+@pytest.fixture
+def check_reflink():
+    def check(result, source, dest):
+        # Independently probe the filesystem; do not infer support from xcp.
+        import errno
+        import fcntl
+        import tempfile
+        with source.open("rb") as src, tempfile.TemporaryFile(dir=source.parent) as probe:
+            try:
+                fcntl.ioctl(probe.fileno(), 0x40049409, src.fileno())  # FICLONE
+            except OSError as exc:
+                assert exc.errno in (errno.EOPNOTSUPP, errno.ENOTTY, errno.EXDEV)
+                assert result.returncode == 1
+                assert "Failed to reflink" in result.stderr
+                assert "'always' was specified" in result.stderr
+            else:
+                assert result.returncode == 0, result.stderr
+                assert dest.read_bytes() == source.read_bytes()
+    return check
