+import os
+import socket
+import pytest
+
+
+@pytest.fixture
+def blackhole_host():
+    """Saturated local listen queues give deterministic TCP connect timeouts.
+
+    No external route, DNS policy, or firewall privilege is needed. Ports stay
+    unchanged so the default-port and URL parameter assertions remain useful.
+    """
+    host = f"127.78.{(os.getpid() >> 8) & 255}.{os.getpid() & 255}"
+    sockets = []
+    try:
+        for port in (21, 80, 1935, 8080, 9999):
+            listener = socket.socket()
+            sockets.append(listener)
+            listener.bind((host, port))
+            listener.listen(1)
+            for _ in range(2):
+                connection = socket.socket()
+                sockets.append(connection)
+                connection.settimeout(1)
+                connection.connect((host, port))
+            with socket.socket() as probe:
+                probe.settimeout(0.05)
+                with pytest.raises(TimeoutError):
+                    probe.connect((host, port))
+        yield host
+    finally:
+        for connection in reversed(sockets):
+            connection.close()
