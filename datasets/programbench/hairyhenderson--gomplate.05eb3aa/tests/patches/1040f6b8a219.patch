+                "instanceId": "i-0123456789abcdef0", "imageId": "ami-0123456789abcdef0",
+                "instanceType": "t3.micro", "availabilityZone": "us-east-1a"}
+
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self, *args):
+            pass
+
+        def reply(self, body, status=200, content_type="text/plain"):
+            body = body.encode()
+            self.send_response(status)
+            self.send_header("Content-Type", content_type)
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def do_PUT(self):
+            if self.path == "/latest/api/token":
+                self.reply("qc-imds-token")
+            else:
+                self.reply("Not Found", 404)
+
+        def do_GET(self):
+            values = {
+                "instance-id": identity["instanceId"], "ami-id": identity["imageId"],
+                "instance-type": identity["instanceType"],
+                "placement/availability-zone": identity["availabilityZone"],
+                "placement/region": identity["region"],
+                "local-ipv4": "10.77.0.1", "hostname": "qc-instance",
+            }
+            if self.path == "/latest/dynamic/instance-identity/document":
+                self.reply(json.dumps(identity), content_type="application/json")
+            elif self.path.startswith("/latest/meta-data/") and self.path[18:] in values:
+                self.reply(values[self.path[18:]])
+            else:
+                self.reply("Not Found", 404)
+
+        def do_POST(self):
+            body = self.rfile.read(int(self.headers.get("Content-Length", "0")))
+            target = self.headers.get("X-Amz-Target", "")
+            action = parse_qs(body.decode()).get("Action", [""])[0]
+            if action == "GetCallerIdentity":
+                self.reply('<GetCallerIdentityResponse xmlns="https://sts.amazonaws.com/doc/2011-06-15/">'
