+    xmlpath = session.config.getoption("xmlpath")
+    if xmlpath and Path(xmlpath).exists():
+        tree = ET.parse(xmlpath)
+        for case in tree.iter("testcase"):
+            prefix = case.get("classname", "") + "."
+            full = prefix + case.get("name", "")
+            original = identities.get(full.rsplit("@db_", 1)[0])
+            if original is not None:
+                case.set("name", original[len(prefix):])
