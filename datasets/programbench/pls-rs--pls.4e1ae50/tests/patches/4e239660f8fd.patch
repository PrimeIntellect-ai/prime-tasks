+def teardown_module():
+    import shutil
+    if "LARGEFILES" in globals():
+        shutil.rmtree(LARGEFILES)
+
+
+def setup_module():
+    # Every xdist worker imports this module. Keep files invisible to other
+    # tests until truncate has established their final sparse logical size.
+    import fcntl
+    with open("/tmp/pls-large-fixtures.lock", "w") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        _setup_large_files()
+
+
+def expected_blocks(golden, directory):
+    """Preserve the snapshot's layout, using independent native block counts."""
+    import re
+    lines = golden.splitlines(keepends=True)
+    for index, line in enumerate(lines[1:], 1):
+        name = line.split()[-1]
+        blocks = (directory / name).stat().st_blocks
+        # The Blocks column is six characters wide (including its heading).
+        lines[index] = re.sub(r"(?<=B) +[0-9]+(?= )", f" {blocks:6d}", line, count=1)
+    return "".join(lines)
