+# Deterministic AWS protocol fixture: never require real cloud credentials.
+@pytest.fixture(scope="session")
+def aws_error_endpoint():
+    import json
+    import re
+    import threading
+    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self, *args):
+            pass
+
+        def respond(self):
+            self.rfile.read(int(self.headers.get("Content-Length", "0")))
+            auth = self.headers.get("Authorization", "")
+            match = re.search(r"/([a-z]+-[a-z]+-[0-9]+)/([^/]+)/aws4_request", auth)
+            region, service = match.groups() if match else ("us-east-1", "ssm")
+            if service == "s3":
+                body = b"<Error><Code>NoSuchBucket</Code><Message>The specified bucket does not exist</Message></Error>"
+                content_type = "application/xml"
+                status = 404
+            else:
+                body = json.dumps({"__type": "AccessDeniedException", "Message":
+                    f"Access denied to arn:aws:{service}:{region}:123456789012:parameter/test"}).encode()
+                content_type = "application/x-amz-json-1.1"
+                status = 400
+            self.send_response(status)
+            self.send_header("Content-Type", content_type)
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        do_GET = do_POST = do_PUT = do_DELETE = do_HEAD = respond
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
