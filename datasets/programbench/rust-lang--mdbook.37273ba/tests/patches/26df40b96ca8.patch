 import re
 
 RESOURCES = Path(__file__).parent.parent / "test_resources" / "test_cli"
+
+
+def clean_size_on_this_filesystem(root):
+    """Independent metadata total; directory inode sizes vary by filesystem."""
+    total = sum(p.stat().st_size for p in [root, *root.rglob("*")])
+    if total < 1024:
+        return f"{total}B"
+    value = float(total)
+    for unit in ("KiB", "MiB", "GiB", "TiB", "PiB"):
+        value /= 1024
+        if value < 1024:
+            return f"{value:.2f}{unit}"
+    raise AssertionError("fixture exceeds supported size units")
+
+
+def clean_expected(golden, size):
+    # Keep exact object count, singular/plural wording, and output shape.
+    return re.sub(r", [0-9.]+(?:[KMGTPE]i)?B total$", f", {size} total", golden.strip())
 
 
