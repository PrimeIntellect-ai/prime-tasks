+def emulate_terminal(master, slave):
+    """Provide the iTerm terminal contract advertised by TERM_PROGRAM.
+
+    Drain rendered output and answer the cell-size query, so rendering cannot
+    block the same event loop that handles termination signals.
+    """
+    import fcntl
+    import select
+    import struct
+    import termios
+    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 24, 80, 640, 384))
+    stop = threading.Event()
+    def consume():
+        pending = b""
+        while not stop.is_set():
+            if not select.select([master], [], [], 0.05)[0]:
+                continue
+            try:
+                data = os.read(master, 65536)
+                if not data:
+                    return
+                pending += data
+                if b"1337;ReportCellSize" in pending:
+                    os.write(master, b"\x1b]1337;ReportCellSize=16;8\x1b\\")
+                    pending = b""
+                pending = pending[-64:]
+            except OSError:
+                return
+    thread = threading.Thread(target=consume, daemon=True)
+    thread.start()
+    return stop, thread
