+def build_artifact_fixture(repo_dir, repo_url, clamp_date=None):
+    key = (repo_url, clamp_date)
+    if key not in _artifact_builds:
+        project = Path(tempfile.mkdtemp(prefix="oranda-artifact-input-"))
+        subprocess.run(["git", "init"], cwd=project, check=True, capture_output=True)
+        subprocess.run(["git", "remote", "add", "origin", repo_url], cwd=project, check=True, capture_output=True)
+        commit = {"https://github.com/axodotdev/axolotlsay.git": "a6a33bd70f7c8221cde500f48b99f6afbdf410f8", "https://github.com/oranda-gallery/oranda-inference-test.git": "e8ae6fc74e140b7d804cd139e2c65c77211d8e95"}[repo_url]
+        subprocess.run(["git", "fetch", "origin", commit], cwd=project, check=True, capture_output=True, timeout=30)
+        subprocess.run(["git", "reset", "--hard", "FETCH_HEAD"], cwd=project, check=True, capture_output=True)
+        env = os.environ.copy()
+        if clamp_date is not None:
+            env["DEBUG_DATA_CLAMP_DATE"] = clamp_date
+        binary = Path(__file__).resolve().parents[2] / "executable"
+        result = subprocess.run([str(binary), "build"], cwd=project, env=env, capture_output=True, text=True, timeout=60)
+        _artifact_builds[key] = (project, result)
+    project, result = _artifact_builds[key]
+    shutil.copytree(project, repo_dir, dirs_exist_ok=True)
+    return result
