+@pytest.fixture
+def dns_fixture():
+    """Serve explicit DNS wire records locally; no public resolver assumptions."""
+    import socket
+    import socketserver
+    import struct
+    import threading
+
+    def response(query):
+        offset = 12
+        while query[offset]:
+            offset += query[offset] + 1
+        offset += 1
+        kind, cls = struct.unpack("!HH", query[offset:offset+4])
+        question = query[12:offset+4]
+        code = 5 if kind in (251, 252) else 2 if kind in (249, 250) else 0
+        answers = []
+        if not code:
+            def rr(kind, data):
+                return b"\xc0\x0c" + struct.pack("!HHIH", kind, 1, 60, len(data)) + data
+            if kind == 28:
+                answers.append(rr(28, socket.inet_pton(socket.AF_INET6, "2607:f8b0:4000::1")))
+            else:
+                answers.append(rr(1, socket.inet_aton("127.0.0.1")))
+            if kind == 255:
+                answers.append(rr(16, b"\x0aqc-fixture"))
+            elif kind != 28:
+                answers.append(rr(1, socket.inet_aton("127.0.0.2")))
+        flags = 0x8580 | code
+        return query[:2] + struct.pack("!HHHHH", flags, 1, len(answers), 0, 0) + question + b"".join(answers)
+
+    class UDP(socketserver.BaseRequestHandler):
+        def handle(self):
+            data, sock = self.request
+            sock.sendto(response(data), self.client_address)
+
+    class TCP(socketserver.StreamRequestHandler):
+        def handle(self):
+            size = self.rfile.read(2)
+            if len(size) == 2:
+                data = response(self.rfile.read(struct.unpack("!H", size)[0]))
+                self.wfile.write(struct.pack("!H", len(data)) + data)
+
+    udp = socketserver.ThreadingUDPServer(("127.0.0.1", 0), UDP)
+    tcp = socketserver.ThreadingTCPServer(udp.server_address, TCP)
+    servers = (udp, tcp)
+    threads = [threading.Thread(target=s.serve_forever, kwargs={"poll_interval":0.05}, daemon=True) for s in servers]
+    for thread in threads:
+        thread.start()
+    try:
+        yield f"127.0.0.1:{udp.server_address[1]}"
+    finally:
+        for server in servers:
+            server.shutdown()
+            server.server_close()
+        for thread in threads:
+            thread.join()
