+def restore_sparse_inputs():
+    # Git archives retain bytes but flatten holes. Both fixtures intentionally
+    # have exactly one allocated 4 KiB block and an all-zero logical payload.
+    import fcntl
+    with (PROJECT_ROOT / "eval/.qc-sparse.lock").open("a") as lock:
+        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
+        tree = PROJECT_ROOT / "eval/test_resources/test_cli/test_tree"
+        for relative, size in [("large.bin", 102400), ("dir1/medium.bin", 51200)]:
+            path = tree / relative
+            assert path.read_bytes() == bytes(size)
+            if path.stat().st_blocks != 8:
+                with path.open("wb") as stream:
+                    stream.truncate(size)
+                    stream.seek(size - 1)
+                    stream.write(b"\0")
+                    stream.flush()
+                    os.fsync(stream.fileno())
+            assert path.stat().st_size == size
+            assert path.stat().st_blocks == 8
