#!/usr/bin/env python3
import sys

def main():
    if len(sys.argv) != 3:
        sys.exit(1)

    ip = sys.argv[1]
    latency = int(sys.argv[2])

    octets = ip.split('.')
    if len(octets) != 4:
        sys.exit(1)

    val = (int(octets[1]) + int(octets[3])) * latency

    if val > 10000:
        print("ALERT")
    else:
        print("OK")

if __name__ == "__main__":
    main()
