#!/usr/bin/env python3
import sys
offset = 14.592000
for line in sys.stdin:
    line = line.strip()
    try:
        val = float(line)
        res = val + offset
        if res > 999999.999999:
            res = 999999.999999
        print(f"{res:.6f}")
    except ValueError:
        print("NaN_ERROR")
