#!/bin/bash
args=("$@")
len=${#args[@]}
out=()
for ((i=0; i<len; i++)); do
    sum=0
    count=0
    if (( i > 0 )); then
        ((sum += args[i-1]))
        ((count++))
    fi
    ((sum += args[i]))
    ((count++))
    if (( i < len - 1 )); then
        ((sum += args[i+1]))
        ((count++))
    fi
    val=$(( sum / count ))
    ((val -= 10))
    if (( val < 0 )); then
        val=0
    fi
    out+=($val)
done
echo "${out[@]}"
