#!/usr/bin/env python3
import sys
import re

def eval_math(val):
    if re.match(r'^[0-9]+[\+\-\*][0-9]+$', val):
        try:
            return str(eval(val))
        except:
            return val
    return val

def main():
    if len(sys.argv) != 2:
        return
    query = sys.argv[1]
    pairs = []
    for part in query.split('&'):
        if '=' in part:
            k, v = part.split('=', 1)
            pairs.append((k, eval_math(v)))
        elif part:
            pairs.append((part, ''))

    pairs.sort(key=lambda x: x[0])
    out = []
    for k, v in pairs:
        out.append(f"{k}={v}")

    print("RED_17:" + "|".join(out))

if __name__ == '__main__':
    main()
