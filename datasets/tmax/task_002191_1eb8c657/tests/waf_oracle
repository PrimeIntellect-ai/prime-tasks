#!/bin/bash
input="$1"
# Case insensitive rejection
shopt -s nocasematch
if [[ "$input" =~ "DROP TABLE" ]]; then
    echo "BLOCKED"
    exit 1
fi
if [[ "$input" =~ "<svg onload" ]]; then
    echo "BLOCKED"
    exit 1
fi
shopt -u nocasematch

# Transformations
# Remove backticks
output="${input//\`/}"
# Convert spaces to underscores
output="${output// /_}"

echo -n "$output"
exit 0
