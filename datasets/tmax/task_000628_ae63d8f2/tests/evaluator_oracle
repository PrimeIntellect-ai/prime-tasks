#!/usr/bin/env python3
import sys

def SEQ(n):
    n = int(n)
    if n < 0: return 0
    return n * (n + 1) // 2

if __name__ == '__main__':
    if len(sys.argv) > 1:
        expr = sys.argv[1]
        try:
            res = eval(expr, {"__builtins__": {}}, {"SEQ": SEQ})
            print(int(res))
        except Exception:
            print("Error")
