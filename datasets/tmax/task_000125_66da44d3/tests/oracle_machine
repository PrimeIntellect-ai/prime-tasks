#!/bin/bash
val=57
state="START"
input=$1

for (( i=0; i<${#input}; i++ )); do
    char="${input:$i:1}"
    if [ "$state" == "START" ]; then
        if [ "$char" == "A" ]; then
            val=$(( (val * 3) % 100 ))
            state="S1"
        elif [ "$char" == "B" ]; then
            val=$(( (val + 7) % 100 ))
        fi
    elif [ "$state" == "S1" ]; then
        if [ "$char" == "A" ]; then
            val=$(( (val * 2) % 100 ))
            state="START"
        elif [ "$char" == "C" ]; then
            val=$(( (val - 5) % 100 ))
            if [ $val -lt 0 ]; then val=$((val + 100)); fi
            state="S2"
        fi
    elif [ "$state" == "S2" ]; then
        val=$(( (val + 11) % 100 ))
        state="START"
    fi
done
echo $val
