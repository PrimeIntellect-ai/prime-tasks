#!/usr/bin/env python3
import sys
import re
import csv

def process():
    # Load dict
    substitutions = []
    with open('/home/user/dict.csv', 'r') as f:
        reader = csv.reader(f)
        for row in reader:
            if len(row) == 2:
                substitutions.append((row[0], row[1]))

    text_lines = sys.stdin.read().splitlines()

    out_lines = []
    for i, line in enumerate(text_lines):
        # 1. Substitute
        for old, new in substitutions:
            line = line.replace(old, new)

        # 2. Custom Compression (RLE for 3+ chars)
        def rle_repl(match):
            chars = match.group(0)
            return f"~{chars[0]}{len(chars)}~"

        line = re.sub(r'(.)\1{2,}', rle_repl, line)

        # 3. Line Numbering
        out_lines.append(f"{i+1:03d}: {line}")

    for o in out_lines:
        print(o)

if __name__ == '__main__':
    process()
