#!/usr/bin/env python3
import sys
import re

def clean_string_to_int(s: str) -> int:
    cleaned = re.sub(r'\D', '', s)
    return int(cleaned) if cleaned else 0

def evaluate_length(n: int) -> int:
    length = 0
    while n > 1:
        if n % 7 == 0:
            n = 5 * n + 1
        elif n % 2 == 0:
            n = n // 2
        else:
            n = 3 * n + 1
        length += 1
    return length

if __name__ == '__main__':
    if len(sys.argv) > 1:
        n = clean_string_to_int(sys.argv[1])
        print(evaluate_length(n))
