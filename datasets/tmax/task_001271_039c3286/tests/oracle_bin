#!/usr/bin/env python3
import sys
import math

lines = sys.stdin.read().splitlines()
seq = "".join([l for l in lines if not l.startswith(">")])
if not seq:
    K = 0.0
else:
    K = (seq.count('G') + seq.count('C')) / len(seq)

x = 100.0
t = 0.0
dt = 0.1
while t < 5.0:
    dx = - K * x * dt
    x += dx
    t += dt
    dt = 0.1 * (1.0 + K)

x_exact = 100.0 * math.exp(-K * 5.0)
print(f"{x:.4f} {x_exact:.4f}")
