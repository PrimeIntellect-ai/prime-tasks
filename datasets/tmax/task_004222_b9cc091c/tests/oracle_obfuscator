#!/usr/bin/env python3
import sys
def process():
    data = sys.stdin.buffer.read()
    out = bytearray()
    for b in data:
        x = b ^ 0x5A
        if x == 0x13:
            out.append(0x31)
        elif x == 0x31:
            out.append(0x13)
        else:
            out.append(x)
    sys.stdout.buffer.write(out)
if __name__ == '__main__':
    process()
