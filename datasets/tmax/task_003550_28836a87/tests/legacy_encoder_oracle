#!/usr/bin/env python3
import sys
import base64

def main():
    data = sys.stdin.read()
    reversed_data = data[::-1]
    xored = bytearray()
    for char in reversed_data:
        xored.append(ord(char) ^ 0x5C)
    encoded = base64.b64encode(xored).decode('ascii')
    sys.stdout.write(encoded)

if __name__ == '__main__':
    main()
