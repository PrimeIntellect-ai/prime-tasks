#!/bin/bash
awk '
BEGIN {
    mu = 4520
    sigma = 815
    sum = 0
    c = 0
    prev = 0
}
{
    if (NR == 1) {
        D = 0
    } else {
        D = $1 - prev
        if (D < 0) D = -D
    }
    prev = $1

    f = NR
    diff = f - mu
    exponent = -(diff * diff) / (2 * sigma * sigma)
    T = exp(exponent)

    val = D - T
    if (val < 0) val = -val

    y = val - c
    t = sum + y
    c = (t - sum) - y
    sum = t
}
END {
    printf "%.6f\n", sum
}
' "$1"
