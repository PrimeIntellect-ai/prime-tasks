#!/usr/bin/env python3
import sys, json

def main():
    weights = [12, 45, 233, 110, 0, 55, 99, 128, 255, 64, 32, 16, 8, 4, 2, 100, 200, 150, 75, 37, 18, 9, 140, 210, 180, 90, 45, 22, 11, 250]
    try:
        data = json.loads(sys.argv[1])
        cost = sum(m['size'] * weights[m['id']] for m in data['modules'])
        print(json.dumps({'schema_version': 2, 'build_cost': cost}))
    except Exception as e:
        sys.exit(1)

if __name__ == '__main__':
    main()
