#!/usr/bin/env python3
import sys
import json
import re

stats = {}
for line in sys.stdin:
    m = re.search(r'MATCH \(n1:Person \{id: (\d+)\}\)-\[:KNOWS\]->\(n2:Person \{id: (\d+)\}\)', line)
    if m:
        u, v = m.groups()
        if u not in stats: stats[u] = {"in": 0, "out": 0}
        if v not in stats: stats[v] = {"in": 0, "out": 0}
        stats[u]["out"] += 1
        stats[v]["in"] += 1

print(json.dumps(stats, separators=(',', ':')))
