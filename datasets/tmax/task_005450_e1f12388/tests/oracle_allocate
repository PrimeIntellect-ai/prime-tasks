#!/bin/bash
TARGET=$(readlink -m "$1")
if [[ "$TARGET" == *"qemu"* ]]; then
    echo "ZONE=hypervisor TZ=Etc/UTC LOCALE=en_US.UTF-8"
elif [[ "$TARGET" == *"cicd"* ]]; then
    echo "ZONE=pipeline TZ=America/New_York LOCALE=en_US.UTF-8"
else
    echo "ZONE=standard TZ=Europe/Berlin LOCALE=de_DE.UTF-8"
fi
