#!/usr/bin/env python3
import sys
def get_min_cost(gb, req):
    standard = gb * 0.0210
    infrequent = (gb * 0.0115) + (req * 0.0025)
    archive = (gb * 0.0035) + (req * 0.0250)
    return min(standard, infrequent, archive)

for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    gb, req = map(int, line.split())
    print(f"{get_min_cost(gb, req):.4f}")
