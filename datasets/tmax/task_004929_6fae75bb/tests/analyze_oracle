#!/usr/bin/env python3
import sys
import math

def compute_affinity(sequence):
    A = []
    for i, c in enumerate(sequence):
        if c == 'A': val = 1
        elif c == 'C': val = 2
        elif c == 'G': val = 3
        elif c == 'T': val = 4
        else: val = 0
        A.append((val * i) % 7 + math.sin(i))
    return A

if __name__ == "__main__":
    if len(sys.argv) < 2:
        sys.exit(1)
    seq = sys.argv[1]
    A = compute_affinity(seq)
    L = len(A)
    if L < 2:
        print("0.0000")
        sys.exit(0)

    D = [A[i+1] - A[i] for i in range(L-1)]

    integral = 0.0
    for i in range(L-2):
        integral += (abs(D[i]) + abs(D[i+1])) / 2.0

    print(f"{integral:.4f}")
