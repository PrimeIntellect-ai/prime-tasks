#!/usr/bin/env python3
import sys, json, re

def rle(s):
    def repl(m):
        c = m.group(1)
        l = len(m.group(0))
        if l >= 3:
            return f"~{l}{c}"
        return m.group(0)
    return re.sub(r'([a-zA-Z])\1{2,}', repl, s)

data = []
lines = sys.stdin.read().splitlines()
in_req = False
for line in lines:
    if line.startswith('[REQ_START]'):
        in_req = True
    elif line.startswith('[REQ_END]'):
        in_req = False
    elif in_req:
        try:
            obj = json.loads(line)
            data.append(obj)
        except:
            pass

data.sort(key=lambda x: x.get('endpoint', ''))
csv = "endpoint,status\n" + "\n".join(f"{d.get('endpoint','')},{d.get('status','')}" for d in data)
sys.stdout.write(rle(csv))
