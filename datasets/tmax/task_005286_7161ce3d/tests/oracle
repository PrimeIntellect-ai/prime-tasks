#!/bin/bash
N=$1
seed=$2

awk -v N="$N" -v seed="$seed" '
BEGIN {
    R = 3.82
    X = 0.5
    LCG_A = 1103515245
    LCG_C = 12345
    LCG_M = 2147483648
    S = seed

    for (i = 1; i <= N; i++) {
        S = (LCG_A * S + LCG_C) % LCG_M
        perturb = (S / LCG_M - 0.5) * 0.01
        X = R * X * (1 - X) + perturb
        printf "%.6f\n", X
    }
}'
