#!/usr/bin/env python3
import sys
import hmac
import hashlib

def main():
    if len(sys.argv) != 3:
        sys.exit(1)
    username = sys.argv[1]
    role = sys.argv[2]
    secret = b"SecureAuditTrail2024!"
    data = f"{username}:{role}".encode('utf-8')
    mac = hmac.new(secret, data, hashlib.sha256).hexdigest()
    print(mac, end="")

if __name__ == "__main__":
    main()
