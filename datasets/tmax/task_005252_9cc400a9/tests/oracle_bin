#!/usr/bin/env python3
import sys

def T(n):
    return (((n**3 - 5*n + 12) % 997) + 997) % 997

def main():
    input_data = sys.stdin.read().split()
    if not input_data:
        return

    transformed = []
    for x in input_data:
        try:
            n = int(x)
            transformed.append(T(n))
        except ValueError:
            pass

    result = sorted(list(set(transformed)), reverse=True)
    print(" ".join(map(str, result)))

if __name__ == '__main__':
    main()
