#!/usr/bin/env python3
import sys

def main():
    if len(sys.argv) != 2:
        sys.exit(1)
    key = b"AUDIT2024SEC"
    input_bytes = sys.argv[1].encode('utf-8')
    result = bytes([ b ^ key[i % len(key)] for i, b in enumerate(input_bytes) ])
    print(result.hex())

if __name__ == "__main__":
    main()
