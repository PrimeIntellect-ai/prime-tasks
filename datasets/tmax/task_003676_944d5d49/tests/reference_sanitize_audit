#!/usr/bin/env python3
import sys
import re

def process(line):
    line = line.strip('\r\n')
    # Redact
    line = re.sub(r'(--db-pass=)(\S+)', r'\1[REDACTED]', line)
    # Flag
    if '<script>' in line or '; rm -rf' in line:
        line += ' [FLAG:INJECTION_XSS]'
    return line

if __name__ == '__main__':
    for input_line in sys.stdin:
        print(process(input_line))
