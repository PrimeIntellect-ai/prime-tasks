#!/bin/bash
if [ "$#" -ne 3 ]; then
    echo "ERROR"
    exit 0
fi

INTERFACE="$1"
STATUS="$2"
LATENCY="$3"

if [[ "$INTERFACE" == vpn* ]]; then
    echo "IGNORE"
elif [[ "$INTERFACE" == "eth0" && "$LATENCY" -eq 0 ]]; then
    echo "ERROR"
elif [[ "$STATUS" == "DOWN" ]]; then
    echo "FAILOVER"
elif [[ "$LATENCY" -gt 50 ]]; then
    echo "FAILOVER"
elif [[ "$STATUS" != "UP" && "$STATUS" != "DOWN" ]]; then
    echo "ERROR"
else
    echo "OK"
fi
