#!/usr/bin/env python3
import sys
import json

for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        data = json.loads(line)
        if not all(k in data for k in ("timestamp", "severity", "source", "message")):
            print("INVALID_LOG")
            continue
        sev = int(data["severity"])
        if sev >= 90:
            sev_str = "FATAL"
        elif sev >= 70:
            sev_str = "HIGH"
        elif sev >= 30:
            sev_str = "MEDIUM"
        else:
            sev_str = "LOW"
        print(f"[{sev_str}] {data['source']} - {data['timestamp']} : {data['message']}")
    except Exception:
        print("INVALID_LOG")
