#!/usr/bin/env python3
import sys
import json

def main():
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError:
        sys.exit(1)

    print("start,end,bytes")
    for item in data:
        start = item["start_frame"]
        end = item["end_frame"]
        size = (end - start + 1) * 2764800
        print(f"{start},{end},{size}")

if __name__ == "__main__":
    main()
