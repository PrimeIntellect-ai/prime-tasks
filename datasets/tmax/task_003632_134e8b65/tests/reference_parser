#!/bin/bash
while IFS= read -r line || [ -n "$line" ]; do
    if [[ "$line" =~ ^\{.*\}$ ]]; then
        msg=$(echo "$line" | jq -r '.message // "NULL"' 2>/dev/null)
        if [ $? -eq 0 ]; then
            echo "JSON_MSG: $msg"
        else
            echo "JSON_MSG: NULL"
        fi
    elif [[ "$line" =~ ^([GM][0-9]+) ]]; then
        cmd="${BASH_REMATCH[1]}"
        if [ "$cmd" != "M117" ]; then
            echo "GCODE: $cmd"
        fi
    else
        upper=$(echo "$line" | tr '[:lower:]' '[:upper:]')
        echo "TEXT: $upper"
    fi
done < "$1"
