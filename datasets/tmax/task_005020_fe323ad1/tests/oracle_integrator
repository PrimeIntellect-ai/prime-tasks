#!/usr/bin/env python3
import sys

def main():
    S_prev = None
    I_prev = 0.0
    dt = 0.1

    x_hist = []

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            x = float(line)
        except ValueError:
            continue

        x_hist.append(x)
        if len(x_hist) > 3:
            x_hist.pop(0)

        n = len(x_hist)
        S_t = sum(x_hist) / n

        if n == 1:
            I_t = 0.0
        else:
            I_t = I_prev + dt * (S_t + S_prev) / 2.0

        print(f"{I_t:.4f}")
        sys.stdout.flush()

        S_prev = S_t
        I_prev = I_t

if __name__ == "__main__":
    main()
