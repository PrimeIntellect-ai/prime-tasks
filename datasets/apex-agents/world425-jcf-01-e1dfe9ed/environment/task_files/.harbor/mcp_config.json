{
  "mcpServers": {
    "calendar_server": {
      "transport": "stdio",
      "command": "setpriv",
      "args": [
        "--reuid=svc_calendar",
        "--regid=appsdata_calendar",
        "--init-groups",
        "--inh-caps=-all",
        "--bounding-set=-all",
        "uv",
        "run",
        "python",
        "main.py"
      ],
      "cwd": "/app/mcp_servers/calendar/mcp_servers/calendar_server",
      "env": {
        "APP_CALENDAR_DATA_ROOT": "/.apps_data/calendar",
        "MCP_TRANSPORT": "stdio",
        "USE_INDIVIDUAL_TOOLS": "true",
        "HOME": "/home/svc_calendar",
        "UV_NO_SYNC": "1",
        "UV_FROZEN": "1",
        "PYTHONPYCACHEPREFIX": "/home/svc_calendar/.cache/pycache"
      }
    },
    "chat_server": {
