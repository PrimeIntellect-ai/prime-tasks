+"""
+    substitute(expr, dict)
+
+substitute any subexpression that matches a key in `dict` with
+the corresponding value.
+"""
+function substitute(expr, dict)
+    RuleSet([@rule ~x::(x->haskey(dict, x)) => dict[~x]])(expr)
+end
