index 39f29ce..44ab926 100644
--- a/test/basics.jl
+++ b/test/basics.jl
@@ -67,3 +67,21 @@ end
     @syms t()
     @test_throws ErrorException t(2)
 end
+
+@testset "substitute" begin
+    @syms a b c
+    @test substitute(a, Dict(a=>1)) == 1
+    @test substitute(a+a, Dict(a=>c)) == c+c
+    @test substitute(sin(a+b), Dict(a=>1)) == sin(1+b)
+    @test substitute(a+b, Dict(a=>1, b=>3)) |> simplify == 4
+
+    # a compound subexpression can itself be a key
+    @test substitute(a+b, Dict(a+b => 5)) == 5
+    @test substitute(a+b, Dict(a+b => c)) == c
+    @test substitute(sin(a+b), Dict(a+b => c)) == sin(c)
+    @test substitute(sin(a+b) + a, Dict(a+b => c)) == sin(c) + a
+    raw = substitute(a+b, Dict(a=>1, b=>3))
+    @test raw == Term(+, [1, 3])
+    # a key that is not a subexpression leaves the expression unchanged
+    @test substitute(a+b, Dict(a+b+1 => c)) == a+b
+end
