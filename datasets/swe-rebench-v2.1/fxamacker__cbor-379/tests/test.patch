 }
+
+type ErrorReader struct {
+	data []byte
+	off  int
+	err  error
+}
+
+func NewErrorReader(data []byte, err error) *ErrorReader {
+	return &ErrorReader{data: data, err: err}
+}
+
+func (r *ErrorReader) Read(b []byte) (int, error) {
+	var n int
+	if r.off < len(r.data) {
+		n = copy(b, r.data[r.off:])
+		r.off += n
+	}
+	if n < len(b) {
+		return n, r.err
+	}
+	return n, nil
+}
