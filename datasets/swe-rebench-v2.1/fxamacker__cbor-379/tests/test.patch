+func TestDecoderTruncatedItemReadErrors(t *testing.T) {
+	var buf bytes.Buffer
+	for _, tc := range unmarshalTests {
+		buf.Write(tc.cborData)
+	}
+	buf.Truncate(buf.Len() - 1)
+	data := buf.Bytes()
+
+	decoder := NewDecoder(&buf)
+	for i := 0; i < len(unmarshalTests)-1; i++ {
+		var v interface{}
+		if err := decoder.Decode(&v); err != nil {
+			t.Fatalf("Decode() returned error %v", err)
+		}
+	}
+	for i := 0; i < 2; i++ {
+		// truncated data
+		var v interface{}
+		err := decoder.Decode(&v)
+		if v != nil {
+			t.Errorf("Decode() = %v (%T), want nil (no more data)", v, v)
+		}
+		if err != io.ErrUnexpectedEOF {
+			t.Errorf("Decode() returned error %v, want io.UnexpectedEOF (truncated data)", err)
+		}
+	}
+
+	// A reader that returns a non-EOF error while a truncated CBOR data
+	// item is being read must have that error returned by Decode().
+	readerErr := errors.New("reader error")
+	decoder = NewDecoder(NewErrorReader(data, readerErr))
+	for i := 0; i < len(unmarshalTests)-1; i++ {
+		var v interface{}
+		if err := decoder.Decode(&v); err != nil {
+			t.Fatalf("Decode() returned error %v", err)
+		}
+	}
+	// truncated data because Reader returned error
+	var v interface{}
+	err := decoder.Decode(&v)
+	if v != nil {
+		t.Errorf("Decode() = %v (%T), want nil (no more data)", v, v)
+	}
+	if err != readerErr {
+		t.Errorf("Decode() returned error %v, want reader error", err)
+	}
+}
