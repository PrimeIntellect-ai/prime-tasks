+func callServerChangeType(t *testing.T, client ServerClient, ctx context.Context, server *Server, serverType *ServerType, upgradeDisk bool) (*Action, *Response, error) {
+	t.Helper()
+	method := reflect.ValueOf(&client).MethodByName("ChangeType")
+	if !method.IsValid() {
+		t.Fatal("ServerClient does not expose ChangeType")
+	}
+	options := reflect.New(method.Type().In(2)).Elem()
+	typeField := options.FieldByName("ServerType")
+	diskField := options.FieldByName("UpgradeDisk")
+	if !typeField.IsValid() || !typeField.CanSet() || !diskField.IsValid() || !diskField.CanSet() {
+		t.Fatal("ChangeType options do not expose the requested fields")
+	}
+	typeField.Set(reflect.ValueOf(serverType))
+	diskField.SetBool(upgradeDisk)
+	results := method.Call([]reflect.Value{reflect.ValueOf(ctx), reflect.ValueOf(server), options})
+	var action *Action
+	if !results[0].IsNil() {
+		action = results[0].Interface().(*Action)
+	}
+	var response *Response
+	if !results[1].IsNil() {
+		response = results[1].Interface().(*Response)
+	}
+	var err error
+	if !results[2].IsNil() {
+		err = results[2].Interface().(error)
+	}
+	return action, response, err
+}
+
+func TestServerClientChangeType(t *testing.T) {
+	ctx := context.Background()
+	server := &Server{ID: 1}
+
+	t.Run("with server type ID and disk upgrade", func(t *testing.T) {
+		env := newTestEnv()
+		defer env.Teardown()
+
+		env.Mux.HandleFunc("/servers/1/actions/change_type", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("X-Change-Type", "accepted")
+			if r.Method != http.MethodPost {
+				t.Errorf("unexpected method: %s", r.Method)
+			}
+			var reqBody map[string]interface{}
+			if err := json.NewDecoder(r.Body).Decode(&reqBody); err != nil {
+				t.Fatal(err)
+			}
+			if id, ok := reqBody["server_type"].(float64); !ok || id != 1 {
+				t.Errorf("unexpected server type ID: %v", reqBody["server_type"])
+			}
+			if reqBody["upgrade_disk"] != true {
+				t.Errorf("unexpected disk-upgrade choice: %v", reqBody["upgrade_disk"])
+			}
+			json.NewEncoder(w).Encode(map[string]interface{}{
+				"action": map[string]interface{}{"id": 1},
+			})
+		})
+
+		action, resp, err := callServerChangeType(t, env.Client.Server, ctx, server, &ServerType{ID: 1}, true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if resp == nil || resp.Header.Get("X-Change-Type") != "accepted" {
+			t.Errorf("unexpected raw response: %#v", resp)
+		}
+		if action.ID != 1 {
+			t.Errorf("unexpected action ID: %d", action.ID)
+		}
+	})
+
+	t.Run("with server type name and without disk upgrade", func(t *testing.T) {
+		env := newTestEnv()
+		defer env.Teardown()
+
+		env.Mux.HandleFunc("/servers/1/actions/change_type", func(w http.ResponseWriter, r *http.Request) {
+			if r.Method != http.MethodPost {
+				t.Errorf("unexpected method: %s", r.Method)
+			}
+			var reqBody map[string]interface{}
+			if err := json.NewDecoder(r.Body).Decode(&reqBody); err != nil {
+				t.Fatal(err)
+			}
+			if name, ok := reqBody["server_type"].(string); !ok || name != "type" {
+				t.Errorf("unexpected server type name: %v", reqBody["server_type"])
+			}
+			if reqBody["upgrade_disk"] != false {
+				t.Errorf("unexpected disk-upgrade choice: %v", reqBody["upgrade_disk"])
+			}
+			json.NewEncoder(w).Encode(map[string]interface{}{
+				"action": map[string]interface{}{"id": 1},
+			})
+		})
+
+		action, _, err := callServerChangeType(t, env.Client.Server, ctx, server, &ServerType{Name: "type"}, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if action.ID != 1 {
+			t.Errorf("unexpected action ID: %d", action.ID)
+		}
+	})
+
+	t.Run("returns an error when the request fails", func(t *testing.T) {
+		env := newTestEnv()
+		defer env.Teardown()
+
+		env.Mux.HandleFunc("/servers/1/actions/change_type", func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusInternalServerError)
+		})
+
+		_, _, err := callServerChangeType(t, env.Client.Server, ctx, server, &ServerType{ID: 1}, false)
+		if err == nil {
+			t.Fatal("expected an error for an unsuccessful request")
+		}
+	})
+}
