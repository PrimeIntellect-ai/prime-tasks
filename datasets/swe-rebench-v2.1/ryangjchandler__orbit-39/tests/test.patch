+
+    public function test_it_can_use_markdown_json_driver()
+    {
+        $md = MarkdownJsonModel::create([
+            'name' => 'Ryan',
+        ]);
+
+        $path = __DIR__.'/content/markdown_json_models/'.$md->getKey().'.md';
+
+        $this->assertFileExists($path);
+
+        $contents = file_get_contents($path);
+
+        $this->assertSame(
+            1,
+            preg_match('/^---[ \t]*\R(.*?)\R---[ \t]*(\R|$)/s', $contents, $matches),
+            'Expected the file to contain front matter delimited by "---" lines.'
+        );
+
+        $matter = json_decode(trim($matches[1]), true);
+
+        $this->assertIsArray($matter, 'The front matter should be valid JSON.');
+        $this->assertSame('Ryan', $matter['name'] ?? null);
+
+        $md->delete();
+    }
+
+    public function test_it_persists_updates_to_markdown_json_files()
+    {
+        $md = MarkdownJsonModel::create([
+            'name' => 'Ryan',
+        ]);
+
+        try {
+            $originalPath = __DIR__.'/content/markdown_json_models/Ryan.md';
+            $updatedPath = __DIR__.'/content/markdown_json_models/John.md';
+
+            $md->update([
+                'name' => 'John',
+            ]);
+
+            $this->assertFileDoesNotExist($originalPath);
+            $this->assertFileExists($updatedPath);
+
+            $contents = file_get_contents($updatedPath);
+            preg_match('/^---[ \t]*\R(.*?)\R---[ \t]*(\R|$)/s', $contents, $matches);
+            $matter = json_decode(trim($matches[1] ?? ''), true);
+
+            $this->assertSame('John', $matter['name'] ?? null);
+            $this->assertNotNull(MarkdownJsonModel::find('John'));
+        } finally {
+            $md->delete();
+        }
+    }
+
+    public function test_it_loads_json_front_matter_and_preserves_the_markdown_body()
+    {
+        $directory = __DIR__.'/content/markdown_json_models';
+        if (! is_dir($directory)) {
+            mkdir($directory, 0777, true);
+        }
+
+        $path = $directory.'/😀.md';
+        file_put_contents($path, "---\n{\n  \"name\": \"\\uD83D\\uDE00\",\n  \"created_at\": \"2024-01-01T00:00:00.000000Z\",\n  \"updated_at\": \"2024-01-01T00:00:00.000000Z\"\n}\n---\nA **Markdown** body.\n");
+
+        try {
+            (new MarkdownJsonModel)->migrate();
+
+            $loaded = MarkdownJsonModel::find('😀');
+
+            $this->assertNotNull($loaded);
+            $this->assertSame('😀', $loaded->name);
+            $this->assertSame('A **Markdown** body.', $loaded->content);
+        } finally {
+            if (file_exists($path)) {
+                unlink($path);
+            }
+        }
+    }
+
+    public function test_it_deletes_markdown_json_files_when_model_is_deleted()
+    {
+        $md = MarkdownJsonModel::create([
+            'name' => 'Ryan',
+        ]);
+
+        $path = __DIR__.'/content/markdown_json_models/Ryan.md';
+
+        $this->assertFileExists($path);
+
+        preg_match('/^---[ \t]*\R(.*?)\R---[ \t]*(\R|$)/s', file_get_contents($path), $matches);
+        $this->assertIsArray(json_decode(trim($matches[1] ?? ''), true), 'The file should use JSON front matter.');
+
+        $md->delete();
+
+        $this->assertFileDoesNotExist($path);
+        $this->assertNull(MarkdownJsonModel::find('Ryan'));
+    }
 }
