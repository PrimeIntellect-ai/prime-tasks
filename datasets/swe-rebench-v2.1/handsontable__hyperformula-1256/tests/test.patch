diff --git a/test/update-config.spec.ts b/test/update-config.spec.ts
index 68857a01..0e95e6ca 100644
--- a/test/update-config.spec.ts
+++ b/test/update-config.spec.ts
@@ -67,4 +67,47 @@ describe('update config', () => {
     expect(engine.getCellValue(adr('A1'))).toBe(true)
     expect(engine.getCellValue(adr('B1'))).toBe(false)
   })
+
+  it('doesn\'t lose undo history when new config is the same as the old one', () => {
+    const config = { useArrayArithmetic: true }
+    const engine = HyperFormula.buildFromArray([[1]], config)
+    engine.setCellContents(adr('A1'), 2)
+
+    engine.updateConfig(config)
+
+    engine.undo()
+    expect(engine.getCellValue(adr('A1'))).toEqual(1)
+  })
+
+  it('doesn\'t lose undo history when new config contains only the default config values', () => {
+    const engine = HyperFormula.buildFromArray([[1]], {})
+    engine.setCellContents(adr('A1'), 2)
+
+    engine.updateConfig({ useColumnIndex: false, functionArgSeparator: ',', undoLimit: 20 })
+
+    engine.undo()
+    expect(engine.getCellValue(adr('A1'))).toEqual(1)
+  })
+
+  it('applies a time format added to the same timeFormats array', () => {
+    const config = { timeFormats: ['hh:mm'] }
+    const engine = HyperFormula.buildFromArray([['10:20:30']], config)
+    expect(engine.getCellValue(adr('A1'))).toEqual('10:20:30')
+
+    config.timeFormats.push('hh:mm:ss')
+    engine.updateConfig(config)
+
+    expect(engine.getCellValue(adr('A1'))).toBeCloseTo((10 * 3600 + 20 * 60 + 30) / 86400)
+  })
+
+  it('applies a currency symbol added to the same currencySymbol array', () => {
+    const config = { currencySymbol: ['$'] }
+    const engine = HyperFormula.buildFromArray([['€10']], config)
+    expect(engine.getCellValue(adr('A1'))).not.toEqual(10)
+
+    config.currencySymbol.push('€')
+    engine.updateConfig(config)
+
+    expect(engine.getCellValue(adr('A1'))).toEqual(10)
+  })
 })
