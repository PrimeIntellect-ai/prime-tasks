+import main, { uploadAttachment } from '../attachment';
+
+jest.mock('fs');
+jest.mock('inquirer');
+jest.mock('messaging-api-messenger');
+jest.mock('recursive-readdir');
+jest.mock('file-type');
+jest.mock('read-chunk');
+jest.mock('jsonfile');
+jest.mock('hasha');
+
+jest.mock('../../../shared/log');
+jest.mock('../../../shared/getConfig');
+
+const inquirer = require('inquirer');
+const { MessengerClient } = require('messaging-api-messenger');
+const readdir = require('recursive-readdir');
+const jsonfile = require('jsonfile');
+const hasha = require('hasha');
+const log = require('../../../shared/log');
+const getConfig = require('../../../shared/getConfig');
+
+const MOCK_FILE_WITH_PLATFORM = {
+  messenger: {
+    accessToken: '__PUT_YOUR_ACCESS_TOKEN_HERE__',
+    appId: '__APP_ID__',
+    appSecret: '__APP_SECRET__',
+    verifyToken: '__verifyToken__',
+  },
+  line: {},
+};
+
+let _client;
+
+describe('uploadAttachment', () => {
+  beforeEach(() => {
+    _client = {
+      getPageInfo: jest.fn(() => Promise.resolve({ id: 'page' })),
+      uploadAttachment: jest.fn(() => Promise.resolve({})),
+    };
+    MessengerClient.connect = jest.fn(() => _client);
+    getConfig.mockReturnValue(MOCK_FILE_WITH_PLATFORM.messenger);
+    readdir.mockReturnValue(Promise.resolve(['assets/test.png']));
+    jsonfile.readFileSync = jest.fn(() => ({}));
+    jsonfile.writeFileSync = jest.fn();
+    hasha.fromFileSync = jest.fn(() => 'checksum');
+    inquirer.prompt = jest.fn();
+    inquirer.prompt.mockReturnValue(
+      Promise.resolve({
+        confirm: true,
+      })
+    );
+    process.exit = jest.fn();
+  });
+
+  it('be defined', () => {
+    expect(uploadAttachment).toBeDefined();
+  });
+
+  describe('resolve', () => {
+    it('the yes option should skip confirmation', async () => {
+      await main({
+        argv: {
+          _: ['messenger', 'attachment', 'upload'],
+          force: true,
+          yes: true,
+        },
+      });
+
+      expect(inquirer.prompt).not.toBeCalled();
+      expect(_client.uploadAttachment).toBeCalled();
+    });
+  });
+
+  describe('reject', () => {
+    it('reject when `accessToken` not found in config file', async () => {
+      const ctx = {
+        argv: {},
+      };
+
+      getConfig.mockReturnValueOnce({
+        appId: '__APP_ID__',
+        appSecret: '__APP_SECRET__',
+        verifyToken: '__verifyToken__',
+      });
+
+      await uploadAttachment(ctx);
+
+      expect(process.exit).toBeCalled();
+      expect(log.error).toBeCalled();
+    });
+
+    it('exit when user does not confirm force upload', async () => {
+      const ctx = {
+        argv: {
+          force: true,
+        },
+      };
+      inquirer.prompt.mockReturnValueOnce(
+        Promise.resolve({
+          confirm: false,
+        })
+      );
+
+      await uploadAttachment(ctx);
+
+      expect(inquirer.prompt).toBeCalled();
+      expect(process.exit).toBeCalled();
+      expect(_client.uploadAttachment).not.toBeCalled();
+    });
+  });
+});
