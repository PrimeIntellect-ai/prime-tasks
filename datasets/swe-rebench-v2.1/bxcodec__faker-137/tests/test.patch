@@ -0,0 +1,88 @@
+package faker
+
+import (
+	mathrand "math/rand"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// TestCustomSourceDrivesFakeDataDeterministically verifies that fake-data generation uses the supplied source.
+func TestCustomSourceDrivesFakeDataDeterministically(t *testing.T) {
+	generate := func() float64 {
+		SetRandomSource(mathrand.NewSource(1234567))
+		var got struct {
+			Value float64
+		}
+		if err := FakeData(&got); err != nil {
+			t.Fatalf("generating fake data: %v", err)
+		}
+		return got.Value
+	}
+	defer SetRandomSource(mathrand.NewSource(time.Now().UnixNano()))
+
+	first := generate()
+	second := generate()
+	if first != second {
+		t.Errorf("fake data was not repeatable for identical supplied sources: got %v and %v", first, second)
+	}
+}
+
+// recordingSourceForTest records whether Int63 is ever entered concurrently.
+type recordingSourceForTest struct {
+	inUse      int32
+	concurrent int32
+}
+
+func (s *recordingSourceForTest) Int63() int64 {
+	if !atomic.CompareAndSwapInt32(&s.inUse, 0, 1) {
+		atomic.StoreInt32(&s.concurrent, 1)
+	}
+	time.Sleep(200 * time.Microsecond)
+	atomic.StoreInt32(&s.inUse, 0)
+	return 0
+}
+
+func (s *recordingSourceForTest) Seed(int64) {}
+
+func fakeDataFromManyGoroutines() {
+	var wg sync.WaitGroup
+	for i := 0; i < 50; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			var value struct {
+				Number float64
+			}
+			_ = FakeData(&value)
+		}()
+	}
+	wg.Wait()
+}
+
+// TestCustomSourceWrappedBySafeSourceIsSerialised verifies that callers can opt into
+// serialised access by wrapping their source before setting it.
+func TestCustomSourceWrappedBySafeSourceIsSerialised(t *testing.T) {
+	src := &recordingSourceForTest{}
+	SetRandomSource(NewSafeSource(src))
+	defer SetRandomSource(mathrand.NewSource(time.Now().UnixNano()))
+
+	fakeDataFromManyGoroutines()
+	if atomic.LoadInt32(&src.concurrent) != 0 {
+		t.Error("fake-data generation accessed the protected source concurrently")
+	}
+}
+
+// TestCustomSourceUnwrappedIsNotSerialised verifies that an unwrapped
+// source remains caller-controlled when fake data is generated concurrently.
+func TestCustomSourceUnwrappedIsNotSerialised(t *testing.T) {
+	src := &recordingSourceForTest{}
+	SetRandomSource(src)
+	defer SetRandomSource(mathrand.NewSource(time.Now().UnixNano()))
+
+	fakeDataFromManyGoroutines()
+	if atomic.LoadInt32(&src.concurrent) == 0 {
+		t.Error("fake-data generation unexpectedly serialized the supplied source")
+	}
+}
