diff --git a/tests/testthat/test-robust_infix.R b/tests/testthat/test-robust_infix.R
new file mode 100644
index 0000000..d76d891
--- /dev/null
+++ b/tests/testthat/test-robust_infix.R
@@ -0,0 +1,21 @@
+test_that("infix works", {
+  expect_true(is_infix("1+1"))
+  expect_true(is_infix("1*1"))
+  expect_true(is_infix("a %in% b"))
+  expect_false(is_infix("1"))
+})
+
+test_that("prep handles text containing brackets", {
+  expect_error(prep("[aeiou]"), NA)
+  expect_error(prep("[aeiou"), NA)
+  expect_error(prep("[aeiou*"), NA)
+})
+
+test_that("grade_code handles regular expressions containing brackets", {
+  user <- expression(str_detect(x, "[aeiou]"))
+  solution <- expression(str_detect(x, "[aeiou]+"))
+  expect_error(
+    grade_code(grader_args = list(user_quo = user, solution_quo = solution)),
+    NA
+  )
+})
