+
+
+def test_groupby_decimal_keys_with_na_sum():
+    # GH#54847
+    df = DataFrame(
+        columns=["group_field", "value_field"],
+        data=[
+            [Decimal(1), Decimal(2)],
+            [Decimal(1), Decimal(3)],
+            [None, Decimal(4)],
+            [None, Decimal(5)],
+        ],
+    )
+    gb = df.groupby("group_field", dropna=False)
+    result = gb["value_field"].sum()
+    expected = Series(
+        [Decimal(5), Decimal(9)],
+        index=Index([Decimal(1), np.nan], name="group_field"),
+        name="value_field",
+        dtype=object,
+    )
+    tm.assert_series_equal(result, expected)
