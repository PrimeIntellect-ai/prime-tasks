+// TestErrClosed checks the public API for detecting a closed watcher: the
+// exported ErrClosed sentinel. Callers can use it to tell whether a watcher
+// has been closed without inspecting OS-specific error strings.
+func TestErrClosed(t *testing.T) {
+	t.Parallel()
+
+	if ErrClosed == nil {
+		t.Fatal("ErrClosed is nil")
+	}
+	tmp := t.TempDir()
+	w := newWatcher(t, tmp)
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	file := filepath.Join(tmp, "file")
+	touch(t, file)
+
+	err := w.Add(file)
+	if err == nil {
+		t.Fatal("Add after Close: error is nil")
+	}
+	if !errors.Is(err, ErrClosed) {
+		t.Errorf("Add after Close: got %#v, want ErrClosed", err)
+	}
 }
 
