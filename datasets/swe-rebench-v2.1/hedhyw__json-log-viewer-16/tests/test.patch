+func TestAppViewReload(t *testing.T) {
+	t.Parallel()
+
+	const expected = "included"
+
+	const (
+		jsonFile = `
+{"time":"1970-01-01T00:00:00.00","level":"INFO","message": "test2"}
+{"time":"1970-01-01T00:00:00.00","level":"INFO","message": "test1"}
+`
+
+		jsonFileUpdated = `
+{"time":"1970-01-01T00:00:00.00","level":"INFO","message": "` + expected + `"}
+` + jsonFile
+	)
+
+	appModel, filePath := newTestModelWithPath(t, []byte(jsonFile))
+
+	rendered := appModel.View()
+	assert.NotContains(t, rendered, expected)
+
+	err := os.WriteFile(filePath, []byte(jsonFileUpdated), os.ModePerm)
+	require.NoError(t, err)
+
+	appModel, cmd := toAppModel(appModel.Update(tea.KeyMsg{
+		Type: tea.KeyUp,
+	}))
+
+	// The reload may be performed synchronously during the update or
+	// asynchronously through the returned command. Both are valid, so
+	// execute the command when it is provided.
+	if cmd != nil {
+		appModel, _ = toAppModel(appModel.Update(cmd()))
+	}
+
+	rendered = appModel.View()
+	assert.Contains(t, rendered, expected)
+}
+
+func TestAppViewReloadRequiresFirstUnfilteredRecord(t *testing.T) {
+	const initialLogs = `{"time":"1970-01-01T00:00:00.00","level":"INFO","message":"test1"}
+{"time":"1970-01-01T00:00:00.00","level":"INFO","message":"test2"}`
+	const addedLog = `{"time":"1970-01-01T00:00:00.00","level":"INFO","message":"test1 new-on-disk"}`
+
+	t.Run("cursor is not at the first record", func(t *testing.T) {
+		appModel, filePath := newTestModelWithPath(t, []byte(initialLogs))
+		appModel, cmd := toAppModel(appModel.Update(tea.KeyMsg{Type: tea.KeyDown}))
+		if cmd != nil {
+			appModel, _ = toAppModel(appModel.Update(cmd()))
+		}
+		require.NoError(t, os.WriteFile(filePath, []byte(initialLogs+"\n"+addedLog), os.ModePerm))
+
+		appModel, cmd = toAppModel(appModel.Update(tea.KeyMsg{Type: tea.KeyUp}))
+		if cmd != nil {
+			appModel, _ = toAppModel(appModel.Update(cmd()))
+		}
+
+		assert.NotContains(t, appModel.View(), "new-on-disk")
+	})
+
+	t.Run("results are filtered", func(t *testing.T) {
+		appModel, filePath := newTestModelWithPath(t, []byte(initialLogs))
+		appModel, _ = toAppModel(appModel.Update(tea.KeyMsg{
+			Type:  tea.KeyRunes,
+			Runes: []rune{'f'},
+		}))
+		appModel, _ = toAppModel(appModel.Update(tea.KeyMsg{
+			Type:  tea.KeyRunes,
+			Runes: []rune("test1"),
+		}))
+		appModel, cmd := toAppModel(appModel.Update(tea.KeyMsg{Type: tea.KeyEnter}))
+		if cmd != nil {
+			appModel, _ = toAppModel(appModel.Update(cmd()))
+		}
+		require.True(t, appModel.IsFiltered())
+		require.NoError(t, os.WriteFile(filePath, []byte(initialLogs+"\n"+addedLog), os.ModePerm))
+
+		appModel, cmd = toAppModel(appModel.Update(tea.KeyMsg{Type: tea.KeyUp}))
+		if cmd != nil {
+			appModel, _ = toAppModel(appModel.Update(cmd()))
+		}
+
+		assert.NotContains(t, appModel.View(), "new-on-disk")
+	})
+}
+
+func newTestModel(tb testing.TB, content []byte) app.Model {
+	tb.Helper()
+
+	appModel, _ := newTestModelWithPath(tb, content)
+
+	return appModel
+}
+
+func newTestModelWithPath(tb testing.TB, content []byte) (app.Model, string) {
+	tb.Helper()
+
+	testFile := tests.RequireCreateFile(tb, content)
+
+	appModel := app.NewModel(testFile)
+	cmd := appModel.Init()
+
+	appModel, _ = toAppModel(appModel.Update(cmd()))
+
+	return appModel, testFile
+}
+
+func toAppModel(teaModel tea.Model, cmd tea.Cmd) (app.Model, tea.Cmd) {
+	appModel, _ := teaModel.(app.Model)
+
+	return appModel, cmd
+}
