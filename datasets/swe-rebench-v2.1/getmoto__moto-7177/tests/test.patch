+@mock_identitystore
+def test_list_group_memberships_for_member():
+    client = boto3.client("identitystore", region_name="us-east-2")
+    identity_store_id = get_identity_store_id()
+
+    end = 5000
+    batch_size = 321
+    next_token = None
+    membership_ids = []
+
+    user_id = __create_and_verify_sparse_user(client, identity_store_id)["UserId"]
+    for i in range(end):
+        group_id = client.create_group(
+            IdentityStoreId=identity_store_id,
+            DisplayName=f"test_group_{i}",
+            Description="description",
+        )["GroupId"]
+        create_response = client.create_group_membership(
+            IdentityStoreId=identity_store_id,
+            GroupId=group_id,
+            MemberId={"UserId": user_id},
+        )
+        membership_ids.append((create_response["MembershipId"], group_id))
+
+    membership_group_ids = dict(membership_ids)
+    received_membership_ids = []
+    while True:
+        request = {
+            "IdentityStoreId": identity_store_id,
+            "MemberId": {"UserId": user_id},
+            "MaxResults": batch_size,
+        }
+        if next_token is not None:
+            request["NextToken"] = next_token
+
+        list_response = client.list_group_memberships_for_member(**request)
+        memberships = list_response["GroupMemberships"]
+        assert len(memberships) <= batch_size
+        for membership in memberships:
+            assert membership["MemberId"]["UserId"] == user_id
+            assert (
+                membership["GroupId"]
+                == membership_group_ids[membership["MembershipId"]]
+            )
+            received_membership_ids.append(membership["MembershipId"])
+
+        if "NextToken" in list_response:
+            assert len(received_membership_ids) < end
+            next_token = list_response["NextToken"]
+        else:
+            assert len(received_membership_ids) == end
+            assert set(received_membership_ids) == set(membership_group_ids)
+            break
+
+
+@mock_identitystore
+def test_list_group_memberships_for_member_filters_by_member():
+    client = boto3.client("identitystore", region_name="us-east-2")
+    identity_store_id = get_identity_store_id()
+
+    user_id = __create_and_verify_sparse_user(client, identity_store_id)["UserId"]
+    other_user_id = __create_and_verify_sparse_user(client, identity_store_id)["UserId"]
+
+    group_id = client.create_group(
+        IdentityStoreId=identity_store_id,
+        DisplayName="test_group",
+        Description="description",
+    )["GroupId"]
+
+    membership_id = client.create_group_membership(
+        IdentityStoreId=identity_store_id,
+        GroupId=group_id,
+        MemberId={"UserId": user_id},
+    )["MembershipId"]
+    client.create_group_membership(
+        IdentityStoreId=identity_store_id,
+        GroupId=group_id,
+        MemberId={"UserId": other_user_id},
+    )
+
+    response = client.list_group_memberships_for_member(
+        IdentityStoreId=identity_store_id,
+        MemberId={"UserId": user_id},
+        MaxResults=100,
+    )
+    assert len(response["GroupMemberships"]) == 1
+    assert response["GroupMemberships"][0]["MembershipId"] == membership_id
+    assert response["GroupMemberships"][0]["MemberId"]["UserId"] == user_id
+
+    other_response = client.list_group_memberships_for_member(
+        IdentityStoreId=identity_store_id,
+        MemberId={"UserId": other_user_id},
+        MaxResults=100,
+    )
+    assert len(other_response["GroupMemberships"]) == 1
+    assert other_response["GroupMemberships"][0]["MemberId"]["UserId"] == other_user_id
+
+
+@mock_identitystore
+def test_list_group_memberships_for_member_is_limited_to_identity_store():
+    client = boto3.client("identitystore", region_name="us-east-2")
+    membership_store_id = get_identity_store_id()
+    queried_store_id = get_identity_store_id()
+
+    user_id = __create_and_verify_sparse_user(client, membership_store_id)["UserId"]
+    group_id = client.create_group(
+        IdentityStoreId=membership_store_id,
+        DisplayName="cross_store_group",
+        Description="description",
+    )["GroupId"]
+    client.create_group_membership(
+        IdentityStoreId=membership_store_id,
+        GroupId=group_id,
+        MemberId={"UserId": user_id},
+    )
+
+    response = client.list_group_memberships_for_member(
+        IdentityStoreId=queried_store_id,
+        MemberId={"UserId": user_id},
+        MaxResults=100,
+    )
+
+    assert response["GroupMemberships"] == []
+    assert "NextToken" not in response
+
