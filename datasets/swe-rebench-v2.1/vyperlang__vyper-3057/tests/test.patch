@@ -0,0 +1,26 @@
+from decimal import Decimal
+
+import pytest
+
+
+def test_epsilon(get_contract):
+    contract = get_contract(
+        """
+@external
+def foo() -> decimal:
+    return epsilon(decimal)
+"""
+    )
+
+    assert contract.foo() == Decimal("1e-10")
+
+
+def test_epsilon_rejects_non_decimal_type(get_contract):
+    source = """
+@external
+def foo() -> decimal:
+    return epsilon(uint256)
+"""
+
+    with pytest.raises(Exception):
+        get_contract(source)
