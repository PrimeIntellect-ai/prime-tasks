+describe('CLI delete ================', () => {
+    it('Should delete every entry passed via repeated --metadata options', async function () {
+        this.timeout(30000);
+        const cwd = process.cwd();
+        const configPath = path.join(cwd, '.mcdevrc.json');
+        const authPath = path.join(cwd, '.mcdev-auth.json');
+        fs.copyFileSync(path.join(cwd, 'test/mockRoot/.mcdevrc.json'), configPath);
+        fs.copyFileSync(path.join(cwd, 'test/mockRoot/.mcdev-auth.json'), authPath);
+        const apimock = new MockAdapter(axiosInstance, { onNoMatch: 'throwException' });
+        const authResources = File.readJsonSync(path.join(cwd, 'test/resources/auth.json'));
+        apimock.onPost(authResources.success.url).reply((config) => {
+            authResources.success.response.access_token = JSON.parse(config.data).account_id;
+            return [authResources.success.status, authResources.success.response];
+        });
+        apimock.onPost(soapUrl).reply((config) => handleSOAPRequest(config));
+        const remainingRecords = new Set([
+            '/asset/v1/content/assets/950143',
+            '/interaction/v1/interactions/3c3f4112-9b43-43ca-8a89-aa0375b2c1a2?versionNumber=1',
+            '/interaction/v1/interactions/0175b971-71a3-4d8e-98ac-48121f3fbf4f?versionNumber=1',
+        ]);
+        apimock.onAny(new RegExp(`^${restUrl}`)).reply((config) => {
+            if (config.method === 'delete') {
+                remainingRecords.delete(config.url);
+            }
+            return handleRESTRequest(config);
+        });
+        const oldArgv = process.argv;
+        process.argv = [
+            'node',
+            'cli.js',
+            'del',
+            'testInstance/testBU',
+            '--noLogFile',
+            '-m',
+            'asset:testExisting_asset',
+            '-m',
+            'journey:testExisting_journey_Quicksend/1',
+            '-m',
+            'journey:testExisting_journey_Multistep/1',
+        ];
+        try {
+            await import('../lib/cli.js');
+            const deadline = Date.now() + 20000;
+            while (remainingRecords.size && Date.now() < deadline) {
+                await new Promise((resolve) => setTimeout(resolve, 50));
+            }
+            assert.deepEqual(
+                [...remainingRecords],
+                [],
+                'every record passed via repeated --metadata options should have been deleted'
+            );
+        } finally {
+            process.argv = oldArgv;
+            apimock.restore();
+            fs.rmSync(configPath, { force: true });
+            fs.rmSync(authPath, { force: true });
+        }
+    });
+});
