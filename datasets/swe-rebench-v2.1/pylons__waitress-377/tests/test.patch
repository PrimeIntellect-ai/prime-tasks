+    def test_write_soon_does_not_close_socket_on_disconnect(self):
+        import errno
+
+        inst, sock, map = self._makeOneWithMap()
+
+        # The peer has disconnected, so the socket send fails. A flush that
+        # happens on behalf of a worker thread must not close the socket
+        # (the main loop may be polling it); the main loop is woken instead.
+        def send(_):
+            raise OSError(errno.EPIPE, "Broken pipe")
+
+        sock.send = send
+        inst.adj.send_bytes = 1
+
+        inst.write_soon(b"abc")
+
+        self.assertFalse(sock.closed)
+
