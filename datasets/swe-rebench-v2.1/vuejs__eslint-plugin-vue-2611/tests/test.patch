diff --git a/tests/lib/rules/restricted-component-names.js b/tests/lib/rules/restricted-component-names.js
new file mode 100644
index 00000000..072db1a8
--- /dev/null
+++ b/tests/lib/rules/restricted-component-names.js
@@ -0,0 +1,70 @@
+/**
+ * @author Wayne Zhang
+ * See LICENSE file in root directory for full license.
+ */
+'use strict'
+
+const assert = require('assert')
+const RuleTester = require('../../eslint-compat').RuleTester
+const plugin = require('../../../lib')
+const rule = plugin.rules['restricted-component-names']
+
+assert.ok(rule, 'the plugin exposes the restricted-component-names rule')
+
+const tester = new RuleTester({
+  languageOptions: {
+    parser: require('vue-eslint-parser'),
+    ecmaVersion: 2020,
+    sourceType: 'module'
+  }
+})
+
+tester.run('restricted-component-names', rule, {
+  valid: [
+    '<template><keep-alive></keep-alive></template>',
+    '<template><button/></template>',
+    '<template><circle/></template>',
+    {
+      filename: 'test.vue',
+      code: `
+      <template>
+        <foo-button/>
+        <div-bar/>
+      </template>
+      `,
+      options: [{ allow: ['/^foo-/', '/-bar$/'] }]
+    },
+    {
+      filename: 'test.vue',
+      code: `
+      <template>
+        <bar/>
+      </template>
+      `,
+      options: [{ allow: ['bar'] }]
+    }
+  ],
+  invalid: [
+    {
+      filename: 'test.vue',
+      code: `
+      <template>
+        <Button/>
+        <foo-button/>
+      </template>
+      `,
+      errors: 2
+    },
+    {
+      filename: 'test.vue',
+      code: `
+      <template>
+        <bar-button/>
+        <foo/>
+      </template>
+      `,
+      options: [{ allow: ['/^foo-/', 'bar'] }],
+      errors: 2
+    }
+  ]
+})
