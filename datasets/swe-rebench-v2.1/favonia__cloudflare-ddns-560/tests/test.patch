@@ -0,0 +1,59 @@
+package provider_test
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"testing"
+
+	"github.com/golang/mock/gomock"
+	"github.com/stretchr/testify/require"
+
+	"github.com/favonia/cloudflare-ddns/internal/ipnet"
+	"github.com/favonia/cloudflare-ddns/internal/mocks"
+	"github.com/favonia/cloudflare-ddns/internal/provider"
+)
+
+func TestCustomName(t *testing.T) {
+	t.Parallel()
+
+	require.Equal(t, "custom", provider.Name(provider.NewCustom("")))
+}
+
+func TestCustomGetIP(t *testing.T) {
+	t.Parallel()
+
+	ip4 := netip.MustParseAddr("1.2.3.4")
+	ip6 := netip.MustParseAddr("::1:2:3:4:5:6")
+
+	ip4Server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		fmt.Fprint(w, ip4.String())
+	}))
+	defer ip4Server.Close()
+	ip6Server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		fmt.Fprint(w, ip6.String())
+	}))
+	defer ip6Server.Close()
+
+	for name, tc := range map[string]struct {
+		url      string
+		ipNet    ipnet.Type
+		expected netip.Addr
+	}{
+		"4": {ip4Server.URL, ipnet.IP4, ip4},
+		"6": {ip6Server.URL, ipnet.IP6, ip6},
+	} {
+		tc := tc
+		t.Run(name, func(t *testing.T) {
+			mockCtrl := gomock.NewController(t)
+			mockPP := mocks.NewMockPP(mockCtrl)
+
+			p := provider.NewCustom(tc.url)
+			ip, ok := p.GetIP(context.Background(), mockPP, tc.ipNet, true)
+			require.True(t, ok)
+			require.Equal(t, tc.expected, ip)
+		})
+	}
+}
