+func TestRemoteConnectOption(t *testing.T) {
+	t.Parallel()
+	repo := createTestRepo(t)
+	defer cleanupTestRepo(t, repo)
+
+	config, err := repo.Config()
+	checkFatal(t, err)
+	err = config.SetString("url.git@github.com:.insteadof", "https://github.com/")
+	checkFatal(t, err)
+
+	option, err := DefaultRemoteCreateOptions()
+	checkFatal(t, err)
+	option.Name = "origin"
+	option.Flags = RemoteCreateSkipInsteadof
+
+	remote, err := repo.Remotes.CreateWithOptions("https://github.com/libgit2/TestGitRepository", option)
+	checkFatal(t, err)
+	defer remote.Free()
+
+	if remote.Name() != "origin" {
+		t.Fatalf("expected remote name %q, got %q", "origin", remote.Name())
+	}
+	if remote.Url() != "https://github.com/libgit2/TestGitRepository" {
+		t.Fatalf("expected remote url %q, got %q", "https://github.com/libgit2/TestGitRepository", remote.Url())
+	}
+}
+
+func TestRemoteCreateWithOptionsAppliesInsteadof(t *testing.T) {
+	t.Parallel()
+	repo := createTestRepo(t)
+	defer cleanupTestRepo(t, repo)
+
+	config, err := repo.Config()
+	checkFatal(t, err)
+	err = config.SetString("url.git@github.com:.insteadof", "https://github.com/")
+	checkFatal(t, err)
+
+	option, err := DefaultRemoteCreateOptions()
+	checkFatal(t, err)
+	option.Name = "origin"
+
+	remote, err := repo.Remotes.CreateWithOptions("https://github.com/libgit2/TestGitRepository", option)
+	checkFatal(t, err)
+	defer remote.Free()
+
+	if remote.Url() != "git@github.com:libgit2/TestGitRepository" {
+		t.Fatalf("expected insteadOf-rewritten url %q, got %q", "git@github.com:libgit2/TestGitRepository", remote.Url())
+	}
+}
+
+func TestDefaultRemoteCreateOptions(t *testing.T) {
+	t.Parallel()
+
+	option, err := DefaultRemoteCreateOptions()
+	checkFatal(t, err)
+	if option == nil {
+		t.Fatal("expected non-nil options")
+	}
+
+	other, err := DefaultRemoteCreateOptions()
+	checkFatal(t, err)
+	if other == nil {
+		t.Fatal("expected non-nil options")
+	}
+	if option == other {
+		t.Fatal("expected a freshly allocated options struct on each call")
+	}
+}
