+class TestDBClusterSnapshotFilters:
+    mock = mock_rds()
+
+    @classmethod
+    def setup_class(cls):
+        cls.mock.start()
+        client = boto3.client("rds", region_name="us-west-2")
+        # We'll set up two instances (one postgres, one mysql)
+        # with two snapshots each.
+        for i in range(2):
+            _id = f"db-cluster-{i}"
+            client.create_db_cluster(
+                DBClusterIdentifier=_id,
+                Engine="postgres",
+                MasterUsername="root",
+                MasterUserPassword="hunter2000",
+            )
+
+            for j in range(2):
+                client.create_db_cluster_snapshot(
+                    DBClusterIdentifier=_id,
+                    DBClusterSnapshotIdentifier=f"snapshot-{i}-{j}",
+                )
+        cls.client = client
+
+    @classmethod
+    def teardown_class(cls):
+        try:
+            cls.mock.stop()
+        except RuntimeError:
+            pass
+
+    def test_invalid_filter_name_raises_error(self):
+        with pytest.raises(ClientError) as ex:
+            self.client.describe_db_cluster_snapshots(
+                Filters=[{"Name": "invalid-filter-name", "Values": []}]
+            )
+        ex.value.response["Error"]["Code"].should.equal("InvalidParameterValue")
+        ex.value.response["Error"]["Message"].should.equal(
+            "Unrecognized filter name: invalid-filter-name"
+        )
+
+    def test_empty_filter_values_raises_error(self):
+        with pytest.raises(ClientError) as ex:
+            self.client.describe_db_cluster_snapshots(
+                Filters=[{"Name": "snapshot-type", "Values": []}]
+            )
+        ex.value.response["Error"]["Code"].should.equal("InvalidParameterCombination")
+        ex.value.response["Error"]["Message"].should.contain("must not be empty")
+
+    def test_snapshot_type_filter(self):
+        self.client.create_db_cluster(
+            DBClusterIdentifier="snapshot-type-filter-cluster",
+            Engine="postgres",
+            MasterUsername="root",
+            MasterUserPassword="hunter2000",
+        )
+        self.client.create_db_cluster_snapshot(
+            DBClusterIdentifier="snapshot-type-filter-cluster",
+            DBClusterSnapshotIdentifier="snapshot-type-filter-manual",
+        )
+        self.client.delete_db_cluster(
+            DBClusterIdentifier="snapshot-type-filter-cluster",
+            FinalDBSnapshotIdentifier="snapshot-type-filter-automated",
+        )
+
+        manual = self.client.describe_db_cluster_snapshots(
+            Filters=[{"Name": "snapshot-type", "Values": ["manual"]}]
+        )["DBClusterSnapshots"]
+        assert {snapshot["DBClusterSnapshotIdentifier"] for snapshot in manual} == {
+            "snapshot-0-0",
+            "snapshot-0-1",
+            "snapshot-1-0",
+            "snapshot-1-1",
+            "snapshot-type-filter-manual",
+        }
+        assert all(snapshot["SnapshotType"] == "manual" for snapshot in manual)
+
+        automated = self.client.describe_db_cluster_snapshots(
+            Filters=[{"Name": "snapshot-type", "Values": ["automated"]}]
+        )["DBClusterSnapshots"]
+        assert {snapshot["DBClusterSnapshotIdentifier"] for snapshot in automated} == {
+            "snapshot-type-filter-automated"
+        }
+        assert all(snapshot["SnapshotType"] == "automated" for snapshot in automated)
