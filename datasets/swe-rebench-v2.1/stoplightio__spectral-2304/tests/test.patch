+
+  test.concurrent('should associate async diagnostics with their source locations', async () => {
+    const spectral = new Spectral();
+    const documentUri = path.join(__dirname, './__fixtures__/test.json');
+    spectral.setRuleset({
+      rules: {
+        'valid-type': {
+          given: '$..type',
+          then: {
+            async function() {
+              return [
+                {
+                  message: 'Restricted type',
+                },
+              ];
+            },
+          },
+        },
+      },
+    });
+
+    const document = new Document(
+      JSON.stringify(
+        {
+          oneOf: [
+            {
+              type: ['number'],
+            },
+            {
+              type: ['string'],
+            },
+          ],
+        },
+        null,
+        2,
+      ),
+      Parsers.Json,
+      documentUri,
+    );
+
+    const results = spectral.run(document);
+
+    const diagnostics = await results;
+
+    expect(diagnostics).toHaveLength(2);
+    expect(diagnostics).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({
+          code: 'valid-type',
+          range: expect.objectContaining({ start: expect.objectContaining({ line: 3 }) }),
+          severity: DiagnosticSeverity.Warning,
+        }),
+        expect.objectContaining({
+          code: 'valid-type',
+          range: expect.objectContaining({ start: expect.objectContaining({ line: 8 }) }),
+          severity: DiagnosticSeverity.Warning,
+        }),
+      ]),
+    );
+  });
 });
