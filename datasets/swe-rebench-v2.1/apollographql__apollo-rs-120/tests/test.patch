+/// The AST exposes its parsing errors as an iterator, so callers can consume
+/// them directly without first converting an `IntoIterator` value.
+#[test]
+fn syntax_tree_errors_returns_all_errors_as_an_iterator() {
+    let ast = Parser::new("type A { f: String ? ? }").parse();
+    let errors: Vec<_> = ast.errors().collect();
+    assert_eq!(errors.len(), 2, "expected every lexical error to be exposed");
+}
