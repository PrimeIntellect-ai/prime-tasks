diff --git a/src/content/dom/hasInteractiveDescendant.test.ts b/src/content/dom/hasInteractiveDescendant.test.ts
new file mode 100644
index 0000000..c7515f8
--- /dev/null
+++ b/src/content/dom/hasInteractiveDescendant.test.ts
@@ -0,0 +1,20 @@
+import { afterEach, describe, expect, test } from "vitest";
+import { buttonTips } from "./tips/buttonTips";
+
+describe("nested interactive button content", () => {
+  afterEach(() => {
+    document.body.innerHTML = "";
+  });
+
+  test("a button reports an error when it contains a link", () => {
+    const button = document.createElement("button");
+    button.appendChild(document.createTextNode("Outer button"));
+    const link = document.createElement("a");
+    link.href = "https://example.com";
+    link.textContent = "Inner link";
+    button.appendChild(link);
+    document.body.appendChild(button);
+
+    expect(buttonTips(button).some((tip) => tip.type === "error")).toBe(true);
+  });
+});
diff --git a/src/content/dom/hasTabIndexDescendant.test.ts b/src/content/dom/hasTabIndexDescendant.test.ts
new file mode 100644
index 0000000..f87ff6d
--- /dev/null
+++ b/src/content/dom/hasTabIndexDescendant.test.ts
@@ -0,0 +1,22 @@
+import { afterEach, describe, expect, test } from "vitest";
+import { linkTips } from "./tips/linkTips";
+
+describe("nested interactive link content", () => {
+  afterEach(() => {
+    document.body.innerHTML = "";
+  });
+
+  test("a link reports an error for a button inside a noninteractive container", () => {
+    const link = document.createElement("a");
+    link.href = "https://example.com";
+    link.textContent = "Outer link";
+    const container = document.createElement("div");
+    const button = document.createElement("button");
+    button.textContent = "Inner button";
+    container.appendChild(button);
+    link.appendChild(container);
+    document.body.appendChild(link);
+
+    expect(linkTips(link).some((tip) => tip.type === "error")).toBe(true);
+  });
+});
diff --git a/src/content/dom/tips/buttonTips.test.ts b/src/content/dom/tips/buttonTips.test.ts
