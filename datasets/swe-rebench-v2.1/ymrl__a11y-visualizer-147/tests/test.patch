     expect(result[0].type).toBe("error");
     expect(result[0].content).toBe("messages.noName");
   });
+
+  test("nested interactive", () => {
+    const element = document.createElement("div");
+    element.role = "button";
+    element.tabIndex = 0;
+    element.appendChild(new Text("Hello"));
+    const button = document.createElement("button");
+    button.textContent = "world";
+    element.appendChild(button);
+    document.body.appendChild(element);
+    const result = buttonTips(element);
+    expect(result.some((tip) => tip.type === "error")).toBe(true);
+  });
+
+  test("button containing a link reports an error", () => {
+    const element = document.createElement("button");
+    element.appendChild(document.createTextNode("Outer button"));
+    const link = document.createElement("a");
+    link.href = "https://example.com";
+    link.textContent = "Inner link";
+    element.appendChild(link);
+    document.body.appendChild(element);
+
+    const result = buttonTips(element);
+
+    expect(result.some((tip) => tip.type === "error")).toBe(true);
+  });
+
+  test("button containing a nested button reports an error", () => {
+    const element = document.createElement("button");
+    element.appendChild(document.createTextNode("Outer button"));
+    const container = document.createElement("div");
+    const nestedButton = document.createElement("button");
+    nestedButton.textContent = "Inner button";
+    container.appendChild(nestedButton);
+    element.appendChild(container);
+    document.body.appendChild(element);
+
+    const result = buttonTips(element);
+
+    expect(result.some((tip) => tip.type === "error")).toBe(true);
+  });
 });
