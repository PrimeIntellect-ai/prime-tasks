diff --git a/src/content/dom/hasInteractiveDescendant.ts b/src/content/dom/hasInteractiveDescendant.ts
new file mode 100644
index 0000000..6a4001e
--- /dev/null
+++ b/src/content/dom/hasInteractiveDescendant.ts
@@ -0,0 +1,18 @@
+export const hasInteractiveDescendant = (el: Element): boolean => {
+  return !!el.querySelector(
+    [
+      "a[href]",
+      "audio[controls]",
+      "button",
+      "details",
+      "embed",
+      "iframe",
+      "img[usemap]",
+      'input:not([type="hidden"])',
+      "label",
+      "select",
+      "textarea",
+      "video",
+    ].join(","),
+  );
+};
