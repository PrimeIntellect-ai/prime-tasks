+func TestBuildErrors(t *testing.T) {
+	const childEnv = "API_LINTER_TEST_BUILD_ERRORS_CHILD"
+	if os.Getenv(childEnv) == "1" {
+		err := runCLI([]string{"internal/testdata/build_errors.proto"})
+		if err == nil {
+			t.Fatal("expected build error for build_errors.proto")
+		}
+		fmt.Fprintln(os.Stderr, err)
+		return
+	}
+
+	cmd := exec.Command(os.Args[0], "-test.run=^TestBuildErrors$")
+	cmd.Env = append(os.Environ(), childEnv+"=1")
+	output, _ := cmd.CombinedOutput()
+	actual := string(output)
+	for _, location := range []string{":8:1:", ":13:1:"} {
+		if !strings.Contains(actual, location) {
+			t.Errorf("expected CLI output to report build error at %s, got %q", location, actual)
+		}
+	}
+}
