+    def test_add_route_without_is_authenticated_matches_both_states(self):
+        config = self._makeOne(autocommit=True)
+        config.add_route('name', 'path')
+        mapper = config.get_routes_mapper()
+
+        for authenticated in (False, True):
+            request = self._makeRequest(config)
+            request.path_info = '/path'
+            request.is_authenticated = authenticated
+            self.assertEqual(mapper(request)['route'].name, 'name')
+
+    def test_add_route_with_is_authenticated(self):
+        config = self._makeOne(autocommit=True)
+        config.add_route('name', 'path', is_authenticated=True)
+        mapper = config.get_routes_mapper()
+
+        request = self._makeRequest(config)
+        request.path_info = '/path'
+        request.is_authenticated = True
+        self.assertEqual(mapper(request)['route'].name, 'name')
+
+        request = self._makeRequest(config)
+        request.path_info = '/path'
+        request.is_authenticated = False
+        self.assertIsNone(mapper(request)['route'])
+
+    def test_add_route_with_is_authenticated_false(self):
