+fn email_autolinks_follow_email_address_syntax() {
+    let cases = [
+        ("<a@b>", "<p><a href=\"mailto:a@b\">a@b</a></p>\n"),
+        ("<a@b.c>", "<p><a href=\"mailto:a@b.c\">a@b.c</a></p>\n"),
+        ("<a+b@b.c>", "<p><a href=\"mailto:a+b@b.c\">a+b@b.c</a></p>\n"),
+        ("<a..b@b.c>", "<p><a href=\"mailto:a..b@b.c\">a..b@b.c</a></p>\n"),
+        ("<@1>", "<p>&lt;@1&gt;</p>\n"),
+        ("<@b.c>", "<p>&lt;@b.c&gt;</p>\n"),
+        ("<foo@-example.com>", "<p>&lt;foo@-example.com&gt;</p>\n"),
+        ("<foo@example-.com>", "<p>&lt;foo@example-.com&gt;</p>\n"),
+        ("<a@notrailingperiod.>", "<p>&lt;a@notrailingperiod.&gt;</p>\n"),
+        ("<a(noparens)@example.com>", "<p>&lt;a(noparens)@example.com&gt;</p>\n"),
+    ];
+    for (original, expected) in cases {
+        test_markdown_html(original, expected, false, false, false);
+    }
+
+    let label_63 = "a".repeat(63);
+    let valid = format!("<u@{}.example>", label_63);
+    let valid_html = format!("<p><a href=\"mailto:u@{}.example\">u@{}.example</a></p>\n", label_63, label_63);
+    test_markdown_html(&valid, &valid_html, false, false, false);
+
+    let label_64 = "a".repeat(64);
