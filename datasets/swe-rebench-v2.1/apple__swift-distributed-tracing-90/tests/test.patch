--- a/Tests/TracingTests/TracerTests.swift
+++ b/Tests/TracingTests/TracerTests.swift
@@ -253,6 +253,61 @@ final class TracerTests: XCTestCase {
         #endif
     }
 
+    func testWithSpan_recordErrorWithAttributes() throws {
+        #if swift(>=5.5) && canImport(_Concurrency)
+        guard #available(macOS 10.15, iOS 13.0, tvOS 13.0, watchOS 6.0, *) else {
+            throw XCTSkip("Task locals are not supported on this platform.")
+        }
+
+        let tracer = TestTracer()
+        InstrumentationSystem.bootstrapInternal(tracer)
+        defer {
+            InstrumentationSystem.bootstrapInternal(nil)
+        }
+
+        var endedSpan: TestSpan?
+        tracer.onEndSpan = { span in endedSpan = span }
+
+        let errorToThrow = ExampleSpanError()
+        let attrsForError: SpanAttributes = [
+            "exception.type": "caller supplied type",
+            "request.id": "req-123",
+        ]
+
+        tracer.withSpan("hello") { span in
+            span.recordError(errorToThrow, attributes: attrsForError)
+        }
+
+        XCTAssertTrue(endedSpan != nil)
+        XCTAssertEqual(endedSpan!.recordedErrors.count, 1)
+        let (error, eventAttributes) = endedSpan!.recordedErrors[0]
+        XCTAssertEqual(error as? ExampleSpanError, errorToThrow)
+        XCTAssertEqual(eventAttributes["exception.type"]?.toSpanAttribute(), "caller supplied type")
+        XCTAssertEqual(eventAttributes["request.id"]?.toSpanAttribute(), "req-123")
+        XCTAssertNotNil(eventAttributes["exception.message"])
+        #endif
+    }
+
+    func testWithSpan_recordErrorWithoutAttributes() {
+        let tracer = TestTracer()
+        InstrumentationSystem.bootstrapInternal(tracer)
+        defer {
+            InstrumentationSystem.bootstrapInternal(nil)
+        }
+
+        var endedSpan: TestSpan?
+        tracer.onEndSpan = { span in endedSpan = span }
+        let errorToThrow = ExampleSpanError()
+
+        tracer.withSpan("hello") { span in
+            span.recordError(errorToThrow)
+        }
+
+        XCTAssertTrue(endedSpan != nil)
+        XCTAssertEqual(endedSpan!.recordedErrors.count, 1)
+        XCTAssertEqual(endedSpan?.recordedErrors.first?.0 as? ExampleSpanError, errorToThrow)
+    }
+
     #if swift(>=5.5) && canImport(_Concurrency)
     @available(macOS 10.15, iOS 13.0, tvOS 13.0, watchOS 6.0, *)
