+#[test]
+fn test_binomial_coefficient_example_collapses_conditional_layers() {
+    let example = include_str!("../../examples/binomial_coefficient.nbt");
+    let function = example
+        .split("fn binomial_coefficient")
+        .nth(1)
+        .unwrap()
+        .split("assert_eq")
+        .next()
+        .unwrap();
+    let conditional_layers = function
+        .lines()
+        .filter(|line| line.split_whitespace().any(|word| word == "if"))
+        .count();
+    assert!(
+        conditional_layers < 5,
+        "the binomial coefficient example should collapse some conditional layers"
+    );
+}
+
+#[test]
+fn test_logical() {
+    // negation
+    expect_output("!true", "false");
+    expect_output("!false", "true");
+
+    // or
+    expect_output("true || false", "true");
+    expect_output("false || false", "false");
+
+    // and
+    expect_output("true && false", "false");
+    expect_output("true && true", "true");
+
+    // precedence in mixed expressions
+    expect_output("false || true && false", "false");
+    expect_output("false || true && !false", "true");
+    expect_output("true || false && false", "true");
+    expect_output("false && true || true", "true");
+    expect_output("!false && false", "false");
+    expect_output("!false || false && false", "true");
+
+    // Non-Boolean operands are rejected, regardless of which operand is invalid.
+    let _ = fail("1 || 2");
+    let _ = fail("true || 2");
+    let _ = fail("1 || true");
+    let _ = fail("1 && 2");
+    let _ = fail("true && 2");
+    let _ = fail("1 && true");
+    let _ = fail("!1");
+    let _ = fail("!1 || true");
+}
