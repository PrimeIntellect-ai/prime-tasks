+    @Test
+    void testRobotsAndRequestPathsWithUnicodeCharacters() {
+        final String simpleRobotsTxt = "User-agent: *" + CRLF //
+                        + "Disallow: /bücher/" + CRLF //
+                        + "Disallow: /k%C3%B6nyvek/" + CRLF //
+                        + "Disallow: /foo/bar/ツ" + CRLF //
+                        + CRLF //
+                        + "User-agent: GoodBot" + CRLF //
+                        + "Allow: /";
+
+        BaseRobotRules rules = createRobotRules("mybot", simpleRobotsTxt);
+        assertTrue(rules.isAllowed("https://www.example.com/"));
+
+        // test using escaped and unescaped URLs
+        assertFalse(rules.isAllowed("https://www.example.com/b%C3%BCcher/book1.html"));
+        assertFalse(rules.isAllowed("https://www.example.com/bücher/book2.html"));
+
+        // (for completeness) check also escaped path in robots.txt
+        assertFalse(rules.isAllowed("https://www.example.com/k%C3%B6nyvek/book1.html"));
+        assertFalse(rules.isAllowed("https://www.example.com/könyvek/book2.html"));
+
+        // three-byte UTF-8 character (example from RFC 9309 / reference parser)
+        assertFalse(rules.isAllowed("https://www.example.com/foo/bar/%E3%83%84"));
+        assertFalse(rules.isAllowed("https://www.example.com/foo/bar/ツ"));
+    }
+
+    @Test
+    void testUnicodeUnescapedPathsInAllowDirective() {
+        // RFC 9309 section 2.2.2 applies to both Allow and Disallow paths
+        final String robotsTxt = "User-agent: *" + CRLF //
+                        + "Disallow: /" + CRLF //
+                        + "Allow: /öffentlich/" + CRLF;
+
+        BaseRobotRules rules = createRobotRules("mybot", robotsTxt);
+        assertTrue(rules.isAllowed("https://www.example.com/%C3%B6ffentlich/page.html"));
+        assertTrue(rules.isAllowed("https://www.example.com/öffentlich/page.html"));
+        assertFalse(rules.isAllowed("https://www.example.com/other.html"));
+    }
+
+    @Test
+    void testReservedCharactersInPaths() {
+        // RFC 9309 section 2.2.2: octets in the reserved range must be
+        // percent-encoded before comparison. A reserved character written
+        // unescaped in robots.txt must match its percent-encoded URL form.
+        final String robotsTxt = "User-agent: *" + CRLF //
+                        + "Disallow: /foo;bar/" + CRLF //
+                        + "Disallow: /baz,qux/" + CRLF;
+
+        BaseRobotRules rules = createRobotRules("mybot", robotsTxt);
+        assertFalse(rules.isAllowed("https://www.example.com/foo%3Bbar/page.html"));
+        assertFalse(rules.isAllowed("https://www.example.com/foo;bar/page.html"));
+        assertFalse(rules.isAllowed("https://www.example.com/baz%2Cqux/page.html"));
+        assertTrue(rules.isAllowed("https://www.example.com/other/page.html"));
+    }
