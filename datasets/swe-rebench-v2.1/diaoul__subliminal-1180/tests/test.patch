+def test_cli_provider_options_help() -> None:
+    """The CLI help can be rendered successfully."""
+    from click.testing import CliRunner
+
+    from subliminal.cli import subliminal
+
+    result = CliRunner().invoke(subliminal, ['--help'])
+    assert result.exit_code == 0
+
