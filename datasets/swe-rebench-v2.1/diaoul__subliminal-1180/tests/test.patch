+def test_cli_provider_options() -> None:
+    """Provider and refiner arguments can be passed through CLI options."""
+    from click.testing import CliRunner
+
+    from subliminal.cli import subliminal
+
+    result = CliRunner().invoke(
+        subliminal,
+        ['--provider.opensubtitles.username=user', '--refiner.omdb.apikey=key', 'cache'],
+    )
+    assert result.exit_code == 0
+
+
+def test_cli_provider_options_passed_to_provider(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """Provider arguments given on the CLI are forwarded as keyword arguments to the provider constructor."""
+    from click.testing import CliRunner
+
+    from subliminal.cli import subliminal
+    from subliminal.exceptions import ConfigurationError
+    from subliminal.providers.opensubtitles import OpenSubtitlesProvider
+
+    received: list[dict[str, Any]] = []
+
+    def fake_init(self: object, **kwargs: Any) -> None:
+        received.append(kwargs)
+        raise ConfigurationError('stub')
+
+    monkeypatch.setattr(OpenSubtitlesProvider, '__init__', fake_init)
+
+    video = tmp_path / 'Man.of.Steel.2013.720p.BluRay.x264-Felony.mkv'
+    video.touch()
+
+    CliRunner().invoke(
+        subliminal,
+        [
+            '--provider.opensubtitles.username=user',
+            'download',
+            '-R',
+            'ALL',
+            '-l',
+            'en',
+            '-p',
+            'opensubtitles',
+            str(video),
+        ],
+    )
+    assert any(kwargs.get('username') == 'user' for kwargs in received)
+
+
+def test_opensubtitles_username_without_password_raises() -> None:
+    """Supplying a username without a password raises a ConfigurationError."""
+    from subliminal.exceptions import ConfigurationError
+    from subliminal.providers.opensubtitles import OpenSubtitlesProvider
+
+    with pytest.raises(ConfigurationError):
+        OpenSubtitlesProvider(username='user')
+
+
+def test_cli_provider_option_names_with_underscores() -> None:
+    """Names containing underscores remain valid in dynamic CLI options."""
+    from click.testing import CliRunner
+
+    from subliminal.cli import subliminal
+
+    result = CliRunner().invoke(
+        subliminal,
+        ['--provider.addic7ed.allow_searches=true', 'cache'],
+    )
+    assert result.exit_code == 0
+    assert 'Unknown option' not in result.output
+
+
+def test_cli_refiner_option_reaches_refiner(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """A refiner option supplied on the CLI is used by the selected refiner."""
+    from click.testing import CliRunner
+
+    from subliminal.cli import subliminal
+
+    from urllib.parse import parse_qs, urlparse
+
+    api_key = 'cli-refiner-test-key'
+
+    requested_api_keys: list[str] = []
+
+    class FakeResponse:
+        def raise_for_status(self) -> None:
+            pass
+
+        def json(self) -> dict[str, str]:
+            return {'Response': 'False', 'Error': 'Movie not found!'}
+
+    def fake_send(
+        session: requests.Session, request: requests.PreparedRequest, **kwargs: Any
+    ) -> FakeResponse:
+        requested_api_keys.extend(parse_qs(urlparse(request.url).query).get('apikey', []))
+        return FakeResponse()
+
+    monkeypatch.setattr(requests.Session, 'send', fake_send)
+
+    video = tmp_path / 'A.Unique.Movie.2017.mkv'
+    video.touch()
+    result = CliRunner().invoke(
+        subliminal,
+        [
+            f'--refiner.omdb.apikey={api_key}',
+            'download',
+            '--ignore-provider',
+            'ALL',
+            '--refiner',
+            'omdb',
+            '--language',
+            'en',
+            str(video),
+        ],
+    )
+
+    assert result.exit_code == 0
+    assert api_key in requested_api_keys
