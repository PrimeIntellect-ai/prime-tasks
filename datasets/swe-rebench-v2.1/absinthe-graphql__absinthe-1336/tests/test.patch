diff --git a/test/absinthe/execution/subscription_test.exs b/test/absinthe/execution/subscription_test.exs
index 34aa5435..faa872aa 100644
--- a/test/absinthe/execution/subscription_test.exs
+++ b/test/absinthe/execution/subscription_test.exs
@@ -314,6 +314,57 @@ defmodule Absinthe.Execution.SubscriptionTest do
     refute_receive({:broadcast, _})
   end
 
+  test "can unsubscribe from duplicate subscriptions individually" do
+    client_id = "abc"
+
+    assert {:ok, %{"subscribed" => topic1}} =
+             run_subscription(
+               @query,
+               Schema,
+               variables: %{"clientId" => client_id},
+               context: %{pubsub: PubSub}
+             )
+
+    assert {:ok, %{"subscribed" => topic2}} =
+             run_subscription(
+               @query,
+               Schema,
+               variables: %{"clientId" => client_id},
+               context: %{pubsub: PubSub}
+             )
+
+    Absinthe.Subscription.publish(PubSub, "foo", thing: client_id)
+    assert_receive({:broadcast, a})
+    assert_receive({:broadcast, b})
+    doc_ids = Enum.map([a, b], & &1.topic)
+    assert topic1 in doc_ids
+    assert topic2 in doc_ids
+
+    Absinthe.Subscription.unsubscribe(PubSub, topic1)
+    Absinthe.Subscription.publish(PubSub, "bar", thing: client_id)
+    assert_receive({:broadcast, a})
+    refute_receive({:broadcast, _})
+    assert topic2 == a.topic
+  end
+
+  test "unsubscribing one selection leaves a different selection registered" do
+    assert {:ok, %{"subscribed" => topic1}} =
+             run_subscription("subscription { user { id } }", Schema)
+
+    assert {:ok, %{"subscribed" => topic2}} =
+             run_subscription("subscription { user { name } }", Schema)
+
+    Absinthe.Subscription.unsubscribe(PubSub, topic1)
+    user = %{id: "1", name: "Alicia"}
+    Absinthe.Subscription.publish(PubSub, user, user: ["*", user.id])
+
+    assert_receive(
+      {:broadcast, %{topic: ^topic2, result: %{data: %{"user" => %{"name" => "Alicia"}}}}}
+    )
+
+    refute_receive({:broadcast, _})
+  end
+
   @query """
   subscription {
     multipleTopics
