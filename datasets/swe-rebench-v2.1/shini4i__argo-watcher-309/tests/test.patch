+
+func TestFireAndForgetAllowsStaleScheduledImage(t *testing.T) {
+	root, err := filepath.Abs("../..")
+	if err != nil {
+		t.Fatal(err)
+	}
+	program := `package main
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/shini4i/argo-watcher/cmd/argo-watcher/argocd"
+	"github.com/shini4i/argo-watcher/cmd/argo-watcher/config"
+	"github.com/shini4i/argo-watcher/internal/models"
+)
+
+type apiFake struct { application *models.Application }
+func (apiFake) Init(*config.ServerConfig) error { return nil }
+func (api apiFake) GetUserInfo() (*models.Userinfo, error) { return nil, nil }
+func (api apiFake) GetApplication(string) (*models.Application, error) { return api.application, nil }
+type stateFake struct { status string }
+func (*stateFake) Connect(*config.ServerConfig) error { return nil }
+func (*stateFake) Add(models.Task) (*models.Task, error) { return nil, nil }
+func (*stateFake) GetTasks(float64, float64, string) []models.Task { return nil }
+func (*stateFake) GetTask(string) (*models.Task, error) { return nil, nil }
+func (state *stateFake) SetTaskStatus(_ string, status string, _ string) error { state.status = status; return nil }
+func (*stateFake) Check() bool { return true }
+func (*stateFake) ProcessObsoleteTasks(uint) {}
+type metricsFake struct{}
+func (*metricsFake) AddFailedDeployment(string) {}
+func (*metricsFake) ResetFailedDeployment(string) {}
+func (*metricsFake) AddProcessedDeployment() {}
+func (*metricsFake) SetArgoUnavailable(bool) {}
+func (*metricsFake) AddInProgressTask() {}
+func (*metricsFake) RemoveInProgressTask() {}
+func main() {
+	application := &models.Application{}
+	application.Metadata.Annotations = map[string]string{"argo-watcher/fire-and-forget": "true"}
+	application.Status.Summary.Images = []string{"example.test/app:old"}
+	application.Status.Sync.Status = "Synced"
+	application.Status.Health.Status = "Healthy"
+	state := &stateFake{}
+	metrics := &metricsFake{}
+	argo := &argocd.Argo{}
+	argo.Init(state, apiFake{application: application}, metrics)
+	updater := &argocd.ArgoStatusUpdater{}
+	updater.Init(*argo, 1, 0*time.Second, "", false, &config.WebhookConfig{})
+	task := models.Task{Id: "fire-and-forget", App: "cron-app", Images: []models.Image{{Image: "example.test/app", Tag: "new"}}}
+	updater.WaitForRollout(task)
+	if state.status != models.StatusDeployedMessage {
+		panic(fmt.Sprintf("stale scheduled image did not complete deployment: status=%q", state.status))
+	}
+}
+`
+	programDir, err := os.MkdirTemp(root, "rebench-fire-and-forget-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(programDir)
+	programPath := filepath.Join(programDir, "fire_and_forget.go")
+	if err := os.WriteFile(programPath, []byte(program), 0600); err != nil {
+		t.Fatal(err)
+	}
+	command := exec.Command("go", "run", programPath)
+	command.Dir = root
+	output, err := command.CombinedOutput()
+	if err != nil {
+		t.Fatalf("rollout did not accept an old scheduled image when fire-and-forget was enabled: %v\n%s", err, output)
+	}
+}
