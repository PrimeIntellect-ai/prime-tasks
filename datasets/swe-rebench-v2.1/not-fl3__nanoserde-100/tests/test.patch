+
+#[test]
+fn toml_key_chars() {
+    let toml_str = r#"
+        [foo.bar.baz]
+        1234 = "value"
+        MyThing1 = "value2"
+        123abc456def = "myval"
+    "#;
+
+    assert_eq!(
+        TomlParser::parse(toml_str).unwrap(),
+        HashMap::from([
+            (
+                "foo.bar.baz.1234".to_string(),
+                Toml::Str("value".to_string())
+            ),
+            (
+                "foo.bar.baz.MyThing1".to_string(),
+                Toml::Str("value2".to_string())
+            ),
+            (
+                "foo.bar.baz.123abc456def".to_string(),
+                Toml::Str("myval".to_string())
+            ),
+        ])
+    );
+}
