+/**
+ * @fileoverview Enforces the order of meta properties
+ */
+
+'use strict';
+
+// ------------------------------------------------------------------------------
+// Requirements
+// ------------------------------------------------------------------------------
+
+const rule = require('../../../lib/rules/meta-property-ordering');
+const assert = require('assert');
+const ESLint = require('eslint');
+const RuleTester = ESLint.RuleTester;
+const Linter = ESLint.Linter;
+
+// ------------------------------------------------------------------------------
+// Tests
+// ------------------------------------------------------------------------------
+
+/**
+ * @param {string[]} order
+ * @returns {string}
+ */
+function getMessage (order) {
+  return `The meta properties should be placed in a consistent order: [${order.join(', ')}].`;
+}
+
+const ruleTester = new RuleTester({ parserOptions: { ecmaVersion: 6 } });
+ruleTester.run('test-case-property-ordering', rule, {
+  valid: [
+    `
+    module.exports = {
+      meta: {type, docs, fixable, schema, messages},
+      create() {},
+    };`,
+
+    `
+    module.exports = {
+      meta: {docs, schema, messages},
+      create() {},
+    };`,
+
+    `
+    module.exports = {
+      meta: {
+        type: 'problem',
+        docs: {},
+        fixable: 'code',
+        schema: [],
+        messages: {}
+      },
+      create() {},
+    };`,
+    `
+    module.exports = {
+      meta: {},
+      create() {},
+    };`,
+  ],
+
+  invalid: [],
+});
+
+// A malformed meta object may produce more than one diagnostic. The contract
+// specifies the diagnostic wording and default order, but not the number of
+// diagnostics or whether absent default properties appear in the message.
+const linter = new Linter();
+linter.defineRule('meta-property-ordering', rule);
+const samples = [
+  {
+    code: `
+      module.exports = {
+        meta: { docs, fixable, type: 'problem' },
+        create() {},
+      };`,
+    orders: [
+      ['type', 'docs', 'fixable'],
+      ['type', 'docs', 'fixable', 'schema', 'messages'],
+    ],
+  },
+  {
+    code: `
+      module.exports = {
+        meta: { docs, type, fixable, schema },
+        create() {},
+      };`,
+    orders: [
+      ['type', 'docs', 'fixable', 'schema'],
+      ['type', 'docs', 'fixable', 'schema', 'messages'],
+    ],
+  },
+];
+
+samples.forEach(({ code, orders }) => {
+  const messages = linter.verify(code, {
+    parserOptions: { ecmaVersion: 6 },
+    rules: { 'meta-property-ordering': 'error' },
+  });
+  const expectedMessages = orders.map(getMessage);
+
+  assert(messages.length > 0, 'an ordering violation should be reported');
+  messages.forEach(({ message }) => {
+    assert(
+      expectedMessages.includes(message),
+      `unexpected diagnostic message: ${message}`
+    );
+  });
+});
