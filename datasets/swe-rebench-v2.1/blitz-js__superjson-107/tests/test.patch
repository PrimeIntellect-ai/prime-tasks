+
+test('explicit colliding identifiers do not reject registration', () => {
+  const registry = new Registry<Class>(c => c.name);
+
+  class Car {
+    honk() {
+      console.log('honk');
+    }
+  }
+  registry.register(Car);
+
+  const warnSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+  const anotherCar = class Car {};
+
+  expect(() => registry.register(anotherCar, 'Car')).not.toThrow();
+  expect(warnSpy).toHaveBeenCalledWith(
+    'Ambiguous class "Car", provide a unique identifier.'
+  );
+
+  warnSpy.mockRestore();
+});
