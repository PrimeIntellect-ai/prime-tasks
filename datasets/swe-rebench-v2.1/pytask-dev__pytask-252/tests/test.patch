+def _live_execution(live_manager, n_entries_in_table, verbose, editor_url_scheme):
+    args = (live_manager, n_entries_in_table, verbose, editor_url_scheme)
+    try:
+        return LiveExecution(*args)
+    except TypeError as positional_error:
+        try:
+            return LiveExecution(
+                live_manager=live_manager,
+                n_entries_in_table=n_entries_in_table,
+                verbose=verbose,
+                editor_url_scheme=editor_url_scheme,
+            )
+        except TypeError:
+            raise positional_error
+
+
