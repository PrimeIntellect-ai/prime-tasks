+def test_get_default_logging_config_pythonw_detection(monkeypatch):
+    """Logging configuration follows whether the executable is pythonw.exe."""
+    import importlib
+
+    import traitlets.config.application as application_module
+
+    monkeypatch.setattr(sys, "executable", "/usr/bin/pythonw.exe")
+    importlib.reload(application_module)
+    try:
+        config = application_module.Application().get_default_logging_config()
+        assert "handlers" not in config
+        assert "loggers" not in config
+    finally:
+        monkeypatch.undo()
+        importlib.reload(application_module)
+
+    monkeypatch.setattr(sys, "executable", "/usr/bin/python")
+    importlib.reload(application_module)
+    try:
+        config = application_module.Application().get_default_logging_config()
+        assert "handlers" in config
+        assert "loggers" in config
+    finally:
+        monkeypatch.undo()
+        importlib.reload(application_module)
+
