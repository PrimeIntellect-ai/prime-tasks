+use std::{
+    fs::{self, create_dir_all},
+    path::Path,
+    time::{SystemTime, UNIX_EPOCH},
+};
+
+use anyhow::{Context, Result};
+use swc_core::{
+    base::{
+        config::{ConfigFile, Options},
+        try_with_handler, Compiler, HandlerOpts,
+    },
+    common::{errors::ColorConfig, sync::Lrc, FilePathMapping, Globals, SourceMap, GLOBALS},
+};
+
+#[test]
+fn issue_8265_1() -> Result<()> {
+    let pwd = Path::new("tests/fixture-manual/8265").canonicalize()?;
+    let unique = SystemTime::now().duration_since(UNIX_EPOCH)?.as_nanos();
+    let tmp = std::env::temp_dir().join(format!("swc-issue-8265-{}-{unique}", std::process::id()));
+
+    create_dir_all(tmp.join("src/modules/moduleA"))?;
+    create_dir_all(tmp.join("src/modules/moduleB"))?;
+
+    symlink(&pwd.join(".swcrc"), &tmp.join(".swcrc"));
+    symlink(&pwd.join("src/index.ts"), &tmp.join("src/index.ts"));
+    symlink(
+        &pwd.join("src/modules/moduleA/index.ts"),
+        &tmp.join("src/modules/moduleA/index.ts"),
+    );
+    symlink(
+        &pwd.join("src/modules/moduleB/index.ts"),
+        &tmp.join("src/modules/moduleB/index.ts"),
+    );
+
+    let cm = Lrc::new(SourceMap::new(FilePathMapping::empty()));
+    let output = GLOBALS.set(&Globals::default(), || {
+        try_with_handler(
+            cm.clone(),
+            HandlerOpts {
+                skip_filename: true,
+                color: ColorConfig::Never,
+            },
+            |handler| {
+                let compiler = Compiler::new(cm.clone());
+                let fm = cm.load_file(&tmp.join("src/index.ts"))?;
+                let output = compiler.process_js_file(
+                    fm,
+                    handler,
+                    &Options {
+                        cwd: tmp.clone(),
+                        config_file: Some(ConfigFile::Str(
+                            tmp.join(".swcrc").to_string_lossy().into_owned(),
+                        )),
+                        ..Default::default()
+                    },
+                )?;
+                Ok::<_, anyhow::Error>(output.code)
+            },
+        )
+    })?;
+
+    let require = output
+        .split("require(")
+        .nth(1)
+        .context("compiled output has no require call")?;
+    let specifier = require
+        .split(|ch| ch == '"' || ch == '\'')
+        .nth(1)
+        .context("compiled require has no string specifier")?;
+    assert!(
+        specifier.starts_with("./modules/moduleA"),
+        "expected a relative path to moduleA, got {specifier:?} in {output}"
+    );
+
+    fs::remove_dir_all(&tmp)?;
+
+    Ok(())
+}
+
+/// ln -s $a $b
+fn symlink(a: &Path, b: &Path) {
+    #[cfg(unix)]
+    {
+        std::os::unix::fs::symlink(a, b).unwrap();
+    }
+
+    #[cfg(windows)]
+    {
+        std::os::windows::fs::symlink_file(a, b).unwrap();
+    }
+}
