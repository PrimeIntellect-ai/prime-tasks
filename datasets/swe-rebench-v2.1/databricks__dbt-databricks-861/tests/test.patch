+class TestAlterRelationAddRemoveColumns(MacroTestBase):
+    @pytest.fixture
+    def template_name(self) -> str:
+        return "columns.sql"
+
+    @pytest.fixture(scope="class")
+    def macro_folders_to_load(self) -> list:
+        return ["macros/adapters", "macros"]
+
+    @pytest.fixture(scope="class", autouse=True)
+    def modify_context(self, default_context) -> None:
+        default_context["api"] = Mock(Column=DatabricksColumn)
+        default_context["exceptions"] = Mock()
+        default_context["captured"] = []
+
+        def statement(name, caller):
+            sql = caller()
+            default_context["captured"].append(sql)
+            return sql
+
+        default_context["statement"] = statement
+        default_context["run_query"] = lambda sql: default_context["captured"].append(sql)
+
+    def test_add_columns_are_backticked(self, template, relation):
+        template.globals["captured"].clear()
+        columns = [DatabricksColumn("new-column", "string")]
+        self.run_macro(
+            template, "databricks__alter_relation_add_remove_columns", relation, columns, None
+        )
+        captured = template.globals["captured"]
+        assert any("`new-column`" in sql for sql in captured)
