 ⚠ 1 problem (0 errors, 1 warning)
@@ -71,7 +72,7 @@ Warnings:
 		},
 		{
 			formatter: &formatter.Plain{},
-			want:      `test.go:2:5: test failure https://github.com/mgechev/revive/blob/master/RULES_DESCRIPTIONS.md#rule`,
+			want:      `test.go:2:5: test failure https://revive.run/r#rule`,
 		},
 		{
 			formatter: &formatter.Sarif{},
@@ -102,7 +103,7 @@ Warnings:
       ],
       "tool": {
         "driver": {
-          "informationUri": "https://github.com/mgechev/revive",
+          "informationUri": "https://revive.run",
           "name": "revive"
         }
       }
@@ -116,7 +117,7 @@ Warnings:
 			formatter: &formatter.Stylish{},
 			want: `
 test.go
-  (2, 5)  https://github.com/mgechev/revive/blob/master/RULES_DESCRIPTIONS.md#rule  test failure  
+  (2, 5)  https://revive.run/r#rule  test failure  
 
 
  ✖ 1 problem (0 errors) (1 warning)
@@ -157,11 +158,29 @@ test.go
 			if len(stdout) > 0 {
 				t.Errorf("formatter wrote to stdout: %q", stdout)
 			}
-			got := strings.TrimSpace(output)
-			want := strings.TrimSpace(td.want)
+			if strings.Contains(td.want, "https://revive.run/") && !ruleLinkRE.MatchString(output) {
+				t.Errorf("expected a revive.run rule description link naming the rule in %q", output)
+			}
+			got := normalizeLinks(strings.TrimSpace(output))
+			want := normalizeLinks(strings.TrimSpace(td.want))
 			if got != want {
 				t.Errorf("got %q, want %q", got, want)
 			}
 		})
 	}
 }
+
+// ruleLinkRE matches a revive.run link that identifies the rule by name.
+var ruleLinkRE = regexp.MustCompile(`https://revive\.run/\S*rule\b`)
+
+var (
+	ruleURLRE = regexp.MustCompile(`https://revive\.run/\S*`)
+	infoURIRE = regexp.MustCompile(`"informationUri": "[^"]*"`)
+)
+
+// normalizeLinks masks the exact location of rule description links and
+// the SARIF informationUri, so that only the rest of the output is compared.
+func normalizeLinks(s string) string {
+	s = ruleURLRE.ReplaceAllString(s, "<rule-url>")
+	return infoURIRE.ReplaceAllString(s, `"informationUri": "<info-uri>"`)
+}
