+func TestTriggerWFWithAvailableLock(t *testing.T) {
+	assert := assert.New(t)
+	kube := fake.NewSimpleClientset()
+	var cm v1.ConfigMap
+	err := yaml.Unmarshal([]byte(configMap), &cm)
+	cm.Data["workflow"] = "3"
+	assert.NoError(err)
+	_, err = kube.CoreV1().ConfigMaps("default").Create(&cm)
+	assert.NoError(err)
+	syncLimitFunc := GetSyncLimitFunc(kube)
+	t.Run("TriggerWfsWithAvailableLocks", func(t *testing.T) {
+		var triggeredKeys []string
+		concurrenyMgr := NewLockManager(syncLimitFunc, func(key string) {
+			triggeredKeys = append(triggeredKeys, key)
+		})
+		var wfs []wfv1.Workflow
+		for i := 0; i < 3; i++ {
+			wf := unmarshalWF(wfWithSemaphore)
+			wf.Name = fmt.Sprintf("%s-%d", "acquired", i)
+			status, _, _, err := concurrenyMgr.TryAcquire(wf, "", wf.Spec.Synchronization)
+			assert.NoError(err)
+			assert.True(status)
+			wfs = append(wfs, *wf)
+
+		}
+		var waitingWfs []*wfv1.Workflow
+		for i := 0; i < 3; i++ {
+			wf := unmarshalWF(wfWithSemaphore)
+			wf.Name = fmt.Sprintf("%s-%d", "wait", i)
+			status, _, msg, _ := concurrenyMgr.TryAcquire(wf, "", wf.Spec.Synchronization)
+			assert.NotEmpty(msg)
+			assert.False(status)
+			waitingWfs = append(waitingWfs, wf)
+		}
+		concurrenyMgr.Release(&wfs[0], "", wfs[0].Spec.Synchronization)
+		triggeredKeys = nil
+		concurrenyMgr.Release(&wfs[1], "", wfs[1].Spec.Synchronization)
+		assert.Equal(2, len(triggeredKeys))
+		for _, key := range triggeredKeys {
+			assert.Contains([]string{"default/wait-0", "default/wait-1", "default/wait-2"}, key)
+		}
+		status, _, _, err := concurrenyMgr.TryAcquire(waitingWfs[0], "", waitingWfs[0].Spec.Synchronization)
+		assert.NoError(err)
+		assert.True(status, "a released lock must be available to a subsequent acquisition")
+	})
+}
