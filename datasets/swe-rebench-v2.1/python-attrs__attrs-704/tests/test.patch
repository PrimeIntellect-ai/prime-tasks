+        Set types are converted to lists if retain_collection_types=False,
+        using the default recurse setting.
+        """
+        d = asdict(C(1, set_type((1, 2, 3))), retain_collection_types=False)
+
+        assert d["x"] == 1
+        assert isinstance(d["y"], list)
+        assert set(d["y"]) == {1, 2, 3}
+
+    def test_frozenset_no_retain_default(self, C):
+        """The default asdict call converts a frozenset to a list."""
