+    public function testInvalidTextInPayloadDoesNotTriggerUtf8EncodeDeprecation()
+    {
+        $handler = new TestChromePHPHandler();
+        $deprecations = [];
+        set_error_handler(function ($severity, $message) use (&$deprecations) {
+            if ($severity === E_DEPRECATED && strpos($message, 'utf8_encode') !== false) {
+                $deprecations[] = $message;
+
+                return true;
+            }
+
+            return false;
+        });
+
+        try {
+            $handler->handle($this->getRecord(Logger::WARNING, "\xA4"));
+            \Monolog\Utils::jsonEncode("\xA4", JSON_UNESCAPED_UNICODE);
+        } finally {
+            restore_error_handler();
+        }
+
+        if (function_exists('mb_convert_encoding')) {
+            $this->assertSame([], $deprecations);
+        }
+    }
