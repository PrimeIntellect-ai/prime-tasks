+/* eslint-env mocha */
+'use strict';
+
+var assert = require('assert');
+var eslint = require('eslint').linter;
+var plugin = require('../../../');
+
+// The package exposes its rules through a registry. Check behavior through
+// that public entry point without coupling the test to the rule's name.
+describe('JSX prop bind warnings', function () {
+  it('warns when a JSX prop calls bind, including with a bound argument', function () {
+    var bound = '<a onClick={this.onClick.bind(this, true)}>click me</a>';
+    var unbound = '<a onClick={this.onClick}>click me</a>';
+    var addedDiagnostics = false;
+
+    Object.keys(plugin.rules).forEach(function (name) {
+      eslint.reset();
+      eslint.defineRule(name, plugin.rules[name]);
+      var config = {
+        ecmaFeatures: { jsx: true },
+        rules: {}
+      };
+      config.rules[name] = 2;
+
+      var boundMessages = eslint.verify(bound, config);
+      var unboundMessages = eslint.verify(unbound, config);
+      if (boundMessages.length > unboundMessages.length) {
+        addedDiagnostics = true;
+      }
+    });
+
+    assert.ok(addedDiagnostics, 'a JSX bind call should produce a warning');
+  });
+});
