+package day199
+
+import "testing"
+
+var balanceParensCheckCases = []struct {
+	parens string
+}{
+	{"(()"},
+	{`))()(`},
+	{`))(`},
+}
+
+func TestBalanceParensMinimalEditsResult(t *testing.T) {
+	t.Parallel()
+	for _, tc := range balanceParensCheckCases {
+		result := BalanceParens(tc.parens)
+		if !isWellNestedForBalanceCheck(result) {
+			t.Errorf("BalanceParens(%q) = %q, which is not balanced", tc.parens, result)
+			continue
+		}
+		gotEdits := lcsBasedEditDistanceForBalance(tc.parens, result)
+		wantEdits := referenceBalanceEditCount(tc.parens)
+		if gotEdits != wantEdits {
+			t.Errorf("BalanceParens(%q) = %q, requiring %d edits; minimum is %d", tc.parens, result, gotEdits, wantEdits)
+		}
+	}
+}
+
+func isWellNestedForBalanceCheck(s string) bool {
+	depth := 0
+	for _, r := range s {
+		switch r {
+		case '(':
+			depth++
+		case ')':
+			depth--
+			if depth < 0 {
+				return false
+			}
+		default:
+			return false
+		}
+	}
+	return depth == 0
+}
+
+func referenceBalanceEditCount(s string) int {
+	depth, edits := 0, 0
+	for _, r := range s {
+		if r == '(' {
+			depth++
+		} else if depth == 0 {
+			edits++ // An unmatched closing parenthesis needs a matching opening one.
+		} else {
+			depth--
+		}
+	}
+	return edits + depth // Close any remaining unmatched opening parentheses.
+}
+
+func lcsBasedEditDistanceForBalance(a, b string) int {
+	// With only insertion and deletion operations, the retained characters form
+	// a longest common subsequence.
+	previous := make([]int, len(b)+1)
+	for i := 1; i <= len(a); i++ {
+		current := make([]int, len(b)+1)
+		for j := 1; j <= len(b); j++ {
+			if a[i-1] == b[j-1] {
+				current[j] = previous[j-1] + 1
+			} else if previous[j] > current[j-1] {
+				current[j] = previous[j]
+			} else {
+				current[j] = current[j-1]
+			}
+		}
+		previous = current
+	}
+	return len(a) + len(b) - 2*previous[len(b)]
+}
+
+func BenchmarkBalanceParensMinimalEditsResult(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range balanceParensCheckCases {
+			BalanceParens(tc.parens)
+		}
+	}
+}
