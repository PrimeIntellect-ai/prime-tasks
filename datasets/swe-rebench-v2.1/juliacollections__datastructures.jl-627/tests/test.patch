+@testset "merge" begin
+    h1 = RobinDict("a" => 1, "b" => 2)
+    h2 = RobinDict("c" => 3, "d" => 4)
+    d = merge(h1, h2)
+    @test d !== h1 && d !== h2
+    @test isa(d, RobinDict{String, Int})
+    @test length(d) == 4
+    @test d["a"] == 1
+    @test d["b"] == 2
+    @test d["c"] == 3
+    @test d["d"] == 4
+end
+
+@testset "merge overwrites duplicate keys with later values" begin
+    h1 = RobinDict("a" => 1, "b" => 2)
+    h2 = RobinDict("a" => 10, "c" => 3)
+    d = merge(h1, h2)
+    @test isa(d, RobinDict{String, Int})
+    @test d["a"] == 10
+    @test d["b"] == 2
+    @test d["c"] == 3
+end
+
+@testset "merge promotes key and value types" begin
+    h1 = RobinDict{Int, Int}(1 => 2)
+    h2 = RobinDict{Float64, Float64}(3.0 => 4.0)
+    d = merge(h1, h2)
+    @test isa(d, RobinDict{Float64, Float64})
+    @test d[1] == 2
+    @test d[3.0] == 4.0
+end
+
+@testset "merge accepts more than two dictionaries" begin
+    h1 = RobinDict("a" => 1)
+    h2 = RobinDict("b" => 2)
+    h3 = RobinDict("c" => 3)
+    d = merge(h1, h2, h3)
+    @test isa(d, RobinDict{String, Int})
+    @test length(d) == 3
+    @test d["a"] == 1
+    @test d["b"] == 2
+    @test d["c"] == 3
+end
+
+@testset "merge with combine function" begin
+    h1 = RobinDict("a" => 1, "b" => 2)
+    h2 = RobinDict("b" => 3, "c" => 4)
+    d = merge(+, h1, h2)
+    @test d !== h1 && d !== h2
+    @test isa(d, RobinDict{String, Int})
+    @test d["b"] == 5
+    @test d["a"] == 1
+    @test d["c"] == 4
+end
+
+@testset "combining merge promotes key and value types" begin
+    h1 = RobinDict{String, Int8}("a" => Int8(2))
+    h2 = RobinDict{SubString{String}, Int16}(SubString("a", 1, 1) => Int16(3), SubString("b", 1, 1) => Int16(4))
+    d = merge(+, h1, h2)
+    @test d isa RobinDict{AbstractString, Int16}
+    @test d["a"] == 5
+    @test d["b"] == 4
+end
+
+@testset "merge with combine function applies in argument order" begin
+    h1 = RobinDict("a" => 1, "b" => 2)
+    h2 = RobinDict("b" => 3, "c" => 4)
+    d = merge((old, new) -> old - new, h1, h2)
+    @test isa(d, RobinDict{String, Int})
+    @test d["b"] == -1
+    @test d["a"] == 1
+    @test d["c"] == 4
+end
+
