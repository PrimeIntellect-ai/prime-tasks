+package day245
+
+import (
+	"reflect"
+	"testing"
+)
+
+// nolint
+var testcases = []struct {
+	maxSteps      []int
+	expectedJumps int
+}{
+	{[]int{6, 2, 4, 0, 5, 1, 1, 4, 2, 9}, 2},
+	{[]int{9}, 0},
+	{[]int{1, 1, 1, 1, 1, 1, 1}, 6},
+	{[]int{1, 2, 0, 1, 1}, 3},
+	{[]int{2, 3, 1, 1, 4}, 2},
+	{[]int{3, 0, 0, 0}, 1},
+}
+
+// minimumJumpsValue reads the count returned by MinimumJumps while allowing a
+// legacy implementation to also return an error for unreachable inputs.
+func minimumJumpsValue(maxSteps []int) int {
+	results := reflect.ValueOf(MinimumJumps).Call([]reflect.Value{reflect.ValueOf(maxSteps)})
+	return int(results[0].Int())
+}
+
+func TestMinimumJumps(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		if jumps := minimumJumpsValue(tc.maxSteps); jumps != tc.expectedJumps {
+			t.Errorf("MinimumJumps(%v) = %v, want %v", tc.maxSteps, jumps, tc.expectedJumps)
+		}
+	}
+}
+
+func BenchmarkMinimumJumps(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			minimumJumpsValue(tc.maxSteps)
+		}
+	}
+}
