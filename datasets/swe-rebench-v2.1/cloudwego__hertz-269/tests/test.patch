+
+func TestDisablePrintRoute(t *testing.T) {
+	buf := &bytes.Buffer{}
+	hlog.SetOutput(buf)
+	hlog.SetLevel(hlog.LevelTrace)
+	defer func() {
+		hlog.SetOutput(os.Stderr)
+		hlog.SetLevel(hlog.LevelTrace)
+	}()
+
+	// By default, registering a route prints the route information.
+	h := New()
+	h.GET("/print-route-default", func(c context.Context, ctx *app.RequestContext) {})
+	assert.Assert(t, strings.Contains(buf.String(), "/print-route-default"))
+
+	// When printing is disabled, registering a route does not print the route information.
+	buf.Reset()
+	h2 := New(WithDisablePrintRoute(true))
+	h2.GET("/print-route-disabled", func(c context.Context, ctx *app.RequestContext) {})
+	assert.Assert(t, !strings.Contains(buf.String(), "/print-route-disabled"))
+}
