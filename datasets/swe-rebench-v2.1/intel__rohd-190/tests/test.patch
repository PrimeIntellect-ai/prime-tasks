+///
+/// definition_name_test.dart
+/// Unit tests for definition names of Modules.
+///
+/// 2022 October 26
+/// Author: Yao Jing Quek <yao.jing.quek@intel.com>
+///
+import 'package:rohd/rohd.dart';
+import 'package:test/test.dart';
+
+class InvalidDefinitionNameModule extends Module {
+  InvalidDefinitionNameModule()
+      : super(
+          name: 'specialNameInstance',
+          definitionName: '/--**definitionName+',
+        );
+}
+
+void main() {
+  test('an unsanitary custom definition name is sanitized in generated SV',
+      () async {
+    final mod = InvalidDefinitionNameModule();
+    await mod.build();
+
+    final generated = mod.generateSynth();
+    final declaration = RegExp(
+      r'module\s+(?:(?:automatic|static)\s+)?([A-Za-z_][A-Za-z0-9_$]*|\\[^\s]+)',
+    ).firstMatch(generated);
+    expect(declaration, isNotNull);
+    expect(declaration!.group(1), contains('definitionName'));
+  });
+}
