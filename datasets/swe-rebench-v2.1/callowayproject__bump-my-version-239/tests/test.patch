+@pytest.mark.parametrize("hook_option", ["pre_commit_hooks", "post_commit_hooks"])
+def test_bump_fails_when_a_hook_fails(tmp_path: Path, hook_option: str):
+    """The bump command fails when a configured hook command fails."""
+    config_path = tmp_path / ".bumpversion.toml"
+    config_path.write_text(
+        "\n".join(
+            [
+                "[tool.bumpversion]",
+                'current_version = "0.1.3"',
+                "tag = false",
+                "commit = false",
+                "allow_dirty = true",
+                f'{hook_option} = ["exit 1"]',
+            ]
+        ),
+        encoding="utf-8",
+    )
+
+    runner = CliRunner()
+    with inside_dir(tmp_path):
+        result = runner.invoke(cli.cli, ["bump", "patch"])
+
+    assert result.exit_code != 0
