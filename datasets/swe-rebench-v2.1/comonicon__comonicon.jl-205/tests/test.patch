+using Test
+using Comonicon
+
+# A self-contained script that exercises the public `@lazyload` grammar together
+# with `@main`. It is written to a temporary file and executed as a child process
+# so that the dependency-loading behaviour is observed end to end.
+const LAZYLOAD_SCRIPT = """
+using Comonicon
+
+\"\"\"
+generate a random number
+\"\"\"
+@lazyload using Random @cast function random()
+    isdefined(Main, :Random) && println("Random is loaded")
+    isdefined(Main, :LinearAlgebra) && println("LinearAlgebra is loaded")
+end
+
+@lazyload using Random, LinearAlgebra @cast function both()
+    isdefined(Main, :Random) && println("Random is loaded")
+    isdefined(Main, :LinearAlgebra) && println("LinearAlgebra is loaded")
+end
+
+@cast function none()
+    isdefined(Main, :Random) && println("Random is loaded")
+    isdefined(Main, :LinearAlgebra) && println("LinearAlgebra is loaded")
+end
+
+@main
+"""
+
+function run_lazyload_script(args::String)
+    return mktempdir() do dir
+        path = joinpath(dir, "lazyload.jl")
+        write(path, LAZYLOAD_SCRIPT)
+        cmd = Base.julia_cmd()
+        return read(`$cmd --project=$(Base.active_project()) $path $args`, String)
+    end
+end
+
+@testset "lazyload script" begin
+    # the dependency is loaded only when the matching subcommand is invoked
+    out = run_lazyload_script("random")
+    @test occursin("Random is loaded", out)
+    @test !occursin("LinearAlgebra is loaded", out)
+
+    out = run_lazyload_script("both")
+    @test occursin("Random is loaded", out)
+    @test occursin("LinearAlgebra is loaded", out)
+
+    out = run_lazyload_script("none")
+    @test !occursin("Random is loaded", out)
+    @test !occursin("LinearAlgebra is loaded", out)
+
+    # documentation attached to a lazyloaded command is preserved
+    out = run_lazyload_script("")
+    @test occursin("generate a random number", out)
+end
