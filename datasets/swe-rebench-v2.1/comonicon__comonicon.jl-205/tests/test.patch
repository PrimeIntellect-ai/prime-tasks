 end # TestMarkdown
+
+module TestLazyLoad
+
+using Test
+using Comonicon
+using ExproniconLite
+
+const LOADED = String[]
+
+# evaluate `generated` in `mod` with `ARGS` temporarily set to `args`
+function eval_with_args(mod::Module, generated, args::Vector{String})
+    saved = copy(ARGS)
+    try
+        empty!(ARGS)
+        append!(ARGS, args)
+        Core.eval(mod, generated)
+    finally
+        empty!(ARGS)
+        append!(ARGS, saved)
+    end
+    return nothing
+end
+
+@testset "lazyload" begin
+    # --- function command: load_expr runs iff ARGS[1] matches the command name
+    ex = @expr @cast function f()
+    end
+    generated = Comonicon.lazyload_m(Main, nothing, :(push!(LOADED, "Pkg")), ex)
+    @test generated isa Expr
+
+    empty!(LOADED)
+    eval_with_args(@__MODULE__, generated, ["f"])
+    @test "Pkg" in LOADED
+    @test isdefined(@__MODULE__, :f)
+
+    empty!(LOADED)
+    eval_with_args(@__MODULE__, generated, ["other"])
+    @test isempty(LOADED)
+    @test isdefined(@__MODULE__, :f)
+
+    empty!(LOADED)
+    eval_with_args(@__MODULE__, generated, String[])
+    @test isempty(LOADED)
+    @test isdefined(@__MODULE__, :f)
+
+    # --- module command: same conditional behaviour
+    ex = @expr @cast module nodecmd
+        using Comonicon
+        @cast function f()
+        end
+    end
+    generated = Comonicon.lazyload_m(Main, nothing, :(push!(LOADED, "Pkg")), ex)
+    @test generated isa Expr
+
+    empty!(LOADED)
+    eval_with_args(@__MODULE__, generated, ["nodecmd"])
+    @test "Pkg" in LOADED
+    @test isdefined(@__MODULE__, :nodecmd)
+
+    empty!(LOADED)
+    eval_with_args(@__MODULE__, generated, ["other"])
+    @test isempty(LOADED)
+    @test isdefined(@__MODULE__, :nodecmd)
+
+    # --- invalid module: must throw ArgumentError
+    @test_throws ArgumentError Comonicon.lazyload_m(TestLazyLoad, nothing, :(using Pkg), ex)
+
+    # --- invalid casted expression: must throw ArgumentError
+    @test_throws ArgumentError Comonicon.lazyload_m(Main, nothing, :(using Pkg), :(function f() end))
+    @test_throws ArgumentError Comonicon.lazyload_m(Main, nothing, :(using Pkg), :(@time f()))
+
+    # --- documentation is attached to the evaluated cast expression
+    ex = @expr @cast function documented()
+    end
+    generated = Comonicon.lazyload_m(Main, nothing, :(nothing), ex)
+    doc_expr = Expr(:macrocall, Symbol("@doc"), LineNumberNode(1), "documented command", generated)
+    Core.eval(@__MODULE__, doc_expr)
+    @test occursin("documented command", string(@doc(documented)))
+end
+
+end
