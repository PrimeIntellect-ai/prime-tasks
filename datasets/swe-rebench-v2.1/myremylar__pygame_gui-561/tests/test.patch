@@ -778,6 +778,28 @@ class TestUIButton:
 
         assert button.image is not None
 
+    def test_switching_object_ids(self, _init_pygame, _display_surface_return_none):
+        manager = UIManager((800, 600), os.path.join("tests", "data", "themes", "ui_button_non_default.json"))
+        button = UIButton(relative_rect=pygame.Rect(10, 10, 150, 30),
+                          text="Test Button",
+                          manager=manager)
+        reference_button = UIButton(relative_rect=pygame.Rect(10, 10, 150, 30),
+                                    text="Test Button",
+                                    manager=manager,
+                                    object_id=ObjectID(object_id=None, class_id="@rounded_button"))
+        assert button.image is not None
+        assert reference_button.image is not None
+        assert not compare_surfaces(button.image, reference_button.image)
+
+        change_id = getattr(button, "change_object_id", None)
+        if callable(change_id):
+            change_id(ObjectID(object_id=None, class_id="@rounded_button"))
+        else:
+            button.class_ids = ["@rounded_button"]
+            button.rebuild()
+
+        assert compare_surfaces(button.image, reference_button.image)
+
