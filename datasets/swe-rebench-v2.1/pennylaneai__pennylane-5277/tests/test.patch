+def _rendered_circuit(draw_function, *args):
+    """Capture a diagram as pixels without depending on its artist types."""
+    fig, _ = draw_function(*args)
+    fig.canvas.draw()
+    image = (fig.canvas.get_width_height(), bytes(fig.canvas.buffer_rgba()))
+    plt.close(fig)
+    return image
+
