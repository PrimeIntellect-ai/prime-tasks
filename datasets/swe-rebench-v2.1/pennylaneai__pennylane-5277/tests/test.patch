+@pytest.mark.parametrize("draw_mpl", [False, True], ids=["text", "matplotlib"])
+@pytest.mark.parametrize("expansion_strategy", [None, "device"], ids=["default", "device-expansion"])
+def test_applied_transforms_custom_device_with_expansion(draw_mpl, expansion_strategy):
+    """A custom device's QNode transforms are reflected by both drawing APIs."""
+
+    class CustomDevice(qml.Device):
+        name = "Custom device"
+        short_name = "test.custom-device"
+        pennylane_requires = ">=0.29.1"
+        version = "0.1.0"
+        author = "Test"
+
+        @property
+        def observables(self):
+            return ["PauliZ"]
+
+        @property
+        def operations(self):
+            return ["PauliX", "RX"]
+
+        def apply(self, operation, wires, par):
+            pass
+
+        def expval(self, observable, wires, par):
+            return 0.0
+
+        def reset(self):
+            pass
+
+    @qml.transform
+    def replace_with_pauli_x(_):
+        tape = qml.tape.QuantumScript([qml.PauliX(0)])
+        return (tape,), lambda results: results[0]
+
+    @replace_with_pauli_x
+    @qml.qnode(CustomDevice(wires=1))
+    def transformed_qnode():
+        qml.RX(0.2, wires=0)
+        return qml.expval(qml.PauliZ(0))
+
+    if draw_mpl:
+        import matplotlib.pyplot as plt
+
+        _, ax = qml.draw_mpl(transformed_qnode, expansion_strategy=expansion_strategy)()
+        assert any(text.get_text() == "X" for text in ax.texts)
+        plt.close()
+    else:
+        drawing = qml.draw(transformed_qnode, expansion_strategy=expansion_strategy)()
+        assert "─X─" in drawing
