diff --git a/test/interval_tests/power.jl b/test/interval_tests/power.jl
index a5b4e35..0178407 100644
--- a/test/interval_tests/power.jl
+++ b/test/interval_tests/power.jl
@@ -90,3 +90,25 @@ end
 #     @test real(b) == interval(-13.12878308146216, -13.128783081462153)
 #     @test imag(b) == interval(-15.200784463067956, -15.20078446306795)
 # end
+
+@testset "Literal powers" begin
+    x = interval(-1,1)
+    @test isguaranteed(x ^ 2)
+    @test isguaranteed(x ^ 3)
+    @test isguaranteed(x ^ 4)
+    @test isequal_interval(x^2, interval(0,1))
+    @test isequal_interval(x^3, x)
+
+    a = interval(1, 2)
+    @test isguaranteed(a ^ 4)
+    @test isequal_interval(a ^ 4, interval(1, 16))
+end
+@testset "Literal powers respect the active mode" begin
+    x = interval(-1.1, 1.2)
+    @eval IntervalArithmetic.power_mode() = IntervalArithmetic.PowerMode{:slow}()
+    try
+        @test isequal_interval(x^3, pown(x, 3))
+    finally
+        @eval IntervalArithmetic.power_mode() = IntervalArithmetic.PowerMode{:fast}()
+    end
+end
