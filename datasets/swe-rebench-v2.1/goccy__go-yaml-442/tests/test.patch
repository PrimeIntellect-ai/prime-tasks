+func TestDecoderPreservesDefaultValuesForNullStruct(t *testing.T) {
+	type nested struct {
+		Val string `yaml:"val"`
+		Num int    `yaml:"num"`
+	}
+
+	type test struct {
+		First   string `yaml:"first"`
+		Default nested `yaml:"nested"`
+	}
+
+	for _, yml := range []string{
+		"first: \"Test\"\nnested:\n  # Just some comment here\n#  val: \"default\"\n",
+		"first: \"Test\"\nnested:\n",
+		"first: \"Test\"\nnested: null\n",
+		"first: \"Test\"\nnested: ~\n",
+	} {
+		v := test{Default: nested{Val: "default", Num: 7}}
+		if err := yaml.Unmarshal([]byte(yml), &v); err != nil {
+			t.Fatalf("failed to decode %q: %v", yml, err)
+		}
+		if v.First != "Test" {
+			t.Fatalf("expected first to be %q, got %q (input %q)", "Test", v.First, yml)
+		}
+		if v.Default.Val != "default" || v.Default.Num != 7 {
+			t.Fatalf("decoder doesn't preserve struct defaults for null input %q: got %+v", yml, v.Default)
+		}
+	}
+}
+
+func TestDecoderMergesPartialNestedStructWithDefaults(t *testing.T) {
+	type nested struct {
+		Val string `yaml:"val"`
+		Num int    `yaml:"num"`
+	}
+
+	type test struct {
+		First   string `yaml:"first"`
+		Default nested `yaml:"nested"`
+	}
+
+	yml := "first: \"Test\"\nnested:\n  num: 5\n"
+	v := test{Default: nested{Val: "default", Num: 7}}
+	if err := yaml.Unmarshal([]byte(yml), &v); err != nil {
+		t.Fatal(err)
+	}
+	if v.Default.Val != "default" {
+		t.Fatalf("expected unspecified field to keep its default, got %q", v.Default.Val)
+	}
+	if v.Default.Num != 5 {
+		t.Fatalf("expected specified field to be decoded, got %d", v.Default.Num)
+	}
+}
