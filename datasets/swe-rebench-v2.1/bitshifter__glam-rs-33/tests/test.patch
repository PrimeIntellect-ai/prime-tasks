+#[test]
+fn test_mat4_orthographic_rh() {
+    let projection = Mat4::orthographic_rh(-10.0, 10.0, -5.0, 5.0, 0.0, -10.0);
+    let original = Vec4::new(5.0, 5.0, -5.0, 1.0);
+    let projected = projection.mul_vec4(original);
+    assert_approx_eq!(projected, Vec4::new(0.5, 1.0, -2.0, 1.0));
+}
+
+#[test]
+fn test_mat4_orthographic_rh_equal_bounds() {
+    // Equal bounds produce infinities; the function performs no runtime validation.
+    let p = Mat4::orthographic_rh(0.0, 0.0, -5.0, 5.0, 0.0, -10.0);
+    assert!(p.to_cols_array_2d().iter().flatten().any(|v| v.is_infinite()));
+    let p = Mat4::orthographic_rh(-10.0, 10.0, 0.0, 0.0, 0.0, -10.0);
+    assert!(p.to_cols_array_2d().iter().flatten().any(|v| v.is_infinite()));
+    let p = Mat4::orthographic_rh(-10.0, 10.0, -5.0, 5.0, 0.0, 0.0);
+    assert!(p.to_cols_array_2d().iter().flatten().any(|v| v.is_infinite()));
+}
+
+#[test]
+fn test_mat4_orthographic_rh_bounds() {
+    // The horizontal and vertical bounds map to the normalized device range.
+    let projection = Mat4::orthographic_rh(-10.0, 10.0, -5.0, 5.0, 0.0, -10.0);
+    let min = projection.mul_vec4(Vec4::new(-10.0, -5.0, 0.0, 1.0));
+    assert_approx_eq!(min.x(), -1.0);
+    assert_approx_eq!(min.y(), -1.0);
+    let max = projection.mul_vec4(Vec4::new(10.0, 5.0, 0.0, 1.0));
+    assert_approx_eq!(max.x(), 1.0);
+    assert_approx_eq!(max.y(), 1.0);
+}
