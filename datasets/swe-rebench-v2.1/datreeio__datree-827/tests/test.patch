+func TestInitClientPermissiveSchema(t *testing.T) {
+	schemaDir, manifestPath := writePermissiveSchemaFixtures(t)
+
+	runValidation := func(permissive bool) (bool, bool) {
+		validator := New()
+		validator.InitClient("1.21.0", false, []string{schemaDir}, permissive)
+
+		filesConfigurationsChan := make(chan *extractor.FileConfigurations, 1)
+		filesConfigurationsChan <- &extractor.FileConfigurations{
+			FileName:       manifestPath,
+			Configurations: []extractor.Configuration{},
+		}
+		close(filesConfigurationsChan)
+
+		validChan, invalidChan, _ := validator.ValidateResources(filesConfigurationsChan, 1, false)
+		hasValid := false
+		hasInvalid := false
+		for range validChan {
+			hasValid = true
+		}
+		for range invalidChan {
+			hasInvalid = true
+		}
+		return hasValid, hasInvalid
+	}
+
+	strictValid, strictInvalid := runValidation(false)
+	assert.False(t, strictValid, "strict schema validation must reject resources with additional properties")
+	assert.True(t, strictInvalid, "strict schema validation must report the resource as invalid")
+
+	permissiveValid, permissiveInvalid := runValidation(true)
+	assert.True(t, permissiveValid, "permissive schema validation must accept resources with additional properties")
+	assert.False(t, permissiveInvalid, "permissive schema validation must not report the resource as invalid")
+}
+
+func writePermissiveSchemaFixtures(t *testing.T) (string, string) {
+	t.Helper()
+	schemaDir := t.TempDir()
+	strictSchemaDir := filepath.Join(schemaDir, "v1.21.0-standalone-strict")
+	permissiveSchemaDir := filepath.Join(schemaDir, "v1.21.0-standalone")
+	if err := os.MkdirAll(strictSchemaDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(permissiveSchemaDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+
+	strictSchema := `{"type":"object","properties":{"apiVersion":{"type":"string"},"kind":{"type":"string"},"metadata":{"type":"object"},"spec":{"type":"object"}},"additionalProperties":false}`
+	permissiveSchema := `{"type":"object","properties":{"apiVersion":{"type":"string"},"kind":{"type":"string"},"metadata":{"type":"object"},"spec":{"type":"object"}}}`
+
+	if err := os.WriteFile(filepath.Join(strictSchemaDir, "deployment-apps-v1.json"), []byte(strictSchema), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(permissiveSchemaDir, "deployment-apps-v1.json"), []byte(permissiveSchema), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	manifestPath := filepath.Join(schemaDir, "deployment.yaml")
+	manifest := "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: test\nspec:\n  replicas: 1\nextraField: hello\n"
+	if err := os.WriteFile(manifestPath, []byte(manifest), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	return schemaDir, manifestPath
+}
