+  @Test
+  public void testLifecycleConditionMatchesPrefixAndSuffixGetters() {
+    List<String> prefixes = ImmutableList.of("prefix-one", "prefix-two");
+    List<String> suffixes = ImmutableList.of("-suffix-one", "-suffix-two");
+
+    LifecycleCondition.Builder builder = LifecycleCondition.newBuilder();
+    assertTrue(
+        invokePublicMethod(
+                builder, "setMatchesPrefix", new Class<?>[] {List.class}, prefixes)
+            == builder);
+    assertTrue(
+        invokePublicMethod(
+                builder, "setMatchesSuffix", new Class<?>[] {List.class}, suffixes)
+            == builder);
+    LifecycleCondition condition = builder.build();
+
+    assertEquals(
+        prefixes,
+        invokePublicMethod(condition, "getMatchesPrefix", new Class<?>[0]));
+    assertEquals(
+        suffixes,
+        invokePublicMethod(condition, "getMatchesSuffix", new Class<?>[0]));
+  }
