+  private static Object invokePublicMethod(
+      Object target, String methodName, Class<?>[] parameterTypes, Object... arguments) {
+    try {
+      return target.getClass().getMethod(methodName, parameterTypes).invoke(target, arguments);
+    } catch (ReflectiveOperationException e) {
+      throw new AssertionError("Expected public method " + methodName, e);
+    }
+  }
+
   private static Lifecycle lifecycle(Rule... rules) {
     return lifecycle(Arrays.asList(rules));
