+// TestRest_RSC15_HostFallbackOnTimeout verifies RSC15l2: when a request times
+// out, the client must retry against the fallback hosts (not keep retrying the
+// primary endpoint), and the returned error must report the client timeout.
+func TestRest_RSC15_HostFallbackOnTimeout(t *testing.T) {
+	var mtx sync.Mutex
+	var retryCount int
+	var hosts []string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mtx.Lock()
+		hosts = append(hosts, strings.Split(r.Host, ":")[0])
+		retryCount++
+		mtx.Unlock()
+		time.Sleep(2 * time.Second)
+		w.WriteHeader(http.StatusInternalServerError)
+	}))
+	defer server.Close()
+
+	httpClientMock := &http.Client{
+		Timeout: 1 * time.Second,
+		Transport: &http.Transport{
+			Proxy: func(*http.Request) (*url.URL, error) { return url.Parse(server.URL) },
+		},
+	}
+
+	options := []ably.ClientOption{
+		ably.WithKey("xxxxxxx.yyyyyyy:zzzzzzz"),
+		ably.WithFallbackHosts(ably.DefaultFallbackHosts()),
+		ably.WithTLS(false),
+		ably.WithEnvironment(""), // remove default sandbox env
+		ably.WithHTTPMaxRetryCount(10),
+		ably.WithUseTokenAuth(true),
+		ably.WithHTTPClient(httpClientMock),
+	}
+	client, err := ably.NewREST(options...)
+	assert.NoError(t, err)
+
+	err = client.Channels.Get("test").Publish(context.Background(), "ping", "pong")
+	assert.Error(t, err, "expected an error")
+	assert.Contains(t, err.Error(), "context deadline exceeded (Client.Timeout exceeded while awaiting headers)")
+
+	mtx.Lock()
+	gotRetryCount := retryCount
+	gotHosts := append([]string(nil), hosts...)
+	mtx.Unlock()
+
+	assert.Equal(t, 6, gotRetryCount)                          // 1 primary and 5 default fallback hosts
+	assert.Equal(t, "rest.ably.io", gotHosts[0])               // primary host
+	assertSubset(t, ably.DefaultFallbackHosts(), gotHosts[1:]) // remaining fallback hosts
+	assertUnique(t, gotHosts)                                  // ensure all picked fallbacks are unique
+}
