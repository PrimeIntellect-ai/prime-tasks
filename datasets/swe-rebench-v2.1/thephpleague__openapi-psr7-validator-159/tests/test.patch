+
+    public function testResponseStatusCodesWithWildcards(): void
+    {
+        $yaml = <<<YAML
+openapi: 3.0.0
+info:
+  title: Product import API
+  version: '1.0'
+servers:
+  - url: 'http://localhost:8000/api/v1'
+paths:
+  /products.find:
+    get:
+      responses:
+        '200':
+          description: OK
+        '2XX':
+          description: Success
+        '3XX':
+          description: Redirection
+        '404':
+          description: Not Found
+        '4XX':
+          description: Client Error
+        '5XX':
+          description: Server Error
+        'default':
+          description: Unexpected Error
+YAML;
+
+        $schema     = (new ValidatorBuilder())->fromYaml($yaml)->getServerRequestValidator()->getSchema();
+        $specFinder = new SpecFinder($schema);
+
+        self::assertSame(
+            'OK',
+            $specFinder->findResponseSpec(new ResponseAddress('/products.find', 'get', 200))->description
+        );
+        self::assertSame(
+            'Success',
+            $specFinder->findResponseSpec(new ResponseAddress('/products.find', 'get', 201))->description
+        );
+        self::assertSame(
+            'Redirection',
+            $specFinder->findResponseSpec(new ResponseAddress('/products.find', 'get', 301))->description
+        );
+        self::assertSame(
+            'Not Found',
+            $specFinder->findResponseSpec(new ResponseAddress('/products.find', 'get', 404))->description
+        );
+        self::assertSame(
+            'Client Error',
+            $specFinder->findResponseSpec(new ResponseAddress('/products.find', 'get', 400))->description
+        );
+        self::assertSame(
+            'Server Error',
+            $specFinder->findResponseSpec(new ResponseAddress('/products.find', 'get', 500))->description
+        );
+        self::assertSame(
+            'Unexpected Error',
+            $specFinder->findResponseSpec(new ResponseAddress('/products.find', 'get', 100))->description
+        );
+    }
 }
