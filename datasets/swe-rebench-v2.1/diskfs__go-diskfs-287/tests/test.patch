+func TestWriteThenReadLargeSquashFSFile(t *testing.T) {
+	const blockSize = 4096
+	image, err := os.CreateTemp(t.TempDir(), "squashfs-image-*")
+	if err != nil {
+		t.Fatalf("create image: %v", err)
+	}
+	defer image.Close()
+
+	storage := backendfile.New(image, false)
+	fs, err := Create(storage, 0, 0, blockSize)
+	if err != nil {
+		t.Fatalf("create filesystem: %v", err)
+	}
+
+	want := make([]byte, 2*blockSize+37)
+	for i := range want {
+		want[i] = byte((i*31 + 17) % 251)
+	}
+	w, err := fs.OpenFile("/large", os.O_CREATE|os.O_RDWR)
+	if err != nil {
+		t.Fatalf("open file for writing: %v", err)
+	}
+	if n, err := w.Write(want); err != nil || n != len(want) {
+		t.Fatalf("write file: wrote %d of %d bytes, error %v", n, len(want), err)
+	}
+	if err := fs.Finalize(FinalizeOptions{
+		NoCompressInodes:    true,
+		NoCompressData:      true,
+		NoCompressFragments: true,
+		NoFragments:         true,
+	}); err != nil {
+		t.Fatalf("finalize filesystem: %v", err)
+	}
+
+	readFS, err := Read(storage, 0, 0, blockSize)
+	if err != nil {
+		t.Fatalf("open finalized filesystem: %v", err)
+	}
+	r, err := readFS.OpenFile("/large", os.O_RDONLY)
+	if err != nil {
+		t.Fatalf("open written file: %v", err)
+	}
+	got, err := io.ReadAll(r)
+	if err != nil {
+		t.Fatalf("read written file: %v", err)
+	}
+	if !bytes.Equal(got, want) {
+		t.Fatalf("read %d bytes, want %d bytes matching written contents", len(got), len(want))
+	}
+}
