+def pure_func(arg1, arg2):
+    pass
+
+
+class _CountingStrategy(SearchStrategy):
+    """Yields a fresh, distinct value on every draw."""
+
+    def __init__(self):
+        self._count = 0
+
+    def do_draw(self, data):
+        self._count += 1
+        return self._count
+
+
+@given(data=st.data())
+def test_functions_impure_draws_fresh_values(data):
+    # With pure=False, each call draws a fresh value from
+    # ``returns`` rather than reusing a memoised one.
+    f = data.draw(functions(like=pure_func, returns=_CountingStrategy(), pure=False))
+    values = [f(1, 2) for _ in range(5)]
+    assert len(set(values)) == len(values)
+
+
+@given(data=st.data())
+def test_functions_pure_with_same_args(data):
+    # Same regardless of calling convention, unlike functools.lru_cache()
+    f = data.draw(functions(like=pure_func, returns=integers(), pure=True))
+    arg1 = data.draw(integers())
+    arg2 = data.draw(integers())
+    expected = f(arg1, arg2)
+    assert f(arg1, arg2) == expected
+    assert f(arg1, arg2=arg2) == expected
+    assert f(arg1=arg1, arg2=arg2) == expected
+    assert f(arg2=arg2, arg1=arg1) == expected
+
+
+@given(data=st.data())
+def test_functions_pure_with_different_args(data):
+    # The contract only requires identical argument tuples to give identical
+    # results; different tuples (and hence a constant function) are allowed.
+    # Interleaving calls with different arguments must not disturb the
+    # memoised result for either tuple.
+    f = data.draw(functions(like=pure_func, returns=integers(), pure=True))
+    arg1 = data.draw(integers())
+    arg2 = data.draw(integers())
+    r1 = f(arg1, arg2)
+    r2 = f(arg2, arg1)
+    assert f(arg1, arg2) == r1
+    assert f(arg2, arg1) == r2
+
+
+@given(data=st.data())
+def test_functions_pure_two_functions_different_args_different_result(data):
+    # Two distinct pure functions are each internally consistent, but the
+    # contract does not require them to disagree with one another.
+    f1 = data.draw(functions(like=pure_func, returns=integers(), pure=True))
+    f2 = data.draw(functions(like=pure_func, returns=integers(), pure=True))
+    r1 = f1(1, 2)
+    assert f1(1, 2) == r1
+    r2 = f2(3, 4)
+    assert f2(3, 4) == r2
+
+
+@given(data=st.data())
+def test_functions_pure_two_functions_same_args_different_result(data):
+    # Two distinct pure functions called with the same arguments are each
+    # internally consistent, but need not return different values.
+    f1 = data.draw(functions(like=pure_func, returns=integers(), pure=True))
+    f2 = data.draw(functions(like=pure_func, returns=integers(), pure=True))
+    arg1 = data.draw(integers())
+    arg2 = data.draw(integers())
+    r1 = f1(arg1, arg2)
+    assert f1(arg1, arg2) == r1
+    r2 = f2(arg1, arg2)
+    assert f2(arg1, arg2) == r2
