+    def expectation(self, hamiltonian, normalize=False):
+        statec = K.conj(self.tensor)
+        hstate = hamiltonian @ self.tensor
+        ev = K.real(K.sum(statec * hstate))
+        if normalize:
+            norm = K.sum(K.square(K.abs(self.tensor)))
+            ev = ev / norm
