+// claimedPowerRuntime adapts the test runtime with runtime-like caller validation, without
+// requiring a particular validation API from the actor.
+type claimedPowerRuntime struct {
+	actorRuntime.Runtime
+	callerCode cid.Cid
+}
+
+func (rt *claimedPowerRuntime) ValidateImmediateCallerType(types ...cid.Cid) {
+	for _, allowed := range types {
+		if rt.callerCode.Equals(allowed) {
+			return
+		}
+	}
+	rt.Runtime.Abortf(exitcode.ErrForbidden, "caller type is forbidden")
+}
+
+func (rt *claimedPowerRuntime) ValidateImmediateCallerIs(addrs ...addr.Address) {
+	for _, allowed := range addrs {
+		if rt.Message().Caller() == allowed {
+			return
+		}
+	}
+	rt.Runtime.Abortf(exitcode.ErrForbidden, "caller address is forbidden")
+}
+
+func (rt *claimedPowerRuntime) ValidateImmediateCallerAcceptAny() {}
+
+func (rt *claimedPowerRuntime) GetActorCodeCID(actorAddr addr.Address) (cid.Cid, bool) {
+	if actorAddr == rt.Message().Caller() {
+		return rt.callerCode, true
+	}
+	return rt.Runtime.GetActorCodeCID(actorAddr)
+}
+
+func updateClaimedPowerCall(t *testing.T, actor power.Actor, callerCode cid.Cid, raw, qa abi.StoragePower) (interface{}, interface{}) {
+	t.Helper()
+	method, found := reflect.TypeOf(actor).MethodByName("UpdateClaimedPower")
+	require.True(t, found, "power actor must expose UpdateClaimedPower")
+	params := reflect.New(method.Type.In(2).Elem())
+	params.Elem().FieldByName("RawByteDelta").Set(reflect.ValueOf(raw))
+	params.Elem().FieldByName("QualityAdjustedDelta").Set(reflect.ValueOf(qa))
+	runtimeType := reflect.TypeOf((*actorRuntime.Runtime)(nil)).Elem()
+	callType := reflect.FuncOf([]reflect.Type{runtimeType, method.Type.In(2)}, []reflect.Type{method.Type.Out(0)}, false)
+	call := reflect.MakeFunc(callType, func(args []reflect.Value) []reflect.Value {
+		wrappedRuntime := &claimedPowerRuntime{
+			Runtime: args[0].Interface().(actorRuntime.Runtime), callerCode: callerCode,
+		}
+		return method.Func.Call([]reflect.Value{reflect.ValueOf(actor), reflect.ValueOf(wrappedRuntime), args[1]})
+	})
+	return call.Interface(), params.Interface()
+}
+
+// TestUpdateClaimedPower exercises the power actor's UpdateClaimedPower method directly,
+// verifying caller validation and that both raw and quality-adjusted deltas (positive or
+// negative) are applied to the calling miner's claimed power.
+func TestUpdateClaimedPower(t *testing.T) {
+	actor := power.Actor{}
+	minerAddr := tutil.NewIDAddr(t, 101)
+	otherAddr := tutil.NewIDAddr(t, 102)
+
+	builder := mock.NewBuilder(context.Background(), builtin.StoragePowerActorAddr).
+		WithCaller(builtin.SystemActorAddr, builtin.SystemActorCodeID)
+
+	// setupState initializes the power actor state with a zero-power claim for the miner.
+	setupState := func(t *testing.T, rt *mock.Runtime, initialRaw, initialQA abi.StoragePower) {
+		emptyMap, err := adt.MakeEmptyMap(adt.AsStore(rt)).Root()
+		require.NoError(t, err)
+		emptyMMap, err := adt.MakeEmptyMultimap(adt.AsStore(rt)).Root()
+		require.NoError(t, err)
+		st := power.ConstructState(emptyMap, emptyMMap)
+		claims, err := adt.AsMap(adt.AsStore(rt), st.Claims)
+		require.NoError(t, err)
+		require.NoError(t, claims.Put(power.AddrKey(minerAddr), &power.Claim{RawBytePower: initialRaw, QualityAdjPower: initialQA}))
+		st.Claims, err = claims.Root()
+		require.NoError(t, err)
+		rt.Create(st)
+	}
+
+	getClaim := func(t *testing.T, rt *mock.Runtime) power.Claim {
+		var st power.State
+		rt.GetState(&st)
+		claims, err := adt.AsMap(adt.AsStore(rt), st.Claims)
+		require.NoError(t, err)
+		var claim power.Claim
+		found, err := claims.Get(power.AddrKey(minerAddr), &claim)
+		require.NoError(t, err)
+		require.True(t, found)
+		return claim
+	}
+
+	update := func(t *testing.T, rt *mock.Runtime, raw, qa abi.StoragePower) {
+		rt.SetCaller(minerAddr, builtin.StorageMinerActorCodeID)
+		method, params := updateClaimedPowerCall(t, actor, builtin.StorageMinerActorCodeID, raw, qa)
+		ret := rt.Call(method, params)
+		require.Nil(t, ret)
+		rt.Verify()
+	}
+
+	t.Run("applies positive deltas to the calling miner's claim", func(t *testing.T) {
+		rt := builder.Build(t)
+		setupState(t, rt, big.Zero(), big.Zero())
+
+		update(t, rt, abi.NewStoragePower(10), abi.NewStoragePower(20))
+
+		claim := getClaim(t, rt)
+		assert.Equal(t, abi.NewStoragePower(10), claim.RawBytePower)
+		assert.Equal(t, abi.NewStoragePower(20), claim.QualityAdjPower)
+	})
+
+	t.Run("applies negative deltas to the calling miner's claim", func(t *testing.T) {
+		rt := builder.Build(t)
+		setupState(t, rt, big.Zero(), big.Zero())
+
+		update(t, rt, abi.NewStoragePower(100), abi.NewStoragePower(200))
+		update(t, rt, abi.NewStoragePower(-30), abi.NewStoragePower(-50))
+
+		claim := getClaim(t, rt)
+		assert.Equal(t, abi.NewStoragePower(70), claim.RawBytePower)
+		assert.Equal(t, abi.NewStoragePower(150), claim.QualityAdjPower)
+	})
+
+	t.Run("applies each delta independently when signs differ", func(t *testing.T) {
+		rt := builder.Build(t)
+		setupState(t, rt, abi.NewStoragePower(100), abi.NewStoragePower(100))
+
+		update(t, rt, abi.NewStoragePower(30), abi.NewStoragePower(-40))
+		update(t, rt, abi.NewStoragePower(-20), abi.NewStoragePower(10))
+
+		claim := getClaim(t, rt)
+		assert.Equal(t, abi.NewStoragePower(110), claim.RawBytePower)
+		assert.Equal(t, abi.NewStoragePower(70), claim.QualityAdjPower)
+	})
+
+	t.Run("rejects a caller that is not a miner actor", func(t *testing.T) {
+		rt := builder.Build(t)
+		setupState(t, rt, big.Zero(), big.Zero())
+
+		rt.SetCaller(otherAddr, builtin.AccountActorCodeID)
+		method, params := updateClaimedPowerCall(t, actor, builtin.AccountActorCodeID, abi.NewStoragePower(1), abi.NewStoragePower(1))
+		rt.ExpectAbort(exitcode.ErrForbidden, func() {
+			rt.Call(method, params)
+		})
+		rt.Verify()
+
+		// The rejected call must not have changed the claim.
+		claim := getClaim(t, rt)
+		assert.Equal(t, big.Zero(), claim.RawBytePower)
+		assert.Equal(t, big.Zero(), claim.QualityAdjPower)
+	})
+}
