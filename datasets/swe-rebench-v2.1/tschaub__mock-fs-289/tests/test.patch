+describe('fs.promises.readFile with O_CREAT | O_RDONLY', function() {
+  beforeEach(function() {
+    mock({});
+  });
+  afterEach(mock.restore);
+
+  withPromise.it(
+    'supports the direct numeric flag argument for a missing file',
+    function() {
+    if (!supportsNumericReadFileFlags) {
+      this.skip();
+    }
+    return fs.promises
+      .readFile('direct.txt', constants.O_CREAT | constants.O_RDONLY)
+      .then(function(data) {
+        assert.equal(data.length, 0);
+      })
+      .then(function() {
+        return fs.promises.stat('direct.txt');
+      })
+      .then(function(stats) {
+        assert.isTrue(stats.isFile());
+      });
+    }
+  );
+
+  withPromise.it('reads a nonexistent file without raising EBADF', function() {
