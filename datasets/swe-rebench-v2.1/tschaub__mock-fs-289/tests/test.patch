+      .readFile('bar.txt', {flag: constants.O_CREAT | constants.O_RDONLY})
+      .then(function(data) {
+        assert.equal(data.length, 0);
+      })
+      .then(function() {
+        return fs.promises.stat('bar.txt');
+      })
