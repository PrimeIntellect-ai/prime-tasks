 	"knative.dev/serving/pkg/apis/autoscaling"
 
@@ -129,9 +130,32 @@ func TestServiceUpdateAnnotationsMock(t *testing.T) {
 
 func recordServiceUpdateWithSuccess(r *clientservingv1.ServingRecorder, svcName string, newService *servingv1.Service, updatedService *servingv1.Service) {
 	r.GetService(svcName, nil, errors.NewNotFound(servingv1.Resource("service"), svcName))
-	r.CreateService(newService, nil)
+	r.CreateService(verifyService(newService), nil)
 	r.GetService(svcName, newService, nil)
-	r.UpdateService(updatedService, true, nil)
+	r.UpdateService(verifyService(updatedService), true, nil)
+}
+
+// verifyService checks for a service, and also whether the updateTimestamp is set
+func verifyService(srv *servingv1.Service) func(t *testing.T, toCheck *servingv1.Service) {
+	return func(t *testing.T, toCheck *servingv1.Service) {
+		assertUpdateTimestamp(t, toCheck.Spec.Template.Annotations)
+		// Delete the timestamp before comparing the otherwise stable service fields.
+		delete(toCheck.Spec.Template.Annotations, "client.knative.dev/updateTimestamp")
+		assert.DeepEqual(t, srv, toCheck)
+	}
+
+}
+
+func assertUpdateTimestamp(t *testing.T, annotations map[string]string) {
+	t.Helper()
+	value := annotations["client.knative.dev/updateTimestamp"]
+	assert.Assert(t, value != "")
+	parsed, err := time.Parse(time.RFC3339, value)
+	assert.NilError(t, err)
+	_, offset := parsed.Zone()
+	assert.Equal(t, offset, 0)
+	now := time.Now()
+	assert.Assert(t, parsed.After(now.Add(-time.Minute)) && parsed.Before(now.Add(time.Minute)))
 }
 
