 import pluginTester, { prettierFormatter } from 'babel-plugin-tester';
 import * as fs from 'fs';
 import * as path from 'path';
@@ -251,3 +252,29 @@ pluginTester({
   plugin: transformPlugin,
   pluginName: '@griffel/babel-plugin-transform',
 });
+
+describe('transformPlugin: animationName arrays', () => {
+  it('transforms an array of keyframes in animationName without throwing', () => {
+    const code = `
+      import { makeStyles } from '@griffel/react';
+
+      export const useStyles = makeStyles({
+        multiple: {
+          animationName: [
+            { from: { transform: 'rotate(0deg)' }, to: { transform: 'rotate(360deg)' } },
+            { from: { height: '100px' }, to: { height: '200px' } },
+          ],
+        },
+      });
+    `;
+
+    const result = transformSync(code, {
+      filename: 'Component.styles.ts',
+      parserOpts: { plugins: ['typescript'] },
+      plugins: [[transformPlugin, { babelOptions: { presets: ['@babel/typescript'] } }]],
+    });
+
+    expect(result?.code).toContain('rotate(360deg)');
+    expect(result?.code).toMatch(/height\s*:\s*['"]?200px['"]?/);
+  });
+});
