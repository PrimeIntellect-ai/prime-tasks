+// TestDependencyInstallerSkipsInquiryForExistingDependency verifies that a dependency that is
+// already present in flow.json (and therefore already installed locally) is not inquired about
+// again when dependencies are installed.
+func TestDependencyInstallerSkipsInquiryForExistingDependency(t *testing.T) {
+	logger := &capturingLogger{}
+	_, state, _ := util.TestMocks(t)
+
+	serviceAcc, _ := state.EmulatorServiceAccount()
+	serviceAddress := serviceAcc.Address
+
+	// The dependency is already present in flow.json.
+	dep := config.Dependency{
+		Name: "Hello",
+		Source: config.Source{
+			NetworkName:  "emulator",
+			Address:      serviceAddress,
+			ContractName: "Hello",
+		},
+	}
+	state.Dependencies().AddOrUpdate(dep)
+
+	// ... and its contract file has already been installed locally.
+	filePath := fmt.Sprintf("imports/%s/%s.cdc", serviceAddress.String(), tests.ContractHelloString.Name)
+	assert.NoError(t, state.ReaderWriter().MkdirAll(filepath.Dir(filePath), 0755))
+	assert.NoError(t, state.ReaderWriter().WriteFile(filePath, tests.ContractHelloString.Source, 0644))
+
+	restore := silencePrompts(t)
+	defer restore()
+
+	gw := mocks.DefaultMockGateway()
+	gw.GetAccount.Run(func(args mock.Arguments) {
+		addr := args.Get(1).(flow.Address)
+		acc := tests.NewAccountWithAddress(addr.String())
+		acc.Contracts = map[string][]byte{
+			tests.ContractHelloString.Name: tests.ContractHelloString.Source,
+		}
+		gw.GetAccount.Return(acc, nil)
+	})
+
+	di := newTestDependencyInstaller(t, logger, state, gw, false, true)
+
+	err := di.Install()
+	assert.NoError(t, err, "Failed to install dependencies")
+
+	assert.Equal(t, 0, logger.countContaining("Hello added to emulator deployments"),
+		"expected no deployment inquiry for a dependency already in flow.json")
+}
