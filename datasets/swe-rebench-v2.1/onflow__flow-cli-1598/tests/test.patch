+// capturingLogger records log messages so tests can assert on user-visible output.
+type capturingLogger struct {
+	infos []string
+}
+
+func (l *capturingLogger) Debug(string)         {}
+func (l *capturingLogger) Info(msg string)      { l.infos = append(l.infos, msg) }
+func (l *capturingLogger) Error(string)         {}
+func (l *capturingLogger) StartProgress(string) {}
+func (l *capturingLogger) StopProgress()        {}
+
+func (l *capturingLogger) countContaining(substr string) int {
+	count := 0
+	for _, msg := range l.infos {
+		if strings.Contains(msg, substr) {
+			count++
+		}
+	}
+	return count
+}
