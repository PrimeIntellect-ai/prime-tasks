+// newTestDependencyInstaller builds a DependencyInstaller through its public constructor and
+// swaps in mock gateways so no network access is required.
+func newTestDependencyInstaller(
+	t *testing.T,
+	logger output.Logger,
+	state *flowkit.State,
+	gw *mocks.TestGateway,
+	skipDeployments bool,
+	skipAlias bool,
+) *DependencyInstaller {
+	t.Helper()
+
+	di, err := NewDependencyInstaller(logger, state, dependencyManagerFlagsCollection{})
+	assert.NoError(t, err)
+
+	di.SkipDeployments = skipDeployments
+	di.SkipAlias = skipAlias
+
+	di.Gateways = map[string]gateway.Gateway{
+		config.EmulatorNetwork.Name: gw.Mock,
+		config.TestnetNetwork.Name:  gw.Mock,
+		config.MainnetNetwork.Name:  gw.Mock,
+	}
+
+	return di
+}
+
+// silencePrompts points os.Stdin at an empty pipe so interactive prompts return immediately
+// instead of blocking on a terminal. It returns a restore function.
+func silencePrompts(t *testing.T) func() {
+	t.Helper()
+
+	origStdin := os.Stdin
+	origReadlineStdin := readline.Stdin
+	r, w, err := os.Pipe()
+	assert.NoError(t, err)
+	assert.NoError(t, w.Close())
+	os.Stdin = r
+	readline.Stdin = r
+
+	return func() {
+		os.Stdin = origStdin
+		readline.Stdin = origReadlineStdin
+		_ = r.Close()
+	}
+}
