+// TestDependencyInstallerAsksOncePerDependency verifies that when a contract pulls in the same
+// dependency more than once (directly and transitively), the deployment inquiry is only shown
+// once for that dependency.
+func TestDependencyInstallerAsksOncePerDependency(t *testing.T) {
+	logger := &capturingLogger{}
+	_, state, _ := util.TestMocks(t)
+
+	serviceAcc, _ := state.EmulatorServiceAccount()
+	serviceAddress := serviceAcc.Address
+
+	// Contract A imports B and C; B also imports C, so C is reached twice while installing A.
+	contractA := []byte(`
+import B from 0x0000000000000001
+import C from 0x0000000000000001
+pub contract A {}
+`)
+	contractB := []byte(`
+import C from 0x0000000000000001
+pub contract B {}
+`)
+	contractC := []byte(`
+pub contract C {}
+`)
+
+	dep := config.Dependency{
+		Name: "A",
+		Source: config.Source{
+			NetworkName:  "emulator",
+			Address:      serviceAddress,
+			ContractName: "A",
+		},
+	}
+	state.Dependencies().AddOrUpdate(dep)
+
+	restore := silencePrompts(t)
+	defer restore()
+
+	gw := mocks.DefaultMockGateway()
+	gw.GetAccount.Run(func(args mock.Arguments) {
+		addr := args.Get(1).(flow.Address)
+		acc := tests.NewAccountWithAddress(addr.String())
+		acc.Contracts = map[string][]byte{
+			"A": contractA,
+			"B": contractB,
+			"C": contractC,
+		}
+		gw.GetAccount.Return(acc, nil)
+	})
+
+	di := newTestDependencyInstaller(t, logger, state, gw, false, true)
+
+	err := di.Install()
+	assert.NoError(t, err, "Failed to install dependencies")
+
+	// C is imported by both A and B, but the deployment inquiry must only be shown once.
+	assert.Equal(t, 1, logger.countContaining("C added to emulator deployments"),
+		"expected the deployment inquiry for C to be shown exactly once")
+}
