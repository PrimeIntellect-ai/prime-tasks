+++ b/test/test_sendrecv.jl
@@ -129,5 +129,18 @@ MPI.Sendrecv!(a, b,  comm_cart;
 
 @test MPI.Waitall(MPI.Request[], MPI.Status) == MPI.Status[]
 
+# PROC_NULL
+X = collect(1:10)
+null_tag = 997
+MPI.Send(X, MPI.COMM_WORLD; tag=null_tag, dest=MPI.PROC_NULL)
+MPI.Barrier(MPI.COMM_WORLD)
+has_null_send_message, _ = MPI.Iprobe(MPI.ANY_SOURCE, null_tag, MPI.COMM_WORLD)
+if has_null_send_message
+    MPI.Recv!(X, MPI.COMM_WORLD; tag=null_tag, source=MPI.ANY_SOURCE)
+end
+MPI.Recv!(X, MPI.COMM_WORLD; tag=null_tag, source=MPI.PROC_NULL)
+@test X == collect(1:10)
+
 MPI.Finalize()
+@test !has_null_send_message
 # @test MPI.Finalized()
