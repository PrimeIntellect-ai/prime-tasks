+def _top_level_date(json_text):
+    """Return the value of the "date" field, tolerating any JSON spacing"""
+    match = re.search(r'"date"\s*:\s*"([^"]*)"', json_text)
+    assert match is not None, 'no "date" field in output'
+    return match.group(1)
+
