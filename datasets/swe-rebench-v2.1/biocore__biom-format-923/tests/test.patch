+        obs_md = [{'foo': i} for i in range(2)]
+        samp_md = [{'bar': i} for i in range(2)]
+        data = [[0, 0, 0.01], [0, 1, 1.5], [1, 0, 0.0], [1, 1, 0.79]]
+        current = datetime.now()
+
+        t = Table(data, obs_ids, samp_ids, obs_md, samp_md, obs_md)
+
+        obs = t.to_json('asd', creation_date=current)
+
+        self.assertIn(current.isoformat(), obs)
+
+    def test_to_json_sparse_float_creation_date_directio(self):
+        """Verify an injected creation date is used when streaming output"""
+        obs_ids = ['a', 'b']
