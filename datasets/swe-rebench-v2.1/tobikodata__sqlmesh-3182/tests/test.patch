+def test_bigquery_quota_project_client_options(make_config):
+    from unittest import mock
+
+    config = make_config(
+        type="bigquery",
+        project="project",
+        quota_project="quota_project",
+    )
+
+    with mock.patch(
+        "google.auth.default", return_value=(mock.MagicMock(), "project")
+    ), mock.patch("google.cloud.bigquery.Client") as mock_client:
+        config.create_engine_adapter()
+
+    client_options = mock_client.call_args.kwargs["client_options"]
+    quota_project_id = (
+        client_options.get("quota_project_id")
+        if isinstance(client_options, t.Mapping)
+        else client_options.quota_project_id
+    )
+    assert quota_project_id == "quota_project"
+
+
+def test_bigquery_credentials_quota_project_is_default(make_config):
+    from unittest import mock
+
+    config = make_config(type="bigquery", project="project")
+    credentials = mock.MagicMock()
+    credentials.quota_project_id = "credentials_quota_project"
+
+    with mock.patch(
+        "google.auth.default", return_value=(credentials, "project")
+    ), mock.patch("google.cloud.bigquery.Client") as mock_client:
+        config.create_engine_adapter()
+
+    passed_credentials = mock_client.call_args.kwargs["credentials"]
+    assert passed_credentials.quota_project_id == "credentials_quota_project"
+
 
