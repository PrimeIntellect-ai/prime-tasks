+func TestMongoV2CustomEventsAndStreamsCollectionOptionBehaviour(t *testing.T) {
+	mt := mtest.New(t, mtest.NewOptions().ClientType(mtest.Mock))
+	defer mt.Close()
+
+	mt.Run("default collection names", func(mt *mtest.T) {
+		mt.AddMockResponses(
+			mtest.CreateSuccessResponse(),                                   // ping
+			mtest.CreateSuccessResponse(),                                   // create events index
+			mtest.CreateCursorResponse(0, "test.streams", mtest.FirstBatch), // find $all stream
+			mtest.CreateSuccessResponse(),                                   // insert $all stream
+		)
+
+		store, err := NewEventStoreWithClient(mt.Client, "test")
+		if err != nil {
+			t.Fatal("there should be no error:", err)
+		}
+		if store == nil {
+			t.Fatal("there should be a store")
+		}
+
+		var eventsCollectionUsed, streamsCollectionUsed bool
+		for _, started := range mt.GetAllStartedEvents() {
+			if started.CommandName == "createIndexes" && started.Command.Lookup("createIndexes").StringValue() == "events" {
+				eventsCollectionUsed = true
+			}
+			if started.CommandName == "find" && started.Command.Lookup("find").StringValue() == "streams" {
+				streamsCollectionUsed = true
+			}
+		}
+		if !eventsCollectionUsed {
+			t.Fatal("event collection setup should target the default events collection")
+		}
+		if !streamsCollectionUsed {
+			t.Fatal("stream initialization should target the default streams collection")
+		}
+	})
+
+	mt.Run("custom collection names", func(mt *mtest.T) {
+		mt.AddMockResponses(
+			mtest.CreateSuccessResponse(),                                   // ping
+			mtest.CreateSuccessResponse(),                                   // create events index
+			mtest.CreateCursorResponse(0, "test.streams", mtest.FirstBatch), // find $all stream
+			mtest.CreateSuccessResponse(),                                   // insert $all stream
+		)
+
+		store, err := NewEventStoreWithClient(mt.Client, "test", WithCollectionNames("foo_events", "bar_streams"))
+		if err != nil {
+			t.Fatal("there should be no error:", err)
+		}
+
+		if store == nil {
+			t.Fatal("there should be a store")
+		}
+
+		var eventsCollectionUsed, streamsCollectionUsed bool
+		for _, started := range mt.GetAllStartedEvents() {
+			if started.CommandName == "createIndexes" && started.Command.Lookup("createIndexes").StringValue() == "foo_events" {
+				eventsCollectionUsed = true
+			}
+			if started.CommandName == "find" && started.Command.Lookup("find").StringValue() == "bar_streams" {
+				streamsCollectionUsed = true
+			}
+		}
+		if !eventsCollectionUsed {
+			t.Fatal("event collection setup should target the supplied collection")
+		}
+		if !streamsCollectionUsed {
+			t.Fatal("stream initialization should target the supplied collection")
+		}
+	})
+
+	mt.Run("equal collection names", func(mt *mtest.T) {
+		_, err := NewEventStoreWithClient(mt.Client, "test", WithCollectionNames("my-collection", "my-collection"))
+		if err == nil || !strings.Contains(err.Error(), "custom collection names are equal") {
+			t.Fatal("there should be an error about equal collection names, got:", err)
+		}
+	})
+
+	mt.Run("both collection names empty", func(mt *mtest.T) {
+		_, err := NewEventStoreWithClient(mt.Client, "test", WithCollectionNames("", ""))
+		if err == nil || !strings.Contains(err.Error(), "custom collection names are equal") {
+			t.Fatal("there should be an error about equal collection names, got:", err)
+		}
+	})
+
+	mt.Run("empty events collection name", func(mt *mtest.T) {
+		_, err := NewEventStoreWithClient(mt.Client, "test", WithCollectionNames("", "my-collection"))
+		if err == nil || !strings.Contains(err.Error(), "missing collection name") {
+			t.Fatal("there should be an error about a missing collection name, got:", err)
+		}
+	})
+
+	mt.Run("empty streams collection name", func(mt *mtest.T) {
+		_, err := NewEventStoreWithClient(mt.Client, "test", WithCollectionNames("my-collection", ""))
+		if err == nil || !strings.Contains(err.Error(), "missing collection name") {
+			t.Fatal("there should be an error about a missing collection name, got:", err)
+		}
+	})
+}
