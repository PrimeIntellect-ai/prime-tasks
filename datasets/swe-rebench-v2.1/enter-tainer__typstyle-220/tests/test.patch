+#[test]
+fn test_all_tab_width() {
+    let space = Workspace::new();
+    space.write(
+        "a.typ",
+        "#let f(x) = {
+for i in range(0, 5) {
+     x = x + i
+    }
+}",
+    );
+
+    let output = space
+        .cli()
+        .arg("format-all")
+        .arg("--tab-width=4")
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "format-all failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+
+    let formatted = space.read_string("a.typ");
+    let indentation = |needle: &str| {
+        let line = formatted
+            .lines()
+            .find(|line| line.contains(needle))
+            .expect("expected formatted line");
+        line.len() - line.trim_start().len()
+    };
+    assert_eq!(indentation("for i in range"), 4);
+    assert_eq!(indentation("x = x + i"), 8);
+}
+
+#[test]
+fn test_single_file_tab_width() {
+    let space = Workspace::new();
+    space.write(
+        "a.typ",
+        "#let f(x) = {
+for i in range(0, 5) {
+     x = x + i
+    }
+}",
+    );
+
+    let output = space
+        .cli()
+        .arg("a.typ")
+        .arg("--tab-width=4")
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "formatting failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+
+    let formatted = String::from_utf8(output.stdout).unwrap();
+    let indentation = |needle: &str| {
+        let line = formatted
+            .lines()
+            .find(|line| line.contains(needle))
+            .expect("expected formatted line");
+        line.len() - line.trim_start().len()
+    };
+    assert_eq!(indentation("for i in range"), 4);
+    assert_eq!(indentation("x = x + i"), 8);
+}
