+func TestSSHResolveUsesCoreSSHCommandFromClientEnvironment(t *testing.T) {
+	dir := t.TempDir()
+	argsFile := filepath.Join(dir, "ssh-args")
+	configuredSSH := `#!/bin/sh
+printf '%s\n' "$@" > "$LFS_SSH_ARGS_FILE"
+printf '%s\n' '{"href":"configured-command"}'
+`
+	fallbackSSH := `#!/bin/sh
+printf '%s\n' '{"href":"default-command"}'
+`
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "configured-ssh"), []byte(configuredSSH), 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "ssh"), []byte(fallbackSSH), 0700))
+	t.Setenv("PATH", dir+string(os.PathListSeparator)+os.Getenv("PATH"))
+	t.Setenv("LFS_SSH_ARGS_FILE", argsFile)
+
+	cli, err := NewClient(NewContext(nil, map[string]string{
+		"GIT_SSH_COMMAND": "",
+		"GIT_SSH":         "",
+	}, map[string]string{
+		"core.sshcommand": "configured-ssh",
+	}))
+	require.NoError(t, err)
+
+	endpoint := Endpoint{SshUserAndHost: "git@example.test", SshPath: "repo"}
+	response, err := cli.SSH.Resolve(endpoint, "GET")
+	require.NoError(t, err)
+	assert.Equal(t, "configured-command", response.Href)
+
+	args, err := os.ReadFile(argsFile)
+	require.NoError(t, err)
+	assert.Contains(t, string(args), "git@example.test")
+	assert.Contains(t, string(args), "git-lfs-authenticate repo download")
+}
