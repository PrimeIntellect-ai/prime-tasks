+@pytest.mark.parametrize("method", ["add_prefix", "add_suffix"])
+@pytest.mark.parametrize("data", test_data_values, ids=test_data_keys)
+def test_add_prefix_suffix_no_partition_map(method, data):
+    modin_series, pandas_series = create_test_series(data)
+    affix = "PREFIX_" if method == "add_prefix" else "_SUFFIX"
+    partition_manager = modin_series._query_compiler._modin_frame._partition_mgr_cls
+    with mock.patch.object(
+        partition_manager,
+        "map_partitions",
+        side_effect=AssertionError("add_prefix/add_suffix mapped all partitions"),
+    ) as map_partitions:
+        modin_result = getattr(modin_series, method)(affix)
+        map_partitions.assert_not_called()
+    pandas_result = getattr(pandas_series, method)(affix)
+    df_equals(modin_result, pandas_result)
+
