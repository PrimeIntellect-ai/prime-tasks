+import axios, { AxiosRequestConfig } from "axios";
+
+function createInstanceWithAdapter(config: AxiosRequestConfig = {}) {
+  const requests: AxiosRequestConfig[] = [];
+  const instance = axios.create({
+    ...config,
+    adapter: (requestConfig: AxiosRequestConfig) => {
+      requests.push(requestConfig);
+      return Promise.resolve({
+        data: {},
+        status: 200,
+        statusText: "OK",
+        headers: {},
+        config: requestConfig
+      });
+    }
+  });
+  return { instance, requests };
+}
+
 test("client can be instantiated", () => {
   const client = new Client({});
   expect(client["axiosInstance"]).toBeDefined();
 });
 
+test("client sends requests through a caller-supplied Axios instance", async () => {
+  const { instance, requests } = createInstanceWithAdapter({ timeout: 1234 });
+  const client = new Client({ axiosInstance: instance });
+
+  await client.directions({
+    params: { origin: "a", destination: "b" }
+  } as DirectionsRequest);
+
+  expect(requests).toHaveLength(1);
+  expect(requests[0].timeout).toEqual(1234);
+});
+
