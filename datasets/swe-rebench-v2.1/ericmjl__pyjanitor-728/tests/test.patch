+import pytest
+import pandas as pd
+from random import randint
+import janitor  # noqa: F401
+import janitor.timeseries  # noqa: F401
+
+
+@pytest.fixture
+def timeseries_dataframe() -> pd.DataFrame:
+    """
+    Returns a time series dataframe
+    """
+    ts_index = pd.date_range("1/1/2019", periods=1000, freq="1H")
+    v1 = [randint(1, 2000) for i in range(1000)]
+    test_df = pd.DataFrame({"v1": v1}, index=ts_index)
+    return test_df
+
+
+# NOTE: The tests possibly can be merged back together later
+# if they are parametrized properly.
+# NOTE: These tests use `df.equals(other_df)`,
+# because the desired `pd.assert_frame_equal(df, other_df)`
+# constantly failed on the CI systems.
+# It's a task for later to fix.
+
+
+@pytest.mark.timeseries
+def test_sort_timestamps_monotonically(timeseries_dataframe):
+    """Test sort_timestamps_monotonically for ascending order"""
+    df = timeseries_dataframe.shuffle(
+        reset_index=False
+    ).sort_timestamps_monotonically()
+    assert df.equals(timeseries_dataframe)
+
+    # Strict mode removes duplicated timestamps, keeping the first occurrence.
+    shuffled = timeseries_dataframe.shuffle(reset_index=False)
+    random_number = randint(0, len(timeseries_dataframe) - 1)
+    duplicated = pd.concat([shuffled, shuffled.iloc[[random_number]]])
+    strict_df = duplicated.sort_timestamps_monotonically(
+        direction="increasing", strict=True
+    )
+    assert strict_df.equals(timeseries_dataframe)
+
+
+@pytest.mark.timeseries
+def test_sort_timestamps_monotonically_decreasing(timeseries_dataframe):
+    """Test sorting disordered timestamps into descending order."""
+    already_decreasing = timeseries_dataframe.sort_index(ascending=False)
+    unchanged = already_decreasing.sort_timestamps_monotonically("decreasing")
+    assert unchanged.equals(already_decreasing)
+
+    disordered = timeseries_dataframe.iloc[[0, 2, 1]]
+    sorted_df = disordered.sort_timestamps_monotonically("decreasing")
+    expected = timeseries_dataframe.iloc[[2, 1, 0]]
+    assert sorted_df.equals(expected)
