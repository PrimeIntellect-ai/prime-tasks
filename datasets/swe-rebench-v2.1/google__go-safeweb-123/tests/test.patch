+func newInterceptor(key string) xsrf.Interceptor {
+	i := xsrf.Interceptor{Identifier: userIdentifier{}}
+	value := reflect.ValueOf(&i).Elem()
+	for _, fieldName := range []string{"AppKey", "SecretAppKey"} {
+		field := value.FieldByName(fieldName)
+		if field.IsValid() && field.CanSet() {
+			field.SetString(key)
+			return i
+		}
+	}
+	return i
