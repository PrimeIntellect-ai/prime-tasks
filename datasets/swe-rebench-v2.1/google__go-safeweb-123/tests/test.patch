+func TestBeforeTokenInRequestContext(t *testing.T) {
+	rec := safehttptest.NewResponseRecorder()
+	req := safehttptest.NewRequest(safehttp.MethodGet, "https://foo.com/pizza", nil)
+
+	i := newInterceptor("testSecretAppKey")
+	i.Before(rec.ResponseWriter, req, nil)
+
+	tok, err := xsrf.Token(req)
+	if tok == "" {
+		t.Error(`xsrf.Token(req): got "", want token`)
+	}
+	if err != nil {
+		t.Errorf("xsrf.Token(req): got %v, want nil", err)
+	}
+	if !xsrftoken.Valid(tok, "testSecretAppKey", "1234", "GET /pizza") && !xsrftoken.Valid(tok, "testSecretAppKey", "1234", "foo.com/pizza") {
+		t.Errorf("xsrf.Token(req) = %q, want a token valid for the secret app key, user ID and action ID", tok)
+	}
