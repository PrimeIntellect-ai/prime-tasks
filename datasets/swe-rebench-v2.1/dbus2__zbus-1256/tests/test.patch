+
+#[test]
+fn issues_1252() {
+    // A field named `key` can be populated while deserializing a dictionary.
+    #[derive(SerializeDict, Type)]
+    #[zvariant(signature = "a{sv}")]
+    struct InputProperties {
+        key: String,
+        val: OwnedValue,
+    }
+
+    #[derive(DeserializeDict, Type)]
+    #[zvariant(signature = "a{sv}")]
+    struct OwnedProperties {
+        key: String,
+        val: OwnedValue,
+    }
+
+    let ctxt = Context::new(Format::DBus, LE, 0);
+    let input = InputProperties {
+        key: "expected key value".to_string(),
+        val: Value::from("other value").try_into().unwrap(),
+    };
+    let serialized = zvariant::to_bytes(ctxt, &input).unwrap();
+    let properties: OwnedProperties = serialized.deserialize().unwrap().0;
+
+    assert_eq!(properties.key, "expected key value");
+}
