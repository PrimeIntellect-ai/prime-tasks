+
+#[test]
+fn reply_to_thread() {
+    use ruma_common::events::room::message::{ForwardThread, Thread};
+
+    let root = OriginalRoomMessageEvent {
+        content: RoomMessageEventContent::text_plain("root"),
+        event_id: event_id!("$root:example.org").to_owned(),
+        origin_server_ts: MilliSecondsSinceUnixEpoch(uint!(10_000)),
+        room_id: room_id!("!testroomid:example.org").to_owned(),
+        sender: user_id!("@user:example.org").to_owned(),
+        unsigned: MessageLikeUnsigned::default(),
+    };
+    let mut threaded_content = RoomMessageEventContent::text_plain("in thread");
+    threaded_content.relates_to = Some(Relation::Thread(Thread::plain(
+        root.event_id.clone(),
+        root.event_id.clone(),
+    )));
+    let threaded = OriginalRoomMessageEvent {
+        content: threaded_content,
+        event_id: event_id!("$threaded:example.org").to_owned(),
+        origin_server_ts: MilliSecondsSinceUnixEpoch(uint!(10_000)),
+        room_id: room_id!("!testroomid:example.org").to_owned(),
+        sender: user_id!("@user:example.org").to_owned(),
+        unsigned: MessageLikeUnsigned::default(),
+    };
+
+    let forwarded = RoomMessageEventContent::text_plain("reply")
+        .make_reply_to(&threaded, ForwardThread::Yes);
+    assert_matches!(
+        forwarded.relates_to,
+        Some(Relation::Thread(Thread { event_id, in_reply_to, .. })) => {
+            assert_eq!(event_id, root.event_id);
+            assert_eq!(in_reply_to.event_id, threaded.event_id);
+        }
+    );
+
+    let not_forwarded = RoomMessageEventContent::text_plain("reply")
+        .make_reply_to(&threaded, ForwardThread::No);
+    assert_matches!(
+        not_forwarded.relates_to,
+        Some(Relation::Reply { in_reply_to }) => {
+            assert_eq!(in_reply_to.event_id, threaded.event_id);
+        }
+    );
+}
