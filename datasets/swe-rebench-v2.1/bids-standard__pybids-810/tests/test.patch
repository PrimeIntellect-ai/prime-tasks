+def test_expand_wildcards():
+    from bids.modeling.statsmodels import expand_wildcards
+
+    # Literal-only selectors keep their values but produce an independent list.
+    selectors = ["a", "b"]
+    expanded_literals = expand_wildcards(selectors, ["a", "c"])
+    assert expanded_literals == ["a", "b"]
+    assert expanded_literals is not selectors
+    # No matches == removal
+    assert expand_wildcards(["a", "b*"], ["a", "c"]) == ["a"]
+    # Wildcard matches occupy their selector's position, while the order
+    # among matches is not prescribed.
+    expanded = expand_wildcards(
+        ["start", "a*", "b", "z*", "finish"],
+        ["z1", "a0", "finish", "a2", "start", "z0", "b"],
+    )
+    assert expanded[0] == "start"
+    assert set(expanded[1:3]) == {"a0", "a2"}
+    assert expanded[3] == "b"
+    assert set(expanded[4:6]) == {"z0", "z1"}
+    assert expanded[6] == "finish"
+    # Repeated patterns are expanded at both original selector positions.
+    repeated = expand_wildcards(
+        ["left", "a*", "middle", "a*", "right"],
+        ["a2", "a1", "left", "middle", "right"],
+    )
+    assert repeated[0] == "left"
+    assert set(repeated[1:3]) == {"a1", "a2"}
+    assert repeated[3] == "middle"
+    assert set(repeated[4:6]) == {"a1", "a2"}
+    assert repeated[6] == "right"
+    # Shell-style '?' matches one character and '[]' matches a character set.
+    assert set(expand_wildcards(["a?"], ["a0", "a1", "ab", "b"])) == {"a0", "a1", "ab"}
+    assert set(expand_wildcards(["a[01]"], ["a0", "a1", "a2", "b"])) == {"a0", "a1"}
+    # A new list is returned; the input selectors are not modified
+    selectors = ["a*", "b"]
+    expand_wildcards(selectors, ["a0", "a1"])
+    assert selectors == ["a*", "b"]
+
+
+def test_wildcards_in_model_x():
+    # Wildcards in a model's X specification are resolved against the
+    # available variables when the design matrix is built.
+    def make_var(name, values):
+        data = pd.DataFrame({"amplitude": values})
+        return SimpleVariable(name=name, data=data, source="participants")
+
+    variables = [
+        make_var("a0", [1, 2, 3]),
+        make_var("a1", [4, 5, 6]),
+        make_var("b", [7, 8, 9]),
+    ]
+    collection = BIDSVariableCollection(variables)
+    node = BIDSStatsModelsNode(
+        level="dataset",
+        name="test",
+        model={"x": ["a*", "b"]},
+        contrasts=[],
+        group_by=[],
+    )
+    node.add_collections([collection])
+    outputs = node.run()
+    assert outputs
+    assert set().union(*(set(output.X.columns) for output in outputs)) == {"a0", "a1", "b"}
