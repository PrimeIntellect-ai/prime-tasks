+import { shallow, createLocalVue } from '@vue/test-utils';
+import VeeValidate from './../../src/index';
+import TestComponent from './components/Snapshot';
+
+const Vue = createLocalVue();
+Vue.use(VeeValidate);
+
+test('snapshots should match', () => {
+  // Simulate two consecutive tests: each mounts the component, renders it,
+  // then tears it down before the next one runs. The generated markup must be
+  // identical so that snapshots taken in separate test runs stay stable.
+  const first = shallow(TestComponent, { localVue: Vue });
+  const firstHtml = first.html();
+  first.destroy();
+
+  const second = shallow(TestComponent, { localVue: Vue });
+  const secondHtml = second.html();
+  second.destroy();
+
+  expect(firstHtml).toBe(secondHtml);
+});
