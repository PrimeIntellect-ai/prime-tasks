+func TestRcCopyReportsOperationFailure(t *testing.T) {
+	r := fstest.NewRun(t)
+	defer r.Finalise()
+	r.Mkdir(context.Background(), r.Fremote)
+
+	opt := rc.DefaultOpt
+	opt.Enabled = true
+	opt.NoAuth = true
+	opt.HTTPOptions.ListenAddr = "127.0.0.1:0"
+	server, err := rcserver.Start(&opt)
+	require.NoError(t, err)
+	require.NotNil(t, server)
+	defer func() {
+		server.Close()
+		server.Wait()
+	}()
+
+	body := strings.NewReader(`{"srcFs":"/non-existing","dstFs":"` + r.FremoteName + `"}`)
+	resp, err := http.Post(server.URL()+"sync/copy", "application/json", body)
+	require.NoError(t, err)
+	defer resp.Body.Close()
+	require.True(t, resp.StatusCode >= http.StatusBadRequest)
+}
