+func TestCheckFsError(t *testing.T) {
+	r := fstest.NewRun(t)
+	defer r.Finalise()
+	nonExistentFs, err := fs.NewFs("/non-existent")
+	require.NoError(t, err)
+
+	err = operations.Check(context.Background(), r.Fremote, nonExistentFs, false)
