 import unittest
 
 from mockito import mock, unstub
+from unittest.mock import Mock, patch
 from selenium.webdriver.common.keys import Keys
 
 from SeleniumLibrary.keywords import ElementKeywords
@@ -20,6 +21,8 @@ class ParsingModifierKeys(unittest.TestCase):
     def test_parsing_one_mofier(self):
         parsed = self.element.parse_modifier('CTRL')
         self.assertEqual(parsed, [Keys.CONTROL])
+        parsed = self.element.parse_modifier('ESCAPE')
+        self.assertEqual(parsed, [Keys.ESCAPE])
         parsed = self.element.parse_modifier('control')
         self.assertEqual(parsed, [Keys.CONTROL])
         parsed = self.element.parse_modifier('alt')
@@ -27,6 +30,18 @@ class ParsingModifierKeys(unittest.TestCase):
         parsed = self.element.parse_modifier('sHifT')
         self.assertEqual(parsed, [Keys.SHIFT])
 
+    def test_click_element_accepts_escape_and_control_aliases(self):
+        element = mock()
+        for modifier, key in [('ESC', Keys.ESCAPE), ('CTRL', Keys.CONTROL)]:
+            action = Mock()
+            with patch('SeleniumLibrary.keywords.element.ActionChains',
+                       return_value=action):
+                with patch.object(self.element, 'find_element',
+                                  return_value=element):
+                    self.element.click_element('button', modifier)
+            action.key_down.assert_called_with(key)
+            action.key_up.assert_called_with(key)
+
     def test_parsing_multiple_modifiers(self):
         parsed = self.element.parse_modifier('ctrl+shift')
         self.assertEqual(parsed, [Keys.CONTROL, Keys.SHIFT])
