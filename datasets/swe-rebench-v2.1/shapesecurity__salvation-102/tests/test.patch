+    @Test public void testReportTo() {
+        ArrayList<Notice> notices = new ArrayList<>();
+
+        parseWithNotices("report-to ", notices);
+        assertTrue(notices.stream().anyMatch(n -> "The report-to directive must contain exactly one token".equals(n.message)));
+
+        notices.clear();
+        parseWithNotices("report-to д", notices);
+        assertTrue(notices.stream().anyMatch(n -> "The report-to directive must contain exactly one token".equals(n.message)));
+
+        notices.clear();
+        parseWithNotices("report-to a b", notices);
+        assertTrue(notices.stream().anyMatch(n -> "The report-to directive must contain exactly one token".equals(n.message)));
+
+        Policy p, q;
+        p = parse("report-to a");
+        q = parse("report-to b");
+        assertNotEquals("different report-to tokens produce distinct policies", p, q);
+        assertTrue(p.show().contains("report-to a"));
+        assertTrue(q.show().contains("report-to b"));
+
+        p = parse("report-to        a");
+        q = parse("report-to a; ");
+        assertEquals("report-to hashcode match", p.hashCode(), q.hashCode());
+        assertTrue("report-to equals", p.equals(q));
+
+    }
