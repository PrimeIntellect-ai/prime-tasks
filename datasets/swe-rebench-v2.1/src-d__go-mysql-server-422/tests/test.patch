@@ -0,0 +1,162 @@
+package plan
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"gopkg.in/src-d/go-mysql-server.v0/mem"
+	"gopkg.in/src-d/go-mysql-server.v0/sql"
+)
+
+func TestShowColumns(t *testing.T) {
+	require := require.New(t)
+
+	table := NewResolvedTable(mem.NewTable("foo", sql.Schema{
+		{Name: "a", Type: sql.Text},
+		{Name: "b", Type: sql.Int64, Nullable: true},
+		{Name: "c", Type: sql.Int64, Default: int64(1)},
+	}))
+
+	iter, err := NewShowColumns(false, table).RowIter(sql.NewEmptyContext())
+	require.NoError(err)
+
+	rows, err := sql.RowIterToRows(iter)
+	require.NoError(err)
+
+	expected := []sql.Row{
+		sql.Row{"a", "TEXT", "NO", "", "", ""},
+		sql.Row{"b", "INT64", "YES", "", "", ""},
+		sql.Row{"c", "INT64", "NO", "", "1", ""},
+	}
+
+	require.ElementsMatch(
+		normalizeShowColumnsTypes(normalizeShowColumnsMetadata(expected, false)),
+		normalizeShowColumnsTypes(normalizeShowColumnsMetadata(rows, false)),
+	)
+}
+
+func TestShowColumnsFull(t *testing.T) {
+	require := require.New(t)
+
+	table := NewResolvedTable(mem.NewTable("foo", sql.Schema{
+		{Name: "a", Type: sql.Text},
+		{Name: "b", Type: sql.Int64, Nullable: true},
+		{Name: "c", Type: sql.Int64, Default: int64(1)},
+	}))
+
+	iter, err := NewShowColumns(true, table).RowIter(sql.NewEmptyContext())
+	require.NoError(err)
+
+	rows, err := sql.RowIterToRows(iter)
+	require.NoError(err)
+
+	expected := []sql.Row{
+		sql.Row{"a", "TEXT", "utf8_bin", "NO", "", "", "", "", ""},
+		sql.Row{"b", "INT64", nil, "YES", "", "", "", "", ""},
+		sql.Row{"c", "INT64", nil, "NO", "", "1", "", "", ""},
+	}
+
+	require.ElementsMatch(
+		normalizeShowColumnsTypes(normalizeShowColumnsMetadata(normalizeShowColumnsCollation(expected), true)),
+		normalizeShowColumnsTypes(normalizeShowColumnsMetadata(normalizeShowColumnsCollation(rows), true)),
+	)
+}
+
+// normalizeShowColumnsTypes maps the Type column onto a type category, so that
+// any reasonable MySQL-style spelling of a type is accepted.
+func normalizeShowColumnsTypes(rows []sql.Row) []sql.Row {
+	normalized := make([]sql.Row, len(rows))
+	for i, row := range rows {
+		copy := append(sql.Row(nil), row...)
+		if len(copy) > 1 {
+			if s, ok := copy[1].(string); ok {
+				copy[1] = showColumnTypeCategory(s)
+			}
+		}
+		normalized[i] = copy
+	}
+	return normalized
+}
+
+func showColumnTypeCategory(typ string) string {
+	t := strings.ToLower(typ)
+	switch {
+	case strings.Contains(t, "int"):
+		return "integer"
+	case strings.Contains(t, "text"), strings.Contains(t, "char"):
+		return "text"
+	default:
+		return t
+	}
+}
+
+func normalizeShowColumnsMetadata(rows []sql.Row, full bool) []sql.Row {
+	normalized := make([]sql.Row, len(rows))
+	for i, row := range rows {
+		copy := append(sql.Row(nil), row...)
+		metadataColumns := []int{3, 5}
+		if full {
+			metadataColumns = []int{4, 6, 7, 8}
+		}
+		for _, column := range metadataColumns {
+			if column < len(copy) {
+				copy[column] = nil
+			}
+		}
+		normalized[i] = copy
+	}
+	return normalized
+}
+
+func normalizeShowColumnsCollation(rows []sql.Row) []sql.Row {
+	normalized := make([]sql.Row, len(rows))
+	for i, row := range rows {
+		copy := append(sql.Row(nil), row...)
+		if len(copy) > 2 && (copy[2] == nil || copy[2] == "") {
+			copy[2] = ""
+		}
+		normalized[i] = copy
+	}
+	return normalized
+}
+
+func TestShowColumnsSchema(t *testing.T) {
+	require := require.New(t)
+
+	table := NewResolvedTable(mem.NewTable("foo", sql.Schema{
+		{Name: "a", Type: sql.Text},
+	}))
+
+	require.Equal(
+		[]string{"Field", "Type", "Null", "Key", "Default", "Extra"},
+		schemaColumnNames(NewShowColumns(false, table).Schema()),
+	)
+	require.Equal(
+		[]string{"Field", "Type", "Collation", "Null", "Key", "Default", "Extra", "Privileges", "Comment"},
+		schemaColumnNames(NewShowColumns(true, table).Schema()),
+	)
+}
+
+func schemaColumnNames(s sql.Schema) []string {
+	names := make([]string, len(s))
+	for i, col := range s {
+		names[i] = col.Name
+	}
+	return names
+}
+
+func TestShowColumnsString(t *testing.T) {
+	require := require.New(t)
+
+	table := NewResolvedTable(mem.NewTable("foo", sql.Schema{
+		{Name: "a", Type: sql.Text},
+	}))
+
+	short := NewShowColumns(false, table).String()
+	require.Equal("ShowColumns", strings.SplitN(short, "\n", 2)[0])
+	require.NotContains(short, "full")
+
+	full := NewShowColumns(true, table).String()
+	require.Equal("ShowColumns(full)", strings.SplitN(full, "\n", 2)[0])
+}
