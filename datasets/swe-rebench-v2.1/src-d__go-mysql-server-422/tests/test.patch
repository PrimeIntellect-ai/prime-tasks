 func TestQueries(t *testing.T) {
@@ -746,10 +787,79 @@ func testQuery(t *testing.T, e *sqle.Engine, q string, expected []sql.Row) {
 		rows, err := sql.RowIterToRows(iter)
 		require.NoError(err)
 
+		query := strings.ToUpper(strings.TrimSpace(q))
+		if strings.HasPrefix(query, "SHOW FULL COLUMNS ") {
+			rows = normalizeAbsentCollation(rows)
+			expected = normalizeAbsentCollation(expected)
+			rows = normalizeShowColumnMetadata(rows, true)
+			expected = normalizeShowColumnMetadata(expected, true)
+		} else if strings.HasPrefix(query, "SHOW COLUMNS ") || strings.HasPrefix(query, "SHOW FIELDS ") {
+			rows = normalizeShowColumnMetadata(rows, false)
+			expected = normalizeShowColumnMetadata(expected, false)
+		}
 		require.ElementsMatch(expected, rows)
 	})
 }
 
+func normalizeAbsentCollation(rows []sql.Row) []sql.Row {
+	normalized := make([]sql.Row, len(rows))
+	for i, row := range rows {
+		copy := append(sql.Row(nil), row...)
+		if len(copy) > 2 && (copy[2] == nil || copy[2] == "") {
+			copy[2] = ""
+		}
+		normalized[i] = copy
+	}
+	return normalized
+}
+
+// normalizeShowColumnTypes maps the Type column onto a type category, so that
+// any reasonable MySQL-style spelling of a type (INT64, BIGINT, TEXT, VARCHAR...)
+// is accepted as long as it denotes the same kind of type.
+func normalizeShowColumnTypes(rows []sql.Row) []sql.Row {
+	normalized := make([]sql.Row, len(rows))
+	for i, row := range rows {
+		copy := append(sql.Row(nil), row...)
+		if len(copy) > 1 {
+			if s, ok := copy[1].(string); ok {
+				copy[1] = showColumnTypeCategory(s)
+			}
+		}
+		normalized[i] = copy
+	}
+	return normalized
+}
+
+func showColumnTypeCategory(typ string) string {
+	t := strings.ToLower(typ)
+	switch {
+	case strings.Contains(t, "int"):
+		return "integer"
+	case strings.Contains(t, "text"), strings.Contains(t, "char"):
+		return "text"
+	default:
+		return t
+	}
+}
+
+func normalizeShowColumnMetadata(rows []sql.Row, full bool) []sql.Row {
+	normalized := make([]sql.Row, len(rows))
+	for i, row := range rows {
+		copy := append(sql.Row(nil), row...)
+		metadataColumns := []int{3, 5}
+		if full {
+			metadataColumns = []int{4, 6, 7, 8}
+		}
+		for _, column := range metadataColumns {
+			if column < len(copy) {
+				copy[column] = nil
+			}
+		}
+		normalized[i] = copy
+	}
+	return normalized
+}
+
