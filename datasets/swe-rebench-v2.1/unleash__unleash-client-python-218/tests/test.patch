+def test_get_feature_toggle_retries_connection_failure(caplog, monkeypatch):
+    class FeatureHandler(BaseHTTPRequestHandler):
+        def do_GET(self):
+            body = json.dumps(MOCK_FEATURE_RESPONSE_PROJECT).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(body)))
+            self.send_header("ETag", ETAG_VALUE)
+            self.end_headers()
+            self.wfile.write(body)
+
+        def log_message(self, format, *args):
+            pass
+
+    server = HTTPServer(("127.0.0.1", 0), FeatureHandler)
+    server_thread = threading.Thread(target=server.serve_forever, daemon=True)
+    server_thread.start()
+    original_connect = socket.socket.connect
+    failed_once = [False]
+
+    def fail_first_connection(sock, address):
+        if address == server.server_address and not failed_once[0]:
+            failed_once[0] = True
+            raise OSError("temporary connection failure")
+        return original_connect(sock, address)
+
+    monkeypatch.setattr(socket.socket, "connect", fail_first_connection)
+    try:
+        (result, etag) = get_feature_toggles(f"http://127.0.0.1:{server.server_port}",
+                                             APP_NAME,
+                                             INSTANCE_ID,
+                                             CUSTOM_HEADERS,
+                                             CUSTOM_OPTIONS)
+    finally:
+        server.shutdown()
+        server.server_close()
+        server_thread.join()
+
+    assert failed_once[0]
+    assert len(result["features"]) == 1
+    assert etag == ETAG_VALUE
+    assert not [record for record in caplog.records if record.name == "UnleashClient" and record.levelno >= 30]
