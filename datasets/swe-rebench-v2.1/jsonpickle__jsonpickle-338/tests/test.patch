+def test_repeat_objects_are_expanded():
+    """Ensure that all objects are present in the json output"""
+    # When references are disabled we should create expanded copies
+    # of any object that appears more than once in the object stream.
+    alice = Thing('alice')
+    bob = Thing('bob')
+    alice.child = bob
+
+    car = Thing('car')
+    car.driver = alice
+    car.owner = alice
+    car.passengers = [alice, bob]
+
+    encoded = jsonpickle.encode(car, make_refs=False)
+    decoded = jsonpickle.decode(encoded)
+
+    assert decoded.name == 'car'
+    assert decoded.driver.name == 'alice'
+    assert decoded.owner.name == 'alice'
+    assert decoded.passengers[0].name == 'alice'
+    assert decoded.passengers[1].name == 'bob'
+    assert decoded.driver.child.name == 'bob'
+    assert decoded.passengers[0].child.name == 'bob'
+
+
 def suite():
     suite = unittest.TestSuite()
     suite.addTest(unittest.makeSuite(JSONPickleTestCase))
