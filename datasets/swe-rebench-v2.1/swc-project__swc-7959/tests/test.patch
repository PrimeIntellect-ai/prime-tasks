+#[testing::fixture("tests/const-modules/**/input.js")]
+fn const_modules_test(input: PathBuf) {
+    let globals_path = input.with_file_name("globals.json");
+    let globals: HashMap<String, HashMap<String, String>> =
+        serde_json::from_str(&read_to_string(globals_path).unwrap()).unwrap();
+    let globals = globals
+        .into_iter()
+        .map(|(module, values)| {
+            (
+                module.into(),
+                values.into_iter().map(|(name, value)| (name.into(), value)).collect(),
+            )
+        })
+        .collect();
+    let source = read_to_string(&input).unwrap();
+
+    let transformed = Tester::run(|t| {
+        let module = t.apply_transform(
+            const_modules(t.cm.clone(), globals),
+            "input.js",
+            ::swc_ecma_parser::Syntax::default(),
+            &source,
+        )?;
+        Ok(t.print(&module, &t.comments.clone()))
+    });
+    let compact: String = transformed.chars().filter(|c| !c.is_whitespace()).collect();
+
+    assert!(compact.contains("exportfunction_(){"));
+    let function_start = compact.find("exportfunction_(){").unwrap();
+    let replaced_both_uses = [
+        "console.log(42)",
+        "console.log(\"42\")",
+        "console.log('42')",
+    ]
+    .iter()
+    .any(|call| {
+        compact[..function_start].contains(call)
+            && compact[function_start..].contains(call)
+            && compact.matches(call).count() == 2
+    });
+    assert!(
+        replaced_both_uses,
+        "both import uses should be replaced by the configured constant: {transformed}"
+    );
+}
