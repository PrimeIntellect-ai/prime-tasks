+def test_debug_filetype_with_py():
+    with tempfile.NamedTemporaryFile(suffix=".py", mode='w+') as f:
+        f.write('print("debugged file ran")\n')
+        f.flush()
+        command = [BIN_DIR+"/py", "--debug", f.name]
+
+        output_result = b""
+        child = pexpect.spawn(' '.join(command), timeout=5)
+        child.expect('ipdb>')
+        output_result += child.before
+        child.sendline('c')
+        output_result += child.before
+        child.expect(pexpect.EOF)
+        output_result += child.before
+
+        assert "debugged file ran" in output_result.decode().splitlines()
+
+
