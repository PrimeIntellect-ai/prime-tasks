+"""
+Test functions in model_builder.
+"""
+
+import pytest
+import numpy as np
+from simpeg.utils.model_builder import create_random_model
+
+
+class TestDeprecateSeedProperty:
+    """
+    Test deprecation of seed property.
+    """
+
+    @pytest.fixture
+    def shape(self):
+        return (5, 5)
+
+    def test_warning_argument(self, shape):
+        """
+        Test if warning is raised after passing ``seed`` as argument.
+        """
+        seed = 42135
+        with pytest.warns(FutureWarning):
+            result = create_random_model(shape, seed=seed)
+        np.testing.assert_allclose(result, create_random_model(shape, random_seed=seed))
+
+    def test_random_seed_reproducible(self, shape):
+        """
+        Test that the same ``random_seed`` produces the same model.
+        """
+        first = create_random_model(shape, random_seed=42)
+        second = create_random_model(shape, random_seed=42)
+        np.testing.assert_allclose(first, second)
+
+    def test_output_shape_and_bounds(self, shape):
+        """
+        Test the returned model has the requested shape and respects ``bounds``.
+        """
+        bounds = [0.2, 0.8]
+        result = create_random_model(shape, random_seed=42, bounds=bounds)
+        assert isinstance(result, np.ndarray)
+        assert result.shape == shape
+        assert result.min() >= bounds[0]
+        assert result.max() <= bounds[1]
+
+    def test_output_shape_int(self):
+        """
+        Test the returned model has the requested shape when ``shape`` is an int.
+        """
+        result = create_random_model(7, random_seed=42)
+        assert isinstance(result, np.ndarray)
+        assert result.shape == (7,)
