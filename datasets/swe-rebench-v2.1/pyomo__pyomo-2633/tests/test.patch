+    def test_stale_pickle(self):
+        # Pickling a model must preserve the stale status of its variables
+        # (see GitHub issue: "Fixed Vars unpickle as stale")
+        m = ConcreteModel()
+        m.x = Var(initialize=0)
+        self.assertFalse(m.x.stale)
+        m.y = Var()
+        m.w = Var(domain=Binary)
+        m.w.fix(1)
+        self.assertFalse(m.w.stale)
+
+        i = pickle.loads(pickle.dumps(m))
+        self.assertFalse(i.x.stale)
+        self.assertTrue(i.y.stale)
+        self.assertFalse(i.w.stale)
+
+
 if __name__ == "__main__":
     unittest.main()
