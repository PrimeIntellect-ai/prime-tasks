+import dedent from 'ts-dedent';
+import {load} from 'js-yaml';
+import {LinterSettings, rules} from '../src/rules';
+import {NormalArrayFormats} from '../src/utils/yaml';
+import EscapeYamlSpecialCharacters from '../src/rules/escape-yaml-special-characters';
+import {RulesRunner, createRunLinterRulesOptions} from '../src/rules-runner';
+
+function createSettings(): LinterSettings {
+  const ruleConfigs: Record<string, Record<string, unknown>> = {};
+  for (const rule of rules) {
+    ruleConfigs[rule.name] = rule.getDefaultOptions();
+  }
+
+  const escapeRule = EscapeYamlSpecialCharacters.getRule();
+  ruleConfigs[escapeRule.name] = {...escapeRule.getDefaultOptions(), [escapeRule.enabledOptionName()]: true};
+
+  return {
+    ruleConfigs,
+    commonStyles: {
+      aliasArrayStyle: NormalArrayFormats.SingleLine,
+      tagArrayStyle: NormalArrayFormats.SingleLine,
+      minimumNumberOfDollarSignsToBeAMathBlock: 2,
+      escapeCharacter: '"',
+    },
+  } as unknown as LinterSettings;
+}
+
+describe('Escape YAML Special Characters', () => {
+  it('keeps gist metadata as valid YAML containing a sequence of mappings', () => {
+    const before = dedent`
+      ---
+      gists:
+        - id: testing123
+          url: 'https://gist.github.com/testing123'
+          createdAt: '2022-11-01T16:07:48Z'
+          updatedAt: '2022-11-01T16:35:11Z'
+          filename: file1.md
+          isPublic: true
+      ---
+    `;
+    const runOptions = createRunLinterRulesOptions(before, null, 'en', createSettings());
+    const output = new RulesRunner().lintText(runOptions);
+    const yamlContent = output.replace(/^---\r?\n/, '').replace(/\r?\n---\s*$/, '');
+    const parsed = load(yamlContent) as {gists: Array<Record<string, unknown>>};
+
+    expect(parsed.gists).toHaveLength(1);
+    expect(parsed.gists[0]).toMatchObject({
+      id: 'testing123',
+      url: 'https://gist.github.com/testing123',
+      filename: 'file1.md',
+      isPublic: true,
+    });
+  });
+});
