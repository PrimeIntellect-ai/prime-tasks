+class DocumentationTestCase(unittest.TestCase):
+    DOCS_PATH = Path(__file__).resolve().parents[2] / "docs" / "incompatibilities.md"
+
+    def documentation_for(self, code):
+        """Prose of the docs plus the table row of `code`, lowercased.
+
+        Table rows describing other codes are left out, so that a mention of
+        a different code cannot satisfy the check. Explanations may live in
+        the code's own row or in any surrounding prose.
+        """
+        kept = []
+        for line in self.DOCS_PATH.read_text(encoding="utf-8").splitlines():
+            if not line.startswith("|") or f"`{code}`" in line:
+                kept.append(line)
+        return "\n".join(kept).lower()
+
+    def test_create_index_exclusive_docs_explain_concurrently(self):
+        description = self.documentation_for("CREATE_INDEX_EXCLUSIVE")
+        self.assertIn(
+            "concurrent",
+            description,
+            "CREATE_INDEX_EXCLUSIVE documentation must explain that using CONCURRENTLY does not address the issue",
+        )
+
+    def test_create_index_docs_explain_concurrent_guidance(self):
+        description = self.documentation_for("CREATE_INDEX")
+        self.assertTrue(
+            "concurrent" in description and "lock" in description,
+            "CREATE_INDEX documentation must explain that concurrent index creation avoids the table-locking warning",
+        )
