+def test_right_differently_named_keys_retains_other_only_rows():
+    left = vaex.from_arrays(left_key=np.array(['matched']), left_value=np.array([7]))
+    right = vaex.from_arrays(right_key=np.array(['matched', 'other-only']),
+                             right_value=np.array([8, 9]))
+    left_columns = list(left.column_names)
+    right_columns = list(right.column_names)
+
+    result = left.join(right, left_on='left_key', right_on='right_key', how='right')
+
+    assert result is not left
+    assert result is not right
+    assert list(left.column_names) == left_columns
+    assert list(right.column_names) == right_columns
+    assert left.left_key.tolist() == ['matched']
+    assert left.left_value.tolist() == [7]
+    assert right.right_key.tolist() == ['matched', 'other-only']
+    assert right.right_value.tolist() == [8, 9]
+    assert result.right_key.tolist() == ['matched', 'other-only']
+    assert result.right_value.tolist() == [8, 9]
+    assert result.left_key.tolist() == ['matched', None]
+    assert result.left_value.tolist() == [7, None]
