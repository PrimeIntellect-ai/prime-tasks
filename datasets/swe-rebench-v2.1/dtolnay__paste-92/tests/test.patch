+#[test]
+fn test_invalid_numeric_paste_diagnostic() {
+    use std::fs;
+    use std::process::Command;
+
+    let temp = std::env::temp_dir().join(format!("paste-invalid-numeric-{}", std::process::id()));
+    let src = temp.join("src");
+    fs::create_dir_all(&src).unwrap();
+    let manifest_dir = std::env::var("CARGO_MANIFEST_DIR").unwrap();
+    let manifest_dir = manifest_dir.replace('\\', "\\\\").replace('"', "\\\"");
+    fs::write(
+        temp.join("Cargo.toml"),
+        format!(
+            "[package]\nname = \"paste_invalid_numeric_diagnostic\"\nversion = \"0.0.0\"\nedition = \"2018\"\n\n[dependencies]\npaste = {{ path = \"{}\" }}\n",
+            manifest_dir,
+        ),
+    )
+    .unwrap();
+    fs::write(
+        src.join("main.rs"),
+        "use paste::paste;\n\npaste! {\n    fn [<0 f>]() {}\n}\nfn main() {}\n",
+    )
+    .unwrap();
+
+    let output = Command::new("cargo")
+        .arg("check")
+        .arg("--offline")
+        .arg("--manifest-path")
+        .arg(temp.join("Cargo.toml"))
+        .env("CARGO_TARGET_DIR", temp.join("target"))
+        .output()
+        .unwrap();
+    let _ = fs::remove_dir_all(&temp);
+    let diagnostic = String::from_utf8_lossy(&output.stderr);
+
+    assert!(!output.status.success());
+    assert!(diagnostic.contains("error: expected identifier, found `0f`"));
+    assert!(diagnostic.contains("src/main.rs:3:1"));
+    assert!(diagnostic.contains(
+        "= note: this error originates in the macro `paste` (in Nightly builds, run with -Z macro-backtrace for more info)"
+    ));
+}
