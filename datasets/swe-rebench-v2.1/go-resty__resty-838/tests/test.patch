+func TestTransportSettingsResponseHeaderTimeout(t *testing.T) {
+	newServer := func(delay time.Duration) *httptest.Server {
+		return createTestServer(func(w http.ResponseWriter, r *http.Request) {
+			time.Sleep(delay)
+			_, _ = w.Write([]byte("ready"))
+		})
+	}
+
+	t.Run("positive value limits waiting for response headers", func(t *testing.T) {
+		ts := newServer(100 * time.Millisecond)
+		defer ts.Close()
+
+		client := NewWithTransportSettings(&TransportSettings{ResponseHeaderTimeout: 10 * time.Millisecond})
+		client.SetBaseURL(ts.URL)
+		_, err := client.R().Get("/")
+		assertNotNil(t, err)
+	})
+
+	t.Run("zero leaves response header waiting unrestricted", func(t *testing.T) {
+		ts := newServer(100 * time.Millisecond)
+		defer ts.Close()
+
+		client := NewWithTransportSettings(&TransportSettings{ResponseHeaderTimeout: 0})
+		client.SetBaseURL(ts.URL)
+		resp, err := client.R().Get("/")
+		assertNil(t, err)
+		assertEqual(t, resp.String(), "ready")
+	})
+}
+
+func TestTransportSettingsMaxResponseHeaderBytes(t *testing.T) {
+	ts := createTestServer(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-Large", strings.Repeat("x", 2048))
+		_, _ = w.Write([]byte("ready"))
+	})
+	defer ts.Close()
+
+	t.Run("positive value limits response header size", func(t *testing.T) {
+		client := NewWithTransportSettings(&TransportSettings{MaxResponseHeaderBytes: 1024})
+		client.SetBaseURL(ts.URL)
+		_, err := client.R().Get("/")
+		assertNotNil(t, err)
+	})
+
+	t.Run("zero retains the HTTP transport default limit", func(t *testing.T) {
+		client := NewWithTransportSettings(&TransportSettings{MaxResponseHeaderBytes: 0})
+		client.SetBaseURL(ts.URL)
+		resp, err := client.R().Get("/")
+		assertNil(t, err)
+		assertEqual(t, resp.String(), "ready")
+	})
+}
+
+func TestTransportSettingsIdleConnTimeout(t *testing.T) {
+	var connectionCount int32
+	ts := createTestServer(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = w.Write([]byte("ready"))
+	})
+	ts.Config.ConnState = func(_ net.Conn, state http.ConnState) {
+		if state == http.StateNew {
+			atomic.AddInt32(&connectionCount, 1)
+		}
+	}
+	defer ts.Close()
+
+	client := NewWithTransportSettings(&TransportSettings{IdleConnTimeout: 20 * time.Millisecond})
+	client.SetBaseURL(ts.URL)
+
+	for i := 0; i < 2; i++ {
+		resp, err := client.R().Get("/")
+		assertNil(t, err)
+		assertEqual(t, resp.String(), "ready")
+		if i == 0 {
+			time.Sleep(100 * time.Millisecond)
+		}
+	}
+	assertEqual(t, atomic.LoadInt32(&connectionCount), int32(2))
+}
