+func TestTransportSettingsDisableCompression(t *testing.T) {
+	var gotAcceptEncoding atomic.Value
+	ts := createTestServer(func(w http.ResponseWriter, r *http.Request) {
+		gotAcceptEncoding.Store(r.Header.Get("Accept-Encoding"))
+		_, _ = w.Write([]byte("TestGet: text response"))
+	})
+	defer ts.Close()
+
+	client := NewWithTransportSettings(&TransportSettings{DisableCompression: true})
+	client.SetBaseURL(ts.URL)
+
+	resp, err := client.R().Get("/")
+	assertNil(t, err)
+	assertEqual(t, resp.String(), "TestGet: text response")
+	assertEqual(t, gotAcceptEncoding.Load().(string), "")
+}
