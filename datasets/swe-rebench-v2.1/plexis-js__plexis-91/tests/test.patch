@@ -0,0 +1,54 @@
+import {parse} from '@babel/parser';
+import {readFileSync} from 'fs';
+import compare from '@plexis/compare';
+import * as plexis from '../../plexis/src';
+
+it('Should compare strings naturally', () => {
+  expect(compare('', '')).toBe(0);
+  expect(compare('A', 'a')).toBe(1);
+  expect(compare('A', 'b')).toBe(1);
+  expect(compare('A woman', 'a woman')).toBe(1);
+  expect(compare('b', 'B')).toBe(-1);
+  expect(compare('C', 'b')).toBe(-1);
+  expect(compare('Qux20', 'Qux5')).toBe(-1);
+  expect(compare('Qux10', 'Qux11')).toBe(1);
+});
+
+it('exposes working comparator aliases from plexis', () => {
+  [plexis.compare, plexis.compareLikeHuman, plexis.naturalCompare].forEach(
+    (alias) => {
+      expect(alias).toEqual(expect.any(Function));
+      expect(alias('Qux20', 'Qux5')).toBe(-1);
+    },
+  );
+});
+
+it('declares comparator aliases in the required order before compose', () => {
+  const source = readFileSync(
+    `${__dirname}/../../plexis/src/index.js`,
+    'utf8',
+  );
+  const exportedNames = parse(source, {sourceType: 'module'}).program.body
+    .filter((statement) => statement.type === 'ExportNamedDeclaration')
+    .flatMap((statement) => {
+      const fromSpecifiers = statement.specifiers.map(
+        (specifier) => specifier.exported.name,
+      );
+      const declaration = statement.declaration;
+      const fromDeclaration = !declaration
+        ? []
+        : declaration.type === 'VariableDeclaration'
+          ? declaration.declarations.map((item) => item.id.name)
+          : [declaration.id.name];
+      return [...fromSpecifiers, ...fromDeclaration];
+    });
+
+  const aliasIndex = exportedNames.indexOf('compare');
+  expect(aliasIndex).toBeGreaterThanOrEqual(0);
+  expect(exportedNames.slice(aliasIndex, aliasIndex + 4)).toEqual([
+    'compare',
+    'compareLikeHuman',
+    'naturalCompare',
+    'compose',
+  ]);
+});
