+
+
+def test_evaluate_constant():
+    grammar = '''
+        @@grammar :: constants
+        start = int bool str null 'a' $;
+
+        int = `42` ;
+        bool = `True` ;
+        str = `Something` ;
+        null = `None` ;
+    '''
+
+    ast = parse(grammar, 'a')
+    assert ast == (42, True, 'Something', None, 'a')
