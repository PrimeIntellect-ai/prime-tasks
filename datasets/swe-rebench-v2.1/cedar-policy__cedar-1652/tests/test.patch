+#[test]
+fn actions_in_request_context() {
+    let (schema, _) = json_schema::Fragment::from_cedarschema_str(
+        r#"
+        entity User;
+        entity Session;
+        action getSession, deleteSession appliesTo {
+            principal: [User],
+            resource: [Session],
+            context: { target: Set<Action> },
+        };
+    "#,
+        Extensions::all_available(),
+    )
+    .unwrap();
+    let schema = ValidatorSchema::try_from(schema).unwrap();
+    let principal = (
+        crate::ast::EntityUID::from_str(r#"User::"alice""#).unwrap(),
+        None,
+    );
+    let action = (
+        crate::ast::EntityUID::from_str(r#"Action::"getSession""#).unwrap(),
+        None,
+    );
+    let resource = (
+        crate::ast::EntityUID::from_str(r#"Session::"s1""#).unwrap(),
+        None,
+    );
+    let context_with = |id: &str| {
+        crate::ast::Context::from_json_value(json!({
+            "target": [{ "__entity": { "type": "Action", "id": id } }]
+        }))
+        .unwrap()
+    };
+
+    // A declared action referenced from the request context is accepted.
+    assert!(crate::ast::Request::new(
+        principal.clone(),
+        action.clone(),
+        resource.clone(),
+        context_with("deleteSession"),
+        Some(&schema),
+        &Extensions::all_available(),
+    )
+    .is_ok());
+
+    // An action UID that the schema does not declare is rejected.
+    assert!(crate::ast::Request::new(
+        principal,
+        action,
+        resource,
+        context_with("notDeclared"),
+        Some(&schema),
+        &Extensions::all_available(),
+    )
+    .is_err());
+}
