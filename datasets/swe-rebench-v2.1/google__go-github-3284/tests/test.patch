+func TestCreateOrUpdateOrgRoleOptions_BaseRoleInCreateRequest(t *testing.T) {
+	client, mux, _, teardown := setup()
+	defer teardown()
+
+	mux.HandleFunc("/orgs/o/organization-roles", func(w http.ResponseWriter, r *http.Request) {
+		testMethod(t, r, "POST")
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("failed to read request body: %v", err)
+		}
+		if !strings.Contains(string(body), `"base_role":"read"`) {
+			t.Errorf("CreateCustomOrgRole request body = %s, want it to contain %q", body, `"base_role":"read"`)
+		}
+		fmt.Fprint(w, `{"id":8030,"name":"Reader","base_role":"read","permissions":["read_organization_custom_org_role"]}`)
+	})
+
+	ctx := context.Background()
+	opts := &CreateOrUpdateOrgRoleOptions{
+		Name:        String("Reader"),
+		Description: String("A role for reading custom org roles"),
+		BaseRole:    String("read"),
+		Permissions: []string{"read_organization_custom_org_role"},
+	}
+	if _, _, err := client.Organizations.CreateCustomOrgRole(ctx, "o", opts); err != nil {
+		t.Errorf("Organizations.CreateCustomOrgRole returned error: %v", err)
+	}
+}
