+import { html, render } from '../renderer.js';
+
+export default class PropPasser extends HTMLElement {
+  connectedCallback() {
+    const data = { foo: 'bar' };
+    const message = 'Hello World';
+    render(html`<prop-receiver .data=${data} .message=${message}></prop-receiver>`, this);
+  }
+}
+
+customElements.define('prop-passer', PropPasser);
+export class ShadowPropPasser extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+  }
+
+  connectedCallback() {
+    const data = { foo: 'shadow object' };
+    const message = 'shadow primitive';
+    render(html`<prop-receiver .data=${data} .message=${message}></prop-receiver>`, this.shadowRoot);
+  }
+}
+
+customElements.define('shadow-prop-passer', ShadowPropPasser);
