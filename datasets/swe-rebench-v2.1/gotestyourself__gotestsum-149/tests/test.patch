+func TestRerunFailed_RawCommandUsesAcceptedTestSelection(t *testing.T) {
+	runner := fs.NewFile(t, "raw-test-runner")
+	defer runner.Remove()
+
+	script := `#!/bin/sh
+set -eu
+selector=
+while [ "$#" -gt 0 ]; do
+  arg=$1
+  shift
+  case "$arg" in
+    -test.run=*) selector=${arg#-test.run=} ;;
+    -test.run) selector=$1; shift ;;
+    -run|-run=*) false ;;
+  esac
+done
+if [ -z "$selector" ]; then
+  printf '%s\n' '{"Package":"pkg","Action":"run"}'
+  printf '%s\n' '{"Package":"pkg","Test":"TestOne","Action":"run"}'
+  printf '%s\n' '{"Package":"pkg","Test":"TestOne","Action":"fail"}'
+  printf '%s\n' '{"Package":"pkg","Test":"TestTwo","Action":"run"}'
+  printf '%s\n' '{"Package":"pkg","Test":"TestTwo","Action":"fail"}'
+  printf '%s\n' '{"Package":"pkg","Action":"fail"}'
+  false
+fi
+selected=
+for test_name in TestOne TestTwo; do
+  if printf '%s\n' "$test_name" | grep -E "$selector" >/dev/null; then
+    selected="$selected $test_name"
+  fi
+done
+if [ -z "$selected" ]; then false; fi
+for test_name in $selected; do
+  printf '%s\n' "$test_name" >> "$0.invoked"
+done
+printf '%s\n' '{"Package":"pkg","Action":"run"}'
+for test_name in $selected; do
+  printf '{"Package":"pkg","Test":"%s","Action":"run"}\n' "$test_name"
+  printf '{"Package":"pkg","Test":"%s","Action":"pass"}\n' "$test_name"
+done
+printf '%s\n' '{"Package":"pkg","Action":"pass"}'
+`
+	assert.NilError(t, ioutil.WriteFile(runner.Path(), []byte(script), 0755))
+	assert.NilError(t, os.Chmod(runner.Path(), 0755))
+	stdout := new(bytes.Buffer)
+	opts := &options{
+		rawCommand:                   true,
+		args:                         []string{runner.Path()},
+		format:                       "testname",
+		rerunFailsMaxAttempts:        1,
+		rerunFailsMaxInitialFailures: 2,
+		stdout:                       stdout,
+		stderr:                       new(bytes.Buffer),
+		noSummary:                    newNoSummaryValue(),
 	}
+	err := run(opts)
+	assert.NilError(t, err, stdout.String())
+	invoked, err := ioutil.ReadFile(runner.Path() + ".invoked")
