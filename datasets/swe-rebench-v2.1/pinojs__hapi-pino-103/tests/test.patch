+experiment('logging with invalid request', () => {
+  test('does not throw when an invalid request has ignored paths configured', async () => {
+    const server = getServer()
+    const stream = sink(() => {})
+    const logger = require('pino')(stream)
+
+    await server.register({
+      plugin: Pino,
+      options: {
+        instance: logger,
+        ignorePaths: ['/ignored'],
+        logRequestComplete: false
+      }
+    })
+
+    const response = await server.inject('invalid')
+    expect(response.statusCode).to.not.equal(500)
+  })
+})
