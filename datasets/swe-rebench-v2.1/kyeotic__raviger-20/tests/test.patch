index 0000000..27d10eb
--- /dev/null
+++ b/test/Link.spec.js
@@ -0,0 +1,124 @@
+import React from 'react'
+import { render, act, fireEvent } from '@testing-library/react'
+import { Link, ActiveLink, navigate, useRoutes } from '../src/main.js'
+
+// this is just a little hack to silence a warning that we'll get until we
+// upgrade to 16.9: https://github.com/facebook/react/pull/14853
+const originalError = console.error
+beforeAll(() => {
+  console.error = (...args) => {
+    if (/Warning.*not wrapped in act/.test(args[0])) {
+      return
+    }
+    originalError.call(console, ...args)
+  }
+})
+
+afterAll(() => {
+  act(() => navigate('/'))
+  console.error = originalError
+})
+
+describe('Link', () => {
+  test('renders', async () => {
+    const { getByTestId } = render(
+      <Link href="/foo" className="base" data-testid="link">
+        go to foo
+      </Link>
+    )
+
+    act(() => navigate('/'))
+    expect(getByTestId('link')).toHaveTextContent('go to foo')
+  })
+  test('does not add active styling at a matching path', async () => {
+    act(() => navigate('/foo'))
+    const { getByTestId } = render(
+      <Link href="/foo" className="base" data-testid="link">
+        go to foo
+      </Link>
+    )
+    expect(getByTestId('link').className).toBe('base')
+  })
+  test('navigates to href', async () => {
+    act(() => navigate('/'))
+    const { getByTestId } = render(
+      <Link href="/foo" className="base" data-testid="link">
+        go to foo
+      </Link>
+    )
+    act(() => void fireEvent.click(getByTestId('link')))
+    expect(document.location.pathname).toEqual('/foo')
+  })
+  test('prefixes href with the router basePath', async () => {
+    function Route() {
+      return (
+        <Link href="/foo" data-testid="link">
+          go to foo
+        </Link>
+      )
+    }
+    function Harness() {
+      return useRoutes({ '/foo': () => <Route /> }, { basePath: '/base' })
+    }
+    act(() => navigate('/base/foo'))
+    const { getByTestId } = render(<Harness />)
+    expect(getByTestId('link')).toHaveAttribute('href', '/base/foo')
+  })
+  test('preserves a passed onClick handler', async () => {
+    const onClick = jest.fn()
+    act(() => navigate('/'))
+    const { getByTestId } = render(
+      <Link href="/foo" onClick={onClick} data-testid="link">
+        go to foo
+      </Link>
+    )
+    act(() => void fireEvent.click(getByTestId('link')))
+    expect(onClick).toHaveBeenCalledTimes(1)
+  })
+  test('does not navigate when the click is default-prevented', async () => {
+    act(() => navigate('/'))
+    const { getByTestId } = render(
+      <Link href="/foo" onClick={e => e.preventDefault()} data-testid="link">
+        go to foo
+      </Link>
+    )
+    act(() => void fireEvent.click(getByTestId('link')))
+    expect(document.location.pathname).toEqual('/')
+  })
+  test('does not navigate on a non-left click', async () => {
+    act(() => navigate('/'))
+    const { getByTestId } = render(
+      <Link href="/foo" data-testid="link">
+        go to foo
+      </Link>
+    )
+    act(() => void fireEvent.click(getByTestId('link'), { button: 1 }))
+    expect(document.location.pathname).toEqual('/')
+  })
+})
+describe('ActiveLink', () => {
+  test('adds active class when active', async () => {
+    const { getByTestId } = render(
+      <ActiveLink
+        href="/foo"
+        className="base"
+        activeClass="extra"
+        exactActiveClass="double"
+        data-testid="link"
+      >
+        go to foo
+      </ActiveLink>
+    )
+
+    act(() => navigate('/'))
+    expect(getByTestId('link')).toHaveClass('base')
+
+    act(() => navigate('/foo'))
+    expect(getByTestId('link')).toHaveClass('extra')
+    expect(getByTestId('link')).toHaveClass('double')
+
+    act(() => navigate('/foo/bar'))
+    expect(getByTestId('link')).toHaveClass('extra')
+    expect(getByTestId('link')).not.toHaveClass('double')
+  })
+})
