index 00000000..56fc07de
--- /dev/null
+++ b/rest/rest-sqs/src/test/scala/org/elasticmq/rest/sqs/directives/QueueDirectivesWithContextPathTest.scala
@@ -0,0 +1,68 @@
+package org.elasticmq.rest.sqs.directives
+
+import akka.actor.{ActorRef, ActorSystem, Props}
+import akka.http.scaladsl.Http
+import akka.http.scaladsl.model.{FormData, HttpMethods, HttpRequest, StatusCodes}
+import akka.util.Timeout
+import org.elasticmq.actor.QueueManagerActor
+import org.elasticmq.actor.reply._
+import org.elasticmq.msg.CreateQueue
+import org.elasticmq.rest.sqs.{QueueManagerActorModule, SQSRestServerBuilder}
+import org.elasticmq.util.NowProvider
+import org.elasticmq.{MillisVisibilityTimeout, NodeAddress, QueueData, StrictSQSLimits}
+import org.joda.time.{DateTime, Duration}
+import org.scalatest.flatspec.AnyFlatSpec
+import org.scalatest.matchers.should.Matchers
+
+import scala.concurrent.duration._
+import scala.concurrent.{Await, ExecutionContextExecutor}
+
+class QueueDirectivesWithContextPathTest extends AnyFlatSpec with Matchers with QueueManagerActorModule {
+
+  private val maxDuration = 1.minute
+  implicit val timeout: Timeout = maxDuration
+  implicit lazy val actorSystem: ActorSystem = ActorSystem("lol")
+  implicit val ec: ExecutionContextExecutor = actorSystem.dispatcher
+  lazy val queueManagerActor: ActorRef =
+    actorSystem.actorOf(Props(new QueueManagerActor(new NowProvider(), StrictSQSLimits, None)))
+
+  "NodeAddress" should "use an empty context path when none is configured" in {
+    NodeAddress().contextPath shouldBe empty
+  }
+
+  "SendMessage" should "work when the server is configured with a non-empty context path" in {
+    val queueName = "context-path-queue"
+    Await.result(
+      queueManagerActor ? CreateQueue(
+        QueueData(queueName, MillisVisibilityTimeout(1L), Duration.ZERO, Duration.ZERO, DateTime.now(), DateTime.now())
+      ),
+      maxDuration
+    )
+
+    val server = SQSRestServerBuilder
+      .withPort(0)
+      .withServerAddress(NodeAddress(port = 0, contextPath = "/test-context"))
+      .withQueueManagerActor(queueManagerActor)
+      .start()
+
+    try {
+      val binding = Await.result(server.startFuture, maxDuration)
+      val port = binding.localAddress.getPort
+      val queueUrl = s"http://localhost:$port/test-context/000000000000/$queueName"
+
+      val request = HttpRequest(
+        method = HttpMethods.POST,
+        uri = s"http://localhost:$port/",
+        entity = FormData("Action" -> "SendMessage", "QueueUrl" -> queueUrl, "MessageBody" -> "hello").toEntity
+      )
+
+      val response = Await.result(Http().singleRequest(request), maxDuration)
+      response.status shouldEqual StatusCodes.OK
+      val body = Await.result(response.entity.toStrict(maxDuration).map(_.data.utf8String), maxDuration)
+      body should include("SendMessageResponse")
+      body should include("MessageId")
+    } finally {
+      server.stopAndWait()
+    }
+  }
+}
