diff --git a/test/flint/gfp-test.jl b/test/flint/gfp-test.jl
index bf96f064..d2133b82 100644
--- a/test/flint/gfp-test.jl
+++ b/test/flint/gfp-test.jl
@@ -112,6 +112,18 @@ end
 
   @test deepcopy(R(3)) == R(3)
 
+  @test coeff(R(2), 0) == 2
+
+  # Hecke's `absolute_coordinates` (the motivating use case) is not available
+  # in Nemo's test environment, so reproduce the generic code path it uses:
+  # querying the coefficients of a field element through the public `coeff`
+  # interface.
+  function absolute_coordinates(x)
+    return [coeff(x, i) for i in 0:(degree(parent(x)) - 1)]
+  end
+
+  @test absolute_coordinates(R(2)) == [2]
+
   R1 = Native.GF(13)
 
   @test R === R1
