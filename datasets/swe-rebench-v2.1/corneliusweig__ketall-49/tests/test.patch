+func listDeploymentsWithExclusions(t *testing.T, exclusions []string) string {
+	t.Helper()
+	server := newDeploymentServer(t)
+	defer server.Close()
+
+	originalExclusions := viper.Get(constants.FlagExclude)
+	originalCache := viper.Get(constants.FlagUseCache)
+	viper.Set(constants.FlagExclude, exclusions)
+	viper.Set(constants.FlagUseCache, false)
+	defer func() {
+		viper.Set(constants.FlagExclude, originalExclusions)
+		viper.Set(constants.FlagUseCache, originalCache)
+	}()
+
+	flags := genericclioptions.NewConfigFlags(true)
+	flags.APIServer = &server.URL
+	insecure := true
+	flags.Insecure = &insecure
+	resources, err := GetAllServerResources(flags)
+	assert.NoError(t, err)
+	encoded, marshalErr := json.Marshal(resources)
+	assert.NoError(t, marshalErr)
+	return string(encoded)
+}
