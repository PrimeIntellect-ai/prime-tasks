+func TestIPIPAddr(t *testing.T) {
+	tests := []struct {
+		name string
+		ip   IP
+		want *net.IPAddr
+	}{
+		{
+			name: "v4Addr",
+			ip:   mustIP("192.0.2.1"),
+			want: &net.IPAddr{IP: net.IPv4(192, 0, 2, 1).To4()},
+		},
+		{
+			name: "v6Addr",
+			ip:   mustIP("2001:db8::1"),
+			want: &net.IPAddr{IP: net.ParseIP("2001:db8::1")},
+		},
+		{
+			name: "v6AddrZone",
+			ip:   mustIP("fe80::1%eth0"),
+			want: &net.IPAddr{IP: net.ParseIP("fe80::1"), Zone: "eth0"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := tt.ip.IPAddr()
+			if got == nil {
+				t.Fatal("IPAddr returned nil")
+			}
+			if !got.IP.Equal(tt.want.IP) {
+				t.Errorf("IPAddr IP = %v; want address %v", got.IP, tt.want.IP)
+			}
+			if got.Zone != tt.want.Zone {
+				t.Errorf("IPAddr zone = %q; want %q", got.Zone, tt.want.Zone)
+			}
+		})
+	}
+}
+
+func mustIP(s string) IP {
+	ip, err := ParseIP(s)
+	if err != nil {
+		panic(err)
+	}
+
+	return ip
+}
