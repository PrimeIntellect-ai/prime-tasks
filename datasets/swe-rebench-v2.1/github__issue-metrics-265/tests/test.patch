+""" Unit tests for the markdown_helpers module. """
+
+import glob
+import os
+import unittest
+from datetime import timedelta
+from unittest.mock import MagicMock, patch
+
+import github3.issues
+
+# The installed github3 release exposes ``github3.issues.event`` as a module,
+# while the action annotates it as a type. Normalise it so the action module can
+# be imported for the end-to-end report handling test.
+try:
+    import github3.issues.event  # noqa: F401
+except ImportError:
+    pass
+
+_event = getattr(github3.issues, "event", None)
+if _event is not None and not isinstance(_event, type):
+    github3.issues.event = _event.IssueEvent
+
+from classes import IssueWithMetrics
+from issue_metrics import main
+
+
+def _make_env_vars():
+    """Build an environment configuration suitable for running the action."""
+    env_vars = MagicMock()
+    env_vars.search_query = "repo:owner/repo"
+    env_vars.gh_token = "token"
+    env_vars.ignore_users = []
+    env_vars.gh_app_id = None
+    env_vars.gh_app_installation_id = None
+    env_vars.gh_app_private_key_bytes = None
+    env_vars.ghe = ""
+    env_vars.enable_mentor_count = False
+    env_vars.min_mentor_comments = "0"
+    env_vars.max_comments_eval = "0"
+    env_vars.heavily_involved_cutoff = "0"
+    env_vars.labels_to_measure = []
+    env_vars.hide_author = False
+    env_vars.hide_time_to_first_response = False
+    env_vars.hide_time_to_close = False
+    env_vars.hide_time_to_answer = False
+    env_vars.hide_label_metrics = False
+    return env_vars
+
+
+class TestMarkdownHelpers(unittest.TestCase):
+    """
+    Unit tests for the markdown_helpers module.
+    """
+
+    def tearDown(self):
+        """Remove any markdown files produced by the tests."""
+        for path in glob.glob("temp*.md") + glob.glob("issue_metrics*.md"):
+            if os.path.exists(path):
+                os.remove(path)
+
+    def test_markdown_too_large_for_issue_body(self):
+        """
+        Test the markdown_too_large_for_issue_body function.
+        """
+        from markdown_helpers import markdown_too_large_for_issue_body
+
+        max_char_count = 65535
+
+        # A file whose contents exceed the limit is reported as too large.
+        with open("temp.md", "w", encoding="utf-8") as f:
+            f.write("a" * (max_char_count + 1))
+        try:
+            self.assertTrue(
+                markdown_too_large_for_issue_body("temp.md", max_char_count)
+            )
+        finally:
+            os.remove("temp.md")
+
+        # A file whose contents fit within the limit is not too large.
+        with open("temp.md", "w", encoding="utf-8") as f:
+            f.write("a" * max_char_count)
+        try:
+            self.assertFalse(
+                markdown_too_large_for_issue_body("temp.md", max_char_count)
+            )
+        finally:
+            os.remove("temp.md")
+
+    def test_split_markdown_file(self):
+        """
+        Test the split_markdown_file function.
+        """
+
+        from markdown_helpers import split_markdown_file
+
+        # Define a sample markdown file content with 4 times the maximum character count
+        multiple_of_max = 4
+        max_char_count = 65535
+        repeated_content = "a\n"
+        markdown_content = repeated_content * int(
+            (max_char_count * multiple_of_max) / len(repeated_content)
+        )
+
+        # Write the markdown content to a temporary file
+        with open("temp.md", "w", encoding="utf-8") as f:
+            f.write(markdown_content)
+
+        try:
+            # Call the function with the temporary file
+            split_markdown_file("temp.md", max_char_count)
+
+            # Assert that the function creates the expected split files
+            self.assertTrue(os.path.exists("temp_0.md"))
+            self.assertTrue(os.path.exists("temp_1.md"))
+            self.assertTrue(os.path.exists("temp_2.md"))
+            self.assertTrue(os.path.exists("temp_3.md"))
+
+            # Assert that the all files have less than max characters
+            for i in range(0, multiple_of_max):
+                with open(f"temp_{i}.md", "r", encoding="utf-8") as f:
+                    self.assertLessEqual(len(f.read()), max_char_count)
+
+            # Assert that the split files together contain the original content
+            split_files = sorted(
+                glob.glob("temp_*.md"),
+                key=lambda path: int(path[len("temp_") : -len(".md")]),
+            )
+            combined = ""
+            for path in split_files:
+                with open(path, "r", encoding="utf-8") as f:
+                    combined += f.read()
+            self.assertEqual(combined, markdown_content)
+        finally:
+            for path in glob.glob("temp*.md"):
+                if os.path.exists(path):
+                    os.remove(path)
+
+    def test_main_handles_oversized_report(self):
+        """
+        Test that the action does not leave an oversized report for issue creation.
+        """
+        max_char_count = 65536
+        issues = [
+            IssueWithMetrics(
+                title="x" * 400,
+                html_url=f"https://github.com/owner/repo/issues/{i}",
+                author="user",
+                time_to_first_response=timedelta(days=1),
+            )
+            for i in range(200)
+        ]
+        env_vars = _make_env_vars()
+
+        with patch("issue_metrics.get_env_vars", return_value=env_vars), patch(
+            "markdown_writer.get_env_vars", return_value=env_vars
+        ), patch("issue_metrics.auth_to_github", return_value=MagicMock()), patch(
+            "issue_metrics.search_issues", return_value=[MagicMock()]
+        ), patch(
+            "issue_metrics.get_per_issue_metrics", return_value=(issues, 0, 0)
+        ), patch(
+            "issue_metrics.write_to_json"
+        ):
+            main()
+
+        with open("issue_metrics.md", "r", encoding="utf-8") as f:
+            report = f.read()
+
+        # The report must still contain content and must fit within the limit.
+        self.assertGreater(len(report), 0)
+        self.assertLessEqual(len(report), max_char_count)
+
+
+if __name__ == "__main__":
+    unittest.main()
