+    def test_unitary_synthesis_plugins_valid_method(self):
+        """Test unitary synthesis plugins with a valid method returns a pass manager."""
+        backend = QasmSimulatorPy()
+        pm = generate_preset_pass_manager(
+            optimization_level=1,
+            backend=backend,
+            unitary_synthesis_method="default",
+        )
+        self.assertIsInstance(pm, PassManager)
+        qc = QuantumCircuit(3)
+        qc.h(0)
+        qc.ccx(0, 1, 2)
+        qc.measure_all()
+        transpiled = pm.run(qc)
+        self.assertIsInstance(transpiled, QuantumCircuit)
+        basis_gates = set(backend.configuration().basis_gates)
+        for instruction in transpiled.data:
+            if instruction.operation.name in {"barrier", "measure"}:
+                continue
+            self.assertIn(instruction.operation.name, basis_gates)
