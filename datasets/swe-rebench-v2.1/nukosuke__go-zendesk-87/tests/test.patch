 )
 
@@ -15,3 +17,71 @@ func TestCreateBrand(t *testing.T) {
 		t.Fatalf("Failed to send request to create brand: %s", err)
 	}
 }
+
+func TestGetBrand(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet {
+			t.Errorf("request method = %q, want %q", r.Method, http.MethodGet)
+		}
+		if r.URL.Path != "/brands/123.json" {
+			t.Errorf("request path = %q, want %q", r.URL.Path, "/brands/123.json")
+		}
+		_, _ = w.Write([]byte(`{"brand":{"id":123,"name":"Read brand"}}`))
+	}))
+	defer server.Close()
+
+	brand, err := newTestClient(server).GetBrand(123)
+	if err != nil {
+		t.Fatalf("Failed to get brand: %s", err)
+	}
+	if brand.ID != 123 || brand.Name != "Read brand" {
+		t.Fatalf("Returned brand = %+v, want ID 123 and name %q", brand, "Read brand")
+	}
+}
+
+func TestUpdateBrand(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPut {
+			t.Errorf("request method = %q, want %q", r.Method, http.MethodPut)
+		}
+		if r.URL.Path != "/brands/1234.json" {
+			t.Errorf("request path = %q, want %q", r.URL.Path, "/brands/1234.json")
+		}
+		var body struct {
+			Brand Brand `json:"brand"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Errorf("could not decode update request: %s", err)
+		} else if body.Brand.Name != "Updated brand" || body.Brand.Subdomain != "updated" || body.Brand.SignatureTemplate != "Regards" {
+			t.Errorf("update body brand = %+v, want supplied brand fields", body.Brand)
+		}
+		_, _ = w.Write([]byte(`{"brand":{"id":1234,"name":"Updated brand","subdomain":"updated","signature_template":"Regards"}}`))
+	}))
+	defer server.Close()
+
+	input := Brand{Name: "Updated brand", Subdomain: "updated", SignatureTemplate: "Regards"}
+	brand, err := newTestClient(server).UpdateBrand(1234, input)
+	if err != nil {
+		t.Fatalf("Failed to update brand: %s", err)
+	}
+	if brand.ID != 1234 || brand.Name != input.Name {
+		t.Fatalf("Returned brand = %+v, want ID 1234 and name %q", brand, input.Name)
+	}
+}
+
+func TestDeleteBrand(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodDelete {
+			t.Errorf("request method = %q, want %q", r.Method, http.MethodDelete)
+		}
+		if r.URL.Path != "/brands/1234.json" {
+			t.Errorf("request path = %q, want %q", r.URL.Path, "/brands/1234.json")
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+
+	if err := newTestClient(server).DeleteBrand(1234); err != nil {
+		t.Fatalf("Failed to delete brand: %s", err)
+	}
+}
