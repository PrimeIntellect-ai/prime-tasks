@@ -852,6 +852,38 @@ class TestDiscretise(unittest.TestCase):
         with self.assertRaisesRegex(pybamm.ModelError, "Boundary conditions"):
             disc.check_tab_conditions(b, bcs)
 
+    def test_process_with_no_check(self):
+        whole_cell = ["negative electrode", "separator", "positive electrode"]
+
+        # a model whose variables are inconsistent with its rhs should fail the
+        # model checks, but be discretised without error when they are skipped
+        def make_bad_model():
+            c = pybamm.Variable("c", domain=whole_cell)
+            N = pybamm.grad(c)
+            bad_model = pybamm.BaseModel()
+            bad_model.rhs = {c: pybamm.div(N)}
+            bad_model.initial_conditions = {c: pybamm.Scalar(3)}
+            bad_model.boundary_conditions = {
+                c: {"left": (0, "Neumann"), "right": (0, "Neumann")}
+            }
+            # variable "c" has the wrong shape, so check_variables should raise
+            bad_model.variables = {"c": pybamm.Vector(np.ones(3)), "N": N}
+            return bad_model
+
+        # checks are enabled by default, so the inconsistent model is rejected
+        disc = get_discretisation_for_testing()
+        with self.assertRaises(pybamm.ModelError):
+            disc.process_model(make_bad_model())
+
+        # checks can also be explicitly enabled
+        disc = get_discretisation_for_testing()
+        with self.assertRaises(pybamm.ModelError):
+            disc.process_model(make_bad_model(), check_model=True)
+
+        # with checks disabled the same model is discretised without error
+        disc = get_discretisation_for_testing()
+        disc.process_model(make_bad_model(), check_model=False)
+
 
 if __name__ == "__main__":
     print("Add -v for more debug output")
