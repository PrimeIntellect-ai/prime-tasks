+def test_cli_does_not_try_to_read_missing_flake8_after_parse_error(
+    tmp_path, monkeypatch,
+):
+    from flake8.main import cli
+
+    # These malformed candidates partially parse as Flake8 configurations.
+    malformed = "[flake8]\nx = 1\n..."
+    tmp_path.joinpath("setup.cfg").write_text(malformed)
+    tmp_path.joinpath("tox.ini").write_text(malformed)
+    # The GitHub Actions workflow expects no configuration at this path.
+    monkeypatch.chdir(tmp_path)
+
+    assert cli.main([]) == 0
