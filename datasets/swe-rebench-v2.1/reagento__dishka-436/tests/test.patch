diff --git a/tests/unit/container/override/test_provide.py b/tests/unit/container/override/test_provide.py
index 156f6a2..cc3ff89 100644
--- a/tests/unit/container/override/test_provide.py
+++ b/tests/unit/container/override/test_provide.py
@@ -77,3 +77,44 @@ def test_skip_cant_override() -> None:
         TestProvider(),
         validation_settings=ValidationSettings(nothing_overridden=False),
     )
+
+
+def test_override_different_scope() -> None:
+    real_provider = Provider(Scope.REQUEST)
+    real_provider.provide(lambda: 1, provides=int)
+
+    fake_provider = Provider(Scope.APP)
+    fake_provider.provide(lambda: 2, provides=int)
+
+    container = make_container(real_provider, fake_provider)
+    with container() as request_container:
+        assert request_container.get(int) == 2
+
+
+def test_later_app_provider_is_injected_into_request_consumer() -> None:
+    class RealProvider(Provider):
+        @provide(scope=Scope.REQUEST)
+        def get_int(self) -> int:
+            return 1
+
+    class FakeProvider(Provider):
+        @provide(scope=Scope.APP)
+        def get_int(self) -> int:
+            return 42
+
+    class Interactor:
+        def __init__(self, dep: int) -> None:
+            self.dep = dep
+
+        def __call__(self) -> int:
+            return self.dep
+
+    class ServiceProvider(Provider):
+        get_interactor = provide(Interactor, scope=Scope.REQUEST)
+
+    container = make_container(
+        RealProvider(), ServiceProvider(), FakeProvider(),
+    )
+    with container() as request_container:
+        service = request_container.get(Interactor)
+        assert service() == 42
