+class TestKeepFailed(unittest.TestCase):
+    def test_delete_stacks_keep_failed_across_regions(self):
+        template = make_test_template()
+        stacks = []
+        clients = {}
+        outcomes = {
+            "us-west-2": ("successful-west", "CREATE_COMPLETE"),
+            "us-east-1": ("failed-east", "CREATE_FAILED"),
+            "eu-west-1": ("successful-eu", "CREATE_COMPLETE"),
+            "ap-southeast-1": ("failed-ap", "CREATE_FAILED"),
+        }
+
+        for region_name, (stack_name, outcome) in outcomes.items():
+            region = make_test_region_obj(region_name)
+            client = mock.Mock()
+            client.describe_stacks.return_value = {
+                "Stacks": [{"StackStatus": "DELETE_COMPLETE"}]
+            }
+            region._boto3_cache.client.return_value = client
+            clients[region_name] = client
+            stack_id = (
+                f"arn:aws:cloudformation:{region_name}:123456789012:stack/"
+                f"{stack_name}/test-id"
+            )
+            stack = Stack(region, stack_id, template, stack_name)
+            stack._timer.cancel()
+            stack.status = outcome
+            stacks.append(stack)
+
+        cfn_test = CFNTest(config=mock.Mock(), keep_failed=True)
+        cfn_test.test_definition = Stacker(project_name="test", tests={})
+        cfn_test.test_definition.stacks = Stacks(stacks)
+        cfn_test.config.get_buckets.return_value = {}
+
+        # Cleanup may report failed deployments after handling successful stacks.
+        try:
+            cfn_test.clean_up()
+        except TaskCatException:
+            pass
+
+        for region_name, (stack_name, outcome) in outcomes.items():
+            delete_requests = clients[region_name].delete_stack.call_args_list
+            if outcome == "CREATE_COMPLETE":
+                requested = [request[1]["StackName"] for request in delete_requests]
+                stack = next(s for s in stacks if s.name == stack_name)
+                self.assertTrue(
+                    any(ref in requested for ref in (stack.id, stack.name)),
+                    f"successful stack {stack_name} was not deleted",
+                )
+            else:
+                self.assertEqual(delete_requests, [])
+
