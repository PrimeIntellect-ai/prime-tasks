diff --git a/internal/provisioners/templateprov/template_test.go b/internal/provisioners/templateprov/template_test.go
index 546a6dc..94af534 100644
--- a/internal/provisioners/templateprov/template_test.go
+++ b/internal/provisioners/templateprov/template_test.go
@@ -16,6 +16,10 @@ package templateprov
 
 import (
 	"context"
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
 	"testing"
 
 	compose "github.com/compose-spec/compose-go/v2/types"
@@ -33,6 +37,7 @@ func TestProvision(t *testing.T) {
 	p, err := Parse(map[string]interface{}{
 		"uri":              "template://example",
 		"type":             resUid.Type(),
+		"description":      "desc",
 		"expected_outputs": []string{"b", "c"},
 		"supported_params": []string{"ptest"},
 		"init": `
@@ -102,3 +107,115 @@ some-svc:
 	assert.Equal(t, "(any)", p.Class())
 	assert.Equal(t, resUid.Type(), p.Type())
 }
+
+// buildCLI compiles the score-compose command so that the provisioners list command can be run black-box.
+func buildCLI(t *testing.T) string {
+	t.Helper()
+	repoRoot, err := filepath.Abs(filepath.Join("..", "..", ".."))
+	require.NoError(t, err)
+	cli := filepath.Join(t.TempDir(), "score-compose")
+	build := exec.Command("go", "build", "-o", cli, "./cmd/score-compose")
+	build.Dir = repoRoot
+	output, err := build.CombinedOutput()
+	require.NoError(t, err, string(output))
+	return cli
+}
+
+func runCLI(t *testing.T, cli, dir string, args ...string) string {
+	t.Helper()
+	cmd := exec.Command(cli, args...)
+	cmd.Dir = dir
+	out, err := cmd.CombinedOutput()
+	require.NoError(t, err, string(out))
+	return string(out)
+}
+
+func listProvisionerRows(t *testing.T, cli, dir string) []map[string]interface{} {
+	t.Helper()
+	var rows []map[string]interface{}
+	require.NoError(t, json.Unmarshal([]byte(runCLI(t, cli, dir, "provisioners", "list", "--format", "json")), &rows))
+	return rows
+}
+
+func findProvisionerRow(rows []map[string]interface{}, typ string) map[string]interface{} {
+	for _, row := range rows {
+		if row["Type"] == typ {
+			return row
+		}
+	}
+	return nil
+}
+
+// TestParseWithoutDescription checks that a template provisioner without a description is still accepted.
+func TestParseWithoutDescription(t *testing.T) {
+	p, err := Parse(map[string]interface{}{
+		"uri":  "template://example-no-description",
+		"type": "example-no-description",
+	})
+	require.NoError(t, err)
+	assert.Equal(t, "example-no-description", p.Type())
+}
+
+// TestDefaultProvisionersHaveDescriptions checks, through the list command, that every default provisioner
+// carries a non-empty description.
+func TestDefaultProvisionersHaveDescriptions(t *testing.T) {
+	cli := buildCLI(t)
+	workDir := t.TempDir()
+	runCLI(t, cli, workDir, "init")
+
+	rows := listProvisionerRows(t, cli, workDir)
+	require.NotEmpty(t, rows)
+	for _, row := range rows {
+		assert.NotEmpty(t, row["Description"], "default provisioner %v is missing a description", row["Type"])
+	}
+}
+
+// TestProvisionersListShowsDescriptions checks that descriptions of both template and command provisioners are
+// accepted from provisioner files and displayed by the list command in both formats.
+func TestProvisionersListShowsDescriptions(t *testing.T) {
+	cli := buildCLI(t)
+	workDir := t.TempDir()
+	runCLI(t, cli, workDir, "init")
+	custom := `- uri: template://description-check
+  type: description-check
+  description: a visible template description
+- uri: cmd://sh
+  type: cmd-description-check
+  description: a visible command description
+`
+	require.NoError(t, os.WriteFile(filepath.Join(workDir, ".score-compose", "custom.provisioners.yaml"), []byte(custom), 0644))
+
+	table := runCLI(t, cli, workDir, "provisioners", "list")
+	assert.Contains(t, table, "DESCRIPTION")
+	assert.Contains(t, table, "a visible template description")
+	assert.Contains(t, table, "a visible command description")
+
+	rows := listProvisionerRows(t, cli, workDir)
+	templateRow := findProvisionerRow(rows, "description-check")
+	require.NotNil(t, templateRow, "the listed provisioners should include the template entry")
+	assert.Equal(t, "a visible template description", templateRow["Description"])
+	cmdRow := findProvisionerRow(rows, "cmd-description-check")
+	require.NotNil(t, cmdRow, "the listed provisioners should include the command entry")
+	assert.Equal(t, "a visible command description", cmdRow["Description"])
+}
+
+// TestProvisionersWithoutDescriptionRemainValid checks that custom provisioner files may omit the description
+// for both template and command provisioners.
+func TestProvisionersWithoutDescriptionRemainValid(t *testing.T) {
+	cli := buildCLI(t)
+	workDir := t.TempDir()
+	runCLI(t, cli, workDir, "init")
+	custom := `- uri: template://no-description-check
+  type: no-description-check
+- uri: cmd://sh
+  type: cmd-no-description-check
+`
+	require.NoError(t, os.WriteFile(filepath.Join(workDir, ".score-compose", "custom.provisioners.yaml"), []byte(custom), 0644))
+
+	rows := listProvisionerRows(t, cli, workDir)
+	for _, typ := range []string{"no-description-check", "cmd-no-description-check"} {
+		row := findProvisionerRow(rows, typ)
+		require.NotNil(t, row, "the listed provisioners should include %s", typ)
+		assert.Empty(t, row["Description"])
+	}
+}
