+    def test_from_timestamp(self):
+        # Correct offset: UTC+2, should return datetime + tzoffset(+2)
+        altz = utctz_to_altz('+0200')
+        self.assertEqual(datetime.fromtimestamp(1522827734, tzoffset(altz)), from_timestamp(1522827734, altz))
+
+        # Unusable offsets must not prevent conversion to a datetime, and the
+        # result must preserve the timestamp in UTC.
+        timestamp = 1522827734
+        utc_datetime = datetime.fromtimestamp(timestamp, tzoffset(0))
+
+        altz = utctz_to_altz('+5800')
+        converted = from_timestamp(timestamp, altz)
+        self.assertIsInstance(converted, datetime)
+        self.assertEqual(utc_datetime, converted)
+
+        altz = utctz_to_altz('-9000')
+        converted = from_timestamp(timestamp, altz)
+        self.assertIsInstance(converted, datetime)
+        self.assertEqual(utc_datetime, converted)
