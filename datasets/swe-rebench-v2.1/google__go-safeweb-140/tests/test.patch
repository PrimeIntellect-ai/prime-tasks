+func TestStatusBasedErrorResponse(t *testing.T) {
+	for _, code := range []safehttp.StatusCode{safehttp.StatusBadRequest, safehttp.StatusInternalServerError} {
+		t.Run(http.StatusText(int(code)), func(t *testing.T) {
+			rr := newResponseRecorder(&strings.Builder{})
+			w := safehttp.NewResponseWriter(testDispatcher{}, rr, nil)
+			writeHTTPError(w, code)
+			if rr.status != code {
+				t.Errorf("response status = %d, want %d", rr.status, code)
+			}
+		})
+	}
+}
+
+// writeHTTPError locates the public status-based response operation by its
+// behavior rather than requiring a particular exported method name. The same
+// operation must handle both a client and a server error status.
+func writeHTTPError(w *safehttp.ResponseWriter, code safehttp.StatusCode) safehttp.Result {
+	typeOfWriter := reflect.TypeOf(w)
+	for i := 0; i < typeOfWriter.NumMethod(); i++ {
+		method := typeOfWriter.Method(i)
+		methodType := method.Type
+		if methodType.NumOut() != 1 || methodType.Out(0) != reflect.TypeOf(safehttp.Result{}) {
+			continue
+		}
+		statusArgument := -1
+		for j := 1; j < methodType.NumIn(); j++ {
+			if methodType.In(j) == reflect.TypeOf(safehttp.StatusCode(0)) {
+				statusArgument = j
+				break
+			}
+		}
+		if statusArgument < 0 {
+			continue
+		}
+		if !errorMethodWritesStatus(method, statusArgument, safehttp.StatusBadRequest) ||
+			!errorMethodWritesStatus(method, statusArgument, safehttp.StatusInternalServerError) {
+			continue
+		}
+
+		arguments := make([]reflect.Value, methodType.NumIn())
+		arguments[0] = reflect.ValueOf(w)
+		for j := 1; j < len(arguments); j++ {
+			arguments[j] = reflect.Zero(methodType.In(j))
+		}
+		arguments[statusArgument] = reflect.ValueOf(code)
+		return method.Func.Call(arguments)[0].Interface().(safehttp.Result)
+	}
+	panic("no single response operation handles both client and server error statuses")
+}
+
+func errorMethodWritesStatus(method reflect.Method, statusArgument int, code safehttp.StatusCode) (ok bool) {
+	defer func() {
+		if recover() != nil {
+			ok = false
+		}
+	}()
+	rr := newResponseRecorder(&strings.Builder{})
+	w := safehttp.NewResponseWriter(testDispatcher{}, rr, nil)
+	arguments := make([]reflect.Value, method.Type.NumIn())
+	arguments[0] = reflect.ValueOf(w)
+	for j := 1; j < len(arguments); j++ {
+		arguments[j] = reflect.Zero(method.Type.In(j))
+	}
+	arguments[statusArgument] = reflect.ValueOf(code)
+	method.Func.Call(arguments)
+	return rr.status == code
+}
