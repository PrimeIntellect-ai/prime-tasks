+func TestProfilesService_EnableGiftCardIssuer_SupportedIssuers(t *testing.T) {
+	setEnv()
+	setup()
+	defer func() {
+		teardown()
+		unsetEnv()
+	}()
+
+	id := "pfl_v9hTwCvYqw"
+
+	issuers := []struct {
+		name   string
+		issuer GiftCardIssuer
+		want   string
+	}{
+		{"good4fun", Good4fun, "good4fun"},
+		{"decadeaukaart", DecaudeuKaart, "decadeaukaart"},
+		{"restaurantcadeau", Restaurantcadeau, "restaurantcadeau"},
+		{"dinercadeau", Dinercadeau, "dinercadeau"},
+	}
+
+	for _, tt := range issuers {
+		t.Run(tt.name, func(t *testing.T) {
+			if string(tt.issuer) != tt.want {
+				t.Errorf("unexpected issuer value: want %q, got %q", tt.want, string(tt.issuer))
+			}
+
+			var requested bool
+			tMux.HandleFunc(
+				fmt.Sprintf("/v2/profiles/%s/methods/giftcard/issuers/%s", id, tt.want),
+				func(rw http.ResponseWriter, r *http.Request) {
+					requested = true
+					testMethod(t, r, "POST")
+					rw.WriteHeader(http.StatusOK)
+					_, _ = rw.Write([]byte(testdata.EnableGiftCardIssuerResponse))
+				},
+			)
+
+			if _, err := tClient.Profiles.EnableGiftCardIssuer(id, tt.issuer); err != nil {
+				t.Error(err)
+			}
+
+			if !requested {
+				t.Errorf("expected POST to /v2/profiles/%s/methods/giftcard/issuers/%s", id, tt.want)
+			}
+		})
+	}
+}
