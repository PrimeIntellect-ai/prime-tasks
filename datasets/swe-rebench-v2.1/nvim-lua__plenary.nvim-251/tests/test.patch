diff --git a/tests/plenary/path_spec.lua b/tests/plenary/path_spec.lua
index a4da214..aa1d089 100644
--- a/tests/plenary/path_spec.lua
+++ b/tests/plenary/path_spec.lua
@@ -185,6 +185,25 @@ describe("Path", function()
       local final = Path:new(orig):normalize()
       assert.are.same(final, "/lua/plenary/path.lua")
     end)
+
+    -- Returns the normalized result with any leading "./" removed, so that
+    -- "./a/b" and "a/b" compare equal (both refer to the same relative file).
+    local function strip_dot_slash(p)
+      return (p:gsub("^%./", ""))
+    end
+
+    it("can normalize relative paths", function()
+      local result = Path:new("lua/plenary/path.lua"):normalize()
+      assert.are.same(string.sub(result, 1, 1) ~= "/", true)
+      assert.are.same("lua/plenary/path.lua", strip_dot_slash(result))
+    end)
+
+    it("does not make a relative filename containing ellipsis absolute", function()
+      local filename = "pages/api/user/[...ids].ts"
+      local result = Path:new(filename):normalize()
+      assert.are.same(string.sub(result, 1, 1) ~= "/", true)
+      assert.are.same(filename, strip_dot_slash(result))
+    end)
   end)
 
   describe(":shorten", function()
