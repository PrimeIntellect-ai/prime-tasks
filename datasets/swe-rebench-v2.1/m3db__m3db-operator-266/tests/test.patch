+func TestGenerateStatefulSetPodAntiAffinityOptIn(t *testing.T) {
+	cluster := getFixture("testM3DBCluster.yaml", t)
+	require.NotEmpty(t, cluster.Spec.IsolationGroups)
+	group := &cluster.Spec.IsolationGroups[0]
+
+	// A cluster that has not opted in must not acquire pod anti-affinity.
+	ss, err := GenerateStatefulSet(cluster, group.Name, group.NumInstances)
+	require.NoError(t, err)
+	if ss.Spec.Template.Spec.Affinity != nil {
+		assert.Nil(t, ss.Spec.Template.Spec.Affinity.PodAntiAffinity)
+	}
+
+	_, hasOptInField := reflect.TypeOf(*group).FieldByName("UsePodAntiAffinity")
+	assert.True(t, hasOptInField, "isolation-group configuration must expose UsePodAntiAffinity")
+	configuration := []byte(`{"usePodAntiAffinity":true,"podAffinityToplogyKey":"topology.kubernetes.io/zone"}`)
+	require.NoError(t, json.Unmarshal(configuration, group))
+	ss, err = GenerateStatefulSet(cluster, group.Name, group.NumInstances)
+	require.NoError(t, err)
+	require.NotNil(t, ss.Spec.Template.Spec.Affinity)
+	antiAffinity := ss.Spec.Template.Spec.Affinity.PodAntiAffinity
+	require.NotNil(t, antiAffinity)
+	terms := antiAffinity.RequiredDuringSchedulingIgnoredDuringExecution
+	require.NotEmpty(t, terms)
+
+	// Required anti-affinity over the configured domain must select M3DB node
+	// pods, without constraining the exact selector serialization or term count.
+	matched := false
+	for _, term := range terms {
+		selector, selectorErr := metav1.LabelSelectorAsSelector(term.LabelSelector)
+		require.NoError(t, selectorErr)
+		if term.TopologyKey != "topology.kubernetes.io/zone" ||
+			!selector.Matches(k8slabels.Set{labels.Component: labels.ComponentM3DBNode}) {
+			continue
+		}
+		matched = true
 	}
+	assert.True(t, matched, "required anti-affinity should select M3DB node pods in the configured failure domain")
 }
