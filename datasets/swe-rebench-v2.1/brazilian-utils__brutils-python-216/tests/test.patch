@@ -0,0 +1,30 @@
+from os import pardir
+from os.path import abspath, join, dirname
+from sys import path, version_info, dont_write_bytecode
+from inspect import getsourcefile
+
+
+dont_write_bytecode = True
+range = range if version_info.major >= 3 else xrange
+path.insert(
+    1, abspath(join(dirname(abspath(getsourcefile(lambda: 0))), pardir))
+)
+from brutils import is_valid_pis
+from unittest import TestCase, main
+
+
+class TestPIS(TestCase):
+    def test_is_valid_pis(self):
+        self.assertIs(is_valid_pis("12062828707"), True)
+        self.assertIs(is_valid_pis("12066181422"), True)
+        self.assertIs(is_valid_pis("12066181427"), False)
+        self.assertIs(is_valid_pis("1206282"), False)
+
+    def test_valid_checksum_does_not_require_issuance(self):
+        # This number satisfies the PIS checksum rules; validity does not
+        # depend on whether the number appears in an issuance registry.
+        self.assertIs(is_valid_pis("58392017468"), True)
+
+
+if __name__ == "__main__":
+    main()
