+#[test]
+fn custom_resolver_trait() {
+    use std::io::Read;
+    use std::net::{SocketAddr, TcpListener};
+    use std::sync::mpsc;
+
+    struct LocalResolver(SocketAddr);
+
+    impl Resolver for LocalResolver {
+        fn resolve(&self, _netloc: &str) -> std::io::Result<Vec<SocketAddr>> {
+            Ok(vec![self.0])
+        }
+    }
+
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let local_addr = listener.local_addr().unwrap();
+
+    let (tx, rx) = mpsc::channel();
+    std::thread::spawn(move || {
+        let (mut client, _) = listener.accept().unwrap();
+        let mut buf = vec![0u8; 16];
+        let read = client.read(&mut buf).unwrap();
+        buf.truncate(read);
+        tx.send(buf).unwrap();
+    });
+
+    let mut agent = crate::agent();
+    agent.set_resolver(LocalResolver(local_addr));
+
+    // The agent holding the custom resolver must be usable from another
+    // thread, which requires the resolver to be Send + Sync + 'static.
+    let handle = std::thread::spawn(move || {
+        agent.get("http://cool.server/").call();
+    });
+    handle.join().unwrap();
+
+    let received = rx
+        .recv_timeout(Duration::from_secs(5))
+        .expect("resolver did not direct the request to the local server");
+    assert_eq!(&received, b"GET / HTTP/1.1\r\n");
+}
