+#[test]
+fn custom_resolver_receives_netloc() {
+    use std::io::Read;
+    use std::net::TcpListener;
+    use std::sync::{mpsc, Arc, Mutex};
+
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let local_addr = listener.local_addr().unwrap();
+
+    let (tx, rx) = mpsc::channel();
+    std::thread::spawn(move || {
+        let (mut client, _) = listener.accept().unwrap();
+        let mut buf = vec![0u8; 16];
+        let read = client.read(&mut buf).unwrap();
+        buf.truncate(read);
+        tx.send(buf).unwrap();
+    });
+
+    let seen = Arc::new(Mutex::new(None));
+    let seen_in_resolver = Arc::clone(&seen);
+
+    crate::agent()
+        .set_resolver(move |netloc: &str| {
+            *seen_in_resolver.lock().unwrap() = Some(netloc.to_string());
+            Ok(vec![local_addr])
+        })
+        .get("http://cool.server/")
+        .call();
+
+    let netloc = seen.lock().unwrap().clone().expect("resolver was not called");
+    assert!(
+        netloc.contains("cool.server"),
+        "resolver received unexpected netloc: {:?}",
+        netloc
+    );
+
+    let received = rx
+        .recv_timeout(Duration::from_secs(5))
+        .expect("resolver did not direct the request to the local server");
+    assert_eq!(&received, b"GET / HTTP/1.1\r\n");
+}
