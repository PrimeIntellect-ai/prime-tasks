+    def test_get_cookie_with_extra_keys(self):
+        cookie_dict = {'name': 'foo', 'value': 'bar', 'path': '/',
+                       'domain': 'not.Here', 'secure': True, 'httpOnly': True,
+                       'expiry': 123, 'hCode': -1693023704,
+                       'driver_extension': {'region': 'west'}}
+        when(self.driver).get_cookie('foo').thenReturn(cookie_dict)
+        cookie = self.cookie.get_cookie('foo')
+        self.assertEqual(cookie.name, 'foo')
+        self.assertEqual(cookie.value, 'bar')
+        self.assertTrue(
+            getattr(cookie, 'hCode', object()) == -1693023704 or
+            getattr(cookie, 'extra', {}).get('hCode', object()) == -1693023704
+        )
+        extension = {'region': 'west'}
+        self.assertTrue(
+            getattr(cookie, 'driver_extension', object()) == extension or
+            getattr(cookie, 'extra', {}).get('driver_extension', object()) == extension
+        )
+
