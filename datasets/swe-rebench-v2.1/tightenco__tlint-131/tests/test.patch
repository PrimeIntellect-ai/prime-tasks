+
+namespace App;
+
+class ControllerA extends Controller
+{
+    public function store()
+    {
+        return back()
+            ->with('errors', (new ViewErrorBag)->add('field', 'message'));
+    }
+}
+file;
+
+        $lints = (new TLint)->lint(
+            new RequestValidation($file)
+        );
+
+        $this->assertEmpty($lints);
