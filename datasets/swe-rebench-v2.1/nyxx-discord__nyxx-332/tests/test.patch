+class _ForumRestClient extends NyxxRestMock {
+  late final _RecordingHttpHandler recordingHandler = _RecordingHttpHandler(this);
+
+  @override
+  HttpHandler get httpHandler => recordingHandler;
+}
+
+class _RecordingHttpHandler extends HttpHandler {
+  final requests = <http.Request>[];
+  late Map<String, dynamic> Function(http.Request request) responsePayload;
+
+  _RecordingHttpHandler(INyxxRest client) : super(client);
+
+  @override
+  Future<HttpResponse> execute(HttpRequest request) async {
+    final preparedRequest = await request.prepareRequest() as http.Request;
+    requests.add(preparedRequest);
+    final response = HttpResponseSuccess(
+      http.StreamedResponse(
+        Stream.value(utf8.encode(jsonEncode(responsePayload(preparedRequest)))),
+        200,
+      ),
+    );
+    await response.finalize();
+    return response;
+  }
+}
+
+Iterable<dynamic> _threadsFrom(dynamic result) {
+  if (result is Iterable) {
+    return result.cast<dynamic>();
+  }
+
+  return (result.threads as Iterable).cast<dynamic>();
+}
