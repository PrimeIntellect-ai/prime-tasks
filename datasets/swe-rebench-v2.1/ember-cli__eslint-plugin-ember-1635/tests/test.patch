+test('sortBy with one key evaluates the key once and compares both items without a for-of loop', () => {
+  const linter = new Linter();
+  linter.defineParser('babel-parser', require('@babel/eslint-parser'));
+  linter.defineRule('no-array-prototype-extensions', rule);
+
+  const result = linter.verifyAndFix('something.sortBy(getKey())', {
+    parser: 'babel-parser',
+    parserOptions: { ecmaVersion: 2020, sourceType: 'module' },
+    rules: { 'no-array-prototype-extensions': 'error' },
+  });
+
+  expect(result.fixed).toBe(true);
+  expect(result.output).not.toMatch(/for\s*\(\s*(?:const|let|var)\s+\w+\s+of\b/);
+
+  const generatedCode = result.output.replace(/^import .*;\s*$/gm, '');
+  const evaluatedKeys = [];
+  const reads = [];
+  const getKey = () => {
+    const key = `field${evaluatedKeys.length}`;
+    evaluatedKeys.push(key);
+    return key;
+  };
+  const get = (item, key) => {
+    reads.push({ item, key });
+    return item[key];
+  };
+  const comparisons = [];
+  const compare = (left, right) => {
+    comparisons.push([left, right]);
+    return 7;
+  };
+  const something = { sort(callback) { this.comparator = callback; } };
+
+  new Function('getKey', 'get', 'compare', 'something', generatedCode)(
+    getKey,
+    get,
+    compare,
+    something
+  );
+  const comparator = something.comparator;
+
+  const firstLeft = { field0: 2 };
+  const firstRight = { field0: 1 };
+  comparator(firstLeft, firstRight);
+  expect(comparisons).toEqual([[2, 1]]);
+  expect(evaluatedKeys).toEqual(['field0']);
+  expect(reads).toEqual([
+    { item: firstLeft, key: 'field0' },
+    { item: firstRight, key: 'field0' },
+  ]);
+
+  const secondLeft = { field1: 1 };
+  const secondRight = { field1: 2 };
+  comparator(secondLeft, secondRight);
+  expect(comparisons[1]).toEqual([1, 2]);
+  expect(evaluatedKeys).toEqual(['field0', 'field1']);
+  expect(reads.slice(2)).toEqual([
+    { item: secondLeft, key: 'field1' },
+    { item: secondRight, key: 'field1' },
+  ]);
+});
