+    @Test
+    public void objectAndArrayDefaultsPreserveTheirJsonValues() throws IOException
+    {
+        String raml = "#%RAML 1.0\n"
+                      + "title: Defaults API\n"
+                      + "types:\n"
+                      + "  Person:\n"
+                      + "    type: object\n"
+                      + "    properties:\n"
+                      + "      name: string\n"
+                      + "      age: integer\n"
+                      + "    default: {name: Ray, age: 41}\n"
+                      + "  People:\n"
+                      + "    type: Person[]\n"
+                      + "    default: [{name: Ray, age: 41}, {name: Sam, age: 29}]\n";
+        RamlModelResult result = new RamlModelBuilder().buildApi(raml, "defaults.raml");
+        assertFalse(result.hasErrors());
+
+        TypeDeclaration person = null;
+        TypeDeclaration people = null;
+        for (TypeDeclaration type : result.getApiV10().types())
+        {
+            if ("Person".equals(type.name()))
+            {
+                person = type;
+            }
+            else if ("People".equals(type.name()))
+            {
+                people = type;
+            }
+        }
+
+        ObjectMapper mapper = new ObjectMapper();
+        assertThat(mapper.readTree(person.defaultValue()),
+                is(mapper.readTree("{\"name\":\"Ray\",\"age\":41}")));
+        assertThat(mapper.readTree(people.defaultValue()),
+                is(mapper.readTree("[{\"name\":\"Ray\",\"age\":41},{\"name\":\"Sam\",\"age\":29}]")));
+    }
+
+    @Test
+    public void responseBodyObjectDefaultIsReturnedAsJson() throws IOException
+    {
+        String raml = "#%RAML 1.0\n"
+                      + "title: Books API\n"
+                      + "version: 1.0\n"
+                      + "protocols: [HTTP]\n"
+                      + "baseUri: myApi\n"
+                      + "/books:\n"
+                      + "  get:\n"
+                      + "    responses:\n"
+                      + "      200:\n"
+                      + "        body:\n"
+                      + "          application/json:\n"
+                      + "            default: {'name':'ray'}\n";
+        RamlModelResult result = new RamlModelBuilder().buildApi(raml, "response-default.raml");
+        assertFalse(result.hasErrors());
+
+        TypeDeclaration responseBody = result.getApiV10().resources().get(0).methods().get(0)
+                                             .responses().get(0).body().get(0);
+        ObjectMapper mapper = new ObjectMapper();
+        assertThat(mapper.readTree(responseBody.defaultValue()),
+                is(mapper.readTree("{\"name\":\"ray\"}")));
+    }
