diff --git a/tests/Implementation/Php80/AttributePopo.php b/tests/Implementation/Php80/AttributePopo.php
new file mode 100644
index 0000000..dd8d917
--- /dev/null
+++ b/tests/Implementation/Php80/AttributePopo.php
@@ -0,0 +1,19 @@
+<?php
+
+declare(strict_types=1);
+
+namespace JsonMapper\Tests\Implementation\Php80;
+
+use JsonMapper\Middleware\Attributes\MapFrom;
+
+class AttributePopo
+{
+    #[MapFrom("Identifier")]
+    public int $id;
+    #[MapFrom("UserName")]
+    public string $name;
+    #[MapFrom("email")]
+    public string $email;
+    #[MapFrom("ExternalReference")]
+    public string $reference = '';
+}
diff --git a/tests/Integration/Middleware/Attributes/AttributeTest.php b/tests/Integration/Middleware/Attributes/AttributeTest.php
new file mode 100644
index 0000000..4d333ca
--- /dev/null
+++ b/tests/Integration/Middleware/Attributes/AttributeTest.php
@@ -0,0 +1,52 @@
+<?php
+
+declare(strict_types=1);
+
+namespace JsonMapper\Tests\Integration\Middleware\Attributes;
+
+use JsonMapper\Cache\NullCache;
+use JsonMapper\Handler\PropertyMapper;
+use JsonMapper\JsonMapperFactory;
+use JsonMapper\Middleware\Attributes\Attributes;
+use JsonMapper\Middleware\TypedProperties;
+use JsonMapper\Tests\Implementation\Php80\AttributePopo;
+use PHPUnit\Framework\TestCase;
+
+class AttributeTest extends TestCase
+{
+    /**
+     * @covers \JsonMapper\Middleware\Attributes\Attributes
+     * @requires PHP >= 8.0
+     */
+    public function testAttributesMiddlewareDoesMapFrom(): void
+    {
+        self::assertTrue(class_exists(Attributes::class), 'Attribute middleware must be available.');
+
+        $cache = new NullCache();
+        $mapper = (new JsonMapperFactory())->create(new PropertyMapper(), new Attributes(), new TypedProperties($cache));
+        $object = new AttributePopo();
+        $json = json_encode(['Identifier' => 42, 'UserName' => 'John Doe']);
+
+        $mapper->mapObjectFromString($json, $object);
+
+        self::assertSame(42, $object->id);
+        self::assertSame('John Doe', $object->name);
+    }
+
+    /**
+     * @covers \JsonMapper\Middleware\Attributes\Attributes
+     * @requires PHP >= 8.0
+     */
+    public function testAttributeMetadataMapsAnUnrelatedInputField(): void
+    {
+        self::assertTrue(class_exists(Attributes::class), 'Attribute middleware must be available.');
+
+        $cache = new NullCache();
+        $mapper = (new JsonMapperFactory())->create(new PropertyMapper(), new Attributes(), new TypedProperties($cache));
+        $object = new AttributePopo();
+
+        $mapper->mapObjectFromString(json_encode(['ExternalReference' => 'ref-739']), $object);
+
+        self::assertSame('ref-739', $object->reference);
+    }
+}
