diff --git a/cubed/tests/test_core.py b/cubed/tests/test_core.py
index 7a8a14c..74ed891 100644
--- a/cubed/tests/test_core.py
+++ b/cubed/tests/test_core.py
@@ -492,5 +492,23 @@ def test_measure_reserved_memory(executor):
     if not isinstance(executor, LithopsDagExecutor):
         pytest.skip(f"{type(executor)} does not support measure_reserved_memory")
 
-    reserved_memory = cubed.measure_reserved_memory(executor=executor)
-    assert reserved_memory > 1_000_000  # over 1MB
+    reserved_memory = cubed.measure_reserved_memory(executor)
+    assert reserved_memory > 0
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="does not run on windows")
+def test_measure_reserved_memory_passes_runtime_settings(tmp_path):
+    pytest.importorskip("lithops")
+
+    from cubed.runtime.executors.lithops import LithopsDagExecutor
+    from cubed.tests.utils import LITHOPS_LOCAL_CONFIG
+
+    # the executor's own configuration cannot be used to run workers
+    broken_config = {"lithops": {"backend": "does_not_exist", "storage": "localhost"}}
+    executor = LithopsDagExecutor(config=broken_config)
+
+    # runtime settings given in the call are used for the computation
+    reserved_memory = cubed.measure_reserved_memory(
+        executor, work_dir=str(tmp_path), config=LITHOPS_LOCAL_CONFIG
+    )
+    assert reserved_memory > 0
