+def test_pytest_configuration_does_not_warn_about_strict():
+    process = Popen(
+        [
+            sys.executable,
+            "-m",
+            "pytest",
+            "--collect-only",
+            "-q",
+            "tests/test_crypto.py",
+        ],
+        stdout=PIPE,
+        stderr=PIPE,
+    )
+    stdout, stderr = process.communicate()
+
+    assert b"Unknown config option: strict" not in stdout + stderr
