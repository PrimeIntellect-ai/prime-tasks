diff --git a/encode.go b/encode.go
index 0f4a9d5..95d2c23 100644
--- a/encode.go
+++ b/encode.go
@@ -1233,6 +1233,12 @@ func encodeTag(e *encoderBuffer, em *encMode, v reflect.Value) error {
 
 	t := v.Interface().(Tag)
 
+	if t.Number == 0 && t.Content == nil {
+		// Marshal uninitialized cbor.Tag
+		e.Write(cborNil)
+		return nil
+	}
+
 	// Marshal tag number
 	encodeHead(e, byte(cborTypeTag), t.Number)
 
diff --git a/tag.go b/tag.go
index 847a0ee..924f74d 100644
--- a/tag.go
+++ b/tag.go
@@ -49,7 +49,15 @@ func (t *RawTag) UnmarshalCBOR(data []byte) error {
 
 // MarshalCBOR returns CBOR encoding of t.
 func (t RawTag) MarshalCBOR() ([]byte, error) {
+	if t.Number == 0 && len(t.Content) == 0 {
+		// Marshal uninitialized cbor.RawTag
+		b := make([]byte, len(cborNil))
+		copy(b, cborNil)
+		return b, nil
+	}
+
 	e := getEncoderBuffer()
+
 	encodeHead(e, byte(cborTypeTag), t.Number)
 
 	buf := make([]byte, len(e.Bytes())+len(t.Content))
