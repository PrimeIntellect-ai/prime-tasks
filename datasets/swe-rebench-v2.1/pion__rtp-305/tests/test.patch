+
+func TestNewPacketizerWithOptions_InitialTimestamp(t *testing.T) {
+	const initialTimestamp = uint32(45678)
+	packetizer := NewPacketizerWithOptions(
+		100,
+		&codecs.G722Payloader{},
+		NewRandomSequencer(),
+		90000,
+		WithTimestamp(initialTimestamp),
+	)
+
+	packets := packetizer.Packetize([]byte{0x11, 0x12, 0x13, 0x14}, 2000)
+	assert.NotEmpty(t, packets)
+	for _, packet := range packets {
+		assert.Equal(t, initialTimestamp, packet.Timestamp)
+	}
+}
