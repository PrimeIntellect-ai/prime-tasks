+    def test_can_parse_route53_with_missing_message(self):
+        # Route53 may omit the message from both the XML response and headers.
+        body =  (
+            '<ErrorResponse>'
+            '  <Error>'
+            '    <Type>Sender</Type>'
+            '    <Code>InvalidInput</Code>'
+            '  </Error>'
+            '  <RequestId>id</RequestId>'
+            '</ErrorResponse>'
+        ).encode('utf-8')
+        parser = parsers.RestXMLParser()
+        parsed = parser.parse({
+            'body': body, 'headers': {}, 'status_code': 400}, None)
+        error = parsed['Error']
+        self.assertEqual(error['Code'], 'InvalidInput')
+        # Handling this service error must raise ClientError, not fail while
+        # trying to read a missing message.
+        with self.assertRaises(ClientError) as raised:
+            raise ClientError(parsed, 'ListResourceRecordSets')
+        self.assertEqual(raised.exception.response['Error']['Code'],
+                         'InvalidInput')
+
 
