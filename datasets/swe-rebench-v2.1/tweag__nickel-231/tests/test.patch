+/// Regression test for [#230](https://github.com/tweag/nickel/issues/230).
+///
+/// A `#` or a sequence of `#` inside a multiline string must be treated as
+/// literal text: the program must evaluate without error and preserve the
+/// intended string value. We check the observable evaluated value rather than
+/// the exact parser AST, since a compliant parser may split the literal text
+/// into several adjacent chunks as long as the concatenated value is correct.
+#[test]
+fn multiline_str_escape() {
+    assert_eq!(
+        eval_no_import(parse_without_pos(r##"m#"Hel#lo"#m"##)),
+        Ok(Term::Str(String::from("Hel#lo"))),
+    );
+    assert_eq!(
+        eval_no_import(parse_without_pos(r##"m#"#Hel##lo###"#m"##)),
+        Ok(Term::Str(String::from("#Hel##lo###"))),
+    );
+    assert_eq!(
+        eval_no_import(parse_without_pos(r##"m#"#Hel##{lo###{"#m"##)),
+        Ok(Term::Str(String::from("#Hel##{lo###{"))),
+    );
+}
