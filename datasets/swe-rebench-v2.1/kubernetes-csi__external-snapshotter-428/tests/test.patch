+// newNonCSIVolume returns a PersistentVolume that is not backed by a CSI driver.
+func newNonCSIVolume(name, volumeUID, boundToClaimUID, boundToClaimName string) *v1.PersistentVolume {
+	return &v1.PersistentVolume{
+		ObjectMeta: metav1.ObjectMeta{
+			Name: name,
+			UID:  types.UID(volumeUID),
+		},
+		Spec: v1.PersistentVolumeSpec{
+			PersistentVolumeSource: v1.PersistentVolumeSource{
+				HostPath: &v1.HostPathVolumeSource{Path: "/tmp"},
+			},
+			ClaimRef: &v1.ObjectReference{
+				Kind:       "PersistentVolumeClaim",
+				APIVersion: "v1",
+				UID:        types.UID(boundToClaimUID),
+				Namespace:  testNamespace,
+				Name:       boundToClaimName,
 			},
-			test: testUpdateSnapshotClass,
 		},
+	}
+}
