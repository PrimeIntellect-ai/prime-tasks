+// pvDriverProvider is implemented by the common snapshot controller when it
+// exposes the required pvDriverFromSnapshot method.
+type pvDriverProvider interface {
+	pvDriverFromSnapshot(snapshot *crdv1.VolumeSnapshot) (string, error)
