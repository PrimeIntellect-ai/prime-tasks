+func TestSelectServicesANYPrefersHighestUsableVersion(t *testing.T) {
+	now := time.Now()
+	services := make([]Service, 0, 11)
+	for i := 0; i < 10; i++ {
+		services = append(services, Service{
+			URL:                 fmt.Sprintf("lower-%d", i),
+			MajorAPIVersion:     1,
+			ValidityPeriodStart: now.Add(-time.Hour),
+			ValidityPeriodEnd:   now.Add(time.Hour),
+		})
+	}
+	services = append(services, Service{
+		URL:                 "highest",
+		MajorAPIVersion:     2,
+		ValidityPeriodStart: now.Add(-time.Hour),
+		ValidityPeriodEnd:   now.Add(time.Hour),
+	})
+
+	for i := 0; i < 40; i++ {
+		got, err := SelectServices(services, ServiceConfiguration{
+			Selector: prototrustroot.ServiceSelector_ANY,
+		}, []uint32{1, 2}, now)
+		if err != nil {
+			t.Fatalf("SelectServices() returned an error: %v", err)
+		}
+		if len(got) != 1 || got[0] != "highest" {
+			t.Fatalf("SelectServices() with ANY selected %v; want only the highest-version service", got)
+		}
+	}
+}
