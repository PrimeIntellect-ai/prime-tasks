+test("should resolve media query imports with charset", async t => {
+  const input = fs.readFileSync("test/fixtures/media-charset.css", "utf8")
+  const result = await postcss(
+    atImport({ path: "test/fixtures/imports" })
+  ).process(input, { from: undefined })
+  const root = postcss.parse(result.css)
+  const charsetIndex = root.nodes.findIndex(
+    node => node.type === "atrule" && node.name === "charset"
+  )
+  const mediaIndex = root.nodes.findIndex(
+    node => node.type === "atrule" && node.name === "media"
+  )
+
+  t.not(charsetIndex, -1)
+  t.not(mediaIndex, -1)
+  t.true(charsetIndex < mediaIndex)
+  t.is(root.nodes[mediaIndex].params, "level-1")
+  t.true(
+    root.nodes[mediaIndex].nodes.some(
+      node => node.type === "rule" && node.selector === ".charset-content"
+    )
+  )
+})
+
 test("should join correctly media queries", checkFixture, "media-join")
