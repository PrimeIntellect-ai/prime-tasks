diff --git a/src/effector/__tests__/fork/scopeBind.test.ts b/src/effector/__tests__/fork/scopeBind.test.ts
index 68e301df..18135581 100644
--- a/src/effector/__tests__/fork/scopeBind.test.ts
+++ b/src/effector/__tests__/fork/scopeBind.test.ts
@@ -58,3 +58,54 @@ it('returns promise when used with effect', async () => {
   const req = scopeFx()
   expect(req instanceof Promise).toBe(true)
 })
+
+it('does not throw on calls without scope, if called in safe mode', () => {
+  const trigger = createEvent()
+
+  expect(() => {
+    scopeBind(trigger, {safe: true})
+  }).not.toThrow()
+})
+
+it('allows calls without scope, if called in safe mode', async () => {
+  const trigger = createEvent()
+  const inc = createEvent()
+  const $count = createStore(0).on(inc, x => x + 1)
+
+  let fn: () => void
+
+  trigger.watch(() => {
+    fn = scopeBind(inc, {safe: true})
+  })
+
+  trigger()
+  await Promise.resolve()
+  fn!()
+  expect($count.getState()).toBe(1)
+})
+
+it('catches scope, if called with scope in safe mode', async () => {
+  const trigger = createEvent()
+  const inc = createEvent()
+  const $count = createStore(0).on(inc, x => x + 1)
+
+  let fn: () => void
+
+  trigger.watch(() => {
+    fn = scopeBind(inc, {safe: true})
+  })
+
+  const scope = fork()
+  await allSettled(trigger, {scope})
+  fn!()
+  expect(scope.getState($count)).toBe(1)
+  expect($count.getState()).toBe(0)
+})
+
+it('allows effects to be called without scope in safe mode', async () => {
+  const fx = createEffect((value: number) => value + 1)
+
+  const safeFx = scopeBind(fx, {safe: true})
+
+  await expect(safeFx(2)).resolves.toBe(3)
+})
