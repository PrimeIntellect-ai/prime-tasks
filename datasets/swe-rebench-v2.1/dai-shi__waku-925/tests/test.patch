+import { describe, expect, test, vi } from 'vitest';
+import { fsRouterTypegenPlugin } from '../src/lib/plugins/vite-plugin-fs-router-typegen.js';
+import { fileURLToPath } from 'node:url';
+import { FSWatcher, ViteDevServer } from 'vite';
+import { writeFile } from 'node:fs/promises';
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { dirname, join } from 'node:path';
+
+const root = fileURLToPath(new URL('./fixtures', import.meta.url));
+
+vi.mock('prettier', () => {
+  return { format: (x: string) => x, resolveConfig: () => ({}) };
+});
+vi.mock('node:fs/promises', async (importOriginal) => {
+  const mod = await importOriginal();
+  return {
+    // https://vitest.dev/api/vi.html#vi-mock
+    // @ts-expect-error - docs say this should be inferred...
+    ...mod,
+    writeFile: vi.fn(),
+  };
+});
+
+// Runs the plugin's lifecycle for a project root and returns the generated entries file content
+async function generate(
+  projectRoot: string,
+  srcDir = 'plugin-fs-router-typegen',
+): Promise<string> {
+  vi.mocked(writeFile).mockClear();
+  const plugin = fsRouterTypegenPlugin({
+    srcDir,
+  });
+  expect(plugin.configureServer).toBeDefined();
+  expect(typeof plugin.configureServer).toBe('function');
+  expect(plugin.configResolved).toBeDefined();
+  expect(typeof plugin.configResolved).toBe('function');
+  if (
+    typeof plugin.configureServer !== 'function' ||
+    typeof plugin.configResolved !== 'function'
+  ) {
+    throw new Error('plugin hooks are missing');
+  }
+  // @ts-expect-error - we're not passing the full Vite config
+  await plugin.configResolved?.({ root: projectRoot });
+  await plugin.configureServer?.({
+    watcher: { add: () => {}, on: () => {} } as unknown as FSWatcher,
+  } as ViteDevServer);
+  await vi.waitFor(async () => {
+    if (vi.mocked(writeFile).mock.lastCall === undefined) {
+      throw new Error('writeFile not called');
+    }
+  });
+  return String(vi.mocked(writeFile).mock.lastCall?.[1]);
+}
+
+const IDENTIFIER = /^[\p{ID_Start}$_][\p{ID_Continue}$\u200C\u200D]*$/u;
+
+// Parses `import Alias[, { getConfig as Alias_getConfig }] from './pages/<source>';`
+function parseImports(code: string) {
+  const re =
+    /^import ([^\s,]+)(?:, \{ getConfig as ([^\s}]+) \})? from '\.\/pages\/([^']+)';$/gm;
+  const imports: { alias: string; getConfigAlias?: string; source: string }[] =
+    [];
+  for (const m of code.matchAll(re)) {
+    imports.push({
+      alias: m[1]!,
+      getConfigAlias: m[2],
+      source: m[3]!,
+    });
+  }
+  return imports;
+}
+
+// Returns [routePath, importSource] pairs for every page and layout in the generated routes
+function routeSources(code: string) {
+  const imports = parseImports(code);
+  const sourceByAlias = new Map(imports.map((i) => [i.alias, i.source]));
+  const pairs: [string, string | undefined][] = [];
+  const re = /pagesFns\.(?:createPage|createLayout)\(\{ path: '([^']*)', component: ([^,\s]+),/g;
+  for (const m of code.matchAll(re)) {
+    pairs.push([m[1]!, sourceByAlias.get(m[2]!)]);
+  }
+  return pairs;
+}
+
+describe('vite-plugin-fs-router-typegen', () => {
+  test('generates valid module names for fs entries', async () => {
+    const code = await generate(root);
+    const imports = parseImports(code);
+    expect(imports.length).toBe(8);
+    const names = imports.flatMap((i) =>
+      i.getConfigAlias ? [i.alias, i.getConfigAlias] : [i.alias],
+    );
+    for (const name of names) {
+      expect(name).toMatch(IDENTIFIER);
+    }
+    expect(new Set(names).size).toBe(names.length);
+  });
+
+  test('allows unicode characters in module names', async () => {
+    const code = await generate(root);
+    const unicodeImport = parseImports(code).find(
+      (i) => i.source === 'øné_two_three',
+    );
+    expect(unicodeImport).toBeDefined();
+    expect(unicodeImport?.alias).toMatch(IDENTIFIER);
+    expect(routeSources(code)).toContainEqual([
+      '/øné_two_three',
+      'øné_two_three',
+    ]);
+  });
+
+  test('handles collisions of fs entry module names', async () => {
+    const code = await generate(root);
+    const imports = parseImports(code);
+    const collided = ['one-two-three', 'one__two_three', 'one_two_three'].map(
+      (source) => imports.find((i) => i.source === source),
+    );
+    for (const i of collided) {
+      expect(i).toBeDefined();
+    }
+    const aliases = collided.map((i) => i!.alias);
+    expect(new Set(aliases).size).toBe(3);
+    // each colliding page is still routed to its own file
+    const pairs = routeSources(code);
+    expect(pairs).toContainEqual(['/one-two-three', 'one-two-three']);
+    expect(pairs).toContainEqual(['/one__two_three', 'one__two_three']);
+    expect(pairs).toContainEqual(['/one_two_three', 'one_two_three']);
+  });
+
+  test('creates the expected imports the generated entries file', async () => {
+    const code = await generate(root);
+    expect(routeSources(code).sort()).toEqual(
+      [
+        ['/', '_layout'],
+        ['/', 'index'],
+        ['/[category]/', '[category]/_layout'],
+        ['/[category]/[...tags]/', '[category]/[...tags]/index'],
+        ['/one-two-three', 'one-two-three'],
+        ['/one__two_three', 'one__two_three'],
+        ['/one_two_three', 'one_two_three'],
+        ['/øné_two_three', 'øné_two_three'],
+      ].sort(),
+    );
+  });
+
+  test('generates a project without a root index page', async () => {
+    const projectRoot = mkdtempSync(join(tmpdir(), 'waku-typegen-'));
+    try {
+      const pages = join(projectRoot, 'src', 'pages');
+      const files = ['about.tsx', 'blog/post.tsx'];
+      for (const file of files) {
+        mkdirSync(dirname(join(pages, file)), { recursive: true });
+        writeFileSync(
+          join(pages, file),
+          'export default function Page() { return null; }\n',
+        );
+      }
+      const code = await generate(projectRoot, 'src');
+      expect(routeSources(code).sort()).toEqual([
+        ['/about', 'about'],
+        ['/blog/post', 'blog/post'],
+      ]);
+    } finally {
+      rmSync(projectRoot, { recursive: true, force: true });
+    }
+  });
+});
