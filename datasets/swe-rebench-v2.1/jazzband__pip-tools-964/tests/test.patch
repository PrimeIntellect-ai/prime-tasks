+
+def test_trusted_host_in_requirements_file(runner):
+    """Trusted-host options from the input file are retained in the output."""
+    with open("requirements.in", "w") as reqs_in:
+        reqs_in.write("--trusted-host example.com")
+
+    out = runner.invoke(cli)
+    assert out.exit_code == 0, out
+
+    with open("requirements.txt") as reqs_txt:
+        assert any(
+            line.split()
+            in (["--trusted-host", "example.com"], ["--trusted-host=example.com"])
+            for line in reqs_txt.read().splitlines()
+        )
+
+
+def test_trusted_host_from_stdin_in_output(runner):
+    """Trusted-host options read from STDIN are retained in the output file."""
+    out = runner.invoke(
+        cli,
+        ["-", "--output-file", "requirements.txt"],
+        input="--trusted-host example.com\nsmall-fake-a==0.1",
+    )
+    assert out.exit_code == 0, out
+
+    with open("requirements.txt") as reqs_txt:
+        assert any(
+            line.split()
+            in (["--trusted-host", "example.com"], ["--trusted-host=example.com"])
+            for line in reqs_txt.read().splitlines()
+        )
