+
+/**
+ * Verifies that dependency versions are managed by the Gradle version catalog
+ * declared in `gradle/libs.versions.toml`, rather than being hardcoded in build scripts.
+ */
+val verifyVersionCatalog by tasks.registering {
+    doLast {
+        val catalog = project.extensions
+            .getByType(org.gradle.api.artifacts.VersionCatalogsExtension::class.java)
+            .named("libs")
+        val catalogVersions = mutableSetOf<String>().apply {
+            catalog.versionAliases.forEach { alias ->
+                add(catalog.findVersion(alias).get().requiredVersion)
+            }
+            catalog.libraryAliases.forEach { alias ->
+                val version = catalog.findLibrary(alias).get().get().versionConstraint.requiredVersion
+                if (version.isNotEmpty()) add(version)
+            }
+            catalog.pluginAliases.forEach { alias ->
+                val version = catalog.findPlugin(alias).get().get().version.requiredVersion
+                if (version.isNotEmpty()) add(version)
+            }
+        }
+        val classpathDependencies = rootProject.buildscript
+            .configurations.getByName("classpath")
+            .dependencies
+        classpathDependencies.forEach { dependency ->
+            val version = dependency.version ?: return@forEach
+            check(version in catalogVersions) {
+                "Dependency '${dependency.group}:${dependency.name}:$version' is not managed by the version catalog"
+            }
+        }
+    }
+}
+
+tasks.matching { it.name == "jvmTest" }.configureEach {
+    dependsOn(verifyVersionCatalog)
+}
