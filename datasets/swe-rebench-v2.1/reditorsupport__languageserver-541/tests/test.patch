     expect_equal(bsearch("foo[xy", 0, 5), list(c(0, 3), "["))
     expect_equal(bsearch("foo{xy", 0, 5), list(c(0, 3), "{"))
 })
+
+
+test_that("Signature help works in else if branch", {
+    uri <- "file:///test.R"
+    content <- c("if (sum()) {", "", "} else if (sum(")
+    workspace <- Workspace$new(getwd())
+    document <- Document$new(uri, content = content)
+    workspace$documents$set(uri, document)
+    workspace$update_parse_data(uri, parse_document(uri, content))
+
+    result <- signature_reply(1, uri, workspace, document,
+        list(row = 2, col = 15))$result
+    expect_true(length(result$signatures) >= 1)
+    expect_true(any(vapply(result$signatures, function(signature) {
+        grepl("sum", signature$label)
+    }, logical(1))))
+})
