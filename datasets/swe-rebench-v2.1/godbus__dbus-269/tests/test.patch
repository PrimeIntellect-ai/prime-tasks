+// newTestEncoder builds an encoder through the package constructor. It accepts
+// both the legacy two-argument constructor and the FD-aware three-argument
+// constructor so the same test source can exercise either implementation.
+func newTestEncoder(out io.Writer, order binary.ByteOrder, fds []int) *encoder {
+	fn := reflect.ValueOf(newEncoder)
+	args := []reflect.Value{reflect.ValueOf(out), reflect.ValueOf(order)}
+	if fn.Type().NumIn() == 3 {
+		args = append(args, reflect.ValueOf(fds))
+	}
+	return fn.Call(args)[0].Interface().(*encoder)
+}
+
+// newTestDecoder builds a decoder through the package constructor, accepting
+// both the legacy two-argument constructor and the FD-aware three-argument
+// constructor.
+func newTestDecoder(in io.Reader, order binary.ByteOrder, fds []int) *decoder {
+	fn := reflect.ValueOf(newDecoder)
+	args := []reflect.Value{reflect.ValueOf(in), reflect.ValueOf(order)}
+	if fn.Type().NumIn() == 3 {
+		args = append(args, reflect.ValueOf(fds))
+	}
+	return fn.Call(args)[0].Interface().(*decoder)
+}
