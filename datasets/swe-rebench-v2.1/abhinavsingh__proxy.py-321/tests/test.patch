+    def test_ca_file_flag(self) -> None:
+        """A custom system CA path can be supplied via the --ca-file flag."""
+        flags = Flags.initialize(['--ca-file', '/path/to/custom-ca.pem'])
+        self.assertEqual(flags.ca_file, '/path/to/custom-ca.pem')
+
+    def test_ca_file_defaults_to_none(self) -> None:
+        flags = Flags.initialize([])
+        self.assertIsNone(flags.ca_file)
+
+    def test_custom_ca_file_keeps_upstream_peer_verification_enabled(
+            self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            ca_file = os.path.join(directory, 'custom-ca.pem')
+            key_file = os.path.join(directory, 'custom-ca.key')
+            subprocess.run(
+                ['openssl', 'req', '-x509', '-newkey', 'rsa:2048', '-nodes',
+                 '-keyout', key_file, '-out', ca_file, '-subj',
+                 '/CN=proxy-test-custom-ca', '-days', '1'],
+                check=True,
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL)
+            with open(ca_file) as certificate_file:
+                ca_cert = ssl.PEM_cert_to_DER_cert(certificate_file.read())
+
+            flags = Flags.initialize(['--ca-file', ca_file])
+            plugin = HttpProxyPlugin(
+                uuid.uuid4(), flags, mock.Mock(), mock.Mock(), mock.Mock())
+            upstream_socket = mock.MagicMock(spec=socket.socket)
+            plugin.server = mock.Mock(connection=upstream_socket)
+            plugin.request.host = 'upstream.example'
+            wrapped_socket = mock.MagicMock(spec=ssl.SSLSocket)
+
+            with mock.patch.object(
+                    ssl.SSLContext, 'wrap_socket', autospec=True,
+                    return_value=wrapped_socket) as wrap_socket:
+                plugin.wrap_server()
+
+            context = wrap_socket.call_args[0][0]
+            self.assertNotEqual(context.verify_mode, ssl.CERT_NONE)
+            self.assertIn(ca_cert, context.get_ca_certs(binary_form=True))
