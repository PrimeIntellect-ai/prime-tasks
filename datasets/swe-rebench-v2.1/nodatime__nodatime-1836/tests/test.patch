+        private static TestCaseData[] NanosecondsBetweenLocalTimesTestCaseData =>
+        [
+            new TestCaseData(LocalTime.MinValue, LocalTime.MaxValue, LocalTime.MaxValue.NanosecondOfDay)
+                .SetName($"Nanoseconds between {nameof(LocalTime.MinValue)} and {nameof(LocalTime.MaxValue)} should be maximum {nameof(LocalTime.MaxValue.NanosecondOfDay)}"),
+            new TestCaseData(LocalTime.MaxValue, LocalTime.MinValue, -LocalTime.MaxValue.NanosecondOfDay)
+                .SetName($"Nanoseconds between {nameof(LocalTime.MaxValue)} and {nameof(LocalTime.MinValue)} should be negative maximum {nameof(LocalTime.MaxValue.NanosecondOfDay)}"),
+            new TestCaseData(LocalTime.MinValue, LocalTime.MinValue.PlusNanoseconds(1), 1L)
+                .SetName($"Nanoseconds between {nameof(LocalTime.MinValue)} and {nameof(LocalTime.MinValue)}_Plus_One should be 1"),
+            new TestCaseData(LocalTime.MinValue.PlusNanoseconds(1), LocalTime.MinValue, -1L).
+                SetName($"Nanoseconds between {nameof(LocalTime.MinValue)}_Plus_One and {nameof(LocalTime.MinValue)} should be negative 1"),
+            new TestCaseData(new LocalTime(2, 3, 4), new LocalTime(5, 6, 7), 10_983_000_000_000L)
+                .SetName("Nanoseconds between interior times should be the positive difference"),
+            new TestCaseData(new LocalTime(5, 6, 7), new LocalTime(2, 3, 4), -10_983_000_000_000L)
+                .SetName("Nanoseconds between interior times should be the negative difference"),
+            new TestCaseData(new LocalTime(12, 34, 56), new LocalTime(12, 34, 56), 0L)
+                .SetName("Nanoseconds between equal interior times should be zero"),
+        ];
+
+        private static Func<LocalTime, LocalTime, long> CreateNanosecondsBetweenDelegate()
+        {
+            var method = typeof(Period).GetMethod(
+                "NanosecondsBetween",
+                BindingFlags.Public | BindingFlags.Static,
+                binder: null,
+                types: new[] { typeof(LocalTime), typeof(LocalTime) },
+                modifiers: null);
+            Assert.That(method, Is.Not.Null, "Expected Period to expose a public static NanosecondsBetween method.");
+            Assert.AreEqual(typeof(long), method!.ReturnType);
+            return (Func<LocalTime, LocalTime, long>)method.CreateDelegate(typeof(Func<LocalTime, LocalTime, long>));
+        }
+
+        [TestCaseSource(nameof(NanosecondsBetweenLocalTimesTestCaseData))]
+        public void NanosecondsBetweenLocalTimes(LocalTime start, LocalTime end, long expected)
+        {
+            var nanosecondsBetween = CreateNanosecondsBetweenDelegate();
+            var actual = nanosecondsBetween(start, end);
+            Assert.AreEqual(expected, actual);
+        }
+
+        [Test]
+        public void NanosecondsBetweenLocalTimes_DoesNotAllocate()
+        {
+            var start = LocalTime.MinValue;
+            var end = LocalTime.MaxValue;
+            var nanosecondsBetween = CreateNanosecondsBetweenDelegate();
+            // Warm up so that the method is fully JIT-compiled before measuring.
+            long warmup = 0;
+            for (int i = 0; i < 100_000; i++)
+            {
+                warmup += nanosecondsBetween(start, end);
+            }
+            long before = GC.GetAllocatedBytesForCurrentThread();
+            long total = 0;
+            for (int i = 0; i < 10_000; i++)
+            {
+                total += nanosecondsBetween(start, end);
+            }
+            long allocated = GC.GetAllocatedBytesForCurrentThread() - before;
+            // The calculation must not create a Period (or any other object).
+            Assert.That(allocated, Is.Zero,
+                $"Expected no allocations, but {allocated} bytes were allocated (warmup: {warmup}, total: {total}).");
+        }
+
