+func TestNewWithoutOptionsUsesDefaultContextualMiddleware(t *testing.T) {
+	seen := make(chan string, 2)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		seen <- r.Header.Get("X-Context-Middleware")
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+
+	contextMiddleware := MiddlewareFunc(func(_ Options, next http.RoundTripper) http.RoundTripper {
+		return RoundTripperFunc(func(req *http.Request) (*http.Response, error) {
+			req.Header.Set("X-Context-Middleware", "applied")
+			return next.RoundTrip(req)
+		})
+	})
+
+	for _, createClient := range []struct {
+		name string
+		new  func() (*http.Client, error)
+	}{
+		{name: "without options", new: func() (*http.Client, error) { return New() }},
+		{name: "with empty options", new: func() (*http.Client, error) { return New(Options{}) }},
+	} {
+		t.Run(createClient.name, func(t *testing.T) {
+			client, err := createClient.new()
+			require.NoError(t, err)
+
+			ctx := WithContextualMiddleware(context.Background(), contextMiddleware)
+			req, err := http.NewRequestWithContext(ctx, http.MethodGet, server.URL, nil)
+			require.NoError(t, err)
+			resp, err := client.Do(req)
+			require.NoError(t, err)
+			require.Equal(t, http.StatusNoContent, resp.StatusCode)
+			require.NoError(t, resp.Body.Close())
+		})
+	}
+
+	require.Equal(t, "applied", <-seen)
+	require.Equal(t, "applied", <-seen)
+}
