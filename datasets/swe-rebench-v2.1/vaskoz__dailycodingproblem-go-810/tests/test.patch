@@ -0,0 +1,156 @@
+package day329
+
+import "testing"
+
+// testcases provide preference profiles used to exercise the public contract.
+// Pairings are not hard-coded; instead the tests verify the required
+// properties of whatever matching is returned.
+var testcases = []struct {
+	name           string
+	males, females map[string][]string
+}{
+	{
+		name: "example",
+		males: map[string][]string{
+			"andrew":  {"caroline", "abigail", "betty"},
+			"bill":    {"caroline", "betty", "abigail"},
+			"chester": {"betty", "caroline", "abigail"},
+		},
+		females: map[string][]string{
+			"abigail":  {"andrew", "bill", "chester"},
+			"betty":    {"bill", "andrew", "chester"},
+			"caroline": {"bill", "chester", "andrew"},
+		},
+	},
+	{
+		name: "four-by-four",
+		males: map[string][]string{
+			"0": {"7", "5", "6", "4"},
+			"1": {"5", "4", "6", "7"},
+			"2": {"4", "5", "6", "7"},
+			"3": {"4", "5", "6", "7"},
+		},
+		females: map[string][]string{
+			"4": {"0", "1", "2", "3"},
+			"5": {"0", "1", "2", "3"},
+			"6": {"0", "1", "2", "3"},
+			"7": {"0", "1", "2", "3"},
+		},
+	},
+	{
+		name: "two-by-two",
+		males: map[string][]string{
+			"0": {"2", "3"},
+			"1": {"3", "2"},
+		},
+		females: map[string][]string{
+			"2": {"1", "0"},
+			"3": {"1", "0"},
+		},
+	},
+	{
+		name: "multiple stable matchings",
+		males: map[string][]string{
+			"m1": {"w1", "w2", "w3"},
+			"m2": {"w1", "w2", "w3"},
+			"m3": {"w1", "w3", "w2"},
+		},
+		females: map[string][]string{
+			"w1": {"m1", "m2", "m3"},
+			"w2": {"m1", "m3", "m2"},
+			"w3": {"m1", "m2", "m3"},
+		},
+	},
+}
+
+// rankOf returns the 0-based position of person in prefs, or -1 when absent.
+func rankOf(prefs []string, person string) int {
+	for i, p := range prefs {
+		if p == person {
+			return i
+		}
+	}
+
+	return -1
+}
+
+// checkPerfectMatching verifies that matches pairs every male with exactly one
+// distinct female drawn from the supplied preference lists.
+func checkPerfectMatching(t *testing.T, males, females map[string][]string, matches map[string]string) {
+	t.Helper()
+
+	if len(matches) != len(males) {
+		t.Fatalf("expected %d pairs, got %d: %v", len(males), len(matches), matches)
+	}
+
+	used := make(map[string]bool, len(matches))
+
+	for m, w := range matches {
+		if _, ok := males[m]; !ok {
+			t.Fatalf("matching contains unknown male %q", m)
+		}
+
+		if _, ok := females[w]; !ok {
+			t.Fatalf("male %q matched to unknown female %q", m, w)
+		}
+
+		if used[w] {
+			t.Fatalf("female %q is matched more than once", w)
+		}
+
+		used[w] = true
+	}
+}
+
+// isStable reports whether matches contains no blocking pair, i.e. no man and
+// woman who both prefer each other over their assigned partners.
+func isStable(males, females map[string][]string, matches map[string]string) bool {
+	partner := make(map[string]string, len(matches)*2)
+	for m, w := range matches {
+		partner[m] = w
+		partner[w] = m
+	}
+
+	for m, prefs := range males {
+		for _, w := range prefs {
+			if w == partner[m] {
+				break
+			}
+
+			// m prefers w over his current partner; is the feeling mutual?
+			if rankOf(females[w], m) < rankOf(females[w], partner[w]) {
+				return false
+			}
+		}
+	}
+
+	return true
+}
+
+func TestStableMarriage(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range testcases {
+		tc := tc
+
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+
+			res := StableMarriage(tc.males, tc.females)
+
+			checkPerfectMatching(t, tc.males, tc.females, res)
+
+			if !isStable(tc.males, tc.females, res) {
+				t.Errorf("matching is not stable: %v", res)
+			}
+		})
+	}
+}
+
+func BenchmarkStableMarriage(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			StableMarriage(tc.males, tc.females)
+		}
+	}
+}
