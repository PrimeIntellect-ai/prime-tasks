+def test_pickle_overriden_builtin_dataclass(create_module):
+    module = create_module(
+        # language=Python
+        """\
+import dataclasses
+import pydantic
+
+
+@dataclasses.dataclass
+class BuiltInDataclassForPickle:
+    value: int
+
+class ModelForPickle(pydantic.BaseModel):
+    # pickle can only work with top level classes as it imports them
+
+    dataclass: BuiltInDataclassForPickle
+
+    class Config:
+        validate_assignment = True
+        """
+    )
+    obj = module.ModelForPickle(dataclass=module.BuiltInDataclassForPickle(value=5))
+
+    pickled_obj = pickle.dumps(obj)
+    restored_obj = pickle.loads(pickled_obj)
+
+    assert restored_obj.dataclass.value == 5
+    assert restored_obj == obj
+
+    # the wrapped dataclass class must be registered so that pickle can find it by reference
+    wrapped_dataclass = type(obj.dataclass)
+    assert pickle.loads(pickle.dumps(wrapped_dataclass)) is wrapped_dataclass
+
+    # ensure the restored dataclass is still a pydantic dataclass
+    with pytest.raises(ValidationError, match='value\n +value is not a valid integer'):
+        restored_obj.dataclass.value = 'value of a wrong type'
+
+
+def test_pickle_overriden_builtin_dataclass_same_name(create_module):
+    module1 = create_module(
+        # language=Python
+        """\
+import dataclasses
+import pydantic
+
+
+@dataclasses.dataclass
+class SameNameDataclass:
+    value: int
+
+class Model(pydantic.BaseModel):
+    dataclass: SameNameDataclass
+        """
+    )
+    module2 = create_module(
+        # language=Python
+        """\
+import dataclasses
+import pydantic
+
+
+@dataclasses.dataclass
+class SameNameDataclass:
+    value: str
+
+class Model(pydantic.BaseModel):
+    dataclass: SameNameDataclass
+        """
+    )
+    obj1 = module1.Model(dataclass=module1.SameNameDataclass(value=1))
+    obj2 = module2.Model(dataclass=module2.SameNameDataclass(value='a'))
+
+    restored1 = pickle.loads(pickle.dumps(obj1))
+    restored2 = pickle.loads(pickle.dumps(obj2))
+
+    assert restored1.dataclass.value == 1
+    assert restored2.dataclass.value == 'a'
+    assert type(restored1.dataclass) is type(obj1.dataclass)
+    assert type(restored2.dataclass) is type(obj2.dataclass)
