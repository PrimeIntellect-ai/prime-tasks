+// TestQPCleanerDoesNotWrapInsideEscape verifies that a soft line break at the
+// line limit leaves an encoded byte sequence intact.
+func TestQPCleanerDoesNotWrapInsideEscape(t *testing.T) {
+	input := append(bytes.Repeat([]byte{'a'}, 1024-2), 0x8a)
+	cleaner := coding.NewQPCleaner(bytes.NewReader(input))
+	var got []byte
+	buf := make([]byte, 2048)
+	for {
+		n, err := cleaner.Read(buf)
+		got = append(got, buf[:n]...)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		if n == 0 {
+			t.Fatal("Read returned no data while input remained")
+		}
+	}
+
+	if !bytes.Contains(got, []byte("=\r\n")) {
+		t.Fatal("cleaned output has no soft line break")
+	}
+	if !bytes.Contains(bytes.ToLower(got), []byte("=8a")) {
+		t.Fatalf("encoded byte was split by a soft line break: %q", got[len(got)-12:])
+	}
+}
+
+// TestQPCleanerFillsReadBuffer verifies Read returns all available cleaned
+// bytes when the destination has room for them.
+func TestQPCleanerFillsReadBuffer(t *testing.T) {
+	input := []byte("ordinary text")
+	cleaner := coding.NewQPCleaner(bytes.NewReader(input))
+	buf := make([]byte, len(input)+10)
+	n, err := cleaner.Read(buf)
+	if err != nil && err != io.EOF {
+		t.Fatal(err)
+	}
+	if n != len(input) {
+		t.Fatalf("Read returned %d bytes with %d bytes available and room for all of them", n, len(input))
+	}
+	if !bytes.Equal(buf[:n], input) {
+		t.Fatalf("Read returned %q, want %q", buf[:n], input)
+	}
+}
+
+// TestQPCleanerKeepsEscapeTogetherWhenItFits verifies a complete quoted-printable
+// escape is returned in one Read when the destination can hold it.
+func TestQPCleanerKeepsEscapeTogetherWhenItFits(t *testing.T) {
+	cleaner := coding.NewQPCleaner(strings.NewReader("=4Arest"))
+	buf := make([]byte, 3)
+	n, err := cleaner.Read(buf)
+	if err != nil && err != io.EOF {
+		t.Fatal(err)
+	}
+	if n < 3 || string(buf[:3]) != "=4A" {
+		t.Fatalf("Read returned %q (%d bytes), want the complete escape =4A", buf[:n], n)
+	}
+}
