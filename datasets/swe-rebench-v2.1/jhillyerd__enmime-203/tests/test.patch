+// TestQPCleanerLargeMessage verifies that a message whose quoted-printable bodies contain a very
+// long single line is parsed successfully, exposing its text, HTML and attachments.
+func TestQPCleanerLargeMessage(t *testing.T) {
+	longText := strings.Repeat("The quick brown fox. ", 600)
+	longHTML := "<html><body>" + strings.Repeat("Hello world! ", 600) + "</body></html>"
+	attData := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte("binarydata"), 100))
+
+	msg := "From: sender@example.com\r\n" +
+		"To: recipient@example.com\r\n" +
+		"Subject: Large single-line message\r\n" +
+		"MIME-Version: 1.0\r\n" +
+		"Content-Type: multipart/mixed; boundary=\"BOUNDARY\"\r\n" +
+		"\r\n" +
+		"--BOUNDARY\r\n" +
+		"Content-Type: text/plain; charset=utf-8\r\n" +
+		"Content-Transfer-Encoding: quoted-printable\r\n" +
+		"\r\n" +
+		longText + "\r\n" +
+		"--BOUNDARY\r\n" +
+		"Content-Type: text/html; charset=utf-8\r\n" +
+		"Content-Transfer-Encoding: quoted-printable\r\n" +
+		"\r\n" +
+		longHTML + "\r\n" +
+		"--BOUNDARY\r\n" +
+		"Content-Type: application/octet-stream; name=\"data.bin\"\r\n" +
+		"Content-Transfer-Encoding: base64\r\n" +
+		"Content-Disposition: attachment; filename=\"data.bin\"\r\n" +
+		"\r\n" +
+		attData + "\r\n" +
+		"--BOUNDARY--\r\n"
+
+	e, err := enmime.ReadEnvelope(bytes.NewBufferString(msg))
+	if err != nil {
+		t.Fatalf("ReadEnvelope() error: %v", err)
+	}
+	if !strings.Contains(e.Text, "The quick brown fox.") {
+		t.Errorf("Text does not contain the message body, got %d bytes", len(e.Text))
+	}
+	if !strings.Contains(e.HTML, "Hello world!") {
+		t.Errorf("HTML does not contain the message body, got %d bytes", len(e.HTML))
+	}
+	if len(e.Attachments) != 1 {
+		t.Errorf("len(Attachments) = %d, want 1", len(e.Attachments))
+	}
+}
