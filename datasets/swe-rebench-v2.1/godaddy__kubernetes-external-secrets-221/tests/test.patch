+
+  describe('poller integration', () => {
+    it('processes a dataFrom ExternalSecret without a versionStage', async () => {
+      const secretValueClient = {
+        getSecretValue: sinon.stub().returns({
+          promise: sinon.stub().resolves({ SecretString: '{"token":"secret-value"}' })
+        })
+      }
+      const backendLogger = { info: sinon.stub(), error: sinon.stub() }
+      const secretsManagerBackend = new SecretsManagerBackend({
+        clientFactory: sinon.stub().returns(secretValueClient),
+        assumeRole: sinon.stub(),
+        logger: backendLogger
+      })
+
+      const secrets = { post: sinon.stub().resolves({}) }
+      const namespace = {
+        get: sinon.stub().resolves({ body: { metadata: { annotations: {} } } }),
+        secrets: Object.assign(sinon.stub(), { post: secrets.post })
+      }
+      const status = {
+        get: sinon.stub().resolves({ body: { status: { observedGeneration: 0 } } }),
+        put: sinon.stub()
+      }
+      const pollCompleted = new Promise(resolve => {
+        status.put.callsFake(() => {
+          resolve()
+          return Promise.resolve({})
+        })
+      })
+      const externalSecrets = sinon.stub().returns({ status })
+      const logger = {
+        info: sinon.stub(),
+        debug: sinon.stub(),
+        error: sinon.stub()
+      }
+      const poller = new Poller({
+        backends: { secretsManager: secretsManagerBackend },
+        intervalMilliseconds: 1000,
+        kubeClient: {
+          api: { v1: { namespaces: sinon.stub().returns(namespace) } },
+          apis: {
+            'kubernetes-client.io': {
+              v1: { namespaces: sinon.stub().returns({ externalsecrets: externalSecrets }) }
+            }
+          }
+        },
+        logger,
+        metrics: { observeSync: sinon.stub() },
+        customResourceManifest: {
+          spec: { group: 'kubernetes-client.io', names: { plural: 'externalsecrets' } }
+        },
+        rolePermittedAnnotation: 'iam.amazonaws.com/permitted',
+        externalSecret: {
+          apiVersion: 'v1',
+          kind: 'ExternalSecret',
+          metadata: { namespace: 'default', name: 'example', uid: 'example-uid', generation: 1 },
+          spec: { backendType: 'secretsManager', dataFrom: ['source-secret'] }
+        }
+      })
+
+      poller.start()
+      await pollCompleted
+
+      expect(secrets.post.called).to.equal(true)
+      expect(status.put.firstCall.args[0].body.status.status).to.equal('SUCCESS')
+    })
+  })
