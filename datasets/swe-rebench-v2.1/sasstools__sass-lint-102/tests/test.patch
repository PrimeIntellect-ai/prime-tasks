+  //////////////////////////////
+  // Color Keyword
+  //////////////////////////////
+  it('color keyword', function (done) {
+    lintFile('color-keyword.scss', {
+      'options': {
+        'merge-default-rules': false
+      },
+      'rules': {
+        'color-keyword': 1
+      }
+    }, function (data) {
+      assert.ok(data.messages.some(function (message) {
+        return message.line === 2;
+      }));
+      assert.ok(data.messages.every(function (message) {
+        return message.line !== 19 && message.line !== 30;
+      }));
+      done();
+    });
+  });
