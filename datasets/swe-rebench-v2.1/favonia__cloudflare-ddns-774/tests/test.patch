+// TestUptimeKumaFailureReporting checks that a failed update is reported to
+// Uptime Kuma with the actual failure message, and never with "OK".
+func TestUptimeKumaFailureReporting(t *testing.T) {
+	t.Parallel()
+
+	for name, tc := range map[string]struct {
+		message string
+	}{
+		"actual-issue": {"context deadline exceeded"},
+		"empty":        {""},
+		"spaces":       {"   "},
+		"newline":      {"\n"},
+		"tab":          {"\t"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+
+			logger := pp.New(io.Discard)
+			msgCh := make(chan string, 1)
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				q, err := url.ParseQuery(r.URL.RawQuery)
+				if !assert.NoError(t, err) {
+					panic(http.ErrAbortHandler)
+				}
+				msgCh <- q.Get("msg")
+				if _, err := io.WriteString(w, `{"ok":true}`); !assert.NoError(t, err) {
+					panic(http.ErrAbortHandler)
+				}
+			}))
+			defer server.Close()
+
+			m, ok := monitor.NewUptimeKuma(logger, server.URL)
+			require.True(t, ok)
+			require.True(t, m.Failure(context.Background(), logger, tc.message))
+
+			gotMsg := <-msgCh
+			// A failed update must never be reported to Uptime Kuma as "OK".
+			assert.NotEqual(t, "OK", gotMsg)
+			// The message must not be empty or whitespace-only, because Uptime
+			// Kuma would otherwise fall back to showing "OK".
+			assert.NotEmpty(t, strings.TrimSpace(gotMsg))
+			// A non-empty failure message must be forwarded verbatim.
+			if strings.TrimSpace(tc.message) != "" {
+				assert.Equal(t, tc.message, gotMsg)
+			}
+		})
+	}
+}
