+
+func TestUnaryClientInterceptorDoesNotInspectMessageForSize(t *testing.T) {
+	clientConn, err := grpc.Dial("fake:connection", grpc.WithTransportCredentials(insecure.NewCredentials()))
+	require.NoError(t, err)
+	defer clientConn.Close()
+
+	sr := tracetest.NewSpanRecorder()
+	tp := trace.NewTracerProvider(trace.WithSpanProcessor(sr))
+	interceptor := otelgrpc.UnaryClientInterceptor(otelgrpc.WithTracerProvider(tp))
+	invoker := &mockUICInvoker{}
+
+	var callErr error
+	assert.NotPanics(t, func() {
+		callErr = interceptor(context.Background(), "/service/method", uninspectableMessage{}, &grpc_testing.SimpleResponse{}, clientConn, invoker.invoker)
+	})
+	assert.NoError(t, callErr)
+	span, ok := getSpanFromRecorder(sr, "service/method")
+	require.True(t, ok)
+	assert.Len(t, span.Events(), 2)
+}
