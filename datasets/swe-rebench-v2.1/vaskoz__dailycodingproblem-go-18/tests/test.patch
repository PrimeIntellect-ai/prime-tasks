+package day8
+
+import "testing"
+
+func testNode(value int, left, right *BinaryTree) *BinaryTree {
+	return &BinaryTree{value: value, left: left, right: right}
+}
+
+func TestUnivalSubtreeCounts(t *testing.T) {
+	tests := []struct {
+		name string
+		root *BinaryTree
+		want int
+	}{
+		{name: "empty tree", root: nil, want: 0},
+		{name: "single node", root: testNode(7, nil, nil), want: 1},
+		{
+			name: "problem example",
+			root: testNode(0,
+				testNode(1, nil, nil),
+				testNode(0,
+					testNode(1, testNode(1, nil, nil), testNode(1, nil, nil)),
+					testNode(0, nil, nil))),
+			want: 5,
+		},
+		{
+			name: "equal-valued tree",
+			root: testNode(4,
+				testNode(4, nil, nil),
+				testNode(4, testNode(4, nil, nil), nil)),
+			want: 4,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := CountUnivalSubtrees(tt.root); got != tt.want {
+				t.Errorf("CountUnivalSubtrees() = %d, want %d", got, tt.want)
+			}
+		})
+	}
+}
