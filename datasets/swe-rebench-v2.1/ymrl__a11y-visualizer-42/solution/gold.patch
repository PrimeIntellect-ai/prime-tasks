new file mode 100644
index 0000000..a4a0e79
--- /dev/null
+++ b/src/content/dom/getClosestByRoles.ts
@@ -0,0 +1,18 @@
+import { getKnownRole, KnownRole } from "./getKnownRole";
+
+export const getClosestByRoles = (
+  el: Element,
+  roles: KnownRole[],
+): Element | null => {
+  const parent = el.parentElement;
+  if (!parent) {
+    return null;
+  }
+  const role = getKnownRole(parent);
+  if (role) {
+    if (roles.includes(role)) {
+      return parent;
+    }
+  }
+  return getClosestByRoles(parent, roles);
+};
diff --git a/src/content/dom/getKnownRole.ts b/src/content/dom/getKnownRole.ts
