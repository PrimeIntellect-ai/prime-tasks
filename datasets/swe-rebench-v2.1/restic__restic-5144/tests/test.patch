+// testRunTagMayFail runs the tag command through its public command entry point
+// and returns everything the command wrote to stdout/stderr.
+func testRunTagMayFail(opts TagOptions, gopts GlobalOptions, args ...string) (string, error) {
+	prevOpts := tagOptions
+	prevGopts := globalOptions
+	defer func() {
+		tagOptions = prevOpts
+		globalOptions = prevGopts
+	}()
+
+	buf := bytes.NewBuffer(nil)
+	gopts.stdout = buf
+	gopts.stderr = buf
+	tagOptions = opts
+	globalOptions = gopts
+
+	cmdTag.SetContext(context.TODO())
+	err := cmdTag.RunE(cmdTag, args)
+	return buf.String(), err
+}
+
 func testRunTag(t testing.TB, opts TagOptions, gopts GlobalOptions) {
-	rtest.OK(t, runTag(context.TODO(), opts, gopts, []string{}))
+	_, err := testRunTagMayFail(opts, gopts)
+	rtest.OK(t, err)
 }
 
