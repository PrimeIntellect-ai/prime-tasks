+// TestTagReportsNewSnapshotID checks that modifying the tags of a snapshot
+// reports the previous and the resulting snapshot ID.
+func TestTagReportsNewSnapshotID(t *testing.T) {
+	env, cleanup := withTestEnvironment(t)
+	defer cleanup()
+
+	testSetupBackupData(t, env)
+	testRunBackup(t, "", []string{env.testdata}, BackupOptions{}, env.gopts)
+	newest, _ := testRunSnapshots(t, env.gopts)
+	if newest == nil {
+		t.Fatal("expected a new backup, got nil")
+	}
+	originalID := *newest.ID
+
+	gopts := env.gopts
+	gopts.verbosity = 2
+	out, err := testRunTagMayFail(TagOptions{AddTags: restic.TagLists{[]string{"NL"}}}, gopts)
+	rtest.OK(t, err)
+
+	newest, _ = testRunSnapshots(t, env.gopts)
+	if newest == nil {
+		t.Fatal("expected a backup, got nil")
+	}
+	newID := *newest.ID
+	rtest.Assert(t, newID != originalID, "expected the snapshot ID to change")
+
+	rtest.Assert(t, strings.Contains(out, newID.String()),
+		"expected the new snapshot ID %v in the output, got %q", newID, out)
+}
+
+// TestTagJSONOutput checks the JSON lines emitted for changed snapshots and the
+// trailing summary.
+func TestTagJSONOutput(t *testing.T) {
+	env, cleanup := withTestEnvironment(t)
+	defer cleanup()
+
+	testSetupBackupData(t, env)
+	testRunBackup(t, "", []string{env.testdata}, BackupOptions{}, env.gopts)
+	newest, _ := testRunSnapshots(t, env.gopts)
+	if newest == nil {
+		t.Fatal("expected a new backup, got nil")
+	}
+	originalID := *newest.ID
+
+	gopts := env.gopts
+	gopts.JSON = true
+	out, err := testRunTagMayFail(TagOptions{AddTags: restic.TagLists{[]string{"NL"}}}, gopts)
+	rtest.OK(t, err)
+
+	newest, _ = testRunSnapshots(t, env.gopts)
+	if newest == nil {
+		t.Fatal("expected a backup, got nil")
+	}
+	newID := *newest.ID
+	rtest.Assert(t, newID != originalID, "expected the snapshot ID to change")
+
+	var changed []map[string]interface{}
+	var summary map[string]interface{}
+	for _, line := range strings.Split(out, "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+		var obj map[string]interface{}
+		if err := json.Unmarshal([]byte(line), &obj); err != nil {
+			// ignore any non-JSON output the command may emit
+			continue
+		}
+		switch obj["message_type"] {
+		case "changed":
+			changed = append(changed, obj)
+		case "summary":
+			summary = obj
+		}
+	}
+
+	rtest.Assert(t, len(changed) == 1,
+		"expected exactly one changed message, got %v", changed)
+	rtest.Equals(t, originalID.String(), changed[0]["old_snapshot_id"])
+	rtest.Equals(t, newID.String(), changed[0]["new_snapshot_id"])
+
+	rtest.Assert(t, summary != nil, "expected a summary message, got none")
+	rtest.Equals(t, float64(1), summary["changed_snapshots"])
+}
