+
+describe('unresolved route definitions', () => {
+  const linter = new Linter();
+  linter.defineRule('no-shadow-route-definition', rule);
+
+  test.each([
+    'this.route(someVariable);',
+    "this.route('views', { path: someVariable })",
+  ])('does not fail while processing %s', (code) => {
+    const messages = linter.verify(code, {
+      parserOptions: {
+        ecmaVersion: 6,
+        sourceType: 'module',
+      },
+      rules: {
+        'no-shadow-route-definition': 'error',
+      },
+    });
+
+    expect(messages.some((message) => message.fatal)).toBe(false);
+  });
+});
