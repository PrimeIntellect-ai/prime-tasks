diff --git a/tests/lib/rules/no-invalid-regexp.ts b/tests/lib/rules/no-invalid-regexp.ts
new file mode 100644
index 0000000..3d0ec6e
--- /dev/null
+++ b/tests/lib/rules/no-invalid-regexp.ts
@@ -0,0 +1,50 @@
+import { RuleTester } from "eslint"
+// @ts-expect-error -- ignore
+import { rules } from "../../../lib/index"
+
+const tester = new RuleTester({
+    parserOptions: {
+        ecmaVersion: 2020,
+        sourceType: "module",
+    },
+})
+
+tester.run("no-invalid-regexp", rules["no-invalid-regexp"] as any, {
+    valid: [
+        `/regexp/`,
+        `RegExp("foo")`,
+        `new RegExp("foo")`,
+        `RegExp("foo", "z")`,
+        `RegExp("(" + ")")`,
+        `new RegExp("(" + ")")`,
+    ],
+    invalid: [
+        {
+            code: `RegExp("(")`,
+            errors: [{}],
+        },
+        {
+            code: `new RegExp("(")`,
+            errors: [
+                {
+                    message:
+                        "Invalid regular expression: /(/: Unterminated group",
+                    column: 13,
+                    endColumn: 14,
+                },
+            ],
+        },
+        {
+            code: `RegExp("(" + "(")`,
+            errors: [{}],
+        },
+        {
+            code: `new RegExp("(" + "")`,
+            errors: [{}],
+        },
+        {
+            code: `RegExp("[a-Z] some valid stuff")`,
+            errors: [{}],
+        },
+    ],
+})
