+
+  it('diff works on a formatted parse with a utc offset applied', () => {
+    const endTime = dayjs('2023/08/25 10:35', 'YYYY/MM/DD HH:mm').utcOffset(8, true)
+    const now = dayjs().utcOffset(8)
+    const expected = (Date.UTC(2023, 7, 25, 2, 35) - Date.now()) / 1000
+    const diff = endTime.diff(now, 'second')
+    expect(typeof diff).toBe('number')
+    expect(Math.abs(diff - expected)).toBeLessThan(2)
+  })
 })
