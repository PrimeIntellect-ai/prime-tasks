diff --git a/lib/cypressTagsHelpers.test.js b/lib/cypressTagsHelpers.test.js
new file mode 100644
index 0000000..0af39a5
--- /dev/null
+++ b/lib/cypressTagsHelpers.test.js
@@ -0,0 +1,42 @@
+/* eslint-disable global-require */
+/* global Then */
+const { createTestsFromFeature } = require("./createTestsFromFeature");
+
+const executedRows = [];
+
+Then(/^the row "(.+)" is executed$/, (rowName) => {
+  executedRows.push(rowName);
+});
+
+const featureWithTaggedExamples = `Feature: Tagged example tables
+
+  Scenario Outline: Example tables with different tags
+    When the row "<name>" is executed
+
+    @smoke
+    Examples:
+      | name       |
+      | smoke-one  |
+      | smoke-two  |
+
+    @regression
+    Examples:
+      | name           |
+      | regression-one |
+`;
+
+describe("Examples blocks tagged with the selected tag", () => {
+  window.Cypress = {
+    ...window.Cypress,
+    env: () => "@smoke",
+  };
+
+  createTestsFromFeature(
+    "tagged-examples.feature",
+    Buffer.from(featureWithTaggedExamples)
+  );
+
+  it("executes only the rows of the Examples blocks carrying the selected tag", () => {
+    expect(executedRows).to.have.members(["smoke-one", "smoke-two"]);
+  });
+});
