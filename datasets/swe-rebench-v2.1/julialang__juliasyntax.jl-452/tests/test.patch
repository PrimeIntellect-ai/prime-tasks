+@testset "GreenNode equality" begin
+    x = JuliaSyntax.parsestmt(JuliaSyntax.GreenNode, "f(x) = x + 2")
+    y = JuliaSyntax.parsestmt(JuliaSyntax.GreenNode, "f(x) = x + 2")
+    z = JuliaSyntax.parsestmt(JuliaSyntax.GreenNode, "f(x) = 2 + x")
+    @test x == y
+    @test x != z
+    @test y != z
+end
+
+@testset "GreenNode hashing" begin
+    x = hash(JuliaSyntax.parsestmt(JuliaSyntax.GreenNode, "f(x) = x + 2"))::UInt
+    y = hash(JuliaSyntax.parsestmt(JuliaSyntax.GreenNode, "f(x) = x + 2"))::UInt
+    z = hash(JuliaSyntax.parsestmt(JuliaSyntax.GreenNode, "f(x) = 2 + x"))::UInt
+    @test x == y # Correctness
+    @test x != z # Collision
+    @test y != z # Collision
+end
+
+@testset "GreenNode as Dict key" begin
+    x = JuliaSyntax.parsestmt(JuliaSyntax.GreenNode, "f(x) = x + 2")
+    y = JuliaSyntax.parsestmt(JuliaSyntax.GreenNode, "f(x) = x + 2")
+    d = Dict(x => 1)
+    @test d[y] == 1
+end
