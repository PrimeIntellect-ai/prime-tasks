+def test_missing_description_file(capsys):
+    ini_file = samples_dir / 'missing-description-file.toml'
+    try:
+        flit_main(['--ini-file', str(ini_file), 'build', '--format', 'sdist'])
+    except SystemExit as exc:
+        exit_message = str(exc)
+    else:
+        exit_message = ''
+
+    captured = capsys.readouterr()
+    diagnostic = exit_message + captured.out + captured.err
+    assert 'definitely-missing.rst' in diagnostic
+    assert 'Traceback' not in diagnostic
