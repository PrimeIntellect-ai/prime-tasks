+package day384
+
+import "testing"
+
+// nolint
+var testcases = []struct {
+	denom         []int
+	target        int
+	expectedCoins int
+	expectError   bool
+}{
+	{[]int{1, 5, 10}, 56, 7, false},
+	{[]int{5, 8}, 15, 3, false},
+	{[]int{5, 10}, 2, 0, true},
+}
+
+func TestFewestCoinsBrute(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range testcases {
+		res, err := FewestCoinsBrute(tc.denom, tc.target)
+		if tc.expectError {
+			if err == nil {
+				t.Errorf("Expected no-solution error for denominations %v and target %v", tc.denom, tc.target)
+			}
+			continue
+		}
+		if err != nil || res != tc.expectedCoins {
+			t.Errorf("Expected %v coins without error, got (%v,%v)", tc.expectedCoins, res, err)
+		}
+	}
+}
+
+func BenchmarkFewestCoinsBrute(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			FewestCoinsBrute(tc.denom, tc.target) // nolint
+		}
+	}
+}
