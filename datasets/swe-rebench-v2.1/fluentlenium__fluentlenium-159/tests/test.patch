+    private SubTestPageWithTwoParameters createAndInitializeParameterizedPage() {
+        SubTestPageWithTwoParameters page = new SubTestPageWithTwoParameters("buttonId", "expected title");
+        for (Method method : getClass().getMethods()) {
+            String name = method.getName().toLowerCase();
+            if (!(name.contains("create") || name.contains("init") || name.contains("inject"))
+                    || method.getParameterTypes().length != 1
+                    || !method.getParameterTypes()[0].isAssignableFrom(page.getClass())) {
+                continue;
+            }
+            try {
+                Object initialized = method.invoke(this, page);
+                return initialized instanceof SubTestPageWithTwoParameters
+                        ? (SubTestPageWithTwoParameters) initialized : page;
+            } catch (Exception e) {
+                throw new AssertionError("Unable to initialize the constructed page", e);
+            }
+        }
+        for (Method method : getClass().getMethods()) {
+            if (!method.getName().equals("createPage") || method.getParameterTypes().length != 2
+                    || method.getParameterTypes()[0] != Class.class
+                    || !method.getParameterTypes()[1].isArray()) {
+                continue;
+            }
+            try {
+                Object initialized = method.invoke(this, new Object[]{SubTestPageWithTwoParameters.class,
+                        new Object[]{"buttonId", "expected title"}});
+                return (SubTestPageWithTwoParameters) initialized;
+            } catch (Exception e) {
+                throw new AssertionError("Unable to create the parameterized page", e);
+            }
+        }
+        return page;
     }
