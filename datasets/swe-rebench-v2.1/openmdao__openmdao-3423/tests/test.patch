diff --git a/openmdao/code_review/test_common_problems.py b/openmdao/code_review/test_common_problems.py
new file mode 100644
index 000000000..f0fb1d1d8
--- /dev/null
+++ b/openmdao/code_review/test_common_problems.py
@@ -0,0 +1,51 @@
+import pickle
+import unittest
+
+import openmdao.api as om
+from openmdao.utils.assert_utils import assert_near_equal
+
+
+class _SerializationExplicitComp(om.ExplicitComponent):
+    def setup(self):
+        self.add_input('x', 1.0)
+        self.add_output('y', 1.0)
+
+    def compute(self, inputs, outputs):
+        outputs['y'] = 2.0 * inputs['x']
+
+
+class _SerializationImplicitComp(om.ImplicitComponent):
+    def setup(self):
+        self.add_input('x', 1.0)
+        self.add_output('y', 1.0)
+        self.declare_partials('y', 'x', val=2.0)
+        self.declare_partials('y', 'y', val=1.0)
+
+    def apply_nonlinear(self, inputs, outputs, residuals):
+        residuals['y'] = outputs['y'] - 2.0 * inputs['x']
+
+
+class TestComponentSerialization(unittest.TestCase):
+    def test_pickled_explicit_component_runs(self):
+        # A component that has been serialized (pickled) and restored must still
+        # be usable in a model, i.e. its undefined attributes must be recognized.
+        comp = pickle.loads(pickle.dumps(_SerializationExplicitComp()))
+        prob = om.Problem()
+        prob.model.add_subsystem('comp', comp)
+        prob.setup()
+        prob.run_model()
+        assert_near_equal(prob.get_val('comp.y'), [2.0])
+
+    def test_pickled_implicit_component_runs(self):
+        comp = pickle.loads(pickle.dumps(_SerializationImplicitComp()))
+        prob = om.Problem()
+        prob.model.add_subsystem('comp', comp)
+        prob.model.nonlinear_solver = om.NewtonSolver(solve_subsystems=False)
+        prob.model.linear_solver = om.DirectSolver()
+        prob.setup()
+        prob.run_model()
+        assert_near_equal(prob.get_val('comp.y'), [2.0])
+
+
+if __name__ == '__main__':
+    unittest.main()
