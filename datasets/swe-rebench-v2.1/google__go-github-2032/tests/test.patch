+func TestWebHookPayloadDocumentationMarksDeprecation(t *testing.T) {
+	output, err := exec.Command("go", "doc", "WebHookPayload").CombinedOutput()
+	if err != nil {
+		t.Fatalf("go doc WebHookPayload: %v\n%s", err, output)
+	}
+	doc := string(output)
+	if !strings.Contains(doc, "Deprecated:") || !strings.Contains(doc, "PushEvent") {
+		t.Errorf("WebHookPayload documentation should mark it deprecated and direct users to PushEvent; got:\n%s", doc)
+	}
+}
+
+func TestDeprecatedWebHookTypesAreAliases(t *testing.T) {
+	if got, want := reflect.TypeOf(WebHookPayload{}), reflect.TypeOf(PushEvent{}); got != want {
+		t.Errorf("WebHookPayload type = %v, want %v", got, want)
+	}
+	if got, want := reflect.TypeOf(WebHookCommit{}), reflect.TypeOf(HeadCommit{}); got != want {
+		t.Errorf("WebHookCommit type = %v, want %v", got, want)
+	}
+	if got, want := reflect.TypeOf(WebHookAuthor{}), reflect.TypeOf(CommitAuthor{}); got != want {
+		t.Errorf("WebHookAuthor type = %v, want %v", got, want)
+	}
+}
