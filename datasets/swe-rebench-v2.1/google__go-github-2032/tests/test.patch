+func TestPushEvent_GetAction(t *testing.T) {
+	actionField := reflect.ValueOf(&PushEvent{}).Elem().FieldByName("Action")
+	if !actionField.IsValid() {
+		t.Fatal("PushEvent does not expose an Action field")
+	}
+	method, ok := reflect.TypeOf((*PushEvent)(nil)).MethodByName("GetAction")
+	if !ok {
+		t.Fatal("*PushEvent does not expose GetAction")
+	}
+	call := func(receiver *PushEvent) string {
+		result := reflect.ValueOf(receiver).MethodByName(method.Name).Call(nil)
+		return result[0].String()
+	}
+
+	value := "published"
+	p := &PushEvent{}
+	field := reflect.ValueOf(p).Elem().FieldByName("Action")
+	field.Set(reflect.ValueOf(&value))
+	if got := call(p); got != value {
+		t.Errorf("GetAction() = %q, want %q", got, value)
+	}
+	if got := call(&PushEvent{}); got != "" {
+		t.Errorf("GetAction() with nil Action = %q, want empty string", got)
+	}
+	var nilEvent *PushEvent
+	if got := call(nilEvent); got != "" {
+		t.Errorf("GetAction() on nil receiver = %q, want empty string", got)
+	}
+}
