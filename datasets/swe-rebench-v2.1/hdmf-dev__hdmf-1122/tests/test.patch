+class TestSpecArgumentContract(TestCase):
+    """The inheritance/override checks take a Spec object rather than a name string."""
+
+    def setUp(self):
+        self.def_group_spec = GroupSpec(
+            doc='A test group',
+            name='root',
+            data_type_def='MyGroup',
+            attributes=[AttributeSpec('attribute1', 'my first attribute', 'text'),
+                        AttributeSpec('attribute2', 'my second attribute', 'text')]
+        )
+        self.inc_group_spec = GroupSpec(
+            doc='A test group',
+            name='root',
+            data_type_inc='MyGroup',
+            attributes=[AttributeSpec('attribute2', 'my second attribute', 'text', value='fixed'),
+                        AttributeSpec('attribute3', 'my third attribute', 'text', value='fixed')]
+        )
+        self.inc_group_spec.resolve_spec(self.def_group_spec)
+
+    def test_base_is_inherited_spec_rejects_name_string(self):
+        spec = BaseStorageSpec(doc='a storage spec', name='root',
+                               attributes=[AttributeSpec('attribute1', 'my first attribute', 'text')])
+        with self.assertRaises(TypeError):
+            spec.is_inherited_spec('attribute1')
+
+    def test_base_is_overridden_spec_rejects_name_string(self):
+        spec = BaseStorageSpec(doc='a storage spec', name='root',
+                               attributes=[AttributeSpec('attribute1', 'my first attribute', 'text')])
+        with self.assertRaises(TypeError):
+            spec.is_overridden_spec('attribute1')
+
+    def test_group_is_inherited_spec_rejects_name_string(self):
+        with self.assertRaises(TypeError):
+            self.inc_group_spec.is_inherited_spec('attribute1')
+
+    def test_group_is_overridden_spec_rejects_name_string(self):
+        with self.assertRaises(TypeError):
+            self.inc_group_spec.is_overridden_spec('attribute2')
+
+    def test_base_is_inherited_spec_unknown_spec_returns_false(self):
+        spec = BaseStorageSpec(doc='a storage spec', name='root',
+                               attributes=[AttributeSpec('attribute1', 'my first attribute', 'text')])
+        other = BaseStorageSpec(doc='another storage spec', name='other',
+                                attributes=[AttributeSpec('attribute9', 'another attribute', 'text')])
+        self.assertFalse(spec.is_inherited_spec(other.attributes[0]))
+
+    def test_base_is_overridden_spec_unknown_spec_returns_false(self):
+        spec = BaseStorageSpec(doc='a storage spec', name='root',
+                               attributes=[AttributeSpec('attribute1', 'my first attribute', 'text')])
+        other = BaseStorageSpec(doc='another storage spec', name='other',
+                                attributes=[AttributeSpec('attribute9', 'another attribute', 'text')])
+        self.assertFalse(spec.is_overridden_spec(other.attributes[0]))
+
+    def test_group_is_inherited_spec_unknown_spec_returns_false(self):
+        other = GroupSpec(doc='another group', data_type_def='OtherGroup',
+                          attributes=[AttributeSpec('attribute9', 'another attribute', 'text')])
+        self.assertFalse(self.def_group_spec.is_inherited_spec(other.attributes[0]))
+
+    def test_group_is_overridden_spec_unknown_spec_returns_false(self):
+        other = GroupSpec(doc='another group', data_type_def='OtherGroup',
+                          attributes=[AttributeSpec('attribute9', 'another attribute', 'text')])
+        self.assertFalse(self.def_group_spec.is_overridden_spec(other.attributes[0]))
+
+    def test_group_is_overridden_spec_unnamed_link_returns_false(self):
+        spec = GroupSpec(doc='a group', data_type_def='MyGroup',
+                         links=[LinkSpec(doc='a link', target_type='TargetType')])
+        self.assertFalse(spec.is_overridden_spec(spec.links[0]))
