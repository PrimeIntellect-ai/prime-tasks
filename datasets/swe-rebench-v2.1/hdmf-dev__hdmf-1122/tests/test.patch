+class TestGroupLevelSpecClassification(TestCase):
+
+    def test_inherited_group_level_components(self):
+        parent = GroupSpec(
+            doc='parent type',
+            data_type_def='ParentType',
+            groups=[
+                GroupSpec(doc='named subgroup', name='subgroup'),
+                GroupSpec(doc='standalone data type', data_type_def='StandaloneGroupType'),
+            ],
+            datasets=[
+                DatasetSpec('named dataset', 'int', name='values'),
+                DatasetSpec('standalone dataset type', 'int', data_type_def='StandaloneDatasetType'),
+            ],
+            links=[
+                LinkSpec(doc='named link', name='reference', target_type='ReferenceType'),
+                LinkSpec(doc='target type', target_type='StandaloneTargetType'),
+            ],
+        )
+        child = GroupSpec(doc='child type', data_type_def='ChildType', data_type_inc='ParentType')
+        child.resolve_spec(parent)
+
+        overridable_inherited = (
+            child.get_group('subgroup'),
+            child.get_dataset('values'),
+            child.get_link('reference'),
+        )
+        for component in overridable_inherited:
+            with self.subTest(component=component):
+                self.assertIs(child.is_inherited_spec(component), True)
+                self.assertIs(child.is_overridden_spec(component), False)
+
+        inherited_types = (
+            child.get_data_type('StandaloneGroupType'),
+            child.get_data_type('StandaloneDatasetType'),
+            child.get_target_type('StandaloneTargetType'),
+        )
+        for component in inherited_types:
+            with self.subTest(component=component):
+                self.assertIs(child.is_inherited_spec(component), True)
+                self.assertIsInstance(child.is_overridden_spec(component), bool)
+
+    def test_overridden_named_group_level_components(self):
+        parent = GroupSpec(
+            doc='parent type',
+            data_type_def='ParentType',
+            groups=[GroupSpec(doc='parent subgroup', name='subgroup')],
+            datasets=[DatasetSpec('parent dataset', 'int', name='values')],
+            links=[LinkSpec(doc='parent link', name='reference', target_type='ReferenceType')],
+        )
+        child = GroupSpec(
+            doc='child type',
+            data_type_def='ChildType',
+            data_type_inc='ParentType',
+            groups=[GroupSpec(doc='overridden subgroup', name='subgroup')],
+            datasets=[DatasetSpec('overridden dataset', 'float', name='values')],
+            links=[LinkSpec(doc='overridden link', name='reference', target_type='ChildReferenceType')],
+        )
+        child.resolve_spec(parent)
+
+        overridden = (child.get_group('subgroup'), child.get_dataset('values'), child.get_link('reference'))
+        for component in overridden:
+            with self.subTest(component=component):
+                self.assertIs(child.is_inherited_spec(component), True)
+                self.assertIs(child.is_overridden_spec(component), True)
