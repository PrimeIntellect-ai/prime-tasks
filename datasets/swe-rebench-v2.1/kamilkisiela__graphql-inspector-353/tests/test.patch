diff --git a/packages/core/__tests__/coverage/coverage.ts b/packages/core/__tests__/coverage/coverage.ts
index 6f987c6..af3e9e5 100644
--- a/packages/core/__tests__/coverage/coverage.ts
+++ b/packages/core/__tests__/coverage/coverage.ts
@@ -33,6 +33,7 @@ describe('coverage', () => {
       query getPost {
         post {
           id
+          __typename
           title
         }
       }
@@ -64,4 +65,61 @@ describe('coverage', () => {
     expect(results.types.Identifiable.children.id.hits).toEqual(1);
     expect(results.types.Identifiable.children.createdAt.hits).toEqual(0);
   });
+
+  test('ignores __typename in coverage accounting', () => {
+    const schema = buildSchema(/* GraphQL */ `
+      type Query {
+        value: String
+      }
+    `);
+    const query = gql`
+      query {
+        __typename
+        value
+      }
+    `;
+
+    const results = coverage(schema, [new Source(print(query))]);
+
+    expect(results.types.Query.hits).toEqual(1);
+    expect(results.types.Query.children.value.hits).toEqual(1);
+  });
+
+  test('ignores nested __typename while counting nested fields', () => {
+    const schema = buildSchema(/* GraphQL */ `
+      type Query {
+        container: Container
+      }
+
+      type Container {
+        label: String
+        nested: Nested
+      }
+
+      type Nested {
+        value: String
+      }
+    `);
+    const query = gql`
+      query {
+        container {
+          label
+          nested {
+            __typename
+            value
+          }
+        }
+      }
+    `;
+
+    const results = coverage(schema, [new Source(print(query))]);
+
+    expect(results.types.Query.hits).toEqual(1);
+    expect(results.types.Query.children.container.hits).toEqual(1);
+    expect(results.types.Container.hits).toEqual(2);
+    expect(results.types.Container.children.label.hits).toEqual(1);
+    expect(results.types.Container.children.nested.hits).toEqual(1);
+    expect(results.types.Nested.hits).toEqual(1);
+    expect(results.types.Nested.children.value.hits).toEqual(1);
+  });
 });
