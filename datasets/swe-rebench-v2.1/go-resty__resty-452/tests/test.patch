+func TestSetHeaderMultipleValueBehavior(t *testing.T) {
+	ts := createPostServer(t)
+	defer ts.Close()
+
+	r := dclr()
+	r2 := r.SetHeaderMultiValues(map[string][]string{
+		"Content":       []string{"text/*", "text/html", "*"},
+		"Authorization": []string{"Bearer xyz"},
+	})
+	if r != r2 {
+		t.Errorf("SetHeaderMultiValues should return the same *Request to allow chaining")
+	}
+	assertEqual(t, "text/*, text/html, *", r.Header.Get("content"))
+	assertEqual(t, "Bearer xyz", r.Header.Get("authorization"))
+
+	// an existing header value must be overridden, not appended to
+	r.SetHeader("Content", "application/json")
+	r.SetHeaderMultiValues(map[string][]string{
+		"Content": []string{"text/plain", "text/css"},
+	})
+	assertEqual(t, "text/plain, text/css", r.Header.Get("content"))
+
+	// The standard library's named http.Header type is accepted directly.
+	standardHeaders := http.Header{
+		"X-Multi-Value": []string{"first", "second"},
+	}
+	r.SetHeaderMultiValues(standardHeaders)
+	assertEqual(t, "first, second", r.Header.Get("X-Multi-Value"))
+}
