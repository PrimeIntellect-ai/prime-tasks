+it('caches errored query results correctly', () => {
+  output.mockReturnValueOnce({
+    ...queryResponse,
+    data: null,
+    error: new CombinedError({
+      graphQLErrors: ['Oh no!'],
+    }),
+  });
+
+  const ssr = ssrExchange();
+  const { source: ops$, next } = input;
+  const exchange = ssr(exchangeInput)(ops$);
+
+  publish(exchange);
+  next(queryOperation);
+
+  const data = ssr.extractData();
+  expect(Object.keys(data)).toEqual(['' + queryOperation.key]);
+
+  // The cache entry must retain the error so that it can be rehydrated later.
+  // The exact serialized representation is an implementation detail and is
+  // intentionally not asserted here.
+  expect(data[queryOperation.key].data).toBe(null);
+  expect(data[queryOperation.key].error).toBeDefined();
+});
+
+it('rehydrates a cached GraphQL error into an equivalent CombinedError', () => {
+  output.mockReturnValueOnce({
+    ...queryResponse,
+    data: null,
+    error: new CombinedError({
+      graphQLErrors: ['Oh no!'],
+    }),
+  });
+
+  // Serialize on the server.
+  const server = ssrExchange();
+  const serverInput = makeSubject<Operation>();
+  const serverExchange = server(exchangeInput)(serverInput.source);
+  publish(serverExchange);
+  serverInput.next(queryOperation);
+
+  const serialized = server.extractData();
+
+  // Rehydrate on the client.
+  const onPush = jest.fn();
+  const clientSsr = ssrExchange({ initialState: serialized, isClient: true });
+  const clientInput = makeSubject<Operation>();
+  const clientExchange = clientSsr(exchangeInput)(clientInput.source);
+  pipe(clientExchange, forEach(onPush));
+  clientInput.next(queryOperation);
+
+  expect(onPush).toHaveBeenCalled();
+  const result = onPush.mock.calls[0][0];
+  expect(result.error).toBeInstanceOf(CombinedError);
+  // The rehydrated error must match the browser-side representation rather
+  // than degrading into `[Network] undefined`.
+  expect(result.error.toString()).toBe('[GraphQL] Oh no!');
+  expect(result.error.networkError).toBeUndefined();
+  expect(result.error.graphQLErrors.map((x: any) => x.message)).toEqual([
+    'Oh no!',
+  ]);
+});
+
+it('rehydrates a cached network error into an equivalent CombinedError', () => {
+  output.mockReturnValueOnce({
+    ...queryResponse,
+    data: null,
+    error: new CombinedError({
+      networkError: new Error('Oops!'),
+    }),
+  });
+
+  const server = ssrExchange();
+  const serverInput = makeSubject<Operation>();
+  const serverExchange = server(exchangeInput)(serverInput.source);
+  publish(serverExchange);
+  serverInput.next(queryOperation);
+
+  const serialized = server.extractData();
+
+  const onPush = jest.fn();
+  const clientSsr = ssrExchange({ initialState: serialized, isClient: true });
+  const clientInput = makeSubject<Operation>();
+  const clientExchange = clientSsr(exchangeInput)(clientInput.source);
+  pipe(clientExchange, forEach(onPush));
+  clientInput.next(queryOperation);
+
+  expect(onPush).toHaveBeenCalled();
+  const result = onPush.mock.calls[0][0];
+  expect(result.error).toBeInstanceOf(CombinedError);
+  expect(result.error.toString()).toContain('Oops!');
+  expect(result.error.networkError).toBeInstanceOf(Error);
+  expect(result.error.networkError.message).toContain('Oops!');
+});
+
