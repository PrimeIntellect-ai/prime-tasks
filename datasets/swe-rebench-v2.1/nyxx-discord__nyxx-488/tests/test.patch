+  test('Guild template convenience methods perform their matching operation',
+      () async {
+    nock.init();
+
+    final client = MockNyxx();
+    when(() => client.apiOptions)
+        .thenReturn(RestApiOptions(token: 'TEST_TOKEN'));
+    when(() => client.options).thenReturn(RestClientOptions());
+    when(() => client.httpHandler).thenReturn(HttpHandler(client));
+
+    final apiUrl = 'https://discord.com/api/v${client.apiOptions.apiVersion}';
+    final fetchTemplate = nock(apiUrl).get('/guilds/templates/test')
+      ..reply(200, jsonEncode(sampleGuildTemplate));
+    const useIcon = ImageBuilder.png([1, 2, 3]);
+    final createGuild = nock(apiUrl).post('/guilds/templates/hgM48av5Q69A', {
+      'name': 'A new guild',
+      'icon': useIcon.build(),
+    })
+      ..reply(200, jsonEncode(sampleGuild));
+    const managerIcon = ImageBuilder.png([4, 5, 6]);
+    final createGuildDirectly =
+        nock(apiUrl).post('/guilds/templates/hgM48av5Q69A', {
+      'name': 'Created directly',
+      'icon': managerIcon.build(),
+    })
+          ..reply(200, jsonEncode(sampleGuild));
+    final refetchTemplate = nock(apiUrl).get('/guilds/templates/hgM48av5Q69A')
+      ..reply(200, jsonEncode(sampleGuildTemplate));
+    final syncTemplate = nock(apiUrl)
+        .put('/guilds/678070694164299796/templates/hgM48av5Q69A')
+      ..reply(200, jsonEncode(sampleGuildTemplate));
+    final updateTemplate = nock(apiUrl)
+        .patch('/guilds/678070694164299796/templates/hgM48av5Q69A', (_) => true)
+      ..reply(200, jsonEncode(sampleGuildTemplate));
+    final deleteTemplate = nock(apiUrl)
+        .delete('/guilds/678070694164299796/templates/hgM48av5Q69A')
+      ..reply(200, jsonEncode(sampleGuildTemplate));
+
+    final manager =
+        GuildManager(CacheConfig(), client, banConfig: const CacheConfig());
+    final template = await manager.fetchGuildTemplate('test');
+    expect(template.manager, same(manager));
+    final manuallyCreatedTemplate = GuildTemplate(
+      code: template.code,
+      manager: manager,
+      name: template.name,
+      description: template.description,
+      usageCount: template.usageCount,
+      creatorId: template.creatorId,
+      creator: template.creator,
+      createdAt: template.createdAt,
+      updatedAt: template.updatedAt,
+      sourceGuildId: template.sourceGuildId,
+      serializedSourceGuild: template.serializedSourceGuild,
+      isDirty: template.isDirty,
+    );
+    expect(manuallyCreatedTemplate.manager, same(manager));
+    expect(manuallyCreatedTemplate.code, equals(template.code));
+
+    expect((await template.use(name: 'A new guild', icon: useIcon)).name,
+        equals(sampleGuild['name']));
+    expect(
+      (await manager.createGuildFromTemplate('hgM48av5Q69A',
+              name: 'Created directly', icon: managerIcon))
+          .name,
+      equals(sampleGuild['name']),
+    );
+    expect((await template.fetch()).code, equals('hgM48av5Q69A'));
+    expect((await template.sync()).code, equals('hgM48av5Q69A'));
+    expect(
+        (await template.update(GuildTemplateUpdateBuilder(name: 'Updated')))
+            .code,
+        equals('hgM48av5Q69A'));
+    expect((await template.delete()).code, equals('hgM48av5Q69A'));
+
+    expect(fetchTemplate.isDone, isTrue);
+    expect(createGuild.isDone, isTrue);
+    expect(createGuildDirectly.isDone, isTrue);
+    expect(refetchTemplate.isDone, isTrue);
+    expect(syncTemplate.isDone, isTrue);
+    expect(updateTemplate.isDone, isTrue);
+    expect(deleteTemplate.isDone, isTrue);
+    nock.cleanAll();
+  });
+
+  test('guild template builders include supplied fields in their payloads', () {
+    expect(
+      GuildTemplateBuilder(name: 'A template', description: 'A description')
+          .build(),
+      equals({'name': 'A template', 'description': 'A description'}),
+    );
+    expect(
+      GuildTemplateUpdateBuilder(name: 'Renamed', description: 'Changed')
+          .build(),
+      equals({'name': 'Renamed', 'description': 'Changed'}),
+    );
+  });
 }
