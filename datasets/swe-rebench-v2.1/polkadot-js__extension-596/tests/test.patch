+
+describe('Add menu', () => {
+  const mountMenu = (master?: AccountJson): ReactWrapper => mount(
+    <MemoryRouter initialEntries={ ['/'] }>
+      <AccountContext.Provider value={{ accounts, hierarchy: buildHierarchy(accounts), master }}>
+        <ThemeProvider theme={themes.dark}>
+          <MenuAdd reference={{ current: null }}/>
+          <Route render={({ location }) => <div data-current-path={location.pathname}/>}/>
+        </ThemeProvider>
+      </AccountContext.Provider>
+    </MemoryRouter>
+  );
+
+  const destinationsFromMenu = (wrapper: ReactWrapper): string[] => wrapper
+    .findWhere((node) => node.is('a') || node.is('button') || node.prop('role') === 'button')
+    .map((entry) => {
+      (entry.getDOMNode() as HTMLElement).click();
+      wrapper.update();
+
+      return wrapper.find('[data-current-path]').prop('data-current-path') as string;
+    });
+
+  it('offers a dedicated entry that opens account creation', () => {
+    const wrapper = mountMenu(accounts[1]);
+    const destinations = destinationsFromMenu(wrapper);
+
+    expect(destinations).toContain('/account/create');
+  });
+
+  it('offers a separate entry that opens derivation from the master account', () => {
+    const wrapper = mountMenu(accounts[1]);
+    const destinations = destinationsFromMenu(wrapper);
+
+    expect(destinations).toContain(`/account/derive/${accounts[1].address}`);
+  });
+});
