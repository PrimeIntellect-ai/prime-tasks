+// logLevelOptions returns the kong options required to parse a charmbracelet
+// log level (used by the --on-unmatched flag) in the test harness.
+func logLevelOptions() []kong.Option {
+	return []kong.Option{
+		kong.TypeMapper(reflect.TypeOf(log.DebugLevel), kong.MapperFunc(func(ctx *kong.DecodeContext, target reflect.Value) error {
+			token, err := ctx.Scan.PopValue("string")
+			if err != nil {
+				return err
+			}
+			str, ok := token.Value.(string)
+			if !ok {
+				return fmt.Errorf("expected a string but got %q (%T)", token, token.Value)
+			}
+			level, err := log.ParseLevel(str)
+			if err != nil {
+				return fmt.Errorf("failed to parse '%v' as log level: %w", level, err)
+			}
+			target.Set(reflect.ValueOf(level))
+			return nil
+		})),
+	}
+}
