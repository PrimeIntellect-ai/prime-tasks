+func TestOnUnmatched(t *testing.T) {
+	as := require.New(t)
+
+	// capture current cwd, so we can replace it after the test is finished
+	cwd, err := os.Getwd()
+	as.NoError(err)
+
+	t.Cleanup(func() {
+		as.NoError(os.Chdir(cwd))
+	})
+
+	tempDir := t.TempDir()
+
+	// files matched by the configured formatter
+	matched := []string{"a.py", "b.py"}
+	// files that do not match any formatter
+	unmatched := []string{"c.txt", "d.md", "e.json"}
+
+	for _, name := range append(append([]string{}, matched...), unmatched...) {
+		as.NoError(os.WriteFile(filepath.Join(tempDir, name), []byte("hello"), 0o644))
+	}
+
+	configPath := filepath.Join(tempDir, "treefmt.toml")
+	test.WriteConfig(t, configPath, config.Config{
+		Formatters: map[string]*config.Formatter{
+			"py": {
+				Command:  "touch",
+				Includes: []string{"*.py"},
+			},
+		},
+	})
+
+	// fatal aborts on the first unmatched path with an error
+	_, err = cmd(t, "-C", tempDir, "--config-file", configPath, "--on-unmatched", "fatal")
+	as.ErrorContains(err, "no formatter for path:")
+
+	checkOutput := func(level string, output []byte) {
+		for _, p := range unmatched {
+			as.Contains(string(output), fmt.Sprintf("%s format: no formatter for path: %s/%s", level, tempDir, p))
+		}
+	}
+
+	// default is warn
+	out, err := cmd(t, "-C", tempDir, "--config-file", configPath, "-c")
+	as.NoError(err)
+	checkOutput("WARN", out)
+
+	out, err = cmd(t, "-C", tempDir, "--config-file", configPath, "-c", "--on-unmatched", "warn")
+	as.NoError(err)
+	checkOutput("WARN", out)
+
+	out, err = cmd(t, "-C", tempDir, "--config-file", configPath, "-c", "-u", "error")
+	as.NoError(err)
+	checkOutput("ERRO", out)
+
+	out, err = cmd(t, "-C", tempDir, "--config-file", configPath, "-c", "-v", "--on-unmatched", "info")
+	as.NoError(err)
+	checkOutput("INFO", out)
+
+	out, err = cmd(t, "-C", tempDir, "--config-file", configPath, "-c", "-vv", "-u", "debug")
+	as.NoError(err)
+	checkOutput("DEBU", out)
+}
