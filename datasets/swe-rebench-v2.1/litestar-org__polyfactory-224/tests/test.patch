+++ b/tests/test_provider_map.py
@@ -0,0 +1,37 @@
+from dataclasses import dataclass
+from datetime import time
+from uuid import UUID
+
+from typing_extensions import TypedDict
+
+from polyfactory.factories import DataclassFactory
+from polyfactory.factories import TypedDictFactory
+
+
+def test_dataclass_time_and_uuid_fields() -> None:
+    @dataclass
+    class Model:
+        t: time
+        uuid: UUID
+
+    class ModelFactory(DataclassFactory[Model]):
+        __model__ = Model
+
+    result = ModelFactory.build()
+
+    assert isinstance(result.t, time)
+    assert isinstance(result.uuid, UUID)
+
+
+def test_typeddict_time_and_uuid_fields() -> None:
+    class Model(TypedDict):
+        t: time
+        uuid: UUID
+
+    class ModelFactory(TypedDictFactory[Model]):
+        __model__ = Model
+
+    result = ModelFactory.build()
+
+    assert isinstance(result["t"], time)
+    assert isinstance(result["uuid"], UUID)
