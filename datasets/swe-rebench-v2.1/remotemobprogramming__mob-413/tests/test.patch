diff --git a/status_test.go b/status_test.go
new file mode 100644
index 0000000..e561593
--- /dev/null
+++ b/status_test.go
@@ -0,0 +1,84 @@
+package main
+
+import (
+	config "github.com/remotemobprogramming/mob/v4/configuration"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+func TestExecuteKicksOffStatus(t *testing.T) {
+	output, _ := setup(t)
+
+	execute("status", []string{}, config.GetDefaultConfiguration())
+
+	assertOutputContains(t, output, "you are on base branch 'master'")
+}
+
+func TestStatusMobProgramming(t *testing.T) {
+	output, configuration := setup(t)
+	start(configuration)
+
+	status(configuration)
+
+	assertOutputContains(t, output, "you are on wip branch mob-session")
+}
+
+func TestStatusWithMoreThan5LinesOfLog(t *testing.T) {
+	output, configuration := setup(t)
+	configuration.NextStay = true
+	start(configuration)
+
+	for i := 0; i < 6; i++ {
+		createFile(t, "test"+strconv.Itoa(i)+".txt", "contentIrrelevant")
+		next(configuration)
+	}
+
+	status(configuration)
+	// 6 wip commits + 1 start commit
+	assertOutputContains(t, output, "wip branch 'mob-session' contains 7 commits.")
+}
+
+func TestStatusDoesNotDetectWipBranchesWhenNoneExist(t *testing.T) {
+	output, configuration := setup(t)
+
+	status(configuration)
+
+	assertOutputNotContains(t, output, "  - origin/mob-session")
+}
+
+func TestStatusDetectsWipBranches(t *testing.T) {
+	output, configuration := setup(t)
+	start(configuration)
+	createFile(t, "test.txt", "contentIrrelevant")
+	next(configuration)
+	git("checkout", "master")
+	git("checkout", "-b", "mob/master-feature")
+	git("push", "origin", "mob/master-feature", "--set-upstream")
+	git("checkout", "master")
+
+	status(configuration)
+
+	assertOutputContains(t, output, "remote wip branches detected:")
+	for _, branch := range []string{"mob-session", "mob/master-feature"} {
+		foundEntryWithAge := false
+		for _, line := range strings.Split(*output, "\n") {
+			if !strings.HasPrefix(line, "  - ") || !strings.HasSuffix(line, " ago)") {
+				continue
+			}
+			entry := strings.TrimPrefix(line, "  - ")
+			for _, name := range []string{branch, "origin/" + branch} {
+				if strings.HasPrefix(entry, name+" (") {
+					foundEntryWithAge = true
+				}
+			}
+			if foundEntryWithAge {
+				break
+			}
+		}
+		if !foundEntryWithAge {
+			t.Errorf("expected an entry for %s with an age ending in ' ago)', got: %s", branch, *output)
+		}
+	}
+	assertOutputContains(t, output, " second")
+}
