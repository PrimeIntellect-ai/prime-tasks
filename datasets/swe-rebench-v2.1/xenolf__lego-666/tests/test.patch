+func TestNewDNSProvider(t *testing.T) {
+	testCases := []struct {
+		desc      string
+		userAgent string
+		envVars   map[string]string
+		expected  string
+	}{
+		{
+			desc:      "success",
+			userAgent: "lego",
+			envVars: map[string]string{
+				"DNSIMPLE_OAUTH_TOKEN": "my_token",
+			},
+		},
+		{
+			desc: "success: base url",
+			envVars: map[string]string{
+				"DNSIMPLE_OAUTH_TOKEN": "my_token",
+				"DNSIMPLE_BASE_URL":    "https://api.dnsimple.test",
+			},
+		},
+		{
+			desc: "missing oauth token",
+			envVars: map[string]string{
+				"DNSIMPLE_OAUTH_TOKEN": "",
+			},
+			expected: "dnsimple: OAuth token is missing",
+		},
+	}
 
-	assert.Nil(t, provider)
-	assert.EqualError(t, err, "dnsimple: OAuth token is missing")
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			defer restoreEnv()
+			for key, value := range test.envVars {
+				if len(value) == 0 {
+					os.Unsetenv(key)
+				} else {
+					os.Setenv(key, value)
+				}
+			}
+
+			if test.userAgent != "" {
+				acme.UserAgent = test.userAgent
+			}
+
+			p, err := NewDNSProvider()
+
+			if len(test.expected) == 0 {
+				require.NoError(t, err)
+				require.NotNil(t, p)
+				// The provider must be usable after construction: calling Timeout must not
+				// panic (the reported wildcard DNS-01 panic was caused by the provider
+				// losing its configuration).
+				assert.NotPanics(t, func() { p.Timeout() })
+
+
+
+			} else {
+				require.EqualError(t, err, test.expected)
+			}
+		})
+	}
 }
 
