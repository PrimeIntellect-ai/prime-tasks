@@ -0,0 +1,36 @@
+import { testServer } from './test-server';
+import { OAuth2Client } from '../src';
+import { expect } from 'chai';
+
+describe('Token revocation', () => {
+  const server = testServer();
+
+  it('submits the token being revoked', async () => {
+    const client = new OAuth2Client({
+      server: server.url,
+      tokenEndpoint: '/token',
+      clientId: 'test-client-id',
+      clientSecret: 'test-client-secret',
+    });
+    const token = await client.clientCredentials();
+
+    await client.revoke(token);
+
+    expect(server.lastRequest().body).to.have.property('token', token.accessToken);
+  });
+
+  it('uses the revocation endpoint advertised by discovery', async () => {
+    const client = new OAuth2Client({
+      server: server.url,
+      discoveryEndpoint: '/discover',
+      clientId: 'test-client-id',
+      clientSecret: 'test-client-secret',
+    });
+    const token = await client.clientCredentials();
+
+    await client.revoke(token);
+
+    expect(server.lastRequest().path).to.equal('/discovered-revoke');
+    expect(server.lastRequest().body).to.have.property('token', token.accessToken);
+  });
+});
