diff --git a/lib/absinthe/federation/schema/phase/add_federated_directives.ex b/lib/absinthe/federation/schema/phase/add_federated_directives.ex
index e65a35d..5155472 100644
--- a/lib/absinthe/federation/schema/phase/add_federated_directives.ex
