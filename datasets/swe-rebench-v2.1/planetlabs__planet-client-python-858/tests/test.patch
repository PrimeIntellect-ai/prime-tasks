+"""Session module tests."""
+
+import pytest
+import respx
+
+from planet import DataClient, Session
+
+
+def test_session_get_data_client():
+    """A session can construct the data client for convenience."""
+    session = Session()
+    assert isinstance(session.client("data"), DataClient)
+
+
+def test_data_client_can_still_be_constructed_directly():
+    """The existing dependency-injection construction remains available."""
+    session = Session()
+    DataClient(session)
+
+
+@pytest.mark.asyncio
+@respx.mock
+async def test_factory_client_uses_originating_session_request():
+    """Requests made through a factory client use its originating Session."""
+    class OriginatingSession(Session):
+        async def request(self, *args, **kwargs):
+            raise RuntimeError("originating session request")
+
+    session = OriginatingSession()
+    client = session.client("data")
+
+    with pytest.raises(RuntimeError, match="originating session request"):
+        await client.get_search("search-id")
