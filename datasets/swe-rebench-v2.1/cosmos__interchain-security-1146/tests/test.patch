+
+func GetMocksForSendIBCPacket(ctx sdk.Context, mocks MockedKeepers, channelID string, times int) []*gomock.Call {
+	return []*gomock.Call{
+		mocks.MockChannelKeeper.EXPECT().GetChannel(gomock.Any(), gomock.Any(), channelID).
+			Return(channeltypes.Channel{}, true).Times(times),
+		mocks.MockScopedKeeper.EXPECT().GetCapability(gomock.Any(), gomock.Any()).Return(
+			capabilitytypes.NewCapability(1), true).Times(times),
+		mocks.MockChannelKeeper.EXPECT().SendPacket(gomock.Any(),
+			gomock.Any(),
+			gomock.Any(),
+			channelID,
+			gomock.Any(),
+			gomock.Any(),
+			gomock.Any(),
+		).Return(uint64(888), nil).Times(times),
+	}
+}
