@@ -4,6 +4,7 @@ import (
 	"fmt"
 	"log"
 	"os"
+	"regexp"
 	"testing"
 
 	_ "github.com/StackExchange/dnscontrol/v3/providers/_all"
@@ -18,11 +19,13 @@ func TestFormatTypes(t *testing.T) {
 	  test_data/$DOMAIN.zone   zone            test_data/$DOMAIN.zone.zone
 	*/
 
-	for _, domain := range []string{"simple.com", "example.org", "apex.com"} {
+	for _, domain := range []string{"simple.com", "example.org", "apex.com", "ds.com"} {
 		t.Run(domain+"/js", func(t *testing.T) { testFormat(t, domain, "js") })
-		t.Run(domain+"/djs", func(t *testing.T) { testFormat(t, domain, "djs") })
-		t.Run(domain+"/tsv", func(t *testing.T) { testFormat(t, domain, "tsv") })
-		t.Run(domain+"/zone", func(t *testing.T) { testFormat(t, domain, "zone") })
+		if domain != "ds.com" {
+			t.Run(domain+"/djs", func(t *testing.T) { testFormat(t, domain, "djs") })
+			t.Run(domain+"/tsv", func(t *testing.T) { testFormat(t, domain, "tsv") })
+			t.Run(domain+"/zone", func(t *testing.T) { testFormat(t, domain, "zone") })
+		}
 	}
 }
 
@@ -72,6 +75,16 @@ func testFormat(t *testing.T, domain, format string) {
 	//		log.Fatal(err)
 	//	}
 
+	if domain == "ds.com" && format == "js" {
+		dsCall := regexp.MustCompile(`DS\(\s*['"]geo['"]\s*,\s*14480\s*,\s*13\s*,\s*2\s*,\s*['"]BB1C4B615CDED2B34347CF23710471934D972F1E34F53B54ED8D5F786202C73B['"]\s*\)`)
+		if matches := dsCall.FindAll(got, -1); len(matches) != 1 {
+			t.Errorf("expected one DS record with separate data parameters, got %q", got)
+		}
+		canonical := []byte("DS('geo', 14480, 13, 2, 'BB1C4B615CDED2B34347CF23710471934D972F1E34F53B54ED8D5F786202C73B')")
+		got = dsCall.ReplaceAll(got, canonical)
+		want = dsCall.ReplaceAll(want, canonical)
+	}
+
 	if w, g := string(want), string(got); w != g {
 		t.Errorf("testFormat mismatch (-got +want):\n%s", diff.LineDiff(g, w))
 	}
