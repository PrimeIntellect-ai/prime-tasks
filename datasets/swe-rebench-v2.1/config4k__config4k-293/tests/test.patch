+package io.github.config4k.serializers
+
+import com.typesafe.config.Config
+import io.github.config4k.Config4k
+import io.github.config4k.toConfig
+import kotlinx.serialization.Contextual
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.hocon.decodeFromConfig
+import kotlinx.serialization.hocon.encodeToConfig
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.Nested
+import org.junit.jupiter.api.Test
+
+class RegexSerializerTest {
+    private companion object {
+        val simpleRegex: Regex = Regex("[0-9]{10}")
+        val regexWithOps: Regex = Regex("[0-9]{10}", setOf(RegexOption.LITERAL, RegexOption.IGNORE_CASE))
+
+        val regexComparator = nullsLast(compareBy(Regex::pattern, { it.toPattern().flags() }))
+    }
+
+    @Nested
+    inner class SimpleTest {
+        @Test
+        fun checkDecoding() {
+            @Serializable
+            data class Conf(
+                @Contextual val r: Regex,
+            )
+
+            listOf(simpleRegex, regexWithOps).forEach { regex ->
+                val encoded = Config4k.encodeToConfig(Conf(regex))
+                val decoded: Conf = Config4k.decodeFromConfig(encoded)
+                assertThat(decoded.r).usingComparator(regexComparator).isEqualTo(regex)
+            }
+        }
+
+        @Test
+        fun checkNullableDecoding() {
+            @Serializable
+            data class Conf(
+                @Contextual val r: Regex? = null,
+            )
+
+            val test: Conf = Config4k.decodeFromConfig("foo = bar".toConfig())
+            assertThat(test.r).isNull()
+        }
+
+        @Test
+        fun checkDefaultDecoding() {
+            @Serializable
+            data class Conf(
+                @Contextual val r: Regex = simpleRegex,
+            )
+
+            val default: Conf = Config4k.decodeFromConfig("foo = bar".toConfig())
+            assertThat(default.r).usingComparator(regexComparator).isEqualTo(simpleRegex)
+        }
+
+        @Test
+        fun checkEncoding() {
+            @Serializable
+            data class Conf(
+                @Contextual val r: Regex,
+            )
+
+            val simple = Config4k.encodeToConfig(Conf(simpleRegex))
+            assertThat(Config4k.decodeFromConfig<Conf>(simple).r).usingComparator(regexComparator).isEqualTo(simpleRegex)
+
+            val withOps = Config4k.encodeToConfig(Conf(regexWithOps))
+            assertThat(Config4k.decodeFromConfig<Conf>(withOps).r).usingComparator(regexComparator).isEqualTo(regexWithOps)
+        }
+    }
+
+    @Nested
+    inner class ListTest {
+        @Test
+        fun checkDecoding() {
+            @Serializable
+            data class Conf(
+                val rs: List<@Contextual Regex>,
+            )
+
+            val emptyTest: Conf = Config4k.decodeFromConfig("rs = []".toConfig())
+            assertThat(emptyTest.rs).isEmpty()
+
+            val expected = listOf(simpleRegex, regexWithOps)
+            val encoded = Config4k.encodeToConfig(Conf(expected))
+            val test: Conf = Config4k.decodeFromConfig(encoded)
+            assertThat(test.rs).usingElementComparator(regexComparator).containsExactlyElementsOf(expected)
+
+        }
+
+        @Test
+        fun checkNullableDecoding() {
+            @Serializable
+            data class Conf(
+                val rs: List<@Contextual Regex?>? = null,
+            )
+
+            val nullTest: Conf = Config4k.decodeFromConfig("foo = bar".toConfig())
+            assertThat(nullTest.rs).isNull()
+
+            val emptyTest: Conf = Config4k.decodeFromConfig("rs = []".toConfig())
+            assertThat(emptyTest.rs).isEmpty()
+
+            val expected = listOf(simpleRegex, null, regexWithOps)
+            val encoded = Config4k.encodeToConfig(Conf(expected))
+            val test: Conf = Config4k.decodeFromConfig(encoded)
+            assertThat(test.rs).usingElementComparator(regexComparator).containsExactlyElementsOf(expected)
+        }
+
+        @Test
+        fun checkDefaultDecoding() {
+            @Serializable
+            data class Conf(
+                val rs: List<@Contextual Regex> = listOf(simpleRegex),
+            )
+
+            val expected = listOf(simpleRegex, regexWithOps)
+            val encoded = Config4k.encodeToConfig(Conf(expected))
+            val test: Conf = Config4k.decodeFromConfig(encoded)
+            assertThat(test.rs).usingElementComparator(regexComparator).containsExactlyElementsOf(expected)
+
+            val default: Conf = Config4k.decodeFromConfig("foo = bar".toConfig())
+            assertThat(default.rs).usingElementComparator(regexComparator).containsExactly(simpleRegex)
+        }
+
+        @Test
+        fun checkEncoding() {
+            @Serializable
+            data class Conf(
+                val rs: List<@Contextual Regex?>,
+            )
+
+            val test: Config = Config4k.encodeToConfig(Conf(listOf(regexWithOps, null)))
+            assertThat(Config4k.decodeFromConfig<Conf>(test).rs)
+                .usingElementComparator(regexComparator)
+                .containsExactly(regexWithOps, null)
+        }
+    }
+
+    @Nested
+    inner class MapTest {
+        @Test
+        fun checkDecoding() {
+            @Serializable
+            data class Conf(
+                val rs: Map<String, @Contextual Regex>,
+            )
+
+            val emptyTest: Conf = Config4k.decodeFromConfig("rs = {}".toConfig())
+            assertThat(emptyTest.rs).isEmpty()
+
+            val expected = mapOf("key1" to regexWithOps, "key2" to simpleRegex)
+            val encoded = Config4k.encodeToConfig(Conf(expected))
+            val test: Conf = Config4k.decodeFromConfig(encoded)
+            assertThat(test.rs).containsOnlyKeys("key1", "key2")
+            assertThat(test.rs.values).usingElementComparator(regexComparator).containsExactlyInAnyOrderElementsOf(expected.values)
+        }
+
+        @Test
+        fun checkNullableDecoding() {
+            @Serializable
+            data class Conf(
+                val rs: Map<String, @Contextual Regex?>? = null,
+            )
+
+            val nullTest: Conf = Config4k.decodeFromConfig("foo = bar".toConfig())
+            assertThat(nullTest.rs).isNull()
+
+            val emptyTest: Conf = Config4k.decodeFromConfig("rs = {}".toConfig())
+            assertThat(emptyTest.rs).isEmpty()
+
+            val expected = mapOf("key1" to regexWithOps, "key2" to null, "key3" to simpleRegex)
+            val encoded = Config4k.encodeToConfig(Conf(expected))
+            val test: Conf = Config4k.decodeFromConfig(encoded)
+            assertThat(test.rs).containsOnlyKeys("key1", "key2", "key3")
+            assertThat(test.rs?.values).usingElementComparator(regexComparator).containsExactlyInAnyOrderElementsOf(expected.values)
+        }
+
+        @Test
+        fun checkDefaultDecoding() {
+            @Serializable
+            data class Conf(
+                val rs: Map<String, @Contextual Regex> = mapOf("key" to simpleRegex),
+            )
+
+            val expected = mapOf("key1" to regexWithOps, "key2" to simpleRegex)
+            val encoded = Config4k.encodeToConfig(Conf(expected))
+            val test: Conf = Config4k.decodeFromConfig(encoded)
+            assertThat(test.rs.values).usingElementComparator(regexComparator).containsExactlyInAnyOrderElementsOf(expected.values)
+
+            val default: Conf = Config4k.decodeFromConfig("foo = bar".toConfig())
+            assertThat(default.rs.values).usingElementComparator(regexComparator).containsExactly(simpleRegex)
+        }
+
+        @Test
+        fun checkEncoding() {
+            @Serializable
+            data class Conf(
+                val ps: Map<String, @Contextual Regex?>,
+            )
+
+            val test: Config =
+                Config4k.encodeToConfig(
+                    Conf(
+                        mapOf(
+                            "key1" to regexWithOps,
+                            "key2" to null,
+                        ),
+                    ),
+                )
+            val decoded = Config4k.decodeFromConfig<Conf>(test).ps
+            assertThat(decoded).containsOnlyKeys("key1", "key2")
+            assertThat(decoded["key1"]).usingComparator(regexComparator).isEqualTo(regexWithOps)
+            assertThat(decoded["key2"]).isNull()
+        }
+    }
+}
