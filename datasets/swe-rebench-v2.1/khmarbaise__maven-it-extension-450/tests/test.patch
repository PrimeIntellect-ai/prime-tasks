@@ -27,6 +27,13 @@ import org.mockito.Mock;
 import org.mockito.junit.jupiter.MockitoExtension;
 
 import java.nio.file.Path;
+import java.nio.file.Paths;
+import javax.xml.parsers.DocumentBuilderFactory;
+import javax.xml.xpath.XPathConstants;
+import javax.xml.xpath.XPathFactory;
+
+import org.w3c.dom.Document;
+import org.w3c.dom.NodeList;
 
 import static org.assertj.core.api.Assertions.assertThat;
 import static org.assertj.core.api.Assertions.assertThatExceptionOfType;
@@ -49,12 +56,37 @@ class ArchiveAssertTest {
   @InjectMocks
   private ArchiveAssert archiveAssert;
 
+  @Test
+  void imported_assertj_bom_uses_version_3_25_0() throws Exception {
+    Document rootPom = DocumentBuilderFactory.newInstance().newDocumentBuilder()
+        .parse(Paths.get("../pom.xml").toFile());
+    NodeList importedAssertjBom = (NodeList) XPathFactory.newInstance().newXPath()
+        .compile("//dependency[groupId='org.assertj' and artifactId='assertj-bom' "
+            + "and type='pom' and scope='import']")
+        .evaluate(rootPom, XPathConstants.NODESET);
+
+    assertThat(importedAssertjBom.getLength()).isEqualTo(1);
+    String declaredVersion = XPathFactory.newInstance().newXPath().compile("string(./version)")
+        .evaluate(importedAssertjBom.item(0), XPathConstants.STRING).toString().trim();
+    String resolvedVersion = declaredVersion;
+    if (declaredVersion.startsWith("${") && declaredVersion.endsWith("}")) {
+      String propertyName = declaredVersion.substring(2, declaredVersion.length() - 1);
+      NodeList properties = rootPom.getDocumentElement().getElementsByTagName("properties");
+      if (properties.getLength() == 1) {
+        NodeList property = ((org.w3c.dom.Element) properties.item(0)).getElementsByTagName(propertyName);
+        if (property.getLength() == 1) {
+          resolvedVersion = property.item(0).getTextContent().trim();
+        }
+      }
+    }
+    assertThat(resolvedVersion).isEqualTo("3.25.0");
+  }
+
