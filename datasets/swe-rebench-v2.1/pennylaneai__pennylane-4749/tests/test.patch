         with pytest.raises(TypeError, match="unsupported operand type"):
             _ = qml.PauliX(0) @ "dummy"
 
+    def test_label_for_operations_with_id(self):
+        """Test that the label is correctly generated for an operation with an id"""
+        op = qml.RX(1.344, wires=0, id="test_with_id")
+        assert '"test_with_id"' in op.label()
+        assert '"test_with_id"' in op.label(decimals=2)
+
+        op = qml.RX(1.344, wires=0)
+        assert '"test_with_id"' not in op.label()
+        assert '"test_with_id"' not in op.label(decimals=2)
+
+        parameterless_op = qml.S(wires=0, id="parameterless_id")
+        assert '"parameterless_id"' in parameterless_op.label()
+        assert '"parameterless_id"' in parameterless_op.label(decimals=2)
+
+    def test_draw_displays_operation_ids(self):
+        """Test that qml.draw displays the id of operations in the printed circuit."""
+
+        def circuit(x, d):
+            qml.S(wires=0, id="phase")
+            qml.RX(d, id="data", wires=0)
+            qml.Rot(*x, id="parameters", wires=0)
+            return qml.expval(qml.PauliZ(0))
+
+        x = np.array([0.863, 0.611, 0.281])
+        d = 0.123
+
+        drawn = qml.draw(circuit)(x, d)
+        assert '"phase"' in drawn
+        assert '"data"' in drawn
+        assert '"parameters"' in drawn
+
+        drawn_without_params = qml.draw(circuit, decimals=None)(x, d)
+        assert '"phase"' in drawn_without_params
+        assert '"data"' in drawn_without_params
+        assert '"parameters"' in drawn_without_params
+
 
 class TestTensor:
     """Unit tests for the Tensor class"""
