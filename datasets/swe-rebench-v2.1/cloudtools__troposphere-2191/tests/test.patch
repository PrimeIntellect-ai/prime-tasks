+class TestParameterValidator(unittest.TestCase):
+    def test_allowed_pattern_for_number(self):
+        with self.assertRaises(ValueError) as ctx:
+            Parameter("Foo", Type="Number", AllowedPattern="^[a-zA-Z0-9]*$").validate()
+        self.assertIn("AllowedPattern", str(ctx.exception))
+
+    def test_allowed_pattern_for_comma_delimited_list_and_string(self):
+        self.assertIsNone(
+            Parameter(
+                "Foo",
+                Type="CommaDelimitedList",
+                AllowedPattern="^[A-Z]{2}$",
+                Default="",
+            ).validate()
+        )
+
+        self.assertIsNone(
+            Parameter(
+                "Foo",
+                Type="String",
+                AllowedPattern="^[A-Z]{2}$",
+                Default="",
+            ).validate()
+        )
+
+    def test_numeric_limits_for_non_number_types(self):
+        with self.assertRaises(ValueError) as ctx:
+            Parameter("Foo", Type="String", MaxValue=10).validate()
+        self.assertIn("MaxValue", str(ctx.exception))
+
+        with self.assertRaises(ValueError) as ctx:
+            Parameter("Foo", Type="CommaDelimitedList", MinValue=1).validate()
+        self.assertIn("MinValue", str(ctx.exception))
+
+    def test_aws_specific_type(self):
+        Parameter(
+            "Foo",
+            Type="AWS::EC2::KeyPair::KeyName",
+            Default="",
+        ).validate()
+
+
 if __name__ == "__main__":
     unittest.main()
