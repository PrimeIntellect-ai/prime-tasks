+async def test_mount_custom_tool_separator():
+    """Test that a caller-supplied tool separator is used for imported tool names."""
+    main_app = FastMCP("MainApp")
+    sub_app = FastMCP("SubApp")
+
+    @sub_app.tool()
+    def sub_tool() -> str:
+        return "This is from the sub app"
+
+    main_app.mount("sub", sub_app, tool_separator="__")
+
+    assert {tool.name for tool in await main_app.list_tools()} == {"sub__sub_tool"}
+
+
+async def test_mount_custom_prompt_separator():
+    """Test that a caller-supplied prompt separator is used for imported prompt names."""
+    main_app = FastMCP("MainApp")
+    assistant_app = FastMCP("AssistantApp")
+
+    @assistant_app.prompt()
+    def greeting(name: str) -> str:
+        return f"Hello, {name}!"
+
+    main_app.mount("assistant", assistant_app, prompt_separator=".")
+
+    assert {prompt.name for prompt in await main_app.list_prompts()} == {
+        "assistant.greeting"
+    }
+
+
+async def test_mount_custom_resource_separator():
+    """Test that a caller-supplied resource separator is used for imported resource URIs."""
+    main_app = FastMCP("MainApp")
+    data_app = FastMCP("DataApp")
+
+    @data_app.resource(uri="data://users")
+    async def get_users():
+        return ["user1", "user2"]
+
+    main_app.mount("data", data_app, resource_separator="-")
+
+    assert "data-data://users" in {
+        str(resource.uri) for resource in await main_app.list_resources()
+    }
+
+
+async def test_mount_custom_resource_separator_templates():
+    """Test that a caller-supplied resource separator is used for imported resource-template URIs."""
+    main_app = FastMCP("MainApp")
+    user_app = FastMCP("UserApp")
+
+    @user_app.resource(uri="users://{user_id}/profile")
+    def get_user_profile(user_id: str) -> dict:
+        return {"id": user_id, "name": f"User {user_id}"}
+
+    main_app.mount("api", user_app, resource_separator="-")
+
+    assert "api-users://{user_id}/profile" in {
+        template.uriTemplate for template in await main_app.list_resource_templates()
+    }
