+def test_cudf_ordered_categorical_categories_stay_native(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    import sys
+    import types
+
+    class ArrowCategories:
+        def __init__(self, categories: Categories) -> None:
+            self.categories = categories
+
+        def to_pylist(self) -> list[str]:
+            self.categories.materializations += 1
+            return ["a", "b"]
+
+    class Categories:
+        def __init__(self) -> None:
+            self.materializations = 0
+            self.pandas_conversions = 0
+
+        def to_arrow(self) -> ArrowCategories:
+            return ArrowCategories(self)
+
+        def to_pandas(self) -> list[str]:
+            self.pandas_conversions += 1
+            return ["a", "b"]
+
+    class CategoricalDtype:
+        ordered = True
+
+        def __init__(self) -> None:
+            self.categories = Categories()
+
+        def __str__(self) -> str:
+            return "category"
+
+    class CudfSeries:
+        def __init__(self) -> None:
+            self.dtype = CategoricalDtype()
+            self.name = "values"
+
+    class CudfDataFrame:
+        pass
+
+    cudf = types.ModuleType("cudf")
+    cudf.__version__ = "24.10"
+    cudf.Series = CudfSeries  # type: ignore[attr-defined]
+    cudf.DataFrame = CudfDataFrame  # type: ignore[attr-defined]
+    monkeypatch.setitem(sys.modules, "cudf", cudf)
+
+    native = CudfSeries()
+    series = nw.from_native(native, series_only=True)
+    dtype = series.dtype
+
+    assert isinstance(dtype, nw.Enum)
+    assert native.dtype.categories.materializations == 0
+    assert native.dtype.categories.pandas_conversions == 0
+    assert dtype.categories == ("a", "b")
+    assert native.dtype.categories.pandas_conversions == 0
+    assert "Enum(categories=['a', 'b'])" in repr(dtype)
+
+
