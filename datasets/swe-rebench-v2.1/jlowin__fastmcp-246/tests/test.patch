+class TestWildcardResourceTemplate:
+    """Test that wildcard templates can be registered and served as resources."""
+
+    async def test_wildcard_template_serves_matching_uri(self):
+        """A registered wildcard template serves a URI spanning multiple segments."""
+
+        def get_contents(path: str) -> str:
+            return f"Contents of {path}"
+
+        template = ResourceTemplate(
+            uri_template="contents://{path*}",
+            name="contents",
+            description="",
+            fn=get_contents,
+            parameters={},
+        )
+
+        manager = ResourceManager()
+        manager.add_template(template)
+
+        resource = await manager.get_resource("contents://foo/bar/baz.gif")
+        content = await resource.read()
+        assert content == "Contents of foo/bar/baz.gif"
