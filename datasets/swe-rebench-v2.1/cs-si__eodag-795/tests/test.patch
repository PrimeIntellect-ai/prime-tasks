diff --git a/tests/units/test_http_server.py b/tests/units/test_http_server.py
index 9a144cd..7633d1b 100644
--- a/tests/units/test_http_server.py
+++ b/tests/units/test_http_server.py
@@ -760,3 +760,49 @@ class RequestTestCase(unittest.TestCase):
         response = self._request_valid("/extensions/oseo/json-schema/schema.json")
         self.assertEqual(response["title"], "OpenSearch for Earth Observation")
         self.assertEqual(response["allOf"][0]["$ref"], "#/definitions/oseo")
+
+    def test_queryables(self):
+        """The global queryables response exposes common, not product-specific, terms."""
+        response = self._request_valid("queryables")
+
+        self.assertTrue(
+            {"id", "collection", "geometry", "bbox", "datetime"}.issubset(
+                response["properties"]
+            )
+        )
+        self.assertNotIn("eo:cloud_cover", response["properties"])
+
+    def test_queryables_responses_are_json_schemas(self):
+        """Both queryables endpoints return a JSON Schema object document."""
+        responses = (
+            self._request_valid("queryables"),
+            self._request_valid(
+                f"collections/{self.tested_product_type}/queryables"
+            ),
+        )
+
+        for response in responses:
+            self.assertEqual(
+                response["$schema"],
+                "https://json-schema.org/draft/2019-09/schema",
+            )
+            self.assertIsInstance(response.get("$id"), str)
+            self.assertTrue(response["$id"])
+            self.assertEqual(response.get("type"), "object")
+            self.assertIsInstance(response.get("properties"), dict)
+            for definition in response["properties"].values():
+                self.assertIsInstance(definition, (dict, bool))
+                if isinstance(definition, dict) and "$ref" in definition:
+                    self.assertIsInstance(definition["$ref"], str)
+                if isinstance(definition, dict) and "description" in definition:
+                    self.assertIsInstance(definition["description"], str)
+
+    def test_product_type_queryables(self):
+        """Collection queryables include properties configured for the product type."""
+        response = self._request_valid(
+            f"collections/{self.tested_product_type}/queryables"
+        )
+
+        # S2_MSI_L1C defines cloudCover in providers.yml; the STAC mapping exposes it
+        # as eo:cloud_cover.
+        self.assertIn("eo:cloud_cover", response["properties"])
