diff --git a/__tests__/customJobName.test.ts b/__tests__/customJobName.test.ts
new file mode 100644
index 0000000..60f111f
--- /dev/null
+++ b/__tests__/customJobName.test.ts
@@ -0,0 +1,44 @@
+import nock from 'nock';
+
+process.env.GITHUB_RUN_ID = '2';
+process.env.MATRIX_CONTEXT = '{"os": "ubuntu-18.04"}';
+
+import { newWith, setupNockCommit, setupNockJobs } from './helper';
+import { Client, Success } from '../src/client';
+
+beforeAll(() => {
+  nock.disableNetConnect();
+  setupNockCommit(process.env.GITHUB_SHA as string);
+  setupNockJobs(
+    process.env.GITHUB_RUN_ID as string,
+    'actions.custom-job-name.jobs',
+  );
+});
+afterAll(() => {
+  nock.cleanAll();
+  nock.enableNetConnect();
+});
+describe('configured job name', () => {
+  beforeEach(() => {
+    process.env.GITHUB_REPOSITORY = '8398a7/action-slack';
+    process.env.GITHUB_EVENT_NAME = 'push';
+    const github = require('@actions/github');
+    github.context.job = 'custom-job-id';
+    github.context.payload = {};
+  });
+  it('includes the configured job name in the Slack field', async () => {
+    const withParams = {
+      ...newWith(),
+      status: Success,
+      fields: 'job,took',
+      job_name: 'Custom Job',
+    };
+    const client = new Client(withParams, process.env.GITHUB_TOKEN, '');
+    const result = await client.prepare('');
+    const jobField = result.attachments[0].fields.find(
+      field => field.title === 'job',
+    );
+
+    expect(jobField?.value).toContain('Custom Job');
+  });
+});
