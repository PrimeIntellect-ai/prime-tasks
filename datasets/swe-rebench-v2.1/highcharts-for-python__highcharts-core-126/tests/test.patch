+    }, {
+        'spacing_right': 124,
+        'spacing_top': 421,
+        'spacing_bottom': 321,
+        'spacing_left': 789
+    }),
+])
+def test_bug124_spacing_right_from_dict(as_dict, expected_spacing):
+    result = cls.from_dict(as_dict)
+
+    assert isinstance(result, cls) is True
+    for attribute, expected_value in expected_spacing.items():
+        assert getattr(result, attribute) == expected_value
