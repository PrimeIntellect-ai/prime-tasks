+
+func Test_WorkspaceScopedIgnoreThroughCLI(t *testing.T) {
+	dir := t.TempDir()
+	config := `
+# tfsec:ignore:AWS018:ws:staging
+resource "aws_security_group_rule" "my-rule" {
+    type        = "ingress"
+    cidr_blocks = ["0.0.0.0/0"]
+}
+`
+	require.NoError(t, ioutil.WriteFile(filepath.Join(dir, "main.tf"), []byte(config), 0600))
+
+	scan := func(workspace string) []string {
+		cmd := exec.Command("go", "run", "../../../../cmd/tfsec", "--format", "json", "--workspace", workspace, dir)
+		var stderr bytes.Buffer
+		cmd.Stderr = &stderr
+		output, err := cmd.Output()
+		if err != nil {
+			t.Logf("tfsec returned %v: %s", err, stderr.String())
+		}
+		var report struct {
+			Results []struct {
+				LegacyRuleID string `json:"legacy_rule_id"`
+			} `json:"results"`
+		}
+		require.NoError(t, json.Unmarshal(output, &report))
+		var ruleIDs []string
+		for _, result := range report.Results {
+			ruleIDs = append(ruleIDs, result.LegacyRuleID)
+		}
+		return ruleIDs
+	}
+
+	assert.NotContains(t, scan("staging"), "AWS018")
+	assert.Contains(t, scan("production"), "AWS018")
+}
