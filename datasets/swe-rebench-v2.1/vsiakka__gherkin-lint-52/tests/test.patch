diff --git a/test/rules/name-length/test.js b/test/rules/name-length/test.js
new file mode 100644
index 0000000..64355c8
--- /dev/null
+++ b/test/rules/name-length/test.js
@@ -0,0 +1,66 @@
+var assert = require('chai').assert;
+var expect = require('chai').expect;
+var nameLength = require('../../../src/rules/name-length.js');
+var Gherkin = require('gherkin');
+var parser = new Gherkin.Parser();
+var fs = require('fs');
+
+var expectedResults = require('./test-results/results.js');
+
+require('mocha-sinon');
+
+function getErrors(fileName, configuration) {
+  var file = fs.readFileSync('test/rules/name-length/test-data/' + fileName, 'utf8');
+  var parsedFile = parser.parse(file).feature;
+  return nameLength.run(parsedFile, undefined, configuration);
+}
+
+
+describe('Name length rule', function() {
+  it('doesn\'t raise errors when the default configuration is used and there are no length violations', function() {
+    var configuration = ['on'];
+    var fileName = 'CorrectLength.feature';
+    var errors = getErrors(fileName, configuration);
+    expect(errors).to.be.empty;
+  });
+
+  it('detects errors for features, scenarios, scenario outlines and steps', function() {
+    var configuration = ['on'];
+    var fileName = 'WrongLength.feature';
+    var errors = getErrors(fileName, configuration);
+    assert.sameDeepMembers(errors, expectedResults.wrongLength);
+  });
+
+  it('uses the configured maximum length for each element type', function() {
+    var configuration = {Feature: 10, Scenario: 10, Step: 10};
+    var fileName = 'CorrectLength.feature';
+    var errors = getErrors(fileName, configuration);
+    assert.sameDeepMembers(errors, [
+      { message: 'Feature name is too long. Length of 41 is longer than the maximum allowed: 10',
+        rule: 'name-length',
+        line: 1
+      },
+      { message: 'Step name is too long. Length of 40 is longer than the maximum allowed: 10',
+        rule: 'name-length',
+        line: 4
+      },
+      { message: 'Scenario name is too long. Length of 38 is longer than the maximum allowed: 10',
+        rule: 'name-length',
+        line: 6
+      },
+      { message: 'Step name is too long. Length of 31 is longer than the maximum allowed: 10',
+        rule: 'name-length',
+        line: 7
+      },
+      { message: 'Scenario name is too long. Length of 46 is longer than the maximum allowed: 10',
+        rule: 'name-length',
+        line: 9
+      },
+      { message: 'Step name is too long. Length of 31 is longer than the maximum allowed: 10',
+        rule: 'name-length',
+        line: 10
+      }
+    ]);
+  });
+
+});
