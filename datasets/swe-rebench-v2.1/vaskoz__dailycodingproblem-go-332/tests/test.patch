+package day159
+
+import "testing"
+
+var testcases = []struct {
+	s            string
+	expected     rune
+	expectsError bool
+}{
+	{"acbbac", 'b', false},
+	{"abcdef", 0, true},
+	{"界é界", '界', false},
+}
+
+func TestFirstRecurringRune(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		r, err := FirstRecurringRune(tc.s)
+		if (err != nil) != tc.expectsError {
+			t.Errorf("Expected error presence %t, got %v", tc.expectsError, err)
+		}
+		if !tc.expectsError && r != tc.expected {
+			t.Errorf("Expected rune %q, got %q", tc.expected, r)
+		}
+	}
+}
+
+func BenchmarkFirstRecurringRune(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			FirstRecurringRune(tc.s)
+		}
+	}
+}
