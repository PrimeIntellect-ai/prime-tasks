diff --git a/test/counts/core.jl b/test/counts/core.jl
index 4bc377a..14bcae1 100644
--- a/test/counts/core.jl
+++ b/test/counts/core.jl
@@ -68,3 +68,50 @@ outs_unnamed = tuple(collect(o for o in outs)...) # outcomes doesn't care about
 @test outcomes(Counts(z, outs), 1:3) == outs_unnamed
 @test outcomes(Counts(z, outs), 1:2) == outs_unnamed[1:2]
 
+# -----------------------------------------------------------------------------------------
+# Pretty printing
+# -----------------------------------------------------------------------------------------
+# 1D
+c = Counts([101, 202, 303], (["first", "second", "third"],))
+out_capture = repr(MIME("text/plain"), c)
+s = split(out_capture, '\n')
+@test contains(first(s), "Counts{Int64,1} over 3 outcomes")
+@test all(label -> occursin(label, out_capture), ("first", "second", "third"))
+
+# 2D
+c = Counts(rand(1:30, 2, 3), (["a", "e"], ["two", "four", "six"]))
+out_capture = repr(MIME("text/plain"), c)
+s = split(out_capture, '\n')
+@test contains(first(s), "2×3 Counts{Int64,2}")
+@test all(label -> occursin(label, out_capture), ("a", "e", "two", "four", "six"))
+
+# 3D: the representation includes a displayed data slice.
+data3 = reshape(101:118, 2, 3, 3)
+c = Counts(data3, (["a", "e"], ["two", "four", "six"], [(1, 2), (2, 1), (3, 1)]))
+out_capture = repr(MIME("text/plain"), c)
+s = split(out_capture, '\n')
+
+@test contains(first(s), "2×3×3 Counts{Int64,3}")
+@test all(label -> occursin(label, out_capture), ("a", "e", "two", "four", "six"))
+@test strip(last(split(rstrip(out_capture), '\n'))) == "[and 2 more slices...]"
+
+# 4D (and higher)
+c = Counts(rand(1:30, 2, 3, 3, 2), (['a', 'e'], 2:2:6, [(1, 2), (2, 1), (3, 1)], ["q", "q2"]))
+out_capture = repr(MIME("text/plain"), c)
+s = split(out_capture, '\n')
+@test contains(s[1], "2×3×3×2 Counts")
+@test strip(last(split(rstrip(out_capture), '\n'))) == "[and 5 more slices...]"
+
+# Data values are displayed alongside the outcome marginals.
+c = Counts([11 12 13; 14 15 16], (["a", "b"], ["x", "y", "z"]))
+out_capture = repr(MIME("text/plain"), c)
+@test all(occursin(string(v), out_capture) for v in (11, 12, 13, 14, 15, 16))
+
+# A higher-dimensional representation shows a labeled two-dimensional slice of the data.
+# Identical slices allow any valid slice choice.
+slice_counts = [101 102 103; 104 105 106]
+counts_3d_data = cat(slice_counts, slice_counts, slice_counts; dims=3)
+c3_layout = Counts(counts_3d_data, (["r1", "r2"], ["c1", "c2", "c3"], ["s1", "s2", "s3"]))
+layout_out = repr(MIME("text/plain"), c3_layout)
+@test all(v -> occursin(string(v), layout_out), vec(slice_counts))
+@test all(l -> occursin(l, layout_out), ("r1", "r2", "c1", "c2", "c3"))
diff --git a/test/probabilities/probabilities.jl b/test/probabilities/probabilities.jl
index 694d3a8..96609ad 100644
--- a/test/probabilities/probabilities.jl
+++ b/test/probabilities/probabilities.jl
@@ -33,3 +33,36 @@ p_decoded, outs = probabilities_and_outcomes(est, outcomemodel, x)
 # Error messages.
 struct MyEstimator <: ProbabilitiesEstimator end
 @test_throws MethodError probabilities(MyEstimator(), x)
+
+# ----------------------------------------------------------------
+# Pretty printing
+# ----------------------------------------------------------------
+p = Probabilities([0.11, 0.22, 0.67], (["low", "middle", "high"],))
+out_capture = repr(MIME("text/plain"), p)
+s = split(out_capture, '\n')
+@test contains(first(s), "Probabilities{Float64,1} over 3 outcomes")
+@test all(label -> occursin(label, out_capture), ("low", "middle", "high"))
+# Multidimensional Probabilities
+p2 = Probabilities([0.1 0.2 0.3; 0.05 0.15 0.2], (["alpha", "beta"], ["x1", "x2", "x3"]))
+out_capture = repr(MIME("text/plain"), p2)
+s = split(out_capture, '\n')
+@test contains(first(s), "2×3 Probabilities{Float64,2}")
+@test occursin("alpha", out_capture)
+@test occursin("x1", out_capture)
+# Values are displayed in some numeric notation (decimal or scientific).
+@test any(m -> isapprox(parse(Float64, m.match), 0.1; atol=1e-9), eachmatch(r"[-+]?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?", out_capture))
+
+p3data = reshape([0.001, 0.002, 0.003, 0.004, 0.005, 0.006, 0.007, 0.008, 0.009, 0.010, 0.011, 0.012, 0.013, 0.014, 0.015, 0.016, 0.017, 0.847], 2, 3, 3)
+p3 = Probabilities(p3data, (["alpha", "beta"], ["x1", "x2", "x3"], [1, 2, 3]))
+out_capture = repr(MIME("text/plain"), p3)
+s = split(out_capture, '\n')
+@test contains(first(s), "2×3×3 Probabilities{Float64,3}")
+@test strip(last(split(rstrip(out_capture), '\n'))) == "[and 2 more slices...]"
+
+probability_slice = [0.1 0.2 0.3; 0.05 0.15 0.2] ./ 3
+probabilities_3d_data = cat(probability_slice, probability_slice, probability_slice; dims=3)
+p3_layout = Probabilities(probabilities_3d_data, (["r1", "r2"], ["c1", "c2", "c3"], ["s1", "s2", "s3"]))
+layout_out = repr(MIME("text/plain"), p3_layout)
+layout_numbers = [parse(Float64, m.match) for m in eachmatch(r"[-+]?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?", layout_out)]
+@test all(v -> any(n -> isapprox(n, v; atol=1e-3), layout_numbers), probability_slice)
+@test all(l -> occursin(l, layout_out), ("r1", "r2", "c1", "c2", "c3"))
