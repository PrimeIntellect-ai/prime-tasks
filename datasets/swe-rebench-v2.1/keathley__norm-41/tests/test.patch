+      ]
+
+      matcher = spec(Foo.match?("foo") and is_binary)
+      assert conform!("foo", matcher) == "foo"
+      assert {:error, errors} = conform("1", matcher)
+      assert errors == [
+        %{input: "1", path: [], spec: "Foo.match?(\"foo\")"}
