+// TestTotalEvictionLimitFromPolicy verifies that the policy budget is shared across nodes and plugins during a descheduling cycle.
+func TestTotalEvictionLimitFromPolicy(t *testing.T) {
+	descheduler.SetupPlugins()
+
+	node1 := test.BuildTestNode("tainted", 2000, 3000, 10, nil)
+	node1.Spec.Taints = []v1.Taint{{Key: "dedicated", Value: "test", Effect: v1.TaintEffectNoSchedule}}
+	node2 := test.BuildTestNode("available", 2000, 3000, 10, nil)
+	oldPod := test.BuildTestPod("old-candidate", 100, 0, node1.Name, test.SetRSOwnerRef)
+	oldPod.ObjectMeta.CreationTimestamp = metav1.NewTime(time.Date(2009, time.November, 10, 23, 0, 0, 0, time.UTC))
+	secondOldPod := test.BuildTestPod("second-old-candidate", 100, 0, node2.Name, test.SetRSOwnerRef)
+	secondOldPod.ObjectMeta.CreationTimestamp = oldPod.ObjectMeta.CreationTimestamp
+	recentPod := test.BuildTestPod("recent-candidate", 100, 0, node1.Name, test.SetRSOwnerRef)
+	recentPod.ObjectMeta.CreationTimestamp = metav1.NewTime(time.Now())
+
+	client := fake.NewSimpleClientset(node1, node2, oldPod, secondOldPod, recentPod)
+	evictionRequests := 0
+	var cancelAfterSecondEviction context.CancelFunc
+	client.PrependReactor("create", "pods", func(action core.Action) (bool, runtime.Object, error) {
+		if action.GetSubresource() == "eviction" {
+			evictionRequests++
+			if evictionRequests == 2 && cancelAfterSecondEviction != nil {
+				cancelAfterSecondEviction()
+			}
+			return true, &policyv1.Eviction{}, nil
+		}
+		return false, nil, nil
+	})
+
+	server, err := appoptions.NewDeschedulerServer()
+	if err != nil {
+		t.Fatalf("create descheduler server: %v", err)
+	}
+	server.Client = client
+	server.DeschedulingInterval = 0
+
+	policy := &deschedulerapi.DeschedulerPolicy{
+		Profiles: []deschedulerapi.DeschedulerProfile{{
+			Name: "test",
+			PluginConfigs: []deschedulerapi.PluginConfig{
+				{Name: defaultevictor.PluginName, Args: &defaultevictor.DefaultEvictorArgs{}},
+				{Name: podlifetime.PluginName, Args: &podlifetime.PodLifeTimeArgs{MaxPodLifeTimeSeconds: utilptr.To[uint](600)}},
+				{Name: nodetaints.PluginName, Args: &nodetaints.RemovePodsViolatingNodeTaintsArgs{}},
+			},
+			Plugins: deschedulerapi.Plugins{
+				Deschedule:        deschedulerapi.PluginSet{Enabled: []string{podlifetime.PluginName, nodetaints.PluginName}},
+				Filter:            deschedulerapi.PluginSet{Enabled: []string{defaultevictor.PluginName}},
+				PreEvictionFilter: deschedulerapi.PluginSet{Enabled: []string{defaultevictor.PluginName}},
+			},
+		}},
+	}
+
+	if err := yaml.Unmarshal([]byte("maxNoOfPodsToEvictTotal: 1"), policy); err != nil {
+		t.Fatalf("decode policy total eviction limit: %v", err)
+	}
+
+	if err := descheduler.RunDeschedulerStrategies(context.Background(), server, policy, "v1"); err != nil {
+		t.Fatalf("run descheduler with policy: %v", err)
+	}
+	if evictionRequests != 1 {
+		t.Errorf("policy total limit of one allowed %d pod eviction requests across plugins, want 1", evictionRequests)
+	}
+
+	// A subsequent loop is a new descheduling cycle and receives its own budget.
+	evictionRequests = 0
+	server.DeschedulingInterval = 10 * time.Millisecond
+	cycleCtx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	cancelAfterSecondEviction = cancel
+	if err := descheduler.RunDeschedulerStrategies(cycleCtx, server, policy, "v1"); err != nil {
+		t.Fatalf("run recurring descheduler cycles: %v", err)
+	}
+	if evictionRequests != 2 {
+		t.Errorf("total limit was not reset for the next cycle: observed %d successful eviction requests, want one in each of two cycles", evictionRequests)
+	}
