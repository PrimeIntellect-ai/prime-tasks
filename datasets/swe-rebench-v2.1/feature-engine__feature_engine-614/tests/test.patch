+def test_with_selected_variables(df_duplicate_features):
+    # Only the variables passed by the user are inspected for duplication.
+    transformer = DropDuplicateFeatures(variables=["City", "City2", "Age", "Age2"])
+    X = transformer.fit_transform(df_duplicate_features)
+
+    assert transformer.features_to_drop_ == {"City2", "Age2"}
+    assert list(X.columns) == [
+        "Name",
+        "dob2",
+        "City",
+        "Age",
+        "Marks",
+        "dob",
+        "dob3",
+    ]
+
+
+def test_performance_with_many_features():
+    # A dataset with a large number of features must be processed quickly.
+    n_features = 1000
+    rng = np.random.RandomState(0)
+    X = pd.DataFrame({f"feature_{i}": rng.rand(10) for i in range(n_features)})
+
+    transformer = DropDuplicateFeatures()
+
+    start = time.perf_counter()
+    transformer.fit_transform(X)
+    elapsed = time.perf_counter() - start
+
+    assert elapsed < 1
