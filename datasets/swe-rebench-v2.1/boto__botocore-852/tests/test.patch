+class TestCanSendIntegerHeaders(BaseSessionTest):
+
+    def test_int_values_with_sigv4(self):
+        s3 = self.session.create_client(
+            's3', config=Config(signature_version='s3v4'))
+        with mock.patch('botocore.endpoint.Session.send') as mock_send:
+            mock_send.return_value = mock.Mock(status_code=200,
+                                               content=b'',
+                                               headers={})
+            s3.upload_part(Bucket='foo', Key='bar', Body=b'foo',
+                           UploadId='bar', PartNumber=1, ContentLength=3)
+            request_sent = mock_send.call_args[0][0]
+            # The contract only requires that the upload succeeds when a
+            # non-string header value is supplied.  We deliberately do not
+            # assert on the exact representation of the header value at this
+            # boundary, because an implementation may legitimately keep the
+            # integer value here and normalize it to a string later (for
+            # example while signing or in the HTTP transport).
+            self.assertIn('Content-Length', request_sent.headers)
