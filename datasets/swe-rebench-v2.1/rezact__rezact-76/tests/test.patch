+    const notThere = screen.queryAllByRole("heading", {
+      name: /data fetching/i,
+    });
+    expect(notThere).toHaveLength(0);
+
+    router.routeRequest("/data-fetching");
+    await delay(100);
+  });
+
+  it("onBeforeLeave hook receives the to and from routes", async () => {
+    router.routeRequest("/simple-string-list");
+    await delay(100);
+
+    let receivedTo = null;
+    let receivedFrom = null;
+    router.currentRoute.onBeforeLeave((to, from) => {
+      receivedTo = to;
+      receivedFrom = from;
+      return false;
+    });
+    router.routeChanged("/data-fetching");
+    await delay(100);
+
+    expect(receivedTo).not.toBeNull();
+    expect(receivedFrom).not.toBeNull();
+    expect(receivedTo.pathname).toBe("/data-fetching");
+    expect(receivedFrom.pathname).toBe("/simple-string-list");
+
+    router.routeRequest("/data-fetching");
+    await delay(100);
+  });
