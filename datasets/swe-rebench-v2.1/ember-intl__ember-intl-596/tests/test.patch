diff --git a/tests-node/unit/utils/valid-locale-file-test.js b/tests-node/unit/utils/valid-locale-file-test.js
new file mode 100644
index 0000000..6782fd9
--- /dev/null
+++ b/tests-node/unit/utils/valid-locale-file-test.js
@@ -0,0 +1,75 @@
+/* eslint-env node */
+/* globals describe, it */
+
+'use strict';
+
+let fs = require('fs');
+let os = require('os');
+let path = require('path');
+let expect = require('chai').expect;
+
+let subject = require('../../../index');
+
+describe('validLocaleFile', function() {
+  [
+    ['en-us.yaml', true],
+    ['en.json', true],
+    ['sub/en-us.yml', true],
+
+    ['index.html', false],
+    ['notes.txt', false],
+    ['translations/notes.txt', false],
+    ['.bashrc', false],
+    ['.DS_Store', false],
+    [undefined, false],
+    [null, false],
+    [123, false]
+  ].forEach(([filename, isValid]) => {
+    it(`${filename}`, function() {
+      let validLocaleFile = require('../../../lib/utils/valid-locale-file');
+
+      expect(validLocaleFile(filename)).to.equal(isValid);
+    });
+  });
+});
+
+describe('build locale discovery', function() {
+  it('ignores .DS_Store artifacts and does not warn about them', function() {
+    let root = fs.mkdtempSync(path.join(os.tmpdir(), 'ember-intl-'));
+    let inputPath = 'translations';
+    let translationsDir = path.join(root, inputPath);
+
+    fs.mkdirSync(translationsDir);
+    fs.writeFileSync(path.join(translationsDir, '.DS_Store'), '');
+    fs.writeFileSync(path.join(translationsDir, 'notes.txt'), '');
+    fs.writeFileSync(path.join(translationsDir, 'en.json'), '{}');
+
+    let logs = [];
+    let app = {
+      project: {
+        root,
+        configPath() {
+          return path.join(root, 'ember-intl-config.js');
+        }
+      },
+      env: 'test',
+      options: { intl: {} }
+    };
+    let addon = Object.assign({}, subject, {
+      _super: { included() {} },
+      _findHost() {
+        return app;
+      },
+      log(message) {
+        logs.push(message);
+      }
+    });
+
+    addon.included();
+
+    expect(addon.locales).to.include('en');
+    expect(addon.locales).to.not.include('notes');
+    expect(addon.locales).to.not.include('.ds-store');
+    expect(logs.filter(message => /invalid locale|not a valid locale/i.test(message))).to.deep.equal([]);
+  });
+});
