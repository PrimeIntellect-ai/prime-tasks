+describe('global expressions in tag values and attributes', () => {
+  const tagsFor = async (envFile: string, image: string, tags: string[]): Promise<string[]> => {
+    process.env = dotenv.parse(fs.readFileSync(path.join(__dirname, 'fixtures', envFile)));
+    const context = github.context();
+    const repo = await github.repo(process.env.GITHUB_TOKEN || '');
+    const meta = new Meta(
+      {
+        ...getInputs(),
+        images: [image],
+        tags
+      } as Inputs,
+      context,
+      repo
+    );
+    return meta.getTags();
+  };
+
+  test('expands branch and tag expressions in raw values', async () => {
+    const tags = await tagsFor('event_push_defbranch.env', 'user/app', [
+      'type=raw,value=mytag-{{branch}}',
+      'type=raw,value=mytag-{{tag}}'
+    ]);
+
+    expect(tags).toEqual(expect.arrayContaining(['user/app:mytag-master', 'user/app:mytag-']));
+  });
+
+  test('expands branch expressions in prefixes', async () => {
+    const tags = await tagsFor('event_push_defbranch.env', 'user/app', ['type=sha,prefix={{branch}}-']);
+
+    expect(tags).toContain('user/app:master-90dd603');
+  });
+
+  test('expands tag and sha expressions in raw values', async () => {
+    const tags = await tagsFor('event_tag_v1.1.1.env', 'org/app', ['type=raw,{{tag}}-{{sha}}-foo']);
+
+    expect(tags).toContain('org/app:v1.1.1-90dd603-foo');
+  });
+
+  test.each([
+    [
+      'branch ref',
+      'event_push_defbranch.env',
+      'user/app',
+      ['user/app:suffix-checkmaster--90dd603']
+    ],
+    [
+      'tag ref',
+      'event_tag_v1.1.1.env',
+      'org/app',
+      ['org/app:suffix-check-v1.1.1-90dd603', 'org/app:suffix-check-{{branch}}-v1.1.1-90dd603']
+    ]
+  ])('expands expressions in a suffix for a %s', async (_name: string, envFile: string, image: string, expected: string[]) => {
+    const tags = await tagsFor(envFile, image, ['type=raw,value=suffix-check,suffix={{branch}}-{{tag}}-{{sha}}']);
+
+    expect(tags.some(tag => expected.includes(tag))).toBe(true);
+  });
+
+  test('expands tag and sha expressions in prefixes', async () => {
+    const tags = await tagsFor('event_tag_v1.1.1.env', 'org/app', ['type=sha,prefix={{tag}}-{{sha}}-']);
+
+    expect(tags).toContain('org/app:v1.1.1-90dd603-90dd603');
+  });
+});
