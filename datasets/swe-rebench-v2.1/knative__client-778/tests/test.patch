+func TestServiceUpdateWithMultipleNames(t *testing.T) {
+	orig := newEmptyService()
+	updatedNames, err := fakeServiceUpdateMultipleNames(orig, []string{
+		"service", "update", "foo", "foo1", "--image", "gcr.io/foo/bar:baz", "--no-wait"})
+	if err != nil {
+		// The contract permits rejecting the invocation with a clear single-argument error.
+		assert.Assert(t, util.ContainsAll(err.Error(), "'service update' requires the service name given as single argument"))
+		return
+	}
+	// The contract also permits performing the update on both services. Each named
+	// service must be updated at least once; additional update requests are allowed.
+	var updatedFoo, updatedFoo1 bool
+	for _, name := range updatedNames {
+		switch name {
+		case "foo":
+			updatedFoo = true
+		case "foo1":
+			updatedFoo1 = true
+		default:
+			t.Fatalf("unexpected update of service %q", name)
+		}
+	}
+	assert.Assert(t, updatedFoo && updatedFoo1)
+}
+
+func fakeServiceUpdateMultipleNames(original *servingv1.Service, args []string) (updatedNames []string, err error) {
+	knParams := &commands.KnParams{}
+	cmd, fakeServing, _ := commands.CreateTestKnCommand(NewServiceCommand(knParams), knParams)
+	fakeServing.AddReactor("get", "services",
+		func(a clienttesting.Action) (bool, runtime.Object, error) {
+			getAction, ok := a.(clienttesting.GetAction)
+			if !ok {
+				return true, nil, fmt.Errorf("wrong kind of action %v", a)
+			}
+			svc := original.DeepCopy()
+			svc.Name = getAction.GetName()
+			return true, svc, nil
+		})
+	fakeServing.AddReactor("update", "services",
+		func(a clienttesting.Action) (bool, runtime.Object, error) {
+			updateAction, ok := a.(clienttesting.UpdateAction)
+			if !ok {
+				return true, nil, fmt.Errorf("wrong kind of action %v", a)
+			}
+			svc, ok := updateAction.GetObject().(*servingv1.Service)
+			if !ok {
+				return true, nil, errors.New("was passed the wrong object")
+			}
+			updatedNames = append(updatedNames, svc.Name)
+			return true, svc, nil
+		})
+	fakeServing.AddReactor("patch", "services",
+		func(a clienttesting.Action) (bool, runtime.Object, error) {
+			patchAction, ok := a.(clienttesting.PatchAction)
+			if !ok {
+				return true, nil, fmt.Errorf("wrong kind of action %v", a)
+			}
+			updatedNames = append(updatedNames, patchAction.GetName())
+			return true, original, nil
+		})
+	cmd.SetArgs(args)
+	err = cmd.Execute()
+	return
+}
