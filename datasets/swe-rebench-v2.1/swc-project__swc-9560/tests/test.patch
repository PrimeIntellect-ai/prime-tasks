+#[test]
+fn issue_9559() -> Result<()> {
+    let sandbox = TempDir::new()?;
+    fs::write(
+        sandbox.path().join("index.ts"),
+        "const rootSourceMarker = 1;",
+    )?;
+    fs::create_dir(sandbox.path().join("chart.js"))?;
+    fs::create_dir(sandbox.path().join("nested"))?;
+    fs::write(
+        sandbox.path().join("nested/index.ts"),
+        "const nestedSourceMarker = 2;",
+    )?;
+
+    let mut cmd = cli()?;
+    cmd.current_dir(&sandbox).arg("compile").arg(sandbox.path());
+
+    let assertion = cmd.assert().success();
+    let output = String::from_utf8_lossy(&assertion.get_output().stdout);
+    assert!(output.contains("rootSourceMarker"), "{output}");
+    assert!(output.contains("nestedSourceMarker"), "{output}");
+
+    Ok(())
+}
