+    /// Each request has its own identifier available to route handlers.
+    func testRequestId() throws {
+        let app = HBApplication(testing: .embedded)
+        app.router.get("id") { request -> String in
+            String(describing: request.id)
+        }
+        try app.XCTStart()
+        defer { app.XCTStop() }
+
+        let firstID = try app.XCTExecute(uri: "/id", method: .GET) { response -> String in
+            let body = try XCTUnwrap(response.body)
+            return String(buffer: body)
+        }
+        let secondID = try app.XCTExecute(uri: "/id", method: .GET) { response -> String in
+            let body = try XCTUnwrap(response.body)
+            return String(buffer: body)
+        }
+
+        XCTAssertNotEqual(firstID, secondID)
+    }
 }
 
