+package main
+
+import (
+	"io/ioutil"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestCustomLinterWithoutPartitionStrategyCanRun(t *testing.T) {
+	tmpdir, err := ioutil.TempDir("", "custom-linter")
+	require.NoError(t, err)
+	defer os.RemoveAll(tmpdir)
+	require.NoError(t, ioutil.WriteFile(filepath.Join(tmpdir, "foo.go"), []byte("package foo\n"), 0644))
+
+	linter, err := NewLinter(LinterConfig{
+		Command: "true",
+		Pattern: "path",
+	})
+	require.NoError(t, err)
+
+	issues, errors := runLinters(map[string]*Linter{"custom": linter}, []string{tmpdir}, 1, nil, nil)
+	for range issues {
+	}
+	for err := range errors {
+		require.NoError(t, err)
+	}
+}
