+package token
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/distribution/distribution/v3/registry/auth"
+)
+
+// newAutoRedirectController builds a token access controller with autoredirect
+// enabled. setAutoRedirectPath controls whether the option is present, allowing
+// omitted and explicitly empty paths to be tested separately.
+func newAutoRedirectController(t *testing.T, autoRedirectPath string, setAutoRedirectPath bool) auth.AccessController {
+	t.Helper()
+
+	rootKeys, err := makeRootKeys(1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rootCertBundleFilename, err := writeTempRootCerts(rootKeys[:1])
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.Remove(rootCertBundleFilename) })
+
+	options := map[string]interface{}{
+		"realm":          "https://auth.example.com/token/",
+		"issuer":         "test-issuer.example.com",
+		"service":        "test-service.example.com",
+		"rootcertbundle": rootCertBundleFilename,
+		"autoredirect":   true,
+	}
+	if setAutoRedirectPath {
+		options["autoredirectpath"] = autoRedirectPath
+	}
+
+	ac, err := auth.GetAccessController("token", options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return ac
+}
+
+// autoRedirectRealm issues an unauthenticated request through the access
+// controller and returns the realm advertised in the WWW-Authenticate
+// challenge header.
+func autoRedirectRealm(t *testing.T, ac auth.AccessController, req *http.Request) string {
+	t.Helper()
+
+	_, err := ac.Authorized(req, auth.Access{
+		Resource: auth.Resource{Type: "repository", Name: "foo/bar"},
+		Action:   "pull",
+	})
+	challenge, ok := err.(auth.Challenge)
+	if !ok {
+		t.Fatalf("expected an auth challenge, got %v", err)
+	}
+
+	w := httptest.NewRecorder()
+	challenge.SetHeaders(req, w)
+
+	header := w.Header().Get("WWW-Authenticate")
+	const prefix = `realm="`
+	start := strings.Index(header, prefix)
+	if start < 0 {
+		t.Fatalf("no realm in challenge header %q", header)
+	}
+	start += len(prefix)
+	end := strings.Index(header[start:], `"`)
+	if end < 0 {
+		t.Fatalf("unterminated realm in challenge header %q", header)
+	}
+	return header[start : start+end]
+}
+
+func TestAutoRedirectRealm(t *testing.T) {
+	cases := []struct {
+		name                string
+		forwardedProto      string
+		autoRedirectPath    string
+		setAutoRedirectPath bool
+		wantRealm           string
+	}{
+		{
+			name:      "defaults to https scheme",
+			wantRealm: "https://example.com/auth/token",
+		},
+		{
+			name:           "honours forwarded proto",
+			forwardedProto: "http",
+			wantRealm:      "http://example.com/auth/token",
+		},
+		{
+			name:                "honours configured path",
+			forwardedProto:      "http",
+			autoRedirectPath:    "/custom/path",
+			setAutoRedirectPath: true,
+			wantRealm:           "http://example.com/custom/path",
+		},
+		{
+			name:                "defaults when configured path is empty",
+			setAutoRedirectPath: true,
+			wantRealm:           "https://example.com/auth/token",
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			ac := newAutoRedirectController(t, tc.autoRedirectPath, tc.setAutoRedirectPath)
+
+			req := httptest.NewRequest(http.MethodGet, "http://example.com/v2/", nil)
+			if tc.forwardedProto != "" {
+				req.Header.Set("X-Forwarded-Proto", tc.forwardedProto)
+			}
+
+			if got := autoRedirectRealm(t, ac, req); got != tc.wantRealm {
+				t.Errorf("realm = %q, want %q", got, tc.wantRealm)
+			}
+		})
+	}
+}
