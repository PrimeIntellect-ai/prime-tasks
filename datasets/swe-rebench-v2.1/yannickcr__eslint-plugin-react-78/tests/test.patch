@@ -0,0 +1,174 @@
+/**
+ * @fileoverview Enforce component methods order
+ * @author Yannick Croissant
+ */
+'use strict';
+
+var assert = require('assert');
+var eslint = require('eslint').linter;
+var plugin = require('../../..');
+require('babel-eslint');
+
+var ruleAlias = 'component-order-contract-check';
+var correctlyOrderedProbe = [
+  'var Hello = React.createClass({',
+  '  componentWillMount: function() {},',
+  '  onClick: function() {},',
+  '  render: function() { return <div/>; }',
+  '});'
+].join('\n');
+var incorrectlyOrderedProbe = [
+  'var Hello = React.createClass({',
+  '  onClick: function() {},',
+  '  componentWillMount: function() {},',
+  '  render: function() { return <div/>; }',
+  '});'
+].join('\n');
+
+function findOrderingRule() {
+  var ruleIds = Object.keys(plugin.rules);
+  for (var i = 0; i < ruleIds.length; i++) {
+    eslint.defineRule(ruleAlias, plugin.rules[ruleIds[i]]);
+    var config = {
+      rules: {},
+      ecmaFeatures: {classes: true, jsx: true}
+    };
+    config.rules[ruleAlias] = 1;
+    if (
+      eslint.verify(correctlyOrderedProbe, config).length === 0 &&
+      eslint.verify(incorrectlyOrderedProbe, config).length > 0
+    ) {
+      return plugin.rules[ruleIds[i]];
+    }
+  }
+}
+
+var orderingRule = findOrderingRule();
+
+function lint(code) {
+  if (!orderingRule) {
+    return [];
+  }
+  eslint.defineRule(ruleAlias, orderingRule);
+  return eslint.verify(code, {
+    rules: (function() {
+      var rules = {};
+      rules[ruleAlias] = 1;
+      return rules;
+    }()),
+    ecmaFeatures: {classes: true, jsx: true}
+  });
+}
+
+function component(members) {
+  return [
+    'var Hello = React.createClass({',
+    members,
+    '});'
+  ].join('\n');
+}
+
+function classComponent(members) {
+  return [
+    'class Hello extends React.Component {',
+    members,
+    '}'
+  ].join('\n');
+}
+
+describe('component method ordering', function() {
+  it('accepts lifecycle entries followed by custom methods and render', function() {
+    var code = component([
+      '  displayName: "Hello",',
+      '  propTypes: {},',
+      '  mixins: [],',
+      '  getInitialState: function() {},',
+      '  componentWillMount: function() {},',
+      '  componentWillUnmount: function() {},',
+      '  onChange: function() {},',
+      '  onCreate: function() {},',
+      '  render: function() { return <div/>; }'
+    ].join('\n'));
+    assert.strictEqual(lint(code).length, 0);
+  });
+
+  it('accepts components that omit optional members', function() {
+    var code = component('  render: function() { return <div/>; }');
+    assert.strictEqual(lint(code).length, 0);
+  });
+
+  it('accepts custom methods before render', function() {
+    var code = component([
+      '  onClick: function() {},',
+      '  render: function() { return <button/>; }'
+    ].join('\n'));
+    assert.strictEqual(lint(code).length, 0);
+  });
+
+
+  it('reports lifecycle methods that appear out of progression order', function() {
+    var code = component([
+      '  componentWillUnmount: function() {},',
+      '  componentWillMount: function() {},',
+      '  render: function() { return <div/>; }'
+    ].join('\n'));
+    assert(lint(code).length > 0);
+  });
+
+  it('accepts lifecycle methods in progression order when intermediate methods are omitted', function() {
+    var code = component([
+      '  getInitialState: function() {},',
+      '  componentDidMount: function() {},',
+      '  componentWillUnmount: function() {},',
+      '  render: function() { return <div/>; }'
+    ].join('\n'));
+    assert.strictEqual(lint(code).length, 0);
+  });
+  it('reports when render precedes a lifecycle entry', function() {
+    var code = component([
+      '  render: function() { return <div/>; },',
+      '  displayName: "Hello"'
+    ].join('\n'));
+    assert(lint(code).length > 0);
+  });
+
+  it('reports when render precedes a custom method', function() {
+    var code = component([
+      '  render: function() { return <div/>; },',
+      '  onClick: function() {}'
+    ].join('\n'));
+    assert(lint(code).length > 0);
+  });
+
+  it('reports when a custom method precedes a lifecycle entry', function() {
+    assert(lint(incorrectlyOrderedProbe).length > 0);
+  });
+
+
+  it('accepts lifecycle entries before custom methods in ES6 classes', function() {
+    var code = classComponent([
+      '  componentWillMount() {}',
+      '  onClick() {}',
+      '  render() { return <div/>; }'
+    ].join('\n'));
+    assert.strictEqual(lint(code).length, 0);
+  });
+
+  it('reports when a custom method precedes a lifecycle entry in an ES6 class', function() {
+    var code = classComponent([
+      '  onClick() {}',
+      '  componentWillMount() {}',
+      '  render() { return <div/>; }'
+    ].join('\n'));
+    assert(lint(code).length > 0);
+  });
+
+  it('reports when render is not last in an ES6 class', function() {
+    var code = classComponent([
+      '  componentWillMount() {}',
+      '  render() { return <div/>; }',
+      '  onClick() {}'
+    ].join('\n'));
+    assert(lint(code).length > 0);
+  });
+});
