+def _count_log_lines():
+    """Count lines across every log file the application writes to"""
+    log_dir = os.path.join(os.path.dirname(utils.__file__), 'logs')
+    total = 0
+    for path in glob.glob(os.path.join(log_dir, '*.log')):
+        with open(path) as f:
+            total += sum(1 for _ in f)
+    return total
+
+
+def test_failed_login_attempt_is_logged():
+    """A failed login attempt should be recorded in a log file"""
+    app = create_ctfd()
+    with app.app_context():
+        register_user(app)
+        before = _count_log_lines()
+        client = login_as_user(app, name="user", password="wrong_password")
+        after = _count_log_lines()
+        assert after > before
+    destroy_ctfd(app)
+
