+
+    def test_read_page_examples(self):
+        # https://es.wiktionary.org/wiki/read
+        # The "ejemplo" template does not expand to HTML tags when only the
+        # example text is given, so the examples for senses 4, 6 and 7 must
+        # still be extracted.
+        self.wxr.wtp.add_page("Plantilla:lengua", 10, "Inglés")
+        self.wxr.wtp.add_page(
+            "Plantilla:verbo transitivo", 10, "Verbo transitivo"
+        )
+        self.wxr.wtp.add_page("Plantilla:plm", 10, "{{{1}}}")
+        self.wxr.wtp.add_page(
+            "Plantilla:ejemplo", 10, ":*'''Ejemplo:''' {{{1}}}"
+        )
+        page_data = parse_page(
+            self.wxr,
+            "read",
+            """== {{lengua|en}} ==
+=== {{verbo transitivo|en}} ===
+;1: {{plm|leer}}.
+;4: {{plm|entender}}, [[comprender]].
+{{ejemplo|Do you read me?}}
+;6: {{plm|interpretar}}.
+{{ejemplo|A repeater signal may be used where the track geometry makes the main signal difficult to read from a distance.}}
+;7: {{plm|estudiar}}.
+{{ejemplo|I am reading theology at university.}}
+""",
+        )
+        examples_by_index = {}
+        for entry in page_data:
+            for sense in entry["senses"]:
+                for example in sense.get("examples", []):
+                    examples_by_index.setdefault(
+                        sense.get("sense_index"), []
+                    ).append(example["text"])
+        self.assertIn("Do you read me?", examples_by_index.get("4", []))
+        self.assertIn(
+            "A repeater signal may be used where the track geometry makes "
+            "the main signal difficult to read from a distance.",
+            examples_by_index.get("6", []),
+        )
+        self.assertIn(
+            "I am reading theology at university.",
+            examples_by_index.get("7", []),
+        )
