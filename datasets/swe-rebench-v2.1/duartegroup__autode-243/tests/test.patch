+@testutils.work_in_zipped_dir(os.path.join(here, "data", "hessians.zip"))
+def test_hessian_units_and_values_retained_after_attribute_inspection():
+    """Inspecting available Hessian attributes must be non-mutating."""
+
+    h2o = Molecule("H2O_hess_orca.xyz")
+    h2o.hessian = h2o_hessian_arr
+    units_before = h2o.hessian.units
+    values_before = np.array(h2o.hessian, copy=True)
+
+    # Interactive completion/inspection enumerates attributes and may evaluate
+    # Hessian-derived properties.
+    inspect.getmembers(h2o.hessian)
+
+    assert h2o.hessian.units == units_before
+    assert np.allclose(np.asarray(h2o.hessian), values_before)
+
+
+@testutils.work_in_zipped_dir(os.path.join(here, "data", "hessians.zip"))
+def test_hessian_units_retained_after_normal_modes():
+    """Calculating normal modes must not change the Hessian units or values"""
+
+    h2o = Molecule("H2O_hess_orca.xyz")
+    h2o.hessian = h2o_hessian_arr
+    units_before = h2o.hessian.units
+    values_before = np.array(h2o.hessian, copy=True)
+
+    _ = h2o.hessian.normal_modes
+
+    # Neither the units nor the underlying values should have changed
+    assert h2o.hessian.units == units_before
+    assert np.allclose(np.asarray(h2o.hessian), values_before)
+
