+    def test_launcher_runs_from_subdirectories_of_lib_dir(self):
+        repository_root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+        launcher = os.path.join(repository_root, "bin", "waagent")
+        script = textwrap.dedent("""
+            import runpy
+            import sys
+            import azurelinuxagent.common.conf as conf
+
+            launcher, lib_dir = sys.argv[1:3]
+            conf.get_lib_dir = lambda: lib_dir
+            sys.argv = [launcher, "-version"]
+            runpy.run_path(launcher, run_name="__main__")
+        """)
+        environment = os.environ.copy()
+        environment["PYTHONPATH"] = repository_root + os.pathsep + environment.get("PYTHONPATH", "")
+        for subdirectory in ("events", os.path.join("extensions", "nested")):
+            working_directory = os.path.join(self.tmp_dir, subdirectory)
+            if not os.path.isdir(working_directory):
+                os.makedirs(working_directory)
+            process = subprocess.Popen(
+                [sys.executable, "-c", script, launcher, self.tmp_dir],
+                cwd=working_directory,
+                env=environment,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE)
+            stdout, stderr = process.communicate()
+            self.assertEqual(0, process.returncode, stderr.decode("utf-8"))
+        return
+
