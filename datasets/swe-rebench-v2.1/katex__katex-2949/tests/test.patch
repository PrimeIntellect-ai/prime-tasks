+    it("\\char escapes ~ correctly", () => {
+        // Collect the rendered text from the built HTML tree.
+        const renderedText = (expr) => {
+            const collect = (node) => {
+                if (typeof node === "string") {
+                    return node;
+                }
+                let text = node.text || "";
+                if (node.children) {
+                    text += node.children.map(collect).join("");
+                }
+                return text;
+            };
+            return getBuilt(expr).map(collect).join("");
+        };
+        // \char`\~ produces a literal (raised) tilde, not a space.
+        expect(renderedText("\\char`\\~")).toEqual("~");
+        // The reported text-mode input renders the same way.
+        expect(renderedText("\\text{\\char`\\~}")).toEqual("~");
+    });
