+func TestGenericPrinterDisabledOutput(t *testing.T) {
+	previousDisableOutput := DisableOutput
+	DisableOutput = true
+	defer func() { DisableOutput = previousDisableOutput }()
+
+	printers := []TextPrinter{DefaultSection, DefaultHeader}
+	prefixPrinters := []PrefixPrinter{Info, Success, Warning, Error, *Fatal.WithFatal(false)}
+	for _, printer := range prefixPrinters {
+		printers = append(printers, printer)
+	}
+
+	for _, printer := range printers {
+		t.Run("Print", func(t *testing.T) {
+			out := captureStdout(func(w io.Writer) {
+				printer.Print("silent")
+			})
+			assert.Empty(t, out)
+		})
+		t.Run("Println", func(t *testing.T) {
+			out := captureStdout(func(w io.Writer) {
+				printer.Println("silent")
+			})
+			assert.Empty(t, out)
+		})
+		t.Run("Printf", func(t *testing.T) {
+			out := captureStdout(func(w io.Writer) {
+				printer.Printf("%s", "silent")
+			})
+			assert.Empty(t, out)
+		})
+	}
+}
