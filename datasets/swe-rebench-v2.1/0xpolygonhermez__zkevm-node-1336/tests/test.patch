+// loadRPCConfig loads RPC settings using the public TOML configuration keys.
+func loadRPCConfig(t *testing.T, rpcSettings string) jsonrpc.Config {
+	t.Helper()
+	configFile, err := os.CreateTemp("", "rpc-config-*.toml")
+	require.NoError(t, err)
+	defer os.Remove(configFile.Name())
+	_, err = fmt.Fprintf(configFile, "[RPC]\n%s", rpcSettings)
+	require.NoError(t, err)
+	require.NoError(t, configFile.Close())
+
+	genesisFile, err := os.CreateTemp("", "genesis-config-*")
+	require.NoError(t, err)
+	defer os.Remove(genesisFile.Name())
+	require.NoError(t, os.WriteFile(genesisFile.Name(), []byte("{}"), 0600))
+
+	flagSet := flag.NewFlagSet("", flag.PanicOnError)
+	flagSet.String(config.FlagCfg, configFile.Name(), "")
+	flagSet.String(config.FlagGenesisFile, genesisFile.Name(), "")
+	ctx := cli.NewContext(cli.NewApp(), flagSet, nil)
+	loaded, err := config.Load(ctx)
+	require.NoError(t, err)
+	return loaded.RPC
+}
