+// A repeat sync has no destination-only objects to remove.
+func TestSyncLocalToS3BucketWithDeleteWhenAlreadyInSync(t *testing.T) {
+	t.Parallel()
+
+	s3client, s5cmd := setup(t)
+	bucket := s3BucketFromTestName(t)
+	createBucket(t, s3client, bucket)
+
+	workdir := fs.NewDir(t, "source", fs.WithFile("source.txt", "source content"))
+	defer workdir.Remove()
+
+	src := filepath.ToSlash(workdir.Path()) + "/"
+	dst := fmt.Sprintf("s3://%s/", bucket)
+
+	for run := 0; run < 2; run++ {
+		result := icmd.RunCmd(s5cmd("sync", "--delete", src, dst))
+		result.Assert(t, icmd.Success)
+	}
+
+	assert.Assert(t, ensureS3Object(s3client, bucket, "source.txt", "source content"))
+	_, err := os.Stat(filepath.Join(workdir.Path(), "source.txt"))
+	assert.NilError(t, err)
+}
