+        Object result = new JythonEvaluable("return None").evaluate(new Properties());
+        Assert.assertNull(result);
+    }
+
+    @Test
+    public void testOtherPythonObjectIsPreserved() {
+        Object result = new JythonEvaluable("return object()").evaluate(new Properties());
+        Assert.assertTrue(result instanceof PyObject);
+        Assert.assertEquals(((PyObject) result).getType().getName(), "object");
+    }
+
+    @Test
+    public void testJythonDataTypes() {
+        Properties bindings = new Properties(); // tests are self-contained, so no bindings needed
+
+        // Test sequences
+        Evaluable evaluable = new JythonEvaluable("return (1,2)");
+        Object result = evaluable.evaluate(bindings);
+        Object[] sequence = (Object[]) result;
+        Assert.assertEquals(sequence.length, 2);
+        Assert.assertEquals(sequence[0], 1L);
+        Assert.assertEquals(sequence[1], 2L);
+
+        // Test floats
+        evaluable = new JythonEvaluable("return 1.2");
+        result = evaluable.evaluate(bindings);
+        Assert.assertEquals(result, 1.2);
+
+        // Test integers
+        evaluable = new JythonEvaluable("return 1");
+        result = evaluable.evaluate(bindings);
+        Assert.assertEquals(result, 1L);
+
+        // Test strings
+        evaluable = new JythonEvaluable("return 'foo'");
+        result = evaluable.evaluate(bindings);
+        Assert.assertEquals(result, "foo");
+
+    }
