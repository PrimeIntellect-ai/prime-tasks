diff --git a/test/server/middleware.test.js b/test/server/middleware.test.js
new file mode 100644
index 0000000..c722cfd
--- /dev/null
+++ b/test/server/middleware.test.js
@@ -0,0 +1,113 @@
+import Koa from 'koa'
+import supertest from 'supertest-as-promised'
+import { expect } from 'chai'
+import generateProblemMiddleware, { generateProblemResponseFromAppError as problem } from '../../server/middleware/problem'
+
+
+describe('problem middleware', () => {
+  let ERROR
+
+  beforeEach(() => {
+    ERROR = {
+      expose: false, // is set by koa. true when calling ctx.throw(), false when random error was thrown
+      status: 422,
+      detail: 'very detailed stack trace',
+      title: 'detailed explanation what happened',
+      type: Symbol('foo')
+    }
+  })
+
+  it('should have status and title even if there is no input', () => {
+    const result = problem()
+    expect(result).to.have.keys('status', 'title')
+    expect(result.status).to.equal(500)
+    expect(result.title).to.equal('Internal server error')
+  })
+
+  it('should convert standard errors to problems', () => {
+    const message = 'something happened'
+    const error = new Error(message)
+    const result = problem(error)
+    expect(result).to.have.keys('status', 'title')
+    expect(result.status).to.equal(500)
+    expect(result.title).to.equal(message)
+  })
+
+  it('should return detailed problem+json', () => {
+    const result = problem(ERROR)
+    expect(result).to.have.keys('status', 'detail', 'title', 'type')
+    expect(result.status).to.equal(ERROR.status)
+    expect(result.detail).to.equal(ERROR.detail)
+    expect(result.title).to.equal(ERROR.title)
+    expect(result.type).to.equal('foo')
+  })
+
+  it('should accept statusCode as an alternative status source', () => {
+    const result = problem({statusCode: 404})
+    expect(result.status).to.equal(404)
+  })
+
+  it('should include the instance identifier', () => {
+    const result = problem({instance: '/some/instance'})
+    expect(result.instance).to.equal('/some/instance')
+  })
+
+  it('should accept a string type', () => {
+    const type = 'https://example.com/probs/out-of-credit'
+    const result = problem({type})
+    expect(result.type).to.equal(type)
+  })
+
+  it('should preserve custom extension members', () => {
+    const result = problem({status: 400, foo: 'bar'})
+    expect(result.foo).to.equal('bar')
+  })
+
+  it('should strip internal fields from the result', () => {
+    const result = problem({statusCode: 404, expose: true})
+    expect(result).to.not.have.property('statusCode')
+    expect(result).to.not.have.property('expose')
+  })
+
+  it('should convert thrown errors into application/problem+json responses', async () => {
+    const app = new Koa()
+    app.use(generateProblemMiddleware({}))
+    app.use(ctx => ctx.throw(503, 'service unavailable'))
+    const res = await supertest(app.callback()).get('/')
+    expect(res.status).to.equal(503)
+    expect(res.headers['content-type']).to.contain('application/problem+json')
+    expect(res.body.status).to.equal(503)
+    expect(res.body.title).to.be.a('string').and.not.empty
+  })
+
+  it('should use statusCode for a downstream application error when status is absent', async () => {
+    const app = new Koa()
+    app.use(generateProblemMiddleware({exposableErrorTypes: ['missing-resource']}))
+    app.use(() => {
+      const error = new Error('resource missing')
+      error.type = 'missing-resource'
+      error.statusCode = 404
+      throw error
+    })
+    const res = await supertest(app.callback()).get('/')
+    expect(res.status).to.equal(404)
+    expect(res.headers['content-type']).to.contain('application/problem+json')
+    expect(res.body.status).to.equal(404)
+  })
+
+  it('should convert a non-Koa downstream Error into a problem response', async () => {
+    const app = new Koa()
+    app.use(generateProblemMiddleware({}))
+    app.use(() => {
+      const error = new Error('unexpected failure')
+      error.status = 500
+      throw error
+    })
+    const res = await supertest(app.callback()).get('/')
+    expect(res.status).to.equal(500)
+    expect(res.headers['content-type']).to.contain('application/problem+json')
+    expect(res.body).to.be.an('object')
+    expect(res.body.status).to.equal(500)
+    expect(res.body.title).to.equal('unexpected failure')
+  })
+})
