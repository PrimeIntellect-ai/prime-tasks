+<?php
+
+declare(strict_types=1);
+
+namespace Spatie\DataTransferObject\Tests;
+
+use Spatie\DataTransferObject\DataTransferObject;
+use Spatie\DataTransferObject\DataTransferObjectCollection;
+
+class NestedDataTransferObjectCollectionTest extends TestCase
+{
+    /** @test */
+    public function with_typed_properties()
+    {
+        $a = new DtoParentPropertyType([
+            'children' => [
+                ['name' => 'test'],
+                ['name' => 'test2'],
+                ['name' => 'test3'],
+            ],
+        ]);
+
+        $this->assertInstanceOf(DtoChildPropertyTypeCollection::class, $a->children);
+        $this->assertEquals('test', $a->children[0]->name);
+        $this->assertEquals('test2', $a->children[1]->name);
+        $this->assertEquals('test3', $a->children[2]->name);
+    }
+
+    /** @test */
+    public function with_parent_docblock_property()
+    {
+        $a = new DtoParentPropertyTypeWithTypedCurrent([
+            'children' => [
+                ['name' => 'test'],
+                ['name' => 'test2'],
+                ['name' => 'test3'],
+            ],
+        ]);
+
+        $this->assertInstanceOf(DtoChildPropertyTypeCollectionWithTypedCurrent::class, $a->children);
+        $this->assertInstanceOf(DtoChildPropertyType::class, $a->children[0]);
+        $this->assertEquals('test', $a->children[0]->name);
+        $this->assertEquals('test2', $a->children[1]->name);
+        $this->assertEquals('test3', $a->children[2]->name);
+    }
+
+    /** @test */
+    public function with_collection_docblock()
+    {
+        $a = new DtoParentPropertyTypeWithCollection([
+            'children' => [
+                ['name' => 'test'],
+                ['name' => 'test2'],
+                ['name' => 'test3'],
+            ],
+        ]);
+
+        $this->assertInstanceOf(DtoChildPropertyTypeCollection::class, $a->children);
+        $this->assertInstanceOf(DtoChildPropertyType::class, $a->children->current());
+        $this->assertEquals('test', $a->children->current()->name);
+    }
+}
+
+// Scenario 1: a natively typed collection property whose element type is
+// resolved from the collection's typed current() method.
+class DtoParentPropertyType extends DataTransferObject
+{
+    public DtoChildPropertyTypeCollection $children;
+}
+
+class DtoChildPropertyType extends DataTransferObject
+{
+    public string $name;
+}
+
+class DtoChildPropertyTypeCollection extends DataTransferObjectCollection
+{
+    public function current(): DtoChildPropertyType
+    {
+        return parent::current();
+    }
+}
+
+// Scenario 2: same contract, exercised through a distinct collection class.
+class DtoParentPropertyTypeWithTypedCurrent extends DataTransferObject
+{
+    public DtoChildPropertyTypeCollectionWithTypedCurrent $children;
+}
+
+class DtoChildPropertyTypeCollectionWithTypedCurrent extends DataTransferObjectCollection
+{
+    public function current(): DtoChildPropertyType
+    {
+        return parent::current();
+    }
+}
+
+// Scenario 3: the collection's current() override exposes the cast DTO.
+class DtoParentPropertyTypeWithCollection extends DataTransferObject
+{
+    public DtoChildPropertyTypeCollection $children;
+}
