diff --git a/detox/src/utils/tempfile.test.js b/detox/src/utils/tempfile.test.js
new file mode 100644
index 00000000..e8f8052a
--- /dev/null
+++ b/detox/src/utils/tempfile.test.js
@@ -0,0 +1,72 @@
+describe('tempfile', () => {
+  let tempfile;
+
+  beforeEach(() => {
+    jest.restoreAllMocks();
+    tempfile = require('./tempfile');
+  });
+
+  const expectGeneratedPath = (result, extension = '') => {
+    const path = require('node:path');
+    expect(typeof result).toBe('string');
+    expect(path.basename(result)).toMatch(
+      new RegExp(`^detox-${process.pid}-[^/]{6}${extension}$`)
+    );
+  };
+
+  it('returns a path with the current process id and requested extension without a leading dot', () => {
+    expectGeneratedPath(tempfile('log'), '\\.log');
+  });
+
+  it('returns a path with exactly one dot for an extension that already has a leading dot', () => {
+    expectGeneratedPath(tempfile('.log'), '\\.log');
+  });
+
+  it('returns a path without an extension when extension is omitted', () => {
+    expectGeneratedPath(tempfile());
+  });
+
+  it('returns a path without an extension when extension is empty', () => {
+    expectGeneratedPath(tempfile(''));
+  });
+
+  it('returns a fresh path on each call', () => {
+    const fs = require('node:fs');
+    const firstPath = tempfile('uniqueness-check');
+
+    try {
+      fs.writeFileSync(firstPath, 'occupy the first generated path');
+      const secondPath = tempfile('uniqueness-check');
+      expect(secondPath).not.toBe(firstPath);
+    } finally {
+      fs.rmSync(firstPath, { force: true });
+    }
+  });
+
+  it('cleans up temporary files when the process exits', () => {
+    const fs = require('node:fs');
+    const path = require('node:path');
+    const { spawnSync } = require('node:child_process');
+    const modulePath = path.resolve(__dirname, './tempfile');
+    const script = `
+      const file = require(${JSON.stringify(modulePath)})('process-cleanup');
+      process.stdout.write(file);
+    `;
+    const child = spawnSync(process.execPath, ['-e', script], { encoding: 'utf8' });
+
+    expect(child.status).toBe(0);
+    expect(fs.existsSync(child.stdout)).toBe(false);
+  });
+
+  describe('package dependencies', () => {
+    it('should not list the outdated tempfile package as a dependency', () => {
+      const packageJson = require('../../package.json');
+      expect(packageJson.dependencies).not.toHaveProperty('tempfile');
+    });
+
+    it('should list tmp as a dependency', () => {
+      const packageJson = require('../../package.json');
+      expect(packageJson.dependencies).toHaveProperty('tmp');
+    });
+  });
+});
