diff --git a/compiler-core/src/type_/tests/errors.rs b/compiler-core/src/type_/tests/errors.rs
index 3eb0450d5..0aa7c2162 100644
--- a/compiler-core/src/type_/tests/errors.rs
+++ b/compiler-core/src/type_/tests/errors.rs
@@ -2685,3 +2685,35 @@ fn negative_out_of_range_erlang_float_in_pattern() {
 fn negative_out_of_range_erlang_float_in_const() {
     assert_module_error!(r#"const x = -1.8e308"#);
 }
+
+#[test]
+fn missing_case_body() {
+    let source = "case True";
+    let (errors, names) = super::compile_statement_sequence(source)
+        .expect_err("should infer an error");
+    let error = crate::error::Error::Type {
+        names,
+        src: source.into(),
+        path: camino::Utf8PathBuf::from("/src/one/two.gleam"),
+        errors,
+    };
+    let diagnostic = error.pretty_string();
+    assert!(diagnostic.contains("error: Missing case body"));
+    assert!(diagnostic.contains("This case expression is missing its body."));
+
+    let source_line = diagnostic
+        .lines()
+        .position(|line| line.contains(source))
+        .expect("the diagnostic should label the case expression");
+    let location_marker = diagnostic
+        .lines()
+        .nth(source_line + 1)
+        .expect("the diagnostic should show the case expression location");
+    assert_eq!(
+        location_marker
+            .chars()
+            .filter(|character| *character == '^')
+            .count(),
+        source.len()
+    );
+}
