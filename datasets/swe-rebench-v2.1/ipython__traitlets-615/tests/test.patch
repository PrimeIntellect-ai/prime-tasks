     _from_string_test(CUnicode, s, expected)
 
 
+@pytest.mark.parametrize(
+    "s, expected",
+    [("xyz", b"xyz"), ("1", b"1"), ('b"xx"', b"xx"), ("b'abc'", b"abc"), ("None", None)],
+)
+def test_bytes_from_string(s, expected):
+    _from_string_test(Bytes, s, expected)
+
+
+@pytest.mark.parametrize(
+    "s, expected",
+    [("xyz", b"xyz"), ("1", b"1"), ('b"xx"', b"xx"), ("b'abc'", b"abc"), ("None", None)],
+)
+def test_cbytes_from_string(s, expected):
+    _from_string_test(CBytes, s, expected)
+
+
+def test_bytes_from_string_allow_none():
+    """``"None"`` maps to ``None`` only when ``allow_none`` is True."""
+    assert Bytes(allow_none=True).from_string("None") is None
+    assert Bytes(allow_none=False).from_string("None") == b"None"
+
+
+def test_bytes_from_string_utf8():
+    """Ordinary strings are encoded as UTF-8 bytes."""
+    s = "h\u00e9llo w\u00f6rld"
+    assert Bytes().from_string(s) == s.encode("utf-8")
+
+
+@pytest.mark.parametrize("s, expected", [('b"xx"', b"xx"), ("b'abc'", b"abc")])
+def test_bytes_from_string_deprecated_quotes_warns(s, expected):
+    """Legacy ``b"..."`` syntax is stripped and emits a FutureWarning."""
+    with pytest.warns(FutureWarning):
+        assert Bytes().from_string(s) == expected
+
+
+@pytest.mark.parametrize(
+    "s, expected", [('b"xx"', b"xx"), ("b'abc'", b"abc"), ("xyz", b"xyz")]
+)
+def test_cbytes_from_string_matches_bytes(s, expected):
+    """CBytes parses strings exactly like Bytes."""
+    assert CBytes().from_string(s) == Bytes().from_string(s) == expected
+
+
+@pytest.mark.parametrize("s, expected", [('b"xx"', b"xx"), ("b'abc'", b"abc")])
+def test_cbytes_from_string_deprecated_quotes_warns(s, expected):
+    """CBytes handles legacy ``b"..."`` syntax like Bytes, emitting a FutureWarning."""
+    with pytest.warns(FutureWarning):
+        assert CBytes().from_string(s) == expected
+
+
+def test_bytes_from_string_command_line():
+    """Bytes values passed on the command line (as ipykernel does with
+    ``--Session.key=b"..."``) must be parsed to the underlying bytes rather
+    than keeping the deprecated ``b"..."`` wrapper."""
+    from traitlets.config import Application
+
+    class SessionApp(Application):
+        key = CBytes(b"", allow_none=True).tag(config=True)
+        aliases = {"key": "SessionApp.key"}
+
+    app = SessionApp()
+    app.parse_command_line(['--key=b"abc"'])
+    assert app.key == b"abc"
+
+
 @pytest.mark.parametrize(
     "s, expected",
     [("x", ValueError), ("1", 1), ("123", 123), ("2.0", ValueError), ("None", None)],
