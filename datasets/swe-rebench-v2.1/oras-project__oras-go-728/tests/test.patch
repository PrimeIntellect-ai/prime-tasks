+// TestDynamicStore_Put_RetrySetCredsStore verifies that when setting the
+// credential store fails during a Put, a subsequent Put retries setting it
+// instead of silently succeeding.
+func TestDynamicStore_Put_RetrySetCredsStore(t *testing.T) {
+	// install fake credential helpers so that a default native store is
+	// detected and used by the DynamicStore.
+	binDir := t.TempDir()
+	helperScript := "#!/bin/sh\ncat >/dev/null\nexit 0\n"
+	for _, name := range []string{
+		"docker-credential-pass",
+		"docker-credential-secretservice",
+		"docker-credential-osxkeychain",
+		"docker-credential-wincred",
+	} {
+		if err := os.WriteFile(filepath.Join(binDir, name), []byte(helperScript), 0755); err != nil {
+			t.Fatal("failed to write fake credential helper:", err)
+		}
+	}
+	t.Setenv("PATH", binDir+string(os.PathListSeparator)+os.Getenv("PATH"))
+
+	tempDir := t.TempDir()
+	configPath := filepath.Join(tempDir, "config.json")
+	ds, err := credentials.NewStore(configPath, credentials.StoreOptions{
+		DetectDefaultNativeStore: true,
+	})
+	if err != nil {
+		t.Fatal("credentials.NewStore() error =", err)
+	}
+
+	// block the config file from being written by placing a directory at its
+	// path, so that setting the credential store fails.
+	if err := os.Mkdir(configPath, 0755); err != nil {
+		t.Fatal("failed to create blocking directory:", err)
+	}
+
+	ctx := context.Background()
+	serverAddr := "test.example.com"
+	cred := auth.Credential{Username: "username", Password: "password"}
+
+	// the first Put must fail to set the credential store.
+	if err := ds.Put(ctx, serverAddr, cred); err == nil {
+		t.Fatal("DynamicStore.Put() error = nil, want error when setting the credential store fails")
+	}
+
+	// the credential store is still not settable, so a subsequent Put must
+	// retry setting it and report the failure instead of silently succeeding.
+	if err := ds.Put(ctx, serverAddr, cred); err == nil {
+		t.Fatal("DynamicStore.Put() error = nil, want error on retry when setting the credential store still fails")
+	}
+
+	// once the config file can be written again, Put must succeed.
+	if err := os.Remove(configPath); err != nil {
+		t.Fatal("failed to remove blocking directory:", err)
+	}
+	if err := ds.Put(ctx, serverAddr, cred); err != nil {
+		t.Fatalf("DynamicStore.Put() error = %v, want nil after the credential store becomes settable", err)
+	}
+}
