+import asyncio
+import os
+from unittest.mock import patch
+
+import pytest
+from aiohttp_socks import ProxyConnector
+
+from bandersnatch.master import Master
+
+
+@pytest.mark.parametrize(
+    ("mock_env", "expected_result"),
+    # The IP values here don't matter for the test and could be any sentinel value
+    [
+        # No environment variables => no configuration
+        ({}, None),
+        # Unsupported protocol => no configuration
+        ({"WSS_PROXY": "wss://192.0.2.100"}, None),
+        # Detect proto "http"
+        ({"HTTP_PROXY": "http://192.0.2.111"}, "http://192.0.2.111"),
+        # Detect proto "socks4"
+        ({"SOCKS4_PROXY": "socks4://192.0.2.112:1080"}, "socks4://192.0.2.112:1080"),
+        # Detect proto "socks"
+        ({"SOCKS_PROXY": "socks5://192.0.2.113:1080"}, "socks5://192.0.2.113:1080"),
+        # Detect ALL_PROXY
+        ({"ALL_PROXY": "socks5://192.0.2.114:1080"}, "socks5://192.0.2.114:1080"),
+        # prefer https to http, if both are set
+        (
+            {"HTTP_PROXY": "http://192.0.2.111", "HTTPS_PROXY": "https://192.0.2.112"},
+            "https://192.0.2.112",
+        ),
+        # prefer socks to https
+        (
+            {
+                "HTTPS_PROXY": "https://192.0.2.112",
+                "SOCKS_PROXY": "socks4://192.0.2.113:1080",
+            },
+            "socks4://192.0.2.113:1080",
+        ),
+        # prefer socks to http and socks5 to socks4
+        (
+            {
+                "HTTPS_PROXY": "https://192.0.2.112",
+                "SOCKS4_PROXY": "socks4://192.0.2.113:1080",
+                "SOCKS5_PROXY": "socks5://192.0.2.114:1080",
+            },
+            "socks5://192.0.2.114:1080",
+        ),
+    ],
+)
+def test_proxy_address_from_env(
+    mock_env: dict[str, str], expected_result: str | None
+) -> None:
+    from bandersnatch.config.proxy import proxy_address_from_env
+
+    with patch.dict(os.environ, mock_env, clear=True):
+        actual_result = proxy_address_from_env()
+        assert actual_result == expected_result
+
+
+def test_proxy_address_from_env__os_specific_source() -> None:
+    # A proxy that is only available through an OS-specific source (and not
+    # through environment variables) is still detected, because the process
+    # environment is read through urllib's getproxies().
+    import bandersnatch.config.proxy as proxy_module
+    from bandersnatch.config.proxy import proxy_address_from_env
+
+    os_specific = {"http": "http://192.0.2.200:8080"}
+    with patch.dict(os.environ, {}, clear=True):
+        with patch("urllib.request.getproxies", return_value=os_specific):
+            if hasattr(proxy_module, "getproxies"):
+                with patch.object(proxy_module, "getproxies", return_value=os_specific):
+                    assert proxy_address_from_env() == "http://192.0.2.200:8080"
+            else:
+                assert proxy_address_from_env() == "http://192.0.2.200:8080"
+
+
+@pytest.mark.parametrize("arg", ["wss://192.0.2.113"])
+def test_get_aiohttp_proxy_kwargs__unsupported_arguments(
+    arg: str,
+) -> None:
+    from bandersnatch.config.proxy import get_aiohttp_proxy_kwargs
+
+    assert get_aiohttp_proxy_kwargs(arg) == {}
+
+
+@pytest.mark.parametrize(
+    "arg",
+    [
+        # testing schemes
+        "http://192.0.2.111",
+        "https://192.0.2.112",
+        "HTTPS://192.0.2.112",
+        # testing host addresses
+        "http://192.0.2.111:8080/",
+        "http://[2001:db8::1234]",
+        "http://[2001:0db8:0:0:0:0:0:1234]:8080",
+    ],
+)
+def test_get_aiohttp_proxy_kwargs__http_urls(arg: str) -> None:
+    from bandersnatch.config.proxy import get_aiohttp_proxy_kwargs
+
+    assert get_aiohttp_proxy_kwargs(arg) == {"proxy": arg, "trust_env": True}
+
+
+# Creating an 'aiohttp_socks.ProxyConnector' requires an event loop because its
+# initializer calls 'asyncio.get_running_loop()', so these tests are async.
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "arg",
+    [
+        "socks4://198.51.100.111:1080",
+        "socks5://198.51.100.112:1080/",
+        "SOCKS5://198.51.100.112:1080",
+        "socks4://[2001:db8:f1::1234]:1080",
+        "socks5://[2001:0db8:00f1:0000:0000:0000:0000:1234]:1080/",
+    ],
+)
+async def test_get_aiohttp_proxy_kwargs__socks_urls(arg: str) -> None:
+    from bandersnatch.config.proxy import get_aiohttp_proxy_kwargs
+
+    result = get_aiohttp_proxy_kwargs(arg)
+    assert "connector" in result
+    assert isinstance(result["connector"], ProxyConnector)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    ("arg", "expect_socks"),
+    [
+        (None, False),
+        ("", False),
+        ("socks4://198.51.100.111:1080", True),
+        ("socks5://[2001:db8:f1::1234]:1080", True),
+    ],
+)
+async def test_master_uses_socks_proxy_from_config(
+    arg: str | None, expect_socks: bool
+) -> None:
+    # clear os.environ so that urllib.request.getproxies doesn't pick up
+    # possible proxy configuration on the test runner
+    with patch.dict(os.environ, {}, clear=True):
+        async with Master("https://unit.test/simple/", proxy=arg) as mas:
+            assert isinstance(mas.session.connector, ProxyConnector) == expect_socks
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    ("mock_env", "expect_socks"),
+    [
+        ({}, False),
+        ({"WSS_PROXY": "wss://foo.bar.baz"}, False),
+        ({"http_proxy": "http://192.0.2.111"}, False),
+        ({"SOCKS_PROXY": "socks4://198.51.100.111:1080"}, True),
+        ({"ALL_PROXY": "socks5://198.51.100.112:1080"}, True),
+        (
+            {
+                "http_proxy": "http://192.0.2.111",
+                "all_proxy": "socks5://198.51.100.112:1080",
+            },
+            False,
+        ),
+        ({"socks4_proxy": "http://lolnotsocks.test:8080"}, False),
+    ],
+)
+async def test_master_uses_socks_proxy_from_env(
+    mock_env: dict[str, str], expect_socks: bool
+) -> None:
+    with patch.dict(os.environ, mock_env, clear=True):
+        async with Master("https://unit.test/simple/", proxy=None) as mas:
+            assert isinstance(mas.session.connector, ProxyConnector) == expect_socks
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("use_configured_proxy", [True, False])
+async def test_master_routes_http_requests_through_proxy(
+    use_configured_proxy: bool,
+) -> None:
+    async def make_proxy() -> tuple[asyncio.AbstractServer, list[bytes], str]:
+        requests: list[bytes] = []
+
+        async def handle_request(
+            reader: asyncio.StreamReader, writer: asyncio.StreamWriter
+        ) -> None:
+            request_line = await reader.readline()
+            requests.append(request_line)
+            while await reader.readline() not in (b"\r\n", b""):
+                pass
+            writer.write(
+                b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
+            )
+            await writer.drain()
+            writer.close()
+            await writer.wait_closed()
+
+        server = await asyncio.start_server(handle_request, "127.0.0.1", 0)
+        port = server.sockets[0].getsockname()[1]
+        return server, requests, f"http://127.0.0.1:{port}"
+
+    configured_server, configured_requests, configured_url = await make_proxy()
+    environment_server, environment_requests, environment_url = await make_proxy()
+    try:
+        configured_proxy = configured_url if use_configured_proxy else None
+        with patch.dict(os.environ, {"HTTP_PROXY": environment_url}, clear=True):
+            async with Master(
+                "https://unit.test/simple/",
+                proxy=configured_proxy,
+                timeout=1,
+                global_timeout=2,
+            ) as master:
+                async for _ in master.get("http://unit.test/resource", None):
+                    pass
+
+        assert bool(configured_requests) is use_configured_proxy
+        assert bool(environment_requests) is (not use_configured_proxy)
+    finally:
+        configured_server.close()
+        environment_server.close()
+        await configured_server.wait_closed()
+        await environment_server.wait_closed()
