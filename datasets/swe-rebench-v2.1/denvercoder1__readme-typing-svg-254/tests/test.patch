diff --git a/tests/OptionsTest.php b/tests/OptionsTest.php
index 697b8fe..382c029 100644
--- a/tests/OptionsTest.php
+++ b/tests/OptionsTest.php
@@ -338,4 +338,35 @@ final class OptionsTest extends TestCase
         $this->assertEquals(";;", $model->separator);
         $this->assertEquals(["text", "tex;t2"], $model->lines);
     }
+
+    /**
+     * Test random order
+     */
+    public function testRandom(): void
+    {
+        // not set
+        $params = [
+            "lines" => "text",
+        ];
+        $model = new RendererModel("src/templates/main.php", $params);
+        $this->assertSame(false, $model->random);
+
+        // true
+        $params = [
+            "lines" => "text",
+            "random" => "true",
+        ];
+        $model = new RendererModel("src/templates/main.php", $params);
+        $this->assertSame(true, $model->random);
+
+        // any value other than the exact string "true"
+        foreach (["false", "other"] as $value) {
+            $params = [
+                "lines" => "text",
+                "random" => $value,
+            ];
+            $model = new RendererModel("src/templates/main.php", $params);
+            $this->assertSame(false, $model->random);
+        }
+    }
 }
diff --git a/tests/RendererTest.php b/tests/RendererTest.php
index 7d122db..0674da0 100644
--- a/tests/RendererTest.php
+++ b/tests/RendererTest.php
@@ -304,4 +304,63 @@ final class RendererTest extends TestCase
         $actualSVG = $controller->render();
         $this->compareNoCommentsOrWhitespace($expectedSVG, $actualSVG);
     }
+
+    /**
+     * Test random
+     */
+    public function testRandom(): void
+    {
+        $lines = [];
+        for ($i = 0; $i < 20; ++$i) {
+            $lines[] = "Line number $i";
+        }
+
+        $observedDifferentOrder = false;
+        for ($attempt = 0; $attempt < 50; ++$attempt) {
+            $params = [
+                "lines" => implode(";", $lines),
+                "random" => "true",
+            ];
+            $controller = new RendererController($params);
+            $actualSVG = preg_replace("/\\s+/", " ", $controller->render());
+            preg_match_all("/<textPath[^>]*> (.*?) <\\/textPath>/", $actualSVG, $matches);
+            $renderedLines = $matches[1];
+
+            $this->assertCount(count($lines), $renderedLines);
+            if ($attempt === 0) {
+                foreach ($lines as $line) {
+                    $this->assertStringContainsString("> $line </textPath>", $actualSVG);
+                }
+            }
+            $sortedRendered = $renderedLines;
+            $sortedLines = $lines;
+            sort($sortedRendered);
+            sort($sortedLines);
+            $this->assertSame($sortedLines, $sortedRendered);
+            if ($renderedLines !== $lines) {
+                $observedDifferentOrder = true;
+            }
+        }
+
+        // With 20 lines the chance that every one of 50 renders keeps the input order
+        // is negligible, so at least one render must differ from the input order.
+        $this->assertTrue($observedDifferentOrder);
+    }
+
+    public function testRandomDisabledPreservesLineOrder(): void
+    {
+        $lines = [];
+        for ($i = 0; $i < 20; ++$i) {
+            $lines[] = "Stable line $i";
+        }
+
+        foreach ([[], ["random" => "false"], ["random" => "other"]] as $randomParams) {
+            $params = array_merge(["lines" => implode(";", $lines)], $randomParams);
+            $controller = new RendererController($params);
+            $actualSVG = preg_replace("/\\s+/", " ", $controller->render());
+            preg_match_all("/<textPath[^>]*> (.*?) <\\/textPath>/", $actualSVG, $matches);
+
+            $this->assertSame($lines, $matches[1]);
+        }
+    }
 }
