@@ -0,0 +1,147 @@
+"""Performance regression tests for OpenAPI parsing.
+
+These tests ensure that large OpenAPI schemas parse quickly and don't regress
+to the slow performance we had before optimization. They use a large synthetic
+schema so that no network access is required.
+"""
+
+import time
+
+import httpx
+import pytest
+
+from fastmcp import FastMCP
+from fastmcp.utilities.tests import temporary_settings
+
+
+@pytest.fixture(autouse=True)
+def use_new_openapi_parser():
+    with temporary_settings(experimental__enable_new_openapi_parser=True):
+        yield
+
+
+def _build_large_spec(num_paths: int = 600, num_defs: int = 900) -> dict:
+    """Build a large synthetic OpenAPI spec without requiring network access.
+
+    The spec contains many operations, each referencing one of many shared
+    component schemas, which is the shape that made the previous implementation
+    slow (it copied the entire set of component schemas for every operation).
+    """
+    spec: dict = {
+        "openapi": "3.0.0",
+        "info": {"title": "Large Test API", "version": "1.0.0"},
+        "servers": [{"url": "https://api.example.com"}],
+        "paths": {},
+        "components": {"schemas": {}},
+    }
+
+    for i in range(num_defs):
+        spec["components"]["schemas"][f"Def{i}"] = {
+            "type": "object",
+            "title": f"Def{i}",
+            "properties": {
+                f"field{j}": {"type": "string", "title": f"Field{j}"}
+                for j in range(10)
+            },
+            "additionalProperties": False,
+        }
+
+    for i in range(num_paths):
+        spec["paths"][f"/thing/{i}"] = {
+            "get": {
+                "operationId": f"get_thing_{i}",
+                "summary": f"Get thing {i}",
+                "responses": {
+                    "200": {
+                        "description": "ok",
+                        "content": {
+                            "application/json": {
+                                "schema": {
+                                    "$ref": f"#/components/schemas/Def{i % num_defs}"
+                                }
+                            }
+                        },
+                    }
+                },
+            }
+        }
+
+    return spec
+
+
+class TestOpenAPIPerformance:
+    """Performance tests for OpenAPI parsing with large schemas."""
+
+    async def test_large_schema_performance(self):
+        """A large OpenAPI spec must be parsed quickly.
+
+        This is a regression test to ensure the performance optimizations
+        (eliminating the full-schema deep copy and the repeated tree traversals)
+        continue to work. Without them, parsing this schema takes tens of
+        seconds; with them it takes well under a second.
+        """
+        num_paths = 600
+        schema = _build_large_spec(num_paths=num_paths, num_defs=900)
+
+        start_time = time.time()
+        mcp_server = FastMCP.from_openapi(schema, httpx.AsyncClient())
+        elapsed_time = time.time() - start_time
+
+        print(f"OpenAPI parsing took {elapsed_time:.2f}s")
+
+        # Verify the server was created successfully
+        assert mcp_server is not None
+
+        # Performance regression test: should complete in under 8 seconds
+        assert elapsed_time < 8.0, (
+            f"OpenAPI parsing took {elapsed_time:.2f}s, exceeding 8s limit. "
+            f"This suggests a performance regression."
+        )
+
+        # Verify tools were created successfully
+        tools = await mcp_server.get_tools()
+        assert len(tools) == num_paths
+
+    def test_medium_schema_performance(self):
+        """Parsing a medium synthetic schema should be fast."""
+        schema = {
+            "openapi": "3.0.0",
+            "info": {"title": "Test API", "version": "1.0.0"},
+            "paths": {},
+        }
+
+        for i in range(100):
+            path = f"/test/{i}"
+            schema["paths"][path] = {
+                "get": {
+                    "operationId": f"test_{i}",
+                    "parameters": [
+                        {"name": "param1", "in": "query", "schema": {"type": "string"}}
+                    ],
+                    "responses": {
+                        "200": {
+                            "description": "Success",
+                            "content": {
+                                "application/json": {
+                                    "schema": {
+                                        "type": "object",
+                                        "properties": {
+                                            "id": {"type": "integer"},
+                                            "name": {"type": "string"},
+                                        },
+                                    }
+                                }
+                            },
+                        }
+                    },
+                }
+            }
+
+        start_time = time.time()
+        mcp_server = FastMCP.from_openapi(schema, httpx.AsyncClient())
+        elapsed_time = time.time() - start_time
+
+        assert elapsed_time < 8.0, (
+            f"Medium schema parsing took {elapsed_time:.3f}s, expected <8s"
+        )
+        assert mcp_server is not None
