+        [
+            '''\
+def foo():
+    """This is a docstring with a link that causes a wrap.
+
+    See `the link <https://www.link.com/a/long/link/that/causes/line/break>`_ for more details.
+    """
+''',
+        ],
+    )
+    @pytest.mark.parametrize(
+        "arguments",
+        [["--wrap-descriptions", "72", "--in-place"]],
+    )
+    def test_format_docstring_with_inline_link_retain_spaces(
+        self, temporary_file, contents, arguments
+    ):
+        """Wrapping a link retains whitespace between following words."""
+        result = subprocess.run(
+            [sys.executable, "-m", "docformatter", *arguments, temporary_file],
+            capture_output=True,
+            text=True,
+        )
+        assert result.returncode != 1, result.stderr
+        with open(temporary_file) as formatted_file:
+            formatted = " ".join(formatted_file.read().split())
+        assert "more details" in formatted
+
