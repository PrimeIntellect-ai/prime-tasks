+    @pytest.mark.system
+    @pytest.mark.parametrize(
+        "contents",
+        [
+            '''\
+def foo():
+    """This is a docstring with a short link.
+
+    See `the link <https://www.link.com>`_ for more details.
+    """
+''',
+        ],
+    )
+    @pytest.mark.parametrize(
+        "arguments",
+        [["--wrap-descriptions", "72", "--in-place"]],
+    )
+    def test_format_docstring_with_short_inline_link(
+        self, temporary_file, contents, arguments
+    ):
+        """Formatting a short inline link through the CLI does not error."""
+        result = subprocess.run(
+            [sys.executable, "-m", "docformatter", *arguments, temporary_file],
+            capture_output=True,
+            text=True,
+        )
+        assert result.returncode != 1, result.stderr
+
+    @pytest.mark.system
