+// TestProcessInjectLabelsSkipsRoleLists verifies that enabling label injection
+// does not put tanka.dev labels on RoleList or RoleBindingList objects, while
+// ordinary objects in the same input still receive the label.
+func TestProcessInjectLabelsSkipsRoleLists(t *testing.T) {
+	fixture := loadFixture("list")
+
+	config := v1alpha1.New()
+	config.Metadata.Name = "testdata"
+	config.Spec.InjectLabels = true
+
+	got, err := Process(fixture.Deep.(map[string]interface{}), *config, nil)
+	require.NoError(t, err)
+
+	foundDeployment := false
+	for _, m := range got {
+		labels := m.Metadata().Labels()
+		switch m.Kind() {
+		case "RoleList", "RoleBindingList":
+			_, has := labels[LabelEnvironment]
+			require.False(t, has, "%s must not receive the %s label", m.Kind(), LabelEnvironment)
+		case "Deployment":
+			foundDeployment = true
+			require.Equal(t, config.Metadata.NameLabel(), labels[LabelEnvironment])
+		}
+	}
+	require.True(t, foundDeployment, "ordinary objects should still be processed")
+}
