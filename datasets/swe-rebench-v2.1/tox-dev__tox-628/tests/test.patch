+        monkeypatch.setenv(
+            "PYTHONPATH", os.pathsep.join(filter(None, [
+                str(plugin_dir), os.environ.get("PYTHONPATH", "")]))
+        )
+
+        result = cmd.run("tox", "--version")
+
+        assert not result.ret
+        output = result.stdout.str()
