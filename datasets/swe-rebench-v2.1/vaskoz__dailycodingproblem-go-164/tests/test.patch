+package day77_test
+
+import (
+	"reflect"
+	"testing"
+
+	"dailycodingproblem-go/day77"
+)
+
+func interval(start, end int) day77.Interval {
+	return day77.Interval{Start: start, End: end}
+}
+
+var testcases = []struct {
+	input, expected []day77.Interval
+}{
+	{nil, nil},
+	{[]day77.Interval{}, nil},
+	{[]day77.Interval{
+		interval(1, 3), interval(5, 8), interval(4, 10), interval(20, 25)},
+		[]day77.Interval{interval(1, 3), interval(4, 10), interval(20, 25)},
+	},
+	{[]day77.Interval{
+		interval(1, 3), interval(1, 8), interval(4, 10), interval(20, 25)},
+		[]day77.Interval{interval(1, 10), interval(20, 25)},
+	},
+	{[]day77.Interval{
+		interval(3, 5), interval(1, 3)},
+		[]day77.Interval{interval(1, 3), interval(3, 5)},
+	},
+}
+
+func TestMergeOverlappingIntervals(t *testing.T) {
+	t.Parallel()
+	for tcid, tc := range testcases {
+		if result := day77.MergeOverlappingIntervals(tc.input); !reflect.DeepEqual(result, tc.expected) {
+			t.Errorf("TC%d Expected %v got %v", tcid, tc.expected, result)
+		}
+	}
+}
+
+func BenchmarkMergeOverlappingIntervals(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			day77.MergeOverlappingIntervals(tc.input)
+		}
+	}
+}
