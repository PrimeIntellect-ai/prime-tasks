+
+    describe('chaining calls', function () {
+      before(function (done) {
+        setTimeout(function () {
+          done();
+        }, 50);
+      }).timeout(1500);
+
+      it('should allow overriding via chaining', function (done) {
+        setTimeout(function () {
+          done();
+        }, 50);
+      }).timeout(1500);
+
+      describe('suite-level', function () {
+        it('should work with timeout(0)', function (done) {
+          setTimeout(done, 1);
+        });
+
+        describe('nested suite', function () {
+          it('should work with timeout(0)', function (done) {
+            setTimeout(done, 1);
+          });
+        });
+      }).timeout(1000);
+    });
+
+    describe('chaining calls on hooks', function () {
+      var suite = this;
+      var suiteTimeout = suite.timeout();
+      var beforeHook = before(function () {});
+      var afterHook = after(function () {});
+      var beforeEachHook = beforeEach(function () {});
+      var afterEachHook = afterEach(function () {});
+
+      it('should return the hook from before()', function () {
+        beforeHook.timeout(500);
+        expect(beforeHook.timeout(), 'to be', 500);
+        expect(suite.timeout(), 'to be', suiteTimeout);
+      });
+
+      it('should return the hook from after()', function () {
+        afterHook.timeout(500);
+        expect(afterHook.timeout(), 'to be', 500);
+        expect(suite.timeout(), 'to be', suiteTimeout);
+      });
+
+      it('should return the hook from beforeEach()', function () {
+        beforeEachHook.timeout(500);
+        expect(beforeEachHook.timeout(), 'to be', 500);
+        expect(suite.timeout(), 'to be', suiteTimeout);
+      });
+
+      it('should return the hook from afterEach()', function () {
+        afterEachHook.timeout(500);
+        expect(afterEachHook.timeout(), 'to be', 500);
+        expect(suite.timeout(), 'to be', suiteTimeout);
+      });
+    });
   });
 });
