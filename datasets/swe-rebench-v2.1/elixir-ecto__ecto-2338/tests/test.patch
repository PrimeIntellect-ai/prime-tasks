diff --git a/test/ecto/migration_test.exs b/test/ecto/migration_test.exs
index c017fb0a..20e9177f 100644
--- a/test/ecto/migration_test.exs
+++ b/test/ecto/migration_test.exs
@@ -551,5 +551,50 @@ defmodule Ecto.MigrationTest do
            %Reference{table: "posts", column: :id, type: :binary_id}
   end
 
+  describe "preload in parallel" do
+    defmodule PreloadAdapter do
+      defmacro __before_compile__(_opts), do: :ok
+      def transaction(_repo, _opts, fun), do: {:ok, fun.()}
+      def in_transaction?(_repo), do: false
+      def rollback(_repo, value), do: throw({:ecto_rollback, value})
+    end
+
+    defmodule PreloadRepo do
+      use Ecto.Repo, otp_app: :ecto, adapter: PreloadAdapter
+    end
+
+    defmodule PreloadChildA do
+      use Ecto.Schema
+      schema "preload_child_a" do
+        belongs_to :parent, Ecto.MigrationTest.PreloadParent
+      end
+    end
+
+    defmodule PreloadChildB do
+      use Ecto.Schema
+      schema "preload_child_b" do
+        belongs_to :parent, Ecto.MigrationTest.PreloadParent
+      end
+    end
+
+    defmodule PreloadParent do
+      use Ecto.Schema
+      schema "preload_parent" do
+        has_many :children_a, Ecto.MigrationTest.PreloadChildA, foreign_key: :parent_id
+        has_many :children_b, Ecto.MigrationTest.PreloadChildB, foreign_key: :parent_id
+      end
+    end
+
+    test "completing parallel preloads does not send EXIT messages to a trapping caller" do
+      Process.flag(:trap_exit, true)
+      parent = %PreloadParent{children_a: [], children_b: []}
+
+      assert %PreloadParent{children_a: [], children_b: []} =
+             PreloadRepo.preload(parent, [:children_a, :children_b])
+
+      refute_receive {:EXIT, _pid, :normal}, 100
+    end
+  end
+
   defp last_command(), do: Process.get(:last_command)
 end
