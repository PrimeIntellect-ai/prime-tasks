+
+/// Transforms `input` (an ES module) with the CommonJS transform, evaluates the
+/// output with `node`, and returns the names and values of the module's exports
+/// as sorted `name=value` lines. `modules` maps each specifier the output may
+/// `require` to a JavaScript object literal used as that module's exports.
+fn run_commonjs_exports(input: &str, modules: &[(&str, &str)]) -> String {
+    let code = Tester::run(|tester| {
+        let module = tester.apply_transform(tr(Default::default()), "input.js", syntax(), input)?;
+        let module = module.fold_with(&mut inject_helpers());
+        Ok(tester.print(&module, &tester.comments.clone()))
+    });
+
+    let registry: String = modules
+        .iter()
+        .map(|(name, exports)| format!("{:?}: {},\n", name, exports))
+        .collect();
+
+    let script = r#"
+(function () {
+    const registry = {
+__REGISTRY__    };
+    const require = (name) => {
+        if (!(name in registry)) throw new Error("unexpected require: " + name);
+        return registry[name];
+    };
+    const module = { exports: {} };
+    const exports = module.exports;
+    (function (require, exports, module) {
+__CODE__
+    })(require, exports, module);
+    console.log(Object.keys(exports).sort().map((name) => name + "=" + exports[name]).join("\n"));
+})();
+"#
+    .replace("__REGISTRY__", &registry)
+    .replace("__CODE__", &code);
+
+    let output = std::process::Command::new("node")
+        .arg("-e")
+        .arg(&script)
+        .output()
+        .expect("failed to run node");
+    assert!(
+        output.status.success(),
+        "transformed module failed to evaluate:\n{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    String::from_utf8_lossy(&output.stdout)
+        .trim_end()
+        .to_string()
+}
+
+const CUSTOM_RENDER_MODULES: &[(&str, &str)] = &[
+    ("./customRender", "{ customRender: 'CUSTOM' }"),
+    (
+        "@testing-library/react",
+        "{ render: 'ORIGINAL', fireEvent: 'FIRE' }",
+    ),
+];
+
+#[test]
+fn issue_2101_1_named_export_overrides_wildcard_declared_first() {
+    let out = run_commonjs_exports(
+        "import { customRender } from './customRender';
+
+// re-export everything
+export * from '@testing-library/react';
+
+// override render method
+export { customRender as render };
+",
+        CUSTOM_RENDER_MODULES,
+    );
+
+    assert_eq!(out, "fireEvent=FIRE\nrender=CUSTOM");
+}
+
+#[test]
+fn issue_2101_2_named_export_overrides_wildcard_declared_last() {
+    let out = run_commonjs_exports(
+        "import { customRender } from './customRender';
+
+// override render method
+export { customRender as render };
+
+// re-export everything
+export * from '@testing-library/react';
+",
+        CUSTOM_RENDER_MODULES,
+    );
+
+    assert_eq!(out, "fireEvent=FIRE\nrender=CUSTOM");
+}
+
+#[test]
+fn issue_2101_3_reexported_name_overrides_wildcard() {
+    let out = run_commonjs_exports(
+        "// re-export everything, but keep named 'render' exported above
+export { customRender as render } from './customRender';
+export * from '@testing-library/react';
+",
+        CUSTOM_RENDER_MODULES,
+    );
+
+    assert_eq!(out, "fireEvent=FIRE\nrender=CUSTOM");
+}
+
+#[test]
+fn issue_1043_1_reexported_name_overrides_wildcard() {
+    let out = run_commonjs_exports(
+        "
+  export * from './http';
+  export { Scope } from './interfaces'
+  ",
+        &[
+            ("./http", "{ Scope: 'HTTP_SCOPE', request: 'REQUEST' }"),
+            ("./interfaces", "{ Scope: 'IFACE_SCOPE' }"),
+        ],
+    );
+
+    assert_eq!(out, "Scope=IFACE_SCOPE\nrequest=REQUEST");
+}
+
+#[test]
+fn issue_1043_2_reexported_name_overrides_wildcards_around_it() {
+    let out = run_commonjs_exports(
+        "
+import 'reflect-metadata';
+
+export * from './http';
+export { id } from './interfaces';
+export * from './pipes';
+",
+        &[
+            ("reflect-metadata", "{}"),
+            ("./http", "{ id: 'HTTP_ID', get: 'GET' }"),
+            ("./interfaces", "{ id: 'IFACE_ID' }"),
+            ("./pipes", "{ id: 'PIPE_ID', pipe: 'PIPE' }"),
+        ],
+    );
+
+    assert_eq!(out, "get=GET\nid=IFACE_ID\npipe=PIPE");
+}
