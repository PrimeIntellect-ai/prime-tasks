+    def test_inline(self):
+        class F(Form):
+            a = StringField(default=" hello ")
+            b = StringField(default="42")
+
+            def filter_a(self, value):
+                return value.strip()
+
+            def filter_b(self, value):
+                return -int(value)
+
+        form = F()
+        assert "hello" == form.a.data
+        assert -42 == form.b.data
+
+        submitted = F(DummyPostData(a=["  submitted  "], b=["17"]))
+        assert submitted.a.data == "submitted"
+        assert submitted.b.data == -17
+
+        class Obj:
+            a = "  object  "
+            b = "23"
+
+        from_object = F(obj=Obj())
+        assert from_object.a.data == "object"
+        assert from_object.b.data == -23
+
 
