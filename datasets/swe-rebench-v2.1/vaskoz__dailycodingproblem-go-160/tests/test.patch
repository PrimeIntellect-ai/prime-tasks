+package day75
+
+import "testing"
+
+func TestLongestIncreasingSubsequence(t *testing.T) {
+	t.Parallel()
+
+	testcases := []struct {
+		name           string
+		input          []int
+		expectedLength int
+	}{
+		{
+			name:           "problem example",
+			input:          []int{0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15},
+			expectedLength: 6,
+		},
+		{name: "empty", input: []int{}, expectedLength: 0},
+		{name: "decreasing", input: []int{5, 4, 3, 2, 1}, expectedLength: 1},
+		{name: "duplicates are not increasing", input: []int{2, 2, 2, 2}, expectedLength: 1},
+		{name: "increasing values need not be adjacent", input: []int{3, -1, 0, 2, 1, 4}, expectedLength: 4},
+	}
+
+	for _, tc := range testcases {
+		tc := tc
+		t.Run(tc.name, func(t *testing.T) {
+			result := any(LongestIncreasingSubsequence(tc.input))
+			switch value := result.(type) {
+			case int:
+				if value != tc.expectedLength {
+					t.Errorf("expected longest subsequence length %d, got %d", tc.expectedLength, value)
+				}
+			case []int:
+				if len(value) != tc.expectedLength {
+					t.Errorf("expected longest subsequence length %d, got %d (%v)", tc.expectedLength, len(value), value)
+				}
+			default:
+				t.Errorf("expected a length or a longest subsequence, got %T", result)
+			}
+		})
+	}
+}
+
+func BenchmarkLongestIncreasingSubsequence(b *testing.B) {
+	input := []int{0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15}
+	for i := 0; i < b.N; i++ {
+		LongestIncreasingSubsequence(input)
+	}
+}
