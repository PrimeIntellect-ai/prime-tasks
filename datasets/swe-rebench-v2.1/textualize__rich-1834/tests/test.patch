+def test_lru_cache_removed_from_methods():
+    """functools.lru_cache must not be used on methods.
+
+    A cached method keeps a reference to its instance alive via ``self``.
+    """
+    import importlib
+    import inspect
+    import pkgutil
+
+    import rich
+
+    offenders = []
+    for module_info in pkgutil.iter_modules(rich.__path__):
+        module = importlib.import_module(f"rich.{module_info.name}")
+        for class_name, class_object in vars(module).items():
+            if not inspect.isclass(class_object):
+                continue
+            if class_object.__module__ != module.__name__:
+                continue
+            for attribute_name, attribute in vars(class_object).items():
+                if hasattr(attribute, "cache_info"):
+                    offenders.append(
+                        f"{module.__name__}.{class_name}.{attribute_name}"
+                    )
+    assert offenders == [], f"lru_cache is still used on methods: {offenders}"
+
 
