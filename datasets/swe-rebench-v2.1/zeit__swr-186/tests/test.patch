+describe('useSWR - loading', () => {
+  afterEach(cleanup)
+
+  const loadData = () => new Promise(res => setTimeout(() => res('data'), 100))
+
+  it('should return loading state', async () => {
+    function Page() {
+      const { data, isValidating } = useSWR('is-validating-1', loadData)
+      return (
+        <div>
+          hello, {data}, {isValidating ? 'loading' : 'ready'}
+        </div>
+      )
+    }
+
+    const { container } = render(<Page />)
+    expect(container.textContent).toMatchInlineSnapshot(`"hello, , loading"`)
+    await waitForDomChange({ container })
+    expect(container.textContent).toMatchInlineSnapshot(`"hello, data, ready"`)
+  })
+
+  it('should update data when loading state is not read', async () => {
+    function Page() {
+      // we never access `isValidating`, so it will not trigger rerendering
+      const { data } = useSWR('is-validating-2', loadData)
+      return <div>hello, {data}</div>
+    }
+
+    const { container } = render(<Page />)
+    await waitForDomChange({ container })
+    expect(container.textContent).toMatchInlineSnapshot(`"hello, data"`)
+  })
+
+  it('should fetch successfully when no response fields are read', async () => {
+    let dataLoaded = false
+    const loadDataWithLog = () =>
+      new Promise(res =>
+        setTimeout(() => {
+          dataLoaded = true
+          res('data')
+        }, 100)
+      )
+
+    function Page() {
+      // we never access anything
+      useSWR('is-validating-3', loadDataWithLog)
+      return <div>hello</div>
+    }
+
+    const { container } = render(<Page />)
+    expect(container.textContent).toMatchInlineSnapshot(`"hello"`)
+
+    await act(() => new Promise(res => setTimeout(res, 110))) // wait
+    expect(dataLoaded).toEqual(true)
+  })
+})
+
+
+describe('useSWR - memoized response', () => {
+  afterEach(cleanup)
+
+  it('should return a memoized response object across re-renders', async () => {
+    const responses = []
+    function Page() {
+      const [count, setCount] = useState(0)
+      const response = useSWR('memoized-1', () => 'data')
+      responses.push(response)
+      return (
+        <div onClick={() => setCount(c => c + 1)}>
+          count: {count}, {response.data}
+        </div>
+      )
+    }
+
+    const { container } = render(<Page />)
+    await waitForDomChange({ container })
+    expect(container.textContent).toBe('count: 0, data')
+
+    const before = responses.length
+    fireEvent.click(container.firstElementChild)
+    expect(responses.length).toBeGreaterThan(before)
+    expect(responses[responses.length - 1]).toBe(responses[before - 1])
+  })
+
+  it('should retain the same state when an equal value is written', async () => {
+    let renderCount = 0
+    function Page() {
+      const { data } = useSWR('equal-state-1', () => 'same value')
+      renderCount++
+      return <div>{data}</div>
+    }
+
+    const { container } = render(<Page />)
+    await waitForDomChange({ container })
+    expect(container.textContent).toBe('same value')
+    const rendersBeforeEqualUpdate = renderCount
+
+    await act(async () => {
+      await mutate('equal-state-1', 'same value', false)
+    })
+
+    expect(container.textContent).toBe('same value')
+    expect(renderCount).toBe(rendersBeforeEqualUpdate)
+  })
+
+  it('should keep the same response object reference when error changes', async () => {
+    const responses = []
+    function Page() {
+      const response = useSWR('memoized-error', () =>
+        Promise.reject(new Error('request failed'))
+      )
+      responses.push(response)
+      return <div>{response.error ? response.error.message : 'loading'}</div>
+    }
+
+    const { container } = render(<Page />)
+    await waitForDomChange({ container })
+    expect(container.textContent).toBe('request failed')
+    expect(responses.length).toBeGreaterThan(1)
+    expect(responses.every(response => response === responses[0])).toBe(true)
+  })
+
+  it('should keep the same response object reference when validation changes', async () => {
+    const responses = []
+    const validatingValues = []
+    let resolveRequest
+    function Page() {
+      const response = useSWR(
+        'memoized-validating',
+        () => new Promise(resolve => (resolveRequest = resolve))
+      )
+      responses.push(response)
+      validatingValues.push(response.isValidating)
+      return (
+        <div>{response.isValidating ? 'loading' : response.data || 'idle'}</div>
+      )
+    }
+
+    const { container } = render(<Page />)
+    expect(container.textContent).toBe('loading')
+    await act(async () => {
+      resolveRequest('loaded')
+    })
+    expect(container.textContent).toBe('loaded')
+    expect(validatingValues).toContain(true)
+    expect(validatingValues).toContain(false)
+    expect(responses.length).toBeGreaterThan(1)
+    expect(responses.every(response => response === responses[0])).toBe(true)
+  })
+
+  it('should keep the same response object reference when the state updates', async () => {
+    const responses = []
+    function Page() {
+      const response = useSWR('memoized-2', () => 'data')
+      responses.push(response)
+      return <div>{response.data}</div>
+    }
+
+    const { container } = render(<Page />)
+    await waitForDomChange({ container })
+    expect(container.textContent).toBe('data')
+
+    // the response object is memoized: the same reference is returned even
+    // though the underlying state (data) changed from `undefined` to `data`
+    expect(responses[responses.length - 1]).toBe(responses[0])
+  })
+})
+
