+function Base.to_index(A::DenseAxisArray{T,N}, idx) where {T,N}
+    if length(idx) < N
+        throw(BoundsError(A, idx))
+    elseif any(i -> !isone(idx[i]), (N+1):length(idx))
+        throw(KeyError(idx))
+    end
+    return _getindex_recurse(A.lookup, idx, x -> true)
