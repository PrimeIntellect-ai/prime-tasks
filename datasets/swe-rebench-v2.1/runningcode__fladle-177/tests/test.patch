+  @Test
+  fun `sanityRobo - named configuration rejects instrumentationApk`() =
+    assertNamedSanityConflict("instrumentationApk.set(\"test.apk\")", "instrumentationApk")
+
+  @Test
+  fun `sanityRobo - named configuration rejects roboDirectives`() =
+    assertNamedSanityConflict("roboDirectives = [[\"click\", \"button1\", \"\"]]", "roboDirectives")
+
+  @Test
+  fun `sanityRobo - named configuration rejects additionalTestApks`() =
+    assertNamedSanityConflict("additionalTestApks = [\"test.apk\"]", "additionalTestApks")
+
+  private fun assertNamedSanityConflict(setting: String, option: String) {
+    makeBuildDotGradle(
+      where = testProjectRoot,
+      buildScript =
+        """
+      |plugins {
+      |  id "com.osacky.fladle"
+      |}
+      |
+      |fladle {
+      |  serviceAccountCredentials = layout.projectDirectory.file("flank-gradle-service.json")
+      |  configs {
+      |    orange {
+      |      sanityRobo.set(true)
+      |      $setting
+      |    }
+      |  }
+      |}
+    """
+    )
+
+    val result = failedGradleRun(
+      arguments = listOf("printYmlOrange"),
+      projectDir = testProjectRoot.root
+    )
+
+    assertThat(result.output).contains("FAILED")
+    assertThat(result.output).contains("sanityRobo")
+    assertThat(result.output).contains(option)
+  }
+}
