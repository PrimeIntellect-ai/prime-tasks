diff --git a/opennmt/tests/losses_test.py b/opennmt/tests/losses_test.py
index 61d7477..77194ef 100644
--- a/opennmt/tests/losses_test.py
+++ b/opennmt/tests/losses_test.py
@@ -30,6 +30,62 @@ class LossesTest(tf.test.TestCase):
     with self.assertRaises(ValueError):
       losses.regularization_penalty("l1_l2", 1e-4, [])
 
+  @parameterized.expand([
+      ["ce", False],
+      ["mse", False],
+      ["mse", True],
+  ])
+  def testGuidedAlignmentCostUnderDistributionStrategy(self, cost_type, with_length):
+    strategy = tf.distribute.MirroredStrategy(devices=["/cpu:0"])
+    attention_probs = tf.random.uniform([2, 5, 6])
+    gold_alignment = tf.random.uniform([2, 5, 6])
+    if with_length:
+      sequence_length = tf.constant([4, 5], dtype=tf.int32)
+    else:
+      sequence_length = None
+    with strategy.scope():
+      cost = losses.guided_alignment_cost(
+          attention_probs,
+          gold_alignment,
+          sequence_length=sequence_length,
+          cost_type=cost_type)
+    self.assertEqual(0, len(cost.shape))
+    self.evaluate(cost)
+
+  def testGuidedAlignmentCostWeight(self):
+    attention_probs = tf.random.uniform([2, 5, 6])
+    gold_alignment = tf.random.uniform([2, 5, 6])
+    cost = losses.guided_alignment_cost(attention_probs, gold_alignment)
+    weighted_cost = losses.guided_alignment_cost(
+        attention_probs, gold_alignment, weight=2.5)
+    self.assertEqual(0, len(weighted_cost.shape))
+    self.assertAllClose(weighted_cost, 2.5 * cost)
+
+  def testGuidedAlignmentCostSequenceLength(self):
+    attention_probs = tf.random.uniform([2, 5, 6])
+    gold_alignment = tf.random.uniform([2, 5, 6])
+    sequence_length = tf.constant([4, 5], dtype=tf.int32)
+    cost = losses.guided_alignment_cost(
+        attention_probs,
+        gold_alignment,
+        sequence_length=sequence_length)
+    loss = tf.keras.losses.CategoricalCrossentropy(
+        reduction=tf.keras.losses.Reduction.SUM)
+    sample_weight = tf.expand_dims(
+        tf.sequence_mask(
+            sequence_length, maxlen=5, dtype=attention_probs.dtype), -1)
+    expected = loss(gold_alignment, attention_probs, sample_weight=sample_weight)
+    expected /= tf.cast(tf.reduce_sum(sequence_length), expected.dtype)
+    self.assertAllClose(cost, expected)
+
+
+  def testGuidedAlignmentCostInvalidType(self):
+    attention_probs = tf.random.uniform([2, 5, 6])
+    gold_alignment = tf.random.uniform([2, 5, 6])
+    with self.assertRaises(ValueError):
+      losses.guided_alignment_cost(
+          attention_probs, gold_alignment, cost_type="unsupported")
+
 
 if __name__ == "__main__":
   tf.test.main()
