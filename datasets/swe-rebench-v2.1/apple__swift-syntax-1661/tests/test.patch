+/// Asserts that the lexemes produced for `source` match `expectedLexemes`, ignoring the
+/// `.isAtStartOfLine` flag.
+///
+/// The public contract for this change only requires that a newline inside a block comment
+/// allows the following statement to be recognized as starting on a new line. It does not
+/// specify whether multiline string segments are marked as being at the start of a line, so
+/// tolerate either behavior here.
+private func assertLexemesIgnoringStartOfLineFlag(
+  _ source: String,
+  lexemes expectedLexemes: [LexemeSpec],
+  file: StaticString = #file,
+  line: UInt = #line
+) {
+  var expectedLexemes = expectedLexemes
+  if expectedLexemes.last?.rawTokenKind != .eof {
+    expectedLexemes.append(LexemeSpec(.eof, text: ""))
+  }
+  var source = source
+  source.withUTF8 { (buf) in
+    var lexemes = [Lexer.Lexeme]()
+    for token in Lexer.tokenize(buf, from: 0) {
+      lexemes.append(token)
+      if token.rawTokenKind == .eof {
+        break
+      }
+    }
+    guard lexemes.count == expectedLexemes.count else {
+      return XCTFail(
+        "Expected \(expectedLexemes.count) lexemes but got \(lexemes.count)",
+        file: file,
+        line: line
+      )
+    }
+    for (actual, expected) in zip(lexemes, expectedLexemes) {
+      XCTAssertEqual(actual.rawTokenKind, expected.rawTokenKind, file: file, line: line)
+      XCTAssertEqual(String(syntaxText: actual.leadingTriviaText), String(syntaxText: expected.leadingTrivia), file: file, line: line)
+      XCTAssertEqual(String(syntaxText: actual.tokenText), String(syntaxText: expected.tokenText), file: file, line: line)
+      XCTAssertEqual(String(syntaxText: actual.trailingTriviaText), String(syntaxText: expected.trailingTrivia), file: file, line: line)
+    }
+  }
+}
