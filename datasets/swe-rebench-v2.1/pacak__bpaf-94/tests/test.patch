+
+#[test]
+fn cauwugo_add_rev_value_name() {
+    // Build the `cauwugo` binary so we can inspect the help output it produces.
+    let status = std::process::Command::new(env!("CARGO"))
+        .args(["build", "-p", "bpaf_cauwugo", "--bin", "cauwugo"])
+        .status()
+        .expect("failed to run cargo build");
+    assert!(status.success(), "cargo build failed");
+
+    let exe = std::env::current_exe().unwrap();
+    let bin = exe.parent().unwrap().parent().unwrap().join("cauwugo");
+    let output = std::process::Command::new(&bin)
+        .args(["add", "--help"])
+        .output()
+        .expect("failed to run cauwugo");
+    let help = String::from_utf8_lossy(&output.stdout);
+
+    // `--rev` must take a value named `REV`, not `TAG`.
+    assert!(
+        help.contains("--rev <REV>"),
+        "expected `--rev <REV>` in help output, got:\n{}",
+        help
+    );
+    assert!(
+        !help.contains("--rev <TAG>"),
+        "`--rev` still uses the `TAG` value name:\n{}",
+        help
+    );
+}
