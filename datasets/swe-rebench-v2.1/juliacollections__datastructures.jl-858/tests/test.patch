+    @testset "Fixes issue 857" begin
+        h = OrderedRobinDict{Any,Any}([("a", missing), ("b", -2)])
+        # Membership must recognize present keys regardless of the stored value.
+        @test "b" in keys(h)
+        @test haskey(h, "b")
+        @test "a" in keys(h)
+        @test haskey(h, "a")
+        @test !("c" in keys(h))
+        @test !haskey(h, "c")
+
+        # Membership must not error when a stored value is not comparable to Int.
+        h2 = OrderedRobinDict(1 => [1, 2, 3], 2 => [4, 5, 6])
+        @test 1 in keys(h2)
+        @test 2 in keys(h2)
+        @test !(3 in keys(h2))
+        @test haskey(h2, 1)
+        @test !haskey(h2, 3)
+    end
