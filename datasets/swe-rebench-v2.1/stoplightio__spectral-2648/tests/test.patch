+++ b/packages/formatters/src/__tests__/code-climate.jest.test.ts
@@ -0,0 +1,147 @@
+import { isAbsolute } from 'path';
+import { DiagnosticSeverity } from '@stoplight/types';
+import type { IRuleResult } from '@stoplight/spectral-core';
+const codeClimate = (results: IRuleResult[], options?: { failSeverity?: DiagnosticSeverity }) =>
+  require('../code-climate').codeClimate(results, options);
+
+const cwd = process.cwd();
+const results: IRuleResult[] = [
+  {
+    code: 'operation-description',
+    message: 'paths./pets.get.description is not truthy',
+    path: ['paths', '/pets', 'get', 'description'],
+    severity: 1,
+    source: `${cwd}/__tests__/fixtures/petstore.oas2.yaml`,
+    range: {
+      start: {
+        line: 60,
+        character: 8,
+      },
+      end: {
+        line: 71,
+        character: 60,
+      },
+    },
+  },
+  {
+    code: 'operation-tags',
+    message: 'paths./pets.get.tags is not truthy',
+    path: ['paths', '/pets', 'get', 'tags'],
+    severity: 1,
+    source: `${cwd}/__tests__/fixtures/petstore.oas2.yaml`,
+    range: {
+      start: {
+        line: 60,
+        character: 8,
+      },
+      end: {
+        line: 71,
+        character: 60,
+      },
+    },
+  },
+];
+
+describe('Code climate formatter', () => {
+  test('should include ranges', () => {
+    expect(JSON.parse(codeClimate(results, { failSeverity: DiagnosticSeverity.Hint }))).toEqual([
+      expect.objectContaining({
+        location: expect.objectContaining({
+          path: expect.any(String),
+          positions: expect.objectContaining({
+            begin: expect.objectContaining({
+              line: 60,
+              column: 8,
+            }),
+            end: expect.objectContaining({
+              line: 71,
+              column: 60,
+            }),
+          }),
+        }),
+      }),
+      expect.objectContaining({
+        location: expect.objectContaining({
+          path: expect.any(String),
+          positions: expect.objectContaining({
+            begin: expect.objectContaining({
+              line: 60,
+              column: 8,
+            }),
+            end: expect.objectContaining({
+              line: 71,
+              column: 60,
+            }),
+          }),
+        }),
+      }),
+    ]);
+    for (const issue of JSON.parse(codeClimate(results))) {
+      expect(issue.location.path.length).toBeGreaterThan(0);
+      expect(isAbsolute(issue.location.path)).toBe(false);
+    }
+  });
+
+  test('should include description', () => {
+    expect(JSON.parse(codeClimate(results, { failSeverity: DiagnosticSeverity.Hint }))).toEqual([
+      expect.objectContaining({
+        description: expect.any(String),
+      }),
+      expect.objectContaining({
+        description: expect.any(String),
+      }),
+    ]);
+    for (const issue of JSON.parse(codeClimate(results))) {
+      expect(issue.description.length).toBeGreaterThan(0);
+    }
+  });
+});
+
+jest.mock('@stoplight/spectral-formatters', () => ({
+  ...jest.requireActual('@stoplight/spectral-formatters'),
+  codeClimate: (...args: any[]) => require('../code-climate').codeClimate(...args),
+}));
+
+describe('Code climate output format', () => {
+  test.each(['gitlab', 'code-climate'])('exports a Code Climate report for the %s output format', format => {
+    const { formatOutput } = require('../../../cli/src/services/output');
+    const output = formatOutput(results, format, { failSeverity: DiagnosticSeverity.Hint }, {} as never);
+    const issues = JSON.parse(output);
+
+    expect(Array.isArray(issues)).toBe(true);
+    expect(issues).toHaveLength(results.length);
+    for (const issue of issues) {
+      expect(issue).toEqual(
+        expect.objectContaining({
+          type: 'issue',
+          check_name: expect.any(String),
+          categories: expect.any(Array),
+          fingerprint: expect.any(String),
+        }),
+      );
+      expect(issue.check_name.length).toBeGreaterThan(0);
+      expect(issue.categories.length).toBeGreaterThan(0);
+      for (const category of issue.categories) {
+        expect(
+          ['Bug Risk', 'Clarity', 'Compatibility', 'Complexity', 'Duplication', 'Performance', 'Security', 'Style'],
+        ).toContain(category);
+      }
+      expect(issue.fingerprint.length).toBeGreaterThan(0);
+    }
+    expect(issues[0]).toEqual(
+      expect.objectContaining({
+        description: expect.any(String),
+        location: expect.objectContaining({
+          path: expect.any(String),
+          positions: expect.objectContaining({
+            begin: expect.objectContaining({ line: expect.any(Number), column: expect.any(Number) }),
+            end: expect.objectContaining({ line: expect.any(Number), column: expect.any(Number) }),
+          }),
+        }),
+      }),
+    );
+    for (const issue of issues) {
+      expect(issue.description.length).toBeGreaterThan(0);
+    }
+  });
+});
