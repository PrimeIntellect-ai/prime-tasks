+    def test_unmatched_overload_call(self):
+        import typing
+        import typing_extensions
+        from pyanalyze import extensions
+
+        code = """
+            from typing import overload
+
+            @overload
+            def f(x: int) -> str:
+                raise NotImplementedError
+
+            @overload
+            def f(x: str) -> int:
+                raise NotImplementedError
+
+            def f(x: object) -> object:
+                raise NotImplementedError
+
+            def capybara():
+                f(None)
+        """
+        original_overload = typing.overload
+        original_extensions_overload = typing_extensions.overload
+        patcher = getattr(extensions, "patch_typing_overload", None)
+        try:
+            if patcher is not None:
+                patcher()
+            errors = self._run_str(code, expect_failure=False, fail_after_first=False)
+        finally:
+            typing.overload = original_overload
+            typing_extensions.overload = original_extensions_overload
+        assert errors, "an unmatched overload call must be reported as invalid"
+
