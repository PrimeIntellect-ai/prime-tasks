+def test_patch_typing_overload_returns_none() -> None:
+    import typing
+    import typing_extensions
+    from pyanalyze.extensions import overload, patch_typing_overload
+
+    original_overload = typing.overload
+    original_extensions_overload = typing_extensions.overload
+    try:
+        assert patch_typing_overload() is None
+        assert typing.overload is overload
+    finally:
+        typing.overload = original_overload
+        typing_extensions.overload = original_extensions_overload
