+def test_overload_forwards_to_typing() -> None:
+    from pyanalyze.extensions import overload
+
+    def f(x: int) -> int:
+        return x
+
+    result = overload(f)
+    assert callable(result)
+    try:
+        result()
+    except NotImplementedError:
+        pass
+    else:
+        raise AssertionError("overload did not forward to typing.overload")
+
