+package safehttp_test
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/google/go-safeweb/safehttp"
+)
+
+func TestCookieSafeDefaults(t *testing.T) {
+	rr := newResponseRecorder(&strings.Builder{})
+	rw := safehttp.NewResponseWriter(testDispatcher{}, rr, nil)
+	rw.SetCookie(safehttp.NewCookie("session", "abc123"))
+
+	cookies := (&http.Response{Header: http.Header(rr.header)}).Cookies()
+	if len(cookies) != 1 {
+		t.Fatalf("response contains %d cookies, want 1", len(cookies))
+	}
+	c := cookies[0]
+	if c.Name != "session" || c.Value != "abc123" {
+		t.Errorf("response cookie is %q=%q, want session=abc123", c.Name, c.Value)
+	}
+	if !c.Secure {
+		t.Error("cookie is not Secure by default")
+	}
+	if !c.HttpOnly {
+		t.Error("cookie is not HttpOnly by default")
+	}
+	if c.SameSite != http.SameSiteLaxMode {
+		t.Errorf("cookie SameSite mode is %v, want Lax", c.SameSite)
+	}
+}
