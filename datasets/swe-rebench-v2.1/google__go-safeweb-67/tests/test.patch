+package safehttp_test
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/google/go-safeweb/safehttp"
+)
+
+func TestResponseWriterSetCookie(t *testing.T) {
+	rr := newResponseRecorder(&strings.Builder{})
+	rw := safehttp.NewResponseWriter(testDispatcher{}, rr, nil)
+	rw.SetCookie(safehttp.NewCookie("foo", "bar"))
+
+	cookies := (&http.Response{Header: http.Header(rr.header)}).Cookies()
+	if len(cookies) != 1 {
+		t.Fatalf("response contains %d cookies, want 1", len(cookies))
+	}
+	if got := cookies[0].Name; got != "foo" {
+		t.Errorf("response cookie name is %q, want foo", got)
+	}
+	if got := cookies[0].Value; got != "bar" {
+		t.Errorf("response cookie value is %q, want bar", got)
+	}
+}
