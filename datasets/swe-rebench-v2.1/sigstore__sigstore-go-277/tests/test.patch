+func TestEntitySignedByPublicGoodWithCurrentTimeFailsForExpiredCertificate(t *testing.T) {
+	tr := data.PublicGoodTrustedMaterialRoot(t)
+	entity := data.SigstoreJS200ProvenanceBundle(t)
+
+	// The bundle's signing certificate is only valid for a short window in the
+	// past. Verifying the certificate against the current wall-clock time must
+	// therefore fail, whereas verifying it against its own validity period
+	// would succeed.
+	v, err := verify.NewSignedEntityVerifier(tr, verify.WithCurrentTime())
+	assert.NoError(t, err)
+
+	res, err := v.Verify(entity, SkipArtifactAndIdentitiesPolicy)
+	assert.Error(t, err)
+	assert.Nil(t, res)
+}
+
+func TestEntityWithCurrentTimeVerifiesValidCertificate(t *testing.T) {
+	virtualSigstore, err := ca.NewVirtualSigstore()
+	assert.NoError(t, err)
+
+	// The certificate is valid at the current time, so configuring the
+	// verifier to use the current time must allow verification to succeed.
+	statement := []byte(`{"_type":"https://in-toto.io/Statement/v0.1","predicateType":"customFoo","subject":[{"name":"subject","digest":{"sha256":"deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef"}}],"predicate":{}}`)
+	entity, err := virtualSigstore.Attest("foo@example.com", "issuer", statement)
+	assert.NoError(t, err)
+
+	v, err := verify.NewSignedEntityVerifier(virtualSigstore, verify.WithCurrentTime())
 	assert.NoError(t, err)
 
 	res, err := v.Verify(entity, SkipArtifactAndIdentitiesPolicy)
