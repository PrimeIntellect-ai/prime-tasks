+''' Tests the handling of SAVE statements in the fparser2 PSyIR front-end '''
+
+from psyclone.psyir.nodes import Container
+
+
+def test_bare_save_statement_in_module(fortran_reader):
+    """A module containing a bare SAVE statement is parsed as a Container."""
+    code = """module test_mod
+      implicit none
+      private
+      public :: var1
+      public :: var2, var3
+      save
+      integer, dimension(123) :: var2, var3
+      contains
+      subroutine var1()
+        var2(:) = 0
+        var3(:) = 0
+      end subroutine var1
+    end module test_mod"""
+
+    psyir = fortran_reader.psyir_from_source(code)
+    assert isinstance(psyir.children[0], Container)
