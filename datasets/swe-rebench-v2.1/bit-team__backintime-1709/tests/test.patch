-snapshot_version=.+
-user.size=.+''', re.MULTILINE))
+    def test_backup_info_file(self):
+        """Creation and content of the 'info' file contained in each snapshot
+        """
+
+        # Create the file and verify its serialized, user-visible contents.
+        writer = getattr(self.sn, 'backupInfo', None)
+        if writer is None:
+            writer = self.sn._backup_info_file
+        writer(self.sid)
+        sut_fp = pathlib.Path(self.sid.path('info'))
+
+        self.assertTrue(sut_fp.is_file())
+
+        sut = sut_fp.read_text()
+
+        # The file retains the snapshot metadata, independent of field order.
+        self.assertRegex(sut, r'(?m)^group\.size=')
+        self.assertRegex(sut, r'(?m)^snapshot_date=20151219-010324$')
+        self.assertRegex(sut, r'(?m)^snapshot_machine=.+$')
+        self.assertRegex(sut, r'(?m)^snapshot_profile_id=1$')
+        self.assertRegex(sut, r'(?m)^snapshot_tag=123$')
+        self.assertRegex(sut, r'(?m)^snapshot_user=.+$')
+        self.assertRegex(sut, r'(?m)^user\.size=')
+
+        # ... but not the removed fields.
+        self.assertNotRegex(sut, r'(?m)^filesystem_mounts=')
+        self.assertNotRegex(sut, r'(?m)^snapshot_version=')
 
