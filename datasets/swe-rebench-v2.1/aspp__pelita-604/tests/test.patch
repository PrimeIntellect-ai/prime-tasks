+
+def test_remote_timeout():
+    # We have a slow player that also generates a bad move
+    # in its second turn.
+    # We need to detect both.
+
+    layout = """
+        ##########
+        #  2  3  #
+        #0  ..  1#
+        ##########
+        """
+
+    tp = """
+    import time
+    TEAM_NAME = "500ms timeout"
+    def move(b, s):
+        if b.round == 1 and b.turn == 1:
+            return (-2, 0), s
+        time.sleep(0.5)
+        return b.position, s
+    """
+    with tempfile.NamedTemporaryFile('w+', suffix='.py') as f:
+        print(dedent(tp), file=f, flush=True)
+        timeout_player = f.name
+
+        state = pelita.game.run_game([stopping_player, timeout_player],
+                                     max_rounds=8,
+                                     layout_dict=pelita.layout.parse_layout(layout),
+                                     timeout_length=0.5)
+
+    # The timeout player is team 1. Its errors must record a PlayerTimeout
+    # whenever it exceeds the configured timeout, as well as the illegal
+    # move it returned on its first turn.
+    errors = state['errors'][1]
+
+    def error_entries(value):
+        # A timeout may be recorded as a single error dict or (in
+        # implementations that also record the resulting illegal move)
+        # as a collection of error dicts.
+        if isinstance(value, dict):
+            return [value]
+        return list(value)
+
+    timeout_entries = [e for value in errors.values() for e in error_entries(value)
+                       if e.get('type') == 'PlayerTimeout']
+    assert timeout_entries
+    for entry in timeout_entries:
+        assert entry['description'] == ''
+
+    illegal_entries = [e for value in errors.values() for e in error_entries(value)
+                       if e.get('reason') == 'illegal move']
+    assert any(e['bot_position'] == (-2, 0) for e in illegal_entries)
