new file mode 100644
index 0000000..f25d20b
--- /dev/null
+++ b/test/size.spec.ts
@@ -0,0 +1,45 @@
+import * as Fx from "../src";
+import { range, toAsync } from "../src";
+
+const size = (Fx as unknown as { size: (iterable: any) => any }).size;
+
+describe("size", function () {
+  describe("sync", function () {
+    it.each([
+      [[1, 2, 3, 4, 5], 5],
+      ["abcdef", 6],
+      [[], 0],
+    ])("should return the size of elements %s", function (iterable, result) {
+      expect(size(iterable)).toEqual(result);
+    });
+
+    it("should return a number for a synchronous iterable", function () {
+      expect(typeof size([1, 2, 3])).toBe("number");
+    });
+
+    it("should count the elements of a lazy range", function () {
+      expect(size(range(10, 16))).toEqual(6);
+    });
+  });
+
+  describe("async", function () {
+    it.each([
+      [[1, 2, 3, 4, 5], 5],
+      ["abcdef", 6],
+      [[], 0],
+    ])(
+      "should return the size of elements %s",
+      async function (iterable, result) {
+        expect(await size(toAsync(iterable as any[]))).toEqual(result);
+      },
+    );
+
+    it("should return a Promise for an asynchronous iterable", function () {
+      expect(size(toAsync([1, 2, 3]))).toBeInstanceOf(Promise);
+    });
+
+    it("should count the elements of an async range", async function () {
+      expect(await size(toAsync(range(10, 16)))).toEqual(6);
+    });
+  });
+});
diff --git a/type-check/size.test.ts b/type-check/size.test.ts
new file mode 100644
index 0000000..609476f
--- /dev/null
+++ b/type-check/size.test.ts
@@ -0,0 +1,20 @@
+import * as Test from "../src/types/Test";
+import { size, pipe, toAsync } from "../src";
+
+const { checks, check } = Test;
+
+const res1 = size([]);
+const res2 = size([1, 2, 3, 4, 5]);
+const res3 = size(["a", "b", "c", "d"]);
+const res4 = size(toAsync(["a", "b", "c", "d"]));
+const res5 = pipe([1, 2, 3, 4, 5], size);
+const res6 = pipe(["a", "b", "c", "d"], toAsync, size);
+
+checks([
+  check<typeof res1, number, Test.Pass>(),
+  check<typeof res2, number, Test.Pass>(),
+  check<typeof res3, number, Test.Pass>(),
+  check<typeof res4, Promise<number>, Test.Pass>(),
+  check<typeof res5, number, Test.Pass>(),
+  check<typeof res6, Promise<number>, Test.Pass>(),
+]);
