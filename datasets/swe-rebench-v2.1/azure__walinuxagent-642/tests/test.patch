+    def test_run_logs_traceback_on_crash(self):
+        # Cause the extension handler to crash while the agent is running
+        captured = []
+
+        class _CaptureAppender(object):
+            def write(self, level, msg):
+                captured.append(msg)
+
+        class _CaptureStream(object):
+            def __init__(self):
+                self.data = []
+
+            def write(self, msg):
+                self.data.append(msg)
+
+            def flush(self):
+                pass
+
+        appender = _CaptureAppender()
+        stderr = _CaptureStream()
+        logger.DEFAULT_LOGGER.appenders.append(appender)
+        try:
+            conf.get_autoupdate_enabled = Mock(return_value=False)
+            fileutil.write_file(conf.get_agent_pid_file_path(), ustr(42))
+            with patch('sys.stderr', stderr):
+                with patch('azurelinuxagent.ga.exthandlers.get_exthandlers_handler') as mock_handler:
+                    def crash_extension_handler():
+                        raise Exception("extension handler crashed")
+
+                    mock_handler.return_value.run.side_effect = crash_extension_handler
+                    with patch('azurelinuxagent.ga.monitor.get_monitor_handler'):
+                        with patch('azurelinuxagent.ga.env.get_env_handler'):
+                            with patch('time.sleep'):
+                                with patch('sys.exit'):
+                                    with patch('os.getppid', return_value=42):
+                                        self.update_handler.run()
+        finally:
+            logger.DEFAULT_LOGGER.appenders.remove(appender)
+
+        output = "".join(captured) + "".join(stderr.data)
+        self.assertIn("crash_extension_handler", output)
+        return
+
     def test_run_emits_restart_event(self):
         self.update_handler._emit_restart_event = Mock()
         self._test_run()
