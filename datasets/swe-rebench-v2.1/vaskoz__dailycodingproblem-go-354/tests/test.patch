+package day170
+
+import (
+	"reflect"
+	"testing"
+)
+
+var testcases = []struct {
+	start, end  string
+	dict        []string
+	expected    []string
+	expectError bool
+}{
+	{"dog", "cat", []string{"dot", "dop", "dat", "cat"}, []string{"dog", "dot", "dat", "cat"}, false},
+	{"dog", "cat", []string{"dot", "tod", "dat", "dar"}, nil, true},
+}
+
+func TestShortestTransformation(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		result, err := ShortestTransformation(tc.start, tc.end, tc.dict)
+		if (err != nil) != tc.expectError {
+			t.Errorf("Expected error presence %v, got error %v", tc.expectError, err)
+		}
+		if tc.expectError {
+			if len(result) != 0 {
+				t.Errorf("Expected no transformation sequence, got %v", result)
+			}
+		} else if !reflect.DeepEqual(result, tc.expected) {
+			t.Errorf("Expected sequence %v, got %v", tc.expected, result)
+		}
+	}
+}
+
+func BenchmarkShortestTransformation(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			ShortestTransformation(tc.start, tc.end, tc.dict)
+		}
+	}
+}
