+func TestNormalizeDetectedIPRejectsPlainIPv4ForIPv6(t *testing.T) {
+	t.Parallel()
+	mockPP := mocks.NewMockPP(gomock.NewController(t))
+	mockPP.EXPECT().Noticef(pp.EmojiError,
+		"Detected IP address %s is not a valid IPv6 address", "10.10.10.10")
+	_, ok := ipnet.IP6.NormalizeDetectedIP(mockPP, mustIP("10.10.10.10"))
+	require.False(t, ok)
+}
+
+func TestNormalizeDetectedIPRejectsIPv4MappedIPv6(t *testing.T) {
+	t.Parallel()
+	mockPP := mocks.NewMockPP(gomock.NewController(t))
+	gomock.InOrder(
+		mockPP.EXPECT().Noticef(pp.EmojiError,
+			"Detected IP address %s is an IPv4-mapped IPv6 address", "::ffff:10.10.10.10"),
+		mockPP.EXPECT().Hintf(gomock.Any(),
+			"An IPv4-mapped IPv6 address is an IPv4 address in disguise. "+
+				"It cannot be used for routing IPv6 traffic. "+
+				"If you need to use it for DNS, please open an issue at %s",
+			pp.IssueReportingURL),
+	)
+	_, ok := ipnet.IP6.NormalizeDetectedIP(mockPP, mustIP("::ffff:10.10.10.10"))
+	require.False(t, ok)
+}
