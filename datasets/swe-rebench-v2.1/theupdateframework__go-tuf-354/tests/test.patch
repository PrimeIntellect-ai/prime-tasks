+// failingRemoteStore is a RemoteStore that returns an error for every
+// request. It is used to observe that a client operation does not access the
+// remote store.
+type failingRemoteStore struct{}
+
+func (failingRemoteStore) GetMeta(name string) (io.ReadCloser, int64, error) {
+	return nil, 0, errors.New("unexpected remote metadata access: " + name)
+}
+
+func (failingRemoteStore) GetTarget(path string) (io.ReadCloser, int64, error) {
+	return nil, 0, errors.New("unexpected remote target access: " + path)
+}
