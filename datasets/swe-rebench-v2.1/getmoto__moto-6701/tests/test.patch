+@mock_iot
+def test_reserved_group_name_body_references_use_original_name():
+    client = boto3.client("iot", region_name="ap-northeast-1")
+    parent_name = "group:parent"
+    child_name = "child-group"
+    thing_name = "thing-in-reserved-name-group"
+
+    client.create_thing_group(thingGroupName=parent_name)
+    client.create_thing(thingName=thing_name)
+
+    client.add_thing_to_thing_group(
+        thingGroupName=parent_name, thingName=thing_name
+    )
+    groups_for_thing = client.list_thing_groups_for_thing(thingName=thing_name)[
+        "thingGroups"
+    ]
+    assert [group["groupName"] for group in groups_for_thing] == [parent_name]
+
+    client.create_thing_group(
+        thingGroupName=child_name, parentGroupName=parent_name
+    )
+    child = client.describe_thing_group(thingGroupName=child_name)
+    assert child["thingGroupMetadata"]["parentGroupName"] == parent_name
