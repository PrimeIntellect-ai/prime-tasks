+package day210
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestLongestCollatzSequence(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		max           int
+		startingValue int
+		steps         int
+	}{
+		{max: 2, startingValue: 2, steps: 1},
+		{max: 3, startingValue: 3, steps: 7},
+		{max: 10, startingValue: 9, steps: 19},
+		{max: 100, startingValue: 97, steps: 118},
+		{max: 1000, startingValue: 871, steps: 178},
+		{max: 1000000, startingValue: 837799, steps: 524},
+	}
+	for _, test := range tests {
+		t.Run(fmt.Sprint(test.max), func(t *testing.T) {
+			gotValue, gotSteps := LongestCollatzSequence(test.max)
+			if gotValue != test.startingValue || gotSteps != test.steps {
+				t.Errorf("LongestCollatzSequence(%d) = (%d, %d), want (%d, %d)", test.max, gotValue, gotSteps, test.startingValue, test.steps)
+			}
+		})
+	}
+}
+
+func BenchmarkLongestCollatzSequence(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		LongestCollatzSequence(10)
+	}
+}
