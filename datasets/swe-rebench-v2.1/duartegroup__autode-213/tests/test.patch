+def test_invalid_get_ts_template_folder_path():
+
+    Config.ts_template_folder_path = ""
+    try:
+        with pytest.raises(Exception) as exc_info:
+            _ = get_ts_template_folder_path(None)
+        assert str(exc_info.value).strip()
+    finally:
+        Config.ts_template_folder_path = None
+
+
+def test_get_ts_template_folder_path():
+
+    # A configured non-empty path should be returned
+    Config.ts_template_folder_path = "/tmp/ts_templates"
+    assert get_ts_template_folder_path(None) == "/tmp/ts_templates"
+
+    # With no configuration the default TS template folder is used
+    Config.ts_template_folder_path = None
+    default_path = get_ts_template_folder_path(None)
+    expected_path = Path(autode.__file__).resolve().parent / "transition_states" / "lib"
+    assert Path(default_path).resolve() == expected_path
