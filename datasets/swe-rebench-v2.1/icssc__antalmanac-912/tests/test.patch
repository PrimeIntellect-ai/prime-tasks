+import { describe, test, expect } from 'vitest';
+import locationIds from '$lib/location_ids';
+import buildingCatalogue from '$lib/buildingCatalogue';
+
+/**
+ * The short identifier used for a building, e.g.
+ * "Biological Sciences III (BS3)" -> "BS3".
+ */
+const getAbbreviation = (name: string) =>
+    name.includes('(') ? name.substring(name.indexOf('(') + 1, name.indexOf(')')) : name;
+
+describe('locationIds', () => {
+    test('no duplicate names', () => {
+        const names = Object.keys(locationIds);
+        const uniqueNames = new Set(names);
+        expect(names.length).toBe(uniqueNames.size);
+    });
+});
+
+describe('locationIds and buildingCatalogue', () => {
+    test('all locationIds are in buildingCatalogue', () => {
+        // Every location key must resolve, through its numeric id, to the
+        // catalogue entry for that same building.
+        for (const [locationName, locationId] of Object.entries(locationIds)) {
+            const building = buildingCatalogue[locationId];
+            expect(building, `location "${locationName}" points at unknown catalogue id ${locationId}`).toBeDefined();
+            expect(getAbbreviation(building.name)).toBe(locationName);
+        }
+    });
+
+    test('all buildingCatalogue are in locationIds', () => {
+        const locationNames = new Set(Object.keys(locationIds));
+        for (const building of Object.values(buildingCatalogue)) {
+            expect(locationNames).toContain(getAbbreviation(building.name));
+        }
+    });
+});
