+"""Test Fortran 2008 rule R818 : loop-control, including the CONCURRENT
+form.
+
+"""
+import pytest
+from fparser.two.parser import ParserFactory
+from fparser.two.utils import NoMatchError
+
+
+@pytest.fixture(name="loop_control_cls", scope="module")
+def fixture_loop_control_cls():
+    """Create the Fortran 2008 parser (selecting the Fortran 2008 grammar)
+    and return the R818 loop-control class."""
+    ParserFactory().create(std="f2008")
+    # pylint: disable=import-outside-toplevel
+    from fparser.two.Fortran2008 import Loop_Control
+
+    return Loop_Control
+
+
+def test_concurrent_form(loop_control_cls):
+    """Test that the CONCURRENT form with a forall header is matched and
+    that its string output contains the same keyword and header."""
+    result = loop_control_cls("CONCURRENT (i=1:10)")
+    assert isinstance(result, loop_control_cls)
+    normalised = str(result).upper().replace(" ", "")
+    assert normalised == "CONCURRENT(I=1:10)"
+
+
+def test_concurrent_form_multiple_triplets_and_case(loop_control_cls):
+    """Test that the CONCURRENT form accepts several forall triplets and
+    that the keyword is case-insensitive."""
+    result = loop_control_cls("concurrent (i=1:n, j=2:m)")
+    assert isinstance(result, loop_control_cls)
+    normalised = str(result).upper().replace(" ", "")
+    assert normalised == "CONCURRENT(I=1:N,J=2:M)"
+
+
+def test_concurrent_form_with_delimiter(loop_control_cls):
+    """Test that the CONCURRENT form may be preceded by an optional comma
+    delimiter and that the delimiter is retained in the output."""
+    result = loop_control_cls(" , CONCURRENT (i=1:10) ")
+    assert isinstance(result, loop_control_cls)
+    normalised = str(result).upper().replace(" ", "")
+    assert normalised == ",CONCURRENT(I=1:10)"
+
+
+def test_existing_while_form(loop_control_cls):
+    """Test that the WHILE form still matches in the Fortran 2008 rule."""
+    result = loop_control_cls(" , while (.true.) ")
+    assert isinstance(result, loop_control_cls)
+    assert str(result) == ", WHILE (.TRUE.)"
+
+
+def test_existing_counter_form(loop_control_cls):
+    """Test that the counter form still matches in the Fortran 2008 rule."""
+    result = loop_control_cls("idx = start,stop,step")
+    assert isinstance(result, loop_control_cls)
+    assert str(result) == "idx = start, stop, step"
+
+
+@pytest.mark.parametrize("string", ["", " ", "concurent (i=1:10)"])
+def test_invalid(loop_control_cls, string):
+    """Test that there is no match for strings that are not loop-control
+    forms."""
+    with pytest.raises(NoMatchError):
+        _ = loop_control_cls(string)
