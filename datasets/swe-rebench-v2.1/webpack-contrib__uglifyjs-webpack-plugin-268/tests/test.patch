diff --git a/test/utils/index.test.js b/test/utils/index.test.js
new file mode 100644
index 0000000..07eccce
--- /dev/null
+++ b/test/utils/index.test.js
@@ -0,0 +1,32 @@
+import * as utilsModule from '../../src/utils';
+
+const defaultExport = utilsModule.default;
+const isSourceMap = defaultExport && defaultExport.isSourceMap;
+
+describe('utils', () => {
+  it('isSourceMap is available on the default export', () => {
+    expect(isSourceMap).toEqual(expect.any(Function));
+
+    const rawSourceMap = {
+      version: 3,
+      file: 'min.js',
+      names: ['bar', 'baz', 'n'],
+      sources: ['one.js', 'two.js'],
+      sourceRoot: 'http://example.com/www/js/',
+      mappings: 'CAAC,IAAI,IAAM,SAAUA,GAClB,OAAOC,IAAID;CCDb,IAAI,IAAM,SAAUE,GAClB,OAAOA',
+    };
+
+    expect(isSourceMap(null)).toBe(false);
+    expect(isSourceMap()).toBe(false);
+    expect(isSourceMap({})).toBe(false);
+    expect(isSourceMap([])).toBe(false);
+    expect(isSourceMap('foo')).toBe(false);
+    expect(isSourceMap(rawSourceMap)).toBe(true);
+
+    ['version', 'sources', 'names', 'mappings'].forEach((field) => {
+      [null, false, 0, ''].forEach((value) => {
+        expect(isSourceMap(Object.assign({}, rawSourceMap, { [field]: value }))).toBe(false);
+      });
+    });
+  });
+});
