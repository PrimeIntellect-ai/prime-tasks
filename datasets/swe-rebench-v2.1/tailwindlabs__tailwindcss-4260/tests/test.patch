+test('important modifier on a generated utility overrides conflicting normal styling', async () => {
+  let config = {
+    mode: 'jit',
+    purge: [path.resolve(__dirname, './important-modifier.test.html')],
+    corePlugins: { preflight: false },
+    plugins: [],
+  }
+
+  let css = `
+    @tailwind utilities;
+
+    .\\!font-bold {
+      font-weight: 400;
+    }
+  `
+
+  let result = await run(css, config)
+  let declarations = []
+
+  postcss.parse(result.css).walkRules((rule) => {
+    if (rule.selector.includes('!font-bold')) {
+      rule.walkDecls('font-weight', (declaration) => {
+        declarations.push({ value: declaration.value, important: Boolean(declaration.important) })
+      })
+    }
+  })
+
+  expect(declarations).toEqual(
+    expect.arrayContaining([
+      { value: '700', important: true },
+      { value: '400', important: false },
+    ])
+  )
+})
+
