+            sys.base_prefix = sys.base_exec_prefix = fake_prefix
+
+            if len(sys.argv) > 2 and sys.argv[1] == "-c":
+                exec(sys.argv[2])
+            else:
+                sys.argv = sys.argv[1:]
+                runpy.run_path(sys.argv[0], run_name="__main__")
+            """
+        ).format(executable=sys.executable)
     )
