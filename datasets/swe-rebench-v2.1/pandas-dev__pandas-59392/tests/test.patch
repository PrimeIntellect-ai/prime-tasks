+def test_drop_duplicates_set():
+    # GH#59237
+    df = DataFrame(
+        {
+            "AAA": ["foo", "bar", "foo", "bar", "foo", "bar", "bar", "foo"],
+            "B": ["one", "one", "two", "two", "two", "two", "one", "two"],
+            "C": [1, 1, 2, 2, 2, 2, 1, 2],
+            "D": range(8),
+        }
+    )
+    # single column
+    result = df.drop_duplicates({"AAA"})
+    expected = df[:2]
+    tm.assert_frame_equal(result, expected)
+
+    result = df.drop_duplicates({"AAA"}, keep="last")
+    expected = df.loc[[6, 7]]
+    tm.assert_frame_equal(result, expected)
+
+    result = df.drop_duplicates({"AAA"}, keep=False)
+    expected = df.loc[[]]
+    tm.assert_frame_equal(result, expected)
+    assert len(result) == 0
+
+    # multi column
+    expected = df.loc[[0, 1, 2, 3]]
+    result = df.drop_duplicates({"AAA", "B"})
+    tm.assert_frame_equal(result, expected)
+
+    result = df.drop_duplicates({"AAA", "B"}, keep="last")
+    expected = df.loc[[0, 5, 6, 7]]
+    tm.assert_frame_equal(result, expected)
+
+    result = df.drop_duplicates({"AAA", "B"}, keep=False)
+    expected = df.loc[[0]]
+    tm.assert_frame_equal(result, expected)
+
+
+def test_duplicated_set():
+    # GH#59237
+    df = DataFrame(
+        {
+            "AAA": ["foo", "bar", "foo", "bar", "foo", "bar", "bar", "foo"],
+            "B": ["one", "one", "two", "two", "two", "two", "one", "two"],
+            "C": [1, 1, 2, 2, 2, 2, 1, 2],
+            "D": range(8),
+        }
+    )
+    # a set of column names is accepted just like a list of column names
+    result = df.duplicated({"AAA"})
+    expected = df.duplicated(["AAA"])
+    tm.assert_series_equal(result, expected)
+
+    result = df.duplicated({"AAA", "B"})
+    expected = df.duplicated(["AAA", "B"])
+    tm.assert_series_equal(result, expected)
+
+    result = df.duplicated({"AAA", "B"}, keep="last")
+    expected = df.duplicated(["AAA", "B"], keep="last")
+    tm.assert_series_equal(result, expected)
+
+
+def test_drop_duplicates_subset_annotation():
+    # GH#59237
+    for method in (DataFrame.drop_duplicates, DataFrame.duplicated):
+        annotation = inspect.signature(method).parameters["subset"].annotation
+        assert str(annotation) == "Hashable | Iterable[Hashable] | None"
+
+
+def test_drop_duplicates_subset_docstring():
+    # GH#59237
+    assert "iterable of labels" in DataFrame.drop_duplicates.__doc__
+    assert "iterable of labels" in DataFrame.duplicated.__doc__
