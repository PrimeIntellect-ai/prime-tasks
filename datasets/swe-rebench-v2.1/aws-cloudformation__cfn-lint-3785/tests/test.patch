+        ("Parameter with a non object definition", "foo"),
+        ("Parameter with a missing type", {}),
+        ("Parameter with a non string type", {"Type": 1}),
+    ],
+)
+def test_parameter_malformed(name, definition):
+    with pytest.raises(ValueError):
+        Parameter(definition)
