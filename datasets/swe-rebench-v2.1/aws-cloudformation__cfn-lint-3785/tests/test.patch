+def test_invalid_findinmap_region_second_key():
+    context = Context(
+        mappings=Mappings.create_from_dict(
+            {
+                "RegionMap": {
+                    "us-east-1": {"HVM64": "ami-1", "HVMG2": "ami-2"},
+                    "us-west-1": {"HVM64": "ami-3", "HVMG2": "ami-4"},
+                },
+            }
+        ),
+    )
+    validator = CfnTemplateValidator().evolve(context=context)
+
+    resolutions = list(
+        validator.resolve_value(
+            {"Fn::FindInMap": ["RegionMap", {"Ref": "AWS::Region"}, "HVM150"]}
+        )
+    )
+
+    errors = [error for _, _, error in resolutions if error is not None]
+    assert errors, (
+        "expected a validation error for a second level key that is not "
+        "defined for any region"
+    )
+
+
+@pytest.mark.parametrize(
