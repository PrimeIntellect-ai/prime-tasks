     assume(value < threshold)
+
+
+def test_multiple_example_reporting():
+    @example(1)
+    @example(2)
+    @settings(report_multiple_bugs=True, phases=[Phase.explicit])
+    @given(integers())
+    def inner_test_multiple_failing_examples(x):
+        assert x < 2
+        assert x < 1
+
+    with pytest.raises(MultipleFailures) as excinfo:
+        inner_test_multiple_failing_examples()
+    # The message describes how many explicit examples failed.
+    assert "2" in str(excinfo.value)
+
+
+def test_single_example_reporting_when_multiple_bugs_disabled():
+    @example(1)
+    @example(2)
+    @settings(report_multiple_bugs=False, phases=[Phase.explicit])
+    @given(integers())
+    def inner_test_multiple_failing_examples(x):
+        assert x < 2
+        assert x < 1
+
+    with pytest.raises(AssertionError):
+        inner_test_multiple_failing_examples()
