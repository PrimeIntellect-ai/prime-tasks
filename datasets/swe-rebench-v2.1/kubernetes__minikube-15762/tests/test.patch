+// TestUnrecordedAddonsAreListedAsDisabled verifies that the persisted profile produced
+// by starting without addon state is shown as disabled by the user-facing list.
+func TestUnrecordedAddonsAreListedAsDisabled(t *testing.T) {
+	profile := createTestProfile(t)
+
+	cmd := exec.Command("go", "run", "../../cmd/minikube", "-p", profile, "addons", "list")
+	cmd.Env = append(os.Environ(), "LC_ALL=C")
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("unable to list addons: %v\n%s", err, output)
+	}
+
+	for name := range assets.Addons {
+		foundDisabled := false
+		for _, line := range strings.Split(string(output), "\n") {
+			columns := strings.Split(line, "|")
+			if len(columns) >= 4 && strings.TrimSpace(columns[1]) == name && strings.Contains(columns[3], "disabled") {
+				foundDisabled = true
+				break
+			}
+		}
+		if !foundDisabled {
+			t.Errorf("expected addon %s to be reported as disabled; list output:\n%s", name, output)
+		}
+	}
+}
