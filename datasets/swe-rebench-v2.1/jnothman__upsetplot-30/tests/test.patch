+def test_vertical():
+    X = generate_data(n_samples=100)
+
+    fig = matplotlib.figure.Figure()
+    UpSet(X, orientation='horizontal').make_grid(fig)
+    horz_height = fig.get_figheight()
+    horz_width = fig.get_figwidth()
+    assert horz_height < horz_width
+
+    fig = matplotlib.figure.Figure()
+    UpSet(X, orientation='vertical').make_grid(fig)
+    vert_height = fig.get_figheight()
+    vert_width = fig.get_figwidth()
+    assert horz_width / horz_height > vert_width / vert_height
+
+
+
+def test_default_orientation():
+    X = generate_data(n_samples=100)
+
+    fig = matplotlib.figure.Figure()
+    UpSet(X).make_grid(fig)
+    default_size = (fig.get_figwidth(), fig.get_figheight())
+
+    fig = matplotlib.figure.Figure()
+    UpSet(X, orientation='horizontal').make_grid(fig)
+    horizontal_size = (fig.get_figwidth(), fig.get_figheight())
+
+    assert default_size == horizontal_size
+
+
+def test_orientation_bars():
+    X = generate_data(n_samples=100)
+
+    fig = matplotlib.figure.Figure()
+    axes = UpSet(X, orientation='horizontal').plot(fig)
+    patches = axes['intersections'].patches
+    assert patches
+    centers = [patch.get_x() + patch.get_width() / 2 for patch in patches]
+    assert centers == sorted(centers)
+
+    fig = matplotlib.figure.Figure()
+    axes = UpSet(X, orientation='vertical').plot(fig)
+    patches = axes['intersections'].patches
+    assert patches
+    centers = [patch.get_y() + patch.get_height() / 2 for patch in patches]
+    assert centers == sorted(centers)
+
+
+@pytest.mark.parametrize('orientation', ['horizontal', 'vertical'])
+def test_module_plot_orientation(orientation):
+    X = generate_data(n_samples=100)
+    fig = matplotlib.figure.Figure()
+    axes = plot(X, fig, orientation=orientation)
+    patches = axes['intersections'].patches
+
+    assert patches
+    if orientation == 'horizontal':
+        centers = [patch.get_x() + patch.get_width() / 2
+                   for patch in patches]
+    else:
+        centers = [patch.get_y() + patch.get_height() / 2
+                   for patch in patches]
+    assert centers == sorted(centers)
+
+
