+
+#[test]
+fn test_attached_stacktrace() {
+    let options = sentry::apply_defaults(sentry::ClientOptions {
+        attach_stacktrace: true,
+        ..Default::default()
+    });
+    let events = sentry::test::with_captured_events_options(
+        || {
+            let error = "thisisnotanumber".parse::<u32>().unwrap_err();
+            sentry::capture_error(&error);
+        },
+        options,
+    );
+
+    let has_stacktrace = |ev: &sentry::protocol::Event| {
+        ev.stacktrace.is_some()
+            || ev.exception.iter().any(|exc| exc.stacktrace.is_some())
+            || ev.threads.iter().any(|thrd| thrd.stacktrace.is_some())
+    };
+    assert!(
+        events
+            .iter()
+            .any(|ev| !ev.exception.is_empty() && has_stacktrace(ev)),
+        "expected the captured error event to carry a stacktrace"
+    );
+}
