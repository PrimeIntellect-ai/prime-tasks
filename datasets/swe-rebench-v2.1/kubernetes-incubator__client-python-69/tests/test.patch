+    def test_ssl_with_relative_ssl_files_loaded_from_file(self):
+        # Relative file references inside a kube-config file must be resolved
+        # against the directory that contains that file when the client loads
+        # it (the ~/.kube/config use case), without the caller supplying a
+        # base path.
+        try:
+            temp_dir = tempfile.mkdtemp()
+            with open(os.path.join(temp_dir, "cert_test"), "wb") as fd:
+                fd.write(TEST_CERTIFICATE_AUTH.encode())
+            with open(os.path.join(temp_dir, "client_cert"), "wb") as fd:
+                fd.write(TEST_CLIENT_CERT.encode())
+            with open(os.path.join(temp_dir, "client_key"), "wb") as fd:
+                fd.write(TEST_CLIENT_KEY.encode())
+            with open(os.path.join(temp_dir, "token_file"), "wb") as fd:
+                fd.write(TEST_DATA.encode())
+            config_file = os.path.join(temp_dir, "kube-config")
+            file_config = dict(self.TEST_KUBE_CONFIG)
+            file_config["current-context"] = "ssl-local-file"
+            with open(config_file, "w") as fd:
+                yaml.dump(file_config, fd)
+
+            saved = (configuration.ssl_ca_cert, configuration.cert_file,
+                     configuration.key_file, configuration.host,
+                     dict(configuration.api_key))
+            # PyYAML >= 6 requires an explicit Loader for yaml.load; supply one
+            # so the client's file-loading path can be exercised here.
+            original_load = yaml.load
+
+            def _patched_load(stream, *args, **kwargs):
+                kwargs.setdefault('Loader', yaml.SafeLoader)
+                return original_load(stream, *args, **kwargs)
+
+            yaml.load = _patched_load
+            try:
+                load_kube_config(config_file)
+                self.assertEqual(
+                    os.path.realpath(os.path.join(temp_dir, "cert_test")),
+                    os.path.realpath(configuration.ssl_ca_cert))
+                self.assertEqual(
+                    os.path.realpath(os.path.join(temp_dir, "client_cert")),
+                    os.path.realpath(configuration.cert_file))
+                self.assertEqual(
+                    os.path.realpath(os.path.join(temp_dir, "client_key")),
+                    os.path.realpath(configuration.key_file))
+            finally:
+                yaml.load = original_load
+                (configuration.ssl_ca_cert, configuration.cert_file,
+                 configuration.key_file, configuration.host) = saved[:4]
+                configuration.api_key = saved[4]
+        finally:
+            shutil.rmtree(temp_dir)
+
 
 if __name__ == '__main__':
     unittest.main()
