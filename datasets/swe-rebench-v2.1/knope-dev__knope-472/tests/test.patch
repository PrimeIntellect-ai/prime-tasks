+
+
+#[test]
+fn github_release_preserves_prose_in_order() {
+    let temp_dir = tempfile::tempdir().unwrap();
+    let temp_path = temp_dir.path();
+    let source_path = Path::new("tests/github_release");
+
+    init(temp_path);
+    commit(temp_path, "feat: Existing feature");
+    tag(temp_path, "v1.0.0");
+    commit(
+        temp_path,
+        "feat: New feature\n\nChangelog-Note: First prose line\n\nSecond prose line",
+    );
+
+    for file in ["knope.toml", "CHANGELOG.md", "Cargo.toml"] {
+        copy(source_path.join(file), temp_path.join(file)).unwrap();
+    }
+
+    let output = std::process::Command::new(cargo_bin!("knope"))
+        .arg("release")
+        .arg("--dry-run")
+        .current_dir(temp_path)
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "release command failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    let body = stdout.split_once("and body:\n").unwrap().1;
+    let first = body.find("First prose line").unwrap();
+    let second = body.find("Second prose line").unwrap();
+    assert!(first < second, "release prose changed order: {body}");
+    assert!(body.contains("### First prose line"), "{body}");
+}
