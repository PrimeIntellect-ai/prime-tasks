+
+  # Collects acknowledgment events for `ref` until `expected_count` messages
+  # have been acknowledged. This is tolerant to how the acknowledger groups
+  # the messages (one combined call or one call per message).
+  defp collect_acks(ref, expected_count) do
+    collect_acks(ref, expected_count, [], [])
+  end
+
+  defp collect_acks(_ref, remaining, successful, failed) when remaining <= 0 do
+    {Enum.reverse(successful), Enum.reverse(failed)}
+  end
+
+  defp collect_acks(ref, remaining, successful, failed) do
+    receive do
+      {:ack, ^ref, new_successful, new_failed} ->
+        collect_acks(
+          ref,
+          remaining - length(new_successful) - length(new_failed),
+          Enum.reverse(new_successful) ++ successful,
+          Enum.reverse(new_failed) ++ failed
+        )
+    after
+      1000 ->
+        flunk(
+          "expected #{remaining} more acked message(s), but the acknowledger was not invoked for all of them"
+        )
+    end
+  end
