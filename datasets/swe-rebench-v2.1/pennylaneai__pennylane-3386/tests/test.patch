@@ -623,6 +623,19 @@ class TestBarrier:
         op = qml.Barrier(wires=(0, 1, 2, 3), only_visual=False)
         assert op.simplify() is op
 
+    def test_qml_matrix_and_method_agree(self):
+        """Test that qml.matrix(op) and op.matrix() have matching availability."""
+        op = qml.Barrier(0)
+        results = []
+        for matrix_fn in (qml.matrix, lambda operation: operation.matrix()):
+            try:
+                matrix_fn(op)
+            except Exception:
+                results.append(False)
+            else:
+                results.append(True)
+        assert results[0] == results[1]
+
 
