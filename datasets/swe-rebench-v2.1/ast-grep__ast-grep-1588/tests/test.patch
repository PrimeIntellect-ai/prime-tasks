+#[test]
+fn test_inspect_scan_summary() -> Result<()> {
+  let dir = create_test_files([
+    ("sgconfig.yml", "ruleDirs:\n- rules\n"),
+    (
+      "rules/on-rule.yml",
+      "id: on-rule\nmessage: test rule\nseverity: warning\nlanguage: TypeScript\nrule:\n  pattern: Some($A)\n",
+    ),
+    (
+      "rules/off-rule.yml",
+      "id: off-rule\nseverity: off\nlanguage: TypeScript\nrule:\n  pattern: Some($A)\n",
+    ),
+    ("test.ts", "Some(123)"),
+  ])?;
+  let config = dir.path().join("sgconfig.yml");
+  Command::cargo_bin("sg")?
+    .current_dir(dir.path())
+    .args(["scan", "-c"])
+    .arg(&config)
+    .args(["--inspect", "entity"])
+    .assert()
+    .success()
+    .stderr(contains("sg: summary|file: scannedFileCount="))
+    .stderr(contains(",skippedFileCount="))
+    .stderr(contains(
+      "sg: summary|rule: effectiveRuleCount=1,skippedRuleCount=1",
+    ))
+    .stderr(contains(
+      "sg: entity|file|test.ts: language=TypeScript,appliedRuleCount=1",
+    ));
   Ok(())
 }
