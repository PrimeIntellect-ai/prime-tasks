--- a/server/jetstream_test.go
+++ b/server/jetstream_test.go
@@ -19215,3 +19215,74 @@ func TestJetStreamMetaDataFailOnKernelFault(t *testing.T) {
 	require_NoError(t, err)
 	require_True(t, si.State.Msgs == 10)
 }
+
+// https://github.com/nats-io/nats-server/issues/3734
+func TestJetStreamMsgBlkFailOnKernelFault(t *testing.T) {
+	s := RunBasicJetStreamServer(t)
+	defer s.Shutdown()
+
+	nc, js := jsClientConnect(t, s)
+	defer nc.Close()
+
+	_, err := js.AddStream(&nats.StreamConfig{
+		Name:     "TEST",
+		Subjects: []string{"foo"},
+		MaxBytes: 10 * 1024 * 1024, // 10MB
+	})
+	require_NoError(t, err)
+
+	msgSize := 1024 * 1024 // 1MB
+	msg := make([]byte, msgSize)
+	rand.Read(msg)
+
+	accepted := 0
+	for i := 0; i < 20; i++ {
+		if _, err := js.Publish("foo", msg); err != nil {
+			break
+		}
+		accepted++
+	}
+	require_True(t, accepted > 0)
+
+	// Emulate a kernel fault by replacing one message block with a zero-byte file.
+	sd := s.JetStreamConfig().StoreDir
+	s.Shutdown()
+
+	var blocks []string
+	err = filepath.Walk(sd, func(path string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		if !info.IsDir() && filepath.Ext(path) == ".blk" {
+			blocks = append(blocks, path)
+		}
+		return nil
+	})
+	require_NoError(t, err)
+	require_True(t, len(blocks) > 0)
+	sort.Strings(blocks)
+	err = os.WriteFile(blocks[len(blocks)/2], nil, defaultFilePerms)
+	require_NoError(t, err)
+
+	s = RunJetStreamServerOnPort(-1, sd)
+	defer s.Shutdown()
+
+	nc, js = jsClientConnect(t, s)
+	defer nc.Close()
+
+	// The stream must still enforce its configured byte limit after recovering
+	// from the zero-byte block. We intentionally do not assert exact deleted or
+	// lost sequence numbers, since the public contract only requires that the
+	// configured limit keeps being honored.
+	for i := 0; i < 20; i++ {
+		// Publishing may be refused once the stream reaches its configured cap.
+		_, _ = js.Publish("foo", msg)
+	}
+
+	si, err := js.StreamInfo("TEST")
+	require_NoError(t, err)
+	if si.State.Bytes > uint64(si.Config.MaxBytes) {
+		t.Fatalf("MaxBytes not enforced with empty interior msg blk, max %v, bytes %v",
+			friendlyBytes(si.Config.MaxBytes), friendlyBytes(int64(si.State.Bytes)))
+	}
+}
