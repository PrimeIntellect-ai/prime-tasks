+    public function test_it_does_not_prefix_numbered_backreference_strings(): void
+    {
+        $prefix = 'Humbug';
+        $symbolsRegistry = new SymbolsRegistry();
+
+        $container = new Container();
+
+        $scoper = new PhpScoper(
+            $container->getParser(),
+            $this->decoratedScoper,
+            new TraverserFactory(
+                new EnrichedReflector(
+                    Reflector::createEmpty(),
+                    SymbolsConfiguration::create(),
+                ),
+                $prefix,
+                $symbolsRegistry,
+            ),
+            $container->getPrinter(),
+        );
+
+        $actual = $scoper->scope(
+            'file.php',
+            <<<'PHP'
+                <?php
+
+                $body = RegEx::replace('...(some).*?(regex)...', '\\1\\2', $body);
+
+                PHP,
+        );
+
+        self::assertStringNotContainsString('Humbug\\1\\2', $actual);
+    }
