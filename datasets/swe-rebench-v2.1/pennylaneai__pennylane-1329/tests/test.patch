+    @pytest.mark.parametrize("wires", [[0, 1], [2, 0]])
+    def test_swap_decomposition(self, wires):
+        """The decomposition evolves states in the same way as SWAP."""
+        decomp = qml.SWAP.decomposition(wires)
+
+        assert isinstance(decomp, list)
+
+        def matrix_on_wires(op):
+            op_wires = op.wires.tolist()
+            local_matrix = op.matrix
+            full_matrix = np.zeros((4, 4), dtype=complex)
+
+            for input_index in range(4):
+                input_bits = [(input_index >> 1) & 1, input_index & 1]
+                local_input = sum(
+                    input_bits[wires.index(wire)] << (len(op_wires) - position - 1)
+                    for position, wire in enumerate(op_wires)
+                )
+                for local_output in range(2 ** len(op_wires)):
+                    output_bits = input_bits.copy()
+                    for position, wire in enumerate(op_wires):
+                        bit = (local_output >> (len(op_wires) - position - 1)) & 1
+                        output_bits[wires.index(wire)] = bit
+                    output_index = 2 * output_bits[0] + output_bits[1]
+                    full_matrix[output_index, input_index] = local_matrix[local_output, local_input]
+
+            return full_matrix
+
+        decomposed_matrix = np.eye(4)
+        for op in decomp:
+            decomposed_matrix = matrix_on_wires(op) @ decomposed_matrix
+
+        assert np.allclose(decomposed_matrix, qml.SWAP(wires=wires).matrix)
+
