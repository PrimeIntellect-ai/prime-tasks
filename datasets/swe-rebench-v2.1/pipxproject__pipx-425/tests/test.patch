diff --git a/tests/test_package_specifier.py b/tests/test_package_specifier.py
new file mode 100644
index 0000000..26c2048
--- /dev/null
+++ b/tests/test_package_specifier.py
@@ -0,0 +1,142 @@
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest  # type: ignore
+
+from helpers import run_pipx_cli
+from pipx import constants
+from pipx.util import PipxError
+
+
+# TODO: Make sure git+ works with tests, correct in test_install as well
+@pytest.mark.parametrize(
+    "package_spec_in,package_or_url_correct,valid_spec",
+    [
+        ("pipx", "pipx", True),
+        ("PiPx_stylized.name", "pipx-stylized-name", True),
+        ("pipx==0.15.0", "pipx", True),
+        ("pipx>=0.15.0", "pipx", True),
+        ("pipx<=0.15.0", "pipx", True),
+        ('pipx;python_version>="3.6"', "pipx", True),
+        ('pipx==0.15.0;python_version>="3.6"', "pipx", True),
+        ("pipx[extra1]", "pipx[extra1]", True),
+        ("pipx[extra1, extra2]", "pipx[extra1,extra2]", True),
+        (
+            "git+https://github.com/cs01/nox.git@5ea70723e9e6",
+            "git+https://github.com/cs01/nox.git@5ea70723e9e6",
+            True,
+        ),
+        (
+            "nox@git+https://github.com/cs01/nox.git@5ea70723e9e6",
+            None,
+            True,
+        ),
+        (
+            "https://github.com/ambv/black/archive/18.9b0.zip",
+            "https://github.com/ambv/black/archive/18.9b0.zip",
+            True,
+        ),
+        (
+            "black@https://github.com/ambv/black/archive/18.9b0.zip",
+            None,
+            True,
+        ),
+        (
+            "black @ https://github.com/ambv/black/archive/18.9b0.zip",
+            None,
+            True,
+        ),
+        ("not a valid spec", "invalid-spec", False),
+    ],
+)
+def test_parse_specifier_for_metadata(
+    package_spec_in, package_or_url_correct, valid_spec
+):
+    from pipx.package_specifier import parse_specifier_for_metadata
+
+    if valid_spec:
+        package_or_url = parse_specifier_for_metadata(package_spec_in)
+        if package_spec_in.startswith("nox@git+"):
+            assert "git+https://github.com/cs01/nox.git@5ea70723e9e6" in package_or_url
+        elif package_spec_in.startswith("black"):
+            assert "https://github.com/ambv/black/archive/18.9b0.zip" in package_or_url
+        elif package_spec_in == "pipx[extra1, extra2]":
+            assert package_or_url.startswith("pipx[") and package_or_url.endswith("]")
+            assert set(package_or_url[5:-1].split(",")) == {"extra1", "extra2"}
+            assert " " not in package_or_url
+        else:
+            assert package_or_url == package_or_url_correct
+    else:
+        # print package_spec_in for info in case no error is raised
+        print(f"package_spec_in = {package_spec_in}")
+        with pytest.raises(PipxError, match=r"^Unable to parse package spec"):
+            package_or_url = parse_specifier_for_metadata(package_spec_in)
+
+
+def test_parse_specifier_for_metadata_local_path(tmp_path, monkeypatch):
+    from pipx.package_specifier import parse_specifier_for_metadata
+
+    # A local filesystem path is converted to an absolute path.
+    local_dir = tmp_path / "local package"
+    local_dir.mkdir()
+    monkeypatch.chdir(tmp_path)
+    assert parse_specifier_for_metadata("local package") == str(local_dir.resolve())
+
+
+def _make_package_src(root: Path, name: str, version: str) -> Path:
+    package_src = root / f"{name}-{version}"
+    (package_src / name).mkdir(parents=True)
+    (package_src / "setup.py").write_text(
+        "from setuptools import setup\n"
+        f"setup(name={name!r}, version={version!r}, packages=[{name!r}],\n"
+        f"      entry_points={{'console_scripts': [{name + '=' + name + ':main'!r}]}})\n"
+    )
+    (package_src / name / "__init__.py").write_text(
+        "def main():\n    print('hello')\n"
+    )
+    return package_src
+
+
+def _build_wheel(package_src: Path, wheel_dir: Path) -> None:
+    subprocess.run(
+        [
+            sys.executable,
+            "-m",
+            "pip",
+            "wheel",
+            "--no-deps",
+            "--no-build-isolation",
+            "-w",
+            str(wheel_dir),
+            str(package_src),
+        ],
+        check=True,
+        capture_output=True,
+    )
+
+
+def test_install_strips_version_specifier_from_metadata(tmp_path, pipx_temp_env):
+    # Installing a version-specified requirement must install that exact
+    #   version, but must not persist the version specifier in metadata.
+    wheel_dir = tmp_path / "wheels"
+    wheel_dir.mkdir()
+    _build_wheel(_make_package_src(tmp_path, "mypkg", "0.1.0"), wheel_dir)
+    _build_wheel(_make_package_src(tmp_path, "mypkg", "0.2.0"), wheel_dir)
+
+    assert not run_pipx_cli(
+        [
+            "install",
+            "mypkg==0.1.0",
+            "--pip-args",
+            f"--find-links {wheel_dir} --no-index",
+        ]
+    )
+
+    metadata_path = constants.PIPX_LOCAL_VENVS / "mypkg" / "pipx_metadata.json"
+    metadata = json.loads(metadata_path.read_text())
+    # The requested version must actually have been installed...
+    assert metadata["main_package"]["package_version"] == "0.1.0"
+    # ...but the version specifier must not be stored in metadata.
+    assert metadata["main_package"]["package_or_url"] == "mypkg"
