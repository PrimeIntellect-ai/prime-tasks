diff --git a/src/Query/Filter/RecurrenceField.ts b/src/Query/Filter/RecurrenceField.ts
new file mode 100644
index 00000000..02b03a58
--- /dev/null
+++ b/src/Query/Filter/RecurrenceField.ts
@@ -0,0 +1,16 @@
+import type { Task } from '../../Task';
+import { TextField } from './TextField';
+
+export class RecurrenceField extends TextField {
+    fieldName(): string {
+        return 'recurrence';
+    }
+
+    value(task: Task): string {
+        if (task.recurrence !== null) {
+            return task.recurrence!.toText();
+        } else {
+            return '';
+        }
+    }
+}
