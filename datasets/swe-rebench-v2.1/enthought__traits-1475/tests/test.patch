+    @requires_sphinx
+    def test_trait_documenter_add_content_emits_no_deprecation_warning(self):
+        # Documenting a trait with Sphinx must not trigger Sphinx
+        # deprecation warnings (for example about ``no_docstring``).
+        from traits.util.trait_documenter import TraitDocumenter
+
+        class Foo(HasTraits):
+            bar = Int(3)
+
+        documenter = TraitDocumenter(mock.MagicMock(), "bar", "")
+        documenter.object_name = "bar"
+        documenter.parent = Foo
+        documenter.objpath = ["Foo", "bar"]
+        documenter.modname = __name__
+        documenter.fullname = __name__ + ".Foo.bar"
+
+        with warnings.catch_warnings(record=True) as caught:
+            warnings.simplefilter("always")
+            documenter.add_content(None)
+
+        deprecation_types = (DeprecationWarning, PendingDeprecationWarning)
+        deprecations = [
+            w for w in caught if issubclass(w.category, deprecation_types)
+        ]
+        self.assertEqual(deprecations, [])
