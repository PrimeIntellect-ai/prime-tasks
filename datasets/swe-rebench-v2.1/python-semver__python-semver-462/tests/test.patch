--- a/tests/test_bump.py
+++ b/tests/test_bump.py
@@ -78,6 +78,16 @@ def test_should_versioninfo_bump_prerelease_with_none():
     assert v.bump_prerelease(None) == expected
 
 
+def test_should_versioninfo_bump_prerelease_nonnumeric_nine():
+    v = parse_version_info("3.4.5-rc9")
+    try:
+        bumped = v.bump_prerelease(None)
+    except Exception:
+        # It is acceptable to report that no higher prerelease can be determined.
+        return
+    assert v.compare(bumped) == -1
+
