+const lintWithDynamicRole = (element) => {
+  const linter = new Linter();
+  linter.defineParser("vue-eslint-parser", require("vue-eslint-parser"));
+  linter.defineRule("role-has-required-aria-props", rule);
+  linter.verify(`<template>${element}</template>`, {
+    parser: "vue-eslint-parser",
+    parserOptions: { ecmaVersion: 2015, sourceType: "module" },
+    rules: { "role-has-required-aria-props": "error" }
+  });
+};
+
+describe("role-has-required-aria-props with a dynamic role", () => {
+  test.each([
+    "<span :role='role' aria-checked='false' aria-labelledby='test' tabindex='0' />",
+    "<span :role='role' />"
+  ])("does not throw while linting %s", (element) => {
+    expect(() => lintWithDynamicRole(element)).not.toThrow();
+  });
+});
