+def test_record_message_parse_time_extracted():
+    message_dic = {
+        "type": "RECORD",
+        "stream": "test",
+        "record": {"id": 1, "name": "test"},
+        "version": 42,
+        "time_extracted": "2021-01-01T00:00:00Z",
+    }
+    record = singer.RecordMessage.from_dict(message_dic)
+    assert record.type == "RECORD"
+    assert record.stream == "test"
+    assert record.record == {"id": 1, "name": "test"}
+    assert record.version == 42
+    assert record.time_extracted == datetime.datetime(2021, 1, 1, 0, 0, 0, tzinfo=UTC)
+
+
+def test_record_message_parse_time_extracted_with_timezone_offset():
+    """Parse an ISO timestamp with an offset into the extracted datetime."""
+    message_dic = {
+        "type": "RECORD",
+        "stream": "test",
+        "record": {"id": 1, "name": "test"},
+        "time_extracted": "2021-01-01T01:00:00+01:00",
+    }
+    record = singer.RecordMessage.from_dict(message_dic)
+    assert record.time_extracted == datetime.datetime(2021, 1, 1, 0, 0, 0, tzinfo=UTC)
+
