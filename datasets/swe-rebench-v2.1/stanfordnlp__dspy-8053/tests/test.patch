+import pytest
+import dspy
+from dspy.propose.grounded_proposer import GroundedProposer
+from dspy.predict import Predict
+from dspy.utils.dummies import DummyLM
+
+
+def _per_predictor_instructions(result):
+    """Normalize the program-level result into a list of per-predictor entries.
+
+    The public contract specifies a list of instructions, one per predictor, but
+    implementations may also return a mapping keyed by predictor index. Both
+    shapes are accepted here.
+    """
+    if isinstance(result, dict):
+        return list(result.values())
+    return list(result)
+
+
+@pytest.mark.parametrize(
+    "demo_candidates",
+    [
+        None,
+        [[[dspy.Example(question="What is the capital of France?", answer="Paris")]]],
+    ],
+)
+def test_propose_instructions_for_program(demo_candidates):
+    # Set large numner here so that lm always returns the same response
+    prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+    program = Predict("question -> answer")
+    trainset = []
+
+    proposer = GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset, verbose=False)
+    result = proposer.propose_instructions_for_program(
+        trainset=trainset, program=program, demo_candidates=demo_candidates, trial_logs={}, N=1, T=0.5
+    )
+
+    per_predictor = _per_predictor_instructions(result)
+    assert len(per_predictor) == len(program.predictors())
+    for entry in per_predictor:
+        # Each predictor's entry may be a single instruction string or a list of
+        # instruction candidates; both are allowed by the contract.
+        candidates = entry if isinstance(entry, list) else [entry]
+        assert candidates == ["instruction"]
+
+
+def test_propose_instructions_for_program_uses_fallback_count():
+    """When demo_candidates is None, N instruction candidates are generated per predictor."""
+    prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 30)
+    program = Predict("question -> answer")
+    trainset = []
+
+    proposer = GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset, verbose=False)
+    result = proposer.propose_instructions_for_program(
+        trainset=trainset, program=program, demo_candidates=None, trial_logs={}, N=3, T=0.5
+    )
+
+    per_predictor = _per_predictor_instructions(result)
+    assert len(per_predictor) == len(program.predictors())
+    for entry in per_predictor:
+        candidates = entry if isinstance(entry, list) else [entry]
+        assert candidates == ["instruction"] * 3
+
+
+@pytest.mark.parametrize(
+    "demo_candidates",
+    [
+        None,
+        [[[dspy.Example(question="What is the capital of France?", answer="Paris")]]],
+    ],
+)
+def test_propose_instruction_for_predictor(demo_candidates):
+    prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+    program = Predict("question -> answer")
+
+    proposer = GroundedProposer(prompt_model=prompt_model, program=program, trainset=[], verbose=False)
+    result = proposer.propose_instruction_for_predictor(
+        program=program,
+        predictor=program.predictors()[0],
+        pred_i=0,
+        T=0.5,
+        demo_candidates=demo_candidates,
+        demo_set_i=0,
+        trial_logs={},
+        tip=None,
+    )
+    assert result == "instruction"
+
+
+def test_missing_candidates_do_not_add_training_examples_to_prompt():
+    demo_marker = "unique-training-demo-marker"
+    trainset = [dspy.Example(question=demo_marker, answer="demo answer", augmented=True)]
+    prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+    program = Predict("question -> answer")
+    proposer = GroundedProposer(
+        prompt_model=prompt_model,
+        program=program,
+        trainset=trainset,
+        program_aware=False,
+        use_dataset_summary=False,
+        verbose=False,
+    )
+
+    proposer.propose_instructions_for_program(
+        trainset=trainset, program=program, demo_candidates=None, trial_logs={}, N=2, T=0.5
+    )
+
+    prompt_text = "\n".join(
+        message["content"]
+        for request in prompt_model.history
+        for message in request["messages"]
+    )
+    assert demo_marker not in prompt_text
+
+
+def test_direct_call_without_candidates_disables_training_demos():
+    demo_marker = "unique-direct-call-training-demo-marker"
+    trainset = [dspy.Example(question=demo_marker, answer="demo answer", augmented=True)]
+    prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+    program = Predict("question -> answer")
+    proposer = GroundedProposer(
+        prompt_model=prompt_model,
+        program=program,
+        trainset=trainset,
+        program_aware=False,
+        use_dataset_summary=False,
+        verbose=False,
+    )
+
+    result = proposer.propose_instruction_for_predictor(
+        program=program,
+        predictor=program.predictors()[0],
+        pred_i=0,
+        T=0.5,
+        demo_candidates=None,
+        demo_set_i=0,
+        trial_logs={},
+    )
+
+    assert result == "instruction"
+    prompt_text = "\n".join(
+        message["content"]
+        for request in prompt_model.history
+        for message in request["messages"]
+    )
+    assert demo_marker not in prompt_text
