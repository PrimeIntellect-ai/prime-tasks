+def _shorter_lists(list_type):
+    return st.lists(st.from_type(*typing.get_args(list_type)), max_size=2)
+
+
+def test_can_register_builtin_list():
+    # Regression test for https://github.com/HypothesisWorks/hypothesis/issues/3635
+    # temp_registered() registers via the public st.register_type_strategy() API,
+    # so this exercises the documented public behaviour for the builtin list type.
+    with temp_registered(list, _shorter_lists):
+        assert_all_examples(
+            st.from_type(list[int]),
+            lambda ls: len(ls) <= 2 and {type(x) for x in ls}.issubset({int}),
+        )
+
+
+def test_can_register_builtin_list_for_infer():
+    # The contract demonstrates registering a strategy for the builtin ``list``
+    # type and then relying on it via ``@given(infer)`` with an annotated
+    # argument, which is a distinct entry path from a direct ``st.from_type``.
+    with temp_registered(list, _shorter_lists):
+
+        @given(infer)
+        def test_example(example: list[int]):
+            assert len(example) <= 2
+            assert {type(x) for x in example}.issubset({int})
+
+        test_example()
