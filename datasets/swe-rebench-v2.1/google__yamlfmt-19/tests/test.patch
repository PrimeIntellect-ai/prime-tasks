+
+func TestFormatterParsesMultipleDocuments(t *testing.T) {
+	f := &basic.BasicFormatter{Config: basic.DefaultConfig()}
+
+	yaml := `b:
+---
+a:
+---
+c:
+`
+	s, err := f.Format([]byte(yaml))
+	if err != nil {
+		t.Fatalf("expected formatting to pass, returned error: %v", err)
+	}
+	decoder := yamlv3.NewDecoder(strings.NewReader(string(s)))
+	wantKeys := []string{"b", "a", "c"}
+	for i, wantKey := range wantKeys {
+		var doc map[string]interface{}
+		if err := decoder.Decode(&doc); err != nil {
+			t.Fatalf("could not decode output document %d: %v", i+1, err)
+		}
+		if len(doc) != 1 {
+			t.Fatalf("output document %d has unexpected contents: %#v", i+1, doc)
+		}
+		if _, ok := doc[wantKey]; !ok {
+			t.Fatalf("output document %d should contain key %q, got %#v", i+1, wantKey, doc)
+		}
+	}
+	var extra map[string]interface{}
+	if err := decoder.Decode(&extra); err != io.EOF {
+		t.Fatalf("expected exactly %d output documents, got an additional document or error: %#v, %v", len(wantKeys), extra, err)
+	}
+}
