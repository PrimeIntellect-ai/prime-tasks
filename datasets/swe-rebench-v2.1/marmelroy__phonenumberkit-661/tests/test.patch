diff --git a/PhoneNumberKitTests/PhoneNumberKitTests.swift b/PhoneNumberKitTests/PhoneNumberKitTests.swift
index 23cc396..22100a5 100644
--- a/PhoneNumberKitTests/PhoneNumberKitTests.swift
+++ b/PhoneNumberKitTests/PhoneNumberKitTests.swift
@@ -457,4 +457,23 @@ class PhoneNumberKitTests: XCTestCase {
             }
         }
     }
+
+    func testValidCZNumbers() {
+        let numbers = ["420734593819", "+420734593819", "734593819"]
+        numbers.forEach { XCTAssertTrue(phoneNumberKit.isValidPhoneNumber($0, withRegion: "CZ")) }
+    }
+
+    // GitHub issue #661: parsing a Czech number with the country code but no
+    // leading "+" must succeed when the region is provided.
+    func testParseCZNumberWithCountryCodeAndNoPlus() {
+        do {
+            let phoneNumber = try phoneNumberKit.parse("420777666555", withRegion: "CZ")
+            XCTAssertEqual(phoneNumber.countryCode, 420)
+            XCTAssertEqual(phoneNumber.nationalNumber, 777666555)
+            let formatted = phoneNumberKit.format(phoneNumber, toType: .international)
+            XCTAssertFalse(formatted.isEmpty)
+        } catch {
+            XCTFail("Expected parsing of 420777666555 with region CZ to succeed, but got \(error)")
+        }
+    }
 }
