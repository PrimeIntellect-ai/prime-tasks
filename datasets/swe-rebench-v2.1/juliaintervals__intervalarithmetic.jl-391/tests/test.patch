+    @testset "Interval{Float32}" begin
+        a = Interval{Float32}(1, 2)
+        b = Interval{Float32}(-1, Inf)
+        n = Interval{Float32}(-Inf, 1)
+        e = emptyinterval(Float32)
+
+        setformat(:standard)
+        @test string(a) == "[1f0, 2f0]"
+        @test string(b) == "[-1f0, ∞]"
+        @test string(n) == "[-∞, 1f0]"
+        @test string(e) == "∅"
+
+        setformat(:full)
+        @test string(a) == "Interval(1.0f0, 2.0f0)"
+        @test string(b) == "Interval(-1.0f0, ∞)"
+        @test string(n) == "Interval(-∞, 1.0f0)"
+        @test IntervalArithmetic.basic_representation(n, :full) == "Interval(-∞, 1.0f0)"
+        @test string(e) == "∅"
+
+        setformat(:midpoint)
+        @test string(a) == "1.5f0 ± 0.5f0"
+        @test string(e) == "∅"
+
+        # an explicit format argument overrides the global display format
+        @test IntervalArithmetic.basic_representation(a, :standard) == "[1f0, 2f0]"
+        @test IntervalArithmetic.basic_representation(a, :full) == "Interval(1.0f0, 2.0f0)"
+        @test IntervalArithmetic.basic_representation(a, :midpoint) == "1.5f0 ± 0.5f0"
+        @test IntervalArithmetic.basic_representation(e, :full) == "∅"
+    end
+
 
     setprecision(Interval, 256)
 
