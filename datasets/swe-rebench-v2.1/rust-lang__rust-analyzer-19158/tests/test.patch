+#[test]
+fn public_glob_reexport_expands_all_public_items() {
+    let fixture = r#"
+mod foo {
+    pub struct Bar;
+    pub struct Baz;
+    pub trait Marker {}
+    pub enum Choice { First }
+    pub fn helper() {}
+}
+
+pub use foo::*$0;
+"#;
+    let (db, file_id, selection) = super::RootDatabase::with_range_or_offset(fixture);
+    let frange = super::FileRange { file_id, range: selection.into() };
+
+    let produces_explicit_reexport =
+        crate::assists(&db, &super::TEST_CONFIG, super::AssistResolveStrategy::All, frange.into())
+            .into_iter()
+            .filter_map(|assist| {
+                let source_change = assist.source_change?;
+                let (source_file_edit, snippet_edit) =
+                    source_change.get_source_and_snippet_edit(file_id.file_id())?;
+                let mut actual = db.file_text(file_id.file_id()).to_string();
+                source_file_edit.apply(&mut actual);
+                if let Some(snippet_edit) = snippet_edit {
+                    snippet_edit.apply(&mut actual);
+                }
+                Some(actual)
+            })
+            .any(|actual| {
+                actual
+                    .split_once("pub use foo::")
+                    .and_then(|(_, reexport)| reexport.split_once(';'))
+                    .map(|(tree, _)| {
+                        ["Bar", "Baz", "Marker", "Choice", "helper"]
+                            .iter()
+                            .all(|name| tree.contains(name))
+                            && !tree.contains('*')
+                    })
+                    .unwrap_or(false)
+            });
+
+    assert!(produces_explicit_reexport, "public glob reexport was not expanded to its public items");
+}
