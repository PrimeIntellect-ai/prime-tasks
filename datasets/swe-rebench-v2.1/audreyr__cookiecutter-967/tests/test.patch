+def test_get_config_abbreviations_resolve_prefix():
+    """
+    A user config that defines its own abbreviations must not remove the
+    built-in prefixes, so a prefixed template reference still resolves.
+    """
+    conf = config.get_config('tests/test-config/valid-config.yaml')
+    assert expand_abbreviations(
+        'gh:audreyr/cookiecutter-pypackage', conf['abbreviations']
+    ) == 'https://github.com/audreyr/cookiecutter-pypackage.git'
