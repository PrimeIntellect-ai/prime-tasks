+func TestSeverityValuesMatchStyleGuide(t *testing.T) {
+	// The Severity enum of a check Problem must use the same numeric values as
+	// the Severity enum of a style guide Rule.
+	for name, want := range rpc.Rule_Severity_value {
+		got, ok := rpc.Problem_Severity_value[name]
+		if !ok {
+			t.Errorf("check Severity is missing %q, which the style Severity defines as %d", name, want)
+			continue
+		}
+		if got != want {
+			t.Errorf("check Severity %q = %d, want %d to match the style Severity", name, got, want)
+		}
+	}
+}
