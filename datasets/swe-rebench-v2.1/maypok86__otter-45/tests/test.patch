+func TestCache_DeleteByFuncRemovesOnlyMatchingEntriesWithTheirKeyAndValue(t *testing.T) {
+	const size = 256
+	c, err := MustBuilder[int, int](size).WithTTL(time.Hour).Build()
+	if err != nil {
+		t.Fatalf("can not create builder: %v", err)
+	}
+
+	for key := 0; key < size; key++ {
+		c.Set(key, size-key)
+	}
+
+	c.DeleteByFunc(func(key int, value int) bool {
+		return key%2 == 1 && value%3 == 1
+	})
+
+	c.Range(func(key int, value int) bool {
+		if key%2 == 1 && value%3 == 1 {
+			t.Fatalf("entry matching the predicate remains: key=%d value=%d", key, value)
+		}
+		return true
+	})
+
+	for key := 0; key < size; key++ {
+		wantPresent := key%2 != 1 || (size-key)%3 != 1
+		value, ok := c.Get(key)
+		if ok != wantPresent {
+			t.Fatalf("key %d present = %t, want %t", key, ok, wantPresent)
+		}
+		if ok && value != size-key {
+			t.Fatalf("value for key %d = %d, want %d", key, value, size-key)
+		}
+	}
+}
