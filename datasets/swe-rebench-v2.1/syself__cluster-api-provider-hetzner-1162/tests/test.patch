+var _ = Describe("Reconcile host compatibility", func() {
+	const defaultNamespace = "default"
+
+	type mismatchCase struct {
+		swraid int
+		hints  infrav1.RootDeviceHints
+	}
+
+	DescribeTable("does not associate a host with incompatible disk hints",
+		func(tc mismatchCase) {
+			scheme := runtime.NewScheme()
+			utilruntime.Must(infrav1.AddToScheme(scheme))
+			host := &infrav1.HetznerBareMetalHost{
+				ObjectMeta: metav1.ObjectMeta{Name: "candidate", Namespace: defaultNamespace},
+				Spec: infrav1.HetznerBareMetalHostSpec{
+					RootDeviceHints: &tc.hints,
+					Status:          infrav1.ControllerGeneratedStatus{ProvisioningState: infrav1.StateNone},
+				},
+			}
+			c := fakeclient.NewClientBuilder().WithScheme(scheme).WithObjects(host).Build()
+			bmMachine := &infrav1.HetznerBareMetalMachine{
+				ObjectMeta: metav1.ObjectMeta{Name: "candidate-machine", Namespace: defaultNamespace},
+				Spec: infrav1.HetznerBareMetalMachineSpec{
+					InstallImage: infrav1.InstallImage{Swraid: tc.swraid},
+				},
+			}
+			machine := &clusterv1.Machine{
+				ObjectMeta: metav1.ObjectMeta{Name: "candidate-machine", Namespace: defaultNamespace},
+				Spec: clusterv1.MachineSpec{
+					ClusterName: "cluster",
+					Bootstrap:   clusterv1.Bootstrap{DataSecretName: ptr.To("bootstrap-data")},
+				},
+			}
+			service := NewService(&scope.BareMetalMachineScope{
+				Logger: log, Client: c, Machine: machine, BareMetalMachine: bmMachine,
+				HetznerCluster: &infrav1.HetznerCluster{ObjectMeta: metav1.ObjectMeta{Name: "cluster", Namespace: defaultNamespace}},
+			})
+
+			_, _ = service.Reconcile(context.Background())
+
+			updatedHost := &infrav1.HetznerBareMetalHost{}
+			Expect(c.Get(context.Background(), client.ObjectKey{Name: "candidate", Namespace: defaultNamespace}, updatedHost)).To(Succeed())
+			Expect(updatedHost.Spec.ConsumerRef).To(BeNil())
+			Expect(bmMachine.Annotations).NotTo(HaveKey(infrav1.HostAnnotation))
+		},
+		Entry("one WWN with RAID requested", mismatchCase{
+			swraid: 1,
+			hints:  infrav1.RootDeviceHints{Raid: infrav1.Raid{WWN: []string{"raid-disk"}}},
+		}),
+		Entry("two WWNs without RAID requested", mismatchCase{
+			swraid: 0,
+			hints:  infrav1.RootDeviceHints{Raid: infrav1.Raid{WWN: []string{"raid-disk-1", "raid-disk-2"}}},
+		}),
+	)
+
+	DescribeTable("associates a host with disk hints compatible with the requested setting",
+		func(tc mismatchCase) {
+			scheme := runtime.NewScheme()
+			utilruntime.Must(infrav1.AddToScheme(scheme))
+			host := &infrav1.HetznerBareMetalHost{
+				ObjectMeta: metav1.ObjectMeta{Name: "candidate", Namespace: defaultNamespace},
+				Spec: infrav1.HetznerBareMetalHostSpec{
+					RootDeviceHints: &tc.hints,
+					Status:          infrav1.ControllerGeneratedStatus{ProvisioningState: infrav1.StateNone},
+				},
+			}
+			c := fakeclient.NewClientBuilder().WithScheme(scheme).WithObjects(host).Build()
+			bmMachine := &infrav1.HetznerBareMetalMachine{
+				ObjectMeta: metav1.ObjectMeta{Name: "candidate-machine", Namespace: defaultNamespace},
+				Spec: infrav1.HetznerBareMetalMachineSpec{
+					InstallImage: infrav1.InstallImage{Swraid: tc.swraid},
+				},
+			}
+			machine := &clusterv1.Machine{
+				ObjectMeta: metav1.ObjectMeta{Name: "candidate-machine", Namespace: defaultNamespace},
+				Spec: clusterv1.MachineSpec{
+					ClusterName: "cluster",
+					Bootstrap:   clusterv1.Bootstrap{DataSecretName: ptr.To("bootstrap-data")},
+				},
+			}
+			service := NewService(&scope.BareMetalMachineScope{
+				Logger: log, Client: c, Machine: machine, BareMetalMachine: bmMachine,
+				HetznerCluster: &infrav1.HetznerCluster{ObjectMeta: metav1.ObjectMeta{Name: "cluster", Namespace: defaultNamespace}},
+			})
+
+			_, _ = service.Reconcile(context.Background())
+
+			Expect(bmMachine.Annotations).To(HaveKey(infrav1.HostAnnotation))
+		},
+		Entry("two RAID WWNs when RAID is requested", mismatchCase{
+			swraid: 1,
+			hints:  infrav1.RootDeviceHints{Raid: infrav1.Raid{WWN: []string{"raid-disk-1", "raid-disk-2"}}},
+		}),
+		Entry("one non-RAID WWN when RAID is not requested", mismatchCase{
