+    def test_nonword_boundary_language(self):
+        """A language name containing punctuation still yields a code block."""
+
+        html = self.md.convert(
+            "```c++ hl_lines=\"1\"\n#include <iostream>\n```"
+        )
+        parser = CodeBlockParser()
+        parser.feed(html)
+
+        self.assertEqual(len(parser.blocks), 1)
+        self.assertIn('#include <iostream>', parser.blocks[0])
+
+    def test_omitted_language(self):
+        """A fence with an option but no language is recognized as code."""
+
+        text = (
+            '``` hl_lines="1"\n'
+            'test\n'
+            'data\n'
+            '```\n'
+            '\n'
+            'some text\n'
+            '```sql\n'
+            'select * from dual;\n'
+            '```'
+        )
+        html = self.md.convert(text)
+        parser = CodeBlockParser()
+        parser.feed(html)
+
+        self.assertTrue(parser.blocks)
+        self.assertIn('test\ndata', parser.blocks[0])
+        self.assertIn('some text', html)
+        self.assertNotIn('```', html)
+
+    def test_later_sql_fence_after_omitted_language(self):
+        """A language-less fence must not consume the following SQL fence."""
+
+        text = (
+            '``` hl_lines="1"\n'
+            'test\n'
+            'data\n'
+            '```\n'
+            '\n'
+            'some text\n'
+            '```sql\n'
+            'select * from dual;\n'
+            '```'
+        )
+        html = self.md.convert(text)
+        parser = CodeBlockParser()
+        parser.feed(html)
+
+        self.assertEqual(len(parser.blocks), 2)
+        self.assertIn('test\ndata', parser.blocks[0])
+        self.assertIn('select * from dual;', parser.blocks[1])
+
 
