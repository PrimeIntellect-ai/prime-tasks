+func TestFailureOutputThroughSuite(t *testing.T) {
+	if featurePath := os.Getenv("GOBDD_FAILURE_FEATURE"); featurePath != "" {
+		suite := NewSuite(t, NewSuiteOptions().WithFeaturesPath(featurePath))
+		suite.AddStep(`a step that fails`, failure)
+		suite.Run()
+		return
+	}
+
+	featurePath := filepath.Join(t.TempDir(), "failure.feature")
+	feature := "Feature: failure output\n  Scenario: returned error\n    Given a step that fails\n"
+	if err := os.WriteFile(featurePath, []byte(feature), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	cmd := exec.Command(os.Args[0], "-test.v", "-test.run=^TestFailureOutputThroughSuite$")
+	cmd.Env = append(os.Environ(), "GOBDD_FAILURE_FEATURE="+featurePath)
+	output, _ := cmd.CombinedOutput()
+	got := string(output)
+	for _, want := range []string{"Given", "a step that fails", "the step failed"} {
+		if !strings.Contains(got, want) {
+			t.Errorf("failure output %q does not contain %q", got, want)
+		}
+	}
+	if strings.Contains(got, "%!(EXTRA") {
+		t.Errorf("failure output contains malformed formatting: %q", got)
+	}
+}
