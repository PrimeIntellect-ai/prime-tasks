+def get_ip(request: HttpRequest) -> str:
+    return "127.0.0.1"
+
+
+def get_ip_from_request(request: HttpRequest) -> str:
+    return request.META["HTTP_X_RESOLVER_ADDRESS"]
+
+
+class ClientIpAddressTestCase(AxesTestCase):
+    @override_settings(AXES_CLIENT_IP_CALLABLE=get_ip)
+    def test_get_client_ip_address(self):
+        self.assertEqual(get_client_ip_address(HttpRequest()), "127.0.0.1")
+
+    @override_settings(AXES_CLIENT_IP_CALLABLE="tests.test_helpers.get_ip")
+    def test_get_client_ip_address_str(self):
+        self.assertEqual(get_client_ip_address(HttpRequest()), "127.0.0.1")
+
+    @override_settings(AXES_CLIENT_IP_CALLABLE=get_ip_from_request)
+    def test_custom_resolver_receives_incoming_request(self):
+        request = HttpRequest()
+        request.META["HTTP_X_RESOLVER_ADDRESS"] = "198.51.100.24"
+
+        self.assertEqual(get_client_ip_address(request), "198.51.100.24")
+
+    @override_settings(
+        AXES_CLIENT_IP_CALLABLE="tests.test_helpers.get_ip_from_request"
+    )
+    def test_dotted_path_resolver_receives_incoming_request(self):
+        request = HttpRequest()
+        request.META["HTTP_X_RESOLVER_ADDRESS"] = "203.0.113.17"
+
+        self.assertEqual(get_client_ip_address(request), "203.0.113.17")
+
+    @override_settings(
+        AXES_CLIENT_IP_CALLABLE=lambda request: "127.0.0.1"
+    )  # pragma: no cover
+    def test_get_client_ip_address_lambda(self):
+        self.assertEqual(get_client_ip_address(HttpRequest()), "127.0.0.1")
+
+    @override_settings(
+        AXES_CLIENT_IP_CALLABLE=None,
+        AXES_META_PRECEDENCE_ORDER=("HTTP_X_FORWARDED_FOR", "REMOTE_ADDR"),
+    )
+    def test_get_client_ip_address_uses_ipware_without_custom_resolver(self):
+        request = HttpRequest()
+        request.META["REMOTE_ADDR"] = "127.0.0.1"
+        request.META["HTTP_X_FORWARDED_FOR"] = "127.0.0.2"
+
+        self.assertEqual(get_client_ip_address(request), "127.0.0.2")
+
