+package pass
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/mmcloughlin/avo/ir"
+	"github.com/mmcloughlin/avo/operand"
+	"github.com/mmcloughlin/avo/reg"
+)
+
+// TestCompileRejectsInvalidMemOperands verifies that the memory operand
+// validation is applied by the build: compiling a file that contains an
+// instruction with an invalid memory operand must fail.
+func TestCompileRejectsInvalidMemOperands(t *testing.T) {
+	cases := []struct {
+		Name           string
+		Operands       []operand.Op
+		ErrorSubstring string
+	}{
+		{
+			Name: "missing base",
+			Operands: []operand.Op{
+				reg.RAX,
+				operand.Mem{Disp: 42},
+			},
+			ErrorSubstring: "missing base",
+		},
+		{
+			Name: "index register with scale 0",
+			Operands: []operand.Op{
+				operand.Mem{Base: reg.EBX, Index: reg.R9L},
+				reg.ECX,
+			},
+			ErrorSubstring: "index register with scale 0",
+		},
+	}
+	for _, c := range cases {
+		t.Run(c.Name, func(t *testing.T) {
+			f := ir.NewFile()
+			fn := ir.NewFunction("F")
+			fn.AddInstruction(&ir.Instruction{Operands: c.Operands})
+			f.AddSection(fn)
+
+			err := Compile.Execute(f)
+			if err == nil || !strings.Contains(err.Error(), c.ErrorSubstring) {
+				t.Errorf("got error %v; expected error to contain %q", err, c.ErrorSubstring)
+			}
+		})
+	}
+}
