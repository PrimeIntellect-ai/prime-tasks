+    @Test
+    void shouldReachServiceEndpointUsingDiscoveredHost() throws Exception {
+        HttpServer backend = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+        byte[] response = "{\"hero\":{\"name\":\"Real hero\"},\"villain\":{\"name\":\"Real villain\"}}"
+                .getBytes(StandardCharsets.UTF_8);
+        backend.createContext("/api/fights/randomfighters", exchange -> {
+            exchange.sendResponseHeaders(200, response.length);
+            try (var output = exchange.getResponseBody()) {
+                output.write(response);
+            }
+        });
+        backend.start();
+
+        try {
+            String serviceUrl = "http://127.0.0.1:" + backend.getAddress().getPort();
+            TestConfigProvider.addServiceConfig("rest-fights", null, "knative",
+                    null, Map.of("knative-host", k8sMasterUrl, "knative-namespace", "test", "application", "rest-fights"));
+            registerKnativeServices("rest-fights", serviceUrl, null);
+
+            Stork stork = StorkTestUtils.getNewStorkInstance();
+            AtomicReference<List<ServiceInstance>> instances = new AtomicReference<>();
+            stork.getService("rest-fights").getServiceDiscovery().getServiceInstances()
+                    .onFailure().invoke(th -> fail("Failed to get service instances from the cluster", th))
+                    .subscribe().with(instances::set);
+
+            await().atMost(Duration.ofSeconds(5)).until(() -> instances.get() != null);
+            assertThat(instances.get()).hasSize(1);
+
+            URI serviceUri = URI.create(serviceUrl);
+            URL endpoint = new URI(serviceUri.getScheme(), null, instances.get().get(0).getHost(), serviceUri.getPort(),
+                    "/api/fights/randomfighters", null, null).toURL();
+            HttpURLConnection connection = (HttpURLConnection) endpoint.openConnection();
+            try {
+                assertThat(connection.getResponseCode()).isEqualTo(200);
+                try (InputStream body = connection.getInputStream()) {
+                    String result = new String(body.readAllBytes(), StandardCharsets.UTF_8);
+                    assertThat(result).contains("Real hero", "Real villain");
+                }
+            } finally {
+                connection.disconnect();
+            }
+        } finally {
+            backend.stop(0);
+        }
+    }
+
+    @Test
+    void shouldUseOriginalUrlWhenItCannotBeParsed() {
+        TestConfigProvider.addServiceConfig("my-knservice", null, "knative",
+                null, Map.of("knative-host", k8sMasterUrl, "knative-namespace", "test"));
+
+        Stork stork = StorkTestUtils.getNewStorkInstance();
+
+        String knSvcName = "my-knservice";
+        String invalidUrl = "http://hello world";
+
+        registerKnativeServices(knSvcName, invalidUrl, null);
+
+        AtomicReference<List<ServiceInstance>> instances = new AtomicReference<>();
+
+        io.smallrye.stork.api.Service service = stork.getService(knSvcName);
+        service.getServiceDiscovery().getServiceInstances()
+                .onFailure().invoke(th -> fail("Failed to get service instances from the cluster", th))
+                .subscribe().with(instances::set);
+
+        await().atMost(Duration.ofSeconds(5))
+                .until(() -> instances.get() != null);
+
+        assertThat(instances.get()).hasSize(1);
+        assertThat(instances.get().get(0).getHost()).isEqualTo(invalidUrl);
+    }
