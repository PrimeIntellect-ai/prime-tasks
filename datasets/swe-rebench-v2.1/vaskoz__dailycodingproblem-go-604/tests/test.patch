+package day294
+
+import (
+	"reflect"
+	"testing"
+)
+
+type routeEdge struct {
+	from, to, distance int
+}
+
+// makePathDistance expresses the input as directed endpoint pairs while
+// accommodating either a pair-keyed path map or an adjacency map.
+func makePathDistance(edges []routeEdge) PathDistance {
+	pathType := reflect.TypeOf(PathDistance(nil))
+	paths := reflect.MakeMap(pathType)
+	if pathType.Key().Kind() == reflect.Int && pathType.Elem().Kind() == reflect.Map {
+		for _, edge := range edges {
+			from := reflect.ValueOf(edge.from).Convert(pathType.Key())
+			toType := pathType.Elem().Key()
+			distanceType := pathType.Elem().Elem()
+			to := reflect.ValueOf(edge.to).Convert(toType)
+			distance := reflect.ValueOf(edge.distance).Convert(distanceType)
+			adjacency := paths.MapIndex(from)
+			if !adjacency.IsValid() {
+				adjacency = reflect.MakeMap(pathType.Elem())
+			}
+			adjacency.SetMapIndex(to, distance)
+			paths.SetMapIndex(from, adjacency)
+		}
+	} else {
+		for _, edge := range edges {
+			keyType := pathType.Key()
+			key := reflect.New(keyType).Elem()
+			switch keyType.Kind() {
+			case reflect.Array:
+				key.Index(0).Set(reflect.ValueOf(edge.from).Convert(keyType.Elem()))
+				key.Index(1).Set(reflect.ValueOf(edge.to).Convert(keyType.Elem()))
+			case reflect.Struct:
+				key.Field(0).Set(reflect.ValueOf(edge.from).Convert(keyType.Field(0).Type))
+				key.Field(1).Set(reflect.ValueOf(edge.to).Convert(keyType.Field(1).Type))
+			default:
+				panic("PathDistance key must identify a source and destination")
+			}
+			distance := reflect.ValueOf(edge.distance).Convert(pathType.Elem())
+			paths.SetMapIndex(key, distance)
+		}
+	}
+	return paths.Interface().(PathDistance)
+}
+
+var testcases = []struct {
+	elevations    Elevation
+	edges         []routeEdge
+	shortestRoute int
+}{
+	{
+		Elevation{0: 10, 1: 25, 2: 15},
+		[]routeEdge{{0, 1, 15}, {0, 2, 5}, {1, 0, 1}, {2, 1, 7}, {2, 0, 30}},
+		13,
+	},
+	{
+		Elevation{0: 10, 1: 5, 2: 15},
+		[]routeEdge{{0, 1, 5}, {0, 2, 10}, {1, 0, 5}, {2, 0, 10}},
+		20,
+	},
+	{
+		Elevation{0: 5, 1: 25, 2: 15, 3: 20, 4: 10},
+		[]routeEdge{{0, 1, 10}, {0, 2, 8}, {0, 3, 15}, {1, 3, 12}, {2, 4, 10}, {3, 4, 5}, {3, 0, 17}, {4, 0, 10}},
+		28,
+	},
+}
+
+func TestShortestRunnerPath(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		if result, _ := ShortestRunnerPath(tc.elevations, makePathDistance(tc.edges)); result != tc.shortestRoute {
+			t.Errorf("Expected route length %v, got %v", tc.shortestRoute, result)
+		}
+	}
+
+	// The route must not be limited to a fixed small number of edges.
+	elevations := Elevation{0: 0, 1: 2, 2: 4, 3: 6, 4: 4, 5: 2}
+	edges := []routeEdge{{0, 1, 1}, {1, 2, 1}, {2, 3, 1}, {3, 4, 1}, {4, 5, 1}, {5, 0, 1}}
+	if result, _ := ShortestRunnerPath(elevations, makePathDistance(edges)); result != 6 {
+		t.Errorf("Expected six-edge route length 6, got %v", result)
+	}
+}
+
+func BenchmarkShortestRunnerPath(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			ShortestRunnerPath(tc.elevations, makePathDistance(tc.edges)) // nolint
+		}
+	}
+}
