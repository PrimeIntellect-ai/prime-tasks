+
+func TestRepositoryUsesCurrentSemconvVersion(t *testing.T) {
+	// Locate the repository root from this test source, then inspect every Go
+	// import declaration, including modules outside the detector packages.
+	_, source, _, ok := runtime.Caller(0)
+	require.True(t, ok, "could not locate test source")
+	root := filepath.Dir(source)
+	for {
+		if _, err := os.Stat(filepath.Join(root, ".git")); err == nil {
+			break
+		}
+		parent := filepath.Dir(root)
+		require.NotEqual(t, root, parent, "could not locate repository root")
+		root = parent
+	}
+
+	const obsolete = "go.opentelemetry.io/otel/semconv/v1.24.0"
+	err := filepath.WalkDir(root, func(path string, entry os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if entry.IsDir() {
+			if entry.Name() == ".git" || entry.Name() == "vendor" {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if filepath.Ext(path) != ".go" {
+			return nil
+		}
+		file, err := parser.ParseFile(token.NewFileSet(), path, nil, parser.ImportsOnly)
+		if err != nil {
+			return err
+		}
+		for _, spec := range file.Imports {
+			importPath, err := strconv.Unquote(spec.Path.Value)
+			if err != nil {
+				return err
+			}
+			if importPath == obsolete {
+				t.Errorf("%s still imports the obsolete semantic conventions package", path)
+			}
+		}
+		return nil
+	})
+	require.NoError(t, err)
+}
