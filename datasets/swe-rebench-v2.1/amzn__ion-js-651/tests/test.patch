diff --git a/test/IonLocalSymbolTable.ts b/test/IonLocalSymbolTable.ts
index d59c9d2..3289a73 100644
--- a/test/IonLocalSymbolTable.ts
+++ b/test/IonLocalSymbolTable.ts
@@ -151,5 +151,23 @@ describe('Local symbol table', () => {
         // It is, however, a property (an accessor) on the 'Map' data type.
         // Asking for its symbol ID should return undefined.
         assert.isUndefined(symbolTable.getSymbolId("size"));
+        // Same test for 'toString', which isn't a 'Map' property, but exists on JS Objects instantiated with the
+        // `{}` literal instead of `Object.create(null)`.
+        assert.isUndefined(symbolTable.getSymbolId('toString'));
+    });
+
+    // See https://github.com/amzn/ion-js/issues/649
+    it('Symbol tables do not discard duplicate text during instantiation (Issue #649)', () => {
+        const extraSymbols = ["foo", "foo", "bar", "bar"];
+        const symbolTable = new LocalSymbolTable(getSystemSymbolTableImport(), extraSymbols);
+        // The system symbols occupy SIDs 1-9, so each supplied symbol gets its own SID starting at 10,
+        // even when its text duplicates an earlier entry.
+        assertSystemSymbols(symbolTable);
+        assert.equal(symbolTable.maxId, 9 + extraSymbols.length);
+        assert.equal(symbolTable.getSymbolText(10), "foo");
+        assert.equal(symbolTable.getSymbolText(11), "foo");
+        assert.equal(symbolTable.getSymbolText(12), "bar");
+        assert.equal(symbolTable.getSymbolText(13), "bar");
+        assert.throws(() => symbolTable.getSymbolText(14));
     });
 });
