+  @Test
+  fun `nullable member injection is rejected or handles null`() {
+    compile(
+      """
+      package com.squareup.test
+
+      import javax.inject.Inject
+
+      class InjectClass {
+        @Inject
+        var injected: String? = "initial"
+      }
+      """
+    ) {
+      // Some Dagger paths reject this private field. If compilation accepts it, the generated
+      // injection path must still preserve the property's nullable semantics.
+      if (exitCode != OK) return@compile
+
+      val membersInjector = try {
+        injectClass.membersInjector()
+      } catch (_: ClassNotFoundException) {
+        return@compile
+      }
+
+      val constructor = membersInjector.declaredConstructors.single()
+      val constructorArguments = Array(constructor.parameterCount) { Provider<Any?> { null } }
+      val membersInjectorInstance = constructor
+        .newInstance(*constructorArguments) as MembersInjector<Any>
+      val instance = injectClass.createInstance()
+
+      membersInjectorInstance.injectMembers(instance)
+
+      assertThat(instance.getPropertyValue("injected")).isNull()
+    }
+  }
