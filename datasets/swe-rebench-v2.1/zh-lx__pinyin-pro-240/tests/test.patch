   });
+
+  it("[surname]corrects the reported single-character surname", () => {
+    const result = pinyin("曾乐", {
+      mode: "surname",
+      surname: "head",
+      toneType: "none",
+    });
+    expect(result.split(" ")).to.deep.equal(["zeng", "le"]);
+  });
+
+  it("[surname]surname head does not alter the given name", () => {
+    const result = pinyin("令狐乐", { mode: "surname", surname: "head" });
+    expect(result).to.be.equal("líng hú lè");
+  });
 });
