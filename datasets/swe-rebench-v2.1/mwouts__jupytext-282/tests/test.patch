+def test_sync_continues_after_unpaired_notebook(tmpdir, capsys):
+    """An unpaired notebook must not prevent later notebooks from being synced (#281)"""
+    unpaired_ipynb = str(tmpdir.join('unpaired.ipynb'))
+    paired_ipynb = str(tmpdir.join('paired.ipynb'))
+    paired_py = str(tmpdir.join('paired.py'))
+
+    nb = new_notebook(cells=[new_code_cell('1 + 1')])
+    write(nb, unpaired_ipynb)
+
+    nb.metadata.setdefault('jupytext', {})['formats'] = 'py,ipynb'
+    write(nb, paired_ipynb)
+
+    # The unpaired notebook comes first: it must be skipped, and the paired
+    # notebook that follows must still be synced
+    jupytext(['--sync', unpaired_ipynb, paired_ipynb])
+
+    _, err = capsys.readouterr()
+    assert 'is not a paired notebook' in err
+    assert os.path.isfile(paired_py)
+    compare_notebooks(nb, read(paired_py))
+
