+    private static void assertStrictDynamicWarnings(List<Notice> notices, String message, int minimumCount) {
+        int matchingWarnings = 0;
+        for (Notice notice : notices) {
+            if (message.equals(notice.message)) {
+                assertTrue(notice.isWarning());
+                matchingWarnings++;
+            }
+        }
+        assertTrue("expected at least " + minimumCount + " strict-dynamic warnings", matchingWarnings >= minimumCount);
+    }
+
