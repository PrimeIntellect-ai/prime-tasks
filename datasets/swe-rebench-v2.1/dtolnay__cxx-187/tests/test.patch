@@ -286,3 +295,115 @@ fn r_fail_return_primitive() -> Result<usize, Error> {
 fn r_return_r2(n: usize) -> Box<R2> {
     Box::new(R2(n))
 }
+
+#[cfg(test)]
+mod tests {
+    use std::fs;
+    use std::path::{Path, PathBuf};
+    use std::process::Command;
+
+    fn target_dir() -> PathBuf {
+        let mut dir = PathBuf::from(env!("OUT_DIR"));
+        loop {
+            if dir.ends_with("target") {
+                return dir;
+            }
+            if !dir.pop() {
+                panic!("could not locate the cargo target directory");
+            }
+        }
+    }
+
+    // Compile a translation unit that provides a COwnedEnum with the supplied
+    // values. Returns whether the generated file compiles successfully.
+    fn compiles(
+        generated: &Path,
+        target: &Path,
+        repo_root: &Path,
+        values: (u32, u32),
+    ) -> bool {
+        let source = format!(
+            "#define CXX_TEST_SUITE_OWNED_ENUM\n\
+             namespace tests {{\n\
+             enum COwnedEnum {{ CVal1 = {}, CVal2 = {} }};\n\
+             }}\n\
+             #include \"{}\"\n\
+             int main() {{ return 0; }}\n",
+            values.0,
+            values.1,
+            generated.display(),
+        );
+
+        let dir = std::env::temp_dir().join("cxx-test-suite-owned-enum");
+        fs::create_dir_all(&dir).unwrap();
+        let source_path = dir.join(format!("enum-{}-{}.cc", values.0, values.1));
+        fs::write(&source_path, source).unwrap();
+
+        Command::new("c++")
+            .arg("-std=c++11")
+            .arg("-fsyntax-only")
+            .arg("-I")
+            .arg(target.join("cxxbridge"))
+            .arg("-I")
+            .arg(repo_root)
+            .arg(&source_path)
+            .status()
+            .expect("failed to invoke the C++ compiler")
+            .success()
+    }
+
+    // A C++-owned enum is declared in the shared block and as an extern "C"
+    // type. In that case C++ is the source of truth, so the generated bridge
+    // must not redefine the enum but must instead assert that the
+    // discriminants listed in the #[cxx::bridge] agree with the values of the
+    // existing C++ enum. Compiling the generated bridge against an enum whose
+    // values disagree must be rejected; if it compiles, the required static
+    // assertions are missing or ineffective.
+    #[test]
+    fn cxx_owned_enum_discriminants_are_asserted() {
+        let out_dir = PathBuf::from(env!("OUT_DIR"));
+        let target = target_dir();
+        let repo_root = target.parent().unwrap();
+
+        let generated = out_dir.join("tests").join("ffi").join("lib.rs.cc");
+        assert!(generated.exists(), "no generated C++ implementation was found");
+
+        // Vary each bridge discriminant independently so a check for one
+        // variant cannot mask a missing check for the other. The assertions
+        // need to be enforced by generated C++, not in every generated file.
+        for values in [(100, 1), (0, 200)] {
+            assert!(
+                !compiles(&generated, &target, repo_root, values),
+                "generated C++ accepted COwnedEnum values {:?}",
+                values,
+            );
+        }
+    }
+
+    // The matching C++ definition must remain usable when included before the
+    // generated bridge. A duplicate generated enum would make this fail to
+    // compile even though its values agree with the bridge declaration.
+    #[test]
+    fn cxx_owned_enum_uses_existing_cpp_definition() {
+        let out_dir = PathBuf::from(env!("OUT_DIR"));
+        let target = target_dir();
+        let repo_root = target.parent().unwrap();
+        let generated = [
+            out_dir.join("tests").join("ffi").join("lib.rs.h"),
+            out_dir.join("tests").join("ffi").join("lib.rs.cc"),
+        ];
+
+        let mut checked = false;
+        for path in &generated {
+            if !path.exists() {
+                continue;
+            }
+            checked = true;
+            assert!(
+                compiles(path, &target, repo_root, (0, 1)),
+                "generated bridge could not use the matching existing COwnedEnum",
+            );
+        }
+        assert!(checked, "no generated bridge file was found to check");
+    }
+}
