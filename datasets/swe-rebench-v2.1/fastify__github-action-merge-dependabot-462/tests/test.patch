diff --git a/test/action.test.js b/test/action.test.js
index 9cec03b..16b1fe5 100644
--- a/test/action.test.js
+++ b/test/action.test.js
@@ -704,3 +704,53 @@ Tried to do a '${updateTypes.minor}' update but the max allowed is '${updateType
     MERGE_STATUS.skippedBumpHigherThanTarget
   )
 })
+
+tap.test('should forbid when update type is missing', async () => {
+  const PR_NUMBER = Math.random()
+
+  const { action, stubs } = buildStubbedAction({
+    payload: {
+      pull_request: {
+        number: PR_NUMBER,
+        user: { login: BOT_NAME },
+      },
+    },
+    inputs: {
+      PR_NUMBER,
+      target: 'minor',
+    },
+    dependabotMetadata: createDependabotMetadata({
+      updateType: null,
+    }),
+  })
+
+  await action()
+
+  sinon.assert.notCalled(stubs.approveStub)
+  sinon.assert.notCalled(stubs.mergeStub)
+})
+
+tap.test('should forbid when update type is not valid', async () => {
+  const PR_NUMBER = Math.random()
+
+  const { action, stubs } = buildStubbedAction({
+    payload: {
+      pull_request: {
+        number: PR_NUMBER,
+        user: { login: BOT_NAME },
+      },
+    },
+    inputs: {
+      PR_NUMBER,
+      target: 'minor',
+    },
+    dependabotMetadata: createDependabotMetadata({
+      updateType: 'semver:invalid',
+    }),
+  })
+
+  await action()
+
+  sinon.assert.notCalled(stubs.approveStub)
+  sinon.assert.notCalled(stubs.mergeStub)
+})
