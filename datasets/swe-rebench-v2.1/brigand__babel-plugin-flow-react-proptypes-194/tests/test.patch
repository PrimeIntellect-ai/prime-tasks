diff --git a/src/__tests__/class-intersection-type-parameter-test.js b/src/__tests__/class-intersection-type-parameter-test.js
new file mode 100644
index 0000000..386e3eb
--- /dev/null
+++ b/src/__tests__/class-intersection-type-parameter-test.js
@@ -0,0 +1,37 @@
+const babel = require('babel-core');
+const vm = require('vm');
+const content = `
+var React = require('react');
+
+type FooProps = {
+  a_number: number
+}
+
+export default class Foo extends React.Component<FooProps & {
+  b_number: number
+}> {
+}
+`;
+
+it('class-intersection-type-parameter-test', () => {
+  const code = babel.transform(content, {
+    babelrc: false,
+    presets: ['es2015', 'stage-1', 'react'],
+    plugins: ['syntax-flow', require('../')],
+  }).code;
+  const requiredNumberValidator = {};
+  const propTypes = { number: { isRequired: requiredNumberValidator } };
+  const exports = {};
+
+  vm.runInNewContext(code, {
+    exports,
+    require(name) {
+      if (name === 'react') return { Component: function Component() {} };
+      if (name === 'prop-types') return propTypes;
+      throw new Error(`Unexpected module: ${name}`);
+    },
+  });
+
+  expect(exports.default.propTypes.a_number).toBe(requiredNumberValidator);
+  expect(exports.default.propTypes.b_number).toBe(requiredNumberValidator);
+});
