+describe('action api-level flow', () => {
+  it('uses a non-integer api-level when installing the SDK and launching the emulator', async () => {
+    const invocations: Array<{ command: string; args: string[] }> = [];
+    let markDone: () => void = () => undefined;
+    const done = new Promise<void>((resolve) => {
+      markDone = resolve;
+    });
+
+    const inputs: Record<string, string> = {
+      'api-level': 'UpsideDownCake-ext5',
+      target: 'default',
+      arch: 'x86_64',
+      profile: '',
+      cores: '',
+      'ram-size': '',
+      'heap-size': '',
+      'sdcard-path-or-size': '',
+      'disk-size': '',
+      'avd-name': 'test-avd',
+      'force-avd-creation': 'false',
+      'emulator-options': '',
+      'disable-animations': 'false',
+      'disable-spellchecker': 'false',
+      'disable-linux-hw-accel': 'false',
+      'enable-hw-keyboard': 'false',
+      'emulator-build': '',
+      'working-directory': '',
+      ndk: '',
+      cmake: '',
+      channel: 'stable',
+      script: 'echo hello',
+    };
+
+    (core.getInput as jest.Mock).mockImplementation((name: string) => inputs[name] ?? '');
+    (core.setFailed as jest.Mock).mockImplementation(() => markDone());
+    (core.addPath as jest.Mock).mockImplementation(() => undefined);
+    (core.exportVariable as jest.Mock).mockImplementation((name: string, value: string) => {
+      process.env[name] = value;
+    });
+
+    (exec.exec as jest.Mock).mockImplementation(
+      async (command: string, args: string[] = [], options?: { listeners?: { stdout?: (data: Buffer) => void } }) => {
+        invocations.push({ command, args });
+        if (command.includes('getprop sys.boot_completed')) {
+          options?.listeners?.stdout?.(Buffer.from('1'));
+        }
+        if (command.includes('emu kill')) {
+          markDone();
+        }
+        return 0;
+      }
+    );
+
+    const androidHome = fs.mkdtempSync(path.join(os.tmpdir(), 'android-home-'));
+    process.env.ANDROID_HOME = androidHome;
+    process.env.HOME = androidHome;
+    fs.mkdirSync(path.join(androidHome, 'cmdline-tools'), { recursive: true });
+
+    require('../src/main');
+    await done;
+
+    const packageId = 'system-images;android-UpsideDownCake-ext5;default;x86_64';
+    const calls = invocations.map(({ command, args }) => `${command} ${args.join(' ')}`);
+    expect(calls.some((call) => call.includes('sdkmanager') && call.includes(packageId))).toBe(true);
+    expect(calls.some((call) => call.includes('avdmanager') && call.includes(packageId))).toBe(true);
+    expect(calls.some((call) => call.includes('NaN'))).toBe(false);
+  });
+});
