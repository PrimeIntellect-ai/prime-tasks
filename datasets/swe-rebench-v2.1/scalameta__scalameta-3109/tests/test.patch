     }
   )
+
+  targeted(
+    """package example
+      |class ForComprehension {
+      |  val <<x>>: Option[(Int, Int)] = None
+      |  for {
+      |    (_, _) <- <<x>>
+      |  } yield ()
+      |}
+    """.stripMargin,
+    (_, declaration, generator) => {
+      assertEquals(declaration, "example/ForComprehension#x.")
+      assertEquals(generator, "example/ForComprehension#x.")
+    }
+  )
+
+  targeted(
+    """
+    package n
+      | object ForCompWithFilter {
+      |  val foo: Option[(Int, Int)] = None
+      |  for {
+      |    (_, _) <- <<foo>>
+      |    (_, _) <- <<foo>>
+      |  } yield ()
+      |}
+    """.stripMargin,
+    (_, foo1, foo2) => {
+      assertEquals(foo1, "n/ForCompWithFilter.foo.")
+      assertEquals(foo2, "n/ForCompWithFilter.foo.")
+    }
+  )
+
+  targeted(
+    """
+    package o
+      | object ForCompWithExtractor {
+      |  case class Foo()
+      |  val foo: Option[Foo] = None
+      |  for {
+      |    Foo() <- <<foo>>
+      |  } yield ()
+      |}
+    """.stripMargin,
+    (_, foo) => {
+      assertEquals(foo, "o/ForCompWithExtractor.foo.")
+    }
+  )
 }
