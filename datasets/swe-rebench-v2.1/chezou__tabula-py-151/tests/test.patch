 import unittest
+import threading
+from http.server import BaseHTTPRequestHandler, HTTPServer
+import os
 import tabula
 
 
+
 class TestUtil(unittest.TestCase):
     def test_environment_info(self):
         self.assertEqual(tabula.environment_info(), None)
 
+    def test_localize_file_sends_custom_user_agent(self):
+        received_headers = []
+
+        class Handler(BaseHTTPRequestHandler):
+            def do_GET(self):
+                received_headers.append(self.headers.get('User-Agent'))
+                body = b'contents'
+                self.send_response(200)
+                self.send_header('Content-Length', str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+            def log_message(self, format, *args):
+                pass
+
+        server = HTTPServer(('127.0.0.1', 0), Handler)
+        thread = threading.Thread(target=server.serve_forever)
+        thread.daemon = True
+        thread.start()
+        local_path = None
+        try:
+            uri = 'http://127.0.0.1:{0}/download.pdf'.format(server.server_port)
+            user_agent = 'Mozilla/5.0'
+            local_path, temporary = tabula.file_util.localize_file(uri, user_agent=user_agent)
+            self.assertIn(user_agent, received_headers)
+        finally:
+            server.shutdown()
+            server.server_close()
+            thread.join()
+            if local_path and os.path.exists(local_path):
+                os.remove(local_path)
+
+
 
 if __name__ == '__main__':
     unittest.main()
