+def test_graceful_start_permission_exception(mocker, monkeypatch, tmp_path):
+    """Show a subprocess startup error and avoid recording a failed process."""
+
+    pid_file = tmp_path / "ui.pid"
+    monkeypatch.setattr("covalent_dispatcher._cli.service.UI_PIDFILE", str(pid_file))
+    monkeypatch.setattr("covalent_dispatcher._cli.service.UI_LOGFILE", str(tmp_path / "ui.log"))
+    monkeypatch.setattr("covalent_dispatcher._cli.service.UI_SRVDIR", str(tmp_path))
+    mocker.patch("covalent_dispatcher._cli.service.psutil.pid_exists", return_value=False)
+    mocker.patch("covalent_dispatcher._cli.service._next_available_port", return_value=42)
+    mocker.patch(
+        "covalent_dispatcher._cli.service.Popen",
+        side_effect=PermissionError("Permission denied"),
+    )
+    db_mock = Mock()
+    db_mock.current_revision.return_value = "revision"
+    db_mock.is_migration_pending = False
+    mocker.patch.object(DataStore, "factory", return_value=db_mock)
+    mocker.patch("covalent_dispatcher._cli.service.set_config")
+
+    # Older Click releases do not recognize the application's lightgrey name.
+    # Preserve the rendered error text while substituting a supported color.
+    original_secho = click.secho
+
+    def compatible_secho(*args, **kwargs):
+        if kwargs.get("fg") == "lightgrey":
+            kwargs["fg"] = "white"
+        return original_secho(*args, **kwargs)
+
+    monkeypatch.setattr("covalent_dispatcher._cli.service.click.secho", compatible_secho)
+    result = CliRunner().invoke(start, "--port 42 --no-cluster")
+
+    assert "Permission denied" in result.output, repr(result.exception)
+    assert not pid_file.exists()
