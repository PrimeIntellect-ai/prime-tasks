+    def test_compute_totals_discrete_variable_cost(self):
+        class DiscreteOutputComp(om.ExplicitComponent):
+            def initialize(self):
+                self.options.declare('num_outputs', types=int)
+
+            def setup(self):
+                for i in range(self.options['num_outputs']):
+                    self.add_discrete_output(f'value{i}', 1)
+
+            def compute(self, inputs, outputs, discrete_inputs, discrete_outputs):
+                pass
+
+        def make_problem(with_discrete_outputs):
+            prob = om.Problem()
+            model = prob.model
+            indeps = model.add_subsystem('indeps', om.IndepVarComp())
+            for i in range(300):
+                indeps.add_output(f'x{i}', 1.0)
+                model.add_subsystem(f'calc{i}', om.ExecComp(f'y{i} = 2.0 * x{i}'))
+                model.connect(f'indeps.x{i}', f'calc{i}.x{i}')
+                model.add_design_var(f'indeps.x{i}')
+                model.add_objective(f'calc{i}.y{i}')
+            if with_discrete_outputs:
+                model.add_subsystem('discrete', DiscreteOutputComp(num_outputs=10000))
+            prob.setup()
+            prob.run_model()
+            return prob
+
+        reference = make_problem(False)
+        discrete_heavy = make_problem(True)
+
+        start = time.perf_counter()
+        reference.compute_totals()
+        reference_time = time.perf_counter() - start
+
+        start = time.perf_counter()
+        discrete_heavy.compute_totals()
+        discrete_time = time.perf_counter() - start
+
+        self.assertLess(discrete_time, reference_time * 6.0 + 0.2)
+
