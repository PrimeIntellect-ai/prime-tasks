+
+  eq(S.when(gte0, Math.sqrt, 16), 4);
+  eq(S.when(gte0, Math.sqrt, -1), -1);
+
+  eq(S.when(gte0)(Math.sqrt)(16), 4);
+  eq(S.when(gte0, Math.sqrt)(-1), -1);
+
+});
