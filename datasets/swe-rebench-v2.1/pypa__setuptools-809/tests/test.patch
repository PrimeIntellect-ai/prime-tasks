+    def test_include_subpackage_without_parent(self):
+        """
+        ``include`` may select a subpackage and its descendants without
+        selecting the top-level parent package.
+        """
+        self._touch('__init__.py', self.pkg_dir)
+        self._touch('__init__.py', self.sub_pkg_dir)
+        nested_dir = self._mkdir('nested', self.sub_pkg_dir)
+        self._touch('__init__.py', nested_dir)
+        packages = find_packages(
+            self.dist_dir, include=['pkg.subpkg', 'pkg.subpkg.*'])
+        assert set(packages) == {'pkg.subpkg', 'pkg.subpkg.nested'}
+        assert 'pkg' not in packages
