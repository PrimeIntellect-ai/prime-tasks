+// TestMarshalBuiltinBignumTagPreservesByteStringContent checks that encoder options
+// do not change the byte-string content of built-in bignum tags.
+func TestMarshalBuiltinBignumTagPreservesByteStringContent(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		tag  Tag
+		opts EncOptions
+	}{
+		{
+			name: "unsigned bignum with expected base16 encoding",
+			tag:  Tag{Number: tagNumUnsignedBignum, Content: []byte{0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}},
+			opts: EncOptions{ByteSlice: ByteSliceExpectedEncodingBase16},
+		},
+		{
+			name: "unsigned bignum with base64url conversion",
+			tag:  Tag{Number: tagNumUnsignedBignum, Content: []byte{0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}},
+			opts: EncOptions{ByteSlice: ByteSliceToByteStringWithExpectedConversionToBase64URL},
+		},
+		{
+			name: "unsigned bignum with base64 conversion",
+			tag:  Tag{Number: tagNumUnsignedBignum, Content: []byte{0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}},
+			opts: EncOptions{ByteSlice: ByteSliceToByteStringWithExpectedConversionToBase64},
+		},
+		{
+			name: "negative bignum with expected base16 encoding",
+			tag:  Tag{Number: tagNumNegativeBignum, Content: []byte{0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}},
+			opts: EncOptions{ByteSlice: ByteSliceExpectedEncodingBase16},
+		},
+		{
+			name: "negative bignum with base64url conversion",
+			tag:  Tag{Number: tagNumNegativeBignum, Content: []byte{0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}},
+			opts: EncOptions{ByteSlice: ByteSliceToByteStringWithExpectedConversionToBase64URL},
+		},
+		{
+			name: "negative bignum with base64 conversion",
+			tag:  Tag{Number: tagNumNegativeBignum, Content: []byte{0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}},
+			opts: EncOptions{ByteSlice: ByteSliceToByteStringWithExpectedConversionToBase64},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			em, err := tc.opts.EncMode()
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			got, err := em.Marshal(tc.tag)
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			var decoded Tag
+			if err := Unmarshal(got, &decoded); err != nil {
+				t.Fatalf("encoded tag is not valid CBOR: %v", err)
+			}
+			if decoded.Number != tc.tag.Number {
+				t.Errorf("decoded tag number = %d, want %d", decoded.Number, tc.tag.Number)
+			}
+			content, ok := decoded.Content.([]byte)
+			if !ok {
+				t.Fatalf("decoded tag content has type %T, want byte string", decoded.Content)
+			}
+			if !bytes.Equal(content, tc.tag.Content.([]byte)) {
+				t.Errorf("decoded tag content = %x, want %x", content, tc.tag.Content)
+			}
+		})
+	}
+}
