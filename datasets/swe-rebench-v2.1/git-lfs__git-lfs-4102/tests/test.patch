+func TestRevListScannerSkipsMissingRemoteRefObjects(t *testing.T) {
+	repoDir, err := ioutil.TempDir("", "git-lfs-missing-remote-ref-")
+	if !assert.NoError(t, err) {
+		return
+	}
+	defer os.RemoveAll(repoDir)
+
+	cmd := exec.Command("git", "init", "--quiet", repoDir)
+	if !assert.NoError(t, cmd.Run()) {
+		return
+	}
+
+	remoteRefs := filepath.Join(repoDir, ".git", "refs", "remotes", "origin")
+	if !assert.NoError(t, os.MkdirAll(remoteRefs, 0755)) {
+		return
+	}
+	missingOID := "1111111111111111111111111111111111111111"
+	if !assert.NoError(t, ioutil.WriteFile(filepath.Join(remoteRefs, "branch"), []byte(missingOID+"\n"), 0644)) {
+		return
+	}
+
+	scanner, err := NewRevListScanner(nil, nil, &ScanRefsOptions{
+		Mode:        ScanRangeToRemoteMode,
+		Remote:      "origin",
+		SkippedRefs: []string{},
+		WorkingDir:  repoDir,
+	})
+	if !assert.NoError(t, err) {
+		return
+	}
+
+	assert.False(t, scanner.Scan(), "the dangling remote ref should not produce a scanned object")
+	assert.NoError(t, scanner.Err())
+	assert.NoError(t, scanner.Close())
+}
+
+func TestRevListScannerProcessesValidObjectsAlongsideMissingRemoteRef(t *testing.T) {
+	repoDir, err := ioutil.TempDir("", "git-lfs-mixed-remote-refs-")
+	if !assert.NoError(t, err) {
+		return
+	}
+	defer os.RemoveAll(repoDir)
+
+	runGit := func(args ...string) ([]byte, error) {
+		fullArgs := append([]string{"-C", repoDir}, args...)
+		return exec.Command("git", fullArgs...).CombinedOutput()
+	}
+	if output, err := runGit("init", "--quiet"); !assert.NoError(t, err, string(output)) {
+		return
+	}
+	for _, args := range [][]string{
+		{"config", "user.name", "Scanner Test"},
+		{"config", "user.email", "scanner@example.com"},
+	} {
+		if output, err := runGit(args...); !assert.NoError(t, err, string(output)) {
+			return
+		}
+	}
+	if !assert.NoError(t, ioutil.WriteFile(filepath.Join(repoDir, "tracked.txt"), []byte("valid local object\n"), 0644)) {
+		return
+	}
+	if output, err := runGit("add", "tracked.txt"); !assert.NoError(t, err, string(output)) {
+		return
+	}
+	if output, err := runGit("commit", "--quiet", "-m", "local commit"); !assert.NoError(t, err, string(output)) {
+		return
+	}
+	output, err := runGit("rev-parse", "HEAD")
+	if !assert.NoError(t, err, string(output)) {
+		return
+	}
+	validOID := strings.TrimSpace(string(output))
+
+	remoteRefs := filepath.Join(repoDir, ".git", "refs", "remotes", "origin")
+	if !assert.NoError(t, os.MkdirAll(remoteRefs, 0755)) {
+		return
+	}
+	missingOID := "1111111111111111111111111111111111111111"
+	if !assert.NoError(t, ioutil.WriteFile(filepath.Join(remoteRefs, "branch"), []byte(missingOID+"\n"), 0644)) {
+		return
+	}
+
+	scanner, err := NewRevListScanner([]string{"HEAD"}, nil, &ScanRefsOptions{
+		Mode:        ScanRangeToRemoteMode,
+		Remote:      "origin",
+		SkippedRefs: []string{},
+		WorkingDir:  repoDir,
+	})
+	if !assert.NoError(t, err) {
+		return
+	}
+	defer scanner.Close()
+
+	foundValidCommit := false
+	for scanner.Scan() {
+		if fmt.Sprintf("%x", scanner.OID()) == validOID {
+			foundValidCommit = true
+		}
+	}
+	assert.NoError(t, scanner.Err())
+	assert.True(t, foundValidCommit, "the valid local commit should still be scanned")
+	assert.NoError(t, scanner.Close())
+}
