@@ -0,0 +1,55 @@
+{
+  "openapi": "3.0.1",
+  "info": {
+    "title": "My API",
+    "version": "1"
+  },
+  "paths": {
+    "/project/{projectKey}": {
+      "get": {
+        "summary": "Get specific values from a configuration for a specific project",
+        "operationId": "getProjectConfiguration",
+        "parameters": [
+          {
+            "name": "projectKey",
+            "in": "path",
+            "description": "Project ID",
+            "required": true,
+            "schema": {
+              "type": "string",
+              "format": "string"
+            }
+          },
+          {
+            "name": "key",
+            "in": "query",
+            "description": "Obtains values corresponding to these keys from a project's configuration",
+            "schema": {
+              "type": "string",
+              "format": "string"
+            }
+          }
+        ],
+        "responses": {
+          "200": {
+            "description": "Configuration for the specified project",
+            "content": {
+              "application/json": {
+                "schema": {
+                  "type": "string",
+                  "format": "string"
+                }
+              }
+            }
+          },
+          "403": {
+            "description": "Refusing access to requested resource, perhaps due to insufficient privilege"
+          },
+          "404": {
+            "description": "Requested resource was not found"
+          }
+        }
+      }
+    }
+  }
+}
diff --git a/core/test/martian/openapi_test.cljc b/core/test/martian/openapi_test.cljc
index e0a77b0..051a32b 100644
--- a/core/test/martian/openapi_test.cljc
+++ b/core/test/martian/openapi_test.cljc
@@ -60,3 +60,33 @@
                (->> (filter #(= (:route-name %) :update-pet)))
                first
                (select-keys [:consumes :produces]))))))
+
+(deftest openapi-parameters-test
+  (testing "parses parameters"
+    (let [handler (-> (parse-string (slurp (io/resource "openapi2.json")))
+                      (openapi->handlers {:encodes ["application/json" "application/octet-stream"]
+                                          :decodes ["application/json" "application/octet-stream"]})
+                      (->> (filter #(= (:route-name %) :get-project-configuration)))
+                      first)]
+      (is (some? handler) "a handler is produced for the operation")
+      (is (= :get (:method handler)))
+      (is (= ["/project/" :projectKey] (:path-parts handler)))
+      (is (= "Get specific values from a configuration for a specific project"
+             (:summary handler)))
+      (testing "path and query parameters are extracted into schemas"
+        (is (= {:projectKey s/Str} (:path-schema handler)))
+        (is (= {(s/optional-key :key) s/Str} (:query-schema handler))))
+      (testing "no form or header parameters"
+        (is (= {} (:form-schema handler)))
+        (is (= {} (:headers-schema handler)))
+        (is (nil? (:body-schema handler))))
+      (testing "produces the response media type"
+        (is (contains? (set (:produces handler)) "application/json")))
+      (testing "consumes no media types when there is no request body"
+        (is (empty? (remove nil? (:consumes handler)))))
+      (testing "response schemas are extracted for each response"
+        (is (= #{{:status (s/eq 200) :body s/Str}
+                 {:status (s/eq 403) :body nil}
+                 {:status (s/eq 404) :body nil}}
+               (set (:response-schemas handler))))))))
+
