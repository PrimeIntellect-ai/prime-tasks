+describe('connection status', () => {
+  const app: any = { context: {} };
+  const games = [ProcessGameConfig({ seed: 0 })];
+  let clientInfo;
+  let roomInfo;
+  let io;
+
+  const onConnectionChangeCalls = () => {
+    const calls = [];
+    mockInstances.forEach(m => {
+      m.onConnectionChange.mock.calls.forEach(c => calls.push(c));
+    });
+    return calls;
+  };
+
+  beforeEach(() => {
+    mockInstances.length = 0;
+    clientInfo = new Map();
+    roomInfo = new Map();
+    const transport = new SocketIOTestAdapter({ clientInfo, roomInfo });
+    transport.init(app, games);
+    io = app.context.io;
+  });
+
+  test('notifies the master when a player connects', async () => {
+    io.socket.id = '0';
+    await io.socket.receive('sync', 'matchID', '0', 2);
+
+    expect(onConnectionChangeCalls()).toContainEqual(['matchID', '0', true]);
+  });
+
+  test('notifies the master when a player disconnects', async () => {
+    io.socket.id = '0';
+    await io.socket.receive('sync', 'matchID', '0', 2);
+
+    await io.socket.receive('disconnect');
+
+    expect(onConnectionChangeCalls()).toContainEqual(['matchID', '0', false]);
+  });
+});
