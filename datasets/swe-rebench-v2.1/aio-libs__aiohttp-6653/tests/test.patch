+async def test_https_connect_fingerprint_mismatch(
+    aiohttp_server, ssl_ctx, tls_certificate_fingerprint_sha256
+) -> None:
+    async def handler(request):
+        return aiohttp.web.Response(text="OK")
+
+    app = aiohttp.web.Application()
+    app.router.add_get("/", handler)
+    server = await aiohttp_server(app, ssl=ssl_ctx)
+    url = server.make_url("/")
+    good_fingerprint = tls_certificate_fingerprint_sha256
+    bad_fingerprint = bytes([good_fingerprint[0] ^ 0xFF]) + good_fingerprint[1:]
+
+    async with aiohttp.ClientSession(
+        connector=aiohttp.TCPConnector(ssl=aiohttp.Fingerprint(good_fingerprint))
+    ) as session:
+        async with session.get(url) as response:
+            assert response.status == 200
+    async with aiohttp.ClientSession(
+        connector=aiohttp.TCPConnector(ssl=aiohttp.Fingerprint(bad_fingerprint))
+    ) as session:
+        with pytest.raises(aiohttp.ServerFingerprintMismatch):
+            await session.get(url)
+
+    with proxy.Proxy(
+        input_args=[
+            "--threadless" if os.name != "nt" else "--threaded",
+            "--num-workers",
+            "1",
+            "--hostname",
+            "127.0.0.1",
+            "--port",
+            "0",
+        ]
+    ) as proxy_instance:
+        proxy_url = URL.build(
+            scheme="http",
+            host=str(proxy_instance.flags.hostname),
+            port=proxy_instance.flags.port,
+        )
+        async with aiohttp.ClientSession(
+            connector=aiohttp.TCPConnector(ssl=aiohttp.Fingerprint(good_fingerprint))
+        ) as session:
+            async with session.get(url, proxy=proxy_url) as response:
+                assert response.status == 200
+        async with aiohttp.ClientSession(
+            connector=aiohttp.TCPConnector(ssl=aiohttp.Fingerprint(bad_fingerprint))
+        ) as session:
+            with pytest.raises(aiohttp.ServerFingerprintMismatch):
+                await session.get(url, proxy=proxy_url)
