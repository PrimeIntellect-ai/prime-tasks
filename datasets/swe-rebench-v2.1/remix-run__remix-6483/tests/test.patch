+  describe("the dev server", () => {
+    it("is reachable over HTTPS when TLS is configured in remix.config.js", async () => {
+      let projectDir = path.join(TEMP_DIR, "tls-app");
+      await fse.ensureDir(path.join(projectDir, "app"));
+      await fse.copy(
+        path.join(__dirname, "fixtures", "stack", "app"),
+        path.join(projectDir, "app")
+      );
+      await fse.writeFile(
+        path.join(projectDir, "package.json"),
+        JSON.stringify({ name: "tls-app", private: true })
+      );
+      await fse.symlink(
+        path.resolve(__dirname, "../../../node_modules"),
+        path.join(projectDir, "node_modules"),
+        "dir"
+      );
+      childProcess.execSync(
+        `openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 1 -nodes -subj "/CN=localhost"`,
+        { cwd: projectDir, stdio: "ignore" }
+      );
+
+      let port = await getPort();
+      await fse.writeFile(
+        path.join(projectDir, "remix.config.js"),
+        `module.exports = { future: { unstable_dev: { port: ${port}, tlsKey: "key.pem", tlsCert: "cert.pem" } } };`
+      );
+
+      let proc = childProcess.spawn(
+        "node",
+        [
+          "--require",
+          require.resolve("esbuild-register"),
+          path.resolve(__dirname, "../cli.ts"),
+          "dev",
+          "-c",
+          "node -e 'setTimeout(()=>{},100000)'",
+        ],
+        {
+          cwd: projectDir,
+          env: { ...process.env, NO_COLOR: "1" },
+          detached: process.platform !== "win32",
+        }
+      );
+
+      try {
+        let output = "";
+        proc.stdout.on("data", (chunk) => {
+          output += String(chunk);
+        });
+        proc.stderr.on("data", (chunk) => {
+          output += String(chunk);
+        });
+
+        let start = Date.now();
+        let isListening = false;
+        while (!isListening && Date.now() - start < 30_000) {
+          isListening = await new Promise<boolean>((resolve) => {
+            let socket = net.connect(port, "localhost");
+            socket.once("connect", () => {
+              socket.destroy();
+              resolve(true);
+            });
+            socket.once("error", () => resolve(false));
+          });
+          if (!isListening) {
+            await new Promise((resolve) => setTimeout(resolve, 200));
+          }
+        }
+        if (!isListening) {
+          throw new Error(`Dev server did not start listening.\n${output}`);
+        }
+
+        let response = await new Promise<{ status?: number; error?: Error }>(
+          (resolve) => {
+            let req = https.get(
+              {
+                host: "localhost",
+                port,
+                path: "/",
+                rejectUnauthorized: false,
+              },
+              (res) => resolve({ status: res.statusCode })
+            );
+            req.on("error", (error) => resolve({ error }));
+            req.setTimeout(5_000, () => {
+              req.destroy();
+              resolve({ error: new Error("timed out") });
+            });
+          }
+        );
+
+        expect(response.error).toBeUndefined();
+        expect(typeof response.status).toBe("number");
+      } finally {
+        if (process.platform === "win32") {
+          proc.kill("SIGKILL");
+        } else if (proc.pid) {
+          try {
+            process.kill(-proc.pid, "SIGKILL");
+          } catch {}
+        }
+      }
+    }, 90_000);
+  });
