+    def test_subgraph_relabeling(self):
+        Z12 = dnx.zephyr_graph(12)
+        nodelist = sorted(Z12.nodes)
+        edgelist = sorted(sorted(edge) for edge in Z12.edges)
+
+        child = dimod.StructureComposite(dimod.NullSampler(), nodelist, edgelist)
+
+        # source bqm on shifted nodes
+        bqm = dimod.BQM({n+1: 1 for n in nodelist}, {(u+1, v+1): 1 for u, v in edgelist}, 'SPIN')
+
+        # 1-1 mapping
+        embedding = {n+1: (n, ) for n in nodelist}
+
+        sampler = FixedEmbeddingComposite(child, embedding)
+        ss = sampler.sample(bqm)
+
+        self.assertEqual(set(ss.variables), bqm.variables)
+
+    def test_subgraph_skips_embedded_bqm_generation(self):
+        class BQMWithoutEmpty(dimod.BinaryQuadraticModel):
+            def empty(self, *args, **kwargs):
+                raise AssertionError("one-to-one embedding should not generate an embedded BQM")
+
+        bqm = BQMWithoutEmpty({'source': 1}, {}, dimod.SPIN)
+        child = dimod.StructureComposite(dimod.ExactSolver(), [0], [])
+        sampler = FixedEmbeddingComposite(child, {'source': [0]})
+
+        sampleset = sampler.sample(bqm, chain_strength=1)
+
+        self.assertEqual(set(sampleset.variables), {'source'})
+
+    def test_subgraph_skips_chain_strength_calculation(self):
+        bqm = dimod.BQM({'source': 1}, {}, dimod.SPIN)
+        child = dimod.StructureComposite(dimod.ExactSolver(), [0], [])
+        sampler = FixedEmbeddingComposite(child, {'source': [0]})
+
+        def forbidden_chain_strength(*args, **kwargs):
+            raise AssertionError("chain strength should not be calculated for a one-to-one embedding")
+
+        sampleset = sampler.sample(bqm, chain_strength=forbidden_chain_strength)
+
+        self.assertEqual(set(sampleset.variables), {'source'})
+
+    def test_subgraph_skips_chain_break_resolution(self):
+        bqm = dimod.BQM({'source': 1}, {}, dimod.SPIN)
+        child = dimod.StructureComposite(dimod.ExactSolver(), [0], [])
+        sampler = FixedEmbeddingComposite(child, {'source': [0]})
+
+        def forbidden_chain_break_resolution(*args, **kwargs):
+            raise AssertionError("chain breaks should not be resolved for a one-to-one embedding")
+
+        sampleset = sampler.sample(bqm, chain_break_method=forbidden_chain_break_resolution)
+
+        self.assertEqual(set(sampleset.variables), {'source'})
+
 
