+func TestShowDatabases(t *testing.T) {
+	require := require.New(t)
+	e := newEngine(t)
+
+	for _, name := range []string{"zdb", "adb", "mdb"} {
+		e.AddDatabase(mem.NewDatabase(name))
+	}
+
+	schema, iter, err := e.Query(newCtx(), "SHOW DATABASES")
+	require.NoError(err)
+
+	rows, err := sql.RowIterToRows(iter)
+	require.NoError(err)
+
+	require.Equal([]sql.Row{
+		{"adb"},
+		{"mdb"},
+		{"mydb"},
+		{"zdb"},
+	}, rows)
+
+	require.Len(schema, 1)
+	require.Equal("database", schema[0].Name)
+	require.Equal(sql.Text, schema[0].Type)
+}
