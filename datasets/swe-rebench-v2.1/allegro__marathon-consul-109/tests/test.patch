 package consul
 
 import (
+	"encoding/json"
 	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptest"
 	"testing"
 	"time"
 
@@ -484,6 +488,46 @@ func TestDeregisterServices_shouldReturnErrorOnFailure(t *testing.T) {
 	assert.Error(t, err)
 }
 
+func TestRegisterServiceChecksHonourStaticPortsOfHealthChecks(t *testing.T) {
+	t.Parallel()
+
+	var registered consulapi.AgentServiceRegistration
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		assert.NoError(t, json.NewDecoder(r.Body).Decode(&registered))
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	host, port, err := net.SplitHostPort(server.Listener.Addr().String())
+	assert.NoError(t, err)
+	consul := New(ConsulConfig{Port: port, Timeout: time.Second})
+	app, err := apps.ParseApp([]byte(`{"app":{"id":"/static-port-app","labels":{"consul":"true"},"healthChecks":[{"path":"/health","protocol":"HTTP","port":8123,"intervalSeconds":60,"timeoutSeconds":20},{"path":"/secure","protocol":"HTTPS","port":8125,"intervalSeconds":60,"timeoutSeconds":20},{"protocol":"TCP","port":8124,"intervalSeconds":60,"timeoutSeconds":20}]}}`))
+	assert.NoError(t, err)
+
+	task := &apps.Task{
+		ID:    "static-port-task",
+		AppID: app.ID,
+		Host:  host,
+		Ports: []int{8090},
+	}
+	assert.NoError(t, consul.Register(task, app))
+	assert.Contains(t, registered.Checks, &consulapi.AgentServiceCheck{
+		HTTP:     "http://" + host + ":8123/health",
+		Interval: "60s",
+		Timeout:  "20s",
+	})
+	assert.Contains(t, registered.Checks, &consulapi.AgentServiceCheck{
+		HTTP:     "https://" + host + ":8125/secure",
+		Interval: "60s",
+		Timeout:  "20s",
+	})
+	assert.Contains(t, registered.Checks, &consulapi.AgentServiceCheck{
+		TCP:      host + ":8124",
+		Interval: "60s",
+		Timeout:  "20s",
+	})
+}
+
