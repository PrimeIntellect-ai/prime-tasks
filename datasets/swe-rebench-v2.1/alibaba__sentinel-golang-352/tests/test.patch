+
+func TestGopsutilDependencyUsesV3ModulePath(t *testing.T) {
+	output, err := exec.Command("go", "mod", "edit", "-json").Output()
+	if !assert.NoError(t, err) {
+		return
+	}
+	var module struct {
+		Require []struct {
+			Path string
+		} `json:"Require"`
+	}
+	if !assert.NoError(t, json.Unmarshal(output, &module)) {
+		return
+	}
+
+	hasV3, hasLegacy := false, false
+	for _, requirement := range module.Require {
+		switch requirement.Path {
+		case "github.com/shirou/gopsutil/v3":
+			hasV3 = true
+		case "github.com/shirou/gopsutil":
+			hasLegacy = true
+		}
+	}
+	assert.True(t, hasV3, "gopsutil v3 must be a direct module requirement")
+	assert.False(t, hasLegacy, "the pre-v3 gopsutil module path must not remain a direct requirement")
+}
