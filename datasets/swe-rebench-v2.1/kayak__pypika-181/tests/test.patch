+    def test_select_correlated_subquery(self):
+        outer = Table('table_a', alias='a')
+        inner = Table('table_b', alias='b')
+        outer_id_table_b = outer.id_table_b.for_(None)
+
+        subquery = Query.from_(inner).select(inner.name).where(inner.id == outer_id_table_b)
+        query = Query.from_(outer).select(outer.id, outer.name, subquery)
+
+        self.assertIn('WHERE "b"."id"="id_table_b"', str(query))
+
+    def test_select_correlated_subquery_with_qualified_outer_field(self):
+        outer = Table('table_a')
+        inner = Table('table_b')
+
+        subquery = Query.from_(inner).select(inner.name).where(inner.id == F('table_a.id_table_b'))
+        query = Query.from_(outer).select(outer.id, outer.name, subquery)
+
+        self.assertIn('(SELECT name FROM table_b WHERE id=table_a.id_table_b)',
+                      query.get_sql(quote_char=None))
+
+    def test_select_subquery_with_quote_char(self):
