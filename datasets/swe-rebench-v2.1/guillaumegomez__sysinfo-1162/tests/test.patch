+
+// Ensure that `root` exposes its information as an optional path.
+#[test]
+fn test_process_root_is_optional() {
+    if !sysinfo::IS_SUPPORTED || cfg!(feature = "apple-sandbox") {
+        return;
+    }
+    let mut s = System::new();
+    let pid = Pid::from_u32(std::process::id());
+    s.refresh_process_specifics(
+        pid,
+        ProcessRefreshKind::new().with_root(UpdateKind::Always),
+    );
+    let p = s.process(pid).expect("current process not found");
+
+    // The root directory may legitimately be unavailable on some platforms, but its
+    // value is represented as an option. On Linux, refreshing the current process
+    // provides its root path, which must remain present for callers.
+    let root: Option<&std::path::Path> = p.root();
+    #[cfg(target_os = "linux")]
+    assert!(root.is_some(), "the current process root should be available");
 }
