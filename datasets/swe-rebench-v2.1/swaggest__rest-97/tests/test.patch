+func TestWrapper_Use_security(t *testing.T) {
+	apiSchema := &openapi.Collector{}
+
+	r := chirouter.NewWrapper(chi.NewRouter())
+	r.Wrap(nethttp.OpenAPIMiddleware(apiSchema))
+
+	sessionMiddleware := func(handler http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+			handler.ServeHTTP(w, req)
+		})
+	}
+
+	securityDoc := nethttp.SecurityMiddleware(apiSchema, "User", openapi3.SecurityScheme{
+		APIKeySecurityScheme: &openapi3.APIKeySecurityScheme{
+			In:   "cookie",
+			Name: "sessid",
+		},
+	})
+
+	u := usecase.NewIOI(nil, nil, func(ctx context.Context, input, output interface{}) error {
+		return nil
+	})
+
+	r.Route("/github", func(r chi.Router) {
+		r.Group(func(r chi.Router) {
+			r.Use(sessionMiddleware, securityDoc)
+
+			r.Method(http.MethodGet, "/connect", nethttp.NewHandler(u))
+		})
+	})
+
+	paths := apiSchema.Reflector().Spec.Paths.MapOfPathItemValues
+	item, ok := paths["/github/connect"]
+	require.True(t, ok)
+	operation, ok := item.MapOfOperationValues["get"]
+	require.True(t, ok)
+	require.Len(t, operation.Security, 1)
+	assert.Equal(t, map[string][]string{"User": {}}, operation.Security[0])
+
+	components := apiSchema.Reflector().Spec.Components
+	require.NotNil(t, components)
+	require.NotNil(t, components.SecuritySchemes)
+	scheme, ok := components.SecuritySchemes.MapOfSecuritySchemeOrRefValues["User"]
+	require.True(t, ok, "the operation's security scheme must be declared")
+	assert.True(t, scheme.SecurityScheme != nil || scheme.SecuritySchemeReference != nil, "the component must contain a scheme or reference")
+}
+
+func TestWrapper_Use_security_is_limited_to_selected_routes(t *testing.T) {
+	apiSchema := &openapi.Collector{}
+	r := chirouter.NewWrapper(chi.NewRouter())
+	r.Wrap(nethttp.OpenAPIMiddleware(apiSchema))
+
+	u := usecase.NewIOI(nil, nil, func(ctx context.Context, input, output interface{}) error {
+		return nil
+	})
+	r.Method(http.MethodGet, "/public", nethttp.NewHandler(u))
+
+	securityDoc := nethttp.SecurityMiddleware(apiSchema, "User", openapi3.SecurityScheme{
+		APIKeySecurityScheme: &openapi3.APIKeySecurityScheme{
+			In:   openapi3.APIKeySecuritySchemeInCookie,
+			Name: "sessid",
+		},
+	})
+	r.Group(func(r chi.Router) {
+		r.Use(securityDoc)
+		r.Method(http.MethodGet, "/private", nethttp.NewHandler(u))
+	})
+
+	paths := apiSchema.Reflector().Spec.Paths.MapOfPathItemValues
+	publicPath, ok := paths["/public"]
+	require.True(t, ok)
+	publicOperation, ok := publicPath.MapOfOperationValues["get"]
+	require.True(t, ok)
+	assert.Empty(t, publicOperation.Security)
+
+	privatePath, ok := paths["/private"]
+	require.True(t, ok)
+	privateOperation, ok := privatePath.MapOfOperationValues["get"]
+	require.True(t, ok)
+	require.Len(t, privateOperation.Security, 1)
+	assert.Equal(t, map[string][]string{"User": {}}, privateOperation.Security[0])
+}
