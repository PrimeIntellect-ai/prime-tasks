+
+#[test]
+fn test_admin_named_variant_serialization_regression() {
+    // The `Admin` enum must use the `Name {}` form for every variant so
+    // that each variant serializes as an object (e.g. `{"none":{}}`)
+    // rather than as a bare string. This is what makes the enum easy to
+    // write out in the frontend.
+    let none = to_binary(&cw_governance::msg::Admin::None {}).unwrap();
+    assert_eq!(String::from_utf8(none.to_vec()).unwrap(), r#"{"none":{}}"#);
+
+    let governance_contract =
+        to_binary(&cw_governance::msg::Admin::GovernanceContract {}).unwrap();
+    assert_eq!(
+        String::from_utf8(governance_contract.to_vec()).unwrap(),
+        r#"{"governance_contract":{}}"#
+    );
+
+    let address = to_binary(&cw_governance::msg::Admin::Address {
+        addr: "some_addr".to_string(),
+    })
+    .unwrap();
+    assert_eq!(
+        String::from_utf8(address.to_vec()).unwrap(),
+        r#"{"address":{"addr":"some_addr"}}"#
+    );
+}
