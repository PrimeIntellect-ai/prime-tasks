+# -*- coding: utf-8 -*-
+from __future__ import absolute_import, division, print_function, unicode_literals
+from logging import getLogger
+from math import floor
+
+import pytest
+
+from conda.models.index_record import IndexRecord
+
+log = getLogger(__name__)
+
+
+def test_index_record_timestamp():
+    # regression test for #6096
+    ts = 1507565728.999
+    rec = IndexRecord(
+        name='test-package',
+        version='1.2.3',
+        build='2',
+        build_number=2,
+        timestamp=ts
+    )
+    assert rec.timestamp == floor(ts)
+    assert rec.dump()['timestamp'] == floor(ts)
+
+
+def test_index_record_timestamp_integer():
+    ts = 1507565728
+    rec = IndexRecord(
+        name='test-package',
+        version='1.2.3',
+        build='2',
+        build_number=2,
+        timestamp=ts
+    )
+    assert rec.timestamp == ts
+    assert rec.dump()['timestamp'] == ts
+
+
+def test_index_record_invalid_timestamp():
+    with pytest.raises(Exception):
+        IndexRecord(
+            name='test-package',
+            version='1.2.3',
+            build='2',
+            build_number=2,
+            timestamp='not-a-number'
+        )
+
+
+def test_index_record_accepts_additional_supported_fields():
+    dependencies = ['python >=3.8']
+    rec = IndexRecord(
+        name='test-package',
+        version='1.2.3',
+        build='2',
+        build_number=2,
+        timestamp=1507565728,
+        depends=dependencies
+    )
+
+    assert tuple(rec.depends) == tuple(dependencies)
+    assert tuple(rec.dump()['depends']) == tuple(dependencies)
