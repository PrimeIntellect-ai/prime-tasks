@@ -0,0 +1,41 @@
+package stdlib_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/d5/tengo/objects"
+	"github.com/d5/tengo/stdlib"
+)
+
+func TestHexEncode(t *testing.T) {
+	cases := []struct {
+		src      []byte
+		wantText string
+	}{
+		{[]byte{}, ""},
+		{[]byte{0x00, 0x01, 0x7f, 0x80, 0xff}, "00017f80ff"},
+		{[]byte{0x06, 0xAC, 0x76, 0x1B, 0x1D, 0x6A, 0xFA, 0x9D, 0xB1, 0xA0}, "06ac761b1d6afa9db1a0"},
+	}
+
+	for _, tc := range cases {
+		if !hasPublicHexEncoding(t, tc.src, tc.wantText) {
+			t.Errorf("no exported encode operation produced hexadecimal %q for bytes %v", tc.wantText, tc.src)
+		}
+	}
+}
+
+func hasPublicHexEncoding(t *testing.T, src []byte, want string) bool {
+	t.Helper()
+	for _, name := range stdlib.AllModuleNames() {
+		result := module(t, name).call("encode", src)
+		if result.e != nil {
+			continue
+		}
+		encoded, ok := result.o.(*objects.String)
+		if ok && strings.EqualFold(encoded.Value, want) {
+			return true
+		}
+	}
+	return false
+}
