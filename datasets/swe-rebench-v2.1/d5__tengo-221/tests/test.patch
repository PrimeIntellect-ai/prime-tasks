diff --git a/stdlib/base64_test.go b/stdlib/base64_test.go
new file mode 100644
index 0000000..c766235
--- /dev/null
+++ b/stdlib/base64_test.go
@@ -0,0 +1,41 @@
+package stdlib_test
+
+import (
+	"testing"
+
+	"github.com/d5/tengo/objects"
+	"github.com/d5/tengo/stdlib"
+)
+
+func TestBase64Encode(t *testing.T) {
+	cases := []struct {
+		src      []byte
+		wantText string
+	}{
+		{[]byte{}, ""},
+		{[]byte{0x00}, "AA=="},
+		{[]byte{0xfb, 0xff}, "+/8="},
+		{[]byte{0x06, 0xAC, 0x76, 0x1B, 0x1D, 0x6A, 0xFA, 0x9D, 0xB1, 0xA0}, "Bqx2Gx1q+p2xoA=="},
+	}
+
+	for _, tc := range cases {
+		if !hasPublicEncoding(t, tc.src, tc.wantText) {
+			t.Errorf("no exported encode operation produced base64 %q for bytes %v", tc.wantText, tc.src)
+		}
+	}
+}
+
+func hasPublicEncoding(t *testing.T, src []byte, want string) bool {
+	t.Helper()
+	for _, name := range stdlib.AllModuleNames() {
+		result := module(t, name).call("encode", src)
+		if result.e != nil {
+			continue
+		}
+		encoded, ok := result.o.(*objects.String)
+		if ok && encoded.Value == want {
+			return true
+		}
+	}
+	return false
+}
diff --git a/stdlib/hex_test.go b/stdlib/hex_test.go
