+func TestUpliftExposesAnnotatedTagsField(t *testing.T) {
+	cfg := config.Uplift{AnnotatedTags: true}
+	assert.True(t, cfg.AnnotatedTags)
+}
+
+func TestBumpWithAnnotatedTag(t *testing.T) {
+	git.InitRepo(t)
+	git.EmptyCommitAndTag(t, "0.1.0", "feat: Lorem ipsum dolor sit amet")
+
+	var upliftConfig config.Uplift
+	err := yaml.Unmarshal([]byte("annotatedTags: true\ncommitMessage: this is an annotated tag\n"), &upliftConfig)
+	require.NoError(t, err)
+
+	b := NewBumper(io.Discard, BumpOptions{Config: upliftConfig})
+	err = b.Bump()
+
+	require.NoError(t, err)
+	tag := git.LatestTag()
+	taggerName, err := git.Clean(git.Run("for-each-ref", "refs/tags/"+tag,
+		"--format=%(taggername)"))
+	require.NoError(t, err)
+	assert.NotEmpty(t, taggerName)
+
+	taggerEmail, err := git.Clean(git.Run("for-each-ref", "refs/tags/"+tag,
+		"--format=%(taggeremail)"))
+	require.NoError(t, err)
+	assert.NotEmpty(t, taggerEmail)
+
+	contents, err := git.Clean(git.Run("for-each-ref", "refs/tags/"+tag,
+		"--format=%(contents)"))
+	require.NoError(t, err)
+	assert.Contains(t, contents, "this is an annotated tag")
+}
+
+func TestBumpUsesLightweightTagWhenAnnotationsAreDisabled(t *testing.T) {
+	git.InitRepo(t)
+	git.EmptyCommitAndTag(t, "0.1.0", "feat: Lorem ipsum dolor sit amet")
+
+	b := NewBumper(io.Discard, BumpOptions{})
+	err := b.Bump()
+	require.NoError(t, err)
+
+	objectType, err := git.Clean(git.Run("cat-file", "-t", git.LatestTag()))
+	require.NoError(t, err)
+	assert.Equal(t, "commit", objectType)
+}
