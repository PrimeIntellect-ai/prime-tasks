+class TestEndpointPathIntegration(TestEndpointBase):
+    def sent_request_path(self, endpoint_url, request_path):
+        self.endpoint.host = endpoint_url
+        params = request_dict()
+        params['url_path'] = request_path
+        self.endpoint.make_request(self.op, params)
+        sent_request = self.http_session.send.call_args[0][0]
+        return urlsplit(sent_request.url).path
+
+    def test_make_request_preserves_endpoint_url_path(self):
+        cases = [
+            ('https://custom.endpoint/services/Cloud', '/resource',
+             '/services/Cloud/resource'),
+            ('https://custom.endpoint/services/Cloud/', '/resource',
+             '/services/Cloud/resource'),
+            ('https://custom.endpoint/services/Cloud', '/',
+             '/services/Cloud'),
+        ]
+        for endpoint_url, request_path, expected_path in cases:
+            with self.subTest(endpoint_url=endpoint_url,
+                              request_path=request_path):
+                actual_path = self.sent_request_path(
+                    endpoint_url, request_path)
+                expected_paths = (expected_path, expected_path + '/') \
+                    if request_path == '/' else (expected_path,)
+                self.assertIn(actual_path, expected_paths)
