+describe("baseline type data", () => {
+	it("discovers newly available functions when generating the type data", async () => {
+		const directory = fs.mkdtempSync(
+			path.join(os.tmpdir(), "css-baseline-"),
+		);
+		const loaderPath = path.join(directory, "feature-loader.mjs");
+		const features = {
+			"color-mix": {
+				compat_features: ["css.types.color.color-mix"],
+			},
+			"conic-gradients": {
+				compat_features: ["css.types.gradient.conic-gradient"],
+			},
+		};
+
+		fs.writeFileSync(
+			loaderPath,
+			`export async function resolve(specifier, context, nextResolve) {
+if (specifier === "web-features") {
+return {
+url: "data:text/javascript,export const features = ${encodeURIComponent(JSON.stringify(features))}",
+shortCircuit: true,
+};
+}
+return nextResolve(specifier, context);
+}`,
+		);
+		fs.mkdirSync(path.join(directory, "src/data"), { recursive: true });
+		fs.writeFileSync(
+			path.join(directory, "package.json"),
+			JSON.stringify({ type: "module" }),
+		);
+
+		try {
+			const result = spawnSync(
+				process.execPath,
+				[
+					"--loader",
+					loaderPath,
+					path.resolve("tools/generate-baseline.js"),
+				],
+				{ cwd: directory, encoding: "utf8" },
+			);
+
+			assert.equal(result.status, 0, result.stderr);
+
+			const generated = await import(
+				pathToFileURL(path.join(directory, "src/data/baseline-data.js"))
+			);
+
+			assert.ok(generated.types.has("color-mix"));
+			assert.ok(generated.types.has("conic-gradient"));
+		} finally {
+			fs.rmSync(directory, { recursive: true, force: true });
+		}
+	});
+
+	it("includes color-mix and conic-gradient", () => {
+		assert.ok(types.has("color-mix"));
+		assert.ok(types.has("conic-gradient"));
+	});
+
+	it("marks color as newly available", () => {
+		assert.match(types.get("color"), /^5:/);
+	});
+});
+
