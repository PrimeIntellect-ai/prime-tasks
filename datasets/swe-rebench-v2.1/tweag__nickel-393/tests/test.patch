+#[test]
+fn imports() {
+    use nickel::error::Error;
+    use nickel::program::Program;
+    use std::fs;
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    let unique = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap()
+        .as_nanos();
+    let dir = std::env::temp_dir().join(format!("nickel-import-typecheck-{unique}"));
+    fs::create_dir_all(&dir).unwrap();
+    fs::write(dir.join("main.ncl"), "let unused = import \"nested.ncl\" in 0").unwrap();
+    fs::write(
+        dir.join("nested.ncl"),
+        "let also_unused = import \"bad.ncl\" in 1",
+    )
+    .unwrap();
+    fs::write(dir.join("bad.ncl"), "false : Num").unwrap();
+
+    let mut program = Program::new_from_file(dir.join("main.ncl")).unwrap();
+    let result = program.typecheck();
+    fs::remove_dir_all(&dir).unwrap();
+
+    assert_matches!(result, Err(Error::TypecheckError(..)));
+}
 
