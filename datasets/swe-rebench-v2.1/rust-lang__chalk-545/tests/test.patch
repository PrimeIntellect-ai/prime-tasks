+
+#[test]
+fn collection_constructors_and_substitution_slice() {
+    use chalk_integration::interner::ChalkIr;
+    use chalk_ir::*;
+
+    let empty_variable_kinds = VariableKinds::empty(&ChalkIr);
+    assert!(empty_variable_kinds.as_slice(&ChalkIr).is_empty());
+    let empty_canonical_var_kinds = CanonicalVarKinds::empty(&ChalkIr);
+    assert!(empty_canonical_var_kinds.as_slice(&ChalkIr).is_empty());
+    let empty_goals = Goals::empty(&ChalkIr);
+    assert!(empty_goals.as_slice(&ChalkIr).is_empty());
+
+    let variable_kind = VariableKind::Ty(TyKind::General);
+    let variable_kinds = VariableKinds::from1(&ChalkIr, variable_kind.clone());
+    assert_eq!(variable_kinds.as_slice(&ChalkIr), &[variable_kind]);
+
+    let canonical_kind = CanonicalVarKind::new(
+        VariableKind::Ty(TyKind::General),
+        UniverseIndex::root(),
+    );
+    let canonical_var_kinds = CanonicalVarKinds::from1(&ChalkIr, canonical_kind.clone());
+    assert_eq!(canonical_var_kinds.as_slice(&ChalkIr), &[canonical_kind]);
+
+    let parameter = Ty::new(
+        &ChalkIr,
+        TyData::BoundVar(BoundVar::new(DebruijnIndex::INNERMOST, 0)),
+    );
+    let substitution = Substitution::from1(&ChalkIr, parameter.clone());
+    let expected_parameter = GenericArg::new(&ChalkIr, GenericArgData::Ty(parameter));
+    assert_eq!(substitution.as_slice(&ChalkIr), &[expected_parameter]);
+
+    let binders = Binders::new(variable_kinds.clone(), substitution.clone());
+    assert_eq!(
+        binders.binders.as_slice(&ChalkIr),
+        &[VariableKind::Ty(TyKind::General)],
+    );
+}
