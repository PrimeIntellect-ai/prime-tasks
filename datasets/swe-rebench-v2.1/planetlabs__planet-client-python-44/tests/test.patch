+from planet.api.dispatch import RequestsDispatcher
+from planet.api.models import Request, JSON
+from planet.api.auth import APIKey
+import requests_mock
+from urllib.parse import parse_qs, urlsplit
+
+
+def test_dispatcher_passes_auth_on_redirect():
+    '''the client request path must pass auth when following a redirect'''
+    dispatcher = RequestsDispatcher()
+    request = Request('http://redirect.com/', APIKey('foobar'), body_type=JSON)
+    with requests_mock.Mocker() as m:
+        m.get('http://redirect.com/', status_code=302, headers={
+            'Location': 'http://newredirect.com/?param=yep'
+        })
+        m.get('http://newredirect.com', text='redirected!')
+
+        body = dispatcher.response(request).get_body()
+        final_url = urlsplit(body.response.url)
+        assert final_url.scheme == 'http'
+        assert final_url.hostname == 'newredirect.com'
+        query = parse_qs(final_url.query)
+        assert query.get('api_key') == ['foobar']
+        assert query.get('param') == ['yep']
+
+
+def test_dispatcher_preserves_auth_on_same_domain_redirect():
+    dispatcher = RequestsDispatcher()
+    request = Request('http://redirect.com/start', APIKey('foobar'), body_type=JSON)
+    with requests_mock.Mocker() as m:
+        m.get('http://redirect.com/start', status_code=302, headers={
+            'Location': 'http://redirect.com/final'
+        })
+        m.get('http://redirect.com/final', text='redirected!')
+
+        body = dispatcher.response(request).get_body()
+        final_request = body.response.request
+        query = parse_qs(urlsplit(final_request.url).query)
+        assert (
+            final_request.headers.get('Authorization') == 'api-key foobar'
+            or query.get('api_key') == ['foobar']
+        )
