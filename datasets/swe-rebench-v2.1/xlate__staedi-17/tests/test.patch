+    @Test
+    public void testControlSchemaDataTypeValidationWithCodeValuesDisabled() throws Exception {
+        EDIInputFactory factory = EDIInputFactory.newFactory();
+        factory.setProperty(EDIInputFactory.EDI_VALIDATE_CONTROL_STRUCTURE, true);
+        factory.setProperty("io.xlate.edi.stream.EDI_VALIDATE_CONTROL_CODE_VALUES", false);
+
+        // UNB element DE0001 ("IATA") and UNH element DE0065 ("PNRGOV") are not
+        // enumerated values in the control schema. UNB element DE0017 ("ABCDEF")
+        // is not a valid decimal value.
+        String edi = "UNA:+.\\*'"
+                   + "UNB+IATA:1+1A+KRC+ABCDEF:0649+0003'"
+                   + "UNH+1+PNRGOV:11:1:IA+270513/0649/SQ/602'"
+                   + "UNT+2+1'"
+                   + "UNZ+1+0003'";
+
+        EDIStreamReader reader = factory.createEDIStreamReader(
+                new java.io.ByteArrayInputStream(edi.getBytes(java.nio.charset.StandardCharsets.UTF_8)));
+
+        Set<EDIStreamValidationError> errors = new HashSet<>();
+        try {
+            while (reader.hasNext()) {
+                if (reader.next() == EDIStreamEvent.ELEMENT_DATA_ERROR) {
+                    errors.add(reader.getErrorType());
+                }
+            }
+        } finally {
+            reader.close();
+        }
+
+        // Data type validation remains active for the control schema ...
+        assertTrue(errors.contains(EDIStreamValidationError.INVALID_CHARACTER_DATA),
+                   "Expected data type validation to remain active: " + errors);
+        // ... while enumerated code value validation is disabled.
+        assertFalse(errors.contains(EDIStreamValidationError.INVALID_CODE_VALUE),
+                    "Expected code value validation to be disabled: " + errors);
+    }
+
+    @Test
+    public void testControlSchemaCodeValueValidationEnabledByDefault() throws Exception {
+        EDIInputFactory factory = EDIInputFactory.newFactory();
+        factory.setProperty(EDIInputFactory.EDI_VALIDATE_CONTROL_STRUCTURE, true);
+
+        String edi = "UNA:+.\\*'"
+                   + "UNB+IATA:1+1A+KRC+130527:0649+0003'"
+                   + "UNZ+0+0003'";
+        EDIStreamReader reader = factory.createEDIStreamReader(
+                new java.io.ByteArrayInputStream(edi.getBytes(java.nio.charset.StandardCharsets.UTF_8)));
+
+        boolean codeValueErrorReported = false;
+        try {
+            while (reader.hasNext()) {
+                if (reader.next() == EDIStreamEvent.ELEMENT_DATA_ERROR
+                        && reader.getErrorType() == EDIStreamValidationError.INVALID_CODE_VALUE) {
+                    codeValueErrorReported = true;
+                }
+            }
+        } finally {
+            reader.close();
+        }
+
+        assertTrue(codeValueErrorReported,
+                   "Control-schema code-value validation should be enabled when the property is unset");
+    }
+
+    @Test
+    public void testControlSchemaStructureValidationWithCodeValuesDisabled() throws Exception {
+        EDIInputFactory factory = EDIInputFactory.newFactory();
+        factory.setProperty(EDIInputFactory.EDI_VALIDATE_CONTROL_STRUCTURE, true);
+        factory.setProperty("io.xlate.edi.stream.EDI_VALIDATE_CONTROL_CODE_VALUES", false);
+
+        String edi = "UNA:+.\\*'"
+                   + "UNB+IATA:1+1A+KRC+130527:0649+0003'"
+                   + "FOO+BAR'"
+                   + "UNZ+0+0003'";
+        EDIStreamReader reader = factory.createEDIStreamReader(
+                new java.io.ByteArrayInputStream(edi.getBytes(java.nio.charset.StandardCharsets.UTF_8)));
+
+        boolean structuralErrorReported = false;
+        try {
+            while (reader.hasNext()) {
+                if (reader.next() == EDIStreamEvent.SEGMENT_ERROR) {
+                    structuralErrorReported = true;
+                }
+            }
+        } finally {
+            reader.close();
+        }
+
+        assertTrue(structuralErrorReported,
+                   "Disabling control-schema code values must not disable segment-structure validation");
+    }
+
+    @Test
+    public void testValidateControlCodeValuesPropertyConstant() throws Exception {
+        java.lang.reflect.Field field = EDIInputFactory.class.getField("EDI_VALIDATE_CONTROL_CODE_VALUES");
+        assertEquals("io.xlate.edi.stream.EDI_VALIDATE_CONTROL_CODE_VALUES", field.get(null));
+    }
 }
