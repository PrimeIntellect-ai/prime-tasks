+func TestQueryBool(t *testing.T) {
+
+	db, err := sql.Open("ramsql", "TestQueryBool")
+	if err != nil {
+		t.Fatalf("sql.Open: %s", err)
+	}
+	defer db.Close()
+
+	_, err = db.Exec(`CREATE TABLE ttable (id BIGINT, hasBool BOOL)`)
+	if err != nil {
+		t.Fatalf("cannot create table: %s", err)
+	}
+
+	_, err = db.Exec(`INSERT INTO ttable (id, hasBool) VALUES (?,?)`, 1, true)
+	if err != nil {
+		t.Fatalf("cannot insert into table: %s", err)
+	}
+
+	_, err = db.Exec(`INSERT INTO ttable (id, hasBool) VALUES (?,?)`, 2, false)
+	if err != nil {
+		t.Fatalf("cannot insert into table: %s", err)
+	}
+
+	var id int64
+	err = db.QueryRow(`SELECT id FROM ttable WHERE hasBool = ?`, true).Scan(&id)
+	if err != nil {
+		t.Fatalf("cannot query with true: %s", err)
+	}
+	if id != 1 {
+		t.Fatalf("expected id 1 for hasBool = true, got %d", id)
+	}
+
+	err = db.QueryRow(`SELECT id FROM ttable WHERE hasBool = ?`, false).Scan(&id)
+	if err != nil {
+		t.Fatalf("cannot query with false: %s", err)
+	}
+	if id != 2 {
+		t.Fatalf("expected id 2 for hasBool = false, got %d", id)
+	}
+
+}
