+def test_explain_phase_label_assertion_4339():
+    # A strategy built inside a composite is re-created on each draw, so the
+    # strategies it contains are not the same objects across draws.  The
+    # explain phase used to trip an internal assertion when it compared the
+    # labels of such re-created strategies, hiding the user's error.
+    @st.composite
+    def g(draw):
+        draw(st.one_of(st.none(), st.integers(min_value=1, max_value=256)))
+
+    @given(g(), st.one_of(st.none(), st.booleans()))
+    @settings(database=None, derandomize=True)
+    def f(a, b):
+        raise ValueError("marker")
+
+    with pytest.raises(ValueError, match="marker"):
+        f()
