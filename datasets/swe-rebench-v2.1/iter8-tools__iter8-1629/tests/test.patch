+func assertDashboardWithAllowedTestKey(t *testing.T, path string, handler http.HandlerFunc, expectedBody string) {
+	t.Helper()
+	accepted := false
+	for _, key := range []string{"test", "performance_test"} {
+		query := url.Values{"namespace": {"default"}, key: {"default"}}
+		req := httptest.NewRequest(http.MethodGet, path+"?"+query.Encode(), nil)
+		w := httptest.NewRecorder()
+		handler(w, req)
+		res := w.Result()
+		body, err := io.ReadAll(res.Body)
+		assert.NoError(t, err)
+		assert.NoError(t, res.Body.Close())
+		if res.StatusCode == http.StatusOK {
+			accepted = true
+			assert.Equal(t, expectedBody, string(body))
+		} else {
+			assert.Equal(t, http.StatusBadRequest, res.StatusCode)
+		}
+	}
+	assert.True(t, accepted, "the dashboard must accept either test or performance_test")
+}
