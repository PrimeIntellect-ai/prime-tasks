+use getrandom::getrandom as getrandom_impl;
+
+#[test]
+fn test_public_getrandom_uninit() {
+    use core::mem::MaybeUninit;
+
+    let mut first = [MaybeUninit::<u8>::uninit(); 1000];
+    let original_ptr = first.as_mut_ptr() as *mut u8;
+    let expected_len = first.len();
+    let initialized = getrandom::getrandom_uninit(&mut first).unwrap();
+
+    assert_eq!(initialized.len(), expected_len);
+    assert_eq!(initialized.as_mut_ptr(), original_ptr);
+
+    let mut second = [MaybeUninit::<u8>::uninit(); 1000];
+    let other = getrandom::getrandom_uninit(&mut second).unwrap();
+    // Independent 1000-byte random outputs are equal with probability 2^-8000,
+    // and all-zero with probability 2^-8000 as well, so these checks only
+    // reject a missing or constant fill.
+    assert!(initialized.iter().any(|&b| b != 0));
+    assert_ne!(&*initialized, &*other);
+}
