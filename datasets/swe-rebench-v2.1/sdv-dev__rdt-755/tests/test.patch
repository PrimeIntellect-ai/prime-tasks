+
+
+@pytest.mark.parametrize(('transformer_class', 'kwargs', 'transformed'), [
+    (UniformEncoder, {}, [0.1, 0.2, np.nan, 0.9]),
+    (OrderedUniformEncoder, {'order': [1, 2, 3]}, [0.1, 0.2, np.nan, 0.9]),
+    (LabelEncoder, {}, [0.0, 0.0, np.nan, 2.0]),
+    (OrderedLabelEncoder, {'order': [1, 2, 3]}, [0.0, 0.0, np.nan, 2.0]),
+])
+def test_reverse_transform_int64_with_nulls_warns_and_returns_float(
+        transformer_class, kwargs, transformed):
+    """Test that int64 data with nulls is reversed to float64 with a warning.
+
+    Reversing transformed data that contains nulls for an int64 column must not raise
+    an error. Instead, a warning should be shown and the result should be float64
+    with the nulls preserved.
+    """
+    # Setup
+    data = pd.DataFrame({'a': [1, 1, 2, 2, 2, 3, 3, 3]})
+    transformer = transformer_class(**kwargs)
+    transformer.fit(data, 'a')
+    transformed_data = pd.DataFrame({transformer.output_columns[0]: transformed})
+
+    # Run
+    with pytest.warns(UserWarning, match='null values'):
+        reversed_data = transformer.reverse_transform(transformed_data)
+
+    # Assert
+    expected = pd.DataFrame({'a': [1.0, 1.0, np.nan, 3.0]})
+    pd.testing.assert_frame_equal(reversed_data, expected)
+
+
+@pytest.mark.parametrize('categories', [['a', 'b', 'c'], [1.5, 2.5, 3.5]])
+@pytest.mark.parametrize(('transformer_class', 'transformed'), [
+    (UniformEncoder, [0.1, np.nan, 0.9]),
+    (OrderedUniformEncoder, [0.1, np.nan, 0.9]),
+    (LabelEncoder, [0.0, np.nan, 2.0]),
+    (OrderedLabelEncoder, [0.0, np.nan, 2.0]),
+])
+def test_reverse_transform_non_integer_with_nulls_warns(
+        transformer_class, transformed, categories):
+    """Test that non-integer data with nulls is reversed with a warning.
+
+    The reversed values must be the same as without nulls, the nulls must be kept, the
+    original dtype must be kept and a warning must be shown.
+    """
+    # Setup
+    values = [categories[0], categories[0], categories[1], categories[1], categories[2]]
+    data = pd.DataFrame({'a': values})
+    kwargs = {}
+    if transformer_class in (OrderedUniformEncoder, OrderedLabelEncoder):
+        kwargs['order'] = categories
+
+    transformer = transformer_class(**kwargs)
+    transformer.fit(data, 'a')
+    transformed_data = pd.DataFrame({transformer.output_columns[0]: transformed})
+
+    # Run
+    with pytest.warns(UserWarning, match='null values'):
+        reversed_data = transformer.reverse_transform(transformed_data)
+
+    # Assert
+    expected = pd.DataFrame({'a': [categories[0], np.nan, categories[2]]})
+    pd.testing.assert_frame_equal(reversed_data, expected)
+    assert reversed_data['a'].dtype == data['a'].dtype
