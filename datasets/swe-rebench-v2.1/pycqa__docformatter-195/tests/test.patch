+        """The application CLI accepts words to preserve in summaries."""
+        source = 'def client():\n    """eBay kinda suss"""\n'
+        result = subprocess.run(
+            [
+                sys.executable,
+                "-m",
+                "docformatter",
+                "-",
+                "--non-cap",
+                "eBay",
+            ],
+            input=source,
+            capture_output=True,
+            text=True,
+        )
+
+        assert result.returncode == 0
+        assert '"""eBay kinda suss."""' in result.stdout
