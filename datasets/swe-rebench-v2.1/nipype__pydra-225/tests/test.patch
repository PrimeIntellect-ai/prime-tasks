+def test_hash_value_dir_tracks_all_file_contents(tmpdir):
+    nested = tmpdir.mkdir("nested")
+    deep = nested.mkdir("deep")
+    root_file = tmpdir.join("root.txt")
+    nested_file = nested.join("nested.txt")
+    deep_file = deep.join("deep.txt")
+
+    for path in (root_file, nested_file, deep_file):
+        with open(path, "w") as f:
+            f.write("initial")
+
