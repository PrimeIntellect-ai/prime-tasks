@@ -0,0 +1,133 @@
+package test
+
+import (
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+
+	"github.com/mgechev/revive/config"
+	"github.com/mgechev/revive/lint"
+)
+
+func TestEnforceMapStyleUserConfiguration(t *testing.T) {
+	configuration := lint.Config{Rules: map[string]lint.RuleConfig{
+		"enforce-map-style": {},
+	}}
+	rules, err := config.GetLintingRules(&configuration, nil)
+	if err != nil {
+		t.Fatalf("could not configure the map-style rule: %v", err)
+	}
+	for _, configuredRule := range rules {
+		if configuredRule.Name() == "enforce-map-style" {
+			return
+		}
+	}
+	t.Fatalf("configured rules did not include enforce-map-style: got %v", rules)
+}
+
+func TestEnforceMapStyleSelectedStyle(t *testing.T) {
+	if style := os.Getenv("REVIVE_MAP_STYLE_TEST"); style != "" {
+		switch style {
+		case "make":
+			checkConfiguredMapStyle(t, "enforce-map-style-make.go", style, []int{6, 20, 34, 44, 47})
+		case "literal":
+			checkConfiguredMapStyle(t, "enforce-map-style-literal.go", style, []int{5, 19, 33, 46})
+		default:
+			t.Fatalf("unexpected test style %q", style)
+		}
+		return
+	}
+
+	for _, style := range []string{"make", "literal"} {
+		t.Run(style, func(t *testing.T) {
+			cmd := exec.Command(os.Args[0], "-test.run=^TestEnforceMapStyleSelectedStyle$")
+			for _, entry := range os.Environ() {
+				if !strings.HasPrefix(entry, "REVIVE_MAP_STYLE_TEST=") {
+					cmd.Env = append(cmd.Env, entry)
+				}
+			}
+			cmd.Env = append(cmd.Env, "REVIVE_MAP_STYLE_TEST="+style)
+			if output, err := cmd.CombinedOutput(); err != nil {
+				t.Fatalf("%s style failed: %v\n%s", style, err, output)
+			}
+		})
+	}
+}
+
+func checkConfiguredMapStyle(t *testing.T, filename, style string, requiredLines []int) {
+	t.Helper()
+	// Rule configuration can express the selected style as a scalar argument or
+	// as a keyed option. Try both public configuration forms rather than
+	// requiring one representation from the implementation.
+	candidates := []interface{}{style, map[string]interface{}{"style": style}}
+	for _, argument := range candidates {
+		got, panicked := runConfiguredMapStyle(t, filename, argument)
+		if panicked {
+			continue
+		}
+		matches := true
+		for _, line := range requiredLines {
+			if !containsMapStyleLine(got, line) {
+				matches = false
+			}
+		}
+		for _, line := range got {
+			if !containsMapStyleLine(requiredLines, line) {
+				matches = false
+			}
+		}
+		if matches {
+			return
+		}
+	}
+	t.Fatalf("no supported configuration for %q style reported exactly the expected violations %v", style, requiredLines)
+}
+
+func runConfiguredMapStyle(t *testing.T, filename string, argument interface{}) (got []int, panicked bool) {
+	t.Helper()
+	defer func() {
+		if recover() != nil {
+			panicked = true
+		}
+	}()
+	configuration := lint.Config{Rules: map[string]lint.RuleConfig{
+		"enforce-map-style": {Arguments: lint.Arguments{argument}},
+	}}
+	registeredRules, err := config.GetLintingRules(&configuration, nil)
+	if err != nil {
+		t.Fatalf("could not configure the map-style rule: %v", err)
+	}
+	var selectedRule lint.Rule
+	for _, configuredRule := range registeredRules {
+		if configuredRule.Name() == "enforce-map-style" {
+			selectedRule = configuredRule
+			break
+		}
+	}
+	if selectedRule == nil {
+		t.Fatalf("configured rules did not include enforce-map-style: got %v", registeredRules)
+	}
+
+	linter := lint.New(func(path string) ([]byte, error) {
+		return os.ReadFile("../testdata/" + path)
+	}, 0)
+	rules := []lint.Rule{selectedRule}
+	failures, err := linter.Lint([][]string{{filename}}, rules, configuration)
+	if err != nil {
+		t.Fatalf("could not lint the fixture: %v", err)
+	}
+	for failure := range failures {
+		got = append(got, failure.Position.Start.Line)
+	}
+	return got, false
+}
+
+func containsMapStyleLine(lines []int, target int) bool {
+	for _, line := range lines {
+		if line == target {
+			return true
+		}
+	}
+	return false
+}
