+import Module from 'module'
 import td from 'testdouble'
 
+// Newer Node versions create Module._cache with a null prototype, which breaks
+// the quibble version bundled with testdouble. Restore hasOwnProperty so that
+// module replacement works.
+if (typeof Module._cache.hasOwnProperty !== 'function') {
+  Module._cache.hasOwnProperty = function (key) {
+    return Object.prototype.hasOwnProperty.call(this, key)
+  }
+}
+
 const exec = td.replace('../../src/util/modules/exec')
 
 function didExec (t, cmd, args, options = {}) {
-  const secondArg = args ? td.matchers.contains(args) : []
-  td.verify(exec(td.matchers.contains(cmd), secondArg, td.matchers.contains(options)))
+  const argsMatcher = args ? td.matchers.contains(...[].concat(args)) : td.matchers.anything()
+  td.verify(exec(cmd, argsMatcher, td.matchers.contains(options)))
 }
 
 didExec.title = (providedTitle, cmd, subcmd) => `Executed ${cmd} ${subcmd || ''}`
