-test(didExec, 'webpack')
+
+async function captureOutput (operation) {
+  let output = ''
+  const stdoutWrite = process.stdout.write
+  const stderrWrite = process.stderr.write
+  const record = function (chunk) {
+    output += String(chunk)
+    return true
+  }
+  process.stdout.write = record
+  process.stderr.write = record
+  try {
+    await operation()
+  } catch (err) {
+    // The rejected promise is checked by the caller; capture only its report.
+  } finally {
+    process.stdout.write = stdoutWrite
+    process.stderr.write = stderrWrite
+  }
+  return output
+}
+
+test.serial('build and deploy reject and report webpack failures', async (t) => {
+  const shep = require('../../src')
+  td.when(exec('webpack', td.matchers.anything(), td.matchers.anything()))
+    .thenResolve({ stdout: 'ERROR in ./functions/foo/index.js' })
+  td.when(exec('webpack', td.matchers.contains('--bail'), td.matchers.anything()))
+    .thenReject(new Error('webpack failed'))
+
+  let buildRejected = false
+  const buildOutput = await captureOutput(async () => {
+    try {
+      await shep.build({ quiet: false })
+    } catch (err) {
+      buildRejected = true
+    }
+  })
+  t.true(buildRejected)
+  t.true(buildOutput.trim().length > 0)
+
+  let deployRejected = false
+  const deployOutput = await captureOutput(async () => {
+    try {
+      await shep.deploy({ functions: 'foo-*', env: 'beta', quiet: false })
+    } catch (err) {
+      deployRejected = true
+    }
+  })
+  t.true(deployRejected)
+  t.true(deployOutput.trim().length > 0)
+  td.verify(upload(td.matchers.anything()), { times: 0, ignoreExtraArgs: true })
+})
