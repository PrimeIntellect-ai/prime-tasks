+  func testSharedStringsArchiveReadErrorThrows() throws {
+    let fileManager = FileManager.default
+    let tempDir = fileManager.temporaryDirectory
+      .appendingPathComponent("CoreXLSX-\(UUID().uuidString)")
+    let xlDir = tempDir.appendingPathComponent("xl")
+    try fileManager.createDirectory(at: xlDir, withIntermediateDirectories: true)
+    defer { try? fileManager.removeItem(at: tempDir) }
+
+    try "<sst xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" count=\"1\" uniqueCount=\"1\"><si><t>value</t></si></sst>"
+      .write(
+        to: xlDir.appendingPathComponent("sharedStrings.xml"),
+        atomically: true,
+        encoding: .utf8
+      )
+
+    let archiveURL = tempDir.appendingPathComponent("damaged.xlsx")
+    do {
+      guard let archive = Archive(url: archiveURL, accessMode: .create) else {
+        XCTFail("failed to create the archive")
+        return
+      }
+      try archive.addEntry(with: "xl/sharedStrings.xml", relativeTo: tempDir)
+    }
+
+    var archiveData = try Data(contentsOf: archiveURL)
+    let entryName = Data("xl/sharedStrings.xml".utf8)
+    guard let entryNameRange = archiveData.range(of: entryName) else {
+      XCTFail("failed to find the shared-strings entry in the archive")
+      return
+    }
+    let nameOffset = archiveData.distance(
+      from: archiveData.startIndex,
+      to: entryNameRange.lowerBound
+    )
+    let compressionMethodOffset = nameOffset - 30 + 8
+    archiveData[archiveData.index(archiveData.startIndex, offsetBy: compressionMethodOffset)] = 0xff
+    archiveData[archiveData.index(archiveData.startIndex, offsetBy: compressionMethodOffset + 1)] = 0
+    try archiveData.write(to: archiveURL)
+
+    guard let file = XLSXFile(filepath: archiveURL.path) else {
+      XCTFail("failed to open the file")
+      return
+    }
+
+    XCTAssertThrowsError(try file.parseSharedStrings())
+  }
+
+  func testSharedStringsMalformedThrows() throws {
+    let fileManager = FileManager.default
+    let tempDir = fileManager.temporaryDirectory
+      .appendingPathComponent("CoreXLSX-\(UUID().uuidString)")
+    let xlDir = tempDir.appendingPathComponent("xl")
+    try fileManager.createDirectory(at: xlDir, withIntermediateDirectories: true)
+    defer { try? fileManager.removeItem(at: tempDir) }
+
+    try "<sharedStrings><si><t>unterminated"
+      .write(
+        to: xlDir.appendingPathComponent("sharedStrings.xml"),
+        atomically: true,
+        encoding: .utf8
+      )
+
+    let archiveURL = tempDir.appendingPathComponent("malformed.xlsx")
+    guard let archive = Archive(url: archiveURL, accessMode: .create) else {
+      XCTFail("failed to create the archive")
+      return
+    }
+    try archive.addEntry(with: "xl/sharedStrings.xml", relativeTo: tempDir)
+
+    guard let file = XLSXFile(filepath: archiveURL.path) else {
+      XCTFail("failed to open the file")
+      return
+    }
+
+    XCTAssertThrowsError(try file.parseSharedStrings())
+  }
