     return
 end
 
+function test_symmetric_hermitian_equality()
+    model = Model()
+    @variable(model, x[1:2, 1:2], Symmetric)
+    H = LinearAlgebra.Hermitian([1 2; 2 3])
+    c = @constraint(model, x == H)
+
+    # Matching the full matrix is feasible, while a mismatch in an off-diagonal
+    # element must not be silently ignored.
+    @test isempty(primal_feasibility_report(model, Dict(
+        x[1, 1] => 1.0,
+        x[1, 2] => 2.0,
+        x[2, 2] => 3.0,
+    )))
+    @test !isempty(primal_feasibility_report(model, Dict(
+        x[1, 1] => 1.0,
+        x[1, 2] => 0.0,
+        x[2, 2] => 3.0,
+    )))
+    complex_model = Model()
+    @variable(complex_model, z[1:2, 1:2], Symmetric)
+    H_complex = LinearAlgebra.Hermitian([1 2im; -2im 3])
+    @constraint(complex_model, z == H_complex)
+    @test !isempty(primal_feasibility_report(complex_model, Dict(
+        z[1, 1] => 1.0,
+        z[1, 2] => 0.0,
+        z[2, 2] => 3.0,
+    )))
+    dual_model = Model(() -> MOIU.MockOptimizer(
+        MOIU.Model{Float64}();
+        eval_objective_value = false,
+        eval_variable_constraint_dual = false,
+    ))
+    @variable(dual_model, A[1:2, 1:2], Symmetric)
+    @variable(dual_model, B[1:2, 1:2], Hermitian)
+    dual_constraint = @constraint(dual_model, A == B)
+    optimize!(dual_model)
+    optimizer = unsafe_backend(dual_model)
+    MOI.set(optimizer, MOI.TerminationStatus(), MOI.OPTIMAL)
+    MOI.set(optimizer, MOI.DualStatus(), MOI.FEASIBLE_POINT)
+    dual_object = constraint_object(dual_constraint)
+    MOI.set(
+        optimizer,
+        MOI.ConstraintDual(),
+        optimizer_index(dual_constraint),
+        1:MOI.dimension(dual_object.set),
+    )
+    dual_value = dual(dual_constraint)
+    @test isapprox(dual_value, adjoint(dual_value))
+    return
+end
+
 end  # module
