+class Test_Expression_rule_validation(unittest.TestCase):
+    """The Expression component must validate that the result returned by
+    its rule is a valid numeric expression (see the problem statement)."""
+
+    def test_valid_rule_result(self):
+        m = ConcreteModel()
+        m.TIME = RangeSet(2)
+        m.x = Var(m.TIME)
+
+        @m.Expression(m.TIME)
+        def exp1(m, t):
+            return m.x[t]
+
+        self.assertEqual(len(m.exp1), 2)
+
+    def test_rule_result_is_indexed_component(self):
+        m = ConcreteModel()
+        m.TIME = RangeSet(2)
+        m.x = Var(m.TIME)
+
+        @m.Expression(m.TIME)
+        def exp1(m, t):
+            return m.x[t]
+
+        with self.assertRaisesRegex(
+                TypeError,
+                "is not a valid type for Pyomo numeric expressions"):
+
+            @m.Expression(m.TIME)
+            def exp2(m, t):
+                return m.exp1
+
+    def test_rule_result_is_non_numeric_object(self):
+        m = ConcreteModel()
+        m.TIME = RangeSet(2)
+
+        with self.assertRaisesRegex(
+                TypeError,
+                "is not a valid type for Pyomo numeric expressions"):
+
+            @m.Expression(m.TIME)
+            def exp1(m, t):
+                return m
+
+
 if __name__ == "__main__":
