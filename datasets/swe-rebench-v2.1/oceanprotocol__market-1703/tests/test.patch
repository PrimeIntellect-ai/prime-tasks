--- /dev/null
+++ b/src/@utils/url.test.ts
@@ -0,0 +1,14 @@
+import { sanitizeUrl } from './url'
+
+describe('@utils/url', () => {
+  test('allows HTTP and HTTPS URLs unchanged', () => {
+    expect(sanitizeUrl('http://example.com')).toBe('http://example.com')
+    expect(sanitizeUrl('https://example.com')).toBe('https://example.com')
+  })
+
+  test('replaces URLs using schemes outside the allow-list with the fallback', () => {
+    expect(sanitizeUrl('ftp://example.com')).toBe('about:blank')
+    expect(sanitizeUrl('mailto:user@example.com')).toBe('about:blank')
+    expect(sanitizeUrl('javascript:alert(1)')).toBe('about:blank')
+  })
+})
