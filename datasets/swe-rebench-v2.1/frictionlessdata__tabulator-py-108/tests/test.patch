+def test_detect_encoding_unknown():
+    # Uncertain detection falls back to the default UTF-8 decoding behavior.
+    data = b'\xff\x81,ok\n'
+    table = Stream(io.BytesIO(data), format='csv', headers=['value', 'status'])
+    with pytest.raises(UnicodeDecodeError):
+        table.open()
+
+
+def test_detect_encoding_uses_cchardet():
+    # This sample is reliably recognized as Shift-JIS by cchardet; the former
+    # detector does not identify it with sufficient confidence.
+    data = ('こんにちは世界,ok\n' * 50).encode('shift_jis')
+    table = Stream(io.BytesIO(data), format='csv', headers=['value', 'status'])
+    table.open()
+    try:
+        assert table.read() == [['こんにちは世界', 'ok']] * 50
+    finally:
+        table.close()
+
+
+def test_detect_encoding_shift_jis_for_another_sample():
+    data = ('今日は世界,ok\n' * 50).encode('shift_jis')
+    table = Stream(io.BytesIO(data), format='csv', headers=['value', 'status'])
+    table.open()
+    try:
+        assert table.read() == [['今日は世界', 'ok']] * 50
+    finally:
+        table.close()
+
+
+def test_cchardet_is_a_runtime_dependency(tmp_path):
+    repository = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    subprocess.check_call(
+        [sys.executable, 'setup.py', 'egg_info', '--egg-base', str(tmp_path)],
+        cwd=repository, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    requirements_file = tmp_path / 'tabulator.egg-info' / 'requires.txt'
+    runtime_requirements = requirements_file.read_text().split('[develop]', 1)[0]
+    assert any(line.strip().lower().startswith('cchardet')
+               for line in runtime_requirements.splitlines())
 
 
