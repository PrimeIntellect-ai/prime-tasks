+func TestMinerConsensusFaultReportRequestsDealTermination(t *testing.T) {
+	owner := tutil.NewIDAddr(t, 100)
+	worker := tutil.NewIDAddr(t, 101)
+	workerKey := tutil.NewBLSAddr(t, 0)
+	actor := newHarness(t, tutil.NewIDAddr(t, 1000), owner, worker, workerKey)
+	periodOffset := abi.ChainEpoch(100)
+	builder := mock.NewBuilder(context.Background(), actor.receiver).
+		WithActorType(owner, builtin.AccountActorCodeID).
+		WithActorType(worker, builtin.AccountActorCodeID).
+		WithHasher(fixedHasher(uint64(periodOffset))).
+		WithBalance(abi.NewTokenAmount(1<<50), abi.NewTokenAmount(0)).
+		WithCaller(builtin.InitActorAddr, builtin.InitActorCodeID)
+
+	rt := builder.Build(t)
+	actor.constructAndVerify(rt, periodOffset)
+	rt.SetEpoch(1)
+	st := getState(rt)
+	deadline := st.DeadlineInfo(rt.Epoch())
+	expiration := deadline.PeriodEnd() + 10*miner.WPoStProvingPeriod
+	dealIDs := [][]abi.DealID{{1, 2}, {3, 4}}
+	actor.commitAndProveSectors(rt, 2, expiration, 1<<50, dealIDs)
+
+	allDeals := []abi.DealID{1, 2, 3, 4}
+	faultRuntime := &faultDealTrackingRuntime{
+		Runtime: rt,
+		fault: &runtime.ConsensusFault{
+			Target: actor.receiver,
+			Epoch:  rt.Epoch() - 1,
+			Type:   runtime.ConsensusFaultDoubleForkMining,
+		},
+	}
+	rt.SetCaller(addr.TestAddress, builtin.AccountActorCodeID)
+	rt.ExpectValidateCallerType(builtin.CallerTypesSignable...)
+	rt.Call(func(r runtime.Runtime, params *miner.ReportConsensusFaultParams) *adt.EmptyValue {
+		return actor.a.ReportConsensusFault(faultRuntime, params)
+	}, &miner.ReportConsensusFaultParams{})
+	rt.Verify()
+
+	assert.ElementsMatch(t, allDeals, faultRuntime.terminatedDeals)
+}
+
+type faultDealTrackingRuntime struct {
+	runtime.Runtime
+	fault           *runtime.ConsensusFault
+	terminatedDeals []abi.DealID
+}
+
+func (rt *faultDealTrackingRuntime) Syscalls() runtime.Syscalls {
+	return faultDealTrackingSyscalls{Syscalls: rt.Runtime.Syscalls(), fault: rt.fault}
+}
+
+func (rt *faultDealTrackingRuntime) Send(to addr.Address, method abi.MethodNum, params runtime.CBORMarshaler, value abi.TokenAmount) (runtime.SendReturn, exitcode.ExitCode) {
+	if to == builtin.StorageMarketActorAddr && method == builtin.MethodsMarket.OnMinerSectorsTerminate {
+		termination := params.(*market.OnMinerSectorsTerminateParams)
+		rt.terminatedDeals = append(rt.terminatedDeals, termination.DealIDs...)
+	}
+	return nil, exitcode.Ok
+}
+
+func (rt *faultDealTrackingRuntime) DeleteActor(_ addr.Address) {}
+
+type faultDealTrackingSyscalls struct {
+	runtime.Syscalls
+	fault *runtime.ConsensusFault
+}
+
+func (syscalls faultDealTrackingSyscalls) VerifyConsensusFault(_, _, _ []byte) (*runtime.ConsensusFault, error) {
+	return syscalls.fault, nil
+}
