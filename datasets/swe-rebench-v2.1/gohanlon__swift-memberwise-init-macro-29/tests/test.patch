+import MacroTesting
+import MemberwiseInitMacros
+import SwiftDiagnostics
+import SwiftParser
+import SwiftSyntax
+import SwiftSyntaxMacroExpansion
+import XCTest
+
+final class InvalidSyntaxTests: XCTestCase {
+  override func invokeTest() {
+    // NB: Waiting for swift-macro-testing PR to support explicit indentationWidth: https://github.com/pointfreeco/swift-macro-testing/pull/8
+    withMacroTesting(
+      //indentationWidth: .spaces(2),
+      macros: [
+        "MemberwiseInit": MemberwiseInitMacro.self,
+        "InitRaw": InitMacro.self,
+      ]
+    ) {
+      super.invokeTest()
+    }
+  }
+
+  func testInvalidRedeclaration_DoesNotCrash() {
+    assertMemberwiseInitDoesNotCrash(
+      """
+      @MemberwiseInit
+      struct S {
+        let x: T
+        let x: T
+      }
+      """
+    )
+  }
+
+  func testInvalidRedeclarationInSingleDeclaration_DoesNotCrash() {
+    assertMemberwiseInitDoesNotCrash(
+      """
+      @MemberwiseInit
+      struct S {
+        let x, x: T
+      }
+      """
+    )
+  }
+
+  private func assertMemberwiseInitDoesNotCrash(_ source: String) {
+    let sourceFile = Parser.parse(source: source)
+    guard
+      let structDecl = sourceFile.statements.first?.item.as(DeclSyntax.self)?.as(StructDeclSyntax.self),
+      let attribute = structDecl.attributes.first?.as(AttributeSyntax.self)
+    else {
+      XCTFail("Expected a struct annotated with @MemberwiseInit")
+      return
+    }
+    let context = BasicMacroExpansionContext(
+      sourceFiles: [sourceFile: .init(moduleName: "TestModule", fullFilePath: "Test.swift")]
+    )
+
+    _ = try? MemberwiseInitMacro.expansion(
+      of: attribute,
+      providingMembersOf: structDecl,
+      in: context
+    )
+  }
+
+  func testInvalidRedeclarationAndCustomLabelConflictsWithPropertyName_FailsWithDiagnostic() throws {
+    let source = """
+      @MemberwiseInit
+      struct S {
+        @Init(label: "x") let x: T
+        let x: T
+      }
+      """
+    let sourceFile = Parser.parse(source: source)
+    let context = BasicMacroExpansionContext(
+      sourceFiles: [sourceFile: .init(moduleName: "TestModule", fullFilePath: "Test.swift")]
+    )
+    let structDecl = try XCTUnwrap(
+      sourceFile.statements.first?.item.as(DeclSyntax.self)?.as(StructDeclSyntax.self)
+    )
+    let attribute = try XCTUnwrap(structDecl.attributes.first?.as(AttributeSyntax.self))
+
+    _ = try MemberwiseInitMacro.expansion(
+      of: attribute,
+      providingMembersOf: structDecl,
+      in: context
+    )
+
+    let messages = context.diagnostics.map(\.message)
+    XCTAssertTrue(
+      messages.contains("Label 'x' conflicts with a property name"),
+      "Expected a diagnostic with the message \"Label 'x' conflicts with a property name\", got: \(messages)"
+    )
+  }
+}
