+@testset "Derivatives of Array Variables" begin
+    @variables p[1:9]
+    vp = collect(p)
+
+    f = - 1.5log(5 + p[3]) - 1.5log(7 + p[1]) - 1.5log(8 - p[2]) - 1.5log(9 - p[4]) + 0.08p[4]*p[9] -1.5log(5 + p[3]) - 1.5log(7 + p[1]) - 1.5log(8 - p[2]) - 1.5log(9 - p[4]) + 0.08p[4]*p[9]
+
+    # Compare the Hessians by value: equivalent symbolic forms need not be structurally identical.
+    vals = Dict(Symbolics.unwrap(p[i]) => 0.1i - 0.3 for i in 1:9)
+    numeric(H) = [Float64(Symbolics.value(Symbolics.substitute(Symbolics.unwrap(h), vals))) for h in H]
+    @test numeric(Symbolics.hessian(f, vp)) ≈ numeric(Symbolics.hessian(f, p))
+end
