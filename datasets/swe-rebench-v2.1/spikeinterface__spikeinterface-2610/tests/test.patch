+def test_preprocessed_recording_get_parent():
+    from spikeinterface.preprocessing import scale
+
+    traces = np.zeros((100, 3), dtype="float32")
+    traces[:] = np.arange(100)[:, None]
+    sampling_frequency = 30000
+    rec = NumpyRecording([traces], sampling_frequency)
+
+    preproc = scale(rec, gain=2.0)
+    assert preproc.get_parent() == rec
+    # the original data is reachable through the preprocessed recording
+    assert np.array_equal(preproc.get_parent().get_traces(), rec.get_traces())
+
+
 if __name__ == "__main__":
     test_FrameSliceRecording()
+    test_preprocessed_recording_get_parent()
