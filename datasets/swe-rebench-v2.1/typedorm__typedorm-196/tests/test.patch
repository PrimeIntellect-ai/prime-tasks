@@ -0,0 +1,86 @@
+import {Article, IArticlePrimaryKey} from './specific-event-entity';
+import 'reflect-metadata';
+
+import {createTestConnection, resetTestConnection} from '@typedorm/testing';
+import {EntityManager} from '@typedorm/core';
+
+jest.useFakeTimers('modern').setSystemTime(new Date('2020-10-10'));
+
+let entityManager: EntityManager;
+
+const dcMock = {
+  update: jest.fn(),
+};
+beforeEach(() => {
+  const connection = createTestConnection({
+    entities: [Article],
+    documentClient: dcMock,
+  });
+  entityManager = new EntityManager(connection);
+});
+
+afterEach(() => {
+  resetTestConnection();
+});
+
+/**
+ * Resolves the SET assignments of an UpdateItem request into a plain
+ * attribute name -> value map, independent of the expression alias names and
+ * the ordering of the assignments chosen by the implementation.
+ */
+function resolveUpdatedAttributes(request: any): Record<string, any> {
+  const names: Record<string, string> = request.ExpressionAttributeNames ?? {};
+  const values: Record<string, any> = request.ExpressionAttributeValues ?? {};
+  const expression: string = request.UpdateExpression ?? '';
+
+  const setClause = expression.replace(/^\s*SET\s+/i, '');
+  const assignments = setClause
+    .split(',')
+    .map(part => part.trim())
+    .filter(Boolean);
+
+  const resolved: Record<string, any> = {};
+  for (const assignment of assignments) {
+    const [lhs, rhs] = assignment.split('=').map(part => part.trim());
+    const attributeName = names[lhs] ?? lhs;
+    resolved[attributeName] = values[rhs] ?? rhs;
+  }
+  return resolved;
+}
+
+test('allows updating article with primary key', async () => {
+  dcMock.update.mockReturnValue({
+    promise: () => ({}),
+  });
+
+  await entityManager.update<Article, IArticlePrimaryKey>(
+    Article,
+    {
+      KSUID: '12341',
+    },
+    {
+      ContainerId: 'container-1',
+    }
+  );
+
+  const request = dcMock.update.mock.calls[0][0];
+
+  // targets the correct table and item
+  expect(request.TableName).toBe('article');
+  expect(request.Key).toEqual({
+    PK: 'ARTICLE#ARTICLE_KSUID#12341',
+    SK: 'METADATA#ARTICLE#12341',
+  });
+
+  // the updated attributes are returned
+
+  // the supplied attribute and every affected index attribute are updated,
+  // with index template references resolved against the primary key
+  expect(resolveUpdatedAttributes(request)).toMatchObject({
+    ContainerId: 'container-1',
+    UpdatedAt: '2020-10-10T00:00:00.000Z',
+    GSI1PK: 'CONTAINER#CONTAINER_KSUID#container-1',
+    GSI3PK: 'CONTAINER#container-1#ARTICLE#12341',
+    LSI1SK: 'ARTICLE#UPDATED_AT#2020-10-10T00:00:00.000Z',
+  });
+});
diff --git a/__test__/github-issues/195/specific-event-entity.ts b/__test__/github-issues/195/specific-event-entity.ts
