diff --git a/sqltests/SELECT/len.sql b/sqltests/SELECT/len.sql
new file mode 100644
index 00000000..7b93cfd2
--- /dev/null
+++ b/sqltests/SELECT/len.sql
@@ -0,0 +1,49 @@
+-- setup:
+CREATE TABLE foo(
+  b ARRAY
+);
+INSERT INTO foo VALUES ([1, 2, 3, [4, 5]]);
+
+-- test: array field
+SELECT len(b) AS result FROM foo;
+/* result:
+{
+    "result": 4
+}
+*/
+
+-- test: subarray
+SELECT len(b[3]) AS result FROM foo;
+/* result:
+{
+    "result": 2
+}
+*/
+
+-- test: array expr
+SELECT len([1, 2, 3, 4, 5]) AS result;
+/* result:
+{
+  "result": 5
+}
+*/
+
+-- test: empty array expr
+SELECT len([]) AS result;
+/* result:
+{
+  "result": 0
+}
+*/
+
+-- test: mixed type array expr
+SELECT len([1, 2, 3, [1, 2, 3]]) AS result;
+/* result:
+{
+  "result": 4
+}
+*/
+
+-- test: error from inner expression
+SELECT len(CAST('\xAF' AS INT)) FROM foo;
+-- error: cannot cast blob as integer
