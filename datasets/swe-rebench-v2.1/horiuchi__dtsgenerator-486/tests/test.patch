+import assert from 'assert';
+import dtsGenerator, { parseSchema } from '../src/core';
+import { JsonSchemaDraft07 } from '../src/core/jsonSchemaDraft07';
+
+// Collects the names of all declared properties (e.g. `a?: string`) in the generated text.
+function declaredPropertyNames(text: string): string[] {
+    const pattern = /(?:"([^"]+)"|([A-Za-z_$][\w$]*))\s*\??\s*:/g;
+    const names: string[] = [];
+    let match = pattern.exec(text);
+    while (match !== null) {
+        names.push(match[1] !== undefined ? match[1] : match[2]);
+        match = pattern.exec(text);
+    }
+    return names.sort();
+}
+
+describe("nested 'oneOf' test", () => {
+    it("single 'oneOf' nesting schema", async () => {
+        const schema: JsonSchemaDraft07.Schema = {
+            $id: '/test/nested/oneOf',
+            $schema: 'http://json-schema.org/draft-07/schema#',
+            type: 'object',
+            oneOf: [
+                {
+                    type: 'object',
+                    properties: {
+                        a: { type: 'string' },
+                    },
+                },
+                {
+                    type: 'object',
+                    oneOf: [
+                        {
+                            type: 'object',
+                            properties: {
+                                b: { type: 'string' },
+                            },
+                        },
+                        {
+                            type: 'object',
+                            properties: {
+                                c: { type: 'string' },
+                            },
+                        },
+                    ],
+                },
+            ],
+        };
+        const result = await dtsGenerator({ contents: [parseSchema(schema)] });
+
+        assert.ok(/export type OneOf\s*=/.test(result), result);
+        assert.deepStrictEqual(
+            declaredPropertyNames(result),
+            ['a', 'b', 'c'],
+            "Nested 'oneOf' definitions should result in all properties being included in the output interface."
+        );
+    });
+
+    it("multiple 'oneOf' nestings schema", async () => {
+        const schema: JsonSchemaDraft07.Schema = {
+            $id: '/test/nested/oneOf',
+            $schema: 'http://json-schema.org/draft-07/schema#',
+            type: 'object',
+            oneOf: [
+                {
+                    type: 'object',
+                    properties: {
+                        a: { type: 'string' },
+                    },
+                },
+                {
+                    type: 'object',
+                    oneOf: [
+                        {
+                            type: 'object',
+                            properties: {
+                                b: { type: 'string' },
+                            },
+                        },
+                        {
+                            type: 'object',
+                            oneOf: [
+                                {
+                                    type: 'object',
+                                    properties: {
+                                        c: { type: 'string' },
+                                    },
+                                },
+                                {
+                                    type: 'object',
+                                    properties: {
+                                        d: { type: 'string' },
+                                    },
+                                },
+                            ],
+                        },
+                        {
+                            type: 'object',
+                            oneOf: [
+                                {
+                                    type: 'object',
+                                    properties: {
+                                        c: { type: 'string' },
+                                    },
+                                },
+                                {
+                                    type: 'object',
+                                    properties: {
+                                        e: { type: 'string' },
+                                    },
+                                },
+                                {
+                                    type: 'object',
+                                    properties: {
+                                        f: { type: 'string' },
+                                    },
+                                },
+                            ],
+                        },
+                    ],
+                },
+            ],
+        };
+        const result = await dtsGenerator({ contents: [parseSchema(schema)] });
+
+        assert.ok(/export type OneOf\s*=/.test(result), result);
+        assert.deepStrictEqual(
+            [...new Set(declaredPropertyNames(result))],
+            ['a', 'b', 'c', 'd', 'e', 'f'],
+            "Nested 'oneOf' definitions should result in all properties being included in the output interface."
+        );
+    });
+
+    it("refed 'oneOf' nested schema", async () => {
+        const schema: JsonSchemaDraft07.Schema = {
+            $id: '/test/nested/oneOf',
+            $schema: 'http://json-schema.org/draft-07/schema#',
+            type: 'object',
+            definitions: {
+                A: {
+                    properties: {
+                        s: {
+                            oneOf: [
+                                {
+                                    type: 'string',
+                                },
+                            ],
+                        },
+                    },
+                },
+                B: {
+                    properties: {
+                        ref: {
+                            oneOf: [
+                                {
+                                    $ref: '#/definitions/A',
+                                },
+                            ],
+                        },
+                    },
+                },
+            },
+            properties: {
+                bref: {
+                    $ref: '#/definitions/B',
+                },
+            },
+        };
+        const result = await dtsGenerator({ contents: [parseSchema(schema)] });
+
+        assert.ok(/export interface A\b/.test(result), result);
+        assert.ok(/export interface B\b/.test(result), result);
+        assert.ok(/\bs\s*\?\s*:\s*string\b/.test(result), result);
+        assert.ok(/\bref\s*\?\s*:\s*(?:[\w.]+\.)?A\s*;/.test(result), result);
+        assert.ok(/\bbref\s*\?\s*:\s*(?:[\w.]+\.)?B\s*;/.test(result), result);
+    });
+
+    it("includes alternatives from a nested 'anyOf' schema", async () => {
+        const schema: JsonSchemaDraft07.Schema = {
+            $id: '/test/nested/anyOf',
+            $schema: 'http://json-schema.org/draft-07/schema#',
+            type: 'object',
+            anyOf: [
+                {
+                    type: 'object',
+                    properties: {
+                        a: { type: 'string' },
+                    },
+                },
+                {
+                    type: 'object',
+                    anyOf: [
+                        {
+                            type: 'object',
+                            properties: {
+                                b: { type: 'string' },
+                            },
+                        },
+                        {
+                            type: 'object',
+                            properties: {
+                                c: { type: 'string' },
+                            },
+                        },
+                    ],
+                },
+            ],
+        };
+        const result = await dtsGenerator({ contents: [parseSchema(schema)] });
+
+        assert.ok(/(?:"a"|a)\s*\??\s*:/.test(result));
+        assert.ok(/(?:"b"|b)\s*\??\s*:/.test(result));
+        assert.ok(/(?:"c"|c)\s*\??\s*:/.test(result));
+    });
+});
