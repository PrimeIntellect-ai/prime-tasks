+    @pytest.mark.skipif(
+        backend.backend() != "tensorflow",
+        reason="The tf.Variable test can only run with TensorFlow backend.",
+    )
+    def test_mixed_with_tf_variables(self):
+        import tensorflow as tf
+
+        v = backend.Variable([[1.0, 2.0], [3.0, 4.0]])
+        grads = backend.convert_to_tensor([[1.0, 1.0], [1.0, 1.0]])
+        tf_v = tf.Variable([[1.0, 2.0], [3.0, 4.0]])
+        tf_grads = backend.convert_to_tensor([[1.0, 1.0], [1.0, 1.0]])
+        optimizer = optimizers.SGD(learning_rate=0.1)
+        optimizer.apply_gradients([(grads, v), (tf_grads, tf_v)])
+        expected_after_update = [[0.9, 1.9], [2.9, 3.9]]
+        self.assertAllClose(v, expected_after_update)
+        self.assertAllClose(tf_v, expected_after_update)
+
+        # A missing gradient should warn without preventing the available
+        # gradient from updating its variable.
+        v_before = backend.convert_to_numpy(v)
+        tf_v_before = tf_v.numpy().copy()
+        with pytest.warns(Warning):
+            optimizer.apply_gradients([(grads, v), (None, tf_v)])
+        self.assertAllClose(v, v_before - 0.1)
+        self.assertAllClose(tf_v, tf_v_before)
