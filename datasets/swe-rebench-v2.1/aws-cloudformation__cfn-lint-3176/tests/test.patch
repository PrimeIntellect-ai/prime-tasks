+        self.assertListEqual(matches, [])
+
+        generated = [
+            resource
+            for resource in template["Resources"].values()
+            if resource.get("Type") == "AWS::S3::Bucket"
+            and isinstance(resource.get("Properties", {}).get("BucketName"), dict)
+        ]
+        self.assertGreaterEqual(len(generated), 1)
+        # every iteration must stand for a different element of the list
+        bucket_names = [
+            str(resource["Properties"]["BucketName"]) for resource in generated
+        ]
+        self.assertEqual(len(set(bucket_names)), len(generated))
+        for bucket_name in bucket_names:
+            self.assertIn("AccountIds", bucket_name)
