+class TestTransformListParameterValidation(TestCase):
+    def test_no_validation_error_for_list_parameter(self):
+        template = """
+Transform: AWS::LanguageExtensions
+Parameters:
+  AccountIds:
+    Type: CommaDelimitedList
+  GroupId:
+    Type: String
+Resources:
+  'Fn::ForEach::Assignments':
+    - AccountId
+    - !Ref AccountIds
+    - 'Assignment${AccountId}':
+        Type: AWS::SSO::Assignment
+        Properties:
+          InstanceArn: arn:aws:sso:::instance/ssoins-1234567890abcdef
+          PermissionSetArn: arn:aws:sso:::permissionSet/ssoins-1234567890abcdef/ps-1234567890abcdef
+          TargetId: !Ref AccountId
+          TargetType: AWS_ACCOUNT
+          PrincipalId: !Ref GroupId
+          PrincipalType: GROUP
+"""
+        rules = get_rules([], [], ["I", "W", "E"], include_experimental=True)
+        matches = lint(template, rules, ["us-east-1"])
+        self.assertNotIn("E3031", [match.rule.id for match in matches])
+
+    def test_invalid_concrete_list_element_is_pattern_validated(self):
+        template = """
+Transform: AWS::LanguageExtensions
+Parameters:
+  AccountIds:
+    Type: CommaDelimitedList
+    Default: "12345678901"
+Resources:
+  'Fn::ForEach::Assignments':
+    - AccountId
+    - !Ref AccountIds
+    - 'Assignment${AccountId}':
+        Type: AWS::SSO::Assignment
+        Properties:
+          InstanceArn: arn:aws:sso:::instance/ssoins-1234567890abcdef
+          PermissionSetArn: arn:aws:sso:::permissionSet/ssoins-1234567890abcdef/ps-1234567890abcdef
+          TargetId: !Ref AccountId
+          TargetType: AWS_ACCOUNT
+          PrincipalId: 12345678-1234-1234-1234-123456789012
+          PrincipalType: GROUP
+"""
+        rules = get_rules([], [], ["I", "W", "E"], include_experimental=True)
+        matches = lint(template, rules, ["us-east-1"])
+        self.assertTrue(
+            any(
+                match.rule.id == "E3031" and match.path[-1] == "TargetId"
+                for match in matches
+            )
+        )
+
