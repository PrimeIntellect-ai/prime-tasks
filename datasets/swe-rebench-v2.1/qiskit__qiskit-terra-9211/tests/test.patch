+    def test_text_reverse_bits_read_from_config(self):
+        """Swap drawing with reverse_bits set in the configuration file."""
+        expected_forward = "\n".join(
+            [
+                "            ",
+                "q1_0: ─X────",
+                "       │    ",
+                "q1_1: ─┼──X─",
+                "       │  │ ",
+                "q2_0: ─X──┼─",
+                "          │ ",
+                "q2_1: ────X─",
+                "            ",
+            ]
+        )
+        expected_reverse = "\n".join(
+            [
+                "            ",
+                "q2_1: ────X─",
+                "          │ ",
+                "q2_0: ─X──┼─",
+                "       │  │ ",
+                "q1_1: ─┼──X─",
+                "       │    ",
+                "q1_0: ─X────",
+                "            ",
+            ]
+        )
+        qr1 = QuantumRegister(2, "q1")
+        qr2 = QuantumRegister(2, "q2")
+        circuit = QuantumCircuit(qr1, qr2)
+        circuit.swap(qr1, qr2)
+
+        self.assertEqual(str(circuit_drawer(circuit, output="text")), expected_forward)
+
+        config_content = """
+            [default]
+            circuit_reverse_bits = true
+        """
+        with tempfile.TemporaryDirectory() as dir_path:
+            file_path = pathlib.Path(dir_path) / "qiskit.conf"
+            with open(file_path, "w") as fptr:
+                fptr.write(config_content)
+            with unittest.mock.patch.dict(os.environ, {"QISKIT_SETTINGS": str(file_path)}):
+                test_reverse = str(circuit_drawer(circuit, output="text"))
+        self.assertEqual(test_reverse, expected_reverse)
+
+    def test_text_reverse_bits_read_from_config_via_draw(self):
+        """QuantumCircuit.draw uses the config value when reverse_bits is None."""
+        qr1 = QuantumRegister(2, "q1")
+        qr2 = QuantumRegister(2, "q2")
+        circuit = QuantumCircuit(qr1, qr2)
+        circuit.swap(qr1, qr2)
+
+        default_drawing = str(circuit.draw(output="text"))
+        explicit_reverse = str(circuit.draw(output="text", reverse_bits=True))
+        self.assertNotEqual(default_drawing, explicit_reverse)
+
+        config_content = """
+            [default]
+            circuit_reverse_bits = true
+        """
+        with tempfile.TemporaryDirectory() as dir_path:
+            file_path = pathlib.Path(dir_path) / "qiskit.conf"
+            with open(file_path, "w") as fptr:
+                fptr.write(config_content)
+            with unittest.mock.patch.dict(os.environ, {"QISKIT_SETTINGS": str(file_path)}):
+                from_config = str(circuit.draw(output="text"))
+        self.assertEqual(from_config, explicit_reverse)
+
+    def test_explicit_reverse_bits_false_overrides_config(self):
+        """An explicit false value overrides a configured reverse-bits default."""
+        qr1 = QuantumRegister(2, "q1")
+        qr2 = QuantumRegister(2, "q2")
+        circuit = QuantumCircuit(qr1, qr2)
+        circuit.swap(qr1, qr2)
+
+        config_files = []
+        for value in ("false", "true"):
+            temp_dir = tempfile.TemporaryDirectory()
+            self.addCleanup(temp_dir.cleanup)
+            file_path = pathlib.Path(temp_dir.name) / "qiskit.conf"
+            file_path.write_text(f"[default]\ncircuit_reverse_bits = {value}\n")
+            config_files.append(file_path)
+
+        with unittest.mock.patch.dict(os.environ, {"QISKIT_SETTINGS": str(config_files[0])}):
+            expected_drawer = str(circuit_drawer(circuit, output="text"))
+            expected_method = str(circuit.draw(output="text"))
+
+        with unittest.mock.patch.dict(os.environ, {"QISKIT_SETTINGS": str(config_files[1])}):
+            drawer_result = str(circuit_drawer(circuit, output="text", reverse_bits=False))
+            method_result = str(circuit.draw(output="text", reverse_bits=False))
+
+        self.assertEqual(drawer_result, expected_drawer)
+        self.assertEqual(method_result, expected_method)
