+func TestIRMCCredentialsAreAvailableToIPMIDriver(t *testing.T) {
+	acc, err := NewAccessDetails("irmc://192.168.122.1", true)
+	if err != nil {
+		t.Fatalf("unexpected parse error: %v", err)
+	}
+
+	driverInfo := acc.DriverInfo(Credentials{Username: "bmc-user", Password: "bmc-secret"})
+	for key, want := range map[string]interface{}{
+		"ipmi_address":  "192.168.122.1",
+		"ipmi_username": "bmc-user",
+		"ipmi_password": "bmc-secret",
+	} {
+		if got, ok := driverInfo[key]; !ok || got != want {
+			t.Errorf("driver info %q = %v (present: %v), want %v", key, got, ok, want)
+		}
+	}
+}
