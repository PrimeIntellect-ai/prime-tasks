+func TestDecoder_LiteralWithTrailingNewLines(t *testing.T) {
+	tests := []struct {
+		name string
+		yaml string
+		want string
+	}{
+		{
+			name: "clip indicator with trailing blank lines",
+			yaml: "foo: |\n  bar\n\n\n",
+			want: "bar\n",
+		},
+		{
+			name: "clip indicator with one trailing blank line",
+			yaml: "foo: |\n  bar\n\n",
+			want: "bar\n",
+		},
+		{
+			name: "strip indicator with trailing blank lines",
+			yaml: "foo: |-\n  bar\n\n\n",
+			want: "bar",
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			var v map[string]any
+			if err := yaml.Unmarshal([]byte(test.yaml), &v); err != nil {
+				t.Fatal(err)
+			}
+			got, ok := v["foo"].(string)
+			if !ok {
+				t.Fatalf("failed to decode string value: %v", v["foo"])
+			}
+			if got != test.want {
+				t.Fatalf("expected %q but got %q", test.want, got)
+			}
+		})
+	}
+}
