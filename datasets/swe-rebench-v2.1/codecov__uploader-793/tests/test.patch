index 0000000..51c6e79
--- /dev/null
+++ b/test/helpers/git.test.ts
@@ -0,0 +1,71 @@
+import { execFileSync } from 'child_process'
+import fs from 'fs'
+import os from 'os'
+import path from 'path'
+import { MockAgent, setGlobalDispatcher } from 'undici'
+
+import { main } from '../../src'
+import { version } from '../../package.json'
+import { parseSlug } from '../../src/helpers/git'
+
+describe('Git Helper', () => {
+  it('should be able to parse http urls', () => {
+    const remoteAddr = 'http://github.com/codecov/uploader.git'
+    expect(parseSlug(remoteAddr)).toBe('codecov/uploader')
+  })
+
+  it('should be able to parse https urls', () => {
+    const remoteAddr = 'https://github.com/codecov/uploader.git'
+    expect(parseSlug(remoteAddr)).toBe('codecov/uploader')
+  })
+
+  it('should be able to parse ssh urls with a port', () => {
+    const remoteAddr = 'ssh://git@github.com:22/codecov/uploader.git'
+    expect(parseSlug(remoteAddr)).toBe('codecov/uploader')
+  })
+
+  it('uploads coverage when the git remote uses an ssh:// url', async () => {
+    const repoDir = fs.mkdtempSync(path.join(os.tmpdir(), 'codecov-ssh-'))
+    const originalCwd = process.cwd()
+    try {
+      execFileSync('git', ['init', '-q'], { cwd: repoDir })
+      execFileSync('git', ['config', 'user.email', 'test@example.com'], { cwd: repoDir })
+      execFileSync('git', ['config', 'user.name', 'Test User'], { cwd: repoDir })
+      execFileSync(
+        'git',
+        ['remote', 'add', 'origin', 'ssh://git@github.com:22/codecov/uploader.git'],
+        { cwd: repoDir },
+      )
+      fs.copyFileSync(
+        path.join(originalCwd, 'test', 'fixtures', 'coverage.txt'),
+        path.join(repoDir, 'coverage.txt'),
+      )
+      execFileSync('git', ['add', 'coverage.txt'], { cwd: repoDir })
+      execFileSync('git', ['commit', '-q', '-m', 'init'], { cwd: repoDir })
+
+      process.chdir(repoDir)
+
+      const args = {
+        flags: '',
+        slug: '',
+        token: 'abcdefg',
+        upstream: '',
+        url: 'https://codecov.io',
+      }
+      const mockAgent = new MockAgent({ connections: 1 })
+      setGlobalDispatcher(mockAgent)
+      const mockClient = mockAgent.get('https://codecov.io')
+      mockClient.intercept({
+        method: 'POST',
+        path: /^\/upload\/v4\?.*(?:[?&])slug=codecov(?:%2F|\/)uploader(?:&|$).*/,
+      }).reply(200, 'https://results.codecov.io\nhttps://codecov.io')
+      mockClient.intercept({ method: 'PUT', path: '/' }).reply(200, 'success')
+
+      await main(args)
+      expect(mockAgent.pendingInterceptors()).toHaveLength(0)
+    } finally {
+      process.chdir(originalCwd)
+      fs.rmSync(repoDir, { recursive: true, force: true })
+    }
+  }, 30000)
+})
