diff --git a/test/ecto/migrator_test.exs b/test/ecto/migrator_test.exs
index 6a014987..561e87d8 100644
--- a/test/ecto/migrator_test.exs
+++ b/test/ecto/migrator_test.exs
@@ -303,6 +303,24 @@ defmodule Ecto.MigratorTest do
     end
   end
 
+  test "migrations will give the migration status while file is deleted" do
+    in_tmp fn path ->
+      create_migration "1_up_migration_1.exs"
+      create_migration "2_up_migration_2.exs"
+      create_migration "3_up_migration_3.exs"
+      create_migration "4_down_migration_1.exs"
+
+      File.rm("2_up_migration_2.exs")
+
+      missing_migration =
+        migrations(TestRepo, path)
+        |> Enum.find(fn {_status, version, _description} -> version == 2 end)
+
+      assert {:up, 2, description} = missing_migration
+      assert String.contains?(description, "FILE NOT FOUND")
+    end
+  end
+
   test "migrations run inside a transaction if the adapter supports ddl transactions" do
     capture_log fn ->
       put_test_adapter_config(supports_ddl_transaction?: true, test_process: self())
