+            "cosmwasm1uwcvgs5clswpfxhm7nyfjmaeysn6us0yvjdexn9yjkv3k7zjhp2sly4xh9",
+        );
+
+        let mock_api = MockApi::default().with_prefix("juno");
+        let juno_creator: Addr = mock_api.addr_make("creator");
+        assert_eq!(
+            juno_creator.to_string(),
