+
+    def test_non_comparable_defaults(self):
+        """
+        Default values whose equality comparison result cannot be used as a
+        boolean (for example numpy arrays) do not break class creation, and
+        the default value is kept.
+        """
+
+        class AmbiguousBool:
+            def __bool__(self):
+                raise ValueError(
+                    "The truth value is ambiguous. Use a.any() or a.all()"
+                )
+
+        class ArrayLike:
+            def __eq__(self, other):
+                return AmbiguousBool()
+
+            def __ne__(self, other):
+                return AmbiguousBool()
+
+        default = ArrayLike()
+
+        @attr.s(auto_attribs=True)
+        class C:
+            x: typing.Any = default
+
+        assert default is C().x
