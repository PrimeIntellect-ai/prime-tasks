+import { Canvas } from './Canvas';
+
+describe('Canvas touch scrolling', () => {
+  test('allows native vertical scrolling for touch gestures when enabled', () => {
+    const canvas = new Canvas(undefined, { allowTouchScrolling: true });
+    const touch = {
+      clientX: 10,
+      clientY: 10,
+      identifier: 1,
+      target: canvas.upperCanvasEl,
+    };
+    const start = new TouchEvent('touchstart', {
+      bubbles: true,
+      cancelable: true,
+      touches: [touch],
+      changedTouches: [touch],
+    });
+    canvas.upperCanvasEl.dispatchEvent(start);
+    expect(start.defaultPrevented).toBe(false);
+
+    const move = new TouchEvent('touchmove', {
+      bubbles: true,
+      cancelable: true,
+      touches: [touch],
+      changedTouches: [touch],
+    });
+    document.dispatchEvent(move);
+    expect(move.defaultPrevented).toBe(false);
+
+    // CSS touch-action can suppress native panning even when events are not
+    // cancelled. Accept any value that permits vertical panning.
+    const touchAction =
+      getComputedStyle(canvas.upperCanvasEl).touchAction ||
+      canvas.upperCanvasEl.style.touchAction ||
+      '';
+    const actions = touchAction.split(/\s+/).filter(Boolean);
+    const allowsVerticalPanning =
+      actions.length === 0 ||
+      actions.includes('auto') ||
+      actions.includes('manipulation') ||
+      actions.includes('pan-y') ||
+      (actions.includes('pan-up') && actions.includes('pan-down'));
+    expect(allowsVerticalPanning).toBe(true);
+  });
+});
