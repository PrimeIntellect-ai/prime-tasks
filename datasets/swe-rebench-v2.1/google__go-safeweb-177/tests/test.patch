+// failingWriter is an http.ResponseWriter whose body writes always fail.
+type failingWriter struct {
+	header http.Header
+}
+
+func (w failingWriter) Header() http.Header       { return w.header }
+func (w failingWriter) WriteHeader(int)           {}
+func (w failingWriter) Write([]byte) (int, error) { return 0, errors.New("write failed") }
+
+func TestDefaultDispatcherExecuteTemplateFailures(t *testing.T) {
+	type execData struct{ Name string }
+	tests := []struct {
+		name string
+		rw   func() http.ResponseWriter
+		resp safehttp.TemplateResponse
+	}{
+		{
+			name: "Execution fails",
+			rw: func() http.ResponseWriter {
+				return safehttptest.NewTestResponseWriter(&strings.Builder{})
+			},
+			resp: safehttp.TemplateResponse{
+				Template: templatePtr(safetemplate.Must(safetemplate.New("name").Parse("<h1>{{ .Missing }}</h1>"))),
+				Data:     dataPtr(execData{Name: "x"}),
+			},
+		},
+		{
+			name: "Execution fails with FuncMap",
+			rw: func() http.ResponseWriter {
+				return safehttptest.NewTestResponseWriter(&strings.Builder{})
+			},
+			resp: safehttp.TemplateResponse{
+				Template: templatePtr(safetemplate.Must(safetemplate.New("name").Parse("<h1>{{ .Missing }}</h1>"))),
+				Data:     dataPtr(execData{Name: "x"}),
+				FuncMap:  map[string]interface{}{"Extra": func() string { return "extra" }},
+			},
+		},
+		{
+			name: "Writing fails",
+			rw: func() http.ResponseWriter {
+				return failingWriter{header: http.Header{}}
+			},
+			resp: safehttp.TemplateResponse{
+				Template: templatePtr(safetemplate.Must(safetemplate.New("name").Parse("<h1>{{ . }}</h1>"))),
+				Data:     dataPtr("Content"),
+			},
+		},
+		{
+			name: "Writing fails with FuncMap",
+			rw: func() http.ResponseWriter {
+				return failingWriter{header: http.Header{}}
+			},
+			resp: safehttp.TemplateResponse{
+				Template: templatePtr(safetemplate.Must(safetemplate.New("name").Parse("<h1>{{ . }}</h1>"))),
+				Data:     dataPtr("Content"),
+				FuncMap:  map[string]interface{}{"Extra": func() string { return "extra" }},
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			d := &safehttp.DefaultDispatcher{}
+			if err := d.ExecuteTemplate(tt.rw(), tt.resp); err == nil {
+				t.Error("d.ExecuteTemplate(rw, resp): got nil, want error")
+			}
+		})
+	}
+}
+
+func templatePtr(x *safetemplate.Template) *safehttp.Template {
+	t := safehttp.Template(x)
+	return &t
+}
+
+func dataPtr(x interface{}) *interface{} {
+	return &x
+}
