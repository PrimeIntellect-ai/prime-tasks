diff --git a/lua/lualine/components/progress.lua b/lua/lualine/components/progress.lua
index 7946a6ce9..5611fbe78 100644
--- a/lua/lualine/components/progress.lua
+++ b/lua/lualine/components/progress.lua
@@ -1,7 +1,15 @@
 -- Copyright (c) 2020-2021 hoob3rt
 -- MIT license, see LICENSE for more details.
 local function progress()
-  return '%3p%%'
+  local cur = vim.fn.line('.')
+  local total = vim.fn.line('$')
+  if cur == 1 then
+    return 'Top'
+  elseif cur == total then
+    return 'Bot'
+  else
+    return math.floor(cur / total * 100) .. '%%'
+  end
 end
 
 return progress
