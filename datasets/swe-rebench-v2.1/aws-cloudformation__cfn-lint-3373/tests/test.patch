+def test_codepipeline_version_getatt_is_valid_for_webhook_target_pipeline_version():
+    rule = GetAtt()
+    cfn = Template(
+        "",
+        {
+            "Resources": {
+                "MyCodePipeline": {"Type": "AWS::CodePipeline::Pipeline"},
+                "Webhook": {"Type": "AWS::CodePipeline::Webhook"},
+            }
+        },
+        regions=["us-east-1"],
+    )
+    context = create_context_for_template(cfn)
+    validator = CfnTemplateValidator({}, context=context, cfn=cfn)
+    _, webhook_schema = next(
+        iter(
+            PROVIDER_SCHEMA_MANAGER.get_resource_schemas_by_regions(
+                "AWS::CodePipeline::Webhook", ["us-east-1"]
+            )
+        )
+    )
+    target_pipeline_version_schema = webhook_schema.schema["properties"][
+        "TargetPipelineVersion"
+    ]
+    errors = list(
+        rule.fn_getatt(
+            validator,
+            target_pipeline_version_schema,
+            {"Fn::GetAtt": "MyCodePipeline.Version"},
+            {},
+        )
+    )
+
+    assert errors == []
