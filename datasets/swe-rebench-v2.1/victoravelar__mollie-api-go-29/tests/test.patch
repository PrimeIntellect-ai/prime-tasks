diff --git a/mollie/invoices_test.go b/mollie/invoices_test.go
new file mode 100644
index 0000000..c4cdd5e
--- /dev/null
+++ b/mollie/invoices_test.go
@@ -0,0 +1,148 @@
+package mollie
+
+import (
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/VictorAvelar/mollie-api-go/testdata"
+)
+
+func TestInvoicesService_Get(t *testing.T) {
+	setup()
+	defer teardown()
+	id := "inv_xBEbP9rvAq"
+	_ = tClient.WithAuthenticationValue("test_token")
+	tMux.HandleFunc("/v2/invoices/"+id, func(w http.ResponseWriter, r *http.Request) {
+		testHeader(t, r, AuthHeader, "Bearer test_token")
+		testMethod(t, r, "GET")
+		if _, ok := r.Header[AuthHeader]; !ok {
+			w.WriteHeader(http.StatusUnauthorized)
+		}
+
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte(testdata.GetInvoiceResponse))
+	})
+
+	res, err := tClient.Invoices.Get(id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if res.ID != id {
+		t.Errorf("mismatching info. want %v, got %v", id, res.ID)
+	}
+}
+
+func TestInvoicesService_List(t *testing.T) {
+	setup()
+	defer teardown()
+	_ = tClient.WithAuthenticationValue("test_token")
+	tMux.HandleFunc("/v2/invoices", func(w http.ResponseWriter, r *http.Request) {
+		testHeader(t, r, AuthHeader, "Bearer test_token")
+		testMethod(t, r, "GET")
+		if _, ok := r.Header[AuthHeader]; !ok {
+			w.WriteHeader(http.StatusUnauthorized)
+		}
+
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte(testdata.ListInvoicesResponse))
+	})
+
+	res, err := tClient.Invoices.List(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if res.Count == 0 {
+		t.Errorf("mismatching info. want %v, got %v", 0, res.Count)
+	}
+}
+
+// queryValue looks up a query parameter ignoring the case of its name.
+func queryValue(q url.Values, name string) (string, bool) {
+	for k, v := range q {
+		if strings.EqualFold(k, name) && len(v) > 0 {
+			return v[0], true
+		}
+	}
+	return "", false
+}
+
+func TestInvoicesService_ListWithOptions(t *testing.T) {
+	setup()
+	defer teardown()
+	_ = tClient.WithAuthenticationValue("test_token")
+	tMux.HandleFunc("/v2/invoices", func(w http.ResponseWriter, r *http.Request) {
+		testHeader(t, r, AuthHeader, "Bearer test_token")
+		testMethod(t, r, "GET")
+		if _, ok := r.Header[AuthHeader]; !ok {
+			w.WriteHeader(http.StatusUnauthorized)
+		}
+
+		want := map[string]string{
+			"reference": "2016.10000",
+			"year":      "2016",
+			"from":      "10",
+			"limit":     "5",
+		}
+		for name, value := range want {
+			got, ok := queryValue(r.URL.Query(), name)
+			if !ok || got != value {
+				t.Errorf("list request: query parameter %q: want %q, got %q (present: %v)", name, value, got, ok)
+			}
+		}
+
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte(testdata.ListInvoicesResponse))
+	})
+
+	options := &ListInvoiceOptions{
+		Reference: "2016.10000",
+		Year:      "2016",
+		From:      10,
+		Limit:     5,
+	}
+
+	res, err := tClient.Invoices.List(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if res.Count == 0 {
+		t.Errorf("mismatching info. want non-zero count, got %v", res.Count)
+	}
+
+	if len(res.Embedded.Invoices) == 0 {
+		t.Fatal("expected at least one invoice in the list")
+	}
+	if res.Embedded.Invoices[0].Reference != "2016.10000" {
+		t.Errorf("mismatching info. want %v, got %v", "2016.10000", res.Embedded.Invoices[0].Reference)
+	}
+}
+
+func TestInvoicesService_ListWithoutOptionsSendsNoFilters(t *testing.T) {
+	setup()
+	defer teardown()
+	_ = tClient.WithAuthenticationValue("test_token")
+	tMux.HandleFunc("/v2/invoices", func(w http.ResponseWriter, r *http.Request) {
+		testMethod(t, r, "GET")
+		for _, name := range []string{"reference", "year", "from", "limit"} {
+			if got, ok := queryValue(r.URL.Query(), name); ok {
+				t.Errorf("unfiltered list request: unexpected query parameter %q=%q", name, got)
+			}
+		}
+
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte(testdata.ListInvoicesResponse))
+	})
+
+	res, err := tClient.Invoices.List(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Count == 0 {
+		t.Errorf("mismatching info. want non-zero count, got %v", res.Count)
+	}
+}
