+func TestInternalDBResourcesRemainAvailable(t *testing.T) {
+	testData := path.Join("testdata", "db-statefulset.yaml")
+	manifest, err := mf.ManifestFrom(mf.Recursive(testData))
+	assert.NilError(t, err)
+
+	pipeline := &v1alpha1.TektonPipeline{ObjectMeta: metav1.ObjectMeta{Name: v1alpha1.PipelineResourceName}, Spec: v1alpha1.TektonPipelineSpec{CommonSpec: v1alpha1.CommonSpec{TargetNamespace: "tekton-pipelines"}}}
+	pipeline.Status.MarkPreReconcilerComplete()
+	pipeline.Status.MarkInstallerSetAvailable()
+	pipeline.Status.MarkInstallerSetReady()
+	pipeline.Status.MarkPostReconcilerComplete()
+	installerSet := &v1alpha1.TektonInstallerSet{
+		ObjectMeta: metav1.ObjectMeta{
+			Name: "results-existing",
+			Labels: map[string]string{
+				v1alpha1.CreatedByKey:     "TektonResult",
+				v1alpha1.InstallerSetType: v1alpha1.ResultResourceName,
+			},
+			Annotations: map[string]string{
+				v1alpha1.TargetNamespaceKey: "tekton-pipelines",
+				v1alpha1.LastAppliedHashKey: "old-spec-hash",
+			},
+		},
+	}
+	operatorClient := operatorfake.NewSimpleClientset(pipeline, installerSet)
+	pipelineInformers := informers.NewSharedInformerFactory(operatorClient, 0)
+	pipelineInformer := pipelineInformers.Operator().V1alpha1().TektonPipelines()
+	assert.NilError(t, pipelineInformer.Informer().GetIndexer().Add(pipeline))
+	kubeClient := kube.NewSimpleClientset(
+		&corev1.Secret{ObjectMeta: metav1.ObjectMeta{Name: DbSecretName, Namespace: "tekton-pipelines"}},
+		&corev1.Secret{ObjectMeta: metav1.ObjectMeta{Name: TlsSecretName, Namespace: "tekton-pipelines"}},
+	)
+	metricstest.Unregister("results_reconciled")
+	recorder, err := NewRecorder()
+	assert.NilError(t, err)
+	r := &Reconciler{
+		manifest:          manifest,
+		kubeClientSet:     kubeClient,
+		operatorClientSet: operatorClient,
+		pipelineInformer:  pipelineInformer,
+		extension:         common.NoExtension(context.Background()),
+		recorder:          recorder,
+	}
+	tr := &v1alpha1.TektonResult{
+		ObjectMeta: metav1.ObjectMeta{Name: v1alpha1.ResultResourceName},
+		Spec: v1alpha1.TektonResultSpec{
+			CommonSpec: v1alpha1.CommonSpec{TargetNamespace: "tekton-pipelines"},
+		},
+	}
+
+	_ = r.ReconcileKind(context.Background(), tr)
+	updated, err := operatorClient.OperatorV1alpha1().TektonInstallerSets().Get(context.Background(), installerSet.Name, metav1.GetOptions{})
+	assert.NilError(t, err)
+
+	resources := map[string]map[string]bool{}
+	for _, resource := range updated.Spec.Manifests {
+		if resources[resource.GetKind()] == nil {
+			resources[resource.GetKind()] = map[string]bool{}
+		}
+		resources[resource.GetKind()][resource.GetName()] = true
+	}
+	assert.Assert(t, resources["ConfigMap"]["tekton-results-postgres"], "the internal Results DB ConfigMap must remain available for reconciliation")
+	assert.Assert(t, resources["Service"]["tekton-results-postgres-service"], "the internal Results DB Service must remain available for reconciliation")
 }
