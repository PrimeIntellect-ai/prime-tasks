+import unittest
+import copy
+from openmdao.core.constants import _UNDEFINED, _DEFAULT_OUT_STREAM
+
+
+class Foo(object):
+    def __init__(self):
+        self.bar = _UNDEFINED
+
+
+class ConstantsTestCase(unittest.TestCase):
+    def test_repr_deepcopy(self):
+        f = Foo()
+        cpf = copy.deepcopy(f)
+        self.assertTrue(cpf.bar is _UNDEFINED, "Constants don't match!")
+
+    def test_repr_deepcopy_default_out_stream(self):
+        f = Foo()
+        f.bar = _DEFAULT_OUT_STREAM
+        cpf = copy.deepcopy(f)
+        self.assertTrue(cpf.bar is _DEFAULT_OUT_STREAM, "Constants don't match!")
+
+    def test_repr_deepcopy_container(self):
+        container = {'undefined': _UNDEFINED, 'default': _DEFAULT_OUT_STREAM}
+        cp = copy.deepcopy(container)
+        self.assertTrue(cp['undefined'] is _UNDEFINED, "Constants don't match!")
+        self.assertTrue(cp['default'] is _DEFAULT_OUT_STREAM, "Constants don't match!")
