             INDENTATION,
             instring,
         )
+
+    @pytest.mark.unit
+    @pytest.mark.parametrize(
+        "args",
+        [
+            [
+                "--wrap-descriptions",
+                "120",
+                "--wrap-summaries",
+                "120",
+                "--pre-summary-newline",
+                "--black",
+                "",
+            ]
+        ],
+    )
+    def test_format_docstring_sphinx_style_recognize_yield(
+        self,
+        test_args,
+        args,
+    ):
+        """Should identify `yield` as sphinx field name.
+
+        See issue #253.
+        """
+        instring = self.TEST_STRINGS["issue_253"]["instring"]
+        source = "def example():\n    " + instring + "\n"
+        test_args.files = ["-"]
+        stdout = io.StringIO()
+        uut = Formatter(
+            test_args,
+            sys.stderr,
+            io.StringIO(source),
+            stdout,
+        )
+
+        uut.do_format_standard_in(argparse.ArgumentParser())
+
+        output_lines = [line.strip() for line in stdout.getvalue().splitlines()]
+        assert any(line.startswith(":param caplog:") for line in output_lines)
+        assert any(line.startswith(":yield:") for line in output_lines)
