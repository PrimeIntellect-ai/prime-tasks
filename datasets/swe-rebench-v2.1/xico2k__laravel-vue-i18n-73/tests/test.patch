+
+it('returns a reactive array from the $t mixin', async () => {
+  const wrapper = await global.mountPlugin(`<h1 v-for="line in $t('auth.arr')">{{line}}</h1>`, 'de');
+
+  expect(wrapper.html()).toBe("<h1>foo</h1>\n<h1>bar</h1>")
+
+  const lines = wrapper.vm.$t('auth.arr')
+  lines.push('baz')
+  await wrapper.vm.$nextTick()
+
+  expect(wrapper.html()).toBe("<h1>foo</h1>\n<h1>bar</h1>\n<h1>baz</h1>")
