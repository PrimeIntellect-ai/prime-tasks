diff --git a/tests/core/test_tap_class.py b/tests/core/test_tap_class.py
new file mode 100644
index 0000000..72e30c7
--- /dev/null
+++ b/tests/core/test_tap_class.py
@@ -0,0 +1,54 @@
+from __future__ import annotations
+
+import typing as t
+from contextlib import nullcontext
+
+import pytest
+
+from singer_sdk.exceptions import ConfigValidationError
+
+if t.TYPE_CHECKING:
+    from singer_sdk import Tap
+
+
+@pytest.mark.parametrize(
+    "config_dict,expectation",
+    [
+        pytest.param(
+            {},
+            pytest.raises(ConfigValidationError),
+            id="missing_username_and_password",
+        ),
+        pytest.param(
+            {"username": "utest"},
+            pytest.raises(ConfigValidationError),
+            id="missing_password",
+        ),
+        pytest.param(
+            {"username": "utest", "password": "ptest", "extra": "not valid"},
+            pytest.raises(ConfigValidationError),
+            id="extra_property",
+        ),
+        pytest.param(
+            {"username": "utest", "password": "ptest"},
+            nullcontext(),
+            id="valid_config",
+        ),
+    ],
+)
+def test_config_errors(
+    tap_class: type[Tap],
+    config_dict: dict,
+    expectation,
+):
+    with expectation:
+        tap_class(config=config_dict)
+
+
+def test_config_validation_fails_on_invalid_option(tap_class: type[Tap]):
+    """Reject an unexpected option during construction using default validation."""
+    with pytest.raises(ConfigValidationError):
+        tap_class(
+            config={"default_true": False, "option_not_in_schema": 1},
+            parse_env_config=True,
+        )
