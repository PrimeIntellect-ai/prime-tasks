+extern crate snafu;
+
+mod default_with_lifetime {
+    use snafu::{AsErrorSource, Snafu};
+    use std::fmt::{Debug, Display};
+
+    #[derive(Debug, Snafu)]
+    pub struct ApiError<'a, S, T>(Error<'a, S, T>)
+    where
+        T: Debug + Display,
+        S: std::error::Error + AsErrorSource;
+
+    #[derive(Debug, Snafu)]
+    enum Error<'a, S = std::io::Error, T = String>
+    where
+        T: Display,
+        S: std::error::Error + AsErrorSource,
+    {
+        #[snafu(display("Boom: {}", value))]
+        Boom {
+            value: T,
+            name: &'a str,
+        },
+        WithSource {
+            source: S,
+        },
+        Empty,
+    }
+
+    #[test]
+    fn implements_error() {
+        fn check_bounds<T: std::error::Error>() {}
+        check_bounds::<Error<std::io::Error>>();
+        check_bounds::<ApiError<std::io::Error, i32>>();
+    }
+
+    #[test]
+    fn forwards_source() {
+        let io_error = std::io::Error::new(std::io::ErrorKind::Other, "boom");
+        let error: Error<'_, std::io::Error> = Error::WithSource { source: io_error };
+
+        let source = std::error::Error::source(&error).expect("source should be present");
+        assert!(source.downcast_ref::<std::io::Error>().is_some());
+    }
+
+    #[test]
+    fn has_no_source_without_one() {
+        let error: Error<'_, std::io::Error> = Error::Empty;
+
+        assert!(std::error::Error::source(&error).is_none());
+    }
+
+    #[test]
+    fn displays_message() {
+        let error: Error<'_, std::io::Error> = Error::Boom {
+            value: "hello".to_string(),
+            name: "n",
+        };
+
+        assert_eq!(error.to_string(), "Boom: hello");
+    }
+
+    #[test]
+    fn api_error_forwards_source() {
+        let io_error = std::io::Error::new(std::io::ErrorKind::Other, "boom");
+        let inner: Error<'_, std::io::Error> = Error::WithSource { source: io_error };
+        let error: ApiError<'_, std::io::Error, String> = ApiError(inner);
+
+        let source = std::error::Error::source(&error).expect("source should be present");
+        assert!(source.downcast_ref::<std::io::Error>().is_some());
+    }
+
+    #[test]
+    fn api_error_displays_message() {
+        let inner: Error<'_, std::io::Error> = Error::Boom {
+            value: "hello".to_string(),
+            name: "n",
+        };
+        let error: ApiError<'_, std::io::Error, String> = ApiError(inner);
+
+        assert_eq!(error.to_string(), "Boom: hello");
+    }
+}
