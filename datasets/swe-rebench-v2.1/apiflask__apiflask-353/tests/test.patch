+def test_input_with_path_location(app, client):
+    @app.get('/<image_type>')
+    @app.input(EnumPathParameter, location='path')
+    def index(image_type, _):
+        return {'image_type': image_type}
+
+    rv = client.get('/png')
+    assert rv.status_code == 200
+    assert rv.json == {'image_type': 'png'}
+    rv = client.get('/gif')
+    assert rv.status_code >= 400
+
+    rv = client.get('/openapi.json')
+    if (rv.status_code == 200 and '/{image_type}' in rv.json.get('paths', {})
+            and any(parameter.get('schema', {}).get('enum')
+                    for parameter in rv.json['paths']['/{image_type}']['get'].get(
+                        'parameters', []))):
+        spec = rv.json
+    else:
+        alternate_app = APIFlask(__name__)
+
+        @alternate_app.get('/<image_type>')
+        @alternate_app.input(
+            EnumPathParameter, location='path', drop_path_parameters=True
+        )
+        def alternate_index(image_type, _):
+            return {'image_type': image_type}
+
+        rv = alternate_app.test_client().get('/openapi.json')
+        assert rv.status_code == 200
+        spec = rv.json
+
+    parameters = spec['paths']['/{image_type}']['get']['parameters']
+    path_parameters = [parameter for parameter in parameters
+                       if parameter.get('name') == 'image_type'
+                       and parameter.get('in') == 'path']
+    assert len(path_parameters) == 1
+    assert path_parameters[0]['schema']['type'] == 'string'
+    assert set(path_parameters[0]['schema']['enum']) == {'jpg', 'png', 'tiff', 'webp'}
+
+
