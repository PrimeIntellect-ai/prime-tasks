+func TestDefaultProcessorAllowsMultiLineAssignmentCuddling(t *testing.T) {
+	code := []byte(`package main
+
+		func main() {
+			err := SomeFunc(
+				"taking multiple values",
+				"suddenly not a single line",
+			)
+			if err != nil {
+				fmt.Println("accepted")
+			}
+		}`)
+	file, err := ioutil.TempFile("", "wsl-default-config-*.go")
+	require.NoError(t, err)
+	defer os.Remove(file.Name())
+	_, err = file.Write(code)
+	require.NoError(t, err)
+	require.NoError(t, file.Close())
+
+	results, _ := NewProcessor().ProcessFiles([]string{file.Name()})
+	assert.Empty(t, results, "the default processor permits cuddling this multiline assignment with its if")
+}
+
+func multiLineAssignmentConfig(allow bool) *Configuration {
+	config := &Configuration{}
+	field := reflect.ValueOf(config).Elem().FieldByName("AllowMultiLineAssignmentCuddled")
+	if field.IsValid() && field.CanSet() && field.Kind() == reflect.Bool {
+		field.SetBool(allow)
+	}
+	return config
+}
