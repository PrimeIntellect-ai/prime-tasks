+        # GH#60064
+        # Either the data is accepted as NaT followed by a 1ns timedelta, or
+        # it is rejected with an error that is not the low-level buffer error.
+        try:
+            result = DataFrame([None, 1], dtype="timedelta64[ns]")
+        except (TypeError, ValueError) as err:
+            assert "Buffer has wrong number of dimensions" not in str(err)
+            assert str(err)
+        else:
+            expected = DataFrame(
+                ["NaT", "0 days 00:00:00.000000001"], dtype="timedelta64[ns]"
