+      url: '/foo'
+    })
+    await done
+  })
+
+  test('ignoreFunc false allows logging even when legacy ignore rules match', async () => {
+    const server = getServer()
+    const logged = []
+    const stream = sink(data => {
+      logged.push(data)
+    })
+    const logger = require('pino')(stream)
+    const plugin = {
+      plugin: Pino,
+      options: {
+        instance: logger,
+        logEvents: ['response'],
+        ignorePaths: ['/something'],
+        ignoreTags: ['foo'],
+        ignoreFunc: (options, request) => false
+      }
+    }
+
+    await server.register(plugin)
+    await server.inject({
+      method: 'GET',
+      url: '/something'
+    })
+    await sleep(10)
+
+    expect(logged.some(data => data.req.url.endsWith('/something'))).to.be.true()
+  })
+
+  test('ignoreFunc receives the plugin options as its first argument', async () => {
+    const server = getServer()
+    let receivedOptions
+    let resolver
+    const done = new Promise((resolve, reject) => {
+      resolver = resolve
+    })
+    const stream = sink(() => {
+      resolver()
+    })
+    const logger = require('pino')(stream)
+    const plugin = {
+      plugin: Pino,
+      options: {
+        instance: logger,
+        ignoreFunc: (options, request) => {
+          receivedOptions = options
+          return false
+        }
+      }
+    }
+
+    await server.register(plugin)
+
+    await server.inject({
+      method: 'GET',
+      url: '/something'
+    })
+    await done
+
+    expect(receivedOptions).to.be.an.object()
+    expect(receivedOptions.instance).to.equal(logger)
+  })
+})
