+def make_recording_async_client():
+    try:
+        from slack_sdk.web.async_client import AsyncWebClient
+    except ModuleNotFoundError as error:
+        if error.name != "aiohttp":
+            raise
+        aiohttp_stub = types.ModuleType("aiohttp")
+        for name in ("BasicAuth", "ClientSession", "ClientTimeout", "ContentTypeError", "FormData"):
+            setattr(aiohttp_stub, name, type(name, (), {}))
+        for name in ("ServerDisconnectedError", "ServerConnectionError", "ClientOSError"):
+            setattr(aiohttp_stub, name, type(name, (Exception,), {}))
+        with patch.dict(sys.modules, {"aiohttp": aiohttp_stub}):
+            from slack_sdk.web.async_client import AsyncWebClient
+
+    class RecordingAsyncWebClient(AsyncWebClient):
+        def __init__(self):
+            super().__init__(token="xoxb-test")
+            self.requests = []
+
+        async def api_call(self, api_method, **kwargs):
+            self.requests.append((api_method, kwargs))
+            return None
+
+    return RecordingAsyncWebClient, AsyncWebClient
+
