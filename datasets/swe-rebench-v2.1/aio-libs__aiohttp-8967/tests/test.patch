+async def test_timeout_does_not_leave_resolve_host_pending() -> None:
+    class DelayedResolver(AbstractResolver):
+        def __init__(self) -> None:
+            self.started = asyncio.Event()
+            self.cancelled = asyncio.Event()
+
+        async def resolve(
+            self,
+            host: str,
+            port: int = 0,
+            family: socket.AddressFamily = socket.AF_INET,
+        ) -> List[ResolveResult]:
+            self.started.set()
+            try:
+                await asyncio.Event().wait()
+            except asyncio.CancelledError:
+                self.cancelled.set()
+                raise
+
+        async def close(self) -> None:
+            pass
+
+    resolver = DelayedResolver()
+    connector = aiohttp.TCPConnector(resolver=resolver)
+    timeout = ClientTimeout(connect=0.01)
+
+    async with ClientSession(connector=connector, timeout=timeout) as session:
+        request = asyncio.create_task(session.get("http://delayed-resolve.test/"))
+        await resolver.started.wait()
+        with pytest.raises(asyncio.TimeoutError):
+            await request
+
+    assert resolver.cancelled.is_set()
+
+
