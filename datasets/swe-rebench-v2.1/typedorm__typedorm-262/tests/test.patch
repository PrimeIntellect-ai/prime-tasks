+test('throws an error when attribute name conflicts with a primary key or sort key name of the table ', () => {
+  const mockTable = new Table({
+    name: 'admin-table',
+    partitionKey: 'id',
+  });
+  @Entity({
+    name: 'admin-test',
+    table: mockTable,
+    primaryKey: {
+      partitionKey: 'ADMIN#{{id}}',
+    },
+  })
+  class AdminTest {
+    @AutoGenerateAttribute({
+      strategy: AUTO_GENERATE_ATTRIBUTE_STRATEGY.KSUID,
+    })
+    id: string;
+  }
+
+  const buildMetadata = () =>
+    createTestConnection({
+      table: mockTable,
+      entities: [AdminTest],
+    }).buildMetadatas();
+  expect(buildMetadata).toThrow(ConflictingAttributeNameError);
+});
+
+test('throws an error when attribute name conflicts with the sort key name of the table', () => {
+  const mockTable = new Table({
+    name: 'admin-table',
+    partitionKey: 'id',
+    sortKey: 'sortKey',
+  });
+  @Entity({
+    name: 'admin-test',
+    table: mockTable,
+    primaryKey: {
+      partitionKey: 'ADMIN#{{pk}}',
+      sortKey: 'ADMIN#{{sk}}',
+    },
+  })
+  class AdminTest {
+    @Attribute()
+    pk: string;
+
+    @Attribute()
+    sk: string;
+
+    @Attribute()
+    sortKey: string;
+  }
+
+  const buildMetadata = () =>
+    createTestConnection({
+      table: mockTable,
+      entities: [AdminTest],
+    }).buildMetadatas();
+  expect(buildMetadata).toThrow(ConflictingAttributeNameError);
+});
+
+test('allows a key attribute name supplied through explicit alias syntax', () => {
+  const mockTable = new Table({
+    name: 'admin-table',
+    partitionKey: {alias: 'id'} as unknown as string,
+  });
+  @Entity({
+    name: 'admin-test',
+    table: mockTable,
+    primaryKey: {
+      partitionKey: 'ADMIN#{{id}}',
+    },
+  })
+  class AdminTest {
+    @Attribute()
+    id: string;
+  }
+
+  const [metadata] = createTestConnection({
+    table: mockTable,
+    entities: [AdminTest],
+  }).buildMetadatas();
+
+  expect(metadata.attributes.map(attribute => attribute.name)).toContain('id');
+});
