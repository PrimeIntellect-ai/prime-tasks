+test('conflicting attribute name error reports the conflicting attribute and table names', () => {
+  const mockTable = new Table({
+    name: 'admin-table',
+    partitionKey: 'conflictingName',
+  });
+  @Entity({
+    name: 'admin-test',
+    table: mockTable,
+    primaryKey: {
+      partitionKey: 'ADMIN#{{conflictingName}}',
+    },
+  })
+  class AdminTest {
+    @Attribute()
+    conflictingName: string;
+  }
+
+  let thrownError: any;
+  try {
+    createTestConnection({
+      table: mockTable,
+      entities: [AdminTest],
+    }).buildMetadatas();
+  } catch (err) {
+    thrownError = err;
+  }
+
+  expect(thrownError).toBeDefined();
+  expect(thrownError).toBeInstanceOf(ConflictingAttributeNameError);
+  expect(thrownError.name).toBe('ConflictingAttributeNameError');
+  expect(thrownError.message).toContain('conflictingName');
+  expect(thrownError.message).toContain('admin-table');
+});
+
+test('ConflictingAttributeNameError can be constructed with attribute, entity and table names', () => {
