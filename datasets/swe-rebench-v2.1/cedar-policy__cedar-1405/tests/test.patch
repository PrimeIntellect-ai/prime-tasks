+mod source_locations {
+    use cedar_policy_core::ast::Name;
+    use cedar_policy_core::extensions::Extensions;
+
+    use crate::json_schema;
+
+    /// The source locations attached to `EntityDecl`, `ActionDecl`, and
+    /// `TypeDecl` in the Cedar schema syntax should be propagated to the
+    /// corresponding structures in `json_schema` when the human syntax is
+    /// converted.
+    #[test]
+    fn decls_carry_source_locations() {
+        let src = r#"
+        namespace NS {
+            type S = String;
+            entity A;
+            entity B in A;
+            entity C in A { value: String };
+            type AA = A;
+            action Read, Write;
+            action List in Read appliesTo { principal: [A], resource: [B] };
+        }
+        "#;
+        let (schema, _) =
+            json_schema::Fragment::from_cedarschema_str(src, Extensions::all_available()).unwrap();
+        let ns = schema
+            .0
+            .get(&Some(Name::parse_unqualified_name("NS").unwrap()))
+            .expect("couldn't find namespace NS");
+
+        let entity_a = ns.entity_types.get(&"A".parse().unwrap()).expect("entity A");
+        let entity_b = ns.entity_types.get(&"B".parse().unwrap()).expect("entity B");
+        let entity_c = ns.entity_types.get(&"C".parse().unwrap()).expect("entity C");
+        let ctype_s = ns
+            .common_types
+            .get(&json_schema::CommonTypeId::new("S".parse().unwrap()).unwrap())
+            .expect("common type S");
+        let ctype_aa = ns
+            .common_types
+            .get(&json_schema::CommonTypeId::new("AA".parse().unwrap()).unwrap())
+            .expect("common type AA");
+        let action_read = ns.actions.get("Read").expect("action Read");
+        let action_write = ns.actions.get("Write").expect("action Write");
+        let action_list = ns.actions.get("List").expect("action List");
+
+        for (name, loc) in [
+            ("A", &entity_a.loc),
+            ("B", &entity_b.loc),
+            ("C", &entity_c.loc),
+            ("S", &ctype_s.loc),
+            ("AA", &ctype_aa.loc),
+            ("Read", &action_read.loc),
+            ("Write", &action_write.loc),
+            ("List", &action_list.loc),
+        ] {
+            let loc = loc
+                .as_ref()
+                .unwrap_or_else(|| panic!("missing source location for `{name}`"));
+            let snippet = loc
+                .snippet()
+                .unwrap_or_else(|| panic!("invalid source location for `{name}`"));
+            assert!(
+                snippet.contains(name),
+                "source location for `{name}` should point at its declaration, got {snippet:?}"
+            );
+        }
+    }
+}
