diff --git a/tests/integration/test_main.py b/tests/integration/test_main.py
index e711fb3..0d14a6c 100644
--- a/tests/integration/test_main.py
+++ b/tests/integration/test_main.py
@@ -406,3 +406,23 @@ The specified config file does not exist: missing.cfg
     out, err = capsys.readouterr()
     assert out == expected
     assert err == ""
+
+
+def test_format_option_help(capsys):
+    """Test that help displays list of available formatters."""
+    with pytest.raises(SystemExit):
+        cli.main(["--help"])
+
+    out, _ = capsys.readouterr()
+    lines = out.splitlines()
+    format_line = next(
+        i for i, line in enumerate(lines) if "--format" in line
+    )
+    format_help_lines = [lines[format_line]]
+    for line in lines[format_line + 1 :]:
+        if line.startswith("  -"):
+            break
+        format_help_lines.append(line)
+
+    format_help = "\n".join(format_help_lines)
+    assert "(default, pylint, quiet-filename, quiet-nothing)" in format_help
