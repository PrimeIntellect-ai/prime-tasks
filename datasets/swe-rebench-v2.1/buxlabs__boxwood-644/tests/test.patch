+test('i18n: translation error classes expose their type and message', async assert => {
+  const yamlError = new YAMLTranslationError('yaml parser diagnostic')
+  assert.deepEqual(yamlError.type, 'YAMLTranslationError')
+  assert.deepEqual(yamlError.message, 'yaml parser diagnostic')
+  assert.truthy(yamlError instanceof Error)
+
+  const jsonError = new JSONTranslationError('json parser diagnostic')
+  assert.deepEqual(jsonError.type, 'JSONTranslationError')
+  assert.deepEqual(jsonError.message, 'json parser diagnostic')
+  assert.truthy(jsonError instanceof Error)
+
+  const jsError = new JavaScriptTranslationError('js parser diagnostic')
+  assert.deepEqual(jsError.type, 'JavaScriptTranslationError')
+  assert.deepEqual(jsError.message, 'js parser diagnostic')
+  assert.truthy(jsError instanceof Error)
+})
+
+test('i18n: throws if the data tag in yaml format has invalid format', async assert => {
+  const { errors } = await compile(`
+    <data yaml>
+    i18n:
+      foo:
+        pl: bar
+        en:baz
+    </data>
+  `)
+  assert.deepEqual(errors[0].type, 'YAMLTranslationError')
+  assert.truthy(errors[0].message)
+})
+
+test('i18n: throws if the data tag in yaml format has invalid characters', async assert => {
+  const { errors } = await compile(`
+    <data yaml>
+    i18n:
+      foo:
+        pl: bar
+        en: baz:
+    </data>
+  `)
