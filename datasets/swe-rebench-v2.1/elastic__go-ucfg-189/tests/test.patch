+func TestEmptyUntypedArrayYAMLRoundTrip(t *testing.T) {
+	c := mustNewConfig(t, `a: []`)
+	output := map[string]interface{}{}
+	mustUnpack(t, c, &output)
+
+	encoded, err := yamlv2.Marshal(output)
+	require.NoError(t, err)
+	var roundTripped map[string]interface{}
+	require.NoError(t, yamlv2.Unmarshal(encoded, &roundTripped))
+	array, ok := roundTripped["a"]
+	require.True(t, ok, "the array key should remain present")
+	value := reflect.ValueOf(array)
+	require.True(t, value.IsValid() && (value.Kind() == reflect.Slice || value.Kind() == reflect.Array), "the YAML value should remain an array, got %#v", array)
+	assert.False(t, value.Kind() == reflect.Slice && value.IsNil(), "the empty YAML array should not become null")
+	assert.Zero(t, value.Len())
+}
+
+// equalIgnoringEmptySliceType compares unpacked values without prescribing the
+// Go slice type used to represent an empty YAML sequence. A nil slice remains
+// distinct from a non-nil empty sequence.
+func equalIgnoringEmptySliceType(want, got reflect.Value) bool {
+	if !want.IsValid() || !got.IsValid() {
+		return want.IsValid() == got.IsValid()
+	}
+	for want.Kind() == reflect.Interface || want.Kind() == reflect.Ptr {
+		if want.IsNil() {
+			return got.Kind() == want.Kind() && got.IsNil()
+		}
+		want = want.Elem()
+	}
+	for got.Kind() == reflect.Interface || got.Kind() == reflect.Ptr {
+		if got.IsNil() {
+			return false
+		}
+		got = got.Elem()
+	}
+	if want.Kind() != got.Kind() {
+		return false
+	}
+	switch want.Kind() {
+	case reflect.Slice, reflect.Array:
+		if want.Kind() == reflect.Slice && (want.IsNil() != got.IsNil()) {
+			return false
+		}
+		if want.Len() != got.Len() {
+			return false
+		}
+		if want.Len() == 0 {
+			return true
+		}
+		if want.Type() != got.Type() {
+			return false
+		}
+		for i := 0; i < want.Len(); i++ {
+			if !equalIgnoringEmptySliceType(want.Index(i), got.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Map:
+		if want.Type() != got.Type() || want.Len() != got.Len() {
+			return false
+		}
+		if want.IsNil() || got.IsNil() {
+			return want.IsNil() == got.IsNil()
+		}
+		iter := want.MapRange()
+		for iter.Next() {
+			value := got.MapIndex(iter.Key())
+			if !value.IsValid() || !equalIgnoringEmptySliceType(iter.Value(), value) {
+				return false
+			}
+		}
+		return true
+	case reflect.Struct:
+		if want.Type() != got.Type() {
+			return false
+		}
+		for i := 0; i < want.NumField(); i++ {
+			if !equalIgnoringEmptySliceType(want.Field(i), got.Field(i)) {
+				return false
+			}
+		}
+		return true
+	default:
+		return reflect.DeepEqual(want.Interface(), got.Interface())
+	}
+}
