+def test_pop_ast_interface():
+    from pyccel.ast.builtin_methods.list_methods import ListPop
+    from pyccel.ast.variable import Variable
+    from pyccel.ast.datatypes import NativeHomogeneousList, NativeInteger, NativeComplex
+    from pyccel.ast.class_defs import get_cls_base
+    from pyccel.ast.literals import LiteralInteger
+
+    def make_list_variable(dtype, name):
+        return Variable(dtype, name,
+                        class_type=NativeHomogeneousList(),
+                        rank=1, memory_handling='heap',
+                        cls_base=get_cls_base(dtype, -1, NativeHomogeneousList()))
+
+    int_list = make_list_variable(NativeInteger(), 'a')
+
+    pop = ListPop(int_list)
+    assert pop.list_variable is int_list
+    assert pop.pop_index is None
+    assert pop.dtype == int_list.dtype
+    assert pop.precision == int_list.precision
+
+    index = LiteralInteger(1)
+    pop_indexed = ListPop(int_list, index)
+    assert pop_indexed.list_variable is int_list
+    assert pop_indexed.pop_index is index
+
+    complex_list = make_list_variable(NativeComplex(), 'b')
+    pop_complex = ListPop(complex_list)
+    assert pop_complex.dtype == complex_list.dtype
+    assert pop_complex.precision == complex_list.precision
+
+    with pytest.raises(AttributeError):
+        pop.pop_index = index
+    with pytest.raises(AttributeError):
+        pop.list_variable = int_list
