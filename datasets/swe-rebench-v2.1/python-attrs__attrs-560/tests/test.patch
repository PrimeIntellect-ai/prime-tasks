+class TestFilenames(object):
+    def test_init_filename_stable_across_processes(self):
+        """
+        The generated __init__ filename is deterministic across process
+        restarts, even when the attributes' repr is not (a lambda default
+        includes its id in its repr).
+        """
+        code = (
+            "import attr\n"
+            "@attr.s\n"
+            "class C(object):\n"
+            "    a = attr.ib(default=lambda: 1)\n"
+            "print(C.__init__.__code__.co_filename)\n"
+        )
+        filenames = set()
+        for _ in range(2):
+            out = subprocess.check_output([sys.executable, "-c", code])
+            filenames.add(out.decode("utf-8").strip())
+
+        assert 1 == len(filenames)
