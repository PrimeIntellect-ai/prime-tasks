+#[tokio::test]
+async fn object_statistics() {
+    let manager = Computer {};
+    let pool = Pool::<Computer>::builder(manager)
+        .max_size(1)
+        .build()
+        .unwrap();
+
+    // A freshly created object has never been recycled.
+    let obj = pool.get().await.unwrap();
+    let stats = Object::statistics(&obj);
+    assert_eq!(stats.recycle_count, 0);
+    assert!(stats.recycled.is_none());
+    let created = stats.created;
+    drop(obj);
+
+    // After the object has been returned to the pool and taken again it has
+    // been recycled exactly once and its creation time is unchanged.
+    let obj = pool.get().await.unwrap();
+    let stats = Object::statistics(&obj);
+    assert_eq!(stats.created, created);
+    assert_eq!(stats.recycle_count, 1);
+    assert!(stats.recycled.is_some());
+    drop(obj);
+
+    // A second recycle increments the recycle count again.
+    let obj = pool.get().await.unwrap();
+    let stats = Object::statistics(&obj);
+    assert_eq!(stats.created, created);
+    assert_eq!(stats.recycle_count, 2);
+    assert!(stats.recycled.is_some());
+}
+
+#[derive(Clone)]
+struct MetricsRecorder {
+    recorded: Arc<Mutex<Vec<(std::time::Instant, usize)>>>,
+}
+
+#[async_trait]
+impl PostRecycle<Computer> for MetricsRecorder {
+    async fn post_recycle(&self, _: &mut usize, metrics: &Metrics) -> Result<(), HookError<()>> {
+        self.recorded
+            .lock()
+            .unwrap()
+            .push((metrics.created, metrics.recycle_count));
+        Ok(())
+    }
+}
+
+#[tokio::test]
+async fn post_recycle_receives_object_metrics() {
+    let recorded = Arc::new(Mutex::new(Vec::new()));
+    let manager = Computer {};
+    let pool = Pool::<Computer>::builder(manager)
+        .max_size(1)
+        .post_recycle(MetricsRecorder {
+            recorded: recorded.clone(),
+        })
+        .build()
+        .unwrap();
+
+    // The first retrieval creates the object and does not run the hook.
+    let obj = pool.get().await.unwrap();
+    let created = Object::statistics(&obj).created;
+    drop(obj);
+
+    // The second retrieval recycles the object and runs the hook once.
+    let obj = pool.get().await.unwrap();
+    let stats = Object::statistics(&obj);
+    drop(obj);
+
+    let recorded = recorded.lock().unwrap();
+    assert_eq!(recorded.len(), 1);
+    // The metrics handed to the hook describe the same object lifecycle as
+    // the metrics reported by the object itself.
+    assert_eq!(recorded[0].0, created);
+    assert_eq!(recorded[0].0, stats.created);
+    assert!(recorded[0].1 <= stats.recycle_count);
+}
