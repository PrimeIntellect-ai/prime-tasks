+func TestWampFloat64ConversionEdges(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		input interface{}
+		want  float64
+	}{
+		{name: "fractional float64", input: float64(12.75), want: 12.75},
+		{name: "fractional float32", input: float32(12.75), want: float64(float32(12.75))},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, ok := AsFloat64(tc.input)
+			if !ok || got != tc.want {
+				t.Fatalf("AsFloat64(%v) = (%v, %v), want (%v, true)", tc.input, got, ok, tc.want)
+			}
+		})
+	}
+
+	for _, input := range []interface{}{true, "12.75", nil} {
+		if _, ok := AsFloat64(input); ok {
+			t.Errorf("AsFloat64(%#v) unexpectedly succeeded", input)
+		}
+	}
 }
 
