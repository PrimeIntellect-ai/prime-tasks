+package aat
+
+import (
+	"sync"
+	"testing"
+
+	"github.com/gammazero/nexus/client"
+	"github.com/gammazero/nexus/wamp"
+)
+
+const benchMsgCount = 5
+
+func BenchmarkPub2Sub(b *testing.B) {
+	benchPubSub(2, b)
+}
+
+func BenchmarkPub4Sub(b *testing.B) {
