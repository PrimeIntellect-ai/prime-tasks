+def test_nonreentrant_keys_have_distinct_reusable_storage_slots():
+    code = """
+value: uint256
+
+@external
+@nonreentrant("first")
+def first_function():
+    pass
+
+@external
+@nonreentrant("second")
+def second_function():
+    pass
+
+@external
+@nonreentrant("first")
+def another_first_function():
+    pass
+    """
+
+    layout = compiler.compile_code(code, output_formats=["layout"])["layout"]["storage_layout"]
+    first_slot = layout["nonreentrant.first"]["slot"]
+    second_slot = layout["nonreentrant.second"]["slot"]
+    assert first_slot == 0
+    assert second_slot == 1
+    assert first_slot != second_slot
+    assert layout["value"]["slot"] == 2
