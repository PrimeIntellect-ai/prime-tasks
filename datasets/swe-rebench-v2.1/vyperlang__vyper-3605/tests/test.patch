+def test_validate_identifier_ast_node_annotation():
+    source = "@external\ndef foo():\n    pass\n"
+    module = vy_ast.parse_to_ast(source)
+    node = module.body[0]
+
+    with pytest.raises(StructureException) as exc_info:
+        validate_identifier("123abc", node)
+
+    # the provided node enriches the error with source-location information
+    assert "def foo()" in str(exc_info.value)
