+func TestCascadeBuildWithTargetOnlyMatcher(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+[cascade]
+title = "Site cascade title"
+[cascade._target]
+kind = "page"
+-- content/_index.md --
+---
+title: Home
+cascade:
+  _target:
+    kind: page
+---
+-- content/page.md --
+Page content.
+-- layouts/_default/single.html --
+{{ .Title }}
+`
+
+	hugolib.Test(t, files)
+}
