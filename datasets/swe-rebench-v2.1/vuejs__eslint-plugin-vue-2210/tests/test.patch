+/**
+ * @author ItMaga <https://github.com/ItMaga>
+ * See LICENSE file in root directory for full license.
+ */
+'use strict'
+
+const RuleTester = require('eslint').RuleTester
+const rule = require('../../../lib/rules/no-restricted-component-names')
+
+const tester = new RuleTester({
+  parser: require.resolve('vue-eslint-parser'),
+  parserOptions: {
+    ecmaVersion: 2020,
+    sourceType: 'module'
+  }
+})
+
+tester.run('no-restricted-component-names', rule, {
+  valid: [
+    {
+      filename: 'test.vue',
+      code: `
+      <script>
+      export default {
+        name: 'Allow'
+      }
+      `
+    },
+    {
+      filename: 'test.vue',
+      code: `
+      new Vue({
+        name: 'Allow',
+      })
+    `
+    },
+    {
+      filename: 'test.vue',
+      code: `
+      <script setup>
+      defineOptions({
+        name: 'Allow'
+      })
+      </script>
+      `
+    },
+    {
+      filename: 'test.vue',
+      code: `
+      <script>
+      export default {
+        name: 'Allow'
+      }
+      </script>
+      `,
+      options: ['Disallow']
+    },
+    {
+      filename: 'test.vue',
+      code: `
+      <script setup>
+      defineOptions({
+        name: 'Allow'
+      })
+      </script>
+      `,
+      options: ['Disallow', '/^Baz(One|Two)/']
+    },
+    {
+      filename: 'test.vue',
+      code: `
+      <script>
+      export default {
+        name: 'BazThree'
+      }
+      </script>
+      `,
+      options: ['/^Baz(One|Two)/']
+    }
+  ],
+  invalid: [
+    {
+      filename: 'test.vue',
+      code: `
+      <script>
+      export default {
+        name: 'Disallow'
+      }
+      </script>
+      `,
+      options: ['Disallow', 'Disallow2'],
+      errors: 1
+    },
+    {
+      filename: 'test.vue',
+      code: `
+      <script>
+      new Vue({
+        name: 'Disallow',
+      })
+      </script>
+      `,
+      options: ['Disallow'],
+      errors: 1
+    },
+    {
+      filename: 'test.vue',
+      code: `
+      <script setup>
+      defineOptions({
+        name: 'Disallow'
+      })
+      </script>
+      `,
+      options: ['Disallow'],
+      errors: 1
+    },
+    {
+      filename: 'test.vue',
+      code: `
+      <script setup>
+      defineOptions({
+        name: 'FooBar'
+      })
+      </script>
+      `,
+      options: ['/^Foo(Bar|Baz)/'],
+      errors: 1
+    },
+    {
+      filename: 'test.vue',
+      code: `
+      <script>
+      export default {
+        name: 'BazTwo'
+      }
+      </script>
+      `,
+      options: ['Foo', '/^Baz(One|Two)/'],
+      errors: 1
+    },
+    {
+      filename: 'test.vue',
+      code: `
+      <script>
+      export default {
+        name: 'Foo'
+      }
+      </script>
+      `,
+      options: ['Foo', '/^Baz(One|Two)/'],
+      errors: 1
+    }
+  ]
+})
