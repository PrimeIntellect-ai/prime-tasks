+func (c *MockEc2Client) DescribeSecurityGroupsPages(input *ec2.DescribeSecurityGroupsInput, callback func(*ec2.DescribeSecurityGroupsOutput, bool) bool) error {
+	page, err := c.DescribeSecurityGroups(input)
+	if err != nil {
+		return err
+	}
+	callback(page, false)
+	return nil
+}
+
+func (c *MockEc2Client) DescribeSubnetsPages(input *ec2.DescribeSubnetsInput, callback func(*ec2.DescribeSubnetsOutput, bool) bool) error {
+	page, err := c.DescribeSubnets(input)
+	if err != nil {
+		return err
+	}
+	callback(page, false)
+	return nil
+}
+
+func (c *MockEc2Client) DescribeSecurityGroups(input *ec2.DescribeSecurityGroupsInput) (*ec2.DescribeSecurityGroupsOutput, error) {
+	if c.DescribeSecurityGroupsErr != nil {
+		return nil, c.DescribeSecurityGroupsErr
+	}
+	groups := []*ec2.SecurityGroup{}
+	for _, g := range c.SecurityGroups {
+		if ec2ResourceMatchesFilters(aws.StringValue(g.VpcId), g.Tags, input.Filters) {
+			groups = append(groups, g)
+		}
+	}
+	return &ec2.DescribeSecurityGroupsOutput{SecurityGroups: groups}, nil
+}
+
+func (c *MockEc2Client) DescribeSubnets(input *ec2.DescribeSubnetsInput) (*ec2.DescribeSubnetsOutput, error) {
+	if c.DescribeSubnetsErr != nil {
+		return nil, c.DescribeSubnetsErr
+	}
+	subnets := []*ec2.Subnet{}
+	for _, s := range c.Subnets {
+		if ec2ResourceMatchesFilters(aws.StringValue(s.VpcId), s.Tags, input.Filters) {
+			subnets = append(subnets, s)
+		}
+	}
+	return &ec2.DescribeSubnetsOutput{Subnets: subnets}, nil
+}
+
+// ec2ResourceMatchesFilters emulates the server-side filtering a real EC2
+// endpoint performs, so that implementations which rely on the service to
+// apply the requested filters are exercised faithfully.
+func ec2ResourceMatchesFilters(vpcID string, tags []*ec2.Tag, filters []*ec2.Filter) bool {
+	for _, f := range filters {
+		name := aws.StringValue(f.Name)
+		values := []string{}
+		for _, v := range f.Values {
+			values = append(values, aws.StringValue(v))
+		}
+		switch {
+		case name == "vpc-id":
+			if !ec2StringInSlice(vpcID, values) {
+				return false
+			}
+		case strings.HasPrefix(name, "tag:"):
+			key := strings.TrimPrefix(name, "tag:")
+			value, ok := ec2TagValue(tags, key)
+			if !ok || !ec2StringInSlice(value, values) {
+				return false
+			}
+		case name == "tag-key":
+			found := false
+			for _, t := range tags {
+				if ec2StringInSlice(aws.StringValue(t.Key), values) {
+					found = true
+					break
+				}
+			}
+			if !found {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func ec2TagValue(tags []*ec2.Tag, key string) (string, bool) {
+	for _, t := range tags {
+		if strings.EqualFold(aws.StringValue(t.Key), key) {
+			return aws.StringValue(t.Value), true
+		}
+	}
+	return "", false
+}
+
+func ec2StringInSlice(s string, values []string) bool {
+	for _, v := range values {
+		if v == s {
+			return true
+		}
+	}
+	return false
+}
