+
+  it("disable a selected rule in template expressions but keep it in script blocks", async () => {
+    const code = `
+    {a}
+    <script>
+      a;
+    </script>
+    {a}
+    `
+
+    const linter = new eslint.ESLint({
+      plugins: {
+        svelte: plugin as never,
+      },
+      baseConfig: {
+        parser: require.resolve("svelte-eslint-parser"),
+        parserOptions: {
+          ecmaVersion: 2020,
+        },
+        plugins: ["svelte"],
+        rules: {
+          "no-undef": "error",
+          "svelte/system": "error",
+        },
+        settings: {
+          svelte: {
+            ignoreWarnings: ["no-undef"],
+          },
+        },
+      },
+      useEslintrc: false,
+    })
+    const result = await linter.lintText(code, { filePath: "test.svelte" })
+    const messages = result[0].messages
+
+    assert.deepStrictEqual(
+      messages.map((m) => ({ ruleId: m.ruleId, line: m.line })),
+      [
+        {
+          ruleId: "no-undef",
+          line: 4,
+        },
+      ],
+    )
+  })
