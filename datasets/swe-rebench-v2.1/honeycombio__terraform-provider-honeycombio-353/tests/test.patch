+package provider
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/hashicorp/terraform-plugin-framework/providerserver"
+	"github.com/hashicorp/terraform-plugin-go/tfprotov5"
+	"github.com/hashicorp/terraform-plugin-go/tftypes"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAuthMetadataDataSourceBehavior(t *testing.T) {
+	permissions := `"api_key_access": {
+"boards": true,
+"columns": false,
+"create_datasets": true,
+"events": false,
+"markers": true,
+"queries": false,
+"recipients": true,
+"slos": false,
+"triggers": true
+}`
+
+	for _, scenario := range []struct {
+		name        string
+		environment string
+		classic     bool
+	}{
+		{
+			name:        "scoped environment",
+			environment: `"environment": {"name": "Production", "slug": "prod"}`,
+			classic:     false,
+		},
+		{
+			name:        "classic environment",
+			environment: `"environment": {"name": "", "slug": ""}`,
+			classic:     true,
+		},
+	} {
+		t.Run(scenario.name, func(t *testing.T) {
+			body := fmt.Sprintf(`{%s, %s, "team": {"name": "Acme", "slug": "acme"}}`, permissions, scenario.environment)
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method != http.MethodGet || r.URL.Path != "/1/auth" {
+					http.NotFound(w, r)
+					return
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = fmt.Fprint(w, body)
+			}))
+			defer server.Close()
+
+			protocolProvider, err := providerserver.NewProtocol5WithError(New("test"))()
+			require.NoError(t, err)
+			ctx := context.Background()
+
+			schemaResponse, err := protocolProvider.GetProviderSchema(ctx, &tfprotov5.GetProviderSchemaRequest{})
+			require.NoError(t, err)
+			dataSourceSchema, registered := schemaResponse.DataSourceSchemas["honeycombio_auth_metadata"]
+			require.True(t, registered, "the named auth metadata data source must be registered")
+
+			providerConfigType := schemaResponse.Provider.ValueType().(tftypes.Object)
+			providerConfigValues := make(map[string]tftypes.Value, len(providerConfigType.AttributeTypes))
+			for name, valueType := range providerConfigType.AttributeTypes {
+				switch name {
+				case "api_key":
+					providerConfigValues[name] = tftypes.NewValue(valueType, "test-key")
+				case "api_url":
+					providerConfigValues[name] = tftypes.NewValue(valueType, server.URL)
+				default:
+					providerConfigValues[name] = tftypes.NewValue(valueType, nil)
+				}
+			}
+			providerConfig, err := tfprotov5.NewDynamicValue(schemaResponse.Provider.ValueType(), tftypes.NewValue(schemaResponse.Provider.ValueType(), providerConfigValues))
+			require.NoError(t, err)
+			configureResponse, err := protocolProvider.ConfigureProvider(ctx, &tfprotov5.ConfigureProviderRequest{
+				TerraformVersion: "test",
+				Config:           &providerConfig,
+			})
+			require.NoError(t, err)
+			require.Empty(t, configureResponse.Diagnostics)
+
+			dataSourceType := dataSourceSchema.ValueType().(tftypes.Object)
+			noArgumentValues := make(map[string]tftypes.Value, len(dataSourceType.AttributeTypes))
+			for name, valueType := range dataSourceType.AttributeTypes {
+				noArgumentValues[name] = tftypes.NewValue(valueType, nil)
+			}
+			noArgumentConfig := tftypes.NewValue(dataSourceType, noArgumentValues)
+			config, err := tfprotov5.NewDynamicValue(dataSourceType, noArgumentConfig)
+			require.NoError(t, err)
+			validationResponse, err := protocolProvider.ValidateDataSourceConfig(ctx, &tfprotov5.ValidateDataSourceConfigRequest{
+				TypeName: "honeycombio_auth_metadata",
+				Config:   &config,
+			})
+			require.NoError(t, err)
+			require.Empty(t, validationResponse.Diagnostics, "an empty data-source configuration must be valid")
+			readResponse, err := protocolProvider.ReadDataSource(ctx, &tfprotov5.ReadDataSourceRequest{
+				TypeName: "honeycombio_auth_metadata",
+				Config:   &config,
+			})
+			require.NoError(t, err)
+			require.Empty(t, readResponse.Diagnostics)
+
+			state, err := readResponse.State.Unmarshal(dataSourceSchema.ValueType())
+			require.NoError(t, err)
+			var stateValues map[string]tftypes.Value
+			require.NoError(t, state.As(&stateValues))
+			team := objectAttributes(t, stateValues["team"])
+			requireStringValue(t, team["name"], "Acme")
+			requireStringValue(t, team["slug"], "acme")
+
+			environment := objectAttributes(t, stateValues["environment"])
+			requireBoolValue(t, environment["classic"], scenario.classic)
+			if scenario.classic {
+				require.True(t, environment["name"].IsNull())
+				require.True(t, environment["slug"].IsNull())
+			} else {
+				requireStringValue(t, environment["name"], "Production")
+				requireStringValue(t, environment["slug"], "prod")
+			}
+
+			apiKeyAccess := objectAttributes(t, stateValues["api_key_access"])
+			for name, expected := range map[string]bool{
+				"boards": true, "columns": false, "datasets": true,
+				"events": false, "markers": true, "queries": false,
+				"recipients": true, "slos": false, "triggers": true,
+			} {
+				requireBoolValue(t, apiKeyAccess[name], expected)
+			}
+		})
+	}
+}
+
+func objectAttributes(t *testing.T, value tftypes.Value) map[string]tftypes.Value {
+	t.Helper()
+	var attributes map[string]tftypes.Value
+	require.NoError(t, value.As(&attributes))
+	return attributes
+}
+
+func requireStringValue(t *testing.T, value tftypes.Value, expected string) {
+	t.Helper()
+	var actual string
+	require.NoError(t, value.As(&actual))
+	require.Equal(t, expected, actual)
+}
+
+func requireBoolValue(t *testing.T, value tftypes.Value, expected bool) {
+	t.Helper()
+	var actual bool
+	require.NoError(t, value.As(&actual))
+	require.Equal(t, expected, actual)
+}
