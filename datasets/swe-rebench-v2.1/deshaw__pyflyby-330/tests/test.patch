+def test_tidy_imports_dunder_class(tmp_path):
+    source = dedent("""
+        class MyClass:
+            def get_class(self):
+                return __class__
+    """)
+    filename = tmp_path / "a.py"
+    filename.write_text(source)
+    tidy_imports = os.path.join(os.path.dirname(os.path.dirname(__file__)),
+                                "bin", "tidy-imports")
+    result = subprocess.run(
+        [sys.executable, tidy_imports, "--replace", str(filename)],
+        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+    assert result.returncode == 0
+    assert "undefined name '__class__'" not in result.stdout
+
+
+@pytest.mark.parametrize("source", [
+    "print(__class__)",
+    "class NotOk:\n    print(__class__)\n",
+])
+def test_tidy_imports_reports_unbound_dunder_class(tmp_path, source):
+    filename = tmp_path / "a.py"
+    filename.write_text(source)
+    tidy_imports = os.path.join(os.path.dirname(os.path.dirname(__file__)),
+                                "bin", "tidy-imports")
+    result = subprocess.run(
+        [sys.executable, tidy_imports, "--replace", str(filename)],
+        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+    assert "undefined name '__class__'" in result.stdout
