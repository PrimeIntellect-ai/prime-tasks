+
+
+describe('YAML Title Alias with a linked heading', () => {
+  it('stores the heading as an alias regardless of valid YAML quoting', () => {
+    const output = YamlTitleAlias.getRule().apply('[[Link1]]\n\n# [[Heading]]', {
+      aliasArrayStyle: NormalArrayFormats.MultiLine,
+    });
+    expect(output).toMatch(/- (?:'\[\[Heading\]\]'|"\[\[Heading\]\]"|\[\[Heading\]\])\n/);
+    expect(output).toMatch(/linter-yaml-title-alias: (?:'\[\[Heading\]\]'|"\[\[Heading\]\]"|\[\[Heading\]\])\n/);
+    expect(output).toContain('[[Link1]]\n\n# [[Heading]]');
+  });
+});
