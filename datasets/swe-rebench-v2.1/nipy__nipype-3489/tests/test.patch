+def test_compute_dvars_excludes_voxel_at_positive_variance_tol(tmp_path):
+    n_time = 20
+    data = np.empty((1, 1, 3, n_time), dtype=np.float32)
+    data[0, 0, 0] = np.arange(n_time, dtype=np.float32)
+    data[0, 0, 1] = 100.0 + 10.0 * np.arange(n_time, dtype=np.float32)
+    data[0, 0, 2] = 200.0 + 20.0 * np.arange(n_time, dtype=np.float32)
+
+    # This matches the robust spread used by compute_dvars for the first voxel.
+    at_threshold = data[0, 0, 0]
+    variance_tol = float(
+        (np.percentile(at_threshold, 75, method="lower")
+         - np.percentile(at_threshold, 25, method="lower"))
+        / 1.349
+    )
+    mask = np.ones((1, 1, 3), dtype=np.uint8)
+    mask_without_equal = mask.copy()
+    mask_without_equal[0, 0, 0] = 0
+
+    func_file = str(tmp_path / "func_at_threshold.nii")
+    mask_file = str(tmp_path / "mask_at_threshold.nii")
+    mask_without_equal_file = str(tmp_path / "mask_without_equal.nii")
+    nb.save(nb.Nifti1Image(data, np.eye(4)), func_file)
+    nb.save(nb.Nifti1Image(mask, np.eye(4)), mask_file)
+    nb.save(nb.Nifti1Image(mask_without_equal, np.eye(4)), mask_without_equal_file)
+
+    with patch.dict(sys.modules, _fake_nitime_modules()):
+        got = compute_dvars(
+            func_file,
+            mask_file,
+            remove_zerovariance=True,
+            intensity_normalization=0,
+            variance_tol=variance_tol,
+        )
+        expected = compute_dvars(
+            func_file,
+            mask_without_equal_file,
+            remove_zerovariance=True,
+            intensity_normalization=0,
+            variance_tol=variance_tol,
+        )
+
+    for actual, reference in zip(got, expected):
+        assert np.allclose(actual, reference)
+
