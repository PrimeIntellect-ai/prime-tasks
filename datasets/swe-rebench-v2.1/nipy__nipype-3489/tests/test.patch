+def test_compute_dvars_variance_tol(tmp_path):
+    rng = np.random.RandomState(0)
+    n_time = 20
+    data = np.zeros((2, 2, 2, n_time), dtype=np.float32)
+    data[0, 0, 0, :] = 5.0  # exactly zero variance
+    data[0, 0, 1, :] = 5.0 + rng.randn(n_time) * 1e-6  # near-zero variance
+    data[0, 1, 0, :] = 5.0 + rng.randn(n_time) * 1.0
+    data[0, 1, 1, :] = 5.0 + rng.randn(n_time) * 1.0
+
+    mask = np.ones((2, 2, 2), dtype=np.uint8)
+    mask_without_small = mask.copy()
+    mask_without_small[0, 0, 1] = 0
+
+    func_file = str(tmp_path / "func.nii")
+    mask_file = str(tmp_path / "mask.nii")
+    mask_without_small_file = str(tmp_path / "mask_without_small.nii")
+    nb.save(nb.Nifti1Image(data, np.eye(4)), func_file)
+    nb.save(nb.Nifti1Image(mask, np.eye(4)), mask_file)
+    nb.save(nb.Nifti1Image(mask_without_small, np.eye(4)), mask_without_small_file)
+
+    with patch.dict(sys.modules, _fake_nitime_modules()):
+        keep_all = compute_dvars(
+            func_file,
+            mask_file,
+            remove_zerovariance=True,
+            intensity_normalization=0,
+            variance_tol=0.0,
+        )
+        drop_small = compute_dvars(
+            func_file,
+            mask_file,
+            remove_zerovariance=True,
+            intensity_normalization=0,
+            variance_tol=1e-3,
+        )
+        excluded = compute_dvars(
+            func_file,
+            mask_without_small_file,
+            remove_zerovariance=True,
+            intensity_normalization=0,
+            variance_tol=0.0,
+        )
+        default_tol = compute_dvars(
+            func_file,
+            mask_file,
+            remove_zerovariance=True,
+            intensity_normalization=0,
+        )
+
+    # A tolerance above the near-zero variance removes that voxel, matching a
+    # mask that excludes it entirely.
+    for got, expected in zip(drop_small, excluded):
+        assert np.allclose(got, expected)
+
+    # Retaining the near-zero-variance voxel changes the result.
+    assert not np.allclose(keep_all[1], drop_small[1])
+
+    # The default tolerance behaves like an explicit tolerance of 0.0.
+    for got, expected in zip(default_tol, keep_all):
+        assert np.allclose(got, expected)
+
