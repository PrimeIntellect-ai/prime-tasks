+/**
+ * @jest-environment jsdom
+ */
+import moment from 'moment';
+import * as fs from 'fs';
+import * as path from 'path';
+import { compile, preprocess } from 'svelte/compiler';
+import { tick } from 'svelte';
+import sveltePreprocess from 'svelte-preprocess';
+
+jest.mock('obsidian');
+window.moment = moment;
+
+/**
+ * Compile and load the Create/Edit Task modal so that its behaviour can be
+ * exercised the same way a user would experience it.
+ */
+async function loadEditTaskComponent(): Promise<any> {
+    const filename = path.resolve(__dirname, '../src/ui/EditTask.svelte');
+    const source = fs.readFileSync(filename, 'utf-8');
+    const preprocessed = await preprocess(source, sveltePreprocess(), {
+        filename,
+    });
+    const { js } = compile(preprocessed.code, {
+        generate: 'dom',
+        format: 'cjs',
+        filename,
+    });
+    const module = { exports: {} as any };
+    const componentRequire = (id: string) => {
+        if (id === 'chrono-node') {
+            return { default: require('chrono-node') };
+        }
+        if (id.startsWith('.')) {
+            return require(path.resolve(path.dirname(filename), id));
+        }
+        return require(id);
+    };
+    const fn = new Function(
+        'exports',
+        'require',
+        'module',
+        '__filename',
+        '__dirname',
+        js.code,
+    );
+    fn(
+        module.exports,
+        componentRequire,
+        module,
+        filename,
+        path.dirname(filename),
+    );
+    return module.exports.default;
+}
+
+describe('Create/Edit Task modal', () => {
+    it('recognises a capitalised date abbreviation typed into the due date field', async () => {
+        const EditTask = await loadEditTaskComponent();
+        const target = document.createElement('div');
+        new EditTask({
+            target,
+            props: {
+                task: {
+                    description: 'a task',
+                    status: 'Todo',
+                    priority: 'none',
+                    recurrence: null,
+                    startDate: null,
+                    scheduledDate: null,
+                    dueDate: null,
+                    doneDate: null,
+                },
+                onSubmit: () => {},
+            },
+        });
+
+        const dueInput = target.querySelector('#due') as HTMLInputElement;
+        dueInput.value = 'Td ';
+        dueInput.dispatchEvent(new Event('input'));
+        await tick();
+
+        const duePreview = dueInput.nextElementSibling as HTMLElement;
+        expect(duePreview.innerHTML).not.toContain('invalid');
+    });
+});
