+// Empty cases should report the concrete values that are missing.
+fn assert_empty_case_suggestions(source: &str, patterns: &[&str]) {
+    let errors = crate::type_::tests::compile_statement_sequence(source)
+        .expect_err("an empty case should be inexhaustive");
+    let output = crate::error::Error::Type {
+        src: source.into(),
+        path: camino::Utf8PathBuf::from("/src/one/two.gleam"),
+        errors,
+    }
+    .pretty_string();
+    let suggestions = output
+        .split_once("The missing patterns are:")
+        .expect("the error should explain which patterns are missing")
+        .1;
+
+    let mut remaining = suggestions;
+    for pattern in patterns {
+        let position = remaining
+            .find(pattern)
+            .unwrap_or_else(|| panic!("missing suggestion {pattern:?} in {suggestions:?}"));
+        remaining = &remaining[position + pattern.len()..];
+    }
+}
+
+#[test]
+fn empty_boolean_case_suggests_missing_patterns() {
+    assert_empty_case_suggestions("
+let b = True
+case b {}
+", &["False", "True"]);
+}
+
+#[test]
+fn empty_list_case_suggests_missing_patterns() {
+    assert_empty_case_suggestions("
+let list = []
+case list {}
+", &["[]", "[_, ..]"]);
+}
+
+#[test]
+fn empty_case_of_int() {
+    let source = "
+let num = 24
+case num {}
+";
+    assert!(crate::type_::tests::compile_statement_sequence(source).is_err());
+}
+
+#[test]
