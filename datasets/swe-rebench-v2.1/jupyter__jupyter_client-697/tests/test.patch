+import asyncio
+
+import pytest
+
+from jupyter_client.utils import run_sync
+
+
+@pytest.fixture
+def loop():
+    loop = asyncio.new_event_loop()
+    asyncio.set_event_loop(loop)
+    return loop
+
+
+def test_run_sync_runs_coroutine_synchronously(loop):
+    async def coro():
+        return 42
+
+    assert run_sync(coro)() == 42
+
+
+def _run_interrupted(loop, exc_type):
+    """Run a coroutine that is interrupted while awaiting.
+
+    Returns the list of cancellation observations made by the coroutine.
+    """
+    cancelled = []
+
+    async def coro():
+        loop.call_soon(_raise)
+        try:
+            await asyncio.sleep(10)
+        except asyncio.CancelledError:
+            cancelled.append(True)
+            raise
+
+    def _raise():
+        raise exc_type
+
+    with pytest.raises(exc_type):
+        run_sync(coro)()
+    # Let the event loop deliver the cancellation requested by run_sync.
+    loop.run_until_complete(asyncio.sleep(0))
+    return cancelled
+
+
+def test_run_sync_cancels_pending_task_on_keyboard_interrupt(loop):
+    assert _run_interrupted(loop, KeyboardInterrupt) == [True]
+
+
+def test_run_sync_cancels_pending_task_on_base_exception(loop):
+    assert _run_interrupted(loop, SystemExit) == [True]
