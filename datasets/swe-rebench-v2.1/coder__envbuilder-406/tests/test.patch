+func TestExplicitWorkspaceFolderRemainsFinal(t *testing.T) {
+	t.Parallel()
+
+	const finalFolder = "/home/coder"
+	o := options.Options{
+		GitURL:          "https://github.com/coder/envbuilder.git",
+		WorkspaceFolder: finalFolder,
+	}
+	o.SetDefaults()
+
+	require.Equal(t, finalFolder, o.WorkspaceFolder)
+}
+
+func TestExplicitWorkspaceFolderWithCustomParentRemainsFinal(t *testing.T) {
+	t.Parallel()
+
+	const finalFolder = "/home/coder"
+	o := options.Options{GitURL: "https://github.com/coder/envbuilder.git"}
+	cmd := serpent.Command{
+		Options: o.CLI(),
+		Handler: func(inv *serpent.Invocation) error { return nil },
+	}
+	invocation := cmd.Invoke().WithOS()
+	invocation.Args = []string{"--workspace-base-dir", "/custom-parent", "--workspace-folder", finalFolder}
+	fakeIO(invocation)
+	require.NoError(t, invocation.Run())
+
+	o.SetDefaults()
+	require.Equal(t, finalFolder, o.WorkspaceFolder)
+}
+
+// TestWorkspaceParentConfigurable verifies that a user can choose a parent
+// directory and still get a repository-name subdirectory by default.
+func TestWorkspaceParentConfigurable(t *testing.T) {
+	const repoURL = "https://github.com/coder/envbuilder.git"
+	const parent = "/custom-parent"
+	o := options.Options{GitURL: repoURL}
+	cmd := serpent.Command{
+		Options: o.CLI(),
+		Handler: func(inv *serpent.Invocation) error { return nil },
+	}
+	invocation := cmd.Invoke().WithOS()
+	invocation.Args = []string{"--workspace-base-dir", parent}
+	fakeIO(invocation)
+	require.NoError(t, invocation.Run())
+
+	o.SetDefaults()
+	require.Equal(t, parent+"/envbuilder", o.WorkspaceFolder)
+}
+
+func TestWorkspaceParentAppliesToEmptyFallback(t *testing.T) {
+	for _, repoURL := range []string{"", "not a valid URL"} {
+		t.Run(repoURL, func(t *testing.T) {
+			const parent = "/custom-parent"
+			o := options.Options{GitURL: repoURL}
+			cmd := serpent.Command{
+				Options: o.CLI(),
+				Handler: func(inv *serpent.Invocation) error { return nil },
+			}
+			invocation := cmd.Invoke().WithOS()
+			invocation.Args = []string{"--workspace-base-dir", parent}
+			fakeIO(invocation)
+			require.NoError(t, invocation.Run())
+
+			o.SetDefaults()
+			require.Equal(t, parent+"/empty", o.WorkspaceFolder)
+		})
+	}
 }
