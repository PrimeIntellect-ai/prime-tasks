+describe('getParsedSpec with an unparseable spec', () => {
+  it('does not throw when the spec cannot be dereferenced', () => {
+    // A spec whose $ref cannot be resolved makes the underlying parser throw.
+    // The contract requires getParsedSpec() to handle this gracefully and fall
+    // back to the original (unparsed) schema instead of propagating the error.
+    const brokenSpec = {
+      openapi: '3.0.0',
+      info: { title: 'Broken', version: '1.0.0' },
+      paths: {},
+      components: {
+        schemas: {
+          A: { $ref: '#/components/schemas/B/properties/x' },
+          B: { type: 'object' },
+        },
+      },
+    }
+
+    const openapi = OpenApi({ spec: brokenSpec })
+
+    let result: any
+    expect(() => {
+      result = openapi.getParsedSpec()
+    }).not.toThrow()
+    expect(result).toEqual(brokenSpec)
   })
