+// The public contract allows object schemas to be returned either as a
+// JavaScript object or as its JSON-string representation. Normalize both
+// shapes so the assertions check the specified value, not the encoding.
+function asJsonValue(result: any) {
+  if (typeof result === 'string') {
+    try {
+      return JSON.parse(result)
+    } catch {
+      return result
+    }
+  }
+  return result
+}
 
