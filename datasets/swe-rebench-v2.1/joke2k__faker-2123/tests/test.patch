+class TestGuIN(unittest.TestCase):
+    """Test `gu_IN` (Gujarati) provider for date_time"""
+
+    def setUp(self):
+        self.fake = Faker("gu_IN")
+        Faker.seed(0)
+
+    def test_day_in_guj(self):
+        days = {self.fake.day_of_week_in_guj() for _ in range(100)}
+        for day in days:
+            assert day
+            assert all(char == " " or "\u0a80" <= char <= "\u0aff" for char in day)
+
+    def test_month_name_in_guj(self):
+        months = {self.fake.month_name_in_guj() for _ in range(200)}
+        for month in months:
+            assert month
+            assert all(char == " " or "\u0a80" <= char <= "\u0aff" for char in month)
+
+    def test_month_in_guj(self):
+        self.fake.seed_instance(0)
+        month_name = self.fake.month_name()
+        self.fake.seed_instance(0)
+        month = self.fake.month_in_guj()
+        assert isinstance(month, str)
+        assert month
+        localized_in_script = all(char == " " or "\u0a80" <= char <= "\u0aff" for char in month)
+        assert localized_in_script or month == month_name
+
+
