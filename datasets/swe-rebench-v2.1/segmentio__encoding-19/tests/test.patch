+func TestGithubIssue18(t *testing.T) {
+	// https://github.com/segmentio/encoding/issues/18
+	b := []byte(`{
+	"userId": "blah",
+	}`)
+
+	d := NewDecoder(bytes.NewReader(b))
+
+	var a struct {
+		UserId string `json:"userId"`
+	}
+	decode := func(d *Decoder) error {
+		done := make(chan error, 1)
+		go func() { done <- d.Decode(&a) }()
+		select {
+		case err := <-done:
+			return err
+		case <-time.After(time.Second):
+			t.Fatal("decoder did not terminate")
+			return nil
+		}
+	}
+	if err := decode(d); err == nil {
+		t.Error("expected an error for malformed JSON")
+	}
+
+	for i := 1; i <= 18; i++ { // up to the invalid ',' character
+		d := NewDecoder(bytes.NewReader(b[:i])) // cut somewhere in the middle
+		if err := decode(d); err == nil {
+			t.Errorf("expected an error for incomplete JSON prefix of length %d", i)
+		}
+	}
+}
