+import createLifecycle from '../services/lifecycle/lifecycle.js'
+import { MeiliSearch } from '../__mocks__/meilisearch'
+import { createStrapiMock } from '../__mocks__/strapi'
+
+global.meiliSearch = MeiliSearch
+
+const strapiMock = createStrapiMock({})
+strapiMock.db.lifecycles = { subscribe: jest.fn() }
+global.strapi = strapiMock
+
+const meilisearchService = {
+  addEntriesToMeilisearch: jest.fn().mockResolvedValue(),
+  updateEntriesInMeilisearch: jest.fn().mockResolvedValue(),
+  entriesQuery: jest.fn(() => ({})),
+}
+
+const storeService = {
+  addListenedContentType: jest.fn(),
+}
+
+const contentTypeService = {
+  getContentTypeUid: ({ contentType }) => contentType,
+  getEntry: jest.fn(),
+}
+
+const forwardedToMeilisearch = ({ contentType, entryId }) =>
+  [
+    ...meilisearchService.addEntriesToMeilisearch.mock.calls,
+    ...meilisearchService.updateEntriesInMeilisearch.mock.calls,
+  ].some(
+    ([request]) =>
+      request.contentType === contentType &&
+      request.entries?.some(entry => entry.id === entryId),
+  )
+
+const originalPlugin = strapiMock.plugin
+strapiMock.plugin = jest.fn(pluginName => {
+  if (pluginName === 'meilisearch') {
+    return {
+      service: jest.fn(serviceName => {
+        if (serviceName === 'store') return storeService
+        if (serviceName === 'meilisearch') return meilisearchService
+        if (serviceName === 'contentType') return contentTypeService
+        return originalPlugin().service()
+      }),
+    }
+  }
+  return originalPlugin(pluginName)
+})
+
+describe('draft-and-publish lifecycle synchronization', () => {
+  let lifecycleHandler
+
+  beforeEach(() => {
+    jest.clearAllMocks()
+    meilisearchService.addEntriesToMeilisearch.mockResolvedValue()
+    meilisearchService.updateEntriesInMeilisearch.mockResolvedValue()
+    // A lookup performed in the completed lifecycle transaction reproduces the
+    // failure reported for draft-and-publish entries. Other lookup paths remain
+    // available to implementations that can fetch outside that transaction.
+    contentTypeService.getEntry.mockImplementation(({ entriesQuery } = {}) => {
+      if (entriesQuery) {
+        return Promise.reject(new Error('Transaction query already complete'))
+      }
+      return Promise.resolve({ id: '123', title: 'Fetched entry' })
+    })
+    strapiMock.contentTypes['api::restaurant.restaurant'].options.draftAndPublish =
+      true
+    lifecycleHandler = createLifecycle({ strapi: strapiMock })
+  })
+
+  test('synchronizes a created entry when draft-and-publish is enabled', async () => {
+    const contentType = 'api::restaurant.restaurant'
+    const result = { id: '123', documentId: 'doc-123', title: 'Created entry' }
+
+    await lifecycleHandler.subscribeContentType({ contentType })
+    const callbacks = strapiMock.db.lifecycles.subscribe.mock.calls[0][0]
+
+    await callbacks.afterCreate({ result })
+    expect(forwardedToMeilisearch({ contentType, entryId: result.id })).toBe(
+      true,
+    )
+  })
+
+  test('synchronizes an updated entry when draft-and-publish is enabled', async () => {
+    const contentType = 'api::restaurant.restaurant'
+    const result = { id: '123', documentId: 'doc-123', title: 'Updated entry' }
+
+    await lifecycleHandler.subscribeContentType({ contentType })
+    const callbacks = strapiMock.db.lifecycles.subscribe.mock.calls[0][0]
+
+    await callbacks.afterUpdate({ result })
+    expect(forwardedToMeilisearch({ contentType, entryId: result.id })).toBe(
+      true,
+    )
+  })
+})
