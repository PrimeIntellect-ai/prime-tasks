+#[test]
+fn test_feature_powerset_workspace_progress_is_aggregate() {
+    let output = cargo_hack()
+        .args(&["check", "--feature-powerset", "--workspace"])
+        .current_dir(test_dir("tests/fixtures/real"))
+        .output()
+        .unwrap();
+    output.assert_success();
+
+    let progress = output
+        .stderr()
+        .lines()
+        .filter_map(|line| {
+            if !line.contains("running `cargo check") {
+                return None;
+            }
+            let (_, diagnostic) = line.split_once(" on ")?;
+            let (_, fraction) = diagnostic.rsplit_once(" (")?;
+            let fraction = fraction.strip_suffix(')')?;
+            let (current, total) = fraction.split_once('/')?;
+            Some((current.parse::<usize>().ok()?, total.parse::<usize>().ok()?))
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(progress.len(), 36, "each selected run should have a progress diagnostic");
+    assert!(progress.iter().all(|(_, total)| *total == 36));
+    let mut current = progress.iter().map(|(current, _)| *current).collect::<Vec<_>>();
+    current.sort_unstable();
+    assert_eq!(current, (1..=36).collect::<Vec<_>>());
+}
