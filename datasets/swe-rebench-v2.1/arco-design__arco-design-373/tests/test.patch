@@ -325,4 +325,26 @@ describe('Select', () => {
 
     expect(wrapper.find('.arco-tag')).toHaveLength(2);
   });
+
+  it('User creating option will not affect original options', () => {
+    const value = 'Hello';
+    const onChange = jest.fn();
+    wrapper = mountSelect(
+      <Select
+        allowCreate
+        popupVisible
+        mode="multiple"
+        inputValue={value}
+        options={[{ value, label: value, disabled: true }]}
+        onChange={onChange}
+      />
+    );
+
+    wrapper
+      .find('.arco-select-option')
+      .filterWhere((option) => option.text() === value)
+      .forEach((option) => option.simulate('click'));
+
+    expect(onChange).not.toHaveBeenCalled();
+  });
 });
