+mod multiline_tabbed_range {
+    use super::*;
+
+    #[test]
+    fn underline_tracks_tab_on_final_line() {
+        let mut files = SimpleFiles::new();
+        let source = "first line\nx\tbefore target\nlast line";
+        let end = source.find("target").unwrap() + "target".len();
+        let file_id = files.add("tabbed range", source);
+        let data = TestData {
+            files,
+            diagnostics: vec![Diagnostic::warning()
+                .with_labels(vec![Label::primary(file_id, 0..end)])],
+        };
+
+        let output = data.emit_no_color(&TEST_CONFIG);
+        let source_row = output
+            .lines()
+            .find(|line| line.contains("x   before target"))
+            .unwrap();
+        let underline_row = output
+            .lines()
+            .find(|line| line.contains('╰'))
+            .unwrap();
+        let source_content = source_row.split_once('│').unwrap().1;
+        let underline_content = underline_row.split_once('│').unwrap().1;
+
+        let source_start = source_content.chars().position(|ch| ch == 'x').unwrap();
+        let target_end = source_start + "x   before target".chars().count();
+        let underline_start = underline_content.chars().position(|ch| ch == '╰').unwrap();
+        let underline_end = underline_content.chars().position(|ch| ch == '^').unwrap();
+
+        assert_eq!(underline_end - underline_start - 1, target_end - source_start);
+    }
+}
