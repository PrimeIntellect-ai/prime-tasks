+def test_select_column_using_boolean_expression_in_parenthesis():
+    sql = """INSERT OVERWRITE TABLE tab1
+SELECT (col1 > 0 AND col2 > 0) AS col3
+FROM tab2"""
+    assert_column_lineage_equal(
+        sql,
+        [
+            (
+                ColumnQualifierTuple("col1", "tab2"),
+                ColumnQualifierTuple("col3", "tab1"),
+            ),
+            (
+                ColumnQualifierTuple("col2", "tab2"),
+                ColumnQualifierTuple("col3", "tab1"),
+            ),
+        ],
+    )
+
+
+def test_select_column_using_timestamp_boolean_expression():
+    sql = """CREATE VIEW VIEW_B AS
+SELECT
+    (
+        FIRST_TIMESTAMP IS NOT NULL
+        AND FIRST_TIMESTAMP >= TO_TIMESTAMP(ADD_DAYS(CURRENT_DATE, -100))
+        AND OTHER_TIMESTAMP > TO_TIMESTAMP(ADD_YEARS(CURRENT_DATE, -7))
+    ) AS IS_QUALIFIED
+FROM TABLE_B"""
+    assert_column_lineage_equal(
+        sql,
+        [
+            (
+                ColumnQualifierTuple("FIRST_TIMESTAMP", "TABLE_B"),
+                ColumnQualifierTuple("IS_QUALIFIED", "VIEW_B"),
+            ),
+            (
+                ColumnQualifierTuple("OTHER_TIMESTAMP", "TABLE_B"),
+                ColumnQualifierTuple("IS_QUALIFIED", "VIEW_B"),
+            ),
+        ],
+    )
+
+
