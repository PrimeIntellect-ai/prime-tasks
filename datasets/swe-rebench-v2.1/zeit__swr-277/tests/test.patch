+describe('useSWR - default error retry behavior', () => {
+  afterEach(cleanup)
+
+  it('stops retrying after the configured error retry count', async () => {
+    let requests = 0
+    function Page() {
+      const { error } = useSWR(
+        'error-retry-limit',
+        () => {
+          requests++
+          return Promise.reject(new Error('failed'))
+        },
+        { errorRetryCount: 1, errorRetryInterval: 20, dedupingInterval: 0 }
+      )
+      return <div>{error ? error.message : 'loading'}</div>
+    }
+    const { container } = render(<Page />)
+
+    await waitForDomChange({ container })
+    await act(() => new Promise(resolve => setTimeout(resolve, 200)))
+    expect(requests).toBe(2)
+    await act(() => new Promise(resolve => setTimeout(resolve, 100)))
+    expect(requests).toBe(2)
+  })
+
+  it('increases the delay between error retries', async () => {
+    let requests = 0
+    function Page() {
+      const { error } = useSWR(
+        'error-retry-backoff',
+        () => {
+          requests++
+          return Promise.reject(new Error('failed'))
+        },
+        { errorRetryCount: 2, errorRetryInterval: 100, dedupingInterval: 0 }
+      )
+      return <div>{error ? error.message : 'loading'}</div>
+    }
+    const { container } = render(<Page />)
+
+    await waitForDomChange({ container })
+    await act(() => new Promise(resolve => setTimeout(resolve, 250)))
+    expect(requests).toBeLessThan(3)
+    await act(() => new Promise(resolve => setTimeout(resolve, 500)))
+    expect(requests).toBeGreaterThanOrEqual(3)
+  })
+
+  it('does not retry while the document is hidden', async () => {
+    const visibilityDescriptor = Object.getOwnPropertyDescriptor(
+      document,
+      'visibilityState'
+    )
+    Object.defineProperty(document, 'visibilityState', {
+      configurable: true,
+      value: 'hidden'
+    })
+    let requests = 0
+    function Page() {
+      const { error } = useSWR(
+        'error-retry-hidden',
+        () => {
+          requests++
+          return Promise.reject(new Error('failed'))
+        },
+        { errorRetryInterval: 20, dedupingInterval: 0 }
+      )
+      return <div>{error ? error.message : 'loading'}</div>
+    }
+
+    try {
+      const { container } = render(<Page />)
+      await waitForDomChange({ container })
+      await act(() => new Promise(resolve => setTimeout(resolve, 150)))
+      expect(requests).toBe(1)
+    } finally {
+      if (visibilityDescriptor) {
+        Object.defineProperty(
+          document,
+          'visibilityState',
+          visibilityDescriptor
+        )
+      } else {
+        Reflect.deleteProperty(document, 'visibilityState')
+      }
+    }
+  })
+})
+
