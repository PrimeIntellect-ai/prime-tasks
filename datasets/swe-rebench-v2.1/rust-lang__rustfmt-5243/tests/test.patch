 }
+
+#[test]
+fn mod_resolution_error_multiple_candidate_files() {
+    // See also https://github.com/rust-lang/rustfmt/issues/5167
+    let args = ["tests/mod-resolver/issue-5167/src/lib.rs"];
+    let (_stdout, stderr) = rustfmt(&args);
+    // The module `a` is ambiguous because both `a.rs` and `a/mod.rs` exist. The
+    // reported error must name both candidate files so the user can resolve the
+    // ambiguity, rather than claiming the module or its directory does not exist.
+    assert!(stderr.contains("a.rs"), "stderr: {}", stderr);
+    assert!(
+        stderr.contains("a/mod.rs") || stderr.contains("a\\mod.rs"),
+        "stderr: {}",
+        stderr
+    );
+    assert!(
+        !stderr.contains("does not exist"),
+        "an ambiguity must not be reported as a missing module or directory: {}",
+        stderr
+    );
+}
