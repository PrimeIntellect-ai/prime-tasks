+type singleResultCache struct {
+	result    et.VerifyResult
+	available bool
+	ready     chan struct{}
+}
+
+func (cache *singleResultCache) GetVerifyResult(ctx context.Context, subject string) (et.VerifyResult, bool) {
+	return cache.result, cache.available
+}
+
+func (cache *singleResultCache) SetVerifyResult(ctx context.Context, subject string, result et.VerifyResult, ttl time.Duration) {
+	cache.result = result
+	cache.available = true
+	close(cache.ready)
+}
+
+func TestTimedOutVerificationCanBeUsedBySubsequentRequest(t *testing.T) {
+	testDigest := digest.FromString("test")
+	store := &mocks.TestStore{
+		References: []ocispecs.ReferenceDescriptor{{ArtifactType: "test-type1"}},
+		ResolveMap: map[string]digest.Digest{"v1": testDigest},
+	}
+	requestStarted := false
+	ver := &TestVerifier{
+		CanVerifyFunc: func(artifactType string) bool { return artifactType == "test-type1" },
+		VerifyResult: func(artifactType string) bool {
+			if requestStarted {
+				return false
+			}
+			requestStarted = true
+			time.Sleep(25 * time.Millisecond)
+			return true
+		},
+	}
+	base := &Executor{
+		PolicyEnforcer: config.PolicyEnforcer{},
+		ReferrerStores: []referrerstore.ReferrerStore{store},
+		Verifiers:      []verifier.ReferenceVerifier{ver},
+	}
+	cache := &singleResultCache{ready: make(chan struct{})}
+	cached := ExecutorWithCache{
+		base:                   base,
+		verifierCache:          cache,
+		verfierCacheItemExpiry: time.Minute,
+	}
+	parameters := e.VerifyParameters{Subject: "localhost:5000/net-monitor:v1"}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Millisecond)
+	_, _ = cached.VerifySubject(ctx, parameters)
+	cancel()
+	select {
+	case <-cache.ready:
+	case <-time.After(time.Second):
+		t.Fatal("completed verification request was not made available from cache")
+	}
+
+	second, err := cached.VerifySubject(context.Background(), parameters)
+	if err != nil {
+		t.Fatalf("subsequent verification returned an error: %v", err)
+	}
+	if !second.IsSuccess {
+		t.Fatal("subsequent verification should succeed using the completed timed-out request")
+	}
+}
