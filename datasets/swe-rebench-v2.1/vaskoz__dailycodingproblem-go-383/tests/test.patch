@@ -0,0 +1,41 @@
+package day181
+
+import (
+	"reflect"
+	"testing"
+)
+
+var testcases = []struct {
+	input    string
+	expected []string
+}{
+	{"racecarannakayak", []string{"racecar", "anna", "kayak"}},
+	{"abc", []string{"a", "b", "c"}},
+	{"racecarracecar", []string{"racecarracecar"}},
+	{"a", []string{"a"}},
+	{"", nil},
+}
+
+func TestMinimumPartitionPalindrome(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		result := MinimumPartitionPalindrome(tc.input)
+		if tc.input == "" {
+			if len(result) != 0 {
+				t.Errorf("Expected no partition pieces for empty input, got %v", result)
+			}
+			continue
+		}
+		if !reflect.DeepEqual(result, tc.expected) {
+			t.Errorf("Expected %v, got %v", tc.expected, result)
+		}
+	}
+}
+
+func BenchmarkMinimumPartitionPalindrome(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			MinimumPartitionPalindrome(tc.input)
+		}
+	}
+}
