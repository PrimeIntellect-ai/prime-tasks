 //file:noinspection GrDeprecatedAPIUsage
 package io.jsonwebtoken.jackson.io
 
+import com.fasterxml.jackson.core.JsonParser
 import com.fasterxml.jackson.databind.ObjectMapper
 import io.jsonwebtoken.io.DeserializationException
 import io.jsonwebtoken.io.Deserializer
@@ -120,6 +121,59 @@ class JacksonDeserializerTest {
         assertEquals expected, result
     }
 
+    private static final String DUPLICATE_KEY_JSON = """
+             {
+                "aKey":"oneValue",
+                "bKey": 15,
+                "bKey": "hello"
+             }
+            """
+
+    private static void assertDuplicateKeyRejected(Deserializer deserializer) {
+        try {
+            deserializer.deserialize(new StringReader(DUPLICATE_KEY_JSON))
+            fail('Duplicate keys must be rejected.')
+        } catch (DeserializationException expected) {
+            assertNotNull expected.getCause()
+            assertTrue expected.getCause().getMessage().contains('bKey')
+        }
+    }
+
+    /**
+     * Asserts https://github.com/jwtk/jjwt/issues/877
+     */
+    @Test
+    void testStrictDuplicateDetection() {
+        assertDuplicateKeyRejected(new JacksonDeserializer<>())
+    }
+
+    /**
+     * Asserts https://github.com/jwtk/jjwt/issues/877 for deserializers configured with custom claim types.
+     */
+    @Test
+    void testStrictDuplicateDetectionWithClaimTypeMap() {
+        assertDuplicateKeyRejected(new JacksonDeserializer<>(Maps.of("aKey", String).build()))
+    }
+
+    /**
+     * A caller-supplied ObjectMapper with STRICT_DUPLICATE_DETECTION enabled must cause duplicate keys to be rejected.
+     */
+    @Test
+    void testCallerEnabledStrictDuplicateDetection() {
+        def mapper = new ObjectMapper().configure(JsonParser.Feature.STRICT_DUPLICATE_DETECTION, true)
+        assertDuplicateKeyRejected(new JacksonDeserializer<>(mapper))
+    }
+
+    /**
+     * A caller-supplied ObjectMapper that does not enable STRICT_DUPLICATE_DETECTION keeps its own behavior:
+     * the duplicate key is not rejected and the last value is used.
+     */
+    @Test
+    void testCallerObjectMapperWithoutStrictDuplicateDetection() {
+        def result = new JacksonDeserializer<>(new ObjectMapper()).deserialize(new StringReader(DUPLICATE_KEY_JSON))
+        assertEquals 'hello', result['bKey']
+    }
+
