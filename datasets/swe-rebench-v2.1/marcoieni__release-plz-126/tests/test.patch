+/// A git-cliff configuration that uses a distinctive header and commit group,
+/// so that generated changelogs reveal whether the caller-supplied config was used.
+const CUSTOM_CHANGELOG_CONFIG: &str = r#"
+[changelog]
+header = "CUSTOM_CHANGELOG_HEADER\n"
+body = """
+{% if version %}## {{ version }}{% endif %}
+{% for group, commits in commits | group_by(attribute="group") %}
+### {{ group }}
+{% for commit in commits %}
+- {{ commit.message }}
+{% endfor %}
+{% endfor %}
+"""
+trim = true
+
+[git]
+conventional_commits = true
+filter_unconventional = false
+commit_parsers = [
+    { message = "^feat", group = "MyCustomGroup" },
+]
+filter_commits = false
+"#;
+
+#[tokio::test]
+async fn custom_changelog_config_is_used() {
+    let comparison_test = ComparisonTest::new().await;
+    user_mock::add_feature(&comparison_test.local_project(), "do awesome stuff");
+
+    let config_dir = tempdir().unwrap();
+    let config_path = config_dir.path().join("cliff.toml");
+    fs::write(&config_path, CUSTOM_CHANGELOG_CONFIG).unwrap();
+    comparison_test.run_cli_update(Some(&config_path));
+
+    let changelog = comparison_test.local_project_changelog();
+    assert!(
+        changelog.contains("CUSTOM_CHANGELOG_HEADER"),
+        "the caller-supplied changelog header was not used, got:\n{changelog}"
+    );
+    assert!(
+        changelog.contains("MyCustomGroup"),
+        "the caller-supplied commit group was not used, got:\n{changelog}"
+    );
+}
