+package procfs
+
+import (
+	"testing"
+)
+
+func TestFSWirelessSignalLevelPerInterface(t *testing.T) {
+	fs, err := NewFS(procTestFixtures)
+	if err != nil {
+		t.Fatalf("failed to open procfs: %v", err)
+	}
+
+	got, err := fs.Wireless()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	expected := map[string]int64{
+		"wlan0": -31,
+		"wlan1": -42,
+	}
+	if len(got) != len(expected) {
+		t.Fatalf("unexpected number of interfaces parsed %d, expected %d", len(got), len(expected))
+	}
+
+	for _, iface := range got {
+		level, ok := expected[iface.Name]
+		if !ok {
+			t.Errorf("unexpected interface %q", iface.Name)
+			continue
+		}
+		if int64(iface.QualityLevel) != level {
+			t.Errorf("interface %q has signal level %d, expected %d", iface.Name, iface.QualityLevel, level)
+		}
+		delete(expected, iface.Name)
+	}
+	if len(expected) != 0 {
+		t.Errorf("missing interface signal levels: %v", expected)
+	}
+}
