 }
+
+
+final class TokenTypeContractTestSupport {
+	private TokenTypeContractTestSupport() {
+	}
+
+	static String tokenTypeFieldValue() {
+		try {
+			return (String) OAuth2TokenServiceConstants.class.getField("TOKEN_TYPE").get(null);
+		} catch (ReflectiveOperationException e) {
+			throw new AssertionError("A public TOKEN_TYPE field is required", e);
+		}
+	}
+
+	static OAuth2TokenResponse createWithTokenType(String accessToken, long expiresInSeconds, String refreshToken,
+			String tokenType) {
+		try {
+			return OAuth2TokenResponse.class
+					.getConstructor(String.class, long.class, String.class, String.class)
+					.newInstance(accessToken, expiresInSeconds, refreshToken, tokenType);
+		} catch (ReflectiveOperationException e) {
+			throw new AssertionError("A public four-argument OAuth2TokenResponse constructor is required", e);
+		}
+	}
+
+	static String getTokenType(OAuth2TokenResponse response) {
+		try {
+			return (String) OAuth2TokenResponse.class.getMethod("getTokenType").invoke(response);
+		} catch (ReflectiveOperationException e) {
+			throw new AssertionError("A public getTokenType method is required", e);
+		}
+	}
+}
