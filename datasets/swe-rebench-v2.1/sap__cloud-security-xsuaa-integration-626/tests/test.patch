+	@Test
+	public void tokenTypeResponseFieldNameIsPublicAndStable() {
+		assertEquals("token_type", TokenTypeContractTestSupport.tokenTypeFieldValue());
+	}
+
+	@Test
+	public void getTokenType() {
+		OAuth2TokenResponse tokenResponse = TokenTypeContractTestSupport.createWithTokenType(
+				"accessToken", 47299, null, "MAC");
+		assertEquals("MAC", TokenTypeContractTestSupport.getTokenType(tokenResponse));
+		assertEquals("accessToken", tokenResponse.getAccessToken());
+	}
+
+	@Test
+	public void getTokenType_defaultsToBearerWhenNotSet() {
+		OAuth2TokenResponse tokenResponse = new OAuth2TokenResponse("accessToken", 47299, null);
+		assertEquals("bearer", TokenTypeContractTestSupport.getTokenType(tokenResponse));
+	}
