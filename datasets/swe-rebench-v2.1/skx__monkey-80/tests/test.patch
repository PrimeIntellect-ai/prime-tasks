+func TestTimeout(t *testing.T) {
+	input := `
+i = 1;
+for ( true ) {
+  i++;
+}
+`
+	ctx, cancel := context.WithTimeout(context.Background(), 350*time.Millisecond)
+	defer cancel()
+
+	l := lexer.New(input)
+	p := parser.New(l)
+	program := p.ParseProgram()
+	env := object.NewEnvironment()
+	SetContext(ctx)
+	defer SetContext(context.Background())
+	evaluated := Eval(program, env)
+
+	errObj, ok := evaluated.(*object.Error)
+	if !ok {
+		t.Fatalf("no error object returned. got=%T(%+v)",
+			evaluated, evaluated)
+	}
+
+	if ctx.Err() == nil {
+		t.Fatal("evaluation returned before its context ended")
+	}
+	if errObj.Message != ctx.Err().Error() {
+		t.Errorf("got error %q, want context error %q", errObj.Message, ctx.Err().Error())
+	}
+}
+
+func TestCancel(t *testing.T) {
+	input := `
+i = 1;
+for ( true ) {
+  i++;
+}
+`
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	l := lexer.New(input)
+	p := parser.New(l)
+	program := p.ParseProgram()
+	env := object.NewEnvironment()
+	SetContext(ctx)
+	defer SetContext(context.Background())
+
+	// Cancel the running script after a short delay, exercising an
+	// explicit cancellation signal rather than a deadline.
+	go func() {
+		time.Sleep(100 * time.Millisecond)
+		cancel()
+	}()
+
+	done := make(chan object.Object, 1)
+	go func() {
+		done <- Eval(program, env)
+	}()
+
+	var evaluated object.Object
+	select {
+	case evaluated = <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("evaluation did not stop after the context was cancelled")
+	}
+
+	errObj, ok := evaluated.(*object.Error)
+	if !ok {
+		t.Fatalf("no error object returned. got=%T(%+v)",
+			evaluated, evaluated)
+	}
+
+	if ctx.Err() == nil {
+		t.Fatal("evaluation returned before cancellation")
+	}
+	if errObj.Message != ctx.Err().Error() {
+		t.Errorf("got error %q, want context error %q", errObj.Message, ctx.Err().Error())
+	}
+}
