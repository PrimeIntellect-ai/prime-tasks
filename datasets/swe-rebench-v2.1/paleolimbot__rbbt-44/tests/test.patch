diff --git a/tests/testthat/test-write-bib.R b/tests/testthat/test-write-bib.R
index b116c43..159f56e 100644
--- a/tests/testthat/test-write-bib.R
+++ b/tests/testthat/test-write-bib.R
@@ -22,9 +22,40 @@ test_that("bib writer works", {
 test_that("bib guessers work", {
   expect_identical(bbt_guess_translator("thing.bib"), "biblatex")
   expect_identical(bbt_guess_translator("thing.json"), "json")
-  expect_identical(bbt_guess_translator("thing.yaml"), "cslyaml")
 
   expect_identical(bbt_guess_format("thing.tex"), "cite")
   expect_identical(bbt_guess_format("thing.Rmd"), "pandoc")
 })
 
+
+test_that("the bibliography addin inserts a selected record into YAML files", {
+  inserted <- NULL
+  testthat::local_mocked_bindings(
+    getActiveDocumentContext = function() list(path = "references.yaml"),
+    isAvailable = function() TRUE,
+    insertText = function(text, ...) {
+      inserted <<- text
+      invisible(TRUE)
+    },
+    .package = "rstudioapi"
+  )
+  testthat::local_mocked_bindings(
+    GET = function(url, ...) structure(list(url = url), class = "response"),
+    content = function(x, ...) {
+      if (grepl("cayw", x$url, fixed = TRUE)) {
+        return("ready")
+      }
+
+      if (grepl("cslyaml", x$url, fixed = TRUE)) {
+        return("Error: getTranslatorId: \"cslyaml\" is not a GUID")
+      }
+
+      "- id: selected-record"
+    },
+    .package = "httr"
+  )
+
+  expect_no_error(rbbt:::bbt_bib_addin())
+  expect_match(inserted, "selected-record", fixed = TRUE)
+  expect_no_match(inserted, "Error", fixed = TRUE)
+})
