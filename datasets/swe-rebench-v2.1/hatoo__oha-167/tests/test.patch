+}
+
+async fn assert_connect_to_fails(connect_to: &'static str) {
+    tokio::task::spawn_blocking(move || {
+        Command::cargo_bin("oha")
+            .unwrap()
+            .args(&["-n", "1", "--no-tui"])
+            .arg("http://example.org/")
+            .arg("--connect-to")
+            .arg(connect_to)
+            .assert()
+            .failure();
+    })
+    .await
+    .unwrap();
+}
+
+#[tokio::test]
+async fn test_connect_to_invalid_syntax() {
+    assert_connect_to_fails("invalid").await;
+}
+
+#[tokio::test]
+async fn test_connect_to_malformed_ipv6() {
+    assert_connect_to_fails("example.org:80:[::1").await;
+}
+
+#[tokio::test]
+async fn test_connect_to_invalid_requested_port() {
+    assert_connect_to_fails("example.org:notaport:localhost:80").await;
+}
+
+#[tokio::test]
+async fn test_connect_to_invalid_target_port() {
