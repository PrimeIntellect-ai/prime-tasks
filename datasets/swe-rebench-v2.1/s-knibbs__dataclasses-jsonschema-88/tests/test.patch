+def test_from_object_preserves_none_for_nested_object():
+    @dataclass
+    class Child(JsonSchemaMixin):
+        value: str
+
+    @dataclass
+    class Parent(JsonSchemaMixin):
+        child: Optional[Child]
+
+    class ParentModel:
+        child = None
+
+    converted = Parent.from_object(ParentModel())
+
+    assert converted.child is None
