+  public void testUnsuccessfulResponseHandlerCanInspectContentAndTriggerBackOffRetry()
+      throws IOException {
+    final AtomicInteger calls = new AtomicInteger();
+    HttpTransport transport =
+        new MockHttpTransport() {
+          @Override
+          public LowLevelHttpRequest buildRequest(String method, String url) throws IOException {
+            return new MockLowLevelHttpRequest() {
+              @Override
+              public LowLevelHttpResponse execute() throws IOException {
+                MockLowLevelHttpResponse result = new MockLowLevelHttpResponse();
+                if (calls.getAndIncrement() == 0) {
+                  result.setStatusCode(403);
+                  result.setContent(ERROR_SAMPLE);
+                } else {
+                  result.setStatusCode(200);
+                  result.setContent("ok");
+                }
+                return result;
+              }
+            };
+          }
+        };
+    final MockSleeper sleeper = new MockSleeper();
+    final HttpBackOffUnsuccessfulResponseHandler backOffHandler =
+        new HttpBackOffUnsuccessfulResponseHandler(new ExponentialBackOff())
+            .setSleeper(sleeper)
+            .setBackOffRequired(HttpBackOffUnsuccessfulResponseHandler.BackOffRequired.ALWAYS);
+    HttpRequest request =
+        transport.createRequestFactory().buildGetRequest(HttpTesting.SIMPLE_GENERIC_URL);
+    request.setUnsuccessfulResponseHandler(
+        new HttpUnsuccessfulResponseHandler() {
+          @Override
+          public boolean handleResponse(
+              HttpRequest request, HttpResponse response, boolean supportsRetry)
+              throws IOException {
+            InputStream content = response.getContent();
+            if (content.markSupported()) {
+              content.mark(8192);
+            }
+            String body = new String(ByteStreams.toByteArray(content), StandardCharsets.UTF_8);
+            if (content.markSupported()) {
+              content.reset();
+            }
+            if (!body.contains("domainPolicy")) {
+              return false;
+            }
+            return backOffHandler.handleResponse(request, response, supportsRetry);
+          }
+        });
+
+    HttpResponse response = request.execute();
+    assertEquals(200, response.getStatusCode());
+    assertEquals("ok", response.parseAsString());
+    assertEquals(2, calls.get());
+    assertEquals(1, sleeper.getCount());
+  }
