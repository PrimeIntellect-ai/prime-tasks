+def test_Connector_close_kills_thread() -> None:
+    """Closing a connector leaves no newly created worker thread running."""
+    import threading
+
+    threads_before = {thread.ident for thread in threading.enumerate()}
+    connector = Connector()
+    connector.close()
+
+    lingering_threads = [
+        thread
+        for thread in threading.enumerate()
+        if thread.ident not in threads_before
+    ]
+    assert not lingering_threads
+
+
+def test_Connector_close_releases_loop_resources() -> None:
+    """Test that closing a Connector and dropping the reference releases the
+    event loop's file descriptors so repeated create/close cycles do not leak
+    open files."""
+    import gc
+    import os
+
+    fd_dir = "/proc/self/fd"
+    if not os.path.isdir(fd_dir):
+        pytest.skip("file descriptor introspection requires /proc/self/fd")
+
+    def open_fds() -> int:
+        return len(os.listdir(fd_dir))
+
+    # warm up so any one-time resources are already allocated
+    warmup = Connector()
+    warmup.close()
+    del warmup
+    gc.collect()
+
+    before = open_fds()
+    for _ in range(20):
+        connector = Connector()
+        connector.close()
+        del connector
+    gc.collect()
+    after = open_fds()
+
+    # each leaked event loop keeps its selector's file descriptors open, so a
+    # correct close must not accumulate them across create/close cycles
+    assert after - before < 10
