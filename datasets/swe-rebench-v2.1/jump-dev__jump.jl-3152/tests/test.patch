+function test_containers_denseaxisarray_jump_3151()
+    source = Containers.DenseAxisArray(ones(3), [:a, :b, :c])
+
+    destination = Containers.DenseAxisArray(zeros(3), [:a, :b, :c])
+    selected = [:a, :b]
+    destination[selected] = source[selected]
+    @test [destination[i] for i in [:a, :b, :c]] == [1.0, 1.0, 0.0]
+
+    destination = Containers.DenseAxisArray(zeros(3), [:a, :b, :c])
+    selected = [:a, :c]
+    destination[selected] = source[selected]
+    @test [destination[i] for i in [:a, :b, :c]] == [1.0, 0.0, 1.0]
+    return
+end
+
+function test_containers_denseaxisarray_broadcast_selection()
+    destination = Containers.DenseAxisArray([1.0, 2.0, 3.0], [:a, :b, :c])
+    selected = [:a, :c]
+    destination[selected] .= 7.0
+    @test [destination[key] for key in [:a, :b, :c]] == [7.0, 2.0, 7.0]
+    return
+end
 end  # module
