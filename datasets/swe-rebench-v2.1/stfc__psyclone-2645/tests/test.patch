+def test_lookup_default_value():
+    '''Test that lookup() uses its fallback only when lookup fails.
+
+    '''
+    table = symbols.SymbolTable()
+    with pytest.raises(KeyError):
+        table.lookup("missing")
+
+    # Any supplied value, including None, can be returned for an absent name.
+    assert table.lookup("missing", otherwise=None) is None
+    fallback = object()
+    assert table.lookup("missing", otherwise=fallback) is fallback
+
+    # A successful lookup takes precedence over the fallback.
+    present = symbols.Symbol("present")
+    table.add(present)
+    assert table.lookup("present", otherwise=fallback) is present
+
+    # A fallback does not bypass the existing visibility constraint.
+    hidden = symbols.Symbol(
+        "hidden", visibility=symbols.Symbol.Visibility.PRIVATE)
+    table.add(hidden)
+    with pytest.raises(symbols.SymbolError):
+        table.lookup("hidden", visibility=symbols.Symbol.Visibility.PUBLIC,
+                     otherwise=fallback)
+
+    # Nor does a fallback bypass name validation or scope limits.
+    with pytest.raises(TypeError):
+        table.lookup(None, otherwise=fallback)
+    schedule_symbol_table, _ = create_hierarchy()
+    scope = schedule_symbol_table.node
+    assert schedule_symbol_table.lookup(
+        "symbol2", scope_limit=scope, otherwise=fallback) is fallback
+
