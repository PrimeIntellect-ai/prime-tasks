+
+def test_get_when_non_strict_json(downloader):
+    response = Response()
+    response.encoding = "UTF-8"
+    response.status_code = 200
+    response._content = '\n{"text":"This is\nmy text"}'.encode("UTF-8")
+    expected = {"text": "This is\nmy text"}
+    when(requests).get("https://test.com", ...).thenReturn(response)
+
+    result = downloader.get("https://test.com")
+
+    assert expected == result
+
+    unstub()
+
+
+def test_get_when_malformed_json(downloader):
+    response = Response()
+    response.encoding = "UTF-8"
+    response.status_code = 200
+    response._content = b"this is not valid json"
+    when(requests).get(...).thenReturn(response)
+
+    with pytest.raises(ValueError):
+        downloader.get("https://test.com")
+
+    unstub()
