+// Copyright (c) 2022 Onur Cinar. All Rights Reserved.
+// https://github.com/cinar/indicatorts
+
+import { ok } from 'assert';
+import { rsi } from '../momentum/rsi';
+
+describe('RSI smoothing', () => {
+  it('uses rolling rather than simple averaging for gains and losses', () => {
+    const previousZero = Object.getOwnPropertyDescriptor(Array.prototype, '0');
+    Object.defineProperty(Array.prototype, '0', {
+      configurable: true,
+      writable: true,
+      value: 0,
+    });
+
+    try {
+      const closings = [1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2];
+      ok(rsi(closings)[15] > 50);
+    } finally {
+      if (previousZero) {
+        Object.defineProperty(Array.prototype, '0', previousZero);
+      } else {
+        delete Array.prototype[0];
+      }
+    }
+  });
+});
