         p.id = "#bar"
+
+
+def test_entity_in_properties(tmpdir):
+    file_id = "data.csv"
+    file_path = tmpdir / file_id
+    with open(file_path, "wt") as fout:
+        fout.write("DATA\n")
+    crate = ROCrate()
+    alice_id = "https://orcid.org/0000-0000-0000-0000"
+    bob_id = "https://orcid.org/0000-0000-0000-0001"
+    alice = crate.add(Person(crate, alice_id, properties={
+        "name": "Alice Doe",
+        "affiliation": "University of Flatland",
+    }))
+    bob = crate.add(Person(crate, bob_id, properties={
+        "name": "Bob Doe",
+        "affiliation": "University of Flatland",
+    }))
+    data = crate.add_file(file_path, properties={
+        "name": "Data file",
+        "encodingFormat": "text/csv",
+        "author": [alice, bob],
+    })
+    authors = data["author"]
+    assert {author.id for author in authors} == {alice_id, bob_id}
+    assert {author["name"] for author in authors} == {"Alice Doe", "Bob Doe"}
+
+    book = crate.add(ContextEntity(crate, "#44cats", properties={
+        "@type": "Book",
+        "name": "44 Cats",
+        "author": alice,
+    }))
+    assert book["author"].id == alice_id
+    assert book["author"]["name"] == "Alice Doe"
+
+    out_path = tmpdir / "ro_crate_out"
+    crate.write(out_path)
+    out_crate = ROCrate(out_path)
+    out_alice = out_crate.get(alice_id)
+    out_bob = out_crate.get(bob_id)
+    out_data = out_crate.get(file_id)
+    out_book = out_crate.get("#44cats")
+    assert out_book["author"].id == out_alice.id
+    assert out_book["author"]["name"] == "Alice Doe"
+    out_authors = out_data["author"]
+    assert {author.id for author in out_authors} == {alice_id, bob_id}
+    assert {author["name"] for author in out_authors} == {"Alice Doe", "Bob Doe"}
