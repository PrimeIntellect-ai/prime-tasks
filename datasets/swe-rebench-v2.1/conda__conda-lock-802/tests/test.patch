@@ -0,0 +1,14 @@
+from conda_lock.src_parser.pyproject_toml import poetry_version_to_conda_version
+
+
+def test_compatible_release_operator_is_parsed():
+    """A ``~=`` compatible-release specifier must be accepted, not raise.
+
+    conda-lock 2 accepted ``~=`` in a pip dependency and returned a conda
+    version string; conda-lock 3 raised ``InvalidVersion``.  The operator must
+    once again parse into a conda-compatible version string.
+    """
+    result = poetry_version_to_conda_version("~=1.36")
+    assert result is not None
+    assert isinstance(result, str)
+    assert result
