+def _managed_policy_document(num_actions):
+    return {
+        "Version": "2012-10-17",
+        "Statement": [
+            {
+                "Effect": "Allow",
+                "Action": [f"service:Action{i}" for i in range(num_actions)],
+                "Resource": "*",
+            }
+        ],
+    }
+
+
+def _managed_policy_template(policy_document, indent=4):
+    rendered = json.dumps(policy_document, indent=indent)
+    indented = "\n".join(f"        {line}" for line in rendered.splitlines())
+    return (
+        'AWSTemplateFormatVersion: "2010-09-09"\n'
+        "Resources:\n"
+        "  Policy:\n"
+        '    Type: "AWS::IAM::ManagedPolicy"\n'
+        "    Properties:\n"
+        "      PolicyDocument: |\n"
+        f"{indented}\n"
+    )
+
+
+@pytest.mark.parametrize(
+    "num_actions,indent,over_limit",
+    [
+        # The serialized document is well over 6144 characters because of the
+        # indentation, but the policy itself is under the limit once whitespace
+        # is ignored, so no E3033 is reported.
+        (300, 4, False),
+        # Tabs are JSON whitespace too and do not count toward the policy limit.
+        (300, "\t", False),
+        # The policy itself is over the limit, so E3033 is reported.
+        (320, 4, True),
+    ],
+)
+def test_managed_policy_document_size(num_actions, indent, over_limit):
+    policy_document = _managed_policy_document(num_actions)
+    compact_length = len(json.dumps(policy_document, separators=(",", ":")))
+    if over_limit:
+        assert compact_length > 6144
+    else:
+        assert compact_length <= 6144
+
+    template = _managed_policy_template(policy_document, indent=indent)
+    matches = lint(template)
+    e3033 = [m for m in matches if m.rule.id == "E3033"]
+    if over_limit:
+        assert len(e3033) >= 1
+    else:
+        assert len(e3033) == 0
