+class CrossTests(unittest.TestCase):
+    def setUp(self):
+        self.a = np.eye(2, 3)
+        self.b = np.ones((2, 3))
+
+    def test_cross(self):
+        a = TensorBase(self.a)
+        b = TensorBase(self.b)
+
+        # Verify that the expected result is retuned
+        expected_result = np.array([0, -1, 1, 1, 0, -1]).reshape(2, 3)
+        self.assertTrue(np.array_equal(a.cross(b), expected_result))
+
+        # Verify that ValueError is thrown when dimension is out of bounds
+        self.assertRaises(ValueError, a.cross, b, 5)
+
+        # Verify that ValueError is thrown when size dimension dim != 3
+        self.assertRaises(ValueError, a.cross, b, 0)
+
+        # Verify that ValueError is thrown when dimensions don't match
+        a = TensorBase(self.a.reshape(3, 2))
+        self.assertRaises(ValueError, a.cross, b)
+
+        # Verify that NotImplemented is returned if Tensor is encrypted
+        a = TensorBase(self.a, True)
+        self.assertEqual(a.cross(b), NotImplemented)
+
+    def test_cross_int(self):
+        a = TensorBase(np.array([[1, 2, 3], [4, 5, 6]]))
+        b = TensorBase(np.array([[7, 8, 9], [10, 11, 12]]))
+        expected_result = np.array([[-6, 12, -6], [-6, 12, -6]])
+        self.assertTrue(np.array_equal(a.cross(b), expected_result))
+
+    def test_cross_float(self):
+        a = TensorBase(np.array([[1.0, 2.0, 3.0]]))
+        b = TensorBase(np.array([[4.0, 5.0, 6.0]]))
+        expected_result = np.array([[-3.0, 6.0, -3.0]])
+        self.assertTrue(np.array_equal(a.cross(b), expected_result))
+
+    def test_cross_dim(self):
+        a = TensorBase(np.array([[1, 2], [3, 4], [5, 6]]))
+        b = TensorBase(np.array([[7, 8], [9, 10], [11, 12]]))
+        expected_result = np.array([[-12, -12], [24, 24], [-12, -12]])
+        self.assertTrue(np.array_equal(a.cross(b, 0), expected_result))
+
+    def test_cross_returns_new_tensor(self):
+        a = TensorBase(self.a)
+        b = TensorBase(self.b)
+        result = a.cross(b)
+        self.assertIsInstance(result, TensorBase)
+        self.assertIsNot(result, a)
+
+    def test_cross_encrypted_other(self):
+        a = TensorBase(self.a)
+        b = TensorBase(self.b, True)
+        self.assertEqual(a.cross(b), NotImplemented)
+
+    def test_cross_has_inline_documentation(self):
+        self.assertTrue(TensorBase.cross.__doc__.strip())
