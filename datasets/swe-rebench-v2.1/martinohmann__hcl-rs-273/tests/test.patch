+
+// https://github.com/martinohmann/hcl-rs/issues/270
+#[test]
+fn issue_270() {
+    let no_trailing_newline = String::from("block {\nfoo = \"bar\"\n}\nbar = \"baz\"");
+    let one_trailing_newline = format!("{no_trailing_newline}\n");
+    let two_trailing_newlines = format!("{one_trailing_newline}\n");
+
+    for input in [
+        no_trailing_newline,
+        one_trailing_newline,
+        two_trailing_newlines,
+    ] {
+        let parsed: Body = input.parse().unwrap();
+        assert_eq!(parsed.to_string(), input);
+    }
+}
