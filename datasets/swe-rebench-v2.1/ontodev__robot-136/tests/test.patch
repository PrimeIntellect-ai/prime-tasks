 package org.obolibrary.robot;
 
+import static org.junit.Assert.assertTrue;
+
 import java.io.IOException;
 import java.util.HashMap;
 import java.util.Map;
 
 import org.junit.Test;
 
+import org.semanticweb.owlapi.model.IRI;
+import org.semanticweb.owlapi.model.OWLClass;
+import org.semanticweb.owlapi.model.OWLClassExpression;
+import org.semanticweb.owlapi.model.OWLObjectProperty;
 import org.semanticweb.owlapi.model.OWLOntology;
 
 /**
- * Tests for ReasonOperation.
+ * Tests for RelaxOperation.
  */
 public class RelaxOperationTest extends CoreTest {
 
+    /** Base IRI used by the OBO test resources. */
+    private static final String OBO = "http://purl.obolibrary.org/obo/";
+
     /**
-     * Test removing redundant subclass axioms.
+     * Resolve a named class from the test ontology by its OBO id.
      *
+     * @param id the OBO id, e.g. "X_1"
+     * @return the corresponding OWLClass
+     */
+    private OWLClass cls(String id) {
+        return dataFactory.getOWLClass(IRI.create(OBO + id));
+    }
+
+    /**
+     * Resolve an object property from the test ontology by its OBO id.
+     *
+     * @param id the OBO id, e.g. "RO_0002180"
+     * @return the corresponding OWLObjectProperty
+     */
+    private OWLObjectProperty prop(String id) {
+        return dataFactory.getOWLObjectProperty(IRI.create(OBO + id));
+    }
+
+    /**
+     * Assert that the ontology contains the given SubClassOf axiom.
+     *
+     * @param ont the ontology to inspect
+     * @param sub the subclass
+     * @param sup the superclass expression
+     */
+    private void assertSubClassOf(
+            OWLOntology ont, OWLClass sub, OWLClassExpression sup) {
+        assertTrue(
+            "Expected relaxed axiom: SubClassOf(" + sub + " " + sup + ")",
+            ont.getSubClassAxiomsForSubClass(sub).stream()
+                .anyMatch(axiom -> axiom.getSuperClass().equals(sup)));
+    }
+
+    /**
+     * Load and relax the ontology used to exercise the supported equivalence cases.
+     *
+     * @return the relaxed ontology
      * @throws IOException on file problem
      */
-    @Test
-    public void testRelax() throws IOException {
+    private OWLOntology relaxedTestOntology() throws IOException {
         OWLOntology ont = loadOntology("/relax_equivalence_axioms_test.obo");
-
         Map<String, String> options = new HashMap<String, String>();
         options.put("remove-redundant-subclass-axioms", "true");
-
         RelaxOperation.relax(ont, options);
-        assertIdentical("/relax_equivalence_axioms_relaxed.obo", ont);
+        return ont;
+    }
+
+    /**
+     * Named conjuncts of an equivalence must become subclass axioms.
+     *
+     * @throws IOException on file problem
+     */
+    @Test
+    public void testRelaxNamedSuperclasses() throws IOException {
+        OWLOntology ont = relaxedTestOntology();
+        assertSubClassOf(ont, cls("X_4"), cls("X_5"));
+    }
+
+    /**
+     * A positive exact-cardinality conjunct must yield its existential subclass axiom.
+     *
+     * @throws IOException on file problem
+     */
+    @Test
+    public void testRelaxExactCardinality() throws IOException {
+        OWLOntology ont = relaxedTestOntology();
+        assertSubClassOf(
+            ont,
+            cls("X_4"),
+            dataFactory.getOWLObjectSomeValuesFrom(
+                prop("RO_0002180"), cls("X_6")));
+    }
+
+    /**
+     * The existing SomeValuesFrom relaxation remains available.
+     *
+     * @throws IOException on file problem
+     */
+    @Test
+    public void testRelaxSomeValuesFrom() throws IOException {
+        OWLOntology ont = relaxedTestOntology();
+        assertSubClassOf(
+            ont,
+            cls("X_1"),
+            dataFactory.getOWLObjectSomeValuesFrom(
+                prop("BFO_0000050"), cls("X_3")));
     }
 
 }
