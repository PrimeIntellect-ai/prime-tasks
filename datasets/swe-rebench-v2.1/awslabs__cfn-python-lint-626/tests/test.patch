+class TestRelationshipConditionsWithParameters(BaseTestCase):
+    """Test W1001 uses feasible condition scenarios from parameter AllowedValues"""
+
+    def _run_w1001(self, template):
+        """Run the W1001 rule against a template and return its matches"""
+        collection = RulesCollection(include_rules=['I'])
+        collection.register(RelationshipConditions())
+        runner = Runner(collection, 'test.yaml', template, ['us-east-1'], [])
+        runner.transform()
+        return runner.run()
+
+    def test_no_false_positive_when_conditions_share_parameter(self):
+        """A Ref guarded by a condition that is always true when the resource condition is true"""
+        template = {
+            'Parameters': {
+                'NatType': {
+                    'Type': 'String',
+                    'AllowedValues': ['None', 'Single NAT', 'High Availability']
+                }
+            },
+            'Conditions': {
+                'DeployNatGateway': {'Fn::Not': [{'Fn::Equals': [{'Ref': 'NatType'}, 'None']}]},
+                'Az1Nat': {
+                    'Fn::Or': [
+                        {'Fn::Equals': [{'Ref': 'NatType'}, 'Single NAT']},
+                        {'Fn::Equals': [{'Ref': 'NatType'}, 'High Availability']}
+                    ]
+                }
+            },
+            'Resources': {
+                'NatA': {
+                    'Type': 'AWS::EC2::NatGateway',
+                    'Condition': 'Az1Nat',
+                    'Properties': {'AllocationId': 'eipalloc-1', 'SubnetId': 'subnet-1'}
+                },
+                'PrivateDefaultRouteA': {
+                    'Type': 'AWS::EC2::Route',
+                    'Condition': 'DeployNatGateway',
+                    'Properties': {'NatGatewayId': {'Ref': 'NatA'}, 'RouteTableId': 'rtb-1'}
+                }
+            }
+        }
+        self.assertEqual([], self._run_w1001(template))
+
+    def test_valid_warning_still_reported(self):
+        """A Ref to a resource whose condition can be false while the reference exists is still reported"""
+        template = {
+            'Parameters': {
+                'myEnvironment': {
+                    'Type': 'String',
+                    'AllowedValues': ['Dev', 'Stage', 'Prod']
+                }
+            },
+            'Conditions': {
+                'isProduction': {'Fn::Equals': [{'Ref': 'myEnvironment'}, 'Prod']},
+                'isDevelopment': {'Fn::Equals': [{'Ref': 'myEnvironment'}, 'Dev']}
+            },
+            'Resources': {
+                'Role': {
+                    'Type': 'AWS::IAM::Role',
+                    'Condition': 'isProduction',
+                    'Properties': {'AssumeRolePolicyDocument': {'Version': '2012-10-17', 'Statement': []}}
+                },
+                'Profile': {
+                    'Type': 'AWS::IAM::InstanceProfile',
+                    'Condition': 'isDevelopment',
+                    'Properties': {'Roles': [{'Ref': 'Role'}]}
+                }
+            }
+        }
+        matches = self._run_w1001(template)
+        self.assertTrue(matches)
