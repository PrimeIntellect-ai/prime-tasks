+def _assert_api_version(metadata: dict[str, object]) -> str:
+    api_version = metadata["api-version"]
+    assert isinstance(api_version, str)
+    assert Version(api_version) >= Version("1.1")
+    return api_version
+
+
+def _assert_simple_json(actual: str, expected: str) -> None:
+    """Compare two simple-index JSON documents, ignoring versions order."""
+    actual_data = json.loads(actual)
+    expected_data = json.loads(expected)
+
+    # Any Simple API version 1.1 or later is supported.
+    api_version = _assert_api_version(actual_data["meta"])
+    expected_data["meta"]["api-version"] = api_version
+
+    # The order of the versions list is not significant.
+    assert set(actual_data["versions"]) == set(expected_data["versions"])
+    actual_data["versions"] = sorted(actual_data["versions"])
+    expected_data["versions"] = sorted(expected_data["versions"])
+    assert actual_data == expected_data
+
+    # Key order is significant at every level.
+    assert list(actual_data) == list(expected_data)
+    assert list(actual_data["meta"]) == list(expected_data["meta"])
+    for a_entry, e_entry in zip(actual_data["files"], expected_data["files"]):
+        assert list(a_entry) == list(e_entry)
+
+
+def _assert_json_indentation(text: str) -> None:
+    lines = text.splitlines()
+    assert len(lines) > 1
+    depth = 0
+    in_string = False
+    escaped = False
+    for line in lines:
+        stripped = line.lstrip(" ")
+        if not stripped:
+            continue
+        expected_depth = depth - 1 if stripped[0] in "}]" else depth
+        assert line[: len(line) - len(stripped)] == " " * (4 * expected_depth)
+
+        for character in line:
+            if in_string:
+                if escaped:
+                    escaped = False
+                elif character == "\\":
+                    escaped = True
+                elif character == '"':
+                    in_string = False
+            elif character == '"':
+                in_string = True
+            elif character in "[{":
+                depth += 1
+            elif character in "}]":
+                depth -= 1
+
+
+def _assert_json_separator_spaces(text: str) -> None:
+    in_string = False
+    escaped = False
+    for index, character in enumerate(text):
+        if in_string:
+            if escaped:
+                escaped = False
+            elif character == "\\":
+                escaped = True
+            elif character == '"':
+                in_string = False
+        elif character == '"':
+            in_string = True
+        elif character in ",:":
+            assert text[index + 1 : index + 2] == " "
+
