+@pytest.mark.parametrize(
+    "connector",
+    [
+        {"enable_iam_auth": True, "db_version": "MYSQL_8_0"},
+        {"enable_iam_auth": True, "db_version": "SQLSERVER_2019_STANDARD"},
+    ],
+    indirect=True,
+)
+def test_connector_iam_auth_unsupported(
+    connector: Connector, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """A public connection attempt rejects unsupported automatic IAM auth."""
+    import pg8000
+
+    monkeypatch.setattr(pg8000.dbapi, "connect", lambda *args, **kwargs: object())
+    with pytest.raises(Exception):
+        connector.connect(
+            "my-project:my-region:my-instance",
+            "pg8000",
+            user="my-user",
+            db="my-db",
+        )
+
+
+@pytest.mark.parametrize(
+    "connector",
+    [{"enable_iam_auth": True, "db_version": "POSTGRES_14"}],
+    indirect=True,
+)
+def test_connector_iam_auth_supported_postgres(
+    connector: Connector, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """A supported PostgreSQL IAM request is not rejected as unsupported."""
+    import pg8000
+
+    connection = object()
+    monkeypatch.setattr(pg8000.dbapi, "connect", lambda *args, **kwargs: connection)
+
+    result = connector.connect(
+        "my-project:my-region:my-instance",
+        "pg8000",
+        user="my-user",
+        db="my-db",
+    )
+
+    assert result is not None
+
+
