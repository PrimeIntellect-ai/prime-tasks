diff --git a/test/anyof.test.js b/test/anyof.test.js
index bb28e6e..3059c67 100644
--- a/test/anyof.test.js
+++ b/test/anyof.test.js
@@ -616,3 +616,70 @@ test('anyOf with a nested external schema', (t) => {
   const stringify = build(schema, { schema: externalSchemas })
   t.equal(stringify('foo'), '"foo"')
 })
+
+test('object with ref and validated properties', (t) => {
+  t.plan(2)
+
+  const externalSchemas = {
+    RefSchema: {
+      $id: 'RefSchema',
+      type: 'string'
+    }
+  }
+
+  const schema = {
+    $id: 'root',
+    type: 'object',
+    properties: {
+      id: {
+        anyOf: [
+          { type: 'string' },
+          { type: 'number' }
+        ]
+      },
+      reference: { $ref: 'RefSchema' }
+    }
+  }
+
+  const stringify = build(schema, { schema: externalSchemas })
+  const output = JSON.parse(stringify({ id: 1, reference: 'hi' }))
+  t.same(Object.keys(output).sort(), ['id', 'reference'])
+  t.equal(output.reference, 'hi')
+})
+
+test('object with ref and validated properties and nested external refs', (t) => {
+  t.plan(2)
+
+  const externalSchemas = {
+    RefSchema: {
+      $id: 'RefSchema',
+      type: 'string'
+    },
+    NestedRefSchema: {
+      $id: 'NestedRefSchema',
+      type: 'object',
+      properties: {
+        nested: { $ref: 'RefSchema' }
+      }
+    }
+  }
+
+  const schema = {
+    $id: 'root',
+    type: 'object',
+    properties: {
+      id: {
+        anyOf: [
+          { type: 'string' },
+          { type: 'number' }
+        ]
+      },
+      reference: { $ref: 'NestedRefSchema' }
+    }
+  }
+
+  const stringify = build(schema, { schema: externalSchemas })
+  const output = JSON.parse(stringify({ id: 1, reference: { nested: 'hi' } }))
+  t.same(Object.keys(output).sort(), ['id', 'reference'])
+  t.equal(output.reference.nested, 'hi')
+})
