+def test_wide_to_long_string_columns():
+    # GH 57066
+    pytest.importorskip("pyarrow")
+    with pd.option_context("future.infer_string", True):
+        df = DataFrame(
+            {
+                "ID": {0: 1, 1: 2, 2: 3},
+                "R_test1": {0: 1, 1: 2, 2: 3},
+                "R_test2": {0: 1, 1: 3, 2: 5},
+                "R_test3": {0: 2, 1: 4, 2: 6},
+                "D": {0: 1, 1: 3, 2: 5},
+            }
+        )
+        result = wide_to_long(
+            df, stubnames="R", i="ID", j="UNPIVOTED", sep="_", suffix=".*"
+        )
+    expected = DataFrame(
+        {
+            "D": [1, 3, 5, 1, 3, 5, 1, 3, 5],
+            "R": [1, 2, 3, 1, 3, 5, 2, 4, 6],
+        },
+        columns=Index(["D", "R"], dtype="string[pyarrow_numpy]"),
+        index=pd.MultiIndex.from_arrays(
+            [
+                [1, 2, 3, 1, 2, 3, 1, 2, 3],
+                Index(
+                    [
+                        "test1",
+                        "test1",
+                        "test1",
+                        "test2",
+                        "test2",
+                        "test2",
+                        "test3",
+                        "test3",
+                        "test3",
+                    ],
+                    dtype="string[pyarrow_numpy]",
+                ),
+            ],
+            names=["ID", "UNPIVOTED"],
+        ),
+    )
+    tm.assert_frame_equal(result, expected)
