+<?php
+
+namespace PhpBench\Tests\Unit\Remote;
+
+use PhpBench\Tests\IntegrationTestCase;
+use Symfony\Component\Process\Process;
+
+class ProcessFactoryTest extends IntegrationTestCase
+{
+    protected function setUp(): void
+    {
+        $this->workspace()->reset();
+    }
+
+    public function testBenchmarkReceivesConfiguredEnv(): void
+    {
+        $this->writeProject(['PHPBENCH_TEST_FOO' => 'hello world']);
+
+        $process = $this->runPhpBench();
+
+        self::assertSame(0, $process->getExitCode(), $process->getOutput() . $process->getErrorOutput());
+    }
+
+    /**
+     * @param array<string,string> $env
+     */
+    private function writeProject(array $env): void
+    {
+        $config = [
+            'runner.path' => 'benchmarks',
+            'runner.php_env' => $env,
+        ];
+        file_put_contents(
+            $this->workspace()->path('phpbench.json'),
+            json_encode($config, JSON_PRETTY_PRINT)
+        );
+
+        if (!is_dir($this->workspace()->path('benchmarks'))) {
+            mkdir($this->workspace()->path('benchmarks'), 0777, true);
+        }
+
+        file_put_contents($this->workspace()->path('benchmarks/EnvBench.php'), <<<'PHP'
+<?php
+
+class EnvBench
+{
+    public function benchEnv(): void
+    {
+        if ('hello world' !== getenv('PHPBENCH_TEST_FOO')) {
+            throw new RuntimeException('configured env var was not passed to the benchmark');
+        }
+    }
+}
+PHP);
+    }
+
+    private function runPhpBench(): Process
+    {
+        $bin = __DIR__ . '/../../../bin/phpbench';
+        $process = Process::fromShellCommandline(
+            escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($bin) . ' run --iterations=1 --revs=1 --report=default',
+            $this->workspace()->path()
+        );
+        $process->run();
+
+        return $process;
+    }
+}
