+func newDocumentFromString(ged string) *gedcom.Document {
+	doc, err := gedcom.NewDocumentFromString(ged)
+	if err != nil {
+		panic(err)
+	}
+
+	return doc
+}
+
+func TestMergeNodeSlicesPassesDestinationDocumentToCallback(t *testing.T) {
+	destination := gedcom.NewDocument()
+	left := gedcom.Nodes{gedcom.NewDateNode("1 JAN 1900")}
+	right := gedcom.Nodes{gedcom.NewDateNode("1 JAN 1900")}
+	var callbackDocument *gedcom.Document
+
+	gedcom.MergeNodeSlices(left, right, destination, func(left, right gedcom.Node, document *gedcom.Document) gedcom.Node {
+		callbackDocument = document
+		return nil
+	})
+
+	assert.True(t, callbackDocument == destination)
+}
