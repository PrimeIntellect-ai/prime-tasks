+func TestDeepCopyUsesProvidedDocument(t *testing.T) {
+	source := gedcom.NewDocument()
+	individual := source.AddIndividual("P1", gedcom.NewNameNode("Ada /Lovelace/"))
+	destination := gedcom.NewDocument()
+
+	actual := gedcom.DeepCopy(individual, destination)
+	copiedIndividual, ok := actual.(*gedcom.IndividualNode)
+	if assert.True(t, ok) {
+		assert.True(t, copiedIndividual.Document() == destination)
+	}
+}
