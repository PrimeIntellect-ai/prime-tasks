         )
 
+    def test_diff_method_none(self):
+        """A QNode with diff_method=None cannot be differentiated."""
+        dev = qml.device("default.qubit", wires=1)
+
+        def func(x):
+            qml.RX(x, wires=0)
+            return qml.expval(qml.PauliZ(0))
+
+        qn = qml.QNode(func, dev, diff_method=None)
+        differentiable_input = pnp.array(0.5, requires_grad=True)
+
+        with pytest.raises(Exception):
+            qml.grad(qn)(differentiable_input)
+
+    def test_diff_method_none_numpy_io(self):
+        """Test that a QNode with diff_method=None accepts NumPy input and returns NumPy output."""
+        dev = qml.device("default.qubit", wires=1)
+
+        def func(x):
+            qml.RX(x, wires=0)
+            return qml.expval(qml.PauliZ(0))
+
+        qn = qml.QNode(func, dev, diff_method=None)
+
+        res_np = qn(np.array(0.5))
+
+        assert isinstance(res_np, (np.ndarray, np.generic))
+        assert np.allclose(res_np, np.cos(0.5))
+
 
 class TestTapeConstruction:
     """Tests for the tape construction"""
