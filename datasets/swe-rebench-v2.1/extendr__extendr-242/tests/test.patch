+#[test]
+fn exported_wide_integer_returns_are_real() {
+    test! {
+        unsafe {
+            let i = new_owned(wrap__exported_i64());
+            assert_eq!(i.rtype(), RType::Real);
+            assert_eq!(i.as_real(), Some(i64::MAX as f64));
+
+            let u = new_owned(wrap__exported_u64());
+            assert_eq!(u.rtype(), RType::Real);
+            assert_eq!(u.as_real(), Some(u64::MAX as f64));
+
+            let w = new_owned(wrap__exported_u32());
+            assert_eq!(w.rtype(), RType::Real);
+            assert_eq!(w.as_real(), Some(u32::MAX as f64));
+        }
+    }
+}
+
+#[test]
+fn wide_integers_convert_to_real_without_wrapping() {
+    test! {
+        assert_eq!(Robj::from(i64::MAX).as_real(), Some(i64::MAX as f64));
+        assert_eq!(Robj::from(i64::MIN).as_real(), Some(i64::MIN as f64));
+        assert_eq!(Robj::from(u64::MAX).as_real(), Some(u64::MAX as f64));
+        assert_eq!(Robj::from(u32::MAX).as_real(), Some(u32::MAX as f64));
+        assert_eq!(Robj::from(3_000_000_000_u32).as_real(), Some(3_000_000_000.));
+        assert_eq!(Robj::from(i64::MAX).rtype(), RType::Real);
+        assert_eq!(Robj::from(u64::MAX).rtype(), RType::Real);
+        assert_eq!(Robj::from(u32::MAX).rtype(), RType::Real);
+    }
+}
