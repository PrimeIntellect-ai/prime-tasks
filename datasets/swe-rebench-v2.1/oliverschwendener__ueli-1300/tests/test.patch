+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { ThemeProvider } from "./ThemeProvider";
+
+const createWindowStub = ({ themeName }: { themeName: string }) => {
+    vi.stubGlobal("window", {
+        ContextBridge: {
+            getSettingValue: () => themeName,
+        },
+        matchMedia: () => ({ matches: false }),
+    });
+};
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe("ThemeProvider", () => {
+    it("renders its content when the configured theme cannot be resolved", () => {
+        createWindowStub({ themeName: "toString" });
+
+        const markup = renderToStaticMarkup(
+            createElement(ThemeProvider, null, createElement("main", null, "Application content")),
+        );
+
+        expect(markup).toContain("Application content");
+    });
+});
