+func TestIndividualPageListsMultipleSpouses(t *testing.T) {
+	doc := gedcom.NewDocument()
+	individual := doc.AddIndividual("P1")
+	individual.AddName("Jordan /Central/")
+
+	firstSpouse := doc.AddIndividual("P2")
+	firstSpouse.AddName("Avery /OneSpouse/")
+	secondSpouse := doc.AddIndividual("P3")
+	secondSpouse.AddName("Riley /TwoSpouse/")
+	doc.AddFamilyWithHusbandAndWife("F1", individual, firstSpouse)
+	doc.AddFamilyWithHusbandAndWife("F2", secondSpouse, individual)
+
+	page := html.NewIndividualPage(doc, individual, "", &html.PublishShowOptions{
+		LivingVisibility: html.LivingVisibilityShow,
+	}, nil)
+	var output bytes.Buffer
+	_, err := page.WriteHTMLTo(&output)
+	assert.NoError(t, err)
+	assert.Contains(t, output.String(), "OneSpouse")
+	assert.Contains(t, output.String(), "TwoSpouse")
+}
+
+func TestIndividualPageListsChildrenAcrossFamilies(t *testing.T) {
+	doc := gedcom.NewDocument()
+	individual := doc.AddIndividual("P1")
+	individual.AddName("Jordan /Parent/")
+	spouse := doc.AddIndividual("P2")
+	spouse.AddName("Casey /KnownSpouse/")
+	knownSpouseChild := doc.AddIndividual("P3")
+	knownSpouseChild.AddName("Taylor /KnownSpouseChild/")
+	unknownSpouseChild := doc.AddIndividual("P4")
+	unknownSpouseChild.AddName("Morgan /UnknownSpouseChild/")
+	doc.AddFamilyWithHusbandAndWife("F1", individual, spouse).AddChild(knownSpouseChild)
+	doc.AddFamilyWithHusbandAndWife("F2", individual, nil).AddChild(unknownSpouseChild)
+
+	page := html.NewIndividualPage(doc, individual, "", &html.PublishShowOptions{
+		LivingVisibility: html.LivingVisibilityShow,
+	}, nil)
+	var output bytes.Buffer
+	_, err := page.WriteHTMLTo(&output)
+	assert.NoError(t, err)
+	assert.Contains(t, output.String(), "KnownSpouseChild")
+	assert.Contains(t, output.String(), "UnknownSpouseChild")
+}
