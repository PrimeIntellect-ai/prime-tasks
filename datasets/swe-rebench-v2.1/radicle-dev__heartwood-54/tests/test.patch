+#[test]
+fn test_ping_size_limits() {
+    // A ping generated for any seed must fit within the wire size limit.
+    for seed in 0..64u64 {
+        let mut rng = fastrand::Rng::with_seed(seed);
+        let ping = Ping::new(&mut rng);
+
+        assert!(ping.ponglen <= Ping::MAX_PONG_ZEROES);
+        assert!(ping.zeroes.len() <= Ping::MAX_PING_ZEROES as usize);
+
+        let mut buf = Vec::new();
+        Message::Ping(ping)
+            .encode(&mut buf)
+            .expect("a generated ping fits within the size limit");
+        assert!(buf.len() <= wire::Size::MAX as usize);
+    }
+}
+
+#[test]
+fn test_oversized_message_is_rejected() {
+    // A message whose encoded size exceeds the wire limit must not be encodable.
+    let msg = Message::Pong {
+        zeroes: ZeroBytes::new(wire::Size::MAX),
+    };
+    let mut buf = Vec::new();
+    assert!(
+        msg.encode(&mut buf).is_err(),
+        "messages larger than the wire size limit must be rejected"
+    );
+}
