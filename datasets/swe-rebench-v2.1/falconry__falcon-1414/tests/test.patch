+        # Each raw cookie must be emitted as its own Set-Cookie header line,
+        # rather than being combined into a single comma-delimited value.
+        env = testing.create_environ(path='/', method='POST')
+        captured = []
+
+        def start_response(status, headers, exc_info=None):
+            captured.extend(headers)
+            return lambda chunk: None
+
+        client.app(env, start_response)
+
+        set_cookie_values = [v for n, v in captured if n.lower() == 'set-cookie']
+        assert len(set_cookie_values) == 2
+        assert set(set_cookie_values) == {
+            'ut_existing_user=1; expires=Mon, 14-Jan-2019 21:20:08 GMT; Max-Age=600; path=/',
+            'partner_source=deleted; expires=Thu, 01-Jan-1970 00:00:01 GMT; Max-Age=0',
+        }
+
+    @pytest.mark.parametrize('header_name', ['Set-Cookie', 'set-cookie', 'seT-cookie'])
+    def test_set_cookie_disallowed(self, client, header_name):
+        resp = falcon.Response()
+
+        cookie = 'ut_existing_user=1; expires=Mon, 14-Jan-2019 21:20:08 GMT; Max-Age=600; path=/'
+
+        with pytest.raises(ValueError):
+            resp.set_header(header_name, cookie)
+
+        with pytest.raises(ValueError):
+            resp.set_headers([(header_name, cookie)])
+
+        with pytest.raises(ValueError):
+            resp.set_headers({header_name: cookie})
+
+        with pytest.raises(ValueError):
+            resp.get_header(header_name)
+
+        with pytest.raises(ValueError):
+            resp.delete_header(header_name)
+
+    def test_header_not_supported_is_value_error(self):
+        assert issubclass(falcon.errors.HeaderNotSupported, ValueError)
 
