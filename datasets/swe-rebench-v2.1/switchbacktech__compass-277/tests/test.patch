+import dayjs from "dayjs";
+import React from "react";
+import { configureStore } from "@reduxjs/toolkit";
+import "@testing-library/jest-dom";
+import { screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { Categories_Event } from "@core/types/event.types";
+import { render } from "@web/__tests__/__mocks__/mock.render";
+import { sagaMiddleware } from "@web/common/store/middlewares";
+import {
+  selectDraft,
+  selectDraftCategory,
+  selectIsDrafting,
+} from "@web/ducks/events/selectors/draft.selectors";
+import { reducers } from "@web/store/reducers";
+import CmdPalette from "@web/views/CmdPalette/CmdPalette";
+import { assembleDefaultEvent } from "../event.util";
+
+jest.mock("@web/auth/auth.util", () => ({
+  getUserId: jest.fn().mockResolvedValue("mock-user-id"),
+}));
+
+describe("assembleDefaultEvent", () => {
+  it("should include dates for a someday week event when provided", async () => {
+    const startDate = "2024-01-01";
+    const endDate = "2024-01-07";
+    const eventWithDates = await assembleDefaultEvent(
+      Categories_Event.SOMEDAY_WEEK,
+      startDate,
+      endDate,
+    );
+
+    expect(eventWithDates).toHaveProperty("startDate", startDate);
+    expect(eventWithDates).toHaveProperty("endDate", endDate);
+  });
+
+  it("dates should be empty for a someday week event when not provided", async () => {
+    const eventWithoutDates = await assembleDefaultEvent(
+      Categories_Event.SOMEDAY_WEEK,
+    );
+
+    expect(eventWithoutDates).toHaveProperty("startDate", "");
+    expect(eventWithoutDates).toHaveProperty("endDate", "");
+  });
+
+  it("returns empty week-event dates when either date is missing", async () => {
+    for (const [startDate, endDate] of [
+      ["2024-01-01", undefined],
+      [undefined, "2024-01-07"],
+    ] as const) {
+      const event = await assembleDefaultEvent(
+        Categories_Event.SOMEDAY_WEEK,
+        startDate,
+        endDate,
+      );
+      expect(event.startDate).toBe("");
+      expect(event.endDate).toBe("");
+    }
+  });
+
+  it("should include dates for a someday month event when provided", async () => {
+    const startDate = "2024-01-01";
+    const endDate = "2024-01-31";
+    const eventWithDates = await assembleDefaultEvent(
+      Categories_Event.SOMEDAY_MONTH,
+      startDate,
+      endDate,
+    );
+
+    expect(eventWithDates).toHaveProperty("startDate", startDate);
+    expect(eventWithDates).toHaveProperty("endDate", endDate);
+  });
+
+  it("dates should be empty for a someday month event when not provided", async () => {
+    const eventWithoutDates = await assembleDefaultEvent(
+      Categories_Event.SOMEDAY_MONTH,
+    );
+
+    expect(eventWithoutDates).toHaveProperty("startDate", "");
+    expect(eventWithoutDates).toHaveProperty("endDate", "");
+  });
+
+  it("returns empty month-event dates when either date is missing", async () => {
+    for (const [startDate, endDate] of [
+      ["2024-01-01", undefined],
+      [undefined, "2024-01-31"],
+    ] as const) {
+      const event = await assembleDefaultEvent(
+        Categories_Event.SOMEDAY_MONTH,
+        startDate,
+        endDate,
+      );
+      expect(event.startDate).toBe("");
+      expect(event.endDate).toBe("");
+    }
+  });
+});
+
+describe("CmdPalette event creation", () => {
+  const makeStore = () =>
+    configureStore({
+      middleware: (getDefaultMiddleware) =>
+        getDefaultMiddleware().concat(sagaMiddleware),
+      reducer: reducers,
+      preloadedState: { settings: { isCmdPaletteOpen: true } } as any,
+    });
+
+  const props = {
+    today: dayjs(),
+    dateCalcs: {} as any,
+    isCurrentWeek: true,
+    startOfView: dayjs(),
+    endOfView: dayjs().add(6, "day"),
+    util: {} as any,
+    scrollUtil: {} as any,
+  };
+
+  const selectAction = async (label: RegExp) => {
+    const store = makeStore();
+    render(React.createElement(CmdPalette, props), { store });
+
+    await waitFor(() => {
+      expect(screen.getByText(label)).toBeInTheDocument();
+    });
+
+    const user = userEvent.setup();
+    await user.click(screen.getByText(label));
+
+    return store;
+  };
+
+  const selectActionWithEnter = async (label: RegExp, searchText: string) => {
+    window.HTMLElement.prototype.scrollIntoView = jest.fn();
+    const store = makeStore();
+    render(React.createElement(CmdPalette, props), { store });
+
+    const user = userEvent.setup();
+    await user.type(screen.getByRole("textbox"), searchText);
+    await waitFor(() => {
+      expect(screen.getByText(label)).toBeInTheDocument();
+    });
+    await user.keyboard("{ArrowDown}{Enter}");
+
+    return store;
+  };
+
+  it("starts a week-event draft when Create Week Event is selected", async () => {
+    const store = await selectAction(/Create Week Event/i);
+
+    await waitFor(() => {
+      expect(selectIsDrafting(store.getState())).toBe(true);
+    });
+    expect(selectDraftCategory(store.getState())).toBe(
+      Categories_Event.SOMEDAY_WEEK,
+    );
+    expect(selectDraft(store.getState())).toBeTruthy();
+  });
+
+  it("starts a month-event draft when Create Month Event is selected", async () => {
+    const store = await selectAction(/Create Month Event/i);
+
+    await waitFor(() => {
+      expect(selectIsDrafting(store.getState())).toBe(true);
+    });
+    expect(selectDraftCategory(store.getState())).toBe(
+      Categories_Event.SOMEDAY_MONTH,
+    );
+    expect(selectDraft(store.getState())).toBeTruthy();
+  });
+
+  it("starts an event draft when Create Event is selected", async () => {
+    const store = await selectAction(/Create Event/i);
+
+    await waitFor(() => {
+      expect(selectIsDrafting(store.getState())).toBe(true);
+    });
+    expect(selectDraftCategory(store.getState())).toBe(Categories_Event.TIMED);
+    expect(selectDraft(store.getState())).toBeTruthy();
+  });
+
+  it("starts a week-event draft when Create Week Event is activated with Enter", async () => {
+    const store = await selectActionWithEnter(
+      /Create Week Event/i,
+      "Create Week Event",
+    );
+
+    await waitFor(() => {
+      expect(selectIsDrafting(store.getState())).toBe(true);
+    });
+    expect(selectDraftCategory(store.getState())).toBe(
+      Categories_Event.SOMEDAY_WEEK,
+    );
+    expect(selectDraft(store.getState())).toBeTruthy();
+  });
+
+  it("starts a month-event draft when Create Month Event is activated with Enter", async () => {
+    const store = await selectActionWithEnter(
+      /Create Month Event/i,
+      "Create Month Event",
+    );
+
+    await waitFor(() => {
+      expect(selectIsDrafting(store.getState())).toBe(true);
+    });
+    expect(selectDraftCategory(store.getState())).toBe(
+      Categories_Event.SOMEDAY_MONTH,
+    );
+    expect(selectDraft(store.getState())).toBeTruthy();
+  });
+
+  it("starts a timed-event draft when Create Event is activated with Enter", async () => {
+    const store = await selectActionWithEnter(/Create Event/i, "Create Event");
+
+    await waitFor(() => {
+      expect(selectIsDrafting(store.getState())).toBe(true);
+    });
+    expect(selectDraftCategory(store.getState())).toBe(Categories_Event.TIMED);
+    expect(selectDraft(store.getState())).toBeTruthy();
+  });
+});
