+func TestFlagsChanged(t *testing.T) {
+	cfg := &mockconfigurer{}
+	cfg.SetPath("K0sConfigPath", "/tmp/foo.yaml")
+	cfg.SetPath("K0sJoinTokenPath", "/tmp/token")
+	t.Run("simple", func(t *testing.T) {
+		h := Host{
+			Configurer:     cfg,
+			DataDir:        "/tmp/data",
+			Role:           "controller",
+			PrivateAddress: "10.0.0.1",
+			InstallFlags:   []string{"--foo"},
+			Metadata: HostMetadata{
+				K0sStatusArgs: []string{"--foo", "--data-dir=/tmp/data", "--token-file=/tmp/token", "--config=/tmp/foo.yaml"},
+			},
+		}
+		require.False(t, h.FlagsChanged())
+		h.InstallFlags = []string{"--bar"}
+		require.True(t, h.FlagsChanged())
+	})
+	t.Run("quoted values", func(t *testing.T) {
+		h := Host{
+			Configurer:     cfg,
+			DataDir:        "/tmp/data",
+			Role:           "controller",
+			PrivateAddress: "10.0.0.1",
+			InstallFlags:   []string{"--foo='bar'", "--bar=foo"},
+			Metadata: HostMetadata{
+				K0sStatusArgs: []string{"--foo=bar", `--bar="foo"`, "--data-dir=/tmp/data", "--token-file=/tmp/token", "--config=/tmp/foo.yaml"},
+			},
+		}
+		require.False(t, h.FlagsChanged())
+		h.InstallFlags = []string{"--foo=bar", `--bar="foo"`}
+		require.False(t, h.FlagsChanged())
+		h.InstallFlags = []string{"--foo=baz", `--bar="foo"`}
+		require.True(t, h.FlagsChanged())
+	})
+	t.Run("kubelet-extra-args and single", func(t *testing.T) {
+		h := Host{
+			Configurer:     cfg,
+			DataDir:        "/tmp/data",
+			Role:           "single",
+			PrivateAddress: "10.0.0.1",
+			InstallFlags:   []string{"--foo='bar'", `--kubelet-extra-args="--bar=foo --foo='bar'"`},
+			Metadata: HostMetadata{
+				K0sStatusArgs: []string{"--foo=bar", `--kubelet-extra-args="--bar=foo --foo='bar'"`, "--data-dir=/tmp/data", "--single=true", "--token-file=/tmp/token", "--config=/tmp/foo.yaml"},
+			},
+		}
+		flags, err := h.K0sInstallFlags()
+		require.NoError(t, err)
+		require.Equal(t, `--foo=bar --kubelet-extra-args='--bar=foo --foo='"'"'bar'"'"'' --data-dir=/tmp/data --single=true --token-file=/tmp/token --config=/tmp/foo.yaml`, flags.Join())
+		require.False(t, h.FlagsChanged())
+		h.InstallFlags = []string{"--foo='baz'", `--kubelet-extra-args='--bar=baz --foo="bar"'`}
+		flags, err = h.K0sInstallFlags()
+		require.NoError(t, err)
+		require.Equal(t, map[string]string{
+			"--foo":                "baz",
+			"--kubelet-extra-args": `--bar=baz --foo="bar"`,
+			"--data-dir":           "/tmp/data",
+			"--single":             "true",
+			"--token-file":         "/tmp/token",
+			"--config":             "/tmp/foo.yaml",
+		}, flags.Map())
+		require.True(t, h.FlagsChanged())
+	})
+	t.Run("worker with existing generated kubelet args", func(t *testing.T) {
+		h := Host{
+			Configurer:     cfg,
+			DataDir:        "/tmp/data",
+			Role:           "worker",
+			PrivateAddress: "10.0.0.1",
+			InstallFlags:   []string{`--kubelet-extra-args="--foo bar --node-ip=10.0.0.1"`},
+			Metadata: HostMetadata{
+				K0sStatusArgs: []string{`--kubelet-extra-args="--foo bar --node-ip=10.0.0.1"`, "--data-dir=/tmp/data", "--token-file=/tmp/token"},
+			},
+		}
+		flags, err := h.K0sInstallFlags()
+		require.NoError(t, err)
+		val := flags.GetValue("--kubelet-extra-args")
+		require.Contains(t, val, "--node-ip=10.0.0.1")
+		require.Equal(t, 1, strings.Count(val, "--node-ip="))
+		require.False(t, h.FlagsChanged())
+	})
+	t.Run("worker with hostname override", func(t *testing.T) {
+		h := Host{
+			Configurer:       cfg,
+			DataDir:          "/tmp/data",
+			Role:             "worker",
+			PrivateAddress:   "10.0.0.1",
+			HostnameOverride: "myhost",
+			InstallFlags:     []string{`--kubelet-extra-args="--foo bar"`},
+			Metadata: HostMetadata{
+				K0sStatusArgs: []string{`--kubelet-extra-args="--foo bar --node-ip=10.0.0.1 --hostname-override=myhost"`, "--data-dir=/tmp/data", "--token-file=/tmp/token"},
+			},
+		}
+		flags, err := h.K0sInstallFlags()
+		require.NoError(t, err)
+		val := flags.GetValue("--kubelet-extra-args")
+		require.Contains(t, val, "--node-ip=10.0.0.1")
+		require.Contains(t, val, "--hostname-override=myhost")
+		require.Equal(t, 1, strings.Count(val, "--node-ip="))
+		require.Equal(t, 1, strings.Count(val, "--hostname-override="))
+		require.False(t, h.FlagsChanged())
+	})
+	t.Run("worker with existing hostname override", func(t *testing.T) {
+		h := Host{
+			Configurer:       cfg,
+			DataDir:          "/tmp/data",
+			Role:             "worker",
+			HostnameOverride: "myhost",
+			InstallFlags:     []string{`--kubelet-extra-args="--foo bar --hostname-override=myhost"`},
+			Metadata: HostMetadata{
+				K0sStatusArgs: []string{`--kubelet-extra-args="--foo bar --hostname-override=myhost"`, "--data-dir=/tmp/data", "--token-file=/tmp/token"},
+			},
+		}
+		flags, err := h.K0sInstallFlags()
+		require.NoError(t, err)
+		val := flags.GetValue("--kubelet-extra-args")
+		require.Contains(t, val, "--hostname-override=myhost")
+		require.Equal(t, 1, strings.Count(val, "--hostname-override="))
+		require.False(t, h.FlagsChanged())
+	})
+	t.Run("controller+worker with existing generated kubelet args", func(t *testing.T) {
+		h := Host{
+			Configurer:     cfg,
+			DataDir:        "/tmp/data",
+			Role:           "controller+worker",
+			PrivateAddress: "10.0.0.1",
+			InstallFlags:   []string{`--kubelet-extra-args="--foo bar --node-ip=10.0.0.1"`},
+			Metadata: HostMetadata{
+				K0sStatusArgs: []string{`--kubelet-extra-args="--foo bar --node-ip=10.0.0.1"`, "--data-dir=/tmp/data", "--enable-worker", "--token-file=/tmp/token", "--config=/tmp/foo.yaml"},
+			},
+		}
+		flags, err := h.K0sInstallFlags()
+		require.NoError(t, err)
+		val := flags.GetValue("--kubelet-extra-args")
+		require.Contains(t, val, "--node-ip=10.0.0.1")
+		require.Equal(t, 1, strings.Count(val, "--node-ip="))
+		require.False(t, h.FlagsChanged())
+	})
+}
