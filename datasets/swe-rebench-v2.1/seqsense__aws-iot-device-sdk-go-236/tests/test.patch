+func TestGetThenDesireWithOmittedState(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+
+	var s Shadow
+	var cli *mockDevice
+	cli = &mockDevice{Client: &mockmqtt.Client{
+		PublishFn: func(ctx context.Context, msg *mqtt.Message) error {
+			var req struct {
+				ClientToken string `json:"clientToken"`
+			}
+			if err := json.Unmarshal(msg.Payload, &req); err != nil {
+				t.Errorf("decode request: %v", err)
+				return err
+			}
+
+			var topic string
+			var response map[string]interface{}
+			switch msg.Topic {
+			case "$aws/things/test/shadow/get":
+				topic = "$aws/things/test/shadow/get/accepted"
+				response = map[string]interface{}{"version": 1}
+			case "$aws/things/test/shadow/update":
+				topic = "$aws/things/test/shadow/update/accepted"
+				response = map[string]interface{}{
+					"state":       map[string]interface{}{"desired": map[string]interface{}{"foo": "bar"}},
+					"version":     2,
+					"clientToken": req.ClientToken,
+				}
+			default:
+				t.Errorf("unexpected publish topic %q", msg.Topic)
+				return errors.New("unexpected publish topic")
+			}
+			if topic == "$aws/things/test/shadow/get/accepted" {
+				response["clientToken"] = req.ClientToken
+			}
+			payload, err := json.Marshal(response)
+			if err != nil {
+				t.Errorf("encode response: %v", err)
+				return err
+			}
+			go cli.Serve(&mqtt.Message{Topic: topic, Payload: payload})
+			return nil
+		},
+	}}
+
+	var err error
+	s, err = New(ctx, cli)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cli.Handle(s)
+
+	if _, err := s.Get(ctx); err != nil {
+		t.Fatalf("Get: %v", err)
+	}
+	doc, err := s.Desire(ctx, NestedState{"foo": "bar"})
+	if err != nil {
+		t.Fatalf("Desire after Get: %v", err)
+	}
+	if got := doc.State.Desired["foo"]; got != "bar" {
+		t.Errorf("desired state after update: got %v, want %v", got, "bar")
+	}
+}
