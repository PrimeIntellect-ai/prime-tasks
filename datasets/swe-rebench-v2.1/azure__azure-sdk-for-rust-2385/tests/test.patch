     }
-
-    async fn clear_cache(&self) -> azure_core::Result<()> {
-        Ok(())
-    }
 }
 
 /// Gets a `TokenCredential` appropriate for the current environment.
@@ -68,3 +64,35 @@ pub fn from_env(
             as Arc<dyn TokenCredential>,
     )
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Probe trait sharing the name of the method that was removed from `TokenCredential`.
+    ///
+    /// If `TokenCredential` still exposed a `clear_cache` method on `MockCredential`, the call
+    /// below would be ambiguous and this module would fail to compile.
+    trait ClearCacheProbe {
+        fn clear_cache(&self) -> bool {
+            true
+        }
+    }
+
+    impl ClearCacheProbe for MockCredential {}
+
+    #[test]
+    fn token_credential_has_no_clear_cache_method() {
+        assert!(MockCredential.clear_cache());
+    }
+
+    #[tokio::test]
+    async fn get_token_issues_token_through_trait_object() {
+        let credential: Arc<dyn TokenCredential> = Arc::new(MockCredential);
+        let token = credential
+            .get_token(&["https://example.invalid/.default"])
+            .await
+            .expect("mock credential should issue a token");
+        assert!(token.token.secret().contains("https://example.invalid/.default"));
+    }
+}
