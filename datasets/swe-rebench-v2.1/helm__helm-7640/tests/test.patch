+func TestUpgradeWithValuesFromStdin(t *testing.T) {
+
+	releaseName := "funny-bunny-v5"
+	relMock, ch, chartPath := prepareMockRelease(releaseName, t)
+
+	defer resetEnv()()
+
+	store := storageFixture()
+
+	store.Create(relMock(releaseName, 3, ch))
+
+	in, err := os.Open("testdata/testcharts/upgradetest/values.yaml")
+	if err != nil {
+		t.Errorf("unexpected error, got '%v'", err)
+	}
+
+	cmd := fmt.Sprintf("upgrade %s --values - '%s'", releaseName, chartPath)
+	_, _, err = executeActionCommandStdinC(store, in, cmd)
+	if err != nil {
+		t.Errorf("unexpected error, got '%v'", err)
+	}
+
+	updatedRel, err := store.Get(releaseName, 4)
+	if err != nil {
+		t.Errorf("unexpected error, got '%v'", err)
+	}
+
+	if !strings.Contains(updatedRel.Manifest, "drink: beer") {
+		t.Errorf("The value is not set correctly. manifest: %s", updatedRel.Manifest)
+	}
+}
+
+func TestUpgradeWithStdinAndValuesFile(t *testing.T) {
+	releaseName := "funny-bunny-v7"
+	relMock, ch, chartPath := prepareMockRelease(releaseName, t)
+	defer resetEnv()()
+
+	store := storageFixture()
+	store.Create(relMock(releaseName, 3, ch))
+
+	stdin, err := ioutil.TempFile("", "helm-stdin-values-*.yaml")
+	if err != nil {
+		t.Fatalf("could not create stdin values: %v", err)
+	}
+	defer os.Remove(stdin.Name())
+	defer stdin.Close()
+	if _, err := stdin.WriteString("favoriteDrink: tea\n"); err != nil {
+		t.Fatalf("could not write stdin values: %v", err)
+	}
+	if _, err := stdin.Seek(0, 0); err != nil {
+		t.Fatalf("could not rewind stdin values: %v", err)
+	}
+
+	cmd := fmt.Sprintf("upgrade %s -f - -f testdata/testcharts/upgradetest/values.yaml '%s'", releaseName, chartPath)
+	_, _, err = executeActionCommandStdinC(store, stdin, cmd)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	updatedRel, err := store.Get(releaseName, 4)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if !strings.Contains(updatedRel.Manifest, "drink: beer") {
+		t.Errorf("later values file was not applied: manifest: %s", updatedRel.Manifest)
+	}
+}
+
