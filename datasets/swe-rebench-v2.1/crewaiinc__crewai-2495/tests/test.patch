@@ -0,0 +1,41 @@
+from unittest.mock import MagicMock
+
+from crewai.memory.contextual.contextual_memory import ContextualMemory
+
+
+def _make_contextual_memory(um):
+    """Build contextual memory for the mem0 provider with no other memories."""
+    stm = MagicMock()
+    stm.search.return_value = []
+    ltm = MagicMock()
+    ltm.search.return_value = []
+    em = MagicMock()
+    em.search.return_value = []
+    return ContextualMemory(
+        memory_config={"provider": "mem0", "config": {"user_id": "john"}},
+        stm=stm,
+        ltm=ltm,
+        em=em,
+        um=um,
+    )
+
+
+def test_contextual_memory_without_user_memory_does_not_raise():
+    """Without configured user memory, task context is empty and safe to build."""
+    contextual_memory = _make_contextual_memory(um=None)
+    task = MagicMock()
+    task.description = "What is your favorite vacation destination?"
+
+    assert contextual_memory.build_context_for_task(task, "") == ""
+
+
+def test_contextual_memory_includes_user_memory():
+    """Retrieved user memories are included in the task context."""
+    um = MagicMock()
+    um.search.return_value = [{"memory": "The user prefers Airbnb over hotels."}]
+    contextual_memory = _make_contextual_memory(um=um)
+    task = MagicMock()
+    task.description = "What is your favorite vacation destination?"
+
+    context = contextual_memory.build_context_for_task(task, "")
+    assert "The user prefers Airbnb over hotels." in context
