+
+def test_polars_series_repr() -> None:
+    pytest.importorskip("polars")
+    import polars as pl
+
+    df = nw.from_native(pl.DataFrame({"col1": [None, 2], "col2": [3, 7]}))
+    s = df["col1"]
+    result = repr(s)
+    lines = result.splitlines()
+    # Tabs from the backend repr must not leak into the box.
+    assert "\t" not in result
+    # The box is rectangular: every line has the same width.
+    assert len({len(line) for line in lines}) == 1
+    assert lines[0].startswith("┌")
+    assert lines[-1].startswith("└")
+    assert "Narwhals Series" in lines[1]
+    # The native content is kept intact, in order, inside the box.
+    content = [line[1:-1].strip() for line in lines[3:-1]]
+    assert content == [
+        "shape: (2,)",
+        "Series: 'col1' [i64]",
+        "[",
+        "null",
+        "2",
+        "]",
+    ]
