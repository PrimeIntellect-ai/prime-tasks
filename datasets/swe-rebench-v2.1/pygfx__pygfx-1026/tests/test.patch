+def test_binding_recollection():
+    # When bindings are (re)collected, bindings and binding-derived template
+    # variables that are no longer produced must not survive from an earlier
+    # collection, while template variables set at init must be kept.
+
+    class MyShader(LocalBaseShader):
+        def get_code(self):
+            return "{{bindings_code}} {$ if use_extra is defined $}EXTRA{$ else $}NONE{$ endif $}"
+
+        def get_bindings(self, wobject, shared):
+            if wobject.use_extra:
+                self["use_extra"] = True
+                bindings = {0: Binding("zz", "buffer/uniform", dict(foo="f4"))}
+                self.define_bindings(0, bindings)
+                return {0: bindings}
+            return {0: {}}
+
+    shader = MyShader(always=True)
+    assert hasattr(shader, "_template_vars_current")
+    assert hasattr(shader, "_template_vars_bindings")
+
+    # First collection: the extra binding and template variable are present.
+    first_bindings = shader.get_bindings_info(SimpleNamespace(use_extra=True), None)
+    assert isinstance(first_bindings, dict)
+    assert set(first_bindings) == {0}
+    assert set(first_bindings[0]) == {0}
+    assert isinstance(first_bindings[0][0], Binding)
+    assert first_bindings[0][0].name == "zz"
+    assert "zz" in get_shader_code(shader)
+    assert "EXTRA" in shader.generate_wgsl()
+
+    # Second collection: the binding and template variable are gone.
+    collect_bindings(shader, SimpleNamespace(use_extra=False), None)
+    assert "zz" not in get_shader_code(shader)
+    assert "NONE" in shader.generate_wgsl()
+
+    # Template variables set at init are not cleared.
+    assert shader["always"] is True
+
+
+def test_env_map_recollection():
+    # Dynamically applying and removing an env_map must be reflected in the
+    # collected bindings.
+
+    class FakeShared:
+        def __init__(self):
+            self.uniform_buffer = Buffer(
+                array_from_shadertype(dict(foo="f4")), force_contiguous=True
+            )
+
+    geometry = gfx.box_geometry(1, 1, 1)
+    material = gfx.MeshStandardMaterial()
+    mesh = gfx.Mesh(geometry, material)
+    shader = MeshShader(mesh)
+    shared = FakeShared()
+    tracker = PropTracker()
+
+    def track_env_map_dependency():
+        with tracker.track_usage("bindings"):
+            material.env_map
+
+    # Track the material property consumed when shader bindings are selected.
+    track_env_map_dependency()
+
+    # Without an env_map there is no env-map binding.
+    collect_bindings(shader, mesh, shared)
+    assert "t_env_map" not in get_shader_code(shader)
+    assert "use_IBL" not in shader._template_vars_bindings
+
+    # Applying an env_map invalidates the bindings collected by the pipeline.
+    texture = gfx.Texture(np.zeros((10, 10, 6, 4), np.uint8), dim=2, size=(10, 10, 6))
+    material.env_map = gfx.TextureMap(texture)
+    assert tracker.pop_changed() == {"bindings"}
+    collect_bindings(shader, mesh, shared)
+    assert "t_env_map" in get_shader_code(shader)
+
+    # Removing it invalidates bindings again and removes all derived state.
+    track_env_map_dependency()
+    material.env_map = None
+    assert tracker.pop_changed() == {"bindings"}
+    collect_bindings(shader, mesh, shared)
+    assert "t_env_map" not in get_shader_code(shader)
+    assert "use_IBL" not in shader._template_vars_bindings
+
