+++ b/ross/tests/test_fluid_flow.py
@@ -0,0 +1,55 @@
+from ross.fluid_flow import fluid_flow as flow
+import math
+
+
+def _bearing(omega=157.1, visc=0.1):
+    return flow.PressureMatrix(
+        30, 20, 11, 0.03, omega, 0.0, 0.0, 0.0499, 0.05, 0.0, visc, 860.0
+    )
+
+
+def test_sommerfeld_number_for_known_load():
+    """A bearing reports a positive Sommerfeld number for a specified load."""
+    sommerfeld_number = _bearing().sommerfeld_number(525)
+
+    assert math.isfinite(sommerfeld_number)
+    assert sommerfeld_number > 0
+
+
+def test_sommerfeld_number_scales_inversely_with_load():
+    """Doubling the load halves the Sommerfeld number."""
+    bearing = _bearing()
+
+    s_light = bearing.sommerfeld_number(525)
+    s_heavy = bearing.sommerfeld_number(1050)
+
+    assert math.isclose(s_heavy, s_light / 2, rel_tol=1e-9)
+
+
+def test_sommerfeld_number_scales_with_speed_and_viscosity():
+    """The Sommerfeld number is proportional to speed and to viscosity."""
+    base = _bearing(omega=157.1, visc=0.1).sommerfeld_number(525)
+    faster = _bearing(omega=314.2, visc=0.1).sommerfeld_number(525)
+    thicker = _bearing(omega=157.1, visc=0.2).sommerfeld_number(525)
+
+    assert math.isclose(faster, 2 * base, rel_tol=1e-9)
+    assert math.isclose(thicker, 2 * base, rel_tol=1e-9)
+
+
+def test_eccentricity_ratio_for_known_load_satisfies_sommerfeld_quartic():
+    """The eccentricity inferred from a load satisfies its Sommerfeld quartic."""
+    bearing = _bearing()
+
+    eccentricity_ratio = bearing.calculate_eccentricity_ratio(525)
+    sommerfeld_number = bearing.sommerfeld_number(525)
+
+    assert 0 <= eccentricity_ratio <= 1
+    squared_ratio = eccentricity_ratio**2
+    quartic_value = (
+        squared_ratio**4
+        - 4 * squared_ratio**3
+        + (6 - sommerfeld_number**2 * (16 - math.pi**2)) * squared_ratio**2
+        - (4 + math.pi**2 * sommerfeld_number**2) * squared_ratio
+        + 1
+    )
+    assert math.isclose(quartic_value, 0.0, abs_tol=1e-7)
