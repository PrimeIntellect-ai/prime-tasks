 // Not part of enhanced-resolve
@@ -168,3 +174,26 @@ fn infinite_recursion() {
     let resolution = resolver.resolve(f, "./a");
     assert_eq!(resolution, Err(ResolveError::Recursion));
 }
+
+#[test]
+fn aliased_file_dependency_uses_native_path() {
+    let f = super::fixture();
+    let expected = f.join("alias/files/a.js");
+    let alias = format!("{}{}", f.join("alias").display(), std::path::MAIN_SEPARATOR);
+
+    let resolver = Resolver::new(ResolveOptions {
+        alias: vec![("@app".into(), vec![AliasValue::Path(alias)])],
+        ..ResolveOptions::default()
+    });
+    let mut ctx = ResolveContext::default();
+
+    let _ = resolver.resolve_with_context(&f, "@app/files/a", &mut ctx);
+
+    let recorded = ctx
+        .file_dependencies
+        .iter()
+        .find(|path| **path == expected)
+        .expect("the resolved aliased file should be a file dependency");
+    assert_eq!(recorded.to_string_lossy(), expected.to_string_lossy());
+    check_slash(recorded);
+}
