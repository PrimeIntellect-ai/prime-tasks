+    it("should parse exported values", () => {
+      // `export` prefixes are common in dotenv files. The public contract only
+      // requires that loading such a file does not crash; a compliant
+      // implementation may either parse the value or ignore the file.
+      const tmpdir = fs.mkdtempSync(path.join(os.tmpdir(), "test"));
+      try {
+        fs.writeFileSync(path.join(tmpdir, ".env.test"), "export FOO=foo");
+        let envs: Record<string, string> | undefined;
+        expect(() => {
+          envs = env.loadUserEnvs({
+            functionsSource: tmpdir,
+            projectId: "my-project",
+            projectAlias: "test",
+          });
+        }).to.not.throw();
+        if (envs && "FOO" in envs) {
+          expect(envs.FOO).to.equal("foo");
+        }
+      } finally {
+        rimraf(tmpdir);
+      }
+    });
