+func TestShutdownNodeLifecycleAppliesShutdownTaint(t *testing.T) {
+	ctx := context.Background()
+	id := 12345
+	providerID := providerIDPrefix + strconv.Itoa(id)
+	node := &v1.Node{
+		ObjectMeta: metav1.ObjectMeta{Name: "offline-node"},
+		Spec:       v1.NodeSpec{ProviderID: providerID},
+		Status: v1.NodeStatus{Conditions: []v1.NodeCondition{{
+			Type: v1.NodeReady, Status: v1.ConditionFalse,
+		}}},
+	}
+	kubeClient := fake.NewSimpleClientset(node)
+	factory := informers.NewSharedInformerFactory(kubeClient, 0)
+	nodeInformer := factory.Core().V1().Nodes()
+	if err := nodeInformer.Informer().GetIndexer().Add(node); err != nil {
+		t.Fatal(err)
+	}
+
+	ctrl := gomock.NewController(t)
+	client := NewMockClient(ctrl)
+	client.EXPECT().GetInstance(gomock.Any(), id).AnyTimes().Return(&linodego.Instance{
+		ID: id, Label: "offline-node", Status: linodego.InstanceOffline,
+	}, nil)
+	cloud := &linodeCloud{instances: newInstances(client)}
+	lifecycle, err := nodelifecycle.NewCloudNodeLifecycleController(nodeInformer, kubeClient, cloud, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	lifecycle.MonitorNodes()
+	updated, err := kubeClient.CoreV1().Nodes().Get(ctx, node.Name, metav1.GetOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, taint := range updated.Spec.Taints {
+		if taint.Key == cloudproviderapi.TaintNodeShutdown && taint.Effect == v1.TaintEffectNoSchedule {
+			return
+		}
+	}
+	t.Fatal("shutdown node was not marked with the Kubernetes shutdown taint")
+}
