+    def test_surge_exposure_multipart(self):
+        """CV: test surge exposure with a multipart shelf contour."""
+        workspace_dir = self.workspace_dir
+        srs = osr.SpatialReference()
+        srs.ImportFromEPSG(26910)  # UTM Zone 10N
+        wkt = srs.ExportToWkt()
+
+        shore_point_path = os.path.join(workspace_dir, 'shore_points.gpkg')
+        pygeoprocessing.shapely_geometry_to_vector(
+            [Point(0, 0)], shore_point_path, wkt, 'GPKG',
+            fields={'shore_id': ogr.OFTInteger},
+            attribute_list=[{'shore_id': 0}],
+            ogr_geom_type=ogr.wkbPoint)
+
+        shelf_contour_path = os.path.join(workspace_dir, 'shelf.gpkg')
+        line_a = LineString([(-100, -100), (100, 100)])
+        line_b = LineString([(-100, 100), (100, -100)])
+        pygeoprocessing.shapely_geometry_to_vector(
+            [MultiLineString([line_a, line_b])], shelf_contour_path, wkt,
+            'GPKG', ogr_geom_type=ogr.wkbMultiLineString)
+
+        target_pickle_path = os.path.join(workspace_dir, 'surge.pickle')
+        coastal_vulnerability.calculate_surge_exposure(
+            shore_point_path, shelf_contour_path, target_pickle_path)
+
+        with open(target_pickle_path, 'rb') as pickle_file:
+            result = pickle.load(pickle_file)
+        # The shore point lies on the shelf contour, so its distance is 0.
+        self.assertEqual(result[0], 0.0)
+
