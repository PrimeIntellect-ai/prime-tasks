     def test_python_version_defaults(self):
         tag = next(tags.cpython_tags(abis=["abi3"], platforms=["any"]))
         interpreter = "cp" + tags._version_nodot(sys.version_info[:2])
         assert interpreter == tag.interpreter
 
+    def test_disable_gil_default_abis_omit_abi3(self, monkeypatch):
+        config = {
+            "Py_DEBUG": 0,
+            "WITH_PYMALLOC": 0,
+            "Py_NOGIL": 1,
+            "EXT_SUFFIX": ".cpython-313t-x86_64-linux-gnu.so",
+        }
+        monkeypatch.setattr(sysconfig, "get_config_var", config.get)
+        result = list(tags.cpython_tags((3, 13), platforms=["plat1"]))
+        assert any(tag.abi.startswith("cp313") and "t" in tag.abi for tag in result)
+        assert not any(tag.abi == "abi3" for tag in result)
+        assert tags.Tag("cp313", "none", "plat1") in result
+
     def test_abi_defaults(self, monkeypatch):
         monkeypatch.setattr(tags, "_cpython_abis", lambda _1, _2: ["cp38"])
         result = list(tags.cpython_tags((3, 8), platforms=["any"]))
