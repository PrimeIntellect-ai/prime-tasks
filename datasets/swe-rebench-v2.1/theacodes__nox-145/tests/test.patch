+def _run_main(noxfile, argv_extra=(), run_sessions=False):
+    """Run ``nox.__main__.main`` against ``noxfile``.
+
+    Returns the global configuration that was handed to the workflow. Unless
+    ``run_sessions`` is true the session execution step is skipped so that only
+    configuration handling is exercised.
+    """
+    cwd = os.getcwd()
+    sys.argv = [sys.executable, "--noxfile", str(noxfile)] + list(argv_extra)
+    real_execute = nox.workflow.execute
+    captured = {}
+
+    def fake_execute(workflow, global_config):
+        captured["config"] = global_config
+        return real_execute(workflow, global_config)
+
+    try:
+        with mock.patch("nox.workflow.execute", side_effect=fake_execute):
+            with mock.patch.object(sys, "exit"):
+                if run_sessions:
+                    nox.__main__.main()
+                else:
+                    with mock.patch("nox.tasks.run_manifest", return_value=[]):
+                        nox.__main__.main()
+    finally:
+        os.chdir(cwd)
+    return captured["config"]
+
