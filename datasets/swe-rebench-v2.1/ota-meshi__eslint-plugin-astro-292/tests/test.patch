diff --git a/tests/src/integration/client-typescript.ts b/tests/src/integration/client-typescript.ts
new file mode 100644
index 0000000..1411184
--- /dev/null
+++ b/tests/src/integration/client-typescript.ts
@@ -0,0 +1,84 @@
+import { ESLint } from "eslint"
+import astroPlugin from "../../../src/index"
+import assert from "assert"
+import Module from "module"
+
+describe("Integration test for client-side ts", () => {
+  // @ts-expect-error -- ignore
+  const originalLoad = Module._load
+  before(() => {
+    // @ts-expect-error -- ignore
+    Module._load = function (name, ...args) {
+      if (name === "eslint-plugin-astro") {
+        return astroPlugin
+      }
+      return originalLoad(name, ...args)
+    }
+  })
+  after(() => {
+    // @ts-expect-error -- ignore
+    Module._load = originalLoad
+  })
+  it("should lint TypeScript in client-side scripts", async () => {
+    const processorNames = [
+      undefined,
+      ...Object.keys(astroPlugin.processors).map((name) => `astro/${name}`),
+    ]
+    const source = `
+          <script>
+          const map: Map<string, string> = new Map<string, string>()
+          </script>
+          `
+    const lintResults = await Promise.all(
+      processorNames.map(async (processor) => {
+        const eslint = new ESLint({
+          plugins: {
+            astro: astroPlugin as any,
+          },
+          useEslintrc: false,
+          overrideConfig: {
+            extends: ["plugin:astro/base"],
+            parser: "@typescript-eslint/parser",
+            rules: {
+              "no-restricted-syntax": ["error", "TSTypeAnnotation"],
+            },
+            overrides: [
+              {
+                files: ["*.astro"],
+                parser: "astro-eslint-parser",
+                parserOptions: {
+                  parser: "@typescript-eslint/parser",
+                  extraFileExtensions: [".astro"],
+                },
+                ...(processor ? { processor } : {}),
+              },
+            ],
+          },
+        })
+
+        return eslint.lintText(source, { filePath: "path/to/test.astro" })
+      }),
+    )
+
+    const messages = lintResults.flatMap((result) =>
+      result.flatMap((r) => r.messages),
+    )
+    const diagnostic = messages.find(
+      (message) => message.ruleId === "no-restricted-syntax",
+    )
+    assert(diagnostic, "the TypeScript type annotation should be linted")
+
+    const scriptLine = source.split("\n").findIndex((line) =>
+      line.includes("const map"),
+    ) + 1
+    const sourceLine = source.split("\n")[scriptLine - 1]
+    const annotationStart = sourceLine.indexOf(":") + 1
+    const annotationEnd = sourceLine.indexOf(" =") + 1
+    assert.strictEqual(diagnostic.line, scriptLine)
+    assert(
+      diagnostic.column >= annotationStart &&
+        diagnostic.column <= annotationEnd,
+      "the TypeScript diagnostic should point into the annotation in the Astro source",
+    )
+  })
+})
