+def directory_mark_flag():
+    """Find a public flag that marks directories in ordinary glob results."""
+
+    matches = glob.glob("*")
+    expected = {os.path.join(path, "") if os.path.isdir(path) else path for path in matches}
+    if expected == set(matches):
+        return None
+    candidates = {
+        value for name in dir(glob) if not name.startswith("_")
+        for value in [getattr(glob, name)]
+        if type(value) is int and value > 0 and value & (value - 1) == 0
+    }
+    for flag in candidates:
+        if set(glob.glob("*", flags=flag)) == expected:
+            return flag
+    return None
+
+
+MARK_FLAG = directory_mark_flag() or 0
+
+def test_directory_results_can_be_marked():
+    """An optional public flag adds a separator only to directory results."""
+
+    assert directory_mark_flag() is not None
+
