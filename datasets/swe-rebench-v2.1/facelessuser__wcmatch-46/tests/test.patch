+    def test_glob_integrity_marked(self):
+        """`globmatch` must match what glob globs with marked directories."""
+
+        # Number of slashes is inconsequential
+        # Glob really looks at what is in between. Multiple slashes are the same as one separator.
+        # UNC mounts are special cases and it matters there.
+        self.assertTrue(
+            all(
+                [
+                    glob.globmatch(
+                        x, '**/docs/**', flags=self.flags | MARK_FLAG
+                    ) for x in glob.glob('**/docs/**', flags=self.flags | MARK_FLAG)
+                ]
+            )
+        )
+        self.assertTrue(
+            all(
+                [
+                    glob.globmatch(
+                        x, '**/docs/**|!**/*.md', flags=self.flags | glob.SPLIT | MARK_FLAG
+                    ) for x in glob.glob('**/docs/**|!**/*.md', flags=self.flags | glob.SPLIT | MARK_FLAG)
+                ]
+            )
+        )
+
+        self.assertTrue(
+            all(
+                [
+                    glob.globmatch(
+                        x, '!**/*.md', flags=self.flags | glob.SPLIT | MARK_FLAG
+                    ) for x in glob.glob('!**/*.md', flags=self.flags | glob.SPLIT | MARK_FLAG)
+                ]
+            )
+        )
+        self.assertFalse(
+            all(
+                [
+                    glob.globmatch(
+                        x, '**/docs/**|!**/*.md', flags=self.flags | glob.SPLIT | MARK_FLAG
+                    ) for x in glob.glob('**/docs/**', flags=self.flags | glob.SPLIT | MARK_FLAG)
+                ]
+            )
+        )
+
