+
+# issue 1718
+@testset "Linked axes of linked axes" begin
+    # check that if linking axis A and B, where B has already been linked to C, A and C are also linked
+    f = Figure()
+    ax1 = Axis(f[1, 1])
+    ax2 = Axis(f[1, 2])
+    ax3 = Axis(f[1, 3])
+    linkaxes!(ax2, ax3)
+    linkaxes!(ax1, ax2)
+
+    axes = (ax1, ax2, ax3)
+    for (i, source) in enumerate(axes)
+        xlims!(source, 10i, 10i + 5)
+        @test all(ax -> first(extrema(ax.finallimits[]))[1] == 10i, axes)
+        @test all(ax -> last(extrema(ax.finallimits[]))[1] == 10i + 5, axes)
+
+        ylims!(source, 20i, 20i + 5)
+        @test all(ax -> first(extrema(ax.finallimits[]))[2] == 20i, axes)
+        @test all(ax -> last(extrema(ax.finallimits[]))[2] == 20i + 5, axes)
+    end
+end
