+
+  group('Logic', () {
+    test('generated constant assignments are sized', () async {
+      var mod = SwizzlyModule(Logic());
+      await mod.build();
+      final synthesized = mod.generateSynth();
+      final assignments = RegExp(
+              r'(?:assign\s+)?[A-Za-z_]\w*(?:\s*\[[^\]]+\])?\s*(?:<=|(?<![<>=!])=(?!=))\s*([^;]+);',
+              multiLine: true)
+          .allMatches(synthesized);
+      expect(assignments, isNotEmpty);
+
+      final sizedLiterals =
+          RegExp(r"(\d+)'[sS]?([bBoOdDhH])([0-9a-fA-F_xXzZ?]+)")
+              .allMatches(synthesized);
+      bool containsSizedValue(int width, int value) =>
+          sizedLiterals.any((literal) {
+            final base = literal.group(2)!.toLowerCase();
+            final radix = base == 'b'
+                ? 2
+                : base == 'o'
+                    ? 8
+                    : base == 'd'
+                        ? 10
+                        : 16;
+            final literalValue = int.tryParse(
+                literal.group(3)!.replaceAll('_', ''),
+                radix: radix);
+            return int.parse(literal.group(1)!) == width &&
+                literalValue == value;
+          });
+      expect(containsSizedValue(1, 1), isTrue);
+      expect(containsSizedValue(4, 15), isTrue);
+
+      for (final assignment in assignments) {
+        final rhs = assignment
+            .group(1)!
+            .replaceAll(RegExp(r'\[[^\]]*\]'), '')
+            .replaceAll(RegExp(r"\d+'[sS]?[bBoOdDhH][0-9a-fA-F_xXzZ_]+"), '');
+        expect(
+            rhs,
+            isNot(matches(RegExp(
+                r"(?<![\w'])\d+(?![\w'])|'[sS]?[bBoOdDhH][0-9a-fA-F_xXzZ_?]+|'[01xXzZ]\b"))));
+      }
+    });
+
+    test('simple swizzle', () async {
+      var mod = SwizzlyModule(Logic());
+      await mod.build();
+      var vectors = [
+        Vector({'a': 0}, {'b': bin('101'), 'direct': bin('1111')}),
+        Vector({'a': 1}, {'b': bin('111'), 'direct': bin('1111')}),
+      ];
+      await SimCompare.checkFunctionalVector(mod, vectors);
+      var simResult = SimCompare.iverilogVector(
+          mod.generateSynth(), mod.runtimeType.toString(), vectors,
+          signalToWidthMap: {'b': 3, 'direct': 4});
+      expect(simResult, equals(true));
+    });
+  });
 }
