+def test_eigenstates_ENR():
+    a1, a2 = qutip.enr_destroy([2, 2], 1)
+    H = a1.dag() * a1 + a2.dag() * a2
+    vals, vecs = H.eigenstates()
+    for val, vec in zip(vals, vecs):
+        assert val * vec == H @ vec
