+@pytest.mark.parametrize(
+    "package_spec_in,package_name",
+    [
+        ("https://github.com/ambv/black/archive/18.9b0.zip", "black"),
+        ("nox@https://github.com/ambv/black/archive/18.9b0.zip", "black"),
+        ("nox[extra]@https://github.com/ambv/black/archive/18.9b0.zip", "black"),
+        ("[broken", "black"),
+    ],
+)
+def test_fix_package_name(package_spec_in, package_name):
+    fixed_spec = package_specifier.fix_package_name(package_spec_in, package_name)
+    if package_spec_in.startswith("https://") or package_spec_in == "[broken":
+        assert fixed_spec == package_spec_in
+        return
+
+    original = Requirement(package_spec_in)
+    fixed = Requirement(fixed_spec)
+    assert fixed.name == package_name
+    assert set(fixed.extras) == set(original.extras)
+    assert fixed.url == original.url
+
