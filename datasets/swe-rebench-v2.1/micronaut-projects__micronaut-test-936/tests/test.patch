+// Validate the public managed JUnit accessor coordinates.
+[
+    'junit-jupiter-api': libs.managed.junit.jupiter.api,
+    'junit-jupiter-engine': libs.managed.junit.jupiter.engine,
+    'junit-jupiter-params': libs.managed.junit.jupiter.params
+].each { module, dependencyProvider ->
+    def dependency = dependencyProvider.get()
+    if (dependency.group != 'org.junit.jupiter' || dependency.name != module) {
+        throw new GradleException("Managed JUnit dependency must resolve to org.junit.jupiter:$module")
+    }
+}
