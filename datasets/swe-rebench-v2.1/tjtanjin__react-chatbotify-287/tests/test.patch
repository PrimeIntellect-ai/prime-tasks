+// __mocks__/fileMock.ts
+export const audioIcon = "../../assets/audio_icon.svg";
+export const audioIconDisabled = "../../assets/audio_icon_disabled.svg";
+export const actionDisabledIcon = "../../assets/action_disabled_icon.svg";
+export const botAvatar = "../../assets/bot_avatar.svg";
+export const closeChatIcon = "../../assets/close_chat_icon.svg";
+export const emojiIcon = "../../assets/emoji_icon.svg";
+export const notificationIcon = "../../assets/notification_icon.svg";
+export const notificationIconDisabled = "../../assets/notification_icon_disabled.svg";
+export const sendIcon = "../../assets/send_icon.svg";
+export const voiceIcon = "../../assets/voice_icon.svg";
+export const voiceIconDisabled = "../../assets/voice_icon_disabled.svg";
+
+// This module is also an asset mock. Register VoiceButton tests only when Jest
+// directly runs this file, so importing the mock elsewhere has no side effects.
+const testPath = (globalThis as any).expect?.getState?.().testPath;
+if (testPath?.endsWith("/__tests__/__mocks__/fileMock.ts")) {
+const React = require("react");
+const { render, screen } = require("@testing-library/react");
+const { TestChatBotProvider } = require("./TestChatBotContext");
+const VoiceButton = require("../../src/components/Buttons/VoiceButton/VoiceButton").default;
+
+const renderVoiceButton = (defaultToggledOn: boolean, ariaLabel?: string) => render(
+React.createElement(
+TestChatBotProvider,
+{
+initialSettings: {
+voice: { defaultToggledOn, icon: voiceIcon, iconDisabled: voiceIconDisabled },
+ariaLabel: { voiceButton: ariaLabel },
+},
+},
+React.createElement(VoiceButton)
+)
+);
+
+describe("VoiceButton", () => {
+	it("renders the icon with the configured disabled-state image", () => {
+		renderVoiceButton(false);
+		const icon = screen.getByTestId("rcb-voice-icon");
+
+		expect(icon.style.backgroundImage).toBe(`url(${voiceIconDisabled})`);
+	});
+
+	it("exposes a button role", () => {
+		renderVoiceButton(false);
+
+		expect(screen.getByRole("button")).toBeTruthy();
+	});
+
+	it("uses the configured accessible name", () => {
+		renderVoiceButton(false, "Accessible voice control");
+
+		expect(screen.getByRole("button", { name: "Accessible voice control" })).toBeTruthy();
+	});
+});
+}
