+describe('service worker fetch handler', function() {
+  var PRECACHED_URL = 'http://example.com/a.txt';
+
+  // Generates a service worker that precaches a single file, evaluates it in a
+  // sandbox that mimics the service worker global scope, and invokes the
+  // callback with the registered event listeners.
+  function loadServiceWorker(callback) {
+    var config = {
+      logger: NOOP,
+      staticFileGlobs: ['test/data/one/a.txt'],
+      stripPrefix: 'test/data/one'
+    };
+
+    generate(config, function(error, serviceWorkerString) {
+      assert.ifError(error);
+
+      var listeners = {};
+      var sandbox = {
+        self: {
+          location: 'http://example.com/',
+          registration: {scope: 'http://example.com/'},
+          addEventListener: function(type, listener) {
+            listeners[type] = listener;
+          },
+          clients: {
+            claim: function() {
+              return Promise.resolve();
+            }
+          },
+          skipWaiting: function() {
+            return Promise.resolve();
+          }
+        },
+        caches: {
+          open: function() {
+            return Promise.resolve({
+              keys: function() {
+                return Promise.resolve([]);
+              },
+              match: function() {
+                return Promise.resolve({});
+              },
+              put: function() {
+                return Promise.resolve();
+              },
+              delete: function() {
+                return Promise.resolve();
+              }
+            });
+          }
+        },
+        URL: URL,
+        Request: function() {},
+        Response: function() {},
+        fetch: function() {
+          return Promise.resolve({ok: true});
+        },
+        console: console,
+        Map: Map,
+        Set: Set,
+        Promise: Promise,
+        Array: Array
+      };
+
+      vm.createContext(sandbox);
+      vm.runInContext(serviceWorkerString, sandbox);
+      callback(listeners);
+    });
+  }
+
+  // Dispatches a GET fetch event for the given URL and returns whatever was
+  // passed to event.respondWith(), or undefined if respondWith() wasn't called.
+  function dispatchFetch(listeners, url) {
+    var respondedWith;
+    listeners.fetch({
+      request: {method: 'GET', url: url},
+      respondWith: function(response) {
+        respondedWith = response;
+      }
+    });
+    return respondedWith;
+  }
+
+  it('should respond from the cache for a precached URL', function(done) {
+    loadServiceWorker(function(listeners) {
+      assert(listeners.fetch, 'a fetch listener should be registered');
+      assert(dispatchFetch(listeners, PRECACHED_URL),
+        'respondWith() should be called for a precached URL');
+      done();
+    });
+  });
+
+  it('should treat a URL with a hash fragment as the same cache entry', function(done) {
+    loadServiceWorker(function(listeners) {
+      assert(dispatchFetch(listeners, PRECACHED_URL + '#hash'),
+        'respondWith() should be called for a precached URL with a hash fragment');
+      done();
+    });
+  });
+
+  it('should not respond from the cache for a URL that is not precached', function(done) {
+    loadServiceWorker(function(listeners) {
+      assert.strictEqual(dispatchFetch(listeners, 'http://example.com/not-precached.txt'),
+        undefined, 'respondWith() should not be called for a non-precached URL');
+      done();
+    });
+  });
+});
+
