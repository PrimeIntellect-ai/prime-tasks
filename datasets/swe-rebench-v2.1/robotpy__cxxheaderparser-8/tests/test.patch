+def test_fn_typename_param():
+    content = """
+      class Foo
+      {
+      public:
+      void MethodA(const mynamespace::SomeObject &x,
+                   typename mynamespace::SomeObject * = 0);
+      };
+    """
+    data = parse_string(content, cleandoc=True)
+
+    assert len(data.namespace.classes) == 1
+    methods = data.namespace.classes[0].methods
+    assert len(methods) == 1
+    method = methods[0]
+    assert method.name.segments[-1].name == "MethodA"
+    assert len(method.parameters) == 2
+    second_parameter = method.parameters[1]
+    assert [segment.name for segment in second_parameter.type.ptr_to.typename.segments] == [
+        "mynamespace",
+        "SomeObject",
+    ]
+    assert [token.value for token in second_parameter.default.tokens] == ["0"]
+
+
