+import { BasicConfig } from '../../../configs/BasicConfig';
+import { call } from '../../../util/Util';
+
+describe('A server handling HEAD requests', (): void => {
+  it('answers a HEAD request for an existing resource with a success status and no body.', async(): Promise<void> => {
+    const handler = new BasicConfig().getHttpHandler();
+
+    // Create a resource that has content
+    let response = await call(
+      handler,
+      new URL('http://test.com/'),
+      'POST',
+      { 'content-type': 'text/turtle', 'transfer-encoding': 'chunked' },
+      [ '<http://test.com/s> <http://test.com/p> <http://test.com/o>.' ],
+    );
+    expect(response.statusCode).toBe(200);
+    const requestUrl = new URL(response._getHeaders().location as string);
+
+    // The resource really has data
+    response = await call(handler, requestUrl, 'GET', { accept: 'text/turtle' }, []);
+    expect(response.statusCode).toBe(200);
+    expect(response._getData()).toContain('<http://test.com/s> <http://test.com/p> <http://test.com/o>.');
+
+    // HEAD succeeds without a body
+    response = await call(handler, requestUrl, 'HEAD', {}, []);
+    expect(response.statusCode).toBe(200);
+    expect(response._getData()).toHaveLength(0);
+  });
+});
