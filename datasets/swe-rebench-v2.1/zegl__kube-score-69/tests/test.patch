@@ -0,0 +1,34 @@
+package score
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/zegl/kube-score/score/cronjob"
+	"github.com/zegl/kube-score/scorecard"
+	batchv1beta1 "k8s.io/api/batch/v1beta1"
+)
+
+func TestCronJobHasDeadline(t *testing.T) {
+	testExpectedScore(t, "cronjob-deadline-set.yaml", "CronJob has deadline", 10)
+}
+
+func TestCronJobNotHasDeadline(t *testing.T) {
+	testExpectedScore(t, "cronjob-deadline-not-set.yaml", "CronJob has deadline", 1)
+}
+
+func TestScoreCronJobHasDeadline(t *testing.T) {
+	deadline := int64(100)
+	withDeadline := batchv1beta1.CronJob{}
+	withDeadline.Spec.StartingDeadlineSeconds = &deadline
+
+	score := cronjob.ScoreCronJobHasDeadline(withDeadline)
+	assert.Equal(t, "CronJob has deadline", score.Name)
+	assert.Equal(t, scorecard.Grade(scorecard.GradeAllOK), score.Grade)
+
+	withoutDeadline := batchv1beta1.CronJob{}
+	score = cronjob.ScoreCronJobHasDeadline(withoutDeadline)
+	assert.Equal(t, "CronJob has deadline", score.Name)
+	assert.Equal(t, scorecard.Grade(scorecard.GradeCritical), score.Grade)
+	assert.NotEmpty(t, score.Comments)
+}
