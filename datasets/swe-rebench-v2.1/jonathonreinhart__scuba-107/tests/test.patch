+class TestCommonScriptSchema(TmpDirTestCase):
+    def test_alias_mapping_accepts_string_script(self):
+        with open('.scuba.yml', 'w') as f:
+            f.write('''image: busybox
+aliases:
+  foo:
+    script: echo Hello
+''')
+
+        config = scuba.config.load_config('.scuba.yml')
+        result = config.process_command(['foo'])
+
+        commands = [result.script] if isinstance(result.script, str) else result.script
+        assert_equal(len(commands), 1)
+        assert_equal(shlex_split(commands[0]), ['echo', 'Hello'])
 
