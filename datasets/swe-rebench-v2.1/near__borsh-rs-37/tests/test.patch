+#[test]
+fn test_phantom_data_serializes_to_zero_bytes() {
+    let pd: PhantomData<[u8]> = PhantomData;
+    let data = pd.try_to_vec().unwrap();
+    assert!(data.is_empty());
+}
+
+#[test]
+fn test_phantom_data_deserializes_without_consuming_bytes() {
+    let mut buf: &[u8] = &[1, 2, 3];
+    let pd = <PhantomData<[u8]>>::deserialize(&mut buf).unwrap();
+    assert_eq!(pd, PhantomData);
+    assert_eq!(buf, &[1, 2, 3]);
+}
