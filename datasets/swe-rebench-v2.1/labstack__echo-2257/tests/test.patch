+func TestCSRFCustomErrorHandlerResponse(t *testing.T) {
+	cfg := CSRFConfig{}
+	handlerField, ok := reflect.TypeOf(cfg).FieldByName("ErrorHandler")
+	if !ok {
+		t.Fatal("CSRF configuration does not expose an error handler")
+	}
+	reflect.ValueOf(&cfg).Elem().FieldByName(handlerField.Name).Set(reflect.MakeFunc(handlerField.Type, func(args []reflect.Value) []reflect.Value {
+		return []reflect.Value{reflect.ValueOf(error(echo.NewHTTPError(http.StatusTeapot, "error_handler_executed")))}
+	}))
+
+	e := echo.New()
+	e.POST("/", func(c echo.Context) error {
+		return c.String(http.StatusNotImplemented, "should not end up here")
+	})
+
+	e.Use(CSRFWithConfig(cfg))
+
+	req := httptest.NewRequest(http.MethodPost, "/", nil)
+	res := httptest.NewRecorder()
+	e.ServeHTTP(res, req)
+
+	assert.Equal(t, http.StatusTeapot, res.Code)
+	assert.Contains(t, res.Body.String(), "error_handler_executed")
+}
