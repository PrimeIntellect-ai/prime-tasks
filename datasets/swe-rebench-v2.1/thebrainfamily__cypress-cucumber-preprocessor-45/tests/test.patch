@@ -57,3 +62,63 @@ describe("Background section", () => {
     readAndParseFeatureFile("./cypress/integration/BackgroundSection.feature")
   );
 });
+
+describe("Regular expressions", () => {
+  it("includes the regular-expression example files", () => {
+    expect(fs.existsSync("./cypress/support/step_definitions/regexp.js")).to.equal(
+      true
+    );
+    expect(fs.existsSync("./cypress/integration/RegularExpressions.feature")).to.equal(
+      true
+    );
+  });
+
+  it("matches a step defined with a regular expression and passes captured parameters", () => {
+    let captured;
+    given(/I choose (Apple|Banana)/, selection => {
+      captured = selection;
+    });
+
+    resolveAndRunStepDefinition({ keyword: "Given", text: "I choose Apple" });
+
+    expect(captured).to.equal("Apple");
+  });
+
+  it("matches a Then step defined with a regular expression", () => {
+    let captured;
+    then(/I see (Apple|Banana)/, value => {
+      captured = value;
+    });
+
+    resolveAndRunStepDefinition({ keyword: "Then", text: "I see Apple" });
+
+    expect(captured).to.equal("Apple");
+  });
+
+  it("passes a digit capture from a Then regular expression", () => {
+    let captured;
+    then(/I do (\d+)/, value => {
+      captured = value;
+    });
+
+    resolveAndRunStepDefinition({ keyword: "Then", text: "I do 2" });
+
+    expect(captured).to.be.oneOf(["2", 2]);
+  });
+
+  it("captures an optional group when present and leaves it empty when absent", () => {
+    const captured = [];
+    given(/I do a (exact)? ?search/, exactParam => {
+      captured.push(exactParam);
+    });
+
+    resolveAndRunStepDefinition({
+      keyword: "Given",
+      text: "I do a exact search"
+    });
+    resolveAndRunStepDefinition({ keyword: "Given", text: "I do a search" });
+
+    expect(captured[0]).to.equal("exact");
+    expect(captured[1]).to.be.oneOf([null, undefined, ""]);
+  });
+});
