+Feature: Regular Expressions
+  As a pro-developer
+  I want to be able to use the power of regular expression in my step definitions
+  So I can write more sophisticated tests
+
+  Scenario: Regular Expression Example
+    Given I choose Apple
+    Then Apple is chosen
+    When I choose Banana
+    Then Banana is chosen
\ No newline at end of file
diff --git a/cypress/support/step_definitions/regexp.js b/cypress/support/step_definitions/regexp.js
new file mode 100644
index 0000000..856a10a
--- /dev/null
+++ b/cypress/support/step_definitions/regexp.js
@@ -0,0 +1,10 @@
+/* global given then */
+let selectedFruit;
+
+given(/I choose (Apple|Banana)/, selection => {
+  selectedFruit = selection;
+});
+
+then("{word} is chosen", selection => {
+  expect(selectedFruit).to.equal(selection);
+});
