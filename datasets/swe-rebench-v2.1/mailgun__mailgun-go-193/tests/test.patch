+func TestDomainTrackingInterface(t *testing.T) {
+	tests := []struct {
+		path   string
+		fields map[string]string
+		update func(mailgun.Mailgun) error
+	}{
+		{
+			path:   "/domains/request.test/tracking/click",
+			fields: map[string]string{"active": "no"},
+			update: func(mg mailgun.Mailgun) error {
+				return mg.UpdateClickTracking(context.Background(), "request.test", "no")
+			},
+		},
+		{
+			path:   "/domains/request.test/tracking/open",
+			fields: map[string]string{"active": "yes"},
+			update: func(mg mailgun.Mailgun) error {
+				return mg.UpdateOpenTracking(context.Background(), "request.test", "yes")
+			},
+		},
+		{
+			path: "/domains/request.test/tracking/unsubscribe",
+			fields: map[string]string{
+				"active": "yes", "html_footer": "<p>HTML</p>", "text_footer": "Text",
+			},
+			update: func(mg mailgun.Mailgun) error {
+				return mg.UpdateUnsubscribeTracking(context.Background(), "request.test", "yes", "<p>HTML</p>", "Text")
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.path, func(t *testing.T) {
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+				if req.Method != http.MethodPut {
+					t.Errorf("request method = %q, want PUT", req.Method)
+				}
+				if !strings.HasSuffix(req.URL.Path, tt.path) {
+					t.Errorf("request path = %q, want suffix %q", req.URL.Path, tt.path)
+				}
+				if err := req.ParseForm(); err != nil {
+					t.Errorf("could not parse update parameters: %v", err)
+				}
+				for key, want := range tt.fields {
+					if got := req.Form.Get(key); got != want {
+						t.Errorf("parameter %q = %q, want %q", key, got, want)
+					}
+				}
+				w.WriteHeader(http.StatusOK)
+			}))
+			defer srv.Close()
+
+			mg := mailgun.NewMailgun(testDomain, testKey)
+			mg.SetAPIBase(srv.URL)
+			var client mailgun.Mailgun = mg
+			if err := tt.update(client); err != nil {
+				t.Fatalf("tracking update failed: %v", err)
+			}
+		})
+	}
+}
+
+func TestUpdateUnsubscribeTrackingOptionalFooters(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		if req.Method != http.MethodPut || !strings.HasSuffix(req.URL.Path, "/domains/optional.test/tracking/unsubscribe") {
+			t.Errorf("unexpected request: %s %s", req.Method, req.URL.Path)
+		}
+		if err := req.ParseForm(); err != nil {
+			t.Errorf("could not parse update parameters: %v", err)
+		}
+		if req.Form.Get("active") != "yes" {
+			t.Errorf("active parameter = %q, want yes", req.Form.Get("active"))
+		}
+		if got := req.Form.Get("html_footer"); got != "<p>Footer</p>" && got != "" {
+			t.Errorf("unexpected HTML footer: %q", got)
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer srv.Close()
+
+	mg := mailgun.NewMailgun(testDomain, testKey)
+	mg.SetAPIBase(srv.URL)
+	ctx := context.Background()
+	if err := mg.UpdateUnsubscribeTracking(ctx, "optional.test", "yes", "", ""); err != nil {
+		t.Fatalf("update with both optional footers omitted: %v", err)
+	}
+	if err := mg.UpdateUnsubscribeTracking(ctx, "optional.test", "yes", "<p>Footer</p>", ""); err != nil {
+		t.Fatalf("update with text footer omitted: %v", err)
+	}
+}
+
+type failingRoundTripper struct{}
+
+func (failingRoundTripper) RoundTrip(*http.Request) (*http.Response, error) {
+	return nil, errors.New("transport unavailable")
+}
+
+func TestDomainTrackingTransportErrors(t *testing.T) {
+	mg := mailgun.NewMailgun(testDomain, testKey)
+	mg.SetClient(&http.Client{Transport: failingRoundTripper{}})
+	ctx := context.Background()
+
+	ensure.NotNil(t, mg.UpdateClickTracking(ctx, testDomain, "yes"))
+	ensure.NotNil(t, mg.UpdateOpenTracking(ctx, testDomain, "yes"))
+	ensure.NotNil(t, mg.UpdateUnsubscribeTracking(ctx, testDomain, "yes", "", ""))
+}
