+#[test]
+fn test_ok_raw_template() {
+    let mut tera = Tera::default();
+    tera.add_template("tpl", &read_file("tests/templates/raw.html"));
+
+    let rendered = tera.render("tpl", Context::new()).unwrap();
+    assert!(rendered.contains("Hey there {{ name }}"));
+    assert!(!rendered.contains("{% raw %}"));
+    assert!(!rendered.contains("{% endraw %}"));
+}
