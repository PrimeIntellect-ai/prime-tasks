+mutable struct ReplacingColumnTable
+  names::Vector{Symbol}
+  data::Dict{Symbol,Vector{Int}}
+end
+
+Tables.istable(::Type{ReplacingColumnTable}) = true
+Tables.columnaccess(::Type{ReplacingColumnTable}) = true
+Tables.columns(table::ReplacingColumnTable) = table
+Tables.columnnames(table::ReplacingColumnTable) = table.names
+Tables.getcolumn(table::ReplacingColumnTable, name::Symbol) = copy(table.data[name])
+Tables.getcolumn(table::ReplacingColumnTable, index::Int) = Tables.getcolumn(table, table.names[index])
+Tables.schema(table::ReplacingColumnTable) = Tables.Schema(Tuple(table.names), Tuple(fill(Int, length(table.names))))
+Tables.materializer(::ReplacingColumnTable) = identity
+replacecolumn!(table::ReplacingColumnTable, name::Symbol, values::Vector{Int}) = (table.data[name] = values)
+
