+                mock.patch.object(ec2_module, 'get_cluster',
+                                  side_effect=ClusterNotFound('no cluster')), \
+                mock.patch.object(ec2_module, 'get_or_create_flintrock_security_groups',
+                                  return_value=[]), \
+                mock.patch.object(ec2_module, 'get_security_groups', return_value=[]), \
+                mock.patch.object(ec2_module, 'get_ec2_block_device_mappings', return_value=[]), \
+                mock.patch.object(ec2_module, 'boto3') as mock_boto3, \
+                mock.patch.object(ec2_module, 'generate_ssh_key_pair', return_value=None), \
+                mock.patch.object(ec2_module, 'provision_cluster'), \
+                mock.patch.object(ec2_module.time, 'sleep'), \
+                mock.patch('flintrock.flintrock.check_external_dependency'):
+            mock_vpc.return_value.id = 'vpc-1'
+            mock_boto3.resource.side_effect = fake_resource
+            result = runner.invoke(
+                cli,
+                _launch_args(identity_file.name) + ['--ec2-tag', tag],
+                obj={})
+        assert result.exit_code != 0
+        assert 'no such option' not in result.output
+    finally:
+        os.remove(identity_file.name)
