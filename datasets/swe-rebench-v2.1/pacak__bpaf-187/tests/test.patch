+#[test]
+fn derive_fallback_display_help() {
+    #[derive(Debug, Clone, Bpaf)]
+    #[allow(dead_code)]
+    #[bpaf(options)]
+    struct Config {
+        /// Listening port of HTTP server
+        #[bpaf(long, fallback(3000u16), display_fallback)]
+        http_port: u16,
+    }
+
+    let r = config()
+        .run_inner(Args::from(&["--help"]))
+        .unwrap_err()
+        .unwrap_stdout();
+
+    assert!(
+        r.contains("Listening port of HTTP server"),
+        "help output should contain the field description:\n{}",
+        r
+    );
+    assert!(
+        r.contains("[default: 3000]"),
+        "help output should document the fallback value:\n{}",
+        r
+    );
+    assert!(
+        r.find("Listening port of HTTP server").unwrap()
+            < r.find("[default: 3000]").unwrap(),
+        "fallback should follow its description:\n{}",
+        r
+    );
+}
+
+#[test]
+fn derive_fallback_debug_help() {
+    #[derive(Debug, Clone, Bpaf)]
+    #[allow(dead_code)]
+    #[bpaf(options)]
+    struct Config {
+        /// Path to the input file
+        #[bpaf(argument("PATH"), fallback(std::path::PathBuf::from("foo")), debug_fallback)]
+        path: std::path::PathBuf,
+    }
+
+    let r = config()
+        .run_inner(Args::from(&["--help"]))
+        .unwrap_err()
+        .unwrap_stdout();
+
+    let description = r.find("Path to the input file").unwrap();
+    let fallback = r.find(r#"[default: "foo"]"#).unwrap();
+    assert!(
+        description < fallback,
+        "fallback should follow its description:\n{}",
+        r
+    );
+}
+
+#[test]
+fn derive_fallback_is_not_shown_without_opt_in() {
+    #[derive(Debug, Clone, Bpaf)]
+    #[allow(dead_code)]
+    #[bpaf(options)]
+    struct Config {
+        /// Listening port of HTTP server
+        #[bpaf(long, fallback(3000u16))]
+        http_port: u16,
+    }
+
+    let r = config()
+        .run_inner(Args::from(&["--help"]))
+        .unwrap_err()
+        .unwrap_stdout();
+
+    assert!(r.contains("Listening port of HTTP server"));
+    assert!(
+        !r.contains("[default: 3000]"),
+        "unopted fallback appeared in help:\n{}",
+        r
+    );
+}
