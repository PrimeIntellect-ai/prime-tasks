+// storageClassJSONField matches the storage_class field in a JSON object,
+// including an adjacent comma, so that JSON comparisons do not depend on
+// whether an explicit storage class was set on the object.
+var storageClassJSONField = regexp.MustCompile(`,?"storage_class":"[^"]*"`)
+
+func stripStorageClassField(s string) string {
+	return storageClassJSONField.ReplaceAllString(s, "")
+}
