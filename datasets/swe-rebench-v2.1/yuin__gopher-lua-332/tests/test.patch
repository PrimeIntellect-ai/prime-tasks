+--issue #331
+function test()
+	-- An index above the number of extra arguments must be handled without
+	-- returning garbage: a compliant implementation may either clamp it
+	-- (returning no values) or raise an "index out of range" error.
+	local select_a = function()
+		return select(3, "1")
+	end
+	local ok_a, a = pcall(select_a)
+	assert(ok_a == false or a == nil)
+
+	-- An index below 1 is out of range and must raise an error.
+	local select_b = function()
+		return select(0)
+	end
+	assert(false == pcall(select_b))
+
+	local select_c = function()
+		return select(1/9)
+	end
+	assert(false == pcall(select_c))
+
+	-- A valid index returns the remaining arguments.
+	local select_d = function()
+		return select(1, "a")
+	end
+	assert("a" == select_d())
+
+	local select_e = function()
+		return select(3, "a", "b", "c")
+	end
+	assert("c" == select_e())
+
+	-- Negative indices count from the end of the argument list.
+	local select_g = function()
+		return select(-1, "a", "b", "c")
+	end
+	assert("c" == select_g())
+
+	local select_h = function()
+		return select(-2, "a", "b", "c")
+	end
+	assert("b" == select_h())
+
+	-- "#" returns the number of extra arguments.
+	assert(3 == select("#", "a", "b", "c"))
+	assert(0 == select("#"))
+
+	-- Unsupported string arguments raise an error.
+	local select_i = function()
+		return select("x", "a")
+	end
+	assert(false == pcall(select_i))
+
+	-- The reported input must not crash the interpreter.
+	local select_f = function()
+		return select(0)(select(1/9))
+	end
+	assert(false == pcall(select_f))
+end
+test()
