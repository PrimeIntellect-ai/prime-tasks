+func TestVariableTypeAndDefaultConfig(t *testing.T) {
+	configs := []struct {
+		name        string
+		config      string
+		wantDefault bool
+		wantType    bool
+	}{
+		{name: "configuration defaults", wantDefault: true, wantType: true},
+		{
+			name:        "both explicitly enabled",
+			config:      "settings:\n  default: true\n  type: true\n",
+			wantDefault: true,
+			wantType:    true,
+		},
+		{
+			name:        "default disabled independently",
+			config:      "settings:\n  default: false\n  type: true\n",
+			wantDefault: false,
+			wantType:    true,
+		},
+		{
+			name:        "type disabled independently",
+			config:      "settings:\n  default: true\n  type: false\n",
+			wantDefault: true,
+			wantType:    false,
+		},
+	}
+	formats := []string{
+		"asciidoc document",
+		"asciidoc table",
+		"markdown document",
+		"markdown table",
+	}
+	for _, formatName := range formats {
+		for _, tt := range configs {
+			t.Run(formatName+"/"+tt.name, func(t *testing.T) {
+				dir := t.TempDir()
+				if err := os.WriteFile(filepath.Join(dir, "main.tf"), []byte("variable \"foo\" {\n  type    = string\n  default = \"bar\"\n}\n"), 0644); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(filepath.Join(dir, "config.yaml"), []byte(tt.config), 0644); err != nil {
+					t.Fatal(err)
+				}
+
+				config := cli.DefaultConfig()
+				config.File = "config.yaml"
+				cmd := &cobra.Command{
+					Annotations: cli.Annotations(formatName),
+					PreRunE:     cli.PreRunEFunc(config),
+					RunE:        cli.RunEFunc(config),
+				}
+				if err := cmd.PreRunE(cmd, []string{dir}); err != nil {
+					t.Fatal(err)
+				}
+
+				var runErr error
+				out := captureStdout(t, func() {
+					runErr = cmd.RunE(cmd, []string{dir})
+				})
+				if runErr != nil {
+					t.Fatal(runErr)
+				}
+
+				assert.Equal(t, tt.wantDefault, strings.Contains(out, "Default"))
+				assert.Equal(t, tt.wantType, strings.Contains(out, "Type"))
+			})
+		}
+	}
+}
+
+func captureStdout(t *testing.T, fn func()) string {
+	t.Helper()
+
+	old := os.Stdout
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	os.Stdout = w
+	defer func() { os.Stdout = old }()
+
+	fn()
+
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	out, err := io.ReadAll(r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(out)
+}
