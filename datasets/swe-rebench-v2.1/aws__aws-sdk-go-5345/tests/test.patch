+func dlLoggingSvcWithVersions(data []byte, initial string) (*s3.S3, *[]string, *[]string, *[]string) {
+	var m sync.Mutex
+	versions := []string{}
+	etags := []string{}
+	names := []string{}
+
+	// Simulate the object being replaced after the first request. A correct
+	// downloader must return a single, consistent version of the object
+	// rather than mixing bytes from the old and new versions.
+	updated := make([]byte, len(data))
+	for i := range updated {
+		updated[i] = 0xFF
+	}
+	const (
+		versionA = "version-a"
+		versionB = "version-b"
+		etagA    = "etag-a"
+		etagB    = "etag-b"
+	)
+	current := initial
+	reqCount := 0
+
+	svc := s3.New(unit.Session)
+	svc.Handlers.Send.Clear()
+	svc.Handlers.Send.PushBack(func(r *request.Request) {
+		m.Lock()
+		defer m.Unlock()
+
+		names = append(names, r.Operation.Name)
+
+		// A compliant downloader may resolve the latest object version with a
+		// HeadObject request before issuing ranged GetObject requests. Support
+		// that strategy by returning the current version's metadata.
+		if r.Operation.Name == "HeadObject" {
+			version := current
+			etag := etagA
+			if version == versionB {
+				etag = etagB
+			}
+			r.HTTPResponse = &http.Response{
+				StatusCode: 200,
+				Body:       ioutil.NopCloser(bytes.NewReader(nil)),
+				Header:     http.Header{},
+			}
+			r.HTTPResponse.Header.Set("Content-Length", fmt.Sprintf("%d", len(data)))
+			r.HTTPResponse.Header.Set("Etag", etag)
+			r.HTTPResponse.Header.Set("x-amz-version-id", version)
+
+			// The object is updated after the first request completes.
+			reqCount++
+			if reqCount == 1 {
+				current = versionB
+			}
+			return
+		}
+
+		in, _ := r.Params.(*s3.GetObjectInput)
+		if in == nil {
+			return
+		}
+		versions = append(versions, aws.StringValue(in.VersionId))
+		etags = append(etags, aws.StringValue(in.IfMatch))
+
+		// Resolve which version this request is pinned to. Requests that do
+		// not pin a version observe the current (possibly updated) object.
+		version := current
+		if v := aws.StringValue(in.VersionId); v != "" {
+			version = v
+		} else if e := aws.StringValue(in.IfMatch); e != "" {
+			switch e {
+			case etagA:
+				version = versionA
+			case etagB:
+				version = versionB
+			}
+		}
+
+		body := data
+		etag := etagA
+		if version == versionB {
+			body = updated
+			etag = etagB
+		}
+
+		rerng := regexp.MustCompile(`bytes=(\d+)-(\d+)`)
+		rng := rerng.FindStringSubmatch(r.HTTPRequest.Header.Get("Range"))
+		start, fin := int64(0), int64(len(body))
+		if len(rng) == 3 {
+			start, _ = strconv.ParseInt(rng[1], 10, 64)
+			fin, _ = strconv.ParseInt(rng[2], 10, 64)
+			fin++
+		}
+		if fin > int64(len(body)) {
+			fin = int64(len(body))
+		}
+		bodyBytes := body[start:fin]
+
+		r.HTTPResponse = &http.Response{
+			StatusCode: 200,
+			Body:       ioutil.NopCloser(bytes.NewReader(bodyBytes)),
+			Header:     http.Header{},
+		}
+		r.HTTPResponse.Header.Set("Content-Range", fmt.Sprintf("bytes %d-%d/%d",
+			start, fin-1, len(body)))
+		r.HTTPResponse.Header.Set("Content-Length", fmt.Sprintf("%d", len(bodyBytes)))
+		r.HTTPResponse.Header.Set("Etag", etag)
+		r.HTTPResponse.Header.Set("x-amz-version-id", version)
+
+		// The object is updated after the first request completes.
+		reqCount++
+		if reqCount == 1 {
+			current = versionB
+		}
+	})
+
+	return svc, &names, &versions, &etags
+}
