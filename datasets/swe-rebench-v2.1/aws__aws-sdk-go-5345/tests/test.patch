+func dlLoggingSvcWithVersionMismatch() (*s3.S3, *bool) {
+	var m sync.Mutex
+	reqCount := int64(0)
+	preconditionReturned := false
+	body := bytes.NewReader(make([]byte, s3manager.DefaultDownloadPartSize))
+	svc := s3.New(unit.Session)
+	svc.Handlers.Send.Clear()
+	svc.Handlers.Send.PushBack(func(r *request.Request) {
+		m.Lock()
+		defer m.Unlock()
+
+		if r.Operation.Name == "HeadObject" {
+			r.HTTPResponse = &http.Response{
+				StatusCode: http.StatusOK,
+				Body:       ioutil.NopCloser(bytes.NewReader(nil)),
+				Header:     http.Header{},
+			}
+			r.HTTPResponse.Header.Set("Content-Length", fmt.Sprintf("%d", body.Len()))
+			r.HTTPResponse.Header.Set("Etag", etag)
+			r.HTTPResponse.Header.Set("x-amz-version-id", "vid")
+			return
+		}
+
+		statusCode := http.StatusOK
+		var eTag *string
+		switch atomic.LoadInt64(&reqCount) {
+		case 0:
+			eTag = aws.String(etag)
+		case 1:
+			if r.HTTPRequest.Header.Get("Range") != "" {
+				// Give queued multipart requests a chance to observe the update.
+				time.Sleep(time.Second)
+				statusCode = http.StatusPreconditionFailed
+				preconditionReturned = true
+			}
+		}
+		respBody := ioutil.NopCloser(bytes.NewReader(make([]byte, s3manager.DefaultDownloadPartSize)))
+		if statusCode != http.StatusOK {
+			respBody = ioutil.NopCloser(bytes.NewReader(nil))
+		}
+		r.HTTPResponse = &http.Response{
+			StatusCode: statusCode,
+			Body:       respBody,
+			Header:     http.Header{},
+		}
+		r.HTTPResponse.Header.Set("Content-Range", fmt.Sprintf("bytes 0-%d/%d",
+			body.Len()-1, body.Len()*10))
+		r.HTTPResponse.Header.Set("Content-Length", fmt.Sprintf("%d", body.Len()))
+		r.HTTPResponse.Header.Set("Etag", aws.StringValue(eTag))
+		r.HTTPResponse.Header.Set("x-amz-version-id", "vid")
+		atomic.AddInt64(&reqCount, 1)
+	})
+
+	return svc, &preconditionReturned
+}
