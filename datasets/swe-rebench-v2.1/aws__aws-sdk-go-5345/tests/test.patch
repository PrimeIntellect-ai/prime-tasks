+func TestDownloadWithVersionID(t *testing.T) {
+	s, _, versions, _ := dlLoggingSvcWithVersions(buf12MB, "version-a")
+	d := s3manager.NewDownloaderWithClient(s)
+
+	w := &aws.WriteAtBuffer{}
+	n, err := d.Download(w, &s3.GetObjectInput{
+		Bucket:    aws.String("bucket"),
+		Key:       aws.String("key"),
+		VersionId: aws.String("vid"),
+	})
+
+	if err != nil {
+		t.Fatalf("expect no error, got %v", err)
+	}
+
+	if e, a := int64(len(buf12MB)), n; e != a {
+		t.Errorf("expect %d buffer length, got %d", e, a)
+	}
+
+	if len(*versions) == 0 {
+		t.Fatal("expected at least one request to retrieve object data")
+	}
+	for _, version := range *versions {
+		if version != "vid" {
+			t.Errorf("expected data requests to target version vid, got %q", version)
+		}
+	}
+}
+
+func TestDownloadReturnsConsistentVersion(t *testing.T) {
+	s, _, _, _ := dlLoggingSvcWithVersions(buf12MB, "version-a")
+	d := s3manager.NewDownloaderWithClient(s)
+
+	w := &aws.WriteAtBuffer{}
+	n, err := d.Download(w, &s3.GetObjectInput{
+		Bucket: aws.String("bucket"),
+		Key:    aws.String("key"),
+	})
+
+	// The object is replaced while the download is in progress. Returning an
+	// error is acceptable; if data is returned, it must be one complete snapshot.
+	if err != nil {
+		return
+	}
+	if e, a := int64(len(buf12MB)), n; e != a {
+		t.Fatalf("expect %d buffer length, got %d", e, a)
+	}
+	updated := bytes.Repeat([]byte{0xFF}, len(buf12MB))
+	if !bytes.Equal(buf12MB, w.Bytes()) && !bytes.Equal(updated, w.Bytes()) {
+		t.Errorf("expect download to return bytes from one consistent object version")
+	}
+}
+
+func TestDownloadStartsAtLatestVersion(t *testing.T) {
+	// The object already has a newer version when the download starts.
+	// The download must return that latest version, not a stale one.
+	s, _, _, _ := dlLoggingSvcWithVersions(buf12MB, "version-b")
+	d := s3manager.NewDownloaderWithClient(s)
+
+	w := &aws.WriteAtBuffer{}
+	n, err := d.Download(w, &s3.GetObjectInput{
+		Bucket: aws.String("bucket"),
+		Key:    aws.String("key"),
+	})
+	if err != nil {
+		t.Fatalf("expect no error downloading the latest version, got %v", err)
+	}
+	if e, a := int64(len(buf12MB)), n; e != a {
+		t.Fatalf("expect %d buffer length, got %d", e, a)
+	}
+	latest := bytes.Repeat([]byte{0xFF}, len(buf12MB))
+	if !bytes.Equal(latest, w.Bytes()) {
+		t.Errorf("expect download to return the latest object version")
+	}
+}
