                   combine-responses)]
     (is (= {:status #{:done}} rsp1))
     (is (= {:status #{:done} :pong "pong-deferred"} rsp2))))
+
+;; Mimics the pomegranate hot-loading sample: a classpath entry is added to the
+;; DynamicClassLoader found in the session's context classloader hierarchy, and
+;; a namespace from it must then be loadable with `require`.
+(def-repl-test hotloading-dependency-require-test
+  (testing "A classpath entry added at runtime is available to require"
+    (let [ns-pkg (str "nrepl_hotload_" (System/nanoTime))
+          ns-sym (str ns-pkg ".lib")
+          dir    (io/file (System/getProperty "java.io.tmpdir")
+                          (str "nrepl-hotload-" (System/nanoTime)))
+          lib    (io/file dir ns-pkg "lib.clj")]
+      (try
+        (io/make-parents lib)
+        (spit lib (str "(ns " ns-sym ") (def value 42)"))
+        (let [url (str (.toURL dir))
+              rsp (->> (message session
+                                {:op   "eval"
+                                 :code (str "(let [cl (first (filter #(instance? clojure.lang.DynamicClassLoader %)"
+                                            "                        (take-while some?"
+                                            "                          (iterate #(.getParent %)"
+                                            "                                   (.getContextClassLoader (Thread/currentThread))))))]"
+                                            "  (.addURL cl (java.net.URL. " (pr-str url) "))"
+                                            "  (require '" ns-sym ")"
+                                            "  @(find-var '" ns-sym "/value))")})
+                       (map clean-response)
+                       combine-responses)]
+          (is (= {:status #{:done} :value ["42"]}
+                 (select-keys rsp [:status :value]))))
+        (finally
+          (doseq [f (reverse (file-seq dir))]
+            (.delete ^java.io.File f)))))))
