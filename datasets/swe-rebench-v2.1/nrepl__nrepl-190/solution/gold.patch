-             (.setContextClassLoader (Thread/currentThread) ctxcl#))))
-       (do ~@body))))
+                   (classloader#))
+         cl#     (or alt-cl# ctxcl#)]
+     (.setContextClassLoader (Thread/currentThread) cl#)
+     (try
+       (with-bindings {clojure.lang.Compiler/LOADER cl#}
