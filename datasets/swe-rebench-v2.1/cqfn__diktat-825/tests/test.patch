+    @Test
+    @Tag(WarningNames.COLLAPSE_IF_STATEMENTS)
+    fun `moved comments are preserved around the continuation condition`() {
+        val source = """
+            fun foo() {
+                if (outerCondition) {
+                    // outer line comment
+                    /* moved block comment */
+                    if (innerCondition) {
+                        doSomething()
+                    }
+                }
+            }
+        """.trimIndent()
+        val output = KtLint.format(
+            KtLint.Params(
+                text = source,
+                ruleSets = listOf(
+                    DiktatRuleSetProvider4Test(
+                        ::CollapseIfStatementsRule,
+                        listOf(RulesConfig(COLLAPSE_IF_STATEMENTS.name, true, emptyMap()))
+                    ).get()
+                ),
+                cb = { _, _ -> Unit }
+            )
+        )
+        val outerCondition = output.indexOf("outerCondition")
+        val lineComment = output.indexOf("// outer line comment")
+        val blockComment = output.indexOf("moved block comment")
+        val innerCondition = output.indexOf("innerCondition")
+
+        assertEquals(1, output.split("// outer line comment").size - 1)
+        assertEquals(1, output.split("moved block comment").size - 1)
+        assertTrue(outerCondition >= 0 && output.contains("&&"))
+        assertTrue(outerCondition < lineComment && lineComment < blockComment)
+        assertTrue(blockComment < innerCondition)
+    }
+
