new file mode 100644
index 0000000..9e979dc
--- /dev/null
+++ b/test/kino/text_test.exs
@@ -0,0 +1,29 @@
+defmodule Kino.TextTest do
+  use Kino.LivebookCase, async: true
+
+  describe "new/1" do
+    test "outputs plain text" do
+      "Hello!" |> Kino.Text.new() |> Kino.render()
+      assert_output({:plain_text, "Hello!"})
+    end
+
+    test "outputs ANSI text as terminal text" do
+      ansi_text = "\e[31mHello!\e[0m"
+
+      recognized_options =
+        for opts <- [[terminal: true], [ansi: true], [plain: false]] do
+          try do
+            ansi_text |> Kino.Text.new(opts) |> Kino.render()
+            assert_output({:text, ^ansi_text})
+            true
+          rescue
+            ArgumentError -> false
+            FunctionClauseError -> false
+            UndefinedFunctionError -> false
+          end
+        end
+
+      assert Enum.any?(recognized_options)
+    end
+  end
+end
