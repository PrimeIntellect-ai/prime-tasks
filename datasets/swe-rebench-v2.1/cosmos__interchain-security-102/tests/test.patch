+// TestConsumerRedistributeFracNotStoredInParams verifies that the consumer
+// redistribution fraction is no longer part of the consumer Params. The
+// fraction is hardcoded in the keeper, so it must not be a field of Params and
+// therefore cannot be set through NewParams or SetParams.
+func (suite *KeeperTestSuite) TestConsumerRedistributeFracNotStoredInParams() {
+	_, found := reflect.TypeOf(types.Params{}).FieldByName("ConsumerRedistributeFrac")
+	suite.Require().False(found,
+		"ConsumerRedistributeFrac must not be a field of the consumer Params")
+}
+
+// TestConsumerRedistributeFracNotGovernable verifies that the consumer chain
+// cannot update the redistribution fraction through governance. A governance
+// parameter-change proposal can only target keys registered in the consumer
+// param subspace, so the fraction must not be a registered parameter.
+func (suite *KeeperTestSuite) TestConsumerRedistributeFracNotGovernable() {
+	subspace, ok := suite.consumerChain.App.(*app.App).ParamsKeeper.GetSubspace(types.ModuleName)
+	suite.Require().True(ok)
+
+	err := subspace.Validate(suite.consumerChain.GetContext(),
+		[]byte("ConsumerRedistributeFrac"), "0.5")
+	suite.Require().Error(err,
+		"ConsumerRedistributeFrac must not be a registered consumer parameter")
 }
