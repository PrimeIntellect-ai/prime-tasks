+func TestFailLintModeBehavior(t *testing.T) {
+	failtpl := `before{{ fail "this is a failure!" }}after`
+	ch := &chart.Chart{
+		Metadata: &chart.Metadata{Name: "moby"},
+		Templates: []*chart.File{{
+			Name: "templates/fail.yaml",
+			Data: []byte(failtpl),
+		}},
+	}
+
+	_, err := (Engine{}).Render(ch, chartutil.Values{})
+	if err == nil {
+		t.Fatal("expected fail to return an error during ordinary rendering")
+	}
+
+	out, err := (Engine{LintMode: true}).Render(ch, chartutil.Values{})
+	if err != nil {
+		t.Fatalf("fail should not abort lint rendering: %v", err)
+	}
+	if got, want := out["moby/templates/fail.yaml"], "beforeafter"; got != want {
+		t.Errorf("rendered fail invocation should contribute an empty string: got %q, want %q", got, want)
+	}
+}
