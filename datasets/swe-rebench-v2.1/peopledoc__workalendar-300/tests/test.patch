@@ -0,0 +1,355 @@
+from datetime import date
+from unittest import TestCase
+
+from workalendar.tests import GenericCalendarTest
+from workalendar.europe import (Germany, BadenWurttemberg, Bavaria, Berlin,
+                                Brandenburg, Bremen, Hamburg, Hesse,
+                                MecklenburgVorpommern, LowerSaxony,
+                                NorthRhineWestphalia, RhinelandPalatinate,
+                                Saarland, Saxony, SaxonyAnhalt,
+                                SchleswigHolstein, Thuringia)
+
+
+STATE_CALENDAR_CLASSES = (
+    BadenWurttemberg, Bavaria, Berlin, Brandenburg, Bremen, Hamburg,
+    Hesse, MecklenburgVorpommern, LowerSaxony, NorthRhineWestphalia,
+    RhinelandPalatinate, Saarland, Saxony, SaxonyAnhalt,
+    SchleswigHolstein, Thuringia
+)
+
+
+def joins_2018_expansion(klass):
+    """True if the state class declares the 2018 expansion flag as true."""
+    return bool(getattr(klass, 'include_reformation_day_2018', False))
+
+
+class ReformationFlagTest(TestCase):
+    def test_states_include_reformation_day_in_2017(self):
+        for klass in STATE_CALENDAR_CLASSES:
+            cal = klass()
+            self.assertTrue(cal.include_reformation_day(2017))
+            self.assertIn(date(2017, 10, 31), cal.holidays_set(2017))
+
+    def test_states_joining_the_2018_expansion_include_the_holiday(self):
+        joining_states = (Bremen, Hamburg, LowerSaxony, SchleswigHolstein)
+        for klass in joining_states:
+            with self.subTest(state=klass.__name__):
+                cal = klass()
+                self.assertTrue(klass.include_reformation_day_2018)
+                for year in (2018, 2025):
+                    self.assertTrue(cal.include_reformation_day(year))
+                    self.assertIn(date(year, 10, 31), cal.holidays_set(year))
+
+    def test_2018_flag_controls_later_years(self):
+        for klass in STATE_CALENDAR_CLASSES:
+            if joins_2018_expansion(klass):
+                cal = klass()
+                for year in (2018, 2019):
+                    self.assertTrue(cal.include_reformation_day(year))
+                    self.assertIn(date(year, 10, 31), cal.holidays_set(year))
+
+
+class ReformationDayAllTimeTest(TestCase):
+    """States that have always included Reformation Day."""
+
+    cal_classes = (Brandenburg, MecklenburgVorpommern, Saxony,
+                   SaxonyAnhalt, Thuringia)
+
+    def test_include_reformation_day_all_years(self):
+        for klass in self.cal_classes:
+            cal = klass()
+            self.assertTrue(cal.include_reformation_day(2015))
+            self.assertTrue(cal.include_reformation_day(2016))
+            self.assertIn(date(2015, 10, 31), cal.holidays_set(2015))
+            self.assertIn(date(2016, 10, 31), cal.holidays_set(2016))
+
+
+class ReformationDay2018Test(TestCase):
+    """States that added Reformation Day starting in 2018."""
+
+    def test_not_include_reformation_day_before_2018(self):
+        for klass in STATE_CALENDAR_CLASSES:
+            if joins_2018_expansion(klass):
+                cal = klass()
+                if date(2016, 10, 31) not in cal.holidays_set(2016):
+                    self.assertFalse(cal.include_reformation_day(2016))
+
+
+class ReformationDayNotIncludedTest(TestCase):
+    """States without historical or 2018 inclusion do not add the holiday."""
+
+    def test_states_without_inclusion_conditions(self):
+        for klass in STATE_CALENDAR_CLASSES:
+            cal = klass()
+            historically_included = date(2016, 10, 31) in cal.holidays_set(2016)
+            if not joins_2018_expansion(klass) and not historically_included:
+                self.assertFalse(cal.include_reformation_day(2018))
+                self.assertNotIn(date(2018, 10, 31), cal.holidays_set(2018))
+
+
+class GermanyTest(GenericCalendarTest):
+    cal_class = Germany
+
+    def test_year_2014(self):
+        holidays = self.cal.holidays_set(2014)
+        self.assertIn(date(2014, 1, 1), holidays)
+        self.assertIn(date(2014, 4, 18), holidays)
+        self.assertIn(date(2014, 4, 21), holidays)
+        self.assertIn(date(2014, 5, 1), holidays)
+        self.assertIn(date(2014, 5, 29), holidays)
+        self.assertIn(date(2014, 6, 9), holidays)
+        self.assertIn(date(2014, 10, 3), holidays)
+        self.assertIn(date(2014, 12, 25), holidays)
+        self.assertIn(date(2014, 12, 26), holidays)
+
+    def test_year_2015(self):
+        holidays = self.cal.holidays_set(2015)
+        self.assertIn(date(2015, 1, 1), holidays)
+        self.assertIn(date(2015, 4, 3), holidays)
+        self.assertIn(date(2015, 4, 6), holidays)
+        self.assertIn(date(2015, 5, 1), holidays)
+        self.assertIn(date(2015, 5, 14), holidays)
+        self.assertIn(date(2015, 5, 25), holidays)
+        self.assertIn(date(2015, 10, 3), holidays)
+        self.assertIn(date(2015, 12, 25), holidays)
+        self.assertIn(date(2015, 12, 26), holidays)
+
+    def test_year_reformation_day(self):
+        # Reformation Day is included each year in:
+        # Brandenburg, MecklenburgVorpommern, Saxony, SaxonyAnhalt & Thuringia
+        holidays = self.cal.holidays_set(2015)
+        if self.cal.include_reformation_day(2015):
+            self.assertIn(date(2015, 10, 31), holidays)
+        else:
+            self.assertNotIn(date(2015, 10, 31), holidays)
+
+        # But in the year 2017, it's included for the whole country
+        holidays = self.cal.holidays_set(2017)
+        self.assertTrue(self.cal.include_reformation_day(2017))
+        self.assertIn(date(2017, 10, 31), holidays)
+
+        # In 2018, Four more states have added it:
+        # Bremen, Hamburg, Lower Saxony and Schleswig-Holstein
+        holidays = self.cal.holidays_set(2018)
+        if self.cal.include_reformation_day(2018):
+            self.assertIn(date(2018, 10, 31), holidays)
+        else:
+            self.assertNotIn(date(2018, 10, 31), holidays)
+
+
