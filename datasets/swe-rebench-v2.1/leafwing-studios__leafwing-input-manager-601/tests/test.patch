+#[test]
+fn generate_action_diffs_includes_entities_with_arbitrary_components() {
+    let mut app = create_app();
+    app.add_systems(PostUpdate, generate_action_diffs::<Action>);
+
+    let included_entity = app
+        .world_mut()
+        .query_filtered::<Entity, With<ActionState<Action>>>()
+        .single(app.world());
+    let marked_entity = app
+        .world_mut()
+        .spawn((ActionState::<Action>::default(), NoActionDiffs))
+        .id();
+
+    for mut action_state in app
+        .world_mut()
+        .query::<&mut ActionState<Action>>()
+        .iter_mut(app.world_mut())
+    {
+        action_state.press(&Action::Button);
+    }
+    app.update();
+
+    let events = get_events::<ActionDiffEvent<Action>>(&app);
+    let mut reader = events.get_reader();
+    let owners: Vec<_> = reader
+        .read(events)
+        .map(|event| {
+            assert_eq!(event.action_diffs.len(), 1);
+            assert!(matches!(
+                event.action_diffs.first(),
+                Some(ActionDiff::Pressed {
+                    action: Action::Button
+                })
+            ));
+            event.owner.unwrap()
+        })
+        .collect();
+    assert_eq!(owners.len(), 2);
+    assert!(owners.contains(&included_entity));
+    assert!(owners.contains(&marked_entity));
+}
