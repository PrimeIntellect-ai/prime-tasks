+#[test]
+fn backup_files_are_not_linted() {
+    // Backup files (which have the `.bak` extension) must not be linted, even
+    // though their names match the `.env` pattern.
+    let testdir = TestDir::new();
+    testdir.create_testfile(".env", "FOO=BAR\n");
+    testdir.create_testfile(".env_1610361920.bak", "1BAR=\n");
+
+    let subdir = testdir.subdir();
+    subdir.create_testfile(".env_1610361920.bak", "1BAR=\n");
+
+    let args = &["--recursive"];
+    let expected_output = check_output(&[(".env", &[])]);
+
+    testdir.test_command_success_with_args(args, expected_output);
+}
