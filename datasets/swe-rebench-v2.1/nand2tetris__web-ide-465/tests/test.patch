+
+  it("keeps generated labels unique across files", () => {
+    const source = (name: string) => `class ${name} {
+  function void main() {
+    var boolean c;
+    var int x;
+    if (c) {
+      let x = 4;
+    } else {
+      let x = 5;
+    }
+    return;
+  }
+}`;
+    const compiled = compile({ Main: source("Main"), Other: source("Other") });
+    const definitions: string[] = [];
+    for (const name of ["Main", "Other"]) {
+      const vm = compiled[name];
+      expect(typeof vm).toBe("string");
+      const labels = (vm as string)
+        .split("\n")
+        .map((line) => line.trim())
+        .filter((line) => line.startsWith("label "))
+        .map((line) => line.slice("label ".length));
+      expect(labels.length).toBeGreaterThan(0);
+      definitions.push(...labels);
+    }
+    expect(new Set(definitions).size).toBe(definitions.length);
   });
 
