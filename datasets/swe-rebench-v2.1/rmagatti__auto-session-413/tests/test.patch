diff --git a/tests/get_cwd_spec.lua b/tests/get_cwd_spec.lua
new file mode 100644
index 0000000..76f9dc3
--- /dev/null
+++ b/tests/get_cwd_spec.lua
@@ -0,0 +1,64 @@
+---@diagnostic disable: undefined-field
+local TL = require "tests/test_lib"
+
+describe("cwd lookup", function()
+  local as = require "auto-session"
+
+  require("auto-session").setup {}
+
+  TL.clearSessionFilesAndBuffers()
+
+  it("autosaves a restored session under its loaded name with a local cwd", function()
+    TL.clearSessionFilesAndBuffers()
+    vim.cmd("e " .. TL.test_file)
+
+    local global_cwd = vim.fn.getcwd(-1, -1)
+    local loaded_session_name = "loaded-session"
+    local loaded_session_path = TL.makeSessionPath(loaded_session_name)
+    as.SaveSession(loaded_session_name)
+    as.RestoreSession(loaded_session_name)
+
+    vim.cmd "tabnew"
+    vim.cmd "lcd tests"
+    local other_file = vim.fn.fnamemodify(TL.other_file, ":p")
+    vim.cmd("e " .. vim.fn.fnameescape(other_file))
+
+    as.AutoSaveSession()
+    vim.cmd("lcd " .. vim.fn.fnameescape(global_cwd))
+    assert.equals(true, TL.sessionHasFile(loaded_session_path, "other.txt"))
+
+    TL.clearSessionFilesAndBuffers()
+  end)
+
+  TL.clearSessionFilesAndBuffers()
+
+  it("works when tcd is used", function()
+    assert.equals(0, vim.fn.filereadable(TL.default_session_path))
+    vim.cmd("e " .. TL.test_file)
+    vim.cmd "tabnew"
+    vim.cmd "tcd tests"
+
+    as.SaveSession()
+
+    vim.cmd "tabclose"
+
+    -- Make sure the session was still created for the global directory
+    assert.equals(1, vim.fn.filereadable(TL.default_session_path))
+  end)
+
+  TL.clearSessionFilesAndBuffers()
+
+  it("works when lcd is used", function()
+    assert.equals(0, vim.fn.filereadable(TL.default_session_path))
+    vim.cmd("e " .. TL.test_file)
+    vim.cmd "tabnew"
+    vim.cmd "lcd tests"
+
+    as.SaveSession()
+
+    vim.cmd "tabclose"
+
+    -- Make sure the session was still created for the global directory
+    assert.equals(1, vim.fn.filereadable(TL.default_session_path))
+  end)
+end)
