+// removeMatchingEntities preserves the entity-removal scenarios without
+// depending on a batch whole-entity-removal operation.
+func removeMatchingEntities(world *World, filter Filter) int {
+	query := world.Query(filter)
+	entities := make([]Entity, 0, query.Count())
+	for query.Next() {
+		entities = append(entities, query.Entity())
+	}
+	for _, entity := range entities {
+		world.RemoveEntity(entity)
+	}
+	return len(entities)
+}
+
+func TestWorldBatchAddRemove(t *testing.T) {
+	w := NewWorld()
+
+	posID := ComponentID[Position](&w)
+	velID := ComponentID[Velocity](&w)
+	rotID := ComponentID[rotation](&w)
+
+	for i := 0; i < 10; i++ {
+		w.NewEntity(posID)
+	}
+	for i := 0; i < 5; i++ {
+		w.NewEntity(posID, rotID)
+	}
+	for i := 0; i < 3; i++ {
+		w.NewEntity(velID)
+	}
+
+	w.Batch().Add(All(posID), nil, velID)
+
+	q := w.Query(All(posID, velID))
+	assert.Equal(t, 15, q.Count())
+	q.Close()
+
+	// Entities outside the filter are unaffected.
+	excl := All(velID).Exclusive()
+	q = w.Query(&excl)
+	assert.Equal(t, 3, q.Count())
+	q.Close()
+
+	w.Batch().Remove(All(posID), nil, velID)
+
+	q = w.Query(All(posID, velID))
+	assert.Equal(t, 0, q.Count())
+	q.Close()
+
+	q = w.Query(All(velID))
+	assert.Equal(t, 3, q.Count())
+	q.Close()
+}
