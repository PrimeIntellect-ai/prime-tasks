+<?php
+
+declare(strict_types=1);
+
+namespace JsonMapper\Middleware\Rename;
+
+use JsonMapper\JsonMapperInterface;
+use JsonMapper\Middleware\AbstractMiddleware;
+use JsonMapper\ValueObjects\PropertyMap;
+use JsonMapper\Wrapper\ObjectWrapper;
+
+class Rename extends AbstractMiddleware
+{
+    /** @var Mapping[] */
+    private $mapping;
+
+    public function __construct(Mapping ...$mapping)
+    {
+        $this->mapping = $mapping;
+    }
+
+    public function addMapping(string $class, string $from, string $to): void
+    {
+        $this->mapping[] = new Mapping($class, $from, $to);
+    }
+
+    public function handle(\stdClass $json, ObjectWrapper $object, PropertyMap $propertyMap, JsonMapperInterface $mapper): void
+    {
+        $mapping = array_filter($this->mapping, function ($map) use ($object) {
+            return $map->getClass() === get_class($object->getObject());
+        });
+        foreach ($mapping as $map) {
+            $from = $map->getFrom();
+            $to = $map->getTo();
+
+            if (isset($json->$from)) {
+                $json->$to = $json->$from;
+                unset($json->$from);
+            }
+        }
+    }
+}
