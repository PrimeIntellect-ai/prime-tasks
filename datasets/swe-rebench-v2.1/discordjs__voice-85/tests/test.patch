+import { opus, VolumeTransformer } from 'prism-media';
+import { PassThrough } from 'stream';
+import { createAudioResource } from '../AudioResource';
+import { StreamType, TransformerType } from '../TransformerGraph';
+
+jest.mock('prism-media');
+
+describe('createAudioResource', () => {
+	test('Creates a resource from string path', () => {
+		const resource = createAudioResource('mypath.mp3');
+		expect(resource.pipeline.some((edge) => edge.type === TransformerType.FFmpegPCM || edge.type === TransformerType.FFmpegOgg)).toBe(true);
+		expect(resource.volume).toBeUndefined();
+	});
+
+	test('Creates a resource from string path (volume)', () => {
+		const resource = createAudioResource('mypath.mp3', { inlineVolume: true });
+		expect(resource.pipeline.some((edge) => edge.type === TransformerType.FFmpegPCM || edge.type === TransformerType.FFmpegOgg)).toBe(true);
+		expect(resource.volume).toBeInstanceOf(VolumeTransformer);
+	});
+
+	test('String inputs remain arbitrary when an input type is supplied', () => {
+		const resource = createAudioResource('mypath.mp3', { inputType: StreamType.OggOpus });
+		expect(resource.pipeline.some((edge) => edge.type === TransformerType.FFmpegPCM || edge.type === TransformerType.FFmpegOgg)).toBe(true);
+	});
+
+	test('Only infers type if not explicitly given', () => {
+		const input = new opus.Encoder();
+		const resource = createAudioResource(input, { inputType: StreamType.Arbitrary });
+		expect(resource.pipeline.some((edge) => edge.type === TransformerType.FFmpegPCM || edge.type === TransformerType.FFmpegOgg)).toBe(true);
+		expect(resource.volume).toBeUndefined();
+	});
+
+	test('Infers from opus.Encoder', () => {
+		const input = new opus.Encoder();
+		const resource = createAudioResource(input, { inlineVolume: true });
+		expect(resource.pipeline.some((edge) => edge.type === TransformerType.FFmpegPCM || edge.type === TransformerType.FFmpegOgg)).toBe(false);
+		expect(resource.playStream).not.toBe(input);
+		expect(resource.volume).toBeInstanceOf(VolumeTransformer);
+	});
+
+	test('Infers from opus.OggDemuxer', () => {
+		const input = new opus.OggDemuxer();
+		const resource = createAudioResource(input);
+		expect(resource.playStream).toBe(input);
+		expect(resource.volume).toBeUndefined();
+	});
+
+	test('Infers from opus.WebmDemuxer', () => {
+		const input = new opus.WebmDemuxer();
+		const resource = createAudioResource(input);
+		expect(resource.playStream).toBe(input);
+		expect(resource.volume).toBeUndefined();
+	});
+
+	test('Infers from opus.Decoder', () => {
+		const input = new opus.Decoder();
+		const resource = createAudioResource(input);
+		expect(resource.pipeline.some((edge) => edge.type === TransformerType.OpusEncoder)).toBe(true);
+		expect(resource.pipeline.some((edge) => edge.type === TransformerType.FFmpegPCM || edge.type === TransformerType.FFmpegOgg)).toBe(false);
+		expect(resource.playStream).not.toBe(input);
+		expect(resource.volume).toBeUndefined();
+	});
+
+	test('Infers from VolumeTransformer', () => {
+		const stream = new VolumeTransformer({} as any);
+		const resource = createAudioResource(stream, { inlineVolume: true });
+		expect(resource.pipeline.some((edge) => edge.type === TransformerType.OpusEncoder)).toBe(true);
+		expect(resource.pipeline.some((edge) => edge.type === TransformerType.FFmpegPCM || edge.type === TransformerType.FFmpegOgg)).toBe(false);
+		expect(resource.playStream).not.toBe(stream);
+		expect(resource.volume).toBe(stream);
+		expect(resource.pipeline.some((edge) => edge.type === TransformerType.InlineVolume)).toBe(false);
+	});
+
+	test('Falls back to Arbitrary for unknown stream type', () => {
+		const input = new PassThrough();
+		const resource = createAudioResource(input);
+		expect(resource.pipeline.some((edge) => edge.type === TransformerType.FFmpegPCM || edge.type === TransformerType.FFmpegOgg)).toBe(true);
+		expect(resource.volume).toBeUndefined();
+	});
+});
