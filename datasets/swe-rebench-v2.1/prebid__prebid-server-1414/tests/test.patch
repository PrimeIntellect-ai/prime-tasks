 func mockServer(w http.ResponseWriter, req *http.Request) {
 	w.Write([]byte("{}"))
 }
+
+// formatTargetingBidder returns a single bid of the configured media type for every request.
+type formatTargetingBidder struct {
+	mockServerURL string
+	bids          []*openrtb.Bid
+	bidType       openrtb_ext.BidType
+}
+
+func (m *formatTargetingBidder) MakeRequests(request *openrtb.BidRequest, reqInfo *adapters.ExtraRequestInfo) ([]*adapters.RequestData, []error) {
+	return []*adapters.RequestData{{
+		Method:  "POST",
+		Uri:     m.mockServerURL,
+		Body:    []byte(""),
+		Headers: http.Header{},
+	}}, nil
+}
+
+func (m *formatTargetingBidder) MakeBids(internalRequest *openrtb.BidRequest, externalRequest *adapters.RequestData, response *adapters.ResponseData) (*adapters.BidderResponse, []error) {
+	bidResponse := &adapters.BidderResponse{Bids: make([]*adapters.TypedBid, 0, len(m.bids))}
+	for _, bid := range m.bids {
+		bidResponse.Bids = append(bidResponse.Bids, &adapters.TypedBid{Bid: bid, BidType: m.bidType})
+	}
+	return bidResponse, nil
+}
+
+// runFormatTargetingAuction runs an auction in which appnexus returns a single bid of the given media type,
+// using the supplied request ext, and returns the resulting targeting key-values for that bid.
+func runFormatTargetingAuction(t *testing.T, ext json.RawMessage, bidType openrtb_ext.BidType) map[string]string {
+	t.Helper()
+	server := httptest.NewServer(http.HandlerFunc(mockServer))
+	defer server.Close()
+
+	bids := map[openrtb_ext.BidderName][]*openrtb.Bid{
+		openrtb_ext.BidderAppnexus: {{
+			ID:    "format-bid",
+			ImpID: "some-imp",
+			Price: 1.23,
+			CrID:  "1",
+		}},
+	}
+
+	adapterMap := map[openrtb_ext.BidderName]adaptedBidder{
+		openrtb_ext.BidderAppnexus: adaptBidder(&formatTargetingBidder{
+			mockServerURL: server.URL,
+			bids:          bids[openrtb_ext.BidderAppnexus],
+			bidType:       bidType,
+		}, server.Client(), &config.Configuration{}, &metricsConfig.DummyMetricsEngine{}, openrtb_ext.BidderAppnexus),
+	}
+
+	ex := &exchange{
+		adapterMap:          adapterMap,
+		me:                  &metricsConf.DummyMetricsEngine{},
+		cache:               &wellBehavedCache{},
+		cacheTime:           time.Duration(0),
+		gDPR:                gdpr.AlwaysAllow{},
+		currencyConverter:   currencies.NewRateConverterDefault(),
+		UsersyncIfAmbiguous: false,
+	}
+
+	req := &openrtb.BidRequest{
+		Imp:  buildImps(t, bids),
+		Site: &openrtb.Site{},
+		Ext:  ext,
+	}
+
+	categoriesFetcher, err := newCategoryFetcher("./test/category-mapping")
+	if err != nil {
+		t.Fatalf("Failed to create a category Fetcher: %v", err)
+	}
+	bidResp, err := ex.HoldAuction(context.Background(), req, &mockFetcher{}, pbsmetrics.Labels{}, &categoriesFetcher, nil)
+	if err != nil {
+		t.Fatalf("Unexpected errors running auction: %v", err)
+	}
+
+	resultBids := buildBidMap(bidResp.SeatBid, 1)
+	bid, ok := resultBids["format-bid"]
+	if !ok {
+		t.Fatalf("Expected the appnexus bid to survive the auction")
+	}
+	return parseTargets(t, bid)
+}
+
+// hb_format is reported with the bid's media type when includeformat is enabled, and follows the same
+// winner and bidder-key inclusion rules as the other targeting keys.
+func TestTargetingFormatKeys(t *testing.T) {
+	testCases := []struct {
+		name         string
+		targeting    string
+		bidType      openrtb_ext.BidType
+		expectedKeys map[string]string
+		absentKeys   []string
+	}{
+		{
+			name:      "video bid with includeformat",
+			targeting: `{"includewinners":true,"includebidderkeys":true,"includeformat":true}`,
+			bidType:   openrtb_ext.BidTypeVideo,
+			expectedKeys: map[string]string{
+				"hb_format":          "video",
+				"hb_format_appnexus": "video",
+			},
+		},
+		{
+			name:      "banner bid with includeformat",
+			targeting: `{"includewinners":true,"includebidderkeys":true,"includeformat":true}`,
+			bidType:   openrtb_ext.BidTypeBanner,
+			expectedKeys: map[string]string{
+				"hb_format":          "banner",
+				"hb_format_appnexus": "banner",
+			},
+		},
+		{
+			name:         "includeformat with bidder keys only",
+			targeting:    `{"includewinners":false,"includebidderkeys":true,"includeformat":true}`,
+			bidType:      openrtb_ext.BidTypeVideo,
+			expectedKeys: map[string]string{"hb_format_appnexus": "video"},
+			absentKeys:   []string{"hb_format"},
+		},
+		{
+			name:         "includeformat with winners only",
+			targeting:    `{"includewinners":true,"includebidderkeys":false,"includeformat":true}`,
+			bidType:      openrtb_ext.BidTypeVideo,
+			expectedKeys: map[string]string{"hb_format": "video"},
+			absentKeys:   []string{"hb_format_appnexus"},
+		},
+		{
+			name:       "format not requested",
+			targeting:  `{"includewinners":true,"includebidderkeys":true}`,
+			bidType:    openrtb_ext.BidTypeVideo,
+			absentKeys: []string{"hb_format", "hb_format_appnexus"},
+		},
+		{
+			name:       "includeformat disabled explicitly",
+			targeting:  `{"includewinners":true,"includebidderkeys":true,"includeformat":false}`,
+			bidType:    openrtb_ext.BidTypeBanner,
+			absentKeys: []string{"hb_format", "hb_format_appnexus"},
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			ext := json.RawMessage(`{"prebid":{"targeting":` + tc.targeting + `}}`)
+			targets := runFormatTargetingAuction(t, ext, tc.bidType)
+			for key, expected := range tc.expectedKeys {
+				actual, ok := targets[key]
+				if !ok {
+					t.Errorf("Expected targeting key %s to be present, targets: %v", key, targets)
+				} else if actual != expected {
+					t.Errorf("Targeting key %s: expected %q, got %q", key, expected, actual)
+				}
+			}
+			for _, key := range tc.absentKeys {
+				if _, ok := targets[key]; ok {
+					t.Errorf("Targeting key %s should not be present, targets: %v", key, targets)
+				}
+			}
+		})
+	}
+}
