+// bidTypeForBidExt runs a bid carrying the given bid.ext through the adapter's response handling
+// and returns the media type reported for that bid.
+func bidTypeForBidExt(t *testing.T, bidExt string) openrtb_ext.BidType {
+t.Helper()
+body := `{"seatbid":[{"bid":[{"id":"bid-1","impid":"imp-1","price":1.0,"ext":` + bidExt + `}]}]}`
+adapter := NewPubmaticBidder(nil, "https://hbopenbid.pubmatic.com/translator?source=prebid-server")
+bidResp, errs := adapter.MakeBids(&openrtb.BidRequest{}, nil, &adapters.ResponseData{
+StatusCode: http.StatusOK,
+Body:       []byte(body),
+})
+if len(errs) != 0 {
+t.Fatalf("Unexpected errors: %v", errs)
+}
+if bidResp == nil || len(bidResp.Bids) != 1 {
+t.Fatalf("Expected exactly one bid in the response")
+}
+return bidResp.Bids[0].BidType
+}
+
