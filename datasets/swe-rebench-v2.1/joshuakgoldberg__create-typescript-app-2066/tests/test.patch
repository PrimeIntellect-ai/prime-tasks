+
+describe("cspell.json words", () => {
+	const preset = base.createPreset({
+		about: {
+			description: "Test preset for cspell words",
+			name: "Test",
+		},
+		blocks: [blockCSpell, blockESLint, blockRenovate],
+	});
+
+	function readCspellWords() {
+		const creation = producePreset(preset, { options: optionsBase });
+		const cspell = JSON.parse(creation.files["cspell.json"] as string) as {
+			words?: string[];
+		};
+
+		return cspell.words ?? [];
+	}
+
+	test("checked-in cspell.json omits dictionary words", () => {
+		const cspell = JSON.parse(
+			readFileSync(new URL("../../cspell.json", import.meta.url), "utf8"),
+		) as { words: string[] };
+
+		expect(cspell.words).not.toEqual(
+			expect.arrayContaining(["automerge", "tseslint"]),
+		);
+	});
+
+	test("blockESLint does not add tseslint", () => {
+		expect(readCspellWords()).not.toContain("tseslint");
+	});
+
+	test("blockRenovate does not add automerge", () => {
+		expect(readCspellWords()).not.toContain("automerge");
+	});
+});
