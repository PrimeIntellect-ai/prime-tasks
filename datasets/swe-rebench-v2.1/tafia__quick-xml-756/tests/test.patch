+
+/// Processing instructions are reported as PI events whose target and content
+/// are taken literally from the input.
+mod processing_instruction {
+    use super::*;
+    use quick_xml::events::BytesPI;
+
+    fn assert_pi(xml: &str, target: &[u8], content: &[u8]) {
+        let mut reader = Reader::from_str(xml);
+        reader.config_mut().enable_all_checks(true);
+        match reader.read_event().unwrap() {
+            Event::PI(pi) => {
+                let pi: BytesPI<'_> = pi;
+                assert_eq!(pi.target(), target, "target of {:?}", xml);
+                assert_eq!(pi.content(), content, "content of {:?}", xml);
+            }
+            other => panic!("expected a PI event for {:?}, got {:?}", xml, other),
+        }
+    }
+
+    #[test]
+    fn entity_references_are_not_interpreted() {
+        assert_pi("<?pi &amp;?>", b"pi", b" &amp;");
+    }
+
+    #[test]
+    fn character_references_are_not_interpreted() {
+        assert_pi("<?pi &#65; &amp;?>", b"pi", b" &#65; &amp;");
+    }
+
+    #[test]
+    fn empty_processing_instruction_has_empty_target() {
+        assert_pi("<??>", b"", b"");
+    }
+
+    #[test]
+    fn target_only_processing_instruction_has_empty_content() {
+        assert_pi("<?xmlx?>", b"xmlx", b"");
+    }
+}
