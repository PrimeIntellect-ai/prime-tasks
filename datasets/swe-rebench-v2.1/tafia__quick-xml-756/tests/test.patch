+use quick_xml::events::{BytesCData, BytesEnd, BytesPI, BytesStart, BytesText, Event};
 use quick_xml::reader::Reader;
 
+/// Asserts that `event` is a processing instruction whose payload is a `BytesPI`
+/// with the given target and content.
+fn assert_pi_event(event: Event<'_>, target: &[u8], content: &[u8]) {
+    match event {
+        Event::PI(pi) => {
+            let pi: BytesPI<'_> = pi;
+            assert_eq!(pi.target(), target);
+            assert_eq!(pi.content(), content);
+        }
+        other => panic!("expected a processing instruction, got {:?}", other),
+    }
+}
