+#[cfg(feature = "mock")]
+#[test]
+fn metadata_date_is_decoded_from_query_result() {
+    futures::executor::block_on(async {
+        use sea_orm::{DbBackend, MockDatabase};
+
+        let expected = "2021-09-27".parse::<chrono::NaiveDate>().unwrap();
+        let model = metadata::Model {
+            uuid: Uuid::new_v4(),
+            key: "date-check".to_owned(),
+            value: "value".to_owned(),
+            bytes: vec![],
+            date: expected,
+        };
+        let db = MockDatabase::new(DbBackend::Postgres)
+            .append_query_results(vec![vec![model]])
+            .into_connection();
+
+        let retrieved = Metadata::find().one(&db).await.unwrap().unwrap();
+
+        assert_eq!(retrieved.date, expected);
+    });
+}
+
+#[cfg(feature = "mock")]
+#[test]
+fn metadata_date_is_bound_for_insert() {
+    use sea_orm::{sea_query::Value, DbBackend, Insert, QueryTrait};
+
+    let expected = "2021-09-27".parse().unwrap();
+    let model = metadata::Model {
+        uuid: Uuid::new_v4(),
+        key: "date-insert".to_owned(),
+        value: "value".to_owned(),
+        bytes: vec![],
+        date: expected,
+    };
+
+    let statement = Insert::<metadata::ActiveModel>::one(model).build(DbBackend::Postgres);
+    let values = statement.values.expect("insert should bind its values");
+
+    // The date may be bound either as a native date value or as its ISO-8601 text form.
+    assert!(values.0.iter().any(|value| match value {
+        Value::Date(Some(value)) => value.as_ref() == &expected,
+        Value::String(Some(value)) => value.as_str() == "2021-09-27",
+        _ => false,
+    }));
+}
+
+#[cfg(feature = "mock")]
+#[test]
+fn metadata_date_column_uses_sql_date_type() {
+    use sea_orm::Schema;
+
+    let ddl = Schema::create_table_from_entity(metadata::Entity)
+        .to_string(sea_orm::sea_query::PostgresQueryBuilder);
+    let ddl = ddl.to_ascii_lowercase();
+
+    assert!(
+        ddl.contains(" date "),
+        "expected a SQL DATE column in: {}",
+        ddl
+    );
+    assert!(
+        !ddl.contains("timestamp"),
+        "a date-only column must not be a timestamp: {}",
+        ddl
+    );
+}
