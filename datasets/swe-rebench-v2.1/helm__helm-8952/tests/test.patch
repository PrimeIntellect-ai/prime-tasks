+func TestDependencyUpdateSucceedsForLocalChartsWithoutRepositories(t *testing.T) {
+	root := t.TempDir()
+	dep := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name:       "local-dependency",
+			Version:    "0.1.0",
+			APIVersion: "v1",
+		},
+	}
+	parent := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name:       "parent-chart",
+			Version:    "0.1.0",
+			APIVersion: "v2",
+			Dependencies: []*chart.Dependency{{
+				Name:    dep.Metadata.Name,
+				Version: dep.Metadata.Version,
+			}},
+		},
+	}
+	chartPath := filepath.Join(root, parent.Metadata.Name)
+	if err := chartutil.SaveDir(parent, root); err != nil {
+		t.Fatal(err)
+	}
+	if err := chartutil.SaveDir(dep, filepath.Join(chartPath, "charts")); err != nil {
+		t.Fatal(err)
+	}
+
+	cmd := exec.Command("go", "run", "./cmd/helm",
+		"--repository-config", filepath.Join(root, "repositories.yaml"),
+		"--repository-cache", filepath.Join(root, "repository"),
+		"dependency", "update", chartPath)
+	cmd.Dir = filepath.Join("..", "..")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("helm dependency update failed: %v\n%s", err, output)
+	}
+}
