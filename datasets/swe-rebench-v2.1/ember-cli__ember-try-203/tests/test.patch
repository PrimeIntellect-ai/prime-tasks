+++ b/test/utils/run-test.js
@@ -0,0 +1,49 @@
+'use strict';
+
+const expect = require('chai').expect;
+const TryEachTask = require('../../lib/tasks/try-each');
+const StubDependencyAdapter = require('../helpers/stub-dependency-manager-adapter');
+const fs = require('fs');
+const path = require('path');
+
+function runFailedThenSuccessfulScenario() {
+  let output = [];
+  let markerPath = path.join('/tmp', `ember-try-remaining-${process.pid}-${Date.now()}`);
+  let scenarios = [
+    { name: 'failed', command: 'false' },
+    { name: 'remaining', command: `touch ${markerPath}` },
+  ];
+  let task = new TryEachTask({
+    ui: { writeLine(line) { output.push(String(line)); } },
+    project: { root: process.cwd() },
+    config: { scenarios },
+    dependencyManagerAdapters: [new StubDependencyAdapter()],
+    _on() {},
+  });
+
+  function collectOutcome() {
+    let laterScenarioRan = fs.existsSync(markerPath);
+    if (laterScenarioRan) {
+      fs.unlinkSync(markerPath);
+    }
+    return { output: output.join('\n'), laterScenarioRan };
+  }
+
+  // The promise settlement after a failed scenario is not part of the contract;
+  // only the side effects (later scenario ran, summary printed) are checked.
+  return task.run(scenarios, {}).then(collectOutcome, collectOutcome);
+}
+
+describe('scenario command failures', () => {
+  it('continues with the remaining scenarios', () => {
+    return runFailedThenSuccessfulScenario().then((result) => {
+      expect(result.laterScenarioRan).to.equal(true);
+    });
+  });
+
+  it('prints a summary after a scenario fails', () => {
+    return runFailedThenSuccessfulScenario().then((result) => {
+      expect(result.output).to.include('------ RESULTS ------');
+    });
+  });
+});
