diff --git a/test/file-filter_test.go b/test/file-filter_test.go
new file mode 100644
index 0000000..c9805f9
--- /dev/null
+++ b/test/file-filter_test.go
@@ -0,0 +1,89 @@
+package test
+
+import (
+	"os"
+	"testing"
+
+	"github.com/mgechev/revive/config"
+	"github.com/mgechev/revive/lint"
+)
+
+type TestFileFilterRule struct {
+	RuleName string
+}
+
+var _ lint.Rule = (*TestFileFilterRule)(nil)
+
+func (tfr *TestFileFilterRule) Name() string { return tfr.RuleName }
+func (tfr *TestFileFilterRule) Apply(*lint.File, lint.Arguments) []lint.Failure {
+	return []lint.Failure{{RuleName: tfr.RuleName, Failure: "reported", Confidence: 1}}
+}
+
+func TestRuleLevelFileExclusions850(t *testing.T) {
+	cfg, err := config.GetConfig("../config/testdata/rule-level-exclude-850.toml")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	run := func(t *testing.T, rules ...*TestFileFilterRule) []lint.Failure {
+		t.Helper()
+		linting := lint.New(func(filename string) ([]byte, error) {
+			return os.ReadFile("../testdata/" + filename)
+		}, 0)
+		ruleSet := make([]lint.Rule, len(rules))
+		for i, rule := range rules {
+			ruleSet[i] = rule
+		}
+		failures, err := linting.Lint([][]string{{"file-to-exclude.go"}}, ruleSet, *cfg)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var got []lint.Failure
+		for failure := range failures {
+			got = append(got, failure)
+		}
+		return got
+	}
+	containsRule := func(failures []lint.Failure, name string) bool {
+		for _, failure := range failures {
+			if failure.RuleName == name {
+				return true
+			}
+		}
+		return false
+	}
+
+	t.Run("literal path excludes only its matching rule", func(t *testing.T) {
+		failures := run(t,
+			&TestFileFilterRule{RuleName: "r2"},
+			&TestFileFilterRule{RuleName: "r1"},
+		)
+		if containsRule(failures, "r2") {
+			t.Fatal("matching literal exclusion left a warning from r2")
+		}
+		if !containsRule(failures, "r1") {
+			t.Fatal("r1 warning was suppressed by another rule's exclusion")
+		}
+	})
+
+	t.Run("nonmatching literal does not exclude", func(t *testing.T) {
+		failures := run(t, &TestFileFilterRule{RuleName: "r5"})
+		if !containsRule(failures, "r5") {
+			t.Fatal("nonmatching literal exclusion suppressed the rule warning")
+		}
+	})
+
+	t.Run("regex exclusion applies during linting", func(t *testing.T) {
+		failures := run(t, &TestFileFilterRule{RuleName: "r3"})
+		if containsRule(failures, "r3") {
+			t.Fatal("matching regex exclusion left a warning from r3")
+		}
+	})
+
+	t.Run("glob exclusion applies during linting", func(t *testing.T) {
+		failures := run(t, &TestFileFilterRule{RuleName: "r4"})
+		if containsRule(failures, "r4") {
+			t.Fatal("matching glob exclusion left a warning from r4")
+		}
+	})
+}
