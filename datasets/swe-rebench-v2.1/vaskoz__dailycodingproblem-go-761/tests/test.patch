+package day377
+
+import (
+	"reflect"
+	"testing"
+)
+
+// nolint
+var testcases = []struct {
+	input    []float64
+	k        int
+	expected []float64
+}{
+	{
+		[]float64{-1, 5, 13, 8, 2, 3, 3, 1},
+		3,
+		[]float64{5, 8, 8, 3, 3, 3},
+	},
+	{
+		[]float64{-1, 5, 13, 8, 2, 3, 3, 1},
+		4,
+		[]float64{6.5, 6.5, 5.5, 3, 2.5},
+	},
+}
+
+func TestBruteKMedians(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range testcases {
+		if result := BruteKMedians(tc.input, tc.k); !reflect.DeepEqual(result, tc.expected) {
+			t.Errorf("Expected %v, got %v", tc.expected, result)
+		}
+	}
+}
+
+func BenchmarkBruteKMedians(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			BruteKMedians(tc.input, tc.k)
+		}
+	}
+}
+
+func TestBruteKMediansGeneralOddWindows(t *testing.T) {
+	input := []float64{8, 1, 5, -2, 7, 3}
+	want := []float64{5, 1, 5, 3}
+	if got := BruteKMedians(input, 3); !reflect.DeepEqual(got, want) {
+		t.Errorf("BruteKMedians(%v, 3) = %v, want %v", input, got, want)
+	}
+}
+
+func TestBruteKMediansGeneralEvenWindows(t *testing.T) {
+	input := []float64{10, -4, 2, 8, 1}
+	want := []float64{3, -1, 5, 4.5}
+	if got := BruteKMedians(input, 2); !reflect.DeepEqual(got, want) {
+		t.Errorf("BruteKMedians(%v, 2) = %v, want %v", input, got, want)
+	}
+}
