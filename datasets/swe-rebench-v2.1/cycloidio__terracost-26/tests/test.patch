+func TestPlan_ResourceDifferencesRetainComponentErrors(t *testing.T) {
+	lookupErr := errors.New("product not found")
+	plan := cost.NewPlan(nil, &cost.State{
+		Resources: map[string]cost.Resource{
+			"aws_instance.failed": {
+				Components: map[string]cost.Component{
+					"Compute": componentWithError(lookupErr),
+				},
+			},
+			"aws_instance.successful": {
+				Components: map[string]cost.Component{
+					"Storage": {Rate: decimal.NewFromInt(2), Quantity: decimal.NewFromInt(3)},
+				},
+			},
+		},
+	})
+
+	resourceDiffs := plan.ResourceDifferences()
+
+	var failedResource *cost.ResourceDiff
+	for i := range resourceDiffs {
+		if resourceDiffs[i].Address == "aws_instance.failed" {
+			failedResource = &resourceDiffs[i]
+			break
+		}
+	}
+	require.NotNil(t, failedResource, "the failed resource must remain available from the plan")
+	componentDiff, ok := failedResource.ComponentDiffs["Compute"]
+	require.True(t, ok, "the failed component must remain available in the plan")
+	require.NotNil(t, componentDiff.Planned)
+	assert.True(t, errors.Is(componentError(*componentDiff.Planned), lookupErr), "the plan must expose the component lookup error")
 }
 
