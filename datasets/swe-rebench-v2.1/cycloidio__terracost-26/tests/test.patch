+
+func componentError(component cost.Component) error {
+	field := reflect.ValueOf(component).FieldByName("Error")
+	if !field.IsValid() || field.IsNil() {
+		return nil
+	}
+	err, _ := field.Interface().(error)
+	return err
+}
+
+func componentWithError(err error) cost.Component {
+	component := cost.Component{}
+	field := reflect.ValueOf(&component).Elem().FieldByName("Error")
+	if field.IsValid() {
+		field.Set(reflect.ValueOf(err))
+	}
+	return component
+}
