 func assertDecimalEqual(t *testing.T, expected, actual decimal.Decimal) {
 	assert.Truef(t, expected.Equal(actual), "Not equal:\nexpected: %s\nactual  : %s", expected, actual)
 }
+
+func reflectedComponentError(t *testing.T, component *cost.Component) error {
+	t.Helper()
+	field := reflect.ValueOf(component).Elem().FieldByName("Error")
+	require.True(t, field.IsValid(), "component lookup errors must be available")
+	if field.IsNil() {
+		return nil
+	}
+	err, ok := field.Interface().(error)
+	require.True(t, ok, "component lookup error must implement error")
+	return err
+}
