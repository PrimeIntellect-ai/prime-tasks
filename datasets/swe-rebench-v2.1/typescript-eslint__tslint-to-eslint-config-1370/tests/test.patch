+import { describe, expect, test } from "@jest/globals";
+
+import { convertRules } from "../../convertRules";
+import { ruleMergers } from "../../ruleMergers";
+import { ruleConverters } from "../../ruleConverters";
+
+const convertConfiguration = (ruleArguments: string[]) =>
+    convertRules(
+        { ruleConverters, ruleMergers },
+        { typedef: { ruleArguments } },
+        new Map<string, string[]>(),
+    );
+
+describe("TSLint typedef rule conversion", () => {
+    test("converts the rule without arguments instead of reporting it as missing", () => {
+        const { converted, failed, missing } = convertConfiguration([]);
+
+        expect(failed).toEqual([]);
+        expect(missing).toEqual([]);
+        expect(converted.has("@typescript-eslint/typedef")).toBe(true);
+    });
+
+    test("converts selected arguments to ESLint options", () => {
+        const { converted, missing } = convertConfiguration([
+            "parameter",
+            "variable-declaration-ignore-function",
+            "array-destructuring",
+        ]);
+
+        expect(missing).toEqual([]);
+        expect(converted.get("@typescript-eslint/typedef")?.ruleArguments).toEqual([
+            {
+                parameter: true,
+                variableDeclarationIgnoreFunction: true,
+                arrayDestructuring: true,
+            },
+        ]);
+    });
+
+    test("converts all supported typedef arguments", () => {
+        const { converted, missing } = convertConfiguration([
+            "parameter",
+            "arrow-parameter",
+            "property-declaration",
+            "variable-declaration",
+            "variable-declaration-ignore-function",
+            "member-variable-declaration",
+            "object-destructuring",
+            "array-destructuring",
+        ]);
+
+        expect(missing).toEqual([]);
+        expect(converted.get("@typescript-eslint/typedef")?.ruleArguments).toEqual([
+            {
+                parameter: true,
+                arrowParameter: true,
+                propertyDeclaration: true,
+                variableDeclaration: true,
+                variableDeclarationIgnoreFunction: true,
+                memberVariableDeclaration: true,
+                objectDestructuring: true,
+                arrayDestructuring: true,
+            },
+        ]);
+    });
+});
