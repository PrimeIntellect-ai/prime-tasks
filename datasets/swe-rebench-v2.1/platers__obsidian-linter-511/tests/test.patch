+
+
+describe('YAML Title repeated linting', () => {
+  it('keeps frontmatter valid when linting a wikilink heading twice', () => {
+    const ruleConfigs = Object.fromEntries(rules.map((rule) => {
+      const options = rule.getDefaultOptions();
+      options[rule.enabledOptionName()] = ['YAML Title', 'YAML Title Alias'].includes(rule.name);
+      return [rule.name, options];
+    }));
+    const settings: LinterSettings = {
+      ruleConfigs,
+      lintOnSave: false,
+      displayChanged: true,
+      foldersToIgnore: [],
+      linterLocale: 'en',
+      logLevel: 0,
+      lintCommands: [],
+      customRegexs: [],
+      commonStyles: {
+        aliasArrayStyle: NormalArrayFormats.SingleLine,
+        tagArrayStyle: NormalArrayFormats.SingleLine,
+        minimumNumberOfDollarSignsToBeAMathBlock: 2,
+        escapeCharacter: '"',
+      },
+    };
+    const runner = new RulesRunner();
+    const lint = (text: string) => runner.lintText(
+        createRunLinterRulesOptions(text, null, 'en', settings),
+    );
+    const firstPass = lint(dedent`
+      ---
+      language: de
+      Vault: Privat
+      title: [[Test]]
+      tags:
+      aliases: [[[Test]]]
+      ---
+      # [[Test]]
+    `);
+    const secondPass = lint(firstPass);
+    const frontmatter = secondPass.match(/^---\n([\s\S]*?)\n---/);
+
+    expect(frontmatter).not.toBeNull();
+    expect(loadYAML(frontmatter![1]).title).toBe('Test');
+  });
+});
