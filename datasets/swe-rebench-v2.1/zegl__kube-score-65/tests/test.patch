+func TestServiceTypeFlagsOnlyNodePort(t *testing.T) {
+	tests := []struct {
+		name        string
+		serviceType string
+		wantFlagged bool
+	}{
+		{name: "NodePort", serviceType: "  type: NodePort\n", wantFlagged: true},
+		{name: "ClusterIP", serviceType: "  type: ClusterIP\n"},
+		{name: "LoadBalancer", serviceType: "  type: LoadBalancer\n"},
+		{name: "ExternalName", serviceType: "  type: ExternalName\n"},
+		{name: "omitted"},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			flagged := serviceNotFullyAcceptableCount(t, test.serviceType)
+			if hasFlag := flagged > 0; hasFlag != test.wantFlagged {
+				t.Errorf("Service flagged = %t, want %t", hasFlag, test.wantFlagged)
+			}
+		})
+	}
+}
+
+// serviceNotFullyAcceptableCount scores a Service that targets an existing Pod and
+// returns how many of the Service's own scores are below the fully acceptable grade.
+func serviceNotFullyAcceptableCount(t *testing.T, serviceType string) int {
+	t.Helper()
+	document := "apiVersion: v1\nkind: Pod\nmetadata:\n  name: policy-pod\n  namespace: test\n  labels:\n    app: web\nspec:\n  containers:\n  - name: web\n    image: nginx\n---\n"
+	document += "apiVersion: v1\nkind: Service\nmetadata:\n  name: policy-check\n  namespace: test\nspec:\n  selector:\n    app: web\n  ports:\n  - port: 80\n"
+	document += serviceType
+	result, err := Score(Configuration{AllFiles: []io.Reader{strings.NewReader(document)}})
+	if err != nil {
+		t.Fatalf("scoring Service failed: %v", err)
+	}
+
+	flagged := 0
+	for _, scores := range result.Scores {
+		for _, score := range scores {
+			if score.ResourceRef.Kind != "Service" || score.ResourceRef.Name != "policy-check" {
+				continue
+			}
+			if score.Grade < scorecard.GradeAllOK {
+				flagged++
+			}
+		}
+	}
+	return flagged
+}
