diff --git a/.circleci/config.yml b/.circleci/config.yml
index 1a16f98..7f9c558 100644
--- a/.circleci/config.yml
+++ b/.circleci/config.yml
@@ -213,6 +213,42 @@ jobs:
             . env/bin/activate
             make -C docs/ linkcheck
 
+  test-cli:
+    parameters:
+      python-version:
+        type: string
+
+    docker:
+      - image: cimg/python:<< parameters.python-version >>
+
+    steps:
+      - checkout
+
+      - run:
+          name: Install
+          command: |
+            python -m venv env
+            . env/bin/activate
+            pip install .
+            pip install dwave-inspector
+
+      - run:
+          name: Test contrib install
+          command: |
+            . env/bin/activate
+
+            # listing works
+            dwave install --list -v | grep -F 'Package: inspector'
+
+            # assert inspector not installed
+            ! pip show dwave-inspectorapp
+
+            # install works
+            dwave install inspector --yes
+
+            # assert inspector installed
+            pip show dwave-inspectorapp
+
