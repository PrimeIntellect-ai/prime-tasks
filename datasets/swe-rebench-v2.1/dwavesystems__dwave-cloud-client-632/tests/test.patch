+    def test_install_list_with_legacy_entry_points_api(self):
+        script = """
+import importlib.metadata
+
+current_entry_points = importlib.metadata.entry_points
+def legacy_entry_points(*args, **kwargs):
+    if kwargs.get('group') == 'dwave_contrib':
+        raise TypeError("entry_points() got an unexpected keyword argument 'group'")
+    return current_entry_points(*args, **kwargs)
+
+importlib.metadata.entry_points = legacy_entry_points
+from click.testing import CliRunner
+from dwave.cloud.cli import cli
+
+result = CliRunner().invoke(cli, ['install', '--list'])
+assert result.exit_code == 0, result.output + repr(result.exception)
+"""
+        result = subprocess.run(
+            [sys.executable, "-c", script], capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
