+from datetime import datetime, timezone, timedelta
+
+import pytest
+
+from planet import data_filter, exceptions
+
+
+def _as_utc(value):
+    if value.endswith('Z'):
+        value = value[:-1] + '+00:00'
+    parsed = datetime.fromisoformat(value)
+    assert parsed.tzinfo is not None and parsed.utcoffset() is not None
+    return parsed.astimezone(timezone.utc)
+
+
+def test_and_filter():
+    f1 = {'type': 'testf1'}
+    f2 = {'type': 'testf2'}
+    result = data_filter.and_filter([f1, f2])
+    assert result['type'] == 'AndFilter'
+    assert len(result['config']) == 2
+    assert f1 in result['config']
+    assert f2 in result['config']
+
+
+def test_or_filter():
+    f1 = {'type': 'testf1'}
+    f2 = {'type': 'testf2'}
+    result = data_filter.or_filter([f1, f2])
+    assert result['type'] == 'OrFilter'
+    assert len(result['config']) == 2
+    assert f1 in result['config']
+    assert f2 in result['config']
+
+
+def test_not_filter():
+    nested_filter = {'type': 'testf1'}
+    result = data_filter.not_filter(nested_filter)
+    assert result == {'type': 'NotFilter', 'config': nested_filter}
+
+
+def test_range_filter_success():
+    result = data_filter.range_filter(
+        'testfield', gt=0.1, lt=0.9, gte=0.2, lte=0.8)
+    assert result == {
+        'type': 'RangeFilter',
+        'field_name': 'testfield',
+        'config': {'gt': 0.1, 'lt': 0.9, 'gte': 0.2, 'lte': 0.8}
+    }
+
+
+def test_range_filter_requires_at_least_one_bound():
+    with pytest.raises(exceptions.PlanetError):
+        data_filter.range_filter('acquired')
+
+
+def test_date_range_filter_success_serializes_instants():
+    result = data_filter.date_range_filter(
+        'testfield',
+        gt=datetime(2022, 6, 1, 1, tzinfo=timezone(timedelta(hours=1))),
+        lt=datetime(2022, 7, 1, 1),
+        gte=datetime(2022, 6, 2, 1),
+        lte=datetime(2022, 6, 30, 1))
+    assert result['type'] == 'DateRangeFilter'
+    assert result['field_name'] == 'testfield'
+    assert _as_utc(result['config']['gt']) == datetime(
+        2022, 6, 1, tzinfo=timezone.utc)
+    # Naive datetime timezone interpretation is not specified by the API.
+    # Confirm these values serialize as timezone-aware RFC 3339 timestamps,
+    # without requiring them to denote UTC wall time.
+    _as_utc(result['config']['lt'])
+    _as_utc(result['config']['gte'])
+    _as_utc(result['config']['lte'])
+
+
+def test_date_range_filter_requires_at_least_one_bound():
+    with pytest.raises(exceptions.PlanetError):
+        data_filter.date_range_filter('acquired')
+
+
+def test_update_filter_success_serializes_update_bound():
+    result = data_filter.update_filter(
+        'testfield',
+        gt=datetime(2022, 6, 1, 1),
+        gte=datetime(2022, 6, 2, 1))
+    assert result['type'] == 'UpdateFilter'
+    assert result['field_name'] == 'testfield'
+    # Naive datetime timezone interpretation is not specified by the API.
+    _as_utc(result['config']['gt'])
+    _as_utc(result['config']['gte'])
+
+
+def test_update_filter_requires_at_least_one_bound():
+    with pytest.raises(exceptions.PlanetError):
+        data_filter.update_filter('acquired')
+
+
+def test_geometry_filter(geom_geojson):
+    result = data_filter.geometry_filter(geom_geojson)
+    assert result == {
+        'type': 'GeometryFilter',
+        'field_name': 'geometry',
+        'config': geom_geojson
+    }
+
+
+def test_number_in_filter():
+    result = data_filter.number_in_filter('testfield', [3, 3])
+    assert result['type'] == 'NumberInFilter'
+    assert result['field_name'] == 'testfield'
+    assert set(result['config']) == {3}
+
+
+def test_string_in_filter():
+    result = data_filter.string_in_filter('testfield', ['three', 'three'])
+    assert result['type'] == 'StringInFilter'
+    assert result['field_name'] == 'testfield'
+    assert set(result['config']) == {'three'}
+
+
+def test_asset_filter():
+    expected = {'asset1', 'asset2'}
+    results = []
+    for arguments in ((['asset1', 'asset2'],), ('asset1', 'asset2')):
+        try:
+            results.append(data_filter.asset_filter(*arguments))
+        except TypeError:
+            # Implementations may expose a collection argument or positional
+            # asset types; the public contract does not prescribe which.
+            pass
+
+    assert any(
+        result.get('type') == 'AssetFilter'
+        and isinstance(result.get('config'), (list, tuple))
+        and set(result['config']) == expected
+        for result in results
+    )
+
+
+def test_permission_filter():
+    result = data_filter.permission_filter()
+    assert result == {
+        'type': 'PermissionFilter', 'config': ['assets:download']
+    }
