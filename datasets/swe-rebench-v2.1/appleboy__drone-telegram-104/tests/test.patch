@@ -497,3 +500,44 @@ func TestProxySendMessage(t *testing.T) {
 	err := plugin.Exec()
 	assert.Nil(t, err)
 }
+
+type telegramTestTransport struct {
+	message string
+}
+
+func (transport *telegramTestTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	response := `{"ok":true,"result":{"message_id":1,"date":1,"chat":{"id":1,"type":"private"}}}`
+	if strings.HasSuffix(request.URL.Path, "/sendMessage") {
+		_ = request.ParseForm()
+		transport.message = request.Form.Get("text")
+	}
+	return &http.Response{
+		StatusCode: http.StatusOK,
+		Header:     make(http.Header),
+		Body:       ioutil.NopCloser(strings.NewReader(response)),
+		Request:    request,
+	}, nil
+}
+
+func TestBuildTemplate(t *testing.T) {
+	transport := &telegramTestTransport{}
+	previousTransport := http.DefaultTransport
+	http.DefaultTransport = transport
+	defer func() { http.DefaultTransport = previousTransport }()
+
+	plugin := Plugin{
+		Config: Config{
+			Token:   "test-token",
+			To:      []string{"1"},
+			Message: `duration={{duration build.started build.finished}}; datetime={{datetime build.started "2006-01-02" "UTC"}}; since={{since build.started}}`,
+		},
+		Build: Build{
+			Started:  1600000000,
+			Finished: 1600000180,
+		},
+	}
+
+	err := plugin.Exec()
+	assert.NoError(t, err)
+	assert.Regexp(t, `(?s)duration=.+; datetime=.+; since=.+`, transport.message)
+}
