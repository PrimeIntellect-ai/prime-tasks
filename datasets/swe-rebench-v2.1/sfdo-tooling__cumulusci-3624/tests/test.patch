+    @responses.activate
+    def test_merge_to_future_release_branches_noskip_future(self):
+        """A main commit is merged into every feature branch when future releases are enabled."""
+        expected_targets = {
+            "feature/230",
+            "feature/232",
+            "feature/300",
+        }
+        self._setup_mocks(
+            ["main", *sorted(expected_targets)],
+            merges=False,
+        )
+        for _ in expected_targets:
+            self._mock_merge()
+
+        task = self._create_task(
+            task_config={
+                "options": {
+                    "source_branch": "main",
+                    "branch_prefix": "feature/",
+                    "update_future_releases": False,
+                    "skip_future_releases": False,
+                }
+            }
+        )
+
+        task()
+
+        merged_targets = {
+            json.loads(call.request.body)["base"]
+            for call in responses.calls
+            if call.request.method == "POST"
+            and call.request.url.endswith("/merges")
+        }
+        assert merged_targets == expected_targets
+
