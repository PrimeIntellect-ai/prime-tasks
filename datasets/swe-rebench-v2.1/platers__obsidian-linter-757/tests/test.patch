+
+describe('YAML Title Alias numeric header quoting', () => {
+  it('quotes a purely numerical header when adding it as an alias', () => {
+    const before = dedent`
+      ---
+      aliases:
+        - alias1
+      ---
+      # 12456378
+    `;
+    const result = YamlTitleAlias.getRule().apply(before, {
+      aliasArrayStyle: NormalArrayFormats.MultiLine,
+      useYamlKeyToKeepTrackOfOldFilenameOrHeading: false,
+    });
+
+    expect(result).toMatch(/^\s+- (["'])12456378\1\s*$/m);
+  });
+
+  it('quotes a purely numerical filename when adding it as an alias without a header', () => {
+    const before = dedent`
+      ---
+      aliases: [alias1]
+      ---
+    `;
+    const result = YamlTitleAlias.getRule().apply(before, {
+      aliasArrayStyle: NormalArrayFormats.SingleLine,
+      useYamlKeyToKeepTrackOfOldFilenameOrHeading: false,
+      keepAliasThatMatchesTheFilename: true,
+      fileName: '12345678',
+    });
+
+    expect(result).toMatch(/^aliases: \[.*(["'])12345678\1.*\]$/m);
+  });
+});
