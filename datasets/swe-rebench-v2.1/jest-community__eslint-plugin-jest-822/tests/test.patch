diff --git a/src/rules/__tests__/prefer-expect-resolves.test.ts b/src/rules/__tests__/prefer-expect-resolves.test.ts
new file mode 100644
index 0000000..8f58910
--- /dev/null
+++ b/src/rules/__tests__/prefer-expect-resolves.test.ts
@@ -0,0 +1,75 @@
+import { TSESLint } from '@typescript-eslint/experimental-utils';
+import dedent from 'dedent';
+import { Linter } from 'eslint';
+import resolveFrom from 'resolve-from';
+import plugin from '../../';
+const rule = plugin.rules['prefer-expect-resolves'];
+const ruleTester = new TSESLint.RuleTester({
+  parser: resolveFrom(require.resolve('eslint'), 'espree'),
+  parserOptions: {
+    ecmaVersion: 2017,
+  },
+});
+
+ruleTester.run('prefer-expect-resolves', rule, {
+  valid: [
+    dedent`
+      it('passes', async () => {
+        await expect(someValue()).resolves.toBe(true);
+      });
+    `,
+    dedent`
+      it('is true', async () => {
+        const myPromise = Promise.resolve(true);
+
+        await expect(myPromise).resolves.toBe(true);
+      });
+    `,
+    dedent`
+      it('errors', async () => {
+        await expect(Promise.rejects('oh noes!')).rejects.toThrow('oh noes!');
+      });
+    `,
+  ],
+  invalid: [],
+});
+
+const linter = new Linter();
+
+linter.defineRule('prefer-expect-resolves', rule);
+
+describe('prefer-expect-resolves reports awaited promise assertions', () => {
+  it('reports expect(await someValue())', () => {
+    const messages = linter.verify(
+      dedent`
+        it('passes', async () => {
+          expect(await someValue()).toBe(true);
+        });
+      `,
+      {
+        parserOptions: { ecmaVersion: 2017 },
+        rules: { 'prefer-expect-resolves': 'error' },
+      },
+    );
+
+    expect(messages.length).toBeGreaterThan(0);
+  });
+
+  it('reports expect(await promise)', () => {
+    const messages = linter.verify(
+      dedent`
+        it('is true', async () => {
+          const myPromise = Promise.resolve(true);
+
+          expect(await myPromise).toBe(true);
+        });
+      `,
+      {
+        parserOptions: { ecmaVersion: 2017 },
+        rules: { 'prefer-expect-resolves': 'error' },
+      },
+    );
+
+    expect(messages.length).toBeGreaterThan(0);
+  });
+});
