+def test_package_dag_filter_include_exclude_both_used(t_fnmatch: PackageDAG) -> None:
+    with pytest.raises(AssertionError):
+        t_fnmatch.filter_nodes(["a.a", "a.b"], {"a.b"})
+
+
+def test_package_dag_filter_nonexistent_packages(t_fnmatch: PackageDAG) -> None:
+    with pytest.raises(ValueError, match="No packages matched using the following patterns: x, y, z"):
+        t_fnmatch.filter_nodes(["x", "y", "z"], None)
+
+
+def test_package_dag_filter_fnmatch_include_is_case_insensitive(t_fnmatch: PackageDAG) -> None:
+    graph = dag_to_dict(t_fnmatch.filter_nodes(["A.*"], None))
+    assert graph == {"a.a": ["a.b", "a.c"], "a.b": ["a.c"]}
+
+
+def test_package_dag_filter_nonexistent_packages_lists_only_unmatched(t_fnmatch: PackageDAG) -> None:
+    with pytest.raises(ValueError) as excinfo:
+        t_fnmatch.filter_nodes(["a.a", "x"], None)
+    message = str(excinfo.value)
+    assert "x" in message
+    assert "a.a" not in message
+
+
+def test_main_missing_package_returns_error(capsys: pytest.CaptureFixture[str]) -> None:
+    from pipdeptree.__main__ import main
+
+    return_code = main(["-p", "nonexistent_package_xyz", "-w", "fail"])
+    assert (return_code or 0) != 0
+    captured = capsys.readouterr()
+    assert captured.err.strip()
+
