@@ -1,3 +1,6 @@
+import os
+import tempfile
+
 from mock import Mock, PropertyMock, patch, mock_open
 
 from patroni.postgresql import Postgresql
@@ -274,6 +277,39 @@ class TestRewind(BaseTestPostgresql):
             self.r._archive_ready_wals()
             mock_logger_info.assert_not_called()
 
+    def test_archive_ready_wals_runs_shell_command(self):
+        wal = '000000000000000000000000'
+        with tempfile.TemporaryDirectory() as wal_dir:
+            status_dir = os.path.join(wal_dir, 'archive_status')
+            os.makedirs(status_dir)
+            for filename in (wal, wal + '.ready'):
+                with open(os.path.join(wal_dir if filename == wal else status_dir, filename), 'w'):
+                    pass
+            marker = os.path.join(wal_dir, 'shell-command-ran')
+            command = 'true && touch ' + marker
+            with patch.object(Postgresql, 'wal_dir', new_callable=PropertyMock, return_value=wal_dir), \
+                    patch.object(Postgresql, 'get_guc_value', Mock(side_effect=['on', command])):
+                self.r._archive_ready_wals()
+
+            self.assertTrue(os.path.isfile(marker))
+
+    def test_archive_ready_wals_runs_pipeline_command(self):
+        wal = '000000000000000000000000'
+        with tempfile.TemporaryDirectory() as wal_dir:
+            status_dir = os.path.join(wal_dir, 'archive_status')
+            os.makedirs(status_dir)
+            for filename in (wal, wal + '.ready'):
+                with open(os.path.join(wal_dir if filename == wal else status_dir, filename), 'w'):
+                    pass
+            marker = os.path.join(wal_dir, 'pipeline-output')
+            command = 'printf pipeline | tee ' + marker
+            with patch.object(Postgresql, 'wal_dir', new_callable=PropertyMock, return_value=wal_dir), \
+                    patch.object(Postgresql, 'get_guc_value', Mock(side_effect=['on', command])):
+                self.r._archive_ready_wals()
+
+            with open(marker) as output:
+                self.assertEqual(output.read(), 'pipeline')
+
     @patch.object(Postgresql, 'major_version', PropertyMock(return_value=100000))
     @patch('os.listdir', Mock(side_effect=[OSError, ['something', 'something_else']]))
     @patch('shutil.rmtree', Mock())
