+  it("converts plurals for a country-coded language header", () => {
+    const pofile = `
+msgid ""
+msgstr ""
+"Language: en_CA\\n"
+
+#. js-lingui:pluralize_on=someCount
+msgid "message_with_id"
+msgid_plural "message_with_id_plural"
+msgstr[0] "Singular case"
+msgstr[1] "Case number {someCount}"
+`
+
+    const catalog = format.parse(pofile)
+    const translation = catalog.message_with_id.translation
+
+    expect(translation).toContain("plural")
+    expect(translation).toContain("one {Singular case}")
+    expect(translation).toContain("other {Case number {someCount}}")
+  })
+
+  it("converts plurals for a country-coded French language header", () => {
+    const pofile = `
+msgid ""
+msgstr ""
+"Language: fr-CA\n"
+
+#. js-lingui:pluralize_on=someCount
+msgid "message_with_id"
+msgid_plural "message_with_id_plural"
+msgstr[0] "Cas singulier"
+msgstr[1] "Cas numéro {someCount}"
+`
+
+    const catalog = format.parse(pofile)
+    const translation = catalog.message_with_id.translation
+
+    expect(translation).toContain("plural")
+    expect(translation).toContain("one {Cas singulier}")
+    expect(translation).toContain("other {Cas numéro {someCount}}")
+  })
+
+  it("converts plurals for a country-coded language header with more than two cases", () => {
+    const pofile = `
+msgid ""
+msgstr ""
+"Language: ru_RU\\n"
+
+#. js-lingui:pluralize_on=someCount
+msgid "message_with_id"
+msgid_plural "message_with_id_plural"
+msgstr[0] "Один {someCount}"
+msgstr[1] "Несколько {someCount}"
+msgstr[2] "Много {someCount}"
+`
+
+    const catalog = format.parse(pofile)
+    const translation = catalog.message_with_id.translation
+
+    expect(translation).toContain("plural")
+    expect(translation).toContain("one {")
+    expect(translation).toContain("few {")
+    expect(translation).toContain("many {")
+  })
 })
