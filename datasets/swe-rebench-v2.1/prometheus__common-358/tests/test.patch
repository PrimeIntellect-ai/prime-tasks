 }
+
+func TestOAuth2Proxy(t *testing.T) {
+	_, _, err := LoadHTTPConfigFile("testdata/http.conf.oauth2-proxy.good.yml")
+	if err != nil {
+		t.Errorf("Error loading OAuth2 client config: %v", err)
+	}
+}
+
+func TestOAuth2ProxyRoundTrip(t *testing.T) {
+	var proxyHit bool
+	proxyTS := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		proxyHit = true
+		res, _ := json.Marshal(oauth2TestServerResponse{
+			AccessToken: "12345",
+			TokenType:   "Bearer",
+		})
+		w.Header().Add("Content-Type", "application/json")
+		_, _ = w.Write(res)
+	}))
+	defer proxyTS.Close()
+
+	tokenTS := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		res, _ := json.Marshal(oauth2TestServerResponse{
+			AccessToken: "12345",
+			TokenType:   "Bearer",
+		})
+		w.Header().Add("Content-Type", "application/json")
+		_, _ = w.Write(res)
+	}))
+	defer tokenTS.Close()
+
+	var targetHit bool
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		targetHit = true
+		if auth := r.Header.Get("Authorization"); auth != "Bearer 12345" {
+			t.Errorf("Expected authorization header to be 'Bearer 12345', got '%s'", auth)
+		}
+		fmt.Fprintln(w, "Hello, client")
+	}))
+	defer ts.Close()
+
+	var yamlConfig = fmt.Sprintf(`
+client_id: 1
+client_secret: 2
+token_url: %s
+proxy_url: %s
+`, tokenTS.URL, proxyTS.URL)
+
+	var config OAuth2
+	if err := yaml.Unmarshal([]byte(yamlConfig), &config); err != nil {
+		t.Fatalf("Expected no error unmarshalling yaml, got %v", err)
+	}
+
+	rt := NewOAuth2RoundTripper(&config, http.DefaultTransport)
+	client := http.Client{Transport: rt}
+
+	if _, err := client.Get(ts.URL); err != nil {
+		t.Fatalf("unexpected error while executing request: %s", err)
+	}
+	if !proxyHit {
+		t.Fatal("expected the OAuth2 token request to be sent through the configured proxy")
+	}
+	if !targetHit {
+		t.Fatal("expected the request to reach the target server")
+	}
+}
