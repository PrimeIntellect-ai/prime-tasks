+describe("MathML text entity escaping", function() {
+    const expectLessThanText = container => {
+        const operator = container.querySelector("math mo");
+        expect(operator).not.toBeNull();
+        expect(operator.textContent).toBe("<");
+        expect(operator.innerHTML).toContain("&lt;");
+        expect(operator.innerHTML).not.toContain("&amp;lt;");
+
+        const annotation = container.querySelector("math annotation");
+        expect(annotation).not.toBeNull();
+        expect(annotation.textContent).toBe("x < y");
+    };
+
+    it("does not double-encode text rendered into a DOM", function() {
+        const container = document.createElement("div");
+        katex.render("x < y", container);
+        expectLessThanText(container);
+    });
+
+    it("preserves renderToString output when inserted into a DOM", function() {
+        const container = document.createElement("div");
+        container.innerHTML = katex.renderToString("x < y");
+        expectLessThanText(container);
+    });
+});
