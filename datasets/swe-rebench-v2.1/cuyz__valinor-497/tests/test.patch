+    public function test_object_with_one_array_of_objects_property_can_be_mapped_when_superfluous_key_is_present(): void
+    {
+        try {
+            $result = $this->mapper->map(ObjectWithSingleArrayOfObjectsProperty::class, [
+                'identifiers' => [
+                    ['value' => 'some-identifier'],
+                    ['value' => 'some-identifier2'],
+                ],
+                'superfluous_key' => 'useless value',
+            ]);
+        } catch (MappingError $error) {
+            $this->mappingFail($error);
+        }
+
+        self::assertCount(2, $result->identifiers);
+        self::assertSame('some-identifier', $result->identifiers[0]->value);
+        self::assertSame('some-identifier2', $result->identifiers[1]->value);
+    }
