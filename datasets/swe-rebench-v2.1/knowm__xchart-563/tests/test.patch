+package org.knowm.xchart.internal.chartpart;
+
+import java.awt.Color;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.util.Arrays;
+import java.util.List;
+import javax.imageio.ImageIO;
+import org.junit.Assert;
+import org.junit.Test;
+import org.knowm.xchart.BitmapEncoder;
+import org.knowm.xchart.CategoryChart;
+
+public class AxisTickCalculator_CategoryTest {
+
+  @Test
+  public void renderedXAxisHonorsMaximumLabelCount() throws Exception {
+    BufferedImage withLabels = renderChart(Color.BLACK);
+    BufferedImage withoutLabels = renderChart(new Color(0, 0, 0, 0));
+
+    Assert.assertTrue(
+        "the rendered X axis must not show more labels than configured",
+        countSeparatedLabelRegions(withLabels, withoutLabels) <= 3);
+  }
+
+  private BufferedImage renderChart(Color labelColor) throws Exception {
+    List<String> categories = Arrays.asList("one", "two", "three", "four", "five", "six");
+    List<Double> values = Arrays.asList(2.0, 1.0, 0.0, -1.0, 2.0, 4.0);
+    CategoryChart chart = new CategoryChart(800, 600);
+    chart.addSeries("first", categories, values);
+    chart.getStyler().setLegendVisible(false);
+    chart.getStyler().setXAxisMaxLabelCount(3);
+    chart.getStyler().setXAxisTickLabelsColor(labelColor);
+
+    byte[] image = BitmapEncoder.getBitmapBytes(chart, BitmapEncoder.BitmapFormat.PNG);
+    return ImageIO.read(new ByteArrayInputStream(image));
+  }
+
+  private int countSeparatedLabelRegions(BufferedImage withLabels, BufferedImage withoutLabels) {
+    int regions = 0;
+    int lastChangedColumn = Integer.MIN_VALUE;
+    for (int x = 0; x < withLabels.getWidth(); x++) {
+      boolean columnChanged = false;
+      for (int y = 0; y < withLabels.getHeight(); y++) {
+        if (withLabels.getRGB(x, y) != withoutLabels.getRGB(x, y)) {
+          columnChanged = true;
+          break;
+        }
+      }
+      if (columnChanged) {
+        if (lastChangedColumn == Integer.MIN_VALUE || x - lastChangedColumn > 20) {
+          regions++;
+        }
+        lastChangedColumn = x;
+      }
+    }
+    return regions;
+  }
+}
