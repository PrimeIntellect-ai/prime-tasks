+
+func TestDumpCmdPassFileEnv(t *testing.T) {
+	fileTarget := "file:///foo/bar"
+
+	tests := []struct {
+		name         string
+		env          map[string]string
+		expectedPass string
+	}{
+		{
+			name:         "DB_PASS_FILE env var",
+			env:          map[string]string{"DB_PASS_FILE": "testdata/password.txt"},
+			expectedPass: "testpassword",
+		},
+		{
+			name:         "DB_PASS takes precedence over DB_PASS_FILE",
+			env:          map[string]string{"DB_PASS_FILE": "testdata/password.txt", "DB_PASS": "explicitpass"},
+			expectedPass: "explicitpass",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			for k, val := range tt.env {
+				t.Setenv(k, val)
+			}
+			m := newMockExecs()
+			m.On("Dump", mock.MatchedBy(func(dumpOpts core.DumpOptions) bool {
+				return dumpOpts.DBConn.Pass == tt.expectedPass
+			})).Return(nil)
+			m.On("Timer", mock.Anything).Return(nil)
+
+			cmd, err := rootCmd(m)
+			if err != nil {
+				t.Fatal(err)
+			}
+			cmd.SetOutput(io.Discard)
+			cmd.SetArgs([]string{"dump", "--server", "abc", "--target", fileTarget})
+			if err := cmd.Execute(); err != nil {
+				t.Fatal(err)
+			}
+			m.AssertExpectations(t)
+		})
+	}
+}
