+
+describe("padded-blocks autofix", () => {
+    it("should generate valid code when a block has a comment on the opening brace line", () => {
+        const cliEngine = new CLIEngine({
+            useEslintrc: false,
+            fix: true,
+            rules: { "padded-blocks": ["error", "never"] }
+        });
+        const code = "function foo() { // a\n\n  b;\n}";
+        const result = cliEngine.executeOnText(code).results[0];
+        const output = result.output;
+
+        assert.equal(result.messages.length, 0, "the fixed code should not contain any lint or parse errors");
+        assert.doesNotThrow(() => espree.parse(output, { ecmaVersion: 6 }));
+        assert.equal(output.split("function foo()").length - 1, 1, "the fixed code should not duplicate the function declaration");
+    });
+});
