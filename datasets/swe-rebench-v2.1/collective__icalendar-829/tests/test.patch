@@ -0,0 +1,28 @@
+"""Event equality should reflect the instants represented by its times."""
+
+from datetime import datetime
+from zoneinfo import ZoneInfo
+
+from icalendar import Event
+
+
+def event_starting_at(value):
+    event = Event()
+    event.start = value
+    return event
+
+
+def test_events_with_equivalent_instants_compare_equal():
+    utc_time = datetime(2025, 5, 8, 12, 0, tzinfo=ZoneInfo("UTC"))
+    zurich_time = utc_time.astimezone(ZoneInfo("Europe/Zurich"))
+
+    assert zurich_time == utc_time
+    assert event_starting_at(utc_time) == event_starting_at(zurich_time)
+
+
+def test_events_with_different_instants_do_not_compare_equal():
+    zurich_time = datetime(2025, 5, 8, 12, 0, tzinfo=ZoneInfo("Europe/Zurich"))
+    utc_time = datetime(2025, 5, 8, 12, 0, tzinfo=ZoneInfo("UTC"))
+
+    assert zurich_time != utc_time
+    assert event_starting_at(zurich_time) != event_starting_at(utc_time)
