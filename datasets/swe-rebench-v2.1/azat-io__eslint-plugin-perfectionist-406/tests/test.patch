+import { Linter } from 'eslint'
+import * as parser from '@typescript-eslint/parser'
+import { describe, expect, it } from 'vitest'
+import { dedent } from 'ts-dedent'
+
+import rule from '../rules/sort-interfaces'
+
+let linter = new Linter()
+
+describe('natural order desc', () => {
+  let verify = (code: string) =>
+    linter.verify(
+      code,
+      [
+        {
+          languageOptions: {
+            parser,
+            parserOptions: { ecmaVersion: 'latest', sourceType: 'module' },
+          },
+          plugins: { perfectionist: { rules: { 'sort-interfaces': rule } } },
+          rules: {
+            'perfectionist/sort-interfaces': [
+              'error',
+              { type: 'natural', order: 'desc' },
+            ],
+          },
+        },
+      ],
+    )
+
+  it('reports interface properties that are in ascending order', () => {
+    let messages = verify(dedent`
+      interface Test {
+        a: string
+        b: string
+      }
+    `)
+
+    expect(messages.length).toBeGreaterThan(0)
+    expect(messages[0]?.severity).toBe(2)
+  })
+
+  it('accepts interface properties that are in descending order', () => {
+    let messages = verify(dedent`
+      interface Test {
+        b: string
+        a: string
+      }
+    `)
+
+    expect(messages).toHaveLength(0)
+  })
+})
