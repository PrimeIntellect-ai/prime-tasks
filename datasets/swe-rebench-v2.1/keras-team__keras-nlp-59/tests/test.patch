+"""Tests for sinusoidal positional encoding."""
+
+import tensorflow as tf
+from tensorflow import keras
+
+from keras_nlp import layers
+
+
+def _encoding_rows(pos_encoding, rows):
+    """Return the encoding of a 4x6 input at the given positions."""
+    output = pos_encoding(tf.zeros((1, 4, 6), dtype=tf.float32))
+    # The encoding may or may not carry a leading batch dimension.
+    output = tf.broadcast_to(output, [1, 4, 6])[0]
+    return tf.gather(output, rows, axis=0)
+
+
+class SinePositionEncodingTest(tf.test.TestCase):
+    def test_valid_call(self):
+        pos_encoding = layers.SinePositionEncoding()
+        embeddings = tf.random.uniform(shape=[2, 4, 6])
+        encoded = pos_encoding(embeddings)
+        combined = embeddings + encoded
+        self.assertEqual(tuple(combined.shape), tuple(embeddings.shape))
+
+    def test_output_correct_values(self):
+        pos_encoding = layers.SinePositionEncoding()
+        observed = _encoding_rows(pos_encoding, [0, 3])
+        self.assertAllClose(
+            observed,
+            [
+                [0.0, 1.0, 0.0, 1.0, 0.0, 1.0],
+                [
+                    0.14112,
+                    -0.9899925,
+                    0.1387981,
+                    0.9903207,
+                    0.00646326,
+                    0.99997914,
+                ],
+            ],
+        )
+
+    def test_positional_values_are_not_trainable(self):
+        pos_encoding = layers.SinePositionEncoding()
+        inputs = tf.zeros((1, 4, 6), dtype=tf.float32)
+        before = pos_encoding(inputs)
+        with tf.GradientTape() as tape:
+            loss = tf.reduce_sum(pos_encoding(inputs))
+        gradients = tape.gradient(loss, pos_encoding.trainable_variables)
+        updates = [
+            (gradient, variable)
+            for gradient, variable in zip(
+                gradients, pos_encoding.trainable_variables
+            )
+            if gradient is not None
+        ]
+        if updates:
+            keras.optimizers.SGD(learning_rate=0.1).apply_gradients(updates)
+        after = pos_encoding(inputs)
+        self.assertAllClose(after, before)
