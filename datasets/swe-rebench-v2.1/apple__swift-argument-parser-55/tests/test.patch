+
+  enum GroupedHelpThreeCaseChoice: String, CaseIterable { case stats, count, list }
+  struct ShortAndLongGroupedHelpCommand: ParsableCommand {
+    @Flag(name: .shortAndLong, help: "Change the program output")
+    var behaviour: GroupedHelpThreeCaseChoice
+  }
+  struct ShortGroupedHelpCommand: ParsableCommand {
+    @Flag(name: .short, default: .list, help: "Change the program output")
+    var behaviour: GroupedHelpThreeCaseChoice
+  }
+  func testGroupedHelpForThreeCaseEnumFlags() {
+    let shortAndLongHelp = groupedHelpText(for: ShortAndLongGroupedHelpCommand.self)
+    let shortAndLongUsage = usageSection(in: shortAndLongHelp)
+    let shortAndLongOptions = shortAndLongHelp.components(separatedBy: "OPTIONS:")
+      .last?.components(separatedBy: "-h, --help").first ?? ""
+
+    for name in ["--stats", "--count", "--list"] {
+      XCTAssertTrue(shortAndLongUsage.contains(name), shortAndLongHelp)
+    }
+    for name in ["-s", "--stats", "-c", "--count", "-l", "--list"] {
+      XCTAssertTrue(shortAndLongOptions.contains(name), shortAndLongHelp)
+    }
+    XCTAssertEqual(shortAndLongOptions.components(separatedBy: "Change the program output").count - 1, 1,
+                   shortAndLongHelp)
+
+    let shortHelp = groupedHelpText(for: ShortGroupedHelpCommand.self)
+    let shortUsage = usageSection(in: shortHelp)
+    let shortOptions = shortHelp.components(separatedBy: "OPTIONS:")
+      .last?.components(separatedBy: "-h, --help").first ?? ""
+
+    for name in ["-s", "-c", "-l"] {
+      XCTAssertTrue(shortUsage.contains(name), shortHelp)
+    }
+    XCTAssertTrue(shortUsage.contains("[") && shortUsage.contains("]"), shortHelp)
+    XCTAssertEqual(shortOptions.components(separatedBy: "Change the program output").count - 1, 1,
+                   shortHelp)
+  }
+
+  enum GroupedHelpFourCaseChoice: String, CaseIterable { case stats, count, list, quiet }
+  struct FourCaseGroupedHelpCommand: ParsableCommand {
+    @Flag(name: .shortAndLong, help: "Choose output format")
+    var behaviour: GroupedHelpFourCaseChoice
+  }
+
+  func testGroupedHelpSupportsMoreThanThreeEnumCases() {
+    let help = groupedHelpText(for: FourCaseGroupedHelpCommand.self)
+    let options = help.components(separatedBy: "OPTIONS:").last ?? ""
+
+    for name in ["-s", "--stats", "-c", "--count", "-l", "--list", "-q", "--quiet"] {
+      XCTAssertTrue(options.contains(name), help)
+    }
+    XCTAssertEqual(options.components(separatedBy: "Choose output format").count - 1, 1, help)
+  }
+
+  private func usageSection(in help: String) -> String {
+    guard let usageStart = help.range(of: "USAGE:") else { return "" }
+    let afterUsage = help[usageStart.lowerBound...]
+    return String(afterUsage.components(separatedBy: "OPTIONS:").first ?? "")
+  }
+
+  private func groupedHelpText<T: ParsableArguments>(for type: T.Type) -> String {
+    do {
+      _ = try T.parse(["-h"])
+      XCTFail("Expected help to be requested")
+      return ""
+    } catch {
+      return T.fullMessage(for: error)
+    }
+  }
+
 }
