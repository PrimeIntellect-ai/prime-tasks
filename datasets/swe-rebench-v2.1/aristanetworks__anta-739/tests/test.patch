+def test_anta_nrfu_wrong_catalog_format(click_runner: CliRunner) -> None:
+    """Test anta nrfu --dry-run with an unsupported catalog format."""
+    result = click_runner.invoke(anta, ["nrfu", "--dry-run", "--catalog-format", "toto"])
+    assert result.exit_code == ExitCode.USAGE_ERROR
+    # The option must be recognized; a compliant implementation may word the usage error differently.
+    assert "No such option" not in result.output
+
+
+def test_anta_nrfu_json_catalog(click_runner: CliRunner) -> None:
+    """Test anta nrfu --dry-run with a JSON catalog selected via --catalog-format."""
+    result = click_runner.invoke(anta, ["nrfu", "--dry-run", "--catalog", str(DATA_DIR / "test_catalog.json"), "--catalog-format", "json"])
+    assert result.exit_code == ExitCode.OK
+    assert "Tests catalog contains 1 tests" in result.output
+
+
+def test_anta_nrfu_json_catalog_env(click_runner: CliRunner) -> None:
+    """Test anta nrfu --dry-run with a JSON catalog selected via ANTA_CATALOG_FORMAT."""
+    env = default_anta_env()
+    env["ANTA_CATALOG"] = str(DATA_DIR / "test_catalog.json")
+    env["ANTA_CATALOG_FORMAT"] = "json"
+    result = click_runner.invoke(anta, ["nrfu", "--dry-run"], env=env)
+    assert result.exit_code == ExitCode.OK
+    assert "Tests catalog contains 1 tests" in result.output
+
+
 def test_anta_password_required(click_runner: CliRunner) -> None:
     """Test that password is provided."""
