+#[test]
+fn parse_break() {
+    let ast = parse("{% for item in items %}{% break -%}{% endfor %}").unwrap();
+    match &ast[0] {
+        Node::Forloop(_, forloop, _) => {
+            assert_eq!(forloop.body.len(), 1);
+            assert!(
+                format!("{:?}", forloop.body[0]).starts_with("Break"),
+                "expected a Break node in the loop body, got {:?}",
+                forloop.body[0]
+            );
+        }
+        other => panic!("expected a forloop, got {:?}", other),
+    }
+}
+
