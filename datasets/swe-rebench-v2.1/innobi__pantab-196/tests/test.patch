+def test_frames_from_hyper_empty_table(tmp_hyper):
+    """
+    Reading all frames from a Hyper file where a table has no rows should
+    return a blank dataframe with the proper columns but no data.
+    """
+    with HyperProcess(Telemetry.DO_NOT_SEND_USAGE_DATA_TO_TABLEAU) as hyper:
+        with Connection(
+            hyper.endpoint, tmp_hyper, CreateMode.CREATE_IF_NOT_EXISTS
+        ) as connection:
+            table_def = TableDefinition(TableName("test"))
+            table_def.add_column("a", SqlType.int())
+            table_def.add_column("b", SqlType.text())
+            connection.catalog.create_table(table_def)
+
+    result = pantab.frames_from_hyper(tmp_hyper)
+
+    assert len(result) == 1
+    frame = next(iter(result.values()))
+    assert list(frame.columns) == ["a", "b"]
+    assert len(frame) == 0
