+func TestWorldRelationQueryDoesNotScaleWithOtherTargets(t *testing.T) {
+	world := NewWorld()
+	relID := ComponentID[testRelationA](&world)
+	target := world.NewEntity()
+	entity := world.NewEntity(relID)
+	world.SetRelation(entity, relID, target)
+	filter := RelationFilter{Filter: All(relID), Target: target}
+
+	measureQueries := func(count int) time.Duration {
+		started := time.Now()
+		for i := 0; i < count; i++ {
+			query := world.Query(&filter)
+			if !query.Next() {
+				t.Fatal("query did not find the entity for its target")
+			}
+			if query.Relation(relID) != target {
+				t.Fatal("query returned an entity for a different target")
+			}
+			if query.Next() {
+				t.Fatal("query returned more than the entity for its target")
+			}
+			if query.Count() != 1 {
+				t.Fatal("query count did not match its target")
+			}
+		}
+		return time.Since(started)
+	}
+
+	const repetitions = 512
+	smallNodeTime := measureQueries(repetitions)
+	for i := 0; i < 32770; i++ {
+		currentTarget := world.NewEntity()
+		if i == 0 {
+			continue
+		}
+		other := world.NewEntity(relID)
+		world.SetRelation(other, relID, currentTarget)
+	}
+	largeNodeTime := measureQueries(repetitions)
+	if largeNodeTime > smallNodeTime*100 {
+		t.Fatalf("query cost grew substantially with unrelated targets: small=%v large=%v", smallNodeTime, largeNodeTime)
+	}
 }
 
