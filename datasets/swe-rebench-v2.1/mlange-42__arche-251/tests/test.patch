+func TestWorldRelationQueryTargets(t *testing.T) {
+	world := NewWorld()
+
+	rotID := ComponentID[rotation](&world)
+	relID := ComponentID[testRelationA](&world)
+
+	targ1 := world.NewEntityWith(Component{ID: rotID, Comp: &rotation{Angle: 1}})
+	targ2 := world.NewEntityWith(Component{ID: rotID, Comp: &rotation{Angle: 2}})
+	targ3 := world.NewEntityWith(Component{ID: rotID, Comp: &rotation{Angle: 3}})
+
+	for i := 0; i < 3; i++ {
+		e := world.NewEntity(relID)
+		world.SetRelation(e, relID, targ1)
+	}
+	for i := 0; i < 2; i++ {
+		e := world.NewEntity(relID)
+		world.SetRelation(e, relID, targ2)
+	}
+	e := world.NewEntity(relID)
+	world.SetRelation(e, relID, targ3)
+
+	check := func(filter *RelationFilter, target Entity, expected int) {
+		query := world.Query(filter)
+		cnt := 0
+		for query.Next() {
+			assert.Equal(t, target, query.Relation(relID))
+			cnt++
+		}
+		assert.Equal(t, expected, cnt)
+	}
+
+	check(&RelationFilter{Filter: All(relID), Target: targ1}, targ1, 3)
+	check(&RelationFilter{Filter: All(relID), Target: targ2}, targ2, 2)
+	check(&RelationFilter{Filter: All(relID), Target: targ3}, targ3, 1)
+
+	filter1 := RelationFilter{Filter: All(relID), Target: targ1}
+	reg1 := world.Cache().Register(&filter1)
+	query := world.Query(&reg1)
+	cnt := 0
+	for query.Next() {
+		assert.Equal(t, targ1, query.Relation(relID))
+		cnt++
+	}
+	assert.Equal(t, 3, cnt)
+	world.Cache().Unregister(&reg1)
+
+	filter2 := RelationFilter{Filter: All(relID), Target: targ2}
+	reg2 := world.Cache().Register(&filter2)
+	query = world.Query(&reg2)
+	cnt = 0
+	for query.Next() {
+		assert.Equal(t, targ2, query.Relation(relID))
+		cnt++
+	}
+	assert.Equal(t, 2, cnt)
+	world.Cache().Unregister(&reg2)
+}
