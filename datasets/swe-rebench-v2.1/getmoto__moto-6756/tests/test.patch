+def test_list_notebook_instances(client):
+    for i in range(3):
+        args = {
+            "NotebookInstanceName": f"Name{i}",
+            "InstanceType": FAKE_INSTANCE_TYPE_PARAM,
+            "RoleArn": FAKE_ROLE_ARN,
+        }
+        client.create_notebook_instance(**args)
+
+    client.stop_notebook_instance(NotebookInstanceName="Name1")
+
+    instances = _list_all_notebook_instances(client)
+    assert [i["NotebookInstanceName"] for i in instances] == ["Name0", "Name1", "Name2"]
+
+    instances = _list_all_notebook_instances(client, SortBy="Status")
+    assert [i["NotebookInstanceStatus"] for i in instances] == [
+        "InService",
+        "InService",
+        "Stopped",
+    ]
+
+    instances = _list_all_notebook_instances(client, SortOrder="Descending")
+    assert [i["NotebookInstanceName"] for i in instances] == ["Name2", "Name1", "Name0"]
+
+    instances = _list_all_notebook_instances(client, NameContains="1")
+    assert [i["NotebookInstanceName"] for i in instances] == ["Name1"]
+
+    instances = _list_all_notebook_instances(client, StatusEquals="InService")
+    assert [i["NotebookInstanceName"] for i in instances] == ["Name0", "Name2"]
+
+    instances = _list_all_notebook_instances(client, StatusEquals="Pending")
+    assert [i["NotebookInstanceName"] for i in instances] == []
+
+    resp = client.list_notebook_instances(MaxResults=1)
+    instances = resp["NotebookInstances"]
+    assert [i["NotebookInstanceName"] for i in instances] == ["Name0"]
+    assert isinstance(resp.get("NextToken"), str) and resp["NextToken"]
+
+    resp = client.list_notebook_instances(MaxResults=1, NextToken=resp["NextToken"])
+    instances = resp["NotebookInstances"]
+    assert [i["NotebookInstanceName"] for i in instances] == ["Name1"]
+    assert isinstance(resp.get("NextToken"), str) and resp["NextToken"]
+
+    resp = client.list_notebook_instances(MaxResults=1, NextToken=resp["NextToken"])
+    instances = resp["NotebookInstances"]
+    assert [i["NotebookInstanceName"] for i in instances] == ["Name2"]
+    assert "NextToken" not in resp
+
+
+def test_list_notebook_instances_sort_by_creation_time(client):
+    for name in ["Name2", "Name0", "Name1"]:
+        client.create_notebook_instance(
+            NotebookInstanceName=name,
+            InstanceType=FAKE_INSTANCE_TYPE_PARAM,
+            RoleArn=FAKE_ROLE_ARN,
+        )
+        time.sleep(0.05)
+
+    instances = _list_all_notebook_instances(client, SortBy="CreationTime")
+    assert [i["NotebookInstanceName"] for i in instances] == ["Name2", "Name0", "Name1"]
+
+    instances = _list_all_notebook_instances(
+        client, SortBy="CreationTime", SortOrder="Descending"
+    )
+    assert [i["NotebookInstanceName"] for i in instances] == ["Name1", "Name0", "Name2"]
