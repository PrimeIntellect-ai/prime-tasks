+    def test_slow_output_stream_completes(self):
+        class SlowStream(object):
+            def __init__(self):
+                self.received = []
+
+            def write(self, data):
+                # The destination can stop accepting output temporarily
+                # (e.g., while a console window is being scrolled).  The
+                # tee should wait for it rather than report a deadlock.
+                time.sleep(8)
+                self.received.append(data)
+
+        output = SlowStream()
+        with tee.TeeStream(output) as t:
+            t.STDERR.write('solver output\n')
+        self.assertEqual(''.join(output.received), 'solver output\n')
+
