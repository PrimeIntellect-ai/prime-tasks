+def test_duplicate_metadata(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capfd: pytest.CaptureFixture[str]
+) -> None:
+    first_location = tmp_path / "first"
+    second_location = tmp_path / "second"
+    first_location.mkdir()
+    second_location.mkdir()
+
+    def add_distribution(location: Path, name: str, version: str, requirement: str = "") -> None:
+        metadata_dir = location / f"{name}-{version}.dist-info"
+        metadata_dir.mkdir()
+        metadata = f"Metadata-Version: 2.3\nName: {name}\nVersion: {version}\n"
+        if requirement:
+            metadata += f"Requires-Dist: {requirement}\n"
+        (metadata_dir / "METADATA").write_text(metadata)
+
+    add_distribution(first_location, "bar", "1.0", "leaf==1.0")
+    add_distribution(first_location, "leaf", "1.0")
+    add_distribution(second_location, "bar", "2.0", "leaf==1.0")
+    monkeypatch.syspath_prepend(str(first_location))
+    monkeypatch.syspath_prepend(str(second_location))
+
+    main(["--json"])
+    output, _ = capfd.readouterr()
+    packages = json.loads(output)
+    duplicate_package = [package for package in packages if package["package"]["package_name"] == "bar"]
+
+    assert len(duplicate_package) == 1
+    assert [dependency["package_name"] for dependency in duplicate_package[0]["dependencies"]] == ["leaf"]
