+    def test_reverse_timezone_without_timezone_id(self):
+        class TimezoneResponseHandler(BaseHTTPRequestHandler):
+            def do_GET(self):
+                body = json.dumps({'rawOffset': 0}).encode('utf-8')
+                self.send_response(200)
+                self.send_header('Content-Type', 'application/json')
+                self.send_header('Content-Length', str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+            def log_message(self, format, *args):
+                pass
+
+        server = HTTPServer(('127.0.0.1', 0), TimezoneResponseHandler)
+        thread = threading.Thread(target=server.serve_forever)
+        thread.daemon = True
+        thread.start()
+        try:
+            geocoder = GeoNames(username='test')
+            geocoder.api_timezone = 'http://127.0.0.1:%s/timezoneJSON' % server.server_port
+            try:
+                geocoder.reverse_timezone((0, 0))
+            except KeyError as error:
+                self.fail('reverse_timezone raised KeyError: %s' % error)
+        finally:
+            server.shutdown()
+            server.server_close()
+            thread.join()
+
 
