+class TestLogger (unittest.TestCase):
+    ''' Tests for muffling openaddr logging output.
+    '''
+
+    def test_reset_logger_restores_level_and_handlers(self):
+        ''' reset_logger() restores the level and handlers from before setup_logger().
+        '''
+        from ..ci import setup_logger, reset_logger
+
+        openaddr_logger = logging.getLogger('openaddr')
+
+        # Begin from a clean state in case an earlier test left the logger set up.
+        reset_logger()
+        level_before = openaddr_logger.level
+        handlers_before = list(openaddr_logger.handlers)
+
+        setup_logger(None, None, None, logging.CRITICAL)
+        self.assertGreater(len(openaddr_logger.handlers), len(handlers_before),
+                           'setup_logger() should add a handler')
+
+        reset_logger()
+        self.assertEqual(openaddr_logger.level, level_before,
+                         'reset_logger() should restore the previous level')
+        self.assertEqual(list(openaddr_logger.handlers), handlers_before,
+                         'reset_logger() should remove the handlers setup_logger() added')
+
+    def test_test_runner_suppresses_logging(self):
+        """A successful test.py run does not expose logging warnings."""
+        home = mkdtemp(prefix='test-logging-home-')
+        child_env = dict(environ)
+        child_env['HOME'] = home
+        child_env['OA_TEST_LOG_MARKER'] = '1'
+        test_runner = join(os.path.dirname(os.path.dirname(os.path.dirname(__file__))), 'test.py')
+        try:
+            process = subprocess.Popen(
+                [sys.executable, test_runner, 'TestCollect.test_runner_log_emitter'],
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=child_env)
+            stdout, stderr = process.communicate()
+        finally:
+            rmtree(home)
+
+        self.assertEqual(process.returncode, 0, stderr.decode('utf8', 'replace'))
+        output = stdout + stderr
+        self.assertNotIn(b'OA_TEST_LOG_MARKER', output)
+
+    def test_flask_app_log_level(self):
+        ''' A Flask app configured with MINIMUM_LOGLEVEL mutes the openaddr logger.
+        '''
+        from ..ci.webapi import apply_webapi_blueprint
+
+        app = Flask(__name__)
+        app.config['MINIMUM_LOGLEVEL'] = logging.CRITICAL
+        apply_webapi_blueprint(app)
+
+        client = app.test_client()
+        client.get('/nonexistent')
+
+        self.assertEqual(logging.getLogger('openaddr').level, logging.CRITICAL)
+
+        from ..ci import reset_logger
+        reset_logger()
+
+        # Without an explicit MINIMUM_LOGLEVEL the logger falls back to WARNING.
+        app = Flask(__name__)
+        apply_webapi_blueprint(app)
+
+        client = app.test_client()
+        client.get('/nonexistent')
+
+        self.assertEqual(logging.getLogger('openaddr').level, logging.WARNING)
+
+        reset_logger()
+
 if __name__ == '__main__':
     unittest.main()
