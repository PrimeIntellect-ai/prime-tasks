+package cloudflare
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestGetDCVDelegation(t *testing.T) {
+	setup()
+	defer teardown()
+
+	testUuid := "b9ab465427f949ed"
+
+	handler := func(w http.ResponseWriter, r *http.Request) {
+		assert.Equal(t, http.MethodGet, r.Method, "Expected method 'GET', got %s", r.Method)
+		w.Header().Set("content-type", "application/json")
+		fmt.Fprintf(w, `{
+	"success" : true,
+	"errors": [],
+	"messages": [],
+	"result": {
+		"uuid": "%s"
+	}
+}
+		`, testUuid)
+	}
+
+	mux.HandleFunc("/zones/"+testZoneID+"/dcv_delegation/uuid", handler)
+
+	actual, _, err := client.GetDCVDelegation(context.Background(), ZoneIdentifier(testZoneID), GetDCVDelegationParams{})
+
+	if assert.NoError(t, err) {
+		encoded, marshalErr := json.Marshal(actual)
+		if assert.NoError(t, marshalErr) {
+			var result interface{}
+			if assert.NoError(t, json.Unmarshal(encoded, &result)) {
+				assert.True(t, containsDCVUUID(result, testUuid), "returned value should make the endpoint UUID available")
+			}
+		}
+	}
+}
+
+func containsDCVUUID(value interface{}, uuid string) bool {
+	switch v := value.(type) {
+	case string:
+		return v == uuid
+	case []interface{}:
+		for _, item := range v {
+			if containsDCVUUID(item, uuid) {
+				return true
+			}
+		}
+	case map[string]interface{}:
+		for _, item := range v {
+			if containsDCVUUID(item, uuid) {
+				return true
+			}
+		}
+	}
+	return false
+}
