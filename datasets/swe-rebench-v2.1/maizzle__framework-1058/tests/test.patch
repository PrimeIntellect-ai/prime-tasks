diff --git a/test/test-misc.js b/test/test-misc.js
index 149cd49..bf3bb76 100644
--- a/test/test-misc.js
+++ b/test/test-misc.js
@@ -1,8 +1,79 @@
 const test = require('ava')
 const path = require('path')
+const fs = require('fs').promises
 const {requireUncached} = require('../src/utils/helpers')
+const {render} = require('../src')
 
 test('requires an uncached module', t => {
   const helpers = requireUncached(path.resolve(process.cwd(), 'src/utils/helpers'))
   t.is(typeof helpers.requireUncached, 'function')
 })
+
+test('configured component folders do not prevent lookup in default folders', async t => {
+  const folders = ['src/components', 'src/layouts', 'src/templates']
+  const id = `${process.pid}-${Date.now()}`
+  const createdDirectories = []
+  const componentFiles = []
+
+  try {
+    const components = folders.map((folder, index) => {
+      const name = `default-${index}-${id}`
+      const file = path.resolve(folder, `${name}.html`)
+      componentFiles.push(file)
+
+      return {folder, name, file, marker: `found-in-${folder}`}
+    })
+
+    for (const component of components) {
+      try {
+        await fs.access(path.dirname(component.file))
+      } catch {
+        await fs.mkdir(path.dirname(component.file), {recursive: true})
+        createdDirectories.push(path.dirname(component.file))
+      }
+
+      await fs.writeFile(component.file, `<p>${component.marker}</p>`)
+    }
+
+    const source = components.map(({name}) => `<x-${name}></x-${name}>`).join('') +
+      '<x-bare>found-in-configured-folder</x-bare>'
+    const {html} = await render(source, {
+      maizzle: {
+        env: 'maizzle-ci',
+        build: {
+          components: {
+            folders: ['test/stubs/components']
+          }
+        }
+      }
+    })
+
+    for (const component of components) {
+      t.true(html.includes(component.marker))
+    }
+    t.true(html.includes('found-in-configured-folder'))
+  } finally {
+    await Promise.all(componentFiles.map(file => fs.rm(file, {force: true})))
+    await Promise.all(createdDirectories.map(directory => fs.rmdir(directory).catch(() => {})))
+  }
+})
+
+test('configured component folders are added to the default folders', async t => {
+  const error = await t.throwsAsync(
+    render('<x-does-not-exist></x-does-not-exist>', {
+      maizzle: {
+        env: 'maizzle-ci',
+        build: {
+          components: {
+            folders: ['test/stubs/components']
+          }
+        }
+      }
+    })
+  )
+
+  t.true(error.message.includes('test/stubs/components'))
+  t.true(error.message.includes('src/components'))
+  t.true(error.message.includes('src/layouts'))
+  t.true(error.message.includes('src/templates'))
+})
