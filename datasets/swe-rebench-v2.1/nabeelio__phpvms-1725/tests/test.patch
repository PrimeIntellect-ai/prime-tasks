+    /**
+     * Processing one recurring frequency does not charge expenses of another frequency
+     */
+    public function testRecurringExpensesAreProcessedByFrequency(): void
+    {
+        /** @var Airline $airline */
+        $airline = Airline::factory()->create();
+        $airline->initJournal('USD');
+
+        /** @var Subfleet $subfleet */
+        $subfleet = Subfleet::factory()->create(['airline_id' => $airline->id]);
+
+        /** @var Expense $dailyExpense */
+        $dailyExpense = Expense::factory()->create([
+            'airline_id'   => null,
+            'type'         => ExpenseType::DAILY,
+            'amount'       => 100,
+            'ref_model'    => Subfleet::class,
+            'ref_model_id' => $subfleet->id,
+        ]);
+
+        /** @var Expense $monthlyExpense */
+        $monthlyExpense = Expense::factory()->create([
+            'airline_id'   => null,
+            'type'         => ExpenseType::MONTHLY,
+            'amount'       => 100,
+            'ref_model'    => Subfleet::class,
+            'ref_model_id' => $subfleet->id,
+        ]);
+
+        /** @var RecurringFinanceService $recurringFService */
+        $recurringFService = app(RecurringFinanceService::class);
+
+        $recurringFService->processExpenses(ExpenseType::DAILY);
+
+        $this->assertContains($airline->journal()->first()->id, $this->chargedJournalIds($dailyExpense));
+        $this->assertSame([], $this->chargedJournalIds($monthlyExpense));
+
+        $recurringFService->processExpenses(ExpenseType::MONTHLY);
+
+        $this->assertContains($airline->journal()->first()->id, $this->chargedJournalIds($monthlyExpense));
+    }
+
+    /**
+     * addExpense links the expense to the supplied model and persists it
+     */
+    public function testAddExpenseLinksToModelAndPersists(): void
+    {
+        /** @var Subfleet $subfleet */
+        $subfleet = Subfleet::factory()->create();
+
+        /** @var FinanceService $financeSvc */
+        $financeSvc = app(FinanceService::class);
+
+        $expense = $financeSvc->addExpense([
+            'name'   => 'Test Expense',
+            'amount' => 50,
+            'type'   => ExpenseType::DAILY,
+        ], $subfleet);
+
+        $this->assertInstanceOf(Expense::class, $expense);
+        $this->assertNotNull($expense->id);
+        $this->assertDatabaseHas('expenses', ['id' => $expense->id]);
+        $this->assertEquals(Subfleet::class, $expense->ref_model);
+        $this->assertEquals($subfleet->id, $expense->ref_model_id);
+    }
+
+    /**
+     * addExpense assigns the supplied airline to the expense
+     */
+    public function testAddExpenseAssignsAirlineId(): void
+    {
+        /** @var Airline $airline */
+        $airline = Airline::factory()->create();
+
+        /** @var FinanceService $financeSvc */
+        $financeSvc = app(FinanceService::class);
+
+        $expense = $financeSvc->addExpense([
+            'name'   => 'Test Expense',
+            'amount' => 50,
+            'type'   => ExpenseType::DAILY,
+        ], null, $airline->id);
+
+        $this->assertEquals($airline->id, $expense->airline_id);
+        $this->assertDatabaseHas('expenses', [
+            'id'         => $expense->id,
+            'airline_id' => $airline->id,
+        ]);
+    }
+
+    /**
+     * Return the journal IDs that were charged for the given expense
+     *
+     * @param Expense $expense
+     *
+     * @return array
+     */
+    private function chargedJournalIds(Expense $expense): array
+    {
+        return JournalTransaction::where([
+            'ref_model'    => Expense::class,
+            'ref_model_id' => $expense->id,
+        ])->pluck('journal_id')->all();
+    }
