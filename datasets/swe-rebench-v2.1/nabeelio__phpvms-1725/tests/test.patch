+    /**
+     * Daily subfleet expenses are only charged to the airline that owns the subfleet
+     */
+    public function testDailySubfleetExpenseChargedToRelevantAirline(): void
+    {
+        /** @var Airline $airline1 */
+        $airline1 = Airline::factory()->create();
+        /** @var Airline $airline2 */
+        $airline2 = Airline::factory()->create();
+
+        /** @var Subfleet $subfleet */
+        $subfleet = Subfleet::factory()->create(['airline_id' => $airline1->id]);
+
+        /** @var Expense $expense */
+        $expense = Expense::factory()->create([
+            'airline_id'   => null,
+            'type'         => ExpenseType::DAILY,
+            'amount'       => 100,
+            'ref_model'    => Subfleet::class,
+            'ref_model_id' => $subfleet->id,
+        ]);
+
+        /** @var RecurringFinanceService $recurringFService */
+        $recurringFService = app(RecurringFinanceService::class);
+
+        // Make sure every airline has a journal so the recurring service can charge them
+        foreach (Airline::all() as $existing_airline) {
+            $existing_airline->initJournal('USD');
+        }
+
+        $recurringFService->processExpenses(ExpenseType::DAILY);
+
+        $charged = $this->chargedJournalIds($expense);
+        $this->assertContains($airline1->journal()->first()->id, $charged);
+        $this->assertNotContains($airline2->journal()->first()->id, $charged);
+    }
+
