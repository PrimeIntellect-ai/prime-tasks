+
+        // Make sure every airline has a journal so the recurring service can charge them
+        foreach (Airline::all() as $existing_airline) {
+            $existing_airline->initJournal('USD');
+        }
+
+        $recurringFService->processExpenses(ExpenseType::DAILY);
+
+        $charged = $this->chargedJournalIds($expense);
+        $this->assertContains($airline1->journal()->first()->id, $charged);
+        $this->assertNotContains($airline2->journal()->first()->id, $charged);
+    }
