+// FakeNetworkWithGRPCHost builds a network configuration whose gRPC host points
+// at the given address, so tests can observe whether a command contacts a node.
+func FakeNetworkWithGRPCHost(name, host string) string {
+	return fmt.Sprintf(`
+Name = "%s"
+Level = "info"
+TokenExpiry = "1h0m0s"
+Port = 8000
+Host = "127.0.0.1"
+
+[API.GRPC]
+Retries = 1
+Hosts = [
+    "%s",
+]
+
+[API.REST]
+Hosts = [
+    "https://example.com/rest"
+]
+
+[API.GraphQL]
+Hosts = [
+    "https://example.com/gql/query"
+]
+
+[Console]
+URL = "console.example.com"
+LocalPort = 1847
+`, name, host)
+}
diff --git a/tests/sc_rotate_key_test.go b/tests/sc_rotate_key_test.go
