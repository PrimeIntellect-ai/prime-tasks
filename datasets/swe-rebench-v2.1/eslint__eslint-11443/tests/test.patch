--- a/tests/lib/rules/no-var.js
+++ b/tests/lib/rules/no-var.js
@@ -9,7 +9,9 @@
 // Requirements
 //------------------------------------------------------------------------------
 
-const rule = require("../../../lib/rules/no-var"),
+const assert = require("assert"),
+    Linter = require("../../../lib/linter"),
+    rule = require("../../../lib/rules/no-var"),
     RuleTester = require("../../../lib/testers/rule-tester");
 
 //------------------------------------------------------------------------------
@@ -298,6 +300,42 @@ ruleTester.run("no-var", rule, {
             output: "let foo = 1",
             parserOptions: { sourceType: "module" },
             errors: ["Unexpected var, use let or const instead."]
+        },
+
+        // https://github.com/eslint/eslint/issues/11594
+        {
+            code: "declare var foo = 2;",
+            parser: require.resolve("../../fixtures/parsers/typescript-parsers/declare-var"),
+            parserOptions: { sourceType: "module" },
+            errors: ["Unexpected var, use let or const instead."]
         }
     ]
 });
+
+describe("no-var", () => {
+    describe("autofixing ambient declarations", () => {
+        const parserPath = require.resolve("../../fixtures/parsers/typescript-parsers/declare-var");
+
+        it("should not replace the declare keyword when fixing an ambient var declaration", () => {
+            const linter = new Linter();
+
+            linter.defineRule("no-var", rule);
+            linter.defineParser(parserPath, require(parserPath));
+
+            const result = linter.verifyAndFix("declare var foo = 2;", {
+                parser: parserPath,
+                parserOptions: { sourceType: "module" },
+                rules: { "no-var": 2 }
+            });
+
+            assert.ok(
+                result.output.includes("declare"),
+                `The autofix must not remove the declare keyword, but produced: ${result.output}`
+            );
+            assert.ok(
+                !result.output.includes("let var"),
+                `The autofix must not produce incorrect code, but produced: ${result.output}`
+            );
+        });
+    });
+});
