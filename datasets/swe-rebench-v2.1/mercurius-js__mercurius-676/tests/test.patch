diff --git a/test/options.js b/test/options.js
new file mode 100644
index 0000000..14e6658
--- /dev/null
+++ b/test/options.js
@@ -0,0 +1,83 @@
+'use strict'
+
+const proxyquire = require('proxyquire')
+const { test } = require('tap')
+const Fastify = require('fastify')
+
+const schema = `
+type User {
+  name: String!
+  password: String!
+}
+
+type Query {
+  read: [User]
+}
+`
+
+const resolvers = {
+  Query: {
+    read: async (_, obj) => {
+      return [
+        {
+          name: 'foo',
+          password: 'bar'
+        }
+      ]
+    }
+  }
+}
+
+test('compilerOptions are passed to the JIT compiler when queries are compiled', async t => {
+  const app = Fastify()
+  t.teardown(() => app.close())
+
+  const compileCalls = []
+  const jitQuery = async () => ({
+    data: {
+      read: [{ name: 'foo', password: 'bar' }]
+    }
+  })
+
+  const GQL = proxyquire('../index', {
+    'graphql-jit': {
+      compileQuery: (...args) => {
+        compileCalls.push(args)
+        return { query: jitQuery }
+      }
+    }
+  })
+
+  await app.register(GQL, {
+    schema,
+    resolvers,
+    jit: 1,
+    compilerOptions: {
+      customJSONSerializer: true
+    }
+  })
+
+  const query = `{
+    read {
+      name
+      password
+    }
+  }`
+
+  // warm up the jit counter
+  for (let i = 0; i < 2; i++) {
+    const res = await app.inject({
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      url: '/graphql',
+      body: JSON.stringify({ query })
+    })
+    t.equal(res.statusCode, 200)
+  }
+
+  t.ok(compileCalls.length > 0, 'the query is JIT compiled')
+  t.ok(
+    compileCalls.every(args => args[3] && args[3].customJSONSerializer === true),
+    'the compiler receives the configured compilerOptions'
+  )
+})
