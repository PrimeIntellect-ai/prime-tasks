+
+func assertUseEndpointHasNoNameCollision(t *testing.T, code string) {
+	t.Helper()
+	file, err := parser.ParseFile(token.NewFileSet(), "endpoint.go", "package generated\n"+code, 0)
+	if err != nil {
+		t.Fatalf("generated endpoint code is not valid Go: %v", err)
+	}
+	fields := make(map[string]bool)
+	hasUse := false
+	for _, decl := range file.Decls {
+		switch decl := decl.(type) {
+		case *ast.GenDecl:
+			for _, spec := range decl.Specs {
+				typeSpec, ok := spec.(*ast.TypeSpec)
+				if !ok || typeSpec.Name.Name != "Endpoints" {
+					continue
+				}
+				endpoints, ok := typeSpec.Type.(*ast.StructType)
+				if !ok {
+					t.Fatalf("Endpoints is not a struct")
+				}
+				for _, field := range endpoints.Fields.List {
+					for _, name := range field.Names {
+						fields[name.Name] = true
+					}
+				}
+			}
+		case *ast.FuncDecl:
+			if decl.Name.Name == "Use" && receiverIsEndpoints(decl.Recv) {
+				hasUse = true
+			}
+		}
+	}
+	if !hasUse {
+		t.Fatal("generated Endpoints does not provide the Use middleware method")
+	}
+	if fields["Use"] {
+		t.Fatal("generated Endpoints has both a Use field and a Use method")
+	}
+	if len(fields) == 0 {
+		t.Fatal("generated Endpoints has no endpoint fields")
+	}
+}
+
+func receiverIsEndpoints(receiver *ast.FieldList) bool {
+	if receiver == nil || len(receiver.List) == 0 {
+		return false
+	}
+	typeExpr := receiver.List[0].Type
+	if pointer, ok := typeExpr.(*ast.StarExpr); ok {
+		typeExpr = pointer.X
+	}
+	ident, ok := typeExpr.(*ast.Ident)
+	return ok && ident.Name == "Endpoints"
+}
