index 642d5cf..2027543 100644
--- a/tests/test_annotations.py
+++ b/tests/test_annotations.py
@@ -225,3 +225,19 @@ class TestAnnotations:
             'foo': 'typing.Any',
             'return': None,
         }
+
+    @pytest.mark.parametrize("slots", [True, False])
+    def test_annotations_strings_unqualified_classvar(self, slots):
+        """
+        The unqualified ``ClassVar`` string annotation is recognized as a
+        class variable and excluded from the generated ``__init__``.
+        """
+        @attr.s(auto_attribs=True, slots=slots)
+        class C:
+            cls_var: 'ClassVar[int]'
+            a: 'int'
+
+        assert C.__init__.__annotations__ == {
+            'a': 'int',
+            'return': None,
+        }
