+func TestInitActionConfigStorageScopeAndDriver(t *testing.T) {
+	tests := []struct {
+		name          string
+		args          []string
+		allNamespaces bool
+		driver        string
+		// wantPrefix is the API path prefix that a release lookup must hit;
+		// empty means the lookup must not touch the Kubernetes API at all.
+		wantPrefix string
+	}{
+		{
+			name:       "secret driver scoped to namespace",
+			args:       []string{"--namespace=team-a"},
+			driver:     "secret",
+			wantPrefix: "GET /api/v1/namespaces/team-a/secrets",
+		},
+		{
+			name:       "configmap driver scoped to namespace",
+			args:       []string{"--namespace=team-a"},
+			driver:     "configmap",
+			wantPrefix: "GET /api/v1/namespaces/team-a/configmaps",
+		},
+		{
+			name:          "all namespaces does not scope to the namespace",
+			args:          []string{"--namespace=team-a"},
+			allNamespaces: true,
+			driver:        "secret",
+			wantPrefix:    "GET /api/v1/secrets",
+		},
+		{
+			name:   "memory driver makes no API requests",
+			args:   []string{"--namespace=team-a"},
+			driver: "memory",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			defer resetEnv()()
+			os.Unsetenv("HELM_NAMESPACE")
+
+			srv, rec := newRecordingAPI(t)
+			dir := t.TempDir()
+			kubeconfig := filepath.Join(dir, "config")
+			content := `apiVersion: v1
+kind: Config
+clusters:
+- cluster:
+    server: ` + srv.URL + `
+  name: test-cluster
+contexts:
+- context:
+    cluster: test-cluster
+    user: test-user
+  name: test-context
+current-context: test-context
+users:
+- name: test-user
+  user:
+    token: abc123
+`
+			if err := os.WriteFile(kubeconfig, []byte(content), 0600); err != nil {
+				t.Fatal(err)
+			}
+
+			flags := pflag.NewFlagSet("testing", pflag.ContinueOnError)
+			settings := cli.New()
+			settings.AddFlags(flags)
+			args := append([]string{"--kubeconfig=" + kubeconfig}, tt.args...)
+			if err := flags.Parse(args); err != nil {
+				t.Fatal(err)
+			}
+
+			noop := func(string, ...interface{}) {}
+			config, err := action.InitActionConfig(settings, tt.allNamespaces, tt.driver, noop)
+			if err != nil {
+				t.Fatalf("initializing action configuration: %v", err)
+			}
+
+			// The fake API answers 404, so the listing itself reports
+			// "failure"; only the request it issues is of interest here.
+			_, _ = config.Releases.ListReleases()
+
+			requests := rec.all()
+			if tt.wantPrefix == "" {
+				if len(requests) != 0 {
+					t.Fatalf("expected no Kubernetes API requests, got %v", requests)
+				}
+				return
+			}
+			found := false
+			for _, req := range requests {
+				if strings.HasPrefix(req, tt.wantPrefix) {
+					found = true
+				}
+			}
+			if !found {
+				t.Errorf("expected a request with prefix %q, got requests %v", tt.wantPrefix, requests)
+			}
+		})
+	}
+}
