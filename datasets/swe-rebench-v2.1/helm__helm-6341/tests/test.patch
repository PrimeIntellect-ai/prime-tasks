+func TestEnvSettingsNamespaceFromKubeConfig(t *testing.T) {
+	defer resetEnv()()
+	os.Unsetenv("HELM_NAMESPACE")
+
+	dir := t.TempDir()
+	kubeconfig := filepath.Join(dir, "config")
+	content := `apiVersion: v1
+kind: Config
+clusters:
+- cluster:
+    server: https://example.invalid
+  name: test-cluster
+contexts:
+- context:
+    cluster: test-cluster
+    namespace: kubeconfig-ns
+    user: test-user
+  name: test-context
+current-context: test-context
+users:
+- name: test-user
+  user:
+    token: abc123
+`
+	if err := os.WriteFile(kubeconfig, []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+	os.Setenv("KUBECONFIG", kubeconfig)
+
+	flags := pflag.NewFlagSet("testing", pflag.ContinueOnError)
+	settings := cli.New()
+	settings.AddFlags(flags)
+	if err := flags.Parse([]string{"--kubeconfig=" + kubeconfig}); err != nil {
+		t.Fatal(err)
+	}
+
+	if got := settings.Namespace(); got != "kubeconfig-ns" {
+		t.Errorf("expected namespace %q from kubeconfig, got %q", "kubeconfig-ns", got)
+	}
+}
