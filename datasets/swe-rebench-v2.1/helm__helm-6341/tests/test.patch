+func TestInitActionConfig(t *testing.T) {
+	defer resetEnv()()
+
+	dir := t.TempDir()
+	kubeconfig := filepath.Join(dir, "config")
+	content := `apiVersion: v1
+kind: Config
+clusters:
+- cluster:
+    server: https://example.invalid
+  name: test-cluster
+contexts:
+- context:
+    cluster: test-cluster
+    user: test-user
+  name: test-context
+current-context: test-context
+users:
+- name: test-user
+  user:
+    token: abc123
+`
+	if err := os.WriteFile(kubeconfig, []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	flags := pflag.NewFlagSet("testing", pflag.ContinueOnError)
+	settings := cli.New()
+	settings.AddFlags(flags)
+	if err := flags.Parse([]string{"--kubeconfig=" + kubeconfig}); err != nil {
+		t.Fatal(err)
+	}
+
+	logged := false
+	logger := func(string, ...interface{}) { logged = true }
+	config, err := action.InitActionConfig(settings, false, "memory", logger)
+	if err != nil {
+		t.Fatalf("initializing action configuration: %v", err)
+	}
+	if config == nil || config.RESTClientGetter == nil || config.KubeClient == nil || config.Releases == nil || config.Log == nil {
+		t.Fatal("expected initialized action configuration")
+	}
+	config.Log("logger forwarding check")
+	if !logged {
+		t.Fatal("expected action configuration to preserve the supplied logger")
+	}
+}
