+
+#[test]
+fn detect_os_variant() {
+    #![allow(unused_parens)] // needed for `as_ref` call
+
+    #[derive(clap::Parser, PartialEq, Debug)]
+    pub struct Options {
+        #[clap(default_value_os = ("123".as_ref()))]
+        x: String,
+    }
+
+    // `default_value_os` must behave like `default_value = "123"`: when no
+    // value is supplied the OS default is used, and an explicit value wins.
+    assert_eq!(
+        Options {
+            x: "123".to_owned()
+        },
+        Options::try_parse_from(&["test"]).unwrap()
+    );
+    assert_eq!(
+        Options {
+            x: "1".to_owned()
+        },
+        Options::try_parse_from(&["test", "1"]).unwrap()
+    );
+
+    // Building the app and running its internal sanity checks must not panic.
+    Options::into_app().debug_assert();
+}
