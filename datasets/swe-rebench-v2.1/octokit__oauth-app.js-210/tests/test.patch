 import { OAuthApp } from "../src";
 import { OAuthAppOctokit } from "../src/oauth-app-octokit";
 
+describe("OAuthApp.defaultst", () => {
+  test("sets default options", () => {
+    const MyOAuthApp = OAuthApp.defaults({
+      allowSignup: false,
+    });
+
+    const app = new MyOAuthApp({
+      clientId: "1234567890abcdef1234",
+      clientSecret: "1234567890abcdef1234567890abcdef12345678",
+    });
+
+    const result = app.getWebFlowAuthorizationUrl({ state: "test" });
+    expect(result).toMatchInlineSnapshot(`
+      Object {
+        "allowSignup": false,
+        "clientId": "1234567890abcdef1234",
+        "clientType": "oauth-app",
+        "login": null,
+        "redirectUrl": null,
+        "scopes": Array [],
+        "state": "test",
+        "url": "https://github.com/login/oauth/authorize?allow_signup=false&client_id=1234567890abcdef1234&state=test",
+      }
+    `);
+  });
+
+  test("returns a subclass of OAuthApp", () => {
+    const MyOAuthApp = OAuthApp.defaults({
+      allowSignup: false,
+    });
+
+    const app = new MyOAuthApp({
+      clientId: "1234567890abcdef1234",
+      clientSecret: "1234567890abcdef1234567890abcdef12345678",
+    });
+
+    expect(app).toBeInstanceOf(OAuthApp);
+    expect(MyOAuthApp.prototype).toBeInstanceOf(OAuthApp);
+  });
+
+  test("explicit options take precedence over defaults", () => {
+    const MyOAuthApp = OAuthApp.defaults({
+      clientId: "default-client-id",
+    });
+
+    const app = new MyOAuthApp({
+      clientId: "explicit-client-id",
+      clientSecret: "1234567890abcdef1234567890abcdef12345678",
+    });
+
+    const result = app.getWebFlowAuthorizationUrl({ state: "test" });
+    expect(result.clientId).toBe("explicit-client-id");
+  });
+
+  test("applies a custom Octokit default", () => {
+    const MyOctokit = Octokit.defaults({});
+
+    const MyOAuthApp = OAuthApp.defaults({
+      Octokit: MyOctokit,
+    });
+
+    const app = new MyOAuthApp({
+      clientId: "1234567890abcdef1234",
+      clientSecret: "1234567890abcdef1234567890abcdef12345678",
+    });
+
+    expect(app.octokit).toBeInstanceOf(MyOctokit);
+  });
+});
