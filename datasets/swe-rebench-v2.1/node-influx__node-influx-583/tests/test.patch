+    it("sends placeholders as JSON in the params query parameter", async () => {
+      let receivedParams: string | null = null;
+      const server = http.createServer((request, response) => {
+        const requestUrl = new URL(request.url || "/", "http://localhost");
+        receivedParams = requestUrl.searchParams.get("params");
+        response.setHeader("Content-Type", "application/json");
+        response.end(JSON.stringify({ results: [{}] }));
+      });
+
+      await new Promise<void>((resolve) => {
+        server.listen(0, "127.0.0.1", resolve);
+      });
+      const address = server.address();
+      if (!address || typeof address === "string") {
+        throw new Error("Could not determine the local server port");
+      }
+
+      try {
+        const client = new InfluxDB({
+          host: "127.0.0.1",
+          port: address.port,
+          database: "my_db",
+        });
+        await client.query("select * from series_0 WHERE time > now() - $<since>", {
+          placeholders: { since: "10s" },
+        });
+        expect(receivedParams).to.be.a("string");
+        expect(JSON.parse(receivedParams as string)).to.deep.equal({ since: "10s" });
+      } finally {
+        await new Promise<void>((resolve, reject) => {
+          server.close((error) => error ? reject(error) : resolve());
+        });
+      }
+    });
+
