+def test_custom_headers_default_to_empty_mapping():
+    assert_equals({}, conf.custom_headers())
+
+
+def test_custom_headers():
+    custom_headers = {"header1": "value1"}
+    overrides = {"custom_headers": custom_headers}
+    conf.override_all(overrides)
+    endpoint = Endpoint("http://url.com", constants.NO_AUTH)
+    client = LivyReliableHttpClient.from_endpoint(endpoint)
+    headers = client.get_headers()
+    assert_equals(headers["Content-Type"], "application/json")
+    assert_equals(headers["header1"], "value1")
+
+
+def test_custom_headers_are_sent_with_requests():
+    custom_headers = {"header1": "value1"}
+    overrides = {"custom_headers": custom_headers}
+    conf.override_all(overrides)
+    endpoint = Endpoint("http://url.com", constants.NO_AUTH)
+    client = LivyReliableHttpClient.from_endpoint(endpoint)
+    response = MagicMock()
+    response.status_code = 200
+    response.text = ""
+    with patch('requests.Session.send', return_value=response) as send:
+        client.get_sessions()
+        response.status_code = 201
+        client.post_session({})
+        response.status_code = 200
+        client.delete_session(1)
+
+        sent_requests = []
+        for call in send.call_args_list:
+            args, kwargs = call
+            sent_requests.append(args[0] if args else kwargs["request"])
+
+        assert_equals(["GET", "POST", "DELETE"],
+                      [request.method for request in sent_requests])
+        for sent_request in sent_requests:
+            assert_equals(sent_request.headers["header1"], "value1")
+            assert_equals(sent_request.headers["Content-Type"], "application/json")
+
+
+def test_reliable_http_client_returns_supplied_headers():
+    supplied_headers = {"X-Request-Token": "token-value", "Accept": "application/json"}
+    endpoint = Endpoint("http://url.com", constants.NO_AUTH)
+    client = ReliableHttpClient(endpoint, supplied_headers, LinearRetryPolicy(0, 0))
+
+    assert_equals(supplied_headers, client.get_headers())
