+class TestAPIObjectWrappers:
+    """Tests that the platform-agnostic wrappers preserve the underlying
+    platform-specific implementation objects.
+    """
+
+    def test_team_preserves_implementation(self):
+        implementation = MagicMock()
+        team = apimeta.Team(
+            members=["some-student"],
+            name="some-team",
+            id=1,
+            implementation=implementation,
+        )
+        assert team.implementation is implementation
+
+    def test_repo_preserves_implementation(self):
+        implementation = MagicMock()
+        repo = apimeta.Repo(
+            name="some-repo",
+            description="Some description",
+            private=True,
+            implementation=implementation,
+        )
+        assert repo.implementation is implementation
+
+    def test_wrappers_have_specified_namedtuple_fields_and_positional_order(self):
+        implementation = object()
+        wrappers = (
+            (
+                apimeta.Issue("title", "body", 3, "created", "author", implementation),
+                ("title", "body", 3, "created", "author", implementation),
+                ("title", "body", "number", "created_at", "author", "implementation"),
+            ),
+            (
+                apimeta.Team(["member"], "team", 4, implementation),
+                ("team", ["member"], 4, implementation),
+                ("name", "members", "id", "implementation"),
+            ),
+            (
+                apimeta.Repo("repo", "description", True, 5, "url", implementation),
+                ("repo", "description", True, 5, "url", implementation),
+                ("name", "description", "private", "team_id", "url", "implementation"),
+            ),
+        )
+        for wrapper, values, fields in wrappers:
+            assert isinstance(wrapper, tuple)
+            assert type(wrapper)._fields == fields
+            assert tuple(wrapper) == values
+
+    def test_wrapper_optional_values_default_to_none(self):
+        issue = apimeta.Issue("title", "body")
+        team = apimeta.Team(["member"])
+        repo = apimeta.Repo("repo", "description", False)
+
+        for wrapper in (issue, team, repo):
+            assert wrapper.implementation is None
+        assert (issue.number, issue.created_at, issue.author) == (None, None, None)
+        assert (team.id, repo.team_id, repo.url) == (None, None, None)
+
+    def test_wrappers_retain_falsey_implementations_and_are_immutable(self):
+        implementation = []
+        wrappers = (
+            (apimeta.Issue("title", "body", implementation=implementation), "title"),
+            (apimeta.Team(["member"], implementation=implementation), "members"),
+            (apimeta.Repo("repo", "description", False, implementation=implementation), "name"),
+        )
+        for wrapper, field in wrappers:
+            assert wrapper.implementation is implementation
+            with pytest.raises(AttributeError):
+                setattr(wrapper, field, "changed")
