+func TestIssue218FlowGroupMultilineStaysSingleDocument(t *testing.T) {
+	content := `
+- key1: val
+  key2:
+    (
+      foo
+      +
+      bar
+    )
+`
+	f, err := parser.ParseBytes([]byte(content), parser.ParseComments)
+	if err != nil {
+		t.Fatalf("parse reported input: %v", err)
+	}
+	if got := len(f.Docs); got != 1 {
+		t.Fatalf("expected the multiline value to remain in one YAML document, got %d", got)
 	}
