+"""Test various helper functions."""
+import mne
+import numpy as np
+
+from pyprep.find_noisy_channels import NoisyChannels
+from pyprep.utils import _mat_quantile, _mat_iqr
+
+
+def test_mat_quantile_iqr():
+    """Test MATLAB-compatible quantile and IQR functions.
+
+    MATLAB code used to generate the comparison results:
+
+    .. code-block:: matlab
+
+       % Generate test data
+       rng(435656);
+       tst = rand(100, 3);
+
+       % Calculate IQR and 0.98 quantile for test data
+       quantile(tst, 0.98);
+       iqr(tst);
+
+    """
+    # Generate test data
+    np.random.seed(435656)
+    tst = np.transpose(np.random.rand(3, 100))
+
+    # Create arrays containing MATLAB results
+    quantile_expected = np.asarray([0.9710, 0.9876, 0.9802])
+    iqr_expected = np.asarray([0.4776, 0.5144, 0.4851])
+
+    # Test quantile equivalence with MATLAB
+    quantile_actual = _mat_quantile(tst, 0.98, axis=0)
+    assert all(np.isclose(quantile_expected, quantile_actual, atol=0.001))
+
+    # Test IQR equivalence with MATLAB
+    iqr_actual = _mat_iqr(tst, axis=0)
+    assert all(np.isclose(iqr_expected, iqr_actual, atol=0.001))
+
+
+def test_mat_quantile_endpoints():
+    """The quantile at 0 is the minimum and at 1 is the maximum."""
+    np.random.seed(435656)
+    tst = np.transpose(np.random.rand(3, 100))
+
+    assert np.allclose(_mat_quantile(tst, 0.0, axis=0), tst.min(axis=0))
+    assert np.allclose(_mat_quantile(tst, 1.0, axis=0), tst.max(axis=0))
+
+
+def test_mat_quantile_iqr_axis_none():
+    """With axis=None the statistic is computed over the flattened array."""
+    np.random.seed(435656)
+    tst = np.transpose(np.random.rand(3, 100))
+
+    quantile_none = _mat_quantile(tst, 0.98, axis=None)
+    assert np.ndim(quantile_none) == 0
+    assert tst.min() <= quantile_none <= tst.max()
+    # Reducing over every axis is equivalent to flattening the array
+    assert np.isclose(quantile_none, _mat_quantile(tst, 0.98, axis=(0, 1)))
+
+    iqr_none = _mat_iqr(tst, axis=None)
+    assert np.ndim(iqr_none) == 0
+    assert np.isclose(iqr_none, _mat_iqr(tst, axis=(0, 1)))
+
+
+def test_mat_quantile_iqr_tuple_axis():
+    """A tuple of axes reduces over all of the specified axes."""
+    np.random.seed(1)
+    tst = np.random.rand(5, 4, 3)
+
+    quantile_actual = _mat_quantile(tst, 0.98, axis=(0, 1))
+    assert quantile_actual.shape == (3,)
+    for i in range(3):
+        expected = _mat_quantile(tst[:, :, i], 0.98, axis=None)
+        assert np.isclose(quantile_actual[i], expected)
+
+    iqr_actual = _mat_iqr(tst, axis=(0, 1))
+    assert iqr_actual.shape == (3,)
+    for i in range(3):
+        expected = _mat_iqr(tst[:, :, i], axis=None)
+        assert np.isclose(iqr_actual[i], expected)
+
+
+def test_bad_channel_deviation_uses_matlab_iqr():
+    """Deviation classification uses MATLAB-compatible IQR statistics."""
+    deviation_rng = np.random.RandomState(42)
+    # Use the fifth seeded sample, whose classification distinguishes the methods.
+    for _ in range(5):
+        deviation_data = deviation_rng.lognormal(0, 1, (5, 5)) * deviation_rng.choice(
+            [1, 2, 4, 8], 5
+        )[:, None]
+    deviation_raw = mne.io.RawArray(
+        deviation_data,
+        mne.create_info([f"C{i}" for i in range(5)], 10.0, ch_types="eeg"),
+        verbose="ERROR",
+    )
+    deviation_detector = NoisyChannels(
+        deviation_raw, do_detrend=False, random_state=0
+    )
+    deviation_detector.find_bad_by_deviation(deviation_threshold=0.2758205315638727)
+    assert "C2" in deviation_detector.bad_by_deviation
+
+
+def test_bad_channel_correlation_uses_matlab_quantile(monkeypatch):
+    """Correlation classification uses MATLAB-compatible quantiles."""
+    correlation_rng = np.random.RandomState(12)
+    correlation_data = correlation_rng.randn(4, 20)
+    correlation_raw = mne.io.RawArray(
+        correlation_data,
+        mne.create_info([f"C{i}" for i in range(4)], 10.0, ch_types="eeg"),
+        verbose="ERROR",
+    )
+    correlation_detector = NoisyChannels(
+        correlation_raw, do_detrend=False, random_state=0
+    )
+    # Older code in the correlation routine uses the removed NumPy alias; provide
+    # it here so this test can reach and check the requested classification.
+    monkeypatch.setattr(np, "int", int, raising=False)
+    correlation_detector.find_bad_by_correlation(
+        correlation_secs=1.0, correlation_threshold=0.4105, frac_bad=0.0
+    )
+    assert "C2" not in correlation_detector.bad_by_correlation
