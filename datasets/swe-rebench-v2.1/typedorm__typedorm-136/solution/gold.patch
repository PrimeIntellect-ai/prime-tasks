+++ b/packages/core/__mocks__/user-default-value.ts
@@ -0,0 +1,27 @@
+import {Attribute, Entity, INDEX_TYPE} from '@typedorm/common';
+import {table} from './table';
+
+@Entity({
+  table,
+  name: 'user-with-default-values',
+  primaryKey: {
+    partitionKey: 'USER#{{id}}',
+    sortKey: 'USER#{{id}}',
+  },
+  indexes: {
+    GSI1: {
+      partitionKey: 'USER#STATUS#{{status}}',
+      sortKey: 'USER#{{status}}',
+      type: INDEX_TYPE.GSI,
+    },
+  },
+})
+export class UserWithDefaultValues {
+  @Attribute()
+  id: string;
+
+  @Attribute({
+    default: 'active',
+  })
+  status: string;
+}
