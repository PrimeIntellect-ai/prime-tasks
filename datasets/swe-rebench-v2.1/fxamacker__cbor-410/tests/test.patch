+
+func TestDiagnoseEmptyInputReturnsEOFInAllModes(t *testing.T) {
+	var emptyData []byte
+
+	defaultMode, _ := DiagOptions{}.DiagMode()
+	sequenceMode, _ := DiagOptions{CBORSequence: true}.DiagMode()
+
+	for _, dm := range []DiagMode{defaultMode, sequenceMode} {
+		if _, err := dm.Diagnose(emptyData); err != io.EOF {
+			t.Errorf("Diagnose() error for empty data = %v, want io.EOF", err)
+		}
+	}
+}
