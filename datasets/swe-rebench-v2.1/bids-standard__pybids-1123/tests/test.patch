+def test_ignore_dotfiles(temporary_dataset):
+    # macOS Finder metadata files: `._*` companion files and `.DS_Store`.
+    # These can appear at any level of the dataset tree, so exercise both the
+    # dataset root and a nested subject/datatype directory.
+    ds_store = temporary_dataset / 'sub-01' / '.DS_Store'
+    osx_companion_file = temporary_dataset / '._task-mixedgamblestask_bold.json'
+    nested_osx_companion_file = (
+        temporary_dataset / 'sub-01' / 'func'
+        / '._sub-01_task-mixedgamblestask_run-01_bold.json'
+    )
+
+    ds_store.touch()
+    osx_companion_file.touch()
+    nested_osx_companion_file.touch()
+
+    # Default behavior: macOS metadata files are not indexed, while regular
+    # dataset files still are.
+    layout = BIDSLayout(temporary_dataset, validate=False)
+    assert str(temporary_dataset / 'dataset_description.json') in layout.files
+    assert str(ds_store) not in layout.files
+    assert str(osx_companion_file) not in layout.files
+    assert str(nested_osx_companion_file) not in layout.files
+
+    # Explicit ignores do not disable filtering of macOS metadata files.
+    indexer = BIDSLayoutIndexer(ignore=['some_ignore'])
+    layout = BIDSLayout(temporary_dataset, validate=False, indexer=indexer)
+    assert str(temporary_dataset / 'dataset_description.json') in layout.files
+    assert str(ds_store) not in layout.files
+    assert str(osx_companion_file) not in layout.files
+    assert str(nested_osx_companion_file) not in layout.files
