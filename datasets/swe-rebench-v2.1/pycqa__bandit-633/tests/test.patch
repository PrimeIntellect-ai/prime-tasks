+    def check_example_with_config(self, config_contents, example_script,
+                                  expect):
+        '''Run an example with a bandit config file loaded from disk.
+
+        :param config_contents: YAML contents of the config file
+        :param example_script: Filename of an example script to test
+        :param expect: dict with expected counts of issue types
+        '''
+        with tempfile.NamedTemporaryFile(mode='wt', suffix='.bandit',
+                                         delete=False) as f:
+            f.write(config_contents)
+            config_file = f.name
+        try:
+            b_conf = b_config.BanditConfig(config_file)
+            path = os.path.join(os.getcwd(), 'bandit', 'plugins')
+            b_mgr = b_manager.BanditManager(b_conf, 'file')
+            b_mgr.b_conf._settings['plugins_dir'] = path
+            b_mgr.b_ts = b_test_set.BanditTestSet(config=b_conf)
+            self.b_mgr = b_mgr
+            self.check_example(example_script, expect)
+        finally:
+            os.unlink(config_file)
+
