+describe('useSWR - online event', () => {
+  it('should register and remove the online listener through the window target', async () => {
+    let value = 0
+
+    function Page() {
+      const { data } = useSWR('dynamic-online', () => value++, {
+        dedupingInterval: 0
+      })
+      return <div>data: {data}</div>
+    }
+
+    const originalAdd = window.addEventListener
+    const originalRemove = window.removeEventListener
+    const calls: Array<{ method: string; type: string; receiver: unknown }> = []
+    window.addEventListener = function (
+      this: unknown,
+      type: string,
+      listener: any,
+      options?: any
+    ) {
+      calls.push({ method: 'add', type, receiver: this })
+      return originalAdd.call(window, type, listener, options)
+    } as any
+    window.removeEventListener = function (
+      this: unknown,
+      type: string,
+      listener: any,
+      options?: any
+    ) {
+      calls.push({ method: 'remove', type, receiver: this })
+      return originalRemove.call(window, type, listener, options)
+    } as any
+
+    try {
+      const { container, unmount } = render(<Page />)
+
+      await waitForDomChange({ container }) // mount
+      expect(container.firstChild.textContent).toBe('data: 0')
+
+      await act(() => {
+        window.dispatchEvent(new Event('online'))
+        return new Promise(res => setTimeout(res, 1))
+      })
+      expect(container.firstChild.textContent).toBe('data: 1')
+
+      unmount()
+
+      const online = calls.filter(c => c.type === 'online')
+      expect(online.map(c => c.method)).toEqual(
+        expect.arrayContaining(['add', 'remove'])
+      )
+      // every listener method must be invoked with the window as its receiver
+      expect(online.every(c => c.receiver === window)).toBe(true)
+    } finally {
+      window.addEventListener = originalAdd
+      window.removeEventListener = originalRemove
+    }
+  })
+})
