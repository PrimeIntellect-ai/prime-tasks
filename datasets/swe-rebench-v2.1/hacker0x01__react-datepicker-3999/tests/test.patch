+import React from "react";
+import DatePicker from "../src";
+import { render, fireEvent } from "@testing-library/react";
+
+describe("Multiple Dates Selected", function () {
+  function getDatePicker(extraProps) {
+    return render(
+      <DatePicker
+        selectsMultiple
+        onChange={() => {}}
+        shouldCloseOnSelect={false}
+        disabledKeyboardNavigation
+        {...extraProps}
+      />,
+    );
+  }
+
+  it("should add a clicked date to the current selection", () => {
+    const onChange = jest.fn();
+    const datePicker = getDatePicker({
+      selectedDates: [new Date("2024/01/01")],
+      openToDate: new Date("2024/01/01"),
+      onChange,
+    });
+
+    fireEvent.click(datePicker.getByRole("textbox"));
+    fireEvent.click(
+      datePicker.container.querySelector(
+        ".react-datepicker__day--015:not(.react-datepicker__day--outside-month)",
+      ),
+    );
+
+    expect(onChange).toHaveBeenCalled();
+    const dates = onChange.mock.calls[0][0];
+    expect(Array.isArray(dates)).toBe(true);
+    expect(dates).toHaveLength(2);
+    expect(dates.some((date) => date.getDate() === 1)).toBe(true);
+    expect(dates.some((date) => date.getDate() === 15)).toBe(true);
+  });
+});
