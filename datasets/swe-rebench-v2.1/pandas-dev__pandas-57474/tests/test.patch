+    def test_transpose_groupby_max_nullable(self):
+        # GH#57315 - aggregating a transposed concatenated frame with nullable
+        # integer dtypes should not raise and should match the numpy dtype result
+        results = []
+        for dtype in [np.int8, "Int8"]:
+            df1 = DataFrame(
+                data={"col1": Series([1, 2, 3], index=["A", "B", "C"], dtype=dtype)},
+                index=Index(["A", "B", "C"], dtype="string"),
+            )
+            df2 = DataFrame(
+                data={"col2": Series([4, 5, 6], index=["D", "E", "F"], dtype=dtype)},
+                index=Index(["D", "E", "F"], dtype="string"),
+            )
+            df = pd.concat([df1, df2])
+            results.append(df.T.groupby(df.columns).max())
+
+        expected = np.array(
+            [[1, 2, 3, np.nan, np.nan, np.nan], [np.nan, np.nan, np.nan, 4, 5, 6]]
+        )
+        for result in results:
+            tm.assert_index_equal(result.index, Index(["col1", "col2"]))
+            tm.assert_index_equal(
+                result.columns, Index(["A", "B", "C", "D", "E", "F"], dtype="string")
+            )
+            tm.assert_numpy_array_equal(
+                result.to_numpy(dtype="float64", na_value=np.nan), expected
+            )
