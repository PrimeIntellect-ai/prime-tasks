+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+import json
+from pathlib import Path
+
+from cfnlint.api import lint_all
+
+
+def _property_findings(matches):
+    """Select findings that report missing Handler or Runtime values."""
+    return [
+        match
+        for match in matches
+        if getattr(match, "path", None)
+        and match.path[0] == "Resources"
+        and any(
+            prop in match.message or prop in match.path
+            for prop in ("Handler", "Runtime")
+        )
+    ]
+
+
+def _missing_properties(matches):
+    """Return the missing required properties described by findings."""
+    missing = set()
+    for match in matches:
+        for prop in ("Handler", "Runtime"):
+            if prop in match.message or prop in match.path:
+                missing.add(prop)
+    return missing
+
+
+def _lint(template):
+    return _property_findings(lint_all(template))
+
+
+def _function(properties):
+    return {
+        "Resources": {
+            "Function": {
+                "Type": "AWS::Lambda::Function",
+                "Properties": {
+                    "Role": "arn:aws:iam::123456789012:role/lambda-role",
+                    **properties,
+                },
+            }
+        }
+    }
+
+
+def _template(properties):
+    return json.dumps(_function(properties))
+
+
+def test_file_positive():
+    filename = "test/fixtures/templates/good/resources/lambda/required_properties.yaml"
+    assert _lint(Path(filename).read_text()) == []
+
+
+def test_file_negative():
+    filename = "test/fixtures/templates/bad/resources/lambda/required_properties.yaml"
+    matches = _lint(Path(filename).read_text())
+
+    expected = {
+        "Function1": {"Handler", "Runtime"},
+        "Function2": {"Handler"},
+        "Function3": {"Runtime"},
+    }
+    reported = {}
+    for match in matches:
+        path = match.path
+        resource_name = path[1]
+        reported.setdefault(resource_name, set()).update(_missing_properties([match]))
+
+    assert set(expected) == set(reported)
+    assert reported == expected
+    assert all(
+        match.rule.severity in ("warning", "informational") for match in matches
+    )
+
+
+def test_zip_package_detection():
+    # PackageType Zip, Code.ZipFile, and Code.S3Key identify zip deployments.
+    for props in (
+        {"PackageType": "Zip"},
+        {"Code": {"ZipFile": "exports.handler = 1"}},
+        {"Code": {"S3Bucket": "my-bucket", "S3Key": "k"}},
+    ):
+        matches = _lint(_template(props))
+        assert _missing_properties(matches) == {"Handler", "Runtime"}
+        assert all(
+            match.rule.severity in ("warning", "informational") for match in matches
+        )
+
+    # Image deployments are outside the zip-package scope.
+    matches = _lint(
+        _template(
+            {
+                "Code": {
+                    "ImageUri": "111122223333.dkr.ecr.us-east-1.amazonaws.com/x:latest"
+                },
+                "PackageType": "Image",
+            }
+        )
+    )
+    assert matches == []
+
+    # A zip deployment with both required properties is valid for this rule.
+    matches = _lint(
+        _template(
+            {
+                "Handler": "index.handler",
+                "Runtime": "python3.9",
+                "Code": {"S3Bucket": "my-bucket", "S3Key": "k"},
+            }
+        )
+    )
+    assert matches == []
+
+
+def test_conditional_properties():
+    template = """
+AWSTemplateFormatVersion: '2010-09-09'
+Conditions:
+  UseHandler: !Equals [!Ref AWS::Region, us-east-1]
+Resources:
+  Function:
+    Type: AWS::Lambda::Function
+    Properties:
+      Role: arn:aws:iam::123456789012:role/lambda-role
+      Runtime: python3.9
+      Handler: !If [UseHandler, index.handler, !Ref 'AWS::NoValue']
+      Code:
+        S3Bucket: my-bucket
+        S3Key: function.zip
+"""
+    matches = _lint(template)
+    assert _missing_properties(matches) == {"Handler"}
+    assert all(
+        match.path[:2] == ["Resources", "Function"] for match in matches
+    )
+    assert all(
+        match.rule.severity in ("warning", "informational") for match in matches
+    )
