+++ b/tests/parser/features/test_address_balance.py
@@ -0,0 +1,61 @@
+from vyper import compiler
+
+
+def test_constant_address_balance(w3, get_contract_with_gas_estimation):
+    code = """
+a: constant(address) = 0x776Ba14735FF84789320718cf0aa43e91F7A8Ce1
+
+@external
+def foo() -> uint256:
+    x: uint256 = a.balance
+    return x
+    """
+    address = "0x776Ba14735FF84789320718cf0aa43e91F7A8Ce1"
+
+    c = get_contract_with_gas_estimation(code)
+
+    assert c.foo() == 0
+
+    w3.eth.send_transaction({"to": address, "value": 1337})
+
+    assert c.foo() == 1337
+
+
+def test_literal_address_balance(w3):
+    code = """
+@external
+def foo() -> uint256:
+    x: uint256 = 0x776Ba14735FF84789320718cf0aa43e91F7A8Ce1.balance
+    return x
+    """
+    address = "0x776Ba14735FF84789320718cf0aa43e91F7A8Ce1"
+
+    out = compiler.compile_code(code, ["abi", "bytecode"])
+    factory = w3.eth.contract(abi=out["abi"], bytecode=out["bytecode"])
+    tx_hash = factory.constructor().transact({"from": w3.eth.accounts[0], "gasPrice": 0})
+    contract_address = w3.eth.get_transaction_receipt(tx_hash)["contractAddress"]
+    c = w3.eth.contract(contract_address, abi=out["abi"])
+
+    assert c.functions.foo().call() == 0
+
+    w3.eth.send_transaction({"to": address, "value": 1337})
+
+    assert c.functions.foo().call() == 1337
+
+
+def test_variable_address_balance(w3, get_contract_with_gas_estimation):
+    code = """
+@external
+def foo(a: address) -> uint256:
+    x: uint256 = a.balance
+    return x
+    """
+    address = "0x776Ba14735FF84789320718cf0aa43e91F7A8Ce1"
+
+    c = get_contract_with_gas_estimation(code)
+
+    assert c.foo(address) == 0
+
+    w3.eth.send_transaction({"to": address, "value": 1337})
+
+    assert c.foo(address) == 1337
