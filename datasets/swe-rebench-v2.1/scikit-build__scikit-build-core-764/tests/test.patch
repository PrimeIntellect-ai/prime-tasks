diff --git a/tests/test_logging.py b/tests/test_logging.py
index ae99850..768af03 100644
--- a/tests/test_logging.py
+++ b/tests/test_logging.py
@@ -20,3 +20,33 @@ def test_rich_print_forcecolor(capsys, monkeypatch):
     monkeypatch.delenv("NO_COLOR", raising=False)
     rich_print("[red bold]hello[/bold] world", end="")
     assert capsys.readouterr().out == "\33[91m\33[1mhello\33[22m world\33[0m"
+
+
+def test_rich_notrichbrackets(capsys, monkeypatch):
+    monkeypatch.setenv("FORCE_COLOR", "1")
+    monkeypatch.delenv("NO_COLOR", raising=False)
+    rich_print("[red bold]hello[/bold] world[/red] [notrich]", end="")
+    assert (
+        capsys.readouterr().out
+        == "\33[91m\33[1mhello\33[22m world\33[0m [notrich]\33[0m"
+    )
+
+
+def test_rich_unsupported_token_is_literal(capsys, monkeypatch):
+    monkeypatch.setenv("FORCE_COLOR", "1")
+    monkeypatch.delenv("NO_COLOR", raising=False)
+    rich_print(
+        "[bold]Scikit-build-core 0.9.5[/bold] on Python 3.11.9 [GCC]",
+        end="",
+    )
+    assert (
+        capsys.readouterr().out
+        == "\33[1mScikit-build-core 0.9.5\33[22m on Python 3.11.9 [GCC]\33[0m"
+    )
+
+
+def test_rich_unsupported_token_nocolor_is_literal(capsys, monkeypatch):
+    monkeypatch.setenv("NO_COLOR", "1")
+    monkeypatch.delenv("FORCE_COLOR", raising=False)
+    rich_print("Python 3.11.9 (main, Apr 08 2024) [GCC]", end="")
+    assert capsys.readouterr().out == "Python 3.11.9 (main, Apr 08 2024) [GCC]"
