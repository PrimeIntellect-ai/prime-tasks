+def _sub_rich(m: re.Match[str]) -> str:
+    """
+    Replace rich-like tags, but only if they are defined in colors.
+    """
+    color_dict = colors()
+    try:
+        return "".join(color_dict[x] for x in m.group(1).split())
+    except KeyError:
+        return m.group(0)
+
