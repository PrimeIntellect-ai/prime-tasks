+class TestS3UrlFormatting:
+    """Regression coverage for preserving S3 URLs during formatting."""
+
+    @pytest.mark.unit
+    def test_formatting_keeps_s3_url_intact(self):
+        source = (
+            "def get_object():\n"
+            "    \"\"\"Retrieve an object.\n\n"
+            "    See <s3://bucket-name/object-with-long-name>\n"
+            "    \"\"\"\n"
+        )
+        result = subprocess.run(
+            [
+                sys.executable,
+                "-m",
+                "docformatter",
+                "--wrap-descriptions",
+                "30",
+                "--force-wrap",
+                "-",
+            ],
+            input=source,
+            text=True,
+            capture_output=True,
+        )
+
+        assert "s3://bucket-name/object-with-long-name" in result.stdout
+
