+test('core and common do not declare each other as peer dependencies', () => {
+  const readPeerDependencies = (packageName: string): string[] => {
+    const packageJsonPath = path.resolve(
+      __dirname,
+      `../../../../../${packageName}/package.json`
+    );
+    const packageJson = JSON.parse(fs.readFileSync(packageJsonPath, 'utf8'));
+    return Object.keys(packageJson.peerDependencies || {});
+  };
+
+  const corePeers = readPeerDependencies('core');
+  const commonPeers = readPeerDependencies('common');
+
+  const reciprocal =
+    corePeers.includes('@typedorm/common') &&
+    commonPeers.includes('@typedorm/core');
+  expect(reciprocal).toBe(false);
+});
