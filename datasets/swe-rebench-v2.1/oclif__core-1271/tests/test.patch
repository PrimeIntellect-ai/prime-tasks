+  describe('atLeastOne', () => {
+    it('rejects input when none of the listed flags are supplied', async () => {
+      let rejected = false
+      try {
+        await parse([], {
+          flags: {
+            firstPage: Flags.string({atLeastOne: ['firstPage', 'lastPage']}),
+            lastPage: Flags.string({char: 'l'}),
+          },
+        })
+      } catch {
+        rejected = true
+      }
+
+      expect(rejected).to.be.true
+    })
+
+    it('accepts input when one listed flag is supplied', async () => {
+      const out = await parse(['--firstPage', '1'], {
+        flags: {
+          firstPage: Flags.string({atLeastOne: ['firstPage', 'lastPage']}),
+          lastPage: Flags.string({char: 'l'}),
+        },
+      })
+      expect(out.flags.firstPage).to.equal('1')
+    })
+
+    it('accepts input when multiple listed flags are supplied', async () => {
+      const out = await parse(['--firstPage', '1', '--lastPage', '3'], {
+        flags: {
+          firstPage: Flags.string({atLeastOne: ['firstPage', 'lastPage']}),
+          lastPage: Flags.string({char: 'l'}),
+        },
+      })
+      expect(out.flags.firstPage).to.equal('1')
+      expect(out.flags.lastPage).to.equal('3')
+    })
+  })
+
