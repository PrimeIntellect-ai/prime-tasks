new file mode 100644
index 0000000..08bce8e
--- /dev/null
+++ b/test/value.js
@@ -0,0 +1,36 @@
+'use strict';
+
+const S = require ('..');
+
+const eq = require ('./internal/eq');
+
+
+function isJustValue(maybe, value) {
+  return S.maybe (false) (x => x === value) (maybe);
+}
+
+
+test ('safe lookup', () => {
+
+  const hasSafeLookup = Object.getOwnPropertyNames (S).some (name => {
+    const operation = S[name];
+    if (typeof operation !== 'function') return false;
+    try {
+      const lookup = operation ('truthy');
+      if (typeof lookup !== 'function') return false;
+      const returnsItsValue = (key, value) =>
+        isJustValue (operation (key) ({[key]: value}), value);
+      return isJustValue (lookup ({truthy: 'value'}), 'value') &&
+             returnsItsValue ('falseValue', false) &&
+             returnsItsValue ('zero', 0) &&
+             returnsItsValue ('empty', '') &&
+             returnsItsValue ('undefined', undefined) &&
+             S.isNothing (operation ('missing') ({truthy: 'value'}));
+    } catch (_) {
+      return false;
+    }
+  });
+
+  eq (hasSafeLookup) (true);
+
+});
