+# An explicit alias that repeats the name of a plain column (optionally cast to INT) is redundant.
+_REDUNDANT_ALIAS = re.compile(
+    r"^(\s*)((\w+)(?:::INT)?) AS \3(?=,?\s*(?:/\*.*)?$)", re.MULTILINE
+)
+
+
+def _without_redundant_aliases(sql: str) -> str:
+    return _REDUNDANT_ALIAS.sub(r"\1\2", sql)
+
