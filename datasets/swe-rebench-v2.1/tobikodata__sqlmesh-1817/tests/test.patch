+def test_sql_server_model_format_does_not_add_translation_wrappers():
+    formatted = format_model_expressions(
+        parse(
+            """
+            MODEL (name example, kind VIEW);
+            SELECT CONCAT(CAST(value AS VARCHAR(MAX)), suffix) AS combined
+            FROM source;
+            """,
+        )
+    )
+
+    assert "CONCAT(" in formatted.upper()
+    assert "COALESCE(" not in formatted.upper()
+
+
+def test_model_format_separates_consecutive_ctes():
+    formatted = format_model_expressions(
+        parse(
+            """
+            MODEL (name example, kind VIEW);
+            WITH first_cte AS (SELECT a FROM source), second_cte AS (SELECT b FROM source)
+            SELECT * FROM second_cte;
+            """,
+        )
+    )
+
+    assert "), second_cte AS (" in " ".join(formatted.split())
+
