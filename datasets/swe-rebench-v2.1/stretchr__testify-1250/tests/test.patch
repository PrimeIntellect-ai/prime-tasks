+func Test_Mock_UnsetByOnMethodSpec(t *testing.T) {
+	// make a test impl object
+	var mockedService = new(TestExampleImplementation)
+
+	mock1 := mockedService.
+		On("TheExampleMethod", 1, 2, 3).
+		Return(0, nil)
+
+	assert.Equal(t, 1, len(mockedService.ExpectedCalls))
+	mock1.On("TheExampleMethod", 1, 2, 3).
+		Return(0, nil).Unset()
+
+	assert.Equal(t, 0, len(mockedService.ExpectedCalls))
+
+	assert.Panics(t, func() {
+		mock1.Unset()
+	})
+
+	assert.Equal(t, 0, len(mockedService.ExpectedCalls))
+}
+
+func Test_Mock_UnsetByOnMethodSpecAmongOthers(t *testing.T) {
+	// make a test impl object
+	var mockedService = new(TestExampleImplementation)
+
+	mock1 := mockedService.
+		On("TheExampleMethod", 1, 2, 3).
+		Return(0, nil).
+		On("TheExampleMethodVariadic", 1, 2, 3, 4, 5).Once().
+		Return(nil)
+	mock1.
+		On("TheExampleMethodFuncType", Anything).
+		Return(nil)
+
+	assert.Equal(t, 3, len(mockedService.ExpectedCalls))
+	mock1.On("TheExampleMethod", 1, 2, 3).
+		Return(0, nil).Unset()
+
+	assert.Equal(t, 2, len(mockedService.ExpectedCalls))
+
+	// the remaining expectations are the other ones, in their original order
+	assert.Equal(t, "TheExampleMethodVariadic", mockedService.ExpectedCalls[0].Method)
+	assert.Equal(t, Arguments{1, 2, 3, 4, 5}, mockedService.ExpectedCalls[0].Arguments)
+	assert.Equal(t, 1, mockedService.ExpectedCalls[0].Repeatability)
+	assert.Equal(t, "TheExampleMethodFuncType", mockedService.ExpectedCalls[1].Method)
+	assert.Equal(t, Arguments{Anything}, mockedService.ExpectedCalls[1].Arguments)
+}
+
+func Test_Mock_UnsetWithMatchedByArgument(t *testing.T) {
+	var mockedService = new(TestExampleImplementation)
+	positive := func(a int) bool { return a > 0 }
+
+	mockedService.On("TheExampleMethod", MatchedBy(positive), 2, 3).Return(0, nil)
+	mockedService.On("TheExampleMethod", MatchedBy(positive), 2, 3).Return(0, nil)
+	assert.Equal(t, 2, len(mockedService.ExpectedCalls))
+
+	assert.NotPanics(t, func() {
+		mockedService.On("TheExampleMethod", 1, 2, 3).Return(0, nil).Unset()
+	})
+
+	assert.Equal(t, 0, len(mockedService.ExpectedCalls))
+}
