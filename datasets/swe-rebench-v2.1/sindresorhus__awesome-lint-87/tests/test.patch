+// Stub the git invocations used to discover the repository's remote URL.
+// `git config --get remote.origin.url` returns the raw configured value
+// (which may be a shorthand such as `gh:owner/repo`), while `git remote`
+// resolves shorthands to a real URL. Supporting both keeps the tests
+// agnostic about which command an implementation chooses.
+const stubGitRemote = (execaStub, {configUrl, resolvedUrl}) => {
+	execaStub.callsFake((command, args) => {
+		if (args[0] === 'config') {
+			return configUrl;
+		}
+
+		if (args.includes('-v') || args.includes('--verbose')) {
+			return `origin\t${resolvedUrl} (fetch)\norigin\t${resolvedUrl} (push)`;
+		}
+
+		return resolvedUrl;
+	});
+};
+
