@@ -0,0 +1,22 @@
+package parser
+
+import (
+	"bytes"
+	"fmt"
+	"testing"
+)
+
+func TestLongCallChainPreservesParameterType(t *testing.T) {
+	const numCalls = 1200
+
+	var source bytes.Buffer
+	for i := 0; i < numCalls; i++ {
+		fmt.Fprintf(&source, "function f%d(a) { return f%d(a) }\n", i, i+1)
+	}
+	fmt.Fprintf(&source, "function f%d(a) { return a[1] }\n", numCalls)
+	fmt.Fprintln(&source, "BEGIN { values[1] = \"value\"; f0(values) }")
+
+	if _, err := ParseProgram(source.Bytes(), nil); err != nil {
+		t.Fatalf("a parameter type inferred at the end of the call chain should reach earlier callers: %v", err)
+	}
+}
