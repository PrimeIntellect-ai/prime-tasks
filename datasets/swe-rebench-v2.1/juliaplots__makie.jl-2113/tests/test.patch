+# issue 2005
+@testset "axis keyword on a mutating histogram" begin
+    f = Figure()
+    ax = Axis(f[1, 1])
+    err = try
+        hist!(ax, rand(100), axis = (xlabel = "value", ylabel = "occurrences"))
+        nothing
+    catch e
+        e
+    end
+    @test err isa ArgumentError
+    @test occursin("axis", lowercase(sprint(showerror, err)))
+end
