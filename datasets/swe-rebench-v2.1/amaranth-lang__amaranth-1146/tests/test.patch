+    def test_hashable(self):
+        d = {
+            signed(2): "a",
+            unsigned(3): "b",
+            unsigned(2): "c",
+        }
+        self.assertEqual(d[signed(2)], "a")
+        self.assertEqual(d[unsigned(3)], "b")
+        self.assertEqual(d[unsigned(2)], "c")
+        self.assertEqual(hash(signed(2)), hash(Shape(2, True)))
+        self.assertEqual(hash(unsigned(3)), hash(Shape(3, False)))
+
+    def test_immutable(self):
+        s = Shape(2, True)
+        with self.assertRaises(AttributeError):
+            s.width = 3
+        with self.assertRaises(AttributeError):
+            s.signed = False
+        self.assertEqual(s.width, 2)
+        self.assertEqual(s.signed, True)
