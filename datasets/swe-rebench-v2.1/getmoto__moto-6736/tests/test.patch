+)
+@mock_rds
+def test_create_db_cluster_serverless_v2_scaling_configuration_optional_keys(
+    config, expected
+):
+    client = boto3.client("rds", region_name="eu-north-1")
+
+    resp = client.create_db_cluster(
+        DBClusterIdentifier="cluster-id",
+        Engine="aurora-postgresql",
+        MasterUsername="root",
+        MasterUserPassword="hunter2_",
+        ServerlessV2ScalingConfiguration=config,
+    )
+
+    assert resp["DBCluster"]["ServerlessV2ScalingConfiguration"] == expected
+
+
