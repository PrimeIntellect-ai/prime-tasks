+def test_cli_logfile(tmp_path: Path) -> None:
+    from click.testing import CliRunner
+
+    from subliminal.cli import subliminal
+
+    logfile = tmp_path / 'subliminal.log'
+    previous_content = 'existing log contents\n'
+    logfile.write_text(previous_content)
+    CliRunner().invoke(
+        subliminal,
+        [
+            '--cache-dir',
+            os.fspath(tmp_path / 'cache'),
+            '--logfile',
+            os.fspath(logfile),
+            'download',
+            '-l',
+            'en',
+            '...',
+        ],
+    )
+    assert logfile.is_file()
+    log_content = logfile.read_text()
+    assert log_content.startswith(previous_content)
+    assert log_content[len(previous_content):].strip()
+
+
