+func newEducationSchoolPatchService(client *mocks.Client, writeEnabled bool) service.Service {
+	cfg := defaults.FullDefaultConfig()
+	cfg.Identity.LDAP.CACert = ""
+	cfg.Identity.LDAP.WriteEnabled = writeEnabled
+	cfg.Identity.LDAP.EducationResourcesEnabled = true
+	cfg.TokenManager.JWTSecret = "loremipsum"
+	cfg.Commons = &shared.Commons{}
+	cfg.GRPCClientTLS = &shared.GRPCClientTLS{}
+	logger := log.NewLogger()
+	backend, err := identity.NewLDAPBackend(client, cfg.Identity.LDAP, &logger)
+	Expect(err).ToNot(HaveOccurred())
+	_ = ogrpc.Configure(ogrpc.GetClientOptions(cfg.GRPCClientTLS)...)
+	graphService, err := service.NewService(
+		service.Config(cfg),
+		service.WithGatewayClient(&mocks.GatewayClient{}),
+		service.WithIdentityEducationBackend(backend),
+	)
+	Expect(err).ToNot(HaveOccurred())
+	return graphService
+}
