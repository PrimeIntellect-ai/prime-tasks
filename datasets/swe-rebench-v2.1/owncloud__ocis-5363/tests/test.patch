+func schoolSearchEntries(req *ldap.SearchRequest) []*ldap.Entry {
+	if req == nil {
+		return nil
+	}
+	filter := req.Filter
+	entries := []*ldap.Entry{schoolEntry, schoolEntry1}
+	var matches []*ldap.Entry
+	for _, entry := range entries {
+		id := entry.GetAttributeValue("owncloudUUID")
+		number := entry.GetAttributeValue("ocEducationSchoolNumber")
+		if (id != "" && strings.Contains(filter, "owncloudUUID="+id)) ||
+			(number != "" && strings.Contains(filter, "ocEducationSchoolNumber="+number)) {
+			matches = append(matches, entry)
+		}
+	}
+	if len(matches) > 0 {
+		return matches
+	}
+	// Broad searches may return the collection for the caller to select from.
+	if strings.Contains(filter, "ocEducationSchool") && !strings.Contains(filter, "owncloudUUID=") && !strings.Contains(filter, "ocEducationSchoolNumber=") {
+		return entries
+	}
+	return nil
+}
