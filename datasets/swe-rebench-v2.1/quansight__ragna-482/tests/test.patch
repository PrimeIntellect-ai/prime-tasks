+def test_prepare_is_idempotent(tmp_local_root):
+    class RecordingSourceStorage(RagnaDemoSourceStorage):
+        def __init__(self):
+            super().__init__()
+            self.store_count = 0
+
+        def store(self, documents):
+            self.store_count += 1
+            super().store(documents)
+
+    document_root = tmp_local_root / "documents"
+    document_root.mkdir()
+    document_path = document_root / "test.txt"
+    document_path.write_text("!\n")
+    document = LocalDocument.from_path(document_path)
+    source_storage = RecordingSourceStorage()
+
+    async def main():
+        async with Rag().chat(
+            input=[document],
+            source_storage=source_storage,
+            assistant=RagnaDemoAssistant,
+        ) as chat:
+            await chat.prepare()
+            return await chat.answer("?")
+
+    answer = asyncio.run(main())
+
+    assert source_storage.store_count == 1
+    assert answer.role is MessageRole.ASSISTANT
