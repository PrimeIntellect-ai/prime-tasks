+func TestCordoningNodeUpdateReconcilesIngress(t *testing.T) {
+	const namespace = "workloads"
+	const ingressName = "app-ingress"
+	ingressList := extensions.IngressList{Items: []extensions.Ingress{{
+		ObjectMeta: meta_v1.ObjectMeta{Name: ingressName, Namespace: namespace},
+		Spec: extensions.IngressSpec{Backend: &extensions.IngressBackend{
+			ServiceName: "app-service",
+			ServicePort: intstr.FromInt(8080),
+		}},
+	}}}
+
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+	cache := mock_cache.NewMockCache(ctrl)
+	cache.EXPECT().List(gomock.Any(), gomock.Any(), gomock.Any()).SetArg(2, ingressList).AnyTimes()
+
+	queue := &mocks.RateLimitingInterface{}
+	queue.On("Add", mock.Anything).Maybe()
+	queue.On("AddAfter", mock.Anything, mock.Anything).Maybe()
+	queue.On("AddRateLimited", mock.Anything).Maybe()
+
+	nodeReady := &api_v1.Node{Status: api_v1.NodeStatus{Conditions: []api_v1.NodeCondition{{
+		Type: api_v1.NodeReady, Status: api_v1.ConditionTrue,
+	}}}}
+	nodeCordoned := nodeReady.DeepCopy()
+	nodeCordoned.Spec.Unschedulable = true
+
+	handler := handlers.EnqueueRequestsForNodeEvent{Cache: cache}
+	handler.Update(event.UpdateEvent{ObjectOld: nodeReady, ObjectNew: nodeCordoned}, queue)
+
+	want := reconcile.Request{NamespacedName: types.NamespacedName{
+		Namespace: namespace,
+		Name:      ingressName,
+	}}
+	scheduled := false
+	for _, call := range queue.Calls {
+		if len(call.Arguments) > 0 && call.Arguments.Get(0) == want {
+			scheduled = true
+			break
+		}
+	}
+	if !scheduled {
+		t.Fatalf("cordoning a node did not schedule reconciliation for the backend ingress %s/%s", namespace, ingressName)
+	}
+	queue.AssertExpectations(t)
+}
+
+func targetsAsSet(targets []*elbv2.TargetDescription) map[string]int {
+	result := make(map[string]int, len(targets))
+	for _, target := range targets {
+		key := fmt.Sprintf("%s:%d", aws.StringValue(target.Id), aws.Int64Value(target.Port))
+		result[key]++
+	}
+	return result
+}
