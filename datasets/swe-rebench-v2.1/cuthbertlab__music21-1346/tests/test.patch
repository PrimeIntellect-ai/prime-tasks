+    def testMakeTiesAddNewMeasure(self):
+        """An overlong final note is split into tied measure-sized fragments."""
+        p = Part()
+        m = Measure(number=1)
+        m.append(meter.TimeSignature('4/4'))
+        m.append(note.Note(type='breve'))
+        p.append(m)
+
+        for result in (p.makeTies(), p.makeNotation()):
+            measures = list(result[Measure])
+            self.assertEqual(len(measures), 2)
+            fragments = [measure.notes.first() for measure in measures]
+            self.assertEqual([fragment.duration.quarterLength for fragment in fragments],
+                             [4.0, 4.0])
+            self.assertEqual(sum(fragment.duration.quarterLength for fragment in fragments),
+                             8.0)
+            self.assertIsNotNone(fragments[0].tie)
+            self.assertIsNotNone(fragments[1].tie)
+            self.assertEqual(fragments[0].tie.type, 'start')
+            self.assertEqual(fragments[1].tie.type, 'stop')
+
