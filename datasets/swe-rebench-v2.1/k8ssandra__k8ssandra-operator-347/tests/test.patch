+func TestNewDatacenter_AllowMultipleCassPerNodeSet(t *testing.T) {
+	minimumConfig := GetDatacenterConfig()
+	clusterTemplate := &api.CassandraClusterTemplate{}
+	require.NoError(t, json.Unmarshal([]byte(`{"softPodAntiAffinity":true}`), clusterTemplate))
+	clusterTemplate.StorageConfig = minimumConfig.StorageConfig
+	dcTemplate := &api.CassandraDatacenterTemplate{
+		Meta: minimumConfig.Meta,
+		Size: minimumConfig.Size,
+	}
+	template := Coalesce("k8ssandra", clusterTemplate, dcTemplate)
+	dc, err := NewDatacenter(
+		types.NamespacedName{Name: "testdc", Namespace: "test-namespace"},
+		template,
+	)
+	require.NoError(t, err)
+	assert.True(t, dc.Spec.AllowMultipleNodesPerWorker)
+}
+
+func TestNewDatacenter_AllowMultipleCassPerNodeSet_DatacenterTemplate(t *testing.T) {
+	minimumConfig := GetDatacenterConfig()
