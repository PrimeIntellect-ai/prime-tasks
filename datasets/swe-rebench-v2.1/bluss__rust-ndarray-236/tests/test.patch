+#[test]
+#[allow(deprecated)]
+fn assign_scalar_compatibility()
+{
+    let mut a = arr2(&[[1, 2], [3, 4]]);
+    a.assign_scalar(&7);
+    assert_eq!(a, arr2(&[[7, 7], [7, 7]]));
+}
+
+#[test]
+fn assign_scalar_is_deprecated()
+{
+    use std::io::Write;
+    use std::process::{Command, Stdio};
+
+    let deps = std::env::current_exe().unwrap().parent().unwrap().to_path_buf();
+    let ndarray = std::fs::read_dir(&deps).unwrap()
+        .filter_map(|entry| entry.ok())
+        .map(|entry| entry.path())
+        .find(|path| path.file_name().unwrap().to_string_lossy().starts_with("libndarray-")
+            && path.extension().map_or(false, |extension| extension == "rlib"))
+        .expect("the ndarray library used by this test must be available");
+
+    let mut child = Command::new("rustc")
+        .arg("--crate-name").arg("deprecated_api_check")
+        .arg("--crate-type=lib")
+        .arg("--edition=2015")
+        .arg("--deny=deprecated")
+        .arg("--out-dir").arg(std::env::temp_dir())
+        .arg("-L").arg(format!("dependency={}", deps.display()))
+        .arg("--extern").arg(format!("ndarray={}", ndarray.display()))
+        .arg("-")
+        .stdin(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn().unwrap();
+    child.stdin.take().unwrap().write_all(
+        b"extern crate ndarray; fn check() { let mut a = ndarray::arr1(&[1]); a.assign_scalar(&2); }"
+    ).unwrap();
+    let output = child.wait_with_output().unwrap();
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    assert!(!output.status.success() && stderr.contains("deprecated") && stderr.contains("assign_scalar"),
+            "assign_scalar should be deprecated; compiler output: {}", stderr);
+}
