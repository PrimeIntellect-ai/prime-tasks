+#[test]
+fn parse_explain_query_plan() {
+    let sqlite = all_dialects_where(|d| d.is::<SQLiteDialect>());
+    match sqlite.verified_stmt("EXPLAIN QUERY PLAN SELECT sqrt(id) FROM foo") {
+        Statement::Explain {
+            query_plan,
+            analyze,
+            verbose,
+            statement,
+            ..
+        } => {
+            assert!(query_plan);
+            assert!(!analyze);
+            assert!(!verbose);
+            assert_eq!("SELECT sqrt(id) FROM foo", statement.to_string());
+        }
+        _ => unreachable!(),
+    }
+
+    // omitting QUERY PLAN is still valid
+    sqlite.verified_stmt("EXPLAIN SELECT sqrt(id) FROM foo");
+
+    // a missing PLAN keyword is rejected
+    assert!(sqlite
+        .parse_sql_statements("EXPLAIN QUERY SELECT sqrt(id) FROM foo")
+        .is_err());
+}
