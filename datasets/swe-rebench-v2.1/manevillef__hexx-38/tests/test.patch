+#[test]
+fn hex_product() {
+    // The empty product is the multiplicative identity
+    assert_eq!(std::iter::empty::<Hex>().product::<Hex>(), Hex::ONE);
+    // A single element is returned unchanged
+    assert_eq!(std::iter::once(Hex::new(3, 4)).product::<Hex>(), Hex::new(3, 4));
+    // Correct product over a non-empty iterator
+    assert_eq!(
+        Hex::X.line_to(Hex::new(5, 0)).product::<Hex>(),
+        Hex::new((1..=5).product(), 0)
+    );
+    // Negative components are multiplied component-wise
+    assert_eq!(
+        [Hex::new(-2, 3), Hex::new(4, -5)]
+            .into_iter()
+            .product::<Hex>(),
+        Hex::new(-8, -15)
+    );
+}
