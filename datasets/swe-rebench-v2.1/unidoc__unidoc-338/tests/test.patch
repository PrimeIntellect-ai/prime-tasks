+// tcValues returns the character spacing values emitted via the PDF "Tc"
+// operator in the content streams of the document produced by the creator.
+func tcValues(t *testing.T, c *Creator) []float64 {
+	t.Helper()
+
+	var buf bytes.Buffer
+	if err := c.Write(&buf); err != nil {
+		t.Fatalf("Error writing: %v", err)
+	}
+
+	r, err := model.NewPdfReader(bytes.NewReader(buf.Bytes()))
+	if err != nil {
+		t.Fatalf("Error reading: %v", err)
+	}
+
+	numPages, err := r.GetNumPages()
+	if err != nil {
+		t.Fatalf("Error getting number of pages: %v", err)
+	}
+
+	var values []float64
+	for i := 1; i <= numPages; i++ {
+		page, err := r.GetPage(i)
+		if err != nil {
+			t.Fatalf("Error getting page %d: %v", i, err)
+		}
+
+		content, err := page.GetAllContentStreams()
+		if err != nil {
+			t.Fatalf("Error getting content streams: %v", err)
+		}
+
+		parser := contentstream.NewContentStreamParser(content)
+		ops, err := parser.Parse()
+		if err != nil {
+			t.Fatalf("Error parsing content stream: %v", err)
+		}
+
+		for _, op := range *ops {
+			if op.Operand != "Tc" || len(op.Params) != 1 {
+				continue
+			}
+			if v, err := core.GetNumberAsFloat(op.Params[0]); err == nil {
+				values = append(values, v)
+			}
+		}
+	}
+
+	return values
+}
+
+func containsFloat(values []float64, target float64) bool {
+	for _, v := range values {
+		if v == target {
+			return true
+		}
+	}
+	return false
+}
+
+// TestStyledParagraphCharacterSpacingTc verifies that a non-zero character
+// spacing set on a styled paragraph chunk is emitted through the PDF "Tc"
+// operator with the value expressed in 1/1000 text space units.
+func TestStyledParagraphCharacterSpacingTc(t *testing.T) {
+	fontRegular := newStandard14Font(t, fonts.HelveticaName)
+
+	c := New()
+	c.NewPage()
+
+	p := c.NewStyledParagraph()
+	chunk := p.Append("Character spacing is emitted via the Tc operator.")
+	chunk.Style.Font = fontRegular
+	chunk.Style.CharSpacing = 2.5
+
+	if err := c.Draw(p); err != nil {
+		t.Fatalf("Error drawing: %v", err)
+	}
+
+	values := tcValues(t, c)
+	if !containsFloat(values, 2.5) {
+		t.Fatalf("Expected character spacing 2.5 to be emitted via the Tc operator, got Tc values: %v", values)
+	}
+}
+
+// TestStyledParagraphCharacterSpacingDistinctValues verifies that the value
+// emitted through the Tc operator tracks the configured character spacing
+// rather than being a fixed constant.
+func TestStyledParagraphCharacterSpacingDistinctValues(t *testing.T) {
+	fontRegular := newStandard14Font(t, fonts.HelveticaName)
+
+	c := New()
+	c.NewPage()
+
+	first := c.NewStyledParagraph()
+	chunk := first.Append("First paragraph with a small character spacing.")
+	chunk.Style.Font = fontRegular
+	chunk.Style.CharSpacing = 3
+
+	if err := c.Draw(first); err != nil {
+		t.Fatalf("Error drawing: %v", err)
+	}
+
+	second := c.NewStyledParagraph()
+	chunk = second.Append("Second paragraph with a larger character spacing.")
+	chunk.Style.Font = fontRegular
+	chunk.Style.CharSpacing = 11
+
+	if err := c.Draw(second); err != nil {
+		t.Fatalf("Error drawing: %v", err)
+	}
+
+	values := tcValues(t, c)
+	if !containsFloat(values, 3) {
+		t.Fatalf("Expected character spacing 3 to be emitted via the Tc operator, got Tc values: %v", values)
+	}
+	if !containsFloat(values, 11) {
+		t.Fatalf("Expected character spacing 11 to be emitted via the Tc operator, got Tc values: %v", values)
+	}
+}
