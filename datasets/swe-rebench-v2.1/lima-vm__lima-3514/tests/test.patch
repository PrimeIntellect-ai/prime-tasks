+
+// TestEmbeddedTemplatesPassJSONSchemaValidation verifies that the embedded
+// templates and the documented "base" forms pass the JSON Schema generated
+// from the LimaYAML definition.
+func TestEmbeddedTemplatesPassJSONSchemaValidation(t *testing.T) {
+	repoRoot, err := filepath.Abs("../..")
+	assert.NilError(t, err)
+
+	dir, err := os.MkdirTemp("", "lima-jsonschema")
+	assert.NilError(t, err)
+	defer os.RemoveAll(dir)
+	// limactl refuses to run as root, so make the directory accessible to a
+	// non-root user.
+	assert.NilError(t, os.Chmod(dir, 0o777))
+
+	limactl := filepath.Join(dir, "limactl")
+	build := exec.Command("go", "build", "-o", limactl, "./cmd/limactl")
+	build.Dir = repoRoot
+	out, err := build.CombinedOutput()
+	assert.NilError(t, err, string(out))
+	assert.NilError(t, os.Chmod(limactl, 0o755))
+
+	// The embedded template and the documented "base" forms.
+	instances := []string{filepath.Join(repoRoot, "templates", "default.yaml")}
+	forms := map[string]string{
+		"base-list-of-strings.yaml": "minimumLimaVersion: 1.1.0\n\nbase:\n- template://_images/ubuntu-24.10\n- template://_default/mounts\n",
+		"base-single-string.yaml":   "base: template://_images/ubuntu-24.10\n",
+		"base-list-of-objects.yaml": "base:\n- url: template://_images/ubuntu-24.10\n  digest: deadbeef\n",
+		"images-null.yaml":          "images: null\n",
+	}
+	for name, content := range forms {
+		p := filepath.Join(dir, name)
+		assert.NilError(t, os.WriteFile(p, []byte(content), 0o644))
+		instances = append(instances, p)
+	}
+
+	schemaFile := filepath.Join(dir, "schema.json")
+	args := append([]string{"generate-jsonschema", "--schemafile", schemaFile}, instances...)
+	cmd := exec.Command(limactl, args...)
+	cmd.Dir = dir
+	cmd.Env = append(os.Environ(), "HOME="+dir)
+	if os.Geteuid() == 0 {
+		cmd.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{Uid: 1000, Gid: 1000}}
+	}
+	out, err = cmd.CombinedOutput()
+	assert.NilError(t, err, string(out))
+}
