+# ``bfill``/``ffill`` accept ``axis`` positionally in pandas 1.x but only as a
+# keyword in pandas 2.x.  Normalise both calling conventions so that the
+# behaviour exercised below is identical on every supported pandas version.
+_bfill = pd.DataFrame.bfill
+_ffill = pd.DataFrame.ffill
+
+
+def _bfill_axis_compat(self, *args, **kwargs):
+    if args:
+        kwargs["axis"] = args[0]
+    return _bfill(self, **kwargs)
+
+
+def _ffill_axis_compat(self, *args, **kwargs):
+    if args:
+        kwargs["axis"] = args[0]
+    return _ffill(self, **kwargs)
+
+
+pd.DataFrame.bfill = _bfill_axis_compat
+pd.DataFrame.ffill = _ffill_axis_compat
+
+
