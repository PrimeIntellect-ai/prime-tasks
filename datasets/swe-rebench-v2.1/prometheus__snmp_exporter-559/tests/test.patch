+func sampleLabels(t *testing.T, indexOids []int, metric *config.Metric) (labels map[string]string) {
+	t.Helper()
+	const baseOID = "1.3.6.1.4.1.99999.1"
+	metric.Oid = baseOID
+	metric.Name = "sample"
+	metric.Type = "gauge"
+	metric.Help = "sample metric"
+	requestedOID := baseOID
+	for _, component := range indexOids {
+		requestedOID += "." + strconv.Itoa(component)
+	}
+	listener, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.ParseIP("127.0.0.1"), Port: 0})
+	if err != nil {
+		t.Fatalf("unable to start local SNMP responder: %v", err)
+	}
+	defer listener.Close()
+	responseErr := make(chan error, 1)
+	go func() {
+		buf := make([]byte, 2048)
+		n, addr, err := listener.ReadFromUDP(buf)
+		if err != nil {
+			responseErr <- err
+			return
+		}
+		var message asn1.RawValue
+		if _, err = asn1.Unmarshal(buf[:n], &message); err != nil {
+			responseErr <- err
+			return
+		}
+		var version, community, request asn1.RawValue
+		remaining := message.Bytes
+		for _, destination := range []*asn1.RawValue{&version, &community, &request} {
+			remaining, err = asn1.Unmarshal(remaining, destination)
+			if err != nil {
+				responseErr <- err
+				return
+			}
+		}
+		var requestID int32
+		if _, err = asn1.Unmarshal(request.Bytes, &requestID); err != nil {
+			responseErr <- err
+			return
+		}
+		packet := &gosnmp.SnmpPacket{
+			Version: gosnmp.Version2c, Community: "public", PDUType: gosnmp.GetResponse,
+			RequestID: uint32(requestID), Variables: []gosnmp.SnmpPDU{{Name: "." + requestedOID,
+				Type: gosnmp.Integer, Value: 1}},
+		}
+		var encoded []byte
+		encoded, err = packet.MarshalMsg()
+		if err == nil {
+			_, err = listener.WriteToUDP(encoded, addr)
+		}
+		responseErr <- err
+	}()
+
+	module := &config.Module{
+		WalkParams: config.WalkParams{Version: 2, Retries: 0, Timeout: time.Second},
+		Get:        []string{requestedOID}, Metrics: []*config.Metric{metric},
+	}
+	collector := collector{ctx: context.Background(), target: listener.LocalAddr().String(), module: module, logger: log.NewNopLogger()}
+	ch := make(chan prometheus.Metric, 16)
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			t.Errorf("collection panicked: %v", recovered)
+		}
+	}()
+	collector.Collect(ch)
+	if err := <-responseErr; err != nil {
+		t.Fatalf("local SNMP response failed: %v", err)
+	}
+	for len(ch) > 0 {
+		sample := <-ch
+		var emitted io_prometheus_client.Metric
+		if err := sample.Write(&emitted); err != nil {
+			continue
+		}
+		candidate := make(map[string]string, len(emitted.GetLabel()))
+		for _, label := range emitted.GetLabel() {
+			candidate[label.GetName()] = label.GetValue()
+		}
+		if len(candidate) > 0 {
+			return candidate
+		}
+	}
+	return nil
+}
