+func TestEnumAsInfoIndexLabels(t *testing.T) {
+	t.Run("mapped code renders its configured text", func(t *testing.T) {
+		metric := metricFromYAML(t, "name: sample\ntype: gauge\nindexes:\n- labelname: l\n  type: EnumAsInfo\n  enum_values:\n    0: foo\n    1: bar\n")
+		if got := sampleLabels(t, []int{0}, &metric); got["l"] != "foo" {
+			t.Errorf("label l = %q, want mapped enum text %q", got["l"], "foo")
+		}
+	})
+
+	t.Run("subsequent index uses the remaining OID component", func(t *testing.T) {
+		metric := metricFromYAML(t, "name: sample\ntype: gauge\nindexes:\n- labelname: l\n  type: EnumAsInfo\n  enum_values:\n    0: foo\n- labelname: m\n  type: gauge\n")
+		labels := sampleLabels(t, []int{0, 5}, &metric)
+		if labels["l"] != "foo" || labels["m"] != "5" {
+			t.Errorf("emitted labels = %v, want l=foo and m=5", labels)
+		}
+	})
+}
+
+func TestUnmappedEnumAsInfoIsRejectedOrHandledSafely(t *testing.T) {
+	configText := "test:\n  metrics:\n  - name: sample\n    oid: 1.3.6.1.4.1.99999.1\n    type: gauge\n    indexes:\n    - labelname: l\n      type: EnumAsInfo\n"
+	file, err := ioutil.TempFile(t.TempDir(), "snmp-config-*.yml")
+	if err != nil {
+		t.Fatalf("unable to create temporary config: %v", err)
+	}
+	if _, err := file.WriteString(configText); err != nil {
+		t.Fatalf("unable to write temporary config: %v", err)
+	}
+	if err := file.Close(); err != nil {
+		t.Fatalf("unable to close temporary config: %v", err)
+	}
+	cfg, err := config.LoadFile(file.Name())
+	if err != nil {
+		return // Rejecting the configuration before collection is safe.
+	}
+	metric := (*cfg)["test"].Metrics[0]
+	// If accepted, collection must handle the unmapped index without an uncaught panic.
+	sampleLabels(t, []int{3}, metric)
+}
