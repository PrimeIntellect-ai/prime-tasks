+// metricFromYAML builds a config.Metric from its YAML representation so that
+// the test exercises the public configuration surface rather than depending on
+// the concrete Go struct fields used to carry enum values.
+func metricFromYAML(t *testing.T, y string) config.Metric {
+	t.Helper()
+	var m config.Metric
+	if err := yaml.Unmarshal([]byte(y), &m); err != nil {
+		t.Fatalf("unable to parse metric yaml: %v", err)
+	}
+	return m
+}
