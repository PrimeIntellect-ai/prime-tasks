+// TestConfigFlagsMergeToConfigMounts verifies that mounts declared in a
+// configuration file are resolved and attached, not only mounts passed on the
+// command line.
+func TestConfigFlagsMergeToConfigMounts(t *testing.T) {
+	firstVolume := buildVolume("vol")
+	defer removeVolume(firstVolume)
+	secondVolume := buildVolume("vol")
+	defer removeVolume(secondVolume)
+
+	configFileName := "test-" + String(5) + ".json"
+	expected := &types.Config{
+		Mounts: map[string]string{
+			firstVolume:  "/first",
+			secondVolume: "/second",
+		},
+	}
+
+	writeConfigToFile(expected, configFileName)
+	defer os.Remove(configFileName)
+
+	flagSet := newConfigFlagSet()
+	flagSet.Set("config", configFileName)
+	configFlags := cmd.NewConfigCommandFlags(flagSet)
+
+	actual := &types.Config{}
+
+	err := configFlags.MergeToConfig(actual)
+
+	require.NoError(t, err)
+	assert.Equal(t, expected.Mounts, actual.Mounts)
+
+	storedPaths := make([]string, 0, len(expected.Mounts))
+	for _, volumeName := range []string{firstVolume, secondVolume} {
+		volumes, lookupErr := onprem.GetVolumes(lepton.LocalVolumeDir, map[string]string{"label": volumeName})
+		require.NoError(t, lookupErr)
+		require.Len(t, volumes, 1)
+		storedPaths = append(storedPaths, volumes[0].Path)
+	}
+	require.Len(t, actual.RunConfig.Mounts, 2)
+	assert.ElementsMatch(t, storedPaths, actual.RunConfig.Mounts)
+}
+
+// TestBuildImageFlagsMergeToConfigMountError verifies that a failure while
+// processing mounts is reported to the caller instead of terminating the
+// process.
+func TestBuildImageFlagsMergeToConfigMountError(t *testing.T) {
+	flagSet := pflag.NewFlagSet("test", 0)
+
+	cmd.PersistBuildImageCommandFlags(flagSet)
+
+	flagSet.Set("mounts", "missing-volume:/files")
+
+	buildImageFlags := cmd.NewBuildImageCommandFlags(flagSet)
+
+	c := &types.Config{}
+	configFlagSet := pflag.NewFlagSet("test", 0)
+	cmd.PersistConfigCommandFlags(configFlagSet)
+	configFlags := cmd.NewConfigCommandFlags(configFlagSet)
+	err := configFlags.MergeToConfig(c)
+	assert.Nil(t, err)
+
+	err = buildImageFlags.MergeToConfig(c)
+	assert.Error(t, err)
 }
 
