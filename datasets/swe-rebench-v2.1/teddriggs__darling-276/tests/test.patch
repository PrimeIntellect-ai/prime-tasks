+#[test]
+fn option_literal() {
+    let holder = Holder::from_derive_input(&parse_quote! {
+        #[hello(lorem(opt_dolor = "Hello"))]
+        struct Bar;
+    })
+    .unwrap();
+
+    assert_eq!(holder.lorem, Lorem::OptDolor(Some("Hello".into())));
+}
+
+/// A newtype variant with an omitted-value default can be selected by word form.
+#[test]
+fn newtype_option_variant_accepts_word_form_with_default() {
+    let holder = Holder::from_derive_input(&parse_quote! {
+        #[hello(lorem = "opt_dolor")]
+        struct Bar;
+    })
+    .unwrap();
+
+    assert_eq!(holder.lorem, Lorem::OptDolor(None));
+}
+
+/// A newtype variant without an omitted-value default is rejected as an unsupported format.
+#[test]
+fn word_only_fails_for_non_option() {
+    let error = Holder::from_derive_input(&parse_quote! {
+        #[hello(lorem = "dolor")]
+        struct Bar;
+    })
+    .unwrap_err();
+
+    assert!(error
+        .to_string()
+        .starts_with("Unexpected meta-item format"));
+}
