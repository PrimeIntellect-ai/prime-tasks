+#[test]
+fn test_bool_same_as_int() {
+	assert_eq!(rlp::encode(&false), rlp::encode(&0x00u8));
+
+	struct BoolField(bool);
+	impl Encodable for BoolField {
+		fn rlp_append(&self, stream: &mut RlpStream) {
+			stream.begin_list(1).append(&self.0);
+		}
+	}
+
+	struct ByteField(u8);
+	impl Encodable for ByteField {
+		fn rlp_append(&self, stream: &mut RlpStream) {
+			stream.begin_list(1).append(&self.0);
+		}
+	}
+
+	assert_eq!(rlp::encode(&BoolField(false)), rlp::encode(&ByteField(0)));
+}
