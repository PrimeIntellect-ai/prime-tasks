+@testset "insample" begin
+    X, y = make_regression(20)
+    model = Models.DeterministicConstantRegressor()
+
+    # all rows:
+    e = evaluate(model, X, y, resampling=InSample(), measure=rms)
+    @test e.measurement[1] ≈ std(y, corrected=false)
+
+    # The explicitly requested measure is applied to predictions from the
+    # in-sample fit, both singly and when evaluating a battery of measures.
+    mach = machine(model, X, y) |> fit!
+    yhat = predict(mach, X)
+    expected_mae = mean(abs.(yhat .- y))
+    single = evaluate(model, X, y, resampling=InSample(), measure=mae)
+    @test single.measurement[1] ≈ expected_mae
+
+    battery = evaluate(model, X, y, resampling=InSample(), measure=[rms, mae])
+    @test battery.measurement[1] ≈ std(y, corrected=false)
+    @test battery.measurement[2] ≈ expected_mae
+
+    # subsample of rows:
+    e = evaluate(model, X, y, resampling=InSample(), measure=rms, rows=1:7)
+    @test e.measurement[1] ≈ std(y[1:7], corrected=false)
+end
