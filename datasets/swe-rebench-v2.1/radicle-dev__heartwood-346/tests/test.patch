+#[test]
+//
+//     alice -- bob -- eve
+//
+fn test_seeds_disconnected() {
+    logger::init(log::Level::Debug);
+
+    let tmp = tempfile::tempdir().unwrap();
+    let alice = Node::init(tmp.path());
+    let mut bob = Node::init(tmp.path());
+    let mut eve = Node::init(tmp.path());
+    let acme = eve.project("acme", "");
+
+    let mut alice = alice.spawn(service::Config::default());
+    let mut bob = bob.spawn(service::Config::default());
+    let eve = eve.spawn(service::Config::default());
+
+    alice.connect(&bob);
+    bob.connect(&eve);
+    converge([&alice, &bob, &eve]);
+
+    let _ = alice.handle.track_repo(acme).unwrap();
+    let seeds = alice.handle.seeds(acme).unwrap();
+
+    // Alice is not connected to Eve, but Eve is a seed for `acme`.
+    assert!(seeds.is_disconnected(&eve.id));
+    assert!(!seeds.is_connected(&eve.id));
+}
+
+#[test]
+fn test_seeds_fetching() {
+    logger::init(log::Level::Debug);
+
+    let tmp = tempfile::tempdir().unwrap();
+    let alice = Node::init(tmp.path());
+    let mut bob = Node::init(tmp.path());
+    let acme = bob.project("acme", "");
+
+    let mut alice = alice.spawn(service::Config::default());
+    let bob = bob.spawn(service::Config::default());
+
+    alice.connect(&bob);
+    converge([&alice, &bob]);
+
+    let _ = alice.handle.track_repo(acme).unwrap();
+
+    // While a fetch is in progress, the seed being fetched from is reported as
+    // fetching, rather than as merely connected.
+    let mut observed = false;
+    for _ in 0..20 {
+        let mut fetch_handle = (*alice.handle).clone();
+        let fetch = thread::spawn(move || fetch_handle.fetch(acme, bob.id).unwrap());
+
+        while !fetch.is_finished() {
+            let seeds = alice.handle.seeds(acme).unwrap();
+            if seeds.is_fetching(&bob.id) {
+                observed = true;
+                break;
+            }
+        }
+        let result = fetch.join().unwrap();
+        assert!(result.is_success());
+
+        if observed {
+            break;
+        }
+    }
+    assert!(observed, "expected to observe bob in the fetching state");
+}
