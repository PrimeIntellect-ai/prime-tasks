+package execunit
+
+import (
+"encoding/json"
+"os"
+"path/filepath"
+"strings"
+"testing"
+
+"github.com/klothoplatform/klotho/pkg/config"
+"github.com/klothoplatform/klotho/pkg/core"
+"github.com/stretchr/testify/assert"
+"github.com/stretchr/testify/require"
+)
+
+// loadTestConfig writes the given application config as JSON and reads it back through the public config loader.
+func loadTestConfig(t *testing.T, appCfg map[string]any) config.Application {
+t.Helper()
+data, err := json.Marshal(appCfg)
+require.NoError(t, err)
+fpath := filepath.Join(t.TempDir(), "klotho.json")
+require.NoError(t, os.WriteFile(fpath, data, 0600))
+cfg, err := config.ReadConfig(fpath)
+require.NoError(t, err)
+return cfg
+}
+
+func Test_environmentVarsAddedToUnit(t *testing.T) {
+envVars := map[string]string{
+"key1": "value1",
+"key2": "value2",
+}
+wantEnvVars := []core.EnvironmentVariable{
+{Name: "key1", Value: "value1"},
+{Name: "key2", Value: "value2"},
+}
+
+tests := []struct {
+name         string
+unitType     string
+envVars      map[string]string
+want         []core.EnvironmentVariable
+wantExecUnit bool
+}{
+{
+name:         "no exec unit",
+unitType:     "lambda",
+envVars:      envVars,
+wantExecUnit: false,
+},
+{
+name:         "add env vars to lambda",
+unitType:     "lambda",
+envVars:      envVars,
+want:         wantEnvVars,
+wantExecUnit: true,
+},
+{
+name:         "add env vars to fargate",
+unitType:     "fargate",
+envVars:      envVars,
+want:         wantEnvVars,
+wantExecUnit: true,
+},
+{
+name:         "no env vars configured",
+unitType:     "fargate",
+wantExecUnit: true,
+},
+}
+for _, tt := range tests {
+t.Run(tt.name, func(t *testing.T) {
+assert := assert.New(t)
+
+unitCfg := map[string]any{"type": tt.unitType}
+if tt.envVars != nil {
+unitCfg["environment_variables"] = tt.envVars
+}
+cfg := loadTestConfig(t, map[string]any{
+"execution_units": map[string]any{
+"main": unitCfg,
+},
+})
+p := ExecUnitPlugin{Config: &cfg}
+result := &core.CompilationResult{}
+
+inputFiles := &core.InputFiles{}
+if tt.wantExecUnit {
+f, err := core.NewSourceFile("test", strings.NewReader("test"), testAnnotationLang)
+if assert.Nil(err) {
+inputFiles.Add(f)
+}
+} else {
+inputFiles.Add(&core.FileRef{
+FPath: "test",
+})
+}
+
+result.Add(inputFiles)
+err := p.Transform(result, &core.Dependencies{})
+if !assert.NoError(err) {
+return
+}
+units := core.GetResourcesOfType[*core.ExecutionUnit](result)
+if tt.wantExecUnit {
+if assert.Len(units, 1) {
+assert.ElementsMatch(tt.want, units[0].EnvironmentVariables)
+}
+} else {
+assert.Len(units, 0)
+}
+
+})
+}
+}
