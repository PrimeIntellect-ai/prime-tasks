+func setImagePullSecrets(policy *v1beta1.PodPolicy, secrets []v1.LocalObjectReference) bool {
+	field := reflect.ValueOf(policy).Elem().FieldByName("ImagePullSecrets")
+	Ω(field.IsValid()).To(BeTrue(), "PodPolicy must expose ImagePullSecrets")
+	if !field.IsValid() {
+		return false
+	}
+	Ω(field.Type()).To(Equal(reflect.TypeOf(secrets)))
+	if field.Type() != reflect.TypeOf(secrets) {
+		return false
+	}
+	field.Set(reflect.ValueOf(secrets))
+	return true
+}
+
+func imagePullSecrets(policy *v1beta1.PodPolicy) []v1.LocalObjectReference {
+	field := reflect.ValueOf(policy).Elem().FieldByName("ImagePullSecrets")
+	Ω(field.IsValid()).To(BeTrue(), "PodPolicy must expose ImagePullSecrets")
+	if !field.IsValid() {
+		return nil
+	}
+	Ω(field.Type()).To(Equal(reflect.TypeOf([]v1.LocalObjectReference{})))
+	return field.Interface().([]v1.LocalObjectReference)
+}
+
+func nestedSchemaMap(root map[string]interface{}, path ...string) map[string]interface{} {
+	current := root
+	for _, key := range path {
+		value, ok := current[key].(map[string]interface{})
+		Ω(ok).To(BeTrue(), "expected schema object at %q", key)
+		current = value
+	}
+	return current
+}
