+func TestWorkflowRunAttemptOptions_GetExcludePullRequests(tt *testing.T) {
+	var zeroValue bool
+	w := &WorkflowRunAttemptOptions{ExcludePullRequests: &zeroValue}
+	if got := w.GetExcludePullRequests(); got != false {
+		tt.Errorf("GetExcludePullRequests() = %v, want false", got)
+	}
+	trueValue := true
+	w = &WorkflowRunAttemptOptions{ExcludePullRequests: &trueValue}
+	if got := w.GetExcludePullRequests(); got != true {
+		tt.Errorf("GetExcludePullRequests() = %v, want true", got)
+	}
+	w = &WorkflowRunAttemptOptions{}
+	if got := w.GetExcludePullRequests(); got != false {
+		tt.Errorf("GetExcludePullRequests() = %v, want false", got)
+	}
+	w = nil
+	if got := w.GetExcludePullRequests(); got != false {
+		tt.Errorf("GetExcludePullRequests() = %v, want false", got)
+	}
+}
