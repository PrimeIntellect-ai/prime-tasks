+// TestBoxInfoCommandRequestsSystemStatus checks the observable request made by the CLI command.
+func TestBoxInfoCommandRequestsSystemStatus(t *testing.T) {
+	config.Dir = "../testdata/config"
+	config.Filename = "config_localhost_https_test.json"
+
+	srv := mock.New().UnstartedServer()
+	handler := srv.Config.Handler
+	requestedSystemStatus := false
+	srv.Config.Handler = http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/cgi-bin/system_status" {
+			requestedSystemStatus = true
+		}
+		handler.ServeHTTP(w, r)
+	})
+	listener, err := net.Listen("tcp", ":61666")
+	assert.NoError(t, err)
+	srv.Listener = listener
+	srv.Start()
+	defer srv.Close()
+
+	command, _, err := RootCmd.Find([]string{"boxinfo"})
+	if !assert.NoError(t, err) || !assert.NotNil(t, command) {
+		return
+	}
+	if !assert.Equal(t, "boxinfo", command.Name()) {
+		return
+	}
+	RootCmd.SetArgs([]string{"boxinfo"})
+	defer RootCmd.SetArgs(nil)
+	_ = RootCmd.Execute()
+	assert.True(t, requestedSystemStatus, "boxinfo should request the FRITZ!Box system-status URL")
+}
