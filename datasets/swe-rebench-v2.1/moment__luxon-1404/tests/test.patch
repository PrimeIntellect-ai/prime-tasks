   expect(Duration.fromObject({ milliseconds: -1 }).toISOTime()).toBe(null);
 });
 
+test("Duration#toISOTime is not influenced by the locale", () => {
+  expect(Duration.fromObject({ hours: 3, minutes: 10 }, { locale: "ar-QA" }).toISOTime()).toBe(
+    "03:10:00.000"
+  );
+});
+
+test("Duration#toISOTime output can be parsed back", () => {
+  const original = Duration.fromObject({ hours: 3, minutes: 10 }, { locale: "ar-QA" });
+  const parsed = Duration.fromISOTime(original.toISOTime());
+
+  expect(parsed.isValid).toBe(true);
+  expect(parsed.toMillis()).toBe(original.toMillis());
+});
+
+test("Duration#toISOTime returns null for invalid durations", () => {
+  expect(Duration.invalid("because").toISOTime()).toBe(null);
+});
+
+test("Duration#toISOTime does not include an offset by default", () => {
+  expect(Duration.fromObject({ hours: 3 }).toISOTime({ includeOffset: false })).toBe(
+    "03:00:00.000"
+  );
+});
+
