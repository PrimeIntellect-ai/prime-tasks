+def test_json_encoders_inherited_across_multiple_generations():
+    class Grandparent(BaseModel):
+        dt: datetime.datetime = datetime.datetime(2032, 1, 1)
+
+        class Config:
+            json_encoders = {datetime.datetime: lambda _: 'grandparent_encoder'}
+
+    class Parent(Grandparent):
+        duration: datetime.timedelta = datetime.timedelta(seconds=1)
+
+        class Config:
+            json_encoders = {datetime.timedelta: lambda _: 'parent_encoder'}
+
+    class Child(Parent):
+        amount: Decimal = Decimal('2.5')
+
+        class Config:
+            json_encoders = {Decimal: lambda _: 'child_encoder'}
+
+    assert json.loads(Child().json()) == {
+        'dt': 'grandparent_encoder',
+        'duration': 'parent_encoder',
+        'amount': 'child_encoder',
+    }
