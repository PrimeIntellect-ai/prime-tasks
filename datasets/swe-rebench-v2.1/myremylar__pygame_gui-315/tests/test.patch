+    def test_placeholder_text(self, _init_pygame):
+        # An entry with placeholder text should render that placeholder whenever it is
+        # empty and unfocused, and hide it once it is focused or contains real text.
+        resolution = (400, 400)
+
+        def make_entry(placeholder_text=None):
+            manager = UIManager(resolution)
+            rect = pygame.Rect(100, 100, 200, 30)
+            if placeholder_text is None:
+                entry = UITextEntryLine(relative_rect=rect, manager=manager)
+            else:
+                entry = UITextEntryLine(relative_rect=rect, manager=manager,
+                                        placeholder_text=placeholder_text)
+            manager.update(0.001)
+            return manager, entry
+
+        placeholder_manager, placeholder_entry = make_entry("Enter name...")
+        alternate_manager, alternate_entry = make_entry("Type a longer value...")
+        reference_manager, reference_entry = make_entry()
+
+        # Different caller-provided strings produce different placeholder renderings.
+        assert not compare_surfaces(placeholder_entry.image, alternate_entry.image)
+
+        # Empty and unfocused: the placeholder is visible, so the rendering differs from an
+        # otherwise identical entry that has no placeholder.
+        assert not compare_surfaces(placeholder_entry.image, reference_entry.image)
+
+        # Setting real text hides the placeholder; both entries now render the same text.
+        placeholder_entry.set_text("Dan")
+        reference_entry.set_text("Dan")
+        placeholder_manager.update(0.001)
+        reference_manager.update(0.001)
+        assert compare_surfaces(placeholder_entry.image, reference_entry.image)
+
+        # Clearing the text brings the placeholder back.
+        placeholder_entry.set_text("")
+        reference_entry.set_text("")
+        placeholder_manager.update(0.001)
+        reference_manager.update(0.001)
+        assert not compare_surfaces(placeholder_entry.image, reference_entry.image)
+
+        # Focusing an empty entry hides the placeholder.
+        placeholder_entry.focus()
+        reference_entry.focus()
+        placeholder_manager.update(0.001)
+        reference_manager.update(0.001)
+        assert compare_surfaces(placeholder_entry.image, reference_entry.image)
+
+        # Unfocusing an empty entry shows the placeholder again.
+        placeholder_entry.unfocus()
+        reference_entry.unfocus()
+        placeholder_manager.update(0.001)
+        reference_manager.update(0.001)
+        assert not compare_surfaces(placeholder_entry.image, reference_entry.image)
+
     def test_set_text_length_limit(self, _init_pygame, default_ui_manager):
         text_entry = UITextEntryLine(relative_rect=pygame.Rect(100, 100, 200, 30),
                                      manager=default_ui_manager)
