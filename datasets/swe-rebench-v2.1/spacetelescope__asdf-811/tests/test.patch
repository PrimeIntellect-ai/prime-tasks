+def test_one_of_rejects_multiple_matching_alternatives(one_of_validation_context):
+    overlapping_schema = {
+        'oneOf': [
+            {'type': 'number'},
+            {'minimum': 0},
+        ]
+    }
+
+    with pytest.raises(ValidationError):
+        schema.validate(1, schema=overlapping_schema,
+                        ctx=one_of_validation_context)
+
+
+def test_one_of_rejects_no_matching_alternative(one_of_validation_context):
+    unmatched_schema = {
+        'oneOf': [
