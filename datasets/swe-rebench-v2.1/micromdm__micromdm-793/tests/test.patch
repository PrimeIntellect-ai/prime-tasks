+
+// plistContainsDeferrals reports whether the decoded plist contains a
+// max_user_deferrals entry (in either the snake_case or Go field-name
+// casing) with the given value.
+func plistContainsDeferrals(v interface{}, want int64) bool {
+	switch t := v.(type) {
+	case map[string]interface{}:
+		for k, val := range t {
+			if k == "MaxUserDeferrals" || k == "max_user_deferrals" {
+				switch n := val.(type) {
+				case int64:
+					if n == want {
+						return true
+					}
+				case int:
+					if int64(n) == want {
+						return true
+					}
+				case uint64:
+					if int64(n) == want {
+						return true
+					}
+				case float64:
+					if int64(n) == want {
+						return true
+					}
+				}
+			}
+			if plistContainsDeferrals(val, want) {
+				return true
+			}
+		}
+	case []interface{}:
+		for _, item := range t {
+			if plistContainsDeferrals(item, want) {
+				return true
+			}
+		}
+	}
+	return false
+}
