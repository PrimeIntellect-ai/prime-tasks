+func TestCopyRawQuestionMarkIsLiteral(t *testing.T) {
+	t.Parallel()
+
+	const sourceBucket = "source"
+	const destinationBucket = "destination"
+
+	s3client, s5cmd, cleanup := setup(t)
+	defer cleanup()
+	createBucket(t, s3client, sourceBucket)
+	createBucket(t, s3client, destinationBucket)
+
+	putFile(t, s3client, sourceBucket, "item?.txt", "literal source")
+	putFile(t, s3client, sourceBucket, "itemA.txt", "glob match")
+
+	result := icmd.RunCmd(s5cmd("cp", "-raw", "s3://"+sourceBucket+"/item?.txt", "s3://"+destinationBucket+"/copied?.txt"))
+	result.Assert(t, icmd.Success)
+	assert.Assert(t, ensureS3Object(s3client, destinationBucket, "copied?.txt", "literal source"))
+	assertError(t, ensureS3Object(s3client, destinationBucket, "itemA.txt", "glob match"), errS3NoSuchKey)
+}
