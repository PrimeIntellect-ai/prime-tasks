@@ -0,0 +1,17 @@
+import subprocess
+import sys
+
+
+def test_resolver_initialization_handles_non_pep440_python_version():
+    code = """
+import platform
+platform.python_version = lambda: '3.9.7+'
+from pip_audit._dependency_source.resolvelib.resolvelib import ResolveLibResolver
+ResolveLibResolver()
+"""
+    result = subprocess.run(
+        [sys.executable, "-c", code],
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 0, result.stderr
