+describe('Ephemeral replies use flags instead of the deprecated ephemeral option', () => {
+  function expectEphemeralFlags(replyMock) {
+    expect(replyMock).toHaveBeenCalled();
+    const replyArg = replyMock.mock.calls[0][0];
+    expect(replyArg).toEqual(
+      expect.objectContaining({ flags: MessageFlags.Ephemeral }),
+    );
+    expect(replyArg).not.toHaveProperty('ephemeral');
+  }
+
+  it('OpenCollectiveService replies with flags when the user already has the Backer role', async () => {
+    const OpenCollectiveService = require('../opencollective/opencollective.service');
+    const interaction = {
+      member: { roles: { cache: { has: () => true } } },
+      reply: jest.fn(),
+    };
+
+    await OpenCollectiveService.handleInteraction(interaction);
+
+    expectEphemeralFlags(interaction.reply);
+  });
+
+  it('ModerationMessageDeleteService replies with flags when the message cannot be deleted', async () => {
+    const ModerationMessageDeleteService = require('../moderation-message-delete.service');
+    const interaction = {
+      options: { getMessage: () => null },
+      reply: jest.fn(),
+    };
+
+    await ModerationMessageDeleteService.handleInteraction(interaction);
+
+    expectEphemeralFlags(interaction.reply);
+  });
+
+  it('interaction-create replies with flags for an unknown modal submit', async () => {
+    const interactionCreate = require('../../events/interaction-create');
+    const interaction = {
+      isCommand: () => false,
+      isModalSubmit: () => true,
+      customId: 'not-a-known-modal',
+      reply: jest.fn(),
+    };
+
+    await interactionCreate.execute()(interaction);
+
+    expectEphemeralFlags(interaction.reply);
+  });
+
+  it('the format-code context menu command replies with flags when execution fails', async () => {
+    const formatCodeCommand = require('../../bot-commands/context-menu/format-code');
+    jest.spyOn(console, 'error').mockImplementation(() => {});
+    jest
+      .spyOn(FormatCodeService, 'handleContextMenuInteraction')
+      .mockRejectedValueOnce(new Error('boom'));
+    const interaction = { reply: jest.fn() };
+
+    await formatCodeCommand.execute(interaction);
+
+    expectEphemeralFlags(interaction.reply);
+  });
+
+  it('the opencollective slash command replies with flags when execution fails', async () => {
+    const OpenCollectiveService = require('../opencollective/opencollective.service');
+    const openCollectiveCommand = require('../../bot-commands/slash/opencollective');
+    jest.spyOn(console, 'error').mockImplementation(() => {});
+    jest
+      .spyOn(OpenCollectiveService, 'handleInteraction')
+      .mockRejectedValueOnce(new Error('boom'));
+    const interaction = { reply: jest.fn() };
+
+    await openCollectiveCommand.execute(interaction);
+
+    expectEphemeralFlags(interaction.reply);
+  });
+});
