+
+    #[test]
+    fn positional_hidden_help_omits_help_but_still_parses() {
+        #[derive(FromArgs, PartialEq, Debug)]
+        /// Short description
+        struct Cmd {
+            /// this one should be hidden
+            #[argh(positional, hidden_help)]
+            _one: String,
+            #[argh(positional)]
+            /// this one is real
+            _two: String,
+        }
+
+        let help = match Cmd::from_args(&["test_arg_0"], &["--help"]) {
+            Ok(_) => panic!("help was parsed as positional arguments"),
+            Err(e) => {
+                e.status.expect("help returned an error");
+                e.output
+            }
+        };
+        let usage = help.lines().next().expect("help output has a usage line");
+        assert!(usage.contains("<_two>"));
+        assert!(!usage.contains("_one"));
+        let positional_section = help
+            .split("Positional Arguments:\n")
+            .nth(1)
+            .expect("help has a positional arguments section")
+            .split("\nOptions:")
+            .next()
+            .expect("positional arguments section ends before options");
+        assert!(positional_section.contains("_two"));
+        assert!(!positional_section.contains("_one"));
+
+        let parsed = Cmd::from_args(&["test_arg_0"], &["hidden-value", "visible-value"])
+            .expect("hidden positional argument remains available for parsing");
+        assert_eq!(
+            parsed,
+            Cmd {
+                _one: "hidden-value".to_owned(),
+                _two: "visible-value".to_owned(),
+            }
+        );
+    }
 }
 
 #[test]
