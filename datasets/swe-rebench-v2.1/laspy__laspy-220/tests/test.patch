+class NonSeekableStream:
+    """File-like wrapper that deliberately does not support seeking."""
+
+    def __init__(self, inner):
+        self.inner = inner
+
+    def read(self, n=-1):
+        return self.inner.read(n)
+
+    def seekable(self):
+        return False
+
+
+def assert_same_points(expected, actual):
+    assert len(expected.points) == len(actual.points)
+    for dimension in expected.points.array.dtype.names:
+        assert np.allclose(
+            expected.points[dimension], actual.points[dimension]
+        ), f"{dimension} not equal"
+
+
+@pytest.mark.parametrize("file_path", [
+    SIMPLE_LAS_FILE_PATH,
+    VEGETATION1_3_LAS_FILE_PATH,
+    TEST1_4_LAS_FILE_PATH,
+    EXTRA_BYTES_LAS_FILE_PATH,
+])
+def test_read_non_seekable_las(file_path):
+    expected = laspy.read(file_path)
+    with open(file_path, "rb") as raw_file:
+        actual = laspy.read(NonSeekableStream(raw_file), closefd=False)
+    assert_same_points(expected, actual)
+
+
