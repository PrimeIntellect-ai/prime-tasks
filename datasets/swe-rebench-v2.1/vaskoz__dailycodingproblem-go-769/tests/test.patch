+package day381
+
+import "testing"
+
+// nolint
+var testcases = []struct {
+	hexs     string
+	expected string
+}{
+	{"deadbeef", "3q2+7w=="},
+	{"", ""},
+	{"00", "AA=="},
+	{"01ff", "Af8="},
+	{"48656C6C6F", "SGVsbG8="},
+	{"00010203", "AAECAw=="},
+}
+
+func TestBase64Delegate(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range testcases {
+		if result := Base64Delegate(tc.hexs); result != tc.expected {
+			t.Errorf("Base64Delegate(%q) = %q, want %q", tc.hexs, result, tc.expected)
+		}
+	}
+}
+
+func BenchmarkBase64Delegate(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			Base64Delegate(tc.hexs)
+		}
+	}
+}
