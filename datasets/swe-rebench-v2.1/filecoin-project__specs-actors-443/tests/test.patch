+// Threshold parameter fields have used both signed and unsigned integer types.
+// Populate the public parameter struct in its declared type so the behavioral
+// checks work with either representation.
+func setIntegerField(target interface{}, name string, value interface{}) {
+	field := reflect.ValueOf(target).Elem().FieldByName(name)
+	input := reflect.ValueOf(value)
+	field.Set(input.Convert(field.Type()))
+}
+
+func assertThresholdEqual(t *testing.T, expected, actual interface{}) {
+	t.Helper()
+	toUint64 := func(value interface{}) uint64 {
+		v := reflect.ValueOf(value)
+		switch v.Kind() {
+		case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+			return uint64(v.Int())
+		default:
+			return v.Uint()
+		}
+	}
+	assert.Equal(t, toUint64(expected), toUint64(actual))
+}
