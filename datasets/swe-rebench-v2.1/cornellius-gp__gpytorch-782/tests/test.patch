 import torch
 import unittest
+
+import gpytorch
+from gpytorch.distributions import MultivariateNormal
 from gpytorch.kernels import RBFKernel, ScaleKernel
+from gpytorch.likelihoods import GaussianLikelihood
+from gpytorch.means import ConstantMean
+from gpytorch.test.base_kernel_test_case import BaseKernelTestCase
+
+
+class BatchExactGP(gpytorch.models.ExactGP):
+    def __init__(self, train_inputs, train_targets, likelihood, batch_shape=torch.Size()):
+        super(BatchExactGP, self).__init__(train_inputs, train_targets, likelihood)
+        self.mean_module = ConstantMean(batch_shape=batch_shape)
+        self.covar_module = ScaleKernel(RBFKernel(), batch_shape=batch_shape)
+
+    def forward(self, x):
+        return MultivariateNormal(self.mean_module(x), self.covar_module(x))
+
 
+class TestScaleKernel(BaseKernelTestCase, unittest.TestCase):
+    def create_kernel_no_ard(self, **kwargs):
+        base_kernel = RBFKernel()
+        kernel = ScaleKernel(base_kernel, **kwargs)
+        return kernel
+
+    def create_kernel_ard(self, num_dims, **kwargs):
+        base_kernel = RBFKernel(ard_num_dims=num_dims)
+        kernel = ScaleKernel(base_kernel, **kwargs)
+        return kernel
 
