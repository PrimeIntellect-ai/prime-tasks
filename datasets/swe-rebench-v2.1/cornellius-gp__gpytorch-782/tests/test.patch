+    def test_batch_indexing_lazy_covariance_matrix(self):
+        torch.manual_seed(0)
+        train_x = torch.randn(2, 10, 1)
+        train_y = torch.randn(2, 10)
+        likelihood = GaussianLikelihood(batch_shape=torch.Size([2]))
+        model = BatchExactGP(train_x, train_y, likelihood, batch_shape=torch.Size([2]))
+        model.train()
+        likelihood.train()
+
+        mvn = model(train_x)
+        lazy_covar = mvn.lazy_covariance_matrix
+        self.assertEqual(lazy_covar.shape, torch.Size([2, 10, 10]))
+
+        indexed = lazy_covar[0, :, :]
+        self.assertEqual(indexed.shape, torch.Size([10, 10]))
+
+        full = lazy_covar.evaluate()
