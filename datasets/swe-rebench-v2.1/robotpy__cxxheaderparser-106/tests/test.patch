+def test_deleted_function() -> None:
+    content = """
+      void trim(std::string&&) = delete;
+    """
+    data = parse_string(content, cleandoc=True)
+
+    assert data == ParsedData(
+        namespace=NamespaceScope(
+            functions=[
+                Function(
+                    return_type=Type(
+                        typename=PQName(segments=[FundamentalSpecifier(name="void")])
+                    ),
+                    name=PQName(segments=[NameSpecifier(name="trim")]),
+                    parameters=[
+                        Parameter(
+                            type=MoveReference(
+                                moveref_to=Type(
+                                    typename=PQName(
+                                        segments=[
+                                            NameSpecifier(name="std"),
+                                            NameSpecifier(name="string"),
+                                        ]
+                                    )
+                                )
+                            )
+                        )
+                    ],
+                    deleted=True,
+                )
+            ]
+        )
+    )
+
+
+def test_function_deleted_defaults_to_false() -> None:
+    function = Function(
+        return_type=None,
+        name=PQName(segments=[NameSpecifier(name="fn")]),
+        parameters=[],
+    )
+
+    assert function.deleted is False
