+class GeneratedNameCommandTest(TempFolderTest):
+    """
+    Tests that the command line option ``--generated-names`` treats files whose
+    name matches the supplied patterns as generated.
+    """
+
+    def test_can_detect_generated_name_from_command_line(self):
+        generated_path = self.create_temp_file("custom.generated", ["print('hello')"])
+        cloc_xml_path = os.path.join(self.tests_temp_folder, "cloc.xml")
+        exit_code = command.pygount_command(
+            ["--generated-names", "*.generated", "--format", "cloc-xml", "--out", cloc_xml_path, generated_path]
+        )
+        assert exit_code == 0
+        cloc_xml_root = ElementTree.parse(cloc_xml_path)
+        file_elements = cloc_xml_root.findall("files/file[@language='__generated__']")
+        assert len(file_elements) == 1
+
+    def test_can_detect_default_generated_name_from_command_line(self):
+        generated_names = [
+            "Cargo.lock",
+            "custom.lock",
+            "some.g.dart",
+            "go.sum",
+            "package-lock.json",
+            "npm-shrinkwrap.json",
+            "pnpm-lock.yaml",
+        ]
+        for generated_name in generated_names:
+            generated_path = self.create_temp_file(generated_name, ["print('hello')"])
+            cloc_xml_path = os.path.join(self.tests_temp_folder, "cloc.xml")
+            exit_code = command.pygount_command(["--format", "cloc-xml", "--out", cloc_xml_path, generated_path])
+            assert exit_code == 0, generated_name
+            cloc_xml_root = ElementTree.parse(cloc_xml_path)
+            file_elements = cloc_xml_root.findall("files/file[@language='__generated__']")
+            assert len(file_elements) == 1, generated_name
+
