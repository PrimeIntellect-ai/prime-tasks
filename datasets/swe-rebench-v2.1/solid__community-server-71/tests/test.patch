diff --git a/test/unit/init/RuntimeConfig.test.ts b/test/unit/init/RuntimeConfig.test.ts
new file mode 100644
index 0000000..d3c9db0
--- /dev/null
+++ b/test/unit/init/RuntimeConfig.test.ts
@@ -0,0 +1,126 @@
+import { execFileSync, spawn } from 'child_process';
+import { mkdtempSync, rmdirSync } from 'fs';
+import { tmpdir } from 'os';
+import { join } from 'path';
+import { RuntimeConfig, RuntimeConfigData } from '../../../src/init/RuntimeConfig';
+
+describe('RuntimeConfig', (): void => {
+  it('handles undefined args.', async(): Promise<void> => {
+    const config = new RuntimeConfig();
+    expect(config.port).toEqual(3000);
+    expect(config.base).toEqual('http://localhost:3000/');
+  });
+
+  it('handles empty args.', async(): Promise<void> => {
+    const config = new RuntimeConfig({});
+    expect(config.port).toEqual(3000);
+    expect(config.base).toEqual('http://localhost:3000/');
+  });
+
+  it('handles args with port.', async(): Promise<void> => {
+    const config = new RuntimeConfig({ port: 1234 });
+    expect(config.port).toEqual(1234);
+    expect(config.base).toEqual('http://localhost:1234/');
+  });
+
+  it('handles args with base.', async(): Promise<void> => {
+    const config = new RuntimeConfig({ base: 'http://example.org/' });
+    expect(config.port).toEqual(3000);
+    expect(config.base).toEqual('http://example.org/');
+  });
+
+  it('handles args with port and base.', async(): Promise<void> => {
+    const config = new RuntimeConfig({ port: 1234, base: 'http://example.org/' });
+    expect(config.port).toEqual(1234);
+    expect(config.base).toEqual('http://example.org/');
+  });
+
+  it('handles args with rootFilepath.', async(): Promise<void> => {
+    const config = new RuntimeConfig({ rootFilepath: '/foo/bar/' });
+    expect(config.rootFilepath).toEqual('/foo/bar/');
+  });
+
+  it('accepts a RuntimeConfigData object.', async(): Promise<void> => {
+    const data: RuntimeConfigData = { port: 1234, base: 'http://example.org/', rootFilepath: '/foo/bar/' };
+    const config = new RuntimeConfig(data);
+    expect(config.port).toEqual(1234);
+    expect(config.base).toEqual('http://example.org/');
+    expect(config.rootFilepath).toEqual('/foo/bar/');
+  });
+
+  it('handles resetting data.', async(): Promise<void> => {
+    const config = new RuntimeConfig({});
+    expect(config.port).toEqual(3000);
+    expect(config.base).toEqual('http://localhost:3000/');
+
+    config.reset({ port: 1234, base: 'http://example.org/' });
+    expect(config.port).toEqual(1234);
+    expect(config.base).toEqual('http://example.org/');
+  });
+
+  it('handles resetting the rootFilepath.', async(): Promise<void> => {
+    const config = new RuntimeConfig({ rootFilepath: '/foo/bar/' });
+    expect(config.rootFilepath).toEqual('/foo/bar/');
+
+    config.reset({ rootFilepath: '/other/path/' });
+    expect(config.rootFilepath).toEqual('/other/path/');
+  });
+});
+
+
+describe('CLI runtime configuration', (): void => {
+  it('uses a supplied port to construct the runtime base URL.', async(): Promise<void> => {
+    const outputDirectory = mkdtempSync(join(tmpdir(), 'community-server-cli-'));
+    let child: ReturnType<typeof spawn> | undefined;
+
+    try {
+      execFileSync('node_modules/.bin/tsc', [
+        '--module', 'commonjs',
+        '--target', 'es2017',
+        '--esModuleInterop',
+        '--strict',
+        '--noUnusedLocals',
+        '--skipLibCheck',
+        '--outDir', outputDirectory,
+        'bin/server.ts',
+      ], { cwd: process.cwd() });
+
+      const port = 40000 + Math.floor(Math.random() * 20000);
+      child = spawn(process.execPath, [ join(outputDirectory, 'bin/server.js'), '--port', String(port) ], {
+        cwd: process.cwd(),
+        env: { ...process.env, NODE_PATH: join(process.cwd(), 'node_modules') },
+      });
+      let output = '';
+      let errors = '';
+
+      await new Promise<void>((resolve, reject): void => {
+        const timeout = setTimeout((): void => reject(new Error(`CLI did not start: ${errors}`)), 10000);
+        child!.stdout!.on('data', (data: Buffer): void => {
+          output += data.toString();
+          if (output.includes('Running at ')) {
+            clearTimeout(timeout);
+            resolve();
+          }
+        });
+        child!.stderr!.on('data', (data: Buffer): void => {
+          errors += data.toString();
+        });
+        child!.on('error', (error: Error): void => {
+          clearTimeout(timeout);
+          reject(error);
+        });
+        child!.on('exit', (code: number | null): void => {
+          if (!output.includes('Running at ')) {
+            clearTimeout(timeout);
+            reject(new Error(`CLI stopped before starting (${code}): ${errors}`));
+          }
+        });
+      });
+
+      expect(output).toContain(`Running at http://localhost:${port}/`);
+    } finally {
+      child?.kill();
+      rmdirSync(outputDirectory, { recursive: true });
+    }
+  });
+});
