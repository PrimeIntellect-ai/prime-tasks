@@ -2180,3 +2180,58 @@ async def test_no_body_for_1xx_204_304_responses(
     assert TRANSFER_ENCODING not in resp.headers
     await resp.read() == b""
     resp.release()
+
+
+async def test_keepalive_race_condition(
+    aiohttp_server: Any, aiohttp_client: Any
+) -> None:
+    """A request arriving as the keepalive timer fires must not be dropped.
+
+    The server must not close a connection that has just received a new
+    request, even when the keepalive timeout expires at the same moment.
+    """
+    loop = asyncio.get_running_loop()
+    fake_now = [loop.time()]
+
+    def fake_time() -> float:
+        return fake_now[0]
+
+    async def handler(request: web.Request) -> web.Response:
+        return web.Response()
+
+    app = web.Application()
+    app.router.add_get("/", handler)
+    server = await aiohttp_server(app, keepalive_timeout=1.0)
+    client = await aiohttp_client(server)
+
+    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    sock.setblocking(False)
+    try:
+        await loop.sock_connect(sock, ("127.0.0.1", client.port))
+
+        async def read_response() -> bytes:
+            data = b""
+            while b"\r\n\r\n" not in data:
+                chunk = await loop.sock_recv(sock, 4096)
+                if not chunk:
+                    break
+                data += chunk
+            return data
+
+        with mock.patch.object(loop, "time", fake_time):
+            # First request establishes a keepalive connection.
+            await loop.sock_sendall(sock, b"GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
+            assert b"200 OK" in await read_response()
+
+            # The keepalive timer is now scheduled at fake_now + 1.0.  Advance
+            # the clock and send the second request within the same loop
+            # iteration, so the keepalive callback runs after data_received()
+            # has queued the request but before start() resumes from the waiter.
+            def trigger() -> None:
+                fake_now[0] += 2.0
+                sock.sendall(b"GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
+
+            loop.call_soon(trigger)
+            assert b"200 OK" in await read_response()
+    finally:
+        sock.close()
