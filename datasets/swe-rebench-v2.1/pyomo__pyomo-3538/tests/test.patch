+    def test_invalid_exception_argument(self):
+        m = ConcreteModel()
+        m.p = Param(initialize=7, mutable=True)
+        m.indexed = Param([1, 2], initialize={1: 3, 2: 4}, mutable=True)
+        with self.assertRaisesRegex(
+            ValueError,
+            r"Param 'p' was called with a non-bool argument for 'exception': "
+            r"p \+ 2",
+        ):
+            m.p(m.p + 2)
+
+        with self.assertRaisesRegex(
+            ValueError,
+            r"Param 'indexed\[1\]' was called with a non-bool argument for "
+            r"'exception': 3.2",
+        ):
+            m.indexed[1](3.2)
+
+    def test_param_called_with_var_in_constraint(self):
+        m = ConcreteModel()
+        m.t = Set(initialize=[0, 1, 2])
+        m.x = Param(initialize=0.5, mutable=True)
+        m.y = Var(m.t, initialize=0)
+
+        def const_1(m, t):
+            return m.y[t] == m.x(m.y[t])
+
+        with self.assertRaises(ValueError):
+            m.const_1 = Constraint(m.t, rule=const_1)
+
 
