+describe("getPhase", () => {
+  test("returns a generic phase object when cycle information is missing", () => {
+    // @ts-expect-error mocked `t` method
+    jest.spyOn(i18n, "t").mockImplementation((key) => key);
+    const result = getPhase(0, 0, 0);
+    expect(result.title).toEqual(expect.any(String));
+    expect(result.description).toEqual(expect.any(String));
+    expect(Array.isArray(result.symptoms)).toBe(true);
+    expect(result.symptoms.every((symptom) => typeof symptom === "string")).toBe(
+      true,
+    );
+  });
+
+  test("selects each phase across its cycle-day boundaries", () => {
+    // @ts-expect-error mocked `t` method
+    jest.spyOn(i18n, "t").mockImplementation((key) => key);
+    const menstrual = getPhase(28, 5, 5);
+    const firstFollicularDay = getPhase(28, 5, 6);
+    const lastFollicularDay = getPhase(28, 5, 11);
+    const firstOvulationDay = getPhase(28, 5, 12);
+    const lastOvulationDay = getPhase(28, 5, 14);
+    const firstLutealDay = getPhase(28, 5, 15);
+    const representativePhases = [
+      getPhase(28, 5, 1),
+      getPhase(28, 5, 7),
+      getPhase(28, 5, 14),
+      getPhase(28, 5, 21),
+    ];
+
+    [...representativePhases, menstrual, firstFollicularDay, lastFollicularDay,
+      firstOvulationDay, lastOvulationDay, firstLutealDay].forEach((result) => {
+      expect(result.title).toEqual(expect.any(String));
+      expect(result.description).toEqual(expect.any(String));
+      expect(Array.isArray(result.symptoms)).toBe(true);
+      expect(result.symptoms.every((symptom) => typeof symptom === "string")).toBe(
+        true,
+      );
+    });
+    expect(new Set(representativePhases.map((phase) => phase.title)).size).toBe(4);
+    expect(menstrual.title).toBe(representativePhases[0].title);
+    expect(firstFollicularDay.title).toBe(lastFollicularDay.title);
+    expect(firstFollicularDay.title).toBe(representativePhases[1].title);
+    expect(firstOvulationDay.title).toBe(lastOvulationDay.title);
+    expect(firstOvulationDay.title).toBe(representativePhases[2].title);
+    expect(firstLutealDay.title).toBe(representativePhases[3].title);
+  });
+});
+
+describe("cycle information hooks", () => {
+  test("expose the calculation module results for the current cycles", () => {
+    const cycles: Cycle[] = [
+      { cycleLength: 99, periodLength: 8, startDate: "2024-01-01" },
+      { cycleLength: 28, periodLength: 4, startDate: "2024-03-02" },
+      { cycleLength: 30, periodLength: 6, startDate: "2024-02-01" },
+    ];
+    const wrapper = ({ children }: { children: React.ReactNode }) =>
+      React.createElement(
+        CyclesContext.Provider,
+        { value: { cycles, updateCycles: () => {} } },
+        children,
+      );
+
+    jest.useFakeTimers();
+    jest.setSystemTime(new Date("2024-03-15T12:00:00.000Z"));
+    try {
+      expect(renderHook(() => useDayOfCycle(), { wrapper }).result.current).toBe(
+        getDayOfCycle(cycles[0].startDate),
+      );
+      expect(
+        renderHook(() => useAverageLengthOfCycle(), { wrapper }).result.current,
+      ).toBe(getAverageLengthOfCycle(cycles));
+      expect(
+        renderHook(() => useAverageLengthOfPeriod(), { wrapper }).result.current,
+      ).toBe(getAverageLengthOfPeriod(cycles));
+    } finally {
+      jest.useRealTimers();
+    }
+  });
+});
