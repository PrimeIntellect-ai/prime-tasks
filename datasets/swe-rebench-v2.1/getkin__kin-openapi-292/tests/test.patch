+package openapi3
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestIssue289(t *testing.T) {
+	spec := []byte(`components:
+  schemas:
+    Server:
+      properties:
+        address:
+          oneOf:
+          - $ref: "#/components/schemas/ip-address"
+          - $ref: "#/components/schemas/domain-name"
+        name:
+          type: string
+      type: object
+    domain-name:
+      maxLength: 10
+      minLength: 5
+      pattern: "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\."
+      type: string
+    ip-address:
+      pattern: "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$"
+      type: string
+openapi: "3.0.1"
+`)
+
+	s, err := NewSwaggerLoader().LoadSwaggerFromData(spec)
+	require.NoError(t, err)
+	server := s.Components.Schemas["Server"].Value
+
+	conflictErr := server.VisitJSON(map[string]interface{}{
+		"name":    "kin-openapi",
+		"address": "127.0.0.1",
+	})
+	require.EqualError(t, conflictErr, "input matches more than one oneOf schemas")
+	pointerErr, ok := conflictErr.(interface {
+		JSONPointer() []string
+	})
+	require.True(t, ok)
+	require.Equal(t, []string{"address"}, pointerErr.JSONPointer())
+
+	noMatchErr := server.VisitJSON(map[string]interface{}{
+		"name":    "kin-openapi",
+		"address": "x",
+	})
+	require.Error(t, noMatchErr)
+	require.NotEqual(t, noMatchErr.Error(), conflictErr.Error())
+}
