+func TestConfigAuditReportCRD_DisplaysPassCount(t *testing.T) {
+	var passColumnJSONPath string
+	for _, column := range v1alpha1.ConfigAuditReportCRD.Spec.AdditionalPrinterColumns {
+		if strings.EqualFold(column.Name, "Pass") {
+			passColumnJSONPath = column.JSONPath
+			break
+		}
+	}
+	assert.Equal(t, ".report.summary.passCount", passColumnJSONPath,
+		"ConfigAuditReport CRD must expose a Pass printer column reading .report.summary.passCount")
+}
+
+func TestConfigAuditSummary_JSONPassCount(t *testing.T) {
+	summaryType := reflect.TypeOf(v1alpha1.ConfigAuditSummary{})
+	field, found := summaryType.FieldByName("PassCount")
+	require.True(t, found, "ConfigAuditSummary must expose PassCount")
+	assert.Equal(t, reflect.TypeOf(0), field.Type)
+
+	summaryValue := reflect.New(summaryType).Elem()
+	summaryValue.FieldByName("PassCount").SetInt(7)
+	data, err := json.Marshal(summaryValue.Interface())
+	require.NoError(t, err)
+
+	var serialized map[string]int
+	require.NoError(t, json.Unmarshal(data, &serialized))
+	assert.Equal(t, 7, serialized["passCount"])
+}
