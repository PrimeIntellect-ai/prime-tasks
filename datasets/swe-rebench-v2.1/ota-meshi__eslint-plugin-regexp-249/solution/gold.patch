+                    propName === "match" ||
+                    propName === "matchAll" ||
+                    propName === "split" ||
+                    propName === "replace" ||
+                    propName === "replaceAll" ||
+                    propName === "search"
+                ) {
+                    yield UsageOfPattern.whole
+                } else {
+                    yield UsageOfPattern.unknown
+                }
+            } else {
+                yield UsageOfPattern.unknown
+            }
         } else {
             yield UsageOfPattern.unknown
         }
