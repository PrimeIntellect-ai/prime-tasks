diff --git a/logger_test.go b/logger_test.go
index dea7013..f2ea958 100644
--- a/logger_test.go
+++ b/logger_test.go
@@ -1232,6 +1232,61 @@ func TestLogger_JSON(t *testing.T) {
 		assert.Equal(t, "[INFO]  test: who=programmer why=testing\n", rest)
 	})
 
+	t.Run("disable json escape when log special character", func(t *testing.T) {
+		var buf bytes.Buffer
+
+		logger := New(&LoggerOptions{
+			Name:               "test",
+			Output:             &buf,
+			JSONFormat:         true,
+			JSONEscapeDisabled: true,
+		})
+
+		logger.Info("this is test and use > < &")
+
+		b := buf.Bytes()
+
+		var raw map[string]interface{}
+		if err := json.Unmarshal(b, &raw); err != nil {
+			t.Fatal(err)
+		}
+
+		assert.Equal(t, "this is test and use > < &", raw["@message"])
+
+		out := buf.String()
+		assert.Contains(t, out, "this is test and use > < &")
+		assert.NotContains(t, out, `\u003e`)
+		assert.NotContains(t, out, `\u003c`)
+		assert.NotContains(t, out, `\u0026`)
+	})
+
+	t.Run("escape json by default when log special character", func(t *testing.T) {
+		var buf bytes.Buffer
+
+		logger := New(&LoggerOptions{
+			Name:       "test",
+			Output:     &buf,
+			JSONFormat: true,
+		})
+
+		logger.Info("this is test and use > < &")
+
+		b := buf.Bytes()
+
+		var raw map[string]interface{}
+		if err := json.Unmarshal(b, &raw); err != nil {
+			t.Fatal(err)
+		}
+
+		assert.Equal(t, "this is test and use > < &", raw["@message"])
+
+		out := buf.String()
+		assert.NotContains(t, out, "> < &")
+		assert.Contains(t, out, `\u003e`)
+		assert.Contains(t, out, `\u003c`)
+		assert.Contains(t, out, `\u0026`)
+	})
+
 }
 
 type customErrJSON struct {
