+
+test(
+  integrationTest(
+    'Query parameters are preserved when switching fetch structure modes',
+  ),
+  async () => {
+    const pluginManager = LegendQueryPluginManager.create();
+    pluginManager.usePresets([new Query_GraphPreset()]).install();
+    const mockedQueryStore = TEST__provideMockedLegendQueryStore({
+      pluginManager,
+    });
+    const renderResult = await TEST__setUpQueryEditor(
+      mockedQueryStore,
+      TEST_DATA__ComplexM2MModel,
+      RawLambda.createStub(),
+      'model::MyMapping',
+      'model::MyRuntime',
+    );
+    const queryBuilderState = mockedQueryStore.queryBuilderState;
+    const parameter = QueryParameterState.createDefault(
+      queryBuilderState.queryParametersState,
+    );
+    parameter.parameter.name = 'businessDate';
+    queryBuilderState.queryParametersState.addParameter(parameter);
+
+    const getParameterDetails = () =>
+      queryBuilderState.queryParametersState.parameters.map((entry) => ({
+        name: entry.variableName,
+        type: entry.variableType?.name,
+        lowerBound: entry.parameter.multiplicity.lowerBound,
+        upperBound: entry.parameter.multiplicity.upperBound,
+        values: entry.values,
+      }));
+    const parametersBeforeSwitch = getParameterDetails();
+    expect(parametersBeforeSwitch).toEqual([
+      {
+        name: 'businessDate',
+        type: 'String',
+        lowerBound: 1,
+        upperBound: 1,
+        values: undefined,
+      },
+    ]);
+
+    fireEvent.click(renderResult.getByText('Graph Fetch'));
+    await waitFor(() =>
+      expect(queryBuilderState.fetchStructureState.fetchStructureMode).toBe(
+        FETCH_STRUCTURE_MODE.GRAPH_FETCH,
+      ),
+    );
+    expect(getParameterDetails()).toEqual(parametersBeforeSwitch);
+
+    fireEvent.click(renderResult.getByText('Projection'));
+    await waitFor(() =>
+      expect(queryBuilderState.fetchStructureState.fetchStructureMode).toBe(
+        FETCH_STRUCTURE_MODE.PROJECTION,
+      ),
+    );
+    expect(getParameterDetails()).toEqual(parametersBeforeSwitch);
+  },
+);
