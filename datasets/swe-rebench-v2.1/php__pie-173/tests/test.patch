+<?php
+
+declare(strict_types=1);
+
+namespace Php\PieUnitTest\ComposerIntegration;
+
+use Composer\Package\CompletePackage;
+use Composer\Util\Filesystem;
+use Php\Pie\BinaryFile;
+use Php\Pie\Building\Build;
+use Php\Pie\Command\InstallCommand;
+use Php\Pie\ComposerIntegration\InstalledJsonMetadata;
+use Php\Pie\Container;
+use Php\Pie\Installing\Install;
+use Php\Pie\Platform;
+use Php\Pie\Platform\TargetPhp\PhpBinaryPath;
+use Php\Pie\Platform\TargetPlatform;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\TestCase;
+use Symfony\Component\Console\Tester\CommandTester;
+
+use function array_column;
+use function file_get_contents;
+use function file_put_contents;
+use function getenv;
+use function json_decode;
+use function json_encode;
+use function mkdir;
+use function sys_get_temp_dir;
+use function uniqid;
+use function putenv;
+
+use const DIRECTORY_SEPARATOR;
+use const JSON_THROW_ON_ERROR;
+
+#[CoversClass(InstallCommand::class)]
+final class VendorCleanupTest extends TestCase
+{
+    public function testSuccessfulPieInstallCleansItsWorkingVendorDirectory(): void
+    {
+        $filesystem = new Filesystem();
+        $temporaryRoot = sys_get_temp_dir() . DIRECTORY_SEPARATOR . 'pie-post-install-cleanup-' . uniqid('', true);
+        mkdir($temporaryRoot);
+        $oldWorkingDirectory = getenv('PIE_WORKING_DIRECTORY');
+        putenv('PIE_WORKING_DIRECTORY=' . $temporaryRoot);
+
+        try {
+            $packageSource = $temporaryRoot . DIRECTORY_SEPARATOR . 'package';
+            mkdir($packageSource);
+            file_put_contents(
+                $packageSource . DIRECTORY_SEPARATOR . 'composer.json',
+                '{"name":"test/extension","version":"1.0.0","type":"php-ext","extra":{"php-ext":{"extension-name":"testext"}}}',
+            );
+            file_put_contents($packageSource . DIRECTORY_SEPARATOR . 'source.txt', 'package source');
+
+            $targetPlatform = TargetPlatform::fromPhpBinaryPath(PhpBinaryPath::fromCurrentProcess(), 1);
+            mkdir(Platform::getPieWorkingDirectory($targetPlatform), recursive: true);
+            $vendorDir = $temporaryRoot . DIRECTORY_SEPARATOR . 'vendor';
+            file_put_contents(
+                Platform::getPieJsonFilename($targetPlatform),
+                json_encode(
+                    [
+                        'repositories' => [['type' => 'path', 'url' => $packageSource]],
+                        'config' => ['vendor-dir' => $vendorDir],
+                    ],
+                    JSON_THROW_ON_ERROR,
+                ),
+            );
+
+            $container = Container::factory();
+            $build = $this->createMock(Build::class);
+            $build->method('__invoke')->willReturn(new BinaryFile('/tmp/built-extension.so', 'checksum'));
+            $install = $this->createMock(Install::class);
+            $install->method('__invoke')->willReturn(new BinaryFile('/tmp/installed-extension.so', 'checksum'));
+            $container->instance(Build::class, $build);
+            $container->instance(Install::class, $install);
+            $container->instance(InstalledJsonMetadata::class, $this->createMock(InstalledJsonMetadata::class));
+
+            $commandTester = new CommandTester($container->get(InstallCommand::class));
+            $commandTester->execute([
+                'requested-package-and-version' => 'test/extension:1.0.0',
+                '--skip-enable-extension' => true,
+            ]);
+            $commandTester->assertCommandIsSuccessful();
+
+            self::assertFileDoesNotExist($vendorDir . DIRECTORY_SEPARATOR . 'test' . DIRECTORY_SEPARATOR . 'extension' . DIRECTORY_SEPARATOR . 'source.txt');
+            $installedJsonPath = $vendorDir . DIRECTORY_SEPARATOR . 'composer' . DIRECTORY_SEPARATOR . 'installed.json';
+            self::assertFileExists($installedJsonPath);
+            $installedJson = json_decode(
+                file_get_contents($installedJsonPath),
+                true,
+                flags: JSON_THROW_ON_ERROR,
+            );
+            self::assertContains('test/extension', array_column($installedJson['packages'], 'name'));
+        } finally {
+            $filesystem->removeDirectory($temporaryRoot);
+            if ($oldWorkingDirectory === false) {
+                putenv('PIE_WORKING_DIRECTORY');
+            } else {
+                putenv('PIE_WORKING_DIRECTORY=' . $oldWorkingDirectory);
+            }
+        }
+    }
+
+}
