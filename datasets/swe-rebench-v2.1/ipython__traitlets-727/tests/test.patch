+def test_logging_teardown_on_error(capsys):
+    """Destroying an application that has not configured logging is harmless."""
+    app = Application()
+    del app
+    _, err = capsys.readouterr()
+    assert "Traceback" not in err
+
+
+def test_close_handlers_before_logging_configuration_does_nothing():
+    app = Application()
+    logger = logging.getLogger("test_close_handlers_before_logging_configuration")
+    handler = logging.Handler()
+    closed = []
+    handler.close = lambda: closed.append(True)
+    logger.addHandler(handler)
+    app.log = logger
+
+    app.close_handlers()
+
+    assert closed == []
+    logger.removeHandler(handler)
+
+
+def test_configured_logging_closes_handlers_and_tolerates_close_errors():
+    """Real logging setup enables cleanup, including after a handler fails."""
+    app = Application()
+    app.log  # Trigger the application's normal logging configuration.
+
+    original_handlers = app.log.handlers[:]
+    close_attempts = []
+    failing_handler = logging.Handler()
+    healthy_handler = logging.Handler()
+    failing_close = failing_handler.close
+    healthy_close = healthy_handler.close
+
+    def fail_to_close():
+        close_attempts.append("failing")
+        raise RuntimeError("handler close failed")
+
+    failing_handler.close = fail_to_close
+    healthy_handler.close = lambda: close_attempts.append("healthy")
+    app.log.handlers[:] = [failing_handler, healthy_handler]
+
+    app.close_handlers()
+    app.close_handlers()
+    failing_handler.close = failing_close
+    healthy_handler.close = healthy_close
+    app.log.handlers[:] = original_handlers
+
+    assert sorted(close_attempts) == ["failing", "healthy"]
+
+
 if __name__ == "__main__":
