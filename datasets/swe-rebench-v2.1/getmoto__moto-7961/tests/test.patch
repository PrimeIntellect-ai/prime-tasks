+def test_implementation_coverage_recognizes_alias_operations():
+    # The implementation-coverage script decides whether an operation is
+    # implemented by looking it up on the service backend. The KMS alias
+    # operations must therefore be reported as implemented.
+    import importlib.util
+    from pathlib import Path
+
+    script = (
+        Path(__file__).resolve().parents[2] / "scripts" / "implementation_coverage.py"
     )
+    spec = importlib.util.spec_from_file_location("implementation_coverage", script)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
 
-    assert ciphertext is not None
-    assert arn == key.arn
+    coverage = module.calculate_extended_implementation_coverage()
+
+    implemented = coverage["kms"]["implemented"]
