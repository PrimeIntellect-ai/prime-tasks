+// evalInput parses and evaluates the given source, returning the resulting
+// object.
+func evalInput(input string) object.Object {
+	l := lexer.New(input)
+	p := parser.New(l)
+	program := p.ParseProgram()
+	env := object.NewEnvironment()
+	return evaluator.Eval(program, env)
+}
+
+// TestRegexpMatch ensures that a regular-expression literal can be matched
+// against a string with the "~=" operator, including the example from the
+// problem statement.
+func TestRegexpMatch(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected bool
+	}{
+		{`"Steve" ~= /steve/i`, true},
+		{`"Steve" ~= /bob/i`, false},
+		{`"Steve" ~= /steve/`, false},
+		{`if ( "Steve" ~= /steve/i ) { true } else { false }`, true},
+	}
+	for _, tt := range tests {
+		evaluated := evalInput(tt.input)
+		result, ok := evaluated.(*object.Boolean)
+		if !ok {
+			t.Fatalf("input %q did not evaluate to a boolean, got=%T(%+v)", tt.input, evaluated, evaluated)
+		}
+		if result.Value != tt.expected {
+			t.Fatalf("input %q evaluated to %v, want %v", tt.input, result.Value, tt.expected)
+		}
+	}
+}
+
+// TestRegexpType ensures that a regular-expression literal has its own
+// distinct type, reported as "regexp" by the type builtin.
+func TestRegexpType(t *testing.T) {
+	evaluated := evalInput(`type( /foo/ )`)
+	result, ok := evaluated.(*object.String)
+	if !ok {
+		t.Fatalf("type(/foo/) did not evaluate to a string, got=%T(%+v)", evaluated, evaluated)
+	}
+	if result.Value != "regexp" {
+		t.Fatalf("type(/foo/) returned %q, want %q", result.Value, "regexp")
+	}
+}
