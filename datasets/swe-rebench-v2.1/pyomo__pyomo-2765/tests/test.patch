+    def test_index_by_list_constraint_add(self):
+        m = ConcreteModel()
+        m.set1 = Set(initialize=[1, 2])
+        m.set2 = Set(initialize=[1, 2])
+        m.pairs = Set(initialize=[(i, j) for i in m.set1 for j in m.set2])
+        m.x = Var(m.pairs)
+        def rule(m, i, j):
+            return m.x[i, j] >= 1
+        m.c = Constraint(m.pairs, rule=rule)
+        # Adding a constraint with a list-form index must not fail
+        m.c.add(expr=rule(m, 1, 2), index=[1, 2])
+        self.assertIn((1, 2), m.c)
+        self.assertEqual(len(m.c), 4)
