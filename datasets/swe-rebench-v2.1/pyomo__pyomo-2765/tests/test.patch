     def test_index_by_unhashable_type(self):
         m = ConcreteModel()
         m.x = Var([1,2,3], initialize=lambda m,x: 2*x)
+        # Indexing by a dict raises an error
         self.assertRaisesRegex(
             TypeError, '.*',
             m.x.__getitem__, {})
+        # Assigning through a dict index also raises an error
+        self.assertRaisesRegex(
+            TypeError, '.*',
+            m.x.__setitem__, {}, 5)
+        # Indexing by lists works...
+        # ... scalar
+        self.assertIs(m.x[[1]], m.x[1])
+        # ... "tuple"
+        m.y = Var([(1, 1), (1, 2)])
+        self.assertIs(m.y[[1, 1]], m.y[1, 1])
+        m.y[[1, 2]] = 5
+        y12 = m.y[[1, 2]]
+        self.assertEqual(y12.value, 5)
+        m.y[[1, 2]] = 15
+        self.assertIs(y12, m.y[[1, 2]])
+        self.assertEqual(y12.value, 15)
+        # Retrieving an index that is not in the index set raises KeyError
+        with self.assertRaises(KeyError):
+            m.y[[2, 2]]
+        # Assigning to an index that is not in the index set raises KeyError
+        with self.assertRaises(KeyError):
+            m.y[[2, 2]] = 5
