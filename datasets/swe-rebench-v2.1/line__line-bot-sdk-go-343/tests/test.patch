+
+func TestMentioneeMarshalingType(t *testing.T) {
+	data, err := json.Marshal(Mentionee{
+		Index:  0,
+		Length: 4,
+		Type:   MentionedTargetTypeAll,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var got map[string]interface{}
+	if err := json.Unmarshal(data, &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["type"] != string(MentionedTargetTypeAll) {
+		t.Errorf("marshaled mentionee type = %v; want %q", got["type"], MentionedTargetTypeAll)
+	}
+}
