+from contextlib import contextmanager
+from unittest.mock import MagicMock, patch
+
 import pytest
 
-from tests.brokers.confluent.test_security import patch_aio_consumer_and_producer
+
+@contextmanager
+def patch_native_producer():
+    """Capture the configuration handed to the native confluent-kafka Producer."""
+    producer = MagicMock()
+    with patch("faststream.confluent.client.Producer", new=producer):
+        yield producer
+
+
+def _producer_config(producer: MagicMock) -> dict:
+    call = producer.call_args
+    if call.args:
+        return call.args[0]
+    return call.kwargs.get("conf") or call.kwargs.get("config")
 
 
