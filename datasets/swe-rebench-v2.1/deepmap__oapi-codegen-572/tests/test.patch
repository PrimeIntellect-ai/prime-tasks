+// setMultiErrorHandler assigns the MultiErrorHandler option through reflection
+// so that the test can exercise the hook without depending on the field being
+// present at compile time.
+func setMultiErrorHandler(options *Options, handler interface{}) {
+	v := reflect.ValueOf(options).Elem().FieldByName("MultiErrorHandler")
+	if v.IsValid() && v.CanSet() {
+		v.Set(reflect.ValueOf(handler))
+	}
