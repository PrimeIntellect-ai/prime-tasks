+
+func TestNewDecoderFactory_default(t *testing.T) {
+	type NewThing struct {
+		Defaulted    defaultFromSchema `json:"d"`
+		DefaultedTag *defaultFromTag   `json:"dt" default:"all"`
+	}
+
+	service := web.DefaultService()
+	var got NewThing
+	service.Post("/foo", usecase.NewIOI(new(NewThing), new(string), func(_ context.Context, input, output interface{}) error {
+		got = *input.(*NewThing)
+		*output.(*string) = "ok"
+		return nil
+	}))
+
+	rw := httptest.NewRecorder()
+	req, err := http.NewRequest(http.MethodPost, "/foo", bytes.NewReader([]byte(`{}`)))
+	require.NoError(t, err)
+	req.Header.Set("Content-Type", "application/json")
+	service.ServeHTTP(rw, req)
+
+	require.Equal(t, http.StatusOK, rw.Code)
+	assert.Equal(t, enum1, string(got.Defaulted))
+	require.NotNil(t, got.DefaultedTag)
+	assert.Equal(t, enum1, string(*got.DefaultedTag))
+}
