+def test_wait_error_on_timeout(RE):
+    from ophyd import StatusBase
+
+    class Dummy:
+        name = "dummy"
+
+        def set(self, val):
+            self.st = StatusBase()
+            return self.st
+
+    def plan(error_on_timeout):
+        dummy = Dummy()
+        yield Msg("set", dummy, 1, group="test")
+        yield from wait("test", timeout=0.1, error_on_timeout=error_on_timeout)
+
+    # With error_on_timeout=False a timeout lets the plan continue.
+    RE(plan(False))
+
+    # With error_on_timeout=True a timeout raises.
+    with pytest.raises(Exception):
+        RE(plan(True))
+
+
