+  it('border zero - accepts 0 and reports none when the 0 convention is selected', function () {
+    lintFile('border-zero.scss', {
+      'rules': {
+        'zero-unit': 0,
+        'border-zero': [1, { 'convention': '0' }]
+      }
+    }, function (data) {
+      var warnings = data.messages.filter(function (message) {
+        return message.ruleId === 'border-zero';
+      });
+      assert.deepEqual(warnings.map(function (message) {
+        return message.line;
+      }), [6, 14, 22], 'the 0 convention reports none values and accepts zero and nonzero values');
+    });
+  });
+
+  it('border zero - accepts none and reports zero when that convention is selected', function () {
+    lintFile('border-zero.scss', {
+      'rules': {
+        'zero-unit': 0,
+        'border-zero': [1, { 'convention': 'none' }]
+      }
+    }, function (data) {
+      var warnings = data.messages.filter(function (message) {
+        return message.ruleId === 'border-zero';
+      });
+      assert.deepEqual(warnings.map(function (message) {
+        return message.line;
+      }), [2, 10], 'the none convention reports zero values and accepts none and nonzero values');
+    });
