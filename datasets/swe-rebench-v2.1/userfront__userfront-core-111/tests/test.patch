diff --git a/test/singleton.spec.js b/test/singleton.spec.js
new file mode 100644
index 0000000..a30d973
--- /dev/null
+++ b/test/singleton.spec.js
@@ -0,0 +1,36 @@
+import Userfront from "../src/index.js";
+import api from "../src/api.js";
+
+jest.mock("../src/api.js");
+
+describe("Userfront object", () => {
+  beforeAll(() => {
+    Userfront.init("demo1234");
+  });
+
+  it("should expose sendVerificationCode as a function", () => {
+    expect(typeof Userfront.sendVerificationCode).toEqual("function");
+  });
+
+  it("should send a verification code when sendVerificationCode is called", async () => {
+    const mockResponse = {
+      data: { message: "OK", result: { whatever: "response" } },
+    };
+    api.post.mockImplementationOnce(() => mockResponse);
+
+    const res = await Userfront.sendVerificationCode({
+      channel: "email",
+      email: "user@example.com",
+    });
+
+    expect(api.post).toHaveBeenCalledWith(
+      `/auth/code`,
+      expect.objectContaining({
+        channel: "email",
+        email: "user@example.com",
+        tenantId: "demo1234",
+      })
+    );
+    expect(res).toEqual(mockResponse.data);
+  });
+});
