index 1ac00c0..815bad6 100644
--- a/test/fika/compiler/parser/pattern_test.exs
+++ b/test/fika/compiler/parser/pattern_test.exs
@@ -36,4 +36,27 @@ defmodule Fika.Compiler.Parser.PatternTest do
              ]
            } == TestParser.pattern!(str)
   end
+
+  test "record pattern represents its fields and value patterns" do
+    ast = TestParser.pattern!("{foo: \"bar\"}")
+
+    assert contains_value?(ast, :foo) or contains_value?(ast, "foo")
+    assert contains_value?(ast, "bar") or contains_value?(ast, ["bar"])
+  end
+
+  defp contains_value?(term, value) when term == value, do: true
+
+  defp contains_value?(term, value) when is_tuple(term) do
+    term |> Tuple.to_list() |> Enum.any?(&contains_value?(&1, value))
+  end
+
+  defp contains_value?(term, value) when is_list(term) do
+    Enum.any?(term, &contains_value?(&1, value))
+  end
+
+  defp contains_value?(term, value) when is_map(term) do
+    term |> Map.to_list() |> Enum.any?(&contains_value?(&1, value))
+  end
+
+  defp contains_value?(_term, _value), do: false
 end
