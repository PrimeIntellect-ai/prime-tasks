index 62ba88c..7bca4e8 100644
--- a/components/Message/__test__/index.test.tsx
+++ b/components/Message/__test__/index.test.tsx
@@ -1,6 +1,8 @@
 import React from 'react';
 import { mount } from 'enzyme';
+import { act } from 'react-dom/test-utils';
 import Message from '..';
+import Image from '../../Image';
 import Notice from '../../_class/notice';
 import { IconMessage } from '../../../icon';
 import { $ } from '../../../tests/util';
@@ -64,4 +66,31 @@ describe('open message', () => {
       expect($(`.arco-message-wrapper-${position} .arco-message`).length).toBe(1);
     });
   });
+
+  it('controlled current switches image when clicking arrow', () => {
+    const srcList = ['a', 'b', 'c'];
+    const ControlledGroup = () => {
+      const [current, setCurrent] = React.useState(0);
+      return (
+        <Image.PreviewGroup
+          defaultVisible
+          current={current}
+          srcList={srcList}
+          onChange={setCurrent}
+        />
+      );
+    };
+    const wrapper = mount(<ControlledGroup />);
+    jest.runAllTimers();
+    wrapper.update();
+
+    expect(wrapper.find('.arco-image-preview-img').prop('src')).toBe('a');
+
+    act(() => {
+      wrapper.find('.arco-image-preview-arrow-right').simulate('click');
+    });
+    wrapper.update();
+
+    expect(wrapper.find('.arco-image-preview-img').prop('src')).toBe('b');
+  });
 });
