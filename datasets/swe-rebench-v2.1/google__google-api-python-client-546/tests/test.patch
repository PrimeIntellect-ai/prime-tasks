+  def test_media_io_base_download_custom_request_headers(self):
+    self.request.http = HttpMockSequence([
+      ({'status': '200',
+        'content-range': '0-2/5'}, 'echo_request_headers_as_json'),
+      ({'status': '200',
+        'content-range': '3-4/5'}, 'echo_request_headers_as_json'),
+    ])
+    self.assertEqual(True, self.request.http.follow_redirects)
+
+    self.request.headers['Cache-Control'] = 'no-store'
+
+    download = MediaIoBaseDownload(
+        fd=self.fd, request=self.request, chunksize=3)
+
+    status, done = download.next_chunk()
+
+    # The mock echoes the outgoing request headers as the response body, which
+    # the downloader writes to the file. We only assert that the custom header
+    # set on the original request is sent to the server on each call to
+    # next_chunk; the exact range values are not part of the behaviour.
+    result = json.loads(self.fd.getvalue().decode('utf-8'))
+    sent_headers = dict((k.lower(), v) for k, v in result.items())
+    self.assertEqual('no-store', sent_headers.get('cache-control'))
+
+    download._fd = self.fd = BytesIO()
+    status, done = download.next_chunk()
+
+    result = json.loads(self.fd.getvalue().decode('utf-8'))
+    sent_headers = dict((k.lower(), v) for k, v in result.items())
+    self.assertEqual('no-store', sent_headers.get('cache-control'))
