+class HardcodedPasswordFuncArgTests(testtools.TestCase):
+    """Behavioural tests for the B106 hardcoded_password_funcarg check."""
+
+    def _b106_issues(self, code):
+        plugins_dir = os.path.join(os.getcwd(), "bandit", "plugins")
+        b_conf = b_config.BanditConfig()
+        mgr = b_manager.BanditManager(b_conf, "file")
+        mgr.b_conf._settings["plugins_dir"] = plugins_dir
+        mgr.b_ts = b_test_set.BanditTestSet(config=b_conf)
+        with tempfile.TemporaryDirectory() as tmp:
+            fname = os.path.join(tmp, "sample.py")
+            with open(fname, "w") as fh:
+                fh.write(code)
+            mgr.discover_files([fname], True)
+            mgr.run_tests()
+        return [i for i in mgr.get_issue_list() if i.test_id == "B106"]
+
+    def test_no_b106_for_non_string_keyword_value(self):
+        code = (
+            "import cfg\n"
+            "cfg.StrOpt('metadata_proxy_shared_secret',\n"
+            "           default='',\n"
+            "           help='x',\n"
+            "           secret=True)\n"
+            "cfg.StrOpt('nova_metadata_protocol',\n"
+            "           default='http',\n"
+            "           secret=True)\n"
+        )
+        self.assertEqual([], self._b106_issues(code))
+
+    def test_b106_for_string_keyword_value(self):
+        code = "doLogin(password='blerg')\n"
+        self.assertEqual(1, len(self._b106_issues(code)))
