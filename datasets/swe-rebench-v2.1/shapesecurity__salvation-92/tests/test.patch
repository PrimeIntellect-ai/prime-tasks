+    @Test
+    public void testAsciiNonPrintableSourceCharactersGivePercentEncodingGuidance() throws ParseException {
+        for (char invalid : new char[]{'\u007f', '\u0001'}) {
+            try {
+                parse("script-src a" + invalid);
+                fail("an ASCII non-printable source character should be rejected");
+            } catch (TokeniserException e) {
+                String diagnostic = e.getMessage().toLowerCase(Locale.ROOT);
+                assertTrue("the diagnostic should explain percent encoding for ASCII non-printable characters",
+                    diagnostic.contains("escap") ||
+                        (diagnostic.contains("percent") && diagnostic.contains("encod")) ||
+                        (diagnostic.contains("uri") && diagnostic.contains("encod")));
+            }
+        }
+    }
 
