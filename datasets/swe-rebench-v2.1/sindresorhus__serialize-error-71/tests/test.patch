+test('should ignore `.toJSON` methods if set in the options', t => {
+	let toJSONCalls = 0;
+	class CustomError extends Error {
+		constructor() {
+			super('foo');
+			this.name = this.constructor.name;
+			this.value = 10;
+		}
+
+		toJSON() {
+			toJSONCalls++;
+			return {
+				message: this.message,
+				amount: `$${this.value}`,
+			};
+		}
+	}
+
+	const deeplyNested = {
+		value: 30,
+		toJSON() {
+			toJSONCalls++;
+			return {omitted: true};
+		},
+	};
+	const nested = {
+		value: 20,
+		deeplyNested,
+		toJSON() {
+			toJSONCalls++;
+			return {omitted: true};
+		},
+	};
+	const error = new CustomError();
+	error.nested = nested;
+	const serialized = serializeError(error, {useToJSON: false});
+	t.is(toJSONCalls, 0);
+	t.like(serialized, {
+		name: 'CustomError',
+		message: 'foo',
+		value: 10,
+	});
+	t.like(serialized.nested, {value: 20});
+	t.like(serialized.nested.deeplyNested, {value: 30});
+});
+
