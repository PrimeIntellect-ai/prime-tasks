+
+    def test_linear_expression(self):
+        m = pyo.ConcreteModel()
+        m.x = pyo.Var(bounds=(1, 2))
+        m.y = pyo.Var()
+        m.p = pyo.Param(initialize=3, mutable=True)
+        e = LinearExpression(constant=1, linear_coefs=[1, m.p - 1], linear_vars=[m.x, m.y])
+        m.c = pyo.Constraint(expr=e == 0)
+        fbbt(m.c)
+        self.assertAlmostEqual(m.y.lb, -1.5)
+        self.assertAlmostEqual(m.y.ub, -1)
+
+    def test_compute_bounds_on_linear_expression(self):
+        m = pyo.ConcreteModel()
+        m.x = pyo.Var(bounds=(1, 2))
+        m.y = pyo.Var(bounds=(3, 4))
+        expr = LinearExpression(
+            constant=1, linear_coefs=[2, -1], linear_vars=[m.x, m.y]
+        )
+
+        lb, ub = compute_bounds_on_expr(expr)
+
+        self.assertAlmostEqual(lb, -1)
+        self.assertAlmostEqual(ub, 2)
+
+    def test_negation_expression(self):
+        m = pyo.ConcreteModel()
+        m.x = pyo.Var([0], bounds=(-2, 7))
+        lb, ub = compute_bounds_on_expr(-pyo.summation(m.x))
+        self.assertAlmostEqual(lb, -7)
+        self.assertAlmostEqual(ub, 2)
