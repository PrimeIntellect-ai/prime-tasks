+
+func TestBuildSkipsUnixSocketInProject(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("Unix-domain sockets are not available on Windows")
+	}
+
+	workingDir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(workingDir, "go.mod"), []byte("module socket-project\n\ngo 1.20\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(workingDir, "main.go"), []byte("package main\nfunc main() {}\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	socketPath := filepath.Join(workingDir, "000.sock")
+	listener, err := net.Listen("unix", socketPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+
+	gocBuild, err := NewBuild("", []string{"."}, workingDir, "")
+	if err != nil {
+		t.Fatalf("create project build: %v", err)
+	}
+	if err := gocBuild.Build(); err != nil {
+		t.Fatalf("build project containing a Unix socket: %v", err)
+	}
 }
