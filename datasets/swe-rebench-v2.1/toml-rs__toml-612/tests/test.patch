+#[test]
+fn newtype_key_btreemap() {
+    #[derive(PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Clone, Serialize, Deserialize)]
+    struct NewType(String);
+
+    type CustomKeyMap = std::collections::BTreeMap<NewType, u32>;
+
+    equivalent! {
+        [
+            (NewType("x".to_owned()), 1),
+            (NewType("y".to_owned()), 2),
+        ].into_iter().collect::<CustomKeyMap>(),
+        map! {
+            x: Value::Integer(1),
+            y: Value::Integer(2)
+        },
+    }
+}
+
+#[test]
+fn newtype_key_hashmap() {
+    #[derive(PartialEq, Eq, Hash, Debug, Clone, Serialize, Deserialize)]
+    struct NewType(String);
+
+    let map = t!(toml::from_str::<std::collections::HashMap<NewType, u32>>(
+        r#"
+        x = 1
+        y = 2
+        "#
+    ));
+    assert_eq!(map.get(&NewType("x".to_owned())), Some(&1));
+    assert_eq!(map.get(&NewType("y".to_owned())), Some(&2));
+}
