diff --git a/test/test_grocy_api_client.py b/test/test_grocy_api_client.py
new file mode 100644
index 0000000..4cbd3d9
--- /dev/null
+++ b/test/test_grocy_api_client.py
@@ -0,0 +1,40 @@
+from unittest.mock import patch
+
+from pygrocy.grocy_api_client import GrocyApiClient
+
+
+def _request_url(client):
+    with patch("pygrocy.grocy_api_client.requests.get") as get:
+        get.return_value.status_code = 200
+        get.return_value.content = b"{}"
+        get.return_value.json.return_value = {}
+        client.get_userfields("products", 1)
+        return get.call_args.args[0]
+
+
+class TestGrocyApiClient:
+    def test_url_only(self):
+        client = GrocyApiClient(api_key="", base_url="http://grocy.de")
+        assert _request_url(client) == "http://grocy.de:9192/api/userfields/products/1"
+
+    def test_url_and_port(self):
+        client = GrocyApiClient(api_key="", base_url="http://grocy.de", port=1234)
+        assert _request_url(client) == "http://grocy.de:1234/api/userfields/products/1"
+
+    def test_url_and_port_and_path(self):
+        client = GrocyApiClient(
+            api_key="", base_url="http://grocy.de", port=1234, path="my/custom/path"
+        )
+        assert (
+            _request_url(client)
+            == "http://grocy.de:1234/my/custom/path/api/userfields/products/1"
+        )
+
+    def test_url_and_path(self):
+        client = GrocyApiClient(
+            api_key="", base_url="http://grocy.de", path="my/custom/path"
+        )
+        assert (
+            _request_url(client)
+            == "http://grocy.de:9192/my/custom/path/api/userfields/products/1"
+        )
