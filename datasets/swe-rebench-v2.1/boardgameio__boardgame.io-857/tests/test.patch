+
+describe('plugin playerView', () => {
+  test('an arbitrary plugin can filter data for a client', () => {
+    const plugin = {
+      name: 'filtered',
+      setup: () => ({ publicValue: 'shared', secret: 'private' }),
+      playerView: ({ data, playerID = null }) => ({
+        publicValue: data.publicValue,
+        recipient: playerID,
+      }),
+    };
+    const game = { plugins: [plugin] };
+    const client = Client({ game, playerID: '0' });
+
+    expect(client.getState().plugins[plugin.name].data).toEqual({
+      publicValue: 'shared',
+      recipient: '0',
+    });
+  });
+
+  test('an arbitrary plugin filters data for each client update', async () => {
+    const playerView = jest.fn(({ data, playerID }) => ({
+      recipient: playerID,
+      publicValue: data.publicValue,
+    }));
+    const plugin = {
+      name: 'filtered',
+      setup: () => ({ publicValue: 'shared', secret: 'private' }),
+      playerView,
+    };
+    const game = { plugins: [plugin] };
+    const db = new InMemory();
+    let updateForClient;
+    const master = new Master(game, db, {
+      send: jest.fn(),
+      sendAll: jest.fn(update => {
+        updateForClient = update;
+      }),
+    });
+
+    await master.onSync('matchID', '0', 2);
+    await master.onUpdate(
+      ActionCreators.gameEvent('endTurn'),
+      0,
+      'matchID',
+      '0'
+    );
+    playerView.mockClear();
+
+    updateForClient('0');
+    updateForClient('1');
+
+    expect(playerView).toHaveBeenCalledTimes(2);
+    expect(
+      new Set(playerView.mock.calls.map(([context]) => context.playerID))
+    ).toEqual(new Set(['0', '1']));
+  });
+});
