+
+it('does not retry a subscription error rejected by retryIf', () => {
+  const subscriptionOp = client.createRequestOperation('subscription', {
+    key: 2,
+    query: queryOne,
+  });
+  const response = jest.fn(
+    (forwardOp: Operation): OperationResult => ({
+      operation: forwardOp,
+      // @ts-ignore
+      error: queryOneError,
+    })
+  );
+  const result = jest.fn();
+  const forward: ExchangeIO = ops$ => pipe(ops$, map(response));
+  const retryIf = jest.fn(() => false);
+
+  pipe(
+    retryExchange({
+      ...mockOptions,
+      retryIf,
+    })({
+      forward,
+      client,
+      dispatchDebug,
+    })(ops$),
+    tap(result),
+    publish
+  );
+
+  next(subscriptionOp);
+  jest.runAllTimers();
+
+  expect(retryIf).toHaveBeenCalledWith(queryOneError, subscriptionOp);
+  expect(response).toHaveBeenCalledTimes(1);
+  expect(result).toHaveBeenCalledTimes(1);
+  expect(result.mock.calls[0][0].error).toBeTruthy();
+});
