@@ -5,6 +5,36 @@ import { describe, expect, test } from "vitest";
 import { blockPackageJson } from "./blockPackageJson.js";
 import { optionsBase } from "./options.fakes.js";
 
+function expectInstallCommand(
+	creation: { scripts?: { commands: string[] }[] },
+	offline = false,
+) {
+	const command = creation.scripts?.[0]?.commands[0];
+
+	expect(command).toMatch(/^pnpm install\b/);
+	if (offline) {
+		expect(command).toBe("pnpm install --offline --no-frozen-lockfile");
+	} else {
+		expect(command).toContain("--no-frozen-lockfile");
+	}
+}
+
+function normalizeInstallCommandOptions<
+	T extends { scripts?: { commands: string[] }[] },
+>(creation: T) {
+	return {
+		...creation,
+		scripts: creation.scripts?.map((script) => ({
+			...script,
+			commands: script.commands.map((command) =>
+				command.startsWith("pnpm install ")
+					? "pnpm install <options>"
+					: command,
+			),
+		})),
+	};
+}
+
