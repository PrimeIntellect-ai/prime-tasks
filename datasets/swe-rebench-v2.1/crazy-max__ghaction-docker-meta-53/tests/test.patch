+test('omits a disabled edge tag', async () => {
+  process.env = dotenv.parse(fs.readFileSync(path.join(__dirname, 'fixtures', 'event_push_defbranch.env')));
+  const context = github.context();
+  const repo = await github.repo(process.env.GITHUB_TOKEN || '');
+  const meta = new Meta(
+    {
+      ...getInputs(),
+      images: ['user/app'],
+      tags: ['type=edge,enable=false']
+    } as Inputs,
+    context,
+    repo
+  );
+
+  expect(meta.getTags()).not.toContain('user/app:edge');
+});
