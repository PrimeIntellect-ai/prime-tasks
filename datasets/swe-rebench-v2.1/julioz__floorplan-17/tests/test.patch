+    @Test
+    fun `nullable fields are rendered in the generated output when argument is specified`() {
+        val schemaFile = writeSchemaWithNullableTextField()
+
+        val output = captureStandardOutput {
+            main(arrayOf(schemaFile.absolutePath, "--render-nullable-fields"))
+        }
+
+        assertTrue(output.contains("varchar(?)"))
+    }
+
+    @Test
+    fun `nullable fields are not rendered in the generated output when argument isn't specified`() {
+        val schemaFile = writeSchemaWithNullableTextField()
+
+        val output = captureStandardOutput {
+            main(arrayOf(schemaFile.absolutePath))
+        }
+
+        assertFalse(output.contains("(?)"))
+    }
+
+    private fun writeSchemaWithNullableTextField(): File {
+        val schemaFile = File.createTempFile("floorplan-schema", ".json")
+        schemaFile.deleteOnExit()
+        schemaFile.writeText(
+            """
+            {
+              "formatVersion": 1,
+              "database": {
+                "version": 1,
+                "identityHash": "hash",
+                "entities": [
+                  {
+                    "tableName": "Users",
+                    "createSql": "CREATE TABLE Users",
+                    "fields": [
+                      {
+                        "fieldPath": "name",
+                        "columnName": "name",
+                        "affinity": "TEXT",
+                        "notNull": false
+                      }
+                    ],
+                    "primaryKey": { "columnNames": [], "autoGenerate": false },
+                    "indices": [],
+                    "foreignKeys": []
+                  }
+                ],
+                "setupQueries": []
+              }
+            }
+            """.trimIndent()
+        )
+        return schemaFile
+    }
+
+    private fun captureStandardOutput(block: () -> Unit): String {
+        val originalOut = System.out
+        val captured = ByteArrayOutputStream()
+        try {
+            System.setOut(PrintStream(captured))
+            block()
+        } finally {
+            System.setOut(originalOut)
+        }
+        return captured.toString()
+    }
 }
