+    fun `nullable field types receive the nullable marker through the command line`() {
+        val schemaFile = File.createTempFile("floorplan-fields", ".json")
+        schemaFile.deleteOnExit()
+        schemaFile.writeText(
+            """
+            {
+              "formatVersion": 1,
+              "database": {
+                "version": 1,
+                "identityHash": "hash",
+                "entities": [{
+                  "tableName": "Users",
+                  "createSql": "CREATE TABLE Users",
+                  "fields": [
+                    { "fieldPath": "id", "columnName": "id", "affinity": "INTEGER", "notNull": false },
+                    { "fieldPath": "name", "columnName": "name", "affinity": "TEXT", "notNull": true }
+                  ],
+                  "primaryKey": { "columnNames": [], "autoGenerate": false },
+                  "indices": [],
+                  "foreignKeys": []
+                }],
+                "setupQueries": []
+              }
+            }
+            """.trimIndent()
+        )
+
+        val originalOut = System.out
+        val captured = ByteArrayOutputStream()
+        try {
+            System.setOut(PrintStream(captured))
+            main(arrayOf(schemaFile.absolutePath, "--render-nullable-fields"))
+        } finally {
+            System.setOut(originalOut)
+        }
+
+        val output = captured.toString()
+        assertTrue(output.contains("id int(?)"))
+        assertFalse(output.contains("name varchar(?)"))
+    }
