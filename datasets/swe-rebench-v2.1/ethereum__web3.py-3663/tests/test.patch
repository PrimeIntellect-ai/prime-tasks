diff --git a/tests/core/providers/test_ipc_provider.py b/tests/core/providers/test_ipc_provider.py
index 77b62370..7603e605 100644
--- a/tests/core/providers/test_ipc_provider.py
+++ b/tests/core/providers/test_ipc_provider.py
@@ -199,3 +199,18 @@ def test_ipc_provider_write_messages_end_with_new_line_delimiter(jsonrpc_ipc_pip
 
     request_data = b'{"jsonrpc": "2.0", "method": "method", "params": [], "id": 0}'
     provider._socket.sock.sendall.assert_called_with(request_data + b"\n")
+
+
+def test_ipc_provider_make_batch_request_without_manual_is_batching(
+    jsonrpc_ipc_pipe_path,
+):
+    provider = IPCProvider(pathlib.Path(jsonrpc_ipc_pipe_path), timeout=3)
+    provider._make_request = Mock(
+        return_value=[{"id": 0, "jsonrpc": "2.0", "result": {}}]
+    )
+
+    assert not provider._is_batching
+    result = provider.make_batch_request([("eth_blockNumber", [])])
+
+    assert result == [{"id": 0, "jsonrpc": "2.0", "result": {}}]
+    assert not provider._is_batching
diff --git a/tests/core/providers/test_websocket_provider.py b/tests/core/providers/test_websocket_provider.py
index 2965addb..bb76d544 100644
--- a/tests/core/providers/test_websocket_provider.py
+++ b/tests/core/providers/test_websocket_provider.py
@@ -534,3 +534,41 @@ async def test_req_info_cache_size_can_be_set_and_warns_when_full(caplog):
             "behavior. Consider increasing the ``request_information_cache_size`` "
             "on the provider."
         ) in caplog.text
+
+
+@pytest.mark.asyncio
+async def test_websocket_provider_make_batch_request_without_manual_is_batching():
+    with patch(
+        "web3.providers.persistent.websocket.connect",
+        new=lambda *_1, **_2: WebSocketMessageStreamMock(
+            messages=[b'[{"id": 0, "jsonrpc": "2.0", "result": "0x1"}]\n']
+        ),
+    ):
+        async_w3 = await AsyncWeb3(WebSocketProvider("ws://mocked"))
+        assert not async_w3.provider._is_batching
+
+        result = await async_w3.provider.make_batch_request(
+            [("eth_blockNumber", [])]
+        )
+
+        assert result == [{"id": 0, "jsonrpc": "2.0", "result": "0x1"}]
+        assert not async_w3.provider._is_batching
+
+
+@pytest.mark.asyncio
+async def test_list_response_in_cache_does_not_raise_type_error():
+    with patch(
+        "web3.providers.persistent.websocket.connect",
+        new=lambda *_1, **_2: WebSocketMessageStreamMock(
+            messages=[
+                b'[{"id": 0, "jsonrpc": "2.0", "result": "0x1"}]\n',
+                b'{"id": 0, "jsonrpc": "2.0", "result": "0x2"}\n',
+            ]
+        ),
+    ):
+        async_w3 = await AsyncWeb3(WebSocketProvider("ws://mocked"))
+        await asyncio.sleep(0.1)
+
+        # a list-valued cache response must not cause a ``TypeError`` when the
+        # provider checks the cache for stray errors
+        assert await async_w3.eth.block_number == 2
