+# A number type with non-commutative multiplication
+struct MatNum <: Number
+    mat::Matrix{Int}
+end
+Base.:(==)(x::MatNum, y::MatNum) = x.mat == y.mat
+Base.:*(x::MatNum, y::MatNum) = MatNum(x.mat*y.mat)
+
