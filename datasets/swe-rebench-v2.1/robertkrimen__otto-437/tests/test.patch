+
+func TestJSONMarshaling(t *testing.T) {
+	tt(t, func() {
+		eval, tester := test()
+		isJSON := func(val interface{}, expected string) {
+			actual, err := json.Marshal(val)
+			is(err, nil)
+			var actualValue, expectedValue interface{}
+			is(json.Unmarshal(actual, &actualValue), nil)
+			is(json.Unmarshal([]byte(expected), &expectedValue), nil)
+			is(reflect.DeepEqual(actualValue, expectedValue), true)
+		}
+
+		isJSON(*eval("[]").Object(), `[]`)
+		isJSON(*eval("[1, 2, 3]").Object(), `[1,2,3]`)
+		isJSON(*eval("new Array(1,2,3)").Object(), `[1,2,3]`)
+
+		isJSON(*eval(`({a:1, b:"hi", c:[true,false]})`).Object(), `{"a":1,"b":"hi","c":[true,false]}`)
+
+		goArray := []string{"foo", "bar"}
+		val, _ := tester.vm.ToValue(goArray)
+		isJSON(*val.Object(), `["foo","bar"]`)
+
+		goMap := map[string]interface{}{
+			"bar": []int{1, 2, 3},
+			"foo": 17,
+		}
+		val, _ = tester.vm.ToValue(goMap)
+		isJSON(*val.Object(), `{"bar":[1,2,3],"foo":17}`)
+	})
+}
