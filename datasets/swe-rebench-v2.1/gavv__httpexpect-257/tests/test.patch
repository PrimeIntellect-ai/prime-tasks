+func TestValue_AddedIsObjectBehavior(t *testing.T) {
+	reporter := newMockReporter(t)
+
+	data := map[string]interface{}{"foo": 123.0}
+
+	value1 := NewValue(reporter, data)
+	if callIsMethod(t, value1, "IsObject") != value1 {
+		t.Fatalf("IsObject() did not return the receiver")
+	}
+	if reporter.reported {
+		t.Fatalf("unexpected validation failure")
+	}
+
+	value2 := NewValue(reporter, "foo")
+	if callIsMethod(t, value2, "IsObject") != value2 {
+		t.Fatalf("IsObject() did not return the receiver")
+	}
+	if !reporter.reported {
+		t.Fatalf("expected validation failure")
+	}
+}
