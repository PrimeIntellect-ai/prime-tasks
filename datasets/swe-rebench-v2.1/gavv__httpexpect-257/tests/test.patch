+func callIsMethod(t *testing.T, value *Value, name string) *Value {
+	t.Helper()
+	method := reflect.ValueOf(value).MethodByName(name)
+	if !method.IsValid() {
+		t.Fatalf("%s method is not available", name)
+	}
+	result := method.Call(nil)
+	if len(result) != 1 {
+		t.Fatalf("%s returned an unexpected number of values", name)
+	}
+	returnedValue, ok := result[0].Interface().(*Value)
+	if !ok {
+		t.Fatalf("%s did not return a Value", name)
+	}
+	return returnedValue
+}
+
+func TestValue_AddedIsMethodsDocumented(t *testing.T) {
+	for _, method := range []string{"IsObject", "IsArray", "IsString", "IsNumber", "IsBoolean"} {
+		t.Run(method, func(t *testing.T) {
+			output, err := exec.Command("go", "doc", "Value."+method).CombinedOutput()
+			if err != nil {
+				t.Fatalf("could not read public documentation for %s: %v\n%s", method, err, output)
+			}
+			if !strings.Contains(string(output), "\n    ") {
+				t.Errorf("%s has no explanatory public documentation", method)
+			}
+		})
+	}
+}
