+func TestDecodeInterfaceSlice(t *testing.T) {
+	var v map[string]interface{}
+	if _, err := Decode(`S = []`, &v); err != nil {
+		t.Errorf(err.Error())
+	}
+	// S = [] should decode into a non-nil empty []interface{} (see issue #338).
+	empty, ok := v["S"].([]interface{})
+	if !ok || empty == nil || len(empty) != 0 {
+		t.Errorf("S decoded as %#v; want a non-nil empty []interface{}", v["S"])
+	}
+
+	if _, err := Decode(`S = [[]]`, &v); err != nil {
+		t.Fatalf("decoding nested empty array: %v", err)
+	}
+	nested, ok := v["S"].([]interface{})
+	if !ok || len(nested) != 1 {
+		t.Fatalf("S = [[]] decoded as %#v; want one nested array", v["S"])
+	}
+	inner := reflect.ValueOf(nested[0])
+	if !inner.IsValid() || inner.Kind() != reflect.Slice || inner.IsNil() || inner.Len() != 0 {
+		t.Errorf("inner empty array decoded as %#v; want a non-nil empty slice", nested[0])
+	}
+}
