+	defer func() { _ = r.Kill() }()
+	if err != nil {
+		panic(err)
+	}
+	getAllStepsRequest := &gm.Message{MessageType: gm.Message_StepNamesRequest, StepNamesRequest: &gm.StepNamesRequest{}}
