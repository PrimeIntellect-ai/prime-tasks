+func TestListStepsViaCLI(t *testing.T) {
+	dir := t.TempDir()
+	gaugeHome := filepath.Join(dir, "gauge-home")
+	pluginDir := filepath.Join(gaugeHome, "plugins", "java", "0.0.1")
+	if err := os.MkdirAll(pluginDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Join(gaugeHome, "config"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(gaugeHome, "config", "gauge.properties"), nil, 0644); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("GAUGE_HOME", gaugeHome)
+
+	if err := os.WriteFile(filepath.Join(dir, "manifest.json"), []byte(`{"Language":"java"}`), 0644); err != nil {
+		t.Fatal(err)
+	}
+	specsDir := filepath.Join(dir, "specs")
+	if err := os.MkdirAll(specsDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(specsDir, "sample.spec"), []byte("# Sample\n\n## Scenario1\n* ordinary step\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	testBinary, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("GAUGE_LIST_TEST_RUNNER", "true")
+	runnerCommand, err := json.Marshal([]string{testBinary, "-test.run=^TestListStepsRunnerProcess$"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	pluginConfig := fmt.Sprintf(`{"GaugeVersionSupport":{"Minimum":"0.0.0"},"GRPCSupport":true,"Run":{"Linux":%s,"Darwin":%s,"Windows":%s}}`, runnerCommand, runnerCommand, runnerCommand)
+	if err := os.WriteFile(filepath.Join(pluginDir, "java.json"), []byte(pluginConfig), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	previousRoot := config.ProjectRoot
+	config.ProjectRoot = dir
+	defer func() { config.ProjectRoot = previousRoot }()
+
+	listCommand, _, err := GaugeCmd.Find([]string{"list"})
+	if err != nil {
+		t.Fatalf("gauge list command not found: %v", err)
+	}
+	if err := listCommand.Flags().Set("steps", "true"); err != nil {
+		t.Fatalf("gauge list does not expose a --steps flag: %v", err)
+	}
+	defer listCommand.Flags().Set("steps", "false")
+
+	out := captureStdout(t, func() {
+		listCommand.Run(listCommand, []string{specsDir})
+	})
+
+	ordered := []string{"alias step", "concept step", "ordinary step"}
+	last := -1
+	for _, step := range ordered {
+		position := strings.Index(out, step)
+		if position < 0 {
+			t.Errorf("expected `gauge list --steps` output on standard output to include %q, got:\n%s", step, out)
+			continue
+		}
+		if position <= last {
+			t.Errorf("expected listed steps to be sorted, got:\n%s", out)
+		}
+		last = position
+		if count := strings.Count(out, step); count != 1 {
+			t.Errorf("expected %q once in listed output, found it %d times:\n%s", step, count, out)
+		}
+	}
+}
