+func TestListStepsRunnerProcess(t *testing.T) {
+	if os.Getenv("GAUGE_LIST_TEST_RUNNER") != "true" {
+		return
+	}
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	fmt.Printf("Listening on port:%d\n", listener.Addr().(*net.TCPAddr).Port)
+	server := grpc.NewServer()
+	gm.RegisterRunnerServer(server, listStepsRunnerService{})
+	if err := server.Serve(listener); err != nil {
+		t.Fatal(err)
+	}
+}
+
+type listStepsRunnerService struct {
+	gm.UnimplementedRunnerServer
+}
+
+func (listStepsRunnerService) GetStepNames(context.Context, *gm.StepNamesRequest) (*gm.StepNamesResponse, error) {
+	return &gm.StepNamesResponse{Steps: []string{"ordinary step", "concept step", "alias step", "alias step"}}, nil
+}
+
+func captureStdout(t *testing.T, f func()) string {
+	t.Helper()
+	old := os.Stdout
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	os.Stdout = w
+	defer func() { os.Stdout = old }()
+	f()
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	out, err := io.ReadAll(r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(out)
+}
