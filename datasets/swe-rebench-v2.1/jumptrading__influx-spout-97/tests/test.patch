+// The filter and writer components also run a statistician whose
+// publish interval must come from the StatsInterval configuration
+// option. These tests verify that the configured interval is actually
+// honoured: an implementation that ignores the configuration and uses
+// the old hard-coded 3s interval would only produce a single publish
+// within the observation window.
+
+const (
+	filterStatsNATSPort = 44300
+	writerStatsNATSPort = 44400
+)
+
+func TestListenerStatsInterval(t *testing.T) {
+	stats.SetHostname("h")
+
+	s := spouttest.RunGnatsd(natsPort)
+	defer s.Shutdown()
+
+	conf := testConfig()
+	conf.StatsInterval = config.Duration{100 * time.Millisecond}
+	monitorCh, unsub := subscribeAddr(t, conf.NATSAddress, conf.NATSSubjectMonitor)
+	defer unsub()
+
+	l := startListener(t, conf)
+	defer l.Stop()
+
+	assertFrequentStats(t, monitorCh)
+}
+
+func TestFilterStatsInterval(t *testing.T) {
+	stats.SetHostname("h")
+
+	s := spouttest.RunGnatsd(filterStatsNATSPort)
+	defer s.Shutdown()
+
+	conf := &config.Config{
+		Mode:                "filter",
+		Name:                "filterstats",
+		NATSAddress:         fmt.Sprintf("nats://127.0.0.1:%d", filterStatsNATSPort),
+		NATSSubject:         []string{"filter-stats-in"},
+		NATSSubjectMonitor:  "filter-stats-monitor",
+		NATSSubjectJunkyard: "filter-stats-junk",
+		NATSMaxPendingSize:  32 * datasize.MB,
+		Workers:             1,
+		MaxTimeDelta:        config.Duration{10 * time.Minute},
+		Rule: []config.Rule{{
+			Rtype:   "basic",
+			Match:   "hello",
+			Subject: "hello-subject",
+		}},
+		StatsInterval: config.Duration{100 * time.Millisecond},
+	}
+
+	monitorCh, unsub := subscribeAddr(t, conf.NATSAddress, conf.NATSSubjectMonitor)
+	defer unsub()
+
+	f, err := filter.StartFilter(conf)
+	require.NoError(t, err)
+	defer f.Stop()
+
+	assertFrequentStats(t, monitorCh)
+}
+
+func TestWriterStatsInterval(t *testing.T) {
+	stats.SetHostname("h")
