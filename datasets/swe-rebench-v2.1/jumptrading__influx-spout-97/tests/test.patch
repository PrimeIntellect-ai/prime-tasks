+
+func subscribeAddr(t require.TestingT, address, subject string) (chan string, func()) {
+	nc, err := nats.Connect(address)
+	require.NoError(t, err)
+
+	msgCh := make(chan string, 100)
+	sub, err := nc.Subscribe(subject, func(msg *nats.Msg) {
+		msgCh <- string(msg.Data)
+	})
+	require.NoError(t, err)
+	require.NoError(t, nc.Flush())
+
+	return msgCh, func() {
+		sub.Unsubscribe()
+		nc.Close()
+	}
+}
+
+// assertFrequentStats checks that the statistician publishes several
+// times within a short window. With the configured 100ms interval many
+// publishes are expected; an implementation that ignores the
+// configuration and uses the old hard-coded 3s interval would only
+// produce a single publish in this window.
+func assertFrequentStats(t *testing.T, ch chan string) {
+	const want = 4
+	deadline := time.After(2 * time.Second)
+	seen := 0
+	for seen < want {
+		select {
+		case <-ch:
+			seen++
+		case <-deadline:
+			t.Fatalf("expected at least %d stats publishes within 2s, saw %d", want, seen)
+		}
+	}
+}
