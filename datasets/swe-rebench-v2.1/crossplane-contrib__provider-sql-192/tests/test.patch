+func assertCreateDatabaseRouting(t *testing.T, loginDatabase *string, want []string) {
+	t.Helper()
+	const targetDatabase = "application-db"
+	var operations []string
+	kube := &test.MockClient{
+		MockGet: test.NewMockGetFn(nil, func(obj client.Object) error {
+			switch o := obj.(type) {
+			case *v1alpha1.ProviderConfig:
+				o.Spec.Credentials.ConnectionSecretRef = &xpv1.SecretReference{}
+			case *corev1.Secret:
+				obj.(*corev1.Secret).Data = map[string][]byte{}
+			}
+			return nil
+		}),
+	}
+	mg := &v1alpha1.User{
+		ObjectMeta: v1.ObjectMeta{Annotations: map[string]string{meta.AnnotationKeyExternalName: "example"}},
+		Spec: v1alpha1.UserSpec{
+			ResourceSpec: xpv1.ResourceSpec{ProviderConfigReference: &xpv1.Reference{Name: "provider"}},
+			ForProvider:  v1alpha1.UserParameters{Database: ptr.To(targetDatabase)},
+		},
+	}
+	if loginDatabase != nil {
+		setLoginDatabase(t, &mg.Spec.ForProvider, *loginDatabase)
+	}
+	c := &connector{
+		kube:  kube,
+		usage: resource.TrackerFn(func(context.Context, resource.Managed) error { return nil }),
+		newClient: func(_ map[string][]byte, database string) xsql.DB {
+			session := &statementSession{current: database, operations: &operations}
+			return &mockDB{
+				MockExec: func(_ context.Context, q xsql.Query) error {
+					session.run(q)
+					return nil
+				},
+				MockExecTx: func(_ context.Context, queries []xsql.Query) error {
+					for _, q := range queries {
+						session.run(q)
+					}
+					return nil
+				},
+			}
+		},
+	}
+	ec, err := c.Connect(context.Background(), mg)
+	if err != nil {
+		t.Fatalf("Connect() returned unexpected error: %v", err)
+	}
+	if _, err := ec.Create(context.Background(), mg); err != nil {
+		t.Fatalf("Create() returned unexpected error: %v", err)
+	}
+	if diff := cmp.Diff(want, operations, cmpopts.SortSlices(func(a, b string) bool { return a < b })); diff != "" {
+		t.Errorf("statements by database: -want, +got:\n%s", diff)
+	}
+}
+
+func TestCreateUsesConfiguredLoginDatabase(t *testing.T) {
+	loginDatabase := "master-db"
+	assertCreateDatabaseRouting(t, &loginDatabase, []string{"master-db: CREATE LOGIN", "application-db: CREATE USER"})
+}
+
+func TestCreateDefaultsLoginDatabaseToTarget(t *testing.T) {
+	assertCreateDatabaseRouting(t, nil, []string{"application-db: CREATE LOGIN", "application-db: CREATE USER"})
+}
