+// statementSession simulates a client connection. It starts in the database
+// the client was created for and switches database context when it executes
+// a USE statement. Every CREATE LOGIN and CREATE USER is recorded together with
+// the database it actually ran in.
+type statementSession struct {
+	current    string
+	operations *[]string
+}
+
+func (s *statementSession) run(q xsql.Query) {
+	for _, stmt := range strings.FieldsFunc(q.String, func(r rune) bool { return r == ';' || r == '\n' }) {
+		stmt = strings.TrimSpace(stmt)
+		upper := strings.ToUpper(stmt)
+		if strings.HasPrefix(upper, "USE ") {
+			s.current = strings.Trim(strings.TrimSpace(stmt[len("USE "):]), "[]\" ")
+			continue
+		}
+		if strings.Contains(upper, "CREATE LOGIN") {
+			*s.operations = append(*s.operations, s.current+": CREATE LOGIN")
+		}
+		if strings.Contains(upper, "CREATE USER") {
+			*s.operations = append(*s.operations, s.current+": CREATE USER")
+		}
+	}
+}
