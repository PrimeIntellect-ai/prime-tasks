+func (c connectorTestClient) Get(ctx context.Context, key client.ObjectKey, obj client.Object, opts ...client.GetOption) error {
+	switch got := obj.(type) {
+	case *v1alpha1.ProviderConfig:
+		got.Spec.Credentials.ConnectionSecretRef = &xpv1.SecretReference{Name: "provider-credentials"}
+		return nil
+	case *corev1.Secret:
