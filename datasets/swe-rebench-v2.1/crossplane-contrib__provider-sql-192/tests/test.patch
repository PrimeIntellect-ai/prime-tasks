+// setLoginDatabase sets the optional LoginDatabase parameter, whether it is
+// declared as a string or as a pointer to a string.
+func setLoginDatabase(t *testing.T, params *v1alpha1.UserParameters, name string) {
+	t.Helper()
+	field := reflect.ValueOf(params).Elem().FieldByName("LoginDatabase")
+	if !field.IsValid() || !field.CanSet() {
+		t.Fatalf("UserParameters has no settable LoginDatabase field")
+	}
+	switch {
+	case field.Kind() == reflect.String:
+		field.SetString(name)
+	case field.Kind() == reflect.Ptr && field.Type().Elem().Kind() == reflect.String:
+		value := reflect.New(field.Type().Elem())
+		value.Elem().SetString(name)
+		field.Set(value)
+	default:
+		t.Fatalf("LoginDatabase must be a string or a pointer to a string")
+	}
+}
+
+func newExternalClient(t *testing.T, userDB, loginDB xsql.DB, kube client.Client) managed.ExternalClient {
+	t.Helper()
+	loginDatabase := loginDB
+	c := &connector{
+		kube:  connectorTestClient{Client: kube},
+		usage: resource.TrackerFn(func(context.Context, resource.Managed) error { return nil }),
+		newClient: func(_ map[string][]byte, database string) xsql.DB {
+			if database == "login" && loginDatabase != nil {
+				return loginDatabase
+			}
+			return userDB
+		},
+	}
+	mg := &v1alpha1.User{Spec: v1alpha1.UserSpec{
+		ResourceSpec: xpv1.ResourceSpec{ProviderConfigReference: &xpv1.Reference{Name: "provider"}},
+		ForProvider:  v1alpha1.UserParameters{Database: ptr.To("user")},
+	}}
+	if loginDatabase != nil {
+		setLoginDatabase(t, &mg.Spec.ForProvider, "login")
+	}
+	ec, err := c.Connect(context.Background(), mg)
+	if err != nil {
+		t.Fatalf("Connect() returned unexpected error: %v", err)
+	}
+	return ec
+}
