diff --git a/src/rulesets/__tests__/rule_name_conflicts.jest.test.ts b/src/rulesets/__tests__/rule_name_conflicts.jest.test.ts
new file mode 100644
index 0000000..af844e0
--- /dev/null
+++ b/src/rulesets/__tests__/rule_name_conflicts.jest.test.ts
@@ -0,0 +1,57 @@
+import * as fs from 'fs';
+import { Spectral } from '../../spectral';
+
+const readRuleset = (name: string): { rules: Record<string, unknown> } =>
+  JSON.parse(fs.readFileSync(`${__dirname}/../${name}/index.json`, { encoding: 'utf8' }));
+
+describe('Rule name conflicts among rulesets', () => {
+  test.each([['oas', 'oas2'], ['oas2', 'oas3'], ['oas3', 'oas']])(
+    'do not exist (comparing %s with %s)',
+    async () => {
+      // `spectral:oas` extends both `spectral:oas2` and `spectral:oas3`, so its effective rules
+      // are the merge of the three rulesets. Merging must not drop the format-specific
+      // `model-description` behaviour for either OpenAPI version.
+      const rules = {
+        ...readRuleset('oas2').rules,
+        ...readRuleset('oas3').rules,
+        ...readRuleset('oas').rules,
+      };
+
+      const s = new Spectral();
+      const enabledRules: Record<string, unknown> = {};
+      for (const [name, rule] of Object.entries(rules)) {
+        enabledRules[name] = Object.assign({}, rule, { recommended: true });
+      }
+      s.setRules(enabledRules as any);
+
+      const oas2Results = await s.run({
+        swagger: '2.0',
+        paths: {},
+        host: 'stoplight.io',
+        definitions: { user: {} },
+      });
+      expect(oas2Results).toEqual(
+        expect.arrayContaining([
+          expect.objectContaining({
+            message: 'Definition `description` must be present and non-empty string.',
+            path: ['definitions', 'user'],
+          }),
+        ]),
+      );
+
+      const oas3Results = await s.run({
+        openapi: '3.0.0',
+        paths: {},
+        components: { schemas: { user: {} } },
+      });
+      expect(oas3Results).toEqual(
+        expect.arrayContaining([
+          expect.objectContaining({
+            message: 'Model `description` must be present and non-empty string.',
+            path: ['components', 'schemas', 'user'],
+          }),
+        ]),
+      );
+    },
+  );
+});
