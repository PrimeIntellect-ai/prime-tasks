+
+mod bracket_indexing_contract {
+    use context::Context;
+    use tera::Tera;
+
+    #[derive(Serialize)]
+    struct Record {
+        label: String,
+    }
+
+    #[test]
+    fn integer_bracket_index_matches_dotted_index() {
+        let mut context = Context::new();
+        context.add("items", &vec!["zero", "one"]);
+
+        assert_eq!(Tera::one_off("{{ items[0] }}", &context, true).unwrap(), "zero");
+        assert_eq!(
+            Tera::one_off("{{ items[0] }}", &context, true).unwrap(),
+            Tera::one_off("{{ items.0 }}", &context, true).unwrap()
+        );
+    }
+
+    #[test]
+    fn quoted_bracket_key_matches_dotted_property() {
+        let mut context = Context::new();
+        context.add("item", &Record { label: "hello".to_string() });
+
+        assert_eq!(
+            Tera::one_off(r#"{{ item["label"] }}"#, &context, true).unwrap(),
+            Tera::one_off("{{ item.label }}", &context, true).unwrap()
+        );
+    }
+
+    #[test]
+    fn quoted_bracket_key_can_contain_non_identifier_characters() {
+        let mut context = Context::new();
+        let mut values = ::std::collections::HashMap::new();
+        values.insert(
+            "not-an-identifier".to_string(),
+            ::serde_json::value::to_value("tutorial page").unwrap(),
+        );
+        context.add("pages", &values);
+
+        assert_eq!(
+            Tera::one_off(r#"{{ pages["not-an-identifier"] }}"#, &context, true).unwrap(),
+            "tutorial page"
+        );
+    }
+}
