+describe('RadioButton focus and blur', () => {
+    test('call onFocus and onBlur of the focused option like a native radio', async () => {
+        const onFocusFn = jest.fn();
+        const onBlurFn = jest.fn();
+        const user = userEvent.setup();
+
+        const callbacks = {onFocus: onFocusFn, onBlur: onBlurFn};
+
+        render(
+            <RadioButton
+                options={[
+                    {value: 'first', content: 'First'},
+                    {value: 'second', content: 'Second'},
+                ]}
+                {...callbacks}
+            />,
+        );
+
+        await user.tab();
+        expect(screen.getAllByRole('radio')[0]).toHaveFocus();
+        expect(onFocusFn).toHaveBeenCalledTimes(1);
+        expect(onBlurFn).not.toHaveBeenCalled();
+
+        await user.tab();
+        expect(onBlurFn).toHaveBeenCalledTimes(1);
+    });
+});
