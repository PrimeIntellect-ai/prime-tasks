+
+if (typeof describe === 'function') {
+  describe('zoomed stroke-first text rendering', () => {
+    it('keeps text crisp after zooming', () => {
+      const { FabricText } = require('../../src/shapes/Text/Text');
+      const { Group } = require('../../src/shapes/Group');
+      const { StaticCanvas } = require('../../src/canvas/StaticCanvas');
+      const render = (shadow, zoomTiming) => {
+        const canvas = new StaticCanvas(null, {
+          width: 500,
+          height: 300,
+          enableRetinaScaling: false,
+        });
+        const text = new FabricText('Zoom text', {
+          left: 0,
+          top: 0,
+          fontSize: 20,
+          fill: 'black',
+          stroke: 'black',
+          strokeWidth: 1,
+          paintFirst: 'stroke',
+          objectCaching: false,
+        });
+        text.shadow = shadow;
+        const group = new Group([text], {
+          left: 5,
+          top: 5,
+          objectCaching: false,
+        });
+        canvas.add(group);
+        if (zoomTiming === 'before') {
+          canvas.setZoom(1.3);
+        }
+        canvas.renderAll();
+        if (zoomTiming === 'after') {
+          canvas.setZoom(1.3);
+          canvas.renderAll();
+        }
+        const pixels = canvas.getElement().getContext('2d')
+          .getImageData(0, 0, 500, 300).data;
+        canvas.dispose();
+        return pixels;
+      };
+      const zoomedAfterCaching = render(null, 'after');
+      const renderedAtZoom = render(undefined, 'before');
+      let difference = 0;
+      let visiblePixels = 0;
+      for (let i = 0; i < zoomedAfterCaching.length; i += 4) {
+        if (zoomedAfterCaching[i + 3] || renderedAtZoom[i + 3]) {
+          visiblePixels++;
+          for (let channel = 0; channel < 4; channel++) {
+            difference += Math.abs(
+              zoomedAfterCaching[i + channel] - renderedAtZoom[i + channel]
+            );
+          }
+        }
+      }
+      const normalizedDifference = difference / (visiblePixels * 4 * 255);
+      expect(normalizedDifference).toBeLessThan(0.01);
+    });
+  });
+}
