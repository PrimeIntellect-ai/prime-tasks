+it(
+  'reuses a server result after client hydration without issuing another query',
+  async () => {
+    const serverSsr = ssrExchange();
+    const serverClient = new Client({
+      url: '/api',
+      suspense: true,
+      exchanges: [
+        persistedExchange(),
+        serverSsr,
+        () => operations$ =>
+          pipe(
+            operations$,
+            map(operation => ({ ...queryResponse, operation }))
+          ),
+      ],
+    });
+
+    await pipe(
+      serverClient.executeRequestOperation(queryOperation),
+      take(1),
+      toPromise
+    );
+
+    const clientSsr = ssrExchange({
+      initialState: serverSsr.extractData(),
+      isClient: true,
+    });
+    const clientRequests: Operation[] = [];
+    const client = new Client({
+      url: '/api',
+      suspense: false,
+      exchanges: [
+        persistedExchange(),
+        clientSsr,
+        () => operations$ =>
+          pipe(
+            operations$,
+            tap(operation => {
+              if (operation.kind !== 'teardown') clientRequests.push(operation);
+            }),
+            map(operation => ({ ...queryResponse, operation }))
+          ),
+      ],
+    });
+
+    const result = await pipe(
+      client.executeRequestOperation(queryOperation),
+      take(1),
+      toPromise
+    );
+
+    expect(result.data).toEqual(queryResponse.data);
+    expect(clientRequests).toHaveLength(0);
+  }
+);
