+it('resolves a non-persisted query when persistedExchange runs before ssrExchange', async () => {
+  const server = new Client({
+    url: '/api',
+    suspense: true,
+    exchanges: [
+      persistedExchange(),
+      ssrExchange(),
+      () => operations$ =>
+        pipe(
+          operations$,
+          map(operation => {
+            const persisted = operation.extensions?.persistedQuery;
+            if (persisted && !persisted.miss) {
+              return {
+                ...queryResponse,
+                operation,
+                data: undefined,
+                error: new CombinedError({
+                  graphQLErrors: [{ message: 'PersistedQueryNotFound' }],
+                }),
+              };
+            }
+            return { ...queryResponse, operation };
+          })
+        ),
+    ],
+  });
+
+  const res = await pipe(
+    server.executeRequestOperation(queryOperation),
+    take(1),
+    toPromise
+  );
+
+  expect(res).toBeDefined();
+  expect(res.operation.key).toBe(queryOperation.key);
+});
+
 it('skips operation when generateHash returns a nullish value', async () => {
