@@ -265,3 +265,44 @@ def test_doc_operationid(app, client):
     validate_spec(rv.json)
     assert rv.json['paths']['/foo']['get']['operationId'] == 'getSomeFoo'
     assert 'operationId' not in rv.json['paths']['/bar']['get']
+
+
+def test_auth_required_integration_is_documented(app, client):
+    from apiflask import HTTPTokenAuth
+
+    auth = HTTPTokenAuth(header='X-API-Key')
+
+    @auth.verify_token
+    def verify_token(token):
+        if token == 'valid-key':
+            return 'user'
+        return None
+
+    app.security_schemes = {
+        'PartnerAuth': {
+            'type': 'apiKey',
+            'in': 'header',
+            'name': 'X-API-Key',
+        }
+    }
+
+    @app.route('/protected')
+    @app.auth_required(auth)
+    @app.doc(security='PartnerAuth')
+    def protected():
+        return {'user': auth.current_user}
+
+    assert client.get('/protected').status_code == 401
+    authenticated = client.get('/protected', headers={'X-API-Key': 'valid-key'})
+    assert authenticated.status_code == 200
+
+    spec_response = client.get('/openapi.json')
+    assert spec_response.status_code == 200
+    validate_spec(spec_response.json)
+    spec = spec_response.json
+    operation = spec['paths']['/protected']['get']
+    assert any('PartnerAuth' in requirement for requirement in operation.get('security', []))
+    scheme = spec['components']['securitySchemes']['PartnerAuth']
+    assert scheme['type'] == 'apiKey'
+    assert scheme['in'] == 'header'
+    assert scheme['name'] == 'X-API-Key'
