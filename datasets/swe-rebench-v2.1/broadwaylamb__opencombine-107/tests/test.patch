+//
+//  FutureTests.swift
+//  
+//
+//  Created by Max Desiatov on 24/11/2019.
+//
+
+import XCTest
+
+#if OPENCOMBINE_COMPATIBILITY_TEST
+import Combine
+#else
+import OpenCombine
+#endif
+
+@available(macOS 10.15, iOS 13.0, *)
+final class FutureTests: XCTestCase {
+    private typealias Sut = Future<Int, TestingError>
+
+    private func assertHistory(
+        _ subscriber: TrackingSubscriber,
+        equals expectedEvents: [TrackingSubscriber.Event],
+        file: StaticString = #file,
+        line: UInt = #line
+    ) {
+        guard let firstEvent = subscriber.history.first else {
+            XCTFail("Expected a subscription event", file: file, line: line)
+            return
+        }
+        guard case .subscription = firstEvent else {
+            XCTFail("Expected the first event to be a subscription", file: file, line: line)
+            return
+        }
+        XCTAssertEqual(Array(subscriber.history.dropFirst()), expectedEvents,
+                       file: file, line: line)
+    }
+
+    func testFutureSuccess() {
+        var promise: Sut.Promise?
+
+        let future = Sut { promise = $0 }
+
+        let subscriber = TrackingSubscriber(receiveSubscription: { subscription in
+            subscription.request(.unlimited)
+        })
+        future.subscribe(subscriber)
+
+        promise?(.success(42))
+
+        assertHistory(subscriber, equals: [
+            .value(42),
+            .completion(.finished)
+        ])
+    }
+
+    func testMultipleSubscribersReceiveResult() {
+        var promise: Sut.Promise?
+
+        let future = Sut { promise = $0 }
+
+        let firstSubscriber = TrackingSubscriber(receiveSubscription: { subscription in
+            subscription.request(.unlimited)
+        })
+        let secondSubscriber = TrackingSubscriber(receiveSubscription: { subscription in
+            subscription.request(.unlimited)
+        })
+
+        future.subscribe(firstSubscriber)
+        future.subscribe(secondSubscriber)
+
+        promise?(.success(42))
+
+        let expectedHistory: [TrackingSubscriber.Event] = [
+            .value(42),
+            .completion(.finished)
+        ]
+
+        assertHistory(firstSubscriber, equals: expectedHistory)
+        assertHistory(secondSubscriber, equals: expectedHistory)
+    }
+
+    func testFutureFailure() {
+        var promise: Sut.Promise?
+
+        let future = Sut { promise = $0 }
+
+        let subscriber = TrackingSubscriber(
+            receiveSubscription: { subscription in
+                subscription.request(.unlimited)
+            }, receiveValue: { _ in
+                XCTFail("no value should be returned")
+                return .none
+            }
+        )
+        future.subscribe(subscriber)
+
+        let error = TestingError(description: "\(#function)")
+        promise?(.failure(error))
+
+        assertHistory(subscriber, equals: [
+            .completion(.failure(error))
+        ])
+    }
+
+    func testResolvingMultipleTimes() {
+        var promise: Sut.Promise?
+
+        let future = Sut { promise = $0 }
+
+        let subscriber = TrackingSubscriber(receiveSubscription: { subscription in
+            subscription.request(.unlimited)
+        })
+        future.subscribe(subscriber)
+
+        promise?(.success(42))
+
+        assertHistory(subscriber, equals: [
+            .value(42),
+            .completion(.finished)
+        ])
+
+        promise?(.success(41))
+
+        assertHistory(subscriber, equals: [
+            .value(42),
+            .completion(.finished)
+        ])
+    }
+
+    func testCancellation() {
+        var promise: Sut.Promise?
+
+        let future = Sut { promise = $0 }
+
+        let subscriber = TrackingSubscriber(receiveSubscription: { subscription in
+            subscription.request(.unlimited)
+        })
+        future.subscribe(subscriber)
+
+        subscriber.subscriptions.forEach { $0.cancel() }
+
+        promise?(.success(42))
+
+        assertHistory(subscriber, equals: [])
+    }
+
+    func testSubscribeAfterResolution() {
+        var promise: Sut.Promise?
+
+        let future = Sut { promise = $0 }
+        promise?(.success(42))
+
+        let subscriber = TrackingSubscriber(receiveSubscription: { subscription in
+            subscription.request(.unlimited)
+        })
+        future.subscribe(subscriber)
+
+        assertHistory(subscriber, equals: [
+            .value(42),
+            .completion(.finished)
+        ])
+    }
+
+    func testSuccessWaitsForDemand() {
+        var promise: Sut.Promise?
+        let future = Sut { promise = $0 }
+        let subscriber = TrackingSubscriber()
+
+        future.subscribe(subscriber)
+        promise?(.success(42))
+
+        assertHistory(subscriber, equals: [])
+
+        subscriber.subscriptions.forEach { $0.request(.max(1)) }
+
+        assertHistory(subscriber, equals: [
+            .value(42),
+            .completion(.finished)
+        ])
+    }
+
+    func testValueRecursion() {
+        var promise: Sut.Promise?
+        let future = Sut { promise = $0 }
+
+        let subscriber = TrackingSubscriber(receiveSubscription: { subscription in
+            subscription.request(.unlimited)
+        }, receiveValue: {
+            promise?(.success($0 + 1))
+            return .none
+        })
+        future.subscribe(subscriber)
+
+        promise?(.success(0))
+
+        assertHistory(subscriber, equals: [
+            .value(0),
+            .completion(.finished)
+        ])
+    }
+
+    func testFinishedRecursion() {
+        var promise: Sut.Promise?
+        let future = Sut { promise = $0 }
+
+        let subscriber = TrackingSubscriber(receiveSubscription: { subscription in
+            subscription.request(.unlimited)
+        }, receiveCompletion: {
+            guard case .finished = $0 else {
+                XCTFail("future in \(#function) is not expected to fail")
+                return
+            }
+            promise?(.success(42))
+        })
+        future.subscribe(subscriber)
+
+        promise?(.success(0))
+
+        assertHistory(subscriber, equals: [
+            .value(0),
+            .completion(.finished)
+        ])
+    }
+
+    func testFailureRecursion() {
+        var promise: Sut.Promise?
+        let future = Sut { promise = $0 }
+
+        let subscriber = TrackingSubscriber(receiveSubscription: { subscription in
+            subscription.request(.unlimited)
+        }, receiveCompletion: {
+            guard case .failure = $0 else {
+                XCTFail("future in \(#function) is expected to fail")
+                return
+            }
+            promise?(.success(42))
+        })
+        future.subscribe(subscriber)
+
+        let error = TestingError(description: "\(#function)")
+
+        promise?(.failure(error))
+
+        assertHistory(subscriber, equals: [
+            .completion(.failure(error))
+        ])
+    }
+}
