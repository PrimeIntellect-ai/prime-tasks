+#[test]
+fn test_try_from_slice() {
+    use arrayvec::ArrayVec;
+    use std::convert::TryInto as _;
+
+    // A slice shorter than the capacity converts successfully.
+    let res: Result<ArrayVec<[i32; 4]>, _> = (&[1, 2, 3] as &[_]).try_into();
+    let vec = res.unwrap();
+    assert_eq!(&vec[..], &[1, 2, 3]);
+    assert_eq!(vec.capacity(), 4);
+
+    // A slice exactly at the capacity converts successfully.
+    let res: Result<ArrayVec<[i32; 3]>, _> = (&[1, 2, 3] as &[_]).try_into();
+    let vec = res.unwrap();
+    assert_eq!(&vec[..], &[1, 2, 3]);
+
+    // An empty slice converts to an empty ArrayVec.
+    let res: Result<ArrayVec<[i32; 3]>, _> = (&[] as &[i32]).try_into();
+    let vec = res.unwrap();
+    assert!(vec.is_empty());
+}
+
+#[test]
+fn test_try_from_slice_error() {
+    use arrayvec::ArrayVec;
+    use arrayvec::CapacityError;
+    use std::convert::TryInto as _;
+
+    let res: Result<ArrayVec<[i32; 2]>, CapacityError> = (&[1, 2, 3] as &[_]).try_into();
+    assert_matches!(res, Err(_));
+}
