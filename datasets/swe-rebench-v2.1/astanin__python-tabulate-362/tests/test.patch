+def test_wrap_optional_bool_strs():
+    """A string containing True remains renderable when column widths are limited."""
+    data = [
+        ["First Entry", "True"],
+        ["Second Entry", "False"],
+    ]
+    headers = ["Title", "When"]
+    result = tabulate(data, headers=headers, tablefmt="grid", maxcolwidths=[7, 5])
+
+    assert "True" in result
