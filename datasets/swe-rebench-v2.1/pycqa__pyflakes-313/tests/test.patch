+    def test_typeChecking(self):
+        """
+        Imports inside an ``if TYPE_CHECKING:`` block are not reported as
+        unused when referenced by a forward annotation.
+        """
+        self.flakes('''
+        from typing import TYPE_CHECKING
+        if TYPE_CHECKING:
+            from my_module.test_class import MyClass
+
+        object: 'MyClass' = None
+        ''')
+
 
