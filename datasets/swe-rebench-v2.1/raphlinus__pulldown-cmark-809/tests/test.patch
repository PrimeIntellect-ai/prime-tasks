+#[test]
+fn link_title_retains_text_on_following_line() {
+    let original = r##"[mylink]
+
+[mylink]: https://example.com
+'
+part of the title'
+"##;
+    let title = Parser::new(original)
+        .find_map(|event| match event {
+            Event::Start(Tag::Link { title, .. }) => Some(title),
+            _ => None,
+        })
+        .expect("the reference should parse as a link");
+    assert!(
+        title.contains("part of the title"),
+        "the link title should retain the following line, got: {title:?}"
+    );
+}
