+func TestSetupTracerSupportsMultiplePropagationFormats(t *testing.T) {
+	t.Setenv(backend.PluginTracingOpenTelemetryOTLPAddressEnv, "localhost:4317")
+	t.Setenv(backend.PluginTracingOpenTelemetryOTLPPropagationEnv, "jaeger,w3c")
+
+	require.NoError(t, backend.SetupTracer("test-plugin", tracing.Opts{}))
+
+	ctx, span := otel.Tracer("normal-sdk").Start(context.Background(), "parent")
+	defer span.End()
+	require.NotEmpty(t, trace.SpanContextFromContext(ctx).TraceID())
+
+	headers := http.Header{}
+	otel.GetTextMapPropagator().Inject(ctx, propagation.HeaderCarrier(headers))
+	require.NotEmpty(t, headers.Get("Uber-Trace-Id"))
+	require.NotEmpty(t, headers.Get("Traceparent"))
 }
