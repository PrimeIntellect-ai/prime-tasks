new file mode 100644
index 00000000..07f059d3
--- /dev/null
+++ b/tests/test/object_safe.rs
@@ -0,0 +1,29 @@
+use super::*;
+use chalk_integration::Identifier;
+
+#[test]
+fn object_safe_flag() {
+    test! {
+        program {
+            #[object_safe]
+            trait Foo {}
+            trait Bar {}
+        }
+
+        goal { ObjectSafe(Foo) } yields { "Unique" }
+        goal { not { ObjectSafe(Bar) } } yields { "Unique" }
+    }
+}
+
+#[test]
+fn object_safe_callback() {
+    let db = ChalkDatabase::with(
+        "#[object_safe] trait Foo {} trait Bar {}",
+        SolverChoice::default(),
+    );
+    let program = db.checked_program().unwrap();
+    let foo = program.trait_ids[&Identifier::from("Foo")];
+    let bar = program.trait_ids[&Identifier::from("Bar")];
+    assert!(db.is_object_safe(foo));
+    assert!(!db.is_object_safe(bar));
+}
