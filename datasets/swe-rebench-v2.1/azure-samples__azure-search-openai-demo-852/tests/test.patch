+def test_messagebuilder_insert_at_index():
+    builder = MessageBuilder("You are a bot.", "gpt-35-turbo")
+    builder.insert_message("user", "first")
+    builder.insert_message("assistant", "second", index=2)
+    builder.insert_message("user", "third", index=3)
+    assert builder.messages == [
+        {"role": "system", "content": "You are a bot."},
+        {"role": "user", "content": "first"},
+        {"role": "assistant", "content": "second"},
+        {"role": "user", "content": "third"},
+    ]
+
+
+def test_messagebuilder_insert_returns_none():
+    builder = MessageBuilder("You are a bot.", "gpt-35-turbo")
+    result = builder.insert_message("user", "Hello, how are you?")
+    assert result is None
