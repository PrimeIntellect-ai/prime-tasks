+func TestObjectTimestampsUsePythonClientFormat(t *testing.T) {
+	created := time.Date(2024, time.January, 2, 3, 4, 5, 123456789, time.UTC)
+	obj := Object{
+		BucketName: "timestamp-bucket",
+		Name:       "timestamp-object",
+		Created:    created,
+		Updated:    created,
+	}
+	runServersTest(t, []Object{obj}, func(t *testing.T, server *Server) {
+		resp, err := server.HTTPClient().Get(server.URL() + "/storage/v1/b/timestamp-bucket/o/timestamp-object")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer resp.Body.Close()
+		if resp.StatusCode != http.StatusOK {
+			t.Fatalf("unexpected HTTP status: %s", resp.Status)
+		}
+		var metadata map[string]string
+		if err := json.NewDecoder(resp.Body).Decode(&metadata); err != nil {
+			t.Fatal(err)
+		}
+		want := "2024-01-02T03:04:05.123456Z"
+		for _, field := range []string{"timeCreated", "updated"} {
+			if metadata[field] != want {
+				t.Errorf("%s timestamp = %q, want %q", field, metadata[field], want)
+			}
+		}
+	})
+}
