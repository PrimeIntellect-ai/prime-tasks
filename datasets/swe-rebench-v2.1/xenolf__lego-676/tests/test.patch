+type roundTripperFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripperFunc) RoundTrip(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+// captureUpdateURL runs Present for the given domain and returns the URL of the
+// update request that the provider sent to DuckDNS.
+func captureUpdateURL(t *testing.T, domain string) string {
+	t.Helper()
+
+	oldClient := acme.HTTPClient
+	defer func() { acme.HTTPClient = oldClient }()
+
+	var gotURL string
+	acme.HTTPClient = http.Client{
+		Transport: roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+			gotURL = req.URL.String()
+			return &http.Response{
+				StatusCode: http.StatusOK,
+				Body:       ioutil.NopCloser(strings.NewReader("OK")),
+			}, nil
+		}),
+	}
+
+	config := NewDefaultConfig()
+	config.Token = "123"
+
+	p, err := NewDNSProviderConfig(config)
+	require.NoError(t, err)
+
+	err = p.Present(domain, "", "123d==")
+	require.NoError(t, err)
+
+	return gotURL
+}
+
+func TestPresentUsesMainDomain(t *testing.T) {
+	testCases := []struct {
+		desc     string
+		domain   string
+		expected string
+	}{
+		{
+			desc:     "explicit domain: sub domain",
+			domain:   "sub.duckdns.org",
+			expected: "sub.duckdns.org",
+		},
+		{
+			desc:     "explicit domain: subsub domain",
+			domain:   "my.sub.duckdns.org",
+			expected: "sub.duckdns.org",
+		},
+		{
+			desc:     "explicit domain: subsubsub domain",
+			domain:   "my.sub.sub.duckdns.org",
+			expected: "sub.duckdns.org",
+		},
+		{
+			desc:     "wildcard domain with extra challenge label",
+			domain:   "*.my.sub.duckdns.org",
+			expected: "sub.duckdns.org",
+		},
+	}
+
+	for _, test := range testCases {
+		test := test
+		t.Run(test.desc, func(t *testing.T) {
+			gotURL := captureUpdateURL(t, test.domain)
+
+			u, err := url.Parse(gotURL)
+			require.NoError(t, err)
+			assert.Equal(t, test.expected, u.Query().Get("domains"))
+		})
+	}
+}
+
+func TestCleanUpUsesMainDomain(t *testing.T) {
+	oldClient := acme.HTTPClient
+	defer func() { acme.HTTPClient = oldClient }()
+
+	var gotURL string
+	acme.HTTPClient = http.Client{
+		Transport: roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+			gotURL = req.URL.String()
+			return &http.Response{
+				StatusCode: http.StatusOK,
+				Body:       ioutil.NopCloser(strings.NewReader("OK")),
+			}, nil
+		}),
+	}
+
+	config := NewDefaultConfig()
+	config.Token = "123"
+
+	p, err := NewDNSProviderConfig(config)
+	require.NoError(t, err)
+
+	err = p.CleanUp("my.sub.duckdns.org", "", "123d==")
+	require.NoError(t, err)
+
+	u, err := url.Parse(gotURL)
+	require.NoError(t, err)
+	assert.Equal(t, "sub.duckdns.org", u.Query().Get("domains"))
+}
