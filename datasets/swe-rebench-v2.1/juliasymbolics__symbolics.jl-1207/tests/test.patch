@@ -0,0 +1,25 @@
+using Symbolics
+
+# https://github.com/JuliaSymbolics/Symbolics.jl/issues/1206
+@testset "e f alignment in array" begin
+    r = @variables a b c d e f g h i j
+
+    io = IOBuffer()
+    td = TextDisplay(io)
+
+    display(td, r)
+    vector_lines = split(String(take!(io)), '\n')[2:end-1]
+    @test strip.(vector_lines) == string.(r)
+    vector_label_columns = [findfirst(c -> !isspace(c), line) for line in vector_lines]
+    @test length(unique(vector_label_columns)) == 1
+
+    m = [a b c d
+         b e f g
+         c f h i
+         d g i j]
+    display(td, m)
+    matrix_lines = split(String(take!(io)), '\n')[2:end-1]
+    column_starts = [findfirst(string(x), matrix_lines[1]) for x in (a, b, c, d)]
+    @test all([findfirst(string(m[i, j]), line) for j in 1:4] == column_starts
+              for (i, line) in enumerate(matrix_lines))
+end
