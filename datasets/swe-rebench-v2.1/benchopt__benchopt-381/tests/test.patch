+def test_select_dotted_dataset(tmp_path):
+    benchmark_path = tmp_path / "benchmark"
+    shutil.copytree(DUMMY_BENCHMARK_PATH, benchmark_path)
+    dotted_dataset = benchmark_path / "datasets" / "dotted_dataset.py"
+    dotted_dataset.write_text(
+        "from benchopt import BaseDataset\n"
+        "class Dataset(BaseDataset):\n"
+        "    name = 'Dotted'\n"
+        "    parameters = {'dataset': ['rcv1.binary']}\n"
+        "    def get_data(self, dataset='rcv1.binary'):\n"
+        "        return {}\n"
+    )
+
+    benchmark = Benchmark(benchmark_path)
+    benchmark.validate_dataset_patterns(["Dotted[dataset=rcv1.binary]"])
