             with pytest.raises(FrozenInstanceError):
                 i.b = "3"
+
+    def test_tuple_class_aliasing(self):
+        """
+        An attribute named ``property`` is legal, even when it is followed by
+        other attributes, when using ``auto_attribs``.
+        """
+
+        @attr.s(auto_attribs=True)
+        class C(object):
+            property: str
+            x: str
+
+        assert "property" == attr.fields(C).property.name
+        assert "x" == attr.fields(C).x.name
+
+        c = C(property="p", x="x")
+        assert "p" == c.property
+        assert "x" == c.x
