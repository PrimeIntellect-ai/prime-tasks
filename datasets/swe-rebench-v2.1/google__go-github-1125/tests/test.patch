+func TestSearchService_Repositories_withDateQualifier(t *testing.T) {
+	client, mux, _, teardown := setup()
+	defer teardown()
+
+	const q = "user:pankona created:2019-01-18T17:35:34+09:00..2019-02-18T17:35:34+09:00 fork:true"
+
+	var requestURI string
+	mux.HandleFunc("/search/repositories", func(w http.ResponseWriter, r *http.Request) {
+		testMethod(t, r, "GET")
+		testFormValues(t, r, values{
+			"q": q,
+		})
+		requestURI = r.RequestURI
+
+		fmt.Fprint(w, `{"total_count": 1, "incomplete_results": false, "items": [{"id":1}]}`)
+	})
+
+	opts := &SearchOptions{}
+	result, _, err := client.Search.Repositories(context.Background(), q, opts)
+	if err != nil {
+		t.Errorf("Search.Repositories returned error: %v", err)
+	}
+
+	if !strings.Contains(requestURI, "%2B") {
+		t.Fatalf("URI encoding failed: got %v, want literal '+' encoded as %%2B", requestURI)
+	}
+
+	want := &RepositoriesSearchResult{
+		Total:             Int(1),
+		IncompleteResults: Bool(false),
+		Repositories:      []Repository{{ID: Int64(1)}},
+	}
+	if !reflect.DeepEqual(result, want) {
+		t.Errorf("Search.Repositories returned %+v, want %+v", result, want)
+	}
+}
