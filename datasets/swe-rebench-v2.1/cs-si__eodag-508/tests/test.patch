+class TestApisPluginUsgsApi(BaseApisPluginTest):
+    def setUp(self):
+        self.provider = "usgs"
+        self.api_plugin = self.get_search_plugin(provider=self.provider)
+
+    def test_plugins_apis_usgs_download(self):
+        """S2_MSI_L1C search results can be downloaded through USGS."""
+        import io
+        import zipfile
+
+        archive = io.BytesIO()
+        with zipfile.ZipFile(archive, "w") as product_archive:
+            product_archive.writestr("sentinel/metadata.txt", "S2 product")
+
+        with mock.patch("usgs.api.login", autospec=True), mock.patch(
+            "usgs.api.logout", autospec=True
+        ), mock.patch("usgs.api.scene_search", autospec=True) as scene_search, mock.patch(
+            "usgs.api.download_options", autospec=True
+        ) as download_options, mock.patch(
+            "usgs.api.download_request", autospec=True
+        ) as download_request:
+            scene_search.return_value = {
+                "data": {
+                    "results": [
+                        {
+                            "displayId": "sentinel_product",
+                            "spatialBounds": "POINT (0 0)",
+                            "available": True,
+                            "entityId": "sentinel_entity",
+                            "id": "sentinel_product_id",
+                        }
+                    ],
+                    "totalHits": 1,
+                }
+            }
+            download_options.return_value = {"data": []}
+            download_request.return_value = {
+                "data": {
+                    "preparingDownloads": [{"url": "http://path/to/sentinel.zip"}]
+                }
+            }
+
+            @responses.activate
+            def run_download():
+                responses.add(
+                    responses.GET,
+                    "http://path/to/sentinel.zip",
+                    status=200,
+                    content_type="application/zip",
+                    body=archive.getvalue(),
+                )
+                products, total = self.api_plugin.query(
+                    productType="S2_MSI_L1C", items_per_page=1, page=1
+                )
+                self.assertEqual(total, 1)
+                self.assertEqual(len(products), 1)
+                product = products[0]
+
+                # The public product type must resolve to a Sentinel-2 dataset
+                # identifier; providers may use different identifiers for it.
+                dataset = product.properties["productType"]
+                self.assertTrue(
+                    "SENTINEL" in dataset.upper() or dataset.upper().startswith("S2")
+                )
+                downloaded = self.api_plugin.download(
+                    product, outputs_prefix=self.tmp_home_dir.name
+                )
+                self.assertTrue(os.path.exists(downloaded))
+
+            run_download()
