+    def test_issue_2819(self):
+        m = ConcreteModel()
+        m.x = Var()
+        m.z = Var()
+        m.x.fix(3.5)
+        m.c = Constraint(expr=(m.x - 4) ** 2 + (m.z - 1) ** 2 - 0.55 <= 0)
+        m.obj = Objective(expr=m.z)
+
+        output = StringIO()
+        m.write(
+            output, format='bar', io_options={'symbolic_solver_labels': True}
+        )
+        constraint = next(
+            line for line in output.getvalue().splitlines() if line.startswith('c:')
+        )
+        emitted_expression = constraint.split(':', 1)[1].split('<=', 1)[0]
+
+        # Check the expression in the generated BARON model, rather than the
+        # lower-level expression serializer.  Supplying x as well as z allows
+        # the writer to retain the fixed variable symbolically or fold it.
+        for zval in (0.0, 1.0, 2.0):
+            expected = (3.5 - 4) ** 2 + (zval - 1) ** 2 - 0.55
+            actual = eval(
+                emitted_expression.replace('^', '**'), {'x': 3.5, 'z': zval}
+            )
+            self.assertAlmostEqual(actual, expected)
+
 
