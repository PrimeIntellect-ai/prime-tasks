+
+@testset "unequal support lengths" begin
+    short = DiscreteNonParametric(collect(1:2), [0.5, 0.5])
+    long = DiscreteNonParametric(collect(1:3), [0.2, 0.4, 0.4])
+    @test !(short == long)
+    @test short != long
+end
+
+@testset "equal support and probabilities" begin
+    d1 = DiscreteNonParametric(collect(1:3), [0.2, 0.3, 0.5])
+    d2 = DiscreteNonParametric(collect(1:3), [0.2, 0.3, 0.5])
+    @test d1 == d2
+    @test !(d1 != d2)
+end
