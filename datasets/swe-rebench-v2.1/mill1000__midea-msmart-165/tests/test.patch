+    def test_properties_breeze_control_off(self) -> None:
+        """Test disabling breeze modes requests the accepted off value."""
+
+        # Create dummy device with breeze control
+        device = AC(0, 0, 0)
+        device._supported_properties.add(PropertyId.BREEZE_CONTROL)
+
+        # Capture commands sent to the device
+        lan = _CapturingLAN()
+        device._lan = lan
+
+        # Transition from Breezeless on to off
+        device.breezeless = True
+        device.breezeless = False
+        asyncio.run(device.apply())
+
+        # Find the properties command (payload begins with the property request)
+        payload = next(
+            data[10:-1] for data in lan.sent if data[10] == 0xB0)
+
+        # Parse the properties from the payload
+        props = {}
+        offset = 2
+        for _ in range(payload[1]):
+            prop_id = payload[offset] | (payload[offset + 1] << 8)
+            length = payload[offset + 2]
+            props[prop_id] = payload[offset + 3:offset + 3 + length]
+            offset += 3 + length
+
+        # Assert the breeze control property requests the accepted off value
+        self.assertEqual(
+            int.from_bytes(props[PropertyId.BREEZE_CONTROL], "little"), 0x01)
+
 
 if __name__ == "__main__":
     unittest.main()
