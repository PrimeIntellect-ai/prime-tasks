+func applyManifests(cluster resource.Cluster, inFiles, setOverlay []string, l clog.Logger) error {
+	apply := reflect.ValueOf(mesh.ApplyManifests)
+	t := apply.Type()
+	var args []reflect.Value
+	switch t.NumIn() {
+	case 2:
+		options := reflect.New(t.In(0)).Elem()
+		options.FieldByName("Client").Set(reflect.ValueOf(cluster))
+		options.FieldByName("InFilenames").Set(reflect.ValueOf(inFiles))
+		options.FieldByName("SetOverlay").Set(reflect.ValueOf(setOverlay))
+		options.FieldByName("WaitTimeout").Set(reflect.ValueOf(300 * time.Second))
+		args = []reflect.Value{options, reflect.ValueOf(l)}
+	case 7:
+		args = []reflect.Value{
+			reflect.ValueOf(inFiles), reflect.ValueOf(setOverlay), reflect.ValueOf(false),
+			reflect.ValueOf(false), reflect.ValueOf(cluster), reflect.ValueOf(300 * time.Second), reflect.ValueOf(l),
+		}
+	default:
+		return fmt.Errorf("unsupported manifest apply interface")
+	}
+	result := apply.Call(args)[0]
+	if result.IsNil() {
+		return nil
+	}
+	return result.Interface().(error)
+}
