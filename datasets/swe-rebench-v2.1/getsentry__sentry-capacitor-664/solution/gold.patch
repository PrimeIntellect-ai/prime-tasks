+/**
+ * Closes the SDK, stops sending events.
+ */
+export async function close(): Promise<void> {
+  try {
+    const client = getClient();
+
+    if (client) {
+      await client.close();
+      await NATIVE.closeNativeSdk();
+    }
+  } catch (e) {
+    logger.error('Failed to close the SDK');
+  }
+}
