+    @pytest.mark.unit
+    @pytest.mark.parametrize(
+        "args",
+        [["--wrap-descriptions", "88", "--wrap-summaries", "88", ""]],
+    )
+    def test_format_docstring_link_spacing_is_stable(self, args):
+        """Keep hyperlink spacing stable when formatting repeatedly."""
+        source = '''\
+"""Django settings for webapp project.
+
+Generated by 'django-admin startproject' using Django 4.1.1.
+
+For more information on this file, see https://docs.djangoproject.com/en/4.1/topics/settings/
+
+For the full list of settings and their values, see https://docs.djangoproject.com/en/4.1/ref/settings/
+"""
+'''
+        command = [
+            sys.executable,
+            "-m",
+            "docformatter",
+            *args[:-1],
+            "-",
+        ]
+
+        def format_source(text):
+            return subprocess.run(
+                command,
+                input=text,
+                capture_output=True,
+                check=True,
+                text=True,
+            ).stdout
+
+        targets = (
+            "https://docs.djangoproject.com/en/4.1/topics/settings/",
+            "https://docs.djangoproject.com/en/4.1/ref/settings/",
+        )
+
+        def link_spacing(text):
+            lines = text.splitlines()
+            spacing = []
+            for target in targets:
+                matching_lines = [
+                    index for index, line in enumerate(lines) if target in line
+                ]
+                assert matching_lines
+                index = matching_lines[0]
+                before = 0
+                cursor = index - 1
+                while cursor >= 0 and not lines[cursor].strip():
+                    before += 1
+                    cursor -= 1
+                after = 0
+                cursor = index + 1
+                while cursor < len(lines) and not lines[cursor].strip():
+                    after += 1
+                    cursor += 1
+                spacing.append((before, after))
+            return spacing
+
+        first_pass = format_source(source)
+        first_spacing = link_spacing(first_pass)
+        assert all(before == 0 for before, _ in first_spacing)
+
+        second_pass = format_source(first_pass)
+        assert link_spacing(second_pass) == first_spacing
+
+        third_pass = format_source(second_pass)
+        assert link_spacing(third_pass) == link_spacing(second_pass)
+
