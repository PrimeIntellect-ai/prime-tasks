+
+// invokeManagerAllocation calls the public allocation operation while allowing
+// its relay address to be represented as either a net.IP or a string.
+func invokeManagerAllocation(m *Manager, fiveTuple *FiveTuple, turnSocket net.PacketConn, relayIP net.IP, requestedPort int, lifetime time.Duration) (*Allocation, error) {
+	method := reflect.ValueOf(m).MethodByName("CreateAllocation")
+	methodType := method.Type()
+	args := make([]reflect.Value, methodType.NumIn())
+	ipType := reflect.TypeOf(net.IP(nil))
+	tupleType := reflect.TypeOf((*FiveTuple)(nil))
+	socketType := reflect.TypeOf(turnSocket)
+	durationType := reflect.TypeOf(time.Duration(0))
+	for i := range args {
+		parameter := methodType.In(i)
+		switch {
+		case parameter == tupleType:
+			args[i] = reflect.ValueOf(fiveTuple)
+		case parameter == socketType || parameter.Kind() == reflect.Interface:
+			if turnSocket == nil {
+				args[i] = reflect.Zero(parameter)
+			} else if socketType.AssignableTo(parameter) {
+				args[i] = reflect.ValueOf(turnSocket)
+			}
+		case parameter == ipType:
+			args[i] = reflect.ValueOf(relayIP)
+		case parameter.Kind() == reflect.String:
+			args[i] = reflect.ValueOf(relayIP.String())
+		case parameter.Kind() == reflect.Int:
+			args[i] = reflect.ValueOf(requestedPort).Convert(parameter)
+		case parameter == durationType:
+			args[i] = reflect.ValueOf(lifetime)
+		}
+	}
+	results := method.Call(args)
+	var allocation *Allocation
+	if !results[0].IsNil() {
+		allocation = results[0].Interface().(*Allocation)
+	}
+	if results[1].IsNil() {
+		return allocation, nil
+	}
+	return allocation, results[1].Interface().(error)
+}
