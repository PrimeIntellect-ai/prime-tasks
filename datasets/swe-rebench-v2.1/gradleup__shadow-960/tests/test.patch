+    def 'legacy plugin id is recognized so build logic reacting to it runs'() {
+        given:
+        buildFile.text = """
+            plugins {
+                id 'com.github.johnrengelman.shadow'
+            }
+
+            def legacyPluginApplied = false
+            plugins.withId('com.github.johnrengelman.shadow') {
+                legacyPluginApplied = true
+            }
+
+            if (!legacyPluginApplied) {
+                throw new GradleException('build logic reacting to the legacy plugin id did not run')
+            }
+        """.stripIndent()
+
+        expect:
+        run('help')
+    }
+
+    def 'legacy plugin performs no operations'() {
+        given:
+        Project project = ProjectBuilder.builder().build()
+        def taskNames = project.tasks.names
+        def extensionNames = project.extensions.extensionsSchema.elements.collect { it.name }
+        def extraPropertyNames = project.extensions.extraProperties.properties.keySet()
+
+        when:
+        project.plugins.apply('com.github.johnrengelman.shadow')
+
+        then:
+        project.plugins.hasPlugin('com.github.johnrengelman.shadow')
+        project.tasks.names == taskNames
+        project.extensions.extensionsSchema.elements.collect { it.name } == extensionNames
+        project.extensions.extraProperties.properties.keySet() == extraPropertyNames
+    }
+
