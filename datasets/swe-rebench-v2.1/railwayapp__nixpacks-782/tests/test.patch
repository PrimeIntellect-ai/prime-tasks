+#[test]
+fn test_scala_sbt_plan() {
+    let dir = tempdir::TempDir::new("scala-sbt").unwrap();
+    std::fs::write(dir.path().join("build.sbt"), "name := \"scala-sbt\"\n").unwrap();
+
+    let plan = nixpacks::generate_build_plan(
+        dir.path().to_str().unwrap(),
+        Vec::new(),
+        &GeneratePlanOptions::default(),
+    )
+    .unwrap();
+
+    let setup = plan.get_phase("setup").expect("setup phase");
+    let setup_pkgs = setup.nix_pkgs.clone().unwrap_or_default();
+    assert_eq!(setup_pkgs, vec!["sbt".to_string(), "jdk".to_string()]);
+
+    let build = plan.get_phase("build").expect("build phase");
+    assert_eq!(build.cmds, Some(vec!["sbt stage".to_string()]));
+    let depends_on = build.depends_on.clone().unwrap_or_default();
+    assert_eq!(depends_on, vec!["install".to_string(), "setup".to_string()]);
+    let cache_dirs = build.cache_directories.clone().unwrap_or_default();
+    assert!(cache_dirs.contains(&"/root/.sbt".to_string()));
+    assert!(cache_dirs.contains(&"/root/.ivy2/cache".to_string()));
+    assert!(cache_dirs.contains(&"/root/.cache/coursier".to_string()));
+
+    let start = plan.start_phase.clone().expect("start phase");
+    assert_eq!(
+        start.cmd,
+        Some("./target/universal/stage/bin/main".to_string())
+    );
+
+    let metadata = plan
+        .variables
+        .as_ref()
+        .and_then(|vars| vars.get("NIXPACKS_METADATA"))
+        .cloned();
+    assert_eq!(metadata, Some("scala".to_string()));
+}
