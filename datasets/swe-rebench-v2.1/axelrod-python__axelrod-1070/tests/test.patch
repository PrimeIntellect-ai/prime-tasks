+class TestGenericReactiveStrategy(unittest.TestCase):
+    """
+    Tests for the Reactive Strategy.
+    """
+
+    def test_name(self):
+        self.assertEqual(axelrod.ReactivePlayer((0, 0)).name,
+                         "Reactive Player: (0, 0)")
+        self.assertEqual(axelrod.ReactivePlayer((1, 0)).name,
+                         "Reactive Player: (1, 0)")
+        self.assertEqual(axelrod.ReactivePlayer((1, 0.5)).name,
+                         "Reactive Player: (1, 0.5)")
+
+    def test_stochastic_classification(self):
+        self.assertFalse(
+            axelrod.ReactivePlayer((0, 0)).classifier['stochastic'])
+        self.assertFalse(
+            axelrod.ReactivePlayer((1, 0)).classifier['stochastic'])
+        self.assertTrue(
+            axelrod.ReactivePlayer((1, 0.5)).classifier['stochastic'])
+
+    def test_positional_construction(self):
+        # The problem statement demonstrates ReactivePlayer((p1, p2)).
+        player = axelrod.ReactivePlayer((0.4, 0.5))
+        self.assertEqual(player.name, "Reactive Player: (0.4, 0.5)")
+
+    def test_strategy(self):
+        # A reactive player with (0, 0) cooperates on the initial move and
+        # then always defects.
+        player = axelrod.ReactivePlayer((0, 0))
+        match = axelrod.Match((player, axelrod.Cooperator()), turns=5)
+        self.assertEqual(match.play(),
+                         [(C, C)] + [(D, C)] * 4)
+
+        # A reactive player with (1, 0) behaves like tit-for-tat: it
+        # cooperates initially and then copies the opponent's last move.
+        player = axelrod.ReactivePlayer((1, 0))
+        match = axelrod.Match((player, axelrod.Alternator()), turns=5)
+        self.assertEqual(
+            match.play(),
+            [(C, C), (C, D), (D, C), (C, D), (D, C)])
+
+        # Against an always-defecting opponent it cooperates once and then
+        # defects for the rest of the match.
+        player = axelrod.ReactivePlayer((1, 0))
+        match = axelrod.Match((player, axelrod.Defector()), turns=5)
+        self.assertEqual(match.play(),
+                         [(C, D)] + [(D, D)] * 4)
+
+    def test_not_in_default_players(self):
+        self.assertNotIn(axelrod.ReactivePlayer, axelrod.strategies)
+        self.assertNotIn(axelrod.ReactivePlayer, axelrod.all_strategies)
