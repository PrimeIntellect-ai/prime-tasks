+
+// Verify that <content:encoded> is picked up when it immediately follows a media element with no whitespace separation
+#[test]
+fn test_ghost_no_ws() {
+    let data = r#"<?xml version="1.0" encoding="UTF-8"?>
+<rss xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:media="http://search.yahoo.com/mrss/" version="2.0">
+    <channel>
+        <item>
+            <media:content url="https://example.com/image.png"/><content:encoded>Example</content:encoded>
+        </item>
+    </channel>
+</rss>"#;
+    let feed = parser::parse(data.as_bytes()).unwrap();
+
+    assert_eq!(feed.entries.len(), 1);
+    let content = feed.entries[0].content.as_ref().expect("entry should have content");
+    assert_eq!(content.body.as_deref(), Some("Example"));
+    assert_eq!(content.content_type, "text/html");
+}
