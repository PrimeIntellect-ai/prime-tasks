+import { expect } from 'chai';
+import * as express from 'express';
+import * as request from 'supertest';
+import * as OpenApiValidator from '../src';
+import { OpenAPIV3 } from '../src/framework/types';
+
+describe('security validation before multipart upload processing', () => {
+  it('does not process an uploaded file when security validation rejects the request', async () => {
+    let fileProcessingStarted = false;
+    const apiSpec: OpenAPIV3.Document = {
+      openapi: '3.0.0',
+      info: { title: 'Upload API', version: '1.0.0' },
+      paths: {
+        '/upload': {
+          post: {
+            security: [{ ApiKeyAuth: [] }],
+            requestBody: {
+              required: true,
+              content: {
+                'multipart/form-data': {
+                  schema: {
+                    type: 'object',
+                    properties: { file: { type: 'string', format: 'binary' } },
+                  },
+                },
+              },
+            },
+            responses: { '200': { description: 'Uploaded' } },
+          },
+        },
+      },
+      components: {
+        securitySchemes: {
+          ApiKeyAuth: { type: 'apiKey', in: 'header', name: 'X-API-Key' },
+        },
+      },
+    };
+    const app = express();
+    app.use(
+      OpenApiValidator.middleware({
+        apiSpec,
+        validateSecurity: { handlers: { ApiKeyAuth: () => false } },
+        fileUploader: {
+          storage: {
+            _handleFile: (_req, file, callback) => {
+              fileProcessingStarted = true;
+              file.stream.resume();
+              callback(null, {});
+            },
+            _removeFile: (_req, _file, callback) => callback(null),
+          } as any,
+        },
+      }),
+    );
+    app.post('/upload', (_req, res) => res.sendStatus(200));
+    app.use((err, _req, res, _next) => res.status(err.status || 500).json({ message: err.message }));
+
+    const result = await request(app)
+      .post('/upload')
+      .attach('file', Buffer.from('upload contents'), 'upload.txt');
+
+    expect(result.statusCode).to.equal(401);
+    expect(fileProcessingStarted).to.equal(false);
+  });
+});
