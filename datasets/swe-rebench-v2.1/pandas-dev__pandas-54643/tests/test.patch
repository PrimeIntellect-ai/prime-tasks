+def test_on_bad_lines_skip_pyarrow(all_parsers):
+    parser = all_parsers
+    if parser.engine != "pyarrow":
+        pytest.skip("PyArrow-specific bad-line handling")
+
+    data = "a\n1\n1,2,3\n4\n5,6,7"
+    expected = DataFrame({"a": [1, 4]})
+    with tm.assert_produces_warning(None):
+        result = parser.read_csv(StringIO(data), on_bad_lines="skip")
+    tm.assert_frame_equal(result, expected)
+
+
+def test_on_bad_lines_callable_pyarrow(all_parsers):
+    # GH 54643
+    parser = all_parsers
+    if parser.engine != "pyarrow":
+        pytest.skip("pyarrow-specific callable signature")
+    data = "a,b\n1,2\n1,2,3\n4,5"
+    seen = []
+
+    def handler(row):
+        seen.append(row)
+        return "skip"
+
+    result = parser.read_csv(StringIO(data), on_bad_lines=handler)
+    assert seen
+    expected = DataFrame({"a": [1, 4], "b": [2, 5]})
+    tm.assert_frame_equal(result, expected)
+
+
+def test_on_bad_lines_callable_error_pyarrow(all_parsers):
+    parser = all_parsers
+    if parser.engine != "pyarrow":
+        pytest.skip("PyArrow-specific bad-line handling")
+
+    data = "a,b\n1,2\n1,2,3\n4,5"
+
+    def handler(row):
+        return "error"
+
+    with pytest.raises(Exception):
+        parser.read_csv(StringIO(data), on_bad_lines=handler)
