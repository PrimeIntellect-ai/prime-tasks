+def test_python_model_variable_dependencies() -> None:
+    @model(
+        name="@schema_name.test_model_var_dep",
+        kind="full",
+        columns={'"col"': "int"},
+        depends_on={"@schema_name.table_name"},
+    )
+    def my_model(context, **kwargs):
+        # Even though the argument is not statically resolvable, no error
+        # is raised, because the `depends_on` property is present
+        schema_name = context.var("schema_name")
+        table = context.resolve_table(f"{schema_name}.table_name")
+
+        return context.fetchdf(exp.select("*").from_(table))
+
+    m = model.get_registry()["@schema_name.test_model_var_dep"].model(
+        module_path=Path("."),
+        path=Path("."),
+        variables={"schema_name": "foo", "unused_var": "unused_value_xyz"},
+    )
+
+    rendered_name = m.name.lower()
+    assert "foo" in rendered_name
+    assert "test_model_var_dep" in rendered_name
+    assert "@schema_name" not in rendered_name
+    assert m.depends_on == {'"foo"."table_name"'}
+    # Variables the model does not reference must be ignored entirely.
+    assert "unused_value_xyz" not in str(m.python_env)
+    assert "unused_value_xyz" not in m.json()
+
+
+def test_python_model_variable_dependencies_strict_resolution() -> None:
+    @model(
+        name="bla.test_model_strict_resolution",
+        kind="full",
+        columns={'"col"': "int"},
+    )
+    def my_model(context, **kwargs):
+        schema_name = context.var("schema_name")
+        table = context.resolve_table(f"{schema_name}.table_name")
+
+        return context.fetchdf(exp.select("*").from_(table))
+
+    with pytest.raises(ConfigError):
+        model.get_registry()["bla.test_model_strict_resolution"].model(
+            module_path=Path("."),
+            path=Path("."),
+            variables={"schema_name": "foo"},
+        )
+
