+def test_file_netcdf_zip_list_to_xarray():
+    # A list of ZIP archives, each containing a single NetCDF file, must be
+    # convertible to xarray.
+    import zipfile
+
+    import numpy as np
+    import xarray as xr
+
+    with temp_directory() as tmpdir:
+        zips = []
+        for i in range(2):
+            d = os.path.join(tmpdir, f"d{i}")
+            os.makedirs(d)
+            path = os.path.join(d, "a.nc")
+            da = xr.DataArray(
+                np.arange(3) + i * 3,
+                coords={"x": np.arange(3) + i * 3},
+                name="foo",
+            )
+            da.to_dataset().to_netcdf(path)
+            zip_path = os.path.join(d, "test.zip")
+            with zipfile.ZipFile(zip_path, "w") as zipf:
+                zipf.write(path, arcname="a.nc")
+            zips.append(zip_path)
+
+        ds = from_source("file", zips)
+        out = ds.to_xarray()
+        assert isinstance(out, xr.Dataset)
+        assert "foo" in out
+
+
