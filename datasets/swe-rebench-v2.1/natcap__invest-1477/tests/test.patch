+    def test_hra_can_run_with_extracted_criteria_table(self):
+        """HRA can use the criteria table without resaving its CSV."""
+        from osgeo import ogr, osr
+        import pygeoprocessing
+        import shapely.geometry
+        from natcap.invest import hra
+
+        extracted_dir = os.path.join(self.workspace_dir, 'extracted')
+        criteria_data_dir = os.path.join(extracted_dir, 'criteria_data')
+        os.makedirs(criteria_data_dir)
+        criteria_table_path = os.path.join(extracted_dir, 'criteria.csv')
+        spatial_rating_path = os.path.join(criteria_data_dir, 'rating.tif')
+        info_table_path = os.path.join(extracted_dir, 'info.csv')
+        habitat_path = os.path.join(extracted_dir, 'habitat.tif')
+        stressor_path = os.path.join(extracted_dir, 'stressor.tif')
+        aoi_path = os.path.join(extracted_dir, 'aoi.shp')
+
+        srs = osr.SpatialReference()
+        srs.ImportFromEPSG(32610)
+        projection_wkt = srs.ExportToWkt()
+        raster_origin = (500000, 30, 0, 4100000, 0, -30)
+        for raster_path in (spatial_rating_path, habitat_path, stressor_path):
+            pygeoprocessing.numpy_array_to_raster(
+                numpy.ones((3, 3), dtype=numpy.uint8), 255, (30, -30),
+                (raster_origin[0], raster_origin[3]), projection_wkt,
+                raster_path)
+        pygeoprocessing.shapely_geometry_to_vector(
+            [shapely.geometry.box(500000, 4099910, 500090, 4100000)],
+            aoi_path, projection_wkt, 'ESRI Shapefile',
+            fields={'name': ogr.OFTString},
+            attribute_list=[{'name': 'test region'}])
+
+        with open(criteria_table_path, 'w') as table:
+            table.write(textwrap.dedent(
+                """\
+                HABITAT NAME,eelgrass,,,CRITERIA TYPE
+                HABITAT RESILIENCE ATTRIBUTES,RATING,DQ,WEIGHT,E/C
+                connectivity rate,2,2,2,C
+                ,,,,
+                HABITAT STRESSOR OVERLAP PROPERTIES,,,,
+                oil,RATING,DQ,WEIGHT,E/C
+                frequency of disturbance,2,2,2,C
+                management effectiveness,criteria_data\\rating.tif,2,1,E
+                """))
+        with open(info_table_path, 'w') as table:
+            table.write(textwrap.dedent(
+                """\
+                NAME,PATH,TYPE,STRESSOR BUFFER (meters)
+                eelgrass,habitat.tif,habitat,
+                oil,stressor.tif,stressor,30
+                """))
+
+        args = {
+            'workspace_dir': os.path.join(self.workspace_dir, 'workspace'),
+            'info_table_path': info_table_path,
+            'criteria_table_path': criteria_table_path,
+            'resolution': 30,
+            'max_rating': 3,
+            'risk_eq': 'multiplicative',
+            'decay_eq': 'linear',
+            'aoi_vector_path': aoi_path,
+            'n_overlapping_stressors': 1,
+            'visualize_outputs': False,
+        }
+        validation_warnings = hra.validate(args)
+        self.assertFalse(any(
+            'criteria_table_path' in invalid_keys
+            for invalid_keys, _message in validation_warnings))
+        try:
+            hra.execute(args)
+        except ValueError:
+            # The prepared geospatial stack can reject the generalized AOI
+            # layer during a later summary operation. The model's risk output
+            # should already exist if its criteria table was usable.
+            pass
+        total_risk_path = os.path.join(
+            args['workspace_dir'], 'outputs', 'TOTAL_RISK_Ecosystem.tif')
+        self.assertTrue(os.path.isfile(total_risk_path))
 
