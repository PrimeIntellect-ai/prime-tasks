+import EmptyLineAroundBlockquotes from '../src/rules/empty-line-around-blockquotes';
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: EmptyLineAroundBlockquotes,
+  testCases: [
+    { // accounts for https://github.com/platers/obsidian-linter/issues/668
+      testName: 'Make sure that consecutive blockquotes are not merged when a blank line is between them',
+      before: dedent`
+        > [!quote] Title 1
+        > The quote 1
+        ${''}
+        > [!quote] Title 2
+        > The quote 2
+      `,
+      after: dedent`
+        > [!quote] Title 1
+        > The quote 1
+        ${''}
+        > [!quote] Title 2
+        > The quote 2
+      `,
+    },
+    { // accounts for https://github.com/platers/obsidian-linter/issues/668
+      testName: 'Make sure that consecutive blockquotes are not merged when a blank line is between them',
+      before: dedent`
+        > [!quote] Title 1
+        > The quote 1
+        ${''}
+        > [!quote] Title 2
+        > The quote 2
+        ${''}
+        > [!quote] Title 3
+        > The quote 3
+      `,
+      after: dedent`
+        > [!quote] Title 1
+        > The quote 1
+        ${''}
+        > [!quote] Title 2
+        > The quote 2
+        ${''}
+        > [!quote] Title 3
+        > The quote 3
+      `,
+    },
+  ],
+});
+
+const rule = EmptyLineAroundBlockquotes.getRule();
+
+function expectBlankLineBetween(output: string, preceding: string, following: string): void {
+  const precedingIndex = output.indexOf(preceding);
+  const followingIndex = output.indexOf(following);
+  expect(precedingIndex).toBeGreaterThanOrEqual(0);
+  expect(followingIndex).toBeGreaterThan(precedingIndex);
+  const separator = output.slice(precedingIndex + preceding.length, followingIndex);
+  expect(separator).toMatch(/^\r?\n[ \t]*\r?\n/);
+}
+
+describe('separating blockquotes with multiple blank lines', () => {
+  it('keeps blockquotes separate when two blank lines are between them', () => {
+    const output = rule.apply(dedent`
+      > [!quote] title 1
+      > the quote 1
+      ${''}
+      ${''}
+      > [!quote] title 2
+      > the quote 2
+    `);
+
+    expectBlankLineBetween(output, '> the quote 1', '> [!quote] title 2');
+  });
+
+  it('keeps each blockquote separate when there are different multiple blank-line separators', () => {
+    const output = rule.apply(dedent`
+      > [!quote] Title 1
+      > The quote 1
+      ${''}
+      ${''}
+      > [!quote] Title 2
+      > The quote 2
+      ${''}
+      ${''}
+      ${''}
+      ${''}
+      > [!quote] Title 3
+      > The quote 3
+    `);
+
+    expectBlankLineBetween(output, '> The quote 1', '> [!quote] Title 2');
+    expectBlankLineBetween(output, '> The quote 2', '> [!quote] Title 3');
+  });
+});
