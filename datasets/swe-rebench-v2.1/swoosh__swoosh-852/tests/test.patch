+
+    email = reply_to(email, ["reply-to1@example.com", "reply-to2@example.com"])
+
+    assert SMTP2GO.deliver(email, config) == {:ok, %{id: "123456789"}}
+  end
+
+  test "deliver/1 - valid email with reply_to and custom headers",
+       %{
+         bypass: bypass,
