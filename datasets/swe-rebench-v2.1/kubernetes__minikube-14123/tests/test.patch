+// captureAddonsList runs printAddonsList with stdout redirected to a pipe and
+// returns everything that was written.
+func captureAddonsList(t *testing.T, cc *config.ClusterConfig, printDocs bool) string {
+	t.Helper()
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("failed to create pipe: %v", err)
+	}
+	old := os.Stdout
+	defer func() { os.Stdout = old }()
+	os.Stdout = w
+	printAddonsList(cc, printDocs)
+	if err := w.Close(); err != nil {
+		t.Fatalf("failed to close pipe: %v", err)
+	}
+	data, err := io.ReadAll(r)
+	if err != nil {
+		t.Fatalf("failed to read stdout: %v", err)
+	}
+	return string(data)
+}
+
+// tableRows parses the rendered addons table into rows of trimmed cells.
+func tableRows(out string) [][]string {
+	var rows [][]string
+	for _, line := range strings.Split(out, "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(line, "|") {
+			continue
+		}
+		cells := strings.Split(line, "|")
+		if len(cells) < 3 {
+			continue
+		}
+		cells = cells[1 : len(cells)-1]
+		for i := range cells {
+			cells[i] = strings.TrimSpace(cells[i])
+		}
+		rows = append(rows, cells)
+	}
+	return rows
+}
+
+// columnIndex returns the index of the named column by locating the header row.
+func columnIndex(rows [][]string, name string) int {
+	for _, row := range rows {
+		for i, c := range row {
+			if strings.EqualFold(c, name) {
+				return i
+			}
+		}
+	}
+	return -1
+}
