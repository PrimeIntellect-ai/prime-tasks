+def test_download_guessing_error_visible_without_debug(tmp_path: Path) -> None:
+    """The guessing error is displayed without ``--debug`` when verbose is enabled."""
+    from click.testing import CliRunner
+
+    from subliminal.cli import subliminal as cli
+
+    runner = CliRunner()
+    # A name that guessit cannot turn into a complete video guess
+    path = tmp_path / 'video.mkv'
+    result = runner.invoke(
+        cli,
+        ['--cache-dir', str(tmp_path / 'cache'), 'download', '-l', 'en', '-v', '--name', 'S01', str(path)],
+    )
+    # The contract only requires the error to be displayed; the exit status is not specified.
+    assert 'Insufficient data to process the guess' in result.output
+
+
