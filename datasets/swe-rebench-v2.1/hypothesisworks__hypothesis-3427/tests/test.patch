+def test_deadline_exceeded_is_picklable_with_runtime_and_deadline():
+    runtime = timedelta(seconds=1.5)
+    deadline = timedelta(seconds=1.0)
+    exc = errors.DeadlineExceeded(runtime=runtime, deadline=deadline)
+
+    restored = pickle.loads(pickle.dumps(exc))
+
+    assert isinstance(restored, errors.DeadlineExceeded)
+    assert restored.runtime == runtime
+    assert restored.deadline == deadline
+
+
+def test_failed_health_check_is_picklable_with_message():
+    @settings(database=None)
+    @given(st.integers().filter(lambda _: False))
+    def test(_):
+        pass
+
+    with pytest.raises(errors.FailedHealthCheck) as exc:
+        test()
+
+    restored = pickle.loads(pickle.dumps(exc.value))
+
+    assert isinstance(restored, errors.FailedHealthCheck)
+    assert str(restored) == str(exc.value)
