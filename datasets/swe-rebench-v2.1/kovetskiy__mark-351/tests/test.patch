+func TestStripLinebreaksPreservesHardBreaks(t *testing.T) {
+	input := "<!-- Space: TEST -->\n<!-- Title: test -->\n\n" +
+		"Soft break\ncontinues\n\nHard break  \nstays\n"
+	filename := filepath.Join(t.TempDir(), "breaks.md")
+	if err := os.WriteFile(filename, []byte(input), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	cmd := osexec.Command("go", "run", "../..", "--compile-only", "--files", filename, "--strip-linebreaks")
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("compile-only rendering failed: %v\n%s", err, output)
+	}
+
+	rendered := html.UnescapeString(string(output))
+	assert.Regexp(t, `Soft break[ \t]+continues`, rendered,
+		"a semantic soft line break should become whitespace")
+	hardBreakText := strings.Index(rendered, "Hard break")
+	hardBreakTag := strings.Index(rendered, "<br")
+	textAfterHardBreak := strings.Index(rendered, "stays")
+	assert.True(t, hardBreakText >= 0 && hardBreakTag > hardBreakText && textAfterHardBreak > hardBreakTag,
+		"a deliberate Markdown hard break must remain between its surrounding text")
+}
