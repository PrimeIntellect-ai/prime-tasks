+func loadData(t *testing.T, filename, variant string) ([]byte, string, []byte) {
+	t.Helper()
+	basename := filepath.Base(filename)
+	testname := strings.TrimSuffix(basename, ".md")
+	htmlname := filepath.Join(filepath.Dir(filename), testname+variant+".html")
+
+	markdown, err := os.ReadFile(filename)
+	if err != nil {
+		panic(err)
+	}
+	html, err := os.ReadFile(htmlname)
+	if err != nil {
+		panic(err)
+	}
+
+	return markdown, htmlname, html
+}
+
+// Use the pre-existing rendering entry point without making its newer optional
+// soft-break control part of the compatibility requirement for these checks.
+func compileMarkdownDefault(markdown []byte, lib *stdlib.Lib, path string) string {
+	compile := reflect.ValueOf(CompileMarkdown)
+	args := []reflect.Value{
+		reflect.ValueOf(markdown),
+		reflect.ValueOf(lib),
+		reflect.ValueOf(path),
+		reflect.ValueOf(""),
+		reflect.ValueOf(1.0),
+	}
+	switch compile.Type().NumIn() {
+	case 6:
+		args = append(args, reflect.ValueOf(false))
+	case 7:
+		args = append(args, reflect.ValueOf(false), reflect.ValueOf(false))
+	default:
+		panic("unsupported CompileMarkdown invocation")
+	}
+	return compile.Call(args)[0].String()
+}
