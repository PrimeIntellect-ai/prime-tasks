diff --git a/tests/shared/src/test/scala/scala/meta/tests/parsers/TermSuite.scala b/tests/shared/src/test/scala/scala/meta/tests/parsers/TermSuite.scala
index 1f5a0e89b..d7aaa8f34 100644
--- a/tests/shared/src/test/scala/scala/meta/tests/parsers/TermSuite.scala
+++ b/tests/shared/src/test/scala/scala/meta/tests/parsers/TermSuite.scala
@@ -1437,4 +1437,21 @@ class TermSuite extends ParseSuite {
     }
   }
 
+  test("implicit closure with ascribe") {
+    val code = """|foo {
+                  |  implicit a => implicit b => {
+                  |    case bar => baz
+                  |  }: qux
+                  |}
+                  |""".stripMargin
+    val tree = term(code)
+    val ascriptions = tree.collect {
+      case ascribe: Term.Ascribe if ascribe.tpe.structure == Type.Name("qux").structure => ascribe
+    }
+    assert(ascriptions.size == 1)
+    val partialFunctions = ascriptions.head.expr.collect { case pf: Term.PartialFunction => pf }
+    assert(partialFunctions.size == 1)
+    assert(partialFunctions.head.cases.map(_.body.structure) == List(Term.Name("baz").structure))
+  }
+
 }
