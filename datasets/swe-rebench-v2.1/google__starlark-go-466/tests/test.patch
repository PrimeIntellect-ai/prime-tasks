diff --git a/starlark/testdata/json.star b/starlark/testdata/json.star
index 4f66637..c74e5a6 100644
--- a/starlark/testdata/json.star
+++ b/starlark/testdata/json.star
@@ -3,7 +3,11 @@
 load("assert.star", "assert")
 load("json.star", "json")
 
-assert.eq(dir(json), ["decode", "encode", "indent"])
+# Existing JSON operations remain available; callers may also get an
+# invalid-input handling API such as a validity predicate.
+assert.eq("decode" in dir(json), True)
+assert.eq("encode" in dir(json), True)
+assert.eq("indent" in dir(json), True)
 
 # Some of these cases were inspired by github.com/nst/JSONTestSuite.
 
@@ -111,6 +115,34 @@ decode_error('{"one": 1,', "unexpected end of file")
 decode_error('{"one": 1, }', "unexpected character '}'")
 decode_error('{"one": 1]', "in object, got ']', want ',' or '}'")
 
+## Handling invalid JSON
+
+def check_invalid_json_handling():
+    valid_json = '{"valid": "json"}'
+    invalid_json = '{"invalid": "json"'
+    extras = [name for name in dir(json)
+              if name not in ("decode", "encode", "indent")]
+    if extras:
+        # A validity API may have any name and any return shape; it is
+        # handled if its result distinguishes valid from invalid input.
+        handled = False
+        for name in extras:
+            f = getattr(json, name)
+            if f(valid_json) != f(invalid_json):
+                handled = True
+        assert.eq(handled, True)
+    else:
+        # Otherwise, decode must accept an explicit fallback for malformed input.
+        assert.eq(json.decode(valid_json, default="fallback"), {"valid": "json"})
+        assert.eq(json.decode(invalid_json, default="fallback"), "fallback")
+        assert.eq(json.decode(invalid_json, default=None), None)
+
+check_invalid_json_handling()
+
+# Valid JSON still decodes correctly when it contains nested values.
+assert.eq(json.decode('{"label":"sample","items":[1,true,null]}'),
+          {"label": "sample", "items": [1, True, None]})
+
 def codec(x):
     return json.decode(json.encode(x))
 
