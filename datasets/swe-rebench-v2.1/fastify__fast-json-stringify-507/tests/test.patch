+
+test('nested schema should overwrite anchor scope', (t) => {
+  t.plan(2)
+
+  const externalSchema = {
+    root: {
+      $id: 'root',
+      definitions: {
+        subschema: {
+          $id: 'subschema',
+          definitions: {
+            anchorSchema: {
+              $id: '#anchor',
+              type: 'string'
+            }
+          }
+        }
+      }
+    }
+  }
+
+  const data = 'test'
+  const stringify = build({ $ref: 'subschema#anchor' }, { schema: externalSchema })
+  const output = stringify(data)
+
+  t.equal(output, JSON.stringify(data))
+  t.throws(() => build({ $ref: 'root#anchor' }, { schema: externalSchema }))
+})
+
+test('schema reference compilation scales with the number of references', (t) => {
+  t.plan(1)
+
+  function buildWithReferences (count) {
+    const externalSchema = {}
+    const properties = {}
+    for (let i = 0; i < count; i++) {
+      externalSchema['ext' + i] = {
+        $id: 'ext' + i,
+        type: 'object',
+        properties: { a: { type: 'string' }, b: { type: 'number' } }
+      }
+      properties['p' + i] = { $ref: 'ext' + i + '#' }
+    }
+    build({ type: 'object', properties }, { schema: externalSchema })
+  }
+
+  function medianCompilationTime (count) {
+    const samples = []
+    for (let i = 0; i < 3; i++) {
+      const start = process.hrtime.bigint()
+      buildWithReferences(count)
+      samples.push(Number(process.hrtime.bigint() - start) / 1e6)
+    }
+    samples.sort((a, b) => a - b)
+    return samples[1]
+  }
+
+  // Warm up both workload sizes before measuring to reduce JIT and startup noise.
+  buildWithReferences(500)
+  buildWithReferences(4000)
+
+  const smallMs = medianCompilationTime(500)
+  const largeMs = medianCompilationTime(4000)
+
+  t.ok(
+    largeMs < smallMs * 10 + 100,
+    `compiling eight times as many references took ${largeMs.toFixed(1)}ms ` +
+    `after ${smallMs.toFixed(1)}ms for the smaller schema`
+  )
+})
