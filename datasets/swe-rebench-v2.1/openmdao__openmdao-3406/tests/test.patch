@@ -2056,6 +2056,99 @@ class TestProblem(unittest.TestCase):
         self.assertTrue('-20.' in output[14]) # con
         self.assertTrue('3.18' in output[21]) # obj
 
+    def test_list_driver_vars_driver_scaling_bounds(self):
+        prob = om.Problem()
+        model = prob.model
+
+        ivc = om.IndepVarComp()
+        ivc.add_output('x', 35.0, units='degF')
+
+        model.add_subsystem('p', ivc, promotes=['x'])
+        model.add_subsystem('comp1', om.ExecComp('y1 = 2.0*x',
+                                                 x={'val': 2.0, 'units': 'degF'},
+                                                 y1={'val': 2.0, 'units': 'degF'}),
+                            promotes=['x', 'y1'])
+
+        model.add_subsystem('comp2', om.ExecComp('y2 = 3.0*x',
+                                                 x={'val': 2.0, 'units': 'degF'},
+                                                 y2={'val': 2.0, 'units': 'degF'}),
+                            promotes=['x', 'y2'])
+
+        model.add_design_var('x', units='degC', lower=0.0, upper=100.0, scaler=3.5, adder=77.0)
+        model.add_constraint('y1', units='degC', lower=0.0, upper=100.0, scaler=3.5, adder=77.0)
+        model.add_objective('y2', units='degC', scaler=3.5, adder=77.0)
+
+        recorder = om.SqliteRecorder('cases.sql')
+        prob.driver.add_recorder(recorder)
+
+        prob.driver.recording_options['record_objectives'] = True
+        prob.driver.recording_options['record_constraints'] = True
+        prob.driver.recording_options['record_desvars'] = True
+
+        prob.setup()
+
+        prob.run_driver()
+
+        def _row(output, name):
+            for line in output:
+                fields = line.split()
+                if fields and fields[0] == name:
+                    return fields
+            self.fail(f"no row found for {name!r} in list_driver_vars output")
+
+        # Driver Scaling: bounds are reported after applying the driver's scaler and adder.
+        stdout = sys.stdout
+        strout = StringIO()
+        sys.stdout = strout
+
+        try:
+            prob.list_driver_vars(desvar_opts=['lower', 'upper'], cons_opts=['lower', 'upper'])
+        finally:
+            sys.stdout = stdout
+        output = strout.getvalue().split('\n')
+
+        # columns are: name, val, size, lower, upper
+        x_row = _row(output, 'x')
+        self.assertAlmostEqual(float(x_row[1].strip('[]')), 275.33333333, places=4)  # value
+        self.assertAlmostEqual(float(x_row[3]), 269.5)   # lower bound: (0 + 77) * 3.5
+        self.assertAlmostEqual(float(x_row[4]), 619.5)   # upper bound: (100 + 77) * 3.5
+
+        y1_row = _row(output, 'y1')
+        self.assertAlmostEqual(float(y1_row[1].strip('[]')), 343.38888889, places=4)  # value
+        self.assertAlmostEqual(float(y1_row[3]), 269.5)  # lower bound
+        self.assertAlmostEqual(float(y1_row[4]), 619.5)  # upper bound
+
+        y2_row = _row(output, 'y2')
+        self.assertAlmostEqual(float(y2_row[1].strip('[]')), 411.44444444, places=4)  # value
+
+        # Model Scaling: bounds are reported in the model (un-scaled) units.  Depending on
+        # whether the implementation reports them in the units the design var/constraint was
+        # declared in (degC) or in the units of the underlying model variable (degF), the
+        # un-scaled bounds are either (0, 100) or (32, 212).
+        stdout = sys.stdout
+        strout = StringIO()
+        sys.stdout = strout
+
+        try:
+            prob.list_driver_vars(driver_scaling=False, desvar_opts=['lower', 'upper'],
+                                  cons_opts=['lower', 'upper'])
+        finally:
+            sys.stdout = stdout
+        output = strout.getvalue().split('\n')
+
+        x_row = _row(output, 'x')
+        self.assertAlmostEqual(float(x_row[1].strip('[]')), 35.0, places=4)  # value
+        self.assertIn(float(x_row[3]), (0.0, 32.0))     # lower bound, un-scaled
+        self.assertIn(float(x_row[4]), (100.0, 212.0))  # upper bound, un-scaled
+
+        y1_row = _row(output, 'y1')
+        self.assertAlmostEqual(float(y1_row[1].strip('[]')), 70.0, places=4)  # value
+        self.assertIn(float(y1_row[3]), (0.0, 32.0))     # lower bound, un-scaled
+        self.assertIn(float(y1_row[4]), (100.0, 212.0))  # upper bound, un-scaled
+
+        y2_row = _row(output, 'y2')
+        self.assertAlmostEqual(float(y2_row[1].strip('[]')), 105.0, places=4)  # value
+
     def test_feature_list_driver_vars(self):
 
