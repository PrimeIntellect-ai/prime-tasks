diff --git a/src/config_test.rs b/src/config_test.rs
index 12233b2..9de7711 100644
--- a/src/config_test.rs
+++ b/src/config_test.rs
@@ -268,4 +268,71 @@ mod get_hook_script_tests {
         let result = get_hook_script(contents, "pre-commit");
         assert_eq!(result.unwrap(), "cargo test");
     }
+
+    #[test]
+    fn returns_result_when_value_array() {
+        let contents = r#"[hooks]
+            pre-commit = [
+                "cargo test",
+                "cargo fmt"
+            ]
+        "#;
+        let script = get_hook_script(contents, "pre-commit").unwrap();
+        let first_command = script.find("cargo test").unwrap();
+        let second_command = script.find("cargo fmt").unwrap();
+        assert!(first_command < second_command);
+    }
+
+    #[test]
+    fn returns_error_when_wrong_value_array() {
+        let contents = r#"[hooks]
+            pre-commit = [
+                "cargo test",
+                8
+            ]
+        "#;
+        let result = get_hook_script(contents, "pre-commit");
+        assert!(result.is_err());
+    }
+
+    #[test]
+    fn run_executes_each_command_in_an_array_in_order() {
+        let output_path = format!("/tmp/rusty-hook-array-commands-{}", std::process::id());
+        let _ = std::fs::remove_file(&output_path);
+        let contents = format!(
+            "[hooks]\npre-commit = [\n  \"printf first >> {}\",\n  \"printf second >> {}\"\n]",
+            output_path, output_path
+        );
+        let run_command = |command: &str, _directory: Option<&str>, _stream_io: bool| {
+            if command == "git rev-parse --show-toplevel" {
+                return Ok(Some(String::from("/tmp")));
+            }
+            let result = std::process::Command::new("sh")
+                .arg("-c")
+                .arg(command)
+                .output()
+                .unwrap();
+            if result.status.success() {
+                Ok(Some(String::from_utf8_lossy(&result.stdout).into_owned()))
+            } else {
+                Err(Some(String::from_utf8_lossy(&result.stderr).into_owned()))
+            }
+        };
+        let file_exists = |_path: &str| Ok(true);
+        let read_file = |_path: &str| Ok(contents.clone());
+        let log = |_message: &str, _enabled: bool| {};
+
+        let result = crate::rusty_hook::run(
+            run_command,
+            file_exists,
+            read_file,
+            log,
+            "pre-commit",
+        );
+        assert!(result.is_ok());
+        let output = std::fs::read_to_string(&output_path).unwrap();
+        let _ = std::fs::remove_file(&output_path);
+
+        assert_eq!(output, "firstsecond");
+    }
 }
