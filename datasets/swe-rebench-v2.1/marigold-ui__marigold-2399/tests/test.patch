diff --git a/packages/components/src/Table/Table.test.tsx b/packages/components/src/Table/Table.test.tsx
index 3ae60813..3a0fbf54 100644
--- a/packages/components/src/Table/Table.test.tsx
+++ b/packages/components/src/Table/Table.test.tsx
@@ -292,3 +292,99 @@ test('allows to strecht to fit container', () => {
   const table = screen.getAllByRole(/grid/);
   expect(table[0]).toHaveStyle(`width: 100%`);
 });
+
+test('defaults to a non-interactive table when selectionMode is omitted', () => {
+  render(
+    <Table aria-label="Default table">
+      <Table.Header>
+        <Table.Column>Name</Table.Column>
+      </Table.Header>
+      <Table.Body>
+        <Table.Row key="Alice">
+          <Table.Cell>Alice</Table.Cell>
+        </Table.Row>
+      </Table.Body>
+    </Table>
+  );
+
+  expect(screen.getAllByRole('row')[1]).toHaveStyle('cursor: text');
+});
+
+test('supports non-interactive table', async () => {
+  render(
+    <Table
+      aria-label="Non-interactive table"
+      selectionMode="none"
+      disabledKeys={['Jane']}
+    >
+      <Table.Header>
+        <Table.Column>Name</Table.Column>
+      </Table.Header>
+      <Table.Body>
+        <Table.Row key="Alice">
+          <Table.Cell>Alice</Table.Cell>
+        </Table.Row>
+        <Table.Row key="Jane">
+          <Table.Cell>Jane</Table.Cell>
+        </Table.Row>
+      </Table.Body>
+    </Table>
+  );
+
+  const rows = screen.getAllByRole('row');
+  expect(rows[1]).toHaveStyle('cursor: text');
+  expect(rows[2]).toHaveStyle('cursor: text'); // Disabled, but still selectable text
+});
+
+test('cursor indicates interactivity', async () => {
+  render(
+    <Table
+      aria-label="Interactive table"
+      selectionMode="single"
+      disabledKeys={['Jane']}
+    >
+      <Table.Header>
+        <Table.Column>Name</Table.Column>
+      </Table.Header>
+      <Table.Body>
+        <Table.Row key="Alice">
+          <Table.Cell>Alice</Table.Cell>
+        </Table.Row>
+        <Table.Row key="Jane">
+          <Table.Cell>Jane</Table.Cell>
+        </Table.Row>
+      </Table.Body>
+    </Table>
+  );
+
+  const rows = screen.getAllByRole('row');
+  expect(rows[1]).toHaveStyle('cursor: pointer');
+  expect(rows[2]).toHaveStyle('cursor: default');
+});
+
+test('non-interactive table allows selecting cell text', () => {
+  render(
+    <Table
+      aria-label="Non-interactive table"
+      selectionMode="none"
+      disabledKeys={['Jane']}
+    >
+      <Table.Header>
+        <Table.Column>Name</Table.Column>
+      </Table.Header>
+      <Table.Body>
+        <Table.Row key="Alice">
+          <Table.Cell>Alice</Table.Cell>
+        </Table.Row>
+        <Table.Row key="Jane">
+          <Table.Cell>Jane</Table.Cell>
+        </Table.Row>
+      </Table.Body>
+    </Table>
+  );
+
+  // The browser only starts a text selection when the default of the
+  // mousedown event is not prevented.
+  expect(fireEvent.mouseDown(screen.getByText('Alice'))).toBe(true);
+  expect(fireEvent.mouseDown(screen.getByText('Jane'))).toBe(true);
+});
