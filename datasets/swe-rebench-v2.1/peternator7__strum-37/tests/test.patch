+extern crate strum;
+#[macro_use]
+extern crate strum_macros;
+
+use strum::{EnumCount, IntoEnumIterator};
+
+#[derive(Debug, EnumCount, EnumIter)]
+enum Week {
+    Sunday,
+    Monday,
+    Tuesday,
+    Wednesday,
+    Thursday,
+    Friday,
+    Saturday,
+}
+
+#[test]
+fn simple_test() {
+    assert_eq!(7, Week::count());
+    assert_eq!(Week::count(), WEEK_COUNT);
+    assert_eq!(Week::iter().count(), WEEK_COUNT);
+}
+
+// The generated count constant must be usable in compile-time contexts such as
+// enum discriminants and static array lengths.
+#[derive(EnumCount)]
+enum Aa {}
+
+#[derive(EnumCount)]
+enum Bb {
+    B0 = AA_COUNT as _,
+}
+
+#[repr(u8)]
+#[derive(EnumCount)]
+enum Cc {
+    C0 = AA_COUNT as _,
+    C1 = BB_COUNT as _,
+}
+
+#[repr(usize)]
+#[derive(EnumCount)]
+enum Dd {
+    D0 = AA_COUNT,
+    D1 = BB_COUNT,
+    D2 = CC_COUNT,
+}
+
+static DD_ARRAY: [u8; DD_COUNT] = [0; DD_COUNT];
+
+#[test]
+fn empty_enum_count() {
+    assert_eq!(0, Aa::count());
+    assert_eq!(0, AA_COUNT);
+}
+
+#[test]
+fn count_constant_in_compile_time_contexts() {
+    assert_eq!(1, Bb::count());
+    assert_eq!(2, Cc::count());
+    assert_eq!(3, Dd::count());
+    assert_eq!(DD_ARRAY.len(), 3);
+}
+
+#[derive(EnumCount)]
+enum WithFields {
+    Unit,
+    Tuple(u8),
+    Struct { value: bool },
+}
+
+#[test]
+fn counts_field_bearing_variants() {
+    assert_eq!(3, WithFields::count());
+    assert_eq!(3, WITHFIELDS_COUNT);
+}
