+
+def test_compact_files_cache_cleanup(archivers, request):
+    """Test that files cache files for deleted archives are removed during compact."""
+    archiver = request.getfixturevalue(archivers)
+
+    # Create repository and archives
+    cmd(archiver, "repo-create", RK_ENCRYPTION)
+    create_src_archive(archiver, "archive1")
+    create_src_archive(archiver, "archive2")
+    create_src_archive(archiver, "archive3")
+
+    # Get repository ID
+    output = cmd(archiver, "repo-info")
+    for line in output.splitlines():
+        if "Repository ID:" in line:
+            repo_id = line.split(":", 1)[1].strip()
+            break
+    else:
+        pytest.fail("Could not find repository ID in info output")
+
+    # Check cache directory for files cache files
+    cache_dir = os.path.join(get_cache_dir(), repo_id)
+    if not os.path.exists(cache_dir):
+        pytest.skip("Cache directory does not exist, skipping test")
+
+    # Record the files-cache entries created for these archives.
+    def cache_files():
+        try:
+            return {name for name in os.listdir(cache_dir) if name.startswith("files.")}
+        except (FileNotFoundError, PermissionError):
+            pytest.skip("Could not access cache directory")
+
+    initial_cache_files = cache_files()
+    if not initial_cache_files:
+        pytest.skip("No files-cache entries were created")
+
+    # Delete all archives, leaving their archive series without any archives.
+    for name in ("archive1", "archive2", "archive3"):
+        cmd(archiver, "delete", "-a", name)
+
+    # Run compact and verify both the user-visible notification and cleanup.
+    output = cmd(archiver, "compact", "-v")
+    assert "Cleaning up files cache" in output
+
+    remaining_cache_files = cache_files()
+    assert not remaining_cache_files
