+def test_default_use_reduces_average_masking():
+    sample_len = 4096
+    samples_in = np.ones(sample_len, dtype=np.float32)
+    sample_rate = 16000
+
+    # Compare ordinary default calls with the previous default mask range.
+    # Averaging also includes the transform's default probability of application.
+    def average_removed_amplitude(augmenter):
+        removed = []
+        for _ in range(1000):
+            samples_out = augmenter(samples=samples_in, sample_rate=sample_rate)
+            removed.append(float(np.mean(samples_in - samples_out)))
+        return float(np.mean(removed))
+
+    current_defaults = TimeMask()
+    previous_defaults = TimeMask(min_band_part=0.0, max_band_part=0.5, p=0.5)
+
+    rng_state = random.getstate()
+    random.seed(18721)
+    current_average = average_removed_amplitude(current_defaults)
+    random.seed(18721)
+    previous_average = average_removed_amplitude(previous_defaults)
+    random.setstate(rng_state)
+
+    assert current_average < previous_average
+
+
