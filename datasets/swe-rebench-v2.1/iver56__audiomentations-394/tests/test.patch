+def test_apply_time_mask_returns_new_array():
+    sample_len = 1000
+    samples_in = np.random.normal(0, 1, size=sample_len).astype(np.float32)
+    samples_in_before = samples_in.copy()
+    sample_rate = 8000
+    augmenter = TimeMask(
+        min_band_part=0.1,
+        max_band_part=0.1,
+        p=1.0,
+    )
+
+    samples_out = augmenter(samples=samples_in, sample_rate=sample_rate)
+
+    # The transform must not mutate its input and must return a new array
+    assert samples_out is not samples_in
+    assert np.array_equal(samples_in, samples_in_before)
+    assert samples_out.shape == samples_in.shape
+    assert samples_out.dtype == samples_in.dtype
+
+
