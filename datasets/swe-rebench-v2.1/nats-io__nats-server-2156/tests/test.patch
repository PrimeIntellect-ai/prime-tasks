+func TestLeafNodeRandomRemotes(t *testing.T) {
+	// 16! possible permutations.
+	orderedURLs := make([]string, 0, 16)
+	for i := 0; i < cap(orderedURLs); i++ {
+		orderedURLs = append(orderedURLs, fmt.Sprintf("nats-leaf://host%d:7422", i))
+	}
+
+	var sb strings.Builder
+	sb.WriteString("leafnodes {\n  remotes = [\n    {\n      urls: [\n")
+	for _, u := range orderedURLs {
+		fmt.Fprintf(&sb, "        %q\n", u)
+	}
+	sb.WriteString("      ]\n    }\n  ]\n}\n")
+
+	conf := createConfFile(t, []byte(sb.String()))
+	defer removeFile(t, conf)
+
+	s, o := RunServerWithConfig(conf)
+	s.Shutdown()
+
+	got := o.LeafNode.Remotes[0].URLs
+	if got, want := len(got), len(orderedURLs); got != want {
+		t.Fatalf("Unexpected len URLs, got %d, want %d", got, want)
+	}
+
+	// Shuffling may preserve the input order by chance, but must preserve the URL list.
+	wantURLs := make(map[string]int, len(orderedURLs))
+	for _, u := range orderedURLs {
+		wantURLs[u]++
+	}
+	for _, u := range got {
+		if wantURLs[u.String()] == 0 {
+			t.Fatalf("Unexpected or duplicate URL %s", u)
+		}
+		wantURLs[u.String()]--
+	}
+	for u, count := range wantURLs {
+		if count != 0 {
+			t.Fatalf("URL %s is missing", u)
+		}
+	}
+}
