diff --git a/test/common/unit.js b/test/common/unit.js
index 9c18eec..6ec25be 100644
--- a/test/common/unit.js
+++ b/test/common/unit.js
@@ -1,11 +1,14 @@
 'use strict'
 
-/* globals describe, it */
+/* globals describe, it, afterEach */
 
 const sql = require('../../')
 const assert = require('assert')
 const udt = require('../../lib/udt')
 const BasePool = require('../../lib/base/connection-pool')
+const tds = require('tedious')
+const { EventEmitter } = require('events')
+const { LocalDate, LocalDateTime, ZonedDateTime, ZoneId } = require('@js-joda/core')
 
 describe('Unit', () => {
   it('table', done => {
@@ -352,3 +355,114 @@ describe('config cloning', () => {
     assert.notDeepStrictEqual(options, pool.config.options)
   })
 })
+
+describe('value handlers', () => {
+  afterEach('reset valueHandler', () => {
+    sql.valueHandler.clear()
+  })
+
+  const queryColumns = (columns, callback) => {
+    const metadata = columns.map(column => column.metadata)
+    const connection = new EventEmitter()
+    connection.collation = 'SQL_Latin1_General_CP1_CI_AS'
+    connection.execSql = request => {
+      request.emit('columnMetadata', metadata)
+      request.emit('row', columns)
+      request.emit('done', 1, false)
+      request.callback(null, 1, [])
+    }
+    const pool = {
+      connected: true,
+      collation: 'SQL_Latin1_General_CP1_CI_AS',
+      acquire: (request, cb) => cb(null, connection),
+      release: () => {}
+    }
+    new sql.Request(pool).query('SELECT 1', callback)
+  }
+  it('can set a value handler', () => {
+    assert.strictEqual(sql.valueHandler instanceof Map, true)
+    assert.strictEqual(sql.valueHandler.size, 0)
+    const returned = sql.valueHandler.set(sql.TYPES.Int, (value) => value.toUpperCase())
+    assert.strictEqual(returned, sql.valueHandler)
+    assert.strictEqual(sql.valueHandler.size, 1)
+    assert.strictEqual(sql.valueHandler.has(sql.TYPES.Int), true)
+  })
+  it('can chain value handler registration', () => {
+    const returned = sql.valueHandler
+      .set(sql.TYPES.Int, (value) => value)
+      .set(sql.TYPES.BigInt, (value) => value)
+    assert.strictEqual(returned, sql.valueHandler)
+    assert.strictEqual(sql.valueHandler.size, 2)
+  })
+  it('can delete a value handler', () => {
+    assert.strictEqual(sql.valueHandler instanceof Map, true)
+    assert.strictEqual(sql.valueHandler.size, 0)
+    sql.valueHandler.set(sql.TYPES.Int, (value) => value.toUpperCase())
+    assert.strictEqual(sql.valueHandler.size, 1)
+    assert.strictEqual(sql.valueHandler.has(sql.TYPES.Int), true)
+    assert.strictEqual(sql.valueHandler.delete(sql.TYPES.Int), true)
+    assert.strictEqual(sql.valueHandler.has(sql.TYPES.Int), false)
+    assert.strictEqual(sql.valueHandler.size, 0)
+    assert.strictEqual(sql.valueHandler.delete(sql.TYPES.Int), false)
+  })
+  it('can reset all value handlers', () => {
+    assert.strictEqual(sql.valueHandler instanceof Map, true)
+    assert.strictEqual(sql.valueHandler.size, 0)
+    sql.valueHandler.set(sql.TYPES.Int, (value) => value.toUpperCase())
+    sql.valueHandler.set(sql.TYPES.BigInt, (value) => value.toUpperCase())
+    assert.strictEqual(sql.valueHandler.size, 2)
+    assert.strictEqual(sql.valueHandler.has(sql.TYPES.Int), true)
+    assert.strictEqual(sql.valueHandler.has(sql.TYPES.BigInt), true)
+    assert.strictEqual(sql.valueHandler.clear(), undefined)
+    assert.strictEqual(sql.valueHandler.size, 0)
+  })
+  it('applies a registered handler to every matching returned cell', done => {
+    sql.valueHandler.set(sql.TYPES.Int, value => value == null ? 'handled null' : value + 1)
+
+    const columns = [
+      { metadata: { colName: 'first', type: tds.TYPES.Int, dataLength: 4, scale: 0, precision: 0, flags: 0 }, value: 41 },
+      { metadata: { colName: 'second', type: tds.TYPES.Int, dataLength: 4, scale: 0, precision: 0, flags: 0 }, value: 72 },
+      { metadata: { colName: 'nullValue', type: tds.TYPES.Int, dataLength: 4, scale: 0, precision: 0, flags: 0 }, value: null }
+    ]
+    queryColumns(columns, (err, result) => {
+      if (err) return done(err)
+      try {
+        assert.strictEqual(result.recordset.length, 1)
+        assert.strictEqual(result.recordset[0].first, 42)
+        assert.strictEqual(result.recordset[0].second, 73)
+        assert.strictEqual(result.recordset[0].nullValue, 'handled null')
+      } catch (error) {
+        return done(error)
+      }
+      done()
+    })
+  })
+
+  it('supports handlers for date and time SQL types returning js-joda values', done => {
+    const date = LocalDate.of(2024, 2, 3)
+    const dateTime = LocalDateTime.of(2024, 2, 3, 4, 5, 6)
+    const dateTimeOffset = ZonedDateTime.of(2024, 2, 3, 4, 5, 6, 0, ZoneId.UTC)
+    sql.valueHandler
+      .set(sql.TYPES.Date, () => date)
+      .set(sql.TYPES.DateTime, () => dateTime)
+      .set(sql.TYPES.DateTimeOffset, () => dateTimeOffset)
+
+    const columns = [
+      { metadata: { colName: 'dateValue', type: tds.TYPES.Date, dataLength: 3, scale: 0, precision: 0, flags: 0 }, value: new Date() },
+      { metadata: { colName: 'dateTimeValue', type: tds.TYPES.DateTime, dataLength: 8, scale: 0, precision: 0, flags: 0 }, value: new Date() },
+      { metadata: { colName: 'dateTimeOffsetValue', type: tds.TYPES.DateTimeOffset, dataLength: 10, scale: 0, precision: 0, flags: 0 }, value: new Date() }
+    ]
+    queryColumns(columns, (err, result) => {
+      if (err) return done(err)
+      const row = result.recordset[0]
+      try {
+        assert.strictEqual(row.dateValue, date)
+        assert.strictEqual(row.dateTimeValue, dateTime)
+        assert.strictEqual(row.dateTimeOffsetValue, dateTimeOffset)
+      } catch (error) {
+        return done(error)
+      }
+      done()
+    })
+  })
+})
