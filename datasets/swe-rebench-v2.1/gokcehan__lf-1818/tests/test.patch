+func TestMakeCollatorErrors(t *testing.T) {
+	if _, err := makeCollator(""); err == nil {
+		t.Errorf("expected an error when locale ordering is disabled, got nil")
+	}
+
+	if _, err := makeCollator("not a valid tag"); err == nil {
+		t.Errorf("expected an error for an invalid locale tag, got nil")
+	}
+
+	if _, err := makeCollator("zh-CN"); err != nil {
+		t.Errorf("expected no error for a valid locale tag, got %s", err)
+	}
+}
+
+func TestMakeCollatorSystemLocale(t *testing.T) {
+	setEnv := func(loc string) {
+		t.Setenv("LANGUAGE", loc)
+		t.Setenv("LC_ALL", loc+".UTF-8")
+		t.Setenv("LC_COLLATE", loc+".UTF-8")
+		t.Setenv("LC_MESSAGES", loc+".UTF-8")
+		t.Setenv("LANG", loc+".UTF-8")
+	}
+
+	setEnv("zh_CN")
+	c, err := makeCollator("*", collate.Numeric)
+	if err != nil {
+		t.Fatalf("failed to create collator for the system locale: %s", err)
+	}
+	if c.CompareString("到这", "到那") <= 0 {
+		t.Errorf("expected the system locale (zh-CN) ordering, got %q before %q", "到这", "到那")
+	}
+
+	setEnv("en_US")
+	c, err = makeCollator("*", collate.Numeric)
+	if err != nil {
+		t.Fatalf("failed to create collator for the system locale: %s", err)
+	}
+	if c.CompareString("到这", "到那") >= 0 {
+		t.Errorf("expected the system locale (en-US) ordering, got %q before %q", "到那", "到这")
+	}
+}
