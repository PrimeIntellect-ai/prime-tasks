+func TestLocaleSort(t *testing.T) {
+	dirPath := t.TempDir()
+	for _, name := range []string{"到这", "到那"} {
+		if err := os.WriteFile(filepath.Join(dirPath, name), nil, 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	d := newDir(dirPath)
+	var this, that *file
+	for _, f := range d.allFiles {
+		switch f.Name() {
+		case "到这":
+			this = f
+		case "到那":
+			that = f
+		}
+	}
+	d.allFiles = []*file{this, that}
+	d.files = d.allFiles
+	app := &app{nav: &nav{dirs: []*dir{d}}, ui: &ui{}}
+	configPath := filepath.Join(t.TempDir(), "lfrc")
+	if err := os.WriteFile(configPath, []byte("set locale zh-CN\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	app.readFile(configPath)
+
+	got := make([]string, 0, len(d.files))
+	for _, f := range d.files {
+		got = append(got, f.Name())
+	}
+	want := []string{"到那", "到这"}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("setting locale in the config should use its collation order: got %v, want %v", got, want)
+	}
+
+	if err := os.WriteFile(configPath, []byte("set locale \"\"\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	app.readFile(configPath)
+}
+
+func TestEmptyLocaleSort(t *testing.T) {
+	dirPath := t.TempDir()
+	// Deliberately create the later natural-sort name first.
+	for _, name := range []string{"file10", "file2"} {
+		if err := os.WriteFile(filepath.Join(dirPath, name), nil, 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	d := newDir(dirPath)
+	var file2, file10 *file
+	for _, f := range d.allFiles {
+		switch f.Name() {
+		case "file2":
+			file2 = f
+		case "file10":
+			file10 = f
+		}
+	}
+	d.allFiles = []*file{file10, file2}
+	app := &app{nav: &nav{dirs: []*dir{d}}, ui: &ui{}}
+	configPath := filepath.Join(t.TempDir(), "lfrc")
+	if err := os.WriteFile(configPath, []byte("set locale \"\"\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	app.readFile(configPath)
+
+	got := make([]string, 0, len(d.files))
+	for _, f := range d.files {
+		got = append(got, f.Name())
+	}
+	want := []string{"file2", "file10"}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("an empty locale should retain ordinary natural ordering: got %v, want %v", got, want)
+	}
+}
