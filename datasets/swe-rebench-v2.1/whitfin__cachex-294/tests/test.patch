+  test "warmers don't block cache startup and eventually warm values" do
+    # Pause the initial warming operation so startup and cache access can be
+    # observed while it is still in progress.
+    Helper.create_warmer(:deferred_warmer, 50, fn test_process ->
+      send(test_process, {:warming_started, self()})
+
+      receive do
+        :continue_warming -> {:ok, [{1, 1}]}
+      end
+    end)
+
+    # Creating the cache returns while the first warming operation is pending.
+    cache =
+      Helper.create_cache(
+        warmers: [warmer(module: :deferred_warmer, state: self(), async: true)]
+      )
+
+    assert_receive {:warming_started, warmer_process}, 5_000
+
+    # The cache accepts requests before the warmer has finished.
+    assert Cachex.get!(cache, 1) == nil
+
+    # The warmer still performs its work after cache startup.
+    send(warmer_process, :continue_warming)
+    Helper.poll(5_000, 1, fn -> Cachex.get!(cache, 1) end)
+  end
+
