+// Test that Verbose.InfoS forwards structured arguments and respects verbosity.
+func TestVerboseInfoSStructuredArguments(t *testing.T) {
+	setFlags()
+	defer logging.swap(logging.newBuffers())
+
+	var testDataInfo = []struct {
+		keysValues []interface{}
+		wantField  string
+	}{
+		{keysValues: []interface{}{"pod", "kubedns"}, wantField: `pod="kubedns"`},
+		{keysValues: []interface{}{"replicaNum", 20}, wantField: `replicaNum=20`},
+		{keysValues: []interface{}{"err", errors.New("test error")}, wantField: `err="test error"`},
+	}
+
+	logging.verbosity.Set("2")
+	defer logging.verbosity.Set("0")
+
+	for l := Level(0); l < Level(4); l++ {
+		for _, data := range testDataInfo {
+			logging.file[infoLog] = &flushBuffer{}
+			V(l).InfoS("test", data.keysValues...)
+
+			got := contents(infoLog)
+			if l <= 2 {
+				if !strings.Contains(got, `"test"`) {
+					t.Errorf("V(%d).InfoS omitted its message: %s", l, got)
+				}
+				if !strings.Contains(got, data.wantField) {
+					t.Errorf("V(%d).InfoS omitted structured field %q: %s", l, data.wantField, got)
+				}
+			} else if got != "" {
+				t.Errorf("V(%d).InfoS logged while verbosity was disabled: %s", l, got)
+			}
+		}
+	}
+}
