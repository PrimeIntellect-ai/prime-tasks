+func TestHTTPServer_Endpoint_Response_JSONBody_Array_Evaluation(t *testing.T) {
+	client := newClient()
+
+	confPath := path.Join("testdata/integration/endpoint_eval/15_couper.hcl")
+	helper := test.New(t)
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	helper.Must(err)
+	port := listener.Addr().(*net.TCPAddr).Port
+	helper.Must(listener.Close())
+
+	conf, err := ioutil.ReadFile(filepath.Join(testWorkingDir, confPath))
+	helper.Must(err)
+	conf = append([]byte(fmt.Sprintf("settings { default_port = %d }\n", port)), conf...)
+	shutdown, _ := newCouperWithBytes(conf, helper)
+	defer shutdown()
+
+	content := `[1, 2, {"data": true}]`
+
+	req, err := http.NewRequest(http.MethodGet, fmt.Sprintf("http://example.com:%d/req?foo=bar", port), strings.NewReader(content))
+	helper.Must(err)
+	req.Header.Set("User-Agent", "")
+	req.Header.Set("Content-Type", "application/json")
+
+	res, err := client.Do(req)
+	helper.Must(err)
+
+	resBytes, err := ioutil.ReadAll(res.Body)
+	helper.Must(err)
+
+	_ = res.Body.Close()
+
+	var response struct {
+		JSONBody interface{} `json:"json_body"`
+	}
+	if err := json.Unmarshal(resBytes, &response); err != nil {
+		t.Fatalf("unmarshal JSON response: %v: got:\n%s", err, string(resBytes))
+	}
+
+	want := []interface{}{
+		float64(1),
+		float64(2),
+		map[string]interface{}{
+			"data": true,
+		},
+	}
+	if !reflect.DeepEqual(response.JSONBody, want) {
+		t.Errorf("want json_body %#v, got %#v (payload: %s)", want, response.JSONBody, string(resBytes))
+	}
+}
