+func TestClientRequestJSONBodyTypes(t *testing.T) {
+	tests := []struct {
+		name string
+		body string
+		hcl  string
+		want map[string]cty.Value
+	}{
+		{"boolean", `true`, `value = req.json_body`, map[string]cty.Value{"value": cty.True}},
+		{"number", `1.25`, `value = req.json_body`, map[string]cty.Value{"value": cty.NumberFloatVal(1.25)}},
+		{"string", `"hello"`, `value = req.json_body`, map[string]cty.Value{"value": cty.StringVal("hello")}},
+		{"array", `[1, 2, 3]`, `first = req.json_body[0]
+last = req.json_body[2]`, map[string]cty.Value{
+			"first": cty.NumberIntVal(1),
+			"last":  cty.NumberIntVal(3),
+		}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			req := httptest.NewRequest(http.MethodPost, "https://couper.io/", bytes.NewBufferString(tt.body))
+			req.Header.Set("Content-Type", "application/json")
+			if err := eval.SetGetBody(req, 512); err != nil {
+				t.Fatal(err)
+			}
+
+			ctx := eval.NewContext(nil).WithClientRequest(req).HCLContext()
+			ctx.Functions = nil
+
+			var result map[string]cty.Value
+			err := hclsimple.Decode(tt.name+".hcl", []byte(tt.hcl), ctx, &result)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for name, want := range tt.want {
+				got, ok := result[name]
+				if !ok {
+					t.Errorf("request JSON body expression %q was not available", name)
+					continue
+				}
+				if !got.RawEquals(want) {
+					t.Errorf("request JSON body expression %q did not preserve its JSON value", name)
 				}
 			}
 		})
