+func TestConvertTCPPortsToAci(t *testing.T) {
+	project := types.Project{
+		Name: "myProject",
+		Services: []types.ServiceConfig{{
+			Name:  "myService",
+			Image: "image",
+			Ports: []types.ServicePortConfig{
+				{Protocol: "", Target: 80, Published: 80},
+				{Protocol: "tcp", Target: 90, Published: 90},
+			},
+		}},
+	}
+	group, err := ToContainerGroup(context.TODO(), convertCtx, project, mockStorageHelper)
+	assert.NilError(t, err)
+
+	containerPorts := (*(*group.Containers)[0].ContainerProperties.Ports)
+	assert.Equal(t, len(containerPorts), 2)
+	containerProtocols := make(map[int32]containerinstance.ContainerNetworkProtocol)
+	for _, port := range containerPorts {
+		containerProtocols[*port.Port] = port.Protocol
+	}
+	assert.DeepEqual(t, containerProtocols, map[int32]containerinstance.ContainerNetworkProtocol{
+		80: containerinstance.ContainerNetworkProtocolTCP,
+		90: containerinstance.ContainerNetworkProtocolTCP,
+	})
+
+	assert.Equal(t, len(*group.IPAddress.Ports), 2)
+	groupProtocols := make(map[int32]containerinstance.ContainerGroupNetworkProtocol)
+	for _, port := range *group.IPAddress.Ports {
+		groupProtocols[*port.Port] = port.Protocol
+	}
+	assert.DeepEqual(t, groupProtocols, map[int32]containerinstance.ContainerGroupNetworkProtocol{
+		80: containerinstance.TCP,
+		90: containerinstance.TCP,
+	})
+}
