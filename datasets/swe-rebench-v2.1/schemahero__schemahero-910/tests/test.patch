+
+func TestInsertColumnStatementPreservesParameterizedVectorDimensions(t *testing.T) {
+	for _, dimension := range []string{"3", "1533"} {
+		t.Run(dimension, func(t *testing.T) {
+			statement, err := InsertColumnStatement("items", &schemasv1alpha4.PostgresqlTableColumn{
+				Name: "embedding",
+				Type: "vector(" + dimension + ")",
+			})
+			require.NoError(t, err)
+			assert.Regexp(t, `(?i)vector\s*\(\s*`+dimension+`\s*\)`, statement)
+		})
+	}
+}
