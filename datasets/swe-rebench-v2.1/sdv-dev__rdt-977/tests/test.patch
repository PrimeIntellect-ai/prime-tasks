+        # Setup
+        transformer = transformer_class(
+            missing_value_generation='from_column',
+            enforce_min_max_values=True,
+        )
+        data = pd.DataFrame({
+            'date': pd.to_datetime(['2020-01-01', None, '2020-03-01', '2020-02-01']),
+        })
+
+        # Run through the public transformation API.
+        transformed = transformer.fit_transform(data, column='date')
+        result = transformer.reverse_transform(transformed)
+
+        # Assert
+        assert result['date'].notna().any()
