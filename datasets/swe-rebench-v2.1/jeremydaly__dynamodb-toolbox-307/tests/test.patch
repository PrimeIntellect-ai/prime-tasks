diff --git a/src/__tests__/entity.putBatch.unit.ts b/src/__tests__/entity.putBatch.unit.ts
new file mode 100644
index 0000000..d5c9ff4
--- /dev/null
+++ b/src/__tests__/entity.putBatch.unit.ts
@@ -0,0 +1,63 @@
+import { Table, Entity } from '../index'
+import { DocumentClient } from './bootstrap-tests'
+
+const TestTable = new Table({
+  name: 'test-table',
+  partitionKey: 'pk',
+  sortKey: 'sk',
+  DocumentClient,
+})
+
+const TestEntity = new Entity({
+  name: 'TestEntity',
+  autoExecute: false,
+  attributes: {
+    email: { type: 'string', partitionKey: true },
+    sort: { type: 'string', sortKey: true },
+    test_string: { type: 'string' },
+  },
+  table: TestTable,
+})
+
+describe('putBatch', () => {
+  it('fails when using an undefined schema field and strictSchemaCheck is not provided', () => {
+    expect(() =>
+      TestEntity.putBatch({
+        email: 'test-pk',
+        sort: 'test-sk',
+        // @ts-expect-error
+        unknown: '?',
+      }),
+    ).toThrow(`Field 'unknown' does not have a mapping or alias`)
+  })
+
+  it('fails when using an undefined schema field and strictSchemaCheck is true', () => {
+    expect(() =>
+      TestEntity.putBatch(
+        {
+          email: 'test-pk',
+          sort: 'test-sk',
+          // @ts-expect-error: unknown fields are the behavior under test
+          unknown: '?',
+        },
+        { strictSchemaCheck: true },
+      ),
+    ).toThrow(`Field 'unknown' does not have a mapping or alias`)
+  })
+
+  it('omits unmapped attributes when strict schema checking is disabled', () => {
+    const result = TestEntity.putBatch(
+      {
+        email: 'test-pk',
+        sort: 'test-sk',
+        unknown: '?',
+      },
+      { strictSchemaCheck: false },
+    )
+
+    expect(result[TestTable.name].PutRequest?.Item).toEqual(
+      expect.objectContaining({ pk: 'test-pk', sk: 'test-sk' }),
+    )
+    expect(result[TestTable.name].PutRequest?.Item).not.toHaveProperty('unknown')
+  })
+})
