+function hasNonthrowingExistenceCheck(scheduler: ToadScheduler, id: string, expected: boolean): boolean {
+  const possibleQueries = scheduler as unknown as Record<string, unknown>
+  const results: boolean[] = []
+
+  for (const name of ['existsById', 'jobExists']) {
+    const query = possibleQueries[name]
+    if (typeof query === 'function') {
+      try {
+        results.push(query.call(scheduler, id) === expected)
+      } catch {
+        // Another supported lookup may provide the nonthrowing check.
+      }
+    }
+  }
+
+  try {
+    results.push(Boolean(scheduler.getById(id)) === expected)
+  } catch {
+    // A dedicated existence query may be used when getById throws.
+  }
+
+  return results.some(Boolean)
+}
