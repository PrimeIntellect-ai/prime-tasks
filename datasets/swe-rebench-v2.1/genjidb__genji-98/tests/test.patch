+
+func TestBoolFieldFromEmptyCollectionLiteralsIsFalse(t *testing.T) {
+	db, err := genji.Open(":memory:")
+	require.NoError(t, err)
+	defer db.Close()
+
+	err = db.Exec("CREATE TABLE test(a BOOL, b BOOL)")
+	require.NoError(t, err)
+	err = db.Exec("INSERT INTO test VALUES {a: [], b: {}}")
+	require.NoError(t, err)
+
+	stream, err := db.Query("SELECT * FROM test")
+	require.NoError(t, err)
+	defer stream.Close()
+
+	var result bytes.Buffer
+	err = document.IteratorToJSON(&result, stream)
+	require.NoError(t, err)
+	require.JSONEq(t, `{"a":false,"b":false}`, result.String())
+}
