+def _assert_dtype_is_cached(frame, column, expected_dtype):
+    """
+    Assert that ``column``'s dtype is present in ``frame``'s dtypes cache.
+
+    The check is performed without triggering a dtypes computation, so it
+    verifies that the cache was actually preserved rather than recomputed
+    on demand.
+    """
+    dtypes = frame._dtypes
+    assert dtypes is not None
+    cached = dtypes.lazy_get([column])
+    assert cached.is_materialized, (
+        f"dtype for column {column!r} is missing from the dtypes cache"
+    )
+    assert cached.get()[column] == expected_dtype
+
+
 class TestZeroComputationDtypes:
     """
     Test cases that shouldn't trigger dtypes computation during their execution.
     """
 
+    @pytest.mark.parametrize("self_dtype", ["materialized", "partial", "unknown"])
+    @pytest.mark.parametrize(
+        "value, value_dtype",
+        [
+            [3.5, np.dtype(float)],
+        ],
+    )
+    def test_preserve_dtypes_insert(self, self_dtype, value, value_dtype):
+        df = pd.DataFrame({"a": [1, 2], "b": [3, 4]})
+        if self_dtype == "materialized":
+            assert df._query_compiler._modin_frame.has_materialized_dtypes
+        elif self_dtype == "partial":
+            df._query_compiler._modin_frame.set_dtypes_cache(
+                ModinDtypes(
+                    DtypesDescriptor(
+                        {"a": np.dtype(int)}, cols_with_unknown_dtypes=["b"]
+                    )
+                )
+            )
+        elif self_dtype == "unknown":
+            df._query_compiler._modin_frame.set_dtypes_cache(None)
+        else:
+            raise NotImplementedError(self_dtype)
+
+        df.insert(loc=0, column="c", value=value)
+
+        # The inserted column's dtype must be present in the dtypes cache
+        # without triggering a recomputation.
+        _assert_dtype_is_cached(df._query_compiler._modin_frame, "c", value_dtype)
+        if self_dtype == "materialized":
+            # The existing known dtypes must still be cached before reading
+            # df.dtypes can trigger any lazy computation.
+            _assert_dtype_is_cached(
+                df._query_compiler._modin_frame, "a", np.dtype(int)
+            )
+            _assert_dtype_is_cached(
+                df._query_compiler._modin_frame, "b", np.dtype(int)
+            )
+        if self_dtype == "partial":
+            # dtypes that were known before the insertion must be preserved too
+            _assert_dtype_is_cached(
+                df._query_compiler._modin_frame, "a", np.dtype(int)
+            )
+
+        result_dtype = pandas.Series(
+            [value_dtype, np.dtype(int), np.dtype(int)], index=["c", "a", "b"]
+        )
+        assert df.dtypes.equals(result_dtype)
+
+    @pytest.mark.parametrize("self_dtype", ["materialized", "partial", "unknown"])
+    def test_preserve_dtypes_insert_middle(self, self_dtype):
+        # The public contract demonstrates inserting a scalar column at ``loc=1``,
+        # so make sure the dtypes cache is preserved (and correctly ordered) there too.
+        df = pd.DataFrame({"a": [1, 2], "b": [3, 4]})
+        if self_dtype == "materialized":
+            assert df._query_compiler._modin_frame.has_materialized_dtypes
+        elif self_dtype == "partial":
+            df._query_compiler._modin_frame.set_dtypes_cache(
+                ModinDtypes(
+                    DtypesDescriptor(
+                        {"a": np.dtype(int)}, cols_with_unknown_dtypes=["b"]
+                    )
+                )
+            )
+        elif self_dtype == "unknown":
+            df._query_compiler._modin_frame.set_dtypes_cache(None)
+        else:
+            raise NotImplementedError(self_dtype)
+
+        df.insert(loc=1, column="c", value=10)
+
+        _assert_dtype_is_cached(df._query_compiler._modin_frame, "c", np.dtype(int))
+        if self_dtype == "partial":
+            _assert_dtype_is_cached(
+                df._query_compiler._modin_frame, "a", np.dtype(int)
+            )
+
+        result_dtype = pandas.Series(
+            [np.dtype(int), np.dtype(int), np.dtype(int)], index=["a", "c", "b"]
+        )
+        assert df.dtypes.equals(result_dtype)
+
