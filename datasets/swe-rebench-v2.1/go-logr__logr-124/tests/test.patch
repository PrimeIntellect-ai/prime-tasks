+
+func ExampleRecursivePointerTerminates() {
+	type List struct {
+		Next *List
+	}
+	l := List{}
+	l.Next = &l // recursive
+
+	var log logr.Logger = funcr.NewJSON(
+		func(string) { fmt.Println("logged") },
+		funcr.Options{})
+	log.Info("recursive", "list", l)
+	// Output: logged
+}
+
+func ExampleRecursiveMultiNodePointerTerminates() {
+	type Node struct {
+		Next *Node
+	}
+	first := &Node{}
+	second := &Node{}
+	first.Next = second
+	second.Next = first
+
+	var log logr.Logger = funcr.NewJSON(
+		func(string) { fmt.Println("logged") },
+		funcr.Options{})
+	log.Info("recursive", "node", first)
+	// Output: logged
+}
