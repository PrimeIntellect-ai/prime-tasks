+import io
+
 import pytest
 
 import ci_engine
@@ -83,6 +85,42 @@ def test_get_player_hash(db_wrapper):
     assert db_wrapper.get_player_hash('p1') == 'h1'
     assert db_wrapper.get_player_hash('p2') == 'h2'
 
+def test_get_team_name(db_wrapper):
+    db_wrapper.add_player('p1', 'h1')
+    db_wrapper.add_player('p2', 'h2')
+    assert db_wrapper.add_team_name('p1', 'tn1') is None
+    assert db_wrapper.add_team_name('p2', 'tn2') is None
+    assert db_wrapper.add_team_name('p2', 'tn3') is None # check that override works
+    with pytest.raises(ValueError):
+        db_wrapper.get_team_name('p0')
+    assert db_wrapper.get_team_name('p1') == 'tn1'
+    assert db_wrapper.get_team_name('p2') == 'tn3'
+
+def test_team_name_shown_in_ci_table(monkeypatch, capsys):
+    monkeypatch.setenv('COLUMNS', '200')
+    monkeypatch.setenv('TERM', 'xterm')
+    config = io.StringIO("""
+[general]
+rounds = 300
+viewer = null
+db_file = :memory:
+
+[agents]
+p1 = path1
+p2 = path2
+""")
+    engine = ci_engine.CI_Engine(config)
+    engine.dbwrapper.add_player('p1', 'h1')
+    engine.dbwrapper.add_player('p2', 'h2')
+    engine.dbwrapper.add_team_name('p1', 'tn1')
+    engine.dbwrapper.add_team_name('p2', 'tn2')
+    engine.dbwrapper.add_gameresult('p1', 'p2', 0, '{}', '', '')
+    engine.pretty_print_results()
+    out = capsys.readouterr().out
+    lines = out.splitlines()
+    assert any('p1' in line and 'tn1' in line for line in lines)
+    assert any('p2' in line and 'tn2' in line for line in lines)
+
