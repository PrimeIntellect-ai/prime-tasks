+def test_matlab_compatible_highpass_values():
+    """Check numerical output against a fixed MATLAB PREP reference signal."""
+    rng = np.random.RandomState(23)
+    signal = rng.standard_normal((2, 200))
+    actual = removeTrend.removeTrend(
+        signal,
+        sample_rate=100,
+        detrendCutoff=1.0,
+        matlab_strict=True,
+    )
+
+    rows = np.array([0, 0, 0, 0, 1, 1, 1, 1])
+    columns = np.array([0, 1, 50, 199, 0, 1, 100, 199])
+    expected = np.array([
+        0.3097803745085653,
+        -0.32594667050178217,
+        -0.24426709061120322,
+        0.10597407892938474,
+        0.3046327871310513,
+        -0.9143436256704925,
+        0.985983691956224,
+        -0.21384348292057695,
+    ])
+    np.testing.assert_allclose(actual[rows, columns], expected, rtol=1e-6, atol=1e-6)
