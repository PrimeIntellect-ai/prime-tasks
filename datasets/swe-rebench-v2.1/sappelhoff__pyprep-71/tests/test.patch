 """Test remove trend."""
 import numpy as np
+import scipy.signal
+
+# Keep this legacy package testable with newer NumPy/SciPy releases.
+if not hasattr(np, "int"):
+    np.int = int
+_original_firwin = scipy.signal.firwin
+
+
+def _firwin_compat(*args, **kwargs):
+    if "nyq" in kwargs:
+        kwargs["fs"] = 2 * kwargs.pop("nyq")
+    return _original_firwin(*args, **kwargs)
+
+
+scipy.signal.firwin = _firwin_compat
 
 import pyprep.removeTrend as removeTrend
 
