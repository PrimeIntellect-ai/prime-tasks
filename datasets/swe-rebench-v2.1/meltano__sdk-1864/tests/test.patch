+        target.get_sink(
+            "bar",
+        )
+
+
+def test_target_connector_is_cached_and_shared():
+    target = SQLTargetMock(config={"sqlalchemy_url": "sqlite:///"})
+    connector = target.target_connector
+
+    # The connector is created once and cached on the target.
+    assert isinstance(connector, SQLConnectorMock)
+    assert connector.config == target.config
+    assert target.target_connector is connector
+
+    schema = {
+        "properties": {
+            "id": {"type": ["string", "null"]},
+        },
+    }
+
+    # Every sink created by the target reuses the same connector instance.
+    sink_a = target.add_sqlsink("foo", schema=schema, key_properties=[])
+    sink_b = target.add_sqlsink("bar", schema=schema, key_properties=[])
+    sink_c = target.get_sink("baz", schema=schema, key_properties=[])
+
+    assert sink_a.connector is connector
+    assert sink_b.connector is connector
+    assert sink_c.connector is connector
+
+
+def test_add_sqlsink_runs_setup():
+    target = SQLTargetMock(config={"sqlalchemy_url": "sqlite:///"})
+    schema = {
+        "properties": {
+            "id": {"type": ["string", "null"]},
+        },
+    }
+    sink = target.add_sqlsink("foo", schema=schema, key_properties=[])
+
+    assert sink.stream_name == "foo"
+    assert sink.original_schema == schema
+    assert sink.key_properties == []
+    assert target.num_setups >= 1
