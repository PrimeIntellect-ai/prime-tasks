+
+describe('Protection form noinclude option', () => {
+	test('label displays the full <noinclude> text', () => {
+		// The protection form is built by the protect module; load it and use its public entry point
+		global.Twinkle = { addInitCallback: function () {}, addPortletLink: function () {}, getPref: function () {} };
+		mw.config.set({ wgNamespaceNumber: 0, wgTitle: 'Test', wgArticleId: 1 });
+
+		// jQuery UI widgets are not available in this environment; stub the calls the dialog makes
+		var dialogContent = null;
+		jQuery.fn.dialog = function (cmd) {
+			if (cmd && typeof cmd === 'object') {
+				dialogContent = this[0];
+				document.body.appendChild(dialogContent);
+			}
+			if (cmd === 'widget') {
+				return jQuery('<div><div class="morebits-dialog-buttons"></div><div class="morebits-dialog-content"></div></div>');
+			}
+			return this;
+		};
+		['resizable', 'draggable', 'tooltip'].forEach(function (name) {
+			jQuery.fn[name] = jQuery.fn[name] || function () { return this; };
+		});
+
+		var src = require('fs').readFileSync(require('path').join(__dirname, '../modules/twinkleprotect.js'), 'utf8');
+		// eslint-disable-next-line no-new-func
+		new Function('Twinkle', 'mw', 'Morebits', 'jQuery', '$', 'window', 'document', src)(Twinkle, mw, Morebits, jQuery, jQuery, window, document);
+
+		try {
+			Twinkle.protect.callback();
+		} catch (e) {
+			// The window is already populated when this jsdom limitation is hit; the checks below cover the result
+		}
+		assert.true(dialogContent !== null, 'The protection dialog should be created');
+
+		var tagRadio = dialogContent.querySelector('input[name="actiontype"][value="tag"]');
+		assert.true(tagRadio !== null, 'The tag option should be available');
+		tagRadio.checked = true;
+		tagRadio.dispatchEvent(new Event('change', { bubbles: true }));
+
+		var labelTexts = Array.prototype.map.call(dialogContent.querySelectorAll('label'), function (label) {
+			return label.textContent;
+		});
+		var noincludeLabel = labelTexts.filter(function (text) {
+			return text.indexOf('Wrap protection template with') === 0;
+		})[0];
+		document.body.removeChild(dialogContent);
+		assert.true(noincludeLabel !== undefined, 'The noinclude option should be present');
+		assert.true(noincludeLabel.indexOf('<noinclude>') !== -1, 'The noinclude option label should show the full <noinclude> text, got: ' + noincludeLabel);
+	});
+});
