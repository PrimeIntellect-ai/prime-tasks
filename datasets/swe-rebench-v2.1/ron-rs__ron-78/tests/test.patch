+extern crate ron;
+
+#[test]
+fn test_hex() {
+    assert_eq!(ron::de::from_str("0x507"), Ok(0x507));
+    assert_eq!(ron::de::from_str("0x1A5"), Ok(0x1A5));
+    assert_eq!(ron::de::from_str("0x53C537"), Ok(0x53C537));
+}
+
+// The contract requires hexadecimal notation. Binary (`0b...`) and octal
+// (`0o...`) are only optional suggestions, so these tests exercise additional
+// hexadecimal values instead of requiring the optional formats.
+#[test]
+fn test_bin() {
+    assert_eq!(ron::de::from_str("0x5"), Ok(0x5));
+    assert_eq!(ron::de::from_str("0x1"), Ok(0x1));
+    assert_eq!(ron::de::from_str("0x24"), Ok(0x24));
+}
+
+#[test]
+fn test_oct() {
+    assert_eq!(ron::de::from_str("0x331"), Ok(0x331));
+    assert_eq!(ron::de::from_str("0x29"), Ok(0x29));
+    assert_eq!(ron::de::from_str("0xD1C0"), Ok(0xD1C0));
+}
