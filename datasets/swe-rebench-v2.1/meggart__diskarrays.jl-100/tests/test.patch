+@testset "Read 0-dimensional DiskArray and view" begin
+    a = _DiskArray(zeros(Int); chunksize=())
+    @test ndims(a) == 0
+    @test Array(a)[] == 0
+    @test collect(a)[] == 0
+    v = view(a)
+    @test ndims(v) == 0
+    @test Array(v)[] == 0
+    @test collect(v)[] == 0
+
+    a3 = _DiskArray(reshape(1:12, 3, 4, 1); chunksize=(2, 2, 1))
+    v3 = view(a3, 2, 3, 1)
+    @test ndims(v3) == 0
+    @test Array(v3)[] == 8
+    @test collect(v3)[] == 8
+end
