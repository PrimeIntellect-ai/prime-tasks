+    it("hard newlines after relations and ORD atoms are top-level", () => {
+        const expectTopLevelNewline = (expr) => {
+            const tags = katex.renderToString(expr).match(/<\/?[a-z][^>]*>/gi) || [];
+            const parents = [];
+            const voidElements = new Set([
+                "area", "base", "br", "col", "embed", "hr", "img", "input",
+                "link", "meta", "param", "source", "track", "wbr",
+            ]);
+            let newlineCount = 0;
+            let topLevelNewlineCount = 0;
+
+            tags.forEach((tag) => {
+                const tagName = (tag.match(/^<\/?([a-z][\w:-]*)/i) || [])[1]
+                    .toLowerCase();
+                if (tag.startsWith("</")) {
+                    parents.pop();
+                    return;
+                }
+
+                const classes = (tag.match(/\bclass=["']([^"']*)["']/i) || [])[1] || "";
+                if (classes.split(/\s+/).includes("newline")) {
+                    newlineCount++;
+                    const parentClasses = parents.length
+                        ? parents[parents.length - 1].classes : "";
+                    if (parentClasses.split(/\s+/).includes("katex-html")) {
+                        topLevelNewlineCount++;
+                    }
+                }
+                if (!voidElements.has(tagName) && !tag.endsWith("/>")) {
+                    parents.push({classes});
+                }
+            });
+
+            expect(newlineCount).toBe(1);
+            expect(topLevelNewlineCount).toBe(1);
+        };
+
+        expectTopLevelNewline(r`M = \\ a`);
+        expectTopLevelNewline(r`a \\ b`);
+        expectTopLevelNewline(r`M = \newline a`);
+        expectTopLevelNewline(r`a \newline b`);
+    });
+});
