+from pathlib import Path
+
+import pytest
+
+
+@pytest.mark.parametrize("test_app", [{"buildername": "html", "srcdir": "doc_test/doc_needreport"}], indirect=True)
+def test_dotted_need_id_is_processed_without_exception(test_app):
+    app = test_app
+    app.build()
+    warnings = app._warning.getvalue()
+    assert "threw an exception" not in warnings
+    html = Path(app.outdir, "index.html").read_text(encoding="utf8")
+    assert "REQ.1.2" in html
+    assert "REQ.3" in html
