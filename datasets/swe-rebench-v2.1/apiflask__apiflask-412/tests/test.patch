+def test_spec_processor_pass_object(app, client):
+    app.config['SPEC_PROCESSOR_PASS_OBJECT'] = True
+
+    class NotUsedSchema(Schema):
+        id = Integer()
+
+    class UsedSchema(Schema):
+        name = String()
+
+    @app.route('/used')
+    @app.output(UsedSchema)
+    def used():
+        pass
+
+    @app.spec_processor
+    def process_spec(spec):
+        spec.components.schema('NotUsed', schema=NotUsedSchema)
+        return spec
+
+    rv = client.get('/openapi.json')
+    assert rv.status_code == 200
+    validate_spec(rv.json)
+    schemas = rv.json['components']['schemas']
+    assert 'id' in schemas['NotUsed']['properties']
+
+    used_ref = rv.json['paths']['/used']['get']['responses']['200']['content'][
+        'application/json'
+    ]['schema']['$ref']
+    used_name = used_ref.split('/')[-1]
+    assert used_name in schemas
+    assert 'name' in schemas[used_name]['properties']
+
+
