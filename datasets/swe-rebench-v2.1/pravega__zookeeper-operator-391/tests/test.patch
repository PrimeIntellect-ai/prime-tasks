+var _ = Describe("Helm chart versions", func() {
+	repoRoot := func() string {
+		_, file, _, ok := runtime.Caller(0)
+		Ω(ok).To(BeTrue())
+		return filepath.Join(filepath.Dir(file), "..", "..", "..", "..")
+	}
+
+	readChart := func(relPath string) map[string]interface{} {
+		data, err := ioutil.ReadFile(filepath.Join(repoRoot(), relPath))
+		Ω(err).NotTo(HaveOccurred())
+		chart := map[string]interface{}{}
+		Ω(yaml.Unmarshal(data, &chart)).To(Succeed())
+		return chart
+	}
+
+	It("should set the zookeeper chart version and appVersion to 0.2.13", func() {
+		chart := readChart(filepath.Join("charts", "zookeeper", "Chart.yaml"))
+		Ω(chart["version"]).To(Equal("0.2.13"))
+		Ω(chart["appVersion"]).To(Equal("0.2.13"))
+	})
+
+	It("should set the zookeeper-operator chart version and appVersion to 0.2.13", func() {
+		chart := readChart(filepath.Join("charts", "zookeeper-operator", "Chart.yaml"))
+		Ω(chart["version"]).To(Equal("0.2.13"))
+		Ω(chart["appVersion"]).To(Equal("0.2.13"))
+	})
+})
