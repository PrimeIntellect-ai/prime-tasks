diff --git a/tests/lib/rules/jsx-handler-names.js b/tests/lib/rules/jsx-handler-names.js
index 111aaa0..d28be87 100644
--- a/tests/lib/rules/jsx-handler-names.js
+++ b/tests/lib/rules/jsx-handler-names.js
@@ -9,6 +9,8 @@
 // ------------------------------------------------------------------------------
 
 var rule = require('../../../lib/rules/jsx-handler-names');
+var assert = require('assert');
+var linter = require('eslint').linter;
 var RuleTester = require('eslint').RuleTester;
 
 var parserOptions = {
@@ -93,6 +95,11 @@ ruleTester.run('jsx-handler-names', rule, {
       '<TestComponent onChange={props.foo::handleChange} />'
     ].join('\n'),
     parser: 'babel-eslint'
+  }, {
+    code: [
+      '<TestComponent only={this.only} />'
+    ].join('\n'),
+    parserOptions: parserOptions
   }],
 
   invalid: [{
@@ -127,3 +134,25 @@ ruleTester.run('jsx-handler-names', rule, {
     errors: [{message: 'Handler function for onChange prop key must begin with \'handle\''}]
   }]
 });
+
+linter.defineRule('jsx-handler-names', rule);
+it('does not treat a lowercase on-prefixed prop as an event handler', function() {
+  var messages = linter.verify(
+    '<TestComponent only={this.only} />',
+    {
+      parserOptions: parserOptions,
+      rules: {'jsx-handler-names': 2}
+    }
+  );
+  assert.strictEqual(messages.length, 0);
+});
+it('reports a handler-named value supplied under a non-event prop', function() {
+  var handlerMismatchMessages = linter.verify(
+    '<TestComponent only={this.handleChange} />',
+    {
+      parserOptions: parserOptions,
+      rules: {'jsx-handler-names': 2}
+    }
+  );
+  assert(handlerMismatchMessages.length > 0);
+});
