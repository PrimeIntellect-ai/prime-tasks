+func TestStreamDecodeNextSize(t *testing.T) {
+	testCases := []struct {
+		name      string
+		data      []byte
+		expected  uint64
+		wantError bool
+	}{
+		{"no data", []byte{}, 0, true},
+		{"truncated head", []byte{0x1b, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07}, 0, true},
+		{"invalid array head", []byte{0x9d}, 0, true},
+		{"false", []byte{0xf4}, 0, true},
+		{"true", []byte{0xf5}, 0, true},
+		{"nil", []byte{0xf6}, 0, true},
+		{"uint", []byte{0x01}, 0, true},
+		{"int", []byte{0x20}, 0, true},
+		{"tag", []byte{0xc2, 0x49, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 0, true},
+		{"empty byte string", []byte{0x40}, 0, false},
+		{"byte string", []byte{0x45, 0x01, 0x02, 0x03, 0x04, 0x05}, 5, false},
+		{"indefinite byte string", []byte{0x5f, 0x42, 0x01, 0x02, 0x43, 0x03, 0x04, 0x05, 0xff}, 0, true},
+		{"empty text string", []byte{0x60}, 0, false},
+		{"text string", []byte{0x65, 0x68, 0x65, 0x6c, 0x6c, 0x6f}, 5, false},
+		{"text string with 1-byte length", []byte{0x78, 0x01, 0x61}, 1, false},
+		{"text string with 2-byte length", []byte{0x79, 0x00, 0x01, 0x61}, 1, false},
+		{"text string with 4-byte length", []byte{0x7a, 0x00, 0x00, 0x00, 0x01, 0x61}, 1, false},
+		{"text string with 8-byte length", []byte{0x7b, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x61}, 1, false},
+		{"indefinite text string", []byte{0x7f, 0x65, 0x73, 0x74, 0x72, 0x65, 0x61, 0x64, 0x6d, 0x69, 0x6e, 0x67, 0xff}, 0, true},
+		{"empty array", []byte{0x80}, 0, false},
+		{"array", []byte{0x83, 0x01, 0x02, 0x03}, 3, false},
+		{"indefinite array", []byte{0x9f, 0x01, 0x02, 0x03, 0xff}, 0, true},
+		{"empty map", []byte{0xa0}, 0, false},
+		{"map", []byte{0xa2, 0x01, 0x02, 0x03, 0x04}, 2, false},
+		{"indefinite map", []byte{0xbf, 0x01, 0x02, 0xff}, 0, true},
+	}
+
+	for _, tc := range testCases {
+		decoders := []struct {
+			name string
+			sd   *StreamDecoder
+		}{
+			{"byte_decoder", NewByteStreamDecoder(tc.data)},
+			{"reader_decoder", NewStreamDecoder(bytes.NewReader(tc.data))},
+		}
+
+		for _, decoder := range decoders {
+			t.Run(decoder.name+" "+tc.name, func(t *testing.T) {
+				size, err := callStreamDecoderNextSize(decoder.sd)
+				if tc.wantError {
+					if err == nil {
+						t.Fatal("NextSize() did not report an error")
+					}
+				} else {
+					if err != nil {
+						t.Fatalf("NextSize() returned error %v", err)
+					}
+					if size != tc.expected {
+						t.Errorf("NextSize() returned %d, want %d", size, tc.expected)
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestStreamDecodeNextSizeDoesNotConsume(t *testing.T) {
+	// NextSize() must peek at the next value without consuming it, so the
+	// value can still be decoded afterwards.
+	testCases := []struct {
+		name string
+		data []byte
+		size uint64
+	}{
+		{"byte string", []byte{0x45, 0x01, 0x02, 0x03, 0x04, 0x05}, 5},
+		{"text string", []byte{0x65, 0x68, 0x65, 0x6c, 0x6c, 0x6f}, 5},
+		{"array", []byte{0x83, 0x01, 0x02, 0x03}, 3},
+		{"map", []byte{0xa2, 0x01, 0x02, 0x03, 0x04}, 2},
+	}
+
+	for _, tc := range testCases {
+		decoders := []struct {
+			name string
+			sd   *StreamDecoder
+		}{
+			{"byte_decoder", NewByteStreamDecoder(tc.data)},
+			{"reader_decoder", NewStreamDecoder(bytes.NewReader(tc.data))},
+		}
+
+		for _, sd := range decoders {
+			t.Run(sd.name+" "+tc.name, func(t *testing.T) {
+				size, err := callStreamDecoderNextSize(sd.sd)
+				if err != nil {
+					t.Fatalf("NextSize() returned error %v", err)
+				}
+				if size != tc.size {
+					t.Fatalf("NextSize() returned %d, want %d", size, tc.size)
+				}
+
+				// The next value must still be present after peeking.
+				nt, err := sd.sd.NextType()
+				if err != nil {
+					t.Fatalf("NextType() after NextSize() returned error %v", err)
+				}
+
+				switch nt {
+				case ByteStringType:
+					b, err := sd.sd.DecodeBytes()
+					if err != nil {
+						t.Fatalf("DecodeBytes() after NextSize() returned error %v", err)
+					}
+					if uint64(len(b)) != tc.size {
+						t.Errorf("DecodeBytes() returned %d bytes, want %d", len(b), tc.size)
+					}
+				case TextStringType:
+					s, err := sd.sd.DecodeString()
+					if err != nil {
+						t.Fatalf("DecodeString() after NextSize() returned error %v", err)
+					}
+					if uint64(len(s)) != tc.size {
+						t.Errorf("DecodeString() returned %d bytes, want %d", len(s), tc.size)
+					}
+				case ArrayType:
+					n, err := sd.sd.DecodeArrayHead()
+					if err != nil {
+						t.Fatalf("DecodeArrayHead() after NextSize() returned error %v", err)
+					}
+					if n != tc.size {
+						t.Errorf("DecodeArrayHead() returned %d, want %d", n, tc.size)
+					}
+				case MapType:
+					raw, err := sd.sd.DecodeRawBytes()
+					if err != nil {
+						t.Fatalf("DecodeRawBytes() after NextSize() returned error %v", err)
+					}
+					if len(raw) != len(tc.data) {
+						t.Errorf("DecodeRawBytes() returned %d bytes, want %d", len(raw), len(tc.data))
+					}
+				default:
+					t.Fatalf("NextType() after NextSize() returned %s, want a supported type", nt)
+				}
+			})
+		}
+	}
+}
