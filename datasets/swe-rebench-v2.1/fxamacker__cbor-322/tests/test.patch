+func callStreamDecoderNextSize(sd *StreamDecoder) (uint64, error) {
+	method := reflect.ValueOf(sd).MethodByName("NextSize")
+	if !method.IsValid() {
+		return 0, errors.New("StreamDecoder does not support NextSize")
+	}
+	results := method.Call(nil)
+	if len(results) != 2 {
+		return 0, errors.New("NextSize() returned an unexpected number of values")
+	}
+
+	var size uint64
+	switch results[0].Kind() {
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		signedSize := results[0].Int()
+		if signedSize < 0 {
+			return 0, errors.New("NextSize() returned a negative size")
+		}
+		size = uint64(signedSize)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
+		size = results[0].Uint()
+	default:
+		return 0, errors.New("NextSize() returned a non-integer size")
+	}
+
+	if !results[1].Type().Implements(reflect.TypeOf((*error)(nil)).Elem()) {
+		return 0, errors.New("NextSize() did not return an error value")
+	}
+	var err error
+	if nilable(results[1].Kind()) && results[1].IsNil() {
+		err = nil
+	} else if value, ok := results[1].Interface().(error); ok {
+		err = value
+	}
+	return size, err
+}
+
+func nilable(kind reflect.Kind) bool {
+	switch kind {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Ptr, reflect.Slice:
+		return true
+	default:
+		return false
+	}
+}
