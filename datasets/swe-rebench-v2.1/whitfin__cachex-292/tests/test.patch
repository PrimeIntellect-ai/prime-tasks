diff --git a/test/cachex_test.exs b/test/cachex_test.exs
index 43f6c17..05b17e0 100644
--- a/test/cachex_test.exs
+++ b/test/cachex_test.exs
@@ -210,5 +210,48 @@ defmodule CachexTest do
         raise RuntimeError, message: "Ding dong! The witch is dead!"
       end)
     end)
+
+     # validate an unsafe call to fetch handling
+    assert_raise(Cachex.ExecutionError, fn ->
+      Cachex.fetch!(cache, "key", fn(_key) ->
+        raise RuntimeError, message: "Which old witch? The wicked witch!"
+      end)
+    end)
+  end
+
+  # Ensures that an error raised inside a fetch! fallback surfaces the original
+  # stacktrace, so that the failing location can be identified rather than only
+  # the error message.
+  test "fetch! surfaces the original stacktrace from fallbacks" do
+    # create a basic test cache
+    cache = Helper.create_cache()
+
+    # capture the surfaced error and its stacktrace
+    { stack, message } =
+      try do
+        Cachex.fetch!(cache, "key", fn _key -> raise_in_fetch_fallback() end)
+        { nil, nil }
+      rescue
+        error in Cachex.ExecutionError -> { __STACKTRACE__, error.message }
+      end
+
+    # the surfaced error retains the underlying exception message
+    assert message == "Which old witch? The wicked witch!"
+
+    # the original frame from the fallback must be present
+    assert is_list(stack)
+
+    assert Enum.any?(stack, fn
+      { module, function, _arity, _location } ->
+        module == __MODULE__ and function == :raise_in_fetch_fallback
+
+      _ ->
+        false
+    end)
+  end
+
+  # Raises an error from inside a fetch fallback for stacktrace assertions.
+  defp raise_in_fetch_fallback do
+    raise RuntimeError, message: "Which old witch? The wicked witch!"
   end
 end
