+    def test_parser_hidden_option(self, monkeypatch):
+        optionset = _option_set.OptionSet()
+        optionset.add_options(
+            _option_set.Option(
+                "oh_boy_i_am_hidden",
+                "--hidden-option",
+                hidden=True,
+                group=None,
+                default="meep",
+            )
+        )
+
+        with pytest.raises(SystemExit):
+            optionset.parser().parse_args(["--hidden-option", "supplied"])
+
+        monkeypatch.setattr(sys, "argv", ["nox"])
+        namespace = optionset.parse_args()
+
+        assert namespace.oh_boy_i_am_hidden == "meep"
+
