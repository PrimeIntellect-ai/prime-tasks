+    def test_invoked_from_records_caller_directory(self, tmpdir, monkeypatch):
+        # Nox changes the working directory to the Noxfile's location, but the
+        # directory it was invoked from must still be recorded.
+        noxfile_dir = tmpdir.join("project").ensure(dir=True)
+        noxfile = noxfile_dir.join("noxfile.py")
+        noxfile.write("")
+
+        caller_dir = str(tmpdir.join("caller").ensure(dir=True))
+        monkeypatch.chdir(caller_dir)
+
+        global_config = _options.options.namespace(noxfile=str(noxfile))
+        nox.tasks.load_nox_module(global_config)
+
+        assert global_config.invoked_from == caller_dir
+
