+const testPathTemplate = (settings, options) => {
+  const ruleTester = createRuleTester(settings);
+  ruleTester.run(RULE, rule, {
+    valid: [
+      // Module-a can import react-router-dom/other/foo (path does not match the captured pattern)
+      {
+        filename: absoluteFilePath("modules/module-a/ModuleA.js"),
+        code: "import Foo from 'react-router-dom/other/foo'",
+        options,
+      },
+    ],
+    invalid: [
+      // Module-a can't import react-router-dom/module-a/foo (path matches /${from.elementName}/*)
+      {
+        filename: absoluteFilePath("modules/module-a/ModuleA.js"),
+        code: "import Foo from 'react-router-dom/module-a/foo'",
+        options,
+        errors: [
+          {
+            type: "ImportDeclaration",
+          },
+        ],
+      },
+    ],
+  });
+};
+
+testPathTemplate(
+  SETTINGS.oneLevel,
+  [
+    {
+      default: "allow",
+      rules: [
