+	it('Pause and resume works for local files (Regression Test for Bug #636)', function(done) {
+		this.timeout(30000);
+		var rows = [];
+		for (var i = 0; i < 50; i++) {
+			rows.push(['row' + i, 'value' + i]);
+		}
+		var content = rows.map(function(row) { return row.join(','); }).join('\n');
+
+		// Minimal stand-in for the browser FileReader used when parsing a local File.
+		// It throws if a read is started while a previous read is still in progress,
+		// matching the reported "already busy reading Blobs" failure.
+		var FakeFileReader = function() {
+			this._busy = false;
+			this.onload = null;
+			this.onerror = null;
+		};
+		FakeFileReader.prototype.readAsText = function(blob) {
+			if (this._busy) {
+				throw new Error("Failed to execute 'readAsText' on 'FileReader': The object is already busy reading Blobs.");
+			}
+			this._busy = true;
+			var self = this;
+			setTimeout(function() {
+				self._busy = false;
+				self.onload({ target: { result: blob._content } });
+			}, 1);
+		};
+
+		var file = {
+			size: content.length,
+			slice: function(start, end) {
+				return { _content: content.substring(start, end) };
+			}
+		};
+
+		var previousFileReader = global.FileReader;
+		global.FileReader = FakeFileReader;
+
+		var stepped = 0;
+		var parsedRows = [];
+		Papa.parse(file, {
+			chunkSize: 30,
+			step: function(results, parser) {
+				stepped++;
+				parser.pause();
+				parser.resume();
+				if (results && results.data) {
+					parsedRows.push(results.data);
+				}
+			},
+			error: function(err) {
+				global.FileReader = previousFileReader;
+				done(err);
+			},
+			complete: function() {
+				global.FileReader = previousFileReader;
+				assert.strictEqual(50, stepped);
+				assert.deepEqual(rows, parsedRows);
+				done();
+			}
+		});
+	});
