+@doc Markdown.doc"""
+    tail(p::MPolyElem)
+
+Return the tail of the polynomial $p$, i.e. the polynomial without its leading
+term (if any).
+"""
+function tail(p::MPolyElem{T}) where T <: RingElement
+   S = parent(p)
+   if iszero(p)
+      return S()
+   end
+   ctx = MPolyBuildCtx(S)
+   tail_cv = Iterators.drop(zip(coefficients(p), exponent_vectors(p)), 1)
+   for (c, v) in tail_cv
+      push_term!(ctx, c, v)
+   end
+   return finish(ctx)
+end
