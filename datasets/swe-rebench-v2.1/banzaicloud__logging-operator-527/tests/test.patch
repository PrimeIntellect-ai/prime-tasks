+// normalizeLines trims each line and drops blank ones, so indentation and
+// blank lines do not influence the comparison.
+func normalizeLines(lines []string) []string {
+	var out []string
+	for _, l := range lines {
+		if s := strings.TrimSpace(l); s != "" {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+// splitFieldsBlock separates the <fields> subdirective from the rest of the
+// rendered splunk_hec plugin. It returns the non-empty lines of the block, the
+// remaining lines, and the position of the block relative to the match section.
+func splitFieldsBlock(t *testing.T, rendered string) (block []string, rest []string, inMatch bool) {
+	t.Helper()
+	lines := strings.Split(rendered, "\n")
+	inPlugin, pluginDone, inBlock, blockSeen := false, false, false, false
+	for _, raw := range lines {
+		line := strings.TrimSpace(raw)
+		if !pluginDone && strings.HasPrefix(line, "@type splunk_hec") {
+			inPlugin = true
+		}
+		if inPlugin && line == "</match>" {
+			pluginDone = true
+			inPlugin = false
+		}
+		if inBlock {
+			if line == "</fields>" {
+				inBlock = false
+				continue
+			}
+			block = append(block, line)
+			continue
+		}
+		if line == "<fields>" {
+			if !inPlugin || blockSeen {
+				t.Fatalf("fields block must appear once inside the splunk_hec match section:\n%s", rendered)
+			}
+			inBlock, blockSeen = true, true
+			inMatch = true
+			continue
+		}
+		rest = append(rest, raw)
+	}
+	if inBlock {
+		t.Fatalf("unterminated fields block:\n%s", rendered)
+	}
+	return normalizeLines(block), normalizeLines(rest), inMatch
+}
