+// TestGitPreCommitStagedScansOnlyStagedChanges runs the gitleaks CLI with
+// `git --pre-commit --staged` on a repository whose committed history holds one
+// secret and whose staged (uncommitted) changes hold another. Only the staged
+// secret may be reported.
+func TestGitPreCommitStagedScansOnlyStagedChanges(t *testing.T) {
+	const (
+		committedSecret = "AKIALALEMEL33243OLIA"
+		stagedSecret    = "AKIALALEMEL33243OLIB"
+	)
+
+	binPath := filepath.Join(t.TempDir(), "gitleaks")
+	buildOut, err := exec.Command("go", "build", "-o", binPath, "..").CombinedOutput()
+	require.NoError(t, err, string(buildOut))
+
+	repo := t.TempDir()
+	git := func(args ...string) {
+		t.Helper()
+		full := append([]string{"-C", repo, "-c", "user.name=gitleaks-test", "-c", "user.email=test@example.com"}, args...)
+		out, err := exec.Command("git", full...).CombinedOutput()
+		require.NoError(t, err, string(out))
+	}
+	git("init", "-q")
+	require.NoError(t, os.WriteFile(filepath.Join(repo, "committed.go"),
+		[]byte(fmt.Sprintf("package main\n\nvar token = %q\n", committedSecret)), 0o600))
+	git("add", "committed.go")
+	git("commit", "-q", "-m", "add committed secret")
+	require.NoError(t, os.WriteFile(filepath.Join(repo, "staged.go"),
+		[]byte(fmt.Sprintf("package main\n\nvar token = %q\n", stagedSecret)), 0o600))
+	git("add", "staged.go")
+
+	reportPath := filepath.Join(t.TempDir(), "report.json")
+	out, err := exec.Command(binPath, "git", "--pre-commit", "--staged",
+		"--exit-code", "0", "--no-banner",
+		"--report-format", "json", "--report-path", reportPath, repo).CombinedOutput()
+	require.NoError(t, err, string(out))
+
+	data, err := os.ReadFile(reportPath)
+	require.NoError(t, err)
+	var findings []report.Finding
+	require.NoError(t, json.Unmarshal(data, &findings))
+
+	var secrets []string
+	for _, f := range findings {
+		secrets = append(secrets, f.Secret)
+	}
+	assert.ElementsMatch(t, []string{stagedSecret}, secrets)
+}
