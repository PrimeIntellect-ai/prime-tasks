+func TestServiceCreateTimeout(t *testing.T) {
+	action, created, _, err := fakeServiceCreate([]string{
+		"service", "create", "foo", "--image", "gcr.io/foo/bar:baz", "--timeout", "2"}, false)
+	assert.NilError(t, err)
+	assert.Assert(t, action.Matches("create", "services"))
+
+	assert.Assert(t, created.Spec.Template.Spec.TimeoutSeconds != nil)
+	assert.DeepEqual(t, int64(2), *created.Spec.Template.Spec.TimeoutSeconds)
+}
+
+func TestServiceCreateTimeoutDefault(t *testing.T) {
+	knParams := &commands.KnParams{}
+	cmd, _, _ := commands.CreateTestKnCommand(NewServiceCommand(knParams), knParams)
+	createCmd, _, err := cmd.Find([]string{"service", "create"})
+	assert.NilError(t, err)
+	timeoutFlag := createCmd.Flag("timeout")
+	assert.Assert(t, timeoutFlag != nil, "the --timeout flag should be available for service create")
+	assert.Equal(t, timeoutFlag.DefValue, "300")
+}
+
+func TestServiceUpdateTimeoutMakesRevision(t *testing.T) {
+	orig := newEmptyService()
+	action, updated, _, err := fakeServiceUpdate(orig, []string{
+		"service", "update", "foo", "--timeout", "10", "--no-wait"})
+	assert.NilError(t, err)
+	assert.Assert(t, action.Matches("update", "services"))
+	assert.Assert(t, updated.Spec.Template.Spec.TimeoutSeconds != nil)
+	assert.DeepEqual(t, int64(10), *updated.Spec.Template.Spec.TimeoutSeconds)
+}
