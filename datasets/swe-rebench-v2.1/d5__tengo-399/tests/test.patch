+func TestJSONDecodePreservesLargeIntegerValue(t *testing.T) {
+	expect(t, `
+json := import("json")
+fmt := import("fmt")
+base_info := bytes("{\"1\":7075984636689534001,\"2\":7075984636689534002}")
+m := json.decode(base_info)
+out := fmt.sprintf("%v %v", m["1"], m["2"])
+`, "7075984636689534001 7075984636689534002")
+}
+
+func expectJSONDecode(t *testing.T, input string) {
+	t.Helper()
+	decoded := module(t, "json").call("decode", input)
+	encoded := module(t, "json").call("encode", decoded.o)
+	var expected, actual interface{}
+	if err := json.Unmarshal([]byte(input), &expected); err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(encoded.o.(*tengo.Bytes).Value, &actual); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(expected, actual) {
+		t.Fatalf("decoded value differs: expected %#v, got %#v", expected, actual)
+	}
+}
