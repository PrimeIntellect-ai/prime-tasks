+import numpy
+import pytest
+from matchms import Spectrum
+from matchms.filtering import add_retention_index
+from matchms.filtering import add_retention_time
+
+
+@pytest.mark.parametrize("value", [100.0, 42, 42.5])
+def test_add_retention_time(value):
+    spectrum_in = Spectrum(mz=numpy.array([], "float"),
+                           intensities=numpy.array([], "float"),
+                           metadata={"retention_time": value})
+
+    spectrum = add_retention_time(spectrum_in)
+
+    actual = spectrum.get("retention_time")
+    assert isinstance(actual, float)
+    assert actual == value
+
+
+@pytest.mark.parametrize("value", [100.0, 987, 987.25])
+def test_add_retention_index(value):
+    spectrum_in = Spectrum(mz=numpy.array([], "float"),
+                           intensities=numpy.array([], "float"),
+                           metadata={"retention_index": value})
+
+    spectrum = add_retention_index(spectrum_in)
+
+    actual = spectrum.get("retention_index")
+    assert isinstance(actual, float)
+    assert actual == value
