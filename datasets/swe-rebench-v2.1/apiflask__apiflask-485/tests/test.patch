diff --git a/tests/test_validators.py b/tests/test_validators.py
new file mode 100644
index 0000000..c2ffd51
--- /dev/null
+++ b/tests/test_validators.py
@@ -0,0 +1,130 @@
+import io
+
+import pytest
+from marshmallow.exceptions import ValidationError
+from werkzeug.datastructures import FileStorage
+
+from apiflask import validators
+
+
+def accepted_filetype_extension(value, extensions, iterable_type=list):
+    for extension in extensions:
+        try:
+            validators.FileType(iterable_type([extension]))(value)
+        except ValidationError:
+            continue
+        return extension
+    pytest.fail('none of the conventional extension spellings was accepted')
+
+
+def assert_filetype_accepts(value, extension, iterable_type=list):
+    try:
+        validators.FileType(iterable_type([extension]))(value)
+    except ValidationError:
+        pytest.fail(f'extension token {extension!r} was not accepted')
+
+
+def test_filesize_min():
+    fs = FileStorage(io.BytesIO(b''.ljust(1024)))
+    validators.FileSize(min='1 KiB', max='2 KiB')(fs)
+    validators.FileSize(min='0 KiB', max='1 KiB')(fs)
+    validators.FileSize()(fs)
+    validators.FileSize(min_inclusive=False, max_inclusive=False)(fs)
+    validators.FileSize(min='1 KiB', max='1 KiB')(fs)
+
+    # The contract requires a descriptive ValidationError when out of bounds,
+    # but does not prescribe its exact wording.
+    with pytest.raises(ValidationError):
+        validators.FileSize(min='2 KiB', max='3 KiB')(fs)
+    with pytest.raises(ValidationError):
+        validators.FileSize(min='2 KiB')(fs)
+    with pytest.raises(ValidationError):
+        validators.FileSize(min='1 KiB', max='2 KiB', min_inclusive=False, max_inclusive=True)(fs)
+    with pytest.raises(ValidationError):
+        validators.FileSize(min='1 KiB', max='1 KiB', min_inclusive=True, max_inclusive=False)(fs)
+
+
+def test_filesize_max():
+    fs = FileStorage(io.BytesIO(b''.ljust(2048)))
+    validators.FileSize(min='1 KiB', max='2 KiB')(fs)
+    validators.FileSize(max='2 KiB')(fs)
+    validators.FileSize()(fs)
+    validators.FileSize(min_inclusive=False, max_inclusive=False)(fs)
+    validators.FileSize(min='2 KiB', max='2 KiB')(fs)
+
+    with pytest.raises(ValidationError):
+        validators.FileSize(min='0 KiB', max='1 KiB')(fs)
+    with pytest.raises(ValidationError):
+        validators.FileSize(max='1 KiB')(fs)
+    with pytest.raises(ValidationError):
+        validators.FileSize(min='1 KiB', max='2 KiB', min_inclusive=True, max_inclusive=False)(fs)
+    with pytest.raises(ValidationError):
+        validators.FileSize(min='2 KiB', max='2 KiB', min_inclusive=False, max_inclusive=True)(fs)
+
+
+def test_filetype():
+    png_fs = FileStorage(io.BytesIO(b''.ljust(1024)), 'test.png')
+    PNG_fs = FileStorage(io.BytesIO(b''.ljust(1024)), 'test.PNG')
+    extension = accepted_filetype_extension(png_fs, ('.png', 'png'))
+    for file in (png_fs, PNG_fs):
+        assert_filetype_accepts(file, extension)
+        assert_filetype_accepts(file, extension.upper())
+
+    # The contract requires a descriptive ValidationError when the extension is
+    # disallowed or missing, but does not prescribe its exact wording.
+    with pytest.raises(ValidationError):
+        jpg_fs = FileStorage(io.BytesIO(b''.ljust(1024)), 'test.jpg')
+        validators.FileType(['.png'])(jpg_fs)
+
+    with pytest.raises(ValidationError):
+        no_ext_fs = FileStorage(io.BytesIO(b''.ljust(1024)), 'test')
+        validators.FileType(['.png'])(no_ext_fs)
+
+
+def test_filetype_uses_the_allowed_extensions():
+    jpg_fs = FileStorage(io.BytesIO(b'image data'), 'photo.jpg')
+    png_fs = FileStorage(io.BytesIO(b'image data'), 'photo.png')
+
+    accepted_filetype_extension(jpg_fs, ('.jpg', 'jpg'), iterable_type=tuple)
+    with pytest.raises(ValidationError):
+        validators.FileType(['.jpg'])(png_fs)
+
+
+def test_filesize_uses_the_uploaded_byte_count_beyond_common_boundaries():
+    fs = FileStorage(io.BytesIO(b'x' * 3073))
+
+    validators.FileSize(min='3 KiB', max='4 KiB')(fs)
+    with pytest.raises(ValidationError):
+        validators.FileSize(max='3 KiB')(fs)
+
+    decimal_fs = FileStorage(io.BytesIO(b'x' * 3500))
+    validators.FileSize(min='3 KB', max='4 KB')(decimal_fs)
+    with pytest.raises(ValidationError):
+        validators.FileSize(max='3 KB')(decimal_fs)
+
+
+def test_filesize_inclusivity_options_are_independent():
+    at_min = FileStorage(io.BytesIO(b'x' * 1024))
+    at_max = FileStorage(io.BytesIO(b'x' * 2048))
+
+    # The inclusive lower bound still accepts equality when the upper bound is exclusive.
+    validators.FileSize(min='1 KiB', max='2 KiB', min_inclusive=True, max_inclusive=False)(at_min)
+    # The inclusive upper bound still accepts equality when the lower bound is exclusive.
+    validators.FileSize(min='1 KiB', max='2 KiB', min_inclusive=False, max_inclusive=True)(at_max)
+
+
+def test_filetype_uses_the_final_filename_extension():
+    fs = FileStorage(io.BytesIO(b'image data'), 'archive.png.jpg')
+
+    extension = accepted_filetype_extension(fs, ('.jpg', 'jpg'))
+    assert_filetype_accepts(fs, extension)
+    with pytest.raises(ValidationError):
+        validators.FileType(['.png'])(fs)
+
+
+def test_filesize_supports_byte_and_mib_units():
+    byte_sized = FileStorage(io.BytesIO(b'x' * 1000))
+    validators.FileSize(min='1000 B', max='1000 B')(byte_sized)
+
+    mib_sized = FileStorage(io.BytesIO(b'x' * (1024 * 1024)))
+    validators.FileSize(min='1 MiB', max='1 MiB')(mib_sized)
