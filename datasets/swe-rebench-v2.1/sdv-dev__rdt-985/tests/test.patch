@@ -0,0 +1,68 @@
+"""Behavioral configuration checks for transformer instance reuse."""
+
+import pytest
+
+from rdt import HyperTransformer
+from rdt.errors import InvalidConfigError
+from rdt.transformers import BaseMultiColumnTransformer, UniformEncoder
+
+
+class DummyMultiColumnTransformer(BaseMultiColumnTransformer):
+    """A minimal multi-column transformer for configuration validation."""
+
+    def _fit(self, data):
+        pass
+
+    def _transform(self, data):
+        return data
+
+    def _reverse_transform(self, data):
+        return data
+
+
+def test_set_config_rejects_reused_transformer():
+    transformer = UniformEncoder()
+    ht = HyperTransformer()
+    config = {
+        'sdtypes': {'first': 'categorical', 'second': 'categorical'},
+        'transformers': {'first': transformer, 'second': transformer},
+    }
+
+    with pytest.raises(InvalidConfigError, match='create different transformer objects'):
+        ht.set_config(config)
+
+
+def test_update_transformers_rejects_batch_reuse_without_partial_update():
+    ht = HyperTransformer()
+    ht.set_config({
+        'sdtypes': {'first': 'categorical', 'second': 'categorical'},
+        'transformers': {'first': None, 'second': None},
+    })
+    transformer = UniformEncoder()
+
+    with pytest.raises(InvalidConfigError, match='create different transformer objects'):
+        ht.update_transformers({'first': transformer, 'second': transformer})
+
+    configured = ht.get_config()['transformers']
+    assert configured['first'] is None
+    assert configured['second'] is None
+
+
+def test_set_config_rejects_reused_multi_column_transformer():
+    transformer = DummyMultiColumnTransformer()
+    ht = HyperTransformer()
+    config = {
+        'sdtypes': {
+            'first_a': 'numerical',
+            'first_b': 'numerical',
+            'second_a': 'numerical',
+            'second_b': 'numerical',
+        },
+        'transformers': {
+            ('first_a', 'first_b'): transformer,
+            ('second_a', 'second_b'): transformer,
+        },
+    }
+
+    with pytest.raises(InvalidConfigError, match='create different transformer objects'):
+        ht.set_config(config)
