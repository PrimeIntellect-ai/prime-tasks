+import execa from 'execa'
+import childProcess from 'child_process'
+import fs from 'fs'
+import os from 'os'
+import path from 'path'
 import findBin from '../src/findBin'
+import runScript from '../src/runScript'
 
 jest.mock('npm-which')
+jest.mock('execa')
 
 const scripts = { test: 'noop' }
 
+// Runs a single lint-staged command and returns the argv that is actually
+// handed to the underlying process. This exercises the public behaviour (the
+// command that gets executed) instead of the internal shape of findBin's
+// return value, which the contract does not specify.
+async function runCommand(cmd, paths, packageScripts, options) {
+  const res = runScript(cmd, paths, packageScripts, options)
+  await res[0].task()
+  return execa.mock.calls[0]
+}
+
+function expectStagedPaths(args, paths) {
+  const forwardedPaths = args.slice(-paths.length)
+  expect(forwardedPaths.map(file => path.resolve(process.cwd(), file))).toEqual(
+    paths.map(file => path.resolve(process.cwd(), file))
+  )
+}
