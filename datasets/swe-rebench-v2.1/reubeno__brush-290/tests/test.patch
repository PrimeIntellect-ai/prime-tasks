index bf87537..05bfedf 100644
--- a/brush-core/src/extendedtests.rs
+++ b/brush-core/src/extendedtests.rs
@@ -491,3 +491,34 @@ fn apply_test_binary_arithmetic_predicate(
         false
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use anyhow::Result;
+
+    #[tokio::test]
+    async fn test_word_expansion_supports_braces() -> Result<()> {
+        let options = crate::shell::CreateOptions::default();
+        let mut shell = crate::shell::Shell::new(&options).await?;
+
+        // Brace expansion is applied as part of normal word expansion.
+        assert_eq!(
+            shell.full_expand_and_split_string("{a,b}").await?,
+            vec!["a", "b"]
+        );
+        assert_eq!(
+            shell.full_expand_and_split_string("1{a,b}2").await?,
+            vec!["1a2", "1b2"]
+        );
+        assert_eq!(
+            shell.full_expand_and_split_string("{1..3}").await?,
+            vec!["1", "2", "3"]
+        );
+        assert_eq!(
+            shell.full_expand_and_split_string("\"{1..3}\"").await?,
+            vec!["{1..3}"]
+        );
+        Ok(())
+    }
+
+}
