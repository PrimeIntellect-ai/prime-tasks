 )
 def test_typing_Annotated(annotated_type, expected_strategy_repr):
     assert repr(st.from_type(annotated_type)) == expected_strategy_repr
+
+
+@dataclasses.dataclass
+class User:
+    id: int
+    following: list["User"]  # works with typing.List
+
+
+@dataclasses.dataclass
+class TypingListUser:
+    id: int
+    following: typing.List["TypingListUser"]
+
+
+def test_string_forward_ref_message(tmp_path):
+    # See https://github.com/HypothesisWorks/hypothesis/issues/3016
+    try:
+        user = st.builds(User).example()
+    except InvalidArgument as err:
+        message = str(err)
+        lower_message = message.lower()
+        if "typing.List" in message:
+            user = st.builds(TypingListUser).example()
+            assert isinstance(user, TypingListUser)
+        else:
+            assert "annotation" in lower_message
+            assert any(term in lower_message for term in ("future", "postpon", "defer"))
+            source = '''from __future__ import annotations
+from dataclasses import dataclass
+@dataclass
+class FutureUser:
+    id: int
+    following: list[FutureUser]
+'''
+            path = tmp_path / "future_user.py"
+            path.write_text(source)
+            spec = importlib.util.spec_from_file_location(
+                "recursive_user_future_annotations", path
+            )
+            module = importlib.util.module_from_spec(spec)
+            sys.modules[spec.name] = module
+            try:
+                spec.loader.exec_module(module)
+                user = st.builds(module.FutureUser).example()
+            finally:
+                del sys.modules[spec.name]
+            assert isinstance(user, module.FutureUser)
+    else:
+        assert isinstance(user, User)
+
+    assert isinstance(user.id, int)
+    assert isinstance(user.following, list)
