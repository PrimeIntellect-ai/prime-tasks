+    def test__process_runner_removal_applies_percentage_to_match(self):
+        simulated = mock.MagicMock(matched=[[123, 10, 10]])
+        simulated.__bool__.return_value = True
+        order = mock.Mock(simulated=simulated, info={})
+        runner = mock.Mock(
+            status="REMOVED", selection_id=12345, handicap=0, adjustment_factor=10
+        )
+        market = mock.Mock(
+            market_id="1.23", context={}, market_book=mock.Mock(runners=[runner])
+        )
+        market.blotter = mock.MagicMock()
+        market.blotter.__iter__.return_value = [order]
+        market.blotter.live_orders = [order]
+
+        self.middleware(market)
+
+        self.assertEqual(order.simulated.matched, [[123, 9, 10]])
+
+    def test__process_runner_removal_rounds_above_minimum(self):
+        simulated = mock.MagicMock(matched=[[123, 3.2, 16]])
+        simulated.__bool__.return_value = True
+        order = mock.Mock(simulated=simulated, info={})
+        runner = mock.Mock(
+            status="REMOVED", selection_id=12345, handicap=0, adjustment_factor=16.2
+        )
+        market = mock.Mock(
+            market_id="1.23", context={}, market_book=mock.Mock(runners=[runner])
+        )
+        market.blotter = mock.MagicMock()
+        market.blotter.__iter__.return_value = [order]
+        market.blotter.live_orders = [order]
+
+        self.middleware(market)
+
+        self.assertEqual(order.simulated.matched, [[123, 2.68, 16]])
+
+    def test__process_runner_removal_floors_adjusted_match_price(self):
+        simulated = mock.MagicMock(matched=[[123, 3.2, 10]])
+        simulated.__bool__.return_value = True
+        order = mock.Mock(simulated=simulated, info={})
+        runner = mock.Mock(
+            status="REMOVED", selection_id=12345, handicap=0, adjustment_factor=75.18
+        )
+        market = mock.Mock(
+            market_id="1.23", context={}, market_book=mock.Mock(runners=[runner])
+        )
+        market.blotter = mock.MagicMock()
+        market.blotter.__iter__.return_value = [order]
+        market.blotter.live_orders = [order]
+
+        self.middleware(market)
+
+        self.assertEqual(order.simulated.matched, [[123, 1.01, 10]])
+        self.assertEqual(order.simulated.average_price_matched, 1.01)
