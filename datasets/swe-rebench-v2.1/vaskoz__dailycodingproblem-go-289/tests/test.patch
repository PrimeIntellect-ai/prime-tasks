+package day139
+
+import "testing"
+
+var testcases = []struct {
+	data []interface{}
+}{
+	{[]interface{}{3, 5, 6, 7, 9}},
+	{[]interface{}{"foo", "bar", "baz"}},
+}
+
+type SliceIterator struct {
+	Slice []interface{}
+	pos   int
+}
+
+func (si *SliceIterator) Next() interface{} {
+	if si.pos >= len(si.Slice) {
+		return nil
+	}
+	result := si.Slice[si.pos]
+	si.pos++
+	return result
+}
+
+func (si *SliceIterator) HasNext() bool {
+	return si.pos < len(si.Slice)
+}
+
+func TestPeekableIterator(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		p := PeekableIterator{Iter: &SliceIterator{Slice: tc.data}}
+		for i := range tc.data {
+			if result := p.Peek(); result != tc.data[i] {
+				t.Errorf("Peek should return %v got %v", tc.data[i], result)
+			}
+			if result := p.Peek(); result != tc.data[i] {
+				t.Errorf("Repeated Peek should return %v got %v", tc.data[i], result)
+			}
+			if more := p.HasNext(); !more {
+				t.Errorf("There should be more data")
+			}
+			if result := p.Next(); result != tc.data[i] {
+				t.Errorf("Next should return %v got %v", tc.data[i], result)
+			}
+		}
+		if more := p.HasNext(); more {
+			t.Errorf("There should be NO more data")
+		}
+	}
+}
+
+func TestPeekableIteratorNoPeek(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		p := PeekableIterator{Iter: &SliceIterator{Slice: tc.data}}
+		for i := range tc.data {
+			if more := p.HasNext(); !more {
+				t.Errorf("There should be more data")
+			}
+			if result := p.Next(); result != tc.data[i] {
+				t.Errorf("Next should return %v got %v", tc.data[i], result)
+			}
+		}
+		if more := p.HasNext(); more {
+			t.Errorf("There should be NO more data")
+		}
+	}
+}
+
+func BenchmarkPeekableIterator(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			p := PeekableIterator{Iter: &SliceIterator{Slice: tc.data}}
+			for range tc.data {
+				p.Peek()
+				p.HasNext()
+				p.Next()
+			}
+		}
+	}
+}
+
+func TestPeekableIteratorPeekThenNext(t *testing.T) {
+	t.Parallel()
+	p := PeekableIterator{Iter: &SliceIterator{Slice: []interface{}{1, 2, 3}}}
+	if got := p.Peek(); got != 1 {
+		t.Fatalf("Peek should return 1 got %v", got)
+	}
+	if got := p.Next(); got != 1 {
+		t.Fatalf("Next after Peek should return the peeked 1 got %v", got)
+	}
+	if got := p.Next(); got != 2 {
+		t.Fatalf("Next after consuming the peeked value should return 2 got %v", got)
+	}
+	if got := p.Peek(); got != 3 {
+		t.Fatalf("Peek should return 3 got %v", got)
+	}
+	if got := p.Next(); got != 3 {
+		t.Fatalf("Next after Peek should return the peeked 3 got %v", got)
+	}
+	if more := p.HasNext(); more {
+		t.Errorf("There should be NO more data")
+	}
+}
+
+func TestPeekableIteratorPeekedElementCountsAsRemaining(t *testing.T) {
+	t.Parallel()
+	p := PeekableIterator{Iter: &SliceIterator{Slice: []interface{}{"only"}}}
+	if got := p.Peek(); got != "only" {
+		t.Fatalf("Peek should return only got %v", got)
+	}
+	if more := p.HasNext(); !more {
+		t.Errorf("A peeked element should still count as remaining data")
+	}
+	if got := p.Next(); got != "only" {
+		t.Fatalf("Next should return only got %v", got)
+	}
+	if more := p.HasNext(); more {
+		t.Errorf("There should be NO more data")
+	}
+}
