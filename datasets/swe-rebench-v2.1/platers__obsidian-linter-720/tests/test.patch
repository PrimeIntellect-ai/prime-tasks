diff --git a/__tests__/yaml-title-alias.test.ts b/__tests__/yaml-title-alias.test.ts
index 21e7029..b95a24f 100644
--- a/__tests__/yaml-title-alias.test.ts
+++ b/__tests__/yaml-title-alias.test.ts
@@ -2,6 +2,7 @@ import YamlTitleAlias from '../src/rules/yaml-title-alias';
 import dedent from 'ts-dedent';
 import {ruleTest} from './common';
 import {NormalArrayFormats, SpecialArrayFormats} from '../src/utils/yaml';
+import {load} from 'js-yaml';
 
 ruleTest({
   RuleBuilderClass: YamlTitleAlias,
@@ -1156,5 +1157,83 @@ ruleTest({
         useYamlKeyToKeepTrackOfOldFilenameOrHeading: false,
       },
     },
+    { // accounts for https://github.com/platers/obsidian-linter/issues/630
+      testName: 'Make sure alias is escaped when a comma is present and the array style is single-line',
+      before: dedent`
+        ---
+        aliases: [alias1]
+        ---
+        # Header, with comma
+      `,
+      after: dedent`
+        ---
+        aliases: ["Header, with comma", alias1]
+        ---
+        # Header, with comma
+      `,
+      options: {
+        aliasArrayStyle: NormalArrayFormats.SingleLine,
+        useYamlKeyToKeepTrackOfOldFilenameOrHeading: false,
+      },
+    },
+    { // accounts for https://github.com/platers/obsidian-linter/issues/630
+      testName: 'Make sure alias is escaped when a comma is present and the array style is single string to single-line',
+      before: dedent`
+        ---
+        aliases: alias1
+        ---
+        # Header, with comma
+      `,
+      after: dedent`
+        ---
+        aliases: ["Header, with comma", alias1]
+        ---
+        # Header, with comma
+      `,
+      options: {
+        aliasArrayStyle: SpecialArrayFormats.SingleStringToSingleLine,
+        useYamlKeyToKeepTrackOfOldFilenameOrHeading: false,
+      },
+    },
+    { // accounts for https://github.com/platers/obsidian-linter/issues/630
+      testName: 'Make sure alias is escaped when a comma is present and the array style is a comma delimited string',
+      before: dedent`
+        ---
+        aliases: alias1
+        ---
+        # Header, with comma
+      `,
+      after: dedent`
+        ---
+        aliases: "Header, with comma", alias1
+        ---
+        # Header, with comma
+      `,
+      options: {
+        aliasArrayStyle: SpecialArrayFormats.SingleStringCommaDelimited,
+        useYamlKeyToKeepTrackOfOldFilenameOrHeading: false,
+      },
+    },
   ],
 });
+
+describe('YAML Title Alias comma aliases', () => {
+  it('keeps a comma-containing title as one alias in a multiline array', () => {
+    const title = 'Header, with comma';
+    const output = YamlTitleAlias.getRule().apply(dedent`
+      ---
+      aliases:
+        - alias1
+      ---
+      # ${title}
+    `, {
+      aliasArrayStyle: NormalArrayFormats.MultiLine,
+      useYamlKeyToKeepTrackOfOldFilenameOrHeading: false,
+    });
+    const frontmatter = output.match(/^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/)!;
+    const parsed = load(frontmatter[1]) as {aliases: string[]};
+
+    expect(Array.isArray(parsed.aliases)).toBe(true);
+    expect(parsed.aliases.filter((alias) => alias === title)).toHaveLength(1);
+  });
+});
