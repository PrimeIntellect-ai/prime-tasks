+
+func TestNextLineDirectiveSuppressesMethodNaming(t *testing.T) {
+	source := `package sample
+
+type Source struct{}
+
+// Method documentation.
+//revive:disable-next-line:var-naming
+func (source Source) BaseApiURL() string { return "" }
+`
+	l := lint.New(func(string) ([]byte, error) {
+		return []byte(source), nil
+	})
+	problems, err := l.Lint([][]string{{"sample.go"}}, []lint.Rule{&rule.VarNamingRule{}}, lint.Config{
+		Rules: map[string]lint.RuleConfig{"var-naming": {}},
+	})
+	if err != nil {
+		t.Fatalf("linting source: %v", err)
+	}
+	for problem := range problems {
+		t.Errorf("the next-line directive did not suppress the method naming diagnostic: %q", problem.Failure)
+	}
+}
