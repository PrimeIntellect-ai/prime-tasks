+def test_parameter_shift_gradient():
+    """Test that ``PrepSelPrep`` is differentiable with the parameter-shift rule.
+
+    Regression test for GitHub issue #6331: differentiating ``PrepSelPrep`` with
+    ``diff_method="parameter-shift"`` used to silently return zeros.
+    """
+    dev = qml.device("default.qubit")
+
+    def make_circuit(diff_method):
+        @qml.qnode(dev, diff_method=diff_method)
+        def circuit(params):
+            H = qml.Hamiltonian(params, [qml.Z(2), qml.X(1) @ qml.X(2)])
+            qml.PrepSelPrep(H, control=[0])
+            return qml.expval(qml.PauliZ(0))
+
+        return circuit
+
+    x = qml.numpy.array([0.25, 0.75])
+    ps_grad = qml.jacobian(make_circuit("parameter-shift"))(x)
+    bp_grad = qml.jacobian(make_circuit("backprop"))(x)
+
+    # The parameter-shift gradient must not silently vanish ...
+    assert not np.allclose(ps_grad, 0.0), "parameter-shift gradient should not be zero"
+    # ... and it must agree with the reference backpropagation gradient.
+    assert np.allclose(ps_grad, bp_grad), "parameter-shift and backprop gradients must agree"
+
+
+def test_assert_valid_skip_differentiation_only_skips_gradients():
+    """``skip_differentiation=True`` must only disable the differentiation checks.
+
+    All other validation performed by ``assert_valid`` must still run.
+    """
+    # A valid operator passes when the differentiation checks are disabled.
+    lcu = qml.dot([0.25, 0.75], [qml.Z(2), qml.X(1) @ qml.X(2)])
+    qml.ops.functions.assert_valid(
+        qml.PrepSelPrep(lcu, control=[0]), skip_differentiation=True
+    )
+
+    # An operator with a broken (non-differentiation) property is still rejected.
+    class BadMatrixOp(qml.operation.Operator):
+        num_wires = 1
+
+        def __init__(self, wires):
+            super().__init__(wires=wires)
+
+        def matrix(self):
+            return np.eye(3)
+
+    with pytest.raises(AssertionError, match="matrix must be two dimensional"):
+        qml.ops.functions.assert_valid(
+            BadMatrixOp(0), skip_pickle=True, skip_differentiation=True
+        )
 
 
