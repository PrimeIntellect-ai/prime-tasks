@@ -7,6 +7,11 @@ using Test:
 using JuliaSyntax:
     JuliaSyntax, @K_str, @KSet_str
 
+# The contract requires at least one space before a comment. Implementations may
+# normalize the separator to exactly one space, so compare modulo runs of spaces
+# that immediately precede a comment marker.
+collapse_comment_space(s) = replace(s, r"(?<=[^\s]) +(?=#)" => " ")
+
 @testset "Node" begin
     node = Runic.Node(JuliaSyntax.parseall(JuliaSyntax.GreenNode, "a = 1 + b\n"))
 
@@ -76,6 +81,21 @@ end
         format_string("# comment \t ") == format_string("# comment\t \t") == "# comment"
 end
 
+@testset "space before comment" begin
+    for sp in ("", " ", "  ")
+        @test collapse_comment_space(format_string("a$(sp)# comment")) == "a # comment"
+        @test collapse_comment_space(format_string("1 + 1$(sp)# comment")) == "1 + 1 # comment"
+        @test collapse_comment_space(format_string("(a,$(sp)# comment\nb)")) ==
+            "(\n    a, # comment\n    b,\n)"
+        # Edgecase where the comment ends up as the first leaf inside the call
+        @test collapse_comment_space(format_string("(a,$(sp)# comment\nb + b)")) ==
+            "(\n    a, # comment\n    b + b,\n)"
+    end
+    let str = "a = 1  # a comment\nab = 2 # ab comment\n"
+        @test format_string(str) == str
+    end
+end
