+func TestGenerateIPPermissionsNilPorts(t *testing.T) {
+	got := GenerateIPPermissions([]ec2.IpPermission{
+		{IpProtocol: aws.String("-1")},
+		{IpProtocol: aws.String("-1")},
+	})
+	if len(got) != 2 {
+		t.Fatalf("expected both permissions to be converted, got %d", len(got))
+	}
+	for _, permission := range got {
+		if permission.FromPort != nil || permission.ToPort != nil || permission.IPProtocol != "-1" {
+			t.Errorf("permission lost omitted-port protocol values: %#v", permission)
+		}
+	}
