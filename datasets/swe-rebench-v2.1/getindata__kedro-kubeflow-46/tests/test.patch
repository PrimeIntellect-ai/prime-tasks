+    def test_should_support_params_and_inject_them_to_the_nodes(self):
+        # given
+        run_mock = unittest.mock.MagicMock()
+        self.kfp_client_mock.create_run_from_pipeline_func.return_value = (
+            run_mock
+        )
+        self.create_client({}, {"param1": 0.3, "param2": 42})
+
+        # when
+        self.client_under_test.run_once(
+            run_name="unittest",
+            pipeline="pipeline",
+            image="unittest-image",
+            experiment_name="experiment",
+            wait=False,
+        )
+
+        # then
+        self.kfp_client_mock.create_run_from_pipeline_func.assert_called()
+        run_mock.wait_for_run_completion.assert_not_called()
+        (
+            args,
+            kwargs,
+        ) = self.kfp_client_mock.create_run_from_pipeline_func.call_args
+
+        default_params = signature(args[0]).parameters
+
+        assert {"param1", "param2"}.issubset(default_params)
+        assert default_params["param1"].default == 0.3
+        assert default_params["param2"].default == 42
+        with NamedTemporaryFile(suffix=".yaml") as pipeline_file:
+            Compiler().compile(args[0], pipeline_file.name)
+            with open(pipeline_file.name) as yamlfile:
+                compiled_pipeline = yaml.safe_load(yamlfile)
+
+        templates = compiled_pipeline["spec"]["templates"]
+        root_template = next(
+            template
+            for template in templates
+            if "dag" in template and template["name"] == "my-awesome-project"
+        )
+        tasks = {task["name"]: task for task in root_template["dag"]["tasks"]}
+        for node_name in ("node1", "node2"):
+            task_parameters = {
+                parameter["name"]: parameter["value"]
+                for parameter in tasks[node_name]["arguments"]["parameters"]
+            }
+            assert {"param1", "param2"}.issubset(task_parameters)
+            for parameter_name in ("param1", "param2"):
+                assert parameter_name in str(task_parameters[parameter_name])
+
