+
+describe('decorator names in stored validation metadata', () => {
+  const getStoredNames = (target: Function, propertyName: string): (string | undefined)[] =>
+    getMetadataStorage()
+      .getTargetValidationMetadatas(target, '', true, false)
+      .filter(metadata => metadata.propertyName === propertyName)
+      .map(metadata => (metadata as { name?: string }).name);
+
+  it('should keep the name of a built-in decorator in its stored metadata', () => {
+    class MyClass {
+      @IsString()
+      someProperty: string;
+    }
+
+    expect(getStoredNames(MyClass, 'someProperty')).toContain('isString');
+  });
+
+  it('should keep the name given to a custom decorator in its stored metadata', () => {
+    function IsCustomRule(): PropertyDecorator {
+      return (object: object, propertyName: string | symbol): void => {
+        registerDecorator({
+          name: 'isCustomRule',
+          target: object.constructor,
+          propertyName: propertyName as string,
+          validator: { validate: (): boolean => true },
+        });
+      };
+    }
+
+    class MyClass {
+      @IsCustomRule()
+      someProperty: string;
+    }
+
+    expect(getStoredNames(MyClass, 'someProperty')).toContain('isCustomRule');
+  });
+});
