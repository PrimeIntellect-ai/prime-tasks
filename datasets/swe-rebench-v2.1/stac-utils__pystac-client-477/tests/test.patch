+            json={
+                "type": "Catalog",
+                "id": "test-catalog",
+                "description": "A test catalog",
+                "stac_version": "1.0.0",
+                "conformsTo": ["https://api.stacspec.org/v1.0.0/item-search#filter"],
+                "links": [{"rel": "self", "href": root_url}],
+            },
+        )
+        requests_mock.get(
+            queryables_url,
+            json={
+                "type": "object",
+                "properties": {"server_defined_field": {"type": "integer"}},
+            },
+        )
+
+        result = Client.open(root_url).get_queryables()
+
+        assert "server_defined_field" in result["properties"]
