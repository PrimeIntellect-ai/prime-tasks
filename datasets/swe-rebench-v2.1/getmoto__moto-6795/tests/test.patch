+@mock_kms
+def test_verify_uses_original_raw_message_bytes():
+    kms_client = boto3.client("kms", region_name="us-east-1")
+    key_id = kms_client.create_key(
+        KeyUsage="SIGN_VERIFY",
+        CustomerMasterKeySpec="ECC_NIST_P256",
+    )["KeyMetadata"]["KeyId"]
+    public_key_data = kms_client.get_public_key(KeyId=key_id)["PublicKey"]
+    message = b"verification uses the original message"
+    signature = kms_client.sign(
+        KeyId=key_id,
+        Message=message,
+        MessageType="RAW",
+        SigningAlgorithm="ECDSA_SHA_256",
+    )["Signature"]
+
+    public_key = serialization.load_der_public_key(public_key_data)
+    public_key.verify(
+        signature=signature,
+        data=message,
+        signature_algorithm=ec.ECDSA(hashes.SHA256()),
+    )
+    result = kms_client.verify(
+        KeyId=key_id,
+        Message=message,
+        MessageType="RAW",
+        Signature=signature,
+        SigningAlgorithm="ECDSA_SHA_256",
+    )
+
+    assert result["SignatureValid"] is True
