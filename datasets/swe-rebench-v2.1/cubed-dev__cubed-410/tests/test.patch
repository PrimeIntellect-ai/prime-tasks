+def test_finfo():
+    fi = xp.finfo(xp.float32)
+    assert fi.bits == 32
+    assert fi.dtype == xp.float32
+    assert isinstance(fi.eps, (float, np.floating))
+    assert fi.eps == np.finfo(np.float32).eps
+    assert fi.max == np.finfo(np.float32).max
+    assert fi.min == np.finfo(np.float32).min
+    assert fi.smallest_normal == np.finfo(np.float32).smallest_normal
+
+
+def test_unique_values(spec):
+    a = xp.asarray([1, 2, 2, 3, 3, 3], chunks=(2,), spec=spec)
+    u = nxp.unique_values(a.compute())
+    assert u.ndim == 1
+    assert sorted(u.tolist()) == [1, 2, 3]
+
+
+def test_cubed_import_without_numpy_array_api():
+    script = """
+import importlib.abc
+import sys
+
+class BlockArrayApi(importlib.abc.MetaPathFinder):
+    def find_spec(self, fullname, path=None, target=None):
+        if fullname == "numpy.array_api" or fullname.startswith("numpy.array_api."):
+            raise ModuleNotFoundError("numpy.array_api is unavailable")
+        return None
+
+sys.meta_path.insert(0, BlockArrayApi())
+import cubed
+"""
+    result = subprocess.run(
+        [sys.executable, "-c", script], capture_output=True, text=True
+    )
+    assert result.returncode == 0, result.stderr
