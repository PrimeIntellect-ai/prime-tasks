+#[test]
+fn test_raw_origin_initial_pos_anon_lines() {
+    let dl = DisplayList::from(vec![DisplayLine::Raw(DisplayRawLine::Origin {
+        path: "src/test.rs".to_string(),
+        pos: Some((23, 15)),
+        header_type: DisplayHeaderType::Initial,
+    })]);
+
+    let dlf = formatter(true);
+
+    // Using anonymized_line_numbers should not affect the inital position
+    assert_eq!(dlf.format(&dl), "--> src/test.rs:23:15");
+}
+
+#[test]
+fn test_source_content_anon_lines() {
+    let dl = DisplayList::from(vec![
+        DisplayLine::Source {
+            lineno: Some(2),
+            inline_marks: vec![],
+            line: DisplaySourceLine::Content {
+                text: "first line".to_string(),
+                range: (0, 10),
+            },
+        },
+        DisplayLine::Source {
+            lineno: Some(123),
+            inline_marks: vec![],
+            line: DisplaySourceLine::Content {
+                text: "second line".to_string(),
+                range: (0, 11),
+            },
+        },
+    ]);
+
+    let dlf = formatter(true);
+    let out = dlf.format(&dl);
+    let lines: Vec<&str> = out.lines().collect();
+
+    assert_eq!(lines.len(), 2, "unexpected output: {:?}", out);
+    assert!(lines[0].starts_with("LL "), "unexpected output: {:?}", out);
+    assert!(lines[1].starts_with("LL "), "unexpected output: {:?}", out);
+    assert!(lines[0].contains("first line"), "unexpected output: {:?}", out);
+    assert!(lines[1].contains("second line"), "unexpected output: {:?}", out);
+    assert!(!out.contains("2 |"), "unexpected output: {:?}", out);
+    assert!(!out.contains("123"), "unexpected output: {:?}", out);
+}
