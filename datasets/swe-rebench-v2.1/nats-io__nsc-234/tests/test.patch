+package cmd
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func Test_DeleteUserCanRevoke(t *testing.T) {
+	ts := NewTestStore(t, "O")
+	defer ts.Done(t)
+
+	ts.AddAccount(t, "A")
+	ts.AddUser(t, "A", "U")
+
+	uc, err := ts.Store.ReadUserClaim("A", "U")
+	require.NoError(t, err)
+	upk := uc.Subject
+
+	_, _, err = ExecuteCmd(GetRootCmd(), "delete", "user", "U", "--revoke")
+	require.NoError(t, err)
+
+	ac, err := ts.Store.ReadAccountClaim("A")
+	require.NoError(t, err)
+	require.NotZero(t, ac.Revocations[upk])
+	uc, err = ts.Store.ReadUserClaim("A", "U")
+	require.Error(t, err)
+	require.Nil(t, uc)
+}
+
+func Test_DeleteUserWithoutRevoke(t *testing.T) {
+	ts := NewTestStore(t, "O")
+	defer ts.Done(t)
+
+	ts.AddAccount(t, "A")
+	ts.AddUser(t, "A", "U")
+
+	uc, err := ts.Store.ReadUserClaim("A", "U")
+	require.NoError(t, err)
+	upk := uc.Subject
+
+	root := GetRootCmd()
+	userCmd, _, err := root.Find([]string{"delete", "user"})
+	require.NoError(t, err)
+	if nameFlag := userCmd.Flags().Lookup("name"); nameFlag != nil {
+		_ = nameFlag.Value.Set("")
+	}
+	if revokeFlag := userCmd.Flags().Lookup("revoke"); revokeFlag != nil {
+		_ = revokeFlag.Value.Set("false")
+	}
+	_, _, err = ExecuteCmd(root, "delete", "user", "U")
+	require.NoError(t, err)
+
+	ac, err := ts.Store.ReadAccountClaim("A")
+	require.NoError(t, err)
+	require.Zero(t, ac.Revocations[upk])
+	uc, err = ts.Store.ReadUserClaim("A", "U")
+	require.Error(t, err)
+	require.Nil(t, uc)
+}
