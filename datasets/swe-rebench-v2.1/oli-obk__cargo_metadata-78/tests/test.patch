+
+#[test]
+fn error_is_failure() {
+    // The public error type must implement `failure::Fail`, so that an `Error`
+    // value can be converted into a `failure::Error`.
+    let err = Error::CargoMetadata {
+        stderr: "boom".to_string(),
+    };
+    let failure_err: failure::Error = err.into();
+    assert!(format!("{}", failure_err).contains("boom"));
+}
