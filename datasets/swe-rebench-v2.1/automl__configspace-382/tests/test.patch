+def test_constant_configuration_str():
+    # Printing a Configuration with a list- or tuple-valued Constant
+    # should not throw an exception.
+    for value in (["a", "b", "c"], ("a", "b", "c")):
+        cs = ConfigurationSpace()
+        cs.add(Constant("tags", value))
+        config = cs.sample_configuration()
+        str(config)  # must not raise
+        assert config["tags"] == value
