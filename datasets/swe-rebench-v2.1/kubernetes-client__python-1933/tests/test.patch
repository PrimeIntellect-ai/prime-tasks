+    def test_tls_server_name_is_sent_in_https_handshake(self):
+        listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+        listener.bind(('127.0.0.1', 0))
+        listener.listen(1)
+        listener.settimeout(3)
+        request_url = 'https://127.0.0.1:%d' % listener.getsockname()[1]
+        received = {}
+
+        def capture_client_hello():
+            connection, _ = listener.accept()
+            with connection:
+                connection.settimeout(3)
+                header = connection.recv(5)
+                if len(header) == 5 and header[0] == 22:
+                    record_length = struct.unpack('!H', header[3:5])[0]
+                    record = header
+                    while len(record) < 5 + record_length:
+                        chunk = connection.recv(5 + record_length - len(record))
+                        if not chunk:
+                            break
+                        record += chunk
+                    received['record'] = record
+                else:
+                    received['record'] = header
+
+        server = threading.Thread(target=capture_client_hello)
+        server.daemon = True
+        server.start()
+
+        actual = Configuration()
+        KubeConfigLoader(
+            config_dict=self.TEST_KUBE_CONFIG,
+            active_context="tls-server-name").load_and_set(actual)
+        actual.host = request_url
+        actual.verify_ssl = False
+        actual.ssl_ca_cert = None
+        actual.cert_file = None
+        actual.key_file = None
+        actual.retries = 0
+        try:
+            try:
+                RESTClientObject(actual).request(
+                    'GET', request_url, _request_timeout=2)
+            except Exception:
+                # The listener closes after inspecting the ClientHello rather
+                # than completing a TLS session or serving an HTTP response.
+                pass
+        finally:
+            server.join(4)
+            listener.close()
+
+        record = received.get('record', b'')
+        self.assertTrue(record.startswith(b'\x16'))
+        hello = record[5:]
+        self.assertEqual(1, hello[0])  # TLS ClientHello handshake message
+        offset = 4 + 2 + 32  # handshake header, version, and random
+        session_length = hello[offset]
+        offset += 1 + session_length
+        cipher_length = struct.unpack('!H', hello[offset:offset + 2])[0]
+        offset += 2 + cipher_length
+        compression_length = hello[offset]
+        offset += 1 + compression_length
+        extensions_length = struct.unpack('!H', hello[offset:offset + 2])[0]
+        offset += 2
+        extensions_end = offset + extensions_length
+        server_name = None
+        while offset + 4 <= extensions_end:
+            extension_type, extension_length = struct.unpack(
+                '!HH', hello[offset:offset + 4])
+            offset += 4
+            extension = hello[offset:offset + extension_length]
+            offset += extension_length
+            if extension_type == 0:
+                names_length = struct.unpack('!H', extension[:2])[0]
+                name_type = extension[2]
+                name_length = struct.unpack('!H', extension[3:5])[0]
+                if names_length >= 3 + name_length and name_type == 0:
+                    server_name = extension[5:5 + name_length].decode('ascii')
+                    break
+        self.assertEqual(TEST_TLS_SERVER_NAME, server_name)
+
