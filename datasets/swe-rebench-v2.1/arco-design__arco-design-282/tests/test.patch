diff --git a/components/Form/__test__/validate.test.tsx b/components/Form/__test__/validate.test.tsx
index 91dff6e..d8aec2a 100644
--- a/components/Form/__test__/validate.test.tsx
+++ b/components/Form/__test__/validate.test.tsx
@@ -77,4 +77,36 @@ describe('validate form', () => {
     expect(mockBlurFn).toHaveBeenCalledTimes(3);
     expect(mockClickFn).toHaveBeenCalledTimes(2);
   });
+
+  it('keeps an optional empty field gray after submit', async () => {
+    const less = require('less');
+    const { css: compiledCss } = await less.render(
+      '@import "components/Form/style/index.less"; @import "components/Input/style/index.less";',
+      { paths: [process.cwd()] }
+    );
+    const css = compiledCss
+      .replace(/var\(--color-warning-light-1\)/g, 'rgb(255, 239, 200)')
+      .replace(/var\(--color-bg-2\)/g, 'rgb(255, 255, 255)');
+    const styles = document.createElement('style');
+    styles.textContent = css;
+    document.head.appendChild(styles);
+
+    let form;
+    const wrapper = mount(
+      <Form ref={(node) => (form = node)}>
+        <Form.Item label="Nickname" field="nickname" rules={[{ required: false }]}>
+          <Input placeholder="please enter your nickname" />
+        </Form.Item>
+      </Form>
+    );
+
+    form.submit();
+    await sleep(10);
+    wrapper.update();
+
+    const input = wrapper.find('input').at(0).getDOMNode();
+    const optionalBackground = window.getComputedStyle(input).backgroundColor;
+    expect(optionalBackground).not.toBe('rgb(255, 239, 200)');
+    styles.remove();
+  });
 });
