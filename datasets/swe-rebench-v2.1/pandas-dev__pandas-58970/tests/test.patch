+    def test_big_endian_strl_records_are_valid(self, temp_file):
+        values = ["abc", "def", "ghi"]
+        original = DataFrame({"strings": values})
+        original.to_stata(
+            temp_file,
+            byteorder="big",
+            convert_strl=["strings"],
+            version=117,
+            write_index=False,
+        )
+
+        reread = read_stata(temp_file)
+        tm.assert_frame_equal(reread, original)
+
+        file_data = temp_file.read_bytes()
+        block_start = file_data.index(b"<strls>") + len(b"<strls>")
+        block_end = file_data.index(b"</strls>", block_start)
+        block = file_data[block_start:block_end]
+        records = []
+        position = 0
+        while position < len(block):
+            assert block[position : position + 3] == b"GSO"
+            position += 3
+            value_id, offset = struct.unpack_from(">II", block, position)
+            position += 8
+            assert block[position] == 130
+            position += 1
+            length = struct.unpack_from(">I", block, position)[0]
+            position += 4
+            string = block[position : position + length]
+            assert len(string) == length
+            assert string.endswith(b"\x00")
+            records.append(((value_id, offset), string[:-1].decode("latin-1")))
+            position += length
+
+        keys = [key for key, _ in records]
+        assert len(keys) == len(set(keys))
+        assert {value for _, value in records} == set(values)
+
