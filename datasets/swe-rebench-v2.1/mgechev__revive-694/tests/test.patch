-// Test of missing package comment.
+// Package test contains behavioral coverage for package comments.
+package test // OK
 
-package foo // MATCH /should have a package comment, unless it's in another file for this package/
+import (
+	"testing"
+
+	"github.com/mgechev/revive/lint"
+	"github.com/mgechev/revive/rule"
+)
+
+// TestAcrossFiles checks package-wide comment detection.
+func TestAcrossFiles(t *testing.T) { //revive:disable-line:exported
+	t.Run("a comment in another file suppresses the finding", func(t *testing.T) {
+		sources := map[string]string{
+			"doc.go":   "// Package sample documents the sample package.\npackage sample\n",
+			"other.go": "package sample\n",
+		}
+		findings := lintPackageComments(t, sources)
+		if len(findings) != 0 {
+			t.Fatalf("got %d package-comment findings despite a package comment in another file", len(findings))
+		}
+	})
+
+	t.Run("an undocumented package is reported above the former confidence", func(t *testing.T) {
+		findings := lintPackageComments(t, map[string]string{
+			"plain.go": "package sample\n",
+		})
+		if len(findings) == 0 {
+			t.Fatal("got no finding for an undocumented package")
+		}
+		confidentFinding := false
+		for _, finding := range findings {
+			if finding.Confidence > 0.2 {
+				confidentFinding = true
+				break
+			}
+		}
+		if !confidentFinding {
+			t.Error("no package-comment finding has confidence greater than 0.2")
+		}
+	})
+}
+
+func lintPackageComments(t *testing.T, sources map[string]string) []lint.Failure {
+	t.Helper()
+	linter := lint.New(func(filename string) ([]byte, error) {
+		return []byte(sources[filename]), nil
+	}, 0)
+	filenames := make([]string, 0, len(sources))
+	for filename := range sources {
+		filenames = append(filenames, filename)
+	}
+	failures, err := linter.Lint([][]string{filenames}, []lint.Rule{&rule.PackageCommentsRule{}}, lint.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var result []lint.Failure
+	for failure := range failures {
+		result = append(result, failure)
+	}
+	return result
+}
