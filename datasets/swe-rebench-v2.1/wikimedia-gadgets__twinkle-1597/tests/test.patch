@@ -358,4 +358,43 @@ describe('Morebits.wikitext', () => {
 			assert.strictEqual(page[test.method](...test.params).getText(), test.expected, test.method + ' - ' + test.name);
 		});
 	});
+test('protection tag on CSS pages is a comment at the top of the Wikicode', () => {
+// Load the protection module against a minimal Twinkle namespace and
+// run its tagging callback on a page whose content model is CSS.
+var fs = require('fs');
+var path = require('path');
+var source = fs.readFileSync(path.join(__dirname, '../modules/twinkleprotect.js'), 'utf8');
+var Twinkle = {
+addInitCallback: function () {},
+changeTags: '',
+hatnoteRegex: 'short description|hatnote',
+getPref: function () { return false; }
+};
+new Function('Twinkle', 'Morebits', 'mw', 'jQuery', source)(Twinkle, Morebits, mw, global.jQuery);
+
+var tagPage = function (contentModel) {
+var saved = {};
+var page = {
+getCallbackParameters: function () { return { tag: 'pp', small: true, noinclude: false }; },
+getPageText: function () { return 'body text'; },
+getContentModel: function () { return contentModel; },
+setEditSummary: function () {},
+setChangeTags: function () {},
+setWatchlist: function () {},
+setCreateOption: function () {},
+suppressProtectWarning: function () {},
+setPageText: function (text) { saved.text = text; },
+save: function () {}
+};
+Twinkle.protect.callbacks.taggingPage(page);
+return saved.text;
+};
+
+['css', 'sanitized-css'].forEach(function (contentModel) {
+var text = tagPage(contentModel);
+var match = /^\/\*\s*\{\{pp(?:\|[^{}]*)?\}\}\s*\*\/\s*/.exec(text);
+assert.ok(match, contentModel + ': protection template should be a CSS comment at the very top, got: ' + text);
+assert.strictEqual(text.slice(match[0].length), 'body text', contentModel + ': original content should follow the tag');
+});
+});
 });
