+function expected_total_storage(model)
+    sbm = model.vertical
+    expected = (
+        sbm.glacierstore .* sbm.glacierfrac .+
+        sbm.snow .+
+        sbm.snowwater .+
+        sbm.canopystorage .+
+        sbm.ustoredepth .+
+        sbm.satwaterdepth .+
+        model.lateral.land.h_av .* (1 .- sbm.riverfrac) .* 1000
+    )
+    river = model.network.index_river
+    expected[river] .+= (
+        model.lateral.river.h_av[1:length(river)] .*
+        model.lateral.river.width[1:length(river)] .*
+        model.lateral.river.dl[1:length(river)] ./
+        (model.network.land.xl[river] .* model.network.land.yl[river]) .* 1000
+    )
+    return expected
+end
+
+function bmi_total_storage(model)
+    return BMI.get_value(
+        model,
+        "vertical.total_storage",
+        zeros(Float, model.vertical.n),
+    )
+end
