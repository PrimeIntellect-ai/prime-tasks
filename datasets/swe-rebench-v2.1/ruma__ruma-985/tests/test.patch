+}
+
+#[test]
+fn encrypted_thread_relation_roundtrip() {
+    let value = json!({
+        "algorithm": "m.megolm.v1.aes-sha2",
+        "ciphertext": "ciphertext",
+        "sender_key": "sender_key",
+        "device_id": "device_id",
+        "session_id": "session_id",
+        "m.relates_to": {
+            "rel_type": "io.element.thread",
+            "event_id": "$threadroot",
+            "m.in_reply_to": {
+                "event_id": "$latesteventid",
+            },
+        },
+    });
+
+    let content = from_json_value::<ruma_common::events::room::encrypted::RoomEncryptedEventContent>(
+        value,
+    )
+    .unwrap();
+    let serialized = to_json_value(content).unwrap();
+    let relation = &serialized["m.relates_to"];
+    assert_eq!(relation["rel_type"], "io.element.thread");
+    assert_eq!(relation["event_id"], "$threadroot");
+    assert_eq!(relation["m.in_reply_to"]["event_id"], "$latesteventid");
+}
+
+#[test]
+fn bundled_thread_summary_roundtrip() {
+    let value = json!({
+        "io.element.thread": {
+            "latest_event": {
+                "type": "m.room.message",
+                "event_id": "$latesteventid",
+                "sender": "@alice:example.org",
+                "origin_server_ts": 1,
+                "content": { "msgtype": "m.text", "body": "Latest reply" },
+            },
+            "count": 3,
+            "current_user_participated": true,
+        },
+    });
+    let content = from_json_value::<ruma_common::events::relation::Relations>(value).unwrap();
+    let serialized = to_json_value(content).unwrap();
+    let thread = &serialized["io.element.thread"];
+    assert_eq!(thread["count"], 3);
+    assert_eq!(thread["current_user_participated"], true);
+    assert_eq!(thread["latest_event"]["content"]["body"], "Latest reply");
+}
