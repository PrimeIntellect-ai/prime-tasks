+func (suite *StorageSuite) TestShouldValidateMultipleStorageIsConfigured() {
+	cases := []struct {
+		name       string
+		local      bool
+		mysql      bool
+		postgresql bool
+	}{
+		{name: "local and MySQL", local: true, mysql: true},
+		{name: "local and PostgreSQL", local: true, postgresql: true},
+		{name: "MySQL and PostgreSQL", mysql: true, postgresql: true},
+		{name: "all backends", local: true, mysql: true, postgresql: true},
+	}
+
+	for _, tc := range cases {
+		suite.Run(tc.name, func() {
+			config := schema.Storage{EncryptionKey: testEncryptionKey}
+
+			if tc.local {
+				config.Local = &schema.StorageLocal{Path: "storage.db"}
+			}
+
+			if tc.mysql {
+				config.MySQL = &schema.StorageMySQL{
+					StorageSQL: schema.StorageSQL{
+						Address:  &schema.AddressTCP{Address: MustParseAddress("tcp://mysql:3306")},
+						Username: "user",
+						Password: "password",
+						Database: "database",
+					},
+				}
+			}
+
+			if tc.postgresql {
+				config.PostgreSQL = &schema.StoragePostgreSQL{
+					StorageSQL: schema.StorageSQL{
+						Address:  &schema.AddressTCP{Address: MustParseAddress("tcp://postgres:5432")},
+						Username: "user",
+						Password: "password",
+						Database: "database",
+					},
+				}
+			}
+
+			validator := schema.NewStructValidator()
+			ValidateStorage(config, validator)
+
+			suite.Require().NotEmpty(validator.Errors())
+		})
+	}
+}
