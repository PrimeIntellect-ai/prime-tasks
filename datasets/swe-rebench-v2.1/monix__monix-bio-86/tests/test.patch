+    val bio2 = BIO.evalAsync { effect += 10 }.delayExecution(1.millisecond)
+    BIO.map2(bio1, bio2)((_, _) => ()).runToFuture
+    s.tick()
+    assertEquals(effect, 0)
+    s.tick(1.millisecond)
+    assertEquals(effect, 1)
+    s.tick(1.millisecond)
+    assertEquals(effect, 11)
+  }
