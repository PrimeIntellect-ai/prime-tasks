+  test("Task mapN methods preserve typed failures and stop before later inputs") { implicit s =>
+    val error = DummyException("typed failure")
+    var laterEvaluations = 0
+    var mappingCalls = 0
+    def sum2(a: Int, b: Int): Int = { mappingCalls += 1; a + b }
+    def sum3(a: Int, b: Int, c: Int): Int = { mappingCalls += 1; a + b + c }
+    def sum4(a: Int, b: Int, c: Int, d: Int): Int = { mappingCalls += 1; a + b + c + d }
+    def sum5(a: Int, b: Int, c: Int, d: Int, e: Int): Int = { mappingCalls += 1; a + b + c + d + e }
+    def sum6(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int): Int = { mappingCalls += 1; a + b + c + d + e + f }
+    val failed = Task.raiseError[Int](error)
+    val later = Task.evalAsync { laterEvaluations += 1; 3 }
+    val results: List[Task[Int]] = List(
+      Task.map2(Task.now(1), failed)(sum2),
+      Task.map3(Task.now(1), failed, later)(sum3),
+      Task.map4(Task.now(1), failed, later, later)(sum4),
+      Task.map5(Task.now(1), failed, later, later, later)(sum5),
+      Task.map6(Task.now(1), failed, later, later, later, later)(sum6))
+
+    results.foreach { result =>
+      val future = result.runToFuture
+      s.tick()
+      assertEquals(future.value, Some(Success(Left(error))))
+      assertEquals(laterEvaluations, 0)
+      assertEquals(mappingCalls, 0)
+    }
+  }
