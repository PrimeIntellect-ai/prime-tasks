+
+def test_model_info_with_cli_model(monkeypatch):
+    """A single model passed on the CLI is reported by the public model-info endpoint."""
+    import uvicorn
+    from click.testing import CliRunner
+
+    from litellm.proxy.auth.user_api_key_auth import user_api_key_auth
+    from litellm.proxy.proxy_cli import run_server
+    from litellm.proxy.proxy_server import app
+
+    model_name = "ollama/llama3.2:latest"
+    api_base = "http://localhost:11434"
+
+    # Start the CLI the way a user would, but do not block on the real server.
+    monkeypatch.setattr(uvicorn, "run", lambda *args, **kwargs: None)
+    monkeypatch.setenv("LITELLM_DONT_SHOW_FEEDBACK_BOX", "true")
+    monkeypatch.setenv("WORKER_CONFIG", "")
+    result = CliRunner().invoke(
+        run_server, ["--model", model_name, "--api_base", api_base]
+    )
+    assert result.exit_code == 0, result.output
+
+    async def authorized_user():
+        from litellm.proxy._types import UserAPIKeyAuth
+
+        return UserAPIKeyAuth(models=[])
+
+    monkeypatch.setitem(app.dependency_overrides, user_api_key_auth, authorized_user)
+
+    # Entering the client context runs the application startup, as the server would.
+    with TestClient(app) as client:
+        response = client.get("/model/info")
+
+    assert response.status_code == 200
+    payload = response.json()
+    assert "data" in payload
+    assert model_name in str(payload["data"])
