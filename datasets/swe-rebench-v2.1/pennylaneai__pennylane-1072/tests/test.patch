+    def test_inverse_operation_jacobian_backprop(self, tol):
+        """Test that circuits containing inverse operations can be
+        optimized without error."""
+        dev = qml.device('default.qubit.autograd', wires=1)
+
+        @qml.qnode(dev)
+        def circuit(param):
+            qml.RY(param, wires=0).inv()
+            return qml.expval(qml.PauliX(0))
+
+        x = 0.3
+        assert np.allclose(circuit(x), -np.sin(x), atol=tol, rtol=0)
+
+        opt = qml.GradientDescentOptimizer(0.1)
+        x_new = opt.step(circuit, x)
+        assert np.allclose(x_new, x + 0.1 * np.cos(x), atol=tol, rtol=0)
+
