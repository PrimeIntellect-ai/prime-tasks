@@ -1,6 +1,7 @@
 package tengo_test
 
 import (
+	"reflect"
 	"testing"
 
 	"github.com/d5/tengo/v2"
@@ -126,8 +127,24 @@ func resolveExpect(
 	expectedSymbol *tengo.Symbol,
 	expectedDepth int,
 ) {
-	actualSymbol, actualDepth, ok := symbolTable.Resolve(name)
+	actualSymbol, actualDepth, ok := resolveSymbolForTest(symbolTable, name, true)
 	require.True(t, ok)
 	require.Equal(t, expectedSymbol, actualSymbol)
 	require.Equal(t, expectedDepth, actualDepth)
 }
+
+// resolveSymbolForTest supports both the original recursive Resolve(name)
+// API and versions that expose an explicit recursion argument.
+func resolveSymbolForTest(table *tengo.SymbolTable, name string, recur bool) (*tengo.Symbol, int, bool) {
+	method := reflect.ValueOf(table).MethodByName("Resolve")
+	args := []reflect.Value{reflect.ValueOf(name)}
+	if method.Type().NumIn() == 2 {
+		args = append(args, reflect.ValueOf(recur))
+	}
+	results := method.Call(args)
+	var symbol *tengo.Symbol
+	if !results[0].IsNil() {
+		symbol = results[0].Interface().(*tengo.Symbol)
+	}
+	return symbol, int(results[1].Int()), results[2].Bool()
+}
