+// - MARK: Handle Protocol Associated types
+
+extension UT_SpyFactory {
+  func testGeneratedDeclarationIncludesAssociatedtypeParameter() throws {
+    let declaration = DeclSyntax(
+      """
+      protocol Foo {
+          associatedtype Key: Hashable
+      }
+      """
+    )
+    let protocolDeclaration = try XCTUnwrap(ProtocolDeclSyntax(declaration))
+
+    let result = try SpyFactory().classDeclaration(for: protocolDeclaration)
+
+    assertBuildResult(
+      result,
+      """
+      class FooSpy<Key: Hashable>: Foo {
+      }
+      """
+    )
+  }
+
+  func testDeclarationAssociatedtypeKeyValue() throws {
+    let declaration = DeclSyntax(
+      """
+      protocol Foo {
+          associatedtype Key: Hashable
+          associatedtype Value
+      }
+      """
+    )
+    let protocolDeclaration = try XCTUnwrap(ProtocolDeclSyntax(declaration))
+
+    let result = try SpyFactory().classDeclaration(for: protocolDeclaration)
+
+    assertBuildResult(
+      result,
+      """
+      class FooSpy<Key: Hashable, Value>: Foo {
+      }
+      """
+    )
+  }
+
+  func testDeclarationAssociatedtypeWithMethod() throws {
+    let declaration = DeclSyntax(
+      """
+      protocol Foo {
+          associatedtype Key: Hashable
+          associatedtype Value
+
+          func setValue(_ value: Value, forKey key: Key)
+      }
+      """
+    )
+    let protocolDeclaration = try XCTUnwrap(ProtocolDeclSyntax(declaration))
+
+    let result = try SpyFactory().classDeclaration(for: protocolDeclaration)
+
+    // The spy must be generic over the protocol's associated types so that it can
+    // conform to the protocol.
+    let genericParameters = try XCTUnwrap(result.genericParameterClause?.parameters)
+    XCTAssertEqual(genericParameters.count, 2)
+    XCTAssertEqual(genericParameters.first?.name.text, "Key")
+    XCTAssertEqual(genericParameters.first?.inheritedType?.trimmedDescription.split(separator: ".").last.map(String.init), "Hashable")
+    XCTAssertEqual(genericParameters.last?.name.text, "Value")
+
+    // The spy must declare conformance to the protocol.
+    let inheritedTypes = result.inheritanceClause?.inheritedTypes.map { $0.type.trimmedDescription }
+    XCTAssertEqual(inheritedTypes, ["Foo"])
+
+    // The spy must implement the protocol method using the associated types.
+    let functions = result.memberBlock.members.compactMap { $0.decl.as(FunctionDeclSyntax.self) }
+    let setValue = try XCTUnwrap(functions.first { $0.name.text == "setValue" })
+    let parameters = setValue.signature.parameterClause.parameters
+    XCTAssertEqual(parameters.count, 2)
+    XCTAssertEqual(parameters.first?.type.trimmedDescription, "Value")
+    XCTAssertEqual(parameters.last?.type.trimmedDescription, "Key")
+  }
+
+  func testMacroExpansionCompilesAndConformsForAssociatedTypes() {
+    func acceptsFixture<T: AssociatedTypeConformanceFixture>(_ spy: T)
+      where T.Key == Int, T.Value == String
+    {
+      spy.setValue("value", forKey: 1)
+    }
+
+    acceptsFixture(AssociatedTypeConformanceFixtureSpy<Int, String>())
+  }
+}
