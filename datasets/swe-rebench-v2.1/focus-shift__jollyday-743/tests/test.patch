+  private void assertBerchtoldsDayIsABankHoliday(final String... subdivisions) {
+    final HolidayManager manager = HolidayManager.getInstance(ManagerParameters.create(SWITZERLAND));
+    final Year year = Year.of(2024);
+    final Set<Holiday> holidays = subdivisions.length == 0
+      ? manager.getHolidays(year)
+      : manager.getHolidays(year, subdivisions);
+
+    assertThat(holidays).anyMatch(holiday ->
+      holiday.getDate().equals(LocalDate.of(2024, 1, 2)) && holiday.getType() == BANK_HOLIDAY);
+  }
