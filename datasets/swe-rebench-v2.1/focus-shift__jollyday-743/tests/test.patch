+  @Test
+  void berchtoldsDayIsABankHolidayInSwitzerlandAndTheSpecifiedCantons() {
+    assertBerchtoldsDayIsABankHoliday();
+    for (String canton : new String[] {"gl", "lu", "ne", "so", "zg", "zh", "ju", "ow"}) {
