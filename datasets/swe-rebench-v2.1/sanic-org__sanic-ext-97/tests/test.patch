 def test_default_templates():
@@ -85,3 +86,57 @@ def test_render_from_string():
     assert response.content_type == "text/html; charset=utf-8"
     assert "<li>three</li>" in response.text
     assert "<li>four</li>" in response.text
+
+
+def test_config_templating_dir():
+    app = Sanic("templating")
+    app.config.TEMPLATING_PATH_TO_TEMPLATES = (
+        Path(__file__).parent / "templates"
+    )
+
+    rendered = app.ext.templating.environment.get_template("foo.html").render(
+        seq=["configured path"]
+    )
+    assert "<li>configured path</li>" in rendered
+
+
+def test_config_templating_dir_reflected_in_ext_config():
+    app = Sanic("templating-ext-config")
+    app.config.TEMPLATING_PATH_TO_TEMPLATES = (
+        Path(__file__).parent / "templates"
+    )
+    app.extend()
+
+    assert app.ext.config.TEMPLATING_PATH_TO_TEMPLATES == (
+        Path(__file__).parent / "templates"
+    )
+    rendered = app.ext.templating.environment.get_template("foo.html").render(
+        seq=["configured path"]
+    )
+    assert "<li>configured path</li>" in rendered
+
+
+def test_ext_config_templating_dir(tmp_path):
+    template_dir = tmp_path / "extension-templates"
+    template_dir.mkdir()
+    expected = "loaded from extension config"
+    (template_dir / "extension-only.html").write_text(expected)
+
+    class SetTemplatePath(Extension):
+        name = "SetTemplatePath"
+
+        def startup(self, bootstrap):
+            bootstrap.app.ext.config.TEMPLATING_PATH_TO_TEMPLATES = (
+                template_dir
+            )
+
+    app = Sanic("templating-extension-config")
+    app.extend(
+        extensions=[TemplatingExtension, SetTemplatePath],
+        built_in_extensions=False,
+    )
+
+    rendered = app.ext.templating.environment.get_template(
+        "extension-only.html"
+    ).render()
+    assert rendered == expected
