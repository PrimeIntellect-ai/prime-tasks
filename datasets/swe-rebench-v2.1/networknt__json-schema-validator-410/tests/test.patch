diff --git a/src/test/java/com/networknt/schema/Issue406Test.java b/src/test/java/com/networknt/schema/Issue406Test.java
new file mode 100644
index 0000000..a7c4277
--- /dev/null
+++ b/src/test/java/com/networknt/schema/Issue406Test.java
@@ -0,0 +1,137 @@
+/*
+ * Copyright (c) 2020, 2021 Oracle and/or its affiliates.
+ */
+package com.networknt.schema;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.networknt.schema.uri.URIFactory;
+import com.networknt.schema.uri.URIFetcher;
+import com.networknt.schema.urn.URNFactory;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+
+public class Issue406Test {
+    protected static final String INVALID_$REF_SCHEMA = "{\"$ref\":\"urn:unresolved\"}";
+    protected static final String INVALID_NESTED_$REF_SCHEMA =
+            "{\"properties\":{\"child\":{\"$ref\":\"urn:unresolved\"}}}";
+
+    /**
+     * An unresolved reference may be rejected while obtaining the schema, or by
+     * explicitly requesting eager loading after obtaining it.
+     */
+    private void assertUnresolvedReferenceRejected(final String schemaJson) {
+        final JsonSchemaFactory factory = JsonSchemaFactory.getInstance(SpecVersion.VersionFlag.V7);
+        JsonSchema schema;
+        try {
+            schema = factory.getSchema(schemaJson);
+        } catch (JsonSchemaException e) {
+            return;
+        }
+        final JsonSchema obtainedSchema = schema;
+        final Method eagerResolution;
+        try {
+            eagerResolution = JsonSchema.class.getMethod("initializeValidators");
+        } catch (NoSuchMethodException e) {
+            Assert.fail("No public operation is available to eagerly resolve schema references");
+            return;
+        }
+        try {
+            eagerResolution.invoke(obtainedSchema);
+            Assert.fail("An unresolved URN reference must fail during eager resolution");
+        } catch (InvocationTargetException e) {
+            Assert.assertTrue(e.getCause() instanceof JsonSchemaException);
+        } catch (ReflectiveOperationException e) {
+            throw new AssertionError(e);
+        }
+    }
+
+    @Test
+    public void testUnresolvedReferenceRejectedEagerly() {
+        assertUnresolvedReferenceRejected(INVALID_$REF_SCHEMA);
+    }
+
+    @Test
+    public void testUnresolvedReferenceInNestedPropertyRejectedEagerly() {
+        assertUnresolvedReferenceRejected(INVALID_NESTED_$REF_SCHEMA);
+    }
+
+    @Test
+    public void testResolvableReferenceIsAvailableAfterEagerInitialization() throws Exception {
+        final boolean[] referencesAvailable = { true };
+        final URIFactory uriFactory = new URIFactory() {
+            @Override
+            public URI create(final String uri) {
+                return URI.create(uri);
+            }
+
+            @Override
+            public URI create(final URI baseURI, final String segment) {
+                return baseURI.resolve(segment);
+            }
+        };
+        final URIFetcher uriFetcher = new URIFetcher() {
+            @Override
+            public InputStream fetch(final URI uri) throws IOException {
+                if (!referencesAvailable[0]) {
+                    throw new IOException("Reference fetches are no longer available");
+                }
+                final String schema;
+                if ("/parent".equals(uri.getPath())) {
+                    schema = "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"properties\":{\"child\":{\"$ref\":\"child\"}}}";
+                } else if ("/child".equals(uri.getPath())) {
+                    schema = "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"properties\":{\"value\":{\"$ref\":\"grandchild\"}}}";
+                } else if ("/grandchild".equals(uri.getPath())) {
+                    schema = "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"integer\"}";
+                } else {
+                    throw new IOException("Unknown schema reference: " + uri);
+                }
+                return new ByteArrayInputStream(schema.getBytes(StandardCharsets.UTF_8));
+            }
+        };
+        final URNFactory urnFactory = new URNFactory() {
+            @Override
+            public URI create(final String urn) {
+                return "parent".equals(urn) ? URI.create("test://schemas/parent") : null;
+            }
+        };
+        final JsonMetaSchema draftV7 = JsonMetaSchema.getV7();
+        final JsonSchemaFactory factory = JsonSchemaFactory.builder()
+                .defaultMetaSchemaURI(draftV7.getUri())
+                .addMetaSchema(draftV7)
+                .uriFactory(uriFactory, "test")
+                .uriFetcher(uriFetcher, "test")
+                .addUrnFactory(urnFactory)
+                .build();
+        final JsonSchema schema = factory.getSchema("{\"$ref\":\"parent\"}");
+
+        final Method eagerResolution;
+        try {
+            eagerResolution = JsonSchema.class.getMethod("initializeValidators");
+        } catch (NoSuchMethodException e) {
+            Assert.fail("No public operation is available to eagerly resolve schema references");
+            return;
+        }
+        try {
+            eagerResolution.invoke(schema);
+        } catch (InvocationTargetException e) {
+            throw new AssertionError(e.getCause());
+        } catch (ReflectiveOperationException e) {
+            throw new AssertionError(e);
+        }
+        referencesAvailable[0] = false;
+
+        assertEquals(0, schema.validate(new ObjectMapper().readTree(
+                "{\"child\":{\"value\":37}}")).size());
+    }
+}
