+func TestDestinationBindMountExists(t *testing.T) {
+	tests := map[string]struct {
+		binds []string
+		dest  string
+		want  bool
+	}{
+		"empty binds slice": {
+			binds: []string{},
+			dest:  "/target",
+			want:  false,
+		},
+		"single bind with matching destination": {
+			binds: []string{"/source:/target"},
+			dest:  "/target",
+			want:  true,
+		},
+		"multiple binds with one matching destination": {
+			binds: []string{"/source1:/target1", "/source2:/target"},
+			dest:  "/target",
+			want:  true,
+		},
+		"no matching destination": {
+			binds: []string{"/source1:/target1", "/source2:/target2"},
+			dest:  "/target3",
+			want:  false,
+		},
+		"bind with additional options": {
+			binds: []string{"/source:/target:ro,z"},
+			dest:  "/target",
+			want:  true,
+		},
+		"malformed bind without separator": {
+			binds: []string{"malformedstring"},
+			dest:  "/target",
+			want:  false,
+		},
+		"bind with empty parts": {
+			binds: []string{":/target:", "/source:"},
+			dest:  "/target",
+			want:  true,
+		},
+	}
+
+	for name, tc := range tests {
+		t.Run(name, func(t *testing.T) {
+			got := utils.DestinationBindMountExists(tc.binds, tc.dest)
+			if !cmp.Equal(got, tc.want) {
+				t.Fatalf("wanted %v, got %v", tc.want, got)
+			}
+		})
+	}
+}
+
+// topologyBinds returns the bind mount entries whose destination is /tmp/topology.yml.
+func topologyBinds(binds []string) []string {
+	var res []string
+	for _, b := range binds {
+		parts := strings.Split(b, ":")
+		if len(parts) >= 2 && parts[1] == "/tmp/topology.yml" {
+			res = append(res, b)
+		}
+	}
+	return res
+}
+
+// TestSRLInitTopologyBind verifies that initializing an SR Linux node mounts the
+// containerlab-provided topology file only when the user did not already provide a
+// bind mount targeting /tmp/topology.yml.
+func TestSRLInitTopologyBind(t *testing.T) {
+	reg := nodes.NewNodeRegistry()
+	srl.Register(reg)
+
+	tests := map[string]struct {
+		userBinds []string
+		wantSrc   string
+	}{
+		"no user provided topology bind": {
+			userBinds: nil,
+		},
+		"user provided topology bind": {
+			userBinds: []string{"/custom/topology.yml:/tmp/topology.yml:ro"},
+			wantSrc:   "/custom/topology.yml",
+		},
+	}
+
+	for name, tc := range tests {
+		t.Run(name, func(t *testing.T) {
+			node, err := reg.NewNodeOfKind("srl")
+			if err != nil {
+				t.Fatalf("failed to create srl node: %v", err)
+			}
+
+			labDir := t.TempDir()
+			cfg := &types.NodeConfig{
+				ShortName:   "srl1",
+				LabDir:      labDir,
+				Sysctls:     map[string]string{},
+				Certificate: &types.CertificateConfig{},
+				Binds:       tc.userBinds,
+			}
+
+			if err := node.Init(cfg); err != nil {
+				t.Fatalf("failed to init srl node: %v", err)
+			}
+
+			got := topologyBinds(node.Config().Binds)
+			if len(got) != 1 {
+				t.Fatalf("expected exactly one bind targeting /tmp/topology.yml, got %d: %v", len(got), got)
+			}
+
+			if tc.wantSrc != "" && !strings.HasPrefix(got[0], tc.wantSrc+":") {
+				t.Fatalf("expected topology bind source %q, got %q", tc.wantSrc, got[0])
+			}
+		})
+	}
+}
