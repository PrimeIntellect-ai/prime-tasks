@@ -0,0 +1,56 @@
+import contextlib
+from pathlib import Path
+
+import click.exceptions
+import pytest
+
+from robocop.cli import check_files
+from robocop.linter.rules import RuleSeverity
+from tests import working_directory
+
+TEST_DIR = Path(__file__).parent / "test_data" / "example_test"
+NO_RULE_WARNING = "No rule selected"
+
+
+def run_check(capsys, **kwargs) -> str:
+    """Run the linter and return everything it printed."""
+    with contextlib.suppress(click.exceptions.Exit, SystemExit):
+        check_files(**kwargs)
+    out, err = capsys.readouterr()
+    return out + err
+
+
+@pytest.mark.parametrize(
+    "config",
+    [
+        {"select": ["X"]},  # select non-existing rule only
+        {"select": ["could-be-test-tags"], "threshold": RuleSeverity.ERROR},  # rule is info, so it will be filtered
+        {"select": ["could-be-test-tags"], "ignore": ["could-be-test-tags"]},  # select and ignore the same rule
+        {"select": ["replace-set-variable-with-var"], "target_version": 4},  # rule available from 7
+    ],
+)
+def test_select_empty_rule_set_from_cli(config, capsys):
+    with working_directory(TEST_DIR):
+        out = run_check(capsys, **config, ignore_file_config=True)
+    assert NO_RULE_WARNING in out
+
+
+def test_select_empty_rule_set_from_config_file(capsys):
+    with working_directory(TEST_DIR):
+        out = run_check(capsys, ignore_file_config=False)
+    assert NO_RULE_WARNING in out
+
+
+def test_empty_rule_set_in_one_config_does_not_stop_other_configs(tmp_path, capsys):
+    empty_selection = tmp_path / "empty_selection"
+    full_selection = tmp_path / "full_selection"
+    for directory, rule in ((empty_selection, "X"), (full_selection, "missing-doc-test-case")):
+        directory.mkdir()
+        (directory / "pyproject.toml").write_text(f'[tool.robocop.lint]\nselect = ["{rule}"]\n', encoding="utf-8")
+        (directory / "test.robot").write_text(
+            "*** Test Cases ***\nTest without documentation\n    Log    1\n", encoding="utf-8"
+        )
+    with working_directory(tmp_path):
+        out = run_check(capsys, sources=[empty_selection, full_selection])
+    assert NO_RULE_WARNING in out
+    assert "DOC02" in out
