+func TestCreateUserAddRequestIncludesOptionalAttributesInOrder(t *testing.T) {
+	l := &mocks.Client{}
+	l.On("Search", mock.Anything).Return(&ldap.SearchResult{Entries: []*ldap.Entry{userEntry}}, nil)
+	var addRequest *ldap.AddRequest
+	l.On("Add", mock.Anything).Return(func(request *ldap.AddRequest) error {
+		addRequest = request
+		return nil
+	})
+
+	logger := log.NewLogger(log.Level("debug"))
+	c := lconfig
+	c.UseServerUUID = false
+	c.UsePasswordModExOp = false
+	b, err := NewLDAPBackend(l, c, &logger)
+	assert.NoError(t, err)
+
+	user := libregraph.NewUser()
+	user.SetDisplayName("DisplayName")
+	user.SetMail("user@example")
+	user.SetOnPremisesSamAccountName("user")
+	user.SetSurname("surname")
+	user.SetGivenName("givenName")
+	password := "secret"
+	user.PasswordProfile = &libregraph.PasswordProfile{Password: &password}
+
+	_, err = b.CreateUser(context.Background(), *user)
+	assert.NoError(t, err)
+	if assert.NotNil(t, addRequest) {
+		attributeTypes := make([]string, len(addRequest.Attributes))
+		for i, attribute := range addRequest.Attributes {
+			attributeTypes[i] = attribute.Type
+		}
+		assert.Equal(t, []string{"displayname", "uid", "mail", "sn", "givenname", "objectClass", "cn", "owncloudUUID", "userPassword"}, attributeTypes)
+		attributeValues := make(map[string][]string, len(addRequest.Attributes))
+		for _, attribute := range addRequest.Attributes {
+			attributeValues[attribute.Type] = attribute.Vals
+		}
+		assert.NotEmpty(t, attributeValues["owncloudUUID"])
+		assert.Equal(t, []string{"secret"}, attributeValues["userPassword"])
+	}
+}
