index 0000000..c5fefd9
--- /dev/null
+++ b/tests/src/rules/no-trailing-spaces.ts
@@ -0,0 +1,38 @@
+import assert from "assert"
+import eslint from "eslint"
+import plugin from "../../../src/index"
+
+const linter = new eslint.ESLint({
+  plugins: {
+    svelte: plugin as never,
+  },
+  baseConfig: {
+    parser: require.resolve("svelte-eslint-parser"),
+    parserOptions: {
+      ecmaVersion: 2020,
+    },
+    plugins: ["svelte"],
+    rules: {
+      "svelte/no-trailing-spaces": ["error", { ignoreComments: true }],
+    },
+  },
+  useEslintrc: false,
+})
+
+describe("no-trailing-spaces", () => {
+  it("ignores trailing whitespace in HTML comments but checks other lines", async () => {
+    const code = [
+      "<!--",
+      "  HTML comment with trailing whitespace   ",
+      "-->",
+      "<script>",
+      "  const ordinary = 1;   ",
+      "</script>",
+      "",
+    ].join("\n")
+    const [result] = await linter.lintText(code, { filePath: "test.svelte" })
+
+    assert.strictEqual(result.messages.length, 1)
+    assert.strictEqual(result.messages[0].line, 5)
+  })
+})
