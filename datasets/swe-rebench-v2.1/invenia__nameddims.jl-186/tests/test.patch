+    @testset "$f" for f in (findmax, findmin)
+        @test f(nda) == f(a)
+        @test f(nda; dims=:x) == f(nda; dims=1) == f(a; dims=1)
+
+        # Both the value and the index are NamedDimsArrays that keep the input's
+        # dimension names and shape (the reduced dimension is retained with
+        # length 1).
+        @test f(nda; dims=:x)[1] isa NamedDimsArray
+        @test f(nda; dims=:x)[2] isa NamedDimsArray
+        @test f(nda; dims=1)[1] isa NamedDimsArray
+        @test f(nda; dims=1)[2] isa NamedDimsArray
+        @test dimnames(f(nda; dims=:x)[1]) == (:x, :y) == dimnames(f(nda; dims=:x)[2])
+        @test dimnames(f(nda; dims=1)[1]) == (:x, :y) == dimnames(f(nda; dims=1)[2])
+        @test dimnames(f(nda; dims=:x)[1]) == dimnames(f(nda; dims=1)[1])
+        @test size(f(nda; dims=:x)[1]) == size(f(nda; dims=:x)[2]) == (1, 2)
+        @test size(f(nda; dims=1)[1]) == size(f(nda; dims=1)[2]) == (1, 2)
+
+        # Additional keyword arguments are forwarded to the underlying Base function.
+        @test_throws MethodError f(nda; dims=1, bogus_kwarg=1)
     end
 
+    @testset "non-leading dimension extrema" begin
+        a = [1 9 3; 8 2 7]
+        nda = NamedDimsArray(a, (:row, :column))
+
+        for f in (argmax, argmin)
+            by_name = f(nda; dims=:column)
+            by_position = f(nda; dims=2)
+            expected = f(a; dims=2)
+
+            @test by_name isa NamedDimsArray
+            @test dimnames(by_name) == (:row, :column)
+            @test size(by_name) == (2, 1)
+            @test parent(by_name) == expected
+            @test by_position isa NamedDimsArray
+            @test dimnames(by_position) == (:row, :column)
+            @test size(by_position) == (2, 1)
+            @test parent(by_position) == expected
+            @test by_name == by_position
+        end
+
+        for f in (findmax, findmin)
+            by_name = f(nda; dims=:column)
+            by_position = f(nda; dims=2)
+            expected = f(a; dims=2)
+
+            @test by_name isa Tuple
+            @test by_position isa Tuple
+            if by_name isa Tuple && by_position isa Tuple
+                for result in (by_name, by_position)
+                    for item in result
+                        @test item isa NamedDimsArray
+                        @test dimnames(item) == (:row, :column)
+                        @test size(item) == (2, 1)
+                    end
+                end
+                @test parent(by_name[1]) == expected[1]
+                @test parent(by_name[2]) == expected[2]
+                @test parent(by_position[1]) == expected[1]
+                @test parent(by_position[2]) == expected[2]
+                @test by_name == by_position
+            end
+        end
+    end
     @testset "$f" for f in (cumsum, cumprod, sort, sortslices)
         @test f(nda; dims=:x) == f(nda; dims=1) == f(a; dims=1)
 
