+# -------------------------------------------------
+# File Input Element
+# -------------------------------------------------
+
+
+class FileInputElementTests(unittest.TestCase):
+    def test_element(self):
+        input = {
+            "type": "file_input",
+            "action_id": "file_input-action",
+            "filetypes": ["pdf", "txt"],
+            "max_files": 3,
+        }
+        self.assertDictEqual(input, FileInputElement(**input).to_dict())
+
+    def test_partial_configuration(self):
+        element = FileInputElement(action_id="file_input-action")
+        self.assertEqual("file_input-action", element.action_id)
+        payload = element.to_dict()
+        self.assertEqual("file_input", payload["type"])
+        self.assertEqual("file_input-action", payload["action_id"])
+
+    def test_action_id_length(self):
+        with self.assertRaises(Exception):
+            FileInputElement(action_id=STRING_301_CHARS).to_dict()
+
+
