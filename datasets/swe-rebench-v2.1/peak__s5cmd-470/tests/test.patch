+func TestCopySingleFileToS3NoSuchUploadRetriesAreLimited(t *testing.T) {
+	t.Parallel()
+
+	const retryCount = int32(2)
+	bucket := s3BucketFromTestName(t)
+	endpoint, attempts, srvCleanup := s3ServerWithNoSuchUploadFault(t, 10)
+	defer srvCleanup()
+
+	s3client, s5cmd, cleanup := setup(t, withEndpointURL(endpoint))
+	defer cleanup()
+	createBucket(t, s3client, bucket)
+
+	const filename = "example.txt"
+	content := strings.Repeat("a", 6*1024*1024)
+	workdir := fs.NewDir(t, bucket, fs.WithFile(filename, content))
+	defer workdir.Remove()
+
+	srcpath := filepath.ToSlash(workdir.Join(filename))
+	dstpath := fmt.Sprintf("s3://%v/", bucket)
+	result := icmd.RunCmd(s5cmd("cp", "--part-size", "5", "--no-such-upload-retry-count", "2", srcpath, dstpath))
+
+	result.Assert(t, icmd.Expected{ExitCode: 1})
+	gotAttempts := atomic.LoadInt32(attempts)
+	assert.Assert(t, gotAttempts > 0)
+	assert.Assert(t, gotAttempts <= retryCount+1)
+}
