+def test_events_rule_allows_both_event_pattern_and_schedule_expression():
+    template = """
+Resources:
+  UpdateRule:
+    Type: AWS::Events::Rule
+    Properties:
+      EventPattern:
+        source:
+          - aws.ssm
+      ScheduleExpression: rate(5 minutes)
+      Targets:
+        - Arn: arn:aws:lambda:us-east-1:123456789012:function:foo
+          Id: LAMBDA1
+"""
+    matches = api.lint(template)
+    assert [
+        match.rule.id for match in matches if match.rule.id == "E3014"
+    ] == [], matches
+
+
+def test_required_or_accepts_each_listed_property(validator):
+    validator = validator.evolve(schema={"requiredOr": ["foo", "bar"]})
+
+    assert list(validator.iter_errors({"bar": {}})) == []
+
+
+@pytest.mark.parametrize("instance", [None, [], "value", 0, True])
+def test_required_or_passes_for_non_object_instances(instance, validator):
+    validator = validator.evolve(schema={"requiredOr": ["foo", "bar"]})
+
+    assert list(validator.iter_errors(instance)) == []
