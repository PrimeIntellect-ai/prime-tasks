diff --git a/tests/test_dynamic_metadata.py b/tests/test_dynamic_metadata.py
index c3bc9ab..c1070eb 100644
--- a/tests/test_dynamic_metadata.py
+++ b/tests/test_dynamic_metadata.py
@@ -308,3 +308,74 @@ def test_multipart_regex(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Non
     )
 
     assert version == "1.2.3dev1"
+
+
+def test_regex_remove_all_matches(tmp_path: Path) -> None:
+    source = tmp_path / "version.txt"
+    source.write_text("version", encoding="utf-8")
+
+    version = regex.dynamic_metadata(
+        "version",
+        {
+            "input": str(source),
+            "regex": r"(?P<value>version)",
+            "result": "x|z|x",
+            "remove": "x|z|x",
+        },
+    )
+
+    assert version == "||"
+
+
+@pytest.mark.parametrize("remove", [None, ""])
+def test_regex_remove_empty_is_unchanged(
+    tmp_path: Path, remove: str | None
+) -> None:
+    source = tmp_path / "version.py"
+    source.write_text("__version__ = '{value}'", encoding="utf-8")
+    settings = {"input": str(source)}
+    if remove is not None:
+        settings["remove"] = remove
+
+    version = regex.dynamic_metadata("version", settings)
+
+    assert version == "{value}"
+
+
+@pytest.mark.parametrize("dev", [0, 1])
+def test_regex_remove(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, dev: int
+) -> None:
+    d = tmp_path / "test_multidev_regex"
+    d.mkdir()
+    monkeypatch.chdir(d)
+
+    with Path("version.hpp").open("w") as f:
+        f.write(
+            textwrap.dedent(
+                f"""\
+                #define VERSION_MAJOR 1
+                // Comment
+                #define VERSION_MINOR 2
+                #define VERSION_PATCH 3
+                #define VERSION_DEV {dev}
+                """
+            )
+        )
+
+    version = regex.dynamic_metadata(
+        "version",
+        {
+            "input": "version.hpp",
+            "regex": r"""(?sx)
+            \#define \s+ VERSION_MAJOR \s+ (?P<major>\d+) .*?
+            \#define \s+ VERSION_MINOR \s+ (?P<minor>\d+) .*?
+            \#define \s+ VERSION_PATCH \s+ (?P<patch>\d+) .*?
+            \#define \s+ VERSION_DEV \s+ (?P<dev>\d+)
+            """,
+            "result": "{major}.{minor}.{patch}dev{dev}",
+            "remove": r"dev0",
+        },
+    )
+
+    assert version == "1.2.3dev1" if dev else "1.2.3"
