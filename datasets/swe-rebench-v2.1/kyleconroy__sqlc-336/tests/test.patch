+func TestV2YAML(t *testing.T) {
+	const v2YAML = `version: "2"
+sql:
+  - engine: "postgresql"
+    schema: "schema.sql"
+    queries: "query.sql"
+    gen:
+      go:
+        package: "db"
+        out: "db"
+`
+	conf, err := ParseConfig(strings.NewReader(v2YAML))
+	if err != nil {
+		t.Fatalf("expected no error; got %s", err)
+	}
+	if conf.Version != "2" {
+		t.Errorf("expected version 2; got %q", conf.Version)
+	}
+	if len(conf.SQL) != 1 {
+		t.Fatalf("expected 1 package; got %d", len(conf.SQL))
+	}
+	if conf.SQL[0].Engine != EnginePostgreSQL {
+		t.Errorf("expected postgresql engine; got %q", conf.SQL[0].Engine)
+	}
+}
