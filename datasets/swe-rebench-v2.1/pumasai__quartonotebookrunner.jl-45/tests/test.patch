+include("../utilities/prelude.jl")
+
+function text_plain(cell)
+    output = cell["outputs"][1]
+    data = get(output, "data", nothing)
+    return data === nothing ? nothing : get(data, "text/plain", nothing)
+end
+
+function code_cell_results(json)
+    return [text_plain(cell) for cell in json["cells"] if get(cell, "cell_type", "") == "code"]
+end
+
+test_example(joinpath(@__DIR__, "../examples/env_and_exeflags.qmd")) do json
+    @test "\"BAR\"" in code_cell_results(json)
+end
+
+withenv("QUARTONOTEBOOKRUNNER_TEST_GLOBAL_ENV" => "global_value") do
+    test_example(joinpath(@__DIR__, "../examples/env_and_exeflags.qmd")) do json
+        @test "\"BAR\"" in code_cell_results(json)
+        @test "\"global_value\"" in code_cell_results(json)
+    end
+end
+
+
+withenv("FOO" => "server_value") do
+    test_example(joinpath(@__DIR__, "../examples/env_and_exeflags.qmd")) do json
+        @test "\"BAR\"" in code_cell_results(json)
+    end
+end
