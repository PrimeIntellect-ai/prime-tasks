+def test_github_generated_metadata_excludes_licenses_under_eggs(
+    tmp_path, license_pytest_5_3_1, monkeypatch
+):
+    package = tmp_path / "mypackage-1.0"
+    egg_info = (
+        package / ".eggs" / "setuptools_scm-7.0.5-py3.10.egg" / "EGG-INFO"
+    )
+    egg_info.mkdir(parents=True)
+    (package / "LICENSE").write_text(license_pytest_5_3_1)
+    (package / ".eggs" / "LICENSE").write_text(license_pytest_5_3_1)
+    (egg_info / "LICENSE").write_text(license_pytest_5_3_1)
+    (package / "PKG-INFO").write_text(
+        "Metadata-Version: 2.1\n"
+        "Name: mypackage\n"
+        "Version: 1.0\n"
+        "Summary: test package\n"
+        "Home-page: https://github.com/example/mypackage\n\n"
+    )
+    (package / "setup.py").write_text(
+        "from setuptools import setup\n"
+        "setup(name='mypackage', version='1.0', description='test package', "
+        "url='https://github.com/example/mypackage')\n"
+    )
+    archive_buffer = io.BytesIO()
+    with tarfile.open(fileobj=archive_buffer, mode="w:gz") as archive:
+        archive.add(package, arcname=package.name)
+    archive_data = archive_buffer.getvalue()
+
+    original_get = requests.get
+
+    def fake_get(url, **kwargs):
+        if url.endswith("/git/refs/tags"):
+            return type(
+                "Response",
+                (),
+                {
+                    "json": lambda self: [{"ref": "refs/tags/v1.0"}],
+                    "raise_for_status": lambda self: None,
+                },
+            )()
+        if url.endswith("/archive/v1.0.tar.gz"):
+            return type(
+                "Response",
+                (),
+                {
+                    "headers": {"Content-length": str(len(archive_data))},
+                    "raise_for_status": lambda self: None,
+                    "iter_content": lambda self, chunk_size: iter([archive_data]),
+                },
+            )()
+        return original_get(url, **kwargs)
+
+    monkeypatch.setattr(requests, "get", fake_get)
+    recipe, _ = create_python_recipe(
+        "mypackage",
+        version="1.0",
+        repo_github="https://github.com/example/mypackage",
+    )
+
+    generated_about = recipe.yaml["about"]
+    assert generated_about["license"] == "MIT"
+    license_files = generated_about["license_file"]
+    if isinstance(license_files, str):
+        license_files = [license_files]
+    assert any(os.path.basename(str(path)) == "LICENSE" for path in license_files)
+    assert all(".eggs" not in str(path) for path in license_files)
