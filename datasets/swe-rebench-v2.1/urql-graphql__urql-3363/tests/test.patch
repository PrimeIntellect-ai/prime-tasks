+
+  it('refetches an invalidated query for all subscribers', async () => {
+    vi.useFakeTimers();
+
+    const authorsQuery = gql`
+      query {
+        authors {
+          id
+          name
+        }
+      }
+    `;
+    const mutation = gql`
+      mutation {
+        deleteAuthor {
+          id
+          name
+        }
+      }
+    `;
+
+    const authorsQueryData = {
+      __typename: 'Query',
+      authors: [
+        {
+          __typename: 'Author',
+          id: '123',
+          name: 'Author',
+        },
+      ],
+    };
+    const refreshedAuthorsQueryData = {
+      ...authorsQueryData,
+      authors: [{ ...authorsQueryData.authors[0], name: 'Refreshed Author' }],
+    };
+    const deletedAuthor = {
+      __typename: 'Author',
+      id: '123',
+      name: 'Author',
+    };
+
+    let queryResponseCount = 0;
+    const network: Exchange = () => ops$ =>
+      pipe(
+        ops$,
+        filter(operation => operation.kind !== 'teardown'),
+        delay(1),
+        map(operation => ({
+          ...queryResponse,
+          operation,
+          data:
+            operation.kind === 'query'
+              ? queryResponseCount++ === 0
+                ? authorsQueryData
+                : refreshedAuthorsQueryData
+              : { __typename: 'Mutation', deleteAuthor: deletedAuthor },
+        }))
+      );
+
+    const client = createClient({
+      url: 'http://0.0.0.0',
+      exchanges: [
+        cacheExchange({
+          optimistic: {
+            deleteAuthor: () => deletedAuthor as any,
+          },
+          updates: {
+            Mutation: {
+              deleteAuthor: (_data, _, cache) => {
+                cache.invalidate({ __typename: 'Author', id: '123' });
+              },
+            },
+          },
+        }),
+        network,
+      ],
+    });
+    const queryOperation = client.createRequestOperation('query', {
+      key: 1,
+      query: authorsQuery,
+      variables: undefined,
+    });
+    const mutationOperation = client.createRequestOperation('mutation', {
+      key: 2,
+      query: mutation,
+      variables: undefined,
+    });
+    const firstSubscriber = vi.fn();
+    const secondSubscriber = vi.fn();
+
+    pipe(
+      client.executeRequestOperation(queryOperation),
+      subscribe(firstSubscriber)
+    );
+    pipe(
+      client.executeRequestOperation(queryOperation),
+      subscribe(secondSubscriber)
+    );
+    vi.runAllTimers();
+
+    pipe(
+      client.executeRequestOperation(mutationOperation),
+      subscribe(vi.fn())
+    );
+    await Promise.resolve();
+    vi.runAllTimers();
+    await Promise.resolve();
+    vi.runAllTimers();
+    vi.useRealTimers();
+
+    for (const subscriber of [firstSubscriber, secondSubscriber]) {
+      expect(
+        subscriber.mock.calls.some(
+          ([entry]) => entry.data?.authors?.[0]?.name === 'Refreshed Author'
+        )
+      ).toBe(true);
+    }
+  });
+
 });
 
