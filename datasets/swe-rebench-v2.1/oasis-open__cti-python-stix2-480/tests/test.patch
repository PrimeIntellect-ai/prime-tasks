+        query_params = _filter_kwargs_to_query_params(filter_kwargs)
+        full_filter = BasicFilter(query_params)
+        objs = full_filter.process_filter(
+            self.objects,
+            ("id", "type", "version"),
+            self.manifests,
+            100,
+        )[0]
+        page = objs[start:start + self.page_size]
+        if not page:
+            resp = Response()
+            resp.status_code = 404
+            resp.raise_for_status()
+        resp = Response()
+        resp.status_code = 200
+        resp.encoding = "utf-8"
+        resp._content = bytes(stix2.v20.Bundle(objects=page).serialize(ensure_ascii=False), resp.encoding)
+        end = start + len(page) - 1
+        if start + self.page_size >= len(objs):
+            resp.headers["Content-Range"] = f"items {start}-{end}/{len(objs)}"
+        else:
+            resp.headers["Content-Range"] = f"items {start}-{end}/*"
+        return resp
