+class MockTAXIICollectionEndpointPaged(MockTAXIICollectionEndpoint):
+    """Mock TAXII 2.0 collection that returns its results one page at a time."""
+
+    def __init__(self, url, collection_info, page_size):
+        super(MockTAXIICollectionEndpointPaged, self).__init__(url, collection_info)
+        self.page_size = page_size
+
+    def get_objects(self, accept=MEDIA_TYPE_STIX_V20, start=0, per_request=0, **filter_kwargs):
