+class MockTAXIICollectionEndpointPaged(MockTAXIICollectionEndpoint):
+    """Mock TAXII 2.1 collection that returns its results one page at a time."""
+
+    def __init__(self, url, collection_info, page_size):
+        super(MockTAXIICollectionEndpointPaged, self).__init__(url, collection_info)
+        self.page_size = page_size
+
+    def get_objects(self, **filter_kwargs):
+        self._verify_can_read()
+        next_token = filter_kwargs.pop("next", None)
+        filter_kwargs.pop("limit", None)
+        query_params = _filter_kwargs_to_query_params(filter_kwargs)
+        full_filter = BasicFilter(query_params)
+        objs = full_filter.process_filter(
+            self.objects,
+            ("id", "type", "version"),
+            self.manifests,
+            100,
+        )[0]
+        start = int(next_token) if next_token else 0
+        page = objs[start:start + self.page_size]
+        more = start + self.page_size < len(objs)
+        result = {"objects": page, "more": more}
+        if more:
+            result["next"] = str(start + self.page_size)
+        return result
+
