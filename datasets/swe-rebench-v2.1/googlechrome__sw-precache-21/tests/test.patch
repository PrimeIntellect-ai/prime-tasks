+describe('sw-precache directory index', function() {
+  var DIR = 'test/data/dirindex';
+  var INDEX_HTML = DIR + '/index.html';
+  var INDEX_PHP = DIR + '/index.php';
+  var SUBDIR = DIR + '/subdir';
+  var SUBDIR_INDEX = SUBDIR + '/index.html';
+
+  before(function() {
+    fs.mkdirSync(DIR);
+    fs.mkdirSync(SUBDIR);
+    fs.writeFileSync(INDEX_HTML, 'html index');
+    fs.writeFileSync(INDEX_PHP, 'php index');
+    fs.writeFileSync(SUBDIR_INDEX, 'nested html index');
+  });
+
+  after(function() {
+    fs.unlinkSync(SUBDIR_INDEX);
+    fs.rmdirSync(SUBDIR);
+    fs.unlinkSync(INDEX_HTML);
+    fs.unlinkSync(INDEX_PHP);
+    fs.rmdirSync(DIR);
+  });
+
+  function generate(config, callback) {
+    config = config || {};
+    config.logger = NOOP;
+    config.staticFileGlobs = [DIR + '/**'];
+    config.stripPrefix = DIR + '/';
+    swPrecache(config, callback);
+  }
+
+  // Run the generated worker with install-time cache storage keyed by request URL,
+  // so assertions concern the response content rather than cache naming.
+  function loadServiceWorker(swString) {
+    var listeners = {};
+    var storedCaches = {};
+    var sandbox = {
+      console: {log: NOOP, error: NOOP},
+      URL: URL,
+      Promise: Promise,
+      Response: function(body, init) {
+        this.body = body;
+        this.status = (init && init.status) || 200;
+        this.statusText = (init && init.statusText) || '';
+        this.headers = (init && init.headers) || {};
+      },
+      Request: function(url) {
+        this.url = url;
+        this.clone = function() {
+          return new sandbox.Request(this.url);
+        };
+      },
+      fetch: function(request) {
+        var url = typeof request === 'string' ? request : request.url;
+        if (new URL(url).search.indexOf('sw-precache=') === -1) {
+          return Promise.reject(new Error('offline'));
+        }
+        var pathname = new URL(url).pathname;
+        var body = pathname.indexOf('/subdir/index.html') !== -1 ? 'nested html index' :
+          (pathname.slice(-10) === 'index.html' ? 'html index' : 'php index');
+        return Promise.resolve({status: 200, body: body});
+      },
+      caches: {
+        open: function(name) {
+          storedCaches[name] = storedCaches[name] || [];
+          var entries = storedCaches[name];
+          return Promise.resolve({
+            keys: function() {
+              return Promise.resolve(entries.map(function(entry) {
+                return {url: entry.url};
+              }));
+            },
+            match: function(key) {
+              var url = typeof key === 'string' ? key : key.url;
+              var entry = entries.filter(function(candidate) {
+                return candidate.url === url;
+              })[0];
+              return Promise.resolve(entry && entry.response);
+            },
+            put: function(request, response) {
+              entries.push({url: request.url, response: response});
+              return Promise.resolve();
+            }
+          });
+        },
+        match: function(key) {
+          var url = typeof key === 'string' ? key : key.url;
+          var names = Object.keys(storedCaches);
+          for (var i = 0; i < names.length; i++) {
+            var entry = storedCaches[names[i]].filter(function(candidate) {
+              return candidate.url === url;
+            })[0];
+            if (entry) {
+              return Promise.resolve(entry.response);
+            }
+          }
+          return Promise.resolve(undefined);
+        },
+        keys: function() {
+          return Promise.resolve(Object.keys(storedCaches));
+        },
+        delete: function(name) {
+          delete storedCaches[name];
+          return Promise.resolve(true);
+        }
+      },
+      self: {
+        location: 'http://example.com/',
+        registration: {scope: 'http://example.com/'},
+        addEventListener: function(type, listener) {
+          listeners[type] = listener;
+        },
+        clients: {
+          claim: function() {
+            return Promise.resolve();
+          }
+        },
+        skipWaiting: NOOP
+      }
+    };
+    vm.createContext(sandbox);
+    vm.runInContext(swString, sandbox);
+
+    var installation;
+    listeners.install({waitUntil: function(promise) {
+      installation = promise;
+    }});
+
+    return {
+      ready: installation,
+      fetch: function(url) {
+        var responded = null;
+        listeners.fetch({
+          request: {method: 'GET', url: url},
+          respondWith: function(promise) {
+            responded = promise;
+          }
+        });
+        return responded;
+      }
+    };
+  }
+
+  it('serves the default precached index for a bare directory URL', function(done) {
+    generate({}, function(error, swString) {
+      assert.ifError(error);
+      var sw = loadServiceWorker(swString);
+      sw.ready.then(function() {
+        var responsePromise = sw.fetch('http://example.com/');
+        assert(responsePromise, 'expected a response for a bare directory URL');
+        return responsePromise;
+      }).then(function(response) {
+        assert.strictEqual(response.body, 'html index');
+        done();
+      }).catch(done);
+    });
+  });
+
+  it('serves the precached index for a nested bare directory URL', function(done) {
+    generate({}, function(error, swString) {
+      assert.ifError(error);
+      var sw = loadServiceWorker(swString);
+      sw.ready.then(function() {
+        var responsePromise = sw.fetch('http://example.com/subdir/');
+        assert(responsePromise, 'expected a response for a bare directory URL');
+        return responsePromise;
+      }).then(function(response) {
+        assert.strictEqual(response.body, 'nested html index');
+        done();
+      }).catch(done);
+    });
+  });
+
+  it('serves the configured precached index for a bare directory URL', function(done) {
+    generate({directoryIndex: 'index.php'}, function(error, swString) {
+      assert.ifError(error);
+      var sw = loadServiceWorker(swString);
+      sw.ready.then(function() {
+        var responsePromise = sw.fetch('http://example.com/');
+        assert(responsePromise, 'expected a response for a bare directory URL');
+        return responsePromise;
+      }).then(function(response) {
+        assert.strictEqual(response.body, 'php index');
+        done();
+      }).catch(done);
+    });
+  });
+
+  it('serves the configured precached index when the URL has no explicit pathname', function(done) {
+    generate({directoryIndex: 'index.php'}, function(error, swString) {
+      assert.ifError(error);
+      var sw = loadServiceWorker(swString);
+      sw.ready.then(function() {
+        var responsePromise = sw.fetch('http://example.com');
+        assert(responsePromise, 'expected a response for a bare directory URL');
+        return responsePromise;
+      }).then(function(response) {
+        assert.strictEqual(response.body, 'php index');
+        done();
+      }).catch(done);
+    });
+  });
+});
