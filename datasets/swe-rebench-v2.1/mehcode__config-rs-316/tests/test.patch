+#[test]
+fn test_with_var_restores_previous_environment() {
+    let key = "TEMP_ENV_RESTORE_SINGLE";
+
+    std::env::remove_var(key);
+    temp_env::with_var(key, Some("temporary"), || {
+        assert_eq!(std::env::var(key).ok(), Some(String::from("temporary")));
+    });
+    assert_eq!(std::env::var(key).ok(), None);
+
+    std::env::set_var(key, "original");
+    temp_env::with_var(key, Some("temporary"), || {
+        assert_eq!(std::env::var(key).ok(), Some(String::from("temporary")));
+    });
+    assert_eq!(std::env::var(key).ok(), Some(String::from("original")));
+
+    std::env::remove_var(key);
+}
+
+#[test]
+fn test_with_vars_restores_previous_environment() {
+    let key_a = "TEMP_ENV_RESTORE_MULTI_A";
+    let key_b = "TEMP_ENV_RESTORE_MULTI_B";
+
+    std::env::remove_var(key_a);
+    std::env::remove_var(key_b);
+
+    temp_env::with_vars(
+        vec![(key_a, Some("a")), (key_b, Some("b"))],
+        || {
+            assert_eq!(std::env::var(key_a).ok(), Some(String::from("a")));
+            assert_eq!(std::env::var(key_b).ok(), Some(String::from("b")));
+        },
+    );
+
+    assert_eq!(std::env::var(key_a).ok(), None);
+    assert_eq!(std::env::var(key_b).ok(), None);
 }
