+def test_reset_semantic_tags_then_set_time_index():
+    df = pd.DataFrame({
+        'id': [1, 2, 3],
+        'first_name': ['a', 'b', 'c'],
+        'last_name': ['d', 'e', 'f'],
+        'signup_date': pd.to_datetime(['2020-01-01', '2020-01-02', '2020-01-03']),
+    })
+    df.ww.init(
+        name='test',
+        index='id',
+        time_index='signup_date',
+        logical_types={'first_name': 'NaturalLanguage', 'last_name': 'NaturalLanguage'},
+    )
+
+    df.ww.reset_semantic_tags()
+    df.ww.set_time_index('signup_date')
+
+    assert df.ww.time_index == 'signup_date'
+    assert 'time_index' in df.ww.semantic_tags['signup_date']
+    assert 'time_index' not in df.ww.semantic_tags['first_name']
+    assert 'time_index' not in df.ww.semantic_tags['last_name']
