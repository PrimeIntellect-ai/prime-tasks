diff --git a/json/json_test.go b/json/json_test.go
index 2517617..fc7ce45 100644
--- a/json/json_test.go
+++ b/json/json_test.go
@@ -1249,3 +1249,40 @@ func TestGithubIssue13(t *testing.T) {
 		t.Error("unexpected error decoding string value into pointer fmt.Stringer:", err)
 	}
 }
+
+type sliceA []byte
+
+func (sliceA) MarshalJSON() ([]byte, error) {
+	return []byte(`"A"`), nil
+}
+
+type sliceB []byte
+
+func (sliceB) MarshalText() ([]byte, error) {
+	return []byte("B"), nil
+}
+
+func TestGithubIssue16(t *testing.T) {
+	// https://github.com/segmentio/encoding/issues/16
+	//
+	// A byte-slice type that implements json.Marshaler or
+	// encoding.TextMarshaler must have those methods honored in priority to
+	// the default byte-slice encoding, including for the zero value.
+	tests := []struct {
+		value  interface{}
+		output string
+	}{
+		{value: sliceA(nil), output: `"A"`},
+		{value: sliceB(nil), output: `"B"`},
+		{value: sliceA([]byte{1, 2, 3}), output: `"A"`},
+		{value: sliceB([]byte{1, 2, 3}), output: `"B"`},
+	}
+
+	for _, test := range tests {
+		t.Run(fmt.Sprintf("%T", test.value), func(t *testing.T) {
+			if b, _ := Marshal(test.value); string(b) != test.output {
+				t.Errorf(`%s != %s`, string(b), test.output)
+			}
+		})
+	}
+}
