+func TestNilBodyContentLengthIssue671(t *testing.T) {
+	var gotContentLength string
+	client := dc()
+	// Observe the request at the transport boundary, i.e. after every resty
+	// middleware and the pre-request hook have run. This verifies the outgoing
+	// request carries "Content-Length: 0" without depending on the exact stage
+	// at which the header is populated.
+	client.SetTransport(nilBodyContentLengthTransport(func(r *http.Request) (*http.Response, error) {
+		gotContentLength = r.Header.Get(hdrContentLengthKey)
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Status:     "200 OK",
+			Header:     make(http.Header),
+			Body:       io.NopCloser(strings.NewReader("")),
+			Request:    r,
+		}, nil
+	}))
+
+	_, err := client.R().SetContentLength(true).SetBody(nil).Get("http://localhost")
+	assertError(t, err)
+	assertEqual(t, "0", gotContentLength)
+}
+
+// nilBodyContentLengthTransport adapts a function into an http.RoundTripper for tests.
+type nilBodyContentLengthTransport func(*http.Request) (*http.Response, error)
+
+func (f nilBodyContentLengthTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
