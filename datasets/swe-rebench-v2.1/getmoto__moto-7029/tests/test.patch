--- /dev/null
+++ b/tests/test_ecs/test_ecs_task_tags.py
@@ -0,0 +1,99 @@
+import boto3
+
+from moto import mock_ec2, mock_ecs
+from .test_ecs_boto3 import setup_ecs_cluster_with_ec2_instance
+
+
+@mock_ec2
+@mock_ecs
+def test_describe_tasks_include_tags():
+    client = boto3.client("ecs", region_name="us-east-1")
+    test_cluster_name = "test_ecs_cluster"
+    setup_ecs_cluster_with_ec2_instance(client, test_cluster_name)
+
+    task_tags = [{"key": "Name", "value": "test_ecs_task"}]
+    run_task_response = client.run_task(
+        cluster="test_ecs_cluster",
+        taskDefinition="test_ecs_task",
+        count=2,
+        tags=task_tags,
+    )
+    tasks_arns = [task["taskArn"] for task in run_task_response["tasks"]]
+
+    # Tags supplied to run_task are visible on the returned tasks
+    for task in run_task_response["tasks"]:
+        assert task["tags"] == task_tags
+
+    response = client.describe_tasks(
+        cluster="test_ecs_cluster", tasks=tasks_arns, include=["TAGS"]
+    )
+
+    assert len(response["tasks"]) == 2
+    assert set(
+        [response["tasks"][0]["taskArn"], response["tasks"][1]["taskArn"]]
+    ) == set(tasks_arns)
+    assert response["tasks"][0]["tags"] == task_tags
+
+    # Test we can pass task ids instead of ARNs
+    response = client.describe_tasks(
+        cluster="test_ecs_cluster", tasks=[tasks_arns[0].split("/")[-1]]
+    )
+    assert len(response["tasks"]) == 1
+    # Without include=["TAGS"], the tags key is omitted from the response
+    assert "tags" not in response["tasks"][0]
+
+    response = client.describe_tasks(
+        cluster="test_ecs_cluster", tasks=[tasks_arns[0]], include=["ATTACHMENTS"]
+    )
+    assert "tags" not in response["tasks"][0]
+
+    tags = client.list_tags_for_resource(resourceArn=tasks_arns[0])["tags"]
+    assert tags == task_tags
+
+
+@mock_ec2
+@mock_ecs
+def test_add_tags_to_task():
+    client = boto3.client("ecs", region_name="us-east-1")
+    test_cluster_name = "test_ecs_cluster"
+    setup_ecs_cluster_with_ec2_instance(client, test_cluster_name)
+
+    task_tags = [{"key": "k1", "value": "v1"}]
+    task_arn = client.run_task(
+        cluster="test_ecs_cluster",
+        taskDefinition="test_ecs_task",
+        count=1,
+        tags=task_tags,
+    )["tasks"][0]["taskArn"]
+
+    # Tags supplied when running the task are persisted and can be listed
+    tags = client.list_tags_for_resource(resourceArn=task_arn)["tags"]
+    assert tags == task_tags
+
+    tags = client.describe_tasks(
+        cluster="test_ecs_cluster", tasks=[task_arn], include=["TAGS"]
+    )["tasks"][0]["tags"]
+    assert tags == task_tags
+
+
+@mock_ec2
+@mock_ecs
+def test_start_task_tags_can_be_listed():
+    client = boto3.client("ecs", region_name="us-east-1")
+    setup_ecs_cluster_with_ec2_instance(client, "test_ecs_cluster")
+    container_instance_arn = client.list_container_instances(
+        cluster="test_ecs_cluster"
+    )["containerInstanceArns"][0]
+    task_tags = [{"key": "Name", "value": "started_task"}]
+
+    task = client.start_task(
+        cluster="test_ecs_cluster",
+        taskDefinition="test_ecs_task",
+        containerInstances=[container_instance_arn],
+        tags=task_tags,
+        startedBy="moto",
+    )["tasks"][0]
+
+    assert task["tags"] == task_tags
+    task_arn = task["taskArn"]
+    assert client.list_tags_for_resource(resourceArn=task_arn)["tags"] == task_tags
