+
+    @Test
+    public void testTopHitsSubaggregationCanBeReadFromEachTermsBucket() {
+        SearchResult searchResult = new SearchResult(new Gson());
+        searchResult.setSucceeded(true);
+        searchResult.setJsonString(json);
+        searchResult.setJsonObject(new JsonParser().parse(json).getAsJsonObject());
+        searchResult.setPathToResult("hits/hits/_source");
+
+        TermsAggregation termsAgg = searchResult.getAggregations().getTermsAggregation("test");
+        List<Entry> buckets = termsAgg.getBuckets();
+
+        assertEquals(2, buckets.size());
+        assertBucketSources(buckets.get(0), "field1Content", "field2Content");
+        assertBucketSources(buckets.get(1), "field21Content", "field22Content");
+    }
+
+    private void assertBucketSources(Entry bucket, String firstExpected, String secondExpected) {
+        TopHitsAggregation topHits = bucket.getTopHitsAggregation("top_hits_test");
+        assertNotNull(topHits);
+
+        List<String> sources = topHits.getSourceAsStringList();
+        assertEquals(2, sources.size());
+        assertEquals(firstExpected, new JsonParser().parse(sources.get(0)).getAsJsonObject()
+                .get("field1").getAsString());
+        assertEquals(secondExpected, new JsonParser().parse(sources.get(1)).getAsJsonObject()
+                .get("field1").getAsString());
+    }
