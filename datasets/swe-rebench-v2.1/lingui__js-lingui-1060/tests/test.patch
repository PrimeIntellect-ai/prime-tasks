+  it("keeps origins in every locale when line numbers are disabled", function () {
+    const locales = ["en", "de"]
+
+    ;[locales, [...locales].reverse()].forEach((localeOrder) => {
+      const sharedOrigins = [["src/App.js", 10], ["src/Button.js", 20]]
+      const catalogWriter = new Catalog(
+        { path: "locale/{locale}/messages", include: [] },
+        {
+          format: "po",
+          locales: localeOrder,
+          formatOptions: { origins: true, lineNumbers: false },
+        }
+      )
+      const catalogs = Object.fromEntries(
+        localeOrder.map((locale) => [
+          locale,
+          {
+            greeting: {
+              translation: "Hello",
+              origin: sharedOrigins,
+            },
+          },
+        ])
+      )
+
+      catalogWriter.writeAll(catalogs)
+
+      locales.forEach((locale) => {
+        const output = poFormat.parse(
+          fs.readFileSync(path.join("locale", locale, "messages.po"), "utf8")
+        )
+        const origins = output.greeting.origin
+        expect(origins.map(([source]) => source).sort()).toEqual([
+          "src/App.js",
+          "src/Button.js",
+        ])
+        expect(origins.every((origin) => origin.length === 1)).toBe(true)
+      })
+    })
   })
