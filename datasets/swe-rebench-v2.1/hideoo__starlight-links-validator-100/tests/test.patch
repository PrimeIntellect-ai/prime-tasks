diff --git a/packages/starlight-links-validator/tests/same-site.test.ts b/packages/starlight-links-validator/tests/same-site.test.ts
new file mode 100644
index 0000000..a50872b
--- /dev/null
+++ b/packages/starlight-links-validator/tests/same-site.test.ts
@@ -0,0 +1,69 @@
+import { expect, expectTypeOf, test } from 'vitest'
+
+import type { StarlightLinksValidatorOptions } from '../index'
+import type { Link, RemarkStarlightLinksValidatorConfig } from '../libs/remark'
+import { ValidationErrorType } from '../libs/validation'
+
+import config from './fixtures/same-site-error/astro.config'
+import { buildFixture, expectValidationErrorCount } from './utils'
+
+test('exposes the public options and configuration types', () => {
+  expect(ValidationErrorType.SameSite).toBe('{{site}} can be omitted')
+  expectTypeOf<StarlightLinksValidatorOptions>().toHaveProperty('sameSitePolicy')
+  expectTypeOf<StarlightLinksValidatorOptions['sameSitePolicy']>().toMatchTypeOf<
+    'error' | 'ignore' | 'validate' | undefined
+  >()
+
+  expectTypeOf<RemarkStarlightLinksValidatorConfig>().toHaveProperty('base')
+  expectTypeOf<RemarkStarlightLinksValidatorConfig>().toHaveProperty('options')
+  expectTypeOf<RemarkStarlightLinksValidatorConfig>().toHaveProperty('site')
+  expectTypeOf<RemarkStarlightLinksValidatorConfig>().toHaveProperty('srcDir')
+  expectTypeOf<RemarkStarlightLinksValidatorConfig['base']>().toEqualTypeOf<string>()
+  expectTypeOf<RemarkStarlightLinksValidatorConfig['srcDir']>().toEqualTypeOf<URL>()
+
+  expectTypeOf<Link>().toHaveProperty('raw')
+  expectTypeOf<Link>().toHaveProperty('transformed')
+  expectTypeOf<Link>().toHaveProperty('error')
+  expectTypeOf<Link['raw']>().toEqualTypeOf<string>()
+})
+
+test('does not build with same site links with the option set to `error`', async () => {
+  const { output, status } = await buildFixture('same-site-error')
+
+  expect(status).toBe('error')
+
+  expectValidationErrorCount(output, 6, 1)
+
+  expectSameSiteValidationErrors(output, 'test/', [
+    ['https://example.com', ValidationErrorType.SameSite, config.site],
+    ['https://example.com/', ValidationErrorType.SameSite, config.site],
+    ['https://example.com/guides/example/', ValidationErrorType.SameSite, config.site],
+    ['https://example.com/unknown/', ValidationErrorType.SameSite, config.site],
+    ['https://example.com/guides/example/#content', ValidationErrorType.SameSite, config.site],
+    ['https://example.com/guides/example/#unknown', ValidationErrorType.SameSite, config.site],
+  ])
+})
+
+test('does not build with invalid same site links with the option set to `validate`', async () => {
+  const { output, status } = await buildFixture('same-site-validate')
+
+  expect(status).toBe('error')
+
+  expectValidationErrorCount(output, 2, 1)
+
+  expectSameSiteValidationErrors(output, 'test/', [
+    ['https://example.com/unknown/', ValidationErrorType.InvalidLink],
+    ['https://example.com/guides/example/#unknown', ValidationErrorType.InvalidHash],
+  ])
+})
+
+function expectSameSiteValidationErrors(
+  output: string,
+  path: string,
+  validationErrors: [link: string, type: string, site?: string | undefined][],
+) {
+  expect(output).toContain(`▶ ${path}`)
+  for (const [link, type, site] of validationErrors) {
+    expect(output).toContain(`${link} - ${site ? type.replace('{{site}}', site) : type}`)
+  }
+}
