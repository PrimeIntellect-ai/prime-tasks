+    async def test_same_function_registered_with_multiple_templates(self):
+        """Test that the same function can be registered with different URI templates."""
+        mcp = FastMCP()
+
+        def do_cool_thing(
+            new_name: str, name: str | None = None, id: str | None = None
+        ) -> str:
+            return f"{new_name}:{name}:{id}"
+
+        mcp.add_resource_fn(uri="name://{name}/{new_name}", fn=do_cool_thing)
+        mcp.add_resource_fn(uri="id://{id}/{new_name}", fn=do_cool_thing)
+
+        # Verify both templates are registered
+        templates = mcp.list_resource_templates()
+        assert len(templates) == 2
+        template_uris = {t.uri_template for t in templates}
+        assert "name://{name}/{new_name}" in template_uris
+        assert "id://{id}/{new_name}" in template_uris
+
+        # Both templates resolve to the same function, filling in the optional
+        # parameter that is absent from the URI with its default.
+        async with Client(mcp) as client:
+            name_result = await client.read_resource(AnyUrl("name://alice/bob"))
+            assert isinstance(name_result[0], TextResourceContents)
+            assert name_result[0].text == "bob:alice:None"
+
+            id_result = await client.read_resource(AnyUrl("id://42/bob"))
+            assert isinstance(id_result[0], TextResourceContents)
+            assert id_result[0].text == "bob:None:42"
+
 
