+describe('Local', () => {
+  const makeBotGame = () => ({
+    setup: () => ({ moves: 0 }),
+    moves: {
+      A: G => ({ moves: G.moves + 1 }),
+    },
+    turn: { moveLimit: 1 },
+    ai: {
+      enumerate: () => [{ move: 'A' }],
+    },
+  });
+
+  // Let scheduled bot work (timers and promise continuations) complete,
+  // without depending on the exact number of event-loop turns it needs.
+  const settle = async () => {
+    for (let i = 0; i < 20; i++) {
+      jest.runOnlyPendingTimers();
+      await Promise.resolve();
+    }
+  };
+
+  test('keeps multiplayer boards in sync through a player and bot turn', async () => {
+    const game = makeBotGame();
+    const multiplayer = Local({ bots: { '1': RandomBot } });
+    const client0 = Client({ game, playerID: '0', multiplayer });
+    const client1 = Client({ game, playerID: '1', multiplayer });
+    client0.start();
+    client1.start();
+
+    client0.moves.A();
+    await settle();
+
+    for (const client of [client0, client1]) {
+      expect(client.getState().G.moves).toBe(2);
+      expect(client.getState().ctx.currentPlayer).toBe('0');
+    }
+  });
+
+  test('runs a bot turn and advances without a second board', async () => {
+    const client = Client({
+      game: makeBotGame(),
+      playerID: '0',
+      multiplayer: Local({ bots: { '1': RandomBot } }),
+    });
+    client.start();
+
+    client.moves.A();
+    await settle();
+
+    expect(client.getState().G.moves).toBe(2);
+    expect(client.getState().ctx.currentPlayer).toBe('0');
+  });
+});
+
