+import numpy as np
+import pytest
+from numpy.testing import assert_array_equal
+
+import cubed
+import cubed.array_api as xp
+
+
+def test_map_overlap_1d():
+    x = np.arange(6)
+    a = xp.asarray(x, chunks=(3,))
+
+    b = cubed.map_overlap(
+        lambda x: x,
+        a,
+        dtype=a.dtype,
+        chunks=((5, 5),),
+        depth=1,
+        boundary=0,
+        trim=False,
+    )
+
+    assert_array_equal(b.compute(), np.array([0, 0, 1, 2, 3, 2, 3, 4, 5, 0]))
+
+
+def test_map_overlap_2d():
+    x = np.arange(36).reshape((6, 6))
+    a = xp.asarray(x, chunks=(3, 3))
+
+    b = cubed.map_overlap(
+        lambda x: x,
+        a,
+        dtype=a.dtype,
+        chunks=((7, 7), (5, 5)),
+        depth={0: 2, 1: 1},
+        boundary={0: 100, 1: 200},
+        trim=False,
+    )
+
+    expected = np.array(
+        [
+            [200, 100, 100, 100, 100, 100, 100, 100, 100, 200],
+            [200, 100, 100, 100, 100, 100, 100, 100, 100, 200],
+            [200, 0, 1, 2, 3, 2, 3, 4, 5, 200],
+            [200, 6, 7, 8, 9, 8, 9, 10, 11, 200],
+            [200, 12, 13, 14, 15, 14, 15, 16, 17, 200],
+            [200, 18, 19, 20, 21, 20, 21, 22, 23, 200],
+            [200, 24, 25, 26, 27, 26, 27, 28, 29, 200],
+            [200, 6, 7, 8, 9, 8, 9, 10, 11, 200],
+            [200, 12, 13, 14, 15, 14, 15, 16, 17, 200],
+            [200, 18, 19, 20, 21, 20, 21, 22, 23, 200],
+            [200, 24, 25, 26, 27, 26, 27, 28, 29, 200],
+            [200, 30, 31, 32, 33, 32, 33, 34, 35, 200],
+            [200, 100, 100, 100, 100, 100, 100, 100, 100, 200],
+            [200, 100, 100, 100, 100, 100, 100, 100, 100, 200],
+        ]
+    )
+
+    result = b.compute()
+    assert result.shape == expected.shape
+    # At corners, both axes provide boundary values and the contract does not
+    # prescribe which axis determines those cells.
+    assert_array_equal(result[2:-2, 1:-1], expected[2:-2, 1:-1])
+    assert_array_equal(result[:2, 1:-1], expected[:2, 1:-1])
+    assert_array_equal(result[-2:, 1:-1], expected[-2:, 1:-1])
+    assert_array_equal(result[2:-2, :1], expected[2:-2, :1])
+    assert_array_equal(result[2:-2, -1:], expected[2:-2, -1:])
+
+
+def test_map_overlap_trim():
+    x = np.array([1, 1, 2, 3, 5, 8, 13, 21])
+    a = xp.asarray(x, chunks=5)
+
+    def derivative(x):
+        out = x - np.roll(x, 1)
+        return out[1:-1]  # manual trim
+
+    b = cubed.map_overlap(
+        derivative,
+        a,
+        dtype=a.dtype,
+        chunks=a.chunks,
+        depth=1,
+        boundary=0,
+        trim=False,
+    )
+
+    assert_array_equal(b.compute(), np.array([1, 0, 1, 1, 2, 3, 5, 8]))
+
+
+def test_map_overlap_trim_true_raises():
+    x = np.arange(6)
+    a = xp.asarray(x, chunks=(3,))
+
+    with pytest.raises(ValueError):
+        cubed.map_overlap(
+            lambda x: x,
+            a,
+            dtype=a.dtype,
+            chunks=((5, 5),),
+            depth=1,
+            boundary=0,
+            trim=True,
+        )
+
+
+def test_map_overlap_tuple_depth_and_boundary():
+    x = np.arange(6)
+    a = xp.asarray(x, chunks=(3,))
+
+    b = cubed.map_overlap(
+        lambda x: x,
+        a,
+        dtype=a.dtype,
+        chunks=((5, 5),),
+        depth=(1,),
+        boundary=(0,),
+        trim=False,
+    )
+
+    assert_array_equal(b.compute(), np.array([0, 0, 1, 2, 3, 2, 3, 4, 5, 0]))
+
+
+def test_map_overlap_list_depth():
+    x = np.arange(6)
+    a = xp.asarray(x, chunks=(3,))
+
+    b = cubed.map_overlap(
+        lambda x: x,
+        a,
+        dtype=a.dtype,
+        chunks=((5, 5),),
+        depth=[1],
+        boundary=0,
+        trim=False,
+    )
+
+    assert_array_equal(b.compute(), np.array([0, 0, 1, 2, 3, 2, 3, 4, 5, 0]))
+
+
+def test_map_overlap_kwargs_forwarded():
+    x = np.arange(6)
+    a = xp.asarray(x, chunks=(3,))
+
+    def add_offset(x, offset=0):
+        return x + offset
+
+    b = cubed.map_overlap(
+        add_offset,
+        a,
+        dtype=a.dtype,
+        chunks=((5, 5),),
+        depth=1,
+        boundary=0,
+        trim=False,
+        offset=10,
+    )
+
+    assert_array_equal(b.compute(), np.array([10, 10, 11, 12, 13, 12, 13, 14, 15, 10]))
+
+
+def test_map_overlap_public_module_entry_point():
+    from cubed.overlap import map_overlap
+
+    a = xp.asarray(np.arange(6), chunks=(3,))
+    result = map_overlap(
+        lambda block: block,
+        a,
+        dtype=a.dtype,
+        chunks=((5, 5),),
+        depth=1,
+        boundary=0,
+    )
+
+    # Verify the public entry point returns the requested overlapped shape
+    # without constraining its computed boundary values here.
+    assert result.compute().shape == (10,)
