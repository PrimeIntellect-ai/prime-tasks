 }
+func TestCreateConstraintIncludesExcludedNamespaces(t *testing.T) {
+	binary := filepath.Join(t.TempDir(), "konstraint")
+	if out, err := exec.Command("go", "build", "-o", binary, "github.com/plexsystems/konstraint").CombinedOutput(); err != nil {
+		t.Fatalf("build konstraint: %v: %s", err, out)
+	}
+
+	policyDir := filepath.Join(t.TempDir(), "my-policy")
+	if err := os.MkdirAll(policyDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	policy := `# @title The title
+#
+# @kinds core/Pod
+# @excludedNamespaces kube-system gatekeeper-system
+package test
+
+policyID := "P123456"
+
+violation["msg"] {
+    true
+}
+`
+	if err := os.WriteFile(filepath.Join(policyDir, "src.rego"), []byte(policy), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	outputDir := t.TempDir()
+	if out, err := exec.Command(binary, "create", policyDir, "--output", outputDir).CombinedOutput(); err != nil {
+		t.Fatalf("run create: %v: %s", err, out)
+	}
+
+	constraintBytes, err := os.ReadFile(filepath.Join(outputDir, "constraint_MyPolicy.yaml"))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var constraint struct {
+		Spec struct {
+			Match struct {
+				ExcludedNamespaces []string `json:"excludedNamespaces"`
+			} `json:"match"`
+		} `json:"spec"`
+	}
+	if err := yaml.Unmarshal(constraintBytes, &constraint); err != nil {
+		t.Fatalf("unmarshal constraint: %v", err)
+	}
+
+	actual := append([]string(nil), constraint.Spec.Match.ExcludedNamespaces...)
+	expected := []string{"kube-system", "gatekeeper-system"}
+	sort.Strings(actual)
+	sort.Strings(expected)
+	if !reflect.DeepEqual(actual, expected) {
+		t.Errorf("Unexpected spec.match.excludedNamespaces, have %v want %v", actual, expected)
+	}
+}
