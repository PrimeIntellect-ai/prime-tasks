+
+func isZeroValue(litValue string, typ ast.Expr) bool {
+	switch val := typ.(type) {
+	case *ast.Ident:
+		if val.Name == "any" {
+			return litValue == "nil"
+		}
+	case *ast.InterfaceType:
+		return litValue == "nil"
+	}
+
+	return zeroLiteral[litValue]
+}
