+    private void verifyFinalProjects(List<MavenProject> expectedProjects) {
+        ArgumentCaptor<List<MavenProject>> projectsCaptor = ArgumentCaptor.forClass(List.class);
+        verify(mavenSessionMock, atLeast(0)).setProjects(projectsCaptor.capture());
+        List<List<MavenProject>> capturedProjects = projectsCaptor.getAllValues();
+        // The final project list is either the last one set, or the session's list if nothing had to be changed.
+        List<MavenProject> finalProjects = capturedProjects.isEmpty()
+                ? mavenSessionMock.getProjects()
+                : capturedProjects.get(capturedProjects.size() - 1);
+        assertThat(finalProjects)
+                .as("Unexpected final projects")
+                .containsExactlyElementsOf(expectedProjects);
+    }
+
+    private void verifyProjectsUnchanged() {
+        ArgumentCaptor<List<MavenProject>> projectsCaptor = ArgumentCaptor.forClass(List.class);
+        verify(mavenSessionMock, atLeast(0)).setProjects(projectsCaptor.capture());
+        List<List<MavenProject>> capturedProjects = projectsCaptor.getAllValues();
+        if (!capturedProjects.isEmpty()) {
+            assertThat(capturedProjects.get(capturedProjects.size() - 1))
+                    .as("Unexpected final projects")
+                    .containsExactlyElementsOf(mavenSessionMock.getProjects());
+        }
+    }
