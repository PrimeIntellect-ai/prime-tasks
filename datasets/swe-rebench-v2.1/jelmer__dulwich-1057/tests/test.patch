+def _extension_text(value):
+    """Return the text an UnsupportedExtension exposes for its extension."""
+    if isinstance(value, tuple):
+        value = " ".join(
+            os.fsdecode(v) if isinstance(v, bytes) else str(v) for v in value
+        )
+    elif isinstance(value, bytes):
+        value = os.fsdecode(value)
+    return str(value)
+
