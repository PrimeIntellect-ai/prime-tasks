+func TestDraftReviewComment_GetInReplyTo(t *testing.T) {
+// The contract does not fix the Go integer type of InReplyTo, so the
+// accessor is called reflectively and its integer result is compared by value.
+getInReplyTo := func(c *DraftReviewComment) (int64, bool) {
+m := reflect.ValueOf(c).MethodByName("GetInReplyTo")
+if !m.IsValid() || m.Type().NumIn() != 0 || m.Type().NumOut() != 1 {
+return 0, false
+}
+out := m.Call(nil)[0]
+switch out.Kind() {
+case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+return out.Int(), true
+case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+return int64(out.Uint()), true
+}
+return 0, false
+}
+var comment DraftReviewComment
+if err := json.Unmarshal([]byte(`{"in_reply_to":2468}`), &comment); err != nil {
+t.Fatal(err)
+}
+if got, ok := getInReplyTo(&comment); !ok {
+t.Fatal("DraftReviewComment does not provide GetInReplyTo() with an integer result")
+} else if got != 2468 {
+t.Errorf("GetInReplyTo() = %d, want %d", got, 2468)
+}
+if got, ok := getInReplyTo(&DraftReviewComment{}); !ok || got != 0 {
+t.Errorf("GetInReplyTo() for an unset field = %d (ok=%v), want 0", got, ok)
+}
+if got, ok := getInReplyTo(nil); !ok || got != 0 {
+t.Errorf("GetInReplyTo() for a nil receiver = %d (ok=%v), want 0", got, ok)
+}
+}
