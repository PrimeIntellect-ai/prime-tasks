+func TestDraftReviewComment_ReviewCommentFieldsJSON(t *testing.T) {
+	var comment DraftReviewComment
+	if err := json.Unmarshal([]byte(`{"commit_id":"commit-sha","in_reply_to":2468,"subject_type":"line"}`), &comment); err != nil {
+		t.Fatalf("Unmarshal review comment fields: %v", err)
+	}
+	data, err := json.Marshal(&comment)
+	if err != nil {
+		t.Fatalf("Marshal review comment fields: %v", err)
+	}
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(data, &fields); err != nil {
+		t.Fatalf("Unmarshal serialized review comment: %v", err)
+	}
+	for key, want := range map[string]string{"commit_id": `"commit-sha"`, "in_reply_to": `2468`, "subject_type": `"line"`} {
+		if got := string(fields[key]); got != want {
+			t.Errorf("serialized %s = %s, want %s", key, got, want)
+		}
+	}
+}
