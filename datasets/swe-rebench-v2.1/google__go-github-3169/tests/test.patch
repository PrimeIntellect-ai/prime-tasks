+func TestDraftReviewComment_GetCommitID(t *testing.T) {
+	var comment DraftReviewComment
+	if err := json.Unmarshal([]byte(`{"commit_id":"commit-sha"}`), &comment); err != nil {
+		t.Fatal(err)
+	}
+	getter, ok := interface{}(&comment).(interface{ GetCommitID() string })
+	if !ok {
+		t.Fatal("DraftReviewComment does not provide GetCommitID() string")
+	}
+	if got := getter.GetCommitID(); got != "commit-sha" {
+		t.Errorf("GetCommitID() = %q, want %q", got, "commit-sha")
+	}
+	if got := interface{}(&DraftReviewComment{}).(interface{ GetCommitID() string }).GetCommitID(); got != "" {
+		t.Errorf("GetCommitID() for an unset field = %q, want empty string", got)
+	}
+	var nilComment *DraftReviewComment
+	nilGetter, ok := interface{}(nilComment).(interface{ GetCommitID() string })
+	if !ok {
+		t.Fatal("DraftReviewComment does not provide GetCommitID() string for a nil receiver")
+	}
+	if got := nilGetter.GetCommitID(); got != "" {
+		t.Errorf("GetCommitID() for a nil receiver = %q, want empty string", got)
+	}
+}
