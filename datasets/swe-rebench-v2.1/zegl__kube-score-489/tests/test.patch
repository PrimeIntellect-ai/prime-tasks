+func TestStatefulsetTemplateNestedIgnoreAnnotations(t *testing.T) {
+	t.Parallel()
+	skipped := isSuppressed(t, config.Configuration{
+		UseIgnoreChecksAnnotation:   true,
+		UseOptionalChecksAnnotation: true,
+		AllFiles:                    []ks.NamedReader{testFile("statefulset-nested-ignores.yaml")},
+	}, "Container Image Tag")
+	assert.True(t, skipped)
+	assert.True(t, isSuppressed(t, config.Configuration{
+		UseIgnoreChecksAnnotation:   true,
+		UseOptionalChecksAnnotation: true,
+		AllFiles:                    []ks.NamedReader{testFile("statefulset-nested-ignores.yaml")},
+	}, "Pod Probes"))
+	assert.False(t, isSuppressed(t, config.Configuration{
+		UseIgnoreChecksAnnotation:   true,
+		UseOptionalChecksAnnotation: true,
+		AllFiles:                    []ks.NamedReader{testFile("statefulset-nested-ignores.yaml")},
+	}, "Container Image Pull Policy"))
+}
+
+func TestStatefulsetTemplateAnnotationRespectsIgnoreFlag(t *testing.T) {
+	t.Parallel()
+	for _, check := range []string{"Container Image Tag", "Pod Probes"} {
+		assert.False(t, isSuppressed(t, config.Configuration{
+			UseIgnoreChecksAnnotation:   false,
+			UseOptionalChecksAnnotation: true,
+			AllFiles:                    []ks.NamedReader{testFile("statefulset-nested-ignores.yaml")},
+		}, check), check)
+	}
+}
