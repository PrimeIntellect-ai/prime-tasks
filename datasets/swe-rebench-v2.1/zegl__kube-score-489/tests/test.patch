+func isSuppressed(t *testing.T, config config.Configuration, testcase string) bool {
+	t.Helper()
+	sc, err := testScore(config)
+	assert.NoError(t, err)
+	for _, objectScore := range sc {
+		for _, s := range objectScore.Checks {
+			if s.Check.Name == testcase {
+				return s.Skipped
+			}
+		}
+	}
+
+	t.Fatalf("check %q was not part of the scorecard", testcase)
+	return false
+}
