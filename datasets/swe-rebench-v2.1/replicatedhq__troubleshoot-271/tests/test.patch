+func Test_imagePullSecretMissingOutcomes(t *testing.T) {
+	const registry = "quay.io"
+	passOutcome := &troubleshootv1beta2.Outcome{
+		Pass: &troubleshootv1beta2.SingleOutcome{Message: "pull secret pass"},
+	}
+	failOutcome := &troubleshootv1beta2.Outcome{
+		Fail: &troubleshootv1beta2.SingleOutcome{Message: "pull secret fail"},
+	}
+
+	tests := []struct {
+		name       string
+		outcomes   []*troubleshootv1beta2.Outcome
+		hasCreds   bool
+		expectPass bool
+		expectFail bool
+		expectMsg  string
+	}{
+		{
+			name:       "only fail outcome, credentials found",
+			outcomes:   []*troubleshootv1beta2.Outcome{failOutcome},
+			hasCreds:   true,
+			expectPass: true,
+			expectFail: false,
+		},
+		{
+			name:       "only pass outcome, credentials not found",
+			outcomes:   []*troubleshootv1beta2.Outcome{passOutcome},
+			hasCreds:   false,
+			expectPass: false,
+			expectFail: true,
+		},
+		{
+			name:       "only pass outcome, credentials found",
+			outcomes:   []*troubleshootv1beta2.Outcome{passOutcome},
+			hasCreds:   true,
+			expectPass: true,
+			expectFail: false,
+			expectMsg:  "pull secret pass",
+		},
+		{
+			name:       "only fail outcome, credentials not found",
+			outcomes:   []*troubleshootv1beta2.Outcome{failOutcome},
+			hasCreds:   false,
+			expectPass: false,
+			expectFail: true,
+			expectMsg:  "pull secret fail",
+		},
+		{
+			name:       "no outcomes, credentials found",
+			outcomes:   nil,
+			hasCreds:   true,
+			expectPass: true,
+			expectFail: false,
+		},
+		{
+			name:       "no outcomes, credentials not found",
+			outcomes:   nil,
+			hasCreds:   false,
+			expectPass: false,
+			expectFail: true,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			req := require.New(t)
+
+			analyzer := &troubleshootv1beta2.Analyze{
+				ImagePullSecret: &troubleshootv1beta2.ImagePullSecret{
+					Outcomes:     test.outcomes,
+					RegistryName: registry,
+				},
+			}
+
+			findFiles := func(name string) (map[string][]byte, error) {
+				registries := map[string]string{"docker.io": "user"}
+				if test.hasCreds {
+					registries = map[string]string{registry: "user"}
+				}
+				data, err := json.Marshal(registries)
+				req.NoError(err)
+				return map[string][]byte{"cluster-resources/image-pull-secrets/secret": data}, nil
+			}
+
+			var actual []*AnalyzeResult
+			var err error
+			req.NotPanics(func() {
+				actual, err = Analyze(analyzer, nil, findFiles)
+			})
+			req.NoError(err)
+			req.Len(actual, 1)
+			req.Equal(test.expectPass, actual[0].IsPass)
+			req.Equal(test.expectFail, actual[0].IsFail)
+			if test.expectMsg != "" {
+				req.Equal(test.expectMsg, actual[0].Message)
+			}
+		})
+	}
+}
