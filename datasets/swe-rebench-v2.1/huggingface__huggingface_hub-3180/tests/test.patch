+def test_get_hf_file_metadata_rewrites_refresh_route_with_endpoint(mocker, monkeypatch) -> None:
+    """Metadata fetched with a custom endpoint must not expose a hard-coded huggingface.co refresh route."""
+    endpoint = "https://xet.example.com"
+    monkeypatch.setattr(constants, "ENDPOINT", endpoint)
+    mock_response = MagicMock()
+    mock_response.headers = {
+        "X-Xet-Hash": "sha256:abcdef",
+        "X-Xet-Refresh-Route": "https://huggingface.co/api/models/username/repo_name/xet-read-token/token",
+    }
+    mock_response.links = {}
+    mock_response.request.url = f"{endpoint}/username/repo_name/resolve/main/file"
+
+    mocker.patch("huggingface_hub.file_download._request_wrapper", return_value=mock_response)
+
+    metadata = get_hf_file_metadata(url=f"{endpoint}/username/repo_name/resolve/main/file")
+
+    assert metadata.xet_file_data is not None
+    assert "huggingface.co" not in metadata.xet_file_data.refresh_route
+
