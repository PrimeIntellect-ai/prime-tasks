+package day66
+
+import (
+	"fmt"
+	"testing"
+)
+
+// tossCount is the number of samples used for the statistical checks. It is
+// large enough that the tolerances below are many standard deviations wide, so
+// the tests do not reject valid random samples.
+const tossCount = 100000
+
+// TestBiasedCoinDistribution checks that BiasedCoin.Toss returns 0 with
+// probability zeroBias/100 and 1 otherwise.
+func TestBiasedCoinDistribution(t *testing.T) {
+	t.Parallel()
+	for _, zeroBias := range []int{10, 25, 50, 75, 90, 99} {
+		zeroBias := zeroBias
+		t.Run(fmt.Sprintf("zeroBias=%d", zeroBias), func(t *testing.T) {
+			t.Parallel()
+			bc := NewBiasedCoin(zeroBias)
+			zeros := 0
+			for i := 0; i < tossCount; i++ {
+				switch v := bc.Toss(); v {
+				case 0:
+					zeros++
+				case 1:
+				default:
+					t.Fatalf("Toss returned %d, want 0 or 1", v)
+				}
+			}
+			want := float64(zeroBias) / 100.0
+			got := float64(zeros) / float64(tossCount)
+			if diff := got - want; diff < -0.03 || diff > 0.03 {
+				t.Errorf("zeroBias=%d: fraction of zeros = %v, want about %v", zeroBias, got, want)
+			}
+		})
+	}
+}
+
+// TestFairTosserDistribution checks that FairTosser.Toss returns 0 or 1 with an
+// unbiased 50-50 distribution, regardless of the underlying coin's bias.
+func TestFairTosserDistribution(t *testing.T) {
+	t.Parallel()
+	for _, zeroBias := range []int{10, 25, 50, 75, 90, 99} {
+		zeroBias := zeroBias
+		t.Run(fmt.Sprintf("zeroBias=%d", zeroBias), func(t *testing.T) {
+			t.Parallel()
+			ft := NewFairTosser(NewBiasedCoin(zeroBias))
+			zeros := 0
+			for i := 0; i < tossCount; i++ {
+				switch v := ft.Toss(); v {
+				case 0:
+					zeros++
+				case 1:
+				default:
+					t.Fatalf("Toss returned %d, want 0 or 1", v)
+				}
+			}
+			got := float64(zeros) / float64(tossCount)
+			if got < 0.45 || got > 0.55 {
+				t.Errorf("zeroBias=%d: fraction of zeros = %v, want about 0.5", zeroBias, got)
+			}
+		})
+	}
+}
+
+// TestFairTosserProducesBothOutcomes checks that FairTosser.Toss produces both
+// 0 and 1 for a strongly biased coin, i.e. it does not collapse to a single
+// outcome.
+func TestFairTosserProducesBothOutcomes(t *testing.T) {
+	t.Parallel()
+	ft := NewFairTosser(NewBiasedCoin(99))
+	var zeros, ones int
+	for i := 0; i < tossCount; i++ {
+		switch ft.Toss() {
+		case 0:
+			zeros++
+		case 1:
+			ones++
+		}
+	}
+	if zeros == 0 || ones == 0 {
+		t.Fatalf("FairTosser.Toss produced only one outcome: zeros=%d ones=%d", zeros, ones)
+	}
+}
+
+func BenchmarkFairTosser(b *testing.B) {
+	bc := NewBiasedCoin(99)
+	ft := NewFairTosser(bc)
+	for i := 0; i < b.N; i++ {
+		ft.Toss()
+	}
+}
