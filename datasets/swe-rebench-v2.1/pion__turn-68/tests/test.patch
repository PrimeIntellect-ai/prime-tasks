+
+// getPermission exercises the allocation's public lookup operation while
+// supplying an IP-only key when the API accepts fingerprints directly.
+func getPermission(a *Allocation, addr *net.UDPAddr) *Permission {
+	if lookup, ok := interface{}(a).(interface {
+		GetPermission(net.Addr) *Permission
+	}); ok {
+		return lookup.GetPermission(addr)
+	}
+	return interface{}(a).(interface {
+		GetPermission(string) *Permission
+	}).GetPermission(addr.IP.String())
+}
+
+// removePermission follows the same key convention as getPermission.
+func removePermission(a *Allocation, addr *net.UDPAddr) {
+	if remover, ok := interface{}(a).(interface {
+		RemovePermission(net.Addr)
+	}); ok {
+		remover.RemovePermission(addr)
+		return
+	}
+	interface{}(a).(interface {
+		RemovePermission(string)
+	}).RemovePermission(addr.IP.String())
+}
