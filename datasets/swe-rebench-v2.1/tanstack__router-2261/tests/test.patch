+describe('encoding: basepath', () => {
+  it('should not change the browser location and should preserve the encoded basepath in links', async () => {
+    window.history.replaceState(null, 'root', '/base%2Fpath')
+
+    const rootRoute = createRootRoute()
+    const indexRoute = createRoute({
+      getParentRoute: () => rootRoute,
+      path: '/',
+      component: () => (
+        <>
+          <h1>Index</h1>
+          <Link to="/any-page">AnyPage</Link>
+        </>
+      ),
+    })
+    const anyPageRoute = createRoute({
+      getParentRoute: () => rootRoute,
+      path: '/any-page',
+      component: () => <h1>AnyPage</h1>,
+    })
+
+    const router = createRouter({
+      routeTree: rootRoute.addChildren([indexRoute, anyPageRoute]),
+      basepath: '/base%2Fpath',
+    })
+
+    render(<RouterProvider router={router} />)
+    await act(() => router.load())
+
+    expect(window.location.pathname).toBe('/base%2Fpath')
+
+    const link = await screen.findByRole('link', { name: 'AnyPage' })
+    expect(link).toHaveAttribute('href', '/base%2Fpath/any-page')
+  })
+})
