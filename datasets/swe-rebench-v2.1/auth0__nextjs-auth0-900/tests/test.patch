+  it('should get all cookies in Next < 13.0.1', async () => {
+    // In Next.js < 13.0.1 `req.cookies` is a `Map` (it has no `getAll` method).
+    // Provide the equivalent `cookie` header too so implementations that read
+    // from either source are accepted.
+    const req = {
+      cookies: new Map([
+        ['foo', 'bar'],
+        ['bar', 'baz']
+      ]),
+      headers: new Headers({ cookie: 'foo=bar; bar=baz;' })
+    } as unknown as NextRequest;
+    expect(new MiddlewareCookies().getAll(req)).toMatchObject({ foo: 'bar', bar: 'baz' });
+  });
+
