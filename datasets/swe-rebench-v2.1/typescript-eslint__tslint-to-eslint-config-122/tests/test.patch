+describe("CLI output-write failures", () => {
+    it("reports a failed output write and sets a non-zero process status", async () => {
+        const previousExitCode = process.exitCode;
+        process.exitCode = 0;
+        const writeError = new Error("simulated output write failure");
+        const writeFile = jest.spyOn(fsFileSystem, "writeFile").mockResolvedValue(writeError);
+        const stderrWrite = jest.spyOn(process.stderr, "write").mockImplementation(() => true);
+
+        try {
+            await main([
+                "node",
+                "some/path/bin/file",
+                "--tslint",
+                "test/tests/standalone tslint.json/tslint.json",
+                "--eslint",
+                "test/tests/standalone tslint.json/.eslintrc.json",
+                "--config",
+                "./eslint-output.js",
+            ]);
+
+            expect(Number(process.exitCode)).toBeGreaterThan(0);
+            expect(stderrWrite.mock.calls.map(args => args[0]).join("")).toContain(
+                "simulated output write failure",
+            );
+        } finally {
+            writeFile.mockRestore();
+            stderrWrite.mockRestore();
+            process.exitCode = previousExitCode;
+        }
+    });
+});
