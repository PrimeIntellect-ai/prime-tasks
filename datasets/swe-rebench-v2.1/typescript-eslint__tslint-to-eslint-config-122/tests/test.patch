+describe("writeConversionResults", () => {
+    it("returns the file write error when the configuration file cannot be written", async () => {
+        // Arrange
+        const fileWriteError = new Error("Unable to write the configuration file");
+        const fileSystem = { writeFile: jest.fn().mockResolvedValue(fileWriteError) };
+
+        // Act
+        const result = await writeConversionResults(
+            { fileSystem },
+            ".eslintrc.json",
+            createEmptyConversionResults(),
+            { tslint: { rules: {}, rulesDirectory: [] } },
+        );
+
+        // Assert
+        expect(result).toBeInstanceOf(Error);
+    });
+
+    it("returns undefined when the configuration file is written successfully", async () => {
+        // Arrange
+        const fileSystem = { writeFile: jest.fn().mockResolvedValue(undefined) };
+
