+import pytest
+import sys
+
+import semver
+
+
+PY2 = sys.version_info[0] == 2
+PY3 = sys.version_info[0] == 3
+
+
+def test_should_work_with_string_and_unicode():
+    result = semver.compare(semver.u("1.1.0"), semver.b("1.2.2"))
+    assert result == -1
+    result = semver.compare(semver.b("1.1.0"), semver.u("1.2.2"))
+    assert result == -1
+
+
+def test_should_work_with_bytes_and_text():
+    # The library accepts both text and binary strings.
+    assert semver.compare(b"1.1.0", b"1.2.2") == -1
+    assert semver.compare("1.1.0", b"1.2.2") == -1
+    assert semver.compare(b"1.1.0", "1.2.2") == -1
+    assert semver.VersionInfo.parse(b"1.2.3") == semver.VersionInfo.parse("1.2.3")
+    maximum = semver.max_ver(b"1.1.0", b"1.2.2")
+    assert semver.VersionInfo.parse(maximum) == semver.VersionInfo.parse("1.2.2")
+
+
+def test_py2_flag():
+    assert semver.PY2 == (sys.version_info[0] == 2)
+
+
+def test_text_and_binary_types():
+    assert isinstance(semver.u("1.0.0"), semver.text_type)
+    assert isinstance(semver.b("1.0.0"), semver.binary_type)
+
+
+class TestEnsure:
+    # From six project
+    # grinning face emoji
+    BINARY_EMOJI = b"\xf0\x9f\x98\x80"
+
+    def test_ensure_str_raise_type_error(self):
+        with pytest.raises(TypeError):
+            semver.ensure_str(8)
+
+    def test_ensure_str(self):
+        unicode_emoji = semver.u("\U0001F600")
+        converted_unicode = semver.ensure_str(
+            unicode_emoji, encoding="utf-8", errors="strict"
+        )
+        converted_binary = semver.ensure_str(
+            self.BINARY_EMOJI, encoding="utf-8", errors="strict"
+        )
+        converted_binary_with_defaults = semver.ensure_str(self.BINARY_EMOJI)
+        if PY2:
+            # PY2: unicode -> str
+            assert converted_unicode == self.BINARY_EMOJI and isinstance(
+                converted_unicode, str
+            )
+            # PY2: str -> str
+            assert converted_binary == self.BINARY_EMOJI and isinstance(
+                converted_binary, str
+            )
+            assert converted_binary_with_defaults == self.BINARY_EMOJI
+        else:
+            # PY3: str -> str
+            assert converted_unicode == unicode_emoji and isinstance(
+                converted_unicode, str
+            )
+            # PY3: bytes -> str
+            assert converted_binary == unicode_emoji and isinstance(
+                converted_binary, str
+            )
+            assert converted_binary_with_defaults == unicode_emoji
+
+    def test_ensure_str_encoding_and_errors(self):
+        if PY3:
+            # bytes are decoded using the supplied encoding
+            assert semver.ensure_str(b"\xe9", encoding="latin-1") == "\xe9"
+            # the errors argument is honoured
+            with pytest.raises(UnicodeDecodeError):
+                semver.ensure_str(b"\xe9", encoding="utf-8", errors="strict")
+            assert semver.ensure_str(b"\xe9", encoding="utf-8", errors="ignore") == ""
+        else:
+            # unicode is encoded using the supplied encoding
+            assert semver.ensure_str(semver.u("\xe9"), encoding="latin-1") == b"\xe9"
+            # the errors argument is honoured
+            with pytest.raises(UnicodeEncodeError):
+                semver.ensure_str(semver.u("\xe9"), encoding="ascii", errors="strict")
+            assert (
+                semver.ensure_str(semver.u("\xe9"), encoding="ascii", errors="ignore")
+                == b""
+            )
