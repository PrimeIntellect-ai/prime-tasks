+use ndarray::prelude::*;
+use ndarray::Zip;
+
+#[test]
+fn cell_view() {
+    let mut a = Array::from_shape_fn((10, 5), |(i, j)| (i * j) as f32);
+    let answer = &a + 1.;
+
+    {
+        let cv1 = a.cell_view();
+        let cv2 = cv1;
+
+        Zip::from(cv1).and(cv2).apply(|a, b| a.set(b.get() + 1.));
+    }
+    assert_eq!(a, answer);
+}
+
+#[test]
+fn math_cell_public_and_interior_mutability() {
+    let mut a = Array::from_shape_fn((4,), |i| i as i32);
+    {
+        let cv = a.cell_view();
+        let cell: &ndarray::MathCell<i32> = &cv[[1]];
+        cell.set(cell.get() + 10);
+    }
+    assert_eq!(a[[1]], 11);
+}
+
+#[test]
+fn math_cell_matches_cell_layout() {
+    use std::cell::Cell;
+    use std::mem::{align_of, size_of};
+
+    assert_eq!(size_of::<ndarray::MathCell<[u8; 3]>>(), size_of::<Cell<[u8; 3]>>());
+    assert_eq!(align_of::<ndarray::MathCell<[u8; 3]>>(), align_of::<Cell<[u8; 3]>>());
+}
