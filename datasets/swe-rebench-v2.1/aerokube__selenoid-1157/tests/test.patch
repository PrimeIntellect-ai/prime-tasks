+func TestAerokubeClipboardExtensionStoresPostedValue(t *testing.T) {
+	clipboardContents := "initial clipboard value"
+	clipboardServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodPost {
+			data, err := io.ReadAll(r.Body)
+			if err != nil {
+				http.Error(w, err.Error(), http.StatusInternalServerError)
+				return
+			}
+			clipboardContents = string(data)
+			w.WriteHeader(http.StatusNoContent)
+			return
+		}
+		_, _ = io.WriteString(w, clipboardContents)
+	}))
+	defer clipboardServer.Close()
+
+	sessions.Put("clipboard-session", &session.Session{
+		HostPort:  session.HostPort{Clipboard: strings.TrimPrefix(clipboardServer.URL, "http://")},
+		Timeout:   time.Minute,
+		TimeoutCh: make(chan struct{}),
+	})
+	defer sessions.Remove("clipboard-session")
+
+	url := With(srv.URL).Path("/wd/hub/session/clipboard-session/aerokube/clipboard")
+	response, err := http.Post(url, "text/plain", strings.NewReader("updated clipboard value"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if response.StatusCode < http.StatusOK || response.StatusCode >= http.StatusMultipleChoices {
+		t.Fatalf("clipboard POST returned status %d, want a successful 2xx status", response.StatusCode)
+	}
+	response.Body.Close()
+
+	response, err = http.Get(url)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	AssertThat(t, response, Code{http.StatusOK})
+	data, err := io.ReadAll(response.Body)
+	AssertThat(t, err, Is{nil})
+	AssertThat(t, string(data), EqualTo{"updated clipboard value"})
+}
