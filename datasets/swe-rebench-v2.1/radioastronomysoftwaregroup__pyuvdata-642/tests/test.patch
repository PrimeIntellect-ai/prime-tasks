+def test_baseline_to_antnums_vectorized(uvdata_baseline):
+    """Test vectorized antnum to baseline conversion."""
+    ant_1 = [10, 280]
+    ant_2 = [20, 310]
+    baseline_array = uvdata_baseline.uv_object.antnums_to_baseline(ant_1, ant_2)
+    assert np.array_equal(baseline_array, [88085, 641335])
+    ant_1_out, ant_2_out = uvdata_baseline.uv_object.baseline_to_antnums(list(baseline_array))
+    assert np.array_equal(ant_1, ant_1_out)
+    assert np.array_equal(ant_2, ant_2_out)
+
+
+def test_uvutils_baseline_to_antnums_array():
+    """Test scalar and array-like baseline conversion through the utility."""
+    assert uvutils.baseline_to_antnums(88085, 350) == (10, 20)
+
+    ant1, ant2 = uvutils.baseline_to_antnums([88085, 641335], 350)
+    assert np.array_equal(ant1, [10, 280])
+    assert np.array_equal(ant2, [20, 310])
+
+
+def test_uvutils_antnums_to_baseline_array():
+    """Test scalar and array-like antenna conversion through the utility."""
+    assert uvutils.antnums_to_baseline(10, 20, 350) == 88085
+
+    baseline = uvutils.antnums_to_baseline([10, 280], [20, 310], 350)
+    assert np.array_equal(baseline, [88085, 641335])
+
+
 def test_antnums_to_baselines(uvdata_baseline):
