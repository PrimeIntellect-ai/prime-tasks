+  describe('scriptName', () => {
+    it('should allow the script name to be removed from the command listing', () => {
+      const r = checkUsage(() => yargs(['--help'])
+        .scriptName('')
+        .command('hello [name]', 'welcome ter yargs!')
+        .parse()
+      )
+      const commandRow = r.logs.join('\n').split(/\n+/).find((line) => line.indexOf('hello [name]') !== -1)
+      commandRow.trim().should.match(/^hello \[name\]\s+welcome ter yargs!$/)
+      r.errors.should.have.length(0)
+      r.exit.should.equal(true)
+    })
+  })
+
