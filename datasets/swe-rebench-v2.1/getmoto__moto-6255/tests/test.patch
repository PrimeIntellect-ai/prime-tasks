+@pytest.mark.parametrize("raw_delivery", [False, True])
+@mock_sns
+@mock_sqs
+def test_publish_to_sqs_fifo_forwards_deduplication_id(raw_delivery):
+    sns = boto3.client("sns", region_name="us-east-1")
+    topic_arn = sns.create_topic(
+        Name="topic.fifo", Attributes={"FifoTopic": "true"}
+    )["TopicArn"]
+    endpoint = "https://sqs.us-east-1.amazonaws.com/"
+    create_response = requests.post(
+        endpoint,
+        data={
+            "Action": "CreateQueue",
+            "Version": "2012-11-05",
+            "QueueName": "queue.fifo",
+            "Attribute.1.Name": "FifoQueue",
+            "Attribute.1.Value": "true",
+        },
+    )
+    queue_url = ElementTree.fromstring(create_response.content).findtext(
+        ".//QueueUrl"
+    )
+    queue_arn = f"arn:aws:sqs:us-east-1:{ACCOUNT_ID}:queue.fifo"
+    subscription_attributes = {"RawMessageDelivery": "true"} if raw_delivery else {}
+    sns.subscribe(
+        TopicArn=topic_arn,
+        Protocol="sqs",
+        Endpoint=queue_arn,
+        Attributes=subscription_attributes,
+    )
+
+    sns.publish(
+        TopicArn=topic_arn,
+        Message="message",
+        MessageGroupId="message_group_id",
+        MessageDeduplicationId="message_deduplication_id",
+        MessageAttributes={"kind": {"DataType": "String", "StringValue": "value"}},
+    )
+
+    receive_response = requests.post(
+        endpoint,
+        data={
+            "Action": "ReceiveMessage",
+            "Version": "2012-11-05",
+            "QueueUrl": queue_url,
+            "AttributeName.1": "MessageDeduplicationId",
+        },
+    )
+    received = ElementTree.fromstring(receive_response.content).findall(
+        ".//{*}ReceiveMessageResult/{*}Message"
+    )
+    assert len(received) == 1
+    message_attributes = {
+        attribute.findtext("{*}Name"): attribute.findtext("{*}Value")
+        for attribute in received[0].findall("./{*}Attribute")
+    }
+    assert message_attributes["MessageDeduplicationId"] == "message_deduplication_id"
+
+
