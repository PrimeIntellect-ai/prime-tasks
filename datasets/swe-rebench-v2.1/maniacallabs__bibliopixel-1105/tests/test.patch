+import time
+import unittest
+
+from bibliopixel import builder
+from bibliopixel.drivers.dummy import Dummy
+from bibliopixel.project import project
+
+
+class RecordingDriver(Dummy):
+    """A dummy driver that records whether it has been shut down."""
+
+    instances = []
+
+    def __init__(self, *args, **kwds):
+        super().__init__(*args, **kwds)
+        self.stopped = False
+        self.cleaned_up = False
+        type(self).instances.append(self)
+
+    def stop(self):
+        self.stopped = True
+        super().stop()
+
+    def cleanup(self):
+        self.cleaned_up = True
+        super().cleanup()
+
+
+def _wait_for(predicate, timeout=2.0):
+    end = time.time() + timeout
+    while time.time() < end:
+        if predicate():
+            return True
+        time.sleep(0.01)
+    return predicate()
+
+
+class TestShutdown(unittest.TestCase):
+    def setUp(self):
+        RecordingDriver.instances.clear()
+
+    def test_builder_cleans_up_drivers(self):
+        b = builder.Builder(shape=8, driver=RecordingDriver)
+        b.start(True)
+        self.assertTrue(_wait_for(lambda: len(RecordingDriver.instances) == 1))
+        driver = RecordingDriver.instances[0]
+        b.stop()
+        self.assertTrue(_wait_for(lambda: driver.cleaned_up))
+
+    def test_project_stops_drivers(self):
+        desc = {'shape': 8, 'driver': {'datatype': RecordingDriver},
+                'run': {'threaded': True}}
+        p = project.project(desc)
+        p.start()
+        self.assertEqual(len(RecordingDriver.instances), 1)
+        driver = RecordingDriver.instances[0]
+        p.stop()
+        self.assertTrue(_wait_for(lambda: driver.stopped))
