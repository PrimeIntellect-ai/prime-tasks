+@testset "# runic: (on|off)" begin
+    # The toggle comments make it possible to keep manual formatting, such as
+    # aligned operators, instead of having the formatter normalize it.
+    for (off, on) in (
+        ("# runic: off", "# runic: on"),
+        ("#! format: off", "#! format: on"),
+    )
+        # Aligned assignments at the top level are preserved between paired toggles.
+        @test format_string("$off\na  = 1\n$on\nb  = 2\n") ==
+            "$off\na  = 1\n$on\nb = 2\n"
+        # Aligned operators are preserved.
+        @test format_string("$off\nx    = 1 + 2\nyyyy = 3 + 4\n$on\nz  = 5\n") ==
+            "$off\nx    = 1 + 2\nyyyy = 3 + 4\n$on\nz = 5\n"
+        # Aligned assignments inside a function are preserved.
+        @test format_string(
+            """
+            function f()
+                $off
+                a  = 1
+                ab = 2
+                $on
+            end
+            """,
+        ) == """
+        function f()
+            $off
+            a  = 1
+            ab = 2
+            $on
+        end
+        """
+        # A toggle comment that is not on its own line is not a toggle.
+        @test format_string("x = 1 $off\na  = 1\n") == "x = 1 $off\na = 1\n"
+        # An `off` comment without a matching `on` comment at the same tree level
+        # is not a toggle.
+        @test format_string("function f()\n    $off\n    a  = 1\nend\n$on\n") ==
+            "function f()\n    $off\n    a = 1\nend\n$on\n"
+    end
+    # An unmatched top-level `# runic: off` disables formatting to end of file.
+    @test format_string("# runic: off\na  = 1\nab = 2\n") ==
+        "# runic: off\na  = 1\nab = 2\n"
+    # The two comment styles cannot be mixed.
+    @test format_string(
+        "function f()\n    # runic: off\n    a  = 1\n    #! format: on\n    b  = 2\nend\n",
+    ) == "function f()\n    # runic: off\n    a = 1\n    #! format: on\n    b = 2\nend\n"
+    @test format_string(
+        "function f()\n    #! format: off\n    a  = 1\n    # runic: on\n    b  = 2\nend\n",
+    ) == "function f()\n    #! format: off\n    a = 1\n    # runic: on\n    b = 2\nend\n"
+end
 
