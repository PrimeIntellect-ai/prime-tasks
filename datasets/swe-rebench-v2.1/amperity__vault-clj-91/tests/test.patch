diff --git a/test/vault/sys/mounts_test.clj b/test/vault/sys/mounts_test.clj
new file mode 100644
index 0000000..1c355be
--- /dev/null
+++ b/test/vault/sys/mounts_test.clj
@@ -0,0 +1,222 @@
+(ns vault.sys.mounts-test
+  (:require
+    [clojure.data.json :as json]
+    [clojure.string :as str]
+    [clojure.test :refer [is testing deftest]]
+    [org.httpkit.client :as http-client]
+    [vault.client.http :as http]
+    [vault.integration :refer [with-dev-server]]
+    [vault.sys.mounts :as sys.mounts]))
+
+
+(defn- mock-request
+  "Return a function which simulates an HTTP request, recording the request
+  map and invoking the callback with the given response."
+  [calls response]
+  (fn request
+    [req callback]
+    (swap! calls conj req)
+    (callback (assoc response :opts req))))
+
+
+(defn- test-client
+  "Construct an HTTP client pointed at a fake address."
+  []
+  (http/http-client "https://vault.test:8200"))
+
+
+(defn- last-request
+  "Return the most recent request captured by the mock."
+  [calls]
+  (last @calls))
+
+
+(defn- request-path
+  "Return the path portion of a captured request URL, ignoring any trailing
+  slash."
+  [req]
+  (-> (:url req)
+      (str/replace #"^[a-zA-Z]+://[^/]+" "")
+      (str/replace #"/+$" "")))
+
+
+(defn- request-body
+  "Return the parsed JSON body of a captured request, accepting either a
+  serialized string or an already-decoded map."
+  [req]
+  (let [body (:body req)]
+    (if (string? body)
+      (json/read-str body)
+      body)))
+
+
+(deftest mock-api
+  (testing "list-mounts"
+    (let [calls (atom [])
+          client (test-client)]
+      (with-redefs [http-client/request
+                    (mock-request
+                      calls
+                      {:status 200
+                       :body (json/write-str
+                               {"data" {"cubbyhole/" {"type" "cubbyhole"
+                                                      "uuid" "abc-123"
+                                                      "description" "cubbyhole"
+                                                      "default_lease_ttl" 0}}})})]
+        (let [result (sys.mounts/list-mounts client)
+              req (last-request calls)]
+          (is (= :get (:method req)))
+          (is (str/ends-with? (request-path req) "/sys/mounts"))
+          (is (= #{"cubbyhole/"} (set (keys result))))
+          (is (= "cubbyhole" (:type (get result "cubbyhole/"))))
+          (is (= "abc-123" (:uuid (get result "cubbyhole/"))))
+          (is (= 0 (:default-lease-ttl (get result "cubbyhole/"))))))))
+  (testing "enable-secrets!"
+    (let [calls (atom [])
+          client (test-client)]
+      (with-redefs [http-client/request
+                    (mock-request calls {:status 204 :body ""})]
+        (let [result (sys.mounts/enable-secrets!
+                       client
+                       "ldap"
+                       {:type "openldap"
+                        :description "LDAP secret storage"
+                        :config {:default-lease-ttl "6m"}
+                        :options {:version "1"}})
+              req (last-request calls)
+              body (request-body req)]
+          (is (nil? result))
+          (is (= :post (:method req)))
+          (is (str/ends-with? (request-path req) "/sys/mounts/ldap"))
+          (is (= "openldap" (get body "type")))
+          (is (= "LDAP secret storage" (get body "description")))
+          (is (= {"default_lease_ttl" "6m"} (get body "config")))
+          (is (= {"version" "1"} (get body "options")))))))
+  (testing "disable-secrets!"
+    (let [calls (atom [])
+          client (test-client)]
+      (with-redefs [http-client/request
+                    (mock-request calls {:status 204 :body ""})]
+        (let [result (sys.mounts/disable-secrets! client "ldap")
+              req (last-request calls)]
+          (is (nil? result))
+          (is (= :delete (:method req)))
+          (is (str/ends-with? (request-path req) "/sys/mounts/ldap"))))))
+  (testing "read-secrets-configuration"
+    (let [calls (atom [])
+          client (test-client)]
+      (with-redefs [http-client/request
+                    (mock-request
+                      calls
+                      {:status 200
+                       :body (json/write-str
+                               {"data" {"type" "openldap"
+                                        "description" "LDAP secret storage"
+                                        "config" {"default_lease_ttl" 360}}})})]
+        (let [result (sys.mounts/read-secrets-configuration client "ldap")
+              req (last-request calls)]
+          (is (= :get (:method req)))
+          (is (str/ends-with? (request-path req) "/sys/mounts/ldap"))
+          (is (= "openldap" (:type result)))
+          (is (= "LDAP secret storage" (:description result)))
+          (is (= 360 (get-in result [:config :default-lease-ttl])))))))
+  (testing "read-mount-configuration"
+    (let [calls (atom [])
+          client (test-client)]
+      (with-redefs [http-client/request
+                    (mock-request
+                      calls
+                      {:status 200
+                       :body (json/write-str
+                               {"data" {"default_lease_ttl" 1800
+                                        "max_lease_ttl" 86400
+                                        "description" "new description"}})})]
+        (let [result (sys.mounts/read-mount-configuration client "ldap")
+              req (last-request calls)]
+          (is (= :get (:method req)))
+          (is (str/ends-with? (request-path req) "/sys/mounts/ldap/tune"))
+          (is (= 1800 (:default-lease-ttl result)))
+          (is (= 86400 (:max-lease-ttl result)))
+          (is (= "new description" (:description result)))))))
+  (testing "tune-mount-configuration!"
+    (let [calls (atom [])
+          client (test-client)]
+      (with-redefs [http-client/request
+                    (mock-request calls {:status 204 :body ""})]
+        (let [result (sys.mounts/tune-mount-configuration!
+                       client
+                       "ldap"
+                       {:default-lease-ttl 1800
+                        :max-lease-ttl 86400
+                        :description "new description"})
+              req (last-request calls)
+              body (request-body req)]
+          (is (nil? result))
+          (is (= :post (:method req)))
+          (is (str/ends-with? (request-path req) "/sys/mounts/ldap/tune"))
+          (is (= 1800 (get body "default_lease_ttl")))
+          (is (= 86400 (get body "max_lease_ttl")))
+          (is (= "new description" (get body "description")))))))
+  (testing "http errors"
+    (let [client (test-client)
+          error-response {:status 400
+                          :body (json/write-str {"errors" ["bad request"]})}]
+      (with-redefs [http-client/request (mock-request (atom []) error-response)]
+        (is (thrown? Exception (sys.mounts/list-mounts client)))
+        (is (thrown? Exception
+              (sys.mounts/enable-secrets! client "ldap" {:type "openldap"})))
+        (is (thrown? Exception (sys.mounts/disable-secrets! client "ldap")))
+        (is (thrown? Exception
+              (sys.mounts/read-secrets-configuration client "ldap")))
+        (is (thrown? Exception
+              (sys.mounts/read-mount-configuration client "ldap")))
+        (is (thrown? Exception
+              (sys.mounts/tune-mount-configuration!
+                client "ldap" {:default-lease-ttl 1800})))))))
+
+
+(deftest ^:integration http-api
+  (with-dev-server
+    (testing "list-mounts"
+      (let [result (sys.mounts/list-mounts client)
+            cubbyhole (get result "cubbyhole/")]
+        (is (= #{"cubbyhole/" "identity/" "secret/" "sys/"}
+               (set (keys result))))
+        (is (map? cubbyhole))
+        (is (= "cubbyhole" (:type cubbyhole)))
+        (is (string? (:uuid cubbyhole)))
+        (is (string? (:description cubbyhole)))))
+    (testing "enable-secrets!"
+      (let [result (sys.mounts/enable-secrets!
+                     client
+                     "ldap"
+                     {:type "openldap"
+                      :description "LDAP secret storage"
+                      :config {:default-lease-ttl "6m"}})
+            ldap (get (sys.mounts/list-mounts client) "ldap/")]
+        (is (nil? result))
+        (is (map? ldap))
+        (is (= "openldap" (:type ldap)))
+        (is (= "LDAP secret storage" (:description ldap)))
+        (is (= 360 (get-in ldap [:config :default-lease-ttl])))))
+    (testing "read-secrets-configuration"
+      (let [result (sys.mounts/read-secrets-configuration client "ldap")]
+        (is (= "openldap" (:type result)))
+        (is (= "LDAP secret storage" (:description result)))
+        (is (= 360 (get-in result [:config :default-lease-ttl])))))
+    (testing "tune-mount-configuration"
+      (is (nil? (sys.mounts/tune-mount-configuration!
+                  client
+                  "ldap"
+                  {:default-lease-ttl 1800
+                   :max-lease-ttl 86400
+                   :description "new description"})))
+      (let [result (sys.mounts/read-mount-configuration client "ldap")]
+        (is (= 1800 (:default-lease-ttl result)))
+        (is (= 86400 (:max-lease-ttl result)))
+        (is (= "new description" (:description result)))))
+    (testing "disable-secrets!"
+      (is (nil? (sys.mounts/disable-secrets! client "ldap")))
+      (let [result (sys.mounts/list-mounts client)]
+        (is (= #{"cubbyhole/" "identity/" "secret/" "sys/"}
+               (set (keys result))))))))
