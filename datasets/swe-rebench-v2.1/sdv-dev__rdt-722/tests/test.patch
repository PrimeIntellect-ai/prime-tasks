+    def test___init__deprecated_distributions_warning(self):
+        """Deprecated distribution names warn and behave like their replacements."""
+        data = pd.DataFrame({'value': np.linspace(0.1, 0.9, 20)})
+        dists = [
+            ('gaussian', 'norm', univariate.GaussianUnivariate),
+            ('student_t', 't', univariate.StudentTUnivariate),
+            ('truncated_gaussian', 'truncnorm', univariate.TruncatedGaussian),
+        ]
+        for deprecated, current, expected_distribution in dists:
+            if deprecated == 'gaussian':
+                err_msg = re.escape(
+                    "Future versions of RDT will not support 'gaussian' as an option. "
+                    "Please use 'norm' instead."
+                )
+                warning_context = pytest.warns(FutureWarning, match=err_msg)
+            else:
+                warning_context = pytest.warns(FutureWarning)
+
+            with warning_context:
+                transformer = GaussianNormalizer(distribution=deprecated)
+
+            expected = GaussianNormalizer(distribution=expected_distribution)
+            transformer.fit(data, 'value')
+            expected.fit(data, 'value')
+            np.testing.assert_allclose(
+                transformer.transform(data).to_numpy(), expected.transform(data).to_numpy()
+            )
+
+    @pytest.mark.parametrize('name,distribution', [
+        ('norm', univariate.GaussianUnivariate),
+        ('truncnorm', univariate.TruncatedGaussian),
+        ('t', univariate.StudentTUnivariate),
+        ('gamma', univariate.GammaUnivariate),
+        ('beta', univariate.BetaUnivariate),
+        ('gaussian_kde', univariate.GaussianKDE),
+    ])
+    def test___init__distribution_names_select_the_expected_distribution(self, name, distribution):
+        """Names accepted by the constructor select the corresponding distribution."""
+        data = pd.DataFrame({'value': np.linspace(0.1, 0.9, 20)})
+        transformer = GaussianNormalizer(distribution=name)
+        expected = GaussianNormalizer(distribution=distribution)
+        transformer.fit(data, 'value')
+        expected.fit(data, 'value')
+
+        np.testing.assert_allclose(
+            transformer.transform(data).to_numpy(), expected.transform(data).to_numpy()
+        )
+
