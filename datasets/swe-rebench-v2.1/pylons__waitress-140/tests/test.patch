+    def test_ipv6_socket_options_when_undefined(self):
+        # Regression test for platforms where ``socket.IPPROTO_IPV6`` is
+        # not defined. Setting up an IPv6 server must not fail because of that.
+        if not self._hasIPv6():
+            return
+
+        from waitress.server import create_server
+
+        saved = {}
+        for name in ('IPPROTO_IPV6',):
+            if hasattr(socket, name):
+                saved[name] = getattr(socket, name)
+                delattr(socket, name)
+        try:
+            server = create_server(
+                object(),
+                listen='[::1]:0',
+                ipv4=False,
+                ipv6=True,
+                _start=False,
+            )
+            server.close()
+        finally:
+            for name, value in saved.items():
+                setattr(socket, name, value)
+
     def test_bad_port(self):
         self.assertRaises(ValueError, self._makeOne, listen='127.0.0.1:test')
 
