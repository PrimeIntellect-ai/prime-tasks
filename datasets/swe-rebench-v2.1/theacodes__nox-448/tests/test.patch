+    @pytest.mark.parametrize(
+        ("backend", "expected_command"),
+        [("conda", "conda"), ("mamba", "mamba")],
+    )
+    def test_selected_conda_backend_is_used_for_install(
+        self, backend, expected_command
+    ):
+        runner = self.make_runner()
+        runner.func.venv_backend = backend
+        runner.func.venv_params = []
+        runner.func.side_effect = lambda session: session.conda_install(
+            "requests", auto_offline=False
+        )
+
+        with mock.patch("shutil.which", return_value="/usr/bin/mamba"):
+            with mock.patch.object(nox.command, "run") as run:
+                runner.execute()
+
+        assert any(
+            Path(call.args[0][0]).name == expected_command
+            and call.args[0][1] == "install"
+            for call in run.call_args_list
+            if call.args
+        )
+
