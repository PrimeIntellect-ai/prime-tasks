+    #[test]
+    fn test_colour_row_nested_table_cli() {
+        use std::io::Write;
+        use std::process::{Command, Stdio};
+
+        let input = br#"<head><style>
+        tr.r { color: #f00; }
+        .hidden { display: none; }
+        </style></head><body>
+        <table>
+         <tr class="r">
+           <td>
+             <table>
+               <tr><td>Hey there!</td></tr>
+               <tr><td class="hidden">Do not show this</td></tr>
+             </table>
+           </td>
+         </tr>
+        </table>
+        "#;
+        let test_binary = std::env::current_exe().unwrap();
+        let cli = test_binary
+            .parent()
+            .unwrap()
+            .parent()
+            .unwrap()
+            .join("examples")
+            .join("html2text");
+        let mut child = Command::new(cli)
+            .args(["--width", "80", "--wrap-width", "80", "--colour", "--css", "--ignore-css-colour"])
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .expect("could not start html2text example");
+        child.stdin.take().unwrap().write_all(input).unwrap();
+        let output = child.wait_with_output().unwrap();
+        assert!(output.status.success(), "html2text failed: {:?}", output.stderr);
+        let rendered = String::from_utf8(output.stdout).unwrap();
+        assert!(rendered.contains("Hey there!"), "nested table text was missing: {rendered:?}");
+        assert!(!rendered.contains("Do not show this"), "CSS-hidden text was rendered: {rendered:?}");
+    }
+
 }
