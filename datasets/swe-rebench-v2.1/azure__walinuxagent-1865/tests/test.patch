+class TestUbuntuDhcpClientDetection(AgentTestCase):
+    """
+    On Ubuntu 18.04 through 20.04 the DHCP client may be systemd-networkd, so the OS util returned by the factory
+    must report its process id when it is running.
+    """
+    def setUp(self):
+        AgentTestCase.setUp(self)
+
+    def tearDown(self):
+        AgentTestCase.tearDown(self)
+
+    def test_get_dhcp_pid_should_return_systemd_networkd_pid_on_ubuntu_19_10(self):
+        def fake_run_command(command, *args, **kwargs):
+            if "systemd-networkd" in command:
+                return "4242\n"
+            raise CommandError(command=command, returncode=1, stdout="", stderr="")
+
+        osutil = _get_osutil(distro_name="ubuntu",
+                             distro_code_name="eoan",
+                             distro_version="19.10",
+                             distro_full_name="")
+
+        with patch("azurelinuxagent.common.utils.shellutil.run_command", side_effect=fake_run_command):
+            pids = osutil.get_dhcp_pid()
+
+        self.assertIn(4242, pids)
