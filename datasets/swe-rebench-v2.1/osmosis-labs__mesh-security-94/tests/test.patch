+#[test]
+fn stake_locked() {
+    let users = ["user1"];
+
+    let app = MtApp::new(|router, _api, storage| {
+        router
+            .bank
+            .init_balance(storage, &Addr::unchecked(users[0]), coins(300, OSMO))
+            .unwrap();
+    });
+    let app = App::new(app);
+
+    let owner = "owner";
+    let validators = ["validator1"];
+
+    let (vault, contract) = setup(&app, owner, 100).unwrap();
+
+    // set these validators to be active
+    for val in validators {
+        let activate = AddValidator::mock(val);
+        contract
+            .test_set_active_validator(activate)
+            .call("test")
+            .unwrap();
+    }
+
+    // Bond tokens
+    vault
+        .bond()
+        .with_funds(&coins(300, OSMO))
+        .call(users[0])
+        .unwrap();
+
+    // Stake remotely. This write-locks the stake until the pending tx is committed.
+    vault
+        .stake_remote(
+            contract.contract_addr.to_string(),
+            coin(100, OSMO),
+            to_binary(&ReceiveVirtualStake {
+                validator: validators[0].to_string(),
+            })
+            .unwrap(),
+        )
+        .call(users[0])
+        .unwrap();
+
+    // While the tx is pending the stake is locked, and querying it reports the
+    // locked state instead of failing.
+    let stake = contract
+        .stake(users[0].to_owned(), validators[0].to_owned())
+        .unwrap();
+    assert_eq!(stake, MaybeStake::Locked {});
+
+    let stakes = contract.stakes(users[0].to_owned(), None, None).unwrap();
+    assert_eq!(
+        stakes.stakes,
+        [StakeInfo {
+            owner: users[0].to_owned(),
+            validator: validators[0].to_owned(),
+            stake: MaybeStake::Locked {},
+        }]
+    );
+
+    // Commit the pending tx, the stake becomes queryable again.
+    contract
+        .test_commit_stake(get_last_external_staking_pending_tx_id(&contract).unwrap())
+        .call("test")
+        .unwrap();
+
+    let stake = contract
+        .stake(users[0].to_owned(), validators[0].to_owned())
+        .unwrap()
+        .unwrap();
+    assert_eq!(stake.stake.u128(), 100);
+}
+
 #[track_caller]
 fn get_last_external_staking_pending_tx_id(contract: &ExternalStakingContractProxy) -> Option<u64> {
     let txs = contract.all_pending_txs_desc(None, None).unwrap().txs;
