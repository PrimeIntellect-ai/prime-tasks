+import MemoryStream = require("memorystream");
+import { PinoLogger } from "../src";
+import { __resetOutOfContextForTests } from "../src/PinoLogger";
+
+const waitFor = async (read: () => string, text: string) => {
+  for (let i = 0; i < 100 && !read().includes(text); i++) {
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+};
+
+describe("getting the logger instance", () => {
+  beforeEach(() => __resetOutOfContextForTests());
+
+  it("is readable directly from a PinoLogger instance and writes through the same logger", async () => {
+    const stream = new MemoryStream();
+    let logs = "";
+    stream.on("data", (chunk: string) => {
+      logs += chunk.toString();
+    });
+
+    const logger = new PinoLogger({ pinoHttp: [{}, stream] });
+    const nativeLogger = logger.logger;
+
+    nativeLogger.info("written through exposed logger");
+    await waitFor(() => logs, "written through exposed logger");
+    expect(logs).toContain("written through exposed logger");
+
+    nativeLogger.level = "silent";
+    logger.info("written through PinoLogger");
+    await new Promise(resolve => setTimeout(resolve, 50));
+    expect(logs).not.toContain("written through PinoLogger");
+  });
+
+  it("can be used as a native pino logger, including child()", async () => {
+    const stream = new MemoryStream();
+    let logs = "";
+    stream.on("data", (chunk: string) => {
+      logs += chunk.toString();
+    });
+
+    const logger = new PinoLogger({ pinoHttp: [{}, stream] });
+    const child = logger.logger.child({ module: "billing" });
+
+    child.info("written through child");
+    await waitFor(() => logs, "written through child");
+
+    const line = logs
+      .split("\n")
+      .filter(l => l.includes("written through child"))
+      .map(l => JSON.parse(l))[0];
+    expect(line).toBeDefined();
+    expect(line.module).toBe("billing");
+  });
+});
