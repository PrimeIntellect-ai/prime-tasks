 use darling::ast;
 use darling::FromDeriveInput;
 
+/// Collects the location path of every individual error in `err`.
+///
+/// The path is the part of the rendered error that follows the message,
+/// e.g. `schedule/tuesday/morning` in
+/// ``Unknown literal value `yes` at schedule/tuesday/morning``.
+fn error_paths(err: ::darling::Error) -> Vec<String> {
+    err.into_iter()
+        .map(|e| {
+            let rendered = e.to_string();
+            match rendered.find(" at ") {
+                Some(idx) => rendered[idx + " at ".len()..].to_string(),
+                None => String::new(),
+            }
+        })
+        .collect()
+}
