+fn test_definition_list_html(input: &str, expected: &str) {
+    assert_eq!(normalize_tag_spacing(expected), normalize_tag_spacing(&definition_list_html(input)));
+}
+
+fn test_definition_list_exact_html(input: &str, expected: &str) {
+    assert_eq!(expected, definition_list_html(input));
+}
+
+fn definition_list_html(input: &str) -> String {
+    use pulldown_cmark::{Options, Parser};
+
+    let mut options = Options::empty();
+    options.insert(Options::ENABLE_MATH);
+    options.insert(Options::ENABLE_TABLES);
+    options.insert(Options::ENABLE_STRIKETHROUGH);
+    options.insert(Options::ENABLE_TASKLISTS);
+    options.insert(Options::ENABLE_GFM);
+    options.insert(Options::ENABLE_FOOTNOTES);
+    options.insert(Options::ENABLE_HEADING_ATTRIBUTES);
+    options.insert(Options::ENABLE_DEFINITION_LIST);
+
+    let mut actual = String::new();
+    pulldown_cmark::html::push_html(&mut actual, Parser::new_ext(input, options));
+    actual
+}
+
+fn normalize_tag_spacing(html: &str) -> String {
+    let html = html.replace("<br>", "<br />").replace("<br/>", "<br />");
+    let chars: Vec<char> = html.chars().collect();
+    let mut normalized = String::with_capacity(html.len());
+    let mut i = 0;
+    while i < chars.len() {
+        if chars[i].is_whitespace() && normalized.ends_with('>') {
+            let mut next = i;
+            while next < chars.len() && chars[next].is_whitespace() {
+                next += 1;
+            }
+            if next < chars.len() && chars[next] == '<' {
+                i = next;
+                continue;
+            }
+        }
+        normalized.push(chars[i]);
+        i += 1;
+    }
+    normalized
+}
