+class ModelWithFixedAndUserParameters(mesa.Model):
+    def __init__(self, required_setting, width=10, height=10, seed=None):
+        super().__init__(seed=seed)
+        self.required_setting = required_setting
+        self.width = width
+        self.height = height
+        self.user_seed = seed
+
+
+def test_model_creator_accepts_required_fixed_parameters():
+    model = ModelWithFixedAndUserParameters("configured", width=20, height=20)
+    reactive_model = solara.reactive(model)
+    model_params = {
+        "required_setting": "configured",
+        "width": {"type": "SliderInt", "value": 10, "min": 1, "max": 30},
+    }
+
+    solara.render(ModelCreator(reactive_model, model_params), handle_error=False)
+
+    assert reactive_model.value is model
+    assert reactive_model.value.required_setting == "configured"
+
+    displayed_models = []
+
+    def show_model(displayed_model):
+        displayed_models.append(displayed_model)
+        return solara.Text(str(displayed_model.required_setting))
+
+    solara.render(
+        SolaraViz(model, components=[show_model], model_params=model_params)
+    )
+    assert displayed_models[-1] is model
+
+
+def test_model_creator_keeps_supplied_model_configuration():
+    model = ModelWithFixedAndUserParameters("configured", width=20, height=20)
+    reactive_model = solara.reactive(model)
+    model_params = {
+        "required_setting": "configured",
+        "width": {"type": "SliderInt", "value": 10, "min": 1, "max": 30},
+        "height": {"type": "SliderInt", "value": 10, "min": 1, "max": 30},
+    }
+
+    solara.render(ModelCreator(reactive_model, model_params), handle_error=False)
+
+    assert reactive_model.value is model
+    assert (reactive_model.value.width, reactive_model.value.height) == (20, 20)
+
+    displayed_models = []
+
+    def show_model(displayed_model):
+        displayed_models.append(displayed_model)
+        return solara.Text(f"{displayed_model.width}x{displayed_model.height}")
+
+    solara.render(
+        SolaraViz(model, components=[show_model], model_params=model_params)
+    )
+
+    assert displayed_models[-1] is model
+    assert (displayed_models[-1].width, displayed_models[-1].height) == (20, 20)
+
+
+def test_seed_is_available_as_an_ordinary_model_parameter():
+    model = ModelWithFixedAndUserParameters("configured", seed=23)
+    reactive_model = solara.reactive(model)
+    model_params = {
+        "required_setting": "configured",
+        "seed": {"type": "SliderInt", "value": 5, "min": 0, "max": 30},
+    }
+
+    _, render_context = solara.render(
+        ModelCreator(reactive_model, model_params), handle_error=False
+    )
+
+    seed_control = render_context.find(vw.Slider).widget
+    assert seed_control.v_model == 5
+
+    seed_control.v_model = 17
+    assert reactive_model.value.user_seed == 17
