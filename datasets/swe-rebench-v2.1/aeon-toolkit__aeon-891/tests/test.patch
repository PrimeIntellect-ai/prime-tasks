+def test_rdst_transformer_unequal_length():
+    """Test the RDST transformer supports unequal length series."""
+    X, y = make_unequal_length_test_data(
+        n_cases=10,
+        n_channels=1,
+        min_series_length=20,
+        max_series_length=30,
+        n_labels=2,
+        random_state=0,
+    )
+    transformer = RandomDilatedShapeletTransform(
+        max_shapelets=10, shapelet_lengths=[20], random_state=0
+    )
+    X_t = transformer.fit_transform(X, y)
+    assert X_t.shape[0] == len(X)
+
+
+@pytest.mark.parametrize("shapelet_length", [5, 11, 20])
+def test_rdst_max_shapelet_length_fitted(shapelet_length):
+    """Test max_shapelet_length_ reflects the fitted shapelets, not a constant.
+
+    With a single fixed shapelet length L, the fitted maximum must be the temporal
+    extent of some shapelet with dilation d >= 1, and cannot exceed the shortest
+    training series.
+    """
+    X, y = make_unequal_length_test_data(
+        n_cases=10,
+        n_channels=1,
+        min_series_length=20,
+        max_series_length=30,
+        n_labels=2,
+        random_state=0,
+    )
+    transformer = RandomDilatedShapeletTransform(
+        max_shapelets=10, shapelet_lengths=[shapelet_length], random_state=0
+    )
+    transformer.fit(X, y)
+    max_len = transformer.max_shapelet_length_
+    min_series_len = min(x.shape[-1] for x in X)
+    assert 1 <= max_len <= min_series_len
+    # Accept the usual conventions for the extent of a dilated shapelet.
+    extents = set()
+    for dilation in range(1, min_series_len + 1):
+        extents.add((shapelet_length - 1) * dilation)
+        extents.add((shapelet_length - 1) * dilation + 1)
+        extents.add(shapelet_length * dilation)
+    assert max_len in extents
+
+
+def test_rdst_classifier_unequal_length():
+    """Test the RDST classifier supports unequal length series."""
+    X, y = make_unequal_length_test_data(
+        n_cases=10,
+        n_channels=1,
+        min_series_length=20,
+        max_series_length=30,
+        n_labels=2,
+        random_state=0,
+    )
+    classifier = RDSTClassifier(max_shapelets=10, random_state=0)
+    classifier.fit(X, y)
+    y_pred = classifier.predict(X)
+    assert len(y_pred) == len(X)
+    y_proba = classifier.predict_proba(X)
+    assert y_proba.shape[0] == len(X)
