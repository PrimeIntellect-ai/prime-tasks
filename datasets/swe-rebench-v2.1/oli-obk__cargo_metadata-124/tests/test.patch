+#[test]
+fn target_test_field() {
+    // The `test` field reflects whether the target is tested by default by
+    // `cargo test`. Examples are not tested by default, while binaries and
+    // libraries are. When the field is absent (Cargo older than 1.47) it
+    // defaults to `true`.
+    let json = r#"
+{
+  "packages": [
+    {
+      "name": "foo",
+      "version": "0.1.0",
+      "id": "foo 0.1.0 (path+file:///foo)",
+      "license": null,
+      "license_file": null,
+      "description": null,
+      "source": null,
+      "dependencies": [],
+      "targets": [
+        {
+          "kind": ["example"],
+          "crate_types": ["bin"],
+          "name": "ex1",
+          "src_path": "/foo/examples/ex1.rs",
+          "test": false
+        },
+        {
+          "kind": ["bin"],
+          "crate_types": ["bin"],
+          "name": "foo",
+          "src_path": "/foo/src/main.rs",
+          "test": true
+        },
+        {
+          "kind": ["lib"],
+          "crate_types": ["lib"],
+          "name": "foo",
+          "src_path": "/foo/src/lib.rs"
+        }
+      ],
+      "features": {},
+      "manifest_path": "/foo/Cargo.toml"
+    }
+  ],
+  "workspace_members": ["foo 0.1.0 (path+file:///foo)"],
+  "resolve": null,
+  "target_directory": "/foo/target",
+  "version": 1,
+  "workspace_root": "/foo"
+}
+"#;
+    let meta: Metadata = serde_json::from_str(json).unwrap();
+    let targets = &meta.packages[0].targets;
+    assert_eq!(targets.len(), 3);
+    assert_eq!(targets[0].test, false);
+    assert_eq!(targets[1].test, true);
+    assert_eq!(targets[2].test, true);
+}
+
