@@ -0,0 +1,19 @@
+import boto3
+
+from moto import mock_ec2
+
+
+@mock_ec2
+def test_allocate_hosts_returns_one_host_id_per_requested_host():
+    client = boto3.client("ec2", "us-west-1")
+    quantity = 3
+
+    response = client.allocate_hosts(
+        AvailabilityZone="us-west-1a",
+        InstanceType="t3a.nano",
+        Quantity=quantity,
+    )
+
+    assert isinstance(response["HostIds"], list)
+    assert len(response["HostIds"]) == quantity
+    assert len(set(response["HostIds"])) == quantity
