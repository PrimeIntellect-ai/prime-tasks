+def test_raise_error_with_builtin_function_as_task():
+    """Builtin functions cannot be wrapped with the task decorator.
+
+    See https://github.com/pytask-dev/pytask/issues/512.
+    """
+    import re
+    from datetime import datetime
+    from pathlib import Path
+
+    from pytask import task
+
+    msg = (
+        "Builtin functions cannot be wrapped with '@task'. If necessary, wrap the "
+        "builtin function in a function or lambda expression."
+    )
+
+    with pytest.raises(NotImplementedError, match=re.escape(msg)):
+        task(kwargs={"format": "%y/%m/%d"}, produces=Path("time.txt"))(
+            datetime.utcnow().strftime
+        )
+
+
+def test_raise_error_with_builtin_function_as_task_end_to_end(runner, tmp_path):
+    source = """
+    from pytask import task
+    from pathlib import Path
+    from datetime import datetime
+
+    task(
+        kwargs={"format": "%y/%m/%d"}, produces=Path("time.txt")
+    )(datetime.utcnow().strftime)
+    """
+    tmp_path.joinpath("task_example.py").write_text(textwrap.dedent(source))
+
+    result = runner.invoke(cli, [tmp_path.as_posix()])
+    assert "NotImplementedError" in result.output
+    assert "Builtin functions cannot be wrapped with '@task'" in result.output
