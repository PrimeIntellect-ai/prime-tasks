+
+test('bot activity around stale labeling does not remove the stale label', async () => {
+  const staleMarkedAt = '2022-09-09T13:00:00Z';
+  const opts: IIssuesProcessorOptions = {
+    ...DefaultProcessorOptions,
+    removeStaleWhenUpdated: true,
+    daysBeforeClose: 10000
+  };
+  github.context.actor = 'stale-bot';
+  const TestIssueList: Issue[] = [
+    generateIssue(
+      opts,
+      1,
+      'An issue that should remain stale',
+      '2022-09-09T13:00:01Z',
+      '2020-01-01T17:00:00Z',
+      false,
+      ['Stale']
+    )
+  ];
+  const processor = new IssuesProcessorMock(
+    opts,
+    async p => (p === 1 ? TestIssueList : []),
+    async () => [
+      {
+        user: {login: 'stale-bot', type: 'Bot'},
+        body: 'This issue is stale'
+      }
+    ],
+    async () => staleMarkedAt
+  );
+
+  await processor.processIssues(1);
+
+  expect(processor.removedLabelIssues).toHaveLength(0);
+});
