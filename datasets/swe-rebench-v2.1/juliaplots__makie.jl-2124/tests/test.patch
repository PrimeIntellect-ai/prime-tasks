+@testset "empty poly" begin
+    # Plotting an empty list of polygons must not fail. Previously this threw a
+    # MethodError (e.g. `to_vertices(::Vector{Any})` / `merge(::Vector{Any})`)
+    # for empty input.
+    fig = Figure()
+    ax = Axis(fig[1, 1])
+    @test (poly!(ax, Vector{Point2f}[]); true)
+    @test (poly!(ax, Rect2f[]); true)
+    @test (poly(Vector{Point2f}[]); true)
+    @test (poly(Rect2f[]); true)
+end
