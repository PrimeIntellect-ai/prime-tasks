diff --git a/tests/testthat/test-app.R b/tests/testthat/test-app.R
index 99fdbde..d7ce3d0 100644
--- a/tests/testthat/test-app.R
+++ b/tests/testthat/test-app.R
@@ -15,3 +15,74 @@ test_that("configure_logger() works with missing config fields", {
   )
   expect_silent(configure_logger())
 })
+
+test_that("with_head_tags() wraps a static UI together with the head resources", {
+  ui <- shiny::tags$div("test")
+  wrapped <- with_head_tags(ui)
+  expect_s3_class(wrapped, "shiny.tag.list")
+  html <- htmltools::doRenderTags(wrapped)
+  expect_match(html, "<head>", fixed = TRUE)
+  expect_match(html, "app.min.js", fixed = TRUE)
+  expect_match(html, "app.min.css", fixed = TRUE)
+  expect_match(html, "favicon.ico", fixed = TRUE)
+  expect_match(html, "test", fixed = TRUE)
+})
+
+test_that("with_head_tags() preserves the formals of a function UI without parameters", {
+  ui <- function() shiny::tags$div("test")
+  wrapped <- with_head_tags(ui)
+  expect_identical(formals(wrapped), formals(ui))
+})
+
+test_that("with_head_tags() preserves the formals of a function UI with a request parameter", {
+  ui <- function(request) shiny::tags$div("test")
+  wrapped <- with_head_tags(ui)
+  expect_identical(formals(wrapped), formals(ui))
+})
+
+test_that("with_head_tags() wrapper produces the head-wrapped UI when invoked", {
+  ui <- function() shiny::tags$div("test")
+  wrapped <- with_head_tags(ui)
+  html <- htmltools::doRenderTags(wrapped())
+  expect_match(html, "<head>", fixed = TRUE)
+  expect_match(html, "app.min.js", fixed = TRUE)
+  expect_match(html, "app.min.css", fixed = TRUE)
+  expect_match(html, "favicon.ico", fixed = TRUE)
+  expect_match(html, "test", fixed = TRUE)
+})
+
+test_that("with_head_tags() wrapper accepts the request argument", {
+  ui <- function(request) shiny::tags$div("test")
+  wrapped <- with_head_tags(ui)
+  html <- htmltools::doRenderTags(wrapped(list()))
+  expect_match(html, "<head>", fixed = TRUE)
+  expect_match(html, "app.min.js", fixed = TRUE)
+  expect_match(html, "test", fixed = TRUE)
+})
+
+test_that("a how-to guide documents how to use shinymanager", {
+  vignettes <- list.files(
+    file.path(pkgload::pkg_path(), "vignettes"),
+    pattern = "\\.(Rmd|rmd|qmd|Qmd|md|R|txt)$",
+    recursive = TRUE,
+    full.names = TRUE
+  )
+  contents <- vapply(
+    vignettes,
+    function(path) paste(readLines(path, warn = FALSE), collapse = "\n"),
+    character(1)
+  )
+  expect_true(any(grepl("shinymanager", contents, fixed = TRUE)))
+})
+
+test_that("with_head_tags() wraps a plain list UI together with the head resources", {
+  ui <- list(shiny::tags$div("test"))
+  wrapped <- with_head_tags(ui)
+  expect_s3_class(wrapped, "shiny.tag.list")
+  html <- htmltools::doRenderTags(wrapped)
+  expect_match(html, "<head>", fixed = TRUE)
+  expect_match(html, "app.min.js", fixed = TRUE)
+  expect_match(html, "app.min.css", fixed = TRUE)
+  expect_match(html, "favicon.ico", fixed = TRUE)
+  expect_match(html, "test", fixed = TRUE)
+})
