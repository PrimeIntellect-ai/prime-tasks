+#[test]
+fn test_magical_variable_dumps_context() {
+    let mut tera = Tera::default();
+    tera.add_template("context", &read_file("tests/templates/magical_variable.html")).unwrap();
+
+    let mut context = Context::new();
+    context.add("username", &"bob");
+    context.add("number_reviews", &2);
+    let expected = context.as_json();
+
+    let rendered = tera.render("context", context).unwrap();
+    assert!(rendered.contains('\n'), "context JSON should be pretty-printed");
+    let parsed: tera::Value = serde_json::from_str(&rendered).unwrap();
+    assert_eq!(parsed, expected);
+}
