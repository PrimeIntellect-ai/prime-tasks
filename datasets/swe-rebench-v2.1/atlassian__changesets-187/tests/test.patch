+
+describe("empty flag at the CLI boundary", () => {
+  const cliPath = path.resolve(__dirname, "../../../../bin.js");
+
+  const runCli = (args: Array<string>, cwd: string) =>
+    spawnSync(process.execPath, [cliPath, ...args], {
+      cwd,
+      encoding: "utf-8",
+      timeout: 30000
+    });
+
+  const readChangesets = (cwd: string) => {
+    const changesetDir = path.join(cwd, ".changeset");
+    return fs
+      .readdirSync(changesetDir)
+      .filter(file => file.endsWith(".md") && file !== "README.md")
+      .map(file =>
+        parse(fs.readFileSync(path.join(changesetDir, file), "utf-8"))
+      );
+  };
+
+  it("creates an empty changeset when `changeset --empty` is run", async () => {
+    const cwd = await copyFixtureIntoTempDir(__dirname, "simple-project");
+
+    const result = runCli(["--empty"], cwd);
+
+    expect(result.status).toBe(0);
+    expect(readChangesets(cwd)).toEqual([{ releases: [], summary: "" }]);
+  });
+
+  it("creates an empty changeset when `changeset add --empty` is run", async () => {
+    const cwd = await copyFixtureIntoTempDir(__dirname, "simple-project");
+
+    const result = runCli(["add", "--empty"], cwd);
+
+    expect(result.status).toBe(0);
+    expect(readChangesets(cwd)).toEqual([{ releases: [], summary: "" }]);
+  });
+});
