+describe('Try It Out default base URL', () => {
+  async function renderTryItRequest({ spec, themeConfig, operationId }: {
+    spec: any
+    themeConfig?: any
+    operationId: string
+  }) {
+    const openapi = createOpenApiInstance({ spec })
+    useTheme(themeConfig ?? {})
+
+    let requestUrl: string | undefined
+
+    try {
+      const app = createSSRApp({
+        render() {
+          return h(OAPath, { id: operationId, openapi }, {
+            'try-it': (slotProps: any) => {
+              requestUrl = slotProps.request.url
+              return h('div')
+            },
+          })
+        },
+      })
+
+      await renderToString(app)
+    }
+    finally {
+      useTheme().reset()
+    }
+
+    return requestUrl
+  }
+
+  it('uses the configured default URL for the Try It Out request when the specification has no servers', async () => {
+    const requestUrl = await renderTryItRequest({
+      spec: {
+        openapi: '3.0.0',
+        paths: {
+          '/things': {
+            get: { operationId: 'getThings' },
+          },
+        },
+      },
+      themeConfig: {
+        operation: {
+          defaultBaseUrl: 'https://app.local:8080',
+        },
+      },
+      operationId: 'getThings',
+    })
+
+    expect(new URL(requestUrl!).origin).toBe('https://app.local:8080')
+  })
+})
