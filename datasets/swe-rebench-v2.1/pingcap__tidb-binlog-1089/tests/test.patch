+// TestPBBinlogToTxnCreateView verifies that CREATE VIEW statements are
+// accepted by the binlog execution path instead of being rejected as an
+// unknown/invalid DDL type.
+func (s *testTranslateSuite) TestPBBinlogToTxnCreateView(c *check.C) {
+	tests := []struct {
+		ddl      string
+		database string
+		table    string
+	}{
+		{"create view `db1`.`view1` as (select 1)", "db1", "view1"},
+		{"use db1; create view view1 as (select 1)", "db1", "view1"},
+	}
+
+	for _, test := range tests {
+		binlog := &pb.Binlog{
+			Tp:       pb.BinlogType_DDL,
+			DdlQuery: []byte(test.ddl),
+		}
+
+		txn, err := pbBinlogToTxn(binlog)
+		c.Assert(err, check.IsNil, check.Commentf("ddl: %s", test.ddl))
+		c.Assert(txn, check.NotNil, check.Commentf("ddl: %s", test.ddl))
+		c.Assert(txn.DDL, check.NotNil, check.Commentf("ddl: %s", test.ddl))
+		c.Assert(txn.DDL.Database, check.Equals, test.database, check.Commentf("ddl: %s", test.ddl))
+		c.Assert(txn.DDL.Table, check.Equals, test.table, check.Commentf("ddl: %s", test.ddl))
+	}
+}
