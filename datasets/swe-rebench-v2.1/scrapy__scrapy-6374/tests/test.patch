+class PracticesDocsTestCase(unittest.TestCase):
+    """The CrawlerProcess/CrawlerRunner examples must not import the reactor
+    before it has been installed, otherwise a non-default reactor configured
+    through settings cannot be used."""
+
+    docs_path = Path(__file__).parent.parent / "docs" / "topics" / "practices.rst"
+
+    @staticmethod
+    def _python_code_blocks(text):
+        lines = text.splitlines()
+        blocks = []
+        i = 0
+        while i < len(lines):
+            if lines[i].strip().startswith(".. code-block:: python"):
+                i += 1
+                while i < len(lines) and not lines[i].strip():
+                    i += 1
+                block = []
+                while i < len(lines):
+                    line = lines[i]
+                    if line.strip() and not line.startswith("    "):
+                        break
+                    block.append(line)
+                    i += 1
+                blocks.append(block)
+            else:
+                i += 1
+        return blocks
+
+    def test_no_toplevel_reactor_import(self):
+        text = self.docs_path.read_text(encoding="utf-8")
+        blocks = self._python_code_blocks(text)
+        self.assertTrue(blocks)
+        reactor_install = re.compile(
+            r"\b(install_reactor|CrawlerRunner|CrawlerProcess)\s*\("
+        )
+        for block in blocks:
+            block_text = "\n".join(block)
+            if "CrawlerRunner" not in block_text and "CrawlerProcess" not in block_text:
+                continue
+            tree = ast.parse(textwrap.dedent(block_text))
+            module_reactor_imports = [
+                node
+                for node in tree.body
+                if (
+                    isinstance(node, ast.ImportFrom)
+                    and node.module == "twisted.internet"
+                    and any(alias.name == "reactor" for alias in node.names)
+                )
+                or (
+                    isinstance(node, ast.Import)
+                    and any(
+                        alias.name == "twisted.internet.reactor"
+                        for alias in node.names
+                    )
+                )
+            ]
+            if not module_reactor_imports:
+                continue
+            install_index = next(
+                (i for i, line in enumerate(block) if reactor_install.search(line)),
+                None,
+            )
+            self.assertIsNotNone(
+                install_index,
+                "the reactor is imported without a runner or reactor setup",
+            )
+            for node in module_reactor_imports:
+                self.assertLess(
+                    install_index,
+                    node.lineno - 1,
+                    "the reactor must not be imported before runner setup",
+                )
