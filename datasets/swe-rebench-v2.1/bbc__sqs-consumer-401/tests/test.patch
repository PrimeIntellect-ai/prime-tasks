+
+  describe('logger', () => {
+    const enableDebugCapture = () => {
+      const debugLib = require('debug');
+      const stderrWrite = sandbox.stub(process.stderr, 'write');
+      debugLib.enable('sqs-consumer');
+      return {
+        output: () =>
+          stderrWrite
+            .getCalls()
+            .map((call) => String(call.args[0]))
+            .join(''),
+        count: () => stderrWrite.getCalls().length,
+        restore: () => debugLib.disable()
+      };
+    };
+
+    it('logs a debug message whenever an event is emitted', () => {
+      const capture = enableDebugCapture();
+      try {
+        const events = [
+          'started',
+          'stopped',
+          'empty',
+          'aborted',
+          'response_processed'
+        ];
+        events.forEach((event) => consumer.emit(event));
+
+        const output = capture.output();
+        events.forEach((event) => {
+          assert.include(
+            output,
+            event,
+            `expected a debug message to be logged when '${event}' was emitted`
+          );
+        });
+      } finally {
+        capture.restore();
+      }
+    });
+
+    it('logs a debug message periodically while the handler is processing', async () => {
+      const capture = enableDebugCapture();
+
+      let resolveHandler;
+      let markHandlerStarted;
+      const handlerStarted = new Promise((resolve) => {
+        markHandlerStarted = resolve;
+      });
+      const handlerPromise = new Promise((resolve) => {
+        resolveHandler = resolve;
+      });
+
+      sqs.send.withArgs(mockReceiveMessage).resolves({
+        Messages: [
+          { MessageId: '1', ReceiptHandle: 'receipt-handle-1', Body: 'body-1' }
+        ]
+      });
+      consumer = new Consumer({
+        queueUrl: QUEUE_URL,
+        region: REGION,
+        handleMessage: () => {
+          markHandlerStarted();
+          return handlerPromise;
+        },
+        sqs
+      });
+
+      try {
+        consumer.start();
+        await clock.tickAsync(0);
+        await handlerStarted;
+        const beforeProcessing = capture.count();
+        await clock.tickAsync(5000);
+        const periodicLogs = capture.count() - beforeProcessing;
+
+        resolveHandler();
+        await clock.tickAsync(0);
+        consumer.stop();
+
+        assert.isAtLeast(
+          periodicLogs,
+          2,
+          'expected the consumer to log periodically while the handler is processing'
+        );
+      } finally {
+        capture.restore();
+      }
+    });
+  });
 });
