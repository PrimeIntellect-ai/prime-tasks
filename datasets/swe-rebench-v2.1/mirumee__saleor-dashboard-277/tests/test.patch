+import { configure, mount, ReactWrapper } from "enzyme";
+import Adapter from "enzyme-adapter-react-16";
+import React from "react";
+import { IntlProvider } from "react-intl";
+import ProductImages from "@saleor/products/components/ProductImages/ProductImages";
+
+configure({ adapter: new Adapter() });
+
+const makeFiles = () =>
+  ["first.png", "second.png"].map(
+    name => new File([name], name, { type: "image/png" })
+  );
+
+const mountProductImages = (onImageUpload: jest.Mock): ReactWrapper =>
+  mount(
+    React.createElement(
+      IntlProvider,
+      { locale: "en" },
+      React.createElement(ProductImages, {
+        images: [
+          {
+            __typename: "ProductImage",
+            alt: "existing image",
+            id: "existing-image",
+            sortOrder: 0,
+            url: "existing.png"
+          }
+        ],
+        onImageDelete: () => () => undefined,
+        onImageEdit: () => () => undefined,
+        onImageUpload
+      })
+    )
+  );
+
+const uploadedFileNames = (onImageUpload: jest.Mock) =>
+  onImageUpload.mock.calls.map(call => (call[0] as File).name).sort();
+
+const fileNames = (files: File[]) => files.map(file => file.name).sort();
+
+describe("Product image upload UI", () => {
+  it("uploads every image dropped onto the upload area", async () => {
+    const files = makeFiles();
+    const onImageUpload = jest.fn(async () => undefined);
+    const wrapper = mountProductImages(onImageUpload);
+
+    wrapper
+      .find("div")
+      .filterWhere(node => typeof node.prop("onDrop") === "function")
+      .simulate("drop", {
+        dataTransfer: {
+          files,
+          items: files.map(file => ({ kind: "file", getAsFile: () => file })),
+          types: ["Files"]
+        }
+      });
+    await new Promise(resolve => setTimeout(resolve, 0));
+
+    expect(uploadedFileNames(onImageUpload)).toEqual(fileNames(files));
+    wrapper.unmount();
+  });
+
+  it("uploads every image selected through the file explorer", async () => {
+    const files = makeFiles();
