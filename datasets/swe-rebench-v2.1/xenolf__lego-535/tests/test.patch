+func TestProviderConfigFromEnvironment(t *testing.T) {
+	isolateCloudflareCredentials(t)
+	t.Setenv("CLOUDFLARE_EMAIL", "test@example.com")
+	t.Setenv("CLOUDFLARE_API_KEY", "123")
+
+	_, err := cloudflare.NewDNSProvider()
+	require.NoError(t, err)
+}
+
+func TestProviderConfigEnvironmentTakesPrecedenceOverFiles(t *testing.T) {
+	isolateCloudflareCredentials(t)
+	t.Setenv("CLOUDFLARE_EMAIL", "test@example.com")
+	t.Setenv("CLOUDFLARE_API_KEY", "123")
+	t.Setenv("CLOUDFLARE_EMAIL_FILE", "/path/that/does/not/exist")
+	t.Setenv("CLOUDFLARE_API_KEY_FILE", "/path/that/does/not/exist")
+
+	_, err := cloudflare.NewDNSProvider()
+	require.NoError(t, err)
+}
+
+func isolateCloudflareCredentials(t *testing.T) {
+	for _, key := range []string{
+		"CLOUDFLARE_EMAIL", "CLOUDFLARE_API_KEY",
+		"CLOUDFLARE_EMAIL_FILE", "CLOUDFLARE_API_KEY_FILE",
+		"CF_API_EMAIL", "CF_API_KEY", "CF_API_EMAIL_FILE", "CF_API_KEY_FILE",
+	} {
+		t.Setenv(key, "")
+	}
+}
