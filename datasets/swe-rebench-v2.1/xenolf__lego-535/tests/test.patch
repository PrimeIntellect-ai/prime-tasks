+func TestProviderConfigFromFile(t *testing.T) {
+	isolateCloudflareCredentials(t)
+
+	emailFile, err := ioutil.TempFile("", "lego")
+	require.NoError(t, err)
+	defer os.Remove(emailFile.Name())
+	require.NoError(t, ioutil.WriteFile(emailFile.Name(), []byte("test@example.com"), 0644))
+
+	keyFile, err := ioutil.TempFile("", "lego")
+	require.NoError(t, err)
+	defer os.Remove(keyFile.Name())
+	require.NoError(t, ioutil.WriteFile(keyFile.Name(), []byte("123"), 0644))
+
+	t.Setenv("CLOUDFLARE_EMAIL_FILE", emailFile.Name())
+	t.Setenv("CLOUDFLARE_API_KEY_FILE", keyFile.Name())
+
+	provider, err := cloudflare.NewDNSProvider()
+	require.NoError(t, err)
+	assert.NotNil(t, provider)
+}
+
+func TestNonCloudflareProviderConfigFromFile(t *testing.T) {
+	t.Setenv("DNSIMPLE_OAUTH_TOKEN", "")
+
+	tokenFile, err := ioutil.TempFile("", "lego-dnsimple-token")
+	require.NoError(t, err)
+	defer os.Remove(tokenFile.Name())
+	require.NoError(t, ioutil.WriteFile(tokenFile.Name(), []byte("dnsimple-token"), 0644))
+	t.Setenv("DNSIMPLE_OAUTH_TOKEN_FILE", tokenFile.Name())
+
+	provider, err := dnsimple.NewDNSProvider()
+	require.NoError(t, err)
+	assert.NotNil(t, provider)
+}
