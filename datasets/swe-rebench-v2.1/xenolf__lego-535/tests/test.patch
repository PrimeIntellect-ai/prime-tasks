+func TestGetOrFile(t *testing.T) {
+	file, err := ioutil.TempFile("", "lego-env-file")
+	require.NoError(t, err)
+	defer os.Remove(file.Name())
+	_, err = file.WriteString("file-backed-value")
+	require.NoError(t, err)
+	require.NoError(t, file.Close())
+
+	t.Setenv("LEGO_GET_OR_FILE", "")
+	t.Setenv("LEGO_GET_OR_FILE_FILE", file.Name())
+	assert.Equal(t, "file-backed-value", env.GetOrFile("LEGO_GET_OR_FILE"))
+
+	t.Setenv("LEGO_GET_OR_FILE", "environment-value")
+	assert.Equal(t, "environment-value", env.GetOrFile("LEGO_GET_OR_FILE"))
+}
