+def test_span_context_closes_nested_spans_when_block_raises(tracked_request):
+    with tracked_request.span(operation="parent") as parent:
+        with pytest.raises(ValueError):
+            with tracked_request.span(operation="child"):
+                raise ValueError("span block failed")
+
+        with tracked_request.span(operation="after") as after:
+            assert after.parent == parent.span_id
+
+    assert {span.operation for span in tracked_request.complete_spans} == {
+        "parent",
+        "child",
+        "after",
+    }
