+func TestAnyOfNestedPropertyConstraintsAsRequest(t *testing.T) {
+	spec := `
+openapi: 3.0.0
+info:
+  title: 'Validator'
+  version: 0.0.1
+paths:
+  /tech:
+    post:
+      requestBody:
+        content:
+          application/json:
+            schema:
+              type: object
+              properties:
+                vehicle:
+                  $ref: "#/components/schemas/Vehicle"
+      responses:
+        '200':
+          description: Ok
+
+components:
+  schemas:
+    Vehicle:
+      type: object
+      properties:
+        identifiers:
+          type: object
+          properties:
+            vin:
+              type: string
+              minLength: 17
+              maxLength: 17
+            body:
+              type: string
+              minLength: 7
+              maxLength: 15
+          anyOf:
+            - required: [ vin ]
+            - required: [ body ]
+`
+	loader := NewLoader()
+	doc, err := loader.LoadFromData([]byte(spec))
+	require.NoError(t, err)
+	requestSchema := doc.Paths.Find("/tech").Post.RequestBody.Value.Content.Get("application/json").Schema.Value
+
+	valid := []interface{}{
+		map[string]interface{}{"vehicle": map[string]interface{}{"identifiers": map[string]interface{}{"vin": "12345678901234567"}}},
+		map[string]interface{}{"vehicle": map[string]interface{}{"identifiers": map[string]interface{}{"body": "1234567"}}},
+		map[string]interface{}{"vehicle": map[string]interface{}{"identifiers": map[string]interface{}{"body": "123456789012345"}}},
+	}
+	for _, value := range valid {
+		require.NoError(t, validateSchemaJSON(t, requestSchema, value, VisitAsRequest()), "%#v", value)
+	}
+
+	err = validateSchemaJSON(t, requestSchema, map[string]interface{}{"vehicle": map[string]interface{}{"identifiers": map[string]interface{}{"vin": "BAD"}}}, VisitAsRequest())
+	require.ErrorContains(t, err, "minimum string length is 17")
+
+	invalid := []interface{}{
+		map[string]interface{}{"vehicle": map[string]interface{}{"identifiers": map[string]interface{}{"vin": "123456789012345678"}}},
+		map[string]interface{}{"vehicle": map[string]interface{}{"identifiers": map[string]interface{}{"body": "123456"}}},
+		map[string]interface{}{"vehicle": map[string]interface{}{"identifiers": map[string]interface{}{"body": "1234567890123456"}}},
+	}
+	for _, value := range invalid {
+		require.Error(t, validateSchemaJSON(t, requestSchema, value, VisitAsRequest()), "%#v", value)
+	}
+}
+
