diff --git a/tests/ruleToggler.js b/tests/ruleToggler.js
new file mode 100644
index 0000000..62f3053
--- /dev/null
+++ b/tests/ruleToggler.js
@@ -0,0 +1,41 @@
+'use strict';
+
+var assert = require('assert'),
+    lint = require('../index');
+
+describe('source lint directives', function () {
+  it('suppresses a matching lint report through the normal linting API', function () {
+    var options = {
+      options: {
+        'merge-default-rules': false,
+        'cache-config': false
+      },
+      rules: {
+        'border-zero': 2
+      }
+    };
+    var source = 'a { border: none; }\n';
+    var ordinaryResult = lint.lintText({
+      text: source,
+      format: 'scss',
+      filename: 'inline.scss'
+    }, options);
+    var directives = ['sass-lint', 'scss-lint'];
+    var suppressedBySomeDirective = directives.some(function (prefix) {
+      var result = lint.lintText({
+        text: '// ' + prefix + ':disable border-zero\n' + source,
+        format: 'scss',
+        filename: 'inline.scss'
+      }, options);
+
+      return !result.messages.some(function (message) {
+        return message.ruleId === 'border-zero';
+      });
+    });
+
+    assert(ordinaryResult.messages.some(function (message) {
+      return message.ruleId === 'border-zero';
+    }));
+    assert(suppressedBySomeDirective);
+  });
+});
