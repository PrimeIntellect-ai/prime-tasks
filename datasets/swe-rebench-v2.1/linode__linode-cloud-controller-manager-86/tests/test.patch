+func testUpdateLoadBalancerAddProxyProtocolPerPort(t *testing.T, client *linodego.Client, fakeAPI *fakeAPI) {
+	nodes := []*v1.Node{
+		{
+			Status: v1.NodeStatus{
+				Addresses: []v1.NodeAddress{
+					{
+						Type:    v1.NodeInternalIP,
+						Address: "127.0.0.1",
+					},
+				},
+			},
+		},
+	}
+
+	lb := &loadbalancers{client, "us-west", nil}
+	fakeClientset := fake.NewSimpleClientset()
+	lb.kubeClient = fakeClientset
+
+	svc := &v1.Service{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:        randString(10),
+			UID:         "foobar123",
+			Annotations: map[string]string{},
+		},
+		Spec: v1.ServiceSpec{
+			Ports: []v1.ServicePort{
+				{
+					Name:     randString(10),
+					Protocol: "tcp",
+					Port:     int32(80),
+					NodePort: int32(30000),
+				},
+				{
+					Name:     randString(10),
+					Protocol: "tcp",
+					Port:     int32(8080),
+					NodePort: int32(30001),
+				},
+				{
+					Name:     randString(10),
+					Protocol: "tcp",
+					Port:     int32(8081),
+					NodePort: int32(30002),
+				},
+			},
+		},
+	}
+
+	defer lb.EnsureLoadBalancerDeleted(context.TODO(), "lnodelb", svc)
+	nodeBalancer, err := client.CreateNodeBalancer(context.TODO(), linodego.NodeBalancerCreateOptions{
+		Region: lb.zone,
+	})
+	if err != nil {
+		t.Fatalf("failed to create NodeBalancer: %s", err)
+	}
+
+	svc.Status.LoadBalancer = *makeLoadBalancerStatus(nodeBalancer)
+	svc.ObjectMeta.SetAnnotations(map[string]string{
+		annLinodeDefaultProxyProtocolKey:   string(linodego.ProxyProtocolV2),
+		annLinodePortConfigPrefix + "8080": fmt.Sprintf(`{"proxy-protocol": "%s"}`, linodego.ProxyProtocolV1),
+		annLinodePortConfigPrefix + "8081": `{"proxy-protocol": "none"}`,
+	})
+
+	stubService(fakeClientset, svc)
+	if err = lb.UpdateLoadBalancer(context.TODO(), "lnodelb", svc, nodes); err != nil {
+		t.Fatalf("UpdateLoadBalancer returned an unexpected error: %s", err)
+	}
+
+	nodeBalancerConfigs, err := client.ListNodeBalancerConfigs(context.TODO(), nodeBalancer.ID, nil)
+	if err != nil {
+		t.Fatalf("failed to get NodeBalancer configs: %s", err)
+	}
+
+	expected := map[int]linodego.ConfigProxyProtocol{
+		80:   linodego.ProxyProtocolV2,
+		8080: linodego.ProxyProtocolV1,
+		8081: linodego.ProxyProtocolNone,
+	}
+	for _, config := range nodeBalancerConfigs {
+		want, ok := expected[int(config.Port)]
+		if !ok {
+			continue
+		}
+		if config.ProxyProtocol != want {
+			t.Errorf("port %d: expected ProxyProtocol %s; got %s", config.Port, want, config.ProxyProtocol)
+		}
+		delete(expected, int(config.Port))
+	}
+	if len(expected) != 0 {
+		t.Errorf("missing NodeBalancer configs for ports: %v", expected)
+	}
+	t.Run("port-specific value without a default", func(t *testing.T) {
+		svcWithoutDefault := &v1.Service{
+			ObjectMeta: metav1.ObjectMeta{
+				Name:        randString(10),
+				UID:         "foobar456",
+				Annotations: map[string]string{annLinodePortConfigPrefix + "8082": `{"proxy-protocol": "v1"}`},
+			},
+			Spec: v1.ServiceSpec{
+				Ports: []v1.ServicePort{{
+					Name:     randString(10),
+					Protocol: "tcp",
+					Port:     int32(8082),
+					NodePort: int32(30003),
+				}},
+			},
+		}
+
+		nodeBalancerWithoutDefault, err := client.CreateNodeBalancer(context.TODO(), linodego.NodeBalancerCreateOptions{Region: lb.zone})
+		if err != nil {
+			t.Fatalf("failed to create NodeBalancer: %s", err)
+		}
+		defer lb.EnsureLoadBalancerDeleted(context.TODO(), "lnodelb", svcWithoutDefault)
+		svcWithoutDefault.Status.LoadBalancer = *makeLoadBalancerStatus(nodeBalancerWithoutDefault)
+		stubService(fakeClientset, svcWithoutDefault)
+		if err := lb.UpdateLoadBalancer(context.TODO(), "lnodelb", svcWithoutDefault, nodes); err != nil {
+			t.Fatalf("UpdateLoadBalancer returned an unexpected error: %s", err)
+		}
+
+		configs, err := client.ListNodeBalancerConfigs(context.TODO(), nodeBalancerWithoutDefault.ID, nil)
+		if err != nil {
+			t.Fatalf("failed to get NodeBalancer configs: %s", err)
+		}
+		for _, config := range configs {
+			if config.Port == 8082 {
+				if config.ProxyProtocol != linodego.ProxyProtocolV1 {
+					t.Errorf("port 8082: expected ProxyProtocol %s; got %s", linodego.ProxyProtocolV1, config.ProxyProtocol)
+				}
+				return
+			}
+		}
+		t.Error("NodeBalancer config for port 8082 was not found")
+	})
+
+}
