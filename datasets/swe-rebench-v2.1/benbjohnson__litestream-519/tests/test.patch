+// closeDB supports the DB.Close API on both sides of the context change.
+func closeDB(db *litestream.DB) error {
+	switch db := interface{}(db).(type) {
+	case interface{ Close(context.Context) error }:
+		return db.Close(context.Background())
+	case interface{ Close() error }:
+		return db.Close()
+	default:
+		return fmt.Errorf("unsupported DB close API")
+	}
+}
