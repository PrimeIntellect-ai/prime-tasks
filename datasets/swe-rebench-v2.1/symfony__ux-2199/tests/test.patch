 import { defineConfig, mergeConfig } from 'vitest/config';
+import { readFileSync } from 'node:fs';
 import configShared from '../../../../../../vitest.config.mjs'
 
+// Verifies that every bare module reference in the packaged Leaflet controller
+// can actually be resolved by the bundler, so that installing/bundling the
+// bridge does not fail with "Module not found" errors.
+function verifyPackagedController(distFile) {
+    return {
+        name: 'verify-packaged-controller',
+        enforce: 'post',
+        async buildStart() {
+            const code = readFileSync(distFile, 'utf8');
+            const specifiers = new Set();
+            const re = /(?:from\s*|import\s*)['"]([^'"]+)['"]/g;
+            let match;
+            while ((match = re.exec(code)) !== null) {
+                specifiers.add(match[1]);
+            }
+            for (const specifier of specifiers) {
+                if (specifier.startsWith('.') || specifier.startsWith('/') || specifier.startsWith('node:')) {
+                    continue;
+                }
+                const resolved = await this.resolve(specifier, distFile);
+                if (!resolved) {
+                    this.error(`The packaged Leaflet controller references "${specifier}", which cannot be resolved.`);
+                }
+            }
+        },
+    };
+}
+
 export default mergeConfig(
