diff --git a/tests/testthat/test-coverage.R b/tests/testthat/test-coverage.R
new file mode 100644
index 00000000..50f01fcf
--- /dev/null
+++ b/tests/testthat/test-coverage.R
@@ -0,0 +1,18 @@
+test_that("we use specific URLs in a codecov badge", {
+  create_local_package()
+  writeLines(c("<!-- badges: start -->", "<!-- badges: end -->"), "README.md")
+
+  use_codecov_badge("OWNER/REPO")
+  badge <- readLines("README.md")
+
+  expect_true(any(grepl(
+    "https://codecov.io/gh/OWNER/REPO/graph/badge.svg)",
+    badge,
+    fixed = TRUE
+  )))
+  expect_true(any(grepl(
+    "https://codecov.io/gh/OWNER/REPO)",
+    badge,
+    fixed = TRUE
+  )))
+})
