diff --git a/tests/test_warning.py b/tests/test_warning.py
new file mode 100644
index 0000000..1a9aa1e
--- /dev/null
+++ b/tests/test_warning.py
@@ -0,0 +1,46 @@
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Iterator
+from unittest.mock import Mock
+
+import pytest
+
+from pipdeptree.__main__ import main
+
+if TYPE_CHECKING:
+    from pytest_mock import MockerFixture
+
+
+@pytest.fixture(autouse=True)
+def _restore_default_warning_mode(mocker: MockerFixture) -> Iterator[None]:
+    yield
+    # Each command uses a process-wide warning mode; reset it for test isolation.
+    mocker.patch("pipdeptree._discovery.distributions", Mock(return_value=[]))
+    main([])
+
+
+def _duplicate_dists() -> list[Mock]:
+    return [
+        Mock(metadata={"Name": "foo"}, version="1.2.5", locate_file=Mock(return_value="/path/1"), requires=[]),
+        Mock(metadata={"Name": "foo"}, version="5.9.0", locate_file=Mock(return_value="/path/2"), requires=[]),
+    ]
+
+
+def test_duplicate_metadata_silence(mocker: MockerFixture, capfd: pytest.CaptureFixture[str]) -> None:
+    mocker.patch("pipdeptree._discovery.distributions", Mock(return_value=_duplicate_dists()))
+    main(["--warn", "silence"])
+    _, err = capfd.readouterr()
+    assert err == ""
+
+
+def test_invalid_requirement_silence(mocker: MockerFixture, capfd: pytest.CaptureFixture[str]) -> None:
+    dist = Mock(
+        metadata={"Name": "foo"},
+        version="1.2.5",
+        locate_file=Mock(return_value="/path/1"),
+        requires=["invalid requirement!!!"],
+    )
+    mocker.patch("pipdeptree._discovery.distributions", Mock(return_value=[dist]))
+    main(["--warn", "silence"])
+    _, err = capfd.readouterr()
+    assert err == ""
