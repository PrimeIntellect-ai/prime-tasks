                           :body,
                      ),
                 )
+
+            # The malformed call from the report must fail at its own line,
+            # whether or not the call ends in a semicolon.
+            for trailing_semicolon in (true, false)
+                source = "function f(x,y)\nend\n\nf(;1;2)" *
+                         (trailing_semicolon ? ";\n" : "\n")
+                malformed = parseall(source)
+                failure = try
+                    Core.eval(Module(gensym()), malformed)
+                    nothing
+                catch err
+                    (err, catch_backtrace())
+                end
+                @test failure !== nothing
+                if failure !== nothing
+                    @test any(frame -> frame.line == 4, stacktrace(failure[2]))
+                end
+            end
         end
 
         @testset "Function definition lines" begin
