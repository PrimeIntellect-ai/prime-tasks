+class _MetadataReadTimeout(BaseException):
+    pass
+
+
+def _pdf_with_info_body(info_body: bytes) -> bytes:
+    objs = [
+        b"<< /Type /Catalog /Pages 2 0 R >>",
+        b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
+        b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 100 100] >>",
+        info_body,
+    ]
+    out = bytearray(b"%PDF-1.4\n")
+    offsets = []
+    for num, body in enumerate(objs, start=1):
+        offsets.append(len(out))
+        out += b"%d 0 obj\n" % num + body + b"\nendobj\n"
+    xref_pos = len(out)
+    out += b"xref\n0 %d\n" % (len(objs) + 1)
+    out += b"0000000000 65535 f \n"
+    for off in offsets:
+        out += b"%010d 00000 n \n" % off
+    out += (
+        b"trailer\n<< /Size %d /Root 1 0 R /Info 4 0 R >>\n" % (len(objs) + 1)
+        + b"startxref\n%d\n%%%%EOF\n" % xref_pos
+    )
+    return bytes(out)
+
+
+@pytest.mark.skipif(not hasattr(signal, "SIGALRM"), reason="needs SIGALRM")
+def test_metadata_with_malformed_info_dictionary_completes():
+    pdf_bytes = _pdf_with_info_body(
+        b"<< /Title (Hello) /Author @@@ /Producer (x) >>"
+    )
+
+    def on_alarm(signum, frame):
+        raise _MetadataReadTimeout("reading metadata did not finish")
+
+    previous = signal.signal(signal.SIGALRM, on_alarm)
+    signal.alarm(20)
+    try:
+        reader = PdfReader(BytesIO(pdf_bytes))
+        reader.metadata  # noqa: B018
+    finally:
+        signal.alarm(0)
+        signal.signal(signal.SIGALRM, previous)
+    assert len(reader.pages) == 1
+
+
