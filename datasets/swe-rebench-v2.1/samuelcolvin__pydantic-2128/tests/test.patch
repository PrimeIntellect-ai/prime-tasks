--- a/tests/test_decorator.py
+++ b/tests/test_decorator.py
@@ -318,3 +318,23 @@ def test_config_arbitrary_types_allowed():
             'ctx': {'expected_arbitrary_type': 'EggBox'},
         },
     ]
+
+
+def test_validate():
+    calls = []
+
+    @validate_arguments
+    def func(s: str, count: int, *, separator: bytes = b''):
+        calls.append((s, count, separator))
+
+    m = func.validate('qwe', '2')
+    assert m.s == 'qwe'
+    assert m.count == 2
+
+    m = func.validate(s='qwe', count=2, separator=b'-')
+    assert m.separator == b'-'
+
+    with pytest.raises(ValidationError):
+        func.validate(['qwe'], 2)
+
+    assert calls == [], 'validate must not execute the decorated function'
