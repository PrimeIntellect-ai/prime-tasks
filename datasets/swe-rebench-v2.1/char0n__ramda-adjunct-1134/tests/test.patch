diff --git a/test/trimEnd.js b/test/trimEnd.js
new file mode 100644
index 0000000..d030815
--- /dev/null
+++ b/test/trimEnd.js
@@ -0,0 +1,59 @@
+import { spawnSync } from 'child_process';
+import { assert } from 'chai';
+
+import * as RA from '../src';
+import eq from './shared/eq';
+
+describe('trimEnd', function() {
+  specify('should remove whitespace from the end of a string', function() {
+    eq(RA.trimEnd('abc   '), 'abc');
+  });
+  specify('should remove trailing tabs and newlines', function() {
+    eq(RA.trimEnd('\tvalue \n\t'), '\tvalue');
+  });
+  specify(
+    'should not remove whitespace from the rest of the string',
+    function() {
+      eq(RA.trimEnd(' a b c'), ' a b c');
+    }
+  );
+
+  context('given an empty string', function() {
+    specify('should return an empty string', function() {
+      eq(RA.trimEnd(''), '');
+    });
+  });
+
+  context('given a string with whitespace only', function() {
+    specify('should return an empty string', function() {
+      eq(RA.trimEnd('   '), '');
+    });
+  });
+
+  context('when the native String.prototype.trimEnd is unavailable', function() {
+    specify('should still remove trailing whitespace', function() {
+      const script = [
+        'delete String.prototype.trimEnd;',
+        'const RA = require("./src");',
+        'const assert = require("assert");',
+        'assert.strictEqual(RA.trimEnd("abc   "), "abc");',
+        'assert.strictEqual(RA.trimEnd("  "), "");',
+        'assert.strictEqual(RA.trimEnd(" a b c"), " a b c");'
+      ].join('\n');
+      const result = spawnSync(
+        process.execPath,
+        ['-r', '@babel/register', '-e', script],
+        { cwd: process.cwd(), env: process.env }
+      );
+
+      assert.strictEqual(result.status, 0, result.stderr.toString());
+    });
+  });
+});
+
+describe('trimRight', function() {
+  it('should be an alias of trimEnd', function() {
+    assert.isFunction(RA.trimRight);
+    eq(RA.trimRight(' a b c   '), RA.trimEnd(' a b c   '));
+  });
+});
