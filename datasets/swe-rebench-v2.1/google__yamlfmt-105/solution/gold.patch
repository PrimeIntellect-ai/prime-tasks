diff --git a/internal/collections/errors.go b/internal/collections/errors.go
new file mode 100644
index 0000000..719079e
--- /dev/null
+++ b/internal/collections/errors.go
@@ -0,0 +1,20 @@
+package collections
+
+import "errors"
+
+type Errors []error
+
+func (errs Errors) Combine() error {
+	errMessage := ""
+
+	for _, err := range errs {
+		if err != nil {
+			errMessage += err.Error() + "\n"
+		}
+	}
+
+	if len(errMessage) == 0 {
+		return nil
+	}
+	return errors.New(errMessage)
+}
