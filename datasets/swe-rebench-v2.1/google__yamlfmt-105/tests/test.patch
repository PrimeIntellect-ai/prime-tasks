+package collections_test
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/google/yamlfmt"
+)
+
+func TestDoublestarExcludeTemplates(t *testing.T) {
+	root := t.TempDir()
+	for _, name := range []string{
+		"chart/templates/deployment.yaml",
+		"chart/values.yaml",
+	} {
+		path := filepath.Join(root, name)
+		if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path, []byte("key: value\n"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	collector := &yamlfmt.DoublestarCollector{
+		Include: []string{filepath.Join(root, "**", "*.yaml")},
+		Exclude: []string{"**/templates/**"},
+	}
+	paths, err := collector.CollectPaths()
+	if err != nil {
+		t.Fatalf("CollectPaths() error: %v", err)
+	}
+
+	got := make([]string, 0, len(paths))
+	for _, path := range paths {
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			t.Fatalf("make path relative: %v", err)
+		}
+		got = append(got, filepath.ToSlash(rel))
+	}
+	if !reflect.DeepEqual(got, []string{"chart/values.yaml"}) {
+		t.Fatalf("formatted paths = %v, want [chart/values.yaml]", got)
+	}
+}
