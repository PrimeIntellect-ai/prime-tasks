+def test_nested_cidr_in_sub():
+    """A valid template with Fn::Cidr/Fn::Select nested in Fn::Sub has no errors."""
+    template = """
+AWSTemplateFormatVersion: "2010-09-09"
+Parameters:
+  additionalVpcCidr:
+    Type: String
+    Default: 10.0.0.0/16
+  additionalSubnetBits:
+    Type: Number
+    Default: 8
+  physicalazlist:
+    Type: String
+    Default: us-east-1a,us-east-1b
+  appCode:
+    Type: String
+    Default: app
+  envType:
+    Type: String
+    Default: dev
+  AdditionalSubnet1Cidr:
+    Type: String
+    Default: 10.0.1.0/24
+Conditions:
+  isAdditionalVpc: !Equals [!Ref additionalVpcCidr, "10.0.0.0/16"]
+  isAdditionalCidr1Empty: !Equals [!Ref additionalSubnetBits, 8]
+  usesetaz: !Equals [!Ref envType, "dev"]
+Resources:
+  vpc:
+    Type: AWS::EC2::VPC
+    Properties:
+      CidrBlock: 10.0.0.0/16
+  AdditionalVpcCIDR:
+    Type: AWS::EC2::VPCCidrBlock
+    Properties:
+      VpcId: !Ref vpc
+      CidrBlock: !Ref additionalVpcCidr
+  AdditionalSubnet1:
+    Type: AWS::EC2::Subnet
+    Condition: isAdditionalVpc
+    DependsOn: AdditionalVpcCIDR
+    Properties:
+      AvailabilityZone: !If [usesetaz, !Select [0, !Split [",", !Ref physicalazlist]], !Select [0, !GetAZs '']]
+      CidrBlock:
+        !If
+          - isAdditionalCidr1Empty
+          - !Select [0, !Cidr [!Ref additionalVpcCidr, 4, !Ref additionalSubnetBits]]
+          - !Ref AdditionalSubnet1Cidr
+      MapPublicIpOnLaunch: false
+      Tags:
+      - Key: Name
+        Value: !Sub
+        - ${appCode}-${envType}-additional1-${az}-${cidr}
+        -
+          az: !If [usesetaz, !Select [0, !Split [",", !Ref physicalazlist]], !Select [0, !GetAZs '']]
+          cidr: !Select [0, !Cidr [!Ref additionalVpcCidr, 4, !Ref additionalSubnetBits]]
+      VpcId: !Ref vpc
+"""
+    matches = cfnlint.lint(template, config=ManualArgs(regions=["us-east-1"]))
+    errors = [m for m in matches if m.rule.id.startswith("E")]
+    assert errors == [], f"Got errors: {errors!r}"
