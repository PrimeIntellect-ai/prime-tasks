+            seen.add(data.draw_bits(8))
+
+        ConjectureRunner(
+            test,
+            settings=settings(max_examples=100, database=db, phases=[Phase.reuse]),
+            database_key=b"key",
+        ).run()
+
+        assert len(seen) == 100
