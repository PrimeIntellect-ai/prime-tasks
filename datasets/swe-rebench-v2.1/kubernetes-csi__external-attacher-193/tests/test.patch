+
+func TestGetNodeIDFromCSINode(t *testing.T) {
+	tests := []struct {
+		name          string
+		driver        string
+		csiNode       *storage.CSINode
+		expectedID    string
+		expectedFound bool
+	}{
+		{
+			name:          "driver present",
+			driver:        testAttacherName,
+			csiNode:       csiNode(),
+			expectedID:    testNodeID,
+			expectedFound: true,
+		},
+		{
+			name:          "driver absent",
+			driver:        "other/driver",
+			csiNode:       csiNode(),
+			expectedID:    "",
+			expectedFound: false,
+		},
+		{
+			name:          "no drivers",
+			driver:        testAttacherName,
+			csiNode:       csiNodeEmpty(),
+			expectedID:    "",
+			expectedFound: false,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			id, found := GetNodeIDFromCSINode(test.driver, test.csiNode)
+			if id != test.expectedID {
+				t.Errorf("expected node ID %q, got %q", test.expectedID, id)
+			}
+			if found != test.expectedFound {
+				t.Errorf("expected found %v, got %v", test.expectedFound, found)
+			}
+		})
+	}
+}
