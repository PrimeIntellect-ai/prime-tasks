+    def test_attrs_deepcopy(self):
+        df = DataFrame({"A": [2, 3]})
+        assert df.attrs == {}
+        df.attrs["tags"] = {"spam", "ham"}
+        df.attrs["metadata"] = {"items": ["original"]}
+
+        result = deepcopy(df)
+        assert result.attrs == df.attrs
+        assert result.attrs["tags"] is not df.attrs["tags"]
+        assert (
+            result.attrs["metadata"]["items"]
+            is not df.attrs["metadata"]["items"]
+        )
+        result.attrs["metadata"]["items"].append("copied")
+        assert df.attrs["metadata"]["items"] == ["original"]
+
+    def test_attrs_rename_deepcopy(self):
+        df = DataFrame({"A": [2, 3]})
+        df.attrs["tags"] = {"spam", "ham"}
+        df.attrs["metadata"] = {"items": ["original"]}
+
+        result = df.rename(columns=str)
+        assert result.attrs == df.attrs
+        assert result.attrs["tags"] is not df.attrs["tags"]
+        assert (
+            result.attrs["metadata"]["items"]
+            is not df.attrs["metadata"]["items"]
+        )
+        result.attrs["metadata"]["items"].append("renamed")
+        assert df.attrs["metadata"]["items"] == ["original"]
+
