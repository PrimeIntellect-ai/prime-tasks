+
+SEED_KEYWORDS = ('random_seed', 'seed', 'random_state')
+
+
+def build_seeded(factory, seed, *args):
+    """Create an instance that samples with ``seed``, using whichever seed keyword it accepts."""
+    error = None
+    for keyword in SEED_KEYWORDS:
+        try:
+            return factory(*args, **{keyword: seed})
+        except TypeError as exc:
+            error = exc
+    raise error
