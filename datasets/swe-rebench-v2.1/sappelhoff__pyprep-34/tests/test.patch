diff --git a/tests/test_prep_pipeline.py b/tests/test_prep_pipeline.py
index ca202fb..7850d0a 100644
--- a/tests/test_prep_pipeline.py
+++ b/tests/test_prep_pipeline.py
@@ -204,3 +204,45 @@ def test_prep_pipeline(raw, montage):
     # axs[4, 0].set_title('Interpolation', loc='left', fontsize=14)
     # axs[4, 0].set_ylabel('Channel Number', fontsize=14)
     axs[4, 1].set_xlabel("Time(s)", fontsize=14)
+
+
+def test_prep_pipeline_retains_non_eeg_channels(raw, montage, monkeypatch):
+    """Non-EEG input channels remain available after PREP processing."""
+    # Older project code uses the NumPy alias removed in recent releases.
+    monkeypatch.setattr(np, "int", int, raising=False)
+    raw_with_aux = raw.copy()
+    sfreq = raw_with_aux.info["sfreq"]
+    n_times = raw_with_aux.n_times
+    aux_names = ["ocular", "aux"]
+    aux_info = mne.create_info(aux_names, sfreq, ch_types=["eog", "misc"])
+    times = np.arange(n_times) / sfreq
+    aux_data = np.vstack([times * 1e-9, np.sin(2 * np.pi * times) * 1e-6])
+    raw_with_aux.add_channels([mne.io.RawArray(aux_data, aux_info, verbose=False)])
+
+    eeg_names = [
+        name
+        for name, channel_type in zip(
+            raw_with_aux.ch_names, raw_with_aux.get_channel_types()
+        )
+        if channel_type == "eeg"
+    ]
+    prep_params = {
+        "ref_chs": eeg_names,
+        "reref_chs": eeg_names,
+        "line_freqs": [],
+    }
+    prep = PrepPipeline(
+        raw_with_aux, prep_params, montage, ransac=False, random_state=42
+    )
+    prep.fit()
+
+    assert set(prep.raw.ch_names) == set(raw_with_aux.ch_names)
+    assert prep.raw.get_channel_types(picks=aux_names) == ["eog", "misc"]
+    aux_output = prep.raw.get_data(picks=aux_names)
+    assert aux_output.shape == raw_with_aux.get_data(picks=aux_names).shape
+    assert np.all(np.isfinite(aux_output))
+    assert np.all(aux_output.std(axis=1) > 0)
+
+    original_eeg = raw_with_aux.get_data(picks=eeg_names)
+    output_eeg = prep.raw.get_data(picks=eeg_names)
+    assert not np.allclose(output_eeg, original_eeg)
