diff --git a/lib/Expression/Ast/UnrepresentableValueNode.php b/lib/Expression/Ast/UnrepresentableValueNode.php
new file mode 100644
index 00000000..f3261b94
--- /dev/null
+++ b/lib/Expression/Ast/UnrepresentableValueNode.php
@@ -0,0 +1,27 @@
+<?php
+
+namespace PhpBench\Expression\Ast;
+
+final class UnrepresentableValueNode implements PhpValue
+{
+    /**
+     * @var mixed
+     */
+    private $value;
+
+    /**
+     * @param mixed $value
+     */
+    public function __construct($value)
+    {
+        $this->value = $value;
+    }
+
+    /**
+     * @return mixed
+     */
+    public function value()
+    {
+        return $this->value;
+    }
+}
diff --git a/lib/Expression/NodePrinter/UnrepresentableValuePrinter.php b/lib/Expression/NodePrinter/UnrepresentableValuePrinter.php
new file mode 100644
index 00000000..fcded255
--- /dev/null
+++ b/lib/Expression/NodePrinter/UnrepresentableValuePrinter.php
@@ -0,0 +1,20 @@
+<?php
+
+namespace PhpBench\Expression\NodePrinter;
+
+use PhpBench\Expression\Ast\Node;
+use PhpBench\Expression\Ast\UnrepresentableValueNode;
+use PhpBench\Expression\NodePrinter;
+use PhpBench\Expression\Printer;
+
+class UnrepresentableValuePrinter implements NodePrinter
+{
+    public function print(Printer $printer, Node $node): ?string
+    {
+        if (!$node instanceof UnrepresentableValueNode) {
+            return null;
+        }
+
+        return sprintf('<%s>', gettype($node->value()));
+    }
+}
