+class PretendUpdateRepo(UpdateRepo):
+    def __init__(self, installed_mod: Mod, version_provider):
+        self.installed_mod = installed_mod
+        self.version_provider = version_provider
+
+    def get_all_mods(self):
+        return [self.installed_mod]
+
+    def get_versions(self, mod):
+        return self.version_provider.get_all_versions(mod)
+
+    def download(self, url, filename=""):
+        return Path("new.jar")
+
+    def update_mod(self, mod):
+        pass
+
+    def get_mod_from_file(self, filepath):
+        if filepath == "missing-installed.jar":
+            raise FileNotFoundError(filepath)
+        return None
+
+    def remove_mod_file(self, filename):
+        pass
+
+
+class FixedVersionHttp:
+    def get(self, url):
+        return [{
+            "version_type": "release",
+            "loaders": ["fabric"],
+            "date_published": "2022-04-20T21:37:40.666022Z",
+            "game_versions": ["1.19"],
+            "version_number": "2.4.6",
+            "files": [{"url": "https://example.invalid/mod.jar", "filename": "mod-2.4.6.jar"}],
+            "dependencies": [],
+        }]
+
+
+class PretendUpdateFinder:
+    def find_mod(self, mod):
+        return {Sites.modrinth: mod.sites[Sites.modrinth]}
+
+
+def _run_pretend_update(monkeypatch, installed_mod):
+    monkeypatch.setattr(config, "pretend", True)
+    provider = ModrinthApi(FixedVersionHttp())
+    repo = PretendUpdateRepo(installed_mod, provider)
+    update = Update(repo, PretendUpdateFinder())
+    update.execute([])
+
+
+def test_pretend_preview_displays_target_version(monkeypatch, capsys):
+    installed_mod = Mod("example", "Example", sites={Sites.modrinth: Site(Sites.modrinth, "project", "example")}, file="installed.jar", upload_time=0)
+    installed_mod.version = "0.9.0"
+
+    _run_pretend_update(monkeypatch, installed_mod)
+
+    assert "2.4.6" in capsys.readouterr().out
+
+
+def test_pretend_preview_succeeds_when_installed_file_is_missing(monkeypatch, capsys):
+    installed_mod = Mod("example", "Example", sites={Sites.modrinth: Site(Sites.modrinth, "project", "example")}, file="missing-installed.jar", upload_time=0)
+    installed_mod.version = "0.9.0"
+
