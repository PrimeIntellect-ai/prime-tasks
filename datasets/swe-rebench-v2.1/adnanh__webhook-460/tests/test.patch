+func TestCommandLookupPaths(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("uses executable shell scripts")
+	}
+
+	tmp, err := ioutil.TempDir("", "webhook-command-lookup-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(tmp)
+
+	workingDir := filepath.Join(tmp, "working")
+	pathDir := filepath.Join(tmp, "path")
+	if err := os.MkdirAll(workingDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(pathDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	writeCommand := func(path, output string) {
+		t.Helper()
+		if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+			t.Fatal(err)
+		}
+		if err := ioutil.WriteFile(path, []byte("#!/bin/sh\necho "+output+"\n"), 0755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	writeCommand(filepath.Join(workingDir, "probe"), "working-directory")
+	writeCommand(filepath.Join(pathDir, "probe"), "path-entry")
+
+	absoluteCommand := filepath.Join(tmp, "absolute-command-that-is-not-present")
+	// This executable would be considered only by a fallback that prefixes the
+	// working directory to the configured absolute command.
+	writeCommand(filepath.Join(workingDir, absoluteCommand), "prefixed-absolute")
+
+	hooks := []hook.Hook{
+		{ID: "relative-lookup", ExecuteCommand: "probe", CommandWorkingDirectory: workingDir, CaptureCommandOutput: true, HTTPMethods: []string{"POST"}},
+		{ID: "absolute-lookup", ExecuteCommand: absoluteCommand, CommandWorkingDirectory: workingDir, CaptureCommandOutput: true, HTTPMethods: []string{"POST"}},
+	}
+	config, err := json.Marshal(hooks)
+	if err != nil {
+		t.Fatal(err)
+	}
+	configPath := filepath.Join(tmp, "hooks.json")
+	if err := ioutil.WriteFile(configPath, config, 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	webhook, cleanupWebhook := buildWebhook(t)
+	defer cleanupWebhook()
+	ip, port := serverAddress(t)
+	logs := &buffer{}
+	cmd := exec.Command(webhook, fmt.Sprintf("-hooks=%s", configPath), fmt.Sprintf("-ip=%s", ip), fmt.Sprintf("-port=%s", port), "-debug")
+	cmd.Stderr = logs
+	cmd.Env = webhookEnv()
+	foundPath := false
+	for i, value := range cmd.Env {
+		if strings.HasPrefix(value, "PATH=") {
+			cmd.Env[i] = "PATH=" + pathDir
+			foundPath = true
+			break
+		}
+	}
+	if !foundPath {
+		cmd.Env = append(cmd.Env, "PATH="+pathDir)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("failed to start webhook: %s", err)
+	}
+	defer killAndWait(cmd)
+	waitForServerReady(t, ip, port)
+
+	request := func(id string) (int, string) {
+		t.Helper()
+		res, err := http.Post(fmt.Sprintf("http://%s:%s/hooks/%s", ip, port, id), "application/json", strings.NewReader("{}"))
+		if err != nil {
+			t.Fatalf("POST hook %q: %v", id, err)
+		}
+		defer res.Body.Close()
+		body, err := ioutil.ReadAll(res.Body)
+		if err != nil {
+			t.Fatalf("read hook %q response: %v", id, err)
+		}
+		return res.StatusCode, string(body)
+	}
+
+	status, body := request("relative-lookup")
+	if status != http.StatusOK || !strings.Contains(body, "working-directory") || strings.Contains(body, "path-entry") {
+		t.Errorf("relative command should come from its configured working directory; got status %d and body %q", status, body)
+	}
+
+	status, _ = request("absolute-lookup")
+	if status == http.StatusOK {
+		t.Errorf("an absolute command that does not exist should not be found by prefixing its working directory; logs: %s", logs)
+	}
+}
