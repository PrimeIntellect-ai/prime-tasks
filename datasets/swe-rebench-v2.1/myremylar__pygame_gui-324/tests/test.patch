+class TestShakeEffect:
+    def test_tagged_chunk_shakes_over_time(self, _init_pygame, default_ui_manager: UIManager):
+        text_box = UITextBox('<effect id=test>Hello world</effect>',
+                             pygame.Rect((10, 10), (200, 100)),
+                             default_ui_manager)
+
+        text_box.set_active_effect(UITextEffectType('shake'), effect_tag='test')
+
+        rendered_frames = {pygame.image.tostring(text_box.image, 'RGBA')}
+        for _ in range(120):
+            try:
+                text_box.update(0.02)
+            except AttributeError:
+                # An unsupported effect on the base implementation has no frame to update.
+                break
+            rendered_frames.add(pygame.image.tostring(text_box.image, 'RGBA'))
+
+        assert len(rendered_frames) > 1
+
+
 class TestTextEffectType:
 
