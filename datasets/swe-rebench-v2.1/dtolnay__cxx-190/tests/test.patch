@@ -176,3 +176,65 @@ extern "C" fn cxx_test_suite_get_box() -> *mut cxx_test_suite::R {
 unsafe extern "C" fn cxx_test_suite_r_is_correct(r: *const cxx_test_suite::R) -> bool {
     *r == 2020
 }
+
+#[test]
+fn test_extern_type_alias_diagnostics() {
+    let t = trybuild::TestCases::new();
+    t.compile_fail("tests/ui/type_alias_rust.rs");
+
+    let temp = std::env::temp_dir().join(format!("cxx-type-id-test-{}", std::process::id()));
+    let src = temp.join("src");
+    std::fs::create_dir_all(&src).unwrap();
+    let manifest = format!(
+        "[package]\nname = \"type-id-test\"\nversion = \"0.0.0\"\nedition = \"2018\"\n\n[dependencies]\ncxx = {{ path = \"{}\" }}\n",
+        env!("CARGO_MANIFEST_DIR").replace('\\', "\\\\").replace('"', "\\\"")
+    );
+    std::fs::write(temp.join("Cargo.toml"), manifest).unwrap();
+    std::fs::write(src.join("main.rs"), include_str!("ui/wrong_type_id.rs")).unwrap();
+
+    let output = std::process::Command::new("cargo")
+        .args(&["check", "--manifest-path"])
+        .arg(temp.join("Cargo.toml"))
+        .arg("--offline")
+        .env("CARGO_TARGET_DIR", temp.join("target"))
+        .output()
+        .unwrap();
+    let _ = std::fs::remove_dir_all(&temp);
+    assert!(!output.status.success(), "the mismatched type identity compiled");
+    let diagnostics = String::from_utf8_lossy(&output.stderr);
+    assert!(diagnostics.contains("error[E0271]"), "{}", diagnostics);
+    assert!(
+        diagnostics.contains("<StringPiece as ExternType>::Id")
+            || diagnostics.contains("<here::StringPiece as cxx::extern_type::ExternType>::Id"),
+        "{}",
+        diagnostics
+    );
+    assert!(
+        diagnostics.contains("expected a tuple with 15 elements, found one with 17 elements"),
+        "{}", diagnostics
+    );
+    // rustc may elide crate paths when formatting the associated type's tuples.
+    let diagnostics = diagnostics.replace("cxx::", "");
+    assert!(
+        diagnostics.contains("expected tuple `(f, o, l, l, y, (), B, y, t, e, R, a, n, g, e)`"),
+        "{}",
+        diagnostics
+    );
+    assert!(
+        diagnostics.contains("found tuple `(f, o, l, l, y, (), S, t, r, i, n, g, P, i, e, c, e)`"),
+        "{}",
+        diagnostics
+    );
+    let diagnostic_lines: Vec<&str> = diagnostics.lines().collect();
+    let alias_line = "type ByteRange = crate::here::StringPiece;";
+    let source_line = diagnostic_lines
+        .iter()
+        .position(|line| line.contains(alias_line))
+        .expect("the E0271 diagnostic should show the ByteRange declaration");
+    let underline = diagnostic_lines[source_line + 1];
+    assert!(
+        underline.matches('^').count() >= "ByteRange".len(),
+        "the E0271 diagnostic should identify the mismatching alias: {}",
+        diagnostics
+    );
+}
