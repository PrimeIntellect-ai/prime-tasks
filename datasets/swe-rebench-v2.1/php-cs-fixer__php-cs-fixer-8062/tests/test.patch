+    public function testGetVariableNameHasNullableStringReturnType(): void
+    {
+        $returnType = (new \ReflectionMethod(Annotation::class, 'getVariableName'))->getReturnType();
+
+        self::assertNotNull($returnType, 'getVariableName() must declare a return type.');
+        self::assertTrue($returnType->allowsNull(), 'getVariableName() must allow null.');
+
+        if ($returnType instanceof \ReflectionNamedType) {
+            self::assertSame('string', $returnType->getName());
+        } else {
+            $typeNames = array_map(
+                static fn (\ReflectionNamedType $type): string => $type->getName(),
+                $returnType->getTypes()
+            );
+
+            self::assertContains('string', $typeNames);
+        }
+    }
