+func optionalStatusValues(t *testing.T, node M) []quad.Value {
+	t.Helper()
+	value, ok := node["status"]
+	if !ok || value == nil {
+		return nil
+	}
+	values := make([]quad.Value, 0)
+	appendValue := func(value interface{}) {
+		status, ok := value.(quad.Value)
+		require.Truef(t, ok, "unexpected status value %T", value)
+		values = append(values, status)
+	}
+	switch value := value.(type) {
+	case quad.Value:
+		values = append(values, value)
+	case []quad.Value:
+		values = append(values, value...)
+	case []interface{}:
+		for _, item := range value {
+			appendValue(item)
+		}
+	default:
+		require.FailNowf(t, "unexpected status value", "%T", value)
+	}
+	return values
+}
+
+func requireOptionalNodeResults(t *testing.T, want, got M) {
+	t.Helper()
+	wantNodes, ok := want["nodes"].([]M)
+	require.True(t, ok, "expected nodes in contract fixture")
+	gotNodes, ok := got["nodes"].([]M)
+	require.True(t, ok, "optional query must return its primary node results")
+
+	wantValues := make(map[interface{}][]quad.Value, len(wantNodes))
+	for _, node := range wantNodes {
+		wantValues[node["id"]] = optionalStatusValues(t, node)
+	}
+	gotValues := make(map[interface{}][]quad.Value, len(wantValues))
+	for _, node := range gotNodes {
+		id, exists := node["id"]
+		require.True(t, exists, "each primary result must include its id")
+		gotValues[id] = append(gotValues[id], optionalStatusValues(t, node)...)
+	}
+	require.Len(t, gotValues, len(wantValues), "optional fields must not filter or add primary nodes")
+	for id, expected := range wantValues {
+		actual, exists := gotValues[id]
+		require.True(t, exists, "missing primary node %v", id)
+		require.ElementsMatch(t, expected, actual, "optional status values for node %v", id)
+	}
+}
