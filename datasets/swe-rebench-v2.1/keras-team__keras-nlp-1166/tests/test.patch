+"""Tests for WordPieceTokenizer output shape inference on symbolic inputs."""
+
+import numpy as np
+
+from keras_nlp.backend import keras
+from keras_nlp.tests.test_case import TestCase
+from keras_nlp.tokenizers.word_piece_tokenizer import WordPieceTokenizer
+
+
+class WordPieceTokenizerSymbolicShapeTest(TestCase):
+    def setUp(self):
+        self.vocab = [
+            "[PAD]",
+            "[UNK]",
+            "[CLS]",
+            "[SEP]",
+            "air",
+            "##plane",
+            "at",
+            "port",
+        ]
+        self.sequence_length = 6
+        self.tokenizer = WordPieceTokenizer(
+            vocabulary=self.vocab,
+            sequence_length=self.sequence_length,
+        )
+
+    def test_symbolic_string_input_has_inferable_shape(self):
+        inputs = keras.Input(shape=(), dtype="string")
+        outputs = self.tokenizer(inputs)
+        self.assertEqual(tuple(outputs.shape), (None, self.sequence_length))
+
+    def test_compute_output_shape_for_batch_of_strings(self):
+        self.assertEqual(
+            tuple(self.tokenizer.compute_output_shape((None,))),
+            (None, self.sequence_length),
+        )
+        self.assertEqual(
+            tuple(self.tokenizer.compute_output_shape((3,))),
+            (3, self.sequence_length),
+        )
+
+    def test_functional_model_matches_eager_tokenization(self):
+        inputs = keras.Input(shape=(), dtype="string")
+        outputs = self.tokenizer(inputs)
+        model = keras.Model(inputs, outputs)
+        batch = np.array(["airplane at port", "air"])
+        model_output = model.predict(batch, verbose=0)
+        self.assertEqual(
+            tuple(model_output.shape), (2, self.sequence_length)
+        )
+        self.assertAllEqual(model_output, self.tokenizer(batch))
