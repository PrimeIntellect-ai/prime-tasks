+++ b/test/absinthe/schema/notation/experimental/import_directives_test.exs
@@ -0,0 +1,40 @@
+defmodule Absinthe.Schema.Notation.Experimental.ImportDirectivesTest do
+  use Absinthe.Case, async: true
+
+  @moduletag :experimental
+
+  defmodule Source do
+    use Absinthe.Schema.Notation
+
+    directive :one do
+      on [:field]
+    end
+
+    directive :two do
+      on [:field]
+    end
+
+    directive :three do
+      on [:field]
+    end
+  end
+
+  defmodule ImportingSchema do
+    use Absinthe.Schema
+
+    query do
+    end
+
+    directive :local_directive do
+      on [:field]
+    end
+
+    import_directives Source
+  end
+
+  test "imports directives and preserves locally defined directives" do
+    for name <- [:one, :two, :three, :local_directive] do
+      assert Absinthe.Schema.lookup_directive(ImportingSchema, name)
+    end
+  end
+end
