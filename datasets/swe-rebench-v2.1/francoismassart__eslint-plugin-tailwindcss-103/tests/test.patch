+
+describe("no-custom-classname nested callee arguments", function () {
+  var linter = new Linter();
+  linter.defineRule("no-custom-classname", rule);
+
+  var reportedClassNames = function (code) {
+    var messages = linter.verify(code, {
+      parserOptions: parserOptions,
+      rules: { "no-custom-classname": "error" },
+    });
+
+    return messages
+      .map(function (message) {
+        var match = message.message.match(/^Classname '(.+)' is not a Tailwind CSS class!$/);
+        return match && match[1];
+      })
+      .sort();
+  };
+
+  it("identifies invalid names in array elements and object keys", function () {
+    assert.deepStrictEqual(
+      reportedClassNames('classnames(["asdf"], [{"qwerty": boolVal}]);'),
+      ["asdf", "qwerty"]
+    );
+  });
+
+  it("identifies names within nested arrays reached through a conditional", function () {
+    assert.deepStrictEqual(
+      reportedClassNames(`classnames(
+        ["asdf foo"],
+        myFlag && ["bar", someBoolean ? ["baz"] : { "qwerty": someOtherFlag }]
+      );`),
+      ["asdf", "bar", "baz", "foo", "qwerty"]
+    );
+  });
+});
