+
+	t.Run("use a different time format", func(t *testing.T) {
+		var buf bytes.Buffer
+
+		// Use a distinctive layout that differs from the package default so
+		// that honoring the caller-supplied format is actually exercised. It
+		// contains no spaces so the timestamp is the first whitespace-delimited
+		// field.
+		const layout = "2006-01-02T15:04:05.000000000"
+
+		opts := &LoggerOptions{
+			Name:   "test",
+			Output: &buf,
+		}
+
+		// TimeFormat is an optional field. Set it through reflection so this
+		// test still compiles against implementations that do not yet provide
+		// the field, making the failure behavioural rather than a build error.
+		if f := reflect.ValueOf(opts).Elem().FieldByName("TimeFormat"); f.IsValid() && f.Kind() == reflect.String {
+			f.SetString(layout)
+		}
+
+		logger := New(opts)
+		logger.Info("this is test", "who", "programmer", "why", "testing is fun")
+
+		str := buf.String()
+
+		dataIdx := strings.IndexByte(str, ' ')
+		require.True(t, dataIdx > 0, "expected a timestamp prefix")
+
+		ts := str[:dataIdx]
+
+		// The timestamp must be rendered using the supplied layout.
+		_, err := time.Parse(layout, ts)
+		require.NoError(t, err, "timestamp was not formatted with the supplied layout")
+	})
+
+	t.Run("falls back to the default time format", func(t *testing.T) {
+		var buf bytes.Buffer
+
+		logger := New(&LoggerOptions{
+			Name:   "test",
+			Output: &buf,
+		})
+
+		logger.Info("this is test")
+
+		str := buf.String()
+
+		dataIdx := strings.IndexByte(str, ' ')
+		require.True(t, dataIdx > 0, "expected a timestamp prefix")
+
+		ts := str[:dataIdx]
+
+		// With no TimeFormat supplied the package default must be used.
+		_, err := time.Parse(TimeFormat, ts)
+		require.NoError(t, err, "timestamp was not formatted with the package default")
+	})
 }
 
