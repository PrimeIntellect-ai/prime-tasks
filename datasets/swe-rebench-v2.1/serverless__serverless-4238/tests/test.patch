+'use strict';
+
+const expect = require('chai').expect;
+const Serverless = require('../../../../../../Serverless');
+
+describe('Alexa Smart Home event configuration', () => {
+  it('compiles configured alexaSmartHome events into Lambda permissions', () => {
+    const serverless = new Serverless();
+    serverless.service.provider.name = 'aws';
+    serverless.service.provider.compiledCloudFormationTemplate = { Resources: {} };
+    serverless.service.functions = {
+      first: {
+        events: [
+          { alexaSmartHome: 'amzn1.ask.skill.xx-xx-xx-xx' },
+        ],
+      },
+    };
+
+    serverless.pluginManager.loadCorePlugins();
+    const compileEventHooks = serverless.pluginManager.getHooks('package:compileEvents');
+    return Promise.all(compileEventHooks.map(hook => hook.hook())).then(() => {
+      const resources = Object.values(
+        serverless.service.provider.compiledCloudFormationTemplate.Resources
+      );
+      const permissions = resources.filter(resource => resource.Type === 'AWS::Lambda::Permission');
+      const skillIds = permissions.map(permission => permission.Properties.EventSourceToken);
+
+      expect(skillIds).to.deep.equal(['amzn1.ask.skill.xx-xx-xx-xx']);
+    });
+  });
+});
