+// TestBoldDirectoryEntryIgnoresPermissionBits verifies that a directory entry
+// is displayed in bold independently of its permissions.
+func TestBoldDirectoryEntryIgnoresPermissionBits(t *testing.T) {
+	t.Setenv("LS_COLORS", "")
+	t.Setenv("LSCOLORS", "")
+	t.Setenv("LF_COLORS", "")
+
+	dirPath := t.TempDir()
+	filePath := filepath.Join(dirPath, "a-file")
+	if err := os.WriteFile(filePath, nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	childPath := filepath.Join(dirPath, "listed-dir")
+	if err := os.Mkdir(childPath, 0700); err != nil {
+		t.Fatal(err)
+	}
+
+	dir := newDir(dirPath)
+	// Keep the directory on a non-selected row so the check observes its
+	// ordinary entry style rather than cursor styling.
+	dir.files = []*file{newFile(filePath), newFile(childPath)}
+	dir.ind = 0
+	dir.pos = 0
+
+	screen := tcell.NewSimulationScreen("UTF-8")
+	if err := screen.Init(); err != nil {
+		t.Fatal(err)
+	}
+	defer screen.Fini()
+	screen.SetSize(50, 3)
+
+	ui := &ui{screen: screen}
+	window := newWin(50, 3, 0, 0)
+	window.printDir(ui, dir, &dirContext{}, &dirStyle{colors: parseStyles(), role: Active}, false)
+
+	for x := 0; x < 50; x++ {
+		r, _, style, _ := screen.GetContent(x, 1)
+		if r == 'l' {
+			_, _, attr := style.Decompose()
+			if attr&tcell.AttrBold == 0 {
+				t.Errorf("displayed directory %q is not bold", childPath)
+			}
+			return
+		}
+	}
+	t.Fatalf("directory name %q was not displayed", filepath.Base(childPath))
+}
