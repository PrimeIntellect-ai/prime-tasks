+def test_conversion_operators_decorated() -> None:
+    content = """
+      struct S {
+        operator const native_handle_t*() const { return mHandle; }
+      };
+    """
+    data = parse_string(content, cleandoc=True)
+
+    methods = data.namespace.classes[0].methods
+    assert len(methods) == 1
+    conversion = methods[0]
+    assert isinstance(conversion.return_type, Pointer)
+    assert conversion.return_type.ptr_to.const
+    assert conversion.const
