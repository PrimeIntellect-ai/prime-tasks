+func TestResolveGVRSinkThroughFlagNames(t *testing.T) {
+	pingSource := &v1beta2.PingSource{
+		TypeMeta:   metav1.TypeMeta{Kind: "PingSource", APIVersion: "sources.knative.dev/v1"},
+		ObjectMeta: metav1.ObjectMeta{Name: "foo", Namespace: "default"},
+	}
+	dynamicClient := dynamicfake.CreateFakeKnDynamicClient("default", pingSource)
+	for _, fname := range []string{"sink", "sink-reply", "sink-dead-letter", "dl-sink"} {
+		cmd := &cobra.Command{Use: "sinktest"}
+		sinkFlags := new(SinkFlags)
+		sinkFlags.AddWithFlagName(cmd, fname, "")
+		assert.NilError(t, cmd.Flags().Set(fname, "sources.knative.dev/v1/pingsource:foo"))
+		result, err := sinkFlags.ResolveSink(context.Background(), dynamicClient, "default")
+		assert.NilError(t, err, "flag %q should accept a GVR sink", fname)
+		assert.DeepEqual(t, result, &duckv1.Destination{Ref: &duckv1.KReference{
+			Kind:       "PingSource",
+			APIVersion: "sources.knative.dev/v1",
+			Namespace:  "default",
+			Name:       "foo",
+		}})
+	}
+}
