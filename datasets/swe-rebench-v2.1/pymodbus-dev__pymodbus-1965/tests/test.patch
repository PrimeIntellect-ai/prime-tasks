 """Test transport."""
+from __future__ import annotations
+
+import asyncio
 
 import pytest
 
@@ -24,5 +27,44 @@ class TestNetwork:
         stub = ModbusProtocolStub(use_cls, True)
         assert await stub.start_run()
         assert await client.connect()
+        test_data = b"Data got echoed."
+        client.transport.write(test_data)
         client.transport_close()
         stub.transport_close()
+
+    async def test_double_packet(self, use_port):
+        """A client decodes multiple replies delivered in one TCP write."""
+        async def send_coalesced_replies(reader, writer):
+            request = await reader.readexactly(12)
+            transaction_id = int.from_bytes(request[:2], "big")
+            replies = []
+            for offset, address in enumerate((1, 2)):
+                reply = (
+                    (transaction_id + offset).to_bytes(2, "big")
+                    + request[2:4]
+                    + b"\x00\x05"
+                    + request[6:7]
+                    + b"\x03\x02"
+                    + (address * 10).to_bytes(2, "big")
+                )
+                replies.append(reply)
+            writer.write(b"".join(replies))
+            await writer.drain()
+            writer.close()
+            await writer.wait_closed()
+
+        server = await asyncio.start_server(
+            send_coalesced_replies, "127.0.0.1", use_port
+        )
+        client = AsyncModbusTcpClient("127.0.0.1", port=use_port, retries=0)
+        try:
+            assert await client.connect()
+            replies = await asyncio.gather(
+                client.read_holding_registers(address=1, count=1),
+                client.read_holding_registers(address=2, count=1),
+            )
+            assert [reply.registers for reply in replies] == [[10], [20]]
+        finally:
+            client.transport_close()
+            server.close()
+            await server.wait_closed()
