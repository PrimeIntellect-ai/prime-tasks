diff --git a/tests/ops/op_math/test_sprod.py b/tests/ops/op_math/test_sprod.py
index 8ea66dfc..ffd31931 100644
--- a/tests/ops/op_math/test_sprod.py
+++ b/tests/ops/op_math/test_sprod.py
@@ -1144,3 +1144,30 @@ class TestArithmetic:
         assert adj_op.wires == final_op.wires
         assert adj_op.data == final_op.data
         assert adj_op.arithmetic_depth == final_op.arithmetic_depth
+
+
+def test_equal_commutator_results_with_reordered_terms():
+    """Equivalent commutators compare equal even when their terms are reordered."""
+    h1 = qml.prod(qml.PauliX(0), qml.PauliX(1))
+    h2 = qml.s_prod(1.0, qml.sum(qml.PauliY(0), qml.PauliY(1)))
+    expected = qml.sum(
+        qml.s_prod(2j, qml.PauliZ(0) @ qml.PauliX(1)),
+        qml.s_prod(2j, qml.PauliX(0) @ qml.PauliZ(1)),
+    )
+    result = qml.prod(h1, h2) - qml.prod(h2, h1)
+    result = result.simplify().simplify()
+    assert qml.equal(expected, result)
+
+
+def test_equal_commutator_results_with_legacy_operators():
+    """Equivalent legacy-operator commutators compare equal despite factor ordering."""
+    h1 = qml.Hamiltonian([1.0], [qml.PauliX(0) @ qml.PauliX(1)])
+    legacy_sum = qml.Hamiltonian([1.0, 1.0], [qml.PauliY(0), qml.PauliY(1)])
+    h2 = qml.s_prod(1.0, legacy_sum)
+    expected = qml.sum(
+        qml.s_prod(2j, qml.PauliZ(0) @ qml.PauliX(1)),
+        qml.s_prod(2j, qml.PauliX(0) @ qml.PauliZ(1)),
+    )
+    result = qml.prod(h1, h2) - qml.prod(h2, h1)
+    result = result.simplify().simplify()
+    assert qml.equal(expected, result)
