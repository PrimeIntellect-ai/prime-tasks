+
+// Issue #317
+#[test]
+fn type_mismatch_in_binary_expression() {
+    let mut builder = LibraryBuilder::new();
+    let _ = builder.code(
+        "libname",
+        "\
+package foo is
+    function takes_slv(din : bit_vector) return boolean;
+    constant bar : boolean := takes_slv(true) and true;
+end package;",
+    );
+
+    let diagnostics = builder.analyze();
+    assert!(
+        diagnostics
+            .iter()
+            .any(|diagnostic| diagnostic.message == "'true' does not match array type 'BIT_VECTOR'"),
+        "expected a type mismatch diagnostic for the invalid argument, got: {:?}",
+        diagnostics
+    );
+}
