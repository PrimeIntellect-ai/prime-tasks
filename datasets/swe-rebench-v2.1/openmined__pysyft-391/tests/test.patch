+class SplitTests(unittest.TestCase):
+    def test_split(self):
+        t = TensorBase(np.random.rand(7, 4))
+        split_size = 3
+        axis = 0
+        target_shapes = [(3, 4), (3, 4), (1, 4)]
+        splits = syft.math.split(t, split_size, axis)
+        self.assertIsInstance(splits, list)
+        self.assertEqual(len(splits), len(target_shapes))
+        for split in splits:
+            self.assertIsInstance(split, TensorBase)
+        start = 0
+        for target_shape, split in zip(target_shapes, splits):
+            self.assertTrue(syft.equal(split.shape(), target_shape))
+            self.assertTrue(syft.equal(t.narrow(axis, start, target_shape[axis]), split))
+            start += target_shape[axis]
+
+    def test_split_along_axis(self):
+        t = TensorBase(np.random.rand(4, 7))
+        split_size = 3
+        axis = 1
+        target_shapes = [(4, 3), (4, 3), (4, 1)]
+        splits = syft.math.split(t, split_size, axis)
+        self.assertIsInstance(splits, list)
+        self.assertEqual(len(splits), len(target_shapes))
+        for split in splits:
+            self.assertIsInstance(split, TensorBase)
+        start = 0
+        for target_shape, split in zip(target_shapes, splits):
+            self.assertTrue(syft.equal(split.shape(), target_shape))
+            self.assertTrue(syft.equal(t.narrow(axis, start, target_shape[axis]), split))
+            start += target_shape[axis]
+
+    def test_split_default_axis(self):
+        t = TensorBase(np.random.rand(7, 4))
+        split_size = 3
+        splits = syft.math.split(t, split_size)
+        target_shapes = [(3, 4), (3, 4), (1, 4)]
+        self.assertEqual(len(splits), len(target_shapes))
+        for target_shape, split in zip(target_shapes, splits):
+            self.assertTrue(syft.equal(split.shape(), target_shape))
+
+    def test_split_negative_axis(self):
+        t = TensorBase(np.random.rand(4, 7))
+        split_size = 3
+        splits = syft.math.split(t, split_size, -1)
+        target_shapes = [(4, 3), (4, 3), (4, 1)]
+        self.assertEqual(len(splits), len(target_shapes))
+        for target_shape, split in zip(target_shapes, splits):
+            self.assertTrue(syft.equal(split.shape(), target_shape))
+
+    def test_split_int_and_float(self):
+        t_int = TensorBase(np.arange(7))
+        t_float = TensorBase(np.arange(7, dtype=np.float64))
+        split_size = 3
+        int_splits = syft.math.split(t_int, split_size, 0)
+        float_splits = syft.math.split(t_float, split_size, 0)
+        self.assertEqual(len(int_splits), 3)
+        self.assertEqual(len(float_splits), 3)
+        for split in int_splits + float_splits:
+            self.assertIsInstance(split, TensorBase)
+        self.assertTrue(np.array_equal(int_splits[0].data, np.array([0, 1, 2])))
+        self.assertTrue(np.array_equal(int_splits[2].data, np.array([6])))
+        self.assertTrue(np.array_equal(float_splits[0].data, np.array([0., 1., 2.])))
+        self.assertTrue(np.array_equal(float_splits[2].data, np.array([6.])))
+
+    def test_split_documentation(self):
+        self.assertIsNotNone(syft.math.split.__doc__)
+        self.assertTrue(syft.math.split.__doc__.strip())
