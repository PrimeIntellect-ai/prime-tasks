@@ -0,0 +1,80 @@
+import distance from '../src';
+import packageDistance from '@plexis/distance';
+import * as plexis from '../../plexis/src';
+import {
+  distance as plexisDistance,
+  calcLevenshtein,
+  levenshtein
+} from '../../plexis/src';
+
+it('Should calculate Levenshtein Distance between two strings', () => {
+  expect(distance('book', 'back')).toBe(2);
+  expect(distance('black', 'back')).toBe(1);
+  expect(distance('Foo', 'Bar')).toBe(3);
+  expect(distance('cool', 'cool')).toBe(0);
+  expect(distance('There was a black cat', 'There was a black dog')).toBe(3);
+  expect(distance('!@#$', '!@#$')).toBe(0);
+  expect(distance('<table>', '<td>')).toBe(4);
+});
+
+it('Levenshtein Distance should be the same for the same strings', () => {
+  expect(distance('flaw', 'lawn')).toBe(2);
+  expect(distance('lawn', 'flaw')).toBe(2);
+  expect(distance('encyclopedia', 'cat')).toBe(11);
+  expect(distance('cat', 'encyclopedia')).toBe(11);
+});
+
+it('Should return a number', () => {
+  expect(typeof distance('book', 'back')).toBe('number');
+});
+
+
+it('returns the length when either string is empty', () => {
+  expect(distance('', 'cat')).toBe(3);
+  expect(distance('cat', '')).toBe(3);
+  expect(distance('', '')).toBe(0);
+});
+
+it('is available as the default export from @plexis/distance', () => {
+  expect(packageDistance('book', 'back')).toBe(2);
+});
+
+it('exposes the distance aliases from the plexis barrel', () => {
+  expect(plexisDistance('book', 'back')).toBe(2);
+  expect(calcLevenshtein('book', 'back')).toBe(2);
+  expect(levenshtein('book', 'back')).toBe(2);
+});
+
+it('keeps the existing plexis utilities available', () => {
+  expect(Object.keys(plexis)).toEqual(
+    expect.arrayContaining([
+      '_do',
+      'calcLevenshtein',
+      'cleanDiacritics',
+      'compose',
+      'decapitalize',
+      'distance',
+      'isLower',
+      'isLowerCase',
+      'isString',
+      'isUpper',
+      'isUpperCase',
+      'levenshtein',
+      'removeDiacritics',
+      'startsWith',
+      'titleize',
+      'toChicagoManualStyle',
+      'toChicagoStyle',
+      'toChicagoTitle',
+      'toFirstLower',
+      'toLower',
+      'toPred',
+      'toPredecessor',
+      'toSucc',
+      'toSuccessor',
+      'toTitle',
+      'toTurabian',
+      'withoutDiacritics'
+    ])
+  );
+});
