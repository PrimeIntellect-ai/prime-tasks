+
+type regionRequestNilCauseTestError struct {
+	error
+}
+
+func (_ regionRequestNilCauseTestError) Cause() error {
+	return nil
+}
+
+func (s *testRegionRequestToSingleStoreSuite) TestRequestSendWithNilCauseDoesNotPanic() {
+	region, err := s.cache.LocateRegionByID(s.bo, s.region)
+	s.Require().NoError(err)
+	s.Require().NotNil(region)
+
+	s.regionRequestSender.Stats = NewRegionRequestRuntimeStats()
+	s.regionRequestSender.client = &fnClient{fn: func(context.Context, string, *tikvrpc.Request, time.Duration) (*tikvrpc.Response, error) {
+		return nil, regionRequestNilCauseTestError{error: errors.New("send failed without a cause")}
+	}}
+	req := tikvrpc.NewRequest(tikvrpc.CmdRawPut, &kvrpcpb.RawPutRequest{Key: []byte("key"), Value: []byte("value")})
+	bo := retry.NewBackofferWithVars(context.Background(), 5, nil)
+
+	s.Require().NotPanics(func() {
+		_, _, _ = s.regionRequestSender.SendReq(bo, req, region.Region, time.Second)
+	})
+}
+
+func (s *testRegionRequestToSingleStoreSuite) TestSendFailureWithNilCauseDoesNotPanic() {
+	region, err := s.cache.LocateRegionByID(s.bo, s.region)
+	s.Require().NoError(err)
+	s.Require().NotNil(region)
+
+	s.regionRequestSender.Stats = nil
+	s.regionRequestSender.client = &fnClient{fn: func(context.Context, string, *tikvrpc.Request, time.Duration) (*tikvrpc.Response, error) {
+		return nil, regionRequestNilCauseTestError{error: errors.New("send failed without a cause")}
+	}}
+	req := tikvrpc.NewRequest(tikvrpc.CmdRawPut, &kvrpcpb.RawPutRequest{Key: []byte("key"), Value: []byte("value")})
