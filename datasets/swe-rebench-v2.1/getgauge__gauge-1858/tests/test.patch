+func TestLanguageServerServesReferencesAfterInitializationLifecycle(t *testing.T) {
+	provider = &dummyInfoProvider{}
+	projectDir := t.TempDir()
+	manifest := []byte(`{"Language":"typescript"}`)
+	if err := os.WriteFile(filepath.Join(projectDir, "manifest.json"), manifest, 0600); err != nil {
+		t.Fatalf("could not create Gauge project: %v", err)
+	}
+
+	initializeParams, err := json.Marshal(InitializeParams{RootPath: projectDir})
+	if err != nil {
+		t.Fatalf("could not encode initialize parameters: %v", err)
+	}
+	initializeRequest := &jsonrpc2.Request{Method: "initialize", Params: (*json.RawMessage)(&initializeParams)}
+	server := &LangHandler{}
+	if _, err := server.Handle(context.Background(), nil, initializeRequest); err != nil {
+		t.Fatalf("language server initialization failed: %v", err)
+	}
+
+	uri := util.ConvertPathToURI("foo.spec")
+	openParams, err := json.Marshal(lsp.DidOpenTextDocumentParams{TextDocument: lsp.TextDocumentItem{
+		URI: uri,
+		Text: `Specification Heading
+=====================
+
+Scenario Heading
+----------------
+
+* Say <hello> to <gauge>`,
+	}})
+	if err != nil {
+		t.Fatalf("could not encode document-open parameters: %v", err)
+	}
+	openRequest := &jsonrpc2.Request{Method: "textDocument/didOpen", Params: (*json.RawMessage)(&openParams)}
+	if _, err := server.Handle(context.Background(), nil, openRequest); err != nil {
+		t.Fatalf("language server could not open a document after initialization: %v", err)
+	}
+
+	referenceParams, err := json.Marshal([]string{"Say {} to {}"})
+	if err != nil {
+		t.Fatalf("could not encode reference parameters: %v", err)
+	}
+	referenceRequest := &jsonrpc2.Request{Method: "gauge/stepReferences", Params: (*json.RawMessage)(&referenceParams)}
+	got, err := server.Handle(context.Background(), nil, referenceRequest)
+	if err != nil {
+		t.Fatalf("language server could not serve references after initialization: %v", err)
+	}
+	locations, ok := got.([]lsp.Location)
+	if !ok || len(locations) == 0 {
+		t.Fatalf("expected references after initialization, got %v", got)
+	}
+}
