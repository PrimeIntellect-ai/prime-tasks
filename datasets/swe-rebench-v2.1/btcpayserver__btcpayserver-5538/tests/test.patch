+        [Fact]
+        public async Task CanDetectWebhookOverPaid()
+        {
+            var logs = new Logs();
+            var aggregator = new EventAggregator(logs);
+            var dbFile = Path.Combine(Path.GetTempPath(), "webhooktest_" + Guid.NewGuid().ToString("N") + ".db");
+            var dbOptions = Options.Create(new DatabaseOptions { DatabaseType = DatabaseType.Sqlite, ConnectionString = "Data Source=" + dbFile });
+            var dbFactory = new ApplicationDbContextFactory(dbOptions);
+            try
+            {
+                using (var ctx = dbFactory.CreateContext())
+                    await ctx.Database.MigrateAsync();
+                var storeRepo = new StoreRepository(dbFactory, new JsonSerializerSettings(), aggregator, null);
+                var sender = new WebhookSender(storeRepo, null, dbFactory, NullLogger<WebhookSender>.Instance, null, aggregator);
+                var provider = new InvoiceWebhookProvider(sender, aggregator, NullLogger<InvoiceWebhookProvider>.Instance);
+                await provider.StartAsync(CancellationToken.None);
+
+                // InvoiceSettled webhook for an over-paid invoice must carry overPaid = true
+                var settledOverPaid = await PublishInvoiceEvent(aggregator, InvoiceEvent.MarkedCompleted, InvoiceExceptionStatus.PaidOver);
+                Assert.True(ReadOverPaid(settledOverPaid) == true);
 
+                // InvoiceSettled webhook for a normally paid invoice must carry overPaid = false
+                var settledNormal = await PublishInvoiceEvent(aggregator, InvoiceEvent.MarkedCompleted, InvoiceExceptionStatus.None);
+                Assert.True(ReadOverPaid(settledNormal) == false);
+
+                // InvoiceProcessing webhook for an over-paid invoice must carry overPaid = true
+                var processingOverPaid = await PublishInvoiceEvent(aggregator, InvoiceEvent.PaidInFull, InvoiceExceptionStatus.PaidOver);
+                Assert.True(ReadOverPaid(processingOverPaid) == true);
+
+                // InvoiceProcessing webhook for a normally paid invoice must carry overPaid = false
+                var processingNormal = await PublishInvoiceEvent(aggregator, InvoiceEvent.PaidInFull, InvoiceExceptionStatus.None);
+                Assert.True(ReadOverPaid(processingNormal) == false);
+            }
+            finally
+            {
+                if (File.Exists(dbFile))
+                    File.Delete(dbFile);
+            }
+        }
+
+        private static async Task<WebhookEvent> PublishInvoiceEvent(EventAggregator aggregator, string eventName, InvoiceExceptionStatus status)
+        {
+            var invoice = new InvoiceEntity { StoreId = "store1", ExceptionStatus = status, Metadata = new InvoiceMetadata() };
+            var evt = new InvoiceEvent(invoice, eventName);
+            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
+            var waitTask = aggregator.WaitNext<WebhookSender.WebhookDeliveryRequest>(cts.Token);
+            aggregator.Publish(evt);
+            var req = await waitTask;
+            return req.WebhookEvent;
+        }
+
+        private static bool? ReadOverPaid(WebhookEvent webhookEvent)
+        {
+            var json = JsonConvert.SerializeObject(webhookEvent, WebhookEvent.DefaultSerializerSettings);
+            var obj = JObject.Parse(json);
+            return obj["overPaid"]?.Value<bool>();
+        }
