+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+import os
+
+import pytest
+
+import cfnlint
+from cfnlint.config import ConfigMixIn
+from cfnlint.decode.decode import decode_str
+from cfnlint.rules import Rules
+from cfnlint.rules.resources.s3.BucketTieringConfiguration import (
+    BucketTieringConfiguration,
+)
+from cfnlint.runner import TemplateRunner
+
+
+@pytest.fixture(scope="module")
+def rule():
+    rule = BucketTieringConfiguration()
+    yield rule
+
+
+@pytest.mark.parametrize(
+    "instance,should_report_range_error",
+    [
+        ({"AccessTier": "ARCHIVE_ACCESS", "Days": 89}, True),
+        ({"AccessTier": "ARCHIVE_ACCESS", "Days": 90}, False),
+        ({"AccessTier": "ARCHIVE_ACCESS", "Days": 730}, False),
+        ({"AccessTier": "ARCHIVE_ACCESS", "Days": 731}, True),
+        ({"AccessTier": "DEEP_ARCHIVE_ACCESS", "Days": 179}, True),
+        ({"AccessTier": "DEEP_ARCHIVE_ACCESS", "Days": 180}, False),
+        ({"AccessTier": "DEEP_ARCHIVE_ACCESS", "Days": 730}, False),
+        ({"AccessTier": "DEEP_ARCHIVE_ACCESS", "Days": 731}, True),
+    ],
+)
+def test_validate(instance, should_report_range_error, rule, validator):
+    errs = list(rule.validate(validator, "", instance, {}))
+
+    if should_report_range_error:
+        assert errs, f"Expected a range error for {instance!r}"
+    else:
+        assert not errs, f"Expected no errors for in-range configuration {instance!r}"
+
+
+def test_rule_applies_to_intelligent_tiering_configurations():
+    rules = Rules.create_from_directory(
+        os.path.join(os.path.dirname(cfnlint.__file__), "rules")
+    )
+    template, _ = decode_str(
+        """
+Resources:
+  MyBucket:
+    Type: AWS::S3::Bucket
+    Properties:
+      IntelligentTieringConfigurations:
+        - Id: ColdIntelligentTieringConfig
+          Status: Enabled
+          Tierings:
+            - AccessTier: ARCHIVE_ACCESS
+              Days: 1
+"""
+    )
+    runner = TemplateRunner(None, template, ConfigMixIn([]), rules)
+    matches = list(runner.run())
+    assert any(
+        match.rule.id == "E3061" for match in matches
+    ), f"Expected E3061 to be raised, got {matches}"
