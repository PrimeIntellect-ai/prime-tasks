+func TestServiceToMeshServicesWarnsOnImplicitHTTP(t *testing.T) {
+	assert := tassert.New(t)
+
+	stop := make(chan struct{})
+	defer close(stop)
+
+	// Provide matching endpoints so that the only warning emitted is the one
+	// about the implicitly selected app protocol.
+	endpoints := &corev1.Endpoints{
+		ObjectMeta: metav1.ObjectMeta{
+			Namespace: "ns1",
+			Name:      "s1",
+		},
+		Subsets: []corev1.EndpointSubset{
+			{
+				Ports: []corev1.EndpointPort{
+					{
+						Name: "p1",
+						Port: 8080,
+					},
+				},
+			},
+		},
+	}
+	fakeClient := testclient.NewSimpleClientset(endpoints)
+	k8sClient, err := k8s.NewClient(tests.OsmNamespace, tests.OsmMeshConfigName, messaging.NewBroker(stop),
+		k8s.WithKubeClient(fakeClient, "test-mesh"),
+	)
+	assert.NoError(err)
+	c := NewClient(k8sClient)
+
+	svc := corev1.Service{
+		ObjectMeta: metav1.ObjectMeta{
+			Namespace: "ns1",
+			Name:      "s1",
+		},
+		Spec: corev1.ServiceSpec{
+			ClusterIP: "10.0.0.1",
+			Ports: []corev1.ServicePort{
+				{
+					Name:     "p1",
+					Port:     80,
+					Protocol: corev1.ProtocolTCP,
+				},
+			},
+		},
+	}
+
+	var actual []service.MeshService
+	output := captureStderr(t, func() {
+		actual = c.serviceToMeshServices(svc)
+	})
+	assert.Len(actual, 1)
+	assert.Equal("http", actual[0].Protocol)
+
+	// The app protocol was not explicitly specified, so a warning must be
+	// logged to indicate that http was selected implicitly.
+	assert.Contains(output, `"level":"warn"`)
+}
+
+// captureStderr runs fn while capturing everything written to the process's
+// standard error stream, and returns the captured output.
+func captureStderr(t *testing.T, fn func()) string {
+	t.Helper()
+
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("failed to create pipe: %v", err)
+	}
+
+	// Duplicate the current stderr file descriptor so it can be restored later.
+	origFd, err := syscall.Dup(int(os.Stderr.Fd()))
+	if err != nil {
+		t.Fatalf("failed to duplicate stderr: %v", err)
+	}
+
+	if err := syscall.Dup2(int(w.Fd()), int(os.Stderr.Fd())); err != nil {
+		t.Fatalf("failed to redirect stderr: %v", err)
+	}
+
+	done := make(chan string, 1)
+	go func() {
+		var buf bytes.Buffer
+		_, _ = io.Copy(&buf, r)
+		done <- buf.String()
+	}()
+
+	fn()
+
+	// Restore stderr and close the write end so the reader can finish.
+	_ = syscall.Dup2(origFd, int(os.Stderr.Fd()))
+	_ = syscall.Close(origFd)
+	_ = w.Close()
+
+	return <-done
+}
