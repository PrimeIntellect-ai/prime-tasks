+func TestServiceToMeshServicesUDPPortResultsInConfigError(t *testing.T) {
+	assert := tassert.New(t)
+
+	stop := make(chan struct{})
+	defer close(stop)
+	fakeClient := testclient.NewSimpleClientset()
+	k8sClient, err := k8s.NewClient(tests.OsmNamespace, tests.OsmMeshConfigName, messaging.NewBroker(stop),
+		k8s.WithKubeClient(fakeClient, "test-mesh"),
+	)
+	assert.NoError(err)
+	c := NewClient(k8sClient)
+
+	svc := corev1.Service{
+		ObjectMeta: metav1.ObjectMeta{
+			Namespace: "ns1",
+			Name:      "s1",
+		},
+		Spec: corev1.ServiceSpec{
+			ClusterIP: "10.0.0.1",
+			Ports: []corev1.ServicePort{
+				{
+					Name:     "p1",
+					Port:     80,
+					Protocol: corev1.ProtocolUDP,
+				},
+			},
+		},
+	}
+
+	meshServices := c.serviceToMeshServices(svc)
+	assert.Len(meshServices, 1)
+	// A UDP port whose app protocol cannot be detected must be left unset.
+	assert.Empty(meshServices[0].Protocol)
+
+	// Building the Envoy config for the unset protocol must log an error.
+	output := captureStderr(t, func() {
+		lb := lds.ListenerBuilder().
+			ProxyIdentity(tests.BookstoreServiceIdentity).
+			TrafficDirection(xds_core.TrafficDirection_INBOUND).
+			InboundMeshTrafficMatches([]*trafficpolicy.TrafficMatch{
+				{
+					Name:                "udp-port",
+					DestinationPort:     int(meshServices[0].Port),
+					DestinationProtocol: meshServices[0].Protocol,
+				},
+			})
+		_, _ = lb.Build()
+	})
+	assert.Contains(output, `"level":"error"`)
+}
