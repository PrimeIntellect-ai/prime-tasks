+package app
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/grafana/grafana-plugin-sdk-go/backend"
+	"github.com/grafana/grafana-plugin-sdk-go/backend/instancemgmt"
+	"github.com/stretchr/testify/require"
+)
+
+func TestManagedAppInstanceUsesRequestSettings(t *testing.T) {
+	updated := time.Date(2024, time.January, 2, 3, 4, 5, 0, time.UTC)
+	settings := backend.AppInstanceSettings{
+		JSONData:                json.RawMessage(`{"endpoint":"https://example.test"}`),
+		DecryptedSecureJSONData: map[string]string{"token": "secret"},
+		Updated:                 updated,
+	}
+
+	var factorySettings backend.AppInstanceSettings
+	manager := NewInstanceManager(func(received backend.AppInstanceSettings) (instancemgmt.Instance, error) {
+		factorySettings = received
+		return struct{}{}, nil
+	})
+
+	instance, err := manager.Get(backend.PluginContext{
+		PluginID:            "example-app",
+		OrgID:               42,
+		AppInstanceSettings: &settings,
+	})
+	require.NoError(t, err, "a managed app request has app settings rather than datasource settings")
+	require.NotNil(t, instance)
+	require.JSONEq(t, string(settings.JSONData), string(factorySettings.JSONData))
+	require.Equal(t, settings.DecryptedSecureJSONData, factorySettings.DecryptedSecureJSONData)
+	require.True(t, settings.Updated.Equal(factorySettings.Updated))
+}
