+describe('YAML Title exposed escape choices', () => {
+  it('offers None, Single Quote, and Double Quote', () => {
+    const escapeOption = YamlTitle.getRule().options.find((option) => {
+      const values = (option as {options?: {value: string}[]}).options?.map((choice) => choice.value);
+      return ['None', 'Single Quote', 'Double Quote'].every((value) => values?.includes(value));
+    });
+    expect(escapeOption).toBeDefined();
