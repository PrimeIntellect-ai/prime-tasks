+func TestGetBasicUserDataContainerRuntime(t *testing.T) {
+	var (
+		k             = MockKubernetesClientSet()
+		ig            = MockInstanceGroup()
+		asgMock       = NewAutoScalingMocker()
+		iamMock       = NewIamMocker()
+		eksMock       = NewEksMocker()
+		ec2Mock       = NewEc2Mocker()
+		configuration = ig.GetEKSConfiguration()
+	)
+
+	w := MockAwsWorker(asgMock, iamMock, eksMock, ec2Mock)
+	ctx := MockContext(ig, k, w)
+
+	configuration.BootstrapOptions = &v1alpha1.BootstrapOptions{}
+	if err := json.Unmarshal([]byte(`{"maxPods":5,"containerRuntime":"containerd"}`), configuration.BootstrapOptions); err != nil {
+		t.Fatal(err)
+	}
+
+	args := ctx.GetBootstrapArgs()
+	kubeletArgs := ctx.GetKubeletExtraArgs()
+	userDataPayload := ctx.GetUserDataStages()
+	mounts := ctx.GetMountOpts()
+
+	userData := ctx.GetBasicUserData("foo", args, kubeletArgs, userDataPayload, mounts)
+	basicUserDataDecoded, _ := base64.StdEncoding.DecodeString(userData)
+	basicUserDataString := string(basicUserDataDecoded)
+	if !strings.Contains(basicUserDataString, "--use-max-pods false --container-runtime containerd --b64-cluster-ca ") {
+		t.Fatalf("expected bootstrap arguments to place the container runtime between max-pods and cluster CA arguments, got: %v", basicUserDataString)
+	}
+}
