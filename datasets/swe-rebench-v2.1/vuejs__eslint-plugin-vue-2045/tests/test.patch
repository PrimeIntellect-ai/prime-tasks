+describe('attribute-hyphenation autofix with underscore-containing attributes', () => {
+  /**
+   * @param {string} code
+   * @param {string} option
+   */
+  function fixWith(code, option) {
+    const linter = new Linter()
+    linter.defineParser('vue-eslint-parser', require('vue-eslint-parser'))
+    linter.defineRule('vue/attribute-hyphenation', rule)
+    const config = {
+      parser: 'vue-eslint-parser',
+      parserOptions: { ecmaVersion: 2015 },
+      rules: { 'vue/attribute-hyphenation': ['error', option] }
+    }
+    return linter.verifyAndFix(code, config, { filename: 'test.vue' }).output
+  }
+
+  const cases = [
+    {
+      code: '<template><div><custom :attr_Gg="prop"></custom></div></template>',
+      option: 'always'
+    },
+    {
+      code: '<template><div><custom :Attr_Hh="prop"></custom></div></template>',
+      option: 'always'
+    },
+    {
+      code: '<template><div><custom :_attr_Jj="prop"></custom></div></template>',
+      option: 'always'
+    },
+    {
+      code: '<template><div><custom :_attrKk="prop"></custom></div></template>',
+      option: 'always'
+    },
+    {
+      code: '<template><div><custom :_AttrLl="prop"></custom></div></template>',
+      option: 'always'
+    },
+    {
+      code: '<template><div><custom :my-custom_prop="prop"></custom></div></template>',
+      option: 'never'
+    }
+  ]
+
+  for (const { code, option } of cases) {
+    it(`does not rename underscore-containing attributes in ${code} (${option})`, () => {
+      assert.strictEqual(fixWith(code, option), code)
+    })
+  }
+})
