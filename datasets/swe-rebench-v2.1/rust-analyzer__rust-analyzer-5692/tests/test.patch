+#[test]
+fn test_extern_crate() {
+    check_highlighting(
+        r#"
+        //- /main.rs
+        extern crate std;
+        extern crate alloc as abc;
+        //- /std/lib.rs
+        pub struct S;
+        //- /alloc/lib.rs
+        pub struct A
+        "#,
+        expect_file!["crates/ra_ide/test_data/highlight_extern_crate.html"],
+        false,
+    );
+}
+
+#[test]
+fn test_go_to_definition_on_extern_crate_name() {
+    use crate::mock_analysis::MockAnalysis;
+
+    let (mock, position) = MockAnalysis::with_files_and_position(
+        r#"
+        //- /main.rs
+        extern crate st<|>d;
+        //- /std/lib.rs
+        pub struct Target;
+        "#,
+    );
+    let analysis = mock.analysis();
+    let nav = analysis
+        .goto_definition(position)
+        .unwrap()
+        .unwrap()
+        .info
+        .into_iter()
+        .next()
+        .unwrap();
+    assert!(analysis.file_text(nav.file_id).unwrap().contains("pub struct Target;"));
+}
