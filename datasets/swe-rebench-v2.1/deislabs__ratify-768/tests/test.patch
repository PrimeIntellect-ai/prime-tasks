+
+func TestBlobToSPDXSPDX23(t *testing.T) {
+	spdx23Bytes := []byte("" +
+		"SPDXVersion: SPDX-2.3\n" +
+		"DataLicense: CC0-1.0\n" +
+		"SPDXID: SPDXRef-DOCUMENT\n" +
+		"DocumentName: localhost-5000/test-v1\n" +
+		"DocumentNamespace: localhost-5000/test-v1-c0e2605b-0d32-45e2-9ed3-530611f8798e\n" +
+		"Creator: Tool: test-0.0.0\n" +
+		"Created: 2021-12-17T20:24:36Z\n")
+	spdxDoc, err := BlobToSPDX(spdx23Bytes)
+	if err != nil {
+		t.Fatalf("could not parse SPDX 2.3 doc from bytes: %v", err)
+	}
+	expected := "localhost-5000/test-v1"
+	if spdxDoc.DocumentName != expected {
+		t.Fatalf("expected: %s, got: %s", expected, spdxDoc.DocumentName)
+	}
+}
+
+func TestToolsGolangDependencyVersion(t *testing.T) {
+	_, thisFile, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatalf("could not determine test file location")
+	}
+	dir := filepath.Dir(thisFile)
+	var goModPath string
+	for {
+		candidate := filepath.Join(dir, "go.mod")
+		if _, err := os.Stat(candidate); err == nil {
+			goModPath = candidate
+			break
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			break
+		}
+		dir = parent
+	}
+	if goModPath == "" {
+		t.Fatalf("could not locate go.mod")
+	}
+	data, err := os.ReadFile(goModPath)
+	if err != nil {
+		t.Fatalf("could not read go.mod: %v", err)
+	}
+	if !strings.Contains(string(data), "github.com/spdx/tools-golang v0.5.0") {
+		t.Fatalf("expected go.mod to require github.com/spdx/tools-golang v0.5.0")
+	}
+}
