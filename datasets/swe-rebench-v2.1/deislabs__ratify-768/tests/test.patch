+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+package main
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/deislabs/ratify/pkg/common"
+	"github.com/deislabs/ratify/pkg/ocispecs"
+	"github.com/deislabs/ratify/pkg/referrerstore"
+	"github.com/deislabs/ratify/pkg/referrerstore/config"
+	"github.com/deislabs/ratify/pkg/verifier"
+	"github.com/deislabs/ratify/pkg/verifier/plugin/skel"
+	"github.com/opencontainers/go-digest"
+	oci "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+type sbomTestStore struct {
+	blob []byte
+}
+
+func (s sbomTestStore) Name() string { return "sbom-test-store" }
+func (s sbomTestStore) ListReferrers(context.Context, common.Reference, []string, string, *ocispecs.SubjectDescriptor) (referrerstore.ListReferrersResult, error) {
+	return referrerstore.ListReferrersResult{}, nil
+}
+func (s sbomTestStore) GetBlobContent(context.Context, common.Reference, digest.Digest) ([]byte, error) {
+	return s.blob, nil
+}
+func (sbomTestStore) GetReferenceManifest(context.Context, common.Reference, ocispecs.ReferenceDescriptor) (ocispecs.ReferenceManifest, error) {
+	return ocispecs.ReferenceManifest{Blobs: []oci.Descriptor{{MediaType: SpdxJsonMediaType}}}, nil
+}
+func (sbomTestStore) GetConfig() *config.StoreConfig { return nil }
+func (sbomTestStore) GetSubjectDescriptor(context.Context, common.Reference) (*ocispecs.SubjectDescriptor, error) {
+	return nil, nil
+}
+
+func runSBOMVerifier(t *testing.T, fixture string) (*verifier.VerifierResult, error) {
+	t.Helper()
+	blob, err := os.ReadFile(filepath.Join("testdata", fixture))
+	if err != nil {
+		t.Fatalf("read SPDX JSON fixture: %v", err)
+	}
+
+	args := &skel.CmdArgs{StdinData: []byte(`{"config":{"name":"test"}}`)}
+	manifest := ocispecs.ReferenceDescriptor{}
+	subject := common.Reference{Original: "example.com/image:latest"}
+	return VerifyReference(args, subject, manifest, sbomTestStore{blob: blob})
+}
+
+func TestVerifyReferenceProcessesSPDXJSON(t *testing.T) {
+	result, err := runSBOMVerifier(t, "bom.json")
+	if err != nil {
+		t.Fatalf("valid SPDX 2.3 JSON should be processed without an error: %v", err)
+	}
+	if result == nil || !result.IsSuccess {
+		t.Fatalf("valid SPDX 2.3 JSON should produce a successful verification result")
+	}
+}
+
+func TestVerifyReferenceRejectsInvalidSPDXJSON(t *testing.T) {
+	_, err := runSBOMVerifier(t, "invalid-bom.json")
+	if err == nil {
+		t.Fatal("JSON that is not a valid SPDX document should return an error")
+	}
+}
