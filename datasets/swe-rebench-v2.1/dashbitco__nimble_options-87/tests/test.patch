+                  message: message
                 }}
     end
 
@@ -968,6 +970,41 @@ defmodule NimbleOptionsTest do
              }
     end
 
+    for subtype <- [:keyword_list, :non_empty_keyword_list] do
+      test "{:list, subtype} with a #{inspect(subtype)} subtype" do
+        type = {:custom, __MODULE__, :string_to_integer, []}
+        schema = [opts_list: [type: {:list, {unquote(subtype), str: [type: type]}}]]
+
+        # Valid
+        opts = [opts_list: [[str: "1"], [str: "2"]]]
+
+        assert NimbleOptions.validate(opts, schema) ==
+                 {:ok, [opts_list: [[str: 1], [str: 2]]]}
+
+        # Invalid
+        opts = [opts_list: [[str: "123"], [str: "not an int"]]]
+
+        assert {:error, %NimbleOptions.ValidationError{} = error} =
+                 NimbleOptions.validate(opts, schema)
+
+        assert error.key == :opts_list
+        assert error.value == [[str: "123"], [str: "not an int"]]
+        assert error.message =~ "list element at position 1 in :opts_list failed validation:"
+        assert error.message =~ "expected string to be convertible to integer"
+      end
+    end
+
+    test "{:list, {:non_empty_keyword_list, keys}} rejects an empty element" do
+      schema = [opts_list: [type: {:list, {:non_empty_keyword_list, []}}]]
+      opts = [opts_list: [[]]]
+
+      assert {:error, %ValidationError{} = error} = NimbleOptions.validate(opts, schema)
+      assert error.key == :opts_list
+      assert error.value == [[]]
+      assert error.message =~ "list element at position 0 in :opts_list failed validation:"
+      assert error.message =~ "non-empty keyword list"
+    end
+
     test "valid {:tuple, tuple_def}" do
       schema = [result: [type: {:tuple, [{:in, [:ok, :error]}, :string]}]]
 
