+def test_dotted_set_preserves_higher_level_sibling():
+    settings = Dynaconf()
+    settings.set("a.b", 1)
+    settings.set("a.c", 2)
+    settings.set("a.c.k", 22)
+
+    settings.set("a.c.b", 3)
+
+    assert settings.a.b == 1
+    assert settings.a.c == {"b": 3, "k": 22}
