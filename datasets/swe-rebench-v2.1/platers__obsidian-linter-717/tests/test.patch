+import RemoveSpaceBeforeOrAfterCharacters from '../src/rules/remove-space-before-or-after-characters';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: RemoveSpaceBeforeOrAfterCharacters,
+  testCases: [
+    {
+      testName: 'Removes the space before punctuation in ordinary text',
+      before: 'a word , another word .',
+      after: 'a word, another word.',
+    },
+    {
+      testName: 'Removes the spaces before and after full-width Chinese punctuation',
+      options: {
+        charactersToRemoveSpacesBefore: '，。',
+        charactersToRemoveSpacesAfter: '，。',
+      },
+      before: 'english ， english。',
+      after: 'english，english。',
+    },
+    {
+      testName: 'Removes a tab before a full-width comma and the spaces after it',
+      options: {
+        charactersToRemoveSpacesBefore: '，',
+        charactersToRemoveSpacesAfter: '，',
+      },
+      before: 'This is a fullwidth comma\t，  with text after it.',
+      after: 'This is a fullwidth comma，with text after it.',
+    },
+    {
+      testName: 'Removes tabs after a character listed in charactersToRemoveSpacesAfter',
+      options: {
+        charactersToRemoveSpacesBefore: '，',
+        charactersToRemoveSpacesAfter: '（',
+      },
+      before: 'This is a fullwidth paren （\t\tfollowed by a tab and  spaces.',
+      after: 'This is a fullwidth paren （followed by a tab and  spaces.',
+    },
+  ],
+});
