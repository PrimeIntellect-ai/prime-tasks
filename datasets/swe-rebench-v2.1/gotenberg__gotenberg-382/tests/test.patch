+func TestChromium_PDF_ProxyServerFlag(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		flagValue string
+		expect    bool
+	}{
+		{name: "configured proxy", flagValue: "http://proxy.test:8080", expect: true},
+		{name: "empty proxy", flagValue: "", expect: false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			browserPath := filepath.Join(dir, "chromium")
+			argsPath := filepath.Join(dir, "chromium-args")
+			browser := "#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$CHROMIUM_ARGS_FILE\"\n"
+			if err := os.WriteFile(browserPath, []byte(browser), 0700); err != nil {
+				t.Fatalf("write fake Chromium: %v", err)
+			}
+			t.Setenv("CHROMIUM_BIN_PATH", browserPath)
+			t.Setenv("CHROMIUM_ARGS_FILE", argsPath)
+
+			descriptor := Chromium{}.Descriptor()
+			var flagArgs []string
+			if tc.flagValue != "" {
+				flagArgs = []string{"--chromium-proxy-server=" + tc.flagValue}
+			}
+			if err := descriptor.FlagSet.Parse(flagArgs); err != nil {
+				t.Fatalf("parse Chromium flags: %v", err)
+			}
+
+			provider := struct{ ProtoPDFEngineProvider }{}
+			provider.descriptor = func() gotenberg.ModuleDescriptor {
+				return gotenberg.ModuleDescriptor{
+					ID:  "test-pdf-engine-provider",
+					New: func() gotenberg.Module { return provider },
+				}
+			}
+			provider.pdfEngine = func() (gotenberg.PDFEngine, error) { return nil, nil }
+
+			mod := descriptor.New().(*Chromium)
+			ctx := gotenberg.NewContext(
+				gotenberg.ParsedFlags{FlagSet: descriptor.FlagSet},
+				[]gotenberg.ModuleDescriptor{provider.Descriptor()},
+			)
+			if err := mod.Provision(ctx); err != nil {
+				t.Fatalf("provision Chromium: %v", err)
+			}
+			api, err := mod.Chromium()
+			if err != nil {
+				t.Fatalf("get Chromium API: %v", err)
+			}
+			pdfCtx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			_ = api.PDF(pdfCtx, zap.NewNop(), "https://example.test", filepath.Join(dir, "out.pdf"), Options{})
+
+			args, err := os.ReadFile(argsPath)
+			if err != nil {
+				t.Fatalf("Chromium was not started with captured arguments: %v", err)
+			}
+			hasProxy := strings.Contains(string(args), "--proxy-server")
+			if hasProxy != tc.expect {
+				t.Errorf("expected proxy configured = %t, Chromium arguments were: %s", tc.expect, args)
+			}
+			if tc.expect && !strings.Contains(string(args), tc.flagValue) {
+				t.Errorf("expected Chromium arguments to contain configured proxy %q, got: %s", tc.flagValue, args)
+			}
+		})
+	}
+}
