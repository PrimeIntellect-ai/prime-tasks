+func TestChromium_Descriptor_ProxyServer(t *testing.T) {
+	fs := new(Chromium).Descriptor().FlagSet
+
+	f := fs.Lookup("chromium-proxy-server")
+	if f == nil {
+		t.Fatal("expected 'chromium-proxy-server' flag to be registered")
+	}
+
+	if f.DefValue != "" {
+		t.Errorf("expected default value '' but got '%s'", f.DefValue)
+	}
+}
