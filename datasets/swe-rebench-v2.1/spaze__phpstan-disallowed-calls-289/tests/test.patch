+<?php
+declare(strict_types = 1);
+
+namespace Spaze\PHPStan\Rules\Disallowed\Calls;
+
+use PHPUnit\Framework\TestCase;
+
+class IssetCallsTest extends TestCase
+{
+
+	public function testConfiguredIssetCallsRespectAllowedPaths(): void
+	{
+		$root = dirname(__DIR__, 2);
+		$disallowedFile = $root . '/tests/src/disallowed/functionCalls.php';
+		$allowedFile = $root . '/tests/src/disallowed-allow/functionCalls.php';
+		$tempFile = tempnam(sys_get_temp_dir(), 'isset-calls-');
+		self::assertNotFalse($tempFile);
+		$configFile = $tempFile . '.neon';
+		rename($tempFile, $configFile);
+
+		$config = sprintf(
+			"includes:\n    - %s/extension.neon\nparameters:\n    level: 0\n    paths:\n        - %s\n        - %s\n    disallowedFunctionCalls:\n        - function: 'isset()'\n          allowIn:\n            - %s/tests/src/disallowed-allow/*.php\n            - %s/tests/src/*-allow/*.*\n",
+			$root,
+			$disallowedFile,
+			$allowedFile,
+			$root,
+			$root
+		);
+		file_put_contents($configFile, $config);
+
+		try {
+			$process = proc_open(
+				[
+				PHP_BINARY,
+				$root . '/vendor/bin/phpstan',
+				'analyse',
+				'--configuration=' . $configFile,
+				'--no-progress',
+				'--error-format=json',
+				],
+				[
+				0 => ['pipe', 'r'],
+				1 => ['pipe', 'w'],
+				2 => ['pipe', 'w'],
+				],
+				$pipes
+			);
+			self::assertIsResource($process);
+			fclose($pipes[0]);
+			$output = stream_get_contents($pipes[1]);
+			$errorOutput = stream_get_contents($pipes[2]);
+			fclose($pipes[1]);
+			fclose($pipes[2]);
+			proc_close($process);
+
+			$result = json_decode($output, true);
+			self::assertIsArray($result, $errorOutput . $output);
+			$errorsByFile = $result['files'] ?? [];
+			$disallowedErrors = array_filter(
+				$errorsByFile[$disallowedFile]['messages'] ?? [],
+				static fn (array $error): bool => $error['line'] === 120
+			);
+			$allowedErrors = array_filter(
+				$errorsByFile[$allowedFile]['messages'] ?? [],
+				static fn (array $error): bool => $error['line'] === 120
+			);
+
+			self::assertNotEmpty($disallowedErrors);
+			self::assertCount(0, $allowedErrors);
+		} finally {
+			unlink($configFile);
+		}
+	}
+
+}
