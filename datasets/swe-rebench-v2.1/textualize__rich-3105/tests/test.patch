+class _HTMLFontParser(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.pre_styles = []
+        self.code_attributes = []
+        self.stylesheets = []
+        self._in_style = False
+
+    def handle_starttag(self, tag, attrs):
+        attributes = dict(attrs)
+        if tag == "pre":
+            self.pre_styles.append(attributes.get("style", ""))
+        elif tag == "code":
+            self.code_attributes.append(attributes)
+        elif tag == "style":
+            self._in_style = True
+
+    def handle_endtag(self, tag):
+        if tag == "style":
+            self._in_style = False
+
+    def handle_data(self, data):
+        if self._in_style:
+            self.stylesheets.append(data)
+
+
+def _font_families(style):
+    return re.findall(r"(?:^|;)\s*font-family\s*:\s*([^;]+)", style, re.I)
+
+
+def _normalize_font_family(family):
+    return "".join(
+        family.lower().replace("!important", "").replace("'", "").replace('"', "").split()
+    )
+
+
+def _assert_code_uses_pre_font(html):
+    parsed = _HTMLFontParser()
+    parsed.feed(html)
+    assert parsed.pre_styles and parsed.code_attributes
+
+    pre_families = [
+        _normalize_font_family(family)
+        for style in parsed.pre_styles
+        for family in _font_families(style)
+    ]
+    code_styles = [attributes.get("style", "") for attributes in parsed.code_attributes]
+    for stylesheet in parsed.stylesheets:
+        for selectors, declarations in re.findall(r"([^{}]+)\{([^{}]*)\}", stylesheet):
+            if (
+                "code" in selectors.lower()
+                or re.search(r"\bpre\s*(?:>\s*|\s+)\*", selectors, re.I) or selectors.strip() == "*"
+                or any(
+                    f".{class_name}" in selectors
+                    for attributes in parsed.code_attributes
+                    for class_name in attributes.get("class", "").split()
+                )
+            ):
+                code_styles.append(declarations)
+
+    code_families = [
+        _normalize_font_family(family)
+        for style in code_styles
+        for family in _font_families(style)
+    ]
+    inherited_font = any(
+        re.search(r"(?:^|;)\s*(?:font|all)\s*:\s*(?:inherit|unset)(?:\s*!important)?\s*(?:;|$)", style, re.I)
+        for style in code_styles
+    )
+    assert inherited_font or any(
+        family in {"inherit", "unset"} or family in pre_families
+        for family in code_families
+    )
+
+
 
