+// fakePolicyServer emulates the AWS operations needed by Subscribe and persists
+// queue policies between subscriptions.
+type fakePolicyServer struct {
+	mu        sync.Mutex
+	policy    string
+	submitted []string
+}
+
+func newFakePolicyServer(t *testing.T) (*httptest.Server, *fakePolicyServer) {
+	t.Helper()
+	state := &fakePolicyServer{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		body, _ := io.ReadAll(req.Body)
+		values, _ := url.ParseQuery(string(body))
+		action := values.Get("Action")
+		w.Header().Set("Content-Type", "text/xml")
+
+		switch action {
+		case "CreateTopic":
+			arn := "arn:aws:sns:us-east-1:123456789012:" + values.Get("Name")
+			fmt.Fprintf(w, `<CreateTopicResponse><CreateTopicResult><TopicArn>%s</TopicArn></CreateTopicResult><ResponseMetadata><RequestId>1</RequestId></ResponseMetadata></CreateTopicResponse>`, arn)
+		case "Subscribe":
+			fmt.Fprint(w, `<SubscribeResponse><SubscribeResult><SubscriptionArn>subscription-arn</SubscriptionArn></SubscribeResult><ResponseMetadata><RequestId>1</RequestId></ResponseMetadata></SubscribeResponse>`)
+		case "Unsubscribe":
+			fmt.Fprint(w, `<UnsubscribeResponse><ResponseMetadata><RequestId>1</RequestId></ResponseMetadata></UnsubscribeResponse>`)
+		case "CreateQueue":
+			fmt.Fprint(w, `<CreateQueueResponse><CreateQueueResult><QueueUrl>http://example.com/queue</QueueUrl></CreateQueueResult><ResponseMetadata><RequestId>1</RequestId></ResponseMetadata></CreateQueueResponse>`)
+		case "GetQueueAttributes":
+			state.mu.Lock()
+			policy := state.policy
+			state.mu.Unlock()
+			if values.Get("AttributeName.1") == "QueueArn" {
+				fmt.Fprint(w, `<GetQueueAttributesResponse><GetQueueAttributesResult><Attribute><Name>QueueArn</Name><Value>arn:aws:sqs:us-east-1:123456789012:queue</Value></Attribute></GetQueueAttributesResult><ResponseMetadata><RequestId>1</RequestId></ResponseMetadata></GetQueueAttributesResponse>`)
+			} else if policy == "" {
+				fmt.Fprint(w, `<GetQueueAttributesResponse><GetQueueAttributesResult></GetQueueAttributesResult><ResponseMetadata><RequestId>1</RequestId></ResponseMetadata></GetQueueAttributesResponse>`)
+			} else {
+				fmt.Fprintf(w, `<GetQueueAttributesResponse><GetQueueAttributesResult><Attribute><Name>Policy</Name><Value>%s</Value></Attribute></GetQueueAttributesResult><ResponseMetadata><RequestId>1</RequestId></ResponseMetadata></GetQueueAttributesResponse>`, html.EscapeString(policy))
+			}
+		case "SetQueueAttributes":
+			policy := values.Get("Attribute.1.Value")
+			state.mu.Lock()
+			state.policy = policy
+			state.submitted = append(state.submitted, policy)
+			state.mu.Unlock()
+			fmt.Fprint(w, `<SetQueueAttributesResponse><ResponseMetadata><RequestId>1</RequestId></ResponseMetadata></SetQueueAttributesResponse>`)
+		case "ReceiveMessage":
+			fmt.Fprint(w, `<ReceiveMessageResponse><ReceiveMessageResult></ReceiveMessageResult><ResponseMetadata><RequestId>1</RequestId></ResponseMetadata></ReceiveMessageResponse>`)
+		default:
+			http.Error(w, "unexpected AWS action: "+action, http.StatusBadRequest)
+		}
+	}))
+	return server, state
+}
