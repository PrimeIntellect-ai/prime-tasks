+func Test_SubscribePolicySupportsMoreThanTwentyTopics(t *testing.T) {
+	t.Parallel()
+	server, state := newFakePolicyServer(t)
+	defer server.Close()
+	s, cancel := newSnsSqsWithEndpoint(t, server.URL)
+	defer cancel()
+
+	const queueArn = "arn:aws:sqs:us-east-1:123456789012:queue"
+	snsArns := make([]string, 0, 25)
+	for i := 0; i < 25; i++ {
+		topic := fmt.Sprintf("topic-%d", i)
+		snsArns = append(snsArns, "arn:aws:sns:us-east-1:123456789012:"+topic)
+		subscribeToTopic(t, s, topic)
+	}
+
+	state.mu.Lock()
+	submitted := append([]string(nil), state.submitted...)
+	state.mu.Unlock()
+	require.NotEmpty(t, submitted)
+	for _, policy := range submitted {
+		require.LessOrEqual(t, policyStatementCount(t, policy), 20)
+	}
+	require.ElementsMatch(t, snsArns, sourceArnsForQueue(t, submitted[len(submitted)-1], queueArn))
+}
+
+func Test_SubscribePolicyPreservesExistingSingleArnString(t *testing.T) {
+	t.Parallel()
+	server, state := newFakePolicyServer(t)
+	defer server.Close()
+	s, cancel := newSnsSqsWithEndpoint(t, server.URL)
+	defer cancel()
+
+	const queueArn = "arn:aws:sqs:us-east-1:123456789012:queue"
+	firstArn := "arn:aws:sns:us-east-1:123456789012:topic-1"
+	secondArn := "arn:aws:sns:us-east-1:123456789012:topic-2"
+	subscribeToTopic(t, s, "topic-1")
+
+	state.mu.Lock()
+	state.policy = flattenSingleSourceArn(t, state.policy)
+	state.mu.Unlock()
+
+	subscribeToTopic(t, s, "topic-2")
+	state.mu.Lock()
+	finalPolicy := state.policy
+	state.mu.Unlock()
+	require.ElementsMatch(t, []string{firstArn, secondArn}, sourceArnsForQueue(t, finalPolicy, queueArn))
+}
