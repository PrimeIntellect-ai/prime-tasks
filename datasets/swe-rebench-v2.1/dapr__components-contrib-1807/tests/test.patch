+func newSnsSqsWithEndpoint(t *testing.T, endpoint string) (*snsSqs, context.CancelFunc) {
+	t.Helper()
+	sess := session.Must(session.NewSession(&aws.Config{
+		Region:      aws.String("us-east-1"),
+		Endpoint:    aws.String(endpoint),
+		Credentials: credentials.NewStaticCredentials("a", "s", ""),
+		DisableSSL:  aws.Bool(true),
+	}))
+	ctx, cancel := context.WithCancel(context.Background())
+	return &snsSqs{
+		snsClient:     sns.New(sess),
+		sqsClient:     sqs.New(sess),
+		metadata:      &snsSqsMetadata{Region: "us-east-1", Partition: "aws", accountID: "123456789012", sqsQueueName: "queue", messageMaxNumber: 10},
+		topicArns:     make(map[string]string),
+		topicHandlers: make(map[string]topicHandler),
+		logger:        logger.NewLogger("SnsSqs unit test"),
+		opsTimeout:    5 * time.Second,
+		ctx:           ctx,
+		pollerRunning: make(chan struct{}, 1),
+	}, cancel
+}
