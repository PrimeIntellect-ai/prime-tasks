+func sourceArnsForQueue(t *testing.T, policyJSON, queueArn string) []string {
+	t.Helper()
+	var parsed struct {
+		Statement []struct {
+			Resource  string                                `json:"Resource"`
+			Condition map[string]map[string]json.RawMessage `json:"Condition"`
+		} `json:"Statement"`
+	}
+	require.NoError(t, json.Unmarshal([]byte(policyJSON), &parsed))
+	var arns []string
+	for _, statement := range parsed.Statement {
+		if statement.Resource != queueArn {
+			continue
+		}
+		for _, operator := range statement.Condition {
+			raw, ok := operator["aws:SourceArn"]
+			if !ok {
+				continue
+			}
+			var single string
+			if json.Unmarshal(raw, &single) == nil {
+				arns = append(arns, single)
+				continue
+			}
+			var multiple []string
+			require.NoError(t, json.Unmarshal(raw, &multiple))
+			arns = append(arns, multiple...)
+		}
+	}
+	return arns
+}
+
+func policyStatementCount(t *testing.T, policyJSON string) int {
+	t.Helper()
+	var parsed struct {
+		Statement []json.RawMessage `json:"Statement"`
+	}
+	require.NoError(t, json.Unmarshal([]byte(policyJSON), &parsed))
+	return len(parsed.Statement)
+}
+
+func flattenSingleSourceArn(t *testing.T, policyJSON string) string {
+	t.Helper()
+	var parsed map[string]interface{}
+	require.NoError(t, json.Unmarshal([]byte(policyJSON), &parsed))
+	statements, ok := parsed["Statement"].([]interface{})
+	require.True(t, ok)
+	for _, rawStatement := range statements {
+		statement, ok := rawStatement.(map[string]interface{})
+		if !ok {
+			continue
+		}
+		condition, ok := statement["Condition"].(map[string]interface{})
+		if !ok {
+			continue
+		}
+		for _, rawOperator := range condition {
+			operator, ok := rawOperator.(map[string]interface{})
+			if !ok {
+				continue
+			}
+			if arns, ok := operator["aws:SourceArn"].([]interface{}); ok && len(arns) == 1 {
+				operator["aws:SourceArn"] = arns[0]
+			}
+		}
+	}
+	out, err := json.Marshal(parsed)
+	require.NoError(t, err)
+	return string(out)
+}
