+
+const linter = new Linter()
+linter.defineRule("sort-flags", rule as any)
+
+describe("sort-flags fixes literal flags for RegExp calls with unknown patterns", () => {
+    for (const code of [
+        String.raw`RegExp('a' + b, 'us');`,
+        String.raw`var a = "foo"; RegExp(foo, 'us'); RegExp(foo, 'u');`,
+    ]) {
+        it(code, () => {
+            const config = {
+                parserOptions: {
+                    ecmaVersion: 2020 as const,
+                    sourceType: "module" as const,
+                },
+                rules: { "sort-flags": "error" as const },
+            }
+            const result = linter.verifyAndFix(code, config, "test.js")
+            assert.match(result.output, /(['"])su\1/)
+        })
+    }
+})
