+class custom_qiskitrc(ContextDecorator):
+    """Context manager that uses a temporary qiskitrc."""
+
+    # pylint: disable=invalid-name
+
+    def __init__(self, contents=b""):
+        self.contents = contents
+        self.filename = os.path.join(os.path.expanduser("~"), ".qiskit", "qiskitrc")
+        self.original_contents = None
+        self.had_original = False
+
+    def __enter__(self):
+        os.makedirs(os.path.dirname(self.filename), exist_ok=True)
+        self.had_original = os.path.isfile(self.filename)
+        if self.had_original:
+            with open(self.filename, "rb") as qiskitrc_file:
+                self.original_contents = qiskitrc_file.read()
+        with open(self.filename, "wb") as qiskitrc_file:
+            qiskitrc_file.write(self.contents)
+        return self
+
+    def __exit__(self, *exc):
+        if self.had_original:
+            with open(self.filename, "wb") as qiskitrc_file:
+                qiskitrc_file.write(self.original_contents)
+        else:
+            os.remove(self.filename)
+
+
