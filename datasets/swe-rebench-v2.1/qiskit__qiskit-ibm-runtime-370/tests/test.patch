+    def test_enable_account_by_qiskitrc(self):
+        """Test initializing account by a qiskitrc file."""
+        token = "token-x"
+        proxies = {"urls": {"https": "localhost:8080"}}
+        str_contents = f"""
+        [ibmq]
+        token = {token}
+        url = https://auth.quantum-computing.ibm.com/api
+        verify = True
+        default_provider = ibm-q/open/main
+        proxies = {proxies}
+        """
+        with custom_qiskitrc(contents=str.encode(str_contents)):
+            with temporary_account_config_file(contents={}):
+                service = FakeRuntimeService()
+        self.assertEqual(service.active_account()["token"], token)
+
+    def test_runtime_account_takes_precedence_over_qiskitrc(self):
+        """Use the Runtime account when both credential sources are present."""
+        runtime_token = "runtime-token"
+        qiskit_token = "qiskit-token"
+        qiskitrc_contents = f"""
+        [ibmq]
+        token = {qiskit_token}
+        url = https://auth.quantum-computing.ibm.com/api
+        default_provider = ibm-q/open/main
+        """
+        with no_envs(["QISKIT_IBM_TOKEN"]):
+            with custom_qiskitrc(contents=str.encode(qiskitrc_contents)):
+                with temporary_account_config_file(
+                    channel="ibm_quantum", token=runtime_token
+                ):
+                    service = FakeRuntimeService()
+        self.assertEqual(service.active_account()["token"], runtime_token)
