+def test_default_client_lazy(rig, monkeypatch):
+    class ClientRequested(Exception):
+        pass
+
+    def fail_if_requested(cls):
+        raise ClientRequested
+
+    monkeypatch.setattr(rig.client_class, "get_default_client", classmethod(fail_if_requested))
+
+    # Merely constructing a cloud path must not request its default client.
+    cp = rig.path_class(rig.cloud_prefix + "testing/file.txt")
+
+    # The default client is requested only when the client is first needed.
+    with pytest.raises(ClientRequested):
+        _ = cp.client
+
+
+def test_default_client_available_when_requested(rig):
+    cp = rig.path_class(rig.cloud_prefix + "testing/file.txt")
+    assert isinstance(cp.client, rig.client_class)
+
+
 def test_instantiation_errors(rig):
     with pytest.raises(TypeError):
         rig.path_class()
