+func TestLoad2_2RelationshipRightHandSideNOASSERTION(t *testing.T) {
+	content := `SPDXVersion: SPDX-2.2
+DataLicense: CC0-1.0
+SPDXID: SPDXRef-DOCUMENT
+DocumentName: relationship special value
+DocumentNamespace: https://example.com/spdx/document
+Creator: Tool: test
+Created: 2020-01-01T00:00:00Z
+Relationship: SPDXRef-DOCUMENT DESCRIBES NOASSERTION
+`
+	if _, err := tvloader.Load2_2(strings.NewReader(content)); err != nil {
+		t.Fatalf("Load2_2 rejected a Relationship with NOASSERTION on the right: %v", err)
+	}
+}
