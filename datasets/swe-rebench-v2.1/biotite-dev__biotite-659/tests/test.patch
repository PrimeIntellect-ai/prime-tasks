+@pytest.mark.parametrize("level", ["block", "category", "column"])
+def test_editing(tmpdir, level):
+    """
+    Check if editing an existing PDBx file works, by checking if replacing some
+    category/block/column with a copy of itself does not affect the content.
+    """
+    File = pdbx.CIFFile
+    Block = File.subcomponent_class()
+    Category = Block.subcomponent_class()
+    Column = Category.subcomponent_class()
+
+    column = Column(["a", "b", "c"])
+    category = Category({"foo_col": column, "bar_col": column, "baz_col": column})
+    block = Block({"foo_cat": category, "bar_cat": category, "baz_cat": category})
+    ref_pdbx_file = File({"foo_block": block, "bar_block": block, "baz_block": block})
+    ref_pdbx_file.write(join(tmpdir, "original.cif"))
+
+    pdbx_file = File.read(join(tmpdir, "original.cif"))
+    if level == "block":
+        # Replace block in the mid,
+        # to check if the block before and after remain the same
+        pdbx_file["bar_block"] = pdbx_file["bar_block"]
+    elif level == "category":
+        pdbx_file["bar_block"]["bar_cat"] = pdbx_file["bar_block"]["bar_cat"]
+    elif level == "column":
+        pdbx_file["bar_block"]["bar_cat"]["bar_col"] = pdbx_file["bar_block"][
+            "bar_cat"
+        ]["bar_col"]
+    pdbx_file.write(join(tmpdir, "edited.cif"))
+
+    test_pdbx_file = File.read(join(tmpdir, "edited.cif"))
+    # Editing must preserve the CIF data, regardless of normalized formatting.
+    assert test_pdbx_file == ref_pdbx_file
+
+
+def test_editing_comment_line():
+    """
+    After editing a block and saving a text mmCIF file, items must not be
+    written directly after the '#' comment character; they must start on
+    the next line.
+    """
+    path = join(data_dir("structure"), "1aki.cif")
+    pdbx_file = pdbx.CIFFile.read(path)
+    block_name = next(iter(pdbx_file))
+    category_name = next(iter(pdbx_file[block_name]))
+    # Replace a category with itself, i.e. edit the block
+    pdbx_file[block_name][category_name] = pdbx_file[block_name][category_name]
+
+    for line in pdbx_file.serialize().splitlines():
+        if line.startswith("#"):
+            # Only the comment marker may be on this line;
+            # no item (data name, loop_ or data_ block) may follow it
+            assert not line[1:].lstrip().startswith(("_", "loop_", "data_")), line
+
