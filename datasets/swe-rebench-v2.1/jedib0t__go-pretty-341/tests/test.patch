+func setFormatOption(t *testing.T, style *Style, name string, value interface{}) {
+	t.Helper()
+	field := reflect.ValueOf(&style.Format).Elem().FieldByName(name)
+	if !field.IsValid() {
+		t.Fatalf("FormatOptions does not expose %s", name)
+	}
+	valueField := reflect.ValueOf(value)
+	if !field.CanSet() || !valueField.Type().AssignableTo(field.Type()) {
+		t.Fatalf("FormatOptions field %s cannot be set to the requested alignment", name)
+	}
+	field.Set(valueField)
+}
