+func TestBuildVMConfiguration_StubDriveReplacement(t *testing.T) {
+	namespace := "TestBuildVMConfiguration_StubDriveReplacement"
+	svc := &service{
+		namespace: namespace,
+		logger:    logrus.WithField("test", namespace),
+		config: &Config{
+			RootDrive: "ROOT DRIVE",
+		},
+	}
+
+	tempDir, err := ioutil.TempDir(os.TempDir(), namespace)
+	require.NoError(t, err)
+	defer os.RemoveAll(tempDir)
+
+	svc.stubDriveHandler = newStubDriveHandler(tempDir, svc.logger)
+
+	const containerCount = 2
+	_, err = svc.buildVMConfiguration(&proto.CreateVMRequest{ContainerCount: containerCount})
+	require.NoError(t, err)
+
+	ctx := context.Background()
+	mockClient := &fctesting.MockClient{
+		PatchGuestDriveByIDFn: func(params *ops.PatchGuestDriveByIDParams) (*ops.PatchGuestDriveByIDNoContent, error) {
+			return nil, nil
+		},
+	}
+	fcClient := firecracker.NewClient("/path/to/socket", nil, false, firecracker.WithOpsClient(mockClient))
+	client, err := firecracker.NewMachine(ctx, firecracker.Config{}, firecracker.WithClient(fcClient))
+	require.NoError(t, err)
+
+	// Each container replaces one stub drive, in stub0, stub1, ... order.
+	for i := 0; i < containerCount; i++ {
+		driveID, err := svc.stubDriveHandler.PatchStubDrive(ctx, client, fmt.Sprintf("/container/path%d", i))
+		require.NoError(t, err)
+		require.Equal(t, fmt.Sprintf("stub%d", i), firecracker.StringValue(driveID))
+	}
+
+	// Once every stub drive has been replaced, no non-stub drive may be replaced.
+	driveID, err := svc.stubDriveHandler.PatchStubDrive(ctx, client, "/container/path-extra")
+	require.Error(t, err, "replacing more drives than there are stub drives must fail")
+	require.NotEqual(t, "root_drive", firecracker.StringValue(driveID))
+}
