+@mock_aws
+def test_search_model_package_groups():
+    client = boto3.client("sagemaker", region_name="eu-west-1")
+    group1 = "test-model-package-group-1"
+    desc1 = "test-model-package-group-description-1"
+    arn1 = client.create_model_package_group(
+        ModelPackageGroupName=group1, ModelPackageGroupDescription=desc1
+    )["ModelPackageGroupArn"]
+    client.add_tags(ResourceArn=arn1, Tags=[{"Key": "k1", "Value": "v1"}])
+
+    group2 = "test-model-package-group-2"
+    desc2 = "test-model-package-group-description-2"
+    client.create_model_package_group(
+        ModelPackageGroupName=group2,
+        ModelPackageGroupDescription=desc2,
+    )
+
+    summary = client.search(Resource="ModelPackageGroup")["Results"]
+    assert len(summary) == 2
+
+    names = {
+        name
+        for name in (group1, group2)
+        if name in repr(summary)
+    }
+    assert names == {group1, group2}
+
+
+@mock_aws
+def test_search_model_package_groups_with_tag_filter():
+    client = boto3.client("sagemaker", region_name="eu-west-1")
+    source_role_arn = "arn:aws:iam::123456789012:role/DSSourceRole"
+
+    arn1 = client.create_model_package_group(
+        ModelPackageGroupName="test-model-package-group-1",
+        ModelPackageGroupDescription="test-model-package-group-description-1",
+        Tags=[{"Key": "RegisteredBySourceRoleArn", "Value": source_role_arn}],
+    )["ModelPackageGroupArn"]
+
+    client.create_model_package_group(
+        ModelPackageGroupName="test-model-package-group-2",
+        ModelPackageGroupDescription="test-model-package-group-description-2",
+        Tags=[
+            {
+                "Key": "RegisteredBySourceRoleArn",
+                "Value": "arn:aws:iam::123456789012:role/OtherSourceRole",
+            }
+        ],
+    )
+
+    summary = client.search(
+        Resource="ModelPackageGroup",
+        SearchExpression={
+            "Filters": [
+                {
+                    "Name": "Tags.RegisteredBySourceRoleArn",
+                    "Operator": "Equals",
+                    "Value": source_role_arn,
+                }
+            ]
+        },
+    )["Results"]
+
+    assert len(summary) == 1
+    assert "test-model-package-group-1" in repr(summary)
+    assert "test-model-package-group-2" not in repr(summary)
