+def test_markdown_description_file(tmp_path):
+    (tmp_path / 'module1.py').write_text(
+        '"""Example module"""\n\n__version__ = "0.1"\n')
+    (tmp_path / 'README.md').write_text('# Title\n\nSome *markdown* text.\n')
+    (tmp_path / 'pyproject.toml').write_text(
+        '[build-system]\n'
+        'requires = ["flit"]\n'
+        '\n'
+        '[tool.flit.metadata]\n'
+        'module = "module1"\n'
+        'author = "Sir Robin"\n'
+        'author-email = "robin@camelot.uk"\n'
+        'home-page = "http://github.com/sirrobin/module1"\n'
+        'description-file = "README.md"\n'
+    )
+    info = read_pkg_ini(tmp_path / 'pyproject.toml')
+    assert info['metadata']['description'] == '# Title\n\nSome *markdown* text.\n'
+    text = _written_metadata(tmp_path / 'pyproject.toml')
+    assert _metadata_header(text, 'Description-Content-Type') == 'text/markdown'
+    assert '# Title\n\nSome *markdown* text.\n' in text
