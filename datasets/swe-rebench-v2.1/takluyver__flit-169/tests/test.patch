+import io
 import pathlib
 
 import pytest
 
+from flit.common import Module, make_metadata
 from flit.inifile import read_pkg_ini, ConfigError, flatten_entrypoints
 
 samples_dir = pathlib.Path(__file__).parent / 'samples'
 
+def _written_metadata(ini_path):
+    """Build the package metadata and return the text written to METADATA."""
+    info = read_pkg_ini(ini_path)
+    module = Module(info['module'], ini_path.parent)
+    metadata = make_metadata(module, info)
+    out = io.StringIO()
+    metadata.write_metadata_file(out)
+    return out.getvalue()
+
+def _metadata_header(text, name):
+    """Return the value of a header from the METADATA header block."""
+    for line in text.splitlines():
+        if not line.strip():
+            break
+        if line.lower().startswith(name.lower() + ':'):
+            return line.split(':', 1)[1].strip()
+    return None
+
 def test_invalid_classifier():
     with pytest.raises(ConfigError):
         read_pkg_ini(samples_dir / 'invalid_classifier.ini')
@@ -49,3 +69,23 @@ def test_description_file():
     assert info['metadata']['description'] == \
