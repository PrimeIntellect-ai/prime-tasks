+// TestMakeVirtHostSetsOnlineFalse verifies that the make-virt-host command
+// renders a BareMetalHost manifest with the online field set to false.
+func TestMakeVirtHostSetsOnlineFalse(t *testing.T) {
+	cmdDir := filepath.Join("..", "..", "make-virt-host")
+
+	tmpDir := t.TempDir()
+
+	sudoScript := "#!/bin/sh\n" +
+		"cat <<'XML'\n" +
+		"<domain>\n" +
+		"  <devices>\n" +
+		"    <interface type='bridge'>\n" +
+		"      <mac address='00:1a:74:74:e5:cb'/>\n" +
+		"      <source bridge='provisioning'/>\n" +
+		"    </interface>\n" +
+		"  </devices>\n" +
+		"</domain>\n" +
+		"XML\n"
+	vbmcScript := "#!/bin/sh\n" +
+		"echo '[{\"Port\": 6230, \"Domain name\": \"test-domain\"}]'\n"
+
+	for name, script := range map[string]string{"sudo": sudoScript, "vbmc": vbmcScript} {
+		if err := os.WriteFile(filepath.Join(tmpDir, name), []byte(script), 0755); err != nil {
+			t.Fatalf("failed to write fake %s: %v", name, err)
+		}
+	}
+
+	binary := filepath.Join(tmpDir, "make-virt-host")
+	build := exec.Command("go", "build", "-o", binary, ".")
+	build.Dir = cmdDir
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("failed to build make-virt-host: %v\n%s", err, out)
+	}
+
+	run := exec.Command(binary, "test-domain")
+	run.Env = append(os.Environ(),
+		"PATH="+tmpDir+string(os.PathListSeparator)+os.Getenv("PATH"))
+	out, err := run.CombinedOutput()
+	if err != nil {
+		t.Fatalf("make-virt-host failed: %v\n%s", err, out)
+	}
+
+	if !strings.Contains(string(out), "online: false") {
+		t.Errorf("expected generated BareMetalHost to set online to false, got:\n%s", out)
+	}
+}
