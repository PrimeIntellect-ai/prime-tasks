+    def test_white_noise_offset_is_subtracted(self):
+        time = np.arange(0, 100, 1) + 0.5
+        counts = 100 + 50 * np.sin(2 * np.pi * 0.1 * time)
+        poisson_counts = np.random.poisson(counts)
+        lc = Lightcurve(time, counts=poisson_counts, dt=1, gti=[[0, 100]])
+        nphots = np.sum(lc.counts)
+
+        for norm in ["leahy", "frac"]:
+            ps = Powerspectrum(lc=lc, norm=norm)
+            minind = ps.freq.searchsorted(ps.freq[1])
+            maxind = ps.freq.searchsorted(ps.freq[-1])
+            n = maxind - minind
+
+            rms_0, _ = ps.compute_rms(min_freq=ps.freq[1],
+                                      max_freq=ps.freq[-1],
+                                      white_noise_offset=0)
+            rms_2, _ = ps.compute_rms(min_freq=ps.freq[1],
+                                      max_freq=ps.freq[-1],
+                                      white_noise_offset=2)
+
+            # Subtracting a white-noise level W reduces rms**2 by W * n / nphots
+            assert np.isclose(rms_0 ** 2 - rms_2 ** 2,
+                              2.0 * n / nphots, rtol=1e-6)
+            assert rms_2 < rms_0
+
+    def test_averaged_white_noise_offset_is_subtracted(self):
+        time = np.arange(0, 400, 1) + 0.5
+        counts = 100 + 50 * np.sin(2 * np.pi * 0.1 * time)
+        poisson_counts = np.random.poisson(counts)
+        lc = Lightcurve(time, counts=poisson_counts, dt=1, gti=[[0, 400]])
+        offset = 2.0
+
+        for norm in ["leahy", "frac"]:
+            ps = AveragedPowerspectrum(lc=lc, norm=norm, segment_size=100)
+            min_freq = ps.freq[1]
+            max_freq = ps.freq[-1]
+            minind = ps.freq.searchsorted(min_freq)
+            maxind = ps.freq.searchsorted(max_freq)
+            n = maxind - minind
+
+            rms_0, _ = ps.compute_rms(min_freq=min_freq, max_freq=max_freq)
+            rms_offset, _ = ps.compute_rms(min_freq=min_freq, max_freq=max_freq,
+                                           white_noise_offset=offset)
+
+            assert np.isclose(rms_0 ** 2 - rms_offset ** 2,
+                              offset * n / ps.nphots, rtol=1e-6)
+            assert rms_offset < rms_0
+
