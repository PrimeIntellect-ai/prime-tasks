+        IntsRef footwayFlags = footEncoder.handleWayTags(encodingManager.createEdgeFlags(), footway, footEncoder.getAccess(footway), 0);
+
+        // the platform edge must be traversable and get the same speed as a footway
+        assertTrue(footEncoder.getSpeed(platformFlags) > 0);
+        assertEquals(footEncoder.getSpeed(footwayFlags), footEncoder.getSpeed(platformFlags), 1e-1);
+
+        // and the same priority
