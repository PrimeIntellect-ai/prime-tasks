+func TestImportAttachmentOnlyCriteria(t *testing.T) {
+	filters := []*gmailv1.Filter{{
+		Action:   &gmailv1.FilterAction{AddLabelIds: []string{labelIDTrash}},
+		Criteria: &gmailv1.FilterCriteria{HasAttachment: true},
+	}}
+	imported, err := Import(filters, emptyLabelMap())
+	assert.Nil(t, err, "an attachment-only filter must not fail as empty criteria")
+	if err != nil || len(imported) == 0 {
+		return // Skipping this filter is a supported outcome.
+	}
+	assert.False(t, imported[0].Criteria.Empty(), "an imported filter must retain its attachment criterion")
+}
