+@pytest.mark.parametrize('skip_glob_assert', (([], 0, {os.sep.join(('code', 'file.py'))}), (['**/*.py'], 1, set())))
+def test_skip_glob(tmpdir, skip_glob_assert):
+    skip_glob, skipped_count, expected_file_names = skip_glob_assert
+    base_dir = tmpdir.mkdir('build')
+    code_dir = base_dir.mkdir('code')
+    code_dir.join('file.py').write('import os')
+
+    config = dict(settings.default.copy(), skip_glob=skip_glob)
+    skipped = []
+    file_names = set(os.path.relpath(f, str(base_dir)) for f in main.iter_source_code([str(base_dir)], config, skipped))
+    assert len(skipped) == skipped_count
+    assert file_names == expected_file_names
+
+
+def test_skip_glob_leaves_named_file_untouched(tmpdir):
+    file_path = tmpdir.join('file.py')
+    original = 'import os, sys\n'
+    file_path.write(original)
+
+    result = SortImports(file_path=str(file_path), skip_glob=['*file.py'])
+
+    assert result.skipped
+    assert file_path.read() == original
+
