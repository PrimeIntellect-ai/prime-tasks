+class TestSafeBuildMissingManifest(unittest.TestCase):
+    def test_safe_build_missing_manifest(self):
+        """A SAFE build on a product without manifest.safe must report the missing file"""
+        awsd = AwsDownload("some_provider", {})
+        product_path = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, product_path, ignore_errors=True)
+        os.makedirs(os.path.join(product_path, "X.SAFE", "GRANULE"))
+
+        # checking the files listed in the manifest must report the missing manifest
+        with self.assertRaises(FileNotFoundError):
+            awsd.check_manifest_file_list(product_path)
+
+        # finalizing the SAFE product must fail with an error naming the missing manifest
+        with self.assertRaises(DownloadError) as ctx:
+            awsd.finalize_s2_safe_product(product_path)
+        self.assertIn("manifest.safe", str(ctx.exception))
