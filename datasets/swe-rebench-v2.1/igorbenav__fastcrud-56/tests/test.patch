+@pytest.mark.asyncio
+async def test_get_joined_nest_joins(async_session, test_data, test_data_tier):
+    for tier_item in test_data_tier:
+        async_session.add(TierModel(**tier_item))
+    await async_session.commit()
+
+    for user_item in test_data:
+        async_session.add(ModelTest(**user_item))
+    await async_session.commit()
+
+    crud = FastCRUD(ModelTest)
+
+    result = await crud.get_joined(
+        db=async_session,
+        join_model=TierModel,
+        join_prefix="tier_",
+        schema_to_select=CreateSchemaTest,
+        join_schema_to_select=TierSchemaTest,
+        nest_joins=True,
+    )
+
+    assert result is not None, "No result returned, expected a nested join result."
+    assert "name" in result, "Expected primary model field 'name' in result."
+    assert "tier" in result, "Expected nested 'tier' key in result for joined fields."
+    assert (
+        "name" in result["tier"]
+    ), "Expected 'name' inside nested 'tier' dictionary from TierModel."
+    assert (
+        "tier_name" not in result
+    ), "'tier_name' should not be at the top level in the result."
+
+
+@pytest.mark.asyncio
+async def test_get_joined_nest_joins_with_joins_config(
+    async_session, test_data, test_data_tier, test_data_category
+):
+    for tier_item in test_data_tier:
+        async_session.add(TierModel(**tier_item))
+    await async_session.commit()
+
+    for category_item in test_data_category:
+        async_session.add(CategoryModel(**category_item))
+    await async_session.commit()
+
+    for user_item in test_data:
+        async_session.add(ModelTest(**user_item))
+    await async_session.commit()
+
+    crud = FastCRUD(ModelTest)
+
+    result = await crud.get_joined(
+        db=async_session,
+        joins_config=[
+            JoinConfig(
+                model=TierModel,
+                join_prefix="tier_",
+                schema_to_select=TierSchemaTest,
+                join_on=ModelTest.tier_id == TierModel.id,
+                join_type="left",
+            ),
+            JoinConfig(
+                model=CategoryModel,
+                join_prefix="category_",
+                schema_to_select=CategorySchemaTest,
+                join_on=ModelTest.category_id == CategoryModel.id,
+                join_type="left",
+            ),
+        ],
+        schema_to_select=CreateSchemaTest,
+        nest_joins=True,
+    )
+
+    assert result is not None, "No result returned, expected a nested join result."
+    assert "name" in result, "Expected primary model field 'name' in result."
+    assert "tier" in result, "Expected nested 'tier' key for the tier join."
+    assert "category" in result, "Expected nested 'category' key for the category join."
+    assert isinstance(result["tier"], dict), "Nested 'tier' data should be a dictionary."
+    assert isinstance(
+        result["category"], dict
+    ), "Nested 'category' data should be a dictionary."
+    assert "name" in result["tier"], "Expected tier fields inside nested 'tier'."
+    assert "name" in result["category"], "Expected category fields inside nested 'category'."
+    assert "tier_name" not in result, "'tier_name' should not be at the top level."
+    assert "category_name" not in result, "'category_name' should not be at the top level."
