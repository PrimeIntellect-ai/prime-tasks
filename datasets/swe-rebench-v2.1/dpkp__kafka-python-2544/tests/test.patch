+def test__reset_offset_timeout_expires(fetcher):
+    tp = TopicPartition("foobar", 0)
+    fetcher._subscriptions.need_offset_reset(tp)
+
+    # With no broker available, a zero timeout must bound this lookup.
+    with pytest.raises(Errors.KafkaTimeoutError):
+        fetcher._reset_offset(tp, timeout_ms=0)
+
+
+def test_position_without_timeout_uses_known_offset():
+    consumer = KafkaConsumer(
+        bootstrap_servers=(), api_version=(0, 9), auto_offset_reset='latest')
+    tp = TopicPartition("known", 0)
+    consumer.assign([tp])
+    consumer.seek(tp, 42)
+
+    assert consumer.position(tp) == 42
+    consumer.close(autocommit=False)
+
+
+def test_position_timeout_when_broker_unavailable():
+    consumer = KafkaConsumer(
+        bootstrap_servers=(), api_version=(0, 9), auto_offset_reset='latest')
+    tp = TopicPartition("unavailable", 0)
+    consumer.assign([tp])
+    outcome = []
+
+    def get_position():
+        try:
+            outcome.append(consumer.position(tp, timeout_ms=0))
+        except Exception as error:
+            outcome.append(error)
+
+    worker = threading.Thread(target=get_position)
+    worker.daemon = True
+    worker.start()
+    worker.join(1.0)
+
+    assert not worker.is_alive(), "position did not honor its timeout"
+    assert outcome == [None]
+    consumer.close(autocommit=False)
+
+
