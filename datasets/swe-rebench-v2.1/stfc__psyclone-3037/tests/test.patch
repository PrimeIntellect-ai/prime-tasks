+def test_forward_accesses_respect_control_flow(fortran_reader):
+    """A conditional or loop-body write is not guaranteed to execute, so
+    a value defined before it may still reach a subsequent use.
+    """
+    sources = [
+        """subroutine test_if()
+             integer :: a, b, condition
+             a = 1
+             if (condition > 0) then
+               a = 2
+             end if
+             b = a
+           end subroutine test_if""",
+        """subroutine test_loop()
+             integer :: a, b, i
+             a = 1
+             do i = 1, 10
+               a = 2
+             end do
+             b = a
+           end subroutine test_loop"""
+    ]
+    for source in sources:
+        psyir = fortran_reader.psyir_from_source(source)
+        assignments = psyir.walk(Assignment)
+        initial_definition = assignments[0].lhs
+        use_after_control_flow = assignments[-1].rhs
+        chain = DefinitionUseChain(initial_definition)
+        assert any(access is use_after_control_flow
+                   for access in chain.find_forward_accesses())
 
 
