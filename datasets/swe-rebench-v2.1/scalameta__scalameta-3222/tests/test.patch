+++ b/tests/shared/src/test/scala-2.13/scala/meta/tests/parsers/dotty/Scala3PositionSuite.scala
@@ -1079,4 +1079,12 @@ class Scala3PositionSuite extends BasePositionSuite(dialects.Scala3) {
        |""".stripMargin
   )
 
+  // #3219: postfix selection must preserve the leading parenthesis of the qualifier
+  test("(10) + 1 toInt") {
+    implicit val dialect: Dialect = dialects.Scala3
+    val tree = "(10) + 1 toInt".parse[Stat].get
+    val qual = tree.collect { case Term.Select(qual, _) => qual }.head
+    assertEquals(qual.syntax, "(10) + 1")
+  }
+
 }
