+class TestQPYSymbolicPulse(QiskitTestCase):
+    """QPY loading of symbolic pulses."""
+
+
+    def test_qpy_loads_symbolic_pulses_without_waveform_subclasses(self):
+        """QPY loading preserves waveform identity on plain symbolic pulse objects."""
+        from qiskit.pulse import builder
+        from qiskit.pulse.channels import DriveChannel
+        from qiskit.qpy import dump, load
+
+        pulses = [
+            Gaussian(160, 0.1, 40),
+            GaussianSquare(800, 0.1, 64, 544),
+            Drag(160, 0.1, 40, 1.5),
+            Constant(800, 0.1),
+        ]
+        for pulse in pulses:
+            with builder.build() as schedule:
+                builder.play(pulse, DriveChannel(0))
+            qpy_file = io.BytesIO()
+            dump(schedule, qpy_file)
+            qpy_file.seek(0)
+            loaded_schedule = load(qpy_file)[0]
+            loaded_pulse = loaded_schedule.blocks[0].pulse
+            self.assertIs(type(loaded_pulse), SymbolicPulse)
+            self.assertEqual(loaded_pulse.pulse_type, pulse.pulse_type)
+
+
 if __name__ == "__main__":
     unittest.main()
