 /* eslint-env mocha */
 
+const assert = require('assert')
+const fs = require('fs')
+const path = require('path')
+const { spawnSync } = require('child_process')
 const fse = require('..')
 
 const methods = [
@@ -22,4 +26,40 @@ describe('promise support', () => {
       fse[method]().catch(() => done())
     })
   })
+
+  if (Object.getOwnPropertyDescriptor(fs, 'promises')) {
+    it('exposes the built-in fs.promises API', () => {
+      assert.strictEqual(fse.promises, fs.promises)
+    })
+
+    it('does not access fs.promises while fs-extra is being loaded', () => {
+      const repoRoot = path.join(__dirname, '..', '..')
+      const script = `
+        const fs = require('fs')
+        const repoRoot = process.cwd()
+        const real = fs.promises
+        let accessedByFse = false
+        Object.defineProperty(fs, 'promises', {
+          configurable: true,
+          enumerable: true,
+          get () {
+            const stack = new Error().stack || ''
+            const lines = stack.split('\\n')
+            const caller = lines[2] || ''
+            const isSyncExports = stack.includes('syncExports') || stack.includes('getOwn')
+            if (!isSyncExports && caller.includes(repoRoot)) accessedByFse = true
+            return real
+          }
+        })
+        require(repoRoot)
+        process.stdout.write(JSON.stringify({ accessedByFse }))
+      `
+      const result = spawnSync(process.execPath, ['-e', script], {
+        cwd: repoRoot,
+        encoding: 'utf8'
+      })
+      assert.strictEqual(result.status, 0, result.stderr)
+      assert.deepStrictEqual(JSON.parse(result.stdout), { accessedByFse: false })
+    })
+  }
 })
