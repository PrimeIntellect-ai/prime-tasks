+func TestSignedAttributeNegativeRoundTrip(t *testing.T) {
+	tests := []struct {
+		typ    uint16
+		want   int64
+		encode func(*AttributeEncoder)
+		decode func(*AttributeDecoder) int64
+	}{
+		{
+			typ:    1,
+			want:   -128,
+			encode: func(ae *AttributeEncoder) { ae.Int8(1, -128) },
+			decode: func(ad *AttributeDecoder) int64 { return int64(ad.Int8()) },
+		},
+		{
+			typ:    2,
+			want:   -12345,
+			encode: func(ae *AttributeEncoder) { ae.Int16(2, -12345) },
+			decode: func(ad *AttributeDecoder) int64 { return int64(ad.Int16()) },
+		},
+		{
+			typ:    3,
+			want:   -123456789,
+			encode: func(ae *AttributeEncoder) { ae.Int32(3, -123456789) },
+			decode: func(ad *AttributeDecoder) int64 { return int64(ad.Int32()) },
+		},
+		{
+			typ:    4,
+			want:   -1234567890123456789,
+			encode: func(ae *AttributeEncoder) { ae.Int64(4, -1234567890123456789) },
+			decode: func(ad *AttributeDecoder) int64 { return ad.Int64() },
+		},
+	}
+
+	for _, order := range []struct {
+		name  string
+		order binary.ByteOrder
+	}{
+		{name: "little endian", order: binary.LittleEndian},
+		{name: "big endian", order: binary.BigEndian},
+	} {
+		t.Run(order.name, func(t *testing.T) {
+			ae := NewAttributeEncoder()
+			ae.ByteOrder = order.order
+			for _, tt := range tests {
+				tt.encode(ae)
+			}
+
+			b, err := ae.Encode()
+			if err != nil {
+				t.Fatalf("failed to encode signed attributes: %v", err)
+			}
+			ad, err := NewAttributeDecoder(b)
+			if err != nil {
+				t.Fatalf("failed to create attribute decoder: %v", err)
+			}
+			ad.ByteOrder = order.order
+			for _, tt := range tests {
+				if !ad.Next() {
+					t.Fatalf("missing signed attribute %d: %v", tt.typ, ad.Err())
+				}
+				if got := ad.Type(); got != tt.typ {
+					t.Fatalf("unexpected attribute type: want %d, got %d", tt.typ, got)
+				}
+				if got := tt.decode(ad); got != tt.want {
+					t.Errorf("attribute %d: want %d, got %d", tt.typ, tt.want, got)
+				}
+				if err := ad.Err(); err != nil {
+					t.Fatalf("failed to decode attribute %d: %v", tt.typ, err)
+				}
+			}
+			if ad.Next() {
+				t.Fatal("unexpected extra signed attribute")
+			}
+			if err := ad.Err(); err != nil {
+				t.Fatalf("failed after decoding signed attributes: %v", err)
+			}
+		})
+	}
+}
+
 func aeEndianTest(order binary.ByteOrder) func(ae *AttributeEncoder) {
 	return func(ae *AttributeEncoder) {
 		ae.ByteOrder = order
