+test('client does not send bytes after the declared request body', (t) => {
+  t.plan(2)
+
+  const wireServer = net.createServer((socket) => {
+    let received = Buffer.alloc(0)
+    let responseScheduled = false
+    socket.on('data', (chunk) => {
+      received = Buffer.concat([received, chunk])
+      const headerEnd = received.indexOf('\r\n\r\n')
+      if (headerEnd < 0 || responseScheduled) return
+
+      const headers = received.subarray(0, headerEnd).toString()
+      const contentLength = Number(headers.match(/\r\nContent-Length: (\d+)/i)[1])
+      const bodyStart = headerEnd + 4
+      if (received.length < bodyStart + contentLength) return
+
+      responseScheduled = true
+      setTimeout(() => {
+        t.same(received.subarray(bodyStart), Buffer.from('body'), 'only the declared body bytes were sent')
+        socket.end('HTTP/1.1 204 No Content\r\nContent-Length: 0\r\nConnection: close\r\n\r\n')
+      }, 20)
+    })
+  })
+
+  wireServer.listen(0, '127.0.0.1', () => {
+    const opts = wireServer.address()
+    opts.hostname = '127.0.0.1'
+    opts.method = 'POST'
+    opts.body = 'body'
+    const client = new Client(opts)
+    client.on('response', (statusCode) => {
+      t.equal(statusCode, 204, 'the request completed successfully')
+      client.destroy()
+      wireServer.close()
+    })
+    client.on('error', (err) => t.fail(err))
+  })
+})
+
