+def test_optional_union():
+    @dataclass
+    class Baz(JsonSchemaMixin):
+        """Class with optional union"""
+        a: Optional[Union[int, str]]
+
+    schema = Baz.json_schema()
+    # An optional field must not be listed as required
+    assert "a" not in schema.get("required", [])
+    # The union is represented compositionally; alternative order is not significant
+    alternatives = schema["properties"]["a"]["oneOf"]
+    assert {"type": "integer"} in alternatives
+    assert {"type": "string"} in alternatives
