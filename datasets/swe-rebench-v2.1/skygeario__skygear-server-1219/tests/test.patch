+package policy_test
+
+import (
+	"net/http"
+	"testing"
+	"time"
+
+	authhandler "github.com/skygeario/skygear-server/pkg/auth/handler"
+	"github.com/skygeario/skygear-server/pkg/core/auth"
+	"github.com/skygeario/skygear-server/pkg/core/auth/authinfo"
+	"github.com/skygeario/skygear-server/pkg/core/auth/authz"
+	"github.com/skygeario/skygear-server/pkg/core/model"
+	"github.com/skygeario/skygear-server/pkg/core/skyerr"
+
+	. "github.com/smartystreets/goconvey/convey"
+)
+
+type contextGetter struct {
+	accessKey model.AccessKey
+	authInfo  *authinfo.AuthInfo
+	session   *auth.Session
+}
+
+func (c contextGetter) AccessKey() model.AccessKey {
+	return c.accessKey
+}
+
+func (c contextGetter) AuthInfo() (*authinfo.AuthInfo, error) {
+	return c.authInfo, nil
+}
+
+func (c contextGetter) Session() (*auth.Session, error) {
+	return c.session, nil
+}
+
+func TestRequireValidUserOrMasterKey(t *testing.T) {
+	policy := (authhandler.UpdateMetadataHandler{}).ProvideAuthzPolicy()
+
+	Convey("Authorization accepts a valid user session or a master key", t, func() {
+		req, _ := http.NewRequest("POST", "/", nil)
+
+		userContext := contextGetter{
+			authInfo: &authinfo.AuthInfo{ID: "user-id"},
+			session: &auth.Session{
+				AccessTokenCreatedAt: time.Date(2016, 10, 1, 0, 0, 0, 0, time.UTC),
+			},
+		}
+		So(policy.IsAllowed(req, userContext), ShouldBeNil)
+
+		masterContext := contextGetter{
+			accessKey: model.AccessKey{Type: model.MasterAccessKeyType},
+		}
+		So(policy.IsAllowed(req, masterContext), ShouldBeNil)
+	})
+
+	Convey("Authorization reports the contractually required errors", t, func() {
+		req, _ := http.NewRequest("POST", "/", nil)
+
+		err := policy.IsAllowed(req, contextGetter{})
+		So(err, ShouldBeError, "authentication required")
+
+		// The key identifies an expired session for which no user was resolved.
+		expiredSession := contextGetter{
+			accessKey: model.AccessKey{
+				Type:     model.APIAccessKeyType,
+				ClientID: "client-id",
+			},
+		}
+		err = policy.IsAllowed(req, expiredSession)
+		So(err, ShouldBeError)
+		So(skyerr.IsKind(err, authz.NotAuthenticated), ShouldBeTrue)
+	})
+}
