+func TestEnsureLoadBalancerReusesNamedPublicIP(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+
+	az := GetTestCloud(ctrl)
+	clusterResources, expectedInterfaces, expectedVirtualMachines := getClusterResources(az, 8, 4)
+	setMockEnv(az, ctrl, expectedInterfaces, expectedVirtualMachines, 2)
+
+	backendPool := az.LoadBalancerBackendPool.(*MockBackendPool)
+	backendPool.EXPECT().ReconcileBackendPools(gomock.Any(), gomock.Any(), gomock.Any()).Return(false, false, false, nil).AnyTimes()
+	backendPool.EXPECT().EnsureHostsInPool(gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any()).Return(nil).AnyTimes()
+	backendPool.EXPECT().GetBackendPrivateIPs(gomock.Any(), gomock.Any(), gomock.Any()).Return(nil, nil).AnyTimes()
+
+	pipName := "shared-pip"
+	pipID := "/subscriptions/subscription/resourceGroups/named-rg/providers/Microsoft.Network/publicIPAddresses/shared-pip"
+	pip := network.PublicIPAddress{
+		ID:   pointer.String(pipID),
+		Name: pointer.String(pipName),
+		Tags: map[string]*string{consts.ServiceTagKey: pointer.String("default/primary")},
+		PublicIPAddressPropertiesFormat: &network.PublicIPAddressPropertiesFormat{
+			IPAddress: pointer.String("9.8.7.6"),
+		},
+	}
+	pipClient := mockpublicipclient.NewMockInterface(ctrl)
+	az.PublicIPAddressesClient = pipClient
+	pipClient.EXPECT().List(gomock.Any(), "named-rg").Return([]network.PublicIPAddress{pip}, nil).AnyTimes()
+	pipClient.EXPECT().Get(gomock.Any(), "named-rg", pipName, gomock.Any()).Return(pip, nil).AnyTimes()
+	pipClient.EXPECT().Get(gomock.Any(), "named-rg", gomock.Any(), gomock.Any()).Return(network.PublicIPAddress{}, &retry.Error{HTTPStatusCode: http.StatusNotFound}).AnyTimes()
+	pipClient.EXPECT().CreateOrUpdate(gomock.Any(), "named-rg", gomock.Any(), gomock.Any()).Return(nil).AnyTimes()
+
+	service := getResourceGroupTestService("secondary", "named-rg", "", 8082)
+	service.Annotations[consts.ServiceAnnotationPIPName] = pipName
+	primaryService := getTestService("primary", v1.ProtocolTCP, nil, false, 8081)
+	lb := getTestLoadBalancer(pointer.String(testClusterName), pointer.String(az.ResourceGroup), pointer.String(testClusterName), pointer.String("aprimary1"), primaryService, "Basic")
+	fips := *lb.FrontendIPConfigurations
+	fips[0].FrontendIPConfigurationPropertiesFormat.PublicIPAddress.ID = pointer.String(pipID)
+	lb.FrontendIPConfigurations = &fips
+
+	var reconciledLB network.LoadBalancer
+	lbClient := mockloadbalancerclient.NewMockInterface(ctrl)
+	az.LoadBalancerClient = lbClient
+	lbClient.EXPECT().List(gomock.Any(), az.ResourceGroup).Return([]network.LoadBalancer{lb}, nil).AnyTimes()
+	lbClient.EXPECT().List(gomock.Any(), gomock.Not(az.ResourceGroup)).Return(nil, &retry.Error{HTTPStatusCode: http.StatusNotFound}).AnyTimes()
+	lbClient.EXPECT().Get(gomock.Any(), az.ResourceGroup, gomock.Any(), gomock.Any()).Return(lb, nil).AnyTimes()
+	lbClient.EXPECT().Get(gomock.Any(), gomock.Not(az.ResourceGroup), gomock.Any(), gomock.Any()).Return(network.LoadBalancer{}, &retry.Error{HTTPStatusCode: http.StatusNotFound}).AnyTimes()
+	lbClient.EXPECT().CreateOrUpdate(gomock.Any(), az.ResourceGroup, gomock.Any(), gomock.Any(), gomock.Any()).DoAndReturn(
+		func(_ context.Context, _, _ string, parameters network.LoadBalancer, _ string) *retry.Error {
+			reconciledLB = parameters
+			return nil
+		}).AnyTimes()
+	lbClient.EXPECT().Delete(gomock.Any(), gomock.Any(), gomock.Any()).Return(nil).AnyTimes()
+
+	plsClient := mockprivatelinkserviceclient.NewMockInterface(ctrl)
+	plsClient.EXPECT().List(gomock.Any(), az.Config.ResourceGroup).Return([]network.PrivateLinkService{}, nil).AnyTimes()
+	az.PrivateLinkServiceClient = plsClient
+
+	status, err := az.EnsureLoadBalancer(context.TODO(), testClusterName, &service, clusterResources.nodes)
+	if !assert.NoError(t, err) {
+		return
+	}
+	if assert.NotNil(t, status) && assert.NotEmpty(t, status.Ingress) {
+		assert.Equal(t, "9.8.7.6", status.Ingress[0].IP)
+	}
+	if reconciledLB.FrontendIPConfigurations == nil {
+		t.Fatal("reconciliation did not return the existing frontend configuration")
+	}
+	configs := *reconciledLB.FrontendIPConfigurations
+	if len(configs) != 1 {
+		t.Fatalf("expected the new Service to reuse one frontend configuration, got %d", len(configs))
+	}
+	if configs[0].PublicIPAddress == nil || configs[0].PublicIPAddress.ID == nil {
+		t.Fatal("reused frontend configuration has no public IP reference")
+	}
+	assert.Equal(t, pipID, *configs[0].PublicIPAddress.ID)
+}
