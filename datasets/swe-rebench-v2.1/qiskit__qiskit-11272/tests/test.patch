+    def test_barrier(self):
+        """Test that a barrier spans all qubits selected by a set."""
+        qc = QuantumCircuit(3)
+        selected_qubits = {qc.qubits[0], qc.qubits[1]}
+        qc.barrier({0, 1})
+
+        barrier = qc.data[-1]
+        self.assertEqual(set(barrier.qubits), selected_qubits)
+        self.assertEqual(barrier.operation.num_qubits, len(selected_qubits))
