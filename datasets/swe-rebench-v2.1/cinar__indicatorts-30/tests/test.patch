+// Copyright (c) 2022 Onur Cinar. All Rights Reserved.
+// https://github.com/cinar/indicatorts
+
+import { ema, trix } from '../../index';
+
+describe('Triple Exponential Average (TRIX)', () => {
+  it('should reflect upward and downward momentum around zero', () => {
+    const risingValues = [1, 2, 3, 4, 5, 6, 7, 8];
+    const fallingValues = [8, 7, 6, 5, 4, 3, 2, 1];
+    const rising = trix(3, risingValues);
+    const falling = trix(3, fallingValues);
+
+    expect(rising).toHaveLength(risingValues.length);
+    expect(falling).toHaveLength(fallingValues.length);
+    expect(rising[0]).toBe(0);
+    expect(falling[0]).toBe(0);
+    expect(rising.some((value: number) => value > 0)).toBe(true);
+    expect(falling.some((value: number) => value < 0)).toBe(true);
+  });
+
+  it('should report the rate of change of the triple-smoothed EMA as a decimal proportion', () => {
+    const values = [10, 12, 11, 15, 14, 18, 17, 21, 20, 25];
+    const period = 3;
+
+    const ema3 = ema(period, ema(period, ema(period, values)));
+    const result = trix(period, values);
+
+    expect(result).toHaveLength(values.length);
+    expect(result[0]).toBe(0);
+
+    for (let i = 1; i < values.length; i++) {
+      const expected = (ema3[i] - ema3[i - 1]) / ema3[i - 1];
+      expect(result[i]).toBeCloseTo(expected, 12);
+    }
+  });
+});
