+#[test]
+fn mapv_into_any_consumes_input() {
+    let _: fn(Array<i32, Ix1>, fn(i32) -> i64) -> Array<i64, Ix1> =
+        ArrayBase::mapv_into_any;
+}
+
+#[test]
+fn mapv_into_any_same_type() {
+    let a: Array<f64, _> = array![[1., 2., 3.], [4., 5., 6.]];
+    let a_plus_one: Array<f64, _> = array![[2., 3., 4.], [5., 6., 7.]];
+    let allocation = a.as_ptr();
+    let mapped = a.mapv_into_any(|a| a + 1.);
+    assert_eq!(mapped, a_plus_one);
+    assert_eq!(mapped.as_ptr(), allocation);
+}
+
+#[test]
+fn mapv_into_any_diff_types() {
+    let a: Array<f64, _> = array![[1., 2., 3.], [4., 5., 6.]];
+    let a_even: Array<bool, _> = array![[false, true, false], [true, false, true]];
+    assert_eq!(a.mapv_into_any(|a| a.round() as i32 % 2 == 0), a_even);
+}
+
+#[test]
+fn mapv_into_any_diff_types_nonstandard_layout() {
+    let a = Array::from_shape_vec((2, 3).f(), vec![1., 4., 2., 5., 3., 6.]).unwrap();
+    let mapped: Array<i32, _> = a.mapv_into_any(|value| (value * 10.) as i32);
+    let expected = array![[10, 20, 30], [40, 50, 60]];
+    assert_eq!(mapped, expected);
+    assert_eq!(mapped.shape(), &[2, 3]);
+}
+
+#[test]
+fn mapv_into_any_preserves_higher_rank_shape() {
+    let a = Array::from_shape_vec((2, 1, 3), vec![1., 2., 3., 4., 5., 6.]).unwrap();
+    let mapped: Array<i32, _> = a.mapv_into_any(|value| value as i32 + 10);
+    let expected = Array::from_shape_vec((2, 1, 3), vec![11, 12, 13, 14, 15, 16]).unwrap();
+    assert_eq!(mapped, expected);
+    assert_eq!(mapped.shape(), &[2, 1, 3]);
+}
+
