+func TestServerClientUpdate(t *testing.T) {
+	env := newTestEnv()
+	defer env.Teardown()
+
+	env.Mux.HandleFunc("/servers/1", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPut {
+			t.Errorf("expected PUT, got %s", r.Method)
+		}
+		var body map[string]interface{}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Fatal(err)
+		}
+		if body["name"] != "test" {
+			t.Errorf("unexpected name: %v", body["name"])
+		}
+		json.NewEncoder(w).Encode(map[string]interface{}{
+			"server": map[string]interface{}{"id": 1},
+		})
+	})
+
+	updatedServer, _, err := env.Client.Server.Update(context.Background(), &Server{ID: 1}, ServerUpdateOpts{Name: "test"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if updatedServer.ID != 1 {
+		t.Errorf("unexpected server ID: %v", updatedServer.ID)
+	}
+}
