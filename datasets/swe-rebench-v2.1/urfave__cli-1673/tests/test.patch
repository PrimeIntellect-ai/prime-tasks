+func TestAppHelpKeepsUncategorizedFlagsBesideCategories(t *testing.T) {
+	// Reset HelpPrinter after this test.
+	defer func(old helpPrinter) {
+		HelpPrinter = old
+	}(HelpPrinter)
+
+	output := new(bytes.Buffer)
+	app := &App{
+		Name:   "cli.test",
+		Writer: output,
+		Action: func(ctx *Context) error { return nil },
+		Flags: []Flag{
+			&StringFlag{
+				Name: "strd", // no category set
+			},
+			&Int64Flag{
+				Name:     "intd",
+				Aliases:  []string{"altd1", "altd2"},
+				Category: "cat1",
+			},
+			&BoolFlag{
+				Name:   "secret",
+				Hidden: true,
+			},
+		},
+	}
+
+	c := NewContext(app, nil, nil)
+	app.Setup()
+
+	HelpPrinter = func(w io.Writer, templ string, data interface{}) {
+		funcMap := map[string]interface{}{
+			"wrapAt": func() int {
+				return 30
+			},
+		}
+
+		HelpPrinterCustom(w, templ, data, funcMap)
+	}
+
+	_ = ShowAppHelp(c)
+
+	for _, name := range []string{"--strd", "--intd"} {
+		if !strings.Contains(output.String(), name) {
+			t.Errorf("help does not show visible flag %q:\n%s", name, output.String())
+		}
+	}
+	if strings.Contains(output.String(), "--secret") {
+		t.Errorf("help shows explicitly hidden flag:\n%s", output.String())
+	}
+}
+
+func TestCommandHelpIncludesUncategorizedFlagsAlongsideCategories(t *testing.T) {
+	defer func(old helpPrinter) {
+		HelpPrinter = old
+	}(HelpPrinter)
+
+	output := new(bytes.Buffer)
+	app := &App{
+		Name:   "cli.test",
+		Writer: output,
+		Commands: []*Command{
+			{
+				Name:  "serve",
+				Usage: "serve requests",
+				Flags: []Flag{
+					&StringFlag{Name: "plain"},
+					&Int64Flag{Name: "categorized", Category: "network"},
+					&BoolFlag{Name: "secret", Hidden: true},
+				},
+			},
+		},
+	}
+	app.Setup()
+	ctx := NewContext(app, nil, nil)
+	_ = ShowCommandHelp(ctx, "serve")
+
+	for _, name := range []string{"--plain", "--categorized"} {
+		if !strings.Contains(output.String(), name) {
+			t.Errorf("command help does not show visible flag %q:\n%s", name, output.String())
+		}
+	}
+	if strings.Contains(output.String(), "--secret") {
+		t.Errorf("command help shows explicitly hidden flag:\n%s", output.String())
+	}
+}
