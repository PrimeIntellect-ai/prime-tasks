+def test_unique_tag_in_sensitivity_mapping_output(tmp_path):
+    import numpy as np
+
+    from autofit.non_linear.grid import sensitivity as s
+    from autofit.non_linear.mock.mock_samples_summary import MockSamplesSummary
+
+    x = np.array(range(10))
+
+    class Simulate:
+        def __call__(self, instance, simulate_path=None):
+            image = instance.gaussian(x)
+            if hasattr(instance, "perturb"):
+                image += instance.perturb(x)
+            return image
+
+    class Analysis(af.Analysis):
+        def __init__(self, dataset):
+            self.dataset = dataset
+
+        def log_likelihood_function(self, instance):
+            dataset = Simulate()(instance)
+            return np.mean(-0.5 * np.square(self.dataset - dataset))
+
+    class Fit:
+        def __init__(self, analysis_cls):
+            self.analysis_cls = analysis_cls
+
+        def __call__(self, dataset, model, paths):
+            search = af.m.MockSearch(
+                return_sensitivity_results=True,
+                samples_summary=MockSamplesSummary(model=model),
+            )
+            return search.fit(model=model, analysis=self.analysis_cls(dataset=dataset))
+
+    instance = af.ModelInstance()
+    instance.gaussian = af.Gaussian()
+
+    paths = af.DirectoryPaths(
+        path_prefix=tmp_path,
+        unique_tag="hello",
+        name="sensitivity_mapping",
+    )
+
+    sensitivity = s.Sensitivity(
+        simulation_instance=instance,
+        base_model=af.Collection(gaussian=af.Model(af.Gaussian)),
+        perturb_model=af.Model(af.Gaussian),
+        simulate_cls=Simulate(),
+        base_fit_cls=Fit(Analysis),
+        perturb_fit_cls=Fit(Analysis),
+        paths=paths,
+        number_of_steps=2,
+        number_of_cores=1,
+    )
+
+    sensitivity.run()
+
+    assert "hello" in sensitivity.results_path.parts
+    assert sensitivity.results_path.exists()
