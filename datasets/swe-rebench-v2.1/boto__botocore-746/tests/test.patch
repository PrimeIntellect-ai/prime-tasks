+    def test_session_client_with_cross_account_datetime_expiration(self):
+        with tempfile.TemporaryDirectory() as temp_dir:
+            config_file = os.path.join(temp_dir, 'config')
+            credentials_file = os.path.join(temp_dir, 'credentials')
+            with open(config_file, 'w') as config:
+                config.write('[profile Test]\n'
+                             'role_arn = arn:aws:iam::123456789012:role/Test\n'
+                             'source_profile = Master\n')
+            with open(credentials_file, 'w') as credentials_file_handle:
+                credentials_file_handle.write(
+                    '[Master]\n'
+                    'aws_access_key_id = source-key\n'
+                    'aws_secret_access_key = source-secret\n')
+
+            session = botocore.session.get_session()
+            session.set_config_variable('profile', 'Test')
+            session.set_config_variable('config_file', config_file)
+            session.set_config_variable('credentials_file', credentials_file)
+
+            sts_client = mock.Mock()
+            sts_client.assume_role.return_value = {
+                'Credentials': {
+                    'AccessKeyId': 'role-key',
+                    'SecretAccessKey': 'role-secret',
+                    'SessionToken': 'role-token',
+                    'Expiration': datetime.now(tzlocal()) + timedelta(hours=1),
+                },
+            }
+            original_create_client = session.create_client
+
+            def create_client(service_name, *args, **kwargs):
+                if service_name == 'sts':
+                    return sts_client
+                return original_create_client(service_name, *args, **kwargs)
+
+            with mock.patch.object(session, 'create_client',
+                                   side_effect=create_client):
+                client = session.create_client('ec2', region_name='us-west-2')
+
+            self.assertIsNotNone(client)
+            self.assertEqual(session.get_credentials().access_key, 'role-key')
+
+    def test_assume_role_with_datetime(self):
+        response = {
+            'Credentials': {
+                'AccessKeyId': 'foo',
+                'SecretAccessKey': 'bar',
+                'SessionToken': 'baz',
+                # Keep the expiration in the future so this check covers
+                # loading the datetime value without invoking refresh.
+                'Expiration': datetime.now(tzlocal()) + timedelta(hours=1)
+            },
+        }
+        client_creator = self.create_client_creator(with_response=response)
+        provider = credentials.AssumeRoleProvider(
+            self.create_config_loader(),
+            client_creator, cache={}, profile_name='development')
+
+        creds = provider.load()
+
+        self.assertEqual(creds.access_key, 'foo')
+        self.assertEqual(creds.secret_key, 'bar')
+        self.assertEqual(creds.token, 'baz')
+
