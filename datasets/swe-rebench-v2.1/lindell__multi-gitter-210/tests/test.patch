+func TestGiteaGetOpenPullRequest(t *testing.T) {
+	repoJSON := `[{"id":1,"name":"test1","owner":{"login":"test-org"},"default_branch":"master","clone_url":"https://gitea.com/test-org/test1.git"}]`
+	prJSON := `[{"number":42,"html_url":"https://gitea.com/test-org/test1/pulls/42","state":"open","head":{"label":"feature-branch","sha":"abc","repo":{"name":"test1","owner":{"login":"test-org"}}},"base":{"repo":{"name":"test1","owner":{"login":"test-org"}}}}]`
+	closedPRJSON := `[{"number":43,"html_url":"https://gitea.com/test-org/test1/pulls/43","state":"closed","head":{"label":"feature-branch","sha":"def","repo":{"name":"test1","owner":{"login":"test-org"}}},"base":{"repo":{"name":"test1","owner":{"login":"test-org"}}}}]`
+	closedLookup := false
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch {
+		case r.URL.Path == "/api/v1/version":
+			fmt.Fprint(w, `{"version":"1.14.0"}`)
+		case r.URL.Path == "/api/v1/orgs/test-org/repos":
+			fmt.Fprint(w, repoJSON)
+		case r.URL.Path == "/api/v1/repos/test-org/test1/pulls":
+			if closedLookup {
+				if r.URL.Query().Get("state") == "all" {
+					fmt.Fprint(w, closedPRJSON)
+				} else {
+					fmt.Fprint(w, `[]`)
+				}
+			} else {
+				fmt.Fprint(w, prJSON)
+			}
+		case strings.HasPrefix(r.URL.Path, "/api/v1/repos/test-org/test1/commits/"):
+			fmt.Fprint(w, `{"state":"success","statuses":[]}`)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+
+	g, err := gitea.New("", server.URL, gitea.RepositoryListing{
+		Organizations: []string{"test-org"},
+	}, []scm.MergeType{scm.MergeTypeMerge})
+	require.NoError(t, err)
+	repos, err := g.GetRepositories(context.Background())
+	require.NoError(t, err)
+	require.Len(t, repos, 1)
+	pr := getOpenPullRequest(t, g, repos[0], "feature-branch")
+	require.NotNil(t, pr)
+	assert.Equal(t, "test-org/test1 #42", pr.String())
+
+	closedLookup = true
+	assert.Nil(t, getOpenPullRequest(t, g, repos[0], "feature-branch"))
+}
