+	closedPRJSON := `{"values":[{"id":43,"version":1,"state":"CLOSED","fromRef":{"displayId":"feature-branch","repository":{"slug":"test1","project":{"key":"TEST"}}},"toRef":{"displayId":"master","repository":{"slug":"test1","project":{"key":"TEST"}}},"links":{"self":[{"href":"https://bitbucket.com/projects/TEST/repos/test1/pull-requests/43"}]}}],"isLastPage":true}`
