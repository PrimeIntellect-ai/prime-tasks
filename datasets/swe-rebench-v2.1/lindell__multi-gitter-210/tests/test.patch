+func TestGithubGetOpenPullRequest(t *testing.T) {
+	repoJSON := `[{"id":1,"name":"test1","full_name":"test-org/test1","owner":{"login":"test-org"},"default_branch":"master","clone_url":"https://github.com/test-org/test1.git","permissions":{"pull":true,"push":true},"created_at":"2020-01-01T16:49:16Z"}]`
+	prJSON := `[{"number":42,"html_url":"https://github.com/test-org/test1/pull/42","head":{"ref":"feature-branch","user":{"login":"test-org"},"repo":{"name":"test1"}},"base":{"user":{"login":"test-org"},"repo":{"name":"test1"}}}]`
+	closedPRJSON := `[{"number":43,"state":"closed","html_url":"https://github.com/test-org/test1/pull/43","head":{"ref":"feature-branch","user":{"login":"test-org"},"repo":{"name":"test1"}},"base":{"user":{"login":"test-org"},"repo":{"name":"test1"}}}]`
+
+	t.Run("existing pull request", func(t *testing.T) {
+		transport := mockTransport{responses: map[string]string{
+			"/orgs/test-org/repos":        repoJSON,
+			"/repos/test-org/test1/pulls": prJSON,
+		}}
+		gh, err := github.New("", "", transport.Wrapper, github.RepositoryListing{
+			Organizations: []string{"test-org"},
+		}, []scm.MergeType{scm.MergeTypeMerge}, false, "")
+		require.NoError(t, err)
+		repos, err := gh.GetRepositories(context.Background())
+		require.NoError(t, err)
+		require.Len(t, repos, 1)
+		pr := getOpenPullRequest(t, gh, repos[0], "feature-branch")
+		require.NotNil(t, pr)
+		assert.Equal(t, "test-org/test1 #42", pr.String())
+	})
+
+	t.Run("no pull request", func(t *testing.T) {
+		transport := mockTransport{responses: map[string]string{
+			"/orgs/test-org/repos":        repoJSON,
+			"/repos/test-org/test1/pulls": `[]`,
+		}}
+		gh, err := github.New("", "", transport.Wrapper, github.RepositoryListing{
+			Organizations: []string{"test-org"},
+		}, []scm.MergeType{scm.MergeTypeMerge}, false, "")
+		require.NoError(t, err)
+		repos, err := gh.GetRepositories(context.Background())
+		require.NoError(t, err)
+		require.Len(t, repos, 1)
+		assert.Nil(t, getOpenPullRequest(t, gh, repos[0], "feature-branch"))
+	})
+
+	t.Run("closed pull request is not returned", func(t *testing.T) {
+		transport := mockTransport{responses: map[string]string{
+			"/orgs/test-org/repos":                   repoJSON,
+			"/repos/test-org/test1/pulls?state=open": `[]`,
+			"/repos/test-org/test1/pulls?state=all":  closedPRJSON,
+		}}
+		gh, err := github.New("", "", transport.Wrapper, github.RepositoryListing{
+			Organizations: []string{"test-org"},
+		}, []scm.MergeType{scm.MergeTypeMerge}, false, "")
+		require.NoError(t, err)
+		repos, err := gh.GetRepositories(context.Background())
+		require.NoError(t, err)
+		require.Len(t, repos, 1)
+		assert.Nil(t, getOpenPullRequest(t, gh, repos[0], "feature-branch"))
+	})
+}
