+type openPullRequestGetter interface {
+	GetOpenPullRequest(ctx context.Context, repo scm.Repository, branchName string) (scm.PullRequest, error)
+}
+
+func getOpenPullRequest(t *testing.T, vc interface{}, repo scm.Repository, branchName string) scm.PullRequest {
+	getter, ok := vc.(openPullRequestGetter)
+	require.True(t, ok, "version controller does not implement GetOpenPullRequest")
+	pr, err := getter.GetOpenPullRequest(context.Background(), repo, branchName)
+	require.NoError(t, err)
+	return pr
+}
