@@ -0,0 +1,33 @@
+/* eslint-env jest */
+
+const DataPoint = require('../../../index')
+
+const dataPoint = DataPoint.create()
+
+describe('DataPoint.helpers.parallel resolution', () => {
+  test('resolves an empty input array to an empty array', () => {
+    return dataPoint
+      .transform(DataPoint.helpers.parallel([]), { value: 1 })
+      .then(result => expect(result.value).toEqual([]))
+  })
+
+  test('returns child reducer results in input order', () => {
+    const input = {
+      a: 1,
+      b: 2,
+      c: 3
+    }
+    const reducers = [
+      '$a',
+      { b: '$b' },
+      ['$c', value => value + 2],
+      DataPoint.helpers.parallel(['$a', '$b', '$c'])
+    ]
+
+    return dataPoint
+      .transform(DataPoint.helpers.parallel(reducers), input)
+      .then(result =>
+        expect(result.value).toEqual([1, { b: 2 }, 5, [1, 2, 3]])
+      )
+  })
+})
