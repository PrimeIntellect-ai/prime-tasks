+use bevy::{input::InputPlugin, prelude::*};
+use leafwing_input_manager::{
+    action_state::ActionDiff,
+    axislike::DualAxisData,
+    prelude::*,
+    systems::{generate_action_diffs, process_action_diffs},
+};
+
+#[derive(Actionlike, Clone, Copy, Debug, Reflect, PartialEq, Eq, Hash)]
+enum Action {
+    PayTheBills,
+}
+
+#[derive(Clone, Copy, Component, Debug, Reflect, PartialEq, Eq, Hash)]
+struct BankAccountId(u32);
+
+#[derive(Default)]
+struct Counter(pub u8);
+
+fn spawn_da_bills(mut commands: Commands) {
+    commands.spawn((BankAccountId(1337), ActionState::<Action>::default()));
+}
+
+fn pay_da_bills(
+    mutation: impl Fn(Mut<ActionState<Action>>) -> (),
+) -> impl Fn(Query<&mut ActionState<Action>>, Local<Counter>) -> () {
+    move |mut action_state_query: Query<&mut ActionState<Action>>, mut counter: Local<Counter>| {
+        if let Ok(mut action_state) = action_state_query.get_single_mut() {
+            if !action_state.pressed(Action::PayTheBills) {
+                action_state.press(Action::PayTheBills);
+                mutation(action_state);
+            } else if counter.0 > 1 {
+                action_state.release(Action::PayTheBills);
+            }
+            counter.0 += 1;
+        }
+    }
+}
+
+fn create_app() -> App {
+    let mut app = App::new();
+    app.add_plugins((
+        MinimalPlugins,
+        InputPlugin,
+        InputManagerPlugin::<Action>::default(),
+    ))
+    .add_systems(Startup, spawn_da_bills)
+    .add_event::<ActionDiff<Action, BankAccountId>>();
+    app
+}
+
+fn get_events<E: Event>(app: &App) -> &Events<E> {
+    app.world.resource()
+}
+fn get_events_mut<E: Event>(app: &mut App) -> Mut<Events<E>> {
+    app.world.resource_mut()
+}
+
+fn send_action_diff(app: &mut App, action_diff: ActionDiff<Action, BankAccountId>) {
+    let mut action_diff_events = get_events_mut::<ActionDiff<Action, BankAccountId>>(app);
+    action_diff_events.send(action_diff);
+}
+
+fn assert_has_no_action_diffs(app: &mut App) {
+    let action_diff_events = get_events::<ActionDiff<Action, BankAccountId>>(app);
+    let action_diff_event_reader = &mut action_diff_events.get_reader();
+    match action_diff_event_reader.read(action_diff_events).next() {
+        Some(action_diff) => panic!(
+            "Expected no `ActionDiff` variants. Received: {:?}",
+            action_diff
+        ),
+        None => {}
+    }
+}
+
+fn assert_action_diff_created(
+    app: &mut App,
+    predicate: impl Fn(&ActionDiff<Action, BankAccountId>) -> bool,
+) {
+    let mut action_diff_events = get_events_mut::<ActionDiff<Action, BankAccountId>>(app);
+    let action_diff_event_reader = &mut action_diff_events.get_reader();
+    let matched = action_diff_event_reader
+        .read(action_diff_events.as_ref())
+        .any(|action_diff| predicate(action_diff));
+    assert!(
+        matched,
+        "Expected a matching `ActionDiff` variant. Received none."
+    );
+    action_diff_events.clear();
+}
+
+fn assert_action_state(
+    app: &mut App,
+    action: Action,
+    pressed: bool,
+) {
+    let mut action_state_query = app.world.query::<&ActionState<Action>>();
+    let action_state = action_state_query.get_single(&app.world).unwrap();
+    assert_eq!(action_state.pressed(action), pressed);
+}
+
+fn forward_action_diffs(source: &mut App, receiver: &mut App) -> usize {
+    let diffs = {
+        let mut events = get_events_mut::<ActionDiff<Action, BankAccountId>>(source);
+        let diffs = {
+            let mut reader = events.get_reader();
+            reader.read(&events).cloned().collect::<Vec<_>>()
+        };
+        events.clear();
+        diffs
+    };
+    let count = diffs.len();
+    for diff in diffs {
+        send_action_diff(receiver, diff);
+    }
+    count
+}
+
+#[test]
+fn generate_binary_action_diffs() {
+    let mut app = create_app();
+    app.add_systems(
+        Update,
+        pay_da_bills(|mut action_state| {
+            action_state.action_data_mut(Action::PayTheBills).value = 1.;
+        }),
+    )
+    .add_systems(PostUpdate, generate_action_diffs::<Action, BankAccountId>);
+
+    app.update();
+    assert_action_diff_created(&mut app, |action_diff| match action_diff {
+        ActionDiff::Pressed { id, action } => {
+            *id == BankAccountId(1337) && *action == Action::PayTheBills
+        }
+        _ => false,
+    });
+
+    app.update();
+
+    assert_has_no_action_diffs(&mut app);
+
+    app.update();
+
+    assert_action_diff_created(&mut app, |action_diff| match action_diff {
+        ActionDiff::Released { id, action } => {
+            *id == BankAccountId(1337) && *action == Action::PayTheBills
+        }
+        _ => false,
+    });
+}
+
+
+#[test]
+fn generate_axis_action_diffs() {
+    let input_axis_pair = Vec2 { x: 5., y: 8. };
+    let mut source = create_app();
+    source.add_systems(
+        Update,
+        pay_da_bills(move |mut action_state| {
+            action_state.action_data_mut(Action::PayTheBills).axis_pair =
+                Some(DualAxisData::from_xy(input_axis_pair));
+        }),
+    )
+    .add_systems(PostUpdate, generate_action_diffs::<Action, BankAccountId>);
+
+    let mut receiver = create_app();
+    receiver.add_systems(PreUpdate, process_action_diffs::<Action, BankAccountId>);
+
+    source.update();
+    assert!(forward_action_diffs(&mut source, &mut receiver) > 0);
+    receiver.update();
+    let mut action_state_query = receiver.world.query::<&ActionState<Action>>();
+    let action_state = action_state_query.get_single(&receiver.world).unwrap();
+    assert_eq!(
+        action_state.axis_pair(Action::PayTheBills).map(|data| data.xy()),
+        Some(input_axis_pair)
+    );
+
+    source.update();
+    assert_has_no_action_diffs(&mut source);
+}
+
+#[test]
+fn process_binary_action_diffs() {
+    let mut app = create_app();
+    app.add_systems(PreUpdate, process_action_diffs::<Action, BankAccountId>);
+
+    let action_diff = ActionDiff::Pressed {
+        id: BankAccountId(1337),
+        action: Action::PayTheBills,
+    };
+    send_action_diff(&mut app, action_diff);
+    app.update();
+    assert_action_state(&mut app, Action::PayTheBills, true);
+
+    let action_diff = ActionDiff::Released {
+        id: BankAccountId(1337),
+        action: Action::PayTheBills,
+    };
+    send_action_diff(&mut app, action_diff);
+    app.update();
+    assert_action_state(&mut app, Action::PayTheBills, false);
+}
+
+
+#[test]
+fn generate_axis_action_diffs_while_pressed() {
+    let mut source = create_app();
+    source.add_systems(
+        Update,
+        |mut action_state_query: Query<&mut ActionState<Action>>, mut counter: Local<Counter>| {
+            if let Ok(mut action_state) = action_state_query.get_single_mut() {
+                match counter.0 {
+                    0 => {
+                        action_state.press(Action::PayTheBills);
+                        action_state.action_data_mut(Action::PayTheBills).axis_pair =
+                            Some(DualAxisData::from_xy(Vec2 { x: 1., y: 0. }));
+                    }
+                    1 => {
+                        action_state.action_data_mut(Action::PayTheBills).axis_pair =
+                            Some(DualAxisData::from_xy(Vec2 { x: 0., y: 1. }));
+                    }
+                    _ => {}
+                }
+                counter.0 += 1;
+            }
+        },
+    )
+    .add_systems(PostUpdate, generate_action_diffs::<Action, BankAccountId>);
+
+    let mut receiver = create_app();
+    receiver.add_systems(PreUpdate, process_action_diffs::<Action, BankAccountId>);
+
+    source.update();
+    forward_action_diffs(&mut source, &mut receiver);
+    receiver.update();
+    source.update();
+    assert!(forward_action_diffs(&mut source, &mut receiver) > 0);
+    receiver.update();
+    let mut action_state_query = receiver.world.query::<&ActionState<Action>>();
+    let action_state = action_state_query.get_single(&receiver.world).unwrap();
+    assert_eq!(
+        action_state.axis_pair(Action::PayTheBills).map(|data| data.xy()),
+        Some(Vec2 { x: 0., y: 1. })
+    );
+}
+
+#[test]
+fn generate_scalar_action_value_diffs() {
+    let mut source = create_app();
+    source
+        .add_systems(
+            Update,
+            |mut action_state_query: Query<&mut ActionState<Action>>, mut counter: Local<Counter>| {
+                if let Ok(mut action_state) = action_state_query.get_single_mut() {
+                    match counter.0 {
+                        0 => {
+                            action_state.press(Action::PayTheBills);
+                            action_state.action_data_mut(Action::PayTheBills).value = 1.0;
+                        }
+                        1 => {
+                            action_state.action_data_mut(Action::PayTheBills).value = 0.75;
+                        }
+                        _ => {}
+                    }
+                    counter.0 += 1;
+                }
+            },
+        )
+        .add_systems(PostUpdate, generate_action_diffs::<Action, BankAccountId>);
+
+    source.update();
+    assert_action_diff_created(&mut source, |action_diff| matches!(
+        action_diff,
+        ActionDiff::Pressed { id, action }
+            if *id == BankAccountId(1337) && *action == Action::PayTheBills
+    ));
+
+    source.update();
+    assert_action_diff_created(&mut source, |action_diff| {
+        !matches!(action_diff, ActionDiff::Pressed { .. } | ActionDiff::Released { .. })
+    });
+
+    source.update();
+    assert_has_no_action_diffs(&mut source);
+}
+
+#[test]
+fn process_scalar_action_value_diffs_for_matching_action_state() {
+    let mut source = create_app();
+    source
+        .add_systems(
+            Update,
+            |mut action_state_query: Query<&mut ActionState<Action>>, mut counter: Local<Counter>| {
+                if let Ok(mut action_state) = action_state_query.get_single_mut() {
+                    match counter.0 {
+                        0 => {
+                            action_state.press(Action::PayTheBills);
+                            action_state.action_data_mut(Action::PayTheBills).value = 1.0;
+                        }
+                        1 => {
+                            action_state.action_data_mut(Action::PayTheBills).value = 0.625;
+                        }
+                        _ => {}
+                    }
+                    counter.0 += 1;
+                }
+            },
+        )
+        .add_systems(PostUpdate, generate_action_diffs::<Action, BankAccountId>);
+
+    let mut receiver = create_app();
+    receiver
+        .world
+        .spawn((BankAccountId(7331), ActionState::<Action>::default()));
+    receiver.add_systems(PreUpdate, process_action_diffs::<Action, BankAccountId>);
+
+    source.update();
+    forward_action_diffs(&mut source, &mut receiver);
+    receiver.update();
+
+    source.update();
+    assert!(forward_action_diffs(&mut source, &mut receiver) > 0);
+    receiver.update();
+
+    let mut action_state_query = receiver.world.query::<(&BankAccountId, &ActionState<Action>)>();
+    for (id, action_state) in action_state_query.iter(&receiver.world) {
+        if id.0 == 1337 {
+            assert_eq!(action_state.value(Action::PayTheBills), 0.625);
+        } else {
+            assert_eq!(action_state.value(Action::PayTheBills), 0.0);
+        }
+    }
+}
