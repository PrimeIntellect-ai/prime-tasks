+"""Tests for YeoJohnsonTransformer."""
+
+__maintainer__ = []
+__all__ = []
+
+import numpy as np
+from scipy.stats import yeojohnson
+
+from aeon.datasets import load_airline
+from aeon.transformations.series._yeojohnson import YeoJohnsonTransformer
+
+
+def test_yeojohnson_against_scipy():
+    y = load_airline()
+
+    t = YeoJohnsonTransformer()
+    actual = t.fit_transform(y)
+
+    excepted, expected_lambda = yeojohnson(y.values)
+    np.testing.assert_almost_equal(np.asarray(actual).reshape(-1), excepted, decimal=12)
+    assert t._lambda == expected_lambda
+
+
+def test_yeojohnson_handles_zero_and_negative_values():
+    X = np.array([-3.0, -1.0, 0.0, 1.0, 2.0, 5.0])
+
+    t = YeoJohnsonTransformer()
+    actual = t.fit_transform(X)
+
+    excepted, expected_lambda = yeojohnson(X)
+    np.testing.assert_almost_equal(np.asarray(actual).reshape(-1), excepted, decimal=12)
+    assert t._lambda == expected_lambda
+
+
+def test_yeojohnson_returns_numpy_array():
+    y = load_airline()
+
+    t = YeoJohnsonTransformer()
+    actual = t.fit_transform(y)
+
+    assert isinstance(actual, np.ndarray)
