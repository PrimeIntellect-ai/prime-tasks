+def test_nested_unwrap_preserves_plain_python_values():
+    source = {
+        "count": 666,
+        "ratio": 2.78,
+        "enabled": True,
+        "items": [False, {"values": [1, 2]}],
+    }
+
+    unwrapped = item(source).unwrap()
+
+    assert unwrapped == source
+    assert type(unwrapped) is dict
+    assert type(unwrapped["items"]) is list
+    assert type(unwrapped["items"][1]) is dict
+    assert all(type(key) is str for key in unwrapped)
+
+
+def test_inline_table_unwrap():
+    inline_table = parse("value = { number = 42, nested = { enabled = true } }")["value"]
+    assert isinstance(inline_table, InlineTable)
+
+    unwrapped = inline_table.unwrap()
+
+    assert_is_ppo(unwrapped, dict)
+    assert unwrapped == {"number": 42, "nested": {"enabled": True}}
+    assert type(unwrapped["number"]) is int
+    assert_is_ppo(unwrapped["nested"], dict)
+    assert type(unwrapped["nested"]["enabled"]) is bool
+
+
+def test_abstract_table_unwrap():
+    table = item({"foo": "bar"})
+    super_table = item({"table": table, "baz": "borg"})
+    assert isinstance(super_table["table"], Table)
+
+    table_unwrapped = super_table.unwrap()
+    sub_table = table_unwrapped["table"]
+    assert_is_ppo(table_unwrapped, dict)
+    assert_is_ppo(sub_table, dict)
+    for ku in sub_table:
+        vu = sub_table[ku]
+        assert_is_ppo(ku, str)
+        assert_is_ppo(vu, str)
+
