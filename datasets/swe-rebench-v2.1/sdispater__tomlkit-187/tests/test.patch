+def test_aot_unwrap():
+    d = item([{"a": "A"}, {"b": "B"}])
+    assert isinstance(d, AoT)
+    unwrapped = d.unwrap()
+    assert_is_ppo(unwrapped, list)
+    for du, dw in zip(unwrapped, d):
+        assert_is_ppo(du, dict)
+        for ku in du:
