diff --git a/test/export/InstanceExporter.test.ts b/test/export/InstanceExporter.test.ts
index 266a5ce..2248ca4 100644
--- a/test/export/InstanceExporter.test.ts
+++ b/test/export/InstanceExporter.test.ts
@@ -5,6 +5,7 @@ import { FHIRDefinitions } from '../../src/fhirdefs';
 import {
   Instance,
   Profile,
+  Resource,
   FshCanonical,
   FshCode,
   FshReference,
@@ -20,7 +21,8 @@ import {
   ContainsRule,
   FlagRule,
   InsertRule,
-  OnlyRule
+  OnlyRule,
+  AddElementRule
 } from '../../src/fshtypes/rules';
 import { loggerSpy, TestFisher } from '../testhelpers';
 import { InstanceDefinition } from '../../src/fhirtypes';
@@ -4998,6 +5000,87 @@ describe('InstanceExporter', () => {
         /CaretValueRule.*Instance.*File: Caret\.fsh.*Line: 1 - 3.*Applied in File: Insert\.fsh.*Applied on Line: 5 - 7/s
       );
     });
+
+    it('should populate title and description when specified for instances with #definition', () => {
+      // Instance: DemoQuestionnaire
+      // InstanceOf: Questionnaire
+      // Usage: #definition
+      // Title: "My Demo Questionnaire"
+      // Description: "My Demo Questionnaire's description"
+      //* name = "DemoQuestionnaire"
+      //* status = #draft
+      const goalInstance = new Instance('DemoQuestionnaire');
+      goalInstance.instanceOf = 'Questionnaire';
+      goalInstance.usage = 'Definition';
+      goalInstance.title = 'My Demo Questionnaire';
+      goalInstance.description = "My Demo Questionnaire's description";
+      const statusDraft = new AssignmentRule('status');
+      statusDraft.value = new FshCode('draft');
+      const nameDemo = new AssignmentRule('name');
+      nameDemo.value = new FshCode('DemoQuestionnaire');
+      goalInstance.rules.push(statusDraft, nameDemo);
+      const exported = exportInstance(goalInstance);
+      expect(exported.title).toMatch('My Demo Questionnaire');
+      expect(exported.description).toMatch("My Demo Questionnaire's description");
+    });
+
+    it("should not populate title and description for instances that don't have title or description (like Patient)", () => {
+      // Instance: JustAPatient
+      // InstanceOf: Patient
+      // Usage: #definition
+      // Title: "Just a Patient"
+      // Description: "This is just a patient"
+      const goalInstance = new Instance('JustAPatient');
+      goalInstance.instanceOf = 'Patient';
+      goalInstance.usage = 'Definition';
+      goalInstance.title = 'Just a Patient';
+      goalInstance.description = 'This is just a patient';
+      const exported = exportInstance(goalInstance);
+      expect(exported.title).toBeUndefined();
+      expect(exported.description).toBeUndefined();
+    });
+
+    it('should populate title when the target type has title but not description', () => {
+      const target = new Resource('TitleOnlyResource');
+      target.id = target.name;
+      const titleElement = new AddElementRule('title');
+      titleElement.min = 0;
+      titleElement.max = '1';
+      titleElement.types = [{ type: 'string' }];
+      target.rules.push(titleElement);
+      doc.resources.set(target.name, target);
+
+      const instance = new Instance('TitleOnlyInstance');
+      instance.instanceOf = target.name;
+      instance.usage = 'Definition';
+      instance.title = 'Supported title';
+      instance.description = 'Unsupported description';
+      const exported = exportInstance(instance);
+
+      expect(exported.title).toBe('Supported title');
+      expect(exported.description).toBeUndefined();
+    });
+
+    it('should populate description when the target type has description but not title', () => {
+      const target = new Resource('DescriptionOnlyResource');
+      target.id = target.name;
+      const descriptionElement = new AddElementRule('description');
+      descriptionElement.min = 0;
+      descriptionElement.max = '1';
+      descriptionElement.types = [{ type: 'string' }];
+      target.rules.push(descriptionElement);
+      doc.resources.set(target.name, target);
+
+      const instance = new Instance('DescriptionOnlyInstance');
+      instance.instanceOf = target.name;
+      instance.usage = 'Definition';
+      instance.title = 'Unsupported title';
+      instance.description = 'Supported description';
+      const exported = exportInstance(instance);
+
+      expect(exported.title).toBeUndefined();
+      expect(exported.description).toBe('Supported description');
+    });
   });
 });
 
