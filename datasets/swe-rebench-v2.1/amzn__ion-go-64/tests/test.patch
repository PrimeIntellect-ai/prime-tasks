+func TestReadmeRetainsJSONAnnotationPattern(t *testing.T) {
+	readme, err := os.ReadFile("../README.md")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !regexp.MustCompile(`(?is)json.{0,200}?(annotation|tag|pattern)|(annotation|tag|pattern).{0,200}?json`).Match(readme) {
+		t.Fatal("README must retain a reference to the JSON annotation pattern")
+	}
+}
