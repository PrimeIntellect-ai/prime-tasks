@@ -293,10 +273,110 @@ defmodule PoolexTest do
     end
   end
 
+  describe "overflow" do
+    test "create new workers when possible", %{pool_name: pool_name} do
+      Poolex.start_link(pool_name, worker_module: SomeWorker, workers_count: 1, max_overflow: 5)
+
+      launch_long_tasks(pool_name, 5)
+
+      # Wait until every launched caller has acquired a worker instead of
+      # relying on a fixed sleep, which is scheduler dependent.
+      wait_until(fn -> Poolex.get_debug_info(pool_name).busy_workers_count == 5 end)
+
+      debug_info = Poolex.get_debug_info(pool_name)
+      assert debug_info.busy_workers_count == 5
+    end
+
+    test "return error when max count of workers reached", %{pool_name: pool_name} do
+      Poolex.start_link(pool_name, worker_module: SomeWorker, workers_count: 1)
+
+      launch_long_task(pool_name)
+
+      result =
+        Poolex.run(
+          pool_name,
+          fn pid -> GenServer.call(pid, {:do_some_work_with_delay, :timer.seconds(4)}) end,
+          timeout: 100
+        )
+
+      assert result == :all_workers_are_busy
+
+      debug_info = Poolex.get_debug_info(pool_name)
+
+      assert debug_info.busy_workers_count == 1
+    end
+
+    test "does not create more workers than the configured overflow limit", %{pool_name: pool_name} do
+      Poolex.start_link(pool_name, worker_module: SomeWorker, workers_count: 1, max_overflow: 2)
+      test_process = self()
+
+      for _ <- 1..3 do
+        spawn(fn ->
+          Poolex.run(pool_name, fn pid ->
+            send(test_process, {:worker_started, pid})
+            :timer.sleep(1_000)
+          end)
+        end)
+      end
+
+      # One regular worker and two overflow workers can run at once.
+      for _ <- 1..3 do
+        assert_receive {:worker_started, _pid}, 1_000
+      end
+
+      result =
+        Poolex.run(
+          pool_name,
+          fn pid -> send(test_process, {:over_limit_worker_started, pid}) end,
+          timeout: 100
+        )
+
+      assert result == :all_workers_are_busy
+      refute_receive {:over_limit_worker_started, _pid}, 50
+    end
+  end
+
   defp pool_name do
     1..10
     |> Enum.map(fn _ -> Enum.random(?a..?z) end)
     |> to_string()
     |> String.to_atom()
   end
+
+  defp launch_long_task(pool_id, delay \\ :timer.seconds(4)) do
+    launch_long_tasks(pool_id, 1, delay)
+  end
+
+  defp launch_long_tasks(pool_id, count, delay \\ :timer.seconds(4)) do
+    for _i <- 1..count do
+      spawn(fn ->
+        Poolex.run(
+          pool_id,
+          fn pid -> GenServer.call(pid, {:do_some_work_with_delay, delay}) end,
+          timeout: 100
+        )
+      end)
+    end
+
+    :timer.sleep(10)
+  end
+
+  defp wait_until(fun, timeout \\ 1000) do
+    deadline = System.monotonic_time(:millisecond) + timeout
+    do_wait_until(fun, deadline)
+  end
+
+  defp do_wait_until(fun, deadline) do
+    cond do
+      fun.() ->
+        :ok
+
+      System.monotonic_time(:millisecond) >= deadline ->
+        :timeout
+
+      true ->
+        :timer.sleep(5)
+        do_wait_until(fun, deadline)
+    end
+  end
 end
