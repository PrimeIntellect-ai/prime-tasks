+func TestGoBuildProducesMobExecutable(t *testing.T) {
+dir, err := ioutil.TempDir("", "mob-build")
+if err != nil {
+t.Fatal(err)
+}
+defer os.RemoveAll(dir)
+
+files, err := filepath.Glob("*.go")
+if err != nil {
+t.Fatal(err)
+}
+files = append(files, "go.mod")
+for _, file := range files {
+content, err := ioutil.ReadFile(file)
+if err != nil {
+t.Fatal(err)
+}
+if err := ioutil.WriteFile(filepath.Join(dir, file), content, 0644); err != nil {
+t.Fatal(err)
+}
+}
+
+build := exec.Command("go", "build")
+build.Dir = dir
+if output, err := build.CombinedOutput(); err != nil {
+t.Fatalf("go build failed: %v\n%s", err, output)
+}
+
+executable := "mob"
+if runtime.GOOS == "windows" {
+executable = "mob.exe"
+}
+if _, err := os.Stat(filepath.Join(dir, executable)); err != nil {
+t.Errorf("expected go build to produce an executable named %s: %v", executable, err)
+}
+}
+
+func TestGoModDeclaresGo114AsMinimumVersion(t *testing.T) {
+output, err := exec.Command("go", "list", "-m", "-f", "{{.GoVersion}}").Output()
+if err != nil {
+t.Fatalf("go list failed: %v", err)
+}
+equals(t, "1.14", strings.TrimSpace(string(output)))
+}
