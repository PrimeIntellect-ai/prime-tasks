+func TestMutator_MutateJob_PendingTimeoutKeepsCreationDefault(t *testing.T) {
+	initialConfig := &configv1alpha1.JobExecutionConfig{
+		DefaultPendingTimeoutSeconds: pointer.Int64(300),
+	}
+	mutator := setup(t, map[configv1alpha1.ConfigName]runtime.Object{
+		configv1alpha1.JobExecutionConfigName: initialConfig,
+	}, nil)
+	createdJob := &v1alpha1.Job{
+		Spec: v1alpha1.JobSpec{
+			Template: &v1alpha1.JobTemplate{},
+		},
+	}
+	if result := mutator.MutateJob(createdJob); result.Errors.ToAggregate() != nil {
+		t.Fatalf("MutateJob() returned errors: %v", result.Errors.ToAggregate())
+	}
+
+	changedConfig := &configv1alpha1.JobExecutionConfig{
+		DefaultPendingTimeoutSeconds: pointer.Int64(60),
+	}
+	if got, want := jobutil.GetPendingTimeout(createdJob, changedConfig), 300*time.Second; got != want {
+		t.Errorf("effective pending timeout after changing the default = %v, want %v", got, want)
+	}
+}
