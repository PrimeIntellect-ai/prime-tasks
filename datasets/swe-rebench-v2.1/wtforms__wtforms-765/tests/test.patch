@@ -0,0 +1,87 @@
+from datetime import date
+
+from tests.common import DummyPostData
+
+from wtforms.fields import ColorField
+from wtforms.fields import MonthField
+from wtforms.fields import WeekField
+from wtforms.fields.datetime import WeekField as DatetimeWeekField
+from wtforms.form import Form
+from wtforms.validators import InputRequired
+
+
+class F(Form):
+    a = WeekField()
+    b = WeekField(format="W%W %Y")
+    c = WeekField(format="%Y-W%W-%w")
+
+
+def test_basic():
+    form = F(DummyPostData(a=["2023-W03"], b=["W03 2023"], c=["2023-W03-1"]))
+
+    assert form.a.data == date(2023, 1, 16)
+    assert 'type="week"' in form.a()
+
+    assert form.b.data == date(2023, 1, 16)
+
+    assert form.c.data == date(2023, 1, 16)
+
+
+def test_invalid_data():
+    form = F(DummyPostData(a=["2008-Wbb"]))
+
+    assert not form.validate()
+    assert 1 == len(form.a.process_errors)
+    assert 1 == len(form.a.errors)
+    assert "Not a valid week value." == form.a.process_errors[0]
+    assert form.a.data is None
+
+
+class M(Form):
+    a = MonthField()
+    b = MonthField(format="%m/%Y")
+
+
+def test_month_field():
+    form = M(DummyPostData(a=["2008-05"], b=["05/2008"]))
+
+    assert form.a.data == date(2008, 5, 1)
+    assert 'type="month"' in form.a()
+
+    assert form.b.data == date(2008, 5, 1)
+
+
+class C(Form):
+    a = ColorField(default="#ff0000")
+
+
+def test_color_field():
+    form = C()
+
+    assert 'type="color"' in form.a()
+
+
+class ConfiguredWeekForm(Form):
+    week = WeekField(
+        "Calendar week",
+        validators=[InputRequired()],
+        id="week-entry",
+        description="Choose a week",
+        render_kw={"data-kind": "calendar"},
+    )
+
+
+def test_week_field_public_module_and_date_field_options():
+    assert DatetimeWeekField is WeekField
+    assert WeekField.__module__ == "wtforms.fields.datetime"
+
+    form = ConfiguredWeekForm(DummyPostData(week=["2023-W03"]))
+    assert form.week.label.text == "Calendar week"
+    assert form.week.description == "Choose a week"
+    assert 'id="week-entry"' in form.week()
+    assert 'data-kind="calendar"' in form.week()
+    assert form.validate()
+
+    empty_form = ConfiguredWeekForm(DummyPostData(week=[""]))
+    assert not empty_form.validate()
+    assert empty_form.week.errors
