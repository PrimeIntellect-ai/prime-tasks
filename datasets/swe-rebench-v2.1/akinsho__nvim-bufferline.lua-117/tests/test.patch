diff --git a/tests/bufferline_spec.lua b/tests/bufferline_spec.lua
index 9a7f552..380d6d0 100644
--- a/tests/bufferline_spec.lua
+++ b/tests/bufferline_spec.lua
@@ -22,5 +22,41 @@ describe("Bufferline tests:", function()
       assert.truthy(tabline)
       assert.is_truthy(tabline:match(icon))
     end)
+
+    it('should handle close click correctly', function()
+      local bufnum = vim.api.nvim_get_current_buf()
+      local count = 1
+      local expected = bufnum + count
+      bufferline.setup({
+        options = {
+          close_command = function (bufid)
+            count = count + bufid
+          end
+        }
+      })
+      bufferline.handle_close_buffer(bufnum)
+      assert.is_equal(count, expected)
+    end)
+
+    it('should delete the buffer when no custom close action is configured', function()
+      bufferline.setup()
+      local bufnum = vim.api.nvim_create_buf(true, false)
+      vim.api.nvim_set_current_buf(bufnum)
+
+      bufferline.handle_close_buffer(bufnum)
+      assert.is_equal(0, vim.fn.buflisted(bufnum))
+    end)
+
+    it('should run a command close action for the target buffer', function()
+      local bufnum = vim.api.nvim_get_current_buf()
+      vim.g.close_command_buffer = nil
+      bufferline.setup({
+        options = {
+          close_command = "let g:close_command_buffer = %d"
+        }
+      })
+      bufferline.handle_close_buffer(bufnum)
+      assert.is_equal(vim.g.close_command_buffer, bufnum)
+    end)
   end)
 end)
