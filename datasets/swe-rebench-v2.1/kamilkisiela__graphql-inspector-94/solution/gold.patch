--- /dev/null
+++ b/packages/core/src/diff/common/compare.ts
@@ -0,0 +1,7 @@
+export function equal<T>(a: T, b: T): boolean {
+  return a === b || (!a && !b);
+}
+
+export function notEqual<T>(a: T, b: T): boolean {
+  return !equal(a, b);
+}
