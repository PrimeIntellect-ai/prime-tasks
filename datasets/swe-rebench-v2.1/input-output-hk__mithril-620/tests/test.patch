+/// Produce a signature for a message on which `signer` wins the lottery.
+fn sign_winning_message(signer: &StmSigner<H>) -> StmSig {
+    for i in 0u64..1000 {
+        let mut msg = [0u8; 16];
+        msg[..8].copy_from_slice(&i.to_be_bytes());
+        if let Some(sig) = signer.sign(&msg) {
+            return sig;
+        }
+    }
+    panic!("signer did not win the lottery for any tried message");
+}
+
+/// An individual signature exposes the required data without key or stake.
+#[test]
+fn test_stm_sig_contains_only_contract_fields() {
+    let params = StmParameters {
+        k: 1,
+        m: 2642,
+        phi_f: 0.2,
+    };
+    let mut rng = ChaCha20Rng::from_seed([7u8; 32]);
+    let initializer = StmInitializer::setup(params, 100, &mut rng);
+    let mut key_reg = KeyReg::init();
+    key_reg.register(100, initializer.verification_key()).unwrap();
+    let signer = initializer.new_signer(key_reg.close()).unwrap();
+    let sig = sign_winning_message(&signer);
+
+    let StmSig {
+        sigma: _,
+        indexes: _,
+        signer_index: _,
+    } = &sig;
+}
