+    def test_optimize_composed_swap_network_once(self):
+        """Retarget measurements through a composed SWAP permutation in one run."""
+        circuit = QuantumCircuit(8, 8)
+        circuit.swap(0, 1)
+        circuit.swap(1, 2)
+        circuit.swap(2, 3)
+        circuit.swap(0, 1)
+        circuit.measure(range(8), range(8))
+
+        expected = QuantumCircuit(8, 8)
+        expected.measure(2, 0)
+        expected.measure(1, 1)
+        expected.measure(3, 2)
+        expected.measure(0, 3)
+        for qubit in range(4, 8):
+            expected.measure(qubit, qubit)
+
+        after = OptimizeSwapBeforeMeasure().run(circuit_to_dag(circuit))
+
+        self.assertEqual(circuit_to_dag(expected), after)
+
