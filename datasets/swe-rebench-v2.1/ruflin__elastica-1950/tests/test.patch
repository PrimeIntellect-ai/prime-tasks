+    /**
+     * @group unit
+     */
+    public function testRawPostFilter(): void
+    {
+        $query = (new Query())
+            ->setQuery(new Term(['field' => 'value']))
+            ->setParam('post_filter', [
+                'term' => ['field' => 'value'],
+            ])
+        ;
+
+        $this->assertSame([
+            'query' => [
+                'term' => [
+                    'field' => 'value',
+                ],
+            ],
+            'post_filter' => [
+                'term' => [
+                    'field' => 'value',
+                ],
+            ],
+        ], $query->toArray());
+    }
+
+    /**
+     * @group unit
+     */
+    public function testEmptyRawPostFilterIsOmitted(): void
+    {
+        $query = (new Query())
+            ->setQuery(new Term(['field' => 'value']))
+            ->setParam('post_filter', [])
+        ;
+
+        $this->assertSame([
+            'query' => [
+                'term' => [
+                    'field' => 'value',
+                ],
+            ],
+        ], $query->toArray());
+    }
+
