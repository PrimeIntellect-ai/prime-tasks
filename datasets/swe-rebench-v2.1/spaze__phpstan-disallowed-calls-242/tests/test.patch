@@ -0,0 +1,26 @@
+<?php
+declare(strict_types = 1);
+
+use Waldo\Quux\Blade;
+
+// disallowed
+$kind = 'RUNNER';
+echo Blade::{$kind};
+/** @var 'DECKARD'|'MOVIE'|'RUNNER' $kind2 */
+echo Blade::{$kind2};
+
+// enum dynamic constant
+$enumKind = 'RUNNER';
+echo \Waldo\Quux\BladeEnum::{$enumKind};
+/** @var 'DECKARD'|'RUNNER' $enumKind2 */
+echo \Waldo\Quux\BladeEnum::{$enumKind2};
+
+// allowed constant in a non-exempt location
+$allowedKind = 'MOVIE';
+echo Blade::{$allowedKind};
+
+// The name has a general string type rather than a known constant string.
+function accessDynamicConstantWithUnknownName(string $constantName): void
+{
+    echo Blade::{$constantName};
+}
