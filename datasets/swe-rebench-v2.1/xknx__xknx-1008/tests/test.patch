+class TestKeyringWithoutBackbone:
+    """Test loading a knxkeys file that has no Backbone element."""
+
+    keyring_test_file = os.path.join(
+        os.path.dirname(__file__), "../secure_tests/resources/keyring.knxkeys"
+    )
+
+    def test_load_keyring_without_backbone(self, tmp_path):
+        """Test that a keyring file without a Backbone element loads and decrypts."""
+        with open(self.keyring_test_file, encoding="utf-8") as file:
+            content = file.read()
+        content_without_backbone = re.sub(r"<Backbone [^>]*/>", "", content)
+        assert "<Backbone" not in content_without_backbone
+        keyring_file = tmp_path / "keyring_without_backbone.knxkeys"
+        keyring_file.write_text(content_without_backbone, encoding="utf-8")
+
+        keyring = load_key_ring(str(keyring_file), "pwd", validate_signature=False)
+
+        interface = keyring.get_interface_by_user_id(2)
+        assert interface is not None
+        assert interface.decrypted_password == "user4"
