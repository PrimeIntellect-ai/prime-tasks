+// transformPublish invokes the public transformer API across releases where its
+// optional request context was added.
+func transformPublish(transformer *Transformer, inData *verifyapi.Publish, batchTime time.Time) ([]*Exposure, error) {
+	method := reflect.ValueOf(transformer).MethodByName("TransformPublish")
+	args := []reflect.Value{reflect.ValueOf(inData), reflect.ValueOf(batchTime)}
+	if method.Type().NumIn() == 3 {
+		args = []reflect.Value{reflect.ValueOf(context.Background()), reflect.ValueOf(inData), reflect.ValueOf(batchTime)}
+	}
+	results := method.Call(args)
+	exposures := results[0].Interface().([]*Exposure)
+	if results[1].IsNil() {
+		return exposures, nil
+	}
+	return exposures, results[1].Interface().(error)
+}
