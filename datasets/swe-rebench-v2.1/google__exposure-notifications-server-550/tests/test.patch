+func TestStillValidKey(t *testing.T) {
+	now := time.Now()
+	batchWindow := TruncateWindow(now, time.Minute)
+	intervalNumber := IntervalNumber(now) - 1
+
+	cases := []struct {
+		name               string
+		source             verifyapi.Publish
+		createdAt          time.Time
+		releaseSameDayKeys bool
+	}{
+		{
+			name: "release same day keys",
+			source: verifyapi.Publish{
+				Keys: []verifyapi.ExposureKey{
+					{
+						Key:              encodeKey(generateKey(t)),
+						IntervalNumber:   intervalNumber,
+						IntervalCount:    verifyapi.MaxIntervalCount,
+						TransmissionRisk: 1,
+					},
+				},
+			},
+			createdAt:          batchWindow,
+			releaseSameDayKeys: true,
+		},
+		{
+			name: "proper embargo",
+			source: verifyapi.Publish{
+				Keys: []verifyapi.ExposureKey{
+					{
+						Key:              encodeKey(generateKey(t)),
+						IntervalNumber:   intervalNumber,
+						IntervalCount:    verifyapi.MaxIntervalCount,
+						TransmissionRisk: 1,
+					},
+				},
+			},
+			createdAt:          TruncateWindow(time.Unix(int64(intervalNumber+verifyapi.MaxIntervalCount)*int64(verifyapi.IntervalLength/time.Second), 0), time.Minute),
+			releaseSameDayKeys: false,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			allowedAge := 2 * 24 * time.Hour
+			transformer, err := NewTransformer(10, allowedAge, time.Minute, tc.releaseSameDayKeys)
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			tf, err := transformPublish(transformer, &tc.source, now)
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			if len(tf) != 1 {
+				t.Fatalf("wrong number of keys, want: 1 got :%v", len(tf))
+			}
+
+			if !tf[0].CreatedAt.Equal(tc.createdAt) {
+				t.Errorf("wrong createdAt time, want: %v got: %v", tc.createdAt, tf[0].CreatedAt)
+			}
+		})
+	}
+}
+
+func TestStillValidKeyAllowsOtherKeys(t *testing.T) {
+	batchTime := time.Date(2020, 3, 1, 10, 43, 1, 0, time.UTC)
+	currentInterval := IntervalNumber(batchTime)
+
+	transformer, err := NewTransformer(10, 2*24*time.Hour, time.Minute, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	source := &verifyapi.Publish{
+		Keys: []verifyapi.ExposureKey{
+			{
+				Key:              encodeKey(generateKey(t)),
+				IntervalNumber:   currentInterval - 2,
+				IntervalCount:    1,
+				TransmissionRisk: 1,
+			},
+			{
+				Key:              encodeKey(generateKey(t)),
+				IntervalNumber:   currentInterval - 1,
+				IntervalCount:    verifyapi.MaxIntervalCount,
+				TransmissionRisk: 1,
+			},
+		},
+		Regions:        []string{"US"},
+		AppPackageName: "com.google",
+	}
+
+	got, err := transformPublish(transformer, source, batchTime)
+	if err != nil {
+		t.Fatalf("TransformPublish returned unexpected error: %v", err)
+	}
+	if len(got) != 2 {
+		t.Fatalf("wrong number of keys, want: 2 got: %v", len(got))
+	}
+
+	// The expired key is sent immediately with the normal batch createdAt.
+	batchWindow := TruncateWindow(batchTime, time.Minute)
+	if !got[0].CreatedAt.Equal(batchWindow) {
+		t.Errorf("expired key createdAt, want: %v got: %v", batchWindow, got[0].CreatedAt)
+	}
+
+	// The still-valid key is embargoed until the end of its validity window.
+	wantEmbargo := TruncateWindow(time.Unix(int64(currentInterval-1+verifyapi.MaxIntervalCount)*int64(verifyapi.IntervalLength/time.Second), 0), time.Minute)
+	if !got[1].CreatedAt.Equal(wantEmbargo) {
+		t.Errorf("still-valid key createdAt, want: %v got: %v", wantEmbargo, got[1].CreatedAt)
+	}
+}
