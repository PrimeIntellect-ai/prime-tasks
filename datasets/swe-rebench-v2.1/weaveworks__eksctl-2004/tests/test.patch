@@ -0,0 +1,71 @@
+package nodebootstrap
+
+import (
+	"encoding/base64"
+	"strings"
+
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+
+	api "github.com/weaveworks/eksctl/pkg/apis/eksctl.io/v1alpha5"
+)
+
+var _ = Describe("Windows", func() {
+	var (
+		clusterConfig *api.ClusterConfig
+		ng            *api.NodeGroup
+	)
+
+	BeforeEach(func() {
+		clusterConfig = api.NewClusterConfig()
+		clusterConfig.Status = &api.ClusterStatus{
+			Endpoint:                 "unit-test.example.com",
+			CertificateAuthorityData: []byte(`CertificateAuthorityData`),
+		}
+		clusterConfig.Metadata = &api.ClusterMeta{
+			Name: "unit-test",
+		}
+		ng = &api.NodeGroup{
+			AMIFamily: api.NodeImageFamilyWindowsServer2019CoreContainer,
+		}
+	})
+
+	Describe("with a single pre-bootstrap command", func() {
+		It("includes it before bootstrapping the Windows instance", func() {
+			command := "wget -UseBasicParsing -O amazon-cloudwatch-agent.msi https://s3.amazonaws.com/amazoncloudwatch-agent/windows/amd64/latest/amazon-cloudwatch-agent.msi"
+			ng.PreBootstrapCommands = []string{command}
+
+			userdata, err := NewUserData(clusterConfig, ng)
+			Expect(err).ToNot(HaveOccurred())
+			expectCommandsBeforeWindowsBootstrap(userdata, command)
+		})
+	})
+
+	Describe("with multiple pre-bootstrap commands", func() {
+		It("includes each command before bootstrapping the Windows instance", func() {
+			commands := []string{
+				"wget -UseBasicParsing -O amazon-cloudwatch-agent.msi https://s3.amazonaws.com/amazoncloudwatch-agent/windows/amd64/latest/amazon-cloudwatch-agent.msi",
+				"start /wait msiexec.exe /qb /i \"amazon-cloudwatch-agent.msi\"",
+			}
+			ng.PreBootstrapCommands = commands
+
+			userdata, err := NewUserData(clusterConfig, ng)
+			Expect(err).ToNot(HaveOccurred())
+			expectCommandsBeforeWindowsBootstrap(userdata, commands...)
+		})
+	})
+})
+
+func expectCommandsBeforeWindowsBootstrap(userdata string, commands ...string) {
+	decodedBytes, err := base64.StdEncoding.DecodeString(userdata)
+	Expect(err).ToNot(HaveOccurred())
+	decoded := string(decodedBytes)
+
+	bootstrapIndex := strings.LastIndex(decoded, "-EKSClusterName")
+	Expect(bootstrapIndex).To(BeNumerically(">", 0))
+	for _, command := range commands {
+		commandIndex := strings.Index(decoded, command)
+		Expect(commandIndex).To(BeNumerically(">=", 0), "userdata should include command %q", command)
+		Expect(commandIndex).To(BeNumerically("<", bootstrapIndex), "command %q should run before Windows bootstrap", command)
+	}
+}
