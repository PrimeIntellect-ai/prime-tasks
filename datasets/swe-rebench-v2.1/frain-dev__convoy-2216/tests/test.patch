+func TestProjectServiceCreateEndpoint_LocalhostAndLoopbackIPAccepted_Rebench(t *testing.T) {
+	projectID := "loopback-project"
+	project := &datastore.Project{
+		UID:    projectID,
+		Type:   datastore.OutgoingProject,
+		Config: &datastore.ProjectConfig{SSL: &datastore.SSLConfiguration{EnforceSecureEndpoints: false}},
+	}
+
+	for _, host := range []string{"localhost", "127.0.0.1"} {
+		t.Run(host, func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			defer ctrl.Finish()
+
+			endpointURL := "http://" + host
+			service := provideCreateEndpointService(ctrl, models.CreateEndpoint{
+				Name: "local endpoint",
+				URL:  endpointURL,
+			}, projectID)
+			service.ProjectRepo.(*mocks.MockProjectRepository).EXPECT().
+				FetchProjectByID(gomock.Any(), projectID).Return(project, nil)
+			service.EndpointRepo.(*mocks.MockEndpointRepository).EXPECT().
+				CreateEndpoint(gomock.Any(), gomock.Any(), projectID).Return(nil)
+			service.Licenser.(*mocks.MockLicenser).EXPECT().AdvancedEndpointMgmt().Return(true)
+
+			endpoint, err := service.Run(context.Background())
+			require.NoError(t, err)
+			require.Contains(t, endpoint.Url, host)
+		})
+	}
+}
