+// TestDispatcherSendsToLoopbackWithDefaultRules verifies that the default
+// dispatcher can deliver an event to a process on the local machine.
+func TestDispatcherSendsToLoopbackWithDefaultRules(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("delivered"))
+	}))
+	defer server.Close()
+
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+
+	licenser := mocks.NewMockLicenser(ctrl)
+	licenser.EXPECT().IpRules().AnyTimes().Return(false)
+
+	dispatcher, err := NewDispatcher(
+		licenser,
+		fflag.NewFFlag([]string{string(fflag.IpRules)}),
+		LoggerOption(log.NewLogger(os.Stdout)),
+	)
+	require.NoError(t, err)
+
+	response, err := dispatcher.SendRequest(
+		context.Background(), server.URL, http.MethodPost, json.RawMessage(`{"event":"local"}`),
+		"X-Signature", "test-signature", 1024, nil, "", 5*time.Second,
+	)
+	require.NoError(t, err)
+	require.Equal(t, http.StatusOK, response.StatusCode)
+	require.Equal(t, "delivered", string(response.Body))
+}
