+def _resident_memory_mb():
+    with open("/proc/self/statm", encoding="ascii") as fh:
+        resident_pages = int(fh.read().split()[1])
+    return resident_pages * os.sysconf("SC_PAGE_SIZE") / 2**20
+
+
+@pytest.mark.skipif(
+    not os.path.exists("/proc/self/statm"), reason="requires Linux /proc"
+)
+def test_read_csv_c_engine_repeated_calls_do_not_leak_memory(tmp_path):
+    # Repeated read_csv(engine="c") calls must not keep growing resident memory,
+    # including when np.nan is used in the same process.
+    values = np.ones((270, 610))
+    values[values < 0] = np.nan
+    path = tmp_path / "data.csv"
+    pd.DataFrame(np.ones((200, 300))).to_csv(path, index=False)
+
+    for _ in range(10):
+        pd.read_csv(path, engine="c")
+    before = _resident_memory_mb()
+    for _ in range(100):
+        pd.read_csv(path, engine="c")
+    growth = _resident_memory_mb() - before
+
+    assert growth < 100, f"resident memory grew by {growth:.1f} MB"
