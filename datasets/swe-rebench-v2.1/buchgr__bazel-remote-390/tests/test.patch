+// TestMetricsDurationBucketsAppliedToRequestMetrics verifies that the buckets
+// configured through endpoint_metrics_duration_buckets are actually used for
+// the request duration metrics exposed by the running server.
+func TestMetricsDurationBucketsAppliedToRequestMetrics(t *testing.T) {
+	tmpDir, err := ioutil.TempDir("", "bazel-remote-buckets")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(tmpDir)
+
+	binPath := filepath.Join(tmpDir, "bazel-remote")
+	build := exec.Command("go", "build", "-o", binPath, "github.com/buchgr/bazel-remote")
+	build.Dir = ".."
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("failed to build bazel-remote: %v\n%s", err, out)
+	}
+
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := ln.Addr().(*net.TCPAddr).Port
+	ln.Close()
+
+	cacheDir := filepath.Join(tmpDir, "cache")
+	if err := os.MkdirAll(cacheDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+
+	configPath := filepath.Join(tmpDir, "config.yaml")
+	configYAML := fmt.Sprintf(`host: 127.0.0.1
+port: %d
+grpc_port: 0
+dir: %s
+max_size: 1
+enable_endpoint_metrics: true
+endpoint_metrics_duration_buckets: [0.001, 0.002, 0.003]
+`, port, cacheDir)
+	if err := ioutil.WriteFile(configPath, []byte(configYAML), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	cmd := exec.Command(binPath, "--config_file", configPath)
+	var serverLog bytes.Buffer
+	cmd.Stdout = &serverLog
+	cmd.Stderr = &serverLog
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		cmd.Process.Kill()
+		cmd.Wait()
+	}()
+
+	baseURL := fmt.Sprintf("http://127.0.0.1:%d", port)
+	deadline := time.Now().Add(60 * time.Second)
+	ready := false
+	for time.Now().Before(deadline) {
+		resp, err := http.Get(baseURL + "/status")
+		if err == nil {
+			resp.Body.Close()
+			ready = true
+			break
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+	if !ready {
+		t.Fatalf("server did not become ready; log:\n%s", serverLog.String())
+	}
+
+	// Generate at least one request so that the request duration histogram is populated.
+	resp, err := http.Get(baseURL + "/status")
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+
+	resp, err = http.Get(baseURL + "/metrics")
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, err := ioutil.ReadAll(resp.Body)
+	resp.Body.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	metrics := string(body)
+
+	for _, le := range []string{"0.001", "0.002", "0.003"} {
+		if !hasRequestDurationBucket(metrics, le) {
+			t.Errorf("expected the request duration metrics to use the configured bucket le=%q; metrics:\n%s", le, metrics)
+		}
+	}
+	if hasRequestDurationBucket(metrics, "0.5") {
+		t.Errorf("expected the request duration metrics to use the configured buckets, but found the default bucket le=\"0.5\"")
+	}
+}
+
+func hasRequestDurationBucket(metrics, le string) bool {
+	for _, line := range strings.Split(metrics, "\n") {
+		if strings.HasPrefix(line, "http_request_duration_seconds_bucket") && strings.Contains(line, `le="`+le+`"`) {
+			return true
+		}
+	}
+	return false
+}
+
+// setMetricsDurationBuckets sets the MetricsDurationBuckets field of c when the
+// field exists. It is a no-op on configurations that do not expose the field.
+func setMetricsDurationBuckets(c *Config, buckets []float64) {
+	v := reflect.ValueOf(c).Elem().FieldByName("MetricsDurationBuckets")
+	if v.IsValid() && v.CanSet() {
+		v.Set(reflect.ValueOf(buckets))
+	}
+}
+
+// checkMetricsDurationBuckets fails the test unless c exposes a
+// MetricsDurationBuckets field holding the expected buckets.
+func checkMetricsDurationBuckets(t *testing.T, c *Config, want []float64) {
+	t.Helper()
+	v := reflect.ValueOf(c).Elem().FieldByName("MetricsDurationBuckets")
+	if !v.IsValid() {
+		t.Errorf("Config does not expose a MetricsDurationBuckets field")
+		return
+	}
+	got := v.Interface().([]float64)
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("MetricsDurationBuckets = %v, want %v", got, want)
+	}
+}
