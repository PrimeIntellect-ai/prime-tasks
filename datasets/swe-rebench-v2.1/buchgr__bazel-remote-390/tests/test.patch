+func TestValidMetricsDurationBuckets(t *testing.T) {
+	yaml := `host: localhost
+port: 1234
+dir: /opt/cache-dir
+max_size: 42
+endpoint_metrics_duration_buckets: [.005, .1, 5]
+`
+	config, err := newFromYaml([]byte(yaml))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	expectedConfig := &Config{
+		Host:             "localhost",
+		Port:             1234,
+		Dir:              "/opt/cache-dir",
+		MaxSize:          42,
+		NumUploaders:     100,
+		MaxQueuedUploads: 1000000,
+	}
+	setMetricsDurationBuckets(expectedConfig, []float64{0.005, 0.1, 5})
+	checkMetricsDurationBuckets(t, config, []float64{0.005, 0.1, 5})
+
+	if !cmp.Equal(config, expectedConfig) {
+		t.Fatalf("Expected '%+v' but got '%+v'", expectedConfig, config)
+	}
+}
+
+func TestMetricsDurationBucketsNoDupliates(t *testing.T) {
+	configPath := filepath.Join(t.TempDir(), "config.yaml")
+	configYAML := `host: localhost
+port: 8080
+dir: /opt/cache-dir
+max_size: 42
+endpoint_metrics_duration_buckets: [1, 2, 3, 3]
+`
+	if err := ioutil.WriteFile(configPath, []byte(configYAML), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	_, err := NewFromYamlFile(configPath)
+	if err == nil {
+		t.Fatal("expected duplicate endpoint_metrics_duration_buckets to be rejected during configuration loading")
+	}
+	if !strings.Contains(err.Error(), "'endpoint_metrics_duration_buckets'") {
+		t.Fatalf("expected the error to mention 'endpoint_metrics_duration_buckets', got: %v", err)
+	}
+}
