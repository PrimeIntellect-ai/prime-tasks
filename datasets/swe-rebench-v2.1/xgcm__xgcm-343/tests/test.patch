--- a/xgcm/test/test_grid.py
+++ b/xgcm/test/test_grid.py
@@ -782,3 +782,79 @@ def test_boundary_kwarg_same_as_grid_constructor_kwarg():
     actual2 = grid2.interp(ds.data_g, ("X", "Y"))
 
     xr.testing.assert_identical(actual1, actual2)
+
+
+@pytest.mark.parametrize(
+    "metric_axes,metric_name",
+    [("X", "dx_t"), ("Y", "dy_ne"), (["Y", "X"], "dy_n")],
+)
+def test_interp_like(metric_axes, metric_name):
+
+    ds, coords, _ = datasets_grid_metric("C")
+    grid = Grid(ds, coords=coords)
+    interp_metric = grid.interp_like(ds[metric_name], ds.u)
+    test_metric = grid.interp(ds[metric_name], metric_axes)
+
+    xr.testing.assert_allclose(interp_metric, test_metric)
+
+
+@pytest.mark.parametrize(
+    "var_name,like_name,var_axes",
+    [
+        ("tracer", "u", "X"),
+    ],
+)
+def test_interp_like_var(var_name, like_name, var_axes):
+
+    ds, coords, metrics = datasets_grid_metric("C")
+    grid = Grid(ds, coords=coords, metrics=metrics)
+    interp_var = grid.interp_like(ds[var_name], ds[like_name])
+    test_var = grid.interp(ds[var_name], var_axes)
+
+    xr.testing.assert_allclose(interp_var, test_var)
+
+
+def test_interp_like_with_source_only_axes():
+    ds, coords, _ = datasets_grid_metric("C")
+    grid = Grid(ds, coords=coords)
+
+    source = ds.tracer
+    like = ds.u.isel(yt=0, time=0, zt=0, drop=True)
+
+    actual = grid.interp_like(source, like)
+    expected = grid.interp(source, "X")
+
+    xr.testing.assert_allclose(actual, expected)
+
+
+def test_interp_like_skips_axes_only_in_target():
+    ds = xr.Dataset(
+        {
+            "source": (("x",), [1.0, 2.0]),
+            "like": (("x", "z"), [[0.0, 1.0], [2.0, 3.0]]),
+        },
+        coords={"x": [0, 1], "z": [0, 1]},
+    )
+    grid = Grid(
+        ds,
+        coords={"X": {"center": "x"}, "TARGET_ONLY": {"center": "z"}},
+    )
+
+    actual = grid.interp_like(ds.source, ds.like)
+
+    xr.testing.assert_identical(actual, ds.source)
+
+
+def test_interp_like_preserves_matching_axis_position():
+    ds = xr.Dataset(
+        {
+            "source": (("xc",), [1.0, 2.0, 3.0]),
+            "like": (("xc",), [4.0, 5.0, 6.0]),
+        },
+        coords={"xc": [0, 1, 2], "xl": [0.5, 1.5]},
+    )
+    grid = Grid(ds, coords={"TARGET_MATCH": {"center": "xc", "left": "xl"}})
+
+    actual = grid.interp_like(ds.source, ds.like)
+
+    xr.testing.assert_identical(actual, ds.source)
