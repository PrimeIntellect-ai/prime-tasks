+import * as inspectorExtensionManager from '@/components/InspectorExtensionManager';
+
+// The registration function may be exposed as the default export or as a named export.
+const registerInspectorExtension = inspectorExtensionManager.default
+  || inspectorExtensionManager.registerInspectorExtension;
+
+describe('Inspector Extension Manager', function() {
+  let node;
+  let config;
+
+  beforeEach(() => {
+    node = {
+      inspectorConfig: [{
+        items: [
+          {
+            id: 1,
+          },
+          {
+            id: 2,
+          },
+        ],
+      }],
+    };
+    config = {
+      id: 5,
+      container: true,
+      name: 'advanced',
+    };
+  });
+
+  it('should always sort the advanced accordion to the end when the config is a container', function() {
+    registerInspectorExtension(node, config);
+
+    const items = node.inspectorConfig[0].items;
+    const lastItem = items[items.length - 1];
+    expect(lastItem.id).toBe(config.id);
+    expect(lastItem.name).toBe('advanced');
+  });
+
+  it('should always sort the advanced accordion to the end when the config is not a container', function() {
+    delete config.container;
+    const items = node.inspectorConfig[0].items;
+    node.inspectorConfig[0].items = [{ items }];
+
+    registerInspectorExtension(node, config);
+
+    const innerItems = node.inspectorConfig[0].items[0].items;
+    const lastItem = innerItems[innerItems.length - 1];
+    expect(lastItem.id).toBe(config.id);
+    expect(lastItem.name).toBe('advanced');
+  });
+
+  it('should update items that have the same id', function() {
+    config.id = 1;
+
+    registerInspectorExtension(node, config);
+
+    const items = node.inspectorConfig[0].items;
+    expect(items.length).toBe(2);
+    expect(items.map(item => item.id).sort()).toEqual([1, 2]);
+    const lastItem = items[items.length - 1];
+    expect(lastItem.id).toBe(1);
+    expect(lastItem.name).toBe('advanced');
+  });
+
+  it('should only move advanced types to the end', function() {
+    const secondConfig = {
+      id: 6,
+      name: 'Not advanced',
+      container: true,
+    };
+
+    registerInspectorExtension(node, config);
+    registerInspectorExtension(node, secondConfig);
+
+    const items = node.inspectorConfig[0].items;
+    const lastItem = items[items.length - 1];
+    expect(lastItem.name).toBe('advanced');
+    expect(lastItem.id).toBe(config.id);
+  });
+
+  it('should not return a value', function() {
+    expect(registerInspectorExtension(node, config)).toBeUndefined();
+  });
+});
