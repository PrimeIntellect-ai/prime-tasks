+using System.Reflection;
+
 namespace Spectre.Console.Tests.Unit;
 
 public sealed class ListPromptStateTests
 {
-    private ListPromptState<string> CreateListPromptState(int count, int pageSize, bool shouldWrap, bool searchEnabled)
-        => new(Enumerable.Range(0, count).Select(i => new ListPromptItem<string>(i.ToString())).ToList(), pageSize, shouldWrap, SelectionMode.Independent, true, searchEnabled);
+    private static ListPromptState<string> CreateListPromptState(int count, int pageSize, bool shouldWrap, bool searchEnabled)
+    {
+        var items = Enumerable.Range(0, count).Select(i => new ListPromptItem<string>(i.ToString())).ToList();
+
+        // The converter parameter was added to ListPromptState<T> as part of the
+        // "search on converted value" change. Resolve the constructor at runtime so
+        // this test compiles against both the old and the new signature.
+        var constructor = typeof(ListPromptState<string>)
+            .GetConstructors(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)
+            .OrderByDescending(c => c.GetParameters().Length)
+            .First();
+
+        var arguments = constructor
+            .GetParameters()
+            .Select(parameter => ResolveArgument(parameter, items, pageSize, shouldWrap, searchEnabled))
+            .ToArray();
+
+        return (ListPromptState<string>)constructor.Invoke(arguments);
+    }
+
+    private static object ResolveArgument(
+        ParameterInfo parameter,
+        IReadOnlyList<ListPromptItem<string>> items,
+        int pageSize,
+        bool shouldWrap,
+        bool searchEnabled)
+    {
+        if (parameter.ParameterType == typeof(IReadOnlyList<ListPromptItem<string>>))
+        {
+            return items;
+        }
+
+        if (parameter.ParameterType == typeof(Func<string, string>))
+        {
+            return (Func<string, string>)(text => text);
+        }
+
+        if (parameter.ParameterType == typeof(Func<ListPromptItem<string>, string>))
+        {
+            return (Func<ListPromptItem<string>, string>)(item => item.Data);
+        }
+
+        if (parameter.ParameterType == typeof(int))
+        {
+            return pageSize;
+        }
+
+        if (parameter.ParameterType == typeof(SelectionMode))
+        {
+            return SelectionMode.Independent;
+        }
+
+        if (parameter.ParameterType == typeof(bool))
+        {
+            return parameter.Name switch
+            {
+                "wrapAround" => shouldWrap,
+                "searchEnabled" => searchEnabled,
+                _ => true,
+            };
+        }
+
+        throw new InvalidOperationException($"Unexpected constructor parameter '{parameter.Name}'.");
+    }
 
