+
+// See: https://github.com/JelteF/derive_more/issues/363
+mod type_variables_optional_box_regression {
+    mod our_alloc {
+        #[cfg(not(feature = "std"))]
+        pub use alloc::{boxed::Box, format, vec::Vec};
+        #[cfg(feature = "std")]
+        pub use std::{boxed::Box, format, vec::Vec};
+    }
+
+    use our_alloc::{format, Box};
+
+    // We want `Vec` in scope to test that code generation works if it is there.
+    #[allow(unused_imports)]
+    use our_alloc::Vec;
+
+    use derive_more::Display;
+
+    #[derive(Display, Debug)]
+    #[display("{inner:?}")]
+    #[display(bounds(T: Display))]
+    struct OptionalBox<T> {
+        inner: Option<Box<T>>,
+    }
+
+    #[derive(Display, Debug)]
+    #[display("{next}")]
+    struct ItemStruct {
+        next: OptionalBox<ItemStruct>,
+    }
+
+    #[derive(Display)]
+    #[derive(Debug)]
+    struct ItemTuple(OptionalBox<ItemTuple>);
+
+    #[derive(Display)]
+    #[derive(Debug)]
+    #[display("Item({_0})")]
+    struct ItemTupleContainerFmt(OptionalBox<ItemTupleContainerFmt>);
+
+    #[derive(Display, Debug)]
+    #[display("{next}")]
+    enum ItemEnumOuterFormat {
+        Variant1 {
+            next: OptionalBox<ItemEnumOuterFormat>,
+        },
+        Variant2 {
+            next: OptionalBox<i32>,
+        },
+    }
+
+    #[derive(Display, Debug)]
+    enum ItemEnumInnerFormat {
+        #[display("{next} {inner}")]
+        Node {
+            next: OptionalBox<ItemEnumInnerFormat>,
+            inner: i32,
+        },
+        #[display("{inner}")]
+        Leaf { inner: i32 },
+    }
+
+    #[derive(Display)]
+    #[derive(Debug)]
+    #[display("{next:?}, {real:?}")]
+    struct VecMeansDifferent<Vec> {
+        next: our_alloc::Vec<i32>,
+        real: Vec,
+    }
+
+    #[derive(Display)]
+    #[derive(Debug)]
+    #[display("{t:?}")]
+    struct Array<T> {
+        t: [T; 10],
+    }
+
+    mod parens {
+        #![allow(unused_parens)] // test that type is found even in parentheses
+
+        use derive_more::Display;
+
+        #[derive(Display)]
+        struct Paren<T> {
+            t: (T),
+        }
+    }
+
+    #[derive(Display)]
+    struct ParenthesizedGenericArgumentsInput<T> {
+        t: dyn Fn(T) -> i32,
+    }
+
+    #[derive(Display)]
+    struct ParenthesizedGenericArgumentsOutput<T> {
+        t: dyn Fn(i32) -> T,
+    }
+
+    #[derive(Display)]
+    struct Ptr<T> {
+        t: *const T,
+    }
+
+    #[derive(Display)]
+    struct Reference<'a, T> {
+        t: &'a T,
+    }
+
+    #[derive(Display)]
+    struct Slice<'a, T> {
+        t: &'a [T],
+    }
+
+    #[derive(Display)]
+    struct BareFn<T> {
+        t: Box<fn(T) -> T>,
+    }
+
+    #[derive(Display)]
+    struct Tuple<T> {
+        t: Box<(T, T)>,
+    }
+
+    trait MyTrait<T> {}
+
+    #[derive(Display)]
+    struct TraitObject<T> {
+        t: Box<dyn MyTrait<T>>,
+    }
+
+    #[test]
+    fn assert() {
+        assert_eq!(
+            format!(
+                "{}",
+                ItemStruct {
+                    next: OptionalBox {
+                        inner: Some(Box::new(ItemStruct {
+                            next: OptionalBox { inner: None },
+                        })),
+                    },
+                },
+            ),
+            "Some(ItemStruct { next: OptionalBox { inner: None } })",
+        );
+
+        assert_eq!(
+            format!(
+                "{}",
+                ItemTuple(OptionalBox {
+                    inner: Some(Box::new(ItemTuple(OptionalBox { inner: None }))),
+                }),
+            ),
+            "Some(ItemTuple(OptionalBox { inner: None }))",
+        );
+
+        assert_eq!(
+            format!(
+                "{}",
+                ItemTupleContainerFmt(OptionalBox {
+                    inner: Some(Box::new(ItemTupleContainerFmt(OptionalBox {
+                        inner: None,
+                    }))),
+                }),
+            ),
+            "Item(Some(ItemTupleContainerFmt(OptionalBox { inner: None })))",
+        );
+
+        let item = ItemEnumOuterFormat::Variant1 {
+            next: OptionalBox {
+                inner: Some(Box::new(ItemEnumOuterFormat::Variant2 {
+                    next: OptionalBox { inner: None },
+                })),
+            },
+        };
+        assert_eq!(
+            format!("{item}"),
+            "Some(Variant2 { next: OptionalBox { inner: None } })",
+        )
+    }
+
+
+    #[derive(derive_more::Debug)]
+    struct RecursiveDebugVec {
+        children: Vec<RecursiveDebugVec>,
+    }
+
+    #[derive(derive_more::Debug)]
+    struct RecursiveDebugBox {
+        child: Option<Box<RecursiveDebugBox>>,
+    }
+
+    #[derive(derive_more::Debug)]
+    enum RecursiveDebugEnum {
+        End,
+        Next(Box<RecursiveDebugEnum>),
+    }
+
+    #[test]
+    fn recursive_debug_structs_and_enum_format() {
+        let mut children = Vec::new();
+        children.push(RecursiveDebugVec { children: Vec::new() });
+        let value = RecursiveDebugVec { children };
+        assert_eq!(
+            format!("{value:?}"),
+            "RecursiveDebugVec { children: [RecursiveDebugVec { children: [] }] }",
+        );
+
+        let value = RecursiveDebugBox {
+            child: Some(Box::new(RecursiveDebugBox { child: None })),
+        };
+        assert_eq!(
+            format!("{value:?}"),
+            "RecursiveDebugBox { child: Some(RecursiveDebugBox { child: None }) }",
+        );
+
+        assert_eq!(
+            format!("{:?}", RecursiveDebugEnum::Next(Box::new(RecursiveDebugEnum::End))),
+            "Next(End)",
+        );
+    }
+
+    struct BinaryBox<T>(Box<T>);
+
+    impl<T: core::fmt::Binary> core::fmt::Binary for BinaryBox<T> {
+        fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+            core::fmt::Binary::fmt(self.0.as_ref(), f)
+        }
+    }
+
+    #[derive(derive_more::Binary)]
+    enum RecursiveBinaryFormat {
+        #[binary("end")]
+        End,
+        #[binary("branch({_0:b})")]
+        Branch(BinaryBox<RecursiveBinaryFormat>),
+    }
+
+    #[test]
+    fn recursive_binary_derive_uses_declared_format() {
+        let value = RecursiveBinaryFormat::Branch(BinaryBox(Box::new(
+            RecursiveBinaryFormat::End,
+        )));
+        assert_eq!(format!("{value:b}"), "branch(end)");
+    }
+
+    #[derive(Display, derive_more::Debug)]
+    enum RecursiveDisplayTuple {
+        #[display("end")]
+        End,
+        #[display("branch({_0})")]
+        Branch(OptionalBox<RecursiveDisplayTuple>),
+    }
+
+    #[test]
+    fn recursive_enum_display_uses_declared_format() {
+        let value = RecursiveDisplayTuple::Branch(OptionalBox {
+            inner: Some(Box::new(RecursiveDisplayTuple::End)),
+        });
+        assert_eq!(format!("{value}"), "branch(Some(End))");
+    }
+
+    #[derive(Display, derive_more::Debug)]
+    #[display("item({child})")]
+    struct RecursiveGenericlessItem {
+        child: OptionalBox<RecursiveDisplayContainer<Self>>,
+    }
+
+    #[derive(Display, derive_more::Debug)]
+    #[display("container({child})")]
+    struct RecursiveDisplayContainer<T> {
+        child: OptionalBox<RecursiveGenericlessItem>,
+        marker: core::marker::PhantomData<T>,
+    }
+
+    struct NotDisplay;
+
+    #[derive(Display)]
+    #[display("{value}")]
+    struct GenericDisplayWithoutIgnoredBound<T> {
+        value: T,
+        ignored: NotDisplay,
+    }
+
+    #[test]
+    fn generic_display_ignores_bounds_for_non_parameter_field_types() {
+        let generic = GenericDisplayWithoutIgnoredBound {
+            value: 7,
+            ignored: NotDisplay,
+        };
+        assert_eq!(format!("{generic}"), "7");
+
+        let item = RecursiveGenericlessItem {
+            child: OptionalBox { inner: None },
+        };
+        assert_eq!(format!("{item}"), "item(None)");
+
+        let container = RecursiveDisplayContainer::<()> {
+            child: OptionalBox { inner: None },
+            marker: core::marker::PhantomData,
+        };
+        assert_eq!(format!("{container}"), "container(None)");
+    }
+}
