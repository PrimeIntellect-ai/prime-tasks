+        @Parameter(description = "the stars")
+        @RequestParam
+        @Size(min = 2, max = 2)
+        stars: List<@Max(12) @Min(1) Int>
+    ): ResponseEntity<String> {
+        return ResponseEntity.ok("ok")
+    }
