+
+test('#1796', async () => {
+  const i18n = createI18n({
+    locale: 'en',
+    messages: {
+      en: {
+        hello: 'hello world',
+        'message-with-placeholder-using-hyphens':
+          'My message with {placeholder-hyphens}.'
+      }
+    }
+  })
+  expect(
+    i18n.global.t('message-with-placeholder-using-hyphens', {
+      'placeholder-hyphens': i18n.global.t('hello')
+    })
+  ).toEqual('My message with hello world.')
+})
+
+test('#1796: i18n-t with hyphenated placeholder', async () => {
+  const i18n = createI18n({
+    legacy: true,
+    locale: 'en',
+    messages: {
+      en: {
+        hello: 'hello world',
+        'message-with-placeholder-using-hyphens':
+          'My message with {placeholder-hyphens}.'
+      }
+    }
+  })
+
+  const App = defineComponent({
+    template: `<i18n-t keypath="message-with-placeholder-using-hyphens" tag="p">
+      <template #placeholder-hyphens>
+        <strong>{{ $t("hello") }}</strong>
+      </template>
+    </i18n-t>`
+  })
+
+  const wrapper = await mount(App, i18n)
+
+  expect(wrapper.html()).toEqual(
+    `<p>My message with <strong>hello world</strong>.</p>`
+  )
+})
