+#[test]
+fn plugin_main_executable_requires_single_executable_named_after_plugin() {
+    use fuelup::component::Plugin;
+
+    let plugin = |name: &str, executables: &[&str]| Plugin {
+        name: name.to_string(),
+        executables: executables.iter().map(|e| e.to_string()).collect(),
+    };
+
+    // Exactly one executable whose name matches the plugin name.
+    assert!(plugin("forc-fmt", &["forc-fmt"]).is_main_executable());
+    assert!(plugin("forc-client", &["forc-client"]).is_main_executable());
+    assert!(plugin("some-other-plugin", &["some-other-plugin"]).is_main_executable());
+
+    // Exactly one executable whose name differs from the plugin name.
+    assert!(!plugin("forc-client", &["forc-run"]).is_main_executable());
+    assert!(!plugin("forc-edit", &["forc-fmt"]).is_main_executable());
+
+    // Several executables, even when one of them matches the plugin name.
+    assert!(!plugin(
+        "forc-client",
+        &["forc-client", "forc-run", "forc-deploy"]
+    )
+    .is_main_executable());
+    assert!(!plugin("forc-edit", &["forc-edit", "forc-x"]).is_main_executable());
+    assert!(!plugin("forc-edit", &["forc-x", "forc-y"]).is_main_executable());
+
+    // No executables at all.
+    assert!(!plugin("forc-fmt", &[]).is_main_executable());
+}
