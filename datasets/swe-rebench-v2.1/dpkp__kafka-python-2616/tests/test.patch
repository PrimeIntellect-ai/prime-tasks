+
+
+def test_sender_waits_after_delivery_timeout(sender, accumulator, mocker):
+    accumulator.config['delivery_timeout_ms'] = 50
+    future, _, _ = accumulator.append(
+        TopicPartition('foo', 0), 0, b'key', b'value', [], now=time.time())
+
+    def poll_and_wait(timeout_ms=None, **kwargs):
+        if timeout_ms is not None and timeout_ms > 0:
+            time.sleep(min(timeout_ms / 1000.0, 0.01))
+
+    mocker.patch.object(sender._client, 'poll', side_effect=poll_and_wait)
+    wall_start = time.monotonic()
+    cpu_start = time.process_time()
+    sender.start()
+    try:
+        time.sleep(0.15)
+        cpu_elapsed = time.process_time() - cpu_start
+        wall_elapsed = time.monotonic() - wall_start
+    finally:
+        sender.initiate_close()
+        sender.join(timeout=1)
+
+    assert not sender.is_alive()
+    assert future.is_done
+    # A wait between polls may be short, but the sender should not consume
+    # most of a CPU while idle after the batch expires.
+    assert cpu_elapsed < wall_elapsed * 0.5
