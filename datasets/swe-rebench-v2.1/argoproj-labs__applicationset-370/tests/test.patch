+// assertPersistedErrorReported checks, through the stored ApplicationSet, that some status
+// condition carries a message containing the expected error text.
+func assertPersistedErrorReported(t *testing.T, c crtclient.Client, namespace, name, expectedText string) {
+	t.Helper()
+	var persistedSet argoprojiov1alpha1.ApplicationSet
+	err := c.Get(context.Background(), crtclient.ObjectKey{Namespace: namespace, Name: name}, &persistedSet)
+	assert.NoError(t, err)
+	statusJSON, err := json.Marshal(persistedSet.Status)
+	assert.NoError(t, err)
+	var persistedStatus struct {
+		Conditions []struct {
+			Message string `json:"message"`
+		} `json:"conditions"`
+	}
+	assert.NoError(t, json.Unmarshal(statusJSON, &persistedStatus))
+	found := false
+	for _, condition := range persistedStatus.Conditions {
+		if strings.Contains(condition.Message, expectedText) {
+			found = true
+			break
+		}
+	}
+	assert.True(t, found, "expected persisted ApplicationSet status to report the error containing %q", expectedText)
+}
+
+func TestReconcilerRecordsInvalidApplicationErrorInStatus(t *testing.T) {
+	scheme := runtime.NewScheme()
+	assert.NoError(t, argoprojiov1alpha1.AddToScheme(scheme))
+	assert.NoError(t, argov1alpha1.AddToScheme(scheme))
+
+	// The Application references a project that does not exist, so it is invalid.
+	appSet := argoprojiov1alpha1.ApplicationSet{
+		ObjectMeta: metav1.ObjectMeta{Name: "name", Namespace: "argocd"},
+		Spec: argoprojiov1alpha1.ApplicationSetSpec{
+			Generators: []argoprojiov1alpha1.ApplicationSetGenerator{
+				{List: &argoprojiov1alpha1.ListGenerator{
+					Elements: []apiextensionsv1.JSON{{
+						Raw: []byte(`{"cluster": "good-cluster","url": "https://good-cluster"}`),
+					}},
+				}},
+			},
+			Template: argoprojiov1alpha1.ApplicationSetTemplate{
+				ApplicationSetTemplateMeta: argoprojiov1alpha1.ApplicationSetTemplateMeta{
+					Name:      "{{cluster}}",
+					Namespace: "argocd",
+				},
+				Spec: argov1alpha1.ApplicationSpec{
+					Source:      argov1alpha1.ApplicationSource{RepoURL: "https://github.com/argoproj/argocd-example-apps", Path: "guestbook"},
+					Project:     "missing-project",
+					Destination: argov1alpha1.ApplicationDestination{Server: "https://good-cluster"},
+				},
+			},
+		},
+	}
+
+	client := fake.NewClientBuilder().WithScheme(scheme).WithObjects(&appSet).Build()
+	r := ApplicationSetReconciler{
+		Log:      ctrl.Log.WithName("controllers").WithName("ApplicationSet"),
+		Client:   client,
+		Scheme:   scheme,
+		Renderer: &utils.Render{},
+		Recorder: record.NewFakeRecorder(1),
+		Generators: map[string]generators.Generator{
+			"List": generators.NewListGenerator(),
+		},
+		ArgoDB:           &dbmocks.ArgoDB{},
+		ArgoAppClientset: appclientset.NewSimpleClientset(),
+		KubeClientset:    kubefake.NewSimpleClientset(),
+		Policy:           &utils.SyncPolicy{},
+	}
+
+	req := ctrl.Request{NamespacedName: types.NamespacedName{Namespace: "argocd", Name: "name"}}
+	_, _ = r.Reconcile(context.Background(), req)
+
+	assertPersistedErrorReported(t, r.Client, "argocd", "name", "missing-project")
