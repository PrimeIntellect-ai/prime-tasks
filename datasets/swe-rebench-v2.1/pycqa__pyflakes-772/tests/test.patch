+
+    def test_defined_in_different_branches(self):
+        self.flakes('''
+            def f(x):
+                match x:
+                    case 1:
+                        def y(): pass
+                    case _:
+                        def y(): print(1)
+                return y
+        ''')
+
+    def test_defined_in_different_if_branches(self):
+        self.flakes('''
+            def no_redef(value):
+                if value:
+                    def fun(x, y):
+                        return x
+                else:
+                    def fun(x, y):
+                        return y
+                return fun
+        ''')
