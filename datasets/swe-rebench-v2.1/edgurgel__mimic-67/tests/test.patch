diff --git a/test/mimic_test.exs b/test/mimic_test.exs
index cdde541..1cecb0b 100644
--- a/test/mimic_test.exs
+++ b/test/mimic_test.exs
@@ -945,4 +945,21 @@ defmodule Mimic.Test do
       assert_receive {:add, 1, 2}
     end
   end
+
+  describe "struct values" do
+    setup :set_mimic_private
+
+    test "expecting a struct-returning function and asserting on struct values" do
+      Mimic.copy(Structs)
+
+      expect(Structs, :foo, 2, fn -> %Structs{foo: 1} end)
+
+      assert Structs.foo() == %Structs{foo: 1}
+      assert %Structs{foo: 1, bar: nil} = Structs.foo()
+      assert struct(Structs, foo: 3) == %Structs{foo: 3}
+
+      fields = Structs.__info__(:struct) |> Enum.map(& &1.field) |> Enum.sort()
+      assert fields == [:bar, :foo]
+    end
+  end
 end
diff --git a/test/support/test_modules.ex b/test/support/test_modules.ex
