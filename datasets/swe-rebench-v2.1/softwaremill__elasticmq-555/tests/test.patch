+      System.getProperty("java.class.path"),
+      "org.elasticmq.server.Main"
+    ).redirectOutput(ProcessBuilder.Redirect.DISCARD).start()
+
+    try {
+      val deadline = System.nanoTime() + java.util.concurrent.TimeUnit.SECONDS.toNanos(20)
+      var queues = List.empty[String]
+      var apiReady = false
+      while (!apiReady && System.nanoTime() < deadline && process.isAlive) {
+        try {
+          queues = listQueues(port)
+          apiReady = true
+        } catch {
+          case _: java.io.IOException => Thread.sleep(100)
+        }
+      }
+
+      queues should contain("configuredByUser")
+    } finally {
+      process.destroy()
