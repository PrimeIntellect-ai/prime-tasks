+  test("custom configuration queues are available through SQS when starting the executable") {
+    val port = freePort()
+    val configFile = Files.createTempFile("elasticmq-custom-config", ".conf")
+    val config = s"""
+      include classpath("reference.conf")
+      rest-sqs.bind-port = $port
