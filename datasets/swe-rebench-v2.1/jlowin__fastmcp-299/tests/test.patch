+from mcp.types import ToolAnnotations
+
+from fastmcp import Client, FastMCP
+
+
+async def test_tool_annotations_are_exposed_to_client():
+    """Decorator-supplied titles and annotation hints reach MCP consumers."""
+    mcp = FastMCP("Test Server")
+
+    @mcp.tool(
+        annotations=ToolAnnotations(
+            title="Full Tool",
+            readOnlyHint=True,
+            destructiveHint=False,
+            idempotentHint=True,
+            openWorldHint=False,
+        )
+    )
+    def full_tool() -> str:
+        """A tool carrying annotation metadata."""
+        return "ok"
+
+    async with Client(mcp) as client:
+        tools = await client.list_tools()
+
+    tool = next(tool for tool in tools if tool.name == "full_tool")
+    annotations = tool.annotations
+    assert annotations is not None
+    assert annotations.title == "Full Tool"
+    assert annotations.readOnlyHint is True
+    assert annotations.destructiveHint is False
+    assert annotations.idempotentHint is True
+    assert annotations.openWorldHint is False
