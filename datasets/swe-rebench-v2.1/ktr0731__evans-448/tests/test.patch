+// installStructSelections supplies selections through Prompt's normal
+// selection entry point while accommodating the repository's existing
+// selection callback return shape.
+func installStructSelections(p prompt.Prompt) {
+	field := reflect.ValueOf(p).Elem().FieldByName("SelectFunc")
+	selectedListValue := false
+	selectedStringValue := false
+	digPrompts := make(map[string]bool)
+	callback := reflect.MakeFunc(field.Type(), func(args []reflect.Value) []reflect.Value {
+		options := args[1]
+		selected := ""
+		index := -1
+		message := args[0].String()
+		for i := 0; i < options.Len(); i++ {
+			if options.Index(i).String() == "dig down" {
+				if !digPrompts[message] {
+					selected, index = "dig down", i
+					digPrompts[message] = true
+				} else {
+					for j := 0; j < options.Len(); j++ {
+						option := options.Index(j).String()
+						if option == "skip" || option == "finish" {
+							selected, index = option, j
+							break
+						}
+					}
+				}
+				break
+			}
+		}
+		if index < 0 && !selectedListValue {
+			for i := 0; i < options.Len(); i++ {
+				if options.Index(i).String() == "list_value" {
+					selected, index = "list_value", i
+					selectedListValue = true
+					break
+				}
+			}
+		}
+		if index < 0 && !selectedStringValue {
+			for i := 0; i < options.Len(); i++ {
+				if options.Index(i).String() == "string_value" {
+					selected, index = "string_value", i
+					selectedStringValue = true
+					break
+				}
+			}
+		}
+		var err error
+		if index < 0 {
+			err = io.EOF
+		}
+
+		if field.Type().NumOut() == 2 {
+			result := reflect.ValueOf(selected)
+			if err != nil {
+				return []reflect.Value{result, reflect.ValueOf(err)}
+			}
+			return []reflect.Value{result, reflect.Zero(field.Type().Out(1))}
+		}
+		indexResult := reflect.Zero(field.Type().Out(0))
+		if index >= 0 {
+			indexResult = reflect.ValueOf(index)
+		}
+		textResult := reflect.ValueOf(selected)
+		if err != nil {
+			return []reflect.Value{indexResult, textResult, reflect.ValueOf(err)}
+		}
+		return []reflect.Value{indexResult, textResult, reflect.Zero(field.Type().Out(2))}
+	})
+	field.Set(callback)
+}
 
