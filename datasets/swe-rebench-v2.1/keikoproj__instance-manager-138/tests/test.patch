+func TestUpgradeCRDStrategyReplace(t *testing.T) {
+	var (
+		g   = gomega.NewGomegaWithT(t)
+		k   = MockKubernetesClientSet()
+		ig  = MockInstanceGroup()
+		cr  = MockCustomResourceSpec()
+		crd = MockCustomResourceDefinition()
+	)
+
+	crYAML, err := yaml.Marshal(cr.Object)
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+
+	definitionsGvr := kubeprovider.GetGVR(crd, "customresourcedefinitions")
+	crGvr := kubeprovider.GetGVR(cr, "dogs")
+	_, err = k.KubeDynamic.Resource(definitionsGvr).Create(crd, metav1.CreateOptions{})
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+
+	strategy := MockAwsCRDStrategy(string(crYAML))
+	strategy.CRDType.ConcurrencyPolicy = "replace"
+	ig.SetUpgradeStrategy(strategy)
+
+	status := ig.GetStatus()
+	status.SetActiveScalingGroupName("scaling-group-1")
+	status.SetActiveLaunchConfigurationName("some-launch-configuration-2")
+
+	// an active custom resource submitted for a previous launch configuration
+	existing := MockCustomResourceSpec()
+	existing.SetName("captain-1")
+	existing.SetNamespace("default")
+	kubeprovider.AddAnnotation(existing, kubeprovider.OwnershipAnnotationKey, kubeprovider.OwnershipAnnotationValue)
+	kubeprovider.AddAnnotation(existing, kubeprovider.ScopeAnnotationKey, "scaling-group-1")
+	err = unstructured.SetNestedField(existing.Object, "bla", "status", "dogStatus")
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+	_, err = k.KubeDynamic.Resource(crGvr).Namespace("default").Create(existing, metav1.CreateOptions{})
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+
+	_, err = kubeprovider.ProcessCRDStrategy(k.KubeDynamic, ig)
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+	// process again so that implementations which delete and requeue before
+	// submitting the replacement are also covered
+	_, err = kubeprovider.ProcessCRDStrategy(k.KubeDynamic, ig)
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+
+	// the custom resource for the previous launch configuration should be deleted
+	_, err = k.KubeDynamic.Resource(crGvr).Namespace("default").Get("captain-1", metav1.GetOptions{})
+	g.Expect(kerr.IsNotFound(err)).To(gomega.BeTrue())
+
+	// a new custom resource for the new launch configuration should be submitted
+	_, err = k.KubeDynamic.Resource(crGvr).Namespace("default").Get("captain-2", metav1.GetOptions{})
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+}
