+@pytest.mark.end_to_end
+def test_live_execution_displays_completed_task(tmp_path, runner):
+    tmp_path.joinpath("task_dummy.py").write_text("def task_dummy(): pass")
+
+    result = runner.invoke(cli, [tmp_path.as_posix(), "-v", "1"])
+
+    assert result.exit_code == 0
+    assert "Task" in result.output
+    assert "Outcome" in result.output
+    assert "task_dummy.py::task_dummy" in result.output
+    assert "running" not in result.output
+
+
+@pytest.mark.end_to_end
+@pytest.mark.parametrize("verbose", [1, 2])
+def test_live_execution_displays_skips_and_persists(tmp_path, runner, verbose):
+    source = """
+    import pytask
+
+    @pytask.mark.skip
+    def task_skipped():
+        pass
+
+    @pytask.mark.persist
+    @pytask.mark.depends_on("persisted-input.txt")
+    @pytask.mark.produces("persisted-output.txt")
+    def task_persisted(depends_on, produces):
+        produces.write_text(depends_on.read_text())
+    """
+    tmp_path.joinpath("task_dummy.py").write_text(textwrap.dedent(source))
+    tmp_path.joinpath("persisted-input.txt").write_text("input")
+
+    # Establish saved state, then change a dependency so the persist marker applies.
+    runner.invoke(cli, [tmp_path.as_posix(), "-v", "0"])
+    tmp_path.joinpath("persisted-input.txt").write_text("changed input")
+
+    result = runner.invoke(cli, [tmp_path.as_posix(), "-v", str(verbose)])
+
+    assert result.exit_code == 0
+    skipped_task = "task_dummy.py::task_skipped"
+    persisted_task = "task_dummy.py::task_persisted"
+    if verbose == 1:
+        assert skipped_task not in result.output
+        assert not any(
+            persisted_task in line and "│ p" in line
+            for line in result.output.splitlines()
+        )
+    else:
+        assert skipped_task in result.output
+        assert persisted_task in result.output
