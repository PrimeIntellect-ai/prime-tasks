+    def test_copy_empty_like_does_not_copy_instructions(self):
+        """Test copy_empty_like does not copy the instruction data of the original circuit."""
+
+        class _UncopyableGate(Gate):
+            def __init__(self):
+                super().__init__("uncopyable", 1, [])
+
+            def copy(self, name=None):
+                raise RuntimeError("instruction data was copied")
+
+            def __deepcopy__(self, memo):
+                raise RuntimeError("instruction data was deep-copied")
+
+        qr = QuantumRegister(1)
+        qc = QuantumCircuit(qr)
+        qc.append(_UncopyableGate(), [qr[0]])
+
+        copied = qc.copy_empty_like()
+
+        self.assertEqual(len(copied.data), 0)
