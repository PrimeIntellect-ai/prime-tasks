+def test_add_derivatives_validation(tmp_path):
+    from bids.exceptions import BIDSDerivativesValidationError
+
+    data_dir = join(get_test_data_path(), 'ds005')
+    layout = BIDSLayout(data_dir)
+    # A derivatives dataset without PipelineDescription.Name is invalid
+    bad_deriv = tmp_path / 'bad_deriv'
+    bad_deriv.mkdir()
+    (bad_deriv / 'dataset_description.json').write_text(
+        '{"Name": "bad", "BIDSVersion": "1.0.0"}')
+    with pytest.raises(BIDSDerivativesValidationError):
+        layout.add_derivatives(str(bad_deriv))
+    # Adding the same pipeline name twice is invalid
+    deriv_dir = join(data_dir, 'derivatives', 'events')
+    layout.add_derivatives(deriv_dir)
+    with pytest.raises(BIDSDerivativesValidationError):
+        layout.add_derivatives(deriv_dir)
+
