+;; CLI: --external-options column indices
+
+
+(deftest test-external-options-column-indices-via-cli
+  (testing "CSV column indices passed through --external-options are honored"
+    (let [csv-file (java.io.File/createTempFile "pip-license-checker" ".csv")]
+      (try
+        (spit csv-file
+              (str/join "\n"
+                        ["version,url,package name,license name"
+                         "0.0.1,http://example.com/test-package,test-package,BSD License"]))
+        (let [args ["--external" (.getAbsolutePath csv-file)
+                    "--external-options" "{:package-column-index 2 :license-column-index 3}"]
+              {:keys [external options]} (core/validate-args args)]
+          (is (= [{:ok? true
+                   :requirement {:name "test-package" :version nil}
+                   :license {:name "BSD License" :type "Permissive"}}]
+                 (external/get-parsed-requiements external options))))
+        (finally
+          (.delete csv-file))))))
