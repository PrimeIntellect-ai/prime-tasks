+    def test_eks_gh_155(self):
+        """test_eks_gh_155: Test EKS issue raised in GH-155"""
+        template_file_path = os.path.abspath(
+            os.path.join(
+                os.path.dirname(__file__),
+                os.path.pardir,
+                "files",
+                "eks-service-wide.yml",
+            )
+        )
+        cfg = read_yaml_file(template_file_path)
+        result = write_policy_with_template(cfg)
+        print(json.dumps(result, indent=4))
+        # The config requests all wildcard-only EKS actions at both the Write and
+        # List access levels. Both must be retained - the bug caused the later
+        # access level to overwrite the earlier one. The exact ordering and the
+        # singular/plural spelling of the Create action are incidental, so the
+        # check is case- and order-insensitive.
+        self.assertEqual(len(result["Statement"]), 1)
+        statement = result["Statement"][0]
+        self.assertEqual(statement["Effect"], "Allow")
+        self.assertEqual(statement["Resource"], ["*"])
+        actions = [action.lower() for action in statement["Action"]]
+        self.assertIn("eks:listclusters", actions)
+        self.assertTrue(
+            any(
+                action in ("eks:createcluster", "eks:createclusters")
+                for action in actions
+            ),
+            f"Expected an EKS Create action in {statement['Action']}",
+        )
 
 
