+        # The wildcard-only statement must retain both the explicitly requested
+        # single actions and the actions pulled in from the service-level
+        # requests. Ordering within the action list is incidental, so compare
+        # the actions as a set.
+        wildcard_statement = next(
+            statement
+            for statement in output["Statement"]
+            if statement["Sid"] == "MultMultNone"
+        )
+        self.assertEqual(wildcard_statement["Effect"], "Allow")
+        self.assertEqual(wildcard_statement["Resource"], ["*"])
+        self.assertEqual(
+            {action.lower() for action in wildcard_statement["Action"]},
+            {
+                "ram:enablesharingwithawsorganization",
+                "ram:getresourcepolicies",
+                "secretsmanager:createsecret",
