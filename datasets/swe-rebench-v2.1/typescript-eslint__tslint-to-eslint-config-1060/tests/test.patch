+import { convertRules } from "../../convertRules";
+import { ruleConverters } from "../../ruleConverters";
+
+describe("prefer-conditional-expression conversion", () => {
+    test("converts the configured rule and makes its plugin available", () => {
+        const { converted, missing, plugins } = convertRules(
+            { ruleConverters, ruleMergers: new Map() },
+            { "prefer-conditional-expression": { ruleArguments: [] } },
+            new Map(),
+        );
+
+        expect(missing).toHaveLength(0);
+        expect(converted.get("unicorn/prefer-ternary")).toMatchObject({
+            ruleName: "unicorn/prefer-ternary",
+        });
+        expect(plugins.has("eslint-plugin-unicorn")).toBe(true);
+    });
+});
