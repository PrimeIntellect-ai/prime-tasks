+
+    let json = p
+        .cargo("metadata -q --format-version 1 --no-deps -Zpublic-dependency")
+        .masquerade_as_nightly_cargo(&["public-dependency"])
+        .run_json();
+    let dependencies = json["packages"][0]["dependencies"].as_array().unwrap();
+    assert_eq!(dependencies.len(), 3);
+    for (name, is_public) in [("bar", false), ("baz", false), ("foobar", true)] {
+        let dependency = dependencies
+            .iter()
+            .find(|dependency| dependency["name"].as_str() == Some(name))
+            .unwrap();
+        assert_eq!(dependency["public"], json!(is_public));
+    }
+}
