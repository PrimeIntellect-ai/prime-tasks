+def test_grib_grib_metadata_valid_datetime():
+    ds = from_source("file", earthkit_test_data_file("t_time_series.grib"))
+    md = ds[4].metadata()
+
+    expected = datetime.datetime(2020, 12, 21, 18)
+    assert md["valid_datetime"] == expected
