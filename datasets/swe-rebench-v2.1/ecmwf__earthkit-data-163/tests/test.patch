+def test_virtual_grib_metadata_get():
+    ds = from_source(
+        "list-of-dicts",
+        [
+            {
+                "shortName": "t",
+                "paramId": 167,
+                "levelist": 500,
+                "dataDate": 20180801,
+                "dataTime": 1200,
+                "endStep": 6,
+                "values": [1, 2, 3],
+            }
+        ],
+    )
+    f = ds[0]
+    md = f.metadata()
+
+    expected_valid_datetime = datetime.datetime(2018, 8, 1, 18)
+    assert md["valid_datetime"] == expected_valid_datetime
+    assert md.get("valid_datetime", "missing") == expected_valid_datetime
+
+    # key aliases
+    assert md["param"] == "t"
+    assert md["_param_id"] == 167
+
+    # key groups
+    assert md["level"] == 500
+    assert md["date"] == 20180801
+    assert md["time"] == 1200
+    assert md["step"] == 6
+
+    # type suffixes
+    assert md["step:l"] == 6
+    assert md["step:s"] == "6"
+    assert md["step:d"] == 6.0
+
+    # conversion
+    assert f.metadata("step", astype=str) == "6"
+
+    # default and raise_on_missing
+    assert md.get("nonExistentKey") is None
+    assert md.get("nonExistentKey", 42) == 42
+    assert f.metadata("nonExistentKey", default=42) == 42
+    with pytest.raises(KeyError):
+        md["nonExistentKey"]
+
+
