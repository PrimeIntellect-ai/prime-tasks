--- a/tests/config/test_rule_matcher.py
+++ b/tests/config/test_rule_matcher.py
@@ -94,3 +94,18 @@ class TestIncludingExcluding:
         msg = get_message_with_id("0101")
         assert rule_matcher.is_rule_disabled(msg)
         assert not rule_matcher.is_rule_enabled(msg)
+
+    def test_select_all(self):
+        linter_config = LinterConfig(select=["ALL", "0101"], ignore=["0103"])
+        assert linter_config.load_configuration() is None
+        rule_matcher = RuleMatcher(linter_config)
+        assert rule_matcher.is_rule_enabled(get_message_with_id("0101"))
+        assert rule_matcher.is_rule_enabled(get_message_with_id("0102"))
+        assert not rule_matcher.is_rule_enabled(get_message_with_id("0103"))
+
+    def test_additional_kwargs_are_passed_through(self):
+        linter_config = LinterConfig(select=["0101"], threshold=RuleSeverity.ERROR)
+        linter_config.load_configuration()
+        rule_matcher = RuleMatcher(linter_config)
+        # CustomRule severity is WARNING, which is below the ERROR threshold, so it must be disabled.
+        assert not rule_matcher.is_rule_enabled(get_message_with_id("0101"))
