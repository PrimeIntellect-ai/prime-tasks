+  test('meta queries accept nested and indexed field paths', async () => {
+    let form!: FormContext<any>;
+    mountWithHoc({
+      setup() {
+        form = useForm({
+          initialValues: { nested: { name: 'initial' }, users: [{ name: 'initial' }] },
+        });
+        useField('nested.name');
+        useField('users[0].name');
+        return {};
+      },
+      template: `<div></div>`,
+    });
+
+    await flushPromises();
+    for (const path of ['nested.name', 'users[0].name']) {
+      expect(typeof form.isFieldTouched(path)).toBe('boolean');
+      expect(typeof form.isFieldDirty(path)).toBe('boolean');
+      expect(typeof form.isFieldValid(path)).toBe('boolean');
+      expect(form.isFieldTouched(path)).toBe(false);
+      expect(form.isFieldDirty(path)).toBe(false);
+      expect(form.isFieldValid(path)).toBe(true);
+    }
+
+    form.setFieldTouched('nested.name', true);
+    form.setFieldTouched('users[0].name', true);
+    form.setFieldValue('nested.name', 'changed');
+    form.setFieldValue('users[0].name', 'changed');
+    await flushPromises();
+
+    for (const path of ['nested.name', 'users[0].name']) {
+      expect(form.isFieldTouched(path)).toBe(true);
+      expect(form.isFieldDirty(path)).toBe(true);
+    }
+  });
+
