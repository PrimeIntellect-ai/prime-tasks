+var _ = Describe("AdditionalEncryptedVolume", func() {
+	It("should not allow users to set AdditionalEncryptedVolume in ClusterConfig", func() {
+		config := `
+apiVersion: eksctl.io/v1alpha5
+kind: ClusterConfig
+
+metadata:
+  name: cluster
+  region: us-west-2
+
+nodeGroups:
+- name: test
+  AdditionalEncryptedVolume: "this-will-break-nodegroup-creation"
+`
+		f, err := ioutil.TempFile("", "eksctl-*.yaml")
+		Expect(err).ToNot(HaveOccurred())
+		defer os.Remove(f.Name())
+		_, err = f.WriteString(config)
+		Expect(err).ToNot(HaveOccurred())
+		Expect(f.Close()).To(Succeed())
+
+		Expect(api.Register()).To(Succeed())
+		cfg, err := eksapi.LoadConfigFromFile(f.Name())
+		if err == nil {
+			Expect(cfg.NodeGroups).To(HaveLen(1))
+			loadedConfig, err := json.Marshal(cfg)
+			Expect(err).NotTo(HaveOccurred())
+			Expect(string(loadedConfig)).NotTo(ContainSubstring("this-will-break-nodegroup-creation"))
+		}
+	})
+})
