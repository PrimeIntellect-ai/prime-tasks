+    def test_422_html_response(self):
+        # https://github.com/brettcannon/gidgethub/issues/81
+        status_code = 422
+        body = "<html><body>Mistakes were made ...</body></html>"
+        encoded_body = body.encode("utf-8")
+        headers = {"content-type": "text/html; charset=utf-8"}
+        with pytest.raises(HTTPException) as exc_info:
+            sansio.decipher_response(status_code, headers, encoded_body)
+        error = exc_info.value
+        assert error.status_code == http.HTTPStatus(status_code)
+        diagnostic_text = [str(error)]
+        diagnostic_text.extend(
+            getattr(error, name)
+            for name in dir(error)
+            if not name.startswith("_")
+            and isinstance(getattr(error, name), str)
+        )
+        assert any(body in value for value in diagnostic_text)
+
