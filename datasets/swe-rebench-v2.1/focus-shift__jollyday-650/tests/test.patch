+  private void assertNoUnexpectedHolidays(HolidayManager expected, HolidayManager found, CalendarHierarchy hierarchy, List<String> region, Year year) {
+    final Set<Holiday> expectedHolidays = new HashSet<>(expected.getHolidays(year, region.toArray(String[]::new)));
+    if (region.equals(List.of("ti")) || region.equals(List.of("tg"))) {
+      expectedHolidays.add(new Holiday(LocalDate.of(year.getValue(), MAY, 1), "LABOUR_DAY", OBSERVANCE));
+    }
+    assertThat(expectedHolidays).describedAs(hierarchy.getDescription())
+      .containsAll(found.getHolidays(year, region.toArray(String[]::new)));
+
+    for (String id : hierarchy.getChildren().keySet()) {
+      final List<String> childRegion = new ArrayList<>(region);
+      childRegion.add(id);
+      assertNoUnexpectedHolidays(expected, found, hierarchy.getChildren().get(id), childRegion, year);
+    }
+  }
