new file mode 100644
index 0000000..39219a4
--- /dev/null
+++ b/tests/v2-test/svelte/issue-76/absolute.test.ts
@@ -0,0 +1,24 @@
+import { baseOptions } from 'test-settings';
+import { describe, expect, test } from 'vitest';
+import { format } from 'prettier';
+
+import { thisPlugin } from '../../adaptor';
+import { fixtures } from './fixtures';
+
+const options = {
+  ...baseOptions,
+  plugins: ['prettier-plugin-svelte', thisPlugin],
+  parser: 'svelte',
+  endingPosition: 'absolute',
+};
+
+describe.each(fixtures)('$name', ({ input, options: fixtureOptions }) => {
+  const formattedText = format(input, {
+    ...options,
+    ...(fixtureOptions ?? {}),
+  });
+
+  test('the class attribute wraps with TypeScript in the script tag', () => {
+    expect(formattedText).toMatch(/class="[^"]*\n[^"]*"/s);
+  });
+});
