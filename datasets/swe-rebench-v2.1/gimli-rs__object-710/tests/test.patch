+#[test]
+fn empty_symtab() {
+    let object = write::Object::new(BinaryFormat::Elf, Architecture::X86_64, Endianness::Little);
+    let bytes = object.write().unwrap();
+
+    let object = read::File::parse(&*bytes).unwrap();
+    assert_eq!(object.format(), BinaryFormat::Elf);
+    assert_eq!(object.architecture(), Architecture::X86_64);
+
+    let elf_file = read::elf::ElfFile64::<LittleEndian>::parse(&*bytes).unwrap();
+    for section in elf_file.sections() {
+        if section.elf_section_header().sh_type(elf_file.endian()) == elf::SHT_STRTAB {
+            assert!(section.size() > 0, "ELF string-table sections must not be empty");
+        }
+    }
+}
