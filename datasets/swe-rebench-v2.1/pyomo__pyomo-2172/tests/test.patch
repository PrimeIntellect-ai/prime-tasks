@@ -30,6 +30,31 @@ from pyomo.environ import (
 )
 from pyomo.core.base.units_container import units, pint_available, UnitsError
 
+
+class TestVarData(unittest.TestCase):
+    def test_lower_bound_expression(self):
+        m = ConcreteModel()
+        m.x = Var()
+        self.assertIsNone(m.x.lower)
+        m.p = Param(mutable=True, initialize=2)
+        m.x.setlb(5 * m.p)
+        lower = m.x.lower
+        self.assertEqual(value(lower), 10)
+        m.p.set_value(3)
+        self.assertEqual(value(lower), 15)
+
+    def test_upper_bound_expression(self):
+        m = ConcreteModel()
+        m.x = Var()
+        self.assertIsNone(m.x.upper)
+        m.p = Param(mutable=True, initialize=2)
+        m.x.setub(-5 * m.p)
+        upper = m.x.upper
+        self.assertEqual(value(upper), -10)
+        m.p.set_value(3)
+        self.assertEqual(value(upper), -15)
+
+
