diff --git a/lib/WorseReflection/Tests/Inference/call-expression/invoke2.test b/lib/WorseReflection/Tests/Inference/call-expression/invoke2.test
new file mode 100644
index 00000000..be90d3e9
--- /dev/null
+++ b/lib/WorseReflection/Tests/Inference/call-expression/invoke2.test
@@ -0,0 +1,30 @@
+<?php
+
+class Foobar 
+{
+    /**
+     * @return Generator<DateTime>
+     */
+    public function __invoke(): Generator
+    {
+        yield new DateTime();
+    }
+}
+
+class Baz
+{
+    private Foobar $foo;
+
+    public function __construct(Foobar $foo) {
+        $this->foo = $foo;
+    }
+
+    public function baz(): void {
+        $f = $this->foo;
+
+        foreach (($this->foo)() as $bar) {
+            wrAssertType('DateTime', $bar);
+        }
+    }
+}
+
