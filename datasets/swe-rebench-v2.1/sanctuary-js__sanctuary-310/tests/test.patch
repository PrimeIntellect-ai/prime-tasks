@@ -0,0 +1,28 @@
+'use strict';
+
+var assert = require('assert');
+
+var S = require('..');
+
+var eq = require('./internal/eq');
+
+
+function isTypeError(err) {
+  return err instanceof TypeError;
+}
+
+test('props', function() {
+
+  eq(typeof S.props, 'function');
+
+  assert.throws(function() { S.props(1); }, isTypeError);
+
+  assert.throws(function() { S.props(['a', 'b', 'c'], null); }, isTypeError);
+
+  assert.throws(function() { S.props([true, false], {a: {b: {c: 1}}}); }, isTypeError);
+
+  eq(S.props(['a', 'b', 'c'], {a: {b: {c: 1}}}), 1);
+  eq(S.props(['a', 'b', 'c', '0'], {a: {b: {c: [2, 4, 6]}}}), 2);
+  eq(S.props(['a', 'b', 'c'], Object.create({a: {b: {c: 1}}})), 1);
+
+});
