         # representative (wrt CPython) for same binary
@@ -880,3 +889,9 @@ def test_hexadecimal_fmt():
         assert f'{x:.0a}' == '0x1p+0'
         assert f'{x:#.0a}' == '0x1.p+0'
         assert f"{mp.mpf('1.234567890123456789'):+.0a}" == '+0x1p+0'
+
+
+def test_read_format_spec_frac_separators():
+    assert read_format_spec('.9_f')['frac_separators'] == '_'
+    assert read_format_spec('.9,f')['frac_separators'] == ','
+    assert read_format_spec('.9f')['frac_separators'] == ''
