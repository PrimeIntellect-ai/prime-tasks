+describe('viewer refresh behavior', () => {
+  const refreshViewer = async () => {
+    const fetcher = (global as any).fetch as jest.Mock;
+    fetcher.mockReset();
+    fetcher
+      .mockResolvedValueOnce({
+        status: 200,
+        json: jest.fn().mockResolvedValue({ data: { viewer: null } }),
+      })
+      .mockResolvedValueOnce({
+        status: 200,
+        json: jest.fn().mockResolvedValue({
+          data: { viewer: { id: 'viewer-42' } },
+        }),
+      });
+
+    let accessToken: string | undefined;
+    const client = createClient({
+      url: 'https://viewer.example/graphql',
+      fetchOptions: () => ({
+        headers: { Authorization: accessToken ? `Bearer ${accessToken}` : '' },
+      }),
+    });
+    const viewerRequest = {
+      key: 1626,
+      query: gql`
+        query Viewer {
+          viewer {
+            id
+          }
+        }
+      `,
+    };
+
+    const accountPanelText: string[] = [];
+    let resolveInitial: () => void;
+    let resolveRefreshed: () => void;
+    const initialResult = new Promise<void>(resolve => {
+      resolveInitial = resolve;
+    });
+    const refreshedResult = new Promise<void>(resolve => {
+      resolveRefreshed = resolve;
+    });
+    let resultCount = 0;
+    const unsubscribe = pipe(
+      client.executeQuery(viewerRequest, { requestPolicy: 'cache-first' }),
+      subscribe(result => {
+        resultCount++;
+        if (result.data && result.data.viewer) {
+          accountPanelText.push(`Account: ${result.data.viewer.id}`);
+        }
+        if (resultCount === 1) resolveInitial();
+        if (resultCount > 1 && !result.stale) resolveRefreshed();
+      })
+    );
+
+    await initialResult;
+    accessToken = 'fresh-access-token';
+    const refreshedSubscription = pipe(
+      client.executeQuery(viewerRequest, { requestPolicy: 'network-only' }),
+      subscribe(() => {})
+    );
+    await new Promise(resolve => setTimeout(resolve, 0));
+    if (fetcher.mock.calls.length > 1) await refreshedResult;
+    refreshedSubscription.unsubscribe();
+    unsubscribe.unsubscribe();
+
+    return { fetcher, accountPanelText };
+  };
+
+  it('sends the current login token on the re-executed request', async () => {
+    const { fetcher } = await refreshViewer();
+
+    expect(fetcher.mock.calls.length).toBeGreaterThanOrEqual(2);
+    const headers = new Headers(fetcher.mock.calls[1][1].headers);
+    expect(headers.get('authorization')).toContain('fresh-access-token');
+  });
+
+  it('makes the refreshed viewer id available to account information', async () => {
+    const { accountPanelText } = await refreshViewer();
+
+    expect(accountPanelText).toContain('Account: viewer-42');
+  });
+});
