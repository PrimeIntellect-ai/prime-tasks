+@pytest.mark.parametrize("failure_location", ["open", "write"])
+def test_from_cvp_os_error(
+    tmp_path: Path,
+    click_runner: CliRunner,
+    failure_location: str,
+) -> None:
+    """Test that file-write errors are reported as CLI errors."""
+    output: Path = tmp_path / "output.yml"
+    cli_args = ["get", "from-cvp", "--output", str(output), "--host", "42.42.42.42", "--username", "anta", "--password", "anta"]
+    failing_file = MagicMock()
+    failing_file.__enter__.return_value.write.side_effect = OSError("No space left on device")
+    if failure_location == "open":
+        open_patch = patch("anta.cli.get.utils.Path.open", side_effect=OSError("Permission denied"))
+    else:
+        open_patch = patch("anta.cli.get.utils.Path.open", return_value=failing_file)
+
+    with (
+        patch("anta.cli.get.commands.get_cv_token", autospec=True, side_effect=None),
+        patch("cvprac.cvp_client.CvpClient.connect", autospec=True, side_effect=None),
+        patch("cvprac.cvp_client.CvpApi.get_inventory", autospec=True, return_value=[]),
+        patch("cvprac.cvp_client.CvpApi.get_devices_in_container", autospec=True, return_value=[]),
+        open_patch,
+    ):
+        result = click_runner.invoke(anta, cli_args)
+
+    assert result.exit_code != 0
+    assert result.exception is None or isinstance(result.exception, SystemExit)
+
+
