+    def test_experiment_last_state_with_output_variables(self):
+        experiment = pybamm.Experiment(["Discharge at 1C for 10 minutes"])
+        solver = pybamm.IDAKLUSolver(
+            output_variables=["Time [s]", "Current [A]", "Voltage [V]"]
+        )
+
+        first_sim = pybamm.Simulation(
+            pybamm.lithium_ion.SPM(), experiment=experiment, solver=solver
+        )
+        first_solution = first_sim.solve()
+
+        next_sim = pybamm.Simulation(
+            pybamm.lithium_ion.SPM(), experiment=experiment, solver=solver
+        )
+        continued_solution = next_sim.solve(
+            starting_solution=first_solution.last_state
+        )
+
+        assert continued_solution.t[-1] > 0
+        assert continued_solution.cycles[-1] is not None
+
+    def test_save_cycles_with_output_variables(self):
+        experiment = pybamm.Experiment(
+            [("Discharge at 1C for 10 minutes",)] * 4
+        )
+        solver = pybamm.IDAKLUSolver(
+            output_variables=["Time [s]", "Current [A]", "Voltage [V]"]
+        )
+        sim = pybamm.Simulation(
+            pybamm.lithium_ion.SPM(), experiment=experiment, solver=solver
+        )
+
+        solution = sim.solve(save_at_cycles=2)
+
+        assert len(solution.cycles) == 4
+        assert solution.cycles[0] is not None
+        assert solution.cycles[1] is not None
+        assert solution.cycles[2] is None
+        assert solution.cycles[3] is not None
+        assert solution.cycles[1]["Current [A]"].data.size > 0
