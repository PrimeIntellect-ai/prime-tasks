+package helm_test
+
+import (
+	"testing"
+
+	"github.com/kinvolk/lokomotive/pkg/helm"
+
+	"github.com/google/go-cmp/cmp"
+	"helm.sh/helm/v3/pkg/release"
+)
+
+// mockHistory is a HistoryClient that returns a fixed release history for a
+// given release name.
+type mockHistory struct {
+	releases map[string][]*release.Release
+}
+
+func (m mockHistory) Run(name string) ([]*release.Release, error) {
+	return m.releases[name], nil
+}
+
+// releaseHistory returns a fresh, unordered release history so that each test
+// case operates on its own data.
+func releaseHistory() []*release.Release {
+	return []*release.Release{
+		{
+			Name:    "testRelease",
+			Version: 6,
+		},
+		{
+			Name:    "testRelease",
+			Version: 2,
+		},
+		{
+			Name:    "testRelease",
+			Version: 4,
+		},
+		{
+			Name:    "testRelease",
+			Version: 3,
+		},
+		{
+			Name:    "testRelease",
+			Version: 5,
+		},
+	}
+}
+
+func TestGetHistory(t *testing.T) {
+	type testCase struct {
+		name     string
+		max      int
+		expected []*release.Release
+	}
+
+	cases := []testCase{
+		{
+			name: "returns_at_most_given_max_elements",
+			max:  2,
+			expected: []*release.Release{
+				{
+					Name:    "testRelease",
+					Version: 6,
+				},
+				{
+					Name:    "testRelease",
+					Version: 5,
+				},
+			},
+		},
+		{
+			name: "returns_releases_with_descending_order_by_version",
+			max:  10,
+			expected: []*release.Release{
+				{
+					Name:    "testRelease",
+					Version: 6,
+				},
+				{
+					Name:    "testRelease",
+					Version: 5,
+				},
+				{
+					Name:    "testRelease",
+					Version: 4,
+				},
+				{
+					Name:    "testRelease",
+					Version: 3,
+				},
+				{
+					Name:    "testRelease",
+					Version: 2,
+				},
+			},
+		},
+		{
+			name: "returns_only_the_newest_release_when_max_is_one",
+			max:  1,
+			expected: []*release.Release{
+				{
+					Name:    "testRelease",
+					Version: 6,
+				},
+			},
+		},
+	}
+
+	for _, tc := range cases {
+		tc := tc
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+
+			client := mockHistory{releases: map[string][]*release.Release{
+				"testRelease": releaseHistory(),
+			}}
+
+			got, err := helm.GetHistory(client, "testRelease", tc.max)
+			if err != nil {
+				t.Fatalf("Getting history: %v", err)
+			}
+
+			if diff := cmp.Diff(tc.expected, got); diff != "" {
+				t.Fatalf("Unexpected history (-want +got)\n%s", diff)
+			}
+		})
+	}
+}
+
+// TestGetHistoryUsesRequestedRelease verifies that the history is retrieved for
+// the release name that was requested.
+func TestGetHistoryUsesRequestedRelease(t *testing.T) {
+	client := mockHistory{releases: map[string][]*release.Release{
+		"release-a": {
+			{
+				Name:    "release-a",
+				Version: 1,
+			},
+		},
+		"release-b": {
+			{
+				Name:    "release-b",
+				Version: 1,
+			},
+			{
+				Name:    "release-b",
+				Version: 2,
+			},
+		},
+	}}
+
+	got, err := helm.GetHistory(client, "release-b", 1)
+	if err != nil {
+		t.Fatalf("Getting history: %v", err)
+	}
+
+	if len(got) != 1 {
+		t.Fatalf("expected 1 release, got %d", len(got))
+	}
+
+	if got[0].Name != "release-b" || got[0].Version != 2 {
+		t.Fatalf("expected newest revision of release-b, got %v", got[0])
+	}
+}
