diff --git a/tests/testthat/test-assignment_spaces_linter.R b/tests/testthat/test-assignment_spaces_linter.R
index 604700b..81b5160 100644
--- a/tests/testthat/test-assignment_spaces_linter.R
+++ b/tests/testthat/test-assignment_spaces_linter.R
@@ -1,5 +1,5 @@
 test_that("returns the correct linting", {
-  linter <- assignment_spaces()
+  linter <- assignment_spaces_linter()
   msg <- rex("Assignments should only have one space before and after the operator.")
 
   expect_lint("fun(blah =  1)", NULL, linter)
@@ -52,3 +52,19 @@ test_that("returns the correct linting", {
     linter
   )
 })
+
+test_that("assignment_spaces_linter flags incorrect spacing around <-", {
+  linter <- assignment_spaces_linter()
+  msg <- rex("Assignments should only have one space before and after the operator.")
+
+  expect_lint("blah <- 1", NULL, linter)
+  expect_lint("blah<-  1", msg, linter)
+  expect_lint("blah  <-1", msg, linter)
+  expect_lint("blah <-  1", msg, linter)
+  expect_lint("blah  <- 1", msg, linter)
+  expect_lint("blah     <-     1", msg, linter)
+})
+
+test_that("assignment_spaces_linter is available from the package API", {
+  expect_true("assignment_spaces_linter" %in% getNamespaceExports("lintr"))
+})
