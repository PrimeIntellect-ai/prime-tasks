diff --git a/tests/testthat/test-sprintf_linter.R b/tests/testthat/test-sprintf_linter.R
new file mode 100644
index 0000000..27970ca
--- /dev/null
+++ b/tests/testthat/test-sprintf_linter.R
@@ -0,0 +1,41 @@
+context("sprintf_linter")
+test_that("returns the correct linting", {
+  expect_lint("sprintf('hello')",
+    NULL,
+    sprintf_linter)
+
+  expect_lint("sprintf('hello %d', 1)",
+    NULL,
+    sprintf_linter)
+
+  expect_lint("sprintf('hello %d',)",
+    list(message = rex("")),
+    sprintf_linter)
+
+  expect_lint("sprintf('hello %1$s %1$s', x)",
+    NULL,
+    sprintf_linter)
+
+  expect_lint("sprintf('hello %1$s %1$s %2$d', x, y)",
+    NULL,
+    sprintf_linter)
+
+  expect_lint("sprintf('hello %1$s %1$s %3$d', x, y)",
+    list(message = rex("")),
+    sprintf_linter)
+
+  # Only string-literal format strings are analysed.  A symbol or a call as the
+  # format argument must be ignored, even when evaluating it would raise an
+  # error (e.g. an unbound symbol or a call producing an incompatible format).
+  expect_lint("sprintf(fmt, 1)",
+    NULL,
+    sprintf_linter)
+
+  expect_lint("sprintf(paste0('%d'), 'a')",
+    NULL,
+    sprintf_linter)
+})
+
+test_that("exposes a callable linter API", {
+  expect_true(is.function(sprintf_linter))
+})
