+    def test_mass_matrix_inverse_for_mixed_model(self):
+        class NonIdentityMassMethod(SpatialMethodForTesting):
+            def mass_matrix(self, symbol, boundary_conditions):
+                n = 0
+                for domain in symbol.domain:
+                    n += self.mesh[domain][0].npts
+                entries = np.diag(np.arange(2, n + 2, dtype=float))
+                entries[np.arange(n - 1), np.arange(1, n)] = 0.25
+                return pybamm.Matrix(csc_matrix(entries))
+
+        mesh = get_mesh_for_testing()
+        spatial_methods = {
+            "macroscale": NonIdentityMassMethod(),
+            "negative particle": SpatialMethodForTesting(),
+            "positive particle": SpatialMethodForTesting(),
+            "current collector": SpatialMethodForTesting(),
+        }
+        differential = pybamm.Variable("differential", domain="negative electrode")
+        algebraic = pybamm.Variable("algebraic", domain="negative electrode")
+        model = pybamm.BaseModel()
+        model.rhs = {differential: differential}
+        model.algebraic = {algebraic: 2 * differential - algebraic}
+        model.initial_conditions = {
+            differential: pybamm.Scalar(1),
+            algebraic: pybamm.Scalar(2),
+        }
+        model.variables = {"differential": differential, "algebraic": algebraic}
+
+        disc = pybamm.Discretisation(mesh, spatial_methods)
+        disc.process_model(model)
+
+        self.assertIsInstance(model.mass_matrix_inv, pybamm.Matrix)
+        n = model.mass_matrix_inv.entries.shape[0]
+        expected = inv(csc_matrix(model.mass_matrix.entries[:n, :n]))
+        np.testing.assert_allclose(
+            model.mass_matrix_inv.entries.toarray(), expected.toarray()
+        )
+
+    def test_mass_matrix_inverse_can_be_assigned(self):
+        model = pybamm.BaseModel()
+        model.mass_matrix = pybamm.Matrix(4 * eye(2))
+        assigned_inverse = pybamm.Matrix(3 * eye(2))
+
+        model.mass_matrix_inv = assigned_inverse
+
+        self.assertIsInstance(model.mass_matrix_inv, pybamm.Matrix)
+        np.testing.assert_allclose(
+            model.mass_matrix_inv.entries.toarray(), assigned_inverse.entries.toarray()
+        )
+
+    def test_mass_matirx_inverse(self):
+        # create a spatial method whose mass matrix is not the identity, so that
+        # the inverse is not trivial
+        class NonIdentityMassMethod(SpatialMethodForTesting):
+            def mass_matrix(self, symbol, boundary_conditions):
+                n = 0
+                for domain in symbol.domain:
+                    n += self.mesh[domain][0].npts
+                entries = np.diag(np.arange(2, n + 2, dtype=float))
+                entries[np.arange(n - 1), np.arange(1, n)] = 0.25
+                return pybamm.Matrix(csc_matrix(entries))
+
+        mesh = get_mesh_for_testing()
+        spatial_methods = {
+            "macroscale": NonIdentityMassMethod(),
+            "negative particle": SpatialMethodForTesting(),
+            "positive particle": SpatialMethodForTesting(),
+            "current collector": SpatialMethodForTesting(),
+        }
+        # create model
+        a = pybamm.Variable("a", domain="negative electrode")
+        model = pybamm.BaseModel()
+        model.rhs = {a: a}
+        model.initial_conditions = {a: pybamm.Scalar(3)}
+        model.variables = {"a": a}
+
+        # create discretisation
+        disc = pybamm.Discretisation(mesh, spatial_methods)
+        disc.process_model(model)
+
+        # the inverse of the (invertible) mass matrix is computed element-for-element
+        mass_inv = inv(csc_matrix(model.mass_matrix.entries))
+        np.testing.assert_allclose(
+            model.mass_matrix_inv.entries.toarray(), mass_inv.toarray()
+        )
+
 
