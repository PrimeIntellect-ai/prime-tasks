new file mode 100644
index 0000000..a94d7db
--- /dev/null
+++ b/algolia/suggestions/client_config_test.go
@@ -0,0 +1,30 @@
+package suggestions
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestConfig_Unmarshal(t *testing.T) {
+	t.Run("languages as a string array", func(t *testing.T) {
+		var config IndexConfiguration
+		err := json.Unmarshal([]byte(`{"languages":["ja"]}`), &config)
+		require.NoError(t, err)
+
+		encoded, err := json.Marshal(config)
+		require.NoError(t, err)
+		var decoded struct {
+			Languages []string `json:"languages"`
+		}
+		require.NoError(t, json.Unmarshal(encoded, &decoded))
+		require.Equal(t, []string{"ja"}, decoded.Languages)
+	})
+
+	t.Run("languages as false", func(t *testing.T) {
+		var config IndexConfiguration
+		err := json.Unmarshal([]byte(`{"languages":false}`), &config)
+		require.NoError(t, err)
+	})
+}
