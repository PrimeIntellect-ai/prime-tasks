+#[test]
+fn it_rejects_non_string_non_table_wasm_bindgen_values() {
+    let step = wasm_pack::progressbar::Step::new(1);
+    let dir = std::env::temp_dir().join("wasm-pack-non-string-dep-fixture");
+    let _ = fs::remove_dir_all(&dir);
+    fs::create_dir_all(&dir).unwrap();
+
+    for dependency_value in &["true", "17"] {
+        fs::write(
+            dir.join("Cargo.toml"),
+            format!(
+                "[package]\nname = \"invalid-dep\"\nversion = \"0.1.0\"\nauthors = [\"test\"]\n\n[lib]\ncrate-type = [\"cdylib\"]\n\n[dependencies]\nwasm-bindgen = {}\n",
+                dependency_value
+            ),
+        )
+        .unwrap();
+        let result = manifest::check_crate_config(&dir, &step);
+        assert!(
+            result.is_err(),
+            "wasm-bindgen value {} should be rejected",
+            dependency_value
+        );
+    }
+
+    let _ = fs::remove_dir_all(&dir);
+}
