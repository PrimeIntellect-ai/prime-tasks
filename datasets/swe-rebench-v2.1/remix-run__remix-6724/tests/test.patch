+        "rsa:2048",
+        "-keyout",
+        "key.pem",
+        "-out",
+        "cert.pem",
+        "-days",
+        "1",
+        "-nodes",
+        "-subj",
+        "/CN=localhost",
+      ],
+      { cwd: projectDir }
+    );
+
+    let port = await getPort();
