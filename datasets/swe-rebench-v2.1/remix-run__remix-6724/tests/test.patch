+      `console.log(JSON.stringify(Object.values(process.env).filter((value) => typeof value === "string" && value.startsWith("http")))); setInterval(() => {}, 1000);`
+    );
+    let appServerCommand = `node ${appServerPath}`;
+    fse.writeFileSync(
+      path.join(projectDir, "remix.config.js"),
+      `module.exports = { future: { v2_dev: { tlsKey: ${JSON.stringify(
+        path.join(projectDir, "key.pem")
+      )}, tlsCert: ${JSON.stringify(
+        path.join(projectDir, "cert.pem")
+      )}, port: ${port}, command: ${JSON.stringify(appServerCommand)} } } };`
+    );
+
+    let proc = childProcess.spawn(
+      "node",
+      [
+        "--require",
+        require.resolve("esbuild-register"),
+        "--require",
+        path.join(__dirname, "./msw.ts"),
+        path.resolve(__dirname, "../cli.ts"),
+        "dev",
+        projectDir,
+      ],
+      {
+        cwd: TEMP_DIR,
+        env: { ...process.env, NO_COLOR: "1" },
+        stdio: ["ignore", "pipe", "pipe"],
+      }
+    );
+    let serverOutput = "";
+    proc.stdout?.on("data", (chunk) => (serverOutput += chunk.toString()));
+    proc.stderr?.on("data", (chunk) => (serverOutput += chunk.toString()));
+
+    try {
+      let encryptedResponseReceived = false;
+      for (
+        let attempt = 0;
+        attempt < 50 &&
+        (!encryptedResponseReceived || !serverOutput.includes(expectedOrigin));
+        attempt++
+      ) {
+        try {
+          if (!encryptedResponseReceived) {
+            encryptedResponseReceived = await new Promise<boolean>(
+              (resolve, reject) => {
+                let request = https.get(
