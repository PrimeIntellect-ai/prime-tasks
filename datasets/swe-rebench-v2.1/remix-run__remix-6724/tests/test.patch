+                    hostname: "localhost",
+                    port,
+                    rejectUnauthorized: false,
+                  },
+                  (response) => {
+                    let encrypted = Boolean(response.socket.encrypted);
+                    response.resume();
+                    response.on("end", () => resolve(encrypted));
+                  }
+                );
+                request.on("error", reject);
+              }
+            );
+          }
+        } catch {
+          // The development server may not be listening yet.
+        }
