diff --git a/test/runtests.jl b/test/runtests.jl
index 4e0e57f..2d6b21a 100644
--- a/test/runtests.jl
+++ b/test/runtests.jl
@@ -1,6 +1,28 @@
 using Distributed
 addprocs()
 
+using MLJBase
+using Test
+if !MLJBase.TESTING
+    error("To test MLJBase, the environment variable "*
+          "`TEST_MLJBASE` must be set to `\"true\"`\n"*
+          "You can do this in the REPL with `ENV[TEST_MLJBASE]=\"true\"")
+end
+
+@testset "remote channel initialization" begin
+    code = "using MLJBase; using Distributed; "*
+           "print(MLJBase.TESTING, \",\", "*
+           "isdefined(MLJBase, :MACHINE_CHANNEL) && "*
+           "MLJBase.MACHINE_CHANNEL isa RemoteChannel)"
+    cmd = `$(Base.julia_cmd()) --project=$(Base.active_project()) -e $code`
+
+    # Testing is enabled only for the exact value "true", and the test
+    # channel exists only in that mode.
+    @test strip(read(addenv(cmd, "TEST_MLJBASE" => "true"), String)) == "true,true"
+    @test strip(read(addenv(cmd, "TEST_MLJBASE" => "false"), String)) == "false,false"
+    @test strip(read(addenv(cmd, "TEST_MLJBASE" => nothing), String)) == "false,false"
+end
+
 @info "nprocs() = $(nprocs())"
 @static if VERSION >= v"1.3.0-DEV.573"
     import .Threads
