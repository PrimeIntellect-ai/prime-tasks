+    def test_non_complete_config_load(self):
+        """Tests non full configuration load."""
+        path_to_config = (
+            f"{os.path.dirname(os.path.abspath(__file__))}/"
+            f"../resources/test_ecosystem_config.json"
+        )
+
+        config = PythonRepositoryConfiguration.load(path_to_config)
+        self.assertEqual(config.language.name, "python")
+        self.assertEqual(
+            config.language.versions, PythonLanguageConfiguration.default_version()
+        )
+        self.assertEqual(config.dependencies_files, [])
+        self.assertEqual(config.tests_command, [])
+        self.assertEqual(config.styles_check_command, [])
+        self.assertEqual(config.extra_dependencies, [])
+
+    def test_omitted_constructor_arguments_use_python_and_empty_lists(self):
+        """Both repository configuration types supply their documented defaults."""
+        for config in (RepositoryConfiguration(), PythonRepositoryConfiguration()):
+            self.assertEqual(config.language.name, "python")
+            self.assertEqual(
+                config.language.versions, PythonLanguageConfiguration.default_version()
+            )
+            self.assertEqual(config.dependencies_files, [])
+            self.assertEqual(config.extra_dependencies, [])
+            self.assertEqual(config.tests_command, [])
+            self.assertEqual(config.styles_check_command, [])
+            self.assertEqual(config.coverages_check_command, [])
+
+    def test_explicit_empty_language_versions_are_preserved(self):
+        """An explicitly empty versions list is distinct from omitted versions."""
+        config = PythonLanguageConfiguration(versions=[])
+
+        self.assertEqual(config.versions, [])
