+func TestActionClientAll(t *testing.T) {
+	env := newTestEnv()
+	defer env.Teardown()
+
+	env.Mux.HandleFunc("/actions", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		page := r.URL.Query().Get("page")
+		var actions []schema.Action
+		switch page {
+		case "", "1":
+			actions = []schema.Action{{ID: 1}, {ID: 2}}
+		case "2":
+			actions = []schema.Action{{ID: 3}, {ID: 4}}
+		default:
+			t.Errorf("unexpected page requested: %q", page)
+		}
+		currentPage := 1
+		nextPage := 2
+		if page == "2" {
+			currentPage = 2
+			nextPage = 0
+		}
+		json.NewEncoder(w).Encode(struct {
+			Actions []schema.Action `json:"actions"`
+			Meta    schema.Meta     `json:"meta"`
+		}{
+			Actions: actions,
+			Meta: schema.Meta{
+				Pagination: &schema.MetaPagination{
+					Page:         currentPage,
+					NextPage:     nextPage,
+					LastPage:     2,
+					PerPage:      2,
+					TotalEntries: 4,
+				},
+			},
+		})
+	})
+
+	ctx := context.Background()
+	actions, err := env.Client.Action.All(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(actions) != 4 {
+		t.Fatalf("expected 4 actions across both pages; got %d", len(actions))
+	}
+	gotIDs := make(map[int]bool, len(actions))
+	for _, action := range actions {
+		gotIDs[action.ID] = true
+	}
+	for _, id := range []int{1, 2, 3, 4} {
+		if !gotIDs[id] {
+			t.Errorf("missing action %d", id)
+		}
+	}
+}
