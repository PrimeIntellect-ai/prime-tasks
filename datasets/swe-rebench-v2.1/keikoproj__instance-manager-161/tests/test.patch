+func TestConfiguredIOPSForIo1Volume(t *testing.T) {
+	g := gomega.NewGomegaWithT(t)
+	configuration := &v1alpha1.EKSConfiguration{}
+	err := json.Unmarshal([]byte(`{"volumes":[{"name":"/dev/xvda","type":"io1","size":100,"iops":500}]}`), configuration)
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+
+	ig := MockInstanceGroup()
+	ig.GetEKSConfiguration().Volumes = configuration.Volumes
+	ctx := MockContext(ig, MockKubernetesClientSet(), MockAwsWorker(NewAutoScalingMocker(), NewIamMocker(), NewEksMocker(), NewEc2Mocker()))
+	ctx.SetDiscoveredState(&DiscoveredState{})
+
+	input := ctx.GetLaunchConfigurationInput("configured-volume")
+	iopsApplied := false
+	for _, mapping := range input.BlockDeviceMappings {
+		if aws.StringValue(mapping.Ebs.VolumeType) == "io1" && aws.Int64Value(mapping.Ebs.Iops) == 500 {
+			iopsApplied = true
+			break
+		}
+	}
+	g.Expect(iopsApplied).To(gomega.BeTrue())
+}
