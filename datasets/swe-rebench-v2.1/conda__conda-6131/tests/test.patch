+# -*- coding: utf-8 -*-
+from __future__ import absolute_import, division, print_function, unicode_literals
+from logging import getLogger
+
+from conda.models.index_record import IndexRecord
+
+log = getLogger(__name__)
+
+
+def test_index_record_timestamp():
+    # regression test for #6096
+    ts = 1507565728
+    new_ts = ts * 1000
+    rec = IndexRecord(
+        name='test-package',
+        version='1.2.3',
+        build='2',
+        build_number=2,
+        timestamp=ts
+    )
+    assert rec.timestamp == new_ts
+    assert isinstance(rec.timestamp, int)
+    dumped = rec.dump()
+    assert isinstance(dumped, dict)
+    assert dumped['timestamp'] == new_ts
+
+    ts = 1507565728999
+    new_ts = ts
+    rec = IndexRecord(
+        name='test-package',
+        version='1.2.3',
+        build='2',
+        build_number=2,
+        timestamp=ts
+    )
+    assert rec.timestamp == new_ts
+    assert rec.dump()['timestamp'] == new_ts
+
+
+def test_index_record_timestamp_at_millisecond_cutoff():
+    cutoff = 253402300799
+    rec = IndexRecord(
+        name='test-package',
+        version='1.2.3',
+        build='2',
+        build_number=2,
+        timestamp=cutoff,
+    )
+
+    assert rec.timestamp == cutoff
+    assert rec.dump()['timestamp'] == cutoff
+
+
+def test_index_record_additional_fields():
+    # additional fields supported by the Entity base class are preserved
+    rec = IndexRecord(
+        name='test-package',
+        version='1.2.3',
+        build='2',
+        build_number=2,
+        timestamp=1507565728,
+        channel='defaults',
+        md5='0123456789abcdef0123456789abcdef',
+        size=1234,
+    )
+    assert rec.channel == 'defaults'
+    assert rec.md5 == '0123456789abcdef0123456789abcdef'
+    assert rec.size == 1234
+
+    dumped = rec.dump()
+    assert dumped['channel'] == 'defaults'
+    assert dumped['md5'] == '0123456789abcdef0123456789abcdef'
+    assert dumped['size'] == 1234
+
+
+def test_index_record_fractional_seconds_timestamp():
+    rec = IndexRecord(
+        name='test-package',
+        version='1.2.3',
+        build='2',
+        build_number=2,
+        timestamp=1505856869.685,
+    )
+
+    assert rec.timestamp == 1505856869685
+    assert rec.dump()['timestamp'] == 1505856869685
