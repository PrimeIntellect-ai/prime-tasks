+func TestGenerateCompletesWithHTMLInJSString(t *testing.T) {
+	dir := t.TempDir()
+	template := `package test
+
+templ A() {
+<script>
+function showSuccessMessage(responseText) {
+const formResponse = document.getElementById('form-response');
+formResponse.innerHTML = ` + "`" + `
+<div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">
+${responseText}
+</div>` + "`" + `;
+}
+</script>
+}
+`
+	if err := os.WriteFile(filepath.Join(dir, "a.templ"), []byte(template), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	bin := filepath.Join(t.TempDir(), "templ")
+	build := exec.Command("go", "build", "-o", bin, "github.com/a-h/templ/cmd/templ")
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("failed to build templ: %v\n%s", err, out)
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+
+	cmd := exec.CommandContext(ctx, bin, "generate", "-path", dir)
+	cmd.WaitDelay = 5 * time.Second
+	out, err := cmd.CombinedOutput()
+	if ctx.Err() == context.DeadlineExceeded {
+		t.Fatalf("templ generate did not complete within the timeout; output:\n%s", out)
+	}
+	if err != nil {
+		t.Fatalf("templ generate failed: %v\noutput:\n%s", err, out)
+	}
+}
