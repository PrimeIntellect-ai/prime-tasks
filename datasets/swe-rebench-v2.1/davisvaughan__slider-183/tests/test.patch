+# ------------------------------------------------------------------------------
+# .before / .after - non-vctrs types
+
+test_that(".i/.before/.after can be non-vctrs types (#182)", {
+  local_c_foobar()
+
+  i <- foobar(1:4)
+  x <- seq_along(i)
+
+  expect_identical(
+    slide_index(x, i, identity, .before = 2L),
+    list(
+      1L,
+      1:2,
+      1:3,
+      2:4
+    )
+  )
+  expect_identical(
+    slide_index(x, i, identity, .before = foobar(2L)),
+    list(
+      1L,
+      1:2,
+      1:3,
+      2:4
+    )
+  )
+
+  expect_identical(
+    slide_index(x, i, identity, .after = 2L),
+    list(
+      1:3,
+      2:4,
+      3:4,
+      4L
+    )
+  )
+  expect_identical(
+    slide_index(x, i, identity, .after = foobar(2L)),
+    list(
+      1:3,
+      2:4,
+      3:4,
+      4L
+    )
+  )
+
+  # Check custom window lengths separately from the custom index type.
+  expect_identical(
+    slide_index(x, 1:4, identity, .before = foobar(2L)),
+    list(1L, 1:2, 1:3, 2:4)
+  )
+  expect_identical(
+    slide_index(x, 1:4, identity, .after = foobar(2L)),
+    list(1:3, 2:4, 3:4, 4L)
+  )
+})
+
+test_that("identity windows retain a custom class on `.x`", {
+  x <- structure(1:4, class = "my_integer")
+  before <- structure(2L, class = "my_integer")
+
+  out <- slide_index(x, x, identity, .before = before)
+
+  expect_identical(
+    lapply(out, class),
+    rep(list("my_integer"), 4L)
+  )
+})
+
 # ------------------------------------------------------------------------------
 # .before / .after - function
 
