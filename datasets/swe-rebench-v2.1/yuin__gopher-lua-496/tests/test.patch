+
+func TestMergingLoadNilBug(t *testing.T) {
+	// A nil assignment clears its target without clearing neighboring locals.
+	s := `
+    function test()
+        local a = 0
+        local b = 1
+        local c = 2
+        local d = 3
+        local e = 4
+        local f = 5
+        local g = 6
+        local h = 7
+
+        if e == 4 then
+            e = nil
+        end
+        if e ~= nil then
+            error("bad e")
+        end
+        if f == nil then
+            error("bad f")
+        end
+        if g == nil then
+            error("bad g")
+        end
+        if h == nil then
+            error("bad h")
+        end
+    end
+
+    test()
+`
+
+	chunk, err := parse.Parse(strings.NewReader(s), "test")
+	if err != nil {
+		t.Fatal(err)
+	}
+	compiled, err := Compile(chunk, "test")
+	if err != nil {
+		t.Fatal(err)
+	}
+	hasReportedEncoding := false
+	var findReportedEncoding func(*FunctionProto)
+	findReportedEncoding = func(proto *FunctionProto) {
+		for _, instr := range proto.Code {
+			if opGetOpCode(instr) == OP_LOADNIL && opGetArgA(instr) == 4 && opGetArgB(instr) == 4 && opGetArgC(instr) == 0 {
+				hasReportedEncoding = true
+			}
+		}
+		for _, child := range proto.FunctionPrototypes {
+			findReportedEncoding(child)
+		}
+	}
+	findReportedEncoding(compiled)
+	if !hasReportedEncoding {
+		t.Fatal("reported nil assignment was not encoded as LOADNIL 4, 4, 0")
+	}
+
+	L := NewState()
+	defer L.Close()
+	if err := L.DoString(s); err != nil {
+		t.Error(err)
+	}
+}
+
+func TestMergingLoadNil(t *testing.T) {
+	// Consecutive nil assignments should clear their targets without clearing a neighboring local.
+	s := `
+function test()
+local a = 0
+local b = 1
+local c = 2
+local d = 3
+
+a = nil
+b = nil
+c = nil
+
+observed_a = a
+observed_b = b
+observed_c = c
+observed_d = d
+end
+
+test()`
+
+	L := NewState()
+	defer L.Close()
+	if err := L.DoString(s); err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"observed_a", "observed_b", "observed_c"} {
+		if L.GetGlobal(name) != LNil {
+			t.Errorf("%s = %v, want nil", name, L.GetGlobal(name))
+		}
+	}
+	if got := L.GetGlobal("observed_d"); got != LNumber(3) {
+		t.Errorf("neighboring local = %v, want 3", got)
+	}
+}
