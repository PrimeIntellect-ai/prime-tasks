+
+// Keep these tests compatible with either ServiceAccount parameter form.
+type deploymentReconcilerByValue interface {
+	reconcileRolloutsDeployment(context.Context, *v1alpha1.RolloutManager, corev1.ServiceAccount) error
+}
+type deploymentReconcilerByPointer interface {
+	reconcileRolloutsDeployment(context.Context, *v1alpha1.RolloutManager, *corev1.ServiceAccount) error
+}
+
+func reconcileDeployment(r *RolloutManagerReconciler, ctx context.Context, manager *v1alpha1.RolloutManager, sa *corev1.ServiceAccount) error {
+	if reconciler, ok := any(r).(deploymentReconcilerByValue); ok {
+		return reconciler.reconcileRolloutsDeployment(ctx, manager, *sa)
+	}
+	return any(r).(deploymentReconcilerByPointer).reconcileRolloutsDeployment(ctx, manager, sa)
+}
+
+func makeRolloutsContainer(manager *v1alpha1.RolloutManager) corev1.Container {
+	factory := any(rolloutsContainer)
+	if byValue, ok := factory.(func(v1alpha1.RolloutManager) corev1.Container); ok {
+		return byValue(*manager)
+	}
+	return factory.(func(*v1alpha1.RolloutManager) corev1.Container)(manager)
+}
diff --git a/hack/run-rollouts-manager-e2e-tests.sh b/hack/run-rollouts-manager-e2e-tests.sh
new file mode 100755
index 0000000..52d430b
--- /dev/null
+++ b/hack/run-rollouts-manager-e2e-tests.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+
+SCRIPTPATH="$(
+  cd -- "$(dirname "$0")" >/dev/null 2>&1 || exit
+  pwd -P
+)"
+
+cd "$SCRIPTPATH/.."
+
+set -o pipefail
+set -ex
+
+go test -v -p=1 -timeout=10m -race -count=1 -coverprofile=coverage.out ./tests/e2e
+
+set +e
+
+# If the output from the E2E operator is available, then check it for errors
+if [ -f "/tmp/e2e-operator-run.log" ]; then
+
+    # Grep the log for unexpected errors
+    # - Ignore errors that are expected to occur
+
+    ERRORS_FOUND_TEXT=`cat /tmp/e2e-operator-run.log | grep "ERROR" | grep -v "unable to create new content in namespace argo-rollouts because it is being terminated" | grep -v "the object has been modified; please apply your changes to the latest version and try again"`
+
+    ERRORS_FOUND=`echo $ERRORS_FOUND_TEXT | grep "ERROR" | wc -l`
+
+    if [ "$ERRORS_FOUND" != "0" ]; then
+        echo "Unexpected errors found: $ERRORS_FOUND_TEXT"
+        exit 1
+    fi
+
+fi
