+  test('sink.addStream sends the streamed body', () async {
+    var request = http.StreamedRequest('POST', serverUrl);
+    var responseFuture = request.send();
+    await request.sink.addStream(Stream.fromIterable([
+      [1, 2, 3],
+      [4, 5, 6],
+    ]));
+    unawaited(request.sink.close());
+    var response = await responseFuture;
+    expect(await utf8.decodeStream(response.stream),
+        parse(containsPair('body', [1, 2, 3, 4, 5, 6])));
+  });
+
+  test('sink.addStream pauses its source while the request body is paused',
+      () async {
+    final request = http.StreamedRequest('POST', serverUrl);
+    final bodySubscription = request.finalize().listen((_) {});
+    bodySubscription.pause();
+
+    final sourcePaused = Completer<void>();
+    final source = StreamController<List<int>>(onPause: () {
+      if (!sourcePaused.isCompleted) sourcePaused.complete();
+    });
+    final addStream = request.sink.addStream(source.stream);
+    source.add([1]);
+
+    try {
+      await sourcePaused.future.timeout(const Duration(seconds: 1));
+      expect(source.isPaused, isTrue);
+    } finally {
+      bodySubscription.resume();
+      await source.close();
+      await addStream;
+      await request.sink.close();
+      await bodySubscription.cancel();
+    }
+  });
+
