+@pytest.mark.skipif(os.name == "nt", reason="Windows")
+def test_VirtualEnv_uses_symlinks(nested_venv: VirtualEnv) -> None:
+    executable = Path(nested_venv.executable)
+    assert executable.resolve(strict=True).parent != executable.parent
+
+
+def test_VirtualEnv_create_symlinks_true(tmp_path: Path) -> None:
+    venv = VirtualEnv(tmp_path)
+    venv.create(with_pip=False, upgrade_deps=False, symlinks=True)
+    assert Path(venv.executable).is_symlink()
+
+
+def test_VirtualEnv_create_symlinks_false(tmp_path: Path) -> None:
+    venv = VirtualEnv(tmp_path)
+    venv.create(with_pip=False, upgrade_deps=False, symlinks=False)
+    assert not Path(venv.executable).is_symlink()
+
+
+def test_VirtualEnv_create_default_symlinks_windows(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    import importlib
+    import platform
+
+    import lektor.packages as packages
+
+    # Simulate running on Windows so that the platform-dependent default can be
+    # observed on any host.
+    monkeypatch.setattr(os, "name", "nt")
+    monkeypatch.setattr(sys, "platform", "win32")
+    monkeypatch.setattr(platform, "system", lambda: "Windows")
+    importlib.reload(packages)
+    try:
+        default = inspect.signature(packages.VirtualEnv.create).parameters[
+            "symlinks"
+        ].default
+        if isinstance(default, bool):
+            assert default is False
+    finally:
+        monkeypatch.undo()
+        importlib.reload(packages)
+
+
