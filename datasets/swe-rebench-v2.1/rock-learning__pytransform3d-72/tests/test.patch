+def test_axis_angle_from_two_direction_vectors():
+    """The returned rotation aligns the requested directions."""
+    direction_pairs = [
+        (np.array([1.0, 0.0, 0.0]), np.array([1.0, 0.0, 0.0])),
+        (np.array([2.0, 0.0, 0.0]), np.array([0.0, 3.0, 0.0])),
+        (np.array([1.0, 2.0, -3.0]), np.array([-1.0, -2.0, 3.0])),
+        (np.array([1.0, 2.0, 3.0]), np.array([-2.0, 1.0, 4.0])),
+    ]
+    for source, target in direction_pairs:
+        rotation = np.asarray(axis_angle_from_two_directions(source, target))
+        assert_equal(rotation.shape, (4,))
+        source_direction = source / np.linalg.norm(source)
+        target_direction = target / np.linalg.norm(target)
+        aligned_direction = matrix_from_axis_angle(rotation).dot(
+            source_direction)
+        assert_array_almost_equal(aligned_direction, target_direction)
+
