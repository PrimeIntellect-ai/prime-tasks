+func TestOptionIsUsedByExportedAPIs(t *testing.T) {
+	if got := reflect.TypeOf((*ocinterceptor.Option)(nil)).Elem().Name(); got != "Option" {
+		t.Fatalf("public option type has name %q, want Option", got)
+	}
+
+	optionParameter := func(name string, fn interface{}, index int) {
+		t.Helper()
+		parameter := reflect.TypeOf(fn).In(index)
+		if parameter.Kind() != reflect.Slice {
+			t.Fatalf("%s option parameter has type %v, want a variadic Option", name, parameter)
+		}
+		if got := parameter.Elem().Name(); got != "Option" {
+			t.Errorf("%s accepts %q, want Option", name, got)
+		}
+	}
+	optionParameter("New", ocinterceptor.New, 1)
+	optionParameter("NewTraceInterceptor", ocinterceptor.NewTraceInterceptor, 1)
+	optionParameter("NewTraceInterceptorOnDefaultPort", ocinterceptor.NewTraceInterceptorOnDefaultPort, 0)
+
+	for name, fn := range map[string]interface{}{
+		"WithSpanBufferPeriod": ocinterceptor.WithSpanBufferPeriod,
+		"WithSpanBufferCount":  ocinterceptor.WithSpanBufferCount,
+	} {
+		if got := reflect.TypeOf(fn).Out(0).Name(); got != "Option" {
+			t.Errorf("%s returns %q, want Option", name, got)
+		}
+	}
+}
