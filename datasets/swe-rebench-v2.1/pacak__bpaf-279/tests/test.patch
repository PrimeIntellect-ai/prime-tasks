+
+#[test]
+fn command_alias() {
+    #[derive(Debug, Bpaf, Clone)]
+    #[bpaf(options)]
+    enum Groups {
+        #[bpaf(command("top"), long("top-alias"))]
+        Command,
+    }
+
+    assert!(matches!(groups().run_inner(&["top"]), Ok(Groups::Command)));
+    assert!(matches!(groups().run_inner(&["top-alias"]), Ok(Groups::Command)));
+}
+
+#[test]
+fn command_alias_options() {
+    #[derive(Debug, Bpaf, Clone)]
+    #[bpaf(options)]
+    enum Options {
+        #[bpaf(command("command"), long("long"))]
+        Command,
+    }
+
+    // The subcommand can be reached through its name and long alias.
+    // bpaf matches command aliases as bare words (no leading dashes).
+    for alias in ["command", "long"] {
+        let args = [alias];
+        assert!(matches!(options().run_inner(&args[..]), Ok(Options::Command)));
+    }
+}
