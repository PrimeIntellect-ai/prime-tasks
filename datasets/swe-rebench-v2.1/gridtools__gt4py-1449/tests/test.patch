+def test_tuple_of_fields_different_locations():
+    """Tuples of fields on different locations must remain valid through temporary processing."""
+
+    def diff_loc_tuple(
+        inp1: gtx.Field[[IDim], float64], inp2: gtx.Field[[Edge], float64]
+    ) -> gtx.Field[[IDim], float64]:
+        tmp1, tmp2 = inp1, inp2
+        return tmp1
+
+    diff_loc_tuple_function = diff_loc_tuple
+    diff_loc_tuple = gtx.field_operator(diff_loc_tuple_function)
+
+    def mixed_domain_program(
+        inp1: gtx.Field[[IDim], float64],
+        inp2: gtx.Field[[Edge], float64],
+        out: gtx.Field[[IDim], float64],
+    ):
+        diff_loc_tuple(inp1, inp2, out=out)
+
+    field_operator = FieldOperatorLowering.apply(
+        FieldOperatorParser.apply_to_function(diff_loc_tuple_function)
+    )
+    program = ProgramParser.apply_to_function(mixed_domain_program)
+    fencil = ProgramLowering.apply(
+        program, function_definitions=[field_operator], grid_type=gtx.GridType.CARTESIAN
+    )
+
+    # The temporary pass performs type inference over this field-operator call. A tuple
+    # spanning distinct dimensions must remain valid regardless of its ITIR representation.
+    global_tmps.split_closures(fencil, offset_provider={})
 
 
