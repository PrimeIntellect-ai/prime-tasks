+    root.add_child(b)
+    a.add_link(pystac.Link("related", b))
+
+    root.normalize_and_save(
+        str(tmp_path), catalog_type=pystac.catalog.CatalogType.SELF_CONTAINED
+    )
+
+    with (tmp_path / "a" / "catalog.json").open() as f:
+        serialized_a = json.load(f)
+    related_href = next(
+        link["href"] for link in serialized_a["links"] if link["rel"] == "related"
+    )
