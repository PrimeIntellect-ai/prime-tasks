+func waitSuccess(a *Actor, ctx context.Context, h util.Uint256, vub uint32, sendErr error) (*state.AppExecResult, error) {
+	m := reflect.ValueOf(a).MethodByName("WaitSuccess")
+	args := make([]reflect.Value, 0, m.Type().NumIn())
+	if m.Type().NumIn() == 4 {
+		args = append(args, reflect.ValueOf(ctx))
+	}
+	args = append(args, reflect.ValueOf(h), reflect.ValueOf(vub))
+	if sendErr == nil {
+		args = append(args, reflect.Zero(m.Type().In(len(args))))
+	} else {
+		args = append(args, reflect.ValueOf(sendErr))
+	}
+	out := m.Call(args)
+	var callErr error
+	if !out[1].IsNil() {
+		callErr = out[1].Interface().(error)
+	}
+	if out[0].IsNil() {
+		return nil, callErr
+	}
+	return out[0].Interface().(*state.AppExecResult), callErr
+}
