+
+func TestWSWaiter_WaitContextCancelled(t *testing.T) {
+	h := util.Uint256{1, 2, 3}
+	c := &AwaitableRPCClient{RPCClient: RPCClient{}}
+	c.bCount.Store(5)
+	w := waiter.New(c, &result.Version{Protocol: result.Protocol{MillisecondsPerBlock: 1}})
+	_, ok := w.(*waiter.EventBased)
+	require.True(t, ok)
+
+	// No application log is available, so waiting blocks until the supplied
+	// context is done. The underlying client context stays alive.
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	errCh := make(chan error, 1)
+	go func() {
+		_, err := waitWithContext(w, ctx, h, 5, nil)
+		errCh <- err
+	}()
+	select {
+	case err := <-errCh:
+		require.ErrorIs(t, err, waiter.ErrContextDone)
+	case <-time.After(5 * time.Second):
+		t.Fatal("Wait did not return after context cancellation")
+	}
+}
