+package webrtc
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestPeerConnection_AddICECandidate_ICECandidateInit(t *testing.T) {
+	api := NewAPI()
+	pc, err := api.NewPeerConnection(Configuration{})
+	assert.NoError(t, err)
+	defer func() {
+		assert.NoError(t, pc.Close())
+	}()
+
+	assert.NoError(t, pc.SetRemoteDescription(SessionDescription{Type: SDPTypeOffer, SDP: minimalOffer}))
+
+	mid := "0"
+	mLineIndex := uint16(0)
+	candidate := ICECandidateInit{
+		Candidate:        "candidate:foundation 1 udp 128 1.0.0.1 1234 typ host",
+		SDPMid:           &mid,
+		SDPMLineIndex:    &mLineIndex,
+		UsernameFragment: "def",
+	}
+	assert.NoError(t, pc.AddICECandidate(candidate))
+}
