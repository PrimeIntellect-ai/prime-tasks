@@ -623,6 +623,48 @@ class TestIOLoopRunSync(unittest.TestCase):
 
         self.io_loop.run_sync(f2)
 
+    def test_stop_no_timeout(self):
+        async def f():
+            await asyncio.sleep(0.1)
+            IOLoop.current().stop()
+            await asyncio.sleep(10)
+
+        with self.assertRaises(Exception) as cm:
+            self.io_loop.run_sync(f, timeout=0.5)
+        stop_message = str(cm.exception)
+
+        async def g():
+            await asyncio.sleep(10)
+
+        with self.assertRaises(Exception) as cm2:
+            self.io_loop.run_sync(g, timeout=0.5)
+        timeout_message = str(cm2.exception)
+
+        # The error raised when the loop is stopped for a reason other than a
+        # timeout must be distinguishable (by its message) from the error
+        # raised when the timeout actually triggers.
+        self.assertNotEqual(stop_message, timeout_message)
+
+    def test_stop_without_timeout(self):
+        async def stopped():
+            await asyncio.sleep(0.01)
+            IOLoop.current().stop()
+            await asyncio.sleep(10)
+
+        with self.assertRaises(Exception) as stopped_error:
+            self.io_loop.run_sync(stopped)
+
+        async def unfinished():
+            await asyncio.sleep(10)
+
+        with self.assertRaises(Exception) as timeout_error:
+            self.io_loop.run_sync(unfinished, timeout=0.01)
+
+        timeout_message_with_no_timeout_value = str(timeout_error.exception).replace("0.01", "None")
+        self.assertNotEqual(
+            str(stopped_error.exception), timeout_message_with_no_timeout_value
+        )
+
 
