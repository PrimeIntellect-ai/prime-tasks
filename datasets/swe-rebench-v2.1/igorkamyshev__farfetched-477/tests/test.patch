+
+describe('Query.reset aborts in-flight operations, issue #461', () => {
+  test('createQuery with onAbort aborts in-flight operation on reset', async () => {
+    const handleCancel = vi.fn();
+
+    const query = createQuery({
+      handler: async () => {
+        onAbort(handleCancel);
+
+        await setTimeout(10);
+
+        return null;
+      },
+    });
+
+    const scope = fork();
+
+    allSettled(query.start, { scope, params: undefined });
+    allSettled(query.reset, { scope });
+
+    await allSettled(scope);
+
+    expect(handleCancel).toBeCalledTimes(1);
+  });
+
+  test('createJsonQuery aborts in-flight operation on reset', async () => {
+    const query = createJsonQuery({
+      request: {
+        method: 'GET',
+        url: 'https://api.example.com/api/aborted',
+      },
+      response: {
+        contract: unknownContract,
+      },
+    });
+
+    const abortedListener = vi.fn();
+
+    const scope = fork({
+      handlers: [[fetchFx, vi.fn(async () => setTimeout(100))]],
+    });
+
+    createWatch({ unit: query.aborted, fn: abortedListener, scope });
+
+    allSettled(query.refresh, { scope });
+    allSettled(query.reset, { scope });
+
+    await allSettled(scope);
+
+    expect(abortedListener).toBeCalledTimes(1);
+  });
+});
