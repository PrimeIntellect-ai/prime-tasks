+def test_extension_content_access():
+    ext = Nifti1Extension('comment', b'123')
+    assert ext.get_content() == b'123'
+    # get_content is an alias for get_object
+    assert ext.get_object() == b'123'
+    assert ext.get_content() == ext.get_object()
+
+    # Raw, text and JSON access
+    assert ext.content == b'123'
+    assert ext.text == '123'
+    assert ext.json() == 123
+
+    # UTF-8 is the default when no encoding is configured.
+    utf8_ext = Nifti1Extension('comment', b'caf\xc3\xa9')
+    assert utf8_ext.text == 'café'
+
+    # A configured encoding controls text decoding.
+    latin1_ext = Nifti1Extension('comment', b'caf\xe9')
+    latin1_ext.encoding = 'latin-1'
+    assert latin1_ext.text == 'café'
+
+    # Test that encoding errors are caught
+    ascii_ext = Nifti1Extension('comment', 'hôpital'.encode('utf-8'))
+    ascii_ext.encoding = 'ascii'
+    with pytest.raises(UnicodeError):
+        ascii_ext.text
+
+    json_ext = Nifti1Extension('unknown', b'{"a": 1}')
+    assert json_ext.content == b'{"a": 1}'
+    assert json_ext.text == '{"a": 1}'
+    assert json_ext.json() == {'a': 1}
+
+    # Invalid JSON raises a decoding error
+    with pytest.raises(Exception):
+        Nifti1Extension('unknown', b'not json').json()
+
