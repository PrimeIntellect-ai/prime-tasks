+def test_toctree_glob_option():
+    """A final option with no value must be preserved.
+
+    Regression test for https://github.com/executablebooks/MyST-Parser/issues/924,
+    where a trailing ``glob:`` option was dropped, breaking toctree glob patterns.
+    """
+    content = (
+        "---\n"
+        "maxdepth: 2\n"
+        "caption: Contents\n"
+        "glob:\n"
+        "---\n"
+        "path*/index\n"
+        "pages/**\n"
+        "*/index"
+    )
+    result = parse_directive_text(TocTree, "", content, line=0)
+    assert not result.warnings
+    # the trailing valueless option must not be dropped
+    assert "glob" in result.options
+    assert result.body == ["path*/index", "pages/**", "*/index"]
