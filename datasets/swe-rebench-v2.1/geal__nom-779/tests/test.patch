+#[test]
+fn issue_768() {
+  named!(bit_vec11<CompleteByteSlice, Vec<u16>>, bits!(many0!(take_bits!(u16, 11))));
+
+  let m: Vec<u8> = vec![70, 97, 106, 121, 86, 66, 105, 98, 86, 106, 101];
+  assert_eq!(
+    bit_vec11(CompleteByteSlice(m.as_slice())),
+    Ok((CompleteByteSlice(&[]), vec![563, 90, 1266, 1380, 308, 1417, 717, 613]))
+  );
+}
+
+#[test]
+fn issue_768_partial_11_bit_tail() {
+  named!(bit_vec11<CompleteByteSlice, Vec<u16>>, bits!(many0!(take_bits!(u16, 11))));
+
+  let input = [70, 97, 106, 121, 86, 66, 105, 98, 86, 106, 101, 72];
+  let result = bit_vec11(CompleteByteSlice(&input));
+  assert!(result.is_ok());
+  assert_eq!(result.unwrap().1, vec![563, 90, 1266, 1380, 308, 1417, 717, 613]);
+}
+
