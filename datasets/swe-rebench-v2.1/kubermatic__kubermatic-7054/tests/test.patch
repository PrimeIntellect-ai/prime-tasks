+func sortUserProjectBinding(bindings []kubermaticv1.UserProjectBinding) {
+	sort.Slice(bindings, func(i, j int) bool {
+		mi, mj := bindings[i], bindings[j]
+		return mi.Spec.UserEmail < mj.Spec.UserEmail
+	})
