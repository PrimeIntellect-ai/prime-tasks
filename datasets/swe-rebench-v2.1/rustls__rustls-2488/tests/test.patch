+#[test]
+fn client_hello_named_groups_absent() {
+    use rustls::server::Acceptor;
+
+    let provider = provider::default_provider();
+    let client_config = Arc::new(make_client_config(KeyType::Ed25519, &provider));
+    let mut client = ClientConnection::new(client_config, server_name("localhost")).unwrap();
+    let mut hello = Vec::new();
+    client.write_tls(&mut hello).unwrap();
+
+    // Remove the named-groups extension from the generated ClientHello.
+    let mut cursor = 9 + 2 + 32;
+    cursor += 1 + hello[cursor] as usize;
+    let cipher_suites_len = u16::from_be_bytes([hello[cursor], hello[cursor + 1]]) as usize;
+    cursor += 2 + cipher_suites_len;
+    cursor += 1 + hello[cursor] as usize;
+    let extensions_len_offset = cursor;
+    let mut extension_cursor = cursor + 2;
+    let extensions_end = extension_cursor
+        + u16::from_be_bytes([hello[cursor], hello[cursor + 1]]) as usize;
+    let named_groups_extension = loop {
+        let extension_type = u16::from_be_bytes([
+            hello[extension_cursor],
+            hello[extension_cursor + 1],
+        ]);
+        let extension_len =
+            u16::from_be_bytes([hello[extension_cursor + 2], hello[extension_cursor + 3]])
+                as usize;
+        let end = extension_cursor + 4 + extension_len;
+        if extension_type == 10 {
+            break extension_cursor..end;
+        }
+        extension_cursor = end;
+        assert!(extension_cursor < extensions_end);
+    };
+    let removed_len = named_groups_extension.len();
+    hello.drain(named_groups_extension);
+
+    let extensions_len = extensions_end - (extensions_len_offset + 2) - removed_len;
+    hello[extensions_len_offset..extensions_len_offset + 2]
+        .copy_from_slice(&(extensions_len as u16).to_be_bytes());
+    let handshake_len = hello.len() - 9;
+    hello[6] = (handshake_len >> 16) as u8;
+    hello[7] = (handshake_len >> 8) as u8;
+    hello[8] = handshake_len as u8;
+    let record_len = hello.len() - 5;
+    hello[3..5].copy_from_slice(&(record_len as u16).to_be_bytes());
+
+    let mut acceptor = Acceptor::default();
+    acceptor.read_tls(&mut hello.as_slice()).unwrap();
+    let accepted = acceptor.accept().unwrap().unwrap();
+    assert_eq!(accepted.client_hello().named_groups(), None);
+}
