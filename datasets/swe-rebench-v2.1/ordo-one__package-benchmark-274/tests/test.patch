+    func testInfluxExportIncludesCustomBenchmarkTags() throws {
+        let tags = ["size": "10", "scenario": "constrained"]
+        let benchmark = Benchmark("Influx tagged benchmark", configuration: .init(tags: tags)) { _ in }
+        let benchmarkName = try XCTUnwrap(benchmark?.name)
+
+        let statistics = Statistics()
+        statistics.add(100)
+        statistics.add(200)
+        let result = BenchmarkResult(metric: .cpuUser,
+                                     timeUnits: .nanoseconds,
+                                     scalingFactor: .one,
+                                     warmupIterations: 0,
+                                     statistics: statistics)
+        let baseline = InfluxFixtureBaseline(
+            baselineName: "default",
+            machine: InfluxFixtureMachine(hostname: "test host",
+                                          processors: 1,
+                                          processorType: "test cpu",
+                                          memory: 1,
+                                          kernelVersion: "test kernel"),
+            results: [InfluxFixtureIdentifier(target: "InfluxFixture", name: benchmarkName): [result]]
+        )
+
+        let packageRoot = URL(fileURLWithPath: FileManager.default.currentDirectoryPath)
+        let buildDirectory = packageRoot.appendingPathComponent(".build", isDirectory: true)
+        let buildConfigurations = try FileManager.default.contentsOfDirectory(
+            at: buildDirectory,
+            includingPropertiesForKeys: [.isDirectoryKey]
+        )
+        let toolCandidates = [buildDirectory.appendingPathComponent("debug/BenchmarkTool")] +
+            buildConfigurations.map { $0.appendingPathComponent("debug/BenchmarkTool") }
+        let toolURL = toolCandidates.first { FileManager.default.isExecutableFile(atPath: $0.path) }
+        let tool = try XCTUnwrap(toolURL, "BenchmarkTool must be built to exercise Influx export")
+
+        let temporaryDirectory = FileManager.default.temporaryDirectory
+            .appendingPathComponent("benchmark-influx-\(UUID().uuidString)", isDirectory: true)
+        defer { try? FileManager.default.removeItem(at: temporaryDirectory) }
+        let baselineDirectory = temporaryDirectory
+            .appendingPathComponent(".benchmarkBaselines/InfluxFixture/default", isDirectory: true)
+        try FileManager.default.createDirectory(at: baselineDirectory, withIntermediateDirectories: true)
+        let encodedBaseline = try JSONEncoder().encode(baseline)
+        try encodedBaseline.write(to: baselineDirectory.appendingPathComponent("results.json"))
+
+        let process = Process()
+        process.executableURL = tool
+        process.arguments = [
+            "--command", "baseline",
+            "--format", "influx",
+            "--baseline-storage-path", temporaryDirectory.path,
+            "--grouping", "benchmark",
+            "--targets", "InfluxFixture",
+            "--baseline", "default",
+            "--baseline-operation", "read",
+            "--path", "stdout"
+        ]
+        let output = Pipe()
+        process.standardOutput = output
+        process.standardError = FileHandle.nullDevice
+        try process.run()
+        let outputData = output.fileHandleForReading.readDataToEndOfFile()
+        process.waitUntilExit()
+        let exportedCSV = String(decoding: outputData, as: UTF8.self)
+
+        XCTAssertEqual(process.terminationStatus, 0, exportedCSV)
+        XCTAssertTrue(exportedCSV.contains("size"), exportedCSV)
+        XCTAssertTrue(exportedCSV.contains("10"), exportedCSV)
+        XCTAssertTrue(exportedCSV.contains("scenario"), exportedCSV)
+        XCTAssertTrue(exportedCSV.contains("constrained"), exportedCSV)
+    }
