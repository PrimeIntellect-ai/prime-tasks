index 4eb50f4..d4a89a5 100644
--- a/tests/test_pyproject_pep517.py
+++ b/tests/test_pyproject_pep517.py
@@ -4,6 +4,7 @@ import sys
 import tarfile
 import time
 import zipfile
+from email.parser import Parser
 from pathlib import Path
 
 import build.util
@@ -273,9 +274,31 @@ def test_prepare_metdata_for_build_wheel():
         "Requires-Python": ">=3.7",
         "Provides-Extra": "test",
         "Requires-Dist": 'pytest>=6.0; extra == "test"',
+        "License-File": "LICENSE",
     }
 
     for k, b in answer.items():
         assert metadata[k] == b
 
     assert len(metadata) == len(answer)
+
+
+@pytest.mark.compile()
+@pytest.mark.configure()
+@pytest.mark.usefixtures("package_simple_pyproject_ext")
+def test_pep517_wheel_license_file_metadata():
+    dist = Path("dist")
+    out = build_wheel("dist")
+    (wheel,) = dist.glob("cmake_example-0.0.1-*.whl")
+    assert wheel == dist / out
+
+    with wheel.open("rb") as f:
+        p = zipfile.Path(f)
+        metadata_text = p.joinpath("cmake_example-0.0.1.dist-info/METADATA").read_text()
+        metadata = Parser().parsestr(metadata_text)
+        license_file_names = [
+            Path(value).name for value in (metadata.get_all("License-File") or [])
+        ]
+        assert "LICENSE" in license_file_names
+        for name in license_file_names:
+            assert p.joinpath(f"cmake_example-0.0.1.dist-info/licenses/{name}").exists()
