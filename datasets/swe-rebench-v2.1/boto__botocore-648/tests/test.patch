+class TestServiceNameCaseSensitivity(BaseEnvVar):
+    def test_create_client_rejects_incorrectly_cased_service_name(self):
+        session = botocore.session.get_session()
+        with self.assertRaises(ValidationError):
+            session.create_client(
+                'S3', 'us-west-2',
+                aws_access_key_id='foo',
+                aws_secret_access_key='bar')
+
+    def test_create_client_accepts_canonical_lowercase_service_name(self):
+        session = botocore.session.get_session()
+        client = session.create_client(
+            's3', 'us-west-2',
+            aws_access_key_id='foo',
+            aws_secret_access_key='bar')
+        self.assertIsInstance(client, botocore.client.BaseClient)
