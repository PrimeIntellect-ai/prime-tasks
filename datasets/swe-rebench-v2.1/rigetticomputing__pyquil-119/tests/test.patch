@@ -549,6 +549,28 @@ def test_sum_equality():
         assert pauli_sum != 0
 
 
+def test_zero_term():
+    qubit_id = 0
+    coefficient = 10
+    ps = sI(qubit_id) + sX(qubit_id)
+    empty_sum = PauliSum([])
+
+    # Multiplying ZERO by a scalar or Pauli term has no effect when added.
+    assert coefficient * ZERO + ID == ID
+    assert ZERO * coefficient + ID == ID
+    assert ZERO * ID + ID == ID
+    assert ZERO * sX(qubit_id) + ID == ID
+    assert sX(qubit_id) * ZERO + ID == ID
+    # ZERO is an additive identity for terms and sums, including empty sums.
+    assert ZERO + ID == ID
+    assert ZERO + sX(qubit_id) == sX(qubit_id)
+    assert sX(qubit_id) + ZERO == sX(qubit_id)
+    assert ZERO + ps == ps
+    assert ps + ZERO == ps
+    assert ZERO + empty_sum == empty_sum
+    assert empty_sum + ZERO == empty_sum
+
+
 def test_from_list():
