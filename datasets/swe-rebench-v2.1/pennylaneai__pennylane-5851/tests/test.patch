+    def test_variance_of_sums_respects_all_terms_and_multiplicities(self):
+        """Variance measures the full summed observable, including repeated terms."""
+        dev = qml.device("default.qubit", wires=1)
+
+        @qml.qnode(dev)
+        def circuit():
+            qml.RX(np.pi / 3, 0)
+            qml.RZ(np.pi / 3, 0)
+            return qml.var(qml.Z(0) + qml.X(0)), qml.var(
+                qml.Z(0) + qml.X(0) + qml.Z(0) + qml.Z(0) + qml.Z(0)
+            )
+
+        variances = circuit()
+        assert qnp.allclose(variances, qnp.array([0.4375, 9.4375]))
