+    test('radixString roundTrip zero corner case', () {
+      final lv = LogicValue.ofBigInt(BigInt.from(0), 61);
+      for (final i in [2, 4, 8, 10, 16]) {
+        final unpadded = lv.toRadixString(radix: i);
+        final unpaddedDigits = unpadded
+            .replaceFirst(RegExp(r"^\d+'[bqodh]"), '')
+            .replaceAll('_', '');
+        expect(unpaddedDigits, equals('0'));
+        expect(LogicValue.ofRadixString(unpadded), equals(lv));
+        expect(
+            LogicValue.ofRadixString(
+                lv.toRadixString(radix: i, leadingZeros: true)),
+            equals(lv));
+      }
+    });
