+func Test_Simpleworker_DebugCompletionDoesNotPanic(t *testing.T) {
+	r := require.New(t)
+	w := worker.NewSimple()
+	completed := make(chan struct{})
+	var output bytes.Buffer
+	l := logrus.New()
+	l.SetLevel(logrus.DebugLevel)
+	l.SetOutput(&output)
+	w.Logger = l
+
+	r.NoError(w.Register("complete", func(worker.Args) error {
+		close(completed)
+		return nil
+	}))
+	r.NoError(w.Perform(worker.Job{
+		Handler: "complete",
+		Args:    worker.Args{"context": &DefaultContext{}},
+	}))
+	r.NoError(w.Stop())
+	select {
+	case <-completed:
+	default:
+		r.FailNow("worker did not complete the job")
+	}
+	r.NotContains(output.String(), "PANIC=String method")
+}
+
+func Test_Simpleworker_DebugPerformStartDoesNotPanic(t *testing.T) {
+	r := require.New(t)
+	w := worker.NewSimple()
+	var output bytes.Buffer
+	l := logrus.New()
+	l.SetLevel(logrus.DebugLevel)
+	l.SetOutput(&output)
+	w.Logger = l
+
+	_ = w.Perform(worker.Job{
+		Handler: "not-registered",
+		Args:    worker.Args{"context": &DefaultContext{}},
+	})
+	_ = w.Stop()
+	r.NotContains(output.String(), "PANIC=String method")
+}
