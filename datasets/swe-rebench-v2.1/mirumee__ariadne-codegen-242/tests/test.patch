+import ast
+import importlib
+
+import pytest
+from graphql import GraphQLSchema
+
+from ariadne_codegen.codegen import generate_import_from
+from ariadne_codegen.client_generators.arguments import ArgumentsGenerator
+from ariadne_codegen.client_generators.client import ClientGenerator
+from ariadne_codegen.client_generators.enums import EnumsGenerator
+from ariadne_codegen.client_generators.fragments import FragmentsGenerator
+from ariadne_codegen.client_generators.init_file import InitFileGenerator
+from ariadne_codegen.client_generators.input_types import InputTypesGenerator
+from ariadne_codegen.client_generators.package import PackageGenerator
+from ariadne_codegen.plugins.manager import PluginManager
+
+
+def _no_reimports_plugin():
+    return importlib.import_module(
+        "ariadne_codegen.contrib.no_reimports"
+    ).NoReimportsPlugin
+
+
+@pytest.mark.parametrize(
+    "module",
+    [
+        ast.Module(
+            body=[
+                ast.ImportFrom(
+                    module="input_types", names=[ast.alias(name="InputA")], level=1
+                ),
+                ast.Assign(
+                    targets=[ast.Name(id="__all__")],
+                    value=ast.List(elts=[ast.Constant(value="InputA")]),
+                ),
+            ],
+            type_ignores=[],
+        ),
+        ast.Module(body=[], type_ignores=[]),
+    ],
+)
+def test_generate_init_module_returns_module_without_body(module):
+    plugin = _no_reimports_plugin()(schema=None, config_dict={})
+
+    modified_module = plugin.generate_init_module(module)
+
+    assert isinstance(modified_module, ast.Module)
+    assert not modified_module.body
+
+
+def test_generated_client_submodule_is_importable_with_empty_package_initializer(
+    tmp_path, monkeypatch
+):
+    package_name = "generated_client"
+    schema = GraphQLSchema()
+    plugin_manager = PluginManager(schema=schema, plugins_types=[_no_reimports_plugin()])
+    generator = PackageGenerator(
+        package_name=package_name,
+        target_path=tmp_path.as_posix(),
+        schema=schema,
+        init_generator=InitFileGenerator(plugin_manager=plugin_manager),
+        client_generator=ClientGenerator(
+            base_client_import=generate_import_from(
+                names=["AsyncBaseClient"], from_="async_base_client", level=1
+            ),
+            arguments_generator=ArgumentsGenerator(
+                schema=schema, plugin_manager=plugin_manager
+            ),
+            plugin_manager=plugin_manager,
+        ),
+        enums_generator=EnumsGenerator(schema=schema, plugin_manager=plugin_manager),
+        input_types_generator=InputTypesGenerator(
+            schema=schema, plugin_manager=plugin_manager
+        ),
+        fragments_generator=FragmentsGenerator(
+            schema=schema, fragments_definitions={}, plugin_manager=plugin_manager
+        ),
+        plugin_manager=plugin_manager,
+    )
+
+    generator.generate()
+    monkeypatch.syspath_prepend(tmp_path.as_posix())
+    generated_client = importlib.import_module(f"{package_name}.client")
+
+    assert hasattr(generated_client, "Client")
