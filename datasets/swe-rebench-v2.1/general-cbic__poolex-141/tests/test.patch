+++ b/test/poolex_test.exs
@@ -284,6 +284,7 @@ defmodule PoolexTest do
       assert debug_info.idle_workers_count == 2
 
       # Busy worker should be restarted if caller dies
+      # NOTE: may be I should write a test using :do_some_work_with_delay
       refute Enum.any?(debug_info.idle_workers_pids, fn pid ->
                pid == busy_worker_pid
              end)
@@ -638,6 +639,50 @@ defmodule PoolexTest do
       assert %DebugInfo{idle_workers_count: 10} = Poolex.get_debug_info(pool_name)
     end
 
+    test "provides new workers to waiting callers", %{pool_options: pool_options} do
+      pool_name = pool_options |> Keyword.put(:workers_count, 1) |> start_pool()
+
+      test_process = self()
+
+      # Occupy the only worker so that the next caller has to wait.
+      spawn(fn ->
+        Poolex.run(pool_name, fn _pid ->
+          Process.send(test_process, :busy_worker_started, [])
+          :timer.sleep(:timer.seconds(5))
+        end)
+      end)
+
+      assert_receive :busy_worker_started, 1000
+
+      # This caller cannot be served yet and joins the waiting queue.
+      spawn(fn ->
+        Poolex.run(pool_name, fn _pid ->
+          Process.send(test_process, :waiting_caller_started, [])
+          :timer.sleep(:timer.seconds(5))
+        end)
+      end)
+
+      # Wait until the caller is actually queued instead of relying on a
+      # message sent before `Poolex.run/2` is entered.
+      assert wait_until(fn ->
+               Enum.count(Poolex.get_debug_info(pool_name).waiting_callers) == 1
+             end)
+
+      debug_info = Poolex.get_debug_info(pool_name)
+      assert debug_info.busy_workers_count == 1
+      assert debug_info.idle_workers_count == 0
+      refute_received :waiting_caller_started
+
+      assert :ok = Poolex.add_idle_workers!(pool_name, 1)
+
+      assert_receive :waiting_caller_started, 1000
+
+      debug_info = Poolex.get_debug_info(pool_name)
+      assert debug_info.busy_workers_count == 2
+      assert debug_info.idle_workers_count == 0
+      assert Enum.empty?(debug_info.waiting_callers)
+    end
+
     test "raises error on non positive workers_count", %{pool_options: pool_options} do
