@@ -0,0 +1,103 @@
+package org.opentripplanner.ext.transmodelapi.support;
+
+import static graphql.execution.ExecutionContextBuilder.newExecutionContextBuilder;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import graphql.ExecutionInput;
+import graphql.execution.ExecutionContext;
+import graphql.execution.ExecutionId;
+import graphql.schema.DataFetchingEnvironmentImpl;
+import graphql.schema.GraphQLObjectType;
+import graphql.schema.GraphQLSchema;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import org.opentripplanner._support.time.ZoneIds;
+import org.opentripplanner.ext.transmodelapi.TransmodelGraphQLSchema;
+import org.opentripplanner.ext.transmodelapi.model.stop.MonoOrMultiModalStation;
+import org.opentripplanner.framework.geometry.WgsCoordinate;
+import org.opentripplanner.framework.i18n.TranslatedString;
+import org.opentripplanner.routing.api.request.RouteRequest;
+import org.opentripplanner.transit.model.framework.FeedScopedId;
+import org.opentripplanner.transit.model.site.MultiModalStation;
+import org.opentripplanner.transit.model.site.RegularStop;
+
+class GqlUtilTest {
+
+  private static final ExecutionContext EXECUTION_CONTEXT;
+
+  private static final GraphQLSchema SCHEMA;
+
+  static {
+    var executionInput = ExecutionInput
+      .newExecutionInput()
+      .query("")
+      .locale(Locale.ENGLISH)
+      .build();
+
+    EXECUTION_CONTEXT = newExecutionContextBuilder()
+      .executionInput(executionInput)
+      .executionId(ExecutionId.from("TransmodelLanguageArgumentTest"))
+      .build();
+    SCHEMA = TransmodelGraphQLSchema.create(new RouteRequest(), new GqlUtil(ZoneIds.OSLO));
+  }
+
+  @Test
+  void stopPlaceAndQuayNameExposeReplacementAndDeprecateLegacyArgument() {
+    assertNameArguments("StopPlace");
+    assertNameArguments("Quay");
+  }
+
+  @Test
+  void languageArgumentSelectsTranslatedNamesForStopPlaceAndQuay() throws Exception {
+    var translations = TranslatedString.getI18NString("Default name", "fr", "French name");
+    var multimodalStation = MultiModalStation
+      .of(new FeedScopedId("F", "stop-place"))
+      .withName(translations)
+      .withChildStations(List.of())
+      .withCoordinate(new WgsCoordinate(50, 10))
+      .build();
+    var stopPlaceSource = new MonoOrMultiModalStation(multimodalStation);
+    var quaySource = RegularStop
+      .of(new FeedScopedId("F", "quay"))
+      .withName(translations)
+      .withCoordinate(50, 10)
+      .build();
+
+    assertEquals(
+      "French name",
+      resolveName("StopPlace", stopPlaceSource, Map.of("language", "fr"))
+    );
+    assertEquals("French name", resolveName("StopPlace", stopPlaceSource, Map.of("lang", "fr")));
+    assertEquals("French name", resolveName("Quay", quaySource, Map.of("language", "fr")));
+    assertEquals("French name", resolveName("Quay", quaySource, Map.of("lang", "fr")));
+  }
+
+  private static void assertNameArguments(String typeName) {
+    var nameField = SCHEMA.getObjectType(typeName).getFieldDefinition("name");
+    var legacyLanguage = nameField.getArgument("lang");
+    assertNotNull(legacyLanguage, typeName);
+    assertTrue(legacyLanguage.isDeprecated(), typeName);
+    assertNotNull(nameField.getArgument("language"), typeName);
+  }
+
+  private static String resolveName(
+    String typeName,
+    Object source,
+    Map<String, Object> arguments
+  ) throws Exception {
+    GraphQLObjectType objectType = SCHEMA.getObjectType(typeName);
+    var nameField = objectType.getFieldDefinition("name");
+    var dataFetcher = SCHEMA.getCodeRegistry().getDataFetcher(objectType, nameField);
+    var environment = DataFetchingEnvironmentImpl
+      .newDataFetchingEnvironment(EXECUTION_CONTEXT)
+      .source(source)
+      .locale(Locale.ENGLISH)
+      .arguments(arguments)
+      .build();
+    return (String) dataFetcher.get(environment);
+  }
+}
