+func setZapLevel(t *testing.T, logger *ZapLogger, methodName string, level zapcore.Level) {
+	t.Helper()
+	method := reflect.ValueOf(logger).MethodByName(methodName)
+	require.True(t, method.IsValid(), "ZapLogger must expose %s", methodName)
+	method.Call([]reflect.Value{reflect.ValueOf(level)})
 }
