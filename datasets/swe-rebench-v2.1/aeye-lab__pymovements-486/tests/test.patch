+def test_save_preprocessed_csv_unnests_columns(dataset_configuration):
+    dataset = pm.Dataset(**dataset_configuration['init_kwargs'])
+    dataset.load()
+    dataset.pix2deg()
+    dataset.pos2vel()
+    dataset.pos2acc()
+
+    preprocessed_dirname = 'preprocessed-csv-columns-test'
+    shutil.rmtree(dataset.path / preprocessed_dirname, ignore_errors=True)
+    dataset.save_preprocessed(preprocessed_dirname, extension='csv')
+
+    saved_csv = next((dataset.path / preprocessed_dirname).rglob('*.csv'))
+    saved_frame = pl.read_csv(saved_csv)
+    expected_gaze = dataset.gaze[0].copy()
+    for column in ('pixel', 'position', 'velocity', 'acceleration'):
+        if column in expected_gaze.frame.columns:
+            expected_gaze.unnest(column)
+    expected_columns = (
+        set(expected_gaze.frame.columns) - set(dataset.fileinfo.columns)
+    )
+
+    assert expected_columns <= set(saved_frame.columns)
+    assert not {'pixel', 'position', 'velocity', 'acceleration'} & set(saved_frame.columns)
+
+
+@pytest.mark.parametrize(
+    'drop_column',
+    [
+        'time',
+        'pixel',
+        'position',
+        'velocity',
+        'acceleration',
+    ],
+)
+def test_save_preprocessed_has_no_side_effect(dataset_configuration, drop_column):
+    dataset = pm.Dataset(**dataset_configuration['init_kwargs'])
+    dataset.load()
+    dataset.pix2deg()
+    dataset.pos2vel()
+    dataset.pos2acc()
+
+    dataset.gaze[0].frame = dataset.gaze[0].frame.drop(drop_column)
+
+    old_frame = dataset.gaze[0].frame.clone()
+
+    preprocessed_dirname = 'preprocessed-test'
+    shutil.rmtree(dataset.path / Path(preprocessed_dirname), ignore_errors=True)
+    shutil.rmtree(dataset.path / Path(preprocessed_dirname), ignore_errors=True)
+    dataset.save_preprocessed(preprocessed_dirname, extension='csv')
+
+    new_frame = dataset.gaze[0].frame.clone()
+
+    assert_frame_equal(old_frame, new_frame)
+
+
