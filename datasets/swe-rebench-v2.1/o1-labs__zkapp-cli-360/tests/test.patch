+jest.mock('child_process', () => ({
+  execSync: jest.fn((cmd, opts) => {
+    if (typeof cmd === 'string' && cmd.includes('npm list')) {
+      return JSON.stringify({
+        dependencies: { 'zkapp-cli': { version: '0.6.2' } },
+      });
+    }
+    return jest.requireActual('child_process').execSync(cmd, opts);
+  }),
+}));
+
+const { chooseSmartContract, deploy } = require('./deploy');
+
+// Runs `deploy()` against a throwaway project directory containing the given
+// config.json. The deploy alias intentionally has no `url`, so `deploy()`
+// returns early (before any build/network work) once it has resolved the alias.
+async function deployWithConfig(config) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'zkapp-cli-test-'));
+  fs.writeJsonSync(path.join(dir, 'package.json'), { name: 'test-project' });
+  fs.writeJsonSync(path.join(dir, 'config.json'), config);
+  const originalCwd = process.cwd();
+  process.chdir(dir);
+  try {
+    return await deploy({ alias: 'mainnet', yes: true });
+  } finally {
+    process.chdir(originalCwd);
+    fs.removeSync(dir);
+  }
+}
 
