+def test_custom_security_scheme_name(app, client):
+    token_auth = HTTPTokenAuth(
+        header='X-API-Key', security_scheme_name='myToken'
+    )
+    other_token_auth = HTTPTokenAuth(
+        header='X-Other-Key', security_scheme_name='otherToken'
+    )
+
+    @app.get('/bar')
+    @app.auth_required(token_auth)
+    def bar():
+        pass
+
+    @app.get('/other')
+    @app.auth_required(other_token_auth)
+    def other():
+        pass
+
+    rv = client.get('/openapi.json')
+    assert rv.status_code == 200
+    validate_spec(rv.json)
+    schemes = rv.json['components']['securitySchemes']
+    assert 'myToken' in schemes
+    assert schemes['myToken'] == {
+        'type': 'apiKey',
+        'name': 'X-API-Key',
+        'in': 'header'
+    }
+    assert 'otherToken' in schemes
+    assert schemes['otherToken'] == {
+        'type': 'apiKey',
+        'name': 'X-Other-Key',
+        'in': 'header'
+    }
+    assert 'ApiKeyAuth' not in schemes
+    assert 'myToken' in rv.json['paths']['/bar']['get']['security'][0]
+    assert 'otherToken' in rv.json['paths']['/other']['get']['security'][0]
+
+
+def test_custom_security_schemes_mapping_no_generic_apikey(app, client):
+    app.security_schemes = {
+        'api_token': {
+            'type': 'apiKey',
+            'name': 'X-API-Key',
+            'in': 'header'
+        }
+    }
+    token_auth = HTTPTokenAuth(
+        header='X-API-Key', security_scheme_name='myToken'
+    )
+
+    @app.get('/bar')
+    @app.auth_required(token_auth)
+    def bar():
+        pass
+
+    rv = client.get('/openapi.json')
+    assert rv.status_code == 200
+    validate_spec(rv.json)
+    schemes = rv.json['components']['securitySchemes']
+    assert 'api_token' in schemes
+    assert 'myToken' in schemes
+    assert 'ApiKeyAuth' not in schemes
+    assert 'myToken' in rv.json['paths']['/bar']['get']['security'][0]
+
+
