+    def test_reset_index(self):
+        r = self._repo
+        with open(os.path.join(r.path, 'a'), 'wb') as f:
+            f.write(b'changed')
+        with open(os.path.join(r.path, 'b'), 'wb') as f:
+            f.write(b'added')
+        r.stage(['a', 'b'])
+        status = list(porcelain.status(self._repo))
+        self.assertEqual([{'add': [b'b'], 'delete': [], 'modify': [b'a']}, [], []], status)
+        r.reset_index()
+        # The index is reset to the committed tree, so the staged changes
+        # (the added file 'b' and the modification to 'a') are gone. The
+        # working tree is left untouched, so the modification to 'a' may
+        # still show up as an unstaged change.
+        self.assertNotIn(b'b', r.open_index())
+        status = list(porcelain.status(self._repo))
+        self.assertEqual({'add': [], 'delete': [], 'modify': []}, status[0])
