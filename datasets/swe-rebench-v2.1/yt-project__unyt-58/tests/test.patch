+def test_array_multiplication_simplifies():
+    import unyt as u
+
+    # The issue's example: Hz * s should reduce to a dimensionless quantity.
+    q = (1 * u.Hz) * (1 * u.s)
+    assert q.units.dimensions == 1
+    assert "Hz" not in str(q.units)
+    assert_almost_equal(q.in_units("dimensionless").value, 1)
+
+    # Numeric scale factors may be represented in either the value or unit.
+    q = (1 * u.kHz) * (1 * u.s)
+    assert q.units.dimensions == 1
+    assert_almost_equal(q.in_units("dimensionless").value, 1000)
+
+    # Compatible factors cancel, leaving a result convertible to the
+    # uncanceled unit, regardless of where a numeric coefficient is stored.
+    q = (1 * u.kHz) * (1 * u.s) * (1 * u.km)
+    assert q.units.dimensions == u.km.dimensions
+    assert_almost_equal(q.in_units("km").value, 1000)
+
+    # Quotients are simplified as well.
+    q = (1 * u.km) / (1 * u.m)
+    assert q.units.dimensions == 1
+    assert_almost_equal(q.in_units("dimensionless").value, 1000)
+
+    q = (1 * u.m ** 2) / (1 * u.cm)
+    assert q.units.dimensions == u.m.dimensions
+    assert_almost_equal(q.in_units("m").value, 100)
