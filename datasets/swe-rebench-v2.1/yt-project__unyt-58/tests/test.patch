+def test_simplify():
+    import unyt as u
+
+    # The contract fixes this exact representation.
+    assert str((u.kHz * u.s ** 2 * u.km).simplify()) == "1000*km*s"
+
+    # simplify() cancels compatible factors and factors out a dimensionless
+    # coefficient.  The string form of the coefficient is not fixed by the
+    # contract, so check the resulting dimensions and coefficient instead.
+    cases = [
+        (u.Hz * u.s, 1, 1),
+        (u.kg / u.g, 1, 1000),
+        (u.m ** 2 / u.cm ** 2, 1, 10000),
+        (u.kHz * u.s, 1, 1000),
+        (u.Hz * u.s * u.km, u.km.dimensions, 1),
+        (u.kHz * u.s * u.km, u.km.dimensions, 1000),
+        (u.kHz * u.s ** 2, u.s.dimensions, 1000),
+    ]
+    for unit, dims, coeff in cases:
+        simplified = unit.simplify()
+        assert isinstance(simplified, u.Unit)
+        assert simplified.dimensions == dims
+        c, rest = simplified.as_coeff_unit()
+        assert isinstance(c, float)
+        assert isinstance(rest, u.Unit)
+        assert c == coeff
+        assert rest.dimensions == dims
