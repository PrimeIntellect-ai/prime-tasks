+describe('package manifest', () => {
+  it('does not declare any dependency using the npm alias protocol', () => {
+    const pkg = require('../../package.json');
+    const dependencyGroups = [
+      pkg.dependencies,
+      pkg.devDependencies,
+      pkg.optionalDependencies,
+      pkg.peerDependencies,
+    ].filter(Boolean);
+    const aliasedDependencies = dependencyGroups
+      .reduce((acc, group) => acc.concat(Object.entries(group)), [])
+      .filter(([, version]) => typeof version === 'string' && version.startsWith('npm:'));
+
+    expect(aliasedDependencies).toEqual([]);
+  });
+});
