+    def test_update_model_current_function_parameter(self):
+        # a current function defined by a parameter must follow updated values
+        def process(model):
+            geometry = model.default_geometry
+            param = model.default_parameter_values
+            param.process_model(model)
+            param.process_geometry(geometry)
+            mesh = pybamm.Mesh(
+                geometry, model.default_submesh_types, model.default_var_pts
+            )
+            disc = pybamm.Discretisation(mesh, model.default_spatial_methods)
+            disc.process_model(model)
+            return disc
+
+        # default current function
+        model1 = pybamm.ReactionDiffusionModel()
+        disc1 = process(model1)
+        parameter_values_update = pybamm.ParameterValues(
+            base_parameters=model1.default_parameter_values,
+            optional_parameters={"Typical current [A]": 2},
+        )
+        parameter_values_update.update_model(model1, disc1)
+        self.assertEqual(model1.variables["Current [A]"].evaluate(t=0), 2)
+
+        # current function whose value is given by a parameter
+        model2 = pybamm.ReactionDiffusionModel()
+        disc2 = process(model2)
+        parameter_values_update = pybamm.ParameterValues(
+            base_parameters=model2.default_parameter_values,
+            optional_parameters={
+                "Current function": pybamm.GetConstantCurrent(
+                    current=pybamm.Parameter("Test current [A]")
+                ),
+                "Test current [A]": 3,
+            },
+        )
+        parameter_values_update.update_model(model2, disc2)
+        self.assertEqual(model2.variables["Current [A]"].evaluate(t=0), 3)
+
