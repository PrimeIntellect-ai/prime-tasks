diff --git a/src/FormSpy.test.js b/src/FormSpy.test.js
index 31f2c94..3de467d 100644
--- a/src/FormSpy.test.js
+++ b/src/FormSpy.test.js
@@ -202,4 +202,150 @@ describe('FormSpy', () => {
     const button = TestUtils.findRenderedDOMComponentWithTag(dom, 'button')
     TestUtils.Simulate.click(button)
   })
+
+  it('should call onChange', () => {
+    const input = jest.fn(({ input }) => <input {...input} />)
+    const onChange = jest.fn()
+    TestUtils.renderIntoDocument(
+      <Form onSubmit={onSubmitMock}>
+        {() => (
+          <form>
+            <FormSpy subscription={{ dirty: true }} onChange={onChange} />
+            <Field name="foo" render={input} />
+          </form>
+        )}
+      </Form>
+    )
+    expect(input).toHaveBeenCalled()
+    expect(onChange).toHaveBeenCalled()
+    expect(onChange).toHaveBeenCalledTimes(1)
+    expect(onChange).toHaveBeenCalledWith({ dirty: false })
+
+    input.mock.calls[0][0].input.onChange('bar')
+
+    expect(onChange).toHaveBeenCalledTimes(2)
+    expect(onChange).toHaveBeenCalledWith({ dirty: true })
+  })
+
+  it('should not render with render prop when given onChange', () => {
+    const onChange = jest.fn()
+    const render = jest.fn()
+    const dom = TestUtils.renderIntoDocument(
+      <Form onSubmit={onSubmitMock}>
+        {() => (
+          <form>
+            <FormSpy
+              subscription={{ dirty: true }}
+              onChange={onChange}
+              render={render}
+            />
+          </form>
+        )}
+      </Form>
+    )
+    const form = TestUtils.findRenderedDOMComponentWithTag(dom, 'form')
+    expect(form.children.length).toBe(0)
+    expect(onChange).toHaveBeenCalled()
+    expect(onChange).toHaveBeenCalledTimes(1)
+    expect(render).not.toHaveBeenCalled()
+  })
+
+  it('should not render with child render prop when given onChange', () => {
+    const onChange = jest.fn()
+    const render = jest.fn()
+    TestUtils.renderIntoDocument(
+      <Form onSubmit={onSubmitMock}>
+        {() => (
+          <form>
+            <FormSpy subscription={{ dirty: true }} onChange={onChange}>
+              {render}
+            </FormSpy>
+          </form>
+        )}
+      </Form>
+    )
+    expect(onChange).toHaveBeenCalled()
+    expect(onChange).toHaveBeenCalledTimes(1)
+    expect(render).not.toHaveBeenCalled()
+  })
+
+  it('should not render with component prop when given onChange', () => {
+    const onChange = jest.fn()
+    const render = jest.fn()
+    TestUtils.renderIntoDocument(
+      <Form onSubmit={onSubmitMock}>
+        {() => (
+          <form>
+            <FormSpy
+              subscription={{ dirty: true }}
+              onChange={onChange}
+              component={render}
+            />
+          </form>
+        )}
+      </Form>
+    )
+    expect(onChange).toHaveBeenCalled()
+    expect(onChange).toHaveBeenCalledTimes(1)
+    expect(render).not.toHaveBeenCalled()
+  })
+
+  it('should not call onChange when parent rerenders', () => {
+    const onChange = jest.fn()
+    class Container extends React.Component {
+      state = { count: 0 }
+
+      render() {
+        return (
+          <Form onSubmit={onSubmitMock}>
+            {() => (
+              <form>
+                <FormSpy
+                  subscription={{ dirty: true }}
+                  onChange={onChange}
+                  foo={this.state.count}
+                />
+                <button
+                  type="button"
+                  onClick={() => this.setState({ count: this.state.count + 1 })}
+                >
+                  Rerender
+                </button>
+              </form>
+            )}
+          </Form>
+        )
+      }
+    }
+    const dom = TestUtils.renderIntoDocument(<Container />)
+    expect(onChange).toHaveBeenCalled()
+    expect(onChange).toHaveBeenCalledTimes(1)
+
+    const button = TestUtils.findRenderedDOMComponentWithTag(dom, 'button')
+    TestUtils.Simulate.click(button)
+
+    expect(onChange).toHaveBeenCalledTimes(1)
+  })
+
+  it('should not call onChange for changes outside its subscription', () => {
+    const input = jest.fn(({ input }) => <input {...input} />)
+    const onChange = jest.fn()
+    TestUtils.renderIntoDocument(
+      <Form onSubmit={onSubmitMock}>
+        {() => (
+          <form>
+            <FormSpy subscription={{ dirty: true }} onChange={onChange} />
+            <Field name="foo" render={input} />
+          </form>
+        )}
+      </Form>
+    )
+
+    input.mock.calls[0][0].input.onChange('bar')
+    expect(onChange).toHaveBeenCalledTimes(2)
+    expect(onChange).toHaveBeenLastCalledWith({ dirty: true })
+
+    input.mock.calls[input.mock.calls.length - 1][0].input.onChange('baz')
+    expect(onChange).toHaveBeenCalledTimes(2)
+  })
 })
