+func TestMarkdownOutputWithLineEndings(t *testing.T) {
+	tests := []struct {
+		name string
+		path string
+	}{
+		{
+			name: "lf",
+			path: "inputs-lf",
+		},
+		{
+			name: "crlf",
+			path: "inputs-crlf",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			command := exec.Command("go", "run", "../../main.go",
+				"--no-outputs", "--no-requirements", "--no-providers", "md",
+				filepath.Join("testdata", tt.path))
+			output, err := command.CombinedOutput()
+			assert.NoError(t, err, string(output))
+			assert.Contains(t, string(output), "The quick brown fox jumps<br>over the lazy dog")
+		})
+	}
+}
