+
+// TestNewRegistryClientWithSettings verifies that a Registry client can be
+// constructed from explicit connection settings.
+func TestNewRegistryClientWithSettings(t *testing.T) {
+	ctx := context.Background()
+
+	settings, err := connection.ActiveSettings()
+	if err != nil {
+		t.Fatalf("ActiveSettings: %v", err)
+	}
+	client, err := connection.NewRegistryClientWithSettings(ctx, settings)
+	if err != nil {
+		t.Fatalf("NewRegistryClientWithSettings: %v", err)
+	}
+	defer client.Close()
+
+	// Settings without an address cannot be used to build a client.
+	if _, err := connection.NewRegistryClientWithSettings(ctx, connection.Settings{}); err == nil {
+		t.Errorf("NewRegistryClientWithSettings with settings without an address: got nil error, want error")
+	}
+}
