+func Test_BuildImage_CopyExtraNestedFile(t *testing.T) {
+	workDir, err := ioutil.TempDir("", "openfaas-build-context-")
+	if err != nil {
+		t.Fatalf("Error creating working directory\n%v", err)
+	}
+	defer os.RemoveAll(workDir)
+
+	oldWd, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Error reading working directory\n%v", err)
+	}
+	if err := os.Chdir(workDir); err != nil {
+		t.Fatalf("Error changing working directory\n%v", err)
+	}
+	defer os.Chdir(oldWd)
+
+	// a language template so that the build context can be created
+	if err := os.MkdirAll("template/dockerfile", 0755); err != nil {
+		t.Fatalf("Error creating template folder\n%v", err)
+	}
+	if err := ioutil.WriteFile("template/dockerfile/template.yml", []byte("language: dockerfile\n"), 0644); err != nil {
+		t.Fatalf("Error creating template file\n%v", err)
+	}
+
+	// the function handler
+	if err := os.MkdirAll("myfunc", 0755); err != nil {
+		t.Fatalf("Error creating handler folder\n%v", err)
+	}
+	if err := ioutil.WriteFile("myfunc/handler.py", []byte("print('hi')"), 0644); err != nil {
+		t.Fatalf("Error creating handler file\n%v", err)
+	}
+
+	// a nested extra file to be copied into the build context
+	extraData := []byte("model-data")
+	if err := os.MkdirAll("models", 0755); err != nil {
+		t.Fatalf("Error creating extra folder\n%v", err)
+	}
+	if err := ioutil.WriteFile("models/Prices-RF-v1.0.0.pkl", extraData, 0644); err != nil {
+		t.Fatalf("Error creating extra file\n%v", err)
+	}
+
+	err = BuildImage("myimage:latest", "myfunc", "myfunc", "dockerfile", false, false, true, nil, nil, schema.DefaultFormat, nil, true, []string{"./models/Prices-RF-v1.0.0.pkl"})
+	if err != nil {
+		t.Fatalf("Unexpected build error\n%v", err)
+	}
+
+	dest := filepath.Join("build", "myfunc", "models", "Prices-RF-v1.0.0.pkl")
+	got, err := ioutil.ReadFile(dest)
+	if err != nil {
+		t.Fatalf("Expected copied extra file at %s\n%v", dest, err)
+	}
+	if string(got) != string(extraData) {
+		t.Fatalf("Copied extra file content mismatch: got %q want %q", got, extraData)
+	}
+}
