+    def test_draw_again_and_serialize_after_idle_wires_omitted(self):
+        """Omitting idle wires leaves the circuit usable for drawing and QPY."""
+        qr = QuantumRegister(3, "qr")
+        cr = ClassicalRegister(3, "cr")
+        circuit = QuantumCircuit(qr, cr)
+        circuit.h(qr[1])
+        circuit.measure(qr[1], cr[1])
+
+        serialized = BytesIO()
+        qpy.dump(circuit, serialized)
+        serialized.seek(0)
+        circuit = qpy.load(serialized)[0]
+
+        circuit.draw(idle_wires=False)
+        circuit.draw(idle_wires=False)
+
+        serialized = BytesIO()
+        qpy.dump(circuit, serialized)
+        serialized.seek(0)
+        restored = qpy.load(serialized)[0]
+        self.assertIsInstance(restored, QuantumCircuit)
+        self.assertEqual(restored.find_bit(restored.data[0].qubits[0]).index, 1)
+        self.assertEqual(restored.find_bit(restored.data[1].qubits[0]).index, 1)
+        self.assertEqual(restored.find_bit(restored.data[1].clbits[0]).index, 1)
+
 
