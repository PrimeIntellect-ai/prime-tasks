+    public function testCreateFromPreviousExport(): void
+    {
+        $timetable = OpeningHours::create([
+            'monday' => ['09:00-12:00', '13:00-18:00'],
+            'tuesday' => ['09:00-12:00', '13:00-18:00'],
+            'wednesday' => ['09:00-12:00'],
+            'thursday' => ['09:00-12:00', '13:00-18:00'],
+            'friday' => ['09:00-12:00', '13:00-20:00'],
+            'saturday' => ['09:00-12:00', '13:00-16:00'],
+            'sunday' => [],
+            'exceptions' => [
+                '2016-11-11' => ['09:00-12:00'],
+                '2016-12-25' => [],
+                '01-01' => [],                // Recurring on each 1st of January
+                '12-25' => ['09:00-12:00'],   // Recurring on each 25th of December
+            ],
+        ]);
+
+        $array = $timetable->asStructuredData();
+        $newOpeningHours = OpeningHours::createFromStructuredData($array);
+
+        foreach ([
+            '2023-11-20 08:59' => false,
+            '2023-11-20 09:00' => true,
+            '2023-11-20 12:30' => false,
+            '2023-11-20 13:00' => true,
+            '2023-11-20 18:00' => false,
+            '2023-11-21 10:00' => true,
+            '2023-11-22 10:00' => true,
+            '2023-11-22 13:00' => false,
+            '2023-11-23 10:00' => true,
+            '2023-11-24 19:00' => true,
+            '2023-11-24 20:00' => false,
+            '2023-11-25 15:00' => true,
+            '2023-11-26 10:00' => false,
+            '2016-11-11 10:00' => true,
+            '2016-11-11 14:00' => false,
+            '2016-12-25 10:00' => false,
+            '2023-01-01 10:00' => false,
+            '2024-01-01 10:00' => false,
+            '2023-12-25 10:00' => true,
+            '2023-12-25 14:00' => false,
+        ] as $dateTime => $expectedOpen) {
+            self::assertSame(
+                $expectedOpen,
+                $newOpeningHours->isOpenAt(new DateTimeImmutable($dateTime)),
+                $dateTime,
+            );
+        }
+    }
+
