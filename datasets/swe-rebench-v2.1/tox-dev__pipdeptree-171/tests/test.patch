+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+def test_guess_version_setuptools(tmp_path):
+    env = os.environ.copy()
+    env["PYTHONUSERBASE"] = str(tmp_path)
+    user_site = subprocess.check_output(
+        [sys.executable, "-c", "import site; print(site.getusersitepackages())"],
+        env=env,
+        text=True,
+    ).strip()
+    site_path = Path(user_site)
+    package = site_path / "setuptools"
+    package.mkdir(parents=True)
+    # Model the reported failure: setuptools cannot be imported once pip has been imported.
+    (package / "__init__.py").write_text(
+        "import sys\n"
+        "if 'pip' in sys.modules:\n"
+        "    raise AssertionError('distutils failure')\n"
+    )
+    distribution = site_path / "sample_root-1.0.dist-info"
+    distribution.mkdir()
+    (distribution / "METADATA").write_text(
+        "Metadata-Version: 2.1\nName: sample-root\nVersion: 1.0\n"
+        "Requires-Dist: setuptools\n"
+    )
+
+    pythonpath = [user_site]
+    if env.get("PYTHONPATH"):
+        pythonpath.append(env["PYTHONPATH"])
+    env["PYTHONPATH"] = os.pathsep.join(pythonpath)
+    result = subprocess.run(
+        [sys.executable, "-m", "pipdeptree", "-u"],
+        env=env,
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 0, result.stderr
