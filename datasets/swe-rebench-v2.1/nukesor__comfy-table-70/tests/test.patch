+#[test]
+fn styled_text_only_table() {
+    let mut table = alignment_regression_table();
+    table.force_no_tty().enforce_styling().style_text_only();
+    let styled = table.to_string();
+
+    let mut plain_table = alignment_regression_table();
+    plain_table.force_no_tty();
+    let plain = plain_table.to_string();
+
+    // The ANSI styling must not alter the visible column layout.
+    let unstyled_rendering = strip_ansi(&styled);
+    assert_eq!(unstyled_rendering, plain);
+
+    // Styled heading content remains styled in its cell.
+    let heading_line = styled
+        .lines()
+        .find(|line| strip_ansi(line).contains("A heading"))
+        .expect("the rendered heading should be present");
+    let heading_cell = heading_line
+        .split('│')
+        .find(|cell| strip_ansi(cell).contains("A heading"))
+        .expect("the heading should be inside a table cell");
+    let text_start = heading_cell.find("A heading").unwrap();
+    let text_end = text_start + "A heading".len();
+    assert!(heading_cell[..text_start].contains('\u{1b}'));
+    assert!(heading_cell[text_end..].contains('\u{1b}'));
+
+    // Alignment padding must remain outside of the styled text.
+    assert_padding_unstyled(&styled);
+}
+
+fn alignment_regression_table() -> Table {
+    let mut table = Table::new();
+    table.load_preset(UTF8_FULL).set_header(vec![
+        Cell::new("A heading").add_attribute(Attribute::Bold),
+        Cell::new("Column 1").add_attribute(Attribute::Bold),
+        Cell::new("A slightly longer heading").add_attribute(Attribute::Bold),
+    ]);
+    for i in 0..5 {
+        let row: Vec<_> = (0..3)
+            .map(|j| format!("Row {} col {}", i, j))
+            .collect();
+        table.add_row(row);
+    }
+    table
+}
+
+/// Remove all ANSI escape sequences (e.g. `\u{1b}[1m`) from a string.
+fn strip_ansi(input: &str) -> String {
+    let mut result = String::new();
+    let mut chars = input.chars().peekable();
+    while let Some(c) = chars.next() {
+        if c == '\u{1b}' {
+            // Consume the CSI sequence up to and including its terminating letter.
+            if chars.peek() == Some(&'[') {
+                chars.next();
+                for next in chars.by_ref() {
+                    if next.is_ascii_alphabetic() {
+                        break;
+                    }
+                }
+            }
+        } else {
+            result.push(c);
+        }
+    }
+    result
+}
+
+/// Assert that the trailing padding of every cell is not wrapped in an ANSI style.
+///
+/// The contract only requires the visible text to be styled; whitespace used for
+/// alignment must stay unstyled. This accepts implementations that style each
+/// non-whitespace run separately as well as those that style a whole line.
+fn assert_padding_unstyled(styled: &str) {
+    for line in styled.lines() {
+        for segment in line.split(['│', '┆']) {
+            if let Some(start) = segment.rfind('\u{1b}') {
+                let rest = &segment[start..];
+                let end = rest
+                    .char_indices()
+                    .find(|(_, c)| c.is_ascii_alphabetic())
+                    .map(|(i, c)| i + c.len_utf8())
+                    .unwrap_or(rest.len());
+                let trailing = &rest[end..];
+                assert!(
+                    !trailing.is_empty() && trailing.chars().all(|c| c == ' '),
+                    "padding after the last style must be unstyled, got: {segment:?}"
+                );
+            }
+        }
+    }
+}
