diff --git a/test/parse_stream.jl b/test/parse_stream.jl
index f7c0bd6..2ef3693 100644
--- a/test/parse_stream.jl
+++ b/test/parse_stream.jl
@@ -147,3 +147,24 @@ end
     @test first_child_position(st, position(st)) == ParseStreamPosition(4, 1)
     @test last_child_position(st, position(st)) == ParseStreamPosition(7, 2)
 end
+
+@testset "SubString of a non-String string type (issue #505)" begin
+    x = Test.GenericString("1 2")
+    @test x == "1 2"
+    y = split(x)[1]
+    @test y == "1"
+    @test y isa SubString{GenericString}
+    JuliaSyntax.enable_in_core!()
+    try
+        # Parsing must succeed directly, not by failing internally and falling
+        # back to the reference parser, so no error-level log may be emitted.
+        logger = Test.TestLogger()
+        parsed = Base.CoreLogging.with_logger(logger) do
+            Meta.parse(y)
+        end
+        @test parsed == Meta.parse("1")
+        @test !any(l -> l.level >= Base.CoreLogging.Error, logger.logs)
+    finally
+        JuliaSyntax.enable_in_core!(false)
+    end
+end
