+// TestMarshalUsesCanonicalJSON verifies that the canonical JSON encoding used
+// when signing metadata is the one provided by
+// github.com/secure-systems-lab/go-securesystemslib/cjson.
+func TestMarshalUsesCanonicalJSON(t *testing.T) {
+	v := map[string]interface{}{"a": json.Number("123")}
+	want := []byte(`{"a":123}`)
+	s, err := sign.Marshal(v)
+	if err != nil {
+		t.Fatalf("sign.Marshal: %v", err)
+	}
+	if string(s.Signed) != string(want) {
+		t.Fatalf("sign.Marshal produced %s, want %s", s.Signed, want)
+	}
+}
