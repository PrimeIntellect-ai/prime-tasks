+func TestVerifyRejectsUncanonicalizableJSONNumber(t *testing.T) {
+	key, err := keys.GenerateEd25519Key()
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyID := key.PublicData().IDs()[0]
+
+	// This payload's number cannot be represented as canonical JSON. The
+	// attached signature matches the legacy encoder's interpretation.
+	signature, err := key.SignMessage([]byte(`{"a":-9223372036854775808}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	signed := &data.Signed{
+		Signed: json.RawMessage(`{"a":1e20}`),
+		Signatures: []data.Signature{{
+			KeyID:     keyID,
+			Signature: signature,
+		}},
+	}
+
+	db := verify.NewDB()
+	if err := db.AddKey(keyID, key.PublicData()); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AddRole("root", &data.Role{KeyIDs: []string{keyID}, Threshold: 1}); err != nil {
+		t.Fatal(err)
+	}
+	err = db.VerifySignatures(signed, "root")
+	if err == nil {
+		t.Fatal("expected canonical verification to reject an uncanonicalizable number")
+	}
+}
+
+func TestCanonicalJSONEncoderProvider(t *testing.T) {
+	foundCanonicalCall := false
+	foundArchivedImport := false
+	err := filepath.Walk(".", func(path string, info os.FileInfo, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if info.IsDir() {
+			if path != "." && (strings.HasPrefix(filepath.Base(path), ".") || filepath.Base(path) == "vendor") {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if !strings.HasSuffix(path, ".go") || strings.HasSuffix(path, "_test.go") {
+			return nil
+		}
+		file, err := parser.ParseFile(token.NewFileSet(), path, nil, 0)
+		if err != nil {
+			return err
+		}
+		aliases := make(map[string]string)
+		for _, spec := range file.Imports {
+			importPath, err := strconv.Unquote(spec.Path.Value)
+			if err != nil {
+				return err
+			}
+			if importPath == "github.com/tent/canonical-json-go" {
+				foundArchivedImport = true
+			}
+			if importPath == "github.com/secure-systems-lab/go-securesystemslib/cjson" {
+				name := filepath.Base(importPath)
+				if spec.Name != nil {
+					name = spec.Name.Name
+				}
+				aliases[name] = importPath
+			}
+		}
+		ast.Inspect(file, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			selector, ok := call.Fun.(*ast.SelectorExpr)
+			if !ok || selector.Sel.Name != "EncodeCanonical" {
+				return true
+			}
+			qualifier, ok := selector.X.(*ast.Ident)
+			if ok && aliases[qualifier.Name] == "github.com/secure-systems-lab/go-securesystemslib/cjson" {
+				foundCanonicalCall = true
+			}
+			return true
+		})
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("inspect production Go files: %v", err)
+	}
+	if foundArchivedImport {
+		t.Fatal("production code still imports the archived canonical JSON encoder")
+	}
+	if !foundCanonicalCall {
+		t.Fatal("production code does not call go-securesystemslib/cjson.EncodeCanonical")
+	}
+}
