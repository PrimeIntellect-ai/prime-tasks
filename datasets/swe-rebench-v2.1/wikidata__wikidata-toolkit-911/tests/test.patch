+    @Test
+    public void testAbuseFilterError() throws IOException, MediaWikiApiErrorException {
+        JsonNode root;
+        URL path = this.getClass().getResource("/error-spam-filter.json");
+        root = mapper.readTree(path.openStream());
+        try {
+            connection.checkErrors(root);
+            fail("Expected a MediaWikiApiErrorException");
+        } catch(MediaWikiApiErrorException e) {
+            List<MediaWikiErrorMessage> messages = e.getDetailedMessages();
+            assertEquals(2, messages.size());
+            Map<String, String> textByName = new HashMap<>();
+            for (MediaWikiErrorMessage message : messages) {
+                textByName.put(message.getName(), message.getHTMLText());
+            }
+            assertEquals("The save has failed.", textByName.get("wikibase-api-failed-save"));
+            assertEquals("The text you wanted to publish was blocked by the spam filter.",
+                    textByName.get("spam-blacklisted-link"));
+        }
+    }
+
