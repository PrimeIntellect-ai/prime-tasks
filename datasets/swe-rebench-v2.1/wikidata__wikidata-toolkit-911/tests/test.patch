+import static org.junit.Assert.*;
+
+import java.beans.Introspector;
+import java.beans.PropertyDescriptor;
+import org.junit.Test;
+
+public class MediaWikiErrorMessageTest {
+
+    @Test
+    public void testPublicConstructorAndAccessors() {
+        MediaWikiErrorMessage message = new MediaWikiErrorMessage("some-error", "<b>Details</b>");
+
+        assertEquals("some-error", message.getName());
+        assertEquals("<b>Details</b>", message.getHTMLText());
+    }
+
+    @Test
+    public void testPropertiesCannotBeChangedThroughPublicBeanSetters() throws Exception {
+        for (PropertyDescriptor property : Introspector.getBeanInfo(MediaWikiErrorMessage.class)
+                .getPropertyDescriptors()) {
+            assertNull("Property should be read-only: " + property.getName(), property.getWriteMethod());
+        }
+    }
+}
