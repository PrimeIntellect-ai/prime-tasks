+describe('package entrypoints', () => {
+	function createPackage(manifest: Record<string, any>): tmp.DirResult {
+		const dir = tmp.dirSync({ unsafeCleanup: true });
+		fs.writeFileSync(path.join(dir.name, 'package.json'), JSON.stringify({
+			name: 'test',
+			publisher: 'mocha',
+			version: '0.0.1',
+			description: 'test extension',
+			engines: { vscode: '*' },
+			...((manifest.main || manifest.browser) ? { activationEvents: [] } : {}),
+			...manifest,
+		}));
+		return dir;
+	}
+
+	it('should reject a declared entrypoint missing from the package', async () => {
+		for (const entrypoint of ['main', 'browser']) {
+			const entrypointPath = `${entrypoint}.js`;
+			const dir = createPackage({ [entrypoint]: entrypointPath });
+			try {
+				let message = '';
+				try {
+					await pack({ cwd: dir.name, dependencies: false, packagePath: path.join(dir.name, 'out.vsix') });
+				} catch (err: any) {
+					message = err.message;
+				}
+				assert.ok(message.includes('entrypoint(s) missing'), message);
+				assert.ok(message.includes(entrypointPath), message);
+			} finally {
+				dir.removeCallback();
+			}
+		}
+	});
+
+	it('should package when declared entrypoints are included', async () => {
+		for (const entrypoint of ['main', 'browser']) {
+			const entrypointPath = `${entrypoint}.js`;
+			const dir = createPackage({ [entrypoint]: entrypointPath });
+			try {
+				fs.writeFileSync(path.join(dir.name, entrypointPath), '');
+				const result = await pack({ cwd: dir.name, dependencies: false, packagePath: path.join(dir.name, 'out.vsix') });
+				assert.ok(result.files.some(file => file.path === `extension/${entrypointPath}`));
+			} finally {
+				dir.removeCallback();
+			}
+		}
+	});
+
+	it('should package successfully when no entrypoints are declared', async () => {
+		const dir = createPackage({});
+		try {
+			const result = await pack({ cwd: dir.name, dependencies: false, packagePath: path.join(dir.name, 'out.vsix') });
+			assert.ok(fs.existsSync(result.packagePath));
+		} finally {
+			dir.removeCallback();
+		}
+	});
+});
