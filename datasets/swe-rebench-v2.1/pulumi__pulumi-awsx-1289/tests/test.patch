diff --git a/awsx/ecs/fargateMemoryAndCpu.test.ts b/awsx/ecs/fargateMemoryAndCpu.test.ts
index c1cf2b1..6605fc0 100644
--- a/awsx/ecs/fargateMemoryAndCpu.test.ts
+++ b/awsx/ecs/fargateMemoryAndCpu.test.ts
@@ -48,4 +48,84 @@ describe("max vcpu and memory", () => {
     expect(memCpu.cpu).toEqual("8192");
     expect(memCpu.memory).toEqual("21504");
   });
+
+  it("accepts maximum cumulative requests and allocates enough resources for every container", async () => {
+    const containers = [
+      {
+        cpu: (maxVCPU * 1024) / 2,
+        memory: (maxMemGB * 1024) / 2,
+      },
+      {
+        cpu: (maxVCPU * 1024) / 2,
+        memory: (maxMemGB * 1024) / 2,
+      },
+    ];
+    const task = calculateFargateMemoryAndCPU(containers);
+    const taskCPU = Number(task.cpu);
+    const taskMemory = Number(task.memory);
+
+    expect(taskCPU).toBeGreaterThanOrEqual(containers.reduce((total, container) => total + container.cpu, 0));
+    expect(taskMemory).toBeGreaterThanOrEqual(containers.reduce((total, container) => total + container.memory, 0));
+    for (const container of containers) {
+      expect(taskCPU).toBeGreaterThanOrEqual(container.cpu);
+      expect(taskMemory).toBeGreaterThanOrEqual(container.memory);
+    }
+  });
+  it("allocates enough resources for a mixed workload of several containers", async () => {
+    const containers = [
+      {
+        cpu: 1024, // 1 vcpu
+        memory: 8 * 1024, // 8 GB
+      },
+      {
+        cpu: 3072, // 3 vcpu
+        memory: 32 * 1024, // 32 GB
+      },
+    ];
+    const task = calculateFargateMemoryAndCPU(containers);
+    const taskCPU = Number(task.cpu);
+    const taskMemory = Number(task.memory);
+
+    expect(taskCPU).toBeGreaterThanOrEqual(containers.reduce((total, container) => total + container.cpu, 0));
+    expect(taskMemory).toBeGreaterThanOrEqual(containers.reduce((total, container) => total + container.memory, 0));
+    for (const container of containers) {
+      expect(taskCPU).toBeGreaterThanOrEqual(container.cpu);
+      expect(taskMemory).toBeGreaterThanOrEqual(container.memory);
+    }
+  });
+
+  it("throws error if containers request more resources than fargate allows", async () => {
+    expect(() => {
+      calculateFargateMemoryAndCPU([
+        {
+          cpu: 16 * 1024,
+          memory: 120 * 1024,
+        },
+        {
+          cpu: 16 * 1024,
+          memory: 120 * 1024,
+        },
+      ]);
+    }).toThrowError();
+  });
+  it("throws error if containers request more CPU than fargate allows", async () => {
+    expect(() => {
+      calculateFargateMemoryAndCPU([
+        {
+          cpu: (maxVCPU + 1) * 1024,
+          memory: maxMemGB * 1024,
+        },
+      ]);
+    }).toThrowError();
+  });
+  it("throws error if containers requests more memory than fargate allows", async () => {
+    expect(() => {
+      calculateFargateMemoryAndCPU([
+        {
+          cpu: maxVCPU * 1024,
+          memory: (maxMemGB + 1) * 1024,
+        },
+      ]);
+    }).toThrowError();
+  });
 });
