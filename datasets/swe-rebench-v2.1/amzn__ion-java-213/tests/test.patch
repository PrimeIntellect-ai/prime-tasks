+    @Test
+    public void testMillisIsIndepedentOfOffset() throws ParseException {
+        DateFormat format = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ssZ");
+        Date date = format.parse("2010-06-29T23:20:00+0000");
+
+        Calendar cal1 = Calendar.getInstance();
+        cal1.setTimeZone(TimeZone.getTimeZone("GMT+00:00"));
+        cal1.setTime(date);
+        Timestamp t1 = Timestamp.forCalendar(cal1);
+
+        Calendar cal2 = Calendar.getInstance();
+        cal2.setTimeZone(TimeZone.getTimeZone("GMT+02:00"));
+        cal2.setTime(date);
+        Timestamp t2 = Timestamp.forCalendar(cal2);
+
+        // A time zone that observes daylight saving time; in June this is EDT (UTC-04:00).
+        Calendar cal3 = Calendar.getInstance();
+        cal3.setTimeZone(TimeZone.getTimeZone("America/New_York"));
+        cal3.setTime(date);
+        Timestamp t3 = Timestamp.forCalendar(cal3);
+
+        // getMillis() must return the same instant regardless of the Calendar's offset from UTC.
+        assertEquals(date.getTime(), t1.getMillis());
+        assertEquals(date.getTime(), t2.getMillis());
+        assertEquals(date.getTime(), t3.getMillis());
+
+        assertEquals(t1.getMillis(), t2.getMillis());
+        assertEquals(t1.getMillis(), t3.getMillis());
+    }
+
