diff --git a/test/grammar/left_recursion_test.py b/test/grammar/left_recursion_test.py
index 0dced21..53735c7 100644
--- a/test/grammar/left_recursion_test.py
+++ b/test/grammar/left_recursion_test.py
@@ -309,3 +309,68 @@ class LeftRecursionTests(unittest.TestCase):
 
         ast = model.parse('foo, bar', trace=trace, colorize=True)
         self.assertEqual(['foo', ',', 'bar'], ast)
+
+    def test_change_start_rule(self, trace=False):
+        grammar = '''
+            start = expr ;
+        
+            expr 
+                = 
+                mul | identifier 
+                ;
+                
+            mul 
+                = 
+                expr '*' identifier 
+                ;
+                
+            identifier 
+                = 
+                /\w+/ 
+                ;
+        '''
+        model = compile(grammar)
+
+        ast = model.parse('a * b', start='expr', trace=trace, colorize=True)
+        self.assertEqual(['a', '*', 'b'], ast)
+
+        # The `start` argument selects the entry point for the parse.  For
+        # this grammar the left-recursive `mul` rule cannot be used as an
+        # entry point (the choice-containing rule must be invoked first), so
+        # parsing from `mul` must fail cleanly.
+        try:
+            model.parse('a * b', start='mul', trace=trace, colorize=True)
+            self.fail('failure expected as first recursive rule does not contain a choice')
+        except FailedParse:
+            pass
+
+        # Input that cannot be derived from the selected start rule must
+        # raise FailedParse.
+        with self.assertRaises(FailedParse):
+            model.parse('*', start='identifier', trace=trace, colorize=True)
+
+        # Changing the start rule must not be affected by memoization of
+        # left-recursive results.
+        grammar = '''
+            identifier = /\w+/ ;
+            expr = mul | tmp ;
+            mul = expr '*' tmp ;
+            tmp = call | identifier ;
+            call = identifier '(' ','.{expr} ')' ;
+        '''
+        model = compile(grammar)
+        ast = model.parse('a(b, c)', start='expr', trace=trace, colorize=True)
+        self.assertEqual(['a', '(', ['b', 'c'], ')'], ast)
+
+    def test_with_gather(self, trace=False):
+        grammar = '''
+            identifier = /\w+/ ;
+            expr = mul | tmp ;
+            mul = expr '*' tmp ;
+            tmp = call | identifier ;
+            call = identifier '(' ','.{expr} ')' ;
+        '''
+        model = compile(grammar)
+
+        ast = model.parse('a(b, c)', start='expr', trace=trace, colorize=True)
+        self.assertEqual(['a', '(', ['b', 'c'], ')'], ast)
