+    def test_binary_energy_usage_response(self) -> None:
+        """Each format setting selects its corresponding parsed measurements."""
+        responses = [
+            (bytes.fromhex(
+                "aa20ac00000000000203c121014400564a02640000000014ae0000000000041a22"),
+             (5650.02, 1514.0, 0), (565504.2, 135526.4, 0.0)),
+            (bytes.fromhex(
+                "aa1fac00000000000303c12101440006792000000000000000000123459b65"),
+             (679.2, 0, 1234.5), (42422.4, 0.0, 7456.5)),
+        ]
+
+        async def refresh_with_response(device, response):
+            async def send(_lan, _data, retries=3):
+                return [response]
+
+            with patch("msmart.lan.LAN.send", new=send):
+                await device.refresh()
+
+        for response, bcd_readings, binary_readings in responses:
+            for alternate, expected in ((False, bcd_readings), (True, binary_readings)):
+                device = AC(0, 0, 0)
+                device.enable_energy_usage_requests = True
+                device.use_alternate_energy_format = alternate
+                asyncio.run(refresh_with_response(device, response))
+                readings = (device.total_energy_usage,
+                            device.current_energy_usage,
+                            device.real_time_power_usage)
+                self.assertEqual(readings, expected)
+
+    def test_use_alternate_energy_format(self) -> None:
+        """Test the use_alternate_energy_format property reflects the set value."""
+        device = AC(0, 0, 0)
+
+        # Defaults to the legacy BCD format
+        self.assertFalse(device.use_alternate_energy_format)
+
+        # Enabling the alternate (binary) format is reflected by the getter
+        device.use_alternate_energy_format = True
+        self.assertTrue(device.use_alternate_energy_format)
+
+        # Disabling it is reflected by the getter
+        device.use_alternate_energy_format = False
+        self.assertFalse(device.use_alternate_energy_format)
+
