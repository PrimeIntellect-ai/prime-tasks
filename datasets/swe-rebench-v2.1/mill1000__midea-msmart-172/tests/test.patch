+    def test_binary_energy_usage_readings(self) -> None:
+        """Binary measurements reflect the unsigned big-endian payload values."""
+        energy_response = Response.construct(bytes.fromhex(
+            "aa20ac00000000000203c121014400564a02640000000014ae0000000000041a22"))
+        power_response = Response.construct(bytes.fromhex(
+            "aa1fac00000000000303c12101440006792000000000000000000123459b65"))
+
+        self.assertIsInstance(energy_response, EnergyUsageResponse)
+        self.assertIsInstance(power_response, EnergyUsageResponse)
+        self.assertEqual(energy_response.total_energy_binary, 565504.2)
+        self.assertEqual(energy_response.current_energy_binary, 135526.4)
+        self.assertEqual(power_response.real_time_power_binary, 7456.5)
+
