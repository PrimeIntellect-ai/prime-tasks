+async function expectTypedProjectConfigured(eslint: ESLint, filePath: string) {
+	const config = await eslint.calculateConfigForFile(filePath);
+	const parserOptions = config?.languageOptions?.parserOptions as
+		| { programs?: unknown; project?: unknown; projectService?: unknown }
+		| undefined;
+
+	expect(
+		Boolean(
+			parserOptions?.projectService ||
+				parserOptions?.project ||
+				parserOptions?.programs,
+		),
+	).toBe(true);
+}
+
+async function expectGeneratedConfigToSupportTypedProjects(options: Options) {
+	const directory = await mkdtemp(join(process.cwd(), ".tmp-eslint-project-"));
+
+	try {
+		await writeFile(
+			join(directory, "eslint.config.js"),
+			await createESLintConfig(options),
+		);
+		await writeFile(
+			join(directory, "tsconfig.json"),
+			JSON.stringify({
+				compilerOptions: { strict: true },
+				include: ["**/*.ts"],
+			}),
+		);
+		await writeFile(
+			join(directory, "example.ts"),
+			'const message: string = "ok";\n',
+		);
+
+		const eslint = new ESLint({ cwd: directory });
+
+		await expectTypedProjectConfigured(eslint, "example.ts");
+	} finally {
+		await rm(directory, { force: true, recursive: true });
+	}
+}
