+describe("typescript-eslint lockfile dependency", () => {
+	it("resolves typescript-eslint major version 8", async () => {
+		type LockedDependency = { specifier: string; version: string };
+		type Lockfile = {
+			importers: {
+				".": { devDependencies?: Record<string, LockedDependency> };
+			};
+		};
+
+		const [lockfileText, packageText] = await Promise.all([
+			readFile(new URL("../../../../pnpm-lock.yaml", import.meta.url), "utf8"),
+			readFile(new URL("../../../../package.json", import.meta.url), "utf8"),
+		]);
+		const lockfile = jsYaml.load(lockfileText) as Lockfile;
+		const packageData = JSON.parse(packageText) as {
+			devDependencies: Record<string, string>;
+		};
+		const lockedDependency =
+			lockfile.importers["."]?.devDependencies?.["typescript-eslint"];
+
+		expect(lockedDependency).toBeDefined();
+		expect(lockedDependency?.specifier).toBe(
+			packageData.devDependencies["typescript-eslint"],
+		);
+		expect(lockedDependency?.version).toMatch(/^8(?:\.|$)/);
