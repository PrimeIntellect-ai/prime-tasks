+
+func Test_Create_Timestamps_With_NowFunc(t *testing.T) {
+	if PDB == nil {
+		t.Skip("skipping integration tests")
+	}
+	transaction(func(tx *Connection) {
+		r := require.New(t)
+
+		// restore the default time source once the test is done
+		defer SetNowFunc(time.Now)
+
+		fakeNow, err := time.Parse(time.RFC3339, "2019-07-14T00:00:00Z")
+		r.NoError(err)
+		SetNowFunc(func() time.Time { return fakeNow })
+
+		friend := Friend{FirstName: "Yester", LastName: "Day"}
+		err = tx.Create(&friend)
+		r.NoError(err)
+
+		r.Equal(fakeNow, friend.CreatedAt)
+		r.Equal(fakeNow, friend.UpdatedAt)
+
+		updatedNow, err := time.Parse(time.RFC3339, "2020-08-15T12:34:56Z")
+		r.NoError(err)
+		SetNowFunc(func() time.Time { return updatedNow })
+		friend.FirstName = "Today"
+		err = tx.Update(&friend)
+		r.NoError(err)
+		r.Equal(updatedNow, friend.UpdatedAt)
+	})
+}
