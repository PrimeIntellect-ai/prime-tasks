+#[cfg(test)]
+mod scan_summary_tests {
+    use super::*;
+    use zcash_client_backend::data_api::AccountBirthday;
+    use zcash_primitives::zip32::ExtendedSpendingKey;
+
+    /// Scanning a block that contains no transactions relevant to the wallet reports an
+    /// empty change set, so that a caller can skip updating the UI.
+    #[test]
+    fn scan_cached_blocks_reports_spent_note_without_receiving_one() {
+        let mut st = TestBuilder::new()
+            .with_block_cache()
+            .with_test_account(AccountBirthday::from_sapling_activation)
+            .build();
+        let dfvk = st.test_account_sapling().unwrap();
+        let value = NonNegativeAmount::from_u64(5).unwrap();
+
+        let (received_height, _, nf) =
+            st.generate_next_block(&dfvk, AddressType::DefaultExternal, value.into());
+        let received = st.scan_cached_blocks(received_height, 1);
+        assert_eq!(received.received_sapling_note_count(), 1);
+
+        let outsider_dfvk = ExtendedSpendingKey::master(&[2]).to_diversifiable_full_viewing_key();
+        let outsider = outsider_dfvk.default_address().1;
+        let spent_value = NonNegativeAmount::from_u64(2).unwrap();
+        let (spent_height, _) = st.generate_next_block_spending(
+            &outsider_dfvk,
+            (nf, value.into()),
+            outsider,
+            spent_value.into(),
+        );
+
+        let spent = st.scan_cached_blocks(spent_height, 1);
+        assert_eq!(spent.scanned_range(), spent_height..spent_height + 1);
+        assert_eq!(spent.spent_sapling_note_count(), 1);
+        assert_eq!(spent.received_sapling_note_count(), 0);
+    }
+
+    #[test]
+    fn scan_cached_blocks_reports_no_changes() {
+        let mut st = TestBuilder::new()
+            .with_block_cache()
+            .with_test_account(AccountBirthday::from_sapling_activation)
+            .build();
+
+        // A viewing key that does not belong to the wallet.
+        let other_dfvk = ExtendedSpendingKey::master(&[1]).to_diversifiable_full_viewing_key();
+
+        let value = NonNegativeAmount::from_u64(5).unwrap();
+        let (h, _, _) =
+            st.generate_next_block(&other_dfvk, AddressType::DefaultExternal, value.into());
+
+        let summary = st.scan_cached_blocks(h, 1);
+        assert_eq!(summary.scanned_range().start, h);
+        assert_eq!(summary.scanned_range().end, h + 1);
+        assert_eq!(summary.received_sapling_note_count(), 0);
+    }
+}
