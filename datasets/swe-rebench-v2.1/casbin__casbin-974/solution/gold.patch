+func (rm *RoleManager) GetAllDomains() ([]string, error) {
+	var domains []string
+	rm.allDomains.Range(func(key, value interface{}) bool {
+		domains = append(domains, key.(string))
+		return true
+	})
+	return domains, nil
+}
