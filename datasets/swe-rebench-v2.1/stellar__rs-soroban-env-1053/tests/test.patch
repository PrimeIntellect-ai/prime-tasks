+// Returns a copy of `wasm` with the interface version in its environment
+// metadata section replaced by `interface_version`.
+fn wasm_with_interface_version(wasm: &[u8], interface_version: u64) -> Vec<u8> {
+    let name = crate::meta::ENV_META_V0_SECTION_NAME.as_bytes();
+    let name_pos = wasm
+        .windows(name.len())
+        .position(|w| w == name)
+        .expect("wasm is missing the environment metadata section");
+    // The section payload is the XDR encoding of `ScEnvMetaEntry`: a 4-byte
+    // union discriminant followed by the 8-byte interface version.
+    let version_pos = name_pos + name.len() + 4;
+    let mut patched = wasm.to_vec();
+    patched[version_pos..version_pos + 8].copy_from_slice(&interface_version.to_be_bytes());
+    patched
+}
+
+#[test]
+fn upload_contract_wasm_rejects_mismatched_pre_release() {
+    let host = Host::test_host_with_recording_footprint();
+    let proto = crate::meta::get_ledger_protocol_version(crate::meta::INTERFACE_VERSION) as u64;
+    let pre = crate::meta::get_pre_release_version(crate::meta::INTERFACE_VERSION) as u64;
+
+    // A contract built for the current protocol but a different pre-release
+    // number must be rejected at upload time, before it is ever invoked.
+    let mismatched = wasm_with_interface_version(ADD_I32, (proto << 32) | (pre + 1));
+    let res = host.invoke_function(HostFunction::UploadContractWasm(
+        mismatched.as_slice().try_into().unwrap(),
+    ));
+    assert!(res.is_err());
+
+    // A contract with the matching pre-release number still uploads fine.
+    let matching = wasm_with_interface_version(ADD_I32, (proto << 32) | pre);
+    let res = host.invoke_function(HostFunction::UploadContractWasm(
+        matching.as_slice().try_into().unwrap(),
+    ));
+    assert!(res.is_ok());
+}
+
+#[test]
+fn get_ledger_protocol_version_extracts_high_bits() {
+    // The ledger protocol version is the high 32 bits of the interface version.
+    assert_eq!(
+        crate::meta::get_ledger_protocol_version((5u64 << 32) | 3),
+        5
+    );
 }
 
