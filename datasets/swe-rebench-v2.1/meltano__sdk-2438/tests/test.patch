diff --git a/tests/core/test_state_handling.py b/tests/core/test_state_handling.py
index 3f4fff1..ef0563f 100644
--- a/tests/core/test_state_handling.py
+++ b/tests/core/test_state_handling.py
@@ -127,3 +127,42 @@ def test_irresumable_state():
             "replication_key_value": "2021-05-17T20:41:16Z",
         },
     }
+
+
+def test_null_replication_value():
+    stream_state = {
+        "replication_key": "updated_at",
+        "replication_key_value": "2021-05-17T20:41:16Z",
+    }
+    latest_record = {"updated_at": None}
+    replication_key = "updated_at"
+    is_sorted = True
+    check_sorted = False
+
+    _state.increment_state(
+        stream_state,
+        latest_record=latest_record,
+        replication_key=replication_key,
+        is_sorted=is_sorted,
+        check_sorted=check_sorted,
+    )
+
+    assert stream_state == {
+        "replication_key": "updated_at",
+        "replication_key_value": "2021-05-17T20:41:16Z",
+    }
+
+
+def test_null_replication_value_without_checkpoint():
+    stream_state = {}
+    latest_record = {"updated_at": None}
+
+    _state.increment_state(
+        stream_state,
+        latest_record=latest_record,
+        replication_key="updated_at",
+        is_sorted=True,
+        check_sorted=False,
+    )
+
+    assert stream_state == {}
