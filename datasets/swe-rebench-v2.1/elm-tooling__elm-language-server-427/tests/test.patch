+module Test exposing (..)
+
+func : Int -> Int
+func =
+    let
+        go n =
+            if n == 1 then
+                2
+
+            else
+                func n + 1
+    in
+    go
+
+
+func2 =
+    let
+        go n =
+            if n == 1 then
+                "text"
