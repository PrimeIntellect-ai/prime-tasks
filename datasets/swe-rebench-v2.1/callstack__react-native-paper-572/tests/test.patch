+/* @flow */
+
+import * as React from 'react';
+import { StyleSheet } from 'react-native';
+import renderer from 'react-test-renderer';
+import Caption from '../../Typography/Caption';
+
+const renderCaption = element => renderer.create(element).toJSON();
+
+const collectText = node => {
+  if (node == null) {
+    return '';
+  }
+  if (typeof node === 'string') {
+    return node;
+  }
+  if (Array.isArray(node)) {
+    return node.map(collectText).join('');
+  }
+  return collectText(node.children);
+};
+
+it('renders caption with children as content inside a Text element', () => {
+  const tree = renderCaption(<Caption>Caption content</Caption>);
+
+  expect(tree.type).toBe('Text');
+  expect(collectText(tree)).toContain('Caption content');
+});
+
+it('renders caption with the default caption style', () => {
+  const tree = renderCaption(<Caption>Caption content</Caption>);
+  const style = StyleSheet.flatten(tree.props.style);
+
+  expect(style.fontSize).toBe(12);
+  expect(style.lineHeight).toBe(20);
+  expect(style.marginVertical).toBe(2);
+});
+
+it('renders caption applying an object style that overrides the default', () => {
+  const tree = renderCaption(
+    <Caption style={{ fontSize: 20, color: 'red' }}>Big and red caption</Caption>
+  );
+  const style = StyleSheet.flatten(tree.props.style);
+
+  expect(style.fontSize).toBe(20);
+  expect(style.color).toBe('red');
+});
+
+it('renders caption applying an array style that overrides the default', () => {
+  const tree = renderCaption(
+    <Caption style={[{ fontSize: 20 }, { color: 'red' }]}>
+      Big and red caption
+    </Caption>
+  );
+  const style = StyleSheet.flatten(tree.props.style);
+
+  expect(style.fontSize).toBe(20);
+  expect(style.color).toBe('red');
+});
+
+it('renders caption applying a StyleSheet style that overrides the default', () => {
+  const styles = StyleSheet.create({
+    custom: { fontSize: 20, color: 'red' },
+  });
+  const tree = renderCaption(
+    <Caption style={styles.custom}>Big and red caption</Caption>
+  );
+  const style = StyleSheet.flatten(tree.props.style);
+
+  expect(style.fontSize).toBe(20);
+  expect(style.color).toBe('red');
+});
