+
+describe('integration with MessengerConnector', () => {
+  it('should not throw when updating a session read multiple times', async () => {
+    const mockClient = { getUserProfile: jest.fn() };
+    mockClient.getUserProfile.mockResolvedValue({
+      id: 'user',
+      profile_pic: 'https://example.com/pic.png?oe=386D4380', // expired
+    });
+
+    const connector = new MessengerConnector({
+      client: mockClient,
+      appSecret: 'FAKE_SECRET',
+    });
+    const store = new CacheBasedSessionStore(new MemoryCacheStore(5), 5);
+
+    const body = {
+      object: 'page',
+      entry: [
+        {
+          id: 'page',
+          time: 1,
+          messaging: [
+            {
+              sender: { id: 'user' },
+              recipient: { id: 'page' },
+              timestamp: 1,
+              message: { mid: 'mid', seq: 1, text: 'hi' },
+            },
+          ],
+        },
+      ],
+    };
+
+    await store.write('messenger:user', {
+      user: {
+        id: 'user',
+        profile_pic: 'https://example.com/pic.png?oe=386D4380', // expired
+      },
+    });
+
+    // Two concurrent readers of the same session key must not share the
+    // same object, otherwise freezing `user` for one reader makes the
+    // other reader throw "Cannot assign to read only property 'user'".
+    const session1 = await store.read('messenger:user');
+    const session2 = await store.read('messenger:user');
+
+    await connector.updateSession(session1, body);
+
+    await expect(
+      connector.updateSession(session2, body)
+    ).resolves.not.toThrow();
+  });
+});
