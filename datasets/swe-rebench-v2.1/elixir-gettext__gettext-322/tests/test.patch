+  describe "reference comments in extracted POT files" do
+    test "omits line numbers when `write_reference_line_numbers` is `false`" do
+      contents = extracted_pot(write_reference_line_numbers: false)
+
+      assert Enum.count(
+               String.split(contents, "\n"),
+               &String.starts_with?(&1, "#: path/to/file.ex")
+             ) == 2
+
+      refute contents =~ "#: path/to/file.ex:12"
+    end
+
+    test "omits all references when `write_reference_comments` is `false`" do
+      contents = extracted_pot(write_reference_comments: false)
+
+      refute contents =~ "#: path/to/file.ex"
+    end
+
+    test "omits all references when both reference options are `false`" do
+      contents =
+        extracted_pot(
+          write_reference_comments: false,
+          write_reference_line_numbers: false
+        )
+
+      refute contents =~ "#: path/to/file.ex"
+    end
+
+    test "includes line numbers by default" do
+      contents = extracted_pot([])
+
+      assert Enum.count(
+               String.split(contents, "\n"),
+               &String.starts_with?(&1, "#: path/to/file.ex:12")
+             ) == 2
+    end
+  end
