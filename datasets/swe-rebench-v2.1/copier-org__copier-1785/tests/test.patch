diff --git a/tests/test_recopy.py b/tests/test_recopy.py
index 80a6731..c05fa8c 100644
--- a/tests/test_recopy.py
+++ b/tests/test_recopy.py
@@ -1,4 +1,5 @@
 from pathlib import Path
+from textwrap import dedent
 
 import pytest
 import yaml
@@ -98,3 +99,47 @@ def test_recopy_with_skip_answered_and_new_answer(
     run_recopy(dst, data={"boolean": "true"}, skip_answered=True, overwrite=True)
     answers = yaml.safe_load(answers_file.read_text())
     assert answers["boolean"] is True
+
+
+def test_recopy_dont_validate_computed_value(
+    tmp_path_factory: pytest.TempPathFactory,
+) -> None:
+    src, dst = map(tmp_path_factory.mktemp, ("src", "dst"))
+    build_file_tree(
+        {
+            src / "copier.yml": dedent(
+                """\
+                computed:
+                    type: str
+                    default: foo
+                    when: false
+                    validator: "{% if computed == 'foo' %}This validator should never be rendered{% endif %}"
+                """
+            ),
+            src / "{{ _copier_conf.answers_file }}.jinja": (
+                "{{ _copier_answers|to_nice_yaml }}"
+            ),
+        }
+    )
+    git_save(src)
+
+    # Prepare a destination using a value accepted by the validator.
+    run_copy(str(src), dst, data={"computed": "bar"}, defaults=True, overwrite=True)
+    git_save(dst)
+
+    # Copying with the default (rejected) value...
+    copy_dst = tmp_path_factory.mktemp("copy_dst")
+    copy_raised = False
+    try:
+        run_copy(str(src), copy_dst, defaults=True, overwrite=True)
+    except Exception:
+        copy_raised = True
+
+    # ...and recopying with the default (rejected) value must behave consistently.
+    recopy_raised = False
+    try:
+        run_recopy(dst, overwrite=True)
+    except Exception:
+        recopy_raised = True
+
+    assert copy_raised == recopy_raised
diff --git a/tests/test_updatediff.py b/tests/test_updatediff.py
index 73774e4..7e500f0 100644
--- a/tests/test_updatediff.py
+++ b/tests/test_updatediff.py
@@ -25,6 +25,7 @@ from .helpers import (
     build_file_tree,
     git,
     git_init,
+    git_save,
 )
 
 
@@ -1612,3 +1613,103 @@ def test_update_with_skip_answered_and_new_answer(
     run_update(dst, data={"boolean": "true"}, skip_answered=True, overwrite=True)
     answers = yaml.safe_load(answers_file.read_text())
     assert answers["boolean"] is True
+
+
+def test_update_dont_validate_computed_value(
+    tmp_path_factory: pytest.TempPathFactory,
+) -> None:
+    src, dst = map(tmp_path_factory.mktemp, ("src", "dst"))
+
+    def write_template(validator: str | None) -> None:
+        validator_line = f"    validator: {validator!r}\n" if validator else ""
+        build_file_tree(
+            {
+                src / "copier.yml": (
+                    "computed:\n"
+                    "    type: str\n"
+                    "    default: foo\n"
+                    "    when: false\n" + validator_line
+                ),
+                src / "{{ _copier_conf.answers_file }}.jinja": (
+                    "{{ _copier_answers|to_nice_yaml }}"
+                ),
+            }
+        )
+
+    # Prepare a destination from a template without a validator.
+    write_template(None)
+    git_save(src, tag="v1")
+    run_copy(str(src), dst, overwrite=True)
+    git_save(dst)
+
+    # Add a validator that rejects the computed value.
+    write_template("This validator should never be rendered")
+    git_save(src, tag="v2")
+
+    # Copying with the validator...
+    copy_dst = tmp_path_factory.mktemp("copy_dst")
+    copy_raised = False
+    try:
+        run_copy(str(src), copy_dst, overwrite=True)
+    except Exception:
+        copy_raised = True
+
+    # ...and updating with the validator must behave consistently.
+    update_raised = False
+    try:
+        run_update(dst, overwrite=True)
+    except Exception:
+        update_raised = True
+
+    assert copy_raised == update_raised
+
+
+def test_update_dont_validate_computed_null_value(
+    tmp_path_factory: pytest.TempPathFactory,
+) -> None:
+    src, dst = map(tmp_path_factory.mktemp, ("src", "dst"))
+
+    def write_template(validator: str | None) -> None:
+        validator_line = f"    validator: {validator!r}\n" if validator else ""
+        build_file_tree(
+            {
+                src / "copier.yml": (
+                    "computed:\n"
+                    "    type: yaml\n"
+                    '    default: "{{ \'\' }}"\n'
+                    "    when: false\n" + validator_line
+                ),
+                src / "{{ _copier_conf.answers_file }}.jinja": (
+                    "{{ _copier_answers|to_nice_yaml }}"
+                ),
+            }
+        )
+
+    # Prepare a destination from a template without a validator.
+    write_template(None)
+    git_save(src, tag="v1")
+    run_copy(str(src), dst, overwrite=True)
+    git_save(dst)
+
+    # Add a validator that rejects the computed (null) value.
+    write_template(
+        "{% if computed is none %}This validator should never be rendered{% endif %}"
+    )
+    git_save(src, tag="v2")
+
+    # Copying with the validator...
+    copy_dst = tmp_path_factory.mktemp("copy_dst")
+    copy_raised = False
+    try:
+        run_copy(str(src), copy_dst, overwrite=True)
+    except Exception:
+        copy_raised = True
+
+    # ...and updating with the validator must behave consistently.
+    update_raised = False
+    try:
+        run_update(dst, overwrite=True)
+    except Exception:
+        update_raised = True
+
+    assert copy_raised == update_raised
