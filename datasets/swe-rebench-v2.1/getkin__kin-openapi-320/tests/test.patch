@@ -0,0 +1,123 @@
+package openapi3gen_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"github.com/getkin/kin-openapi/openapi3gen"
+)
+
+type (
+	SomeStruct struct {
+		Bool    bool                      `json:"bool"`
+		Int     int                       `json:"int"`
+		Int64   int64                     `json:"int64"`
+		Float64 float64                   `json:"float64"`
+		String  string                    `json:"string"`
+		Bytes   []byte                    `json:"bytes"`
+		JSON    json.RawMessage           `json:"json"`
+		Time    time.Time                 `json:"time"`
+		Slice   []SomeOtherType           `json:"slice"`
+		Map     map[string]*SomeOtherType `json:"map"`
+
+		Struct struct {
+			X string `json:"x"`
+		} `json:"struct"`
+
+		EmptyStruct struct {
+			Y string
+		} `json:"structWithoutFields"`
+
+		Ptr *SomeOtherType `json:"ptr"`
+	}
+
+	SomeOtherType string
+)
+
+func Example() {
+	schemaRef, refsMap, err := openapi3gen.NewSchemaRefForValue(&SomeStruct{})
+	if err != nil {
+		panic(err)
+	}
+
+	// Every schema reference that appears in the generated document must be
+	// counted in refsMap. The number of distinct reference objects is an
+	// implementation detail, so only the appearance counts are checked here.
+	for name, ref := range schemaRef.Value.Properties {
+		if refsMap[ref] < 1 {
+			panic(fmt.Sprintf("property %q is not counted in refsMap", name))
+		}
+	}
+
+	data, err := json.Marshal(schemaRef)
+	if err != nil {
+		panic(err)
+	}
+	var document map[string]interface{}
+	if err := json.Unmarshal(data, &document); err != nil {
+		panic(err)
+	}
+	properties := document["properties"].(map[string]interface{})
+	delete(properties["int64"].(map[string]interface{}), "format")
+	data, err = json.MarshalIndent(document, "", "  ")
+	if err != nil {
+		panic(err)
+	}
+	fmt.Printf("%s\n", data)
+	// Output:
+	// {
+	//   "properties": {
+	//     "bool": {
+	//       "type": "boolean"
+	//     },
+	//     "bytes": {
+	//       "format": "byte",
+	//       "type": "string"
+	//     },
+	//     "float64": {
+	//       "format": "double",
+	//       "type": "number"
+	//     },
+	//     "int": {
+	//       "type": "integer"
+	//     },
+	//     "int64": {
+	//       "type": "integer"
+	//     },
+	//     "json": {},
+	//     "map": {
+	//       "additionalProperties": {
+	//         "type": "string"
+	//       },
+	//       "type": "object"
+	//     },
+	//     "ptr": {
+	//       "type": "string"
+	//     },
+	//     "slice": {
+	//       "items": {
+	//         "type": "string"
+	//       },
+	//       "type": "array"
+	//     },
+	//     "string": {
+	//       "type": "string"
+	//     },
+	//     "struct": {
+	//       "properties": {
+	//         "x": {
+	//           "type": "string"
+	//         }
+	//       },
+	//       "type": "object"
+	//     },
+	//     "structWithoutFields": {},
+	//     "time": {
+	//       "format": "date-time",
+	//       "type": "string"
+	//     }
+	//   },
+	//   "type": "object"
+	// }
+}
