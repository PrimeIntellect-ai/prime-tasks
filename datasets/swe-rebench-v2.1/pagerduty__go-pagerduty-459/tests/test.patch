+// Updating a service fetched with an indefinite time-based grouping keeps its zero timeout.
+func TestService_UpdatePreservesZeroAlertGroupingTimeout(t *testing.T) {
+	setup()
+	defer teardown()
+
+	mux.HandleFunc("/services/1", func(w http.ResponseWriter, r *http.Request) {
+		switch r.Method {
+		case "GET":
+			_, _ = w.Write([]byte(`{"service":{"id":"1","name":"foo","alert_grouping_parameters":{"type":"time","config":{"timeout":0}}}}`))
+		case "PUT":
+			var payload map[string]interface{}
+			if err := json.NewDecoder(r.Body).Decode(&payload); err != nil {
+				t.Fatal(err)
+			}
+			service, ok := payload["service"].(map[string]interface{})
+			if !ok {
+				t.Fatal("update request has no service object")
+			}
+			grouping, ok := service["alert_grouping_parameters"].(map[string]interface{})
+			if !ok {
+				t.Fatal("update request has no alert grouping parameters")
+			}
+			config, ok := grouping["config"].(map[string]interface{})
+			if !ok {
+				t.Fatal("update request has no alert grouping config")
+			}
+			timeout, ok := config["timeout"]
+			if !ok {
+				t.Fatal("update request omitted the alert grouping timeout")
+			}
+			if timeout != float64(0) {
+				t.Fatalf("update request timeout = %v, want 0", timeout)
+			}
+			_, _ = w.Write([]byte(`{"service":{"id":"1","name":"foo"}}`))
+		default:
+			t.Errorf("unexpected request method %q", r.Method)
+			http.Error(w, "unexpected method", http.StatusMethodNotAllowed)
+		}
+	})
+
+	client := defaultTestClient(server.URL, "foo")
+	service, err := client.GetService("1", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := client.UpdateService(*service); err != nil {
+		t.Fatal(err)
+	}
+}
