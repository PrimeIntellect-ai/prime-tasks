--- a/tests/test_web_urldispatcher.py
+++ b/tests/test_web_urldispatcher.py
@@ -916,3 +916,32 @@ async def test_url_with_many_slashes(aiohttp_client: AiohttpClient) -> None:
     r = await client.get("///a")
     assert r.status == 200
     await r.release()
+
+
+async def test_route_with_regex(aiohttp_client: AiohttpClient) -> None:
+    """Test a route with a regex preceded by a fixed string."""
+    app = web.Application()
+
+    async def handler(request: web.Request) -> web.Response:
+        return web.Response(text="matched")
+
+    route = "/core/locations{tail:.*}"
+    app.router.add_get(route, handler)
+    app.router.add_put(route, handler)
+    client = await aiohttp_client(app)
+
+    for path in (
+        "/core/locations/tail/here",
+        "/core/locations_tail_here",
+        "/core/locations_tail;id=abcdef",
+    ):
+        r = await client.get(path)
+        assert r.status == 200
+        assert await r.text() == "matched"
+
+    r = await client.put(
+        "/core/locations;id=c50f167537524366a5af7aa3942feb1e/"
+        "thermostat;id=711861a52ed84f37a2d854afba34d9e6"
+    )
+    assert r.status == 200
+    assert await r.text() == "matched"
