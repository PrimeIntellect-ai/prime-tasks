+#[test]
+fn redirect_to_different_host() {
+    let destination = TcpListener::bind("127.0.0.2:0").unwrap();
+    let destination_port = destination.local_addr().unwrap().port();
+    let destination_thread = thread::spawn(move || {
+        let (mut stream, _) = destination.accept().unwrap();
+        test::testserver::read_headers(&stream);
+        write!(
+            stream,
+            "HTTP/1.1 200 OK\r\nContent-Length: 0\r\nx-redirected: yes\r\n\r\n"
+        )
+        .unwrap();
+    });
+
+    let origin = TcpListener::bind("127.0.0.1:0").unwrap();
+    let origin_port = origin.local_addr().unwrap().port();
+    let origin_thread = thread::spawn(move || {
+        let (mut stream, _) = origin.accept().unwrap();
+        test::testserver::read_headers(&stream);
+        write!(
+            stream,
+            "HTTP/1.1 302 Found\r\nLocation: http://127.0.0.2:{}/target\r\nContent-Length: 0\r\n\r\n",
+            destination_port
+        )
+        .unwrap();
+    });
+
+    let response = get(&format!("http://127.0.0.1:{}/start", origin_port)).call();
+    assert_eq!(response.status(), 200);
+    assert_eq!(response.header("x-redirected").unwrap(), "yes");
+    origin_thread.join().unwrap();
+    destination_thread.join().unwrap();
+}
