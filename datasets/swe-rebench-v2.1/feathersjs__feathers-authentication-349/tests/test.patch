+      const authenticator = authenticate()(passport, ['chain-first', 'chain-selected']);
+
+      return authenticator({ strategy: 'chain-selected' }).then(result => {
+        const reported = [];
+        const collect = value => {
+          if (typeof value === 'string') {
+            reported.push(value);
+          } else if (value && typeof value === 'object') {
+            if (typeof value.message === 'string') {
+              reported.push(value.message);
+            }
+            Object.keys(value).forEach(key => collect(value[key]));
+          }
+        };
+        collect(result);
+        expect(reported.some(message => message.includes('selected strategy failed'))).to.equal(true);
+      });
+    });
