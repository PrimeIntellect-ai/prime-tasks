+// Bindgen derives the clang target from the `TARGET` environment variable when
+// no explicit `--target` is given. The variable is set only in a child process
+// so that other tests running in parallel are not affected.
+#[test]
+fn test_apple_ios_simulator_target_is_converted_for_clang() {
+    const CHILD_ENV: &str = "BINDGEN_TESTS_APPLE_IOS_SIM_CHILD";
+
+    if std::env::var_os(CHILD_ENV).is_none() {
+        let status = std::process::Command::new(
+            std::env::current_exe().expect("current test executable"),
+        )
+        .args([
+            "--exact",
+            "parse_callbacks::test_apple_ios_simulator_target_is_converted_for_clang",
+            "--nocapture",
+        ])
+        .env(CHILD_ENV, "1")
+        .env("TARGET", "aarch64-apple-ios-sim")
+        .status()
+        .expect("failed to run child test process");
+        assert!(
+            status.success(),
+            "bindings for target aarch64-apple-ios-sim could not be generated"
+        );
+        return;
+    }
+
+    // Clang defines this macro only for the accepted simulator triple.
+    let bindings = bindgen::Builder::default()
+        .header_contents(
+            "apple_sim.h",
+            "#ifdef __APPLE_EMBEDDED_SIMULATOR__\nint on_simulator(void);\n#else\nint not_on_simulator(void);\n#endif\n",
+        )
+        .generate()
+        .expect("generating bindings for aarch64-apple-ios-sim should succeed")
+        .to_string();
+
+    assert!(bindings.contains("on_simulator"), "{bindings}");
+    assert!(!bindings.contains("not_on_simulator"), "{bindings}");
+}
