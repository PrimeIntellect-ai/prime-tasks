 func (CaseExpr) isExpr()              {}
+func (IfExpr) isExpr()                {}
 func (ParenExpr) isExpr()             {}
 func (ScalarSubQuery) isExpr()        {}
 func (ArraySubQuery) isExpr()         {}
@@ -1305,6 +1306,22 @@ type CaseElse struct {
 	Expr Expr
 }
 
+// IfExpr is IF conditional expression.
+// Because IF is SQL keyword, it can't be a normal CallExpr.
+//
+//	IF({{.Expr | sql}}, {{.TrueResult | sql}}, {{.ElseResult | sql}})
+type IfExpr struct {
+	// pos = If
+	// end = Rparen + 1
+
+	If     token.Pos // position of "IF" keyword
+	Rparen token.Pos // position of ")"
+
+	Expr       Expr
+	TrueResult Expr
+	ElseResult Expr
+}
+
 // ParenExpr is parenthesized expression node.
 //
 //	({{. | sql}})
diff --git a/ast/pos.go b/ast/pos.go
index af1b319..103aa32 100644
--- a/ast/pos.go
+++ b/ast/pos.go
@@ -510,6 +510,14 @@ func (c *CaseElse) End() token.Pos {
 	return nodeEnd(wrapNode(c.Expr))
 }
 
+func (i *IfExpr) Pos() token.Pos {
+	return i.If
+}
+
+func (i *IfExpr) End() token.Pos {
+	return posAdd(i.Rparen, 1)
+}
+
 func (p *ParenExpr) Pos() token.Pos {
 	return p.Lparen
 }
