+    def test_lint_templates_in_subdirectories(self):
+        template_body = """
+Parameters:
+  Environment:
+    Type: String
+Conditions:
+  IsProd: !Equals [!Ref Environment, "prod"]
+Rules:
+  Rule1:
+    Assertions:
+    - Assert:
+        Fn::Not:
+        - !Equals ["A", "A"]
+Resources:
+  MyBucket:
+    Type: AWS::S3::Bucket
+    Properties:
+      Foo: bar
+"""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            template_paths = []
+            for subdir in ("nested", os.path.join("deeper", "nested")):
+                directory = os.path.join(tmpdir, "main", subdir)
+                os.makedirs(directory)
+                template_path = os.path.join(directory, "template.yaml")
+                with open(template_path, "w") as f:
+                    f.write(template_body)
+                template_paths.append(template_path)
+
+            config = ConfigMixIn(
+                [
+                    "--format=pretty",
+                    "--ignore-checks=W",
+                    os.path.join(tmpdir, "main", "**", "*.yaml"),
+                ]
+            )
+            matches = list(Runner(config).run())
+
+        linted_filenames = {match.filename for match in matches}
+        for template_path in template_paths:
+            self.assertIn(template_path, linted_filenames)
