+/// depend on how the diagram is laid out.
+fn wire_labels(rendered: &str) -> String {
+    let mut out = String::new();
+    for line in rendered.lines() {
+        let labels: Vec<&str> = line
+            .split_whitespace()
+            .filter(|tok| tok.chars().any(|c| c.is_alphanumeric() || c == '●'))
+            .collect();
+        if !labels.is_empty() {
+            out.push_str(&labels.join(" "));
+            out.push('\n');
+        }
+    }
+    out
