@@ -148,6 +148,41 @@ func TestObjectsAreEqual(t *testing.T) {
 		t.Fail()
 	}
 
+	// time.Time values that represent the same instant must be considered
+	// equal by the public Equal assertion even when they carry different
+	// location pointers (see issue #1464).
+	tm := time.Now()
+	tz := tm.In(time.Local)
+	if !Equal(t, tm, tz) {
+		t.Error("Equal should return true for time.Time values representing the same instant")
+	}
+
+}
+
+// TestEqualTime verifies the public contract from issue #1464: two time.Time
+// values that denote the same instant must compare equal through the public
+// Equal assertion, even when one was produced by converting the other to a
+// different location (which drops the monotonic clock reading).
+func TestEqualTime(t *testing.T) {
+	mockT := new(testing.T)
+
+	t1 := time.Now()
+	t2 := t1.In(time.Local)
+	if !Equal(mockT, t1, t2) {
+		t.Error("Equal should return true for the same instant expressed in different locations")
+	}
+
+	// A genuinely different instant must still be reported as unequal.
+	t3 := t1.Add(time.Second)
+	if Equal(mockT, t1, t3) {
+		t.Error("Equal should return false for different instants")
+	}
+	utc := time.Date(2020, time.January, 2, 3, 4, 5, 0, time.UTC)
+	fixedOffset := time.FixedZone("UTC+02", 2*60*60)
+	sameInstantInAnotherZone := utc.In(fixedOffset)
+	if !Equal(mockT, utc, sameInstantInAnotherZone) {
+		t.Error("Equal should return true for the same instant in different timezones")
+	}
 }
 
