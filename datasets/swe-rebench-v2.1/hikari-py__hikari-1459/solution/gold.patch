@@ -0,0 +1,1 @@
+Add ability to suppress optimization warnings through `suppress_optimization_warning=True` to the `GatewayBot` or `RESTBot` constructors.
diff --git a/hikari/impl/bot.py b/hikari/impl/bot.py
