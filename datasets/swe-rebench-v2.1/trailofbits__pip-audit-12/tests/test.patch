+import pytest
+from packaging.version import Version
+
+from pip_audit.service.interface import Dependency, VulnerabilityResult, VulnerabilityService
+
+
+@pytest.fixture(autouse=True)
+def spec():
+    def _spec(version):
+        return Dependency(package="foo", version=Version(version))
+
+    return _spec
+
+
+@pytest.fixture(autouse=True)
+def vuln_service():
+    # A dummy service that only returns results for the "foo" package
+    # between [1.0.0, 1.1.0).
+    class Service(VulnerabilityService):
+        def query(self, spec):
+            introduced = Version("1.0.0")
+            fixed = Version("1.1.0")
+
+            if spec.package == "foo" and (introduced <= spec.version < fixed):
+                return [
+                    VulnerabilityResult(
+                        id="fake-id",
+                        description="this is not a real result",
+                        version_introduced=Version("1.0.0"),
+                        version_fixed=Version("1.1.0"),
+                    )
+                ]
+
+            return []
+
+    return Service
diff --git a/test/service/test_interface.py b/test/service/test_interface.py
new file mode 100644
index 0000000..2ac2f8a
--- /dev/null
+++ b/test/service/test_interface.py
@@ -0,0 +1,26 @@
+from pip_audit.service.interface import VulnerabilityService
+
+
+def test_vulnerability_service_declares_query():
+    # The interface itself must declare `query`, independently of any
+    # subclass that supplies its own implementation.
+    assert callable(getattr(VulnerabilityService, "query", None))
+    assert callable(getattr(VulnerabilityService, "query_all", None))
+
+
+def test_vulnerability_service(vuln_service, spec):
+    service = vuln_service()
+    spec = spec("1.0.1")
+
+    assert len(service.query(spec)) == 1
+
+    all_ = service.query_all([spec])
+    assert len(all_) == 1
+    assert len(all_[spec]) == 1
+
+
+def test_vulnerability_service_no_results(vuln_service, spec):
+    service = vuln_service()
+    spec = spec("1.1.1")
+
+    assert len(service.query(spec)) == 0
