+class eqTests(unittest.TestCase):
+    def testEqualityOperationsHaveInlineDocumentation(self):
+        self.assertTrue(TensorBase.eq.__doc__ and TensorBase.eq.__doc__.strip())
+        self.assertTrue(TensorBase.eq_.__doc__ and TensorBase.eq_.__doc__.strip())
+
+    def testEqWithTensor(self):
+        t1 = TensorBase(np.arange(5))
+        t2 = TensorBase(np.arange(5)[-1::-1])
+        truth_values = t1.eq(t2)
+        self.assertIsInstance(truth_values, TensorBase)
+        self.assertEqual(truth_values, [False, False, True, False, False])
+        self.assertTrue(syft.equal(t1, TensorBase(np.arange(5))))
+
+    def testEqWithNumber(self):
+        t1 = TensorBase(np.arange(5))
+        truth_values = t1.eq(1)
+        self.assertIsInstance(truth_values, TensorBase)
+        self.assertEqual(truth_values, [False, True, False, False, False])
+        self.assertTrue(syft.equal(t1, TensorBase(np.arange(5))))
+
+    def testEqWithBroadcastTensor(self):
+        t1 = TensorBase(np.array([[1, 2, 3], [4, 5, 6]]))
+        t2 = TensorBase(np.array([1, 2, 3]))
+        truth_values = t1.eq(t2)
+        self.assertIsInstance(truth_values, TensorBase)
+        self.assertEqual(truth_values, [[True, True, True], [False, False, False]])
+
+    def testEqInPlaceWithTensor(self):
+        t1 = TensorBase(np.arange(5))
+        t2 = TensorBase(np.arange(5)[-1::-1])
+        t1.eq_(t2)
+        self.assertEqual(t1, [False, False, True, False, False])
+
+    def testEqInPlaceWithNumber(self):
+        t1 = TensorBase(np.arange(5))
+        t1.eq_(1)
+        self.assertEqual(t1, [False, True, False, False, False])
+
+    def testEqWithFloatTensor(self):
+        t1 = TensorBase(np.array([1.5, 2.0, 3.25]))
+        t2 = TensorBase(np.array([1.5, 0.0, 3.25]))
+        truth_values = t1.eq(t2)
+        self.assertEqual(truth_values, [True, False, True])
+        self.assertEqual(t1, [1.5, 2.0, 3.25])
+
+    def testEncryptedEqReturnsNotImplemented(self):
+        encrypted = TensorBase(np.array([1, 2, 3]))
+        encrypted.encrypted = True
+        self.assertIs(encrypted.eq(1), NotImplemented)
+
+    def testEncryptedEqInPlaceReturnsNotImplemented(self):
+        encrypted = TensorBase(np.array([1, 2, 3]))
+        encrypted.encrypted = True
+        self.assertIs(encrypted.eq_(1), NotImplemented)
+
+
 if __name__ == "__main__":
     unittest.main()
