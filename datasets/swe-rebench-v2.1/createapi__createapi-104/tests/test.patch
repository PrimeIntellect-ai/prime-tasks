+    private func generatedSources(package: String) throws -> [String] {
+        let root = URL(fileURLWithPath: temp.path(for: package)).appendingPathComponent("Sources")
+        let files = FileManager.default.enumerator(at: root, includingPropertiesForKeys: nil)
+        return try files?.compactMap { item in
+            guard let url = item as? URL, url.pathExtension == "swift" else { return nil }
+            return try String(contentsOf: url, encoding: .utf8)
+        } ?? []
+    }
+
+    private func generatedSource(package: String, path: String) throws -> String {
+        let url = URL(fileURLWithPath: temp.path(for: package)).appendingPathComponent(path)
+        return try String(contentsOf: url, encoding: .utf8)
+    }
