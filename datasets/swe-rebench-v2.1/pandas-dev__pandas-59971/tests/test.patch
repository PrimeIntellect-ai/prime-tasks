+    def test_query_duplicate_column_name(self, engine, parser):
+        # GH#59950
+        df = DataFrame(
+            {
+                "A": range(3),
+                "B": range(3),
+                "C": range(3),
+            }
+        ).rename(columns={"B": "A"})
+
+        expect = DataFrame(
+            [[1, 1, 1]],
+            columns=["A", "A", "C"],
+            index=[1],
+        )
+
+        for expr in ["C == 1", "A == 1"]:
+            try:
+                res = df.query(expr, engine=engine, parser=parser)
+            except Exception as err:
+                # A compliant implementation may instead reject DataFrames with
+                # duplicate column names with a clear error.
+                msg = str(err).lower()
+                assert "duplicate" in msg or "unique" in msg
+            else:
+                tm.assert_frame_equal(res, expect)
+
+    def test_query_duplicate_column_name_different_dtypes(self, engine, parser):
+        df = DataFrame(
+            [[1, "x", False], [2, "y", True], [3, "z", True]],
+            columns=["value", "value", "keep"],
+        )
+
+        expected = DataFrame(
+            [[2, "y", True], [3, "z", True]],
+            columns=["value", "value", "keep"],
+            index=[1, 2],
+        )
+
+        try:
+            result = df.query("keep == True", engine=engine, parser=parser)
+        except Exception as err:
+            message = str(err).lower()
+            assert "duplicate" in message or "unique" in message
+        else:
+            tm.assert_frame_equal(result, expected)
+
