+def test_async_context_manager():
+    async def coro():
+        async with logger.catch():
+            return 1 / 0
+        return 1
+
+    assert asyncio.run(coro()) == 1
+
+
+def test_async_context_manager_enters():
+    async def coro():
+        async with logger.catch():
+            return "entered"
+
+    assert asyncio.run(coro()) == "entered"
+
+
+def test_async_context_manager_logs_exception(writer):
+    logger.add(writer)
+
+    async def coro():
+        async with logger.catch():
+            1 / 0  # noqa: B018
+
+    asyncio.run(coro())
+
+    assert writer.read().endswith("ZeroDivisionError: division by zero\n")
+
+
+def test_async_context_manager_reraise(writer):
+    logger.add(writer)
+
+    async def coro():
+        async with logger.catch(reraise=True):
+            1 / 0  # noqa: B018
+
+    with pytest.raises(ZeroDivisionError):
+        asyncio.run(coro())
+
+    assert writer.read().endswith("ZeroDivisionError: division by zero\n")
+
+
+def test_async_context_manager_exception_filter(writer):
+    logger.add(writer)
+
+    async def coro():
+        async with logger.catch(exception=ValueError):
+            1 / 0  # noqa: B018
+
+    with pytest.raises(ZeroDivisionError):
+        asyncio.run(coro())
+
+    assert writer.read() == ""
+
+
