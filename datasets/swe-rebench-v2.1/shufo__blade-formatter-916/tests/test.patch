@@ -5417,4 +5417,52 @@ describe('formatter', () => {
 
     await util.doubleFormatCheck(content, expected);
   });
+
+  test('@php blocks format the same code consistently across surrounding nesting', async () => {
+    const phpLines = [
+      "    $value = $condition ? 'yes' : 'no';",
+      '    $result = strtoupper($value);',
+    ];
+    const depth = 6;
+    const nestedIndent = '    '.repeat(depth);
+    const content = [
+      '@php',
+      ...phpLines,
+      '@endphp',
+      ...Array.from({ length: depth }, (_, index) => `${'    '.repeat(index)}<div>`),
+      `${nestedIndent}@php`,
+      ...phpLines.map((line) => `${nestedIndent}${line}`),
+      `${nestedIndent}@endphp`,
+      ...Array.from({ length: depth }, (_, index) => `${'    '.repeat(depth - index - 1)}</div>`),
+    ].join('\n');
+
+    const formatted = await formatter().formatContent(content);
+    const phpBlocks = [...formatted.matchAll(/@php([\s\S]*?)@endphp/g)].map((match) => match[1]);
+    expect(phpBlocks).toHaveLength(2);
+
+    const removeSurroundingIndent = (block: string) => {
+      const lines = block.replace(/^\n/, '').replace(/\n\s*$/, '').split('\n');
+      const indentation = Math.min(...lines.filter((line) => line.trim()).map((line) => line.match(/^\s*/)?.[0].length ?? 0));
+      return lines.map((line) => (line.trim() ? line.slice(indentation) : '')).join('\n');
+    };
+
+    expect(removeSurroundingIndent(phpBlocks[1])).toEqual(removeSurroundingIndent(phpBlocks[0]));
+  });
+
+  test('@php ternary that fits the 79-character width stays on one line', async () => {
+    const ternary = '$result = $left ? $right : $fallback;';
+    const depth = 6;
+    const nestedIndent = '    '.repeat(depth);
+    const content = [
+      ...Array.from({ length: depth }, (_, index) => `${'    '.repeat(index)}<div>`),
+      `${nestedIndent}@php`,
+      `${nestedIndent}    ${ternary}`,
+      `${nestedIndent}    $another = true;`,
+      `${nestedIndent}@endphp`,
+      ...Array.from({ length: depth }, (_, index) => `${'    '.repeat(depth - index - 1)}</div>`),
+    ].join('\n');
+
+    const formatted = await new Formatter({ indentSize: 4, wrapLineLength: 79 }).formatContent(content);
+    expect(formatted.split('\n').some((line) => line.trim() === ternary && line.length <= 79)).toBe(true);
+  });
 });
