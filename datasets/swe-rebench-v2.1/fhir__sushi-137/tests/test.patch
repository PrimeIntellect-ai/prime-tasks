+    it('should generate a differential with slices of a repeating element in the correct order', () => {
+      // Reproduces the CancerGeneticVariant profile scenario from https://github.com/FHIR/sushi/issues/122
+      const doc = new FSHDocument('CancerGenomics.fsh');
+      const input = new FSHTank([doc], {
+        name: 'test',
+        version: '0.0.1',
+        canonical: 'http://example.com'
+      });
+      const pkg = new Package(input.config);
+      const profileFisher = new TestFisher(input, defs, pkg);
+      const exporter = new StructureDefinitionExporter(input, pkg, profileFisher);
+      const profile = new Profile('CancerGeneticVariant');
+      profile.parent = 'Observation';
+      const discType = new CaretValueRule('component');
+      discType.caretPath = 'slicing.discriminator[0].type';
+      discType.value = new FshCode('pattern');
+      const discPath = new CaretValueRule('component');
+      discPath.caretPath = 'slicing.discriminator[0].path';
+      discPath.value = 'code';
+      const slicingRules = new CaretValueRule('component');
+      slicingRules.caretPath = 'slicing.rules';
+      slicingRules.value = new FshCode('open');
+      profile.rules.push(discType, discPath, slicingRules);
+      const contains = new ContainsRule('component');
+      contains.items = [
+        'GeneStudied',
+        'VariationCode',
+        'GenomicDNAChange',
+        'GenomicSourceClass',
+        'AminoAcidChange',
+        'AminoAcidChangeType',
+        'CytogeneticLocation',
+        'CytogeneticNomenclature'
+      ];
+      profile.rules.push(contains);
+      contains.items.forEach(name => {
+        const codeRule = new FixedValueRule(`component[${name}].code`);
+        codeRule.fixedValue = new FshCode('x');
+        profile.rules.push(codeRule);
+      });
+      doc.profiles.set(profile.name, profile);
+      exporter.exportStructDef(profile);
+      const sd = pkg.profiles[0];
+      const differentialIds = sd.toJSON().differential.element.map((e: any) => e.id);
+      expect(differentialIds).toEqual([
+        'Observation.component',
+        'Observation.component:GeneStudied',
