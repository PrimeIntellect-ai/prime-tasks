+from __future__ import annotations
+
+import zipfile
+from pathlib import Path
+
+import pytest
+
+from scikit_build_core.build import build_wheel
+
+
+@pytest.mark.compile()
+@pytest.mark.configure()
+def test_scripts_are_processed_during_build(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Scripts installed into ``/scripts`` are processed as part of a build."""
+    project = tmp_path / "project"
+    project.mkdir()
+    (project / "pyproject.toml").write_text(
+        "[build-system]\n"
+        'requires = ["scikit_build_core"]\n'
+        'build-backend = "scikit_build_core.build"\n'
+        "\n"
+        "[project]\n"
+        'name = "scriptpkg"\n'
+        'version = "0.0.1"\n'
+    )
+    (project / "CMakeLists.txt").write_text(
+        "cmake_minimum_required(VERSION 3.15...3.26)\n"
+        'project("${SKBUILD_PROJECT_NAME}" LANGUAGES NONE '
+        'VERSION "${SKBUILD_PROJECT_VERSION}")\n'
+        "file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/plain "
+        "\"#!/usr/bin/env python3\\nprint('hi')\\n\")\n"
+        "file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/withargs "
+        "\"#!/usr/bin/env python3 -u\\nprint('hi')\\n\")\n"
+        "file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/pypy "
+        "\"#!/usr/bin/env pypy3 -u\\nprint('hi')\\n\")\n"
+        "install(FILES ${CMAKE_CURRENT_BINARY_DIR}/plain "
+        "DESTINATION ${SKBUILD_SCRIPTS_DIR})\n"
+        "install(FILES ${CMAKE_CURRENT_BINARY_DIR}/withargs "
+        "DESTINATION ${SKBUILD_SCRIPTS_DIR})\n"
+        "install(FILES ${CMAKE_CURRENT_BINARY_DIR}/pypy "
+        "DESTINATION ${SKBUILD_SCRIPTS_DIR})\n"
+    )
+
+    dist = tmp_path / "dist"
+    dist.mkdir()
+    monkeypatch.chdir(project)
+
+    out = build_wheel(str(dist), {})
+    wheel = dist / out
+
+    with zipfile.ZipFile(wheel) as z:
+        scripts = {
+            Path(name).name: z.read(name).decode()
+            for name in z.namelist()
+            if "/scripts/" in name
+        }
+
+    assert {"plain", "withargs", "pypy"} <= scripts.keys()
+    assert scripts["plain"].splitlines()[0] == "#!python"
+    assert scripts["withargs"].splitlines()[0] == "#!python -u"
+    assert scripts["pypy"].splitlines()[0] == "#!python -u"
+    for name in ("plain", "withargs", "pypy"):
+        assert scripts[name].splitlines()[1] == "print('hi')"
