+    @Test
+    fun pulse_beat_exposes_only_the_scheduled_instant_overload() {
+        // The obsolete overloads (the one accepting an `occurred` instant and the parameterless one) must be removed,
+        // leaving exactly one `beat` function on the public API. On the JVM a value class member is emitted as
+        // `<name>-impl`, so both spellings are counted.
+        val beatOverloads = Pulse::class.java.declaredMethods.filter { method ->
+            method.name == "beat" || method.name == "beat-impl"
+        }
+        assertEquals(expected = 1, actual = beatOverloads.size)
