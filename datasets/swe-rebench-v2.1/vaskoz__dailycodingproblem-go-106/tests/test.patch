+package day47
+
+import "testing"
+
+func TestMaxProfit(t *testing.T) {
+	t.Parallel()
+	testcases := []struct {
+		prices    []int
+		maxProfit int
+	}{
+		{[]int{9, 11, 8, 5, 7, 10}, 5},
+		{[]int{10, 7, 5, 8, 11, 9}, 6},
+		{[]int{7, 1, 5, 3, 6, 4}, 5},
+	}
+	for _, tc := range testcases {
+		if profit := MaxProfit(tc.prices); tc.maxProfit != profit {
+			t.Errorf("For prices %v, expected profit %d but got %d", tc.prices, tc.maxProfit, profit)
+		}
+	}
+}
