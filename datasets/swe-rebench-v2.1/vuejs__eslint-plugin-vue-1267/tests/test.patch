+/**
+ * @fileoverview enforce `v-for` directive's delimiter style
+ * @author Flo Edelmann
+ * @copyright 2020 Flo Edelmann. All rights reserved.
+ * See LICENSE file in root directory for full license.
+ */
+'use strict'
+
+const assert = require('assert')
+const Linter = require('eslint').Linter
+const ruleId = 'v-for-delimiter-style'
+const rule = require('../../../').rules[ruleId]
+const parser = require('vue-eslint-parser')
+
+function lint(code, delimiter) {
+  const linter = new Linter()
+  linter.defineParser('vue-eslint-parser', parser)
+  if (rule) {
+    linter.defineRule(ruleId, rule)
+  }
+  return linter.verify(
+    code,
+    {
+      parser: 'vue-eslint-parser',
+      parserOptions: { ecmaVersion: 2015 },
+      rules: {
+        [ruleId]: ['error', delimiter]
+      }
+    },
+    'test.vue'
+  ).filter(
+    message =>
+      message.ruleId === ruleId &&
+      !message.message.startsWith('Definition for rule')
+  )
+}
+
+describe('v-for-delimiter-style', () => {
+  it('accepts the selected delimiter whether it is in or of', () => {
+    for (const [delimiter, expression] of [
+      ['in', 'x in xs'],
+      ['of', 'x of xs']
+    ]) {
+      const messages = lint(`<template><div v-for="${expression}"></div></template>`, delimiter)
+      assert.strictEqual(messages.length, 0)
+    }
+  })
+
+  it('reports use of the other delimiter for an in preference', () => {
+    const messages = lint('<template><div v-for="x of xs"></div></template>', 'in')
+    assert(messages.length > 0)
+  })
+
+  it('reports use of the other delimiter for an of preference', () => {
+    const messages = lint('<template><div v-for="x in xs"></div></template>', 'of')
+    assert(messages.length > 0)
+  })
+})
