+      const baseUrl = 'https://your.ghe.com';
+      const fields = await runActionAndGetFields(baseUrl);
+      expect(fields.map(field => field.title).sort()).toEqual([
+        'action',
+        'commit',
+        'job',
+        'repo',
+        'workflow',
+      ]);
+      expect(
+        fields.every(field => field.value.startsWith(`<${baseUrl}/`)),
+      ).toBe(true);
+      expect(fields.find(field => field.title === 'repo')?.value).toContain(
+        `${baseUrl}/8398a7/action-slack|8398a7/action-slack`,
+      );
+      expect(fields.find(field => field.title === 'commit')?.value).toContain(
+        `${baseUrl}/8398a7/action-slack/commit/`,
+      );
+      expect(fields.find(field => field.title === 'commit')?.value).toContain(
+        `|${process.env.GITHUB_SHA?.slice(0, 8)}>`,
+      );
+      expect(fields.find(field => field.title === 'job')?.value).toContain(
+        `${baseUrl}/8398a7/action-slack/runs/`,
+      );
+      expect(fields.find(field => field.title === 'job')?.value).toContain(
+        `|${process.env.GITHUB_JOB}>`,
+      );
+      expect(fields.find(field => field.title === 'action')?.value).toContain(
+        `${baseUrl}/8398a7/action-slack/commit/`,
+      );
+      expect(fields.find(field => field.title === 'action')?.value).toContain(
+        '/checks|action>',
+      );
+      expect(fields.find(field => field.title === 'workflow')?.value).toContain(
+        `${baseUrl}/8398a7/action-slack/commit/`,
+      );
+      expect(fields.find(field => field.title === 'workflow')?.value).toContain(
+        '/checks|PR Checks>',
+      );
+    });
+  });
+  describe('action.yml', () => {
