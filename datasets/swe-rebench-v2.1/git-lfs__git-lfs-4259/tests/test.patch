+func TestSocks5hProxyFromEnvironment(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer listener.Close()
+
+	proxyAddress := listener.Addr().String()
+	c, err := NewClient(NewContext(nil, map[string]string{
+		"HTTP_PROXY": fmt.Sprintf("socks5h://%s", proxyAddress),
+	}, nil))
+	require.NoError(t, err)
+
+	req, err := http.NewRequest("GET", "http://some-host.invalid:80/foo/bar", nil)
+	require.NoError(t, err)
+	transport, err := c.Transport(req.URL, creds.EmptyAccess)
+	require.NoError(t, err)
+	client := &http.Client{Transport: transport, Timeout: 5 * time.Second}
+
+	type handshakeResult struct {
+		host string
+		port string
+		err  error
+	}
+	result := make(chan handshakeResult, 1)
+	go func() {
+		conn, acceptErr := listener.Accept()
+		if acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		defer conn.Close()
+
+		var greeting [2]byte
+		if _, acceptErr = io.ReadFull(conn, greeting[:]); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		methods := make([]byte, int(greeting[1]))
+		if _, acceptErr = io.ReadFull(conn, methods); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		if _, acceptErr = conn.Write([]byte{5, 0}); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+
+		var request [4]byte
+		if _, acceptErr = io.ReadFull(conn, request[:]); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		if request[3] != 3 {
+			result <- handshakeResult{err: fmt.Errorf("SOCKS address type was %d, want domain name", request[3])}
+			return
+		}
+		nameLength := make([]byte, 1)
+		if _, acceptErr = io.ReadFull(conn, nameLength); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		name := make([]byte, int(nameLength[0]))
+		var portBytes [2]byte
+		if _, acceptErr = io.ReadFull(conn, name); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		if _, acceptErr = io.ReadFull(conn, portBytes[:]); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		if _, acceptErr = conn.Write([]byte{5, 0, 0, 1, 127, 0, 0, 1, 0, 80}); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		_, acceptErr = http.ReadRequest(bufio.NewReader(conn))
+		if acceptErr == nil {
+			_, acceptErr = io.WriteString(conn, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")
+		}
+		result <- handshakeResult{host: string(name), port: fmt.Sprintf("%d", int(portBytes[0])<<8|int(portBytes[1])), err: acceptErr}
+	}()
+
+	response, err := client.Do(req)
+	require.NoError(t, err)
+	defer response.Body.Close()
+	body, err := io.ReadAll(response.Body)
+	require.NoError(t, err)
+	assert.Equal(t, "ok", string(body))
+
+	handshake := <-result
+	require.NoError(t, handshake.err)
+	assert.Equal(t, "some-host.invalid", handshake.host)
+	assert.Equal(t, "80", handshake.port)
+}
+
+func TestSocks5hProxyFromHTTPSProxyEnvironment(t *testing.T) {
+	target := http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = io.WriteString(w, "ok")
+	})
+	tlsServer := httptest.NewTLSServer(target)
+	defer tlsServer.Close()
+
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer listener.Close()
+
+	c, err := NewClient(NewContext(nil, map[string]string{
+		"HTTPS_PROXY": fmt.Sprintf("socks5h://%s", listener.Addr()),
+	}, nil))
+	require.NoError(t, err)
+	c.SkipSSLVerify = true
+
+	port := tlsServer.Listener.Addr().(*net.TCPAddr).Port
+	req, err := http.NewRequest("GET", fmt.Sprintf("https://some-host.invalid:%d/foo/bar", port), nil)
+	require.NoError(t, err)
+	transport, err := c.Transport(req.URL, creds.EmptyAccess)
+	require.NoError(t, err)
+	client := &http.Client{Transport: transport, Timeout: 5 * time.Second}
+
+	type handshakeResult struct {
+		host string
+		port string
+		err  error
+	}
+	result := make(chan handshakeResult, 1)
+	go func() {
+		conn, acceptErr := listener.Accept()
+		if acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		defer conn.Close()
+
+		var greeting [2]byte
+		if _, acceptErr = io.ReadFull(conn, greeting[:]); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		methods := make([]byte, int(greeting[1]))
+		if _, acceptErr = io.ReadFull(conn, methods); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		if _, acceptErr = conn.Write([]byte{5, 0}); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+
+		var request [4]byte
+		if _, acceptErr = io.ReadFull(conn, request[:]); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		if request[3] != 3 {
+			result <- handshakeResult{err: fmt.Errorf("SOCKS address type was %d, want domain name", request[3])}
+			return
+		}
+		nameLength := make([]byte, 1)
+		if _, acceptErr = io.ReadFull(conn, nameLength); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		name := make([]byte, int(nameLength[0]))
+		var portBytes [2]byte
+		if _, acceptErr = io.ReadFull(conn, name); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		if _, acceptErr = io.ReadFull(conn, portBytes[:]); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+
+		upstream, acceptErr := net.Dial("tcp", tlsServer.Listener.Addr().String())
+		if acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		defer upstream.Close()
+		if _, acceptErr = conn.Write([]byte{5, 0, 0, 1, 127, 0, 0, 1, 0, 80}); acceptErr != nil {
+			result <- handshakeResult{err: acceptErr}
+			return
+		}
+		result <- handshakeResult{host: string(name), port: fmt.Sprintf("%d", int(portBytes[0])<<8|int(portBytes[1]))}
+		go func() {
+			_, _ = io.Copy(upstream, conn)
+		}()
+		_, _ = io.Copy(conn, upstream)
+	}()
+
+	response, err := client.Do(req)
+	require.NoError(t, err)
+	defer response.Body.Close()
+	body, err := io.ReadAll(response.Body)
+	require.NoError(t, err)
+	assert.Equal(t, "ok", string(body))
+
+	handshake := <-result
+	require.NoError(t, handshake.err)
+	assert.Equal(t, "some-host.invalid", handshake.host)
+	assert.Equal(t, fmt.Sprintf("%d", port), handshake.port)
+}
