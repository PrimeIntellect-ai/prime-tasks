+'use strict';
+
+const expect = require('chai').expect;
+const Linter = require('../../../lib/index');
+
+describe('disallow-log', function() {
+  [
+    '{{log}}',
+    '{{log "Logs are best for debugging!"}}',
+    '{{#log}}Arrgh!{{/log}}',
+    '{{#log "Foo"}}{{/log}}'
+  ].forEach(function(template) {
+    it(`reports a violation for ${template}`, function() {
+      let linter = new Linter({
+        config: { rules: { 'disallow-log': true } }
+      });
+
+      expect(linter.verify({ source: template, moduleId: 'layout.hbs' })).to.have.length(1);
+    });
+  });
+
+  ['{{foo}}', '{{button}}'].forEach(function(template) {
+    it(`does not report a violation for ${template}`, function() {
+      let linter = new Linter({
+        config: { rules: { 'disallow-log': true } }
+      });
+
+      expect(linter.verify({ source: template, moduleId: 'layout.hbs' })).to.deep.equal([]);
+    });
+  });
+});
