 	return k, ctx
 }
+
+// newRollappKeeper calls keeper.NewKeeper, passing the codec, store keys and
+// params subspace (the first four arguments), and nil for every trailing
+// dependency keeper. The dependency keepers are not used by these tests, and
+// going through reflection keeps this helper independent of how many of them
+// the constructor takes.
+func newRollappKeeper(cdc codec.Codec, storeKey, memStoreKey storetypes.StoreKey, ps typesparams.Subspace) *keeper.Keeper {
+	fn := reflect.ValueOf(keeper.NewKeeper)
+	args := make([]reflect.Value, fn.Type().NumIn())
+	for i := range args {
+		args[i] = reflect.Zero(fn.Type().In(i))
+	}
+	args[0] = reflect.ValueOf(cdc)
+	args[1] = reflect.ValueOf(storeKey)
+	args[2] = reflect.ValueOf(memStoreKey)
+	args[3] = reflect.ValueOf(ps)
+	return fn.Call(args)[0].Interface().(*keeper.Keeper)
+}
