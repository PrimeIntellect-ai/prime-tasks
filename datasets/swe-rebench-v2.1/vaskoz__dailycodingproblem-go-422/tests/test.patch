+package day204
+
+import (
+	"testing"
+	"time"
+)
+
+var testcases = []struct {
+	tree  *CompleteBinaryTree
+	count int
+}{
+	{&CompleteBinaryTree{
+		Left: &CompleteBinaryTree{
+			Left: &CompleteBinaryTree{
+				Left:  &CompleteBinaryTree{},
+				Right: &CompleteBinaryTree{},
+			},
+			Right: &CompleteBinaryTree{
+				Left:  &CompleteBinaryTree{},
+				Right: &CompleteBinaryTree{},
+			},
+		},
+		Right: &CompleteBinaryTree{
+			Left: &CompleteBinaryTree{
+				Left: &CompleteBinaryTree{},
+			},
+			Right: &CompleteBinaryTree{},
+		},
+	}, 12},
+	{nil, 0},
+	{&CompleteBinaryTree{}, 1},
+	{&CompleteBinaryTree{Left: &CompleteBinaryTree{}}, 2},
+}
+
+// completeTreeWithNodes returns a complete binary tree holding exactly n
+// nodes, laid out level by level from the left. Fully populated subtrees
+// are shared between parents so that trees with billions of nodes stay
+// small in memory.
+func completeTreeWithNodes(n uint64) *CompleteBinaryTree {
+	perfect := make([]*CompleteBinaryTree, 64)
+	var perfectTree func(levels uint) *CompleteBinaryTree
+	perfectTree = func(levels uint) *CompleteBinaryTree {
+		if levels == 0 {
+			return nil
+		}
+		if perfect[levels] == nil {
+			child := perfectTree(levels - 1)
+			perfect[levels] = &CompleteBinaryTree{Left: child, Right: child}
+		}
+		return perfect[levels]
+	}
+	var build func(i uint64) *CompleteBinaryTree
+	build = func(i uint64) *CompleteBinaryTree {
+		if i == 0 || i > n {
+			return nil
+		}
+		// Heap numbering: the subtree rooted at i has its nodes at
+		// indices i*2^k .. (i+1)*2^k-1 on each level k below it.
+		levels := uint(1)
+		for (i+1)<<levels <= n+1 {
+			levels++
+		}
+		if i<<levels > n {
+			return perfectTree(levels)
+		}
+		return &CompleteBinaryTree{Left: build(2 * i), Right: build(2*i + 1)}
+	}
+	return build(1)
+}
+
+func TestCountCompleteBinaryTree(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		if count := CountCompleteBinaryTree(tc.tree); count != tc.count {
+			t.Errorf("Expected %v, got %v", tc.count, count)
+		}
+	}
+}
+
+func TestCountCompleteBinaryTreeEveryPartialLevel(t *testing.T) {
+	t.Parallel()
+	for n := uint64(1); n <= 300; n++ {
+		tree := completeTreeWithNodes(n)
+		if count := CountCompleteBinaryTree(tree); count != int(n) {
+			t.Errorf("tree with %d nodes: expected %d, got %d", n, n, count)
+		}
+	}
+}
+
+func TestCountCompleteBinaryTreeLarge(t *testing.T) {
+	t.Parallel()
+	sizes := []uint64{
+		1<<50 + 12345,
+		1<<52 - 1,
+		1<<40 + 1<<39 + 7,
+	}
+	for _, n := range sizes {
+		tree := completeTreeWithNodes(n)
+		result := make(chan int, 1)
+		go func() {
+			result <- CountCompleteBinaryTree(tree)
+		}()
+		select {
+		case count := <-result:
+			if count != int(n) {
+				t.Errorf("tree with %d nodes: expected %d, got %d", n, n, count)
+			}
+		case <-time.After(10 * time.Second):
+			t.Fatalf("counting a tree with %d nodes took longer than 10s", n)
+		}
+	}
+}
+
+func BenchmarkCountCompleteBinaryTree(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			CountCompleteBinaryTree(tc.tree)
+		}
+	}
+}
