+func TestParseFileHeaderWithSpaces(t *testing.T) {
+	input := `diff --git a/path/to/file/File with Spaces.pdf b/path/to/file/File with Spaces.pdf
+deleted file mode 100644
+index 6e02dcd4fabc172009aca3a6f78763246c59b8fe..0000000000000000000000000000000000000000
+`
+	files, _, err := Parse(strings.NewReader(input))
+	if err != nil {
+		t.Fatalf("unexpected error parsing patch: %v", err)
+	}
+	if len(files) != 1 {
+		t.Fatalf("expected 1 file, got %d", len(files))
+	}
+	if files[0].OldName != "path/to/file/File with Spaces.pdf" {
+		t.Errorf("incorrect old name: expected %q, actual %q", "path/to/file/File with Spaces.pdf", files[0].OldName)
+	}
+	if !files[0].IsDelete {
+		t.Errorf("expected file to be marked as deleted")
+	}
+}
