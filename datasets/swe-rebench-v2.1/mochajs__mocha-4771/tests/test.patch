diff --git a/test/integration/options/passOnFailingTestSuite.spec.js b/test/integration/options/passOnFailingTestSuite.spec.js
new file mode 100644
index 00000000..aa23e40f
--- /dev/null
+++ b/test/integration/options/passOnFailingTestSuite.spec.js
@@ -0,0 +1,92 @@
+'use strict';
+
+var helpers = require('../helpers');
+var runMocha = helpers.runMocha;
+var runMochaJSON = helpers.runMochaJSON;
+
+describe('--pass-on-failing-test-suite defaults to false', function() {
+  it('uses normal failure status when omitted', function(done) {
+    runMochaJSON('failing-sync.fixture.js', [], function(err, res) {
+      if (err) {
+        return done(err);
+      }
+
+      expect(res, 'to have test count', 1).and('to have exit code', 1);
+      done();
+    });
+  });
+});
+
+describe('Enabled --pass-on-failing-test-suite', function() {
+  var args = ['--pass-on-failing-test-suite=true'];
+
+  it('Test should finish with zero code with disabled option', function(done) {
+    var fixture = 'failing-sync.fixture.js';
+    runMochaJSON(fixture, args, function(err, res) {
+      if (err) {
+        return done(err);
+      }
+
+      expect(res, 'to have passed test count', 0)
+        .and('to have test count', 1)
+        .and('to have exit code', 0);
+      done();
+    });
+  });
+});
+
+describe('Disabled --pass-on-failing-test-suite', function() {
+  var args = ['--pass-on-failing-test-suite=false'];
+
+  it('Test should return non-zero code with enabled option', function(done) {
+    var fixture = 'failing-sync.fixture.js';
+    runMochaJSON(fixture, args, function(err, res) {
+      if (err) {
+        return done(err);
+      }
+
+      expect(res, 'to have passed test count', 0)
+        .and('to have test count', 1)
+        .and('to have exit code', 1);
+      done();
+    });
+  });
+});
+
+describe('Enabled --pass-on-failing-test-suite with an infrastructure problem', function() {
+  var args = ['--pass-on-failing-test-suite=true'];
+
+  it('should return a non-zero exit code when no test files are found', function(done) {
+    var fixture = 'nonexistent-xyz.fixture.js';
+    runMocha(fixture, args, function(err, res) {
+      if (err) {
+        return done(err);
+      }
+
+      expect(res.code, 'to be greater than', 0);
+      done();
+    });
+  });
+});
+
+describe('Enabled --pass-on-failing-test-suite with a runtime problem', function() {
+  it('keeps a nonzero status when loading the test file throws', function(done) {
+    runMocha(
+      'failing-sync.fixture.js',
+      ['--pass-on-failing-test-suite=true'],
+      function(err, res) {
+        if (err) {
+          return done(err);
+        }
+
+        expect(res.code, 'to be greater than', 0);
+        done();
+      },
+      {
+        env: Object.assign({}, process.env, {
+          MOCHA_TEST_RUNTIME_ERROR: '1'
+        })
+      }
+    );
+  });
+});
