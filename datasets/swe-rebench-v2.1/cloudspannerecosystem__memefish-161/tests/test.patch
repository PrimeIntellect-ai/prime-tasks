+
+func TestIssue131AlterDatabaseSQLAcceptance(t *testing.T) {
+	// Exercise the public parser from outside this package: the contract is the
+	// SQL accepted, not the concrete AST representation used to expose it.
+	dir := t.TempDir()
+	source := `package main
+import (
+"fmt"
+"github.com/cloudspannerecosystem/memefish"
+"github.com/cloudspannerecosystem/memefish/token"
+)
+func parser(sql string) *memefish.Parser {
+return &memefish.Parser{Lexer: &memefish.Lexer{File: &token.File{Buffer: sql}}}
+}
+func parses(sql string) bool {
+_, ddlErr := parser(sql).ParseDDL()
+_, statementErr := parser(sql).ParseStatement()
+return ddlErr == nil && statementErr == nil
+}
+func main() {
+valid := []string{
+"ALTER DATABASE dbname SET OPTIONS (default_leader='region', optimizer_version=1, optimizer_statistics_package='package', version_retention_period='7d')",
+"ALTER DATABASE dbname SET OPTIONS (optimizer_version=2)",
+"ALTER DATABASE dbname SET OPTIONS (optimizer_version=3)",
+"ALTER DATABASE dbname SET OPTIONS (optimizer_version=4)",
+"ALTER DATABASE dbname SET OPTIONS (optimizer_version=5)",
+"ALTER DATABASE dbname SET OPTIONS (optimizer_version=6)",
+"ALTER DATABASE dbname SET OPTIONS (optimizer_version=7)",
+"ALTER DATABASE dbname SET OPTIONS (enable_key_visualizer=true)",
+"ALTER DATABASE dbname SET OPTIONS (enable_key_visualizer=false)",
+"ALTER DATABASE dbname SET OPTIONS (default_leader=null, optimizer_version=null, optimizer_statistics_package=null, version_retention_period=null, enable_key_visualizer=null)",
+"ALTER DATABASE a0 SET OPTIONS (optimizer_version=1)",
+"ALTER DATABASE a_b SET OPTIONS (optimizer_version=1)",
+"ALTER DATABASE \x60a-b_3\x60 SET OPTIONS (optimizer_version=1)",
+}
+for _, sql := range valid {
+if !parses(sql) { panic("rejected valid statement: " + sql) }
+}
+fmt.Print("ALTER DATABASE parser contract passed")
+}`
+	path := filepath.Join(dir, "main.go")
+	if err := os.WriteFile(path, []byte(source), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("go", "run", path)
+	cmd.Dir = ".."
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("public parser contract check failed: %v\n%s", err, output)
+	}
+}
