+#[test]
+fn test_check_parse_subsets() {
+    // policies only: schema and entities omitted
+    run_check_parse_test_optional(
+        Some("sample-data/sandbox_a/policies_1.cedar"),
+        None::<PathBuf>,
+        None::<PathBuf>,
+        CedarExitCode::Success,
+    );
+    // schema only: policies and entities omitted
+    run_check_parse_test_optional(
+        None::<String>,
+        Some("sample-data/sandbox_a/schema.cedarschema"),
+        None::<PathBuf>,
+        CedarExitCode::Success,
+    );
+    // entities only: policies and schema omitted
+    run_check_parse_test_optional(
+        None::<String>,
+        None::<PathBuf>,
+        Some("sample-data/sandbox_a/entities.json"),
+        CedarExitCode::Success,
+    );
+    // policies and entities: schema omitted
+    run_check_parse_test_optional(
+        Some("sample-data/sandbox_a/policies_1.cedar"),
+        None::<PathBuf>,
+        Some("sample-data/sandbox_a/entities.json"),
+        CedarExitCode::Success,
+    );
+    // schema and entities: policies omitted
+    run_check_parse_test_optional(
+        None::<String>,
+        Some("sample-data/tiny_sandboxes/sample2/schema.cedarschema"),
+        Some("sample-data/tiny_sandboxes/sample2/entity.json"),
+        CedarExitCode::Success,
+    );
+    // all three supplied
+    run_check_parse_test_optional(
+        Some("sample-data/tiny_sandboxes/sample2/policy.cedar"),
+        Some("sample-data/tiny_sandboxes/sample2/schema.cedarschema"),
+        Some("sample-data/tiny_sandboxes/sample2/entity.json"),
+        CedarExitCode::Success,
+    );
+    // entities that do not parse (a Cedar policy file is not valid entity JSON)
+    run_check_parse_test_optional(
+        None::<String>,
+        None::<PathBuf>,
+        Some("sample-data/sandbox_a/policies_1.cedar"),
+        CedarExitCode::Failure,
+    );
+    // schema that does not parse
+    run_check_parse_test_optional(
+        None::<String>,
+        Some("sample-data/sandbox_a/policies_1.cedar"),
+        None::<PathBuf>,
+        CedarExitCode::Failure,
+    );
+    // policies that do not parse (a schema file is not a valid policy file)
+    run_check_parse_test_optional(
+        Some("sample-data/sandbox_a/schema.cedarschema"),
+        None::<PathBuf>,
+        None::<PathBuf>,
+        CedarExitCode::Failure,
+    );
+    // A parsing failure remains a failure when another category parses successfully.
+    run_check_parse_test_optional(
+        Some("sample-data/sandbox_a/schema.cedarschema"),
+        Some("sample-data/tiny_sandboxes/sample2/schema.cedarschema"),
+        None::<PathBuf>,
+        CedarExitCode::Failure,
+    );
+}
