+
+func TestGitHubLoadedSshSignatureSatisfiesPredicate(t *testing.T) {
+	const sha = "abcdef123456789"
+	responseBody := `{"data":{"repository":{"pullRequest":{"commits":{"nodes":[{"commit":{"oid":"` + sha + `","author":{"user":{"login":"author"}},"committer":{"user":{"login":"author"}},"pushedDate":"2024-01-02T03:04:05Z","parents":{"nodes":[]},"signature":{"__typename":"SshSignature","isValid":true,"signer":{"__typename":"User","login":"author"},"state":"VALID"}}}],"pageInfo":{"hasNextPage":false}}}}}}`
+	transport := signatureTestRoundTripper(func(req *http.Request) (*http.Response, error) {
+		return &http.Response{
+			Status:        "200 OK",
+			StatusCode:    http.StatusOK,
+			Header:        make(http.Header),
+			Body:          io.NopCloser(strings.NewReader(responseBody)),
+			ContentLength: int64(len(responseBody)),
+			Request:       req,
+		}, nil
+	})
+	client := &http.Client{Transport: transport}
+	pr := &github.PullRequest{
+		Title:     github.String("test"),
+		State:     github.String("open"),
+		Number:    github.Int(1),
+		CreatedAt: &github.Timestamp{Time: time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC)},
+		Draft:     github.Bool(false),
+		User:      &github.User{Login: github.String("author")},
+		Head: &github.PullRequestBranch{
+			Ref: github.String("feature"),
+			SHA: github.String(sha),
+			Repo: &github.Repository{
+				ID: github.Int64(1), Name: github.String("repo"),
+				Owner: &github.User{Login: github.String("org")},
+			},
+		},
+		Base: &github.PullRequestBranch{
+			Ref:  github.String("main"),
+			Repo: &github.Repository{ID: github.Int64(1)},
+		},
+	}
+	ctx, err := pull.NewGitHubContext(context.Background(), nil, nil, githubv4.NewClient(client), pull.Locator{
+		Owner: "org", Repo: "repo", Number: 1, Value: pr,
+	})
+	require.NoError(t, err)
+
+	result, err := HasValidSignatures(true).Evaluate(context.Background(), ctx)
+	require.NoError(t, err)
+	assert.True(t, result.Satisfied)
+}
+
+func TestHasValidSignaturesWithSsh(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		valid bool
+		want  bool
+	}{
+		{name: "valid signature", valid: true, want: true},
+		{name: "invalid signature", valid: false, want: false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := &pulltest.Context{
+				CommitsValue: []*pull.Commit{{
+					SHA: "abcdef123456789",
+					Signature: &pull.Signature{
+						Type:    pull.SignatureType("SshSignature"),
+						IsValid: tc.valid,
+					},
+				}},
+			}
+			result, err := HasValidSignatures(true).Evaluate(context.Background(), ctx)
+			require.NoError(t, err)
+			assert.Equal(t, tc.want, result.Satisfied)
+		})
+	}
+}
