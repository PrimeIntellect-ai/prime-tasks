+package test
+
+import (
+	"encoding/json"
+	"io/ioutil"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+func TestUnconditionalRecursion(t *testing.T) {
+	fixture := filepath.Join("..", "testdata", "unconditional-recursion.go")
+	src, err := ioutil.ReadFile(fixture)
+	if err != nil {
+		t.Fatal(err)
+	}
+	instructions := parseInstructions(t, fixture, src)
+
+	config := filepath.Join(t.TempDir(), "revive.toml")
+	if err := ioutil.WriteFile(config, []byte("[rule.unconditional-recursion]\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("go", "run", "..", "-config", config, "-formatter", "json", fixture)
+	output, runErr := cmd.CombinedOutput()
+	if runErr != nil {
+		// The linter returns a nonzero status when it reports findings.
+		if _, ok := runErr.(*exec.ExitError); !ok {
+			t.Fatalf("could not run linter: %v\n%s", runErr, output)
+		}
+	}
+
+	var failures []struct {
+		RuleName string
+	}
+	if err := json.Unmarshal(output, &failures); err != nil {
+		t.Fatalf("could not read lint findings: %v\n%s", err, output)
+	}
+	if got, want := len(failures), len(instructions); got != want {
+		t.Errorf("got %d unconditional-recursion findings, want %d", got, want)
+	}
+	for _, failure := range failures {
+		if failure.RuleName != "unconditional-recursion" {
+			t.Errorf("unexpected rule identifier %q", failure.RuleName)
+		}
+	}
+}
