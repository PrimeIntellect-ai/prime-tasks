+// createRawClient establishes a raw client connection to the server, performing
+// the operator JWT handshake, and optionally sends the initial PING. It returns
+// the underlying connection so the caller can keep it open.
+func createRawClient(t *testing.T, opts *Options, akp nkeys.KeyPair, name string, protocol int, sendPing bool) net.Conn {
+	t.Helper()
+	kp, _ := nkeys.CreateUser()
+	pub, _ := kp.PublicKey()
+	nuc := jwt.NewUserClaims(pub)
+	ujwt, err := nuc.Encode(akp)
+	require_NoError(t, err)
+
+	conn, err := net.Dial("tcp", fmt.Sprintf("%s:%d", opts.Host, opts.Port))
+	require_NoError(t, err)
+
+	br := bufio.NewReader(conn)
+	line, err := br.ReadString('\n')
+	if err != nil {
+		conn.Close()
+		t.Fatalf("Error reading INFO: %v", err)
+	}
+	line = strings.TrimSpace(strings.TrimPrefix(strings.TrimSpace(line), "INFO "))
+	var info Info
+	if err := json.Unmarshal([]byte(line), &info); err != nil {
+		conn.Close()
+		t.Fatalf("Error unmarshalling INFO: %v", err)
+	}
+
+	sig, err := kp.Sign([]byte(info.Nonce))
+	if err != nil {
+		conn.Close()
+		t.Fatalf("Error signing nonce: %v", err)
+	}
+
+	cinfo := map[string]interface{}{
+		"jwt":      ujwt,
+		"sig":      base64.RawURLEncoding.EncodeToString(sig),
+		"name":     name,
+		"protocol": protocol,
+		"verbose":  false,
+		"pedantic": false,
+		"lang":     "go",
+		"version":  "1.0.0",
+	}
+	b, err := json.Marshal(cinfo)
+	if err != nil {
+		conn.Close()
+		t.Fatalf("Error marshalling CONNECT: %v", err)
+	}
+	if _, err := fmt.Fprintf(conn, "CONNECT %s\r\n", b); err != nil {
+		conn.Close()
+		t.Fatalf("Error sending CONNECT: %v", err)
+	}
+	if sendPing {
+		if _, err := fmt.Fprintf(conn, "PING\r\n"); err != nil {
+			conn.Close()
+			t.Fatalf("Error sending PING: %v", err)
+		}
+	}
+	return conn
+}
