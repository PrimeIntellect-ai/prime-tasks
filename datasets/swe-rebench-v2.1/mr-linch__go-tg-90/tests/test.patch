+// staticFS is a minimal custom fs.FS implementation used to verify that
+// NewInputFileFS works with any fs.FS, not only fstest.MapFS.
+type staticFS struct {
+	name string
+	data string
+}
+
+func (s staticFS) Open(name string) (fs.File, error) {
+	if name != s.name {
+		return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrNotExist}
+	}
+
+	return fstest.MapFS{s.name: {Data: []byte(s.data)}}.Open(name)
+}
+
+// errFS is an fs.FS whose Open always fails with the given error.
+type errFS struct {
+	err error
+}
+
+func (e errFS) Open(name string) (fs.File, error) {
+	return nil, e.err
+}
+
+func TestNewInputFileFS(t *testing.T) {
+	fsys := fstest.MapFS{
+		"hello.txt": {
+			Data: []byte("hello, world"),
+		},
+	}
+
+	t.Run("OK", func(t *testing.T) {
+		file, err := NewInputFileFS(fsys, "hello.txt")
+		if !assert.NoError(t, err) {
+			return
+		}
+
+		assert.NotNil(t, file.Body)
+
+		data, err := io.ReadAll(file.Body)
+		assert.NoError(t, err)
+		assert.Equal(t, "hello, world", string(data))
+
+		assert.NoError(t, file.Close())
+	})
+
+	t.Run("NestedPath", func(t *testing.T) {
+		fsys := fstest.MapFS{
+			"dir/nested.txt": {
+				Data: []byte("nested"),
+			},
+		}
+
+		file, err := NewInputFileFS(fsys, "dir/nested.txt")
+		if !assert.NoError(t, err) {
+			return
+		}
+
+		data, err := io.ReadAll(file.Body)
+		assert.NoError(t, err)
+		assert.Equal(t, "nested", string(data))
+
+		assert.NoError(t, file.Close())
+	})
+
+	t.Run("CustomFS", func(t *testing.T) {
+		file, err := NewInputFileFS(staticFS{name: "custom.txt", data: "custom content"}, "custom.txt")
+		if !assert.NoError(t, err) {
+			return
+		}
+
+		data, err := io.ReadAll(file.Body)
+		assert.NoError(t, err)
+		assert.Equal(t, "custom content", string(data))
+
+		assert.NoError(t, file.Close())
+	})
+
+	t.Run("NotExist", func(t *testing.T) {
+		_, err := NewInputFileFS(fsys, "not-exist.txt")
+		assert.Error(t, err)
+	})
+
+	t.Run("WrapsOpenError", func(t *testing.T) {
+		sentinel := errors.New("open failed")
+
+		_, err := NewInputFileFS(errFS{err: sentinel}, "any.txt")
+		assert.Error(t, err)
+	})
+}
+
