diff --git a/test/transforms/paths/security.test.js b/test/transforms/paths/security.test.js
new file mode 100644
index 0000000..28a6716
--- /dev/null
+++ b/test/transforms/paths/security.test.js
@@ -0,0 +1,17 @@
+const jsdocInfo = require('../../../consumers/jsdocInfo');
+const setPaths = require('../../../transforms/paths');
+
+describe('Paths - security', () => {
+  it('Should parse jsdoc security params into security array with each security type', () => {
+    const jsodInput = [`
+      /**
+       * POST /api/v1/song
+       * @summary Create new song
+       * @security BasicAuth
+       */
+    `];
+    const parsedJSDocs = jsdocInfo()(jsodInput);
+    const result = setPaths({}, parsedJSDocs);
+    expect(result.paths['/api/v1/song'].post.security).toEqual([{ BasicAuth: [] }]);
+  });
+});
