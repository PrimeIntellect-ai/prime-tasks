+trait IntoDustAmount {
+    fn into_dust_amount(self) -> (Amount, bool);
+}
+
+impl IntoDustAmount for Amount {
+    fn into_dust_amount(self) -> (Amount, bool) { (self, false) }
+}
+
+impl<E: std::fmt::Debug> IntoDustAmount for Result<Amount, E> {
+    fn into_dust_amount(self) -> (Amount, bool) {
+        (self.expect("normal script should have a calculable dust value"), false)
+    }
+}
+
+impl IntoDustAmount for Option<Amount> {
+    fn into_dust_amount(self) -> (Amount, bool) {
+        (self.expect("normal script should have a calculable dust value"), true)
+    }
+}
