+#[test]
+fn gen_complex_function() {
+    abigen!(
+        WyvernExchangeV1,
+        r#"[
+        function atomicMatch_(address[14] addrs, uint[18] uints, uint8[8] feeMethodsSidesKindsHowToCalls, bytes calldataBuy, bytes calldataSell, bytes replacementPatternBuy, bytes replacementPatternSell, bytes staticExtradataBuy, bytes staticExtradataSell, uint8[2] vs, bytes32[5] rssMetadata) public payable
+    ]"#,
+    );
+
+    let tx_input = "";
+    let call_data: Bytes = tx_input.parse().unwrap();
+    let decoded = AtomicMatchCall::decode(&call_data).unwrap();
+    assert_eq!(decoded.encode(), call_data.to_vec());
+    let decoded = AtomicMatchCall::decode(&call_data).unwrap();
+    let fee: [u8; 8] = decoded.fee_methods_sides_kinds_how_to_calls.map(|v| v.into());
+    assert_eq!(fee, [1, 0, 0, 1, 1, 1, 0, 1]);
+}
+
+/// Exercises the `uint8` element type used by the generated `uint8[8]` field.
+fn check_uint8_element<T: Tokenizable + From<u8> + Into<u8>>(_: &[T; 8]) {
+    // `from`/`into` preserve the wrapped value.
+    let value: u8 = T::from(42u8).into();
+    assert_eq!(value, 42u8);
+
+    // Encoding produces a `uint8` ABI token.
+    assert_eq!(T::from(7u8).into_token(), Token::Uint(7u8.into()));
+
+    // Decoding accepts both unsigned and signed integer tokens holding a valid `uint8`.
+    let value: u8 = T::from_token(Token::Uint(5u8.into())).unwrap().into();
+    assert_eq!(value, 5u8);
+    let value: u8 = T::from_token(Token::Int(5u8.into())).unwrap().into();
+    assert_eq!(value, 5u8);
+
+    // Values that do not fit in a `uint8` are rejected.
+    assert!(T::from_token(Token::Uint(256u64.into())).is_err());
+    // Non-integer tokens are rejected.
+    assert!(T::from_token(Token::Bool(true)).is_err());
+}
