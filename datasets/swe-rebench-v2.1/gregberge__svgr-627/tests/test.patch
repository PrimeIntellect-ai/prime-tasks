+function collectStyleObjects(node: any, result: any[] = []): any[] {
+  if (!node || typeof node !== 'object') return result
+  if (Array.isArray(node)) {
+    node.forEach((child) => collectStyleObjects(child, result))
+    return result
+  }
+  if (
+    node.type === 'JSXAttribute' &&
+    node.name &&
+    node.name.name === 'style' &&
+    node.value &&
+    node.value.type === 'JSXExpressionContainer' &&
+    node.value.expression &&
+    node.value.expression.type === 'ObjectExpression'
+  ) {
+    result.push(node.value.expression)
+  }
+  Object.keys(node).forEach((key) => {
+    if (key === 'loc' || key === 'start' || key === 'end') return
+    collectStyleObjects(node[key], result)
+  })
+  return result
+}
+
+function styleObjectToMap(objectExpression: any): Record<string, any> {
+  const map: Record<string, any> = {}
+  objectExpression.properties.forEach((property: any) => {
+    const key =
+      property.key.type === 'StringLiteral'
+        ? property.key.value
+        : property.key.name
+    map[key] = property.value
+  })
+  return map
+}
