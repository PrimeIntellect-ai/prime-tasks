 from xcube.util.config import NameDictPairList
 
 _LON_ATTRS_DATA = ('lon', 'lon_bnds', 'degrees_east',
@@ -192,3 +194,48 @@ def update_dataset_var_attrs(dataset: xr.Dataset,
