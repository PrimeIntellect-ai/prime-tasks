+#[cfg(test)]
+mod plain_output_contract {
+    use clap::Parser;
+    use crate::cli::Cli;
+
+    #[test]
+    fn plain_output_supports_pipeline_text_and_code_block_selection() {
+        let markdown = "Test _one_ [two][1] three.\n\n```rust\nsome_markdown(\"rust\");\n```\n\n[1]: https://example.com/1\n";
+
+        let all_cli = Cli::try_parse_from(["mdq", "-o", "plain"]).unwrap();
+        let (found, output) = crate::run_in_memory(&all_cli, markdown);
+        assert!(found);
+        assert_eq!(output, "Test one two three.\n\nsome_markdown(\"rust\");\n");
+
+        let code_cli = Cli::try_parse_from(["mdq", "-o", "plain", "```rust"]).unwrap();
+        let (found, output) = crate::run_in_memory(&code_cli, markdown);
+        assert!(found);
+        assert_eq!(output.trim_end(), "some_markdown(\"rust\");");
+        assert!(!output.contains("```"));
+    }
+
+    #[test]
+    fn plain_output_separates_table_cells_with_single_space() {
+        let markdown = "| Name | Kind | Description |\n|---|---|---|\n| Foo | fizz | Not a fizz |\n";
+
+        let cli = Cli::try_parse_from(["mdq", "-o", "plain"]).unwrap();
+        let (found, output) = crate::run_in_memory(&cli, markdown);
+        assert!(found);
+        let lines: Vec<&str> = output.lines().filter(|line| !line.trim().is_empty()).collect();
+        assert_eq!(lines, vec!["Name Kind Description", "Foo fizz Not a fizz"]);
+    }
+}
