diff --git a/tests/test_annotations.py b/tests/test_annotations.py
index ee30944..89a5670 100644
--- a/tests/test_annotations.py
+++ b/tests/test_annotations.py
@@ -131,3 +131,25 @@ class TestAnnotations:
         assert (
             "The following `attr.ib`s lack a type annotation: v, y.",
         ) == e.value.args
+
+    def test_auto_attribs_subclassing(self):
+        """
+        Attributes from super classes are inherited when using auto_attribs.
+        """
+        @attr.s(auto_attribs=True)
+        class A:
+            a: int = 1
+
+        @attr.s(auto_attribs=True)
+        class B(A):
+            b: int = 2
+
+        @attr.s(auto_attribs=True)
+        class C(A):
+            pass
+
+        b = B()
+        c = C()
+        assert 1 == b.a
+        assert 2 == b.b
+        assert 1 == c.a
