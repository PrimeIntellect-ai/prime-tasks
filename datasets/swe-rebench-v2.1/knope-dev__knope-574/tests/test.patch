+/// Unreachable tags must not be used to determine a Go module's version.
+#[test]
+fn go_mod_ignores_unreachable_tags() {
+    let temp_dir = tempfile::tempdir().unwrap();
+    let temp_path = temp_dir.path();
+    init(temp_path);
+    commit(temp_path, "Initial commit");
+    tag(temp_path, "v1.0.0");
+    create_branch(temp_path, "rc");
+    commit(temp_path, "feat!: A breaking feature");
+    tag(temp_path, "v2.0.0");
+    switch_branch(temp_path, "main");
+    commit(temp_path, "fix: A bug");
+
+    write(temp_path.join("go.mod"), "module example.com/foo\n").unwrap();
+    write(temp_path.join("CHANGELOG.md"), "# Changelog\n").unwrap();
+    write(
+        temp_path.join("knope.toml"),
+        r#"[package]
+versioned_files = ["go.mod"]
+changelog = "CHANGELOG.md"
+
+[[workflows]]
+name = "prepare-release"
+
+[[workflows.steps]]
+type = "PrepareRelease"
+"#,
+    )
+    .unwrap();
+
+    // Act.
+    let dry_run_output = Command::new(cargo_bin!("knope"))
+        .arg("prepare-release")
+        .arg("--dry-run")
+        .current_dir(temp_dir.path())
+        .assert();
+    let actual_assert = Command::new(cargo_bin!("knope"))
+        .arg("prepare-release")
+        .current_dir(temp_dir.path())
+        .assert();
+
+    // Assert: the reachable v1.0.0 is used, so the fix bumps to 1.0.1.
+    dry_run_output.success();
+    actual_assert.success().stdout_eq("");
+    assert().eq(
+        "module example.com/foo // v1.0.1\n",
+        read_to_string(temp_path.join("go.mod")).unwrap(),
+    );
+}
+
+/// Unreachable tags must not determine JavaScript or Python package versions.
+#[rstest]
+#[case::javascript(
+    "scn-2-javascript",
+    "package.json",
+    r#"{
+  "name": "example",
+  "version": "1.0.0"
+}
+"#,
+)]
+#[case::python(
+    "scn-2-python",
+    "pyproject.toml",
+    "[project]\nname = \"example\"\nversion = \"1.0.0\"\n",
+)]
+fn non_go_package_formats_ignore_unreachable_tags(
+    #[case] package_name: &str,
+    #[case] versioned_file: &str,
+    #[case] initial_content: &str,
+) {
+    let temp_dir = tempfile::tempdir().unwrap();
+    let temp_path = temp_dir.path();
+    init(temp_path);
+    write(temp_path.join(versioned_file), initial_content).unwrap();
+    write(temp_path.join("CHANGELOG.md"), "# Changelog\n").unwrap();
+    write(
+        temp_path.join("knope.toml"),
+        format!(
+            "[packages.{package_name}]\nversioned_files = [\"{versioned_file}\"]\nchangelog = \"CHANGELOG.md\"\n\n[[workflows]]\nname = \"prepare-release\"\n\n[[workflows.steps]]\ntype = \"PrepareRelease\"\n"
+        ),
+    )
+    .unwrap();
+    add_all(temp_path);
+    commit(temp_path, "Initial package");
+    tag(temp_path, &format!("{package_name}/v1.0.0"));
+    create_branch(temp_path, "release-candidate");
+    commit(temp_path, "feat!: Unreachable breaking release");
+    tag(temp_path, &format!("{package_name}/v2.0.0"));
+    switch_branch(temp_path, "main");
+    commit(temp_path, "fix: Reachable bug fix");
+
+    let output = Command::new(cargo_bin!("knope"))
+        .arg("prepare-release")
+        .current_dir(temp_path)
+        .assert();
+
+    output.success();
+    let updated_file = read_to_string(temp_path.join(versioned_file)).unwrap();
+    let updated_version = if versioned_file == "package.json" {
+        serde_json::from_str::<serde_json::Value>(&updated_file).unwrap()["version"]
+            .as_str()
+            .unwrap()
+            .to_string()
+    } else {
+        toml::from_str::<toml::Value>(&updated_file).unwrap()["project"]["version"]
+            .as_str()
+            .unwrap()
+            .to_string()
+    };
+    assert_eq!(
+        "1.0.1", updated_version,
+        "The current version should come from the reachable 1.0.0 tag, not the unreachable 2.0.0 tag"
+    );
+}
