+  /**
+   * Fetches object metadata through the real {@code HttpStorageRpc}, which processes the supplied
+   * options map (including encryption headers). The reported NullPointerException comes from
+   * dereferencing a null options map in that code path, so running it with the options map supplied
+   * by {@code BlobWriteChannel} verifies that uploads no longer fail with that NPE.
+   */
+  private static StorageObject fetchRemoteObject(Map<StorageRpc.Option, ?> options) {
+    final HttpTransport transport =
+        new MockHttpTransport.Builder()
+            .setLowLevelHttpResponse(
+                new MockLowLevelHttpResponse()
+                    .setContentType("application/json")
+                    .setContent(
+                        "{\"name\":\"n\",\"bucket\":\"b\",\"size\":\"262144\"}"))
+            .build();
+    StorageOptions httpOptions =
+        StorageOptions.newBuilder()
+            .setProjectId("projectid")
+            .setHost("http://localhost")
+            .setTransportOptions(
+                HttpTransportOptions.newBuilder()
+                    .setHttpTransportFactory(
+                        new HttpTransportFactory() {
+                          @Override
+                          public HttpTransport create() {
+                            return transport;
+                          }
+                        })
+                    .build())
+            .build();
+    return new HttpStorageRpc(httpOptions).get(BLOB_INFO.toPb(), options);
+  }
+
