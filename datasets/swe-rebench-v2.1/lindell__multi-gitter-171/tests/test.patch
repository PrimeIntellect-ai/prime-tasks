+func TestNestedProjectFromCLIAndYAML(t *testing.T) {
+	const project = "group-org/subgroup/project"
+	cases := []struct {
+		name string
+		args func(string, string) ([]string, error)
+	}{
+		{
+			name: "command line",
+			args: func(baseURL, _ string) ([]string, error) {
+				return []string{"--platform", "gitlab", "--base-url", baseURL, "--token", "token", "--project", project}, nil
+			},
+		},
+		{
+			name: "YAML configuration",
+			args: func(baseURL, configFile string) ([]string, error) {
+				config := "platform: gitlab\nbase-url: " + baseURL + "\ntoken: token\nproject:\n  - " + project + "\n"
+				if err := os.WriteFile(configFile, []byte(config), 0600); err != nil {
+					return nil, err
+				}
+				return []string{"--config", configFile}, nil
+			},
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var receivedMu sync.Mutex
+			var receivedProject bool
+			var server *httptest.Server
+			server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				receivedMu.Lock()
+				receivedProject = true
+				receivedMu.Unlock()
+				w.Header().Set("Content-Type", "application/json")
+				projectJSON := fmt.Sprintf(`{"id":1,"path":"project","path_with_namespace":"group-org/subgroup/project","namespace":{"path":"group-org/subgroup"},"http_url_to_repo":%q,"default_branch":"main"}`, server.URL+"/repo.git")
+				if strings.HasSuffix(r.URL.Path, "/projects") {
+					fmt.Fprintf(w, "[%s]", projectJSON)
+					return
+				}
+				fmt.Fprint(w, projectJSON)
+			}))
+			defer server.Close()
+
+			configFile := t.TempDir() + "/config.yaml"
+			platformArgs, err := tc.args(server.URL, configFile)
+			if err != nil {
+				t.Fatalf("prepare project input: %v", err)
+			}
+			commandArgs := []string{"run", "--skip-pr", "--dry-run", "--commit-message", "update", "--author-name", "Test", "--author-email", "test@example.com"}
+			commandArgs = append(commandArgs, platformArgs...)
+			commandArgs = append(commandArgs, "/bin/true")
+			ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
+			defer cancel()
+			command := exec.CommandContext(ctx, "go", append([]string{"run", "../../../main.go"}, commandArgs...)...)
+			output, commandErr := command.CombinedOutput()
+			if ctx.Err() != nil {
+				t.Fatalf("multi-gitter command timed out: %v", ctx.Err())
+			}
+			if commandErr != nil {
+				t.Fatalf("multi-gitter could not use the nested project reference: %v\n%s", commandErr, output)
+			}
+			receivedMu.Lock()
+			gotProject := receivedProject
+			receivedMu.Unlock()
+			if !gotProject {
+				t.Fatal("the GitLab API was not contacted to fetch the configured project")
+			}
+		})
+	}
+}
