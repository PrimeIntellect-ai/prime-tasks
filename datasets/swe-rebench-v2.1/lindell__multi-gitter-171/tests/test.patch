+// TestGetRepositoriesNestedGroup verifies that a project living in a nested
+// GitLab group can actually be fetched, not just parsed.
+func TestGetRepositoriesNestedGroup(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		fmt.Fprint(w, `{
+"id": 1,
+"path": "project",
+"path_with_namespace": "group-org/subgroup/project",
+"namespace": {"path": "group-org/subgroup"},
+"http_url_to_repo": "https://gitlab.com/group-org/subgroup/project.git",
+"default_branch": "main"
+}`)
+	}))
+	defer server.Close()
+
+	ref, err := ParseProjectReference("group-org/subgroup/project")
+	if err != nil {
+		t.Fatalf("ParseProjectReference() error = %v", err)
+	}
+
+	g, err := New("token", server.URL, RepositoryListing{
+		Projects: []ProjectReference{ref},
+	}, Config{})
+	if err != nil {
+		t.Fatalf("New() error = %v", err)
+	}
+
+	repos, err := g.GetRepositories(context.Background())
+	if err != nil {
+		t.Fatalf("GetRepositories() error = %v", err)
+	}
+	if len(repos) != 1 {
+		t.Fatalf("GetRepositories() returned %d repositories, want 1", len(repos))
+	}
+	if got, want := repos[0].FullName(), "group-org/subgroup/project"; got != want {
+		t.Errorf("repository FullName() = %q, want %q", got, want)
+	}
+}
