+func TestRestoreAcceptsRepeatedPatternFileFlags(t *testing.T) {
+	env, cleanup := withTestEnvironment(t)
+	defer cleanup()
+
+	testRunInit(t, env.gopts)
+
+	files := []string{"dir1/Alpha.txt", "dir2/Beta.txt", "dir3/Gamma.txt"}
+	for _, name := range files {
+		path := filepath.Join(env.testdata, name)
+		rtest.OK(t, os.MkdirAll(filepath.Dir(path), 0755))
+		rtest.OK(t, appendRandomData(path, 100))
+	}
+	testRunBackup(t, filepath.Dir(env.testdata), []string{filepath.Base(env.testdata)}, BackupOptions{}, env.gopts)
+	testRunCheck(t, env.gopts)
+	snapshotID := testListSnapshots(t, env.gopts, 1)[0]
+
+	cases := []struct {
+		name          string
+		flag          string
+		firstPattern  string
+		secondPattern string
+		include       bool
+	}{
+		{"include", "--include-file", "dir1/Alpha.txt", "dir2/Beta.txt", true},
+		{"iinclude", "--iinclude-file", "dir1/alpha.txt", "dir2/beta.txt", true},
+		{"exclude", "--exclude-file", "dir1/Alpha.txt", "dir2/Beta.txt", false},
+		{"iexclude", "--iexclude-file", "dir1/alpha.txt", "dir2/beta.txt", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			first := filepath.Join(env.base, tc.name+"-patterns-1")
+			second := filepath.Join(env.base, tc.name+"-patterns-2")
+			rtest.OK(t, os.WriteFile(first, []byte(tc.firstPattern+"\n"), 0600))
+			rtest.OK(t, os.WriteFile(second, []byte(tc.secondPattern+"\n"), 0600))
+
+			restoredir := filepath.Join(env.base, "restore-repeated-"+tc.name)
+			flags := []string{"--target", restoredir, tc.flag, first, tc.flag, second}
+			rtest.OK(t, testRunRestoreWithFlags(t, env.gopts, snapshotID.String(), flags))
+
+			for _, name := range files {
+				_, err := os.Stat(filepath.Join(restoredir, "testdata", name))
+				selected := name != "dir3/Gamma.txt"
+				if tc.include {
+					if selected {
+						rtest.OK(t, err)
+					} else {
+						rtest.Assert(t, os.IsNotExist(err), "%s should not have been restored", name)
+					}
+				} else if selected {
+					rtest.Assert(t, os.IsNotExist(err), "%s should have been excluded", name)
+				} else {
+					rtest.OK(t, err)
+				}
+			}
+		})
+	}
 }
 
