+func TestRestoreInsensitiveIncludesFromFile(t *testing.T) {
+	testfiles := []struct {
+		path    string
+		size    uint
+		include bool
+	}{
+		{"dir1/Include_Me.TXT", 100, true},
+		{"dir1/something_else.txt", 200, false},
+		{"dir2/ALSO_INCLUDE_ME.txt", 150, true},
+		{"dir3/not_included.txt", 180, false},
+	}
