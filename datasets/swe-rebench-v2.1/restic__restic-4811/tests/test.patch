+		err := testRunRestoreWithFlags(t, env.gopts, "latest", []string{"--target", filepath.Join(env.base, "restore"), flag, missing})
+		rtest.Assert(t, err != nil, "expected an error for %s with a missing file", flag)
+		rtest.Assert(t, !strings.Contains(err.Error(), "unknown flag"),
+			"expected %s to be a recognized flag, got %v", flag, err)
+	}
+}
