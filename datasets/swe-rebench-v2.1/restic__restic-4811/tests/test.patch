+	patternsFile := filepath.Join(env.base, "iinclude-patterns")
+	rtest.OK(t, os.WriteFile(patternsFile, []byte("dir1/include_me.txt\ndir2/also_include_me.txt\n"), 0644))
+
+	restoredir := filepath.Join(env.base, "restore-iinclude-file")
+	rtest.OK(t, testRunRestoreWithFlags(t, env.gopts, snapshotID.String(), []string{"--target", restoredir, "--iinclude-file", patternsFile}))
+
+	for _, testFile := range testfiles {
+		restoredFilePath := filepath.Join(restoredir, "testdata", testFile.path)
+		_, err := os.Stat(restoredFilePath)
+		if testFile.include {
+			rtest.OK(t, err)
+		} else {
+			rtest.Assert(t, os.IsNotExist(err), "File %s should not have been restored", testFile.path)
+		}
+	}
+}
