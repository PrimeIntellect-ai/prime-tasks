+
+#[test]
+fn executor_task_cfg_args() {
+    // simulate cfg'ing away argument c
+    #[task]
+    async fn task1(trace: Trace, a: u32, b: u32, #[cfg(any())] c: u32) {
+        assert_eq!((a, b), (1, 2));
+        trace.push("poll task1");
+    }
+
+    #[task]
+    async fn task2(trace: Trace, a: u32, b: u32, #[cfg(all())] c: u32) {
+        assert_eq!((a, b, c), (3, 4, 5));
+        trace.push("poll task2");
+    }
+
+    let (executor, trace) = setup();
+    executor.spawner().spawn(task1(trace.clone(), 1, 2)).unwrap();
+    executor.spawner().spawn(task2(trace.clone(), 3, 4, 5)).unwrap();
+
+    unsafe { executor.poll() };
+    unsafe { executor.poll() };
+
+    let trace = trace.get();
+    assert!(trace.contains(&"poll task1"), "task1 did not run: {trace:?}");
+    assert!(trace.contains(&"poll task2"), "task2 did not run: {trace:?}");
+}
