+def test_describe_numeric_all_nans():
+    df = pd.DataFrame({"nulls": [np.nan] * 5})
+    df.ww.init(logical_types={"nulls": "Double"})
+
+    stats = df.ww.describe_dict(extra_stats=True)
+
+    assert stats["nulls"]["top_values"] == []
+
+
+def test_describe_dict_extra_stats_populated_double_top_values():
+    df = pd.DataFrame({"double_values": [1.0, 2.0, 2.0, 3.0]})
+    df.ww.init(logical_types={"double_values": "Double"})
+
+    stats = df.ww.describe_dict(extra_stats=True)["double_values"]
+
+    assert any(
+        item["value"] == 2 and item["count"] == 2 for item in stats["top_values"]
+    )
+
+
+def test_describe_dict_extra_stats_fractional_double_no_top_values():
+    df = pd.DataFrame({"fractional_values": [1.5, 2.0, 2.5, 3.0, 3.5, 1.0]})
+    df.ww.init(logical_types={"fractional_values": "Double"})
+
+    stats = df.ww.describe_dict(extra_stats=True)["fractional_values"]
+
+    assert not stats.get("top_values")
+
