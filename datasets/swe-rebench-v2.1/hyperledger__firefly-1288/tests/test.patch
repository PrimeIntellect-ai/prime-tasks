+// assertNamespaceCachePurged waits for the reload to purge the cache entry for the namespace
+func assertNamespaceCachePurged(t *testing.T, ctx context.Context, nm *namespaceManager, ns, key string) {
+	assert.Eventually(t, func() bool {
+		c, err := nm.cacheManager.GetCache(cache.NewCacheConfig(ctx, "cache.batch.limit", "cache.batch.ttl", ns))
+		return err == nil && c.Get(key) == nil
+	}, 10*time.Second, 10*time.Millisecond, "cache for namespace %s was not purged on reload", ns)
+}
+
+func TestConfigReloadPurgesCachesOnNamespaceDeletion(t *testing.T) {
+	logrus.SetLevel(logrus.TraceLevel)
+
+	testDir := t.TempDir()
+	configFilename := fmt.Sprintf("%s/firefly.core", testDir)
+	renameWriteFile(t, configFilename, []byte(exampleConfig1base))
+
+	coreconfig.Reset()
+	InitConfig()
+	err := config.ReadConfig("core", configFilename)
+	assert.NoError(t, err)
+	config.Set(coreconfig.ConfigAutoReload, true)
+
+	nm := NewNamespaceManager().(*namespaceManager)
+	nmm := mockPluginFactories(nm)
+	mockInitConfig(nmm)
+	waitInit := namespaceInitWaiter(t, nmm, []string{"ns1", "ns2"})
+
+	ctx, cancelCtx := context.WithCancel(context.Background())
+	err = nm.Init(ctx, cancelCtx, make(chan bool), func() error {
+		coreconfig.Reset()
+		return config.ReadConfig("core", configFilename)
+	})
+	assert.NoError(t, err)
+	defer func() {
+		cancelCtx()
+		nm.WaitStop()
+	}()
+	nmm.mo.On("WaitStop").Return(nil).Maybe()
+
+	err = nm.Start()
+	assert.NoError(t, err)
+	waitInit.Wait()
+
+	// Populate a cache entry for each namespace, as the orchestrator would
+	ns2Cache, err := nm.cacheManager.GetCache(cache.NewCacheConfig(ctx, "cache.batch.limit", "cache.batch.ttl", "ns2"))
+	assert.NoError(t, err)
+	ns2Cache.Set("key2", "value2")
+
+	// Same configuration, with the definition of ns2 removed
+	ns2Definition := "    - defaultKey: 0x630659A26fa005d50Fa9706D8a4e242fd4169A61\n      name: ns2\n      plugins:\n        - database0\n        - blockchain-ns2\n        - test_user_auth-ns2\n      multiparty: {}\n"
+	configNoNS2 := strings.Replace(exampleConfig1base, ns2Definition, "", 1)
+	assert.NotEqual(t, exampleConfig1base, configNoNS2)
+
+	// Delete ns2 in the configuration
+	renameWriteFile(t, configFilename, []byte(configNoNS2))
+
+	// The cache for the deleted namespace must have been purged
+	assertNamespaceCachePurged(t, ctx, nm, "ns2", "key2")
+}
+
+func TestConfigReloadPurgesCachesOnNamespaceChange(t *testing.T) {
+	logrus.SetLevel(logrus.TraceLevel)
+
+	testDir := t.TempDir()
+	configFilename := fmt.Sprintf("%s/firefly.core", testDir)
+	renameWriteFile(t, configFilename, []byte(exampleConfig1base))
+
+	coreconfig.Reset()
+	InitConfig()
+	err := config.ReadConfig("core", configFilename)
+	assert.NoError(t, err)
+	config.Set(coreconfig.ConfigAutoReload, true)
+
+	nm := NewNamespaceManager().(*namespaceManager)
+	nmm := mockPluginFactories(nm)
+	mockInitConfig(nmm)
+	waitInit := namespaceInitWaiter(t, nmm, []string{"ns1", "ns2"})
+
+	ctx, cancelCtx := context.WithCancel(context.Background())
+	err = nm.Init(ctx, cancelCtx, make(chan bool), func() error {
+		coreconfig.Reset()
+		return config.ReadConfig("core", configFilename)
+	})
+	assert.NoError(t, err)
+	defer func() {
+		cancelCtx()
+		nm.WaitStop()
+	}()
+	nmm.mo.On("WaitStop").Return(nil).Maybe()
+
+	err = nm.Start()
+	assert.NoError(t, err)
+	waitInit.Wait()
+
+	// Populate a cache entry for ns1, as the orchestrator would
+	ns1Cache, err := nm.cacheManager.GetCache(cache.NewCacheConfig(ctx, "cache.batch.limit", "cache.batch.ttl", "ns1"))
+	assert.NoError(t, err)
+	ns1Cache.Set("key1", "value1")
+
+	// Change the configuration of ns1
+	waitInit = namespaceInitWaiter(t, nmm, []string{"ns1", "ns2"})
+
+	renameWriteFile(t, configFilename, []byte(exampleConfig3NSchanges))
+
+	waitInit.Wait()
+
+	// The cache for the changed namespace must have been purged
+	assertNamespaceCachePurged(t, ctx, nm, "ns1", "key1")
+}
