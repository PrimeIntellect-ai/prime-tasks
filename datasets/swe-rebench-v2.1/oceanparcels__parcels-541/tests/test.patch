+@pytest.mark.parametrize('mode', ['scipy', 'jit'])
+def test_nested_if(fieldset, mode):
+    """Test nested if commands"""
+    class TestParticle(ptype[mode]):
+        p0 = Variable('p0', dtype=np.int32, initial=0)
+        p1 = Variable('p1', dtype=np.int32, initial=1)
+    pset = ParticleSet(fieldset, pclass=TestParticle, lon=0, lat=0)
+
+    def kernel(particle, fieldset, time):
+        tmp = 0
+        if tmp > 0:
+            if particle.p1 >= particle.p0:
+                particle.p1 = -1
+
+    pset.execute(kernel, endtime=10, dt=1.)
+    assert np.allclose([pset[0].p0, pset[0].p1], [0, 1])
+
+
+@pytest.mark.parametrize('mode', ['scipy', 'jit'])
+def test_nested_if_runs_when_both_conditions_are_true(fieldset, mode):
+    """An inner body runs when its own condition and its enclosing condition hold."""
+    class TestParticle(ptype[mode]):
+        p0 = Variable('p0', dtype=np.int32, initial=0)
+        p1 = Variable('p1', dtype=np.int32, initial=1)
+    pset = ParticleSet(fieldset, pclass=TestParticle, lon=0, lat=0)
+
+    def kernel(particle, fieldset, time):
+        if particle.p0 == 0:
+            if particle.p1 >= particle.p0:
+                particle.p1 = -1
+
+    pset.execute(kernel, endtime=1, dt=1.)
+    assert np.allclose([pset[0].p0, pset[0].p1], [0, -1])
+
+
+@pytest.mark.parametrize('mode', ['scipy', 'jit'])
+def test_nested_if_does_not_run_when_inner_condition_is_false(fieldset, mode):
+    """A true enclosing condition must not make a false inner condition run."""
+    class TestParticle(ptype[mode]):
+        p0 = Variable('p0', dtype=np.int32, initial=0)
+        p1 = Variable('p1', dtype=np.int32, initial=1)
+    pset = ParticleSet(fieldset, pclass=TestParticle, lon=0, lat=0)
+
+    def kernel(particle, fieldset, time):
+        if particle.p0 == 0:
+            if particle.p1 < particle.p0:
+                particle.p1 = -1
+
+    pset.execute(kernel, endtime=1, dt=1.)
+    assert np.allclose([pset[0].p0, pset[0].p1], [0, 1])
+
+
+def test_parcels_tmpvar_in_kernel(fieldset):
+    """Test that a kernel-local variable whose name contains 'tmp' is accepted
+    and does not break the code generation of nested if-statements (issue #541)."""
+    class TestParticle(JITParticle):
+        p0 = Variable('p0', dtype=np.int32, initial=0)
+        p1 = Variable('p1', dtype=np.int32, initial=1)
+    pset = ParticleSet(fieldset, pclass=TestParticle, lon=0, lat=0)
+
+    def kernel_tmpvar(particle, fieldset, time):
+        tmp = 0
+        if tmp > 0:
+            if particle.p1 >= particle.p0:
+                particle.p1 = -1
+
+    pset.execute(kernel_tmpvar, endtime=1, dt=1.)
+    assert np.allclose([pset[0].p0, pset[0].p1], [0, 1])
+
+
