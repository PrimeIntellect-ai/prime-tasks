+
+
+class TestWriteToMarkdownHideItemsClosedCount(unittest.TestCase):
+    """Verify the closed-count row follows the HIDE_ITEMS_CLOSED_COUNT setting."""
+
+    def _write_report(self):
+        issues_with_metrics = [
+            IssueWithMetrics(
+                title="Issue 1",
+                html_url="https://github.com/user/repo/issues/1",
+                author="alice",
+                time_to_first_response=timedelta(minutes=10),
+                time_to_close=timedelta(days=1),
+                time_to_answer=timedelta(hours=2),
+                labels_metrics={},
+            ),
+        ]
+        hide_count = get_env_vars(test=True).hide_items_closed_count
+        write_to_markdown(
+            issues_with_metrics,
+            None,
+            None,
+            None,
+            {},
+            2,
+            2,
+            5,
+            [],
+            "repo:user/repo is:issue",
+            False,
+            hide_items_closed_count=hide_count,
+        )
+        with open("issue_metrics.md", "r", encoding="utf-8") as file:
+            content = file.read()
+        os.remove("issue_metrics.md")
+        return content
+
+    @patch.dict(
+        os.environ,
+        {
+            "SEARCH_QUERY": "repo:user/repo is:issue",
+            "GH_TOKEN": "test_token",
+            "HIDE_ITEMS_CLOSED_COUNT": "true",
+        },
+        clear=True,
+    )
+    def test_true_omits_closed_count_row(self):
+        content = self._write_report()
+        self.assertNotIn("Number of items closed", content)
+        self.assertIn("Number of items that remain open", content)
+
+    @patch.dict(
+        os.environ,
+        {
+            "SEARCH_QUERY": "repo:user/repo is:issue",
+            "GH_TOKEN": "test_token",
+            "HIDE_ITEMS_CLOSED_COUNT": "false",
+        },
+        clear=True,
+    )
+    def test_false_keeps_closed_count_row(self):
+        content = self._write_report()
+        self.assertIn("Number of items closed", content)
+
+    @patch.dict(
+        os.environ,
+        {
+            "SEARCH_QUERY": "repo:user/repo is:issue",
+            "GH_TOKEN": "test_token",
+        },
+        clear=True,
+    )
+    def test_unset_keeps_closed_count_row(self):
+        content = self._write_report()
+        self.assertIn("Number of items closed", content)
