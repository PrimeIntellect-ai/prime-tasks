@@ -1281,3 +1282,95 @@ func TestRouteClusterNameConflictBetweenStaticAndDynamic(t *testing.T) {
 
 	checkClusterFormed(t, s1, s2)
 }
+
+type testRouteResolver struct{}
+
+func (r *testRouteResolver) LookupHost(ctx context.Context, host string) ([]string, error) {
+	return []string{"127.0.0.1", "127.0.0.2"}, nil
+}
+
+func TestRouteIPResolutionAndRouteToSelf(t *testing.T) {
+	// Server that is reachable through the resolved (non-self) IP.
+	ob := DefaultOptions()
+	ob.Cluster.Host = "127.0.0.2"
+	ob.Cluster.Port = 1234
+	sb, err := NewServer(ob)
+	if err != nil {
+		t.Fatalf("Error creating server: %v", err)
+	}
+	defer sb.Shutdown()
+	go sb.Start()
+	if !sb.ReadyForConnections(5 * time.Second) {
+		t.Fatalf("Failed to start server")
+	}
+
+	// Server that solicits a route to a hostname that resolves to both its own
+	// IP and the other server's IP. It must skip its own IP and use the other.
+	oa := DefaultOptions()
+	oa.Cluster.Host = "127.0.0.1"
+	oa.Cluster.Port = 1234
+	oa.Cluster.resolver = &testRouteResolver{}
+	oa.Routes = RoutesFromStr("nats://routehost:1234")
+	sa, err := NewServer(oa)
+	if err != nil {
+		t.Fatalf("Error creating server: %v", err)
+	}
+	defer sa.Shutdown()
+	go sa.Start()
+	if !sa.ReadyForConnections(5 * time.Second) {
+		t.Fatalf("Failed to start server")
+	}
+
+	checkClusterFormed(t, sa, sb)
+}
+
+type selfOnlyResolver struct{}
+
+func (r *selfOnlyResolver) LookupHost(ctx context.Context, host string) ([]string, error) {
+	return []string{"127.0.0.1"}, nil
+}
+
+type selfRouteLogger struct {
+	DummyLogger
+	mu       sync.Mutex
+	selfSeen bool
+}
+
+func (l *selfRouteLogger) Debugf(format string, v ...interface{}) {
+	if strings.Contains(fmt.Sprintf(format, v...), "Detected route to self") {
+		l.mu.Lock()
+		l.selfSeen = true
+		l.mu.Unlock()
+	}
+}
+
+func TestRouteExcludesSelfIP(t *testing.T) {
+	o := DefaultOptions()
+	o.Cluster.Host = "127.0.0.1"
+	o.Cluster.Port = 1234
+	o.Cluster.resolver = &selfOnlyResolver{}
+	o.Routes = RoutesFromStr("nats://routehost:1234")
+	o.Debug = true
+	o.NoLog = false
+	s, err := NewServer(o)
+	if err != nil {
+		t.Fatalf("Error creating server: %v", err)
+	}
+	defer s.Shutdown()
+	l := &selfRouteLogger{}
+	s.SetLogger(l, true, true)
+	go s.Start()
+	if !s.ReadyForConnections(5 * time.Second) {
+		t.Fatalf("Failed to start server")
+	}
+
+	// The route hostname only resolves to this server's own address, so the
+	// server must not attempt to connect to itself.
+	time.Sleep(500 * time.Millisecond)
+
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.selfSeen {
+		t.Fatalf("Server attempted to connect to its own route address")
+	}
+}
