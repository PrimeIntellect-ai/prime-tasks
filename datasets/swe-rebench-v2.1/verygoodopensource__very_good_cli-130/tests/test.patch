@@ -0,0 +1,63 @@
+import 'package:test/test.dart';
+import 'package:universal_io/io.dart';
+import 'package:very_good_cli/src/flutter_cli.dart';
+
+/// The path of the file the fake `flutter` executable appends its working
+/// directory to whenever it installs packages.
+const flutterCallsPath = '/tmp/rebench_flutter_calls';
+
+/// Installs a fake `flutter` executable on the `PATH` so that the behaviour of
+/// [Flutter.packagesGet] can be exercised without a real Flutter installation.
+///
+/// The fake mimics installing packages: it succeeds when the working directory
+/// contains a `pubspec.yaml` and fails otherwise.
+void installFakeFlutter() {
+  const script = '''
+#!/bin/sh
+if [ "\$1" = "packages" ] || [ "\$1" = "pub" ]; then
+  if [ -f pubspec.yaml ]; then
+    echo "\$PWD" >> $flutterCallsPath
+    exit 0
+  else
+    echo "Error: No pubspec.yaml file found." >&2
+    exit 1
+  fi
+fi
+exit 0
+''';
+  final candidates = <String>[
+    '/usr/local/bin',
+    ...(Platform.environment['PATH'] ?? '').split(':'),
+  ];
+  for (final dir in candidates) {
+    if (dir.isEmpty) continue;
+    try {
+      final file = File('$dir/flutter');
+      file.writeAsStringSync(script);
+      Process.runSync('chmod', ['+x', file.path]);
+      return;
+    } catch (_) {
+      continue;
+    }
+  }
+  throw StateError('Unable to install a fake flutter executable.');
+}
+
+void main() {
+  setUpAll(installFakeFlutter);
+
+  group('Flutter CLI', () {
+    group('packages get', () {
+      test('throws when there is no pubspec.yaml', () {
+        expectLater(
+          Flutter.packagesGet(Directory.systemTemp.path),
+          throwsException,
+        );
+      });
+
+      test('completes when there is a pubspec.yaml', () {
+        expectLater(Flutter.packagesGet(), completes);
+      });
+    });
+  });
+}
