+
+#[test]
+fn test_unqualified_to_qualified_import_variable_shadowing() {
+    let src = r#"
+
+import wibble.{wobble}
+
+pub fn example() {
+  echo wobble
+
+  let wobble = 1
+
+  echo wobble
+
+  let _ = fn(wobble) {
+    echo wobble
+  }
+
+  let _ = case #(1, 2) {
+    #(wobble, _) -> echo wobble
+  }
+
+  todo
+}
+"#;
+
+    let actual = apply_code_action(
+        "Qualify wobble as wibble.wobble",
+        TestProject::for_source(src).add_hex_module("wibble", "pub fn wobble() { todo }"),
+        find_position_of("wob")
+            .nth_occurrence(2)
+            .select_until(find_position_of("ble").nth_occurrence(3))
+            .find_range(src),
+    );
+
+    assert!(actual.contains("echo wibble.wobble"));
+    assert!(actual.contains("let wobble = 1\n\n  echo wobble"));
+    assert!(actual.contains("fn(wobble) {\n    echo wobble"));
+    assert!(actual.contains("#(wobble, _) -> echo wobble"));
+}
