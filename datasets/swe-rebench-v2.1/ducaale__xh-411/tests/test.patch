+
+/// Behavioural tests for the response body decoder.
+///
+/// A response that declares a `Content-Encoding` but has an empty body must not
+/// make xh panic. These exercise the decoder through the CLI so they stay
+/// black-box.
+mod decoder {
+    mod tests {
+        use super::super::*;
+
+        fn empty_zstd_response() -> server::Server {
+            server::http(|_req| async move {
+                hyper::Response::builder()
+                    .header("date", "N/A")
+                    .header("content-encoding", "zstd")
+                    .header("content-length", "100")
+                    .body("".into())
+                    .unwrap()
+            })
+        }
+
+        #[test]
+        fn empty_inputs_do_not_cause_errors() {
+            let server = empty_zstd_response();
+            get_command()
+                .arg("head")
+                .arg(server.base_url())
+                .assert()
+                .success();
+        }
+
+        #[test]
+        fn read_errors_keep_their_context() {
+            let server = empty_zstd_response();
+            get_command()
+                .arg("--stream")
+                .arg("head")
+                .arg(server.base_url())
+                .assert()
+                .success();
+        }
+
+        #[test]
+        fn true_decode_errors_are_preserved() {
+            let server = empty_zstd_response();
+            get_command()
+                .arg("--print=hb")
+                .arg("head")
+                .arg(server.base_url())
+                .assert()
+                .success();
+        }
+    }
+}
