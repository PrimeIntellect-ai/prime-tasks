+// assertFieldsFormat verifies that each field of the record is emitted on its own
+// line, with the field name and its value on the same line.
+func assertFieldsFormat(t *testing.T, out string, fields map[string]string) {
+	t.Helper()
+	lines := strings.Split(out, "\n")
+	for name, value := range fields {
+		var matching []string
+		for _, line := range lines {
+			if strings.Contains(line, name) {
+				matching = append(matching, line)
+			}
+		}
+		require.Len(t, matching, 1, "expected field %q on exactly one line, got output:\n%s", name, out)
+		assert.Contains(t, matching[0], value, "line for field %q should contain its value", name)
+	}
+	for _, line := range lines {
+		count := 0
+		for name := range fields {
+			if strings.Contains(line, name) {
+				count++
+			}
+		}
+		assert.LessOrEqual(t, count, 1, "line %q should not contain more than one field", line)
+	}
+}
