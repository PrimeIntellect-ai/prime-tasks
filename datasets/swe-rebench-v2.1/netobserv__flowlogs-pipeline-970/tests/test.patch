+func TestLoki_ProcessRecordOrdered(t *testing.T) {
+	params := api.WriteLoki{
+		URL:            "http://loki:3100/",
+		TimestampLabel: "ts",
+	}
+	reorderConfig, err := json.Marshal(map[string]bool{"reorder": true})
+	require.NoError(t, err)
+	require.NoError(t, json.Unmarshal(reorderConfig, &params))
+	loki, err := NewWriteLoki(operational.NewMetrics(&config.MetricsSettings{}), config.StageParam{Write: &config.Write{Loki: &params}})
+	require.NoError(t, err)
+
+	ce := &captureEmitter{}
+	loki.client = ce
+
+	require.NoError(t, loki.ProcessRecord(map[string]interface{}{"ts": 123456, "c": "c", "e": "e", "a": "a", "d": "d", "b": "b"}))
+
+	require.Len(t, ce.records, 1)
+	var parsed map[string]interface{}
+	require.NoError(t, json.Unmarshal([]byte(ce.records[0]), &parsed))
+	assert.Equal(t, map[string]interface{}{"a": "a", "b": "b", "c": "c", "d": "d", "e": "e", "ts": float64(123456)}, parsed)
+	previous := -1
+	for _, key := range []string{"a", "b", "c", "d", "e", "ts"} {
+		position := strings.Index(ce.records[0], `"`+key+`"`)
+		require.NotEqual(t, -1, position, "JSON object should contain key %q", key)
+		assert.Greater(t, position, previous, "JSON keys should be alphabetically ordered")
+		previous = position
+	}
+}
