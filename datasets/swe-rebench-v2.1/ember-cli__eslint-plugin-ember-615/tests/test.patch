+
+describe('linting native classes extended with a mixin', () => {
+  it('does not fail while resolving the superclass module', () => {
+    const Linter = require('eslint').Linter;
+    const linter = new Linter();
+    linter.defineParser('babel-eslint', require('babel-eslint'));
+    linter.defineRule('no-actions-hash', require('../../../lib/rules/no-actions-hash'));
+    linter.defineRule(
+      'require-tagless-components',
+      require('../../../lib/rules/require-tagless-components')
+    );
+
+    const code = `
+      import Component from '@ember/component';
+      import ResizeAware from './resize-aware';
+      export default class extends Component.extend(ResizeAware) {
+        tagName = '';
+      }
+    `;
+    const messages = linter.verify(code, {
+      parser: 'babel-eslint',
+      parserOptions: {
+        ecmaVersion: 2018,
+        sourceType: 'module',
+      },
+      rules: {
+        'no-actions-hash': 'error',
+        'require-tagless-components': 'error',
+      },
+    });
+
+    expect(messages.some(message => message.fatal)).toBe(false);
+  });
+});
