+        createOrUpdateDynamicTheme(testTheme, wikipediaFixes, false);
+        const legendOverride = legend.style.getPropertyValue('--darkreader-inline-bgcolor');
+        if (legendOverride) {
+            expect(parseColor(legendOverride)).toBe(legendColorBefore);
