+private fun openApiBehaviorTestAllSerializers(
+  routeUnderTest: Routing.() -> Unit,
+  validateOpenApi: (String) -> Unit
+) {
+  listOf(SupportedSerializer.KOTLINX, SupportedSerializer.JACKSON, SupportedSerializer.GSON).forEach { serializer ->
+    testApplication {
+      install(NotarizedApplication()) {
+        spec = defaultSpec()
+      }
+      install(ContentNegotiation) {
+        when (serializer) {
+          SupportedSerializer.KOTLINX -> json(Json {
+            encodeDefaults = true
+            explicitNulls = false
+            serializersModule = KompendiumSerializersModule.module
+          })
+          SupportedSerializer.GSON -> gson()
+          SupportedSerializer.JACKSON -> jackson(ContentType.Application.Json) {
+            enable(SerializationFeature.INDENT_OUTPUT)
+            setSerializationInclusion(JsonInclude.Include.NON_NULL)
+          }
+        }
+      }
+      routing {
+        redoc()
+        routeUnderTest()
+      }
+      val response = client.get("/openapi.json")
+      response shouldHaveStatus HttpStatusCode.OK
+      val body = response.bodyAsText()
+      body shouldNot beBlank()
+      validateOpenApi(body)
+    }
+  }
+}
+
+private fun JsonObject.responseSchema(): JsonObject {
+  val getOperation = this["paths"]!!.jsonObject["/"]!!.jsonObject["get"]!!.jsonObject
+  val response = getOperation["responses"]!!.jsonObject["200"]!!.jsonObject
+  val responseSchema = response["content"]!!.jsonObject["application/json"]!!.jsonObject["schema"]!!.jsonObject
+  return resolveSchema(responseSchema)
+}
+
+private fun JsonObject.resolveSchema(schema: JsonObject): JsonObject {
+  val reference = schema["\$ref"]?.jsonPrimitive?.content ?: return schema
+  val componentName = reference.substringAfterLast('/')
+  val componentSchema = this["components"]!!.jsonObject["schemas"]!!.jsonObject[componentName]!!.jsonObject
+  return resolveSchema(componentSchema)
+}
