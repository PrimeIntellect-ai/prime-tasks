+package xmpp_test
+
+import (
+	"encoding/xml"
+	"fmt"
+	"net"
+	"testing"
+	"time"
+
+	"gosrc.io/xmpp"
+)
+
+// TestClient_Disconnect checks that a connected client can be closed and that
+// closing it actually terminates the underlying connection.
+func TestClient_Disconnect(t *testing.T) {
+	const address = "localhost:15223"
+
+	closed := make(chan struct{})
+	mock := xmpp.ServerMock{}
+	mock.Start(t, address, func(t *testing.T, conn net.Conn) {
+		if err := serveHandshake(conn); err != nil {
+			return
+		}
+		// Wait until the client closes the connection.
+		decoder := xml.NewDecoder(conn)
+		for {
+			if _, err := decoder.Token(); err != nil {
+				close(closed)
+				return
+			}
+		}
+	})
+	defer mock.Stop()
+
+	config := xmpp.Config{Address: address, Jid: "test@localhost", Password: "test", Insecure: true}
+	client, err := xmpp.NewClient(config)
+	if err != nil {
+		t.Fatalf("cannot create XMPP client: %s", err)
+	}
+	if _, err = client.Connect(); err != nil {
+		t.Fatalf("XMPP connection failed: %s", err)
+	}
+
+	client.Disconnect()
+
+	select {
+	case <-closed:
+	case <-time.After(2 * time.Second):
+		t.Error("client did not close the connection")
+	}
+}
+
+//=============================================================================
+// Minimal XMPP server handshake used to obtain a connected client.
+
+const (
+	serverStreamOpen = "<?xml version='1.0'?><stream:stream to='localhost' id='streamid1' xmlns='jabber:client' xmlns:stream='http://etherx.jabber.org/streams' version='1.0'>"
+	saslFeatures     = `<stream:features><mechanisms xmlns="urn:ietf:params:xml:ns:xmpp-sasl"><mechanism>PLAIN</mechanism></mechanisms></stream:features>`
+	bindFeatures     = `<stream:features><bind xmlns='urn:ietf:params:xml:ns:xmpp-bind'/></stream:features>`
+	bindResult       = "<iq id='%s' type='result'><bind xmlns='urn:ietf:params:xml:ns:xmpp-bind'><jid>test@localhost/test</jid></bind></iq>"
+)
+
+func serveHandshake(conn net.Conn) error {
+	decoder := xml.NewDecoder(conn)
+
+	// Client opens the stream.
+	if _, err := readStartElement(decoder, "stream"); err != nil {
+		return err
+	}
+	if _, err := fmt.Fprint(conn, serverStreamOpen); err != nil {
+		return err
+	}
+	if _, err := fmt.Fprint(conn, saslFeatures); err != nil {
+		return err
+	}
+
+	// Client authenticates.
+	if _, err := readStartElement(decoder, "auth"); err != nil {
+		return err
+	}
+	if err := decoder.Skip(); err != nil {
+		return err
+	}
+	if _, err := fmt.Fprint(conn, `<success xmlns="urn:ietf:params:xml:ns:xmpp-sasl"/>`); err != nil {
+		return err
+	}
+
+	// Client reopens the stream after authentication.
+	if _, err := readStartElement(decoder, "stream"); err != nil {
+		return err
+	}
+	if _, err := fmt.Fprint(conn, serverStreamOpen); err != nil {
+		return err
+	}
+	if _, err := fmt.Fprint(conn, bindFeatures); err != nil {
+		return err
+	}
+
+	// Client binds a resource.
+	se, err := readStartElement(decoder, "iq")
+	if err != nil {
+		return err
+	}
+	id := ""
+	for _, attr := range se.Attr {
+		if attr.Name.Local == "id" {
+			id = attr.Value
+		}
+	}
+	if err := decoder.Skip(); err != nil {
+		return err
+	}
+	if _, err := fmt.Fprintf(conn, bindResult, id); err != nil {
+		return err
+	}
+	return nil
+}
+
+func readStartElement(decoder *xml.Decoder, local string) (xml.StartElement, error) {
+	for {
+		tok, err := decoder.Token()
+		if err != nil {
+			return xml.StartElement{}, err
+		}
+		if se, ok := tok.(xml.StartElement); ok && se.Name.Local == local {
+			return se, nil
+		}
+	}
+}
