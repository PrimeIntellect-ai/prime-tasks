+def test_datetime64_utc_supported(tmp_hyper):
+    """A datetime64[ns, UTC] column can be written to a hyper extract."""
+    df = pd.DataFrame({"a": pd.to_datetime(["2018-01-01", "2019-01-01"], utc=True)})
+    pantab.frame_to_hyper(df, tmp_hyper, table="test")
+    assert tmp_hyper.exists()
+
+
+def test_datetime64_utc_roundtrip_preserves_values_and_dtype(tmp_hyper):
+    """UTC timestamps retain their values and timezone when read back."""
+    expected = pd.DataFrame(
+        {"a": pd.to_datetime(["2018-01-01", "2019-01-01"], utc=True)}
+    )
+    pantab.frame_to_hyper(expected, tmp_hyper, table="test")
+
+    result = pantab.frame_from_hyper(tmp_hyper, table="test")
+
+    tm.assert_series_equal(pd.to_datetime(result["a"], utc=True), expected["a"])
+    assert result["a"].dtype == "datetime64[ns, UTC]"
+
