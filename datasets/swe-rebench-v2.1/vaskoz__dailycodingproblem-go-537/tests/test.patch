+package day260
+
+import (
+	"fmt"
+	"testing"
+)
+
+var testcases = [][]rune{
+	{'+', '+', '-', '+'},
+}
+
+func TestUnjumble(t *testing.T) {
+	check := func(hints []rune) {
+		t.Helper()
+		result := Unjumble(hints)
+		if len(result) != len(hints)+1 {
+			t.Errorf("Unjumble(%q) returned %v, want a permutation of length %d", string(hints), result, len(hints)+1)
+			return
+		}
+
+		seen := make([]bool, len(hints)+1)
+		for i, value := range result {
+			if value < 0 || value > len(hints) {
+				t.Errorf("Unjumble(%q) returned out-of-range value %d in %v", string(hints), value, result)
+				return
+			}
+			if seen[value] {
+				t.Errorf("Unjumble(%q) returned duplicate value %d in %v", string(hints), value, result)
+				return
+			}
+			seen[value] = true
+			if i == 0 {
+				continue
+			}
+			switch hints[i-1] {
+			case '+':
+				if result[i] <= result[i-1] {
+					t.Errorf("Unjumble(%q) returned %v, but clue %d requires an increase", string(hints), result, i-1)
+					return
+				}
+			case '-':
+				if result[i] >= result[i-1] {
+					t.Errorf("Unjumble(%q) returned %v, but clue %d requires a decrease", string(hints), result, i-1)
+					return
+				}
+			default:
+				t.Errorf("unknown test clue %q", hints[i-1])
+				return
+			}
+		}
+	}
+
+	for _, hints := range testcases {
+		check(hints)
+	}
+	// Exercise every possible clue sequence through six adjacent comparisons.
+	for length := 0; length <= 6; length++ {
+		for pattern := 0; pattern < 1<<length; pattern++ {
+			hints := make([]rune, length)
+			for i := range hints {
+				if pattern&(1<<i) == 0 {
+					hints[i] = '+'
+				} else {
+					hints[i] = '-'
+				}
+			}
+			t.Run(fmt.Sprintf("length_%d_pattern_%d", length, pattern), func(t *testing.T) {
+				check(hints)
+			})
+		}
+	}
+}
+
+func BenchmarkUnjumble(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, hints := range testcases {
+			Unjumble(hints)
+		}
+	}
+}
