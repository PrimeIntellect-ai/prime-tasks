+
+test('logging a warning after repeated process listeners does not throw a TypeError', async ({ is }) => {
+  const stream = sink()
+  const logger = pino({ level: 'info' }, stream)
+  const eventName = `pino-warning-regression-${process.pid}`
+  const listener = () => {}
+  let resolveWarning
+  const warningHandled = new Promise(resolve => { resolveWarning = resolve })
+  const onWarning = warning => {
+    process.removeListener('warning', onWarning)
+    try {
+      logger.info(warning)
+      resolveWarning(null)
+    } catch (error) {
+      resolveWarning(error)
+    }
+  }
+
+  process.on('warning', onWarning)
+  for (let i = 0; i < 11; i++) process.on(eventName, listener)
+
+  try {
+    const error = await warningHandled
+    is(error instanceof TypeError, false, 'warning logging does not throw a TypeError')
+  } finally {
+    process.removeListener('warning', onWarning)
+    process.removeAllListeners(eventName)
+  }
+})
