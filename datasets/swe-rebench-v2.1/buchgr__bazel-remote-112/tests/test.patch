+func TestUploadEmptyActionResult(t *testing.T) {
+	cacheDir := testutils.CreateTmpCacheDirs(t)
+	defer os.RemoveAll(cacheDir)
+
+	data, hash := testutils.RandomDataAndHash(0)
+
+	r, err := http.NewRequest("PUT", "/ac/"+hash, bytes.NewReader(data))
+	if err != nil {
+		t.Error(err)
+	}
+
+	c := disk.New(cacheDir, 2048)
+	validate := true
+	h := NewHTTPCache(c, testutils.NewSilentLogger(), testutils.NewSilentLogger(), validate)
+	rr := httptest.NewRecorder()
+	handler := http.HandlerFunc(h.CacheHandler)
+	handler.ServeHTTP(rr, r)
+
+	if status := rr.Code; status >= 200 && status < 300 {
+		t.Error("Handler returned success for an empty ActionResult upload")
+	}
+
+	rdr, _, err := c.Get(cache.AC, hash)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rdr != nil {
+		rdr.Close()
+		t.Error("empty ActionResult was admitted to the cache")
+	}
+}
+
+func TestServeCachedEmptyActionResult(t *testing.T) {
+	cacheDir := testutils.CreateTmpCacheDirs(t)
+	defer os.RemoveAll(cacheDir)
+
+	data, hash := testutils.RandomDataAndHash(0)
+	c := disk.New(cacheDir, 2048)
+	if err := c.Put(cache.RAW, hash, 0, bytes.NewReader(data)); err != nil {
+		t.Fatal(err)
+	}
+
+	h := NewHTTPCache(c, testutils.NewSilentLogger(), testutils.NewSilentLogger(), false)
+	req, err := http.NewRequest(http.MethodGet, "/ac/"+hash, bytes.NewReader(nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	rr := httptest.NewRecorder()
+	h.CacheHandler(rr, req)
+
+	if rr.Code != http.StatusOK {
+		t.Fatalf("cached empty ActionResult returned HTTP %d, want %d", rr.Code, http.StatusOK)
+	}
+	if body := rr.Body.Bytes(); len(body) != 0 {
+		t.Fatalf("cached empty ActionResult returned %d bytes, want 0", len(body))
+	}
+}
