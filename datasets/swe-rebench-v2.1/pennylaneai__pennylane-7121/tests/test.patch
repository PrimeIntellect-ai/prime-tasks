+    def test_gen_is_multi_term_hamiltonian_qnode_spectrum(self):
+        """Test that qnode_spectrum is independent of how an equivalent generator is defined."""
+        dev = qml.device("default.qubit", wires=4, shots=None)
+
+        class MySingleExcitation(qml.SingleExcitation):
+            def generator(self):
+                w1, w2 = self.wires
+                return -0.25 * qml.PauliY(w1) @ qml.PauliX(w2) + 0.25 * qml.PauliX(w1) @ qml.PauliY(w2)
+
+        spectra = []
+        for gate in (qml.SingleExcitation, MySingleExcitation):
+
+            @qml.qnode(dev)
+            def qnode(params):
+                qml.PauliX(wires=0)
+                qml.PauliX(wires=1)
+                qml.OrbitalRotation(0.4, wires=range(4), id="OrbitalRotation")
+                gate(params[0], wires=range(2), id="ReFermionEx")
+                return qml.expval(qml.PauliZ(wires=0))
+
+            params = pnp.array([0.1], requires_grad=True)
+            spectra.append(qml.fourier.qnode_spectrum(qnode)(params))
+
+        assert spectra[0] == spectra[1]
+
     def test_has_multipar(self):
         """Test has_multipar criterion."""
         assert not qml.operation.has_multipar(self.rx)
