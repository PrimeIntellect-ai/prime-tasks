+    def test_submodule_src_loc_emitted(self):
+        from amaranth.back import rtlil
+
+        o = Signal()
+        top_src_line = inspect.currentframe().f_lineno + 1
+        m = Module()
+        sub_src_line = inspect.currentframe().f_lineno + 1
+        sub = Module()
+        sub.d.sync += o.eq(~o)
+        cell_src_line = inspect.currentframe().f_lineno + 1
+        m.submodules.sub = sub
+        text = rtlil.convert(m, ports=[o])
+
+        def attrs_before(decl):
+            lines = text.splitlines()
+            for i, line in enumerate(lines):
+                if line.strip() == decl:
+                    attrs = []
+                    j = i - 1
+                    while j >= 0 and lines[j].strip().startswith("attribute "):
+                        attrs.append(lines[j].strip())
+                        j -= 1
+                    return attrs
+            self.fail(f"declaration {decl!r} not found in RTLIL output")
+
+        declarations = [
+            line.strip() for line in text.splitlines()
+            if line.strip().startswith(("module ", "cell "))
+        ]
+        for declaration in declarations:
+            self.assertTrue(any(
+                attr.startswith("attribute \\src ")
+                for attr in attrs_before(declaration)
+            ))
+
+        expected_locations = {
+            "module \\top": top_src_line,
+            "module \\top.sub": sub_src_line,
+            "cell \\top.sub \\sub": cell_src_line,
+        }
+        for declaration, source_line in expected_locations.items():
+            src_attrs = [a for a in attrs_before(declaration) if a.startswith("attribute \\src ")]
+            self.assertTrue(src_attrs)
+            self.assertTrue(any(
+                __file__.rsplit("/", 1)[-1] in src_attr and f":{source_line}" in src_attr
+                for src_attr in src_attrs
+            ))
+
+    def test_anonymous_submodule_src_loc_emitted(self):
+        from amaranth.back import rtlil
+
+        o = Signal()
+        m = Module()
+        sub = Module()
+        sub.d.sync += o.eq(~o)
+        cell_src_line = inspect.currentframe().f_lineno + 1
+        m.submodules += sub
+        text = rtlil.convert(m, ports=[o])
+
+        lines = text.splitlines()
+        matching_cell_sources = []
+        for cell_index, line in enumerate(lines):
+            if not line.strip().startswith("cell "):
+                continue
+            i = cell_index - 1
+            while i >= 0 and lines[i].strip().startswith("attribute "):
+                attr = lines[i].strip()
+                if attr.startswith("attribute \\src "):
+                    matching_cell_sources.append(attr)
+                i -= 1
+        self.assertTrue(any(
+            __file__.rsplit("/", 1)[-1] in attr and f":{cell_src_line}" in attr
+            for attr in matching_cell_sources
+        ))
+
