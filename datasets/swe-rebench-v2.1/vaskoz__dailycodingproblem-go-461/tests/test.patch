+package day223
+
+import (
+	"reflect"
+	"runtime"
+	"testing"
+)
+
+var testcases = []struct {
+	root    *BinaryTree
+	inorder []interface{}
+}{
+	{
+		root: &BinaryTree{
+			Value: 1,
+			Left: &BinaryTree{
+				Value: 2,
+				Left:  &BinaryTree{Value: 4},
+				Right: &BinaryTree{Value: 5},
+			},
+			Right: &BinaryTree{Value: 3},
+		},
+		inorder: []interface{}{4, 2, 5, 1, 3},
+	},
+}
+
+func TestInorderMorrisTraversal(t *testing.T) {
+	for _, tc := range testcases {
+		if result := InorderMorrisTraversal(tc.root); !reflect.DeepEqual(tc.inorder, result) {
+			t.Errorf("Expected %v, got %v", tc.inorder, result)
+		}
+	}
+}
+
+var traversalResultSink []interface{}
+
+func skewedTree(n int, left bool) *BinaryTree {
+	var root *BinaryTree
+	if left {
+		for value := 0; value < n; value++ {
+			root = &BinaryTree{Value: value, Left: root}
+		}
+		return root
+	}
+	for value := n - 1; value >= 0; value-- {
+		root = &BinaryTree{Value: value, Right: root}
+	}
+	return root
+}
+
+func traversalAllocatedBytes(root *BinaryTree, repetitions int) uint64 {
+	var before, after runtime.MemStats
+	runtime.ReadMemStats(&before)
+	for i := 0; i < repetitions; i++ {
+		traversalResultSink = InorderMorrisTraversal(root)
+	}
+	runtime.ReadMemStats(&after)
+	return after.TotalAlloc - before.TotalAlloc
+}
+
+func TestInorderTraversalAuxiliarySpaceDoesNotGrowWithHeight(t *testing.T) {
+	const nodeCount = 4096
+	const repetitions = 2
+	leftSkewed := skewedTree(nodeCount, true)
+	rightSkewed := skewedTree(nodeCount, false)
+
+	leftBytes := traversalAllocatedBytes(leftSkewed, repetitions)
+	rightBytes := traversalAllocatedBytes(rightSkewed, repetitions)
+	// These trees have the same number of nodes and produce the same values in
+	// the same order, so result-slice allocations should be comparable. A
+	// height-sized traversal stack costs substantially more for the left chain.
+	const tolerancePerNode = 2
+	if leftBytes > rightBytes+repetitions*nodeCount*tolerancePerNode {
+		t.Fatalf("allocation grew with tree height: left-skewed=%d bytes, right-skewed=%d bytes", leftBytes, rightBytes)
+	}
+}
+
+func BenchmarkInorderMorrisTraversal(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			InorderMorrisTraversal(tc.root)
+		}
+	}
+}
