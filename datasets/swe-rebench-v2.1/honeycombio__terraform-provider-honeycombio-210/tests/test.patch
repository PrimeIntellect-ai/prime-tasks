+func TestBoardColumnStyleValues_BoardFieldType(t *testing.T) {
+	field, ok := reflect.TypeOf(Board{}).FieldByName("ColumnLayout")
+	if !ok {
+		t.Fatal("Board does not expose a ColumnLayout field")
+	}
+	if field.PkgPath != "" {
+		t.Errorf("Board.ColumnLayout is not public")
+	}
+	if want := reflect.TypeOf(BoardColumnStyle("")); field.Type != want {
+		t.Errorf("Board.ColumnLayout type = %v, want %v", field.Type, want)
+	}
