+// TestBoard_columnLayoutListStyleError verifies that a list style board cannot
+// specify a column layout. The rejection may happen while the configuration is
+// planned or when the board is created, so both paths are checked.
+func TestBoard_columnLayoutListStyleError(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"id":"board-1","name":"test board","style":"list","queries":[]}`))
+	}))
+	defer srv.Close()
+
+	c, err := honeycombio.NewClient(&honeycombio.Config{APIKey: "test-key", APIUrl: srv.URL})
+	if err != nil {
+		t.Fatalf("could not create client: %v", err)
+	}
+
+	r := Provider().ResourcesMap["honeycombio_board"]
+	if r == nil {
+		t.Fatal("honeycombio_board resource is not registered")
+	}
+
+	const wantMsg = "list style boards cannot specify a column layout"
+
+	// Path 1: planning the configuration.
+	cfg := terraform.NewResourceConfigRaw(map[string]interface{}{
+		"name":          "test board",
+		"style":         "list",
+		"column_layout": "multi",
+	})
+	if _, planErr := r.Diff(context.Background(), nil, cfg, c); planErr != nil {
+		if !strings.Contains(planErr.Error(), wantMsg) {
+			t.Fatalf("unexpected plan error message: %v", planErr)
+		}
+		return
+	}
+
+	// Path 2: creating the board.
+	d := r.TestResourceData()
+	_ = d.Set("name", "test board")
+	_ = d.Set("style", "list")
+	_ = d.Set("column_layout", "multi")
+
+	diags := r.CreateContext(context.Background(), d, c)
+	if !diags.HasError() {
+		t.Fatal("expected an error when a list style board specifies a column layout")
+	}
+	var msgs []string
+	for _, d := range diags {
+		msgs = append(msgs, d.Summary, d.Detail)
+	}
+	if !strings.Contains(strings.Join(msgs, " "), wantMsg) {
+		t.Fatalf("unexpected error message: %v", diags)
+	}
+}
