+
+@testset "Broadcasting against Tuples" begin
+    # https://github.com/invenia/NamedDims.jl/issues/140
+    nda = NamedDimsArray(zeros(4), :foo)
+    lhs = nda .+ (1,2,3,4)
+    @test lhs isa NamedDimsArray
+    @test dimnames(lhs) == (:foo,)
+    @test lhs == [1, 2, 3, 4]
+
+    rhs = (1,2,3,4) .+ nda
+    @test rhs isa NamedDimsArray
+    @test dimnames(rhs) == (:foo,)
+    @test rhs == [1, 2, 3, 4]
+
+    g = (x, y) -> x + 1
+    @test g.(nda, (1,2,3,4)) == ones(4)
+    @test g.((1,2,3,4), nda) == [2, 3, 4, 5]
+end
