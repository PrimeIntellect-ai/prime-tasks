+func TestSwitchStatementParsesWithDefaultArm(t *testing.T) {
+	input := `let name = "Bob";
+switch (name) {
+case /^steve$/i {
+printf("regexp");
+}
+case "Steven" {
+printf("literal");
+}
+default {
+printf("parsed");
+}
+}`
+
+	if got := evalSwitchStatementProgram(t, input); got != "parsed" {
+		t.Errorf("switch output = %q, want %q", got, "parsed")
+	}
+}
+
+func evalSwitchStatementProgram(t *testing.T, input string) string {
+	t.Helper()
+	var stdout bytes.Buffer
+	cmd := exec.Command("go", "run", "..", "-eval", input)
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	cmd.Stdout = &stdout
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("could not start interpreter: %v", err)
+	}
+
+	done := make(chan error, 1)
+	go func() { done <- cmd.Wait() }()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
+		<-done
+		t.Fatal("interpreter did not finish")
+	}
+	return stdout.String()
+}
+
+func TestSwitchStatementSelectsSingleArm(t *testing.T) {
+	tests := []struct {
+		name  string
+		input string
+		want  string
+	}{
+		{
+			name: "regular expression case",
+			input: `switch ("Steve") {
+case /^steve$/i { printf("regexp"); }
+case "Steven" { printf("literal"); }
+default { printf("fallback"); }
+}`,
+			want: "regexp",
+		},
+		{
+			name: "literal case",
+			input: `switch ("Steven") {
+case "Steven" { printf("literal"); }
+default { printf("fallback"); }
+}`,
+			want: "literal",
+		},
+		{
+			name: "default when no case matches",
+			input: `switch ("Bob") {
+case "Steven" { printf("literal"); }
+default { printf("fallback"); }
+}`,
+			want: "fallback",
+		},
+		{
+			name: "matching arm does not fall through",
+			input: `switch ("chosen") {
+case "chosen" { printf("first"); }
+case "chosen" { printf("later"); }
+default { printf("fallback"); }
+}`,
+			want: "first",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := evalSwitchStatementProgram(t, tt.input); got != tt.want {
+				t.Errorf("switch output = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestSwitchStatementWithinFunctionCall(t *testing.T) {
+	input := `function test(name) {
+switch (name) {
+case /^steve$/i { printf("regexp"); }
+case "Steven" { printf("literal"); }
+default { printf("fallback"); }
+}
+}
+test("Steve");`
+
+	if got := evalSwitchStatementProgram(t, input); got != "regexp" {
+		t.Errorf("function switch output = %q, want %q", got, "regexp")
+	}
+}
