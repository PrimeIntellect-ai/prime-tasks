+    <attributes class="edge">
+      <attribute id="ef" title="edge_float" type="float"/>
+      <attribute id="ed" title="edge_double" type="double"/>
+    </attributes>
+    <nodes>
+      <node id="0">
+        <attvalues>
+          <attvalue for="f" value="1.25"/>
+          <attvalue for="d" value="-2.5"/>
+        </attvalues>
+      </node>
+      <node id="1">
+        <attvalues>
+          <attvalue for="f" value="INF"/>
+          <attvalue for="d" value="NaN"/>
+        </attvalues>
+      </node>
+      <node id="2"/>
+    </nodes>
+    <edges>
+      <edge id="e0" source="0" target="2">
+        <attvalues>
+          <attvalue for="ef" value="3.75"/>
