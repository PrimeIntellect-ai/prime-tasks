+        assert_true(isinstance(graph.edges["1", "2"]["edge_float"], float))
+        assert_true(isinf(graph.edges["1", "2"]["edge_float"]))
+        assert_true(isinstance(graph.edges["1", "2"]["edge_double"], float))
+        assert_true(isnan(graph.edges["1", "2"]["edge_double"]))
