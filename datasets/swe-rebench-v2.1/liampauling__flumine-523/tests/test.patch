+
+
+class MarketRecorderTest(unittest.TestCase):
+    """Behavioural tests for the example market recorder strategy.
+
+    ``boto3``/``botocore`` are optional example dependencies that are not
+    installed in this environment, so lightweight stand-ins are registered
+    while the example module is imported.
+    """
+
+    def setUp(self) -> None:
+        boto3 = types.ModuleType("boto3")
+        boto3.s3 = types.ModuleType("boto3.s3")
+        boto3.s3.transfer = types.ModuleType("boto3.s3.transfer")
+        boto3.s3.transfer.S3Transfer = object
+        boto3.s3.transfer.TransferConfig = object
+        botocore = types.ModuleType("botocore")
+        botocore.exceptions = types.ModuleType("botocore.exceptions")
+        botocore.exceptions.BotoCoreError = Exception
+        self._modules = mock.patch.dict(
+            sys.modules,
+            {
+                "boto3": boto3,
+                "boto3.s3": boto3.s3,
+                "boto3.s3.transfer": boto3.s3.transfer,
+                "botocore": botocore,
+                "botocore.exceptions": botocore.exceptions,
+            },
+        )
+        self._modules.start()
+        from examples.strategies.marketrecorder import MarketRecorder
+
+        self.market_recorder_class = MarketRecorder
+
+    def tearDown(self) -> None:
+        self._modules.stop()
+
+    @staticmethod
+    def _raw_data_event(stream_id, clk, publish_time, datum):
+        # receive a market change message through the stream as the
+        # Betfair stream would, then capture the event it emits
+        listener = mock.Mock(
+            output_queue=mock.Mock(),
+            update_clk=True,
+            max_latency=None,
+        )
+        stream = datastream.FlumineMarketStream(listener, stream_id)
+        stream.on_update(
+            {"op": "mcm", "clk": clk, "pt": publish_time, "mc": [datum]}
+        )
+        return listener.output_queue.put.call_args[0][0]
+
+    def test_process_raw_data_outputs_received_clk(self):
+        with tempfile.TemporaryDirectory() as local_dir:
+            recorder = self.market_recorder_class(
+                market_filter={},
+                context={"local_dir": local_dir, "recorder_id": "recorder"},
+            )
+            flumine = BaseFlumine(mock.Mock(paper_trade=False))
+            flumine.add_strategy(recorder)
+            stream_id = recorder.stream_ids[0]
+            first_datum = {"id": "1.23"}
+            second_datum = {"id": "1.23", "change": 1}
+            for event in (
+                self._raw_data_event(stream_id, "AAA", 123, first_datum),
+                self._raw_data_event(stream_id, "BBB", 124, second_datum),
+            ):
+                flumine._process_raw_data(event)
+            with open(os.path.join(local_dir, "recorder", "1.23")) as f:
+                records = [json.loads(line) for line in f]
+        self.assertEqual(
+            records,
+            [
+                {"op": "mcm", "clk": "AAA", "pt": 123, "mc": [{"id": "1.23"}]},
+                {
+                    "op": "mcm",
+                    "clk": "BBB",
+                    "pt": 124,
+                    "mc": [{"id": "1.23", "change": 1}],
+                },
+            ],
+        )
