diff --git a/packages/babel-plugin-minify-dead-code-elimination/__tests__/dead-code-elimination-test.js b/packages/babel-plugin-minify-dead-code-elimination/__tests__/dead-code-elimination-test.js
index 045305e..992eed1 100644
--- a/packages/babel-plugin-minify-dead-code-elimination/__tests__/dead-code-elimination-test.js
+++ b/packages/babel-plugin-minify-dead-code-elimination/__tests__/dead-code-elimination-test.js
@@ -2503,4 +2503,67 @@ describe("dce-plugin", () => {
       plugins: [[deadcode, { tdz: true }]]
     }
   );
+
+  it("preserves a property-presence result across deletion", () => {
+    const code = `
+      function test(props) {
+        var hadWidth = "width" in props;
+        delete props.width;
+        if (hadWidth) return true;
+        return false;
+      }
+    `;
+    const transformed = babel.transform(code, { plugins: [deadcode] }).code;
+    const props = { width: true };
+    const result = new Function(
+      "props",
+      transformed + "\nreturn test(props);"
+    )(props);
+
+    expect(result).toBe(true);
+  });
+
+  it("preserves a property-presence result across for-in deletion", () => {
+    const code = `
+      function test(props) {
+        var hadWidth = "width" in props;
+        for (var property in props) {
+          delete props[property];
+        }
+        if (hadWidth) return true;
+        return false;
+      }
+    `;
+    const transformed = babel.transform(code, { plugins: [deadcode] }).code;
+    const props = { width: true, height: true };
+    const result = new Function(
+      "props",
+      transformed + "\nreturn test(props);"
+    )(props);
+
+    expect(result).toBe(true);
+  });
+
+  it("keeps slideToggle overflow hidden during animation", () => {
+    const code = `
+      function slideToggle(element, property) {
+        var style = element.style;
+        var hadOverflow = (property in style) === true;
+        delete style[property];
+        if (hadOverflow && element.animating) {
+          style.overflow = "hidden";
+        }
+      }
+      slideToggle(element, "overflow");
+    `;
+    const transformed = babel.transform(code, { plugins: [deadcode] }).code;
+    const element = {
+      style: { overflow: "visible" },
+      animating: true
+    };
+
+    new Function("element", transformed)(element);
+
+    expect(element.style.overflow).toBe("hidden");
+  });
 });
