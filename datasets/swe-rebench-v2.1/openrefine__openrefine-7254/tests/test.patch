+    @Test
+    public void deepCopy() {
+        Row row = new Row(1);
+        row.flagged = true;
+        row.starred = true;
+        Cell originalCell = new Cell("original value", null);
+        row.setCell(0, originalCell);
+
+        Row copied = row.deepCopy();
+        row.flagged = false;
+        row.starred = false;
+        row.setCell(0, new Cell("new value", null));
+
+        assertTrue(copied.flagged);
+        assertTrue(copied.starred);
+        assertNotSame(originalCell, copied.cells.get(0));
+        assertEquals(copied.cells.get(0).value, "original value");
+    }
 }
