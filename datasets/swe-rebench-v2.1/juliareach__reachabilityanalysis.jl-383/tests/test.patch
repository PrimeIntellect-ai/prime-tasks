+
+import LazySets
+
+@testset "Type piracy of set and array" begin
+    # `set` and `array` must extend the functions from LazySets instead of
+    # shadowing them with new functions defined in this package
+    @test ReachabilityAnalysis.set === LazySets.set
+    @test ReachabilityAnalysis.array === LazySets.array
+    X = BallInf(zeros(2), 1.0)
+    lm = LinearMap([1.0 0.0; 0.0 1.0], X)
+    @test set(lm) === X
+
+    Y = BallInf(ones(2), 1.0)
+    cpa = CartesianProductArray([X, Y])
+    @test ReachabilityAnalysis.array(cpa) == [X, Y]
+end
