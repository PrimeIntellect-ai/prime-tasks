+
+test('sort-conversations-by-update-time prepends sort:updated-desc', () => {
+	featureMocks.loaders[0].init(new AbortController().signal);
+
+	const link = createConversationLink('https://github.com/owner/repo/issues?q=is%3Aissue+is%3Aopen');
+	featureMocks.observedCallback!(link);
+
+	assert.equal(
+		new URL(link.getAttribute('href')!).searchParams.get('q'),
+		'sort:updated-desc is:issue is:open',
+	);
+});
