-import {test, assert} from 'vitest';
+import {test, assert, vi} from 'vitest';
 
 import SearchQuery from './search-query.js';
 
+// `sort-conversations-by-update-time` rewrites conversation-list links through
+// the selector observer. Capture the registered init and the observed callback
+// so the feature can be exercised without a full extension environment.
+const featureMocks = vi.hoisted(() => ({
+	loaders: [] as Array<{init: (signal: AbortSignal) => void}>,
+	observedCallback: undefined as ((link: HTMLAnchorElement) => void) | undefined,
+}));
+
+vi.mock('../feature-manager.js', () => ({
+	default: {
+		add: (_url: string, ...loaders: Array<{init: (signal: AbortSignal) => void}>) => {
+			featureMocks.loaders.push(...loaders);
+		},
+	},
+}));
+
+vi.mock('../helpers/selector-observer.js', () => ({
+	default: (_selector: string, callback: (link: HTMLAnchorElement) => void) => {
+		featureMocks.observedCallback = callback;
+	},
+}));
+
+import '../features/sort-conversations-by-update-time.js';
+
+// linkedom anchors don't implement the URL accessors that `github-url-detection`
+// and the feature rely on, so provide them from the raw `href` attribute.
+function createConversationLink(href: string): HTMLAnchorElement {
+	const link = document.createElement('a');
+	link.setAttribute('href', href);
+	Object.defineProperties(link, {
+		href: {
+			configurable: true,
+			get() {
+				return this.getAttribute('href');
+			},
+			set(value: string) {
+				this.setAttribute('href', value);
+			},
+		},
+		host: {configurable: true, get() { return new URL(this.getAttribute('href')!).host; }},
+		hostname: {configurable: true, get() { return new URL(this.getAttribute('href')!).hostname; }},
+		pathname: {configurable: true, get() { return new URL(this.getAttribute('href')!).pathname; }},
+	});
+	return link;
+}
+
