+// exportedInterfaceMethods parses the package's non-test Go sources and returns,
+// for every exported interface type, the signatures of its declared methods.
+func exportedInterfaceMethods(t *testing.T) map[string]map[string]*ast.FuncType {
+	t.Helper()
+	fset := token.NewFileSet()
+	pkgs, err := parser.ParseDir(fset, ".", func(fi fs.FileInfo) bool {
+		return !strings.HasSuffix(fi.Name(), "_test.go")
+	}, 0)
+	if err != nil {
+		t.Fatalf("failed to parse package sources: %v", err)
+	}
+	result := map[string]map[string]*ast.FuncType{}
+	for _, pkg := range pkgs {
+		for _, file := range pkg.Files {
+			for _, decl := range file.Decls {
+				gen, ok := decl.(*ast.GenDecl)
+				if !ok || gen.Tok != token.TYPE {
+					continue
+				}
+				for _, spec := range gen.Specs {
+					ts, ok := spec.(*ast.TypeSpec)
+					if !ok || !ts.Name.IsExported() {
+						continue
+					}
+					it, ok := ts.Type.(*ast.InterfaceType)
+					if !ok {
+						continue
+					}
+					methods := map[string]*ast.FuncType{}
+					for _, field := range it.Methods.List {
+						if signature, ok := field.Type.(*ast.FuncType); ok {
+							for _, name := range field.Names {
+								methods[name.Name] = signature
+							}
+						}
+					}
+					result[ts.Name.Name] = methods
+				}
+			}
+		}
+	}
+	return result
+}
+
+// TestExpectBeginIsDocumented verifies that ExpectBegin is part of the package's
+// exported API surface with its documented method signature.
+func TestExpectBeginIsDocumented(t *testing.T) {
+	ifaces := exportedInterfaceMethods(t)
+	methods, ok := ifaces["Expecter"]
+	if !ok {
+		t.Fatal("Expecter is not an exported interface type, so ExpectBegin is not documented")
+	}
+	signature, ok := methods["ExpectBegin"]
+	if !ok {
+		t.Fatal("ExpectBegin is not a method of the exported Expecter interface")
+	}
+	if signature.Params.NumFields() != 0 || signature.Results.NumFields() != 1 {
+		t.Fatal("ExpectBegin must take no arguments and return one value")
+	}
+	result, ok := signature.Results.List[0].Type.(*ast.StarExpr)
+	if !ok {
+		t.Fatal("ExpectBegin must return a pointer to ExpectedBegin")
+	}
+	resultType, ok := result.X.(*ast.Ident)
+	if !ok || resultType.Name != "ExpectedBegin" {
+		t.Fatal("ExpectBegin must return *ExpectedBegin")
+	}
+}
