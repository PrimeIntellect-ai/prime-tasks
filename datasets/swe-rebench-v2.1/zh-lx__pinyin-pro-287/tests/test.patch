 import { pinyin } from '../lib/index';
 import { expect, describe, it } from 'vitest';
+import ts from 'typescript';
+import path from 'path';
+
+const repoRoot = path.resolve(__dirname, '..');
+const typesEntry = path.join(repoRoot, 'types/index').replace(/\\/g, '/');
+
+// Type-check a snippet against the public type declarations using the
+// TypeScript compiler, so the public `BasicOptions` contract is exercised.
+function getTypeDiagnostics(source) {
+  const fileName = path.join(repoRoot, '__v_type_test__.ts');
+  const options = {
+    noEmit: true,
+    strict: true,
+    skipLibCheck: true,
+    moduleResolution: ts.ModuleResolutionKind.NodeJs,
+    module: ts.ModuleKind.CommonJS,
+    target: ts.ScriptTarget.ES2017,
+    types: [],
+  };
+  const host = ts.createCompilerHost(options);
+  const origGetSourceFile = host.getSourceFile.bind(host);
+  host.getSourceFile = (name, languageVersion, ...rest) => {
+    if (path.resolve(name) === fileName) {
+      return ts.createSourceFile(name, source, languageVersion, true);
+    }
+    return origGetSourceFile(name, languageVersion, ...rest);
+  };
+  const origFileExists = host.fileExists.bind(host);
+  host.fileExists = (name) => path.resolve(name) === fileName || origFileExists(name);
+  const origReadFile = host.readFile.bind(host);
+  host.readFile = (name) => (path.resolve(name) === fileName ? source : origReadFile(name));
+  const program = ts.createProgram([fileName], options, host);
+  return ts
+    .getPreEmitDiagnostics(program)
+    .map((d) => ts.flattenDiagnosticMessageText(d.messageText, '\n'));
+}
 
