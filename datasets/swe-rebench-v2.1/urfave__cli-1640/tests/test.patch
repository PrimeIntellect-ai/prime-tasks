+func TestCommandCustomHelpTemplateWithSubcommands(t *testing.T) {
+	const customHelp = "CUSTOM COMMAND HELP"
+
+	var output bytes.Buffer
+	app := &App{
+		Writer: &output,
+		Commands: []Command{
+			{
+				Name:               "some-command",
+				CustomHelpTemplate: customHelp,
+				Action:             func(c *Context) error { return ShowAppHelp(c) },
+				Subcommands: []Command{
+					{Name: "some-subcommand"},
+				},
+			},
+		},
+	}
+
+	err := app.Run([]string{"some-exec", "some-command"})
+	expect(t, err, nil)
+	if !strings.Contains(output.String(), customHelp) {
+		t.Fatalf("expected custom help template %q in output, got %q", customHelp, output.String())
+	}
+}
