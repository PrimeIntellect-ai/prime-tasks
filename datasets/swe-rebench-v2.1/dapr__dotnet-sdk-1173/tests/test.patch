+        [Fact]
+        public async Task GetBulkStateAsync_CanReadDeserializedState()
+        {
+            await using var client = TestClient.CreateForDaprClient();
+
+            var key = "test";
+            var request = await client.CaptureGrpcRequestAsync(async daprClient =>
+            {
+                return await daprClient.GetBulkStateAsync<Widget>("testStore", new List<string>() {key}, null);
+            });
+
+            // Create Response & Respond
+            const string size = "small";
+            const string color = "yellow";
+            const string etag = "some-etag";
+            var data = new Widget() {Size = size, Color = color};
+            var envelope = MakeGetBulkStateResponse<Widget>(key, data, etag);
+            var state = await request.CompleteWithMessageAsync(envelope);
+
+            // Get response and validate
+            state.Should().HaveCount(1);
+            state[0].Key.Should().Be(key);
+            state[0].ETag.Should().Be(etag);
+            state[0].Value.Size.Should().Match(size);
+            state[0].Value.Color.Should().Match(color);
+        }
+
+        [Fact]
+        public async Task GetBulkStateAsync_UsesConfiguredJsonConverter()
+        {
+            var serializerOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
+            serializerOptions.Converters.Add(new ConvertedValueJsonConverter());
+            await using var client = TestClient.CreateForDaprClient(builder => builder.UseJsonSerializationOptions(serializerOptions));
+
+            var key = "test";
+            var request = await client.CaptureGrpcRequestAsync(async daprClient =>
+            {
+                return await daprClient.GetBulkStateAsync<ConvertedValue>("testStore", new List<string> { key }, null);
+            });
+
+            var response = new Autogenerated.GetBulkStateResponse
+            {
+                Items =
+                {
+                    new Autogenerated.BulkStateItem
+                    {
+                        Key = key,
+                        Data = ByteString.CopyFromUtf8("\"custom-wire-value\""),
+                        Etag = "some-etag",
+                    }
+                }
+            };
+            var state = await request.CompleteWithMessageAsync(response);
+
+            state.Should().ContainSingle();
+            state[0].Value.Value.Should().Be("handled by configured converter");
+        }
+
