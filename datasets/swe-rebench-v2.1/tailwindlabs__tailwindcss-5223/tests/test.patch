--- /dev/null
+++ b/tests/jit/animations.test.js
@@ -0,0 +1,62 @@
+import postcss from 'postcss'
+import fs from 'fs'
+import path from 'path'
+import tailwind from '../../src/jit/index.js'
+
+function run(input, config = {}) {
+  return postcss(tailwind(config)).process(input, {
+    from: path.resolve(__filename),
+  })
+}
+
+function normalizeCssValue(value) {
+  return value.replace(/\s+/g, ' ').replace(/\s*,\s*/g, ', ').trim()
+}
+
+function summarizeAnimations(root) {
+  let keyframes = {}
+  root.walkAtRules('keyframes', (rule) => {
+    keyframes[rule.params] = rule.nodes
+      .map((frame) => [
+        normalizeCssValue(frame.selector),
+        frame.nodes
+          .filter((node) => node.type === 'decl')
+          .map(({ prop, value, important }) => [prop, normalizeCssValue(value), important])
+          .sort((a, b) => JSON.stringify(a).localeCompare(JSON.stringify(b))),
+      ])
+      .sort((a, b) => a[0].localeCompare(b[0]))
+  })
+
+  let animations = {}
+  root.walkRules((rule) => {
+    let declarations = rule.nodes
+      .filter((node) => node.type === 'decl' && node.prop === 'animation')
+      .map(({ prop, value, important }) => [prop, normalizeCssValue(value), important])
+
+    if (declarations.length > 0) {
+      animations[rule.selector] = declarations
+    }
+  })
+
+  return { keyframes, animations }
+}
+
+test('animations', () => {
+  let config = {
+    darkMode: 'class',
+    mode: 'jit',
+    purge: [path.resolve(__dirname, './animations.test.html')],
+    corePlugins: {},
+    theme: {},
+    plugins: [],
+  }
+
+  let css = `@tailwind utilities`
+
+  return run(css, config).then((result) => {
+    let expectedPath = path.resolve(__dirname, './animations.test.css')
+    let expected = fs.readFileSync(expectedPath, 'utf8')
+
+    expect(summarizeAnimations(result.root)).toEqual(summarizeAnimations(postcss.parse(expected)))
+  })
+})
