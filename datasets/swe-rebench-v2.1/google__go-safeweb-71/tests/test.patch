+func TestIncomingRequestContextAccessors(t *testing.T) {
+	type contextKey string
+	key := contextKey("request-value")
+	initial := context.WithValue(context.Background(), key, "initial")
+	req := httptest.NewRequest(http.MethodGet, "/", nil).WithContext(initial)
+	ir := safehttp.NewIncomingRequest(req)
+
+	request := reflect.ValueOf(ir)
+	contextMethod := request.MethodByName("Context")
+	if !contextMethod.IsValid() {
+		t.Fatal("IncomingRequest.Context method is missing")
+	}
+	getContext := func() context.Context {
+		return contextMethod.Call(nil)[0].Interface().(context.Context)
+	}
+	if got := getContext().Value(key); got != "initial" {
+		t.Errorf("Context().Value(key) got: %v, want: initial", got)
+	}
+
+	setContext := request.MethodByName("SetContext")
+	if !setContext.IsValid() {
+		t.Fatal("IncomingRequest.SetContext method is missing")
+	}
+	replacement := context.WithValue(context.Background(), key, "replacement")
+	setContext.Call([]reflect.Value{reflect.ValueOf(replacement)})
+	if got := getContext().Value(key); got != "replacement" {
+		t.Errorf("after SetContext, Context().Value(key) got: %v, want: replacement", got)
 	}
 }
