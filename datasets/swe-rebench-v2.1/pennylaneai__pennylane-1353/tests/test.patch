+    def test_same_wire_multiple_measurements(self):
+        """Test that drawing a QNode with multiple measurements on certain wires works correctly."""
+        dev = qml.device("default.qubit", wires=4)
+
+        @qml.qnode(dev)
+        def qnode(x, y):
+            qml.RY(x, wires=0)
+            qml.Hadamard(0)
+            qml.RZ(y, wires=0)
+            return [
+                qml.expval(qml.PauliX(wires=[0]) @ qml.PauliX(wires=[1]) @ qml.PauliX(wires=[2])),
+                qml.expval(qml.PauliX(wires=[0]) @ qml.PauliX(wires=[3])),
+            ]
+
+        qnode(1.0, 2.0)
+
+        drawn = qnode.draw()
+        lines = {
+            line.partition(":")[0].strip(): line.partition(":")[2]
+            for line in drawn.splitlines()
+        }
+        assert drawn
+        assert all(wire in lines for wire in ("0", "1", "2", "3"))
+        assert all(
+            any(marker in lines[wire] for marker in ("┤", "⟨", "|", "<"))
+            for wire in ("0", "1", "2", "3")
+        )
+
+    def test_same_wire_multiple_measurements_xz(self):
+        """Test that drawing a QNode with multiple measurements on certain wires
+        works correctly when the second observable is X(0) @ Z(3)."""
+        dev = qml.device("default.qubit", wires=4)
+
+        @qml.qnode(dev)
+        def qnode(x, y):
+            qml.RY(x, wires=0)
+            qml.Hadamard(0)
+            qml.RZ(y, wires=0)
+            return [
+                qml.expval(qml.PauliX(wires=[0]) @ qml.PauliX(wires=[1]) @ qml.PauliX(wires=[2])),
+                qml.expval(qml.PauliX(wires=[0]) @ qml.PauliZ(wires=[3])),
+            ]
+
+        qnode(1.0, 2.0)
+
+        drawn = qnode.draw()
+        lines = {
+            line.partition(":")[0].strip(): line.partition(":")[2]
+            for line in drawn.splitlines()
+        }
+        assert drawn
+        assert all(wire in lines for wire in ("0", "1", "2", "3"))
+        assert all(
+            any(marker in lines[wire] for marker in ("┤", "⟨", "|", "<"))
+            for wire in ("0", "1", "2", "3")
+        )
+
+    def test_no_ops_with_return_statement_draws(self):
+        """Test that a QNode with no operations and only a return statement draws."""
+        dev = qml.device("default.qubit", wires=4)
+
+        @qml.qnode(dev)
+        def qnode(x, y):
+            return [
+                qml.expval(qml.PauliX(wires=[0]) @ qml.PauliX(wires=[1]) @ qml.PauliX(wires=[2]))
+            ]
+
+        qnode(1.0, 2.0)
+        res = qnode.draw()
+        assert isinstance(res, str)
+        assert "⟨X ⊗ X ⊗ X⟩" in res
+
 
