+class StreamMapTestStream(Stream):
+    """A stream whose key property is not selected by default."""
+
+    name = "public-time_series_meta"
+    primary_keys = ["ts_id"]
+    selected_by_default = False
+    schema = PropertiesList(
+        Property("ts_id", IntegerType),
+        Property("name", StringType),
+    ).to_dict()
+
+    def get_records(self, context):  # noqa: ARG002
+        """Return no records."""
+        return []
+
+
+class StreamMapTestTap(Tap):
+    """A tap exposing the stream from the reported issue."""
+
+    name = "tap-stream-map-test"
+
+    def discover_streams(self):
+        """Discover the reported stream."""
+        return [StreamMapTestStream(self)]
+
+
+def test_discovery_mode_does_not_fail_on_stream_map_filter(tmp_path):
+    """Discovery mode must not fail on the reported stream map configuration.
+
+    Regression test for the tap-postgres ``__filter__`` failure: discovery
+    with the reported configuration must complete successfully.
+    """
+    config_file = tmp_path / "config.json"
+    config_file.write_text(
+        json.dumps(
+            {
+                "stream_maps": {
+                    "public-time_series_meta": {
+                        "__filter__": "ts_id in config['allowed_id']",
+                    },
+                },
+                "stream_map_config": {"allowed_id": [2364, 2363]},
+            },
+        ),
+    )
+
+    runner = CliRunner()
+    result = runner.invoke(
+        StreamMapTestTap.cli,
+        ["--discover", "--config", str(config_file)],
+    )
+
+    assert result.exit_code == 0, result.output
