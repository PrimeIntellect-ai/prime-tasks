+func TestMemoryInstance_Grow_via_module_memory(t *testing.T) {
+	s := newStore()
+	module, err := s.Instantiate(testCtx, &Module{MemorySection: &Memory{Min: 1, Cap: 1, Max: 2}}, t.Name(), nil, nil)
+	require.NoError(t, err)
+	defer module.Close(testCtx)
+
+	// The memory exposed by a module must be growable programmatically.
+	mem := module.Memory()
+	require.Equal(t, uint32(MemoryPageSize), mem.Size(testCtx))
+
+	previousPages, ok := mem.Grow(testCtx, 1)
+	require.True(t, ok)
+	require.Equal(t, uint32(1), previousPages)
+	require.Equal(t, uint32(2*MemoryPageSize), mem.Size(testCtx))
+
+	// Growing beyond the maximum must report failure and leave the size unchanged.
+	previousPages, ok = mem.Grow(testCtx, 1)
+	require.False(t, ok)
+	require.Equal(t, uint32(2*MemoryPageSize), mem.Size(testCtx))
+}
