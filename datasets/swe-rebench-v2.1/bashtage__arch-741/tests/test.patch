+@pytest.mark.parametrize("use_numpy", [True, False])
+def test_non_contiguous_input(use_numpy):
+    # GH 740: the reported input is a pandas Series with a datetime index.
+    # Both a Series backed by a strided array and a sliced Series are
+    # non-contiguous and must be handled.
+    if use_numpy:
+        y = pd.Series(np.array(SP500, copy=True)[::2], index=SP500.index[::2])
+    else:
+        y = SP500.iloc[::2]
+    assert not np.asarray(y).flags["C_CONTIGUOUS"]
+    mod = arch_model(y, mean="Zero")
+    res = mod.fit()
+    assert res.params.shape[0] == 3
