+#[test]
+fn resolves_derive_helper_rustc_builtin_macro() {
+    // This is NOT the correct usage of `default` helper attribute, but we don't resolve helper
+    // attributes on non mod items in hir nameres.
+    let fixture = r#"
+//- minicore: derive, default
+#[derive(Default)]
+#[default]
+enum E {
+    A,
+    B,
+}
+"#;
+    // The `default` helper attribute declared by the builtin `Default` derive must be recognized,
+    // so it must not be reported as an unresolved attribute macro.
+    let map = compute_crate_def_map(fixture);
+    assert!(
+        !map.diagnostics.iter().any(|diag| matches!(
+            &diag.kind,
+            crate::nameres::diagnostics::DefDiagnosticKind::UnresolvedMacroCall { path, .. }
+                if path.as_ident().map(|it| it.to_string()).as_deref() == Some("default")
+        )),
+        "`default` should be recognized as a derive helper, but got diagnostics: {:?}",
+        map.diagnostics
+    );
+    check(
+        fixture,
+        expect![[r#"
+            crate
+            E: t
+        "#]],
+    );
+}
+
