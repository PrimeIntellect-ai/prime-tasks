+
+func setCompilerPath(t *testing.T) {
+	t.Helper()
+	gopath, err := exec.Command("go", "env", "GOPATH").Output()
+	require.NoError(t, err)
+	pluginBin := filepath.Join(strings.TrimSpace(string(gopath)), "bin")
+	t.Setenv("PATH", pluginBin+string(os.PathListSeparator)+os.Getenv("PATH"))
+}
+
+func compileGeneratedSchema(t *testing.T, path string) {
+	t.Helper()
+	dir := filepath.Dir(path)
+	args := []string{
+		"--experimental_allow_proto3_optional", path,
+		"--proto_path", dir,
+		"--go_out", dir,
+		"--go-grpc_out", dir,
+		"--go_opt=paths=source_relative",
+		"--go-grpc_opt=paths=source_relative",
+	}
+	output, err := exec.Command("protoc", args...).CombinedOutput()
+	require.NoError(t, err, "generated protobuf schema should compile: %s", output)
+}
+
+func TestProtoc(t *testing.T) {
+	fakeBin := filepath.Join(t.TempDir(), "protoc")
+	if runtime.GOOS == "windows" {
+		fakeBin += ".exe"
+	}
+	out, err := exec.Command("go", "build", "-o", fakeBin, "./testdata/protoc").CombinedOutput()
+	require.NoError(t, err, "build a protoc-compatible command: %s", out)
+
+	for _, tc := range []struct {
+		name      string
+		configure bool
+	}{
+		{name: "default command"},
+		{name: "command through go run", configure: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			marker := filepath.Join(t.TempDir(), "invocation")
+			t.Setenv("PROTOC_MARKER", marker)
+			t.Setenv("PROTOC_EXPECT_PREFIX", "")
+			if tc.configure {
+				// The selected compiler is a Go program launched with go run.
+				pkg, err := filepath.Abs("./testdata/protoc/main.go")
+				require.NoError(t, err)
+				RunGRPCDSL(t, func() {
+					dsl.API("test", func() {
+						dsl.Meta("protoc:cmd", "go", "run", pkg, "fixed-prefix")
+					})
+					testdata.UnaryRPCsDSL()
+				})
+				t.Setenv("PROTOC_EXPECT_PREFIX", "fixed-prefix")
+			} else {
+				RunGRPCDSL(t, testdata.UnaryRPCsDSL)
+				// With no override, generation must find and invoke the ordinary
+				// protoc command using the process search path.
+				t.Setenv("PATH", filepath.Dir(fakeBin)+string(os.PathListSeparator)+os.Getenv("PATH"))
+			}
+
+			files := ProtoFiles("", expr.Root)
+			require.NotEmpty(t, files)
+			_, err := files[0].Render(t.TempDir())
+			require.NoError(t, err)
+
+			args, err := os.ReadFile(marker)
+			require.NoError(t, err, "the selected protobuf command should have been invoked")
+			arglist := strings.Split(string(args), "\n")
+			if tc.configure {
+				require.NotEmpty(t, arglist)
+				assert.Equal(t, "fixed-prefix", arglist[0], "configured arguments precede compiler arguments")
+			}
+			assert.Contains(t, string(args), ".proto")
 		})
 	}
 }
