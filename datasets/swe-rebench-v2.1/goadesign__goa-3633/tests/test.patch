@@ -0,0 +1,23 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"strings"
+)
+
+func main() {
+	args := os.Args[1:]
+	if expected := os.Getenv("PROTOC_EXPECT_PREFIX"); expected != "" {
+		if len(args) == 0 || args[0] != expected {
+			panic(fmt.Sprintf("expected leading argument %q, got %q", expected, args))
+		}
+	}
+	marker := os.Getenv("PROTOC_MARKER")
+	if marker == "" {
+		panic("PROTOC_MARKER is not set")
+	}
+	if err := os.WriteFile(marker, []byte(strings.Join(args, "\n")), 0o600); err != nil {
+		panic(err)
+	}
+}
