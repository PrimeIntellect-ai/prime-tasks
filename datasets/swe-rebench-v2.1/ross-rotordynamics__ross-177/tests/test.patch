diff --git a/ross/tests/test_fluid_flow.py b/ross/tests/test_fluid_flow.py
index ebc3ea1..3323d08 100644
--- a/ross/tests/test_fluid_flow.py
+++ b/ross/tests/test_fluid_flow.py
@@ -114,3 +114,33 @@ def test_numerical_abs_error():
     error = np.linalg.norm(bearing.p_mat_analytical[:][int(bearing.nz / 2)] -
                            bearing.p_mat_numerical[:][int(bearing.nz / 2)], ord=np.inf)
     assert math.isclose(error, 0, abs_tol=0.001)
+
+
+def test_bearing_type_uses_diameter():
+    # length / radius_stator = 0.2, so length / diameter = 0.1 <= 1/8 -> short_bearing
+    bearing = flow.PressureMatrix(8, 64, 11, 0.02, 100. * 2 * np.pi / 60, 0., 0.,
+                                  0.08, 0.1, 0.015, 860., eccentricity=0.001)
+    assert bearing.bearing_type == "short_bearing"
+
+
+def test_bearing_type_long_uses_diameter():
+    # length / radius_stator = 5, so length / diameter = 2.5, not > 4 -> medium_size
+    bearing = flow.PressureMatrix(8, 64, 11, 0.5, 100. * 2 * np.pi / 60, 0., 0.,
+                                  0.08, 0.1, 0.015, 860., eccentricity=0.001)
+    assert bearing.bearing_type == "medium_size"
+
+
+def test_bearing_type_diameter_ratio_boundaries():
+    diameter = 0.25
+    cases = (
+        (0.125, "short_bearing"),
+        (0.126, "medium_size"),
+        (4.0, "medium_size"),
+        (4.01, "long_bearing"),
+    )
+    for ratio, expected_type in cases:
+        bearing = flow.PressureMatrix(
+            8, 64, 11, diameter * ratio, 100. * 2 * np.pi / 60, 0., 0.,
+            0.08, diameter / 2, 0.015, 860., eccentricity=0.001
+        )
+        assert bearing.bearing_type == expected_type
