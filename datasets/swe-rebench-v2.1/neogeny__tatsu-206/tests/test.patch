diff --git a/test/grammar/error_test.py b/test/grammar/error_test.py
new file mode 100644
index 0000000..ab4c8d2
--- /dev/null
+++ b/test/grammar/error_test.py
@@ -0,0 +1,26 @@
+from __future__ import annotations
+
+from tatsu.tool import parse
+from tatsu.exceptions import GrammarError
+
+
+def test_missing_rule():
+    grammar = '''
+        @@grammar::TestGrammar
+          block = test ;
+    '''
+    try:
+        parse(grammar, 'abc')
+    except GrammarError as e:
+        assert str(e) == 'Unknown rules, no parser generated:\ntest'
+
+
+def test_missing_rules():
+    grammar = '''
+        @@grammar::TestGrammar
+          block = test | test2;
+    '''
+    try:
+        parse(grammar, 'abc')
+    except GrammarError as e:
+        assert str(e) == 'Unknown rules, no parser generated:\ntest\ntest2'
