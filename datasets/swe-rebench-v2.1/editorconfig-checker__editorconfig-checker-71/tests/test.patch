+// buildCLI compiles the editorconfig-checker command and returns the path to the
+// resulting binary so the user facing disable flags can be exercised.
+func buildCLI(t *testing.T) string {
+	t.Helper()
+
+	binary := filepath.Join(t.TempDir(), "ec")
+	cmd := exec.Command("go", "build", "-o", binary, "github.com/editorconfig-checker/editorconfig-checker/cmd/editorconfig-checker")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("could not build the editorconfig-checker binary: %v\n%s", err, output)
+	}
+
+	return binary
+}
+
+// runCLI runs the compiled binary inside dir and returns its exit code.
+func runCLI(t *testing.T, binary, dir string, args ...string) int {
+	t.Helper()
+
+	cmd := exec.Command(binary, args...)
+	cmd.Dir = dir
+	output, err := cmd.CombinedOutput()
+	if err == nil {
+		return 0
+	}
+
+	exitError, ok := err.(*exec.ExitError)
+	if !ok {
+		t.Fatalf("could not run the editorconfig-checker binary: %v\n%s", err, output)
+	}
+
+	return exitError.ExitCode()
+}
+
+func TestDisableFlags(t *testing.T) {
+	binary := buildCLI(t)
+
+	testCases := []struct {
+		name         string
+		flag         string
+		editorconfig string
+		fileContent  string
+	}{
+		{
+			name:         "trailing whitespace",
+			flag:         "-disable-trailing-whitespace",
+			editorconfig: "root = true\n[*]\ntrim_trailing_whitespace = true\ninsert_final_newline = true\n",
+			fileContent:  "hello   \n",
+		},
+		{
+			name:         "final newline",
+			flag:         "-disable-final-newline",
+			editorconfig: "root = true\n[*]\ninsert_final_newline = true\n",
+			fileContent:  "hello",
+		},
+		{
+			name:         "line ending",
+			flag:         "-disable-line-ending",
+			editorconfig: "root = true\n[*]\nend_of_line = lf\n",
+			fileContent:  "hello\r\n",
+		},
+		{
+			name:         "indentation",
+			flag:         "-disable-indentation",
+			editorconfig: "root = true\n[*]\nindent_style = tab\n",
+			fileContent:  "    hello\n",
+		},
+	}
+
+	for _, testCase := range testCases {
+		t.Run(testCase.name, func(t *testing.T) {
+			dir := t.TempDir()
+			if err := os.WriteFile(filepath.Join(dir, ".editorconfig"), []byte(testCase.editorconfig), 0644); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(dir, "bad.txt"), []byte(testCase.fileContent), 0644); err != nil {
+				t.Fatal(err)
+			}
+
+			if code := runCLI(t, binary, dir); code == 0 {
+				t.Errorf("expected the %s check to report an error without %s, but the command succeeded", testCase.name, testCase.flag)
+			}
+
+			if code := runCLI(t, binary, dir, testCase.flag); code != 0 {
+				t.Errorf("expected %s to disable the %s check, but the command exited with %d", testCase.flag, testCase.name, code)
+			}
+		})
+	}
+}
+
+func TestDisableFlagsAreSpecific(t *testing.T) {
+	binary := buildCLI(t)
+
+	dir := t.TempDir()
+	editorconfig := "root = true\n[*]\ntrim_trailing_whitespace = true\ninsert_final_newline = true\n"
+	if err := os.WriteFile(filepath.Join(dir, ".editorconfig"), []byte(editorconfig), 0644); err != nil {
+		t.Fatal(err)
+	}
+	// The file has both a trailing whitespace error and a missing final newline.
+	if err := os.WriteFile(filepath.Join(dir, "bad.txt"), []byte("hello   "), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	if code := runCLI(t, binary, dir, "-disable-trailing-whitespace"); code == 0 {
+		t.Error("disabling the trailing whitespace check must not disable the final newline check")
+	}
+
+	if code := runCLI(t, binary, dir, "-disable-final-newline"); code == 0 {
+		t.Error("disabling the final newline check must not disable the trailing whitespace check")
 	}
 }
