diff --git a/tests/frame/gather_every_test.py b/tests/frame/gather_every_test.py
index c151f450..776f5937 100644
--- a/tests/frame/gather_every_test.py
+++ b/tests/frame/gather_every_test.py
@@ -1,7 +1,10 @@
 from __future__ import annotations
 
+from contextlib import nullcontext
+
 import pytest
 
+import narwhals as nw_main
 import narwhals.stable.v1 as nw
 from tests.utils import Constructor
 from tests.utils import assert_equal_data
@@ -14,9 +17,26 @@ data = {"a": list(range(10))}
 def test_gather_every(
     constructor: Constructor, n: int, offset: int, request: pytest.FixtureRequest
 ) -> None:
-    if ("pyspark" in str(constructor)) or "duckdb" in str(constructor):
+    if "pyspark" in str(constructor) or "duckdb" in str(constructor):
         request.applymarker(pytest.mark.xfail)
-    df = nw.from_native(constructor(data))
-    result = df.gather_every(n=n, offset=offset)
     expected = {"a": data["a"][offset::n]}
+
+    # `gather_every` stays available in `narwhals.stable.v1` and returns the
+    # selected rows.
+    df_v1 = nw.from_native(constructor(data))
+    result = df_v1.gather_every(n=n, offset=offset)
     assert_equal_data(result, expected)
+
+    # In the main namespace `LazyFrame.gather_every` is deprecated, but it still
+    # returns a new frame containing only the selected rows.
+    df_main = nw_main.from_native(constructor(data))
+
+    context = (
+        pytest.deprecated_call()
+        if isinstance(df_main, nw_main.LazyFrame)
+        else nullcontext()
+    )
+
+    with context:
+        result_main = df_main.gather_every(n=n, offset=offset)
+    assert_equal_data(result_main, expected)
