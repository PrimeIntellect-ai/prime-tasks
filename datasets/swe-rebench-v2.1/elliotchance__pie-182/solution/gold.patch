@@ -0,0 +1,12 @@
+package pie
+
+// First returns the first element or a zero value if there are no elements.
+func First[T any](ss []T) T {
+	if len(ss) == 0 {
+		var zeroValue T
+
+		return zeroValue
+	}
+
+	return ss[0]
+}
diff --git a/v2/last.go b/v2/last.go
new file mode 100644
index 0000000..0f05c80
--- /dev/null
+++ b/v2/last.go
@@ -0,0 +1,12 @@
+package pie
+
+// Last returns the last element or a zero value if there are no elements.
+func Last[T any](ss []T) T {
+	if len(ss) == 0 {
+		var zeroValue T
+
+		return zeroValue
+	}
+
+	return ss[len(ss)-1]
+}
