diff --git a/v2/first_test.go b/v2/first_test.go
new file mode 100644
index 0000000..222507f
--- /dev/null
+++ b/v2/first_test.go
@@ -0,0 +1,31 @@
+package pie_test
+
+import (
+	"github.com/elliotchance/pie/v2"
+	"github.com/stretchr/testify/assert"
+	"testing"
+)
+
+func TestFirst(t *testing.T) {
+	tests := []struct {
+		name string
+		ss   []float64
+		want float64
+	}{
+		{"nil slice returns zero", nil, 0},
+		{"empty slice returns zero", []float64{}, 0},
+		{"one element", []float64{100}, 100},
+		{"first of several elements", []float64{1, 2, 3}, 1},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			assert.Equal(t, test.want, pie.First(test.ss))
+		})
+	}
+}
+
+func TestFirstWithNonNumericElements(t *testing.T) {
+	assert.Equal(t, "first", pie.First([]string{"first", "second"}))
+	assert.Equal(t, "", pie.First([]string{}))
+}
