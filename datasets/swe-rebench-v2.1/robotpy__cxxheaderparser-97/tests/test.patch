+# Note: testcases generated via `python -m cxxheaderparser.gentest`
+
+from dataclasses import replace
+
+from cxxheaderparser.types import (
+    FundamentalSpecifier,
+    NameSpecifier,
+    PQName,
+    Token,
+    Type,
+    Value,
+    Variable,
+)
+from cxxheaderparser.simple import (
+    Include,
+    NamespaceScope,
+    Pragma,
+    parse_string,
+    ParsedData,
+)
+
+
+def _strip_value(value: Value) -> Value:
+    # Digit separators may or may not be preserved in token spelling; the
+    # contract only requires the literal to be recognized as one numeric token.
+    return Value(tokens=[Token(value=t.value.replace("'", "")) for t in value.tokens])
+
+
+def _strip_separators(data: ParsedData) -> ParsedData:
+    variables = [
+        replace(v, value=_strip_value(v.value)) for v in data.namespace.variables
+    ]
+    return replace(data, namespace=replace(data.namespace, variables=variables))
+
+
+def test_numeric_literals() -> None:
+    content = """
+      #pragma once
+      #include <cstdint>
+
+      int test_binary = 0b01'10'01;
+      int test_decimal = 123'456'789u;
+      int test_octal = 012'42'11l;
+    """
+    data = parse_string(content, cleandoc=True)
+
+    assert _strip_separators(data) == ParsedData(
+        namespace=NamespaceScope(
+            variables=[
+                Variable(
+                    name=PQName(segments=[NameSpecifier(name="test_binary")]),
+                    type=Type(
+                        typename=PQName(segments=[FundamentalSpecifier(name="int")])
+                    ),
+                    value=Value(tokens=[Token(value="0b011001")]),
+                ),
+                Variable(
+                    name=PQName(segments=[NameSpecifier(name="test_decimal")]),
+                    type=Type(
+                        typename=PQName(segments=[FundamentalSpecifier(name="int")])
+                    ),
+                    value=Value(tokens=[Token(value="123456789u")]),
+                ),
+                Variable(
+                    name=PQName(segments=[NameSpecifier(name="test_octal")]),
+                    type=Type(
+                        typename=PQName(segments=[FundamentalSpecifier(name="int")])
+                    ),
+                    value=Value(tokens=[Token(value="0124211l")]),
+                ),
+            ]
+        ),
+        pragmas=[Pragma(content=Value(tokens=[Token(value="once")]))],
+        includes=[Include(filename="<cstdint>")],
+    )
+
+
+def test_hex_numeric_literal() -> None:
+    content = """
+      #pragma once
+      #include <cstdint>
+
+      uint64_t value{0xffff'ffff};
+    """
+    data = parse_string(content, cleandoc=True)
+
+    assert _strip_separators(data) == ParsedData(
+        namespace=NamespaceScope(
+            variables=[
+                Variable(
+                    name=PQName(segments=[NameSpecifier(name="value")]),
+                    type=Type(
+                        typename=PQName(segments=[NameSpecifier(name="uint64_t")])
+                    ),
+                    value=Value(
+                        tokens=[
+                            Token(value="{"),
+                            Token(value="0xffffffff"),
+                            Token(value="}"),
+                        ]
+                    ),
+                ),
+            ]
+        ),
+        pragmas=[Pragma(content=Value(tokens=[Token(value="once")]))],
+        includes=[Include(filename="<cstdint>")],
+    )
+
+
+def test_hex_floating_literal_with_digit_separator() -> None:
+    literal = "0x1'000.5p0"
+    data = parse_string(f"double value = {literal};", cleandoc=True)
+
+    value = _strip_value(data.namespace.variables[0].value)
+    assert value == Value(tokens=[Token(value=literal.replace("'", ""))])
+
+
+def test_decimal_floating_literal_keeps_digit_separator() -> None:
+    literal = "1'000.5"
+    data = parse_string(f"double value = {literal};", cleandoc=True)
+
+    tokens = data.namespace.variables[0].value.tokens
+    assert "".join(token.value for token in tokens).replace("'", "") == literal.replace(
+        "'", ""
+    )
