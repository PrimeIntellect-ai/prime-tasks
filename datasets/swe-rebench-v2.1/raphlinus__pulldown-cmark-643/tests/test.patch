+#[test]
+fn regression_test_71() {
+    let original = r##"[`]: xx:
+
+[`]`]
+"##;
+    let expected = r##"<p>[<code>]</code>]</p>
+"##;
+
+    test_markdown_html(original, expected, false);
+}
+
+#[test]
+fn regression_test_71_offset_iter() {
+    let text = "[`]: xx:\n\n[`]`]\n";
+    let events: Vec<_> = Parser::new(text).into_offset_iter().collect();
+
+    // The link-like span must not be parsed as a link.
+    assert!(
+        !events
+            .iter()
+            .any(|(ev, _)| matches!(ev, Event::Start(Tag::Link(..)))),
+        "unexpected link event: {:?}",
+        events
+    );
+
+    // The reported source ranges must cover the whole span, not just its front part.
+    let expected = vec![
+        (Event::Start(Tag::Paragraph), 10..16),
+        (Event::Text("[".into()), 10..11),
+        (Event::Code("]".into()), 11..14),
+        (Event::Text("]".into()), 14..15),
+        (Event::End(Tag::Paragraph), 10..16),
+    ];
+    assert_eq!(expected, events);
+}
