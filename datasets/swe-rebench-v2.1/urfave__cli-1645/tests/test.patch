+func TestIntApplyInputSourceAlternateNameUpdatesDestination(t *testing.T) {
+	const configFile = "current-int-destination.yaml"
+	if err := ioutil.WriteFile(configFile, []byte("test: 1"), 0666); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(configFile)
+
+	var destination int
+	app := cli.NewApp()
+	set := flag.NewFlagSet("test", flag.ContinueOnError)
+	if err := set.Parse([]string{"test-cmd", "--load", configFile}); err != nil {
+		t.Fatal(err)
+	}
+	c := cli.NewContext(app, set, nil)
+	actionValue := 0
+	command := &cli.Command{
+		Name: "test-cmd",
+		Action: func(*cli.Context) error {
+			actionValue = destination
+			return nil
+		},
+		Flags: []cli.Flag{
+			NewIntFlag(cli.IntFlag{Name: "test,t", Destination: &destination}),
+			cli.StringFlag{Name: "load"},
+		},
+	}
+	command.Before = InitInputSourceWithContext(command.Flags, NewYamlSourceFromFlagFunc("load"))
+	if err := command.Run(c); err != nil {
+		t.Fatal(err)
+	}
+	expect(t, 1, actionValue)
 }
 
