+func TestPGRestoreErrors(t *testing.T) {
+	t.Parallel()
+
+	errCritical := errors.New("critical error")
+	errIgnored := &pglib.ErrRelationAlreadyExists{}
+
+	t.Run("empty", func(t *testing.T) {
+		t.Parallel()
+
+		errs := pglib.NewPGRestoreErrors()
+		require.Equal(t, "", errs.Error())
+		require.False(t, errs.HasCriticalErrors())
+		require.Empty(t, errs.GetIgnoredErrors())
+	})
+
+	t.Run("critical and ignored errors", func(t *testing.T) {
+		t.Parallel()
+
+		errs := pglib.NewPGRestoreErrors(errCritical, errIgnored)
+		require.True(t, errs.HasCriticalErrors())
+		require.Len(t, errs.GetIgnoredErrors(), 1)
+		require.ErrorIs(t, errs.GetIgnoredErrors()[0], errIgnored)
+		require.Contains(t, errs.Error(), errCritical.Error())
+		require.Contains(t, errs.Error(), errIgnored.Error())
+	})
+
+	t.Run("only ignored errors", func(t *testing.T) {
+		t.Parallel()
+
+		errs := pglib.NewPGRestoreErrors(errIgnored)
+		require.False(t, errs.HasCriticalErrors())
+		require.Len(t, errs.GetIgnoredErrors(), 1)
+		require.Contains(t, errs.Error(), errIgnored.Error())
+	})
+}
