+func TestBatchWriter_InsertOnConflict(t *testing.T) {
+	t.Parallel()
+
+	testTableID := xid.New()
+	testTable := "table"
+	testSchema := "test"
+	quotedTestTable := quotedTableName(testSchema, testTable)
+
+	columnID := func(i int) string {
+		return fmt.Sprintf("%s-%d", testTableID, i)
+	}
+
+	insertData := func(withPK bool) *wal.Data {
+		d := &wal.Data{
+			Action: "I",
+			Schema: testSchema,
+			Table:  testTable,
+			Columns: []wal.Column{
+				{ID: columnID(1), Name: "id", Value: 1},
+				{ID: columnID(2), Name: "name", Value: "alice"},
+			},
+		}
+		if withPK {
+			d.Metadata = wal.Metadata{InternalColIDs: []string{columnID(1)}}
+		}
+		return d
+	}
+
+	insertSQL := fmt.Sprintf("INSERT INTO %s(id, name) VALUES($1, $2)", quotedTestTable)
+
+	tests := []struct {
+		name     string
+		action   string
+		walData  *wal.Data
+		wantSQL  []string
+		noSQL    []string
+		wantArgs []any
+	}{
+		{
+			name:     "default action is error",
+			action:   "",
+			walData:  insertData(true),
+			wantSQL:  []string{insertSQL},
+			noSQL:    []string{"ON CONFLICT"},
+			wantArgs: []any{1, "alice"},
+		},
+		{
+			name:     "error action",
+			action:   "error",
+			walData:  insertData(true),
+			wantSQL:  []string{insertSQL},
+			noSQL:    []string{"ON CONFLICT"},
+			wantArgs: []any{1, "alice"},
+		},
+		{
+			name:     "nothing action ignores conflicts",
+			action:   "nothing",
+			walData:  insertData(true),
+			wantSQL:  []string{insertSQL, "ON CONFLICT", "DO NOTHING"},
+			wantArgs: []any{1, "alice"},
+		},
+		{
+			name:     "update action updates the existing row",
+			action:   "update",
+			walData:  insertData(true),
+			wantSQL:  []string{insertSQL, "ON CONFLICT", "DO UPDATE"},
+			noSQL:    []string{"DO NOTHING"},
+			wantArgs: []any{1, "alice"},
+		},
+		{
+			name:     "update action without primary key metadata falls back to error",
+			action:   "update",
+			walData:  insertData(false),
+			wantSQL:  []string{insertSQL},
+			noSQL:    []string{"ON CONFLICT"},
+			wantArgs: []any{1, "alice"},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+
+			sql, args := batchedQuery(t, tc.action, tc.walData)
+			require.Equal(t, tc.wantArgs, args)
+			for _, s := range tc.wantSQL {
+				require.Contains(t, sql, s)
+			}
+			for _, s := range tc.noSQL {
+				require.NotContains(t, sql, s)
+			}
+		})
+	}
+}
