-func TestDMLAdapter_walDataToQuery(t *testing.T) {
+// queryCaptureLogger records the queries the batch writer hands over for
+// sending. The writer logs every query it batches at debug level, which lets
+// the tests observe the generated SQL through the public writer API.
+type queryCaptureLogger struct {
+	mu      sync.Mutex
+	queries []loglib.Fields
+}
+
+func (l *queryCaptureLogger) Trace(msg string, fields ...loglib.Fields) {}
+func (l *queryCaptureLogger) Info(msg string, fields ...loglib.Fields)  {}
+func (l *queryCaptureLogger) Warn(err error, msg string, fields ...loglib.Fields) {
+}
+func (l *queryCaptureLogger) Error(err error, msg string, fields ...loglib.Fields) {}
+func (l *queryCaptureLogger) Panic(msg string, fields ...loglib.Fields)            {}
+func (l *queryCaptureLogger) WithFields(fields loglib.Fields) loglib.Logger {
+	return l
+}
+
+func (l *queryCaptureLogger) Debug(msg string, fields ...loglib.Fields) {
+	if msg != "batching query" || len(fields) == 0 {
+		return
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.queries = append(l.queries, fields[0])
+}
+
+// batchedQuery processes the event with a batch writer configured with the
+// given on conflict action, and returns the SQL and args of the single query
+// the writer batches for it.
+func batchedQuery(t *testing.T, onConflictAction string, d *wal.Data) (string, []any) {
+	t.Helper()
+
+	ctx, cancel := context.WithCancel(context.Background())
+
+	logger := &queryCaptureLogger{}
+	writer, err := NewBatchWriter(ctx, &Config{
+		// the URL is never reached, the queries are only batched
+		URL:              "postgres://user:password@127.0.0.1:1/db?sslmode=disable",
+		OnConflictAction: onConflictAction,
+	}, WithLogger(logger))
+	require.NoError(t, err)
+	defer func() {
+		// the writer only shuts down once its context is cancelled
+		cancel()
+		_ = writer.Close()
+	}()
+
+	err = writer.ProcessWALEvent(ctx, &wal.Event{Data: d})
+	require.NoError(t, err)
+
+	logger.mu.Lock()
+	defer logger.mu.Unlock()
+	require.Len(t, logger.queries, 1)
+	sql, _ := logger.queries[0]["sql"].(string)
+	args, _ := logger.queries[0]["args"].([]any)
+	return sql, args
+}
