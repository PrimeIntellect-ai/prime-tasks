+class _EchoRequestHandler(MockHandler):
+    """Mock handler that echoes the request parameters back in the response body."""
+
+    def _handle(self):
+        parsed_path = urlparse(self.path)
+        content_len = int(self.headers.get("Content-Length") or 0)
+        raw_body = self.rfile.read(content_len) if content_len else b""
+        params = {}
+        if raw_body:
+            text = raw_body.decode("utf-8")
+            if text.startswith("{"):
+                try:
+                    params.update(json.loads(text))
+                except ValueError:
+                    pass
+            else:
+                params.update({k: v[0] for k, v in parse_qs(text).items()})
+        if parsed_path.query:
+            params.update({k: v[0] for k, v in parse_qs(parsed_path.query).items()})
+
+        authorization = self.headers.get("Authorization", "")
+        if "xoxb-error" in authorization:
+            body = {"ok": False, "error": "invalid_arguments"}
+        else:
+            body = {"ok": True, "method": parsed_path.path.replace("/", ""), "args": params}
+
+        self.send_response(200)
+        self.send_header("content-type", "application/json;charset=utf-8")
+        self.send_header("connection", "close")
+        self.end_headers()
+        self.wfile.write(json.dumps(body).encode("utf-8"))
+
+
