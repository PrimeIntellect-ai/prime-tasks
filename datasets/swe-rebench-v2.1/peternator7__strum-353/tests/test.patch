diff --git a/strum_tests/tests/as_ref_str.rs b/strum_tests/tests/as_ref_str.rs
index d492f17..73851f7 100644
--- a/strum_tests/tests/as_ref_str.rs
+++ b/strum_tests/tests/as_ref_str.rs
@@ -111,3 +111,59 @@ fn brightness_serialize_all() {
     assert_eq!("dim", <&'static str>::from(Brightness::Dim { glow: 0 }));
     assert_eq!("Bright", <&'static str>::from(Brightness::BrightWhite));
 }
+
+#[derive(IntoStaticStr)]
+#[strum(const_into_str)]
+enum Bar<'a, T>
+    where
+        T: AsRef<str>,
+{
+    A(T),
+    B,
+    C(&'a i32),
+    #[strum(serialize = "Dark")]
+    D,
+    #[strum(to_string = "Green")]
+    G,
+    #[strum(serialize = "b", to_string = "blue")]
+    Blue { hue: usize },
+    #[strum(serialize = "y", serialize = "yellow")]
+    Yellow,
+}
+
+#[derive(IntoStaticStr)]
+#[strum(serialize_all = "snake_case")]
+#[strum(const_into_str)]
+enum BrightnessConst {
+    DarkBlack,
+    Dim {
+        glow: usize,
+    },
+    #[strum(serialize = "Bright")]
+    BrightWhite,
+}
+
+#[test]
+fn const_into_str_preserves_into_static_str_conversion() {
+    assert_eq!("A", <&'static str>::from(Bar::A("foo")));
+    assert_eq!("B", <&'static str>::from(Bar::B::<&str>));
+    assert_eq!("C", <&'static str>::from(Bar::C::<&str>(&12)));
+    assert_eq!("Dark", <&'static str>::from(Bar::D::<&str>));
+    assert_eq!("Green", <&'static str>::from(Bar::G::<&str>));
+    assert_eq!("blue", <&'static str>::from(Bar::Blue::<&str> { hue: 2 }));
+    assert_eq!("yellow", <&'static str>::from(Bar::Yellow::<&str>));
+    assert_eq!("dark_black", <&'static str>::from(BrightnessConst::DarkBlack));
+    assert_eq!("dim", <&'static str>::from(BrightnessConst::Dim { glow: 1 }));
+    assert_eq!("Bright", <&'static str>::from(BrightnessConst::BrightWhite));
+}
+
+const DARK_BLACK_CONST_STR: &'static str = BrightnessConst::DarkBlack.into_str();
+const DIM_CONST_STR: &'static str = BrightnessConst::Dim { glow: 0 }.into_str();
+const BRIGHT_WHITE_CONST_STR: &'static str = BrightnessConst::BrightWhite.into_str();
+
+#[test]
+fn const_into_str_is_callable_in_const_expressions() {
+    assert_eq!("dark_black", DARK_BLACK_CONST_STR);
+    assert_eq!("dim", DIM_CONST_STR);
+    assert_eq!("Bright", BRIGHT_WHITE_CONST_STR);
+}
