diff --git a/src/rules/converters/tests/no-redundant-jsdoc.test.ts b/src/rules/converters/tests/no-redundant-jsdoc.test.ts
new file mode 100644
index 0000000..7788173
--- /dev/null
+++ b/src/rules/converters/tests/no-redundant-jsdoc.test.ts
@@ -0,0 +1,25 @@
+import { convertRules } from "../../convertRules";
+import { converters } from "../../converters";
+import { mergers } from "../../mergers";
+
+describe("no-redundant-jsdoc", () => {
+    test("an enabled rule is converted to jsdoc/no-types with error severity", () => {
+        const { converted, failed, missing } = convertRules(
+            { converters, mergers },
+            { "no-redundant-jsdoc": true },
+        );
+
+        expect(failed).toEqual([]);
+        expect(missing).toEqual([]);
+        expect(converted.get("jsdoc/no-types")).toMatchObject({
+            ruleName: "jsdoc/no-types",
+            ruleSeverity: "error",
+        });
+    });
+
+    test("converting the rule adds the eslint-plugin-jsdoc plugin", () => {
+        const { plugins } = convertRules({ converters, mergers }, { "no-redundant-jsdoc": true });
+
+        expect(plugins).toContain("eslint-plugin-jsdoc");
+    });
+});
