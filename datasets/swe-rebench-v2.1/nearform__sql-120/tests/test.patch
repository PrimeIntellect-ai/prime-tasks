+test('SQL helper - build complex query with map', async t => {
+  const objArray = [{
+    id: 1,
+    name: 'name1'
+  },
+  {
+    id: 2,
+    name: 'name2'
+  },
+  {
+    id: 3,
+    name: 'name3'
+  }]
+
+  const mapFunction = (objItem) => {
+    return objItem.id
+  }
+
+  const values = SQL.map(objArray, mapFunction)
+  const sql = SQL`INSERT INTO users (id) VALUES (${values})`
+
+  t.match(sql.text, /\$\d+,\$\d+,\$\d+/)
+  t.equal((sql.sql.match(/\?/g) || []).length, 3)
+  t.same(sql.values, [1, 2, 3])
+})
+
+test('SQL helper - build complex query with map - using default mapper function', async t => {
+  const ids = [1, 2, 3]
+
+  const values = SQL.map(ids)
+  const sql = SQL`INSERT INTO users (id) VALUES (${values})`
+
+  t.equal((sql.text.match(/\$\d+/g) || []).length, 3)
+  t.equal((sql.sql.match(/\?/g) || []).length, 3)
+  t.same(sql.values, [1, 2, 3])
+})
+
+test('SQL.map expands arrays according to their length', async t => {
+  const cases = [
+    [1, 2],
+    [4, 5, 6, 7]
+  ]
+
+  for (const values of cases) {
+    const sql = SQL`SELECT * FROM users WHERE id IN (${SQL.map(values)})`
+
+    t.equal((sql.text.match(/\$\d+/g) || []).length, values.length)
+    t.equal((sql.sql.match(/\?/g) || []).length, values.length)
+    t.same(sql.values, values)
+  }
+
+  const records = [{ id: 8 }, { id: 9 }, { id: 10 }, { id: 11 }]
+  const mappedSql = SQL`SELECT * FROM users WHERE id IN (${SQL.map(records, record => record.id)})`
+
+  t.equal((mappedSql.text.match(/\$\d+/g) || []).length, records.length)
+  t.equal((mappedSql.sql.match(/\?/g) || []).length, records.length)
+  t.same(mappedSql.values, [8, 9, 10, 11])
+})
+
