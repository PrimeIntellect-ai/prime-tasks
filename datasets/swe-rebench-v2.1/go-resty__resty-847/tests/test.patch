+
+func TestRequestClone(t *testing.T) {
+	c := dc()
+	parent := c.R()
+
+	// set an non-interface value
+	parent.URL = "https://example.com"
+	parent.SetPathParam("name", "parent")
+	parent.SetRawPathParam("name", "parent")
+	// set http header
+	parent.SetHeader("X-Header", "parent")
+	// set an interface value
+	parent.SetBasicAuth("parent", "")
+	parent.SetQueryParam("page", "parent")
+
+	cloneMethod := reflect.ValueOf(parent).MethodByName("Clone")
+	if !cloneMethod.IsValid() {
+		t.Fatal("Request clone operation is unavailable")
+	}
+	var cloneArgs []reflect.Value
+	if cloneMethod.Type().NumIn() == 1 {
+		cloneArgs = []reflect.Value{reflect.ValueOf(context.Background())}
+	}
+	cloneResult := cloneMethod.Call(cloneArgs)
+	clone, ok := cloneResult[0].Interface().(*Request)
+	if !ok || clone == nil {
+		t.Fatal("clone operation did not return a request")
+	}
+
+	// The clone starts with the request's configured values.
+	assertEqual(t, "https://example.com", clone.URL)
+	assertEqual(t, "parent", clone.PathParams["name"])
+	assertEqual(t, "parent", clone.RawPathParams["name"])
+	assertEqual(t, "parent", clone.Header.Get("X-Header"))
+	assertEqual(t, "parent", clone.UserInfo.Username)
+	assertEqual(t, "parent", clone.QueryParam.Get("page"))
+
+	// update value of non-interface type - change will only happen on clone
+	clone.URL = "http://localhost.clone"
+	clone.PathParams["name"] = "clone"
+	clone.RawPathParams["name"] = "clone"
+	// update value of http header - change will only happen on clone
+	clone.SetHeader("X-Header", "clone")
+	// update value of interface type - change will only happen on clone
+	clone.UserInfo.Username = "clone"
+	clone.SetQueryParam("page", "clone")
+
+	// assert non-interface type
+	assertEqual(t, "http://localhost.clone", clone.URL)
+	assertEqual(t, "https://example.com", parent.URL)
+	assertEqual(t, "clone", clone.PathParams["name"])
+	assertEqual(t, "clone", clone.RawPathParams["name"])
+	// assert http header
+	assertEqual(t, "clone", clone.Header.Get("X-Header"))
+	// assert interface type
+	assertEqual(t, "clone", clone.UserInfo.Username)
+	assertEqual(t, "parent", parent.QueryParam.Get("page"))
+	assertEqual(t, "clone", clone.QueryParam.Get("page"))
+
+	// test SRV
+	parent = c.R()
+	parent.SetSRV(&SRVRecord{"xmpp-server", "google.com"})
+
+	cloneMethod = reflect.ValueOf(parent).MethodByName("Clone")
+	cloneArgs = nil
+	if cloneMethod.Type().NumIn() == 1 {
+		cloneArgs = []reflect.Value{reflect.ValueOf(context.Background())}
+	}
+	clone = cloneMethod.Call(cloneArgs)[0].Interface().(*Request)
+	assertEqual(t, "xmpp-server", clone.SRV.Service)
+	clone.SRV.Service = "xmpp-server-clone"
+
+	assertEqual(t, "xmpp-server-clone", clone.SRV.Service)
+}
