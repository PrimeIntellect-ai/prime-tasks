 }
+
+func TestMissingWithArgs(t *testing.T) {
+	mock, _ := NewConn()
+	// No arguments expected
+	mock.ExpectExec("INSERT something")
+	// Receiving argument
+	_, err := mock.Exec(context.Background(), "INSERT something", "something")
+	if err == nil {
+		t.Error("arguments do not match error was expected")
+	}
+	if err := mock.ExpectationsWereMet(); err == nil {
+		t.Error("expectation was not matched error was expected")
+	}
+}
+
+func TestQueryWithEmptyArgsRejectsArguments(t *testing.T) {
+	mock, err := NewConn()
+	if err != nil {
+		t.Fatalf("could not create mock connection: %v", err)
+	}
+
+	mock.ExpectQuery("SELECT id FROM users").WithArgs().WillReturnRows(NewRows([]string{"id"}).AddRow(1))
+	_, err = mock.Query(context.Background(), "SELECT id FROM users WHERE name=$1", "john")
+	if err == nil {
+		t.Fatal("query with unexpected arguments should not match an expectation configured with no arguments")
+	}
+	if err := mock.ExpectationsWereMet(); err == nil {
+		t.Fatal("the query expectation should remain unmet after an argument mismatch")
+	}
+}
+
+func TestZeroArgumentsMatchUnconfiguredArgumentExpectations(t *testing.T) {
+	for _, test := range []struct {
+		name     string
+		query    bool
+		withArgs bool
+	}{
+		{name: "exec without WithArgs"},
+		{name: "exec with empty WithArgs", withArgs: true},
+		{name: "query without WithArgs", query: true},
+		{name: "query with empty WithArgs", query: true, withArgs: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			mock, err := NewConn()
+			if err != nil {
+				t.Fatalf("could not create mock connection: %v", err)
+			}
+
+			if test.query {
+				expectation := mock.ExpectQuery("SELECT id FROM users").WillReturnRows(NewRows([]string{"id"}).AddRow(1))
+				if test.withArgs {
+					expectation.WithArgs()
+				}
+				var id int
+				if err := mock.QueryRow(context.Background(), "SELECT id FROM users").Scan(&id); err != nil {
+					t.Fatalf("zero-argument query did not match: %v", err)
+				}
+				if id != 1 {
+					t.Fatalf("query returned id %d, want 1", id)
+				}
+			} else {
+				expectation := mock.ExpectExec("INSERT INTO users").WillReturnResult(NewResult("INSERT", 1))
+				if test.withArgs {
+					expectation.WithArgs()
+				}
+				if _, err := mock.Exec(context.Background(), "INSERT INTO users"); err != nil {
+					t.Fatalf("zero-argument execution did not match: %v", err)
+				}
+			}
+
+			if err := mock.ExpectationsWereMet(); err != nil {
+				t.Fatalf("zero-argument expectation was not fulfilled: %v", err)
+			}
+		})
+	}
+}
+
+func TestQueryWithoutWithArgsRejectsArguments(t *testing.T) {
+	mock, err := NewConn()
+	if err != nil {
+		t.Fatalf("could not create mock connection: %v", err)
+	}
+
+	mock.ExpectQuery("SELECT id FROM users").WillReturnRows(NewRows([]string{"id"}).AddRow(1))
+	if _, err := mock.Query(context.Background(), "SELECT id FROM users WHERE name=$1", "john"); err == nil {
+		t.Fatal("query arguments should not match an expectation configured without WithArgs")
+	}
+	if err := mock.ExpectationsWereMet(); err == nil {
+		t.Fatal("the query expectation should remain unmet after an argument mismatch")
+	}
+}
+
+func TestExecWithEmptyArgsRejectsArguments(t *testing.T) {
+	mock, err := NewConn()
+	if err != nil {
+		t.Fatalf("could not create mock connection: %v", err)
+	}
+
+	mock.ExpectExec("INSERT INTO users").WithArgs().WillReturnResult(NewResult("INSERT", 1))
+	if _, err := mock.Exec(context.Background(), "INSERT INTO users", "john"); err == nil {
+		t.Fatal("execution arguments should not match an expectation configured with empty WithArgs")
+	}
+	if err := mock.ExpectationsWereMet(); err == nil {
+		t.Fatal("the execution expectation should remain unmet after an argument mismatch")
+	}
+}
