+
+func assertMapScanValues(t *testing.T, values map[string]interface{}) {
+	t.Helper()
+
+	for _, field := range []string{"a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "r"} {
+		require.Contains(t, values, field)
+	}
+
+	require.Equal(t, []interface{}{true}, values["j"])
+	require.Equal(t, map[string]interface{}{"foo": "foo", "bar": "bar"}, values["k"])
+	require.Equal(t, map[string]interface{}{
+		"foo": "foo",
+		"bar": "bar",
+		"baz": "baz",
+		"-":   "bat",
+	}, values["m"])
+	r, ok := values["r"].(map[string]interface{})
+	require.True(t, ok)
+	nested, ok := r["foo"].(map[string]interface{})
+	require.True(t, ok)
+	require.Equal(t, map[string]interface{}{"foo": "foo", "bar": "bar"}, map[string]interface{}{
+		"foo": nested["foo"],
+		"bar": nested["bar"],
+	})
+	require.IsType(t, []interface{}{}, nested["baz"])
+	array, ok := nested["nestedArray"].([]interface{})
+	require.True(t, ok)
+	require.Len(t, array, 1)
+	arrayDocument, ok := array[0].(map[string]interface{})
+	require.True(t, ok)
+	require.Equal(t, "inside array", arrayDocument["child"])
+}
