+func TestListApiSpecRevisionsAcrossScopesIncludesHistory(t *testing.T) {
+	ctx := context.Background()
+	server := defaultTestServer(t)
+	names := []string{
+		"projects/my-project/locations/global/apis/my-api/versions/v1/specs/my-spec",
+		"projects/other-project/locations/global/apis/other-api/versions/v1/specs/other-spec",
+	}
+	if err := seeder.SeedSpecs(ctx, server,
+		&rpc.ApiSpec{Name: names[0]},
+		&rpc.ApiSpec{Name: names[1]},
+	); err != nil {
+		t.Fatalf("Setup/Seeding: Failed to seed registry: %s", err)
+	}
+
+	want := make(map[string]bool)
+	for i, name := range names {
+		current, err := server.GetApiSpec(ctx, &rpc.GetApiSpecRequest{Name: name})
+		if err != nil {
+			t.Fatalf("Setup: GetApiSpec(%q) returned error: %s", name, err)
+		}
+		want[fmt.Sprintf("%s@%s", name, current.GetRevisionId())] = true
+
+		updated, err := server.UpdateApiSpec(ctx, &rpc.UpdateApiSpecRequest{
+			ApiSpec: &rpc.ApiSpec{Name: name, Contents: []byte(fmt.Sprintf("revision %d", i+1))},
+		})
+		if err != nil {
+			t.Fatalf("Setup: UpdateApiSpec(%q) returned error: %s", name, err)
+		}
+		want[fmt.Sprintf("%s@%s", name, updated.GetRevisionId())] = true
+	}
+
+	got, err := server.ListApiSpecRevisions(ctx, &rpc.ListApiSpecRevisionsRequest{
+		Name: "projects/-/locations/global/apis/-/versions/-/specs/-",
+	})
+	if err != nil {
+		t.Fatalf("ListApiSpecRevisions returned error: %s", err)
+	}
+	if len(got.GetApiSpecs()) != len(want) {
+		t.Fatalf("ListApiSpecRevisions returned %d revisions, want %d", len(got.GetApiSpecs()), len(want))
+	}
+	for _, revision := range got.GetApiSpecs() {
+		if !want[revision.GetName()] {
+			t.Errorf("ListApiSpecRevisions returned unexpected revision %q", revision.GetName())
+		}
+		delete(want, revision.GetName())
+	}
+	for missing := range want {
+		t.Errorf("ListApiSpecRevisions omitted revision %q", missing)
+	}
+}
