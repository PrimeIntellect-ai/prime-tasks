+func streamState(stream *Stream) (string, bool) {
+	stateMethod := reflect.ValueOf(stream).MethodByName("State")
+	if !stateMethod.IsValid() {
+		return "", false
+	}
+	state := stateMethod.Call(nil)
+	if len(state) != 1 {
+		return "", false
+	}
+	return fmt.Sprint(state[0].Interface()), true
+}
+
+func assertStreamState(t *testing.T, stream *Stream, expected string) {
+	state, ok := streamState(stream)
+	if assert.True(t, ok, "stream lifecycle state should be observable") {
+		assert.Equal(t, expected, state)
+	}
+}
