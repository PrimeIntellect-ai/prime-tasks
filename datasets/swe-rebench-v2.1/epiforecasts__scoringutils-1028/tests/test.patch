@@ -176,6 +176,32 @@ test_that("as_forecast_quantile doesn't modify column names in place", {
   expect_equal(pre, post)
 })
 
+test_that("as_forecast_quantile handles rounding issues correctly", {
+  levels <- c(0.05, 0.25, 0.5, 0.75 + 1e-13, 0.95)
+  quantile_data <- data.table(
+    quantile_level = c(levels, levels - c(0, 0, 0, 1e-13, 0)),
+    predicted = rep(1:5, 2),
+    observed = rep(5, 10),
+    location = rep(1:2, each = 5)
+  )
+  expect_warning(
+    quantile_forecast <- quantile_data %>%
+      as_forecast_quantile(),
+    "rounding issue"
+  )
+  scored <- score(quantile_forecast, metrics = get_metrics(quantile_forecast))
+  score_columns <- c(
+    "wis", "overprediction", "underprediction", "dispersion", "bias",
+    "interval_coverage_50", "interval_coverage_90", "ae_median"
+  )
+  expect_true(all(vapply(
+    scored[, ..score_columns], is.finite, logical(nrow(scored))
+  )))
+})
+
