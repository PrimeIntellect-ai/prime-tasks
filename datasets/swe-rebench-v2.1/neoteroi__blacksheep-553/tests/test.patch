+@pytest.mark.skipif(
+    int(PYDANTIC_LIB_VERSION[0]) < 2, reason="Run this test only with Pydantic v2"
+)
+async def test_refs_characters_handling():
+    app = FakeApplication(show_error_details=True, router=Router())
+    get = app.router.get
+
+    # TODO: when support for Python < 3.12 is dropped,
+    # the following can be rewritten without TypeVar, like:
+    #
+    # class Response[DataT](BaseModel):
+    #
+
+    DataT = TypeVar("DataT")
+
+    class Response(BaseModel, Generic[DataT]):
+        data: DataT
+
+    class Cat(BaseModel):
+        id: int
+        name: str
+        creation_time: datetime
+
+    docs = OpenAPIHandler(info=Info(title="Example API", version="0.0.1"))
+    docs.bind_app(app)
+
+    @get("/cat")
+    def generic_example() -> Response[Cat]: ...
+
+    @get("/cats")
+    def generic_list_example() -> list[Response[Cat]]: ...
+
+    await app.start()
+
+    await app(get_example_scope("GET", "/openapi.json"), MockReceive(), MockSend())
+    json_response = app.response
+    assert json_response is not None
+    json_docs = await json_response.text()
+
+    await app(get_example_scope("GET", "/openapi.yaml"), MockReceive(), MockSend())
+    yaml_response = app.response
+    assert yaml_response is not None
+    yaml_docs = await yaml_response.text()
+
+    spec = json.loads(json_docs)
+
+    # Schema component names and the component identifier in each local $ref
+    # use only letters, digits, hyphen, underscore, and period.
+    allowed = re.compile(r"^[a-zA-Z0-9\-_.]+$")
+
+    def collect_refs(value):
+        refs = []
+        if isinstance(value, dict):
+            for k, v in value.items():
+                if k == "$ref" and isinstance(v, str):
+                    refs.append(v)
+                else:
+                    refs.extend(collect_refs(v))
+        elif isinstance(value, list):
+            for item in value:
+                refs.extend(collect_refs(item))
+        return refs
+
+    schemas = spec["components"]["schemas"]
+    for key in schemas:
+        assert allowed.match(key), f"schema name {key!r} contains disallowed characters"
+
+    refs = collect_refs(spec)
+    assert refs, "expected at least one $ref in the generated document"
+    for ref in refs:
+        assert ref.startswith("#/components/schemas/"), ref
+        name = ref[len("#/components/schemas/") :]
+        assert allowed.match(name), f"$ref {ref!r} contains disallowed characters"
+        assert name in schemas, f"$ref {ref!r} does not resolve to a schema"
+
+    # The same references must be valid in the YAML representation.
+    yaml_spec = yaml.safe_load(yaml_docs)
+    for ref in collect_refs(yaml_spec):
+        assert ref.startswith("#/components/schemas/"), ref
+        name = ref[len("#/components/schemas/") :]
+        assert allowed.match(name), f"$ref {ref!r} contains disallowed characters"
+        assert name in yaml_spec["components"]["schemas"]
