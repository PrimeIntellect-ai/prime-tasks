+/// Matches an output line that makes the package in [directory] identifiable.
+///
+/// The contract only requires each package's title to be visible in the
+/// output. A `Running "flutter test" in <path> ...` banner identifies the
+/// package when its path resolves to [directory] (relative to [relativeTo])
+/// or ends with the directory name. Any other line identifies it when it
+/// names the directory as a whole path token.
+Matcher _runningTestsIn(Directory directory, {required String relativeTo}) {
+  final directoryPath = directory.absolute.path;
+  final name = p.basename(directoryPath);
+  final nameToken = RegExp(
+    '(^|[\\s"\'/\\\\:(])${RegExp.escape(name)}(\$|[\\s"\'/\\\\:).])',
+  );
+  return predicate<String>((line) {
+    final text = line.replaceAll(RegExp(r'\s+$'), '');
+    final match = RegExp(
+      r'^Running "flutter test" in (.*?)\s*\.\.\.$',
+    ).firstMatch(text);
+    if (match != null) {
+      final path = match.group(1)!;
+      final resolved = p.isAbsolute(path)
+          ? p.normalize(path)
+          : p.normalize(p.join(relativeTo, path));
+      return p.equals(resolved, directoryPath) ||
+          p.basename(p.normalize(path)) == name;
+    }
+    final rest = text.replaceFirst('Running "flutter test"', '');
+    return nameToken.hasMatch(rest);
+  }, 'identifies package ${directory.path}');
+}
+
+/// Matches the `Running "flutter test" in ...` banner without constraining the
+/// path format, since the contract does not specify the output for
+/// non-recursive runs.
+Matcher get _runningTestsBanner => startsWith('Running "flutter test" in ');
+
