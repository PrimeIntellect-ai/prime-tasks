+// TestAppRunExitCode verifies that an exit code supplied to
+// Shutdowner.Shutdown is propagated to the process exit status used by App.Run.
+func TestAppRunExitCode(t *testing.T) {
+	t.Parallel()
+
+	var exitCode int
+	app := New(
+		WithLogger(func() fxevent.Logger { return fxevent.NopLogger }),
+		WithExit(func(code int) { exitCode = code }),
+		Invoke(func(s Shutdowner) error {
+			return s.Shutdown(ExitCode(7))
+		}),
+	)
+	app.Run()
+
+	assert.Equal(t, 7, exitCode)
+}
