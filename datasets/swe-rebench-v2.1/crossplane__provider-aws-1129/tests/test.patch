+func TestReplicationLateInitWithMetricsWithoutEventThreshold(t *testing.T) {
+	external := generateAWSReplication()
+	external.Rules[0].Destination.Metrics.EventThreshold = nil
+	bucket := s3testing.Bucket(s3testing.WithReplConfig(nil))
+	client := NewReplicationConfigurationClient(fake.MockBucketClient{
+		MockGetBucketReplication: func(context.Context, *s3.GetBucketReplicationInput, []func(*s3.Options)) (*s3.GetBucketReplicationOutput, error) {
+			return &s3.GetBucketReplicationOutput{ReplicationConfiguration: external}, nil
+		},
+	})
+
+	if err := client.LateInitialize(context.Background(), bucket); err != nil {
+		t.Fatalf("late initialize replication configuration: %v", err)
+	}
+	metrics := bucket.Spec.ForProvider.ReplicationConfiguration.Rules[0].Destination.Metrics
+	if metrics == nil {
+		t.Fatal("expected AWS replication metrics to be retained")
+	}
+	data, err := json.Marshal(metrics)
+	if err != nil {
+		t.Fatalf("marshal late-initialized metrics: %v", err)
+	}
+	var serialized map[string]json.RawMessage
+	if err := json.Unmarshal(data, &serialized); err != nil {
+		t.Fatalf("decode late-initialized metrics: %v", err)
+	}
+	if _, present := serialized["eventThreshold"]; present {
+		t.Fatalf("event threshold must remain absent after late initialization, got %s", serialized["eventThreshold"])
+	}
+}
