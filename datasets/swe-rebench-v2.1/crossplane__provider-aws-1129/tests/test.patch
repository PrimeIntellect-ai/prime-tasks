+func TestReplicationCreateOrUpdateOmitsAbsentEventThreshold(t *testing.T) {
+	config := generateReplicationConfig()
+	config.Rules[0].Destination.Metrics = fixtureS3ReplMetricsEventThreshold(false)
+	config.Rules[0].Destination.ReplicationTime.Status = "Disabled"
+
+	var request *s3.PutBucketReplicationInput
+	client := NewReplicationConfigurationClient(fake.MockBucketClient{
+		MockPutBucketReplication: func(_ context.Context, input *s3.PutBucketReplicationInput, _ []func(*s3.Options)) (*s3.PutBucketReplicationOutput, error) {
+			request = input
+			return &s3.PutBucketReplicationOutput{}, nil
+		},
+	})
+	if err := client.CreateOrUpdate(context.Background(), s3testing.Bucket(s3testing.WithReplConfig(config))); err != nil {
+		t.Fatalf("create or update replication configuration: %v", err)
+	}
+	if request == nil || request.ReplicationConfiguration == nil || len(request.ReplicationConfiguration.Rules) != 1 {
+		t.Fatalf("expected a replication request with one rule, got %#v", request)
+	}
+	metrics := request.ReplicationConfiguration.Rules[0].Destination.Metrics
+	if metrics == nil {
+		t.Fatal("expected enabled replication metrics in the request")
+	}
+	if metrics.EventThreshold != nil {
+		t.Fatalf("event threshold must remain absent from the AWS request, got %#v", metrics.EventThreshold)
+	}
+}
