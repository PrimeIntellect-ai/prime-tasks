+func TestReplicationMetricsAcceptsOmittedEventThresholdInCRDSchema(t *testing.T) {
+	data, err := ioutil.ReadFile(filepath.Join("..", "..", "..", "..", "package", "crds", "s3.aws.crossplane.io_buckets.yaml"))
+	if err != nil {
+		t.Fatalf("read bucket CRD: %v", err)
+	}
+	var crd map[string]interface{}
+	if err := yaml.Unmarshal(data, &crd); err != nil {
+		t.Fatalf("decode bucket CRD: %v", err)
+	}
+	spec := crd["spec"].(map[string]interface{})
+	versions := spec["versions"].([]interface{})
+	schema := versions[0].(map[string]interface{})["schema"].(map[string]interface{})["openAPIV3Schema"].(map[string]interface{})
+	properties := schema["properties"].(map[string]interface{})
+	replication := properties["spec"].(map[string]interface{})["properties"].(map[string]interface{})["forProvider"].(map[string]interface{})["properties"].(map[string]interface{})["replicationConfiguration"].(map[string]interface{})
+	rules := replication["properties"].(map[string]interface{})["rules"].(map[string]interface{})
+	items := rules["items"].(map[string]interface{})
+	destination := items["properties"].(map[string]interface{})["destination"].(map[string]interface{})
+	metrics := destination["properties"].(map[string]interface{})["metrics"].(map[string]interface{})
+	required, _ := metrics["required"].([]interface{})
+	for _, field := range required {
+		if field == "eventThreshold" {
+			t.Fatal("eventThreshold must not be required by the replication metrics schema")
+		}
+	}
+}
