@@ -48,4 +48,25 @@ class HtmlTest extends TestCase
 
         self::assertSame($expected, $actual->getPlainText());
     }
+
+    public function testSTag(): void
+    {
+        $html = new Html();
+        $input = 'Hello <s>test</s>world';
+        $richText = $html->toRichTextObject($input);
+
+        // The plain text content must be preserved.
+        self::assertSame('Hello testworld', $richText->getPlainText());
+
+        // Only the text inside the <s> tag should be struck through.
+        $struckText = '';
+        foreach ($richText->getRichTextElements() as $element) {
+            $font = $element->getFont();
+            if ($font !== null && $font->getStrikethrough()) {
+                $struckText .= $element->getText();
+            }
+        }
+
+        self::assertSame('test', $struckText);
+    }
 }
