+test('with routePrefix: \'/\' should redirect to /index.html', t => {
+  t.plan(5)
+  const fastify = Fastify()
+
+  const opts = JSON.parse(JSON.stringify(swaggerInfo))
+  opts.routePrefix = '/'
+  fastify.register(fastifySwagger, opts)
+
+  fastify.get('/foo', () => {})
+
+  fastify.inject({
+    method: 'GET',
+    url: '/'
+  }, (err, res) => {
+    t.error(err)
+    t.ok(res.statusCode >= 300 && res.statusCode < 400)
+    const location = res.headers['location']
+    t.ok(location.startsWith('/') || /^https?:\/\//.test(location))
+    t.strictEqual(new URL(location, 'http://localhost').host, 'localhost')
+    t.strictEqual(new URL(location, 'http://localhost').pathname, '/index.html')
+  })
+})
