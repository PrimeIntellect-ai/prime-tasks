+func TestParseJSONLiteralExpression(t *testing.T) {
+	const input = `  JSON '{"s": "foo", "n": 42}'`
+	p := &memefish.Parser{Lexer: &memefish.Lexer{File: &token.File{FilePath: "json.sql", Buffer: input}}}
+	expr, err := p.ParseExpr()
+	if err != nil {
+		t.Fatalf("ParseExpr() error = %v", err)
+	}
+	node := reflect.ValueOf(expr)
+	if node.Type().String() != "*ast.JSONLiteral" {
+		t.Fatalf("ParseExpr() returned %T, want *ast.JSONLiteral", expr)
+	}
+	node = node.Elem()
+	jsonPos := node.FieldByName("JSON")
+	if !jsonPos.IsValid() || jsonPos.Int() != 2 {
+		t.Errorf("JSON keyword position = %v, want 2", jsonPos)
+	}
+	value := node.FieldByName("Value")
+	if !value.IsValid() || value.Type().String() != "*ast.StringLiteral" || value.IsNil() {
+		t.Fatalf("JSON value has type %v, want a non-nil *ast.StringLiteral", value.Type())
+	}
+	stringValue := value.Elem().FieldByName("Value")
+	if !stringValue.IsValid() || stringValue.String() != `{"s": "foo", "n": 42}` {
+		t.Errorf("JSON string value = %v, want %q", stringValue, `{"s": "foo", "n": 42}`)
+	}
+}
