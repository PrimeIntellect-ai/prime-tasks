+func TestServerFromContextRetainedPushHandle(t *testing.T) {
+	type pusher interface {
+		Notify(context.Context, string, interface{}) error
+		Callback(context.Context, string, interface{}) (*jrpc2.Response, error)
+	}
+	var got pusher
+	notifications := make(chan *jrpc2.Request, 1)
+	callbacks := make(chan *jrpc2.Request, 1)
+	loc := server.NewLocal(handler.Map{
+		"Test": handler.New(func(ctx context.Context) error {
+			results := reflect.ValueOf(jrpc2.ServerFromContext).Call([]reflect.Value{reflect.ValueOf(ctx)})
+			if len(results) == 0 {
+				t.Errorf("ServerFromContext did not provide a server")
+				return nil
+			}
+			value := results[0].Interface()
+			var ok bool
+			got, ok = value.(pusher)
+			if !ok || got == nil {
+				t.Errorf("ServerFromContext returned a value that cannot send notifications and callbacks: %T", value)
+			}
+			return nil
+		}),
+	}, &server.LocalOptions{
+		Server: &jrpc2.ServerOptions{AllowPush: true},
+		Client: &jrpc2.ClientOptions{
+			OnNotify: func(req *jrpc2.Request) {
+				notifications <- req
+			},
+			OnCallback: func(_ context.Context, req *jrpc2.Request) (interface{}, error) {
+				callbacks <- req
+				return map[string]bool{"accepted": true}, nil
+			},
+		},
+	})
+	defer loc.Close()
+	if _, err := loc.Client.Call(context.Background(), "Test", nil); err != nil {
+		t.Fatalf("Call failed: %v", err)
+	}
+	if got == nil {
+		t.Fatal("handler did not obtain a push-capable server")
+	}
+	if err := got.Notify(context.Background(), "$/progress", map[string]int{"percentage": 25}); err != nil {
+		t.Fatalf("Notify after handler returned: %v", err)
+	}
+	select {
+	case req := <-notifications:
+		if req.Method() != "$/progress" {
+			t.Errorf("notification method = %q, want %q", req.Method(), "$/progress")
+		}
+		var params map[string]int
+		if err := req.UnmarshalParams(&params); err != nil {
+			t.Errorf("Unmarshal progress parameters: %v", err)
+		} else if params["percentage"] != 25 {
+			t.Errorf("progress parameters = %v, want percentage 25", params)
+		}
+	case <-time.After(5 * time.Second):
+		t.Error("client did not receive progress notification")
+	}
+
+	rsp, err := got.Callback(context.Background(), "$/progress-request", map[string]int{"step": 2})
+	if err != nil {
+		t.Fatalf("Callback after handler returned: %v", err)
+	}
+	var result map[string]bool
+	if err := rsp.UnmarshalResult(&result); err != nil {
+		t.Fatalf("Unmarshal callback result: %v", err)
+	}
+	if !result["accepted"] {
+		t.Errorf("callback result = %v, want accepted=true", result)
+	}
+	select {
+	case req := <-callbacks:
+		if req.Method() != "$/progress-request" {
+			t.Errorf("callback method = %q, want %q", req.Method(), "$/progress-request")
+		}
+		var params map[string]int
+		if err := req.UnmarshalParams(&params); err != nil {
+			t.Errorf("Unmarshal callback parameters: %v", err)
+		} else if params["step"] != 2 {
+			t.Errorf("callback parameters = %v, want step 2", params)
+		}
+	case <-time.After(5 * time.Second):
+		t.Error("client did not receive callback request")
+	}
+}
