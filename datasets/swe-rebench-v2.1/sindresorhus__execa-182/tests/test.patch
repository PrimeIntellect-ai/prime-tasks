+const echoScript = tempfile('.js');
+fs.writeFileSync(echoScript, 'console.log(process.argv.slice(2).join("\\n"))');
+
+test('allow string arguments', async t => {
+	const {stdout} = await execa(`node ${echoScript} foo bar`);
+	t.is(stdout, 'foo\nbar');
+});
+
+test('allow string arguments in synchronous mode', t => {
+	const {stdout} = execa.sync(`node ${echoScript} foo bar`);
+	t.is(stdout, 'foo\nbar');
+});
+
+test('preserve non-space characters in string arguments', async t => {
+	const {stdout} = await execa(`node ${echoScript} foo\tbar`);
+	t.is(stdout, 'foo\tbar');
+});
+
+test('allow escaping spaces in string arguments', async t => {
+	const {stdout} = await execa(`node ${echoScript} foo\\ bar`);
+	t.is(stdout, 'foo bar');
+});
+
+test('treat shell metacharacters as literal string arguments', async t => {
+	const {stdout} = await execa(`node ${echoScript} foo;bar`);
+	t.is(stdout, 'foo;bar');
+});
+
+test('allow string arguments with options', async t => {
+	const {stdout} = await execa('node fixtures/environment', {env: {BAR: 'bar'}});
+	t.is(stdout, 'foo\nbar');
+});
+
+test('do not parse string arguments when `shell` is true', async t => {
+	const command = process.platform === 'win32' ? 'echo %TEST%' : 'echo $TEST';
+	const {stdout} = await execa(command, {shell: true, env: {TEST: 'test'}});
+	t.is(stdout, 'test');
+});
+
+test('do not use a shell for string arguments', async t => {
+	await t.throwsAsync(execa('cd /'));
+});
+
