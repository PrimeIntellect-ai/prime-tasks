diff --git a/tests/lib/rules/require-meta-schema-description.js b/tests/lib/rules/require-meta-schema-description.js
new file mode 100644
index 0000000..e57a187
--- /dev/null
+++ b/tests/lib/rules/require-meta-schema-description.js
@@ -0,0 +1,279 @@
+'use strict';
+
+// ------------------------------------------------------------------------------
+// Requirements
+// ------------------------------------------------------------------------------
+
+const assert = require('chai').assert;
+const RuleTester = require('../eslint-rule-tester').RuleTester;
+const plugin = require('../../../lib');
+const rule = plugin.rules['require-meta-schema-description'];
+
+// ------------------------------------------------------------------------------
+// Tests
+// ------------------------------------------------------------------------------
+
+const ruleTester = new RuleTester({
+  languageOptions: { sourceType: 'commonjs' },
+});
+
+if (rule) {
+  ruleTester.run('require-meta-schema-description', rule, {
+    valid: [
+      ``,
+      `
+  module.exports = {};
+  `,
+      `
+  module.exports = {
+    create() {}
+  };
+  `,
+      `
+  module.exports = {
+    meta: {
+      schema: false,
+    },
+    create() {}
+  };
+  `,
+      `
+  module.exports = {
+    meta: {
+      schema: [false],
+    },
+    create() {}
+  };
+  `,
+      `
+  module.exports = {
+    meta: {
+      schema: [
+        {
+          description: 'Elements to allow.',
+          elements: { type: 'string' },
+          type: 'array',
+        },
+      ],
+    },
+  };
+  `,
+      `
+  const descriptionKey = 'description';
+
+  module.exports = {
+    meta: {
+      schema: [
+        {
+          [descriptionKey]: 'Elements to allow.',
+          elements: { type: 'string' },
+          type: 'array',
+        },
+      ],
+    },
+  };
+  `,
+      `
+  module.exports = {
+    meta: {
+      schema: [
+        {
+          description: 'Elements to allow.',
+          elements: { type: 'string' },
+          type: 'array',
+        },
+      ],
+    },
+    create() {}
+  };
+  `,
+      `
+  module.exports = {
+  meta: {
+  schema: [
+    {
+      ['description']: 'Elements to allow.',
+      elements: { type: 'string' },
+      type: 'array',
+    },
+  ],
+  },
+  create() {}
+  };
+  `,
+      `
+  module.exports = {
+    meta: {
+      schema: [
+        {
+          oneOf: [
+            {
+              description: 'Elements to allow.',
+              elements: { type: 'string' },
+              type: 'array',
+            }
+          ],
+        },
+      ],
+    },
+    create() {}
+  };
+  `,
+      `
+  module.exports = {
+    meta: {
+      schema: [
+        {
+          type: 'object',
+          $defs: {
+            directiveConfigSchema: {
+              oneOf: [
+                {
+                  type: 'boolean',
+                  default: true,
+                },
+              ],
+            },
+          },
+          additionalProperties: false,
+          properties: {
+            'ts-check': {
+              $ref: '#/items/0/$defs/directiveConfigSchema',
+              description: 'Whether to report @ts-check comments.',
+            },
+          },
+        },
+      ],
+    },
+    create() {}
+  };
+  `,
+    ],
+
+  invalid: [
+    {
+      code: `
+module.exports = {
+  meta: {
+    schema: [
+      {
+        elements: { type: 'string' },
+        type: 'array',
+      },
+    ],
+  },
+  create() {}
+};
+`,
+      errors: 1,
+    },
+    {
+      code: `
+const otherKey = 'other';
+
+module.exports = {
+  meta: {
+    schema: [
+      {
+        [otherKey]: 'Computed.',
+        elements: { type: 'string' },
+        type: 'array',
+      },
+    ],
+  },
+  create() {}
+};
+`,
+      errors: 1,
+    },
+    {
+      code: `
+module.exports = {
+  meta: {
+    schema: [
+      {
+        properties: {
+          something: {
+            type: 'string',
+          }
+        },
+        type: 'object',
+      },
+    ],
+  },
+  create() {}
+};
+`,
+      errors: 1,
+    },
+    {
+      code: `
+module.exports = {
+  meta: {
+    schema: [
+      {
+        oneOf: [
+          {
+            elements: { type: 'string' },
+            type: 'array',
+          }
+        ],
+      },
+    ],
+  },
+  create() {}
+};
+`,
+      errors: 1,
+    },
+    {
+      code: `
+module.exports = {
+  meta: {
+    schema: [
+      {
+        type: 'object',
+        $defs: {
+          directiveConfigSchema: {
+            oneOf: [
+              {
+                type: 'boolean',
+                default: true,
+              },
+            ],
+          },
+        },
+        additionalProperties: false,
+        properties: {
+          'ts-check': {
+            $ref: '#/items/0/$defs/directiveConfigSchema',
+          },
+        },
+      },
+    ],
+  },
+  create() {}
+};
+`,
+      errors: 1,
+    },
+  ],
+  });
+}
+
+describe('public rule registration', () => {
+  it('exposes the rule by its public name', () => {
+    assert.property(plugin.rules, 'require-meta-schema-description');
+  });
+
+  it('does not enable the rule in recommended configurations', () => {
+    assert.notProperty(
+      plugin.configs.recommended.rules,
+      'eslint-plugin/require-meta-schema-description',
+    );
+    assert.notProperty(
+      plugin.configs['flat/recommended'].rules,
+      'eslint-plugin/require-meta-schema-description',
+    );
+  });
+});
