new file mode 100644
index 0000000..7253e72
--- /dev/null
+++ b/tests/isolated/patcher_existing_locks_preexisting.py
@@ -0,0 +1,68 @@
+"""
+Ensure pre-existing RLocks get upgraded in a variety of situations.
+"""
+
+import threading
+import unittest.mock
+import eventlet
+
+
+class NS:
+    lock = threading.RLock()
+
+    class NS2:
+        lock = threading.RLock()
+
+    dict = {1: 2, 12: threading.RLock()}
+    list = [0, threading.RLock()]
+
+
+def ensure_upgraded(lock):
+    """Check that ``lock`` is a usable, greened lock.
+
+    We deliberately avoid asserting on the concrete lock class: any
+    implementation that leaves a usable, cooperative lock in place is
+    acceptable.  What matters is that the reference was not corrupted (the
+    bug left dicts/descriptors behind) and that blocking on the lock yields
+    to the eventlet hub instead of blocking the whole thread.
+    """
+    if not (hasattr(lock, 'acquire') and hasattr(lock, 'release')):
+        raise RuntimeError('lock reference was corrupted: {!r}'.format(lock))
+
+    # While this greenlet holds the lock, another greenlet that tries to
+    # acquire it must block cooperatively (yield to the hub).  If the lock
+    # were not greened, the second greenlet would block the whole OS thread
+    # and this test would hang.
+    lock.acquire()
+    acquired = []
+
+    def waiter():
+        with lock:
+            acquired.append(True)
+
+    g = eventlet.spawn(waiter)
+    eventlet.sleep(0)
+    blocked = not acquired
+    lock.release()
+    g.wait()
+    if not blocked:
+        raise RuntimeError('lock did not exclude the waiter')
+    if not acquired:
+        raise RuntimeError('waiter never acquired the lock')
+
+
+if __name__ == '__main__':
+    # These extra print()s caused either test failures or segfaults until
+    # https://github.com/eventlet/eventlet/issues/864 was fixed.
+    has_mock_lock = hasattr(unittest.mock.NonCallableMock, '_lock')
+    if has_mock_lock:
+        print(unittest.mock.NonCallableMock._lock)
+    print(NS.lock)
+    eventlet.monkey_patch()
+    ensure_upgraded(NS.lock)
+    ensure_upgraded(NS.NS2.lock)
+    ensure_upgraded(NS.dict[12])
+    ensure_upgraded(NS.list[1])
+    if has_mock_lock:
+        ensure_upgraded(unittest.mock.NonCallableMock._lock)
+    print("pass")
