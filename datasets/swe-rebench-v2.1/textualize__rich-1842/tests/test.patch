+def test_inspect_swig_edge_case():
+    """Issue #1838 - Edge case with Faiss library - object with empty dir()"""
+
+    class Thing:
+        @property
+        def __class__(self):
+            raise AttributeError
+
+    thing = Thing()
+    try:
+        inspect(thing)
+    except Exception as e:
+        assert False, f"Object with no __class__ shouldn't raise {e}"
+
+
+def test_inspect_faiss_module_with_broken_class_lookup():
+    class FaissGlobals:
+        @property
+        def __class__(self):
+            raise AttributeError("Unknown C global variable '__class__'")
+
+        def __dir__(self):
+            return []
+
+    inspect(FaissGlobals())
