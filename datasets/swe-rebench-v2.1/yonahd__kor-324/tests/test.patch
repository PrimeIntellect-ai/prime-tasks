+
+func TestReplicaSetAgeFilteringThroughCLI(t *testing.T) {
+	var zero int32
+	older := CreateTestReplicaSet(testNamespace, "older-replicaset", &zero, &appsv1.ReplicaSetStatus{})
+	older.CreationTimestamp = v1.NewTime(time.Now().Add(-48 * time.Hour))
+	newer := CreateTestReplicaSet(testNamespace, "newer-replicaset", &zero, &appsv1.ReplicaSetStatus{})
+	newer.CreationTimestamp = v1.NewTime(time.Now().Add(-time.Hour))
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/api/v1/namespaces":
+			_ = json.NewEncoder(w).Encode(corev1.NamespaceList{
+				TypeMeta: v1.TypeMeta{APIVersion: "v1", Kind: "NamespaceList"},
+				Items:    []corev1.Namespace{{ObjectMeta: v1.ObjectMeta{Name: testNamespace}}},
+			})
+		case "/apis/apps/v1/namespaces/" + testNamespace + "/replicasets":
+			_ = json.NewEncoder(w).Encode(appsv1.ReplicaSetList{
+				TypeMeta: v1.TypeMeta{APIVersion: "apps/v1", Kind: "ReplicaSetList"},
+				Items:    []appsv1.ReplicaSet{*older, *newer},
+			})
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+
+	kubeconfig := clientcmdapi.NewConfig()
+	kubeconfig.Clusters["test"] = &clientcmdapi.Cluster{Server: server.URL}
+	kubeconfig.AuthInfos["test"] = &clientcmdapi.AuthInfo{}
+	kubeconfig.Contexts["test"] = &clientcmdapi.Context{Cluster: "test", AuthInfo: "test"}
+	kubeconfig.CurrentContext = "test"
+	kubeconfigPath := filepath.Join(t.TempDir(), "kubeconfig")
+	if err := clientcmd.WriteToFile(*kubeconfig, kubeconfigPath); err != nil {
+		t.Fatalf("writing kubeconfig: %v", err)
+	}
+
+	for _, tc := range []struct {
+		flag     string
+		want     string
+		dontWant string
+	}{
+		{flag: "--older-than=24h", want: "older-replicaset", dontWant: "newer-replicaset"},
+		{flag: "--newer-than=24h", want: "newer-replicaset", dontWant: "older-replicaset"},
+	} {
+		t.Run(strings.TrimPrefix(tc.flag, "--"), func(t *testing.T) {
+			command := exec.Command("go", "run", "../../main.go", "replicaset", "--kubeconfig", kubeconfigPath,
+				"--output=json", tc.flag)
+			output, err := command.CombinedOutput()
+			if err != nil {
+				t.Fatalf("running ReplicaSet CLI: %v\n%s", err, output)
+			}
+			if !strings.Contains(string(output), tc.want) {
+				t.Errorf("CLI output should contain %q, got:\n%s", tc.want, output)
+			}
+			if strings.Contains(string(output), tc.dontWant) {
+				t.Errorf("CLI output should not contain %q, got:\n%s", tc.dontWant, output)
+			}
+		})
+	}
+}
