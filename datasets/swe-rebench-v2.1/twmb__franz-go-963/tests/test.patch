+func TestClientOptionValueRetrieval(t *testing.T) {
+	httpcl := &http.Client{}
+	tlscfg := &tls.Config{}
+
+	c, err := NewClient(
+		HTTPClient(httpcl),
+		URLs("localhost:8081", "localhost2:8082"),
+		UserAgent("some-ua"),
+		DialTLSConfig(tlscfg),
+		BasicAuth("some-user", "some-pass"),
+		BearerToken("some-bearer"),
+		PreReq(func(req *http.Request) error {
+			req.Header.Set("Authorization", "foobar")
+			return nil
+		}),
+		DefaultParams(Normalize, Verbose),
+	)
+	if err != nil {
+		t.Fatalf("unable to create client: %s", err)
+	}
+
+	tests := []struct {
+		name     string
+		opt      any
+		assertFn func(v any) bool
+	}{
+		{
+			name:     "HTTPClient",
+			opt:      "HTTPClient",
+			assertFn: func(v any) bool { return v == httpcl },
+		},
+		{
+			name: "URLs",
+			opt:  "URLs",
+			assertFn: func(v any) bool {
+				got := fmt.Sprint(v)
+				return strings.Contains(got, "localhost:8081") && strings.Contains(got, "localhost2:8082")
+			},
+		},
+		{
+			name:     "UserAgent",
+			opt:      "UserAgent",
+			assertFn: func(v any) bool { return v.(string) == "some-ua" },
+		},
+		{
+			name:     "DialTLSConfig",
+			opt:      "DialTLSConfig",
+			assertFn: func(v any) bool { return v == tlscfg },
+		},
+		{
+			name:     "BasicAuth",
+			opt:      BasicAuth,
+			assertFn: func(v any) bool { return v != nil },
+		},
+		{
+			name:     "BearerToken",
+			opt:      BearerToken,
+			assertFn: func(v any) bool { return v.(string) == "some-bearer" },
+		},
+		{
+			name:     "PreReq",
+			opt:      "PreReq",
+			assertFn: func(v any) bool { return v != nil },
+		},
+		{
+			name:     "DefaultParams",
+			opt:      DefaultParams,
+			assertFn: func(v any) bool { return v != nil },
+		},
+		{
+			name:     "unknown option name",
+			opt:      "Unknown",
+			assertFn: func(v any) bool { return v == nil },
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got := c.OptValue(test.opt)
+			if !test.assertFn(got) {
+				t.Errorf("assertion failed: %q", got)
+			}
+		})
+	}
+
+	t.Run("single-input option values", func(t *testing.T) {
+		for _, opt := range []any{"UserAgent", UserAgent} {
+			got := c.OptValues(opt)
+			if len(got) != 1 || got[0] != "some-ua" {
+				t.Errorf("OptValues(%v): expected one user-agent value, got %#v", opt, got)
+			}
+		}
+	})
+
+	t.Run("unknown option values", func(t *testing.T) {
+		if got := c.OptValues("Unknown"); len(got) != 0 {
+			t.Errorf("OptValues for unknown option: expected no values, got %#v", got)
+		}
+	})
+
+	t.Run("BasicAuthValues", func(t *testing.T) {
+		got := c.OptValues(BasicAuth)
+		if len(got) != 2 {
+			t.Fatalf("number of return values: expected 2, got %d", len(got))
+		}
+		if got[0] != "some-user" {
+			t.Errorf("username: expected some-user, got %#v", got[0])
+		}
+		if got[1] != "some-pass" {
+			t.Errorf("password: expected some-pass, got %#v", got[1])
+		}
+	})
+}
