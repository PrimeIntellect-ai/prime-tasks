+func TestMetricResourceToMonitoringResourceWithConfiguredResource(t *testing.T) {
+	configured := &monitoredrespb.MonitoredResource{
+		Type:   "k8s_container",
+		Labels: map[string]string{"cluster_name": "my-cluster"},
+	}
+	exporter, capture := newResourceTestExporter(t, configured)
+
+	// A nil input resource must fall back to the exporter's configured Resource.
+	if got := metricResourceViaPublicExport(t, exporter, capture, nil); !monitoringResourcesMatch(got, configured) {
+		t.Fatalf("nil input: got resource %v, want %v", got, configured)
+	}
+
+	// An explicitly supplied resource must take precedence over the configured one.
+	supplied := &resource.Resource{Type: "gce_instance", Labels: map[string]string{"instance_id": "123"}}
+	want := &monitoredrespb.MonitoredResource{Type: "gce_instance", Labels: map[string]string{"instance_id": "123"}}
+	if got := metricResourceViaPublicExport(t, exporter, capture, supplied); !monitoringResourcesMatch(got, want) {
+		t.Fatalf("supplied input: got resource %v, want %v", got, want)
+	}
+}
