+type resourceTestMonitoringServer struct {
+	monitoringpb.MetricServiceServer
+	timeSeries chan *monitoringpb.TimeSeries
+}
+
+func (s *resourceTestMonitoringServer) CreateMetricDescriptor(_ context.Context, req *monitoringpb.CreateMetricDescriptorRequest) (*googlemetricpb.MetricDescriptor, error) {
+	return req.MetricDescriptor, nil
+}
+
+func (s *resourceTestMonitoringServer) CreateTimeSeries(_ context.Context, req *monitoringpb.CreateTimeSeriesRequest) (*empty.Empty, error) {
+	for _, ts := range req.TimeSeries {
+		s.timeSeries <- ts
+	}
+	return &empty.Empty{}, nil
+}
+
+func newResourceTestExporter(t *testing.T, configured *monitoredrespb.MonitoredResource) (*Exporter, *resourceTestMonitoringServer) {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("listen for Monitoring test service: %v", err)
+	}
+	server := grpc.NewServer()
+	capture := &resourceTestMonitoringServer{timeSeries: make(chan *monitoringpb.TimeSeries, 16)}
+	monitoringpb.RegisterMetricServiceServer(server, capture)
+	go server.Serve(listener)
+	t.Cleanup(func() {
+		server.Stop()
+		listener.Close()
+	})
+
+	stats, err := newStatsExporter(Options{
+		ProjectID:               "foo",
+		Resource:                configured,
+		BundleCountThreshold:    1,
+		MonitoringClientOptions: []option.ClientOption{option.WithEndpoint(listener.Addr().String()), option.WithoutAuthentication(), option.WithGRPCDialOption(grpc.WithInsecure())},
+	})
+	if err != nil {
+		t.Fatalf("create metrics exporter: %v", err)
+	}
+	return &Exporter{statsExporter: stats}, capture
+}
+
+func metricResourceViaPublicExport(t *testing.T, exporter *Exporter, capture *resourceTestMonitoringServer, rs *resource.Resource) *monitoredrespb.MonitoredResource {
+	t.Helper()
+	metric := &metricdata.Metric{
+		Descriptor: metricdata.Descriptor{
+			Name: "test_metric",
+			Type: metricdata.TypeGaugeInt64,
+		},
+		Resource: rs,
+		TimeSeries: []*metricdata.TimeSeries{
+			{
+				Points: []metricdata.Point{
+					{Time: time.Now(), Value: int64(1)},
+				},
+			},
+		},
+	}
+	if err := exporter.ExportMetrics(context.Background(), []*metricdata.Metric{metric}); err != nil {
+		t.Fatalf("ExportMetrics(%v): %v", rs, err)
+	}
+	select {
+	case ts := <-capture.timeSeries:
+		return ts.Resource
+	case <-time.After(5 * time.Second):
+		t.Fatalf("ExportMetrics(%v): no time series was submitted", rs)
+		return nil
+	}
+}
+
+func monitoringResourcesMatch(got, want *monitoredrespb.MonitoredResource) bool {
+	if got == nil || want == nil {
+		return got == want
+	}
+	if got.Type != want.Type || len(got.Labels) != len(want.Labels) {
+		return false
+	}
+	for key, value := range want.Labels {
+		if got.Labels[key] != value {
+			return false
+		}
+	}
+	return true
+}
