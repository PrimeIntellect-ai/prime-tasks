+func TestGetChannelInformationSupports100BroadcasterIDs(t *testing.T) {
+	ids := make([]string, 100)
+	channels := make([]ChannelInformation, 100)
+	expectedIDs := make(map[string]bool, len(ids))
+	for i := range ids {
+		ids[i] = strconv.Itoa(1000 + i)
+		channels[i] = ChannelInformation{BroadcasterID: ids[i]}
+		expectedIDs[ids[i]] = true
+	}
+
+	responseBody, err := json.Marshal(ManyChannelInformation{Channels: channels})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var requestedIDs []string
+	client := newMockClient(&Options{ClientID: "my-client-id"}, func(w http.ResponseWriter, r *http.Request) {
+		requestedIDs = r.URL.Query()["broadcaster_id"]
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write(responseBody)
+	})
+
+	resp, err := client.GetChannelInformation(&GetChannelInformationParams{BroadcasterIDs: ids})
+	if err != nil {
+		t.Fatalf("GetChannelInformation returned an error: %v", err)
+	}
+	if len(requestedIDs) != len(ids) {
+		t.Fatalf("request contained %d broadcaster IDs; want %d", len(requestedIDs), len(ids))
+	}
+	requestedSet := make(map[string]bool, len(ids))
+	for _, id := range requestedIDs {
+		if !expectedIDs[id] {
+			t.Errorf("request contained unexpected broadcaster ID %q", id)
+		}
+		requestedSet[id] = true
+	}
+	if len(requestedSet) != len(expectedIDs) {
+		t.Errorf("request did not include each of the %d requested broadcaster IDs", len(ids))
+	}
+	if len(resp.Data.Channels) != len(ids) {
+		t.Fatalf("got %d channel objects; want %d", len(resp.Data.Channels), len(ids))
+	}
+	returnedSet := make(map[string]bool, len(ids))
+	for _, channel := range resp.Data.Channels {
+		if !expectedIDs[channel.BroadcasterID] {
+			t.Errorf("returned unexpected channel ID %q", channel.BroadcasterID)
+		}
+		returnedSet[channel.BroadcasterID] = true
+	}
+	if len(returnedSet) != len(expectedIDs) {
+		t.Errorf("response did not include each of the %d requested channels", len(ids))
+	}
+}
