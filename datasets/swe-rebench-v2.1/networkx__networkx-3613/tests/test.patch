+    def test_transitive_closure_self_loops_only_for_cyclic_vertices(self):
+        G = nx.DiGraph([(1, 2), (2, 1), (2, 3)])
+        G.add_node(4)
+
+        H = nx.transitive_closure(G)
+
+        assert {v for v in G if H.has_edge(v, v)} == {1, 2}
+
+    def test_transitive_closure_preserves_self_loop_data(self):
+        G = nx.DiGraph()
+        G.add_edge(1, 1, label="existing loop")
+        G.add_edge(1, 2, weight=5)
+
+        H = nx.transitive_closure(G)
+
+        assert H.get_edge_data(1, 1) == {"label": "existing loop"}
+
+    def test_transitive_closure_cycles(self):
+        G = nx.DiGraph(
+            [(0, 1), (0, 2), (1, 0), (1, 2), (2, 0), (2, 1)]
+        )
+
+        H = nx.transitive_closure(G)
+
+        assert set(H.edges()) == {(u, v) for u in G for v in G}
+
