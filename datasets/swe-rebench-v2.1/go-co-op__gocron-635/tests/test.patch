+func TestDailyJob_MidnightAdvancesAfterRun(t *testing.T) {
+	start := time.Date(2000, 1, 1, 23, 59, 59, 0, time.Local)
+	fakeClock := clockwork.NewFakeClockAt(start)
+	s := newTestScheduler(t, WithClock(fakeClock))
+	runs := make(chan struct{}, 10)
+
+	j, err := s.NewJob(
+		DailyJob(1, NewAtTimes(NewAtTime(0, 0, 0))),
+		NewTask(func() {
+			select {
+			case runs <- struct{}{}:
+			default:
+			}
+		}),
+	)
+	require.NoError(t, err)
+	defer s.Shutdown()
+
+	s.Start()
+	fakeClock.Advance(time.Second)
+	select {
+	case <-runs:
+	case <-time.After(time.Second):
+		t.Fatal("daily job did not run at midnight")
+	}
+
+	expectedNextRun := time.Date(2000, 1, 3, 0, 0, 0, 0, time.Local)
+	require.Eventually(t, func() bool {
+		nextRun, err := j.NextRun()
+		return err == nil && nextRun.Equal(expectedNextRun)
+	}, time.Second, 5*time.Millisecond, "the next run should be the following midnight")
+
+	select {
+	case <-runs:
+		t.Fatal("daily job ran again before its next scheduled day")
+	case <-time.After(100 * time.Millisecond):
+	}
+
+}
