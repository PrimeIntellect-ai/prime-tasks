@@ -1,6 +1,6 @@
 from pydatastructs.trees.binary_trees import (
     BinarySearchTree, BinaryTreeTraversal, AVLTree,
-    ArrayForTrees, BinaryIndexedTree)
+    ArrayForTrees, BinaryIndexedTree, SelfBalancingBinaryTree)
 from pydatastructs.utils.raises_util import raises
 from pydatastructs.utils.misc_util import TreeNode
 from copy import deepcopy
@@ -319,3 +319,61 @@ def test_BinaryIndexedTree():
     assert t.get_sum(0, 2) == 105
     assert t.get_sum(0, 4) == 114
     assert t.get_sum(1, 9) == 54
+
+def _assert_links_consistent(tree):
+    roots = []
+    for i, node in enumerate(tree.tree):
+        if node is None:
+            continue
+        if node.parent is None:
+            roots.append(i)
+        else:
+            parent = tree.tree[node.parent]
+            assert parent.left == i or parent.right == i
+        for child in (node.left, node.right):
+            if child is not None:
+                assert tree.tree[child].parent == i
+    assert roots == [tree.root_idx]
+
+def _in_order_keys(tree):
+    keys = []
+    def walk(i):
+        if i is None:
+            return
+        walk(tree.tree[i].left)
+        keys.append(tree.tree[i].key)
+        walk(tree.tree[i].right)
+    walk(tree.root_idx)
+    return keys
+
+def test_issue_234():
+    """
+    https://github.com/codezonediitj/pydatastructs/issues/234
+    """
+    tree = SelfBalancingBinaryTree()
+    for key in [5, 5.5, 4.5, 4.6, 4.4, 4.55, 4.65]:
+        tree.insert(key, key)
+    keys_before = _in_order_keys(tree)
+    # Node 3 (key 4.6) is the right child of node 2 (key 4.5).
+    # Rotating it with its left child (node 5, key 4.55) must
+    # put node 5 into the right slot of node 2.
+    tree._right_rotate(3, 5)
+    _assert_links_consistent(tree)
+    assert _in_order_keys(tree) == keys_before
+    assert tree.tree[2].left == 4
+    assert tree.tree[2].right == 5
+    assert tree.tree[5].parent == 2
+
+    tree = SelfBalancingBinaryTree()
+    for key in [10, 5, 15, 3, 7, 6]:
+        tree.insert(key, key)
+    idx = {node.key: i for i, node in enumerate(tree.tree) if node is not None}
+    keys_before = _in_order_keys(tree)
+    # Node 5 is the left child of the root (key 10).
+    # Rotating it with its right child (node 7) must put
+    # node 7 into the left slot of the root.
+    tree._left_rotate(idx[5], idx[7])
+    _assert_links_consistent(tree)
+    assert _in_order_keys(tree) == keys_before
+    assert tree.tree[tree.root_idx].left == idx[7]
+    assert tree.tree[idx[7]].parent == tree.root_idx
