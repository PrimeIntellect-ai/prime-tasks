--- /dev/null
+++ b/test/unit/deprecation.test.ts
@@ -0,0 +1,24 @@
+import { createWebhooksApi, Webhooks } from "../../src";
+
+describe("Deprecated methods", () => {
+  test("createWebhooksApi", () => {
+    const spy = jest.spyOn(console, "error");
+    createWebhooksApi({ secret: "foo" });
+    expect(spy).toBeCalledWith(
+      "[@octokit/webhooks] `createWebhooksApi()` is deprecated and will be removed in a future release of `@octokit/webhooks`, please use the `Webhooks` class instead"
+    );
+    spy.mockClear();
+  });
+
+  test("createWebhooksApi returns a Webhooks instance initialized with the provided options", () => {
+    const spy = jest.spyOn(console, "error");
+    const webhooks = createWebhooksApi({ secret: "foo" });
+
+    expect(webhooks).toBeInstanceOf(Webhooks);
+    expect(webhooks.sign("payload")).toEqual(
+      new Webhooks({ secret: "foo" }).sign("payload")
+    );
+
+    spy.mockClear();
+  });
+});
