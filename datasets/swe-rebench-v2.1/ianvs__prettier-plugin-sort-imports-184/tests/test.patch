+
+exports[`mixed-case.ts - typescript-verify > mixed-case.ts 1`] = `
+import c from "c";
+import b from "b";
+import a from "a";
+import file10 from "file10";
+import File10 from "File10";
+import file2 from "file2";
+import File2 from "File2";
+import { alpha10, Alpha2, Alpha10, alpha2 } from "specifiers";
+
+import {cat, Dog} from "C";
+import B from "B";
+import A from "A";
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+import A from "A";
+import B from "B";
+import { Dog, cat } from "C";
+import File2 from "File2";
+import File10 from "File10";
+import a from "a";
+import b from "b";
+import c from "c";
+import file2 from "file2";
+import file10 from "file10";
+import { Alpha2, Alpha10, alpha2, alpha10 } from "specifiers";
+
+`;
