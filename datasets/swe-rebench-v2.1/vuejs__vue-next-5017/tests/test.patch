+
+  // #5016
+  test('handling attr with undefined value', () => {
+    let childAttrs: any
+    let childProps: any
+    const Comp = {
+      props: ['declared'],
+      render(this: any) {
+        childAttrs = this.$attrs
+        childProps = this.$props
+        return ''
+      }
+    }
+    const Parent = defineComponent({
+      props: ['value'],
+      render(this: any) {
+        return (
+          openBlock(),
+          createBlock('div', null, [
+            createVNode(
+              Comp,
+              { declared: true, foo: this.value },
+              null,
+              PatchFlags.PROPS,
+              ['foo']
+            )
+          ])
+        )
+      }
+    })
+    const root = nodeOps.createElement('div')
+
+    render(h(Parent, { value: undefined }), root)
+    render(h(Parent, { value: 'bar' }), root)
+    expect(childAttrs.foo).toBe('bar')
+    expect(childProps.foo).toBeUndefined()
+  })
+
+  test('handling kebab-case attr with undefined value', () => {
+    let childAttrs: any
+    let childProps: any
+    const Comp = {
+      props: ['declared'],
+      render(this: any) {
+        childAttrs = this.$attrs
+        childProps = this.$props
+        return ''
+      }
+    }
+    const Parent = defineComponent({
+      props: ['value'],
+      render(this: any) {
+        return (
+          openBlock(),
+          createBlock('div', null, [
+            createVNode(
+              Comp,
+              { declared: true, 'my-class': this.value },
+              null,
+              PatchFlags.PROPS,
+              ['my-class']
+            )
+          ])
+        )
+      }
+    })
+    const root = nodeOps.createElement('div')
+
+    render(h(Parent, { value: undefined }), root)
+    render(h(Parent, { value: 'xxx' }), root)
+    expect(childAttrs['my-class']).toBe('xxx')
+    expect(childProps.myClass).toBeUndefined()
+  })
 })
