+func TestAppsService_RevokeInstallationToken(t *testing.T) {
+	client, mux, _, teardown := setup()
+	defer teardown()
+
+	mux.HandleFunc("/installation/token", func(w http.ResponseWriter, r *http.Request) {
+		testMethod(t, r, "DELETE")
+		testHeader(t, r, "Accept", "application/vnd.github.gambit-preview+json")
+		w.WriteHeader(http.StatusNoContent)
+	})
+
+	resp, err := client.Apps.RevokeInstallationToken(context.Background())
+	if err != nil {
+		t.Errorf("Apps.RevokeInstallationToken returned error: %v", err)
+	}
+	if resp == nil {
+		t.Error("Apps.RevokeInstallationToken returned nil Response")
+	} else if resp.StatusCode != http.StatusNoContent {
+		t.Errorf("Apps.RevokeInstallationToken returned status %d, want %d", resp.StatusCode, http.StatusNoContent)
+	}
+}
+
+func TestAppsService_RevokeInstallationTokenError(t *testing.T) {
+	client, mux, _, teardown := setup()
+	defer teardown()
+
+	mux.HandleFunc("/installation/token", func(w http.ResponseWriter, r *http.Request) {
+		testMethod(t, r, "DELETE")
+		testHeader(t, r, "Accept", "application/vnd.github.gambit-preview+json")
+		http.Error(w, "token revocation failed", http.StatusInternalServerError)
+	})
+
+	_, err := client.Apps.RevokeInstallationToken(context.Background())
+	if err == nil {
+		t.Fatal("Apps.RevokeInstallationToken returned no error for an unsuccessful response")
+	}
+}
