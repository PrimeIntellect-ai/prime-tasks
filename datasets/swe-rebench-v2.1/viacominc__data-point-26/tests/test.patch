+  })
+  test('It should not execute utils.inspect', () => {
+    console.info = jest.fn()
+    Reducer.inspect(getAcc())
+    expect(console.info.mock.calls[0]).toContain('test:test')
+  })
+  test('It should output options', () => {
+    console.info = jest.fn()
