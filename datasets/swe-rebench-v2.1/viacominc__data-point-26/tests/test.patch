+
+describe('inspect during request', () => {
+  let consoleInfo
+  beforeAll(() => {
+    consoleInfo = console.info
+  })
+  afterEach(() => {
+    console.info = consoleInfo
+  })
+
+  test('outputs the entity information before the request is made', () => {
+    dataPoint.addEntities({
+      'request:inspectTrue': {
+        url: 'http://remote.test/source1',
+        params: { inspect: true }
+      }
+    })
+    console.info = jest.fn()
+    nock('http://remote.test')
+      .get('/source1')
+      .reply(200, { ok: true })
+
+    return dataPoint.transform('request:inspectTrue', {}).then(result => {
+      const logged = console.info.mock.calls
+        .map(args => args.join(' '))
+        .join('\n')
+      expect(logged).toContain('request:inspectTrue')
+      expect(result.value).toEqual({ ok: true })
+    })
+  })
+
+  test('runs custom inspect with the accumulator before the request is made', () => {
+    const order = []
+    const inspectCalls = []
+    const inspectFn = function (acc) {
+      inspectCalls.push({ acc, argCount: arguments.length })
+      order.push('inspect')
+    }
+    dataPoint.addEntities({
+      'request:inspectFn': {
+        url: 'http://remote.test/source1',
+        params: { inspect: inspectFn }
+      }
+    })
+    nock('http://remote.test')
+      .get('/source1')
+      .reply(200, () => {
+        order.push('request')
+        return { ok: true }
+      })
+
+    return dataPoint.transform('request:inspectFn', {}).then(() => {
+      expect(order).toEqual(['inspect', 'request'])
+      expect(inspectCalls.length).toBe(1)
+      expect(inspectCalls[0].argCount).toBe(1)
+      expect(inspectCalls[0].acc.reducer.spec.id).toBe('request:inspectFn')
+      expect(inspectCalls[0].acc.params.inspect).toBe(inspectFn)
+    })
+  })
+})
+
