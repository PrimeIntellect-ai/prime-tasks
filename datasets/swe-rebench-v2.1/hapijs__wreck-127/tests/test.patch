+
+    it('emits request information before sending requests', (done) => {
+
+        let eventObserved = false;
+        const server = Http.createServer((req, res) => {
+
+            expect(eventObserved).to.equal(true);
+            res.writeHead(200);
+            res.end('ok');
+        });
+
+        Wreck.once('request', (...details) => {
+
+            eventObserved = true;
+            expect(details.length).to.be.above(0);
+            expect(details.some((detail) => detail !== undefined && detail !== null)).to.equal(true);
+        });
+
+        server.listen(0, () => {
+
+            Wreck.post('http://localhost:' + server.address().port, {}, (err, res, payload) => {
+
+                expect(err).to.not.exist();
+                expect(res.statusCode).to.equal(200);
+                expect(payload.toString()).to.equal('ok');
+                server.close();
+                done();
+            });
+        });
+    });
+
+    it('emits request information before every redirected request', (done) => {
+
+        const requests = [];
+        const eventCountsAtServer = [];
+        const server = Http.createServer((req, res) => {
+
+            eventCountsAtServer.push(requests.length);
+            if (req.url === '/') {
+                res.writeHead(302, { Location: '/redirected' });
+                res.end();
+                return;
+            }
+
+            res.writeHead(200);
+            res.end('ok');
+        });
+
+        const listener = (...details) => {
+
+            // The URI and options may arrive as separate arguments or as fields of a single payload
+            const uri = details.reduce((found, detail) => {
+
+                if (found) {
+                    return found;
+                }
+
+                if (detail && typeof detail.href === 'string') {
+                    return detail;
+                }
+
+                return (detail && detail.uri && typeof detail.uri.href === 'string') ? detail.uri : undefined;
+            }, undefined);
+
+            const options = details.reduce((found, detail) => {
+
+                if (found || !detail || typeof detail !== 'object') {
+                    return found;
+                }
+
+                if (detail.uri) {
+                    return detail.options;
+                }
+
+                return detail !== uri && typeof detail.href !== 'string' ? detail : undefined;
+            }, undefined);
+
+            requests.push({ uri, options });
+        };
+
+        Wreck.on('request', listener);
+
+        server.listen(0, () => {
+
+            const url = 'http://localhost:' + server.address().port;
+            Wreck.get(url, { redirects: 1 }, (err, res, payload) => {
+
+                Wreck.removeListener('request', listener);
+                expect(err).to.not.exist();
+                expect(res.statusCode).to.equal(200);
+                expect(payload.toString()).to.equal('ok');
+                expect(requests.length).to.equal(2);
+                expect(eventCountsAtServer[0]).to.equal(1);
+                expect(eventCountsAtServer[1]).to.equal(2);
+                expect(requests[0].uri.href).to.equal(url + '/');
+                expect(requests[1].uri.href).to.equal(url + '/redirected');
+                expect(requests.every((request) => request.options && typeof request.options === 'object')).to.equal(true);
+                server.close();
+                done();
+            });
+        });
+    });
 });
 
