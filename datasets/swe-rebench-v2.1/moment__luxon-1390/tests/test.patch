+test("DateTime#plus works across the 100 barrier when passing through February", () => {
+  const z = DateTime.fromISO("0099-12-31", { zone: "utc" });
+  const a = DateTime.fromISO("0100-03-01", { zone: "utc" });
+  const b = DateTime.fromISO("0100-03-02", { zone: "utc" });
+
+  // the two diff forms must agree, and the two dates must be one day apart
+  expect(a.diff(z).as("days")).toBe(60);
+  expect(b.diff(z).as("days")).toBe(61);
+  expect(a.diff(z, "days").as("days")).toBe(60);
+  expect(b.diff(z, "days").as("days")).toBe(61);
+});
+
