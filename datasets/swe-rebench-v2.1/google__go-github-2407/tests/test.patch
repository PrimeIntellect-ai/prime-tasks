+func TestPagesUpdate_SourceFieldTypes(t *testing.T) {
+	stringPointer := reflect.TypeOf((*string)(nil))
+	checks := []struct {
+		structType reflect.Type
+		field      string
+		want       reflect.Type
+	}{
+		{reflect.TypeOf(PagesUpdate{}), "Source", reflect.TypeOf((*PagesSource)(nil))},
+		{reflect.TypeOf(PagesSource{}), "Branch", stringPointer},
+		{reflect.TypeOf(PagesSource{}), "Path", stringPointer},
+	}
+
+	for _, check := range checks {
+		field, ok := check.structType.FieldByName(check.field)
+		if !ok {
+			t.Errorf("%s has no %s field", check.structType.Name(), check.field)
+			continue
+		}
+		if field.Type != check.want {
+			t.Errorf("%s.%s has type %v, want %v", check.structType.Name(), check.field, field.Type, check.want)
+		}
+	}
+}
