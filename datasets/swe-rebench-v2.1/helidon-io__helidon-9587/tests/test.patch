+package io.helidon.tracing.providers.opentelemetry;
+
+import java.util.Map;
+import java.util.ServiceLoader;
+
+import io.helidon.tracing.Tracer;
+import io.helidon.tracing.spi.TracerProvider;
+
+import io.opentelemetry.api.OpenTelemetry;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class TestGlobalTracerAssignment {
+
+    @Test
+    void assignGlobalTracer() {
+        OpenTelemetry openTelemetry = OpenTelemetry.noop();
+        io.opentelemetry.api.trace.Tracer otelTracer = openTelemetry.getTracer("testTracer");
+        Tracer tracer = HelidonOpenTelemetry.create(openTelemetry, otelTracer, Map.of());
+
+        // Assigning a valid Helidon OpenTelemetry tracer must not throw
+        assertDoesNotThrow(() -> Tracer.global(tracer));
+
+        // ... and the assignment must take effect: the OpenTelemetry provider reports that a global tracer is registered
+        TracerProvider otelProvider = ServiceLoader.load(TracerProvider.class)
+                .stream()
+                .map(ServiceLoader.Provider::get)
+                .filter(OpenTelemetryTracerProvider.class::isInstance)
+                .findFirst()
+                .orElseThrow(() -> new AssertionError("OpenTelemetry tracer provider is not registered"));
+        assertTrue(otelProvider.available(),
+                   "Global tracer must be installed after Tracer.global(tracer) with a Helidon OpenTelemetry tracer");
+    }
+}
