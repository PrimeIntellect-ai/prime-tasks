+
+// This test ensures that parent variables are inherited in the block.
+// This is a regression test for <https://github.com/rinja-rs/rinja/issues/246>.
+#[test]
+fn test_variable_inheritance_in_block() {
+    #[derive(Template)]
+    #[template(
+        source = r#"{% extends "base-decl.txt" %}
+{%- block extended -%}
+--> {{ variable }}
+{% include "included.html" -%}
+{% endblock %}"#,
+        ext = "txt"
+    )]
+    struct Y;
+
+    let rendered = Y.render().unwrap();
+    assert!(rendered.contains("--> 42"));
+    assert!(rendered.contains("INCLUDED: base"));
+}
+
+#[test]
+fn test_empty_partial_include_in_inherited_block() {
+    #[derive(Template)]
+    #[template(
+        source = r#"{% extends "base-decl.txt" %}
+{% block extended %}{% include "use-var.txt" %}{% endblock %}"#,
+        ext = "txt"
+    )]
+    struct EmptyOutputInclude;
+
+    assert!(EmptyOutputInclude.render().is_ok());
+}
