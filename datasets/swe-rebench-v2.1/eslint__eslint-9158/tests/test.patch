 });
+
+describe("no-extra-parens autofix with nested returned IIFE", () => {
+    it("does not block applicable fixes inside a returned nested IIFE", () => {
+        const code = [
+            "(function() {",
+            "    // trailing spaces",
+            "    console.log('quotes');",
+            "",
+            "    // extra parens",
+            "    return (function() {",
+            "        // trailing spaces",
+            "        console.log('quotes');",
+            "    }());",
+            "})();",
+            ""
+        ].join("\n");
+        const linter = new Linter();
+        const result = linter.verifyAndFix(code, {
+            rules: {
+                "wrap-iife": [2, "any"],
+                "no-extra-parens": 2,
+                "no-trailing-spaces": 2,
+                quotes: [2, "double"]
+            }
+        });
+
+        assert.strictEqual(
+            result.output,
+            code.replace(/'quotes'/g, "\"quotes\"")
+        );
+        assert.isFalse(
+            result.messages.some(message => message.ruleId === "no-extra-parens")
+        );
+    });
+});
