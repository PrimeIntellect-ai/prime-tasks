+class test_worker_optimization_option:
+
+    @pytest.fixture
+    def app(self):
+        return Celery(set_as_current=False)
+
+    def parse(self, app, argv):
+        ctx = worker_command.make_context(
+            'worker', list(argv), obj=SimpleNamespace(app=app),
+        )
+        return ctx.params['optimization']
+
+    def test_long_form_is_accepted(self, app):
+        assert self.parse(app, ['--optimization', 'fair']) == 'fair'
+        assert self.parse(app, ['--optimization=fair']) == 'fair'
+
+    def test_short_form_is_accepted(self, app):
+        assert self.parse(app, ['-O', 'fair']) == 'fair'
+
+    def test_default_when_omitted(self, app):
+        assert self.parse(app, []) == 'default'
