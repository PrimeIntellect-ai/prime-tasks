+  })
+
+  fastify.get('/check-user', async function (request, reply) {
+    await request.jwtVerify()
+    return reply.send(request.user)
+  })
+
+  t.test('result of jwtVerify is the decoded payload', async function (t) {
+    t.plan(2)
