+@pytest.mark.parametrize("nan", [-math.nan, SIGNALING_NAN, -SIGNALING_NAN])
+def test_shrinks_to_canonical_nan(nan):
+    shrunk = minimal_from(nan, math.isnan)
+    assert math.isnan(shrunk)
+
+
+def test_all_nan_representations_shrink_to_the_same_value():
+    inputs = [-math.nan, SIGNALING_NAN, -SIGNALING_NAN]
+    inputs.extend(
+        struct.unpack("d", struct.pack("Q", bits))[0]
+        for bits in (0x7FF8000000000002, 0xFFF8000000000001)
+    )
+    shrunk = [minimal_from(nan, math.isnan) for nan in inputs]
+    assert len({float_to_int(nan) for nan in shrunk}) == 1
