diff --git a/stingray/tests/test_crossspectrum.py b/stingray/tests/test_crossspectrum.py
index b12caead..d326142d 100644
--- a/stingray/tests/test_crossspectrum.py
+++ b/stingray/tests/test_crossspectrum.py
@@ -1676,3 +1676,46 @@ class TestDynamicalCrossspectrum(object):
         assert np.array_equal(output.m, [2, 3, 3, 3, 2])
         assert np.array_equal(output.power, [2.0, 2.0, 5.0, 2.0, 1.5])
         assert np.allclose(output.freq, [0.05, 0.15, 0.25, 0.35, 0.45])
+
+
+@pytest.mark.parametrize("channels_overlap", [False, True])
+def test_averaged_crossspectrum_lag_uncertainties_follow_reference_relation(channels_overlap):
+    from stingray.fourier import error_on_averaged_cross_spectrum
+
+    dt = 0.001
+    time = np.arange(0.5 * dt, 10, dt)
+    rng = np.random.RandomState(1234)
+    subject_counts = rng.poisson(10, size=time.size)
+    if channels_overlap:
+        reference_counts = subject_counts + rng.poisson(5, size=time.size)
+    else:
+        reference_counts = rng.poisson(15, size=time.size)
+
+    subject = Lightcurve(time, subject_counts, dt=dt)
+    reference = Lightcurve(time, reference_counts, dt=dt)
+    spectrum = AveragedCrossspectrum(
+        subject, reference, segment_size=0.1, channels_overlap=channels_overlap
+    )
+
+    noise_subject = poisson_level(
+        norm="none", meanrate=spectrum.countrate1, n_ph=spectrum.nphots1
+    )
+    noise_reference = poisson_level(
+        norm="none", meanrate=spectrum.countrate2, n_ph=spectrum.nphots2
+    )
+    expected_phase_error = error_on_averaged_cross_spectrum(
+        spectrum.unnorm_power,
+        spectrum.pds1.unnorm_power,
+        spectrum.pds2.unnorm_power,
+        spectrum.m,
+        noise_subject,
+        noise_reference,
+        common_ref=channels_overlap,
+    )[2]
+
+    phase, phase_error = spectrum.phase_lag()
+    time_lag, time_error = spectrum.time_lag()
+    valid = np.isfinite(expected_phase_error) & np.isfinite(phase_error)
+    assert np.any(valid)
+    assert np.allclose(phase_error[valid], expected_phase_error[valid])
+    assert np.allclose(time_error[valid], phase_error[valid] / (2 * np.pi * spectrum.freq[valid]))
