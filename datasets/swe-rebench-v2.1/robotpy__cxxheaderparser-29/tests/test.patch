+def test_function_typedef():
+    content = """
+      typedef void fn(int);
+      typedef auto fntype(int) -> int;
+      
+      struct X {
+          typedef void fn(int);
+      };
+    """
+    data = parse_string(content, cleandoc=True)
+
+    assert data == ParsedData(
+        namespace=NamespaceScope(
+            classes=[
+                ClassScope(
+                    class_decl=ClassDecl(
+                        typename=PQName(
+                            segments=[NameSpecifier(name="X")], classkey="struct"
+                        )
+                    ),
+                    typedefs=[
+                        Typedef(
+                            type=FunctionType(
+                                return_type=Type(
+                                    typename=PQName(
+                                        segments=[FundamentalSpecifier(name="void")]
+                                    )
+                                ),
+                                parameters=[
+                                    Parameter(
+                                        type=Type(
+                                            typename=PQName(
+                                                segments=[
+                                                    FundamentalSpecifier(name="int")
+                                                ]
+                                            )
+                                        )
+                                    )
+                                ],
+                                vararg=False,
+                                has_trailing_return=False,
+                            ),
+                            name="fn",
+                            access="public",
+                        )
+                    ],
+                )
+            ],
+            typedefs=[
+                Typedef(
+                    type=FunctionType(
+                        return_type=Type(
+                            typename=PQName(
+                                segments=[FundamentalSpecifier(name="void")]
+                            )
+                        ),
+                        parameters=[
+                            Parameter(
+                                type=Type(
+                                    typename=PQName(
+                                        segments=[FundamentalSpecifier(name="int")]
+                                    )
+                                )
+                            )
+                        ],
+                        vararg=False,
+                        has_trailing_return=False,
+                    ),
+                    name="fn",
+                ),
+                Typedef(
+                    type=FunctionType(
+                        return_type=Type(
+                            typename=PQName(segments=[FundamentalSpecifier(name="int")])
+                        ),
+                        parameters=[
+                            Parameter(
+                                type=Type(
+                                    typename=PQName(
+                                        segments=[FundamentalSpecifier(name="int")]
+                                    )
+                                )
+                            )
+                        ],
+                        vararg=False,
+                        has_trailing_return=True,
+                    ),
+                    name="fntype",
+                ),
+            ],
+        )
+    )
+
+
+def test_function_typedef_opencascade():
+    content = """
+      typedef void   Convert_CosAndSinEvalFunction(Standard_Real,
+                                                   const Standard_Integer,
+                                                   const TColgp_Array1OfPnt2d&,
+                                                   const TColStd_Array1OfReal&,
+                                                   const TColStd_Array1OfInteger*,
+                                                   Standard_Real Result[2]) ;
+    """
+    data = parse_string(content, cleandoc=True)
+
+    assert len(data.namespace.typedefs) == 1
+    typedef = data.namespace.typedefs[0]
+    assert typedef.name == "Convert_CosAndSinEvalFunction"
+    assert isinstance(typedef.type, FunctionType)
+
+    fntype = typedef.type
+    assert fntype.return_type == Type(
+        typename=PQName(segments=[FundamentalSpecifier(name="void")])
+    )
+    assert len(fntype.parameters) == 6
+    assert fntype.parameters[0].type == Type(
+        typename=PQName(segments=[NameSpecifier(name="Standard_Real")])
+    )
+    assert fntype.parameters[1].type == Type(
+        typename=PQName(segments=[NameSpecifier(name="Standard_Integer")]), const=True
+    )
+    assert fntype.parameters[2].type == Reference(
+        ref_to=Type(
+            typename=PQName(segments=[NameSpecifier(name="TColgp_Array1OfPnt2d")]),
+            const=True,
+        )
+    )
+    assert fntype.parameters[3].type == Reference(
+        ref_to=Type(
+            typename=PQName(segments=[NameSpecifier(name="TColStd_Array1OfReal")]),
+            const=True,
+        )
+    )
+    assert fntype.parameters[4].type == Pointer(
+        ptr_to=Type(
+            typename=PQName(segments=[NameSpecifier(name="TColStd_Array1OfInteger")]),
+            const=True,
+        )
+    )
+    assert fntype.parameters[5].type == Array(
+        array_of=Type(typename=PQName(segments=[NameSpecifier(name="Standard_Real")])),
+        size=Value(tokens=[Token(value="2")]),
+    )
+    assert fntype.parameters[5].name == "Result"
+
+
+def test_function_typedef_vararg_and_noexcept():
+    data = parse_string(
+        "typedef void variadic_fn(int, ...); "
+        "typedef void noexcept_fn(int) noexcept(true);"
+    )
+
+    variadic_fn, noexcept_fn = data.namespace.typedefs
+    assert isinstance(variadic_fn.type, FunctionType)
+    assert variadic_fn.type.vararg is True
+    assert isinstance(noexcept_fn.type, FunctionType)
+    assert noexcept_fn.type.noexcept == Value(tokens=[Token(value="true")])
