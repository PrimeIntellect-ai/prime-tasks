+
+# Evaluator for the nonlinear constraint x^3 >= 0. Used to check that
+# callback_value reports the current iterate when a nonlinear constraint is
+# present.
+struct _CubicConstraintEvaluator <: MOI.AbstractNLPEvaluator end
+MOI.initialize(::_CubicConstraintEvaluator, ::Vector{Symbol}) = nothing
+MOI.features_available(::_CubicConstraintEvaluator) = [:Grad, :Jac]
+MOI.eval_constraint(::_CubicConstraintEvaluator, g, x) = (g[1] = x[1]^3)
+MOI.jacobian_structure(::_CubicConstraintEvaluator) = Tuple{Int64,Int64}[(1, 1)]
+function MOI.eval_constraint_jacobian(::_CubicConstraintEvaluator, J, x)
+    J[1] = 3 * x[1]^2
+    return
+end
+function test_callback_2()
+    model = Ipopt.Optimizer()
+    MOI.set(model, MOI.RawOptimizerAttribute("print_level"), 0)
+    x = MOI.add_variable(model)
+    MOI.add_constraint(model, x, MOI.GreaterThan(0.0))
+    MOI.add_constraint(model, x, MOI.LessThan(1.0))
+    MOI.set(
+        model,
+        MOI.NLPBlock(),
+        MOI.NLPBlockData(
+            MOI.NLPBoundsPair.([0.0], [Inf]),
+            _CubicConstraintEvaluator(),
+            false,
+        ),
+    )
+    f = MOI.ScalarAffineFunction([MOI.ScalarAffineTerm(1.0, x)], 0.5)
+    MOI.set(model, MOI.ObjectiveSense(), MOI.MIN_SENSE)
+    MOI.set(model, MOI.ObjectiveFunction{typeof(f)}(), f)
+    x_vals = Float64[]
+    function my_callback(
+        alg_mod::Cint,
+        iter_count::Cint,
+        obj_value::Float64,
+        inf_pr::Float64,
+        inf_du::Float64,
+        mu::Float64,
+        d_norm::Float64,
+        regularization_size::Float64,
+        alpha_du::Float64,
+        alpha_pr::Float64,
+        ls_trials::Cint,
+    )
+        push!(x_vals, MOI.get(model, MOI.CallbackVariablePrimal(model), x))
+        @test isapprox(obj_value, 1.0 * x_vals[end] + 0.5, atol = 1e-1)
+        return iter_count < 1
+    end
+    MOI.set(model, Ipopt.CallbackFunction(), my_callback)
+    MOI.optimize!(model)
+    @test MOI.get(model, MOI.TerminationStatus()) == MOI.INTERRUPTED
+    @test length(x_vals) >= 2
+    @test any(value -> value != x_vals[1], x_vals[2:end])
     return
 end
 
