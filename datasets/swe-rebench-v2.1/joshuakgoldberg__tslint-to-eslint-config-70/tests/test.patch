diff --git a/src/rules/formatRawTslintRule.test.ts b/src/rules/formatRawTslintRule.test.ts
new file mode 100644
index 0000000..42b2a7c
--- /dev/null
+++ b/src/rules/formatRawTslintRule.test.ts
@@ -0,0 +1,28 @@
+import { formatConvertedRules } from "../creation/formatConvertedRules";
+import { findTSLintConfiguration, TSLintConfiguration } from "../input/findTSLintConfiguration";
+import { createStubExec } from "../adapters/exec.stubs";
+import { convertRules } from "./convertRules";
+
+describe("rule conversion output", () => {
+    it("handles raw rules without arguments", async () => {
+        // Arrange
+        const rawRules = { "unconverted-rule": {} };
+        const conversionResults = convertRules(
+            {
+                converters: new Map(),
+                mergers: new Map(),
+            },
+            rawRules,
+        );
+        const originalConfiguration = (await findTSLintConfiguration(
+            { exec: createStubExec({ stdout: "{}" }) },
+            undefined,
+        )) as TSLintConfiguration;
+
+        // Act
+        const formatOutput = () => formatConvertedRules(conversionResults, originalConfiguration);
+
+        // Assert
+        expect(formatOutput).not.toThrow();
+    });
+});
