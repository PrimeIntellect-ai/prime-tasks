+func TestLoadBindingTimeoutDefault(t *testing.T) {
+	ctx := context.Background()
+	store, dom := CreateStoreAndBootstrap(t)
+	defer func() { require.NoError(t, store.Close()) }()
+
+	s := CreateSessionAndSetID(t, store)
+	res := MustExecToRecodeSet(t, s, "select @@global.tidb_load_binding_timeout")
+	chk := res.NewChunk(nil)
+	require.NoError(t, res.Next(ctx, chk))
+	require.Equal(t, 1, chk.NumRows())
+	require.Equal(t, int64(200), chk.GetRow(0).GetInt64(0))
+
+	// A zero value is not a usable timeout, so binding loads must fall back to the default (200 ms)
+	// instead of using a zero timeout that makes every load fail immediately.
+	MustExec(t, s, "set global tidb_load_binding_timeout = 0")
+	require.Equal(t, uint64(200), s.GetSessionVars().LoadBindingTimeout)
+
+	dom.Close()
+}
