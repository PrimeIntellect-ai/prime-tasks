+from typing import Any, Type
+
+import httpcore
 import pytest
 
 import httpx
 
 
+@pytest.mark.parametrize("error_type", [httpcore.ConnectError, httpcore.ProtocolError])
+def test_sync_httpcore_errors_are_http_errors(error_type: Type[Exception]) -> None:
+    class ErrorTransport(httpcore.SyncHTTPTransport):
+        def request(self, *args: Any, **kwargs: Any) -> Any:
+            raise error_type()
+
+    with httpx.Client(transport=ErrorTransport()) as client:
+        with pytest.raises(httpx.HTTPError):
+            client.get("http://testserver")
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("error_type", [httpcore.ConnectError, httpcore.ProtocolError])
+async def test_async_httpcore_errors_are_http_errors(
+    error_type: Type[Exception],
+) -> None:
+    class ErrorTransport(httpcore.AsyncHTTPTransport):
+        async def request(self, *args: Any, **kwargs: Any) -> Any:
+            raise error_type()
+
+    async with httpx.AsyncClient(transport=ErrorTransport()) as client:
+        with pytest.raises(httpx.HTTPError):
+            await client.get("http://testserver")
+
+
