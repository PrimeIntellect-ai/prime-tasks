+fn format_message_flows(event: Event, context: Context, flows: &[(&str, &str)]) -> MessageData {
+    let csml_flows: Vec<CsmlFlow> = flows
+        .iter()
+        .map(|(name, content)| CsmlFlow::new("id", name, content, Vec::default()))
+        .collect();
+
+    let bot = CsmlBot::new("id", "bot", None, csml_flows, None, None, "flow", None, None);
+
+    interpret(bot, context, event, None)
+}
+
+#[test]
+fn previous_flow_test() {
+    let flow = r#"
+start:
+    if (!done) {
+        remember done = 1
+        say "flow start"
+        goto flow other
+    }
+    say "back in flow"
+    goto end
+"#;
+    let other = r#"
+start:
+    say "other start"
+    previous flow
+"#;
+    let msg = format_message_flows(
+        Event::new("payload", "", serde_json::json!({})),
+        Context::new(HashMap::new(), HashMap::new(), None, None, "start", "flow"),
+        &[("flow", flow), ("other", other)],
+    );
+
+    let v1: Value = message_to_json_value(msg);
+    let v2: Value = serde_json::from_str(
+        r#"{"memories":[{"key":"done","value":1}],"messages":[
+            {"content":{"text":"flow start"},"content_type":"text"},
+            {"content":{"text":"other start"},"content_type":"text"},
+            {"content":{"text":"back in flow"},"content_type":"text"}
+        ]}"#,
+    )
+    .unwrap();
+
+    assert_eq!(v1, v2)
+}
+
+#[test]
+fn previous_step_test() {
+    let flow = r#"
+start:
+    say "start"
+    goto step2
+
+step2:
+    if (!done) {
+        remember done = 1
+        say "step2"
+        goto flow other
+    }
+    say "back"
+    goto end
+"#;
+    let other = r#"
+start:
+    say "other"
+    previous step
+"#;
+    let msg = format_message_flows(
+        Event::new("payload", "", serde_json::json!({})),
+        Context::new(HashMap::new(), HashMap::new(), None, None, "start", "flow"),
+        &[("flow", flow), ("other", other)],
+    );
+
+    let v1: Value = message_to_json_value(msg);
+    let v2: Value = serde_json::from_str(
+        r#"{"memories":[{"key":"done","value":1}],"messages":[
+            {"content":{"text":"start"},"content_type":"text"},
+            {"content":{"text":"step2"},"content_type":"text"},
+            {"content":{"text":"other"},"content_type":"text"},
+            {"content":{"text":"back"},"content_type":"text"}
+        ]}"#,
+    )
+    .unwrap();
+
     assert_eq!(v1, v2)
 }
