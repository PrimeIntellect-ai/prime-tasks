+it('can send a dice', function () {
+    $request = app(Telegraph::class)->chat(make_chat())->dice()->toArray();
+
+    expect($request['url'])->toContain('/sendDice');
+    expect((string) $request['payload']['chat_id'])->toBe('-123456789');
+    expect(! array_key_exists('emoji', $request['payload']) || $request['payload']['emoji'] === '🎲')->toBeTrue();
+});
+
+it('can send a dice with different emojis', function (string $emoji) {
+    $request = app(Telegraph::class)->chat(make_chat())->dice($emoji)->toArray();
+
+    expect($request['url'])->toContain('/sendDice');
+    expect((string) $request['payload']['chat_id'])->toBe('-123456789');
+    expect($request['payload']['emoji'])->toBe($emoji);
+})->with([
+    'DICE' => '🎲',
+    'ARROW' => '🎯',
+    'BASKETBALL' => '🏀',
+    'FOOTBALL' => '⚽',
+    'BOWLING' => '🎳',
+    'SLOT_MACHINE' => '🎰',
+]);
+
 it('requires a chat to send a document', function () {
     TelegraphFacade::document(Storage::path('test.txt'));
 })->throws(TelegraphException::class, 'No TelegraphChat defined for this request');
