+// https://github.com/pion/rtp/issues/315
+func TestMarshalSizePanic(t *testing.T) {
+	hdr := &Header{
+		Extension: true,
+	}
+
+	size := 0
+	assert.NotPanics(t, func() {
+		size = hdr.MarshalSize()
+	})
+	assert.Equal(t, 16, size)
+}
+
+// https://github.com/pion/rtp/issues/315
+//
+// The public contract only requires MarshalSize() to be panic-free when the
+// extension bit is set but no extension data is present. MarshalTo() is not
+// required to handle that input, so it is only checked when it returns
+// without panicking.
+func TestMarshalToPanic(t *testing.T) {
+	hdr := &Header{
+		Extension: true,
+	}
+
+	size := 0
+	assert.NotPanics(t, func() {
+		size = hdr.MarshalSize()
+	})
+	assert.GreaterOrEqual(t, size, 12)
+
+	buf := make([]byte, size)
+	func() {
+		defer func() {
+			_ = recover()
+		}()
+		n, err := hdr.MarshalTo(buf)
+		if err == nil {
+			assert.Equal(t, size, n)
+		}
+	}()
+}
