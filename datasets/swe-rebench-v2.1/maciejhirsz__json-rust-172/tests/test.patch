@@ -0,0 +1,87 @@
+use std::fs;
+use std::process::Command;
+
+#[test]
+fn generator_is_public_to_downstream_implementations() {
+    let dependencies = std::env::current_exe()
+        .expect("integration test executable path")
+        .parent()
+        .expect("integration test executable directory")
+        .to_path_buf();
+    let json_library = fs::read_dir(&dependencies)
+        .expect("Cargo dependency directory")
+        .filter_map(Result::ok)
+        .map(|entry| entry.path())
+        .find(|path| {
+            path.file_name()
+                .and_then(|name| name.to_str())
+                .map_or(false, |name| name.starts_with("libjson-") && name.ends_with(".rlib"))
+        })
+        .expect("compiled json library");
+
+    let probe_dir = std::env::temp_dir().join(format!(
+        "json-generator-publication-probe-{}",
+        std::process::id()
+    ));
+    fs::create_dir_all(&probe_dir).expect("create temporary probe directory");
+
+    let implementation = r#"
+use TRAIT_PATH as Generator;
+use json::object::Object;
+use std::io::{self, Write};
+
+struct CustomWriter(Vec<u8>);
+
+impl Generator for CustomWriter {
+    type T = Vec<u8>;
+
+    fn get_writer(&mut self) -> &mut Vec<u8> {
+        &mut self.0
+    }
+
+    fn write_min(&mut self, _: &[u8], minimum: u8) -> io::Result<()> {
+        self.0.push(minimum);
+        Ok(())
+    }
+
+    fn write_object(&mut self, _: &Object) -> io::Result<()> {
+        self.write_char(b'{')?;
+        self.write_char(b'}')
+    }
+}
+"#;
+
+    let mut accessible = false;
+    for (index, trait_path) in ["json::codegen::Generator", "json::Generator", "json::generator::Generator"]
+        .iter()
+        .enumerate()
+    {
+        let source = probe_dir.join(format!("probe-{index}.rs"));
+        let output = probe_dir.join(format!("probe-{index}.rlib"));
+        fs::write(&source, implementation.replace("TRAIT_PATH", trait_path))
+            .expect("write downstream implementation probe");
+        let compiled = Command::new("rustc")
+            .arg("--edition=2018")
+            .arg("--crate-type=lib")
+            .arg("--crate-name=custom_generator_probe")
+            .arg("--extern")
+            .arg(format!("json={}", json_library.display()))
+            .arg("-L")
+            .arg(format!("dependency={}", dependencies.display()))
+            .arg(&source)
+            .arg("-o")
+            .arg(&output)
+            .output()
+            .expect("run Rust compiler for downstream implementation probe");
+        if compiled.status.success() {
+            accessible = true;
+            break;
+        }
+    }
+
+    let _ = fs::remove_dir_all(&probe_dir);
+    assert!(
+        accessible,
+        "Generator must be publicly accessible for a downstream implementation"
+    );
+}
