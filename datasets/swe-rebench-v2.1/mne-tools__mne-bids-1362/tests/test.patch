+def test_get_entity_vals_exclude_sidecars(tmp_path):
+    """Exclude sidecars without discarding matching data files."""
+    bids_root = tmp_path
+    meg_dir = bids_root / "sub-01" / "ses-01" / "meg"
+    session_dir = meg_dir.parent
+    meg_dir.mkdir(parents=True)
+    (session_dir / "sub-01_ses-01_scans.tsv").touch()
+    (meg_dir / "sub-01_ses-01_coordsystem.json").touch()
+    (meg_dir / "sub-01_ses-01_task-rest_meg.fif").touch()
+
+    meg_dir_2 = bids_root / "sub-01" / "ses-02" / "meg"
+    meg_dir_2.mkdir(parents=True)
+    (meg_dir_2 / "sub-01_ses-02_task-nback_meg.fif").touch()
+
+    filters = dict(ignore_suffixes=("scans", "coordsystem"))
+    vals = get_entity_vals(
+        root=bids_root,
+        entity_key="session",
+        ignore_tasks=("rest", "nback"),
+        **filters,
+    )
+    assert vals == []
+
+    vals = get_entity_vals(
+        root=bids_root,
+        entity_key="session",
+        ignore_tasks="rest",
+        **filters,
+    )
+    assert vals == ["02"]
+
+    vals = get_entity_vals(root=bids_root, entity_key="session", **filters)
+    assert set(vals) == {"01", "02"}
+
