+import Foundation
+import XCTest
+
+@testable import Benchmark
+
+final class BenchmarkReporterTests: XCTestCase {
+
+    /// Runs `body` while capturing everything written to standard output.
+    private func captureStandardOutput(_ body: () -> Void) -> String {
+        let pipe = Pipe()
+        let savedStdout = dup(STDOUT_FILENO)
+        dup2(pipe.fileHandleForWriting.fileDescriptor, STDOUT_FILENO)
+        body()
+        fflush(stdout)
+        dup2(savedStdout, STDOUT_FILENO)
+        close(savedStdout)
+        pipe.fileHandleForWriting.closeFile()
+        let data = pipe.fileHandleForReading.readDataToEndOfFile()
+        return String(data: data, encoding: .utf8) ?? ""
+    }
+
+    func testTimeColumnIsRightJustified() throws {
+        let results = [
+            BenchmarkResult(
+                benchmarkName: "benchmark_one", suiteName: "", measurements: [1000.0]),
+            BenchmarkResult(
+                benchmarkName: "benchmark_two", suiteName: "", measurements: [1000000.0]),
+        ]
+        let reporter = PlainTextReporter()
+        let output = captureStandardOutput { reporter.report(results: results) }
+
+        let dataLines = output.split(separator: "\n").filter { $0.range(of: " ns") != nil }
+        XCTAssertEqual(
+            dataLines.count, results.count,
+            "expected one output line per result:\n\(output)")
+
+        // Every time value ends with " ns". Right-justifying the time column
+        // aligns the right edge of each value, so " ns" must end at the same
+        // column on every result line.
+        let endColumns = dataLines.map { line -> Int in
+            let range = line.range(of: " ns")!
+            return line.distance(from: line.startIndex, to: range.upperBound)
+        }
+        XCTAssertEqual(
+            Set(endColumns).count, 1,
+            "time values should be right-justified:\n\(output)")
+    }
+
+    static var allTests = [
+        ("testTimeColumnIsRightJustified", testTimeColumnIsRightJustified)
+    ]
+}
