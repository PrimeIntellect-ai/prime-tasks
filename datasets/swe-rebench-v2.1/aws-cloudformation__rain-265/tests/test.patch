index 0000000..0231da3
--- /dev/null
+++ b/cft/pkg/anchor_test.go
@@ -0,0 +1,108 @@
+package pkg
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/aws-cloudformation/rain/cft"
+	"github.com/aws-cloudformation/rain/cft/format"
+	"github.com/aws-cloudformation/rain/cft/parse"
+)
+
+// anchoredTemplate is the example from the problem statement. It uses YAML
+// anchors (&code, &fooval) and aliases (*fooval, *code).
+const anchoredTemplate = `Resources:
+  MyLambda:
+    Type: AWS::Lambda::Function
+    Properties:
+      Code: &code
+        ZipFile: "print(\"Hello World!\")\n"
+      FunctionName: my-lambda
+      Handler: index.lambda_handler
+      Role: !ImportValue 'MyLambdaRoleArn'
+      Runtime: python3.8
+      Tags:
+        - Key: foo
+          Value: &fooval myval
+        - Key: bar
+          Value: *fooval
+    Metadata:
+      Comment: *code
+`
+
+func TestAnchors(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "anchors.yaml")
+	if err := os.WriteFile(path, []byte(anchoredTemplate), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	packaged, err := File(path)
+	if err != nil {
+		t.Fatalf("unable to package anchored template: %v", err)
+	}
+
+	assertExpandedAliases(t, packaged)
+}
+
+func TestTemplateAnchors(t *testing.T) {
+	parsed, err := parse.String(anchoredTemplate)
+	if err != nil {
+		t.Fatalf("unable to parse anchored template: %v", err)
+	}
+
+	packaged, err := Template(parsed, t.TempDir())
+	if err != nil {
+		t.Fatalf("unable to package anchored template directly: %v", err)
+	}
+	assertExpandedAliases(t, packaged)
+}
+
+func assertExpandedAliases(t *testing.T, packaged cft.Template) {
+	// Converting the packaged template to JSON must not fail with
+	// "yaml: unknown anchor ... referenced".
+	out := format.String(packaged, format.Options{JSON: true})
+
+	var doc map[string]interface{}
+	if err := json.Unmarshal([]byte(out), &doc); err != nil {
+		t.Fatalf("fmt -j output is not valid JSON: %v\n%s", err, out)
+	}
+
+	myLambda := lookup(t, doc, "Resources", "MyLambda")
+	props := lookup(t, myLambda, "Properties")
+
+	// The alias *fooval must be resolved to the anchor value "myval".
+	tags, ok := lookup(t, props, "Tags").([]interface{})
+	if !ok || len(tags) != 2 {
+		t.Fatalf("expected 2 Tags entries, got %v", lookup(t, props, "Tags"))
+	}
+	for i, tag := range tags {
+		if got := lookup(t, tag, "Value"); got != "myval" {
+			t.Errorf("Tags[%d].Value = %v, want myval", i, got)
+		}
+	}
+
+	// The alias *code must be resolved to the anchor value.
+	code := lookup(t, lookup(t, props, "Code"), "ZipFile")
+	comment := lookup(t, lookup(t, myLambda, "Metadata"), "Comment")
+	if got := lookup(t, comment, "ZipFile"); got != code {
+		t.Errorf("Metadata.Comment.ZipFile = %v, want %v", got, code)
+	}
+}
+
+func lookup(t *testing.T, v interface{}, keys ...string) interface{} {
+	t.Helper()
+	cur := v
+	for _, k := range keys {
+		m, ok := cur.(map[string]interface{})
+		if !ok {
+			t.Fatalf("expected an object while looking up %q, got %T", k, cur)
+		}
+		cur, ok = m[k]
+		if !ok {
+			t.Fatalf("missing key %q", k)
+		}
+	}
+	return cur
+}
