     func testOptional() throws {
+        // Optional.none
         XCTAssertEqual(try Node(Int?.none), "null")
+
+        // Optional.some(.none)
+        XCTAssertEqual(try Node(Int??.some(nil)), "null")
+
+        // Keyed null - https://github.com/jpsim/Yams/issues/232
+        let keyedNullString = "A: null\n"
+        let keyedNullObject = try XCTUnwrap(Yams.load(yaml: keyedNullString))
+        // Dumping a value containing a keyed null must succeed rather than throw.
+        let keyedNullDump = try Yams.dump(object: keyedNullObject)
+        // The dumped YAML must represent the same value, preserving the null entry.
+        let reloaded = try Yams.load(yaml: keyedNullDump)
+        XCTAssertEqual(reloaded as? NSDictionary, keyedNullObject as? NSDictionary)
     }
 
