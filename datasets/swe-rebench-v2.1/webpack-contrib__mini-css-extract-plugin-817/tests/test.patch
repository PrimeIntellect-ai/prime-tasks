+import assert from "assert";
+import { SourceMapConsumer } from "source-map";
+import Self from "../../../src";
+
+class SourceMapAssertionsPlugin {
+  apply(compiler) {
+    compiler.hooks.thisCompilation.tap(
+      "SourceMapAssertionsPlugin",
+      (compilation) => {
+        compilation.hooks.processAssets.tap(
+          {
+            name: "SourceMapAssertionsPlugin",
+            stage: 10000,
+          },
+          (assets) => {
+            const cssAsset = assets["main.css"];
+            assert(cssAsset, "the combined CSS asset should be emitted");
+
+            const css = cssAsset.source().toString();
+            const mapReference = css.match(/sourceMappingURL=([^\s*]+)/);
+            assert(
+              mapReference,
+              "the CSS asset should reference its source map"
+            );
+            const mapName = mapReference[1].split(/[?#]/)[0].split("/").pop();
+            const mapAsset = assets[mapName];
+            assert(mapAsset, "the referenced source map should be emitted");
+
+            const consumer = new SourceMapConsumer(
+              JSON.parse(mapAsset.source().toString())
+            );
+
+            const mappedSources = new Set();
+
+            for (const color of ["red", "blue", "yellow"]) {
+              const rule = new RegExp(`background: ${color};`, "g");
+              const match = rule.exec(css);
+              assert(
+                match,
+                `the combined CSS should include the ${color} rule`
+              );
+
+              const prefix = css.slice(0, match.index);
+              const line = prefix.split("\n").length;
+              const column = match.index - prefix.lastIndexOf("\n") - 1;
+              const original = consumer.originalPositionFor({ line, column });
+
+              assert.strictEqual(
+                original.line,
+                2,
+                `the ${color} rule should map to its original CSS line`
+              );
+              assert(original.source, `the ${color} rule should have a source`);
+              const originalContent = consumer.sourceContentFor(
+                original.source,
+                true
+              );
+              if (originalContent !== null) {
+                assert(
+                  originalContent.includes(`background: ${color};`),
+                  `the ${color} rule should map to its matching source`
+                );
+              }
+              mappedSources.add(original.source);
+            }
+
+            assert.strictEqual(
+              mappedSources.size,
+              3,
+              "the combined rules should map to three original sources"
+            );
+            if (typeof consumer.destroy === "function") consumer.destroy();
+          }
+        );
+      }
+    );
+  }
+}
+
+module.exports = {
+  entry: "./index.js",
+  devtool: "source-map",
+  output: {
+    pathinfo: true,
+  },
+  module: {
+    rules: [
+      {
+        test: /\.css$/,
+        use: [Self.loader, "css-loader"],
+      },
+    ],
+  },
+  plugins: [
+    new Self({
+      filename: "[name].css",
+    }),
+    new SourceMapAssertionsPlugin(),
+  ],
+};
