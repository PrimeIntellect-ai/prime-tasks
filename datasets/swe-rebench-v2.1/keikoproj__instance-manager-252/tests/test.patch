+func TestUpgradeLeavesOtherScalingGroupsResourcesAlone(t *testing.T) {
+	g := gomega.NewGomegaWithT(t)
+	k := MockKubernetesClientSet()
+	ig := MockInstanceGroup()
+	cr := MockCustomResourceSpec()
+	crd := MockCustomResourceDefinition()
+	asgMock := NewAutoScalingMocker()
+	iamMock := NewIamMocker()
+	eksMock := NewEksMocker()
+	ec2Mock := NewEc2Mocker()
+
+	w := MockAwsWorker(asgMock, iamMock, eksMock, ec2Mock)
+	ctx := MockContext(ig, k, w)
+	crYAML, err := yaml.Marshal(cr.Object)
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+
+	strategy := MockAwsCRDStrategy(string(crYAML))
+	strategy.CRDType.SetConcurrencyPolicy(v1alpha1.ReplaceConcurrencyPolicy)
+	ig.SetUpgradeStrategy(strategy)
+	ig.SetState(v1alpha1.ReconcileModifying)
+	ig.Status.SetActiveScalingGroupName("current-asg")
+
+	crdGVR := kubeprovider.GetGVR(crd, "customresourcedefinitions")
+	crGVR := kubeprovider.GetGVR(cr, "dogs")
+	_, err = k.KubeDynamic.Resource(crdGVR).Create(context.Background(), crd, metav1.CreateOptions{})
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+
+	otherGroupResource := MockCustomResourceSpec()
+	otherGroupResource.SetName("captain-other-launch")
+	kubeprovider.AddAnnotation(otherGroupResource, kubeprovider.OwnershipAnnotationKey, kubeprovider.OwnershipAnnotationValue)
+	kubeprovider.AddAnnotation(otherGroupResource, kubeprovider.ScopeAnnotationKey, "another-asg")
+	_, err = k.KubeDynamic.Resource(crGVR).Namespace("default").Create(context.Background(), otherGroupResource, metav1.CreateOptions{})
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+
+	completedResource := MockCustomResourceSpec()
+	completedResource.SetName("captain-completed-launch")
+	completedResource.Object["status"] = map[string]interface{}{"dogStatus": "woof"}
+	kubeprovider.AddAnnotation(completedResource, kubeprovider.OwnershipAnnotationKey, kubeprovider.OwnershipAnnotationValue)
+	kubeprovider.AddAnnotation(completedResource, kubeprovider.ScopeAnnotationKey, "current-asg")
+	_, err = k.KubeDynamic.Resource(crGVR).Namespace("default").Create(context.Background(), completedResource, metav1.CreateOptions{})
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+
+	scalingGroup := &autoscaling.Group{
+		AutoScalingGroupName:    aws.String("current-asg"),
+		LaunchConfigurationName: aws.String("my-lc-0123"),
+	}
+	ctx.SetDiscoveredState(&DiscoveredState{
+		Publisher:    kubeprovider.EventPublisher{Client: k.Kubernetes},
+		ScalingGroup: scalingGroup,
+		ScalingConfiguration: &scaling.LaunchConfiguration{
+			TargetResource: &autoscaling.LaunchConfiguration{LaunchConfigurationName: aws.String("my-lc-0123")},
+		},
+	})
+
+	_ = ctx.UpgradeNodes()
+	otherResource, err := k.KubeDynamic.Resource(crGVR).Namespace("default").Get(context.Background(), "captain-other-launch", metav1.GetOptions{})
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+	g.Expect(otherResource.GetAnnotations()[kubeprovider.ScopeAnnotationKey]).To(gomega.Equal("another-asg"))
+	resourceName := ig.GetStatus().GetStrategyResourceName()
+	g.Expect(resourceName).NotTo(gomega.BeEmpty())
+	g.Expect(resourceName).NotTo(gomega.Equal("captain-other-launch"))
+	g.Expect(resourceName).NotTo(gomega.Equal("captain-completed-launch"))
+	selectedResource, err := k.KubeDynamic.Resource(crGVR).Namespace("default").Get(context.Background(), resourceName, metav1.GetOptions{})
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+	g.Expect(selectedResource.GetAnnotations()[kubeprovider.ScopeAnnotationKey]).To(gomega.Equal("current-asg"))
+	selectedStatus, _, _ := unstructured.NestedString(selectedResource.Object, "status", "dogStatus")
+	g.Expect(selectedStatus).NotTo(gomega.Equal("woof"))
+}
