+try:
+    from scuba.utils import shlex_split
+except ImportError:
+    from scuba.config import shlex_split
 import scuba.config
 
+def script_commands(script):
+    """Return command arguments without depending on their serialized form."""
+    commands = []
+    for command in script:
+        if isinstance(command, (list, tuple)):
+            commands.append(list(command))
+        else:
+            commands.append(shlex_split(command))
+    return commands
+
