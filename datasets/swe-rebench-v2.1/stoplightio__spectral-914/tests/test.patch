 import { JSONSchema4, JSONSchema6 } from 'json-schema';
+import { RuleType, Spectral } from '../../spectral';
+import * as oasRuleset from '../../rulesets/oas/index.json';
 import { schema } from '../schema';
 
+function createOasExampleSpectral(ruleName: 'oas3-valid-schema-example' | 'oas3-valid-content-schema-example') {
+  const spectral = new Spectral();
+  spectral.registerFormat('oas3', () => true);
+  const rule = oasRuleset.rules[ruleName]!;
+  spectral.setRules({
+    [ruleName]: Object.assign(rule, { type: RuleType[rule.type] }),
+  });
+  return spectral;
+}
+
 function runSchema(target: any, schemaObj: object) {
   return schema(target, { schema: schemaObj }, { given: [] }, { given: null, original: null } as any);
