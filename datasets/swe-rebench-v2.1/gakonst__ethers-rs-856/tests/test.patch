+#[test]
+fn can_derive_ethcall_for_bytes() {
+    #[derive(Clone, Debug, Default, Eq, PartialEq, EthCall, EthDisplay)]
+    #[ethcall(name = "batch", abi = "batch(bytes[],bool)")]
+    pub struct BatchCall {
+        pub calls: Vec<Bytes>,
+        pub revert_on_fail: bool,
+    }
+
+    assert_ethcall::<BatchCall>();
+}
+
+#[test]
+fn bytes_abi_codec_roundtrip() {
+    let bytes: Bytes = vec![0xde, 0xad, 0xbe, 0xef].into();
+    let encoded = bytes.clone().encode();
+    let decoded = <Bytes as AbiDecode>::decode(encoded).unwrap();
+    assert_eq!(bytes, decoded);
+}
