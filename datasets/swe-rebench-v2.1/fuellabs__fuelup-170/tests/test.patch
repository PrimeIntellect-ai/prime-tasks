+#[test]
+fn fuelup_toolchain_install_nightly_date() -> Result<()> {
+    testcfg::setup(FuelupState::Empty, &|cfg| {
+        let toolchain = "nightly-2022-08-31";
+        let output = cfg.fuelup(&["toolchain", "install", toolchain]);
+        let response = format!("{}{}", output.stdout, output.stderr);
+        assert!(
+            !response.contains("You may not specify a date or target"),
+            "dated nightly was rejected: {response}"
+        );
+
+        let installed_name = format!("{toolchain}-{}", TargetTriple::from_host().unwrap());
+        let bin_dir = cfg.toolchain_bin_dir(&installed_name);
+        if bin_dir.is_dir() {
+            expect_files_exist(&bin_dir, ALL_BINS);
+        }
+    })?;
+    Ok(())
+}
