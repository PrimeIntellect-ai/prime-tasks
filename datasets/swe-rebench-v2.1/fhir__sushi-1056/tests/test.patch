+    it('should constrain an element to Reference type with the Reference() keyword when both Reference and CodeableReference is allowed', () => {
+      // R5 Extension allows both Reference and CodeableReference types
+      const r5Extension = fisher.fishForStructureDefinition('Extension');
+      const valueX = r5Extension.elements.find(e => e.id === 'Extension.value[x]');
+      // * value[x] only Reference(Resource)
+      const onlyRule = new OnlyRule('value[x]');
+      onlyRule.types = [{ type: 'Resource', isReference: true }];
+      valueX.constrainType(onlyRule, fisher);
+      expect(valueX.type).toHaveLength(1);
+      expect(valueX.type[0]).toEqual(
+        new ElementDefinitionType('Reference').withTargetProfiles(
+          'http://hl7.org/fhir/StructureDefinition/Resource'
+        )
+      );
+    });
+
+    it('should produce a Reference type in the differential when an extension allowing both Reference and CodeableReference is constrained to Reference(Resource)', () => {
+      // Reproduces the scenario where an extension's value[x] allows both Reference and
+      // CodeableReference (as in R4B Snapshot1 and R5) and is constrained to Reference(Resource).
+      const doc = new FSHDocument('fileName');
+      const input = new FSHTank([doc], minimalConfig);
+      const pkg = new Package(input.config);
+      const testFisher = new TestFisher(
+        input,
+        defs,
+        pkg,
+        'hl7.fhir.r5.core#current',
+        'r5-definitions'
+      );
+      const exporter = new StructureDefinitionExporter(input, pkg, testFisher);
+
+      const extension = new Extension('MyExtension');
+      const onlyRule = new OnlyRule('value[x]');
+      onlyRule.types = [{ type: 'Resource', isReference: true }];
+      extension.rules.push(onlyRule);
+      doc.extensions.set(extension.name, extension);
+
+      exporter.exportStructDef(extension);
+      const sd = pkg.extensions[0];
+
+      const valueX = sd.findElement('Extension.value[x]');
+      expect(valueX.type).toHaveLength(1);
+      expect(valueX.type[0]).toEqual(
+        new ElementDefinitionType('Reference').withTargetProfiles(
+          'http://hl7.org/fhir/StructureDefinition/Resource'
+        )
+      );
+
+      const diffValueX = sd
+        .toJSON()
+        .differential.element.find((e: any) => e.id === 'Extension.value[x]');
+      expect(diffValueX.type).toEqual([
+        {
+          code: 'Reference',
+          targetProfile: ['http://hl7.org/fhir/StructureDefinition/Resource']
+        }
+      ]);
+    });
+
