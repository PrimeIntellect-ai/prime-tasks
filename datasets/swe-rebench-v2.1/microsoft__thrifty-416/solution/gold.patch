+    private fun findClosestIncludeRoot(path: Path): Path? {
+        var minNameCountRoot: Path? = null
+        var minNameCount = Int.MAX_VALUE
+        for (root in includePaths) {
+            val relative = try {
+                root.relativize(path)
+            } catch (e: IllegalArgumentException) {
+                continue
+            }
