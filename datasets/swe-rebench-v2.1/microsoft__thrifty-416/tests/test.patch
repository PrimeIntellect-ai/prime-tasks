+    @Test
+    fun locationPathIsRelativeToWorkingDirectory() {
+        val workingDir = File(System.getProperty("user.dir"))
+        val subDir = Files.createTempDirectory(workingDir.toPath(), "location-path-test").toFile()
+        try {
+            val f = File(subDir, "wd.thrift")
+            f.writeText("""
+                namespace java com.microsoft.thrifty.test.wd
+
+                enum WD {
+                  A, B
+                }
+            """)
+
+            val loader = Loader()
+            loader.addIncludePath(workingDir.toPath())
+            loader.addThriftFile(f.toPath())
+
+            val schema = loader.load()
+
+            val path = java.io.File(schema.enums.single().location.path).toPath().normalize()
+            path.isAbsolute shouldBe false
+            (path.nameCount > 1) shouldBe true
+            path.fileName.toString() shouldBe "wd.thrift"
+            path.parent.fileName.toString().startsWith("location-path-test") shouldBe true
+        } finally {
+            subDir.deleteRecursively()
+        }
+    }
+
