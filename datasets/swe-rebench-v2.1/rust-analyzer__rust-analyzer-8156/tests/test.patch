 }
+
+#[test]
+fn omitted_default_trait_argument_infers_associated_output() {
+    check_types(
+        r#"
+struct A;
+
+trait Op<RHS=Self> {
+    type Output;
+
+    fn do_op(self, rhs: RHS) -> Self::Output;
+}
+
+impl Op for A {
+    type Output = bool;
+
+    fn do_op(self, rhs: Self) -> Self::Output {
+        true
+    }
+}
+
+fn test() {
+    let x = A;
+    let y = A;
+    let r = x.do_op(y);
+    r;
+} //^ bool
+        "#,
+    );
+}
+
+#[test]
+fn infer_non_self_default_trait_type_parameter() {
+    check_types(
+        r#"
+struct A;
+struct Wrapper<T>(T);
+
+trait Op<RHS=Wrapper<Self>> {
+    type Output;
+
+    fn do_op(self, rhs: RHS) -> Self::Output;
+}
+
+impl Op for A {
+    type Output = bool;
+
+    fn do_op(self, rhs: Wrapper<A>) -> Self::Output {
+        true
+    }
+}
+
+impl Op<A> for A {
+    type Output = char;
+
+    fn do_op(self, rhs: A) -> Self::Output {
+        'a'
+    }
+}
+
+fn test() {
+    let x = A;
+    let r = x.do_op(Wrapper(A));
+    r;
+} //^ bool
+        "#,
+    );
+}
