diff --git a/tests/test_struct.rs b/tests/test_struct.rs
index 41e3b3d..6dde8e7 100644
--- a/tests/test_struct.rs
+++ b/tests/test_struct.rs
@@ -204,3 +204,23 @@ fn test_big_endian() {
     let new_bytes = a.to_bytes().unwrap();
     assert_eq!(&bytes[..2], &*new_bytes);
 }
+
+#[test]
+fn test_unit_struct_with_magic_writes_magic() {
+    #[derive(DekuWrite)]
+    #[deku(magic = b"\xf0")]
+    struct Unit;
+
+    let bytes = [0xf0];
+    let serialized = Unit.to_bytes().unwrap();
+    assert_eq!(bytes, &*serialized);
+}
+
+#[test]
+fn test_unit_struct_without_magic_writes_no_bytes() {
+    #[derive(DekuWrite)]
+    struct Unit;
+
+    let serialized = Unit.to_bytes().unwrap();
+    assert!(serialized.is_empty());
+}
