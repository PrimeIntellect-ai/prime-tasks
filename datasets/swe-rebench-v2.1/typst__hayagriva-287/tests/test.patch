+/// Compare stipulated formatting wrappers without prescribing their nesting order.
+fn normalize_formatting_wrappers(input: &str) -> String {
+    // The conjunction is not a name part; accept either its own wrapper or plain text.
+    let input =
+        input.replace("<span style=\"font-variant:small-caps;\"> and </span>", " and ");
+    let input = input.as_str();
+    let mut normalized = String::new();
+    let mut wrappers: Vec<(String, String, String)> = Vec::new();
+    let mut rest = input;
+
+    while let Some(tag_start) = rest.find('<') {
+        let (text, tagged) = rest.split_at(tag_start);
+        if !text.is_empty() {
+            let mut ordered = wrappers.clone();
+            ordered.sort_by(|a, b| a.0.cmp(&b.0));
+            for (_, open, _) in &ordered {
+                normalized.push_str(open);
+            }
+            normalized.push_str(text);
+            for (_, _, close) in ordered.iter().rev() {
+                normalized.push_str(close);
+            }
+        }
+
+        let Some(tag_end) = tagged.find('>') else {
+            normalized.push_str(tagged);
+            rest = "";
+            break;
+        };
+        let (tag, remainder) = tagged.split_at(tag_end + 1);
+        let wrapper = match tag {
+            "<b>" => Some(("b", "<b>", "</b>")),
+            "<i>" => Some(("i", "<i>", "</i>")),
+            "<u>" => Some(("u", "<u>", "</u>")),
+            "<sup>" => Some(("sup", "<sup>", "</sup>")),
+            _ if tag.starts_with("<span ")
+                && tag.contains("font-variant:small-caps;") =>
+            {
+                Some(("small-caps", tag, "</span>"))
+            }
+            _ => None,
+        };
+        if let Some((key, open, close)) = wrapper {
+            wrappers.push((key.to_string(), open.to_string(), close.to_string()));
+        } else if matches!(tag, "</b>" | "</i>" | "</u>" | "</sup>" | "</span>") {
+            let key = match tag {
+                "</b>" => "b",
+                "</i>" => "i",
+                "</u>" => "u",
+                "</sup>" => "sup",
+                "</span>" => "small-caps",
+                _ => unreachable!(),
+            };
+            if let Some(index) =
+                wrappers.iter().rposition(|(wrapper, _, _)| wrapper == key)
+            {
+                wrappers.remove(index);
+            } else {
+                normalized.push_str(tag);
+            }
+        } else {
+            normalized.push_str(tag);
+        }
+        rest = remainder;
+    }
+
+    if !rest.is_empty() {
+        let mut ordered = wrappers;
+        ordered.sort_by(|a, b| a.0.cmp(&b.0));
+        for (_, open, _) in &ordered {
+            normalized.push_str(open);
+        }
+        normalized.push_str(rest);
+        for (_, _, close) in ordered.iter().rev() {
+            normalized.push_str(close);
+        }
+    }
+    normalized
+}
