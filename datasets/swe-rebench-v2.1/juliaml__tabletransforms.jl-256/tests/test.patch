--- /dev/null
+++ b/test/transforms/unitify.jl
@@ -0,0 +1,21 @@
+@testset "Unitify" begin
+  anm = Symbol("a [m]")
+  bnm = :b
+  cnm = Symbol("c [km/hr]")
+  dnm = :d
+  enm = Symbol("e [°C]")
+  a = rand(10)
+  b = rand(10)
+  c = rand(10)
+  d = rand(10)
+  e = rand(10)
+  t = Table(; anm => a, bnm => b, cnm => c, dnm => d, enm => e)
+
+  n, _ = apply(Unitify(), t)
+  @test Set(Tables.schema(n).names) == Set((:a, :b, :c, :d, :e))
+  @test n.a == a .* u"m"
+  @test n.b == b
+  @test n.c == c .* u"km/hr"
+  @test n.d == d
+  @test n.e == e .* u"°C"
+end
