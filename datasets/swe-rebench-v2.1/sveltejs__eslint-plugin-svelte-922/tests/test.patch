+import assert from 'assert';
+import plugin from '../../../src/index.js';
+import { ESLint } from '../../utils/eslint-compat.js';
+import * as svelteParser from 'svelte-eslint-parser';
+
+describe('no-useless-children-snippet', () => {
+	it('is available through the plugin and reports only unnecessary children snippets', async () => {
+		assert.ok(plugin.rules['no-useless-children-snippet']);
+
+		const linter = new ESLint({
+			overrideConfigFile: true,
+			overrideConfig: {
+				files: ['**/*.svelte'],
+				languageOptions: { parser: svelteParser },
+				plugins: { svelte: plugin },
+				rules: { 'svelte/no-useless-children-snippet': 'error' }
+			} as never
+		});
+		const input = [
+			'<Foo>\n  {#snippet children()}\n    Hello\n  {/snippet}\n</Foo>',
+			'<Foo>\n  {#snippet bar()}\n    Hello\n  {/snippet}\n</Foo>',
+			'<Foo>\n  {#snippet children(value)}\n    Hello {value}\n  {/snippet}\n</Foo>',
+			'<Foo>\n  Hello\n</Foo>',
+			'{#snippet children()}\n  Hello\n{/snippet}\n\n{@render children()}'
+		].join('\n');
+		const result = await linter.lintText(input, { filePath: 'component.svelte' });
+
+		assert.deepStrictEqual(
+			result[0].messages.map(({ ruleId, message, line, column }) => ({
+				ruleId,
+				message,
+				line,
+				column
+			})),
+			[
+				{
+					ruleId: 'svelte/no-useless-children-snippet',
+					message: 'Found an unnecessary children snippet.',
+					line: 2,
+					column: 3
+				}
+			]
+		);
+	});
+});
