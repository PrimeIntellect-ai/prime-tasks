+const SEVEN_DAYS_IN_HOURS = 7 * 24;
+
+/**
+ * Converts a Renovate-style duration such as "7 days" or "1 week" into hours.
+ */
+const durationInHours = (duration: string): number | undefined => {
+	const match = /^(\d+)\s*(hours?|h|days?|d|weeks?|w)$/i.exec(duration.trim());
+
+	if (!match) {
+		return undefined;
+	}
+
+	const amount = Number(match[1]);
+	const unit = match[2].toLowerCase();
+
+	if (unit.startsWith("h")) {
+		return amount;
+	}
+
+	if (unit.startsWith("d")) {
+		return amount * 24;
+	}
+
+	return amount * 24 * 7;
+};
+
