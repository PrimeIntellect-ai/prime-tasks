+func TestValueStringBigDouble(t *testing.T) {
+	// A large integral double must still be displayed with a decimal point.
+	v := document.NewDoubleValue(1e21)
+	s := v.String()
+	require.Contains(t, s, ".")
+
+	f, err := strconv.ParseFloat(s, 64)
+	require.NoError(t, err)
+	require.Equal(t, 1e21, f)
