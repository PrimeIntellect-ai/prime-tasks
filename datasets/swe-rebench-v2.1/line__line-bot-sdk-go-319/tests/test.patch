+func TestValidateRichMenuObjectRequestAndResponse(t *testing.T) {
+	type want struct {
+		Response  *BasicResponse
+		Error     error
+		WantError bool
+	}
+	testCases := []struct {
+		Request      RichMenu
+		Response     []byte
+		ResponseCode int
+		Want         want
+	}{
+		{
+			Request: RichMenu{
+				Size:        RichMenuSize{Width: 2500, Height: 1686},
+				Selected:    false,
+				Name:        "Menu1",
+				ChatBarText: "ChatText",
+				Areas: []AreaDetail{
+					{
+						Bounds: RichMenuBounds{X: 0, Y: 0, Width: 2500, Height: 1686},
+						Action: RichMenuAction{Type: RichMenuActionTypePostback, Data: "action=buy&itemid=123", DisplayText: "Buy", Label: "Buy"},
+					},
+				},
+			},
+			ResponseCode: 200,
+			Response:     []byte(`{}`),
+			Want: want{
+				Response: &BasicResponse{},
+			},
+		},
+		{
+			Request: RichMenu{
+				Size:        RichMenuSize{Width: 2500, Height: 1686},
+				Selected:    false,
+				Name:        "Menu1",
+				ChatBarText: "ChatText",
+				Areas: []AreaDetail{
+					{
+						Bounds: RichMenuBounds{X: 0, Y: 0, Width: 2500, Height: 1686},
+						Action: RichMenuAction{Type: RichMenuActionTypePostback, Data: "action=buy&itemid=123", DisplayText: "Buy", Label: "Buy"},
+					},
+				},
+			},
+			ResponseCode: 400,
+			Response:     []byte(`{"message":"Bad Request"}`),
+			Want: want{
+				WantError: true,
+			},
+		},
+	}
+
+	var currentTestIdx int
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer r.Body.Close()
+		tc := testCases[currentTestIdx]
+		if r.Method != http.MethodPost {
+			t.Errorf("Method %s; want %s", r.Method, http.MethodPost)
+		}
+		if r.URL.Path != "/v2/bot/richmenu/validate" {
+			t.Errorf("URLPath %s; want %s", r.URL.Path, "/v2/bot/richmenu/validate")
+		}
+		body, err := ioutil.ReadAll(r.Body)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var submitted RichMenu
+		if err := json.Unmarshal(body, &submitted); err != nil {
+			t.Errorf("Request body is not valid RichMenu JSON: %v", err)
+		} else if !reflect.DeepEqual(submitted, tc.Request) {
+			t.Errorf("Submitted rich menu %#v; want %#v", submitted, tc.Request)
+		}
+		w.WriteHeader(tc.ResponseCode)
+		w.Write(tc.Response)
+	}))
+	defer server.Close()
+
+	dataServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer r.Body.Close()
+		t.Error("Unexpected data API call")
+		w.WriteHeader(404)
+		w.Write([]byte(`{"message":"Not found"}`))
+	}))
+	defer dataServer.Close()
+
+	client, err := mockClient(server, dataServer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i, tc := range testCases {
+		currentTestIdx = i
+		t.Run(strconv.Itoa(i), func(t *testing.T) {
+			res, err := client.ValidateRichMenuObject(tc.Request).Do()
+			if tc.Want.Error != nil {
+				if !reflect.DeepEqual(err, tc.Want.Error) {
+					t.Errorf("Error %v; want %v", err, tc.Want.Error)
+				}
+			} else if tc.Want.WantError {
+				if err == nil {
+					t.Error("expected an error, got nil")
+				}
+			} else {
+				if err != nil {
+					t.Error(err)
+				}
+			}
+			if tc.Want.Response != nil {
+				if !reflect.DeepEqual(res, tc.Want.Response) {
+					t.Errorf("Response %v; want %v", res, tc.Want.Response)
+				}
+			}
+		})
+	}
+}
