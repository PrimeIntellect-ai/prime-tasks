+func TestImportAliasNaming_CustomConfigWithMultipleRules(t *testing.T) {
+	const source = `package fixture
+import (
+alpha "pkg/alpha"
+alpha9 "pkg/alpha9"
+bar_foo "pkg/underscore"
+fooBAR "pkg/mixed"
+v1 "pkg/version"
+v1alpha1 "pkg/prerelease"
+)
+`
+
+	config := lint.Config{Rules: map[string]lint.RuleConfig{
+		"import-alias-naming": {Arguments: []any{
+			map[string]any{
+				"allowRegex": `^[a-z][a-z0-9]*$`,
+				"denyRegex":  `^((v\d+)|(v\d+alpha\d+))$`,
+			},
+		}},
+	}}
+	linter := lint.New(func(string) ([]byte, error) { return []byte(source), nil }, 0)
+	problems, err := linter.Lint([][]string{{"fixture.go"}}, []lint.Rule{&rule.ImportAliasNamingRule{}}, config)
+	if err != nil {
+		t.Fatalf("lint failed: %v", err)
+	}
+
+	got := map[int]bool{}
+	for problem := range problems {
+		got[problem.Position.Start.Line] = true
+	}
+	for line, wantViolation := range map[int]bool{
+		3: false, // lowercase alias
+		4: false, // lowercase alias with digits
+		5: true,  // fails the allow constraint
+		6: true,  // fails the allow constraint
+		7: true,  // matches the deny constraint
+		8: true,  // matches the deny constraint
+	} {
+		if got[line] != wantViolation {
+			t.Errorf("source line %d violation = %t, want %t", line, got[line], wantViolation)
+		}
+	}
+}
+
+func TestImportAliasNaming_OmittedConstraintIsNotApplied(t *testing.T) {
+	tests := []struct {
+		name      string
+		source    string
+		arguments []any
+	}{
+		{
+			name:   "no implicit deny constraint",
+			source: "package fixture\nimport v1 \"pkg/version\"\nimport v1alpha1 \"pkg/prerelease\"\n",
+			arguments: []any{map[string]any{
+				"allowRegex": `^[a-z][a-z0-9]*$`,
+			}},
+		},
+		{
+			name:   "no implicit allow constraint",
+			source: "package fixture\nimport BadName \"pkg/name\"\n",
+			arguments: []any{map[string]any{
+				"denyRegex": `^blocked$`,
+			}},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			config := lint.Config{Rules: map[string]lint.RuleConfig{
+				"import-alias-naming": {Arguments: tt.arguments},
+			}}
+			linter := lint.New(func(string) ([]byte, error) { return []byte(tt.source), nil }, 0)
+			problems, err := linter.Lint([][]string{{"fixture.go"}}, []lint.Rule{&rule.ImportAliasNamingRule{}}, config)
+			if err != nil {
+				t.Fatalf("lint failed: %v", err)
+			}
+			for problem := range problems {
+				t.Errorf("unexpected import alias violation at line %d: %s", problem.Position.Start.Line, problem.Failure)
+			}
+		})
+	}
+}
