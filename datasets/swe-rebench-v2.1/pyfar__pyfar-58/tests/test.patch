+import numpy as np
+import numpy.testing as npt
+
+import pyfar
+
+
+def test_signal_copy_preserves_state():
+    """A copied Signal preserves its public state in a separate object."""
+    signal = pyfar.Signal([0.25, -0.5, 1.0], 44100, comment="source")
+    copied = signal.copy()
+
+    assert isinstance(copied, pyfar.Signal)
+    assert copied is not signal
+    npt.assert_array_equal(copied.time, signal.time)
+    assert copied.sampling_rate == signal.sampling_rate
+    assert copied.comment == signal.comment
+    assert copied.domain == signal.domain
+    assert copied.fft_norm == signal.fft_norm
+
+
+def test_signal_copy_data_is_independent():
+    """Changing copied signal data does not change the source data."""
+    signal = pyfar.Signal([0.25, -0.5, 1.0], 44100)
+    copied = signal.copy()
+    source_data = signal.time.copy()
+
+    copied.time[0, 0] = 99
+
+    npt.assert_array_equal(signal.time, source_data)
+    assert not np.array_equal(copied.time, signal.time)
