+func TestEnsureLoadBalancerRecognizesInternalNameRegardlessOfCase(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+
+	az := GetTestCloud(ctrl)
+	service := getInternalTestService("service-1", 80)
+	validateTestSubnet(t, az, &service)
+	clusterResources, expectedInterfaces, expectedVirtualMachines := getClusterResources(az, 1, 1)
+	setMockEnv(az, ctrl, expectedInterfaces, expectedVirtualMachines, 1, service)
+
+	backendPool := az.LoadBalancerBackendPool.(*MockBackendPool)
+	backendPool.EXPECT().ReconcileBackendPools(gomock.Any(), gomock.Any(), gomock.Any()).DoAndReturn(
+		func(_ string, _ *v1.Service, lb *network.LoadBalancer) (bool, bool, *network.LoadBalancer, error) {
+			return false, false, lb, nil
+		}).AnyTimes()
+	backendPool.EXPECT().EnsureHostsInPool(gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any()).Return(nil).AnyTimes()
+	backendPool.EXPECT().GetBackendPrivateIPs(gomock.Any(), gomock.Any(), gomock.Any()).Return(nil, nil).AnyTimes()
+
+	loadBalancer := network.LoadBalancer{
+		Name: pointer.String("TESTCLUSTER-INTERNAL"),
+		LoadBalancerPropertiesFormat: &network.LoadBalancerPropertiesFormat{
+			FrontendIPConfigurations: &[]network.FrontendIPConfiguration{{
+				Name: pointer.String("aservice1"),
+				ID:   pointer.String("fip"),
+				FrontendIPConfigurationPropertiesFormat: &network.FrontendIPConfigurationPropertiesFormat{
+					PrivateIPAddress: pointer.String("10.0.0.6"),
+					Subnet:           &network.Subnet{Name: pointer.String("subnet")},
+				},
+			}},
+		},
+	}
+	mockLBClient := mockloadbalancerclient.NewMockInterface(ctrl)
+	az.LoadBalancerClient = mockLBClient
+	mockLBClient.EXPECT().List(gomock.Any(), az.ResourceGroup).Return([]network.LoadBalancer{loadBalancer}, nil).AnyTimes()
+	mockLBClient.EXPECT().Get(gomock.Any(), az.ResourceGroup, gomock.Any(), gomock.Any()).Return(loadBalancer, nil).AnyTimes()
+	mockLBClient.EXPECT().CreateOrUpdate(gomock.Any(), az.ResourceGroup, gomock.Any(), gomock.Any(), gomock.Any()).Return(nil).AnyTimes()
+	mockLBClient.EXPECT().Delete(gomock.Any(), gomock.Any(), gomock.Any()).Return(nil).AnyTimes()
+
+	mockPLSClient := mockprivatelinkserviceclient.NewMockInterface(ctrl)
+	mockPLSClient.EXPECT().List(gomock.Any(), az.Config.ResourceGroup).Return([]network.PrivateLinkService{}, nil).AnyTimes()
+	az.PrivateLinkServiceClient = mockPLSClient
+
+	status, err := az.EnsureLoadBalancer(context.TODO(), testClusterName, &service, clusterResources.nodes)
+	assert.NoError(t, err)
+	if assert.NotNil(t, status) {
+		var ingressIPs []string
+		for _, ingress := range status.Ingress {
+			ingressIPs = append(ingressIPs, ingress.IP)
+		}
+		assert.Contains(t, ingressIPs, "10.0.0.6")
+	}
+}
