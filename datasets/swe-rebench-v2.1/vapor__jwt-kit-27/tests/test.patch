+    }
+
+    private func decodedJWTHeader(from token: String) throws -> [String: Any] {
+        let parts = token.split(separator: ".")
+        let encodedHeader = try XCTUnwrap(parts.first).replacingOccurrences(of: "-", with: "+")
+            .replacingOccurrences(of: "_", with: "/")
+        let paddedHeader = encodedHeader + String(repeating: "=", count: (4 - encodedHeader.count % 4) % 4)
+        let headerData = try XCTUnwrap(Data(base64Encoded: paddedHeader))
+        let json = try JSONSerialization.jsonObject(with: headerData)
+        return try XCTUnwrap(json as? [String: Any])
