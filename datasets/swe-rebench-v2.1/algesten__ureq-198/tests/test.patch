+#[test]
+fn read_timeout_during_body() {
+    let server = TestServer::new(|stream| dribble_body_respond(stream, &[b'a'; 300]));
+    let url = format!("http://localhost:{}/", server.port);
+    let agent = Agent::default().build();
+    let resp = agent.get(&url).timeout_read(5).call();
+    assert!(
+        resp.into_string().is_err(),
+        "expected the response body read to time out"
+    );
+}
+
+// Send `len` body bytes on the TcpStream, one byte per `pause`.
+fn dribble_body_with_pause(mut stream: TcpStream, len: usize, pause: Duration) -> io::Result<()> {
+    read_headers(&stream);
+    let headers = format!("HTTP/1.1 200 OK\r\nContent-Length: {}\r\n\r\n", len);
+    stream.write_all(headers.as_bytes())?;
+    for _ in 0..len {
+        stream.write_all(b"a")?;
+        stream.flush()?;
+        thread::sleep(pause);
+    }
+    Ok(())
+}
+
+#[test]
+fn read_timeout_applies_per_read_not_to_whole_body() {
+    // The body takes about 1.5 seconds in total, but no single read waits
+    // longer than about 50 milliseconds, well within the 500 millisecond
+    // per-read timeout. The read timeout must not act as an overall deadline.
+    let server =
+        TestServer::new(|stream| dribble_body_with_pause(stream, 30, Duration::from_millis(50)));
+    let url = format!("http://localhost:{}/", server.port);
+    let agent = Agent::default().build();
+    let resp = agent.get(&url).timeout_read(500).call();
+    let body = resp
+        .into_string()
+        .expect("a body that makes progress within the read timeout must not time out");
+    assert_eq!(body, "a".repeat(30));
+}
