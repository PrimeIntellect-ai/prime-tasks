@@ -0,0 +1,35 @@
+import Event from '../../../src/event/Event';
+import Window from '../../../src/window/Window';
+
+describe('SubmitEvent', () => {
+	describe('constructor', () => {
+		it('Creates a submit event.', () => {
+			const window = new Window();
+			const submitter = window.document.createElement('button');
+			const SubmitEventConstructor = (window as any).SubmitEvent;
+			const event = new SubmitEventConstructor('submit', { bubbles: true, submitter });
+			expect(event).toBeInstanceOf(Event);
+			expect(event.bubbles).toBe(true);
+			expect(event.cancelable).toBe(false);
+			expect(event.submitter).toBe(submitter);
+		});
+
+		it('Uses null when no submitter is provided.', () => {
+			const window = new Window();
+			const SubmitEventConstructor = (window as any).SubmitEvent;
+			const event = new SubmitEventConstructor('submit');
+			expect(event.submitter).toBeNull();
+		});
+	});
+
+	describe('window.SubmitEvent', () => {
+		it('Is available on the window and constructs a submit event.', () => {
+			const window = new Window();
+			const submitter = window.document.createElement('button');
+			const event = new (window as any).SubmitEvent('submit', { bubbles: true, submitter });
+			expect(event).toBeInstanceOf(Event);
+			expect(event.bubbles).toBe(true);
+			expect(event.submitter).toBe(submitter);
+		});
+	});
+});
