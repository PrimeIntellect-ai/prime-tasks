+describe('Dev server', () => {
+  it('renders the page defined by app/nested/index.tsx', async () => {
+    const routeFile = path.resolve(__dirname, '../mocks/app/routes/app/nested/index.tsx')
+    let previousRoute: string | undefined
+    try {
+      previousRoute = await readFile(routeFile, 'utf8')
+    } catch {
+      // The app under test supplies this route for the duration of the request.
+    }
+    await mkdir(path.dirname(routeFile), { recursive: true })
+    await writeFile(routeFile, 'export default () => <h1>Nested</h1>')
+
+    let server: Awaited<ReturnType<typeof createServer>> | undefined
+    try {
+      server = await createServer({
+        configFile: path.resolve(__dirname, '../mocks/vite.config.ts'),
+        root: path.resolve(__dirname, '../mocks'),
+        server: {
+          host: '127.0.0.1',
+          port: 0,
+        },
+      })
+      await server.listen()
+      const address = server.httpServer?.address()
+      const port = typeof address === 'object' && address ? address.port : 0
+      const res = await fetch(`http://127.0.0.1:${port}/app/nested`)
+      expect(res.status).toBe(200)
+      const html = await res.text()
+      expect(html).toMatch(/<h1(?:\s[^>]*)?>\s*Nested\s*<\/h1>/i)
+    } finally {
+      await server?.close()
+      if (previousRoute === undefined) {
+        await rm(routeFile, { force: true })
+      } else {
+        await writeFile(routeFile, previousRoute)
+      }
+    }
+  })
+})
