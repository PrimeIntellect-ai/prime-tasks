+    public function testShowCommandListsInstalledModulesAndTheirVersions(): void
+    {
+        $process = new Process([PHP_BINARY, __DIR__ . '/../../../bin/pie', 'show']);
+        $process->run();
+
+        self::assertSame(0, $process->getExitCode(), $process->getErrorOutput());
+
+        $output = strtolower($process->getOutput());
+
+        foreach (get_loaded_extensions() as $extension) {
+            self::assertStringContainsString(strtolower($extension), $output);
+
+            $version = phpversion($extension);
+            if ($version !== false) {
+                self::assertStringContainsString($version, $output);
+            }
+        }
+    }
