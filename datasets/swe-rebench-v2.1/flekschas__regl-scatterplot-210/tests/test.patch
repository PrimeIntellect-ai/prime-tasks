+test('get() and set() performance properties', async () => {
+  const scatterplotA = createScatterplot({ canvas: createCanvas() });
+
+  expect(scatterplotA.get('performanceMode')).toBe(false);
+  expect(scatterplotA.get('renderPointsAsSquares')).toBe(false);
+  expect(scatterplotA.get('disableAlphaBlending')).toBe(false);
+
+  scatterplotA.destroy();
+
+  const scatterplotB = createScatterplot({
+    canvas: createCanvas(),
+    performanceMode: true,
+  });
+
+  expect(scatterplotB.get('performanceMode')).toBe(true);
+  expect(scatterplotB.get('renderPointsAsSquares')).toBe(true);
+  expect(scatterplotB.get('disableAlphaBlending')).toBe(true);
+
+  scatterplotB.destroy();
+
+  const scatterplotC = createScatterplot({
+    canvas: createCanvas(),
+    renderPointsAsSquares: true,
+  });
+
+  expect(scatterplotC.get('performanceMode')).toBe(false);
+  expect(scatterplotC.get('renderPointsAsSquares')).toBe(true);
+  expect(scatterplotC.get('disableAlphaBlending')).toBe(false);
+
+  scatterplotC.destroy();
+
+  const scatterplotD = createScatterplot({
+    canvas: createCanvas(),
+    disableAlphaBlending: true,
+  });
+
+  expect(scatterplotD.get('performanceMode')).toBe(false);
+  expect(scatterplotD.get('renderPointsAsSquares')).toBe(false);
+  expect(scatterplotD.get('disableAlphaBlending')).toBe(true);
+
+  scatterplotD.destroy();
+});
+
+test('renderPointsAsSquares controls the rendered point shape', async () => {
+  const dim = 100;
+  const createPlot = (options) =>
+    createScatterplot({
+      canvas: createCanvas(dim, dim),
+      width: dim,
+      height: dim,
+      pointSize: 20,
+      ...options,
+    });
+
+  const circles = createPlot({});
+  await circles.draw([[0, 0]]);
+  const circlePixelSum = getPixelSum(circles.export(), 0, dim, 0, dim);
+  circles.destroy();
+
+  const squares = createPlot({ renderPointsAsSquares: true });
+  await squares.draw([[0, 0]]);
+  const squarePixelSum = getPixelSum(squares.export(), 0, dim, 0, dim);
+  squares.destroy();
+
+  // A square point covers the full point quad while a circular point leaves the
+  // corners transparent, so the squared rendering lights up more pixels.
+  expect(circlePixelSum).toBeGreaterThan(0);
+  expect(squarePixelSum).toBeGreaterThan(circlePixelSum);
+});
+
+test('disableAlphaBlending controls alpha blending of overlapping points', async () => {
+  const dim = 100;
+  const createPlot = (options) =>
+    createScatterplot({
+      canvas: createCanvas(dim, dim),
+      width: dim,
+      height: dim,
+      pointSize: 20,
+      opacity: 0.5,
+      ...options,
+    });
+
+  const alphaSum = (image) => {
+    let sum = 0;
+    for (let i = 3; i < image.data.length; i += 4) sum += image.data[i];
+    return sum;
+  };
+
+  const overlappingPoints = [
+    [0, 0],
+    [0, 0],
+    [0, 0],
+  ];
+
+  const blended = createPlot({});
+  await blended.draw(overlappingPoints);
+  const blendedAlpha = alphaSum(blended.export());
+  blended.destroy();
+
+  const unblended = createPlot({ disableAlphaBlending: true });
+  await unblended.draw(overlappingPoints);
+  const unblendedAlpha = alphaSum(unblended.export());
+  unblended.destroy();
+
+  // With alpha blending enabled the overlapping semi-transparent points
+  // accumulate opacity, so the total alpha is higher than without blending.
+  expect(blendedAlpha).toBeGreaterThan(unblendedAlpha);
+});
