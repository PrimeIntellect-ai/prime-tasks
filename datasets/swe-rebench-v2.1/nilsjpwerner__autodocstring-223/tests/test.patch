+describe("docstring generation with Literal type hints", () => {
+    const document = [
+        "from typing import Literal",
+        "",
+        'def foo(bar: Literal["baz"]) -> None:',
+        "    pass",
+    ].join("\n");
+
+    it("should preserve the complete Literal annotation in the generated docstring", () => {
+        const docstringParts = parse(document, 3);
+        const docstringFactory = new DocstringFactory(getTemplate("google"));
+        const docstring = docstringFactory.generateDocstring(docstringParts);
+
+        const normalizedDocstring = docstring
+            .replace(/\$\{\d+:([^}]*)\}/g, "$1")
+            .replace(/&quot;/g, '"');
+        expect(normalizedDocstring).to.contain('bar (Literal["baz"])');
+    });
+});
