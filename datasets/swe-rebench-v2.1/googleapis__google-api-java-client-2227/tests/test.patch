+  public void testMediaUpload_preservesRequestInitializer() throws Exception {
+    MediaTransport transport = new MediaTransport();
+    HttpRequestInitializer credentialInitializer =
+        new HttpRequestInitializer() {
+          @Override
+          public void initialize(HttpRequest request) {
+            request.getHeaders().set("Authorization", "credential-marker");
+          }
+        };
+    AbstractGoogleClient client =
+        new MockGoogleClient.Builder(
+                transport,
+                TEST_RESUMABLE_REQUEST_URL,
+                "",
+                JSON_OBJECT_PARSER,
+                credentialInitializer)
+            .setApplicationName("Test Application")
+            .build();
+    InputStream is = new ByteArrayInputStream(new byte[MediaHttpUploader.DEFAULT_CHUNK_SIZE]);
+    InputStreamContent mediaContent = new InputStreamContent(TEST_CONTENT_TYPE, is);
+    mediaContent.setLength(MediaHttpUploader.DEFAULT_CHUNK_SIZE);
+    MockGoogleClientRequest<A> request =
+        new MockGoogleClientRequest<A>(client, "POST", "", null, A.class);
+
+    request.initializeMediaUpload(mediaContent);
+    request.getMediaHttpUploader().upload(new GenericUrl(TEST_RESUMABLE_REQUEST_URL));
+
+    assertFalse(transport.authorizationsRecorded.isEmpty());
+    for (String authorization : transport.authorizationsRecorded) {
+      assertEquals("credential-marker", authorization);
+    }
+  }
