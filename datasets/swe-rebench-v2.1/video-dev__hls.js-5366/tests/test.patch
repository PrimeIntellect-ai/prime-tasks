+describe('GapController large gap handling', function () {
+  let hls: Hls;
+  let media: any;
+  let fragmentTracker: FragmentTracker;
+  let gapController: GapController;
+
+  beforeEach(function () {
+    hls = new Hls({});
+    hls.networkControllers.forEach((component) => component.destroy());
+    hls.networkControllers.length = 0;
+    hls.coreComponents.forEach((component) => component.destroy());
+    hls.coreComponents.length = 0;
+    media = {
+      currentTime: 0,
+      paused: false,
+      seeking: false,
+      ended: false,
+      playbackRate: 1,
+      readyState: 1,
+    };
+    fragmentTracker = new FragmentTracker(hls);
+    gapController = new GapController(hls.config, media, fragmentTracker, hls);
+  });
+
+  afterEach(function () {
+    hls.destroy();
+  });
+
+  it('does not jump a large gap when fragments in the gap are not all partial', function () {
+    const currentTime = 105.275674;
+    const gapEnd = 170.055333;
+    media.currentTime = currentTime;
+    media.buffered = {
+      length: 2,
+      start: (i: number) => (i === 0 ? 0 : gapEnd),
+      end: (i: number) => (i === 0 ? currentTime : gapEnd + 10),
+    };
+    const partial = {
+      start: currentTime,
+      end: currentTime + 1,
+      duration: 1,
+      gap: false,
+    };
+    sinon
+      .stub(fragmentTracker, 'getPartialFragment')
+      .callsFake((pos: number) =>
+        pos === currentTime ? (partial as any) : null
+      );
+    sinon.stub(fragmentTracker, 'getAppendedFrag').returns(null as any);
+
+    gapController.poll(currentTime);
+    gapController.poll(currentTime);
+
+    expect(media.currentTime).to.be.at.most(gapEnd);
+  });
+
+  it('does not jump a non-start large gap when no spanning fragments are tracked', function () {
+    const currentTime = 105.275674;
+    const gapEnd = 170.055333;
+    media.currentTime = currentTime;
+    media.buffered = {
+      length: 2,
+      start: (i: number) => (i === 0 ? 0 : gapEnd),
+      end: (i: number) => (i === 0 ? currentTime : gapEnd + 10),
+    };
+
+    gapController.poll(currentTime);
+    gapController.poll(currentTime);
+
+    expect(media.currentTime).to.be.at.most(gapEnd);
+  });
+
+  it('jumps a large gap when all fragments in the gap are partial', function () {
+    const currentTime = 105.275674;
+    const gapEnd = 170.055333;
+    media.currentTime = currentTime;
+    media.buffered = {
+      length: 2,
+      start: (i: number) => (i === 0 ? 0 : gapEnd),
+      end: (i: number) => (i === 0 ? currentTime : gapEnd + 10),
+    };
+    const partialGap = new Fragment(PlaylistLevelType.MAIN, '');
+    partialGap.sn = 1;
+    partialGap.start = currentTime;
+    partialGap.duration = gapEnd - currentTime;
+    partialGap.gap = true;
+    fragmentTracker.fragBuffered(partialGap, true);
+
+    gapController.poll(currentTime);
+    gapController.poll(currentTime);
+
+    expect(media.currentTime).to.be.greaterThan(gapEnd);
+  });
+});
