+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+from test.unit.rules import BaseRuleTestCase
+import cfnlint.core
+from cfnlint.runner import Runner
+
+
+class TestRoute53RecordSetName(BaseRuleTestCase):
+    """Test Route53 RecordSet hosted-zone names"""
+
+    def setUp(self):
+        """Setup"""
+        super(TestRoute53RecordSetName, self).setUp()
+        self.collection = cfnlint.core.get_rules([], [], [])
+        self.success_templates = [
+            'test/fixtures/templates/good/resources/route53/recordset_name.yaml'
+        ]
+
+    def test_file_positive(self):
+        """Valid record-set names are accepted"""
+        self.helper_file_positive()
+
+    def errors_for_resource(self, resource_name):
+        """Return errors for one resource in the negative template"""
+        filename = 'test/fixtures/templates/bad/resources/route53/recordset_name.yaml'
+        template = self.load_template(filename)
+        template['Resources'] = {resource_name: template['Resources'][resource_name]}
+        runner = Runner(self.collection, filename, template, ['us-east-1'], [])
+        runner.transform()
+        return [match for match in runner.run() if match.rule.id.startswith('E')]
+
+    def test_hosted_zone_name_without_dot_is_rejected(self):
+        """A hosted-zone name without its trailing dot produces an error"""
+        self.assertTrue(self.errors_for_resource('RecordSet1'))
+
+    def test_name_without_hosted_zone_suffix_is_rejected(self):
+        """A record-set name outside its hosted zone produces an error"""
+        self.assertTrue(self.errors_for_resource('RecordSet2'))
