+def test_friendly_declspec():
+    content = """
+      struct D {
+          friend __declspec(dllexport) void my_friend();
+          static __declspec(dllexport) void static_declspec();
+      };
+    """
+    data = parse_string(content, cleandoc=True)
+
+    assert data == ParsedData(
+        namespace=NamespaceScope(
+            classes=[
+                ClassScope(
+                    class_decl=ClassDecl(
+                        typename=PQName(
+                            segments=[NameSpecifier(name="D")], classkey="struct"
+                        )
+                    ),
+                    friends=[
+                        FriendDecl(
+                            fn=Method(
+                                return_type=Type(
+                                    typename=PQName(
+                                        segments=[FundamentalSpecifier(name="void")]
+                                    )
+                                ),
+                                name=PQName(segments=[NameSpecifier(name="my_friend")]),
+                                parameters=[],
+                                access="public",
+                            )
+                        )
+                    ],
+                    methods=[
+                        Method(
+                            return_type=Type(
+                                typename=PQName(
+                                    segments=[FundamentalSpecifier(name="void")]
+                                )
+                            ),
+                            name=PQName(
+                                segments=[NameSpecifier(name="static_declspec")]
+                            ),
+                            parameters=[],
+                            static=True,
+                            access="public",
+                        )
+                    ],
+                )
+            ]
+        )
+    )
+
+
+def test_friendly_declspec_opencascade():
+    # The declarations from the OpenCASCADE headers that motivated this feature
+    content = """
+      class CDM_MetaData : public Standard_Transient
+      {
+      public:
+      friend class CDM_Reference;
+      friend
+        __declspec( dllexport ) void CDM_Document::SetMetaData (const opencascade::handle<CDM_MetaData>& aMetaData);
+      friend
+        __declspec( dllexport ) void CDM_Application::SetDocumentVersion (const opencascade::handle<CDM_Document>& aDocument, const opencascade::handle<CDM_MetaData>& aMetaData) const;
+      };
+    """
+    data = parse_string(content, cleandoc=True)
+
+    cls = data.namespace.classes[0]
+    assert len(cls.friends) == 3
+
+    # the first friend is a friend class
+    assert cls.friends[0].cls is not None
+    assert cls.friends[0].fn is None
+
+    # the second friend is a qualified free function with one parameter
+    fn1 = cls.friends[1].fn
+    assert fn1 is not None
+    assert [seg.name for seg in fn1.name.segments] == ["CDM_Document", "SetMetaData"]
+    assert len(fn1.parameters) == 1
+    assert fn1.const is False
+
+    # the third friend is a qualified free function with two parameters and const
+    fn2 = cls.friends[2].fn
+    assert fn2 is not None
+    assert [seg.name for seg in fn2.name.segments] == [
+        "CDM_Application",
+        "SetDocumentVersion",
+    ]
+    assert len(fn2.parameters) == 2
+    assert fn2.const is True
