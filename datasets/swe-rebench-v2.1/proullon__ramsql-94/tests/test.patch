+func TestInsertFalseBoolAsBoundValue(t *testing.T) {
+	db, err := sql.Open("ramsql", "TestInsertFalseBoolAsBoundValue")
+	if err != nil {
+		t.Fatalf("sql.Open: %s", err)
+	}
+	defer db.Close()
+
+	_, err = db.Exec(`CREATE TABLE named_bool (id INT, hasBool BOOL)`)
+	if err != nil {
+		t.Fatalf("cannot create table: %s", err)
+	}
+
+	input := struct {
+		ID      int
+		HasBool bool
+	}{ID: 1}
+	_, err = db.Exec(`INSERT INTO named_bool (id, hasBool) VALUES (?, ?)`, input.ID, input.HasBool)
+	if err != nil {
+		t.Fatalf("cannot insert false bound boolean: %s", err)
+	}
+
+	var got bool
+	err = db.QueryRow(`SELECT hasBool FROM named_bool WHERE id = ?`, input.ID).Scan(&got)
+	if err != nil {
+		t.Fatalf("cannot read bound boolean: %s", err)
+	}
+	if got {
+		t.Fatalf("expected stored boolean false, got true")
+	}
+}
