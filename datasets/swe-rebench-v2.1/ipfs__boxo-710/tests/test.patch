+// startRepublisher supports lifecycle forms that expose cancellation through a
+// context or a returned stop function without requiring either form.
+func startRepublisher(t *testing.T, rp *Republisher) {
+	t.Helper()
+	run := reflect.ValueOf(rp).MethodByName("Run")
+	var args []reflect.Value
+	var cancel context.CancelFunc
+	if run.Type().NumIn() == 1 && run.Type().In(0).Implements(reflect.TypeOf((*context.Context)(nil)).Elem()) {
+		ctx, stop := context.WithCancel(context.Background())
+		cancel = stop
+		args = append(args, reflect.ValueOf(ctx))
+	} else if run.Type().NumIn() != 0 {
+		t.Skip("republisher requires an external process lifecycle")
+	}
+	if cancel != nil {
+		t.Cleanup(cancel)
+	}
+	for _, result := range run.Call(args) {
+		if result.Kind() == reflect.Func {
+			stop := result
+			t.Cleanup(func() { stop.Call(nil) })
+		}
+	}
+}
