+// TestNoGoprocessDependency verifies that boxo no longer depends on
+// github.com/jbenet/goprocess. The task explicitly requires removing this
+// dependency so that code depending on boxo does not need to support it.
+// This is checked by scanning every Go source file in the module for imports
+// of goprocess (or any of its subpackages) and by verifying that go.mod does
+// not list goprocess as a direct requirement.
+func TestNoGoprocessDependency(t *testing.T) {
+	root := findModuleRoot(t)
+
+	const goprocess = "github.com/jbenet/goprocess"
+
+	var offenders []string
+	err := filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if d.IsDir() {
+			switch d.Name() {
+			case ".git", "vendor":
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if !strings.HasSuffix(path, ".go") {
+			return nil
+		}
+		fset := token.NewFileSet()
+		f, perr := parser.ParseFile(fset, path, nil, parser.ImportsOnly)
+		if perr != nil {
+			// Ignore files that cannot be parsed (e.g. build-tagged for
+			// other platforms); they cannot be importing goprocess in a way
+			// that affects this module's dependency graph.
+			return nil
+		}
+		for _, imp := range f.Imports {
+			p := strings.Trim(imp.Path.Value, `"`)
+			if p == goprocess || strings.HasPrefix(p, goprocess+"/") {
+				rel, rerr := filepath.Rel(root, path)
+				if rerr != nil {
+					rel = path
+				}
+				offenders = append(offenders, rel)
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("walking module tree: %v", err)
+	}
+	if len(offenders) > 0 {
+		t.Fatalf("boxo must not depend on %s, but found imports in: %v", goprocess, offenders)
+	}
+
+	// The module must not list goprocess as a direct requirement in go.mod.
+	// A transitive (indirect) requirement is acceptable, but boxo itself must
+	// not depend on it directly.
+	gomodPath := filepath.Join(root, "go.mod")
+	data, rerr := os.ReadFile(gomodPath)
+	if rerr != nil {
+		t.Fatalf("reading %s: %v", gomodPath, rerr)
+	}
+	mf, rerr := modfile.Parse(gomodPath, data, nil)
+	if rerr != nil {
+		t.Fatalf("parsing %s: %v", gomodPath, rerr)
+	}
+	for _, req := range mf.Require {
+		if req.Mod.Path == goprocess && !req.Indirect {
+			t.Fatalf("boxo must not directly require %s in go.mod", goprocess)
+		}
+	}
+}
+
+// findModuleRoot walks up from the current working directory until it finds
+// the go.mod file that defines the module under test.
+func findModuleRoot(t *testing.T) string {
+	t.Helper()
+	dir, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("getting working directory: %v", err)
+	}
+	for {
+		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			t.Fatal("could not locate go.mod for the module under test")
+		}
+		dir = parent
+	}
+}
