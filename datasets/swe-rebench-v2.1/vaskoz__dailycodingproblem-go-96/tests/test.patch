+package day43
+
+import (
+	"testing"
+	"time"
+)
+
+var testcases = []struct {
+	input []int
+	max   []int
+}{
+	{[]int{1, 2, 3, 4, 5, 6}, []int{1, 2, 3, 4, 5, 6}},
+	{[]int{3, 1, 4, 1, 5, 9, 2, 6}, []int{3, 3, 4, 4, 5, 9, 9, 9}},
+}
+
+func TestMaxIntStack(t *testing.T) {
+	t.Parallel()
+	for tcid, tc := range testcases {
+		stack := NewMaxIntStack()
+		for i, push := range tc.input {
+			stack.Push(push)
+			if max, err := stack.Max(); err != nil || max != tc.max[i] {
+				t.Errorf("TC%d push expected,got max (%d,%d) error should be nil (%v)",
+					tcid, tc.max[i], max, err)
+			}
+		}
+		for i := range tc.input {
+			if max, err := stack.Max(); err != nil || max != tc.max[len(tc.max)-1-i] {
+				t.Errorf("TC%d pre-pop expected,got max (%d,%d) error should be nil (%v)",
+					tcid, tc.max[len(tc.max)-1-i], max, err)
+			}
+			if val, err := stack.Pop(); err != nil || val != tc.input[len(tc.input)-1-i] {
+				t.Errorf("TC%d pop expected,got val (%d,%d) error should be nil (%v)",
+					tcid, tc.input[len(tc.input)-1-i], val, err)
+			}
+		}
+		if _, err := stack.Pop(); err != StackEmptyError() {
+			t.Errorf("Stack should be empty and return an error on Pop()")
+		}
+		if _, err := stack.Max(); err != StackEmptyError() {
+			t.Errorf("Stack should be empty and return an error on Max()")
+		}
+	}
+}
+
+// TestMaxIntStackConstantTime checks that Push, Pop and Max do not scan the
+// stack: the time to run each operation must not grow with the number of
+// elements already on the stack.
+func TestMaxIntStackConstantTime(t *testing.T) {
+	if testing.Short() {
+		t.Skip("skipping timing-sensitive test in short mode")
+	}
+
+	// Push is measured by filling a fresh stack: a constant-time Push makes
+	// the total time grow linearly with the number of elements, while a Push
+	// that scans the stack makes it grow quadratically. This check is bounded
+	// and runs first so that a non-constant Push cannot make the larger
+	// measurements below run for a very long time.
+	const (
+		pushSmall  = 2000
+		pushLarge  = 16000
+		pushTrials = 9
+	)
+	timePush := func(n int) time.Duration {
+		best := time.Duration(1) << 62
+		for trial := 0; trial < pushTrials; trial++ {
+			start := time.Now()
+			s := NewMaxIntStack()
+			for i := 0; i < n; i++ {
+				s.Push(i)
+			}
+			if d := time.Since(start); d < best {
+				best = d
+			}
+		}
+		return best
+	}
+	smallPush := timePush(pushSmall)
+	largePush := timePush(pushLarge)
+	if largePush > 50*time.Millisecond && largePush > smallPush*20 {
+		t.Fatalf("Push() does not run in constant time: %d elements took %v, %d elements took %v",
+			pushSmall, smallPush, pushLarge, largePush)
+	}
+
+	const (
+		smallSize = 2000
+		largeSize = 1000000
+		reps      = 1000
+		trials    = 7
+	)
+
+	build := func(n int) MaxIntStack {
+		s := NewMaxIntStack()
+		for i := 0; i < n; i++ {
+			s.Push(i)
+		}
+		return s
+	}
+
+	// timeOp returns the best (minimum) time to run reps operations of the
+	// given kind on a freshly built stack of size n.
+	timeOp := func(n int, op func(MaxIntStack)) time.Duration {
+		best := time.Duration(1) << 62
+		for trial := 0; trial < trials; trial++ {
+			s := build(n)
+			start := time.Now()
+			for i := 0; i < reps; i++ {
+				op(s)
+			}
+			if d := time.Since(start); d < best {
+				best = d
+			}
+		}
+		return best
+	}
+
+	// Max and Pop are measured on a large stack: a constant-time operation
+	// takes about the same time on a large stack as on a small one, while an
+	// operation that scans the stack would take about largeSize/smallSize
+	// times longer.
+	for _, op := range []struct {
+		name string
+		run  func(MaxIntStack)
+	}{
+		{"Max", func(s MaxIntStack) { s.Max() }},
+		{"Pop", func(s MaxIntStack) { s.Pop() }},
+	} {
+		small := timeOp(smallSize, op.run)
+		large := timeOp(largeSize, op.run)
+		if large > 50*time.Millisecond && large > small*50 {
+			t.Errorf("%s() does not run in constant time: %d elements took %v, %d elements took %v",
+				op.name, smallSize, small, largeSize, large)
+		}
+	}
+}
+
+func BenchmarkMaxIntStack(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			stack := NewMaxIntStack()
+			for _, push := range tc.input {
+				stack.Push(push)
+				stack.Max()
+				stack.Pop()
+			}
+		}
+	}
+}
+
+func TestNewMaxIntStackReturnsIndependentStacks(t *testing.T) {
+	first := NewMaxIntStack()
+	second := NewMaxIntStack()
+
+	first.Push(8)
+	if _, err := second.Max(); err != StackEmptyError() {
+		t.Fatalf("a newly constructed stack should remain empty after using another stack: %v", err)
+	}
+
+	second.Push(3)
+	if max, err := first.Max(); err != nil || max != 8 {
+		t.Fatalf("first stack should retain its own maximum 8, got (%d, %v)", max, err)
+	}
+	if max, err := second.Max(); err != nil || max != 3 {
+		t.Fatalf("second stack should retain its own maximum 3, got (%d, %v)", max, err)
+	}
+}
