+def test_configure_discover_default_calendar(runner, monkeypatch, metavdirs):
+    runner = runner()
+    runner.config_file.remove()
+
+    class VdirConfig:
+        storages = {
+            'collection': {
+                'type': 'filesystem',
+                'path': f'{metavdirs}/cal1/',
+                'instance_name': 'declared_collection',
+            },
+        }
+
+    monkeypatch.setattr(
+        'vdirsyncer.cli.config.load_config', lambda: VdirConfig())
+    result = runner.invoke(
+        main_khal, ['configure'],
+        input=choices(calendar_option=1),
+    )
+
+    assert result.exit_code == 0, result.output
+    config = get_config(str(runner.config_file))
+    assert config['default']['default_calendar'] in config['calendars']
+
