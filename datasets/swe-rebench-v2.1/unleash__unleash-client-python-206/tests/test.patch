+@responses.activate
+def test_uc_cache_bootstrap_url_fallback(cache):
+    # Bootstrap URL returns a valid configuration.
+    responses.add(responses.GET, URL + "/bootstrap", json=MOCK_FEATURE_RESPONSE_PROJECT, status=200)
+
+    # The Unleash API is unavailable.
+    responses.add(responses.POST, URL + REGISTER_URL, json={}, status=202)
+    responses.add(responses.GET, URL + FEATURES_URL, status=500)
+    responses.add(responses.POST, URL + METRICS_URL, json={}, status=202)
+
+    # Set up cache
+    cache.bootstrap_from_url(initial_config_url=URL + "/bootstrap")
+
+    # Check bootstrapping
+    unleash_client = UnleashClient(
+        URL,
+        APP_NAME,
+        refresh_interval=REFRESH_INTERVAL,
+        metrics_interval=METRICS_INTERVAL,
+        cache=cache
+    )
+    assert unleash_client.is_enabled("ivan-project")
+
+    # The Unleash API is tried but fails; the bootstrapped configuration is used as a fallback.
+    unleash_client.initialize_client()
+    time.sleep(1)
+    assert unleash_client.is_enabled("ivan-project")
+    assert not unleash_client.is_enabled("testFlag")
+
+
+@responses.activate
+def test_uc_bootstrap_url_is_not_reloaded_on_later_refresh(cache):
+    bootstrap_url = URL + "/bootstrap"
+
+    # The Unleash API returns an empty configuration first, then an updated one on a later refresh.
+    responses.add(responses.GET, bootstrap_url, json=MOCK_FEATURE_RESPONSE, status=200)
+    responses.add(responses.GET, URL + FEATURES_URL, json={"version": 2, "features": []}, status=200)
+    responses.add(responses.GET, URL + FEATURES_URL, json=MOCK_FEATURE_RESPONSE_PROJECT, status=200)
+
+    cache.bootstrap_from_url(initial_config_url=bootstrap_url)
+    unleash_client = UnleashClient(
+        URL,
+        APP_NAME,
+        refresh_interval=1,
+        metrics_interval=METRICS_INTERVAL,
+        disable_metrics=True,
+        disable_registration=True,
+        cache=cache,
+    )
+
+    try:
+        unleash_client.initialize_client()
+        assert not unleash_client.is_enabled("testFlag")
+
+        deadline = time.monotonic() + 4
+        while time.monotonic() < deadline and not unleash_client.is_enabled("ivan-project"):
+            time.sleep(0.05)
+
+        # A refresh has applied the updated API configuration.
+        assert unleash_client.is_enabled("ivan-project")
+        assert not unleash_client.is_enabled("testFlag")
+
+        # The bootstrap source is not fetched again on refresh (at most the one initial load).
+        bootstrap_fetches = [call for call in responses.calls if call.request.url.startswith(bootstrap_url)]
+        assert len(bootstrap_fetches) <= 1
+    finally:
+        unleash_client.destroy()
