+	}
+
+	firstRuntime := wazero.NewRuntimeWithConfig(ctx, wazero.NewRuntimeConfigCompiler())
+	_, err := firstRuntime.CompileModule(testCtx, moduleBinary, wazero.NewCompileConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = firstRuntime.Close(testCtx); err != nil {
+		t.Fatal(err)
+	}
+
+	entries, err := os.ReadDir(cacheDir)
+	if err != nil {
+		t.Fatal(err)
+	}
