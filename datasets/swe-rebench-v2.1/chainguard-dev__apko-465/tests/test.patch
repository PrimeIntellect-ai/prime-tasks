+// TestFixateWorldReadsLocalRepositoryPathFromFilesystem verifies that a repository supplied as a local
+// filesystem path (as with --repository-append /work/packages) is read from the
+// local filesystem rather than fetched over HTTP.
+func TestFixateWorldReadsLocalRepositoryPathFromFilesystem(t *testing.T) {
+	// A build targeting amd64 uses apk's x86_64 architecture name.
+	arch := "x86_64"
+	repoDir := t.TempDir()
+	require.NoError(t, os.MkdirAll(filepath.Join(repoDir, arch), 0o755))
+
+	indexData, err := os.ReadFile(filepath.Join("testdata", indexFilename))
+	require.NoError(t, err, "unable to read test index")
+	require.NoError(t, os.WriteFile(filepath.Join(repoDir, arch, indexFilename), indexData, 0o644))
+
+	// Include the selected package archive alongside the index. The package
+	// must be installed from this local repository, not just resolved there.
+	archivePath := filepath.Join(repoDir, arch, "perl-timedate-doc-2.33-r1.apk")
+	require.NoError(t, os.WriteFile(archivePath, buildLocalRepoTestAPKArchive(t), 0o644))
+
+	src := memfs.New()
+	require.NoError(t, src.MkdirAll("etc/apk", 0o755))
+	require.NoError(t, src.WriteFile(reposFilePath, []byte(repoDir), 0o644))
+	require.NoError(t, src.WriteFile(archFilePath, []byte(arch), 0o644))
+	require.NoError(t, src.MkdirAll(keysDirPath, 0o755))
+	// Leave the selected package uninstalled so FixateWorld must retrieve and
+	// install its archive from the local repository.
+	require.NoError(t, src.MkdirAll("lib/apk/db", 0o755))
+	require.NoError(t, src.WriteFile("lib/apk/db/installed", []byte("\n"), 0o644))
+	require.NoError(t, src.WriteFile("lib/apk/db/scripts.tar", nil, 0o644))
+	require.NoError(t, src.WriteFile(worldFilePath, []byte("perl-timedate-doc"), 0o644))
+	require.NoError(t, src.WriteFile(
+		filepath.Join(keysDirPath, "alpine-devel@lists.alpinelinux.org-6165ee59.rsa.pub"),
+		[]byte(localRepoTestSigningPublicKey), 0o644))
+
+	a, err := NewAPKImplementation(WithFS(src), WithIgnoreMknodErrors(ignoreMknodErrors))
+	require.NoError(t, err, "unable to create APKImplementation")
+
+	require.NoError(t,
+		a.FixateWorld(false, true, false, nil),
+		"unable to resolve packages from local repository during build")
+	installed, err := src.ReadFile("local-package")
+	require.NoError(t, err, "local package archive payload was not installed")
+	require.Equal(t, "installed from local repository", string(installed))
+}
+
+func buildLocalRepoTestAPKArchive(t *testing.T) []byte {
+	t.Helper()
+
+	makeTarGz := func(name, contents string) []byte {
+		var compressed bytes.Buffer
+		zw := gzip.NewWriter(&compressed)
+		tw := tar.NewWriter(zw)
+		require.NoError(t, tw.WriteHeader(&tar.Header{
+			Name: name,
+			Mode: 0o644,
+			Size: int64(len(contents)),
+		}))
+		_, err := tw.Write([]byte(contents))
+		require.NoError(t, err)
+		require.NoError(t, tw.Close())
+		require.NoError(t, zw.Close())
+		return compressed.Bytes()
+	}
+
+	var archive bytes.Buffer
+	archive.Write(makeTarGz(".PKGINFO", "pkgname = perl-timedate-doc\npkgver = 2.33-r1\n"))
+	archive.Write(makeTarGz("local-package", "installed from local repository"))
+	return archive.Bytes()
+}
