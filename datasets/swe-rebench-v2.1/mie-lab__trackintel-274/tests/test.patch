+from trackintel.io.postgis import read_trips_postgis
+from trackintel.io.file import write_triplegs_csv
+from trackintel.io.postgis import write_triplegs_postgis
+from trackintel.model.triplegs import TriplegsAccessor
+
+
+class TestCopy_Docstring:
+    def test_default(self):
+        from trackintel.model.util import copy_docstring
+
+        @copy_docstring(read_trips_postgis)
+        def bar(b: int) -> int:
+            """Old docstring."""
+            pass
+
+        old_docs = """Old docstring."""
+        assert bar.__doc__ == read_trips_postgis.__doc__
+        assert bar.__doc__ != old_docs
+
+    def test_accessor_method_docstring(self):
+        assert write_triplegs_csv.__doc__ in TriplegsAccessor.to_csv.__doc__
+        assert write_triplegs_postgis.__doc__ in TriplegsAccessor.to_postgis.__doc__
