@@ -13,3 +15,43 @@ func TestReceiverNamingTypeParams(t *testing.T) {
 	}
 	testRule(t, "receiver-naming-issue-669", &rule.ReceiverNamingRule{})
 }
+
+func TestReceiverNamingMaxLength(t *testing.T) {
+	filename := "../testdata/receiver-naming-issue-1040.go"
+	config := lint.RuleConfig{Arguments: []any{map[string]any{"maxLength": int64(2)}}}
+	linter := lint.New(func(file string) ([]byte, error) {
+		return os.ReadFile(file)
+	}, 0)
+	failures, err := linter.Lint([][]string{{filename}}, []lint.Rule{&rule.ReceiverNamingRule{}}, lint.Config{
+		Rules: map[string]lint.RuleConfig{"receiver-naming": config},
+	})
+	if err != nil {
+		t.Fatalf("linting failed: %v", err)
+	}
+
+	foundOverLimit := false
+	for failure := range failures {
+		if failure.Position.Start.Line == 5 {
+			foundOverLimit = true
+			continue
+		}
+		t.Errorf("unexpected receiver-naming failure at line %d", failure.Position.Start.Line)
+	}
+	if !foundOverLimit {
+		t.Fatal("expected a finding for the receiver name exceeding the configured maximum length")
+	}
+}
+
+func TestReceiverNamingMaxLengthWithoutConfiguration(t *testing.T) {
+	filename := "../testdata/receiver-naming-issue-1040.go"
+	linter := lint.New(func(file string) ([]byte, error) {
+		return os.ReadFile(file)
+	}, 0)
+	failures, err := linter.Lint([][]string{{filename}}, []lint.Rule{&rule.ReceiverNamingRule{}}, lint.Config{})
+	if err != nil {
+		t.Fatalf("linting failed: %v", err)
+	}
+	for failure := range failures {
+		t.Errorf("unexpected finding without a configured receiver-name length limit at line %d: %s", failure.Position.Start.Line, failure.Failure)
+	}
+}
