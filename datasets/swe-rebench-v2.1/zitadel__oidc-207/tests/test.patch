+// issue 203 test case.
+func Test_userinfo_GetAddress_issue_203(t *testing.T) {
+	tests := []struct {
+		name    string
+		data    string
+		country string
+	}{
+		{
+			name:    "with address",
+			data:    `{"address":{"country":"CH","street_address":"Test 789\nPostfach 2"},"email":"test","email_verified":true,"name":"Test","phone_number":"0791234567","phone_number_verified":true,"private_claim":"test","sub":"test"}`,
+			country: "CH",
+		},
+		{
+			name:    "without address",
+			data:    `{"email":"test","email_verified":true,"name":"Test","phone_number":"0791234567","phone_number_verified":true,"private_claim":"test","sub":"test"}`,
+			country: "",
+		},
+		{
+			name:    "null address",
+			data:    `{"address":null,"email":"test","email_verified":true,"name":"Test","phone_number":"0791234567","phone_number_verified":true,"private_claim":"test","sub":"test"}`,
+			country: "",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			info := &userinfo{}
+			err := json.Unmarshal([]byte(tt.data), info)
+			require.NoError(t, err)
+
+			addr := info.GetAddress()
+			if tt.country != "" {
+				require.NotNil(t, addr)
+				assert.Equal(t, tt.country, addr.GetCountry())
+			} else if addr != nil {
+				assert.Empty(t, addr.GetCountry())
+			}
+		})
+	}
+}
