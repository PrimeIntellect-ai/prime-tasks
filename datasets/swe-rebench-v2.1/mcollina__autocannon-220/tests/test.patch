diff --git a/test/basic-auth.test.js b/test/basic-auth.test.js
new file mode 100644
index 0000000..2ba1daa
--- /dev/null
+++ b/test/basic-auth.test.js
@@ -0,0 +1,40 @@
+'use strict'
+
+const t = require('tap')
+const path = require('path')
+const childProcess = require('child_process')
+const helper = require('./helper')
+
+t.plan(4)
+
+const children = []
+
+runAuthBenchmark('http', helper.startBasicAuthServer())
+runAuthBenchmark('https', helper.startBasicAuthServer({ https: true }))
+
+function runAuthBenchmark (protocol, server) {
+  const url = protocol + '://foo:bar@localhost:' + server.address().port
+  const child = childProcess.spawn(process.execPath, [path.join(__dirname, '..'), '-d', '1', url], {
+    cwd: __dirname,
+    env: process.env,
+    stdio: ['ignore', 'pipe', 'pipe'],
+    detached: false
+  })
+  children.push(child)
+
+  let acceptedRequest = false
+  server.on('request', (req, res) => {
+    res.on('finish', () => {
+      if (res.statusCode >= 200 && res.statusCode < 300) acceptedRequest = true
+    })
+  })
+
+  child.on('close', (code) => {
+    t.equal(code, 0, protocol + ' benchmark completes successfully')
+    t.ok(acceptedRequest, protocol + ' protected server accepts URL credentials')
+  })
+}
+
+t.tearDown(() => {
+  children.forEach((child) => child.kill())
+})
