-	}`), collector.Reflector().SpecEns())
+	}`)
+
+	var expectedDoc, actualDoc map[string]interface{}
+	require.NoError(t, json.Unmarshal(expected, &expectedDoc))
+	actual, err := json.Marshal(collector.Reflector().SpecEns())
+	require.NoError(t, err)
+	require.NoError(t, json.Unmarshal(actual, &actualDoc))
+
+	// Duplicate schemas in a combined error response do not change its behavior.
+	for _, doc := range []map[string]interface{}{expectedDoc, actualDoc} {
+		responses := doc["paths"].(map[string]interface{})["/test"].(map[string]interface{})["post"].(map[string]interface{})["responses"].(map[string]interface{})
+		schema := responses["400"].(map[string]interface{})["content"].(map[string]interface{})["application/json"].(map[string]interface{})["schema"].(map[string]interface{})
+		oneOf := schema["oneOf"].([]interface{})
+		seen := make(map[string]bool)
+		unique := make([]interface{}, 0, len(oneOf))
+		for _, item := range oneOf {
+			encoded, marshalErr := json.Marshal(item)
+			require.NoError(t, marshalErr)
+			if !seen[string(encoded)] {
+				seen[string(encoded)] = true
+				unique = append(unique, item)
+			}
+		}
+		schema["oneOf"] = unique
+	}
+
+	normalizedExpected, err := json.Marshal(expectedDoc)
+	require.NoError(t, err)
+	assertjson.EqualMarshal(t, normalizedExpected, actualDoc)
