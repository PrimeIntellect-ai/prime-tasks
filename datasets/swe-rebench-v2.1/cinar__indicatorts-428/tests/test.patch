+// Copyright (c) 2022 Onur Cinar. All Rights Reserved.
+// https://github.com/cinar/indicatorts
+
+import { onBalanceVolume } from './onBalanceVolume';
+
+describe('On Balance Volume (OBV)', () => {
+  it('should be able to compute OBV', () => {
+    const closings = [9, 11, 7, 10, 8];
+    const volumes = [100, 110, 80, 120, 90];
+
+    const actual = onBalanceVolume(closings, volumes);
+
+    // The reported bug was that OBV returned only NaN values.
+    expect(actual.length).toBe(closings.length);
+    expect(
+      actual.filter((value) => Number.isFinite(value)).length
+    ).toBeGreaterThanOrEqual(closings.length - 1);
+
+    // OBV accumulates volume in the direction of the closing price change.
+    for (let i = 2; i < actual.length; i++) {
+      const expectedDelta =
+        closings[i] > closings[i - 1]
+          ? volumes[i]
+          : closings[i] < closings[i - 1]
+          ? -volumes[i]
+          : 0;
+
+      expect(actual[i] - actual[i - 1]).toBeCloseTo(expectedDelta, 5);
+    }
+  });
+});
