diff --git a/test/tailwind_formatter_test.exs b/test/tailwind_formatter_test.exs
index b462736..84c625c 100644
--- a/test/tailwind_formatter_test.exs
+++ b/test/tailwind_formatter_test.exs
@@ -523,4 +523,15 @@ defmodule TailwindFormatterTest do
 
     assert_formatter_output(input, expected)
   end
+
+  # https://tailwindcss.com/docs/adding-custom-styles#arbitrary-properties
+  test "preserves the required space in arbitrary properties" do
+    input = """
+    <html lang="en" class="[scrollbar-gutter: stable] potato">
+    """
+
+    formatted = TailwindFormatter.format(input, [])
+
+    assert String.contains?(formatted, "[scrollbar-gutter: stable]")
+  end
 end
