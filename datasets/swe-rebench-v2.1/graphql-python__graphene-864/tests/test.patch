+@pytest.mark.xfail(
+    reason="creating the error message fails when un-parsable object is not JSON serializable."
+)
+def test_bad_variables():
+    def _test_bad_variables(type, input):
+        result = schema.execute(
+            """query Test($input: {}){{ {}(in: $input) }}""".format(type, type.lower()),
+            variables={"input": input},
+        )
+        assert len(result.errors) == 1
+        # when `input` is not JSON serializable formatting the error message in
+        # `graphql.utils.is_valid_value` line 79 fails with a TypeError
+        assert isinstance(result.errors[0], GraphQLError)
+        print(result.errors[0])
+        assert result.data is None
+
+    not_a_date = dict()
+    not_a_date_str = "Some string that's not a date"
+    today = datetime.date.today()
+    now = datetime.datetime.now().replace(tzinfo=pytz.utc)
+    time = datetime.time(now.hour, now.minute, now.second, now.microsecond, now.tzinfo)
+
+    bad_pairs = [
+        ("DateTime", not_a_date),
+        ("DateTime", not_a_date_str),
+        ("DateTime", today),
+        ("DateTime", time),
+        ("Date", not_a_date),
+        ("Date", not_a_date_str),
+        ("Date", now),
+        ("Date", time),
+        ("Time", not_a_date),
+        ("Time", not_a_date_str),
+        ("Time", now),
+        ("Time", today),
+    ]
+
+    for type, input in bad_pairs:
+        _test_bad_variables(type, input)
+
+
+def test_datetime_input_object_variable():
+    class DateTimeInput(InputObjectType):
+        date = Date()
+        datetime = DateTime()
+        time = Time()
+
+    class DateTimeOutput(ObjectType):
+        date = Date()
+        datetime = DateTime()
+        time = Time()
+
+    class InputQuery(ObjectType):
+        test = Field(DateTimeOutput, input=DateTimeInput(required=True))
+
+        def resolve_test(self, info, input):
+            return DateTimeOutput(
+                date=input.date, datetime=input.datetime, time=input.time
+            )
+
+    input_schema = Schema(query=InputQuery)
+    query = """
+        query Test($input: DateTimeInput!) {
+            test(input: $input) { date datetime time }
+        }
+    """
+
+    now = datetime.datetime.now().replace(tzinfo=pytz.utc)
+    today = datetime.date.today()
+    time = datetime.time(12, 30, 15)
+    expected = {
+        "date": today.isoformat(),
+        "datetime": now.isoformat(),
+        "time": time.isoformat(),
+    }
+
+    # Python instances supplied as fields of the input object variable
+    result = input_schema.execute(
+        query,
+        variables={"input": {"date": today, "datetime": now, "time": time}},
+    )
+    assert not result.errors
+    assert result.data == {"test": expected}
+
+    # string-formatted values in the same input object variable
+    result = input_schema.execute(
+        query,
+        variables={
+            "input": {
+                "date": today.isoformat(),
+                "datetime": now.isoformat(),
+                "time": time.isoformat(),
+            }
+        },
+    )
+    assert not result.errors
+    assert result.data == {"test": expected}
