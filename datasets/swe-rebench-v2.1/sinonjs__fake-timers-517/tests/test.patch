+"use strict";
+
+const { FakeTimers, assert } = require("./helpers/setup-tests");
+
+describe("issue #516 - not resilient to changes on Intl", function () {
+    it("should successfully install the timer", function () {
+        const originalIntlProperties = Object.getOwnPropertyDescriptors(
+            global.Intl,
+        );
+        for (const key of Object.keys(originalIntlProperties)) {
+            delete global.Intl[key];
+        }
+        try {
+            const clock = FakeTimers.createClock();
+            clock.tick(16);
+        } finally {
+            Object.defineProperties(global.Intl, originalIntlProperties);
+        }
+    });
+
+    it("should keep clock Date usable after the global Date is removed", function () {
+        const originalDate = Object.getOwnPropertyDescriptor(global, "Date");
+        global.Date = undefined;
+        try {
+            const clock = FakeTimers.createClock(0);
+            clock.tick(16);
+            assert.equals(clock.Date.now(), 16);
+            assert.equals(new clock.Date().getTime(), 16);
+        } finally {
+            Object.defineProperty(global, "Date", originalDate);
+        }
+    });
+});
