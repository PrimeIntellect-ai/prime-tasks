+    def test_transform_preserves_device_that_cannot_be_deep_copied(self):
+        """Applying a transform to a QNode keeps the original device, even when the
+        device cannot be deep-copied (as is the case for lightning.kokkos)."""
+        import threading
+
+        uncopyable_dev = qml.device("default.qubit", wires=2)
+        # A device holding a non-picklable resource cannot be deep-copied.
+        uncopyable_dev._uncopyable_resource = threading.Lock()
+
+        @qml.transforms.split_non_commuting
+        @qml.qnode(uncopyable_dev)
+        def circuit():
+            qml.Hadamard(0)
+            return qml.expval(qml.PauliZ(0)), qml.expval(qml.PauliX(0))
+
+        assert circuit.device is uncopyable_dev
+        with uncopyable_dev.tracker:
+            result = circuit()
+        assert qml.math.allclose(result, [0.0, 1.0])
+        assert uncopyable_dev.tracker.totals["executions"] > 0
+
