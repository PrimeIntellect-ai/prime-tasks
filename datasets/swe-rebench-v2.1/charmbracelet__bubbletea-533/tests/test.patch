+
+// heightModel renders a fixed set of lines once it has received a window size.
+type heightModel struct {
+	lines []string
+	ready atomic.Value
+}
+
+func (m *heightModel) Init() Cmd {
+	return nil
+}
+
+func (m *heightModel) Update(msg Msg) (Model, Cmd) {
+	if _, ok := msg.(WindowSizeMsg); ok {
+		m.ready.Store(true)
+	}
+	return m, nil
+}
+
+func (m *heightModel) View() string {
+	if m.ready.Load() == nil {
+		return "waiting"
+	}
+	return strings.Join(m.lines, "\n")
+}
+
+// TestTeaRenderHeight verifies that when the view is taller than the window,
+// the renderer drops lines from the top and keeps the bottom ones.
+func TestTeaRenderHeight(t *testing.T) {
+	var buf bytes.Buffer
+	var in bytes.Buffer
+
+	m := &heightModel{lines: []string{"line1", "line2", "line3", "line4", "line5"}}
+	p := NewProgram(m, WithInput(&in), WithOutput(&buf))
+
+	go func() {
+		p.Send(WindowSizeMsg{Width: 80, Height: 2})
+		for m.ready.Load() == nil {
+			time.Sleep(time.Millisecond)
+		}
+		p.Quit()
+	}()
+
+	if _, err := p.Run(); err != nil {
+		t.Fatal(err)
+	}
+
+	out := buf.String()
+
+	// Lines above the window height should be dropped from the top.
+	for _, dropped := range []string{"line1", "line2", "line3"} {
+		if strings.Contains(out, dropped) {
+			t.Errorf("expected %q to be dropped from the top, but it was rendered:\n%s", dropped, out)
+		}
+	}
+
+	// The bottom lines should still be rendered.
+	for _, kept := range []string{"line4", "line5"} {
+		if !strings.Contains(out, kept) {
+			t.Errorf("expected %q to be rendered, but it was missing:\n%s", kept, out)
+		}
+	}
+}
