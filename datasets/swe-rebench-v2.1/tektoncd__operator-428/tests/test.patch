 }
+
+func TestAppendManifest(t *testing.T) {
+
+	// Case 1: loading a directory appends every resource found under it,
+	// including resources in nested subdirectories, exactly once.
+	var manifest mf.Manifest
+	err := AppendManifest(&manifest, "testdata/kodata/tekton-addon")
+	if err != nil {
+		t.Fatal("failed to read yaml: ", err)
+	}
+
+	if len(manifest.Resources()) != 3 {
+		t.Fatalf("failed to find expected number of resource: %d found, expected 3", len(manifest.Resources()))
+	}
+	resourceNames := map[string]int{}
+	for _, resource := range manifest.Resources() {
+		resourceNames[resource.GetName()]++
+	}
+	for _, name := range []string{"bitbucket-pullreq", "bitbucket-pullreq-0.0.2", "bitbucket-pullreq-no-version"} {
+		if resourceNames[name] != 1 {
+			t.Errorf("expected resource %q exactly once, found %d", name, resourceNames[name])
+		}
+	}
+
+	// Case 2: loading a nested directory appends the resources it contains.
+	var newManifest mf.Manifest
+	err = AppendManifest(&newManifest, "testdata/kodata/tekton-addon/0.0.1")
+	if err != nil {
+		t.Fatal("failed to read yaml: ", err)
+	}
+
+	if len(newManifest.Resources()) != 1 {
+		t.Fatalf("failed to find expected number of resource: %d found, expected 1", len(newManifest.Resources()))
+	}
+
+	// Case 3: resources already present in the manifest are retained when
+	// more resources are appended.
+	var combined mf.Manifest
+	if err := AppendManifest(&combined, "testdata/kodata/tekton-addon/0.0.1"); err != nil {
+		t.Fatal("failed to read yaml: ", err)
+	}
+	if err := AppendManifest(&combined, "testdata/kodata/tekton-addon/0.0.2"); err != nil {
+		t.Fatal("failed to read yaml: ", err)
+	}
+
+	if len(combined.Resources()) != 2 {
+		t.Fatalf("failed to retain existing resources: %d found, expected 2", len(combined.Resources()))
+	}
+	names := map[string]bool{}
+	for _, r := range combined.Resources() {
+		names[r.GetName()] = true
+	}
+	if !names["bitbucket-pullreq"] || !names["bitbucket-pullreq-0.0.2"] {
+		t.Fatalf("expected both the existing and the appended resource, got %v", names)
+	}
+}
