+use darklua_core::{generator::LuaGenerator, rules::Rule};
+
+fn generated_ast(input: &str) -> Option<darklua_core::nodes::Block> {
+    let parser = darklua_core::Parser::default();
+    let mut block = parser.parse(input).expect("input should parse");
+    let resources = darklua_core::Resources::from_memory();
+    resources.write("src/test.lua", input).unwrap();
+    let context = darklua_core::rules::ContextBuilder::new("src/test.lua", &resources, input)
+        .build();
+    let rule = "remove_method_call".parse::<Box<dyn Rule>>().unwrap();
+    rule.process(&mut block, &context).ok()?;
+    let mut generator = darklua_core::generator::TokenBasedLuaGenerator::new(input);
+    generator.write_block(&block);
+    Some(crate::utils::parse_input(&generator.into_string()))
+}
+
+#[test]
+fn rewrites_method_calls_with_identifier_receivers() {
+    let examples = [
+        ("obj:method()", "obj.method(obj)"),
+        ("obj:method(1, 2, 3)", "obj.method(obj, 1, 2, 3)"),
+        ("obj:method'hello'", "obj.method(obj, 'hello')"),
+        (
+            "obj:method{key = 'value'}",
+            "obj.method(obj, {key = 'value'})",
+        ),
+        (
+            "other:func(obj:method())",
+            "other.func(other, obj.method(obj))",
+        ),
+        ("myTable:insert(...)", "myTable.insert(myTable, ...)"),
+    ];
+
+    for (input, expected) in examples {
+        let expected_ast = crate::utils::parse_input(expected);
+        assert_eq!(
+            generated_ast(input),
+            Some(expected_ast),
+            "unexpected result for {input:?}"
+        );
+    }
+}
+
+#[test]
+fn leaves_regular_calls_and_non_identifier_receivers_unchanged() {
+    let examples = [
+        "obj.method()",
+        "obj.method(1, 2, 3)",
+        "obj.field:method()",
+        "obj[key]:method()",
+        "obj():method()",
+        "obj.field.other:method()",
+    ];
+    for input in examples {
+        let expected_ast = crate::utils::parse_input(input);
+        assert_eq!(
+            generated_ast(input),
+            Some(expected_ast),
+            "the rule changed an ineligible call in {input:?}"
+        );
+    }
+}
