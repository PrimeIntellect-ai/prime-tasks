+def test_get_operation_as_str_returns_representation_without_mixin_directive():
+    query_str = format_graphql_str(
+        """
+        query CustomQuery {
+            query2 @mixin(from: ".mixins", import: "TestMixin") {
+                id
+                field1 @mixin(from: ".mixins", import: "TestMixin1") {
+                    fielda
+                }
+                field2 @mixin(from: ".mixins", import: "TestMixin2") {
+                    fieldb
+                }
+            }
+        }
+        """
+    )
+    generator = ResultTypesGenerator(
+        schema=build_ast_schema(parse(SCHEMA_STR)),
+        operation_definition=cast(
+            OperationDefinitionNode, parse(query_str).definitions[0]
+        ),
+        enums_module_name="enums",
+    )
+
+    result = generator.get_operation_as_str()
+
+    assert "@mixin" not in result
+    operation = cast(OperationDefinitionNode, parse(result).definitions[0])
+    assert operation.name and operation.name.value == "CustomQuery"
+    query_fields = {
+        selection.name.value: selection
+        for selection in operation.selection_set.selections
+    }
+    assert set(query_fields) == {"query2"}
+    nested_fields = {
+        selection.name.value: selection
+        for selection in query_fields["query2"].selection_set.selections
+    }
+    assert set(nested_fields) == {"id", "field1", "field2"}
+    assert {
+        selection.name.value
+        for selection in nested_fields["field1"].selection_set.selections
+    } == {"fielda"}
+    assert {
+        selection.name.value
+        for selection in nested_fields["field2"].selection_set.selections
+    } == {"fieldb"}
+
+
+def test_generated_result_object_uses_configured_mixin_behavior():
+    class ConfiguredMixin:
+        def mixin_behavior(self):
+            return f"mixin value: {self.id}"
+
+    query_str = """
+        query CustomQuery {
+            query2 @mixin(from: ".mixins", import: "ConfiguredMixin") {
+                id
+            }
+        }
+    """
+    generator = ResultTypesGenerator(
+        schema=build_ast_schema(parse(SCHEMA_STR)),
+        operation_definition=cast(
+            OperationDefinitionNode, parse(query_str).definitions[0]
+        ),
+        enums_module_name="enums",
+    )
+
+    generated_classes = generator.get_classes()
+    namespace = {
+        "BaseModel": BaseModel,
+        "ConfiguredMixin": ConfiguredMixin,
+        "Field": Field,
+        "List": List,
+        "Optional": Optional,
+    }
+    generated_source = ast.unparse(generated_classes)
+    module = ast.parse(generated_source)
+    exec(
+        compile(module, "<generated-result-types>", "exec"), namespace
+    )
+    for generated_class in generated_classes:
+        generated_type = namespace[generated_class.name]
+        if hasattr(generated_type, "update_forward_refs"):
+            generated_type.update_forward_refs(**namespace)
+
+    result = namespace["CustomQuery"](query2=[{"id": "returned"}])
+
+    assert result.query2[0].mixin_behavior() == "mixin value: returned"
