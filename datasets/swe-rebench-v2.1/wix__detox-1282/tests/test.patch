+describe('detox init', () => {
+  let originalCwd;
+  let workDir;
+
+  beforeEach(() => {
+    jest.mock('../../utils/logger', () => {
+      const logger = { info: () => {}, warn: () => {}, error: () => {}, debug: () => {}, verbose: () => {} };
+      logger.child = () => logger;
+      return logger;
+    });
+    originalCwd = process.cwd();
+    workDir = require('fs').mkdtempSync(require('path').join(require('os').tmpdir(), 'detox-init-'));
+    require('fs').writeFileSync(
+      require('path').join(workDir, 'package.json'),
+      JSON.stringify({ name: 'my-app', version: '1.0.0', scripts: { start: 'node index.js' } }, null, 2)
+    );
+    process.chdir(workDir);
+  });
+
+  afterEach(() => {
+    process.chdir(originalCwd);
+    require('fs').rmSync(workDir, { recursive: true, force: true });
+  });
+
+  it(`leaves package.json ending with a newline and still records the runner`, async () => {
+    const init = require('../../../local-cli/init');
+    await init.handler({ runner: 'mocha' });
+
+    const content = require('fs').readFileSync(require('path').join(workDir, 'package.json'), 'utf8');
+    expect(content.endsWith('\n')).toBe(true);
+
+    const json = JSON.parse(content);
+    expect(json.name).toBe('my-app');
+    expect(json.detox['test-runner']).toBe('mocha');
+  });
+});
