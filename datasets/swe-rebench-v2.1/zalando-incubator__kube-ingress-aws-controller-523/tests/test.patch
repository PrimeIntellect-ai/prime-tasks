+}
+
+func TestUpdateStackTargetAccessMode(t *testing.T) {
+	for _, test := range []struct {
+		mode       string
+		targetType *cf.StringExpr
+	}{
+		{mode: "HostPort", targetType: cf.String("instance")},
+		{mode: "AWSCNI", targetType: cf.String("ip")},
+		{mode: "Legacy", targetType: nil},
+	} {
+		t.Run(test.mode, func(t *testing.T) {
+			cfClient := &templateCapturingCloudFormationClient{}
+			a := &Adapter{
+				cloudformation: cfClient,
+				TargetCNI:      &TargetCNIconfig{},
+				manifest: &manifest{
+					clusterID: "cluster-id",
+					vpcID:     "vpc-id",
+				},
+			}
+			a.WithTargetAccessMode(test.mode)
+			_, err := a.UpdateStack("stack-name", map[string]time.Time{}, "internet-facing", "sg-1", "", "ELBSecurityPolicy-2016-08", "ipv4", "", nil, LoadBalancerTypeApplication, true)
+			require.NoError(t, err)
+
+			var template *cf.Template
+			require.NoError(t, json.Unmarshal([]byte(cfClient.templateBody), &template))
+			tg, ok := template.Resources["TG"].Properties.(*cf.ElasticLoadBalancingV2TargetGroup)
+			require.True(t, ok, "couldn't convert resource to ElasticLoadBalancingV2TargetGroup")
+			assert.Equal(t, test.targetType, tg.TargetType)
+		})
+	}
+}
+
+func TestTargetAccessModeFlagValues(t *testing.T) {
+	for _, mode := range []string{"HostPort", "AWSCNI", "Legacy"} {
+		t.Run(mode, func(t *testing.T) {
+			cmd := exec.Command("go", "run", "..", "--target-access-mode="+mode,
+				"--target-cni-namespace=ingress", "--target-cni-pod-labelselector=app=controller", "--version")
+			output, err := cmd.CombinedOutput()
+			assert.NoError(t, err, "CLI rejected %q: %s", mode, output)
+		})
+	}
+
+	t.Run("rejects other values", func(t *testing.T) {
+		cmd := exec.Command("go", "run", "..", "--target-access-mode=Other", "--version")
+		output, err := cmd.CombinedOutput()
+		assert.Error(t, err, "CLI unexpectedly accepted an unsupported mode: %s", output)
 	})
 }
