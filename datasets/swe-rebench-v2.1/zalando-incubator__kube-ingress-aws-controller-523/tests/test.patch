+// templateCapturingCloudFormationClient records the template body passed to CreateStack.
+type templateCapturingCloudFormationClient struct {
+	cloudformationiface.CloudFormationAPI
+	templateBody string
+}
+
+func (m *templateCapturingCloudFormationClient) CreateStack(params *awscloudformation.CreateStackInput) (*awscloudformation.CreateStackOutput, error) {
+	m.templateBody = aws.StringValue(params.TemplateBody)
+	return &awscloudformation.CreateStackOutput{StackId: aws.String("stack-id")}, nil
+}
+
+func (m *templateCapturingCloudFormationClient) UpdateStack(params *awscloudformation.UpdateStackInput) (*awscloudformation.UpdateStackOutput, error) {
+	m.templateBody = aws.StringValue(params.TemplateBody)
+	return &awscloudformation.UpdateStackOutput{StackId: aws.String("stack-id")}, nil
+}
+
+// targetGroupForAccessMode builds an Adapter configured with the given target access
+// mode and returns the target group resource from the CloudFormation template it
+// generates. It only observes the publicly produced template, not internal fields.
+func targetGroupForAccessMode(t *testing.T, mode string) *cf.ElasticLoadBalancingV2TargetGroup {
+	t.Helper()
+
+	cfClient := &templateCapturingCloudFormationClient{}
+	a := &Adapter{
+		cloudformation: cfClient,
+		TargetCNI:      &TargetCNIconfig{},
+		manifest: &manifest{
+			clusterID: "cluster-id",
+			vpcID:     "vpc-id",
+		},
+	}
+	a = a.WithTargetAccessMode(mode)
+
+	_, err := a.CreateStack(nil, "internet-facing", "sg-1", "", "ELBSecurityPolicy-2016-08", "ipv4", "", nil, LoadBalancerTypeApplication, true)
+	require.NoError(t, err)
+
+	var template *cf.Template
+	require.NoError(t, json.Unmarshal([]byte(cfClient.templateBody), &template))
+
+	tg, ok := template.Resources["TG"].Properties.(*cf.ElasticLoadBalancingV2TargetGroup)
+	require.True(t, ok, "couldn't convert resource to ElasticLoadBalancingV2TargetGroup")
+	return tg
+}
+
 func TestWithTargetAccessMode(t *testing.T) {
-	t.Run("WithTargetAccessMode enables AWS CNI mode", func(t *testing.T) {
