+def test_get_file_path_stat_encoding_annotations() -> None:
+    annotations = get_type_hints(FileResponse._get_file_path_stat_encoding)
+
+    assert annotations["accept_encoding"] is str
+    assert annotations["return"] == Tuple[Path, os.stat_result, Optional[str]]
+
+
+def test_get_file_path_stat_encoding_prefers_brotli(tmp_path: Path) -> None:
+    txt = tmp_path / "hello.txt"
+    txt.write_bytes(b"hello")
+    gz = tmp_path / "hello.txt.gz"
+    gz.write_bytes(b"gzip-data")
+    br = tmp_path / "hello.txt.br"
+    br.write_bytes(b"brotli-data")
+
+    file_sender = FileResponse(txt)
+
+    path, st, encoding = file_sender._get_file_path_stat_encoding("gzip, br")
+    assert path == br
+    assert encoding == "br"
+    assert st.st_size == len(b"brotli-data")
+
+
+def test_get_file_path_stat_encoding_uses_gzip_when_brotli_missing(
+    tmp_path: Path,
+) -> None:
+    txt = tmp_path / "hello.txt"
+    txt.write_bytes(b"hello")
+    gz = tmp_path / "hello.txt.gz"
+    gz.write_bytes(b"gzip-data")
+
+    file_sender = FileResponse(txt)
+
+    path, st, encoding = file_sender._get_file_path_stat_encoding("gzip, br")
+    assert path == gz
+    assert encoding == "gzip"
+    assert st.st_size == len(b"gzip-data")
+
+
+def test_get_file_path_stat_encoding_gzip(tmp_path: Path) -> None:
+    txt = tmp_path / "hello.txt"
+    txt.write_bytes(b"hello")
+    gz = tmp_path / "hello.txt.gz"
+    gz.write_bytes(b"gzip-data")
+    br = tmp_path / "hello.txt.br"
+    br.write_bytes(b"brotli-data")
+
+    file_sender = FileResponse(txt)
+
+    path, st, encoding = file_sender._get_file_path_stat_encoding("gzip")
+    assert path == gz
+    assert encoding == "gzip"
+    assert st.st_size == len(b"gzip-data")
+
+
+def test_get_file_path_stat_encoding_uncompressed(tmp_path: Path) -> None:
+    txt = tmp_path / "hello.txt"
+    txt.write_bytes(b"hello")
+    gz = tmp_path / "hello.txt.gz"
+    gz.write_bytes(b"gzip-data")
+    br = tmp_path / "hello.txt.br"
+    br.write_bytes(b"brotli-data")
+
+    file_sender = FileResponse(txt)
+
+    path, st, encoding = file_sender._get_file_path_stat_encoding("")
+    assert path == txt
+    assert encoding is None
+    assert st.st_size == len(b"hello")
