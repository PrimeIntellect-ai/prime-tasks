+    def test_not_recorded(self):
+        prob = ParaboloidProblem()
+
+        rec = om.SqliteRecorder('test_not_recorded.db')
+
+        # record all inputs/outputs for problem, but set residuals to False
+        prob.add_recorder(rec)
+        prob.recording_options['record_residuals'] = False
+
+        prob.setup()
+        prob.run_model()
+        prob.record('final')
+
+        cases = om.CaseReader(prob.get_outputs_dir() / 'test_not_recorded.db')
+        prob_case = cases.get_case(cases.list_cases('problem', out_stream=None)[-1])
+
+        # list outputs with residuals requested even though they were not recorded;
+        # this should not raise and should still return the information that was recorded
+        stream = io.StringIO()
+        outputs = prob_case.list_outputs(
+            residuals=True,
+            units=True,
+            shape=True,
+            bounds=True,
+            scaling=True,
+            desc=True,
+            print_arrays=True,
+            print_tags=True,
+            list_autoivcs=True,
+            print_min=True,
+            print_max=True,
+            out_stream=stream,
+            return_format='dict',
+        )
+
+        # information that was recorded is still collected and returned
+        self.assertIn('comp.f_xy', outputs)
+
+        # The available output row remains visible alongside the missing-residuals marker.
+        self.assertIn('f_xy', stream.getvalue())
+        self.assertIn('Not Recorded', stream.getvalue())
+
+        # A tolerance alone also must not raise when residuals were not recorded.
+        prob_case.list_outputs(residuals_tol=1e-6, out_stream=None)
+
