+
+test('Reports duplicate colors with matching totals', async t => {
+  const actual = await analyzer('a { color: #000; background-color: black; }')
+  const duplicates = actual.values.colors.duplicates
+
+  t.is(duplicates.unique.length, 1)
+  t.is(duplicates.unique[0].count, 2)
+  t.is(duplicates.total, duplicates.unique.length)
+  t.is(duplicates.totalUnique, duplicates.unique.length)
+})
