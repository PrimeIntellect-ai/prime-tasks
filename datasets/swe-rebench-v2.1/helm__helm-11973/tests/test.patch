+func TestLintQuietFlagDisplaysErrors(t *testing.T) {
+	_, output, err := executeActionCommand("lint --quiet thischartdoesntexist/")
+	if err == nil {
+		t.Fatal("expected linting a non-existent chart to fail")
+	}
+	if !strings.Contains(strings.ToLower(output), "chart.yaml") {
+		t.Errorf("expected quiet lint output to include the chart error, got %q", output)
+	}
