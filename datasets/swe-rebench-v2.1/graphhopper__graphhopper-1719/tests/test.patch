+    @Test
+    public void testShortcutRecordSizeWithoutDistance() {
+        // without the distance field a node-based shortcut occupies 28 bytes and an edge-based shortcut 36 bytes.
+        // Allocation slack is small compared to the size of many shortcuts, so the per-shortcut size is observable
+        int count = 10000;
+        long slack = 4096;
+        long nodeBasedIncrease = shortcutCapacityIncrease(false, count);
+        assertEquals("node-based shortcut storage: " + nodeBasedIncrease, 28L * count, nodeBasedIncrease, slack);
+
+        long edgeBasedIncrease = shortcutCapacityIncrease(true, count);
+        assertEquals("edge-based shortcut storage: " + edgeBasedIncrease, 36L * count, edgeBasedIncrease, slack);
+    }
+
+    private long shortcutCapacityIncrease(boolean edgeBased, int shortcutCount) {
+        Weighting weighting = new FastestWeighting(carEncoder);
+        CHProfile profile = edgeBased
+                ? CHProfile.edgeBased(weighting, INFINITE_U_TURN_COSTS)
+                : CHProfile.nodeBased(weighting);
+        GraphHopperStorage storage = new GraphHopperStorage(Collections.singletonList(profile), new RAMDirectory(),
+                encodingManager, false, new GraphExtension.NoOpExtension());
+        storage.setSegmentSize(4);
+        storage.create(0);
+        CHGraph chGraph = storage.getCHGraph();
+        chGraph.edge(0, 1).setDistance(1);
+        chGraph.edge(1, 2).setDistance(1);
+        storage.freeze();
+
+        long capacityBeforeShortcut = storage.getCapacity();
+        for (int i = 0; i < shortcutCount; i++) {
+            if (edgeBased) {
+                chGraph.shortcutEdgeBased(0, 2, PrepareEncoder.getScFwdDir(), 2, 0, 1, 0, 1);
+            } else {
+                chGraph.shortcut(0, 2, PrepareEncoder.getScFwdDir(), 2, 0, 1);
+            }
+        }
+        long capacityIncrease = storage.getCapacity() - capacityBeforeShortcut;
+        storage.close();
+        return capacityIncrease;
+    }
+
