+package com.cronutils.model.definition;
+
+import com.cronutils.descriptor.CronDescriptor;
+import com.cronutils.model.Cron;
+import com.cronutils.model.CronType;
+import com.cronutils.parser.CronParser;
+import org.junit.Assert;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.junit.runners.Parameterized;
+
+import java.util.Locale;
+
+@RunWith(Parameterized.class)
+public class Issue343Test {
+
+    @Parameterized.Parameters(name = "{0}")
+    public static Object[][] expressions() {
+        // Expressions and descriptions from the Spring CronSequenceGenerator documentation example.
+        return new Object[][]{
+                {"0 0 * * * *", "every hour"},
+                {"*/10 * * * * *", "every 10 seconds"},
+                {"0 0 8-10 * * *", "every hour between 8 and 10"},
+                {"0 0 6,19 * * *", "at 6 and 19 hours"},
+                {"0 0/30 8-10 * * *", "every 30 minutes every hour between 8 and 10"},
+                {"0 0 9-17 * * MON-FRI", "every hour between 9 and 17 every day between Monday and Friday"},
+                {"0 0 0 25 12 ?", "at 00:00 at 25 day at December month"}
+        };
+    }
+
+    private final String expression;
+    private final String expectedDescription;
+
+    public Issue343Test(String expression, String expectedDescription) {
+        this.expression = expression;
+        this.expectedDescription = expectedDescription;
+    }
+
+    @Test
+    public void testSpringCronExpressions() {
+        CronParser parser = new CronParser(CronDefinitionBuilder.instanceDefinitionFor(CronType.SPRING));
+        Cron parsed = parser.parse(expression);
+
+        Assert.assertNotNull(parsed);
+        Assert.assertEquals(expectedDescription, CronDescriptor.instance(Locale.ENGLISH).describe(parsed));
+    }
+}
