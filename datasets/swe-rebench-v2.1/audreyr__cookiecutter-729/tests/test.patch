+@pytest.mark.usefixtures('clean_system', 'remove_additional_folders')
+def test_empty_hooks():
+
+    # OSError.errno=8 is not thrown on Windows when the script is emtpy
+    # because it always runs through shell instead of needing a shebang.
+
+    if not sys.platform.startswith('win'):
+        with pytest.raises(Exception) as excinfo:
+            generate.generate_files(
+                context={
+                    'cookiecutter': {'shellhooks': 'shellhooks'}
+                },
+                repo_dir='tests/test-shellhooks-empty/',
+                overwrite_if_exists=True
+            )
+        diagnostic = str(excinfo.value).strip()
+        assert diagnostic
+        raw_exec_error = r"""^\[Errno {}\] {}: (?:'.*'|".*")$""".format(
+            errno.ENOEXEC, re.escape(os.strerror(errno.ENOEXEC))
+        )
+        assert not re.match(raw_exec_error, diagnostic)
+        assert 'traceback' not in diagnostic.lower()
+
+
+@pytest.mark.usefixtures('clean_system')
+def test_empty_post_generation_hook_reports_diagnostic(tmp_path):
+    if not sys.platform.startswith('win'):
+        repo_dir = str(tmp_path / 'empty-post-hook')
+        make_test_repo(repo_dir)
+        post_hook = os.path.join(repo_dir, 'hooks', 'post_gen_project.sh')
+        with open(post_hook, 'w'):
+            pass
+
+        with pytest.raises(Exception) as excinfo:
+            generate.generate_files(
+                context={'cookiecutter': {'shellhooks': 'shellhooks'}},
+                repo_dir=repo_dir,
+                output_dir=repo_dir
+            )
+
+        diagnostic = str(excinfo.value).strip()
+        assert diagnostic
+        raw_exec_error = r"""^\[Errno {}\] {}: (?:'.*'|".*")$""".format(
+            errno.ENOEXEC, re.escape(os.strerror(errno.ENOEXEC))
+        )
+        assert not re.match(raw_exec_error, diagnostic)
+        assert 'traceback' not in diagnostic.lower()
+
+
