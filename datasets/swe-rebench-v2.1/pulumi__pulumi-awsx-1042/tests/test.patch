+import { calculateFargateMemoryAndCPU } from "./fargateMemoryAndCpu";
+
+describe("max vcpu and memory", () => {
+  it("can request valid exact values", async () => {
+    const memCpu = calculateFargateMemoryAndCPU([
+      {
+        cpu: 8192, // 8 vcpu * 1024
+        memory: 20480, // 20 GB * 1024
+      },
+    ]);
+    expect(memCpu.cpu).toEqual("8192");
+    expect(memCpu.memory).toEqual("20480");
+  });
+
+  it("can request valid approximate values", async () => {
+    const memCpu = calculateFargateMemoryAndCPU([
+      {
+        cpu: 8000, // will be rounded up to 8 vcpu * 1024
+        memory: 20000, // will be rounded up to 20 GB = 20,480 MB.
+      },
+    ]);
+    expect(memCpu.cpu).toEqual("8192");
+    expect(memCpu.memory).toEqual("20480");
+  });
+
+  it("aggregates the requests of multiple containers", async () => {
+    const memCpu = calculateFargateMemoryAndCPU([
+      { cpu: 4096, memory: 8192 },
+      { cpu: 4096, memory: 8192 },
+    ]);
+    expect(memCpu.cpu).toEqual("8192");
+    expect(memCpu.memory).toEqual("16384");
+  });
+
+  it("caps requests that exceed the maximum supported limits", async () => {
+    const memCpu = calculateFargateMemoryAndCPU([{ cpu: 32768, memory: 32768 }]);
+    expect(memCpu.cpu).toEqual("16384");
+  });
+});
