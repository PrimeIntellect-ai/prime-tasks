+def test_issue84_ExportingButtons_as_ContextButtonConfiguration():
+    as_dict = {
+        'contextButton': {
+            'enabled': False
+        },
+        'exportButton': {
+            'text': "Download",
+            'menuItems': ['downloadPNG']
+        }
+    }
+    instance = cls3.from_dict(as_dict)
+    for key in as_dict:
+        assert key in instance
+        assert does_kwarg_value_match_result(as_dict[key],
+                                             instance.get(key)) is True
+
+    # The reported bug is that the button configuration - including its
+    # ``menuItems`` - is dropped from the resulting export.
+    as_json = instance.to_json()
+    if isinstance(as_json, bytes):
+        as_json = as_json.decode('utf-8')
+    exported = json.loads(as_json)
+    assert exported['exportButton']['menuItems'] == ['downloadPNG']
+    assert exported['exportButton']['text'] == 'Download'
+    assert exported['contextButton']['enabled'] is False
+
+
+def test_issue84_Chart_to_json_preserves_custom_button_configuration():
+    options = {
+        'exporting': {
+            'buttons': {
+                'contextButton': {'enabled': False},
+                'exportButton': {
+                    'text': 'Download',
+                    'menuItems': ['downloadPNG']
+                }
+            }
+        }
+    }
+    as_json = Chart(options=options).to_json()
+    if isinstance(as_json, bytes):
+        as_json = as_json.decode('utf-8')
+    exported = json.loads(as_json)
+    buttons = exported['userOptions']['exporting']['buttons']
+
+    assert buttons['contextButton']['enabled'] is False
+    assert buttons['exportButton']['text'] == 'Download'
+    assert buttons['exportButton']['menuItems'] == ['downloadPNG']
