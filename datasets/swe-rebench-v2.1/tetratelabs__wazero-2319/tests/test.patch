+func TestFileSetAppendKeepsNonblockingOperationsWorking(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("nonblocking writes to regular files are not supported on Windows")
+	}
+
+	tmpDir := t.TempDir()
+	filePath := path.Join(tmpDir, "file")
+	require.NoError(t, os.WriteFile(filePath, []byte("original"), 0o600))
+
+	// Closing the first descriptor lets SetAppend's reopen reuse its number.
+	f0 := requireOpenFile(t, filePath, experimentalsys.O_RDWR, 0o600)
+	f1 := requireOpenFile(t, filePath, experimentalsys.O_RDWR, 0o600)
+	require.EqualErrno(t, 0, f0.Close())
+	defer f1.Close()
+
+	f1WithNonblock, ok := f1.(fsapi.File)
+	require.True(t, ok)
+	if errno := f1WithNonblock.SetNonblock(true); errno == experimentalsys.ENOSYS {
+		t.Skip("nonblocking file operations are not supported")
+	} else {
+		require.EqualErrno(t, 0, errno)
+	}
+
+	require.EqualErrno(t, 0, f1.SetAppend(true))
+	readContents := make([]byte, len("original"))
+	readN, errno := f1.Read(readContents)
+	require.EqualErrno(t, 0, errno)
+	require.Equal(t, len(readContents), readN)
+	require.Equal(t, "original", string(readContents))
+
+	n, errno := f1.Write([]byte("append"))
+	require.EqualErrno(t, 0, errno)
+	require.Equal(t, 6, n)
+
+	contents, err := os.ReadFile(filePath)
+	require.NoError(t, err)
+	require.Equal(t, "originalappend", string(contents))
+}
+
+func TestOSFileSetAppendRejectsSwappedPathAndLeavesOtherFileIntact(t *testing.T) {
+	tmpDir := t.TempDir()
+	filePath := path.Join(tmpDir, "file")
+
+	f := requireOpenFile(t, filePath, experimentalsys.O_RDWR|experimentalsys.O_CREAT, 0o600)
+	defer f.Close()
+
+	require.NoError(t, os.Remove(filePath))
+	require.NoError(t, os.WriteFile(filePath, []byte("replacement"), 0o600))
+
+	// Reopening must reject a different file now occupying the original path.
+	require.NotEqual(t, experimentalsys.Errno(0), f.SetAppend(true))
+	_, _ = f.Write([]byte("original handle"))
+
+	contents, err := os.ReadFile(filePath)
+	require.NoError(t, err)
+	require.Equal(t, "replacement", string(contents))
+}
