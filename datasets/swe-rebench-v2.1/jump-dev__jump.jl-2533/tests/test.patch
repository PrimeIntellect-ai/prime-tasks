     end
+    @testset "Broadcast" begin
+        foo(x, y) = x + y
+        foo_b(x, y) = foo.(x, y)
+        bar(x, y) = (foo.(x, y) .+ x) .^ 2
+        a = [5.0 6.0; 7.0 8.0]
+        A = DenseAxisArray(a, [:a, :b], [:a, :b])
+        b = a .+ 1
+        B = A .+ 1
+        labels = [:a, :b]
+        @test [B[i, j] for i in labels, j in labels] == b
+        C = foo_b(A, B)
+        @test C isa DenseAxisArray
+        @test [C[i, j] for i in labels, j in labels] == foo_b(a, b)
+        D = bar(A, B)
+        @test D isa DenseAxisArray
+        @test [D[i, j] for i in labels, j in labels] == bar(a, b)
+    end
 end
