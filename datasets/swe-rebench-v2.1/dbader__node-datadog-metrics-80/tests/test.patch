diff --git a/test/loggers_tests.js b/test/loggers_tests.js
index 961b16d..0dcab15 100644
--- a/test/loggers_tests.js
+++ b/test/loggers_tests.js
@@ -118,4 +118,59 @@ describe('BufferedMetricsLogger', function() {
         });
         l.aggregator.defaultTags.should.deep.equal(['one', 'two']);
     });
+
+    it('should allow setting apiHost/site', function() {
+        var l = new BufferedMetricsLogger({
+            apiKey: 'abc123',
+            apiHost: 'datadoghq.eu'
+        });
+        l.reporter.should.have.property('apiHost', 'datadoghq.eu');
+    });
+
+    it('should allow setting apiHost/site with "app.*" URLs', function() {
+        var l = new BufferedMetricsLogger({
+            apiKey: 'abc123',
+            apiHost: 'app.datadoghq.eu'
+        });
+        l.reporter.should.have.property('apiHost', 'datadoghq.eu');
+    });
+
+    it('should allow setting apiHost/site directly on the reporter', function() {
+        var reporter = new reporters.DataDogReporter('abc123', 'appkey', 'app.datadoghq.eu');
+        reporter.should.have.property('apiHost', 'datadoghq.eu');
+    });
+
+    it('should submit metrics to the configured site', function(done) {
+        var crossFetch = require('cross-fetch');
+        var originalFetch = crossFetch.fetch;
+        var requestedUrl = null;
+        crossFetch.fetch = function(url) {
+            requestedUrl = url;
+            return Promise.resolve({
+                status: 202,
+                headers: { forEach: function() {} },
+                text: function() { return Promise.resolve('{}'); },
+                arrayBuffer: function() { return Promise.resolve(new ArrayBuffer(0)); }
+            });
+        };
+
+        var l = new BufferedMetricsLogger({
+            apiKey: 'abc123',
+            apiHost: 'app.datadoghq.eu'
+        });
+
+        l.reporter.report([{ type: 'gauge', metric: 'test.metric', points: [[1, 1]] }], function() {
+            crossFetch.fetch = originalFetch;
+            try {
+                requestedUrl.should.contain('datadoghq.eu');
+                requestedUrl.should.not.contain('datadoghq.com');
+                done();
+            } catch (err) {
+                done(err);
+            }
+        }, function(err) {
+            crossFetch.fetch = originalFetch;
+            done(err);
+        });
+    });
 });
