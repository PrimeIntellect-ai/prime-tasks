@@ -0,0 +1,90 @@
+package day40
+
+import (
+	"testing"
+	"time"
+)
+
+var testcases = []struct {
+	input    []int
+	expected int
+}{
+	{[]int{6, 1, 3, 3, 3, 6, 6}, 1},
+	{[]int{13, 19, 13, 13}, 19},
+}
+
+func TestFindOnce(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		if result := FindOnce(tc.input); tc.expected != result {
+			t.Errorf("Expected %v got %v", tc.expected, result)
+		}
+	}
+}
+
+func BenchmarkFindOnce(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			FindOnce(tc.input)
+		}
+	}
+}
+
+// buildTriples returns a slice in which every value in [0, n) occurs exactly
+// three times, followed by a single value that occurs once.
+func buildTriples(n int) []int {
+	nums := make([]int, 0, n*3+1)
+	for i := 0; i < n; i++ {
+		nums = append(nums, i, i, i)
+	}
+	return append(nums, -1)
+}
+
+// benchSink keeps the result of the benchmarked call observable so the
+// compiler cannot eliminate it.
+var benchSink int
+
+// allocBytesPerOp reports the average number of heap bytes allocated per call
+// to FindOnce for the given input.
+func allocBytesPerOp(nums []int) int64 {
+	res := testing.Benchmark(func(b *testing.B) {
+		var s int
+		for i := 0; i < b.N; i++ {
+			s += FindOnce(nums)
+		}
+		benchSink = s
+	})
+	return res.AllocedBytesPerOp()
+}
+
+// TestFindOnceConstantSpace checks the O(1) extra space requirement: the
+// memory FindOnce allocates must not grow with the size of the input.
+func TestFindOnceConstantSpace(t *testing.T) {
+	small := buildTriples(100)
+	large := buildTriples(50000)
+
+	smallBytes := allocBytesPerOp(small)
+	largeBytes := allocBytesPerOp(large)
+
+	if largeBytes > smallBytes+4096 {
+		t.Errorf("FindOnce extra space grows with input size: %d bytes for %d elements, %d bytes for %d elements",
+			smallBytes, len(small), largeBytes, len(large))
+	}
+}
+
+// TestFindOnceLinearTime checks the O(N) time requirement: FindOnce must
+// finish quickly on a large input.
+func TestFindOnceLinearTime(t *testing.T) {
+	nums := buildTriples(100000)
+
+	done := make(chan int, 1)
+	go func() {
+		done <- FindOnce(nums)
+	}()
+
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Error("FindOnce did not finish within 10s on a large input; expected O(N) time")
+	}
+}
