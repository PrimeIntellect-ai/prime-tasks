+
+
+def test_context(helpers):
+    crate = ROCrate()
+    base_context = f"{helpers.PROFILE}/context"
+    wfrun_ctx = "https://w3id.org/ro/terms/workflow-run"
+
+    def context_entries():
+        context = crate.metadata.generate()["@context"]
+        return context if isinstance(context, (list, tuple)) else [context]
+
+    assert base_context in context_entries()
+    crate.metadata.extra_contexts.append(wfrun_ctx)
+    entries = context_entries()
+    assert base_context in entries
+    assert wfrun_ctx in entries
+
+    k, v = "runsOn", "https://w3id.org/ro/terms/test#runsOn"
+    crate.metadata.extra_terms[k] = v
+    entries = context_entries()
+    assert base_context in entries
+    assert wfrun_ctx in entries
+    assert any(isinstance(entry, dict) and entry.get(k) == v for entry in entries)
