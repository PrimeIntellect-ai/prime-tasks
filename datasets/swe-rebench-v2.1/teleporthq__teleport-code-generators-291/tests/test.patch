+describe('project generation with a template collision', () => {
+  it('replaces a colliding component file and retains unrelated template files', async () => {
+    const template = emptyFolder('root')
+    const testFolder = emptyFolder('test')
+    const componentsFolder = emptyFolder('components')
+    componentsFolder.files.push(
+      { name: 'mock', fileType: 'js', content: 'template component' },
+      { name: 'keep', fileType: 'js', content: 'template-only file' }
+    )
+    testFolder.subFolders.push(componentsFolder)
+    template.subFolders.push(testFolder)
+
+    const result = await createProjectGenerator(firstStrategy).generateProject(projectUIDL, template)
+    const generatedComponents = result.subFolders
+      .find((folder) => folder.name === 'test')!
+      .subFolders.find((folder) => folder.name === 'components')!
+
+    const collidingFiles = generatedComponents.files.filter(
+      (file) => file.name === 'mock' && file.fileType === 'js'
+    )
+    expect(collidingFiles).toHaveLength(1)
+    expect(collidingFiles[0].content).toBe('const mock = 0;')
+    expect(generatedComponents.files).toContainEqual({
+      name: 'keep',
+      fileType: 'js',
+      content: 'template-only file',
+    })
+  })
+})
