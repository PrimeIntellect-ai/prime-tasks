+function test_MA_Zero_objective()
+    model = Model()
+    result = @objective(model, Min, sum(i for i in 1:0))
+    @test result isa Number && iszero(result)
+    return
+end
+
+function test_MA_Zero_expression()
+    model = Model()
+    result = @expression(model, sum(i for i in 1:0))
+    @test result isa Number && iszero(result)
+    @expression(model, expr[j = 1:2], sum(i for i in j:0))
+    @test expr == [0, 0]
+    @test all(x -> x isa Number && iszero(x), expr)
+    return
+end
