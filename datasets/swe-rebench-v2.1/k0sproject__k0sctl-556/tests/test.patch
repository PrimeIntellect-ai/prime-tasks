+
+func TestHostInstallFlagQuoteValidation(t *testing.T) {
+	t.Run("installFlags", func(t *testing.T) {
+		h := Host{
+			Role:         "worker",
+			InstallFlags: []string{"--foo"},
+		}
+		require.NoError(t, h.Validate())
+
+		h.InstallFlags = []string{`--foo=""`, `--bar=''`}
+		require.NoError(t, h.Validate())
+
+		for _, tc := range []struct {
+			name  string
+			flags []string
+		}{
+			{name: "unbalanced double quote", flags: []string{`--foo="`}},
+			{name: "unbalanced single quote", flags: []string{"--bar='"}},
+		} {
+			t.Run(tc.name, func(t *testing.T) {
+				h.InstallFlags = tc.flags
+				err := h.Validate()
+				require.Error(t, err)
+				require.NotEmpty(t, err.Error())
+			})
+		}
+	})
+}
