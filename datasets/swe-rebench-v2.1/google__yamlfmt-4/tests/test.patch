+package basic_test
+
+import (
+"strings"
+"testing"
+
+"github.com/google/yamlfmt"
+"github.com/google/yamlfmt/formatters/basic"
+)
+
+// newBasicFormatter returns a basic formatter configured with the standard
+// settings, obtained through the public factory API. This avoids depending on
+// any particular internal representation of the formatter's configuration.
+func newBasicFormatter(t *testing.T) yamlfmt.Formatter {
+t.Helper()
+factory := &basic.BasicFormatterFactory{}
+return factory.NewDefault()
+}
+
+func TestFormatterRetainsComments(t *testing.T) {
+f := newBasicFormatter(t)
+
+yaml := `x: "y" # foo comment`
+
+s, err := f.Format([]byte(yaml))
+if err != nil {
+t.Fatalf("expected formatting to pass, returned error: %v", err)
+}
+if !strings.Contains(string(s), "foo comment") {
+t.Fatalf("comment was stripped away, got:\n%s", s)
+}
+}
+
+func TestFormatterRetainsStandaloneComment(t *testing.T) {
+f := newBasicFormatter(t)
+
+yaml := "# a standalone comment\nx: \"y\"\n"
+
+s, err := f.Format([]byte(yaml))
+if err != nil {
+t.Fatalf("expected formatting to pass, returned error: %v", err)
+}
+if !strings.Contains(string(s), "a standalone comment") {
+t.Fatalf("standalone comment was stripped away, got:\n%s", s)
+}
+}
