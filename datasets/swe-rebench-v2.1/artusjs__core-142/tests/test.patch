-import { Container } from '@artus/injection';
+import { Container, ExecutionContainer, Inject, Injectable, ScopeEnum } from '@artus/injection';
 import { LoaderFactory } from '../src';
 import { createApp } from './fixtures/custom_instance/index';
 import Custom from './fixtures/custom_instance/custom';
 
+@Injectable()
+class SingletonContainerConsumer {
+  @Inject()
+  public container: Container;
+}
+
+@Injectable({ scope: ScopeEnum.EXECUTION })
+class ExecutionContainerConsumer {
+  @Inject()
+  public executionContainer: ExecutionContainer;
+}
+
 describe('test/loader.test.ts', () => {
   describe('module with ts', () => {
     it('should load module testServiceA.ts and testServiceB.ts', async () => {
@@ -63,7 +75,45 @@ describe('test/loader.test.ts', () => {
   describe('custom instance', () => {
     it('should not overide custom instance', async () => {
       const app = await createApp();
-      expect(app.getContainer().get(Custom).getName()).toBe('foo');
+      expect((app as any).container.get(Custom).getName()).toBe('foo');
+    });
+  });
+  describe('container access', () => {
+    it('should expose container property and not the removed getContainer method', async () => {
+      const app = await createApp();
+      expect((app as any).container).toBeDefined();
+      expect((app as any).getContainer).toBeUndefined();
+    });
+
+    it('should expose the execution container through the context property', async () => {
+      const app = await createApp();
+      const input = { __omitContextContainer: true } as any;
+      const ctx = await app.trigger.initContext(input);
+      expect(ctx.container).toBeInstanceOf(ExecutionContainer);
+    });
+
+    it('should inject the application container into an IoC singleton', async () => {
+      const app = await createApp();
+      try {
+        (app as any).container.get(Container);
+      } catch {
+        (app as any).container.set({ id: Container, value: (app as any).container });
+      }
+      (app as any).container.set({ type: SingletonContainerConsumer });
+
+      expect((app as any).container.get(SingletonContainerConsumer).container).toBe((app as any).container);
+    });
+
+    it('should inject each context execution container into execution-scoped classes', async () => {
+      const app = await createApp();
+      (app as any).container.set({ type: ExecutionContainerConsumer });
+      const firstContext = await app.trigger.initContext();
+      const secondContext = await app.trigger.initContext();
+      const firstConsumer = firstContext.container.get(ExecutionContainerConsumer);
+      const secondConsumer = secondContext.container.get(ExecutionContainerConsumer);
+
+      expect(firstConsumer.executionContainer).toBe(firstContext.container);
+      expect(secondConsumer.executionContainer).toBe(secondContext.container);
     });
   });
 });
