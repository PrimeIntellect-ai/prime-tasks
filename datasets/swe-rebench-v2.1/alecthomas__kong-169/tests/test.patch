diff --git a/mapper_test.go b/mapper_test.go
index 4f052f9..3c663ce 100644
--- a/mapper_test.go
+++ b/mapper_test.go
@@ -420,3 +420,37 @@ func TestPathMapper(t *testing.T) {
 	require.NoError(t, err)
 	require.Equal(t, "-", cli.Path)
 }
+
+func TestMapperPlaceHolder(t *testing.T) {
+	var cli struct {
+		Flag string
+	}
+	b := bytes.NewBuffer(nil)
+	mapper := testMapperWithPlaceHolder{placeholder: "CUSTOM-PATH or -"}
+	k := mustNew(
+		t,
+		&cli,
+		kong.Writers(b, b),
+		kong.ValueMapper(&cli.Flag, mapper),
+		kong.Exit(func(int) { panic("exit") }),
+	)
+	// Ensure that --help
+	require.Panics(t, func() {
+		_, err := k.Parse([]string{"--help"})
+		require.NoError(t, err)
+	})
+	require.Contains(t, b.String(), "--flag="+mapper.placeholder)
+}
+
+type testMapperWithPlaceHolder struct {
+	placeholder string
+}
+
+func (t testMapperWithPlaceHolder) Decode(ctx *kong.DecodeContext, target reflect.Value) error {
+	target.SetString("hi")
+	return nil
+}
+
+func (t testMapperWithPlaceHolder) PlaceHolder(flag *kong.Flag) string {
+	return t.placeholder
+}
