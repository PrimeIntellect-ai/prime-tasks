index 8f6e235..66c4c80 100644
--- a/tests/parsers/service.parser.spec.ts
+++ b/tests/parsers/service.parser.spec.ts
@@ -547,4 +547,34 @@ describe('ServiceParser', () => {
 		const keys = parser.extract(contents, componentFilename)?.keys();
 		expect(keys).to.deep.equal([]);
 	});
+
+	describe('function-valued const declarations', () => {
+		it('should extract from an arrow function initializer', () => {
+			const contents = `
+			export const errorInterceptor: HttpInterceptorFn = (req, next) => {
+				const translateService = inject(TranslateService);
+
+				translateService.instant('translation.key');
+
+			};
+			`;
+			const keys = parser.extract(contents, componentFilename)?.keys();
+			expect(keys?.slice().sort()).to.deep.equal(['translation.key']);
+		});
+
+		it('should not extract dynamically supplied keys', () => {
+			const contents = `
+			export const errorInterceptor: HttpInterceptorFn = (req, next) => {
+				const translate = inject(TranslateService);
+
+				translate.instant('direct.translation.key');
+
+				const dynamicKey = req.url;
+				translate.instant(dynamicKey);
+			};
+			`;
+			const keys = parser.extract(contents, componentFilename)?.keys();
+			expect(keys?.slice().sort()).to.deep.equal(['direct.translation.key']);
+		});
+	});
 });
