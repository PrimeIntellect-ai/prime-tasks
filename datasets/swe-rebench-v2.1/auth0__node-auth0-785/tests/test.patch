+  describe('#deleteAllAuthenticators', () => {
+    let params;
+    let scope;
+
+    beforeEach(() => {
+      params = {
+        id: 'user_id',
+      };
+
+      scope = nock(API_URL).delete(`/users/${params.id}/authenticators`).reply(200);
+    });
+
+    it('should throw an ArgumentError when the id is missing', () => {
+      expect(() => {
+        usersManager.deleteAllAuthenticators({});
+      }).to.throw(ArgumentError);
+    });
+
+    it('should throw an ArgumentError when the id is undefined', () => {
+      expect(() => {
+        usersManager.deleteAllAuthenticators({ id: undefined });
+      }).to.throw(ArgumentError);
+    });
+
+    it('should throw an ArgumentError when the id is null', () => {
+      expect(() => {
+        usersManager.deleteAllAuthenticators({ id: null });
+      }).to.throw(ArgumentError);
+    });
+
+    it('should throw an ArgumentError when the id is not a string', () => {
+      expect(() => {
+        usersManager.deleteAllAuthenticators({ id: 123 });
+      }).to.throw(ArgumentError);
+    });
+
+    it('should accept a callback', (done) => {
+      usersManager.deleteAllAuthenticators(params, (err) => {
+        expect(err).to.not.exist;
+        done();
+      });
+    });
+
+    it('should pass any errors to the callback', (done) => {
+      nock.cleanAll();
+
+      nock(API_URL).delete(`/users/${params.id}/authenticators`).reply(500);
+
+      usersManager.deleteAllAuthenticators(params, (err) => {
+        expect(err).to.exist;
+        done();
+      });
+    });
+
+    it('should return a promise if no callback is given', () => {
+      expect(usersManager.deleteAllAuthenticators(params)).instanceOf(Promise);
+    });
+
+    it('should resolve the promise when the request succeeds', async () => {
+      nock.cleanAll();
+
+      const request = nock(API_URL).delete(`/users/${params.id}/authenticators`).reply(204);
+
+      await usersManager.deleteAllAuthenticators(params);
+      expect(request.isDone()).to.be.true;
+    });
+
+    it('should pass any errors to the promise catch handler', async () => {
+      nock.cleanAll();
+
+      nock(API_URL).delete(`/users/${params.id}/authenticators`).reply(500);
+
+      const promise = usersManager.deleteAllAuthenticators(params);
+      expect(promise).to.be.an.instanceOf(Promise);
+
+      let error;
+      try {
+        await promise;
+      } catch (err) {
+        error = err;
+      }
+      expect(error).to.exist;
+    });
+
+    it('should perform a DELETE request to /api/v2/users/user_id/authenticators', async () => {
+      await usersManager.deleteAllAuthenticators(params);
+      expect(scope.isDone()).to.be.true;
+    });
+
+    it('should include the token in the Authorization header', async () => {
+      nock.cleanAll();
+
+      const request = nock(API_URL)
+        .delete(`/users/${params.id}/authenticators`)
+        .matchHeader('Authorization', `Bearer ${token}`)
+        .reply(200);
+
+      await usersManager.deleteAllAuthenticators(params);
+      expect(request.isDone()).to.be.true;
+    });
+  });
+
