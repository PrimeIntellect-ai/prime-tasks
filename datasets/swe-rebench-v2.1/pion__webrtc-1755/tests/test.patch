+func TestICETransport_SelectedCandidatePairAccessorReturnsPairAfterConnect(t *testing.T) {
+	selectedPairAvailable := func(transport *ICETransport) bool {
+		method := reflect.ValueOf(transport).MethodByName("GetSelectedCandidatePair")
+		if !method.IsValid() {
+			t.Fatal("ICETransport does not expose GetSelectedCandidatePair")
+		}
+		results := method.Call(nil)
+		if len(results) == 0 {
+			t.Fatal("GetSelectedCandidatePair returned no pair value")
+		}
+		switch pair := results[0].Interface().(type) {
+		case *ICECandidatePair:
+			return pair != nil
+		case ICECandidatePair:
+			return pair.Local != nil || pair.Remote != nil
+		default:
+			t.Fatalf("GetSelectedCandidatePair returned %T, want an ICECandidatePair", results[0].Interface())
+			return false
+		}
+	}
+
+	offerer, answerer, err := newPair()
+	assert.NoError(t, err)
+
+	peerConnectionConnected := untilConnectionState(PeerConnectionStateConnected, offerer, answerer)
+
+	offererICE := offerer.SCTP().Transport().ICETransport()
+	answererICE := answerer.SCTP().Transport().ICETransport()
+	assert.False(t, selectedPairAvailable(offererICE))
+	assert.False(t, selectedPairAvailable(answererICE))
+
+	assert.NoError(t, signalPair(offerer, answerer))
+	peerConnectionConnected.Wait()
+
+	assert.True(t, selectedPairAvailable(offererICE))
+	assert.True(t, selectedPairAvailable(answererICE))
+
+	closePairNow(t, offerer, answerer)
+}
