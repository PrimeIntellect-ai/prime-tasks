         self.assertEqual(scheduled.duration, org_duration*2)
+
+    def test_cx_durations_match_backend_for_asap_scheduling(self):
+        """Each CX instruction retains the backend duration of its own qubit pair."""
+        qc = QuantumCircuit(3)
+        qc.cz(0, 1)
+        qc.cz(1, 2)
+        sc = transpile(qc,
+                       backend=self.backend_with_dt,
+                       scheduling_method='asap')
+        durations_by_pair = {}
+        for inst, qargs, _ in sc.data:
+            if inst.name == 'cx':
+                pair = tuple(sc.qubits.index(q) for q in qargs)
+                durations_by_pair.setdefault(pair, []).append(inst.duration)
+        expected = {
+            (0, 1): round(self.backend_with_dt.properties().gate_length('cx', (0, 1)) / self.dt),
+            (1, 2): round(self.backend_with_dt.properties().gate_length('cx', (1, 2)) / self.dt),
+        }
+        self.assertEqual(set(durations_by_pair), set(expected))
+        for pair, expected_duration in expected.items():
+            self.assertEqual(durations_by_pair[pair], [expected_duration])
