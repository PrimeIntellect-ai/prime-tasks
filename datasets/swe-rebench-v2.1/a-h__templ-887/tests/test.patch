diff --git a/parser/v2/benchmarks_test.go b/parser/v2/benchmarks_test.go
new file mode 100644
index 0000000..015591c
--- /dev/null
+++ b/parser/v2/benchmarks_test.go
@@ -0,0 +1,62 @@
+package parser
+
+import (
+	_ "embed"
+	"strings"
+	"testing"
+	"time"
+)
+
+//go:embed benchmarktestdata/benchmark.txt
+var benchmarkTemplate string
+
+func BenchmarkParse(b *testing.B) {
+	b.ReportAllocs()
+	for i := 0; i < b.N; i++ {
+		if _, err := ParseString(benchmarkTemplate); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+func BenchmarkFormat(b *testing.B) {
+	b.ReportAllocs()
+	sb := new(strings.Builder)
+	for i := 0; i < b.N; i++ {
+		tf, err := ParseString(benchmarkTemplate)
+		if err != nil {
+			b.Fatal(err)
+		}
+		if err = tf.Write(sb); err != nil {
+			b.Fatal(err)
+		}
+		sb.Reset()
+	}
+}
+
+func TestParseManyUnclosedVoidElementsDoesNotLockUp(t *testing.T) {
+	// A template containing many unclosed void elements used to cause the parser
+	// to repeatedly re-scan the remainder of the file, taking exponential time.
+	sb := new(strings.Builder)
+	sb.WriteString("package main\n\ntempl X() {\n")
+	for i := 0; i < 30; i++ {
+		sb.WriteString("<input>\n")
+	}
+	sb.WriteString("}\n")
+	src := sb.String()
+
+	done := make(chan error, 1)
+	go func() {
+		_, err := ParseString(src)
+		done <- err
+	}()
+
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("parsing a template with many unclosed void elements did not complete within 10s")
+	}
+}
