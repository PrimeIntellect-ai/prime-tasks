+@pytest.mark.parametrize("conf_value, expect_strip", [("True", True), ("False", False)])
+def test_meson_install_strip(conf_value, expect_strip):
+    """The `tools.build:install_strip` configuration controls whether
+    the Meson install operation passes `--strip`."""
+    c = ConfDefinition()
+    c.loads(f"tools.build:install_strip={conf_value}")
+
+    settings = MockSettings({"build_type": "Release",
+                             "compiler": "gcc",
+                             "compiler.version": "7",
+                             "os": "Linux",
+                             "arch": "x86_64"})
+    conanfile = ConanFileMock()
+    conanfile.settings = settings
+    conanfile.conf = c.get_conanfile_conf(None)
+    conanfile.folders.generators = "."
+    conanfile.folders.set_base_generators(temp_folder())
+    conanfile.folders.set_base_package(temp_folder())
+
+    meson = Meson(conanfile)
+    meson.install()
+
+    assert ("--strip" in str(conanfile.command)) == expect_strip
+
+
+def test_meson_install_strip_default_off():
+    """Without the configuration, the Meson install operation does not pass `--strip`."""
+    settings = MockSettings({"build_type": "Release",
+                             "compiler": "gcc",
+                             "compiler.version": "7",
+                             "os": "Linux",
+                             "arch": "x86_64"})
+    conanfile = ConanFileMock()
+    conanfile.settings = settings
+    conanfile.conf = ConfDefinition().get_conanfile_conf(None)
+    conanfile.folders.generators = "."
+    conanfile.folders.set_base_generators(temp_folder())
+    conanfile.folders.set_base_package(temp_folder())
+
+    meson = Meson(conanfile)
+    meson.install()
+
+    assert "--strip" not in str(conanfile.command)
