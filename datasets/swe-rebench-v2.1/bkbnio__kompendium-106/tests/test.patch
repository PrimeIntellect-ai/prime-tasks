+/**
+ * Builds a copy of this [MethodInfo.GetInfo] with the supplied `operationId` when the
+ * installed Kompendium version exposes that optional property. When the property is not
+ * available (i.e. the feature is not implemented) the original metadata is returned
+ * unchanged, so the generated spec simply omits the `operationId` field.
+ */
+private fun <TParam, TResp> MethodInfo.GetInfo<TParam, TResp>.operationIdTestRoute(
+  operationId: String
+): MethodInfo.GetInfo<TParam, TResp> {
+  val copyFunction = this::class.memberFunctions.first { it.name == "copy" }
+  val operationIdParameter = copyFunction.parameters.firstOrNull { it.name == "operationId" } ?: return this
+  @Suppress("UNCHECKED_CAST")
+  return copyFunction.callBy(
+    mapOf(
+      copyFunction.instanceParameter!! to this,
+      operationIdParameter to operationId
+    )
+  ) as MethodInfo.GetInfo<TParam, TResp>
+}
+
+fun Application.operationIdTestRoute() {
+  routing {
+    route("/test") {
+      notarizedGet(
+        info = TestResponseInfo.testGetInfo.operationIdTestRoute("getTest")
+      ) {
+        call.respond(HttpStatusCode.OK)
+      }
+    }
+  }
+}
