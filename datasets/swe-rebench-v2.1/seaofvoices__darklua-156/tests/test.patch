+use darklua_core::rules::{get_all_rule_names, Rule};
+
+#[test]
+fn converts_interpolated_strings_to_lua_expressions() {
+    // A string containing only literal text remains an ordinary string expression.
+    assert_registered_rule_output("return `abc`", &["return 'abc'"]);
+    assert_registered_rule_output("return `\"`", &["return '\"'", "return \"\\\"\""]);
+
+    // Interpolated values are converted to strings; concatenation is also an
+    // acceptable representation of a complex interpolation.
+    assert_registered_rule_output(
+        "return `...{true}`",
+        &[
+            "return string.format('...%s', tostring(true))",
+            "return '...' .. tostring(true)",
+        ],
+    );
+
+    // The default conversion for this example is specified exactly.
+    assert_registered_rule_output(
+        "return `-{object}`",
+        &["return string.format('-%s', tostring(object))"],
+    );
+}
+
+/// Look up registered rules without depending on the identifier chosen for
+/// this rule, and check their observable transformation of the source.
+fn assert_registered_rule_output(input: &str, expected: &[&str]) {
+    use darklua_core::generator::LuaGenerator;
+
+    let resources = darklua_core::Resources::from_memory();
+    let original = crate::utils::parse_input(input);
+    let expected_blocks: Vec<_> = expected
+        .iter()
+        .map(|source| crate::utils::parse_input(source))
+        .collect();
+
+    for name in get_all_rule_names() {
+        let Ok(rule) = json5::from_str::<Box<dyn Rule>>(&format!("'{}'", name)) else {
+            continue;
+        };
+        let mut block = crate::utils::parse_input(input);
+        let context =
+            darklua_core::rules::ContextBuilder::new("src/test.lua", &resources, input).build();
+
+        if rule.process(&mut block, &context).is_err() {
+            continue;
+        }
+
+        if block != original && expected_blocks.iter().any(|expected| expected == &block) {
+            return;
+        }
+
+        let mut generator = darklua_core::generator::ReadableLuaGenerator::default();
+        generator.write_block(&block);
+        let generated = generator.into_string();
+        let generated_block = crate::utils::parse_input(&generated);
+        if generated_block != original
+            && expected_blocks
+                .iter()
+                .any(|expected| expected == &generated_block)
+        {
+            return;
+        }
+    }
+
+    panic!(
+        "no registered rule transformed input:\n{}\ninto any of:\n{}",
+        input,
+        expected.join("\n")
+    );
+}
