+def test_factory_with_nested_optional_field_overrides_in_dict() -> None:
+    class MyChildModel(BaseModel):
+        name: str
+
+    class MyParentModel(BaseModel):
+        child: Optional[MyChildModel]
+
+    class MyParentModelFactory(ModelFactory):
+        __model__ = MyParentModel
+
+        @classmethod
+        def should_set_none_value(cls, field_meta: FieldMeta) -> bool:
+            return True
+
+    result = MyParentModelFactory.build(child={"name": "test"})
+    assert result.child is not None
+    assert result.child.name == "test"
+
+
+def test_factory_with_nested_optional_dataclass_field_overrides_in_dict() -> None:
+    @dataclass
+    class Bar:
+        baz: str
+
+    @dataclass
+    class Foo:
+        bar: Optional[Bar]
+
+    class FooFactory(DataclassFactory):
+        __model__ = Foo
+
+    for _ in range(1000):
+        foo = FooFactory.build(bar={"baz": "TEST"})
+        assert foo.bar is not None
+        assert foo.bar.baz == "TEST"
+
+
+def test_base_factory_exposes_should_set_none_value_classmethod() -> None:
+    field_meta = FieldMeta(name="value", annotation=Optional[str])
+
+    assert isinstance(BaseFactory.should_set_none_value(field_meta), bool)
+
+
+def test_factory_override_controls_none_for_optional_field_without_build_override() -> None:
+    class ChildModel(BaseModel):
+        name: str
+
+    class ParentModel(BaseModel):
+        child: Optional[ChildModel]
+
+    class SetNoneFactory(ModelFactory):
+        __model__ = ParentModel
+
+        @classmethod
+        def should_set_none_value(cls, field_meta: FieldMeta) -> bool:
+            return True
+
+    class DoNotSetNoneFactory(ModelFactory):
+        __model__ = ParentModel
+
+        @classmethod
+        def should_set_none_value(cls, field_meta: FieldMeta) -> bool:
+            return False
+
+    assert SetNoneFactory.build().child is None
+    assert DoNotSetNoneFactory.build().child is not None
