+    def test_stats_computation_methods(self, test_result_factory: Callable[[], TestResult]) -> None:
+        """Test that statistics properties report aggregated result counts."""
+        result_manager = ResultManager()
+
+        test1 = test_result_factory()
+        test1.name = "device1"
+        test1.result = AntaTestStatus.SUCCESS
+        test1.categories = ["system"]
+        test1.test = "test1"
+
+        test2 = test_result_factory()
+        test2.name = "device2"
+        test2.result = AntaTestStatus.FAILURE
+        test2.categories = ["interfaces"]
+        test2.test = "test2"
+
+        result_manager.add(test1)
+        result_manager.add(test2)
+
+        device_stats = result_manager.device_stats
+        test_stats = result_manager.test_stats
+
+        assert device_stats["device1"].tests_success_count == 1
+        assert device_stats["device2"].tests_failure_count == 1
+        assert test_stats["test1"].devices_success_count == 1
+        assert test_stats["test2"].devices_failure_count == 1
+
+    def test_stats_property_computation(self, test_result_factory: Callable[[], TestResult]) -> None:
