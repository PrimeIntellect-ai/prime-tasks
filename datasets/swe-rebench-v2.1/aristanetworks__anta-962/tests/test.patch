 from __future__ import annotations
 
+import click
 import json
 import re
 from pathlib import Path
@@ -12,8 +13,19 @@ from typing import TYPE_CHECKING, Any
 from unittest.mock import patch
 
 from anta.cli import anta
+from anta.cli.nrfu import nrfu as _nrfu_command
 from anta.cli.utils import ExitCode
 
+# Compatibility shim: with click >= 8.2 a flag that also declares an explicit ``type``
+# has its boolean default converted to a truthy string, which makes the ``--dry-run``
+# option of ``anta nrfu`` always active and prevents the CLI tests from running the
+# tests. Normalise the option so the tests exercise the real command flow on every
+# supported click version.
+for _param in _nrfu_command.params:
+    if _param.name == "dry_run":
+        _param.type = click.BOOL
+        _param.default = False
+
 if TYPE_CHECKING:
     from click.testing import CliRunner
 
