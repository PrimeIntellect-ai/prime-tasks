+def test_arcp_root_id(tmp_path):
+    crate_dir = tmp_path / "test_crate"
+    crate_dir.mkdir()
+    root_id = "arcp://name,corpus-of-oz-early-english"
+    metadata = {
+        "@context": [
+            "https://w3id.org/ro/crate/1.1/context",
+            {"@vocab": "http://schema.org/"},
+        ],
+        "@graph": [
+            {
+                "@id": "ro-crate-metadata.json",
+                "@type": "CreativeWork",
+                "conformsTo": [{"@id": "https://w3id.org/ro/crate/1.2"}],
+                "about": {"@id": root_id},
+            },
+            {"@id": root_id, "@type": "Dataset"},
+        ],
+    }
+    (crate_dir / "ro-crate-metadata.json").write_text(json.dumps(metadata))
+    crate = ROCrate(crate_dir)
+    assert crate.root_dataset.id.startswith("arcp://")
+    assert "name,corpus-of-oz-early-english" in crate.root_dataset.id
