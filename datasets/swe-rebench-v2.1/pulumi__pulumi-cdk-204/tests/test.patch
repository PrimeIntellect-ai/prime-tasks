+    test('route53 short text records are unquoted', async () => {
+        resources.length = 0;
+        const value = 'short TXT value';
+        await testApp((scope: Construct) => {
+            const zone = new route53.PublicHostedZone(scope, 'ShortHostedZone', {
+                zoneName: 'pulumi-cdk.com',
+            });
+            new route53.TxtRecord(scope, 'ShortTxtRecord', {
+                zone,
+                values: [value],
+                recordName: 'cdk-short-txt',
+            });
+        });
+        const txt = resources.find((res) => res.type === 'aws:route53/record:Record');
+        expect(txt).toBeDefined();
+        const records = txt?.inputs.records as string[];
+        expect(records).toBeDefined();
+        expect(records?.join('')).toEqual(value);
+        expect(records?.every((record) => record.length <= 255)).toBe(true);
+        expect(records?.every((record) => !record.includes('"'))).toBe(true);
+    });
+
+    test('route53 long text records are split', async () => {
+        resources.length = 0;
+        await testApp((scope: Construct) => {
+            const zone = new route53.PublicHostedZone(scope, 'HostedZone', {
+                zoneName: 'pulumi-cdk.com',
+            });
+            new route53.TxtRecord(scope, 'TxtRecord2', {
+                zone,
+                values: ['hello'.repeat(52)],
+                recordName: 'cdk-txt-2',
+            });
+        });
+        const txt = resources.find((res) => res.type === 'aws:route53/record:Record');
+        expect(txt).toBeDefined();
+        const records = txt?.inputs.records as string[];
+        expect(records).toBeDefined();
+        // The long value is unquoted and split so that no single value exceeds 255 characters.
+        expect(records.join('')).toEqual('hello'.repeat(52));
+        expect(records.every((r) => r.length <= 255)).toBe(true);
+        expect(records.every((r) => !r.includes('"'))).toBe(true);
+    });
