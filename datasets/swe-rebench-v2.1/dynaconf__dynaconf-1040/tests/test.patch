@@ -519,3 +520,53 @@ def test_boolean_fix():
     assert boolean_fix("TrueNotOnly") == "TrueNotOnly"
     assert boolean_fix("FalseNotOnly") == "FalseNotOnly"
     assert boolean_fix("NotOnlyFalse") == "NotOnlyFalse"
+
+
+def test_get_converter(settings):
+    """Ensure the work of @get converter"""
+    settings.set("FOO", 12)
+    settings.set("BAR", "@get FOO")
+    assert settings.BAR == settings.FOO == 12
+
+    settings.set("ZAZ", "@get RAZ @float 42")
+    assert settings.ZAZ == 42.0
+
+
+def test_get_converter_error_when_converting(settings):
+    """Malformed declaration errors"""
+    settings.set("BLA", "@get")
+
+    with pytest.raises(DynaconfFormatError):
+        settings.BLA
+
+
+def test_get_converter_preserves_type(settings):
+    """@get reuses the stored value keeping its current type"""
+    settings.set("A_DICT", {"key": "value"})
+    settings.set("A_LIST", [1, 2, 3])
+    settings.set("DICT_ALIAS", "@get A_DICT")
+    settings.set("LIST_ALIAS", "@get A_LIST")
+    assert settings.DICT_ALIAS == {"key": "value"}
+    assert settings.LIST_ALIAS == [1, 2, 3]
+
+
+def test_get_converter_default_and_cast(settings):
+    """@get accepts an optional cast and an optional default"""
+    settings.set("NUMBER", 12)
+    settings.set("CAST_ALIAS", "@get NUMBER @int")
+    assert settings.CAST_ALIAS == 12
+
+    settings.set("MISSING_ALIAS", "@get MISSING_KEY @int 789")
+    assert settings.MISSING_ALIAS == 789
+    assert isinstance(settings.MISSING_ALIAS, int)
+
+    settings.set("MISSING_ALIAS_WITHOUT_CAST", "@get MISSING_KEY fallback-value")
+    assert settings.MISSING_ALIAS_WITHOUT_CAST == "fallback-value"
+
+
+def test_dynaconf_format_error_is_public_exception():
+    """DynaconfFormatError is a public exception with an optional message"""
+    assert issubclass(DynaconfFormatError, Exception)
+    assert str(DynaconfFormatError()) == ""
+    error = DynaconfFormatError("boom")
+    assert "boom" in str(error) or getattr(error, "message", None) == "boom"
