+func TestWithTemplateASN1Booleans(t *testing.T) {
+	cr, _ := createCertificateRequest(t, "foo", nil)
+	var options Options
+	template := `{{ asn1Enc "bool:true" }} {{ asn1Enc "bool:false" }}`
+	if err := WithTemplate(template, TemplateData{})(cr, &options); err != nil {
+		t.Fatalf("WithTemplate() error = %v", err)
+	}
+
+	values := bytes.Fields(options.CertBuffer.Bytes())
+	if len(values) != 2 {
+		t.Fatalf("template rendered %d values, want 2", len(values))
+	}
+	for i, want := range []bool{true, false} {
+		der, err := base64.StdEncoding.DecodeString(string(values[i]))
+		if err != nil {
+			t.Fatalf("decode template value %d: %v", i, err)
+		}
+		var got bool
+		rest, err := asn1.Unmarshal(der, &got)
+		if err != nil {
+			t.Fatalf("decode ASN.1 boolean %d: %v", i, err)
+		}
+		if len(rest) != 0 {
+			t.Errorf("ASN.1 boolean %d left trailing data %x", i, rest)
+		}
+		if got != want {
+			t.Errorf("ASN.1 boolean %d = %t, want %t", i, got, want)
+		}
+	}
+}
