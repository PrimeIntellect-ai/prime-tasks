+// newSAMLTestConnector opens a SAML connector with signature validation enabled,
+// using the CA shipped with the SAML connector's test data.
+func newSAMLTestConnector(t *testing.T) connector.SAMLConnector {
+	t.Helper()
+	cfg := &saml.Config{
+		SSOURL:       "https://idp.example.com/sso",
+		RedirectURI:  "https://dex.example.com/callback",
+		UsernameAttr: "name",
+		EmailAttr:    "email",
+		CA:           "../../connector/saml/testdata/ca.crt",
+	}
+	c, err := cfg.Open("saml-test", slog.Default())
+	if err != nil {
+		t.Fatalf("open saml connector: %v", err)
+	}
+	sc, ok := c.(connector.SAMLConnector)
+	if !ok {
+		t.Fatalf("saml connector does not implement connector.SAMLConnector")
+	}
+	return sc
+}
+
+// TestSAMLResponseWithoutSignedNodesIsRejected checks that SAML responses lacking
+// the XML nodes needed for signature validation are rejected with an error instead
+// of panicking.
+func TestSAMLResponseWithoutSignedNodesIsRejected(t *testing.T) {
+	sc := newSAMLTestConnector(t)
+
+	responses := map[string]string{
+		"root element without assertion": `<samlp:Response xmlns:samlp="urn:oasis:names:tc:SAML:2.0:protocol" ID="_1" Version="2.0"></samlp:Response>`,
+		"document without root element":  `<!-- no root element -->`,
+	}
+	for name, raw := range responses {
+		t.Run(name, func(t *testing.T) {
+			encoded := base64.StdEncoding.EncodeToString([]byte(raw))
+			var err error
+			func() {
+				defer func() {
+					if r := recover(); r != nil {
+						t.Fatalf("HandlePOST panicked: %v", r)
+					}
+				}()
+				_, err = sc.HandlePOST(connector.Scopes{}, encoded, "")
+			}()
+			if err == nil {
+				t.Fatal("expected an error for a response without a signed assertion, got nil")
+			}
+		})
+	}
+}
