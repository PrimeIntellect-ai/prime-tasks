+@pytest.mark.parametrize(
+    "name,numpy_method,options",
+    [
+        ("min", numpy.ma.min, [{}]),
+        ("max", numpy.ma.max, [{}]),
+        ("median", numpy.ma.median, [{}]),
+        ("mean", numpy.ma.mean, [{}]),
+        ("std", numpy.ma.std, [{"ddof": 0}, {"ddof": 1}]),
+        ("var", numpy.ma.var, [{"ddof": 0}, {"ddof": 1}]),
+    ],
+)
+def test_math_algorithm(name, numpy_method, options):
+    """test math algos."""
+    # Use a multi-band input so the reduction across the band axis is exercised.
+    arr = numpy.ma.MaskedArray(
+        numpy.random.randint(0, 5000, (3, 256, 256)).astype("uint16"),
+        mask=numpy.zeros((3, 256, 256), dtype="bool"),
+    )
+    arr.mask[:, 1:100, 1:100] = True
+
+    img = ImageData(arr)
+    algo = default_algorithms.get(name)()
+    out = algo(img)
+
+    assert out.array.shape == (1, 256, 256)
+    expected = [
+        numpy_method(img.array, axis=0, keepdims=True, **option)
+        for option in options
+    ]
+    assert any(numpy.ma.allclose(out.array, result) for result in expected)
+    assert out.array[0, 1, 1] is numpy.ma.masked
+
+
+def test_math_algorithm_masked_reduction():
+    """Reductions must use the remaining valid bands when only some are masked."""
+    arr = numpy.ma.MaskedArray(
+        numpy.array(
+            [
+                [[1.0, 10.0], [5.0, 5.0]],
+                [[2.0, 20.0], [5.0, 5.0]],
+                [[3.0, 30.0], [5.0, 5.0]],
+            ],
+            dtype="float32",
+        ),
+        mask=numpy.zeros((3, 2, 2), dtype="bool"),
+    )
+    # pixel (0, 0): only band 0 is masked -> reduce over bands 1 and 2
+    arr.mask[0, 0, 0] = True
+    # pixel (0, 1): every band is masked -> result must be masked
+    arr.mask[:, 0, 1] = True
+
+    img = ImageData(arr)
+    expected = {
+        "min": (2.0,),
+        "max": (3.0,),
+        "median": (2.5,),
+        "mean": (2.5,),
+        "std": (numpy.std([2.0, 3.0], ddof=0), numpy.std([2.0, 3.0], ddof=1)),
+        "var": (numpy.var([2.0, 3.0], ddof=0), numpy.var([2.0, 3.0], ddof=1)),
+    }
+
+    for name, values in expected.items():
+        out = default_algorithms.get(name)()(img)
+        assert out.array.shape == (1, 2, 2)
+        assert any(out.array[0, 0, 0] == pytest.approx(value) for value in values)
+        assert out.array[0, 0, 1] is numpy.ma.masked
