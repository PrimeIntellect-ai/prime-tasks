@@ -0,0 +1,101 @@
+use crate::tests_helper::{create_timer, run_with_splits};
+
+#[test]
+fn reattaches_unattached_segment_history_elements_to_synthetic_indices() {
+    let mut timer = create_timer(&["A", "B"]);
+    run_with_splits(&mut timer, &[3.0, 6.0]);
+    run_with_splits(&mut timer, &[2.0, 4.0]);
+    let mut run = timer.into_run(true);
+
+    // We pop the last attempt from the history, but keep it in the segment
+    // history, which makes the segment history elements unattached.
+    run.attempt_history.pop().unwrap();
+
+    let attached_times: Vec<_> = run
+        .segments()
+        .iter()
+        .map(|segment| segment.segment_history().get(1).unwrap())
+        .collect();
+    let unattached_times: Vec<_> = run
+        .segments()
+        .iter()
+        .map(|segment| segment.segment_history().get(2).unwrap())
+        .collect();
+
+    run.fix_splits();
+
+    let segments = run.segments();
+
+    for ((segment, attached_time), unattached_time) in segments
+        .iter()
+        .zip(attached_times)
+        .zip(unattached_times)
+    {
+        let history = segment.segment_history();
+        let synthetic_entry = history.iter().find(|&&(index, _)| index <= 0).unwrap();
+        assert_eq!(synthetic_entry.1, unattached_time);
+        assert_eq!(history.get(1), Some(attached_time));
+
+        // The unattached element (index 2) is reattached to a synthetic,
+        // non-positive index, while the attached element (index 1) is kept.
+        assert!(history.get(2).is_none());
+        assert!(history.get(1).is_some());
+        assert!(
+            history.try_get_min_index().map_or(false, |i| i <= 0),
+            "expected a non-positive synthetic index, got {:?}",
+            history.try_get_min_index()
+        );
+        assert_eq!(history.try_get_max_index(), Some(1));
+    }
+}
+
+#[test]
+fn reattaches_multiple_unattached_segment_history_elements_to_distinct_indices() {
+    let mut timer = create_timer(&["A", "B"]);
+    run_with_splits(&mut timer, &[3.0, 6.0]);
+    run_with_splits(&mut timer, &[2.0, 4.0]);
+    run_with_splits(&mut timer, &[1.0, 2.0]);
+    let mut run = timer.into_run(true);
+
+    // Pop the last two attempts, leaving the segment history elements with
+    // indices 2 and 3 unattached.
+    run.attempt_history.pop().unwrap();
+    run.attempt_history.pop().unwrap();
+
+    let expected: Vec<_> = run
+        .segments()
+        .iter()
+        .map(|segment| {
+            let history = segment.segment_history();
+            (
+                history.get(1).unwrap(),
+                history.get(2).unwrap(),
+                history.get(3).unwrap(),
+            )
+        })
+        .collect();
+
+    run.fix_splits();
+
+    for (segment, (attached_time, first_unattached_time, second_unattached_time)) in
+        run.segments().iter().zip(expected)
+    {
+        let history = segment.segment_history();
+
+        assert!(history.get(2).is_none());
+        assert!(history.get(3).is_none());
+        assert_eq!(history.get(1), Some(attached_time));
+        assert_eq!(history.try_get_max_index(), Some(1));
+
+        let synthetic: Vec<_> = history
+            .iter()
+            .filter(|&&(index, _)| index <= 0)
+            .map(|&(index, time)| (index, time))
+            .collect();
+        assert_eq!(synthetic.len(), 2);
+        assert!(synthetic.iter().all(|&(index, _)| index <= 0));
+        assert_ne!(synthetic[0].0, synthetic[1].0);
+        assert!(synthetic.iter().any(|&(_, time)| time == first_unattached_time));
+        assert!(synthetic.iter().any(|&(_, time)| time == second_unattached_time));
+    }
+}
