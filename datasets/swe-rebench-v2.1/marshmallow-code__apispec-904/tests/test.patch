+@pytest.mark.parametrize("spec_fixture", ("3.1.0",), indirect=True)
+def test_nested_nullable(spec_fixture):
+    class Child(Schema):
+        name = fields.Str()
+
+    field = fields.Nested(Child, allow_none=True)
+    res = spec_fixture.openapi.field2property(field)
+    assert res == {
+        "anyOf": [{"$ref": "#/components/schemas/Child"}, {"type": "null"}]
+    }
+
+
+@pytest.mark.parametrize("spec_fixture", ("3.1.0",), indirect=True)
+def test_nested_nullable_does_not_make_nested_schema_nullable(spec_fixture):
+    class FooSchema(Schema):
+        bar = fields.Integer(required=True)
+
+    class MySchema(Schema):
+        foo = fields.Nested(FooSchema, allow_none=True)
+
+    spec_fixture.spec.components.schema("MySchema", schema=MySchema)
+    schemas = get_schemas(spec_fixture.spec)
+    assert schemas == {
+        "Foo": {
+            "type": "object",
+            "properties": {"bar": {"type": "integer"}},
+            "required": ["bar"],
+        },
+        "MySchema": {
+            "type": "object",
+            "properties": {
+                "foo": {
+                    "anyOf": [
+                        {"$ref": "#/components/schemas/Foo"},
+                        {"type": "null"},
+                    ]
+                }
+            },
+        },
+    }
+
+
