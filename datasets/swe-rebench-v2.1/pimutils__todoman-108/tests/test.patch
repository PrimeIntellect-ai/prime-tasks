diff --git a/tests/test_formatter.py b/tests/test_formatter.py
new file mode 100644
index 0000000..513f489
--- /dev/null
+++ b/tests/test_formatter.py
@@ -0,0 +1,54 @@
+from datetime import datetime, timedelta
+from random import randrange
+
+from freezegun import freeze_time
+
+from todoman import ui
+
+DATE_FORMAT = "%d-%m-%y"
+
+
+@freeze_time("2016-01-15 12:00:00")
+def test_format_date():
+    """
+    Tests the format_date function in todoman.ui.TodoFormatter
+    """
+    formatter = ui.TodoFormatter(DATE_FORMAT)
+    today = datetime.now()
+    tomorrow = today + timedelta(days=1)
+    any_day = today + timedelta(days=randrange(2, 8))
+
+    assert formatter.format_date("") == "        "
+    assert formatter.format_date(today) == "   Today"
+    assert formatter.format_date(tomorrow) == "Tomorrow"
+    assert formatter.format_date(any_day) == any_day.strftime(DATE_FORMAT)
+
+
+@freeze_time("2016-01-15 12:00:00")
+def test_format_date_empty():
+    """
+    Falsy dates (empty string or None) yield the empty-date placeholder.
+    """
+    formatter = ui.TodoFormatter(DATE_FORMAT)
+
+    assert formatter.format_date("") == "        "
+    assert formatter.format_date(None) == "        "
+
+
+@freeze_time("2016-01-15 12:00:00")
+def test_format_date_padding_matches_date_width():
+    """
+    Special labels and the empty placeholder are padded to the width of a
+    regularly formatted date so columns stay aligned, for any date format.
+    """
+    date_format = "%Y-%m-%d"
+    formatter = ui.TodoFormatter(date_format)
+    today = datetime.now()
+    tomorrow = today + timedelta(days=1)
+    any_day = today + timedelta(days=5)
+
+    width = len(any_day.strftime(date_format))
+    assert formatter.format_date(None) == " " * width
+    assert formatter.format_date(today) == "Today".rjust(width)
+    assert formatter.format_date(tomorrow) == "Tomorrow".rjust(width)
+    assert formatter.format_date(any_day) == any_day.strftime(date_format)
