+import { parse } from '@vue/compiler-sfc'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { DEFAULT_OVERRIDE_CONFIG } from '../../helpers/constants'
+import { checkRules } from '../../rulesCheck'
+import { reportRules } from '../../rulesReport'
+
+const repeatedCssRule = '<text_info>rrd ~ repeated CSS</text_info>'
+
+type Component = { file: string, css: string }
+
+const analyzeRepeatedCss = (components: Component[]) => {
+  components.forEach(({ file, css }) => {
+    const { descriptor } = parse(`<template><div /></template><style>${css}</style>`)
+    checkRules(descriptor, file, ['repeatedCss'], DEFAULT_OVERRIDE_CONFIG)
+  })
+
+  return reportRules('rule', 'asc', 'all', DEFAULT_OVERRIDE_CONFIG).output
+}
+
+const componentsWithCss = (css: string, count: number): Component[] =>
+  Array.from({ length: count }, (_, index) => ({
+    file: `component${index + 1}.vue`,
+    css,
+  }))
+
+describe('repeated CSS reporting', () => {
+  beforeEach(() => {
+    vi.restoreAllMocks()
+  })
+
+  it('does not report a pair found in three or fewer distinct files', () => {
+    const output = analyzeRepeatedCss(componentsWithCss('.foo { color: red; }', 3))
+
+    expect(output[repeatedCssRule] ?? []).toHaveLength(0)
+  })
+
+  it('does not report a pair repeated within one component', () => {
+    const output = analyzeRepeatedCss([{
+      file: 'component.vue',
+      css: '.foo { color: red; } .bar { color: red; } .baz { color: red; } .qux { color: red; }',
+    }])
+
+    expect(output[repeatedCssRule] ?? []).toHaveLength(0)
+  })
+
+  it('reports repeated pairs across distinct files with the required details', () => {
+    const output = analyzeRepeatedCss(componentsWithCss('.foo { color: red; }', 4))
+    const reports = output[repeatedCssRule]
+
+    expect(reports).toHaveLength(1)
+    expect(reports[0]).toMatchObject({
+      id: 'component1.vue, component2.vue, component3.vue, component4.vue',
+      description: '👉 <text_warn>Avoid repeating CSS properties with the same value more than 3 times across files. Consider using CSS variables or a common class.</text_warn> See: https://vue-mess-detector.webmania.cc/rules/rrd/repeated-css.html',
+      message: 'repeated CSS: (color:red;) in 4 files 🚨',
+    })
+  })
+
+  it('reports an offense for every qualifying property-value pair', () => {
+    const output = analyzeRepeatedCss(componentsWithCss('.foo { color: red; background-color: blue; }', 4))
+    const reports = output[repeatedCssRule]
+
+    expect(reports).toHaveLength(2)
+    expect(reports.map(report => report.message).sort()).toEqual([
+      'repeated CSS: (color:red;) in 4 files 🚨',
+      'repeated CSS: (background-color:blue;) in 4 files 🚨',
+    ].sort())
+    expect(reports.every(report => report.id === 'component1.vue, component2.vue, component3.vue, component4.vue')).toBe(true)
+  })
+
+  it('ignores property-value text inside CSS comments', () => {
+    const output = analyzeRepeatedCss(componentsWithCss('/* color: red; */', 4))
+
+    expect(output[repeatedCssRule] ?? []).toHaveLength(0)
+  })
+
+  it('logs the files associated with a repeated pair', () => {
+    const logSpy = vi.spyOn(console, 'log').mockImplementation(() => {})
+
+    analyzeRepeatedCss(componentsWithCss('.foo { color: red; }', 4))
+
+    const logged = logSpy.mock.calls.flat().join(' ')
+    expect(logged).toContain('component1.vue')
+    expect(logged).toContain('component2.vue')
+    expect(logged).toContain('component3.vue')
+    expect(logged).toContain('component4.vue')
+  })
+})
