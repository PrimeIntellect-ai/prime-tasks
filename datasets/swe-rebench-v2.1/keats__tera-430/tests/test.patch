+#[test]
+fn parse_variable_with_whitespace_trimming() {
+    let ast = parse("{{- id }}").unwrap();
+    assert_eq!(
+        ast[0],
+        Node::VariableBlock(
+            WS { left: true, right: false },
+            Expr::new(ExprVal::Ident("id".to_string()))
+        ),
+    );
+
+    let ast = parse("{{ id -}}").unwrap();
+    assert_eq!(
+        ast[0],
+        Node::VariableBlock(
+            WS { left: false, right: true },
+            Expr::new(ExprVal::Ident("id".to_string()))
+        ),
+    );
+
+    let ast = parse("{{- id -}}").unwrap();
+    assert_eq!(
+        ast[0],
+        Node::VariableBlock(
+            WS { left: true, right: true },
+            Expr::new(ExprVal::Ident("id".to_string()))
+        ),
+    );
+}
+
+#[test]
+fn default_whitespace_flags_are_disabled() {
+    let ws = WS::default();
+    assert!(!ws.left);
+    assert!(!ws.right);
+}
