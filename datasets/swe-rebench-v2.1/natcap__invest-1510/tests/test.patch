+    def test_write_vector_for_single_raster_modes(self):
+        """UNA: create a summary vector for single-raster summary stats."""
+
+        from natcap.invest import urban_nature_access
+
+        args = _build_model_args(self.workspace_dir)
+
+        # Overwrite all population pixels with 0
+        try:
+            raster = gdal.Open(args['population_raster_path'], gdal.GA_Update)
+            band = raster.GetRasterBand(1)
+            array = band.ReadAsArray()
+            array.fill(0.0)
+            band.WriteArray(array)
+        finally:
+            raster = band = None
+
+        args['search_radius_mode'] = urban_nature_access.RADIUS_OPT_UNIFORM
+        args['search_radius'] = 1000
+
+        urban_nature_access.execute(args)
+
+        summary_vector = gdal.OpenEx(
+            os.path.join(args['workspace_dir'], 'output',
+                         'admin_boundaries_suffix.gpkg'))
+        summary_layer = summary_vector.GetLayer()
+        self.assertEqual(summary_layer.GetFeatureCount(), 1)
+        summary_feature = summary_layer.GetNextFeature()
+
+        per_capita_value = summary_feature.GetField('SUP_DEMadm_cap')
+        self.assertTrue(
+            per_capita_value is None or math.isnan(per_capita_value))
+
+    def test_empty_admin_unit_when_other_units_have_population(self):
+        """An empty unit is retained and does not prevent model execution."""
+        from natcap.invest import urban_nature_access
+
+        args = _build_model_args(self.workspace_dir)
+        population_info = pygeoprocessing.get_raster_info(
+            args['population_raster_path'])
+        raster = gdal.Open(args['population_raster_path'], gdal.GA_Update)
+        band = raster.GetRasterBand(1)
+        population = band.ReadAsArray()
+        population[4:, :] = 0
+        band.WriteArray(population)
+        raster = band = None
+
+        min_x, min_y, max_x, max_y = population_info['bounding_box']
+        midpoint_y = (min_y + max_y) / 2
+        admin_geometries = [
+            shapely.geometry.box(min_x, min_y, max_x, midpoint_y),
+            shapely.geometry.box(min_x, midpoint_y, max_x, max_y)]
+        pygeoprocessing.shapely_geometry_to_vector(
+            admin_geometries, args['admin_boundaries_vector_path'],
+            population_info['projection_wkt'], 'GeoJSON')
+
+        args['search_radius_mode'] = urban_nature_access.RADIUS_OPT_UNIFORM
+        args['search_radius'] = 1000
+        urban_nature_access.execute(args)
+
+        summary_vector = gdal.OpenEx(
+            os.path.join(args['workspace_dir'], 'output',
+                         'admin_boundaries_suffix.gpkg'))
+        summary_layer = summary_vector.GetLayer()
+        self.assertEqual(summary_layer.GetFeatureCount(), 2)
+        per_capita_values = [
+            feature.GetField('SUP_DEMadm_cap') for feature in summary_layer]
+        no_value_results = [
+            value for value in per_capita_values
+            if value is None or math.isnan(value)]
+        numeric_results = [
+            value for value in per_capita_values
+            if value is not None and not math.isnan(value)]
+        self.assertEqual(len(no_value_results), 1, repr(per_capita_values))
+        self.assertEqual(len(numeric_results), 1)
+        self.assertGreater(float(population[:4, :].sum()), 0)
+
