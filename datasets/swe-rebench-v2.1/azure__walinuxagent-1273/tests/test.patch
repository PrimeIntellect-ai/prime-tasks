+    def test_launch_command_does_not_terminate_long_running_extension(self):
+        """
+        A long-running extension which forks must not be terminated by the agent.
+        launch_command must return without raising an exception, and the forked
+        child process must still be running afterwards.
+        """
+        ext_handler = ExtHandler("Microsoft.OSTCExtensions.TestExtension")
+        ext_handler.properties.version = "1.0.0"
+        ext_handler_i = ExtHandlerInstance(ext_handler, "dummy protocol")
+
+        base_dir = ext_handler_i.get_base_dir()
+        if not os.path.isdir(base_dir):
+            os.makedirs(base_dir)
+
+        pid_file = os.path.join(base_dir, "child.pid")
+        script = os.path.join(base_dir, "long_running.sh")
+        with open(script, "w") as script_file:
+            script_file.write("#!/bin/sh\nsleep 20 &\necho $! > {0}\n".format(pid_file))
+        os.chmod(script, 0o755)
+
+        start = datetime.datetime.utcnow()
+        try:
+            ext_handler_i.launch_command("long_running.sh", timeout=10)
+        except Exception as e:
+            self.fail("launch_command should not raise for a long-running forked extension: {0}".format(e))
+        duration = datetime.datetime.utcnow() - start
+
+        self.assertTrue(duration < datetime.timedelta(seconds=5))
+
+        # The forked child must not have been terminated by the agent
+        self.assertTrue(os.path.isfile(pid_file))
+        with open(pid_file) as pid_handle:
+            child_pid = int(pid_handle.read().strip())
+        try:
+            os.kill(child_pid, 0)
