-    expect(isAnalyticsLogged(req, res, 'aaa', 'aa')).toBeTruthy()
+    expect(isAnalyticsLogged(req, 'aaa', 'aa')).toBeTruthy()
+  })
+  test('new visitor without a GA cookie is redirected and the GA cookie is set', async () => {
+    const req = createRequestWithShortUrl('Aaa')
+    const res = httpMocks.createResponse()
+    redisMockClient.set('aaa', 'aa')
+
+    await container
+      .get<RedirectController>(DependencyIds.redirectController)
+      .redirect(req, res)
+
+    expect(res.statusCode).toBe(302)
+    expect(res._getRedirectUrl()).toBe('aa')
+    expect(res.cookies.gaClientId).toBeDefined()
+    expect(isAnalyticsLogged(req, 'aaa', 'aa')).toBeTruthy()
+  })
+
+  test('real analytics logger only generates a GA cookie when one is absent', () => {
+    const config = jest.requireMock('../../../src/server/config') as {
+      gaTrackingId?: string
+    }
+    const previousTrackingId = config.gaTrackingId
+    config.gaTrackingId = 'test-tracking-id'
+
+    // Collect every string value nested in the settings, whatever their shape.
+    const collectStrings = (value: unknown): string[] => {
+      if (typeof value === 'string') return [value]
+      if (Array.isArray(value)) {
+        return value.reduce<string[]>(
+          (acc, v) => acc.concat(collectStrings(v)),
+          [],
+        )
+      }
+      if (value && typeof value === 'object') {
+        return Object.values(value).reduce<string[]>(
+          (acc, v) => acc.concat(collectStrings(v)),
+          [],
+        )
+      }
+      return []
+    }
+
+    try {
+      const analyticsLogger = (new GaLogger() as unknown) as {
+        generateCookie: (cookie?: string) => unknown
+      }
+      expect(typeof analyticsLogger.generateCookie).toBe('function')
+
+      const cookieSettings = analyticsLogger.generateCookie()
+      expect(cookieSettings).toBeTruthy()
+
+      const strings = collectStrings(cookieSettings)
+      expect(strings).toContain('gaClientId')
+      const clientId = strings.find((s) => s !== 'gaClientId' && s !== '')
+      expect(clientId).toBeDefined()
+
+      const existing = analyticsLogger.generateCookie(`gaClientId=${clientId}`)
+      expect(existing === null || existing === undefined).toBe(true)
+    } finally {
+      if (previousTrackingId === undefined) {
+        delete config.gaTrackingId
+      } else {
+        config.gaTrackingId = previousTrackingId
+      }
+    }
   })
 })
