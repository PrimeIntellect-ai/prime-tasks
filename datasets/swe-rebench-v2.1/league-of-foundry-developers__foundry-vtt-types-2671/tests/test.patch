diff --git a/tests/foundry/client/data/documents/macro.test-d.ts b/tests/foundry/client/data/documents/macro.test-d.ts
index 4749f7ab..18130d46 100644
--- a/tests/foundry/client/data/documents/macro.test-d.ts
+++ b/tests/foundry/client/data/documents/macro.test-d.ts
@@ -1,24 +1,52 @@
 import { expectTypeOf } from "vitest";
 import type { StoredDocument } from "../../../../../src/types/utils.d.mts";
+import type { Scope } from "../../../../../src/foundry/client/data/documents/macro.d.mts";
 
-const macro = new Macro({ name: "my macro", scope: "global", type: "script" });
+const myMacro = new Macro({ name: "my macro", scope: "global", type: "script" });
+
+// `Scope` is a public interface that consumers can use with `Macro.execute`
+const scope: Scope = {
+  actor: new Actor({ name: "foo", type: "base" }),
+  token: new Token(new TokenDocument()),
+  additionalArgument: "value",
+  anotherAdditionalArgument: 42,
+};
+myMacro.execute(scope);
 
 // properties and functions added by the concrete `Macro` class
-expectTypeOf(macro.isAuthor).toEqualTypeOf<boolean>();
-expectTypeOf(macro.execute).toEqualTypeOf<(scope?: { actor?: Actor; token?: Token }) => any>();
+myMacro.execute();
+if (myMacro.type === "script") {
+  expectTypeOf(myMacro.type).toEqualTypeOf<"script">();
+  expectTypeOf(myMacro.isAuthor).toEqualTypeOf<boolean>();
+  myMacro.execute({ effect: new ActiveEffect() });
+  myMacro.execute({ effect: new ActiveEffect(), actor: new Actor({ name: "foo", type: "base" }) });
+  myMacro.execute({ token: new Token(new TokenDocument()) });
+
+  // @ts-expect-error The token property must be an actual Token
+  myMacro.execute({ token: new ActiveEffect() });
+
+  // @ts-expect-error The actor property must be an actual Actor
+  myMacro.execute({ actor: new ActiveEffect() });
+  // @ts-expect-error The actor property must be an actual Actor
+  myMacro.execute({ actor: new ActiveEffect(), effect: new ActiveEffect() });
+}
+if (myMacro.type === "chat") {
+  expectTypeOf(myMacro.type).toEqualTypeOf<"chat">();
+  myMacro.execute();
+}
 
 // properties and functions of `ClientDocumentMixin`
-expectTypeOf(macro.apps).toEqualTypeOf<Record<string, Application>>();
-expectTypeOf(macro.collection).toEqualTypeOf<Collection<Macro>>();
-expectTypeOf(macro.folder).toEqualTypeOf<Folder | null>();
-expectTypeOf(macro.isOwner).toEqualTypeOf<boolean>();
+expectTypeOf(myMacro.apps).toEqualTypeOf<Record<string, Application>>();
+expectTypeOf(myMacro.collection).toEqualTypeOf<Collection<Macro>>();
+expectTypeOf(myMacro.folder).toEqualTypeOf<Folder | null>();
+expectTypeOf(myMacro.isOwner).toEqualTypeOf<boolean>();
 
 // static properties and functions of `ClientDocumentMixin`
 expectTypeOf(Macro.createDialog()).toEqualTypeOf<Promise<Macro | null | undefined>>();
 
 // properties of `Document`
-expectTypeOf(macro.parent).toEqualTypeOf<null>();
-expectTypeOf(macro.pack).toEqualTypeOf<string | null>();
+expectTypeOf(myMacro.parent).toEqualTypeOf<null>();
+expectTypeOf(myMacro.pack).toEqualTypeOf<string | null>();
 
 // static properties of `Document`
 expectTypeOf(Macro.create({ name: "Some Macro" })).toEqualTypeOf<Promise<StoredDocument<Macro> | undefined>>();
