+    @ParameterizedTest
+    @EnumSource(Target::class)
+    fun lazy_multi_interface_provider_setup_is_safe(target: Target) {
+        val projectCompiler = ProjectCompiler(target, workingDir)
+        val compilationSucceeded = try {
+            projectCompiler.source(
+                "RuntimeCheck.kt",
+                """
+                    import me.tatarka.inject.annotations.Component
+                    import me.tatarka.inject.annotations.Inject
+                    import me.tatarka.inject.annotations.Provides
+
+                    interface UserReadPort { fun read(): String }
+                    interface UserWritePort { fun write(): String }
+
+                    @Inject
+                    class UserInMemoryAdapter : UserReadPort, UserWritePort {
+                        override fun read(): String = "read"
+                        override fun write(): String = "write"
+                    }
+
+                    @Inject
+                    class CreateUserUseCase(
+                        lazyUserWritePort: Lazy<UserWritePort>,
+                        lazyUserReadPort: Lazy<UserReadPort>
+                    ) {
+                        private val userWritePort by lazyUserWritePort
+                        private val userReadPort by lazyUserReadPort
+
+                        fun exercise() {
+                            userWritePort.write()
+                            userReadPort.read()
+                        }
+                    }
+
+                    @Component
+                    abstract class AppComponent {
+                        abstract val createUserUseCase: CreateUserUseCase
+
+                        @Provides
+                        fun userReadInMemoryAdapter(userReadPort: UserReadPort): UserReadPort = userReadPort
+
+                        @Provides
+                        fun userWriteInMemoryAdapter(userWritePort: UserWritePort): UserWritePort = userWritePort
+                    }
+
+                    fun main() {
+                        AppComponent::class.create().createUserUseCase.exercise()
+                    }
+                """.trimIndent()
+            ).compile()
+            true
+        } catch (failure: Exception) {
+            if (failure.message.orEmpty().contains("Cycle detected")) {
+                false
+            } else {
+                throw failure
+            }
+        }
+
+        if (compilationSucceeded) {
+            val classes = File(workingDir, "classes")
+            java.net.URLClassLoader(arrayOf(classes.toURI().toURL()), javaClass.classLoader).use { loader ->
+                loader.loadClass("RuntimeCheckKt").getMethod("main").invoke(null)
+            }
+        }
+    }
