+def test_normalize_token_parquet_filemetadata(tmpdir):
+    from dask.base import tokenize
+
+    df = pd.DataFrame({c: range(10) for c in "abcde"})
+    path = tmpdir / "df.parquet"
+    df.to_parquet(path)
+
+    metadata = pq.read_metadata(path)
+    equivalent_metadata = pq.read_metadata(path)
+
+    assert tokenize(metadata) == tokenize(equivalent_metadata)
