+func TestFormatGlobPreservesBackslashesAcrossFiles(t *testing.T) {
+	dir := t.TempDir()
+	cases := []struct {
+		name     string
+		input    string
+		expected string
+	}{
+		{
+			name: "template",
+			input: `value: "\\${VARIABLE_:-}"
+`,
+			expected: `\${VARIABLE_:-}`,
+		},
+		{
+			name: "regular expression",
+			input: `value: '\(\d+, "Unknown database .*'
+`,
+			expected: `\(\d+, "Unknown database .*`,
+		},
+	}
+
+	for _, tc := range cases {
+		path := filepath.Join(dir, tc.name+".yaml")
+		if err := os.WriteFile(path, []byte(tc.input), 0600); err != nil {
+			t.Fatalf("write input YAML: %v", err)
+		}
+	}
+
+	f, err := (&basic.BasicFormatterFactory{}).NewFormatter(map[string]interface{}{"emoji_support": true})
+	if err != nil {
+		t.Fatalf("create basic formatter: %v", err)
+	}
+	formatter := &engine.Engine{
+		Include:   []string{filepath.Join(dir, "*.yaml")},
+		Formatter: f,
+	}
+	if err := formatter.FormatAllFiles(); err != nil {
+		t.Fatalf("format glob-selected YAML files: %v", err)
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			formatted, err := os.ReadFile(filepath.Join(dir, tc.name+".yaml"))
+			if err != nil {
+				t.Fatalf("read formatted YAML: %v", err)
+			}
+			var result struct {
+				Value string `yaml:"value"`
+			}
+			if err := yaml.Unmarshal(formatted, &result); err != nil {
+				t.Fatalf("parse formatted YAML: %v", err)
+			}
+			if result.Value != tc.expected {
+				t.Errorf("formatted value = %q, want %q", result.Value, tc.expected)
+			}
+		})
+	}
+}
