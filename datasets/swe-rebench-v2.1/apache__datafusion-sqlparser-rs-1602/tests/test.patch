+#[test]
+fn test_any_type_data_type() {
+    let dialect = BigQueryDialect {};
+    let mut parser = Parser::new(&dialect)
+        .try_with_sql("ANY TYPE")
+        .expect("tokenize to work");
+    parser
+        .parse_data_type()
+        .expect("ANY TYPE should parse as a data type");
