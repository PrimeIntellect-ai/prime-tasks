+func TestRPMVersionWithPrereleaseWithDashes(t *testing.T) {
+	for _, prerelease := range []string{"rc1-alpha-omega", "candidate-one-rc-two", "alpha-beta-gamma-delta"} {
+		t.Run(prerelease, func(t *testing.T) {
+			info := exampleInfo()
+			info.Version = "1.0.0"
+			info.Prerelease = prerelease
+
+			f, err := os.CreateTemp(t.TempDir(), "test.rpm")
+			require.NoError(t, err)
+			require.NoError(t, Default.Package(info, f))
+			require.NoError(t, f.Close())
+
+			file, err := os.Open(f.Name())
+			require.NoError(t, err)
+			defer func() { require.NoError(t, file.Close()) }()
+			rpm, err := rpmutils.ReadRpm(file)
+			require.NoError(t, err)
+
+			version, err := rpm.Header.GetString(rpmutils.VERSION)
+			require.NoError(t, err)
+			require.True(t, strings.HasPrefix(version, info.Version+"~"), version)
+			prereleaseVersion := strings.TrimPrefix(version, info.Version+"~")
+			require.NotContains(t, prereleaseVersion, "-")
+		})
+	}
+}
