+    @pytest.mark.unit
+    def test_split_summary_public_api(self):
+        """The splitter is provided from its documented module and package API."""
+        import inspect
+        from typing import List, get_type_hints
+
+        import docformatter.strings
+
+        splitter = docformatter.strings.split_summary
+        assert callable(splitter)
+        assert splitter.__module__ == docformatter.strings.__name__
+        assert docformatter.split_summary is splitter
+        signature = inspect.signature(splitter)
+        assert list(signature.parameters) == ["lines"]
+        assert get_type_hints(splitter)["return"] == List[str]
+
+    @pytest.mark.unit
+    def test_split_one_sentence_summary(self):
+        """A single sentence summary should be returned as is.
+
+        See issue #283.
+        """
+        assert [
+            "This is a sentence.",
+            "",
+        ] == docformatter.split_summary(["This is a sentence.", ""])
+
+        assert [
+            "This e.g. a sentence.",
+            "",
+        ] == docformatter.split_summary(["This e.g. a sentence.", ""])
+
+    @pytest.mark.unit
+    def test_split_multi_sentence_summary(self):
+        """A multi-sentence summary should return only the first as the summary.
+
+        See issue #283.
+        """
+        assert [
+            "This is a sentence.",
+            "",
+            "This is another.",
+        ] == docformatter.split_summary(["This is a sentence. This is another.", ""])
+
+        assert [
+            "This e.g. a sentence.",
+            "",
+            "This is another.",
+        ] == docformatter.split_summary(["This e.g. a sentence. This is another.", ""])
+
+    @pytest.mark.unit
+    def test_split_summary_empty_and_whitespace(self):
+        """Empty or whitespace-only summaries should be returned unchanged.
+
+        See issue #283.
+        """
+        assert [] == docformatter.split_summary([])
+        assert [""] == docformatter.split_summary([""])
+        assert ["", "text"] == docformatter.split_summary(["", "text"])
+        assert ["   ", "text"] == docformatter.split_summary(["   ", "text"])
+
+    @pytest.mark.unit
+    def test_split_summary_and_description_multiline_multi_sentence(self):
+        """A multi-line docstring summary is split into one sentence.
+
+        See issue #283.
+        """
+        summary, description = docformatter.split_summary_and_description(
+            "Do bar. This is the first sentence. And this is the second.\n\n"
+            "And now this is the longer description."
+        )
+
+        assert "Do bar." == summary
+        assert "This is the first sentence. And this is the second." in description
+        assert "And now this is the longer description." in description
+
