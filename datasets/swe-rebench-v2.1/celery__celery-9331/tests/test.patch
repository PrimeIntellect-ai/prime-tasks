+    def test_setup_schedule_recovers_from_dbm_error(self, tmp_path):
+        class CorruptedStore(dict):
+            def __getitem__(self, key):
+                raise KeyError(key)
+
+            def __setitem__(self, key, value):
+                raise dbm.error[0]()
+
+            def setdefault(self, key, default=None):
+                raise dbm.error[0]()
+
+        corrupted_store = CorruptedStore()
+        usable_store = MockShelve()
+        opened_corrupted_store = []
+
+        def open_store(*args, **kwargs):
+            if not opened_corrupted_store:
+                opened_corrupted_store.append(True)
+                return corrupted_store
+            return usable_store
+
+        Scheduler, _ = create_persistent_scheduler()
+        Scheduler.persistence = Bunch(open=open_store)
+        scheduler = Scheduler(app=self.app,
+                              schedule_filename=str(tmp_path / 'schedule'))
+
+        scheduler.schedule['recovery-check'] = 'usable'
+        assert scheduler.schedule['recovery-check'] == 'usable'
+
