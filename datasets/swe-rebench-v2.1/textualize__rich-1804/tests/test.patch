+def test_install_ipython_falls_back_when_special_repr_returns_none(monkeypatch):
+    from IPython.core.interactiveshell import InteractiveShell
+
+    console = Console(file=io.StringIO(), force_jupyter=True, no_color=True)
+    shell = InteractiveShell()
+    monkeypatch.setattr(pretty_module, "get_ipython", lambda: shell, raising=False)
+    monkeypatch.setattr(rich, "get_console", lambda: console)
+
+    class SeriesLike:
+        def _repr_latex_(self):
+            return None
+
+        def __repr__(self):
+            return "Series([1, 2, 3])"
+
+    install(console)
+    formatter = shell.display_formatter.formatters["text/plain"]
+    console.begin_capture()
+    result = formatter(SeriesLike())
+
+    rendered = console.end_capture()
+    assert result is None
+    assert rendered
+    assert "Series" in rendered
+
+
+def test_ipy_display_hook__signature():
+    parameters = inspect.signature(pretty_module._ipy_display_hook).parameters
+
+    assert list(parameters) == [
+        "value",
+        "console",
+        "overflow",
+        "crop",
+        "indent_guides",
+        "max_length",
+        "max_string",
+        "expand_all",
+    ]
+    assert [parameter.default for parameter in parameters.values()] == [
+        inspect.Parameter.empty,
+        None,
+        "ignore",
+        False,
+        False,
+        None,
+        None,
+        False,
+    ]
+
