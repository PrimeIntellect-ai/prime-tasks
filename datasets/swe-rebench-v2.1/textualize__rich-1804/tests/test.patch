+def test_ipy_display_hook__special_repr_raises_exception():
+    """A failed representation doesn't prevent a later one from being used."""
+    console = Console(file=io.StringIO(), force_jupyter=True)
+
+    class Thing:
+        def _repr_markdown_(self):
+            raise Exception()
+
+        def _repr_latex_(self):
+            return None
+
+        def _repr_html_(self):
+            return "hello"
+
+    console.begin_capture()
+    result = pretty_module._ipy_display_hook(Thing(), console=console)
+
+    assert console.end_capture() == ""
+    assert result is None
+
