+def test_ipy_display_hook__non_jupyter_uses_rich_for_special_repr():
+    console = Console(file=io.StringIO(), force_jupyter=False, no_color=True)
+
+    class Thing:
+        def _repr_html_(self):
+            return "<b>not used outside Jupyter</b>"
+
+        def __repr__(self):
+            return "Thing()"
+
+    console.begin_capture()
+    result = pretty_module._ipy_display_hook(Thing(), console=console)
+
+    rendered = console.end_capture()
+    assert "Thing()" in rendered
+    assert result is None
+
+
+def test_ipy_display_hook__repr_html():
+    console = Console(file=io.StringIO(), force_jupyter=True)
+
+    class Thing:
+        def _repr_html_(self):
+            return "hello"
+
+    console.begin_capture()
+    result = pretty_module._ipy_display_hook(Thing(), console=console)
+
+    # Rendering delegated to notebook because _repr_html_ method exists
+    assert console.end_capture() == ""
+    assert result is None
+
