+++ b/src/create/createRerunSuggestion.test.ts
@@ -0,0 +1,141 @@
+import { SpyInstance, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { createRerunSuggestion } from "./createRerunSuggestion.js";
+import type { Options } from "../shared/types.js";
+
+type AssertFalse<T extends false> = T;
+type SkipApiIsNotPublic = AssertFalse<"skipApi" extends keyof Options ? true : false>;
+
+const mockReadOptions = vi.fn();
+
+vi.mock("../shared/options/readOptions.js", () => ({
+	get readOptions() {
+		return mockReadOptions;
+	},
+}));
+
+const mockCreateWithOptions = vi.fn();
+
+vi.mock("./createWithOptions.js", () => ({
+	get createWithOptions() {
+		return mockCreateWithOptions;
+	},
+}));
+
+const mockOutro = vi.fn();
+
+vi.mock("@clack/prompts", () => ({
+	get outro() {
+		return mockOutro;
+	},
+}));
+
+const mock$ = vi.fn();
+
+vi.mock("execa", () => ({
+	get $() {
+		return mock$;
+	},
+}));
+
+const mockReaddir = vi.fn();
+const mockMkdir = vi.fn();
+
+vi.mock("node:fs/promises", () => ({
+	get default() {
+		return {
+			get mkdir() {
+				return mockMkdir;
+			},
+			get readdir() {
+				return mockReaddir;
+			},
+		};
+	},
+}));
+
+import { create } from "./index.js";
+
+describe("createRerunSuggestion", () => {
+	it("includes key-value pairs with mixed truthy and falsy values", () => {
+		const actual = createRerunSuggestion("initialize", {
+			author: "TestAuthor",
+			base: "everything",
+			createRepository: true,
+			description: "Test description.",
+			email: "test@test.com",
+			excludeCompliance: true,
+			excludeContributors: true,
+			excludeLintJson: true,
+			excludeLintKnip: true,
+			excludeLintMd: false,
+			excludeLintPackageJson: true,
+			excludeLintPackages: false,
+			excludeLintPerfectionist: true,
+			excludeLintSpelling: false,
+			excludeLintYml: false,
+			excludeReleases: false,
+			excludeRenovate: undefined,
+			excludeTests: undefined,
+			funding: undefined,
+			owner: "TestOwner",
+			repository: "test-repository",
+			skipGitHubApi: true,
+			skipInstall: true,
+			skipRemoval: true,
+			skipRestore: undefined,
+			skipUninstall: undefined,
+			title: "Test Title",
+		});
+
+const actualWithBooleanLiteralsRemoved = actual.replace(
+/(--(?:create-repository|exclude-compliance|exclude-contributors|exclude-lint-json|exclude-lint-knip|exclude-lint-package-json|exclude-lint-perfectionist|skip-github-api|skip-install|skip-removal)) true(?= |$)/g,
+"$1",
+);
+
+expect(actualWithBooleanLiteralsRemoved).toBe(
+'npx template-typescript-node-package --mode initialize --author TestAuthor --base everything --create-repository --description "Test description." --email test@test.com --exclude-compliance --exclude-contributors --exclude-lint-json --exclude-lint-knip --exclude-lint-package-json --exclude-lint-perfectionist --owner TestOwner --repository test-repository --skip-github-api --skip-install --skip-removal --title "Test Title"',
+);
+	});
+});
+
+describe("create", () => {
+	let mockConsoleLog: SpyInstance;
+
+	beforeEach(() => {
+		mockConsoleLog = vi
+			.spyOn(console, "log")
+			.mockImplementation(() => undefined);
+		vi.spyOn(process, "chdir").mockImplementation(() => undefined);
+		mockReaddir.mockResolvedValue([]);
+		mockCreateWithOptions.mockResolvedValue({ sentToGitHub: false });
+		mockReadOptions.mockResolvedValue({
+			octokit: undefined,
+			options: {
+				owner: "TestOwner",
+				repository: "test-repository",
+				skipGitHubApi: true,
+				skipInstall: true,
+				skipRestore: true,
+				title: "Test Title",
+			},
+		});
+	});
+
+	it("suggests an initialize rerun command that does not skip the GitHub API", async () => {
+		await create([]);
+
+		const loggedLines = mockConsoleLog.mock.calls
+			.map(([first]) => (typeof first === "string" ? first : ""))
+			.map((line) => line.replace(/\u001b\[[0-9;]*m/g, ""));
+
+		const suggestion = loggedLines.find((line) =>
+			line.includes("--mode initialize"),
+		);
+
+		expect(suggestion).toContain(
+			"npx template-typescript-node-package --mode initialize",
+		);
+		expect(suggestion).not.toContain("--skip-github-api");
+	});
+});
