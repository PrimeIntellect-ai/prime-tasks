+
+func TestCRLFLineEnding(t *testing.T) {
+	factory := basic.BasicFormatterFactory{}
+	f, err := factory.NewWithConfig(map[string]interface{}{"line_ending": "crlf"})
+	if err != nil {
+		t.Fatalf("expected factory to create formatter, got error: %v", err)
+	}
+
+	yaml := "# comment\r\na:\r\n"
+	result, err := f.Format([]byte(yaml))
+	if err != nil {
+		t.Fatalf("expected formatting to pass, returned error: %v", err)
+	}
+	if got := strings.ReplaceAll(string(result), "\r", ""); got != "# comment\na:\n" {
+		t.Fatalf("expected comment and content to be retained, result: %q", result)
+	}
+}
+
+func TestFormatterDoesNotInsertBlankLinesAfterComments(t *testing.T) {
+	factory := basic.BasicFormatterFactory{}
+	f, err := factory.NewWithConfig(map[string]interface{}{"line_ending": "crlf"})
+	if err != nil {
+		t.Fatalf("expected factory to create formatter, got error: %v", err)
+	}
+
+	yaml := "Resources:\r\n  ElasticBeanstalk:\r\n    Properties:\r\n      #NotificationARNs: \r\n      #  - String\r\n      #Parameters: \r\n      TemplateURL: x\r\n"
+	result, err := f.Format([]byte(yaml))
+	if err != nil {
+		t.Fatalf("expected formatting to pass, returned error: %v", err)
+	}
+	lines := strings.Split(strings.ReplaceAll(string(result), "\r", ""), "\n")
+	for i, line := range lines {
+		if line == "" && i != len(lines)-1 {
+			t.Fatalf("blank line was inserted in result: %q", result)
+		}
+	}
+	for _, comment := range []string{"#NotificationARNs", "#  - String", "#Parameters"} {
+		if !strings.Contains(string(result), comment) {
+			t.Fatalf("comment %q was stripped away, result: %q", comment, result)
+		}
+	}
+}
