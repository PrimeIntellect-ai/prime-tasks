diff --git a/tests/unit/utilities/print-command-test.js b/tests/unit/utilities/print-command-test.js
index c1176542..04c08d05 100644
--- a/tests/unit/utilities/print-command-test.js
+++ b/tests/unit/utilities/print-command-test.js
@@ -84,4 +84,56 @@ describe('printCommand', function() {
 
     expect(output).to.equal(testString);
   });
+
+  it('quotes an empty string in option type choices', function() {
+    let output = printCommand.call({
+      availableOptions: [
+        {
+          name: 'type',
+          type: ['', 'foo'],
+        },
+      ],
+      anonymousOptions: [],
+    });
+
+    expect(processHelpString(output)).to.include(processHelpString('\u001b[36m("", foo)\u001b[39m'));
+  });
+
+  it('quotes an empty string alias value', function() {
+    let output = printCommand.call({
+      availableOptions: [
+        {
+          name: 'type',
+          type: String,
+          aliases: [{ 'no-type': '' }],
+        },
+      ],
+      anonymousOptions: [],
+    });
+
+    expect(processHelpString(output)).to.include(
+      processHelpString('\u001b[90maliases: --no-type (--type="")\u001b[39m')
+    );
+  });
+
+  it('quotes empty strings', function() {
+    let output = printCommand.call({
+      availableOptions: [
+        {
+          name: 'type',
+          type: ['', 'foo', 'bar'], // setting to empty string is allowed
+          default: '',
+          aliases: [{ 'no-type': '' }],
+        },
+      ],
+      anonymousOptions: [],
+    });
+
+    let testString = processHelpString(`\
+ \u001b[36m<options...>\u001b[39m${EOL}\
+  \u001b[36m--type\u001b[39m \u001b[36m("", foo, bar)\u001b[39m \u001b[36m(Default: "")\u001b[39m${EOL}\
+    \u001b[90maliases: --no-type (--type="")\u001b[39m`);
+
+    expect(output).to.equal(testString);
+  });
 });
