+function (a::AbsSeriesRing{T})(b::Array{S, 1}, len::Int, prec::Int) where {S <: RingElement, T <: RingElement}
+   R = base_ring(a)
+   lenb = length(b)
+   entries = Array{T}(undef, lenb)
+   for i = 1:lenb
+      entries[i] = R(b[i])
+   end
+   z = AbsSeries{T}(entries, len, prec)
+   z.parent = a
+   return z
+end
