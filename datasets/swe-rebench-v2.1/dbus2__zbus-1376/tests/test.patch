+
+#[test]
+fn serialize_empty_dict_struct() {
+    #[derive(Default, Debug, SerializeDict, Type)]
+    #[zvariant(signature = "dict")]
+    struct TestEmpty {}
+
+    let ctxt = Context::new_dbus(NATIVE_ENDIAN, 0);
+    assert!(to_bytes(ctxt, &TestEmpty::default()).is_ok());
+
+    #[cfg(feature = "gvariant")]
+    {
+        let ctxt = Context::new_gvariant(NATIVE_ENDIAN, 0);
+        assert!(to_bytes(ctxt, &TestEmpty::default()).is_ok());
+    }
+}
