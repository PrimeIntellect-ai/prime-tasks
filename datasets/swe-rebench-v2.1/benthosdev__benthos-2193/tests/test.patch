+func TestParseLogRFC5424StructuredDataBloblangNavigation(t *testing.T) {
+	conf := processor.NewConfig()
+	conf.Type = "parse_log"
+	conf.ParseLog.Format = "syslog_rfc5424"
+	conf.ParseLog.Codec = "json"
+	conf.ParseLog.BestEffort = true
+	proc, err := mock.NewManager().NewProcessor(conf)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	input := `<165>1 2003-10-11T22:14:15.003Z mymachine.example.com evntslog - ID47 [temp iut="3" eventSource="Application" eventID="1011"] BOMAn application event log entry...`
+	msgsOut, res := proc.ProcessBatch(context.Background(), message.QuickBatch([][]byte{[]byte(input)}))
+	if res != nil {
+		t.Fatal(res)
+	}
+	if len(msgsOut) != 1 {
+		t.Fatalf("Wrong count of result messages: %v != 1", len(msgsOut))
+	}
+
+	exe, err := bloblang.Parse(`root = if this.structureddata.temp.eventID == "1011" { true } else { throw("unexpected eventID") }`)
+	if err != nil {
+		t.Fatalf("Failed to parse Bloblang mapping: %v", err)
+	}
+	if _, err := service.NewInternalMessage(msgsOut[0].Get(0)).BloblangQuery(exe); err != nil {
+		t.Fatalf("Could not access structured-data parameter through Bloblang: %v", err)
+	}
+}
