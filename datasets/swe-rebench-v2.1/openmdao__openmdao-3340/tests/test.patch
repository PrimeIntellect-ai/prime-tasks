+            prob = _make_and_run()
+
+        warnings_issued = [str(ww.message) for ww in w
+                           if issubclass(ww.category, OpenMDAOWarning)]
+
+        # A duplicate problem name should warn rather than raise an error.
+        self.assertIn(msg1, warnings_issued)
