+func TestDocker_IgnoreMissingEnvFiles(t *testing.T) {
+	composePath, _, _ := getPaths(t)
+	outputPath := path.Join(t.TempDir(), "generated.nix")
+	missingEnvFile := path.Join(t.TempDir(), "not-present.env")
+	cmd := exec.Command("go", "run", ".",
+		"-runtime=docker",
+		"-inputs="+composePath,
+		"-env_files="+missingEnvFile,
+		"-include_env_files=true",
+		"-env_files_only=true",
+		"-ignore_missing_env_files=true",
+		"-output="+outputPath,
+	)
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("compose2nix failed with a missing env file: %v\n%s", err, output)
+	}
+	if _, err := os.Stat(outputPath); err != nil {
+		t.Fatalf("compose2nix did not generate its output: %v", err)
+	}
+}
