+import { convertRules } from "../../convertRules";
+import { ruleConverters } from "../../ruleConverters";
+import { ruleMergers } from "../../ruleMergers";
+
+describe("no-with-statement conversion", () => {
+    test("converts through the standard rule conversion path", () => {
+        const result = convertRules(
+            { ruleConverters, ruleMergers },
+            {
+                "no-with-statement": {
+                    ruleArguments: [],
+                    ruleSeverity: "error",
+                },
+            },
+            new Map<string, string[]>(),
+        );
+
+        expect(result.converted.get("no-with")).toMatchObject({
+            ruleName: "no-with",
+        });
+        expect(result.missing).toEqual([]);
+    });
+});
