+use ron::{
+    de::from_str,
+    ser::{to_string, to_string_pretty},
+};
+use serde::{Deserialize, Serialize};
+
+#[derive(Copy, Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+struct Test1 {
+    field: f64,
+}
+
+#[test]
+fn test_serialize_infinity() {
+    // Serializing positive infinity must succeed.
+    assert!(to_string(&std::f64::INFINITY).is_ok());
+}
+
+#[test]
+fn test_deserialize_infinity() {
+    // The serialized representation of positive infinity must deserialize
+    // back to positive infinity.
+    let serialized = to_string(&std::f64::INFINITY).unwrap();
+    assert_eq!(from_str::<f64>(&serialized), Ok(std::f64::INFINITY));
+}
+
+#[test]
+fn test_infinity_roundtrip() {
+    // The round trip demonstrated in the problem statement must work.
+    let original = Test1 {
+        field: std::f64::INFINITY,
+    };
+    let serialized = to_string_pretty(&original, Default::default()).unwrap();
+    let duplicate: Test1 = from_str(&serialized).unwrap();
+    assert_eq!(original, duplicate);
+}
