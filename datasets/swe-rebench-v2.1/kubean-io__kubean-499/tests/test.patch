+func TestCreateKubeSprayJobUsesRenderedServiceAccount(t *testing.T) {
+	t.Setenv("POD_NAMESPACE", "operator-namespace")
+	const renderedServiceAccount = "rendered-operator-account"
+	serviceAccount := &corev1.ServiceAccount{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      renderedServiceAccount,
+			Namespace: "operator-namespace",
+			Labels:    map[string]string{"kubean.io/kubean-operator": "sa"},
+		},
+	}
+	operatorDeployment := &appsv1.Deployment{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "kubean-operator",
+			Namespace: "operator-namespace",
+		},
+		Spec: appsv1.DeploymentSpec{
+			Template: corev1.PodTemplateSpec{
+				Spec: corev1.PodSpec{ServiceAccountName: renderedServiceAccount},
+			},
+		},
+	}
+	controller := Controller{
+		Client:                newFakeClient(),
+		ClientSet:             clientsetfake.NewSimpleClientset(serviceAccount, operatorDeployment),
+		InfoManifestClientSet: manifestv1alpha1fake.NewSimpleClientset(),
+	}
+	clusterOps := &clusteroperationv1alpha1.ClusterOperation{}
+	clusterOps.Name = "rendered-account-ops"
+	clusterOps.Spec.Image = "test-image"
+	clusterOps.Spec.HostsConfRef = &apis.ConfigMapRef{NameSpace: "workload-namespace", Name: "hosts"}
+	clusterOps.Spec.VarsConfRef = &apis.ConfigMapRef{NameSpace: "workload-namespace", Name: "vars"}
+	clusterOps.Spec.EntrypointSHRef = &apis.ConfigMapRef{NameSpace: "workload-namespace", Name: "entrypoint"}
+	if err := controller.Client.Create(context.Background(), clusterOps); err != nil {
+		t.Fatalf("create cluster operation: %v", err)
+	}
+
+	created, err := controller.CreateKubeSprayJob(clusterOps)
+	if err != nil {
+		t.Fatalf("create Kubespray job: %v", err)
+	}
+	if !created {
+		t.Fatal("expected the Kubespray job to be created")
+	}
+	job, err := controller.ClientSet.BatchV1().Jobs("operator-namespace").Get(context.Background(), "kubean-rendered-account-ops-job", metav1.GetOptions{})
+	if err != nil {
+		t.Fatalf("get created Kubespray job: %v", err)
+	}
+	if got := job.Spec.Template.Spec.ServiceAccountName; got != renderedServiceAccount {
+		t.Fatalf("job uses ServiceAccount %q, want %q", got, renderedServiceAccount)
+	}
+}
