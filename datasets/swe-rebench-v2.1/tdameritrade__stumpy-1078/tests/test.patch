+def test_check_window_size_excl_zone():
+    # To ensure a warning is raised when it is not feasible to obtain at
+    # least one pair of non-trivial motifs under the exclusion rule.
+    T = np.random.rand(10)
+    m = 8
+
+    # For `len(T) == 10` and `m == 8`, the `excl_zone` is ceil(m / 4) = 2.
+    # In this case, there are `10 - 8 + 1 = 3` subsequences of length 8,
+    # starting at indices 0, 1, and 2. The largest distance between any two
+    # start indices is `2`, which does not exceed the `excl_zone` of `2`.
+    # Therefore, there is no pair of start indices `i` and `j` satisfying
+    # `|i - j| > excl_zone` and a warning should be raised.
+    with pytest.warns(Warning):
+        stump(T, m)
+
+
+def test_check_window_size_excl_zone_feasible():
+    # To ensure that no warning is raised when at least one pair of
+    # non-trivial motifs can be obtained under the exclusion rule.
+    T = np.random.rand(10)
+    m = 3
+
+    # For `len(T) == 10` and `m == 3`, the `excl_zone` is ceil(m / 4) = 1.
+    # There are `10 - 3 + 1 = 8` subsequences and the start indices `0` and
+    # `7` satisfy `|0 - 7| = 7 > 1`, so a non-trivial pair exists and no
+    # warning should be raised.
+    with warnings.catch_warnings():
+        warnings.simplefilter("error")
+        stump(T, m)
+
+
