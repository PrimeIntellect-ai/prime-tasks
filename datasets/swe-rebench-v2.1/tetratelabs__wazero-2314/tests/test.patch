+func TestCompiler_callIndirectThroughReexport(t *testing.T) {
+	ctx := context.Background()
+	compiler := NewEngine(ctx, api.CoreFeaturesV1, nil)
+	defer compiler.Close()
+	store := wasm.NewStore(api.CoreFeaturesV1, compiler)
+
+	identityType := wasm.FunctionType{Params: []wasm.ValueType{wasm.ValueTypeI32}, Results: []wasm.ValueType{wasm.ValueTypeI32}}
+	providerExport := wasm.Export{Name: "f", Type: wasm.ExternTypeFunc, Index: 0}
+	provider := &wasm.Module{
+		TypeSection:     []wasm.FunctionType{identityType},
+		FunctionSection: []wasm.Index{0},
+		CodeSection:     []wasm.Code{{Body: []byte{wasm.OpcodeLocalGet, 0, wasm.OpcodeEnd}}},
+		ExportSection:   []wasm.Export{providerExport},
+		Exports:         map[string]*wasm.Export{"f": &providerExport},
+	}
+	providerInstance := instantiateForCallIndirect(t, store, ctx, provider, "provider", []wasm.FunctionTypeID{10})
+	defer providerInstance.Close(ctx)
+
+	middleImport := wasm.Import{Module: "provider", Name: "f", Type: wasm.ExternTypeFunc, DescFunc: 0}
+	middleExport := wasm.Export{Name: "f", Type: wasm.ExternTypeFunc, Index: 0}
+	middle := &wasm.Module{
+		TypeSection:         []wasm.FunctionType{identityType, {}},
+		ImportSection:       []wasm.Import{middleImport},
+		ImportFunctionCount: 1,
+		ImportPerModule:     map[string][]*wasm.Import{"provider": {&middleImport}},
+		FunctionSection:     []wasm.Index{1},
+		CodeSection:         []wasm.Code{{Body: []byte{wasm.OpcodeEnd}}},
+		ExportSection:       []wasm.Export{middleExport},
+		Exports:             map[string]*wasm.Export{"f": &middleExport},
+	}
+	middleInstance := instantiateForCallIndirect(t, store, ctx, middle, "middle", []wasm.FunctionTypeID{30})
+	defer middleInstance.Close(ctx)
+
+	callerImport := wasm.Import{Module: "middle", Name: "f", Type: wasm.ExternTypeFunc, DescFunc: 1}
+	callerExport := wasm.Export{Name: "run", Type: wasm.ExternTypeFunc, Index: 1}
+	caller := &wasm.Module{
+		TypeSection: []wasm.FunctionType{
+			{Results: []wasm.ValueType{wasm.ValueTypeI32}},
+			identityType,
+			identityType,
+		},
+		ImportSection:       []wasm.Import{callerImport},
+		ImportFunctionCount: 1,
+		ImportPerModule:     map[string][]*wasm.Import{"middle": {&callerImport}},
+		FunctionSection:     []wasm.Index{2},
+		TableSection:        []wasm.Table{{Type: wasm.RefTypeFuncref, Min: 1}},
+		ElementSection: []wasm.ElementSegment{{
+			OffsetExpr: wasm.ConstantExpression{Opcode: wasm.OpcodeI32Const, Data: []byte{0}},
+			TableIndex: 0, Type: wasm.RefTypeFuncref, Mode: wasm.ElementModeActive, Init: []wasm.Index{0},
+		}},
+		CodeSection: []wasm.Code{{Body: []byte{
+			wasm.OpcodeLocalGet, 0, wasm.OpcodeI32Const, 0,
+			wasm.OpcodeCallIndirect, 1, 0, wasm.OpcodeEnd,
+		}}},
+		ExportSection: []wasm.Export{callerExport},
+		Exports:       map[string]*wasm.Export{"run": &callerExport},
+	}
+	callerInstance := instantiateForCallIndirect(t, store, ctx, caller, "caller", []wasm.FunctionTypeID{30, 20, 20})
+	defer callerInstance.Close(ctx)
+
+	results, err := callerInstance.ExportedFunction("run").Call(ctx, 42)
+	require.NoError(t, err)
+	require.Equal(t, []uint64{42}, results)
+}
+
+func instantiateForCallIndirect(t *testing.T, store *wasm.Store, ctx context.Context, module *wasm.Module, name string, typeIDs []wasm.FunctionTypeID) *wasm.ModuleInstance {
+	t.Helper()
+	require.NoError(t, module.Validate(api.CoreFeaturesV1))
+	module.AssignModuleID([]byte(name), nil, false)
+	require.NoError(t, store.Engine.CompileModule(ctx, module, nil, false))
+	instance, err := store.Instantiate(ctx, module, name, sys.DefaultContext(nil), typeIDs)
+	require.NoError(t, err)
+	return instance
+}
