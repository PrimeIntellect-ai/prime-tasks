+// sequenceRecorder records the probe messages it receives, in order.
+type sequenceRecorder struct {
+	got []string
+}
+
+type sequenceProbeMsg string
+
+func (m *sequenceRecorder) Init() Cmd { return nil }
+
+func (m *sequenceRecorder) Update(msg Msg) (Model, Cmd) {
+	if pm, ok := msg.(sequenceProbeMsg); ok {
+		m.got = append(m.got, string(pm))
+	}
+	return m, nil
+}
+
+func (m *sequenceRecorder) View() string { return "" }
+
+func TestSequenceOrder(t *testing.T) {
+	m := &sequenceRecorder{}
+	p := NewProgram(
+		&sequenceOrderModel{recorder: m},
+		WithInput(strings.NewReader("")),
+		WithOutput(&bytes.Buffer{}),
+	)
+	if _, err := p.StartReturningModel(); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := []string{"slow", "fast"}
+	if strings.Join(m.got, ",") != strings.Join(want, ",") {
+		t.Fatalf("expected messages in order %v, got %v", want, m.got)
+	}
+}
+
+// sequenceOrderModel starts a sequence whose first command is slow, so that a
+// concurrent run would deliver "fast" first.
+type sequenceOrderModel struct {
+	recorder *sequenceRecorder
+}
+
+func (m *sequenceOrderModel) Init() Cmd {
+	return Sequence(
+		func() Msg {
+			time.Sleep(100 * time.Millisecond)
+			return sequenceProbeMsg("slow")
+		},
+		func() Msg { return sequenceProbeMsg("fast") },
+		Quit,
+	)
+}
+
+func (m *sequenceOrderModel) Update(msg Msg) (Model, Cmd) {
+	return m.recorder.Update(msg)
+}
+
+func (m *sequenceOrderModel) View() string { return "" }
+
+func TestSequencePrintBeforeQuit(t *testing.T) {
+	var out bytes.Buffer
+	p := NewProgram(
+		&sequencePrintModel{},
+		WithInput(strings.NewReader("")),
+		WithOutput(&out),
+	)
+	if _, err := p.StartReturningModel(); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	printed := out.String()
+	first := strings.Index(printed, "first line")
+	second := strings.Index(printed, "second line")
+	if first < 0 || second < 0 {
+		t.Fatalf("expected both printed lines before the program quit, got %q", printed)
+	}
+	if first > second {
+		t.Fatalf("expected printed lines in the order they were requested, got %q", printed)
+	}
+}
+
+// sequencePrintModel prints two lines and then quits, all in one sequence.
+type sequencePrintModel struct{}
+
+func (m *sequencePrintModel) Init() Cmd {
+	return Sequence(
+		Printf("first %s", "line"),
+		Println("second line"),
+		Quit,
+	)
+}
+
+func (m *sequencePrintModel) Update(msg Msg) (Model, Cmd) { return m, nil }
+
+func (m *sequencePrintModel) View() string { return "" }
