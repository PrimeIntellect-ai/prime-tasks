+
+#[test]
+fn package_json_available_adjacent_to_node_modules() {
+    use std::{path::Path, sync::Arc};
+
+    use crate::tests::memory_fs::MemoryFS;
+    use crate::{FsCache, ResolveOptions, ResolverGeneric};
+
+    let file_system = MemoryFS::new(&[
+        ("/project/package.json", r#"{"name":"project"}"#),
+        ("/project/node_modules/some-module/index.js", ""),
+        ("/project/dir-with-index/index.js", ""),
+    ]);
+
+    let resolver = ResolverGeneric::new_with_cache(
+        Arc::new(FsCache::new(file_system)),
+        ResolveOptions::default(),
+    );
+
+    // Populate the cache so that the `node_modules` directory is known.
+    let _ = resolver.resolve("/project", "some-module");
+
+    let resolution = resolver.resolve("/project/dir-with-index", "./index.js").unwrap();
+    let package_json = resolution.package_json();
+    assert_eq!(package_json.map(|p| p.path.as_path()), Some(Path::new("/project/package.json")));
+}
