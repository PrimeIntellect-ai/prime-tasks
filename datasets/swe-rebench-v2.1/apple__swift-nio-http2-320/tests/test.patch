diff --git a/Tests/NIOHTTP2Tests/SimpleClientServerFramePayloadStreamTests.swift b/Tests/NIOHTTP2Tests/SimpleClientServerFramePayloadStreamTests.swift
index ed9bb2f..f309dca 100644
--- a/Tests/NIOHTTP2Tests/SimpleClientServerFramePayloadStreamTests.swift
+++ b/Tests/NIOHTTP2Tests/SimpleClientServerFramePayloadStreamTests.swift
@@ -1960,4 +1960,88 @@ class SimpleClientServerFramePayloadStreamTests: XCTestCase {
         XCTAssertNoThrow(try self.clientChannel.finish())
         XCTAssertNoThrow(try self.serverChannel.finish())
     }
+
+    func testHTTP2HandlerDoesNotFlushExcessively() throws {
+        try self.basicHTTP2Connection()
+
+        class FlushCounter: ChannelOutboundHandler {
+            typealias OutboundIn = Never
+            var flushCount = 0
+
+            func flush(context: ChannelHandlerContext) {
+                self.flushCount += 1
+                context.flush()
+            }
+        }
+
+        let counter = FlushCounter()
+        XCTAssertNoThrow(try self.clientChannel.pipeline.syncOperations.addHandler(counter, position: .first))
+
+        // 'channelReadComplete' should cause the HTTP2Handler to emit a flush if any frames have
+        // been written. No frames have been written, so no flush should be emitted.
+        self.clientChannel.pipeline.fireChannelReadComplete()
+        XCTAssertEqual(counter.flushCount, 0)
+    }
+
+    func testHTTP2HandlerFlushesWrittenFramesOnReadComplete() throws {
+        try self.basicHTTP2Connection()
+
+        class FlushCounter: ChannelOutboundHandler {
+            typealias OutboundIn = Never
+            var flushCount = 0
+
+            func flush(context: ChannelHandlerContext) {
+                self.flushCount += 1
+                context.flush()
+            }
+        }
+
+        let counter = FlushCounter()
+        XCTAssertNoThrow(try self.clientChannel.pipeline.syncOperations.addHandler(counter, position: .first))
+
+        // Write a frame, but do not flush it.
+        let frame = HTTP2Frame(streamID: .rootStream, payload: .ping(HTTP2PingData(withInteger: 1), ack: false))
+        self.clientChannel.write(frame, promise: nil)
+        XCTAssertEqual(counter.flushCount, 0)
+
+        // A read-complete event must flush the frame that was written.
+        self.clientChannel.pipeline.fireChannelReadComplete()
+        XCTAssertEqual(counter.flushCount, 1)
+    }
+
+    func testHTTP2HandlerDoesNotFlushAgainAfterFlush() throws {
+        try self.basicHTTP2Connection()
+
+        class FlushCounter: ChannelOutboundHandler {
+            typealias OutboundIn = Never
+            var flushCount = 0
+
+            func flush(context: ChannelHandlerContext) {
+                self.flushCount += 1
+                context.flush()
+            }
+        }
+
+        let counter = FlushCounter()
+        XCTAssertNoThrow(try self.clientChannel.pipeline.syncOperations.addHandler(counter, position: .first))
+
+        let frame = HTTP2Frame(streamID: .rootStream, payload: .ping(HTTP2PingData(withInteger: 1), ack: false))
+
+        // Write a frame and flush it explicitly.
+        self.clientChannel.write(frame, promise: nil)
+        self.clientChannel.flush()
+        XCTAssertEqual(counter.flushCount, 1)
+
+        // A subsequent read-complete event with no intervening frame writes must not flush again.
+        self.clientChannel.pipeline.fireChannelReadComplete()
+        XCTAssertEqual(counter.flushCount, 1)
+
+        // Write another frame; the read-complete event flushes it, and a second read-complete event
+        // with no intervening writes must not flush again.
+        self.clientChannel.write(frame, promise: nil)
+        self.clientChannel.pipeline.fireChannelReadComplete()
+        XCTAssertEqual(counter.flushCount, 2)
+        self.clientChannel.pipeline.fireChannelReadComplete()
+        XCTAssertEqual(counter.flushCount, 2)
+    }
 }
