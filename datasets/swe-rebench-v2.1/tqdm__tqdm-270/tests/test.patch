+@with_setup(pretest, posttest)
+def test_postfix():
+    """Custom metrics given at creation are shown after the progress counter."""
+    with closing(StringIO()) as our_file:
+        with tqdm(total=10, file=our_file, mininterval=0,
+                  postfix={'score': 'new'}) as progress:
+            progress.update(5)
+            progress.refresh()
+            status = our_file.getvalue().split('\r')[-1]
+
+    counter_end = status.index('5/10') + len('5/10')
+    assert 'score' in status[counter_end:]
+    assert 'new' in status[counter_end:]
+
+
+@with_setup(pretest, posttest)
+def test_postfix_update():
+    """Metrics set on a running bar replace the previously displayed values."""
+    with closing(StringIO()) as our_file:
+        with tqdm(total=10, file=our_file, mininterval=0) as progress:
+            progress.set_postfix(score='first')
+            progress.update(3)
+            progress.set_postfix(score='second')
+            progress.update(2)
+            progress.refresh()
+            status = our_file.getvalue().split('\r')[-1]
+
+    assert 'second' in status
+    assert 'first' not in status
