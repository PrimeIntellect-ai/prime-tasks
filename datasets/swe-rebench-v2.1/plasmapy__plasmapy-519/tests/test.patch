+def test_ion_charge_state_can_be_changed():
+    """An ion can move to neighboring higher and lower charge states."""
+    electron = Particle('e-')
+    ion_to_ionize = Particle('Fe 5+')
+    ionize = getattr(ion_to_ionize, "ionize", None)
+    higher_charge = (
+        ionize() if callable(ionize) else ion_to_ionize - electron
+    )
+    if higher_charge is None:
+        higher_charge = ion_to_ionize
+
+    ion_to_recombine = Particle('Fe 5+')
+    recombine = getattr(ion_to_recombine, "recombine", None)
+    lower_charge = (
+        recombine() if callable(recombine) else ion_to_recombine + electron
+    )
+    if lower_charge is None:
+        lower_charge = ion_to_recombine
+
+    assert higher_charge == Particle('Fe 6+')
+    assert lower_charge == Particle('Fe 4+')
+
+
