+
+func TestGenerateModel_EmptyEnumValue(t *testing.T) {
+	// An empty value in a string enum must not cause a name conflict between
+	// the generated enum constant and the type.
+	log.SetOutput(ioutil.Discard)
+	defer log.SetOutput(os.Stdout)
+
+	specDoc, err := loads.Spec("../fixtures/canary/docker-v1.41/swagger.yaml")
+	if !assert.NoError(t, err) {
+		return
+	}
+
+	const typeName = "LocalNodeState"
+	schema, ok := specDoc.Spec().Definitions[typeName]
+	if !assert.True(t, ok) {
+		return
+	}
+	genModel, err := makeGenDefinition(typeName, "models", schema, specDoc, opts())
+	if !assert.NoError(t, err) {
+		return
+	}
+
+	buf := bytes.NewBuffer(nil)
+	// The enum constants are rendered by the validator template. Rendering may
+	// stop later on unrelated constructs, so only the rendered enum block is
+	// inspected.
+	_ = templates.MustGet("schemavalidator").Execute(buf, genModel.GenSchema)
+
+	rendered := buf.String()
+	start := strings.Index(rendered, "const (")
+	if !assert.GreaterOrEqual(t, start, 0, "expected the generated code to declare enum constants") {
+		return
+	}
+	rest := rendered[start:]
+	end := strings.Index(rest, ")")
+	if !assert.GreaterOrEqual(t, end, 0) {
+		return
+	}
+
+	fset := token.NewFileSet()
+	file, err := parser.ParseFile(fset, "enum.go", "package models\n"+rest[:end+1], 0)
+	if !assert.NoError(t, err) {
+		return
+	}
+	names := make(map[string]bool)
+	ast.Inspect(file, func(n ast.Node) bool {
+		if vs, ok := n.(*ast.ValueSpec); ok {
+			for _, id := range vs.Names {
+				names[id.Name] = true
+			}
+		}
+		return true
+	})
+	assert.NotContains(t, names, typeName,
+		"the generated enum constant for the empty value must not conflict with the type name")
 }
