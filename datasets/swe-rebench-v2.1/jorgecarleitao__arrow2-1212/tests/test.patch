+
+#[test]
+fn infer_object() -> Result<()> {
+    let data = r#"{"u64": 1, "f64": 0.1, "utf8": "foo1", "bools": true}
+    {"u64": 2, "f64": 0.2, "utf8": "foo2", "bools": false}
+    {"u64": 3, "f64": 0.3, "utf8": "foo3"}
+    {"u64": 4, "f64": 0.4, "utf8": "foo4", "bools": false}
+    "#;
+    let actual = infer(data)?;
+    let fields = match actual {
+        DataType::Struct(fields) => fields,
+        other => panic!("expected inferred struct, got {:?}", other),
+    };
+
+    assert_eq!(
+        fields.iter().map(|field| field.name.as_str()).collect::<Vec<_>>(),
+        vec!["u64", "f64", "utf8", "bools"]
+    );
+    Ok(())
+}
