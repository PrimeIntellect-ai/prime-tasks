+    #[test]
+    fn test_within_line_deletion_is_visibly_emphasized() {
+        let input = WITHIN_LINE_DELETION_INPUT;
+        let config = integration_test_utils::make_config(&[
+            "--minus-style",
+            "normal red",
+            "--minus-emph-style",
+            "normal blue",
+        ]);
+        let output = integration_test_utils::run_delta(input, &config);
+        let plain_output = strip_ansi_codes(&output);
+        assert!(plain_output.contains("foo!old!foo"));
+        assert!(plain_output.contains("foo!new!foo"));
+        let style_before = |text: &str| {
+            let text_start = output.find(text).unwrap();
+            let style_start = output[..text_start].rfind("\x1b[").unwrap();
+            let style_end = output[style_start..text_start].find('m').unwrap() + style_start;
+            &output[style_start..=style_end]
+        };
+        assert_ne!(style_before("foo"), style_before("old"));
+    }
