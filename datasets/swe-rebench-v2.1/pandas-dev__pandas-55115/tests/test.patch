diff --git a/pandas/tests/io/parser/test_header.py b/pandas/tests/io/parser/test_header.py
index d72174c404..938c7613ca 100644
--- a/pandas/tests/io/parser/test_header.py
+++ b/pandas/tests/io/parser/test_header.py
@@ -684,3 +684,41 @@ def test_header_delim_whitespace(all_parsers):
     result = parser.read_csv(StringIO(data), delim_whitespace=True)
     expected = DataFrame({"a,b": ["1,2", "3,4"]})
     tm.assert_frame_equal(result, expected)
+
+
+def test_usecols_no_header_pyarrow(pyarrow_parser_only):
+    parser = pyarrow_parser_only
+    data = """
+chr1,11874,12227,chr1,11874,12227,DDX11L1
+chr2,12228,12612,chr2,12228,12612,WASH7P
+"""
+    result = parser.read_csv(
+        StringIO(data),
+        header=None,
+        usecols=[0, 1, 2],
+        dtype="string[pyarrow]",
+        dtype_backend="pyarrow",
+        engine="pyarrow",
+    )
+    expected = DataFrame(
+        [["chr1", "11874", "12227"], ["chr2", "12228", "12612"]],
+        dtype="string[pyarrow]",
+    )
+    tm.assert_frame_equal(result, expected)
+
+
+def test_usecols_does_not_convert_unselected_columns_pyarrow(pyarrow_parser_only):
+    parser = pyarrow_parser_only
+    data = """chr1,11874,12227,chr1,11874,12227,not-an-integer
+chr2,12228,12612,chr2,12228,12612,also-not-an-integer
+"""
+    result = parser.read_csv(
+        StringIO(data),
+        header=None,
+        usecols=[0, 1, 2],
+        dtype={6: "int64"},
+        dtype_backend="pyarrow",
+        engine="pyarrow",
+    )
+    expected = DataFrame([["chr1", 11874, 12227], ["chr2", 12228, 12612]])
+    tm.assert_frame_equal(result.astype(object), expected.astype(object))
