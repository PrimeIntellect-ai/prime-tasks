index d58e93a..7a9da38 100644
--- a/test/absinthe/introspection_test.exs
+++ b/test/absinthe/introspection_test.exs
@@ -241,28 +241,23 @@ defmodule Absinthe.IntrospectionTest do
         """
         |> run(ComplexDefaultSchema)
 
-      assert_result(
-        {:ok,
-         %{
-           data: %{
-             "__schema" => %{
-               "queryType" => %{
-                 "fields" => [
-                   %{
-                     "args" => [
-                       %{
-                         "defaultValue" =>
-                           "{fancyEnum: FOO, fancyList: [FOO, BAR], fancyNested: {fancyBool: false}, fancyValue: \"qwerty\"}"
-                       }
-                     ]
-                   }
-                 ]
-               }
-             }
-           }
-         }},
-        result
-      )
+      assert {:ok, %{data: data}} = result
+      [field] = get_in(data, ["__schema", "queryType", "fields"])
+      [argument] = field["args"]
+      default_value = argument["defaultValue"]
+
+      default_fields =
+        Regex.scan(~r/([_A-Za-z][_0-9A-Za-z]*)\s*:/, default_value)
+        |> Enum.map(&List.last/1)
+        |> MapSet.new()
+
+      assert default_fields ==
+               MapSet.new(["fancyBool", "fancyEnum", "fancyList", "fancyNested", "fancyValue"])
+
+      assert Regex.match?(~r/fancyEnum\s*:\s*FOO/, default_value)
+      assert Regex.match?(~r/fancyList\s*:\s*\[\s*FOO\s*,?\s*BAR\s*\]/, default_value)
+      assert Regex.match?(~r/fancyNested\s*:\s*\{\s*fancyBool\s*:\s*false\s*\}/, default_value)
+      assert Regex.match?(~r/fancyValue\s*:\s*"qwerty"/, default_value)
     end
   end
 
@@ -545,4 +540,72 @@ defmodule Absinthe.IntrospectionTest do
       result
     )
   end
+
+  test "properly render partial default value input objects" do
+    {:ok, result} =
+      """
+      {
+        __schema {
+          queryType {
+            fields {
+              name
+              args {
+                name
+                defaultValue
+              }
+            }
+          }
+        }
+      }
+      """
+      |> run(Absinthe.Fixtures.ArgumentsSchema)
+
+    fields = get_in(result, [:data, "__schema", "queryType", "fields"])
+
+    field = Enum.find(fields, &(&1["name"] == "filterNumbers"))
+    assert %{"args" => args, "name" => "filterNumbers"} = field
+
+    assert %{"defaultValue" => filter_all_default} =
+             Enum.find(args, &(&1["name"] == "filterAll"))
+
+    field_names =
+      Regex.scan(~r/([_A-Za-z][_0-9A-Za-z]*)\s*:/, filter_all_default)
+      |> Enum.map(&List.last/1)
+      |> MapSet.new()
+
+    assert field_names == MapSet.new(["include", "exclude"])
+    assert Regex.match?(~r/include\s*:\s*\[\s*1\s*\]/, filter_all_default)
+    assert Regex.match?(~r/exclude\s*:\s*\[\s*2\s*,?\s*3\s*\]/, filter_all_default)
+
+    assert %{"defaultValue" => empty_default} = Enum.find(args, &(&1["name"] == "filterEmpty"))
+    assert Regex.match?(~r/^\{\s*\}$/, empty_default)
+    refute String.contains?(empty_default, "isEven")
+
+    assert %{"defaultValue" => exclude_default} =
+             Enum.find(args, &(&1["name"] == "filterExclude"))
+
+    assert Regex.match?(
+             ~r/^\{\s*exclude\s*:\s*\[\s*1\s*,?\s*2\s*,?\s*3\s*\]\s*\}$/,
+             exclude_default
+           )
+
+    assert %{"defaultValue" => include_default} =
+             Enum.find(args, &(&1["name"] == "filterInclude"))
+
+    assert Regex.match?(
+             ~r/^\{\s*include\s*:\s*\[\s*1\s*,?\s*2\s*,?\s*3\s*\]\s*\}$/,
+             include_default
+           )
+
+    assert %{"defaultValue" => scalar_default} = Enum.find(args, &(&1["name"] == "filterScalar"))
+    assert Regex.match?(~r/^\{\s*limit\s*:\s*7\s*\}$/, scalar_default)
+
+    assert %{"defaultValue" => boolean_default} =
+             Enum.find(args, &(&1["name"] == "filterBoolean"))
+
+    assert Regex.match?(~r/^\{\s*isEven\s*:\s*false\s*\}$/, boolean_default)
+
+    assert %{"defaultValue" => enum_default} = Enum.find(args, &(&1["name"] == "filterEnum"))
+    assert Regex.match?(~r/^\{\s*mode\s*:\s*FAST\s*\}$/, enum_default)
+  end
 end
