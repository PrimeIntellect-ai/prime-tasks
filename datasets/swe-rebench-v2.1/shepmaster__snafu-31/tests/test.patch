+// There are also happy-path tests
+
+mod outer {
+    pub mod inner {
+        use snafu::Snafu;
+
+        #[derive(Debug, Snafu)]
+        #[snafu_visibility = "pub(crate)"]
+        pub(crate) enum Error {
+            PubCrate,
+            #[snafu_visibility = "pub(in ::outer)"]
+            PubInPath,
+            #[snafu_visibility]
+            Private,
+        }
