@@ -0,0 +1,156 @@
+extern crate snafu;
+
+// There are also sad-path tests
+
+mod outer {
+    pub mod inner {
+        use snafu::Snafu;
+
+        #[derive(Debug, Snafu)]
+        #[snafu_visibility = "pub(crate)"]
+        pub(crate) enum Error {
+            PubCrate,
+            #[snafu_visibility = "pub(in ::outer)"]
+            PubInPath,
+            #[snafu_visibility = "pub"]
+            Pub,
+            #[snafu_visibility]
+            Private,
+        }
+    }
+
+    #[test]
+    fn can_set_default_visibility() {
+        let _ = self::inner::PubCrate.fail::<()>();
+    }
+
+    #[test]
+    fn can_set_visibility() {
+        let _ = self::inner::PubInPath.fail::<()>();
+    }
+}
+
+#[test]
+fn can_set_default_visibility() {
+    let _ = self::outer::inner::PubCrate.fail::<()>();
+}
+
+#[test]
+fn can_set_pub_visibility() {
+    let _ = self::outer::inner::Pub.fail::<()>();
+}
+
+#[test]
+fn fail_returns_the_corresponding_error_variant() {
+    match self::outer::inner::PubCrate.fail::<()>() {
+        Err(self::outer::inner::Error::PubCrate) => {}
+        _ => panic!("the selector should return its error variant"),
+    }
+}
+
+
+fn assert_external_code_reports_private(source: &str) {
+    use std::fs;
+    use std::process::Command;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    static NEXT_ID: AtomicUsize = AtomicUsize::new(0);
+    let deps = std::env::current_exe()
+        .unwrap()
+        .parent()
+        .unwrap()
+        .to_path_buf();
+    let snafu = fs::read_dir(&deps)
+        .unwrap()
+        .filter_map(Result::ok)
+        .map(|entry| entry.path())
+        .find(|path| {
+            path.file_name()
+                .and_then(|name| name.to_str())
+                .map(|name| name.starts_with("libsnafu-") && name.ends_with(".rlib"))
+                .unwrap_or(false)
+        })
+        .expect("the integration test's snafu dependency should be available");
+    let stem = format!(
+        "snafu_visibility_{}_{}",
+        std::process::id(),
+        NEXT_ID.fetch_add(1, Ordering::Relaxed)
+    );
+    let source_path = std::env::temp_dir().join(format!("{}.rs", stem));
+    let output_path = std::env::temp_dir().join(format!("{}.rlib", stem));
+    fs::write(&source_path, source).unwrap();
+    let result = Command::new("rustc")
+        .arg("--edition=2015")
+        .arg("--crate-type=lib")
+        .arg("--extern")
+        .arg(format!("snafu={}", snafu.display()))
+        .arg("-L")
+        .arg(format!("dependency={}", deps.display()))
+        .arg(&source_path)
+        .arg("-o")
+        .arg(&output_path)
+        .output()
+        .expect("rustc should be available to compile the external consumer");
+    let _ = fs::remove_file(source_path);
+    let _ = fs::remove_file(output_path);
+    let stderr = String::from_utf8_lossy(&result.stderr);
+    assert!(!result.status.success(), "the private selector unexpectedly compiled");
+    assert!(
+        stderr.contains("private"),
+        "expected a privacy error, got: {}",
+        stderr
+    );
+}
+
+#[test]
+fn selector_visibility_boundaries() {
+    assert_external_code_reports_private(
+        r#"
+extern crate snafu;
+mod outer {
+    pub mod inner {
+        use snafu::Snafu;
+        #[derive(Debug, Snafu)]
+        #[snafu_visibility = "pub(crate)"]
+        pub(crate) enum Error {
+            #[snafu_visibility = "pub(in ::outer)"]
+            Restricted,
+        }
+    }
+}
+fn probe() { let _ = outer::inner::Restricted.fail::<()>(); }
+"#,
+    );
+
+    assert_external_code_reports_private(
+        r#"
+extern crate snafu;
+mod outer {
+    pub mod inner {
+        use snafu::Snafu;
+        #[derive(Debug, Snafu)]
+        pub enum Error { Hidden }
+    }
+}
+fn probe() { let _ = outer::inner::Hidden.fail::<()>(); }
+"#,
+    );
+
+    assert_external_code_reports_private(
+        r#"
+extern crate snafu;
+mod outer {
+    pub mod inner {
+        use snafu::Snafu;
+        #[derive(Debug, Snafu)]
+        #[snafu_visibility = "pub(crate)"]
+        pub(crate) enum Error {
+            #[snafu_visibility]
+            Private,
+        }
+    }
+    fn probe() { let _ = inner::Private.fail::<()>(); }
+}
+"#,
+    );
+}
