+#[test]
+fn no_empty_text_after_markup_and_cdata_buffered() {
+    let input = format!("<root>{}<![CDATA[value]]><child/></root>", "x".repeat(10_001));
+    let mut reader = Reader::from_str(&input);
+    let mut buf = Vec::new();
+
+    loop {
+        match reader.read_event(&mut buf).unwrap() {
+            Event::Text(text) => assert!(!text.is_empty(), "reader emitted empty Text"),
+            Event::Eof => break,
+            _ => (),
+        }
+        buf.clear();
+    }
+}
+
+#[test]
+fn no_empty_text_after_markup_and_cdata_unbuffered() {
+    let input = format!("<root>{}<![CDATA[value]]><child/></root>", "x".repeat(10_001));
+    let mut reader = Reader::from_str(&input);
+
+    loop {
+        match reader.read_event_unbuffered().unwrap() {
+            Event::Text(text) => assert!(!text.is_empty(), "reader emitted empty Text"),
+            Event::Eof => break,
+            _ => (),
+        }
+    }
+}
+
+#[test]
+fn empty_comment_is_followed_directly_by_text_buffered() {
+    let mut reader = Reader::from_str("<!---->other content");
+    let mut buf = Vec::new();
+
+    match reader.read_event(&mut buf).unwrap() {
+        Event::Comment(comment) => assert!(comment.is_empty()),
+        event => panic!("expected empty Comment, got {:?}", event),
+    }
+    buf.clear();
+    match reader.read_event(&mut buf).unwrap() {
+        Event::Text(text) => assert_eq!(&*text, b"other content"),
+        event => panic!("expected text immediately after Comment, got {:?}", event),
+    }
+}
+
+#[test]
+fn empty_comment_is_followed_directly_by_text_unbuffered() {
+    let mut reader = Reader::from_str("<!---->other content");
+
+    match reader.read_event_unbuffered().unwrap() {
+        Event::Comment(comment) => assert!(comment.is_empty()),
+        event => panic!("expected empty Comment, got {:?}", event),
+    }
+    match reader.read_event_unbuffered().unwrap() {
+        Event::Text(text) => assert_eq!(&*text, b"other content"),
+        event => panic!("expected text immediately after Comment, got {:?}", event),
+    }
+}
