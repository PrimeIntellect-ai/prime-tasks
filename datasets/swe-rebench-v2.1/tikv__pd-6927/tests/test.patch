+// captureLogs replaces the global logger with one that records entries into an
+// in-memory observer, returning the recorded logs and a restore function.
+func captureLogs() (*observer.ObservedLogs, func()) {
+	core, logs := observer.New(zapcore.InfoLevel)
+	logger := zap.New(core)
+	restore := pclog.ReplaceGlobals(logger, &pclog.ZapProperties{
+		Core:   core,
+		Syncer: zapcore.AddSync(io.Discard),
+		Level:  zap.NewAtomicLevelAt(zapcore.InfoLevel),
+	})
+	return logs, restore
+}
