+    assert exc.error_type == "IllegalLocationConstraintException"
+    assert (
+        exc.message
+        == "The eu-central-1 location constraint is incompatible for the region specific endpoint this request was sent to."
+    )
+
+
+def test_invalid_location_constraint_exception():
+    from moto.s3.exceptions import InvalidLocationConstraintException
+    exc = InvalidLocationConstraintException()
+    assert exc.error_type == "InvalidLocationConstraint"
+    assert exc.message == "The specified location-constraint is not valid"
+
