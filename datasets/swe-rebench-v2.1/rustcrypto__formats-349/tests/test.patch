+    /// Regression test for `IMPLICIT` context-specific tagging of a `SET OF`
+    /// field: encoding must emit the context-specific tag rather than the
+    /// `SET` tag.
+    #[derive(Clone, Debug, Eq, PartialEq, Sequence)]
+    pub struct ImplicitContextSpecificSetOfVecExample {
+        #[asn1(context_specific = "0", tag_mode = "IMPLICIT")]
+        pub bar: SetOfVec<ObjectIdentifier>,
+    }
+
+    #[test]
+    fn implicit_context_specific_set_of_vec() {
+        let mut bar = SetOfVec::new();
+        bar.add(ObjectIdentifier::new("1.2.840.10045.2.1")).unwrap();
+
+        let example = ImplicitContextSpecificSetOfVecExample { bar };
+
+        // `[0] IMPLICIT SET OF` must be encoded with the context-specific
+        // constructed tag `0xA0`, not the `SET` tag `0x31`.
+        let der = example.to_vec().unwrap();
+        assert_eq!(der, hex!("30 0B A0 09 06 07 2A 86 48 CE 3D 02 01"));
+
+        // Decoding the context-specific field must round-trip.
+        let decoded = ImplicitContextSpecificSetOfVecExample::from_der(&der).unwrap();
+        assert_eq!(decoded, example);
+    }
