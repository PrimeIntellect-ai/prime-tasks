     ]
+
+
+def test_load_env_string_values():
+    # Environment variables whose values are not valid Python literals are
+    # used as strings instead of raising an error.
+    os.environ["INTAKE_CACHE"] = "./tmp"
+    os.environ["INTAKE_CACHE2"] = "tmp"
+    try:
+        with temp_conf({}) as fn:
+            config = Config(fn)
+        assert config["cache"] == "./tmp"
+        assert config["cache2"] == "tmp"
+    finally:
+        os.environ.pop("INTAKE_CACHE", None)
+        os.environ.pop("INTAKE_CACHE2", None)
+
+
+def test_load_env_warn():
+    # With environment_conf_parse set to "warn", an unparseable environment
+    # variable emits a UserWarning and is used as a string.
+    os.environ["INTAKE_CACHE"] = "./tmp"
+    os.environ["INTAKE_CACHE2"] = "tmp"
+    try:
+        with temp_conf({"environment_conf_parse": "warn"}) as fn:
+            with pytest.warns(UserWarning, match="environment variable"):
+                config = Config(fn)
+        assert config["cache"] == "./tmp"
+        assert config["cache2"] == "tmp"
+    finally:
+        os.environ.pop("INTAKE_CACHE", None)
+        os.environ.pop("INTAKE_CACHE2", None)
