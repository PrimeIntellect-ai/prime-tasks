+func TestDeviceAccessTokenIDToken(t *testing.T) {
+	storage := testProvider.Storage().(*storage.Storage)
+
+	tests := []struct {
+		name        string
+		deviceCode  string
+		userCode    string
+		scopes      []string
+		wantIDToken bool
+	}{
+		{
+			name:        "openid scope returns id token",
+			deviceCode:  "device-code-openid",
+			userCode:    "user-code-openid",
+			scopes:      []string{oidc.ScopeOpenID},
+			wantIDToken: true,
+		},
+		{
+			name:        "without openid scope no id token",
+			deviceCode:  "device-code-no-openid",
+			userCode:    "user-code-no-openid",
+			scopes:      []string{"profile"},
+			wantIDToken: false,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			require.NoError(t, storage.StoreDeviceAuthorization(context.Background(), "native", tt.deviceCode, tt.userCode, time.Now().Add(time.Minute), tt.scopes))
+			require.NoError(t, storage.CompleteDeviceAuthorization(context.Background(), tt.userCode, "id1"))
+
+			values := make(url.Values)
+			values.Set("client_id", "native")
+			values.Set("grant_type", string(oidc.GrantTypeDeviceCode))
+			values.Set("device_code", tt.deviceCode)
+
+			r := httptest.NewRequest(http.MethodPost, "/", strings.NewReader(values.Encode()))
+			r.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+			w := httptest.NewRecorder()
+
+			op.DeviceAccessToken(w, r, testProvider)
+
+			result := w.Result()
+			require.Less(t, result.StatusCode, 300)
+
+			var resp oidc.AccessTokenResponse
+			require.NoError(t, json.NewDecoder(result.Body).Decode(&resp))
+			assert.NotEmpty(t, resp.AccessToken)
+			assert.Equal(t, oidc.BearerToken, resp.TokenType)
+			assert.NotZero(t, resp.ExpiresIn)
+			if tt.wantIDToken {
+				assert.NotEmpty(t, resp.IDToken)
+			} else {
+				assert.Empty(t, resp.IDToken)
+			}
+		})
+	}
+}
