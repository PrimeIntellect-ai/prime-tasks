+#[test]
+fn completes_struct_via_doc_alias_in_fn_body() {
+    let actual = completion_list(
+        r#"
+#[doc(alias = "Bar")]
+struct Foo;
+
+fn here_we_go() {
+    $0
+}
+"#,
+    );
+    assert!(actual.contains("Foo (alias Bar)"), "{actual}");
+}
+
+#[test]
+fn completes_struct_via_multiple_doc_aliases_in_fn_body() {
+    let actual = completion_list(
+        r#"
+#[doc(alias("Bar", "Qux"))]
+#[doc(alias = "Baz")]
+struct Foo;
+
+fn here_we_go() {
+    B$0
+}
+"#,
+    );
+    assert!(actual.contains("Foo (alias Bar, Qux, Baz)"), "{actual}");
+}
