@@ -582,6 +582,70 @@ func TestProvisioningCancelled(t *testing.T) {
 			}
 		})
 	}
+
+	// A Host in the provisioned state that reports a provisioned registration
+	// error (for example from Adopt()) must not be deprovisioned. This is an
+	// externally observable state-transition outcome, so drive the state
+	// machine rather than inspecting internal helpers.
+	t.Run("provisioned with error", func(t *testing.T) {
+		host := metal3v1alpha1.BareMetalHost{
+			ObjectMeta: metav1.ObjectMeta{
+				Name:      "myhost",
+				Namespace: "myns",
+			},
+			Spec: metal3v1alpha1.BareMetalHostSpec{
+				Image: &metal3v1alpha1.Image{
+					URL: "same",
+				},
+				Online: true,
+			},
+			Status: metal3v1alpha1.BareMetalHostStatus{
+				ErrorType:    metal3v1alpha1.ProvisionedRegistrationError,
+				ErrorMessage: "Adoption failed",
+				ErrorCount:   1,
+				GoodCredentials: metal3v1alpha1.CredentialsStatus{
+					Reference: &corev1.SecretReference{
+						Name:      "secretRefName",
+						Namespace: "secretNs",
+					},
+					Version: "100",
+				},
+				TriedCredentials: metal3v1alpha1.CredentialsStatus{
+					Reference: &corev1.SecretReference{
+						Name:      "secretRefName",
+						Namespace: "secretNs",
+					},
+					Version: "100",
+				},
+				Provisioning: metal3v1alpha1.ProvisionStatus{
+					State: metal3v1alpha1.StateProvisioned,
+					Image: metal3v1alpha1.Image{
+						URL: "same",
+					},
+				},
+			},
+		}
+		prov := newMockProvisioner()
+		hsm := newHostStateMachine(&host, &BareMetalHostReconciler{}, prov, true)
+		info := makeDefaultReconcileInfo(&host)
+
+		hsm.ReconcileState(info)
+
+		assert.NotEqual(t, metal3v1alpha1.StateDeprovisioning, host.Status.Provisioning.State,
+			"a provisioned host with a provisioned registration error must not be deprovisioned")
+	})
+	t.Run("ordinary registration error", func(t *testing.T) {
+		hostObj := host(metal3v1alpha1.StateProvisioned).
+			SetStatusError(metal3v1alpha1.OperationalStatusError, metal3v1alpha1.RegistrationError, "Registration failed", 1).
+			build()
+		prov := newMockProvisioner()
+		prov.setNextError("ValidateManagementAccess", "registration retry failed")
+		hsm := newHostStateMachine(hostObj, &BareMetalHostReconciler{}, prov, true)
+
+		hsm.ReconcileState(makeDefaultReconcileInfo(hostObj))
+		assert.NotEqual(t, metal3v1alpha1.StateDeprovisioning, hostObj.Status.Provisioning.State,
+			"an ordinary registration error must not trigger adoption-error deprovisioning")
+	})
 }
 
