+def test_regression_objectives_defined_for_time_series_regression():
+    from evalml.objectives import MAE, MSE, R2, RegressionObjective
+
+    assert isinstance(RegressionObjective.problem_types, list)
+    assert ProblemTypes.REGRESSION in RegressionObjective.problem_types
+    assert ProblemTypes.TIME_SERIES_REGRESSION in RegressionObjective.problem_types
+    assert RegressionObjective.is_defined_for_problem_type(ProblemTypes.TIME_SERIES_REGRESSION)
+
+    for objective in [MSE, MAE, R2]:
+        assert isinstance(objective.problem_types, list)
+        assert ProblemTypes.REGRESSION in objective.problem_types
+        assert ProblemTypes.TIME_SERIES_REGRESSION in objective.problem_types
+        assert objective.is_defined_for_problem_type(ProblemTypes.REGRESSION)
+        assert objective.is_defined_for_problem_type(ProblemTypes.TIME_SERIES_REGRESSION)
+
+
+def test_classification_objectives_not_defined_for_time_series_regression():
+    from evalml.objectives import (
+        AccuracyBinary,
+        AccuracyMulticlass,
+        BinaryClassificationObjective,
+        MulticlassClassificationObjective,
+    )
+
+    assert isinstance(BinaryClassificationObjective.problem_types, list)
+    assert ProblemTypes.BINARY in BinaryClassificationObjective.problem_types
+    assert ProblemTypes.TIME_SERIES_REGRESSION not in BinaryClassificationObjective.problem_types
+    assert isinstance(MulticlassClassificationObjective.problem_types, list)
+    assert ProblemTypes.MULTICLASS in MulticlassClassificationObjective.problem_types
+    assert ProblemTypes.TIME_SERIES_REGRESSION not in MulticlassClassificationObjective.problem_types
+    assert not BinaryClassificationObjective.is_defined_for_problem_type(ProblemTypes.TIME_SERIES_REGRESSION)
+    assert not MulticlassClassificationObjective.is_defined_for_problem_type(ProblemTypes.TIME_SERIES_REGRESSION)
+
+    assert isinstance(AccuracyBinary.problem_types, list)
+    assert ProblemTypes.BINARY in AccuracyBinary.problem_types
+    assert ProblemTypes.TIME_SERIES_REGRESSION not in AccuracyBinary.problem_types
+    assert AccuracyBinary.is_defined_for_problem_type(ProblemTypes.BINARY)
+    assert not AccuracyBinary.is_defined_for_problem_type(ProblemTypes.TIME_SERIES_REGRESSION)
+
+    assert isinstance(AccuracyMulticlass.problem_types, list)
+    assert ProblemTypes.MULTICLASS in AccuracyMulticlass.problem_types
+    assert ProblemTypes.TIME_SERIES_REGRESSION not in AccuracyMulticlass.problem_types
+    assert AccuracyMulticlass.is_defined_for_problem_type(ProblemTypes.MULTICLASS)
+    assert not AccuracyMulticlass.is_defined_for_problem_type(ProblemTypes.TIME_SERIES_REGRESSION)
