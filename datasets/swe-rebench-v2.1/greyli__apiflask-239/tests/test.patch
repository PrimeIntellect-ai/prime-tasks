diff --git a/tests/test_decorators.py b/tests/test_decorators.py
index d1f7a40..5b7cb4e 100644
--- a/tests/test_decorators.py
+++ b/tests/test_decorators.py
@@ -1,4 +1,45 @@
+import re
+from pathlib import Path
+
 from apiflask import APIBlueprint
+from apiflask import HTTPBasicAuth
+
+
+def test_deprecation_warning_for_role(recwarn, app, client):
+    auth = HTTPBasicAuth()
+
+    @auth.verify_password
+    def verify_password(username, password):
+        return {'user': username}
+
+    @auth.get_user_roles
+    def get_roles(user):
+        return 'admin' if user['user'] == 'admin' else 'guest'
+
+    @app.get('/foo')
+    @app.auth_required(auth, role='admin')
+    def foo():
+        return 'ok'
+
+    assert client.get('/foo', headers={'Authorization': 'Basic Z3Vlc3Q6cHc='}).status_code == 403
+    assert client.get('/foo', headers={'Authorization': 'Basic YWRtaW46cHc='}).status_code == 200
+    w = recwarn.pop(DeprecationWarning)
+    message = str(w).lower()
+    assert 'role' in message and 'deprecated' in message and '1.1' in message and 'remov' in message
+
+
+def test_deprecation_warning_for_tag(recwarn, app, client):
+
+    @app.get('/foo')
+    @app.doc(tag='foo')
+    def foo():
+        pass
+
+    spec = client.get('/openapi.json').json
+    assert spec['paths']['/foo']['get']['tags'] == ['foo']
+    w = recwarn.pop(DeprecationWarning)
+    message = str(w).lower()
+    assert 'tag' in message and 'deprecated' in message and '1.1' in message and 'remov' in message
 
 
 def test_app_decorators(app):
@@ -14,3 +55,17 @@ def test_bp_decorators(app):
     assert hasattr(bp, 'input')
     assert hasattr(bp, 'output')
     assert hasattr(bp, 'doc')
+
+
+def test_documentation_and_examples_use_plural_decorator_parameters():
+    materials = []
+    for root in (Path('docs'), Path('examples')):
+        for path in root.rglob('*'):
+            if path.suffix in {'.md', '.py'}:
+                materials.append(path.read_text())
+
+    old_decorator_argument = re.compile(
+        r'\b(auth_required\s*\([^)]*\brole\s*=|doc\s*\([^)]*\btag\s*=)',
+        re.DOTALL,
+    )
+    assert old_decorator_argument.search('\n'.join(materials)) is None
