+
+            def _get_prefix(self):
+                return
+
+            def _reverse_transform(self, data):
+                num_rows = data.shape[0]
+                for column in self.columns:
+                    data[column] = np.arange(num_rows)
+
+                return data
+
+        # Setup
+        instance = HyperTransformer()
+        instance._multi_column_fields = {
+            'col1': ('col1', 'col2'),
