+mod test_opposing {
+    use super::*;
+
+    fn assert_opposing(flag: &str, opposing_flags: &[&str]) {
+        let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+        let mut flags = vec![flag];
+        flags.extend_from_slice(opposing_flags);
+        let out_no_flags = te.assert_success_and_get_output(".", &[]);
+        let out_opposing_flags = te.assert_success_and_get_output(".", &flags);
+
+        assert_eq!(
+            out_no_flags,
+            out_opposing_flags,
+            "{} should override {}",
+            opposing_flags.join(" "),
+            flag
+        );
+    }
+
+    #[test]
+    fn hidden() {
+        assert_opposing("--hidden", &["--no-hidden"]);
+    }
+
+    #[test]
+    fn no_ignore() {
+        assert_opposing("--no-ignore", &["--ignore"]);
+    }
+
+    #[test]
+    fn no_ignore_vcs() {
+        assert_opposing("--no-ignore-vcs", &["--ignore-vcs"]);
+    }
+
+    #[test]
+    fn follow() {
+        assert_opposing("--follow", &["--no-follow"]);
+    }
+
+    #[test]
+    fn absolute_path() {
+        assert_opposing("--absolute-path", &["--relative-path"]);
+    }
+
+    #[test]
+    fn u() {
+        assert_opposing("-u", &["--ignore"]);
+    }
+
+    #[test]
+    fn uu() {
+        assert_opposing("-uu", &["--ignore", "--no-hidden"]);
+    }
+}
+
 /// Print error if search pattern starts with a dot and --hidden is not set
 /// (Unix only, hidden files on Windows work differently)
 #[test]
