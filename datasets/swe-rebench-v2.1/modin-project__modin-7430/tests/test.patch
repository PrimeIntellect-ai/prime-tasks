@@ -58,3 +64,45 @@ def test_api_consistent(execution):
     assert (
         len(extra_methods) == 0
     ), f"{execution} implement these extra methods: {extra_methods}"
+
+
+SUPPORTED_ENGINES = ["Python", "Ray", "Dask"]
+STORAGE_FORMAT = "Pandas"
+
+
+def _engine_and_storage_format(obj):
+    query_compiler = obj._query_compiler
+    return query_compiler.engine, query_compiler.storage_format
+
+
+def test_dataframe_and_series_keep_their_selected_execution():
+    old_engine, old_format = modin.set_execution(
+        engine="Python", storage_format=STORAGE_FORMAT
+    )
+    try:
+        created = []
+        for engine in SUPPORTED_ENGINES:
+            modin.set_execution(engine=engine, storage_format=STORAGE_FORMAT)
+            dataframe = pd.DataFrame({"a": [1]})
+            series = pd.Series([1])
+            created.append((engine, dataframe, series))
+
+        # new objects report the execution selected when they were created
+        for engine, dataframe, series in created:
+            assert _engine_and_storage_format(dataframe) == (engine, STORAGE_FORMAT)
+            assert _engine_and_storage_format(series) == (engine, STORAGE_FORMAT)
+
+        # changing the selection again does not change existing objects
+        for engine in reversed(SUPPORTED_ENGINES):
+            modin.set_execution(engine=engine, storage_format=STORAGE_FORMAT)
+            for created_engine, dataframe, series in created:
+                assert _engine_and_storage_format(dataframe) == (
+                    created_engine,
+                    STORAGE_FORMAT,
+                )
+                assert _engine_and_storage_format(series) == (
+                    created_engine,
+                    STORAGE_FORMAT,
+                )
+    finally:
+        modin.set_execution(engine=old_engine, storage_format=old_format)
