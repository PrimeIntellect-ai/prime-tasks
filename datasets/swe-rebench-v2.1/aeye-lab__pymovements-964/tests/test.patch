diff --git a/tests/unit/datasets/datasets_test.py b/tests/unit/datasets/datasets_test.py
index 46eefd6..54b8893 100644
--- a/tests/unit/datasets/datasets_test.py
+++ b/tests/unit/datasets/datasets_test.py
@@ -172,3 +172,29 @@ def construct_public_dataset(
 
     dataset = pm.Dataset(public_dataset, path=init_path)
     return dataset, expected
+
+
+def test_paper_reading_data_has_download_and_load_resources():
+    definition = pm.datasets.UCL()
+    assert pm.DatasetLibrary.get('UCL') is type(definition)
+    assert definition.has_files.get('gaze') is False
+    assert definition.has_files.get('precomputed_events') is True
+    assert definition.has_files.get('precomputed_reading_measures') is True
+
+    for file_type in ('precomputed_events', 'precomputed_reading_measures'):
+        mirrors = definition.mirrors.get(file_type, ())
+        resources = definition.resources.get(file_type, ())
+        assert mirrors
+        assert all(
+            isinstance(mirror, str) and mirror.startswith(('http://', 'https://'))
+            for mirror in mirrors
+        )
+        assert resources
+        assert all(
+            isinstance(resource.get('resource'), str)
+            and resource['resource']
+            and isinstance(resource.get('filename'), str)
+            and resource['filename']
+            for resource in resources
+        )
+        assert definition.filename_format.get(file_type)
