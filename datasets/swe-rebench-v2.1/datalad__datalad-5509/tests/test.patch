+def _write_git_output_program(directory, output):
+    """Make git-config output deterministic for a ConfigManager integration test."""
+    program = directory / 'git'
+    program.write_text(
+        '#!' + os.sys.executable + '\n'
+        'import sys\n'
+        'sys.stdout.write(' + repr(output) + ')\n')
+    program.chmod(0o755)
+
+
+def test_config_manager_discards_unrelated_git_config_output(tmp_path):
+    bindir = tmp_path / 'bin'
+    bindir.mkdir()
+    output = (
+        'unfortunate stdout\non more lines\n'
+        'recovered.key\nvalue\0')
+    _write_git_output_program(bindir, output)
+
+    with patch.dict(os.environ, {
+            'PATH': str(bindir) + os.pathsep + os.environ['PATH']}):
+        cfg = ConfigManager()
+
+    assert_equal(cfg.get('recovered.key'), 'value')
+
+
+def test_config_manager_reloads_origin_file(tmp_path):
+    origin = tmp_path / 'config'
+    origin.write_text('first')
+    bindir = tmp_path / 'bin'
+    bindir.mkdir()
+    program = bindir / 'git'
+    program.write_text(
+        '#!' + os.sys.executable + '\n'
+        'import sys\n'
+        'sys.stdout.write(' + repr(f'file:{origin}\0tracked.key\n')
+        + ' + open(' + repr(str(origin)) + ').read() + ' + repr('\0') + ')\n')
+    program.chmod(0o755)
+
+    with patch.dict(os.environ, {
+            'PATH': str(bindir) + os.pathsep + os.environ['PATH']}):
+        cfg = ConfigManager()
+        assert_equal(cfg.get('tracked.key'), 'first')
+        origin.write_text('updated')
+        cfg.reload()
+
+    assert_equal(cfg.get('tracked.key'), 'updated')
+
+def test_config_manager_preserves_duplicate_config_values(tmp_path):
+    bindir = tmp_path / 'bin'
+    bindir.mkdir()
+    output = 'repeat.key\nfirst\0repeat.key\nsecond\0'
+    _write_git_output_program(bindir, output)
+
+    with patch.dict(os.environ, {
+            'PATH': str(bindir) + os.pathsep + os.environ['PATH']}):
+        cfg = ConfigManager()
+
+    assert_equal(cfg.get('repeat.key', get_all=True), ('first', 'second'))
+    assert_equal(cfg.get('repeat.key'), 'second')
+
+
