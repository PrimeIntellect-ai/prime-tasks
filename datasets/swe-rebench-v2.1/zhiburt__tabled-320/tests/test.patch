+#[test]
+fn conflicting_panel_leaves_table_unchanged() {
+    let mut table = tabled::Table::new([["a", "b"], ["c", "d"]]);
+    table.with(Modify::new((0, 0)).with(Span::row(2)));
+    let mut unchanged = table.clone();
+    let before = table.to_string();
+
+    table.with(Panel::horizontal(1, "conflicting panel"));
+
+    assert_eq!(table.to_string(), before);
+
+    // Reveal the covered cell as well, so an invisible content change cannot go unnoticed.
+    table.with(Modify::new((0, 0)).with(Span::row(1)));
+    unchanged.with(Modify::new((0, 0)).with(Span::row(1)));
+    assert_eq!(table.to_string(), unchanged.to_string());
+}
 
