+#[test]
+fn overlapping_panels_do_not_panic() {
+    let result = catch_unwind(AssertUnwindSafe(|| {
+        let mut table = tabled::Table::new([["a", "b"], ["c", "d"]]);
+        table
+            .with(Panel::header("heading"))
+            .with(Panel::footer("ending"))
+            .with(Panel::vertical(1, "side"));
+        table.to_string()
+    }));
+
+    assert!(result.is_ok(), "overlapping panels must not panic");
+}
+
+#[test]
+fn intersecting_spans_do_not_panic() {
+    let mut table = tabled::Table::new([["a", "b"], ["c", "d"]]);
+    table.with(Modify::new((0, 0)).with(Span::column(2)));
+
+    let result = catch_unwind(AssertUnwindSafe(|| {
+        table.with(Modify::new((0, 1)).with(Span::row(2)));
+    }));
+
+    assert!(result.is_ok(), "intersecting spans must not panic");
+}
