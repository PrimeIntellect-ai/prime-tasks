+describe('YAML Title', () => {
+  function expectGeneratedTitle(markdown: string, title: string) {
+    const result = rulesDict['yaml-title'].apply(markdown, {'Title Key': 'title'});
+    const frontMatter = result.match(/^---\n([\s\S]*?)\n---(?:\n|$)/);
+
+    expect(frontMatter).not.toBeNull();
+    expect(parseYaml(frontMatter![1])).toEqual(expect.objectContaining({title}));
+  }
+
+  it('Preserves a simple title as valid YAML', () => {
+    const before = dedent`
+    # Hello world
+    `;
+
+    expectGeneratedTitle(before, 'Hello world');
+  });
+
+  it('Preserves a title containing a colon as valid YAML', () => {
+    const before = dedent`
+    # Hello: world
+    `;
+
+    expectGeneratedTitle(before, 'Hello: world');
+  });
+
+  it('Preserves a title starting with a single quote as valid YAML', () => {
+    const before = dedent`
+    # 'Hello world
+    `;
+
+    expectGeneratedTitle(before, "'Hello world");
+  });
+
+  it('Preserves a title starting with a double quote as valid YAML', () => {
+    const before = dedent`
+    # "Hello world
+    `;
+
+    expectGeneratedTitle(before, '"Hello world');
+  });
+
+  it('Preserves a title starting with an unmatched square bracket as valid YAML', () => {
+    const before = dedent`
+    # [hello
+    `;
+
+    expectGeneratedTitle(before, '[hello');
+  });
+});
