+func TestMultipleDefinitionOfSamePathWithDifferentQueries(t *testing.T) {
+	r := NewRouter()
+	r.HandleFunc("/api", func(w http.ResponseWriter, r *http.Request) { _, _ = w.Write([]byte("foo route")) }).Queries("foo", "{foo:[0-9]+}").Methods(http.MethodGet)
+	r.HandleFunc("/api", func(w http.ResponseWriter, r *http.Request) { _, _ = w.Write([]byte("bar route")) }).Queries("bar", "{bar:[0-9]+}").Methods(http.MethodGet)
+
+	w := NewRecorder()
+	r.ServeHTTP(w, newRequest(http.MethodGet, "/api?bar=4"))
+	if got := w.Body.String(); got != "bar route" {
+		t.Errorf("Expected the route matching the bar query to respond, got %q", got)
+	}
+}
