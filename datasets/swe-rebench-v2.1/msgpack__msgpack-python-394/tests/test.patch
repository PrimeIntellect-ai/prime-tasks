diff --git a/test/test_timestamp.py b/test/test_timestamp.py
index 1348e69..7bcdf48 100644
--- a/test/test_timestamp.py
+++ b/test/test_timestamp.py
@@ -1,3 +1,5 @@
+import datetime
+
 import msgpack
 from msgpack import Timestamp
 
@@ -42,5 +44,26 @@ def test_timestamp():
 
 def test_timestamp_to():
     t = Timestamp(42, 14)
-    assert t.to_float_s() == 42.000000014
     assert t.to_unix_ns() == 42000000014
+
+
+def test_pack_datetime():
+    value = datetime.datetime(
+        2020, 1, 2, 3, 4, 5, 678901, tzinfo=datetime.timezone.utc
+    )
+
+    packed = msgpack.packb(value, datetime=True)
+
+    assert msgpack.unpackb(packed, timestamp=3) == value
+
+
+def test_pack_datetime_non_utc_offset():
+    tz = datetime.timezone(datetime.timedelta(hours=5))
+    # same instant as 2020-01-02 03:04:05.678901 UTC
+    value = datetime.datetime(2020, 1, 2, 8, 4, 5, 678901, tzinfo=tz)
+
+    packed = msgpack.packb(value, datetime=True)
+    unpacked = msgpack.unpackb(packed, timestamp=3)
+
+    assert unpacked == value
+    assert unpacked.utcoffset() == datetime.timedelta(0)
