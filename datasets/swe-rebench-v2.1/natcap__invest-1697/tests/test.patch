+    def test_zeropadded_monthly_filenames(self):
+        """SWY accepts zero-padded single-digit monthly input filenames."""
+        from natcap.invest.seasonal_water_yield import seasonal_water_yield
+
+        args = SeasonalWaterYieldRegressionTests.generate_base_args(
+            self.workspace_dir)
+        for input_dir in (args['precip_dir'], args['et0_dir']):
+            for month in range(1, 10):
+                month_suffix = '%d.tif' % month
+                month_name = next(
+                    name for name in os.listdir(input_dir)
+                    if (name.endswith(month_suffix) and
+                        not name[-len(month_suffix) - 1].isdigit()))
+                old_path = os.path.join(input_dir, month_name)
+                padded_name = (month_name[:-len(month_suffix)] + '0' +
+                               month_suffix)
+                os.rename(old_path, os.path.join(input_dir, padded_name))
+
+        args['user_defined_climate_zones'] = False
+        args['user_defined_local_recharge'] = False
+        args['monthly_alpha'] = False
+        seasonal_water_yield.execute(args)
+
+        aggregate_path = os.path.join(
+            self.workspace_dir, 'aggregated_results_swy.shp')
+        self.assertTrue(os.path.exists(aggregate_path))
+
