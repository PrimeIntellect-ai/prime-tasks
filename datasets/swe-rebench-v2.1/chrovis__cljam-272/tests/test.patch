+(deftest vcf-reader-accepts-case-insensitive-special-floats
+  (let [file (java.io.File/createTempFile "cljam-vcf-floats" ".vcf")]
+    (try
+      (spit file (str "##fileformat=VCFv4.3\n"
+                      "##INFO=<ID=F,Number=.,Type=Float,Description=\"values\">\n"
+                      "#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\n"
+                      "chr1\t1\t.\tA\tC\t.\tPASS\tF=nan,NAN,NaN,+NAN,-nAn,+INF,-INF,INF,inf,infinity,+INFINITY,-infinity\n"))
+      (with-open [r (vcf/reader file)]
+        (let [values (get-in (first (vcf/read-variants r)) [:info :F])]
+          (is (= 12 (count values)))
+          (is (every? #(Float/isNaN (float %)) (take 5 values)))
+          (is (= [Float/POSITIVE_INFINITY
+                  Float/NEGATIVE_INFINITY
+                  Float/POSITIVE_INFINITY
+                  Float/POSITIVE_INFINITY
+                  Float/POSITIVE_INFINITY
+                  Float/POSITIVE_INFINITY
+                  Float/NEGATIVE_INFINITY]
+                 (drop 5 values)))))
+      (finally
+        (.delete file)))))
