+
+describe('The navigation menu on a mobile screen', () => {
+  it('preserves the page position when the menu is opened and closed', () => {
+    let pageY = 240;
+    Object.defineProperty(window, 'scrollY', {
+      configurable: true,
+      get: () => pageY,
+    });
+    (window as any).scrollTo = jest.fn(
+      (x: number | ScrollToOptions, y?: number) => {
+        if (typeof x === 'number' && y !== undefined) {
+          pageY = y;
+        } else if (typeof x !== 'number' && x.top !== undefined) {
+          pageY = x.top;
+        }
+      }
+    );
+    (HTMLElement.prototype as any).scrollTo = jest.fn();
+    (window as any).requestAnimationFrame = jest.fn();
+    document.body.innerHTML = '<div class="nav"></div>';
+    window.innerWidth = 720;
+    const sections = createNavigationSectionData();
+    const { container } = render(
+      React.createElement(Navigation, {
+        sections,
+        currentSlug: 'test-slug-1',
+        previousSlug: '',
+        label: 'Secondary',
+        category: 'test1',
+      })
+    );
+    const menuButton = container.querySelector(
+      '.side-nav__open'
+    ) as HTMLElement;
+    fireEvent.click(menuButton);
+    expect(window.scrollY).toBe(240);
+    fireEvent.click(menuButton);
+    expect(window.scrollY).toBe(240);
   });
 });
