+
+// https://github.com/denoland/deno_lint/issues/1031
+// `deno lint` must not report `no-unreachable` for a `return` inside a
+// `finally` block.
+#[test]
+fn issue_1031() {
+  let src = r#"
+class Foo {
+  private async handleContext(ctx: Context<S>): Promise<Response> {
+    try {
+      ctx = await this.invokeHandlers(ctx, this.routes);
+    } catch (error) {
+      ctx.error = error;
+      ctx = await this.invokeHandlers(ctx, this.catchRoutes);
+    } finally {
+      ctx = await this.invokeHandlers(ctx, this.finallyRoutes);
+      return ctx.response;
+    }
+  }
+}
+"#;
+  crate::test_util::assert_lint_ok::<crate::rules::no_unreachable::NoUnreachable>(
+    src,
+    "issue_1031.ts",
+  );
+}
