+        assertEquals(new AuthConfig().getRegistryAddress(), "https://index.docker.io/v1/");
+    }
+
+    @Test
+    public void fluentSettersReturnSameInstance() throws Exception {
+        AuthConfig config = new AuthConfig();
+        assertSame(config.withEmail("foo"), config);
+        assertSame(config.withPassword("bar"), config);
+        assertSame(config.withUsername("qux"), config);
+        assertSame(config.withRegistryAddress("baz"), config);
+    }
+
+    @Test
+    public void fluentSettersSetValues() throws Exception {
+        assertEquals(authConfig.getEmail(), "foo");
+        assertEquals(authConfig.getPassword(), "bar");
+        assertEquals(authConfig.getUsername(), "qux");
+        assertEquals(authConfig.getRegistryAddress(), "baz");
+    }
+
+    @Test
+    public void shouldNotExposeMethodsNamedAsSetters() throws Exception {
+        for (Method method : AuthConfig.class.getMethods()) {
+            assertFalse(method.getName().matches("set[A-Z].*"),
+                    "AuthConfig must not expose a method named " + method.getName());
+        }
+    }
+
+    @Test
+    public void shouldNotExposeJavaBeansSetters() throws Exception {
+        BeanInfo beanInfo = Introspector.getBeanInfo(AuthConfig.class);
+        for (PropertyDescriptor descriptor : beanInfo.getPropertyDescriptors()) {
+            assertNull(descriptor.getWriteMethod(),
+                    "AuthConfig must not expose a JavaBeans setter for property " + descriptor.getName());
+        }
     }
 }
