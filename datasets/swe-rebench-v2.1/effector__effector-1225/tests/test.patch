+
+describe('clearNode with an external sample and shared targets', () => {
+  test('keeps delivering to a nonregional target after clearing the region', () => {
+    const region = createNode()
+    const regionalTarget = withRegion(region, () => createEvent<number>())
+    const externalTarget = createEvent<number>()
+    const clock = createEvent<number>()
+    const externalValues: number[] = []
+
+    externalTarget.watch(value => externalValues.push(value))
+    sample({clock, target: [regionalTarget, externalTarget]})
+
+    clock(0)
+    clearNode(region)
+    clock(1)
+
+    expect(externalValues).toEqual([0, 1])
+  })
+})
