+func TestEndpointSeparatePushUrl(t *testing.T) {
+	for desc, c := range map[string]struct {
+		Config   map[string]string
+		Download string
+		Upload   string
+	}{
+		"plain urls": {
+			Config: map[string]string{
+				"remote.test.url":     "https://example.com/foo/bar.git",
+				"remote.test.pushurl": "https://readwrite.com/foo/bar.git",
+			},
+			Download: "https://example.com/foo/bar.git/info/lfs",
+			Upload:   "https://readwrite.com/foo/bar.git/info/lfs",
+		},
+		"aliased urls": {
+			Config: map[string]string{
+				"remote.test.url":                           "ex:git-lfs/git-lfs.git",
+				"remote.test.pushurl":                       "push:git-lfs/git-lfs.git",
+				"url.https://example.com/.insteadof":        "ex:",
+				"url.ssh://push.example.com/.pushinsteadof": "push:",
+			},
+			Download: "https://example.com/git-lfs/git-lfs.git/info/lfs",
+			Upload:   "https://push.example.com/git-lfs/git-lfs.git/info/lfs",
+		},
+	} {
+		t.Run(desc, func(t *testing.T) {
+			finder := NewEndpointFinder(lfshttp.NewContext(nil, nil, c.Config))
+			assert.Equal(t, c.Download, finder.Endpoint("download", "test").Url)
+			assert.Equal(t, c.Upload, finder.Endpoint("upload", "test").Url)
+		})
+	}
+}
