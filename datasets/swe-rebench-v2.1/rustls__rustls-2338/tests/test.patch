+#[test]
+fn early_data_peek_does_not_consume_record() {
+    let expected: &[_] = b"early data that must remain available";
+
+    let mut server_config = make_server_config(KeyType::Rsa2048);
+    server_config.max_early_data_size = 128;
+    let server_config = Arc::new(server_config);
+
+    let mut client_config = make_client_config_with_versions(KeyType::Rsa2048, &[&TLS13]);
+    client_config.enable_early_data = true;
+    let client_config = Arc::new(client_config);
+
+    run(
+        client_config.clone(),
+        &mut NO_ACTIONS.clone(),
+        server_config.clone(),
+        &mut NO_ACTIONS.clone(),
+    );
+
+    let mut client_actions = Actions {
+        early_data_to_send: Some(expected),
+        ..NO_ACTIONS
+    };
+    let server_actions = Actions {
+        inspect_early_data_only: true,
+        ..NO_ACTIONS
+    };
+
+    let mut outcome = run(
+        client_config,
+        &mut client_actions,
+        server_config,
+        &mut server_actions.clone(),
+    );
+    let mut server = outcome.server.take().unwrap();
+
+    let UnbufferedStatus { state, .. } = server.process_tls_records(&mut []);
+    match state.unwrap() {
+        ConnectionState::ReadEarlyData(mut state) => {
+            assert_eq!(state.peek_len(), NonZeroUsize::new(expected.len()));
+            let record = state.next_record().unwrap().unwrap();
+            assert_eq!(record.payload, expected);
+        }
+        other => panic!("unexpected state {other:?} (wanted ReadEarlyData)"),
+    }
+}
