+package com.amihaiemil.eoyaml;
+
+import org.hamcrest.MatcherAssert;
+import org.hamcrest.Matchers;
+import org.junit.Test;
+
+/**
+ * Unit tests for the scalar readers' handling of the scalar start markers
+ * ('&gt;' for folded block scalars and '|' for literal block scalars).
+ * @author Mihai Andronache (amihaiemil@gmail.com)
+ * @version $Id$
+ * @since 4.0.0
+ */
+public final class NoScalarMarkersTest {
+
+    /**
+     * The folded block scalar reader ignores the '&gt;' marker line.
+     * @throws Exception If something goes wrong.
+     */
+    @Test
+    public void readsFoldedBlockScalarWithoutMarker() throws Exception {
+        final String newLine = System.lineSeparator();
+        MatcherAssert.assertThat(
+            Yaml.createYamlInput(
+                ">" + newLine
+              + "  some folded" + newLine
+              + "  block scalar"
+            ).readFoldedBlockScalar().value()
+                .replaceAll("\\s+", " ").trim(),
+            Matchers.equalTo("some folded block scalar")
+        );
+    }
+
+    /**
+     * The literal block scalar reader ignores the '|' marker line.
+     * @throws Exception If something goes wrong.
+     */
+    @Test
+    public void readsLiteralBlockScalarWithoutMarker() throws Exception {
+        final String newLine = System.lineSeparator();
+        MatcherAssert.assertThat(
+            Yaml.createYamlInput(
+                "|" + newLine
+              + "  line1" + newLine
+              + "  line2"
+            ).readLiteralBlockScalar().value().trim(),
+            Matchers.equalTo("line1" + newLine + "line2")
+        );
+    }
+}
