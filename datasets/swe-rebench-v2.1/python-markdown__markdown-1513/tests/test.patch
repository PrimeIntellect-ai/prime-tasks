+from markdown.inlinepatterns import InlineProcessor
+from markdown.util import AtomicString
+import xml.etree.ElementTree as etree
+
+
+class _MathInlineProcessor(InlineProcessor):
+    """A minimal stand-in for a math extension which protects math from inline parsing."""
+
+    def handleMatch(self, m, data):
+        el = etree.Element('span')
+        el.text = AtomicString(m.group(0))
+        return el, m.start(0), m.end(0)
+
+
+class _MathExtension(Extension):
+    """A minimal stand-in for a math extension which protects math from inline parsing."""
+
+    def extendMarkdown(self, md):
+        md.inlinePatterns.register(_MathInlineProcessor(r'\$[^$]+\$', md), 'math', 200)
 
 
