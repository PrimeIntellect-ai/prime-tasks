+    @Test
+    public void testStringSortCaseSensitive() throws Exception {
+        ProjectManager.singleton.deleteProject(project.id);
+        project = createCSVProject(
+                "key,first\n" +
+                        "1,b\n" +
+                        "2,d\n" +
+                        "3,f\n" +
+                        "4,h\n" +
+                        "5,F\n" +
+                        "6,f\n");
+        String sortingJson = "{\"criteria\":[{\"column\":\"first\",\"valueType\":\"string\",\"reverse\":false,\"blankPosition\":2,\"errorPosition\":1,\"caseSensitive\":true}]}";
+        SortingConfig sortingConfig = SortingConfig.reconstruct(sortingJson);
+        AbstractOperation op = new RowReorderOperation(Mode.RowBased, sortingConfig);
+        Process process = op.createProcess(project, new Properties());
+        process.performImmediate();
+
+        Assert.assertEquals(project.rows.get(0).cells.get(1).value, "b");
+        Assert.assertEquals(project.rows.get(1).cells.get(1).value, "d");
+        // Case-only differences must be distinguished: the "F" row may come before or after the
+        // two "f" rows depending on the case order chosen, but the case-variants must not interleave.
+        Object v2 = project.rows.get(2).cells.get(1).value;
+        Object v3 = project.rows.get(3).cells.get(1).value;
+        Object v4 = project.rows.get(4).cells.get(1).value;
+        int countLower = 0;
+        int countUpper = 0;
+        for (Object v : new Object[] { v2, v3, v4 }) {
+            if ("f".equals(v)) {
+                countLower++;
+            } else if ("F".equals(v)) {
+                countUpper++;
+            }
+        }
+        Assert.assertEquals(countLower, 2);
+        Assert.assertEquals(countUpper, 1);
+        Assert.assertTrue(v2.equals(v3) || v3.equals(v4),
+                "case variants of the same letter should be grouped together");
+        Assert.assertEquals(project.rows.get(5).cells.get(1).value, "h");
+    }
