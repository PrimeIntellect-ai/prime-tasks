+macro_rules! setting_write {
+    ($service:expr, put, $url:expr) => {
+        ($service).put($url, serde_json::Value::Null).await
+    };
+    ($service:expr, put_or_patch, $url:expr) => {{
+        let (response, code) = ($service).put($url.clone(), serde_json::Value::Null).await;
+        if code == 202 {
+            (response, code)
+        } else {
+            ($service).patch($url, serde_json::Value::Null).await
+        }
+    }};
+}
