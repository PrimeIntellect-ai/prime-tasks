+macro_rules! test_reset_setting_route {
+    ($test_name:ident, $setting:ident, $route:literal, $custom_value:expr) => {
+        #[actix_rt::test]
+        async fn $test_name() {
+            let server = Server::new().await;
+            let index = server.index("test");
+            let (response, code) = index.create(None).await;
+            assert_eq!(code, 202, "{}", response);
+            index.wait_task(0).await;
+
+            let url = format!("/indexes/test/settings/{}", $route);
+            let (response, code) = server
+                .service
+                .put(url.clone(), json!($custom_value))
+                .await;
+            let (response, code) = if code == 202 {
+                (response, code)
+            } else {
+                server
+                    .service
+                    .patch(url.clone(), json!($custom_value))
+                    .await
+            };
+            assert_eq!(code, 202, "{}", response);
+            index.wait_task(1).await;
+
+            let (response, code) = server.service.get(url.clone()).await;
+            assert_eq!(code, 200, "{}", response);
+            assert_eq!(response, json!($custom_value));
+
+            let (response, code) = server.service.delete(url.clone()).await;
+            assert_eq!(code, 202, "{}", response);
+            let task = index.wait_task(2).await;
+            assert_eq!(task["status"], "succeeded", "{}", task);
+
+            let (response, code) = server.service.get(url).await;
+            assert_eq!(code, 200, "{}", response);
+            assert_eq!(response, *DEFAULT_SETTINGS_VALUES.get(stringify!($setting)).unwrap());
+        }
+    };
+}
+
+test_reset_setting_route!(
+    reset_pagination_through_its_subroute,
+    pagination,
+    "pagination",
+    json!({ "limitedTo": 17 })
+);
+test_reset_setting_route!(
+    reset_faceting_through_its_subroute,
+    faceting,
+    "faceting",
+    json!({ "maxValuesPerFacet": 23 })
 );
 
 #[actix_rt::test]
