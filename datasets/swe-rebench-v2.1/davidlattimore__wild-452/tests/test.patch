diff --git a/wild/tests/sources/whole_archive.c b/wild/tests/sources/whole_archive.c
new file mode 100644
index 0000000..26bdbb4
--- /dev/null
+++ b/wild/tests/sources/whole_archive.c
@@ -0,0 +1,54 @@
+//#Object:exit.c
+
+//#LinkArgs:--whole-archive
+//#Archive:whole_archive0.c
+
+//#Config: selective
+//#Object:exit.c
+//#LinkArgs:--whole-archive --no-whole-archive
+//#CompArgs:-DSELECTIVE
+//#Archive:whole_archive0.c
+
+//#Config: push_pop
+//#Object:exit.c
+//#LinkArgs:--whole-archive --push-state --no-whole-archive --pop-state
+//#Archive:whole_archive0.c
+
+//#Config: selective_referenced
+//#Object:exit.c
+//#LinkArgs:--whole-archive --no-whole-archive
+//#CompArgs:-DREFERENCED
+//#Archive:whole_archive0.c
+
+#include "exit.h"
+
+extern int __start_foo[];
+extern int __stop_foo[];
+
+#ifdef REFERENCED
+extern int whole_archive_needed(void);
+#endif
+
+static int base_foo __attribute__ ((used, retain, section ("foo"))) = 0;
+
+void _start(void) {
+    int value = 0;
+
+    for (int *foo = __start_foo; foo < __stop_foo; ++foo) {
+        value += *foo;
+    }
+
+#ifdef REFERENCED
+    // The archive member defining whole_archive_needed() must be extracted to resolve this
+    // reference, which in turn contributes 42 to the sum above.
+    value += whole_archive_needed();
+    exit_syscall(value == 42 ? 42 : 43);
+#elif defined(SELECTIVE)
+    if (value != 0) {
+        exit_syscall(43);
+    }
+    exit_syscall(42);
+#else
+    exit_syscall(value);
+#endif
+}
