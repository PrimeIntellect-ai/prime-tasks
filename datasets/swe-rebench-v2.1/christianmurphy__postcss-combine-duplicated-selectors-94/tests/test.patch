@@ -296,3 +299,59 @@ test(
   '@media print { a{ color: blue; } } @MEDIA print { a{ background: green; } }',
   '@media print { a{ color: blue; background: green; } } @MEDIA print { }'
 );
+
+test(
+  'does not use the deprecated Node#moveTo API',
+  (t) => {
+    const pluginPath = path.join(__dirname, '..', 'src');
+    const script = [
+      'const postcss = require("postcss");',
+      `const plugin = require(${JSON.stringify(pluginPath)});`,
+      'const warnings = [];',
+      'const originalWarn = console.warn;',
+      'console.warn = (message) => warnings.push(String(message));',
+      'postcss([plugin]).process(".a {color: black} .a {color: red}").css;',
+      'console.warn = originalWarn;',
+      'process.stdout.write(JSON.stringify(warnings));',
+    ].join('\n');
+    const output = execFileSync(process.execPath, ['-e', script], {
+      cwd: path.join(__dirname, '..'),
+      encoding: 'utf8',
+    });
+    const warnings = JSON.parse(output);
+    t.false(
+      warnings.some((warning) =>
+        /deprecated.*Node#moveTo|Node#moveTo.*deprecated/i.test(warning)
+      ),
+      `deprecation warning emitted: ${warnings.join(', ')}`
+    );
+  }
+);
+
+test(
+  'moves declarations with Container#append',
+  (t) => {
+    const root = postcss.parse('.a {color: black} .a {color: red}');
+    const rulePrototype = Object.getPrototypeOf(root.first);
+    const originalAppend = rulePrototype.append;
+    let movedDeclaration = false;
+
+    rulePrototype.append = function append(node) {
+      const nodes = Array.isArray(node) ? node : [node];
+      if (this.type === 'rule' && nodes.some((item) =>
+        item.type === 'decl' && item.parent !== this
+      )) {
+        movedDeclaration = true;
+      }
+      return originalAppend.call(this, node);
+    };
+
+    try {
+      postcss([plugin]).process(root, {from: undefined}).css;
+    } finally {
+      rulePrototype.append = originalAppend;
+    }
+
+    t.true(movedDeclaration);
+  }
+);
