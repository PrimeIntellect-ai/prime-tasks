+
+/// Runs the compiled `mdq` binary as a child process, feeding `stdin` to it.
+fn run_cli(args: &[&str], stdin: &str) -> std::process::Output {
+    use std::io::Write;
+    use std::process::{Command, Stdio};
+
+    let mut child = Command::new(env!("CARGO_BIN_EXE_mdq"))
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("failed to spawn mdq");
+    child
+        .stdin
+        .take()
+        .expect("failed to open mdq stdin")
+        .write_all(stdin.as_bytes())
+        .expect("failed to write mdq stdin");
+    child.wait_with_output().expect("failed to wait for mdq")
+}
+
+const EXIT_MD: &str = "[fizz](https://example.com/buzz)\n";
+
+#[test]
+fn process_exits_zero_when_items_found() {
+    let output = run_cli(&["--link-format", "keep", "[]()"], EXIT_MD);
+    assert_eq!(output.status.code(), Some(0), "stderr: {}", String::from_utf8_lossy(&output.stderr));
+}
+
+#[test]
+fn process_exits_one_when_no_items_found() {
+    let output = run_cli(&["--link-format", "keep", "[no match]()"], EXIT_MD);
+    assert_eq!(output.status.code(), Some(1), "stderr: {}", String::from_utf8_lossy(&output.stderr));
+}
+
+#[test]
+fn process_quiet_suppresses_output_and_exits_zero_on_match() {
+    let output = run_cli(&["--link-format", "keep", "[]()", "-q"], EXIT_MD);
+    assert_eq!(output.status.code(), Some(0), "stderr: {}", String::from_utf8_lossy(&output.stderr));
+    assert!(output.stdout.is_empty(), "quiet should print nothing, got: {:?}", String::from_utf8_lossy(&output.stdout));
+}
+
+#[test]
+fn process_quiet_exits_one_when_no_items_found() {
+    let output = run_cli(&["--link-format", "keep", "[no match]()", "-q"], EXIT_MD);
+    assert_eq!(output.status.code(), Some(1), "stderr: {}", String::from_utf8_lossy(&output.stderr));
+    assert!(output.stdout.is_empty(), "quiet should print nothing, got: {:?}", String::from_utf8_lossy(&output.stdout));
+}
+
+#[test]
+fn process_long_quiet_suppresses_output_and_preserves_exit_status() {
+    let matched = run_cli(&["--link-format", "keep", "[]()", "--quiet"], EXIT_MD);
+    assert_eq!(matched.status.code(), Some(0), "stderr: {}", String::from_utf8_lossy(&matched.stderr));
+    assert!(matched.stdout.is_empty(), "quiet should print nothing, got: {:?}", String::from_utf8_lossy(&matched.stdout));
+
+    let unmatched = run_cli(&["--link-format", "keep", "[no match]()", "--quiet"], EXIT_MD);
+    assert_eq!(unmatched.status.code(), Some(1), "stderr: {}", String::from_utf8_lossy(&unmatched.stderr));
+    assert!(unmatched.stdout.is_empty(), "quiet should print nothing, got: {:?}", String::from_utf8_lossy(&unmatched.stdout));
+}
