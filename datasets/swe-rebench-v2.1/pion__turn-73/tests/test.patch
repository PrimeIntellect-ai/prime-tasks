diff --git a/server_test.go b/server_test.go
index e265f26..8abfc02 100644
--- a/server_test.go
+++ b/server_test.go
@@ -1,12 +1,19 @@
 package turn
 
 import (
+	"bytes"
+	"context"
 	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
 	"testing"
 	"time"
 
 	"github.com/gortc/turn"
 	"github.com/pion/logging"
+	"github.com/pion/stun"
 	"github.com/stretchr/testify/assert"
 )
 
@@ -136,4 +143,104 @@ func TestServer(t *testing.T) {
 		err = server.Close()
 		assert.NoError(t, err, "should succeed")
 	})
+
+	t.Run("Adds SOFTWARE attribute to response", func(t *testing.T) {
+		const testSoftware = "SERVER_SOFTWARE"
+
+		// Build the simple TURN server command and run it with SOFTWARE set.
+		// Reading the command source makes the cached test result depend on it,
+		// because the command is built in a child process.
+		if _, err := os.ReadFile(filepath.Join("cmd", "simple-turn", "main.go")); err != nil {
+			t.Fatal(err)
+		}
+		serverBin := filepath.Join(t.TempDir(), "simple-turn")
+		if output, err := exec.Command("go", "build", "-o", serverBin, "./cmd/simple-turn").CombinedOutput(); err != nil {
+			t.Fatalf("failed to build server command: %v\n%s", err, output)
+		}
+
+		// The server command listens on the system's non-loopback IPv4 addresses.
+		var serverIP net.IP
+		addrs, err := net.InterfaceAddrs()
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, addr := range addrs {
+			if ipNet, ok := addr.(*net.IPNet); ok && !ipNet.IP.IsLoopback() && ipNet.IP.To4() != nil {
+				serverIP = ipNet.IP.To4()
+				break
+			}
+		}
+		if serverIP == nil {
+			t.Skip("no non-loopback IPv4 address available")
+		}
+
+		probe, err := net.ListenPacket("udp4", net.JoinHostPort(serverIP.String(), "0"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		port := probe.LocalAddr().(*net.UDPAddr).Port
+		assert.NoError(t, probe.Close(), "should succeed")
+
+		ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
+		defer cancel()
+		var serverOutput bytes.Buffer
+		cmd := exec.CommandContext(ctx, serverBin)
+		cmd.Env = append(os.Environ(),
+			"USERS=user=pass",
+			"REALM=pion.ly",
+			"UDP_PORT="+strconv.Itoa(port),
+			"SOFTWARE="+testSoftware,
+		)
+		cmd.Stdout = &serverOutput
+		cmd.Stderr = &serverOutput
+		if err := cmd.Start(); err != nil {
+			t.Fatal(err)
+		}
+		defer func() {
+			_ = cmd.Process.Kill()
+			_ = cmd.Wait()
+		}()
+
+		conn, err := net.ListenPacket("udp4", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer func() {
+			assert.NoError(t, conn.Close(), "should succeed")
+		}()
+
+		req, err := stun.Build(stun.TransactionID, stun.BindingRequest)
+		if err != nil {
+			t.Fatal(err)
+		}
+		serverAddr := &net.UDPAddr{IP: serverIP, Port: port}
+
+		// Retry the binding request until the server command is listening.
+		deadline := time.Now().Add(30 * time.Second)
+		for {
+			if _, err := conn.WriteTo(req.Raw, serverAddr); err != nil {
+				t.Fatal(err)
+			}
+			if err := conn.SetReadDeadline(time.Now().Add(200 * time.Millisecond)); err != nil {
+				t.Fatal(err)
+			}
+			buf := make([]byte, 1500)
+			n, _, readErr := conn.ReadFrom(buf)
+			if readErr == nil {
+				resp := &stun.Message{Raw: append([]byte{}, buf[:n]...)}
+				if err := resp.Decode(); err != nil {
+					t.Fatalf("failed to decode binding response: %v", err)
+				}
+				var software stun.Software
+				if err := software.GetFrom(resp); err != nil {
+					t.Fatalf("binding response should carry a SOFTWARE attribute: %v\n%s", err, serverOutput.String())
+				}
+				assert.Equal(t, testSoftware, software.String())
+				return
+			}
+			if time.Now().After(deadline) {
+				t.Fatalf("server did not answer binding request: %v\n%s", readErr, serverOutput.String())
+			}
+		}
+	})
 }
