+====document====
+openapi: 3.0.2
+info:
+  title: Circular circurlarity
+  description: This is a description
+  version: draft
+  contact: 
+    email: me@me.com
+paths:
+  /self_referencing_graphs:
+    get:
+      description: A good one.
+      responses:
+        '200':
+          description: Hello
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/descriptor'
+              example:
+                A weird example.
+  /cyclic_graphs:
+    get:
+      description: A good one.
+      responses:
+        '200':
+          description: Hello
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/descriptor'
+              example:
+                A weird example.
+  /looping_graphs:
+    get:
+      description: A good one.
+      responses:
+        '200':
+          description: Hello
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/descriptor'
+              example:
+                A weird example.
+components:
+  schemas:
+    links:
+      type: object
+      properties:
+        id:
+          type: string
+        references:
+          type: array
+          items:
+            $ref: '#/components/schemas/links'
+    descriptor:
+      type: object
+      properties:
+        id:
+          type: string
+        links:
+          $ref: '#/components/schemas/links'
+      example:
+        processes:
+          - id: 17
