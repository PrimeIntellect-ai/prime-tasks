+    def test_cond_direct_controlled_cry(self):
+        """A conditional operation may itself be a controlled rotation."""
+        dev = qml.device("default.qubit", wires=3)
+
+        @qml.defer_measurements
+        @qml.qnode(dev)
+        def circuit(theta):
+            qml.Hadamard(0)
+            mcm = qml.measure(0)
+            qml.cond(mcm, qml.CRY)(theta, wires=(0, 1))
+            return qml.expval(qml.PauliZ(1))
+
+        theta = 0.6
+        assert np.allclose(circuit(theta), 0.5 * (1 + np.cos(theta)))
+
+    def test_cond_direct_controlled_phase(self):
+        """Conditional deferral handles controlled phase operations as well."""
+        dev = qml.device("default.qubit", wires=4)
+
+        @qml.defer_measurements
+        @qml.qnode(dev)
+        def circuit(theta):
+            qml.PauliX(0)
+            mcm = qml.measure(0)
+            qml.Hadamard(1)
+            qml.PauliX(2)
+            qml.cond(mcm, qml.ControlledPhaseShift)(theta, wires=(1, 2))
+            return qml.expval(qml.PauliX(1))
+
+        theta = 0.6
+        assert np.allclose(circuit(theta), np.cos(theta))
+
