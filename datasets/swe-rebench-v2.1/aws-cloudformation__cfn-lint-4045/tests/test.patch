+def _error_key(err):
+    """User-facing identity of a validation error.
+
+    The public contract is about which problems are reported and where they
+    occur, not about the internal schema composition (``schema_path``), the
+    keyword that produced the error (``validator``) or the exact wording of the
+    diagnostic (``message``).  Comparing only the rule and the path keeps the
+    tests behavioural so that any implementation reporting the same problems at
+    the same locations is accepted, regardless of how it words the message.
+    """
+    return (
+        err.rule.id if err.rule is not None else None,
+        tuple(err.path),
+    )
+
