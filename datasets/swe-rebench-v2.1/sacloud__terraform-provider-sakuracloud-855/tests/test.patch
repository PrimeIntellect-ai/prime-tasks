+func TestSakuraCloudRouterReadTracksPreviousID(t *testing.T) {
+	ctx := context.Background()
+	caller := testutil.SingletonAPICaller()
+	zone := testutil.TestZone()
+	op := sacloud.NewInternetOp(caller)
+	builder := &internetBuilder.Builder{
+		Name: testutil.ResourceName("router-previous-id-provider-test"), NetworkMaskLen: 28,
+		BandWidthMbps: 100, Client: internetBuilder.NewAPIClient(caller),
+	}
+	router, err := builder.Build(ctx, zone)
+	if err != nil {
+		t.Fatal(err)
+	}
+	previousTag := fmt.Sprintf("@previous-id=%s", router.ID)
+	if err := op.Delete(ctx, zone, router.ID); err != nil {
+		t.Fatal(err)
+	}
+	builder.Name = testutil.ResourceName("router-replacement-previous-id-test")
+	builder.Tags = types.Tags{previousTag}
+	updated, err := builder.Build(ctx, zone)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if updated.ID == router.ID {
+		t.Fatalf("replacement router retained old ID %s", router.ID)
+	}
+	assertHasPreviousIDTag(t, updated.Tags, previousTag)
+
+	provider, meta := configuredFakeProvider(t, zone)
+	routerResource := provider.ResourcesMap["sakuracloud_internet"]
+	d := schema.TestResourceDataRaw(t, routerResource.Schema, map[string]interface{}{"zone": zone})
+	d.SetId(router.ID.String())
+	diags := routerResource.ReadContext(ctx, d, meta)
+	if diags.HasError() {
+		t.Fatalf("reading router by its previous ID failed: %v", diags)
+	}
+	if got, want := d.Id(), updated.ID.String(); got != want {
+		t.Fatalf("Terraform ID after fallback = %q, want current ID %q", got, want)
+	}
+	if err := op.Delete(ctx, zone, updated.ID); err != nil {
+		t.Fatal(err)
+	}
+}
