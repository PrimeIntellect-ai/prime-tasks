+func TestSakuraCloudServerReadTracksPreviousID(t *testing.T) {
+	ctx := context.Background()
+	caller := testutil.SingletonAPICaller()
+	zone := testutil.TestZone()
+	op := sacloud.NewServerOp(caller)
+	server, err := op.Create(ctx, zone, &sacloud.ServerCreateRequest{
+		Name: testutil.ResourceName("server-previous-id-provider-test"), CPU: 1, MemoryMB: size.GiB,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	previousTag := fmt.Sprintf("@previous-id=%s", server.ID)
+	if _, err := op.Update(ctx, zone, server.ID, &sacloud.ServerUpdateRequest{Name: server.Name, Tags: types.Tags{previousTag}}); err != nil {
+		t.Fatal(err)
+	}
+	updated, err := op.ChangePlan(ctx, zone, server.ID, &sacloud.ServerChangePlanRequest{
+		CPU: 1, MemoryMB: 2 * size.GiB, ServerPlanCommitment: types.Commitments.Standard,
+		ServerPlanGeneration: types.PlanGenerations.Default,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertHasPreviousIDTag(t, updated.Tags, previousTag)
+
+	provider, meta := configuredFakeProvider(t, zone)
+	serverResource := provider.ResourcesMap["sakuracloud_server"]
+	d := schema.TestResourceDataRaw(t, serverResource.Schema, map[string]interface{}{"zone": zone})
+	d.SetId(server.ID.String())
+	diags := serverResource.ReadContext(ctx, d, meta)
+	if diags.HasError() {
+		t.Fatalf("reading server by its previous ID failed: %v", diags)
+	}
+	if got, want := d.Id(), updated.ID.String(); got != want {
+		t.Fatalf("Terraform ID after fallback = %q, want current ID %q", got, want)
+	}
+	if err := op.Delete(ctx, zone, updated.ID); err != nil {
+		t.Fatal(err)
+	}
+}
