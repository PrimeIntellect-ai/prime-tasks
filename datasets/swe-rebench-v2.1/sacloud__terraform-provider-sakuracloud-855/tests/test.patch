+func TestSakuraCloudELBReadTracksPreviousID(t *testing.T) {
+	ctx := context.Background()
+	caller := testutil.SingletonAPICaller()
+	zone := testutil.TestZone()
+	op := sacloud.NewProxyLBOp(caller)
+	elb, err := op.Create(ctx, &sacloud.ProxyLBCreateRequest{
+		Plan: types.ProxyLBPlans.CPS100, Region: types.ProxyLBRegions.IS1,
+		Name:        testutil.ResourceName("elb-previous-id-provider-test"),
+		HealthCheck: &sacloud.ProxyLBHealthCheck{Protocol: types.ProxyLBProtocols.TCP, DelayLoop: 10},
+		Timeout:     &sacloud.ProxyLBTimeout{InactiveSec: 10},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	previousTag := fmt.Sprintf("@previous-id=%s", elb.ID)
+	if err := op.Delete(ctx, elb.ID); err != nil {
+		t.Fatal(err)
+	}
+	updated, err := op.Create(ctx, &sacloud.ProxyLBCreateRequest{
+		Plan: types.ProxyLBPlans.CPS500, Region: types.ProxyLBRegions.IS1,
+		Name: testutil.ResourceName("elb-replacement-previous-id-test"), Tags: types.Tags{previousTag},
+		HealthCheck: &sacloud.ProxyLBHealthCheck{Protocol: types.ProxyLBProtocols.TCP, DelayLoop: 10},
+		Timeout:     &sacloud.ProxyLBTimeout{InactiveSec: 10},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if updated.ID == elb.ID {
+		t.Fatalf("replacement ELB retained old ID %s", elb.ID)
+	}
+	assertHasPreviousIDTag(t, updated.Tags, previousTag)
+
+	provider, meta := configuredFakeProvider(t, zone)
+	elbResource := provider.ResourcesMap["sakuracloud_proxylb"]
+	d := schema.TestResourceDataRaw(t, elbResource.Schema, map[string]interface{}{"zone": zone})
+	d.SetId(elb.ID.String())
+	diags := elbResource.ReadContext(ctx, d, meta)
+	if diags.HasError() {
+		t.Fatalf("reading ELB by its previous ID failed: %v", diags)
+	}
+	if got, want := d.Id(), updated.ID.String(); got != want {
+		t.Fatalf("Terraform ID after fallback = %q, want current ID %q", got, want)
+	}
+	if err := op.Delete(ctx, updated.ID); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func assertHasPreviousIDTag(t *testing.T, tags types.Tags, want string) {
+	t.Helper()
+	for _, tag := range tags {
+		if tag == want {
+			return
+		}
+	}
+	t.Errorf("resource tags %v do not contain previous-ID metadata %q", tags, want)
+}
+
+func configuredFakeProvider(t *testing.T, zone string) (*schema.Provider, interface{}) {
+	t.Helper()
+	provider := Provider()
+	providerData := schema.TestResourceDataRaw(t, provider.Schema, map[string]interface{}{
+		"token": "dummy", "secret": "dummy", "zone": zone, "fake_mode": "1",
+	})
+	meta, diags := provider.ConfigureContextFunc(context.Background(), providerData)
+	if diags.HasError() {
+		t.Fatalf("configuring fake provider failed: %v", diags)
+	}
+	return provider, meta
+}
