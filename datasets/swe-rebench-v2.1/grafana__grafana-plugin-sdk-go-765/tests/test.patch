+// waitDisposed blocks until the instance has been disposed or the timeout
+// elapses, in which case the test fails.
+func (ti *testInstance) waitDisposed(t *testing.T, timeout time.Duration) {
+	t.Helper()
+	done := make(chan struct{})
+	go func() {
+		ti.wg.Wait()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(timeout):
+		t.Fatalf("instance was not disposed within %s", timeout)
+	}
 }
 
