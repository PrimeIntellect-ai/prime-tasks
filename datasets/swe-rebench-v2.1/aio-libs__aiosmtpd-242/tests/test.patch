+class TestCompat(unittest.TestCase):
+
+    def test_version_resolvable_without_public(self):
+        # Reproduces the clean build environment from the bug report, where the
+        # third-party 'public' module is not installed.  Resolving a configured
+        # module-based version must not import code that requires 'public'.
+        project_root = Path(__file__).resolve().parents[2]
+        pyproject = project_root / "pyproject.toml"
+        if pyproject.is_file():
+            # If the isolated build environment is told to provide 'public'
+            # explicitly, the missing-module situation from the report cannot
+            # arise during the build, so the requirement is met by declaration.
+            text = pyproject.read_text(encoding="utf-8")
+            section = re.search(
+                r"^\[build-system\][ \t]*$(.*?)(?=^\[|\Z)", text, re.M | re.S
+            )
+            if section and "atpublic" in section.group(1):
+                return
+        setup_cfg = project_root / "setup.cfg"
+        cfg = configparser.ConfigParser()
+        cfg.read(str(setup_cfg))
+        # Projects may supply the version outside setup.cfg, or use a literal
+        # value which requires no module import to resolve.
+        if not cfg.has_option("metadata", "version"):
+            return
+        spec = cfg["metadata"]["version"].strip()
+        if not spec.startswith("attr:"):
+            # A literal version string needs no import at all during build-time
+            # version resolution, so it trivially satisfies the requirement.
+            return
+        dotted = spec.split(":", 1)[1].strip()
+        module_name, _, attr_name = dotted.rpartition(".")
+
+        with patch.dict(sys.modules, {"public": None}):
+            # Force a fresh import of the module named in setup.cfg, mimicking
+            # setuptools falling back to importing when it cannot statically
+            # read the version.
+            sys.modules.pop(module_name, None)
+            module = importlib.import_module(module_name)
+            resolved = getattr(module, attr_name)
