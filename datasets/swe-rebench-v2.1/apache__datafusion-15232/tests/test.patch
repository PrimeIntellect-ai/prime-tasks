+/// Builds a file sink config through its protobuf form, which only carries the
+/// fields a serialized sink needs.
+fn sink_config_from_proto(
+    schema: &SchemaRef,
+    file_extension: &str,
+) -> Result<FileSinkConfig> {
+    let conf = protobuf::FileSinkConfig {
+        object_store_url: ObjectStoreUrl::local_filesystem().as_str().to_string(),
+        table_paths: vec!["file:///".to_string()],
+        output_schema: Some(protobuf::Schema::try_from(schema.as_ref())?),
+        table_partition_cols: vec![protobuf::PartitionColumn {
+            name: "plan_type".to_string(),
+            arrow_type: Some(protobuf::ArrowType::try_from(&DataType::Utf8)?),
+        }],
+        keep_partition_by_columns: true,
+        insert_op: protobuf::InsertOp::Overwrite as i32,
+        file_extension: file_extension.to_string(),
+        ..Default::default()
+    };
+    FileSinkConfig::try_from(&conf)
+}
