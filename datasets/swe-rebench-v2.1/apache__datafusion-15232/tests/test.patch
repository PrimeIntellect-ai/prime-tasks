+#[test]
+fn tree_render_local_limit_has_details() -> Result<()> {
+    let schema = Arc::new(Schema::new(vec![Field::new("a", DataType::Int64, false)]));
+    let input = Arc::new(PlaceholderRowExec::new(schema));
+    let plan = LocalLimitExec::new(input, 2);
+
+    let rendered = displayable(&plan).tree_render().to_string();
+    let lines: Vec<&str> = rendered.lines().collect();
+    let Some(title) = lines
+        .iter()
+        .position(|line| line.contains("LocalLimitExec"))
+    else {
+        return internal_err!("expected a LocalLimitExec box in:\n{rendered}");
+    };
+    let has_details = lines[title + 1..]
+        .iter()
+        .take_while(|line| !line.contains('└'))
+        .any(|line| {
+            line.trim_matches(|c: char| c == '│' || c.is_whitespace())
+                .chars()
+                .any(char::is_alphanumeric)
+        });
+    assert!(
+        has_details,
+        "LocalLimitExec box has no details in tree output:\n{rendered}"
+    );
+    Ok(())
+}
