 )
 
+func TestEvalContextRootVariablesFromIssue181(t *testing.T) {
+	requestContext := context.WithValue(context.Background(), request.AccessControls, map[string]interface{}{
+		"auth": map[string]interface{}{"sub": "user-123"},
+	})
+	req := httptest.NewRequest(http.MethodGet, "https://couper.io/path", nil).WithContext(requestContext)
+	backendReq := httptest.NewRequest(http.MethodPost, "https://backend.example/path", nil)
+	backendResp := &http.Response{StatusCode: http.StatusAccepted, Request: backendReq}
+	hclContext := eval.NewContext(nil).WithClientRequest(req).WithBeresps(backendResp).HCLContext()
+
+	var values map[string]cty.Value
+	config := `client_context = request.context.auth.sub
+backend_method = backend_requests.default.method
+backend_status = backend_responses.default.status
+`
+	err := hclsimple.Decode("variables.hcl", []byte(config), hclContext, &values)
+	if err != nil {
+		t.Fatalf("evaluate renamed variables: %v", err)
+	}
+	for name, want := range map[string]string{
+		"client_context": "user-123",
+		"backend_method": http.MethodPost,
+		"backend_status": "202",
+	} {
+		if got := values[name].AsString(); got != want {
+			t.Errorf("%s: got %q, want %q", name, got, want)
+		}
+	}
+
+	for _, oldName := range []string{"req.method", "request.ctx.auth.sub", "bereq.method", "beresp.status", "bereqs.default.method", "beresps.default.status"} {
+		expression, diags := hclsyntax.ParseExpression([]byte(oldName), "old-variable.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			t.Fatalf("parse %q: %s", oldName, diags.Error())
+		}
+		if _, diags = expression.Value(hclContext); !diags.HasErrors() {
+			t.Errorf("obsolete variable %q unexpectedly evaluated", oldName)
+		}
+	}
+}
