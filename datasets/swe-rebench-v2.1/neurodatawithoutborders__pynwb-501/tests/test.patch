+class BehavioralEventsPersistence(unittest.TestCase):
+    def setUp(self):
+        self.path = tempfile.mktemp(suffix='.nwb')
+
+    def tearDown(self):
+        if os.path.exists(self.path):
+            os.remove(self.path)
+
+    def test_behavioral_events_timeseries_persisted(self):
+        nwbfile = NWBFile(source='nwbfile_source',
+                          session_description='nwb_file_session_description',
+                          identifier='0',
+                          session_start_time=datetime(2017, 5, 4, 1, 1, 1))
+        ts = TimeSeries('behavioral_events_name', 'behavioral_events_source',
+                        [1.0, 2.0, 3.0, 4.0], 'ms',
+                        timestamps=[5.0, 6.0, 7.0, 8.0])
+        behavioral_events = BehavioralEvents('Behavioral_Events_source', name='BehavioralEvents_name')
+        behavioral_events.add_timeseries(ts)
+        behavior_module = nwbfile.create_processing_module('behavioral_module_name',
+                                                           'behavioral_module_source',
+                                                           'example module')
+        behavior_module.add_container(behavioral_events)
+
+        with NWBHDF5IO(self.path, mode='w') as io:
+            io.write(nwbfile)
+
+        with NWBHDF5IO(self.path, mode='r') as io:
+            read_nwbfile = io.read()
+            read_module = read_nwbfile.get_processing_module('behavioral_module_name')
+            read_behavioral_events = read_module.get_container('BehavioralEvents_name')
+            read_ts = read_behavioral_events.time_series['behavioral_events_name']
+            self.assertEqual(list(read_ts.data[:]), [1.0, 2.0, 3.0, 4.0])
+            self.assertEqual(list(read_ts.timestamps[:]), [5.0, 6.0, 7.0, 8.0])
 
 
