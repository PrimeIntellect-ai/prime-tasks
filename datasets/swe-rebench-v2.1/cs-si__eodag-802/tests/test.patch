+    @mock.patch("eodag.plugins.manager.PluginManager.get_auth_plugin", autospec=True)
+    def test__do_search_authenticates_provider(self, mock_get_auth_plugin):
+        """_do_search must authenticate the provider's auth plugin before searching"""
+        mock_auth_plugin = mock.Mock()
+        mock_get_auth_plugin.return_value = mock_auth_plugin
+
+        class DummyConfig:
+            pagination = {}
+            need_auth = True
+
+        search_plugin = mock.Mock()
+        search_plugin.provider = "peps"
+        search_plugin.config = DummyConfig()
+        search_plugin.query.return_value = ([], 0)
+
+        event_order = mock.Mock()
+        event_order.attach_mock(mock_auth_plugin.authenticate, "authenticate")
+        event_order.attach_mock(search_plugin.query, "query")
+        self.dag._do_search(search_plugin=search_plugin)
+
+        self.assertTrue(mock_auth_plugin.authenticate.called)
+        authenticate_index = next(
+            index
+            for index, call in enumerate(event_order.mock_calls)
+            if call[0] == "authenticate"
+        )
+        query_index = next(
+            index
+            for index, call in enumerate(event_order.mock_calls)
+            if call[0] == "query"
+        )
+        self.assertLess(authenticate_index, query_index)
+        # the auth plugin must be the one passed to the search query
+        self.assertIs(search_plugin.query.call_args[1]["auth"], mock_auth_plugin)
+
