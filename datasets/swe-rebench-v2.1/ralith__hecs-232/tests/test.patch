+#[test]
+fn simultaneous_access_via_view_mut() {
+    let mut world = World::new();
+    let a = world.spawn((1,));
+    let b = world.spawn((2,));
+    let c = world.spawn((3,));
+
+    {
+        let mut query = world.query_mut::<&mut i32>();
+        let mut view = query.view();
+
+        let [x, y, z] = view.get_mut_n([a, b, c]);
+        let x = x.unwrap();
+        let y = y.unwrap();
+        let z = z.unwrap();
+        assert_eq!(*x, 1);
+        assert_eq!(*y, 2);
+        assert_eq!(*z, 3);
+
+        *x += 10;
+        *y += 10;
+        *z += 10;
+    }
+
+    assert_eq!(*world.get::<i32>(a).unwrap(), 11);
+    assert_eq!(*world.get::<i32>(b).unwrap(), 12);
+    assert_eq!(*world.get::<i32>(c).unwrap(), 13);
+}
+
+#[test]
+fn simultaneous_access_reports_missing_entities() {
+    let mut world = World::new();
+    let a = world.spawn((1,));
+    let b = world.spawn((2,));
+    let c = world.spawn((3.0,));
+
+    let mut query = world.query_mut::<&mut i32>();
+    let mut view = query.view();
+
+    let [x, y, z] = view.get_mut_n([a, b, c]);
+    assert_eq!(*x.unwrap(), 1);
+    assert_eq!(*y.unwrap(), 2);
+    assert!(z.is_none());
+}
