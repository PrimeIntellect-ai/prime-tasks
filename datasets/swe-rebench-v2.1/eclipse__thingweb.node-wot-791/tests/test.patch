+import { suite, test } from "@testdeck/mocha";
+import { expect } from "chai";
+import ExposedThing from "../src/exposed-thing";
+import { Content } from "../src/protocol-interfaces";
+
+@suite("Exposed thing event test")
+class ExposedThingEventTest {
+    @test async "should emit event data to subscribers on different forms"() {
+        const thing = new ExposedThing({} as any, {
+            events: {
+                update: {
+                    data: { type: "object" },
+                    forms: [
+                        {
+                            href: "http://example.org/update",
+                            contentType: "application/json",
+                            op: ["subscribeevent"],
+                        },
+                        {
+                            href: "http://example.org/update/alternate",
+                            contentType: "application/json",
+                            op: ["subscribeevent"],
+                        },
+                    ],
+                },
+            },
+        } as any);
+        const expected = { temperature: 21 };
+        const received: Content[] = [];
+
+        await thing.handleSubscribeEvent(
+            "update",
+            (content) => {
+                received.push(content);
+            },
+            { formIndex: 0 }
+        );
+        await thing.handleSubscribeEvent(
+            "update",
+            (content) => {
+                received.push(content);
+            },
+            { formIndex: 1 }
+        );
+
+        expect(() => thing.emitEvent("update", expected)).not.to.throw();
+        expect(received).to.have.length(2);
+
+        const serialized = await Promise.all(
+            received.map(
+                (content) =>
+                    new Promise<string>((resolve, reject) => {
+                        const chunks: Buffer[] = [];
+                        content.body.on("data", (chunk: Buffer) => chunks.push(chunk));
+                        content.body.on("end", () => resolve(Buffer.concat(chunks).toString()));
+                        content.body.on("error", reject);
+                    })
+            )
+        );
+        expect(serialized.map((value) => JSON.parse(value))).to.deep.equal([expected, expected]);
+    }
+}
