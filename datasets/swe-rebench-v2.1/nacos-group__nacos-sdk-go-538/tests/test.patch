+	param := make(map[string]string)
+	param["serviceName"] = "s-0"
+	param["groupName"] = "g-0"
+	callInjectSignForNamingHttp(t, server, param, clientConfig)
+	assert.Equal(t, "123", param["ak"])
+	assert.Regexp(t, `^\d+@@g-0@@s-0$`, param["data"])
+	assert.Equal(t, expectedNamingSignature(param["data"], "321"), param["signature"])
+	assertRecentNamingTimestamp(t, param["data"])
+}
