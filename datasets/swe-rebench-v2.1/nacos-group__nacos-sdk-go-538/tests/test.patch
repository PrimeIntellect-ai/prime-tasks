+func TestNacosServer_ReqApiSignsNamingHttpRequest(t *testing.T) {
+	var received url.Values
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		assert.NoError(t, r.ParseForm())
+		received = r.Form
+		_, _ = io.WriteString(w, "ok")
+	}))
+	defer ts.Close()
+
+	parsedURL, err := url.Parse(ts.URL)
+	assert.NoError(t, err)
+	host, portText, err := net.SplitHostPort(parsedURL.Host)
+	assert.NoError(t, err)
+	port, err := strconv.Atoi(portText)
+	assert.NoError(t, err)
+
+	clientConfig := constant.ClientConfig{AccessKey: "request-ak", SecretKey: "request-secret"}
+	server, err := NewNacosServer(context.Background(), []constant.ServerConfig{{
+		IpAddr: host, Port: uint64(port), Scheme: "http", ContextPath: "/nacos",
+	}}, clientConfig, &http_agent.HttpAgent{}, 1000, "")
+	assert.NoError(t, err)
+
+	params := map[string]string{"serviceName": "g-0@@s-0", "groupName": "g-0"}
+	result, err := callReqApiWithClientConfig(t, server, "/v1/ns/instance", params, http.MethodPost, clientConfig)
+	assert.NoError(t, err)
+	assert.Equal(t, "ok", result)
+	assert.Equal(t, "request-ak", received.Get("ak"))
+	assert.Regexp(t, `^\d+@@g-0@@(?:g-0@@)?s-0$`, received.Get("data"))
+	assert.Equal(t, expectedNamingSignature(received.Get("data"), clientConfig.SecretKey), received.Get("signature"))
+	assertRecentNamingTimestamp(t, received.Get("data"))
+}
