+func buildNacosServer(clientConfig constant.ClientConfig) (*NacosServer, error) {
+	return NewNacosServer(context.Background(),
+		[]constant.ServerConfig{*constant.NewServerConfig("http://console.nacos.io", 80)},
+		clientConfig,
+		&http_agent.HttpAgent{},
+		1000,
+		"")
+}
+
+func callInjectSignForNamingHttp(t *testing.T, server *NacosServer, param map[string]string, config constant.ClientConfig) {
+	t.Helper()
+	method := reflect.ValueOf(server).MethodByName("InjectSignForNamingHttp")
+	if !assert.True(t, method.IsValid(), "NacosServer must expose InjectSignForNamingHttp") {
+		return
+	}
+	method.Call([]reflect.Value{reflect.ValueOf(param), reflect.ValueOf(config)})
+}
+
+func callReqApiWithClientConfig(t *testing.T, server *NacosServer, api string, params map[string]string, methodName string, config constant.ClientConfig) (string, error) {
+	t.Helper()
+	method := reflect.ValueOf(server).MethodByName("ReqApi")
+	if !assert.True(t, method.IsValid(), "NacosServer must expose ReqApi") {
+		return "", fmt.Errorf("ReqApi is unavailable")
+	}
+	args := []reflect.Value{reflect.ValueOf(api), reflect.ValueOf(params), reflect.ValueOf(methodName)}
+	if method.Type().NumIn() == 4 {
+		args = append(args, reflect.ValueOf(config))
+	} else if method.Type().NumIn() != 3 {
+		assert.Fail(t, "ReqApi must accept its request arguments")
+		return "", fmt.Errorf("unsupported ReqApi signature")
+	}
+	results := method.Call(args)
+	if results[1].IsNil() {
+		return results[0].String(), nil
+	}
+	return results[0].String(), results[1].Interface().(error)
+}
