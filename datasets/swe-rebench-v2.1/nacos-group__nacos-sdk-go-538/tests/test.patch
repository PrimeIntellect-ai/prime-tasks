+func TestNacosServer_InjectSignForNamingHttp_NoAk(t *testing.T) {
+	clientConfig := constant.ClientConfig{
+		AccessKey: "123",
+		SecretKey: "321",
+	}
+	server, err := buildNacosServer(clientConfig)
+	if err != nil {
+		t.FailNow()
+	}
+
+	param := map[string]string{
+		"serviceName": "s-0",
+		"groupName":   "g-0",
+		"ak":          "existing-ak",
+		"data":        "existing-data",
+		"signature":   "existing-signature",
+	}
+	before := make(map[string]string, len(param))
+	for key, value := range param {
+		before[key] = value
+	}
+	callInjectSignForNamingHttp(t, server, param, constant.ClientConfig{})
+	assert.Equal(t, before, param)
+}
+
+func expectedNamingSignature(data, secretKey string) string {
+	mac := hmac.New(sha1.New, []byte(secretKey))
+	mac.Write([]byte(data))
+	return base64.StdEncoding.EncodeToString(mac.Sum(nil))
+}
+
+func assertRecentNamingTimestamp(t *testing.T, signData string) {
+	t.Helper()
+	timestampText := strings.SplitN(signData, "@@", 2)[0]
+	timestamp, err := strconv.ParseInt(timestampText, 10, 64)
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.InDelta(t, time.Now().UnixMilli(), timestamp, float64(5000))
+}
