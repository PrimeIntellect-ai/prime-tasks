+func TestProxyFailureRefreshesOtherRegionsAndDiscoversLeader(t *testing.T) {
+	s := new(testReplicaSelectorSuite)
+	s.SetupTest(t)
+	defer s.TearDownTest()
+	s.cache.enableForwarding = true
+	config.UpdateGlobal(func(conf *config.Config) {
+		conf.TiKVClient.EnableReplicaSelectorV2 = true
+	})
+
+	// Split the PD region and cache both halves. Both regions still refer to
+	// the same store instances when the request fails.
+	upperRegionID := s.cluster.AllocID()
+	s.cluster.Split(s.regionID, upperRegionID, []byte("m"), s.peerIDs, s.leaderPeer)
+	oldRegion := s.getRegion()
+	s.cache.InvalidateCachedRegion(oldRegion.VerID())
+	firstLoc, err := s.cache.LocateKey(s.bo, []byte("key"))
+	s.NoError(err)
+	secondLoc, err := s.cache.LocateKey(s.bo, []byte("z"))
+	s.NoError(err)
+	s.NotEqual(firstLoc.Region, secondLoc.Region)
+	failedRequest := replicaSelectorAccessPathCase{
+		reqType:   tikvrpc.CmdGet,
+		readType:  kv.ReplicaReadLeader,
+		key:       []byte("key"),
+		accessErr: []RegionErrorType{DeadLineExceededErr, ServerIsBusyWithEstimatedWaitMsErr, ServerIsBusyWithEstimatedWaitMsErr},
+		afterRun:  func() { /* preserve cache state for the next request */ },
+	}
+	failedRequest.run(s)
+	s.cluster.ChangeLeader(s.regionID, s.peerIDs[1])
+	s.cluster.ChangeLeader(upperRegionID, s.peerIDs[1])
+
+	// Neither request's setup invalidates cached routing. A fresh leader address
+	// therefore demonstrates that the failed request caused PD state to be used.
+	refreshedRequest := replicaSelectorAccessPathCase{
+		reqType:   tikvrpc.CmdGet,
+		readType:  kv.ReplicaReadLeader,
+		key:       []byte("key"),
+		beforeRun: func() {},
+		afterRun:  func() { /* preserve the observed routing */ },
+	}
+	refreshedRequest.run(s)
+	newLeaderWasUsed := false
+	for _, access := range refreshedRequest.result.accessPath {
+		if strings.Contains(access, "forward_addr: store2") ||
+			(!strings.Contains(access, "forward_addr:") && strings.Contains(access, "addr: store2")) {
+			newLeaderWasUsed = true
+		}
+	}
+	s.True(newLeaderWasUsed, "expected a request to reach the leader reported by PD; accesses: %v", refreshedRequest.result.accessPath)
+
+	// A second cached region that shared the failed store must also discover its
+	// new leader rather than continuing to use stale region routing.
+	otherRegionRequest := replicaSelectorAccessPathCase{
+		reqType:   tikvrpc.CmdGet,
+		readType:  kv.ReplicaReadLeader,
+		key:       []byte("z"),
+		beforeRun: func() {},
+		afterRun:  func() { /* preserve the observed routing */ },
+	}
+	otherRegionRequest.run(s)
+	usedFailedStoreAsTarget := false
+	for _, access := range otherRegionRequest.result.accessPath {
+		if strings.Contains(access, "forward_addr: store1") ||
+			(!strings.Contains(access, "forward_addr:") && strings.Contains(access, "addr: store1")) {
+			usedFailedStoreAsTarget = true
+		}
+	}
+	s.False(usedFailedStoreAsTarget, "request reused the failed store as its target: %v", otherRegionRequest.result.accessPath)
+}
