+// Compatibility shim: the bundled nock version reads and writes request headers
+// through `OutgoingMessage.prototype._headers`, which is a deprecated accessor on
+// modern Node that returns a fresh object on every read. As a result, headers that
+// nock sets from the request options (for example those produced by the `request`
+// library when sending multipart form data) are lost and header matching fails.
+// Mirroring the options headers onto the created request restores that behaviour.
+var http = require('http');
+var https = require('https');
+
+[http, https].forEach(function(mod) {
+  var originalRequest = mod.request;
+
+  mod.request = function(options, callback) {
+    var req = originalRequest.call(this, options, callback);
+
+    if (options && options.headers) {
+      Object.keys(options.headers).forEach(function(name) {
+        try {
+          req.setHeader(name, options.headers[name]);
+        } catch (e) {
+          // Ignore headers that cannot be set on the request.
+        }
+      });
+    }
+
+    return req;
+  };
+});
