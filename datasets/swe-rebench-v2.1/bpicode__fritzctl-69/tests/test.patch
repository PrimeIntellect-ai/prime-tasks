@@ -1,10 +1,16 @@
 package fritz
 
 import (
+	"encoding/json"
 	"encoding/xml"
+	"net"
+	"net/url"
 	"os"
+	"os/exec"
+	"path/filepath"
 	"testing"
 
+	"github.com/bpicode/fritzctl/mock"
 	"github.com/stretchr/testify/assert"
 )
 
@@ -23,3 +29,77 @@ func TestSwitchAndThermostatFiltering(t *testing.T) {
 
 	assert.Equal(t, len(l.Devices), len(l.Switches())+len(l.Thermostats()))
 }
+
+// TestSwitchAndThermostatFilteringIssue56 reproduces https://github.com/bpicode/fritzctl/issues/59.
+func TestSwitchAndThermostatFilteringIssue56(t *testing.T) {
+	f, err := os.Open("../testdata/devicelist_issue_59.xml")
+	assert.NoError(t, err)
+	defer f.Close()
+
+	var l Devicelist
+	err = xml.NewDecoder(f).Decode(&l)
+	assert.NoError(t, err)
+
+	assert.Len(t, l.Thermostats(), 4)
+}
+
+// TestListSwitchesOmitsThermostats checks the user-visible switch listing.
+func TestListSwitchesOmitsThermostats(t *testing.T) {
+	server := mock.New()
+	server.DeviceList = "../testdata/devicelist_issue_59.xml"
+	server.Start()
+	defer server.Close()
+
+	serverURL, err := url.Parse(server.Server.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	host, port, err := net.SplitHostPort(serverURL.Host)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	tempDir := t.TempDir()
+	configData, err := json.Marshal(map[string]string{
+		"protocol": serverURL.Scheme,
+		"host":     host,
+		"port":     port,
+		"loginURL": "/login_sid.lua",
+		"username": "",
+		"password": "xxxxx",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(tempDir, "fritzctl.json"), configData, 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	harness := `package main
+import (
+	"os"
+	"github.com/bpicode/fritzctl/cmd"
+	"github.com/bpicode/fritzctl/config"
+)
+func main() {
+	config.Dir = os.Getenv("FRITZCTL_TEST_CONFIG_DIR")
+	config.Filename = "fritzctl.json"
+	cmd.RootCmd.SetArgs([]string{"list", "switches"})
+	if err := cmd.RootCmd.Execute(); err != nil { panic(err) }
+}
+`
+	harnessPath := filepath.Join(tempDir, "main.go")
+	if err := os.WriteFile(harnessPath, []byte(harness), 0600); err != nil {
+		t.Fatal(err)
+	}
+	command := exec.Command("go", "run", harnessPath)
+	command.Dir = ".."
+	command.Env = append(os.Environ(), "FRITZCTL_TEST_CONFIG_DIR="+tempDir)
+	output, err := command.CombinedOutput()
+	if err != nil {
+		t.Fatalf("list switches failed: %v\n%s", err, output)
+	}
+	for _, thermostatName := range []string{"H1", "H2", "H3", "H4"} {
+		assert.NotContains(t, string(output), thermostatName)
+	}
+}
