+    def test_presolve_named_expressions(self):
+        # Test from #3055
+        m = pyo.ConcreteModel()
+        m.x = pyo.Var([1, 2, 3], initialize=1, bounds=(0, 10))
+        m.subexpr = pyo.Expression(pyo.Integers)
+        m.subexpr[1] = m.x[1] + m.x[2]
+        m.eq = pyo.Constraint(pyo.Integers)
+        m.eq[1] = m.x[1] == 7
+        m.eq[2] = m.x[3] == 0.1 * m.subexpr[1] * m.x[2]
+        m.obj = pyo.Objective(expr=m.x[1] ** 2 + m.x[2] ** 2 + m.x[3] ** 3)
+
+        OUT = io.StringIO()
+        nlinfo = nl_writer.NLWriter().write(
+            m, OUT, symbolic_solver_labels=True, linear_presolve=True
+        )
+        self.assertEqual(
+            nlinfo.eliminated_vars, [(m.x[1], nl_writer.AMPLRepn(7, {}, None))]
+        )
+        self.assertEqual(len(nlinfo.variables), 2)
+        self.assertFalse(any(var is m.x[1] for var in nlinfo.variables))
+        self.assertEqual(len(nlinfo.constraints), 1)
+
+        lines = OUT.getvalue().splitlines()
+        section_start = re.compile(
+            r"^(?:V\d+|C\d+|O\d+|x\d+|r|b|k\d+|J\d+|G\d+)\b"
+        )
+        token_pattern = re.compile(
+            r"o\d+|v\d+|n[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?|\d+"
+        )
+
+        def section_tokens(label):
+            start = next(
+                i for i, line in enumerate(lines) if line.strip().startswith(label)
+            )
+            result = []
+            for line in lines[start + 1 :]:
+                line = line.split("#", 1)[0].strip()
+                if not line:
+                    continue
+                if section_start.match(line):
+                    break
+                result.extend(token_pattern.findall(line))
+            return result
+
+        def evaluate(tokens, variable_values):
+            def parse(expression, index):
+                token = expression[index]
+                index += 1
+                if token[0] == "n":
+                    return float(token[1:]), index
+                if token[0] == "v":
+                    variable = int(token[1:])
+                    if variable < len(nlinfo.variables):
+                        return variable_values[variable], index
+                    common_label = "V%d" % variable
+                    common_line = next(
+                        line.strip()
+                        for line in lines
+                        if line.strip().startswith(common_label)
+                    )
+                    linear_count = int(common_line.split()[1])
+                    common = section_tokens(common_label)
+                    value = sum(
+                        float(common[2 * i + 1])
+                        * variable_values[int(common[2 * i])]
+                        for i in range(linear_count)
+                    )
+                    nonlinear = common[2 * linear_count :]
+                    if nonlinear:
+                        value += parse(nonlinear, 0)[0]
+                    return value, index
+                if token == "o54":
+                    count = int(expression[index])
+                    index += 1
+                    value = 0
+                    for _ in range(count):
+                        term, index = parse(expression, index)
+                        value += term
+                    return value, index
+                if token == "o16":
+                    value, index = parse(expression, index)
+                    return -value, index
+                left, index = parse(expression, index)
+                right, index = parse(expression, index)
+                if token == "o0":
+                    return left + right, index
+                if token == "o1":
+                    return left - right, index
+                if token == "o2":
+                    return left * right, index
+                if token == "o3":
+                    return left / right, index
+                if token == "o5":
+                    return left**right, index
+                raise AssertionError("Unexpected NL operator: %s" % token)
+
+            return parse(tokens, 0)[0]
+
+        # Map each value to its variable so the check does not depend on the
+        # order in which the presolved NL representation lists the variables.
+        value_of = {id(m.x[2]): 2.0, id(m.x[3]): 1.8}
+        variable_values = [value_of[id(var)] for var in nlinfo.variables]
+        constraint = section_tokens("C0")
+        jacobian = section_tokens("J0")
+        objective = section_tokens("O0")
+
+        def constraint_value(values):
+            linear = sum(
+                float(jacobian[2 * i + 1]) * values[int(jacobian[2 * i])]
+                for i in range(len(jacobian) // 2)
+            )
+            return evaluate(constraint, values) + linear
+
+        self.assertAlmostEqual(constraint_value(variable_values), 0.0)
+        alt_value_of = {id(m.x[2]): 2.0, id(m.x[3]): 0.4}
+        alt_values = [alt_value_of[id(var)] for var in nlinfo.variables]
+        self.assertNotAlmostEqual(constraint_value(alt_values), 0.0)
+        self.assertAlmostEqual(
+            evaluate(objective, variable_values), 49 + 2**2 + 1.8**3
+        )
+
