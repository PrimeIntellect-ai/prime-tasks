+class TestSetenv:
+
+    """Tests for gidgethub.actions.setenv()."""
+
+    def test_creating(self, tmp_envfile):
+        actions.setenv("HELLO", "WORLD")
+        assert os.environ["HELLO"] == "WORLD"
+        assert _environment_file_contains(tmp_envfile, "HELLO", "WORLD")
+
+    def test_updating(self, tmp_envfile):
+        actions.setenv("CHANGED", "FALSE")
+        assert os.environ["CHANGED"] == "FALSE"
+        assert _environment_file_contains(tmp_envfile, "CHANGED", "FALSE")
+        actions.setenv("CHANGED", "TRUE")
+        assert os.environ["CHANGED"] == "TRUE"
+        assert _environment_file_contains(tmp_envfile, "CHANGED", "TRUE")
+
+    def test_creating_multiline(self, tmp_envfile):
+        multiline = """This
+                        is
+                        a
+                        multiline
+                        string."""
+        actions.setenv("MULTILINE", multiline)
+        assert os.environ["MULTILINE"] == multiline
+        assert _environment_file_contains(tmp_envfile, "MULTILINE", multiline)
+
+
+class TestAddpath:
+
+    """Tests for gidgethub.actions.addpath()."""
+
+    def test_string_path(self, tmp_pathfile):
+        actions.addpath("/path/to/random/dir")
+        data = tmp_pathfile.read_text(encoding="utf-8").splitlines()
+        assert os.environ["PATH"].split(os.pathsep)[0] == "/path/to/random/dir"
+        assert "/path/to/random/dir" in data
+
+    def test_multiple_paths(self, tmp_pathfile):
+        actions.addpath("/path/to/random/dir")
+        random_path = "/path/to/another/dir"
+        actions.addpath(random_path)
+        data = tmp_pathfile.read_text(encoding="utf-8").splitlines()
+        # Last path added comes first.
+        assert os.environ["PATH"].split(os.pathsep)[:2] == [
+            random_path,
+            "/path/to/random/dir",
+        ]
+        assert {"/path/to/random/dir", random_path} <= set(data)
