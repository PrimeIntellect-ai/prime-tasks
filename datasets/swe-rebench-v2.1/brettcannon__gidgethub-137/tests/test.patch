+def _environment_file_contains(path, name, value):
+    """Check a single-line assignment or a delimited environment-file entry."""
+    lines = path.read_text(encoding="utf-8").splitlines(keepends=True)
+    for index, line in enumerate(lines):
+        header = line.rstrip("\r\n")
+        if header == f"{name}={value}":
+            return True
+        prefix = f"{name}<<"
+        if not header.startswith(prefix):
+            continue
+        delimiter = header[len(prefix):]
+        body = ""
+        for body_line in lines[index + 1:]:
+            if body_line.rstrip("\r\n") == delimiter:
+                if body.endswith("\r\n"):
+                    body = body[:-2]
+                elif body.endswith("\n"):
+                    body = body[:-1]
+                if body == value:
+                    return True
+                break
+            body += body_line
+    return False
+
