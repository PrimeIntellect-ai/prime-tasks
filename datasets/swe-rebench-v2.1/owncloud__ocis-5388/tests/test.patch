+// searchRequestMatcher returns a testify argument matcher that accepts any LDAP
+// search request targeting the given base DN, size limit and filter. The order
+// and exact set of requested attributes are implementation details and are not
+// checked here; callers verify the required attributes separately. When capture
+// is non-nil, matching requests are appended to it.
+func searchRequestMatcher(baseDN string, sizeLimit int, filter string, capture *[]*ldap.SearchRequest) interface{} {
+	return stretchrmock.MatchedBy(func(req *ldap.SearchRequest) bool {
+		if req == nil || req.BaseDN != baseDN || req.SizeLimit != sizeLimit || req.Filter != filter {
+			return false
+		}
+		if capture != nil {
+			*capture = append(*capture, req)
+		}
+		return true
+	})
+}
+
+// hasAttributes reports whether the search request asks for all of the given
+// attributes, regardless of order, or requests every attribute.
+func hasAttributes(req *ldap.SearchRequest, required ...string) bool {
+	if len(req.Attributes) == 0 {
+		return true
+	}
+	for _, attr := range req.Attributes {
+		if attr == "*" {
+			return true
+		}
+	}
+	for _, r := range required {
+		found := false
+		for _, a := range req.Attributes {
+			if strings.EqualFold(a, r) {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
