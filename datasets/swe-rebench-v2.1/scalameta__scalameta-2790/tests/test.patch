+
+  private def snapshotSection(snapshot: String, heading: String): String = {
+    val lines = snapshot.split("\\n", -1).toVector
+    val start = lines.indexWhere(_ == heading)
+    if (start < 0) ""
+    else {
+      val end = (start + 2 until lines.length).find { index =>
+        index + 1 < lines.length && lines(index + 1).nonEmpty &&
+        lines(index + 1).forall(_ == '-')
+      }.getOrElse(lines.length)
+      lines.slice(start, end).mkString("\n")
+    }
+  }
+
+  private def withoutStructuralTypeSnapshots(
+      snapshot: String,
+      classfile: Boolean = false
+  ): String = {
+    val headings = if (classfile) {
+      Seq("example/StructuralTypes.class", "example/StructuralTypes2.class")
+    } else {
+      Seq(
+        "semanticdb/integration/src/main/scala/example/StructuralTypes.scala",
+        "semanticdb/integration/src/main/scala/example/StructuralTypes2.scala"
+      )
+    }
+    headings.foldLeft(snapshot) { (initial, heading) =>
+      def removeAll(current: String): String = {
+        val lines = current.split("\\n", -1).toVector
+        val start = lines.indexWhere(_ == heading)
+        if (start < 0) current
+        else {
+          val end = (start + 2 until lines.length).find { index =>
+            index + 1 < lines.length && lines(index + 1).nonEmpty &&
+            lines(index + 1).forall(_ == '-')
+          }.getOrElse(lines.length)
+          removeAll(lines.patch(start, Nil, end - start).mkString("\n"))
+        }
+      }
+      removeAll(initial)
+    }
+  }
+
+  private def withoutStructuralTypeDiff(snapshot: String): String = {
+    val lines = snapshot.split("\\n", -1).toVector
+    val title = lines.indexWhere(_ == "example/StructuralTypes.a.")
+    if (title < 0) snapshot
+    else {
+      val nextSection = (title + 2 until lines.length - 2).find { index =>
+        lines(index).nonEmpty && lines(index).forall(_ == '=') &&
+        lines(index + 2).nonEmpty && lines(index + 2).forall(_ == '=')
+      }.getOrElse(lines.length)
+      lines.patch(title - 1, Nil, nextSection - title + 1).mkString("\n")
+    }
+  }
 }
 
