+
+func getStarboardConfig() starboard.ConfigData {
+	return starboard.ConfigData{"compliance.failEntriesLimit": "1"}
+}
+
+// generateDetailReport generates the cluster compliance detail report from the fixture data
+// with the given failure entries limit. Extra failing Pods are added to the config audit data.
+func generateDetailReport(limit string, extraFailingPods int) (*v1alpha1.ClusterComplianceDetailReport, error) {
+	var cisBenchList v1alpha1.CISKubeBenchReportList
+	if err := loadResource("./testdata/fixture/cisBenchmarkReportList.json", &cisBenchList); err != nil {
+		return nil, err
+	}
+	var confAuditList v1alpha1.ConfigAuditReportList
+	if err := loadResource("./testdata/fixture/configAuditReportList.json", &confAuditList); err != nil {
+		return nil, err
+	}
+	var clusterComplianceSpec v1alpha1.ClusterComplianceReport
+	if err := loadResource("./testdata/fixture/clusterComplianceSpec.json", &clusterComplianceSpec); err != nil {
+		return nil, err
+	}
+	for i := range confAuditList.Items {
+		item := confAuditList.Items[i]
+		if item.Name != "pod-rss-site" {
+			continue
+		}
+		for n := 0; n < extraFailingPods; n++ {
+			clone := item.DeepCopy()
+			clone.Name = fmt.Sprintf("pod-rss-site-copy-%d", n)
+			confAuditList.Items = append(confAuditList.Items, *clone)
+		}
+		break
+	}
+
+	cli := fake.NewClientBuilder().WithScheme(starboard.NewScheme()).WithLists(
+		&cisBenchList,
+		&confAuditList,
+	).WithObjects(
+		&clusterComplianceSpec,
+	).Build()
+	mgr := NewMgr(cli, log.Log.WithName("operator"), starboard.ConfigData{"compliance.failEntriesLimit": limit})
+	if err := mgr.GenerateComplianceReport(context.TODO(), clusterComplianceSpec.Spec); err != nil {
+		return nil, err
+	}
+	return getDetailReport(context.TODO(), types.NamespacedName{Namespace: "", Name: "nsa-details"}, cli)
+}
+
+// detailsByCheck indexes the failure entries of a detail report by control ID, object type and check ID.
+func detailsByCheck(report *v1alpha1.ClusterComplianceDetailReport) map[string][]v1alpha1.ResultDetails {
+	result := make(map[string][]v1alpha1.ResultDetails)
+	for _, control := range report.Report.ControlChecks {
+		for _, sc := range control.ScannerCheckResult {
+			key := fmt.Sprintf("%s/%s/%s", control.ID, sc.ObjectType, sc.ID)
+			result[key] = append(result[key], sc.Details...)
+		}
+	}
+	return result
+}
