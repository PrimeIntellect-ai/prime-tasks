+import '../../../dom/node-parser';
+import {deepStrictEqual} from 'assert';
+import {CanvasRenderer} from '../../../render/canvas/canvas-renderer';
+import {CSSParsedDeclaration} from '../../index';
+import {TextContainer} from '../../../dom/text-container';
+import {Bounds} from '../../layout/bounds';
+import {TextBounds} from '../../layout/text';
+import {Logger} from '../../../core/logger';
+
+type TextRenderCalls = {
+    filled: string[];
+    stroked: string[];
+    strokeStyles: string[];
+    lineWidths: number[];
+};
+
+const styleProperty = (cssName: string): string =>
+    cssName.replace(/^-/, '').replace(/-([a-z])/g, (_, letter: string) => letter.toUpperCase());
+
+const isRedColor = (value: string): boolean => {
+    const color = value.toLowerCase();
+    return (
+        ['red', '#f00', '#ff0000'].includes(color) ||
+        /^rgba?\(\s*(?:255|100%)(?:\s*,\s*|\s+)(?:0|0%)(?:\s*,\s*|\s+)(?:0|0%)(?:\s*(?:,|\/)\s*(?:1(?:\.0*)?|100%))?\s*\)$/.test(color) ||
+        /^hsla?\(\s*0(?:deg)?(?:\s*,\s*|\s+)100%(?:\s*,\s*|\s+)50%(?:\s*(?:,|\/)\s*(?:1(?:\.0*)?|100%))?\s*\)$/.test(color)
+    );
+};
+
+const renderText = async (declaration: {[key: string]: string}, text: string): Promise<TextRenderCalls> => {
+    Logger.create({id: 'text-stroke-render', enabled: false});
+    const calls: TextRenderCalls = {filled: [], stroked: [], strokeStyles: [], lineWidths: []};
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const ctx: any = {
+        scale: () => undefined,
+        translate: () => undefined,
+        save: () => undefined,
+        restore: () => undefined,
+        fillText: (value: string) => calls.filled.push(value),
+        strokeText: (value: string) => {
+            calls.stroked.push(value);
+            calls.strokeStyles.push(ctx.strokeStyle);
+            calls.lineWidths.push(ctx.lineWidth);
+        },
+        measureText: () => ({width: 1}),
+        fillRect: () => undefined
+    };
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const canvas: any = {getContext: () => ctx, style: {}};
+    const renderer = new CanvasRenderer({
+        id: 'text-stroke-render',
+        scale: 1,
+        canvas,
+        x: 0,
+        y: 0,
+        scrollX: 0,
+        scrollY: 0,
+        width: 100,
+        height: 100,
+        windowWidth: 100,
+        windowHeight: 100,
+        // eslint-disable-next-line @typescript-eslint/no-explicit-any
+        cache: {} as any,
+        backgroundColor: null
+    });
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const styles = new CSSParsedDeclaration(
+        {
+            ...declaration,
+            getPropertyValue: (cssName: string) => declaration[styleProperty(cssName)] || ''
+        } as any
+    );
+    const container = {textBounds: [new TextBounds(text, new Bounds(0, 0, 10, 10))]} as TextContainer;
+    await renderer.renderTextNode(container, styles);
+    return calls;
+};
+
+describe('text-stroke', () => {
+    it('fills and strokes text with the computed stroke color and width', async () => {
+        const calls = await renderText(
+            {
+                fontSize: '16px',
+                fontFamily: 'Arial',
+                color: 'black',
+                [styleProperty('-webkit-text-stroke-width')]: '2px',
+                [styleProperty('-webkit-text-stroke-color')]: 'red'
+            },
+            'hello'
+        );
+
+        deepStrictEqual(calls.filled.join(''), 'hello');
+        deepStrictEqual(calls.stroked.join(''), 'hello');
+        deepStrictEqual(calls.strokeStyles.every(isRedColor), true);
+        deepStrictEqual(calls.lineWidths.every((lineWidth) => lineWidth === 2), true);
+    });
+});
