+@assert_no_logs
+@pytest.mark.parametrize('argument, texts', (
+    # TODO: start doesn’t work because running elements are removed from the
+    # original tree, and the current implentation in
+    # layout.get_running_element_for uses the tree to know if it’s at the
+    # beginning of the page
+
+    # ('start', ('', '2-first', '2-last', '3-last', '5')),
+
+    ('', ('', '2-first', '3-first', '3-last', '5')),
+    ('first', ('', '2-first', '3-first', '3-last', '5')),
+    ('last', ('', '2-last', '3-last', '3-last', '5')),
+    ('first-except', ('', '', '', '3-last', '')),
+))
+def test_running_elements(argument, texts):
+    pages = render_pages('''
+      <style>
+        @page {
+          margin: 50px;
+          size: 200px;
+          @bottom-center { content: element(title %s) }
+        }
+        article { break-after: page }
+        h1 { position: running(title) }
+      </style>
+      <article>
+        <div>1</div>
+      </article>
+      <article>
+        <h1>2-first</h1>
+        <h1>2-last</h1>
+      </article>
+      <article>
+        <p>3</p>
+        <h1>3-first</h1>
+        <h1>3-last</h1>
+      </article>
+      <article>
+      </article>
+      <article>
+        <h1>5</h1>
+      </article>
+    ''' % argument)
+    margin_texts = []
+    for page in pages:
+        margin = next(
+            box for box in page.descendants()
+            if getattr(box, 'at_keyword', None) == '@bottom-center')
+        margin_texts.append(''.join(
+            getattr(node, 'text', '') for node in margin.descendants()))
+    assert margin_texts == list(texts)
+
+
+@assert_no_logs
+def test_running_elements_display():
+    page, = render_pages('''
+      <style>
+        @page {
+          margin: 50px;
+          size: 200px;
+          @bottom-left { content: element(inline) }
+          @bottom-center { content: element(block) }
+          @bottom-right { content: element(table) }
+        }
+        table { position: running(table) }
+        div { position: running(block) }
+        span { position: running(inline) }
+      </style>
+      text
+      <table><tr><td>table</td></tr></table>
+      <div>block</div>
+      <span>inline</span>
+    ''')
+    margin_text = {
+        box.at_keyword: ''.join(
+            getattr(node, 'text', '') for node in box.descendants())
+        for box in page.descendants()
+        if getattr(box, 'at_keyword', None) in (
+            '@bottom-left', '@bottom-center', '@bottom-right')}
+    assert margin_text['@bottom-left'] == 'inline'
+    assert margin_text['@bottom-center'] == 'block'
+    assert margin_text['@bottom-right'] == 'table'
+
+
+@assert_no_logs
+def test_running_elements_table_in_block():
+    page, = render_pages('''
+      <style>
+        @page {
+          margin: 50px;
+          size: 200px;
+          @top-center { content: element(header) }
+        }
+        div { position: running(header) }
+      </style>
+      <div>
+        <table><tr><td>Hello World</td></tr></table>
+      </div>
+    ''')
+    margin = next(
+        box for box in page.descendants()
+        if getattr(box, 'at_keyword', None) == '@top-center')
+    assert ''.join(
+        getattr(node, 'text', '') for node in margin.descendants()
+    ) == 'Hello World'
