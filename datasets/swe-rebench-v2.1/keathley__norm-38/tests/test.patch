   test "no function" do
     assert_raise ArgumentError, "contract for undefined function foo/0", fn ->
       defmodule NoFunction do
@@ -100,4 +89,40 @@ defmodule Norm.ContractTest do
     assert WithoutParentheses2.fun(50) == 100
     assert WithoutParentheses2.other() == "Hello, world!"
   end
+
+  test "unnamed arguments" do
+    defmodule Unnamed do
+      use Norm
+
+      def int(), do: spec(is_integer())
+
+      @contract foo(int(), int()) :: int()
+      def foo(a, b), do: a + b
+
+      @contract first(int(), int()) :: int()
+      def first(a, _b), do: a
+    end
+
+    assert Unnamed.foo(1, 2) == 3
+    assert_raise Norm.MismatchError, fn -> Unnamed.first(1, "not an integer") end
+  end
+
+  test "reflection" do
+    defmodule Reflection do
+      use Norm
+
+      def int(), do: spec(is_integer())
+
+      @contract foo(a :: int(), int()) :: int()
+      def foo(a, b), do: a + b
+    end
+
+    contract = Reflection.__contract__({:foo, 2})
+
+    assert contract.__struct__ == Norm.Contract
+    assert Keyword.keys(contract.args) == [:a, :arg2]
+    assert Enum.all?(contract.args, fn {_name, spec} -> Norm.conform!(5, spec) == 5 end)
+    assert Norm.conform!(5, contract.result) == 5
+    assert_raise Norm.MismatchError, fn -> Norm.conform!("not an integer", contract.args[:arg2]) end
+  end
 end
