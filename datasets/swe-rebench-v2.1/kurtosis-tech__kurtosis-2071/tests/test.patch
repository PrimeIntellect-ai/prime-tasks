+func TestStartingServicePropagatesConfiguredTolerationsToPod(t *testing.T) {
+	const (
+		namespaceName = "test-enclave"
+		serviceName   = "test-service"
+		serviceUUID   = service.ServiceUUID("12345678-1234-1234-1234-123456789abc")
+		enclaveUUID   = enclave.EnclaveUUID("aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee")
+	)
+	tolerations := []apiv1.Toleration{{Key: "dedicated", Operator: apiv1.TolerationOpEqual, Value: "batch", Effect: apiv1.TaintEffectNoSchedule}}
+	serviceConfig, err := service.CreateServiceConfig(
+		testContainerImageName, nil, nil, nil, nil, nil, nil, nil, nil, nil,
+		0, 0, "private-ip-placeholder", 0, 0, map[string]string{}, nil, tolerations,
+	)
+	require.NoError(t, err)
+
+	var startedPod *apiv1.Pod
+	serviceLabels := map[string]string{
+		kubernetes_label_key.AppIDKubernetesLabelKey.GetString():                label_value_consts.AppIDKubernetesLabelValue.GetString(),
+		kubernetes_label_key.EnclaveUUIDKubernetesLabelKey.GetString():          string(enclaveUUID),
+		kubernetes_label_key.KurtosisResourceTypeKubernetesLabelKey.GetString(): label_value_consts.UserServiceKurtosisResourceTypeKubernetesLabelValue.GetString(),
+		kubernetes_label_key.GUIDKubernetesLabelKey.GetString():                 string(serviceUUID),
+		kubernetes_label_key.IDKubernetesLabelKey.GetString():                   serviceName,
+	}
+	namespaceLabels := map[string]string{
+		kubernetes_label_key.AppIDKubernetesLabelKey.GetString():                label_value_consts.AppIDKubernetesLabelValue.GetString(),
+		kubernetes_label_key.EnclaveUUIDKubernetesLabelKey.GetString():          string(enclaveUUID),
+		kubernetes_label_key.KurtosisResourceTypeKubernetesLabelKey.GetString(): label_value_consts.EnclaveKurtosisResourceTypeKubernetesLabelValue.GetString(),
+	}
+	registeredService := &apiv1.Service{
+		ObjectMeta: metav1.ObjectMeta{Name: serviceName, Namespace: namespaceName, Labels: serviceLabels},
+		Spec:       apiv1.ServiceSpec{ClusterIP: "10.0.0.10"},
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch {
+		case r.Method == http.MethodGet && r.URL.Path == "/api/v1/namespaces":
+			_ = json.NewEncoder(w).Encode(&apiv1.NamespaceList{Items: []apiv1.Namespace{{ObjectMeta: metav1.ObjectMeta{Name: namespaceName, Labels: namespaceLabels}}}})
+		case r.Method == http.MethodGet && strings.HasSuffix(r.URL.Path, "/services"):
+			_ = json.NewEncoder(w).Encode(&apiv1.ServiceList{Items: []apiv1.Service{*registeredService}})
+		case r.Method == http.MethodGet && strings.HasSuffix(r.URL.Path, "/pods"):
+			_ = json.NewEncoder(w).Encode(&apiv1.PodList{})
+		case r.Method == http.MethodPost && strings.HasSuffix(r.URL.Path, "/pods"):
+			body, readErr := io.ReadAll(r.Body)
+			require.NoError(t, readErr)
+			startedPod = &apiv1.Pod{}
+			require.NoError(t, json.Unmarshal(body, startedPod))
+			startedPod.Status.Phase = apiv1.PodRunning
+			w.WriteHeader(http.StatusCreated)
+			_ = json.NewEncoder(w).Encode(startedPod)
+		case r.Method == http.MethodGet && strings.Contains(r.URL.Path, "/pods/"):
+			if startedPod == nil {
+				http.NotFound(w, r)
+				return
+			}
+			_ = json.NewEncoder(w).Encode(startedPod)
+		case r.Method == http.MethodGet && strings.HasSuffix(r.URL.Path, "/ingresses"):
+			_ = json.NewEncoder(w).Encode(map[string]interface{}{"apiVersion": "networking.k8s.io/v1", "kind": "IngressList", "items": []interface{}{}})
+		case r.Method == http.MethodPatch && strings.Contains(r.URL.Path, "/services/"):
+			updated := registeredService.DeepCopy()
+			patch, readErr := io.ReadAll(r.Body)
+			require.NoError(t, readErr)
+			patchFields := map[string]json.RawMessage{}
+			require.NoError(t, json.Unmarshal(patch, &patchFields))
+			if rawAnnotations, ok := patchFields["metadata"]; ok {
+				metadata := map[string]json.RawMessage{}
+				require.NoError(t, json.Unmarshal(rawAnnotations, &metadata))
+				if annotationsRaw, ok := metadata["annotations"]; ok {
+					require.NoError(t, json.Unmarshal(annotationsRaw, &updated.Annotations))
+				}
+			}
+			_ = json.NewEncoder(w).Encode(updated)
+		default:
+			t.Errorf("unexpected Kubernetes API request: %s %s", r.Method, r.URL.Path)
+			http.Error(w, "unexpected request", http.StatusNotFound)
+		}
+	}))
+	defer server.Close()
+
+	clientset, err := kubernetes.NewForConfig(&rest.Config{Host: server.URL})
+	require.NoError(t, err)
+	manager := kubernetes_manager.NewKubernetesManager(clientset, nil, "")
+	_, failed, err := user_services_functions.StartRegisteredUserServices(
+		context.Background(), enclaveUUID,
+		map[service.ServiceUUID]*service.ServiceConfig{serviceUUID: serviceConfig},
+		nil, nil, &k8s_shared_helpers.EngineServerModeArgs{}, manager, apiv1.RestartPolicyNever,
+	)
+	require.NoError(t, err)
+	require.Empty(t, failed)
+	require.NotNil(t, startedPod)
+	require.Equal(t, tolerations, startedPod.Spec.Tolerations)
+}
