+
+# POSIXct fractional seconds finer than DateTime's millisecond resolution
+# must still convert successfully. Either truncation or rounding to the
+# nearest millisecond preserves the value at DateTime's resolution.
+converted = rcopy(R"as.POSIXct('2020-10-09 12:09:46.1234', tz='UTC')")
+lower = rcopy(R"as.POSIXct('2020-10-09 12:09:46.123', tz='UTC')")
+upper = rcopy(R"as.POSIXct('2020-10-09 12:09:46.124', tz='UTC')")
+@test converted isa DateTime
+@test converted in (lower, upper)
