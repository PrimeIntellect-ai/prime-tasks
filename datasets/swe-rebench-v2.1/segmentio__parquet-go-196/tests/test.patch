+func TestWriterOmitsTaggedFields(t *testing.T) {
+	input := []*event{
+		{Name: "customer1", Type: "request", Value: 42.0},
+		{Name: "customer2", Type: "access", Value: 1.0},
+	}
+
+	buffer := new(bytes.Buffer)
+	if err := writeParquetFile(buffer, makeRows(input)); err != nil {
+		t.Fatal(err)
+	}
+	file, err := parquet.OpenFile(bytes.NewReader(buffer.Bytes()), int64(buffer.Len()))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	columns := file.Schema().Columns()
+	wantColumns := []string{"name", "value"}
+	if len(columns) != len(wantColumns) {
+		t.Fatalf("schema has columns %v, want %v", columns, wantColumns)
+	}
+	seenColumns := make(map[string]bool, len(columns))
+	for _, column := range columns {
+		if len(column) == 1 {
+			seenColumns[column[0]] = true
+		}
+	}
+	for _, want := range wantColumns {
+		if !seenColumns[want] {
+			t.Errorf("schema columns %v do not contain %q", columns, want)
+		}
+	}
+
+	rows := file.RowGroups()[0].Rows()
+	defer rows.Close()
+	rowBuffer := make([]parquet.Row, len(input))
+	n, err := rows.ReadRows(rowBuffer)
+	if err != nil && n != len(input) {
+		t.Fatalf("reading rows: read %d of %d: %v", n, len(input), err)
+	}
+	if n != len(input) {
+		t.Fatalf("read %d rows, want %d", n, len(input))
+	}
+	structSchema := parquet.SchemaOf(&event{})
+	seenRows := make(map[string]bool, len(input))
+	for i, row := range rowBuffer {
+		var got event
+		if err := structSchema.Reconstruct(&got, row); err != nil {
+			t.Fatalf("reconstructing row %d: %v", i, err)
+		}
+		switch got.Name {
+		case "customer1":
+			if got.Value != 42.0 {
+				t.Errorf("row %d value = %v, want 42", i, got.Value)
+			}
+		case "customer2":
+			if got.Value != 1.0 {
+				t.Errorf("row %d value = %v, want 1", i, got.Value)
+			}
+		default:
+			t.Errorf("row %d has unexpected retained name %q", i, got.Name)
+		}
+		seenRows[got.Name] = true
+		if got.Type != "" || got.Category != "" {
+			t.Errorf("row %d reconstructed omitted fields with values (%q, %q)", i, got.Type, got.Category)
+		}
+	}
+	for _, name := range []string{"customer1", "customer2"} {
+		if !seenRows[name] {
+			t.Errorf("Parquet rows do not contain retained value %q", name)
+		}
+	}
+}
