+@pytest.mark.parametrize("nqubits,controls,target", [
+    (5, [0], 1),
+    (5, [0, 1, 2, 3], 4),
+    (6, [0, 1, 2, 3, 4], 5),
+])
+def test_controlled_by_density_matrix(backend, nqubits, controls, target):
+    """Controlled gates must work with density matrices of five or more qubits."""
+    original_backend = qibo.get_backend()
+    qibo.set_backend("numpy_defaulteinsum")
+    reference = Circuit(nqubits, density_matrix=True)
+    reference.add(gates.X(controls[0]))
+    reference.add(gates.H(target).controlled_by(*controls))
+    target_result = reference()
+    qibo.set_backend(backend)
+    circuit = Circuit(nqubits, density_matrix=True)
+    circuit.add(gates.X(controls[0]))
+    circuit.add(gates.H(target).controlled_by(*controls))
+    result = circuit()
+    np.testing.assert_allclose(result, target_result)
+    qibo.set_backend(original_backend)
