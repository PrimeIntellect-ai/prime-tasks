+@pytest.mark.parametrize("shape,axis", [
+    ((1, 5, 1, 2), None),
+    ((5, 1, 2), 1),
+    ((1, 5, 1, 2), (0, 2)),
+])
+def test_numpy_backend_squeeze_matches_numpy(shape, axis):
+    x = rand(shape)
+    result = backends.numpy_backend.squeeze(x, axis=axis)
+    np.testing.assert_array_equal(result, np.squeeze(x, axis=axis))
+
+
+def test_abstract_backend_squeeze_signature():
+    """The common backend interface accepts optional squeeze axes."""
+    parameters = inspect.signature(AbstractBackend.squeeze).parameters
+    assert list(parameters) == ["self", "x", "axis"]
+    assert parameters["axis"].default is None
+
