+func TestInlinePrimaryKeyDeclaration(t *testing.T) {
+	db, err := sql.Open("ramsql", "TestInlinePrimaryKeyDeclaration")
+	if err != nil {
+		t.Fatalf("sql.Open: %s", err)
+	}
+	defer db.Close()
+
+	if _, err = db.Exec(`CREATE TABLE inline_pk (id INT PRIMARY KEY, value TEXT)`); err != nil {
+		t.Fatalf("create table with inline primary key: %s", err)
+	}
+	if _, err = db.Exec(`INSERT INTO inline_pk (id, value) VALUES (1, "first")`); err != nil {
+		t.Fatalf("insert first row: %s", err)
+	}
+	if _, err = db.Exec(`INSERT INTO inline_pk (id, value) VALUES (2, "second")`); err != nil {
+		t.Fatalf("insert distinct primary key: %s", err)
+	}
+	if _, err = db.Exec(`INSERT INTO inline_pk (id, value) VALUES (1, "duplicate")`); err == nil {
+		t.Fatal("expected duplicate inline primary key to fail")
+	}
+}
+
+func TestSingleColumnTrailingPrimaryKeyDeclaration(t *testing.T) {
+	db, err := sql.Open("ramsql", "TestSingleColumnTrailingPrimaryKeyDeclaration")
+	if err != nil {
+		t.Fatalf("sql.Open: %s", err)
+	}
+	defer db.Close()
+
+	if _, err = db.Exec(`CREATE TABLE trailing_pk (id INT, value TEXT, PRIMARY KEY (id))`); err != nil {
+		t.Fatalf("create table with one-column trailing primary key: %s", err)
+	}
+	if _, err = db.Exec(`INSERT INTO trailing_pk (id, value) VALUES (1, "first")`); err != nil {
+		t.Fatalf("insert into table with one-column trailing primary key: %s", err)
+	}
+	if _, err = db.Exec(`INSERT INTO trailing_pk (id, value) VALUES (2, "second")`); err != nil {
+		t.Fatalf("distinct primary key should be accepted: %s", err)
+	}
+	if _, err = db.Exec(`INSERT INTO trailing_pk (id, value) VALUES (1, "duplicate")`); err == nil {
+		t.Fatal("expected duplicate one-column trailing primary key to fail")
+	}
+}
+
+func TestSingleColumnPrimaryKeyUniqueness(t *testing.T) {
+	db, err := sql.Open("ramsql", "TestSingleColumnPrimaryKeyUniqueness")
+	if err != nil {
+		t.Fatalf("sql.Open: %s", err)
+	}
+	defer db.Close()
+
+	if _, err = db.Exec(`CREATE TABLE single_pk (id INT, value TEXT, PRIMARY KEY (id))`); err != nil {
+		t.Fatalf("create table: %s", err)
+	}
+	if _, err = db.Exec(`INSERT INTO single_pk (id, value) VALUES (7, "first")`); err != nil {
+		t.Fatalf("insert first row: %s", err)
+	}
+	if _, err = db.Exec(`INSERT INTO single_pk (id, value) VALUES (8, "second")`); err != nil {
+		t.Fatalf("distinct primary key should be accepted: %s", err)
+	}
+	if _, err = db.Exec(`INSERT INTO single_pk (id, value) VALUES (7, "duplicate")`); err == nil {
+		t.Fatal("expected duplicate single-column primary key to fail")
+	}
+}
