+describe('display-name underscore-prefixed function assignments', () => {
+  const linter = new Linter();
+  linter.defineRule('display-name', rule);
+
+  function lint(code) {
+    return linter.verify(code, {
+      parserOptions,
+      rules: { 'display-name': 'error' },
+    });
+  }
+
+  it('does not report an underscore-prefixed property assignment as a component', () => {
+    const messages = lint('obj._property = (a) => { if (a == null) return null; return f(a); };');
+    assert.deepStrictEqual(messages, []);
+  });
+
+  it('does not report an underscore-prefixed variable assignment as a component', () => {
+    const messages = lint('_variable = (a) => { if (a == null) return null; return f(a); };');
