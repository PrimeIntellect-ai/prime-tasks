@@ -464,6 +464,20 @@ class SyntacticSuite extends scala.meta.tests.parsers.ParseSuite {
   test("some tricky parenthesization") {
     assertEquals(templStat("if (1) 2 else 3 + 4").syntax, "if (1) 2 else 3 + 4")
     assertEquals(templStat("(if (1) 2 else 3) + 4").syntax, "(if (1) 2 else 3) + 4")
+    // `syntax` must not change the semantics of a nested `if` without `else`
+    // in the `then` branch of an `if` that has an `else`. The contract permits
+    // either parenthesizing the inner `if` or adding an explicit `else ()`.
+    def assertSyntaxIsOneOf(code: String, expected: Set[String]): Unit = {
+      val printed = templStat(code).syntax
+      assert(expected.contains(printed), s"$code => $printed")
+    }
+    val disambiguated = Set(
+      "if (1) (if (2) 3) else 4",
+      "if (1) if (2) 3 else () else 4",
+      "if (1) (if (2) 3 else ()) else 4"
+    )
+    assertSyntaxIsOneOf("if (1) (if (2) 3) else 4", disambiguated)
+    assertSyntaxIsOneOf("if (1) if (2) 3 else () else 4", disambiguated)
     assertEquals(
       templStat("if (1) 2 else 3 match { case _ => }").syntax,
       s"if (1) 2 else 3 match {${EOL}  case _ =>${EOL}}"
