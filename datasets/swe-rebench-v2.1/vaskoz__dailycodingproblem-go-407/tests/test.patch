+package day196
+
+import "testing"
+
+var mostFrequentSubtreeSumCases407 = []struct {
+	head     *BinaryTree
+	expected int
+}{
+	{&BinaryTree{
+		Value: 5,
+		Left:  &BinaryTree{Value: 2},
+		Right: &BinaryTree{Value: -5},
+	}, 2},
+}
+
+func TestMostFrequentSubtreeSum407(t *testing.T) {
+	t.Parallel()
+	for _, tc := range mostFrequentSubtreeSumCases407 {
+		if result := MostFrequentSubtreeSum(tc.head); result != tc.expected {
+			t.Errorf("Expected %v, got %v", tc.expected, result)
+		}
+	}
+}
+
+func BenchmarkMostFrequentSubtreeSum407(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range mostFrequentSubtreeSumCases407 {
+			MostFrequentSubtreeSum(tc.head)
+		}
+	}
+}
