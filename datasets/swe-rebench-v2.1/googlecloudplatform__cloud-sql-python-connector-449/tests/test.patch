+def test_connector_formats_automatic_iam_username(
+    fake_credentials: Credentials,
+    db_version: str,
+    user: str,
+    expected_user: str,
+) -> None:
+    """Automatic IAM connections format usernames for the reported engine."""
+    connection_name = "my-project:my-region:my-instance"
+    project, _, instance_name = connection_name.split(":")
+    mock_instance = FakeCSQLInstance(
+        project=project,
+        name=instance_name,
+        db_version=db_version,
+    )
+    connector = Connector(enable_iam_auth=True, credentials=fake_credentials)
+    fake_credentials.token = "test-token"
+    fake_credentials.expiry = datetime.datetime.utcnow() + datetime.timedelta(hours=1)
+
+    def ephemeral_certificate(url: Any, **kwargs: Any) -> CallbackResult:
+        request = kwargs["json"]
+        return CallbackResult(
+            method="POST",
+            status=200,
+            body=mock_instance.generate_ephemeral(request["public_key"]),
+        )
+
+    try:
+        with (
+            patch.object(Credentials, "valid", True),
+            aioresponses() as mocked,
+            patch("pg8000.dbapi.connect", return_value=True) as driver_connect,
+        ):
+            mocked.get(
+                f"https://sqladmin.googleapis.com/sql/v1beta4/projects/{project}/instances/{instance_name}/connectSettings",
+                status=200,
+                body=mock_instance.connect_settings(),
+                repeat=True,
+            )
+            mocked.post(
+                f"https://sqladmin.googleapis.com/sql/v1beta4/projects/{project}/instances/{instance_name}:generateEphemeralCert",
+                callback=ephemeral_certificate,
+                repeat=True,
+            )
+
+            connector.connect(
+                connection_name,
+                "pg8000",
+                user=user,
+                password="password",
+                db="database",
+            )
+
+        driver_call = driver_connect.call_args
+        driver_user = (
+            driver_call.args[0]
+            if driver_call.args
+            else driver_call.kwargs.get("user")
+        )
+        assert driver_user == expected_user
+    finally:
+        connector.close()
