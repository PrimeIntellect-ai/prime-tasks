+
+func TestRunTrustAllProxiesWarningLinksToDocs(t *testing.T) {
+	SetMode(DebugMode)
+	defer SetMode(TestMode)
+
+	var buf bytes.Buffer
+	oldWriter := DefaultWriter
+	DefaultWriter = &buf
+	defer func() { DefaultWriter = oldWriter }()
+
+	engine := New()
+	// An unparsable address makes Run return right after printing the warning.
+	err := engine.Run("not a valid address")
+	assert.Error(t, err)
+
+	output := buf.String()
+	assert.Contains(t, output, "You trusted all proxies")
+	assert.Contains(t, output, "docs/doc.md#dont-trust-all-proxies")
+	assert.NotContains(t, output, "pkg.go.dev")
+}
