+
+  test('uintptr_t is generated as the pointer-sized unsigned FFI type', () {
+    final dir = Directory.systemTemp.createTempSync('ffigen_uintptr_test');
+    try {
+      final header = File('${dir.path}/uintptr_test.h');
+      header.writeAsStringSync('''
+#include <stdint.h>
+
+uintptr_t temp_u(uintptr_t a);
+intptr_t temp_i(intptr_t a);
+''');
+      final library = parser.parse(
+        Config.fromYaml(yaml.loadYaml('''
+${strings.name}: 'Bindings'
+${strings.output}: 'unused'
+${strings.headers}:
+  ${strings.entryPoints}:
+    - '${header.path}'
+  ${strings.includeDirectives}:
+    - '**uintptr_test.h'
+${strings.preamble}: |
+  // ignore_for_file: unused_element, unused_field
+''') as yaml.YamlMap),
+      );
+      final generated = library.generate();
+      expect(generated, contains('ffi.UintPtr'));
+      expect(generated, isNot(contains('ffi.UnsignedLong')));
+    } finally {
+      dir.deleteSync(recursive: true);
+    }
+  });
 }
 
