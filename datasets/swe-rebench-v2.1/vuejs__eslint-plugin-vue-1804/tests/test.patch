+/**
+ * @author Yosuke Ota
+ * See LICENSE file in root directory for full license.
+ */
+'use strict'
+
+const assert = require('assert')
+const Linter = require('eslint').Linter
+const plugin = require('../../../lib')
+const rule = plugin.rules['prefer-import-from-vue'] || { create: () => ({}) }
+
+const prohibitedPackages = [
+  '@vue/runtime-dom',
+  '@vue/runtime-core',
+  '@vue/reactivity',
+  '@vue/shared'
+]
+const linter = new Linter()
+linter.defineRule('prefer-import-from-vue', rule)
+
+function getDiagnostics(code) {
+  return linter.verify(code, {
+    parserOptions: {
+      ecmaVersion: 2020,
+      sourceType: 'module'
+    },
+    rules: {
+      'prefer-import-from-vue': 'error'
+    }
+  })
+}
+
+describe('prefer-import-from-vue', () => {
+  for (const source of prohibitedPackages) {
+    it(`reports imports from ${source}`, () => {
+      const messages = getDiagnostics(`import { value } from '${source}'`)
+      assert.ok(messages.length >= 1)
+      assert.strictEqual(messages[0].ruleId, 'prefer-import-from-vue')
+    })
+
+    it(`reports re-exports from ${source}`, () => {
+      const messages = getDiagnostics(`export { value } from '${source}'`)
+      assert.ok(messages.length >= 1)
+      assert.strictEqual(messages[0].ruleId, 'prefer-import-from-vue')
+    })
+  }
+
+  it('reports star re-exports from prohibited modules', () => {
+    for (const source of prohibitedPackages) {
+      const messages = getDiagnostics(`export * from '${source}'`)
+      assert.ok(messages.length >= 1, `expected a report for ${source}`)
+      assert.strictEqual(messages[0].ruleId, 'prefer-import-from-vue')
+    }
+  })
+
+  for (const code of [
+    `import { createApp } from 'vue'`,
+    `import { ref, reactive } from '@vue/composition-api'`,
+    `import { parse } from '@vue/compiler-dom'`,
+    `export { createApp } from 'vue'`,
+    `export * from 'vue'`,
+    `export { parse } from '@vue/compiler-dom'`,
+    `import Foo from 'foo'`
+  ]) {
+    it(`does not report ${code}`, () => {
+      assert.strictEqual(getDiagnostics(code).length, 0)
+    })
+  }
+})
