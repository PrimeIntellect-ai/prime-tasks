+func TestPingDescribeEmitsYamlResourceDocument(t *testing.T) {
+	pingClient := clientv1alpha2.NewMockKnPingSourceClient(t, "mynamespace")
+
+	pingRecorder := pingClient.Recorder()
+	pingRecorder.GetPingSource("testsource-uri", getPingSourceSinkURI(), nil)
+
+	out, err := executePingSourceCommand(pingClient, nil, "describe", "testsource-uri", "-o", "yaml")
+	assert.NilError(t, err)
+
+	var got v1alpha2.PingSource
+	assert.NilError(t, yaml.Unmarshal([]byte(out), &got))
+	assert.Equal(t, got.Kind, "PingSource")
+	assert.Equal(t, got.APIVersion, "sources.knative.dev/v1")
+	assert.Equal(t, got.Name, "testsource-uri")
+	assert.Equal(t, got.Namespace, "mynamespace")
+	assert.Equal(t, got.Spec.Schedule, "1 2 3 4 5")
+	assert.Equal(t, got.Spec.JsonData, "honeymoon")
+	assert.Equal(t, got.Spec.Sink.URI.String(), "https://foo")
+	pingRecorder.Validate()
+}
