+def test_reported_modules_have_no_unannotated_mutable_class_defaults():
+    mutable_factory_names = {"list", "dict", "set"}
+    for module_path in (Path("src/pipx/animate.py"), Path("src/pipx/pipx_metadata_file.py")):
+        module = ast.parse(module_path.read_text())
+        classvar_names = {"ClassVar"}
+        typing_module_names = {"typing"}
+        for statement in module.body:
+            if isinstance(statement, ast.ImportFrom) and statement.module in {"typing", "typing_extensions"}:
+                classvar_names.update(alias.asname or alias.name for alias in statement.names if alias.name == "ClassVar")
+            elif isinstance(statement, ast.Import):
+                typing_module_names.update(alias.asname or alias.name for alias in statement.names if alias.name == "typing")
+        for class_node in (node for node in ast.walk(module) if isinstance(node, ast.ClassDef)):
+            for statement in class_node.body:
+                if isinstance(statement, ast.Assign):
+                    value = statement.value
+                    annotation = None
+                elif isinstance(statement, ast.AnnAssign):
+                    value = statement.value
+                    annotation = statement.annotation
+                else:
+                    continue
+
+                mutable_default = isinstance(value, (ast.List, ast.Dict, ast.Set)) or (
+                    isinstance(value, ast.Call)
+                    and isinstance(value.func, ast.Name)
+                    and value.func.id in mutable_factory_names
+                )
+                is_class_variable = annotation is not None and any(
+                    (isinstance(node, ast.Name) and node.id in classvar_names)
+                    or (
+                        isinstance(node, ast.Attribute)
+                        and node.attr == "ClassVar"
+                        and isinstance(node.value, ast.Name)
+                        and node.value.id in typing_module_names
+                    )
+                    for node in ast.walk(annotation)
+                )
+                assert not mutable_default or is_class_variable, f"mutable class default in {module_path}:{class_node.name}"
+
+
+def test_package_info_default_collections_are_independent():
+    required_values = {
+        "package": "first",
+        "package_or_url": "first",
+        "pip_args": [],
+        "include_dependencies": False,
+        "include_apps": True,
+        "apps": [],
+        "app_paths": [],
+        "apps_of_dependencies": [],
+        "app_paths_of_dependencies": {},
+        "package_version": "1",
+    }
+    first = PackageInfo(**required_values)
+    second = PackageInfo(**{**required_values, "package": "second"})
+
+    first.man_pages.append("first.1")
+    first.man_paths.append(Path("first.1"))
+    first.man_pages_of_dependencies.append("dependency.1")
+    first.man_paths_of_dependencies["dependency"] = [Path("dependency.1")]
+
+    assert (
+        second.man_pages,
+        second.man_paths,
+        second.man_pages_of_dependencies,
+        second.man_paths_of_dependencies,
+    ) == ([], [], [], {})
+
