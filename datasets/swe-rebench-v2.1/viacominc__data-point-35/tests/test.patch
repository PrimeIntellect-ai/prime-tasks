 })
+
+describe('resolve#reducer-path collection transform', () => {
+  test('transform maps a trailing [] path over the input collection', () => {
+    const input = [
+      { a: { b: { c: 'foo' } } },
+      { a: { b: { c: 'bar' } } }
+    ]
+    return store.transform('$a.b.c[]', input).then(acc => {
+      expect(acc.value).toEqual(['foo', 'bar'])
+    })
+  })
+
+  test('transform maps a trailing [] path over numeric values', () => {
+    const input = [
+      { a: { b: { c: 1 } } },
+      { a: { b: { c: 2 } } },
+      { a: { b: { c: 3 } } }
+    ]
+    return store.transform('$a.b.c[]', input).then(acc => {
+      expect(acc.value).toEqual([1, 2, 3])
+    })
+  })
+
+  test('transform returns null for a trailing [] path on a non-array input', () => {
+    const input = { a: { b: { c: 'value' } } }
+    return store.transform('$a.b.c[]', input).then(acc => {
+      expect(acc.value).toBe(null)
+    })
+  })
+})
