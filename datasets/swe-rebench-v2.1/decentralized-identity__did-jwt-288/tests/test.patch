+++ b/src/__tests__/util.test.ts
@@ -0,0 +1,12 @@
+import { bigintToBytes } from '../util'
+
+describe('bigintToBytes', () => {
+  it('converts the reported odd-digit bigint without losing its value', () => {
+    const value = 1881146970754576322752261068397796891246589699629597037555588131642783231506n
+    const bytes = bigintToBytes(value)
+
+    expect(bytes.length).toBeGreaterThan(0)
+    expect(bytes.length * 2).toBeGreaterThanOrEqual(value.toString(16).length)
+    expect(BigInt(`0x${Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('')}`)).toBe(value)
+  })
+})
