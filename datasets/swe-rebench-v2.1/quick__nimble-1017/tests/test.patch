diff --git a/Tests/NimbleTests/Matchers/EqualTest.swift b/Tests/NimbleTests/Matchers/EqualTest.swift
index 92113e2..a04d442 100644
--- a/Tests/NimbleTests/Matchers/EqualTest.swift
+++ b/Tests/NimbleTests/Matchers/EqualTest.swift
@@ -283,6 +283,36 @@ final class EqualTest: XCTestCase { // swiftlint:disable:this type_body_length
         expect((1, "2", 3, four: "4")).to(equal((1, "2", 3, "4")))
         expect((1, "2", 3, four: "4", 5)).to(equal((1, "2", 3, "4", five: 5)))
         expect((1, "2", 3, four: "4", 5, "6")).to(equal((1, "2", 3, "4", five: 5, "6")))
+
+        expect((1, "2")) == (1, "2")
+        expect((1, two: "2")) == (1, two: "2")
+        expect((1, "2", 3)) == (1, "2", 3)
+        expect((1, "2", three: 3)) == (1, "2", three: 3)
+        expect((1, "2", 3, four: "4")) == (1, "2", 3, "4")
+        expect((1, "2", 3, four: "4", 5)) == (1, "2", 3, "4", five: 5)
+        expect((1, "2", 3, four: "4", 5, "6")) == (1, "2", 3, "4", five: 5, "6")
+
+        let recorder = AssertionRecorder()
+        withAssertionHandler(recorder) {
+            expect((1, "2")) == (1, "3")
+        }
+        XCTAssertTrue(recorder.assertions.contains { !$0.success })
+    }
+
+    func testTupleAsync() async {
+        await expect((1, "2")) == (1, "2")
+        await expect((1, two: "2")) == (1, two: "2")
+        await expect((1, "2", 3)) == (1, "2", 3)
+        await expect((1, "2", three: 3)) == (1, "2", three: 3)
+        await expect((1, "2", 3, four: "4")) == (1, "2", 3, "4")
+        await expect((1, "2", 3, four: "4", 5)) == (1, "2", 3, "4", five: 5)
+        await expect((1, "2", 3, four: "4", 5, "6")) == (1, "2", 3, "4", five: 5, "6")
+
+        let recorder = AssertionRecorder()
+        await withAssertionHandler(recorder) {
+            await expect((1, "2")) == (1, "3")
+        }
+        XCTAssertTrue(recorder.assertions.contains { !$0.success })
     }
 
     // see: https://github.com/Quick/Nimble/issues/867 and https://github.com/Quick/Nimble/issues/937
