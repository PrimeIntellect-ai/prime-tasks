+    def test_escaped_trailing_backslash_unquoted(self) -> None:
+        cf = self.from_file(
+            b'[core]\n\trepositoryformatversion = 0\n[remote "origin"]\n\turl = C:/Users/test\\\\\n\tfetch = +refs/heads/*:refs/remotes/origin/*\n'
+        )
+        self.assertEqual(b"C:/Users/test\\", cf.get((b"remote", b"origin"), b"url"))
+        self.assertEqual(
+            b"+refs/heads/*:refs/remotes/origin/*",
+            cf.get((b"remote", b"origin"), b"fetch"),
+        )
+
+    def test_escaped_trailing_backslash_quoted(self) -> None:
+        cf = self.from_file(
+            b'[core]\n\trepositoryformatversion = 0\n[remote "origin"]\n\turl = "C:\\\\Users\\\\test\\\\"\n\tfetch = +refs/heads/*:refs/remotes/origin/*\n'
+        )
+        self.assertEqual(b"C:\\Users\\test\\", cf.get((b"remote", b"origin"), b"url"))
+        self.assertEqual(
+            b"+refs/heads/*:refs/remotes/origin/*",
+            cf.get((b"remote", b"origin"), b"fetch"),
+        )
+
+    def test_unescaped_trailing_backslash_continues_value(self) -> None:
+        cf = self.from_file(
+            b'[remote "origin"]\n\turl = C:/Users/test\\\n\tfetch = +refs/heads/*:refs/remotes/origin/*\n'
+        )
+        # The unescaped backslash joins the next line onto the value, so the
+        # next line does not define a separate "fetch" setting.
+        self.assertTrue(
+            cf.get((b"remote", b"origin"), b"url").startswith(b"C:/Users/test")
+        )
+        self.assertIn(b"fetch", cf.get((b"remote", b"origin"), b"url"))
+        with self.assertRaises(KeyError):
+            cf.get((b"remote", b"origin"), b"fetch")
+
+
+class CloneTrailingBackslashPathTests(TestCase):
+    def test_clone_local_repo_with_trailing_backslash_path(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            source_path = os.path.join(tmp, "source_repo\\")
+            os.mkdir(source_path)
+            target_path = os.path.join(tmp, "cloned_repo")
+            with Repo.init(source_path) as source:
+                source.do_commit(
+                    b"Initial commit", committer=b"Test <test@example.com>"
+                )
+                with porcelain.clone(
+                    source_path, target_path, errstream=BytesIO()
+                ) as cloned:
+                    self.assertEqual(source.head(), cloned.head())
+                    self.assertEqual(
+                        os.fsencode(source_path),
+                        cloned.get_config().get((b"remote", b"origin"), b"url"),
+                    )
+
 
