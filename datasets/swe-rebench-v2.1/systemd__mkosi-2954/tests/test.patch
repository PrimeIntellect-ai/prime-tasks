+
+
+def test_mkosi_version_executable(tmp_path: Path) -> None:
+    d = tmp_path
+
+    version = d / "mkosi.version"
+    version.write_text("1.2.3\n")
+
+    with chdir(d):
+        _, [config] = parse_config()
+        assert config.image_version == "1.2.3"
+
+    version.write_text("#!/bin/sh\necho '4.5.6'\n")
+    version.chmod(0o755)
+
+    with chdir(d):
+        _, [config] = parse_config()
+        assert config.image_version == "4.5.6"
