+    def test_indexed_sos_constraints(self):
+        # This tests the example from issue #2827
+        m = pyo.ConcreteModel()
+        m.A = pyo.Set(initialize=[1])
+        m.B = pyo.Set(initialize=[1, 2, 3])
+        m.C = pyo.Set(initialize=[1])
+
+        m.param_cx = pyo.Param(m.A, initialize={1: 1})
+        m.param_cy = pyo.Param(m.B, initialize={1: 2, 2: 3, 3: 1})
+
+        m.x = pyo.Var(m.A, domain=pyo.NonNegativeReals, bounds=(0, 40))
+        m.y = pyo.Var(m.B, domain=pyo.NonNegativeIntegers)
+
+        @m.Objective()
+        def OBJ(m):
+            return sum(m.param_cx[a] * m.x[a] for a in m.A) + sum(
+                m.param_cy[b] * m.y[b] for b in m.B
+            )
+
+        m.y[3].bounds = (2, 3)
+
+        m.mysos = pyo.SOSConstraint(
+            m.C, var=m.y, sos=1, index={1: [2, 3]}, weights={2: 25.0, 3: 18.0}
+        )
+
+        OUT = io.StringIO()
+        COL = io.StringIO()
+        nl_writer.NLWriter().write(
+            m, OUT, colstream=COL, symbolic_solver_labels=True
+        )
+
+        # The NL writer must serialize the indexed SOS constraint without
+        # error, preserving the supplied SOS membership and weights.  The
+        # variable ordering (and therefore the numeric indices used in the
+        # "S" lines) is an implementation detail, so map those indices back
+        # to the symbolic variable labels before checking the membership.
+        col_labels = COL.getvalue().splitlines()
+        sosno, ref = _parse_sos_sections(OUT.getvalue(), col_labels)
+        self.assertEqual(set(sosno), {'y[2]', 'y[3]'})
+        self.assertEqual(set(ref), {'y[2]', 'y[3]'})
+        self.assertEqual(ref['y[2]'], 25.0)
+        self.assertEqual(ref['y[3]'], 18.0)
+        # SOS1 sets are encoded with a positive sosno tag
+        self.assertTrue(all(v > 0 for v in sosno.values()))
+
