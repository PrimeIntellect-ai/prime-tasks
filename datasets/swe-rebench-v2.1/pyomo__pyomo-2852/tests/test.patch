+import pyomo.environ as pyo
 
 _invalid_1j = r'InvalidNumber\((\([-+0-9.e]+\+)?1j\)?\)'
 
+def _parse_sos_sections(nl_text, col_labels):
+    """Extract the SOS membership (``sosno``) and reference weights (``ref``)
+    from an NL file, mapping the numeric variable indices back to their
+    symbolic labels."""
+    sosno = {}
+    ref = {}
+    lines = nl_text.splitlines()
+    for i, line in enumerate(lines):
+        fields = line.split()
+        if len(fields) != 3 or fields[0] not in ('S0', 'S1'):
+            continue
+        if fields[2] == 'sosno':
+            target = sosno
+        elif fields[2] == 'ref':
+            target = ref
+        else:
+            continue
+        for j in range(i + 1, i + 1 + int(fields[1])):
+            idx, val = lines[j].split()
+            target[col_labels[int(idx)]] = float(val)
+    return sosno, ref
+
 
