+test('immediately sync flushes when no handler is provided (sync false)', async ({ equal }) => {
+  const dest = pino.destination({ dest: getPathToNull(), sync: false })
+  let passed = false
+  dest.flushSync = () => {
+    passed = true
+  }
+  pino.final(pino(dest))
+  equal(passed, true)
+})
+
+test('immediately sync flushes when no handler is provided (sync true)', async ({ equal }) => {
+  const dest = pino.destination({ dest: getPathToNull(), sync: true })
+  let passed = false
+  dest.flushSync = () => {
+    passed = true
+  }
+  pino.final(pino(dest))
+  equal(passed, true)
+})
+
+test('swallows flushSync errors when no handler is provided', async ({ doesNotThrow }) => {
+  const dest = pino.destination({ dest: getPathToNull(), sync: false })
+  dest.flushSync = () => {
+    throw new Error('flush failed')
+  }
+  doesNotThrow(() => pino.final(pino(dest)))
+})
