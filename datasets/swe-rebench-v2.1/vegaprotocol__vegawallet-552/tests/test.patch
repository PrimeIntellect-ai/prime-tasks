+func newMockConsentPolicy(t *testing.T, pending chan service.ConsentRequest) service.Policy {
+	t.Helper()
+	return constructConsentPolicy(t, mocks.NewMockConsentPolicy, pending)
+}
+
+func newExplicitConsentPolicy(t *testing.T, pending chan service.ConsentRequest) service.Policy {
+	t.Helper()
+	return constructConsentPolicy(t, service.NewExplicitConsentPolicy, pending)
+}
+
+func constructConsentPolicy(t *testing.T, constructor interface{}, pending chan service.ConsentRequest) service.Policy {
+	t.Helper()
+	factory := reflect.ValueOf(constructor)
+	args := []reflect.Value{reflect.ValueOf(pending)}
+	for i := 1; i < factory.Type().NumIn(); i++ {
+		argType := factory.Type().In(i)
+		if argType.Kind() == reflect.Chan {
+			args = append(args, reflect.MakeChan(argType, 1))
+		} else {
+			args = append(args, reflect.Zero(argType))
+		}
+	}
+	return factory.Call(args)[0].Interface().(service.Policy)
+}
