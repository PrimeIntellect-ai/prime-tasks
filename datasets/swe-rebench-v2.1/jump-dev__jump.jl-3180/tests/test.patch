+function test_containers_denseaxisarray_view_axes_n()
+    x = Containers.@container([i = 4:6, j = [:A, :B]], (i, j))
+    y = @view x[5:6, :A]
+    @test sprint(show, MIME("text/plain"), y) isa String
+    @test axes(y) == (5:6,)
+    @test axes(y, 1) == 5:6
+    @test axes(y, 2) == Base.OneTo(1)
