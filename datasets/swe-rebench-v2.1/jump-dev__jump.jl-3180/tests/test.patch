+function test_containers_denseaxisarray_view_drops_dimension()
+    x = Containers.@container([i = 4:6, j = [:A, :B]], (i, j))
+    y = @view x[5:6, :A]
+    @test axes(y) == (5:6,)
+    @test y[5] == (5, :A)
+    @test y[6] == (6, :A)
+    x = Containers.@container([i = 4:6, j = [:A, :B], k = 1:3], (i, j, k))
+    y = @view x[5:6, :A, 1:2]
+    @test axes(y) == (5:6, 1:2)
+    @test y[5, 1] == (5, :A, 1)
+    @test y[6, 2] == (6, :A, 2)
+    return
+end
