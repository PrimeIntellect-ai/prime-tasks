+from bravado_core.response import validate_response
+from bravado_core.spec import Spec
+
+
+SWAGGER_ORIGIN = 'file:///tmp/swagger.json'
+MODEL_ORIGIN = 'file:///tmp/models.json'
+
+
+def swagger_spec(definitions=None):
+    spec = Spec.from_dict({
+        'swagger': '2.0',
+        'info': {'title': 'Test', 'version': '1.0'},
+        'paths': {},
+        'definitions': definitions or {},
+    }, origin_url=SWAGGER_ORIGIN)
+    spec.config['validate_responses'] = True
+    return spec
+
+
+class Response(object):
+    content_type = 'application/json'
+    text = 'null'
+    headers = {}
+
+    def json(self):
+        return None
+
+
+def validate_response_reference(spec, reference_schema):
+    operation = type('OperationStub', (), {
+        'swagger_spec': spec,
+        'produces': ['application/json'],
+    })()
+    validate_response(
+        {
+            'description': 'ok',
+            'schema': {
+                'type': 'object',
+                # This shape allows the response validator's parameter handling
+                # to accept the empty body while still evaluating allOf refs.
+                'in': 'body',
+                'allOf': [reference_schema],
+            },
+        },
+        operation,
+        Response(),
+    )
+
+
+def test_response_validation_resolves_reference_from_annotated_full_scope():
+    spec = swagger_spec()
+    spec.resolver.store[MODEL_ORIGIN] = {
+        'definitions': {'Address': {}},
+    }
+    reference_schema = {
+        '$ref': '#/definitions/Address',
+        'x-scope': [SWAGGER_ORIGIN, MODEL_ORIGIN],
+    }
+
+    validate_response_reference(spec, reference_schema)
+
+
+def test_response_validation_resolves_reference_without_scope_annotation():
+    spec = swagger_spec({'Address': {}})
+
+    validate_response_reference(
+        spec, {'$ref': '#/definitions/Address'})
