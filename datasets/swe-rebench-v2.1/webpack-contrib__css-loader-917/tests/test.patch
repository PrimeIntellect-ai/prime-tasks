diff --git a/test/localIdentName-option.test.js b/test/localIdentName-option.test.js
index 91aac17..942d77a 100644
--- a/test/localIdentName-option.test.js
+++ b/test/localIdentName-option.test.js
@@ -117,4 +117,59 @@ describe('localIdentName option', () => {
     expect(stats.compilation.warnings).toMatchSnapshot('warnings');
     expect(stats.compilation.errors).toMatchSnapshot('errors');
   });
+
+  it('should сorrectly replace escaped symbols in selector', async () => {
+    const config = {
+      loader: {
+        options: {
+          importLoaders: 2,
+          localIdentName: '[local]--[hash:base64:4]',
+          modules: true,
+        },
+      },
+    };
+    const testId = './modules/localIdentName.css';
+    const stats = await webpack(testId, config);
+    const { modules } = stats.toJson();
+    const module = modules.find((m) => m.id === testId);
+    const evaluatedModule = evaluated(module.source, modules);
+
+    const exportedName = evaluatedModule.locals['m_x_@'];
+
+    expect(exportedName.startsWith('m_x_@')).toBe(true);
+  });
+
+  it('should prefix an identifier starting with a digit with underscore', async () => {
+    const config = {
+      loader: {
+        options: { localIdentName: '1[local]', modules: true },
+      },
+    };
+    const testId = './modules/localIdentName.css';
+    const stats = await webpack(testId, config);
+    const { modules } = stats.toJson();
+    const module = modules.find((m) => m.id === testId);
+    const evaluatedModule = evaluated(module.source, modules);
+
+    Object.keys(evaluatedModule.locals).forEach((local) => {
+      expect(evaluatedModule.locals[local].startsWith('_')).toBe(true);
+    });
+  });
+
+  it('should prefix an identifier starting with two hyphens with underscore', async () => {
+    const config = {
+      loader: {
+        options: { localIdentName: '--[local]', modules: true },
+      },
+    };
+    const testId = './modules/localIdentName.css';
+    const stats = await webpack(testId, config);
+    const { modules } = stats.toJson();
+    const module = modules.find((m) => m.id === testId);
+    const evaluatedModule = evaluated(module.source, modules);
+
+    Object.keys(evaluatedModule.locals).forEach((local) => {
+      expect(evaluatedModule.locals[local].startsWith('_')).toBe(true);
+    });
+  });
 });
