+function withoutPackageLicense<T extends { files: Record<string, string> }>(
+	creation: T,
+): T {
+	const normalized = { ...creation, files: { ...creation.files } };
+	const packageJson = JSON.parse(normalized.files["package.json"]);
+	delete packageJson.license;
+	normalized.files["package.json"] = JSON.stringify(packageJson);
+	return normalized;
+}
