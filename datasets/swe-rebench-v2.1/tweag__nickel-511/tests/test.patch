+#[test]
+fn non_serializable_imported_function_keeps_source_location() {
+    use std::fs;
+    use std::process::Command;
+
+    let test_dir = std::env::temp_dir().join(format!(
+        "nickel-imported-function-{}-{}",
+        std::process::id(),
+        std::thread::current().name().unwrap_or("test")
+    ));
+    fs::create_dir_all(&test_dir).unwrap();
+
+    let imported_path = test_dir.join("function.ncl");
+    fs::write(&imported_path, "\n\nfun argument => argument\n").unwrap();
+
+    let main_path = test_dir.join("main.ncl");
+    fs::write(&main_path, "import \"function.ncl\"").unwrap();
+
+    let output = Command::new(env!("CARGO_BIN_EXE_nickel"))
+        .arg("-f")
+        .arg(&main_path)
+        .arg("export")
+        .output()
+        .unwrap();
+    let stderr = String::from_utf8_lossy(&output.stderr);
+
+    assert!(!output.status.success(), "a function cannot be exported");
+    assert!(stderr.contains("function.ncl:3:1"), "{}", stderr);
+
+    fs::remove_dir_all(test_dir).unwrap();
 }
