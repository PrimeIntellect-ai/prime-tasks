+/// Recursively erase the position information of a term, so that terms can be
+/// compared with `==` regardless of where they were parsed from.
+fn strip_pos(mut rt: RichTerm) -> RichTerm {
+    fn clear(rt: &mut RichTerm) {
+        rt.pos = TermPos::None;
+        rt.term.apply_to_rich_terms(clear);
+    }
+
+    clear(&mut rt);
+    rt
+}
