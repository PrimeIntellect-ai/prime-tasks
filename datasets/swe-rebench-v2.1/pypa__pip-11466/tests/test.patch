+def test_build_env_removes_system_site_packages(tmp_path: pathlib.Path) -> None:
+    environment = tmp_path / "system-site-environment"
+    venv.EnvBuilder(with_pip=False, system_site_packages=True).create(environment)
+    python = environment / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
+    source = pathlib.Path(__file__).resolve().parents[2] / "src"
+    env = os.environ.copy()
+    env["PYTHONPATH"] = os.pathsep.join(
+        filter(None, (os.fspath(source), env.get("PYTHONPATH", "")))
     )
+
+    output = subprocess.check_output(
+        [
+            os.fspath(python),
+            "-c",
+            dedent(
+                """
+                import json
+                import os
+                import site
+                import subprocess
+                import sys
+
+                from pip._internal.build_env import BuildEnvironment
+                from pip._internal.utils.temp_dir import global_tempdir_manager
+
+                child = '''
+                import importlib.util
+                import json
+                import os
+                import sys
+
+                names = json.loads(sys.argv[1])
+                sites = json.loads(sys.argv[2])
+                leaked = []
+                for name in names:
+                    try:
+                        spec = importlib.util.find_spec(name)
+                    except Exception:
+                        spec = None
+                    if spec is None:
+                        continue
+                    locations = list(spec.submodule_search_locations or [])
+                    if spec.origin and spec.origin not in ("built-in", "frozen"):
+                        locations.append(spec.origin)
+                    for location in locations:
+                        path = os.path.normcase(os.path.abspath(location))
+                        if any(path.startswith(site + os.sep) for site in sites):
+                            leaked.append(name)
+                            break
+                print(json.dumps(leaked))
+                '''
+
+                system_sites = [
+                    os.path.normcase(os.path.abspath(path))
+                    for path in site.getsitepackages()
+                    if os.path.isdir(path)
+                ]
+                names = set()
+                for site_dir in system_sites:
+                    for entry in os.listdir(site_dir):
+                        stem = entry[:-3] if entry.endswith(".py") else entry
+                        if stem.isidentifier() and not stem.startswith("_"):
+                            names.add(stem)
+
+                with global_tempdir_manager():
+                    build_env = BuildEnvironment()
+                    with build_env:
+                        leaked = json.loads(subprocess.check_output(
+                            [sys.executable, "-c", child,
+                             json.dumps(sorted(names)), json.dumps(system_sites)],
+                            text=True,
+                        ))
+                print(json.dumps([len(names), leaked]))
+                """
+            ),
+        ],
+        cwd=tmp_path,
+        env=env,
+        text=True,
+    )
+
+    checked, leaked = json.loads(output)
+    assert checked
+    assert leaked == []
