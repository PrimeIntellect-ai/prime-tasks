diff --git a/test/parser/markdown-extra.jl b/test/parser/markdown-extra.jl
index a6ebd5c..a758389 100644
--- a/test/parser/markdown-extra.jl
+++ b/test/parser/markdown-extra.jl
@@ -111,3 +111,45 @@ end
     """ |> fd2html_td
     @test isapproxstr(h, "good lord")
 end
+
+@testset "Double brace" begin
+    s = """
+        @def title = "hello"
+        {{title}}{{title}}
+        """ |> fd2html_td
+    @test isapproxstr(s, "<p>hellohello</p>")
+
+    s = """
+        @def title = "hello"
+        {{ title }}
+        """ |> fd2html_td
+    @test isapproxstr(s, "<p>hello</p>")
+end
+
+@testset "Double brace priority" begin
+    # `toc` is a zero-parameter hfun: the shorthand must not shadow it
+    s = """
+        @def toc = "SHADOWED"
+        {{toc}}
+        """
+    out = try
+        s |> fd2html_td
+    catch
+        ""
+    end
+    @test !occursin("SHADOWED", out)
+
+    # the variable is still reachable through the explicit fill
+    s = """
+        @def toc = "SHADOWED"
+        {{fill toc}}
+        """ |> fd2html_td
+    @test isapproxstr(s, "<p>SHADOWED</p>")
+
+    # `if ... end` is a block: the shorthand must not shadow it
+    s = """
+        @def v = true
+        {{if v}}yes{{end}}
+        """ |> fd2html_td
+    @test isapproxstr(s, "<p>yes</p>")
+end
