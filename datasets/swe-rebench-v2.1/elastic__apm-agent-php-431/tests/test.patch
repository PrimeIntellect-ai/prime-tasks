+declare(strict_types=1);
+
+namespace ElasticApmTests\UnitTests\Util;
+
+use Elastic\Apm\Impl\Log\SinkInterface;
+
+class MockLogSink implements SinkInterface
+{
+    /** @var MockLogSinkStatement[] */
+    public $consumed = [];
+
+    /** @inheritDoc */
+    public function consume(
+        int $statementLevel,
+        string $message,
+        array $contextsStack,
+        string $category,
+        string $srcCodeFile,
+        int $srcCodeLine,
+        string $srcCodeFunc,
+        ?bool $includeStacktrace,
+        int $numberOfStackFramesToSkip
+    ): void {
+        $this->consumed[] = new MockLogSinkStatement(
+            $statementLevel,
+            $message,
+            $contextsStack,
+            $category,
+            $srcCodeFile,
+            $srcCodeLine,
+            $srcCodeFunc,
+            $includeStacktrace,
+            $numberOfStackFramesToSkip
+        );
+    }
+}
