+// TestTmplLevelExecutorSecurityContext verifies that executor security settings are applied to the wait container.
+func TestTmplLevelExecutorSecurityContext(t *testing.T) {
+	var user int64 = 1000
+	woc := newWoc()
+	readOnlyRootFilesystem := true
+	woc.controller.Config.Executor = &apiv1.Container{SecurityContext: &apiv1.SecurityContext{
+		RunAsUser:              &user,
+		ReadOnlyRootFilesystem: &readOnlyRootFilesystem,
+	}}
+	tmplCtx, err := woc.createTemplateContext("")
+	assert.NoError(t, err)
+	_, err = woc.executeContainer(woc.wf.Spec.Entrypoint, tmplCtx.GetCurrentTemplateBase().GetTemplateScope(), &woc.wf.Spec.Templates[0], &woc.wf.Spec.Templates[0], &executeTemplateOpts{})
+	assert.NoError(t, err)
+	pods, err := woc.controller.kubeclientset.CoreV1().Pods("").List(metav1.ListOptions{})
+	assert.NoError(t, err)
+	var pod *apiv1.Pod
+	for i := range pods.Items {
+		for _, container := range pods.Items[i].Spec.Containers {
+			if container.Name == common.MainContainerName {
+				pod = &pods.Items[i]
+				break
+			}
+		}
+		if pod != nil {
+			break
+		}
+	}
+	if !assert.NotNil(t, pod, "workflow pod should be present") {
+		return
+	}
+
+	var waitCtr apiv1.Container
+	for _, container := range pod.Spec.Containers {
+		if container.Name == common.WaitContainerName {
+			waitCtr = container
+			break
+		}
+	}
+	assert.NotNil(t, waitCtr.SecurityContext)
+	if waitCtr.SecurityContext != nil {
+		assert.NotNil(t, waitCtr.SecurityContext.RunAsUser)
+		if waitCtr.SecurityContext.RunAsUser != nil {
+			assert.Equal(t, int64(1000), *waitCtr.SecurityContext.RunAsUser)
+		}
+		assert.NotNil(t, waitCtr.SecurityContext.ReadOnlyRootFilesystem)
+		if waitCtr.SecurityContext.ReadOnlyRootFilesystem != nil {
+			assert.True(t, *waitCtr.SecurityContext.ReadOnlyRootFilesystem)
+		}
+	}
+}
