 	"testing"
 	"time"
 
@@ -209,3 +211,38 @@ func TestProgressbarPrinter_UpdateTitle(t *testing.T) {
 
 	testza.AssertEqual(t, "test2", p2.Title)
 }
+
+func TestProgressbarPrinter_OutputToWriters(t *testing.T) {
+	testCases := map[string]struct {
+		action                func(*pterm.ProgressbarPrinter)
+		expectOutputToContain string
+	}{
+		"ExpectUpdatedTitleToBeWrittenToConfiguredWriter": {
+			action: func(pb *pterm.ProgressbarPrinter) {
+				pb.UpdateTitle("Updated text")
+			},
+			expectOutputToContain: "Updated text",
+		},
+	}
+
+	for testTitle, testCase := range testCases {
+		t.Run(testTitle, func(t *testing.T) {
+			output := &bytes.Buffer{}
+			printer := pterm.DefaultProgressbar
+			configurable, ok := interface{}(&printer).(interface {
+				WithWriter(io.Writer) *pterm.ProgressbarPrinter
+			})
+			if !ok {
+				t.Fatal("ProgressbarPrinter does not support a custom writer")
+			}
+			pb, err := configurable.WithWriter(output).WithTitle("Hello world").Start()
+			testza.AssertNoError(t, err)
+			time.Sleep(time.Second) // Required otherwise the goroutine doesn't run and the text isnt outputted
+			testCase.action(pb)
+			time.Sleep(time.Second) // Required otherwise the goroutine doesn't run and the text isnt updated
+
+			testza.AssertContains(t, output.String(), "Hello world")
+			testza.AssertContains(t, output.String(), testCase.expectOutputToContain)
+		})
+	}
+}
