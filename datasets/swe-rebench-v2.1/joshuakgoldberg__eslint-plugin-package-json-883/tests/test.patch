+import { Linter } from "eslint";
+import jsoncESLintParser from "jsonc-eslint-parser";
+import { describe, expect, test } from "vitest";
+
+import { rules } from "../../rules/require-properties.js";
+
+const linter = new Linter();
+const requireNameRule = rules["require-name"];
+const config = [
+	{
+		files: ["**/*.json"],
+		languageOptions: { parser: jsoncESLintParser },
+		plugins: {
+			packageJson: {
+				rules: requireNameRule
+					? { "require-name": requireNameRule }
+					: {},
+			},
+		},
+		rules: requireNameRule
+			? { "packageJson/require-name": "error" as const }
+			: {},
+	},
+];
+
+const lint = (code: string) =>
+	linter.verify(code, config, { filename: "package.json" });
+
+describe("require-name", () => {
+	test.each([
+		"{}",
+		'{ "version": "1.0.0" }',
+		'{ "bin": { "name": "nested" } }',
+	])("reports when the top-level name is missing: %s", (code) => {
+		const messages = lint(code);
+
+		expect(
+			messages.some(
+				(message) => message.ruleId === "packageJson/require-name",
+			),
+		).toBe(true);
+	});
+
+	test("does not report when the top-level name is present", () => {
+		const messages = lint('{ "name": "test" }');
+
+		expect(
+			messages.some(
+				(message) => message.ruleId === "packageJson/require-name",
+			),
+		).toBe(false);
+	});
+});
