--- /dev/null
+++ b/tests/options.test.ts
@@ -0,0 +1,123 @@
+import * as pulumi from '@pulumi/pulumi';
+import { StackManifest } from '../src/assembly';
+import { StackConverter } from '../src/converters/app-converter';
+import { MockAppComponent } from './mocks';
+import { CfnDeletionPolicy } from 'aws-cdk-lib';
+
+jest.mock('@pulumi/pulumi', () => {
+    return {
+        ...jest.requireActual('@pulumi/pulumi'),
+        CustomResource: jest.fn().mockImplementation(() => {
+            return {};
+        }),
+    };
+});
+
+afterAll(() => {
+    jest.resetAllMocks();
+});
+
+beforeEach(() => {
+    jest.clearAllMocks();
+});
+
+function bucketManifest(deletionPolicy?: CfnDeletionPolicy): StackManifest {
+    const resource: { [key: string]: any } = {
+        Type: 'AWS::S3::Bucket',
+        Properties: {},
+    };
+    if (deletionPolicy !== undefined) {
+        resource.DeletionPolicy = deletionPolicy;
+    }
+    return new StackManifest({
+        id: 'stack',
+        templatePath: 'test/stack',
+        metadata: {
+            'stack/bucket': 'bucket',
+        },
+        tree: {
+            path: 'stack',
+            id: 'stack',
+            children: {
+                bucket: {
+                    id: 'bucket',
+                    path: 'stack/bucket',
+                    attributes: {
+                        'aws:cdk:cloudformation:type': 'AWS::S3::Bucket',
+                    },
+                },
+            },
+            constructInfo: {
+                fqn: 'aws-cdk-lib.Stack',
+                version: '2.149.0',
+            },
+        },
+        template: {
+            Resources: {
+                bucket: resource,
+            },
+        },
+        dependencies: [],
+    });
+}
+
+function convert(manifest: StackManifest): void {
+    const converter = new StackConverter(new MockAppComponent('/tmp/foo/bar/does/not/exist'), manifest);
+    converter.convert(new Set());
+}
+
+/**
+ * Returns the effective `retainOnDelete` value of the created bucket resource.
+ *
+ * The removal policy may be applied either directly through the resource options or
+ * through a resource transformation, so both are taken into account. This keeps the
+ * check focused on the resulting lifecycle behaviour rather than on how it is wired up.
+ */
+function effectiveRetainOnDelete(): boolean | undefined {
+    const mock = pulumi.CustomResource as unknown as jest.Mock;
+    const call = mock.mock.calls.find((c) => c[0] === 'aws-native:s3:Bucket');
+    if (call === undefined) {
+        throw new Error('expected the bucket resource to be created');
+    }
+    let opts: pulumi.ResourceOptions = { ...call[3] };
+    for (const transformation of opts.transformations ?? []) {
+        const result = (transformation as any)({
+            resource: {} as pulumi.Resource,
+            type: 'aws-native:s3:Bucket',
+            name: 'bucket',
+            props: {},
+            opts,
+        });
+        if (result) {
+            opts = result.opts;
+        }
+    }
+    return opts.retainOnDelete;
+}
+
+describe('removal policy', () => {
+    test('retains the resource when DeletionPolicy=Retain', () => {
+        convert(bucketManifest(CfnDeletionPolicy.RETAIN));
+        expect(effectiveRetainOnDelete()).toBe(true);
+    });
+
+    test('retains the resource when DeletionPolicy=RetainExceptOnCreate', () => {
+        convert(bucketManifest(CfnDeletionPolicy.RETAIN_EXCEPT_ON_CREATE));
+        expect(effectiveRetainOnDelete()).toBe(true);
+    });
+
+    test('does not retain the resource when DeletionPolicy=Delete', () => {
+        convert(bucketManifest(CfnDeletionPolicy.DELETE));
+        expect(effectiveRetainOnDelete()).toBe(false);
+    });
+
+    test('retains the resource when DeletionPolicy=Snapshot', () => {
+        convert(bucketManifest(CfnDeletionPolicy.SNAPSHOT));
+        expect(effectiveRetainOnDelete()).toBe(true);
+    });
+
+    test('does not retain the resource when no DeletionPolicy is set', () => {
+        convert(bucketManifest());
+        expect(effectiveRetainOnDelete()).not.toBe(true);
+    });
+});
