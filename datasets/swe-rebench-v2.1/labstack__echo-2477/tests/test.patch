+// TestRequestLoggerParallelSetupNoDataRace exercises concurrent construction of
+// RequestLogger middleware. When run with the race detector it fails if the
+// middleware mutates shared package state during setup.
+func TestRequestLoggerParallelSetupNoDataRace(t *testing.T) {
+	var wg sync.WaitGroup
+	for i := 0; i < 10; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			e := echo.New()
+			e.Pre(RequestLoggerWithConfig(RequestLoggerConfig{
+				LogValuesFunc: func(c echo.Context, v RequestLoggerValues) error {
+					return nil
+				},
+			}))
+			req := httptest.NewRequest(http.MethodGet, "/", nil)
+			res := httptest.NewRecorder()
+			e.ServeHTTP(res, req)
+		}()
+	}
+	wg.Wait()
+}
