+    // MARK: - With fixed precision
+
+    // When `useFixedPrecision` is true the writer trims trailing zeros from the
+    // coordinates. The exact textual form (for example whether the writer falls
+    // back to scientific notation) is an implementation detail of the
+    // underlying GEOS writer, so these tests only assert the trimming property
+    // that the public contract actually specifies.
+    func testWKTOptionsWithFixedPrecisionAndALongFraction() {
+        let point = Point(x: 0.11111111111111111, y: 0.1234567890)
+
+        verifyWKTOptionsAreTrimmed(wktConvertible: point, roundingPrecision: -1)
+        verifyWKTOptionsAreTrimmed(wktConvertible: point, roundingPrecision: 0)
+        verifyWKTOptionsAreTrimmed(wktConvertible: point, roundingPrecision: 1)
+        verifyWKTOptionsAreTrimmed(wktConvertible: point, roundingPrecision: 5)
+        verifyWKTOptions(
+            wktConvertible: point,
+            useFixedPrecision: true,
+            roundingPrecision: 1,
+            expectedWKT: "POINT (0.1 0.1)")
+        verifyWKTOptions(
+            wktConvertible: point,
+            useFixedPrecision: true,
+            roundingPrecision: 5,
+            expectedWKT: "POINT (0.11111 0.12346)")
+    }
+
+    func testWKTOptionsWithFixedPrecisionAndAShortFraction() {
+        let point = Point(x: 1, y: 987654321.1)
+
+        verifyWKTOptionsAreTrimmed(wktConvertible: point, roundingPrecision: -1)
+        verifyWKTOptionsAreTrimmed(wktConvertible: point, roundingPrecision: 0)
+        verifyWKTOptionsAreTrimmed(wktConvertible: point, roundingPrecision: 1)
+        verifyWKTOptionsAreTrimmed(wktConvertible: point, roundingPrecision: 5)
+    }
+
+    func testWKTOptionsWithFixedPrecisionAndFractionalValues() {
+        let point = Point(x: 0.1, y: 0.000000123456)
+
+        verifyWKTOptionsAreTrimmed(wktConvertible: point, roundingPrecision: -1)
+        verifyWKTOptionsAreTrimmed(wktConvertible: point, roundingPrecision: 0)
+        verifyWKTOptionsAreTrimmed(wktConvertible: point, roundingPrecision: 1)
+        verifyWKTOptionsAreTrimmed(wktConvertible: point, roundingPrecision: 5)
+    }
+
+    /// Asserts that the fixed-precision writer trims trailing zeros from every
+    /// coordinate it emits. Scientific notation is tolerated: only the
+    /// fractional part of the mantissa is inspected.
+    func verifyWKTOptionsAreTrimmed<T>(wktConvertible: T,
+                                       roundingPrecision: Int32,
+                                       line: UInt = #line) where T: WKTConvertible {
+        do {
+            let wktString = try wktConvertible.wkt(
+                useFixedPrecision: true,
+                roundingPrecision: roundingPrecision)
+
+            let numbers = wktString.split { !"0123456789.eE+-".contains($0) }
+            for number in numbers {
+                let mantissa = number.split { $0 == "e" || $0 == "E" }.first ?? number[...]
+                guard let dot = mantissa.firstIndex(of: ".") else { continue }
+                let fraction = mantissa[mantissa.index(after: dot)...]
+                XCTAssertFalse(
+                    fraction.hasSuffix("0"),
+                    "Expected a trimmed coordinate but found \(number) in \(wktString)",
+                    line: line)
+            }
+        } catch {
+            XCTFail("Unexpected error: \(error)", line: line)
+        }
+    }
+
+    // MARK: - Options apply to every WKTConvertible geometry
+
+    func testWKTOptionsApplyToNonPointGeometries() throws {
+        let lineString = try LineString(points: [
+            Point(x: 0.123456, y: 0.234567),
+            Point(x: 0.345678, y: 0.456789)])
+
+        verifyWKTOptions(
+            wktConvertible: lineString,
+            useFixedPrecision: false,
+            roundingPrecision: 2,
+            expectedWKT: "LINESTRING (0.12 0.23, 0.35 0.46)")
+        verifyWKTOptions(
+            wktConvertible: lineString,
+            useFixedPrecision: false,
+            roundingPrecision: 5,
+            expectedWKT: "LINESTRING (0.12346 0.23457, 0.34568 0.45679)")
+        verifyWKTOptions(
+            wktConvertible: lineString,
+            useFixedPrecision: true,
+            roundingPrecision: 2,
+            expectedWKT: "LINESTRING (0.12 0.23, 0.35 0.46)")
+    }
 }
