+// recordingTradingService records the RPC methods invoked on it. It is
+// deliberately type-agnostic so the test observes which RPC the forwarder
+// actually calls on the wire.
+type recordingTradingService struct {
+	mu    sync.Mutex
+	calls int
+}
+
+func (s *recordingTradingService) record() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.calls++
+}
+
+func (s *recordingTradingService) callCount() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.calls
+}
+
+func recordingSubmitTransactionHandler(srv interface{}, _ context.Context, dec func(interface{}) error, _ grpc.UnaryServerInterceptor) (interface{}, error) {
+	if err := dec(&empty.Empty{}); err != nil {
+		return nil, err
+	}
+	srv.(*recordingTradingService).record()
+	return &empty.Empty{}, nil
+}
+
+var recordingTradingServiceDesc = grpc.ServiceDesc{
+	ServiceName: "api.v1.TradingService",
+	HandlerType: (*interface{})(nil),
+	Methods: []grpc.MethodDesc{
+		{
+			MethodName: "SubmitTransaction",
+			Handler:    recordingSubmitTransactionHandler,
+		},
+	},
+	Streams:  []grpc.StreamDesc{},
+	Metadata: "trading.proto",
+}
+
+// TestForwarderSendTxUsesSubmitTransactionRPC ensures the concrete node
+// forwarder submits transactions through the renamed SubmitTransaction RPC.
+func TestForwarderSendTxUsesSubmitTransactionRPC(t *testing.T) {
+	lis, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+
+	srv := grpc.NewServer()
+	recorder := &recordingTradingService{}
+	srv.RegisterService(&recordingTradingServiceDesc, recorder)
+	go func() {
+		_ = srv.Serve(lis)
+	}()
+	defer srv.Stop()
+
+	// wait until the server is accepting connections
+	conn, err := grpc.Dial(lis.Addr().String(), grpc.WithInsecure(), grpc.WithBlock())
+	require.NoError(t, err)
+	_ = conn.Close()
+
+	forwarder, err := node.NewForwarder(zap.NewNop(), node.NodesConfig{
+		Hosts:   []string{lis.Addr().String()},
+		Retries: 3,
+	})
+	require.NoError(t, err)
+	defer forwarder.Stop()
+
+	tx := &commandspb.Transaction{}
+	err = forwarder.SendTx(context.Background(), tx, 0)
+	require.NoError(t, err)
+
+	require.GreaterOrEqual(t, recorder.callCount(), 1)
+}
