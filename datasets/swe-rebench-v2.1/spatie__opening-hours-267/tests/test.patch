+if (! \function_exists('easter_days')) {
+    /**
+     * Polyfill for the calendar extension's easter_days() used by the tests.
+     * Returns the number of days after March 21 on which Easter Sunday falls.
+     */
+    function easter_days(int $year): int
+    {
+        $a = $year % 19;
+        $b = intdiv($year, 100);
+        $c = $year % 100;
+        $d = intdiv($b, 4);
+        $e = $b % 4;
+        $f = intdiv($b + 8, 25);
+        $g = intdiv($b - $f + 1, 3);
+        $h = (19 * $a + $b - $d - $g + 15) % 30;
+        $i = intdiv($c, 4);
+        $k = $c % 4;
+        $l = (32 + 2 * $e + 2 * $i - $h - $k) % 7;
+        $m = intdiv($a + 11 * $h + 22 * $l, 451);
+        $month = intdiv($h + $l - 7 * $m + 114, 31);
+        $day = (($h + $l - 7 * $m + 114) % 31) + 1;
+
+        $easter = new \DateTimeImmutable(sprintf('%04d-%02d-%02d', $year, $month, $day));
+        $march21 = new \DateTimeImmutable(sprintf('%04d-03-21', $year));
+
+        return (int) $march21->diff($easter)->days;
+    }
