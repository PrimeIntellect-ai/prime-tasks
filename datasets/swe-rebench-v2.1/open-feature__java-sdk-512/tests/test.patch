+    @Test
+    @DisplayName("independently built empty metadata compares equal in evaluation details")
+    public void comparesEvaluationDetailsWithEmptyMetadata() {
+        ImmutableMetadata firstMetadata = ImmutableMetadata.builder().build();
+        ImmutableMetadata secondMetadata = ImmutableMetadata.builder().build();
+
+        assertEquals(firstMetadata, secondMetadata);
+        assertEquals(firstMetadata.hashCode(), secondMetadata.hashCode());
+
+        FlagEvaluationDetails<Boolean> first = FlagEvaluationDetails.<Boolean>builder()
+                .reason(Reason.ERROR.toString())
+                .value(false)
+                .errorCode(ErrorCode.GENERAL)
+                .errorMessage("error XXX")
+                .flagMetadata(firstMetadata)
+                .build();
+        FlagEvaluationDetails<Boolean> second = FlagEvaluationDetails.<Boolean>builder()
+                .reason(Reason.ERROR.toString())
+                .value(false)
+                .errorCode(ErrorCode.GENERAL)
+                .errorMessage("error XXX")
+                .flagMetadata(secondMetadata)
+                .build();
+
+        assertEquals(first, second);
+    }
+
+    @Test
+    @DisplayName("should be able to compare 2 FlagEvaluationDetails")
+    public void compareFlagEvaluationDetails(){
+        FlagEvaluationDetails fed1 = FlagEvaluationDetails.builder()
+                .reason(Reason.ERROR.toString())
+                .value(false)
+                .errorCode(ErrorCode.GENERAL)
+                .errorMessage("error XXX")
+                .flagMetadata(ImmutableMetadata.builder().addString("metadata","1").build())
+                .build();
+
+        FlagEvaluationDetails fed2 = FlagEvaluationDetails.builder()
+                .reason(Reason.ERROR.toString())
+                .value(false)
+                .errorCode(ErrorCode.GENERAL)
+                .errorMessage("error XXX")
+                .flagMetadata(ImmutableMetadata.builder().addString("metadata","1").build())
+                .build();
+
+        assertEquals(fed1,fed2);
+
+        FlagEvaluationDetails fedWithDifferentMetadata = FlagEvaluationDetails.builder()
