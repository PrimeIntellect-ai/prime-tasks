+                .value(false)
+                .errorCode(ErrorCode.GENERAL)
+                .errorMessage("error XXX")
+                .flagMetadata(ImmutableMetadata.builder().addString("metadata","2").build())
+                .build();
+
+        assertNotEquals(fed1, fedWithDifferentMetadata);
+    }
