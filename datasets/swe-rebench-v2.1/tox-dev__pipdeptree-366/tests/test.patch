+from __future__ import annotations
+
+import os
+import subprocess  # noqa: S404
+import sys
+from pathlib import Path
+
+import pytest
+
+
+def test_cli_auto_uses_active_environment_interpreter(tmp_path: Path) -> None:
+    if os.name == "nt":  # pragma: no cover
+        pytest.skip("POSIX-only wrapper interpreter")
+
+    bin_dir = tmp_path / "bin"
+    bin_dir.mkdir()
+    marker = tmp_path / "invoked.txt"
+    wrapper = bin_dir / "python"
+    wrapper.write_text(
+        f"#!{sys.executable}\n"
+        "import subprocess\n"
+        "import sys\n"
+        f"with open({str(marker)!r}, 'a', encoding='utf-8') as stream:\n"
+        "    stream.write('used\\n')\n"
+        "result = subprocess.run([sys.executable, *sys.argv[1:]], check=False)\n"
+        "raise SystemExit(result.returncode)\n"
+    )
+    wrapper.chmod(0o755)
+    # A real activated environment exposes its interpreter through PATH and
+    # commonly provides both python and python3 entry points.
+    (bin_dir / "python3").symlink_to(wrapper)
+
+    env = {key: value for key, value in os.environ.items() if key not in {"CONDA_PREFIX", "VIRTUAL_ENV"}}
+    env["VIRTUAL_ENV"] = str(tmp_path)
+    env["PATH"] = f"{bin_dir}{os.pathsep}{env.get('PATH', '')}"
+    result = subprocess.run(  # noqa: S603
+        [sys.executable, "-m", "pipdeptree", "--python", "auto", "--json"],
+        capture_output=True,
+        text=True,
+        env=env,
+        check=False,
+    )
+
+    assert result.returncode == 0, result.stderr
+    assert marker.exists(), "the active environment's interpreter was not used"
