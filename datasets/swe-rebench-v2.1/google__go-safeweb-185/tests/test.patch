+	mux.Handle("/", safehttp.MethodGet, safehttp.HandlerFunc(func(w *safehttp.ResponseWriter, r *safehttp.IncomingRequest) safehttp.Result {
+		return w.Write(safehtml.HTMLEscaped("handled"))
+	}))
+
+	req := httptest.NewRequest(safehttp.MethodGet, "http://unconfigured.test/", nil)
+	rr := httptest.NewRecorder()
+	mux.ServeHTTP(rr, req)
+	if rr.Code != http.StatusOK {
+		t.Errorf("ServeHTTP status = %d, want %d", rr.Code, http.StatusOK)
+	}
+}
+
+func TestMuxConfigurableHostCheck(t *testing.T) {
+	mux := safehttp.NewServeMux(safehttp.DefaultDispatcher{})
+	mux.Install(hostcheck.New("localhost"))
+	mux.Handle("/", safehttp.MethodGet, safehttp.HandlerFunc(func(w *safehttp.ResponseWriter, r *safehttp.IncomingRequest) safehttp.Result {
+		return w.Write(safehtml.HTMLEscaped("handled"))
+	}))
+
+	for _, tt := range []struct {
+		name       string
+		host       string
+		wantStatus safehttp.StatusCode
+	}{
+		{name: "configured local host is accepted", host: "localhost", wantStatus: safehttp.StatusOK},
+		{name: "unconfigured host is rejected", host: "other.test", wantStatus: safehttp.StatusNotFound},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			req := httptest.NewRequest(safehttp.MethodGet, "http://"+tt.host+"/", nil)
+			rr := httptest.NewRecorder()
+			mux.ServeHTTP(rr, req)
+			if got := rr.Code; got != int(tt.wantStatus) {
+				t.Errorf("ServeHTTP status = %d, want %d", got, tt.wantStatus)
+			}
+		})
+	}
+}
