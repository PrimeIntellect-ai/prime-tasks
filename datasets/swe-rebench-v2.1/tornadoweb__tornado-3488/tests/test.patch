+    def test_continuation(self):
+        # A header line beginning with SP or HTAB may either be rejected or
+        # folded into the previous header line (RFC 9112 section 5.2). Both
+        # behaviors satisfy the contract, so accept either one here.
+        data = "Foo: bar\r\n\tasdf"
+        try:
+            headers = HTTPHeaders.parse(data)
+        except HTTPInputError:
+            pass
+        else:
+            # The continuation was folded into the previous header line.
+            self.assertEqual(headers["Foo"].split(), ["bar", "asdf"])
+
         # If the first line starts with whitespace, it's a
         # continuation line with nothing to continue, so reject it
         # (with a proper error).
         data = " Foo: bar"
         self.assertRaises(HTTPInputError, HTTPHeaders.parse, data)
 
+        # Only SP and HTAB may begin a continuation line. Other bytes that
+        # str.isspace() considers whitespace must not be folded into the
+        # previous header line; they are ordinary (malformed) header lines.
+        for byte in [
+            "\x0b",  # VERTICAL TAB
+            "\x0c",  # FORM FEED
+            "\x0d",  # CARRIAGE RETURN
+            "\x1c",  # FILE SEPARATOR
+            "\x1d",  # GROUP SEPARATOR
+            "\x1e",  # RECORD SEPARATOR
+            "\x1f",  # UNIT SEPARATOR
+            "\x85",  # NEXT LINE
+            "\xa0",  # NO-BREAK SPACE
+        ]:
+            data = "Foo: bar\r\n" + byte + "asdf"
+            self.assertRaises(HTTPInputError, HTTPHeaders.parse, data)
