+    def test_upload_file_retains_explicit_src_last_modified_millis(self):
+        self._authorize_account()
+        self._create_my_bucket()
+
+        explicit_millis = '123456789'
+        with TempDir() as temp_dir:
+            local_file = self._make_local_file(temp_dir, 'explicit.txt')
+            stdout, stderr = self._get_stdouterr()
+            console_tool = ConsoleTool(self.b2_api, stdout, stderr)
+            status = console_tool.run_command([
+                'b2', 'upload_file', '--noProgress', '--quiet', '--info',
+                'src_last_modified_millis=' + explicit_millis,
+                'my-bucket', local_file, 'explicit.txt'
+            ])
+            self.assertEqual(0, status)
+
+            upload_result = json.loads(stdout.getvalue())
+            file_info_stdout, _ = self._get_stdouterr()
+            console_tool = ConsoleTool(self.b2_api, file_info_stdout, stderr)
+            status = console_tool.run_command(
+                ['b2', 'get_file_info', upload_result['fileId']]
+            )
+            self.assertEqual(0, status)
+            persisted_info = json.loads(file_info_stdout.getvalue())['fileInfo']
+            self.assertEqual(explicit_millis, persisted_info['src_last_modified_millis'])
+
     def test_get_download_auth_defaults(self):
         self._authorize_account()
