+import { convertRules } from "../../convertRules";
+import { converters } from "../../converters";
+import { mergers } from "../../mergers";
+
+describe("no-unused-expression conversion", () => {
+    test("converts the TSLint rule to its corresponding ESLint rule", () => {
+        const result = convertRules(
+            { converters, mergers },
+            { "no-unused-expression": { ruleArguments: [] } },
+        );
+
+        expect(result.missing).toEqual([]);
+        expect(result.failed).toEqual([]);
+        expect(result.converted.has("no-unused-expressions")).toBe(true);
+    });
+});
