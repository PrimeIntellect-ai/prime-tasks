+import os
+
+import pytest
+
+from planet.api.models import Body
+
+
+
+class _FakeResponse(object):
+    '''Minimal stand-in for a requests response used by Body.'''
+
+    def __init__(self, chunks, headers=None):
+        self._chunks = chunks
+        self.headers = headers or {}
+
+    def iter_content(self, chunk_size):
+        for chunk in self._chunks:
+            yield chunk
+
+
+def test_body_write_downloads_content(tmpdir):
+    '''Downloading a file writes the response body to the target path.'''
+    outfile = str(tmpdir.join('download'))
+
+    body = Body(None, _FakeResponse([b'bar'], {'content-length': '3'}), None)
+    body.write(outfile)
+
+    with open(outfile, 'rb') as fp:
+        assert fp.read() == b'bar'
+
+
+def test_body_write_is_atomic_on_error(tmpdir):
+    '''A failure while downloading must leave the target file untouched.'''
+    outfile = str(tmpdir.join('download'))
+    with open(outfile, 'w') as fp:
+        fp.write('original')
+
+    class FailingResponse(_FakeResponse):
+        def iter_content(self, chunk_size):
+            yield b'partial'
+            raise Exception('connection lost')
+
+    body = Body(None, FailingResponse([], {'content-length': '100'}), None)
+    try:
+        body.write(outfile)
+    except Exception:
+        pass
+
+    with open(outfile, 'r') as fp:
+        assert fp.read() == 'original'
+
+
+def test_body_write_does_not_expose_partial_download(tmpdir):
+    """Readers see the previous target contents until download completion."""
+    outfile = str(tmpdir.join('download'))
+    with open(outfile, 'wb') as fp:
+        fp.write(b'original')
+
+    class ObservingResponse(_FakeResponse):
+        def iter_content(self, chunk_size):
+            yield b'partial'
+            with open(outfile, 'rb') as fp:
+                assert fp.read() == b'original'
+            yield b' complete'
+
+    body = Body(None, ObservingResponse([], {'content-length': '16'}), None)
+    body.write(outfile)
+
+    with open(outfile, 'rb') as fp:
+        assert fp.read() == b'partial complete'
+
+
+def test_body_write_removes_new_destination_when_download_fails(tmpdir):
+    """A failed download must not leave a partial file at a new path."""
+    outfile = str(tmpdir.join('download'))
+
+    class FailingResponse(_FakeResponse):
+        def iter_content(self, chunk_size):
+            yield b'partial'
+            raise Exception('connection lost')
+
+    body = Body(None, FailingResponse([], {'content-length': '100'}), None)
+    with pytest.raises(Exception):
+        body.write(outfile)
+
+    assert not os.path.exists(outfile)
