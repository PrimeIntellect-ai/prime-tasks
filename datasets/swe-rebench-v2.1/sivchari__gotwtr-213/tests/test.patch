+func Test_graded_quoteTweetsEndpointContext(t *testing.T) {
+	t.Parallel()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	c := gotwtr.New("key", gotwtr.WithHTTPClient(&http.Client{Transport: gradedQuoteRoundTripper(func(request *http.Request) (*http.Response, error) {
+		if err := request.Context().Err(); err != nil {
+			return nil, err
+		}
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Body:       io.NopCloser(strings.NewReader(`{"data":[]}`)),
+		}, nil
+	})}))
+	if _, err := c.QuoteTweets(ctx, "1460323737035677698"); err == nil {
+		t.Error("client.QuoteTweets() error = nil, want non-nil for a cancelled context")
+	}
+}
