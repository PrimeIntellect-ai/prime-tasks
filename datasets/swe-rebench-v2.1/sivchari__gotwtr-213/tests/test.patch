+func Test_graded_quoteTweetsEndpointErrors(t *testing.T) {
+	t.Parallel()
+	t.Run("non-200 response returns HTTPError", func(t *testing.T) {
+		t.Parallel()
+		c := gotwtr.New("key", gotwtr.WithHTTPClient(mockHTTPClient(func(request *http.Request) *http.Response {
+			return &http.Response{
+				StatusCode: http.StatusNotFound,
+				Body:       io.NopCloser(strings.NewReader(`{"title":"Not Found Error","detail":"not found","type":"about:blank"}`)),
+			}
+		})))
+		_, err := c.QuoteTweets(context.Background(), "1460323737035677698")
+		if err == nil {
+			t.Fatal("client.QuoteTweets() error = nil, want non-nil")
+		}
+		var httpErr *gotwtr.HTTPError
+		if !errors.As(err, &httpErr) {
+			t.Errorf("client.QuoteTweets() error = %v, want *gotwtr.HTTPError", err)
+		}
+	})
+	t.Run("transport failure returns error", func(t *testing.T) {
+		t.Parallel()
+		c := gotwtr.New("key", gotwtr.WithHTTPClient(&http.Client{Transport: gradedQuoteRoundTripper(func(request *http.Request) (*http.Response, error) {
+			return nil, errors.New("transport failure")
+		})}))
+		if _, err := c.QuoteTweets(context.Background(), "1460323737035677698"); err == nil {
+			t.Error("client.QuoteTweets() error = nil, want non-nil")
+		}
+	})
+	t.Run("undecodable response returns error", func(t *testing.T) {
+		t.Parallel()
+		c := gotwtr.New("key", gotwtr.WithHTTPClient(mockHTTPClient(func(request *http.Request) *http.Response {
+			return &http.Response{
+				StatusCode: http.StatusOK,
+				Body:       io.NopCloser(strings.NewReader(`not-json`)),
+			}
+		})))
+		if _, err := c.QuoteTweets(context.Background(), "1460323737035677698"); err == nil {
+			t.Error("client.QuoteTweets() error = nil, want non-nil")
+		}
+	})
+}
+
+type gradedQuoteRoundTripper func(request *http.Request) (*http.Response, error)
+
+func (f gradedQuoteRoundTripper) RoundTrip(request *http.Request) (*http.Response, error) {
+	return f(request)
+}
