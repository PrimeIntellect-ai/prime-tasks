+func Test_graded_quoteTweetsEndpointPath(t *testing.T) {
+	t.Parallel()
+	var gotMethod, gotPath string
+	c := gotwtr.New("key", gotwtr.WithHTTPClient(mockHTTPClient(func(request *http.Request) *http.Response {
+		gotMethod = request.Method
+		gotPath = request.URL.Path
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Body:       io.NopCloser(strings.NewReader(`{"data":[]}`)),
+		}
+	})))
+	var tweets gotwtr.Tweets = c
+	if _, err := tweets.QuoteTweets(context.Background(), "1460323737035677698"); err != nil {
+		t.Fatalf("Tweets.QuoteTweets() error = %v", err)
+	}
+	if gotMethod != http.MethodGet {
+		t.Errorf("request method = %q, want %q", gotMethod, http.MethodGet)
+	}
+	if want := "/2/tweets/1460323737035677698/quote_tweets"; gotPath != want {
+		t.Errorf("request path = %q, want %q", gotPath, want)
+	}
