+func Test_graded_quoteTweetsEndpointWithOptions(t *testing.T) {
+	t.Parallel()
+	var gotQuery url.Values
+	c := gotwtr.New("key", gotwtr.WithHTTPClient(mockHTTPClient(func(request *http.Request) *http.Response {
+		gotQuery = request.URL.Query()
+		data := `{
+            "data": [
+                {
+                    "id": "1460323737035677698",
+                    "text": "Quoting this amazing tweet!"
+                }
+            ],
+            "meta": {
+                "result_count": 1
+            }
+        }`
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Body:       io.NopCloser(strings.NewReader(data)),
+		}
+	})))
+	_, err := c.QuoteTweets(context.Background(), "1460323737035677698", &gotwtr.QuoteTweetsOption{
+		Expansions:      []gotwtr.Expansion{gotwtr.ExpansionAuthorID},
+		MaxResults:      10,
+		PaginationToken: "next-page-token",
+		TweetFields:     []gotwtr.TweetField{gotwtr.TweetFieldCreatedAt},
+	})
+	if err != nil {
+		t.Fatalf("client.QuoteTweets() error = %v", err)
+	}
+	if got := gotQuery.Get("expansions"); got != "author_id" {
+		t.Errorf("expansions query = %q, want %q", got, "author_id")
+	}
+	if got := gotQuery.Get("max_results"); got != "10" {
+		t.Errorf("max_results query = %q, want %q", got, "10")
+	}
+	if got := gotQuery.Get("pagination_token"); got != "next-page-token" {
+		t.Errorf("pagination_token query = %q, want %q", got, "next-page-token")
+	}
+	if got := gotQuery.Get("tweet.fields"); got != "created_at" {
+		t.Errorf("tweet.fields query = %q, want %q", got, "created_at")
+	}
+}
