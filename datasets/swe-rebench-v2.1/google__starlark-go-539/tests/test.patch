+// TestDebugFrameBindingPositions verifies that the bindings reported by
+// DebugFrame.Local and Function.FreeVar carry the name and source position
+// of the binding identifier, and that a frame's parameters are enumerated
+// before its other local variables.
+func TestDebugFrameBindingPositions(t *testing.T) {
+	type frameBinding struct {
+		name     string
+		filename string
+		line     int32
+		col      int32
+		value    string
+	}
+	var locals, freevars []frameBinding
+	predeclared := starlark.StringDict{
+		"env": starlark.NewBuiltin("env", func(thread *starlark.Thread, b *starlark.Builtin, args starlark.Tuple, kwargs []starlark.Tuple) (starlark.Value, error) {
+			if thread.CallStackDepth() < 2 {
+				return nil, fmt.Errorf("env must not be called directly")
+			}
+			fr := thread.DebugFrame(1) // parent
+			fn, ok := fr.Callable().(*starlark.Function)
+			if !ok {
+				return nil, fmt.Errorf("env must be called from a Starlark function")
+			}
+			for i := 0; i < fr.NumLocals(); i++ {
+				bind, val := fr.Local(i)
+				locals = append(locals, frameBinding{bind.Name, bind.Pos.Filename(), bind.Pos.Line, bind.Pos.Col, fmt.Sprint(val)})
+			}
+			for i := 0; i < fn.NumFreeVars(); i++ {
+				bind, val := fn.FreeVar(i)
+				freevars = append(freevars, frameBinding{bind.Name, bind.Pos.Filename(), bind.Pos.Line, bind.Pos.Col, fmt.Sprint(val)})
+			}
+			return starlark.None, nil
+		}),
+	}
+	const src = `
+e = [None]
+
+def f(p):
+    outer = 3
+    def g(q):
+        inner = outer + 1
+        e[0] = env()
+        inner2 = None
+    g(2)
+
+f(1)
+`
+	thread := new(starlark.Thread)
+	if _, err := starlark.ExecFile(thread, "env.star", src, predeclared); err != nil {
+		t.Fatalf("ExecFile returned error %v", err)
+	}
+
+	// The parameter q is enumerated before the other local variables.
+	if len(locals) == 0 || locals[0].name != "q" {
+		t.Errorf("first local = %v, want parameter q", locals)
+	}
+
+	gotLocals := make(map[string]frameBinding)
+	for _, b := range locals {
+		gotLocals[b.name] = b
+	}
+	wantLocals := map[string]frameBinding{
+		"q":      {"q", "env.star", 6, 11, "2"},
+		"inner":  {"inner", "env.star", 7, 9, "4"},
+		"inner2": {"inner2", "env.star", 9, 9, "<nil>"},
+	}
+	if !reflect.DeepEqual(gotLocals, wantLocals) {
+		t.Errorf("locals = %v, want %v", gotLocals, wantLocals)
+	}
+
+	gotFreeVars := make(map[string]frameBinding)
+	for _, b := range freevars {
+		gotFreeVars[b.name] = b
+	}
+	wantFreeVars := map[string]frameBinding{
+		"outer": {"outer", "env.star", 5, 5, "3"},
+	}
+	if !reflect.DeepEqual(gotFreeVars, wantFreeVars) {
+		t.Errorf("free variables = %v, want %v", gotFreeVars, wantFreeVars)
+	}
+}
