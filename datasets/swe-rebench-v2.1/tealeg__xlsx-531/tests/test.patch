+	csRunO(c, "TestMakeXlsxSheetWithColStyle", func(qc *qt.C, option FileOption) {
+		file := NewFile(option)
+		sheet, _ := file.AddSheet("Sheet1")
+		row := sheet.AddRow()
+		cell := row.AddCell()
+		cell.Value = "A cell!"
+		cellK, err := sheet.Cell(0, 10)
+		qc.Assert(err, qt.IsNil)
+		cellK.SetString("K1")
+		cellL, err := sheet.Cell(0, 11)
+		qc.Assert(err, qt.IsNil)
+		cellL.SetString("L1")
+
+		colStyle := NewStyle()
+		colStyle.Fill.FgColor = "EEEEEE00"
+		colStyle.Fill.PatternType = "solid"
+		colStyle.ApplyFill = true
+		col := NewColForRange(10, 11)
+		col.SetStyle(colStyle)
+		sheet.Cols.Add(col)
+
+		var workbook bytes.Buffer
+		qc.Assert(file.Write(&workbook), qt.IsNil)
+		archive, err := zip.NewReader(bytes.NewReader(workbook.Bytes()), int64(workbook.Len()))
+		qc.Assert(err, qt.IsNil)
+
+		readPart := func(name string, target interface{}) {
+			var part *zip.File
+			for _, candidate := range archive.File {
+				if candidate.Name == name {
+					part = candidate
+					break
+				}
+			}
+			qc.Assert(part, qt.Not(qt.IsNil))
+			r, err := part.Open()
+			qc.Assert(err, qt.IsNil)
+			defer r.Close()
+			qc.Assert(xml.NewDecoder(r).Decode(target), qt.IsNil)
+		}
+
+		var worksheet struct {
+			Cols struct {
+				Col []struct {
+					Min   int  `xml:"min,attr"`
+					Max   int  `xml:"max,attr"`
+					Style *int `xml:"style,attr"`
+				} `xml:"col"`
+			} `xml:"cols"`
+			SheetData struct {
+				Row []struct {
+					Cells []struct {
+						Ref   string `xml:"r,attr"`
+						Style *int   `xml:"s,attr"`
+					} `xml:"c"`
+				} `xml:"row"`
+			} `xml:"sheetData"`
+		}
+		readPart("xl/worksheets/sheet1.xml", &worksheet)
+
+		var styles struct {
+			Fills struct {
+				Fill []struct {
+					PatternFill struct {
+						PatternType string `xml:"patternType,attr"`
+						FgColor     struct {
+							RGB string `xml:"rgb,attr"`
+						} `xml:"fgColor"`
+					} `xml:"patternFill"`
+				} `xml:"fill"`
+			} `xml:"fills"`
+			CellXfs struct {
+				Xf []struct {
+					FillID int `xml:"fillId,attr"`
+				} `xml:"xf"`
+			} `xml:"cellXfs"`
+		}
+		readPart("xl/styles.xml", &styles)
+
+		styleHasRequestedFill := func(styleIndex *int) bool {
+			if styleIndex == nil || *styleIndex < 0 || *styleIndex >= len(styles.CellXfs.Xf) {
+				return false
+			}
+			fillID := styles.CellXfs.Xf[*styleIndex].FillID
+			return fillID >= 0 && fillID < len(styles.Fills.Fill) &&
+				styles.Fills.Fill[fillID].PatternFill.PatternType == "solid" &&
+				styles.Fills.Fill[fillID].PatternFill.FgColor.RGB == "EEEEEE00"
+		}
+		for columnIndex, cellRef := range []string{"K1", "L1"} {
+			columnIndex += 10
+			var styleIndex *int
+			for _, savedCol := range worksheet.Cols.Col {
+				if savedCol.Min <= columnIndex && savedCol.Max >= columnIndex {
+					styleIndex = savedCol.Style
+					break
+				}
+			}
+			styleFound := styleHasRequestedFill(styleIndex)
+			if !styleFound {
+				for _, savedRow := range worksheet.SheetData.Row {
+					for _, savedCell := range savedRow.Cells {
+						if savedCell.Ref == cellRef && styleHasRequestedFill(savedCell.Style) {
+							styleFound = true
+						}
+					}
+				}
+			}
+			qc.Assert(styleFound, qt.Equals, true)
+		}
+	})
+
