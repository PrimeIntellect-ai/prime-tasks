+#[test]
+fn two_required_fields_first_missing() {
+    let a = long("a").argument::<u32>("A");
+    let b = long("b").argument::<u32>("B");
+    let parser = construct!(a, b).to_options();
+    let r = parser.run_inner(&["--b", "1"]).unwrap_err().unwrap_stderr();
+    // `--b` is a valid option, so the error must not claim it does not exist.
+    // The error must also identify the missing required option.
+    assert!(
+        !r.contains("no such flag"),
+        "valid `--b` must not be reported as nonexistent: {r}"
+    );
+    assert!(r.contains("--a"), "error should identify missing `--a`: {r}");
+}
