+    def test_goal_state_should_try_legacy_cypher_and_then_fail_when_no_cyphers_are_supported_by_the_wireserver(self):
+        cyphers = []
+        def http_get_handler(url, *_, **kwargs):
+            if HttpRequestPredicates.is_certificates_request(url):
+                cypher = kwargs["headers"].get("x-ms-cipher-name")
+                if cypher is None:
+                    raise Exception("x-ms-cipher-name header is missing from the Certificates request")
+                cyphers.append(cypher)
+                return MockHttpResponse(status=400, body="unsupported cypher: {0}".format(cypher).encode('utf-8'))
+            return None
+
+        with mock_wire_protocol(wire_protocol_data.DATA_FILE) as protocol:
+            protocol.set_http_handlers(http_get_handler=http_get_handler)
+            goal_state = GoalState(protocol.client)
+
+        self.assertIn("AES128_CBC", cyphers, "The goal state certificates should have been requested using AES128_CBC")
+        self.assertIn("DES_EDE3_CBC", cyphers, "The legacy cipher should have been attempted as a fallback")
+
+    def test_goal_state_should_use_aes128_to_fetch_certificates(self):
+        cyphers = []
+        def http_get_handler(url, *_, **kwargs):
+            if HttpRequestPredicates.is_certificates_request(url):
+                cyphers.append(kwargs["headers"].get("x-ms-cipher-name"))
+            return None
+
+        with mock_wire_protocol(wire_protocol_data.DATA_FILE) as protocol:
+            protocol.set_http_handlers(http_get_handler=http_get_handler)
+            GoalState(protocol.client)
+
+        self.assertIn("AES128_CBC", cyphers, "The goal state certificates should have been requested using AES128_CBC")
+
+    def test_certificates_summary_should_contain_thumbprint_and_has_private_key(self):
+        with mock_wire_protocol(wire_protocol_data.DATA_FILE_VM_SETTINGS) as protocol:
+            goal_state = GoalState(protocol.client)
+
+        self.assertEqual(
+            {
+                "F6ABAA61098A301EBB8A571C3C7CF77F355F7FA9": True,
+                "8979F1AC8C4215827BF3B5A403E6137B504D02A4": False,
+            },
+            {cert["thumbprint"]: cert["hasPrivateKey"] for cert in goal_state.certs.summary},
+            "Each certificate summary should accurately identify its thumbprint and private-key association",
+        )
+
+    def test_log_event_error_should_log_the_message_and_record_a_telemetry_event(self):
+        from azurelinuxagent.common.event import LogEvent
+
+        logger = MagicMock()
+        with patch("azurelinuxagent.common.event.add_event") as patch_add_event:
+            LogEvent(logger).error("GoalStateCertificates", "Error fetching the goal state certificates: {0}", "some error")
+
+        # The formatted message must be written to the underlying logger at error level
+        self.assertTrue(logger.error.called, "The message should have been logged at error level")
+        log_args = logger.error.call_args[0]
+        logged_message = log_args[0] if len(log_args) == 1 else log_args[0].format(*log_args[1:])
+        self.assertEqual("Error fetching the goal state certificates: some error", logged_message)
+
+        # A telemetry event must be recorded with is_success=False and log_event=False
+        self.assertTrue(patch_add_event.called, "A telemetry event should have been recorded")
+        event_args, event_kwargs = patch_add_event.call_args
+        op = event_kwargs.get("op", event_args[1] if len(event_args) > 1 else None)
+        message = event_kwargs.get("message", event_args[5] if len(event_args) > 5 else None)
+        is_success = event_kwargs.get("is_success", event_args[2] if len(event_args) > 2 else None)
+        log_event = event_kwargs.get("log_event", event_args[6] if len(event_args) > 6 else None)
+        self.assertEqual("GoalStateCertificates", op)
+        self.assertEqual("Error fetching the goal state certificates: some error", message)
+        self.assertFalse(is_success)
+        self.assertFalse(log_event)
 
