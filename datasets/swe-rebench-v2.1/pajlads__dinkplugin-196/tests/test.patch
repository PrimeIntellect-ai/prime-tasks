+    @Test
+    void testExtraDistinguishesAcquisitionCategories() {
+        NPC npc = mock(NPC.class);
+        when(npc.getName()).thenReturn(LOOTED_NAME);
+        plugin.onNpcLootReceived(new NpcLootReceived(npc, Collections.singletonList(new ItemStack(ItemID.RUBY, 1, null))));
+        plugin.onLootReceived(new LootReceived(LOOTED_NAME, 99, LootRecordType.PICKPOCKET, Collections.singletonList(new ItemStack(ItemID.RUBY, 1, null)), 1));
+        plugin.onLootReceived(new LootReceived(LOOTED_NAME, 99, LootRecordType.EVENT, Collections.singletonList(new ItemStack(ItemID.RUBY, 1, null)), 1));
+
+        ArgumentCaptor<NotificationBody> bodyCaptor = ArgumentCaptor.forClass(NotificationBody.class);
+        verify(messageHandler, org.mockito.Mockito.times(3)).createMessage(eq(PRIMARY_WEBHOOK_URL), eq(false), bodyCaptor.capture());
+        Gson gson = new Gson();
+        java.util.Set<String> serializedExtras = new java.util.HashSet<>();
+        for (NotificationBody body : bodyCaptor.getAllValues()) {
+            assertNotNull(body.getExtra());
+            serializedExtras.add(gson.toJson(body.getExtra()));
+        }
+        assertEquals(3, serializedExtras.size());
+    }
