diff --git a/tests/shared/src/test/scala/scala/meta/tests/parsers/dotty/InfixSuite.scala b/tests/shared/src/test/scala/scala/meta/tests/parsers/dotty/InfixSuite.scala
index ca10dabc3..ae6be986a 100644
--- a/tests/shared/src/test/scala/scala/meta/tests/parsers/dotty/InfixSuite.scala
+++ b/tests/shared/src/test/scala/scala/meta/tests/parsers/dotty/InfixSuite.scala
@@ -551,4 +551,69 @@ class InfixSuite extends BaseDottySuite {
     )
   }
 
+  test("#3051 scala3 leading infix syntax") {
+    runTestAssert[Stat](
+      """|val httpRoutes2 = (MetricsApp() ++ HomeApp() ++ GreetingApp())
+         |      @@ Middleware.cors(corsConfig)
+         |      @@ Middleware.metrics(MetricsApp.pathLabelMapper)
+         |      @@ Middleware.debug
+         |""".stripMargin,
+      assertLayout = None
+    )(
+      Defn.Val(
+        Nil,
+        List(Pat.Var(tname("httpRoutes2"))),
+        None,
+        Term.ApplyInfix(
+          Term.ApplyInfix(
+            Term.ApplyInfix(
+              Term.ApplyInfix(
+                Term.ApplyInfix(
+                  Term.Apply(tname("MetricsApp"), Nil),
+                  tname("++"),
+                  Nil,
+                  List(Term.Apply(tname("HomeApp"), Nil))
+                ),
+                tname("++"),
+                Nil,
+                List(Term.Apply(tname("GreetingApp"), Nil))
+              ),
+              tname("@@"),
+              Nil,
+              Term.Apply(
+                Term.Select(tname("Middleware"), tname("cors")),
+                List(tname("corsConfig"))
+              ) :: Nil
+            ),
+            tname("@@"),
+            Nil,
+            Term.Apply(
+              Term.Select(tname("Middleware"), tname("metrics")),
+              List(Term.Select(tname("MetricsApp"), tname("pathLabelMapper")))
+            ) :: Nil
+          ),
+          tname("@@"),
+          Nil,
+          List(Term.Select(tname("Middleware"), tname("debug")))
+        )
+      )
+    )
+  }
+
+  test("scala3 line-leading infix operator other than @@") {
+    runTestAssert[Stat](
+      """|val result = lhs
+         |  @> rhs
+         |""".stripMargin,
+      assertLayout = None
+    )(
+      Defn.Val(
+        Nil,
+        List(Pat.Var(tname("result"))),
+        None,
+        Term.ApplyInfix(tname("lhs"), tname("@>"), Nil, List(tname("rhs")))
+      )
+    )
+  }
+
 }
