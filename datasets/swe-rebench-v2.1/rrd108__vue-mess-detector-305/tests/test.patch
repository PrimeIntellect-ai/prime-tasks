+import type { SFCScriptBlock } from '@vue/compiler-sfc'
+import type { OverrideConfig } from '../../types/Override'
+import { parse } from '@vue/compiler-sfc'
+import { beforeEach, describe, expect, it } from 'vitest'
+import { checkRules } from '../../rulesCheck'
+import { reportRules } from '../../rulesReport'
+import { checkNoTsLang, reportNoTsLang, resetResults } from './noTsLang'
+
+describe('checkNoTsLang', () => {
+  beforeEach(() => {
+    resetResults()
+  })
+
+  it('should not report files with ts lang', () => {
+    const script = {
+      content: `
+        <script setup lang="ts">
+        import { ref } from 'vue'
+        import type { Product } from '@/types/product'
+
+        const products: Product[] = ref([{ name: 'Apple', price: 1 }, { name: 'Banana', price: 2 }])
+
+        // more content here...
+        </script>
+      `,
+      lang: 'ts',
+    } as SFCScriptBlock
+    const fileName = 'ts-lang.vue'
+    checkNoTsLang(script, fileName)
+    const result = reportNoTsLang()
+    expect(result.length).toBe(0)
+    expect(result).toStrictEqual([])
+  })
+
+  it('clears offenses recorded before reset', () => {
+    const script = { content: '<script setup>const count = 1</script>' } as SFCScriptBlock
+    checkNoTsLang(script, 'before-reset.vue')
+
+    resetResults()
+
+    expect(reportNoTsLang()).toStrictEqual([])
+  })
+
+  it('should report files where lang ts is not used', () => {
+    const script = {
+      content: `
+        <script setup>
+        import { ref } from 'vue'
+
+        const products = ref([{ name: 'Apple', price: 1 }, { name: 'Banana', price: 2 }])
+
+        // more content here...
+        </script>
+      `,
+    } as SFCScriptBlock
+    const fileName = 'no-ts-lang-problem.vue'
+    checkNoTsLang(script, fileName)
+    const result = reportNoTsLang()
+    expect(result.length).toBe(1)
+    expect(result).toStrictEqual([{
+      file: fileName,
+      rule: `<text_info>rrd ~ no ts lang</text_info>`,
+      description: `👉 <text_warn>Use typescript instead of javascript.</text_warn> See: https://vue-mess-detector.webmania.cc/rules/rrd/no-ts-lang.html`,
+      message: `<bg_warn>component uses js instead of ts</bg_warn> 🚨`,
+    }])
+  })
+})
+
+describe('noTsLang rule integration', () => {
+  const override = {} as OverrideConfig
+
+  const analyze = (source: string, filePath: string, apply: string[] = ['rrd']) => {
+    const { descriptor } = parse(source)
+    checkRules(descriptor, filePath, apply, override)
+    const { output } = reportRules('file', 'desc', 'warning', override)
+    return (output[filePath] ?? []).map(offense => offense.id)
+  }
+
+  it('reports the rule when analyzing a vue component whose script is not typescript', () => {
+    const source = `<script setup>
+const count = 1
+</script>
+<template><div>{{ count }}</div></template>`
+    const ids = analyze(source, 'component.vue')
+    expect(ids).toContain('<text_info>rrd ~ no ts lang</text_info>')
+  })
+
+  it('does not report the rule when another individual rule is selected', () => {
+    const source = `<script setup>
+const count = 1
+</script>`
+    const ids = analyze(source, 'filtered-component.vue', ['nestedTernary'])
+    expect(ids).not.toContain('<text_info>rrd ~ no ts lang</text_info>')
+  })
+
+  it('records the offense as a warning rather than an error', () => {
+    const { descriptor } = parse('<script setup>const count = 1</script>')
+    checkRules(descriptor, 'warning-only.vue', ['noTsLang'], override)
+
+    const { health, output } = reportRules('file', 'desc', 'error', override)
+    expect(health).toContainEqual({ file: 'warning-only.vue', errors: 0, warnings: 1, output: [] })
+    expect(output['warning-only.vue']).toEqual([])
+  })
+
+  it('does not report the rule when analyzing a vue component whose script is typescript', () => {
+    const source = `<script setup lang="ts">
+const count: number = 1
+</script>
+<template><div>{{ count }}</div></template>`
+    const ids = analyze(source, 'component-ts.vue')
+    expect(ids).not.toContain('<text_info>rrd ~ no ts lang</text_info>')
+  })
+})
