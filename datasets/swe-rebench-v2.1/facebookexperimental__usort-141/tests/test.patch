+    def test_splitting_and_merging_with_comments(self) -> None:
+        source = dedent(
+            """
+                import math, usort  # noqa
+                import black, math  # fun
+            """
+        )
+        result = usort(source.encode(), DEFAULT_CONFIG)
+        if result.error:
+            raise result.error
+        repeated_result = usort(result.output, DEFAULT_CONFIG)
+        if repeated_result.error:
+            raise repeated_result.error
+        self.assertEqual(result.output, repeated_result.output)
+
+        output = result.output.decode()
+        self.assertIn("import math  # noqa  # fun", output)
+        self.assertIn("import usort  # noqa", output)
+        self.assertRegex(output, r"(?m)^import black(?:  #.*)?$")
