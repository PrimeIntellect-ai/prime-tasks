+async def test_numeric_string_tool_argument_remains_a_string():
+    from fastmcp import FastMCP
+
+    mcp = FastMCP()
+
+    @mcp.tool()
+    def echo_type(value: str) -> str:
+        return type(value).__name__
+
+    result = await mcp.call_tool("echo_type", {"value": "123"})
+
+    assert result[0].text == "str"
+
