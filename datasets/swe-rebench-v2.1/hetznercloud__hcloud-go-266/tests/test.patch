diff --git a/hcloud/datacenter_test.go b/hcloud/datacenter_test.go
index a5ef7ad..27763a4 100644
--- a/hcloud/datacenter_test.go
+++ b/hcloud/datacenter_test.go
@@ -227,4 +227,54 @@ func TestDatacenterClient(t *testing.T) {
 			t.Errorf("unexpected datacenters")
 		}
 	})
+
+	t.Run("AllWithOpts", func(t *testing.T) {
+		env := newTestEnv()
+		defer env.Teardown()
+
+		env.Mux.HandleFunc("/datacenters", func(w http.ResponseWriter, r *http.Request) {
+			if name := r.URL.Query().Get("name"); name != "my-datacenter" {
+				t.Errorf("unexpected name: %s", name)
+			}
+			currentPage, nextPage := 1, 2
+			items := []schema.Datacenter{{ID: 1}, {ID: 2}, {ID: 3}}
+			if r.URL.Query().Get("page") == "2" {
+				currentPage, nextPage = 2, 0
+				items = []schema.Datacenter{{ID: 4}}
+			}
+			w.Header().Set("Content-Type", "application/json")
+			json.NewEncoder(w).Encode(struct {
+				Datacenters []schema.Datacenter `json:"datacenters"`
+				Meta        schema.Meta         `json:"meta"`
+			}{
+				Datacenters: items,
+				Meta: schema.Meta{
+					Pagination: &schema.MetaPagination{
+						Page:         currentPage,
+						NextPage:     nextPage,
+						LastPage:     2,
+						PerPage:      3,
+						TotalEntries: 4,
+					},
+				},
+			})
+		})
+
+		ctx := context.Background()
+		opts := DatacenterListOpts{Name: "my-datacenter"}
+		datacenters, err := env.Client.Datacenter.AllWithOpts(ctx, opts)
+		if err != nil {
+			t.Fatalf("Datacenter.List failed: %s", err)
+		}
+		if len(datacenters) != 4 {
+			t.Fatalf("expected 4 datacenters; got %d", len(datacenters))
+		}
+		ids := make(map[int]bool, len(datacenters))
+		for _, item := range datacenters {
+			ids[item.ID] = true
+		}
+		if !ids[1] || !ids[2] || !ids[3] || !ids[4] {
+			t.Errorf("missing expected datacenter IDs: %v", ids)
+		}
+	})
 }
