@@ -50,4 +54,53 @@ class KdocFormattingFixTest : FixTestBase("test/paragraph2/kdoc/", ::KdocFormatt
     fun `KdocFormatting - all warnings`() {
         fixAndCompare("KdocFormattingFullExpected.kt", "KdocFormattingFullTest.kt")
     }
+
+    @Test
+    @Tag(WarningNames.KDOC_WRONG_TAGS_ORDER)
+    fun `basic tags are ordered without changing their occurrences or content`() {
+        val source = javaClass.classLoader
+            .getResource("test/paragraph2/kdoc/KdocFormattingOrderTest.kt")!!
+            .openStream().bufferedReader().use { it.readText() }
+        val actual = format(
+            { rulesConfigList -> DiktatRuleSetProvider4Test(::KdocFormatting, rulesConfigList) },
+            source,
+            "KdocFormattingOrderTest.kt"
+        )
+        val originalTags = basicTagBlocks(source)
+        val formattedTags = basicTagBlocks(actual)
+
+        // every existing tag must still be present with its full content (including continuation lines);
+        // adding missing tags is allowed
+        val available = formattedTags.groupingBy { it }.eachCount().toMutableMap()
+        originalTags.forEach { tag ->
+            val count = available[tag] ?: 0
+            assertTrue(count > 0, "Tag was lost or changed by autofix: $tag")
+            available[tag] = count - 1
+        }
+
+        val categoryOrder = listOf("param", "return", "throws")
+        val formattedCategories = formattedTags.map { categoryOrder.indexOf(tagName(it)) }
+        assertEquals(formattedCategories.sorted(), formattedCategories)
+    }
+
+    /**
+     * Returns the basic tags (`@param`, `@return`, `@throws`) of the first KDoc in [text],
+     * each with its continuation lines joined into a single whitespace-normalized string.
+     */
+    private fun basicTagBlocks(text: String): List<String> {
+        val kdoc = Regex("""/\*\*[\s\S]*?\*/""").find(text)?.value ?: return emptyList()
+        val blocks = mutableListOf<MutableList<String>>()
+        kdoc.lines().forEach { line ->
+            val content = line.trim().removePrefix("/**").removeSuffix("*/").removePrefix("*").trim()
+            when {
+                content.startsWith("@") -> blocks.add(mutableListOf(content))
+                content.isNotEmpty() && blocks.isNotEmpty() -> blocks.last().add(content)
+            }
+        }
+        return blocks
+            .map { it.joinToString(" ").replace(Regex("\\s+"), " ") }
+            .filter { tagName(it) in listOf("param", "return", "throws") }
+    }
+
+    private fun tagName(tagText: String): String = tagText.substringAfter('@').substringBefore(' ')
 }
