+    def test_header_callback_to_parse_line(self):
+        # Make a request with header_callback and feed the headers to HTTPHeaders.parse_line.
+        # (Instead of HTTPHeaders.parse which is used in normal cases). Ensure that the resulting
+        # headers are as expected, and in particular do not have trailing whitespace added
+        # due to the final CRLF line.
+        headers = HTTPHeaders()
+
+        def header_callback(line):
+            if line.startswith("HTTP/"):
+                # Ignore the first status line
+                return
+            headers.parse_line(line)
+
+        self.fetch("/hello", header_callback=header_callback)
+        for k, v in headers.get_all():
+            self.assertTrue(v == v.strip(), (k, v))
+
+    def test_content_length_zero_with_trailing_whitespace(self):
+        # Trailing optional whitespace after a header value is not part of the
+        # value (RFC 9112 section 5.5), so "Content-Length: 0 " must be accepted
+        # as a zero-length body even when it is the last header of the response.
+        sock, port = bind_unused_port()
+        with closing(sock):
+
+            @gen.coroutine
+            def accept_callback(conn, address):
+                stream = IOStream(conn)
+                request_data = yield stream.read_until(b"\r\n\r\n")
+                if b"HTTP/1." not in request_data:
+                    self.skipTest("requires HTTP/1.x")
+                yield stream.write(
+                    b"HTTP/1.1 200 OK\r\nContent-Length: 0 \r\n\r\n"
+                )
+                stream.close()
+
+            netutil.add_accept_handler(sock, accept_callback)  # type: ignore
+            try:
+                resp = self.fetch("http://127.0.0.1:%d/" % port)
+                resp.rethrow()
+                self.assertEqual(resp.code, 200)
+                self.assertEqual(resp.body, b"")
+            finally:
+                self.io_loop.remove_handler(sock.fileno())
+
+    def test_content_length_zero_header_callback_to_parse_line(self):
+        # A zero Content-Length that is the last header of a response must
+        # come through the header callback unchanged, so that feeding the
+        # callback lines to HTTPHeaders.parse_line yields exactly "0".
+        sock, port = bind_unused_port()
+        with closing(sock):
+
+            @gen.coroutine
+            def accept_callback(conn, address):
+                stream = IOStream(conn)
+                request_data = yield stream.read_until(b"\r\n\r\n")
+                if b"HTTP/1." not in request_data:
+                    self.skipTest("requires HTTP/1.x")
+                yield stream.write(b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n")
+                stream.close()
+
+            netutil.add_accept_handler(sock, accept_callback)  # type: ignore
+            headers = HTTPHeaders()
+
+            def header_callback(line):
+                if line.startswith("HTTP/"):
+                    return
+                headers.parse_line(line)
+
+            try:
+                resp = self.fetch(
+                    "http://127.0.0.1:%d/" % port, header_callback=header_callback
+                )
+                resp.rethrow()
+                self.assertEqual(resp.body, b"")
+                self.assertEqual(headers["Content-Length"], "0")
+            finally:
+                self.io_loop.remove_handler(sock.fileno())
