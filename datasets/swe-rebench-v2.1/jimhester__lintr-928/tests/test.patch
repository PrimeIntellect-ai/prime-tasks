diff --git a/tests/testthat/test-assignment_linter.R b/tests/testthat/test-assignment_linter.R
index e5d4fcc..10c36d1 100644
--- a/tests/testthat/test-assignment_linter.R
+++ b/tests/testthat/test-assignment_linter.R
@@ -1,6 +1,6 @@
 test_that("returns the correct linting", {
   linter <- assignment_linter()
-  msg <- rex("Use <-, not =, for assignment.")
+  msg <- rex::rex("Use <-, not =, for assignment.")
 
   expect_lint("blah", NULL, linter)
   expect_lint("blah <- 1", NULL, linter)
@@ -21,3 +21,27 @@ test_that("returns the correct linting", {
     linter
   )
 })
+
+test_that("rightward assignment is linted", {
+  expect_lint("1 -> blah", list(line_number = 1L), assignment_linter())
+})
+
+test_that("cascading assignments can be configured", {
+  expect_lint("x <<- 1", NULL, assignment_linter())
+  expect_lint("1 ->> x", list(line_number = 1L), assignment_linter())
+
+  no_cascading <- assignment_linter(allow_cascading_assign = FALSE)
+  expect_lint("x <<- 1", list(line_number = 1L), no_cascading)
+  expect_lint("1 ->> x", list(line_number = 1L), no_cascading)
+
+  right_assign_allowed <- assignment_linter(allow_right_assign = TRUE)
+  expect_lint("1 -> blah", NULL, right_assign_allowed)
+  expect_lint("1 ->> x", NULL, right_assign_allowed)
+
+  no_cascading_rightward <- assignment_linter(
+    allow_cascading_assign = FALSE,
+    allow_right_assign = TRUE
+  )
+  expect_lint("x <<- 1", list(line_number = 1L), no_cascading_rightward)
+  expect_lint("1 ->> x", list(line_number = 1L), no_cascading_rightward)
+})
