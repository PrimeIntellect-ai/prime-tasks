+experiment('prettyPrint with multiple servers', () => {
+  test('produces pretty logs for each server registered with the same options', async () => {
+    const output = []
+    const stream = new Writable({
+      write (chunk, enc, cb) {
+        output.push(chunk.toString())
+        cb()
+      }
+    })
+
+    const options = {
+      prettyPrint: true,
+      stream
+    }
+
+    const server1 = getServer()
+    const server2 = getServer()
+
+    await server1.register({ plugin: Pino, options })
+    await server2.register({ plugin: Pino, options })
+
+    server1.logger().info('hello from server one')
+    server2.logger().info('hello from server two')
+
+    await sleep(50)
+
+    const text = output.join('')
+    expect(text).to.contain('hello from server one')
+    expect(text).to.contain('hello from server two')
+
+    const jsonLines = text.split('\n').filter((line) => {
+      try {
+        return typeof JSON.parse(line) === 'object'
+      } catch (err) {
+        return false
+      }
+    })
+    expect(jsonLines).to.have.length(0)
+  })
+})
