+  @Test
+  public void testGetArrayOfStructsFromResultSet() throws SQLException {
+    Type structType = Type.struct(StructField.of("point", Type.array(Type.int64())));
+    Struct struct1 =
+        Struct.newBuilder().set("point").to(Value.int64Array(new long[] {1L, 5L})).build();
+    Struct struct2 =
+        Struct.newBuilder().set("point").to(Value.int64Array(new long[] {2L, 8L})).build();
+    com.google.cloud.spanner.ResultSet spannerResultSet =
+        ResultSets.forRows(
+            Type.struct(StructField.of("coordinates", Type.array(structType))),
+            Arrays.asList(
+                Struct.newBuilder()
+                    .set("coordinates")
+                    .toStructArray(structType, Arrays.asList(struct1, struct2))
+                    .build()));
+    try (JdbcResultSet jdbcResultSet = JdbcResultSet.of(mock(Statement.class), spannerResultSet)) {
+      assertTrue(jdbcResultSet.next());
+      Array array = jdbcResultSet.getArray(1);
+      assertThat((Struct[]) array.getArray()).asList().containsExactly(struct1, struct2);
     }
   }
 
