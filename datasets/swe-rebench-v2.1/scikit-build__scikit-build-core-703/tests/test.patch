+def test_metadata_build_without_external_pyproject_metadata(tmp_path: Path) -> None:
+    source = Path(__file__).parents[1] / "src"
+    (tmp_path / "pyproject.toml").write_text(
+        """
+        [project]
+        name = "no-external-metadata"
+        version = "1.0"
+
+        [tool.scikit-build]
+        wheel.cmake = false
+        """
+    )
+    script = f"""
+import sys
+sys.path.insert(0, {str(source)!r})
+
+class BlockExternalMetadata:
+    def find_spec(self, fullname, path=None, target=None):
+        if fullname == "pyproject_metadata":
+            raise ModuleNotFoundError("external pyproject_metadata is unavailable")
+
+sys.meta_path.insert(0, BlockExternalMetadata())
+from scikit_build_core.build import prepare_metadata_for_build_wheel
+prepare_metadata_for_build_wheel("metadata", {{"wheel.cmake": "false"}})
+"""
+    subprocess.run(
+        [sys.executable, "-c", script],
+        cwd=tmp_path,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+
+    metadata = (
+        tmp_path
+        / "metadata"
+        / "no_external_metadata-1.0.dist-info"
+        / "METADATA"
+    ).read_text()
+    assert "Name: no-external-metadata\n" in metadata
+    assert "Version: 1.0\n" in metadata
+
+
 def test_regex(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
     d = tmp_path / "test_regex"
     d.mkdir()
