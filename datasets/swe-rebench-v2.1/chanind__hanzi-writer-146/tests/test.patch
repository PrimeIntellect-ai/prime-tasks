+  describe('highlightStroke', () => {
+    it('visually highlights the requested stroke using the configured highlight color', async () => {
+      document.body.innerHTML = '<div id="target"></div>';
+      const writer = new HanziWriter('target', '人', {
+        showCharacter: true,
+        highlightColor: '#123456',
+        charDataLoader,
+      });
+      await writer._withDataPromise;
+
+      let isResolved = false;
+      writer.highlightStroke(1, {}).then(() => { isResolved = true; });
+      await resolvePromises();
+
+      const svg = document.querySelector('#target svg');
+      const highlightPaths = () => Array.from(svg.querySelectorAll('path'))
+        .filter(path => path.getAttribute('stroke') === 'rgba(18,52,86,1)');
+
+      // the configured highlight color is used to render the highlight
+      expect(highlightPaths().length).toBeGreaterThan(0);
+
+      // the highlighted stroke becomes visible at some point during the animation
+      let maxOpacity = 0;
+      for (let i = 0; i < 1000 && !isResolved; i++) {
+        clock.tick(20);
+        await resolvePromises();
+        highlightPaths().forEach(path => {
+          maxOpacity = Math.max(maxOpacity, parseFloat(path.style.opacity) || 0);
+        });
+      }
+      expect(isResolved).toBe(true);
+      expect(maxOpacity).toBeGreaterThan(0);
+
+      // and then fades back out
+      const finalOpacity = Math.max(
+        ...highlightPaths().map(path => parseFloat(path.style.opacity) || 0)
+      );
+      expect(finalOpacity).toBe(0);
+    });
+
+    it('resolves with canceled: false and calls onComplete when the highlight completes', async () => {
+      document.body.innerHTML = '<div id="target"></div>';
+      const writer = new HanziWriter('target', '人', { showCharacter: true, charDataLoader });
+      await writer._withDataPromise;
+
+      let isResolved = false;
+      let resolvedVal;
+      const onComplete = jest.fn();
+
+      writer.highlightStroke(1, { onComplete }).then(result => {
+        isResolved = true;
+        resolvedVal = result;
+      });
+
+      await resolvePromises();
+
+      expect(isResolved).toBe(false);
+      expect(onComplete).not.toHaveBeenCalled();
+
+      for (let i = 0; i < 1000 && !isResolved; i++) {
+        clock.tick(20);
+        await resolvePromises();
+      }
+
+      expect(isResolved).toBe(true);
+      expect(resolvedVal).toEqual({ canceled: false });
+      expect(onComplete).toHaveBeenCalledTimes(1);
+      expect(onComplete).toHaveBeenCalledWith({ canceled: false });
+    });
+
+    it('resolves with canceled: true and calls onComplete when the highlight is canceled', async () => {
+      document.body.innerHTML = '<div id="target"></div>';
+      const writer = new HanziWriter('target', '人', { showCharacter: true, charDataLoader });
+      await writer._withDataPromise;
+
+      let isResolved = false;
+      let resolvedVal;
+      const onComplete = jest.fn();
+
+      writer.highlightStroke(1, { onComplete }).then(result => {
+        isResolved = true;
+        resolvedVal = result;
+      });
+
+      await resolvePromises();
+
+      expect(isResolved).toBe(false);
+
+      // resetting the writer cancels the in-progress highlight
+      writer.setCharacter('一');
+      await resolvePromises();
+
+      expect(isResolved).toBe(true);
+      expect(resolvedVal).toEqual({ canceled: true });
+      expect(onComplete).toHaveBeenCalledTimes(1);
+      expect(onComplete).toHaveBeenCalledWith({ canceled: true });
+    });
+  });
+
