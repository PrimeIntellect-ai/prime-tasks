+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestPushFileCompletion(t *testing.T) {
+	checkFileCompletion(t, "push", true)
+	checkFileCompletion(t, "push package.tgz", false)
+}
+
+func TestChartOCICompletion(t *testing.T) {
+	_, out, err := executeActionCommandC(storageFixture(), "__complete pull ''")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if !strings.Contains(out, "oci://") {
+		t.Errorf("expected OCI chart location prefix among completions, got %q", out)
+	}
+}
