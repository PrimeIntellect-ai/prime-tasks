+func TestRepositoriesService_Create_deleteBranchOnMerge(t *testing.T) {
+	client, mux, _, teardown := setup()
+	defer teardown()
+
+	var input Repository
+	if err := json.Unmarshal([]byte(`{"name":"n","delete_branch_on_merge":true}`), &input); err != nil {
+		t.Fatalf("Repository.Unmarshal returned error: %v", err)
+	}
+
+	expectedSettings := []bool{true, false}
+	requestIndex := 0
+	mux.HandleFunc("/user/repos", func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]interface{}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Fatalf("Decode returned error: %v", err)
+		}
+		if requestIndex >= len(expectedSettings) {
+			t.Errorf("unexpected repository creation request %d", requestIndex+1)
+		} else if got, ok := body["delete_branch_on_merge"]; !ok || got != expectedSettings[requestIndex] {
+			t.Errorf("Request body delete_branch_on_merge = %v, want %t", got, expectedSettings[requestIndex])
+		}
+		requestIndex++
+		fmt.Fprint(w, `{"id":1}`)
+	})
+
+	for _, enabled := range expectedSettings {
+		input.DeleteBranchOnMerge = Bool(enabled)
+		if _, _, err := client.Repositories.Create(context.Background(), "", &input); err != nil {
+			t.Errorf("Repositories.Create returned error for setting %t: %v", enabled, err)
+		}
+	}
+}
