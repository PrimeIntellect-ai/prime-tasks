+func TestRepository_DeleteBranchOnMerge(t *testing.T) {
+	var repo Repository
+	if err := json.Unmarshal([]byte(`{"name":"n","delete_branch_on_merge":true}`), &repo); err != nil {
+		t.Fatalf("Repository.Unmarshal returned error: %v", err)
+	}
+	if repo.DeleteBranchOnMerge == nil || !*repo.DeleteBranchOnMerge {
+		t.Errorf("Repository.DeleteBranchOnMerge = %v, want a non-nil pointer to true", repo.DeleteBranchOnMerge)
+	}
+
+	got, err := json.Marshal(&repo)
+	if err != nil {
+		t.Fatalf("Repository.Marshal returned error: %v", err)
+	}
+	if !strings.Contains(string(got), `"delete_branch_on_merge":true`) {
+		t.Errorf("Repository JSON = %s, want it to contain %q", got, `"delete_branch_on_merge":true`)
+	}
+
+	if s := repo.String(); !strings.Contains(s, "DeleteBranchOnMerge:true") {
+		t.Errorf("Repository.String = %s, want it to contain %q", s, "DeleteBranchOnMerge:true")
+	}
+
+	repo.DeleteBranchOnMerge = Bool(false)
+	got, err = json.Marshal(&repo)
+	if err != nil {
+		t.Fatalf("Repository.Marshal with false setting returned error: %v", err)
+	}
+	if !strings.Contains(string(got), `"delete_branch_on_merge":false`) {
+		t.Errorf("Repository JSON = %s, want it to contain %q", got, `"delete_branch_on_merge":false`)
+	}
+}
