+  test("issue-2877: sbt using same version in a val and a literal using a Seq addition") {
+    val update = ("org.scalatest".g % Nel.of(
+      "scalatest".a,
+      "scalactic".a
+    ) % "3.2.13" %> "3.2.14").group
+    val original = Map(
+      "build.sbt" ->
+        """
+          |val ScalaTestVersion = "3.2.13"
+          |libraryDependencies ++= Seq(
+          |  "org.scalatest" %% "scalatest" % ScalaTestVersion,
+          |  "org.scalatest" %% "scalactic" % "3.2.13"
+          |)
+          |""".stripMargin
+    )
+    val updated = applyUpdate(update, original)("build.sbt")
+    val updatedDependencies =
+      """(?m)^\s*"org\.scalatest"\s*%%\s*"(scalatest|scalactic)"\s*%\s*("3\.2\.14"|[A-Za-z_]\w*)\s*,?\s*$""".r
+    val dependencies = updatedDependencies.findAllMatchIn(updated).map(m => m.group(1) -> m.group(2)).toMap
+    assertEquals(dependencies.keySet, Set("scalatest", "scalactic"))
+    dependencies.values.foreach { version =>
+      if (version != "\"3.2.14\"") {
+        val versionDeclaration =
+          ("(?s)\\bval\\s+" + java.util.regex.Pattern.quote(version) + "\\s*=\\s*\"3\\.2\\.14\"").r
+        assert(versionDeclaration.findFirstIn(updated).nonEmpty)
+      }
+    }
+  }
+
