+extern crate ron;
+#[macro_use]
+extern crate serde;
+
+use std::collections::HashMap;
+
+#[derive(Serialize)]
+struct Config {
+    float: (f32, f64),
+    tuple: TupleStruct,
+    map: HashMap<u8, char>,
+    nested: Nested,
+    var: Variant,
+    array: Vec<()>,
+}
+
+#[derive(Serialize)]
+struct TupleStruct((), bool);
+
+#[derive(Serialize)]
+enum Variant {
+    A(u8, &'static str),
+}
+
+#[derive(Serialize)]
+struct Nested {
+    a: String,
+    b: char,
+}
+
+fn compact_whitespace(value: &str) -> String {
+    value.chars().filter(|character| !character.is_whitespace()).collect()
+}
+
+const EXPECTED: &str = "(
+    float: (2.18,-1.1,),
+    tuple: ((),false,),
+    map: {8:'1',},
+    nested: (a:\"a\",b:'b',),
+    var: A(255,\"\",),
+    array: [(),(),(),],
+)";
+
+#[test]
+fn depth_limit() {
+    let data = Config {
+        float: (2.18, -1.1),
+        tuple: TupleStruct((), false),
+        map: vec![(8, '1')].into_iter().collect(),
+        nested: Nested {
+            a: "a".to_owned(),
+            b: 'b',
+        },
+        var: Variant::A(!0, ""),
+        array: vec![(); 3],
+    };
+
+    let pretty = ron::ser::PrettyConfig {
+        depth_limit: 2,
+        separate_tuple_members: true,
+        enumerate_arrays: true,
+        .. Default::default()
+    };
+    let s = ron::ser::to_string_pretty(&data, pretty);
+
+    let s = s.unwrap();
+    assert_eq!(compact_whitespace(&s), compact_whitespace(EXPECTED));
+    assert_eq!(s.lines().count(), EXPECTED.lines().count());
+}
+
+
+const EXPECTED_WITHIN_LIMIT: &str = "(
+    float: (
+        2.18,
+        -1.1,
+    ),
+    tuple: (
+        (),
+        false,
+    ),
+    map: {
+        8: '1',
+    },
+    nested: (
+        a: \"a\",
+        b: 'b',
+    ),
+    var: A(
+        255,
+        \"\",
+    ),
+    array: [
+        (),// [0]
+        (),// [1]
+        (),// [2]
+    ],
+)";
+
+#[test]
+fn depth_limit_within_limit() {
+    let data = Config {
+        float: (2.18, -1.1),
+        tuple: TupleStruct((), false),
+        map: vec![(8, '1')].into_iter().collect(),
+        nested: Nested {
+            a: "a".to_owned(),
+            b: 'b',
+        },
+        var: Variant::A(!0, ""),
+        array: vec![(); 3],
+    };
+
+    let pretty = ron::ser::PrettyConfig {
+        depth_limit: 3,
+        separate_tuple_members: true,
+        enumerate_arrays: true,
+        .. Default::default()
+    };
+    let s = ron::ser::to_string_pretty(&data, pretty);
+
+    let s = s.unwrap();
+    assert_eq!(compact_whitespace(&s), compact_whitespace(EXPECTED_WITHIN_LIMIT));
+    assert_eq!(s.lines().count(), EXPECTED_WITHIN_LIMIT.lines().count());
+}
