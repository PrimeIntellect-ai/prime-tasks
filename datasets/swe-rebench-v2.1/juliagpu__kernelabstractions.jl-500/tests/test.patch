+@testset "CPU default workgroupsize distributes multidimensional launches" begin
+    A = Array{CartesianIndex{3}}(undef, 64, 64, 64)
+    index_cartesian_local(CPU())(A, ndrange=(64, 64, 64))
+    synchronize(CPU())
+
+    # Local coordinates reveal how many iterations a workgroup covers on
+    # each axis, without requiring a particular workgroup shape.
+    local_axis_sizes = ntuple(d -> length(unique(index[d] for index in A)), 3)
+    @test count(n -> n > 1, local_axis_sizes) >= 2
+end
 end
