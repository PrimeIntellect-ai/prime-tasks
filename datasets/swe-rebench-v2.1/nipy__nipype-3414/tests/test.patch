+def test_import_without_workflow_defaults():
+    script = r"""
+import sys
+import types
+
+# Provide the small part of DIPY's workflow API used while the interface
+# package is imported. One discovered workflow has no optional arguments.
+dipy = types.ModuleType("dipy")
+dipy.__path__ = []
+dipy.__version__ = "1.0"
+workflows = types.ModuleType("dipy.workflows")
+workflows.__path__ = []
+workflow_base = types.ModuleType("dipy.workflows.base")
+
+class Workflow:
+    pass
+
+class IntrospectiveArgumentParser:
+    def add_workflow(self, flow):
+        self.positional_parameters = []
+        self.optional_parameters = []
+        self.output_parameters = []
+
+workflow_base.IntrospectiveArgumentParser = IntrospectiveArgumentParser
+workflows.Workflow = Workflow
+sys.modules["dipy"] = dipy
+sys.modules["dipy.workflows"] = workflows
+sys.modules["dipy.workflows.base"] = workflow_base
+
+def register_workflow_module(name):
+    module = types.ModuleType("dipy.workflows." + name)
+    module.Workflow = Workflow
+    if name == "denoise":
+        class NoDefaultsFlow(Workflow):
+            def run(self):
+                return None
+        module.NoDefaultsFlow = NoDefaultsFlow
+    setattr(workflows, name, module)
+    sys.modules[module.__name__] = module
+
+for name in ("denoise", "mask", "reconst", "segment", "tracking"):
+    register_workflow_module(name)
+
+import nipype.interfaces.dipy
+"""
+    result = subprocess.run(
+        [sys.executable, "-c", script], capture_output=True, text=True
+    )
+    assert result.returncode == 0, result.stderr
+
+
 @pytest.mark.skipif(no_dipy(), reason="DIPY is not installed")
 def test_dipy_to_nipype_interface():
     from dipy.workflows.workflow import Workflow
