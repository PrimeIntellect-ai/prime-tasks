+
+    def test_parse_json(self) -> None:
+        """Parse a valid JSON inventory file to create an ANTA inventory."""
+        inventory = AntaInventory.parse(
+            filename=FILE_DIR / "test_inventory_with_tags.json",
+            username="arista",
+            password="arista123",
+            file_format="json",
+        )
+        assert set(inventory) == {"leaf1", "leaf2", "spine1"}
+
+    def test_parse_json_uses_json_parser(self, tmp_path: Path) -> None:
+        """Ensure file_format='json' actually parses the file as JSON.
+
+        The file below is valid JSON (tab-indented) but is not valid YAML, so an
+        implementation that ignores file_format and always parses YAML would fail.
+        """
+        json_file = tmp_path / "inventory.json"
+        json_file.write_text(
+            '{\n\t"anta_inventory": {\n\t\t"hosts": [\n\t\t\t{"name": "leaf1", "host": "1.1.1.1"}\n\t\t]\n\t}\n}\n',
+            encoding="UTF-8",
+        )
+        inventory = AntaInventory.parse(filename=json_file, username="arista", password="arista123", file_format="json")
+        assert set(inventory) == {"leaf1"}
