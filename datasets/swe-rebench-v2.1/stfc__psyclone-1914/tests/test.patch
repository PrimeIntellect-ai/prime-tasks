+def test_subroutine_implicit_args(fortran_reader, fortran_writer):
+    """Check that an implicitly-declared subroutine argument is not
+    silently lost.
+
+    """
+    code = '''
+module my_mod
+contains
+subroutine my_sub(iarg)
+  write(*,*) iarg
+end subroutine my_sub
+end module my_mod
+'''
+    try:
+        psyir = fortran_reader.psyir_from_source(code)
+    except Exception:
+        # An implementation may reject the code rather than silently
+        # losing the argument.
+        return
+    # Otherwise the argument must have been retained.
+    assert "my_sub(iarg)" in fortran_writer(psyir)
+
+
+def test_subroutine_some_implicit_args(fortran_reader, fortran_writer):
+    """Check that a subroutine which has declarations but has omitted to
+    declare one of its arguments does not silently lose that argument.
+
+    """
+    code = '''
+subroutine sub1(var, idx)
+    real, intent(in) :: var
+end subroutine'''
+    try:
+        psyir = fortran_reader.psyir_from_source(code)
+    except Exception:
+        # An implementation may reject the code rather than silently
+        # losing the argument.
+        return
+    # Otherwise the argument must have been retained.
+    assert "sub1(var, idx)" in fortran_writer(psyir)
+
