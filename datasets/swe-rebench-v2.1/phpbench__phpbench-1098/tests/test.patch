+    public function testTemplateExtendsPhpDocDoesNotPreventBenchmarkMetadataLoading(): void
+    {
+        $reflection = new ReflectionClass();
+        $reflection->path = 'foo';
+        $reflection->class = \stdClass::class;
+        $reflection->comment = <<<'EOT'
+/**
+ * @template-extends AbstractStorageAdapterBenchmark<RedisClusterOptions>
+ */
+EOT;
+
+        $method = new ReflectionMethod();
+        $method->reflectionClass = $reflection;
+        $method->class = \stdClass::class;
+        $method->name = 'benchRedisCluster';
+        $reflection->methods[$method->name] = $method;
+
+        $hierarchy = new ReflectionHierarchy();
+        $hierarchy->addReflectionClass($reflection);
+        $metadata = $this->createDriver()->getMetadataForHierarchy($hierarchy);
+
+        $this->assertArrayHasKey('benchRedisCluster', $metadata->getSubjects());
+    }
+
+    public function testClassAttributesRemainEffectiveWithGenericPhpDoc(): void
+    {
+        $reflection = new ReflectionClass();
+        $reflection->path = 'foo';
+        $reflection->class = \stdClass::class;
+        $reflection->comment = "/**\n * @template TOptions\n */";
+        $reflection->attributes = [new Revs(12)];
+
+        $method = new ReflectionMethod();
+        $method->reflectionClass = $reflection;
+        $method->class = \stdClass::class;
+        $method->name = 'benchGeneric';
+        $reflection->methods[$method->name] = $method;
+
+        $hierarchy = new ReflectionHierarchy();
+        $hierarchy->addReflectionClass($reflection);
+        $metadata = (new AttributeDriver())->getMetadataForHierarchy($hierarchy);
+
+        $this->assertSame([12], $metadata->getSubjects()['benchGeneric']->getRevs());
+    }
