diff --git a/test/serializer_test.exs b/test/serializer_test.exs
index 165e5fe..fde7f89 100644
--- a/test/serializer_test.exs
+++ b/test/serializer_test.exs
@@ -88,6 +88,40 @@ defmodule JSONAPISerializerTest do
     end
   end
 
+  defmodule ExpensiveResourceView do
+    use JSONAPI.View
+
+    def fields, do: [:name]
+
+    def type, do: "expensive-resource"
+
+    def links(data, _conn) do
+      %{
+        queue: "/expensive-resource/queue/#{data.id}",
+        promotions: %{
+          href: "/promotions?rel=#{data.id}",
+          meta: %{
+            title: "Stuff you might be interested in"
+          }
+        }
+      }
+    end
+  end
+
+  defmodule StringKeyResourceView do
+    use JSONAPI.View
+
+    def fields, do: [:name]
+
+    def type, do: "string-key-resource"
+
+    def links(data, _conn) do
+      %{
+        "string_link" => "/string-key-resource/link/#{data.id}"
+      }
+    end
+  end
+
   setup do
     Application.put_env(:jsonapi, :field_transformation, :underscore)
 
@@ -549,4 +583,36 @@ defmodule JSONAPISerializerTest do
 
     refute encoded[:links][:next]
   end
+
+  test "serialize can include arbitrary, user-defined, links" do
+    data = %{id: 1}
+
+    assert %{
+             links: links
+           } = Serializer.serialize(ExpensiveResourceView, data, nil)
+
+    expected_links = %{
+      self: "/expensive-resource/#{data.id}",
+      queue: "/expensive-resource/queue/#{data.id}",
+      promotions: %{
+        href: "/promotions?rel=#{data.id}",
+        meta: %{
+          title: "Stuff you might be interested in"
+        }
+      }
+    }
+
+    assert links[:self] == expected_links[:self]
+    assert links[:queue] == expected_links[:queue]
+    assert links[:promotions] == expected_links[:promotions]
+  end
+
+  test "serialize merges user-defined links whose names are strings" do
+    data = %{id: 1}
+
+    assert %{links: links} = Serializer.serialize(StringKeyResourceView, data, nil)
+
+    assert links["string_link"] == "/string-key-resource/link/#{data.id}"
+    assert links[:self] == "/string-key-resource/#{data.id}"
+  end
 end
