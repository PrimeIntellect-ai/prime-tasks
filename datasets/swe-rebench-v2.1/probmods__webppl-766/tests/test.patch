+exports.incrementalMHAssertionPreservesType = function(test) {
+  var error;
+  var code = ["Infer({method: 'incrementalMH',",
+              '  model: function() {',
+              '  assert.ok(false);',
+              '}});'].join('\n');
+  try {
+    webppl.run(code, null, {debug: true});
+  } catch (e) {
+    error = e;
+  }
+
+  errors.recoverStack(error, parseV8);
+  test.strictEqual(error.name, 'AssertionError',
+                   'Expected the reported error name to remain AssertionError.');
+  test.ok(error instanceof Error,
+          'Expected stack recovery to preserve the assertion failure as an error.');
+  test.done();
+};
+
+exports.incrementalMHAssertionDiagnosticShowsSource = function(test) {
+  var nodeErrors = require('../src/errors/node');
+  var code = ["Infer({method: 'incrementalMH',",
+              '  model() {',
+              "    assert.ok(false, 'fail');",
+              '  }});'].join('\n');
+  var error;
+  try {
+    webppl.run(code, null, {debug: true});
+  } catch (e) {
+    error = e;
+  }
+
+  test.ok(error, 'Expected the assertion to fail.');
+  var stack = errors.recoverStack(error, parseV8);
+  var output = [];
+  var originalLog = console.log;
+  try {
+    console.log = function(message) { output.push(String(message)); };
+    nodeErrors.showError(error, stack, 'webppl:program');
+  } finally {
+    console.log = originalLog;
+  }
+
+  var diagnostic = output.join('\n').replace(/\u001b\[[0-9;]*m/g, '');
+  var errorSummary = _.find(diagnostic.split('\n'), function(line) {
+    return line.indexOf('AssertionError') !== -1;
+  });
+  test.ok(errorSummary && errorSummary.indexOf('fail') !== -1,
+          'Expected the diagnostic summary to retain the assertion message.');
+  var lines = diagnostic.split('\n');
+  var sourceLine = _.find(lines, function(line) {
+    return line.indexOf("assert.ok(false, 'fail');") !== -1;
+  });
+  var caretLine = _.find(lines, function(line) { return line.indexOf('^') !== -1; });
+  test.ok(sourceLine, 'Expected the diagnostic to include the assertion source line.');
+  test.ok(/^3\|/.test(sourceLine), 'Expected the assertion source to be identified as line 3.');
+  test.ok(caretLine, 'Expected the diagnostic to include a caret.');
+  if (sourceLine && caretLine) {
+    var caretColumn = caretLine.indexOf('^');
+    var assertionStart = sourceLine.indexOf('assert.ok');
+    var assertionEnd = sourceLine.indexOf(';', assertionStart);
+    test.ok(caretColumn >= assertionStart && caretColumn < assertionEnd,
+            'Expected the caret to point within the assertion.');
+  }
+  test.done();
+};
