     assert str(q1) == '[0, 1, 2, 3]'
@@ -35,4 +33,21 @@ def test_Queue():
     assert q1.popleft().data == 2
     assert q1.popleft().data == 3
     assert len(q1) == 0
-    raises(ValueError, lambda: q1.popleft())
+    raises(IndexError, lambda: q1.popleft())
+    assert q1.front is None
+    assert q1.rear is None
+
+    q1 = Queue(implementation='linked_list',items=[1, 2, 3, 4])
+    assert len(q1) == 4
+    assert q1.size == 4
+
+    front = q1.front
+    assert front.data == q1.popleft().data
+
+    rear = q1.rear
+    for _ in range(len(q1)-1):
+        q1.popleft()
+
+    assert rear.data == q1.popleft().data
+    assert q1.front is None
+    assert q1.rear is None
diff --git a/pydatastructs/miscellaneous_data_structures/tests/test_stack.py b/pydatastructs/miscellaneous_data_structures/tests/test_stack.py
index d8ee561..9796da0 100644
--- a/pydatastructs/miscellaneous_data_structures/tests/test_stack.py
+++ b/pydatastructs/miscellaneous_data_structures/tests/test_stack.py
@@ -14,7 +14,39 @@ def test_Stack():
     assert s.pop() == 2
     assert s.pop() == 1
     assert s.is_empty is True
-    assert raises(ValueError, lambda : s.pop())
+    assert raises(IndexError, lambda : s.pop())
+    tuple_stack = Stack(items=(1, 2, 3))
+    assert [tuple_stack.pop(), tuple_stack.pop(), tuple_stack.pop()] == [3, 2, 1]
     _s = Stack(items=[1, 2, 3])
     assert str(_s) == '[1, 2, 3]'
+    assert len(_s) == 3
     assert raises(NotImplementedError, lambda: Stack(implementation=''))
+
+    s = Stack(implementation='linked_list')
+    s.push(1)
+    s.push(2)
+    s.push(3)
+    assert s.peek == 3
+    assert str(s) == '[3, 2, 1]'
+    assert s.pop().data == 3
+    assert s.pop().data == 2
+    assert s.pop().data == 1
+    assert s.is_empty is True
+    assert raises(IndexError, lambda : s.pop())
+    assert s.top is None
+    tuple_stack = Stack(implementation='linked_list', items=(1, 2, 3))
+    assert [tuple_stack.pop().data, tuple_stack.pop().data, tuple_stack.pop().data] == [3, 2, 1]
+    _s = Stack(implementation='linked_list',items=[1, 2, 3])
+    assert str(_s) == '[3, 2, 1]'
+    assert len(_s) == 3
+    assert raises(TypeError, lambda: Stack(implementation='linked_list', items={1, 2, 3}))
+
+    s = Stack(implementation='linked_list',items=[1, 2, 3, 4])
+    assert len(s) == 4
+    assert s.size == 4
+
+    top = s.top
+    assert top.data == s.pop().data
+
+    peek = s.peek
+    assert peek == s.pop().data
