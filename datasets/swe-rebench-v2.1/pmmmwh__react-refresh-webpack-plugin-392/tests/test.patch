+describe('WebSocket client URL', () => {
+  function connectUsingWebsocket(scriptUrl) {
+    const script = document.createElement('script');
+    script.src = scriptUrl;
+    Object.defineProperty(document, 'currentScript', {
+      configurable: true,
+      value: script,
+    });
+
+    let connectedUrl;
+    global.__webpack_dev_server_client__ = class WebsocketClient {
+      constructor(url) {
+        connectedUrl = url;
+      }
+
+      onMessage() {}
+    };
+
+    try {
+      initWDSSocket(() => {});
+      return connectedUrl;
+    } finally {
+      delete global.__webpack_dev_server_client__;
+      delete document.currentScript;
+    }
+  }
+
+  it('uses ws and preserves the host for an HTTP WebSocket connection', () => {
+    expect(connectUsingWebsocket('http://mobile.example:8080/bundle.js')).toBe(
+      'ws://mobile.example:8080/sockjs-node'
+    );
+  });
+
+  it('uses wss and preserves the host for an HTTPS WebSocket connection', () => {
+    expect(connectUsingWebsocket('https://mobile.example:8080/bundle.js')).toBe(
+      'wss://mobile.example:8080/sockjs-node'
+    );
+  });
+});
