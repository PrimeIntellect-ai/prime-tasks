+    @pytest.mark.unit
+    def test_format_docstring_no_blank_in_summary_with_symbol(self):
+        """Keep the reported docstring stable over repeated formatting."""
+        source = (
+            '"""hello yeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeet -v\n'
+            '"""\n'
+        )
+        command = [
+            sys.executable,
+            "-m",
+            "docformatter",
+            "--wrap-summaries",
+            "100",
+            "--wrap-descriptions",
+            "100",
+            "-",
+        ]
+
+        first_pass = subprocess.run(
+            command, input=source, text=True, capture_output=True, check=True
+        ).stdout
+        second_pass = subprocess.run(
+            command, input=first_pass, text=True, capture_output=True, check=True
+        ).stdout
+
+        assert first_pass.rstrip().endswith('-v.\"\"\"')
+        assert second_pass == first_pass
+
 
