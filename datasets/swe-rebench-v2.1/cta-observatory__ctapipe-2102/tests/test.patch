+def test_component_name_availability_at_assignment_time():
+    from ctapipe.core import traits
+
+    class Base(Component, metaclass=ABCMeta):
+        @abstractmethod
+        def stuff(self):
+            pass
+
+    class InitiallyAvailable(Base):
+        def stuff(self):
+            pass
+
+    # Use the runtime class-name trait when available. The fallback exercises
+    # the pre-existing class-enum entry point for implementations that update it.
+    if hasattr(traits, "ComponentName"):
+        trait = traits.ComponentName(Base)
+    else:
+        trait = traits.create_class_enum_trait(Base, "InitiallyAvailable")
+
+    class Configurable(Component):
+        implementation = trait
+
+    # This subclass does not exist when the trait is declared.
+    class LoadedLater(Base):
+        def stuff(self):
+            pass
+
+    # Assigning its name must be validated against the classes available now,
+    # rather than a list captured when the trait was declared.
+    Configurable(implementation="LoadedLater")
+
+    with pytest.raises(TraitError):
+        Configurable(implementation="Unavailable")
+
+
+def test_component_name_shower_processor_accepts_late_reconstructor():
+    from ctapipe.reco import Reconstructor, ShowerProcessor
+
+    class LoadedLaterReconstructor(Reconstructor):
+        def __call__(self, event):
+            pass
+
+    processor = ShowerProcessor(
+        subarray=None,
+        reconstructor_types=["LoadedLaterReconstructor"],
+    )
+
+    assert processor.reconstructor_types == ["LoadedLaterReconstructor"]
