+    )
+    pandas_df.loc[:, "c"] = [10, 20, 30, 40, 51]
+    modin_df.loc[:, "c"] = [10, 20, 30, 40, 51]
+    df_equals(modin_df, pandas_df)
+
+    pandas_df.loc[2:, "y"] = [30, 40, 51]
+    modin_df.loc[2:, "y"] = [30, 40, 51]
+    df_equals(modin_df, pandas_df)
+
+    pandas_df.loc[:, ["b", "c", "d"]] = (
+        pd.DataFrame([[10, 20, 30, 40, 50], [10, 20, 30, 40], [10, 20, 30]])
+        .transpose()
+        .values
+    )
+    modin_df.loc[:, ["b", "c", "d"]] = (
+        pd.DataFrame([[10, 20, 30, 40, 50], [10, 20, 30, 40], [10, 20, 30]])
+        .transpose()
+        .values
+    )
+    df_equals(modin_df, pandas_df)
+
