+fn validator_pending_reward_constructor_sets_fields() {
+    let reward = ValidatorPendingReward::new("validator-x", 47, "rewardtoken");
+
+    assert_eq!(
+        reward,
+        ValidatorPendingReward {
+            validator: "validator-x".to_owned(),
+            amount: coin(47, "rewardtoken"),
+        }
+    );
