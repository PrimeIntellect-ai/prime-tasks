+#[test]
+fn all_pending_rewards_pagination() {
+    let owner = "owner";
+    let user = "user1";
+
+    let app = MtApp::new(|router, _api, storage| {
+        router
+            .bank
+            .init_balance(storage, &Addr::unchecked(user), coins(1000, OSMO))
+            .unwrap();
+
+        router
+            .bank
+            .init_balance(
+                storage,
+                &Addr::unchecked(owner),
+                vec![coin(1000, STAR), coin(1000, OSMO)],
+            )
+            .unwrap();
+    });
+    let app = App::new(app);
+
+    let (vault, contract) = setup(&app, owner, 100).unwrap();
+
+    // Register and stake on more validators than the maximum page size.
+    let validators: Vec<String> = (0..31).map(|i| format!("validator{:02}", i)).collect();
+    for val in &validators {
+        contract
+            .test_set_active_validator(AddValidator::mock(val))
+            .call("test")
+            .unwrap();
+    }
+
+    vault
+        .bond()
+        .with_funds(&coins(1000, OSMO))
+        .call(user)
+        .unwrap();
+
+    for val in &validators {
+        vault
+            .stake_remote(
+                contract.contract_addr.to_string(),
+                coin(1, OSMO),
+                to_binary(&ReceiveVirtualStake {
+                    validator: val.clone(),
+                })
+                .unwrap(),
+            )
+            .call(user)
+            .unwrap();
+        contract
+            .test_commit_stake(get_last_external_staking_pending_tx_id(&contract).unwrap())
+            .call("test")
+            .unwrap();
+    }
+
+    // An explicit limit caps the number of returned entries.
+    let all_rewards = contract
+        .all_pending_rewards(user.to_owned(), None, Some(30))
+        .unwrap();
+    assert!(all_rewards.rewards.len() <= 30);
+
+    // A different supplied limit also caps the returned page.
+    let all_rewards = contract
+        .all_pending_rewards(user.to_owned(), None, Some(31))
+        .unwrap();
+    assert!(all_rewards.rewards.len() <= 31);
+
+    // `start_after` skips validators up to and including the given one.
+    let all_rewards = contract
+        .all_pending_rewards(user.to_owned(), Some(validators[0].clone()), None)
+        .unwrap();
+    assert_eq!(all_rewards.rewards.len(), 30);
+    assert_eq!(all_rewards.rewards[0].validator, validators[1]);
+
+    let all_rewards = contract
+        .all_pending_rewards(user.to_owned(), Some(validators[29].clone()), None)
+        .unwrap();
+    assert_eq!(all_rewards.rewards.len(), 1);
+    assert_eq!(all_rewards.rewards[0].validator, validators[30]);
+}
