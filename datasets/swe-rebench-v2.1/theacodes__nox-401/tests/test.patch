+def test_cli_lists_parameter_names_in_declaration_order(tmp_path):
+    (tmp_path / "noxfile.py").write_text(
+        "import nox\n"
+        "@nox.session\n"
+        "@nox.parametrize(('z', 'a'), [(1, 2)])\n"
+        "def task(session, z, a):\n"
+        "    pass\n"
+    )
+
+    env = os.environ.copy()
+    project_root = str(Path(__file__).resolve().parents[1])
+    env["PYTHONPATH"] = project_root + os.pathsep + env.get("PYTHONPATH", "")
+    result = subprocess.run(
+        [sys.executable, "-m", "nox", "--list"],
+        cwd=str(tmp_path),
+        env=env,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        universal_newlines=True,
+    )
+
+    assert result.returncode == 0
+    assert "* task(z=1, a=2)" in result.stdout
+
+
+def test_cli_runs_parameterized_sessions_in_declaration_order(tmp_path):
+    (tmp_path / "noxfile.py").write_text(
+        "import nox\n"
+        "@nox.session(venv_backend='none')\n"
+        "@nox.parametrize(('z', 'a'), [(1, 2)])\n"
+        "def task(session, z, a):\n"
+        "    pass\n"
+    )
+
+    env = os.environ.copy()
+    project_root = str(Path(__file__).resolve().parents[1])
+    env["PYTHONPATH"] = project_root + os.pathsep + env.get("PYTHONPATH", "")
+    result = subprocess.run(
+        [sys.executable, "-m", "nox", "-s", "task"],
+        cwd=str(tmp_path),
+        env=env,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        universal_newlines=True,
+    )
+
+    assert result.returncode == 0
+    assert "Running session task(z=1, a=2)" in result.stdout
