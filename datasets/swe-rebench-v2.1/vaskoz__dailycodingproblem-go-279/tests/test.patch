+package day134
+
+import (
+	"runtime"
+	"strconv"
+	"testing"
+)
+
+func TestSparseArray(t *testing.T) {
+	t.Parallel()
+	arr := []int{0, 0, 0, 0, 9, 8, 7, 6, 0, 0}
+	sa := NewSparseArray(arr)
+	for i, val := range arr {
+		if result, _ := sa.Get(i); result != val {
+			t.Errorf("Expected %v at index %d, got %v", val, i, result)
+		}
+	}
+	sa.Set(0, 10)
+	if result, _ := sa.Get(0); result != 10 {
+		t.Errorf("Set did not update a zero-valued index: got %v", result)
+	}
+	sa.Set(4, 42)
+	if result, _ := sa.Get(4); result != 42 {
+		t.Errorf("Set did not replace a nonzero value: got %v", result)
+	}
+	sa.Set(4, 9)
+	if result, _ := sa.Get(4); result != 9 {
+		t.Errorf("Set did not restore the requested value: got %v", result)
+	}
+	sa.Set(0, 0)
+	for i, val := range arr {
+		if result, _ := sa.Get(i); result != val {
+			t.Errorf("Expected %v at index %d, got %v", val, i, result)
+		}
+	}
+}
+
+func TestSparseArrayUsesLessStorageForMostlyZeroInput(t *testing.T) {
+	const size = 8_000_000
+	runtime.GC()
+	var before runtime.MemStats
+	runtime.ReadMemStats(&before)
+
+	arr := make([]int, size)
+	arr[17] = 5
+	arr[size-1] = -3
+	sa := NewSparseArray(arr)
+	arr = nil
+	runtime.GC()
+
+	var after runtime.MemStats
+	runtime.ReadMemStats(&after)
+	runtime.KeepAlive(sa)
+
+	var retained uint64
+	if after.HeapAlloc > before.HeapAlloc {
+		retained = after.HeapAlloc - before.HeapAlloc
+	}
+	denseBytes := uint64(size) * uint64(strconv.IntSize/8)
+	if retained >= denseBytes*99/100 {
+		t.Fatalf("mostly-zero array retained %d bytes; expected substantially less than a dense %d-byte array", retained, denseBytes)
+	}
+	for index, want := range map[int]int{17: 5, size - 1: -3, size / 2: 0} {
+		if got, _ := sa.Get(index); got != want {
+			t.Fatalf("Get(%d) = %d; want %d", index, got, want)
+		}
+	}
+}
+
+func BenchmarkSparseArray(b *testing.B) {
+	arr := []int{0, 0, 0, 0, 9, 8, 7, 6, 0, 0}
+	sa := NewSparseArray(arr)
+	for i := 0; i < b.N; i++ {
+		sa.Set(0, 10)
+		sa.Get(0)
+		sa.Set(0, 0)
+
+	}
+}
