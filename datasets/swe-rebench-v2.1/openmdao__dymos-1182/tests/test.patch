+    def test_meaningful_units_with_unitless_time(self):
+        for deriv in (1, 2):
+            with self.subTest(deriv=deriv):
+                self.assertEqual(get_rate_units('m', 'unitless', deriv=deriv), 'm')
+
+    def test_rate_units_for_unitless_time(self):
