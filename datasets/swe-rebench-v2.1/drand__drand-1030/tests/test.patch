+func TestControlListenerBindFailure(t *testing.T) {
+	// Occupy a port so that binding to the same address fails.
+	occupied, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer occupied.Close()
+	addr := occupied.Addr().String()
+
+	s := testnet.EmptyServer{}
+	_, err = NewTCPGrpcControlListener(&s, addr)
+	require.Error(t, err)
+}
