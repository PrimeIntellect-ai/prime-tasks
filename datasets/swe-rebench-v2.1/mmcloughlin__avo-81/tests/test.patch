index 021cd5e..92a727c 100644
--- a/pass/cleanup_test.go
+++ b/pass/cleanup_test.go
@@ -42,3 +42,45 @@ func TestPruneSelfMoves(t *testing.T) {
 		t.Fatal("unexpected result from self-move pruning")
 	}
 }
+
+func TestCleanupRemovesJumpToAdjacentLabel(t *testing.T) {
+	// Construct both a jump to the following label and a jump past an
+	// intervening instruction to a later label.
+	ctx := build.NewContext()
+	ctx.Function("add")
+	ctx.XORQ(reg.RAX, reg.RAX)
+	ctx.JMP(operand.LabelRef("next"))
+	ctx.Label("next")
+	ctx.XORQ(reg.RAX, reg.RAX)
+	ctx.JMP(operand.LabelRef("later"))
+	ctx.XORQ(reg.RAX, reg.RAX)
+	ctx.Label("later")
+	ctx.XORQ(reg.RAX, reg.RAX)
+
+	// Run the ordinary compilation pipeline without coupling the test to the
+	// name of the cleanup transform that it contains.
+	f, err := ctx.Result()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := pass.Compile.Execute(f); err != nil {
+		t.Fatal(err)
+	}
+	fn := f.Functions()[0]
+
+	// The redundant jump is gone, but the jump past an instruction remains.
+	jumps := 0
+	for _, i := range fn.Instructions() {
+		if i.Opcode != "JMP" {
+			continue
+		}
+		jumps++
+		target := i.TargetLabel()
+		if target == nil || *target != ir.Label("later") {
+			t.Fatalf("unexpected JMP target: %v", target)
+		}
+	}
+	if jumps != 1 {
+		t.Fatalf("got %d JMP instructions, want 1", jumps)
+	}
+}
