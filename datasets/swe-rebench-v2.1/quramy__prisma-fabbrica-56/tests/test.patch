@@ -0,0 +1,73 @@
+import { getDMMF } from "@prisma/internals";
+
+import { modelScalarOrEnumFields, getIdFieldNames, getSourceFile } from ".";
+
+describe(modelScalarOrEnumFields, () => {
+  it.each([
+    {
+      pattern: "@id",
+      datamodel: `
+        model TestModel {
+          id Int @id
+        }
+      `,
+      expected: ["id"],
+    },
+    {
+      pattern: "no PK but @unique",
+      datamodel: `
+        model TestModel {
+          field1 Int @unique
+          field2 Int @unique
+        }
+      `,
+      expected: ["field1"],
+    },
+    {
+      pattern: "Complex id",
+      datamodel: `
+        model TestModel {
+          field1 Int
+          field2 String
+          @@id([field1, field2])
+        }
+      `,
+      expected: ["field1", "field2"],
+    },
+  ])("generates literal type field for $pattern", async ({ datamodel, expected }) => {
+    const dmmf = await getDMMF({
+      datamodel,
+    });
+    expect(getIdFieldNames(dmmf.datamodel.models[0])).toEqual(expected);
+  });
+});
+
+describe(getSourceFile, () => {
+  it("generates source for a schema containing a model without a primary key", async () => {
+    const dmmf = await getDMMF({
+      datamodel: `
+        model Company {
+          id    String @id
+          name  String
+          companyEmployees CompanyEmployee[]
+        }
+
+        model Employee {
+          id        String   @id
+          name      String
+          companyEmployees CompanyEmployee?
+        }
+
+        model CompanyEmployee {
+          company   Company  @relation(fields: [companyId], references: [id])
+          companyId String
+          employee  Employee @relation(fields: [employeeId], references: [id])
+          employeeId String @unique
+
+          @@unique([companyId, employeeId])
+        }
+      `,
+    });
+    expect(() => getSourceFile({ document: dmmf })).not.toThrow();
+  });
+});
