+    @Test
+    public void serializingPayloadDoesNotConsumeSharedBufferThroughItsOwnReadAccessors() {
+        SegmentedPersistentQueueSerDes sut = new SegmentedPersistentQueueSerDes();
+        String payloadContents = "prefix:" + TEST_STRING;
+        ReadTrackingByteBuf sharedPayload = new ReadTrackingByteBuf(payloadContents.getBytes(StandardCharsets.UTF_8));
+        sharedPayload.readerIndex("prefix:".length());
+        sharedPayload.retain();
+
+        try {
+            SessionRegistry.EnqueuedMessage message = new SessionRegistry.PublishedMessage(
+                Topic.asTopic("/metering/temperature"), MqttQoS.AT_MOST_ONCE, sharedPayload, true, Instant.MAX);
+
+            ByteBuffer serialized = sut.toBytes(message);
+
+            assertFalse(sharedPayload.consumedDirectly(),
+                "Serializing must not read the shared buffer with a consuming operation");
+            assertEquals("prefix:".length(), sharedPayload.readerIndex());
+            assertEquals(TEST_STRING, sharedPayload.toString(StandardCharsets.UTF_8));
+            SessionRegistry.PublishedMessage decoded = (SessionRegistry.PublishedMessage) sut.fromBytes(serialized);
+            assertEquals(TEST_STRING, decoded.getPayload().toString(StandardCharsets.UTF_8));
+        } finally {
+            sharedPayload.release();
+        }
+    }
+
+    /**
+     * A heap buffer that records whether any consuming read (one that advances the readerIndex of this very
+     * instance) was requested on it. Duplicates and copies are separate buffers, so reads performed on them are
+     * not recorded.
+     */
+    private static final class ReadTrackingByteBuf extends UnpooledHeapByteBuf {
+        private boolean consumed;
+
+        ReadTrackingByteBuf(byte[] content) {
+            super(UnpooledByteBufAllocator.DEFAULT, content.length, content.length);
+            writeBytes(content);
+        }
+
+        boolean consumedDirectly() {
+            return consumed;
+        }
+
+        @Override
+        public ByteBuf readBytes(byte[] dst) {
+            consumed = true;
+            return super.readBytes(dst);
+        }
+
+        @Override
+        public ByteBuf readBytes(byte[] dst, int dstIndex, int length) {
+            consumed = true;
+            return super.readBytes(dst, dstIndex, length);
+        }
+
+        @Override
+        public ByteBuf readBytes(ByteBuffer dst) {
+            consumed = true;
+            return super.readBytes(dst);
+        }
+
+        @Override
+        public ByteBuf readBytes(int length) {
+            consumed = true;
+            return super.readBytes(length);
+        }
+
+        @Override
+        public ByteBuf skipBytes(int length) {
+            consumed = true;
+            return super.skipBytes(length);
+        }
+    }
