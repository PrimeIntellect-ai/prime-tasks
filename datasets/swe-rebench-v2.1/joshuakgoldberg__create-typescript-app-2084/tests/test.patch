@@ -0,0 +1,35 @@
+import { prepareOptions } from "bingo";
+import { describe, expect, test } from "vitest";
+
+import { base } from "../base.js";
+
+type PrepareSettings = NonNullable<Parameters<typeof prepareOptions>[1]>;
+
+async function prepareBinFor(packageJson: Record<string, unknown>) {
+const options = await prepareOptions(base, {
+fs: {
+readFile: async (filePath: string) => {
+if (filePath.endsWith("package.json")) {
+return JSON.stringify(packageJson);
+}
+
+throw new Error(`Unexpected read of ${filePath}`);
+},
+} as unknown as PrepareSettings["fs"],
+offline: true,
+});
+
+return options.bin;
+}
+
+describe("options.bin with a string path", () => {
+test.each([
+["./a", "a"],
+["a", "a"],
+["./bin/index.js", "bin/index.js"],
+])("%s becomes %s", async (input, expected) => {
+const actual = await prepareBinFor({ bin: input });
+
+expect(actual).toBe(expected);
+});
+});
