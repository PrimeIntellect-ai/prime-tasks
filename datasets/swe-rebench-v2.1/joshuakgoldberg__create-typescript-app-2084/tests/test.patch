+import { prepareOptions } from "bingo";
+import { describe, expect, it } from "vitest";
+
+import { base } from "../base.js";
+
+type PrepareSettings = NonNullable<Parameters<typeof prepareOptions>[1]>;
+
+async function prepareBinFor(packageJson: Record<string, unknown>) {
+const options = await prepareOptions(base, {
+fs: {
+readFile: async (filePath: string) => {
+if (filePath.endsWith("package.json")) {
+return JSON.stringify(packageJson);
+}
+
+throw new Error(`Unexpected read of ${filePath}`);
+},
+} as unknown as PrepareSettings["fs"],
+offline: true,
+});
+
+return options.bin;
+}
+
+describe("options.bin", () => {
+it("is undefined when package.json has no bin", async () => {
+const actual = await prepareBinFor({ name: "test-repository" });
+
+expect(actual).toBe(undefined);
+});
+
+it("omits a leading ./ from each path when the bin is an object", async () => {
+const actual = await prepareBinFor({
+bin: {
+absolute: "index.js",
+relative: "./index.js",
+},
+});
+
+expect(actual).toEqual({
+absolute: "index.js",
+relative: "index.js",
+});
+});
+});
