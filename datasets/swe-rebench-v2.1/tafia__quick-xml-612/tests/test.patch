+/// Asserts that reading `data` yields the public `Error::EmptyDocType` variant
+/// (identified by its public name in the error's `Debug` output) instead of
+/// panicking on the debug assertion or returning an empty `Event::DocType`.
+fn assert_empty_doctype_error(data: &[u8]) {
+    let mut reader = Reader::from_reader(data);
+    let mut buf = Vec::new();
+    let err = reader.read_event_into(&mut buf).unwrap_err();
+    assert!(
+        format!("{:?}", err).contains("EmptyDocType"),
+        "expected Error::EmptyDocType, got {:?}",
+        err
+    );
+}
+
+#[test]
+fn fuzz_empty_doctype() {
+    assert_empty_doctype_error(b"<!doctype  \n    >");
+}
+
+#[test]
+fn empty_doctype_reproducer() {
+    // The exact input from the problem statement: an empty doctype with no
+    // name and no whitespace before the closing `>`.
+    assert_empty_doctype_error(b"<!DoctyPE>");
+}
