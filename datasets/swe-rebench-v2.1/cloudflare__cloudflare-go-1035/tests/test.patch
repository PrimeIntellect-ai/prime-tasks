 const testBucketName = "example-bucket"
 
+// Call the public creation method without requiring callers to use a particular
+// Go parameter representation. The API historically accepted a string, while
+// the current API may accept a parameter object.
+func callCreateR2Bucket(t *testing.T, rc *ResourceContainer, name string) error {
+	t.Helper()
+
+	method := reflect.ValueOf(client).MethodByName("CreateR2Bucket")
+	if !method.IsValid() {
+		t.Fatal("CreateR2Bucket method is unavailable")
+	}
+	parameterType := method.Type().In(2)
+	var parameter reflect.Value
+	if parameterType.Kind() == reflect.String {
+		parameter = reflect.ValueOf(name)
+	} else {
+		valueType := parameterType
+		if valueType.Kind() == reflect.Ptr {
+			valueType = valueType.Elem()
+		}
+		value := reflect.New(valueType).Elem()
+		if valueType.Kind() == reflect.Struct {
+			for i := 0; i < valueType.NumField(); i++ {
+				field := valueType.Field(i)
+				tagName := strings.Split(field.Tag.Get("json"), ",")[0]
+				if field.Type.Kind() == reflect.String && (field.Name == "Name" || tagName == "name") {
+					value.Field(i).SetString(name)
+					break
+				}
+			}
+		}
+		parameter = value
+		if parameterType.Kind() == reflect.Ptr {
+			parameter = value.Addr()
+		}
+	}
+	results := method.Call([]reflect.Value{reflect.ValueOf(context.Background()), reflect.ValueOf(rc), parameter})
+	if results[0].IsNil() {
+		return nil
+	}
+	return results[0].Interface().(error)
+}
