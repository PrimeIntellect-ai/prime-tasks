index 0755747..3103b32 100644
--- a/test/test_geos_types.jl
+++ b/test/test_geos_types.jl
@@ -80,4 +80,40 @@
         @test length(LibGEOS.interiorRings(poly_rings2)) == 2
     end
 
-end
\ No newline at end of file
+end
+points = [LibGEOS.Point(0.0, 0.0), LibGEOS.Point(1.0, 1.0)]
+multipoint = try
+    LibGEOS.MultiPoint(points)
+catch
+    nothing
+end
+point_members = multipoint === nothing ? LibGEOS.Geometry[] :
+    [LibGEOS.getGeometry(multipoint, i) for i in 1:LibGEOS.numGeometries(multipoint)]
+
+polygons = [
+    LibGEOS.Polygon([[[0.0, 0.0], [2.0, 0.0], [2.0, 2.0], [0.0, 0.0]]]),
+    LibGEOS.Polygon([[[4.0, 0.0], [6.0, 0.0], [6.0, 2.0], [4.0, 0.0]]]),
+]
+multipolygon = try
+    LibGEOS.MultiPolygon(polygons)
+catch
+    nothing
+end
+polygon_members = multipolygon === nothing ? LibGEOS.Geometry[] :
+    [LibGEOS.getGeometry(multipolygon, i) for i in 1:LibGEOS.numGeometries(multipolygon)]
+
+@testset "Multi-geometry constructors from vectors" begin
+    @test multipoint !== nothing
+    @test multipoint === nothing || LibGEOS.numGeometries(multipoint) == length(points)
+    @test multipoint === nothing || all(point -> any(member -> LibGEOS.equals(member, point), point_members), points)
+    @test multipolygon !== nothing
+    @test multipolygon === nothing || LibGEOS.numGeometries(multipolygon) == length(polygons)
+    @test multipolygon === nothing || all(polygon -> any(member -> LibGEOS.equals(member, polygon), polygon_members), polygons)
+end
+
+foreach(LibGEOS.destroyGeom, points)
+foreach(LibGEOS.destroyGeom, point_members)
+multipoint === nothing || LibGEOS.destroyGeom(multipoint)
+foreach(LibGEOS.destroyGeom, polygons)
+foreach(LibGEOS.destroyGeom, polygon_members)
+multipolygon === nothing || LibGEOS.destroyGeom(multipolygon)
