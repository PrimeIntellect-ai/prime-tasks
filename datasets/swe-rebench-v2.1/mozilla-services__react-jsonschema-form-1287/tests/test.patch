diff --git a/test/oneOf_test.js b/test/oneOf_test.js
index 98ba91e..9f78c14 100644
--- a/test/oneOf_test.js
+++ b/test/oneOf_test.js
@@ -464,4 +464,256 @@ describe("oneOf", () => {
       expect(node.querySelectorAll("input#root_bar")).to.have.length.of(1);
     });
   });
+
+  describe("definitions", () => {
+    it("should handle the $ref keyword correctly", () => {
+      const schema = {
+        type: "object",
+        properties: {
+          value: {
+            type: "array",
+            items: {
+              type: "object",
+              oneOf: [
+                {
+                  type: "object",
+                  properties: {
+                    value: {
+                      type: "string",
+                    },
+                  },
+                },
+                {
+                  type: "object",
+                  properties: {
+                    value: {
+                      type: "array",
+                      items: {
+                        type: "string",
+                      },
+                    },
+                  },
+                },
+              ],
+            },
+          },
+        },
+      };
+
+      const { node } = createFormComponent({
+        schema,
+      });
+
+      expect(node.querySelector(".array-item-add button")).not.eql(null);
+
+      Simulate.click(node.querySelector(".array-item-add button"));
+
+      const $select = node.querySelector("select");
+      expect($select).not.eql(null);
+      Simulate.change($select, {
+        target: { value: $select.options[1].value },
+      });
+
+      // This works because the nested "add" button will now be the first to
+      // appear in the dom
+      Simulate.click(node.querySelector(".array-item-add button"));
+
+      expect($select.value).to.eql($select.options[1].value);
+    });
+
+    it("should render nested oneOf dropdowns for arrays of objects", () => {
+      const schema = {
+        type: "object",
+        properties: {
+          value: {
+            type: "array",
+            items: {
+              type: "object",
+              oneOf: [
+                {
+                  type: "object",
+                  properties: {
+                    service: {
+                      type: "string",
+                    },
+                  },
+                },
+                {
+                  type: "object",
+                  properties: {
+                    service: {
+                      type: "array",
+                      items: {
+                        type: "object",
+                        oneOf: [
+                          {
+                            type: "object",
+                            properties: {
+                              endpoint: {
+                                type: "string",
+                              },
+                            },
+                          },
+                          {
+                            type: "object",
+                            properties: {
+                              endpoint: {
+                                type: "array",
+                                items: {
+                                  type: "string",
+                                },
+                              },
+                            },
+                          },
+                        ],
+                      },
+                    },
+                  },
+                },
+              ],
+            },
+          },
+        },
+      };
+
+      const { node } = createFormComponent({
+        schema,
+      });
+
+      // Add an item to the top-level array; a oneOf dropdown should appear.
+      Simulate.click(node.querySelector(".array-item-add button"));
+
+      const $service = node.querySelector("select");
+      expect($service).not.eql(null);
+      expect($service.options).to.have.length.of(2);
+
+      // Choose the option that nests another array of oneOf objects.
+      Simulate.change($service, {
+        target: { value: $service.options[1].value },
+      });
+
+      // Add an item to the nested array; a second oneOf dropdown should appear.
+      Simulate.click(node.querySelector(".array-item-add button"));
+
+      const selects = node.querySelectorAll("select");
+      expect(selects).to.have.length.of(2);
+
+      const $endpoint = selects[1];
+      expect($endpoint.options).to.have.length.of(2);
+
+      // Choose the option that nests a further array.
+      Simulate.change($endpoint, {
+        target: { value: $endpoint.options[1].value },
+      });
+
+      // Both dropdown selections must be preserved after the nested change.
+      expect($service.value).to.eql($service.options[1].value);
+      expect($endpoint.value).to.eql($endpoint.options[1].value);
+
+      // The nested array should now expose its own add button.
+      expect(node.querySelector(".array-item-add button")).not.eql(null);
+    });
+
+    it("should provide the expected nested formData for the described selection flow", () => {
+      const endpointSchema = {
+        type: "object",
+        oneOf: [
+          {
+            type: "object",
+            properties: {
+              Description: { type: "string" },
+            },
+          },
+          {
+            type: "object",
+            properties: {
+              endpointDescription: { type: "string" },
+            },
+          },
+        ],
+      };
+      const serviceSchema = {
+        type: "object",
+        oneOf: [
+          {
+            type: "object",
+            properties: {
+              service: { type: "string" },
+              endpoints: {
+                type: "array",
+                items: endpointSchema,
+              },
+            },
+          },
+          {
+            type: "object",
+            properties: {
+              serviceName: { type: "string" },
+              endpoints: {
+                type: "array",
+                items: endpointSchema,
+              },
+            },
+          },
+        ],
+      };
+      const schema = {
+        type: "object",
+        properties: {
+          typeProp: { type: "string" },
+          verifications: {
+            type: "array",
+            items: serviceSchema,
+          },
+        },
+      };
+
+      const { comp, node } = createFormComponent({
+        schema,
+      });
+
+      // Add a verification; a service oneOf dropdown appears.
+      Simulate.click(node.querySelector(".array-item-add button"));
+      const $service = node.querySelector("select");
+      expect($service).not.eql(null);
+
+      // Choose the "serviceName" option.
+      Simulate.change($service, {
+        target: { value: $service.options[1].value },
+      });
+
+      // Add an endpoint; an endpoint oneOf dropdown appears.
+      Simulate.click(node.querySelector(".array-item-add button"));
+      const selects = node.querySelectorAll("select");
+      expect(selects).to.have.length.of(2);
+      const $endpoint = selects[1];
+
+      // Choose the "endpointDescription" option.
+      Simulate.change($endpoint, {
+        target: { value: $endpoint.options[1].value },
+      });
+
+      // Enter values into the fields exposed by the selected options.
+      Simulate.change(node.querySelector("input[id$='typeProp']"), {
+        target: { value: "verify" },
+      });
+      Simulate.change(node.querySelector("input[id$='serviceName']"), {
+        target: { value: "yourService" },
+      });
+      Simulate.change(node.querySelector("input[id$='endpointDescription']"), {
+        target: { value: "yourService1" },
+      });
+
+      // The nested selections must be reflected in the formData.
+      expect(comp.state.formData).to.eql({
+        typeProp: "verify",
+        verifications: [
+          {
+            serviceName: "yourService",
+            endpoints: [{ endpointDescription: "yourService1" }],
+          },
+        ],
+      });
+    });
+  });
 });
