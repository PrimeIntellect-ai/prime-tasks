+
+enum Suit {
+    Clubs,
+    Diamonds,
+    Hearts,
+    Spades,
+}
+
+#[derive(Template)]
+#[template(path = "match-enum-or.html")]
+struct MatchEnumOrTemplate {
+    suit: Suit,
+}
+
+#[test]
+fn test_match_enum_or() {
+    let template = MatchEnumOrTemplate { suit: Suit::Clubs };
+    assert_eq!(template.render().unwrap(), "The card is black");
+    let template = MatchEnumOrTemplate { suit: Suit::Spades };
+    assert_eq!(template.render().unwrap(), "The card is black");
+
+    let template = MatchEnumOrTemplate { suit: Suit::Hearts };
+    assert_eq!(template.render().unwrap(), "The card is red");
+
+    let template = MatchEnumOrTemplate {
+        suit: Suit::Diamonds,
+    };
+    assert_eq!(template.render().unwrap(), "The card is red");
+}
+
+
+#[test]
+fn test_match_rejects_pipe_separator() {
+    use std::fs;
+    use std::process::Command;
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    let unique = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap()
+        .as_nanos();
+    let project = std::env::temp_dir().join(format!("askama-pipe-match-{unique}"));
+    let source = project.join("src");
+    fs::create_dir_all(&source).unwrap();
+
+    let askama_path = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../askama");
+    fs::write(
+        project.join("Cargo.toml"),
+        format!(
+            "[package]\nname = \"pipe_match_rejection\"\nversion = \"0.0.0\"\nedition = \"2021\"\n\n[dependencies]\naskama = {{ path = {:?}, default-features = false }}\n",
+            askama_path
+        ),
+    )
+    .unwrap();
+    fs::write(
+        source.join("main.rs"),
+        r#"use askama::Template;
+
+enum Item { A, B }
+
+#[derive(Template)]
+#[template(source = "{% match item %}{% when Item::A | Item::B %}matched{% endmatch %}", ext = "txt")]
+struct Example { item: Item }
+
+fn main() {}
+"#,
+    )
+    .unwrap();
+
+    let target = project.join("target");
+    let result = Command::new("cargo")
+        .args(["check", "--offline", "--quiet", "--manifest-path"])
+        .arg(project.join("Cargo.toml"))
+        .env("CARGO_TARGET_DIR", target)
+        .output()
+        .unwrap();
+    let _ = fs::remove_dir_all(&project);
+    assert!(
+        !result.status.success(),
+        "a pipe-separated match arm should be rejected"
+    );
+}
