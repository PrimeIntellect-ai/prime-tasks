+class TestCircuitConstructionPerformance(QiskitTestCase):
+    """Check parameter-reference construction performance."""
+
+    def test_construction_scales_with_gate_count(self):
+        """Building many gates reusing few parameters scales sub-quadratically."""
+
+        params = [Parameter(f"p{i}") for i in range(8)]
+
+        def build(num_gates):
+            circuit = QuantumCircuit(1)
+            for i in range(num_gates):
+                circuit.rz(params[i % len(params)], 0)
+            return circuit
+
+        build(1000)  # warm up
+
+        def timed_build(num_gates):
+            best = None
+            for _ in range(2):
+                start = time.perf_counter()
+                build(num_gates)
+                elapsed = time.perf_counter() - start
+                best = elapsed if best is None else min(best, elapsed)
+            return best
+
+        small = timed_build(20000)
+        large = timed_build(80000)
+
+        # Four times the gates: linear scaling is about 4x, quadratic is about 16x.
+        self.assertLessEqual(large, 8 * small)
+
+
