+// telegramTransport redirects every request made through the default HTTP
+// transport to a local test server, so the plugin can be exercised without
+// reaching the real Telegram API.
+type telegramTransport struct {
+	target *url.URL
+	base   http.RoundTripper
+}
+
+func (t *telegramTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	req.URL.Scheme = t.target.Scheme
+	req.URL.Host = t.target.Host
+	return t.base.RoundTrip(req)
+}
