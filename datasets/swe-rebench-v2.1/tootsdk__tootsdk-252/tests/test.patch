+//
+//  PostTranslationTests.swift
+//
+
+import XCTest
+@testable import TootSDK
+
+final class PostTranslationTests: XCTestCase {
+    func testPostInitializerAcceptsNilApplication() throws {
+        let account = try localObject(Account.self, "account")
+
+        let post = Post(
+            id: "1",
+            uri: "https://example.com/1",
+            createdAt: Date(),
+            account: account,
+            visibility: .public,
+            sensitive: false,
+            spoilerText: "",
+            mediaAttachments: [],
+            application: nil,
+            mentions: [],
+            tags: [],
+            emojis: [],
+            repostsCount: 0,
+            favouritesCount: 0,
+            repliesCount: 0
+        )
+
+        XCTAssertNil(post.application)
+    }
+}
