+def _run_capturing_stdout(func, *args):
+    """
+    Call ``func(*args)`` in a forked child process and capture everything it
+    writes to stdout.
+
+    Running the call in a separate process is necessary because a runtime
+    error in the generated code (for instance a Fortran formatted-write error)
+    would otherwise abort the whole test session instead of producing a
+    regular test failure.
+
+    Returns
+    -------
+    exitcode : int
+        The exit code of the child process (0 on success).
+    output : str
+        The text written to stdout by the child process.
+    """
+    import os
+    import ctypes
+    import ctypes.util
+
+    sys.stdout.flush()
+    read_fd, write_fd = os.pipe()
+    pid = os.fork()
+    if pid == 0:
+        # Child process: redirect both the OS-level stdout file descriptor
+        # (used by the generated C and Fortran code) and the Python-level
+        # ``sys.stdout`` object (used by the generated Python code) to the
+        # pipe so that everything the call prints is captured.
+        try:
+            os.close(read_fd)
+            os.dup2(write_fd, 1)
+            os.close(write_fd)
+            sys.stdout = os.fdopen(1, 'w')
+            func(*args)
+            sys.stdout.flush()
+            # Flush the C stdio buffer so that output produced by the
+            # generated C code is not lost when the child exits.
+            ctypes.CDLL(None).fflush(None)
+            # Flush the Fortran runtime buffers so that output produced by
+            # the generated Fortran code is not lost when the child exits.
+            # ``_gfortran_flush_i4(NULL)`` flushes every open unit.
+            try:
+                libgfortran = ctypes.util.find_library('gfortran')
+                if libgfortran:
+                    ctypes.CDLL(libgfortran)._gfortran_flush_i4(None)
+            except (OSError, AttributeError):
+                pass
+            os._exit(0)
+        except BaseException:
+            os._exit(1)
+
+    os.close(write_fd)
+    chunks = []
+    while True:
+        chunk = os.read(read_fd, 4096)
+        if not chunk:
+            break
+        chunks.append(chunk)
+    os.close(read_fd)
+    _, status = os.waitpid(pid, 0)
+    if os.WIFEXITED(status):
+        exitcode = os.WEXITSTATUS(status)
+    else:
+        exitcode = -os.WTERMSIG(status)
+
+    return exitcode, b''.join(chunks).decode('utf-8', errors='replace')
+
+
+def _check_print_reduction(f1, x, expected):
+    exitcode, output = _run_capturing_stdout(f1, x)
+    assert exitcode == 0
+    assert float(output.split()[-1].replace('D', 'E')) == float(expected)
+
