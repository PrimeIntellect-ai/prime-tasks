+def test_min_print_int(language):
+    def min_print(x : 'int[:]'):
+        from numpy import amin
+        print(amin(x))
+
+    f1 = epyccel(min_print, language = language)
+    x = np.array([5, -3, 2, 7], dtype=np.int64)
+    _check_print_reduction(f1, x, x.min())
