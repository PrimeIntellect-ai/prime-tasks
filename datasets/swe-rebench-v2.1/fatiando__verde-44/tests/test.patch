+"""
+Test the Chain class
+"""
+import numpy as np
+import numpy.testing as npt
+
+from ..datasets.synthetic import CheckerBoard
+from ..chain import Chain
+from ..coordinates import grid_coordinates
+from ..scipy_bridge import ScipyGridder
+from ..trend import Trend
+
+
+def test_chain():
+    "Test chaining trend and gridder."
+    region = (1000, 5000, -8000, -7000)
+    synth = CheckerBoard(amplitude=100, w_east=1000, w_north=100)
+    synth.fit(region=region)
+    data = synth.scatter(size=5000, random_state=0)
+    east, north = coords = data.easting, data.northing
+    coefs = [1000, 0.2, -1.4]
+    trend = coefs[0] + coefs[1]*east + coefs[2]*north
+    all_data = trend + data.scalars
+
+    grd = Chain([('trend', Trend(degree=1)),
+                 ('gridder', ScipyGridder())])
+    grd.fit(coords, all_data)
+
+    npt.assert_allclose(grd.predict(coords), all_data)
+    npt.assert_allclose(grd.residual_, 0, atol=1e-5)
+    npt.assert_allclose(grd.named_steps['trend'].coef_, coefs, rtol=1e-2)
+    npt.assert_allclose(grd.named_steps['trend'].predict(coords), trend,
+                        rtol=1e-3)
+    # The residual is too small to test. Need a robust trend probably before
+    # this will work.
+    # npt.assert_allclose(grd.named_steps['gridder'].predict(coords),
+    #                     data.scalars, rtol=5e-2, atol=0.5)
+
+
+def test_chain_steps():
+    "The supplied steps are stored in the public steps attribute."
+    trend = Trend(degree=1)
+    gridder = ScipyGridder()
+    steps = [('trend', trend), ('gridder', gridder)]
+    grd = Chain(steps)
+    assert [name for name, _ in grd.steps] == ['trend', 'gridder']
+    assert grd.steps[0][1] is trend
+    assert grd.steps[1][1] is gridder
+
+
+def test_chain_weights():
+    "Chain.fit should accept an optional weights argument."
+    region = (1000, 5000, -8000, -7000)
+    synth = CheckerBoard(amplitude=100, w_east=1000, w_north=100)
+    synth.fit(region=region)
+    data = synth.scatter(size=5000, random_state=0)
+    east, north = coords = data.easting, data.northing
+    coefs = [1000, 0.2, -1.4]
+    trend = coefs[0] + coefs[1]*east + coefs[2]*north
+    all_data = trend + data.scalars
+    weights = np.ones_like(all_data)
+
+    grd = Chain([('trend', Trend(degree=1)),
+                 ('gridder', ScipyGridder())])
+    grd.fit(coords, all_data, weights)
+
+    npt.assert_allclose(grd.predict(coords), all_data)
+    npt.assert_allclose(grd.residual_, 0, atol=1e-5)
+
+
+def test_chain_grid_sums_predictions():
+    """A chain grid contains predictions from every component."""
+    region = (0, 4, 0, 4)
+    coordinates = grid_coordinates(region, shape=(5, 5))
+    east, north = coordinates
+    data = 3 + east - 2 * north + np.sin(east + north)
+    chain = Chain([('trend', Trend(degree=1)),
+                   ('gridder', ScipyGridder(method='nearest'))])
+    chain.fit(coordinates, data)
+
+    grid = chain.grid(region=region, shape=(5, 5))
+    expected = chain.predict(coordinates)
+    npt.assert_allclose(grid.scalars, expected)
