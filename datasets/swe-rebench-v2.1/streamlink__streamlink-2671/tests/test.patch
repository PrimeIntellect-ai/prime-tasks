+import json
+
+import requests_mock
+
+from streamlink import Streamlink
+
+
+class TestPluginVlive:
+    def test_live_broadcast_provides_streams(self):
+        url = "https://www.vlive.tv/video/156824"
+        playlist_url = "https://cdn.vlive.tv/live/master.m3u8"
+        live_stream_info = {
+            "resolutions": [
+                {"name": "720p", "cdnUrl": playlist_url},
+            ],
+        }
+        video_status = {
+            "viewType": "live",
+            "liveStreamInfo": json.dumps(live_stream_info),
+        }
+        init_page = "oVideoStatus = {}<".format(json.dumps(video_status))
+        playlist = """#EXTM3U
+#EXT-X-STREAM-INF:PROGRAM-ID=1,BANDWIDTH=1280000,RESOLUTION=1280x720
+https://cdn.vlive.tv/live/720p.m3u8
+"""
+
+        session = Streamlink()
+        with requests_mock.Mocker() as mock:
+            # The site may expose initialization data at different endpoints.
+            mock.get(requests_mock.ANY, text=init_page)
+            mock.get(playlist_url, text=playlist)
+
+            plugin = session.resolve_url(url)
+            streams = plugin.streams()
+
+        assert streams
+        assert all(callable(stream.open) for stream in streams.values())
