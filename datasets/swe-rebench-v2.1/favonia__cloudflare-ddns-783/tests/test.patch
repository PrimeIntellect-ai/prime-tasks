+func TestSetCreateRecordWithEmptyComment(t *testing.T) {
+	t.Parallel()
+
+	const target = domain.FQDN("sub.test.org")
+	ctx := context.Background()
+	mockCtrl := gomock.NewController(t)
+	mockPP := mocks.NewMockPP(mockCtrl)
+	mockHandle := mocks.NewMockHandle(mockCtrl)
+	ip := netip.MustParseAddr("::1")
+
+	gomock.InOrder(
+		mockHandle.EXPECT().ListRecords(ctx, mockPP, target, ipnet.IP6).Return(map[string]netip.Addr{}, true, true),
+		mockHandle.EXPECT().CreateRecord(ctx, mockPP, target, ipnet.IP6, ip, api.TTLAuto, false, "").Return("created-record", true),
+		mockPP.EXPECT().Noticef(pp.EmojiCreateRecord, "Added a new %s record of %q (ID: %q)", "AAAA", "sub.test.org", "created-record"),
+	)
+
+	s, ok := setter.New(mockPP, mockHandle)
+	require.True(t, ok)
+	require.Equal(t, setter.ResponseUpdated, s.Set(ctx, mockPP, target, ipnet.IP6, ip, api.TTLAuto, false, ""))
+}
