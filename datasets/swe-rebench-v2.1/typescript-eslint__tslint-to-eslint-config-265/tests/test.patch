+
+describe("CLI compatibility", () => {
+    it("completes a migration without Array.prototype.flat", async () => {
+        // Arrange
+        const projectDirectory = mkdtempSync(join(tmpdir(), "tslint-to-eslint-config-"));
+        writeFileSync(join(projectDirectory, "package.json"), "{}\n");
+        writeFileSync(
+            join(projectDirectory, "tsconfig.json"),
+            JSON.stringify({
+                compilerOptions: { target: "es5" },
+                files: [],
+            }),
+        );
+        writeFileSync(join(projectDirectory, "tslint.json"), JSON.stringify({ rules: {} }));
+        const originalDirectory = process.cwd();
+        const originalExitCode = process.exitCode;
+        const flatDescriptor = Object.getOwnPropertyDescriptor(Array.prototype, "flat");
+
+        try {
+            process.chdir(projectDirectory);
+            process.exitCode = 0;
+            Object.defineProperty(Array.prototype, "flat", {
+                configurable: true,
+                value: undefined,
+            });
+
+            // Act
+            await main(["node", "tslint-to-eslint-config"]);
+
+            // Assert
+            expect(process.exitCode).toBe(0);
+        } finally {
+            process.chdir(originalDirectory);
+            if (flatDescriptor) {
+                Object.defineProperty(Array.prototype, "flat", flatDescriptor);
+            } else {
+                delete (Array.prototype as any).flat;
+            }
+            process.exitCode = originalExitCode;
+            for (const file of readdirSync(projectDirectory)) {
+                unlinkSync(join(projectDirectory, file));
+            }
+            rmdirSync(projectDirectory);
+        }
+    });
+});
