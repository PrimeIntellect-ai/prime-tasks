diff --git a/test/runtests.jl b/test/runtests.jl
index 24675d9..e92ad90 100644
--- a/test/runtests.jl
+++ b/test/runtests.jl
@@ -724,9 +724,24 @@ end
             end
         end
         # assignment
+        # Regular line continuation of newlines between `=` and rhs
         for op in ("=", "+=")
             @test format_string("a $(op)\n$(sp)b") == "a $(op)\n    b"
+            @test endswith(format_string("a $(op)\n# comment\n$(sp)b"), "    b")
         end
+        @test format_string("f(a) =\nb") == "f(a) =\n    b"
+        # A block-like RHS keeps its body and branches nested, regardless of outer alignment.
+        lines = split(format_string("a =\nif x\n    1\nelse\n    2\nend"), '\n')
+        indentation = line -> length(line) - length(lstrip(line))
+        if_line = only(filter(line -> occursin("if x", line), lines))
+        body_line = only(filter(line -> strip(line) == "1", lines))
+        else_line = only(filter(line -> strip(line) == "else", lines))
+        other_body_line = only(filter(line -> strip(line) == "2", lines))
+        end_line = only(filter(line -> strip(line) == "end", lines))
+        @test indentation(body_line) > indentation(if_line)
+        @test indentation(other_body_line) > indentation(if_line)
+        @test indentation(else_line) == indentation(if_line)
+        @test indentation(end_line) == indentation(if_line)
         # using/import
         for verb in ("using", "import")
             @test format_string("$(verb) A,\n$(sp)B") == "$(verb) A,\n    B"
