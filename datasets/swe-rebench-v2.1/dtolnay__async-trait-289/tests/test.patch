+// https://github.com/dtolnay/async-trait/issues/288
+pub mod issue288 {
+    use async_trait::async_trait;
+
+    #[async_trait]
+    pub trait Trait {
+        async fn f<#[cfg(any())] T: Send>(#[cfg(any())] t: T) -> u8;
+        async fn g<#[cfg(all())] T: Send>(#[cfg(all())] t: T) -> u8;
+        async fn h<#[cfg(any())] 'a>(#[cfg(any())] t: &'a str) -> u8;
+        async fn i<#[cfg(all())] 'a>(#[cfg(all())] t: &'a str) -> u8;
+    }
+
+    pub struct Struct;
+
+    #[async_trait]
+    impl Trait for Struct {
+        async fn f<#[cfg(any())] T: Send>(#[cfg(any())] t: T) -> u8 {
+            1
+        }
+        async fn g<#[cfg(all())] T: Send>(#[cfg(all())] t: T) -> u8 {
+            let _ = t;
+            2
+        }
+        async fn h<#[cfg(any())] 'a>(#[cfg(any())] t: &'a str) -> u8 {
+            3
+        }
+        async fn i<#[cfg(all())] 'a>(#[cfg(all())] t: &'a str) -> u8 {
+            let _ = t;
+            4
+        }
+    }
+
+    #[test]
+    fn cfg_generic_parameters() {
+        use crate::executor::block_on_simple;
+
+        assert_eq!(block_on_simple(<Struct as Trait>::f()), 1);
+        assert_eq!(block_on_simple(<Struct as Trait>::g(String::from("generic"))), 2);
+        assert_eq!(block_on_simple(<Struct as Trait>::h()), 3);
+        assert_eq!(block_on_simple(<Struct as Trait>::i("lifetime")), 4);
+    }
+}
