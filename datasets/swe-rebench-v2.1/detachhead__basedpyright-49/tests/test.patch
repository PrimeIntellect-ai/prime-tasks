@@ -6,6 +6,12 @@
 
 import * as assert from 'assert';
 
+import { ConfigOptions } from '../common/configOptions';
+import { NullConsole } from '../common/console';
+import { NoAccessHost } from '../common/host';
+import { createServiceProvider } from '../common/serviceProviderExtensions';
+import { Uri } from '../common/uri/uri';
+import { TestFileSystem } from './harness/vfs/filesystem';
 import * as core from '../common/core';
 import * as utils from '../common/stringUtils';
 
@@ -61,3 +67,29 @@ test('CoreCompareStringsCaseInsensitive4', () => {
 test('CoreCompareStringsCaseSensitive', () => {
     assert.equal(utils.compareStringsCaseSensitive('Hello', 'hello'), core.Comparison.LessThan);
 });
+
+test('typeCheckingMode "all" enables rules that "strict" leaves disabled', () => {
+    const all = ConfigOptions.getDiagnosticRuleSet('all');
+    const strict = ConfigOptions.getDiagnosticRuleSet('strict');
+    const strictDisabledRules = Object.keys(strict).filter((rule) => strict[rule as keyof typeof strict] === 'none');
+
+    // Every diagnostic disabled by "strict" is enabled by "all"; the level need not be a particular severity.
+    assert.ok(strictDisabledRules.length > 0);
+    strictDisabledRules.forEach((rule) => assert.notEqual(all[rule as keyof typeof all], 'none'));
+});
+
+test('configuration accepts typeCheckingMode "all"', () => {
+    const configOptions = new ConfigOptions(Uri.file(process.cwd()));
+    const serviceProvider = createServiceProvider(new TestFileSystem(/* ignoreCase */ false), new NullConsole());
+
+    configOptions.initializeFromJson({ typeCheckingMode: 'all' }, undefined, serviceProvider, new NoAccessHost());
+
+    assert.strictEqual(configOptions.typeCheckingMode, 'all');
+});
+
+test('typeCheckingMode "off" disables invalid type forms and missing imports', () => {
+    const off = ConfigOptions.getDiagnosticRuleSet('off');
+
+    assert.strictEqual(off.reportInvalidTypeForm, 'none');
+    assert.strictEqual(off.reportMissingImports, 'none');
+});
