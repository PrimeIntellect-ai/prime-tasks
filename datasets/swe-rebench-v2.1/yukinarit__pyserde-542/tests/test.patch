+
+def test_flatten_optional() -> None:
+    @serde
+    class Bar:
+        c: int
+        d: int
+
+    @serde
+    class Foo:
+        a: Optional[int]
+        bar: Optional[Bar] = field(flatten=True)
+
+    assert from_dict(Foo, {"a": 123, "c": 69, "d": 420}) == Foo(
+        a=123, bar=Bar(c=69, d=420)
+    )
