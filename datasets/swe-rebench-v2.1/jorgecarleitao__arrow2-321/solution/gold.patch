+
+/// Exports a [`Field`] to the C data interface.
+/// # Safety
+/// The pointer must be allocated and valid
+pub unsafe fn export_field_to_c(field: &Field, ptr: *mut Ffi_ArrowSchema) {
+    *ptr = Ffi_ArrowSchema::new(field)
