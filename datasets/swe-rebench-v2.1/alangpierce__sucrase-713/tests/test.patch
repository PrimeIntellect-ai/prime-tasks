+function assertTypeScriptESMResultIgnoringNamedImportFormatting(code: string, expectedResult: string): void {
+  const normalize = (output: string): string =>
+    output.replace(/(import\s+[^;\n]*\{)([^}\n]*)(\})/g, (_match, prefix, specifiers, suffix) => {
+      const normalizedSpecifiers = specifiers
+        .split(",")
+        .map((specifier: string) => specifier.trim())
+        .filter(Boolean)
+        .join(",");
+      return `${prefix}${normalizedSpecifiers}${suffix}`;
+    });
+  const result = transform(code, {transforms: ["jsx", "typescript"]}).code;
+  assert.strictEqual(normalize(result), normalize(expectedResult));
+}
