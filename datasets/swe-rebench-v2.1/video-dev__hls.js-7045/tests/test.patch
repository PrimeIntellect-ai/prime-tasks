diff --git a/tests/unit/utils/safe-json-stringify.js b/tests/unit/utils/safe-json-stringify.js
index 1d06988b..c2ca5b97 100644
--- a/tests/unit/utils/safe-json-stringify.js
+++ b/tests/unit/utils/safe-json-stringify.js
@@ -1,3 +1,4 @@
+import Hls from '../../../src/hls';
 import { stringify } from '../../../src/utils/safe-json-stringify';
 
 describe('Stringify', function () {
@@ -11,4 +12,109 @@ describe('Stringify', function () {
 
     expect(stringified).to.equal(JSON.stringify(originalObject));
   });
+
+  it('should omit an indirect cycle when no replacer is supplied', function () {
+    const circularObject = { value: 'kept', child: {} };
+    circularObject.child.parent = circularObject;
+
+    const stringified = stringify(circularObject);
+
+    expect(JSON.parse(stringified)).to.deep.equal({
+      value: 'kept',
+      child: {},
+    });
+  });
+
+  it('should stringify primitive values', function () {
+    expect(stringify(42)).to.equal('42');
+    expect(stringify('hello')).to.equal('"hello"');
+    expect(stringify(true)).to.equal('true');
+    expect(stringify(null)).to.equal('null');
+  });
+
+  it('should stringify array values', function () {
+    expect(stringify([1, 2, 3])).to.equal(JSON.stringify([1, 2, 3]));
+    expect(stringify(['a', { b: 'c' }])).to.equal(
+      JSON.stringify(['a', { b: 'c' }]),
+    );
+  });
+
+  it('should use the optional custom replacer', function () {
+    const stringified = stringify(
+      {
+        a: '1',
+        b: { c: 2 },
+      },
+      (k, v) => (k === 'b' ? '2' : v),
+    );
+
+    expect(stringified).to.equal(
+      JSON.stringify({
+        a: '1',
+        b: '2',
+      }),
+    );
+  });
+
+  it('uses replacer transformations that remove circular references', function () {
+    const originalObject = { a: 'test' };
+
+    const circularObject = { ...originalObject };
+    circularObject.b = circularObject;
+
+    const stringified = stringify(circularObject, (k, v) =>
+      k === 'b' ? 'replaced' : v,
+    );
+
+    expect(stringified).to.equal(
+      JSON.stringify({
+        a: 'test',
+        b: 'replaced',
+      }),
+    );
+  });
+
+  it('does not throw while logging a config value with an external cycle', function () {
+    const externalValue = {};
+    externalValue.self = externalValue;
+    const warnings = [];
+    const originalWarn = console.warn;
+    let hls;
+    console.warn = (message) => warnings.push(message);
+
+    try {
+      expect(() => {
+        hls = new Hls({ debug: true, fragLoadingTimeOut: externalValue });
+      }).not.to.throw();
+    } finally {
+      console.warn = originalWarn;
+    }
+
+    hls.destroy();
+  });
+
+  it('cyclical references added by the custom replacer are removed', function () {
+    const originalObject = { a: 'test' };
+
+    const circularObject = { ...originalObject };
+    circularObject.b = {};
+    circularObject.d = 'replace-with-circular-object';
+
+    const stringified = stringify(circularObject, (k, v) => {
+      if (k === 'b') {
+        v.b = circularObject;
+        v.c = 'test';
+      } else if (v === 'replace-with-circular-object') {
+        v = circularObject;
+      }
+      return v;
+    });
+
+    expect(stringified).to.equal(
+      JSON.stringify({
+        a: 'test',
+        b: { c: 'test' },
+      }),
+    );
+  });
 });
