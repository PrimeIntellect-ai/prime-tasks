index 00000000..8c4b6add
--- /dev/null
+++ b/borsh/tests/test_macro_namespace_collisions.rs
@@ -0,0 +1,16 @@
+// Borsh macros should not collide with the local modules:
+// https://github.com/near/borsh-rs/issues/11
+mod core {}
+
+use borsh::{BorshDeserialize, BorshSerialize};
+
+#[derive(BorshSerialize, BorshDeserialize, PartialEq, Debug)]
+struct A(u8);
+
+#[test]
+fn derives_work_with_a_local_core_module() {
+    let value = A(42);
+    let bytes = value.try_to_vec().unwrap();
+    let decoded = A::try_from_slice(&bytes).unwrap();
+    assert_eq!(decoded, value);
+}
