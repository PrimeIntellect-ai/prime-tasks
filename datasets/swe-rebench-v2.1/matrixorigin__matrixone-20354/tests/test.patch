+// The Attrs slice of a table function is shared by every parallel instance of
+// the operator in a plan. Preparing those instances concurrently must not write
+// to the shared slice; otherwise the race detector reports a data race.
+func TestFullTextTokenizePrepareConcurrent(t *testing.T) {
+	attrs := []string{"DOC_ID", "POS", "WORD"}
+	args := makeConstInputExprsFTT()
+
+	const n = 16
+	var wg sync.WaitGroup
+	errs := make(chan error, n)
+	start := make(chan struct{})
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			proc := testutil.NewProcessWithMPool("", mpool.MustNewZero())
+			tf := &TableFunction{
+				Attrs:    attrs,
+				Args:     args,
+				FuncName: "fulltext_index_tokenize",
+				OperatorBase: vm.OperatorBase{
+					OperatorInfo: vm.OperatorInfo{Idx: 0},
+				},
+			}
+			<-start
+			if err := tf.Prepare(proc); err != nil {
+				errs <- err
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		require.NoError(t, err)
+	}
+}
