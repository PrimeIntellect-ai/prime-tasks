+
+func TestIssue2767DynamicRouteParams(t *testing.T) {
+	router := New()
+	router.GET("/aa/*xx", func(c *Context) { c.String(http.StatusOK, "/aa/*xx") })
+	router.GET("/ab/*xx", func(c *Context) { c.String(http.StatusOK, "/ab/*xx") })
+	router.GET("/:cc", func(c *Context) { c.String(http.StatusOK, "/:cc:"+c.Param("cc")) })
+	router.GET("/:cc/cc", func(c *Context) { c.String(http.StatusOK, "/:cc/cc:"+c.Param("cc")) })
+
+	for _, tc := range []struct {
+		path string
+		body string
+	}{
+		{path: "/all", body: "/:cc:ll"},
+		{path: "/all/cc", body: "/:cc/cc:ll"},
+		{path: "/a/cc", body: "/:cc/cc:"},
+	} {
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, httptest.NewRequest(http.MethodGet, tc.path, nil))
+		assert.Equal(t, http.StatusOK, w.Code)
+		assert.Equal(t, tc.body, w.Body.String())
+	}
+}
