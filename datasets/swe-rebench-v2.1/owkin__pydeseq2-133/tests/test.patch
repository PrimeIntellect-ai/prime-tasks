+def test_irls_solver_rank_deficient_design():
+    """A rank-deficient design still yields finite coefficients from irls_solver."""
+    counts = np.array([10.0, 20.0, 30.0, 40.0])
+    size_factors = np.array([1.0, 1.0, 1.0, 1.0])
+    # The second column is a multiple of the first, so the design is rank-deficient.
+    design_matrix = np.array([[1.0, 2.0]] * 4)
+
+    beta, mu, H, converged = irls_solver(
+        counts, size_factors, design_matrix, disp=0.1
+    )
+
+    beta = np.asarray(beta)
+    assert beta.size == design_matrix.shape[1]
+    assert np.isfinite(beta).all()
+
