+    assert mi.type_info(typ) == mi.IntType()
+
+    class Test(msgspec.Struct):
+        a: Annotated[int, {"unhashable": "metadata"}]
+
+    sol = mi.StructType(
+        cls=Test,
+        fields=(mi.Field(name="a", encode_name="a", type=mi.IntType()),),
+    )
+    assert mi.type_info(Test) == sol
