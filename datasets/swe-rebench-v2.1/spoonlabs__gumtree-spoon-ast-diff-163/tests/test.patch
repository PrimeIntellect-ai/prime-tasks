+	@Test
+	public void testGettingChildrenOfCtVirtualElement() {
+		String c1 = "class Test { }";
+		String c2 = "public abstract final class Test { }";
+
+		Diff editScript = new AstComparator().compare(c1, c2);
+
+		CtVirtualElement srcNode = (CtVirtualElement) editScript.getRootOperations().get(0).getSrcNode();
+		Set<?> modifiers = new HashSet<>(srcNode.getChildren());
+
+		Set<ModifierKind> expectedModifiers = new HashSet<>();
+		expectedModifiers.add(ModifierKind.PUBLIC);
+		expectedModifiers.add(ModifierKind.ABSTRACT);
+		expectedModifiers.add(ModifierKind.FINAL);
+
+
+		assertEquals(3, modifiers.size());
+		assertTrue(modifiers.containsAll(expectedModifiers));
+	}
+
+	@Test
+	public void testGettingNonModifierChildrenOfCtVirtualElement() {
+		String c1 = "class Test { }";
+		String c2 = "public class Test { }";
+		Diff editScript = new AstComparator().compare(c1, c2);
+		CtVirtualElement parent = (CtVirtualElement) editScript.getRootOperations().get(0).getSrcNode();
+
+		Set<?> expectedChildren = new HashSet<>(Arrays.asList("ordinary child", ModifierKind.PUBLIC));
+		CtVirtualElement virtualElement = new CtVirtualElement("mixed children", parent,
+				Arrays.asList("ordinary child", ModifierKind.PUBLIC));
+
+		assertEquals(expectedChildren, new HashSet<>(virtualElement.getChildren()));
+	}
+
+	@Test
+	public void testChildrenOfCtVirtualElementAreUnmodifiable() {
+		String c1 = "class Test { }";
+		String c2 = "public class Test { }";
+		Diff editScript = new AstComparator().compare(c1, c2);
+		CtVirtualElement virtualElement = (CtVirtualElement) editScript.getRootOperations().get(0).getSrcNode();
+
+		assertThrows(UnsupportedOperationException.class, () -> virtualElement.getChildren().clear());
+	}
