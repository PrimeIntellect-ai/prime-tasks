+package cmd
+
+import (
+	"bytes"
+	"net"
+	"strings"
+	"testing"
+
+	"github.com/bpicode/fritzctl/config"
+	"github.com/bpicode/fritzctl/mock"
+	"github.com/stretchr/testify/assert"
+)
+
+// TestParseTemperature tests the user-supplied temperature interpretation.
+func TestParseTemperature(t *testing.T) {
+	assertions := assert.New(t)
+
+	twelve, err := parseTemperature("12")
+	assertions.NoError(err)
+	assertions.Equal(float64(12), twelve)
+
+	on, err := parseTemperature("on")
+	assertions.NoError(err)
+	assertions.Equal(float64(127), on)
+
+	off, err := parseTemperature("off")
+	assertions.NoError(err)
+	assertions.Equal(float64(126.5), off)
+}
+
+// TestParseTemperatureCaseInsensitive verifies that the on/off keywords are
+// recognized regardless of letter case.
+func TestParseTemperatureCaseInsensitive(t *testing.T) {
+	assertions := assert.New(t)
+
+	for _, s := range []string{"ON", "On", "oN"} {
+		on, err := parseTemperature(s)
+		assertions.NoError(err, "input %q", s)
+		assertions.Equal(float64(127), on, "input %q", s)
+	}
+
+	for _, s := range []string{"OFF", "Off", "oFf"} {
+		off, err := parseTemperature(s)
+		assertions.NoError(err, "input %q", s)
+		assertions.Equal(float64(126.5), off, "input %q", s)
+	}
+}
+
+// TestParseTemperatureInvalid verifies that strings which are neither a valid
+// number nor a recognized keyword produce an error.
+func TestParseTemperatureInvalid(t *testing.T) {
+	assertions := assert.New(t)
+
+	for _, s := range []string{"", "abc", "12abc", "onoff", "twenty"} {
+		_, err := parseTemperature(s)
+		assertions.Error(err, "input %q", s)
+	}
+}
+
+// TestTemperatureCommandAcceptsOnOff verifies that control values are accepted
+// by the command path and reach the thermostat operation.
+func TestTemperatureCommandAcceptsOnOff(t *testing.T) {
+	config.Dir = "../testdata/config"
+	config.Filename = "config_localhost_https_test.json"
+
+	srv := mock.New().UnstartedServer()
+	listener, err := net.Listen("tcp", ":61666")
+	if !assert.NoError(t, err) {
+		return
+	}
+	srv.Listener = listener
+	srv.Start()
+	defer srv.Close()
+
+	for _, value := range []string{"on", "off"} {
+		t.Run(value, func(t *testing.T) {
+			assert.NoError(t, temperatureCmd.RunE(temperatureCmd, []string{value, "HKR_1"}))
+		})
+	}
+}
+
+// TestTemperatureHelpExplainsControlValues ensures the user-facing help
+// identifies the on/off alternatives alongside the temperature argument.
+func TestTemperatureHelpExplainsControlValues(t *testing.T) {
+	var output bytes.Buffer
+	previousOutput := temperatureCmd.OutOrStdout()
+	temperatureCmd.SetOutput(&output)
+	defer temperatureCmd.SetOutput(previousOutput)
+
+	if !assert.NoError(t, temperatureCmd.Help()) {
+		return
+	}
+	help := strings.ToLower(output.String())
+	assert.Contains(t, help, "temperature")
+	assert.Contains(t, help, "on")
+	assert.Contains(t, help, "off")
+}
