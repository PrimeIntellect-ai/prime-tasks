diff --git a/tests/test-cases/include-component/integration.include-component.test.ts b/tests/test-cases/include-component/integration.include-component.test.ts
new file mode 100644
index 0000000..638d5fb
--- /dev/null
+++ b/tests/test-cases/include-component/integration.include-component.test.ts
@@ -0,0 +1,126 @@
+import {WriteStreamsMock} from "../../../src/write-streams";
+import {handler} from "../../../src/handler";
+import fs from "fs-extra";
+import yaml from "js-yaml";
+import {initBashSpy, initSpawnSpy} from "../../mocks/utils.mock";
+import {WhenStatics} from "../../mocks/when-statics";
+
+const componentCwd = "tests/test-cases/include-component/component";
+const stateDir = ".gitlab-ci-local";
+const cacheDir = `${componentCwd}/${stateDir}/includes/gitlab.com/components/go/0.3.1/templates`;
+
+const fullPipeline = `spec:
+  inputs:
+    stage_format:
+      default: 'format'
+    stage_build:
+      default: 'build'
+    stage_test:
+      default: 'test'
+    go_version:
+      default: 'latest'
+    binary_directory:
+      default: 'mybinaries'
+---
+
+include:
+  - local: '/templates/format.yml'
+    inputs:
+      stage: $[[ inputs.stage_format ]]
+      go_version: $[[ inputs.go_version]]
+  - local: '/templates/build.yml'
+    inputs:
+      stage: $[[ inputs.stage_build ]]
+      go_version: $[[ inputs.go_version]]
+      binary_directory: $[[ inputs.binary_directory ]]
+  - local: '/templates/test.yml'
+    inputs:
+      stage: $[[ inputs.stage_test ]]
+      go_version: $[[ inputs.go_version]]
+`;
+
+const formatYml = `spec:
+  inputs:
+    stage:
+      default: 'format'
+    go_version:
+      default: 'latest'
+---
+
+"format-$[[ inputs.go_version ]]":
+  image: golang:$[[ inputs.go_version ]]
+  stage: $[[ inputs.stage ]]
+  script:
+    - go fmt $(go list ./... | grep -v /vendor/)
+    - go vet $(go list ./... | grep -v /vendor/)
+`;
+
+const buildYml = `spec:
+  inputs:
+    stage:
+      default: 'build'
+    go_version:
+      default: 'latest'
+    binary_directory:
+      default: 'mybinaries'
+---
+
+"build-$[[ inputs.go_version ]]":
+  image: golang:$[[ inputs.go_version ]]
+  stage: $[[ inputs.stage ]]
+  script:
+    - mkdir -p $[[ inputs.binary_directory ]]
+    - go build -o $[[ inputs.binary_directory ]] ./...
+  artifacts:
+    paths:
+      - $[[ inputs.binary_directory ]]
+`;
+
+const testYml = `spec:
+  inputs:
+    stage:
+      default: 'test'
+    go_version:
+      default: 'latest'
+---
+
+"test-$[[ inputs.go_version ]]":
+  image: golang:$[[ inputs.go_version ]]
+  stage: $[[ inputs.stage ]]
+  script:
+    - go test -race $(go list ./... | grep -v /vendor/)
+`;
+
+const sshRemote = {
+    cmdArgs: ["git", "remote", "-v"],
+    returnValue: {stdout: "origin\tgit@gitlab.com:components/go.git (fetch)\norigin\tgit@gitlab.com:components/go.git (push)\n"},
+};
+
+test("include-component component", async () => {
+    await fs.remove(`${componentCwd}/${stateDir}`);
+    await fs.outputFile(`${cacheDir}/full-pipeline.yml`, fullPipeline);
+    await fs.outputFile(`${cacheDir}/format.yml`, formatYml);
+    await fs.outputFile(`${cacheDir}/build.yml`, buildYml);
+    await fs.outputFile(`${cacheDir}/test.yml`, testYml);
+
+    initBashSpy([
+        {
+            cmd: `git archive --remote=ssh://git@gitlab.com/components/go.git 0.3.1 templates/full-pipeline.yml > /dev/null`,
+            returnValue: {output: ""},
+        },
+    ]);
+    initSpawnSpy([...WhenStatics.all, sshRemote]);
+
+    const writeStreams = new WriteStreamsMock();
+    await handler({
+        cwd: componentCwd,
+        preview: true,
+    }, writeStreams);
+
+    const pipeline = yaml.load(writeStreams.stdoutLines[0]) as Record<string, unknown>;
+    expect(Object.keys(pipeline)).toEqual(expect.arrayContaining([
+        "format-latest",
+        "build-latest",
+        "test-latest",
+    ]));
+});
