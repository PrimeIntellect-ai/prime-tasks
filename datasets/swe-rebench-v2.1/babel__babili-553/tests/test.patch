     expect(transform(source)).toBe(expected);
   });
+
+  it("should remove unnecessary use strict directives", () => {
+    const source = unpad(`
+      function foo() {
+        "use strict";
+        function bar() {
+          "use strict";
+          bar();
+        }
+        bar.call();
+      }
+    `);
+    const output = transform(source);
+    expect(output).toMatch(/function foo\(\)\s*\{\s*["']use strict["']\s*;?/);
+    const child = output.match(/function bar\(\)\s*\{([^}]*)\}/);
+    expect(child).not.toBeNull();
+    expect(child[1]).not.toMatch(/["']use strict["']/);
+  });
+
+  it("should preserve a child use strict directive without a strict parent", () => {
+    const source = unpad(`
+      function foo() {
+        function bar() {
+          "use strict";
+          bar();
+        }
+        bar();
+      }
+    `);
+    const output = transform(source);
+    expect(output).toMatch(/function bar\(\)\s*\{\s*["']use strict["']\s*;?/);
+  });
 });
