+#[test]
+fn omitted_structure_footprint_is_inferred() {
+    // A structure that does not specify `footprint` at all.
+    let manifest_json = r#"
+    {
+        "structure_types": {
+            "hatchery": {
+                "kind": { "Crafting": { "starting_recipe": "hatch_ants" } },
+                "construction_strategy": {
+                    "Direct": {
+                        "work": 5.0,
+                        "materials": {},
+                        "allowed_terrain_types": ["loam", "muddy", "rocky"]
+                    }
+                },
+                "max_workers": 6
+            }
+        }
+    }
+    "#;
+
+    let raw_structure_manifest: RawStructureManifest = serde_json::from_str(manifest_json).unwrap();
+    let structure_data: StructureData = raw_structure_manifest.structure_types["hatchery"]
+        .clone()
+        .into();
+
+    // The omitted footprint should be inferred to be a single tile.
+    assert_eq!(structure_data.footprint, Footprint::single());
+}
