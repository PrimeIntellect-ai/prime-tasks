+#[test]
+fn omitted_recipe_conditions_are_inferred() {
+    // A recipe that does not specify `conditions` at all.
+    let manifest_json = r#"
+    {
+        "recipes": {
+            "leuco_chunk_production": {
+                "inputs": { "acacia_leaf": 1 },
+                "outputs": { "leuco_chunk": 1.0 },
+                "craft_time": 2.0
+            }
+        }
+    }
+    "#;
+
+    let raw_recipe_manifest: RawRecipeManifest = serde_json::from_str(manifest_json).unwrap();
+    let recipe_data: RecipeData = raw_recipe_manifest.recipes["leuco_chunk_production"]
+        .clone()
+        .into();
+
+    // The omitted conditions should be inferred to be the sensible default:
+    // no workers required and no light restrictions.
+    assert_eq!(
+        recipe_data.conditions,
+        RecipeConditions {
+            workers_required: 0,
+            allowable_light_range: None,
+        }
+    );
+}
