+def test_log_event_with_non_serializable_metadata():
+    """
+    The Langfuse logging path must successfully log data when the metadata
+    contains a non-serializable object such as a thread lock (issue #6314).
+
+    This exercises the actual logging path (not just the metadata helper), so a
+    solution that prepares metadata but never uses it while logging still fails.
+    """
+    mock_generation = Mock()
+    mock_generation.trace_id = "test-trace-id"
+    mock_trace = Mock()
+    mock_trace.generation.return_value = mock_generation
+    mock_langfuse_client = Mock()
+    mock_langfuse_client.trace.return_value = mock_trace
+
+    metadata = {
+        "nested": {"lock": threading.RLock()},
+        "lock": threading.RLock(),
+        "list": [1, 2, {"inner_lock": threading.RLock()}],
+    }
+
+    kwargs = {
+        "model": "gpt-3.5-turbo",
+        "call_type": "completion",
+        "messages": [{"role": "user", "content": "hi"}],
+        "litellm_params": {"metadata": metadata},
+        "optional_params": {},
+        "litellm_call_id": "test-call-id",
+    }
+
+    with patch.object(global_langfuse_logger, "Langfuse", mock_langfuse_client):
+        result = global_langfuse_logger.log_event(
+            kwargs=kwargs,
+            response_obj=None,
+            start_time=datetime.now(),
+            end_time=datetime.now(),
+            user_id="test-user",
+            print_verbose=lambda *args, **kwargs: None,
+        )
+
+    assert result["trace_id"] == "test-trace-id"
