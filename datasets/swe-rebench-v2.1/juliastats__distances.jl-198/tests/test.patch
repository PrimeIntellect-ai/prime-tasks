+@testset "spherical angle" begin
+    @test spherical_angle([-π, 0],    [π,0]) ≈ 0 atol=1e-10
+    @test spherical_angle([0,-π/2], [0,π/2]) ≈ π atol=1e-10
+    @test spherical_angle((-π,0),     (π,0)) ≈ 0 atol=1e-10
+    @test spherical_angle((0,-π/2), (0,π/2)) ≈ π atol=1e-10
+    x, y = rand(2), rand(2)
+    x_deg, y_deg = rad2deg.(x), rad2deg.(y)
+    @test spherical_angle(x, y) ≈ haversine(x_deg, y_deg, 1) atol=1e-10
+    @test spherical_angle(Iterators.take(x, 2), Iterators.take(y, 2)) ≈ haversine(x_deg, y_deg, 1) atol=1e-10
+    @test_throws ArgumentError spherical_angle([0.,-π/2], [0.,π/2, 0.25])
+
+    # The SphericalAngle callable itself must compute the angular separation.
+    @test SphericalAngle()([-π, 0], [π, 0]) ≈ 0 atol=1e-10
+    @test SphericalAngle()([0, -π/2], [0, π/2]) ≈ π atol=1e-10
+    @test SphericalAngle()(x, y) ≈ haversine(x_deg, y_deg, 1) atol=1e-10
+
+    # The SphericalAngle callable itself must validate input lengths.
+    @test_throws ArgumentError SphericalAngle()([0.,-π/2, 0.25], [0.,π/2])
+    @test_throws ArgumentError SphericalAngle()([0.,-π/2], [0.,π/2, 0.25])
+end
