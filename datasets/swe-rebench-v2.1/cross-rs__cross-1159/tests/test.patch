+
+fn virtual_workspace_config() -> Result<
+    (tempfile::TempDir, crate::CargoMetadata),
+    Box<dyn std::error::Error>,
+> {
+    let dir = tempfile::tempdir()?;
+    std::fs::write(
+        dir.path().join("Cargo.toml"),
+        "[workspace]\nmembers = []\n\n[workspace.metadata.cross.build]\nxargo = true\n",
+    )?;
+    let metadata = crate::cargo_metadata_with_args(
+        Some(dir.path()),
+        None,
+        &mut crate::shell::MessageInfo::default(),
+    )?
+    .expect("Cargo should return metadata for the virtual workspace");
+    Ok((dir, metadata))
+}
+
+fn config_value<T: serde::Serialize>(config: &T, path: &str) -> Option<serde_json::Value> {
+    serde_json::to_value(config)
+        .ok()?
+        .pointer(path)
+        .cloned()
+}
+
+#[test]
+fn cross_applies_virtual_workspace_metadata_with_both_config_sources(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let (_dir, metadata) = virtual_workspace_config()?;
+    let global_config = tempfile::NamedTempFile::new()?;
+    std::fs::write(global_config.path(), "[build]\nbuild-std = true\n")?;
+    let previous = std::env::var_os("CROSS_CONFIG");
+    let results = (|| -> Result<_, Box<dyn std::error::Error>> {
+        std::env::remove_var("CROSS_CONFIG");
+        let without_global = crate::toml(&metadata, &mut crate::shell::MessageInfo::default())?;
+        std::env::set_var("CROSS_CONFIG", global_config.path());
+        let with_global = crate::toml(&metadata, &mut crate::shell::MessageInfo::default())?;
+        Ok((without_global, with_global))
+    })();
+    if let Some(value) = previous {
+        std::env::set_var("CROSS_CONFIG", value);
+    } else {
+        std::env::remove_var("CROSS_CONFIG");
+    }
+    let (without_global, with_global) = results?;
+    assert_eq!(
+        config_value(&without_global, "/build/xargo"),
+        Some(serde_json::json!(true)),
+    );
+    assert_eq!(
+        config_value(&with_global, "/build/xargo"),
+        Some(serde_json::json!(true)),
+    );
+    assert_eq!(
+        config_value(&with_global, "/build/build-std"),
+        Some(serde_json::json!(true)),
+    );
+    Ok(())
+}
