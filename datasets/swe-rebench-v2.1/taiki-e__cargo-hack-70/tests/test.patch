+fn each_feature_lists_dependency_feature_scenarios() {
+    // Dependency features are not enumerated unless --include-deps-features is passed.
+    cargo_hack()
+        .args(&["check", "--each-feature"])
+        .test_dir("tests")
+        .assert_success()
+        .assert_stderr_not_contains("--features anyhow/default");
+
+    // --include-deps-features enumerates dependency features as scenarios.
