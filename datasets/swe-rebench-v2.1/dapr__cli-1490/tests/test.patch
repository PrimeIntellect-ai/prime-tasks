+// setSizeField assigns a size value to a RunConfig/SharedRunConfig field
+// regardless of whether the implementation stores it as a string or an int.
+// This keeps the behavioural assertions below independent of the concrete
+// field type while still exercising the public configuration surface.
+func setSizeField(t *testing.T, config interface{}, field, value string) {
+	t.Helper()
+	v := reflect.ValueOf(config).Elem().FieldByName(field)
+	require.True(t, v.IsValid(), "field %s not found", field)
+	switch v.Kind() {
+	case reflect.String:
+		v.SetString(value)
+	case reflect.Int, reflect.Int64:
+		n, err := strconv.Atoi(value)
+		if err != nil {
+			// An int-typed field cannot represent a unit-bearing value.
+			n = 0
+		}
+		v.SetInt(int64(n))
+	default:
+		t.Fatalf("unexpected kind %s for field %s", v.Kind(), field)
+	}
+}
