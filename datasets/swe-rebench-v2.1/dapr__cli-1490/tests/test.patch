+// TestRunFlagsAcceptUnitBearingValues verifies that the `dapr run` CLI accepts
+// unit-bearing values for --max-body-size and --read-buffer-size, e.g.
+// `--max-body-size 4Mi` and `--read-buffer-size 4Ki`. This is the motivating
+// behaviour of the contract: the flags must be parsed as strings, not ints.
+func TestRunFlagsAcceptUnitBearingValues(t *testing.T) {
+	cases := []struct {
+		flag  string
+		value string
+	}{
+		{"max-body-size", "4Mi"},
+		{"max-body-size", "5M"},
+		{"read-buffer-size", "4Ki"},
+	}
+	for _, c := range cases {
+		t.Run(c.flag+"="+c.value, func(t *testing.T) {
+			f := cmd.RunCmd.Flags().Lookup(c.flag)
+			require.NotNil(t, f, "flag --%s must be registered on `dapr run`", c.flag)
+			require.NoError(t, cmd.RunCmd.Flags().Set(c.flag, c.value),
+				"`dapr run --%s %s` must be accepted", c.flag, c.value)
+		})
+	}
 }
