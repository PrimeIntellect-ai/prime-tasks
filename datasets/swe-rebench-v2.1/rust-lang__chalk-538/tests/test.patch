+/// See https://github.com/rust-lang/chalk/issues/515
+#[test]
+fn duplicate_blanket_impls_with_assoc_type_equality_are_rejected() {
+    let program_text = stringify!({
+        trait Iterator { type Item; }
+        trait Trait {}
+
+        struct Foo {}
+
+        impl<T> Trait for T where T: Iterator<Item = u32> {}
+        impl<T> Trait for T where T: Iterator<Item = u32> {}
+    });
+    let db = chalk_integration::db::ChalkDatabase::with(
+        &program_text[1..program_text.len() - 1],
+        chalk_solve::SolverChoice::default(),
+    );
+    assert!(
+        db.checked_program().is_err(),
+        "duplicate impls constrained by an associated type must be rejected",
+    );
+}
