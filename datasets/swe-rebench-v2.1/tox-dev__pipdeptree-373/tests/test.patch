+
+
+def test_invalid_metadata(
+    mocker: MockerFixture, capfd: pytest.CaptureFixture[str], fake_dist_with_invalid_metadata: Path
+) -> None:
+    fake_site_dir = str(fake_dist_with_invalid_metadata.parent)
+    mocked_sys_path = [fake_site_dir]
+    mocker.patch("pipdeptree._discovery.sys.path", mocked_sys_path)
+
+    dists = get_installed_distributions()
+
+    assert len(dists) == 0
+    out, err = capfd.readouterr()
+    expected_warning = (
+        "Warning!!! Missing or invalid metadata found in the following site dirs:\n"
+        f"{fake_site_dir}\n"
+        "------------------------------------------------------------------------\n"
+    )
+    assert err.startswith(expected_warning)
+
+
+def test_invalid_metadata_does_not_hide_valid_metadata(
+    mocker: MockerFixture, capfd: pytest.CaptureFixture[str], tmp_path: Path
+) -> None:
+    fake_site_pkgs = tmp_path / "site-packages"
+    valid_dist = fake_site_pkgs / "bar-2.4.5.dist-info"
+    valid_dist.mkdir(parents=True)
+    (valid_dist / "METADATA").write_text("Metadata-Version: 2.3\nName: bar\nVersion: 2.4.5\n")
+    invalid_dist = fake_site_pkgs / "baz-1.0.0.dist-info"
+    invalid_dist.mkdir(parents=True)
+    (invalid_dist / "METADATA").touch()
+
+    fake_site_dir = str(fake_site_pkgs)
+    mocker.patch("pipdeptree._discovery.sys.path", [fake_site_dir])
+
+    dists = get_installed_distributions()
+
+    assert [dist.metadata["Name"] for dist in dists] == ["bar"]
+    out, err = capfd.readouterr()
+    expected_warning = (
+        "Warning!!! Missing or invalid metadata found in the following site dirs:\n"
+        f"{fake_site_dir}\n"
+        "------------------------------------------------------------------------\n"
+    )
+    assert err.startswith(expected_warning)
