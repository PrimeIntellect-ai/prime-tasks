+/// Custom derive test cases for the `DecodeValue` + `EncodeValue` macro combo.
+mod decode_encode_value {
+    use der::asn1::{BitStringRef, ContextSpecific};
+    use der::{DecodeValue, EncodeValue, IsConstructed, SliceReader, TagNumber};
+    use hex_literal::hex;
+
+    /// Example of a structure, that does not have a tag and is not a sequence
+    /// but can be encoded as `[0] IMPLICIT`
+    #[derive(DecodeValue, EncodeValue, Default, Eq, PartialEq, Debug)]
+    struct DecodeEncodeCheck {
+        field: bool,
+    }
+    impl IsConstructed for DecodeEncodeCheck {
+        const CONSTRUCTED: bool = true;
+    }
+
+    #[test]
+    fn decode_implicit_uses_static_constructed_bit() {
+        // `[0] IMPLICIT` constructed header with a one-byte value.
+        let constructed = hex!("A0 03 01 01 FF");
+        let mut reader = SliceReader::new(&constructed).unwrap();
+        assert!(
+            ContextSpecific::<DecodeEncodeCheck>::decode_implicit(&mut reader, TagNumber(0)).is_ok()
+        );
+
+        // `[0] IMPLICIT` primitive header: rejected because `CONSTRUCTED` is `true`.
+        let primitive = hex!("80 03 01 01 FF");
+        let mut reader = SliceReader::new(&primitive).unwrap();
+        assert!(
+            ContextSpecific::<DecodeEncodeCheck>::decode_implicit(&mut reader, TagNumber(0)).is_err()
+        );
+    }
+
+    #[test]
+    fn decode_implicit_fixed_tag_uses_auto_impl() {
+        // `BitStringRef` is a `FixedTag`, so `IsConstructed` is implemented
+        // automatically with `CONSTRUCTED == false`.
+        let primitive = hex!("80 21 0019BF44096984CDFE8541BAC167DC3B96C85086AA30B6B6CB0C5C38AD703166E1");
+        let mut reader = SliceReader::new(&primitive).unwrap();
+        assert!(
+            ContextSpecific::<BitStringRef<'_>>::decode_implicit(&mut reader, TagNumber(0)).is_ok()
+        );
+
+        // A constructed header is rejected for a primitive `FixedTag` type.
+        let constructed = hex!("A0 21 0019BF44096984CDFE8541BAC167DC3B96C85086AA30B6B6CB0C5C38AD703166E1");
+        let mut reader = SliceReader::new(&constructed).unwrap();
+        assert!(
+            ContextSpecific::<BitStringRef<'_>>::decode_implicit(&mut reader, TagNumber(0)).is_err()
+        );
+    }
+}
