+    @Test
+    public void lineProtocolIsEmptyWhenAllFieldsAreNan() {
+        String lineProtocol = Point
+                .measurement("test")
+                .time(1, TimeUnit.MILLISECONDS)
+                .tag("host", "serverA")
+                .addField("float-nan", Float.NaN)
+                .addField("double-nan", Double.NaN)
+                .build()
+                .lineProtocol(TimeUnit.MILLISECONDS);
+
+        assertThat(lineProtocol).isEmpty();
+    }
+
+    @Test
+    public void lineProtocolSkippingOfNanFields() {
+        String floatLineProtocol = Point
+                .measurement("test")
+                .time(1, TimeUnit.MILLISECONDS)
+                .addField("float-valid", 1f)
+                .addField("float-nan", Float.NaN)
+                .tag("host", "serverA")
+                .build()
+                .lineProtocol(TimeUnit.MILLISECONDS);
+        assertThat(floatLineProtocol).contains("float-valid");
+        assertThat(floatLineProtocol).doesNotContain("float-nan");
+
+        String doubleLineProtocol = Point
+                .measurement("test")
+                .time(1, TimeUnit.MILLISECONDS)
+                .addField("double-valid", 1d)
+                .addField("double-nan", Double.NaN)
+                .tag("host", "serverA")
+                .build()
+                .lineProtocol(TimeUnit.MILLISECONDS);
+        assertThat(doubleLineProtocol).contains("double-valid");
+        assertThat(doubleLineProtocol).doesNotContain("double-nan");
+    }
