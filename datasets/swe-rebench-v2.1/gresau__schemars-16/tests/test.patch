+#[derive(Debug, JsonSchema)]
+struct OptionalFields {
+    value: Option<bool>,
+    text: Option<String>,
+}
+
+#[test]
+fn option_fields_are_optional_when_nullability_is_disabled() -> TestResult {
+    let settings = SchemaSettings::draft07().with(|settings| {
+        settings.option_nullable = false;
+        settings.option_add_null_type = false;
+    });
+    let schema = settings.into_generator().into_root_schema_for::<OptionalFields>();
+    let schema = serde_json::to_value(schema)?;
+
+    let required = schema["required"].as_array();
+    assert!(!required.map_or(false, |names| names.iter().any(|name| name == "value")));
+    assert!(!required.map_or(false, |names| names.iter().any(|name| name == "text")));
+    assert_eq!(schema["properties"]["value"]["type"], "boolean");
+    assert_eq!(schema["properties"]["text"]["type"], "string");
+    Ok(())
+}
