+func TestClientProfileErrorStatus(t *testing.T) {
+	// A registry center that responds with a non-200 status and an error body.
+	errBody := "profile server error"
+	errSvr := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusExpectationFailed)
+		w.Write([]byte(errBody))
+	}))
+	defer errSvr.Close()
+
+	c := NewWorker(errSvr.URL)
+	_, err := c.Profile(ProfileParam{})
+	assert.Error(t, err)
+}
+
+func TestProfileCommandReportsErrorOnCommandLine(t *testing.T) {
+	// Build the goc binary from the repository root.
+	bin := filepath.Join(t.TempDir(), "goc")
+	build := exec.Command("go", "build", "-o", bin, "github.com/qiniu/goc")
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("failed to build goc: %v\n%s", err, out)
+	}
+
+	// A registry center that responds with a non-200 status and an error body.
+	errBody := "profile server error"
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusExpectationFailed)
+		w.Write([]byte(errBody))
+	}))
+	defer ts.Close()
+
+	outputFile := filepath.Join(t.TempDir(), "output.txt")
+	cmd := exec.Command(bin, "profile", "--center="+ts.URL, "--output="+outputFile)
+	out, _ := cmd.CombinedOutput()
+
+	// The failure must be reported on the command line...
+	assert.Contains(t, string(out), errBody)
+
+	// ...and must not be written into the output file.
+	if data, readErr := ioutil.ReadFile(outputFile); readErr == nil {
+		assert.NotContains(t, string(data), errBody)
+	}
+}
