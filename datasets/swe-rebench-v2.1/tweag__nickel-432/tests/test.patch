+#[test]
+fn circular_imports_fail() {
+    let mut prog = Program::new_from_source(
+        BufReader::new(mk_import("cycle.ncl").as_bytes()),
+        "should_fail",
+    )
+    .unwrap();
+    assert_matches!(prog.eval(), Ok(Term::RecRecord(..)) | Ok(Term::Record(..)));
+}
+
+#[test]
+fn circular_imports_evaluate_to_null() {
+    let mut prog = Program::new_from_source(
+        BufReader::new(format!("let x = {} in null", mk_import("cycle.ncl")).as_bytes()),
+        "should_be_null",
+    )
+    .unwrap();
+    assert_eq!(prog.eval(), Ok(Term::Null));
+}
