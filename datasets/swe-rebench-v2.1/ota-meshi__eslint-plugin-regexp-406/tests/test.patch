+describe("no-dupe-disjunctions suggestions", () => {
+    const linter = new Linter()
+    linter.defineRule("no-dupe-disjunctions", rule as any)
+
+    function getMessages(code: string) {
+        return linter.verify(code, {
+            parserOptions: { ecmaVersion: 2020 },
+            rules: { "no-dupe-disjunctions": "error" },
+        })
+    }
+
+    it("offers suggestions for redundant disjunctions without applying them automatically", () => {
+        for (const code of [
+            String(/((?:ab|ba)|(?:ba|ac))/),
+            String(/a+|(?:a|b|c)/),
+            String(/a+|a|b|c/),
+            String(/a|aa|ba/),
+            String(/a|(a|b)a/),
+        ]) {
+            const messages = getMessages(code)
+            assert(messages.some((message) => (message.suggestions?.length ?? 0) > 0))
+            assert(messages.every((message) => !message.fix))
+        }
+    })
+
+    it("includes the required range-removal suggestions", () => {
+        for (const [code, expected] of [
+            [String(/a|[ab]a/), String(/a|[b]a/)],
+            [String(/a+|[a-c]/), String(/a+|[b-c]/)],
+        ]) {
+            const messages = getMessages(code)
+            assert(
+                messages.some((message) =>
+                    message.suggestions?.some((suggestion) => {
+                        const fix = (suggestion as any).fix
+                        return (
+                            code.slice(0, fix.range[0]) +
+                            fix.text +
+                            code.slice(fix.range[1]) ===
+                            expected
+                        )
+                    }),
+                ),
+            )
+            assert(messages.every((message) => !message.fix))
+        }
+    })
+})
