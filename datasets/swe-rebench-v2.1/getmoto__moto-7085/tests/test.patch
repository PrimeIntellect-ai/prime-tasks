+
+
+@mock_dynamodb
+def test_scan_counts_for_large_items():
+    table = _create_user_table()
+
+    payload = "x" * 300_000
+    for i in range(4):
+        table.put_item(Item={"username": f"user{i}", "data": payload})
+
+    unfiltered = table.scan()
+    assert unfiltered["Count"] == unfiltered["ScannedCount"]
+    assert unfiltered["Count"] == len(unfiltered["Items"])
+
+    limited = table.scan(Limit=1)
+    assert limited["Count"] == 1
+    assert limited["ScannedCount"] == 1
+    assert len(limited["Items"]) == 1
