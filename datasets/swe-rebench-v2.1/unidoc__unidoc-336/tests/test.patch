+func TestStyledParagraphRenderingModes(t *testing.T) {
+	fontRegular := newStandard14Font(t, fonts.HelveticaName)
+
+	c := New()
+	c.NewPage()
+
+	p := c.NewStyledParagraph()
+	chunk := p.Append("OCR selectable text")
+	chunk.Style.Font = fontRegular
+	chunk.Style.FontSize = 15
+	field := reflect.ValueOf(&chunk.Style).Elem().FieldByName("RenderingMode")
+	if !field.IsValid() || !field.CanSet() {
+		t.Fatal("text style has no settable RenderingMode field")
+	}
+	field.Set(reflect.ValueOf(3).Convert(field.Type()))
+
+	if err := c.Draw(p); err != nil {
+		t.Fatalf("Error drawing: %v", err)
+	}
+
+	var output bytes.Buffer
+	if err := c.Write(&output); err != nil {
+		t.Fatalf("Error writing PDF: %v", err)
+	}
+
+	reader, err := model.NewPdfReader(bytes.NewReader(output.Bytes()))
+	if err != nil {
+		t.Fatalf("Error reading generated PDF: %v", err)
+	}
+	page, err := reader.GetPage(1)
+	if err != nil {
+		t.Fatalf("Error getting PDF page: %v", err)
+	}
+
+	content, err := page.GetAllContentStreams()
+	if err != nil {
+		t.Fatalf("Error reading page content: %v", err)
+	}
+	operations, err := contentstream.NewContentStreamParser(content).Parse()
+	if err != nil {
+		t.Fatalf("Error parsing page content: %v", err)
+	}
+	renderingMode := float64(0)
+	mode3Text := false
+	for _, operation := range *operations {
+		if operation.Operand == "Tr" && len(operation.Params) == 1 {
+			value, err := core.GetNumberAsFloat(operation.Params[0])
+			if err == nil {
+				renderingMode = value
+			}
+		}
+		if (operation.Operand == "Tj" || operation.Operand == "TJ") && renderingMode == 3 {
+			mode3Text = true
+		}
+	}
+	if !mode3Text {
+		t.Errorf("PDF text is not shown while rendering mode 3 is active")
+	}
+
+	textExtractor, err := extractor.New(page)
+	if err != nil {
+		t.Fatalf("Error creating text extractor: %v", err)
+	}
+	text, err := textExtractor.ExtractText()
+	if err != nil {
+		t.Fatalf("Error extracting PDF text: %v", err)
+	}
+	if !strings.Contains(text, "OCR selectable text") {
+		t.Errorf("mode-3 text was not available for copying; extracted text: %q", text)
+	}
+}
