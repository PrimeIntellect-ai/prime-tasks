+#[tokio::test]
+async fn spin_up_direct_mount_option_serves_host_changes_without_restart() -> Result<()> {
+    use std::process::Stdio;
+    use tokio::time::{sleep, Duration};
+
+    let temp_dir = tempfile::tempdir()?;
+    let root = temp_dir.path();
+    let static_dir = root.join("static/thisshouldbemounted");
+    std::fs::create_dir_all(&static_dir)?;
+    std::fs::write(static_dir.join("1"), "initial")?;
+    std::fs::copy(
+        PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+            .join("../../tests/http/assets-test/spin_static_fs.wasm"),
+        root.join("spin_static_fs.wasm"),
+    )?;
+    std::fs::write(
+        root.join("spin.toml"),
+        r#"
+spin_version = "1"
+name = "direct-mount-cli-test"
+trigger = {type = "http", base = "/"}
+version = "1.0.0"
+
+[[component]]
+id = "fs"
+source = "spin_static_fs.wasm"
+files = [{source = "static/thisshouldbemounted", destination = "/thisshouldbemounted"}]
+
+[component.trigger]
+executor = {type = "spin"}
+route = "/static/..."
+"#,
+    )?;
+
+    let listener = std::net::TcpListener::bind("127.0.0.1:0")?;
+    let address = listener.local_addr()?;
+    drop(listener);
+    let spin = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../target/debug/spin");
+    let flag = spin_up_direct_mount_option()?;
+    let mut child = std::process::Command::new(spin)
+        .current_dir(root)
+        .args(["up", &flag, "--file", "spin.toml", "--listen"])
+        .arg(address.to_string())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()?;
+
+    let result: Result<()> = async {
+        let url = format!("http://{address}/static/thisshouldbemounted/1");
+        let mut response = None;
+        for _ in 0..100 {
+            if child.try_wait()?.is_some() {
+                anyhow::bail!("spin up stopped before the HTTP endpoint became available");
+            }
+            if let Ok(Ok(found)) = tokio::time::timeout(
+                Duration::from_millis(200),
+                reqwest::get(&url),
+            )
+            .await
+            {
+                if found.status().is_success() {
+                    response = Some(found);
+                    break;
+                }
+            }
+            sleep(Duration::from_millis(50)).await;
+        }
+        let response = response.ok_or_else(|| anyhow::anyhow!("HTTP endpoint did not become ready"))?;
+        assert_eq!(response.text().await?, "initial");
+
+        std::fs::write(static_dir.join("2"), "updated")?;
+        let response = reqwest::get(format!("http://{address}/static/thisshouldbemounted/2"))
+            .await?;
+        assert!(response.status().is_success(), "new host-side asset was not served");
+        assert_eq!(response.text().await?, "updated");
+        Ok(())
+    }
+    .await;
+
+    let _ = child.kill();
+    let _ = child.wait();
+    result
+}
