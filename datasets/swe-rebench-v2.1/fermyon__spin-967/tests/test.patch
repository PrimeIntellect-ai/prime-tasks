+#[tokio::test]
+async fn test_direct_mount_uses_source_directory() -> Result<()> {
+    let temp_dir = tempfile::tempdir()?;
+    let root = temp_dir.path();
+
+    std::fs::create_dir(root.join("static"))?;
+    std::fs::write(root.join("static/hello.txt"), "hello")?;
+    std::fs::write(root.join("spin-fs.wasm"), "not actual wasm")?;
+    std::fs::write(
+        root.join("spin.toml"),
+        r#"
+spin_version = "1"
+name = "direct-mount-test"
+trigger = {type = "http", base = "/"}
+version = "1.0.0"
+
+[[component]]
+id = "fs"
+source = "spin-fs.wasm"
+files = [{ source = "static", destination = "/static" }]
+
+[component.trigger]
+executor = {type = "spin"}
+route = "/..."
+"#,
+    )?;
+
+    let manifest = root.join("spin.toml");
+    let app = from_file(&manifest, None::<&Path>, &None).await?;
+
+    let component = &app.components[0];
+    assert_eq!(component.wasm.mounts.len(), 1);
+    let mount = &component.wasm.mounts[0];
+    assert_eq!(mount.guest, "/static");
+
+    // The host directory must be the source directory itself, not a copy.
+    let host = if mount.host.is_absolute() {
+        mount.host.clone()
+    } else {
+        root.join(&mount.host)
+    };
+    assert_eq!(
+        std::fs::canonicalize(&host)?,
+        std::fs::canonicalize(root.join("static"))?
+    );
+
+    // Changes on the host filesystem are immediately visible.
+    std::fs::write(root.join("static/world.txt"), "world")?;
+    assert!(
+        host.join("world.txt").exists(),
+        "expected host-side change to be visible in the mounted directory"
+    );
+
+    Ok(())
+}
 
