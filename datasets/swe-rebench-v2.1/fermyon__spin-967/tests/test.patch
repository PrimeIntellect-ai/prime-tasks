+fn spin_up_direct_mount_option() -> Result<String> {
+    let spin = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../target/debug/spin");
+    let output = std::process::Command::new(&spin)
+        .args(["up", "--help"])
+        .output()?;
+
+    assert!(
+        output.status.success(),
+        "could not retrieve spin up help: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let help = String::from_utf8_lossy(&output.stdout);
+    // Options that `spin up` already had before direct mounting was added.
+    const PRE_EXISTING: &[&str] = &[
+        "bindle",
+        "bindle-password",
+        "bindle-server",
+        "bindle-username",
+        "env",
+        "file",
+        "help",
+        "insecure",
+        "listen",
+        "temp",
+    ];
+    // Any other long option in the help text is the new one; its spelling is not prescribed.
+    let flags: Vec<String> = help
+        .split_whitespace()
+        .filter_map(|tok| tok.strip_prefix("--"))
+        .map(|rest| {
+            rest.chars()
+                .take_while(|c| c.is_ascii_alphanumeric() || *c == '-')
+                .collect::<String>()
+        })
+        .filter(|name| !name.is_empty() && !PRE_EXISTING.contains(&name.as_str()))
+        .collect();
+    match flags.first() {
+        Some(name) => Ok(format!("--{name}")),
+        None => anyhow::bail!("spin up help does not offer a direct-mount option"),
+    }
+}
+
+#[test]
+fn spin_up_exposes_direct_mount_option() -> Result<()> {
+    spin_up_direct_mount_option()?;
+    Ok(())
+}
