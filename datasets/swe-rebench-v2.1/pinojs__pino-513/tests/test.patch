+test('does not override opts with a string as second argument', async ({ same }) => {
+  const tmp = join(
+    os.tmpdir(),
+    '_' + Math.random().toString(36).substr(2, 9)
+  )
+  const instance = pino({
+    timestamp: () => ',"time":"none"'
+  }, tmp)
+  instance.info('hello')
+  await sleep(250)
+  const result = JSON.parse(readFileSync(tmp).toString())
+  same(result, {
+    pid: pid,
+    hostname: hostname,
+    level: 30,
+    time: 'none',
+    msg: 'hello',
+    v: 1
+  })
+})
+
+test('base null suppresses default fields with a string destination', async ({ is }) => {
+  const tmp = join(
+    os.tmpdir(),
+    '_' + Math.random().toString(36).substr(2, 9)
+  )
+  const instance = pino({ base: null }, tmp)
+  instance.info('hello')
+  await sleep(250)
+  const result = JSON.parse(readFileSync(tmp).toString())
+  is(result.pid, undefined)
+  is(result.hostname, undefined)
+})
