+test('creating another logger does not change level labels on an existing logger', async ({ same }) => {
+  const tmp = join(
+    os.tmpdir(),
+    '_' + Math.random().toString(36).substr(2, 9)
+  )
+  const instance = pino({
+    base: null,
+    useLevelLabels: true
+  }, tmp)
+
+  instance.info('before')
+  pino({ useLevelLabels: false })
+  instance.info('after')
+  await sleep(250)
+
+  const results = readFileSync(tmp, 'utf8').trim().split('\n').map(JSON.parse)
+  same(results.map((result) => result.level), ['info', 'info'])
+})
