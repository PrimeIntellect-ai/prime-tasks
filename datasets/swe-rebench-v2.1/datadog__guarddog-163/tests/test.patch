+import json
+
+from click.testing import CliRunner
+
+from guarddog.cli import cli
+from guarddog.scanners.pypi_package_scanner import PypiPackageScanner
+
+
+def test_cli_metadata_only_scan_does_not_fail_source_code_rules(monkeypatch):
+    """A metadata-only package scan should not fail because there are no code rules."""
+    monkeypatch.setattr(
+        PypiPackageScanner,
+        "download_and_get_package_info",
+        lambda self, directory, package_name, version=None: {
+            "info": {"version": "1.0.0", "description": "A package description"},
+            "releases": {},
+        },
+    )
+
+    result = CliRunner().invoke(
+        cli,
+        ["pypi", "scan", "example-package", "--rules", "empty_information", "--output-format", "json"],
+        standalone_mode=False,
+    )
+
+    assert result.exit_code == 0
+    payload = result.return_value if isinstance(result.return_value, str) else result.output
+    scan = json.loads(payload)
+    assert scan["errors"] == {}
