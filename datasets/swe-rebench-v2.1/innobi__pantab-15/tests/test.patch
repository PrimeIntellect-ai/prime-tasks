+def test_frame_to_hyper_default_mode_replaces_table(tmp_hyper):
+    initial = pd.DataFrame({"value": [1]})
+    replacement = pd.DataFrame({"value": [2, 3]})
+
+    pantab.frame_to_hyper(initial, tmp_hyper, table="default_mode")
+    pantab.frame_to_hyper(replacement, tmp_hyper, table="default_mode")
+
+    result = pantab.frame_from_hyper(tmp_hyper, table="default_mode")
+    assert sorted(result["value"]) == sorted(replacement["value"])
+
+
+def test_frames_to_hyper_default_mode_replaces_tables(tmp_hyper):
+    initial = {
+        "first": pd.DataFrame({"value": [1]}),
+        "second": pd.DataFrame({"value": [10, 11]}),
+    }
+    replacement = {
+        "first": pd.DataFrame({"value": [2, 3]}),
+        "second": pd.DataFrame({"value": [12]}),
+    }
+
+    pantab.frames_to_hyper(initial, tmp_hyper)
+    pantab.frames_to_hyper(replacement, tmp_hyper)
+
+    result = pantab.frames_from_hyper(tmp_hyper)
+    assert sorted(result[tab_api.TableName("public", "first")]["value"]) == sorted(
+        replacement["first"]["value"]
+    )
+    assert sorted(result[tab_api.TableName("public", "second")]["value"]) == sorted(
+        replacement["second"]["value"]
+    )
+
+
+def test_frames_to_hyper_accepts_positional_table_mode(tmp_hyper):
+    initial = pd.DataFrame({"value": [1]})
+    appended = pd.DataFrame({"value": [2, 3]})
+
+    pantab.frames_to_hyper({"items": initial}, tmp_hyper)
+    pantab.frames_to_hyper({"items": appended}, tmp_hyper, "a")
+
+    result = pantab.frames_from_hyper(tmp_hyper)
+    assert sorted(result[tab_api.TableName("public", "items")]["value"]) == [1, 2, 3]
+
+
+def test_bad_table_mode_raises(df, tmp_hyper):
+    msg = "'table_mode' must be either 'w' or 'a'"
+    with pytest.raises(ValueError, match=msg):
+        pantab.frame_to_hyper(df, tmp_hyper, table="test", table_mode="x")
+
+    with pytest.raises(ValueError, match=msg):
+        pantab.frames_to_hyper({"a": df}, tmp_hyper, table_mode="x")
+
+
+def test_append_mode_raises_column_mismatch(df, tmp_hyper, table_name):
+    pantab.frame_to_hyper(df, tmp_hyper, table=table_name)
+
+    df = df.drop("object", axis=1)
