diff --git a/graphql/handler/transport/http_post_test.go b/graphql/handler/transport/http_post_test.go
index 28095d85..3a98b7d7 100644
--- a/graphql/handler/transport/http_post_test.go
+++ b/graphql/handler/transport/http_post_test.go
@@ -1,6 +1,7 @@
 package transport_test
 
 import (
+	"bufio"
 	"fmt"
 	"net/http"
 	"net/http/httptest"
@@ -109,8 +110,71 @@ func TestPOST(t *testing.T) {
 		}
 
 		resp := doReq(h, "POST", "/graphql", `{"query":"{ name }"}`)
-		assert.Equal(t, http.StatusBadRequest, resp.Code, resp.Body.String())
-		assert.Equal(t, `{"errors":[{"message":"transport not supported"}],"data":null}`, resp.Body.String())
+		assert.Equal(t, http.StatusOK, resp.Code, resp.Body.String())
+		assert.Equal(t, `{"data":{"name":"test"}}`, resp.Body.String())
+	})
+
+	t.Run("mutation with SSE in Accept", func(t *testing.T) {
+		r := httptest.NewRequest("POST", "/graphql", strings.NewReader(`{"query":"mutation { name }"}`))
+		r.Header.Set("Content-Type", "application/json")
+		r.Header.Set("Accept", "text/event-stream")
+		w := httptest.NewRecorder()
+
+		h.ServeHTTP(w, r)
+
+		assert.Equal(t, http.StatusOK, w.Code, w.Body.String())
+		assert.Equal(t, "application/json", w.Header().Get("Content-Type"))
+		assert.Contains(t, w.Body.String(), "mutations are not supported")
+	})
+
+	t.Run("SSE subscriptions and ordinary POST queries both remain available", func(t *testing.T) {
+		server := testserver.New()
+		server.AddTransport(transport.SSE{})
+		server.AddTransport(transport.POST{})
+
+		query := httptest.NewRequest("POST", "/graphql", strings.NewReader(`{"query":"{ name }"}`))
+		query.Header.Set("Content-Type", "application/json")
+		query.Header.Set("Accept", "application/json")
+		queryResponse := httptest.NewRecorder()
+		server.ServeHTTP(queryResponse, query)
+		assert.Equal(t, http.StatusOK, queryResponse.Code, queryResponse.Body.String())
+		assert.Equal(t, "application/json", queryResponse.Header().Get("Content-Type"))
+		assert.Equal(t, `{"data":{"name":"test"}}`, queryResponse.Body.String())
+
+		httpServer := httptest.NewServer(server)
+		defer httpServer.Close()
+		go server.SendNextSubscriptionMessage()
+
+		req, err := http.NewRequest("POST", httpServer.URL, strings.NewReader(`{"query":"subscription { name }"}`))
+		if !assert.NoError(t, err) {
+			return
+		}
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("Accept", "text/event-stream")
+		response, err := http.DefaultClient.Do(req)
+		if !assert.NoError(t, err) {
+			return
+		}
+		defer response.Body.Close()
+		assert.Equal(t, http.StatusOK, response.StatusCode)
+		assert.Equal(t, "text/event-stream", response.Header.Get("Content-Type"))
+
+		reader := bufio.NewReader(response.Body)
+		for _, line := range []string{":\n", "\n", "event: next\n", "data: {\"data\":{\"name\":\"test\"}}\n", "\n"} {
+			got, readErr := reader.ReadString('\n')
+			if !assert.NoError(t, readErr) {
+				return
+			}
+			assert.Equal(t, line, got)
+		}
+		go server.SendCompleteSubscriptionMessage()
+		for _, line := range []string{"event: complete\n", "\n"} {
+			got, readErr := reader.ReadString('\n')
+			if !assert.NoError(t, readErr) {
+				return
+			}
+			assert.Equal(t, line, got)
+		}
 	})
 }
 
