diff --git a/__tests__/add-blank-line-after-yaml.test.ts b/__tests__/add-blank-line-after-yaml.test.ts
new file mode 100644
index 0000000..dbfeee6
--- /dev/null
+++ b/__tests__/add-blank-line-after-yaml.test.ts
@@ -0,0 +1,169 @@
+import {Rule, rules} from '../src/rules';
+
+try {
+  require('../src/rules-registry');
+} catch {
+  // On a version without this feature, the requested rule module is not available to register.
+}
+import dedent from 'ts-dedent';
+
+const directFrontMatter = dedent`
+  ---
+  key: value
+  ---
+  Content here.
+`;
+const separatedFrontMatter = dedent`
+  ---
+  key: value
+  ---
+  ${''}
+  Content here.
+`;
+
+const getRegisteredRule = (): Rule => {
+  const rule = rules.find((candidate) => {
+    if (!/\b(?:blank|empty)\s+line\s+after\s+yaml\b/i.test(candidate.getName())) {
+      return false;
+    }
+    try {
+      return candidate.apply(directFrontMatter) === separatedFrontMatter;
+    } catch {
+      return false;
+    }
+  });
+  if (!rule) {
+    throw new Error('No registered linter rule adds a blank line after YAML front matter');
+  }
+  return rule;
+};
+
+describe('Add a blank line after YAML front matter', () => {
+  it('is available through the registered linter rules', () => {
+    expect(getRegisteredRule()).toBeDefined();
+  });
+
+  const testCases = [
+    {
+      name: 'does not change a note without YAML front matter',
+      before: dedent`
+        Here is some text.
+      `,
+      after: dedent`
+        Here is some text.
+      `,
+    },
+    {
+      name: 'leaves YAML-looking text in the body alone',
+      before: dedent`
+        Here is some text.
+        ---
+        key: value
+        ---
+        Content here.
+      `,
+      after: dedent`
+        Here is some text.
+        ---
+        key: value
+        ---
+        Content here.
+      `,
+    },
+    {
+      name: 'adds an empty line before paragraph content after front matter',
+      before: dedent`
+        ---
+        key: value
+        ---
+        Content here.
+      `,
+      after: dedent`
+        ---
+        key: value
+        ---
+        ${''}
+        Content here.
+      `,
+    },
+    {
+      name: 'adds an empty line before a heading after front matter',
+      before: dedent`
+        ---
+        key: value
+        ---
+        # Heading
+      `,
+      after: dedent`
+        ---
+        key: value
+        ---
+        ${''}
+        # Heading
+      `,
+    },
+    {
+      name: 'adds an empty line before a list after front matter',
+      before: dedent`
+        ---
+        key: value
+        ---
+        - item
+      `,
+      after: dedent`
+        ---
+        key: value
+        ---
+        ${''}
+        - item
+      `,
+    },
+    {
+      name: 'does not add another empty line when one already precedes content',
+      before: dedent`
+        ---
+        key: value
+        ---
+        ${''}
+        Content here.
+      `,
+      after: dedent`
+        ---
+        key: value
+        ---
+        ${''}
+        Content here.
+      `,
+    },
+    {
+      name: 'does not add an empty line when front matter ends the note',
+      before: dedent`
+        ---
+        key: value
+        ---
+      `,
+      after: dedent`
+        ---
+        key: value
+        ---
+      `,
+    },
+    {
+      name: 'does not add an empty line when the note contains only front matter',
+      before: dedent`
+        ---
+        key: value
+        ---
+      `,
+      after: dedent`
+        ---
+        key: value
+        ---
+      `,
+    },
+  ];
+
+  it.each(testCases)('$name', ({before, after}) => {
+    expect(getRegisteredRule().apply(before)).toBe(after);
+  });
+});
