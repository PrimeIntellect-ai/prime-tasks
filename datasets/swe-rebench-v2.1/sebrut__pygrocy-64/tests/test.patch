+import json
+from unittest import TestCase
+
+import responses
+
+from pygrocy import Grocy
+from pygrocy.grocy import Product
+from pygrocy.grocy_api_client import CurrentVolatilStockResponse
+from test.test_const import CONST_BASE_URL, CONST_PORT, CONST_SSL
+
+
+class TestMissingProductResponse(TestCase):
+    def test_volatile_stock_missing_products_are_parsed(self):
+        input_json = """{
+            "expiring_products": [],
+            "expired_products": [],
+            "missing_products": [
+                { "id": "7", "name": "XXXX", "amount_missing": "1", "is_partly_in_stock": "1" },
+                { "id": "8", "name": "YYYY", "amount_missing": "2", "is_partly_in_stock": "0" }
+            ]
+        }"""
+        response = CurrentVolatilStockResponse(json.loads(input_json))
+
+        missing = response.missing_products
+        assert len(missing) == 2
+
+        assert all(type(item).__name__ == "MissingProductResponse" for item in missing)
+        assert missing[0].product_id == 7
+        assert missing[0].name == "XXXX"
+        assert missing[0].amount_missing == 1
+        assert missing[0].is_partly_in_stock
+        assert missing[1].product_id == 8
+        assert missing[1].name == "YYYY"
+        assert missing[1].amount_missing == 2
+        assert not missing[1].is_partly_in_stock
+
+    @responses.activate
+    def test_missing_products_retrieved_through_grocy(self):
+        resp = {
+            "expiring_products": [],
+            "expired_products": [],
+            "missing_products": [
+                { "id": "7", "name": "XXXX", "amount_missing": "1", "is_partly_in_stock": "1" },
+                { "id": "8", "name": "YYYY", "amount_missing": "2", "is_partly_in_stock": "0" }
+            ]
+        }
+        responses.add(
+            responses.GET,
+            "{}:{}/api/stock/volatile".format(CONST_BASE_URL, CONST_PORT),
+            json=resp,
+            status=200,
+        )
+
+        grocy = Grocy(CONST_BASE_URL, "demo_mode", port=CONST_PORT, verify_ssl=CONST_SSL)
+        missing = grocy.missing_products()
+
+        assert len(missing) == 2
+        assert all(isinstance(item, Product) for item in missing)
+        assert missing[0].product_id == 7
+        assert missing[0].name == "XXXX"
+        assert missing[0].amount_missing == 1
+        assert missing[0].is_partly_in_stock
+        assert missing[1].product_id == 8
+        assert missing[1].name == "YYYY"
+        assert missing[1].amount_missing == 2
+        assert not missing[1].is_partly_in_stock
