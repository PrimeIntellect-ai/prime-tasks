+func TestComputeAllocatesRemainderAmongCurrentTrafficRevisions(t *testing.T) {
+	testCmd, trafficFlags := newTestTrafficCommand()
+	testCmd.SetArgs([]string{"--traffic", "50"})
+	if err := testCmd.Execute(); err != nil {
+		t.Fatal(err)
+	}
+
+	currentTraffic := newServiceTraffic([]servingv1.TrafficTarget{
+		newTarget("", "rev-active", 100, false),
+	})
+	svc := getService("serviceName", "rev-new", currentTraffic)
+	// This revision exists but is absent from the current traffic distribution.
+	revisions := []servingv1.Revision{
+		{ObjectMeta: metav1.ObjectMeta{Name: "rev-inactive"}},
+		{ObjectMeta: metav1.ObjectMeta{Name: "rev-active"}},
+	}
+
+	targets, err := Compute(testCmd, svc, trafficFlags, revisions, true)
+	assert.NilError(t, err)
+	assert.Equal(t, len(targets), 2)
+
+	activePercent := int64(-1)
+	latestPercent := int64(-1)
+	for _, target := range targets {
+		if target.LatestRevision != nil && *target.LatestRevision {
+			latestPercent = *target.Percent
+		}
+		if target.RevisionName == "rev-active" {
+			activePercent = *target.Percent
+		}
+		assert.Assert(t, target.RevisionName != "rev-inactive")
+	}
+	assert.Equal(t, activePercent, int64(50))
+	assert.Equal(t, latestPercent, int64(50))
+}
