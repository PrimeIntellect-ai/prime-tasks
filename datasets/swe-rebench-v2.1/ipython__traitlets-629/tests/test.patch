+def test_set_from_string_cli():
+    """The deprecated Set literal form works from the command line."""
+    from traitlets.config import Application
+
+    class MyApp(Application):
+        tags = Set(Unicode()).tag(config=True)
+
+    app = MyApp()
+    app.parse_command_line(['--MyApp.tags={"noeffect"}'])
+    assert app.tags == {"noeffect"}
+
+    app.parse_command_line(['--MyApp.tags=["noeffect"]'])
+    assert app.tags == {"noeffect"}
+
