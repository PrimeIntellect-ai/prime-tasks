+def test_dba_clustering_reproduction():
+    """Test the reported DBA clustering reproduction does not raise."""
+    from aeon.clustering.k_means import TimeSeriesKMeans
+
+    X_train = create_test_distance_numpy(20, 1, 15, random_state=1)
+    k_means = TimeSeriesKMeans(
+        n_clusters=3,
+        init_algorithm="forgy",
+        max_iter=3,
+        metric="dtw",
+        averaging_method="dba",
+        random_state=1,
+    )
+    k_means.fit(X_train)
+
+
+def test_dba_invalid_metric_error():
+    """Test DBA raises a ValueError with the documented message."""
+    from aeon.clustering.metrics.averaging import elastic_barycenter_average
+
+    X_train = create_test_distance_numpy(10, 10, 10)
+    with pytest.raises(ValueError) as exc_info:
+        elastic_barycenter_average(X_train, metric="euclidean")
+    assert str(exc_info.value) == "Metric parameter invalid"
