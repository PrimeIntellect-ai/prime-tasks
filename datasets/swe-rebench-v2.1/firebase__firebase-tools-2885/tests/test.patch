+++ b/src/test/emulators/auth/batch.spec.ts
@@ -0,0 +1,63 @@
+import { expect } from "chai";
+import { describeAuthEmulator } from "./setup";
+import { expectStatusCode, PROJECT_ID, registerAnonUser, registerUser } from "./helpers";
+import { UserInfo } from "../../../emulator/auth/state";
+
+describeAuthEmulator("accounts:batchGet", ({ authApi }) => {
+  it("should allow listing all accounts", async () => {
+    const user1 = await registerAnonUser(authApi());
+    const user2 = await registerUser(authApi(), { email: "foo@example.com", password: "foobar" });
+
+    await authApi()
+      .get(`/identitytoolkit.googleapis.com/v1/projects/${PROJECT_ID}/accounts:batchGet`)
+      .set("Authorization", "Bearer owner")
+      .then((res) => {
+        expectStatusCode(200, res);
+        expect(res.body.users).to.have.length(2);
+        expect(res.body.users.map((user: UserInfo) => user.localId)).to.have.members([
+          user1.localId,
+          user2.localId,
+        ]);
+
+      });
+  });
+
+  it("should allow specifying maxResults and continuing through pagination", async () => {
+    const user1 = await registerAnonUser(authApi());
+    const user2 = await registerUser(authApi(), { email: "foo@example.com", password: "foobar" });
+    const expectedLocalIds = [user1.localId, user2.localId];
+
+    const firstPage = await authApi()
+      .get(`/identitytoolkit.googleapis.com/v1/projects/${PROJECT_ID}/accounts:batchGet`)
+      .query({ maxResults: 1 })
+      .set("Authorization", "Bearer owner");
+    expectStatusCode(200, firstPage);
+    expect(firstPage.body.users).to.have.length(1);
+    expect(expectedLocalIds).to.include(firstPage.body.users[0].localId);
+    expect(firstPage.body.nextPageToken).to.be.a("string");
+
+    const secondPage = await authApi()
+      .get(`/identitytoolkit.googleapis.com/v1/projects/${PROJECT_ID}/accounts:batchGet`)
+      .query({ nextPageToken: firstPage.body.nextPageToken })
+      .set("Authorization", "Bearer owner");
+    expectStatusCode(200, secondPage);
+    expect(secondPage.body.users).to.have.length(1);
+    expect(expectedLocalIds).to.include(secondPage.body.users[0].localId);
+    expect(secondPage.body.users[0].localId).not.to.equal(firstPage.body.users[0].localId);
+  });
+
+  it("should return a batch of 1000 accounts when requested", async function() {
+    this.timeout(30000);
+    for (let i = 0; i < 1000; i++) {
+      await registerAnonUser(authApi());
+    }
+
+    const res = await authApi()
+      .get(`/identitytoolkit.googleapis.com/v1/projects/${PROJECT_ID}/accounts:batchGet`)
+      .query({ maxResults: 1000 })
+      .set("Authorization", "Bearer owner");
+
+    expectStatusCode(200, res);
+    expect(res.body.users).to.have.length(1000);
+  });
+});
