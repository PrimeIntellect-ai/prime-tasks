diff --git a/test/AsyncTask.spec.ts b/test/AsyncTask.spec.ts
index d1dd1c8..81c24b9 100644
--- a/test/AsyncTask.spec.ts
+++ b/test/AsyncTask.spec.ts
@@ -156,5 +156,71 @@ describe('ToadScheduler', () => {
         done()
       })
     })
+
+    it('correctly provide taskid', (done) => {
+      unMockTimers()
+      expectAssertions(1)
+
+      const scheduler = new ToadScheduler()
+      let receivedTaskId: string | undefined
+      const task = new AsyncTask(
+        'async task',
+        (taskId) => {
+          receivedTaskId = taskId
+          return Promise.resolve()
+        },
+        () => {}
+      )
+      const job = new SimpleIntervalJob(
+        {
+          milliseconds: 5,
+        },
+        task
+      )
+
+      scheduler.addSimpleIntervalJob(job)
+
+      sleep(10).then(() => {
+        scheduler.stop()
+        expect(receivedTaskId).toBe('async task')
+        done()
+      })
+    })
+
+    it('correctly provide taskid and jobid', (done) => {
+      unMockTimers()
+      expectAssertions(2)
+
+      const scheduler = new ToadScheduler()
+      let receivedTaskId: string | undefined
+      let receivedJobId: string | undefined
+      const task = new AsyncTask(
+        'async task',
+        (taskId, jobId) => {
+          receivedTaskId = taskId
+          receivedJobId = jobId
+          return Promise.resolve()
+        },
+        () => {}
+      )
+      const job = new SimpleIntervalJob(
+        {
+          milliseconds: 5,
+        },
+        task,
+        {
+          id: 'jobId',
+        }
+      )
+
+      scheduler.addSimpleIntervalJob(job)
+
+      sleep(10).then(() => {
+        scheduler.stop()
+        expect(receivedTaskId).toBe('async task')
+        expect(receivedJobId).toBe('jobId')
+        done()
+      })
+    })
   })
 })
