diff --git a/test/mix/tasks/phx.gen.context_test.exs b/test/mix/tasks/phx.gen.context_test.exs
index 8ca5a4d7..68d9731f 100644
--- a/test/mix/tasks/phx.gen.context_test.exs
+++ b/test/mix/tasks/phx.gen.context_test.exs
@@ -104,6 +104,9 @@ defmodule Mix.Tasks.Phx.Gen.ContextTest do
         Gen.Context.run(~w(Blog Blog blogs))
       end
 
+      assert_generation_rejected_or_compiles(~w(Phoenix Post posts))
+      assert_generation_rejected_or_compiles(~w(Blog Phoenix blogs))
+
       assert_raise Mix.Error, ~r/Invalid arguments/, fn ->
         Gen.Context.run(~w(Blog.Post posts))
       end
@@ -179,6 +182,78 @@ defmodule Mix.Tasks.Phx.Gen.ContextTest do
     end
   end
 
+  defp assert_generation_rejected_or_compiles(args) do
+    result =
+      try do
+        Mix.Tasks.Phx.Gen.Html.run(args)
+        :generated
+      rescue
+        error in Mix.Error -> {:rejected, error}
+      end
+
+    case result do
+      {:rejected, _error} ->
+        :ok
+
+      :generated ->
+        singular = args |> Enum.at(1) |> Macro.underscore()
+        assert [schema_file] = Path.wildcard("lib/**/*#{singular}.ex")
+        assert [controller_file] = Path.wildcard("lib/**/*#{singular}_controller.ex")
+
+        stub_modules =
+          Code.compile_quoted(quote do
+            defmodule Ecto.Schema do
+              defmacro __using__(_opts) do
+                quote do
+                  import Ecto.Schema
+                end
+              end
+
+              defmacro schema(_source, do: block) do
+                quote do
+                  defstruct []
+                  unquote(block)
+                end
+              end
+
+              defmacro field(_name, _type, _opts \\ []), do: quote(do: :ok)
+              defmacro timestamps(_opts \\ []), do: quote(do: :ok)
+            end
+
+            defmodule Ecto.Changeset do
+              defstruct []
+              def cast(changeset, _attrs, _fields), do: changeset
+              def validate_required(changeset, _fields), do: changeset
+            end
+
+            defmodule PhoenixWeb do
+              defmacro __using__(_opts), do: quote(do: nil)
+            end
+          end)
+
+        try do
+          schema_modules = Code.compile_file(schema_file)
+          try do
+            controller_modules = Code.compile_file(controller_file)
+            Enum.each(controller_modules, fn {module, _} ->
+              :code.purge(module)
+              :code.delete(module)
+            end)
+          after
+            Enum.each(schema_modules, fn {module, _} ->
+              :code.purge(module)
+              :code.delete(module)
+            end)
+          end
+        after
+          Enum.each(stub_modules, fn {module, _} ->
+            :code.purge(module)
+            :code.delete(module)
+          end)
+        end
+    end
+  end
+
   test "generates context with no schema", config do
     in_tmp_project config.test, fn ->
       Gen.Context.run(~w(Blog Post posts title:string --no-schema))
