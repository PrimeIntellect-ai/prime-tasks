 		});
+
+		it('Does not escape unicode attributes.', () => {
+			const div = document.createElement('div');
+
+			div.setAttribute('attr1', 'Hello \u{2068}John\u{2069}');
+			div.setAttribute('attr2', '<span> test');
+			div.setAttribute('attr3', '');
+
+			const serialized = xmlSerializer.serializeToString(div);
+
+			expect(serialized).toContain('Hello \u{2068}John\u{2069}');
+			expect(serialized).toMatch(/attr2="&lt;span(?:&gt;|>) test"/);
+		});
 	});
 });
