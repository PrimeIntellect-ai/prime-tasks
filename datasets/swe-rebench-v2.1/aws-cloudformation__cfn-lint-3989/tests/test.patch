+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+import json
+
+import pytest
+
+from cfnlint.api import lint
+
+
+_REST_API = {
+    "Type": "AWS::ApiGateway::RestApi",
+    "Properties": {
+        "Body": {
+            "swagger": "2.0",
+            "info": {"title": "example", "version": "1.0"},
+            "paths": {},
+        }
+    },
+}
+
+_MIXING_RESOURCES = {
+    "Method": {
+        "Type": "AWS::ApiGateway::Method",
+        "Properties": {
+            "RestApiId": {"Ref": "RestApi"},
+            "ResourceId": {"Fn::GetAtt": "RestApi.RootResourceId"},
+            "HttpMethod": "GET",
+            "AuthorizationType": "NONE",
+        },
+    },
+    "Model": {
+        "Type": "AWS::ApiGateway::Model",
+        "Properties": {
+            "RestApiId": {"Ref": "RestApi"},
+            "ContentType": "application/json",
+            "Schema": {"type": "object"},
+        },
+    },
+    "Resource": {
+        "Type": "AWS::ApiGateway::Resource",
+        "Properties": {
+            "RestApiId": {"Ref": "RestApi"},
+            "ParentId": {"Fn::GetAtt": "RestApi.RootResourceId"},
+            "PathPart": "example",
+        },
+    },
+    "GatewayResponse": {
+        "Type": "AWS::ApiGateway::GatewayResponse",
+        "Properties": {
+            "RestApiId": {"Ref": "RestApi"},
+            "ResponseType": "DEFAULT_4XX",
+        },
+    },
+    "RequestValidator": {
+        "Type": "AWS::ApiGateway::RequestValidator",
+        "Properties": {
+            "RestApiId": {"Ref": "RestApi"},
+            "Name": "validator",
+            "ValidateRequestBody": True,
+            "ValidateRequestParameters": False,
+        },
+    },
+    "Authorizer": {
+        "Type": "AWS::ApiGateway::Authorizer",
+        "Properties": {
+            "RestApiId": {"Ref": "RestApi"},
+            "Name": "authorizer",
+            "Type": "TOKEN",
+            "IdentitySource": "method.request.header.Authorization",
+            "AuthorizerUri": (
+                "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/"
+                "arn:aws:lambda:us-east-1:123456789012:function:authorizer/invocations"
+            ),
+        },
+    },
+}
+
+
+def _warning_matches(template):
+    return [
+        match
+        for match in lint(json.dumps(template))
+        if match.rule.severity == "warning"
+    ]
+
+
+@pytest.mark.parametrize("definition_property", ["Body", "BodyS3Location"])
+@pytest.mark.parametrize("resource_name,resource", _MIXING_RESOURCES.items())
+def test_definition_mixed_with_api_gateway_resources_warns(
+    definition_property, resource_name, resource
+):
+    rest_api = {"Type": "AWS::ApiGateway::RestApi", "Properties": {}}
+    if definition_property == "Body":
+        rest_api["Properties"]["Body"] = _REST_API["Properties"]["Body"]
+    else:
+        rest_api["Properties"]["BodyS3Location"] = {
+            "Bucket": "api-definitions",
+            "Key": "api.yaml",
+        }
+
+    template = {"Resources": {"RestApi": rest_api, resource_name: resource}}
+
+    assert _warning_matches(template)
+
+
+@pytest.mark.parametrize(
+    "resources",
+    [
+        {},
+        {
+            "Stage": {
+                "Type": "AWS::ApiGateway::Stage",
+                "Properties": {
+                    "StageName": "Prod",
+                    "RestApiId": {"Ref": "RestApi"},
+                },
+            }
+        },
+    ],
+)
+def test_definition_without_mixing_resource_does_not_warn(resources):
+    template = {"Resources": {"RestApi": _REST_API, **resources}}
+
+    assert _warning_matches(template) == []
