+import pytest
+import sqlalchemy
+from sqlalchemy.dialects import sqlite
+
+from singer_sdk.connectors import SQLConnector
+
+
+class TestConnectorSQL:
+    """Test the SQLConnector class."""
+
+    @pytest.fixture()
+    def connector(self):
+        return SQLConnector()
+
+    @pytest.mark.parametrize(
+        "method_name,kwargs,expected_fragments",
+        [
+            (
+                "get_column_add_ddl",
+                {
+                    "table_name": "full.table.name",
+                    "column_name": "column_name",
+                    "column_type": sqlalchemy.types.Text(),
+                },
+                ("ALTER TABLE", "full.table.name", "ADD COLUMN", "column_name", "TEXT"),
+            ),
+            (
+                "get_column_rename_ddl",
+                {
+                    "table_name": "full.table.name",
+                    "column_name": "old_name",
+                    "new_column_name": "new_name",
+                },
+                ("ALTER TABLE", "full.table.name", "RENAME COLUMN", "old_name", "new_name"),
+            ),
+            (
+                "get_column_alter_ddl",
+                {
+                    "table_name": "full.table.name",
+                    "column_name": "column_name",
+                    "column_type": sqlalchemy.types.String(),
+                },
+                ("ALTER TABLE", "full.table.name", "ALTER COLUMN", "column_name", "VARCHAR"),
+            ),
+        ],
+    )
+    def test_get_column_ddl(self, connector, method_name, kwargs, expected_fragments):
+        method = getattr(connector, method_name)
+        column_ddl = method(**kwargs)
+
+        if isinstance(column_ddl, str):
+            statement = column_ddl
+        else:
+            statement = str(
+                column_ddl.compile(
+                    dialect=sqlite.dialect(), compile_kwargs={"literal_binds": True}
+                )
+            )
+        # SQL dialects may quote identifiers differently. Check the operation and
+        # its operands without coupling to a particular DDL template or quoting.
+        normalized_statement = (
+            statement.replace('"', "")
+            .replace("`", "")
+            .replace("[", "")
+            .replace("]", "")
+            .upper()
+        )
+        for fragment in expected_fragments:
+            assert fragment.upper() in normalized_statement
+
+
+class _RecordingConnection:
+    """Wrap a SQLAlchemy connection and record the statements executed on it."""
+
+    def __init__(self, real_connection, executed):
+        self._real_connection = real_connection
+        self._executed = executed
+
+    def execute(self, statement, *args, **kwargs):
+        self._executed.append(statement)
+
+    def __getattr__(self, name):
+        return getattr(self._real_connection, name)
+
+
+class _OverriddenDDLConnector(SQLConnector):
+    """Connector whose column DDL methods return distinctive statements.
+
+    The distinctive statements make it observable whether the SQL operations
+    actually route through the overridable ``get_column_*_ddl`` methods.
+    """
+
+    allow_column_alter = True
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.executed = []
+
+    @property
+    def connection(self):
+        return _RecordingConnection(super().connection, self.executed)
+
+    def get_column_add_ddl(self, table_name, column_name, column_type):
+        return sqlalchemy.DDL(
+            "CUSTOM ADD COLUMN %(table_name)s %(column_name)s %(column_type)s",
+            {
+                "table_name": table_name,
+                "column_name": column_name,
+                "column_type": column_type,
+            },
+        )
+
+    def get_column_rename_ddl(self, table_name, column_name, new_column_name):
+        return sqlalchemy.DDL(
+            "CUSTOM RENAME COLUMN %(table_name)s %(column_name)s %(new_column_name)s",
+            {
+                "table_name": table_name,
+                "column_name": column_name,
+                "new_column_name": new_column_name,
+            },
+        )
+
+    def get_column_alter_ddl(self, table_name, column_name, column_type):
+        return sqlalchemy.DDL(
+            "CUSTOM ALTER COLUMN %(table_name)s %(column_name)s %(column_type)s",
+            {
+                "table_name": table_name,
+                "column_name": column_name,
+                "column_type": column_type,
+            },
+        )
+
+
+class TestConnectorSQLOverrides:
+    """The column DDL methods must be used by the SQL operations."""
+
+    @pytest.fixture()
+    def connector(self):
+        connector = _OverriddenDDLConnector(sqlalchemy_url="sqlite://")
+        connector.connection._real_connection.execute(
+            sqlalchemy.text("CREATE TABLE t (id INTEGER)")
+        )
+        return connector
+
+    def test_add_column_uses_overridden_ddl(self, connector):
+        connector.prepare_column("t", "newcol", sqlalchemy.types.Text())
+
+        assert "CUSTOM ADD COLUMN t newcol TEXT" in [
+            str(statement) for statement in connector.executed
+        ]
+
+    def test_alter_column_uses_overridden_ddl(self, connector):
+        connector.prepare_column("t", "id", sqlalchemy.types.String())
+
+        assert "CUSTOM ALTER COLUMN t id VARCHAR" in [
+            str(statement) for statement in connector.executed
+        ]
+
+    def test_rename_column_uses_overridden_ddl(self, connector):
+        connector.rename_column("t", "id", "newid")
+
+        assert "CUSTOM RENAME COLUMN t id newid" in [
+            str(statement) for statement in connector.executed
+        ]
