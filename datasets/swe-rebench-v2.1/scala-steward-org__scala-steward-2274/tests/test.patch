+package org.scalasteward.core.update.artifact
+
+import cats.effect.Async
+import cats.effect.unsafe.implicits.global
+import munit.FunSuite
+import org.http4s.Uri
+import org.scalasteward.core.application.Config.ArtifactCfg
+import org.scalasteward.core.application.{Cli, Config}
+import org.scalasteward.core.data.GroupId
+import org.scalasteward.core.mock.MockConfig.mockRoot
+import org.scalasteward.core.io.{FileAlg, MockFileAlg}
+import org.scalasteward.core.mock.{MockEff, MockLogger}
+import org.scalasteward.core.mock.MockContext.mockState
+import org.typelevel.log4cats.Logger
+
+class ArtifactMigrationsLoaderTest extends FunSuite {
+  private implicit val effect: Async[MockEff] = MockEff
+  private implicit val fileAlg: FileAlg[MockEff] = new MockFileAlg
+  private implicit val logger: Logger[MockEff] = new MockLogger
+  private val loader = new ArtifactMigrationsLoader[MockEff]
+  val migrationsUri: Uri = Uri.unsafeFromString(s"$mockRoot/extra-migrations.conf")
+  val migrationsContent: String =
+    """|changes = [
+       |  {
+       |    groupIdBefore = com.evilcorp
+       |    groupIdAfter = org.ice.cream
+       |    artifactIdAfter = yumyum
+       |    initialVersion = 2.0.0
+       |  }
+       |]""".stripMargin
+  val migration: ArtifactChange = ArtifactChange(
+    groupIdBefore = Some(GroupId("com.evilcorp")),
+    groupIdAfter = GroupId("org.ice.cream"),
+    artifactIdBefore = None,
+    artifactIdAfter = "yumyum",
+    initialVersion = "2.0.0"
+  )
+  val secondMigrationsUri: Uri = Uri.unsafeFromString(s"$mockRoot/second-extra-migrations.conf")
+  val secondMigration: ArtifactChange = migration.copy(
+    groupIdBefore = Some(GroupId("com.othercorp")),
+    artifactIdAfter = "delicious"
+  )
+  val secondMigrationsContent: String = migrationsContent
+    .replace("com.evilcorp", "com.othercorp")
+    .replace("yumyum", "delicious")
+
+  test("loadAll: without extra file, without defaults") {
+    val migrations = loader
+      .loadAll(ArtifactCfg(Nil, disableDefaults = true))
+      .runA(mockState)
+      .unsafeRunSync()
+    assertEquals(migrations.size, 0)
+  }
+
+  test("loadAll: without extra file, with defaults") {
+    val migrations = loader
+      .loadAll(ArtifactCfg(Nil, disableDefaults = false))
+      .runA(mockState)
+      .unsafeRunSync()
+    assert(clue(migrations.size) > 0)
+  }
+
+  test("loadAll: with extra file, without defaults") {
+    val initialState = mockState.addUris(migrationsUri -> migrationsContent)
+    val migrations = loader
+      .loadAll(ArtifactCfg(List(migrationsUri), disableDefaults = true))
+      .runA(initialState)
+      .unsafeRunSync()
+    assertEquals(migrations, List(migration))
+  }
+
+  test("loadAll: with extra file, with defaults") {
+    val initialState = mockState.addUris(migrationsUri -> migrationsContent)
+    val migrations = loader
+      .loadAll(ArtifactCfg(List(migrationsUri), disableDefaults = false))
+      .runA(initialState)
+      .unsafeRunSync()
+    assert(clue(migrations.size) > 1)
+    assert(clue(migrations).contains(migration))
+  }
+
+  test("loadAll: includes migrations from every configured file") {
+    val initialState = mockState.addUris(
+      migrationsUri -> migrationsContent,
+      secondMigrationsUri -> secondMigrationsContent
+    )
+    val migrations = loader
+      .loadAll(ArtifactCfg(List(migrationsUri, secondMigrationsUri), disableDefaults = true))
+      .runA(initialState)
+      .unsafeRunSync()
+    assertEquals(migrations.toSet, Set(migration, secondMigration))
+  }
+
+  test("loadAll: fails when a configured file is malformed") {
+    val initialState = mockState.addUris(
+      migrationsUri -> migrationsContent,
+      secondMigrationsUri -> """{"key": "i'm not a valid Migration}"""
+    )
+    val migrations = loader
+      .loadAll(ArtifactCfg(List(migrationsUri, secondMigrationsUri), disableDefaults = true))
+      .runA(initialState)
+      .attempt
+      .unsafeRunSync()
+    assert(migrations.isLeft)
+  }
+
+  test("--disable-default-artifact-migrations disables the default migrations") {
+    val args = Cli
+      .parseArgs(
+        List(
+          "--workspace", "a",
+          "--repos-file", "b",
+          "--git-author-email", "d",
+          "--vcs-login", "e",
+          "--git-ask-pass", "f",
+          "--disable-default-artifact-migrations"
+        )
+      )
+      .asInstanceOf[Cli.ParseResult.Success]
+      .args
+    val config = Config.from(args)
+    assert(config.artifactCfg.disableDefaults)
+    val migrations = loader
+      .loadAll(config.artifactCfg)
+      .runA(mockState)
+      .unsafeRunSync()
+    assertEquals(migrations.size, 0)
+  }
+
+  test("artifact migrations are enabled by default") {
+    val args = Cli
+      .parseArgs(
+        List(
+          "--workspace", "a",
+          "--repos-file", "b",
+          "--git-author-email", "d",
+          "--vcs-login", "e",
+          "--git-ask-pass", "f"
+        )
+      )
+      .asInstanceOf[Cli.ParseResult.Success]
+      .args
+    val config = Config.from(args)
+    assert(!config.artifactCfg.disableDefaults)
+    val migrations = loader
+      .loadAll(config.artifactCfg)
+      .runA(mockState)
+      .unsafeRunSync()
+    assert(clue(migrations.size) > 0)
+  }
+}
