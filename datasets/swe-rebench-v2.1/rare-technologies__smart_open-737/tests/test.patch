+import gzip
+import io
+
+import pytest
+
+import smart_open.compression
+
+
+plain = 'доброе утро планета!'.encode()
+
+
+def label(thing, name):
+    setattr(thing, 'name', name)
+    return thing
+
+
+@pytest.mark.parametrize('filename', ['file.gz', 'file.GZ'])
+def test_compression_wrapper_read_with_filename(filename):
+    fileobj = io.BytesIO(gzip.compress(plain))
+    wrapped = smart_open.compression.compression_wrapper(
+        fileobj, 'rb', 'infer_from_extension', filename=filename)
+    assert wrapped.read() == plain
+
+
+@pytest.mark.parametrize('filename', ['file.gz', 'file.GZ'])
+def test_compression_wrapper_write_with_filename(tmp_path, filename):
+    path = tmp_path / filename
+    with open(path, 'wb') as fileobj:
+        wrapped = smart_open.compression.compression_wrapper(
+            fileobj, 'wb', 'infer_from_extension', filename=filename)
+        wrapped.write(plain)
+        wrapped.close()
+    with open(path, 'rb') as fileobj:
+        assert gzip.decompress(fileobj.read()) == plain
+
+
+@pytest.mark.parametrize('filename', ['file.gz', 'file.GZ'])
+def test_compression_wrapper_infer_from_name(filename):
+    fileobj = label(io.BytesIO(gzip.compress(plain)), filename)
+    wrapped = smart_open.compression.compression_wrapper(
+        fileobj, 'rb', 'infer_from_extension')
+    assert wrapped.read() == plain
+
+
+def test_compression_wrapper_disabled_returns_original():
+    fileobj = io.BytesIO(plain)
+    assert smart_open.compression.compression_wrapper(
+        fileobj, 'rb', 'disable') is fileobj
+
+
+def test_compression_wrapper_unknown_extension_returns_original():
+    fileobj = io.BytesIO(plain)
+    assert smart_open.compression.compression_wrapper(
+        fileobj, 'rb', 'infer_from_extension', filename='file.unknown') is fileobj
