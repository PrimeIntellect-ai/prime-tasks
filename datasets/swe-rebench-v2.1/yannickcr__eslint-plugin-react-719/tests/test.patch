+/**
+ * @fileoverview Report when a DOM element is using both children and dangerouslySetInnerHTML
+ * @author David Petersen
+ */
+'use strict';
+
+var assert = require('assert');
+var eslint = require('eslint');
+var pluginRules = require('../../../').rules;
+var ruleNames = Object.keys(pluginRules);
+var ruleConfig = {};
+var parserOptions = {
+  ecmaVersion: 6,
+  ecmaFeatures: {
+    jsx: true
+  }
+};
+var expectedMessage = 'Only set one of `children` or `props.dangerouslySetInnerHTML`';
+
+ruleNames.forEach(function(name) {
+  eslint.linter.defineRule(name, pluginRules[name]);
+  ruleConfig[name] = 2;
+});
+
+function reportsConflict(code) {
+  var messages = eslint.linter.verify(code, {
+    parserOptions: parserOptions,
+    rules: ruleConfig
+  });
+  return messages.some(function(message) {
+    return message.message === expectedMessage;
+  });
+}
+
+describe('children and dangerouslySetInnerHTML conflict', function() {
+  it('does not report when only one of children or dangerouslySetInnerHTML is used', function() {
+    [
+      '<div>Children</div>',
+      '<div dangerouslySetInnerHTML={{ __html: "HTML" }} />',
+      '<Hello>Children</Hello>',
+      '<Hello dangerouslySetInnerHTML={{ __html: "HTML" }} />',
+      'React.createElement("div", { dangerouslySetInnerHTML: { __html: "HTML" } });',
+      'React.createElement("div", {}, "Children");',
+      'React.createElement("Hello", { dangerouslySetInnerHTML: { __html: "HTML" } });',
+      'React.createElement("Hello", {}, "Children");'
+    ].forEach(function(code) {
+      assert.strictEqual(reportsConflict(code), false, code);
+    });
+  });
+
+  it('reports the documented message when children and dangerouslySetInnerHTML are both used', function() {
+    [
+      '<div dangerouslySetInnerHTML={{ __html: "HTML" }}>Children</div>',
+      '<div dangerouslySetInnerHTML={{ __html: "HTML" }} children="Children" />',
+      '<Hello dangerouslySetInnerHTML={{ __html: "HTML" }}>Children</Hello>',
+      '<Hello dangerouslySetInnerHTML={{ __html: "HTML" }} children="Children" />',
+      'React.createElement("div", { dangerouslySetInnerHTML: { __html: "HTML" } }, "Children");',
+      'React.createElement("div", { dangerouslySetInnerHTML: { __html: "HTML" }, children: "Children" });',
+      'React.createElement("Hello", { dangerouslySetInnerHTML: { __html: "HTML" } }, "Children");',
+      'React.createElement("Hello", { dangerouslySetInnerHTML: { __html: "HTML" }, children: "Children" });'
+    ].forEach(function(code) {
+      assert.strictEqual(reportsConflict(code), true, code);
+    });
+  });
+});
