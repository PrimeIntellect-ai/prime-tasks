+
+def _requires_start(causality, initial, variability):
+    return (
+        initial in (Fmi2Initial.exact, Fmi2Initial.approx)
+        or causality in (Fmi2Causality.input, Fmi2Causality.parameter)
+        or variability == Fmi2Variability.constant
+    )
+
+
+@pytest.mark.parametrize("var_type, value", [
+    (Boolean, True),
+    (Integer, 23),
+    (Real, 15.),
+    (String, "hello")])
+@pytest.mark.parametrize("causality", list(Fmi2Causality) + [None, ])
+@pytest.mark.parametrize("initial", list(Fmi2Initial) + [None, ])
+@pytest.mark.parametrize("variability", list(Fmi2Variability) + [None, ])
+def test_ScalarVariable_start(var_type, value, causality, initial, variability):
+    var_obj = var_type("var", causality=causality, description="a variable", initial=initial, variability=variability)
+
+    class PySlave(Fmi2Slave):
+
+        modelName = "PySlave"
+
+        def __init__(self):
+            super().__init__()
+            setattr(self, "var", value)
+            self.register_variable(var_obj)
+
+        def do_step(self, current_time: float, step_size: float):
+            return True
+
+    slave = PySlave()
+
+    xml = slave.to_xml()
+    var_node = xml.find(".//ScalarVariable[@name='var']")
+    assert var_node is not None
+
+    if _requires_start(causality, initial, variability):
+        assert var_obj.start == value
+
+
+@pytest.mark.parametrize("causality", list(Fmi2Causality) + [None, ])
+@pytest.mark.parametrize("initial", list(Fmi2Initial) + [None, ])
+@pytest.mark.parametrize("variability", list(Fmi2Variability) + [None, ])
+def test_ScalarVariable_requires_start(causality, initial, variability):
+    var_obj = Real("var", causality=causality, initial=initial, variability=variability)
+
+    assert ScalarVariable.requires_start(var_obj) == _requires_start(causality, initial, variability)
+
+
