+func TestFleetdHasDefaultEtcdEndpointsWithEmptyConfig(t *testing.T) {
+	tmp := t.TempDir()
+	restoreMachineID := ensureTestMachineID(t)
+	defer restoreMachineID()
+
+	configPath := filepath.Join(tmp, "fleet.conf")
+	if err := os.WriteFile(configPath, nil, 0600); err != nil {
+		t.Fatalf("failed to create empty configuration: %v", err)
+	}
+
+	busPath := filepath.Join(tmp, "system-bus.sock")
+	listener, err := net.Listen("unix", busPath)
+	if err != nil {
+		t.Fatalf("failed to start local system bus: %v", err)
+	}
+	defer listener.Close()
+
+	go serveTestSystemBus(listener)
+
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, filepath.Join("..", "bin", "fleetd"), "--config", configPath)
+	cmd.Env = fleetdTestEnvironment(os.Environ(), busPath)
+	output, _ := cmd.CombinedOutput()
+
+	if strings.Contains(strings.ToLower(string(output)), "no endpoints available") {
+		t.Fatalf("fleetd attempted to start with an empty etcd endpoint list: %s", output)
+	}
+}
+
+func fleetdTestEnvironment(env []string, busPath string) []string {
+	filtered := make([]string, 0, len(env)+1)
+	for _, entry := range env {
+		if !strings.HasPrefix(entry, "FLEET_ETCD_SERVERS=") && !strings.HasPrefix(entry, "DBUS_SYSTEM_BUS_ADDRESS=") {
+			filtered = append(filtered, entry)
+		}
+	}
+	return append(filtered, "DBUS_SYSTEM_BUS_ADDRESS=unix:path="+busPath)
+}
+
+func serveTestSystemBus(listener net.Listener) {
+	for {
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		go serveTestSystemBusConnection(conn)
+	}
+}
+
+func serveTestSystemBusConnection(conn net.Conn) {
+	defer conn.Close()
+	reader := bufio.NewReader(conn)
+	if _, err := reader.ReadByte(); err != nil {
+		return
+	}
+	for {
+		line, err := reader.ReadString('\n')
+		if err != nil {
+			return
+		}
+		switch {
+		case strings.HasPrefix(line, "AUTH "):
+			if _, err := conn.Write([]byte("OK 0123456789abcdef0123456789abcdef\r\n")); err != nil {
+				return
+			}
+		case strings.TrimSpace(line) == "AUTH":
+			if _, err := conn.Write([]byte("REJECTED EXTERNAL\r\n")); err != nil {
+				return
+			}
+		case strings.TrimSpace(line) == "NEGOTIATE_UNIX_FD":
+			if _, err := conn.Write([]byte("AGREE_UNIX_FD\r\n")); err != nil {
+				return
+			}
+		case strings.TrimSpace(line) == "BEGIN":
+			goto messages
+		}
+	}
+
+messages:
+	for {
+		msg, err := dbus.DecodeMessage(reader)
+		if err != nil {
+			return
+		}
+		member := msg.Headers[dbus.FieldMember].Value().(string)
+		reply := &dbus.Message{
+			Type:    dbus.TypeMethodReply,
+			Headers: map[dbus.HeaderField]dbus.Variant{dbus.FieldReplySerial: dbus.MakeVariant(msg.Serial())},
+		}
+		if member == "Hello" {
+			reply.Body = []interface{}{":1.1"}
+			reply.Headers[dbus.FieldSignature] = dbus.MakeVariant(dbus.SignatureOf(reply.Body...))
+		}
+		var encoded bytes.Buffer
+		if err := reply.EncodeTo(&encoded, binary.LittleEndian); err != nil {
+			return
+		}
+		binary.LittleEndian.PutUint32(encoded.Bytes()[8:12], 1)
+		if _, err := conn.Write(encoded.Bytes()); err != nil {
+			return
+		}
+	}
+}
+
+func ensureTestMachineID(t *testing.T) func() {
+	t.Helper()
+	const machineIDPath = "/etc/machine-id"
+	original, err := os.ReadFile(machineIDPath)
+	if err != nil {
+		t.Fatalf("failed to read machine identifier: %v", err)
+	}
+	if strings.TrimSpace(string(original)) != "" {
+		return func() {}
+	}
+	info, err := os.Stat(machineIDPath)
+	if err != nil {
+		t.Fatalf("failed to inspect machine identifier: %v", err)
+	}
+	if err := os.WriteFile(machineIDPath, []byte("0123456789abcdef0123456789abcdef\n"), info.Mode().Perm()); err != nil {
+		t.Fatalf("failed to provide a temporary machine identifier: %v", err)
+	}
+	return func() {
+		if err := os.WriteFile(machineIDPath, original, info.Mode().Perm()); err != nil {
+			t.Errorf("failed to restore machine identifier: %v", err)
+		}
+	}
+}
