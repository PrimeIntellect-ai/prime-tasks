@@ -5,6 +5,7 @@
 
 from __future__ import annotations
 
+import asyncio
 import sys
 from typing import TYPE_CHECKING, Any
 
@@ -321,6 +322,11 @@ DATA: AntaUnitTestDataDict = {
         "inputs": {"source_interface": "Loopback1", "udp_port": 4789},
         "expected": {"result": AntaTestStatus.SUCCESS},
     },
+    (VerifyVxlan1ConnSettings, "success-dps-src-intf"): {
+        "eos_data": [{"interfaces": {"Vxlan1": {"srcIpIntf": "Dps1", "udpPort": 4789}}}],
+        "inputs": {"source_interface": "Dps1", "udp_port": 4789},
+        "expected": {"result": AntaTestStatus.SUCCESS},
+    },
     (VerifyVxlan1ConnSettings, "skipped"): {
         "eos_data": [{"interfaces": {}}],
         "inputs": {"source_interface": "Loopback1", "udp_port": 4789},
@@ -343,3 +349,15 @@ DATA: AntaUnitTestDataDict = {
         },
     },
 }
+
+
+def test_vxlan_conn_settings_rejects_mismatched_dps_source(device: Any) -> None:
+    """A configured source different from the expected DPS interface must fail."""
+    instance = VerifyVxlan1ConnSettings(
+        device,
+        inputs={"source_interface": "Dps1", "udp_port": 4789},
+        eos_data=[{"interfaces": {"Vxlan1": {"srcIpIntf": "Loopback10", "udpPort": 4789}}}],
+    )
+    asyncio.run(instance.test())
+
+    assert instance.result.result == AntaTestStatus.FAILURE
