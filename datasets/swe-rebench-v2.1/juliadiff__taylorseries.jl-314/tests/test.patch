+# Large first-order tables must not silently label the first variable incorrectly.
+function _first_variable_ok_or_overflow(numvars)
+    try
+        δv = set_variables("δ", order=1, numvars=numvars)
+        return occursin("δ₁", string((1 + δv[1])^2))
+    catch e
+        return e isa OverflowError
+    end
+end
 
