@@ -9,6 +9,54 @@ use crate::{
 
 use super::*;
 
+struct BorrowedResolver<'a> {
+    url: &'a str,
+}
+
+impl BrokenLinkCallback for BorrowedResolver<'_> {
+    fn resolve(&self, _: BrokenLinkReference) -> Option<ResolvedReference> {
+        Some(ResolvedReference {
+            url: self.url.to_owned(),
+            title: String::new(),
+        })
+    }
+}
+
+#[test]
+fn api_supports_borrowed_callback_closure_in_options() {
+    let arena = Arena::new();
+    let destination = String::from("https://example.com/from-context");
+    let mut options = Options::default();
+    options.parse.broken_link_callback = Some(Arc::new(|_: BrokenLinkReference| {
+        Some(ResolvedReference {
+            url: destination.clone(),
+            title: String::new(),
+        })
+    }));
+
+    let node = parse_document(&arena, "[label][missing]", &options);
+    let mut html = Vec::new();
+    format_html(node, &Options::default(), &mut html).unwrap();
+    let html = String::from_utf8(html).unwrap();
+    assert!(html.contains("href=\"https://example.com/from-context\""));
+}
+
+#[test]
+fn api_supports_borrowed_trait_callback_in_options() {
+    let arena = Arena::new();
+    let destination = String::from("https://example.com/custom-context");
+    let mut options = Options::default();
+    options.parse.broken_link_callback =
+        Some(Arc::new(BorrowedResolver { url: &destination }));
+
+    let node = parse_document(&arena, "[label][missing]", &options);
+
+    let mut html = Vec::new();
+    format_html(node, &Options::default(), &mut html).unwrap();
+    let html = String::from_utf8(html).unwrap();
+    assert!(html.contains("href=\"https://example.com/custom-context\""));
+}
