+defmodule GRPC.Server.SupervisorTest do
+  use ExUnit.Case, async: true
+
+  test "Handler.state is not declared without documentation" do
+    assert {:docs_v1, _anno, _lang, _format, _mod_doc, _meta, docs} =
+             Code.fetch_docs(GRPC.Server.Adapters.Cowboy.Handler)
+
+    state_docs =
+      for {{:type, :state, _arity}, _anno, _sig, doc, _meta} <- docs, do: doc
+
+    assert Enum.all?(state_docs, &(&1 != :none)),
+           "GRPC.Server.Adapters.Cowboy.Handler.state is declared but not documented"
+  end
+end
