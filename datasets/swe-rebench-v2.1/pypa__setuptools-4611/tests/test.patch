+def test_skipping_trove_classifier_validation(monkeypatch):
+    # Accept either the broad opt-out provided by setuptools or the specific
+    # classifier opt-out suggested by the issue.
+    monkeypatch.setenv("SETUPTOOLS_DANGEROUSLY_SKIP_PYPROJECT_VALIDATION", "true")
+    monkeypatch.setenv("VALIDATE_PYPROJECT_NO_TROVE_CLASSIFIERS", "true")
+    script = """
+import sys
+import types
+import warnings
+
+provider = types.ModuleType("trove_classifiers")
+provider.classifiers = {"Framework :: Flask"}
+sys.modules["trove_classifiers"] = provider
+warnings.simplefilter("ignore")
+from setuptools.config.pyprojecttoml import validate
+validate({"project": {"name": "myproj", "version": "1.0", "classifiers": ["Not a valid trove classifier"]}}, "pyproject.toml")
+"""
+    result = subprocess.run(
+        [sys.executable, "-c", script], capture_output=True, text=True
+    )
+    assert result.returncode == 0, result.stderr
+
+
+def test_trove_classifier_validation_enabled_by_default(monkeypatch):
+    monkeypatch.delenv("SETUPTOOLS_DANGEROUSLY_SKIP_PYPROJECT_VALIDATION", raising=False)
+    monkeypatch.delenv("VALIDATE_PYPROJECT_NO_TROVE_CLASSIFIERS", raising=False)
+    script = """
+import sys
+import types
+import warnings
+
+provider = types.ModuleType("trove_classifiers")
+provider.classifiers = {"Framework :: Flask"}
+sys.modules["trove_classifiers"] = provider
+warnings.simplefilter("ignore")
+from setuptools.config.pyprojecttoml import validate
+
+def config(classifier):
+    return {"project": {"name": "myproj", "version": "1.0", "classifiers": [classifier]}}
+
+assert validate(config("Framework :: Flask"), "pyproject.toml")
+try:
+    validate(config("Not a valid trove classifier"), "pyproject.toml")
+except ValueError:
+    raise SystemExit(0)
+raise SystemExit(1)
+"""
+    result = subprocess.run(
+        [sys.executable, "-c", script], capture_output=True, text=True
+    )
+    assert result.returncode == 0, result.stderr
