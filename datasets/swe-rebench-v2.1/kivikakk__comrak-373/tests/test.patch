+#[test]
+fn commonmark_avoids_spurious_backslash() {
+    let arena = Arena::new();
+    let options = Options::default();
+    let empty = LineColumn { line: 0, column: 0 };
+
+    let ast = |val: NodeValue| arena.alloc(AstNode::new(RefCell::new(Ast::new(val, empty))));
+    let root = ast(NodeValue::Document);
+
+    let p1 = ast(NodeValue::Paragraph);
+    p1.append(ast(NodeValue::Text("Line 1".to_owned())));
+    root.append(p1);
+
+    root.append(ast(NodeValue::LineBreak));
+
+    let p2 = ast(NodeValue::Paragraph);
+    p2.append(ast(NodeValue::Text("Line 2".to_owned())));
+    root.append(p2);
+
+    let mut output = vec![];
+    cm::format_document(root, &options, &mut output).unwrap();
+
+    let rendered = String::from_utf8(output).unwrap();
+
+    // A hard line break at the end of a block must not be serialized as a
+    // literal backslash: commonmark treats a trailing backslash as a literal
+    // backslash rather than a line break, so it would show up in the output.
+    // Both reverting to cmark-gfm's two-trailing-spaces behavior and omitting
+    // the meaningless break are acceptable resolutions, so only assert the
+    // absence of the spurious backslash here.
+    assert!(
+        !rendered.contains('\\'),
+        "hard line break at end of block produced a spurious backslash: {rendered:?}"
+    );
+    assert!(
+        rendered.contains("Line 1") && rendered.contains("Line 2"),
+        "paragraphs around the line break were not rendered: {rendered:?}"
+    );
+}
+
+#[test]
+fn commonmark_avoids_backslash_at_end_of_block() {
+    let arena = Arena::new();
+    let options = Options::default();
+    let empty = LineColumn { line: 0, column: 0 };
+
+    let ast = |val: NodeValue| arena.alloc(AstNode::new(RefCell::new(Ast::new(val, empty))));
+    let root = ast(NodeValue::Document);
+
+    let p = ast(NodeValue::Paragraph);
+    p.append(ast(NodeValue::Text("Line 1".to_owned())));
+    p.append(ast(NodeValue::LineBreak));
+    root.append(p);
+
+    let mut output = vec![];
+    cm::format_document(root, &options, &mut output).unwrap();
+
+    let rendered = String::from_utf8(output).unwrap();
+
+    // A hard line break that is the last child of a block must not be
+    // serialized as a literal backslash, since commonmark treats a trailing
+    // backslash as a literal backslash rather than a line break.
+    assert!(
+        !rendered.contains('\\'),
+        "hard line break at end of block produced a spurious backslash: {rendered:?}"
+    );
+    assert!(
+        rendered.contains("Line 1"),
+        "paragraph content was not rendered: {rendered:?}"
+    );
+}
+
 #[test_case("$$x^2$$ and $1 + 2$ and $`y^2`$", "$$x^2$$ and $1 + 2$ and $`y^2`$\n")]
