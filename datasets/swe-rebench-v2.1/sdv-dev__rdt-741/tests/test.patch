+    def test_fit_enforce_min_max_values_through_reverse_transform(self):
+        """Fitting with enforcement clips reversed values to the fitted date range."""
+        transformer = UnixTimestampEncoder(enforce_min_max_values=True)
+        data = pd.DataFrame({'date': ['2020-01-01', '2020-02-01', '2020-03-01']})
+
+        transformer.fit(data, column='date')
+        transformed = transformer.transform(data)
+        lower = transformed['date'].min()
+        upper = transformed['date'].max()
+        transformed.loc[transformed['date'] == lower, 'date'] = lower - 1e17
+        transformed.loc[transformed['date'] == upper, 'date'] = upper + 1e17
+
+        result = transformer.reverse_transform(transformed)
+
+        pd.testing.assert_series_equal(
+            pd.to_datetime(result['date']), pd.to_datetime(data['date'])
+        )
