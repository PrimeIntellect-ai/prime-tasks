+// assertAPIResponseMetadataPerMetricLimit checks that every metric in the response
+// holds between one and limit metadata definitions, and that each returned definition
+// is one of the definitions the targets actually exposed for that metric.
+func assertAPIResponseMetadataPerMetricLimit(t *testing.T, got interface{}, exposed []scrape.MetricMetadata, limit int) {
+	t.Helper()
+
+	expected := map[string]map[metadata]struct{}{}
+	for _, m := range exposed {
+		if expected[m.Metric] == nil {
+			expected[m.Metric] = map[metadata]struct{}{}
+		}
+		expected[m.Metric][metadata{Type: m.Type, Help: m.Help, Unit: m.Unit}] = struct{}{}
+	}
+
+	response := got.(map[string][]metadata)
+	for metric, entries := range response {
+		if len(entries) == 0 {
+			t.Errorf("metric %q has no metadata definitions, expected at least one", metric)
+		}
+		if len(entries) > limit {
+			t.Errorf("metric %q has %d metadata definitions, exceeding limit %d", metric, len(entries), limit)
+		}
+		for _, e := range entries {
+			if _, ok := expected[metric][e]; !ok {
+				t.Errorf("metric %q returned metadata %+v that no target exposed for it", metric, e)
+			}
+		}
+	}
+}
