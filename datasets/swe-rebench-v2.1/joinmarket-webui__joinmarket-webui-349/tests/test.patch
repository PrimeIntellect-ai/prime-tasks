+import React from 'react'
+import { render, screen, waitFor } from '../testUtils'
+import { act } from 'react-dom/test-utils'
+import user from '@testing-library/user-event'
+
+import { Utxos, Utxo, WalletContext } from '../context/WalletContext'
+import { ServiceInfoContext } from '../context/ServiceInfoContext'
+import { ServiceConfigContext } from '../context/ServiceConfigContext'
+import Send from '../components/Send'
+import * as Api from '../libs/JmWalletApi'
+
+jest.mock('../libs/JmWalletApi', () => ({
+  ...jest.requireActual('../libs/JmWalletApi'),
+  postCoinjoin: jest.fn(),
+}))
+
+// The hook under test is loaded lazily so that the send-page behaviour below can be
+// exercised independently of the hook module.
+const loadCoinjoinPrecondition = () => require('./CoinjoinPrecondition')
+
+describe('useCoinjoinPreconditionSummary', () => {
+  it('exports the required collaborative transaction preconditions', () => {
+    const { COINJOIN_PRECONDITIONS } = loadCoinjoinPrecondition()
+
+    expect(COINJOIN_PRECONDITIONS).toEqual({
+      MIN_NUMBER_OF_UTXOS: 1,
+      MIN_CONFIRMATIONS_OF_SINGLE_UTXO: 5,
+      MIN_OVERALL_REMAINING_RETRIES: 1,
+    })
+  })
+
+  function setup(utxos: Utxos) {
+    const { useCoinjoinPreconditionSummary } = loadCoinjoinPrecondition()
+    const returnVal: { data: any } = { data: undefined }
+    const TestComponent: React.FunctionComponent = () => {
+      returnVal.data = useCoinjoinPreconditionSummary(utxos)
+      return <></>
+    }
+
+    render(<TestComponent />)
+
+    return returnVal
+  }
+
+  it('should NOT be fulfilled on empty utxos', () => {
+    const { COINJOIN_PRECONDITIONS } = loadCoinjoinPrecondition()
+    let preconditionSummary: any
+
+    act(() => {
+      preconditionSummary = setup([]).data
+    })
+
+    expect(preconditionSummary).toEqual({
+      isFulfilled: false,
+      numberOfMissingUtxos: COINJOIN_PRECONDITIONS.MIN_NUMBER_OF_UTXOS,
+      amountOfMissingConfirmations: COINJOIN_PRECONDITIONS.MIN_CONFIRMATIONS_OF_SINGLE_UTXO,
+      amountOfMissingOverallRetries: COINJOIN_PRECONDITIONS.MIN_OVERALL_REMAINING_RETRIES,
+    })
+  })
+
+  it('should be fulfilled on suitable utxos', () => {
+    const { COINJOIN_PRECONDITIONS } = loadCoinjoinPrecondition()
+    let preconditionSummary: any
+
+    act(() => {
+      preconditionSummary = setup([
+        {
+          frozen: false,
+          confirmations: COINJOIN_PRECONDITIONS.MIN_CONFIRMATIONS_OF_SINGLE_UTXO,
+          tries_remaining: COINJOIN_PRECONDITIONS.MIN_OVERALL_REMAINING_RETRIES,
+        } as Utxo,
+      ]).data
+    })
+
+    expect(preconditionSummary).toEqual({
+      isFulfilled: true,
+      numberOfMissingUtxos: 0,
+      amountOfMissingConfirmations: 0,
+      amountOfMissingOverallRetries: 0,
+    })
+  })
+
+  it('should NOT be fulfilled on utxos with to little confirmations', () => {
+    const { COINJOIN_PRECONDITIONS } = loadCoinjoinPrecondition()
+    let preconditionSummary: any
+
+    act(() => {
+      preconditionSummary = setup([
+        {
+          frozen: false,
+          confirmations: COINJOIN_PRECONDITIONS.MIN_CONFIRMATIONS_OF_SINGLE_UTXO - 1,
+          tries_remaining: COINJOIN_PRECONDITIONS.MIN_OVERALL_REMAINING_RETRIES,
+        } as Utxo,
+        {
+          frozen: false,
+          confirmations: 0,
+          tries_remaining: COINJOIN_PRECONDITIONS.MIN_OVERALL_REMAINING_RETRIES,
+        } as Utxo,
+      ]).data
+    })
+
+    expect(preconditionSummary).toEqual({
+      isFulfilled: false,
+      numberOfMissingUtxos: 0,
+      amountOfMissingConfirmations: 1,
+      amountOfMissingOverallRetries: 0,
+    })
+  })
+
+  it('should NOT be fulfilled on utxos with to little remaining retries', () => {
+    const { COINJOIN_PRECONDITIONS } = loadCoinjoinPrecondition()
+    let preconditionSummary: any
+
+    act(() => {
+      preconditionSummary = setup([
+        {
+          frozen: false,
+          confirmations: COINJOIN_PRECONDITIONS.MIN_CONFIRMATIONS_OF_SINGLE_UTXO,
+          tries_remaining: COINJOIN_PRECONDITIONS.MIN_OVERALL_REMAINING_RETRIES - 1,
+        } as Utxo,
+        {
+          frozen: false,
+          confirmations: COINJOIN_PRECONDITIONS.MIN_CONFIRMATIONS_OF_SINGLE_UTXO,
+          tries_remaining: 0,
+        } as Utxo,
+      ]).data
+    })
+
+    expect(preconditionSummary).toEqual({
+      isFulfilled: false,
+      numberOfMissingUtxos: 0,
+      amountOfMissingConfirmations: 0,
+      amountOfMissingOverallRetries: 1,
+    })
+  })
+
+  it('should exclude frozen utxos from the summary', () => {
+    const { COINJOIN_PRECONDITIONS } = loadCoinjoinPrecondition()
+    let preconditionSummary: any
+
+    act(() => {
+      preconditionSummary = setup([
+        {
+          frozen: true,
+          confirmations: 100,
+          tries_remaining: 100,
+        } as Utxo,
+        {
+          frozen: false,
+          confirmations: 0,
+          tries_remaining: 0,
+        } as Utxo,
+      ]).data
+    })
+
+    expect(preconditionSummary).toEqual({
+      isFulfilled: false,
+      numberOfMissingUtxos: 0,
+      amountOfMissingConfirmations: COINJOIN_PRECONDITIONS.MIN_CONFIRMATIONS_OF_SINGLE_UTXO,
+      amountOfMissingOverallRetries: COINJOIN_PRECONDITIONS.MIN_OVERALL_REMAINING_RETRIES,
+    })
+  })
+
+  it('should exclude time-locked utxos from the summary', () => {
+    const { COINJOIN_PRECONDITIONS } = loadCoinjoinPrecondition()
+    let preconditionSummary: any
+
+    const futureTimestampInSeconds = Math.floor(Date.now() / 1_000) + 60 * 60 * 24
+
+    act(() => {
+      preconditionSummary = setup([
+        {
+          frozen: false,
+          confirmations: 100,
+          tries_remaining: 100,
+          locktime: '2999-12',
+          path: `m/84'/1'/0'/0/1:${futureTimestampInSeconds}`,
+        } as Utxo,
+        {
+          frozen: false,
+          confirmations: 0,
+          tries_remaining: 0,
+        } as Utxo,
+      ]).data
+    })
+
+    expect(preconditionSummary).toEqual({
+      isFulfilled: false,
+      numberOfMissingUtxos: 0,
+      amountOfMissingConfirmations: COINJOIN_PRECONDITIONS.MIN_CONFIRMATIONS_OF_SINGLE_UTXO,
+      amountOfMissingOverallRetries: COINJOIN_PRECONDITIONS.MIN_OVERALL_REMAINING_RETRIES,
+    })
+  })
+})
+
+describe('Send page collaborative transaction preconditions', () => {
+  const MIN_CONFIRMATIONS_OF_SINGLE_UTXO = 5
+  const MIN_OVERALL_REMAINING_RETRIES = 1
+
+  const walletInfoWith = (utxos: Utxo[]) => ({
+    data: {
+      utxos: { utxos },
+      display: {
+        walletinfo: {
+          wallet_name: 'test.jmdat',
+          total_balance: '1.00000000',
+          available_balance: '1.00000000',
+          accounts: [{ account: '0', account_balance: '1.00000000', available_balance: '1.00000000', branches: [] }],
+        },
+      },
+    },
+  })
+
+  const renderSend = (utxos: Utxo[]) => {
+    const walletInfo = walletInfoWith(utxos)
+
+    return render(
+      <WalletContext.Provider
+        value={{
+          currentWallet: { name: 'test.jmdat', token: 'token' },
+          setCurrentWallet: jest.fn(),
+          currentWalletInfo: walletInfo,
+          reloadCurrentWalletInfo: jest.fn().mockResolvedValue(walletInfo),
+        }}
+      >
+        <ServiceInfoContext.Provider
+          value={{
+            serviceInfo: {
+              sessionActive: true,
+              makerRunning: false,
+              coinjoinInProgress: false,
+              walletName: 'test.jmdat',
+            },
+            reloadServiceInfo: jest.fn().mockResolvedValue({}),
+          }}
+        >
+          <ServiceConfigContext.Provider
+            value={{
+              loadConfigValue: jest
+                .fn()
+                .mockResolvedValue({ key: { section: 'POLICY', field: 'minimum_makers' }, value: '4' }),
+            }}
+          >
+            <Send />
+          </ServiceConfigContext.Provider>
+        </ServiceInfoContext.Provider>
+      </WalletContext.Provider>
+    )
+  }
+
+  const fillValidForm = async () => {
+    await waitFor(() => expect(screen.getByPlaceholderText('send.placeholder_recipient')).toBeInTheDocument())
+    user.type(screen.getByPlaceholderText('send.placeholder_recipient'), 'bc1qexampleaddress')
+    user.type(screen.getByPlaceholderText('send.placeholder_amount'), '1000')
+  }
+
+  beforeEach(() => {
+    ;(Api.postCoinjoin as jest.Mock).mockReset()
+    ;(Api.postCoinjoin as jest.Mock).mockResolvedValue({ ok: true, json: () => Promise.resolve({}) })
+  })
+
+  it('should not process a collaborative send request when the source jar has no sufficiently confirmed utxo', async () => {
+    renderSend([
+      {
+        frozen: false,
+        confirmations: MIN_CONFIRMATIONS_OF_SINGLE_UTXO - 1,
+        tries_remaining: MIN_OVERALL_REMAINING_RETRIES,
+        mixdepth: 0,
+        value: 100_000,
+      } as Utxo,
+    ])
+
+    await fillValidForm()
+    user.click(screen.getByText('send.button_send'))
+
+    await act(async () => {
+      await new Promise((resolve) => setTimeout(resolve, 50))
+    })
+
+    expect(Api.postCoinjoin).not.toHaveBeenCalled()
+  })
+
+  it('should process a collaborative send request when the source jar has a sufficiently confirmed utxo', async () => {
+    renderSend([
+      {
+        frozen: false,
+        confirmations: MIN_CONFIRMATIONS_OF_SINGLE_UTXO,
+        tries_remaining: MIN_OVERALL_REMAINING_RETRIES,
+        mixdepth: 0,
+        value: 100_000,
+      } as Utxo,
+    ])
+
+    await fillValidForm()
+    user.click(screen.getByText('send.button_send'))
+
+    await waitFor(() => expect(Api.postCoinjoin).toHaveBeenCalled())
+  })
+})
