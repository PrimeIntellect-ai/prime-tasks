+func TestRenderedMarkdownPreservesAsterisks(t *testing.T) {
+	inputs := []string{
+		"**Please, read this line before starting**",
+		"* lorem * ipsum *dolor*consectetur* `adipi * scing *elit*sit*`",
+		"** lorem ** ipsum **dolor**consectetur** `adipi ** scing **elit**sit**`",
+		"*** lorem *** ipsum ***dolor***consectetur*** `adipi *** scing ***elit***sit***`",
+		"**lorem ipsum dolor consectetur adipi scing elit sit**",
+	}
+	moduleDir := t.TempDir()
+	comment := "/**\n* " + strings.Join(inputs, "\n* ") + "\n*/\n"
+	err := ioutil.WriteFile(filepath.Join(moduleDir, "main.tf"), []byte(comment), 0600)
+	assert.NoError(t, err)
+
+	cmd := exec.Command("go", "run", ".", "markdown", moduleDir)
+	cmd.Dir = filepath.Join("..", "..")
+	output, err := cmd.CombinedOutput()
+	assert.NoError(t, err, string(output))
+	for _, input := range inputs {
+		assert.Contains(t, string(output), input)
+	}
+}
