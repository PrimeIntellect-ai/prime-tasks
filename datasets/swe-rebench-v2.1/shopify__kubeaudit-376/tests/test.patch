+// TestFixAppArmorInitContainer verifies that autofix does not remove a valid
+// AppArmor annotation that refers to an initContainer. It applies the pending
+// fixes produced by the audit directly to the resource so it does not depend on
+// manifest encoding.
+func TestFixAppArmorInitContainer(t *testing.T) {
+	pod := k8s.NewPod()
+	pod.Name = "pod"
+	pod.Spec.Containers = []k8s.ContainerV1{{Name: "container", Image: "scratch"}}
+	pod.Spec.InitContainers = []k8s.ContainerV1{{Name: "init-container", Image: "scratch"}}
+	pod.Annotations = map[string]string{
+		ContainerAnnotationKeyPrefix + "container":      "localhost/someval",
+		ContainerAnnotationKeyPrefix + "init-container": "localhost/someval",
+	}
+
+	results, err := New().Audit(pod, nil)
+	require.NoError(t, err)
+
+	for _, result := range results {
+		if result == nil {
+			continue
+		}
+		result.Fix(pod)
+	}
+
+	annotations := k8s.GetAnnotations(pod)
+	assert.Contains(t, annotations, ContainerAnnotationKeyPrefix+"init-container",
+		"autofix must not remove a valid AppArmor annotation that refers to an initContainer")
+}
+
+// TestAuditAppArmorInitContainers verifies the general requirement that kubeaudit
+// applies security controls to initContainers the same way it does to regular
+// containers, not just for the AppArmor auditor. It builds a Pod in memory so it
+// does not depend on any fixture files.
+func TestAuditAppArmorInitContainers(t *testing.T) {
+	pod := k8s.NewPod()
+	pod.Name = "pod"
+	pod.Spec.Containers = []k8s.ContainerV1{{Name: "container", Image: "scratch"}}
+	pod.Spec.InitContainers = []k8s.ContainerV1{{Name: "init-container", Image: "scratch"}}
+
+	auditors := map[string]kubeaudit.Auditable{
+		"apparmor":     New(),
+		"capabilities": capabilities.New(capabilities.Config{}),
+		"nonroot":      nonroot.New(),
+		"privileged":   privileged.New(),
+	}
+
+	for name, auditable := range auditors {
+		name, auditable := name, auditable
+		t.Run(name, func(t *testing.T) {
+			results, err := auditable.Audit(pod, nil)
+			require.NoError(t, err)
+
+			auditedContainers := map[string]bool{}
+			for _, result := range results {
+				if result == nil {
+					continue
+				}
+				auditedContainers[result.Metadata["Container"]] = true
+			}
+
+			assert.True(t, auditedContainers["container"], "expected the regular container to be audited by %s", name)
+			assert.True(t, auditedContainers["init-container"], "expected the initContainer to be audited by %s", name)
+		})
+	}
+}
