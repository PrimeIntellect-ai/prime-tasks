+// writeManifest writes the given manifest to a temporary directory and returns
+// the directory and file name so it can be used with the shared test helpers.
+func writeManifest(t *testing.T, content string) (dir, file string) {
+	t.Helper()
+	dir = t.TempDir()
+	file = "manifest.yml"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, file), []byte(content), 0644))
+	return dir, file
+}
