+// TestAuditAppArmorInitContainer verifies that the AppArmor auditor treats an
+// annotation that refers to an existing initContainer as valid, and that it
+// still reports a missing annotation for an initContainer.
+func TestAuditAppArmorInitContainer(t *testing.T) {
+	t.Run("annotation refers to existing initContainer", func(t *testing.T) {
+		dir, file := writeManifest(t, initContainerEnabledManifest)
+		test.AuditManifest(t, dir, file, New(), nil)
+	})
+
+	t.Run("initContainer annotation missing", func(t *testing.T) {
+		dir, file := writeManifest(t, initContainerMissingManifest)
+		test.AuditManifest(t, dir, file, New(), []string{AppArmorAnnotationMissing})
+	})
+}
