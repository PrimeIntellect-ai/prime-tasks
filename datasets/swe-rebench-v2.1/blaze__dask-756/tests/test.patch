+def test_random_chunk_streams_are_distinct():
+    # These positions collide when each chunk is assigned an independent
+    # 32-bit randint seed from this random state.
+    repeated_seed_chunks = (18628, 36310)
+    values = da.random.RandomState(4321).random_sample(
+        size=(200000,), chunks=(2,)
+    )
+    positions = [2 * i + offset
+                 for i in repeated_seed_chunks for offset in (0, 1)]
+    chunks = values[positions].compute().reshape((2, 2))
+
+    assert not np.array_equal(chunks[0], chunks[1])
