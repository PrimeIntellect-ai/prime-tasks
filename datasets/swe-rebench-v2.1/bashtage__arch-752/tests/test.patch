+def test_one_step_simulation_exog_variance_uses_aligned_residuals():
+    y = np.array([0.0, 7.0, 2.0, 5.0, 9.0, 3.0, 8.0])
+    x = np.arange(y.size, dtype=float)
+    model = arch_model(
+        y, x=x, mean="ARX", vol="GARCH", lags=1, p=1, q=0, rescale=False
+    )
+    model.distribution = Normal(seed=42)
+    result = model.fix([0.0, 0.3, 0.2, 0.0, 0.5])
+
+    forecast = result.forecast(
+        horizon=1,
+        start=1,
+        method="simulation",
+        simulations=1,
+        x=x[:, None],
+        align="origin",
+    )
+
+    residuals = y[1:] - 0.3 * y[:-1] - 0.2 * x[1:]
+    assert_allclose(forecast.variance.values.squeeze(), 0.5 * residuals**2)
