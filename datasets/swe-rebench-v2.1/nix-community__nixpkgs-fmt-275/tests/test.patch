diff --git a/test_data/indent_tabs-2.good.nix b/test_data/indent_tabs-2.good.nix
new file mode 100644
index 0000000..0c5ea05
--- /dev/null
+++ b/test_data/indent_tabs-2.good.nix
@@ -0,0 +1,24 @@
+args@{ z, }:
+
+{
+  a = "1";
+  b = { } // { };
+  c = z.y;
+  d = 1.2;
+  e = 5;
+  f = ./test;
+  g = true;
+  h = null;
+  i = [ 1 ./example.bin { hello = "world"; } ];
+  j = 5 * 5;
+  k = z ? fs;
+  l = z ++ z;
+  m = - 324;
+  n = z z;
+  o = import <nixpkgs>;
+  p = with z; "fdsfs";
+  q = ''
+      ${5+5}
+    	'';
+  r = " f${z}ds ";
+}
