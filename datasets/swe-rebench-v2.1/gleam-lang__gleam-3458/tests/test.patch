+#[test]
+fn goto_definition_unqualified_function() {
+    let code = "
+import wibble.{wobble}
+fn main() {
+  wobble()
+}
+";
+
+    let location = definition(
+        TestProject::for_source(code).add_module("wibble", "pub fn wobble() {}"),
+        Position::new(3, 5),
+    )
+    .expect("goto definition should return a location");
+
+    // The definition lives in the imported module, so the returned location
+    // must point at `wibble.gleam` rather than the current file.
+    assert_eq!(
+        location.uri,
+        Url::from_file_path(Utf8PathBuf::from(if cfg!(target_family = "windows") {
+            r"\\?\C:\src\wibble.gleam"
+        } else {
+            "/src/wibble.gleam"
+        }))
+        .unwrap()
+    );
+}
