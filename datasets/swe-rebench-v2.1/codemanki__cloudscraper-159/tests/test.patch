+/* eslint-env node, mocha */
+'use strict';
+
+var assert      = require('assert');
+var cloudscraper = require('../index');
+var helper      = require('./helper');
+
+describe('Cloudscraper email protection', function () {
+  var uri;
+  var protectedPage;
+
+  before(function (done) {
+    helper.listen(function () {
+      uri = helper.resolve('/test');
+      protectedPage = helper.getFixture('page_with_emails.html');
+      done();
+    });
+  });
+
+  after(function () {
+    helper.server.close();
+  });
+
+  afterEach(function () {
+    helper.reset();
+  });
+
+  it('returns decoded email content to the callback and promise when enabled', function (done) {
+    helper.router.get('/test', function (req, res) {
+      res.send(protectedPage);
+    });
+
+    var scraper = cloudscraper.defaults({ decodeEmails: true });
+    var callbackBody;
+    var callbackError;
+
+    scraper.get(uri, function (error, response, body) {
+      if (error) {
+        callbackError = error;
+        return;
+      }
+
+      try {
+        assert(body.includes('cloudscraper@example-site.dev'));
+        assert(!body.includes('[email&#160;protected]'));
+        callbackBody = body;
+      } catch (assertionError) {
+        callbackError = assertionError;
+      }
+    }).then(function (body) {
+      if (callbackError) {
+        return done(callbackError);
+      }
+
+      try {
+        assert.strictEqual(body, callbackBody);
+        done();
+      } catch (assertionError) {
+        done(assertionError);
+      }
+    }, done);
+  });
+
+  it('leaves protected content unchanged by default', function (done) {
+    helper.router.get('/test', function (req, res) {
+      res.send(protectedPage);
+    });
+
+    cloudscraper.get(uri).then(function (body) {
+      try {
+        assert(body.includes('data-cfemail='));
+        assert(!body.includes('cloudscraper@example-site.dev'));
+        done();
+      } catch (assertionError) {
+        done(assertionError);
+      }
+    }, done);
+  });
+});
