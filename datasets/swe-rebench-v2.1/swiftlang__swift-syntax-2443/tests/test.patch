       """
     )
   }
+
+  func testForStatementWithUnexpectedTokenBeforeInKeyword() {
+    assertParse(
+      "for var elem1️⃣? in arr { }",
+      diagnostics: [
+        DiagnosticSpec(message: "unexpected code '?' in 'for' statement")
+      ]
+    )
+
+    var parser = Parser("for var elem? in arr { }")
+    let sourceFile = SourceFileSyntax.parse(from: &parser)
+    let forStatement = sourceFile.statements.first?.item.as(ForStmtSyntax.self)
+    XCTAssertEqual(forStatement?.sequence.trimmedDescription, "arr")
+    XCTAssertEqual(forStatement?.inKeyword.presence, .present)
+    XCTAssertEqual(forStatement?.inKeyword.text, "in")
+    XCTAssertFalse(
+      (forStatement?.body.unexpectedBeforeLeftBrace?.trimmedDescription ?? "").contains("in arr")
+    )
+  }
 }
