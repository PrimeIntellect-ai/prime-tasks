+package command
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/google/yamlfmt"
+	"github.com/google/yamlfmt/formatters/basic"
+)
+
+// testFormatterFactory is a minimal formatter factory used to verify that a
+// specifically requested formatter type is selected.
+type testFormatterFactory struct {
+	typ string
+}
+
+func (f *testFormatterFactory) Type() string { return f.typ }
+
+func (f *testFormatterFactory) NewFormatter(config map[string]interface{}) (yamlfmt.Formatter, error) {
+	return &testFormatter{typ: f.typ}, nil
+}
+
+type testFormatter struct {
+	typ string
+}
+
+func (f *testFormatter) Type() string { return f.typ }
+
+func (f *testFormatter) Format(content []byte) ([]byte, error) {
+	return []byte("formatted-by-" + f.typ + "\n"), nil
+}
+
+func (f *testFormatter) ConfigMap() (map[string]any, error) {
+	return map[string]any{"type": f.typ}, nil
+}
+
+// formatContent runs the command in format mode over a single temporary file
+// containing content and returns the resulting file contents.
+func formatContent(t *testing.T, c *Command, content string) string {
+	t.Helper()
+	dir := t.TempDir()
+	path := filepath.Join(dir, "test.yaml")
+	if err := os.WriteFile(path, []byte(content), 0644); err != nil {
+		t.Fatalf("failed to write test file: %v", err)
+	}
+	c.Operation = yamlfmt.OperationFormat
+	c.Config.Include = []string{path}
+	if err := c.Run(); err != nil {
+		t.Fatalf("Run() returned error: %v", err)
+	}
+	out, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("failed to read test file: %v", err)
+	}
+	return string(out)
+}
+
+// A line_ending set in the formatter settings must take precedence over the
+// top-level line_ending setting.
+func TestFormatterLineEndingOverridesTopLevel(t *testing.T) {
+	c := &Command{
+		Config: &Config{
+			LineEnding: yamlfmt.LineBreakStyleCRLF,
+			FormatterConfig: &FormatterConfig{
+				FormatterSettings: map[string]any{
+					"line_ending": yamlfmt.LineBreakStyleLF,
+				},
+			},
+		},
+		Registry: yamlfmt.NewFormatterRegistry(&basic.BasicFormatterFactory{}),
+	}
+
+	out := formatContent(t, c, "a: 1\n")
+	if strings.Contains(out, "\r\n") {
+		t.Fatalf("expected formatter line_ending lf to override top-level crlf, got CRLF output: %q", out)
+	}
+	if !strings.Contains(out, "\n") {
+		t.Fatalf("expected output to contain a newline, got: %q", out)
+	}
+}
+
+// When the formatter settings do not set line_ending, the top-level
+// line_ending setting must be used.
+func TestFormatterLineEndingFallsBackToTopLevel(t *testing.T) {
+	c := &Command{
+		Config: &Config{
+			LineEnding: yamlfmt.LineBreakStyleCRLF,
+			FormatterConfig: &FormatterConfig{
+				FormatterSettings: map[string]any{},
+			},
+		},
+		Registry: yamlfmt.NewFormatterRegistry(&basic.BasicFormatterFactory{}),
+	}
+
+	out := formatContent(t, c, "a: 1\n")
+	if !strings.Contains(out, "\r\n") {
+		t.Fatalf("expected top-level line_ending crlf to be used, got: %q", out)
+	}
+}
+
+// A non-empty formatter type must select the formatter registered under that
+// type.
+func TestRequestedFormatterTypeIsUsed(t *testing.T) {
+	registry := yamlfmt.NewFormatterRegistry(&basic.BasicFormatterFactory{})
+	registry.Add(&testFormatterFactory{typ: "custom"})
+
+	c := &Command{
+		Config: &Config{
+			LineEnding: yamlfmt.LineBreakStyleLF,
+			FormatterConfig: &FormatterConfig{
+				Type:              "custom",
+				FormatterSettings: map[string]any{},
+			},
+		},
+		Registry: registry,
+	}
+
+	out := formatContent(t, c, "a: 1\n")
+	if !strings.Contains(out, "formatted-by-custom") {
+		t.Fatalf("expected the requested formatter type to be used, got: %q", out)
+	}
+}
+
+// An empty formatter type must use the default formatter.
+func TestEmptyFormatterTypeUsesDefault(t *testing.T) {
+	c := &Command{
+		Config: &Config{
+			LineEnding: yamlfmt.LineBreakStyleLF,
+			FormatterConfig: &FormatterConfig{
+				FormatterSettings: map[string]any{},
+			},
+		},
+		Registry: yamlfmt.NewFormatterRegistry(&basic.BasicFormatterFactory{}),
+	}
+
+	out := formatContent(t, c, "a: 1\n")
+	if strings.Contains(out, "formatted-by-") {
+		t.Fatalf("expected the default formatter to be used, got: %q", out)
+	}
+	if !strings.Contains(out, "a: 1") {
+		t.Fatalf("expected the default formatter to format the content, got: %q", out)
+	}
+}
+
+// Requesting a formatter type that is not registered must fail with an error.
+func TestUnknownFormatterTypeReturnsError(t *testing.T) {
+	c := &Command{
+		Config: &Config{
+			LineEnding: yamlfmt.LineBreakStyleLF,
+			FormatterConfig: &FormatterConfig{
+				Type:              "does-not-exist",
+				FormatterSettings: map[string]any{},
+			},
+		},
+		Registry: yamlfmt.NewFormatterRegistry(&basic.BasicFormatterFactory{}),
+	}
+
+	dir := t.TempDir()
+	path := filepath.Join(dir, "test.yaml")
+	if err := os.WriteFile(path, []byte("a: 1\n"), 0644); err != nil {
+		t.Fatalf("failed to write test file: %v", err)
+	}
+	c.Operation = yamlfmt.OperationFormat
+	c.Config.Include = []string{path}
+
+	if err := c.Run(); err == nil {
+		t.Fatalf("expected an error when the requested formatter type is not registered")
+	}
+}
