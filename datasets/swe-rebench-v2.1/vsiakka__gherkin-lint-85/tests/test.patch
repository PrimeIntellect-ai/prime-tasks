+  var actualErrors = rule.run(parsedFile, undefined, {});
+  var headingErrors = actualErrors.filter(function(error) {
+    return error.line === headingLine;
+  });
+
+  assert.lengthOf(headingErrors, 1, 'the misindented Examples heading is reported');
+
+  var remainingErrors = actualErrors.filter(function(error) {
+    return error.line !== headingLine;
+  });
+  var expected = expectedErrors.map(function(error) {
+    return {
+      rule: rule.name,
+      message: 'Wrong indentation for "' + error.messageElements.element +
+        '", expected indentation level of ' + error.messageElements.expected +
+        ', but got ' + error.messageElements.actual,
+      line: error.line
+    };
+  });
+  assert.sameDeepMembers(remainingErrors, expected);
+}
