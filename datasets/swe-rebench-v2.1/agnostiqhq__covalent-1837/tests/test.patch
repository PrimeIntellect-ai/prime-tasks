index 18d6ced..ec39ef2 100644
--- a/tests/covalent_tests/workflow/electron_test.py
+++ b/tests/covalent_tests/workflow/electron_test.py
@@ -655,3 +655,36 @@ def test_replace_electrons():
     assert (
         workflow.transport_graph.get_node_value(0, "status") == RESULT_STATUS.PENDING_REPLACEMENT
     )
+
+
+def test_electron_pow_dispatch():
+    """A power expression in a lattice graph must compute exponentiation."""
+
+    @ct.electron
+    def g(x):
+        return 42 * x
+
+    @ct.lattice
+    def workflow(x):
+        res = g(x)
+        return res**2
+
+    workflow.build_graph(2)
+
+    graph = workflow.transport_graph.get_internal_graph_copy()
+    op_results = []
+    for node_id in graph.nodes:
+        try:
+            fn = workflow.transport_graph.get_node_value(node_id, "function").get_deserialized()
+        except Exception:
+            continue
+        if callable(fn):
+            # The exponent may be a bound argument of a unary node or a second positional argument.
+            for args in ((3, 2), (3,)):
+                try:
+                    op_results.append(fn(*args))
+                    break
+                except Exception:
+                    pass
+
+    assert 9 in op_results
