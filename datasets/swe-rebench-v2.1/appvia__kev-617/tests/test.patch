+func jsonObject(value interface{}) map[string]interface{} {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		panic(err)
+	}
+	var object map[string]interface{}
+	if err := json.Unmarshal(encoded, &object); err != nil {
+		panic(err)
+	}
+	return object
+}
+
+func jsonMap(value interface{}) map[string]interface{} {
+	return value.(map[string]interface{})
+}
+
+func jsonArray(value interface{}) []interface{} {
+	if value == nil {
+		return nil
+	}
+	return value.([]interface{})
+}
+
+func ingressBackendName(backend map[string]interface{}) string {
+	if service, ok := backend["service"]; ok {
+		return jsonMap(service)["name"].(string)
+	}
+	return backend["serviceName"].(string)
+}
+
+func ingressBackendPort(backend map[string]interface{}) interface{} {
+	if service, ok := backend["service"]; ok {
+		return jsonMap(jsonMap(service)["port"])["number"]
+	}
+	port := backend["servicePort"]
+	if object, ok := port.(map[string]interface{}); ok {
+		if value, found := object["IntVal"]; found {
+			return value
+		}
+		return object["intVal"]
+	}
+	return port
+}
+
+func ingressDefaultBackend(spec map[string]interface{}) map[string]interface{} {
+	if backend, ok := spec["defaultBackend"]; ok {
+		return jsonMap(backend)
+	}
+	return jsonMap(spec["backend"])
+}
