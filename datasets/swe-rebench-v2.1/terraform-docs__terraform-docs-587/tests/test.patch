+func TestLoadOutputsLineEnding(t *testing.T) {
+	tests := []struct {
+		name string
+		path string
+	}{
+		{
+			name: "load module outputs from file with lf line ending",
+			path: "outputs-lf",
+		},
+		{
+			name: "load module outputs from file with crlf line ending",
+			path: "outputs-crlf",
+		},
+	}
+
+	// The generated Markdown must not depend on the line ending used in the
+	// source file. Rendering the equivalent module written with LF line endings
+	// gives the reference document that the CRLF module must also produce.
+	expected := renderMarkdown(t, filepath.Join("testdata", "outputs-lf"))
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert := assert.New(t)
+
+			rendered := renderMarkdown(t, filepath.Join("testdata", tt.path))
+			assert.Equal(expected, rendered)
+		})
+	}
+}
+
+// renderMarkdown runs the terraform-docs CLI against the module at path and
+// returns the generated Markdown document.
+func renderMarkdown(t *testing.T, path string) string {
+	t.Helper()
+
+	cmd := exec.Command("go", "run", "..", "markdown", path)
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("failed to render markdown for %q: %v\n%s", path, err, out)
+	}
+	return string(out)
+}
