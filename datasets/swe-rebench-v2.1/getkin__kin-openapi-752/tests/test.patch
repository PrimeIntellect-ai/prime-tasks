+func TestIssue751(t *testing.T) {
+	schema := &Schema{
+		Type:        "array",
+		UniqueItems: true,
+		Items:       NewStringSchema().NewRef(),
+	}
+	validData := []string{"foo", "bar"}
+	invalidData := []string{"foo", "foo"}
+	invalidItemData := []int{1}
+	require.NoError(t, schema.VisitJSON(validData))
+	require.Error(t, schema.VisitJSON(invalidData))
+	require.Error(t, schema.VisitJSON(invalidItemData))
+}
