+// Captures the messages that are logged at the error level so we can verify
+// that handling a request does not cause a server error.
+const errorLogs: string[] = [];
+
+class CapturingLogger extends Logger {
+  public log(level: string, message: string): this {
+    if (level === 'error') {
+      errorLogs.push(message);
+    }
+    return this;
+  }
+}
+
+const capturingLoggerFactory = {
+  createLogger: (): Logger => new CapturingLogger(),
+};
+
+setGlobalLoggerFactory(capturingLoggerFactory);
+// The server is instantiated from the compiled modules, which have their own logger factory.
+// eslint-disable-next-line global-require, @typescript-eslint/no-var-requires, @typescript-eslint/no-require-imports
+const distLogUtil = require('../../dist/logging/LogUtil');
+distLogUtil.setGlobalLoggerFactory(capturingLoggerFactory);
