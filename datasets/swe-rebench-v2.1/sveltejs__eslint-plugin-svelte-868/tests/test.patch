+import assert from 'assert';
+import { RuleTester } from '../../utils/eslint-compat';
+import plugin from '../../../src/index';
+import { loadTestCases } from '../../utils/utils';
+
+const rule = plugin.rules['no-inspect'];
+
+const tester = new RuleTester({
+	languageOptions: {
+		ecmaVersion: 2020,
+		sourceType: 'module'
+	}
+});
+
+describe('no-inspect', () => {
+	it('is registered as svelte/no-inspect', () => {
+		assert.ok(rule);
+	});
+
+	if (rule) {
+		const cases = loadTestCases('no-inspect');
+
+		// The exact diagnostic wording is not part of the rule's public contract,
+		// so the invalid fixtures only assert how many problems are reported.
+		for (const test of cases.invalid) {
+			test.errors = test.errors.length;
+		}
+
+		tester.run('no-inspect', rule as any, cases);
+	}
+});
