+func TestParameterizedDateTimeTypesInTableStatements(t *testing.T) {
+	for _, typeName := range []string{"datetime", "timestamp"} {
+		t.Run(typeName, func(t *testing.T) {
+			for precision := 0; precision <= 6; precision++ {
+				declaredType := fmt.Sprintf("%s (%d)", typeName, precision)
+				t.Run(fmt.Sprintf("precision_%d", precision), func(t *testing.T) {
+					statements, err := CreateTableStatements("test_table", &schemasv1alpha4.MysqlTableSchema{
+						Columns: []*schemasv1alpha4.MysqlTableColumn{{Name: "created_at", Type: declaredType}},
+					})
+					require.NoError(t, err)
+					assert.Contains(t, strings.Join(statements, "\n"), declaredType)
+				})
+			}
+		})
+	}
+}
+
+func TestParameterizedDateTimeTypesRejectOutOfRangePrecisionInTableStatements(t *testing.T) {
+	for _, typeName := range []string{"datetime", "timestamp"} {
+		t.Run(typeName, func(t *testing.T) {
+			declaredType := fmt.Sprintf("%s (7)", typeName)
+			_, err := CreateTableStatements("test_table", &schemasv1alpha4.MysqlTableSchema{
+				Columns: []*schemasv1alpha4.MysqlTableColumn{{Name: "created_at", Type: declaredType}},
+			})
+			require.Error(t, err)
+			assert.True(t, strings.Contains(err.Error(), fmt.Sprintf("invalid %s precision 7", typeName)))
+		})
+	}
+}
+
