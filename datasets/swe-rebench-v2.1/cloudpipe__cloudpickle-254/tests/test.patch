+    def test_relative_import_inside_staticmethod(self):
+        # A function obtained from a staticmethod that performs a relative
+        # import must remain callable after cloudpickle round-tripping.
+        from .mypkg.mod import Blah
+
+        expected = Blah.func()
+
+        # Make sure the relative import still works after round-tripping
+        cloned_func = pickle_depickle(Blah.func, protocol=self.protocol)
+        assert cloned_func() == expected
+
 
 class Protocol2CloudPickleTest(CloudPickleTest):
 
