+def test_issue_858():
+    # The exact case reported in the issue: rounding 0.99999 up to four
+    # decimal places must not drop a digit.
+    assert format(mp.mpf(0.99999), '.4f') == '1.0000'
+
+    for n in range(2, 15):
+        str_num = '0.' + (n)*'9'
+        fmt_str = '.' + str(n-1) + 'f'
+
+        assert format(mp.mpf(str_num), fmt_str) == format(fp.mpf(str_num), fmt_str)
+
+    assert format(mp.mpf(0.96875), '#.0g') == '1.'
+
