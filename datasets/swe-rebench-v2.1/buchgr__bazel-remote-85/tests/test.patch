+
+func TestHTTPProxyMissingRemoteObjectRespondsNotFound(t *testing.T) {
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Error(w, "Not found", http.StatusNotFound)
+	}))
+	defer upstream.Close()
+
+	baseURL, err := url.Parse(upstream.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cacheDir := testutils.CreateTmpCacheDirs(t)
+	defer os.RemoveAll(cacheDir)
+	localCache := disk.New(cacheDir, 1024)
+	proxyCache := cachehttp.New(baseURL, localCache, upstream.Client(),
+		testutils.NewSilentLogger(), testutils.NewSilentLogger())
+	h := NewHTTPCache(proxyCache, testutils.NewSilentLogger(), testutils.NewSilentLogger())
+
+	_, hash := testutils.RandomDataAndHash(1024)
+	req := httptest.NewRequest(http.MethodGet, "/ac/"+hash, nil)
+	rr := httptest.NewRecorder()
+	h.CacheHandler(rr, req)
+
+	if rr.Code != http.StatusNotFound {
+		t.Errorf("Handler returned status %d for an object missing from the remote cache; want %d",
+			rr.Code, http.StatusNotFound)
+	}
+}
