+describe('autofix with dynamic dependency keys', () => {
+  const { Linter } = require('eslint');
+  const config = {
+    parserOptions: { ecmaVersion: 6, sourceType: 'module' },
+    rules: { 'require-computed-property-dependencies': 'error' },
+  };
+
+  function lint(code) {
+    const linter = new Linter();
+    linter.defineRule('require-computed-property-dependencies', rule);
+    return linter.verifyAndFix(code, config);
+  }
+
+  it('keeps dynamic arguments when adding a missing dependency', () => {
+    const { output } = lint(
+      'Ember.computed(dynamic, ...moreDynamic, function() { return this.undeclared; });'
+    );
+
+    expect(output).toContain('dynamic');
+    expect(output).toContain('...moreDynamic');
+    expect(output).toContain("'undeclared'");
+    expect(lint(output).messages).toEqual([]);
+  });
+
+  it('keeps an identifier dynamic argument when adding a missing dependency', () => {
+    const { output } = lint('Ember.computed(dynamic, function() { return this.undeclared; });');
+
+    expect(output).toContain('dynamic');
+    expect(output).toContain("'undeclared'");
+    expect(lint(output).messages).toEqual([]);
+  });
+});
