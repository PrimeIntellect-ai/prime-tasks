+func TestAllInvalidFunctionSignaturesReported(t *testing.T) {
+	tester := &mockTester{}
+	suite := NewSuite(tester, NewSuiteOptions())
+	suite.AddStep("", nil)
+	suite.AddStep("", func(ctx context.Context) {})
+	suite.AddStep("", func(ctx context.Context) int { return 0 })
+	suite.AddStep("", func() error { return errors.New("") })
+	suite.AddStep("", func(i int) error { return errors.New("") })
+	suite.Run()
+
+	if len(tester.logged) < 5 {
+		t.Errorf("all invalid step functions should be reported, got %d report(s)", len(tester.logged))
+	}
+	if tester.fatalCalled < 1 {
+		t.Errorf("the run should be aborted when there are invalid step functions")
+	}
