+        # copy these keys directly from self to configuration object
+        keys = ['host', 'ssl_ca_cert', 'cert_file', 'key_file']
+        for key in keys:
+            if key in self.__dict__:
+                setattr(self._client_configuration, key, getattr(self, key))
