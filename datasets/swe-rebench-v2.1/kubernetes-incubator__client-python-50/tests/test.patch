+import os
+import tempfile
+import unittest
+from unittest import mock
+
+import yaml
+from kubernetes.client import configuration
+from . import kube_config
+
+
+_ORIGINAL_YAML_LOAD = yaml.load
+
+
+def _safe_load(stream, *args, **kwargs):
+    # PyYAML versions requiring an explicit loader need the safe loader here.
+    return _ORIGINAL_YAML_LOAD(stream, yaml.SafeLoader)
+
+
+class LoadKubeConfigContextTest(unittest.TestCase):
+    def setUp(self):
+        self._temp_files = []
+
+    def tearDown(self):
+        for filename in self._temp_files:
+            os.remove(filename)
+
+    def _config_file(self, current_context='current'):
+        config_dict = {
+            'current-context': current_context,
+            # Deliberately put a different context first: ordering must not
+            # determine which context is loaded by default.
+            'contexts': [
+                {'name': 'other', 'context': {'cluster': 'other-cluster', 'user': 'empty'}},
+                {'name': 'current', 'context': {'cluster': 'current-cluster', 'user': 'empty'}},
+            ],
+            'clusters': [
+                {'name': 'other-cluster', 'cluster': {'server': 'http://other'}},
+                {'name': 'current-cluster', 'cluster': {'server': 'http://current'}},
+            ],
+            'users': [{'name': 'empty', 'user': {'username': 'test', 'password': 'test'}}],
+        }
+        handle, filename = tempfile.mkstemp()
+        self._temp_files.append(filename)
+        with os.fdopen(handle, 'w') as stream:
+            yaml.safe_dump(config_dict, stream)
+        return filename
+
+    def test_load_explicit_context(self):
+        config_file = self._config_file()
+        with mock.patch.object(yaml, 'load', _safe_load):
+            kube_config.load_kube_config(config_file, context='other')
+        self.assertEqual('http://other', configuration.host)
+
+    def test_omitted_context_uses_current_context_not_first_entry(self):
+        config_file = self._config_file()
+        with mock.patch.object(yaml, 'load', _safe_load):
+            kube_config.load_kube_config(config_file)
+        self.assertEqual('http://current', configuration.host)
+
+
+if __name__ == '__main__':
+    unittest.main()
