+#[test]
+fn forbidden_uses_rejects_wildcard_ref_patterns() -> Result<()> {
+    // A repository uses pattern that combines a wildcard with an explicit
+    // ref is not a valid pattern, so the configuration must be rejected.
+    let config_path = std::env::temp_dir().join("zizmor-forbidden-uses-wildcard-ref.yml");
+    std::fs::write(
+        &config_path,
+        "rules:\n  unpinned-uses:\n    config:\n      policies:\n        \"*\": ref-pin\n  forbidden-uses:\n    config:\n      deny:\n        - owner/repo/*@v1\n",
+    )?;
+
+    let result = zizmor()
+        .expects_failure(true)
+        .config(config_path.to_str().unwrap())
+        .input(input_under_test("forbidden-uses/forbidden-uses-menagerie.yml"))
+        .run();
+
+    std::fs::remove_file(&config_path).ok();
+
+    result?;
+
+    Ok(())
+}
+
+#[test]
+fn forbidden_uses_allows_exact_sha_ref_only() -> Result<()> {
+    let sha = "0123456789abcdef0123456789abcdef01234567";
+    let suffix = std::process::id();
+    let config_path = std::env::temp_dir().join(format!("zizmor-forbidden-uses-sha-{suffix}.yml"));
+    let workflow_path = std::env::temp_dir().join(format!(
+        "zizmor-forbidden-uses-sha-{suffix}-workflow.yml"
+    ));
+    std::fs::write(
+        &config_path,
+        format!(
+            "rules:\n  unpinned-uses:\n    config:\n      policies:\n        \"*\": ref-pin\n  forbidden-uses:\n    config:\n      allow:\n        - actions/checkout@{sha}\n"
+        ),
+    )?;
+    std::fs::write(
+        &workflow_path,
+        format!(
+            "name: explicit refs\non: push\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@{sha}\n      - uses: actions/checkout@v4\n"
+        ),
+    )?;
+
+    let result = zizmor()
+        .config(config_path.to_str().unwrap())
+        .input(workflow_path.to_str().unwrap())
+        .run();
+    std::fs::remove_file(&config_path).ok();
+    std::fs::remove_file(&workflow_path).ok();
+
+    let output = result?;
+    assert_eq!(output.matches("error[forbidden-uses]").count(), 1);
+    assert!(output.contains("actions/checkout@v4"));
+
+    Ok(())
+}
+
