+test('match when query is specified with allowUnmocked (#490)', function (t) {
+  nock.cleanAll();
+
+  var nockOpts = { allowUnmocked: true };
+  var searchResponse = 'Matched body';
+
+  var scope = nock('http://www.google.com/', nockOpts)
+    .get('/search')
+    .query({q: 'js'})
+    .reply(200, searchResponse);
+
+  mikealRequest.get('http://www.google.com/search?q=js', function (err, res, body) {
+    scope.done();
+    t.type(err, 'null');
+    t.equal(res.statusCode, 200);
+    t.equal(body, searchResponse);
+    t.end();
+  });
+});
+
+test('regexp paths can include a query string', function (t) {
+  nock.cleanAll();
+
+  var searchResponse = 'Matched query path';
+  var scope = nock('http://www.google.com')
+    .get(/search\?q=js/)
+    .reply(200, searchResponse);
+
+  mikealRequest.get('http://www.google.com/search?q=js', function (err, res, body) {
+    t.error(err);
+    t.equal(res.statusCode, 200);
+    t.equal(body, searchResponse);
+    scope.done();
+    t.end();
+  });
+});
+
+test('allowUnmocked does not match a different query', function (t) {
+  nock.cleanAll();
+
+  var server = http.createServer(function (req, res) {
+    res.end('Unmocked request');
+  });
+
+  server.listen(0, '127.0.0.1', function () {
+    var url = 'http://127.0.0.1:' + server.address().port;
+    var scope = nock(url, { allowUnmocked: true })
+      .get('/search')
+      .query({ q: 'js' })
+      .reply(200, 'Matched body');
+
+    mikealRequest.get(url + '/search?q=other', function (err, res, body) {
+      t.error(err);
+      t.equal(res.statusCode, 200);
+      t.notEqual(body, 'Matched body');
+      t.equal(scope.isDone(), false);
+      server.close(function () {
+        nock.cleanAll();
+        t.end();
+      });
+    });
+  });
+});
