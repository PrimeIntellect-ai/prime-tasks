+    def test_task_with_pydantic_uuid_in_chain(self):
+        """A serialized UUID4 result can be validated by the next task in a chain."""
+
+        class Model(BaseModel):
+            value: UUID4
+
+        from celery import chain
+
+        with self.Celery() as app:
+            app.conf.task_always_eager = True
+
+            @app.task(pydantic=True, pydantic_dump_kwargs={'mode': 'json'})
+            def foo(arg: Model) -> Model:
+                return arg
+
+            value = uuid.uuid4()
+            result = chain(foo.s({'value': value}), foo.s()).apply().get()
+
+            assert result == {'value': str(value)}
+
