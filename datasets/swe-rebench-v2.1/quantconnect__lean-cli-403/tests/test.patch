+from unittest import mock
+
+from click.testing import CliRunner
+
+from lean.commands import lean
+from lean.models.data_providers import DataProvider
+from tests.test_helpers import create_fake_lean_cli_directory
+
+
+def test_backtest_can_use_data_provider() -> None:
+    create_fake_lean_cli_directory()
+
+    # Installing the provider and prompting for its credentials are unrelated to
+    # configuring its backtest environment, so keep this test offline/non-interactive.
+    with mock.patch.object(DataProvider, "ensure_module_installed"), \
+            mock.patch.object(DataProvider, "configure_credentials"):
+        result = CliRunner().invoke(
+            lean, ["backtest", "Python Project", "--data-provider", "Polygon", "--polygon-api-key", "test-key"]
+        )
+
+    assert not (
+        isinstance(result.exception, ValueError)
+        and "not valid for _configure_environment()" in str(result.exception)
+    ), result.output
