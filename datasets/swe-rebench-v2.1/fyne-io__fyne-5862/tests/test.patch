+func TestThemeOverride_LayoutPadding(t *testing.T) {
+	custom, err := theme.FromJSON("{\"Sizes\": {\"padding\": 20}}")
+	assert.NoError(t, err)
+
+	child := canvas.NewRectangle(color.Black)
+	padded := NewPadded(child)
+	o := NewThemeOverride(padded, custom)
+	o.Resize(fyne.NewSize(100, 100))
+
+	assert.Equal(t, fyne.NewPos(20, 20), child.Position())
+	assert.Equal(t, fyne.NewSize(60, 60), child.Size())
