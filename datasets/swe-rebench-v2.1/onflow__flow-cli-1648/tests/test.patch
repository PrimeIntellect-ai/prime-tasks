+
+func TestInitGeneratesCadenceFilesUnderProject(t *testing.T) {
+	workingDir := t.TempDir()
+	previousDir, err := os.Getwd()
+	if !assert.NoError(t, err) {
+		return
+	}
+	if !assert.NoError(t, os.Chdir(workingDir)) {
+		return
+	}
+	t.Cleanup(func() {
+		assert.NoError(t, os.Chdir(previousDir))
+	})
+
+	logger := output.NewStdoutLogger(output.NoneLog)
+	_, err = SetupCommand.Run([]string{"project"}, command.GlobalFlags{}, logger, nil, nil)
+	if !assert.NoError(t, err) {
+		return
+	}
+
+	for _, relativePath := range []string{
+		"cadence/contracts/Counter.cdc",
+		"cadence/scripts/GetCounter.cdc",
+		"cadence/transactions/IncrementCounter.cdc",
+		"cadence/tests/Counter_test.cdc",
+	} {
+		_, err := os.Stat(filepath.Join(workingDir, "project", filepath.FromSlash(relativePath)))
+		assert.NoError(t, err, "expected init artifact at %s", relativePath)
+	}
+}
