+    @Test
+    public void maxSpeedDoesNotRoundAboveConfiguredMaximum() {
+        assertMaxSpeedDoesNotRoundAbove(new FootFlagEncoder(new PMap().putObject("speed_bits", 4).putObject("speed_factor", 1)));
+        assertMaxSpeedDoesNotRoundAbove(new FootFlagEncoder(new PMap().putObject("speed_bits", 4).putObject("speed_factor", 2)));
+        assertMaxSpeedDoesNotRoundAbove(new FootFlagEncoder(new PMap().putObject("speed_bits", 4).putObject("speed_factor", 4)));
+        assertMaxSpeedDoesNotRoundAbove(new CarFlagEncoder(6, 3, 0));
+    }
+
+    private void assertMaxSpeedDoesNotRoundAbove(FlagEncoder encoder) {
+        EncodingManager em = EncodingManager.create(encoder);
+        GraphHopperStorage graph = new GraphBuilder(em).create();
+        double maximum = encoder.getMaxSpeed();
+        EdgeIteratorState edge = graph.edge(0, 1).setDistance(100).set(encoder.getAverageSpeedEnc(), maximum);
+        assertTrue(edge.get(encoder.getAverageSpeedEnc()) <= maximum,
+                "decoded speed must not exceed the encoder's maximum of " + maximum);
+    }
