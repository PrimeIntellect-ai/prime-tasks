+func TestSeedControllerManagerProxyEnvironment(t *testing.T) {
+	const (
+		sharedHTTPProxy = "http://shared-proxy.example.com:3128"
+		sharedNoProxy   = "shared.example.com"
+		seedAHTTPProxy  = "http://seed-a-proxy.example.com:8080"
+		seedANoProxy    = "seed-a.example.internal"
+		seedBHTTPProxy  = "http://seed-b-proxy.example.com:9090"
+		seedBNoProxy    = "seed-b.example.internal"
+	)
+
+	cfg := &kubermaticv1.KubermaticConfiguration{
+		ObjectMeta: metav1.ObjectMeta{Name: "kubermatic", Namespace: "kubermatic"},
+		Spec: kubermaticv1.KubermaticConfigurationSpec{
+			Proxy: kubermaticv1.KubermaticProxyConfiguration{
+				HTTP:    sharedHTTPProxy,
+				HTTPS:   sharedHTTPProxy,
+				NoProxy: sharedNoProxy,
+			},
+			SeedController: kubermaticv1.KubermaticSeedControllerConfiguration{
+				PProfEndpoint: pointer.String(":6600"),
+			},
+		},
+	}
+
+	newSeed := func(name string, proxy *kubermaticv1.ProxySettings) *kubermaticv1.Seed {
+		return &kubermaticv1.Seed{
+			ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: "kubermatic"},
+			Spec: kubermaticv1.SeedSpec{
+				ProxySettings: proxy,
+			},
+		}
+	}
+
+	// seedControllerManagerEnv renders the seed-controller-manager deployment
+	// for the given seed and returns the environment variables it receives.
+	seedControllerManagerEnv := func(t *testing.T, seed *kubermaticv1.Seed) map[string]string {
+		t.Helper()
+
+		_, creator := kubermaticseed.SeedControllerManagerDeploymentCreator("", kubermatic.Versions{}, cfg, seed)()
+		deployment, err := creator(&appsv1.Deployment{})
+		if err != nil {
+			t.Fatalf("failed to create seed-controller-manager deployment: %v", err)
+		}
+
+		env := map[string]string{}
+		for _, container := range deployment.Spec.Template.Spec.Containers {
+			for _, e := range container.Env {
+				env[e.Name] = e.Value
+			}
+		}
+
+		return env
+	}
+
+	containsEntry := func(list, entry string) bool {
+		for _, item := range strings.Split(list, ",") {
+			if strings.TrimSpace(item) == entry {
+				return true
+			}
+		}
+		return false
+	}
+
+	t.Run("seed with its own proxy uses the seed settings instead of the shared configuration", func(t *testing.T) {
+		seed := newSeed("seed-a", &kubermaticv1.ProxySettings{
+			HTTPProxy: kubermaticv1.NewProxyValue(seedAHTTPProxy),
+			NoProxy:   kubermaticv1.NewProxyValue(seedANoProxy),
+		})
+
+		env := seedControllerManagerEnv(t, seed)
+
+		if got := env["HTTP_PROXY"]; got != seedAHTTPProxy {
+			t.Errorf("expected HTTP_PROXY %q from the seed, got %q", seedAHTTPProxy, got)
+		}
+		if got := env["HTTPS_PROXY"]; got != seedAHTTPProxy {
+			t.Errorf("expected HTTPS_PROXY %q from the seed, got %q", seedAHTTPProxy, got)
+		}
+		if !containsEntry(env["NO_PROXY"], seedANoProxy) {
+			t.Errorf("expected NO_PROXY to contain %q from the seed, got %q", seedANoProxy, env["NO_PROXY"])
+		}
+		if containsEntry(env["NO_PROXY"], sharedNoProxy) {
+			t.Errorf("expected NO_PROXY not to contain the shared configuration value %q, got %q", sharedNoProxy, env["NO_PROXY"])
+		}
+	})
+
+	t.Run("different seeds receive their own proxy settings", func(t *testing.T) {
+		seedA := seedControllerManagerEnv(t, newSeed("seed-a", &kubermaticv1.ProxySettings{
+			HTTPProxy: kubermaticv1.NewProxyValue(seedAHTTPProxy),
+			NoProxy:   kubermaticv1.NewProxyValue(seedANoProxy),
+		}))
+		seedB := seedControllerManagerEnv(t, newSeed("seed-b", &kubermaticv1.ProxySettings{
+			HTTPProxy: kubermaticv1.NewProxyValue(seedBHTTPProxy),
+			NoProxy:   kubermaticv1.NewProxyValue(seedBNoProxy),
+		}))
+
+		if got := seedA["HTTP_PROXY"]; got != seedAHTTPProxy {
+			t.Errorf("seed-a: expected HTTP_PROXY %q, got %q", seedAHTTPProxy, got)
+		}
+		if got := seedB["HTTP_PROXY"]; got != seedBHTTPProxy {
+			t.Errorf("seed-b: expected HTTP_PROXY %q, got %q", seedBHTTPProxy, got)
+		}
+		if !containsEntry(seedA["NO_PROXY"], seedANoProxy) || containsEntry(seedA["NO_PROXY"], seedBNoProxy) {
+			t.Errorf("seed-a: unexpected NO_PROXY %q", seedA["NO_PROXY"])
+		}
+		if !containsEntry(seedB["NO_PROXY"], seedBNoProxy) || containsEntry(seedB["NO_PROXY"], seedANoProxy) {
+			t.Errorf("seed-b: unexpected NO_PROXY %q", seedB["NO_PROXY"])
+		}
+	})
+
+	t.Run("seed without proxy settings gets no proxy even if the shared configuration has one", func(t *testing.T) {
+		seeds := map[string]*kubermaticv1.Seed{
+			"seed-without-proxy-settings": newSeed("seed-without-proxy-settings", nil),
+			"seed-with-empty-proxy":       newSeed("seed-with-empty-proxy", &kubermaticv1.ProxySettings{}),
+		}
+
+		for name, seed := range seeds {
+			env := seedControllerManagerEnv(t, seed)
+
+			if got := env["HTTP_PROXY"]; got != "" {
+				t.Errorf("%s: expected no HTTP_PROXY, got %q", name, got)
+			}
+			if got := env["HTTPS_PROXY"]; got != "" {
+				t.Errorf("%s: expected no HTTPS_PROXY, got %q", name, got)
+			}
+		}
+	})
+}
