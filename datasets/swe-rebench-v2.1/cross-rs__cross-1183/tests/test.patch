     }
+
+    // Regression check for parsing a `[package.metadata.cross]` table from a
+    // `Cargo.toml`. The `image.toolchain` key is a list of platform/toolchain
+    // pairs and must be accepted when the configuration is embedded in a
+    // `Cargo.toml`, exactly as it is when read from a `Cross.toml`.
+    let cross_toml = r#"
+        [target.x86_64-unknown-freebsd]
+        image.name = "ghcr.io/cross-rs/x86_64-unknown-freebsd:local"
+        image.toolchain = ["linux/arm64/v8=aarch64-unknown-linux-gnu"]
+    "#;
+    let cargo_toml = r#"
+        [package.metadata.cross.target.x86_64-unknown-freebsd]
+        image.name = "ghcr.io/cross-rs/x86_64-unknown-freebsd:local"
+        image.toolchain = ["linux/arm64/v8=aarch64-unknown-linux-gnu"]
+    "#;
+
+    let mut cross_msg_info = crate::shell::MessageInfo::default();
+    let (from_cross, _) =
+        crate::cross_toml::CrossToml::parse_from_cross(cross_toml, &mut cross_msg_info)?;
+
+    let mut cargo_msg_info = crate::shell::MessageInfo::default();
+    let (from_cargo, _) =
+        crate::cross_toml::CrossToml::parse_from_cargo(cargo_toml, &mut cargo_msg_info)?
+            .expect("a `[package.metadata.cross]` table should yield a configuration");
+
+    // The configuration embedded in a `Cargo.toml` must be parsed the same way
+    // as the equivalent `Cross.toml` configuration.
+    assert_eq!(from_cross, from_cargo);
+
     Ok(())
