+// The contract fixes the ESLint config glob for CommonJS packages, but leaves
+// other incidental details of the generated config open. Normalize those
+// details before snapshotting so that any contract-compliant implementation
+// matches: module-package configs may use a combined or separate JS/TS glob,
+// and may include `.mjs` files or a separate `*.mjs` extension entry.
+function normalizeConfig(creation: { files?: Record<string, unknown> }) {
+	const moduleConfig = creation.files?.["eslint.config.js"];
+	if (typeof moduleConfig === "string") {
+		creation.files!["eslint.config.js"] = moduleConfig
+			.replace(
+				/files:\s*\[(?=[^\]]*["']\*\*\/\*\.(?:\{(?:js|mjs|ts)(?:,(?:js|mjs|ts))*\}|(?:js|mjs|ts))["'])[^\]]*\]/,
+				'files: ["**/*.{js,ts}"]',
+			)
+			.replace(
+				'files: ["**/*.js", "**/*.ts"]',
+				'files: ["**/*.{js,ts}"]',
+			);
+	}
+	const commonjsConfig = creation.files?.["eslint.config.mjs"];
+	if (typeof commonjsConfig === "string") {
+		creation.files!["eslint.config.mjs"] = commonjsConfig.replace(
+			',{ files: ["*.mjs"], languageOptions: {"sourceType":"module"}, }',
+			"",
+		);
+	}
+	return creation;
+}
+
+function expectCommonjsConfig(creation: { files?: Record<string, unknown> }) {
+	const config = Object.entries(creation.files ?? {}).find(([name]) =>
+		/^eslint\.config\.(?:cjs|js|mjs)$/.test(name),
+	);
+	expect(config).toBeDefined();
+	if (!config || typeof config[1] !== "string") {
+		return;
+	}
+	if (config[0] === "eslint.config.js") {
+		expect(config[1]).not.toMatch(/^\s*(?:import\s+(?!\()|export\s+(?:default|const|let|var|function|\{|\*))/m);
+	}
+	expect(config[1]).toMatch(
+		/files\s*:\s*\[\s*["']\*\*\/\*\.\{js,mjs,ts\}["']\s*,?\s*\]/,
+	);
+}
