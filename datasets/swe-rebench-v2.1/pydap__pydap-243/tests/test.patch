 """Test the data model."""
 
 import copy
+import subprocess
+import sys
 import numpy as np
 from pydap.model import (DatasetType, BaseType,
                          SequenceType, StructureType,
@@ -176,7 +178,10 @@ def test_StructureType_init():
 def test_StructureType_instance():
     """Test that it is a Mapping and DapType."""
     var = StructureType("var")
-    from collections import Mapping
+    try:
+       from collections.abc import Mapping
+    except ImportError:
+       from collections import Mapping
     assert isinstance(var, Mapping)
     assert isinstance(var, DapType)
 
@@ -565,3 +570,30 @@ def test_GridType_maps(gridtype_example):
 def test_GridType_dimensions(gridtype_example):
     """Test ``dimensions`` property."""
     assert (gridtype_example.dimensions == ("x", "y"))
+
+
+COLLECTIONS_ABC_WARNING = (
+    "error:Using or importing the ABCs from:DeprecationWarning")
+
+
+def _import_in_fresh_interpreter(module):
+    """Import ``module`` in a new interpreter, turning the collections ABC
+    deprecation warning into an error."""
+    cmd = [sys.executable, "-W", COLLECTIONS_ABC_WARNING,
+           "-c", "import " + module]
+    return subprocess.run(cmd, stdout=subprocess.PIPE,
+                          stderr=subprocess.PIPE, universal_newlines=True)
+
+
+def test_model_import_has_no_collections_abc_warning():
+    """Importing pydap.model works and does not warn about importing
+    ABCs (such as Mapping) from ``collections``."""
+    result = _import_in_fresh_interpreter("pydap.model")
+    assert result.returncode == 0, result.stderr
+
+
+def test_das_import_has_no_collections_abc_warning():
+    """Importing the DAS response works and does not warn about importing
+    ABCs (such as Iterable) from ``collections``."""
+    result = _import_in_fresh_interpreter("pydap.responses.das")
+    assert result.returncode == 0, result.stderr
