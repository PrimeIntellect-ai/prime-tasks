         mk_switch!(Num(123.), ("foo", Bool(true)), ("bar", Bool(false)) ; Num(456.))
-    )
+    );
+    let invalid_switch = "switch { foo => 1 } `foo";
+    let id = Files::new().add("<test>", String::from(invalid_switch));
+    let mut recoveries = Vec::new();
+    let parsed = super::grammar::TermParser::new().parse(
+        id,
+        &mut recoveries,
+        Lexer::new(invalid_switch),
+    );
+    assert!(parsed.is_err() || !recoveries.is_empty());
 }
 
