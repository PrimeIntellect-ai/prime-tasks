+# see also test_rechunk.py
+def test_rechunk_intermediate(tmp_path):
+    spec = cubed.Spec(tmp_path, allowed_mem=4 * 8 * 4)
+    a = xp.ones((4, 4), chunks=(1, 4), spec=spec)
+    b = a.rechunk((4, 1))
+    assert_array_equal(b.compute(), np.ones((4, 4)))
+    # the intermediate array created by rechunk is surfaced as a top-level
+    # (non-hidden) array in the DAG, in addition to the source and target arrays
+    top_level = [
+        n for (n, d) in b.plan.dag.nodes(data=True) if not d.get("hidden", False)
+    ]
+    assert a.name in top_level
+    assert b.name in top_level
+    intermediates = [n for n in top_level if n not in (a.name, b.name)]
+    assert len(intermediates) >= 1
+
+    # Every surfaced rechunk stage reports the number of output chunk tasks
+    # represented by its target array.
+    stage_nodes = [
+        (n, d)
+        for n, d in b.plan.dag.nodes(data=True)
+        if n != a.name and n in top_level and d.get("target") is not None
+    ]
+    assert len(stage_nodes) >= 2
+    for _, data in stage_nodes:
+        target = data["target"]
+        expected_tasks = int(
+            np.prod(
+                [
+                    len(range(0, size, chunk))
+                    for size, chunk in zip(target.shape, target.chunks)
+                ]
+            )
+        )
+        assert data["num_tasks"] == expected_tasks
+
+
