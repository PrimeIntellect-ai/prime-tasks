+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+from test.testlib.testcase import BaseTestCase
+import cfnlint.core
+
+
+class TestBackupPlanLifecycleRule(BaseTestCase):
+    """Check Backup Plan lifecycle cold-to-delete intervals through linting."""
+
+    def lint_file(self, filename):
+        args, filenames, _ = cfnlint.core.get_args_filenames(['--template', filename])
+        results = []
+        for template_filename in filenames:
+            template, rules, _ = cfnlint.core.get_template_rules(template_filename, args)
+            results.extend(cfnlint.core.run_checks(
+                template_filename, template, rules, ['us-east-1']))
+        return results
+
+    def test_file_positive(self):
+        """Valid and incomparable lifecycle values produce no lint findings."""
+        filename = 'test/fixtures/templates/good/resources/backup/test_backup_plan_lifecycle_rule.yml'
+        self.assertEqual([], self.lint_file(filename))
+
+    def test_file_negative(self):
+        """A lifecycle interval shorter than 90 days produces a lint finding."""
+        filename = 'test/fixtures/templates/bad/resources/backup/test_backup_plan_lifecycle_rule.yml'
+        self.assertTrue(self.lint_file(filename))
