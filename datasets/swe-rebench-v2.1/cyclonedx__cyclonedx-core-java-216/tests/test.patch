@@ -0,0 +1,90 @@
+package org.cyclonedx;
+
+import java.io.IOException;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.cyclonedx.generators.json.BomJsonGenerator;
+import org.cyclonedx.model.Bom;
+import org.cyclonedx.model.Component;
+import org.cyclonedx.model.ExternalReference;
+import org.cyclonedx.model.Hash;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+
+public class Issue214RegressionTest
+{
+    /**
+     * The public contract for issue 214 is that hashes attached to an external reference are
+     * serialized when generating CycloneDX 1.4 JSON.
+     */
+    @Test
+    public void schema14JsonObjectGenerationTest() throws IOException
+    {
+        final Bom inputBom = createIssue214Bom();
+        BomJsonGenerator generator = BomGeneratorFactory.createJson(CycloneDxSchema.Version.VERSION_14, inputBom);
+
+        final String actual = generator.toJsonString();
+        final JsonNode root = new ObjectMapper().readTree(actual);
+
+        Assertions.assertEquals("CycloneDX", root.path("bomFormat").asText());
+        Assertions.assertEquals("1.4", root.path("specVersion").asText());
+
+        final JsonNode externalReferences = root.path("components").path(0).path("externalReferences");
+        Assertions.assertTrue(externalReferences.isArray(), "externalReferences should be serialized as an array");
+        Assertions.assertEquals(1, externalReferences.size());
+
+        final JsonNode externalReference = externalReferences.get(0);
+        Assertions.assertEquals("bom", externalReference.path("type").asText());
+        Assertions.assertEquals("https://example.org/support/sbom/portal-server/1.0.0",
+            externalReference.path("url").asText());
+
+        final JsonNode hashes = externalReference.path("hashes");
+        Assertions.assertTrue(hashes.isArray(), "external reference hashes should be serialized as an array");
+        assertHashPresent(hashes, "MD5", "2cd42512b65500dc7ba0ff13490b0b73");
+        assertHashPresent(hashes, "SHA-1", "226247b40160f2892fa4c7851b5b913d5d10912d");
+        assertHashPresent(hashes, "SHA-256", "09a72795a920c1a9c0209cfb8395f8d97089832d249cba8c0938a3423b3ed1d1");
+    }
+
+
+
+    private void assertHashPresent(final JsonNode pHashes, final String pAlgorithm, final String pValue)
+    {
+        for (final JsonNode hash : pHashes)
+        {
+            if (pAlgorithm.equals(hash.path("alg").asText()) && pValue.equals(hash.path("content").asText()))
+            {
+                return;
+            }
+        }
+        Assertions.fail("Missing external-reference hash " + pAlgorithm + " with value " + pValue);
+    }
+
+
+
+    private Bom createIssue214Bom()
+    {
+        ExternalReference extRef = new ExternalReference();
+        extRef.setType(ExternalReference.Type.BOM);
+        extRef.setUrl("https://example.org/support/sbom/portal-server/1.0.0");
+        extRef.setComment("An external SBOM that describes what this component includes");
+        Hash md5 = new Hash(Hash.Algorithm.MD5, "2cd42512b65500dc7ba0ff13490b0b73");
+        Hash sha1 = new Hash(Hash.Algorithm.SHA1, "226247b40160f2892fa4c7851b5b913d5d10912d");
+        Hash sha256 = new Hash(Hash.Algorithm.SHA_256,
+            "09a72795a920c1a9c0209cfb8395f8d97089832d249cba8c0938a3423b3ed1d1");
+        extRef.setHashes(java.util.Arrays.asList(md5, sha1, sha256));
+
+        Component component = new Component();
+        component.setGroup("org.example");
+        component.setName("mylibrary");
+        component.setType(Component.Type.LIBRARY);
+        component.setVersion("1.0.0");
+        component.addExternalReference(extRef);
+
+        Bom bom = new Bom();
+        bom.addComponent(component);
+
+        return bom;
+    }
+}
