+import { spawn } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+import { getDMMF } from "@prisma/internals";
+
+type GetClientModuleSpecifier = (clientGeneratorOutputPath: string | undefined, outputDirname: string) => string;
+
+function loadGetClientModuleSpecifier(): GetClientModuleSpecifier {
+  // Loaded lazily so that the generator-level tests below can still run when the
+  // module is absent.
+  return require("./getClientModuleSpecifier").getClientModuleSpecifier;
+}
+
+describe("getClientModuleSpecifier", () => {
+  test.each([
+    { outputDirname: "dist", clientGeneratorOutputPath: undefined, expected: "@prisma/client" },
+    { outputDirname: "dist", clientGeneratorOutputPath: "", expected: "@prisma/client" },
+    { outputDirname: "dist", clientGeneratorOutputPath: "node_modules/@prisma/client", expected: "@prisma/client" },
+    { outputDirname: "dist", clientGeneratorOutputPath: "node_modules\\@prisma\\client", expected: "@prisma/client" },
+    { outputDirname: "dist", clientGeneratorOutputPath: "prisma-client", expected: "../prisma-client" },
+    { outputDirname: "dist", clientGeneratorOutputPath: "../prisma-client", expected: "../../prisma-client" },
+    { outputDirname: "./dist", clientGeneratorOutputPath: "../prisma-client", expected: "../../prisma-client" },
+    { outputDirname: ".\\dist", clientGeneratorOutputPath: "..\\prisma-client", expected: "../../prisma-client" },
+    { outputDirname: "dist", clientGeneratorOutputPath: "..\\..\\prisma-client", expected: "../../../prisma-client" },
+  ])(
+    "outputDirname: $outputDirname, clientGeneratorOutputPath: $clientGeneratorOutputPath, expected: $expected",
+    ({ outputDirname, clientGeneratorOutputPath, expected }) => {
+      const getClientModuleSpecifier = loadGetClientModuleSpecifier();
+      expect(getClientModuleSpecifier(clientGeneratorOutputPath, outputDirname)).toBe(expected);
+    },
+  );
+});
+
+async function generateFactory(options: { outputDirname: string; clientGeneratorOutputPath: string }) {
+  const dmmf = await getDMMF({
+    datamodel: `
+      model User {
+        id Int @id
+        name String
+      }
+    `,
+  });
+
+  await new Promise<void>((resolve, reject) => {
+    const child = spawn(
+      process.execPath,
+      ["-r", "ts-node/register/transpile-only", path.join(__dirname, "generator.ts")],
+      { cwd: path.join(__dirname, ".."), stdio: ["pipe", "pipe", "pipe"] },
+    );
+    let stderr = "";
+    child.stderr.on("data", chunk => {
+      stderr += chunk.toString();
+      if (stderr.split("\n").some(line => line.includes('"id":1'))) {
+        child.kill();
+        resolve();
+      }
+    });
+    child.on("error", reject);
+    child.on("close", () => resolve());
+    child.stdin.write(
+      JSON.stringify({
+        jsonrpc: "2.0",
+        id: 1,
+        method: "generate",
+        params: {
+          generator: {
+            name: "fabbrica",
+            output: { value: options.outputDirname },
+            config: { noTranspile: "true" },
+            provider: { value: "node ./bin.js" },
+          },
+          otherGenerators: [
+            { name: "client", output: { value: options.clientGeneratorOutputPath }, provider: { value: "prisma-client-js" } },
+          ],
+          schemaPath: path.join(options.outputDirname, "schema.prisma"),
+          dmmf,
+          datasources: [],
+          version: "5.0.0",
+        },
+      }) + "\n",
+    );
+  });
+
+  return fs.readFileSync(path.join(options.outputDirname, "index.ts"), "utf8");
+}
+
+function importSpecifiers(contents: string) {
+  return contents
+    .split("\n")
+    .filter(line => line.startsWith("import"))
+    .map(line => line.match(/from "([^"]+)"/)?.[1]);
+}
+
+describe("generated Prisma Client import", () => {
+  jest.setTimeout(60000);
+
+  it("uses @prisma/client for a Windows-style node_modules client path", async () => {
+    const outputDirname = fs.mkdtempSync(path.join(os.tmpdir(), "fabbrica-"));
+    const contents = await generateFactory({
+      outputDirname,
+      clientGeneratorOutputPath: "node_modules\\@prisma\\client",
+    });
+    expect(importSpecifiers(contents)).toContain("@prisma/client");
+  });
+
+  it("uses a POSIX relative specifier for a Windows-style client path", async () => {
+    const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "fabbrica-"));
+    const outputDirname = path.join(tmp, "generated");
+    const contents = await generateFactory({
+      outputDirname,
+      clientGeneratorOutputPath: path.join(tmp, "prisma-client").replace(/\//g, "\\"),
+    });
+    const specifiers = importSpecifiers(contents);
+    expect(specifiers).toContain("../prisma-client");
+    expect(specifiers.every(specifier => !specifier?.includes("\\"))).toBe(true);
+  });
+});
