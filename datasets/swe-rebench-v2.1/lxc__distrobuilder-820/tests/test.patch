+// TestPongo2V4Migration verifies that the whole module has been migrated to
+// github.com/flosch/pongo2/v4 and no longer depends on the legacy pongo2
+// import paths.
+func TestPongo2V4Migration(t *testing.T) {
+	cmd := exec.Command("go", "list", "-deps", "./...")
+	cmd.Dir = ".."
+
+	out, err := cmd.Output()
+	require.NoError(t, err, "failed to list module dependencies: %s", string(out))
+
+	deps := strings.Split(strings.TrimSpace(string(out)), "\n")
+
+	require.Contains(t, deps, "github.com/flosch/pongo2/v4")
+
+	for _, dep := range deps {
+		dep = strings.TrimSpace(dep)
+		require.NotEqual(t, "github.com/flosch/pongo2", dep, "legacy pongo2 import path is still used")
+		require.NotEqual(t, "gopkg.in/flosch/pongo2.v3", dep, "legacy pongo2.v3 import path is still used")
+	}
+}
