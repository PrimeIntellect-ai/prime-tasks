+        2 * x[1]^2 + 3 * x[1] * x[2],
+    )
+    return
+end
+
+function test_set_objective_coefficient_quadratic_zero_reversed()
+    model = Model()
+    @variable(model, x[1:2])
+    @objective(model, Min, x[1]^2 + 3 * x[1] * x[2] + x[2])
+    set_objective_coefficient(model, x[2], x[1], 0)
+    @test isequal_canonical(
+        objective_function(model),
+        x[1]^2 + x[2],
+    )
+    return
+end
