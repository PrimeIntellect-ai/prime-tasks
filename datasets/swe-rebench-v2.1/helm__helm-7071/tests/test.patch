+func TestChartDownloaderUsesRepositoryTLSConfig(t *testing.T) {
+	root := ensure.TempDir(t)
+	defer os.RemoveAll(root)
+	server, clientCertificateSeen := newTLSGetterTestServer(t)
+	defer server.Close()
+	certFile, keyFile, caFile := writeTLSGetterTestFiles(t, server, filepath.Join(root, "tls"))
+	configPath := filepath.Join(root, "repositories.yaml")
+	config := repo.NewFile()
+	config.Add(&repo.Entry{
+		Name:     "tls-repository",
+		URL:      server.URL,
+		CertFile: certFile,
+		KeyFile:  keyFile,
+		CAFile:   caFile,
+	})
+	if err := config.WriteFile(configPath, 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	cacheDir := filepath.Join(root, "cache")
+	if err := os.MkdirAll(cacheDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	index := repo.NewIndexFile()
+	index.Add(&chart.Metadata{Name: "foo", Version: "1.2.3"}, "foo-1.2.3.tgz", server.URL, "")
+	if err := index.WriteFile(filepath.Join(cacheDir, "tls-repository-index.yaml"), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	dest := filepath.Join(root, "download")
+	if err := os.MkdirAll(dest, 0700); err != nil {
+		t.Fatal(err)
+	}
+	d := ChartDownloader{
+		Out:              os.Stderr,
+		Getters:          getter.All(&cli.EnvSettings{}),
+		RepositoryConfig: configPath,
+		RepositoryCache:  cacheDir,
+	}
+	if _, _, err := d.DownloadTo("tls-repository/foo", "1.2.3", dest); err != nil {
+		t.Fatalf("failed to download chart using repository TLS settings: %v", err)
+	}
+	if !<-clientCertificateSeen {
+		t.Fatal("chart repository request did not present its configured client certificate")
+	}
+}
