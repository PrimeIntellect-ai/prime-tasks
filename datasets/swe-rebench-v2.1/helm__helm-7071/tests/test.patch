+func TestHTTPGetterTLSClientConfig(t *testing.T) {
+	root := ensure.TempDir(t)
+	defer os.RemoveAll(root)
+	server, clientCertificateSeen := newTLSGetterTestServer(t)
+	defer server.Close()
+	certFile, keyFile, caFile := writeTLSGetterTestFiles(t, server, filepath.Join(root, "tls"))
+
+	fullTLSGetter, err := getter.NewHTTPGetter(
+		getter.WithURL(server.URL),
+		getter.WithTLSClientConfig(certFile, keyFile, caFile),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := fullTLSGetter.Get(server.URL); err != nil {
+		t.Fatalf("request with client credentials and custom server CA failed: %v", err)
+	}
+	if !<-clientCertificateSeen {
+		t.Fatal("server did not receive the configured client certificate")
+	}
+
+	caOnlyGetter, err := getter.NewHTTPGetter(
+		getter.WithURL(server.URL),
+		getter.WithTLSClientConfig("", "", caFile),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := caOnlyGetter.Get(server.URL); err != nil {
+		t.Fatalf("request with empty client-certificate paths and a custom server CA failed: %v", err)
+	}
+	if <-clientCertificateSeen {
+		t.Fatal("server received a client certificate when the client-certificate paths were empty")
+	}
+}
