+func newTLSGetterTestServer(t *testing.T) (*httptest.Server, <-chan bool) {
+	t.Helper()
+	clientCertificateSeen := make(chan bool, 10)
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		clientCertificateSeen <- r.TLS != nil && len(r.TLS.PeerCertificates) > 0
+		_, _ = w.Write([]byte("chart archive"))
+	}))
+	server.TLS = &tls.Config{ClientAuth: tls.RequestClientCert}
+	server.StartTLS()
+	return server, clientCertificateSeen
+}
+
+func writeTLSGetterTestFiles(t *testing.T, server *httptest.Server, tlsDir string) (string, string, string) {
+	t.Helper()
+	if err := os.MkdirAll(tlsDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	caFile := filepath.Join(tlsDir, "server-ca.pem")
+	serverCertificate := server.TLS.Certificates[0].Certificate[0]
+	if err := ioutil.WriteFile(caFile, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: serverCertificate}), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	clientKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	clientTemplate := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: "helm-test-client"},
+		NotBefore:    time.Now().Add(-time.Minute),
+		NotAfter:     time.Now().Add(time.Hour),
+		KeyUsage:     x509.KeyUsageDigitalSignature | x509.KeyUsageKeyEncipherment,
+		ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageClientAuth},
+	}
+	clientDER, err := x509.CreateCertificate(rand.Reader, clientTemplate, clientTemplate, &clientKey.PublicKey, clientKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	certFile := filepath.Join(tlsDir, "client.pem")
+	keyFile := filepath.Join(tlsDir, "client-key.pem")
+	if err := ioutil.WriteFile(certFile, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: clientDER}), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := ioutil.WriteFile(keyFile, pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(clientKey)}), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return certFile, keyFile, caFile
+}
