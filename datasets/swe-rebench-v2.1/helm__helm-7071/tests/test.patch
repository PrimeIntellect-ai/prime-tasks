+func TestHelmPullUsesCommandLineTLSConfig(t *testing.T) {
+	root := ensure.TempDir(t)
+	defer os.RemoveAll(root)
+	server, clientCertificateSeen := newTLSGetterTestServer(t)
+	defer server.Close()
+	certFile, keyFile, caFile := writeTLSGetterTestFiles(t, server, filepath.Join(root, "tls"))
+	dest := filepath.Join(root, "download")
+	if err := os.MkdirAll(dest, 0700); err != nil {
+		t.Fatal(err)
+	}
+
+	cmd := exec.Command("go", "run", "../../cmd/helm", "pull", server.URL+"/chart-1.2.3.tgz",
+		"--cert-file", certFile, "--key-file", keyFile, "--ca-file", caFile,
+		"--destination", dest)
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("helm pull with command-line TLS settings failed: %v\n%s", err, output)
+	}
+	if !<-clientCertificateSeen {
+		t.Fatal("chart download did not present the command-line client certificate")
+	}
+	if _, err := os.Stat(filepath.Join(dest, "chart-1.2.3.tgz")); err != nil {
+		t.Fatalf("helm pull did not save the downloaded chart: %v", err)
+	}
+}
