 #[test]
 #[cfg(feature = "deserialization")]
 fn test_deserialize() {
+    use minijinja::value::{from_args, ViaDeserialize};
     use serde::Deserialize;
 
     #[derive(Deserialize, Debug, PartialEq, Eq)]
@@ -572,6 +573,48 @@ fn test_deserialize() {
     let point = Point::deserialize(point_value).unwrap();
 
     assert_eq!(point, Point { x: 42, y: -23 });
+
+    #[derive(Debug, serde::Serialize, serde::Deserialize, Eq, PartialEq)]
+    enum SimpleEnum {
+        B,
+        C,
+        D,
+    }
+
+    #[derive(Debug, serde::Serialize, serde::Deserialize, Eq, PartialEq)]
+    enum TaggedUnion {
+        V(String),
+    }
+
+    #[derive(Debug, serde::Serialize, serde::Deserialize, Eq, PartialEq)]
+    struct UnitStruct(String);
+
+    #[derive(Debug, serde::Serialize, serde::Deserialize, Eq, PartialEq)]
+    struct EmptyUnitStruct;
+
+    #[derive(Debug, serde::Serialize, serde::Deserialize, Eq, PartialEq)]
+    enum ContainsUnitStruct {
+        Empty(EmptyUnitStruct),
+    }
+
+    let spe = Value::from_serialize(SimpleEnum::B);
+    let spu = Value::from_serialize(UnitStruct("hello".into()));
+    let spt = Value::from_serialize(TaggedUnion::V("workd".into()));
+    let unit = Value::from_serialize(EmptyUnitStruct);
+    let nested_unit = Value::from_serialize(ContainsUnitStruct::Empty(EmptyUnitStruct));
+
+    let a: (
+        ViaDeserialize<SimpleEnum>,
+        ViaDeserialize<UnitStruct>,
+        ViaDeserialize<TaggedUnion>,
+        ViaDeserialize<EmptyUnitStruct>,
+        ViaDeserialize<ContainsUnitStruct>,
+    ) = from_args(args!(spe, spu, spt, unit, nested_unit)).unwrap();
+    assert_eq!((a.0).0, SimpleEnum::B);
+    assert_eq!((a.1).0, UnitStruct("hello".into()));
+    assert_eq!((a.2).0, TaggedUnion::V("workd".into()));
+    assert_eq!((a.3).0, EmptyUnitStruct);
+    assert_eq!((a.4).0, ContainsUnitStruct::Empty(EmptyUnitStruct));
 }
 
 #[test]
