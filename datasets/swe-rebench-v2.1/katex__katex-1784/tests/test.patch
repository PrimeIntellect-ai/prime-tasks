+
+describe("Pre-process callback", function() {
+    it("preprocesses and renders each delimited expression", function() {
+        const actual = document.createElement("div");
+        actual.textContent = "Circle: $x-squared$ and $y-squared$.";
+        const expected = document.createElement("div");
+        expected.textContent = "Circle: $x^2$ and $y^2$.";
+        const delimiters = [{left: "$", right: "$", display: false}];
+        const received = [];
+
+        renderMathInElement(actual, {
+            delimiters,
+            preProcess: math => {
+                received.push(math);
+                return math.replace(/-squared/g, "^2");
+            },
+        });
+        renderMathInElement(expected, {delimiters});
+
+        expect(received.slice().sort()).toEqual(["x-squared", "y-squared"]);
+        expect(actual.querySelectorAll(".katex").length).toBe(2);
+        const actualMath = Array.from(actual.querySelectorAll(".katex"),
+            node => node.textContent);
+        const expectedMath = Array.from(expected.querySelectorAll(".katex"),
+            node => node.textContent);
+        expect(actualMath).toEqual(expectedMath);
+    });
+
+    it("renders inline-delimited math in display style without centering", function() {
+        const element = document.createElement("div");
+        element.textContent = "Inline: $\\sum_{i=1}^n i$.";
+
+        renderMathInElement(element, {
+            delimiters: [{left: "$", right: "$", display: false}],
+            preProcess: math => "\\displaystyle{" + math + "}",
+        });
+
+        expect(element.querySelector(".op-limits")).not.toBeNull();
+        expect(element.querySelector(".katex-display")).toBeNull();
+        expect(element.textContent).toContain("Inline: ");
+        expect(element.textContent).toContain(".");
+    });
+
+    it("renders the original expression when preprocessing is omitted", function() {
+        const actual = document.createElement("div");
+        actual.textContent = "Value: $x^2$.";
+        const expected = document.createElement("div");
+        expected.textContent = "Value: $x^2$.";
+        const delimiters = [{left: "$", right: "$", display: false}];
+
+        renderMathInElement(actual, {delimiters});
+        renderMathInElement(expected, {delimiters});
+
+        expect(actual.querySelector(".katex")).not.toBeNull();
+        expect(actual.querySelector(".katex").textContent).toEqual(
+            expected.querySelector(".katex").textContent);
+    });
+});
