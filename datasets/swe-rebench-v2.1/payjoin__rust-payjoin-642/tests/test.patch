diff --git a/payjoin-test-utils/src/lib.rs b/payjoin-test-utils/src/lib.rs
index b337be3..eefb6fa 100644
--- a/payjoin-test-utils/src/lib.rs
+++ b/payjoin-test-utils/src/lib.rs
@@ -299,3 +299,87 @@ pub static PARSED_PAYJOIN_PROPOSAL: Lazy<Psbt> =
 pub static PARSED_PAYJOIN_PROPOSAL_WITH_SENDER_INFO: Lazy<Psbt> = Lazy::new(|| {
     Psbt::from_str(PAYJOIN_PROPOSAL_WITH_SENDER_INFO).expect("known psbt should parse")
 });
+
+pub const MULTIPARTY_ORIGINAL_PSBT_ONE: &str = "";
+
+pub const MULTIPARTY_ORIGINAL_PSBT_TWO: &str = "";
+
+#[cfg(test)]
+mod multiparty_duplicate_session_test {
+    use std::str::FromStr;
+
+    use bitcoin::Address;
+    use payjoin::persist::NoopPersister;
+    use payjoin::receive::multiparty::UncheckedProposalBuilder;
+    use payjoin::receive::v2::{NewReceiver, Receiver};
+
+    use super::{
+        BoxSendSyncError, KEM, KEY_ID, MULTIPARTY_ORIGINAL_PSBT_ONE,
+        MULTIPARTY_ORIGINAL_PSBT_TWO, SYMMETRIC,
+    };
+
+    fn varint(value: usize, output: &mut Vec<u8>) {
+        if value < 64 {
+            output.push(value as u8);
+        } else if value < (1 << 14) {
+            output.push(((value >> 8) as u8) | 0x40);
+            output.push(value as u8);
+        } else {
+            panic!("test fixture unexpectedly requires a longer varint");
+        }
+    }
+
+    fn bhttp_response(payload: &[u8]) -> Vec<u8> {
+        let mut response = vec![1]; // Known-length response
+        varint(200, &mut response);
+        varint(0, &mut response); // No headers
+        varint(payload.len(), &mut response);
+        response.extend_from_slice(payload);
+        varint(0, &mut response); // No trailers
+        response.resize(payjoin::directory::ENCAPSULATED_MESSAGE_BYTES - 48, 0);
+        response
+    }
+
+    fn receive_proposal(
+        receiver: &mut Receiver,
+        server: &ohttp::Server,
+        payload: &str,
+    ) -> Result<payjoin::receive::v2::UncheckedProposal, BoxSendSyncError> {
+        let (request, response_context) = receiver.extract_req("https://relay.example")?;
+        let (_, server_response) = server.decapsulate(&request.body)?;
+        let response = server_response.encapsulate(&bhttp_response(payload.as_bytes()))?;
+        let response: [u8; payjoin::directory::ENCAPSULATED_MESSAGE_BYTES] = response
+            .try_into()
+            .map_err(|_| std::io::Error::other("unexpected OHTTP response size"))?;
+        receiver
+            .process_res(&response, response_context)?
+            .ok_or_else(|| std::io::Error::other("expected a proposal").into())
+    }
+
+    #[test]
+    fn rejects_a_second_proposal_from_the_same_hpke_session() -> Result<(), BoxSendSyncError> {
+        let key_config = ohttp::KeyConfig::new(KEY_ID, KEM, SYMMETRIC.to_vec())?;
+        let server = ohttp::Server::new(key_config.clone())?;
+        let address = Address::from_str("tb1q6d3a2w975yny0asuvd9a67ner4nks58ff0q8g4")?
+            .assume_checked();
+        let mut persister = NoopPersister;
+        let token = NewReceiver::new(
+            address,
+            "https://directory.example",
+            payjoin::OhttpKeys(key_config),
+            None,
+        )?
+        .persist(&mut persister)?;
+        let mut receiver = Receiver::load(token, &persister)?;
+
+        let first = format!("{MULTIPARTY_ORIGINAL_PSBT_ONE}\nv=2&optimisticmerge=true");
+        let second = format!("{MULTIPARTY_ORIGINAL_PSBT_TWO}\nv=2&optimisticmerge=true");
+        let first = receive_proposal(&mut receiver, &server, &first)?;
+        let second = receive_proposal(&mut receiver, &server, &second)?;
+
+        let mut builder = UncheckedProposalBuilder::new();
+        builder.add(first)?;
+        assert!(builder.add(second).is_err());
+        Ok(())
+    }
+}
