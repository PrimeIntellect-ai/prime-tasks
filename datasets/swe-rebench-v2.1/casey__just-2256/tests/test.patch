+#[cfg(unix)]
+#[test]
+fn extension_for_wrapper_launched_powershell_script() {
+  use std::os::unix::fs::PermissionsExt;
+
+  let test = Test::new();
+  let bin = test.tempdir.path().join("bin");
+  fs::create_dir_all(&bin).unwrap();
+  let wrapper = bin.join("gsudo");
+  fs::write(
+    &wrapper,
+    "#!/bin/sh
+test \"$1\" = pwsh && test \"${2##*.}\" = ps1 && /bin/sh \"$2\"
+",
+  )
+  .unwrap();
+  let mut permissions = fs::metadata(&wrapper).unwrap().permissions();
+  permissions.set_mode(0o755);
+  fs::set_permissions(&wrapper, permissions).unwrap();
+
+  test
+    .env(
+      "PATH",
+      &format!("{}:{}", bin.display(), env::var("PATH").unwrap()),
+    )
+    .justfile(format!(
+      "
+        [extension: '.ps1']
+        baz:
+          #!{} pwsh
+          echo wrapper-ran
+      ",
+      wrapper.display(),
+    ))
+    .stdout("wrapper-ran\n")
+    .stderr_regex("(?s).*")
+    .run();
+}
+
+#[cfg(unix)]
+#[test]
+fn selected_extension_overrides_inferred_interpreter_extension() {
+  use std::os::unix::fs::PermissionsExt;
+
+  let test = Test::new();
+  let bin = test.tempdir.path().join("bin");
+  fs::create_dir_all(&bin).unwrap();
+  let interpreter = bin.join("pwsh.exe");
+  fs::write(
+    &interpreter,
+    "#!/bin/sh\ntest \"${1##*.}\" = sh && /bin/sh \"$1\"\n",
+  )
+  .unwrap();
+  let mut permissions = fs::metadata(&interpreter).unwrap().permissions();
+  permissions.set_mode(0o755);
+  fs::set_permissions(&interpreter, permissions).unwrap();
+
+  test
+    .justfile(format!(
+      "\n        [extension: '.sh']\n        baz:\n          #!{}\n          echo selected-extension-used\n      ",
+      interpreter.display(),
+    ))
+    .stdout("selected-extension-used\n")
+    .run();
+}
