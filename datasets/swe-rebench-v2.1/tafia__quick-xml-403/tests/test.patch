+/// Test for https://github.com/tafia/quick-xml/issues/324
+#[test]
+fn from_str_uses_utf8_with_declared_encoding() {
+    let xml = r#"
+        <?xml version="1.0" encoding="windows-1252" ?>
+        <A a="€" />
+    "#;
+
+    #[derive(Debug, PartialEq, Deserialize)]
+    struct A {
+        a: String,
+    }
+
+    let a: A = from_str(xml).unwrap();
+    assert_eq!(
+        a,
+        A {
+            a: "€".to_string()
+        }
+    );
+}
+
+/// Byte-oriented parsing must still honor the encoding declared in the XML
+/// declaration, because the bytes are not guaranteed to be UTF-8.
+#[test]
+fn from_slice_should_respect_encoding() {
+    // "€" is encoded as the single byte 0x80 in windows-1252
+    let xml: &[u8] = b"<?xml version=\"1.0\" encoding=\"windows-1252\" ?><A a=\"\x80\" />";
+
+    #[derive(Debug, PartialEq, Deserialize)]
+    struct A {
+        a: String,
+    }
+
+    let a: A = quick_xml::de::from_slice(xml).unwrap();
+    assert_eq!(
+        a,
+        A {
+            a: "€".to_string()
+        }
+    );
+}
