diff --git a/test/test.js b/test/test.js
index efd02ce..4d81cf4 100644
--- a/test/test.js
+++ b/test/test.js
@@ -1811,4 +1811,69 @@ describe('sanitizeHtml', function() {
     );
     assert.equal(sanitizedHtml, expectedOutput);
   });
+  it('should omit attributes on escaped disallowed tags by default', () => {
+    const inputHtml = '<div class="foo">Some Text</div>';
+    const sanitizedHtml = sanitizeHtml(inputHtml, {
+      allowedTags: [],
+      disallowedTagsMode: 'escape'
+    });
+
+    assert.ok(!sanitizedHtml.includes('<'));
+    assert.ok(!sanitizedHtml.includes('class'));
+    assert.ok(sanitizedHtml.includes('Some Text'));
+  });
+  it('should preserve attributes on escaped disallowed tags when `preserveEscapedAttributes` is true', () => {
+    const inputHtml = '<div class="foo">Some Text</div>';
+    const sanitizedHtml = sanitizeHtml(inputHtml, {
+      allowedTags: [],
+      disallowedTagsMode: 'escape',
+      preserveEscapedAttributes: true
+    });
+
+    assert.ok(!sanitizedHtml.includes('<'));
+    assert.ok(sanitizedHtml.includes('class'));
+    assert.ok(sanitizedHtml.includes('foo'));
+    assert.ok(sanitizedHtml.includes('Some Text'));
+  });
+  it('should preserve attributes on escaped disallowed tags in recursiveEscape mode when `preserveEscapedAttributes` is true', () => {
+    const inputHtml = '<div class="foo">Some Text</div>';
+    const sanitizedHtml = sanitizeHtml(inputHtml, {
+      allowedTags: [],
+      disallowedTagsMode: 'recursiveEscape',
+      preserveEscapedAttributes: true
+    });
+
+    assert.ok(!sanitizedHtml.includes('<'));
+    assert.ok(sanitizedHtml.includes('class'));
+    assert.ok(sanitizedHtml.includes('foo'));
+    assert.ok(sanitizedHtml.includes('Some Text'));
+  });
+  it('should not preserve attributes on escaped disallowed tags in recursiveEscape mode when `preserveEscapedAttributes` is false', () => {
+    const inputHtml = '<div class="foo">Some Text</div>';
+    const sanitizedHtml = sanitizeHtml(inputHtml, {
+      allowedTags: [],
+      disallowedTagsMode: 'recursiveEscape',
+      preserveEscapedAttributes: false
+    });
+
+    assert.ok(!sanitizedHtml.includes('<'));
+    assert.ok(!sanitizedHtml.includes('class'));
+    assert.ok(sanitizedHtml.includes('Some Text'));
+  });
+  it('should retain all attributes on escaped disallowed tags in both escape modes', () => {
+    const inputHtml = '<img src=asset.png onerror=run>';
+
+    for (const mode of ['escape', 'recursiveEscape']) {
+      const sanitizedHtml = sanitizeHtml(inputHtml, {
+        allowedTags: [],
+        disallowedTagsMode: mode,
+        preserveEscapedAttributes: true
+      });
+
+      assert.ok(!sanitizedHtml.includes('<'));
+      assert.ok(/src[\s\S]*?asset\.png/.test(sanitizedHtml));
+      assert.ok(/onerror[\s\S]*?run/.test(sanitizedHtml));
+    }
+  });
+
 });
