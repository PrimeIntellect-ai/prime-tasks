+// Issues a segment or part request through the fragment loader that the CMCD
+// controller installs, and returns the request context as handed to the loader.
+const requestFragment = (frag: Fragment, part?: Part | undefined) => {
+  let requested: any;
+  class CaptureLoader {
+    stats = {};
+    context = undefined;
+    constructor(_config: any) {}
+    load(context: any) {
+      requested = context;
+    }
+    destroy() {}
+    abort() {}
+  }
+  const hls = new HlsMock({ cmcd: {}, loader: CaptureLoader }) as any;
+  hls.levelController = {
