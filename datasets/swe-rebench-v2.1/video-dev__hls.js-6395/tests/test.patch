+  };
+  hls.audioTracks = [];
+  new CMCDController(hls);
+
+  const FragmentLoader = hls.config.fLoader;
+  const loader = new FragmentLoader(hls.config);
+  loader.load({ url: frag.url, frag, part }, {}, {});
+  return requested as { url: string };
+};
+
+// Reads a CMCD key from the CMCD query parameter of a request URL.
+const getCmcdValue = (requestUrl: string, key: string): string | undefined => {
+  const match = /[?&]CMCD=([^&#]*)/.exec(requestUrl);
+  if (!match) {
+    return undefined;
+  }
+  const entry = decodeURIComponent(match[1])
+    .split(',')
+    .find((item) => item.startsWith(`${key}=`));
+  return entry?.slice(key.length + 1).replace(/^"|"$/g, '');
+};
