 package org.cqfn.diktat.ruleset.chapter6
 
 import org.cqfn.diktat.ruleset.rules.chapter6.classes.CompactInitialization
+import org.cqfn.diktat.util.DiktatRuleSetProvider4Test
 import org.cqfn.diktat.util.FixTestBase
+import org.cqfn.diktat.util.format
 
 import generated.WarningNames
+import org.junit.jupiter.api.Assertions
 import org.junit.jupiter.api.Tag
 import org.junit.jupiter.api.Test
 
@@ -25,4 +28,61 @@ class CompactInitializationFixTest : FixTestBase("test/chapter6/compact_initiali
     fun `should wrap properties into apply - existing apply with value argument`() {
         fixAndCompare("ApplyWithValueArgumentExpected.kt", "ApplyWithValueArgumentTest.kt")
     }
+
+    @Test
+    @Tag(WarningNames.COMPACT_OBJECT_INITIALIZATION)
+    fun `should not move statements with this keyword into apply block`() {
+        val input = javaClass.classLoader
+            .getResource("test/chapter6/compact_initialization/ApplyOnStatementsWithThisKeywordTest.kt")!!
+            .readText()
+        val formatted = format({ DiktatRuleSetProvider4Test(::CompactInitialization, it) }, input, "TestFileName.kt")
+
+        // The outer receiver must be preserved. Inside an apply block `this` would refer to the
+        // apply receiver instead of the extension receiver, so a compliant fix either keeps such
+        // statements outside the block or qualifies the receiver, e.g. `this@createPluginConfig`.
+        applyBlockBodies(formatted).forEach { body ->
+            Assertions.assertFalse(
+                Regex("""\bthis\b(?!@)""").containsMatchIn(body),
+                "The outer receiver `this` is shadowed inside an apply block:\n$formatted"
+            )
+        }
+    }
+
+    /**
+     * Returns the bodies of all `apply { ... }` blocks in [code].
+     */
+    private fun applyBlockBodies(code: String): List<String> {
+        val bodies = mutableListOf<String>()
+        var searchFrom = 0
+        while (true) {
+            val applyIndex = code.indexOf(".apply", searchFrom)
+            if (applyIndex < 0) {
+                break
+            }
+            val openIndex = code.indexOf('{', applyIndex)
+            if (openIndex < 0) {
+                break
+            }
+            var depth = 0
+            var endIndex = -1
+            for (index in openIndex until code.length) {
+                when (code[index]) {
+                    '{' -> depth++
+                    '}' -> {
+                        depth--
+                        if (depth == 0) {
+                            endIndex = index
+                            break
+                        }
+                    }
+                }
+            }
+            if (endIndex < 0) {
+                break
+            }
+            bodies.add(code.substring(openIndex + 1, endIndex))
+            searchFrom = endIndex + 1
+        }
+        return bodies
+    }
 }
