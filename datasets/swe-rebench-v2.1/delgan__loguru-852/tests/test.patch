new file mode 100644
index 0000000..fe2251f
--- /dev/null
+++ b/tests/test_add_option_context.py
@@ -0,0 +1,74 @@
+import multiprocessing
+import os
+
+import pytest
+
+from loguru import logger
+
+
+class Writer:
+    def __init__(self):
+        self._output = ""
+
+    def write(self, message):
+        self._output += message
+
+    def read(self):
+        return self._output
+
+
+def set_logger(logger_):
+    global logger
+    logger = logger_
+
+
+def do_something(i):
+    logger.info("#{}", i)
+
+
+def test_default_context():
+    writer = Writer()
+    logger.add(writer, context=None, format="{message}", enqueue=True, catch=False)
+
+    with multiprocessing.get_context().Pool(1, set_logger, [logger]) as pool:
+        pool.apply(do_something, (0,))
+        pool.close()
+        pool.join()
+
+    logger.info("Done!")
+    logger.remove()
+
+    assert set(writer.read().splitlines()) == {"#0", "Done!"}
+
+
+def test_spawn_context_as_object():
+    context = multiprocessing.get_context("spawn")
+    writer = Writer()
+    logger.add(writer, context=context, format="{message}", enqueue=True, catch=False)
+
+    with context.Pool(1, set_logger, [logger]) as pool:
+        pool.apply(do_something, (0,))
+        pool.close()
+        pool.join()
+
+    logger.info("Done!")
+    logger.remove()
+
+    assert set(writer.read().splitlines()) == {"#0", "Done!"}
+
+
+@pytest.mark.skipif(os.name == "nt", reason="Windows does not support forking")
+def test_fork_context_as_object():
+    context = multiprocessing.get_context("fork")
+    writer = Writer()
+    logger.add(writer, context=context, format="{message}", enqueue=True, catch=False)
+
+    with context.Pool(1, set_logger, [logger]) as pool:
+        pool.apply(do_something, (0,))
+        pool.close()
+        pool.join()
+
+    logger.info("Done!")
+    logger.remove()
+
+    assert set(writer.read().splitlines()) == {"#0", "Done!"}
