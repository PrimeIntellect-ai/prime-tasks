+
+  it('continues processing queued callbacks after a custom callback errors', done => {
+    let callbackExecuted = false
+    try {
+      asyncQueue.push(
+        [
+          function() {
+            throw 'caught error'
+          },
+        ],
+        [
+          function() {
+            callbackExecuted = true
+          },
+        ]
+      )
+    } catch (error) {
+      // The callback error may be reported to the caller after queue handling.
+    }
+
+    setTimeout(() => {
+      expect(callbackExecuted).toBe(true)
+      done()
+    }, 0)
+  })
 })
