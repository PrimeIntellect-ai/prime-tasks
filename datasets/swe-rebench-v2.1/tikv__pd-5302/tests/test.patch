+func TestCloneMetaStore(t *testing.T) {
+	re := require.New(t)
+	store := NewStoreInfo(&metapb.Store{Id: 1, Address: "mock://tikv-1", Labels: []*metapb.StoreLabel{{Key: "zone", Value: "z1"}, {Key: "host", Value: "h1"}}})
+	clone := store.Clone()
+	re.Equal(store.GetLabels(), clone.GetLabels())
+	clone.GetLabels()[0].Value = "changed value"
+	re.NotEqual(store.GetLabels(), clone.GetLabels())
+	re.Equal("z1", store.GetLabelValue("zone"))
+}
+
+func TestCloneMetaStoreCost(t *testing.T) {
+	re := require.New(t)
+	store := NewStoreInfo(&metapb.Store{Id: 1, Address: "mock://tikv-1", Labels: []*metapb.StoreLabel{{Key: "zone", Value: "z1"}, {Key: "host", Value: "h1"}}})
+	allocs := testing.AllocsPerRun(100, func() {
+		_ = store.Clone(SetLeaderCount(1))
+	})
+	re.Less(allocs, 20.0)
+}
+
+func BenchmarkStoreClone(b *testing.B) {
+	meta := &metapb.Store{Id: 1,
+		Address: "mock://tikv-1",
