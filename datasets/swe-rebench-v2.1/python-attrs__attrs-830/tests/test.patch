+class TestToBool(object):
+    @pytest.mark.parametrize(
+        "val", [True, "true", "t", "yes", "y", "on", "1", 1]
+    )
+    def test_truthy(self, val):
+        """
+        Returns True for every truthy representation.
+        """
+        assert to_bool(val) is True
+
+    @pytest.mark.parametrize(
+        "val", [False, "false", "f", "no", "n", "off", "0", 0]
+    )
+    def test_falsy(self, val):
+        """
+        Returns False for every falsy representation.
+        """
+        assert to_bool(val) is False
+
+    @pytest.mark.parametrize(
+        "val", ["TRUE", "True", "T", "YES", "Yes", "ON", "On"]
+    )
+    def test_truthy_case_insensitive(self, val):
+        """
+        Truthy strings are interpreted case-insensitively.
+        """
+        assert to_bool(val) is True
+
+    @pytest.mark.parametrize(
+        "val", ["FALSE", "False", "F", "NO", "No", "OFF", "Off"]
+    )
+    def test_falsy_case_insensitive(self, val):
+        """
+        Falsy strings are interpreted case-insensitively.
+        """
+        assert to_bool(val) is False
+
+    @pytest.mark.parametrize(
+        "val", ["foo", "", "2", 2, 1.0, 0.0, 33, None, object()]
+    )
+    def test_invalid(self, val):
+        """
+        Raises ValueError for any other input.
+        """
+        with pytest.raises(ValueError) as exc_info:
+            to_bool(val)
+
+        assert str(exc_info.value) == "Cannot convert value to bool: {}".format(val)
+
+    def test_unhashable(self):
+        """
+        Raises ValueError if value is unhashable.
+        """
+        val = []
+        with pytest.raises(ValueError) as exc_info:
+            to_bool(val)
+
+        assert str(exc_info.value) == "Cannot convert value to bool: {}".format(val)
+
+
+def test_test_module_imports_without_distutils(monkeypatch):
+    """The converter tests do not depend on the deprecated distutils module."""
+    import builtins
+    import runpy
+
+    original_import = builtins.__import__
+
+    def import_without_distutils(name, *args, **kwargs):
+        if name == "distutils" or name.startswith("distutils."):
+            raise ImportError("distutils is unavailable")
+        return original_import(name, *args, **kwargs)
+
+    monkeypatch.setattr(builtins, "__import__", import_without_distutils)
+    runpy.run_path(__file__, run_name="_test_converters_without_distutils")
