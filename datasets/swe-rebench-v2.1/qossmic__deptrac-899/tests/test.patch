+<?php
+
+declare(strict_types=1);
+
+namespace Tests\Qossmic\Deptrac\Layer\Collector;
+
+use PHPUnit\Framework\TestCase;
+use Qossmic\Deptrac\Ast\AstMap\AstMap;
+use Qossmic\Deptrac\Ast\AstMap\File\FileReferenceBuilder;
+use Qossmic\Deptrac\Console\ServiceContainerBuilder;
+use Qossmic\Deptrac\Layer\LayerResolverInterface;
+use function file_put_contents;
+use function is_dir;
+use function json_encode;
+use function mkdir;
+use function rmdir;
+use function sys_get_temp_dir;
+use function uniqid;
+use function unlink;
+
+final class GlobCollectorTest extends TestCase
+{
+    private string $projectDirectory;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->projectDirectory = sys_get_temp_dir().DIRECTORY_SEPARATOR.uniqid('deptrac-glob-', true);
+        mkdir($this->projectDirectory);
+    }
+
+    protected function tearDown(): void
+    {
+        @unlink($this->projectDirectory.DIRECTORY_SEPARATOR.'deptrac.yaml');
+        @rmdir($this->projectDirectory);
+
+        parent::tearDown();
+    }
+
+    public function dataProviderSatisfy(): iterable
+    {
+        yield ['foo/layer1/*', 'foo/layer1/bar.php', true];
+        yield ['foo/*/*.php', 'foo/layer1/bar.php', true];
+        yield ['foo/**/*', 'foo/layer1/dir/bar.php', true];
+        yield ['foo/layer1/*', 'foo/layer2/bar.php', false];
+        yield ['foo/layer2/*', 'foo/layer2/bar.php', true];
+        yield ['src/Model/*.php', 'src/Model/User.php', true];
+        yield ['src/Model/*.php', 'src/Model/Entity/User.php', false];
+        yield ['docs/*.md', 'docs/readme.md', true];
+        yield ['docs/*.md', 'src/readme.md', false];
+        yield ['foo/**/*.php', 'foo/a/b/c/Thing.php', true];
+        yield ['foo/**/*.php', 'foo/Thing.txt', false];
+        yield ['foo/**/*.php', 'bar/a/Thing.php', false];
+    }
+
+    /**
+     * @dataProvider dataProviderSatisfy
+     */
+    public function testSatisfy(string $pattern, string $filePath, bool $expected): void
+    {
+        $layerResolver = $this->createLayerResolver($pattern);
+
+        $fileReferenceBuilder = FileReferenceBuilder::create($this->projectDirectory.DIRECTORY_SEPARATOR.$filePath);
+        $fileReferenceBuilder->newClassLike('Test');
+        $fileReference = $fileReferenceBuilder->build();
+
+        $actual = $layerResolver->isReferenceInLayer(
+            'Glob',
+            $fileReference->getClassLikeReferences()[0],
+            new AstMap([])
+        );
+
+        self::assertSame($expected, $actual);
+    }
+
+    private function createLayerResolver(string $pattern): LayerResolverInterface
+    {
+        $configFile = $this->projectDirectory.DIRECTORY_SEPARATOR.'deptrac.yaml';
+        $config = [
+            'parameters' => [
+                'layers' => [
+                    [
+                        'name' => 'Glob',
+                        'collectors' => [
+                            ['type' => 'glob', 'value' => $pattern],
+                        ],
+                    ],
+                ],
+            ],
+            'services' => [
+                'test.layer_resolver' => [
+                    'alias' => LayerResolverInterface::class,
+                    'public' => true,
+                ],
+            ],
+        ];
+        file_put_contents($configFile, json_encode($config, JSON_THROW_ON_ERROR));
+
+        $container = (new ServiceContainerBuilder($this->projectDirectory))
+            ->withConfig($configFile)
+            ->build();
+
+        $layerResolver = $container->get('test.layer_resolver');
+        self::assertInstanceOf(LayerResolverInterface::class, $layerResolver);
+
+        return $layerResolver;
+    }
+}
