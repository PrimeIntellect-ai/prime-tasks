+func TestInitOutsideGOPATH(t *testing.T) {
+	root, err := ioutil.TempDir("", "nirvana-init")
+	if err != nil {
+		t.Fatalf("cannot create temporary directory: %v", err)
+	}
+	defer os.RemoveAll(root)
+
+	gopath := filepath.Join(root, "gopath")
+	if err := os.MkdirAll(gopath, 0755); err != nil {
+		t.Fatalf("cannot create temporary GOPATH: %v", err)
+	}
+	projectDir := filepath.Join(root, "sample")
+	cmd := exec.Command("go", "run", "../../cmd/nirvana", "init", projectDir)
+	cmd.Env = environmentWithGOPATH(os.Environ(), gopath)
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("nirvana init failed outside GOPATH: %v\n%s", err, output)
+	}
+	if info, err := os.Stat(projectDir); err != nil || !info.IsDir() {
+		t.Fatalf("nirvana init did not create the project directory: %v", err)
+	}
+}
+
+func environmentWithGOPATH(environment []string, gopath string) []string {
+	result := make([]string, 0, len(environment)+1)
+	for _, entry := range environment {
+		if len(entry) < len("GOPATH=") || entry[:len("GOPATH=")] != "GOPATH=" {
+			result = append(result, entry)
+		}
 	}
+	return append(result, "GOPATH="+gopath)
 }
