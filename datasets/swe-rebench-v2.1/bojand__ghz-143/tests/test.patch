+func TestCallTemplateData_TimestampUnixMilli(t *testing.T) {
+	md, err := protodesc.GetMethodDescFromProto("helloworld.Greeter/SayHello", "../testdata/greeter.proto", []string{})
+	assert.NoError(t, err)
+	assert.NotNil(t, md)
+
+	ctd := newCallTemplateData(md, "worker_id_123", 100)
+
+	r, err := ctd.executeData(`{"ts":"{{.TimestampUnixMilli}}"}`)
+	assert.NoError(t, err)
+
+	var out map[string]string
+	err = json.Unmarshal(r, &out)
+	assert.NoError(t, err)
+
+	ms, err := strconv.ParseInt(out["ts"], 10, 64)
+	assert.NoError(t, err)
+	assert.NotZero(t, ms)
+
+	nowMs := time.Now().UnixNano() / 1000000
+	assert.InDelta(t, nowMs, ms, 5000)
+}
