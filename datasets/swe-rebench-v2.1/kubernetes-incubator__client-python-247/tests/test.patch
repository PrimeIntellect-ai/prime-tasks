+import unittest
+from unittest import mock
+from urllib.parse import urlparse
+
+from .ws_client import websocket_call
+
+
+class WSClientTest(unittest.TestCase):
+
+    def test_websocket_connection_preserves_host_and_path(self):
+        # Exercise the actual transport setup; only the network operation is
+        # replaced so the URL supplied for the connection can be inspected.
+        cases = [
+            ('http://localhost/api', 'ws', 'localhost', '/api'),
+            ('https://localhost/api', 'wss', 'localhost', '/api'),
+            ('https://api.domain.com/api', 'wss', 'api.domain.com', '/api'),
+            ('http://api.domain.com', 'ws', 'api.domain.com', ''),
+            ('https://api.domain.com/', 'wss', 'api.domain.com', '/'),
+        ]
+        configuration = mock.Mock(verify_ssl=False)
+        for url, expected_scheme, expected_host, expected_path in cases:
+            with self.subTest(url=url):
+                with mock.patch('kubernetes.client.ws_client.WebSocket') as socket:
+                    websocket_call(configuration, url, [], None, False, None)
+                connected_url = socket.return_value.connect.call_args[0][0]
+                self.assertTrue(connected_url.startswith(expected_scheme + '://'))
+                http_url = connected_url.replace(
+                    expected_scheme + '://', 'http://', 1)
+                parsed = urlparse(http_url)
+                self.assertEqual(parsed.hostname, expected_host)
+                # A missing root path and an explicit slash identify the same
+                # root resource; non-root paths must be preserved as given.
+                actual_path = parsed.path
+                if expected_path in ('', '/'):
+                    self.assertIn(actual_path, ('', '/'))
+                else:
+                    self.assertEqual(actual_path, expected_path)
+
+
+if __name__ == '__main__':
+    unittest.main()
