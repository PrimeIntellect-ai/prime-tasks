+
+describe('numeric alias formatting', () => {
+  const rule = FormatYamlArray.getRule();
+
+  it('keeps a numeric alias a YAML string when converting to a multiline array', () => {
+    const output = rule.apply('---\naliases: 1234, alias1\n---\n', {
+      aliasArrayStyle: NormalArrayFormats.MultiLine,
+    });
+    const frontmatter = output.match(/^---\r?\n([\s\S]*?)\r?\n---/);
+    expect(frontmatter).not.toBeNull();
+    const parsed = parseYaml(frontmatter![1]) as {aliases: unknown[]};
+
+    expect(parsed.aliases).toEqual(expect.arrayContaining(['1234', 'alias1']));
+    expect(parsed.aliases).not.toContain(1234);
+  });
+
+  it('quotes the numeric alias when keeping comma-delimited formatting', () => {
+    const output = rule.apply('---\naliases: 1234, alias1\n---\n', {
+      aliasArrayStyle: SpecialArrayFormats.SingleStringCommaDelimited,
+    });
+
+    expect(output).toMatch(/(?:\"1234\"|'1234')/);
+  });
+
+  it('keeps a numeric alias a YAML string in a normal single-line array', () => {
+    const output = rule.apply('---\naliases: [1234, alias1]\n---\n', {
+      aliasArrayStyle: NormalArrayFormats.SingleLine,
+    });
+    const frontmatter = output.match(/^---\r?\n([\s\S]*?)\r?\n---/);
+    expect(frontmatter).not.toBeNull();
+    const parsed = parseYaml(frontmatter![1]) as {aliases: unknown[]};
+
+    expect(parsed.aliases).toEqual(expect.arrayContaining(['1234', 'alias1']));
+    expect(parsed.aliases).not.toContain(1234);
+  });
+});
