 });
+
+
+describe('YAML title alias updates', () => {
+  const rule = YamlTitleAlias.getRule();
+  const options = {
+    aliasArrayStyle: NormalArrayFormats.SingleLine,
+    defaultEscapeCharacter: '"' as const,
+  };
+
+  function applyAndReadFrontmatter(before: string): Record<string, unknown> {
+    const output = rule.apply(before, options);
+    const frontmatter = output.match(/^---\r?\n([\s\S]*?)\r?\n---/);
+    expect(frontmatter).not.toBeNull();
+    return parseYaml(frontmatter![1]) as Record<string, unknown>;
+  }
+
+  it.each([
+    ['quoted prior alias and numeric tracking value', '\"12345678\"', '12345678'],
+    ['unquoted prior alias and numeric tracking value', '12345678', '12345678'],
+    ['quoted prior alias and quoted tracking value', '\"12345678\"', '\"12345678\"'],
+  ])('replaces a prior numerical managed alias and keeps the tracking value in sync (%s)', (_description, oldAlias, oldTracking) => {
+    const frontmatter = applyAndReadFrontmatter(`---\naliases: [${oldAlias}, alias1]\nlinter-yaml-title-alias: ${oldTracking}\n---\n# 1234\n`);
+    const aliases = frontmatter.aliases as unknown[];
+
+    // A numeric alias must remain a YAML string, while unrelated aliases are retained.
+    expect(aliases).toEqual(expect.arrayContaining(['1234', 'alias1']));
+    expect(aliases.filter((alias) => alias === '1234')).toHaveLength(1);
+    expect(aliases).not.toContain('12345678');
+    expect(String(frontmatter['linter-yaml-title-alias'])).toBe('1234');
+  });
+
+  it('treats a comma-containing prior title as one managed alias during an H1 update', () => {
+    const frontmatter = applyAndReadFrontmatter(`---\naliases: [\"old, title\", keep-me]\nlinter-yaml-title-alias: \"old, title\"\n---\n# 1234\n`);
+    const aliases = frontmatter.aliases as unknown[];
+
+    expect(aliases).toEqual(expect.arrayContaining(['1234', 'keep-me']));
+    expect(aliases.filter((alias) => alias === '1234')).toHaveLength(1);
+    expect(aliases).not.toContain('old');
+    expect(aliases).not.toContain('title');
+    expect(String(frontmatter['linter-yaml-title-alias'])).toBe('1234');
+  });
+
+  it('updates the tracking value to the current H1-derived title', () => {
+    const frontmatter = applyAndReadFrontmatter('---\naliases: [alias1]\nlinter-yaml-title-alias: blob\n---\n# 1234\n');
+
+    expect(String(frontmatter['linter-yaml-title-alias'])).toBe('1234');
+  });
+});
