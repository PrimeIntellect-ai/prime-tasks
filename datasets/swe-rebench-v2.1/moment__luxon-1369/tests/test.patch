diff --git a/test/datetime/tokenParse.test.js b/test/datetime/tokenParse.test.js
index 1090ff7..5893f8c 100644
--- a/test/datetime/tokenParse.test.js
+++ b/test/datetime/tokenParse.test.js
@@ -790,6 +790,33 @@ test("DateTime.fromFormat() parses localized macro tokens", () => {
   }
 });
 
+test("DateTime.fromFormat() parses the reported date and time with a localized time macro", () => {
+  const parsed = DateTime.fromFormat("1/17/2023 11:00:00 PM", "M/d/yyyy tt", {
+    zone: "Europe/Copenhagen",
+  });
+
+  expect(parsed.isValid).toBe(true);
+  expect(parsed.toObject()).toMatchObject({
+    year: 2023,
+    month: 1,
+    day: 17,
+    hour: 23,
+    minute: 0,
+    second: 0,
+  });
+  expect(parsed.zoneName).toBe("Europe/Copenhagen");
+  expect(parsed.toISO()).toBe("2023-01-17T23:00:00.000+01:00");
+});
+
+test("DateTime.fromFormat() allows non-breaking white-space to be substituted inside macro-tokens", () => {
+  const withRegularSpace = DateTime.fromFormat("5:54 PM", "t", { locale: "en-US" });
+  const withNonBreakingSpace = DateTime.fromFormat("5:54 PM", "t", { locale: "en-US" });
+
+  expect(withRegularSpace.isValid).toBe(true);
+  expect(withNonBreakingSpace.isValid).toBe(true);
+  expect(withNonBreakingSpace.toObject()).toEqual(withRegularSpace.toObject());
+});
+
 test("DateTime.fromFormat() throws if you don't provide a format", () => {
   expect(() => DateTime.fromFormat("yo")).toThrowError();
 });
