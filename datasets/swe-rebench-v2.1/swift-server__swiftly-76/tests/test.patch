+    /// Verify that an install option can make the newly installed toolchain active.
+    func testInstallCanActivateNewToolchainWithAnOption() async throws {
+        let help = Install.helpMessage(columns: 160)
+        let expression = try NSRegularExpression(pattern: #"--[A-Za-z][A-Za-z0-9-]*|-[A-Za-z]"#)
+        let matches = expression.matches(in: help, range: NSRange(help.startIndex..., in: help))
+        let options = matches.compactMap { match -> String? in
+            guard let range = Range(match.range, in: help) else { return nil }
+            let option = String(help[range])
+            return ["--help", "-h"].contains(option) ? nil : option
         }
+
+        var activatedToolchain = false
+        for option in options {
+            do {
+                try await self.withTestHome {
+                    try await self.installMockedToolchain(toolchain: Self.oldStable)
+                    try await self.installMockedToolchain(selector: Self.newStable.name, args: [option])
+                    activatedToolchain = try Config.load().inUse == Self.newStable
+                }
+            } catch {
+                // Other advertised options may require values or perform unrelated actions.
+            }
+
+            if activatedToolchain {
+                break
+            }
+        }
+
+        XCTAssertTrue(activatedToolchain, "No install option activated the newly installed toolchain")
     }
