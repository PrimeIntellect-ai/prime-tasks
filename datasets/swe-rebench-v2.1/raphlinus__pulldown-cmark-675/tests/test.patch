+#[test]
+fn html_like_line_and_empty_blockquote_events() {
+    use pulldown_cmark::{Event, Parser, Tag, TagEnd};
+
+    let original = "<G\n>\n";
+    let events: Vec<Event> = Parser::new(original).collect();
+
+    // The input must not be treated as raw HTML.
+    assert!(
+        !events.iter().any(|e| matches!(e, Event::Html(_))),
+        "input was parsed as HTML: {:?}",
+        events
+    );
+
+    // Merge adjacent text events so the assertion does not depend on how the
+    // text is chunked internally.
+    let mut normalized: Vec<Event> = Vec::new();
+    for event in events {
+        match (normalized.last_mut(), event) {
+            (Some(Event::Text(prev)), Event::Text(next)) => {
+                let mut merged = String::from(&**prev);
+                merged.push_str(&next);
+                *prev = merged.into();
+            }
+            (_, event) => normalized.push(event),
+        }
+    }
+
+    let expected = vec![
+        Event::Start(Tag::Paragraph),
+        Event::Text("<G".into()),
+        Event::End(TagEnd::Paragraph),
+        Event::Start(Tag::BlockQuote),
+        Event::End(TagEnd::BlockQuote),
+    ];
+
+    assert_eq!(normalized, expected);
+}
