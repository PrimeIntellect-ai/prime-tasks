     assertImageApproved(p, 'plotcurveitem/connectarray', "Plot curve with connection array.")
 
     p.close()
+
+
+def test_single_point_curve_renders_with_x_axis():
+    app = pg.mkQApp()
+    widget = pg.GraphicsLayoutWidget()
+    widget.resize(320, 240)
+    plot = widget.addPlot()
+    plot.plot([1.0], pen=pg.mkPen(width=2), antialias=False)
+    x_axis = plot.getAxis('bottom')
+
+    scene = widget.scene()
+    source_rect = scene.sceneRect()
+    axis_rect = x_axis.sceneBoundingRect()
+    image = pg.Qt.QtGui.QImage(
+        320, 240, pg.Qt.QtGui.QImage.Format.Format_ARGB32)
+    image.fill(pg.Qt.QtCore.Qt.GlobalColor.white)
+    painter = pg.Qt.QtGui.QPainter(image)
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter('always', RuntimeWarning)
+        scene.render(
+            painter,
+            pg.Qt.QtCore.QRectF(0, 0, image.width(), image.height()),
+            source_rect,
+        )
+    painter.end()
+
+    render_errors = [
+        warning for warning in caught
+        if issubclass(warning.category, RuntimeWarning)
+        and 'Ignored exception' in str(warning.message)
+    ]
+    assert not render_errors
+    assert x_axis.isVisible()
+
+    scale_x = image.width() / source_rect.width()
+    scale_y = image.height() / source_rect.height()
+    left = int((axis_rect.left() - source_rect.left()) * scale_x)
+    right = int((axis_rect.right() - source_rect.left()) * scale_x)
+    top = int((axis_rect.top() - source_rect.top()) * scale_y)
+    bottom = int((axis_rect.bottom() - source_rect.top()) * scale_y)
+    assert any(
+        image.pixelColor(x, y) != pg.Qt.QtGui.QColor('white')
+        for y in range(max(0, top), min(image.height(), bottom + 1))
+        for x in range(max(0, left), min(image.width(), right + 1))
+    )
+    widget.close()
