 import ReIndexFootnotes from '../src/rules/re-index-footnotes';
 import dedent from 'ts-dedent';
 import {ruleTest} from './common';
+import {moment} from 'obsidian';
+import {LinterSettings, rules} from '../src/rules';
+import '../src/rules-registry';
+import {RulesRunner} from '../src/rules-runner';
+import {NormalArrayFormats} from '../src/utils/yaml';
 
 ruleTest({
   RuleBuilderClass: ReIndexFootnotes,
@@ -14,6 +19,177 @@ ruleTest({
         \`h[^ae]llo\`
       `,
     },
+    { // accounts for https://github.com/platers/obsidian-linter/issues/677
+      testName: 'Re-indexing footnotes leaves a note without footnotes unchanged',
+      before: dedent`
+        Some text without any footnotes.
+      `,
+      after: dedent`
+        Some text without any footnotes.
+      `,
+    },
   ],
 });
 
+describe('Re-indexing footnotes with duplicate declarations', () => {
+  const rule = ReIndexFootnotes.getRule();
+
+  it('Re-indexing footnotes condense duplicate footnotes into 1 when key and footnote are the same', () => {
+    const before = dedent`
+      bla[^1], bla[^1], bla[^2]
+      [^1]: bla
+      [^1]: bla
+      [^2]: bla
+    `;
+    const after = rule.apply(before, undefined);
+
+    // The contract only requires that repeated references keep pointing at the same
+    // footnote. Whether the duplicate declarations are condensed or kept is an
+    // implementation detail, so only the references are asserted on here.
+    expect(after).toContain('bla[^1], bla[^1], bla[^2]');
+  });
+});
+
+describe('Re-indexing footnotes tidy-footnotes behaviour', () => {
+  const rule = ReIndexFootnotes.getRule();
+
+  it('Re-indexing footnotes consolidates footnote definitions at the end of the note', () => {
+    const before = dedent`
+      Some text[^1] with a footnote.
+
+      [^1]: first
+
+      More text.
+    `;
+    const after = rule.apply(before, undefined);
+
+    // The footnote reference is preserved and the definition is consolidated at the end.
+    expect(after).toContain('Some text[^1] with a footnote.');
+    expect(after.indexOf('[^1]: first')).toBeGreaterThan(after.indexOf('More text.'));
+  });
+});
+
+describe('Re-indexing footnotes trailing blank lines', () => {
+  const rule = ReIndexFootnotes.getRule();
+
+  it('Re-indexing footnotes does not add trailing blank lines to a note without footnotes', () => {
+    const before = 'Some text without any footnotes.\n\n\n';
+    const after = rule.apply(before, undefined);
+
+    // The rule must not add extra trailing blank lines when there are no footnotes.
+    expect(after.replace(/\n+$/, '')).toBe('Some text without any footnotes.');
+    expect(after.length).toBeLessThanOrEqual(before.length);
+  });
+});
+
+
+// Compare the full result while treating one or more empty lines as equivalent.
+// Definition order, numbering, and all non-blank-line content remain significant.
+function applyIgnoringBlankLineCount(before: string): string {
+  return ReIndexFootnotes.getRule().apply(before, undefined).replace(/\n{2,}/g, '\n\n');
+}
+
+describe('Re-indexing footnotes reference ordering', () => {
+  it('orders definitions by first reference and renumbers references sequentially', () => {
+    const before = dedent`
+      aaaaaa[^1]
+      cccccc[^3]
+      ddddd[^4]
+      bbbbb[^2]
+      fffffff[^5]
+      ${''}
+      [^1]: a-footnote
+      [^2]: b-footnote
+      [^3]: c-footnote
+      [^4]: d-footnote
+      [^5]: f-footnote
+    `;
+    const expected = dedent`
+      aaaaaa[^1]
+      cccccc[^2]
+      ddddd[^3]
+      bbbbb[^4]
+      fffffff[^5]
+      ${''}
+      [^1]: a-footnote
+      [^2]: c-footnote
+      [^3]: d-footnote
+      [^4]: b-footnote
+      [^5]: f-footnote
+    `;
+
+    expect(applyIgnoringBlankLineCount(before)).toBe(expected.replace(/\n{2,}/g, '\n\n'));
+  });
+
+  it('preserves repeated references to the same footnote', () => {
+    const before = dedent`
+      First,[^1] followed by the Second,[^2] and then the First[^1] again.
+      ${''}
+      [^1]: First Reference
+      [^2]: Second reference
+    `;
+    const expected = dedent`
+      First,[^1] followed by the Second,[^2] and then the First[^1] again.
+      ${''}
+      [^1]: First Reference
+      [^2]: Second reference
+    `;
+
+    expect(applyIgnoringBlankLineCount(before)).toBe(expected.replace(/\n{2,}/g, '\n\n'));
+  });
+
+  it('keeps repeated references together when other footnotes are interleaved', () => {
+    const before = dedent`
+      Lorem ipsum dolor sit amet, consectetur adipiscing elit.[^1] Aenean at aliquet felis. Donec dictum turpis quis ipsum pellentesque, et iaculis tortor condimentum.[^1a] Vestibulum nec blandit felis, vulputate finibus purus.[^2] Praesent quis iaculis diam.[^1]
+      ${''}
+      [^1]: first footnote
+      [^1a]: third footnote, inserted later
+      [^2]: second footnotes
+    `;
+    const expected = dedent`
+      Lorem ipsum dolor sit amet, consectetur adipiscing elit.[^1] Aenean at aliquet felis. Donec dictum turpis quis ipsum pellentesque, et iaculis tortor condimentum.[^2] Vestibulum nec blandit felis, vulputate finibus purus.[^3] Praesent quis iaculis diam.[^1]
+      ${''}
+      [^1]: first footnote
+      [^2]: third footnote, inserted later
+      [^3]: second footnotes
+    `;
+
+    expect(applyIgnoringBlankLineCount(before)).toBe(expected.replace(/\n{2,}/g, '\n\n'));
+  });
+});
+
+describe('Re-indexing footnotes through the linter', () => {
+  it('provides footnote tidying when the linter runs the enabled rule', () => {
+    const settings: LinterSettings = {
+      ruleConfigs: Object.fromEntries(rules.map((rule) => [rule.alias, {enabled: rule.alias === 're-index-footnotes'}])),
+      lintOnSave: false,
+      displayChanged: false,
+      settingsConvertedToConfigKeyValues: true,
+      recordLintOnSaveLogs: false,
+      foldersToIgnore: [],
+      linterLocale: 'en',
+      logLevel: 0,
+      lintCommands: [],
+      customRegexes: [],
+      commonStyles: {
+        aliasArrayStyle: NormalArrayFormats.SingleLine,
+        tagArrayStyle: NormalArrayFormats.SingleLine,
+        minimumNumberOfDollarSignsToBeAMathBlock: 2,
+        escapeCharacter: '"',
+        removeUnnecessaryEscapeCharsForMultiLineArrays: false,
+      },
+    };
+    const before = 'First[^b] then same[^b] then second[^a].\n\n[^a]: second\n[^b]: first\n';
+    const after = new RulesRunner().lintText({
+      oldText: before,
+      fileInfo: {name: 'note.md', createdAtFormatted: '2020-01-01', modifiedAtFormatted: '2020-01-01'},
+      settings,
+      momentLocale: 'en',
+      getCurrentTime: () => moment('2020-01-01'),
+    });
+
+    expect(after).toContain('First[^1] then same[^1] then second[^2].');
+    expect(after.indexOf('[^1]: first')).toBeGreaterThan(after.indexOf('then second[^2].'));
+    expect(after.indexOf('[^2]: second')).toBeGreaterThan(after.indexOf('[^1]: first'));
+  });
+});
