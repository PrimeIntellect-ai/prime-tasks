+    def test_flux_binary_operator_uses_harmonic_average(self):
+        mesh = get_mesh_for_testing()
+        domains = ["negative electrode"]
+        disc = pybamm.Discretisation(
+            mesh, {"macroscale": pybamm.FiniteVolume()}
+        )
+        diffusivity = pybamm.Variable("diffusivity", domain=domains)
+        concentration = pybamm.Variable("concentration", domain=domains)
+        disc.set_variable_slices([diffusivity, concentration])
+
+        submesh = mesh[domains[0]][0]
+        n = submesh.npts
+        diffusivity_values = np.arange(1, n + 1, dtype=float)
+        concentration_values = np.arange(n, dtype=float)
+        y_test = np.concatenate([diffusivity_values, concentration_values])
+        disc.bcs = {
+            concentration.id: {
+                "left": (pybamm.Scalar(0), "Dirichlet"),
+                "right": (pybamm.Scalar(0), "Dirichlet"),
+            }
+        }
+
+        flux = disc.process_symbol(diffusivity * pybamm.grad(concentration))
+        gradient = disc.process_symbol(pybamm.grad(concentration))
+        flux_values = flux.evaluate(None, y_test).ravel()
+        gradient_values = gradient.evaluate(None, y_test).ravel()
+
+        beta = submesh.d_edges[:-1] / (
+            submesh.d_edges[1:] + submesh.d_edges[:-1]
+        )
+        left = diffusivity_values[:-1]
+        right = diffusivity_values[1:]
+        harmonic_diffusivity = left * right / (
+            right * beta + left * (1 - beta)
+        )
+        np.testing.assert_allclose(
+            flux_values[1:-1], gradient_values[1:-1] * harmonic_diffusivity
+        )
 
