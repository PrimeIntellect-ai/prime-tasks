+
+    @testset "remove_subtree! - tree mechanism" begin
+        mechanism = parse_urdf(joinpath(@__DIR__, "urdf", "atlas.urdf"), floating=true)
+        # Behead.
+        num_bodies = length(bodies(mechanism))
+        num_joints = length(joints(mechanism))
+        head = findbody(mechanism, "head")
+        neck_joint = joint_to_parent(head, mechanism)
+        remove_subtree!(mechanism, head)
+        @test length(bodies(mechanism)) == num_bodies - 1
+        @test length(joints(mechanism)) == num_joints - 1
+        @test head ∉ bodies(mechanism)
+        @test neck_joint ∉ joints(mechanism)
+
+        # Lop off an arm.
+        num_bodies = length(bodies(mechanism))
+        num_joints = length(joints(mechanism))
+        r_clav = findbody(mechanism, "r_clav")
+        r_hand = findbody(mechanism, "r_hand")
+        r_arm = path(mechanism, r_clav, r_hand)
+        arm_joints = collect(r_arm)
+        arm_bodies = [r_clav; map(joint -> successor(joint, mechanism), arm_joints)]
+        remove_subtree!(mechanism, r_clav)
+        @test length(joints(mechanism)) == num_joints - length(arm_joints) - 1
+        @test length(bodies(mechanism)) == num_bodies - length(arm_bodies)
+        @test isempty(intersect(arm_joints, joints(mechanism)))
+        @test isempty(intersect(arm_bodies, bodies(mechanism)))
+    end
+
+    @testset "prune unrelated URDF branches and retain the selected arm" begin
+        mechanism = parse_urdf(joinpath(@__DIR__, "urdf", "valkyrie.urdf"), floating=true)
+        torso = findbody(mechanism, "torso")
+        right_arm_root = findbody(mechanism, "rightShoulderPitchLink")
+        right_hand = findbody(mechanism, "rightPalm")
+        retained_chain = collect(path(mechanism, torso, right_hand))
+        right_shoulder_joint = joint_to_parent(right_arm_root, mechanism)
+        unrelated_roots = [successor(joint, mechanism) for joint in out_joints(torso, mechanism)
+                           if successor(joint, mechanism) != right_arm_root]
+        unrelated_connections = [joint_to_parent(body, mechanism) for body in unrelated_roots]
+
+        for body in unrelated_roots
+            remove_subtree!(mechanism, body)
+        end
+
+        @test torso ∈ bodies(mechanism)
+        @test right_hand ∈ bodies(mechanism)
+        @test right_shoulder_joint ∈ path(mechanism, root_body(mechanism), right_hand)
+        @test right_shoulder_joint ∈ joints(mechanism)
+        @test all(body ∉ bodies(mechanism) for body in unrelated_roots)
+        @test all(joint ∉ joints(mechanism) for joint in unrelated_connections)
+        @test collect(out_joints(torso, mechanism)) == [right_shoulder_joint]
+    end
+
 end # mechanism modification
