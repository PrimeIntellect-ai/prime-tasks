+
+def test_remote_pin_from_unidentified_client(monkeypatch):
+    import sys
+    from types import ModuleType
+    pigpio_client = ModuleType('pigpio')
+    for value, name in enumerate((
+            'INPUT OUTPUT ALT0 ALT1 ALT2 ALT3 ALT4 ALT5 PUD_UP PUD_DOWN '
+            'PUD_OFF EITHER_EDGE RISING_EDGE FALLING_EDGE').split()):
+        setattr(pigpio_client, name, value)
+    pigpio_client.error = Exception
+    monkeypatch.setitem(sys.modules, 'pigpio', pigpio_client)
+    from gpiozero.pins import pigpiod
+
+    class RemoteDaemon:
+        def __init__(self):
+            self.sl = type('Socket', (), {'s': object()})()
+
+        def get_hardware_revision(self):
+            return 0xa02082
+
+        def set_mode(self, number, mode):
+            return 0
+
+        def get_mode(self, number):
+            return 0
+
+        def set_pull_up_down(self, number, pull):
+            return 0
+
+        def set_glitch_filter(self, number, value):
+            return 0
+
+        def set_PWM_range(self, number, value):
+            return 0
+
+    monkeypatch.setattr(pigpiod.pigpio, 'pi', lambda host, port: RemoteDaemon(), raising=False)
+
+    pin = pigpiod.PiGPIOPin(17, host='192.0.2.123')
+    try:
+        assert pin.number == 17
+    finally:
+        pin.close()
