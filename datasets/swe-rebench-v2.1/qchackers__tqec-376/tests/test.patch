+def _translate_plaquettes(plaquettes: Plaquettes, offset: int) -> Plaquettes:
+    """Return ``plaquettes`` with every index shifted by ``offset``.
+
+    The default plaquette (used for indices that are not explicitly stored) is
+    preserved so that the translated collection describes the same situation as
+    the original one, only translated.
+    """
+    default_plaquette = plaquettes.collection[0]
+    return Plaquettes(
+        FrozenDefaultDict(
+            {
+                plaquette_index + offset: plaquette
+                for plaquette_index, plaquette in plaquettes.collection.items()
+            },
+            default_factory=lambda: default_plaquette,
         )
