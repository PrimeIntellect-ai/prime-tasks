+def test_detector_database_translation_invariance() -> None:
+    db = DetectorDatabase()
+    db.add_situation(SUBTEMPLATES[:1], PLAQUETTE_COLLECTIONS[:1], DETECTORS[0])
+
+    offset = 36
+    translated_subtemplate = SUBTEMPLATES[0] + offset
+    translated_plaquettes = _translate_plaquettes(PLAQUETTE_COLLECTIONS[0], offset)
+    detectors = db.get_detectors((translated_subtemplate,), (translated_plaquettes,))
+    assert detectors is not None
+    assert detectors == DETECTORS[0]
+
+
+def test_detector_database_translation_invariance_multiple_timesteps() -> None:
+    db = DetectorDatabase()
+    db.add_situation(SUBTEMPLATES[:2], PLAQUETTE_COLLECTIONS[:2], DETECTORS[1])
+
+    offset = 12
+    translated_subtemplates = tuple(st + offset for st in SUBTEMPLATES[:2])
+    translated_plaquettes = tuple(
+        _translate_plaquettes(plaquettes, offset)
+        for plaquettes in PLAQUETTE_COLLECTIONS[:2]
+    )
+    detectors = db.get_detectors(translated_subtemplates, translated_plaquettes)
+    assert detectors is not None
+    assert detectors == DETECTORS[1]
