+package chartutil
+
+import (
+	"testing"
+)
+
+func TestErrorNoTableDoesntPanic(t *testing.T) {
+	_, err := (Values{}).Table("empty")
+	if err == nil {
+		t.Fatal("expected a missing-table error")
+	}
+
+	t.Logf("error is: %s", err)
+}
+
+func TestErrorNoValueDoesntPanic(t *testing.T) {
+	_, err := (Values{}).PathValue("empty")
+	if err == nil {
+		t.Fatal("expected a missing-value error")
+	}
+
+	t.Logf("error is: %s", err)
+}
