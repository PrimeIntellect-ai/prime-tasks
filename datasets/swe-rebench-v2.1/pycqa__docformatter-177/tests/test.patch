+    @pytest.mark.unit
+    def test_format_docstring_leave_blank_line_after_comment(
+        self, monkeypatch
+    ):
+        """Leave blank lines after docstring followed by a comment.
+
+        See issue #176.
+        """
+        docstring = '''\
+class Class1:
+    """Class.""" #noqa
+
+    attribute
+    """Attr."""
+
+
+class Class3:
+    """Class docstring.
+
+    With long description.
+    """    #noqa
+
+    attribute
+    """Attr."""
+'''
+        output = io.StringIO()
+        monkeypatch.setattr(sys, "argv", ["docformatter", "-"])
+        monkeypatch.setattr(sys, "stdin", io.StringIO(docstring))
+        monkeypatch.setattr(sys, "stdout", output)
+
+        main()
+
+        formatted_lines = output.getvalue().splitlines()
+        noqa_lines = [
+            index for index, line in enumerate(formatted_lines)
+            if "#noqa" in line
+        ]
+        assert len(noqa_lines) == 2
+        for index in noqa_lines:
+            assert formatted_lines[index + 1] == ""
+            assert formatted_lines[index + 2].strip() == "attribute"
+
+
 class TestFormatLists:
     """Class for testing format_docstring() with lists in the docstring."""
 
