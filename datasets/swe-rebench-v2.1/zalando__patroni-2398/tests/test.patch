+    def test_postgresql_listen_wildcard(self, mock_out, mock_err):
+        c = copy.deepcopy(config)
+        c["postgresql"]["listen"] = "*:5432"
+
+        def connect_for_validation(host_port):
+            return 1 if host_port[1] == 5432 else connect_side_effect(host_port)
+
+        real_getaddrinfo = socket.getaddrinfo
+
+        def resolve_for_validation(host, *args, **kwargs):
+            if host == "*":
+                raise socket.gaierror("wildcard host must be expanded before resolution")
+            return real_getaddrinfo(host, *args, **kwargs)
+
+        with patch('socket.getaddrinfo', side_effect=resolve_for_validation):
+            with patch('socket.socket.connect_ex', Mock(side_effect=connect_for_validation)):
+                errors = schema(c)
+
+        self.assertNotIn('postgresql.listen', parse_output("\n".join(errors)))
