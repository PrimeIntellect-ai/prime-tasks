+func TestSSHKeyClientUpdate(t *testing.T) {
+	env := newTestEnv()
+	defer env.Teardown()
+
+	env.Mux.HandleFunc("/ssh_keys/1", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPut {
+			t.Errorf("expected PUT, got %s", r.Method)
+		}
+		var reqBody struct {
+			Name string `json:"name"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&reqBody); err != nil {
+			t.Fatal(err)
+		}
+		if reqBody.Name != "test" {
+			t.Errorf("unexpected name: %q", reqBody.Name)
+		}
+		fmt.Fprint(w, `{"ssh_key":{"id":1,"name":"test"}}`)
+	})
+
+	method := reflect.ValueOf(&env.Client.SSHKey).MethodByName("Update")
+	if !method.IsValid() {
+		t.Fatal("SSHKeyClient does not expose Update")
+	}
+	methodType := method.Type()
+	if methodType.NumIn() != 3 || methodType.NumOut() < 2 {
+		t.Fatalf("unexpected Update signature: %v", methodType)
+	}
+	optionsType := methodType.In(2)
+	if optionsType.Name() != "SSHKeyUpdateOpts" {
+		t.Fatalf("Update accepts %v, want SSHKeyUpdateOpts", optionsType)
+	}
+	options := reflect.New(optionsType).Elem()
+	nameField := options.FieldByName("Name")
+	if !nameField.IsValid() || !nameField.CanSet() || nameField.Kind() != reflect.String {
+		t.Fatal("SSHKeyUpdateOpts does not expose a string Name field")
+	}
+	nameField.SetString("test")
+
+	results := method.Call([]reflect.Value{
+		reflect.ValueOf(context.Background()),
+		reflect.ValueOf(&SSHKey{ID: 1}),
+		options,
+	})
+	if !results[len(results)-1].IsNil() {
+		t.Fatalf("Update returned an error: %v", results[len(results)-1].Interface())
+	}
+	updatedSSHKey, ok := results[0].Interface().(*SSHKey)
+	if !ok || updatedSSHKey == nil {
+		t.Fatalf("Update returned no SSH key: %v", results[0].Interface())
+	}
+	if updatedSSHKey.ID != 1 {
+		t.Errorf("unexpected SSH key ID: %v", updatedSSHKey.ID)
+	}
+	if updatedSSHKey.Name != "test" {
+		t.Errorf("unexpected SSH key name: %q", updatedSSHKey.Name)
+	}
+}
