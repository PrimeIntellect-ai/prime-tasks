+// https://github.com/gleam-lang/gleam/issues/4430
+#[test]
+fn inline_variable_with_record_field() {
+    assert_code_action!(
+        INLINE_VARIABLE,
+        "
+type Couple {
+  Couple(l: Int, r: Int)
+}
+
+pub fn main() {
+  let c1 = Couple(l: 1, r: 1)
+  let c2 = c1.l
+  echo c2
+}
+",
+        find_position_of("c2").nth_occurrence(2).to_selection()
+    );
+}
+
+// A variable whose definition is a larger expression that starts with a
+// record field access must also be inlined without dropping the record.
+#[test]
+fn inline_variable_with_nested_record_field() {
+    let src = r#"
+type Inner {
+  Inner(value: Int)
+}
+
+type Outer {
+  Outer(inner: Inner)
+}
+
+pub fn main() {
+  let o = Outer(inner: Inner(value: 1))
+  let xyz = o.inner.value
+  echo xyz
+}
+"#;
+    let project = TestProject::for_source(src);
+    let range = find_position_of("xyz")
+        .nth_occurrence(2)
+        .to_selection()
+        .find_range(src);
+    let result = apply_code_action(INLINE_VARIABLE, project, range);
+    assert_eq!(
+        result,
+        r#"
+type Inner {
+  Inner(value: Int)
+}
+
+type Outer {
+  Outer(inner: Inner)
+}
+
+pub fn main() {
+  let o = Outer(inner: Inner(value: 1))
+  echo o.inner.value
+}
+"#
+    );
+}
+
