+import torch
+import numpy as np
+
+import pytest
+
+from ignite.metrics import Average
+from ignite.engine import Engine
+
+
+torch.manual_seed(15)
+
+
+def test_average():
+
+    mean_var = Average()
+    y_true = torch.rand(100) + torch.randint(0, 10, size=(100,)).float()
+
+    for y in y_true:
+        mean_var.update(y.item())
+
+    m = mean_var.compute()
+    assert np.asarray(m) == pytest.approx(y_true.mean().item())
+
+    mean_var = Average()
+    y_true = torch.rand(100, 10) + torch.randint(0, 10, size=(100, 10)).float()
+    for y in y_true:
+        mean_var.update(y)
+
+    m = mean_var.compute()
+    np.testing.assert_almost_equal(np.asarray(m), y_true.mean(dim=0).numpy(), decimal=5)
+
+
+def test_integration():
+
+    size = 100
+    custom_variable = 10.0 + 5.0 * torch.rand(size, 12)
+
+    def update_fn(engine, batch):
+        return 0, custom_variable[engine.state.iteration - 1]
+
+    engine = Engine(update_fn)
+
+    custom_var_mean = Average(output_transform=lambda output: output[1])
+    custom_var_mean.attach(engine, 'agg_custom_var')
+
+    state = engine.run([0] * size)
+    np.testing.assert_almost_equal(np.asarray(state.metrics['agg_custom_var']), custom_variable.mean(dim=0).numpy(),
+                                   decimal=5)
+
+    custom_variable = 10.0 + 5.0 * torch.rand(size)
+
+    def update_scalar(engine, batch):
+        return 0, custom_variable[engine.state.iteration - 1].item()
+
+    engine = Engine(update_scalar)
+
+    custom_var_mean = Average(output_transform=lambda output: output[1])
+    custom_var_mean.attach(engine, 'agg_custom_var')
+
+    state = engine.run([0] * size)
+    assert np.asarray(state.metrics['agg_custom_var']) == pytest.approx(custom_variable.mean().item())
