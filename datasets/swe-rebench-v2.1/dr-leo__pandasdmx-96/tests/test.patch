+def _url_helper():
+    existing_apis = {
+        sdmx.Request, sdmx.add_source, sdmx.list_sources,
+        sdmx.open_file, sdmx.to_pandas,
+    }
+    url = 'http://example.com/path'
+    for name, helper in vars(sdmx).items():
+        if (name.startswith('_') or not callable(helper)
+                or helper in existing_apis):
+            continue
+        try:
+            result = helper(url, dry_run=True, params={'probe': 'value'})
+        except Exception:
+            continue
+        if getattr(result, 'url', None) == url + '?probe=value':
+            return helper
+    pytest.fail('no top-level URL convenience function is available')
+
+
+def test_url_helper_requires_url():
+    with pytest.raises(Exception):
+        _url_helper()()
+
+
+def test_url_helper_returns_request_result_and_forwards_options():
+    result = _url_helper()('http://example.com/path', params={'a': 'b'},
+                          dry_run=True, use_cache=True)
+    assert result.url == 'http://example.com/path?a=b'
+
+
+def test_request_url_classmethod_was_replaced():
+    assert not callable(getattr(sdmx.Request, 'url', None))
+
+
+def test_url_helper_forwards_use_cache():
+    from http.server import BaseHTTPRequestHandler, HTTPServer
+    from threading import Thread
+
+    with open('tests/data/exr_flow.xml', 'rb') as source:
+        body = source.read()
+
+    class Handler(BaseHTTPRequestHandler):
+        requests = 0
+
+        def do_GET(self):
+            type(self).requests += 1
+            self.send_response(200)
+            self.send_header('Content-Type', 'application/vnd.sdmx.structure+xml')
+            self.send_header('Content-Length', str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def log_message(self, *args):
+            pass
+
+    server = HTTPServer(('127.0.0.1', 0), Handler)
+    thread = Thread(target=server.serve_forever)
+    thread.daemon = True
+    thread.start()
+    url = 'http://127.0.0.1:{}/resource'.format(server.server_port)
+    try:
+        _url_helper()(url, use_cache=True)
+        _url_helper()(url, use_cache=True)
+        assert Handler.requests == 1
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join()
+
+
