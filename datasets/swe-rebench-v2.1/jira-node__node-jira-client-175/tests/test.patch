diff --git a/test/jira-tests.js b/test/jira-tests.js
index f65dc92..02989ec 100644
--- a/test/jira-tests.js
+++ b/test/jira-tests.js
@@ -676,5 +676,29 @@ describe('Jira API Tests', () => {
       const result = await dummyURLCall('listStatus');
       result.should.eql('http://jira.somehost.com:8080/rest/api/2.0/status');
     });
+
+    it('issueNotify hits proper url', async () => {
+      const result = await dummyURLCall('issueNotify', ['someIssueId', {}]);
+      result.should.eql('http://jira.somehost.com:8080/rest/api/2.0/issue/someIssueId/notify');
+    });
+
+    it('issueNotify sends a POST with the notification payload', async () => {
+      let sentRequest;
+      const notificationBody = { subject: 'Update', textBody: 'An issue update' };
+      const jira = new JiraApi(getOptions({
+        request: async requestOptions => {
+          sentRequest = requestOptions;
+          return requestOptions;
+        },
+      }));
+
+      await jira.issueNotify('someIssueId', notificationBody);
+
+      expect(sentRequest.uri).to.eql('http://jira.somehost.com:8080/rest/api/2.0/issue/someIssueId/notify');
+      expect(sentRequest.method).to.eql('POST');
+      const requestPayload = sentRequest.body === undefined ? sentRequest.json : sentRequest.body;
+      const parsedPayload = typeof requestPayload === 'string' ? JSON.parse(requestPayload) : requestPayload;
+      expect(parsedPayload).to.eql(notificationBody);
+    });
   });
 });
