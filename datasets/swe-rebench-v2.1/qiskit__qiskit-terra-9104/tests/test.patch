+# Compatibility shims so that this (older) Qiskit release can run against
+# NumPy 2.x.  ``np.product`` was removed in NumPy 2.0 and ``np.packbits`` now
+# returns a ``uint8`` array whose multiplication by 256 overflows; both are
+# used by the primitives exercised below.
+if not hasattr(np, "product"):
+    np.product = np.prod
+try:
+    np.array([1], dtype=np.uint8) * 256
+except OverflowError:
+    _np_packbits = np.packbits
+
+    def _packbits_compat(*args, **kwargs):
+        return _np_packbits(*args, **kwargs).astype(np.uint16)
+
+    np.packbits = _packbits_compat
+
