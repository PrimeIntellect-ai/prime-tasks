+    def test_gradient_method_formula(self):
+        """Test the central, forward, and backward finite difference formulas."""
+        sampler = Sampler()
+        a = Parameter("a")
+        qc = QuantumCircuit(1)
+        qc.h(0)
+        qc.p(a, 0)
+        qc.h(0)
+        qc.measure_all()
+        epsilon = 0.5
+        x = np.pi / 4
+
+        def probabilities(value):
+            return sampler.run([qc], [[value]]).result().quasi_dists[0]
+
+        p_plus = probabilities(x + epsilon)
+        p_zero = probabilities(x)
+        p_minus = probabilities(x - epsilon)
+        expected = {
+            "central": {
+                k: (p_plus.get(k, 0) - p_minus.get(k, 0)) / (2 * epsilon)
+                for k in set(p_plus) | set(p_minus)
