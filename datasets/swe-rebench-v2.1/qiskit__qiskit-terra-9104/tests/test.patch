+    def test_gradient_invalid_method(self):
+        """Test that an unsupported finite difference method raises TypeError."""
+        estimator = Estimator()
+        for method in ["central", "forward", "backward"]:
+            _ = FiniteDiffEstimatorGradient(estimator, epsilon=1e-6, method=method)
+        for method in ["invalid", "CENTRAL", "", None, 1]:
+            with self.subTest(method=method):
+                with self.assertRaises((TypeError, ValueError)):
+                    _ = FiniteDiffEstimatorGradient(estimator, epsilon=1e-6, method=method)
+
+    def test_method_is_keyword_only(self):
+        """The finite-difference scheme must be selected by keyword."""
+        with self.assertRaises(TypeError):
+            FiniteDiffEstimatorGradient(Estimator(), 1e-6, None, "forward")
+
+    def test_gradient_default_method(self):
+        """Test that the default finite difference method is central."""
+        estimator = Estimator()
+        a = Parameter("a")
+        qc = QuantumCircuit(1)
+        qc.h(0)
+        qc.p(a, 0)
+        qc.h(0)
+        op = SparsePauliOp.from_list([("Z", 1)])
+        param = [np.pi / 4]
+        default = FiniteDiffEstimatorGradient(estimator, epsilon=0.5)
+        central = FiniteDiffEstimatorGradient(estimator, epsilon=0.5, method="central")
+        forward = FiniteDiffEstimatorGradient(estimator, epsilon=0.5, method="forward")
+        default_val = default.run([qc], [op], [param]).result().gradients[0]
+        central_val = central.run([qc], [op], [param]).result().gradients[0]
+        forward_val = forward.run([qc], [op], [param]).result().gradients[0]
+        np.testing.assert_allclose(default_val, central_val)
+        self.assertFalse(np.allclose(default_val, forward_val))
+
+    def test_gradient_method_formula(self):
+        """Test the central, forward, and backward finite difference formulas."""
+        estimator = Estimator()
+        a = Parameter("a")
+        qc = QuantumCircuit(1)
+        qc.h(0)
+        qc.p(a, 0)
+        qc.h(0)
+        op = SparsePauliOp.from_list([("Z", 1)])
+        epsilon = 0.5
+        x = np.pi / 4
+        f_plus = estimator.run([qc], [op], [[x + epsilon]]).result().values[0]
+        f_zero = estimator.run([qc], [op], [[x]]).result().values[0]
+        f_minus = estimator.run([qc], [op], [[x - epsilon]]).result().values[0]
+        expected = {
+            "central": (f_plus - f_minus) / (2 * epsilon),
+            "forward": (f_plus - f_zero) / epsilon,
+            "backward": (f_zero - f_minus) / epsilon,
+        }
+        for method, expected_value in expected.items():
+            with self.subTest(method=method):
+                gradient = FiniteDiffEstimatorGradient(estimator, epsilon=epsilon, method=method)
+                value = gradient.run([qc], [op], [[x]]).result().gradients[0][0]
+                self.assertAlmostEqual(value, expected_value, places=6)
+
+    def test_one_sided_methods_use_fewer_circuit_evaluations(self):
+        """One-sided differences evaluate fewer parameter shifts for multiple parameters."""
+
+        class CountingEstimator(Estimator):
+            def __init__(self):
+                super().__init__()
+                self.evaluations = 0
+
+            def run(self, circuits, observables, parameter_values=None, **run_options):
+                self.evaluations += len(circuits) if not isinstance(circuits, QuantumCircuit) else 1
+                return super().run(circuits, observables, parameter_values, **run_options)
+
+        a, b = Parameter("a"), Parameter("b")
+        qc = QuantumCircuit(1)
+        qc.rx(a, 0)
+        qc.ry(b, 0)
+        observable = SparsePauliOp.from_list([("Z", 1)])
+
+        def circuit_evaluations(method):
+            estimator = CountingEstimator()
+            gradient = FiniteDiffEstimatorGradient(estimator, epsilon=0.1, method=method)
+            gradient.run([qc], [observable], [[0.2, 0.4]]).result()
+            return estimator.evaluations
+
+        central = circuit_evaluations("central")
+        self.assertLess(circuit_evaluations("forward"), central)
+        self.assertLess(circuit_evaluations("backward"), central)
+
