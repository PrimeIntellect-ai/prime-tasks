+    /**
+     * Expects the given file to be dumped and actually creates it so that
+     * implementations relying on PHP's native chmod() (which requires the
+     * file to exist) are accepted as well.
+     */
+    private function expectFileToBeDumped(string $outputPath, string $contents): void
+    {
+        $this->fileSystemProphecy
+            ->dumpFile($outputPath, $contents)
+            ->will(static function () use ($outputPath, $contents): void {
+                (new Filesystem())->dumpFile($outputPath, $contents);
+            })
+            ->shouldBeCalled();
+    }
