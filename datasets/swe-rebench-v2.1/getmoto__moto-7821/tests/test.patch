+++ b/tests/test_dynamodb/test_dynamodb_batch_write.py
@@ -0,0 +1,27 @@
+import boto3
+import pytest
+
+from . import dynamodb_aws_verified
+
+
+@pytest.mark.aws_verified
+@dynamodb_aws_verified()
+def test_transact_write_items_update_without_expression_attribute_names(table_name=None):
+    ddb_client = boto3.client("dynamodb", region_name="us-east-1")
+
+    ddb_client.transact_write_items(
+        TransactItems=[
+            {
+                "Update": {
+                    "TableName": table_name,
+                    "Key": {"pk": {"S": "test"}},
+                    "UpdateExpression": "SET xxx = :xxx",
+                    "ConditionExpression": "attribute_not_exists(xxx)",
+                    "ExpressionAttributeValues": {":xxx": {"S": "123"}},
+                }
+            }
+        ]
+    )
+
+    results = ddb_client.scan(TableName=table_name)["Items"]
+    assert results == [{"pk": {"S": "test"}, "xxx": {"S": "123"}}]
