+class MultilineChoiceFilterExportTest(TestCase):
+    def test_xlsform_export_preserves_multiline_filter_and_choice_labels(self):
+        """Exported choice filters retain line breaks and labels remain available."""
+        workbook = {
+            "survey": [
+                {
+                    "type": "select_multiple choices",
+                    "name": "selected",
+                    "label": "Selected",
+                },
+                {
+                    "type": "select_one choices",
+                    "name": "filtered",
+                    "label": "Filtered",
+                    "choice_filter": "selected(${selected}, 'a')\nand selected(${selected}, 'b')",
+                },
+            ],
+            "choices": [
+                {"list_name": "choices", "name": "a", "label": "Alpha"},
+                {"list_name": "choices", "name": "b", "label": "Beta"},
+            ],
+        }
+        result = convert(
+            xlsform=workbook,
+            pretty_print=True,
+            form_name="multiline_filter",
+            file_type=SupportedFileTypes.md.value,
+        )
+
+        itemset_attributes = re.findall(
+            r'<itemset nodeset="([^"]*)"', result.xform, flags=re.DOTALL
+        )
+        self.assertTrue(any("\n" in attribute for attribute in itemset_attributes))
+        xforms_ns = "{http://www.w3.org/2002/xforms}"
+        root = fromstring(result.xform)
+        itemsets = root.findall(f".//{xforms_ns}itemset")
+        self.assertTrue(
+            any(itemset.find(f"{xforms_ns}label") is not None for itemset in itemsets)
+        )
+        self.assertIn("Alpha", result.xform)
+        self.assertIn("Beta", result.xform)
