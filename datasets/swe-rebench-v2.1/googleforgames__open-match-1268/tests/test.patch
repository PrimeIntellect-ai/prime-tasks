+func simpleDoubleRange(name string, value, min, max float64, exclude int) TestCase {
+	filter := &pb.DoubleRangeFilter{
+		DoubleArg: "field",
+		Min:       min,
+		Max:       max,
+	}
+	excludeField := reflect.ValueOf(filter).Elem().FieldByName("Exclude")
+	if excludeField.IsValid() && excludeField.CanSet() {
+		excludeField.SetInt(int64(exclude))
+	}
+	return TestCase{
+		"double range " + name,
+		&pb.Ticket{
+			SearchFields: &pb.SearchFields{
+				DoubleArgs: map[string]float64{
+					"field": value,
+				},
+			},
+		},
+		&pb.Pool{
+			DoubleRangeFilters: []*pb.DoubleRangeFilter{filter},
+		},
+	}
