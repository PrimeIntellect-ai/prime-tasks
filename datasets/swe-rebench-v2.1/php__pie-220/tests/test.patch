+        file_put_contents(
+            $phpConfigWrapper,
+            '#!/bin/sh' . "\n" . 'if [ "$1" = "--php-binary" ]; then printf "%s\n" ' . escapeshellarg($phpWrapper)
+            . '; else ' . escapeshellarg($phpConfig) . ' "$@"; fi' . "\n",
