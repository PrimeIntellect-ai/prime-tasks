+
+    private function copyDirectory(string $source, string $destination): void
+    {
+        foreach (scandir($source) ?: [] as $entry) {
+            if ($entry === '.' || $entry === '..') {
+                continue;
+            }
+
+            $sourceEntry = $source . DIRECTORY_SEPARATOR . $entry;
+            $targetEntry = $destination . DIRECTORY_SEPARATOR . $entry;
+            if (is_dir($sourceEntry)) {
+                mkdir($targetEntry, 0777, true);
+                $this->copyDirectory($sourceEntry, $targetEntry);
+            } else {
+                copy($sourceEntry, $targetEntry);
+            }
+        }
+    }
+
+    private function removeDirectory(string $directory): void
+    {
+        if (! is_dir($directory)) {
+            return;
+        }
+
+        foreach (scandir($directory) ?: [] as $entry) {
+            if ($entry === '.' || $entry === '..') {
+                continue;
+            }
+
+            $path = $directory . DIRECTORY_SEPARATOR . $entry;
+            if (is_dir($path)) {
+                $this->removeDirectory($path);
+            } else {
+                unlink($path);
+            }
+        }
+
+        rmdir($directory);
+    }
+
