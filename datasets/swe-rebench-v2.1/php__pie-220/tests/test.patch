+                ],
+            ],
+        ], JSON_THROW_ON_ERROR | JSON_PRETTY_PRINT));
+
+        $previousDirectory = getcwd();
+        $previousPieHome   = getenv('PIE_WORKING_DIRECTORY');
+        $previousScanDir   = getenv('PHP_INI_SCAN_DIR');
+        $previousPath      = getenv('PATH');
+        $previousNetworkSetting = getenv('COMPOSER_DISABLE_NETWORK');
+        $phpBinary         = trim((new Process([$phpConfig, '--php-binary']))->mustRun()->getOutput());
