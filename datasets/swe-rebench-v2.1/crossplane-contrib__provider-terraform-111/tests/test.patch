+func TestEntrypointOptionalInSchema(t *testing.T) {
+	data, err := os.ReadFile(filepath.Join("..", "..", "..", "package", "crds", "tf.crossplane.io_workspaces.yaml"))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	crd := apiextensionsv1.CustomResourceDefinition{}
+	if err := yaml.Unmarshal(data, &crd); err != nil {
+		t.Fatal(err)
+	}
+	for _, version := range crd.Spec.Versions {
+		if version.Name != "v1alpha1" || version.Schema == nil || version.Schema.OpenAPIV3Schema == nil {
+			continue
+		}
+		workspaceSpec := version.Schema.OpenAPIV3Schema.Properties["spec"]
+		parameters := workspaceSpec.Properties["forProvider"]
+		for _, required := range parameters.Required {
+			if required == "entrypoint" {
+				t.Fatal("entrypoint must not be required in Workspace parameters")
+			}
+		}
+		return
+	}
+	t.Fatal("Workspace v1alpha1 schema was not found")
+}
