@@ -0,0 +1,59 @@
+package ach
+
+import "testing"
+
+func mockBatchTELHeader() *BatchHeader {
+	bh := NewBatchHeader()
+	bh.ServiceClassCode = 225
+	bh.StandardEntryClassCode = "TEL"
+	bh.CompanyName = "Your Company, inc"
+	bh.CompanyIdentification = "123456789"
+	bh.CompanyEntryDescription = "Vndr Pay"
+	bh.ODFIIdentification = 6200001
+	return bh
+}
+
+func mockTELEntryDetail() *EntryDetail {
+	entry := NewEntryDetail()
+	entry.TransactionCode = 27
+	entry.SetRDFI(9101298)
+	entry.DFIAccountNumber = "744-5678-99"
+	entry.Amount = 5000000
+	entry.IdentificationNumber = "Phone 333-2222"
+	entry.IndividualName = "Wade Arnold"
+	entry.TraceNumber = 62000010000123
+	entry.SetPaymentType("S")
+	return entry
+}
+
+func mockBatchTEL(t *testing.T) Batcher {
+	t.Helper()
+	batch, err := NewBatch(BatchParam{StandardEntryClass: "TEL"})
+	if err != nil {
+		t.Fatalf("could not create TEL batch: %v", err)
+	}
+	batch.SetHeader(mockBatchTELHeader())
+	batch.AddEntry(mockTELEntryDetail())
+	if err := batch.Create(); err != nil {
+		t.Fatalf("could not build valid TEL batch: %v", err)
+	}
+	return batch
+}
+
+// An entry based on oral authorization must be in a TEL batch.
+func TestBatchTELSEC(t *testing.T) {
+	batch := mockBatchTEL(t)
+	batch.GetHeader().StandardEntryClassCode = "RCK"
+	if err := batch.Validate(); err == nil {
+		t.Error("TEL validation accepted a batch with a non-TEL SEC code")
+	}
+}
+
+// TEL entries must be debits, so a credit entry cannot be accepted.
+func TestBatchTELDebit(t *testing.T) {
+	batch := mockBatchTEL(t)
+	batch.GetEntries()[0].TransactionCode = 22
+	if err := batch.Validate(); err == nil {
+		t.Error("TEL validation accepted a credit transaction")
+	}
+}
