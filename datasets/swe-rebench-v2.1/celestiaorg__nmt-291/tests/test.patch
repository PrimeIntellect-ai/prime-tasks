+func TestComputeRootWithBasicValidation_NonNamespaceRange(t *testing.T) {
+	tree := exampleNMT(1, true, 1, 2, 3, 3, 3, 4, 5, 6, 7, 8)
+	hasher := tree.treeHasher.(*NmtHasher)
+
+	// A range proof spanning multiple namespaces: leaves at indices [0,4)
+	// have namespace IDs 1, 2, 3, 3.
+	proof, err := tree.ProveRange(0, 4)
+	require.NoError(t, err)
+
+	leafHashes := make([][]byte, 4)
+	copy(leafHashes, tree.leafHashes[0:4])
+
+	root, err := tree.Root()
+	require.NoError(t, err)
+
+	// With isNamespace=false, no namespace consistency check is performed, so a
+	// range proof whose leaf hashes span multiple namespaces must still compute
+	// the correct root.
+	gotRoot, err := proof.ComputeRootWithBasicValidation(hasher, namespace.ID{1}, leafHashes, false)
+	require.NoError(t, err)
+	assert.Equal(t, root, gotRoot)
+}
+
+func TestComputeRootWithBasicValidation_RejectsIncompleteNamespaceWithMatchingCount(t *testing.T) {
+	tree := exampleNMT(1, true, 1, 2, 3, 3, 3, 4, 5, 6, 7, 8)
+	hasher := tree.treeHasher.(*NmtHasher)
+	nid := namespace.ID{3}
+
+	// This range contains two matching leaves, while a third leaf in the
+	// namespace remains outside the range.
+	proof, err := tree.ProveRange(2, 4)
+	require.NoError(t, err)
+	leafHashes := make([][]byte, 2)
+	copy(leafHashes, tree.leafHashes[2:4])
+	require.Equal(t, proof.End()-proof.Start(), len(leafHashes))
+
+	_, err = proof.ComputeRootWithBasicValidation(hasher, nid, leafHashes, true)
+	require.Error(t, err)
+}
