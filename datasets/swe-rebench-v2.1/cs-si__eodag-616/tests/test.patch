+                items_per_page=2,
+                auth=self.onda_auth_plugin,
+                **self.search_criteria_s2_msi_l1c
+            )
+            self.assertEqual(len(products), 2)
+            self.assertEqual(
+                all(
+                    product.properties["expandedProbe"] == "expanded-value"
+                    for product in products
+                ),
+                True,
+            )
+            mock_requests_get.assert_not_called()
+
+        # when the option is enabled, one metadata query per product is sent
+        with mock.patch.object(
+            self.onda_search_plugin.config,
+            "per_product_metadata_query",
+            True,
+            create=True,
+        ):
+            mock_requests_get.reset_mock()
+            mock__request.return_value.json.side_effect = [
+                self.onda_resp_count,
+                onda_resp_search,
+            ]
+            products, _ = self.onda_search_plugin.query(
