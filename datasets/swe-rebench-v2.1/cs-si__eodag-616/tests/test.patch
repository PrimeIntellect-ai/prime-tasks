+    def test_plugins_search_odatav4search_per_product_metadata_query(
+        self, mock__request, mock_requests_get
+    ):
+        """per_product_metadata_query must control whether per-product metadata queries are sent"""  # noqa
+        with open(self.provider_resp_dir / "onda_search.json") as f:
+            onda_resp_search = json.load(f)
+        mock__request.return_value = mock.Mock()
+        mock_requests_get.return_value = mock.Mock()
+        per_product_start_times = [
+            "2021-01-02T03:04:05Z",
+            "2021-02-03T04:05:06Z",
+        ]
+        mock_requests_get.return_value.json.side_effect = [
+            dict(value=[dict(id="beginPosition", value=start_time)])
+            for start_time in per_product_start_times
+        ]
+
+        # Expanded metadata remains available even when separate requests are skipped.
+        expanded_response = json.loads(json.dumps(onda_resp_search))
+        for entity in expanded_response["value"]:
+            entity["Metadata"] = [
+                {"id": "expandedProbe", "value": "expanded-value"}
+            ]
+
+        # when the option is disabled, no per-product metadata query is sent
+        with mock.patch.object(
+            self.onda_search_plugin.config,
+            "per_product_metadata_query",
+            False,
+            create=True,
+        ):
+            mock_requests_get.reset_mock()
+            mock__request.return_value.json.side_effect = [
+                self.onda_resp_count,
+                expanded_response,
+            ]
+            products, _ = self.onda_search_plugin.query(
