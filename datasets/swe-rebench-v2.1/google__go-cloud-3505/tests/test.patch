+func TestS3ForcePathStyleUsesBucketInRequestPath(t *testing.T) {
+	t.Setenv("AWS_ACCESS_KEY_ID", "test-access-key")
+	t.Setenv("AWS_SECRET_ACCESS_KEY", "test-secret-key")
+	t.Setenv("AWS_EC2_METADATA_DISABLED", "true")
+
+	requestPaths := make(chan string, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requestPaths <- r.URL.Path
+		w.Header().Set("ETag", `"etag"`)
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	endpoint, err := url.Parse(server.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	endpoint.Host = "localhost:" + endpoint.Port()
+	bucketURL := fmt.Sprintf("s3://mybucket?endpoint=%s&region=us-east-1&s3ForcePathStyle=true", url.QueryEscape(endpoint.String()))
+	bucket, err := blob.OpenBucket(context.Background(), bucketURL)
+	if err != nil {
+		t.Fatalf("opening bucket: %v", err)
+	}
+	defer bucket.Close()
+
+	if err := bucket.WriteAll(context.Background(), "object", []byte("data"), nil); err != nil {
+		t.Fatalf("writing object: %v", err)
+	}
+	requestPath := <-requestPaths
+	if requestPath != "/mybucket/object" {
+		t.Errorf("request path = %q, want bucket-qualified path %q", requestPath, "/mybucket/object")
+	}
+}
