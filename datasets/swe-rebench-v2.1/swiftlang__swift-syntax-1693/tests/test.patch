diff --git a/Tests/SwiftSyntaxBuilderTest/ArrayExprTests.swift b/Tests/SwiftSyntaxBuilderTest/ArrayExprTests.swift
index 1b5e2759..9c7de914 100644
--- a/Tests/SwiftSyntaxBuilderTest/ArrayExprTests.swift
+++ b/Tests/SwiftSyntaxBuilderTest/ArrayExprTests.swift
@@ -11,6 +11,7 @@
 //===----------------------------------------------------------------------===//
 
 import XCTest
+import SwiftParser
 import SwiftSyntax
 import SwiftSyntaxBuilder
 
@@ -47,4 +48,29 @@ final class ArrayExprTests: XCTestCase {
       """
     )
   }
+
+  func testInitializerWithExpressions() {
+    let expressions: [ExprSyntax] = ["0", "1", "2"]
+    let arrayExpr = ArrayExprSyntax(expressions: expressions)
+    XCTAssertEqual(arrayExpr.elements.map { $0.expression.trimmedDescription }, ["0", "1", "2"])
+    XCTAssertEqual(arrayExpr.elements.count, 3)
+    XCTAssertFalse(Parser.parse(source: arrayExpr.trimmedDescription).hasError)
+  }
+
+  func testInitializerWithNoExpressions() {
+    let arrayExpr = ArrayExprSyntax(expressions: [])
+    XCTAssertEqual(arrayExpr.elements.count, 0)
+    XCTAssertEqual(arrayExpr.trimmedDescription, "[]")
+  }
+
+  func testInitializerWithTrailingWhitespaceKeepsLiteralValid() {
+    let expressions: [ExprSyntax] = ["0 ", "1\n", "2"]
+    let arrayExpr = ArrayExprSyntax(expressions: expressions)
+    XCTAssertEqual(arrayExpr.elements.map { $0.expression.trimmedDescription }, ["0", "1", "2"])
+
+    let reparsed = Parser.parse(source: arrayExpr.trimmedDescription)
+    XCTAssertFalse(reparsed.hasError)
+    let reparsedArray = reparsed.statements.first?.item.as(ExprSyntax.self)?.as(ArrayExprSyntax.self)
+    XCTAssertEqual(reparsedArray?.elements.count, 3)
+  }
 }
