diff --git a/tests/09-collapse-adjacent-rules.test.js b/tests/09-collapse-adjacent-rules.test.js
new file mode 100644
index 0000000..8dc8e4e
--- /dev/null
+++ b/tests/09-collapse-adjacent-rules.test.js
@@ -0,0 +1,183 @@
+const postcss = require('postcss')
+const tailwind = require('../src/index.js')
+const path = require('path')
+const { execFileSync } = require('child_process')
+const os = require('os')
+
+function run(input, config = {}) {
+  return postcss([tailwind(config)]).process(input, { from: path.resolve(__filename) })
+}
+
+test('collapse adjacent rules', () => {
+  let config = {
+    purge: [path.resolve(__dirname, './09-collapse-adjacent-rules.test.html')],
+    corePlugins: { preflight: false },
+    theme: {},
+    plugins: [],
+  }
+
+  let css = `
+    @tailwind base;
+    @font-face {
+      font-family: "Inter";
+      src: url("/fonts/Inter.woff2") format("woff2"),
+            url("/fonts/Inter.woff") format("woff");
+    }
+    @font-face {
+      font-family: "Gilroy";
+      src: url("/fonts/Gilroy.woff2") format("woff2"),
+            url("/fonts/Gilroy.woff") format("woff");
+    }
+    @tailwind components;
+    @tailwind utilities;
+    @layer base {
+      @font-face {
+        font-family: "Poppins";
+        src: url("/fonts/Poppins.woff2") format("woff2"),
+              url("/fonts/Poppins.woff") format("woff");
+      }
+      @font-face {
+        font-family: "Proxima Nova";
+        src: url("/fonts/ProximaNova.woff2") format("woff2"),
+              url("/fonts/ProximaNova.woff") format("woff");
+      }
+    }
+  `
+
+  return run(css, config).then((result) => {
+    let faces = []
+    result.root.walkAtRules('font-face', (node) => faces.push(node))
+
+    let fontFaces = faces.map((face) => {
+      let family = face.nodes.find((node) => node.prop === 'font-family').value.replace(/^['"]|['"]$/g, '')
+      let src = face.nodes.find((node) => node.prop === 'src').value
+      let sources = Array.from(src.matchAll(/url\(([^)]+)\)/g), (match) => match[1].replace(/^['"]|['"]$/g, ''))
+      return { family, sources }
+    })
+
+    expect(fontFaces).toHaveLength(4)
+    expect(fontFaces).toEqual(
+      expect.arrayContaining([
+        { family: 'Gilroy', sources: ['/fonts/Gilroy.woff2', '/fonts/Gilroy.woff'] },
+        { family: 'Inter', sources: ['/fonts/Inter.woff2', '/fonts/Inter.woff'] },
+        { family: 'Poppins', sources: ['/fonts/Poppins.woff2', '/fonts/Poppins.woff'] },
+        { family: 'Proxima Nova', sources: ['/fonts/ProximaNova.woff2', '/fonts/ProximaNova.woff'] },
+      ])
+    )
+  })
+})
+
+test('does not collapse adjacent @font-face rules for the same family', () => {
+  let config = {
+    corePlugins: { preflight: false },
+    theme: {},
+    plugins: [],
+  }
+
+  let css = `
+    @tailwind base;
+    @layer base {
+      @font-face {
+        font-family: "test";
+        src: url("/fonts/test.woff2") format("woff2");
+        font-weight: 400;
+        font-style: normal;
+        font-display: swap;
+      }
+      @font-face {
+        font-family: "test";
+        src: url("/fonts/test-italic.woff2") format("woff2");
+        font-weight: 400;
+        font-style: italic;
+        font-display: swap;
+      }
+    }
+    @tailwind components;
+    @tailwind utilities;
+  `
+
+  return run(css, config).then((result) => {
+    let faces = []
+    result.root.walkAtRules('font-face', (node) => faces.push(node))
+
+    // The two faces must remain separate declarations, not be merged into one.
+    expect(faces).toHaveLength(2)
+
+    let declarations = faces
+      .map((face) => {
+        let style = face.nodes.find((node) => node.prop === 'font-style').value
+        let src = face.nodes.find((node) => node.prop === 'src').value
+        let sources = Array.from(src.matchAll(/url\(([^)]+)\)/g), (match) => match[1].replace(/^['"]|['"]$/g, ''))
+        return { style, sources }
+      })
+      .sort((a, b) => a.style.localeCompare(b.style))
+
+    expect(declarations).toEqual([
+      { style: 'italic', sources: ['/fonts/test-italic.woff2'] },
+      { style: 'normal', sources: ['/fonts/test.woff2'] },
+    ])
+  })
+})
+
+
+test('preserves adjacent @font-face rules in development mode', () => {
+  let css = `
+    @tailwind base;
+    @layer base {
+      @font-face {
+        font-family: "test";
+        src: url("/fonts/test.woff2") format("woff2");
+        font-weight: 400;
+        font-style: normal;
+      }
+      @font-face {
+        font-family: "test";
+        src: url("/fonts/test-italic.woff2") format("woff2");
+        font-weight: 400;
+        font-style: italic;
+      }
+    }
+    @tailwind components;
+    @tailwind utilities;
+  `
+  let script = `
+    const postcss = require(${JSON.stringify(require.resolve('postcss'))})
+    const tailwind = require(${JSON.stringify(require.resolve('../src/index.js'))})
+    postcss([tailwind({ corePlugins: { preflight: false }, theme: {}, plugins: [] })])
+      .process(${JSON.stringify(css)}, { from: ${JSON.stringify(path.resolve(__filename))} })
+      .then(
+        (result) => process.stdout.write(result.root.toString(), () => process.exit(0)),
+        (error) => {
+          console.error(error)
+          process.exit(1)
+        }
+      )
+  `
+  let env = {
+    ...process.env,
+    HOME: path.join(os.tmpdir(), `tailwind-jit-dev-${process.pid}`),
+    NODE_ENV: 'development',
+  }
+  delete env.TAILWIND_MODE
+  let output = execFileSync(process.execPath, ['-e', script], {
+    encoding: 'utf8',
+    env,
+    timeout: 10000,
+  })
+  let faces = []
+  postcss.parse(output).walkAtRules('font-face', (node) => faces.push(node))
+
+  expect(faces).toHaveLength(2)
+  expect(
+    faces
+      .map((face) => {
+        let src = face.nodes.find((node) => node.prop === 'src').value
+        let sources = Array.from(src.matchAll(/url\(([^)]+)\)/g), (match) => match[1].replace(/^['"]|['"]$/g, ''))
+        return { style: face.nodes.find((node) => node.prop === 'font-style').value, sources }
+      })
+      .sort((a, b) => a.style.localeCompare(b.style))
+  ).toEqual([
+    { style: 'italic', sources: ['/fonts/test-italic.woff2'] },
+    { style: 'normal', sources: ['/fonts/test.woff2'] },
+  ])
+})
