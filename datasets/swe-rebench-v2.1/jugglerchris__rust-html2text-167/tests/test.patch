+/// A reader which always fails, used to check that read errors are
+/// propagated as `Err` rather than causing a panic.
+struct FailingReader;
+
+// Keep these public-API regression checks runnable against both the old
+// panicking signatures and the error-returning signatures.
+trait UnwrapApiOutput {
+    fn unwrap(self) -> String;
+}
+
+impl UnwrapApiOutput for String {
+    fn unwrap(self) -> String {
+        self
+    }
+}
+
+trait ApiResultStatus {
+    fn is_api_error(&self) -> bool;
+}
+
+impl ApiResultStatus for String {
+    fn is_api_error(&self) -> bool {
+        false
+    }
+}
+
+impl ApiResultStatus for Vec<TaggedLine<Vec<RichAnnotation>>> {
+    fn is_api_error(&self) -> bool {
+        false
+    }
+}
+
+impl<T, E> ApiResultStatus for Result<T, E> {
+    fn is_api_error(&self) -> bool {
+        self.is_err()
+    }
+}
+
+impl std::io::Read for FailingReader {
+    fn read(&mut self, _buf: &mut [u8]) -> std::io::Result<usize> {
+        Err(std::io::Error::new(
+            std::io::ErrorKind::Other,
+            "simulated read failure",
+        ))
+    }
+}
+
+#[test]
+fn test_from_read_propagates_read_error() {
+    let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        from_read(FailingReader, 80)
+    }));
+    assert!(outcome.is_ok());
+    assert!(outcome.unwrap().is_api_error());
+}
+
+#[test]
+fn test_from_read_with_decorator_propagates_read_error() {
+    let decorator = crate::render::text_renderer::PlainDecorator::new();
+    let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        from_read_with_decorator(FailingReader, 80, decorator)
+    }));
+    assert!(outcome.is_ok());
+    assert!(outcome.unwrap().is_api_error());
+}
+
+#[test]
+fn test_from_read_rich_propagates_read_error() {
+    let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        from_read_rich(FailingReader, 80)
+    }));
+    assert!(outcome.is_ok());
+    assert!(outcome.unwrap().is_api_error());
+}
+
