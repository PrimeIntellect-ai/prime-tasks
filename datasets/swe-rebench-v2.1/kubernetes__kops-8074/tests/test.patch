+type persistentFailureClusterValidator struct {
+	invocationCount int
+}
+
+func (v *persistentFailureClusterValidator) Validate() (*validation.ValidationCluster, error) {
+	v.invocationCount++
+	return &validation.ValidationCluster{
+		Failures: []*validation.ValidationError{
+			{
+				Kind:    "testing",
+				Name:    "testingfailure",
+				Message: "testing failure",
+			},
+		},
+	}, nil
+}
+
+func TestRollingUpdateStopsWhenBastionValidationTimesOut(t *testing.T) {
+	c, cloud, cluster := getTestSetup()
+	c.ValidationTimeout = 10 * time.Millisecond
+	validator := &persistentFailureClusterValidator{}
+	c.ClusterValidator = validator
+
+	groups := getGroups()
+	markNeedUpdate(groups["bastion-1"], "bastion-1a")
+	started := time.Now()
+	err := c.RollingUpdate(groups, cluster, &kopsapi.InstanceGroupList{})
+
+	assert.Error(t, err, "rolling update must stop when bastion validation does not recover")
+	assert.True(t, time.Since(started) >= c.ValidationTimeout, "validation must continue until its timeout expires")
+	assert.GreaterOrEqual(t, validator.invocationCount, 1, "cluster validation must run after bastion termination")
+	assertGroupInstanceCount(t, cloud, "bastion-1", 0)
+	assertGroupInstanceCount(t, cloud, "node-1", 2)
+	assertGroupInstanceCount(t, cloud, "node-2", 2)
+	assertGroupInstanceCount(t, cloud, "master-1", 2)
+}
+
