diff --git a/test/CSSStyleDeclaration.js b/test/CSSStyleDeclaration.js
index 62f35d0..f530c4c 100644
--- a/test/CSSStyleDeclaration.js
+++ b/test/CSSStyleDeclaration.js
@@ -748,4 +748,63 @@ describe('CSSStyleDeclaration', () => {
       assert.strictEqual(style.getPropertyValue(property), 'calc(100% - 100px)');
     });
   }
+
+  it('supports var values on regular properties', () => {
+    for (const [property, value, references] of [
+      ['width', 'var(--measure)', ['--measure']],
+      ['opacity', 'var(--opacity)', ['--opacity']]
+    ]) {
+      const style = new CSSStyleDeclaration();
+      style.setProperty(property, value);
+
+      const storedValue = style.getPropertyValue(property);
+      assert.notStrictEqual(storedValue, '');
+      assert.match(storedValue, /var\s*\(/i);
+      for (const reference of references) {
+        assert.ok(storedValue.includes(reference));
+      }
+    }
+  });
+
+  it('supports var fallbacks and nested var values', () => {
+    for (const [value, references] of [
+      ['var(--foo, 100px)', ['--foo']],
+      ['var(--foo, var(--bar))', ['--foo', '--bar']],
+      ['var(--foo, calc(var(--bar) + 3px))', ['--foo', '--bar']]
+    ]) {
+      const style = new CSSStyleDeclaration();
+      style.setProperty('width', value);
+
+      const storedValue = style.getPropertyValue('width');
+      assert.match(storedValue, /var\s*\(/i);
+      for (const reference of references) {
+        assert.ok(storedValue.includes(reference));
+      }
+      if (value.includes('100px')) {
+        assert.match(storedValue, /100px/i);
+      }
+      if (value.toLowerCase().includes('calc(')) {
+        assert.match(storedValue, /calc\s*\(/i);
+      }
+    }
+  });
+
+  it('supports var inside calc values', () => {
+    const style = new CSSStyleDeclaration();
+    style.setProperty('width', 'calc(100% - var(--foo))');
+
+    const storedValue = style.getPropertyValue('width');
+    assert.match(storedValue, /calc\s*\(/i);
+    assert.match(storedValue, /var\s*\(/i);
+    assert.ok(storedValue.includes('--foo'));
+  });
+
+  it('supports var values for color', () => {
+    const style = new CSSStyleDeclaration();
+    style.setProperty('color', 'var(--foo)');
+
+    const storedValue = style.getPropertyValue('color');
+    assert.match(storedValue, /var\s*\(/i);
+    assert.ok(storedValue.includes('--foo'));
+  });
 });
