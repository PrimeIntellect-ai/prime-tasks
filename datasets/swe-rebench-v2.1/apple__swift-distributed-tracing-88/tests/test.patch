+
+final class SpanOperationNameTests: XCTestCase {
+    func test_spanOperationNameCanBeReadAndUpdated() {
+        let tracer = TestTracer()
+        let span: Span = tracer.startSpan("initial-name", baggage: .topLevel)
+
+        XCTAssertEqual(span.operationName, "initial-name")
+
+        span.operationName = "renamed-name"
+        XCTAssertEqual(span.operationName, "renamed-name")
+    }
+
+    func test_noOpTracerSpanExposesOperationName() {
+        let tracer = NoOpTracer()
+        let span: Span = tracer.startSpan("noop-operation", baggage: .topLevel)
+
+        XCTAssertEqual(span.operationName, "noop-operation")
+    }
+
+    func test_noOpSpanStoresOperationName() {
+        let span = NoOpTracer.NoOpSpan(operationName: "direct-operation", baggage: .topLevel)
+
+        XCTAssertEqual(span.operationName, "direct-operation")
+    }
+}
