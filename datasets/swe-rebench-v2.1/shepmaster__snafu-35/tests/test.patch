+extern crate snafu;
+
+use snafu::{Backtrace, ErrorCompat, ResultExt, Snafu};
+
+type BoxError = Box<std::error::Error>;
+
+#[derive(Debug, Snafu)]
+enum Error<'a, 'x, A, Y> {
+    Everything {
+        source: BoxError,
+        name: &'a str,
+        length: A,
+        backtrace: Backtrace,
+    },
+    Lifetime {
+        key: &'x i32,
+    },
+    Type {
+        value: Y,
+    },
+}
+
+fn cause_error() -> Result<(), BoxError> {
+    Ok(())
+}
+
+fn example<'s, 'k, V>(
+    name: &'s str,
+    key: &'k i32,
+    value: V,
+) -> Result<(), Error<'s, 'k, usize, V>> {
+    let length = name.len();
+
+    cause_error().context(Everything { name, length })?;
+
+    if name == "alice" {
+        return Lifetime { key }.fail();
+    }
+
+    if name == "bob" {
+        return Type { value }.fail();
+    }
+
+    Ok(())
+}
+
+#[test]
+fn implements_error() {
+    let name = String::from("hello");
+    let key = Box::new(42);
+    let value = vec![false];
+
+    example(&name, &key, value).unwrap();
+}
+
+#[test]
+fn lifetime_variant_is_returned() {
+    let name = String::from("alice");
+    let key = Box::new(42);
+    let value = vec![false];
+
+    match example(&name, &key, value) {
+        Err(Error::Lifetime { key }) => assert_eq!(*key, 42),
+        other => panic!("expected a Lifetime error, got {:?}", other),
+    }
+}
+
+#[test]
+fn type_variant_is_returned() {
+    let name = String::from("bob");
+    let key = Box::new(42);
+    let value = vec![false];
+
+    match example(&name, &key, value) {
+        Err(Error::Type { value }) => assert_eq!(value, vec![false]),
+        other => panic!("expected a Type error, got {:?}", other),
+    }
+}
+
+#[test]
+fn context_attaches_source_and_fields() {
+    let name = "hello";
+    let length = name.len();
+
+    let result: Result<(), Error<'_, '_, usize, Vec<bool>>> =
+        Err::<(), BoxError>(Box::new(std::io::Error::new(std::io::ErrorKind::Other, "boom")))
+            .context(Everything { name, length })
+            .map_err(Into::into);
+
+    match &result {
+        Err(error @ Error::Everything { source, name: n, length: l, .. }) => {
+            assert_eq!(*n, "hello");
+            assert_eq!(*l, 5);
+            assert_eq!(source.to_string(), "boom");
+            assert!(ErrorCompat::backtrace(error).is_some());
+        }
+        other => panic!("expected an Everything error, got {:?}", other),
+    }
+}
