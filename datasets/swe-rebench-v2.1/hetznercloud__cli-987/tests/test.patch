+func TestAddRuleDestinationIPs(t *testing.T) {
+	fx := testutil.NewFixture(t)
+	defer fx.Finish()
+
+	cmd := firewall.AddRuleCmd.CobraCommand(fx.State())
+	fx.ExpectEnsureToken()
+
+	fw := &hcloud.Firewall{
+		ID:   123,
+		Name: "test",
+	}
+
+	fx.Client.FirewallClient.EXPECT().
+		Get(gomock.Any(), "test").
+		Return(fw, nil, nil)
+	fx.Client.FirewallClient.EXPECT().
+		SetRules(gomock.Any(), fw, firewallRuleOptionsMatcher(t, hcloud.FirewallSetRulesOpts{
+			Rules: []hcloud.FirewallRule{{
+				Direction:      hcloud.FirewallRuleDirectionOut,
+				SourceIPs:      []net.IPNet{},
+				DestinationIPs: []net.IPNet{{IP: net.IP{0, 0, 0, 0}, Mask: net.IPMask{0, 0, 0, 0}}, {IP: net.IP{127, 0, 0, 1}, Mask: net.IPMask{255, 255, 255, 255}}},
+				Protocol:       hcloud.FirewallRuleProtocolTCP,
+				Port:           hcloud.Ptr("80"),
+				Description:    hcloud.Ptr("http"),
+			}},
+		})).
+		Return([]*hcloud.Action{{ID: 123}, {ID: 321}}, nil, nil)
+	fx.ActionWaiter.EXPECT().
+		WaitForActions(gomock.Any(), gomock.Any(), []*hcloud.Action{{ID: 123}, {ID: 321}}).
+		Return(nil)
+
+	out, errOut, err := fx.Run(cmd, []string{"--direction", "out", "--protocol", "tcp", "--destination-ips", "0.0.0.0/0,127.0.0.1/32", "--port", "80", "--description", "http", "test"})
+
+	expOut := "Firewall Rules for Firewall 123 updated\n"
+
+	require.NoError(t, err)
+	assert.Empty(t, errOut)
+	assert.Equal(t, expOut, out)
+}
+
+func firewallRuleOptionsMatcher(t *testing.T, expected hcloud.FirewallSetRulesOpts) gomock.Matcher {
+	t.Helper()
+	return gomock.Cond(func(actual hcloud.FirewallSetRulesOpts) bool {
+		if len(actual.Rules) != len(expected.Rules) {
+			return false
+		}
+		for i, expectedRule := range expected.Rules {
+			actualRule := actual.Rules[i]
+			if !assert.ElementsMatch(t, expectedRule.SourceIPs, actualRule.SourceIPs) || !assert.ElementsMatch(t, expectedRule.DestinationIPs, actualRule.DestinationIPs) {
+				return false
+			}
+			actualRule.SourceIPs = expectedRule.SourceIPs
+			actualRule.DestinationIPs = expectedRule.DestinationIPs
+			if !assert.Equal(t, expectedRule, actualRule) {
+				return false
+			}
+		}
+		return true
+	})
+}
