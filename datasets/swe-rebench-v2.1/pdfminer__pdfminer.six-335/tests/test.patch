+    def test_pdf_sample_anyone_ordering(self):
+        data = gzip.decompress(base64.b64decode(_PDF_SAMPLE_GZ_B64))
+        fd, path = tempfile.mkstemp(suffix=".pdf")
+        try:
+            with os.fdopen(fd, "wb") as f:
+                f.write(data)
+            text = extract_text(path)
+        finally:
+            os.remove(path)
+        # "anyone" ends the fourth bullet point (after "distributed by"),
+        # not the third bullet point (which ends with "incompatibilities").
+        self.assertLess(text.index("incompatibilities"), text.index("distributed"))
+        self.assertGreater(text.index("anyone."), text.index("distributed"))
+        self.assertLess(text.index("anyone."), text.index("Compact"))
