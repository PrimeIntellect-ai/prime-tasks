+    /**
+     * @test
+     * @requires PHP 8.2
+     */
+    public function shouldUseDNFTypehintWhenCatchingRejections()
+    {
+        $firstAlternative = new CountableException();
+        $secondAlternative = new ArrayAccessibleException();
+        $firstHandled = false;
+        $secondHandled = false;
+        $handler = function ((\RuntimeException&\Countable)|(\RuntimeException&\ArrayAccess) $reason) use (&$firstHandled, &$secondHandled, $firstAlternative, $secondAlternative) {
+            if ($reason === $firstAlternative) {
+                $firstHandled = true;
+            }
+            if ($reason === $secondAlternative) {
+                $secondHandled = true;
+            }
+        };
+
+        $deferred = new Deferred();
+        $deferred->promise()->catch($handler);
+        $deferred->reject($firstAlternative);
+        reject($secondAlternative)->catch($handler);
+        $nonmatchingReason = new \RuntimeException();
+        $propagatedReason = null;
+        reject($nonmatchingReason)->catch($handler)->catch(function ($reason) use (&$propagatedReason) {
+            $propagatedReason = $reason;
+        });
+
+        self::assertTrue($firstHandled);
+        self::assertTrue($secondHandled);
+        self::assertSame($nonmatchingReason, $propagatedReason);
+    }
+
+    /**
