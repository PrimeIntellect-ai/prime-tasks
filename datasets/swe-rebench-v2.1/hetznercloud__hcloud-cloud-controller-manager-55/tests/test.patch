+func TestReconcileHCLBServicesHealthCheckIntervalDuration(t *testing.T) {
+	for _, update := range []bool{false, true} {
+		name := "add service"
+		if update {
+			name = "update service"
+		}
+		t.Run(name, func(t *testing.T) {
+			fx := NewLoadBalancerOpsFixture(t)
+			lb := &hcloud.LoadBalancer{ID: 1}
+			if update {
+				lb.Services = []hcloud.LoadBalancerService{{ListenPort: 83}}
+			}
+			svc := &v1.Service{Spec: v1.ServiceSpec{Ports: []v1.ServicePort{{Port: 83, NodePort: 8083}}}}
+			for annotationName, value := range map[annotation.Name]interface{}{
+				annotation.LBSvcHealthCheckProtocol: string(hcloud.LoadBalancerServiceProtocolTCP),
+				annotation.LBSvcHealthCheckInterval: "15s",
+			} {
+				assert.NoError(t, annotationName.AnnotateService(svc, value))
+			}
+
+			action := &hcloud.Action{ID: 1}
+			var appliedInterval *time.Duration
+			if update {
+				fx.LBClient.On("UpdateService", fx.Ctx, lb, 83, mock.Anything).
+					Return(action, nil, nil).
+					Run(func(args mock.Arguments) {
+						opts := args.Get(3).(hcloud.LoadBalancerUpdateServiceOpts)
+						if opts.HealthCheck != nil {
+							appliedInterval = opts.HealthCheck.Interval
+						}
+					})
+			} else {
+				fx.LBClient.On("AddService", fx.Ctx, lb, mock.Anything).
+					Return(action, nil, nil).
+					Run(func(args mock.Arguments) {
+						opts := args.Get(2).(hcloud.LoadBalancerAddServiceOpts)
+						if opts.HealthCheck != nil {
+							appliedInterval = opts.HealthCheck.Interval
+						}
+					})
+			}
+			fx.MockWatchProgress(action, nil)
+
+			_, err := fx.LBOps.ReconcileHCLBServices(fx.Ctx, lb, svc)
+			assert.NoError(t, err)
+			if assert.NotNil(t, appliedInterval) {
+				assert.Equal(t, 15*time.Second, *appliedInterval)
+			}
+			fx.AssertExpectations()
+		})
+	}
+}
