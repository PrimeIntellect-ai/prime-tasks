+    def test_init_empty_without_roi_masks(self):
+        """An empty segmentation can be constructed without ROI mask columns."""
+        _, ip = self.set_up_dependencies()
+        pS = PlaneSegmentation(
+            description='description',
+            imaging_plane=ip,
+            name='empty_segmentation',
+        )
+        self.assertEqual(len(pS), 0)
+
+    def test_init_mask_column_with_row_data(self):
+        """A declared ROI-mask column that holds data for each row is accepted."""
+        iSS, ip = self.set_up_dependencies()
+        pS = PlaneSegmentation(
+            description='description',
+            imaging_plane=ip,
+            name='test_name',
+            reference_images=iSS,
+            id=[0, 1],
+            columns=[
+                VectorData(name='custom_col', description='custom data', data=[1, 2]),
+                VectorData(name='image_mask', description='image mask',
+                           data=[np.ones((2, 2)), np.ones((2, 2))]),
+            ],
+        )
+        self.assertEqual(len(pS), 2)
+        self.assertEqual(pS['image_mask'][1].shape, (2, 2))
+
