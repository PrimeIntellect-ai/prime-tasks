+from caikit.core.data_model import DataStream, TrainingStatus
+from caikit.core.model_management.local_model_trainer import LocalModelTrainer
+from sample_lib.data_model import SampleTrainingType
+from sample_lib.modules import SampleModule
+
+
+_TRAINING_STATE = "clean-process-state"
+
+
+def _training_data_checks_process_state():
+    assert _TRAINING_STATE == "clean-process-state"
+    yield SampleTrainingType(number=1)
+
+
+def test_training_can_run_in_a_spawned_subprocess():
+    trainer = LocalModelTrainer(
+        aconfig.Config(
+            {"use_subprocess": True, "subprocess_start_method": "spawn"},
+            override_env_vars=False,
+        ),
+        "test-instance",
+    )
+
+    global _TRAINING_STATE
+    _TRAINING_STATE = "parent-only-state"
+    try:
+        future = trainer.train(
+            SampleModule, DataStream(_training_data_checks_process_state)
+        )
+        future.wait()
+        assert future.get_info().status == TrainingStatus.COMPLETED
+    finally:
+        _TRAINING_STATE = "clean-process-state"
