+	var got quotedDocument
+	if err := yaml.Unmarshal(read, &got); err != nil {
+		t.Fatalf("failed to unmarshal %q: %v", read, err)
 	}
-	if token.IsNeedQuoted("Hello World") {
-		t.Fatal("failed to unquoted judge")
+	if !reflect.DeepEqual(want, got) {
+		t.Fatalf("file round trip mismatch:\n got: %#v\nwant: %#v\nfile contents: %q", got, want, read)
 	}
 }
