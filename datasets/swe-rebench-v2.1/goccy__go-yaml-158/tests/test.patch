+type quotedDocument struct {
+	Keyword  string   `yaml:"keyword"`
+	Response []string `yaml:"response"`
+}
+
+func quotedDocumentValue() quotedDocument {
+	return quotedDocument{
+		Keyword: "a test keyword",
+		Response: []string{
+			"**This line will print the first time** Fails to add when marshalling",
+			"This line will be printed alone after marshalling and unmarshalling",
+		},
+	}
+}
+
+func TestMarshalStringRequiresQuotation(t *testing.T) {
+	want := quotedDocumentValue()
+	data, err := yaml.Marshal(want)
+	if err != nil {
+		t.Fatalf("failed to marshal: %v", err)
+	}
+	var got quotedDocument
+	if err := yaml.Unmarshal(data, &got); err != nil {
+		t.Fatalf("failed to unmarshal %q: %v", data, err)
 	}
-	if !token.IsNeedQuoted("true") {
-		t.Fatal("failed to quoted judge for boolean")
+	if !reflect.DeepEqual(want, got) {
+		t.Fatalf("round trip mismatch:\n got: %#v\nwant: %#v\nmarshalled: %q", got, want, data)
 	}
-	if !token.IsNeedQuoted("1.234") {
-		t.Fatal("failed to quoted judge for number")
+}
+
+func TestMarshalStringRequiresQuotationFile(t *testing.T) {
+	want := quotedDocumentValue()
+	data, err := yaml.Marshal(want)
+	if err != nil {
+		t.Fatalf("failed to marshal: %v", err)
 	}
-	if !token.IsNeedQuoted("1:1") {
-		t.Fatal("failed to quoted judge for time")
+	path := filepath.Join(t.TempDir(), "document.yaml")
+	if err := os.WriteFile(path, data, 0644); err != nil {
+		t.Fatalf("failed to write file: %v", err)
 	}
-	if !token.IsNeedQuoted("hoge # comment") {
-		t.Fatal("failed to quoted judge for comment")
+	read, err := os.ReadFile(path)
