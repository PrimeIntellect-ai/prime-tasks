+func TestGithubIssue28(t *testing.T) {
+	type A struct {
+		Err error `json:"err"`
+	}
+
+	if b, err := Marshal(&A{Err: errors.New("ABC")}); err != nil {
+		t.Error(err)
+	} else if string(b) != `{"err":{}}` {
+		t.Error(string(b))
+	}
+
+	buf := &bytes.Buffer{}
+	if err := NewEncoder(buf).Encode(&A{Err: errors.New("ABC")}); err != nil {
+		t.Error(err)
+	} else if s := buf.String(); s != "{\"err\":{}}\n" {
+		t.Error(s)
+	}
+}
