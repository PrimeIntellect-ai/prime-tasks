@@ -655,3 +664,55 @@ class TreeForwardRefs(typing.NamedTuple):
 @given(st.builds(TreeForwardRefs))
 def test_resolves_forward_references_outside_annotations(t):
     assert isinstance(t, TreeForwardRefs)
+
+
+def constructor(a: str = None):
+    pass
+
+
+class WithOptionalInSignature:
+    __signature__ = inspect.signature(constructor)
+    __annotations__ = typing.get_type_hints(constructor)
+
+    def __init__(self, **kwargs):
+        assert set(kwargs) == {"a"}
+        self.a = kwargs["a"]
+
+
+def test_compat_get_type_hints_aware_of_None_default():
+    # Regression test for https://github.com/HypothesisWorks/hypothesis/issues/2648
+    strategy = st.builds(WithOptionalInSignature, a=infer)
+    find_any(strategy, lambda x: x.a is None)
+    find_any(strategy, lambda x: x.a is not None)
+
+    assert typing.get_type_hints(constructor)["a"] == typing.Optional[str]
+    assert inspect.signature(constructor).parameters["a"].annotation == str
+
+
+def constructor_with_optional(a: str = "x", *, b: typing.Optional[str]):
+    pass
+
+
+class WithOptionalField:
+    __signature__ = inspect.signature(constructor_with_optional)
+
+    def __init__(self, **kwargs):
+        self.b = kwargs["b"]
+
+
+def test_from_type_generates_optional_fields():
+    # from_type on a class with an optional field should sometimes generate a
+    # value for that field, rather than always None.
+    strategy = st.from_type(WithOptionalField)
+    find_any(strategy, lambda x: x.b is None)
+    find_any(strategy, lambda x: x.b is not None)
+
+
+@given(st.from_type(WithOptionalField))
+def test_from_type_optional_field_is_None_or_annotated_type(x):
+    assert x.b is None or isinstance(x.b, str)
+
+
+@given(st.builds(WithOptionalInSignature, a=infer))
+def test_builds_infer_None_default_is_None_or_annotated_type(x):
+    assert x.a is None or isinstance(x.a, str)
