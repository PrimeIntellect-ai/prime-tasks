+def test_recursion_error_from_stack_depth_variation_is_not_flaky():
+    calls = [0]
+    depth = int(sys.getrecursionlimit() * 0.83)
+    extra_frames = int(sys.getrecursionlimit() * 0.15)
+
+    def recurse(n):
+        if n:
+            recurse(n - 1)
+
+    def with_extra_stack(frames, function):
+        if frames:
+            return with_extra_stack(frames - 1, function)
+        return function()
+
+    @settings(max_examples=1)
+    @given(st.just(depth))
+    def deterministic_test(n):
+        calls[0] += 1
+        if calls[0] == 1:
+            with_extra_stack(extra_frames, lambda: recurse(n))
+        else:
+            recurse(n)
+
+    try:
+        deterministic_test()
+    except RecursionError:
+        # A stable RecursionError is not the flaky classification at issue.
+        pass
+
