+class LoopsTests(TestCase):
+    def test_basic(self):
+        self.assertTrue(
+            all(list(mi.loops(n)) == [None] * n for n in range(-10, 10))
+        )
+
+    def test_typing_signature(self):
+        source = '''
+import more_itertools as mi
+reveal_type(mi.loops(2))
+mi.loops("two")
+'''
+        with tempfile.NamedTemporaryFile(mode='w', suffix='.py') as example:
+            example.write(source)
+            example.flush()
+            stdout, _, status = mypy_api.run(
+                [
+                    '--strict',
+                    '--no-error-summary',
+                    '--cache-dir=/dev/null',
+                    example.name,
+                ]
+            )
+
+        self.assertEqual(status, 1)  # The deliberately invalid call is rejected.
+        self.assertIn('Revealed type is "typing.Iterator[None]"', stdout)
+        self.assertRegex(stdout, r'Argument 1.*expected "int"')
+
+    def test_returns_iterator(self):
+        for n in range(-10, 10):
+            with self.subTest(n=n):
+                result = mi.loops(n)
+                self.assertIs(iter(result), result)
+
+    def test_does_not_iterate_range(self):
+        original_range = range
+        range_was_iterated = False
+
+        class RangeProxy:
+            def __iter__(self):
+                nonlocal range_was_iterated
+                range_was_iterated = True
+                return iter(original_range(3))
+
+        def tracked_range(*args):
+            return RangeProxy()
+
+        with patch('builtins.range', tracked_range):
+            self.assertEqual(list(mi.loops(3)), [None, None, None])
+
+        self.assertFalse(range_was_iterated)
