+func TestPullLocalSIF(t *testing.T) {
+	f, err := ioutil.TempFile("", "*.sif")
+	require.NoError(t, err, "could not create temp SIF file")
+	_, err = f.Write([]byte("local sif content"))
+	require.NoError(t, err, "could not write temp SIF file")
+	require.NoError(t, f.Close())
+	defer os.Remove(f.Name())
+
+	ref, err := ParseRef("local.file" + f.Name())
+	require.NoError(t, err, "could not parse local SIF reference")
+
+	info, err := Pull(context.Background(), os.TempDir(), ref, nil)
+	require.NoError(t, err, "could not pull local SIF")
+	require.NotNil(t, info, "expected image info")
+	require.Equal(t, f.Name(), info.Path, "local SIF should be used in place")
+	require.Equal(t, ref, info.Ref, "reference mismatch")
+}
+
+func TestInfo_RemoveLocalSIF(t *testing.T) {
+	f, err := ioutil.TempFile("", "*.sif")
+	require.NoError(t, err, "could not create temp SIF file")
+	require.NoError(t, f.Close())
+	defer os.Remove(f.Name())
+
+	ref, err := ParseRef("local.file" + f.Name())
+	require.NoError(t, err, "could not parse local SIF reference")
+	info := &Info{Path: f.Name(), Ref: ref}
+
+	require.NoError(t, info.Remove(), "could not remove local SIF")
+	require.FileExists(t, f.Name(), "local SIF should not be removed")
 }
