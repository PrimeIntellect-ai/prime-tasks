+func TestReconcileRejectsMissingClusterDataReferences(t *testing.T) {
+	ctx := context.Background()
+	cluster := &kubeanclusterv1alpha1.KuBeanCluster{
+		ObjectMeta: metav1.ObjectMeta{Name: "cluster-with-missing-data"},
+	}
+	clusterOps := &kubeanclusteropsv1alpha1.KuBeanClusterOps{
+		ObjectMeta: metav1.ObjectMeta{Namespace: "default", Name: "ops-with-missing-data"},
+		Spec: kubeanclusteropsv1alpha1.Spec{
+			KuBeanCluster: cluster.Name,
+			Image:         "valid-image",
+		},
+	}
+	sch := scheme.Scheme
+	if err := kubeanclusteropsv1alpha1.AddToScheme(sch); err != nil {
+		t.Fatal(err)
+	}
+	if err := kubeanclusterv1alpha1.AddToScheme(sch); err != nil {
+		t.Fatal(err)
+	}
+	controller := &Controller{
+		Client: fake.NewClientBuilder().
+			WithScheme(sch).
+			WithRuntimeObjects(clusterOps, cluster).
+			Build(),
+		ClientSet:        clientsetfake.NewSimpleClientset(),
+		KubeanClusterSet: kubeanclusterv1alpha1fake.NewSimpleClientset(cluster),
+	}
+
+	var reconcileErr error
+	for i := 0; i < 5; i++ {
+		_, reconcileErr = controller.Reconcile(ctx, controllerruntime.Request{
+			NamespacedName: client.ObjectKeyFromObject(clusterOps),
+		})
+		if reconcileErr != nil {
+			break
+		}
+	}
+	if reconcileErr != nil {
+		if !strings.Contains(reconcileErr.Error(), "hostsConfRef is empty") {
+			t.Fatalf("reconciliation error did not identify the invalid hosts reference: %v", reconcileErr)
+		}
+	} else {
+		got := &kubeanclusteropsv1alpha1.KuBeanClusterOps{}
+		if err := controller.Client.Get(ctx, client.ObjectKeyFromObject(clusterOps), got); err != nil {
+			t.Fatalf("getting reconciled ops: %v", err)
+		}
+		if got.Status.Status != kubeanclusteropsv1alpha1.FailedStatus {
+			// Invalid references must not be acted upon: the ops must not start or
+			// succeed, and no job may be created for it.
+			if got.Status.Status == kubeanclusteropsv1alpha1.RunningStatus || got.Status.Status == kubeanclusteropsv1alpha1.SucceededStatus || !got.Status.JobRef.IsEmpty() {
+				t.Fatalf("reconciliation proceeded with invalid data references: got status %q", got.Status.Status)
+			}
+			jobs, err := controller.ClientSet.BatchV1().Jobs("").List(ctx, metav1.ListOptions{})
+			if err != nil {
+				t.Fatalf("listing jobs: %v", err)
+			}
+			if len(jobs.Items) != 0 {
+				t.Fatalf("reconciliation created %d job(s) for invalid data references", len(jobs.Items))
+			}
+		}
+	}
+
+	// Valid references should not be rejected merely because reconciliation ran.
+	validCluster := &kubeanclusterv1alpha1.KuBeanCluster{
+		ObjectMeta: metav1.ObjectMeta{Name: "cluster-with-valid-data"},
+		Spec: kubeanclusterv1alpha1.Spec{
+			HostsConfRef: &apis.ConfigMapRef{NameSpace: "default", Name: "hosts"},
+			VarsConfRef:  &apis.ConfigMapRef{NameSpace: "default", Name: "vars"},
+		},
+	}
+	validOps := &kubeanclusteropsv1alpha1.KuBeanClusterOps{
+		ObjectMeta: metav1.ObjectMeta{Namespace: "default", Name: "ops-with-valid-data"},
+		Spec: kubeanclusteropsv1alpha1.Spec{
+			KuBeanCluster: validCluster.Name,
+			Image:         "valid-image",
+		},
+	}
+	validController := &Controller{
+		Client: fake.NewClientBuilder().
+			WithScheme(sch).
+			WithRuntimeObjects(validOps, validCluster).
+			Build(),
+		ClientSet: clientsetfake.NewSimpleClientset(
+			&corev1.ConfigMap{ObjectMeta: metav1.ObjectMeta{Namespace: "default", Name: "hosts"}},
+			&corev1.ConfigMap{ObjectMeta: metav1.ObjectMeta{Namespace: "default", Name: "vars"}},
+		),
+		KubeanClusterSet: kubeanclusterv1alpha1fake.NewSimpleClientset(validCluster),
+	}
+	_, reconcileErr = validController.Reconcile(ctx, controllerruntime.Request{
+		NamespacedName: client.ObjectKeyFromObject(validOps),
+	})
+	if reconcileErr != nil {
+		t.Fatalf("reconciling ops with valid references returned an error: %v", reconcileErr)
+	}
+	validGot := &kubeanclusteropsv1alpha1.KuBeanClusterOps{}
+	if err := validController.Client.Get(ctx, client.ObjectKeyFromObject(validOps), validGot); err != nil {
+		t.Fatalf("getting ops with valid references: %v", err)
+	}
+	if validGot.Status.Status == kubeanclusteropsv1alpha1.FailedStatus {
+		t.Fatal("reconciliation rejected valid data references")
+	}
+
+}
