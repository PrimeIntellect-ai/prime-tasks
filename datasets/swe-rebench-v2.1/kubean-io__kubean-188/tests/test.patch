+func Test_CheckClusterDataRef_Override(t *testing.T) {
+	newController := func() *Controller {
+		return &Controller{
+			Client:              newFakeClient(),
+			ClientSet:           clientsetfake.NewSimpleClientset(),
+			KubeanClusterSet:    kubeanclusterv1alpha1fake.NewSimpleClientset(),
+			KubeanClusterOpsSet: kubeanclusteropsv1alpha1fake.NewSimpleClientset(),
+		}
+	}
+	createCM := func(c *Controller, ns, name string) {
+		c.ClientSet.CoreV1().ConfigMaps(ns).Create(context.Background(), &corev1.ConfigMap{
+			ObjectMeta: metav1.ObjectMeta{Namespace: ns, Name: name},
+			Data:       map[string]string{"ok": "ok123"},
+		}, metav1.CreateOptions{})
+	}
+	createSecret := func(c *Controller, ns, name string) {
+		c.ClientSet.CoreV1().Secrets(ns).Create(context.Background(), &corev1.Secret{
+			ObjectMeta: metav1.ObjectMeta{Namespace: ns, Name: name},
+			Data:       map[string][]byte{"ok": []byte("ok123")},
+		}, metav1.CreateOptions{})
+	}
+
+	t.Run("hostsConfRef override is used", func(t *testing.T) {
+		c := newController()
+		createCM(c, "my_namespace", "override_hosts_cm")
+		createCM(c, "my_namespace", "vars_cm")
+		createSecret(c, "my_namespace", "ssh_secret")
+		cluster := &kubeanclusterv1alpha1.KuBeanCluster{
+			ObjectMeta: metav1.ObjectMeta{Name: "my_kubean_cluster"},
+			Spec: kubeanclusterv1alpha1.Spec{
+				HostsConfRef: &apis.ConfigMapRef{NameSpace: "my_namespace", Name: "missing_hosts_cm"},
+				VarsConfRef:  &apis.ConfigMapRef{NameSpace: "my_namespace", Name: "vars_cm"},
+				SSHAuthRef:   &apis.SecretRef{NameSpace: "my_namespace", Name: "ssh_secret"},
+			},
+		}
+		clusterOps := &kubeanclusteropsv1alpha1.KuBeanClusterOps{
+			ObjectMeta: metav1.ObjectMeta{Name: "my_kubean_ops_cluster"},
+			Spec: kubeanclusteropsv1alpha1.Spec{
+				HostsConfRef: &apis.ConfigMapRef{NameSpace: "my_namespace", Name: "override_hosts_cm"},
+			},
+		}
+		if err := requireClusterDataRefAPI(t, c).CheckClusterDataRef(cluster, clusterOps); err != nil {
+			t.Fatalf("expected nil error when hostsConfRef is overridden, got %v", err)
+		}
+	})
+
+	t.Run("varsConfRef override is used", func(t *testing.T) {
+		c := newController()
+		createCM(c, "my_namespace", "hosts_cm")
+		createCM(c, "my_namespace", "override_vars_cm")
+		createSecret(c, "my_namespace", "ssh_secret")
+		cluster := &kubeanclusterv1alpha1.KuBeanCluster{
+			ObjectMeta: metav1.ObjectMeta{Name: "my_kubean_cluster"},
+			Spec: kubeanclusterv1alpha1.Spec{
+				HostsConfRef: &apis.ConfigMapRef{NameSpace: "my_namespace", Name: "hosts_cm"},
+				VarsConfRef:  &apis.ConfigMapRef{NameSpace: "my_namespace", Name: "missing_vars_cm"},
+				SSHAuthRef:   &apis.SecretRef{NameSpace: "my_namespace", Name: "ssh_secret"},
+			},
+		}
+		clusterOps := &kubeanclusteropsv1alpha1.KuBeanClusterOps{
+			ObjectMeta: metav1.ObjectMeta{Name: "my_kubean_ops_cluster"},
+			Spec: kubeanclusteropsv1alpha1.Spec{
+				VarsConfRef: &apis.ConfigMapRef{NameSpace: "my_namespace", Name: "override_vars_cm"},
+			},
+		}
+		if err := requireClusterDataRefAPI(t, c).CheckClusterDataRef(cluster, clusterOps); err != nil {
+			t.Fatalf("expected nil error when varsConfRef is overridden, got %v", err)
+		}
+	})
+
+	t.Run("sshAuthRef override is used", func(t *testing.T) {
+		c := newController()
+		createCM(c, "my_namespace", "hosts_cm")
+		createCM(c, "my_namespace", "vars_cm")
+		createSecret(c, "my_namespace", "override_ssh_secret")
+		cluster := &kubeanclusterv1alpha1.KuBeanCluster{
+			ObjectMeta: metav1.ObjectMeta{Name: "my_kubean_cluster"},
+			Spec: kubeanclusterv1alpha1.Spec{
+				HostsConfRef: &apis.ConfigMapRef{NameSpace: "my_namespace", Name: "hosts_cm"},
+				VarsConfRef:  &apis.ConfigMapRef{NameSpace: "my_namespace", Name: "vars_cm"},
+				SSHAuthRef:   &apis.SecretRef{NameSpace: "my_namespace", Name: "missing_ssh_secret"},
+			},
+		}
+		clusterOps := &kubeanclusteropsv1alpha1.KuBeanClusterOps{
+			ObjectMeta: metav1.ObjectMeta{Name: "my_kubean_ops_cluster"},
+			Spec: kubeanclusteropsv1alpha1.Spec{
+				SSHAuthRef: &apis.SecretRef{NameSpace: "my_namespace", Name: "override_ssh_secret"},
+			},
+		}
+		if err := requireClusterDataRefAPI(t, c).CheckClusterDataRef(cluster, clusterOps); err != nil {
+			t.Fatalf("expected nil error when sshAuthRef is overridden, got %v", err)
+		}
+	})
+}
