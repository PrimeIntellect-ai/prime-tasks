+type clusterDataReferenceAPI interface {
+	CheckConfigMapExist(namespace, name string) bool
+	CheckSecretExist(namespace, name string) bool
+	CheckClusterDataRef(cluster *kubeanclusterv1alpha1.KuBeanCluster, clusterOPS *kubeanclusteropsv1alpha1.KuBeanClusterOps) error
+}
+
+func requireClusterDataRefAPI(t *testing.T, controller interface{}) clusterDataReferenceAPI {
+	t.Helper()
+	if value, ok := controller.(Controller); ok {
+		controller = &value
+	}
+	api, ok := controller.(clusterDataReferenceAPI)
+	if !ok {
+		t.Fatal("controller does not provide the cluster data reference API")
+	}
+	return api
+}
