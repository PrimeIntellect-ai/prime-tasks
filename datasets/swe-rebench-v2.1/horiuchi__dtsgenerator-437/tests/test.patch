+function normalizeInterfacePropertyOrder(text: string): string {
+    return text.replace(/(export interface [^{]+\{\n)([\s\S]*?)(\n\s*\})/g, (_match: string, start: string, body: string, end: string) => {
+        const properties = body.split('\n').sort((left, right) => left.trim().localeCompare(right.trim()));
+        return `${start}${properties.join('\n')}${end}`;
+    });
+}
