diff --git a/tests/test_flask.py b/tests/test_flask.py
index cbd2189..9b798ac 100644
--- a/tests/test_flask.py
+++ b/tests/test_flask.py
@@ -163,3 +163,27 @@ def test_setting_instance_options_works_case_insensitive():
     # oddly, using '_for_dynaconf' won't work, although
     # the option functionality seems to work as expected
     assert app.config.load_dotenv is False
+
+
+def test_nested_setdefault_value_is_retrievable():
+    app = Flask(__name__)
+    FlaskDynaconf(app, compatibility_mode=True)
+
+    nested = app.config.setdefault("ASDF", {})
+    nested.setdefault("qwer", "zxcv")
+
+    assert app.config["ASDF"]["qwer"] == "zxcv"
+
+
+def test_extension_config_pattern_after_dynaconf_initialization():
+    app = Flask(__name__)
+    FlaskDynaconf(app, compatibility_mode=True)
+
+    class AlembicLikeExtension:
+        def init_app(self, flask_app):
+            section = flask_app.config.setdefault("ALEMBIC", {})
+            section.setdefault("script_location", "migrations")
+
+    AlembicLikeExtension().init_app(app)
+
+    assert app.config["ALEMBIC"]["script_location"] == "migrations"
