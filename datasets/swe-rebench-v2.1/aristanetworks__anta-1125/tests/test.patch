+class TestEnvironmentInputValidation:
+    """Test that the `states` input of the environment tests rejects invalid values."""
+
+    @pytest.mark.parametrize(
+        ("test_class", "states"),
+        [
+            pytest.param(VerifyEnvironmentCooling, ["ok", "powerLoss"], id="cooling-valid"),
+            pytest.param(VerifyEnvironmentCooling, ["failed", "unknownHwStatus", "unsupported"], id="cooling-valid-all"),
+            pytest.param(VerifyEnvironmentPower, ["ok", "powerLoss"], id="power-valid"),
+            pytest.param(VerifyEnvironmentPower, ["unknown", "failed"], id="power-valid-all"),
+        ],
+    )
+    def test_valid_states(self, test_class: type, states: list[str]) -> None:
+        """Valid state values must be accepted."""
+        test_class.Input(states=states)
+
+    @pytest.mark.parametrize(
+        ("test_class", "states"),
+        [
+            pytest.param(VerifyEnvironmentCooling, ["Not Inserted"], id="cooling-invalid"),
+            pytest.param(VerifyEnvironmentCooling, ["down"], id="cooling-invalid-down"),
+            pytest.param(VerifyEnvironmentCooling, ["ok", "bogus"], id="cooling-invalid-mixed"),
+            pytest.param(VerifyEnvironmentPower, ["Not Inserted"], id="power-invalid"),
+            pytest.param(VerifyEnvironmentPower, ["down"], id="power-invalid-down"),
+            pytest.param(VerifyEnvironmentPower, ["ok", "bogus"], id="power-invalid-mixed"),
+        ],
+    )
+    def test_invalid_states(self, test_class: type, states: list[str]) -> None:
+        """Invalid state values must be rejected."""
+        with pytest.raises(ValidationError):
+            test_class.Input(states=states)
