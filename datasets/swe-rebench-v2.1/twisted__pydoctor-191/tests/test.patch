+def test_docstring_assignment_after_conditional_definitions():
+    mod = fromText('''
+    if condition:
+        def func(args):
+            pass
+    else:
+        def func(args):
+            pass
+
+    func.__doc__ = "Documentation shared by both definitions."
+    ''')
+
+    func = mod.contents['func']
+    assert func.docstring == "Documentation shared by both definitions."
+
+
+def test_docstring_assignment():
+    mod = fromText('''
+    def fun():
+        pass
+
+    fun.__doc__ = "Happy Happy Joy Joy"
+    ''')
+    fun = mod.contents['fun']
+    assert fun.docstring == "Happy Happy Joy Joy"
+
+
+def test_docstring_assignment_diagnostics(capsys):
+    fromText('''
+    def fun():
+        pass
+    # reserved source line 4
+    # reserved source line 5
+    # reserved source line 6
+    # reserved source line 7
+    # reserved source line 8
+    # reserved source line 9
+    # reserved source line 10
+    # reserved source line 11
+    # reserved source line 12
+    # reserved source line 13
+    # reserved source line 14
+    # reserved source line 15
+    # reserved source line 16
+    # reserved source line 17
+    # reserved source line 18
+    # reserved source line 19
+    None.__doc__ = "Free lunch!"
+    real.__doc__ = "Second breakfast"
+    fun.__doc__ = codecs.encode('Pnrfne fnynq', 'rot13')
+    fun.__doc__ = 4
+    ''')
+    output = capsys.readouterr().out
+    assert output == (
+        "<unknown>:20: Unable to figure out target for __doc__ assignment\n"
+        "<unknown>:21: Unable to figure out target for __doc__ assignment: "
+        "computed full name not found: real\n"
+        "<unknown>:22: Unable to figure out value for __doc__ assignment, "
+        "maybe too complex\n"
+        "<unknown>:23: Ignoring value assigned to __doc__: not a string\n"
+    )
+
+
+def test_non_string_docstring_assignment_preserves_existing_docstring():
+    mod = fromText('''
+    def fun():
+        """Original documentation."""
+
+    fun.__doc__ = 4
+    ''')
+    assert mod.contents['fun'].docstring == "Original documentation."
+
