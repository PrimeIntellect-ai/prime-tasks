+    /**
+     * JSON string content must preserve its characters while escaping the
+     * quotation mark, reverse solidus, and all control characters.
+     */
+    public void testEncodeForJSON_ProducesValidJSONStringContents() {
+        Encoder instance = ESAPI.encoder();
+        StringBuilder input = new StringBuilder("ordinary / text, \"quoted\" \\ and ")
+                .append('\u2028').append(" supplementary ").append("\uD83D\uDE02");
+        for (int i = 0; i <= 0x1f; i++) {
+            input.append((char) i);
+        }
+
+        String original = input.toString();
+        String encoded = instance.encodeForJSON(original);
+        assertEquals(original, decodeValidJSONStringContents(encoded));
+    }
+
+    /**
+     * Interprets JSON string contents for the behavioral assertions above,
+     * accepting every RFC 8259 escape spelling rather than a particular one.
+     */
+    private String decodeValidJSONStringContents(String encoded) {
+        StringBuilder decoded = new StringBuilder(encoded.length());
+        for (int i = 0; i < encoded.length(); i++) {
+            char ch = encoded.charAt(i);
+            assertTrue("unescaped quotation mark", ch != '"');
+            if (ch != '\\') {
+                assertTrue("unescaped JSON control character", ch >= 0x20);
+                decoded.append(ch);
+                continue;
+            }
+
+            assertTrue("complete JSON escape", i + 1 < encoded.length());
+            char escaped = encoded.charAt(++i);
+            switch (escaped) {
+                case '"': decoded.append('"'); break;
+                case '\\': decoded.append('\\'); break;
+                case '/': decoded.append('/'); break;
+                case 'b': decoded.append('\b'); break;
+                case 'f': decoded.append('\f'); break;
+                case 'n': decoded.append('\n'); break;
+                case 'r': decoded.append('\r'); break;
+                case 't': decoded.append('\t'); break;
+                case 'u':
+                    assertTrue("complete Unicode escape", i + 4 < encoded.length());
+                    int value = 0;
+                    for (int j = 0; j < 4; j++) {
+                        char hex = encoded.charAt(++i);
+                        int digit = hex >= '0' && hex <= '9' ? hex - '0'
+                                : hex >= 'a' && hex <= 'f' ? hex - 'a' + 10
+                                : hex >= 'A' && hex <= 'F' ? hex - 'A' + 10 : -1;
+                        assertTrue("hexadecimal Unicode escape", digit >= 0);
+                        value = value * 16 + digit;
+                    }
+                    decoded.append((char) value);
+                    break;
+                default:
+                    fail("invalid JSON escape sequence");
+            }
+        }
+        return decoded.toString();
+    }
