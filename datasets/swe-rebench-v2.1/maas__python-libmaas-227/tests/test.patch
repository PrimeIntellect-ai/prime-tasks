+    def test__vlan_update_vid_twice(self):
+        origin = make_origin()
+        Vlan = origin.Vlan
+        Vlan._handler.params = ['fabric_id', 'vid']
+        fabric_id = random.randint(1, 100)
+        vlan_id = random.randint(5001, 6000)
+        vid = random.randint(100, 200)
+        new_vid = random.randint(201, 300)
+        vlan = Vlan({
+            "id": vlan_id,
+            "fabric_id": fabric_id,
+            "vid": vid,
+        })
+        vlan.vid = new_vid
+        current_vid = [vid]
+
+        def update_vlan(**params):
+            self.assertThat(params["vid"], Equals(current_vid[0]))
+            current_vid[0] = params.get("_vid", params["vid"])
+            return {"id": vlan_id, "vid": current_vid[0]}
+
+        Vlan._handler.update.side_effect = update_vlan
+        vlan.save()
+        self.assertThat(vlan.vid, Equals(new_vid))
+
+        # A later VID change must still address the VLAN at its current VID.
+        new_vid_2 = random.randint(301, 400)
+        vlan.vid = new_vid_2
+        vlan.save()
+        self.assertThat(vlan.vid, Equals(new_vid_2))
+
+    def test__vlan_update_name_after_vid(self):
+        origin = make_origin()
+        Vlan = origin.Vlan
+        Vlan._handler.params = ['fabric_id', 'vid']
+        fabric_id = random.randint(1, 100)
+        vlan_id = random.randint(5001, 6000)
+        vid = random.randint(100, 200)
+        new_vid = random.randint(201, 300)
+        vlan = Vlan({
+            "id": vlan_id,
+            "fabric_id": fabric_id,
+            "vid": vid,
+            "name": "old-name",
+        })
+        vlan.vid = new_vid
+        current_vid = [vid]
+        current_name = ["old-name"]
+
+        def update_vlan(**params):
+            self.assertThat(params["vid"], Equals(current_vid[0]))
+            current_vid[0] = params.get("_vid", params["vid"])
+            current_name[0] = params.get("name", current_name[0])
+            return {
+                "id": vlan_id,
+                "vid": current_vid[0],
+                "name": current_name[0],
+            }
+
+        Vlan._handler.update.side_effect = update_vlan
+        vlan.save()
+        self.assertThat(vlan.vid, Equals(new_vid))
+
+        # Changing another attribute after the VID update must still save.
+        vlan.name = "new-name"
+        vlan.save()
+        self.assertThat(vlan.name, Equals("new-name"))
+
