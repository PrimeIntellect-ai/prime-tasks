+package day397
+
+import "testing"
+
+// nolint
+var testcases = []struct {
+	jobs, expected []Job
+}{
+	{
+		[]Job{
+			{0, 6},
+			{1, 4},
+			{3, 5},
+			{3, 8},
+			{4, 7},
+			{5, 9},
+			{6, 10},
+			{8, 11},
+		},
+		[]Job{
+			{1, 4},
+			{4, 7},
+			{8, 11},
+		},
+	},
+	{
+		[]Job{
+			{0, 100},
+			{1, 3},
+			{3, 5},
+			{0, 10},
+			{6, 8},
+			{9, 10},
+			{6, 10},
+			{8, 11},
+		},
+		[]Job{
+			{1, 3},
+			{3, 5},
+			{6, 8},
+			{9, 10},
+		},
+	},
+}
+
+func TestLargestSubsetCompatibleJobs(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range testcases {
+		res := LargestSubsetCompatibleJobs(tc.jobs)
+		if len(res) != len(tc.expected) {
+			t.Errorf("expected a maximum subset of %d jobs, got %d: %v", len(tc.expected), len(res), res)
+		}
+
+		available := make(map[Job]int)
+		for _, job := range tc.jobs {
+			available[job]++
+		}
+		for _, job := range res {
+			if available[job] == 0 {
+				t.Errorf("result contains a job not supplied in the input: %v", job)
+				continue
+			}
+			available[job]--
+		}
+		for i := range res {
+			for j := i + 1; j < len(res); j++ {
+				if res[i].End > res[j].Start && res[j].End > res[i].Start {
+					t.Errorf("result contains overlapping jobs: %v and %v", res[i], res[j])
+				}
+			}
+		}
+	}
+}
+
+func BenchmarkLargestSubsetCompatibleJobs(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			LargestSubsetCompatibleJobs(tc.jobs)
+		}
+	}
+}
