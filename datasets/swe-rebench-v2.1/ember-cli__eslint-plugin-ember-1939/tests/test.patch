+//------------------------------------------------------------------------------
+// Requirements
+//------------------------------------------------------------------------------
+
+const rule = require('../../../lib/rules/template-no-let-reference');
+const plugin = require('../../../lib');
+const RuleTester = require('eslint').RuleTester;
+
+//------------------------------------------------------------------------------
+// Tests
+//------------------------------------------------------------------------------
+
+describe('plugin rule export', () => {
+  test('registers this rule under its public identifier', () => {
+    expect(plugin.rules['template-no-let-reference']).toBeDefined();
+  });
+});
+
+const ruleTester = new RuleTester({
+  parser: require.resolve('../../../lib/parsers/gjs-gts-parser.js'),
+  parserOptions: { ecmaVersion: 2020, sourceType: 'module' },
+});
+
+ruleTester.run('template-no-let-reference', rule, {
+  valid: [
+    // referencing a const binding from a mustache expression is allowed
+    `
+      const a = '';
+      <template>
+      {{a}}
+      </template>
+    `,
+    // referencing a const binding as an element name is allowed
+    `
+      const a = '';
+      <template>
+      <a></a>
+      </template>
+    `,
+    // make sure rule does not error out on missing references
+    `
+      const a = '';
+      <template>
+      {{ab}}
+      <ab></ab>
+      </template>
+    `,
+    // a let binding that is never referenced from the template is allowed
+    `
+      let a = '';
+      <template>
+      {{b}}
+      </template>
+    `,
+  ],
+
+  invalid: [
+    // referencing a let binding from a mustache expression is disallowed
+    {
+      code: `
+      let a = '';
+      <template>
+      {{a}}
+      </template>
+      `,
+      errors: 1,
+    },
+    // references to a var binding are also disallowed in both template positions
+    {
+      code: `
+      var a = '';
+      <template>
+      {{a}}
+      <a></a>
+      </template>
+      `,
+      errors: 2,
+    },
+    // referencing a let binding as an element name is disallowed
+    {
+      code: `
+      let a = '';
+      <template>
+      <a></a>
+      </template>
+      `,
+      errors: 1,
+    },
+    // the motivating example from the rule documentation
+    {
+      code: `
+      let foo = 1;
+
+      function increment() {
+        foo++;
+      }
+
+      export default <template>{{foo}}</template>;
+      `,
+      errors: 1,
+    },
+  ],
+});
