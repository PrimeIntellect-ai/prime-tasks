+
+#[tokio::test]
+async fn retain() {
+    let mgr = RetainManager {
+        next: AtomicUsize::new(0),
+    };
+    let pool = RetainPool::builder(mgr).max_size(4).build().unwrap();
+
+    let a = pool.get().await.unwrap();
+    let b = pool.get().await.unwrap();
+    let c = pool.get().await.unwrap();
+    drop(a);
+    drop(b);
+    drop(c);
+    assert_eq!(pool.status().size, 3);
+
+    // A predicate returning true keeps every idle object.
+    pool.retain(|_, _| true);
+    assert_eq!(pool.status().size, 3);
+
+    // A predicate returning false removes every idle object.
+    pool.retain(|_, _| false);
+    assert_eq!(pool.status().size, 0);
+}
