+class RenderContextProbe(Context):
+    def __init__(
+        self,
+        environment: Environment,
+        parent: dict[str, Any],
+        name: str | None,
+        blocks: Any,
+        globals: dict[str, Any] | None = None,
+        locals: dict[str, Any] | None = None,
+    ) -> None:
+        super().__init__(environment, parent, name, blocks, globals)
+        if "_copier_conf" in parent:
+            RENDER_CONTEXT_PARENTS.append(dict(parent))
+
+
+class RenderContextProbeExtension(Extension):
+    def __init__(self, environment: Environment) -> None:
+        super().__init__(environment)
+        environment.context_class = RenderContextProbe
