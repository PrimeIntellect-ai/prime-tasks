+def test_worker_data_is_available_while_rendering_templates(tmp_path: Path) -> None:
+    template = tmp_path / "template"
+    template.mkdir()
+    (template / "copier.yml").write_text(
+        "_jinja_extensions:\n  - tests.test_config.RenderContextProbeExtension\n"
+    )
+    (template / "rendered.txt.jinja").write_text("{{ my_injected_variable }}")
+    destination = tmp_path / "destination"
+    RENDER_CONTEXT_PARENTS.clear()
+    worker = copier.Worker(
+        str(template),
+        destination,
+        data={"my_injected_variable": "17"},
+        quiet=True,
+        unsafe=True,
+    )
+
+    worker.run_copy()
+
+    assert (destination / "rendered.txt").read_text() == "17"
+    contexts = [
+        context for context in RENDER_CONTEXT_PARENTS if "_copier_conf" in context
+    ]
+    assert contexts and all(
+        context.get("my_injected_variable") == "17" for context in contexts
+    )
+
