+    eq(array.array, "b, ]")
+  end)
+
+  it("trailing commas before closers with whitespace", function()
+    eq(vim.fn.json_decode(json.json_strip_comments '{"a":"b",   }'), { a = "b" })
+    eq(vim.fn.json_decode(json.json_strip_comments [[{"a":["b",
+	]}]]), { a = { "b" } })
+    eq(vim.fn.json_decode(json.json_strip_comments [[{"a":{"b":"c",
+	},}]]), { a = { b = "c" } })
+  end)
 end)
