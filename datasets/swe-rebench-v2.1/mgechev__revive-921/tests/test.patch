+package formatter_test
+
+import (
+	"go/token"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/mgechev/revive/formatter"
+	"github.com/mgechev/revive/lint"
+)
+
+func TestFormatter(t *testing.T) {
+	lintFailure := lint.Failure{
+		Failure:  "test failure",
+		RuleName: "rule",
+		Category: "cat",
+		Position: lint.FailurePosition{
+			Start: token.Position{
+				Filename: "test.go",
+				Line:     2,
+				Column:   5,
+			},
+			End: token.Position{
+				Filename: "test.go",
+				Line:     2,
+				Column:   10,
+			},
+		},
+	}
+	formatters := []lint.Formatter{
+		&formatter.Default{},
+		&formatter.Friendly{},
+		&formatter.NDJSON{},
+		&formatter.Plain{},
+		&formatter.Unix{},
+	}
+
+	for _, f := range formatters {
+		t.Run(f.Name(), func(t *testing.T) {
+			fakeStdout, err := os.Create(t.TempDir() + "/fakeStdout")
+			if err != nil {
+				t.Fatal(err)
+			}
+			realStdout := os.Stdout
+			os.Stdout = fakeStdout
+			defer func() { os.Stdout = realStdout }()
+
+			failures := make(chan lint.Failure, 1)
+			failures <- lintFailure
+			close(failures)
+			output, err := f.Format(failures, lint.Config{})
+			os.Stdout = realStdout
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := fakeStdout.Close(); err != nil {
+				t.Fatal(err)
+			}
+			stdout, err := os.ReadFile(fakeStdout.Name())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(stdout) > 0 {
+				t.Errorf("formatter wrote to stdout: %q", stdout)
+			}
+			if !strings.Contains(output, lintFailure.Failure) {
+				t.Errorf("formatted output does not contain %q: %q", lintFailure.Failure, output)
+			}
+		})
+	}
+}
+
+func TestFormattersReturnAllFailures(t *testing.T) {
+	formatters := []lint.Formatter{
+		&formatter.Default{},
+		&formatter.Friendly{},
+		&formatter.NDJSON{},
+		&formatter.Plain{},
+		&formatter.Unix{},
+	}
+	failures := []lint.Failure{
+		{Failure: "first distinct failure"},
+		{Failure: "second distinct failure"},
+	}
+
+	for _, f := range formatters {
+		t.Run(f.Name(), func(t *testing.T) {
+			fakeStdout, err := os.Create(t.TempDir() + "/fakeStdout")
+			if err != nil {
+				t.Fatal(err)
+			}
+			realStdout := os.Stdout
+			os.Stdout = fakeStdout
+			defer func() { os.Stdout = realStdout }()
+
+			input := make(chan lint.Failure, len(failures))
+			for _, failure := range failures {
+				input <- failure
+			}
+			close(input)
+
+			output, err := f.Format(input, lint.Config{})
+			os.Stdout = realStdout
+			if err != nil {
+				t.Fatalf("Format returned an error: %v", err)
+			}
+			if err := fakeStdout.Close(); err != nil {
+				t.Fatal(err)
+			}
+			stdout, err := os.ReadFile(fakeStdout.Name())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(stdout) > 0 {
+				t.Errorf("formatter wrote to stdout: %q", stdout)
+			}
+			for _, failure := range failures {
+				if !strings.Contains(output, failure.Failure) {
+					t.Errorf("formatted output does not contain %q: %q", failure.Failure, output)
+				}
+			}
+		})
+	}
+}
