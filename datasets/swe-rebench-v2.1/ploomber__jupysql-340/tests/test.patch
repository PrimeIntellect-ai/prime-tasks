@@ -0,0 +1,42 @@
+from pathlib import Path
+
+import pytest
+
+DOC_DIR = Path(__file__).resolve().parents[2] / "doc"
+METADATA_FILTER = "notebook_metadata_filter: myst"
+
+
+def _front_matter(text):
+    """Return the YAML front matter of a Markdown file, or None if it has none"""
+    lines = text.splitlines()
+    if not lines or lines[0].strip() != "---":
+        return None
+
+    for index, line in enumerate(lines[1:], start=1):
+        if line.strip() == "---":
+            return "\n".join(lines[1:index])
+
+    return None
+
+
+def _markdown_files_with_metadata():
+    files = []
+    for path in sorted(DOC_DIR.rglob("*.md")):
+        if _front_matter(path.read_text(encoding="utf-8")) is not None:
+            files.append(path)
+    return files
+
+
+MARKDOWN_FILES = _markdown_files_with_metadata()
+
+
+def test_doc_markdown_files_with_metadata_exist():
+    assert len(MARKDOWN_FILES) > 0
+
+
+@pytest.mark.parametrize(
+    "path", MARKDOWN_FILES, ids=lambda p: str(p.relative_to(DOC_DIR))
+)
+def test_doc_markdown_metadata_has_notebook_metadata_filter(path):
+    front_matter = _front_matter(path.read_text(encoding="utf-8"))
+    assert METADATA_FILTER in front_matter
