+    def test_parameter_shift_derivative_with_sparse_generator(self):
+        """Parameter shift agrees with autodiff for a controlled sparse-generator gate."""
+        dev = qml.device("default.qubit", wires=5)
+
+        @qml.qnode(dev)
+        def circuit(x):
+            qml.Hadamard(0)
+            qml.Hadamard(1)
+            qml.Hadamard(2)
+            qml.ctrl(qml.DoubleExcitationMinus(x, [1, 2, 3, 4]), 0)
+            return qml.expval(qml.dot([1, 1], [qml.PauliY(0), qml.PauliZ(3)]))
+
+        x = np.array(0.7, requires_grad=True)
+        autodiff_derivative = qml.grad(circuit)(x)
+        shift_derivative = qml.gradients.param_shift(circuit)(x)
+
+        assert np.allclose(shift_derivative, autodiff_derivative, atol=1e-7)
+        assert np.allclose(shift_derivative, -0.43279197822247817, atol=1e-7)
+
