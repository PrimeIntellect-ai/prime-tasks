diff --git a/tests/morebits.wikitext.js b/tests/morebits.wikitext.js
index e65fb14..862af9b 100644
--- a/tests/morebits.wikitext.js
+++ b/tests/morebits.wikitext.js
@@ -345,3 +345,163 @@ describe('Morebits.wikitext', () => {
 		});
 	});
 });
+
+	describe('{{Merge}} tags Discuss links', () => {
+		var fs = require('fs');
+		var path = require('path');
+		var savedTwinkle, savedNamespace, savedTitle;
+		var savedWikiPage;
+		var otherPageText, otherArticleResult = null;
+		var callback;
+
+		// Fake of the page object that the tagging callback works with
+		var makeFakePage = function (text, params, onSave) {
+			return {
+				getPageText: function () { return text; },
+				getCallbackParameters: function () { return params; },
+				setPageText: function (newText) { text = newText; },
+				setEditSummary: function () {},
+				setChangeTags: function () {},
+				setWatchlist: function () {},
+				setMinorEdit: function () {},
+				setCreateOption: function () {},
+				getLoadTime: function () { return 0; },
+				triage: function () {},
+				save: function (cb) {
+					onSave(text);
+					if (cb) {
+						cb();
+					}
+				}
+			};
+		};
+
+		// Parses the first merge template in the given wikitext
+		var parseMergeTag = function (text) {
+			return Morebits.wikitext.parseTemplate(text, text.indexOf('{{Merge'));
+		};
+
+		/**
+			 * Tags the current article (titled by wgTitle) and returns the resulting wikitext
+			 * of this article, and of the other article if the tagging callback also tagged it
+			 */
+		var tagArticle = function (options) {
+			var result = { main: null, other: null };
+			otherPageText = 'Other article text.';
+			otherArticleResult = null;
+			var params = {
+				tags: [options.tag],
+				tagsToRemove: [],
+				tagsToRemain: [],
+				group: false,
+				patrol: false,
+				mergeTarget: options.mergeTarget,
+				mergeReason: options.mergeReason,
+				mergeTagOther: options.mergeTagOther
+			};
+			callback(makeFakePage('Lead text.', params, function (text) {
+				result.main = text;
+			}));
+			return result;
+		};
+
+		beforeAll(() => {
+			savedTwinkle = global.Twinkle;
+			savedNamespace = mw.config.get('wgNamespaceNumber');
+			savedTitle = mw.config.get('wgTitle');
+			global.Twinkle = {
+				getPref: function (name) { return name === 'watchTaggedVenues' ? [] : undefined; },
+				addInitCallback: function () {},
+				changeTags: '',
+				hatnoteRegex: ''
+			};
+			// Load the tagging module; the callback below is what tagging a page runs
+			(0, eval)(fs.readFileSync(path.join(__dirname, '..', 'modules', 'friendlytag.js'), 'utf8'));
+			// The lookup table is normally built by the tagging dialog before tagging
+			var flatObject = {};
+			var tagList = global.Twinkle.tag.article.tagList;
+			Object.keys(tagList).forEach(function (groupName) {
+				var group = tagList[groupName];
+				Object.keys(group).forEach(function (subgroupName) {
+					var subgroup = group[subgroupName];
+					(Array.isArray(subgroup) ? subgroup : [subgroup]).forEach(function (item) {
+						flatObject[item.tag] = item;
+					});
+				});
+			});
+			global.Twinkle.tag.article.flatObject = flatObject;
+			callback = global.Twinkle.tag.callbacks.article;
+		});
+
+		beforeEach(() => {
+		mw.config.set({ wgNamespaceNumber: 0, wgTitle: 'Nintendo Channel' });
+		savedWikiPage = Morebits.wiki.page;
+		// Network boundary: wiki page objects are replaced by in-memory ones. The other article
+		// is served from memory, and talk page posts are discarded.
+		Morebits.wiki.page = function FakeWikiPage(pageName) {
+			this.pageName = pageName;
+			this.params = null;
+		};
+		Morebits.wiki.page.prototype.setChangeTags = function () {};
+		Morebits.wiki.page.prototype.setWatchlist = function () {};
+	Morebits.wiki.page.prototype.setCreateOption = function () {};
+		Morebits.wiki.page.prototype.setNewSectionText = function () {};
+		Morebits.wiki.page.prototype.setNewSectionTitle = function () {};
+		Morebits.wiki.page.prototype.newSection = function () {};
+		Morebits.wiki.page.prototype.setCallbackParameters = function (params) {
+			this.params = params;
+		};
+		Morebits.wiki.page.prototype.getCallbackParameters = function () {
+			return this.params;
+		};
+		Morebits.wiki.page.prototype.load = function (cb) {
+			cb(makeFakePage(otherPageText, this.params, function (text) {
+				otherArticleResult = text;
+			}));
+		};
+		});
+
+		afterEach(() => {
+			Morebits.wiki.page = savedWikiPage;
+		});
+
+	afterAll(() => {
+			mw.config.set({ wgNamespaceNumber: savedNamespace, wgTitle: savedTitle });
+			global.Twinkle = savedTwinkle;
+		});
+
+		test('Merge to a section: Discuss link does not repeat the section in the article title', () => {
+			var result = tagArticle({ tag: 'Merge to', mergeTarget: 'Wii Menu#Nintendo Channel', mergeReason: 'Reason' });
+			var tag = parseMergeTag(result.main);
+			assert.strictEqual(tag.name, 'Merge to');
+			assert.strictEqual(tag.parameters.discuss, 'Talk:Wii Menu#Proposed merge of Nintendo Channel into Wii Menu#Nintendo Channel');
+		});
+
+		test('Merge to a plain article: Discuss link is unchanged', () => {
+			var result = tagArticle({ tag: 'Merge to', mergeTarget: 'Wii Menu', mergeReason: 'Reason' });
+			var tag = parseMergeTag(result.main);
+			assert.strictEqual(tag.parameters.discuss, 'Talk:Wii Menu#Proposed merge of Nintendo Channel into Wii Menu');
+		});
+
+		test('Merge to a section with the other article tagged: both articles get the corrected Discuss link', () => {
+			var result = tagArticle({ tag: 'Merge to', mergeTarget: 'Wii Menu#Nintendo Channel', mergeReason: 'Reason', mergeTagOther: true });
+			var expected = 'Talk:Wii Menu#Proposed merge of Nintendo Channel into Wii Menu#Nintendo Channel';
+			assert.strictEqual(parseMergeTag(result.main).parameters.discuss, expected, 'article carrying Merge to');
+			assert.notStrictEqual(otherArticleResult, null, 'other article was tagged');
+			var other = parseMergeTag(otherArticleResult);
+			assert.strictEqual(other.name, 'Merge from', 'other article carries Merge from');
+			assert.strictEqual(other.parameters.discuss, expected, 'other article Discuss link');
+		});
+
+		test('Merge from with a section target: Discuss link names the current article without a section', () => {
+			var result = tagArticle({ tag: 'Merge from', mergeTarget: 'Wii Menu#Nintendo Channel', mergeReason: 'Reason' });
+			var discuss = parseMergeTag(result.main).parameters.discuss;
+			assert.strictEqual(discuss.indexOf('Talk:Nintendo Channel#'), 0, discuss);
+		});
+
+		test('Merge with a section target: Discuss link names the current article without a section', () => {
+			var result = tagArticle({ tag: 'Merge', mergeTarget: 'Wii Menu#Nintendo Channel', mergeReason: 'Reason' });
+			var discuss = parseMergeTag(result.main).parameters.discuss;
+			assert.strictEqual(discuss.indexOf('Talk:Nintendo Channel#'), 0, discuss);
+		});
+});
