+import os
+import shutil
+
+from pre_commit.meta_hooks import identity
+from pre_commit.repository import Repository
+
+
+def test_identity(cap_out):
+    assert not identity.main(('a', 'b', 'c'))
+    assert cap_out.get() == 'a\nb\nc\n'
+
+
+def test_identity_hook_is_verbose(store):
+    config = {'repo': 'meta', 'hooks': [{'id': 'identity'}]}
+    repo = Repository.create(config, store)
+    assert repo.manifest_hooks['identity']['verbose'] is True
+
+
+def test_identity_uses_command_line_arguments_when_argv_omitted(monkeypatch, cap_out):
+    monkeypatch.setattr('sys.argv', ['identity', 'first.py', 'second.py'])
+
+    assert identity.main() is None
+    assert cap_out.get() == 'first.py\nsecond.py\n'
+
+
+def test_identity_hook_runs_without_external_echo(
+        store, monkeypatch, tempdir_factory,
+):
+    bin_dir = tempdir_factory.get()
+    os.symlink(shutil.which('git'), os.path.join(bin_dir, 'git'))
+    monkeypatch.setenv('PATH', bin_dir)
+    config = {'repo': 'meta', 'hooks': [{'id': 'identity'}]}
+    repo = Repository.create(config, store)
+    _, hook = repo.hooks[0]
+
+    retcode, output, _ = repo.run_hook(hook, ('first.py', 'second.py'))
+
+    assert retcode == 0
+    assert output == b'first.py\nsecond.py\n'
