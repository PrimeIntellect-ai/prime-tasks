+func requestWithUnescapedQueryValues(r *Request) *Request {
+	setter, ok := interface{}(r).(interface {
+		SetUnescapeQueryParams(bool) *Request
+	})
+	if !ok {
+		return r
+	}
+	return setter.SetUnescapeQueryParams(true)
+}
