+void _normalizeAnalysisSection(Map<String, Object?> map) {
+  final report = map['report'];
+  if (report is! Map<String, Object?>) return;
+  final sections = report['sections'];
+  if (sections is! List) return;
+  for (final section in sections.whereType<Map<String, Object?>>()) {
+    if (section['id'] != 'analysis') continue;
+    section['grantedPoints'] = section['maxPoints'];
+    section['summary'] = '';
+  }
 }
+
+String _renderSections(Report report) => report.sections
+    .map(
+      (section) =>
+          '## ${section.grantedPoints}/${section.maxPoints} ${section.title}\n\n${section.summary}',
+    )
+    .join('\n\n');
