+  @Test
+  public void bicycleRoadAttractsItinerariesFromParallelStreet() {
+    // A bicycle road and a plain residential street connect the same two intersections.
+    // The bicycle road is longer, so it is only preferred for bicycles if its improved
+    // bicycle safety is taken into account when routing.
+    var bicycleRoadWay = new OSMWithTags();
+    bicycleRoadWay.addTag("highway", "residential");
+    bicycleRoadWay.addTag("bicycle_road", "yes");
+
+    var plainWay = new OSMWithTags();
+    plainWay.addTag("highway", "residential");
+
+    double bicycleRoadSafety = wps
+      .getDataForWay(bicycleRoadWay)
+      .getBicycleSafetyFeatures()
+      .forward();
+    double plainSafety = wps.getDataForWay(plainWay).getBicycleSafetyFeatures().forward();
+
+    var from = intersectionVertex("from", 0.0, 0.0);
+    var to = intersectionVertex("to", 0.001, 0.0);
+    var bicycleRoad = streetEdge(from, to, "Bicycle road", 100.0, bicycleRoadSafety);
+    var plainStreet = streetEdge(from, to, "Plain street", 90.0, plainSafety);
+
+    var request = new RouteRequest();
+    request.journey().direct().setMode(StreetMode.BIKE);
+
+    ShortestPathTree<State, Edge, Vertex> spt = StreetSearchBuilder.of()
+      .setHeuristic(new EuclideanRemainingWeightHeuristic())
+      .setRequest(request)
+      .setStreetRequest(request.journey().direct())
+      .setFrom(from)
+      .setTo(to)
+      .getShortestPathTree();
+
+    GraphPath<State, Edge, Vertex> path = spt.getPath(to);
+    assertNotNull(path);
+    assertTrue(
+      path.edges.contains(bicycleRoad),
+      "Bicycle itinerary should use the bicycle road, but used " + path.edges
+    );
+    assertFalse(path.edges.contains(plainStreet));
+  }
+
+  private static IntersectionVertex intersectionVertex(String label, double x, double y) {
+    return new IntersectionVertex(null, label, x, y, null, false, false);
+  }
+
+  private static StreetEdge streetEdge(
+    IntersectionVertex from,
+    IntersectionVertex to,
+    String name,
+    double length,
+    double bicycleSafety
+  ) {
+    LineString geometry = new GeometryFactory()
+      .createLineString(
+        new Coordinate[] {
+          new Coordinate(from.getLon(), from.getLat()),
+          new Coordinate(to.getLon(), to.getLat()),
+        }
+      );
+    var edge = new StreetEdge(
+      from,
+      to,
+      geometry,
+      name,
+      length,
+      StreetTraversalPermission.ALL,
+      false
+    );
+    edge.setBicycleSafetyFactor((float) bicycleSafety);
+    return edge;
+  }
