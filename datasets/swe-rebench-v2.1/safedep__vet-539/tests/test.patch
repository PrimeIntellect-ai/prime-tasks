+func TestSyncReporterEnvironmentResolverFactory(t *testing.T) {
+	t.Run("GitHub Actions environment", func(t *testing.T) {
+		t.Setenv("GITHUB_ACTIONS", "true")
+		t.Setenv("GITHUB_SERVER_URL", "https://github.example")
+		t.Setenv("GITHUB_REPOSITORY", "team/project")
+		t.Setenv("GITHUB_EVENT_NAME", "pull_request")
+		t.Setenv("GITHUB_REF", "refs/heads/feature")
+		t.Setenv("GITHUB_SHA", "0123456789abcdef")
+
+		resolver := NewSyncReporterEnvironmentResolver()
+		assert.Equal(t, controltowerv1pb.Project_SOURCE_GITHUB, resolver.GetProjectSource())
+		assert.Equal(t, "https://github.example/team/project", resolver.GetProjectURL())
+		assert.Equal(t, controltowerv1.ToolTrigger_TOOL_TRIGGER_PULL_REQUEST, resolver.Trigger())
+		assert.Equal(t, "refs/heads/feature", resolver.GitRef())
+		assert.Equal(t, "0123456789abcdef", resolver.GitSha())
+	})
+
+	t.Run("outside GitHub Actions", func(t *testing.T) {
+		previous, wasSet := os.LookupEnv("GITHUB_ACTIONS")
+		if err := os.Unsetenv("GITHUB_ACTIONS"); err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() {
+			if wasSet {
+				_ = os.Setenv("GITHUB_ACTIONS", previous)
+			} else {
+				_ = os.Unsetenv("GITHUB_ACTIONS")
+			}
+		})
+
+		resolver := NewSyncReporterEnvironmentResolver()
+		assert.Equal(t, controltowerv1pb.Project_SOURCE_UNSPECIFIED, resolver.GetProjectSource())
+		assert.Empty(t, resolver.GetProjectURL())
+		assert.Equal(t, controltowerv1.ToolTrigger_TOOL_TRIGGER_MANUAL, resolver.Trigger())
+		assert.Empty(t, resolver.GitRef())
+		assert.Empty(t, resolver.GitSha())
+	})
+}
