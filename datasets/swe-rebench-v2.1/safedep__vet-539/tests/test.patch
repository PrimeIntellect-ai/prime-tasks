+func TestScanSyncUsesDetectedEnvironment(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := grpc.NewServer()
+	capture := &scanSyncCapture{requests: make(chan *controltowerv1.CreateToolSessionRequest, 2)}
+	controltowerv1grpc.RegisterToolServiceServer(server, capture)
+	go func() { _ = server.Serve(listener) }()
+	t.Cleanup(server.Stop)
+
+	cases := []struct {
+		name                string
+		githubActions       bool
+		wantSource          controltowerv1pb.Project_Source
+		wantURL             string
+		wantTrigger         controltowerv1.ToolTrigger
+		wantGitRef, wantSHA string
+	}{
+		{
+			name:          "GitHub Actions metadata",
+			githubActions: true,
+			wantSource:    controltowerv1pb.Project_SOURCE_GITHUB,
+			wantURL:       "https://github.com/sample-org/sample-repo",
+			wantTrigger:   controltowerv1.ToolTrigger_TOOL_TRIGGER_PUSH,
+			wantGitRef:    "refs/heads/main",
+			wantSHA:       "deadbeef",
+		},
+		{
+			name:        "default metadata outside GitHub Actions",
+			wantSource:  controltowerv1pb.Project_SOURCE_UNSPECIFIED,
+			wantTrigger: controltowerv1.ToolTrigger_TOOL_TRIGGER_MANUAL,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			directory := t.TempDir()
+			command := exec.Command("go", "run", "-ldflags=-X=main.version=test-version", ".", "scan",
+				"--silent", "--report-sync", "--report-sync-project", "sample-project",
+				"--report-sync-project-version", "sample-version", "--directory", directory,
+				"--enrich=false")
+			command.Dir = "../.."
+			env := make([]string, 0, len(os.Environ())+8)
+			for _, entry := range os.Environ() {
+				if !strings.HasPrefix(entry, "GITHUB_ACTIONS=") &&
+					!strings.HasPrefix(entry, "GITHUB_SERVER_URL=") &&
+					!strings.HasPrefix(entry, "GITHUB_REPOSITORY=") &&
+					!strings.HasPrefix(entry, "GITHUB_EVENT_NAME=") &&
+					!strings.HasPrefix(entry, "GITHUB_REF=") &&
+					!strings.HasPrefix(entry, "GITHUB_SHA=") &&
+					!strings.HasPrefix(entry, "VET_SYNC_API_URL=") &&
+					!strings.HasPrefix(entry, "INSECURE_GRPC_CLIENT_USE_INSECURE_TRANSPORT=") {
+					env = append(env, entry)
+				}
+			}
+			command.Env = append(env,
+				"VET_SYNC_API_URL=http://"+listener.Addr().String(),
+				"INSECURE_GRPC_CLIENT_USE_INSECURE_TRANSPORT=true",
+			)
+			if tc.githubActions {
+				command.Env = append(command.Env,
+					"GITHUB_ACTIONS=true",
+					"GITHUB_SERVER_URL=https://github.com",
+					"GITHUB_REPOSITORY=sample-org/sample-repo",
+					"GITHUB_EVENT_NAME=push",
+					"GITHUB_REF=refs/heads/main",
+					"GITHUB_SHA=deadbeef",
+				)
+			}
+			output, err := command.CombinedOutput()
+			if err != nil {
+				t.Fatalf("scan command failed: %v\n%s", err, output)
+			}
+
+			select {
+			case req := <-capture.requests:
+				assert.Equal(t, tc.wantSource, req.GetOriginProjectSource())
+				assert.Equal(t, tc.wantURL, req.GetOriginProjectUrl())
+				assert.Equal(t, tc.wantTrigger, req.GetTrigger())
+				assert.Equal(t, tc.wantGitRef, req.GetGitRef())
+				assert.Equal(t, tc.wantSHA, req.GetGitSha())
+			default:
+				t.Fatal("scan did not create a sync session")
+			}
+		})
+	}
+}
