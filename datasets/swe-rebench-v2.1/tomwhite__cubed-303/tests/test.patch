+def _materialized_array_names(spec):
+    """Return the names of the Zarr arrays that have been written to the store."""
+    names = set()
+    for _, dirs, _ in os.walk(spec.work_dir):
+        for d in dirs:
+            if d.endswith(".zarr"):
+                names.add(d[: -len(".zarr")])
+    return names
+
+
+def _has_materialized_offsets(spec, numblocks):
+    """Whether a Zarr array containing the block offsets has been written."""
+    expected = np.arange(np.prod(numblocks)).reshape(numblocks)
+    for root, dirs, _ in os.walk(spec.work_dir):
+        for d in dirs:
+            if d.endswith(".zarr"):
+                array = zarr.open_array(os.path.join(root, d), mode="r")
+                if array.shape == numblocks and np.array_equal(array[...], expected):
+                    return True
+    return False
+
