+package day394
+
+import "testing"
+
+// nolint
+var testcases = []struct {
+	root     *IntBinaryTree
+	target   int
+	expected bool
+}{
+	{
+		&IntBinaryTree{
+			Value: 8,
+			Left: &IntBinaryTree{
+				Value: 4,
+				Left:  &IntBinaryTree{Value: 2},
+				Right: &IntBinaryTree{Value: 6},
+			},
+			Right: &IntBinaryTree{
+				Value: 13,
+				Right: &IntBinaryTree{Value: 19},
+			},
+		},
+		18,
+		true,
+	},
+	{
+		&IntBinaryTree{
+			Value: 8,
+			Left: &IntBinaryTree{
+				Value: 4,
+				Left:  &IntBinaryTree{Value: 2},
+				Right: &IntBinaryTree{Value: 6},
+			},
+			Right: &IntBinaryTree{
+				Value: 13,
+				Right: &IntBinaryTree{Value: 19},
+			},
+		},
+		100,
+		false,
+	},
+	{
+		&IntBinaryTree{
+			Value: 8,
+			Left: &IntBinaryTree{
+				Value: 4,
+				Left:  &IntBinaryTree{Value: 2},
+				Right: &IntBinaryTree{Value: 6},
+			},
+			Right: &IntBinaryTree{
+				Value: 13,
+				Right: &IntBinaryTree{Value: 19},
+			},
+		},
+		21,
+		false,
+	},
+	{
+		&IntBinaryTree{
+			Value: 8,
+			Left: &IntBinaryTree{
+				Value: 4,
+				Left:  &IntBinaryTree{Value: 2},
+				Right: &IntBinaryTree{Value: 6},
+			},
+			Right: &IntBinaryTree{
+				Value: 13,
+				Right: &IntBinaryTree{Value: 19},
+			},
+		},
+		40,
+		true,
+	},
+}
+
+func TestRootToLeafTarget(t *testing.T) {
+	t.Parallel()
+
+	for tcid, tc := range testcases {
+		if res := RootToLeafTarget(tc.root, tc.target); res != tc.expected {
+			t.Errorf("TCID%d expected %v, got %v", tcid, tc.expected, res)
+		}
+	}
+}
+
+func BenchmarkRootToLeafTarget(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			RootToLeafTarget(tc.root, tc.target)
+		}
+	}
+}
+
+func TestRootToLeafTargetSingleNode(t *testing.T) {
+	root := &IntBinaryTree{Value: 7}
+	for _, tc := range []struct {
+		target   int
+		expected bool
+	}{
+		{target: 7, expected: true},
+		{target: 6, expected: false},
+	} {
+		if got := RootToLeafTarget(root, tc.target); got != tc.expected {
+			t.Errorf("target %d: expected %v, got %v", tc.target, tc.expected, got)
+		}
+	}
+}
+
+func TestRootToLeafTargetWithNegativeValues(t *testing.T) {
+	root := &IntBinaryTree{
+		Value: 5,
+		Left: &IntBinaryTree{
+			Value: 8,
+			Left:  &IntBinaryTree{Value: -10},
+		},
+	}
+
+	if got := RootToLeafTarget(root, 3); !got {
+		t.Fatalf("expected a root-to-leaf path containing a negative value to sum to 3")
+	}
+}
