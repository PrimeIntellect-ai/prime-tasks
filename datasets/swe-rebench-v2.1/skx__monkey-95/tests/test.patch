+// TestIssue94 tests #94 - that malformed regexps are caught
+func TestIssue94(t *testing.T) {
+	literal := `
+name = "Steve"
+
+if ( name ~= /+/i ) { puts( "Hello\n" ); }
+`
+	ev1 := testEval(literal)
+	if _, ok := ev1.(*object.Error); !ok {
+		t.Fatalf("Expected an evaluator error with a bogus regexp, got %T", ev1)
+	}
+
+	match := `
+name = "Steve"
+
+if (match( "+", name) ) { puts( "Hello\n" ); }
+`
+	ev2 := testEval(match)
+	if _, ok := ev2.(*object.Error); !ok {
+		t.Fatalf("Expected an evaluator error with a bogus regexp, got %T", ev2)
+	}
+}
