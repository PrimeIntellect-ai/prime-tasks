+const pluginPattern = /(?:^|\s)prettier-plugin-sh(?:@[^\s]+)?(?=\s|$)/;
+
+// Lists the install commands with the plugin name removed, ignoring any
+// command that only installed the plugin, so the snapshots describe the rest
+// of the dependency list regardless of where the plugin is installed.
+function installCommands() {
+	return mockExecaCommand.mock.calls
+		.map(([command, ...args]) => [
+			typeof command === "string" ? command.replace(pluginPattern, "") : command,
+			...args,
+		])
+		.filter(
+			([command]) =>
+				typeof command !== "string" ||
+				!/^pnpm add(\s+-D)?(\s+--offline)?$/.test(command),
+		);
+}
