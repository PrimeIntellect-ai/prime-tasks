+describe("createRootFiles", () => {
+	it("configures Prettier to use prettier-plugin-sh in the generated .prettierrc.json", async () => {
+		const files = await createRootFiles(options);
+		const prettierConfig = JSON.parse(files[".prettierrc.json"]) as {
+			plugins: string[];
+		};
+
+		expect(prettierConfig.plugins).toContain("prettier-plugin-sh");
+	});
+});
