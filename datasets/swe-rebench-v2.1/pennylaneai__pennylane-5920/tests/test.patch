+    def test_to_mat(self):
+        """Test that the matrix representation of FermiWord is correct."""
+
+        expected_mat = np.zeros((4, 4), dtype=complex)
+        expected_mat[2, 1] = 1.0
+
+        mat = fw1.to_mat()
+        assert np.allclose(mat, expected_mat)
+
+    def test_to_mat_error(self):
+        """Test that an error is raised if the requested matrix dimension is smaller than the
+        dimension inferred from the largest orbital index.
+        """
+        with pytest.raises(ValueError, match="n_orbitals cannot be smaller than 2"):
+            fw1.to_mat(n_orbitals=1)
+
+    def test_to_mat_sufficient_n_orbitals(self):
+        """Test that a sufficient explicit n_orbitals value is accepted and determines the
+        matrix dimension."""
+        mat_default = fw1.to_mat()
+        mat_explicit = fw1.to_mat(n_orbitals=2)
+        assert np.allclose(mat_explicit, mat_default)
+
+        mat_larger = fw1.to_mat(n_orbitals=3)
+        assert mat_larger.shape == (8, 8)
+        assert np.iscomplexobj(mat_larger)
+
+    def test_to_mat_anticommutation_relations(self):
+        """Test that the computed matrices satisfy the fermionic anticommutation relations."""
+        n = 3
+        dim = 2**n
+        identity = np.eye(dim, dtype=complex)
+        zero = np.zeros((dim, dim), dtype=complex)
+
+        creation = [FermiWord({(0, i): "+"}) for i in range(n)]
+        annihilation = [FermiWord({(0, i): "-"}) for i in range(n)]
+
+        for i in range(n):
+            for j in range(n):
+                a_i = annihilation[i].to_mat(n)
+                a_j = annihilation[j].to_mat(n)
+                adag_i = creation[i].to_mat(n)
+                adag_j = creation[j].to_mat(n)
+
+                # {a_i, a_j^dagger} = delta_ij I
+                expected = identity if i == j else zero
+                assert np.allclose(a_i @ adag_j + adag_j @ a_i, expected)
+
+                # {a_i, a_j} = 0
+                assert np.allclose(a_i @ a_j + a_j @ a_i, zero)
+
 
