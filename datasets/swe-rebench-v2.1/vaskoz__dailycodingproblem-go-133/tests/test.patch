+package day61
+
+import (
+	"testing"
+	"time"
+)
+
+var testcases = []struct {
+	x, y, expected uint
+}{
+	{2, 10, 1024},
+	{2, 1, 2},
+	{2, 0, 1},
+}
+
+func TestIntegerExponentiationBySquaring(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		if result := IntegerExponentiationBySquaring(tc.x, tc.y); result != tc.expected {
+			t.Errorf("Expected %v got %v", tc.expected, result)
+		}
+	}
+}
+
+// A linear-time repeated-multiplication implementation cannot practically
+// finish for this exponent, while a fast exponentiation implementation can.
+func TestIntegerExponentiationBySquaringIsFasterThanNaive(t *testing.T) {
+	const largeExponent = uint(1) << 50
+	done := make(chan uint)
+	go func() {
+		done <- IntegerExponentiationBySquaring(1, largeExponent)
+	}()
+	select {
+	case result := <-done:
+		if result != 1 {
+			t.Errorf("Expected 1 got %v", result)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("power computation did not finish for a large exponent")
+	}
+}
