+func TestIssuesService_Edit_stateReason(t *testing.T) {
+	client, mux, _, teardown := setup()
+	defer teardown()
+
+	wantReason := ""
+	mux.HandleFunc("/repos/o/r/issues/1", func(w http.ResponseWriter, r *http.Request) {
+		testMethod(t, r, "PATCH")
+		var payload map[string]interface{}
+		if err := json.NewDecoder(r.Body).Decode(&payload); err != nil {
+			t.Fatalf("failed to decode request body: %v", err)
+		}
+		if got := payload["state"]; got != "closed" {
+			t.Errorf("state = %v, want %v", got, "closed")
+		}
+		if got := payload["state_reason"]; got != wantReason {
+			t.Errorf("state_reason = %v, want %v", got, wantReason)
+		}
+		fmt.Fprint(w, `{"number":1}`)
+	})
+
+	ctx := context.Background()
+	for _, reason := range []string{"not_planned", "completed"} {
+		wantReason = reason
+		input := &IssueRequest{State: String("closed"), StateReason: String(reason)}
+		if _, _, err := client.Issues.Edit(ctx, "o", "r", 1, input); err != nil {
+			t.Errorf("Issues.Edit returned error for %q: %v", reason, err)
+		}
+	}
+}
