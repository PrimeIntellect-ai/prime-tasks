+func TestIssueRequest_GetStateReason(tt *testing.T) {
+	var zeroValue string
+	i := &IssueRequest{StateReason: &zeroValue}
+	if got := i.GetStateReason(); got != "" {
+		tt.Errorf("GetStateReason = %v, want %v", got, "")
+	}
+	i = &IssueRequest{StateReason: String("not_planned")}
+	if got := i.GetStateReason(); got != "not_planned" {
+		tt.Errorf("GetStateReason = %v, want %v", got, "not_planned")
+	}
+	i = &IssueRequest{}
+	if got := i.GetStateReason(); got != "" {
+		tt.Errorf("GetStateReason = %v, want %v", got, "")
+	}
+	i = nil
+	if got := i.GetStateReason(); got != "" {
+		tt.Errorf("GetStateReason = %v, want %v", got, "")
+	}
+}
