+def test_url_with_query_parameter() -> None:
+    # https://github.com/stac-utils/pystac-client/issues/522
+    expected_filter = {"eo:cloud_cover": {"eq": "a&b"}}
+    search = ItemSearch(url="http://pystac-client.test", query=expected_filter)
+    url = urllib.parse.urlparse(search.url_with_parameters())
+    query = urllib.parse.parse_qs(url.query)
+    assert json.loads(query["query"][0]) == expected_filter
