+// TestDeviceTypeUnmarshalNumeric verifies that a persisted container
+// configuration which records device types using the numeric form written by
+// older runc versions can still be loaded.
+func TestDeviceTypeUnmarshalNumeric(t *testing.T) {
+	// The device type is stored as a JSON number (the rune value of the
+	// device type character), as written by older runc versions.
+	persisted := `{"devices":[{"type":98,"major":8,"minor":0,"permissions":"rwm","allow":true}]}`
+
+	var config configs.Config
+	if err := json.Unmarshal([]byte(persisted), &config); err != nil {
+		t.Fatalf("unable to load persisted container configuration: %v", err)
+	}
+	if len(config.Devices) != 1 {
+		t.Fatalf("expected 1 device, got %d", len(config.Devices))
+	}
+	if got := config.Devices[0].Type; got != devices.BlockDevice {
+		t.Fatalf("expected device type %q, got %q", devices.BlockDevice, got)
+	}
+}
