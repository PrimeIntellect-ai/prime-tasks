+    it('Places the label range on the demangled symbol', () => {
+        // Regression test for https://github.com/compiler-explorer/compiler-explorer/issues/6083
+        // The mangled name also appears earlier in the line as part of a longer identifier, so the
+        // replacement shifts the position of the label.
+        const text = '.section .text._Z1fv,"axG",@progbits,_Z1fv,comdat';
+        const startCol = text.lastIndexOf('_Z1fv') + 1;
+        const result = {
+            asm: [
+                {text: '_Z1fv:'},
+                {text, labels: [{name: '_Z1fv', range: {startCol, endCol: startCol + '_Z1fv'.length}}]},
+            ],
+        };
+
+        const demangler = new DummyCppDemangler(cppfiltpath, new DummyCompiler(), ['-n']);
+
+        return Promise.all([
+            demangler
+                .process(result)
+                .then(output => {
+                    const line = output.asm[1];
+                    const label = unwrap(line.labels)[0];
+                    expect(label.name).toEqual('f()');
+                    expect(line.text.substring(label.range.startCol - 1, label.range.endCol - 1)).toEqual('f()');
+                })
+                .catch(catchCppfiltNonexistence),
+        ]);
+    });
+
