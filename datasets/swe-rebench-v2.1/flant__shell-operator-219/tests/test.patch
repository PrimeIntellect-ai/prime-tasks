+			return queue.TaskResult{Status: "Fail"}
+		}
+		retryingTask := &task.BaseTask{Id: "retry", FailureCount: 1024}
+		q.AddFirst(retryingTask)
+		q.Start()
+		<-taskHandled
+		time.Sleep(50 * time.Millisecond)
+		q.Stop()
+		return
+	}
+
+	child, err := os.StartProcess(os.Args[0], []string{os.Args[0], "-test.run=^TestRetrySchedulingAtHighAttemptCount$"}, &os.ProcAttr{
