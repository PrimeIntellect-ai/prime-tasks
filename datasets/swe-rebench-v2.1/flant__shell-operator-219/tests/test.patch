+		Files: []*os.File{os.Stdin, os.Stdout, os.Stderr},
+	})
+	if err != nil {
+		t.Fatalf("could not start retry scheduling check: %v", err)
+	}
+	state, err := child.Wait()
+	if err != nil {
+		t.Fatalf("retry scheduling process failed: %v", err)
+	}
