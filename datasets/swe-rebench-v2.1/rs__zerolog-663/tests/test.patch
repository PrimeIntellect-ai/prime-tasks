+func TestFloatingPointPrecision(t *testing.T) {
+	if got := zerolog.FloatingPointPrecision; got != -1 {
+		t.Fatalf("default FloatingPointPrecision = %d, want -1", got)
+	}
+	defer func() { zerolog.FloatingPointPrecision = -1 }()
+
+	zerolog.FloatingPointPrecision = 2
+
+	out := &bytes.Buffer{}
+	log := zerolog.New(out)
+	log.Info().Float64("f", 1.23456).Msg("")
+	if got, want := out.String(), `{"level":"info","f":1.23}`+"\n"; got != want {
+		t.Errorf("Float64: got %q, want %q", got, want)
+	}
+
+	out.Reset()
+	log = zerolog.New(out)
+	log.Info().Float32("f", 1.23456).Msg("")
+	if got, want := out.String(), `{"level":"info","f":1.23}`+"\n"; got != want {
+		t.Errorf("Float32: got %q, want %q", got, want)
+	}
+
+	out.Reset()
+	log = zerolog.New(out)
+	log.Info().Float64("f", 0).Msg("")
+	if got, want := out.String(), `{"level":"info","f":0.00}`+"\n"; got != want {
+		t.Errorf("Float64 zero: got %q, want %q", got, want)
+	}
+
+	oldUnit, oldInteger := zerolog.DurationFieldUnit, zerolog.DurationFieldInteger
+	defer func() {
+		zerolog.DurationFieldUnit = oldUnit
+		zerolog.DurationFieldInteger = oldInteger
+	}()
+	zerolog.DurationFieldUnit = time.Millisecond
+	zerolog.DurationFieldInteger = false
+	out.Reset()
+	log = zerolog.New(out)
+	log.Info().
+		Floats32("f32s", []float32{1.23456}).
+		Floats64("f64s", []float64{1.23456}).
+		Dur("d", 1234*time.Millisecond).
+		Durs("ds", []time.Duration{1234 * time.Millisecond}).
+		Msg("")
+	if got, want := out.String(), `{"level":"info","f32s":[1.23],"f64s":[1.23],"d":1234.00,"ds":[1234.00]}`+"\n"; got != want {
+		t.Errorf("slice and duration fields: got %q, want %q", got, want)
+	}
+}
