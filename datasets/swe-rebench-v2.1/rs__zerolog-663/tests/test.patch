+func TestAppendFloatsPrecision(t *testing.T) {
+	if got, want := string(enc.AppendFloats32([]byte{}, []float32{1.234, 5.678}, 1)), `[1.2,5.7]`; got != want {
+		t.Errorf("AppendFloats32: got %s, want %s", got, want)
+	}
+	if got, want := string(enc.AppendFloats64([]byte{}, []float64{1.234, 5.678}, 1)), `[1.2,5.7]`; got != want {
+		t.Errorf("AppendFloats64: got %s, want %s", got, want)
+	}
+}
+
+func TestAppendDurationPrecision(t *testing.T) {
+	if got, want := string(enc.AppendDuration([]byte{}, time.Second, time.Millisecond, false, 1)), `1000.0`; got != want {
+		t.Errorf("AppendDuration: got %s, want %s", got, want)
+	}
+	if got, want := string(enc.AppendDuration([]byte{}, time.Second, time.Millisecond, true, 1)), `1000`; got != want {
+		t.Errorf("AppendDuration int: got %s, want %s", got, want)
+	}
+	if got, want := string(enc.AppendDurations([]byte{}, []time.Duration{time.Second, 2 * time.Second}, time.Millisecond, false, 1)), `[1000.0,2000.0]`; got != want {
+		t.Errorf("AppendDurations: got %s, want %s", got, want)
+	}
