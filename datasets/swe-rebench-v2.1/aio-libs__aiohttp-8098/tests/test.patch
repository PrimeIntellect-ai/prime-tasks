+@pytest.mark.parametrize("ssl_option", (None, True), ids=("none", "true"))
+async def test_ssl_none_preserves_default_tls(
+    aiohttp_server, ssl_ctx, ssl_option
+) -> None:
+    async def handler(request):
+        return web.Response(text="secure")
+
+    app = web.Application()
+    app.router.add_get("/", handler)
+    server = await aiohttp_server(app, ssl=ssl_ctx)
+    connector = aiohttp.TCPConnector(ssl=ssl_option)
+
+    async with aiohttp.ClientSession(connector=connector) as session:
+        with pytest.raises(aiohttp.ClientConnectorCertificateError):
+            await session.get(server.make_url("/"))
+
+
+async def test_ssl_none_with_verify_ssl_false() -> None:
+    # ssl=None combined with verify_ssl=False must not raise (backwards compat).
+    conn = aiohttp.TCPConnector(ssl=None, verify_ssl=False)
+    assert isinstance(conn, aiohttp.TCPConnector)
+
+
 async def test_resolver_not_called_with_address_is_ip(loop) -> None:
