 import pytest
 
@@ -47,6 +48,53 @@ from .test_rsa import rsa_key_2048
 __all__ = ["rsa_key_2048"]
 
 
+def _ssh_string(data: bytes) -> bytes:
+    return struct.pack(">I", len(data)) + data
+
+
+def _ssh_mpint(value: int) -> bytes:
+    if value == 0:
+        return _ssh_string(b"")
+    encoded = value.to_bytes((value.bit_length() + 7) // 8, "big")
+    if encoded[0] & 0x80:
+        encoded = b"\x00" + encoded
+    return _ssh_string(encoded)
+
+
+def _build_rsa_ssh_private_key(
+    p: int, q: int, d: int, iqmp: int, e: int, n: int
+) -> bytes:
+    """Encode an unencrypted OpenSSH RSA private key from raw numbers."""
+    public_blob = _ssh_string(b"ssh-rsa") + _ssh_mpint(e) + _ssh_mpint(n)
+    private_blob = struct.pack(">II", 0x12345678, 0x12345678)
+    private_blob += _ssh_string(b"ssh-rsa")
+    private_blob += (
+        _ssh_mpint(n)
+        + _ssh_mpint(e)
+        + _ssh_mpint(d)
+        + _ssh_mpint(iqmp)
+        + _ssh_mpint(p)
+        + _ssh_mpint(q)
+    )
+    private_blob += _ssh_string(b"")
+    pad = 1
+    while len(private_blob) % 8 != 0:
+        private_blob += bytes([pad])
+        pad += 1
+    blob = b"openssh-key-v1\0"
+    blob += _ssh_string(b"none") + _ssh_string(b"none") + _ssh_string(b"")
+    blob += struct.pack(">I", 1)
+    blob += _ssh_string(public_blob)
+    blob += _ssh_string(private_blob)
+    encoded = base64.b64encode(blob).decode("ascii")
+    lines = [encoded[i : i + 70] for i in range(0, len(encoded), 70)]
+    return (
+        "-----BEGIN OPENSSH PRIVATE KEY-----\n"
+        + "\n".join(lines)
+        + "\n-----END OPENSSH PRIVATE KEY-----\n"
+    ).encode("ascii")
+
+
