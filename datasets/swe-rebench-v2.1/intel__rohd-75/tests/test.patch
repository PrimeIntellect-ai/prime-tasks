+///
+/// swizzle_test.dart
+/// Tests for swizzling values
+///
+/// 2022 January 6
+/// Author: Max Korbel <max.korbel@intel.com>
+///
+
+import 'package:rohd/rohd.dart';
+import 'package:test/test.dart';
+
+void main() {
+  group('LogicValues', () {
+    test('simple swizzle', () {
+      expect(
+          [LogicValues.fromString('10'), LogicValues.fromString('xz')]
+              .swizzle(),
+          equals(LogicValues.fromString('10xz')));
+    });
+
+    test('simple rswizzle', () {
+      expect(
+          [LogicValues.fromString('10'), LogicValues.fromString('xz')]
+              .rswizzle(),
+          equals(LogicValues.fromString('xz10')));
+    });
+
+    test('mixed-width swizzle preserves component bits', () {
+      expect(
+          [LogicValues.fromString('101'), LogicValues.fromString('z')]
+              .swizzle(),
+          equals(LogicValues.fromString('101z')));
+    });
+
+    test('mixed-width rswizzle preserves component bits', () {
+      expect(
+          [LogicValues.fromString('101'), LogicValues.fromString('z')]
+              .rswizzle(),
+          equals(LogicValues.fromString('z101')));
+    });
+  });
+}
