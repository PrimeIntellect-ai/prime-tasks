+    def test_variable_aggregation(self):
+        strategy = tf.distribute.MirroredStrategy(["CPU:0", "CPU:1"])
+
+        with strategy.scope():
+            x = np.random.random((4, 4))
+            v1 = backend.Variable(x, dtype="float32")
+            self.assertEqual(v1.aggregation, "mean")
+            self.assertEqual(v1.value.aggregation, tf.VariableAggregation.MEAN)
+
+            v2 = backend.Variable(x, dtype="float32", aggregation="sum")
+            self.assertEqual(v2.aggregation, "sum")
+            self.assertEqual(v2.value.aggregation, tf.VariableAggregation.SUM)
+
+            v3 = backend.Variable(x, dtype="float32", aggregation="none")
+            self.assertEqual(v3.aggregation, "none")
+            self.assertEqual(v3.value.aggregation, tf.VariableAggregation.NONE)
+
+            v4 = backend.Variable(
+                x, dtype="float32", aggregation="only_first_replica"
+            )
+            self.assertEqual(v4.aggregation, "only_first_replica")
+            self.assertEqual(
+                v4.value.aggregation, tf.VariableAggregation.ONLY_FIRST_REPLICA
+            )
+
+    def test_fit_update_is_independent_of_replica_count(self):
+        x = np.array([[-1.0], [0.0], [1.0], [2.0]], dtype="float32")
+        y = np.array(
+            [[0.5, -0.5], [1.0, 0.0], [-1.0, 1.0], [0.25, -0.25]],
+            dtype="float32",
+        )
+
+        def train_and_get_output(device_names):
+            strategy = tf.distribute.MirroredStrategy(device_names)
+            with strategy.scope():
+                inputs = layers.Input(shape=(1,))
+                outputs = layers.Dense(
+                    2,
+                    kernel_initializer="ones",
+                    bias_initializer="zeros",
+                )(inputs)
+                model = models.Functional(inputs, outputs)
+                model.compile(
+                    loss=tf.keras.losses.MeanSquaredError(reduction="sum"),
+                    optimizer="sgd",
+                )
+                before = model(x, training=False).numpy()
+                model.fit(x, y, batch_size=4, epochs=1, shuffle=False, verbose=0)
+                after = model(x, training=False).numpy()
+            return after - before
+
+        one_replica_change = train_and_get_output(["CPU:0"])
+        two_replica_change = train_and_get_output(["CPU:0", "CPU:1"])
+        self.assertAllClose(one_replica_change, two_replica_change, atol=1e-6)
+
+    def test_correctness_with_fit_and_evaluate(self):
+        strategy = tf.distribute.MirroredStrategy(["CPU:0", "CPU:1"])
+
+        with strategy.scope():
+            inputs = layers.Input(shape=(1,))
+            outputs = layers.Dense(10)(inputs)
+            model = models.Functional(inputs, outputs)
+            model.compile(loss="mse", optimizer="sgd")
+
+            batch_size = 12
+            x = np.random.uniform(-1, 1, (batch_size, 1)).astype("float32")
+            y = np.random.uniform(-1, 1, (batch_size, 10)).astype("float32")
+
+            y_pred = model.predict(x, batch_size=batch_size, verbose=0)
+            ground_truth = np.mean(np.square(y - y_pred))
+
+            eval_result = model.evaluate(
+                x, y, batch_size=batch_size, verbose=0
+            )
+            self.assertAllClose(ground_truth, eval_result, atol=1e-5)
+
+            model.fit(
+                x, y, batch_size=batch_size, epochs=1, verbose=0
+            )
