+// fakeSSHVersion places a fake `ssh` executable at the front of PATH that
+// reports the provided version output, so that the SSH client version
+// detection can be exercised deterministically.
+func fakeSSHVersion(t *testing.T, versionOutput string) {
+	t.Helper()
+
+	binDir := t.TempDir()
+	script := "#!/bin/sh\necho '" + versionOutput + "'\n"
+	if err := os.WriteFile(filepath.Join(binDir, "ssh"), []byte(script), 0o755); err != nil {
+		t.Fatalf("failed to create fake ssh executable: %v", err)
+	}
+
+	t.Setenv("PATH", binDir+string(os.PathListSeparator)+os.Getenv("PATH"))
+}
+
+// hasUnboundPubkeyAuthentication reports whether the generated configuration
+// sets PubkeyAuthentication to unbound, independent of directive whitespace.
+func hasUnboundPubkeyAuthentication(config []byte) bool {
+	for _, line := range strings.Split(string(config), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 0 {
+			continue
+		}
+
+		key, value, hasEquals := strings.Cut(fields[0], "=")
+		if key != "PubkeyAuthentication" {
+			continue
+		}
+		if hasEquals && value == "unbound" {
+			return true
+		}
+		if !hasEquals && len(fields) > 1 && fields[1] == "unbound" {
+			return true
+		}
+	}
+	return false
+}
+
+// TestAddSSHConfigUnboundGating verifies that the generated SSH client
+// configuration only enables the `unbound` PubkeyAuthentication value for
+// clients that support it (OpenSSH 8.9 and newer).
+func TestAddSSHConfigUnboundGating(t *testing.T) {
+	tests := []struct {
+		name          string
+		sshVersionOut string
+		wantUnbound   bool
+	}{
+		{
+			name:          "openssh 8.8 does not support unbound",
+			sshVersionOut: "OpenSSH_8.8p1, OpenSSL 1.1.1v  1 Aug 2023",
+			wantUnbound:   false,
+		},
+		{
+			name:          "openssh 8.9 supports unbound",
+			sshVersionOut: "OpenSSH_8.9p1 Ubuntu-3ubuntu0.3, OpenSSL 3.0.2 15 Mar 2022",
+			wantUnbound:   true,
+		},
+		{
+			name:          "openssh 9.0 supports unbound",
+			sshVersionOut: "OpenSSH_9.0p1, OpenSSL 1.1.1v  1 Aug 2023",
+			wantUnbound:   true,
+		},
+		{
+			name:          "unparseable version does not support unbound",
+			sshVersionOut: "not an openssh version",
+			wantUnbound:   false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			fakeSSHVersion(t, tt.sshVersionOut)
+
+			topoName := "sshtest-" + strings.ReplaceAll(tt.name, " ", "-")
+
+			topoFile := filepath.Join(t.TempDir(), "topo.yml")
+			if err := os.WriteFile(topoFile, []byte("name: "+topoName+"\n"), 0o644); err != nil {
+				t.Fatalf("failed to write topology file: %v", err)
+			}
+
+			topoPaths, err := types.NewTopoPaths(topoFile)
+			if err != nil {
+				t.Fatalf("failed to create topo paths: %v", err)
+			}
+			if err := topoPaths.SetLabDir(topoName); err != nil {
+				t.Fatalf("failed to set lab dir: %v", err)
+			}
+
+			ctrl := gomock.NewController(t)
+			defer ctrl.Finish()
+
+			n := mocknodes.NewMockNode(ctrl)
+			n.EXPECT().Config().Return(&types.NodeConfig{
+				LongName: "clab-" + topoName + "-node1",
+				Kind:     "sros",
+			}).AnyTimes()
+			n.EXPECT().GetSSHConfig().Return(&types.SSHConfig{
+				PubkeyAuthentication: types.PubkeyAuthValueUnbound,
+			}).AnyTimes()
+
+			c := &clab.CLab{
+				Config:    &clab.Config{Name: topoName},
+				TopoPaths: topoPaths,
+				Nodes:     map[string]nodes.Node{"node1": n},
+				Reg:       nodes.NewNodeRegistry(),
+			}
+
+			configPath := topoPaths.SSHConfigPath()
+			defer os.Remove(configPath)
+
+			if err := os.MkdirAll(filepath.Dir(configPath), 0o755); err != nil {
+				t.Fatalf("failed to create ssh config directory: %v", err)
+			}
+
+			if err := c.AddSSHConfig(); err != nil {
+				t.Fatalf("AddSSHConfig() error = %v", err)
+			}
+
+			content, err := os.ReadFile(configPath)
+			if err != nil {
+				t.Fatalf("failed to read generated ssh config %q: %v", configPath, err)
+			}
+
+			gotUnbound := hasUnboundPubkeyAuthentication(content)
+			if gotUnbound != tt.wantUnbound {
+				t.Errorf("generated ssh config unbound presence = %v, want %v; config:\n%s",
+					gotUnbound, tt.wantUnbound, content)
+			}
+		})
+	}
+}
