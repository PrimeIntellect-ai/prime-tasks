+@testset "Poisson offset" begin
+    grouseticks = DataFrame(dataset(:grouseticks))
+    grouseticks.ch = grouseticks.height .- mean(grouseticks.height)
+    form = only(gfms[:grouseticks])
+    without_offset = fit(MixedModel, form, grouseticks, Poisson(); fast=true)
+    with_offset = fit(
+        MixedModel, form, grouseticks, Poisson(); offset=ones(nrow(grouseticks)), fast=true
+    )
+    @test !isapprox(with_offset.β, without_offset.β; atol=1e-3)
+end
