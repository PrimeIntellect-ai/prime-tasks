+func TestZDBDecommissionReclaimsDataVolume(t *testing.T) {
+	require := require.New(t)
+
+	var client TestClient
+	var cache TestZDBCache
+	ctx := context.Background()
+	ctx = WithZBus(ctx, &client)
+	ctx = WithZDBMapping(ctx, &cache)
+
+	zdb := ZDB{
+		Size:     10,
+		Mode:     pkg.ZDBModeSeq,
+		Password: "pa$$w0rd",
+		DiskType: pkg.SSDDevice,
+		Public:   true,
+	}
+
+	reservation := Reservation{
+		ID:   "reservation-id",
+		User: "user",
+		Type: ZDBReservation,
+		Data: MustMarshal(t, zdb),
+	}
+
+	const containerID = "container-id"
+	cache.On("Get", reservation.ID).Return(containerID, true)
+
+	startFakeZDB(t, filepath.Join(socketDir(containerID), "zdb.sock"))
+
+	// The container has several mounts. The data volume is not the first
+	// one, so decommissioning must pick the mount whose target is /data.
+	client.On("Request", "container", zbus.ObjectID{Name: "container", Version: "0.0.1"},
+		"Inspect", "zdb", pkg.ContainerID(containerID)).
+		Return(pkg.Container{
+			Name: containerID,
+			Mounts: []pkg.MountInfo{
+				{
+					Source: "/etc/resolv.conf",
+					Target: "/etc/resolv.conf",
+				},
+				{
+					Source: "/mnt/sda/subovl1",
+					Target: "/data",
+				},
+			},
+		}, nil)
+
+	client.On("Request", "storage", zbus.ObjectID{Name: "storage", Version: "0.0.1"},
+		"Claim", "subovl1", zdb.Size).Return(nil)
+
+	err := zdbDecommission(ctx, &reservation)
+	require.NoError(err)
+
+	client.AssertCalled(t, "Request", "storage", zbus.ObjectID{Name: "storage", Version: "0.0.1"},
+		"Claim", "subovl1", zdb.Size)
+	client.AssertNotCalled(t, "Request", "storage", zbus.ObjectID{Name: "storage", Version: "0.0.1"},
+		"Claim", "resolv.conf", zdb.Size)
+}
