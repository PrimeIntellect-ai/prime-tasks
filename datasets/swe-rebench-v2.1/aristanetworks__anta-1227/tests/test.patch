+    def test_runner_usable_without_cli(self) -> None:
+        """Test that anta._runner can be imported and used without anta.cli."""
+        script = textwrap.dedent(
+            """
+            import importlib.abc
+            import sys
+
+            class _BlockCli(importlib.abc.MetaPathFinder):
+                def find_spec(self, fullname, path=None, target=None):
+                    if fullname == "anta.cli" or fullname.startswith("anta.cli."):
+                        raise ImportError(f"anta.cli is not available: {fullname}")
+                    return None
+
+            sys.meta_path.insert(0, _BlockCli())
+
+            import asyncio
+            from pathlib import Path
+
+            from anta._runner import AntaRunner
+            from anta.inventory import AntaInventory
+            from anta.catalog import AntaCatalog
+
+            data_dir = Path(sys.argv[1])
+            inventory = AntaInventory.parse(filename=data_dir / "test_inventory_with_tags.yml", username="anta", password="anta")
+            catalog = AntaCatalog.parse(filename=data_dir / "test_catalog_with_tags.yml")
+            asyncio.run(AntaRunner().run(inventory, catalog, dry_run=True))
+            assert "anta.cli" not in sys.modules
+            """
+        )
+        result = subprocess.run(
+            [sys.executable, "-c", script, str(DATA_DIR)],
+            capture_output=True,
+            text=True,
+            cwd=str(DATA_DIR.parent.parent),
+        )
+        assert result.returncode == 0, result.stderr
+
