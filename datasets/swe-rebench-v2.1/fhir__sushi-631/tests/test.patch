+import fs from 'fs-extra';
+import path from 'path';
+import temp from 'temp';
+import { IGExporter } from '../../src/ig';
+import { Package } from '../../src/export';
+import { FHIRDefinitions } from '../../src/fhirdefs';
+import { cloneDeep } from 'lodash';
+import { minimalConfig } from '../utils/minimalConfig';
+
+describe('IGExporter', () => {
+  temp.track();
+
+  describe('#include-contents', () => {
+    it('does not mutate Markdown include sources across repeated exports', () => {
+      const igDataPath = temp.mkdirSync('sushi-test-source');
+      const includesPath = path.join(igDataPath, 'input', 'includes');
+      fs.ensureDirSync(includesPath);
+      const sourceFile = path.join(includesPath, 'guide.md');
+      const originalContent = '# User-authored include\n\nKeep this content unchanged.\n';
+      fs.writeFileSync(sourceFile, originalContent);
+
+      const config = cloneDeep(minimalConfig);
+      delete config.template;
+      const pkg = new Package(config);
+
+      // Each exporter represents a fresh SUSHI run on the same project.
+      new IGExporter(pkg, new FHIRDefinitions(), igDataPath, true).export(igDataPath);
+      new IGExporter(pkg, new FHIRDefinitions(), igDataPath, true).export(igDataPath);
+
+      expect(fs.readFileSync(sourceFile, 'utf8')).toBe(originalContent);
+    });
+  });
+});
