+# AUTO-GENERATED by tools/checkspecs.py - DO NOT EDIT
+import gzip
+import os
+
+from .. import misc
+
+
+def test_Gzip_compress(tmp_path, monkeypatch):
+    gzip_interface = getattr(misc, "Gzip", None)
+    assert gzip_interface is not None
+    monkeypatch.chdir(tmp_path)
+    payload = b"nipype compression round trip"
+    in_file = tmp_path / "sample.nii"
+    in_file.write_bytes(payload)
+
+    result = gzip_interface(in_file=str(in_file), mode="compress").run()
+    out_file = result.outputs.out_file
+
+    assert out_file == str(tmp_path / "sample.nii.gz")
+    assert os.path.exists(out_file)
+    with gzip.open(out_file, "rb") as fh:
+        assert fh.read() == payload
+
+
+def test_Gzip_decompress(tmp_path, monkeypatch):
+    gzip_interface = getattr(misc, "Gzip", None)
+    assert gzip_interface is not None
+    monkeypatch.chdir(tmp_path)
+    payload = b"nipype compression round trip"
+    in_file = tmp_path / "sample.nii.gz"
+    with gzip.open(str(in_file), "wb") as fh:
+        fh.write(payload)
+
+    result = gzip_interface(in_file=str(in_file), mode="decompress").run()
+    out_file = result.outputs.out_file
+
+    assert out_file == str(tmp_path / "sample.nii")
+    assert os.path.exists(out_file)
+    with open(out_file, "rb") as fh:
+        assert fh.read() == payload
