+                    }
+                ],
+            },
+        )
+        requests_mock.get(url + "?token=bam", status_code=500)
+        stac_api_io = StacApiIO()
+        pages = list(stac_api_io.get_pages(url))
+        assert [request.url for request in requests_mock.request_history] == [url]
