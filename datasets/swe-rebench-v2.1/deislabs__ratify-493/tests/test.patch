+func TestPluginMain_VerifyReference_ResolvesStoreFromDefaultPluginDirectory(t *testing.T) {
+	configDir := t.TempDir()
+	t.Setenv("RATIFY_CONFIG", configDir)
+	defaultPluginDir := ratifyconfig.GetDefaultPluginPath()
+	if err := os.MkdirAll(defaultPluginDir, 0755); err != nil {
+		t.Fatalf("failed to create default plugin directory: %v", err)
+	}
+	pluginExecutable := filepath.Join(defaultPluginDir, "default-store")
+	if err := os.WriteFile(pluginExecutable, []byte("#!/bin/sh\nprintf \"%s\" \"{\\\"referrers\\\":[],\\\"nextToken\\\":\\\"\\\"}\"\n"), 0755); err != nil {
+		t.Fatalf("failed to create store plugin: %v", err)
+	}
+
+	verifyReference := func(_ *CmdArgs, subjectReference common.Reference, _ ocispecs.ReferenceDescriptor, store referrerstore.ReferrerStore) (*verifier.VerifierResult, error) {
+		if store.Name() != "default-store" {
+			t.Fatalf("expected default-store, got %s", store.Name())
+		}
+		result, err := store.ListReferrers(context.Background(), subjectReference, nil, "", nil)
+		if err != nil {
+			t.Fatalf("failed to invoke store plugin from the default directory: %v", err)
+		}
+		if len(result.Referrers) != 0 || result.NextToken != "" {
+			t.Fatalf("unexpected store plugin response: %#v", result)
+		}
+		return &verifier.VerifierResult{IsSuccess: true}, nil
+	}
+
+	environment := map[string]string{
+		plugin.CommandEnvKey: plugin.VerifyCommand,
+		plugin.VersionEnvKey: "1.0.0",
+		plugin.SubjectEnvKey: "localhost:5000/net-monitor:v1@sha256:a0fc570a245b09ed752c42d600ee3bb5b4f77bbd70d8898780b7ab43454530eb",
+	}
+	stdinData := fmt.Sprintf(`{"storeConfig":{"store":{"name":"default-store"},"pluginBinDirs":[%q]},"config":{"name":"skel-test-case"},"referenceDesc":{"artifactType":"test-type"}}`, defaultPluginDir)
+	stdout := &bytes.Buffer{}
+	pluginContext := &pcontext{
+		GetEnviron: func(key string) string { return environment[key] },
+		Stdin:      strings.NewReader(stdinData),
+		Stdout:     stdout,
+		Stderr:     &bytes.Buffer{},
+	}
+	if err := pluginContext.pluginMainCore("skel-test-case", "1.0.0", verifyReference, []string{"1.0.0"}); err != nil {
+		t.Fatalf("plugin execution failed: %v", err)
+	}
+	if !strings.Contains(stdout.String(), `"isSuccess":true`) {
+		t.Fatalf("plugin execution did not succeed: %s", stdout.String())
+	}
+}
