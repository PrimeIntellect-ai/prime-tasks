+func callPrepareMetricsPath(manager interface{}, mux *http.ServeMux, pattern string) error {
+	method := reflect.ValueOf(manager).MethodByName("PrepareMetricsPath")
+	if !method.IsValid() {
+		return fmt.Errorf("MetricsManager does not provide PrepareMetricsPath")
+	}
+	loggerType := reflect.TypeOf((*promhttp.Logger)(nil)).Elem()
+	wantInputs := []reflect.Type{reflect.TypeOf(mux), reflect.TypeOf(pattern), loggerType}
+	if method.Type().NumIn() != len(wantInputs) || method.Type().NumOut() != 1 {
+		return fmt.Errorf("PrepareMetricsPath has an unexpected signature")
+	}
+	for i, want := range wantInputs {
+		if method.Type().In(i) != want {
+			return fmt.Errorf("PrepareMetricsPath has an unexpected signature")
+		}
+	}
+	if method.Type().Out(0) != reflect.TypeOf((*error)(nil)).Elem() {
+		return fmt.Errorf("PrepareMetricsPath must return an error")
+	}
+	result := method.Call([]reflect.Value{reflect.ValueOf(mux), reflect.ValueOf(pattern), reflect.Zero(loggerType)})[0]
+	if result.IsNil() {
+		return nil
+	}
+	return result.Interface().(error)
+}
