+func TestPrepareMetricsPathDoesNotStartServer(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("process listener inspection is available on Linux")
+	}
+	before := selfListeningSocketInodes(t)
+
+	mgr := NewMetricsManager()
+	mux := http.NewServeMux()
+	if err := callPrepareMetricsPath(mgr, mux, "/metrics"); err != nil {
+		t.Fatalf("prepare metrics path: %v", err)
+	}
+	time.Sleep(100 * time.Millisecond)
+
+	after := selfListeningSocketInodes(t)
+	for inode := range after {
+		if !before[inode] {
+			t.Errorf("preparing a metrics path opened a TCP listener (socket %s)", inode)
+		}
+	}
+}
+
+func selfListeningSocketInodes(t *testing.T) map[string]bool {
+	t.Helper()
+	owned := make(map[string]bool)
+	fds, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		t.Fatalf("read process file descriptors: %v", err)
+	}
+	for _, fd := range fds {
+		target, err := os.Readlink("/proc/self/fd/" + fd.Name())
+		if err == nil && strings.HasPrefix(target, "socket:[") {
+			owned[strings.TrimSuffix(strings.TrimPrefix(target, "socket:["), "]")] = true
+		}
+	}
+
+	listeners := make(map[string]bool)
+	for _, table := range []string{"/proc/net/tcp", "/proc/net/tcp6"} {
+		contents, err := os.ReadFile(table)
+		if err != nil {
+			continue
+		}
+		for _, line := range strings.Split(string(contents), "\n")[1:] {
+			fields := strings.Fields(line)
+			if len(fields) > 9 && fields[3] == "0A" && owned[fields[9]] {
+				listeners[fields[9]] = true
+			}
+		}
+	}
+	return listeners
 }
 
