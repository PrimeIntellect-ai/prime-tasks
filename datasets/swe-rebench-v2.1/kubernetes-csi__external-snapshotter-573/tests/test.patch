+func TestSnapshotControllerHTTPRoutes(t *testing.T) {
+	timeout := time.AfterFunc(90*time.Second, func() { t.Error("controller endpoint test timed out") })
+	defer timeout.Stop()
+	api := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/apis/snapshot.storage.k8s.io/v1/volumesnapshots":
+			fmt.Fprint(w, `{"apiVersion":"snapshot.storage.k8s.io/v1","kind":"VolumeSnapshotList","metadata":{"resourceVersion":"1"},"items":[]}`)
+		case "/apis/snapshot.storage.k8s.io/v1/volumesnapshotclasses":
+			fmt.Fprint(w, `{"apiVersion":"snapshot.storage.k8s.io/v1","kind":"VolumeSnapshotClassList","metadata":{"resourceVersion":"1"},"items":[]}`)
+		case "/apis/snapshot.storage.k8s.io/v1/volumesnapshotcontents":
+			fmt.Fprint(w, `{"apiVersion":"snapshot.storage.k8s.io/v1","kind":"VolumeSnapshotContentList","metadata":{"resourceVersion":"1"},"items":[]}`)
+		default:
+			w.WriteHeader(http.StatusNotFound)
+			fmt.Fprint(w, `{"apiVersion":"v1","kind":"Status","status":"Failure","reason":"NotFound","code":404}`)
+		}
+	}))
+	defer api.Close()
+
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("reserve an HTTP endpoint: %v", err)
+	}
+	endpoint := listener.Addr().String()
+	if err := listener.Close(); err != nil {
+		t.Fatalf("release reserved HTTP endpoint: %v", err)
+	}
+
+	config := fmt.Sprintf(`apiVersion: v1
+kind: Config
+clusters:
+- cluster:
+    server: %s
+    insecure-skip-tls-verify: true
+  name: test
+contexts:
+- context:
+    cluster: test
+    user: test
+  name: test
+current-context: test
+users:
+- name: test
+  user: {}
+`, api.URL)
+	tempDir := t.TempDir()
+	kubeconfig := filepath.Join(tempDir, "kubeconfig")
+	if err := os.WriteFile(kubeconfig, []byte(config), 0600); err != nil {
+		t.Fatalf("write kubeconfig: %v", err)
+	}
+	binary := filepath.Join(tempDir, "snapshot-controller")
+	build := exec.Command("go", "build", "-o", binary, "../../cmd/snapshot-controller")
+	if output, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("build snapshot-controller: %v\n%s", err, output)
+	}
+
+	cmd := exec.Command(binary,
+		"--kubeconfig="+kubeconfig,
+		"--http-endpoint="+endpoint,
+		"--metrics-path=/snapshot-metrics",
+		"--leader-election=true")
+	var logs bytes.Buffer
+	cmd.Stdout = &logs
+	cmd.Stderr = &logs
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("start snapshot-controller: %v", err)
+	}
+	defer func() {
+		_ = cmd.Process.Kill()
+		_ = cmd.Wait()
+	}()
+
+	client := &http.Client{Timeout: time.Second}
+	deadline := time.Now().Add(5 * time.Second)
+	metricsURL := "http://" + endpoint + "/snapshot-metrics"
+	var metricsBody string
+	var metricsContentType string
+	var metricsStatus int
+	for time.Now().Before(deadline) {
+		response, requestErr := client.Get(metricsURL)
+		if requestErr == nil {
+			body, readErr := io.ReadAll(response.Body)
+			response.Body.Close()
+			if readErr == nil {
+				metricsBody = string(body)
+				metricsContentType = response.Header.Get("Content-Type")
+				metricsStatus = response.StatusCode
+				if metricsStatus == http.StatusOK {
+					break
+				}
+			}
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	if metricsStatus != http.StatusOK || (!strings.Contains(metricsContentType, "text/plain") && !strings.Contains(metricsContentType, "application/openmetrics-text") && !strings.Contains(metricsContentType, "application/vnd.google.protobuf")) {
+		t.Fatalf("configured metrics endpoint did not return Prometheus exposition (status %d, content type %q, body %q); controller output: %s", metricsStatus, metricsContentType, metricsBody, logs.String())
+	}
+
+	healthURL := "http://" + endpoint + "/healthz/leader-election"
+	var healthStatus int
+	for time.Now().Before(deadline) {
+		response, requestErr := client.Get(healthURL)
+		if requestErr == nil {
+			healthStatus = response.StatusCode
+			response.Body.Close()
+			if healthStatus != http.StatusNotFound {
+				break
+			}
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	if healthStatus == http.StatusNotFound || healthStatus == 0 {
+		t.Fatalf("leader-election health endpoint was unavailable (status %d); controller output: %s", healthStatus, logs.String())
+	}
+}
