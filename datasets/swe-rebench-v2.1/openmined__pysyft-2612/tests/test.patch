+def _wraps_large_precision(tensor):
+    """Return True if a LargePrecisionTensor appears in the wrapper chain."""
+    while hasattr(tensor, "child"):
+        if isinstance(tensor, LargePrecisionTensor):
+            return True
+        tensor = tensor.child
+    return isinstance(tensor, LargePrecisionTensor)
+
+
+def test_storage():
+    x = torch.tensor([1.0, 2.0, 3.0])
+    enlarged = x.fix_prec(storage="large")
+    # storage="large" must select the LargePrecisionTensor interpreter
+    assert _wraps_large_precision(enlarged)
+    restored = enlarged.float_precision()
+    # And now x and restored must be the same
+    assert torch.all(torch.eq(x, restored))
+
