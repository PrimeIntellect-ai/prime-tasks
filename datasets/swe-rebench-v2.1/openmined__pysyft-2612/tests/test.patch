+def test_float_prec_alias():
+    x = torch.tensor([-2.0, 4.0])
+    fixed = x.fix_prec(storage="large")
+    restored = fixed.float_prec()
+    assert isinstance(restored, torch.Tensor)
+    assert torch.all(torch.eq(x, restored))
