diff --git a/tests/unit/tasks/addon-install-test.js b/tests/unit/tasks/addon-install-test.js
new file mode 100644
index 00000000..8be6236b
--- /dev/null
+++ b/tests/unit/tasks/addon-install-test.js
@@ -0,0 +1,201 @@
+'use strict';
+
+var AddonInstallTask = require('../../../lib/tasks/addon-install');
+var MockProject      = require('../../helpers/mock-project');
+var expect           = require('chai').expect;
+var CoreObject       = require('core-object');
+var Promise          = require('rsvp').Promise;
+
+describe('addon install task', function() {
+  var ui;
+  var project;
+
+  beforeEach(function() {
+    ui = {
+      startProgress: function() {
+
+      },
+      stopProgress: function() {
+
+      },
+      writeLine: function() {
+
+      }
+    };
+  });
+
+  afterEach(function() {
+    // ui.stopProgress();
+    ui = undefined;
+    project = undefined;
+  });
+
+  describe('when no save flag specified in blueprintOptions', function() {
+    it('calls npm install with --save-dev as a default', function(done) {
+      var MockNpmInstallTask = CoreObject.extend({
+        run: function(options) {
+          expect(options.save).to.not.be.true;
+          expect(options['save-dev']).to.be.true;
+          done();
+          return Promise.resolve();
+        }
+      });
+
+      var addonInstallTask = new AddonInstallTask({
+        ui: ui,
+        project: project,
+        NpmInstallTask: MockNpmInstallTask
+      });
+
+      addonInstallTask.run({});
+    });
+  });
+
+  describe('when save flag specified in blueprintOptions', function() {
+    it('calls npm install with --save', function(done) {
+      var MockNpmInstallTask = CoreObject.extend({
+        run: function(options) {
+          expect(options.save).to.be.true;
+          expect(options['save-dev']).to.not.be.true;
+          done();
+          return Promise.resolve();
+        }
+      });
+
+      var addonInstallTask = new AddonInstallTask({
+        ui: ui,
+        project: project,
+        NpmInstallTask: MockNpmInstallTask
+      });
+
+      addonInstallTask.run({
+        blueprintOptions: {
+          save: true
+        }
+      });
+    });
+  });
+
+  describe('when saveDev flag specified in blueprintOptions', function() {
+    it('calls npm install with --save-dev', function(done) {
+      var MockNpmInstallTask = CoreObject.extend({
+        run: function(options) {
+          expect(options.save).to.not.be.true;
+          expect(options['save-dev']).to.be.true;
+          done();
+          return Promise.resolve();
+        }
+      });
+
+      var addonInstallTask = new AddonInstallTask({
+        ui: ui,
+        project: project,
+        NpmInstallTask: MockNpmInstallTask
+      });
+
+      addonInstallTask.run({
+        blueprintOptions: {
+          saveDev: true
+        }
+      });
+    });
+  });
+
+  describe('when both save and saveDev flag specified in blueprintOptions', function() {
+    it('calls npm install with --save', function(done) {
+      var MockNpmInstallTask = CoreObject.extend({
+        run: function(options) {
+          expect(options.save).to.be.true;
+          expect(options['save-dev']).to.not.be.true;
+          done();
+          return Promise.resolve();
+        }
+      });
+
+      var addonInstallTask = new AddonInstallTask({
+        ui: ui,
+        project: project,
+        NpmInstallTask: MockNpmInstallTask
+      });
+
+      addonInstallTask.run({
+        blueprintOptions: {
+          save: true,
+          saveDev: true
+        }
+      });
+    });
+  });
+  describe('when installing a versioned addon', function() {
+    it('loads the addon by its package name after installation', function() {
+      var installed = false;
+      var blueprintRan = false;
+      var project = {
+        reloadAddons: function() {
+          installed = true;
+          return Promise.resolve();
+        },
+        findAddonByName: function(name) {
+          if (installed && name === 'ember-cli-eslint') {
+            return { pkg: {} };
+          }
+        }
+      };
+      var MockNpmInstallTask = CoreObject.extend({
+        run: function() {
+          return Promise.resolve();
+        }
+      });
+      var MockBlueprintTask = CoreObject.extend({
+        run: function() {
+          blueprintRan = true;
+          return Promise.resolve();
+        }
+      });
+      var addonInstallTask = new AddonInstallTask({
+        ui: ui,
+        project: project,
+        NpmInstallTask: MockNpmInstallTask,
+        BlueprintTask: MockBlueprintTask
+      });
+
+      return addonInstallTask.run({ packages: ['ember-cli-eslint@^1.7.0'] }).then(function() {
+        expect(blueprintRan).to.be.true;
+      });
+    });
+  });
+
+  describe('when run completes', function() {
+    it('resolves after npm install completes and the project addons are reloaded', function() {
+      var npmInstallCompleted = false;
+      var reloadedAfterNpmInstall = false;
+
+      var MockNpmInstallTask = CoreObject.extend({
+        run: function() {
+          return new Promise(function(resolve) {
+            setTimeout(function() {
+              npmInstallCompleted = true;
+              resolve();
+            }, 5);
+          });
+        }
+      });
+
+      project = {
+        reloadAddons: function() {
+          reloadedAfterNpmInstall = npmInstallCompleted;
+        }
+      };
+
+      var addonInstallTask = new AddonInstallTask({
+        ui: ui,
+        project: project,
+        NpmInstallTask: MockNpmInstallTask
+      });
+
+      return addonInstallTask.run({ packages: [] }).then(function() {
+        expect(reloadedAfterNpmInstall).to.be.true;
+      });
+    });
+  });
+});
