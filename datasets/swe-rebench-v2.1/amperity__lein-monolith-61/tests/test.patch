diff --git a/test/lein_monolith/dependency_test.clj b/test/lein_monolith/dependency_test.clj
index 59b1e93..30cc149 100644
--- a/test/lein_monolith/dependency_test.clj
+++ b/test/lein_monolith/dependency_test.clj
@@ -1,5 +1,6 @@
 (ns lein-monolith.dependency-test
   (:require
+    [clojure.string :as str]
     [clojure.test :refer [deftest testing is]]
     [lein-monolith.dependency :as dep]))
 
@@ -70,11 +71,42 @@
   (let [deps {:a #{}, :b #{:a}, :c #{:a}, :d #{:b :c}}]
     (is (= #{:a :b :c :d} (dep/downstream-keys deps :a)))))
 
-
 (deftest topological-sorting
   (let [deps {:a #{}, :b #{:a}, :c #{:a :b} :x #{:b} :y #{:c}}]
     (is (= [:a :b :c :x :y] (dep/topological-sort deps)))
     (is (= [:b :c :x] (dep/topological-sort deps [:x :c :b]))))
   (let [deps {:a #{:b}, :b #{:c}, :c #{:a}}]
-    (is (thrown-with-msg? Exception #"cycle detected"
-          (dep/topological-sort deps)))))
+    (is (thrown? Exception (dep/topological-sort deps)))))
+
+(deftest cycle-error-identifies-only-cycle-projects
+  (let [deps {"cycle-a" #{"cycle-b"}
+              "cycle-b" #{"cycle-c"}
+              "cycle-c" #{"cycle-a"}
+              "extra-d" #{"cycle-a"}
+              "extra-e" #{"extra-d"}}
+        error (try
+                (dep/topological-sort deps)
+                nil
+                (catch Exception e e))
+        msg (or (some-> error .getMessage) "")]
+    (is (some? error) "A cyclic dependency graph must fail")
+    (doseq [project ["cycle-a" "cycle-b" "cycle-c"]]
+      (is (str/includes? msg (pr-str project))
+          (str "Cycle project " (pr-str project) " missing from message: " msg)))
+    (doseq [project ["extra-d" "extra-e"]]
+      (is (not (str/includes? msg (pr-str project)))
+          (str "Non-cycle project " (pr-str project) " appears in message: " msg)))))
+
+(deftest cycle-error-prints-keyword-project-names
+  (let [deps {:a #{:b}
+              :b #{:c}
+              :c #{:a}}
+        error (try
+                (dep/topological-sort deps)
+                nil
+                (catch Exception e e))
+        msg (or (some-> error .getMessage) "")]
+    (is (some? error) "A cyclic dependency graph must fail")
+    (doseq [project [:a :b :c]]
+      (is (str/includes? msg (pr-str project))
+          (str "Cycle project " (pr-str project) " missing from message: " msg)))))
