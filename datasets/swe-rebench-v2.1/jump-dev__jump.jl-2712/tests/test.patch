+# Check that `f` throws an `ErrorException` whose message reports the
+# non-constant interval sides. The contract only requires the message to
+# contain the shared wording; the trailing clause is allowed to vary.
+function _test_interval_error_message(f::Function)
+    err = try
+        f()
+        nothing
+    catch e
+        e
+    end
+    @test err isa ErrorException
+    @test occursin(
+        "Interval constraint contains non-constant left- or right-hand " *
+        "sides. Reformulate as two separate constraints",
+        sprint(showerror, err),
+    )
+    return
+end
+
 @testset "Check Julia generator expression parsing" begin
     sumexpr = :(sum(x[i, j] * y[i, j] for i = 1:N, j in 1:M if i != j))
     @test sumexpr.head == :call
@@ -998,6 +1017,31 @@ end
         @test obj.set == MOI.Integer()
         @test_throws ErrorException add_to_function_constant(c, 1.0)
     end
+
+    @testset "Interval errors" begin
+        model = Model()
+        @variable(model, x)
+        _test_interval_error_message(() -> @NLconstraint(model, x <= x <= 2x))
+    end
+
+    @testset "Interval_errors_lhs" begin
+        model = Model()
+        @variable(model, x)
+        _test_interval_error_message(() -> @constraint(model, x <= x <= 2))
+    end
+
+    @testset "Interval_errors_rhs" begin
+        model = Model()
+        @variable(model, x)
+        _test_interval_error_message(() -> @constraint(model, 2 <= x <= x))
+    end
+
+    @testset "Interval_errors_lhs_and_rhs" begin
+        model = Model()
+        @variable(model, x)
+        _test_interval_error_message(() -> @constraint(model, x <= x <= x))
+        _test_interval_error_message(() -> @constraint(model, x <= 2x <= 3x))
+    end
 end
 
