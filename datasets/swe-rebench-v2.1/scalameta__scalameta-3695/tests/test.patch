+  test("indented if branches with trailing comments retain block nodes") {
+    val cases = List(
+      ("""|object x:
+         |  val a =
+         |    if cond then
+         |      fx
+         |      // c1
+         |    else
+         |      gx
+         |      // c2
+         |""".stripMargin, true, true, false),
+      ("""|object x:
+         |  val a =
+         |    if cond then
+         |      fx
+         |      // c1
+         |    else
+         |      gx
+         |    // c2
+         |""".stripMargin, true, false, true),
+      ("""|object y:
+         |  val a =
+         |    if cond then
+         |      fx
+         |      // c1
+         |    else
+         |      gx
+         |      // c2""".stripMargin, true, true, false),
+      ("""|object y:
+         |  val a =
+         |    if cond then
+         |      fx
+         |      // c1
+         |    else
+         |      gx
+         |    // c2""".stripMargin, true, false, true),
+      ("""|object y {
+         |  val a =
+         |    if cond then
+         |      fx
+         |      // c1
+         |    else
+         |      gx
+         |    // c2
+         |}""".stripMargin, true, false, true),
+      ("""|object y {
+         |  val a =
+         |    if cond then
+         |      fx
+         |      // c1
+         |    else
+         |      gx
+         |    /* c2 */}""".stripMargin, true, false, true)
+    )
+
+    cases.foreach { case (source, blockThen, blockElse, blockAroundIf) =>
+      val tree = dialects.Scala3(source).parse[Stat].get
+      val ifs = tree.collect { case term: Term.If => term }
+      assertEquals(ifs.size, 1)
+      if (blockThen) assert(ifs.head.thenp.isInstanceOf[Term.Block])
+      if (blockElse) assert(ifs.head.elsep.isInstanceOf[Term.Block])
+      if (blockAroundIf) {
+        val enclosingBlocks = tree.collect {
+          case block: Term.Block if block.stats.exists(_.isInstanceOf[Term.If]) => block
+        }
+        assert(enclosingBlocks.nonEmpty)
+      }
+    }
+  }
 
