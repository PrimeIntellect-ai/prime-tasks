+    def test_pop2(self):
+        d = self.make_dict()
+        d.add('key', 'val1')
+        d.add('key2', 'val2')
+        d.add('key', 'val3')
+
+        self.assertEqual('val1', d.pop('key'))
+        self.assertEqual([('key2', 'val2'), ('key', 'val3')], list(d.items()))
+
+    def test_popone(self):
+        d = self.make_dict()
+        d.add('key', 'val1')
+        d.add('key2', 'val2')
+        d.add('key', 'val3')
+
+        self.assertEqual('val1', d.popone('key'))
+        self.assertEqual([('key2', 'val2'), ('key', 'val3')], list(d.items()))
+
+    def test_popone_default(self):
+        d = self.make_dict(other='val')
+
+        self.assertEqual('default', d.popone('key', 'default'))
+        self.assertIn('other', d)
+
+    def test_popone_raises(self):
+        d = self.make_dict(other='val')
+
+        with self.assertRaises(KeyError):
+            d.popone('key')
+
+        self.assertIn('other', d)
 
