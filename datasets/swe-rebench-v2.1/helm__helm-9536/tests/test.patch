+
+func TestInstallRelease_InvalidName(t *testing.T) {
+	instAction := installAction(t)
+	// A non-empty name that does not conform to the release name rules
+	// (uppercase characters are not allowed) must be rejected during install.
+	instAction.ReleaseName = "Invalid-Name"
+	vals := map[string]interface{}{}
+	_, err := instAction.Run(buildChart(), vals)
+	if err == nil {
+		t.Fatal("expected failure when an invalid name is specified")
+	}
 }
 
 func TestInstallRelease_WithNotes(t *testing.T) {
