diff --git a/src/constraints.jl b/src/constraints.jl
index 257ae0b61da..87c215371b6 100644
--- a/src/constraints.jl
+++ b/src/constraints.jl
@@ -682,6 +682,12 @@ function moi_add_to_function_constant(
     value,
 )
     set = MOI.get(model, MOI.ConstraintSet(), ci)
+    if !MOI.Utilities.supports_shift_constant(typeof(set))
+        error(
+            "Unable to add to function constant for constraint type " *
+            "$(typeof(ci))",
+        )
+    end
     new_set = MOIU.shift_constant(set, convert(Float64, -value))
     return MOI.set(model, MOI.ConstraintSet(), ci, new_set)
 end
diff --git a/src/macros.jl b/src/macros.jl
index 0ee068c8890..103a7295d28 100644
--- a/src/macros.jl
+++ b/src/macros.jl
@@ -487,9 +487,14 @@ function build_constraint(
     expr::Union{GenericAffExpr,GenericQuadExpr},
     set::MOI.AbstractScalarSet,
 )
