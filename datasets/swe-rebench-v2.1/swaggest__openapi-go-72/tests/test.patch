+//go:build go1.18
+// +build go1.18
+
+package openapi3_test
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"github.com/swaggest/openapi-go/openapi3"
+)
+
+func Test_GenericSchemaNamesContainNoBrackets(t *testing.T) {
+	reflector := openapi3.Reflector{}
+	reflector.Spec = &openapi3.Spec{Openapi: "3.0.3"}
+
+	type req[T any] struct {
+		Value T `json:"value"`
+	}
+	type resp[T any] struct {
+		Value T `json:"value"`
+	}
+
+	for _, test := range []struct {
+		path string
+		req  any
+		resp any
+	}{
+		{path: "/time", req: new(req[time.Time]), resp: new(resp[time.Time])},
+		{path: "/integer", req: new(req[int]), resp: new(resp[int])},
+	} {
+		oc, err := reflector.NewOperationContext(http.MethodPut, test.path)
+		require.NoError(t, err)
+		oc.AddReqStructure(test.req)
+		oc.AddRespStructure(test.resp)
+		require.NoError(t, reflector.AddOperation(oc))
+	}
+
+	actualJSON, err := json.Marshal(reflector.Spec)
+	require.NoError(t, err)
+	var document map[string]interface{}
+	require.NoError(t, json.Unmarshal(actualJSON, &document))
+
+	paths := document["paths"].(map[string]interface{})
+	require.Contains(t, paths, "/time")
+	require.Contains(t, paths, "/integer")
+	schemas := document["components"].(map[string]interface{})["schemas"].(map[string]interface{})
+	require.NotEmpty(t, schemas)
+	for name := range schemas {
+		require.NotContains(t, name, "[")
+		require.NotContains(t, name, "]")
+	}
+
+	var checkReferences func(interface{})
+	checkReferences = func(value interface{}) {
+		switch value := value.(type) {
+		case map[string]interface{}:
+			if ref, ok := value["$ref"].(string); ok {
+				require.NotContains(t, ref, "[")
+				require.NotContains(t, ref, "]")
+			}
+			for _, child := range value {
+				checkReferences(child)
+			}
+		case []interface{}:
+			for _, child := range value {
+				checkReferences(child)
+			}
+		}
+	}
+	checkReferences(document)
+}
+
