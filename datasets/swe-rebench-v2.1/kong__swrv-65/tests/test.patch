+    await tick(vm, 2)
+    expect(count).toBe(1)
+    vm.$destroy()
+  })
+
+  it('does not revalidate on focus while the key is falsy', async () => {
+    let count = 0
+    const vm = new Vue({
+      template: '<div></div>',
+      setup  () {
+        const key = ref('focus-key')
+        const { data } = useSWRV(() => key.value, resolvedKey => {
+          count++
+          return resolvedKey
+        })
+        return { key, data }
+      }
+    }).$mount()
+
+    expect(count).toBe(1)
+    vm.key = ''
+    await tick(vm, 2)
+    expect(count).toBe(1)
+
+    window.dispatchEvent(new Event('focus'))
+    await tick(vm, 2)
+    expect(count).toBe(1)
+    vm.$destroy()
+  })
