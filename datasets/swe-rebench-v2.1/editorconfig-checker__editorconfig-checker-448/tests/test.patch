+// TestUnmarshallingEmptyFormat verifies the public contract that an empty
+// `Format` field in a config file must not cause ECC to fail. It exercises the
+// config loading path instead of asserting a particular fallback value for
+// standalone unmarshalling, so any implementation that tolerates an empty
+// Format in a config is accepted.
+func TestUnmarshallingEmptyFormat(t *testing.T) {
+	dir := t.TempDir()
+	configPath := filepath.Join(dir, "config.json")
+	if err := os.WriteFile(configPath, []byte(`{"Format": ""}`), 0644); err != nil {
+		t.Fatalf("failed to write config file: %v", err)
+	}
+
+	c := config.NewConfig([]string{configPath})
+	if err := c.Parse(); err != nil {
+		t.Errorf("parsing a config with an empty Format field failed: %v", err)
+	}
+}
