@@ -538,4 +538,16 @@ final class BasicFormatTest: XCTestCase {
       expected: "Foo<T>.bar"
     )
   }
+
+  func testStringMemberAccessInInterpolatedStatementList() {
+    let statements = Parser.parse(source: "\"Swift Macro\".lowercased()").statements
+    let generated: DeclSyntax = """
+      func test1() {
+        \(raw: statements)
+      }
+      """
+
+    let output = generated.formatted(using: BasicFormat(indentationWidth: .spaces(4))).description
+    XCTAssertTrue(output.contains("\"Swift Macro\".lowercased()"), output)
+  }
 }
