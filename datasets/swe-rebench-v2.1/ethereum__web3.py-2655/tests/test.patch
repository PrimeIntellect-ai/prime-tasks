     parse_block_identifier_int,
 )
+from web3.providers.base import (
+    BaseProvider,
+)
+
+
+class _FixedBlockProvider(BaseProvider):
+    """
+    Minimal provider that reports a fixed block number for any block lookup.
+    """
+
+    def __init__(self, block_number: int) -> None:
+        self._block_number = block_number
+
+    def make_request(self, method, params):
+        if method in ("eth_getBlockByNumber", "eth_getBlockByHash"):
+            return {
+                "jsonrpc": "2.0",
+                "id": 1,
+                "result": {"number": hex(self._block_number)},
+            }
+        return {"jsonrpc": "2.0", "id": 1, "result": None}
+
+    def isConnected(self) -> bool:
+        return True
+
+
+def _web3_with_block_number(block_number: int = 0) -> Web3:
+    return Web3(_FixedBlockProvider(block_number))
 
 
