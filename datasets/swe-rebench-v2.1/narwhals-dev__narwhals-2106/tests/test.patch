+def test_fill_null_series_expression(constructor: Constructor) -> None:
+    if not any(backend in str(constructor) for backend in ("pandas", "polars")):
+        pytest.skip("Expression-valued fill is required for pandas and Polars")
+    data = {
+        "a": [0.0, None, 2.0, 3.0, 4.0],
+        "b": [1.0, None, None, 5.0, 3.0],
+        "c": [5.0, 2.0, None, 2.0, 1.0],
+    }
+    df = nw.from_native(constructor(data))
+
+    result = df.with_columns(nw.col("a").fill_null(nw.col("c")))
+    expected = {
+        "a": [0.0, 2, 2.0, 3.0, 4.0],
+        "b": [1.0, None, None, 5.0, 3.0],
+        "c": [5.0, 2.0, None, 2.0, 1.0],
+    }
+    assert_equal_data(result, expected)
+
