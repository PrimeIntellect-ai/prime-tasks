+    def test_nelder_mead_bounded(self):
+
+        class dummy_function(om.ExplicitComponent):
+            def setup(self):
+                self.add_input('x', val=0.)
+                self.add_output('y', val=0.)
+
+            def compute(self, inputs, outputs):
+                x = inputs['x']
+
+                outputs['y'] = 2*x + 1
+
+        model = om.Group()
+        model.add_subsystem('dummy_function',
+                            dummy_function(),
+                            promotes=['*'])
+        prob = om.Problem(model=model)
+
+        model.add_objective('y')
+        model.add_design_var('x', lower=0, upper=100)
+        model.set_input_defaults('x', 25)
+
+        driver = prob.driver = om.ScipyOptimizeDriver()
+        driver.options["optimizer"] = 'Nelder-Mead'
+
+        driver.options['debug_print'] = ['desvars',
+                                        'nl_cons', 'ln_cons', 'objs', 'totals']
+
+        prob.setup()
+
+        prob.run_driver()
+
+        y_out = prob.get_val('y')
+
+        assert_near_equal(y_out, 1.0, tolerance=1.0E-3)
+
+    def test_nelder_mead_honors_upper_bound(self):
+
+        class objective_component(om.ExplicitComponent):
+            def setup(self):
+                self.add_input('x', val=0.)
+                self.add_output('y', val=0.)
+
+            def compute(self, inputs, outputs):
+                outputs['y'] = -inputs['x']
+
+        model = om.Group()
+        model.add_subsystem('objective_component', objective_component(), promotes=['*'])
+        prob = om.Problem(model=model)
+        model.add_objective('y')
+        model.add_design_var('x', lower=0., upper=100.)
+        model.set_input_defaults('x', 25.)
+        prob.driver = om.ScipyOptimizeDriver()
+        prob.driver.options['optimizer'] = 'Nelder-Mead'
+
+        prob.setup()
+        prob.run_driver()
+
+        assert prob.get_val('x')[0] <= 100. + 1.e-8
+
 
 if __name__ == "__main__":
     unittest.main()
