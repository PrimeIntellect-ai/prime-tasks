+#[test]
+fn supertrait_method_priority_for_trait_object() {
+    check_types(
+        r#"
+//- minicore: from
+trait TryInto {
+    fn try_into(self) -> bool;
+}
+impl<T> TryInto for T {
+    fn try_into(self) -> bool { false }
+}
+
+trait Super {
+    fn try_into(&self, addition: i32) -> u32 { addition as u32 }
+}
+trait Trait: Super {}
+
+fn test(a: &dyn Trait) {
+    let _ = (&*a).try_into(1);
+      //^u32
+}
+        "#,
+    );
+}
