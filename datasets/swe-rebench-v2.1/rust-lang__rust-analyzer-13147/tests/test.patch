+#[test]
+fn placeholder_trait_method_priority_try_into() {
+    check_types(
+        r#"
+//- minicore: from
+trait TryInto {
+    fn try_into(self) -> bool;
+}
+impl<T> TryInto for T {
+    fn try_into(self) -> bool { false }
+}
+
+trait MyTrait {
+    fn try_into(&self, addition: i32) -> u32;
+}
+
+fn test<T: MyTrait>(a: &T) {
+    let _ = a.try_into(1);
+      //^u32
+}
+        "#,
+    );
+}
