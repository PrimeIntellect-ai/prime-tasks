+  @Test
+  fun testEnvironmentCredentialsUsedWhenServiceAccountNotSet() {
+    testProjectRoot.newFile("foo")
+    testProjectRoot.newFile("fakeInstrument.apk")
+    val srcDir = testProjectRoot.newFolder("src", "main", "java")
+    java.io.File(srcDir, "PrintEnv.java").writeText(
+        """
+        |public class PrintEnv {
+        |  public static void main(String[] args) {
+        |    System.out.println("FLADLE_CREDENTIAL_ENV=" + System.getenv("GOOGLE_APPLICATION_CREDENTIALS"));
+        |  }
+        |}
+        """.trimMargin()
+    )
+    writeBuildGradle(
+        """plugins {
+             |  id "java"
+             |  id "com.osacky.fladle"
+             |}
+             |
+             |fladle {
+             |  projectId = "foo-project"
+             |  debugApk = "foo"
+             |  instrumentationApk = "fakeInstrument.apk"
+             |}
+             |
+             |afterEvaluate {
+             |  tasks.getByName("execFlank") {
+             |    main = "PrintEnv"
+             |    classpath = sourceSets.main.runtimeClasspath
+             |  }
+             |}
+             |""".trimMargin()
+    )
+    val result = GradleRunner.create()
+        .withProjectDir(testProjectRoot.root)
+        .withPluginClasspath()
+        .withGradleVersion("5.3.1")
+        .withEnvironment(mapOf("GOOGLE_APPLICATION_CREDENTIALS" to "/tmp/ambient-cred.json"))
+        .withArguments("execFlank")
+        .build()
+    assertThat(result.output).contains("FLADLE_CREDENTIAL_ENV=/tmp/ambient-cred.json")
+  }
