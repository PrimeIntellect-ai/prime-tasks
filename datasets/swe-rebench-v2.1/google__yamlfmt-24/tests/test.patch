+package basic_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/google/yamlfmt/formatters/basic"
+)
+
+func TestNewWithConfigRetainsDefaultValues(t *testing.T) {
+	testCases := []struct {
+		name          string
+		configMap     map[string]interface{}
+		indent        int
+		documentStart bool
+	}{
+		{
+			name: "only indent specified",
+			configMap: map[string]interface{}{
+				"indent": 4,
+			},
+			indent: 4,
+		},
+		{
+			name: "only include_document_start specified",
+			configMap: map[string]interface{}{
+				"include_document_start": true,
+			},
+			indent:        2,
+			documentStart: true,
+		},
+	}
+
+	factory := basic.BasicFormatterFactory{}
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			formatter, err := factory.NewWithConfig(tc.configMap)
+			if err != nil {
+				t.Fatalf("expected factory to create formatter, got error: %v", err)
+			}
+			got, err := formatter.Format([]byte("root:\n  child: value\n"))
+			if err != nil {
+				t.Fatalf("expected formatting to succeed, got error: %v", err)
+			}
+			formatted := string(got)
+			childLine := "\n" + strings.Repeat(" ", tc.indent) + "child: value\n"
+			if !strings.Contains(formatted, childLine) {
+				t.Fatalf("expected nested key to use %d-space indentation, got: %q", tc.indent, formatted)
+			}
+			hasDocumentStart := strings.HasPrefix(formatted, "---\n")
+			if hasDocumentStart != tc.documentStart {
+				t.Fatalf("document-start marker presence was %t, expected %t: %q", hasDocumentStart, tc.documentStart, formatted)
+			}
+		})
+	}
+}
