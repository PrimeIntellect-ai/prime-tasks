+func setAndRestoreEnv(env map[string]string) func() {
+	type previousValue struct {
+		value string
+		set   bool
+	}
+	backup := map[string]previousValue{}
+	for k, v := range env {
+		value, set := os.LookupEnv(k)
+		backup[k] = previousValue{value: value, set: set}
+		os.Setenv(k, v)
+	}
+
+	return func() {
+		for k, v := range backup {
+			if v.set {
+				os.Setenv(k, v.value)
+			} else {
+				os.Unsetenv(k)
+			}
+		}
+	}
+}
