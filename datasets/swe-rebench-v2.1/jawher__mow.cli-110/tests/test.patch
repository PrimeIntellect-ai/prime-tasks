+func TestHelpDefaultValueIgnoresUserInput(t *testing.T) {
+	cases := []struct {
+		name          string
+		declaredValue string
+		params        []string
+		required      []string
+		forbidden     []string
+	}{
+		{
+			name:          "empty declared default",
+			declaredValue: "",
+			params:        []string{"vault", "-f", "abc.txt"},
+			required:      []string{"-f, --file"},
+			forbidden:     []string{"(default"},
+		},
+		{
+			name:          "non-empty declared default",
+			declaredValue: "default.txt",
+			params:        []string{"vault", "-f", "abc.txt"},
+			required:      []string{"-f, --file", `(default "default.txt")`},
+			forbidden:     []string{`(default "abc.txt")`},
+		},
+	}
+	for _, cas := range cases {
+		cas := cas
+		t.Run(cas.name, func(t *testing.T) {
+			var out, stdErr string
+			defer captureAndRestoreOutput(&out, &stdErr)()
+			defer ignoreExit()()
+
+			app := App("vault", "Password Keeper")
+			app.StringOpt("f file", cas.declaredValue, "Path to safe")
+			app.Command("list", "list accounts", func(cmd *Cmd) {})
+
+			_ = app.Run(cas.params)
+
+			for _, want := range cas.required {
+				require.Contains(t, stdErr, want)
+			}
+			for _, unwanted := range cas.forbidden {
+				require.NotContains(t, stdErr, unwanted)
+			}
+		})
+	}
+}
