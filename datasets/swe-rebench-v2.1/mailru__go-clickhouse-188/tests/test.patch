+func TestTraceContextPropagatedToClickHouseHTTPRequest(t *testing.T) {
+	requests := make(chan *http.Request, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests <- r
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	previousPropagator := otel.GetTextMapPropagator()
+	otel.SetTextMapPropagator(propagation.TraceContext{})
+	defer otel.SetTextMapPropagator(previousPropagator)
+
+	tracerProvider := trace.NewTracerProvider()
+	ctx, span := tracerProvider.Tracer("clickhouse-test").Start(context.Background(), "query")
+	defer span.End()
+	want := span.SpanContext()
+
+	db, err := sql.Open("chhttp", server.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if _, err = db.ExecContext(ctx, "SELECT 1"); err != nil {
+		t.Fatalf("sending query: %v", err)
+	}
+
+	var request *http.Request
+	select {
+	case request = <-requests:
+	case <-time.After(time.Second):
+		t.Fatal("ClickHouse did not receive the query")
+	}
+	propagatedCtx := propagation.TraceContext{}.Extract(context.Background(), propagation.HeaderCarrier(request.Header))
+	got := oteltrace.SpanFromContext(propagatedCtx).SpanContext()
+	if !got.IsValid() {
+		t.Fatal("ClickHouse request did not contain a valid trace context")
+	}
+	if got.TraceID() != want.TraceID() || got.SpanID() != want.SpanID() {
+		t.Fatalf("ClickHouse received trace %s / span %s; want trace %s / span %s", got.TraceID(), got.SpanID(), want.TraceID(), want.SpanID())
+	}
+}
