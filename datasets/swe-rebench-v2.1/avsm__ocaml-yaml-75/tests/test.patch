diff --git a/tests/test_emit.ml b/tests/test_emit.ml
index a49fc8e..2444222 100644
--- a/tests/test_emit.ml
+++ b/tests/test_emit.ml
@@ -22,6 +22,7 @@ let scalar ?anchor ?tag ?(plain_implicit = true) ?(quoted_implicit = false)
 
 let v () =
   S.emitter () >>= fun t ->
+  Gc.compact ();
   S.stream_start t `Utf8 >>= fun () ->
   S.document_start t >>= fun () ->
   S.sequence_start t >>= fun () ->
@@ -42,6 +43,17 @@ let v () =
   S.document_end t >>= fun () ->
   S.stream_end t >>= fun () ->
   Printf.printf "written: %d\n%!" (S.emitter_written t);
-  let r = S.emitter_buf t in
-  print_endline (Bytes.to_string r);
-  Ok ()
+  let _ = S.emitter_buf t in
+  let large =
+    `A
+      (List.init 10000 (fun i ->
+           `String (Printf.sprintf "%05d-%s" i (String.make 64 'x'))))
+  in
+  match Yaml.to_string ~len:1_000_000 large with
+  | Error _ as error -> error
+  | Ok output when String.length output <= 256 * 1024 ->
+      Error (`Msg "large YAML serialization was unexpectedly short")
+  | Ok output ->
+      (match Yaml.of_string output with
+      | Ok decoded when Yaml.equal large decoded -> Ok ()
+      | _ -> Error (`Msg "large YAML serialization did not round-trip"))
