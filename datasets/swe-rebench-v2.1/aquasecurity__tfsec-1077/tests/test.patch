+func Test_AZUDefaultActionOnNetworkRuleSetToDenyHasCriticalSeverity(t *testing.T) {
+	results := testutil.ScanHCL(`
+resource "azurerm_storage_account" "test" {
+  name                      = "test"
+  resource_group_name       = azurerm_resource_group.test
+  location                  = azurerm_resource_group.test
+  account_tier              = "Standard"
+  account_replication_type  = "LRS"
+  enable_https_traffic_only = true
+  min_tls_version           = "TLS1_2"
+}
+`, t)
+
+	for _, result := range results {
+		if result.RuleID == "azure-storage-default-action-deny" {
+			if result.Severity != severity.Critical {
+				t.Fatalf("expected critical severity, got %s", result.Severity)
+			}
+			return
+		}
+	}
+	t.Fatal("expected missing default action to produce a finding")
+}
