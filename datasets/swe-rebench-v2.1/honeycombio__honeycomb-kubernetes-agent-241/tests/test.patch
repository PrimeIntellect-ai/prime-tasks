+func TestGlobbing(t *testing.T) {
+	paths := []string{
+		"/var/log/*",
+		"*",
+		".",
+	}
+
+	for _, p := range paths {
+		t.Run(p, func(t *testing.T) {
+			oldfiles, err := filepath.Glob(p)
+			assert.NoError(t, err)
+
+			newfiles, err := doublestarGlob(p)
+			assert.NoError(t, err)
+
+			assert.Equal(t, oldfiles, newfiles)
+		})
+	}
+}
+
+func TestGlobbingRecursivePattern(t *testing.T) {
+	base, err := ioutil.TempDir("", "doublestar-glob-")
+	assert.NoError(t, err)
+	defer os.RemoveAll(base)
+
+	matchedPath := filepath.Join(base, "one", "two", "application.log")
+	assert.NoError(t, os.MkdirAll(filepath.Dir(matchedPath), 0755))
+	assert.NoError(t, ioutil.WriteFile(matchedPath, []byte("log\n"), 0644))
+	assert.NoError(t, ioutil.WriteFile(filepath.Join(base, "one", "two", "ignored.tmp"), []byte("tmp"), 0644))
+
+	matches, err := doublestarGlob(filepath.Join(base, "**", "*.log"))
+	assert.NoError(t, err)
+	assert.Equal(t, []string{matchedPath}, matches)
+}
