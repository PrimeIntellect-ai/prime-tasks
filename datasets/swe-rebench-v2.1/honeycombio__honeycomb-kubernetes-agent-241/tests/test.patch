+type emptyPodWatcher struct{}
+
+func (emptyPodWatcher) Get(types.UID) (*v1.Pod, bool) { return nil, false }
+func (emptyPodWatcher) Pods() chan *v1.Pod            { return nil }
+func (emptyPodWatcher) DeletedPods() chan types.UID   { return nil }
