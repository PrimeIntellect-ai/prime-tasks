+func TestWatcherAppliesConfiguredExclusions(t *testing.T) {
+	pod := &v1.Pod{}
+	pod.Namespace = "rebench"
+	pod.Name = fmt.Sprintf("exclude-%d", time.Now().UnixNano())
+	pod.UID = types.UID(fmt.Sprintf("%d", time.Now().UnixNano()))
+	podDir := filepath.Join("/var/log/pods", fmt.Sprintf("%s_%s_%s", pod.Namespace, pod.Name, pod.UID), "app")
+	if err := os.MkdirAll(podDir, 0755); err != nil {
+		t.Skipf("cannot create temporary pod log directory: %v", err)
+	}
+	defer os.RemoveAll(filepath.Dir(podDir))
+
+	includedPath := filepath.Join(podDir, "0.log")
+	excludedPath := filepath.Join(podDir, "1.log.tmp")
+	includedLine := `{"log":"{\"message\":\"included\"}\n","stream":"stdout","time":"2020-01-01T00:00:00Z"}` + "\n"
+	excludedLine := `{"log":"{\"message\":\"excluded\"}\n","stream":"stdout","time":"2020-01-01T00:00:00Z"}` + "\n"
+	if err := os.WriteFile(includedPath, []byte(includedLine), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(excludedPath, []byte(excludedLine), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	transmitter := &recordingTransmitter{events: make(chan *event.Event, 4)}
+	pt := &PodSetTailer{
+		config: &config.WatcherConfig{
+			Dataset:      "watcher-exclusion-test",
+			Parser:       &config.ParserConfig{Name: "json"},
+			ExcludePaths: []string{"**/*.tmp"},
+		},
+		transmitter: transmitter,
+	}
+	watcher, err := pt.watcherForPod(pod, "", emptyPodWatcher{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	watcher.Start()
+	defer watcher.Stop()
+
+	select {
+	case ev := <-transmitter.events:
+		if ev.Path != includedPath || ev.Data["message"] != "included" {
+			t.Fatalf("received unexpected event from %q: %#v", ev.Path, ev.Data)
+		}
+	case <-time.After(2500 * time.Millisecond):
+		t.Fatal("watcher did not process the non-excluded log")
+	}
+	select {
+	case ev := <-transmitter.events:
+		t.Fatalf("excluded file produced an event from %q", ev.Path)
+	case <-time.After(150 * time.Millisecond):
+	}
+}
