+// Issue 187
+func TestBasic_interfaceStructNonPtr(t *testing.T) {
+	t.Parallel()
+
+	input := map[string]interface{}{
+		"vstring": "foo",
+	}
+
+	var iface interface{} = Basic{}
+	err := Decode(input, &iface)
+	if err != nil {
+		t.Fatalf("got an err: %s", err)
+	}
+
+	expected := Basic{
+		Vstring: "foo",
+	}
+	if !reflect.DeepEqual(iface, expected) {
+		t.Fatalf("bad: %#v", iface)
+	}
+}
+
+func TestBasic_interfaceStructNonPtr_ErrorUnused(t *testing.T) {
+	t.Parallel()
+
+	input := map[string]interface{}{
+		"vstring": "foo",
+	}
+
+	var iface interface{} = Basic{}
+	decoder, err := NewDecoder(&DecoderConfig{
+		Result:      &iface,
+		ErrorUnused: true,
+	})
+	if err != nil {
+		t.Fatalf("could not create decoder: %s", err)
+	}
+	if err := decoder.Decode(input); err != nil {
+		t.Fatalf("decoding a key matching the concrete struct should succeed: %s", err)
+	}
+
+	expected := Basic{Vstring: "foo"}
+	if !reflect.DeepEqual(iface, expected) {
+		t.Fatalf("bad: %#v", iface)
+	}
+}
