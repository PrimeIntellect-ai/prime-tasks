+function isTypeScriptIdentifier(value: string) {
+  const source = ts.createSourceFile(
+    'identifier.ts',
+    `const ${value} = 0;`,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  return (
+    source.parseDiagnostics.length === 0 &&
+    source.statements.length === 1 &&
+    ts.isVariableStatement(source.statements[0]) &&
+    source.statements[0].declarationList.declarations.length === 1 &&
+    ts.isIdentifier(source.statements[0].declarationList.declarations[0].name)
+  );
+}
