+    expect(position('padding-top', '3px')).toBeGreaterThan(position('padding-right', '1rem'))
+    expect(position('color', 'green')).toBeGreaterThan(position('padding-top', '3px'))
+    expect(position('font-weight', '700')).toBeGreaterThan(position('color', 'green'))
   })
