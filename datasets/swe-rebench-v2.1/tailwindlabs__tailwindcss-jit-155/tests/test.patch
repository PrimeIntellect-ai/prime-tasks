+          rule.remove()
+        }
+      })
+      root.walkAtRules((atRule) => {
+        if (atRule.nodes && atRule.nodes.length === 0) {
+          atRule.remove()
+        }
+      })
+      return root.toString()
+    }
+
+    const smallerQuery = `@media (min-width: 640px) {
+  h2 {
+    font-size: 1.5rem;
+    line-height: 2rem;
+  }
+}`
+    const largerQuery = `@media (min-width: 1024px) {
+  h2 {
+    font-size: 1.5rem;
+    line-height: 2rem;
+  }
+}`
+    const alternateExpected = expected.replace(`${smallerQuery}
+${largerQuery}`, `${largerQuery}
+${smallerQuery}`)
+    const matchesExpected = [expected, alternateExpected].some((candidate) => {
+      try {
+        expect(withoutSiblingFixture(result.css)).toMatchCss(withoutSiblingFixture(candidate))
+        return true
+      } catch {
+        return false
+      }
+    })
+    expect(matchesExpected).toBe(true)
+
+    const output = postcss.parse(result.css)
+    const declarations = []
+    output.nodes.forEach((node) => {
+      if (node.type === 'rule' && node.selector === '.add-sibling-properties') {
+        node.walkDecls((declaration) => declarations.push([declaration.prop, declaration.value]))
+      }
+    })
+    const position = (prop, value) => declarations.findIndex(([actualProp, actualValue]) => actualProp === prop && actualValue === value)
