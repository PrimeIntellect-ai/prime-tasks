+// TestExternalTerminationRemovesLog runs lf on a pseudo terminal, terminates
+// it from outside as a window manager or a terminal closing would, and checks
+// that the client log file it created is removed.
+func TestExternalTerminationRemovesLog(t *testing.T) {
+	if _, err := exec.LookPath("script"); err != nil {
+		t.Skip("script utility is needed to run lf on a pseudo terminal")
+	}
+
+	u, err := user.Current()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	bin := filepath.Join(t.TempDir(), "lf")
+	if out, err := exec.Command("go", "build", "-o", bin, ".").CombinedOutput(); err != nil {
+		t.Fatalf("building lf: %s\n%s", err, out)
+	}
+
+	for _, sig := range []syscall.Signal{syscall.SIGHUP, syscall.SIGTERM} {
+		t.Run(sig.String(), func(t *testing.T) {
+			dir := t.TempDir()
+			// The directory name is shown by lf once it is drawn, which tells us
+			// that it is ready to handle signals.
+			probe := filepath.Join(dir, "readyprobe")
+			if err := os.Mkdir(probe, 0755); err != nil {
+				t.Fatal(err)
+			}
+			pidPath := filepath.Join(dir, "pid")
+
+			before := clientLogs(t, u.Username)
+
+			// Quit the server lf may have started for this run.
+			defer exec.Command(bin, "-remote", "quit").Run()
+
+			script := fmt.Sprintf("stty cols 80 rows 24; echo $$ > '%s'; exec '%s'", pidPath, bin)
+			cmd := exec.Command("script", "-qfec", script, "/dev/null")
+			cmd.Dir = probe
+			cmd.Env = append(os.Environ(), "TERM=xterm")
+			out := &syncBuffer{}
+			cmd.Stdout = out
+			cmd.Stderr = out
+			if err := cmd.Start(); err != nil {
+				t.Fatal(err)
+			}
+			waitErr := make(chan error, 1)
+			go func() { waitErr <- cmd.Wait() }()
+
+			var logPath string
+			var pid int
+			deadline := time.Now().Add(20 * time.Second)
+			for {
+				if time.Now().After(deadline) {
+					cmd.Process.Kill()
+					t.Fatalf("lf did not start; output: %q", out.String())
+				}
+				if pid == 0 {
+					if data, err := os.ReadFile(pidPath); err == nil {
+						if p, err := strconv.Atoi(strings.TrimSpace(string(data))); err == nil {
+							pid = p
+						}
+					}
+				}
+				if logPath == "" {
+					for p := range clientLogs(t, u.Username) {
+						if !before[p] {
+							logPath = p
+						}
+					}
+				}
+				if pid != 0 && logPath != "" && strings.Contains(out.String(), "readyprobe") {
+					break
+				}
+				time.Sleep(50 * time.Millisecond)
+			}
+			defer os.Remove(logPath)
+
+			proc, err := os.FindProcess(pid)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := proc.Signal(sig); err != nil {
+				t.Fatal(err)
+			}
+
+			select {
+			case <-waitErr:
+			case <-time.After(20 * time.Second):
+				cmd.Process.Kill()
+				t.Fatalf("lf did not exit after %s", sig)
+			}
+
+			if _, err := os.Stat(logPath); !os.IsNotExist(err) {
+				t.Errorf("log file %s was left behind after lf was terminated by %s", logPath, sig)
+			}
+		})
+	}
