+// syncBuffer collects the output of a process while it is being written.
+type syncBuffer struct {
+	mu sync.Mutex
+	b  bytes.Buffer
+}
+
+func (s *syncBuffer) Write(p []byte) (int, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.b.Write(p)
+}
+
+func (s *syncBuffer) String() string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.b.String()
+}
+
+// clientLogs returns the client log files lf currently has in the temporary
+// directory, keyed by path.
+func clientLogs(t *testing.T, username string) map[string]bool {
+	paths, err := filepath.Glob(filepath.Join(os.TempDir(), "lf."+username+".*.log"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	logs := make(map[string]bool)
+	prefix := "lf." + username + "."
+	for _, p := range paths {
+		id := strings.TrimSuffix(strings.TrimPrefix(filepath.Base(p), prefix), ".log")
+		if _, err := strconv.Atoi(id); err == nil {
+			logs[p] = true
+		}
+	}
+	return logs
+}
