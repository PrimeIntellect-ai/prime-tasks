+	attrBold      = 1 << 9
+	attrUnderline = 1 << 10
+	attrReverse   = 1 << 11
 )
 
+// callApplyAnsiCodes calls applyAnsiCodes with plain integer cell attributes
+// and returns the resulting foreground and background attributes as integers.
+func callApplyAnsiCodes(s string, fg, bg uint16) (uint16, uint16) {
+	fn := reflect.ValueOf(applyAnsiCodes)
+	attrType := fn.Type().In(1)
+	out := fn.Call([]reflect.Value{
+		reflect.ValueOf(s),
+		reflect.ValueOf(fg).Convert(attrType),
+		reflect.ValueOf(bg).Convert(attrType),
+	})
+	return uint16(out[0].Uint()), uint16(out[1].Uint())
+}
