+package main
+
+import (
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// buildNancy compiles the nancy command into a temporary directory and returns
+// the path to the resulting executable.
+func buildNancy(t *testing.T) string {
+	t.Helper()
+	bin := filepath.Join(t.TempDir(), "nancy")
+	cmd := exec.Command("go", "build", "-o", bin, ".")
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("failed to build nancy: %v\n%s", err, out)
+	}
+	return bin
+}
+
+// TestBadArgs verifies that passing an unrecognized flag does not panic and is
+// reported to the user instead.
+func TestBadArgs(t *testing.T) {
+	bin := buildNancy(t)
+
+	for _, badFlag := range []string{"-q", "-bad"} {
+		cmd := exec.Command(bin, badFlag)
+		out, err := cmd.CombinedOutput()
+		sout := string(out)
+		if strings.Contains(sout, "panic") {
+			t.Errorf("nancy panicked on invalid flag %q: %s", badFlag, sout)
+		}
+		if err == nil {
+			t.Errorf("expected a non-zero exit status for invalid flag %q, got success: %s", badFlag, sout)
+		}
+	}
+
+	// The offending flag must be identified in the diagnostic. "-bad" is used
+	// because its name does not appear in the usage text.
+	cmd := exec.Command(bin, "-bad")
+	out, _ := cmd.CombinedOutput()
+	if !strings.Contains(string(out), "bad") {
+		t.Errorf("the invalid flag was not reported: %s", out)
+	}
+}
