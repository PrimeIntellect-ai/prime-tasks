+
+    #[test]
+    fn from_json_reports_parse_errors() {
+        assert!(matches!(
+            crate::from_json::<u64>("not JSON"),
+            Err(crate::StdError::ParseErr { .. })
+        ));
+        assert!(matches!(
+            crate::from_json::<u64>("\"not a number\""),
+            Err(crate::StdError::ParseErr { .. })
+        ));
+    }
+
+    #[test]
+    fn to_json_string_reports_serialization_errors() {
+        struct Unserializable;
+
+        impl serde::Serialize for Unserializable {
+            fn serialize<S>(&self, _serializer: S) -> Result<S::Ok, S::Error>
+            where
+                S: serde::Serializer,
+            {
+                Err(serde::ser::Error::custom("intentional serialization failure"))
+            }
+        }
+
+        let error = crate::to_json_string(&Unserializable).unwrap_err();
+        assert!(
+            matches!(error, crate::StdError::SerializeErr { .. }),
+            "Expected a serialization error, got {error:?}"
+        );
+    }
+
+    #[test]
+    fn json_supports_floating_point_numbers() {
+        // JSON serialization and deserialization support floating point numbers.
+        let value = 1.5f64;
+        let serialized = crate::to_json_string(&value).unwrap();
+        let deserialized: f64 = crate::from_json(&serialized).unwrap();
+        assert_eq!(deserialized, value);
+
+        let value = -2.25f32;
+        let serialized = crate::to_json_string(&value).unwrap();
+        let deserialized: f32 = crate::from_json(&serialized).unwrap();
+        assert_eq!(deserialized, value);
+
+        let deserialized: f64 = crate::from_json("1.5").unwrap();
+        assert_eq!(deserialized, 1.5);
+    }
 }
