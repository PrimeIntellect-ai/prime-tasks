 import cartopy.mpl.patch as cpatch
 
 
@@ -43,3 +46,46 @@ class Test_path_to_geos:
         geoms = cpatch.path_to_geos(p)
         assert [type(geom) for geom in geoms] == [sgeom.Polygon, sgeom.Point]
         assert len(geoms[0].interiors) == 1
+
+    def test_nested_polygons(self):
+        # A geometry with three nested squares.
+        vertices = [[0, 0], [0, 10], [10, 10], [10, 0], [0, 0],
+                    [2, 2], [2, 8], [8, 8], [8, 2], [2, 2],
+                    [4, 4], [4, 6], [6, 6], [6, 4], [4, 4]]
+        codes = [1, 2, 2, 2, 79, 1, 2, 2, 2, 79, 1, 2, 2, 2, 79]
+        p = Path(vertices, codes=codes)
+        geoms = cpatch.path_to_geos(p)
+
+        # The innermost square is a separate island inside the outer
+        # polygon's hole.  Geometry list order is not significant.
+        assert len(geoms) == 2
+        assert all(isinstance(geom, sgeom.Polygon) for geom in geoms)
+        polygons_with_holes = [geom for geom in geoms if geom.interiors]
+        islands = [geom for geom in geoms if not geom.interiors]
+        assert len(polygons_with_holes) == 1
+        assert len(polygons_with_holes[0].interiors) == 1
+        assert len(islands) == 1
+        hole = sgeom.Polygon(polygons_with_holes[0].interiors[0])
+        assert hole.contains(islands[0])
+
+def test_contourf_nested_contours():
+    # Regression test for GH#2224: filled contours whose paths contain
+    # nested rings must transform to valid geometries so that the plot
+    # renders correctly.
+    x = np.linspace(-3, 3, 100)
+    y = np.linspace(-3, 3, 100)
+    xx, yy = np.meshgrid(x, y)
+    radius = np.hypot(xx, yy)
+    data = np.cos(radius * 3) * np.exp(-radius**2 / 4)
+
+    fig, ax = plt.subplots(subplot_kw=dict(projection=ccrs.PlateCarree()))
+    try:
+        cs = ax.contourf(x, y, data, levels=np.linspace(-1, 1, 9),
+                         transform=ccrs.PlateCarree())
+        transform = cs.get_transform()
+        for path in cs.get_paths():
+            geoms = cpatch.path_to_geos(transform.transform_path(path))
+            assert geoms
+            assert all(geom.is_valid for geom in geoms)
+    finally:
+        plt.close(fig)
