+fn check_fn_type_alias_output(before: &str, expected_alias_parts: &[&str], expected_function: &str) {
+    let (db, file_id, selection) = crate::RootDatabase::with_range_or_offset(before);
+    let before = db.file_text(file_id.file_id()).to_string();
+    let range = hir::FileRange { file_id, range: selection.into() };
+    let actuals = crate::assists(
+        &db,
+        &super::TEST_CONFIG,
+        crate::AssistResolveStrategy::All,
+        range.into(),
+    )
+    .into_iter()
+    .filter_map(|assist| {
+        let change = assist.source_change?;
+        let (edit, snippet_edit) = change.get_source_and_snippet_edit(file_id.file_id())?;
+        let mut actual = before.clone();
+        edit.apply(&mut actual);
+        if let Some(snippet_edit) = snippet_edit {
+            snippet_edit.apply(&mut actual);
+        }
+        Some(actual)
+    })
+    .collect::<Vec<_>>();
+    assert!(
+        actuals.iter().any(|actual| {
+            expected_alias_parts.iter().all(|part| actual.contains(part))
+                && actual.contains(expected_function)
+        }),
+        "none of the available assist edits contained both the expected alias and function; got: {actuals:#?}"
+    );
+}
