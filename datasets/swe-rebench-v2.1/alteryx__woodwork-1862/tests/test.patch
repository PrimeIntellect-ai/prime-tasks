+        format="csv",
+        encoding="utf-8",
+        engine="python",
+        profile_name=None,
+    )
+    make_public(s3_client, s3_bucket)
+
+    real_extractall = tarfile.TarFile.extractall
+    with patch.object(
+        tarfile.TarFile,
