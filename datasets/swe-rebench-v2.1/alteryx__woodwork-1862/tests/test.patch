+        namedtuple("version_info", "major minor micro releaselevel serial")(
+            3, 8, 0, "final", 0
+        ),
+    )
+    real_extractall = tarfile.TarFile.extractall
+
+    def extractall_without_filter(self, path=".", members=None, *, numeric_owner=False):
+        return real_extractall(
+            self,
+            path=path,
+            members=members,
+            numeric_owner=numeric_owner,
+        )
+
+    monkeypatch.setattr(tarfile.TarFile, "extractall", extractall_without_filter)
+
+
+def test_to_csv_S3_errors_if_python_version_unsafe(
+    sample_df,
+    s3_client,
+    s3_bucket,
