+// TestTernaryExpressionEvaluation verifies that a ternary expression
+// evaluates its condition and returns the value of the appropriate
+// branch.
+func TestTernaryExpressionEvaluation(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected int64
+	}{
+		{"1 > 2 ? 1 : 2", 2},
+		{"2 > 1 ? 2 : 1", 2},
+		{"1 < 2 ? 10 : 20", 10},
+		{"1 > 2 ? 10 : 20", 20},
+		{"true ? 5 : 6", 5},
+		{"false ? 5 : 6", 6},
+	}
+
+	for _, tt := range tests {
+		l := lexer.New(tt.input)
+		p := parser.New(l)
+		program := p.ParseProgram()
+		if len(p.Errors()) != 0 {
+			t.Fatalf("parser errors for %q: %v", tt.input, p.Errors())
+		}
+		env := object.NewEnvironment()
+		evaluated := evaluator.Eval(program, env)
+		result, ok := evaluated.(*object.Integer)
+		if !ok {
+			t.Fatalf("input %q did not evaluate to an Integer, got=%T(%+v)", tt.input, evaluated, evaluated)
+		}
+		if result.Value != tt.expected {
+			t.Errorf("input %q evaluated to %d, want %d", tt.input, result.Value, tt.expected)
+		}
+	}
+}
+
+// TestTernaryExpressionSampleUsage verifies the sample usage from the
+// problem statement: a function returning the larger of two values.
+func TestTernaryExpressionSampleUsage(t *testing.T) {
+	input := `function max(a, b) { return( a > b ? a : b ); }
+max(1, 2);`
+
+	l := lexer.New(input)
+	p := parser.New(l)
+	program := p.ParseProgram()
+	if len(p.Errors()) != 0 {
+		t.Fatalf("parser errors: %v", p.Errors())
+	}
+	env := object.NewEnvironment()
+	evaluated := evaluator.Eval(program, env)
+	result, ok := evaluated.(*object.Integer)
+	if !ok {
+		t.Fatalf("sample usage did not evaluate to an Integer, got=%T(%+v)", evaluated, evaluated)
+	}
+	if result.Value != 2 {
+		t.Errorf("max(1, 2) evaluated to %d, want 2", result.Value)
+	}
+}
