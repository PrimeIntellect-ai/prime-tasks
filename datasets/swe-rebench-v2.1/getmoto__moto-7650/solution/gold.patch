index 000000000..7cd39ec5b
--- /dev/null
+++ b/moto/fsx/utils.py
@@ -0,0 +1,13 @@
+from enum import Enum
+from typing import List
+
+
+class FileSystemType(str, Enum):
+    WINDOWS = "WINDOWS"
+    LUSTRE = "LUSTRE"
+    ONTAP = "ONTAP"
+    OPEN_ZFS = "OPENZFS"
+
+    @classmethod
+    def list_values(self) -> List[str]:
+        return sorted([item.value for item in FileSystemType])
