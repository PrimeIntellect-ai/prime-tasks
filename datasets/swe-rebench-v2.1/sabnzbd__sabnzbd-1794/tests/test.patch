+"""
+tests.test_sorting - Testing functions in sorting.py
+"""
+
+from sabnzbd import sorting
+from tests.testhelper import *
+
+
+class TestSorting:
+    @set_config(
+        {
+            "movie_sort_string": "%r.%.title.%y",
+            "movie_categories": "movies",
+            "enable_movie_sorting": 1,
+        }
+    )
+    def test_movie_sorting_fills_resolution_placeholder(self):
+        for resolution in ("720p", "1080p"):
+            sorter = sorting.MovieSorter(
+                None, f"Movie.Name.2009.{resolution}", "/complete", "movies"
+            )
+            assert sorter.matched
+            assert resolution in sorter.get_final_path()
