+(defn- run-cli-with-license-data
+  [args licenses]
+  (let [classpath (System/getProperty "java.class.path")
+        form (str "(require 'pip-license-checker.core) "
+                  "(with-redefs "
+                  "[pip-license-checker.core/get-parsed-requiements "
+                  "(fn [& _] " (pr-str licenses) ")] "
+                  "(apply pip-license-checker.core/-main " (pr-str args) "))")]
+    (sh "java" "-cp" classpath "clojure.main" "-e" form)))
+
+(deftest test-cli-fail-exit-status
+  (testing "Repeated fail options produce a non-zero CLI status for a matching type"
+    (let [{:keys [exit]}
+          (run-cli-with-license-data
+           ["--fail" "Permissive" "--fail" "Other" "django"]
+           [{:ok? true
+             :requirement {:name "django" :version "1.0"}
+             :license {:name "MIT License" :desc "Permissive"}}])]
+      (is (not (zero? exit)))))
+  (testing "A later repeated fail option also triggers a non-zero CLI status"
+    (let [{:keys [exit]}
+          (run-cli-with-license-data
+           ["--fail" "Permissive" "--fail" "Other" "django"]
+           [{:ok? true
+             :requirement {:name "django" :version "1.0"}
+             :license {:name "Other/Proprietary License" :desc "Other"}}])]
+      (is (not (zero? exit))))))
