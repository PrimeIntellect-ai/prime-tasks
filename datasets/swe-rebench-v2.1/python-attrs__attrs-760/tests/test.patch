+
+    def test_init_type_hints(self):
+        """
+        String annotations in __init__ are evaluated in the context of the
+        module where the class is defined, so names imported into that module
+        (like ``List``) resolve.
+        """
+
+        @attr.s
+        class C:
+            x = attr.ib(type="List[int]")
+
+        assert typing.get_type_hints(C.__init__) == {
+            "return": type(None),
+            "x": typing.List[int],
+        }
