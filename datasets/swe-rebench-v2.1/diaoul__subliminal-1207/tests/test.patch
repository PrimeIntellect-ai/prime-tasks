+def test_save_subtitles_converts_microdvd_to_srt(tmpdir) -> None:
+    from subliminal.core import save_subtitles
+    from subliminal.video import Movie
+
+    video = Movie('movie.mkv', 'Movie', frame_rate=24)
+    microdvd_content = (
+        b'{1189}{1271}T\xc5\x82umaczenie:|sinu6\n'
+        b'{3146}{3189}/Nie rozumiecie?\n'
+        b'{3189}{3244}/J\xc4\x85dro Kryptona si\xc4\x99 rozpada.\n'
+        b'{3244}{3299}To kwestia tygodni.\n'
+        b'{3299}{3390}Ostrzega\xc5\x82em, \xc5\xbce eksploatacja j\xc4\x85dra|to samob\xc3\xb3jstwo.\n'
+    )
+    subtitles = [Subtitle(Language('pol')), Subtitle(Language('fra'))]
+    for subtitle in subtitles:
+        subtitle.content = microdvd_content
+
+    save_subtitles(video, subtitles, subtitle_format='srt', directory=str(tmpdir), encoding='utf-8')
+
+    for language_code in ('pl', 'fr'):
+        path = os.path.join(str(tmpdir), f'movie.{language_code}.srt')
+        assert os.path.exists(path)
+        content = open(path, encoding='utf-8').read()
+        assert '{1189}' not in content
+        assert list(srt.parse(content))
+
+
