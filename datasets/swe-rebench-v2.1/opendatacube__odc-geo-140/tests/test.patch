+@pytest.mark.parametrize(
+    "shape",
+    [
+        pytest.param((100, 100), id="positive xy"),
+        pytest.param((-100, 100), id="negative x"),
+        pytest.param((100, -100), id="negative y"),
+        pytest.param((-100, -100), id="both negative"),
