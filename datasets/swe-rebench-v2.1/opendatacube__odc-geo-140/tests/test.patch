+def test_shape(shape):
+    if shape[0] < 0 or shape[1] < 0:
+        with pytest.raises(Exception):
+            GeoBox.from_bbox((-3, -4, 3, 4), epsg4326, shape=shape)
+    else:
+        GeoBox.from_bbox((-3, -4, 3, 4), epsg4326, shape=shape)
+
