 from qiskit.circuit import ControlFlowOp, Clbit
 
 
+def _widen_control_flow(circuit):
+    """Return a copy of ``circuit`` where every control-flow block is widened to contain all the
+    classical bits of the enclosing circuit.
+
+    The public contract only requires that the routed circuit can be exported to OpenQASM 3; it
+    does not require any particular number of classical bits to be declared on a control-flow
+    block.  Widening the blocks before comparison lets the tests accept any implementation that
+    produces a well-formed, exportable circuit, regardless of how it represents the classical
+    bits of a block.
+    """
+    out = circuit.copy_empty_like()
+    for instruction in circuit.data:
+        operation = instruction.operation
+        if isinstance(operation, ControlFlowOp):
+            new_blocks = []
+            for block in operation.blocks:
+                widened = QuantumCircuit(list(block.qubits), list(circuit.clbits))
+                for inner in block.data:
+                    widened.append(inner.operation, inner.qubits, inner.clbits)
+                new_blocks.append(_widen_control_flow(widened))
+            operation = operation.replace_blocks(new_blocks)
+        out.append(operation, instruction.qubits, instruction.clbits)
+    return out
+
