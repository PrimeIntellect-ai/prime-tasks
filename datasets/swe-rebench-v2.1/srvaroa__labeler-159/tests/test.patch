+func mustParseTestConfig(t *testing.T, source string) LabelerConfigV1 {
+	t.Helper()
+	var config LabelerConfigV1
+	if err := yaml.Unmarshal([]byte(source), &config); err != nil {
+		t.Fatal(err)
+	}
+	return config
+}
+
+func setPayloadTime(payload []byte, field string, value time.Time) []byte {
+	pattern := regexp.MustCompile(`"` + field + `": "[^"]+"`)
+	replacement := []byte(`"` + field + `": "` + value.UTC().Format(time.RFC3339) + `"`)
+	return pattern.ReplaceAll(payload, replacement)
+}
