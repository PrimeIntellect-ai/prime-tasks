+func TestThrottlingChecker_DoCheckConcurrentShortIntervalDoesNotOverflow(t *testing.T) {
+	const workers = 64
+	const requestsPerWorker = 128
+	tc := NewThrottlingChecker(nil, 60000, 1000)
+	start := make(chan struct{})
+	wg := &sync.WaitGroup{}
+	var blocked int32
+	wg.Add(workers)
+	for i := 0; i < workers; i++ {
+		go func() {
+			defer wg.Done()
+			<-start
+			for j := 0; j < requestsPerWorker; j++ {
+				if result := tc.DoCheck(nil, 1, 1e9); result != nil && result.IsBlocked() {
+					atomic.AddInt32(&blocked, 1)
+				}
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	assert.Zero(t, blocked, "requests within the generous queue timeout should not be blocked")
+}
