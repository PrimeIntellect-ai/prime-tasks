+func TestStorageBilling_FieldTypes(t *testing.T) {
+	storageBillingType := reflect.TypeOf(StorageBilling{})
+	intType := reflect.TypeOf(int(0))
+	float64Type := reflect.TypeOf(float64(0))
+	tests := []struct {
+		fieldName string
+		wantType  reflect.Type
+	}{
+		{fieldName: "DaysLeftInBillingCycle", wantType: intType},
+		{fieldName: "EstimatedPaidStorageForMonth", wantType: float64Type},
+		{fieldName: "EstimatedStorageForMonth", wantType: intType},
+	}
+	for _, tt := range tests {
+		t.Run(tt.fieldName, func(t *testing.T) {
+			field, ok := storageBillingType.FieldByName(tt.fieldName)
+			if !ok {
+				t.Fatalf("StorageBilling has no %s field", tt.fieldName)
+			}
+			if field.Type != tt.wantType {
+				t.Errorf("StorageBilling.%s has type %v, want %v", tt.fieldName, field.Type, tt.wantType)
+			}
+		})
+	}
+}
