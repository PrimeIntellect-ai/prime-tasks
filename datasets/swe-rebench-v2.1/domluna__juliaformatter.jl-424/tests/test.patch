         """
         @test fmt(str) == str
     end
+
+    @testset "issue 419" begin
+        # The reported program must be accepted by the YAS formatter.
+        reported = """
+        x = [[1,2,3], [4,5,6]]
+        print([z for y in x for z in y])
+        """
+        @test_nowarn yasfmt(reported)
+
+        # Formatting must leave the comprehension list-producing, not turn it
+        # into a comprehension of generators.
+        comprehension = "[z for y in x for z in y]"
+        formatted = @test_nowarn yasfmt(comprehension)
+        mod = Module()
+        Core.eval(mod, :(x = [[1, 2, 3], [4, 5, 6]]))
+        result = Core.eval(mod, Meta.parse(formatted))
+        @test result isa Vector
+        @test result == [1, 2, 3, 4, 5, 6]
+    end
 end
