+@pytest.mark.parametrize('operation', ['start', 'stop', 'restart'])
+def test_harness_missing_service_raises_api_error(
+    request: pytest.FixtureRequest, operation: str
+):
+    harness = ops.testing.Harness(
+        ops.CharmBase,
+        meta='''
+        name: test-charm
+        containers:
+          workload:
+            resource: workload
+        ''',
+    )
+    request.addfinalizer(harness.cleanup)
+    harness.begin()
+    harness.set_can_connect('workload', True)
+    client = harness.model.unit.get_container('workload').pebble
+    with pytest.raises(pebble.APIError):
+        getattr(client, f'{operation}_services')(['missing'])
+
+
+@pytest.mark.skipif(
+    not hasattr(ops.testing, 'Context'), reason='requires optional ops[testing] install'
+)
+@pytest.mark.parametrize('operation', ['start', 'stop', 'restart'])
+def test_scenario_missing_service_raises_api_error(operation: str):
+    errors = []
+
+    class Charm(ops.CharmBase):
+        def __init__(self, framework: ops.Framework):
+            super().__init__(framework)
+            framework.observe(self.on.start, self._on_start)
+
+        def _on_start(self, event: ops.StartEvent):
+            container = self.unit.get_container('workload')
+            try:
+                getattr(container.pebble, f'{operation}_services')(['missing'])
+            except pebble.APIError as error:
+                errors.append(error)
+
+    context = ops.testing.Context(
+        Charm,
+        meta={'name': 'test-charm', 'containers': {'workload': {'resource': 'workload'}}},
+    )
+    state = ops.testing.State(
+        containers=[ops.testing.Container(name='workload', can_connect=True)]
+    )
+    context.run(context.on.start(), state)
+    assert errors
