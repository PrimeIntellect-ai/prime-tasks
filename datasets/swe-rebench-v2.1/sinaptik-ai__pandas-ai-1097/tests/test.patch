+import os
+
+from pandasai.llm.bamboo_llm import BambooLLM
+from pandasai.llm.langchain import LangchainLLM
+from pandasai.schemas.df_config import Config
+
+
+def _set_test_env() -> None:
+    os.environ["PANDASAI_API_URL"] = "http://test-server"
+    os.environ["PANDASAI_API_KEY"] = "test-api-key"
+
+
+def test_config_llm_default_type() -> None:
+    # Define a mock environment for testing
+    _set_test_env()
+
+    # Create an instance of Config without any arguments
+    config = Config()
+
+    # Assert that the llm attribute is an instance of the expected default type (BambooLLM)
+    assert isinstance(
+        config.llm, BambooLLM
+    ), "Default LLM type should be BambooLLM when Config is instantiated without arguments."
+
+
+def test_config_llm_none_uses_default() -> None:
+    # An explicitly supplied None is not a valid LLM and must fall back to the default.
+    _set_test_env()
+
+    config = Config(llm=None)
+
+    assert isinstance(
+        config.llm, BambooLLM
+    ), "Default LLM type should be BambooLLM when llm is explicitly None."
+
+
+def test_config_llm_keeps_supplied_llm() -> None:
+    # A valid LLM instance must be preserved as-is.
+    _set_test_env()
+
+    supplied = BambooLLM()
+    config = Config(llm=supplied)
+
+    assert config.llm is supplied
+
+
+def test_config_llm_keeps_supplied_langchain_llm() -> None:
+    # Config must preserve a supplied LangchainLLM wrapper as-is.
+    _set_test_env()
+
+    supplied = LangchainLLM(object())
+    config = Config(llm=supplied)
+
+    assert config.llm is supplied
