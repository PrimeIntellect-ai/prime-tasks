+    def test_acquire_token_silent_should_find_rt_under_different_alias(self):
+        # Simulate a token cache produced by another MSAL library (e.g.
+        # MSAL.NET or MSAL.Java). Such a cache may contain a refresh token
+        # whose "target" does not match the requested scopes, because AAD
+        # refresh tokens are scope-independent and "target" is optional in
+        # the cache schema. The access token for the requested scope is
+        # still valid and must be returned, without any refresh-token exchange.
+        for rt in self.cache.find(self.cache.CredentialType.REFRESH_TOKEN):
+            self.cache.remove_rt(rt)  # Clear the RT added by setUp
+        self.cache.add({
+            "client_id": self.client_id,
+            "scope": [],  # A foreign RT may carry no target at all
+            "token_endpoint": "https://{}/common/oauth2/v2.0/token".format(
+                self.environment_in_cache),
+            "response": TokenCacheTestCase.build_response(
+                uid="uid", utid="utid",
+                access_token="an access token for another scope",
+                refresh_token="some refresh token"),
+        })
+
+        def no_network(*args, **kwargs):
+            raise AssertionError("A cache hit must not trigger a token refresh")
+
+        result = self.app.acquire_token_silent(
+            self.scopes, self.account, post=no_network)
+        self.assertNotEqual(None, result)
+        self.assertEqual(self.access_token, result.get("access_token"))
+
+    def test_acquire_token_silent_should_read_cache_from_other_msal_library(self):
+        # A cache serialized by another MSAL library (e.g. MSAL.NET or
+        # MSAL.Java) stores the access token under the "sts.windows.net"
+        # environment while this app is configured with the
+        # "login.microsoftonline.com" alias. The access token must still be
+        # found, without any refresh-token exchange.
+        now = int(time.time())
+        foreign_cache = {
+            "AccessToken": {
+                "foreign-at": {
+                    "credential_type": "AccessToken",
+                    "secret": self.access_token,
+                    "home_account_id": self.account["home_account_id"],
+                    "environment": self.environment_in_cache,
+                    "client_id": self.client_id,
+                    "target": " ".join(self.scopes),
+                    "realm": "common",
+                    "token_type": "Bearer",
+                    "cached_at": str(now),
+                    "expires_on": str(now + 3600),
+                    "extended_expires_on": str(now + 3600),
+                },
+            },
+            "RefreshToken": {
+                "foreign-rt": {
+                    "credential_type": "RefreshToken",
+                    "secret": "some refresh token",
+                    "home_account_id": self.account["home_account_id"],
+                    "environment": self.environment_in_cache,
+                    "client_id": self.client_id,
+                    # "target" is optional per the cache schema; a foreign
+                    # library may omit it entirely.
+                },
+            },
+        }
+        self.cache.deserialize(json.dumps(foreign_cache))
+
+        def no_network(*args, **kwargs):
+            raise AssertionError("A cache hit must not trigger a token refresh")
+
+        result = self.app.acquire_token_silent(
+            self.scopes, self.account, post=no_network)
