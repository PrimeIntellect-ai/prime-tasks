+  describe('#app --require-latest flag', () => {
+    class ExitError extends Error {
+      constructor(public code: number) {
+        super(`exit ${code}`);
+      }
+    }
+
+    interface RunResult {
+      errors: string[];
+      warns: string[];
+      infos: string[];
+      exits: number[];
+    }
+
+    async function runApp(argv: string[], versions: any): Promise<RunResult> {
+      const result: RunResult = { errors: [], warns: [], infos: [], exits: [] };
+      const origArgv = process.argv;
+      const origExit = process.exit;
+      let thrown = false;
+      process.argv = argv;
+      (process as any).exit = (code: number) => {
+        result.exits.push(code);
+        if (!thrown) {
+          thrown = true;
+          throw new ExitError(code);
+        }
+      };
+      const tmpDir = temp.mkdirSync('sushi-app-test');
+      const inputDir = path.join(tmpDir, 'input', 'fsh');
+      fs.mkdirSync(inputDir, { recursive: true });
+      const outPackage = {
+        profiles: [] as any[],
+        extensions: [] as any[],
+        logicals: [] as any[],
+        resources: [] as any[],
+        valueSets: [] as any[],
+        codeSystems: [] as any[],
+        instances: [] as any[]
+      };
+      jest.isolateModules(() => {
+        jest.doMock('../../src/utils', () => {
+          const actual = jest.requireActual('../../src/utils');
+          jest.spyOn(actual.logger.transports[0], 'write').mockImplementation((entry: any) => {
+            if (entry.level === 'error') result.errors.push(entry.message);
+            else if (entry.level === 'warn') result.warns.push(entry.message);
+            else if (entry.level === 'info') result.infos.push(entry.message);
+            return true;
+          });
+          return {
+            ...actual,
+            checkSushiVersion: jest.fn().mockResolvedValue(versions),
+            getLatestSushiVersion: jest.fn().mockResolvedValue(versions.latest),
+            getLocalSushiVersion: jest.fn().mockReturnValue(versions.current),
+            ensureInputDir: jest.fn().mockReturnValue(inputDir),
+            findInputDir: jest.fn().mockReturnValue(inputDir),
+            ensureOutputDir: jest.fn().mockReturnValue(path.join(tmpDir, 'fsh-generated')),
+            getRawFSHes: jest.fn().mockReturnValue([{}]),
+            writeFHIRResources: jest.fn(),
+            writePreprocessedFSH: jest.fn(),
+            readConfig: jest.fn().mockReturnValue({ FSHOnly: true, fhirVersion: ['4.0.1'] }),
+            fillTank: jest.fn().mockReturnValue({}),
+            loadExternalDependencies: jest.fn().mockResolvedValue(undefined),
+            isSupportedFHIRVersion: jest.fn().mockReturnValue(true),
+            getRandomPun: jest.fn().mockReturnValue('pun'),
+            stats: { numError: 0, numWarn: 0 }
+          };
+        });
+        jest.doMock('../../src/export', () => ({
+          exportFHIR: jest.fn().mockReturnValue(outPackage),
+          Package: class {}
+        }));
+        jest.doMock('../../src/ig', () => ({ IGExporter: class { export() {} } }));
+        jest.doMock('../../src/fhirdefs', () => ({
+          loadCustomResources: jest.fn(),
+          FHIRDefinitions: class {
+            fishForFHIR() {
+              return { version: '4.0.1' };
+            }
+          }
+        }));
+        require('../../src/app');
+      });
+      const start = Date.now();
+      while (result.exits.length === 0 && Date.now() - start < 5000) {
+        await new Promise(r => setTimeout(r, 10));
+      }
+      await new Promise(r => setTimeout(r, 50));
+      process.argv = origArgv;
+      (process as any).exit = origExit;
+      return result;
+    }
+
+    const realErrors = (r: RunResult) => r.errors.filter(e => !/unexpected error/.test(e));
+
+    it('exits with an error when --require-latest is set and SUSHI is not the latest version', async () => {
+      const result = await runApp(['node', 'sushi', '/tmp/proj', '--require-latest'], {
+        latest: '9.9.9',
+        current: '2.4.1'
+      });
+      expect(realErrors(result)).not.toHaveLength(0);
+      expect(result.exits[0]).not.toBe(0);
+    });
+
+    it('exits with an error when --require-latest is set and the latest version cannot be determined', async () => {
+      const result = await runApp(['node', 'sushi', '/tmp/proj', '--require-latest'], {
+        latest: undefined,
+        current: '2.4.1'
+      });
+      expect(realErrors(result)).not.toHaveLength(0);
+      expect(result.exits[0]).not.toBe(0);
+    });
+
+    it('does not exit with an error when --require-latest is not set and SUSHI is not the latest version', async () => {
+      const result = await runApp(['node', 'sushi', '/tmp/proj'], {
+        latest: '9.9.9',
+        current: '2.4.1'
+      });
+      expect(realErrors(result)).toHaveLength(0);
+      expect(result.exits[0]).toBe(0);
+    });
+  });
 });
