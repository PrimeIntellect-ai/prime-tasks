+
+class TestBQMRelabelSuperset(unittest.TestCase):
+    def test_superset_mapping_labels_present_variables(self):
+        bqm = dimod.BinaryQuadraticModel({2: 1, 0: 1}, {}, 0, 'SPIN')
+
+        new = bqm.relabel_variables({0: "a", 1: "b", 2: "c"}, inplace=False)
+
+        self.assertEqual(dict(new.linear), {"c": 1, "a": 1})
+
+    def test_superset_mapping_keeps_interactions(self):
+        bqm = dimod.BinaryQuadraticModel({2: 1, 0: 2}, {(0, 2): 3}, 0, 'SPIN')
+
+        new = bqm.relabel_variables({0: "a", 1: "b", 2: "c"}, inplace=False)
+
+        self.assertEqual(set(new.variables), {"a", "c"})
+        self.assertEqual(new.get_quadratic("a", "c"), 3)
+
+    def test_superset_mapping_inplace(self):
+        bqm = dimod.BinaryQuadraticModel({2: 1, 0: 2}, {}, 0, 'SPIN')
+
+        bqm.relabel_variables({0: "a", 1: "b", 2: "c"})
+
+        self.assertEqual(dict(bqm.linear), {"c": 1, "a": 2})
+
+    def test_subset_mapping_unchanged_behaviour(self):
+        bqm = dimod.BinaryQuadraticModel({2: 1, 0: 2}, {}, 0, 'SPIN')
+
+        new = bqm.relabel_variables({0: "a", 2: "c"}, inplace=False)
+
+        self.assertEqual(dict(new.linear), {"c": 1, "a": 2})
