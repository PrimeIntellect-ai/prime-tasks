+@testset "generic column-access subset" begin
+    # `GenericColumnTable` is a column-access table that does not define its own
+    # `Tables.subset` method, exercising the generic column-access path.
+    mkgc() = GenericColumnTable(Dict(:a=>1, :b=>2, :c=>3),
+        GenericColumn[GenericColumn([1,2,3]), GenericColumn([4.0, 5.0, 6.0]), GenericColumn(["7", "8", "9"])])
+
+    gcv = mkgc()
+    rsv = Tables.subset(gcv, 1:2, viewhint=true)
+    @test Tables.getcolumn(rsv, :a) == [1, 2]
+    gcc = mkgc()
+    rsc = Tables.subset(gcc, 1:2, viewhint=false)
+    @test Tables.getcolumn(rsc, :a) == [1, 2]
+end
