+    def test_dot_real(self):
+        """Test dot for real coefficiets."""
+        x = SparsePauliOp("X", np.array([1]))
+        y = SparsePauliOp("Y", np.array([1]))
+        iz = SparsePauliOp("Z", 1j)
+        self.assertEqual(x.dot(y), iz)
+
+    def test_dot_parameter_coefficients(self):
+        """Test dot preserves parameter-dependent object coefficients."""
+        first = Parameter("first")
+        second = Parameter("second")
+        left = SparsePauliOp("I", np.array([first]))
+        right = SparsePauliOp("I", np.array([second]))
+
+        product = left.dot(right)
+        self.assertEqual(product.coeffs[0].bind({first: 2, second: 3}), 6)
+
 
 if __name__ == "__main__":
