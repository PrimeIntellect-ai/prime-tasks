+@pytest.mark.skipif(aiodns is None, reason="aiodns required")
+@pytest.mark.usefixtures("check_no_lingering_resolvers")
+async def test_async_resolver_passes_provided_loop_to_dns_resolver() -> None:
+    custom_loop = asyncio.new_event_loop()
+    dns_resolver_signature = inspect.signature(aiodns.DNSResolver)
+    try:
+        with patch("aiodns.DNSResolver") as dns_resolver:
+            resolver = AsyncResolver(loop=custom_loop)
+            call_arguments = [
+                dns_resolver_signature.bind(*call.args, **call.kwargs).arguments
+                for call in dns_resolver.call_args_list
+            ]
+            assert any(
+                arguments.get("loop") is custom_loop for arguments in call_arguments
+            )
+            await resolver.close()
+    finally:
+        custom_loop.close()
