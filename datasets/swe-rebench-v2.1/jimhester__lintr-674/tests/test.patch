diff --git a/tests/testthat/test-spaces_left_parentheses_linter.R b/tests/testthat/test-spaces_left_parentheses_linter.R
index 0762add..552a79b 100644
--- a/tests/testthat/test-spaces_left_parentheses_linter.R
+++ b/tests/testthat/test-spaces_left_parentheses_linter.R
@@ -77,3 +77,24 @@ test_that("returns the correct linting", {
 
   expect_lint("a <- -(b)", NULL, spaces_left_parentheses_linter)
 })
+
+test_that("lint_package does not emit vector-length recycling warnings", {
+  recycling_warnings <- character()
+
+  withCallingHandlers(
+    lintr::lint_package(),
+    warning = function(warning) {
+      message <- conditionMessage(warning)
+      if (grepl(
+        "longer object length is not a multiple of shorter object length",
+        message,
+        fixed = TRUE
+      )) {
+        recycling_warnings <<- c(recycling_warnings, message)
+        invokeRestart("muffleWarning")
+      }
+    }
+  )
+
+  expect_length(recycling_warnings, 0L)
+})
