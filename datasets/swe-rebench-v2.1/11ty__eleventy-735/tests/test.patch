+
+test("Front matter from one file does not affect data in another file", async t => {
+  const inputDir = await fs.mkdtemp(
+    path.join(process.cwd(), "test", "tmp-eleventy-merge-")
+  );
+  const outputDir = path.join(inputDir, "_site");
+  const originalConfigPath = templateConfig.getLocalProjectConfigFile();
+  const configPath = path.relative(
+    process.cwd(),
+    path.join(inputDir, "eleventy.config.js")
+  );
+
+  try {
+    await fs.outputFile(
+      configPath,
+      "module.exports = function(eleventyConfig) { eleventyConfig.setDataDeepMerge(true); };"
+    );
+    await fs.outputFile(
+      path.join(inputDir, "_data", "meta.json"),
+      JSON.stringify({ image: "gimage", description: "gdesc" })
+    );
+    await fs.outputFile(
+      path.join(inputDir, "index.liquid"),
+      `---
+meta:
+  description: topleveldesc
+---
+{{ meta.image }}|{{ meta.description }}`
+    );
+    await fs.outputFile(
+      path.join(inputDir, "something.liquid"),
+      `---
+meta:
+  description: otherdesc
+---
+{{ meta.image }}|{{ meta.description }}`
+    );
+
+    const eleventy = new Eleventy(inputDir, outputDir);
+    eleventy.setConfigPathOverride(configPath);
+    await eleventy.init();
+    await eleventy.write();
+
+    t.is(
+      await fs.readFile(path.join(outputDir, "index.html"), "utf8"),
+      "gimage|topleveldesc"
+    );
+    t.is(
+      await fs.readFile(path.join(outputDir, "something", "index.html"), "utf8"),
+      "gimage|otherdesc"
+    );
+  } finally {
+    await fs.remove(inputDir);
+    templateConfig.setProjectConfigPath(originalConfigPath);
+  }
+});
