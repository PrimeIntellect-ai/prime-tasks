+@pytest.mark.asyncio
+async def test_stream_file_apple_tv_3(event_loop):
+    """Streaming to an Apple TV 3 (AirPlay 1) must succeed."""
+    fake_atv = FakeAppleTV(event_loop, test_mode=False)
+    fake_atv.add_service(Protocol.RAOP)
+    await fake_atv.start()
+    client = None
+    try:
+        service = ManualService(
+            "raop_id",
+            Protocol.RAOP,
+            fake_atv.get_port(Protocol.RAOP),
+            {"et": "0", "ft": "0x5A7FFFF7,0xE"},
+        )
+        conf = AppleTV("127.0.0.1", "Apple TV")
+        conf.add_service(service)
+        client = await connect(conf, loop=event_loop)
+        await client.stream.stream_file(data_path("audio_10_frames.wav"))
+    finally:
+        if client is not None:
+            await asyncio.gather(*client.close())
+        await fake_atv.stop()
