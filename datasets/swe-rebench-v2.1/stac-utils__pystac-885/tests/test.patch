+    def test_geo_interface(self) -> None:
+        item = pystac.Item.from_file(
+            TestCases.get_path("data-files/item/sample-item.json")
+        )
+
+        # The protocol is consumed through attribute access rather than by
+        # calling the value.
+        geo_interface = item.__geo_interface__
+        self.assertFalse(callable(geo_interface))
+        self.assertIsInstance(geo_interface, Mapping)
+
+        # It may be a geometry mapping or a Feature, but must convey this
+        # item's geometry.
+        if geo_interface.get("type") == "Feature":
+            self.assertEqual(geo_interface.get("geometry"), item.geometry)
+        else:
+            self.assertEqual(geo_interface, item.geometry)
+
 
