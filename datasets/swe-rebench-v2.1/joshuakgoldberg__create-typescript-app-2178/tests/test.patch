+				],
+				owner: "JoshuaKGoldberg",
+			},
+		});
+
+		const contents: string = creation.files?.[".all-contributorsrc"] ?? "";
+		const lines = contents.replace(/\n$/, "").split("\n");
+
+		for (const line of lines) {
+			const indentation = /^\s*/.exec(line)?.[0] ?? "";
+
+			expect(indentation).not.toContain("\t");
+			expect(indentation.length % 2).toBe(0);
+		}
+
+		expect(lines.find((line) => line.includes('"contributors"'))).toMatch(
