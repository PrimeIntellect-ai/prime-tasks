+
+  describe("Comments schema", function() {
+    var upvertedStory = function() {
+      return transforms.upvert(fixtures['0.5.7']['story-fixture-good'], '0.5.8');
+    };
+
+    it("should validate a story whose comments use the supported property types", function() {
+      validate('0.5.8/story.json', upvertedStory());
+    });
+
+    it("should describe comments_period in days", function() {
+      var commentsSchema = require('../src/main/resources/schema/ans/0.5.8/traits/trait_comments.json');
+      var periodSchema = commentsSchema.properties.comments_period;
+      var annotations = [
+        commentsSchema.title,
+        commentsSchema.description,
+        periodSchema.title,
+        periodSchema.description
+      ].filter(function(annotation) {
+        return typeof annotation === 'string';
+      });
+      annotations.join(' ').toLowerCase().should.containEql('days');
+    });
+
+    it("should not validate a story whose comments_period is not an integer", function() {
+      var story = upvertedStory();
+      story.comments.comments_period = "fourteen";
+      validate('0.5.8/story.json', story, false);
+    });
+
+    it("should not validate a story whose allow_comments is not a boolean", function() {
+      var story = upvertedStory();
+      story.comments.allow_comments = "yes";
+      validate('0.5.8/story.json', story, false);
+    });
+
+    it("should not validate a story whose display_comments is not a boolean", function() {
+      var story = upvertedStory();
+      story.comments.display_comments = 1;
+      validate('0.5.8/story.json', story, false);
+    });
+
+    it("should not validate a story whose moderation_required is not a boolean", function() {
+      var story = upvertedStory();
+      story.comments.moderation_required = "no";
+      validate('0.5.8/story.json', story, false);
     });
   });
 
