+    def test_backtested_market_book_updated_when_market_closes(self):
+        self.base_flumine.client.commission_base = 0
+        market_definition = SimpleNamespace(
+            event_type_id="7",
+            event_id="event",
+            market_type="WIN",
+            market_time=None,
+            event_name="event",
+            country_code="GB",
+            venue="venue",
+            race_type="FLAT",
+        )
+        original_book = SimpleNamespace(
+            version=1, runners=[], market_definition=market_definition
+        )
+        closing_runner = SimpleNamespace(selection_id=42, status="REMOVED")
+        closing_book = SimpleNamespace(
+            market_id="1.23",
+            streaming_unique_id=2,
+            version=2,
+            runners=[closing_runner],
+            market_definition=market_definition,
+        )
+        original_book.market_id = "1.23"
+        original_book.streaming_unique_id = 2
+        original_book.streaming_snap = True
+        original_book.status = "OPEN"
+        closing_book.streaming_snap = True
+        closing_book.status = "CLOSED"
+        flumine = Flumine(self.mock_client)
+        flumine.BACKTEST = True
+
+        class StopAfterCloseQueue(queue.Queue):
+            def put(self, event, *args, **kwargs):
+                super().put(event, *args, **kwargs)
+                if event.EVENT_TYPE == events.EventType.CLOSE_MARKET:
+                    super().put(events.TerminationEvent(None))
+
+        flumine.handler_queue = StopAfterCloseQueue()
+        flumine.handler_queue.put(events.MarketBookEvent([original_book]))
+        flumine.handler_queue.put(events.MarketBookEvent([closing_book]))
+
+        with (
+            mock.patch.object(Flumine, "__enter__", return_value=None),
+            mock.patch.object(Flumine, "__exit__"),
+        ):
+            flumine.run()
+
+        stored_book = flumine.markets.markets["1.23"].market_book
+        self.assertEqual(
+            [runner.status for runner in stored_book.runners], ["REMOVED"]
+        )
+
