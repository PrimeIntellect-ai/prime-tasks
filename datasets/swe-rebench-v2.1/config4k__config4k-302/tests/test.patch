+package io.github.config4k.serializers
+
+import io.github.config4k.Config4k
+import kotlinx.serialization.Contextual
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.hocon.decodeFromConfig
+import kotlinx.serialization.hocon.encodeToConfig
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.Test
+import java.util.regex.Pattern
+
+class PatternSerializerTest {
+    private companion object {
+        val simplePattern: Pattern = Pattern.compile("[0-9]{10}")
+        val patternWithFlags: Pattern =
+            Pattern.compile(
+                "[0-9]{10}",
+                Pattern.LITERAL or Pattern.CASE_INSENSITIVE,
+            )
+        val patternComparator = nullsLast(compareBy(Pattern::pattern, { it.flags() }))
+    }
+
+    @Test
+    fun checkPatternRoundTrip() {
+        @Serializable
+        data class Conf(
+            @Contextual val pattern: Pattern,
+        )
+
+        listOf(simplePattern, patternWithFlags).forEach { expected ->
+            val encoded = Config4k.encodeToConfig(Conf(expected))
+            val decoded: Conf = Config4k.decodeFromConfig(encoded)
+            assertThat(decoded.pattern).usingComparator(patternComparator).isEqualTo(expected)
+        }
+    }
+
+    @Test
+    fun checkListRoundTrip() {
+        @Serializable
+        data class Conf(
+            val patterns: List<@Contextual Pattern?>,
+        )
+
+        val expected = listOf(simplePattern, patternWithFlags, null)
+        val encoded = Config4k.encodeToConfig(Conf(expected))
+        val decoded: Conf = Config4k.decodeFromConfig(encoded)
+
+        assertThat(decoded.patterns)
+            .usingElementComparator(patternComparator)
+            .containsExactlyElementsOf(expected)
+    }
+
+    @Test
+    fun checkMapRoundTrip() {
+        @Serializable
+        data class Conf(
+            val patterns: Map<String, @Contextual Pattern?>,
+        )
+
+        val expected = mapOf("simple" to simplePattern, "withFlags" to patternWithFlags, "absent" to null)
+        val encoded = Config4k.encodeToConfig(Conf(expected))
+        val decoded: Conf = Config4k.decodeFromConfig(encoded)
+
+        assertThat(decoded.patterns.keys).containsExactlyInAnyOrderElementsOf(expected.keys)
+        expected.forEach { (key, pattern) ->
+            assertThat(decoded.patterns[key]).usingComparator(patternComparator).isEqualTo(pattern)
+        }
+    }
+}
