+// https://github.com/dtolnay/async-trait/issues/161
+#[allow(clippy::mut_mut)]
+pub mod issue161 {
+    use crate::executor;
+    use async_trait::async_trait;
+    use std::sync::Arc;
+
+    // A select-style macro defined locally so that the test needs no extra
+    // crate. It is invoked with item-like brace syntax, as `select!` usually is.
+    macro_rules! select {
+        ($pat:pat = $fut:expr => $body:block) => {{
+            let $pat = $fut.await;
+            $body
+        }};
+    }
+
+    #[async_trait]
+    pub trait Trait {
+        async fn f(self: Arc<Self>);
+    }
+
+    pub struct MyStruct(bool);
+
+    #[async_trait]
+    impl Trait for MyStruct {
+        async fn f(self: Arc<Self>) {
+            select! {
+                _ = async {
+                    println!("{}", self.0);
+                } => {}
+            }
+        }
+    }
+
+    #[test]
+    fn test() {
+        let _: () = executor::block_on_simple(Arc::new(MyStruct(true)).f());
+    }
+}
