+// TestShouldProvisionAllowedTopologies checks which PVCs a distributed
+// provisioner claims when the StorageClass has AllowedTopologies with
+// several terms, expressions and values.
+func TestShouldProvisionAllowedTopologies(t *testing.T) {
+	const (
+		zoneKey   = "com.example.csi/zone"
+		nodeName  = "foo"
+		nodeZone  = "a"
+		reqBytes  = 100
+		pvcName   = "fake-pvc"
+		scName    = "fake-test-sc"
+		ownerNode = nodeName
+	)
+	topo := func(key string, values ...string) v1.TopologySelectorLabelRequirement {
+		return v1.TopologySelectorLabelRequirement{Key: key, Values: values}
+	}
+	testcases := map[string]struct {
+		allowedTopologies []v1.TopologySelectorTerm
+		expectOwner       bool
+	}{
+		"single expression matches": {
+			allowedTopologies: []v1.TopologySelectorTerm{
+				{MatchLabelExpressions: []v1.TopologySelectorLabelRequirement{topo(driverTopologyKey, nodeName)}},
+			},
+			expectOwner: true,
+		},
+		"single expression does not match": {
+			allowedTopologies: []v1.TopologySelectorTerm{
+				{MatchLabelExpressions: []v1.TopologySelectorLabelRequirement{topo(driverTopologyKey, "bar")}},
+			},
+			expectOwner: false,
+		},
+		"one of several values matches": {
+			allowedTopologies: []v1.TopologySelectorTerm{
+				{MatchLabelExpressions: []v1.TopologySelectorLabelRequirement{topo(driverTopologyKey, "bar", nodeName)}},
+			},
+			expectOwner: true,
+		},
+		"second term matches": {
+			allowedTopologies: []v1.TopologySelectorTerm{
+				{MatchLabelExpressions: []v1.TopologySelectorLabelRequirement{topo(driverTopologyKey, "bar")}},
+				{MatchLabelExpressions: []v1.TopologySelectorLabelRequirement{topo(driverTopologyKey, nodeName)}},
+			},
+			expectOwner: true,
+		},
+		"no term matches": {
+			allowedTopologies: []v1.TopologySelectorTerm{
+				{MatchLabelExpressions: []v1.TopologySelectorLabelRequirement{topo(driverTopologyKey, "bar")}},
+				{MatchLabelExpressions: []v1.TopologySelectorLabelRequirement{topo(driverTopologyKey, "baz")}},
+			},
+			expectOwner: false,
+		},
+		"all expressions of a term match": {
+			allowedTopologies: []v1.TopologySelectorTerm{
+				{MatchLabelExpressions: []v1.TopologySelectorLabelRequirement{
+					topo(driverTopologyKey, nodeName),
+					topo(zoneKey, nodeZone),
+				}},
+			},
+			expectOwner: true,
+		},
+		"one expression of a term does not match": {
+			allowedTopologies: []v1.TopologySelectorTerm{
+				{MatchLabelExpressions: []v1.TopologySelectorLabelRequirement{
+					topo(driverTopologyKey, nodeName),
+					topo(zoneKey, "b"),
+				}},
+			},
+			expectOwner: false,
+		},
+		"matching expression in second term, other term fails on a later expression": {
+			allowedTopologies: []v1.TopologySelectorTerm{
+				{MatchLabelExpressions: []v1.TopologySelectorLabelRequirement{
+					topo(driverTopologyKey, nodeName),
+					topo(zoneKey, "b"),
+				}},
+				{MatchLabelExpressions: []v1.TopologySelectorLabelRequirement{
+					topo(driverTopologyKey, nodeName),
+					topo(zoneKey, nodeZone),
+				}},
+			},
+			expectOwner: true,
+		},
+	}
+
+	for k, tc := range testcases {
+		t.Run(k, func(t *testing.T) {
+			tmpdir := tempDir(t)
+			defer os.RemoveAll(tmpdir)
+			mockController, driver, _, controllerServer, csiConn, err := createMockServer(t, tmpdir)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer mockController.Finish()
+			defer driver.Stop()
+			controllerServer.EXPECT().GetCapacity(gomock.Any(), gomock.Any()).Return(&csi.GetCapacityResponse{AvailableCapacity: 1024 * 1024 * 1024 * 1024}, nil).AnyTimes()
+
+			mode := storagev1.VolumeBindingImmediate
+			sc := &storagev1.StorageClass{
+				ObjectMeta:        metav1.ObjectMeta{Name: scName},
+				VolumeBindingMode: &mode,
+				AllowedTopologies: tc.allowedTopologies,
+			}
+			node := &v1.Node{
+				ObjectMeta: metav1.ObjectMeta{
+					Name: nodeName,
+					Labels: map[string]string{
+						driverTopologyKey: nodeName,
+						zoneKey:           nodeZone,
+					},
+				},
+			}
+			csiNode := &storagev1.CSINode{
+				ObjectMeta: metav1.ObjectMeta{Name: nodeName},
+				Spec: storagev1.CSINodeSpec{
+					Drivers: []storagev1.CSINodeDriver{
+						{
+							Name:         driverName,
+							NodeID:       nodeName,
+							TopologyKeys: []string{driverTopologyKey, zoneKey},
+						},
+					},
+				},
+			}
+			claim := createFakeNamedPVC(reqBytes, pvcName, nil)
+			claim.Spec.StorageClassName = &[]string{scName}[0]
+
+			clientSet := fakeclientset.NewSimpleClientset(sc, node, csiNode, claim)
+			informerFactory := informers.NewSharedInformerFactory(clientSet, 0)
+			claimInformer := informerFactory.Core().V1().PersistentVolumeClaims()
+			scInformer := informerFactory.Storage().V1().StorageClasses()
+			nodeInformer := informerFactory.Core().V1().Nodes()
+			csiNodeInformer := informerFactory.Storage().V1().CSINodes()
+			claimInformer.Informer().GetStore().Add(claim)
+			scInformer.Informer().GetStore().Add(sc)
+			nodeInformer.Informer().GetStore().Add(node)
+			csiNodeInformer.Informer().GetStore().Add(csiNode)
+
+			nodeDeployment := &NodeDeployment{
+				NodeName:         nodeName,
+				ClaimInformer:    claimInformer,
+				ImmediateBinding: true,
+			}
+			pluginCaps, controllerCaps := provisionCapabilities()
+			csiProvisioner := NewCSIProvisioner(clientSet, 5*time.Second, "test-provisioner", "test", 5, csiConn.conn,
+				nil, driverName, pluginCaps, controllerCaps, "", false, true, csitrans.New(), scInformer.Lister(), csiNodeInformer.Lister(), nodeInformer.Lister(), nil, nil, false, defaultfsType, nodeDeployment)
+
+			// The first call may only try to claim the PVC for this node,
+			// so the decision is read back from the stored claim.
+			csiProvisioner.(controller.Qualifier).ShouldProvision(context.Background(), claim)
+
+			stored, err := clientSet.CoreV1().PersistentVolumeClaims(claim.Namespace).Get(context.Background(), claim.Name, metav1.GetOptions{})
+			if err != nil {
+				t.Fatalf("PVC not found: %v", err)
+			}
+			owned := stored.Annotations[annSelectedNode] == ownerNode
+			if owned != tc.expectOwner {
+				t.Errorf("expected owner %v, got selected node %q", tc.expectOwner, stored.Annotations[annSelectedNode])
+			}
+		})
+	}
+}
