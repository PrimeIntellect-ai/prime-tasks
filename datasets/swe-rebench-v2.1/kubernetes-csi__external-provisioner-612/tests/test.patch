+// TestProvisionRetriesAfterTransientErrorWithDistributedOwner checks that the
+// node owning a PVC keeps retrying after a transient CreateVolume error
+// instead of giving up on the claim.
+func TestProvisionRetriesAfterTransientErrorWithDistributedOwner(t *testing.T) {
+	const (
+		reqBytes = 100
+		nodeName = "foo"
+	)
+	transientCodes := []codes.Code{
+		codes.Canceled,
+		codes.DeadlineExceeded,
+		codes.Unavailable,
+		codes.Aborted,
+	}
+	for _, code := range transientCodes {
+		t.Run(code.String(), func(t *testing.T) {
+			tmpdir := tempDir(t)
+			defer os.RemoveAll(tmpdir)
+			mockController, driver, _, controllerServer, csiConn, err := createMockServer(t, tmpdir)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer mockController.Finish()
+			defer driver.Stop()
+
+			controllerServer.EXPECT().GetCapacity(gomock.Any(), gomock.Any()).Return(&csi.GetCapacityResponse{AvailableCapacity: 1024 * 1024 * 1024 * 1024}, nil).AnyTimes()
+			// The first attempt fails with a transient error, the retry succeeds.
+			controllerServer.EXPECT().CreateVolume(gomock.Any(), gomock.Any()).Return(nil, status.Error(code, "transient failure")).Times(1)
+			controllerServer.EXPECT().CreateVolume(gomock.Any(), gomock.Any()).Return(&csi.CreateVolumeResponse{
+				Volume: &csi.Volume{
+					VolumeId:      "test-volume-id",
+					CapacityBytes: reqBytes,
+				},
+			}, nil).Times(1)
+
+			node := &v1.Node{ObjectMeta: metav1.ObjectMeta{Name: nodeName, Labels: map[string]string{driverTopologyKey: nodeName}}}
+			csiNode := &storagev1.CSINode{
+				ObjectMeta: metav1.ObjectMeta{Name: nodeName},
+				Spec: storagev1.CSINodeSpec{
+					Drivers: []storagev1.CSINodeDriver{
+						{Name: driverName, NodeID: nodeName, TopologyKeys: []string{driverTopologyKey}},
+					},
+				},
+			}
+			mode := storagev1.VolumeBindingImmediate
+			reclaim := v1.PersistentVolumeReclaimDelete
+			sc := &storagev1.StorageClass{
+				ObjectMeta:        metav1.ObjectMeta{Name: fakeSCName},
+				ReclaimPolicy:     &reclaim,
+				VolumeBindingMode: &mode,
+			}
+			// This node already owns the claim.
+			claim := createFakeNamedPVC(reqBytes, "fake-pvc", map[string]string{annSelectedNode: nodeName})
+
+			clientSet := fakeclientset.NewSimpleClientset(sc, node, csiNode, claim)
+			informerFactory := informers.NewSharedInformerFactory(clientSet, 0)
+			claimInformer := informerFactory.Core().V1().PersistentVolumeClaims()
+			scInformer := informerFactory.Storage().V1().StorageClasses()
+			nodeInformer := informerFactory.Core().V1().Nodes()
+			csiNodeInformer := informerFactory.Storage().V1().CSINodes()
+			claimInformer.Informer().GetStore().Add(claim)
+			scInformer.Informer().GetStore().Add(sc)
+			nodeInformer.Informer().GetStore().Add(node)
+			csiNodeInformer.Informer().GetStore().Add(csiNode)
+
+			nodeDeployment := &NodeDeployment{
+				NodeName:         nodeName,
+				ClaimInformer:    claimInformer,
+				ImmediateBinding: true,
+			}
+			pluginCaps, controllerCaps := provisionCapabilities()
+			csiProvisioner := NewCSIProvisioner(clientSet, 5*time.Second, "test-provisioner", "test", 5, csiConn.conn,
+				nil, driverName, pluginCaps, controllerCaps, "", false, true, csitrans.New(), scInformer.Lister(), csiNodeInformer.Lister(), nodeInformer.Lister(), nil, nil, false, defaultfsType, nodeDeployment)
+
+			options := controller.ProvisionOptions{
+				StorageClass: sc,
+				PVName:       "test-name",
+				PVC:          claim,
+				SelectedNode: node,
+			}
+
+			pv, state, err := csiProvisioner.Provision(context.Background(), options)
+			if err == nil {
+				t.Fatal("expected error from the first attempt, got none")
+			}
+			if pv != nil {
+				t.Errorf("expected no PV from the first attempt, got %v", pv)
+			}
+			if state != controller.ProvisioningInBackground {
+				t.Errorf("expected provisioning state %s after transient error %s, got %s", controller.ProvisioningInBackground, code, state)
+			}
+
+			pv, state, err = csiProvisioner.Provision(context.Background(), options)
+			if err != nil {
+				t.Fatalf("expected retry to succeed, got error: %v", err)
+			}
+			if state != controller.ProvisioningFinished {
+				t.Errorf("expected provisioning state %s on retry, got %s", controller.ProvisioningFinished, state)
+			}
+			if pv == nil {
+				t.Fatal("expected PV on retry, got nil")
+			}
 		})
 	}
 }
