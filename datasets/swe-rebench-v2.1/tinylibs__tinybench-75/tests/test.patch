diff --git a/test/sequential.test.ts b/test/sequential.test.ts
index 59d13a2..72f512c 100644
--- a/test/sequential.test.ts
+++ b/test/sequential.test.ts
@@ -28,3 +28,42 @@ test('sequential', async () => {
   await sequentialBench.run();
   expect(isFirstTaskDefined).toBe(true);
 });
+
+const addTrackedTasks = (bench: Bench, count: number, delay: number) => {
+  let active = 0;
+  let peak = 0;
+  let completed = 0;
+
+  for (let index = 0; index < count; index++) {
+    bench.add(`task ${index}`, async () => {
+      active++;
+      peak = Math.max(peak, active);
+      await setTimeout(delay);
+      active--;
+      completed++;
+    });
+  }
+
+  return () => ({ peak, completed });
+};
+
+test('concurrent tasks overlap', async () => {
+  const bench = new Bench({ time: 0, iterations: 1 });
+  const getProgress = addTrackedTasks(bench, 3, 20);
+
+  await bench.runConcurrently();
+
+  expect(getProgress().peak).toBeGreaterThan(1);
+  expect(getProgress().completed).toBe(3);
+});
+
+test('concurrent tasks respect the configured limit', async () => {
+  const bench = new Bench({ time: 0, iterations: 1 });
+  const getProgress = addTrackedTasks(bench, 5, 20);
+
+  await bench.runConcurrently(2);
+
+  expect(getProgress().peak).toBeLessThanOrEqual(2);
+  expect(getProgress().peak).toBeGreaterThan(1);
+  expect(getProgress().completed).toBe(5);
+});
