+#[test]
+fn remove_dev_deps_without_subcommand() {
+    let dir = env::temp_dir().join(format!("cargo-hack-remove-dev-deps-{}", std::process::id()));
+    if dir.exists() {
+        fs::remove_dir_all(&dir).unwrap();
+    }
+    fs::create_dir_all(dir.join("support/src")).unwrap();
+    fs::create_dir_all(dir.join("src")).unwrap();
+    let manifest_path = dir.join("Cargo.toml");
+    fs::write(
+        &manifest_path,
+        "\
+[package]
+name = \"remove-dev-deps-target\"
+version = \"0.1.0\"
+edition = \"2018\"
+
+[dev-dependencies]
+support = { path = \"support\" }
+",
+    )
+    .unwrap();
+    fs::write(
+        dir.join("support/Cargo.toml"),
+        "[package]\nname = \"support\"\nversion = \"0.1.0\"\nedition = \"2018\"\n",
+    )
+    .unwrap();
+    fs::write(dir.join("support/src/lib.rs"), "").unwrap();
+    fs::write(dir.join("src/lib.rs"), "").unwrap();
+
+    let output = cargo_hack()
+        .arg("--remove-dev-deps")
+        .current_dir(&dir)
+        .output()
+        .unwrap();
+    let updated_manifest = fs::read_to_string(&manifest_path).unwrap();
+    fs::remove_dir_all(&dir).unwrap();
+
+    output.assert_success();
+    assert!(!updated_manifest.contains("support = { path = \"support\" }"));
+}
