+"""Unit tests for `.also()`."""
+from unittest.mock import Mock
+
+import pytest
+
+
+def remove_rows_3_and_4(df):
+    """Return a dataframe with rows 3 and 4 removed."""
+    df = df.drop(3, axis=0)
+    df = df.drop(4, axis=0)
+    return df
+
+
+@pytest.mark.functions
+def test_also_runs_function_on_dataframe(dataframe):
+    """Test that `.also()` invokes the function with the chained dataframe."""
+    method = Mock(return_value=None)
+    result = dataframe.also(method)
+
+    assert result is dataframe
+    assert method.called
+    assert method.call_args[0][0].equals(dataframe)
+
+
+@pytest.mark.functions
+def test_also_returns_input_instead_of_function_result(dataframe):
+    """Test that `.also()` returns its input, not the function result."""
+    result = dataframe.also(remove_rows_3_and_4)
+
+    assert result is dataframe
