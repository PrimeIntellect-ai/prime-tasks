+func TestPlaceDetailsSecondaryOpeningHours(t *testing.T) {
+	response := `
+{
+    "html_attributions": [],
+    "result": {
+        "place_id": "ChIJ4cQcDV2uEmsRMxTEHBIe9ZQ",
+        "secondary_opening_hours": [
+            {
+                "open_now": true,
+                "periods": [
+                    {
+                        "close": {
+                            "day": 0,
+                            "time": "2045"
+                        },
+                        "open": {
+                            "day": 0,
+                            "time": "1200"
+                        }
+                    }
+                ],
+                "type": "KITCHEN",
+                "weekday_text": [
+                    "Monday: 11:30 AM - 2:00 PM"
+                ]
+            }
+        ]
+    },
+    "status": "OK"
+}`
+
+	server := mockServer(200, response)
+	defer server.Close()
+	c, _ := NewClient(WithAPIKey(apiKey), WithBaseURL(server.URL))
+	r := &PlaceDetailsRequest{
+		PlaceID: "ChIJ4cQcDV2uEmsRMxTEHBIe9ZQ",
+		Fields:  []PlaceDetailsFieldMask{PlaceDetailsFieldMaskSecondaryOpeningHours},
+	}
+
+	resp, err := c.PlaceDetails(context.Background(), r)
+	if err != nil {
+		t.Fatalf("PlaceDetails returned an error for an array of secondary opening hours: %v", err)
+	}
+
+	// The API returns secondary_opening_hours as a JSON array, so the result must
+	// expose it as a slice holding every returned entry.
+	var hours []OpeningHours
+	switch v := interface{}(resp.SecondaryOpeningHours).(type) {
+	case []OpeningHours:
+		hours = v
+	case []*OpeningHours:
+		for _, h := range v {
+			if h != nil {
+				hours = append(hours, *h)
+			}
+		}
+	default:
+		t.Fatalf("SecondaryOpeningHours is not a slice of OpeningHours: %T", resp.SecondaryOpeningHours)
+	}
+
+	if len(hours) != 1 {
+		t.Fatalf("expected 1 secondary opening-hours entry, got %d", len(hours))
+	}
+	if len(hours[0].Periods) == 0 {
+		t.Fatalf("expected secondary opening-hours periods to be populated")
+	}
+	if hours[0].Periods[0].Open.Day != time.Sunday || hours[0].Periods[0].Close.Day != time.Sunday {
+		t.Errorf("SecondaryOpeningHours[0].Periods[0] Open/Close day incorrect")
+	}
+	if hours[0].Periods[0].Open.Time != "1200" || hours[0].Periods[0].Close.Time != "2045" {
+		t.Errorf("SecondaryOpeningHours[0].Periods[0] Open/Close time incorrect")
+	}
+}
+
