+#[test]
+fn test_float_literal_parsing() {
+    assert_eq!(ron::from_str::<i64>("1_0"), Ok(10));
+    assert_eq!(ron::from_str("1"), Ok(1.0_f64));
+    assert_eq!(ron::from_str("+1"), Ok(1.0_f64));
+    assert_eq!(ron::from_str("-1"), Ok(-1.0_f64));
+
+    assert_eq!(ron::from_str("1e3"), Ok(1000.0_f64));
+    assert_eq!(ron::from_str("1e+1"), Ok(10.0_f64));
+    assert_eq!(ron::from_str("7E-1"), Ok(0.7_f64));
+    assert_eq!(ron::from_str("-1.5e3"), Ok(-1500.0_f64));
+    assert_eq!(ron::from_str("1.e+1"), Ok(10.0_f64));
+    assert_eq!(ron::from_str("7.4E-1"), Ok(0.74_f64));
+    assert_eq!(ron::from_str("-.5e3"), Ok(-500.0_f64));
+    assert_eq!(ron::from_str(".3e+1"), Ok(3.0_f64));
+    assert_eq!(ron::from_str(".4E-1"), Ok(0.04_f64));
+
+    assert!(ron::from_str::<f64>("1_0.1_0").is_err());
+    assert!(ron::from_str::<f64>("1_0.10").is_err());
+    assert!(ron::from_str::<f64>("10.1_0").is_err());
+    assert!(ron::from_str::<f64>("1.0e1.0").is_err());
+}
+
+#[derive(Clone)]
+enum Ebnf {
+    Literal(String),
+    Reference(String),
+    Sequence(Vec<Ebnf>),
+    Alternative(Vec<Ebnf>),
+    Optional(Box<Ebnf>),
+    Repetition(Box<Ebnf>),
+}
+
+struct EbnfParser {
+    chars: Vec<char>,
+    pos: usize,
+}
+
+impl EbnfParser {
+    fn new(input: &str) -> Self {
+        Self {
+            chars: input.chars().collect(),
+            pos: 0,
+        }
+    }
+
+    fn whitespace(&mut self) {
+        while self.chars.get(self.pos).is_some_and(|c| c.is_whitespace()) {
+            self.pos += 1;
+        }
+    }
+
+    fn take(&mut self, expected: char) -> bool {
+        self.whitespace();
+        if self.chars.get(self.pos) == Some(&expected) {
+            self.pos += 1;
+            true
+        } else {
+            false
+        }
+    }
+
+    fn expression(&mut self) -> Ebnf {
+        let mut alternatives = vec![self.sequence()];
+        while self.take('|') {
+            alternatives.push(self.sequence());
+        }
+        if alternatives.len() == 1 {
+            alternatives.pop().unwrap()
+        } else {
+            Ebnf::Alternative(alternatives)
+        }
+    }
+
+    fn sequence(&mut self) -> Ebnf {
+        let mut items = vec![self.factor()];
+        while self.take(',') {
+            items.push(self.factor());
+        }
+        if items.len() == 1 {
+            items.pop().unwrap()
+        } else {
+            Ebnf::Sequence(items)
+        }
+    }
+
+    fn factor(&mut self) -> Ebnf {
+        self.whitespace();
+        match self.chars[self.pos] {
+            '(' => {
+                self.pos += 1;
+                let value = self.expression();
+                assert!(self.take(')'));
+                value
+            }
+            '[' | '{' => {
+                let opening = self.chars[self.pos];
+                self.pos += 1;
+                let value = Box::new(self.expression());
+                let closing = if opening == '[' { ']' } else { '}' };
+                assert!(self.take(closing));
+                if opening == '[' {
+                    Ebnf::Optional(value)
+                } else {
+                    Ebnf::Repetition(value)
+                }
+            }
+            '"' => {
+                self.pos += 1;
+                let start = self.pos;
+                while self.chars[self.pos] != '"' {
+                    self.pos += 1;
+                }
+                let value = self.chars[start..self.pos].iter().collect();
+                self.pos += 1;
+                Ebnf::Literal(value)
+            }
+            _ => {
+                let start = self.pos;
+                while self.chars.get(self.pos).is_some_and(|c| c.is_alphanumeric() || *c == '_') {
+                    self.pos += 1;
+                }
+                assert_ne!(start, self.pos, "expected an EBNF term");
+                Ebnf::Reference(self.chars[start..self.pos].iter().collect())
+            }
+        }
+    }
+}
+
+fn grammar_productions(grammar: &str) -> std::collections::HashMap<String, String> {
+    let mut productions = std::collections::HashMap::new();
+    let mut in_ebnf = false;
+    let mut ebnf = String::new();
+    for line in grammar.lines() {
+        if line.trim() == "```ebnf" {
+            in_ebnf = true;
+        } else if line.trim() == "```" {
+            in_ebnf = false;
+        } else if in_ebnf {
+            ebnf.push_str(line);
+            ebnf.push('\n');
+        }
+    }
+    for rule in ebnf.split(';') {
+        if let Some((name, rhs)) = rule.split_once('=') {
+            productions.insert(name.trim().to_owned(), rhs.trim().to_owned());
+        }
+    }
+    productions
+}
+
+fn grammar_matches(
+    name: &str,
+    input: &[char],
+    start: usize,
+    productions: &std::collections::HashMap<String, String>,
+    references: &mut Vec<(String, usize)>,
+) -> Vec<usize> {
+    let rule = productions.get(name).unwrap_or_else(|| panic!("missing {} rule", name));
+    if references
+        .iter()
+        .any(|(reference, position)| reference == name && *position == start)
+    {
+        return Vec::new();
+    }
+    references.push((name.to_owned(), start));
+    let expression = EbnfParser::new(rule).expression();
+    let matches = match_ebnf(&expression, input, start, productions, references);
+    references.pop();
+    matches
+}
+
+fn match_ebnf(
+    expression: &Ebnf,
+    input: &[char],
+    start: usize,
+    productions: &std::collections::HashMap<String, String>,
+    references: &mut Vec<(String, usize)>,
+) -> Vec<usize> {
+    match expression {
+        Ebnf::Literal(value) => {
+            let chars: Vec<_> = value.chars().collect();
+            if input.get(start..start + chars.len()) == Some(chars.as_slice()) {
+                vec![start + chars.len()]
+            } else {
+                Vec::new()
+            }
+        }
+        Ebnf::Reference(name) => grammar_matches(name, input, start, productions, references),
+        Ebnf::Alternative(alternatives) => alternatives
+            .iter()
+            .flat_map(|alternative| match_ebnf(alternative, input, start, productions, references))
+            .collect(),
+        Ebnf::Sequence(items) => items.iter().fold(vec![start], |positions, item| {
+            positions
+                .into_iter()
+                .flat_map(|position| match_ebnf(item, input, position, productions, references))
+                .collect()
+        }),
+        Ebnf::Optional(inner) => {
+            let mut positions = vec![start];
+            positions.extend(match_ebnf(inner, input, start, productions, references));
+            positions
+        }
+        Ebnf::Repetition(inner) => {
+            let mut positions = vec![start];
+            let mut reached = std::collections::HashSet::from([start]);
+            let mut pending = vec![start];
+            while let Some(position) = pending.pop() {
+                for next in match_ebnf(inner, input, position, productions, references) {
+                    if next != position && reached.insert(next) {
+                        positions.push(next);
+                        pending.push(next);
+                    }
+                }
+            }
+            positions
+        }
+    }
+}
+
+#[test]
+fn documented_float_grammar_allows_integer_and_signed_exponents() {
+    let grammar = include_str!("../docs/grammar.md");
+    let productions = grammar_productions(grammar);
+
+    for input in ["1e1", "1e+1", "1e-1"] {
+        let chars: Vec<_> = input.chars().collect();
+        let matches = grammar_matches("float", &chars, 0, &productions, &mut Vec::new());
+        assert!(matches.contains(&chars.len()), "float grammar does not allow {}", input);
+    }
+}
