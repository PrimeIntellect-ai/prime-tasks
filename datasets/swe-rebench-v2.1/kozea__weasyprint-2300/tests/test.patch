+def test_flex_overflow():
+    # Regression test for https://github.com/Kozea/WeasyPrint/issues/2292
+    page, = render_pages('''
+<style>
+  article {
+    display: flex;
+  }
+  section {
+    overflow: hidden;
+    flex: 1;
+  }
+</style>
+<article>
+  <section>A</section>
+  <section>B</section>
+</article>
+''')
+    html, = page.children
+    body, = html.children
+    article, = body.children
+    section_1 = article.children[0]
+    section_2 = article.children[1]
+    assert section_1.position_x + section_1.width <= section_2.position_x
