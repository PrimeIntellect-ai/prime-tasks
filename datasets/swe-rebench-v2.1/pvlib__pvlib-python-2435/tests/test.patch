+def test_sapm_notes_state_required_params():
+    # the notes must say which module parameters the model requires,
+    # outside of the full coefficient table
+    doc = inspect.cleandoc(pvsystem.sapm.__doc__)
+    notes = doc.split('Notes\n-----', 1)[1]
+    notes_before_table = notes.split('====', 1)[0]
+    required = ['C0', 'C1', 'C2', 'C3', 'Isco', 'Impo', 'Voco', 'Vmpo',
+                'Aisc', 'Aimp', 'Bvoco', 'Mbvoc', 'Bvmpo', 'Mbvmp', 'N',
+                'Cells_in_Series']
+    for key in required:
+        flags = 0 if len(key) == 1 else re.IGNORECASE
+        assert re.search(r'\b{}\b'.format(re.escape(key)),
+                         notes_before_table, flags), key
+
+
