+func messageFileForTest(t *testing.T) string {
+	t.Helper()
+
+	content, err := os.ReadFile("tests/.test.message")
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "message.md")
+	if err := os.WriteFile(path, content, 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func messageFileContext(t *testing.T, args ...string) *cli.Context {
+	t.Helper()
+	t.Setenv("DRONE_COMMIT_MESSAGE", "update travis")
+
+	set := flag.NewFlagSet("test", flag.ContinueOnError)
+	cli.StringFlag{Name: "message.file", EnvVar: "PLUGIN_MESSAGE_FILE"}.Apply(set)
+	cli.StringFlag{Name: "token", EnvVar: "PLUGIN_TOKEN"}.Apply(set)
+	cli.StringSliceFlag{Name: "to", EnvVar: "PLUGIN_TO"}.Apply(set)
+	cli.StringFlag{Name: "commit.message", EnvVar: "DRONE_COMMIT_MESSAGE"}.Apply(set)
+	if err := set.Parse(args); err != nil {
+		t.Fatal(err)
+	}
+	return cli.NewContext(nil, set, nil)
+}
+
+func TestMessageFile(t *testing.T) {
+	messages := newFakeTelegramServer(t)
+	path := messageFileForTest(t)
+	ctx := messageFileContext(t, "--message.file", path, "--token", "123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11", "--to", "1")
+
+	err := run(ctx)
+	assert.Nil(t, err)
+	if assert.Len(t, *messages, 1) {
+		assert.Contains(t, (*messages)[0], "Sample message loaded from file.")
+		assert.Contains(t, (*messages)[0], "update travis")
+	}
+}
+
+func TestMessageFileError(t *testing.T) {
