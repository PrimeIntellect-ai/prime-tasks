+
+    def test_text_to_video_client_api(self, monkeypatch):
+        class FakeResponse:
+            def __init__(self, content):
+                self.status_code = 200
+                self.headers = {}
+                self.content = content
+                self.url = "https://example.test/"
+
+            def raise_for_status(self):
+                pass
+
+        posted = {}
+
+        def fake_request(session, method, url, **kwargs):
+            if method == "POST":
+                posted.update(json=kwargs["json"])
+                return FakeResponse(b'{"output":"https://example.test/video"}')
+            return FakeResponse(b"video bytes")
+
+        monkeypatch.setattr("requests.sessions.Session.request", fake_request)
+
+        client = InferenceClient(provider="replicate", token="my_replicate_key")
+        video = client.text_to_video("A sunset over the ocean", model="genmo/mochi-1-preview")
+
+        assert video == b"video bytes"
+        assert posted["json"]["input"]["prompt"] == "A sunset over the ocean"
+
