+    def test_prepare_request_text_to_video(self):
+        assert "text-to-video" in replicate.SUPPORTED_MODELS
+        assert "genmo/mochi-1-preview" in replicate.SUPPORTED_MODELS["text-to-video"]
+        helper = replicate.ReplicateTask("text-to-video")
+        request = helper.prepare_request(
+            inputs="this is a dummy input",
+            parameters={},
+            headers={},
+            model="genmo/mochi-1-preview",
+            api_key="my_replicate_key",
+        )
+        assert request.task == "text-to-video"
+        assert "input" in request.json
+        assert "prompt" in request.json["input"]
+
+    def test_prepare_request_text_to_speech(self):
+        assert "text-to-speech" in replicate.SUPPORTED_MODELS
+        assert "OuteAI/OuteTTS-0.3-500M" in replicate.SUPPORTED_MODELS["text-to-speech"]
+        helper = replicate.ReplicateTask("text-to-speech")
+        request = helper.prepare_request(
+            inputs="this is a dummy input",
+            parameters={},
+            headers={},
+            model="OuteAI/OuteTTS-0.3-500M",
+            api_key="my_replicate_key",
+        )
+        assert request.task == "text-to-speech"
+        assert "input" in request.json
+
+    def test_provider_registry_exposes_new_tasks(self):
+        assert get_provider_helper("replicate", "text-to-video").task == "text-to-video"
+        assert get_provider_helper("replicate", "text-to-speech").task == "text-to-speech"
+
