+
+#[test]
+fn as_span_does_not_consume_pair() {
+    let input = "{\"a\": [null, true, 3.4]}";
+
+    let pair = JsonParser::parse(Rule::json, input)
+        .unwrap()
+        .next()
+        .unwrap();
+
+    // `as_span` returns a span covering the region matched by the pair...
+    assert_eq!(pair.as_span().as_str(), input);
+
+    // ...and borrows the pair instead of consuming it, so the same pair can
+    // still be used to reach its inner pairs afterwards.
+    let inner = pair.into_inner().next().unwrap();
+    assert_eq!(inner.as_rule(), Rule::object);
+    assert_eq!(inner.as_span().as_str(), input);
+}
