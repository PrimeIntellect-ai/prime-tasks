+func TestVacateCommandExposesOverrideFailsafe(t *testing.T) {
+	cmd := exec.Command("go", "run", ".", "platform", "allocator", "vacate", "--help")
+	cmd.Dir = "../../../"
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("vacate help command failed: %v\n%s", err, output)
+	}
+	if !strings.Contains(string(output), "--override-failsafe") {
+		t.Fatalf("vacate help does not expose the override-failsafe option:\n%s", output)
+	}
+}
