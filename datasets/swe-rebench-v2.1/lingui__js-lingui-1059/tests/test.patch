+describe("development plural rendering", function () {
+  const React = require("react")
+  const { render, cleanup } = require("@testing-library/react")
+  const { Trans, I18nProvider } = require("@lingui/react")
+  const { setupI18n } = require("@lingui/core")
+
+  const createI18n = () => setupI18n({
+    locale: "en",
+    localeData: { en: { plurals: (count) => count === 1 ? "one" : "other" } },
+  })
+
+  afterEach(() => cleanup())
+
+  it("renders updated plural source from a Plural-generated message without a catalog", function () {
+    const i18n = createI18n()
+    const firstMessage = "{count, plural, one {job} other {jobs}}"
+    const updatedMessage = "{count, plural, one {task} other {tasks}}"
+    const renderMessage = (message) => React.createElement(
+      I18nProvider,
+      { i18n },
+      React.createElement(Trans, {
+        id: message,
+        message,
+        values: { count: 1 },
+      })
+    )
+    const view = render(renderMessage(firstMessage))
+
+    expect(view.container.textContent).toBe("job")
+    view.rerender(renderMessage(updatedMessage))
+    expect(view.container.textContent).toBe("task")
+  })
+
+  it("formats a raw ICU plural message without a catalog", function () {
+    const i18n = createI18n()
+    const updatedMessage = "{count, plural, one {inventory} other {inventories}}"
+
+    expect(i18n._(updatedMessage, { count: 1 })).toBe("inventory")
+    expect(i18n._(updatedMessage, { count: 4 })).toBe("inventories")
+  })
+
+  it("uses the singular for one and the plural for counts greater than one", function () {
+    const i18n = createI18n()
+    const message = "{count, plural, one {job} other {jobs}}"
+
+    expect(i18n._(message, { count: 1 })).toBe("job")
+    expect(i18n._(message, { count: 2 })).toBe("jobs")
+  })
+})
+
+describe("ESM development entrypoint", function () {
+  const { execFileSync } = require("child_process")
+
+  beforeAll(() => {
+    execFileSync(process.execPath, ["scripts/build"], {
+      cwd: process.cwd(),
+      stdio: "ignore",
+    })
+  })
+
+  it("formats an unextracted ICU plural message in development", function () {
+    const entrypoint = path.join(
+      process.cwd(),
+      "packages/core/build/esm/index.js"
+    )
+    const script = `
+      const babel = require("@babel/core")
+      const originalJsLoader = require.extensions[".js"]
+      require.extensions[".js"] = (module, filename) => {
+        if (filename.startsWith(${JSON.stringify(path.dirname(entrypoint))} + path.sep)) {
+          const { code } = babel.transformFileSync(filename, {
+            babelrc: false,
+            configFile: false,
+            plugins: ["@babel/plugin-transform-modules-commonjs"],
+          })
+          module._compile(code, filename)
+        } else {
+          originalJsLoader(module, filename)
+        }
+      }
+      const { setupI18n } = require(${JSON.stringify(entrypoint)})
+      const i18n = setupI18n({
+        locale: "en",
+        localeData: { en: { plurals: (count) => count === 1 ? "one" : "other" } },
+      })
+      process.stdout.write(i18n._("{count, plural, one {job} other {jobs}}", { count: 1 }))
+    `
+
+    const rendered = execFileSync(process.execPath, ["-e", script], {
+      cwd: process.cwd(),
+      env: { ...process.env, NODE_ENV: "development" },
+    }).toString()
+
+    expect(rendered).toBe("job")
+  })
+})
