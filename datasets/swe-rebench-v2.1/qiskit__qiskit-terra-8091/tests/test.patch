+"""Tests for primitive results."""
+
+from __future__ import annotations
+
+from collections.abc import Collection
+from dataclasses import dataclass
+from typing import Any
+
+import numpy as np
+from ddt import data, ddt, unpack
+
+from qiskit.primitives import EstimatorResult, SamplerResult
+from qiskit.result import QuasiDistribution
+from qiskit.test import QiskitTestCase
+
+
+def _base_result_class():
+    """Return a stub result dataclass inheriting from the public base result class."""
+    from qiskit.primitives.base_result import BasePrimitiveResult
+
+    @dataclass
+    class Result(BasePrimitiveResult):
+        """Dummy result dataclass implementing BasePrimitiveResult."""
+
+        field_1: Collection[Any]
+        field_2: Collection[Any]
+
+    return Result
+
+
+################################################################################
+## TESTS
+################################################################################
+@ddt
+class TestBasePrimitiveResult(QiskitTestCase):
+    """Tests the common behaviour of primitive results."""
+
+    @data(0, 1.2, True, "sequence", b"sequence", {"name": "value"})
+    def test_post_init_type_error(self, field_1):
+        """Tests post init type error."""
+        result_cls = _base_result_class()
+        self.assertRaises(TypeError, result_cls, *(field_1, []))
+
+    @data(([1], []), ([], [1]), ([1, 2], []), ([1], [1, 2]))
+    @unpack
+    def test_post_init_value_error(self, field_1, field_2):
+        """Tests post init value error."""
+        result_cls = _base_result_class()
+        self.assertRaises(ValueError, result_cls, *(field_1, field_2))
+
+    @data(0, 1, 2, 3)
+    def test_num_experiments(self, num_experiments):
+        """Tests {num_experiments} num_experiments."""
+        result_cls = _base_result_class()
+        result = result_cls([0] * num_experiments, [1] * num_experiments)
+        self.assertEqual(num_experiments, result.num_experiments)
+
+    @data(0, 1, 2, 3)
+    def test_experiments(self, num_experiments):
+        """Test experiment data."""
+        result_cls = _base_result_class()
+        field_1 = list(range(num_experiments))
+        field_2 = [i + 1 for i in range(num_experiments)]
+        experiments = result_cls(field_1, field_2).experiments
+        self.assertIsInstance(experiments, tuple)
+        for i, exp in enumerate(experiments):
+            self.assertEqual(exp, {"field_1": i, "field_2": i + 1})
+
+    @data(0, 1, 2, 3)
+    def test_decompose(self, num_experiments):
+        """Test decompose."""
+        result_cls = _base_result_class()
+        field_1 = list(range(num_experiments))
+        field_2 = [i + 1 for i in range(num_experiments)]
+        result = result_cls(field_1, field_2)
+        for i, res in enumerate(result.decompose()):
+            self.assertIsInstance(res, result_cls)
+            f1, f2 = (i,), (i + 1,)
+            self.assertEqual(res, result_cls(f1, f2))
+
+
+@ddt
+class TestSamplerResult(QiskitTestCase):
+    """Tests SamplerResult."""
+
+    def test_experiments(self):
+        """Each experiment exposes the matching sampler fields."""
+        quasi_dists = [QuasiDistribution({0: 1.0}), QuasiDistribution({1: 1.0})]
+        metadata = [{"index": 0}, {"index": 1}]
+        result = SamplerResult(quasi_dists, metadata)
+
+        self.assertEqual(
+            result.experiments,
+            (
+                {"quasi_dists": quasi_dists[0], "metadata": metadata[0]},
+                {"quasi_dists": quasi_dists[1], "metadata": metadata[1]},
+            ),
+        )
+
+    def test_decompose(self):
+        """Decomposition preserves sampler type and one experiment per result."""
+        quasi_dists = [QuasiDistribution({0: 1.0}), QuasiDistribution({1: 1.0})]
+        metadata = [{"index": 0}, {"index": 1}]
+        result = SamplerResult(quasi_dists, metadata)
+
+        decomposed = list(result.decompose())
+
+        self.assertEqual(len(decomposed), 2)
+        for index, single_result in enumerate(decomposed):
+            self.assertIsInstance(single_result, SamplerResult)
+            self.assertEqual(single_result.quasi_dists, (quasi_dists[index],))
+            self.assertEqual(single_result.metadata, (metadata[index],))
+
+    @data(0, 1, 2, 3)
+    def test_num_experiments(self, num_experiments):
+        """Tests {num_experiments} num_experiments."""
+        quasi_dists = [QuasiDistribution({0: 1.0}) for _ in range(num_experiments)]
+        metadata = [{} for _ in range(num_experiments)]
+        result = SamplerResult(quasi_dists, metadata)
+        self.assertEqual(num_experiments, result.num_experiments)
+
+    def test_inconsistent_num_experiments(self):
+        """Tests that inconsistent data fields raise a ValueError."""
+        self.assertRaises(ValueError, SamplerResult, [QuasiDistribution({0: 1.0})], [])
+
+
+@ddt
+class TestEstimatorResult(QiskitTestCase):
+    """Tests EstimatorResult."""
+
+    def test_experiments(self):
+        """Each experiment exposes the matching estimator fields."""
+        values = np.array([0.25, 0.75])
+        metadata = [{"index": 0}, {"index": 1}]
+        result = EstimatorResult(values, metadata)
+
+        self.assertEqual(
+            result.experiments,
+            (
+                {"values": values[0], "metadata": metadata[0]},
+                {"values": values[1], "metadata": metadata[1]},
+            ),
+        )
+
+    def test_decompose(self):
+        """Decomposition preserves estimator type and one experiment per result."""
+        values = np.array([0.25, 0.75])
+        metadata = [{"index": 0}, {"index": 1}]
+        result = EstimatorResult(values, metadata)
+
+        decomposed = list(result.decompose())
+
+        self.assertEqual(len(decomposed), 2)
+        for index, single_result in enumerate(decomposed):
+            self.assertIsInstance(single_result, EstimatorResult)
+            self.assertEqual(single_result.values, (values[index],))
+            self.assertEqual(single_result.metadata, (metadata[index],))
+
+    @data(0, 1, 2, 3)
+    def test_num_experiments(self, num_experiments):
+        """Tests {num_experiments} num_experiments."""
+        values = np.array([0.0] * num_experiments)
+        metadata = [{} for _ in range(num_experiments)]
+        result = EstimatorResult(values, metadata)
+        self.assertEqual(num_experiments, result.num_experiments)
+
+    def test_inconsistent_num_experiments(self):
+        """Tests that inconsistent data fields raise a ValueError."""
+        self.assertRaises(ValueError, EstimatorResult, np.array([0.0]), [])
