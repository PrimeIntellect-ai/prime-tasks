+use ron::{
+    de::from_str,
+    ser::{to_string, to_string_pretty, PrettyConfig},
+};
+
+// Keeps this test buildable against the base API, which has no such option.
+// On implementations providing the required inherent builder, that method is
+// selected; otherwise the default config lets the behavior assertion run.
+trait EscapeStringsOption {
+    fn escape_strings(self, escape_strings: bool) -> Self;
+}
+
+impl EscapeStringsOption for PrettyConfig {
+    fn escape_strings(self, _escape_strings: bool) -> Self {
+        self
+    }
+}
+
+fn test_string_roundtrip(s: &str, config: Option<PrettyConfig>) -> String {
+    let ser = match config {
+        Some(config) => to_string_pretty(s, config),
+        None => to_string(s),
+    }
+    .unwrap();
+
+    let de: String = from_str(&ser).unwrap();
+
+    assert_eq!(s, de);
+
+    ser
+}
+
+#[test]
+fn test_escaped_string() {
+    let config = Some(PrettyConfig::default());
+
+    assert_eq!(test_string_roundtrip("a\nb", None), r#""a\nb""#);
+    assert_eq!(test_string_roundtrip("a\nb", config.clone()), r#""a\nb""#);
+
+    assert_eq!(test_string_roundtrip("", None), "\"\"");
+    assert_eq!(test_string_roundtrip("", config.clone()), "\"\"");
+
+    assert_eq!(test_string_roundtrip("\"", None), r#""\"""#);
+    assert_eq!(test_string_roundtrip("\"", config.clone()), r#""\"""#);
+
+    assert_eq!(test_string_roundtrip("#", None), "\"#\"");
+    assert_eq!(test_string_roundtrip("#", config.clone()), "\"#\"");
+
+    assert_eq!(test_string_roundtrip("\"#", None), r##""\"#""##);
+    assert_eq!(test_string_roundtrip("\"#", config.clone()), r##""\"#""##);
+
+    assert_eq!(test_string_roundtrip("#\"#", None), r##""#\"#""##);
+    assert_eq!(test_string_roundtrip("#\"#", config.clone()), r##""#\"#""##);
+
+    assert_eq!(test_string_roundtrip("#\"##", None), r###""#\"##""###);
+    assert_eq!(test_string_roundtrip("#\"##", config), r###""#\"##""###);
+}
+
+#[test]
+fn test_unescaped_multiline_string() {
+    let value = "a\nb\nc";
+    let config = PrettyConfig::default().escape_strings(false);
+    let serialized = test_string_roundtrip(value, Some(config));
+
+    assert!(
+        serialized.contains('\n'),
+        "expected line breaks to appear literally in {serialized:?}"
+    );
+}
+
+#[test]
+fn test_unescaped_multiline_string_with_quotes_and_hashes() {
+    let value = "a\nquote \" and #\nmore \"##\nend";
+    let config = PrettyConfig::default().escape_strings(false);
+    let serialized = test_string_roundtrip(value, Some(config));
+
+    assert!(
+        serialized.contains('\n'),
+        "expected line breaks to appear literally in {serialized:?}"
+    );
+}
