+def test_searchcv_digits_example():
+    """The BayesSearchCV workflow from the reported issue must fit and expose
+    the best training score and the held-out score."""
+    X, y = load_digits(n_class=10, return_X_y=True)
+    X_train, X_test, y_train, y_test = train_test_split(
+        X, y, train_size=0.75, test_size=0.25, random_state=0
+    )
+
+    opt = BayesSearchCV(
+        SVC(),
+        {
+            "C": (1e-6, 1e6, "log-uniform"),
+            "gamma": (1e-6, 1e6, "log-uniform"),
+            "kernel": ["linear", "rbf"],
+        },
+        n_iter=32,
+        cv=3,
+    )
+
+    opt.fit(X_train, y_train)
+
+    best_train_score = float(opt.best_score_)
+    assert 0.0 <= best_train_score <= 1.0
+
+    held_out_score = float(opt.score(X_test, y_test))
+    assert 0.0 <= held_out_score <= 1.0
