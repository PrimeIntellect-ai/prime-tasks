+package com.softwaremill.jox.flows;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.lang.reflect.RecordComponent;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+
+import org.junit.jupiter.api.Test;
+
+public class FlowZipTest {
+
+    @Test
+    void shouldNotZipAnythingFromEmptyFlow() throws Exception {
+        Flow<Integer> source = Flows.empty();
+        assertEquals(Collections.emptyList(), source.zipWithIndex().runToList());
+    }
+
+    @Test
+    void shouldZipFlowWithIndex() throws Exception {
+        Flow<Integer> source = Flows.fromValues(1, 2, 3, 4, 5);
+        assertPairs(source.zipWithIndex().runToList(), List.of(
+                List.of(1, 0), List.of(2, 1), List.of(3, 2), List.of(4, 3), List.of(5, 4)));
+    }
+
+    @Test
+    void zipAll_shouldNotEmitAnyElementWhenBothFlowsAreEmpty() throws Exception {
+        Flow<Integer> source = Flows.empty();
+        Flow<String> other = Flows.empty();
+        assertPairs(source.zipAll(other, -1, "foo").runToList(), List.of());
+    }
+
+    @Test
+    void zipAll_shouldEmitThisElementWhenOtherFlowIsEmpty() throws Exception {
+        Flow<Integer> source = Flows.fromValues(1);
+        Flow<String> other = Flows.empty();
+        assertPairs(source.zipAll(other, -1, "foo").runToList(), List.of(List.of(1, "foo")));
+    }
+
+    @Test
+    void zipAll_shouldEmitOtherElementWhenThisFlowIsEmpty() throws Exception {
+        Flow<Integer> source = Flows.empty();
+        Flow<String> other = Flows.fromValues("a");
+        assertPairs(source.zipAll(other, -1, "foo").runToList(), List.of(List.of(-1, "a")));
+    }
+
+    @Test
+    void zipAll_shouldEmitMatchingElementsWhenBothFlowsAreOfTheSameSize() throws Exception {
+        Flow<Integer> source = Flows.fromValues(1, 2);
+        Flow<String> other = Flows.fromValues("a", "b");
+        assertPairs(source.zipAll(other, -1, "foo").runToList(), List.of(List.of(1, "a"), List.of(2, "b")));
+    }
+
+    @Test
+    void zipAll_shouldEmitDefaultForOtherFlowIfThisFlowIsLonger() throws Exception {
+        Flow<Integer> source = Flows.fromValues(1, 2, 3);
+        Flow<String> other = Flows.fromValues("a");
+        assertPairs(source.zipAll(other, -1, "foo").runToList(),
+                List.of(List.of(1, "a"), List.of(2, "foo"), List.of(3, "foo")));
+    }
+
+    @Test
+    void zipAll_shouldEmitDefaultForThisFlowIfOtherFlowIsLonger() throws Exception {
+        Flow<Integer> source = Flows.fromValues(1);
+        Flow<String> other = Flows.fromValues("a", "b", "c");
+        assertPairs(source.zipAll(other, -1, "foo").runToList(),
+                List.of(List.of(1, "a"), List.of(-1, "b"), List.of(-1, "c")));
+    }
+
+    @Test
+    void zip_shouldZipTwoSourcesAndStopAtTheShorterSource() throws Exception {
+        Flow<Integer> first = Flows.fromValues(1, 2, 3, 0);
+        Flow<Integer> second = Flows.fromValues(4, 5, 6);
+        assertPairs(first.zip(second).runToList(), List.of(List.of(1, 4), List.of(2, 5), List.of(3, 6)));
+    }
+
+    @Test
+    void zip_shouldStopWhenTheFirstSourceIsShorter() throws Exception {
+        Flow<Integer> first = Flows.fromValues(1, 2);
+        Flow<Integer> second = Flows.fromValues(4, 5, 6);
+        assertPairs(first.zip(second).runToList(), List.of(List.of(1, 4), List.of(2, 5)));
+    }
+
+    private static void assertPairs(List<?> actual, List<List<?>> expected) throws Exception {
+        List<List<?>> components = new ArrayList<>();
+        for (Object pair : actual) {
+            if (pair instanceof Map.Entry<?, ?> entry) {
+                components.add(List.of(entry.getKey(), entry.getValue()));
+            } else if (pair instanceof List<?> values) {
+                components.add(values);
+            } else if (pair instanceof Object[] values) {
+                components.add(List.of(values));
+            } else if (pair != null && pair.getClass().isRecord()) {
+                List<Object> values = new ArrayList<>();
+                for (RecordComponent component : pair.getClass().getRecordComponents()) {
+                    values.add(component.getAccessor().invoke(pair));
+                }
+                components.add(values);
+            } else {
+                // Pair types are not prescribed; retain count checks without constraining another representation.
+                components.add(null);
+            }
+        }
+        assertEquals(expected.size(), components.size());
+        for (int i = 0; i < expected.size(); i++) {
+            if (components.get(i) == null) {
+                continue;
+            }
+            assertEquals(expected.get(i).size(), components.get(i).size());
+            for (int j = 0; j < expected.get(i).size(); j++) {
+                Object expectedValue = expected.get(i).get(j);
+                Object actualValue = components.get(i).get(j);
+                if (expectedValue instanceof Number expectedNumber && actualValue instanceof Number actualNumber) {
+                    assertEquals(expectedNumber.longValue(), actualNumber.longValue());
+                } else {
+                    assertEquals(expectedValue, actualValue);
+                }
+            }
+        }
+    }
+}
