+// SPDX-License-Identifier: BSD-3-Clause
+//go:build linux
+
+package disk
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/shirou/gopsutil/v4/common"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPartitionsWithContextSplitsMountsOptions(t *testing.T) {
+	procDir := t.TempDir()
+	mounts := "tmpfs /run/user/1000 tmpfs rw,nosuid,nodev,relatime,size=1285356k 0 0\n"
+	require.NoError(t, os.WriteFile(filepath.Join(procDir, "mounts"), []byte(mounts), 0600))
+
+	ctx := context.WithValue(context.Background(), common.EnvKey, common.EnvMap{
+		common.HostProcMountinfo: filepath.Join(procDir, "mountinfo"),
+	})
+	parts, err := PartitionsWithContext(ctx, true)
+	require.NoError(t, err)
+	require.Len(t, parts, 1)
+	assert.Equal(t, []string{"rw", "nosuid", "nodev", "relatime", "size=1285356k"}, parts[0].Opts)
+}
