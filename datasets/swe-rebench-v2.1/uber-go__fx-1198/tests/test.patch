+func TestSignalStopRestoresDefaultHandling(t *testing.T) {
+	const childEnv = "FX_SIGNAL_STOP_DEFAULT_CHILD"
+	if os.Getenv(childEnv) == "1" {
+		recv := newSignalReceivers()
+		recv.Start(context.Background())
+		if err := recv.Stop(context.Background()); err != nil {
+			os.Exit(2)
+		}
+		if err := syscall.Kill(os.Getpid(), syscall.SIGTERM); err != nil {
+			os.Exit(3)
+		}
+		select {}
+	}
+
+	cmd := exec.Command(os.Args[0], "-test.run=^TestSignalStopRestoresDefaultHandling$")
+	cmd.Env = append(os.Environ(), childEnv+"=1")
+	require.NoError(t, cmd.Start())
+
+	done := make(chan error, 1)
+	go func() { done <- cmd.Wait() }()
+	select {
+	case err := <-done:
+		exitErr, ok := err.(*exec.ExitError)
+		require.True(t, ok, "child should be terminated by its signal")
+		status, ok := exitErr.Sys().(syscall.WaitStatus)
+		require.True(t, ok, "child process status should be available")
+		assert.True(t, status.Signaled())
+		assert.Equal(t, syscall.SIGTERM, status.Signal())
+	case <-time.After(5 * time.Second):
+		_ = cmd.Process.Kill()
+		<-done
+		t.Fatal("child remained alive after receiving SIGTERM")
+	}
+}
