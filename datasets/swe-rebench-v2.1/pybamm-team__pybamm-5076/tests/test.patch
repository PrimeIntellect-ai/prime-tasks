--- a/tests/integration/test_solvers/test_idaklu.py
+++ b/tests/integration/test_solvers/test_idaklu.py
@@ -209,3 +209,59 @@ class TestIDAKLUSolver:
             sols[0].cycles[-1]["Current [A]"].data,
             sols[1].cycles[-1]["Current [A]"].data,
         )
+        cycle_pressure = sols[0].cycles[-1]["Pressure [Pa]"].entries
+        assert cycle_pressure.size > 0
+
+    def test_save_at_cycles_with_output_variables(self):
+        model = pybamm.lithium_ion.SPM()
+        cycle = ("Discharge at C/2 for 5 minutes", "Rest for 5 minutes")
+        experiment = pybamm.Experiment([cycle] * 4)
+        solver = pybamm.IDAKLUSolver(output_variables=["Voltage [V]"])
+
+        solution = pybamm.Simulation(
+            model, experiment=experiment, solver=solver
+        ).solve(save_at_cycles=[2])
+
+        # Cycle 1 and the final cycle are always retained; cycle 2 is selected.
+        assert solution.cycles[0] is not None
+        assert solution.cycles[1] is not None
+        assert solution.cycles[2] is None
+        assert solution.cycles[-1] is not None
+        assert solution.cycles[1]["Voltage [V]"].entries.size > 0
+
+    def test_outvars_with_experiments_multi_simulation(self):
+        model = pybamm.lithium_ion.SPM()
+
+        experiment = pybamm.Experiment(
+            [
+                "Discharge at C/2 for 10 minutes",
+                "Rest for 10 minutes",
+            ]
+        )
+
+        solver = pybamm.IDAKLUSolver(
+            output_variables=[
+                "Discharge capacity [A.h]",  # 0D variables
+                "Time [s]",
+                "Current [A]",
+                "Voltage [V]",
+                "Pressure [Pa]",  # 1D variable
+                "Positive particle effective diffusivity [m2.s-1]",  # 2D variable
+            ]
+        )
+
+        sim = pybamm.Simulation(model, experiment=experiment, solver=solver)
+        solution = sim.solve()
+
+        sim2 = pybamm.Simulation(model, experiment=experiment, solver=solver)
+
+        new_sol1 = sim2.solve(starting_solution=solution.copy())
+        new_sol2 = sim2.solve(starting_solution=solution.copy().last_state)
+
+        full_history_voltage = new_sol1["Voltage [V]"].entries
+        continued_voltage = new_sol2["Voltage [V]"].entries
+        assert continued_voltage.size > 0
+        assert np.isfinite(continued_voltage).all()
+        np.testing.assert_allclose(
+            full_history_voltage[-1], continued_voltage[-1], rtol=1e-5, atol=1e-7
+        )
