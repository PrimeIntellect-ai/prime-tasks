diff --git a/test/anyOf_test.js b/test/anyOf_test.js
index a2bd14b..1429b66 100644
--- a/test/anyOf_test.js
+++ b/test/anyOf_test.js
@@ -54,6 +54,117 @@ describe("anyOf", () => {
     expect(node.querySelectorAll("select")).to.have.length.of(1);
   });
 
+  it("should render a custom widget", () => {
+    const schema = {
+      type: "object",
+      anyOf: [
+        {
+          properties: {
+            foo: { type: "string" },
+          },
+        },
+        {
+          properties: {
+            bar: { type: "string" },
+          },
+        },
+      ],
+    };
+    const widgets = {
+      SelectWidget: () => {
+        return <section id="CustomSelect">Custom Widget</section>;
+      },
+    };
+
+    const { node } = createFormComponent({
+      schema,
+      widgets,
+    });
+
+    expect(node.querySelector("#CustomSelect")).to.exist;
+  });
+
+  it("should pass the expected props to the custom widget", () => {
+    const schema = {
+      type: "object",
+      anyOf: [
+        {
+          properties: {
+            foo: { type: "string" },
+          },
+        },
+        {
+          properties: {
+            bar: { type: "string" },
+          },
+        },
+      ],
+    };
+    let widgetProps;
+    const widgets = {
+      SelectWidget: props => {
+        widgetProps = props;
+        return <section id="CustomSelect">Custom Widget</section>;
+      },
+    };
+
+    createFormComponent({
+      schema,
+      widgets,
+    });
+
+    expect(widgetProps.id).to.be.a("string");
+    expect(widgetProps.schema).to.eql({ type: "number", default: 0 });
+    expect(widgetProps.value).to.eql(0);
+    expect(widgetProps.onChange).to.be.a("function");
+    expect(widgetProps.options.enumOptions).to.have.length.of(2);
+    expect(widgetProps.options.enumOptions.map(option => option.value)).to.eql([
+      0,
+      1,
+    ]);
+    widgetProps.options.enumOptions.forEach(option => {
+      expect(option.label).to.be.a("string");
+    });
+  });
+
+  it("should change the rendered form when the custom widget's onChange is called", () => {
+    const schema = {
+      type: "object",
+      anyOf: [
+        {
+          properties: {
+            foo: { type: "string" },
+          },
+        },
+        {
+          properties: {
+            bar: { type: "string" },
+          },
+        },
+      ],
+    };
+    const widgets = {
+      SelectWidget: props => (
+        <button id="CustomSelect" onClick={() => props.onChange(1)}>
+          Select option 2
+        </button>
+      ),
+    };
+
+    const { node } = createFormComponent({
+      schema,
+      widgets,
+    });
+
+    expect(node.querySelectorAll("#root_foo")).to.have.length.of(1);
+    expect(node.querySelectorAll("#root_bar")).to.have.length.of(0);
+
+    Simulate.click(node.querySelector("#CustomSelect"));
+
+    expect(node.querySelectorAll("#root_foo")).to.have.length.of(0);
+    expect(node.querySelectorAll("#root_bar")).to.have.length.of(1);
+  });
+
