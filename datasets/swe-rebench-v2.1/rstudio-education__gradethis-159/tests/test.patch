diff --git a/tests/testthat/test_unpipe.R b/tests/testthat/test_unpipe.R
index 0b793e8..5e32798 100644
--- a/tests/testthat/test_unpipe.R
+++ b/tests/testthat/test_unpipe.R
@@ -20,3 +20,33 @@ test_that("unpipe() does not alter unpiped code", {
 
   expect_equal(unpipe(func2), func2)
 })
+
+test_that("grade_code() returns feedback for an incorrect piped expression", {
+  user <- as.expression(rlang::parse_exprs("1:6 %>% sample(size = 2) %>% sum()"))
+  solution <- as.expression(rlang::parse_exprs("1:6 %>% sample(size = 2) %>% print"))
+
+  result <- gradethis::grade_code(
+    correct = "Correct",
+    grader_args = list(user_quo = user, solution_quo = solution)
+  )
+
+  expect_s3_class(result, "grader_graded")
+  expect_false(result$correct)
+  expect_type(result$message, "character")
+  expect_gt(length(result$message), 0)
+})
+
+test_that("grade_code() handles an incorrect piped answer with a bare final function", {
+  user <- as.expression(rlang::parse_exprs("1:6 %>% print"))
+  solution <- as.expression(rlang::parse_exprs("1:6 %>% sum()"))
+
+  result <- gradethis::grade_code(
+    correct = "Correct",
+    grader_args = list(user_quo = user, solution_quo = solution)
+  )
+
+  expect_s3_class(result, "grader_graded")
+  expect_false(result$correct)
+  expect_type(result$message, "character")
+  expect_gt(length(result$message), 0)
+})
