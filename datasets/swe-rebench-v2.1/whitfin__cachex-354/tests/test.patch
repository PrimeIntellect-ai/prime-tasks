     # we shouldn't be able to stream a cache on multiple nodes
     assert(Cachex.stream(cache) == {:error, :non_distributed})
   end
+  # This test ensures that cache eviction does not depend on the current working
+  # directory being writable. The LRW policy must be able to evict entries even
+  # when the working directory is unavailable (for example, when it has been
+  # removed), rather than silently failing to enforce the cache bounds.
+  test "evicting when the current working directory is not writable" do
+    # define our cache limit
+    limit =
+      limit(
+        size: 1000,
+        policy: Cachex.Policy.LRW,
+        reclaim: 0.75,
+        options: [batch_size: 25, immediate: true]
+      )
+
+    # create a cache with a max size
+    cache = Helper.create_cache(limit: limit)
+
+    # use large keys so that the eviction has to consider a sizeable amount of
+    # data, which is what forces the unfixed implementation to spill to disk
+    key = fn x -> String.duplicate("k", 1000) <> Integer.to_string(x) end
+
+    # fill the cache up to the limit
+    for x <- 1..1000 do
+      {:ok, true} = Cachex.put(cache, key.(x), x)
+    end
+
+    # verify the cache is at the limit
+    assert(Cachex.size!(cache) == 1000)
+
+    # make the current working directory unavailable by removing it
+    original = File.cwd!()
+    dir = Path.join(System.tmp_dir!(), "cachex_evict_#{:erlang.unique_integer([:positive])}")
+    File.mkdir_p!(dir)
+
+    try do
+      File.cd!(dir)
+      File.rm_rf!(dir)
+
+      # add a new key to trigger evictions
+      {:ok, true} = Cachex.put(cache, key.(1001), 1001)
+
+      # verify eviction actually removes entries instead of silently failing
+      Helper.poll(2000, true, fn ->
+        Cachex.size!(cache) < 1000
+      end)
+    after
+      File.cd!(original)
+    end
+  end
 end
