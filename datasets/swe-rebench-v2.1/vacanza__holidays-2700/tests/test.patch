+#  holidays
+#  --------
+#  A fast, efficient Python library for generating country, province and state
+#  specific sets of holidays on the fly. It aims to make determining whether a
+#  specific date is a holiday as fast and flexible as possible.
+#
+#  Authors: Vacanza Team and individual contributors (see CONTRIBUTORS file)
+#           dr-prodigy <dr.prodigy.github@gmail.com> (c) 2017-2023
+#           ryanss <ryanssdev@icloud.com> (c) 2014-2017
+#  Website: https://github.com/vacanza/holidays
+#  License: MIT (see LICENSE file)
+
+from unittest import TestCase
+
+from holidays.constants import BANK
+from holidays.countries.lebanon import Lebanon, LB, LBN
+from tests.common import CommonCountryTests
+
+
+class TestLebanon(CommonCountryTests, TestCase):
+    @classmethod
+    def setUpClass(cls):
+        years = range(2000, 2050)
+        super().setUpClass(Lebanon, years=years)
+        cls.bank_holidays = Lebanon(categories=BANK, years=years)
+
+    def test_country_aliases(self):
+        self.assertAliases(Lebanon, LB, LBN)
+
+    def test_bank_category_subset(self):
+        self.assertHoliday(self.bank_holidays, "2020-02-14", "2020-04-13", "2020-04-20")
+        self.assertNoHoliday(self.bank_holidays, "2020-01-01", "2020-05-01", "2020-11-22")
+
+        holidays = Lebanon(years=2020)
+        self.assertHoliday(holidays, "2020-01-01", "2020-05-01", "2020-11-22")
+
+    def test_new_years_day(self):
+        self.assertHoliday(f"{year}-01-01" for year in range(2000, 2050))
+
+    def test_armenian_orthodox_christmas(self):
+        self.assertHoliday(f"{year}-01-06" for year in range(2000, 2050))
+
+    def test_saint_maron_day(self):
+        self.assertHoliday(f"{year}-02-09" for year in range(2000, 2050))
+
+    def test_rafiki_memorial_day(self):
+        self.assertHoliday(self.bank_holidays, "2020-02-14")
+
+    def test_feast_of_the_annunciation(self):
+        self.assertHoliday(
+            f"{year}-03-25" for year in (*range(2000, 2006), *range(2010, 2050))
+        )
+
+    def test_catholic_good_friday(self):
+        self.assertHoliday(
+            "2019-04-19",
+            "2020-04-10",
+            "2021-04-02",
+            "2022-04-15",
+            "2023-04-07",
+            "2024-03-29",
+            "2025-04-18",
+        )
+
+    def test_orthodox_good_friday(self):
+        self.assertHoliday(
+            "2019-04-26",
+            "2020-04-17",
+            "2021-04-30",
+            "2022-04-22",
+            "2023-04-14",
+            "2024-05-03",
+            "2025-04-18",
+        )
+
+    def test_orthodox_holy_saturday(self):
+        self.assertHoliday(
+            "2010-04-03",
+            "2011-04-23",
+            "2014-04-19",
+            "2017-04-15",
+        )
+
+    def test_catholic_easter_monday(self):
+        self.assertHoliday(
+            self.bank_holidays,
+            "2020-04-13",
+            "2021-04-05",
+            "2022-04-18",
+            "2023-04-10",
+            "2024-04-01",
+        )
+
+    def test_orthodox_easter_monday(self):
+        self.assertHoliday(
+            self.bank_holidays,
+            "2020-04-20",
+            "2021-05-03",
+            "2022-04-25",
+            "2023-04-17",
+            "2024-05-06",
+        )
+
+    def test_labor_day(self):
+        self.assertHoliday(f"{year}-05-01" for year in range(2000, 2050))
+
+    def test_martyrs_day(self):
+        self.assertHoliday(
+            "2006-05-07",
+            "2007-05-06",
+            "2008-05-04",
+            "2009-05-03",
+        )
+
+    def test_resistance_and_liberation_day(self):
+        self.assertHoliday(
+            "2021-05-09",
+            "2022-05-08",
+            "2023-05-14",
+            "2024-05-12",
+            "2025-05-11",
+        )
+
+    def test_assumption_day(self):
+        self.assertHoliday(f"{year}-08-15" for year in range(2000, 2050))
+
+    def test_independence_day(self):
+        self.assertHoliday(f"{year}-11-22" for year in range(2000, 2050))
+
+    def test_christmas_day(self):
+        self.assertHoliday(f"{year}-12-25" for year in range(2000, 2050))
+
+    def test_islamic_new_year(self):
+        self.assertHoliday(
+            "2020-08-20",
+            "2021-08-09",
+            "2022-07-30",
+            "2023-07-19",
+            "2024-07-07",
+            "2025-06-26",
+        )
+
+    def test_ashura(self):
+        self.assertHoliday(
+            "2020-08-30",
+            "2021-08-19",
+            "2022-08-09",
+            "2023-07-28",
+            "2024-07-16",
+        )
+
+    def test_mawlid(self):
+        self.assertHoliday(
+            "2020-10-29",
+            "2021-10-18",
+            "2022-10-08",
+            "2023-09-27",
+            "2024-09-15",
+        )
+
+    def test_eid_al_fitr(self):
+        self.assertHoliday(
+            "2020-05-24",
+            "2020-05-25",
+            "2021-05-13",
+            "2021-05-14",
+            "2022-05-02",
+            "2022-05-03",
+            "2023-04-21",
+            "2023-04-22",
+            "2024-04-10",
+            "2024-04-11",
+            "2025-03-30",
+            "2025-03-31",
+        )
+
+    def test_eid_al_adha(self):
+        self.assertHoliday(
+            "2020-07-31",
+            "2020-08-01",
+            "2021-07-20",
+            "2021-07-21",
+            "2022-07-09",
+            "2022-07-10",
+            "2023-06-28",
+            "2023-06-29",
+            "2024-06-16",
+            "2024-06-17",
+            "2025-06-06",
+            "2025-06-07",
+        )
+
+    def test_2024(self):
+        dates = (
+            "2024-01-01",
+            "2024-01-06",
+            "2024-02-09",
+            "2024-03-25",
+            "2024-03-29",
+            "2024-04-10",
+            "2024-04-11",
+            "2024-05-01",
+            "2024-05-03",
+            "2024-05-05",
+            "2024-05-12",
+            "2024-06-16",
+            "2024-06-17",
+            "2024-07-07",
+            "2024-07-16",
+            "2024-08-15",
+            "2024-09-15",
+            "2024-11-22",
+            "2024-12-25",
+        )
+        holidays = Lebanon(years=2024)
+        for date in dates:
+            self.assertIn(date, holidays)
