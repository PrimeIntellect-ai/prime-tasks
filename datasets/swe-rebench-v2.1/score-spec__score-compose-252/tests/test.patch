+package command
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestProvisionersListCommand(t *testing.T) {
+	td := t.TempDir()
+	wd, err := os.Getwd()
+	require.NoError(t, err)
+	require.NoError(t, os.Chdir(td))
+	defer func() { require.NoError(t, os.Chdir(wd)) }()
+
+	provisionersDir := t.TempDir()
+	definition := filepath.Join(provisionersDir, "custom.provisioners.yaml")
+	require.NoError(t, os.WriteFile(definition, []byte(`
+- uri: template://custom
+  type: custom-type
+  class: custom-class
+  outputs: "{}"
+`), 0644))
+
+	_, _, err = executeAndResetCommand(context.Background(), rootCmd, []string{"init", "--provisioners", definition})
+	require.NoError(t, err)
+
+	// Default output and every non-JSON format are readable tables containing the imported provisioner.
+	for _, args := range [][]string{
+		{"provisioners", "list"},
+		{"provisioners", "list", "--format", "yaml"},
+	} {
+		out, runErr := runCommand(t, args)
+		require.NoError(t, runErr)
+		require.NotEmpty(t, strings.TrimSpace(out))
+		assert.False(t, json.Valid([]byte(out)), "table output should be human-readable, not JSON")
+		assert.Contains(t, out, "custom-type")
+		assert.Contains(t, out, "custom-class")
+	}
+
+	// Both documented spellings select JSON and expose the imported provisioner information.
+	for _, flagArgs := range [][]string{{"--format", "json"}, {"-f", "json"}} {
+		args := append([]string{"provisioners", "list"}, flagArgs...)
+		out, runErr := runCommand(t, args)
+		require.NoError(t, runErr)
+		var entries []map[string]interface{}
+		require.NoError(t, json.Unmarshal([]byte(out), &entries), "JSON output must be an array: %s", out)
+		var found bool
+		for _, entry := range entries {
+			if strings.EqualFold(jsonField(entry, "type"), "custom-type") {
+				found = true
+				assert.Equal(t, "custom-class", jsonField(entry, "class"))
+			}
+		}
+		assert.True(t, found, "expected custom-type in JSON output: %s", out)
+	}
+}
+
+func jsonField(entry map[string]interface{}, name string) string {
+	for key, value := range entry {
+		if strings.EqualFold(key, name) {
+			text, _ := value.(string)
+			return text
+		}
+	}
+	return ""
+}
+
+// runCommand captures output written by the command as well as directly to standard output.
+func runCommand(t *testing.T, args []string) (string, error) {
+	t.Helper()
+	old := os.Stdout
+	r, w, err := os.Pipe()
+	require.NoError(t, err)
+	os.Stdout = w
+	defer func() { os.Stdout = old }()
+	cmdOut, _, runErr := executeAndResetCommand(context.Background(), rootCmd, args)
+	_ = w.Close()
+	out, _ := io.ReadAll(r)
+	return cmdOut + string(out), runErr
+}
