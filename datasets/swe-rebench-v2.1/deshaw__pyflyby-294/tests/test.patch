--- a/tests/tests_sorts.py
+++ b/tests/tests_sorts.py
@@ -1,5 +1,8 @@
 from   pyflyby._parse     import PythonBlock
 from   pyflyby._imports2s import sort_imports
+from pathlib import Path
+import subprocess
+import sys
 from textwrap import dedent
 import pytest
 
@@ -45,10 +48,49 @@ expected1 = dedent("""
         import zz
     """)
 
-@pytest.mark.parametrize('code, expected',[(code1, expected1)])
+# A shebang script with several non-stdlib imports.  Repeated tidy-imports
+# commands must not keep adding blank lines above the import list.
+stable_1 = dedent(
+    """\
+        #!/usr/local/bin/python3
+
+        from   deshaw.abc               import DAYS
+        from   deshaw.py                    import tuple
+
+        print(DAYS.days(20240101, 20241231))
+        print(tuple("hello"))
+    """
+)
+
+
+@pytest.mark.parametrize("code, expected", [(code1, expected1)])
 def test_sort_1(code, expected):
 
     assert str(sort_imports(PythonBlock(code))) == expected
     # expected is stable
     assert str(sort_imports(PythonBlock(expected))) == expected
 
+
+def test_tidy_imports_does_not_keep_adding_blank_lines(tmp_path):
+    source = tmp_path / "script.py"
+    source.write_text(stable_1)
+    command = [
+        sys.executable,
+        str(Path(__file__).resolve().parents[1] / "bin" / "tidy-imports"),
+        "--no-remove-unused",
+        "-r",
+        str(source),
+    ]
+
+    def header(text):
+        # Everything above the first import statement.
+        return text[: text.index("from ")]
+
+    original_header = header(stable_1)
+    assert original_header == "#!/usr/local/bin/python3\n\n"
+
+    for _ in range(3):
+        result = subprocess.run(command, capture_output=True, text=True)
+        assert result.returncode == 0
+        # The blank-line layout above the imports must not change.
+        assert header(source.read_text()) == original_header
