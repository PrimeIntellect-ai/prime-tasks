+    def test_hessian_of_reported_cosine_circuit_at_zero(self):
+        """The reported cosine circuit has second derivative -1 at zero."""
+        dev = qml.device("default.qubit", wires=1)
+
+        @qml.qnode(dev)
+        def circuit(x):
+            qml.RY(x, wires=0)
+            return qml.expval(qml.PauliZ(0))
+
+        assert qml.math.isclose(qml.grad(qml.grad(circuit))(0.0), -1.0)
+
+    def test_hessian_of_reported_pauli_x_circuit_at_zero(self):
+        """The second reported circuit has second derivative 1 at zero."""
+        dev = qml.device("default.qubit", wires=1)
+
+        @qml.qnode(dev)
+        def circuit(x):
+            qml.PauliX(wires=0)
+            qml.RX(x, wires=0)
+            return qml.expval(qml.PauliZ(0))
+
+        assert qml.math.isclose(qml.grad(qml.grad(circuit))(0.0), 1.0)
+
