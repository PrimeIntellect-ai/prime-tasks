+  it("should recalculate page when calling changeRowsPerPage method", () => {
+    const data = new Array(29).fill("").map(() => ["Joe James", "Test Corp", "Yonkers", "NY"]);
+    const mountWrapper = mount(shallow(<MUIDataTable columns={columns} data={data} />).get(0));
+    const instance = mountWrapper.instance();
+
+    // move to the last page (page index 2) with the default 10 rows per page
+    instance.changePage(2);
+    // changing the page size must not leave the table on an out-of-range page,
+    // otherwise rendering the body throws an exception
+    instance.changeRowsPerPage(15);
+    mountWrapper.update();
+
+    const state = mountWrapper.state();
+    const totalPages = Math.ceil(29 / 15);
+
+    // the table should now show two pages for the 29 rows
+    assert.equal(totalPages, 2);
+    // the current page must be a valid index within those two pages
+    assert.isBelow(state.page, totalPages);
+
+    // the rendered pagination should reflect the two pages
+    const pagination = mountWrapper.find(MUIDataTablePagination);
+    assert.lengthOf(pagination, 1);
+    assert.equal(pagination.props().count, 29);
+    assert.equal(pagination.props().rowsPerPage, 15);
+    assert.equal(Math.ceil(pagination.props().count / pagination.props().rowsPerPage), 2);
+  });
+
