@@ -1,3 +1,10 @@
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
 from tests.atest.utils import RuleAcceptance
 
 
@@ -7,3 +14,39 @@ class TestRuleAcceptance(RuleAcceptance):
 
     def test_rule_pre_var(self):
         self.check_rule(src_files=["test.robot"], expected_file="expected_output_pre_var.txt", target_version="<7")
+
+    def test_source_selection(self):
+        if not self.enabled_in_version(">=7"):
+            pytest.skip("Inline VAR statements require Robot Framework 7 or later")
+        listing = subprocess.run(
+            [sys.executable, "-m", "robocop", "-lc", self.rule_name], capture_output=True, text=True, check=True
+        ).stdout
+        configurable = re.search(r"^\s+([\w-]+)\s*=\s*([^\s]+)\s*$", listing, re.MULTILINE)
+        assert configurable is not None, "The rule should expose a selectable source configuration"
+        parameter, default_sources = configurable.groups()
+        if "," not in default_sources:
+            return
+        choices = default_sources.split(",")
+        robot_file = Path(self.test_class_dir) / "test.robot"
+
+        def reported_issues(source=None):
+            command = [sys.executable, "-m", "robocop"]
+            if source is not None:
+                command.extend(["-c", f"{self.rule_name}:{parameter}:{source}"])
+            command.append(str(robot_file))
+            result = subprocess.run(command, capture_output=True, text=True, check=False)
+            return {
+                line
+                for line in result.stdout.splitlines()
+                if re.search(r":\d+:\d+ \[[IWE]\] 0912 ", line)
+            }
+
+        all_issues = reported_issues()
+        isolated_issues = [reported_issues(source) for source in choices]
+        assert all(isolated_issues), "Each selectable source should have matching empty-variable diagnostics"
+        assert all_issues == set.union(*isolated_issues), "The default selection should include every source"
+        assert all(
+            isolated_issues[first].isdisjoint(isolated_issues[second])
+            for first in range(len(isolated_issues))
+            for second in range(first + 1, len(isolated_issues))
+        ), "Selecting an individual source should not include diagnostics from other sources"
