+describe("[lib] checkCamelCaseNaming()", () => {
+  it("should make javascript camelCase and uppercase first letter", () => {
+    const checkCamelCaseNaming = require("lib/utils/check-camelcase-naming").default;
+    const result = checkCamelCaseNaming("javascript");
+    expect(result).toBe("JavaScript");
+  });
+
+  it("should treat javascript case-insensitively", () => {
+    const checkCamelCaseNaming = require("lib/utils/check-camelcase-naming").default;
+    expect(checkCamelCaseNaming("JAVASCRIPT")).toBe("JavaScript");
+    expect(checkCamelCaseNaming("JavaScript")).toBe("JavaScript");
+  });
+
+  it("should uppercase the first character and preserve the remainder for other names", () => {
+    const checkCamelCaseNaming = require("lib/utils/check-camelcase-naming").default;
+    const result = checkCamelCaseNaming("pYtHon 3");
+    expect(result).toBe("PYtHon 3");
+  });
+
+  it("should return an empty string for a falsy name", () => {
+    const checkCamelCaseNaming = require("lib/utils/check-camelcase-naming").default;
+    expect(checkCamelCaseNaming("")).toBe("");
+  });
+});
+
+describe("JavaScript display in interest and explore surfaces", () => {
+  it("shows the corrected spelling in profile interests", () => {
+    const markup = renderToStaticMarkup(React.createElement(ContributorProfileInfo, {
+      githubName: "contributor",
+      interests: "javascript",
+      isConnected: true
+    }));
+
+    expect(markup).toContain("JavaScript");
+  });
+
+  it("shows the corrected spelling in profile settings interests", () => {
