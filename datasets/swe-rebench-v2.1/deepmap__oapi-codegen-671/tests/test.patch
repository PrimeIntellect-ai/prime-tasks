diff --git a/pkg/codegen/codegen_test.go b/pkg/codegen/codegen_test.go
index d5840b3..e3e2715 100644
--- a/pkg/codegen/codegen_test.go
+++ b/pkg/codegen/codegen_test.go
@@ -3,7 +3,10 @@ package codegen
 import (
 	"bytes"
 	_ "embed"
+	"go/ast"
 	"go/format"
+	"go/parser"
+	"go/token"
 	"io/ioutil"
 	"net/http"
 	"testing"
@@ -227,3 +230,77 @@ func TestXGoTypeImport(t *testing.T) {
 
 //go:embed test_spec.yaml
 var testOpenAPIDefinition string
+
+func TestOptionalQueryParamHasNoEmptyConditional(t *testing.T) {
+	spec := `
+openapi: "3.0.0"
+info:
+  title: optional query parameter
+  version: 1.0.0
+paths:
+  /items:
+    get:
+      operationId: listItems
+      parameters:
+        - name: name
+          in: query
+          required: false
+          schema:
+            type: string
+      responses:
+        "200":
+          description: ok
+`
+	swagger, err := openapi3.NewLoader().LoadFromData([]byte(spec))
+	require.NoError(t, err)
+
+	opts := Configuration{
+		PackageName: "api",
+		Generate: GenerateOptions{
+			GorillaServer: true,
+		},
+	}
+	code, err := Generate(swagger, opts)
+	require.NoError(t, err)
+
+	fset := token.NewFileSet()
+	file, err := parser.ParseFile(fset, "test.gen.go", code, 0)
+	require.NoError(t, err, "generated code should be valid Go")
+
+	// mentionsName reports whether the expression contains the string literal "name".
+	mentionsName := func(node ast.Node) bool {
+		found := false
+		ast.Inspect(node, func(n ast.Node) bool {
+			if lit, ok := n.(*ast.BasicLit); ok && lit.Value == `"name"` {
+				found = true
+			}
+			return !found
+		})
+		return found
+	}
+
+	// No if-statement that reads the optional "name" query parameter may have an empty body.
+	emptyGuards := 0
+	ast.Inspect(file, func(n ast.Node) bool {
+		if ifStmt, ok := n.(*ast.IfStmt); ok && len(ifStmt.Body.List) == 0 && (ifStmt.Init != nil && mentionsName(ifStmt.Init) || mentionsName(ifStmt.Cond)) {
+			emptyGuards++
+		}
+		return true
+	})
+	assert.Zero(t, emptyGuards, "optional query parameter should not produce an empty conditional")
+
+	// The parameter binding for "name" must still be generated.
+	bound := false
+	ast.Inspect(file, func(n ast.Node) bool {
+		call, ok := n.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		sel, ok := call.Fun.(*ast.SelectorExpr)
+		if ok && sel.Sel.Name == "BindQueryParameter" && mentionsName(call) {
+			bound = true
+		}
+		return true
+	})
+	assert.True(t, bound, "optional query parameter should still be bound with BindQueryParameter")
+}
