diff --git a/tests/preserve_pandas_like_columns_name_attr_test.py b/tests/preserve_pandas_like_columns_name_attr_test.py
new file mode 100644
index 00000000..c6491919
--- /dev/null
+++ b/tests/preserve_pandas_like_columns_name_attr_test.py
@@ -0,0 +1,41 @@
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import pytest
+
+import narwhals.stable.v1 as nw
+
+if TYPE_CHECKING:
+    from tests.utils import Constructor
+
+
+@pytest.mark.parametrize("operation", ["select", "with_columns"])
+@pytest.mark.parametrize("lazy", [False, True])
+def test_ops_preserve_column_index_name(
+    constructor: Constructor,
+    request: pytest.FixtureRequest,
+    operation: str,
+    lazy: bool,
+) -> None:
+    if not any(x in str(constructor) for x in ("pandas", "modin", "cudf", "dask")):
+        pytest.skip(
+            reason="Dataframe columns is a list and do not have a `name` like a pandas Index does"
+        )
+    if "dask" in str(constructor):
+        # https://github.com/dask/dask/issues/11874
+        request.applymarker(pytest.mark.xfail)
+
+    data = {"a": [1, 3, 2], "b": [4, 4, 6], "z": [7.0, 8.0, 9.0]}
+    df_native = constructor(data)
+    df_native.columns.name = "foo"  # type: ignore[union-attr]
+    frame = nw.from_native(df_native)
+    if lazy:
+        frame = frame.lazy()
+
+    method = getattr(frame, operation)
+    result = method(c=nw.col("a") + 1)
+    if lazy:
+        result = result.collect(backend="pandas")
+
+    assert result.to_native().columns.name == "foo"  # type: ignore[union-attr]
