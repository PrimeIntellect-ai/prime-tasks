+@systemcls_param
+def test_ignore_function_contents(systemcls):
+    mod = fromText('''
+    def outer():
+        """Outer function."""
+
+        class Clazz:
+            """Inner class."""
+
+        def inner_helper():
+            """Inner function."""
+
+        var = 1
+        """Local variable."""
+    ''', systemcls=systemcls)
+    # The requested system class is instantiated and attached to the module.
+    assert isinstance(mod.system, systemcls)
+    outer = mod.contents['outer']
+    # Inner functions are private helpers and must not be documented:
+    # they must not appear in the generated output for the outer function.
+    from pydoctor.test.test_templatewriter import getHTMLOf
+    html = getHTMLOf(outer)
+    assert 'inner_helper' not in html
+    assert 'Inner function' not in html
