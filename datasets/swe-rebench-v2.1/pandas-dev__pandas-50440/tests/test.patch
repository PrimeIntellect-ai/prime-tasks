diff --git a/pandas/tests/resample/test_resampler_grouper.py b/pandas/tests/resample/test_resampler_grouper.py
index 0432cf3970..4b0536500f 100644
--- a/pandas/tests/resample/test_resampler_grouper.py
+++ b/pandas/tests/resample/test_resampler_grouper.py
@@ -515,3 +515,77 @@ def test_resample_empty_Dataframe(keys):
         expected.index.name = keys[0]
 
     tm.assert_frame_equal(result, expected)
+
+
+def _size_as_series(res):
+    # Normalize either shape (MultiIndex Series or wide DataFrame) to counts
+    if isinstance(res, DataFrame):
+        res = res.stack()
+    return res
+
+
+def test_groupby_resample_size_all_index_same():
+    # GH 46826
+    df = DataFrame(
+        {"A": [1] * 3 + [2] * 3 + [1] * 3 + [2] * 3, "B": np.arange(12)},
+        index=date_range("31/12/2000 18:00", freq="H", periods=12),
+    )
+    result = _size_as_series(df.groupby("A").resample("D").size())
+    expected = Series(
+        3,
+        index=pd.MultiIndex.from_tuples(
+            [
+                (1, Timestamp("2000-12-31")),
+                (1, Timestamp("2001-01-01")),
+                (2, Timestamp("2000-12-31")),
+                (2, Timestamp("2001-01-01")),
+            ],
+            names=["A", None],
+        ),
+    )
+    tm.assert_series_equal(result, expected, check_names=False)
+
+
+def test_groupby_resample_size_type_independent_of_observations():
+    # GH 46826
+    df1 = DataFrame(
+        index=pd.DatetimeIndex(["2022-1-1 1:00", "2022-1-2 1:00", "2022-1-2 1:00"]),
+        data={"category": ["A", "A", "B"]},
+    )
+    df2 = DataFrame(
+        index=pd.DatetimeIndex(
+            ["2022-1-1 1:00", "2022-1-2 1:00", "2022-1-2 1:00", "2022-1-1 1:00"]
+        ),
+        data={"category": ["A", "A", "B", "B"]},
+    )
+    res1 = df1.groupby(["category"]).resample("1D").size()
+    res2 = df2.groupby(["category"]).resample("1D").size()
+
+    # Adding an observation must not change the type of the result
+    assert type(res1) is type(res2)
+
+    expected1 = Series(
+        1,
+        index=pd.MultiIndex.from_tuples(
+            [
+                ("A", Timestamp("2022-01-01")),
+                ("A", Timestamp("2022-01-02")),
+                ("B", Timestamp("2022-01-02")),
+            ],
+            names=["category", None],
+        ),
+    )
+    expected2 = Series(
+        1,
+        index=pd.MultiIndex.from_tuples(
+            [
+                ("A", Timestamp("2022-01-01")),
+                ("A", Timestamp("2022-01-02")),
+                ("B", Timestamp("2022-01-01")),
+                ("B", Timestamp("2022-01-02")),
+            ],
+            names=["category", None],
+        ),
+    )
+    tm.assert_series_equal(_size_as_series(res1), expected1, check_names=False)
+    tm.assert_series_equal(_size_as_series(res2), expected2, check_names=False)
