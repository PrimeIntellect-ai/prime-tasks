+function test_unknown_size_dense(::Any, ::Any)
+    model = Model()
+    f = Iterators.filter(k -> isodd(k), 1:10)
+    @variable(model, x[f])
+    @test length(x) == 5
+end
+
+function test_unknown_size_sparse(::Any, ::Any)
+    model = Model()
+    f = Iterators.filter(k -> isodd(k), 1:10)
+    @variable(model, x[i = f; i < 5])
+    @test length(x) == 2
+end
+
+function test_unknown_size_constraint(::Any, ::Any)
+    model = Model()
+    @variable(model, x)
+    @constraint(
+        model,
+        c[i in Iterators.filter(k -> isodd(k), 1:10)],
+        x >= i,
+    )
+    @test length(c) == 5
+end
+
+function test_infinite_size_macro_axes(::Any, ::Any)
+    model = Model()
+    @test_throws Exception @variable(
+        model,
+        x[i in Iterators.repeated(1)],
+    )
+    @test_throws Exception @constraint(
+        model,
+        c[i in Iterators.repeated(1)],
+        i >= 0,
+    )
+end
+
 function test_start_value(::Any, ::Any)
