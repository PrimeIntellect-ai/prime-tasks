+describe("publish package access", () => {
+  it("uses each package's publishConfig access and falls back to global access", async () => {
+    const tempDir = await copyFixtureIntoTempDir(__dirname, "simple-project");
+    const packageAPath = path.join(tempDir, "packages", "pkg-a", "package.json");
+    const packageBPath = path.join(tempDir, "packages", "pkg-b", "package.json");
+    const packageA = await fs.readJSON(packageAPath);
+    const packageB = await fs.readJSON(packageBPath);
+    packageA.publishConfig = { access: "public" };
+    await fs.writeJSON(packageAPath, packageA);
+    await fs.writeJSON(packageBPath, packageB);
+
+    const tokenSpy = jest.spyOn(npmUtils, "getTokenIsRequired").mockResolvedValue(false);
+    const infoSpy = jest
+      .spyOn(npmUtils, "infoAllow404")
+      .mockResolvedValue({ published: false, pkgInfo: {} });
+    const publishSpy = jest
+      .spyOn(npmUtils, "publish")
+      .mockResolvedValue({ published: true });
+
+    try {
+      await publishPackages({ cwd: tempDir, access: "restricted" });
+
+      // npm applies a manifest's publishConfig.access itself when no explicit
+      // access flag is passed, so the effective access is the explicit option
+      // or, failing that, the value declared in the package's manifest.
+      const declaredAccess: { [name: string]: string | undefined } = {
+        "pkg-a": "public",
+        "pkg-b": undefined
+      };
+      const publishedAccess = publishSpy.mock.calls.map(([name, options]) => [
+        name,
+        options.access || declaredAccess[name]
+      ]);
+      expect(publishedAccess).toEqual(
+        expect.arrayContaining([
+          ["pkg-a", "public"],
+          ["pkg-b", "restricted"]
+        ])
+      );
+    } finally {
+      tokenSpy.mockRestore();
+      infoSpy.mockRestore();
+      publishSpy.mockRestore();
+      await fs.remove(tempDir);
+    }
+  });
+});
+
