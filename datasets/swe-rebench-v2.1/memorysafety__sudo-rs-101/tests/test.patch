+/// When the child process is terminated by a signal, sudo must terminate itself
+/// with that same signal so that the caller observes the original sudo exit
+/// status (128 + signal number). For a child that kills itself with SIGTERM
+/// (`sh -c 'kill $$'`) that status is 143.
+#[test]
+fn test_signal_terminated_child_exit_code() {
+    use std::os::unix::process::ExitStatusExt;
+    use std::path::Path;
+
+    // `cargo test` does not build the `sudo` binary itself, so build it here.
+    let workspace_root = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .unwrap()
+        .parent()
+        .unwrap();
+
+    let build = std::process::Command::new(env!("CARGO"))
+        .args(["build", "--bin", "sudo"])
+        .current_dir(workspace_root)
+        .output()
+        .expect("failed to run cargo build");
+    assert!(
+        build.status.success(),
+        "failed to build the sudo binary: {}",
+        String::from_utf8_lossy(&build.stderr),
+    );
+
+    // The test binary lives in `<target-dir>/debug/deps/`, so the `sudo`
+    // binary is two directories up.
+    let target_dir = std::env::current_exe()
+        .unwrap()
+        .parent()
+        .unwrap()
+        .parent()
+        .unwrap()
+        .to_path_buf();
+    let sudo = target_dir.join("sudo");
+    assert!(sudo.exists(), "sudo binary not found at {sudo:?}");
+
+    // The sudo binary reads its policy from this hard-coded path.
+    std::fs::write("/etc/sudoers.test", "root ALL=(ALL:ALL) NOPASSWD: ALL\n")
+        .expect("failed to write /etc/sudoers.test");
+
+    let status = std::process::Command::new(&sudo)
+        .args(["sh", "-c", "kill $$"])
+        .status()
+        .expect("failed to run sudo");
+
+    // A shell reports 128 + signal number for a signal-terminated process.
+    let exit_code = status
+        .code()
+        .unwrap_or_else(|| 128 + status.signal().expect("no exit code or signal"));
+
+    assert_eq!(exit_code, 143, "unexpected exit status: {status:?}");
+
+    // Use a different signal as well, rather than relying only on SIGTERM.
+    // Obtain the platform's signal number from the shell's own wait status.
+    let child_status = std::process::Command::new("sh")
+        .args(["-c", "kill -USR1 $$"])
+        .status()
+        .expect("failed to run signal-number probe");
+    let signal = child_status
+        .signal()
+        .expect("the signal-number probe was not terminated by a signal");
+
+    let status = std::process::Command::new(&sudo)
+        .args(["sh", "-c", "kill -USR1 $$"])
+        .status()
+        .expect("failed to run sudo with SIGUSR1-terminated command");
+    let exit_code = status
+        .code()
+        .unwrap_or_else(|| 128 + status.signal().expect("no exit code or signal"));
+
+    assert_eq!(exit_code, 128 + signal, "unexpected exit status: {status:?}");
+}
