+package bulk
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestDiscoveryMissingParent(t *testing.T) {
+	tests := []struct {
+		desc string
+		args []string
+	}{
+		{
+			desc: "unspecified",
+			args: []string{"discovery"},
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.desc, func(t *testing.T) {
+			cmd := Command()
+			cmd.SilenceUsage = true
+			cmd.SilenceErrors = true
+			cmd.SetArgs(test.args)
+			err := cmd.Execute()
+			if err == nil {
+				t.Fatal("expected error, none reported")
+			}
+			message := strings.ToLower(err.Error())
+			if !strings.Contains(message, "project") && !strings.Contains(message, "parent") {
+				t.Errorf("error should identify the missing project or parent, got: %v", err)
+			}
+		})
+	}
+}
