+         |}
+         |""".stripMargin
+    val tree = Defn.Object(
+      Nil,
+      tname("a"),
+      tpl(
+        Defn.Object(
+          Nil,
+          tname("b"),
+          tpl(
+            Term.ApplyInfix(
+              Term.Apply(
+                Term.Select(tname("foo"), tname("map")),
