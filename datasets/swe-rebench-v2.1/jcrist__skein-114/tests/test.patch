+def test_submit_and_connect_normalizes_spec(tmpdir):
+    spec = ApplicationSpec.from_yaml(app_spec)
+    spec_path = os.path.join(str(tmpdir), 'test.yaml')
+    spec.to_file(spec_path)
+
+    class RecordingClient(skein.Client):
+        def __init__(self):
+            self._proc = None
+
+        def submit(self, spec):
+            self.submitted = spec
+            return 'application_1'
+
+        def connect(self, app_id, security=None):
+            self.connected = (app_id, security)
+            return 'app_client'
+
+        def kill_application(self, app_id):
+            pass
+
+    for obj in [spec, spec_path, spec.to_dict()]:
+        client = RecordingClient()
+        assert client.submit_and_connect(obj) == 'app_client'
+        assert isinstance(client.submitted, ApplicationSpec)
+        assert client.submitted == spec
+
