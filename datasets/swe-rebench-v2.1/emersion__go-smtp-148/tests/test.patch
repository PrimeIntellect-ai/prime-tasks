+// TestServer_Conn checks that a backend can reach the underlying net.Conn of
+// the client connection through the *smtp.Conn passed to NewSession.
+func TestServer_Conn(t *testing.T) {
+	be, s, c, _, _ := testServerEhlo(t)
+	defer s.Close()
+	defer c.Close()
+
+	if be.conn == nil {
+		t.Fatal("NewSession did not receive a *smtp.Conn")
+	}
+
+	netConn := be.conn.Conn()
+	if netConn == nil {
+		t.Fatal("Conn.Conn() returned nil")
+	}
+
+	// The returned net.Conn must be the server side of this client
+	// connection, so its addresses are the mirror image of the client's.
+	if got, want := netConn.RemoteAddr().String(), c.LocalAddr().String(); got != want {
+		t.Fatalf("Conn.Conn() remote address = %q, want %q", got, want)
+	}
+	if got, want := netConn.LocalAddr().String(), c.RemoteAddr().String(); got != want {
+		t.Fatalf("Conn.Conn() local address = %q, want %q", got, want)
+	}
+}
