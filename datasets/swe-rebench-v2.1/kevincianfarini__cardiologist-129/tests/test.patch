+    @Test
+    fun schedulePulse_with_cron_expression_simple() = runTest {
+        val pulse = testClock.schedulePulse("* * * * *").take(1)
+        val duration = testTimeSource.measureTime { pulse.beat {  } }
+        assertEquals(expected = 1.minutes, actual = duration)
+    }
+
+    @Test
+    fun schedulePulse_with_cron_expression_uses_supplied_time_zone() = runTest {
+        val timeZone = TimeZone.of("+05:00")
+        val pulse = testClock.schedulePulse("0 0 * * *", timeZone).take(1)
+        var scheduled: Instant? = null
+        pulse.beat { scheduled = it }
+        assertEquals(
+            expected = Instant.fromEpochSeconds(19 * 60 * 60),
+            actual = scheduled,
+        )
+    }
+
+    @Test
+    fun schedulePulse_with_cron_expression_handles_daylight_savings() = runTest {
+        val timeZone = TimeZone.of("America/New_York")
+        testScheduler.advanceTimeBy(Instant.parse("2021-03-13T20:00:00Z").toEpochMilliseconds())
+        val pulse = testClock.schedulePulse("0 12 * * *", timeZone).take(1)
+        var scheduled: Instant? = null
+        pulse.beat { scheduled = it }
+        assertEquals(
+            expected = Instant.parse("2021-03-14T16:00:00Z"),
+            actual = scheduled,
+        )
+    }
+
+    @Test
+    fun schedulePulse_with_cron_lists_ranges_and_names() = runTest {
+        val pulse = testClock.schedulePulse("5,7-8 0 * APR MON-FRI").take(3)
+        val scheduled = mutableListOf<Instant>()
+        pulse.beat { scheduled.add(it) }
+        val aprilFirstAtMidnight = Instant.fromEpochSeconds(90 * 24 * 60 * 60)
+        assertEquals(
+            expected = listOf(
+                aprilFirstAtMidnight + 5.minutes,
+                aprilFirstAtMidnight + 7.minutes,
+                aprilFirstAtMidnight + 8.minutes,
+            ),
+            actual = scheduled,
+        )
+    }
+
+    @Test
+    fun schedulePulse_with_unsupported_cron_extensions_throws() = runTest {
+        val unsupportedExpressions = listOf(
+            "*/5 * * * *",
+            "0 0 0 * * *",
+            "0 0 * * * 2025",
+            "@monthly",
+        )
+        unsupportedExpressions.forEach { expression ->
+            assertFailsWith<IllegalArgumentException> {
+                testClock.schedulePulse(expression)
+            }
+        }
+    }
+
+    @Test
+    fun schedulePulse_with_malformed_cron_expression_throws() = runTest {
+        assertFailsWith<IllegalArgumentException> {
+            testClock.schedulePulse("not a cron expression")
+        }
+    }
+
+    @Test
+    fun schedulePulse_with_out_of_range_cron_expression_throws() = runTest {
+        assertFailsWith<IllegalArgumentException> {
+            testClock.schedulePulse("60 * * * *")
+        }
+    }
