+func bindGin3971CustomFormParam(name, value string, dst any) error {
+	values := url.Values{name: {value}}
+	req := httptest.NewRequest("POST", "/", strings.NewReader(values.Encode()))
+	req.Header.Set("Content-Type", MIMEPOSTForm)
+	return Form.Bind(req, dst)
+}
+
+type gin3971CustomPath []string
+
+var errGin3971InvalidPath = errors.New("invalid path")
+
+func (p *gin3971CustomPath) UnmarshalParam(param string) error {
+	elems := strings.Split(param, "/")
+	n := len(elems)
+	if n < 2 {
+		return errGin3971InvalidPath
+	}
+
+	*p = elems
+	return nil
+}
+
+func TestGin3971MappingCustomSliceUri(t *testing.T) {
+	var s struct {
+		FileData gin3971CustomPath `uri:"path"`
+	}
+	err := Uri.BindUri(map[string][]string{"path": {`bar/foo`}}, &s)
+	assert.NoError(t, err)
+
+	assert.EqualValues(t, gin3971CustomPath{"bar", "foo"}, s.FileData)
+}
+
+func TestGin3971MappingCustomSliceForm(t *testing.T) {
+	var s struct {
+		FileData gin3971CustomPath `form:"path"`
+	}
+	err := bindGin3971CustomFormParam("path", `bar/foo`, &s)
+	assert.NoError(t, err)
+
+	assert.EqualValues(t, gin3971CustomPath{"bar", "foo"}, s.FileData)
+}
+
+func TestGin3971MappingCustomSliceQuery(t *testing.T) {
+	var s struct {
+		FileData gin3971CustomPath `form:"path"`
+	}
+	req := httptest.NewRequest("GET", "/?path=bar/foo", nil)
+	err := Query.Bind(req, &s)
+	assert.NoError(t, err)
+
+	assert.EqualValues(t, gin3971CustomPath{"bar", "foo"}, s.FileData)
+}
+
+type gin3971ObjectID [12]byte
+
+func (o *gin3971ObjectID) UnmarshalParam(param string) error {
+	oid, err := convertGin3971ObjectID(param)
+	if err != nil {
+		return err
+	}
+
+	*o = oid
+	return nil
+}
+
+var errGin3971InvalidObjectID = errors.New("invalid object id")
+
+func convertGin3971ObjectID(s string) (gin3971ObjectID, error) {
+	var nilObjectID gin3971ObjectID
+	if len(s) != 24 {
+		return nilObjectID, errGin3971InvalidObjectID
+	}
+
+	var oid [12]byte
+	if _, err := hex.Decode(oid[:], []byte(s)); err != nil {
+		return nilObjectID, errGin3971InvalidObjectID
+	}
+
+	return oid, nil
+}
+
+func TestGin3971MappingCustomArrayUri(t *testing.T) {
+	var s struct {
+		FileData gin3971ObjectID `uri:"id"`
+	}
+	val := `664a062ac74a8ad104e0e80f`
+	err := Uri.BindUri(map[string][]string{"id": {val}}, &s)
+	assert.NoError(t, err)
+
+	expected, _ := convertGin3971ObjectID(val)
+	assert.EqualValues(t, expected, s.FileData)
+}
+
+func TestGin3971MappingCustomArrayForm(t *testing.T) {
+	var s struct {
+		FileData gin3971ObjectID `form:"id"`
+	}
+	val := `664a062ac74a8ad104e0e80f`
+	err := bindGin3971CustomFormParam("id", val, &s)
+	assert.NoError(t, err)
+
+	expected, _ := convertGin3971ObjectID(val)
+	assert.EqualValues(t, expected, s.FileData)
+}
