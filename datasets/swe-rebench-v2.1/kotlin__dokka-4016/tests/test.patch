+    @Test
+    fun `should not fail with multiple pages associated with key when an actual class overrides a Java parent method #4016`() = testInline(
+        """
+        /src/common/test.kt
+        expect class Skiko
+
+        /src/jvm/JavaParent.java
+        public class JavaParent {
+            public boolean isShowing() {
+                return true;
+            }
+        }
+
+        /src/jvm/test.kt
+        actual class Skiko actual constructor(): JavaParent() {
+             override fun isShowing(): Boolean {
+                return false
+            }
+        }
+
+        /src/native/test.kt
+        actual class Skiko actual constructor(){
+            fun isShowing(): Boolean {
+                return false
+            }
+        }
+        """.trimMargin(),
+        multiplatformConfiguration
+    ) {
+        renderingStage = { root, _ ->
+            val memberNames = root.withDescendants()
+                .filterIsInstance<MemberPageNode>()
+                .flatMap { it.documentables }
+                .map { it.name }
+            assertTrue(
+                memberNames.any { it == "isShowing" },
+                "The isShowing member should be documented"
+            )
+        }
+    }
+
