   expect_lint(
     "a <- 1
     function() {
@@ -54,3 +50,60 @@ test_that("returns the correct linting", {
   expect_lint('fun(""=42)', msg_zero_length_var)
   expect_lint('fun(a=1,""=42)', msg_zero_length_var)
 })
+
+test_that("load_cache suppresses warnings from unreadable cache files", {
+  path <- tempfile("lintr_cache_")
+  source_file <- "R/test.R"
+  save_cache(new.env(parent = emptyenv()), file = source_file, path = path)
+  cache_file <- list.files(path, full.names = TRUE)
+
+  observed_warnings <- character()
+  read_bad_cache <- function() {
+    withCallingHandlers(
+      load_cache(file = source_file, path = path),
+      warning = function(w) {
+        observed_warnings <<- c(observed_warnings, conditionMessage(w))
+        invokeRestart("muffleWarning")
+      }
+    )
+  }
+
+  writeLines(character(), cache_file)
+  empty_cache <- read_bad_cache()
+  expect_length(ls(empty_cache), 0L)
+  expect_false(any(grepl("truncating string with embedded nuls", observed_warnings, fixed = TRUE)))
+
+  observed_warnings <- character()
+  saveRDS(list(x = 1), cache_file)
+  empty_cache <- read_bad_cache()
+  expect_length(ls(empty_cache), 0L)
+  expect_false(any(grepl(
+    "truncating string with embedded nuls",
+    observed_warnings,
+    fixed = TRUE
+  )))
+  expect_false(any(grepl("has magic number", observed_warnings, fixed = TRUE)))
+})
+
+test_that("named cache workflows do not warn about positional relative_path", {
+  package_path <- "dummy_packages/package"
+  withr::local_options(lintr.cache_directory = tempfile("lintr_cache_"))
+
+  observed_warnings <- character()
+  withCallingHandlers(
+    {
+      lint_package(package_path, cache = TRUE)
+      lint_package(package_path, cache = TRUE)
+    },
+    warning = function(w) {
+      observed_warnings <<- c(observed_warnings, conditionMessage(w))
+      invokeRestart("muffleWarning")
+    }
+  )
+
+  expect_false(any(grepl(
+    "'relative_path' is no longer available as a positional argument",
+    observed_warnings,
+    fixed = TRUE
+  )))
+})
