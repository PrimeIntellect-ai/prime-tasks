diff --git a/Tests/XcbeautifyLibTests/RendererTests/TerminalRendererTests.swift b/Tests/XcbeautifyLibTests/RendererTests/TerminalRendererTests.swift
index 14c4bbc..8ec5b6e 100644
--- a/Tests/XcbeautifyLibTests/RendererTests/TerminalRendererTests.swift
+++ b/Tests/XcbeautifyLibTests/RendererTests/TerminalRendererTests.swift
@@ -785,4 +785,23 @@ final class TerminalRendererTests: XCTestCase {
         let input = "EmitSwiftModule normal arm64 (in target 'Target' from project 'Project')"
         XCTAssertNil(noColoredFormatted(input))
     }
+
+    func testNote() {
+        let formatted = noColoredFormatted("note: Building targets in dependency order")
+        XCTAssertTrue(formatted?.contains("Building targets in dependency order") == true)
+    }
+
+    func testColoredNote() throws {
+        let coloredFormatter = Formatter(colored: true, renderer: .terminal, additionalLines: { nil })
+        let captureGroup = try XCTUnwrap(parser.parse(line: "note: Building targets in dependency order"))
+        let formatted = try XCTUnwrap(coloredFormatter.format(captureGroup: captureGroup))
+
+        // The note text is preserved once ANSI styling is removed.
+        let plain = formatted.replacingOccurrences(
+            of: "\u{001B}\\[[0-9;]*m",
+            with: "",
+            options: .regularExpression
+        )
+        XCTAssertTrue(plain.contains("Building targets in dependency order"))
+    }
 }
