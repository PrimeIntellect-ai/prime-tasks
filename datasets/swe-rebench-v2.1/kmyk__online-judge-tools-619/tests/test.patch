+    def snippet_call_download_samples_ignoring_trailing_newlines(self, url, samples):
+        # Checks the downloaded sample contents as text, ignoring trailing line breaks.
+        with tests.utils.sandbox([]):
+            tests.utils.run(['download', url], check=True)
+            actual = {}
+            for name in os.listdir('test'):
+                with open(os.path.join('test', name)) as fh:
+                    actual[name] = fh.read().rstrip('\r\n')
+        expected = {}
+        for i, sample in enumerate(samples):
+            expected['sample-{}.in'.format(i + 1)] = sample['input'].rstrip('\r\n')
+            expected['sample-{}.out'.format(i + 1)] = sample['output'].rstrip('\r\n')
+        self.assertEqual(set(expected.keys()), set(actual.keys()))
+        for name in expected:
+            self.assertEqual(expected[name], actual[name], name)
+
+    def test_call_download_atcoder_tenka1_2014_qualA_e(self):
+        # This problem uses an unusual HTML markup; see https://github.com/kmyk/online-judge-tools/issues/618
+        self.snippet_call_download_samples_ignoring_trailing_newlines('https://atcoder.jp/contests/tenka1-2014-quala/tasks/tenka1_2014_qualA_e', [
+            {
+                "input": "5 3\nAAB\nABB\nCDE\nFFH\nGHH\n2\n1 1\n2 3\n",
+                "output": "15\n7\n"
+            },
+            {
+                "input": "2 2\nAB\nBA\n2\n1 1\n2 1\n",
+                "output": "2\n2\n"
+            },
+            {
+                "input": "5 5\nAABAA\nACDEA\nAFGHA\nAIJKA\nAAAAA\n1\n3 1\n",
+                "output": "25\n"
+            },
+        ])
+
+    def test_call_download_atcoder_tenka1_2014_qualA_b(self):
+        self.snippet_call_download_samples_ignoring_trailing_newlines('https://atcoder.jp/contests/tenka1-2014-quala/tasks/tenka1_2014_qualA_b', [
+            {
