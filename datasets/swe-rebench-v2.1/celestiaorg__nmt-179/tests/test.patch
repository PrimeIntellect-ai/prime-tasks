+// TestVerifyLeafHashes_MalformedProofNodes checks that verifyLeafHashes rejects
+// a proof whose nodes do not conform to the namespaced hash format, instead of
+// panicking while the completeness check extracts namespace IDs from them.
+func TestVerifyLeafHashes_MalformedProofNodes(t *testing.T) {
+	nIDs := []byte{1, 2, 3, 4, 5, 6, 7, 8}
+	nmt := exampleNMT(1, nIDs...)
+	root, err := nmt.Root()
+	require.NoError(t, err)
+	nid4 := namespace.ID{4}
+	proof, err := nmt.ProveNamespace(nid4) // leaf at index 3 has namespace ID 4
+	require.NoError(t, err)
+	require.NotEmpty(t, proof.nodes)
+	leafHash := nmt.leafHashes[3]
+
+	// replace the first proof node with an empty value, which is not a valid node
+	malformed := proof
+	malformed.nodes = append([][]byte{{}}, proof.nodes[1:]...)
+
+	hasher := NewNmtHasher(sha256.New(), 1, true)
+	assert.NotPanics(t, func() {
+		got, _ := malformed.verifyLeafHashes(hasher, true, nid4, [][]byte{leafHash}, root)
+		assert.False(t, got)
+	})
+}
