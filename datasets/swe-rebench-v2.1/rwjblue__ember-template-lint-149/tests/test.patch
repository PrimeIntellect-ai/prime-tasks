+'use strict';
+
+var assert = require('power-assert');
+var Linter = require('../../../lib/index');
+
+var inlineStyles = [
+  'style="width: 100px"',
+  'style={{foo}}',
+  'style="{{foo}} {{bar}}"',
+  'style',
+  'style=""',
+  'style="color:blue;margin-left:30px;"'
+];
+
+describe('inline-styles', function() {
+  var linter;
+
+  beforeEach(function() {
+    linter = new Linter({
+      config: {
+        rules: {
+          'inline-styles': true
+        }
+      }
+    });
+  });
+
+  inlineStyles.forEach(function(styleAttribute) {
+    it('reports an inline style attribute: ' + styleAttribute, function() {
+      var issues = linter.verify({
+        source: '<div ' + styleAttribute + '></div>',
+        moduleId: 'layout.hbs'
+      });
+
+      assert.equal(issues.length, 1);
+      assert.equal(issues[0].rule, 'inline-styles');
+    });
+  });
+
+  it('does not report elements without an inline style attribute', function() {
+    var issues = linter.verify({
+      source: '<div></div><span class="example"></span>',
+      moduleId: 'layout.hbs'
+    });
+
+    assert.deepEqual(issues, []);
+  });
+
+  it('can be disabled with an inline directive comment', function() {
+    var issues = linter.verify({
+      source: '{{! template-lint-disable inline-styles }}\n<div style="width: 100px"></div>',
+      moduleId: 'layout.hbs'
+    });
+
+    assert.deepEqual(issues, []);
+  });
+});
