+defmodule Commanded.Aggregates.NoopCommand do
+  defstruct [:account_number]
+end
+
+defmodule Commanded.Aggregates.NoopHandler do
+  @moduledoc false
+  @behaviour Commanded.Commands.Handler
+
+  def handle(_aggregate, _command), do: []
