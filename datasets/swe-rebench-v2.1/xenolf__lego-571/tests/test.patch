 	}
 }
+
+// TestACMEHTTPClientAcceptsConfiguredCustomCA verifies that the package-level HTTPClient trusts a
+// non-standard CA certificate configured through the LEGO_CA_CERTIFICATES
+// environment variable. HTTPClient is initialized when the package is loaded,
+// so the environment variable has to be set before the process starts. This
+// test therefore starts a TLS server with a self-signed certificate and then
+// re-runs the test binary as a child process with LEGO_CA_CERTIFICATES pointing
+// at that certificate; the child process makes an HTTPS request through
+// HTTPClient and must succeed.
+func TestACMEHTTPClientAcceptsConfiguredCustomCA(t *testing.T) {
+	if serverURL := os.Getenv("LEGO_TEST_SERVER_URL"); serverURL != "" {
+		// Child process: the package was initialized with the custom CA
+		// configured, so an HTTPS request to the test server must succeed.
+		resp, err := HTTPClient.Get(serverURL)
+		if err != nil {
+			t.Fatalf("HTTPClient.Get(%q) failed with a custom CA configured: %v", serverURL, err)
+		}
+		resp.Body.Close()
+		return
+	}
+
+	// Parent process: start a TLS server using a self-signed certificate and
+	// re-run this test in a child process with LEGO_CA_CERTIFICATES pointing at
+	// that certificate.
+	ts := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer ts.Close()
+
+	certPEM := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: ts.Certificate().Raw})
+	caFile, err := ioutil.TempFile("", "custom-ca.pem")
+	if err != nil {
+		t.Fatalf("Unable to create tempfile: %v", err)
+	}
+	defer os.Remove(caFile.Name())
+	if err := ioutil.WriteFile(caFile.Name(), certPEM, 0600); err != nil {
+		t.Fatalf("Unable to write tempfile contents: %v", err)
+	}
+
+	proc, err := os.StartProcess(os.Args[0],
+		[]string{os.Args[0], "-test.run=TestACMEHTTPClientAcceptsConfiguredCustomCA", "-test.v"},
+		&os.ProcAttr{
+			Files: []*os.File{os.Stdin, os.Stdout, os.Stderr},
+			Env: append(os.Environ(),
+				"LEGO_CA_CERTIFICATES="+caFile.Name(),
+				"LEGO_TEST_SERVER_URL="+ts.URL,
+			),
+		})
+	if err != nil {
+		t.Fatalf("Unable to start child test process: %v", err)
+	}
+	state, err := proc.Wait()
+	if err != nil {
+		t.Fatalf("Child test process failed: %v", err)
+	}
+	if !state.Success() {
+		t.Fatalf("HTTPClient did not trust the CA configured via LEGO_CA_CERTIFICATES (child process returned %v)", state)
+	}
+}
