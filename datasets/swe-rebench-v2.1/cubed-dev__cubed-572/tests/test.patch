+@pytest.mark.skipif(
+    zarr.__version__[0] == "3",
+    reason="setting zarr compressor not yet possible for Zarr Python v3",
+)
+def test_spec_compressor(tmp_path):
+    spec = cubed.Spec(tmp_path, allowed_mem=100000, zarr_compressor=None)
+    a = xp.ones((3, 3), chunks=(2, 2), spec=spec)
+    b = xp.negative(a)
+    assert_array_equal(b.compute(), -np.ones((3, 3)))
+
+    # Intermediate arrays requested without compression remain readable.
+    zarr_paths = sorted(tmp_path.rglob("*.zarr"))
+    assert zarr_paths
+    for zarr_path in zarr_paths:
+        with config.set({"storage_name": "zarr-python"}):
+            z = open_backend_array(zarr_path, mode="r")
+        assert z.compressor is None
+
+
+@pytest.mark.skipif(
+    zarr.__version__[0] == "3",
+    reason="setting zarr compressor not yet possible for Zarr Python v3",
+)
+def test_spec_default_compressor(tmp_path):
+    spec = cubed.Spec(tmp_path, allowed_mem=100000)
+    a = xp.ones((3, 3), chunks=(2, 2), spec=spec)
+    b = xp.negative(a)
+    assert_array_equal(b.compute(), -np.ones((3, 3)))
+
+    zarr_paths = sorted(tmp_path.rglob("*.zarr"))
+    assert zarr_paths
+    for i, zarr_path in enumerate(zarr_paths):
+        with config.set({"storage_name": "zarr-python"}):
+            z = open_backend_array(zarr_path, mode="r")
+        # Without a compressor choice, the Zarr library's default compressor is used
+        reference = zarr.open_array(
+            tmp_path / f"reference_{i}.zarr",
+            mode="w",
+            shape=z.shape,
+            chunks=z.chunks,
+            dtype=z.dtype,
+        )
+        assert z.compressor is not None
+        assert z.compressor == reference.compressor
+
+
