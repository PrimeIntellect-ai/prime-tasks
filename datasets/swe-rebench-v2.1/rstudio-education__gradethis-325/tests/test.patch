diff --git a/tests/testthat/test-grade_this_code.R b/tests/testthat/test-grade_this_code.R
index c0447f7..58f4478 100644
--- a/tests/testthat/test-grade_this_code.R
+++ b/tests/testthat/test-grade_this_code.R
@@ -191,3 +191,23 @@ test_that("grade_this_code() doesn't have to return a grade", {
   expect_graded(grade_this_code(action = "pass")(ex_ok), is_correct = TRUE)
   expect_null(grade_this_code(action = "fail")(ex_ok))
 })
+
+test_that("grade_this_code() doesn't duplicate feedback", {
+  ex <- mock_this_exercise("1", "2")
+  feedback <- code_feedback(ex$.user_code, ex$.solution_code)
+
+  count_feedback <- function(message, feedback) {
+    message <- paste(message, collapse = "\n")
+    length(regmatches(message, gregexpr(feedback, message, fixed = TRUE))[[1]])
+  }
+
+  withr::with_options(
+    list(gradethis.fail.hint = FALSE),
+    expect_equal(count_feedback(grade_this_code()(ex)$message, feedback), 1)
+  )
+
+  withr::with_options(
+    list(gradethis.fail.hint = TRUE),
+    expect_equal(count_feedback(grade_this_code()(ex)$message, feedback), 1)
+  )
+})
