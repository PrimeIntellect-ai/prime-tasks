+
+func TestSyncEnabled(t *testing.T) {
+	ctrl := gomock.NewController(t)
+
+	pm := mock.NewMockMeter(ctrl)
+	gm := mock.NewMockMeter(ctrl)
+	cm := mock.NewMockMeter(ctrl)
+
+	lp, wb := newEnvironment(t, ctrl, pm, gm, cm)
+	lp.Mode = api.ModeNow
+
+	// charger reports disabled although EVCC internal state is enabled
+	wb.EXPECT().Status().Return(api.StatusB, nil)
+	pm.EXPECT().CurrentPower().Return(0.0, nil)
+	gm.EXPECT().CurrentPower().Return(0.0, nil)
+	cm.EXPECT().CurrentPower().Return(0.0, nil)
+
+	wb.EXPECT().Enabled().Return(false, nil).MinTimes(1)
+	wb.EXPECT().Enable(true)
+
+	wb.EXPECT().MaxCurrent(lpMaxCurrent)
+
+	lp.update()
+	ctrl.Finish()
+}
