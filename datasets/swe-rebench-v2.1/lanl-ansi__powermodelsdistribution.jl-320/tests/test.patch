diff --git a/test/opf.jl b/test/opf.jl
index b80eedc..a266980 100644
--- a/test/opf.jl
+++ b/test/opf.jl
@@ -274,5 +274,64 @@
             @test isapprox(sol_ivr["objective"], sol_ivr_with_start["objective"]; atol=1e-5)
             @test isapprox(sol_acr["objective"], sol_acr_with_start["objective"]; atol=1e-5)
         end
+
+        @testset "start values for single-phase components" begin
+            # single-terminal bus, reduced from a three-phase bus, with a start value
+            data = parse_file("../test/data/opendss/case3_unbalanced.dss"; data_model = MATHEMATICAL)
+            delete!(data["load"], "2")
+            delete!(data["load"], "3")
+            data["bus"]["3"]["terminals"] = [2]
+            data["bus"]["3"]["grounded"] = Bool[0.0]
+            data["branch"]["1"]["t_connections"] = [2]
+            data["branch"]["1"]["f_connections"] = [2]
+            data["bus"]["3"]["vm_start"] = [0.9959]
+
+            sol = run_ac_mc_pf(data, ipopt_solver)
+            @test sol["termination_status"] == LOCALLY_SOLVED
+
+            # single-phase generator with start values
+            data = parse_file("../test/data/opendss/case3_unbalanced.dss"; data_model = MATHEMATICAL)
+            delete!(data["load"], "2")
+            delete!(data["load"], "3")
+            data["gen"]["2"] = Dict{String, Any}(
+                                "pg_start"      => [-0.012],
+                                "qg_start"      => [-0.006],
+                                "model"         => 2,
+                                "connections"   => [2],
+                                "shutdown"      => 0.0,
+                                "startup"       => 0.0,
+                                "configuration" => WYE,
+                                "name"          => "single_ph_generator",
+                                "gen_bus"       => 3,
+                                "pmax"          => [Inf],
+                                "vbase"         => 0.23094,
+                                "index"         => 2,
+                                "cost"          => [0.5, 0.0],
+                                "gen_status"    => 1,
+                                "qmax"          => [Inf],
+                                "qmin"          => [-Inf],
+                                "pmin"          => [-Inf],
+                                "ncost"         => 2
+                                )
+
+            data["bus"]["3"]["terminals"] = [2]
+            data["bus"]["3"]["grounded"] = Bool[0.0]
+            data["branch"]["1"]["t_connections"] = [2]
+            data["branch"]["1"]["f_connections"] = [2]
+            data["branch"]["1"]["angmin"] = [-0.5235987755982988]
+            data["branch"]["1"]["angmax"] = [0.5235987755982988]
+            data["branch"]["1"]["p_start"] = [0.025]
+
+            pm = instantiate_mc_model(data, ACPPowerModel, build_mc_opf)
+            @test JuMP.start_value(PM.var(pm, pm.cnw, :pg, 2)[2]) == -0.012
+            @test JuMP.start_value(PM.var(pm, pm.cnw, :qg, 2)[2]) == -0.006
+
+            branch_p = PM.var(pm, pm.cnw, :p)
+            branch_arc = first(arc for arc in keys(branch_p) if arc[1] == 1)
+            @test JuMP.start_value(branch_p[branch_arc][2]) == 0.025
+
+            sol = run_mc_opf(data, ACPPowerModel, ipopt_solver)
+            @test sol["termination_status"] == LOCALLY_SOLVED
+        end
     end
 end
