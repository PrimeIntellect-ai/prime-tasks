+func TestCloudflareCredentialAliases(t *testing.T) {
+	keys := []string{"CLOUDFLARE_EMAIL", "CLOUDFLARE_API_KEY", "CF_API_EMAIL", "CF_API_KEY"}
+	previous := make(map[string]string)
+	wasSet := make(map[string]bool)
+	for _, key := range keys {
+		previous[key], wasSet[key] = os.LookupEnv(key)
+		if err := os.Unsetenv(key); err != nil {
+			t.Fatal(err)
+		}
+	}
+	defer func() {
+		for _, key := range keys {
+			if wasSet[key] {
+				_ = os.Setenv(key, previous[key])
+			} else {
+				_ = os.Unsetenv(key)
+			}
+		}
+	}()
+
+	t.Run("CF_API_EMAIL is accepted", func(t *testing.T) {
+		for _, key := range keys {
+			if err := os.Unsetenv(key); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := os.Setenv("CF_API_EMAIL", "alias@example.com"); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Setenv("CLOUDFLARE_API_KEY", "test-key"); err != nil {
+			t.Fatal(err)
+		}
+
+		_, err := cloudflare.NewDNSProvider()
+		require.NoError(t, err)
+	})
+
+	t.Run("CF_API_KEY is accepted", func(t *testing.T) {
+		for _, key := range keys {
+			if err := os.Unsetenv(key); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := os.Setenv("CLOUDFLARE_EMAIL", "legacy@example.com"); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Setenv("CF_API_KEY", "alias-key"); err != nil {
+			t.Fatal(err)
+		}
+
+		_, err := cloudflare.NewDNSProvider()
+		require.NoError(t, err)
+	})
+}
