+package com.sendgrid.helpers;
+
+import com.sendgrid.Attachments;
+import org.apache.commons.codec.binary.Base64;
+import org.junit.Assert;
+import org.junit.Test;
+
+import java.io.ByteArrayInputStream;
+import java.io.InputStream;
+import java.nio.charset.Charset;
+
+public class AttachmentBuilderTest {
+
+    @Test
+    public void testCreateAttachmentsFromInputStream() {
+        String fileName = "book.txt";
+        byte[] content = "This test checks if the builder works fine".getBytes(Charset.forName("UTF-8"));
+        InputStream contentStream = new ByteArrayInputStream(content);
+
+        Attachments attachments = new Attachments.Builder(fileName, contentStream).build();
+
+        Assert.assertEquals(Base64.encodeBase64String(content), attachments.getContent());
+    }
+}
