+    def test_load_config_with_relative_paths_argfile(self, path_to_test_data):
+        """
+        Argument files resolves relative paths to config directory.
+        """
+        src = path_to_test_data / "relative_path_in_argfile"
+        work_dir = src
+        with working_directory(work_dir), patch.object(sys, "argv", ["robocop", "-A", "tests/args.txt"]):
+            config = Config(from_cli=True)
+            ext_rule_path = config.ext_rules.pop()
+            assert Path(ext_rule_path).absolute() == work_dir / "tests/libraries/test.py"
+
+    def test_dot_relative_ext_rules_path_uses_launch_directory(self, tmp_path):
+        launch_dir = tmp_path
+        argument_dir = launch_dir / "arguments"
+        launch_rules = launch_dir / "libraries" / "test.py"
+        argument_dir.mkdir()
+        launch_rules.parent.mkdir()
+        launch_rules.touch()
+        argument_file = argument_dir / "args.txt"
+        argument_file.write_text("--ext-rules ./libraries/test.py\n", encoding="utf-8")
+
+        with working_directory(launch_dir), patch.object(sys, "argv", ["robocop", "-A", str(argument_file)]):
+            config = Config(from_cli=True)
+            resolved_rule = Path(config.ext_rules.pop()).absolute()
+
+        assert resolved_rule == launch_rules
+
