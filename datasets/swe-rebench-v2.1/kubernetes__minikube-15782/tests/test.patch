+// minikubeNamedHelperSrc is a tiny program compiled to an executable named
+// "minikube" so that the mount cleanup logic recognizes the spawned process
+// as one started by minikube.
+const minikubeNamedHelperSrc = `package main
+
+import (
+"os"
+"os/signal"
+"syscall"
+)
+
+func main() {
+ch := make(chan os.Signal, 1)
+signal.Notify(ch, syscall.SIGHUP)
+<-ch
+}
+`
+
+// TestMountKillMultipleProcesses verifies that `minikube mount --kill`
+// terminates every mount process recorded for the profile, not just one.
+func TestMountKillMultipleProcesses(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("skipping: mount --kill cleanup test is not supported on windows")
+	}
+
+	// Build the minikube binary under test.
+	binDir := t.TempDir()
+	minikubeBin := filepath.Join(binDir, "minikube")
+	build := exec.Command("go", "build", "-o", minikubeBin, "k8s.io/minikube/cmd/minikube")
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("building minikube: %v\n%s", err, out)
+	}
+
+	// Build a helper process whose executable name is "minikube" so the
+	// cleanup logic recognizes it as a minikube-spawned process.
+	helperDir := t.TempDir()
+	helperSrc := filepath.Join(helperDir, "main.go")
+	if err := os.WriteFile(helperSrc, []byte(minikubeNamedHelperSrc), 0o600); err != nil {
+		t.Fatalf("writing helper source: %v", err)
+	}
+	helperBin := filepath.Join(helperDir, "minikube")
+	buildHelper := exec.Command("go", "build", "-o", helperBin, helperSrc)
+	if out, err := buildHelper.CombinedOutput(); err != nil {
+		t.Fatalf("building helper: %v\n%s", err, out)
+	}
+
+	home := t.TempDir()
+	profile := "mountkilltest"
+	profileDir := filepath.Join(home, ".minikube", "profiles", profile)
+	if err := os.MkdirAll(profileDir, 0o755); err != nil {
+		t.Fatalf("creating profile dir: %v", err)
+	}
+
+	const numMounts = 3
+	var procs []*exec.Cmd
+	for i := 0; i < numMounts; i++ {
+		cmd := exec.Command(helperBin, "mount", "-p", profile, fmt.Sprintf("/tmp:/mount%d", i))
+		if err := cmd.Start(); err != nil {
+			t.Fatalf("starting helper process: %v", err)
+		}
+		procs = append(procs, cmd)
+	}
+	defer func() {
+		for _, p := range procs {
+			if p.Process != nil {
+				_ = p.Process.Kill()
+			}
+		}
+	}()
+
+	var pidStrs []string
+	for _, p := range procs {
+		pidStrs = append(pidStrs, fmt.Sprintf("%d", p.Process.Pid))
+	}
+	pidFile := filepath.Join(profileDir, constants.MountProcessFileName)
+	if err := os.WriteFile(pidFile, []byte(strings.Join(pidStrs, " ")), 0o644); err != nil {
+		t.Fatalf("writing pid file: %v", err)
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	killCmd := exec.CommandContext(ctx, minikubeBin, "mount", "-p", profile, "--kill=true")
+	env := []string{}
+	for _, e := range os.Environ() {
+		if strings.HasPrefix(e, localpath.MinikubeHome+"=") {
+			continue
+		}
+		env = append(env, e)
+	}
+	killCmd.Env = append(env, localpath.MinikubeHome+"="+home)
+	if out, err := killCmd.CombinedOutput(); err != nil {
+		t.Fatalf("minikube mount --kill failed: %v\n%s", err, out)
+	}
+
+	for _, p := range procs {
+		done := make(chan error, 1)
+		go func(c *exec.Cmd) { done <- c.Wait() }(p)
+		select {
+		case <-done:
+		case <-time.After(10 * time.Second):
+			t.Errorf("process %d is still running after mount --kill", p.Process.Pid)
+		}
+	}
+}
