+
+func TestClone(t *testing.T) {
+	parent := New()
+	parent.SetBaseURL("http://localhost")
+	parent.UserInfo = &User{Username: "parent"}
+
+	method, found := reflect.ValueOf(parent).Type().MethodByName("Clone")
+	if !found {
+		t.Fatal("client does not provide Clone")
+	}
+	clientType := reflect.TypeOf((*Client)(nil))
+	if method.Type.NumIn() != 1 || method.Type.NumOut() != 1 || method.Type.Out(0) != clientType {
+		t.Fatal("Clone has an incompatible signature")
+	}
+	clone := reflect.ValueOf(parent).MethodByName("Clone").Call(nil)[0].Interface().(*Client)
+	if clone == nil {
+		t.Fatal("Clone returned a nil client")
+	}
+	if clone == parent {
+		t.Fatal("Clone returned the original client")
+	}
+	assertEqual(t, parent.BaseURL, clone.BaseURL)
+	if clone.UserInfo == nil {
+		t.Fatal("Clone did not retain the configured user")
+	}
+	assertEqual(t, parent.UserInfo.Username, clone.UserInfo.Username)
+
+	clone.SetBaseURL("https://local.host")
+	assertEqual(t, "http://localhost", parent.BaseURL)
+	assertEqual(t, "https://local.host", clone.BaseURL)
+}
