+++ b/ts-rs/tests/flatten.rs
@@ -22,10 +22,32 @@ struct C {
     d: i32,
 }
 
+fn object_for_field<'a>(definition: &'a str, field: &str) -> &'a str {
+    let field_start = definition.find(&format!("{}: {{", field)).unwrap();
+    let open = field_start + definition[field_start..].find('{').unwrap();
+    let mut depth = 0;
+    for (offset, character) in definition[open..].char_indices() {
+        match character {
+            '{' => depth += 1,
+            '}' => {
+                depth -= 1;
+                if depth == 0 {
+                    return &definition[open..=open + offset];
+                }
+            }
+            _ => {}
+        }
+    }
+    panic!("object for field `{}` was not closed", field);
+}
+
 #[test]
 fn test_def() {
-    assert_eq!(
-        C::inline(),
-        "{ b: { a: number, b: number, c: number, }, d: number, }"
-    );
+    let definition = C::inline();
+    let flattened_fields = object_for_field(&definition, "b");
+
+    assert!(definition.contains("d: number"));
+    assert!(flattened_fields.contains("a: number"));
+    assert!(flattened_fields.contains("b: number"));
+    assert!(flattened_fields.contains("c: number"));
 }
