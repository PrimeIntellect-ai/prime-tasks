+package day37
+
+import (
+	"testing"
+)
+
+var testcases = []struct {
+	input    []int
+	expected [][]int
+}{
+	{[]int{1, 2, 3}, [][]int{{}, {1}, {2}, {1, 2}, {3}, {1, 3}, {2, 3}, {1, 2, 3}}},
+	{[]int{4, 2, 3, 6}, [][]int{{}, {4}, {2}, {4, 2}, {3}, {4, 3}, {2, 3},
+		{4, 2, 3}, {6}, {4, 6}, {2, 6}, {4, 2, 6}, {3, 6}, {4, 3, 6}, {2, 3, 6}, {4, 2, 3, 6}}},
+	// Empty input yields 2^0 = 1 subset: the empty subset.
+	{[]int{}, [][]int{{}}},
+}
+
+// equalSubset compares subset membership without requiring an element order.
+func equalSubset(a, b []int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	used := make([]bool, len(b))
+	for _, value := range a {
+		found := false
+		for i, candidate := range b {
+			if !used[i] && value == candidate {
+				used[i] = true
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+
+func TestPowerSet(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		result := PowerSet(tc.input)
+		if len(result) != len(tc.expected) {
+			t.Errorf("Length of result doesn't match for input %v. Expected %v got %v", tc.input, len(tc.expected), len(result))
+			continue
+		}
+		matched := make([]bool, len(tc.expected))
+		for _, subset := range result {
+			found := false
+			for i, expected := range tc.expected {
+				if !matched[i] && equalSubset(subset, expected) {
+					matched[i] = true
+					found = true
+					break
+				}
+			}
+			if !found {
+				t.Errorf("For input %v got unexpected subset %v", tc.input, subset)
+			}
+		}
+	}
+}
+
+func BenchmarkPowerSet(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			PowerSet(tc.input)
+		}
+	}
+}
