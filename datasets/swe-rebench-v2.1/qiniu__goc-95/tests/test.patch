+
+// A module project with a relative local replacement builds from its original root.
+func TestBuildModProjectWithRelativeReplace(t *testing.T) {
+	workingDir := filepath.Join(baseDir, "../../tests/samples/gomod_replace_project")
+
+	t.Setenv("GOPATH", "")
+	t.Setenv("GO111MODULE", "on")
+
+	gocBuild, err := NewBuild("", []string{"."}, workingDir, "")
+	if !assert.NoError(t, err) {
+		t.FailNow()
+	}
+
+	assert.NoError(t, gocBuild.Build(), "a module project with a relative local replacement should build")
+}
