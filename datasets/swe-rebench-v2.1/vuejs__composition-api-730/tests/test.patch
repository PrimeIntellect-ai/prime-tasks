diff --git a/test/v3/reactivity/ref.spec.ts b/test/v3/reactivity/ref.spec.ts
index 6806224..ac48799 100644
--- a/test/v3/reactivity/ref.spec.ts
+++ b/test/v3/reactivity/ref.spec.ts
@@ -12,6 +12,7 @@ import {
   unref,
   isReactive,
   shallowRef,
+  proxyRefs,
 } from '../../../src'
 
 describe('reactivity/ref', () => {
@@ -342,4 +343,48 @@ describe('reactivity/ref', () => {
     _trigger!()
     expect(dummy).toBe(2)
   })
+
+  test('proxyRefs', () => {
+    const x = ref(1)
+    const a = {
+      x,
+      y: 'foo',
+    }
+    const p = proxyRefs(a)
+    expect(p.x).toBe(1)
+    expect(p.y).toBe('foo')
+
+    p.x = 2
+    p.y = 'bar'
+    // the proxy's set updates the ref's .value
+    expect(x.value).toBe(2)
+    expect(p.x).toBe(2)
+    // non-ref properties are accessed and mutated directly
+    expect(a.y).toBe('bar')
+
+    const r = reactive({ k: 'v' })
+    const s = proxyRefs(r)
+    expect(s.k).toBe('v')
+
+    r.k = 'k'
+    expect(s.k).toBe('k')
+  })
+
+  test('proxyRefs unwraps computed refs without infinite recursion', () => {
+    const object = proxyRefs({
+      a: computed(() => 1),
+    })
+    expect(object.a).toBe(1)
+  })
+
+  test('proxyRefs is shallow', () => {
+    const a = {
+      obj: {
+        y: ref('foo'),
+      },
+    }
+    const p = proxyRefs(a)
+    // non-ref properties are accessed directly, without recursive unwrapping
+    expect(p.obj).toBe(a.obj)
+  })
 })
