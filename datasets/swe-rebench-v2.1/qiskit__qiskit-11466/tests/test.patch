+    def test_annotated_multi_qubit(self):
+        """A controlled annotated operation's box spans every target qubit."""
+        gate = AnnotatedOperation(CXGate(), [ControlModifier(2, 2), InverseModifier()])
+        circuit = QuantumCircuit(gate.num_qubits)
+        circuit.append(gate, [0, 3, 1, 2])
+        drawing = str(circuit_drawer(circuit, output="text", initial_state=False))
+
+        # The box's top and bottom borders must enclose both CX target wires.
+        lines = drawing.splitlines()
+        target_rows = [
+            next(i for i, line in enumerate(lines) if line.startswith(f"q_{qubit}:"))
+            for qubit in (1, 2)
+        ]
+        top_rows = [i for i, line in enumerate(lines) if "┌" in line and i < target_rows[0]]
+        bottom_rows = [i for i, line in enumerate(lines) if "└" in line and i > target_rows[1]]
+        self.assertTrue(top_rows)
+        self.assertTrue(bottom_rows)
+        # Each target wire is drawn with a box wall rather than a bare wire.
+        for row in target_rows:
+            self.assertTrue(any(char in lines[row] for char in "┤├│"), lines[row])
+
 
 if __name__ == "__main__":
     unittest.main()
