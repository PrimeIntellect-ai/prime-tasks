+@pytest.fixture
+def mocker():
+    """Minimal stand-in for pytest-mock's ``mocker`` fixture.
+
+    The test environment does not always ship the ``pytest-mock`` plugin, so
+    provide a compatible ``patch`` helper backed by ``unittest.mock``.
+    """
+    patchers = []
+
+    class _Mocker(object):
+        def patch(self, target, *args, **kwargs):
+            patcher = unittest.mock.patch(target, *args, **kwargs)
+            mocked = patcher.start()
+            patchers.append(patcher)
+            return mocked
+
+    instance = _Mocker()
+    try:
+        yield instance
+    finally:
+        for patcher in reversed(patchers):
+            patcher.stop()
+
