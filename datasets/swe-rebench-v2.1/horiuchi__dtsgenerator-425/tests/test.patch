+describe('cli without config file', () => {
+    it('runs without a configuration file and does not report a config load error', () => {
+        const schema = JSON.stringify({
+            $schema: 'http://json-schema.org/draft-07/schema#',
+            $id: 'http://example.com/schema.json',
+            type: 'object',
+            properties: { name: { type: 'string' } },
+        });
+        const result = spawnSync(process.execPath, [
+            '-r', 'ts-node/register',
+            path.join(__dirname, '..', 'src', 'cli.ts'),
+            '--stdin',
+        ], {
+            input: schema,
+            encoding: 'utf-8',
+            cwd: path.join(__dirname, '..'),
+        });
+        assert.strictEqual(result.status, 0, 'stderr: ' + result.stderr);
+        assert.ok(!result.stderr.includes('Error to load config file'), 'unexpected config load error: ' + result.stderr);
+    }).timeout(20000);
