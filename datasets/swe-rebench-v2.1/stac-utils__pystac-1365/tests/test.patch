@@ -0,0 +1,16 @@
+# mypy: ignore-errors
+import sys
+from types import ModuleType
+from typing import Any
+
+
+def test_import_client_from_pystac_client_namespace(monkeypatch: Any) -> None:
+    stub = ModuleType("pystac_client")
+    sentinel = object()
+    stub.Client = sentinel  # type: ignore[attr-defined]
+    monkeypatch.setitem(sys.modules, "pystac_client", stub)
+    monkeypatch.delitem(sys.modules, "pystac.client", raising=False)
+
+    from pystac.client import Client
+
+    assert Client is sentinel
