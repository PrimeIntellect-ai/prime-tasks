+# -*- coding: utf-8 -*-
+from six.moves.cPickle import dumps
+from six.moves.cPickle import loads
+
+
+def test_models_are_usable_after_spec_pickling(cat_swagger_spec, cat_kwargs):
+    # A Spec that defines models can be pickled and unpickled, and the model
+    # types exposed by the restored Spec remain usable.
+    unpickled_spec = loads(dumps(cat_swagger_spec))
+
+    assert set(unpickled_spec.definitions) == set(cat_swagger_spec.definitions)
+
+    Cat = unpickled_spec.definitions['Cat']
+    cat = Cat(**cat_kwargs)
+    assert cat.name == cat_kwargs['name']
+    assert cat.id == cat_kwargs['id']
