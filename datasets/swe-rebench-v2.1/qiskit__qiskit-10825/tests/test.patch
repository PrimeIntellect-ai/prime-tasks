+    def test_multi_register(self):
+        """A reverse-directed CX in one of multiple registers is converted.
+
+        CouplingMap map: [0] -> [1]
+        """
+        qr1 = QuantumRegister(1, "qr1")
+        qr2 = QuantumRegister(1, "qr2")
+        circuit = QuantumCircuit(qr1, qr2)
+        circuit.cx(qr2, qr1)
+        circuit.cx(qr1, qr2)
+        coupling = CouplingMap([[0, 1]])
+        dag = circuit_to_dag(circuit)
+
+        pass_ = GateDirection(coupling)
+        after = pass_.run(dag)
+
+        self.assertTrue(
+            all(node.qargs == (qr1[0], qr2[0]) for node in after.op_nodes(CXGate))
+        )
+        self.assertTrue(Operator(circuit).equiv(Operator(dag_to_circuit(after))))
+
+    def test_multi_register_target(self):
+        """A reverse-directed CX across registers is converted for a Target."""
+        qr1 = QuantumRegister(1, "qr1")
+        qr2 = QuantumRegister(1, "qr2")
+        circuit = QuantumCircuit(qr1, qr2)
+        circuit.cx(qr2, qr1)
+        circuit.cx(qr1, qr2)
+
+        target = Target(num_qubits=2)
+        target.add_instruction(CXGate(), {(0, 1): None})
+        after = GateDirection(None, target=target)(circuit)
+
+        self.assertTrue(
+            all(
+                node.qargs == (qr1[0], qr2[0])
+                for node in circuit_to_dag(after).op_nodes(CXGate)
+            )
+        )
+        self.assertTrue(Operator(circuit).equiv(Operator(after)))
