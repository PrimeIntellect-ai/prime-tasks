+class TestCmdCheckoutMultipleStages(TestCheckout):
+    def test(self):
+        os.unlink(self.file1)
+
+        ret = main(['checkout', self.foo_stage.path, self.DATA_DIR + '.dvc'])
+
+        self.assertEqual(ret, 0)
+        self.assertTrue(os.path.isfile(self.FOO))
