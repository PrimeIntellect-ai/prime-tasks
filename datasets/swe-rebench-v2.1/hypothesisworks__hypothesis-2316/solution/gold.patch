+# not (with typing module generic types and some builtins as exceptions).
 _global_type_lookup = {
-    # Types with core Hypothesis strategies
     type(None): st.none(),
     bool: st.booleans(),
     int: st.integers(),
@@ -252,7 +271,6 @@ _global_type_lookup = {
     frozenset: st.builds(frozenset),
     dict: st.builds(dict),
