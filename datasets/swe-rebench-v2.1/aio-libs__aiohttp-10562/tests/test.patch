+async def test_tcp_connector_cancellation_is_not_replaced_by_socket_close_error(
+    loop: asyncio.AbstractEventLoop, start_connection: mock.AsyncMock
+) -> None:
+    req = ClientRequest("GET", URL("https://127.0.0.1:443"), loop=loop)
+    close_error = OSError(1, "error from closing socket")
+    start_connection.return_value.close.side_effect = close_error
+
+    conn = aiohttp.TCPConnector()
+    with (
+        mock.patch.object(
+            conn._loop,
+            "create_connection",
+            autospec=True,
+            spec_set=True,
+            side_effect=asyncio.CancelledError,
+        ),
+        pytest.raises((asyncio.CancelledError, aiohttp.ClientConnectionError)),
+    ):
+        await conn.connect(req, [], ClientTimeout())
+
+    await conn.close()
+
