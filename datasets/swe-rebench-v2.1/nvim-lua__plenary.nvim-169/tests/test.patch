+
+  describe("gitignore", function()
+    local function make_tree(files, directories)
+      local root = vim.fn.tempname()
+      vim.fn.mkdir(root, "p")
+      for _, directory in ipairs(directories) do
+        vim.fn.mkdir(root .. "/" .. directory, "p")
+      end
+      for path, lines in pairs(files) do
+        vim.fn.writefile(lines, root .. "/" .. path)
+      end
+      return root
+    end
+
+    local function remove_tree(root)
+      vim.fn.delete(root, "rf")
+    end
+
+    it("ignores **/bin directories at multiple depths", function()
+      local root = make_tree({
+        [".gitignore"] = { "**/bin" },
+        ["bin/top.txt"] = { "ignored" },
+        ["one/two/bin/deep.txt"] = { "ignored" },
+        ["visible.txt"] = { "visible" },
+      }, { "bin", "one/two/bin" })
+
+      local entries = scan.scan_dir(root, { respect_gitignore = true, add_dirs = true })
+      remove_tree(root)
+
+      eq(false, contains(entries, root .. "/bin"))
+      eq(false, contains(entries, root .. "/bin/top.txt"))
+      eq(false, contains(entries, root .. "/one/two/bin"))
+      eq(false, contains(entries, root .. "/one/two/bin/deep.txt"))
+      eq(true, contains(entries, root .. "/visible.txt"))
+    end)
+
+    it("re-includes a path matched by !bin/asdf after its bin directory is ignored", function()
+      local root = make_tree({
+        ["first/.gitignore"] = { "**/bin", "!bin/asdf" },
+        ["first/bin/asdf"] = { "included" },
+        ["second/.gitignore"] = { "**/bin", "!bin/asdf" },
+        ["second/bin/asdf"] = { "included" },
+      }, { "first/bin", "second/bin" })
+
+      local entries = scan.scan_dir({ root .. "/first", root .. "/second" }, { respect_gitignore = true })
+      remove_tree(root)
+
+      eq(true, contains(entries, root .. "/first/bin/asdf"))
+      eq(true, contains(entries, root .. "/second/bin/asdf"))
+    end)
   end)
 
