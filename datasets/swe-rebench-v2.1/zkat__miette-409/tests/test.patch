+
+#[test]
+fn option_context_some_is_ok() {
+    let value: Option<u32> = Some(7);
+    let got = value.context("missing value").unwrap();
+    assert_eq!(got, 7);
+}
+
+#[test]
+fn option_context_none_is_error_with_supplied_message() {
+    let value: Option<u32> = None;
+    let err = value.context("key was missing").unwrap_err();
+    assert_eq!(err.to_string(), "key was missing");
+}
+
+#[test]
+fn option_with_context_some_does_not_build_context() {
+    let called = Cell::new(false);
+    let got = Some(1u8)
+        .with_context(|| {
+            called.set(true);
+            "unused context"
+        })
+        .unwrap();
+    assert_eq!(got, 1);
+    assert!(!called.get());
+}
+
+#[test]
+fn option_with_context_none_uses_closure_message() {
+    let err = None::<u8>
+        .with_context(|| format!("missing {}", "key"))
+        .unwrap_err();
+    assert_eq!(err.to_string(), "missing key");
+}
