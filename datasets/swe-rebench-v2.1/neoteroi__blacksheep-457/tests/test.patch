+@pytest.mark.asyncio
+async def test_websocket_handler_must_not_return():
+    """
+    A WebSocket handler's result must not cause the ASGI callable to return an
+    HTTP response. The ASGI protocol does not allow returning a response for a
+    WebSocket handshake request, so the application must always return None,
+    regardless of what the route handler returns.
+    """
+    app = FakeApplication()
+    mock_send = MockSend()
+    mock_receive = MockReceive([{"type": "websocket.connect"}])
+
+    called = False
+
+    @app.router.ws("/ws")
+    async def websocket_handler(my_ws: WebSocket):
+        nonlocal called
+        called = True
+        await my_ws.accept()
+
+    await app.start()
+    result = await app(
+        {"type": "websocket", "path": "/ws", "query_string": "", "headers": []},
+        mock_receive,
+        mock_send,
+    )
+
+    assert called is True
+    # The ASGI callable must not return an HTTP response for a WebSocket request.
+    assert result is None
+
+
+@pytest.mark.asyncio
+async def test_websocket_handler_non_none_result_is_ignored():
+    """
+    Any result returned by a WebSocket handler must be ignored: even when the
+    handler returns a non-None value, the ASGI callable must return None.
+    """
+    app = FakeApplication()
+    mock_send = MockSend()
+    mock_receive = MockReceive([{"type": "websocket.connect"}])
+
+    @app.router.ws("/ws")
+    async def websocket_handler(my_ws: WebSocket):
+        await my_ws.accept()
+        return "this result must be ignored"
+
+    await app.start()
+    result = await app(
+        {"type": "websocket", "path": "/ws", "query_string": "", "headers": []},
+        mock_receive,
+        mock_send,
+    )
+
+    assert result is None
+
+
