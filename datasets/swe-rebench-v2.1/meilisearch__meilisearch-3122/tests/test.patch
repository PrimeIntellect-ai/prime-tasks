+#[actix_web::test]
+async fn test_dump_creation_details_before_completion_are_null() {
+    let server = Server::new().await;
+    let (task, _) = server.create_dump().await;
+    let (observed_task, _) = server.get_task(task["taskUid"].as_u64().unwrap()).await;
+    match observed_task["status"].as_str() {
+        Some("succeeded") => assert!(observed_task["details"]["dumpUid"].is_string()),
+        Some("enqueued" | "processing" | "failed" | "canceled") => {
+            assert_eq!(observed_task["details"].get("dumpUid"), Some(&json!(null)));
+        }
+        status => panic!("unexpected dump task status: {status:?}"),
+    }
+}
