+    def test_controlled_gate_open_controls(self):
+        """Test that repeated QPY round trips keep an open-control gate name stable."""
+        qc = QuantumCircuit(3)
+        controlled_gate = DCXGate().control(1, ctrl_state=0)
+        qc.append(controlled_gate, [0, 1, 2])
+        expected_name = controlled_gate.name
+
+        qpy_file = io.BytesIO()
+        dump(qc, qpy_file)
+        qpy_file.seek(0)
+        new_circuit = load(qpy_file)[0]
+        self.assertEqual(expected_name, new_circuit.data[0][0].name)
+
+        qpy_file = io.BytesIO()
+        dump(new_circuit, qpy_file)
+        qpy_file.seek(0)
+        new_circuit = load(qpy_file)[0]
+        self.assertEqual(expected_name, new_circuit.data[0][0].name)
+
