+
+    def test_abbr_with_attr_list(self):
+        class ImageParser(HTMLParser):
+            def __init__(self):
+                super().__init__()
+                self.images = []
+                self.text = []
+
+            def handle_starttag(self, tag, attrs):
+                if tag == 'img':
+                    self.images.append(dict(attrs))
+
+            def handle_data(self, data):
+                self.text.append(data)
+
+        source = self.dedent(
+            """
+            *[abbr]: Abbreviation Definition
+
+            ![Image with abbr in title](abbr.png){title="Image with abbr in title"}
+            """
+        )
+        output = Markdown(extensions=['abbr', 'attr_list']).convert(source)
+        parser = ImageParser()
+        parser.feed(output)
+
+        self.assertEqual(len(parser.images), 1)
+        image = parser.images[0]
+        self.assertEqual(image.get('alt'), 'Image with abbr in title')
+        self.assertEqual(image.get('src'), 'abbr.png')
+        self.assertEqual(image.get('title'), 'Image with abbr in title')
+        self.assertEqual(''.join(parser.text).strip(), '')
