--- a/internal/confgen/prop/prop_test.go
+++ b/internal/confgen/prop/prop_test.go
@@ -4,8 +4,27 @@ import (
 	"testing"
 
 	"github.com/tableauio/tableau/proto/tableaupb"
+	"google.golang.org/protobuf/reflect/protoreflect"
 )
 
+func TestFieldPropUniqueFalsePresence(t *testing.T) {
+	fieldProp := &tableaupb.FieldProp{}
+	unique := fieldProp.ProtoReflect().Descriptor().Fields().ByName("unique")
+	if fieldProp.ProtoReflect().Has(unique) {
+		t.Fatal("unique must be absent before a value is supplied")
+	}
+	fieldProp.ProtoReflect().Set(unique, protoreflect.ValueOfBool(false))
+	if !fieldProp.ProtoReflect().Has(unique) {
+		t.Fatal("explicit false must retain presence")
+	}
+}
+
+func setUnique(fieldProp *tableaupb.FieldProp, value bool) *tableaupb.FieldProp {
+	field := fieldProp.ProtoReflect().Descriptor().Fields().ByName("unique")
+	fieldProp.ProtoReflect().Set(field, protoreflect.ValueOfBool(value))
+	return fieldProp
+}
