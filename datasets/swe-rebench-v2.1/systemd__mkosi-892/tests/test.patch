+def test_nspawn_keep_unit(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """mkosi must be able to run inside a container by keeping the current unit scope."""
+    fake_bin = tmp_path / "bin"
+    fake_bin.mkdir()
+    nspawn = fake_bin / "systemd-nspawn"
+    nspawn.write_text('#!/bin/sh\nprintf \"%s\\n\" \"$@\" > \"$NSPAWN_ARGS_LOG\"\n')
+    nspawn.chmod(0o755)
+    monkeypatch.setenv("PATH", f"{fake_bin}:{os.environ['PATH']}")
+    args_log = tmp_path / "nspawn-args"
+    monkeypatch.setenv("NSPAWN_ARGS_LOG", str(args_log))
+
+    root = tmp_path / "root"
+    root.mkdir()
+
+    with change_cwd(tmp_path):
+        args = mkosi.load_args(mkosi.parse_args(["--nspawn-keep-unit", "build"])["default"])
+        run_workspace_command(args, root, ["true"])
+        assert "--keep-unit" in args_log.read_text().splitlines()
+
+        args = mkosi.load_args(mkosi.parse_args(["build"])["default"])
+        run_workspace_command(args, root, ["true"])
+        assert "--keep-unit" not in args_log.read_text().splitlines()
