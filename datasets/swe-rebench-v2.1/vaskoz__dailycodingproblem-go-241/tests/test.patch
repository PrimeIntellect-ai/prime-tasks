+package day112
+
+import "testing"
+
+func TestLowestCommonAncestor(t *testing.T) {
+	t.Parallel()
+
+	root := &Node{}
+	lca := &Node{Parent: root}
+	n1 := &Node{Parent: lca}
+	n2 := &Node{Parent: &Node{Parent: &Node{Parent: lca}}}
+
+	if result := LowestCommonAncestor(n1, n2); result != lca {
+		t.Errorf("LCA did not match correctly")
+	}
+}
+
+func TestLowestCommonAncestorIncludesQueriedNodes(t *testing.T) {
+	t.Parallel()
+
+	root := &Node{}
+	ancestor := &Node{Parent: root}
+	descendant := &Node{Parent: ancestor}
+
+	if result := LowestCommonAncestor(ancestor, descendant); result != ancestor {
+		t.Errorf("LCA of an ancestor and its descendant = %p, want %p", result, ancestor)
+	}
+	if result := LowestCommonAncestor(descendant, ancestor); result != ancestor {
+		t.Errorf("LCA of a descendant and its ancestor = %p, want %p", result, ancestor)
+	}
+	if result := LowestCommonAncestor(descendant, descendant); result != descendant {
+		t.Errorf("LCA of a node with itself = %p, want %p", result, descendant)
+	}
+}
+
+func BenchmarkLowestCommonAncestor(b *testing.B) {
+	root := &Node{}
+	lca := &Node{Parent: &Node{Parent: root}}
+	n1 := &Node{Parent: lca}
+	n2 := &Node{Parent: &Node{Parent: &Node{Parent: lca}}}
+	for i := 0; i < b.N; i++ {
+		LowestCommonAncestor(n1, n2)
+	}
+}
+
+func TestLowestCommonAncestorCanBeRoot(t *testing.T) {
+	t.Parallel()
+
+	root := &Node{}
+	left := &Node{Parent: root}
+	right := &Node{Parent: root}
+
+	if result := LowestCommonAncestor(left, right); result != root {
+		t.Errorf("LCA of nodes in separate root branches = %p, want root %p", result, root)
+	}
+}
