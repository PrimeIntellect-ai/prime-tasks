 class ClientConfigurationTest {
+  @Test
+  fun testDisallowedTermsBlockPasswordProtectedMessages() {
+    val clientConfiguration = ClientConfiguration(
+      disallowPasswordMessagesForTerms = listOf("test-feature"),
+      disallowPasswordMessagesErrorText = "Password-protected messages are disabled"
+    )
+
+    assertTrue(clientConfiguration.hasRestrictionForPasswordProtectedMessages())
+
+    val regex = requireNotNull(clientConfiguration.getDisallowPasswordMessagesForTermsRegex())
+    assertNotNull(regex.find("test-feature"))
+    assertNotNull(regex.find("Please review test-feature now"))
+    assertNull(regex.find("testfeature"))
+  }
+
+  @Test
+  fun testNoRestrictionWhenTermsOrErrorTextMissing() {
+    assertFalse(
+      ClientConfiguration(
+        disallowPasswordMessagesForTerms = listOf("test-feature"),
+        disallowPasswordMessagesErrorText = null
+      ).hasRestrictionForPasswordProtectedMessages()
+    )
+    assertFalse(
+      ClientConfiguration(
+        disallowPasswordMessagesForTerms = null,
+        disallowPasswordMessagesErrorText = "Password-protected messages are disabled"
+      ).hasRestrictionForPasswordProtectedMessages()
+    )
+  }
