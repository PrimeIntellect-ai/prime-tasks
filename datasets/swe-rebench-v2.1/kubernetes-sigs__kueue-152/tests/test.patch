+// SetOptionalField sets a struct field that may be represented either as a
+// value or as a pointer, so that tests can be written independently of that
+// representation.
+func SetOptionalField(obj interface{}, name string, v interface{}) {
+	rv := reflect.ValueOf(obj).Elem().FieldByName(name)
+	if rv.Kind() == reflect.Ptr {
+		p := reflect.New(rv.Type().Elem())
+		p.Elem().Set(reflect.ValueOf(v))
+		rv.Set(p)
+	} else {
