+func quota(guaranteed resource.Quantity, ceiling *resource.Quantity) kueue.Quota {
+	q := kueue.Quota{Guaranteed: guaranteed}
+	if ceiling != nil {
+		utiltesting.SetOptionalField(&q, "Ceiling", *ceiling)
+	}
+	return q
+}
+
+func flavorLimits(name string, guaranteed int64, ceiling *int64) FlavorLimits {
+	fl := FlavorLimits{Name: name, Guaranteed: guaranteed}
+	if ceiling != nil {
+		utiltesting.SetOptionalField(&fl, "Ceiling", *ceiling)
+	}
+	return fl
+}
+
+func TestQuotaCeilingIsOptionalPointer(t *testing.T) {
+	field, found := reflect.TypeOf(kueue.Quota{}).FieldByName("Ceiling")
+	if !found {
+		t.Fatal("Quota must expose a Ceiling field")
+	}
+	if want := reflect.TypeOf((*resource.Quantity)(nil)); field.Type != want {
+		t.Fatalf("Quota.Ceiling has type %v, want %v", field.Type, want)
+	}
+}
