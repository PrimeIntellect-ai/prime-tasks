+func TestUserDataStageConfigShape(t *testing.T) {
+	var (
+		g = gomega.NewGomegaWithT(t)
+	)
+
+	configYAML := `
+userData:
+  - name: my-stage
+    stage: PreBootstrap
+    data: |
+      echo hello
+  - name: my-post-stage
+    stage: PostBootstrap
+    data: |
+      echo bye
+`
+
+	configuration := &v1alpha1.EKSConfiguration{}
+	err := yaml.Unmarshal([]byte(configYAML), configuration)
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+
+	userData := configuration.GetUserData()
+	g.Expect(userData).To(gomega.HaveLen(2))
+	nameField, hasNameField := reflect.TypeOf(v1alpha1.UserDataStage{}).FieldByName("Name")
+	g.Expect(hasNameField).To(gomega.BeTrue())
+	if hasNameField {
+		g.Expect(nameField.Type).To(gomega.Equal(reflect.TypeOf("")))
+		g.Expect(reflect.ValueOf(userData[0]).FieldByIndex(nameField.Index).String()).To(gomega.Equal("my-stage"))
+		g.Expect(reflect.ValueOf(userData[1]).FieldByIndex(nameField.Index).String()).To(gomega.Equal("my-post-stage"))
+	}
+	g.Expect(userData[0].Stage).To(gomega.Equal(v1alpha1.PreBootstrapStage))
+	g.Expect(userData[0].Data).To(gomega.ContainSubstring("echo hello"))
+	g.Expect(userData[1].Stage).To(gomega.Equal(v1alpha1.PostBootstrapStage))
+	g.Expect(userData[1].Data).To(gomega.ContainSubstring("echo bye"))
+
+	serialized, err := yaml.Marshal(configuration)
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+	roundTripped := &v1alpha1.EKSConfiguration{}
+	err = yaml.Unmarshal(serialized, roundTripped)
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+	g.Expect(roundTripped.GetUserData()).To(gomega.Equal(userData))
+}
