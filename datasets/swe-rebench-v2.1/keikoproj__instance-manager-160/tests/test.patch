+func TestRenderMultipleUserDataScripts(t *testing.T) {
+	var (
+		g             = gomega.NewGomegaWithT(t)
+		k             = MockKubernetesClientSet()
+		ig            = MockInstanceGroup()
+		configuration = ig.GetEKSConfiguration()
+		asgMock       = NewAutoScalingMocker()
+		iamMock       = NewIamMocker()
+		eksMock       = NewEksMocker()
+	)
+
+	w := MockAwsWorker(asgMock, iamMock, eksMock)
+	ctx := MockContext(ig, k, w)
+
+	ctx.SetDiscoveredState(&DiscoveredState{
+		Publisher: kubeprovider.EventPublisher{
+			Client: k.Kubernetes,
+		},
+		Cluster: &eks.Cluster{
+			Version: aws.String("1.15"),
+		},
+	})
+
+	configuration.UserData = []v1alpha1.UserDataStage{
+		{Stage: v1alpha1.PreBootstrapStage, Data: "echo pre-one"},
+		{Stage: v1alpha1.PostBootstrapStage, Data: "echo post-one"},
+		{Stage: v1alpha1.PreBootstrapStage, Data: "echo pre-two"},
+		{Stage: v1alpha1.PostBootstrapStage, Data: "echo post-two"},
+	}
+
+	input := ctx.GetLaunchConfigurationInput("some-launch-config")
+	decoded, err := base64.StdEncoding.DecodeString(aws.StringValue(input.UserData))
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+
+	rendered := string(decoded)
+	g.Expect(rendered).To(gomega.ContainSubstring("echo pre-one"))
+	g.Expect(rendered).To(gomega.ContainSubstring("echo pre-two"))
+	g.Expect(rendered).To(gomega.ContainSubstring("echo post-one"))
+	g.Expect(rendered).To(gomega.ContainSubstring("echo post-two"))
+
+	preOne := strings.Index(rendered, "echo pre-one")
+	preTwo := strings.Index(rendered, "echo pre-two")
+	bootstrap := strings.Index(rendered, "/etc/eks/bootstrap.sh")
+	postOne := strings.Index(rendered, "echo post-one")
+	postTwo := strings.Index(rendered, "echo post-two")
+	g.Expect(preOne).To(gomega.BeNumerically(">=", 0))
+	g.Expect(preTwo).To(gomega.BeNumerically(">", preOne))
+	g.Expect(bootstrap).To(gomega.BeNumerically(">", preTwo))
+	g.Expect(postOne).To(gomega.BeNumerically(">", bootstrap))
+	g.Expect(postTwo).To(gomega.BeNumerically(">", postOne))
 }
 
