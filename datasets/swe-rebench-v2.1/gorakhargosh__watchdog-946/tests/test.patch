+def test_auto_restart_cli_no_restart_on_exit_still_restarts_on_change(tmpdir):
+    """The CLI opt-out suppresses exit restarts without disabling event restarts."""
+    import os
+    import subprocess
+    import sys
+    import time
+
+    watched_dir = os.path.join(tmpdir, 'watched')
+    os.mkdir(watched_dir)
+    watched_file = os.path.join(watched_dir, 'input.txt')
+    with open(watched_file, 'w') as output:
+        output.write('initial')
+    run_log = os.path.join(tmpdir, 'runs.txt')
+    command_script = os.path.join(tmpdir, 'command.py')
+    with open(command_script, 'w') as script:
+        script.write(
+            'import sys\n'
+            'with open(sys.argv[1], "a") as output:\n'
+            '    output.write("run\\n")\n'
+        )
+    process = subprocess.Popen([
+        sys.executable, '-m', 'watchdog.watchmedo', 'auto-restart',
+        '--debug-force-polling', '--interval', '0.1',
+        '--no-restart-on-command-exit', '-d', str(watched_dir),
+        sys.executable, str(command_script), str(run_log),
+    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+    def run_count():
+        try:
+            with open(run_log) as output:
+                return len(output.read().splitlines())
+        except IOError:
+            return 0
+
+    try:
+        deadline = time.monotonic() + 8
+        while run_count() < 1 and time.monotonic() < deadline:
+            time.sleep(0.05)
+        assert run_count() == 1
+        time.sleep(0.4)
+        assert run_count() == 1
+
+        with open(watched_file, 'w') as output:
+            output.write('changed')
+        deadline = time.monotonic() + 8
+        while run_count() < 2 and time.monotonic() < deadline:
+            time.sleep(0.05)
+        assert run_count() >= 2
+    finally:
+        process.terminate()
+        try:
+            process.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+
+
+
+def test_auto_restart_cli_restarts_on_exit_by_default(tmpdir):
+    """Without the opt-out flag, the CLI restarts a command that exits."""
+    import os
+    import subprocess
+    import sys
+    import time
+
+    watched_dir = os.path.join(tmpdir, 'watched')
+    os.mkdir(watched_dir)
+    run_log = os.path.join(tmpdir, 'runs.txt')
+    command_script = os.path.join(tmpdir, 'command.py')
+    with open(command_script, 'w') as script:
+        script.write(
+            'import sys\n'
+            'with open(sys.argv[1], "a") as output:\n'
+            '    output.write("run\\n")\n'
+        )
+    process = subprocess.Popen([
+        sys.executable, '-m', 'watchdog.watchmedo', 'auto-restart',
+        '--debug-force-polling', '--interval', '0.1', '-d', watched_dir,
+        sys.executable, command_script, run_log,
+    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+    def run_count():
+        try:
+            with open(run_log) as output:
+                return len(output.read().splitlines())
+        except IOError:
+            return 0
+
+    try:
+        deadline = time.monotonic() + 8
