+    def test_generic_uniontype_parameters(self):
+        # ``types.UnionType`` (the class) exposes ``__parameters__`` as a
+        # non-iterable descriptor; parsing a generic parameterized with it
+        # must not raise.
+        UnionType = getattr(types, "UnionType", None)
+        if UnionType is None:
+            pytest.skip("types.UnionType requires Python 3.10+")
+
+        class Sub(Base[UnionType]):
+            pass
+
+        assert get_class_annotations(Sub) == {"x": UnionType}
