+func TestTreeMode(t *testing.T) {
+	newInfo := func() *nfpm.Info {
+		return nfpm.WithDefaults(&nfpm.Info{
+			Name:        "tree-mode",
+			Version:     "1.0.0",
+			Maintainer:  "Test User <test@example.com>",
+			Description: "Tree mode test",
+			Overridables: nfpm.Overridables{
+				Contents: files.Contents{
+					{
+						Source:      filepath.Join("testdata", "tree"),
+						Destination: "/usr/share/foo",
+						Type:        files.TypeTree,
+						FileInfo:    &files.ContentFileInfo{Mode: 0o777},
+					},
+				},
+			},
+		})
+	}
+
+	assertDescendantModes := func(t *testing.T, entries map[string]os.FileMode) {
+		t.Helper()
+		checkedFiles, checkedDirs := 0, 0
+		for name, mode := range entries {
+			name = path.Clean("/" + strings.TrimPrefix(name, "/"))
+			if !strings.HasPrefix(name, "/usr/share/foo/") || name == "/usr/share/foo/" || mode&os.ModeSymlink != 0 {
+				continue
+			}
+			require.Equal(t, os.FileMode(0o777), mode.Perm(), "%s", name)
+			if mode.IsDir() {
+				checkedDirs++
+			} else {
+				checkedFiles++
+			}
+		}
+		require.NotZero(t, checkedFiles, "tree files should be present in the package")
+		require.NotZero(t, checkedDirs, "tree subdirectories should be present in the package")
+	}
+
+	t.Run("rpm", func(t *testing.T) {
+		var packageData bytes.Buffer
+		require.NoError(t, rpm.Default.Package(newInfo(), &packageData))
+		archive, err := rpmutils.ReadRpm(bytes.NewReader(packageData.Bytes()))
+		require.NoError(t, err)
+		payload, err := archive.PayloadReader()
+		require.NoError(t, err)
+
+		entries := make(map[string]os.FileMode)
+		for {
+			header, err := payload.Next()
+			if err == io.EOF {
+				break
+			}
+			require.NoError(t, err)
+			mode := os.FileMode(header.Mode() & 0o777)
+			switch header.Mode() & 0o170000 {
+			case 0o040000:
+				mode |= os.ModeDir
+			case 0o120000:
+				mode |= os.ModeSymlink
+			}
+			entries[header.Filename()] = mode
+		}
+		assertDescendantModes(t, entries)
+	})
+
+	t.Run("deb", func(t *testing.T) {
+		info := newInfo()
+		info.Deb.Compression = "none"
+		var packageData bytes.Buffer
+		require.NoError(t, deb.Default.Package(info, &packageData))
+
+		archive := ar.NewReader(bytes.NewReader(packageData.Bytes()))
+		entries := make(map[string]os.FileMode)
+		for {
+			header, err := archive.Next()
+			if err == io.EOF {
+				break
+			}
+			require.NoError(t, err)
+			if header.Name != "data.tar" {
+				continue
+			}
+			tarball := tar.NewReader(archive)
+			for {
+				file, err := tarball.Next()
+				if err == io.EOF {
+					break
+				}
+				require.NoError(t, err)
+				mode := os.FileMode(file.Mode)
+				if file.Typeflag == tar.TypeDir {
+					mode |= os.ModeDir
+				} else if file.Typeflag == tar.TypeSymlink {
+					mode |= os.ModeSymlink
+				}
+				entries[file.Name] = mode
+			}
+			break
+		}
+		assertDescendantModes(t, entries)
+	})
+}
