+func TestClient_StringMetadataMethodsTrimWhitespace(t *testing.T) {
+	tests := []struct {
+		name string
+		path string
+		want string
+		call func(*Client) (string, error)
+	}{
+		{name: "hostname", path: "/hostname", want: "my-server", call: (*Client).Hostname},
+		{name: "region", path: "/region", want: "eu-central", call: (*Client).Region},
+		{name: "availability zone", path: "/availability-zone", want: "fsn1-dc14", call: (*Client).AvailabilityZone},
+		{name: "private networks", path: "/private-networks", want: "network: 10.0.0.0/8", call: (*Client).PrivateNetworks},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			env := newTestEnv()
+			env.Mux.HandleFunc(test.path, func(w http.ResponseWriter, r *http.Request) {
+				w.Write([]byte(test.want + "  \n"))
+			})
+
+			got, err := test.call(env.Client)
+			if err != nil {
+				t.Fatal(err)
+			}
+			assert.Equal(t, test.want, got)
+		})
+	}
+}
