+func TestBlockScalarTreatsYAMLLikeContentAsString(t *testing.T) {
+	source := "a:\n  b: |\n    {\n      [ 1, 2 ]\n    }\n  c: d\n"
+	f, err := parser.ParseBytes([]byte(source), 0)
+	if err != nil {
+		t.Fatalf("failed to parse block scalar: %v", err)
+	}
+	if len(f.Docs) != 1 {
+		t.Fatalf("expected one document, got %d", len(f.Docs))
+	}
+	root, ok := f.Docs[0].Body.(*ast.MappingValueNode)
+	if !ok || root.Key.String() != "a" {
+		t.Fatalf("expected top-level entry a, got %T", f.Docs[0].Body)
+	}
+	a, ok := root.Value.(*ast.MappingNode)
+	if !ok || len(a.Values) != 2 {
+		t.Fatalf("expected both entries under a, got %T", root.Value)
+	}
+	b := a.Values[0]
+	if b.Key.String() != "b" {
+		t.Fatalf("expected first key b, got %q", b.Key.String())
+	}
+	var scalarValue interface{}
+	switch scalar := b.Value.(type) {
+	case *ast.LiteralNode:
+		scalarValue = scalar.GetValue()
+	case *ast.StringNode:
+		scalarValue = scalar.GetValue()
+	default:
+		t.Fatalf("expected b to be a string scalar, got %T", b.Value)
+	}
+	value, ok := scalarValue.(string)
+	if !ok || !strings.Contains(value, "[ 1, 2 ]") || !strings.Contains(value, "{") || !strings.Contains(value, "}") {
+		t.Fatalf("expected YAML-looking content to remain scalar text, got %#v", scalarValue)
+	}
+	c := a.Values[1]
+	if c.Key.String() != "c" || c.Value.String() != "d" {
+		t.Fatalf("expected following entry c: d, got %s: %s", c.Key.String(), c.Value.String())
+	}
+}
