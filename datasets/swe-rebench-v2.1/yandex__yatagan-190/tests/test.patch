+
+            class TestClass @Inject constructor()
+
+            interface Deps1 {
+                val testClass: TestClass
+            }
+
+            interface Deps2 {
+                val testClass: TestClass
+            }
+
+            @Component
+            interface RootComponent : Deps1, Deps2
+
+            fun test() {
+                check(Yatagan.create(RootComponent::class.java).testClass is TestClass)
+            }
+        """.trimIndent())
+
         compileRunAndValidate()
     }
