+def _resolve_nodes(y, spec_nodes):
+    """Resolve node identifiers in a forecasters spec to nodes of y."""
+    zindex = y.index.droplevel(-1).unique()
+    resolved = []
+    for node in spec_nodes:
+        for ind in zindex:
+            if isinstance(node, tuple):
+                if ind[: len(node)] == node:
+                    resolved.append(ind)
+            elif ind == node or (isinstance(ind, tuple) and ind[0] == node):
+                resolved.append(ind)
+    return resolved
+
+
+def _nodes_at_level(y, level):
+    """Return the nodes of y at aggregation level `level`."""
+    nodes = y.index.droplevel(-1).unique()
+    return [
+        n
+        for n in nodes
+        if all(v != "__total" for v in n[:level])
+        and all(v == "__total" for v in n[level:])
+    ]
+
