+@pytest.mark.parametrize("default", [NaiveForecaster(), None])
+def test_level_one_data(forecasters, default):
+    "Check for data with one level of hierarchy (excluding timepoints level)."
+    agg = Aggregator()
+
+    y = _bottom_hier_datagen(
+        no_bottom_nodes=3,
+        no_levels=1,
+        random_seed=123,
+    )
+
+    forecaster = HierarchyEnsembleForecaster(forecasters, by="node", default=default)
+
+    forecaster.fit(y, fh=[1, 2, 3])
+    actual_pred = forecaster.predict()
+
+    y = agg.fit_transform(y)
+
+    # each node/timepoint of the hierarchy must be predicted exactly once, i.e.
+    # the default forecaster must not add predictions for nodes that are already
+    # covered by a node-specific forecaster
+    assert actual_pred.index.is_unique, (
+        "Each node/timepoint must be predicted exactly once, but found "
+        "duplicated predictions."
+    )
+
+    covered = []
+    for i in range(len(forecasters)):
+        test_frcstr = forecasters[i][1].clone()
+        nodes_i = _resolve_nodes(y, forecasters[i][2])
+        covered += nodes_i
+        df = y[y.index.droplevel(-1).isin(nodes_i)]
+        test_frcstr.fit(df, fh=[1, 2, 3])
+        test_pred = test_frcstr.predict()
+        msg = "Node predictions do not match"
+        assert np.all(actual_pred.loc[test_pred.index] == test_pred), msg
+
+    _, _, nodes = zip(*forecasters)
+    nodes = set(flatten(nodes))
+    if default is not None and len(nodes) != len(y.index.droplevel(-1).unique()):
+        def_frcstr = default
+        uncovered = y.index.droplevel(-1).unique().difference(covered)
+        df = y[y.index.droplevel(-1).isin(uncovered)]
+        def_frcstr.fit(df, fh=[1, 2, 3])
+        def_pred = def_frcstr.predict()
+        msg = "Node default predictions do not match"
+        assert np.all(actual_pred.loc[def_pred.index] == def_pred), msg
+
+
+def test_level_one_default_predicts_unassigned_nodes():
+    """The configured default forecasts nodes not assigned explicitly."""
+    agg = Aggregator()
+    y = _bottom_hier_datagen(
+        no_bottom_nodes=3,
+        no_levels=1,
+        random_seed=123,
+    )
+    forecasters = [("trend", TrendForecaster(), ["__total"])]
+    default = NaiveForecaster()
+    forecaster = HierarchyEnsembleForecaster(
+        forecasters, by="node", default=default
+    )
+
+    forecaster.fit(y, fh=[1, 2, 3])
+    actual_pred = forecaster.predict()
+    y = agg.fit_transform(y)
+
+    assigned_nodes = _resolve_nodes(y, forecasters[0][2])
+    all_nodes = y.index.droplevel(-1).unique()
+    unassigned_nodes = all_nodes.difference(assigned_nodes)
+    default_y = y[y.index.droplevel(-1).isin(unassigned_nodes)]
+    default_forecaster = default.clone().fit(default_y, fh=[1, 2, 3])
+    expected_default_pred = default_forecaster.predict()
+
+    assert len(unassigned_nodes) > 0
+    assert expected_default_pred.index.isin(actual_pred.index).all()
+    np.testing.assert_array_equal(
+        actual_pred.loc[expected_default_pred.index], expected_default_pred
+    )
