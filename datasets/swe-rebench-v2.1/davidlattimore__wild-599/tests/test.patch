diff --git a/wild/tests/sources/gnu-unique.c b/wild/tests/sources/gnu-unique.c
new file mode 100644
index 0000000..573f43b
--- /dev/null
+++ b/wild/tests/sources/gnu-unique.c
@@ -0,0 +1,19 @@
+//#Object:exit.c
+//#Object:gnu-unique-1.cc
+//#Object:gnu-unique-2.cc
+
+#include "exit.h"
+
+typedef int(*get_int_fn_t)(int);
+
+// Each function instantiates the template in a separate object file, requiring resolution of its
+// STB_GNU_UNIQUE symbol when the objects are linked together.
+get_int_fn_t get_fn1(void);
+get_int_fn_t get_fn2(void);
+
+void _start(void) {
+    (void)get_fn1()(10);
+    (void)get_fn2()(15);
+
+    exit_syscall(42);
+}
diff --git a/wild/tests/sources/gnu-unique.h b/wild/tests/sources/gnu-unique.h
new file mode 100644
index 0000000..dcbaffb
--- /dev/null
+++ b/wild/tests/sources/gnu-unique.h
@@ -0,0 +1,7 @@
+template<typename T>
+T get_value(T v) {
+    // This static variable inside a template is what causes GCC to emit a symbol as UNIQUE.
+    static T def = 0;
+    def++;
+    return v + def;
+}
