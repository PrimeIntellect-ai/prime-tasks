+def _run_without_pin_factory(code):
+    # Run *code* in a fresh interpreter with no pin factory configured, so that
+    # the behaviour of gpiozero when no factory can be found can be observed
+    # independently of the mock factory installed for the rest of the suite.
+    env = dict(os.environ)
+    env.pop('GPIOZERO_PIN_FACTORY', None)
+    return subprocess.run(
+        [sys.executable, '-c', code],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
+
+
+def test_import_without_pin_factory():
+    # Importing gpiozero must succeed even when no pin factory can be found,
+    # and the factory must be left unset (None) until a device is constructed.
+    result = _run_without_pin_factory(
+        'import gpiozero\n'
+        'assert gpiozero.Device.pin_factory is None, '
+        'repr(gpiozero.Device.pin_factory)\n')
+    assert result.returncode == 0, result.stderr.decode('utf-8', 'replace')
+
+
+def test_device_creation_without_pin_factory_fails():
+    # With no pin factory available, constructing a device must fail rather
+    # than silently succeeding.
+    result = _run_without_pin_factory(
+        'import gpiozero\n'
+        'from gpiozero import LED\n'
+        'try:\n'
+        '    LED(2)\n'
+        'except Exception:\n'
+        '    pass\n'
+        'else:\n'
+        '    raise AssertionError("device creation unexpectedly succeeded")\n')
+    assert result.returncode == 0, result.stderr.decode('utf-8', 'replace')
