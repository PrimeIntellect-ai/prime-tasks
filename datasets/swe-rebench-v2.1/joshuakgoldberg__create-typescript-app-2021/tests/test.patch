+
+	test("preserves project CSpell words in transition mode", async () => {
+		const directory = await mkdtemp(join(tmpdir(), "cspell-transition-"));
+		const retainedWord = "preservedtransitionword";
+		const cspellPath = join(directory, "cspell.json");
+		const fileSystem = {
+			readDirectory: async () => [],
+			readFile: async (filePath: string) =>
+				(await readFile(join(directory, filePath))).toString(),
+			writeDirectory: async (directoryPath: string) =>
+				mkdir(join(directory, directoryPath), { recursive: true }),
+			writeFile: async (filePath: string, contents: string) =>
+				writeFile(join(directory, filePath), contents),
+		};
+
+		try {
+			await writeFile(cspellPath, JSON.stringify({ words: [retainedWord] }));
+			const options = (await prepareOptions(base, {
+				files: { "cspell.json": JSON.stringify({ words: [retainedWord] }) },
+				fs: fileSystem as never,
+				offline: true,
+			})) as BaseOptions;
+			const preset = base.createPreset({
+				about: { name: "CSpell preservation" },
+				blocks: [blockCSpell],
+			});
+
+			await runPreset(preset, {
+				directory: ".",
+				mode: "transition",
+				offline: true,
+				options,
+				fs: fileSystem as never,
+				runner: async () => ({}) as never,
+			});
+
+			const result = JSON.parse((await readFile(cspellPath)).toString()) as {
+				words?: string[];
+			};
+			expect(result.words ?? []).toContain(retainedWord);
+		} finally {
+			await rm(directory, { force: true, recursive: true });
+		}
+	});
 });
