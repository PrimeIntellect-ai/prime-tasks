+def _vertex_request_body(non_default_params, optional_params, model, drop_params):
+    mapped_params = VertexGeminiConfig().map_openai_params(
+        non_default_params=non_default_params,
+        optional_params=optional_params,
+        model=model,
+        drop_params=drop_params,
+    )
+    return sync_transform_request_body(
+        gemini_api_key=None,
+        messages=non_default_params["messages"],
+        api_base=None,
+        model="gemini-2.5-flash",
+        client=None,
+        timeout=None,
+        extra_headers=None,
+        optional_params=mapped_params,
+        logging_obj=None,
+        custom_llm_provider="vertex_ai",
+        litellm_params={},
+    )
+
+
+def test_vertex_ai_response_schema_dict():
+    transformed_request = _vertex_request_body(
+        non_default_params={
+            "messages": [{"role": "user", "content": "Hello, world!"}],
+            "response_format": {
+                "type": "json_schema",
+                "json_schema": {
+                    "name": "math_reasoning",
+                    "schema": {
+                        "type": "object",
+                        "properties": {
+                            "steps": {
+                                "type": "array",
+                                "items": {
+                                    "type": "object",
+                                    "properties": {
+                                        "thought": {"type": "string"},
+                                        "output": {"type": "string"},
+                                    },
+                                    "required": ["thought", "output"],
+                                    "additionalProperties": False,
+                                },
+                            },
+                            "final_answer": {"type": "string"},
+                        },
+                        "required": ["steps", "final_answer"],
+                        "additionalProperties": False,
+                    },
+                    "strict": False,
+                },
+            },
+        },
+        optional_params={},
+        model="gemini-2.0-flash-lite",
+        drop_params=False,
+    )
+
+    schema = transformed_request["generationConfig"]["response_schema"]
+    # The outgoing Vertex request retains property order at each object level.
+    assert schema["propertyOrdering"] == ["steps", "final_answer"]
+    assert schema["properties"]["steps"]["items"]["propertyOrdering"] == [
+        "thought",
+        "output",
+    ]
+
+
+class MathReasoning(BaseModel):
+    steps: List["Step"]
+    final_answer: str
+
+
+class Step(BaseModel):
+    thought: str
+    output: str
+
+def test_vertex_ai_pydantic_schema_property_ordering():
+    schema = VertexGeminiConfig().get_json_schema_from_pydantic_object(MathReasoning)
+
+    transformed_request = _vertex_request_body(
+        non_default_params={
+            "messages": [{"role": "user", "content": "Hello, world!"}],
+            "response_format": schema,
+        },
+        optional_params={},
+        model="gemini-2.0-flash-lite",
+        drop_params=False,
+    )
+
+    schema = transformed_request["generationConfig"]["response_schema"]
+    assert schema["propertyOrdering"] == ["steps", "final_answer"]
+    assert schema["properties"]["steps"]["items"]["propertyOrdering"] == [
+        "thought",
+        "output",
+    ]
+
+
+def test_vertex_ai_retain_property_ordering():
+    transformed_request = _vertex_request_body(
+        non_default_params={
+            "messages": [{"role": "user", "content": "Hello, world!"}],
+            "response_format": {
+                "type": "json_schema",
+                "json_schema": {
+                    "name": "math_reasoning",
+                    "schema": {
+                        "type": "object",
+                        "properties": {
+                            "output": {"type": "string"},
+                            "thought": {"type": "string"},
+                        },
+                        "propertyOrdering": ["thought", "output"],
+                    },
+                },
+            },
+        },
+        optional_params={},
+        model="gemini-2.0-flash-lite",
+        drop_params=False,
+    )
+
+    schema = transformed_request["generationConfig"]["response_schema"]
+    # An explicit order is retained in the outgoing Vertex request.
+    assert schema["propertyOrdering"] == ["thought", "output"]
