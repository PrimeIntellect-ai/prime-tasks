+
+#[derive(Clone, Copy, Debug, Reflect, PartialEq, Eq, Hash)]
+enum MixedAction {
+    Button,
+    Axis,
+    DualAxis,
+}
+
+impl Actionlike for MixedAction {
+    fn input_control_kind(&self) -> InputControlKind {
+        match self {
+            MixedAction::Button => InputControlKind::Button,
+            MixedAction::Axis => InputControlKind::Axis,
+            MixedAction::DualAxis => InputControlKind::DualAxis,
+        }
+    }
+}
+
+#[test]
+fn disable_entire_action_state() {
+    let mut action_state = ActionState::<MixedAction>::default();
+
+    // The entire action state starts out enabled
+    assert!(!action_state.disabled());
+
+    action_state.press(&MixedAction::Button);
+    action_state.axis_data_mut_or_default(&MixedAction::Axis).value = 1.0;
+    action_state
+        .dual_axis_data_mut_or_default(&MixedAction::DualAxis)
+        .pair = Vec2::new(1.0, 2.0);
+
+    // Disabling the entire action state disables it and resets its values
+    action_state.disable();
+    assert!(action_state.disabled());
+    assert!(!action_state.pressed(&MixedAction::Button));
+    assert_eq!(
+        action_state.axis_data(&MixedAction::Axis).unwrap().value,
+        0.0
+    );
+    assert_eq!(
+        action_state
+            .dual_axis_data(&MixedAction::DualAxis)
+            .unwrap()
+            .pair,
+        Vec2::ZERO
+    );
+
+    // Re-enabling the entire action state clears the disabled status
+    action_state.enable();
+    assert!(!action_state.disabled());
+}
+
+#[test]
+fn disable_all_actions_resets_all_value_kinds() {
+    let mut action_state = ActionState::<MixedAction>::default();
+
+    action_state.press(&MixedAction::Button);
+    action_state.axis_data_mut_or_default(&MixedAction::Axis).value = 1.0;
+    action_state
+        .dual_axis_data_mut_or_default(&MixedAction::DualAxis)
+        .pair = Vec2::new(1.0, 2.0);
+
+    action_state.disable_all_actions();
+
+    assert!(!action_state.pressed(&MixedAction::Button));
+    assert_eq!(
+        action_state.axis_data(&MixedAction::Axis).unwrap().value,
+        0.0
+    );
+    assert_eq!(
+        action_state
+            .dual_axis_data(&MixedAction::DualAxis)
+            .unwrap()
+            .pair,
+        Vec2::ZERO
+    );
+}
+
+#[test]
+fn enabling_whole_state_preserves_individual_disabled_actions() {
+    let mut action_state = ActionState::<Action>::default();
+
+    // Register the action and disable it individually
+    action_state.press(&Action::PayRespects);
+    action_state.disable_all_actions();
+
+    // Disable the entire action state as well
+    action_state.disable();
+    assert!(action_state.disabled());
+
+    // Re-enabling the entire action state clears the global disabled status
+    action_state.enable();
+    assert!(!action_state.disabled());
+
+    // But the individual action remains disabled
+    action_state.press(&Action::PayRespects);
+    assert!(!action_state.pressed(&Action::PayRespects));
+}
+
+
+#[test]
+fn disabled_action_state_ignores_later_updates() {
+    use leafwing_input_manager::input_map::{UpdatedActions, UpdatedValue};
+
+    let mut action_state = ActionState::<MixedAction>::default();
+
+    action_state.press(&MixedAction::Button);
+    action_state.axis_data_mut_or_default(&MixedAction::Axis).value = 1.0;
+    action_state
+        .dual_axis_data_mut_or_default(&MixedAction::DualAxis)
+        .pair = Vec2::new(1.0, 2.0);
+
+    action_state.disable();
+
+    let mut updates = UpdatedActions::default();
+    updates.insert(MixedAction::Button, UpdatedValue::Button(true));
+    updates.insert(MixedAction::Axis, UpdatedValue::Axis(0.75));
+    updates.insert(
+        MixedAction::DualAxis,
+        UpdatedValue::DualAxis(Vec2::new(3.0, 4.0)),
+    );
+    action_state.update(updates);
+
+    assert!(action_state.disabled());
+    assert!(!action_state.pressed(&MixedAction::Button));
+    assert_eq!(
+        action_state.axis_data(&MixedAction::Axis).unwrap().value,
+        0.0
+    );
+    assert_eq!(
+        action_state
+            .dual_axis_data(&MixedAction::DualAxis)
+            .unwrap()
+            .pair,
+        Vec2::ZERO
+    );
+}
