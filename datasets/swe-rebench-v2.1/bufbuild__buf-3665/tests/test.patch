+// testRunStderrContainsAnyNonZeroExit runs the command, requires a nonzero exit code,
+// and requires stderr to contain each of the expected partials. The exact nonzero
+// exit code is intentionally not checked.
+func testRunStderrContainsAnyNonZeroExit(t *testing.T, stdin io.Reader, expectedStderrPartials []string, args ...string) {
+	t.Helper()
+	stdout := bytes.NewBuffer(nil)
+	stderr := bytes.NewBuffer(nil)
+	exitCode := app.GetExitCode(
+		appcmd.Run(
+			context.Background(),
+			app.NewContainer(
+				internaltesting.NewEnvFunc(t)("test"),
+				stdin,
+				stdout,
+				stderr,
+				append([]string{"test"}, append(args, "--no-warn")...)...,
+			),
+			NewRootCommand("test"),
+		),
+	)
+	require.NotEqual(t, 0, exitCode, "expected a nonzero exit code:\nstdout: %s\nstderr: %s", stdout.String(), stderr.String())
+	allStderr := stderr.String()
+	for _, expectedPartial := range expectedStderrPartials {
+		require.Contains(t, allStderr, expectedPartial, "stderr expected to contain %q:\nstderr: %s", expectedPartial, allStderr)
+	}
+}
