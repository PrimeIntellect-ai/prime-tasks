+					{
+						ID:     "owncloud",
+						Public: true,
+						RedirectURIs: []string{
+							"https://www.mywebsite.com",
+							"http://www.mywebsite.com",
+							"oc://ios.owncloud.com",
+						},
+					},
+				},
+			},
+		}
+
+		ValidateIdentityProviders(config, validator)
+
+		assert.Empty(t, validator.Errors())
+	})
+
