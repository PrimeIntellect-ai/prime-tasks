+func TestOIDCAuthorizationAcceptsOwnCloudIOSRedirectURI(t *testing.T) {
+	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	privateKeyPEM := pem.EncodeToMemory(&pem.Block{
+		Type:  "RSA PRIVATE KEY",
+		Bytes: x509.MarshalPKCS1PrivateKey(privateKey),
+	})
+
+	provider, err := oidc.NewOpenIDConnectProvider(&schema.OpenIDConnectConfiguration{
+		HMACSecret:       "a sufficiently long hmac secret for oidc",
+		IssuerPrivateKey: string(privateKeyPEM),
+		Clients: []schema.OpenIDConnectClientConfiguration{{
+			ID:            "owncloud-ios",
+			Public:        true,
+			RedirectURIs:  []string{"oc://ios.owncloud.com"},
+			GrantTypes:    []string{"authorization_code"},
+			ResponseTypes: []string{"code"},
+			Scopes:        []string{"openid"},
+		}},
+	})
+	require.NoError(t, err)
+
+	query := url.Values{
+		"client_id":     {"owncloud-ios"},
+		"redirect_uri":  {"oc://ios.owncloud.com"},
+		"response_type": {"code"},
+		"scope":         {"openid"},
+		"state":         {"state-value"},
+	}
+	request := httptest.NewRequest("GET", "/api/oidc/authorize?"+query.Encode(), nil)
+
+	authorizationRequest, err := provider.Fosite.NewAuthorizeRequest(context.Background(), request)
+	require.NoError(t, err)
+	require.NotNil(t, authorizationRequest.GetRedirectURI())
+	assert.Equal(t, "oc://ios.owncloud.com", authorizationRequest.GetRedirectURI().String())
+
+	session := &oidc.OpenIDSession{
+		DefaultSession: openid.NewDefaultSession(),
+		ClientID:       "owncloud-ios",
+	}
+	session.Subject = "user"
+	session.Username = "user"
+	session.Claims.Subject = "user"
+	session.Claims.Issuer = "https://authelia.example.com"
+	session.Claims.Audience = []string{"owncloud-ios"}
+	session.Headers.Extra = map[string]interface{}{"kid": provider.KeyManager.GetActiveKeyID()}
+
+	response, err := provider.Fosite.NewAuthorizeResponse(context.Background(), authorizationRequest, session)
+	require.NoError(t, err)
+	require.NotNil(t, response)
+	assert.NotEmpty(t, response.GetCode())
+}
