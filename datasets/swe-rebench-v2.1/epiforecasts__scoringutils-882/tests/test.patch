diff --git a/tests/testthat/test-metrics-quantile.R b/tests/testthat/test-metrics-quantile.R
index b026379..7604ef9 100644
--- a/tests/testthat/test-metrics-quantile.R
+++ b/tests/testthat/test-metrics-quantile.R
@@ -950,3 +950,55 @@ test_that("ae_median_quantile() works as_expected", {
 
   dim(1:10)
 })
+
+
+
+# ============================================================================ #
+# quantile_score() =============================================================
+# ============================================================================ #
+test_that("quantile_score() works regardless of whether input is vector or matrix", {
+
+  observed <- rnorm(1, mean = 2)
+  alpha <- seq(0.2, 0.8, 0.2)
+  predicted <- rnorm(4, mean = 1:4)
+
+
+  expect_equal(
+    quantile_score(observed, predicted, quantile_level = alpha),
+    quantile_score(observed, t(matrix(predicted)), quantile_level = alpha)
+  )
+})
+
+
+
+test_that("quantile_score() computes the quantile scoring rule", {
+  # observation above the predicted quantile: 2 * (0 - tau) * (q - y)
+  expect_equal(quantile_score(5, matrix(3), quantile_level = 0.25), 1)
+  expect_equal(quantile_score(5, matrix(3), quantile_level = 0.75), 3)
+  # observation below the predicted quantile: 2 * (1 - tau) * (q - y)
+  expect_equal(quantile_score(5, matrix(7), quantile_level = 0.25), 3)
+  expect_equal(quantile_score(5, matrix(7), quantile_level = 0.75), 1)
+})
+
+
+test_that("quantile_score() computes the quantile scoring rule for a vector forecast", {
+  # observation above the predicted quantile
+  expect_equal(quantile_score(5, c(3), quantile_level = 0.75), 3)
+  # observation below the predicted quantile
+  expect_equal(quantile_score(5, c(7), quantile_level = 0.25), 3)
+})
+
+
+test_that("quantile_score() averages the per-quantile scores for each observation", {
+  # per-quantile scores for the two quantile levels are 1 and 2.5, so the
+  # returned value is their arithmetic mean (1.75), not their sum (3.5)
+  expect_equal(
+    quantile_score(5, matrix(c(3, 10), nrow = 1), quantile_level = c(0.25, 0.75)),
+    1.75
+  )
+  # the equivalent vector forecast returns the same averaged score
+  expect_equal(
+    quantile_score(5, c(3, 10), quantile_level = c(0.25, 0.75)),
+    1.75
+  )
+})
