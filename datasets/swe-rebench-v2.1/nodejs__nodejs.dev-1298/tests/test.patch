diff --git a/test/pages/trademark.test.tsx b/test/pages/trademark.test.tsx
new file mode 100644
index 0000000..18215c4
--- /dev/null
+++ b/test/pages/trademark.test.tsx
@@ -0,0 +1,43 @@
+import React from 'react';
+import fs from 'fs';
+import path from 'path';
+import { render } from '@testing-library/react';
+import TrademarkPage from '../../src/pages/trademark';
+import '../__mocks__/intersectionObserverMock';
+
+import { createTrademarkData } from '../__fixtures__/page';
+
+const mockData = createTrademarkData();
+
+describe('Trademark page', () => {
+  it('renders the supplied page data', () => {
+    const { getByText, container } = render(
+      <TrademarkPage data={mockData.data} />
+    );
+    expect(getByText('Mock Title')).toBeInTheDocument();
+    expect(getByText('Sample')).toBeInTheDocument();
+    expect(
+      container.querySelector(
+        'a[href="https://github.com/nodejs/nodejs.dev/edit/master/content/about/trademark.md"]'
+      )
+    ).not.toBeNull();
+  });
+
+  it('is available as a generated /trademark page', () => {
+    const routePath = path.resolve(__dirname, '../../public/trademark/index.html');
+    expect(fs.existsSync(routePath)).toBe(true);
+    expect(fs.readFileSync(routePath, 'utf8')).toContain('Node.js trademarks');
+  });
+
+  it('provides the trademark policy content', () => {
+    const contentPath = path.resolve(
+      __dirname,
+      '../../content/about/trademark.md'
+    );
+    expect(fs.existsSync(contentPath)).toBe(true);
+    const content = fs.readFileSync(contentPath, 'utf8');
+    expect(content).toContain('Node.js trademarks');
+    expect(content).toContain('OpenJS Foundation');
+    expect(content).toContain('trademark@openjsf.org');
+  });
+});
