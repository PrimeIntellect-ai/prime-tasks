+@pytest.mark.parametrize(
+    "assy_fixture, expected",
+    [
+        ("boxes8_assy", {"center": (0.5, 10, 0.5)},),
+        ("boxes9_assy", {"center": (0.5, 10, 0.5)},),
+    ],
+)
+def test_step_export_loc(assy_fixture, expected, request, tmpdir):
+    stepfile = Path(tmpdir, assy_fixture).with_suffix(".step")
+    if not stepfile.exists():
+        assy = request.getfixturevalue(assy_fixture)
+        assy.save(str(stepfile))
+    o = cq.importers.importStep(str(stepfile))
+    c = cq.Compound.makeCompound(o.solids().vals()).Center()
+    assert pytest.approx(c.toTuple()) == expected["center"]
+
+
+@pytest.mark.parametrize("assy_fixture", ["boxes8_assy", "boxes9_assy"])
+def test_caf_export_loc(assy_fixture, request):
+    assy = request.getfixturevalue(assy_fixture)
+    root, doc = toCAF(assy)
+    tool = XCAFDoc_DocumentTool.ShapeTool_s(doc.Main())
+    caf_shape = cq.Shape.cast(tool.GetShape_s(root))
+
+    assert caf_shape.Center().toTuple() == pytest.approx(
+        assy.toCompound().Center().toTuple()
+    )
+
+
+def test_caf_export_rotated_top_level_location(rotated_top_level_assy):
+    root, doc = toCAF(rotated_top_level_assy)
+    tool = XCAFDoc_DocumentTool.ShapeTool_s(doc.Main())
+    caf_shape = cq.Shape.cast(tool.GetShape_s(root))
+
+    assert caf_shape.Center().toTuple() == pytest.approx((10, 22, 1.5))
+
+
+def test_step_export_rotated_top_level_location(rotated_top_level_assy, tmp_path):
+    stepfile = tmp_path / "rotated_top_level.step"
+    rotated_top_level_assy.save(str(stepfile))
+    exported = cq.importers.importStep(str(stepfile))
+
+    center = cq.Compound.makeCompound(exported.solids().vals()).Center()
+    assert center.toTuple() == pytest.approx((10, 22, 1.5))
+
