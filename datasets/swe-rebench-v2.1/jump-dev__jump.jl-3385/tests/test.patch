+function test_generic_model_rational()
+    model = GenericModel{Rational{BigInt}}()
+    @test value_type(typeof(model)) == Rational{BigInt}
+    @variable(model, x)
+    @test x isa GenericVariableRef{Rational{BigInt}}
+    expr = @expression(model, 1 // 3 * x)
+    @test expr isa
+          GenericAffExpr{Rational{BigInt},GenericVariableRef{Rational{BigInt}}}
+    @test coefficient(expr, x) == 1 // 3
+    c = @constraint(model, 2 // 7 * x <= 1 // 5)
+    co = constraint_object(c)
+    @test co.func isa
+          GenericAffExpr{Rational{BigInt},GenericVariableRef{Rational{BigInt}}}
+    @test coefficient(co.func, x) == 2 // 7
+    @test co.set isa MOI.LessThan{Rational{BigInt}}
+    @test co.set.upper == 1 // 5
+    return
+end
 end  # module
