+class RobotsSitemapResponseMiddleware(object):
+
+    def process_request(self, request, spider):
+        if request.url.endswith('/robots.txt'):
+            body = b'Sitemap: http://example.com/sitemap.xml\n'
+        elif request.url.endswith('/sitemap.xml'):
+            body = b"""<?xml version='1.0' encoding='UTF-8'?>
+<urlset xmlns='http://www.sitemaps.org/schemas/sitemap/0.9'>
+  <url><loc>http://example.com/page-one</loc></url>
+  <url><loc>http://example.com/page-two</loc></url>
+</urlset>"""
+        else:
+            body = b'page'
+        return TextResponse(request.url, body=body)
+
+
+class RobotsSitemapCrawlSpider(SitemapSpider):
+    name = 'robots_sitemap_crawl'
+    allowed_domains = ['example.com']
+    sitemap_urls = ['http://example.com/robots.txt']
+
+    def __init__(self, *args, **kwargs):
+        super(RobotsSitemapCrawlSpider, self).__init__(*args, **kwargs)
+        self.pages_parsed = []
+
+    def parse(self, response):
+        self.pages_parsed.append(response.url)
+
+
