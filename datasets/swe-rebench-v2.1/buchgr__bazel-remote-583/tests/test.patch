+
+func TestDiskCacheInitializesWithRootLostFoundDirectory(t *testing.T) {
+	cacheDir := tempDir(t)
+	defer os.RemoveAll(cacheDir)
+
+	// Create a "lost+found" directory in the root of the cache dir, as
+	// created by fsck on some unix style filesystems. We expect to be able
+	// to load this cache dir and ignore it.
+	err := os.Mkdir(path.Join(cacheDir, "lost+found"), os.ModePerm)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	_, err = New(cacheDir, 4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+}
