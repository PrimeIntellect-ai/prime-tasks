+    def testParsePickleSpannerNotDuplicated(self):
+        '''
+        Parsing a MusicXML file in which two notes of a single chord are
+        spanned by the same spanner must not fail when the parsed stream is
+        written to a pickle.  This is the reported GuitarPro failure
+        (a spanner containing the same element twice).
+        '''
+        from music21 import converter
+        import os
+        import tempfile
+
+        xml = '''<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 1.0 Partwise//EN"
+                                "http://www.musicxml.org/dtds/partwise.dtd">
+<score-partwise>
+  <part-list>
+    <score-part id="P1">
+      <part-name>MusicXML Part</part-name>
+    </score-part>
+  </part-list>
+  <part id="P1">
+    <measure number="1">
+      <attributes>
+        <divisions>1</divisions>
+        <key><fifths>0</fifths></key>
+        <time><beats>4</beats><beat-type>4</beat-type></time>
+        <clef><sign>G</sign><line>2</line></clef>
+      </attributes>
+      <note>
+        <pitch><step>C</step><octave>5</octave></pitch>
+        <duration>1</duration><voice>1</voice><type>quarter</type>
+        <notations><slur number="1" type="start"/></notations>
+      </note>
+      <note>
+        <chord/>
+        <pitch><step>E</step><octave>5</octave></pitch>
+        <duration>1</duration><voice>1</voice><type>quarter</type>
+        <notations><slur number="1" type="start"/></notations>
+      </note>
+      <note>
+        <pitch><step>D</step><octave>5</octave></pitch>
+        <duration>1</duration><voice>1</voice><type>quarter</type>
+        <notations><slur number="1" type="stop"/></notations>
+      </note>
+      <note>
+        <chord/>
+        <pitch><step>F</step><octave>5</octave></pitch>
+        <duration>1</duration><voice>1</voice><type>quarter</type>
+        <notations><slur number="1" type="stop"/></notations>
+      </note>
+    </measure>
+  </part>
+</score-partwise>
+'''
+        with tempfile.TemporaryDirectory() as tmpdir:
+            fp = os.path.join(tmpdir, 'chordSlur.xml')
+            with open(fp, 'w', encoding='utf-8') as f:
+                f.write(xml)
+            # converter.parse() writes a pickle of the parsed stream; this
+            # used to raise SitesException for a spanner holding a duplicate.
+            converter.parse(fp)
+
     def testDoubleStreamPlacement(self):
