 func TestSpace(t *testing.T) {
+	enabledIndentSizeConfig := config.Config{}
+
+	dir, err := ioutil.TempDir("", "editorconfig-checker")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+
+	configPath := filepath.Join(dir, ".ecrc")
+	if err := ioutil.WriteFile(configPath, []byte(`{"Disable":{"IndentSize":true}}`), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	disabledIndentSizeConfig, err := config.NewConfig(configPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := disabledIndentSizeConfig.Parse(); err != nil {
+		t.Fatal(err)
+	}
+
 	spaceTests := []struct {
 		line       string
 		indentSize int
+		config     config.Config
 		expected   error
+		expectErr  bool
 	}{
-		{"", 4, nil},
-		{"x", 0, nil},
-		{"x", 4, nil},
-		{"    x", 4, nil},
+		{"", 4, enabledIndentSizeConfig, nil, false},
+		{"x", 0, enabledIndentSizeConfig, nil, false},
+		{"x", 4, enabledIndentSizeConfig, nil, false},
+		{"    x", 4, enabledIndentSizeConfig, nil, false},
 		// 5 spaces
-		{"     x", 4, errors.New("Wrong amount of left-padding spaces(want multiple of 4)")},
+		{"     x", 4, enabledIndentSizeConfig, errors.New("Wrong amount of left-padding spaces(want multiple of 4)"), false},
 		// 3 spaces
-		{"   x", 4, errors.New("Wrong amount of left-padding spaces(want multiple of 4)")},
-		// correct indented block comment, empty and non empty
-		{"     *", 4, nil},
-		{"     * some comment", 4, nil},
-		{"    ", 4, nil},
+		{"   x", 4, enabledIndentSizeConfig, errors.New("Wrong amount of left-padding spaces(want multiple of 4)"), false},
+		{"    ", 4, enabledIndentSizeConfig, nil, false},
+		// disabled indent size
+		{"", 4, *disabledIndentSizeConfig, nil, false},
+		{" x ", 4, *disabledIndentSizeConfig, nil, false},
+		{"  x ", 4, *disabledIndentSizeConfig, nil, false},
+		{"    x ", 4, *disabledIndentSizeConfig, nil, false},
+		{"     x ", 4, *disabledIndentSizeConfig, nil, false},
+		{"\tx ", 4, *disabledIndentSizeConfig, nil, true},
+		{"    \t\tx a", 4, *disabledIndentSizeConfig, nil, true},
 	}
 
 	for _, tt := range spaceTests {
-		actual := Space(tt.line, tt.indentSize)
+		actual := Indentation(tt.line, "space", tt.indentSize, tt.config)
+		if tt.expectErr {
+			if actual == nil {
+				t.Errorf("Indentation(%q, %q, %d): expected an error, got nil", tt.line, "space", tt.indentSize)
+			}
+			continue
+		}
 		if !reflect.DeepEqual(actual, tt.expected) {
-			t.Errorf("Space(%s, %d): expected: %v, got: %v", tt.line, tt.indentSize, tt.expected, actual)
+			t.Errorf("Indentation(%q, %q, %d): expected: %v, got: %v", tt.line, "space", tt.indentSize, tt.expected, actual)
 		}
 	}
 }
 
+func TestSpaceSignature(t *testing.T) {
+	spaceType := reflect.TypeOf(Space)
+	if spaceType.In(0).Kind() != reflect.String {
+		t.Errorf("Space first argument should be a string, got %v", spaceType.In(0))
+	}
+	if spaceType.In(1).Kind() != reflect.Int {
+		t.Errorf("Space second argument should be an int, got %v", spaceType.In(1))
+	}
+	if spaceType.NumOut() != 1 || spaceType.Out(0) != reflect.TypeOf((*error)(nil)).Elem() {
+		t.Errorf("Space should return a single error, got %v", spaceType.Out(0))
+	}
+}
