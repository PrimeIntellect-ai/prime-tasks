+func TestReflectorFieldSchemaAnnotations(t *testing.T) {
+	type ExampleObject struct {
+		Foo string `json:"foo" readOnly:"true"`
+		Bar string `json:"bar" writeOnly:"true"`
+		Baz string `json:"baz" deprecated:"true"`
+	}
+
+	type ExampleResponse struct {
+		ExampleObject `json:"example"`
+	}
+
+	reflector := openapi3.NewReflector()
+	op, err := reflector.NewOperationContext("GET", "/some/path")
+	require.NoError(t, err)
+
+	op.AddRespStructure(ExampleResponse{})
+	require.NoError(t, reflector.AddOperation(op))
+
+	serialized, err := json.Marshal(reflector.SpecSchema())
+	require.NoError(t, err)
+	var document map[string]interface{}
+	require.NoError(t, json.Unmarshal(serialized, &document))
+
+	var findFieldSchema func(interface{}, string) map[string]interface{}
+	findFieldSchema = func(value interface{}, property string) map[string]interface{} {
+		switch value := value.(type) {
+		case map[string]interface{}:
+			if properties, ok := value["properties"].(map[string]interface{}); ok {
+				if field, ok := properties[property].(map[string]interface{}); ok {
+					return field
+				}
+			}
+			for _, child := range value {
+				if field := findFieldSchema(child, property); field != nil {
+					return field
+				}
+			}
+		case []interface{}:
+			for _, child := range value {
+				if field := findFieldSchema(child, property); field != nil {
+					return field
+				}
+			}
+		}
+		return nil
+	}
+
+	for _, annotation := range []struct {
+		property string
+		name     string
+	}{
+		{property: "foo", name: "readOnly"},
+		{property: "bar", name: "writeOnly"},
+		{property: "baz", name: "deprecated"},
+	} {
+		fieldSchema := findFieldSchema(document, annotation.property)
+		require.NotNil(t, fieldSchema, "%s must have a reflected schema", annotation.property)
+		value, present := fieldSchema[annotation.name]
+		require.True(t, present, "%s annotation must be present", annotation.name)
+		assert.Equal(t, true, value, "%s annotation must be true", annotation.name)
+	}
+}
