diff --git a/test/type.asset.test.js b/test/type.asset.test.js
new file mode 100644
index 00000000..9b7dad5d
--- /dev/null
+++ b/test/type.asset.test.js
@@ -0,0 +1,67 @@
+import File from '../lib/util/file.js';
+
+import chai, { assert, expect } from 'chai';
+import chaiFiles from 'chai-files';
+import * as testUtils from './utils.js';
+import handler from '../lib/index.js';
+chai.use(chaiFiles);
+const file = chaiFiles.file;
+
+/**
+ * gets file from Retrieve folder
+ *
+ * @param {string} customerKey of metadata
+ * @param {string} type of metadata
+ * @param {string} subtype of metadata
+ * @param {string} ext file extension
+ * @returns {string} file path
+ */
+function getActualFile(customerKey, type, subtype, ext) {
+    return `./retrieve/testInstance/testBU/${type}/${subtype}/${customerKey}.${type}-${subtype}-meta.${ext}`;
+}
+
+describe('type: asset', () => {
+    beforeEach(() => {
+        testUtils.mockSetup();
+    });
+    afterEach(() => {
+        testUtils.mockReset();
+    });
+    describe('Retrieve ================', () => {
+        it('Should retrieve a asset & ensure non-ssjs code is not removed', async () => {
+            // WHEN
+            await handler.retrieve('testInstance/testBU', ['asset']);
+
+            // the retrieved file must be an HTML file (not an SSJS-only file) that keeps
+            // all content around the SSJS script tag and formats the AMPscript section
+            expect(file(getActualFile('mcdev-issue-1157', 'asset', 'block', 'html'))).to.exist;
+            const actualHtml = await File.readFile(
+                getActualFile('mcdev-issue-1157', 'asset', 'block', 'html'),
+                'utf8'
+            );
+            assert.include(
+                actualHtml,
+                'my 1st html',
+                'content before the SSJS script tag was lost'
+            );
+            assert.include(
+                actualHtml,
+                'my 2nd html',
+                'content after the SSJS script tag was lost'
+            );
+            assert.include(
+                actualHtml,
+                '<script runat="server">',
+                'the SSJS script tag was lost'
+            );
+            assert.include(actualHtml, '// my ssjs', 'the SSJS code was lost');
+            assert.include(
+                actualHtml,
+                '%%[\n    /* my ampscript */\n]%%',
+                'the AMPscript section was not formatted as required'
+            );
+
+            return;
+        });
+    });
+});
