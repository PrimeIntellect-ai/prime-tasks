+func TestURIIsSafeDuringTriggerDescription_Regression900(t *testing.T) {
+	client := clientv1beta1.NewMockKnEventingClient(t, "mynamespace")
+
+	recorder := client.Recorder()
+	recorder.GetTrigger("testtrigger", triggerWithHTTPSinkForDescribeRegression900(), nil)
+	// Describing a Trigger whose sink is a URI (instead of a Ref) must not
+	// panic. Recover explicitly so that a regression fails only this test
+	// instead of aborting the whole test binary.
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("kn trigger describe panicked for a URI sink: %v", r)
+		}
+	}()
+	out, err := executeTriggerCommand(client, nil, "describe", "testtrigger")
+	assert.NilError(t, err)
+
+	assert.Assert(t, util.ContainsAll(out, "Sink:", "URI", "https", "foo"))
+}
 
