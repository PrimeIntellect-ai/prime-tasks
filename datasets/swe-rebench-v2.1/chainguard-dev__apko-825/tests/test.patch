+// TestPublishPackageVersionTag verifies that publishing an image with a
+// package-version tag publishes additional image references derived from the
+// version of the selected installed package.
+func TestPublishPackageVersionTag(t *testing.T) {
+	ctx := context.Background()
+
+	r := registry.New()
+	s := httptest.NewServer(r)
+	defer s.Close()
+	u, err := url.Parse(s.URL)
+	require.NoError(t, err)
+
+	dst := fmt.Sprintf("%s/test/publish", u.Host)
+
+	// Locate the shared testdata used to build a small image.
+	_, thisFile, _, ok := runtime.Caller(0)
+	require.True(t, ok)
+	testdata := filepath.Join(filepath.Dir(thisFile), "..", "..", "internal", "cli", "testdata")
+	testdata, err = filepath.Abs(testdata)
+	require.NoError(t, err)
+
+	config := filepath.Join(t.TempDir(), "apko.yaml")
+	cfg := fmt.Sprintf(`contents:
+  keyring:
+    - %s
+  repositories:
+    - %s
+  packages:
+    - tzdata
+
+entrypoint:
+  command: /bin/sh -l
+
+archs:
+- x86_64
+- aarch64
+`, filepath.Join(testdata, "local-melange.rsa.pub"), filepath.Join(testdata, "packages"))
+	require.NoError(t, os.WriteFile(config, []byte(cfg), 0o644))
+
+	archs := types.ParseArchitectures([]string{"amd64", "arm64"})
+	ropt := []remote.Option{remote.WithTransport(s.Client().Transport)}
+	opts := []build.Option{build.WithConfig(config), build.WithTags(dst)}
+	publishOpts := []cli.PublishOption{cli.WithTags(dst), cli.WithPackageVersionTag("tzdata"), cli.WithLogger(&log.Adapter{Out: io.Discard})}
+
+	require.NoError(t, cli.PublishCmd(ctx, "", archs, ropt, opts, publishOpts))
+
+	// The tzdata package in the test repository is version 2023c-r0, so the
+	// published image must also be available under that version-derived tag.
+	ref, err := name.ParseReference(dst + ":2023c-r0")
+	require.NoError(t, err)
+	_, err = remote.Get(ref, ropt...)
+	require.NoError(t, err, "expected an additional tag derived from the package version to be published")
+}
