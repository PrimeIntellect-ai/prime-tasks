+def test_deserialize_entity_fields_with_quoted_descriptions():
+    """Quoted entity descriptions must not shift neighboring CIF fields."""
+    text = """data_example
+loop_
+_entity.id
+_entity.pdbx_description
+1 'The 5'
+2 'Small nuclear ribonucleoprotein-associated protein B'
+3 "GUANOSINE-5'-TRIPHOSPHATE"
+4
+;single' and double" marks with whitespace
+;
+"""
+    cif_file = pdbx.CIFFile.read(StringIO(text))
+    entity = cif_file.block["entity"]
+
+    assert entity["id"].as_array(str).tolist() == ["1", "2", "3", "4"]
+    assert entity["pdbx_description"].as_array(str).tolist() == [
+        "The 5",
+        "Small nuclear ribonucleoprotein-associated protein B",
+        "GUANOSINE-5'-TRIPHOSPHATE",
+        'single\' and double" marks with whitespace',
+    ]
+
+
+def test_deserialize_entity_loop_in_external_column_order():
+    """Entity fields retain their values in a valid externally ordered loop."""
+    text = """data_external
+loop_
+_entity.pdbx_description
+_entity.id
+;single' and double" marks with whitespace
+;
+1
+'Small nuclear ribonucleoprotein-associated protein B' 2
+'Unknown polypeptide' 3
+"""
+
+    entity = pdbx.CIFFile.read(StringIO(text)).block["entity"]
+
+    assert entity["id"].as_array(str).tolist() == ["1", "2", "3"]
+    assert entity["pdbx_description"].as_array(str).tolist() == [
+        "single' and double\" marks with whitespace",
+        "Small nuclear ribonucleoprotein-associated protein B",
+        "Unknown polypeptide",
+    ]
+
+
