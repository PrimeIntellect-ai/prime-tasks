+def test_class_anon_struct_as_unnamed_classvar() -> None:
+    content = """
+      struct AnonHolderClass {
+        struct {
+          int x;
+          int y;
+        };
+        int z;
+      };
+    """
+    data = parse_string(content, cleandoc=True)
+
+    fields = data.namespace.classes[0].fields
+    unnamed_fields = [field for field in fields if field.name is None]
+
+    assert len(unnamed_fields) == 1
+    assert {field.name for field in fields if field.name is not None} == {"z"}
+
