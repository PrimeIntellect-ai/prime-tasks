+def test_class_multiple_anonymous_aggregate_fields() -> None:
+    content = """
+      struct Holder {
+        int before;
+        struct { int first_struct; };
+        union { int first_union; };
+        struct { int second_struct; };
+        union { int second_union; };
+        int after;
+      };
+    """
+    data = parse_string(content, cleandoc=True)
+
+    fields = data.namespace.classes[0].fields
+    unnamed_fields = [field for field in fields if field.name is None]
+
+    assert len(unnamed_fields) == 4
+    assert {field.name for field in fields if field.name is not None} == {
+        "before",
+        "after",
+    }
