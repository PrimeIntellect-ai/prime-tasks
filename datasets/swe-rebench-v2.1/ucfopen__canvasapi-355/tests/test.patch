diff --git a/tests/test_canvas.py b/tests/test_canvas.py
index 7a5a78d..2e91d58 100644
--- a/tests/test_canvas.py
+++ b/tests/test_canvas.py
@@ -832,3 +832,59 @@ class TestCanvas(unittest.TestCase):
         self.assertEqual(comm_messages[0].subject, "example subject line")
         self.assertEqual(comm_messages[1].id, 2)
         self.assertEqual(comm_messages[1].subject, "My Subject")
+
+    def test_graphql(self, m):
+        register_uris({"graphql": ["graphql"]}, m, base_url=settings.BASE_URL_GRAPHQL)
+        query = """
+        query MyQuery($termid: ID!) {
+            term(id: $termid) {
+                coursesConnection {
+                    nodes {
+                        _id
+                        assignmentsConnection {
+                        nodes {
+                            name
+                            _id
+                            expectsExternalSubmission
+                        }
+                        }
+                    }
+                    edges {
+                        node {
+                        id
+                        }
+                    }
+                }
+            }
+        }
+        """
+        variables = {"termid": 125}
+
+        graphql_response = self.canvas.graphql(query=query, variables=variables)
+
+        self.assertIsInstance(graphql_response, dict)
+        self.assertEqual(
+            graphql_response["term"]["coursesConnection"]["nodes"][0]["_id"], "1"
+        )
+        self.assertEqual(m.last_request.method, "POST")
+        self.assertEqual(m.last_request.url, settings.BASE_URL_GRAPHQL + "graphql")
+        self.assertEqual(m.last_request.json()["query"], query)
+        self.assertEqual(m.last_request.json()["variables"], variables)
+
+    def test_graphql_without_variables(self, m):
+        register_uris({"graphql": ["graphql"]}, m, base_url=settings.BASE_URL_GRAPHQL)
+        query = "query { term { _id } }"
+
+        graphql_response = self.canvas.graphql(query=query)
+
+        self.assertIsInstance(graphql_response, dict)
+        self.assertEqual(m.last_request.json()["query"], query)
+
+    def test_graphql_accepts_extra_kwargs(self, m):
+        register_uris({"graphql": ["graphql"]}, m, base_url=settings.BASE_URL_GRAPHQL)
+        query = "query { term { _id } }"
+
+        graphql_response = self.canvas.graphql(query=query, operationName="MyQuery")
+
+        self.assertIsInstance(graphql_response, dict)
+
