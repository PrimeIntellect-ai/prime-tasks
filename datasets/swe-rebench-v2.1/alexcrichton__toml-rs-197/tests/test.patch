diff --git a/tests/pretty.rs b/tests/pretty.rs
new file mode 100644
index 0000000..b5cf891
--- /dev/null
+++ b/tests/pretty.rs
@@ -0,0 +1,34 @@
+extern crate toml;
+extern crate serde;
+
+use serde::ser::Serialize;
+
+const INPUT: &'static str = r#"text = "first\nsecond"
+"#;
+
+#[test]
+fn escaped_multiline_string_remains_available() {
+    let value: toml::Value = toml::from_str(INPUT).unwrap();
+    let mut result = String::new();
+    value.serialize(&mut toml::Serializer::new(&mut result)).unwrap();
+
+    assert!(result.contains(r#""first\nsecond""#));
+    let decoded: toml::Value = toml::from_str(&result).unwrap();
+    assert_eq!(decoded, value);
+}
+
+#[test]
+fn configured_multiline_string_uses_triple_single_quotes() {
+    let value: toml::Value = toml::from_str(INPUT).unwrap();
+    let mut result = String::new();
+    {
+        let mut serializer = toml::Serializer::new(&mut result);
+        serializer.pretty_string(true);
+        value.serialize(&mut serializer).unwrap();
+    }
+
+    assert!(result.contains("'''"));
+    assert!(result.contains("first\nsecond"));
+    let decoded: toml::Value = toml::from_str(&result).unwrap();
+    assert_eq!(decoded, value);
+}
