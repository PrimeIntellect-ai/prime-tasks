+class TestExplodeAgg:
+    """Test util method _explode_agg"""
+
+    def test_empty_agg(self):
+        """With an empty aggregated DataFrame the original data is returned with an all-NaN column."""
+        orig_df = pd.DataFrame({"a": [1, 2], "b": ["i", "i"]})
+        agg_df = pd.DataFrame({"id": pd.Series([], dtype=object), "c": pd.Series([], dtype=object)})
+        returned_df = _explode_agg("id", "c", orig_df, agg_df)
+        assert set(returned_df.columns) == {"a", "b", "c"}
+        assert returned_df["a"].tolist() == [1, 2]
+        assert returned_df["b"].tolist() == ["i", "i"]
+        assert returned_df["c"].isna().all()
+
+    def test_list_column(self):
+        """List-like entries are exploded and joined back by their value."""
+        orig_df = pd.DataFrame({"a": [1, 2, 3, 4]})
+        agg_df = pd.DataFrame({"id": [[0, 1], [3]], "c": [0, 1]})
+        returned_df = _explode_agg("id", "c", orig_df, agg_df)
+        assert set(returned_df.columns) == {"a", "c"}
+        assert returned_df["a"].tolist() == [1, 2, 3, 4]
+        result = returned_df["c"].tolist()
+        assert result[0] == 0
+        assert result[1] == 0
+        assert pd.isna(result[2])
+        assert result[3] == 1
+
+    def test_original_rows_preserved(self):
+        """The original rows are preserved and unmatched rows receive NaN."""
+        orig_df = pd.DataFrame({"a": [10, 20, 30]}, index=[5, 6, 7])
+        agg_df = pd.DataFrame({"id": [[5]], "c": [99]})
+        returned_df = _explode_agg("id", "c", orig_df, agg_df)
+        assert returned_df["a"].tolist() == [10, 20, 30]
+        result = returned_df["c"].tolist()
+        assert result[0] == 99
+        assert pd.isna(result[1])
+        assert pd.isna(result[2])
+
