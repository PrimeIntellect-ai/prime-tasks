+class TestGenerateStaypointsIdAssignment:
+    """generate_staypoints assigns staypoint ids to positionfixes."""
+
+    def test_staypoint_id_assignment(self):
+        """Every staypoint is referenced by positionfixes and every assigned id is a valid staypoint."""
+        pfs, _ = ti.io.dataset_reader.read_geolife(os.path.join("tests", "data", "geolife_long"))
+        pfs_out, sp = pfs.as_positionfixes.generate_staypoints(
+            method="sliding", dist_threshold=25, time_threshold=5
+        )
+        assert "staypoint_id" in pfs_out.columns
+        assigned = set(pfs_out["staypoint_id"].dropna().unique())
+        assert assigned == set(sp.index)
