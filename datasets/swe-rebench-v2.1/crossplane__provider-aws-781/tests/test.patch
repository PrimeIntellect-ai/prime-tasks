+func TestObservePolicyWithReorderedActions(t *testing.T) {
+	remotePolicy := `{"Statement":[{"Action":["ecr:BatchGetImage","ecr:ListImages"],"Effect":"Allow","Principal":"*"}],"Version":"2012-10-17"}`
+	configured := &v1alpha1.RepositoryPolicyParameters{
+		Policy: &v1alpha1.RepositoryPolicyBody{
+			Version: "2012-10-17",
+			Statements: []v1alpha1.RepositoryPolicyStatement{{
+				Effect:    "Allow",
+				Principal: &v1alpha1.RepositoryPrincipal{AllowAnon: &boolCheck},
+				Action:    []string{"ecr:ListImages", "ecr:BatchGetImage"},
+			}},
+		},
+	}
+	client := &fake.MockRepositoryPolicyClient{
+		MockGet: func(input *awsecr.GetRepositoryPolicyInput) awsecr.GetRepositoryPolicyRequest {
+			return awsecr.GetRepositoryPolicyRequest{
+				Request: &aws.Request{HTTPRequest: &http.Request{}, Retryer: aws.NoOpRetryer{}, Data: &awsecr.GetRepositoryPolicyOutput{
+					PolicyText: &remotePolicy,
+				}},
+			}
+		},
+	}
+
+	got, err := (&external{client: client}).Observe(context.Background(), repositoryPolicy(withPolicy(configured)))
+	if err != nil {
+		t.Fatalf("Observe returned an unexpected error: %v", err)
+	}
+	if !got.ResourceUpToDate {
+		t.Errorf("expected reordered policy array items to remain up to date")
+	}
+}
