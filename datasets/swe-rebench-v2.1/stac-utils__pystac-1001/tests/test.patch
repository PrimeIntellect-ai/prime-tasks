+def test_fully_resolve(tmp_path: Path, label_catalog: Catalog) -> None:
+    label_catalog.save(dest_href=str(tmp_path / "before"))
+    assert len(list((tmp_path / "before").glob("**/*.json"))) == 1
+    label_catalog.fully_resolve()
+    label_catalog.save(dest_href=str(tmp_path / "after"))
+    assert len(list((tmp_path / "after").glob("**/*.json"))) == 15
+
+    # The problem statement's use case: a Collection loaded from a file can be
+    # fully resolved and then saved with all of its objects.
+    collection = Collection.from_file(
+        TestCases.get_path(
+            "data-files/catalogs/test-case-1/country-1/area-1-1/collection.json"
+        )
+    )
+    collection.save(dest_href=str(tmp_path / "collection-before"))
+    assert len(list((tmp_path / "collection-before").glob("**/*.json"))) == 1
+    collection.fully_resolve()
+    collection.save(dest_href=str(tmp_path / "collection-after"))
+    assert len(list((tmp_path / "collection-after").glob("**/*.json"))) == 3
