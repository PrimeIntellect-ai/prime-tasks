+  /**
+   * Asserts that the spawned process invokes the local `func` core tools with
+   * `host start`. The public contract allows resolving the tool either directly
+   * from `node_modules/.bin` or via `npx`, so both shapes are accepted. What is
+   * rejected is relying on a globally installed `func` executable.
+   */
+  function expectFuncHostStart(call: any) {
+    const funcName = process.platform === "win32" ? "func.cmd" : "func";
+    if (call.command === "npx") {
+      // `npx` may be given flags and package-resolution options before the
+      // tool name (e.g. `npx --yes --package azure-functions-core-tools func
+      // host start`). Locate the `func` token and require `host start` after it.
+      const funcIndex = call.args.findIndex((arg: string) => /^func(\.cmd)?$/.test(arg));
+      expect(funcIndex).toBeGreaterThanOrEqual(0);
+      expect(call.args.slice(funcIndex + 1)).toEqual(["host", "start"]);
+    } else {
+      // Direct invocation of the locally installed executable
+      expect(call.command).toContain(path.join("node_modules", ".bin", funcName));
+      expect(call.args).toEqual(["host", "start"]);
+    }
+  }
+
