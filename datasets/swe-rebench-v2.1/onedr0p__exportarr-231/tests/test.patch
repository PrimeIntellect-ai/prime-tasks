diff --git a/internal/arr/collector/queue_test.go b/internal/arr/collector/queue_test.go
new file mode 100644
index 0000000..9b625cc
--- /dev/null
+++ b/internal/arr/collector/queue_test.go
@@ -0,0 +1,36 @@
+package collector
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/onedr0p/exportarr/internal/arr/config"
+	"github.com/onedr0p/exportarr/internal/test_util"
+	"github.com/prometheus/client_golang/prometheus/testutil"
+	"github.com/stretchr/testify/require"
+)
+
+func TestQueueMetricsRequestHandlesQueryParameters(t *testing.T) {
+	require := require.New(t)
+	requestReceived := false
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		require.Equal("/api/v3/queue", r.URL.Path)
+		requestReceived = true
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"page":1,"pageSize":1,"totalRecords":0,"records":[]}`))
+	}))
+	defer server.Close()
+
+	collector := NewQueueCollector(&config.ArrConfig{
+		App:        "sonarr",
+		ApiVersion: "v3",
+		URL:        server.URL,
+		ApiKey:     test_util.API_KEY,
+	})
+
+	// A successful collection proves constructing and using request query
+	// parameters does not panic and that the metrics request completes.
+	testutil.CollectAndCount(collector)
+	require.True(requestReceived, "the queue endpoint should receive the metrics request")
+}
