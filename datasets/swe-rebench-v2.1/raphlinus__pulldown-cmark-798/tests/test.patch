+#[test]
+fn tight_list_emphasis_ends_before_nested_block() {
+    let original = r##"- *foo
+  - -
+  baz*
+"##;
+    let mut html = String::new();
+    pulldown_cmark::html::push_html(&mut html, pulldown_cmark::Parser::new(original));
+
+    let nested_list_starts = html.match_indices("<ul>").skip(1);
+    for (position, _) in nested_list_starts {
+        assert_eq!(
+            html[..position].matches("<em>").count(),
+            html[..position].matches("</em>").count(),
+            "a nested list must not be contained in emphasis"
+        );
+    }
+}
+
+#[test]
+fn tight_list_code_span_ends_before_nested_block() {
+    let original = r##"- `foo
+  - -
+  baz`
+"##;
+    let mut html = String::new();
+    pulldown_cmark::html::push_html(&mut html, pulldown_cmark::Parser::new(original));
+
+    assert!(
+        html.matches("<ul>").count() > 1,
+        "the nested list must remain a block sibling"
+    );
+    let nested_list_start = html.match_indices("<ul>").nth(1).unwrap().0;
+    assert_eq!(
+        html[..nested_list_start].matches("<code>").count(),
+        html[..nested_list_start].matches("</code>").count(),
+        "a code span must not contain the nested list"
+    );
+}
+
+#[test]
+fn tight_list_link_ends_before_nested_block() {
+    let original = r##"- [foo
+  - -
+  baz](https://example.com)
+"##;
+    let mut html = String::new();
+    pulldown_cmark::html::push_html(&mut html, pulldown_cmark::Parser::new(original));
+
+    assert!(
+        html.matches("<ul>").count() > 1,
+        "the nested list must remain a block sibling"
+    );
+    let nested_list_start = html.match_indices("<ul>").nth(1).unwrap().0;
+    assert_eq!(
+        html[..nested_list_start].matches("<a ").count(),
+        html[..nested_list_start].matches("</a>").count(),
+        "a link must not contain the nested list"
+    );
+}
