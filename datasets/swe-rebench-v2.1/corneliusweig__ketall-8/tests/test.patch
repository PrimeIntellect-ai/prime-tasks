+func TestExcludeFlagCanBeClearedToIncludeEvents(t *testing.T) {
+	for _, test := range []struct {
+		name       string
+		args       []string
+		wantEvents bool
+	}{
+		{name: "default exclusion", wantEvents: false},
+		{name: "cleared exclusion", args: []string{"--exclude="}, wantEvents: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				switch r.URL.Path {
+				case "/api":
+					fmt.Fprint(w, `{"kind":"APIVersions","apiVersion":"v1","versions":["v1"]}`)
+				case "/apis":
+					fmt.Fprint(w, `{"kind":"APIGroupList","apiVersion":"v1","groups":[{"name":"events.k8s.io","versions":[{"groupVersion":"events.k8s.io/v1","version":"v1"}],"preferredVersion":{"groupVersion":"events.k8s.io/v1","version":"v1"}}]}`)
+				case "/api/v1":
+					fmt.Fprint(w, `{"kind":"APIResourceList","apiVersion":"v1","groupVersion":"v1","resources":[{"name":"pods","namespaced":true,"kind":"Pod","verbs":["get","list"]},{"name":"services","namespaced":true,"kind":"Service","verbs":["get","list"]},{"name":"events","namespaced":true,"kind":"Event","verbs":["get","list"]}]}`)
+				case "/apis/events.k8s.io/v1":
+					fmt.Fprint(w, `{"kind":"APIResourceList","apiVersion":"v1","groupVersion":"events.k8s.io/v1","resources":[{"name":"events","namespaced":true,"kind":"Event","verbs":["get","list"]}]}`)
+				default:
+					if strings.HasSuffix(r.URL.Path, "/events") && strings.HasPrefix(r.URL.Path, "/apis/events.k8s.io/") {
+						fmt.Fprint(w, `{"apiVersion":"events.k8s.io/v1","kind":"EventList","items":[{"apiVersion":"events.k8s.io/v1","kind":"Event","metadata":{"name":"group-event-sample"}}]}`)
+					} else if strings.HasSuffix(r.URL.Path, "/events") {
+						fmt.Fprint(w, `{"apiVersion":"v1","kind":"EventList","items":[{"apiVersion":"v1","kind":"Event","metadata":{"name":"core-event-sample"}}]}`)
+					} else if strings.HasSuffix(r.URL.Path, "/pods") {
+						fmt.Fprint(w, `{"apiVersion":"v1","kind":"PodList","items":[{"apiVersion":"v1","kind":"Pod","metadata":{"name":"pod-sample"}}]}`)
+					} else if strings.HasSuffix(r.URL.Path, "/services") {
+						fmt.Fprint(w, `{"apiVersion":"v1","kind":"ServiceList","items":[{"apiVersion":"v1","kind":"Service","metadata":{"name":"service-sample"}}]}`)
+					} else {
+						http.NotFound(w, r)
+					}
+				}
+			}))
+			defer server.Close()
+
+			args := append([]string{"run", "github.com/corneliusweig/ketall", "--server=" + server.URL, "--output=json"}, test.args...)
+			out, err := exec.Command("go", args...).CombinedOutput()
+			if err != nil {
+				t.Fatalf("running ketall against a test API server: %v\n%s", err, out)
+			}
+			output := string(out)
+			if !test.wantEvents {
+				assert.Contains(t, output, "pod-sample")
+			}
+			for _, eventName := range []string{"core-event-sample", "group-event-sample"} {
+				if test.wantEvents {
+					assert.Contains(t, output, eventName)
+				} else {
+					assert.NotContains(t, output, eventName)
+				}
+			}
+		})
+	}
+}
+
+// TestExcludeFlagIsExposed verifies that the user-facing exclusion option is available.
+func TestExcludeFlagIsExposed(t *testing.T) {
+	out, err := exec.Command("go", "run", "github.com/corneliusweig/ketall", "--help").CombinedOutput()
+	if err != nil {
+		t.Fatalf("running 'ketall --help': %v\n%s", err, out)
+	}
+	assert.Contains(t, string(out), "--exclude")
+}
