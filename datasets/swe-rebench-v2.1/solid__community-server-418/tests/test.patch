+  it('writes root container metadata without adding a containment triple.', async(): Promise<void> => {
+    metadata = new RepresentationMetadata({ path: 'http://test.com/' },
+      { [RDF.type]: [ toNamedNode(LDP.Resource), toNamedNode(LDP.Container) ]});
+    await expect(accessor.writeContainer({ path: 'http://test.com/' }, metadata)).resolves.toBeUndefined();
+
+    expect(fetchUpdate).toHaveBeenCalled();
+    const insertedTriples: any[] = [];
+    fetchUpdate.mock.calls.forEach((call: any[]): void => {
+      const updates: any[] = (new Parser().parse(call[1]) as any).updates;
+      updates.forEach((update: any): void => {
+        if (Array.isArray(update.insert)) {
+          update.insert.forEach((pattern: any): void => {
+            const graph = pattern.name || update.graph;
+            const triples: any[] = pattern.triples || (pattern.subject ? [ pattern ] : []);
+            triples.forEach((triple: any): void => {
+              insertedTriples.push({ ...triple, graph: graph || triple.graph });
+            });
+          });
+        }
+      });
+    });
+    const rootMetadata = insertedTriples.filter((triple: any): boolean =>
+      triple.subject.value === 'http://test.com/' && triple.predicate.value === RDF.type &&
+      triple.graph?.value === 'meta:http://test.com/');
+    expect(rootMetadata.map((triple: any): string => triple.object.value)).toEqual(expect.arrayContaining([
+      LDP.Resource,
+      LDP.Container,
+    ]));
+    expect(insertedTriples.some((triple: any): boolean => triple.predicate.value === LDP.contains)).toBe(false);
+  });
