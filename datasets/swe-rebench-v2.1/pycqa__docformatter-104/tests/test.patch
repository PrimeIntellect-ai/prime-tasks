 # Third Party Imports
 import pytest
@@ -41,6 +43,15 @@ import docformatter
 from . import generate_random_docstring
 
 
+def _format_with_cli(monkeypatch, source, *options):
+    output = io.StringIO()
+    monkeypatch.setattr(sys, "argv", ["docformatter", *options, "-"])
+    monkeypatch.setattr(sys, "stdin", io.StringIO(source))
+    monkeypatch.setattr(sys, "stdout", output)
+    docformatter.main()
+    return output.getvalue()
+
+
