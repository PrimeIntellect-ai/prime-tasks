+    @pytest.mark.unit
+    def test_format_docstring_for_multi_line_summary_alone(self, monkeypatch):
+        """Place closing quotes on newline when wrapping one-liner."""
+        source = '''\
+def f():
+    """This one-line docstring will be multi-line because it's quite long."""
+'''
+        formatted = _format_with_cli(
+            monkeypatch,
+            source,
+            "--wrap-summaries=69",
+            "--close-quotes-on-newline",
+        )
+        docstring_lines = formatted.splitlines()[1:]
+        assert len(docstring_lines) >= 3  # Summary spans multiple lines.
+        assert docstring_lines[-1] == '    """'
+
+    @pytest.mark.unit
+    def test_format_docstring_for_one_line_summary_alone_but_too_long(
+        self, monkeypatch
+    ):
+        source = '''\
+def f():
+    """This one-line docstring will not be wrapped and quotes will be
+in-line."""
+'''
+        formatted = _format_with_cli(
+            monkeypatch,
+            source,
+            "--wrap-summaries=88",
+            "--close-quotes-on-newline",
+        )
+        docstring_lines = formatted.splitlines()[1:]
+        assert len(docstring_lines) == 1  # Summary did not wrap.
+        assert docstring_lines[0].startswith('    """')
+        assert docstring_lines[0].endswith('"""')
+
 
