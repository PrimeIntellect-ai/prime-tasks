+// TestCommandValuesToEventDTO_AddsTags verifies that resource, command and device
+// tags are present in the event sent by the SDK.
+func TestCommandValuesToEventDTO_AddsTags(t *testing.T) {
+	dic := NewMockDIC()
+	edgexErr := cache.InitCache(TestDeviceService, dic)
+	require.NoError(t, edgexErr)
+
+	cv, err := sdkModels.NewCommandValue(TestDeviceResourceWithTags, common.ValueTypeString, "value")
+	require.NoError(t, err)
+
+	event, edgexErr := transformer.CommandValuesToEventDTO([]*sdkModels.CommandValue{cv}, TestDeviceWithTags, TestDeviceCommandWithTags, dic)
+	require.NoError(t, edgexErr)
+	require.NotNil(t, event)
+	require.Len(t, event.Readings, 1)
+
+	var publishedPayload []byte
+	var publishedContentType string
+	mcMock := &msgMocks.MessageClient{}
+	mcMock.On("Publish", mock.Anything, mock.Anything).Run(func(args mock.Arguments) {
+		envelope := args.Get(0).(types.MessageEnvelope)
+		publishedPayload = envelope.Payload
+		publishedContentType = envelope.ContentType
+	}).Return(nil)
+	dic.Update(di.ServiceConstructorMap{
+		bootstrapContainer.MessagingClientName: func(get di.Get) interface{} {
+			return mcMock
+		},
+	})
+	sdkCommon.InitializeSentMetrics(logger.NewMockClient(), dic)
+	sdkCommon.SendEvent(event, testUUIDString, dic)
+	mcMock.AssertNumberOfCalls(t, "Publish", 1)
+
+	var published requests.AddEventRequest
+	var decodeErr error
+	if publishedContentType == common.ContentTypeCBOR {
+		decodeErr = cbor.Unmarshal(publishedPayload, &published)
+	} else {
+		decodeErr = json.Unmarshal(publishedPayload, &published)
+	}
+	require.NoError(t, decodeErr)
+	require.Len(t, published.Event.Readings, 1)
+	// Resource tags accompany the matching reading in the outbound event.
+	assert.Equal(t, TestResourceTagValue, published.Event.Readings[0].Tags[TestResourceTagName])
+	// Command and device tags accompany the event; device tags take precedence on collisions.
+	assert.Equal(t, TestCommandTagValue, published.Event.Tags[TestCommandTagName])
+	assert.Equal(t, TestDeviceTagValue, published.Event.Tags[TestDeviceTagName])
+	assert.Equal(t, TestDeviceTagValue, published.Event.Tags[TestDuplicateTagName])
+}
