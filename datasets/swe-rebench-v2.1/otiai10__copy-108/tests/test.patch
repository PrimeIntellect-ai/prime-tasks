+func TestOptions_FS(t *testing.T) {
+	src := "test/data/case10/src"
+	backup := src + ".test-backup"
+	if err := Copy(src, backup); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.RemoveAll(src); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := Copy(backup, src); err != nil {
+			t.Errorf("restore embedded source fixture: %v", err)
+		}
+		os.RemoveAll(backup)
+	}()
+
+	dest := filepath.Join(t.TempDir(), "copied-assets")
+	file, err := assets.Open(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+
+	copyFunc := reflect.ValueOf(Copy)
+	fileValue := reflect.ValueOf(file)
+	if fileValue.Type().AssignableTo(copyFunc.Type().In(0)) {
+		results := copyFunc.Call([]reflect.Value{fileValue, reflect.ValueOf(dest)})
+		if !results[0].IsNil() {
+			err = results[0].Interface().(error)
+		}
+	} else {
+		opt := Options{}
+		field, ok := reflect.TypeOf(opt).FieldByName("FS")
+		if !ok {
+			t.Fatal("Copy must accept an opened embedded directory or an embedded filesystem option")
+		}
+		reflect.ValueOf(&opt).Elem().FieldByIndex(field.Index).Set(reflect.ValueOf(assets))
+		err = Copy(src, dest, opt)
+	}
+	Expect(t, err).ToBe(nil)
+
+	for path, want := range map[string]string{
+		"foo/text_aaa": "This is text_aaa from src",
+		"foo/text_bbb": "",
+		"bar/text_ccc": "",
+		"bar/text_ddd": "",
+	} {
+		got, err := ioutil.ReadFile(filepath.Join(dest, path))
+		Expect(t, err).ToBe(nil)
+		Expect(t, string(got)).ToBe(want)
+	}
+}
+
 type SleepyReader struct {
-	src *os.File
+	src io.Reader
 	sec time.Duration
 }
 
