diff --git a/tests/ops/qubit/test_matrix_ops.py b/tests/ops/qubit/test_matrix_ops.py
index d1b5e508..b67a0fe0 100644
--- a/tests/ops/qubit/test_matrix_ops.py
+++ b/tests/ops/qubit/test_matrix_ops.py
@@ -410,3 +410,20 @@ def test_label(op, label):
     assert op.label(decimals=5) == label
     op.inv()
     assert op.label() == label + "⁻¹"
+
+
+control_data = [
+    (qml.QubitUnitary(X, wires=0), Wires([])),
+    (qml.DiagonalQubitUnitary([1, 1], wires=1), Wires([])),
+    (qml.ControlledQubitUnitary(X, control_wires=0, wires=1), Wires([0])),
+]
+
+
+@pytest.mark.parametrize("op, control_wires", control_data)
+def test_control_wires(op, control_wires):
+    """Test ``control_wires`` attribute for matrix operations."""
+    # The public interface declares ``control_wires`` as a property, so it must
+    # be accessed directly as an attribute (not called) and return a ``Wires``.
+    cw = op.control_wires
+    assert not callable(cw)
+    assert cw == control_wires
