@@ -0,0 +1,24 @@
+use bumpalo::Bump;
+
+#[test]
+fn try_with_capacity_too_large() {
+    // Shouldn't panic even though the capacity is too large for a `Layout`;
+    // the failure is reported through the returned `Result`.
+    let result = Bump::try_with_capacity(isize::MAX as usize + 1);
+    assert!(result.is_err());
+}
+
+#[test]
+fn try_with_capacity_replay_value() {
+    // The capacity from the original report is larger than `isize::MAX`, so it
+    // cannot be represented as a `Layout` and must be reported as an error
+    // rather than panicking.
+    let result = Bump::try_with_capacity(10995706271387654244);
+    assert!(result.is_err());
+}
+
+#[test]
+fn try_with_capacity_representable() {
+    // A representable capacity is accepted.
+    assert!(Bump::try_with_capacity(100).is_ok());
+}
