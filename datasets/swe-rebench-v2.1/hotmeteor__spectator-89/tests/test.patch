+    public function test_handles_query_parameters_int()
+    {
+        Spectator::using('Test.v1.json');
+
+        // When testing query parameters, they are not found nor checked by RequestValidator->validateParameters().
+        Route::get('/users-by-id/{user}', function (int $user) {
+            return [];
+        })->middleware(Middleware::class);
+
+        $this->getJson('/users-by-id/1')
+            ->assertValidRequest();
+    }
+
+    public function test_validates_path_parameters_against_their_schemas()
+    {
+        Spectator::using('Test.v1.json');
+
+        Route::get('/users-by-name/{name}', function ($name) {
+            return [];
+        })->middleware(Middleware::class);
+
+        $this->getJson('/users-by-name/not-jim')
+            ->assertInvalidRequest();
+    }
+
+    public function test_rejects_non_integer_path_parameter_for_integer_schema()
+    {
+        Spectator::using('Test.v1.json');
+
+        Route::get('/users-by-id/{user}', function ($user) {
+            return [];
+        })->middleware(Middleware::class);
+
