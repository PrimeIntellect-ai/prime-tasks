+    def test_dict_keys(self):
+        keys = {"a": 1, "b": 2}.keys()
+        results = pickle_depickle(keys)
+        self.assertEqual(results, keys)
+        assert isinstance(results, _collections_abc.dict_keys)
+
+        # An empty view must round-trip as well.
+        empty_keys = {}.keys()
+        results = pickle_depickle(empty_keys)
+        self.assertEqual(list(results), list(empty_keys))
+        assert isinstance(results, _collections_abc.dict_keys)
