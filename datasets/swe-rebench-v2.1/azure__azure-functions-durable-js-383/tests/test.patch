+    describe("signalEntity()", () => {
+        it("schedules a SignalEntity action", () => {
+            const orchestrator = TestOrchestrations.signalEntity;
+            const entityName = "Counter";
+            const id = "1234";
+            const expectedEntity = new EntityId(entityName, id);
+            const operationName = "add";
+            const operationArgument = 1;
+            const mockContext = new MockContext({
+                context: new DurableOrchestrationBindingInfo(
+                    TestHistories.GetOrchestratorStart("signalEntity", new Date()),
+                    {
+                        id,
+                        entityName,
+                        operationName,
+                        operationArgument,
+                    }
+                ),
+            });
+
+            orchestrator(mockContext);
+
+            expect(mockContext.err).to.be.undefined;
+            const state = mockContext.doneValue;
+            expect(state).to.not.be.undefined;
+            expect(state!.isDone).to.equal(true);
+            expect(state!.actions.length).to.equal(1);
+            const action = state!.actions[0][0] as any;
+            expect(action.instanceId).to.equal(EntityId.getSchedulerIdFromEntityId(expectedEntity));
+            expect(action.operation).to.equal(operationName);
+            expect(action.input).to.equal(operationArgument);
+        });
+
+        it("schedules a signal without an optional input", () => {
+            const orchestrator = TestOrchestrations.signalEntityWithoutInput;
+            const expectedEntity = new EntityId("Counter", "1234");
+            const mockContext = new MockContext({
+                context: new DurableOrchestrationBindingInfo(
+                    TestHistories.GetOrchestratorStart("signalEntity", new Date()),
+                    { id: "1234", entityName: "Counter", operationName: "reset" }
+                ),
+            });
+
+            orchestrator(mockContext);
+
+            expect(mockContext.err).to.be.undefined;
+            const state = mockContext.doneValue;
+            expect(state).to.not.be.undefined;
+            expect(state!.isDone).to.equal(true);
+            expect(state!.actions.length).to.equal(1);
+            const action = state!.actions[0][0] as any;
+            expect(action.instanceId).to.equal(EntityId.getSchedulerIdFromEntityId(expectedEntity));
+            expect(action.operation).to.equal("reset");
+        });
+    });
+
