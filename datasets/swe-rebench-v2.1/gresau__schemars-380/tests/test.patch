diff --git a/schemars/tests/ui/invalid_attrs.rs b/schemars/tests/ui/invalid_attrs.rs
index 0eea93b..4a375df 100644
--- a/schemars/tests/ui/invalid_attrs.rs
+++ b/schemars/tests/ui/invalid_attrs.rs
@@ -1,11 +1,89 @@
+#![allow(unexpected_cfgs)]
+
 use schemars::JsonSchema;
 
+#[cfg(not(rebench_runtime))]
 #[derive(JsonSchema)]
-#[serde(default = 0, foo, deny_unknown_fields, deny_unknown_fields)]
+#[serde(
+    default = 0,
+    foo,
+    deny_unknown_fields,
+    deny_unknown_fields
+)]
 pub struct Struct1;
 
+#[cfg(not(rebench_runtime))]
 #[derive(JsonSchema)]
-#[schemars(default = 0, foo, deny_unknown_fields, deny_unknown_fields)]
+#[schemars(
+    default = 0,
+    foo,
+    deny_unknown_fields,
+    deny_unknown_fields
+)]
 pub struct Struct2;
 
-fn main() {}
+#[cfg(not(rebench_runtime))]
+#[derive(JsonSchema)]
+#[schemars(inline)]
+pub struct Struct3;
+
+#[cfg(rebench_runtime)]
+#[derive(JsonSchema)]
+#[schemars(inline)]
+pub struct InlineStruct;
+
+#[cfg(rebench_runtime)]
+#[derive(JsonSchema)]
+pub struct Unmarked;
+
+#[cfg(rebench_runtime)]
+#[derive(JsonSchema)]
+#[schemars(inline)]
+pub struct InlineType {
+    pub value: i32,
+}
+
+#[cfg(rebench_runtime)]
+#[derive(JsonSchema)]
+pub struct Parent {
+    pub child: InlineType,
+}
+
+#[cfg(rebench_runtime)]
+#[derive(JsonSchema)]
+#[schemars(inline)]
+pub enum InlineEnum {
+    Variant,
+}
+
+#[cfg(rebench_runtime)]
+#[derive(JsonSchema)]
+pub enum UnmarkedEnum {
+    Variant,
+}
+
+#[cfg(rebench_runtime)]
+#[derive(JsonSchema)]
+pub struct ParentEnum {
+    pub child: InlineEnum,
+}
+
+fn main() {
+    #[cfg(rebench_runtime)]
+    {
+        assert!(InlineStruct::always_inline_schema());
+        assert!(!Unmarked::always_inline_schema());
+        assert!(InlineEnum::always_inline_schema());
+        assert!(!UnmarkedEnum::always_inline_schema());
+
+        let schema = schemars::schema_for!(Parent);
+        let child = &schema.as_value()["properties"]["child"];
+        assert!(child.get("$ref").is_none());
+        assert!(child.get("properties").is_some());
+
+        let schema = schemars::schema_for!(ParentEnum);
+        let child = &schema.as_value()["properties"]["child"];
+        assert!(child.get("$ref").is_none());
+        assert!(child.get("enum").is_some());
+    }
+}
