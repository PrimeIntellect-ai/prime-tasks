 from rich.text import Span, Text
 
 
+def rendered_style_at(text: Text, offset: int) -> Style:
+    for segment in Console().render(text):
+        if offset < len(segment.text):
+            return segment.style or Style()
+        offset -= len(segment.text)
+    raise AssertionError("text offset is outside rendered content")
+
