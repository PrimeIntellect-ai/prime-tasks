+
+    @testset "Issue 387" begin
+        # reported regression case: exact input triple from the issue
+        let a = 1.0e-20, p = 1.0, q = 7.756625260915455e-21
+            x = gamma_inc_inv(a, p, q)
+            @test isfinite(x)
+            p2, q2 = gamma_inc(a, x)
+            @test p2 ≈ p
+            @test q2 ≈ q
+        end
+        @testset "a=$a" for a in exp10.(range(-20, stop=20, length=1000))
+            @testset "x=$x" for x in exp10.(range(-20, stop=2, length=1000))
+                p, q = gamma_inc(a, x)
+                x2 = gamma_inc_inv(a, p, q)
+                @test isfinite(x2)
+                if p >= floatmin() && q >= floatmin()
+                    p2, q2 = gamma_inc(a, x2)
+                    @test p2 ≈ p
+                    @test q2 ≈ q
+                end
+            end
+        end
+    end
 end
 
