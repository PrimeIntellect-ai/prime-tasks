         """
         @test fmt(s, 4, 92, align_assignment = true) == s
     end
+
+    @testset "655" begin
+        # the semicolon in a vertical concatenation must be retained;
+        # whitespace and indentation are not part of the requirement
+        squash(x) = replace(x, r"\s" => "")
+        s = """
+        [
+          a;
+        ]
+        """
+        out = fmt(s, 2, 92, join_lines_based_on_source = true)
+        @test squash(out) == "[a;]"
+        out = fmt(s, 2, 1)
+        @test squash(out) == "[a;]"
+        s = """
+        [
+          a
+        ]
+        """
+        out = fmt(s, 2, 92, join_lines_based_on_source = true, trailing_comma = nothing)
+        @test squash(out) == "[a]"
+        out = fmt(s, 2, 1, trailing_comma = nothing)
+        @test squash(out) == "[a]"
+    end
 end
