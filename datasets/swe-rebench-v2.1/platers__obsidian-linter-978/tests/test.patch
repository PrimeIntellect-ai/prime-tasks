diff --git a/__tests__/blockquote-style.test.ts b/__tests__/blockquote-style.test.ts
index fccf64f..c0d3567 100644
--- a/__tests__/blockquote-style.test.ts
+++ b/__tests__/blockquote-style.test.ts
@@ -1,4 +1,5 @@
 import BlockquoteStyle from '../src/rules/blockquote-style';
+import TrailingSpaces from '../src/rules/trailing-spaces';
 import dedent from 'ts-dedent';
 import {ruleTest} from './common';
 
@@ -45,5 +46,77 @@ ruleTest({
       `,
       options: {style: 'space'},
     },
+    { // accounts for https://github.com/platers/obsidian-linter/issues/961
+      testName: 'Multiple spaces after a blockquote indicator should be removed except when dealing with list mark lines when `style=no space`',
+      before: dedent`
+        >   Text here
+        >   - List item 1
+        >\t * List item 2
+        >   + List item 3
+        >   1. Ordered item 1
+        >   2) Ordered item 2
+        >   - [ ] Checklist item
+        >- List item 4
+        > >  >   \t > - List item 5
+        > >  >   \t > > - List item 6
+      `,
+      after: dedent`
+        >Text here
+        >   - List item 1
+        >\t * List item 2
+        >   + List item 3
+        >   1. Ordered item 1
+        >   2) Ordered item 2
+        >   - [ ] Checklist item
+        >- List item 4
+        >>>> - List item 5
+        >>>>> - List item 6
+      `,
+      options: {style: 'no space'},
+    },
   ],
 });
+
+describe('Blockquote Style', () => {
+  const rule = BlockquoteStyle.getRule();
+
+  it('Multiple spaces after a blockquote indicator is not converted into one space when it is a list item or checklist line when `style=space`', () => {
+    const before = dedent`
+      >   Text here
+      >   - List item 1
+      >\t * List item 2
+      >   + List item 3
+      >   1. Ordered item 1
+      >   2) Ordered item 2
+      >   - [ ] Checklist item
+      >- List item 4
+    `;
+    const after = rule.apply(before, {style: 'space'});
+    const lines = after.split('\n');
+
+    // a regular blockquote line is normalized to a single space after the indicator
+    expect(lines[0]).toBe('> Text here');
+
+    // list and checklist lines keep their list marker and are separated from the
+    // blockquote indicator by at least one space. The contract only requires a
+    // single space after the blockquote marker, so the exact amount of indentation
+    // before the list marker is intentionally not asserted here.
+    expect(lines[1]).toMatch(/^> [ \t]*- List item 1$/);
+    expect(lines[2]).toMatch(/^> [ \t]*\* List item 2$/);
+    expect(lines[3]).toMatch(/^> [ \t]*\+ List item 3$/);
+    expect(lines[4]).toMatch(/^> [ \t]*1\. Ordered item 1$/);
+    expect(lines[5]).toMatch(/^> [ \t]*2\) Ordered item 2$/);
+    expect(lines[6]).toMatch(/^> [ \t]*- \[ \] Checklist item$/);
+    expect(lines[7]).toBe('> - List item 4');
+  });
+});
+
+describe('Trailing Spaces', () => {
+  const rule = TrailingSpaces.getRule();
+
+  it('A blockquote indicator followed only by whitespace is trimmed', () => {
+    expect(rule.apply('>   ', {})).toBe('>');
+    expect(rule.apply('> ', {})).toBe('>');
+    expect(rule.apply('>   \n> text', {})).toBe('>\n> text');
+  });
+});
