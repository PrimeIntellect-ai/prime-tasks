index 9dff826..d84ddb1 100644
--- a/arch/tests/univariate/test_mean.py
+++ b/arch/tests/univariate/test_mean.py
@@ -1370,3 +1370,21 @@ def test_non_contiguous_input(use_numpy):
     mod = arch_model(y, mean="Zero")
     res = mod.fit()
     assert res.params.shape[0] == 3
+
+
+def test_fixed_arx_exog_forecast_variance():
+    y = np.array([0, 7, 2, 5, 9, 3, 8], dtype=float)
+    x = np.arange(7, dtype=float)
+    mod = arch_model(
+        y=y, x=x, mean="ARX", vol="GARCH", lags=1, p=1, q=0, rescale=False
+    )
+    y_coeff, x_coeff, volatility_coeff, start = 0.3, 0.2, 0.5, 1
+    res = mod.fix([0.0, y_coeff, x_coeff, 0.0, volatility_coeff])
+    forecast = res.forecast(
+        horizon=1, start=start, method="analytic", x=x[:, None], align="origin"
+    )
+
+    observed_variance = np.asarray(forecast.variance).squeeze()
+    residuals = np.asarray(res.resid)
+    expected_variance = volatility_coeff * residuals[start:] ** 2
+    assert_allclose(observed_variance, expected_variance)
