+func TestAddressListFromEncodedColonDisplayName(t *testing.T) {
+	message := "From: =?utf-8?Q?re=3AStore=20?=\r\n" +
+		" =?utf-8?Q?Apple=20?=\r\n" +
+		" =?utf-8?Q?Premium=20?=\r\n" +
+		" =?utf-8?Q?Reseller?= <noreply@mail.restore.ru>\r\n\r\n"
+	env, err := ReadEnvelope(strings.NewReader(message))
+	if err != nil {
+		t.Fatalf("Failed to read message: %v", err)
+	}
+
+	addresses, err := env.AddressList("From")
+	if err != nil {
+		t.Fatalf("Failed to parse From address: %v", err)
+	}
+	if len(addresses) != 1 {
+		t.Fatalf("Got %d From addresses, want 1", len(addresses))
+	}
+	if addresses[0].Address != "noreply@mail.restore.ru" {
+		t.Errorf("Got address %q, want %q", addresses[0].Address, "noreply@mail.restore.ru")
+	}
+	if addresses[0].Name != "re:Store Apple Premium Reseller" {
+		t.Errorf("Got display name %q, want %q", addresses[0].Name, "re:Store Apple Premium Reseller")
+	}
+}
