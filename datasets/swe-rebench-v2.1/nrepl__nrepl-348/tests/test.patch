 (ns nrepl.transport-test
   (:require [nrepl.transport :as sut]
             [clojure.test :refer [deftest testing is]])
-  (:import [java.io ByteArrayOutputStream]))
+  (:import (java.io BufferedInputStream BufferedOutputStream
+                    ByteArrayInputStream ByteArrayOutputStream)))
 
 (deftest bencode-safe-write-test
   (testing "safe-write-bencode only writes if the whole message is writable"
@@ -21,3 +22,26 @@
                (.recv fn-transport)     ;; :op "clone"
                (-> (.recv fn-transport) ;; :op "eval"
                    :code)))))))
+
+(deftest malformed-bencode-input-test
+  (let [recv-error (fn [bytes]
+                     (let [in (-> (.getBytes bytes)
+                                  ByteArrayInputStream.
+                                  BufferedInputStream.)
+                           out (BufferedOutputStream. (ByteArrayOutputStream.))]
+                       (try
+                         (sut/recv (sut/bencode in out))
+                         (catch Throwable error
+                           error))))
+        assert-useful-error (fn [bytes]
+                              (let [error (recv-error bytes)
+                                    message (when (instance? Throwable error)
+                                              (ex-message error))]
+                                (is (instance? Throwable error))
+                                (is (seq message))
+                                (is (not (re-find #"(?i)long overflow" (or message ""))))))]
+    (testing "if non-bencode input is passed, report a useful error"
+      (assert-useful-error "123456789123456789123456789"))
+
+    (testing "if top-level message is not a map, report a useful error"
+      (assert-useful-error "li1ei2ei3ee"))))
