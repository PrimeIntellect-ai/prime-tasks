 class TestUtils(BaseTest):
+    def test_compound_children_preserve_order_and_membership(self):
+        parent = mb.Compound(name="parent")
+        first = mb.Compound(name="first")
+        second = mb.Compound(name="second")
+
+        parent.add(first)
+        parent.add(second)
+
+        assert len(parent.children) == 2
+        assert first in parent.children
+        assert list(parent.children) == [first, second]
+
+        parent.remove(first)
+
+        assert first not in parent.children
+        assert list(parent.children) == [second]
+
+    def test_environment_does_not_depend_on_oset(self):
+        repository = Path(__file__).resolve().parents[2]
+        for filename in ("environment.yml", "environment-dev.yml", "environment-win.yml"):
+            contents = (repository / filename).read_text()
+            declared_packages = [
+                line
+                for line in contents.splitlines()
+                if re.match(r"\s*-\s*oset(?:\s|[<>=!]|$)", line, re.IGNORECASE)
+            ]
+            assert not declared_packages, filename
+
+    def test_import_does_not_warn_about_deprecated_collections(self):
+        result = subprocess.run(
+            [sys.executable, "-W", "always::DeprecationWarning", "-c", "import mbuild"],
+            capture_output=True,
+            text=True,
+            check=True,
+        )
+        deprecated_abc_warning = re.compile(
+            r"using or importing the abcs from ['\"]?collections['\"]? "
+            r"instead of (?:from )?['\"]?collections\.abc['\"]? is deprecated",
+            re.IGNORECASE,
+        )
+        assert not deprecated_abc_warning.search(result.stderr)
+
