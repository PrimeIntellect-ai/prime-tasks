+
+    def test_json_search_link(self, requests_mock) -> None:
+        root_url = STAC_URLS["PLANETARY-COMPUTER"]
+        root = read_data_file("planetary-computer-root.json", parse_json=True)
+        root.pop("conformsTo", None)
+        search_link = next(link for link in root["links"] if link["rel"] == "search")
+        search_link["type"] = MediaType.JSON
+        requests_mock.get(root_url, json=root)
+
+        search_url = search_link["href"]
+        requests_mock.post(
+            search_url,
+            json={
+                "type": "FeatureCollection",
+                "stac_version": "1.0.0",
+                "features": [
+                    {
+                        "type": "Feature",
+                        "stac_version": "1.0.0",
+                        "id": "legacy-api-result",
+                        "geometry": None,
+                        "properties": {"datetime": "2020-01-01T00:00:00Z"},
+                        "links": [],
+                        "assets": {},
+                    }
+                ],
+                "links": [],
+            },
+        )
+
+        client = Client.open(root_url)
+        search = client.search(limit=1, max_items=1, collections="naip")
+        items = list(search.get_items())
+
+        assert [item.id for item in items] == ["legacy-api-result"]
+        request = requests_mock.request_history[-1]
+        assert request.url == search_url
+        assert request.json()["collections"] == ["naip"]
+        assert request.json()["limit"] == 1
