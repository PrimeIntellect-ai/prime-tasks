diff --git a/strum_tests/tests/suffix.rs b/strum_tests/tests/suffix.rs
new file mode 100644
index 0000000..05f0619
--- /dev/null
+++ b/strum_tests/tests/suffix.rs
@@ -0,0 +1,63 @@
+use strum::{Display, EnumString};
+use strum_macros::AsRefStr;
+
+#[allow(dead_code)]
+#[derive(Debug, PartialEq, EnumString, Display, AsRefStr)]
+#[strum(suffix = ".color")]
+enum Color {
+    #[strum(to_string = "RedRed")]
+    Red,
+    #[strum(serialize = "b", to_string = "blue")]
+    Blue { hue: usize },
+    #[strum(serialize = "y", serialize = "yellow")]
+    Yellow,
+    #[strum(default)]
+    Green(String),
+}
+
+#[test]
+fn suffix_redred() {
+    let c = Color::Red;
+    assert_eq!(String::from("RedRed.color"), c.to_string());
+    assert_eq!("RedRed.color", c.as_ref());
+}
+
+#[test]
+fn suffix_blue() {
+    let c = Color::Blue { hue: 10 };
+    assert_eq!(String::from("blue.color"), c.to_string());
+    assert_eq!("blue.color", c.as_ref());
+}
+
+#[test]
+fn suffix_yellow() {
+    let c = Color::Yellow;
+    assert_eq!(String::from("yellow.color"), c.to_string());
+    assert_eq!("yellow.color", c.as_ref());
+}
+
+#[test]
+fn suffix_green_default() {
+    let c = Color::Green("basic-green".into());
+    assert_eq!("Green.color", c.as_ref());
+}
+
+#[test]
+fn suffix_does_not_affect_from_str() {
+    use std::str::FromStr;
+
+    assert_eq!(Color::Red, Color::from_str("RedRed").unwrap());
+    assert_eq!(Color::Blue { hue: 0 }, Color::from_str("b").unwrap());
+    assert_eq!(Color::Blue { hue: 0 }, Color::from_str("blue").unwrap());
+    assert_eq!(Color::Yellow, Color::from_str("y").unwrap());
+    assert_eq!(Color::Yellow, Color::from_str("yellow").unwrap());
+}
+
+#[test]
+fn suffix_does_not_affect_try_from() {
+    assert_eq!(Color::Red, Color::try_from("RedRed").unwrap());
+    assert_eq!(Color::Blue { hue: 0 }, Color::try_from("b").unwrap());
+    assert_eq!(Color::Blue { hue: 0 }, Color::try_from("blue").unwrap());
+    assert_eq!(Color::Yellow, Color::try_from("y").unwrap());
+    assert_eq!(Color::Yellow, Color::try_from("yellow").unwrap());
+}
