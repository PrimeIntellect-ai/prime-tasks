diff --git a/test/management/guardian.tests.js b/test/management/guardian.tests.js
new file mode 100644
index 0000000..fe9ca34
--- /dev/null
+++ b/test/management/guardian.tests.js
@@ -0,0 +1,109 @@
+var expect = require('chai').expect;
+var nock = require('nock');
+
+var SRC_DIR = '../../src';
+var API_URL = 'https://tenants.auth0.com';
+var ManagementClient = require(SRC_DIR + '/management');
+
+describe('ManagementClient Guardian enrollment operations', function() {
+  beforeEach(function() {
+    this.token = 'TOKEN';
+    this.management = new ManagementClient({ domain: 'tenants.auth0.com', token: this.token });
+    this.enrollmentId = 'dev_0000000000000001';
+  });
+
+  describe('#getGuardianEnrollment', function() {
+    it('retrieves the enrollment from the API', function(done) {
+      var data = { id: this.enrollmentId, status: 'pending' };
+      var request = nock(API_URL)
+        .get('/api/v2/guardian/enrollments/' + this.enrollmentId)
+        .matchHeader('Authorization', 'Bearer ' + this.token)
+        .reply(200, data);
+
+      this.management.getGuardianEnrollment({ id: this.enrollmentId }, function(err, enrollment) {
+        expect(err).to.not.exist;
+        expect(enrollment).to.deep.equal(data);
+        expect(request.isDone()).to.equal(true);
+        done();
+      });
+    });
+
+    it('passes API errors to the callback', function(done) {
+      var request = nock(API_URL)
+        .get('/api/v2/guardian/enrollments/' + this.enrollmentId)
+        .reply(500);
+
+      this.management.getGuardianEnrollment({ id: this.enrollmentId }, function(err) {
+        expect(err).to.exist;
+        expect(request.isDone()).to.equal(true);
+        done();
+      });
+    });
+
+    it('returns a promise resolving to the enrollment', function() {
+      var data = { id: this.enrollmentId, status: 'pending' };
+      nock(API_URL).get('/api/v2/guardian/enrollments/' + this.enrollmentId).reply(200, data);
+
+      return this.management.getGuardianEnrollment({ id: this.enrollmentId }).then(function(enrollment) {
+        expect(enrollment).to.deep.equal(data);
+      });
+    });
+
+    it('rejects the promise when the API request fails', function() {
+      nock(API_URL).get('/api/v2/guardian/enrollments/' + this.enrollmentId).reply(500);
+
+      return this.management.getGuardianEnrollment({ id: this.enrollmentId }).then(function() {
+        throw new Error('Expected the request to reject');
+      }, function(err) {
+        expect(err).to.exist;
+      });
+    });
+  });
+
+  describe('#deleteGuardianEnrollment', function() {
+    it('deletes the enrollment from the API', function(done) {
+      var request = nock(API_URL)
+        .delete('/api/v2/guardian/enrollments/' + this.enrollmentId)
+        .matchHeader('Authorization', 'Bearer ' + this.token)
+        .reply(200);
+
+      this.management.deleteGuardianEnrollment({ id: this.enrollmentId }, function(err) {
+        expect(err).to.not.exist;
+        expect(request.isDone()).to.equal(true);
+        done();
+      });
+    });
+
+    it('passes API errors to the callback', function(done) {
+      var request = nock(API_URL)
+        .delete('/api/v2/guardian/enrollments/' + this.enrollmentId)
+        .reply(500);
+
+      this.management.deleteGuardianEnrollment({ id: this.enrollmentId }, function(err) {
+        expect(err).to.exist;
+        expect(request.isDone()).to.equal(true);
+        done();
+      });
+    });
+
+    it('returns a promise when no callback is supplied', function() {
+      var request = nock(API_URL)
+        .delete('/api/v2/guardian/enrollments/' + this.enrollmentId)
+        .reply(200);
+
+      return this.management.deleteGuardianEnrollment({ id: this.enrollmentId }).then(function() {
+        expect(request.isDone()).to.equal(true);
+      });
+    });
+
+    it('rejects the promise when the API request fails', function() {
+      nock(API_URL).delete('/api/v2/guardian/enrollments/' + this.enrollmentId).reply(500);
+
+      return this.management.deleteGuardianEnrollment({ id: this.enrollmentId }).then(function() {
+        throw new Error('Expected the request to reject');
+      }, function(err) {
+        expect(err).to.exist;
+      });
+    });
+  });
+});
