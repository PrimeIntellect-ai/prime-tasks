+func newGitHubPullRequestCompat(cli *github.Client, owner, repo string, pr int, sha, level, toolName string) (*PullRequest, error) {
+	constructor := reflect.ValueOf(NewGitHubPullRequest)
+	args := []reflect.Value{
+		reflect.ValueOf(cli), reflect.ValueOf(owner), reflect.ValueOf(repo),
+		reflect.ValueOf(pr), reflect.ValueOf(sha), reflect.ValueOf(level),
+	}
+	if constructor.Type().NumIn() > len(args) {
+		args = append(args, reflect.ValueOf(toolName))
+	}
+	result := constructor.Call(args)
+	var err error
+	if !result[1].IsNil() {
+		err = result[1].Interface().(error)
+	}
+	return result[0].Interface().(*PullRequest), err
+}
