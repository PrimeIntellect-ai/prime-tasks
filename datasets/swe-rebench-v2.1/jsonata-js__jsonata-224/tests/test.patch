+        });
+
+        it("should use a function registered with registerFunction directly as a matcher", function() {
+            var matcher = function(str, offset) {
+                var pos = str.indexOf("ab", (offset || 0));
+                if (pos === -1) {
+                    return;
+                } else {
+                    return {
+                        match: "ab",
