+                        groups: [],
+                        next: function () {
+                            return matcher(str, pos + 2);
+                        }
+                    };
+                }
+            };
+            var expr = jsonata("$match('abracadabra', $myMatcher)");
+            expr.registerFunction("myMatcher", matcher);
