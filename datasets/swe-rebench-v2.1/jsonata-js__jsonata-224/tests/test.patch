+            expr.registerFunction("repeatingLetters", repeatingLetters);
+            var result = expr.evaluate();
+            var expected = "ỺANFAIRPWỺGWYNGYỺGOGERYCHWYRNDROBWỺỺANTYSILIOGOGOGOCH";
