index 0000000..7a8162f
--- /dev/null
+++ b/tests/bugs/issue775.js
@@ -0,0 +1,213 @@
+'use strict';
+var util = require('../lib/test-utils.js');
+var expect = require('chai').expect;
+
+describe('fs.readdir fails when passing options, issue775', function () {
+  beforeEach(util.setup);
+  afterEach(util.cleanup);
+
+  function setup(fs, dir, cb) {
+    fs.mkdir(dir, undefined, (err) => {
+      if (err) {
+        cb(err);
+      }
+      else {
+        fs.writeFile(dir + '/file', '', (err) => {
+          if (err) {
+            cb(err);
+          }
+          else {
+            fs.mkdir(dir + '/folder', (err) => {
+              if (err) {
+                cb(err);
+              }
+              else {
+                fs.symlink(dir + '/file', dir + '/symlink', (err) => {
+                  if (err) {
+                    cb(err);
+                  }
+                  else {
+                    cb();
+                  }
+                });
+              }
+            });
+          }
+        });
+      }
+    });
+  }
+
+  // Directory enumeration order is not part of the contract, so compare the
+  // set of entry names rather than their positions.
+  function sortedNames(entries) {
+    return entries.map(function (entry) {
+      return entry.toString();
+    }).sort();
+  }
+
+  function byName(entries) {
+    var map = {};
+    entries.forEach(function (entry) {
+      map[entry.name] = entry;
+    });
+    return map;
+  }
+
+  it('should create a directory, add a file, folder and symbolic link then call fs.readdir with buffer encoding', function (done) {
+    var fs = util.fs();
+    setup(fs, '/test_dir', (err) => {
+      if (err) {
+        done(err);
+      }
+      fs.readdir('/test_dir', 'buffer', (err, data) => {
+        if (err) {
+          done(err);
+        }
+        else {
+          expect(data).to.have.length(3);
+          data.forEach(function (entry) {
+            expect(Buffer.isBuffer(entry)).to.be.true;
+          });
+          expect(sortedNames(data)).to.deep.equal(['file', 'folder', 'symlink']);
+
+          done();
+        }
+      });
+    });
+  });
+
+  it('should create a directory, add a file, folder and symbolic link then call fs.readdir with withFileTypes option', function (done) {
+    var fs = util.fs();
+    setup(fs, '/test_dir', (err) => {
+      if (err) {
+        done(err);
+      }
+      fs.readdir('/test_dir', { withFileTypes: true }, (err, data) => {
+        if (err) {
+          done(err);
+        }
+        else {
+          expect(data).to.have.length(3);
+
+          var entries = byName(data);
+          expect(Object.keys(entries).sort()).to.deep.equal(['file', 'folder', 'symlink']);
+
+          expect(entries.file.isFile()).to.be.true;
+          expect(entries.folder.isDirectory()).to.be.true;
+          expect(entries.symlink.isSymbolicLink()).to.be.true;
+
+          done();
+        }
+      });
+    });
+  });
+
+  it('should encode entry names using the requested encoding', function (done) {
+    var fs = util.fs();
+    setup(fs, '/test_dir', (err) => {
+      if (err) {
+        done(err);
+      }
+      fs.readdir('/test_dir', 'hex', (err, data) => {
+        if (err) {
+          done(err);
+        }
+        else {
+          expect(data).to.have.length(3);
+
+          var expected = ['file', 'folder', 'symlink'].map(function (name) {
+            return Buffer.from(name).toString('hex');
+          }).sort();
+          expect(data.slice().sort()).to.deep.equal(expected);
+
+          done();
+        }
+      });
+    });
+  });
+
+  it('should create a directory then call fs.readdir without options', function (done) {
+    var fs = util.fs();
+    setup(fs, '/test_dir', (err) => {
+      if (err) {
+        done(err);
+      }
+      else {
+        fs.readdir('/test_dir', (err, data) => {
+          if (err) {
+            done(err);
+          }
+          else {
+            expect(data).to.have.length(3);
+            expect(sortedNames(data)).to.deep.equal(['file', 'folder', 'symlink']);
+
+            done();
+          }
+        });
+      }
+    });
+  });
+
+  it('should support fs.promises.readdir with an options object', function (done) {
+    var fs = util.fs();
+    setup(fs, '/test_dir', (err) => {
+      if (err) {
+        return done(err);
+      }
+      fs.promises.readdir('/test_dir', { withFileTypes: true })
+        .then(function (data) {
+          expect(data).to.have.length(3);
+
+          var entries = byName(data);
+          expect(Object.keys(entries).sort()).to.deep.equal(['file', 'folder', 'symlink']);
+
+          expect(entries.file.isFile()).to.be.true;
+          expect(entries.folder.isDirectory()).to.be.true;
+          expect(entries.symlink.isSymbolicLink()).to.be.true;
+
+          done();
+        })
+        .catch(done);
+    });
+  });
+
+  it('should support fs.promises.readdir with a buffer encoding option', function (done) {
+    var fs = util.fs();
+    setup(fs, '/test_dir', (err) => {
+      if (err) {
+        return done(err);
+      }
+      fs.promises.readdir('/test_dir', { encoding: 'buffer' })
+        .then(function (data) {
+          expect(data).to.have.length(3);
+          data.forEach(function (entry) {
+            expect(Buffer.isBuffer(entry)).to.be.true;
+          });
+          expect(sortedNames(data)).to.deep.equal(['file', 'folder', 'symlink']);
+
+          done();
+        })
+        .catch(done);
+    });
+  });
+
+  it('should support fs.promises.readdir with a string encoding option', function (done) {
+    var fs = util.fs();
+    setup(fs, '/test_dir', (err) => {
+      if (err) {
+        return done(err);
+      }
+      fs.promises.readdir('/test_dir', 'buffer')
+        .then(function (data) {
+          expect(data).to.have.length(3);
+          data.forEach(function (entry) {
+            expect(Buffer.isBuffer(entry)).to.be.true;
+          });
+          expect(sortedNames(data)).to.deep.equal(['file', 'folder', 'symlink']);
+          done();
+        })
+        .catch(done);
+    });
+  });
+});
