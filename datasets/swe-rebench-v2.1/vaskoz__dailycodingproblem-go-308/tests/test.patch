+package day144
+
+import "testing"
+
+var testcases = []struct {
+	nums        []int
+	targetIndex int
+}{
+	{[]int{4, 1, 3, 5, 6}, 0},
+	{[]int{4, 1, 3, 5, 6}, 4},
+	{[]int{4, 1, 3, 5, 6}, 1},
+}
+
+func assertClosestLarger(t *testing.T, nums []int, targetIndex int) {
+	t.Helper()
+	result := ClosestLargerNumberIndexBrute(nums, targetIndex)
+	target := nums[targetIndex]
+	hasLarger := false
+	for _, value := range nums {
+		if value > target {
+			hasLarger = true
+			break
+		}
+	}
+	if !hasLarger {
+		if result >= 0 && result < len(nums) {
+			t.Fatalf("expected a no-result value, got index %d", result)
+		}
+		return
+	}
+	if result < 0 || result >= len(nums) {
+		t.Fatalf("expected an index of a larger value, got no-result value %d", result)
+	}
+	if nums[result] <= target {
+		t.Fatalf("result index %d has value %d, which is not larger than target value %d", result, nums[result], target)
+	}
+	resultDistance := result - targetIndex
+	if resultDistance < 0 {
+		resultDistance = -resultDistance
+	}
+	for i, value := range nums {
+		if value > target {
+			distance := i - targetIndex
+			if distance < 0 {
+				distance = -distance
+			}
+			if distance < resultDistance {
+				t.Fatalf("result index %d is farther than larger value at index %d", result, i)
+			}
+		}
+	}
+}
+
+func TestClosestLargerNumberIndexBrute(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		assertClosestLarger(t, tc.nums, tc.targetIndex)
+	}
+}
+
+func TestClosestLargerNumberIndexBruteGeneralInputs(t *testing.T) {
+	t.Parallel()
+	cases := []struct {
+		nums        []int
+		targetIndex int
+	}{
+		{[]int{10, 1, 2, 3, 4}, 2},
+		{[]int{1, 5, 2, 8, 3, 7}, 2},
+		{[]int{6, 1, 0, 1, 5}, 2},
+		{[]int{2, 1, 4, 0, 9}, 3},
+	}
+	for _, tc := range cases {
+		assertClosestLarger(t, tc.nums, tc.targetIndex)
+	}
+}
+
+func TestClosestLargerNumberIndexBruteNoLargerValue(t *testing.T) {
+	t.Parallel()
+	cases := []struct {
+		nums        []int
+		targetIndex int
+	}{
+		{[]int{5, 4, 3, 2}, 0},
+		{[]int{1, 1, 1}, 1},
+	}
+	for _, tc := range cases {
+		assertClosestLarger(t, tc.nums, tc.targetIndex)
+	}
+}
+
+func BenchmarkClosestLargerNumberIndexBrute(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			ClosestLargerNumberIndexBrute(tc.nums, tc.targetIndex)
+		}
+	}
+}
