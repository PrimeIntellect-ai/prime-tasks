     @test constant_term(atan(sin(3pi/4+tsquare), cos(3pi/4+tsquare))) == 3pi/4
     @test atan(sin(3pi/4+tsquare)/cos(3pi/4+tsquare)) - atan(sin(3pi/4+tsquare), cos(3pi/4+tsquare)) == -pi
 
+    @test sinh(asinh(tsquare)) ≈ tsquare
+    @test tanh(atanh(tsquare)) ≈ tsquare
+    @test atanh(tanh(tsquare)) ≈ tsquare
+    @test asinh(t) ≈ log(t + sqrt(t^2 + 1))
+    @test cosh(asinh(t)) ≈ sqrt(t^2 + 1)
+
+    t_complex = Taylor1(Complex{Int}, 15) # for use with acosh, which in the Reals is only defined for x ≥ 1
+    @test cosh(acosh(t_complex)) ≈ t_complex
+    @test derivative(acosh(t_complex)) ≈ 1/sqrt(t_complex^2 - 1)
+    @test acosh(t_complex) ≈ log(t_complex + sqrt(t_complex^2 - 1))
+    @test sinh(acosh(t_complex)) ≈ sqrt(t_complex^2 - 1)
+
+    # The inverse hyperbolic functions preserve the type and order of their argument
+    @test asinh(t) isa Taylor1
+    @test asinh(t).order == t.order
+    @test acosh(t_complex) isa Taylor1
+    @test acosh(t_complex).order == t_complex.order
+    @test atanh(t) isa Taylor1
+    @test atanh(t).order == t.order
+
+    # Divergent series expansions raise ArgumentError
+    @test_throws ArgumentError asinh(Taylor1([im, 1], 5))
+    @test_throws ArgumentError acosh(Taylor1([1.0, 1.0], 5))
+    @test_throws ArgumentError acosh(Taylor1([-1.0, 1.0], 5))
+    @test_throws ArgumentError atanh(Taylor1([1.0, 1.0], 5))
+    @test_throws ArgumentError atanh(Taylor1([-1.0, 1.0], 5))
+
+    # The full suite of standard trig functions is supported
+    tpos = Taylor1([1.5, 1.0], 15)
+    for f in (csc, sec, cot, acsc, asec, acot, csch, sech, coth, acsch, acoth)
+        @test f(tpos) isa Taylor1
+    end
+    @test asech(Taylor1([0.5, 1.0], 15)) isa Taylor1
+
+    # TaylorN series are supported as well
+    set_variables("x", numvars=1, order=5)
+    tN = TaylorN(Float64, 1, order=5) + 0.5
+    @test asinh(tN) isa TaylorN
+    @test asinh(tN).order == tN.order
+    @test atanh(tN) isa TaylorN
+    @test atanh(tN).order == 5
+    @test acosh(tN + 1.0) isa TaylorN
+    @test acosh(tN + 1.0).order == 5
+    @test_throws ArgumentError asinh(TaylorN(im, 5))
+    @test_throws ArgumentError acosh(TaylorN(1.0, 5))
+    @test_throws ArgumentError atanh(TaylorN(1.0, 5))
+
     @test asin(t) + acos(t) == pi/2
