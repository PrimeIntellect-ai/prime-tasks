diff --git a/test/features/windowFunctions.ts b/test/features/windowFunctions.ts
new file mode 100644
index 0000000..91c5d07
--- /dev/null
+++ b/test/features/windowFunctions.ts
@@ -0,0 +1,30 @@
+import { FormatFn } from 'src/sqlFormatter';
+
+// The ROWS/RANGE BETWEEN window-frame syntax is only required for BigQuery.
+// BigQuery is the only dialect that treats dashes as part of identifiers,
+// which lets us recognize its formatter from the shared format function.
+function isBigQuery(format: FormatFn): boolean {
+  return format('SELECT alpha-foo FROM beta').includes('alpha-foo');
+}
+
+export default function supportsWindowFunctions(format: FormatFn) {
+  if (!isBigQuery(format)) {
+    return;
+  }
+
+  it('supports ROWS BETWEEN in window functions', () => {
+    const formatted = format(`
+      SELECT
+        RANK() OVER (
+          PARTITION BY explosion
+          ORDER BY day ROWS BETWEEN 6 PRECEDING AND CURRENT ROW
+        ) AS amount
+      FROM
+        tbl
+    `);
+
+    expect(formatted.replace(/\s+/g, ' ')).toContain(
+      'ROWS BETWEEN 6 PRECEDING AND CURRENT ROW'
+    );
+  });
+}
