+#[test]
+fn test_pretty_print_large_numbers_in_statements() {
+    let mut ctx = get_test_context();
+    let fmt = PlainTextFormatter {};
+
+    let (statements, _) = ctx
+        .interpret("let x = 4294967296", CodeSource::Internal)
+        .unwrap();
+    let output = fmt.format(&statements[0].pretty_print(), false);
+    assert!(
+        output.contains("4_294_967_296"),
+        "expected grouped integer in pretty-printed statement, got: {output}"
+    );
+
+    let (statements, _) = ctx
+        .interpret("let sun_luminosity = 3.828e26 W", CodeSource::Internal)
+        .unwrap();
+    let output = fmt.format(&statements[0].pretty_print(), false);
+    assert!(
+        output.contains("3.828e+26"),
+        "expected scientific notation with explicit '+' in pretty-printed statement, got: {output}"
+    );
+}
