diff --git a/test/Containers/DenseAxisArray.jl b/test/Containers/DenseAxisArray.jl
index e6c04c48..53f54e88 100644
--- a/test/Containers/DenseAxisArray.jl
+++ b/test/Containers/DenseAxisArray.jl
@@ -350,4 +350,21 @@ And data, a 0-dimensional $(Array{Int,0}):
         y = @test_logs DenseAxisArray([1.1 2.2], [1], 1:2)
         @test y[1, 2] == 2.2
     end
+
+    @testset "CartesianIndex error" begin
+        S = CartesianIndex.([2, 4])
+        @test_throws Exception DenseAxisArray([1.1, 2.2], S)
+        # The restriction applies to every axis, not just the first one.
+        @test_throws Exception DenseAxisArray([1.1 2.2; 3.3 4.4], [1, 2], S)
+    end
+
+    @testset "Vector of tuple indices" begin
+        sources = ["A", "B", "C"]
+        sinks = ["D", "E"]
+        S = [(source, sink) for source in sources for sink in sinks]
+        x = DenseAxisArray(1:6, S)
+        @test size(x) == (6,)
+        @test x[("A", "D")] == 1
+        @test x[("C", "E")] == 6
+    end
 end
