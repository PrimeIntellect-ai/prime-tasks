+  // MARK: - Test custom assign
+
+  func testCustomAssign() {
+    assertMacro {
+      """
+      @MemberwiseInit
+      struct S {
+        @Init(assignee: "self._type") var type: T
+      }
+      """
+    } expansion: {
+      """
+      struct S {
+        var type: T
+
+        internal init(
+          type: T
+        ) {
+          self._type = type
+        }
+      }
+      """
+    }
+  }
+
+  // MARK: - Test custom assign and type combined
+
+  func testCustomAssignAndType() {
+    assertMacro {
+      """
+      @MemberwiseInit
+      struct S {
+        @Init(assignee: "self._type", type: Q) var type: T
+      }
+      """
+    } expansion: {
+      """
+      struct S {
+        var type: T
+
+        internal init(
+          type: Q
+        ) {
+          self._type = type
+        }
+      }
+      """
+    }
+  }
+
+  func testCustomAssignAndType_WithPropertyWrapper() {
+    assertMacro {
+      """
+      @MemberwiseInit
+      struct S {
+        @Init(assignee: "self._count", type: Binding<Int>)
+        @Binding
+        var count: Int
+      }
+      """
+    } expansion: {
+      """
+      struct S {
+        @Binding
+        var count: Int
+
+        internal init(
+          count: Binding<Int>
+        ) {
+          self._count = count
+        }
+      }
+      """
+    }
+  }
+
