+  // MARK: - Test custom type
+
+  func testCustomType() {
+    assertMacro {
+      """
+      @MemberwiseInit
+      struct S {
+        @Init(type: Q) var type: T
+      }
+      """
+    } expansion: {
+      """
+      struct S {
+        var type: T
+
+        internal init(
+          type: Q
+        ) {
+          self.type = type
+        }
+      }
+      """
+    }
+  }
+
+  func testCustomType_GenericExpression() {
+    assertMacro {
+      """
+      @MemberwiseInit
+      struct S {
+        @Init(type: Q<R>) var type: T
+      }
+      """
+    } expansion: {
+      """
+      struct S {
+        var type: T
+
+        internal init(
+          type: Q<R>
+        ) {
+          self.type = type
+        }
+      }
+      """
+    }
+  }
+
