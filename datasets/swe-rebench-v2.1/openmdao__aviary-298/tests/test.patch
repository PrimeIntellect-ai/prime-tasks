+    @use_tempdirs
+    def test_parse_input(self):
+        aircraft_values = get_option_defaults(engine=False)
+        # create a temperary csv file for testing non-existing variable name
+        file_name = "aircraft_for_invalid_var.csv"
+        with open(file_name, "w") as file:
+            file.write("test_string,0\n")  # be ignored silently
+            file.write("aircraft:wing:mass_scalar,1,unitless\n")  # raise a warning
+            file.write("aircraft:anti_icing:mass,551,lbm\n")  # a good variable
+            file.write("time_to_climb,100\n")  # an initial guess
+        vehicle_deck = get_path(file_name)
+
+        msg = "Variable 'aircraft:wing:mass_scalar' is not in meta_data nor in 'guess_names'. It will be ignored."
+        with assert_warning(UserWarning, msg):
+            aircraft_values, initial_guesses = parse_inputs(vehicle_deck, aircraft_values)
+
+        # a recognized variable is assigned to aircraft_values
+        self.assertEqual(aircraft_values.get_val('aircraft:anti_icing:mass', 'lbm'), 551)
+
+        # a variable without a hierarchy separator that is not recognized is ignored silently
+        self.assertNotIn('test_string', get_keys(aircraft_values))
+
+        # numeric initial guess values are extracted into the returned dictionary
+        self.assertIn('time_to_climb', initial_guesses)
+        self.assertEqual(initial_guesses['time_to_climb'], 100.0)
+
+        # remove the temperary csv file
+        os.remove(file_name)
+
+    def test_parse_inputs_uses_supplied_metadata(self):
+        aircraft_values = get_option_defaults(engine=False)
+        file_name = "aircraft_for_custom_metadata.csv"
