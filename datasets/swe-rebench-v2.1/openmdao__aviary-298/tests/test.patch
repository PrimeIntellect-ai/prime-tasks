+            file.write("custom:mass,551,lbm\n")
+
+        custom_metadata = {
+            'custom:mass': CoreMetaData['aircraft:anti_icing:mass']
+        }
+        aircraft_values, _ = parse_inputs(
+            get_path(file_name), aircraft_values, meta_data=custom_metadata)
+
+        self.assertEqual(aircraft_values.get_val('custom:mass', 'lbm'), 551)
