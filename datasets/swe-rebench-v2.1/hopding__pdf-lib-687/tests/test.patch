new file mode 100644
index 0000000..d15c6c9
--- /dev/null
+++ b/tests/core/acroform/PDFAcroField.spec.ts
@@ -0,0 +1,52 @@
+import {
+  PDFDocument,
+  PDFStream,
+  StandardFonts,
+  PDFTextField,
+  PDFFont,
+} from 'src/index';
+
+const normalAppearanceFontSize = (textField: PDFTextField): number => {
+  const widget = textField.acroField.getWidgets()[0];
+  const normal = widget.getAppearances()?.normal;
+  if (!(normal instanceof PDFStream)) throw new Error('missing appearance');
+
+  const match = /(\d+(?:\.\d+)?) Tf/.exec(normal.getContentsString());
+  if (!match) throw new Error('missing font size operator');
+  return Number(match[1]);
+};
+
+describe(`PDFAcroField`, () => {
+  it(`lays out text in a field with a negative widget height the same as a positive height`, async () => {
+    const pdfDoc = await PDFDocument.create();
+    const page = pdfDoc.addPage();
+    const form = pdfDoc.getForm();
+    const helvetica: PDFFont = await pdfDoc.embedFont(StandardFonts.Helvetica);
+
+    const positive = form.createTextField('positive.height');
+    positive.setText('Hello world');
+    positive.addToPage(page, {
+      x: 0,
+      y: 0,
+      width: 200,
+      height: 50,
+      font: helvetica,
+    });
+
+    const negative = form.createTextField('negative.height');
+    negative.setText('Hello world');
+    negative.addToPage(page, {
+      x: 0,
+      y: 100,
+      width: 200,
+      height: -50,
+      font: helvetica,
+    });
+
+    const positiveSize = normalAppearanceFontSize(positive);
+    const negativeSize = normalAppearanceFontSize(negative);
+
+    expect(positiveSize).toBeGreaterThan(4);
+    expect(negativeSize).toBe(positiveSize);
+  });
+});
