+import {
+  PDFDocument,
+  PDFStream,
+  PDFTextField,
+  PDFWidgetAnnotation,
+  StandardFonts,
+} from 'src/index';
+
+const normalAppearanceFontSize = (textField: PDFTextField): number => {
+  const widget: PDFWidgetAnnotation = textField.acroField.getWidgets()[0];
+  const normal = widget.getAppearances()?.normal;
+  if (!(normal instanceof PDFStream)) throw new Error('missing appearance');
+
+  const match = /(\d+(?:\.\d+)?) Tf/.exec(normal.getContentsString());
+  if (!match) throw new Error('missing font size operator');
+  return Number(match[1]);
+};
+
+describe(`PDFWidgetAnnotation`, () => {
+  it(`sizes text for a widget with a negative rectangle height like the positive height`, async () => {
+    const pdfDoc = await PDFDocument.create();
+    const page = pdfDoc.addPage();
+    const form = pdfDoc.getForm();
+    const helvetica = await pdfDoc.embedFont(StandardFonts.Helvetica);
+
+    const positive = form.createTextField('positive.widget');
+    positive.setText('Some text');
+    positive.addToPage(page, { x: 0, y: 0, width: 150, height: 40 });
+    positive.updateAppearances(helvetica);
+
+    const negative = form.createTextField('negative.widget');
+    negative.setText('Some text');
+    negative.addToPage(page, { x: 0, y: 100, width: 150, height: -40 });
+    negative.updateAppearances(helvetica);
+
+    const positiveSize = normalAppearanceFontSize(positive);
+    const negativeSize = normalAppearanceFontSize(negative);
+
+    expect(positiveSize).toBeGreaterThan(4);
+    expect(negativeSize).toBe(positiveSize);
+  });
+});
