+    @DisplayName("MutableContext merge should retain subkeys from the existing context when the overriding context has the same key")
+    @Test
+    void mutableContextMergeShouldRetainItsSubkeysWhenOverridingContextHasTheSameKey() {
+        MutableContext ctx = new MutableContext("targeting_key");
+        ctx.add("key1", new MutableStructure().add("key1_1", "val1_1").add("shared", "base_value"));
+        ctx.add("key2", "val2");
