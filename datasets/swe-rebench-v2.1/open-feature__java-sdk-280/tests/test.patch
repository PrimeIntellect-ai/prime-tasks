+    @DisplayName("Merge should recursively merge structures that collide at deeper nesting levels")
+    @Test
+    void mergeShouldRecursivelyMergeCollidingNestedStructures() {
+        HashMap<String, Value> baseDeep = new HashMap<>();
+        baseDeep.put("base_only", new Value("base_val"));
+        baseDeep.put("shared", new Value("base_shared"));
+        HashMap<String, Value> base = new HashMap<>();
+        base.put("key1_1", new Value(new ImmutableStructure(baseDeep)));
+        base.put("key1_2", new Value("val1_2"));
+        HashMap<String, Value> attributes = new HashMap<>();
+        attributes.put("key1", new Value(new ImmutableStructure(base)));
+
+        HashMap<String, Value> overridingDeep = new HashMap<>();
+        overridingDeep.put("overriding_only", new Value("overriding_val"));
+        overridingDeep.put("shared", new Value("overriding_shared"));
+        HashMap<String, Value> overridingLevel = new HashMap<>();
+        overridingLevel.put("key1_1", new Value(new ImmutableStructure(overridingDeep)));
+        HashMap<String, Value> overridingAttributes = new HashMap<>();
+        overridingAttributes.put("key1", new Value(new ImmutableStructure(overridingLevel)));
+
+        EvaluationContext ctx = new ImmutableContext("targeting_key", attributes);
+        EvaluationContext overriding = new ImmutableContext("targeting_key", overridingAttributes);
+        EvaluationContext merge = ctx.merge(overriding);
+
+        Structure level1 = merge.getValue("key1").asStructure();
+        assertTrue(level1.keySet().contains("key1_2"));
+        assertEquals("val1_2", level1.getValue("key1_2").asString());
+
+        Structure level2 = level1.getValue("key1_1").asStructure();
+        assertEquals(3, level2.keySet().size());
+        assertTrue(level2.keySet().contains("base_only"));
+        assertTrue(level2.keySet().contains("overriding_only"));
+        assertTrue(level2.keySet().contains("shared"));
+        assertEquals("base_val", level2.getValue("base_only").asString());
+        assertEquals("overriding_val", level2.getValue("overriding_only").asString());
+        assertEquals("overriding_shared", level2.getValue("shared").asString());
+    }
