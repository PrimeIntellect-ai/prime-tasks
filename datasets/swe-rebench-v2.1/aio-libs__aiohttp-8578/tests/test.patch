     r = await client.get("///a")
     assert r.status == 200
     await r.release()
+
+
+async def test_route_with_regex(aiohttp_client: AiohttpClient) -> None:
+    """Test a route with a regex preceded by a fixed string."""
+    app = web.Application()
+
+    async def handler(request: web.Request) -> web.Response:
+        assert isinstance(request.match_info.route.resource, Resource)
+        return web.Response(text=request.match_info.route.resource.canonical)
+
+    app.router.add_get("/core/locations{tail:.*}", handler)
+    client = await aiohttp_client(app)
+
+    r = await client.get("/core/locations/tail/here")
+    assert r.status == 200
+    assert await r.text() == "/core/locations{tail}"
+
+    r = await client.get("/core/locations_tail_here")
+    assert r.status == 200
+    assert await r.text() == "/core/locations{tail}"
+
+    r = await client.get("/core/locations_tail;id=abcdef")
+    assert r.status == 200
+    assert await r.text() == "/core/locations{tail}"
+
+
+async def test_put_route_with_regex_and_semicolon_path(
+    aiohttp_client: AiohttpClient,
+) -> None:
+    app = web.Application()
+
+    async def handler(request: web.Request) -> web.Response:
+        return web.Response(text="handled")
+
+    app.router.add_put("/core/locations{tail:.*}", handler)
+    client = await aiohttp_client(app)
+
+    response = await client.put(
+        "/core/locations;id=c50f167537524366a5af7aa3942feb1e/thermostat;id=711861a52ed84f37a2d854afba34d9e6"
+    )
+    assert await response.text() == "handled"
