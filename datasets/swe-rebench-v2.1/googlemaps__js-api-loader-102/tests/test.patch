+function dispatchScriptError(loader: Loader): void {
+  const script = document.getElementById(loader.id);
+  if (!script) {
+    throw new Error("Expected the loader to have added a script");
+  }
+  script.dispatchEvent(new ErrorEvent("error"));
+}
+
+async function expectRejected(promise: Promise<unknown>): Promise<void> {
+  let rejected = false;
+  try {
+    await promise;
+  } catch {
+    rejected = true;
+  }
+  expect(rejected).toBe(true);
+}
