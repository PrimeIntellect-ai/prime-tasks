+test("script onerror should reset retry mechanism with next loader", async () => {
+  const loader = new Loader({ apiKey: "foo", retries: 1 });
+
+  const firstLoad = loader.load();
+  dispatchScriptError(loader);
+  jest.runAllTimers();
+  dispatchScriptError(loader);
+  await expectRejected(firstLoad);
+
+  // After the retry sequence has failed, a later call starts another load.
+  let settled = false;
+  const secondLoad = loader.load();
+  secondLoad.then(
+    () => (settled = true),
+    () => (settled = true)
+  );
+  await Promise.resolve();
+  expect(settled).toBe(false);
+
+  dispatchScriptError(loader);
+  jest.runAllTimers();
+  dispatchScriptError(loader);
+  await expectRejected(secondLoad);
+});
+
+test("script onerror should not reset retry mechanism with parallel loaders", async () => {
+  const loader = new Loader({ apiKey: "foo", retries: 1 });
+
+  let settled1 = false;
+  let settled2 = false;
+  const firstLoad = loader.load();
+  const secondLoad = loader.load();
+  firstLoad.then(
+    () => (settled1 = true),
+    () => (settled1 = true)
+  );
+  secondLoad.then(
+    () => (settled2 = true),
+    () => (settled2 = true)
+  );
+
+  dispatchScriptError(loader);
+  await Promise.resolve();
+  expect(settled1).toBe(false);
+  expect(settled2).toBe(false);
+
+  jest.runAllTimers();
+  dispatchScriptError(loader);
+  await expect(firstLoad).rejects.toBeDefined();
+  await expectRejected(secondLoad);
+});
