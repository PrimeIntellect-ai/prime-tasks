+def test_similarity_encoder_fit():
+    """SimilarityEncoder can be fitted and used to transform data
+    with the installed scikit-learn version."""
+    X = np.array([["aa"], ["bb"], ["aa"], ["cc"]], dtype=object)
+    encoder = SimilarityEncoder()
+    encoded = encoder.fit_transform(X)
+    # One output row per input row, one column per distinct category.
+    assert encoded.shape == (len(X), 3)
+    assert np.isfinite(encoded).all()
