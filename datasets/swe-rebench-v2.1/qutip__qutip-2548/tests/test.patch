         fig, ax = qutip.plot_schmidt(state)
     assert str(exc_info.value) == text
     plt.close()
+
+
+
+def _two_mode_squeezed_state():
+    a = qutip.tensor(qutip.destroy(5), qutip.qeye(5))
+    b = qutip.tensor(qutip.qeye(5), qutip.destroy(5))
+    return qutip.squeezing(a, b, 0.9) * qutip.tensor(
+        qutip.fock(5, 0), qutip.fock(5, 0))
+
+
+@pytest.mark.parametrize("as_dm", [False, True])
+def test_TwoModeQuadratureCorrelation(as_dm):
+    state = _two_mode_squeezed_state()
+    if as_dm:
+        state = qutip.ket2dm(state)
+
+    corr = qutip.TwoModeQuadratureCorrelation(state)
+
+    assert np.isfinite(corr.data).all()
+    assert np.any(corr.data > 0)
+
+
+@pytest.mark.parametrize("as_dm", [False, True])
+def test_TwoModeQuadratureCorrelation_plot(as_dm):
+    state = _two_mode_squeezed_state()
+    if as_dm:
+        state = qutip.ket2dm(state)
+    corr = qutip.TwoModeQuadratureCorrelation(state)
+
+    fig, ax = corr.visualize()
+    plt.close(fig)
+
+    assert isinstance(fig, mpl.figure.Figure)
+    assert isinstance(ax, mpl.axes.Axes)
