+func TestMonitorConnzSortByRTTContractCoverage(t *testing.T) {
+	s := runMonitorServer()
+	defer s.Shutdown()
+
+	for i := 0; i < 10; i++ {
+		nc, err := nats.Connect(s.ClientURL())
+		require_NoError(t, err)
+		defer nc.Close()
+	}
+
+	// Sorting by RTT should be accepted and return all connections ordered
+	// by their RTT in descending order.
+	connz := pollConz(t, s, 1, _EMPTY_, &ConnzOptions{Sort: SortOpt("rtt")})
+	require_True(t, connz.NumConns == 10)
+	assertConnzRTTDescendingContractCoverage(t, connz)
+
+	// Make sure the URL query parameter works as well.
+	url := fmt.Sprintf("http://127.0.0.1:%d/connz?sort=rtt", s.MonitorAddr().Port)
+	connz = pollConz(t, s, 0, url, nil)
+	require_True(t, connz.NumConns == 10)
+	assertConnzRTTDescendingContractCoverage(t, connz)
+}
+
+// checkConnzRTTDescending verifies that the connections are ordered by their
+// reported RTT in descending order.
+func assertConnzRTTDescendingContractCoverage(t *testing.T, connz *Connz) {
+	t.Helper()
+	var prev int64
+	for i, ci := range connz.Conns {
+		crttd, err := time.ParseDuration(ci.RTT)
+		require_NoError(t, err)
+		crtt := int64(crttd)
+		if i > 0 && crtt > prev {
+			t.Fatalf("RTT not in descending order: %v vs %v",
+				time.Duration(prev), time.Duration(crtt))
+		}
+		prev = crtt
+	}
+}
