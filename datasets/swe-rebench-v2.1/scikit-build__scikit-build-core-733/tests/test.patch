+        build_type="",
+    )
+    commands = []
+    monkeypatch.setattr(
+        "scikit_build_core._shutil.subprocess.run",
+        lambda args, **kwargs: commands.append(args),
+    )
+    tmpbuilder = Builder(settings=settings_reader.settings, config=config)
+    tmpbuilder.build(["a"])
+
+    assert any(
+        "--" in command and command[command.index("--") + 1 :] == ["--jobs=2", "-l3"]
+        for command in commands
+    )
