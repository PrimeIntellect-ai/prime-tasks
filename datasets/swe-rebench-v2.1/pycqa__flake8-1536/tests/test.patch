+RECEIVED_PHYSICAL_LINES = []
+
+
+def record_physical_line(physical_line):
+    RECEIVED_PHYSICAL_LINES.append(physical_line)
+
+
+def test_physical_line_plugin_multiline_string(tmp_path):
+    """Physical line plugins receive every line of a multiline string."""
+    lines = ['x = "foo" + """\n', "bar\n", '"""\n']
+    t_py = tmp_path / "t.py"
+    t_py.write_text("".join(lines))
+
+    RECEIVED_PHYSICAL_LINES.clear()
+
+    to_load = [
+        finder.Plugin(
+            "local",
+            "local",
+            importlib_metadata.EntryPoint(
+                "T",
+                f"{record_physical_line.__module__}:"
+                f"{record_physical_line.__name__}",
+                "flake8.extension",
+            ),
+        ),
+    ]
+    plugins = finder.load_plugins(to_load, finder.PluginOptions.blank())
+    file_checker = checker.FileChecker(
+        filename=str(t_py),
+        plugins=plugins.checkers,
+        options=mock.MagicMock(),
+    )
+    file_checker.run_checks()
+
+    assert RECEIVED_PHYSICAL_LINES == lines
