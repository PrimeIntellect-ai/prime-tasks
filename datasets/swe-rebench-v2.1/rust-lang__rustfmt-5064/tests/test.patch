@@ -1,5 +1,9 @@
+use std::env;
+use std::fs;
 use std::io;
 use std::path::PathBuf;
+use std::process::Command;
+use std::time::{SystemTime, UNIX_EPOCH};
 
 use super::read_config;
 
@@ -23,3 +27,64 @@ fn nested_out_of_line_mods_loaded() {
         "tests/mod-resolver/issue-4874/foo/qux.rs",
     ))));
 }
+
+#[test]
+fn out_of_line_nested_inline_within_out_of_line() {
+    // See also https://github.com/rust-lang/rustfmt/issues/5063
+    let id = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .expect("system clock is before the Unix epoch")
+        .as_nanos();
+    let crate_dir =
+        env::temp_dir().join(format!("rustfmt-issue-5063-{}-{}", std::process::id(), id));
+    let source_dir = crate_dir.join("src");
+    fs::create_dir_all(source_dir.join("foo/bar")).expect("create temporary crate source tree");
+    fs::copy(
+        "tests/mod-resolver/issue-5063/main.rs",
+        source_dir.join("main.rs"),
+    )
+    .expect("copy crate root");
+    fs::copy(
+        "tests/mod-resolver/issue-5063/foo.rs",
+        source_dir.join("foo.rs"),
+    )
+    .expect("copy out-of-line module");
+    fs::copy(
+        "tests/mod-resolver/issue-5063/foo/bar/baz.rs",
+        source_dir.join("foo/bar/baz.rs"),
+    )
+    .expect("copy nested module");
+    fs::write(
+        crate_dir.join("Cargo.toml"),
+        "[package]\nname = \"issue-5063\"\nversion = \"0.1.0\"\nedition = \"2021\"\n",
+    )
+    .expect("write temporary crate manifest");
+
+    let mut bin_dir = env::current_exe().expect("find test executable");
+    bin_dir.pop();
+    bin_dir.pop();
+    let cargo_fmt = bin_dir.join("cargo-fmt");
+    let mut paths = env::split_paths(&env::var_os("PATH").unwrap_or_default()).collect::<Vec<_>>();
+    paths.insert(0, bin_dir);
+    let path = env::join_paths(paths).expect("prepare local cargo-fmt path");
+    let output = Command::new(cargo_fmt)
+        .arg("--manifest-path")
+        .arg(crate_dir.join("Cargo.toml"))
+        .env("PATH", path)
+        .output()
+        .expect("run cargo-fmt");
+
+    assert!(
+        output.status.success(),
+        "cargo-fmt failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let formatted_child = fs::read_to_string(source_dir.join("foo/bar/baz.rs"))
+        .expect("read nested module after formatting");
+    assert!(
+        formatted_child.contains("fn baz() {}"),
+        "cargo-fmt did not format the nested module: {:?}",
+        formatted_child
+    );
+    fs::remove_dir_all(crate_dir).expect("remove temporary crate");
+}
