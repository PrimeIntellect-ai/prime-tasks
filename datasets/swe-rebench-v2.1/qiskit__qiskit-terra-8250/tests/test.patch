+    def _assert_qasm_roundtrip_preserves_functionality(self, circuit):
+        """Compare one-qubit behavior without constraining QASM gate spelling."""
+        roundtrip = QuantumCircuit.from_qasm_str(circuit.qasm())
+
+        def unitary(candidate):
+            matrix = np.eye(2, dtype=complex)
+            for instruction in candidate.data:
+                matrix = instruction.operation.to_matrix() @ matrix
+            return np.exp(1j * float(candidate.global_phase)) * matrix
+
+        original_matrix = unitary(circuit)
+        roundtrip_matrix = unitary(roundtrip)
+        relative_phase = np.vdot(original_matrix, roundtrip_matrix)
+        relative_phase /= abs(relative_phase)
+        self.assertTrue(
+            np.allclose(original_matrix, roundtrip_matrix / relative_phase, rtol=0, atol=1e-13)
+        )
+
+    def test_circuit_qasm_with_double_precision_rotation_angle(self):
+        """A QASM round trip preserves circuit functionality for precise angles."""
+        qc = QuantumCircuit(1)
+        qc.p(0.123456789, 0)
+
+        self._assert_qasm_roundtrip_preserves_functionality(qc)
+
+    def test_circuit_qasm_with_rotation_angles_close_to_pi(self):
+        """A QASM round trip retains precision for angles near multiples of pi."""
+        angle = pi + 1e-11
+        qc = QuantumCircuit(1)
+        qc.p(angle, 0)
+
+        self._assert_qasm_roundtrip_preserves_functionality(qc)
+
+    def test_circuit_qasm_preserves_other_parameterized_gates(self):
+        """A QASM round trip retains precision across parameterized gate types."""
+        qc = QuantumCircuit(1)
+        qc.rx(0.123456789, 0)
+        qc.ry(0.234567891, 0)
+        qc.rz(0.345678912, 0)
+
+        self._assert_qasm_roundtrip_preserves_functionality(qc)
+
