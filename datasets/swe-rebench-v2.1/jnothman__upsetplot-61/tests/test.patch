+
+
+def test_from_contents_accepts_lists_and_preserves_ids_and_memberships():
+    from upsetplot import from_contents
+
+    contents = {
+        'cat1': ['aa', 'bb', 'cc'],
+        'cat2': ['cc', 'dd'],
+        'cat3': ['ee'],
+        'empty': [],
+    }
+
+    out = from_contents(contents)
+
+    assert set(out.index.names) == set(contents)
+    assert set(out['id']) == {'aa', 'bb', 'cc', 'dd', 'ee'}
+    assert out['id'].is_unique
+
+    memberships = {}
+    for _, row in out.reset_index().iterrows():
+        memberships[row['id']] = {
+            category for category in contents if row[category]
+        }
+    assert memberships == {
+        'aa': {'cat1'},
+        'bb': {'cat1'},
+        'cc': {'cat1', 'cat2'},
+        'dd': {'cat2'},
+        'ee': {'cat3'},
+    }
