+func TestInitNoSample(t *testing.T) {
+	td := t.TempDir()
+
+	wd, _ := os.Getwd()
+	require.NoError(t, os.Chdir(td))
+	defer func() {
+		require.NoError(t, os.Chdir(wd))
+	}()
+
+	_, _, err := executeAndResetCommand(context.Background(), rootCmd, []string{"init", "--no-sample"})
+	assert.NoError(t, err)
+
+	_, err = os.Stat("score.yaml")
+	assert.ErrorIs(t, err, os.ErrNotExist)
+
+	sd, ok, err := project.LoadStateDirectory(".")
+	require.NoError(t, err)
+	require.True(t, ok, "init should still create the project state directory")
+	assert.Equal(t, project.DefaultRelativeStateDirectory, sd.Path)
+	assert.Equal(t, filepath.Join(project.DefaultRelativeStateDirectory, "mounts"), sd.State.MountsDirectory)
+	provisionerFiles, err := filepath.Glob(filepath.Join(sd.Path, "*.provisioners.yaml"))
+	require.NoError(t, err)
+	assert.NotEmpty(t, provisionerFiles, "init should still write the default provisioner configuration")
+}
