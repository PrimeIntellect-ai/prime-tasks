diff --git a/test/timeout.js b/test/timeout.js
index 93c7cde..fb16d28 100644
--- a/test/timeout.js
+++ b/test/timeout.js
@@ -436,7 +436,36 @@ test('no error emitted when timeout is not breached (promise)', async t => {
 	t.pass();
 });
 
-test('no unhandled errors', async t => {
+test('no unhandled `socket hung up` errors', async t => {
 	await t.throwsAsync(got(s.url, {retry: 0, timeout: requestDelay / 2}), {instanceOf: got.TimeoutError});
 	await delay(requestDelay);
 });
+
+test('no more timeouts after an error', async t => {
+	const error = await t.throwsAsync(got({
+		hostname: 'example.invalid',
+		port: 80,
+		lookup: (hostname, options, callback) => {
+			// Simulate a DNS lookup that fails after the lookup timeout elapses.
+			setTimeout(() => callback(new Error('ENOTFOUND')), 50);
+		}
+	}, {
+		retry: 1,
+		timeout: {
+			lookup: 1,
+			connect: 1,
+			secureConnect: 1,
+			socket: 1,
+			response: 1,
+			send: 1,
+			request: 1
+		}
+	}));
+
+	// The request may fail with a DNS error (`GotError`) or, if the lookup
+	// timeout elapses first, a `TimeoutError`. Both are valid per the contract.
+	t.true(error instanceof got.GotError || error instanceof got.TimeoutError);
+
+	// Wait a bit more to check if there are any unhandled errors
+	await delay(100);
+});
