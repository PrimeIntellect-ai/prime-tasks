+
+
+@mock.patch(
+    "semantic_release.history.parser_emoji.config.get",
+    wrapped_config_get(use_textual_changelog_sections=True),
+)
+@pytest.mark.parametrize(
+    "level,commit,commit_type,descriptions,breaking_descriptions",
+    [
+        (
+            3,
+            ":boom: Breaking changes\n\n"
+            "More description\n\n"
+            "Even more description",
+            "breaking",
+            [
+                ":boom: Breaking changes",
+                "More description",
+                "Even more description",
+            ],
+            ["More description", "Even more description"],
+        ),
+        (
+            2,
+            ":sparkles: Add a new feature\n\n" "Some description of the feature",
+            "feature",
+            [":sparkles: Add a new feature", "Some description of the feature"],
+            [],
+        ),
+        (
+            1,
+            ":bug: Fixing a bug\n\n" "The bug is finally gone!",
+            "fix",
+            [":bug: Fixing a bug", "The bug is finally gone!"],
+            [],
+        ),
+    ],
+)
+def test_use_textual_changelog_sections(
+    level, commit, commit_type, descriptions, breaking_descriptions
+):
+    parsed_commit = emoji_parser(commit)
+    assert parsed_commit[0] == level
+    assert parsed_commit[1] == commit_type
+    assert parsed_commit[2] is None
+    assert parsed_commit[3] == descriptions
+    assert parsed_commit[4] == breaking_descriptions
+
+
+def test_textual_changelog_sections_defaults_to_false():
+    from semantic_release.settings import config
+
+    assert config.get("use_textual_changelog_sections") is False
