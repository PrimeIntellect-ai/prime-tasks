+
+func TestUpdateStmtWithFieldReference(t *testing.T) {
+	db, err := genji.Open(":memory:")
+	require.NoError(t, err)
+	defer db.Close()
+
+	err = db.Exec("CREATE TABLE foo (base INTEGER, vat INTEGER)")
+	require.NoError(t, err)
+	err = db.Exec("INSERT INTO foo (base, vat) VALUES (400, 20)")
+	require.NoError(t, err)
+
+	err = db.Exec("UPDATE foo SET total = base + base * vat / 100")
+	require.NoError(t, err)
+
+	st, err := db.Query("SELECT * FROM foo")
+	require.NoError(t, err)
+	defer st.Close()
+
+	var buf bytes.Buffer
+	err = document.IteratorToJSONArray(&buf, st)
+	require.NoError(t, err)
+	require.JSONEq(t, `[{"base":400,"vat":20,"total":480}]`, buf.String())
+}
