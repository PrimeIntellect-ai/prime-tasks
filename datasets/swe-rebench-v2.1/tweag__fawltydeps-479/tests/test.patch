 logger = logging.getLogger(__name__)
 
@@ -41,3 +41,25 @@ def test_calculate_unused(vector):
         settings=settings,
     )
     assert actual == vector.expect_unused_deps
+
+
+@pytest.mark.parametrize("entry_point", ["configuration", "command line"])
+def test_ignore_unused_wildcard_from_public_entry_points(
+    entry_point, fake_project, tmp_path
+):
+    project = fake_project(imports=[], declared_deps=["pytest-plugin"])
+
+    if entry_point == "configuration":
+        config_file = tmp_path / "pyproject.toml"
+        config_file.write_text(
+            '[tool.fawltydeps]\nignore_unused = ["pytest-*"]\n'
+        )
+        _, exit_code = run_fawltydeps_function(
+            config_file=config_file, basepath=project
+        )
+    else:
+        _, exit_code = run_fawltydeps_function(
+            "--ignore-unused", "pytest-*", basepath=project
+        )
+
+    assert exit_code == 0
