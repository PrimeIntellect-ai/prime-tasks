+def test_invert_transforms_0dims():
+    random_state = np.random.RandomState(0)
+    A2B = random_transform(random_state)
+    B2A = invert_transform(A2B)
+    actual = invert_transforms(A2B)
+    assert isinstance(actual, np.ndarray)
+    assert_array_almost_equal(B2A, actual)
+
+
+def test_invert_transforms_1dims():
+    random_state = np.random.RandomState(1)
+    A2Bs = np.empty((3, 4, 4))
+    B2As = np.empty((3, 4, 4))
+    for i in range(len(A2Bs)):
+        A2Bs[i] = random_transform(random_state)
+        B2As[i] = invert_transform(A2Bs[i])
+    assert_array_almost_equal(B2As, invert_transforms(A2Bs))
+
+
+def test_invert_transforms_2dims():
+    random_state = np.random.RandomState(1)
+    A2Bs = np.empty((9, 4, 4))
+    B2As = np.empty((9, 4, 4))
+    for i in range(len(A2Bs)):
+        A2Bs[i] = random_transform(random_state)
+        B2As[i] = invert_transform(A2Bs[i])
+    assert_array_almost_equal(
+        B2As.reshape(3, 3, 4, 4), invert_transforms(A2Bs.reshape(3, 3, 4, 4)))
+
+
+def test_invert_transforms_accepts_array_like_input():
+    random_state = np.random.RandomState(2)
+    A2Bs = [random_transform(random_state) for _ in range(3)]
+
+    actual = invert_transforms(A2Bs)
+
+    assert isinstance(actual, np.ndarray)
+    assert actual.shape == (3, 4, 4)
+    expected = np.array([invert_transform(A2B) for A2B in A2Bs])
+    assert_array_almost_equal(expected, actual)
+
+
