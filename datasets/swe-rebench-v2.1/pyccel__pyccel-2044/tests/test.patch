diff --git a/tests/epyccel/test_epyccel_dicts.py b/tests/epyccel/test_epyccel_dicts.py
index 4e2cd69c..88f16c76 100644
--- a/tests/epyccel/test_epyccel_dicts.py
+++ b/tests/epyccel/test_epyccel_dicts.py
@@ -58,6 +58,7 @@ def test_dict_copy(python_only_language):
     assert isinstance(python_result, type(pyccel_result))
     assert python_result == pyccel_result
 
+
 def test_dict_kwarg_init(python_only_language):
     def kwarg_init():
         b = dict(a=1, b=2) #pylint: disable=use-dict-literal
@@ -228,3 +229,41 @@ def test_dict_clear(python_only_language):
     python_result = dict_clear()
     assert python_result == pyccel_result
 
+
+def test_dict_copy_method(python_only_language):
+    def dict_copy():
+        a = {1:1.0, 2:2.0}
+        b = a.copy()
+        return b
+    epyc_dict_copy = epyccel(dict_copy, language = python_only_language)
+    pyccel_result = epyc_dict_copy()
+    python_result = dict_copy()
+    assert python_result == pyccel_result
+
+
+def test_dict_copy_method_is_independent(python_only_language):
+    def dict_copy_and_update():
+        original = {1:1.0, 2:2.0}
+        copied = original.copy()
+        copied.clear()
+        return original
+
+    epyc_dict_copy = epyccel(dict_copy_and_update, language = python_only_language)
+    pyccel_result = epyc_dict_copy()
+    python_result = dict_copy_and_update()
+    assert python_result == pyccel_result
+
+
+def test_dict_copy_shares_nested_values(python_only_language):
+    def dict_copy_and_mutate_value():
+        nested = [2]
+        original = {1: nested}
+        copied = original.copy()
+        nested.append(3)
+        return copied
+
+    epyc_dict_copy = epyccel(dict_copy_and_mutate_value, language = python_only_language)
+    pyccel_result = epyc_dict_copy()
+    python_result = dict_copy_and_mutate_value()
+    assert python_result == {1: [2, 3]}
+    assert pyccel_result == python_result
