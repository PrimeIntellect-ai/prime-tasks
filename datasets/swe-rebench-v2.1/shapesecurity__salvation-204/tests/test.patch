+	@Test
+	public void testHashSourceRejectsWrongDecodedLength() {
+		String[] names = {"sha256", "sha384", "sha512"};
+		int[] correctSizes = {32, 48, 64};
+		for (int i = 0; i < names.length; i++) {
+			int correct = correctSizes[i];
+			int[] wrongSizes = {correct - 1, correct + 1, correct / 2, correct * 2};
+			for (int wrong : wrongSizes) {
+				String value = Base64.getEncoder().encodeToString(new byte[wrong]);
+				ArrayList<Notice> notices = new ArrayList<>();
+				Policy p = parseWithNotices("script-src '" + names[i] + "-" + value + "'", notices);
+				boolean hasError = false;
+				for (Notice notice : notices) {
+					if ("Error".equals(notice.type.getValue())) {
+						hasError = true;
+					}
+				}
+				assertTrue(names[i] + " with " + wrong + " decoded bytes should be an error", hasError);
+				assertFalse(names[i] + " with " + wrong + " decoded bytes should not be kept in the policy",
+						p.show().contains(value));
+			}
+		}
+	}
