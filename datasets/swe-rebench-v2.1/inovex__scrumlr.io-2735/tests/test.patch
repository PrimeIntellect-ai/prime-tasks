+
+const CurrentPath = () => <span data-testid="current-path">{useLocation().pathname}</span>;
+
+describe("StackView navigation when a viewed note is stacked", () => {
+  test("navigates to the parent stack when the viewed child note is moved into it", () => {
+    const boardId = "test-board-id";
+    const noteId = "test-notes-id-1";
+    const parentStackId = "test-notes-id-2";
+    const portal = document.createElement("div");
+    portal.setAttribute("id", "portal");
+    document.body.appendChild(portal);
+
+    const initialState = getTestStore().getState();
+    appStore.dispatch(Actions.signIn(initialState.participants.self.user.id, initialState.participants.self.user.name));
+    appStore.dispatch(
+      Actions.initializeBoard(
+        initialState.board.data!,
+        [initialState.participants.self, ...initialState.participants.others],
+        initialState.requests,
+        initialState.columns,
+        initialState.notes,
+        initialState.votes,
+        [initialState.votings.open!, ...initialState.votings.past],
+        initialState.assignments
+      )
+    );
+    const tree = (
+      <Suspense fallback={<div>fallback</div>}>
+        <I18nextProvider i18n={i18n}>
+          <MemoryRouter initialEntries={[`/board/${boardId}/note/${noteId}/stack`]}>
+            <Provider store={appStore}>
+              <Routes>
+                <Route path="/board/:boardId/note/:noteId/stack" element={<StackView />} />
+              </Routes>
+              <CurrentPath />
+            </Provider>
+          </MemoryRouter>
+        </I18nextProvider>
+      </Suspense>
+    );
+    const {container} = renderRTL(tree, {container: portal});
+
+    const notesAfterMove = initialState.notes.map((note) =>
+      note.id === noteId ? {...note, position: {...note.position, stack: parentStackId}} : note
+    );
+    act(() => {
+      appStore.dispatch(Actions.updatedNotes(notesAfterMove));
+    });
+
+    expect(container.querySelector("[data-testid='current-path']")).toHaveTextContent(`/board/${boardId}/note/${parentStackId}/stack`);
+    portal.remove();
+  });
+});
