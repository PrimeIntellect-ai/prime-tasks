diff --git a/tests/test_client_request.py b/tests/test_client_request.py
index a17c979c..b50108e2 100644
--- a/tests/test_client_request.py
+++ b/tests/test_client_request.py
@@ -448,6 +448,15 @@ def test_basic_auth_from_url(make_request: _RequestMaker) -> None:
     assert "python.org" == req.host
 
 
+def test_basic_auth_no_user_from_url(make_request: _RequestMaker) -> None:
+    req = make_request("get", "http://:1234@python.org")
+    assert "AUTHORIZATION" in req.headers
+    scheme, credentials = req.headers["AUTHORIZATION"].split(" ", 1)
+    assert scheme.lower() == "basic"
+    assert credentials == "OjEyMzQ="
+    assert "python.org" == req.host
+
+
 def test_basic_auth_from_url_overridden(make_request: _RequestMaker) -> None:
     req = make_request(
         "get", "http://garbage@python.org", auth=aiohttp.BasicAuth("nkim", "1234")
diff --git a/tests/test_helpers.py b/tests/test_helpers.py
index 37963167..b6c580e5 100644
--- a/tests/test_helpers.py
+++ b/tests/test_helpers.py
@@ -208,6 +208,14 @@ def test_basic_auth_from_url() -> None:
     assert auth.password == "pass"
 
 
+def test_basic_auth_no_user_from_url() -> None:
+    url = URL("http://:pass@example.com")
+    auth = helpers.BasicAuth.from_url(url)
+    assert auth is not None
+    assert auth.login == ""
+    assert auth.password == "pass"
+
+
 def test_basic_auth_from_not_url() -> None:
     with pytest.raises(TypeError):
         helpers.BasicAuth.from_url("http://user:pass@example.com")  # type: ignore[arg-type]
