+package context
+
+import "testing"
+
+func TestNilInGetError(t *testing.T) {
+	ctx := New()
+	ctx.Set("err", nil)
+
+	res, err := ctx.GetError("err")
+	if err != nil {
+		t.Fatalf("GetError returned an error for a stored nil value: %v", err)
+	}
+	if res != nil {
+		t.Fatalf("GetError returned %v for a stored nil value; want nil", res)
+	}
+}
