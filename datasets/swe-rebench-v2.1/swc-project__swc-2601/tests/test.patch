+
+fn parse_program(src: &str, is_module: IsModule) -> Program {
+    Tester::new()
+        .print_errors(|cm, handler| {
+            let c = Compiler::new(cm.clone());
+
+            let fm = cm.new_source_file(FileName::Real("input.js".into()), src.into());
+            c.parse_js(
+                fm,
+                &handler,
+                EsVersion::Es2020,
+                Syntax::Es(EsConfig::default()),
+                is_module,
+                false,
+            )
+            .map_err(|_| ())
+        })
+        .unwrap()
+}
+
+#[test]
+fn is_module_unknown_script() {
+    let program = parse_program("const fs = require('fs');", IsModule::Unknown);
+    assert!(matches!(program, Program::Script(_)));
+}
+
+#[test]
+fn is_module_unknown_module() {
+    let program = parse_program("import fs from 'fs';", IsModule::Unknown);
+    assert!(matches!(program, Program::Module(_)));
+}
+
+#[test]
+fn is_module_bool_true_parses_module() {
+    let program = parse_program("foo;", IsModule::Bool(true));
+    assert!(matches!(program, Program::Module(_)));
+}
+
+#[test]
+fn is_module_bool_false_parses_script() {
+    let program = parse_program("foo;", IsModule::Bool(false));
+    assert!(matches!(program, Program::Script(_)));
+}
+
+#[test]
+fn is_module_serialize() {
+    assert_eq!(
+        serde_json::to_value(IsModule::Bool(true)).unwrap(),
+        serde_json::json!(true)
+    );
+    assert_eq!(
+        serde_json::to_value(IsModule::Bool(false)).unwrap(),
+        serde_json::json!(false)
+    );
+    assert_eq!(
+        serde_json::to_value(IsModule::Unknown).unwrap(),
+        serde_json::json!("unknown")
+    );
+}
+
+#[test]
+fn is_module_deserialize() {
+    let m: IsModule = serde_json::from_value(serde_json::json!(true)).unwrap();
+    assert!(matches!(m, IsModule::Bool(true)));
+
+    let m: IsModule = serde_json::from_value(serde_json::json!(false)).unwrap();
+    assert!(matches!(m, IsModule::Bool(false)));
+
+    let m: IsModule = serde_json::from_value(serde_json::json!("unknown")).unwrap();
+    assert!(matches!(m, IsModule::Unknown));
+}
+
+#[test]
+fn options_default_is_module() {
+    assert!(matches!(Options::default().is_module, IsModule::Bool(true)));
+}
+
+#[test]
+fn options_deserialize_is_module_unknown() {
+    let opts: Options =
+        serde_json::from_value(serde_json::json!({ "isModule": "unknown" })).unwrap();
+    assert!(matches!(opts.is_module, IsModule::Unknown));
+}
