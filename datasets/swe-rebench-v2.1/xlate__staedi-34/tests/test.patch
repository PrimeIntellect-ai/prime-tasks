+    @Test
+    void testWriteAlternateEncodedElement() throws EDIStreamException {
+        EDIOutputFactory factory = EDIOutputFactory.newFactory();
+        ByteArrayOutputStream stream = new ByteArrayOutputStream(4096);
+        EDIStreamWriter writer = factory.createEDIStreamWriter(stream, StandardCharsets.UTF_8.name());
+
+        writer.startInterchange();
+        writeHeader(writer);
+        writer.flush();
+        stream.reset();
+
+        writer.writeStartSegment("SEG");
+        writer.writeElement("BÜTTNER")
+              .writeEndSegment();
+        writer.flush();
+        assertEquals("SEG*BÜTTNER~", new String(stream.toByteArray(), StandardCharsets.UTF_8));
+    }
+
+    @Test
+    void testFlushFlushesUnderlyingStream() throws EDIStreamException {
+        EDIOutputFactory factory = EDIOutputFactory.newFactory();
+        final boolean[] flushed = { false };
+        OutputStream stream = new OutputStream() {
+            @Override
+            public void write(int b) {
+                // discard
+            }
+
+            @Override
+            public void flush() {
+                flushed[0] = true;
+            }
+        };
+        EDIStreamWriter writer = factory.createEDIStreamWriter(stream);
+
+        writer.startInterchange();
+        writeHeader(writer);
+        writer.flush();
+
+        assertTrue(flushed[0], "Underlying stream was not flushed");
+    }
 }
