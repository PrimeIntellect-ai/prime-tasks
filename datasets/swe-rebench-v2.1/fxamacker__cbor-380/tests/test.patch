+func TestValidExtraneousData(t *testing.T) {
+	testCases := []struct {
+		name     string
+		cborData []byte
+	}{
+		{"two numbers", []byte{0x00, 0x01}},
+		{"bytestring and int", []byte{0x44, 0x01, 0x02, 0x03, 0x04, 0x00}},
+		{"int and partial array", []byte{0x00, 0x83, 0x01, 0x02}},
+	}
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			err := Valid(tc.cborData)
+			if err == nil {
+				t.Errorf("Valid(0x%x) didn't return an error", tc.cborData)
+				return
+			}
+		})
+	}
+}
