 //go:embed test_spec.yaml
 var testOpenAPIDefinition string
+
+const requestValidatorSpecWithServers = `
+openapi: "3.0.0"
+info:
+  title: servers warning
+  version: "1.0"
+servers:
+  - url: http://deepmap.ai
+paths:
+  /resource:
+    get:
+      parameters:
+        - name: id
+          in: query
+          required: true
+          schema:
+            type: integer
+      responses:
+        "204":
+          description: ok
+`
+
+const requestValidatorSpecWithoutServers = `
+openapi: "3.0.0"
+info:
+  title: servers warning
+  version: "1.0"
+paths:
+  /resource:
+    get:
+      parameters:
+        - name: id
+          in: query
+          required: true
+          schema:
+            type: integer
+      responses:
+        "204":
+          description: ok
+`
+
+// requestValidatorHandlers builds each request-validation middleware without
+// custom options, wrapping a trivial 204 endpoint at GET /resource.
+var requestValidatorHandlers = map[string]func(t *testing.T, spec *openapi3.T) http.Handler{
+	"net/http": func(t *testing.T, spec *openapi3.T) http.Handler {
+		mw := chiMiddleware.OapiRequestValidator(spec)
+		return mw(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusNoContent)
+		}))
+	},
+	"echo": func(t *testing.T, spec *openapi3.T) http.Handler {
+		e := echo.New()
+		e.Use(echoMiddleware.OapiRequestValidator(spec))
+		e.GET("/resource", func(c echo.Context) error {
+			return c.NoContent(http.StatusNoContent)
+		})
+		return e
+	},
+	"gin": func(t *testing.T, spec *openapi3.T) http.Handler {
+		gin.SetMode(gin.TestMode)
+		r := gin.New()
+		r.Use(ginMiddleware.OapiRequestValidator(spec))
+		r.GET("/resource", func(c *gin.Context) {
+			c.Status(http.StatusNoContent)
+		})
+		return r
+	},
+}
+
+// captureDefaultLog runs fn and returns everything written to the standard logger.
+func captureDefaultLog(fn func()) string {
+	var buf bytes.Buffer
+	prev := log.Writer()
+	log.SetOutput(&buf)
+	defer log.SetOutput(prev)
+	fn()
+	return buf.String()
+}
+
+func TestRequestValidatorWarnsWhenSpecHasServers(t *testing.T) {
+	for name, build := range requestValidatorHandlers {
+		build := build
+		t.Run(name, func(t *testing.T) {
+			spec, err := openapi3.NewLoader().LoadFromData([]byte(requestValidatorSpecWithServers))
+			require.NoError(t, err)
+
+			var validCode, invalidCode int
+			out := captureDefaultLog(func() {
+				h := build(t, spec)
+
+				// The middleware must still validate requests after warning.
+				validRec := httptest.NewRecorder()
+				h.ServeHTTP(validRec, httptest.NewRequest(http.MethodGet, "http://deepmap.ai/resource?id=1", nil))
+				validCode = validRec.Code
+
+				invalidRec := httptest.NewRecorder()
+				h.ServeHTTP(invalidRec, httptest.NewRequest(http.MethodGet, "http://deepmap.ai/resource", nil))
+				invalidCode = invalidRec.Code
+			})
+
+			assert.NotEmpty(t, out, "expected a warning to be logged for a spec with servers")
+			assert.True(t, strings.Contains(out, "Servers"), "warning should mention the Servers field, got: %q", out)
+			assert.Equal(t, http.StatusNoContent, validCode, "valid request should still pass validation")
+			assert.Equal(t, http.StatusBadRequest, invalidCode, "invalid request should still be rejected")
+		})
+	}
+}
+
+func TestRequestValidatorDoesNotWarnWithoutServers(t *testing.T) {
+	for name, build := range requestValidatorHandlers {
+		build := build
+		t.Run(name, func(t *testing.T) {
+			spec, err := openapi3.NewLoader().LoadFromData([]byte(requestValidatorSpecWithoutServers))
+			require.NoError(t, err)
+
+			out := captureDefaultLog(func() {
+				h := build(t, spec)
+				rec := httptest.NewRecorder()
+				h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "http://deepmap.ai/resource?id=1", nil))
+				assert.Equal(t, http.StatusNoContent, rec.Code)
+			})
+
+			assert.Empty(t, out, "no warning expected for a spec without servers")
+		})
+	}
+}
