+func TestNewState_ResourceProviderAndType(t *testing.T) {
+	ctx := context.Background()
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+
+	productRepo := mock.NewProductRepository(ctrl)
+	priceRepo := mock.NewPriceRepository(ctrl)
+	backend := mock.NewBackend(ctrl)
+	backend.EXPECT().Product().AnyTimes().Return(productRepo)
+	backend.EXPECT().Price().AnyTimes().Return(priceRepo)
+
+	queries := []query.Resource{
+		{
+			Address:  "module.instance.aws_instance.example",
+			Provider: "aws-test",
+			Type:     "aws_instance",
+			Components: []query.Component{
+				{
+					Name:           "Compute",
+					HourlyQuantity: decimal.NewFromInt(1),
+					ProductFilter: &product.Filter{
+						Provider: util.StringPtr("aws"),
+						Service:  util.StringPtr("AmazonEC2"),
+						Family:   util.StringPtr("Compute Instance"),
+						Location: util.StringPtr("eu-west-3"),
+						AttributeFilters: []*product.AttributeFilter{
+							{Key: "instanceType", Value: util.StringPtr("t3.micro")},
+						},
+					},
+				},
+			},
+		},
+		{
+			Address:  "module.instance.aws_s3_bucket.skipped",
+			Provider: "aws-test",
+			Type:     "aws_s3_bucket",
+		},
+	}
+
+	prod1 := &product.Product{ID: product.ID(1)}
+	productRepo.EXPECT().Filter(ctx, queries[0].Components[0].ProductFilter).Return([]*product.Product{prod1}, nil)
+	prc1 := &price.Price{Value: decimal.NewFromFloat(1.23), Unit: "Hrs"}
+	priceRepo.EXPECT().Filter(ctx, prod1.ID, queries[0].Components[0].PriceFilter).Return([]*price.Price{prc1}, nil)
+
+	state, err := cost.NewState(ctx, backend, queries)
+	require.NoError(t, err)
+
+	res, ok := state.Resources["module.instance.aws_instance.example"]
+	require.True(t, ok)
+	assert.Equal(t, "aws-test", res.Provider)
+	assert.Equal(t, "aws_instance", res.Type)
+
+	skipped, ok := state.Resources["module.instance.aws_s3_bucket.skipped"]
+	require.True(t, ok)
+	assert.Equal(t, "aws-test", skipped.Provider)
+	assert.Equal(t, "aws_s3_bucket", skipped.Type)
+}
+
+func TestPlan_ResourceDifferences_ProviderAndType(t *testing.T) {
+	prior := &cost.State{
+		Resources: map[string]cost.Resource{
+			"module.instance.aws_instance.example": {
+				Provider: "aws-test",
+				Type:     "aws_instance",
+				Components: map[string]cost.Component{
+					"Compute": {
+						Quantity: decimal.NewFromInt(730),
+						Unit:     "Hrs",
+						Rate:     cost.NewMonthly(decimal.NewFromFloat(1.23)),
+					},
+				},
+			},
+		},
+	}
+
+	plan := cost.NewPlan(prior, nil)
+	diffs := plan.ResourceDifferences()
+	require.Len(t, diffs, 1)
+	assert.Equal(t, "aws-test", diffs[0].Provider)
+	assert.Equal(t, "aws_instance", diffs[0].Type)
+
+	planned := &cost.State{
+		Resources: map[string]cost.Resource{
+			"module.instance.aws_s3_bucket.example": {
+				Provider:   "aws-test",
+				Type:       "aws_s3_bucket",
+				Components: map[string]cost.Component{"Storage": {}},
+			},
+		},
+	}
+	plannedOnlyDiffs := cost.NewPlan(nil, planned).ResourceDifferences()
+	require.Len(t, plannedOnlyDiffs, 1)
+	assert.Equal(t, "aws-test", plannedOnlyDiffs[0].Provider)
+	assert.Equal(t, "aws_s3_bucket", plannedOnlyDiffs[0].Type)
+}
