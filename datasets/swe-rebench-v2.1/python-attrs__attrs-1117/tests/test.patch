 """
 
 
+import inspect
 from collections import OrderedDict
 from typing import Generic, TypeVar
 
@@ -507,9 +508,7 @@ class TestAssoc:
         AttrsAttributeNotFoundError.
         """
         # No generated class will have a four letter attribute.
