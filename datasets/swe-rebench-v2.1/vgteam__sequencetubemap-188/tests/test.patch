+// Checks that a copied link points at the current page's origin (including
+// protocol) and carries exactly the given view parameters. Compares parsed
+// URL pieces rather than the serialized string, so equivalent spellings
+// (e.g. with or without a root "/" before the query) are accepted.
+function expectLinkForView(link, expectedQuery) {
+  let url = new URL(link);
+  expect(url.origin).toEqual(window.location.origin);
+  expect(url.protocol).toEqual(window.location.protocol);
+  const entries = (params) =>
+    Array.from(params.entries()).sort((a, b) => {
+      if (a[0] !== b[0]) return a[0] < b[0] ? -1 : 1;
+      if (a[1] !== b[1]) return a[1] < b[1] ? -1 : 1;
+      return 0;
+    });
+  expect(entries(url.searchParams)).toEqual(
+    entries(new URLSearchParams(expectedQuery))
+  );
+}
