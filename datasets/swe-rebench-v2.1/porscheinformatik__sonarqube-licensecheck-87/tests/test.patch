+    @Test
+    public void classifiedDependencyLoadsPomLicenseAndPublishesItsVersion() throws IOException
+    {
+        Path root = Files.createTempDirectory("classified-dependency");
+        Path repository = root.resolve("repository");
+        Path artifact = repository.resolve("at/porscheinformatik/test/classified/1.2.3");
+        Files.createDirectories(artifact);
+        Files.copy(new File("src/test/resources/test.pom").toPath(), artifact.resolve("classified-1.2.3.pom"));
+        try (JarOutputStream jar = new JarOutputStream(Files.newOutputStream(artifact.resolve("classified-1.2.3-sources.jar"))))
+        {
+            // The scanner only needs the artifact path produced by Maven's dependency listing.
+        }
+
+        Path module = root.resolve("module");
+        Files.createDirectories(module);
+        String pom = "<project xmlns=\"http://maven.apache.org/POM/4.0.0\" "
+            + "xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" "
+            + "xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 "
+            + "http://maven.apache.org/xsd/maven-4.0.0.xsd\">"
+            + "<modelVersion>4.0.0</modelVersion><groupId>fixture</groupId><artifactId>consumer</artifactId>"
+            + "<version>1.0</version><repositories><repository><id>fixture</id><url>"
+            + repository.toUri().toString() + "</url></repository></repositories>"
+            + "<dependencies><dependency><groupId>at.porscheinformatik.test</groupId>"
+            + "<artifactId>classified</artifactId><version>1.2.3</version><type>jar</type>"
+            + "<classifier>sources</classifier></dependency></dependencies></project>";
+        Files.write(module.resolve("pom.xml"), pom.getBytes(java.nio.charset.StandardCharsets.UTF_8));
+
+        MavenLicenseService licenseService = Mockito.mock(MavenLicenseService.class);
+        Map<Pattern, String> licenseMap = new HashMap<>();
+        licenseMap.put(Pattern.compile(".*Apache.*"), "Apache-2.0");
+        when(licenseService.getLicenseMap()).thenReturn(licenseMap);
+        MavenDependencyService dependencyService = Mockito.mock(MavenDependencyService.class);
+        when(dependencyService.getMavenDependencies()).thenReturn(java.util.Collections.emptyList());
+
+        Set<Dependency> dependencies = new MavenDependencyScanner(licenseService, dependencyService).scan(module.toFile());
+        Dependency classified = dependencies.stream()
+            .filter(d -> "at.porscheinformatik.test:classified".equals(d.getName()))
+            .findFirst().orElse(null);
+
+        assertThat(classified, Matchers.notNullValue());
+        assertThat(classified.getLicense(), is("Apache-2.0"));
+        List<Dependency> dashboardDependencies = Dependency.fromString(Dependency.createString(singletonList(classified)));
+        assertThat(dashboardDependencies.get(0).getVersion(), is("1.2.3"));
+    }
