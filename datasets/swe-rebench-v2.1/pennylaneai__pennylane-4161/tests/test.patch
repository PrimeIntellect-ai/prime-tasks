 class TestGrouping:
     """Tests for the grouping functionality"""
 
+    def test_indentities_preserved(self):
+        """Tests that the grouping indices do not drop identity terms when the wire order is nonstandard."""
+
+        obs = [qml.PauliZ(1), qml.PauliZ(0), qml.Identity(0)]
+
+        H = qml.Hamiltonian([1.0, 1.0, 1.0], obs, grouping_type="qwc")
+        grouped = sorted(idx for group in H.grouping_indices for idx in group)
+        assert grouped == [0, 1, 2]
+
+    def test_grouping_does_not_change_expectation_value(self):
+        """Tests that the expectation value of a Hamiltonian is the same regardless of
+        the ordering of its terms and whether grouping is applied."""
+
+        dev = qml.device("default.qubit", wires=2)
+
+        def expval(hamiltonian):
+            @qml.qnode(dev)
+            def circuit():
+                qml.Hadamard(wires=0)
+                return qml.expval(hamiltonian)
+
+            return circuit()
+
+        obs = [qml.PauliZ(1), qml.PauliZ(0), qml.Identity(0)]
+        coeffs = [1.0, 2.0, 3.0]
+
+        # reference value computed without grouping
+        reference = expval(qml.Hamiltonian(coeffs, obs))
+        assert np.allclose(reference, 4.0)
+
+        # grouping must not change the expectation value
+        assert np.allclose(expval(qml.Hamiltonian(coeffs, obs, grouping_type="qwc")), reference)
+        assert np.allclose(
+            expval(qml.Hamiltonian(coeffs, obs, grouping_type="commuting")), reference
+        )
+
+        # reordering the operators together with their coefficients must not change the value
+        reordered_obs = [qml.Identity(0), qml.PauliZ(0), qml.PauliZ(1)]
+        reordered_coeffs = [3.0, 2.0, 1.0]
+        assert np.allclose(
+            expval(qml.Hamiltonian(reordered_coeffs, reordered_obs, grouping_type="qwc")),
+            reference,
+        )
+        assert np.allclose(expval(qml.Hamiltonian(reordered_coeffs, reordered_obs)), reference)
+
     def test_grouping_is_correct_kwarg(self):
         """Basic test checking that grouping with a kwarg works as expected"""
