diff --git a/test/v3/runtime-core/componentProxy.spec.ts b/test/v3/runtime-core/componentProxy.spec.ts
new file mode 100644
index 0000000..8309ce7
--- /dev/null
+++ b/test/v3/runtime-core/componentProxy.spec.ts
@@ -0,0 +1,31 @@
+import { createApp, getCurrentInstance } from '../../../src'
+
+describe('component: root reference', () => {
+  test('exposes the root Vue instance through root.proxy', () => {
+    let rootInstance: any
+    let childInstance: any
+    let rootVm: any
+
+    const Child = {
+      setup() {
+        childInstance = getCurrentInstance()!
+      },
+      template: '<div></div>',
+    }
+    const Root = {
+      components: { Child },
+      setup() {
+        rootInstance = getCurrentInstance()!
+      },
+      mounted() {
+        rootVm = this
+      },
+      template: '<Child/>',
+    }
+
+    createApp(Root).mount(document.createElement('div'))
+
+    expect(rootInstance.root.proxy).toBe(rootVm.$root)
+    expect(childInstance.root.proxy).toBe(rootVm.$root)
+  })
+})
