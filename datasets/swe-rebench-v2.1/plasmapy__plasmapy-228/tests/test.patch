+def test_plasma_dispersion_func_large_argument_stability():
+    r"""The plasma dispersion function must remain accurate for large
+    arguments.
+
+    Evaluating the plasma dispersion function through the error
+    function, :math:`Z(\zeta) = i \sqrt{\pi} e^{-\zeta^2}
+    [1 + \mathrm{erf}(i \zeta)]`, suffers from catastrophic cancellation
+    and overflow for large :math:`|\zeta|`.  A numerically stable
+    special function (such as the Dawson or Faddeeva function) avoids
+    this.  For large :math:`|\zeta|` the plasma dispersion function
+    approaches the asymptotic expansion
+    :math:`Z(\zeta) \sim -1/\zeta - 1/(2 \zeta^3) - \ldots`.
+    """
+
+    for zeta in [9.2j, 20j, 30j, 1 + 30j, 5 + 20j]:
+
+        Z = plasma_dispersion_func(zeta)
+
+        assert np.all(np.isfinite(Z)), (
+            f"plasma_dispersion_func({zeta}) returned {Z}, which is not "
+            "finite.  The plasma dispersion function should remain finite "
+            "for large arguments.")
+
+        asymptotic = -1 / zeta - 1 / (2 * zeta**3)
+
+        assert np.isclose(Z, asymptotic, rtol=1e-3, atol=1e-6), (
+            f"plasma_dispersion_func({zeta}) equals {Z}, which does not "
+            f"match the asymptotic value {asymptotic} expected for large "
+            "arguments.  This indicates a loss of numerical accuracy.")
