+func TestZapLoggerInvokedLevel(t *testing.T) {
+	t.Parallel()
+
+	t.Run("Success", func(t *testing.T) {
+		t.Parallel()
+
+		core, observedLogs := observer.New(zap.DebugLevel)
+		(&ZapLogger{Logger: zap.New(core)}).LogEvent(&Invoked{FunctionName: "bytes.NewBuffer()"})
+
+		logs := observedLogs.TakeAll()
+		assert.True(t, hasLogAtLevel(logs, zap.InfoLevel), "expected an Info-level record")
+		assert.False(t, hasLogAtLevel(logs, zap.ErrorLevel), "successful invocation must not be logged at Error level")
+	})
+
+	t.Run("Error", func(t *testing.T) {
+		t.Parallel()
+
+		core, observedLogs := observer.New(zap.DebugLevel)
+		(&ZapLogger{Logger: zap.New(core)}).LogEvent(&Invoked{
+			FunctionName: "bytes.NewBuffer()",
+			Err:          errors.New("some error"),
+		})
+
+		logs := observedLogs.TakeAll()
+		assert.True(t, hasLogAtLevel(logs, zap.ErrorLevel), "expected an Error-level record")
+	})
+}
+
+func hasLogAtLevel(logs []observer.LoggedEntry, level zapcore.Level) bool {
+	for _, log := range logs {
+		if log.Level == level {
+			return true
+		}
+	}
+	return false
+}
+
 func joinLines(lines ...string) string {
 	return strings.Join(lines, "\n") + "\n"
 }
