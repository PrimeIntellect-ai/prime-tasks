diff --git a/test/test_gpmr.jl b/test/test_gpmr.jl
index 0a26985..4aad0c4 100644
--- a/test/test_gpmr.jl
+++ b/test/test_gpmr.jl
@@ -41,6 +41,47 @@
     @test_throws ErrorException("c must be nonzero") gpmr(A, B, b, c)
     b .= 0
     @test_throws ErrorException("b must be nonzero") gpmr(A, B, b, c)
+
+    # Test breakdowns
+    A, b, c = ssy_mo_breakdown(transpose)
+    λ = 1.0
+    μ = -1.0
+    K = [I A; A' -I]
+    d = [b; c]
+    breakdown_result = try
+      x, y, stats = gpmr(A, A', b, c, λ=λ, μ=μ)
+      r = d - K * [x; y]
+      (x=x, y=y, stats=stats, resid=norm(r) / norm(d))
+    catch err
+      err
+    end
+    if breakdown_result isa Exception
+      @test true
+    else
+      @test all(isfinite, breakdown_result.x)
+      @test all(isfinite, breakdown_result.y)
+      @test breakdown_result.resid ≤ gpmr_tol
+    end
+    # Test inconsistent linear systems
+    A, b, c = ssy_mo_breakdown(transpose)
+    K = [I A; A' I]
+    d = [b; c]
+    n, m = size(K)
+    p = rank(K)
+    @test(p < n)
+    breakdown_result = try
+      x, y, stats = gpmr(A, A', b, c, λ=1.0, μ=1.0)
+      (x=x, y=y, stats=stats)
+    catch err
+      err
+    end
+    if breakdown_result isa Exception
+      @test true
+    else
+      @test all(isfinite, breakdown_result.x)
+      @test all(isfinite, breakdown_result.y)
+      @test(breakdown_result.stats.inconsistent || !breakdown_result.stats.solved)
+    end
   end
 
