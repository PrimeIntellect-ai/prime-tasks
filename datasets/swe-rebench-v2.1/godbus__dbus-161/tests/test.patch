+func TestCloseChannelAfterRemoveSignal(t *testing.T) {
+	handler := NewDefaultSignalHandler()
+	bus, err := NewConn(nil, WithSignalHandler(handler))
+	if err != nil {
+		t.Fatal(err)
+	}
+	ch := make(chan *Signal)
+	bus.Signal(ch)
+
+	msg := &Signal{Path: ObjectPath("/baz"), Name: "foo.bar"}
+	// Leave several deliveries pending on this unbuffered channel.
+	for i := 0; i < 3; i++ {
+		handler.DeliverSignal("foo.bar", "bar", msg)
+	}
+
+	bus.RemoveSignal(ch)
+	close(ch)
+	// Let any incorrectly surviving deferred sends attempt their channel operation.
+	time.Sleep(10 * time.Millisecond)
+}
+
+func TestCloseBufferedChannelAfterRemoveSignal(t *testing.T) {
+	handler := NewDefaultSignalHandler()
+	bus, err := NewConn(nil, WithSignalHandler(handler))
+	if err != nil {
+		t.Fatal(err)
+	}
+	ch := make(chan *Signal, 1)
+	bus.Signal(ch)
+
+	msg := &Signal{Path: ObjectPath("/baz"), Name: "foo.bar"}
+	handler.DeliverSignal("foo.bar", "bar", msg) // Fill the buffer.
+	for i := 0; i < 32; i++ {
+		handler.DeliverSignal("foo.bar", "bar", msg)
+	}
+
+	bus.RemoveSignal(ch)
+	close(ch)
+	// Give deferred sends that were not canceled time to attempt the closed channel.
+	time.Sleep(10 * time.Millisecond)
+}
