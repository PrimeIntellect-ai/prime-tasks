+func Test_PruneRemoteTrackingBranchWhenDeletingBranches(t *testing.T) {
+	dir := t.TempDir()
+	remoteDir := filepath.Join(dir, "remote.git")
+	workDir := filepath.Join(dir, "work")
+
+	runCommand(t, dir, "git", "init", "--bare", remoteDir)
+	runCommand(t, dir, "git", "init", workDir)
+	runCommand(t, workDir, "git", "config", "user.email", "test@example.com")
+	runCommand(t, workDir, "git", "config", "user.name", "test")
+	runCommand(t, workDir, "git", "remote", "add", "origin", "file://"+remoteDir)
+
+	writeTestFile(t, filepath.Join(workDir, "README.md"), "init\n")
+	runCommand(t, workDir, "git", "add", "README.md")
+	runCommand(t, workDir, "git", "commit", "-m", "init")
+	runCommand(t, workDir, "git", "branch", "-M", "main")
+
+	runCommand(t, workDir, "git", "checkout", "-b", "topic")
+	writeTestFile(t, filepath.Join(workDir, "topic.txt"), "topic\n")
+	runCommand(t, workDir, "git", "add", "topic.txt")
+	runCommand(t, workDir, "git", "commit", "-m", "topic")
+	topicHead := strings.TrimSpace(runCommand(t, workDir, "git", "rev-parse", "HEAD"))
+
+	runCommand(t, workDir, "git", "push", "origin", "main")
+	runCommand(t, workDir, "git", "push", "origin", "topic")
+	runCommand(t, workDir, "git", "push", "origin", "--delete", "topic")
+	runCommand(t, workDir, "git", "update-ref", "refs/remotes/origin/topic", topicHead)
+
+	runCommand(t, workDir, "git", "checkout", "main")
+	runCommand(t, workDir, "git", "merge", "--ff-only", "topic")
+
+	binDir := filepath.Join(dir, "bin")
+	if err := os.MkdirAll(binDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	ghScript := fmt.Sprintf(`#!/bin/sh
+if [ "$1" = "repo" ]; then
+  cat <<'JSON'
+{
+  "defaultBranchRef": { "name": "main" },
+  "name": "repo",
+  "owner": { "id": "1", "login": "owner" },
+  "parent": null
+}
+JSON
+elif [ "$1" = "api" ]; then
+  case "$*" in
+    *graphql*)
+      cat <<'JSON'
+{"data":{"search":{"issueCount":1,"edges":[{"node":{"number":1,"url":"https://example.com/pull/1","state":"MERGED","isDraft":false,"headRefName":"topic","commits":{"nodes":[{"commit":{"oid":"%s"}}]},"author":{"login":"owner"}}}]}}}
+JSON
+      ;;
+  esac
+fi
+`, topicHead)
+	ghPath := filepath.Join(binDir, "gh")
+	writeTestFile(t, ghPath, ghScript)
+	if err := os.Chmod(ghPath, 0755); err != nil {
+		t.Fatal(err)
+	}
+
+	oldPath := os.Getenv("PATH")
+	os.Setenv("PATH", binDir+string(os.PathListSeparator)+oldPath)
+	defer os.Setenv("PATH", oldPath)
+
+	oldWd, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chdir(workDir); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Chdir(oldWd)
+
+	runMain(false)
+
+	remaining := strings.TrimSpace(runCommand(t, workDir, "git", "for-each-ref", "--format=%(refname)", "refs/remotes/origin/topic"))
+	assert.Equal(t, "", remaining)
+}
+
+func runCommand(t *testing.T, dir string, name string, args ...string) string {
+	t.Helper()
+	argv := append([]string{name}, args...)
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	proc, err := os.StartProcess(lookPath(name), argv, &os.ProcAttr{
+		Dir:   dir,
+		Files: []*os.File{os.Stdin, w, w},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.Close()
+	out, err := io.ReadAll(r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.Close()
+	state, err := proc.Wait()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !state.Success() {
+		t.Fatalf("command %s %v failed: %s", name, args, out)
+	}
+	return string(out)
+}
+
+func lookPath(name string) string {
+	for _, dir := range filepath.SplitList(os.Getenv("PATH")) {
+		if dir == "" {
+			continue
+		}
+		p := filepath.Join(dir, name)
+		if info, err := os.Stat(p); err == nil && !info.IsDir() {
+			return p
+		}
+	}
+	return name
+}
+
+func writeTestFile(t *testing.T, path string, content string) {
+	t.Helper()
+	if err := os.WriteFile(path, []byte(content), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
