+def test_parametrized_python_matrix_excludes_unsupported_cell(tmp_path):
+    noxfile = tmp_path / "noxfile.py"
+    run_log = tmp_path / "sessions.txt"
+    matrix = [("3.8", "0.9"), ("3.9", "0.9"), ("3.9", "1.0")]
+    noxfile.write_text(
+        "from nox import parametrize, session\n"
+        "\n"
+        "def record(*values):\n"
+        "    with open({!r}, 'a') as stream:\n"
+        "        stream.write('|'.join(str(value) for value in values) + '\\n')\n"
+        "\n"
+        "@session\n"
+        "@parametrize('python,dependency', {!r})\n"
+        "def selected_python(session, dependency):\n"
+        "    record('selected', session.python, dependency)\n"
+        "\n"
+        "@session\n"
+        "@parametrize('python,dependency', {!r})\n"
+        "def ordinary_python_argument(session, python, dependency):\n"
+        "    record('argument', session.python, python, dependency)\n".format(
+            str(run_log), matrix, matrix
+        )
+    )
+
+    completed = subprocess.run(
+        [
+            sys.executable,
+            "-m",
+            "nox",
+            "--no-venv",
+            "--noxfile",
+            str(noxfile),
+        ],
+        cwd=str(tmp_path),
+        capture_output=True,
+        text=True,
+    )
+
+    assert completed.returncode == 0, completed.stdout + completed.stderr
+    observed = sorted(run_log.read_text().splitlines())
+    expected = sorted(
+        [
+            "selected|3.8|0.9",
+            "selected|3.9|0.9",
+            "selected|3.9|1.0",
+            "argument|None|3.8|0.9",
+            "argument|None|3.9|0.9",
+            "argument|None|3.9|1.0",
+        ]
+    )
+    assert observed == expected
