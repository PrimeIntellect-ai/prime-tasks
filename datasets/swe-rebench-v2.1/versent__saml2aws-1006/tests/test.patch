+func setPublicField(t *testing.T, target interface{}, name string, value interface{}) {
+	t.Helper()
+	field := reflect.ValueOf(target).Elem().FieldByName(name)
+	if !field.IsValid() || !field.CanSet() {
+		t.Errorf("expected public field %s", name)
+		return
+	}
+	valueField := reflect.ValueOf(value)
+	if !valueField.Type().AssignableTo(field.Type()) {
+		t.Errorf("value for public field %s has incompatible type", name)
+		return
+	}
+	field.Set(valueField)
+}
