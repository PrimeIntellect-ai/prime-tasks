+def test_take_with_pandas_series_indices():
+    pd = pytest.importorskip('pandas')
+    values = np.arange(24).reshape((4, 6))
+    array = da.from_array(values, chunks=(2, 3))
+    indices = pd.Series([5, 1, 3])
+
+    result = da.take(array, indices, axis=1)
+
+    assert np.array_equal(result.compute(), values[:, [5, 1, 3]])
