@@ -2173,6 +2173,47 @@ class SortTogetherTest(TestCase):
             ],
         )
 
+    def test_strict(self):
+        # Test for list of lists or tuples
+        self.assertRaises(
+            mi.UnequalIterablesError,
+            lambda: mi.sort_together(
+                [(4, 3, 2, 1), ('a', 'b', 'c')], strict=True
+            ),
+        )
+
+        # Test for list of iterables
+        self.assertRaises(
+            mi.UnequalIterablesError,
+            lambda: mi.sort_together([range(4), range(5)], strict=True),
+        )
+
+        # Test for iterable of iterables
+        self.assertRaises(
+            mi.UnequalIterablesError,
+            lambda: mi.sort_together(
+                (range(i) for i in range(4)), strict=True
+            ),
+        )
+
+    def test_non_strict_truncates_generators(self):
+        """Without strict, unequal generator inputs are trimmed to the
+        shortest length instead of raising."""
+        iterables = [(4, 3, 2, 1), ('a', 'b', 'c')]
+        self.assertEqual(
+            mi.sort_together(iter(i) for i in iterables),
+            [(2, 3, 4), ('c', 'b', 'a')],
+        )
+
+    def test_strict_equal_lengths(self):
+        """With strict and equal-length iterables, all rows are returned in
+        the requested sorted order."""
+        iterables = [(4, 3, 2, 1), ('a', 'b', 'c', 'd')]
+        self.assertEqual(
+            mi.sort_together(iterables, strict=True),
+            [(1, 2, 3, 4), ('d', 'c', 'b', 'a')],
+        )
+
 
