+module TestDeprecate
+
+using Test
+using JuMP
+
+function runtests()
+    for name in names(@__MODULE__; all = true)
+        if startswith("$(name)", "test_")
+            @testset "$(name)" begin
+                getfield(@__MODULE__, name)()
+            end
+        end
+    end
+    return
+end
+
+function test_NonlinearExpression()
+    model = Model()
+    @variable(model, x)
+    @NLexpression(model, expr, sin(x))
+    @test expr.model === model
+    return
+end
+
+function test_NonlinearParameter()
+    model = Model()
+    @variable(model, x)
+    @NLparameter(model, p == 1)
+    @test p.model === model
+    return
+end
+
+function test_NLPEvaluator()
+    model = Model()
+    @variable(model, x)
+    @NLexpression(model, expr, sin(x))
+    d = JuMP.NLPEvaluator(model)
+    @test d.model === model
+    return
+end
+
+function test_value_NonlinearParameter()
+    model = Model()
+    @variable(model, x)
+    @NLparameter(model, p == 1)
+    @test value(p) == 1.0
+    set_value(p, 2)
+    @test value(p) == 2.0
+    return
+end
+
+function test_value_NonlinearExpression()
+    model = Model()
+    @variable(model, x)
+    @NLexpression(model, expr, sin(x))
+    @test value(expr, _ -> 2.0) ≈ sin(2.0)
+    return
+end
+
+function test_objective_expr_NLPEvaluator()
+    model = Model()
+    @variable(model, x)
+    @NLobjective(model, Min, sin(x))
+    d = JuMP.NLPEvaluator(model)
+    JuMP.MOI.initialize(d, [:ExprGraph])
+    @test occursin("sin", string(JuMP.MOI.objective_expr(d)))
+    return
+end
+
+end
+
+TestDeprecate.runtests()
