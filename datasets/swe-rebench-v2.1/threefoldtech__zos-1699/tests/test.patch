+// TestDiskCreateUsesLaterSSD verifies that actual disk creation uses a later
+// SSD pool when the first SSD pool cannot accommodate the disk.
+func TestDiskCreateUsesLaterSSD(t *testing.T) {
+	require := require.New(t)
+
+	firstVDisks := t.TempDir()
+	laterVDisks := t.TempDir()
+	pool1 := &testPool{
+		name: "pool-1",
+		usage: filesystem.Usage{
+			Size: 10000,
+			Used: 20000,
+		},
+		ptype: zos.SSDDevice,
+	}
+	pool2 := &testPool{
+		name: "pool-2",
+		usage: filesystem.Usage{
+			Size: 10000,
+			Used: 100,
+		},
+		ptype: zos.SSDDevice,
+	}
+	mod := Module{ssds: []filesystem.Pool{pool1, pool2}}
+
+	pool1.On("Volumes").Return([]filesystem.Volume{
+		&testVolume{name: vdiskVolumeName, path: firstVDisks},
+	}, nil)
+	pool2.On("Volumes").Return([]filesystem.Volume{
+		&testVolume{name: vdiskVolumeName, path: laterVDisks},
+	}, nil)
+
+	disk, err := mod.DiskCreate("new-disk", 1000)
+	if err != nil {
+		// Some filesystems do not support the virtual disk's NOCOW attribute.
+		// Allocation must still reach disk creation rather than report no space.
+		_, noSpace := errors.Cause(err).(pkg.ErrNotEnoughSpace)
+		require.False(noSpace, "later SSD has room for the requested disk")
+		return
+	}
+	require.Equal(laterVDisks, filepath.Dir(disk.Path))
+	info, err := os.Stat(disk.Path)
+	require.NoError(err)
+	require.Equal(int64(1000), info.Size())
+}
+
+// TestDiskCreateAllowsExactOverProvisionLimit checks that usage plus the new
+// disk may equal, but need not stay below, twice the pool size.
+func TestDiskCreateAllowsExactOverProvisionLimit(t *testing.T) {
+	volumePath := t.TempDir()
+	pool := &testPool{
+		name:  "pool-boundary",
+		usage: filesystem.Usage{Size: 5000, Used: 100},
+		ptype: zos.SSDDevice,
+	}
+	pool.On("Volumes").Return([]filesystem.Volume{
+		&testVolume{name: vdiskVolumeName, path: volumePath},
+	}, nil)
+	mod := Module{ssds: []filesystem.Pool{pool}}
+
+	disk, err := mod.DiskCreate("boundary-disk", 9900)
+	if err != nil {
+		_, noSpace := errors.Cause(err).(pkg.ErrNotEnoughSpace)
+		require.False(t, noSpace, "usage plus request equals twice the pool size")
+		return
+	}
+	require.Equal(t, int64(9900), disk.Size)
+}
