+// TestBtrfsPoolUsageReportsCurrentBytes exercises Usage through a real Btrfs
+// pool implementation while replacing only its external command responses.
+func TestBtrfsPoolUsageReportsCurrentBytes(t *testing.T) {
+	commands := t.TempDir()
+	mount := t.TempDir()
+	volumePath := filepath.Join(mount, "volume")
+	require.NoError(t, os.MkdirAll(volumePath, 0755))
+	const actualBytes = 137
+	require.NoError(t, os.WriteFile(filepath.Join(volumePath, "data"), make([]byte, actualBytes), 0644))
+
+	writeCommand := func(name, body string) {
+		path := filepath.Join(commands, name)
+		require.NoError(t, os.WriteFile(path, []byte("#!/bin/sh\n"+body), 0755))
+	}
+	writeCommand("lsblk", `printf '%s' '{"blockdevices":[{"path":"/dev/fakepool","name":"fakepool","size":100000,"fstype":"btrfs","label":"test-pool","rota":false}]}'`)
+	writeCommand("findmnt", `printf '%s' '{"filesystems":[{"source":"/dev/fakepool","target":"`+mount+`","options":"rw,subvol=/"}]}'`)
+	writeCommand("btrfs", `case "$1 $2" in
+  "subvolume list") printf '%s\n' 'ID 256 gen 1 top level 5 path volume' ;;
+  "subvolume show") printf '%s\n' 'Subvolume ID: 256' 'Parent ID: 5' 'Generation: 1' ;;
+  "qgroup show") printf '%s\n' 'qgroupid rfer excl max_rfer max_excl' '0/256 0 0 none none' ;;
+  "filesystem df") printf '%s\n' 'Data, single: total=8388608, used=65536' 'System, single: total=4194304, used=16384' 'Metadata, single: total=276824064, used=163840' 'GlobalReserve, single: total=16777216, used=0' ;;
+  *) echo "unexpected btrfs command: $*" >&2; false ;;
+esac`)
+	t.Setenv("PATH", commands+":"+os.Getenv("PATH"))
+
+	manager := filesystem.DefaultDeviceManager()
+	device, err := manager.Device(context.Background(), "/dev/fakepool")
+	require.NoError(t, err)
+	pool, err := filesystem.NewBtrfsPool(device)
+	require.NoError(t, err)
+
+	usage, err := pool.Usage()
+	require.NoError(t, err)
+	require.Equal(t, uint64(100000), usage.Size)
+	// Used may be measured as the bytes of the volume's files or as the pool's
+	// allocated data; either way it must account for the written data and not
+	// exceed the pool size.
+	require.GreaterOrEqual(t, usage.Used, uint64(actualBytes))
+	require.LessOrEqual(t, usage.Used, usage.Size)
+}
