+
+def test_compare_read_only_array():
+    # GH#57130
+    arr = np.array([1, 70, 100], dtype=object)
+    arr.flags.writeable = False
+    idx = pd.Index(arr)
+    result = idx > 69
+    assert isinstance(result, np.ndarray)
+    assert result.dtype == bool
+    np.testing.assert_array_equal(result, [False, True, True])
+
+
+def test_loc_read_only_index():
+    # GH#57130
+    values = [1, 70, 100]
+    arr = np.array(values, dtype=object)
+    arr.flags.writeable = False
+    read_only = pd.DataFrame({"b": ["a", "b", "c"]}, index=pd.Index(arr))
+    writable = pd.DataFrame({"b": ["a", "b", "c"]}, index=pd.Index(values, dtype=object))
+
+    result = read_only.loc[read_only.index > 69]
+    expected = writable.loc[writable.index > 69]
+    tm.assert_frame_equal(result, expected)
+    tm.assert_frame_equal(result, writable.iloc[[1, 2]])
+
+
+def test_loc_empty_read_sql_index_condition_copy_on_write():
+    # GH#57130
+    with pd.option_context("mode.copy_on_write", True):
+        con = sqlite3.connect(":memory:")
+        result = pd.read_sql(
+            sql="SELECT 1 AS a, 2 AS b WHERE FALSE",
+            con=con,
+            index_col="a",
+        )
+        expected = pd.DataFrame(columns=["b"], index=pd.Index([], name="a"))
+
+        result_selection = result.loc[result.index > 69]
+        expected_selection = expected.loc[expected.index > 69]
+
+    tm.assert_frame_equal(result, expected)
+    tm.assert_frame_equal(result_selection, expected_selection)
