+import { EvaluationContext, FlagNotFoundError, ProviderStatus, StandardResolutionReasons, TypeMismatchError } from '@openfeature/core';
+import * as clientSdk from '../src';
+
+const InMemoryProvider = (clientSdk as any).InMemoryProvider;
+
+describe('InMemoryProvider', () => {
+  it('is exposed by the client package entry point', () => {
+    expect(typeof InMemoryProvider).toBe('function');
+  });
+
+  describe('initialize', () => {
+    it('Should have provider status as NOT_READY after instantiation and emit READY and have READY state after initialuzation', async () => {
+      const booleanFlagSpec = {
+        'a-boolean-flag': {
+          variants: {
+            on: true,
+            off: false,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+        },
+      };
+      const provider = new InMemoryProvider(booleanFlagSpec);
+      expect(provider.status).toBe(ProviderStatus.NOT_READY);
+
+      await provider.initialize();
+      expect(provider.status).toBe(ProviderStatus.READY);
+
+    });
+
+
+  });
+
+  describe('boolean flags', () => {
+    it('resolves to default variant with reason static', async () => {
+      const booleanFlagSpec = {
+        'a-boolean-flag': {
+          variants: {
+            on: true,
+            off: false,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+        },
+      };
+
+      const provider = new InMemoryProvider(booleanFlagSpec);
+      const resolution = provider.resolveBooleanEvaluation('a-boolean-flag', true);
+
+      expect(resolution).toEqual({ value: true, reason: StandardResolutionReasons.STATIC, variant: 'on' });
+    });
+
+    it('throws FlagNotFound if flag does not exist', async () => {
+      const booleanFlagSpec = {
+        'a-boolean-flag': {
+          variants: {
+            on: true,
+            off: false,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(booleanFlagSpec);
+
+      expect(() => configuredProvider.resolveBooleanEvaluation('another-boolean-flag', false)).toThrow();
+    });
+
+    it('resolves to default value with reason disabled if flag is disabled', async () => {
+      const booleanFlagDisabledSpec = {
+        'a-boolean-flag': {
+          variants: {
+            on: true,
+            off: false,
+          },
+          disabled: true,
+          defaultVariant: 'on',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(booleanFlagDisabledSpec);
+
+      const resolution = configuredProvider.resolveBooleanEvaluation('a-boolean-flag', false);
+
+      expect(resolution).toEqual({ value: false, reason: StandardResolutionReasons.DISABLED });
+    });
+
+    it('throws an error if variant does not exist', async () => {
+      const booleanFlagSpec = {
+        'a-boolean-flag': {
+          variants: {
+            on: true,
+            off: false,
+          },
+          disabled: false,
+          defaultVariant: 'dummy',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(booleanFlagSpec);
+
+      expect(() => configuredProvider.resolveBooleanEvaluation('a-boolean-flag', false)).toThrow();
+    });
+
+    it('throws TypeMismatchError if variant type does not match with accessors', async () => {
+      const booleanFlagSpec = {
+        'a-boolean-flag': {
+          variants: {
+            on: 'yes',
+            off: 'no',
+          },
+          disabled: false,
+          defaultVariant: 'on',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(booleanFlagSpec);
+
+      expect(() => configuredProvider.resolveBooleanEvaluation('a-boolean-flag', false)).toThrow(TypeMismatchError);
+    });
+
+    it('resolves to variant value with reason target match if context is provided and flag spec has context evaluator', async () => {
+      const booleanFlagCtxSpec = {
+        'a-boolean-flag': {
+          variants: {
+            on: true,
+            off: false,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+          contextEvaluator: () => 'off',
+        },
+      };
+      const dummyContext = {};
+      const configuredProvider = new InMemoryProvider(booleanFlagCtxSpec);
+
+      const resolution = configuredProvider.resolveBooleanEvaluation('a-boolean-flag', true, dummyContext);
+
+      expect(resolution).toEqual({ value: false, reason: StandardResolutionReasons.TARGETING_MATCH, variant: 'off' });
+    });
+  });
+
+  describe('string flags', () => {
+    const itsDefault = "it's deafault";
+    const itsOn = "it's on";
+    const itsOff = "it's off";
+    it('resolves to default variant with reason static', async () => {
+      const stringFlagSpec = {
+        'a-string-flag': {
+          variants: {
+            on: itsOn,
+            off: itsOff,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(stringFlagSpec);
+
+      const resolution = configuredProvider.resolveStringEvaluation('a-string-flag', itsDefault);
+
+      expect(resolution).toEqual({ value: itsOn, reason: StandardResolutionReasons.STATIC, variant: 'on' });
+    });
+
+    it('throws FlagNotFound if flag does not exist', async () => {
+      const StringFlagSpec = {
+        'a-string-flag': {
+          variants: {
+            on: true,
+            off: false,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+        },
+      };
+
+      const configuredProvider = new InMemoryProvider(StringFlagSpec);
+
+      expect(() => configuredProvider.resolveStringEvaluation('another-string-flag', itsDefault)).toThrow(FlagNotFoundError);
+    });
+
+    it('resolves to default value with reason disabled if flag is disabled', async () => {
+      const StringFlagDisabledSpec = {
+        'a-string-flag': {
+          variants: {
+            on: itsOn,
+            off: itsOff,
+          },
+          disabled: true,
+          defaultVariant: 'on',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(StringFlagDisabledSpec);
+
+      const resolution = configuredProvider.resolveStringEvaluation('a-string-flag', itsDefault);
+
+      expect(resolution).toEqual({ value: itsDefault, reason: StandardResolutionReasons.DISABLED });
+    });
+
+    it('throws an error if variant does not exist', async () => {
+      const StringFlagSpec = {
+        'a-string-flag': {
+          variants: {
+            on: itsOn,
+            off: itsOff,
+          },
+          disabled: false,
+          defaultVariant: 'dummy',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(StringFlagSpec);
+
+      expect(() => configuredProvider.resolveStringEvaluation('a-string-flag', itsDefault)).toThrow();
+    });
+
+    it('throws TypeMismatchError if variant does not match with accessor method type', async () => {
+      const StringFlagSpec = {
+        'a-string-flag': {
+          variants: {
+            on: true,
+            off: false,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+        },
+      };
+
+      const configuredProvider = new InMemoryProvider(StringFlagSpec);
+
+      expect(() => configuredProvider.resolveStringEvaluation('a-string-flag', itsDefault)).toThrow(TypeMismatchError);
+    });
+
+    it('resolves to variant value with reason target match if context is provided and flag spec has context evaluator', async () => {
+      const StringFlagCtxSpec = {
+        'a-string-flag': {
+          variants: {
+            on: itsOn,
+            off: itsOff,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+          contextEvaluator: () => 'off',
+        },
+      };
+      const dummyContext = {};
+      const configuredProvider = new InMemoryProvider(StringFlagCtxSpec);
+
+      const resolution = configuredProvider.resolveStringEvaluation('a-string-flag', itsDefault, dummyContext);
+
+      expect(resolution).toEqual({ value: itsOff, reason: StandardResolutionReasons.TARGETING_MATCH, variant: 'off' });
+    });
+  });
+
+  describe('number flags', () => {
+    const defaultNumber = 42;
+    const onNumber = -528;
+    const offNumber = 0;
+    it('resolves to default variant with reason static', async () => {
+      const numberFlagSpec = {
+        'a-number-flag': {
+          variants: {
+            on: onNumber,
+            off: offNumber,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(numberFlagSpec);
+
+      const resolution = configuredProvider.resolveNumberEvaluation('a-number-flag', defaultNumber);
+
+      expect(resolution).toEqual({ value: onNumber, reason: StandardResolutionReasons.STATIC, variant: 'on' });
+    });
+
+    it('throws FlagNotFound if flag does not exist', async () => {
+      const numberFlagSpec = {
+        'a-number-flag': {
+          variants: {
+            on: onNumber,
+            off: offNumber,
+          },
+          disabled: false,
+          defaultVariant: 'dummy',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(numberFlagSpec);
+
+      expect(() => configuredProvider.resolveNumberEvaluation('another-number-flag', defaultNumber)).toThrow(FlagNotFoundError);
+    });
+
+    it('resolves to default value with reason disabled if flag is disabled', async () => {
+      const numberFlagDisabledSpec = {
+        'a-number-flag': {
+          variants: {
+            on: onNumber,
+            off: offNumber,
+          },
+          disabled: true,
+          defaultVariant: 'on',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(numberFlagDisabledSpec);
+
+      const resolution = configuredProvider.resolveNumberEvaluation('a-number-flag', defaultNumber);
+
+      expect(resolution).toEqual({ value: defaultNumber, reason: StandardResolutionReasons.DISABLED });
+    });
+
+    it('throws an error if variant does not exist', async () => {
+      const numberFlagSpec = {
+        'a-number-flag': {
+          variants: {
+            on: onNumber,
+            off: offNumber,
+          },
+          disabled: false,
+          defaultVariant: 'dummy',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(numberFlagSpec);
+
+      expect(() => configuredProvider.resolveNumberEvaluation('a-number-flag', defaultNumber)).toThrow();
+    });
+
+    it('throws TypeMismatchError if variant does not match with accessor method type', async () => {
+      const numberFlagSpec = {
+        'a-number-flag': {
+          variants: {
+            on: true,
+            off: false,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+        },
+      };
+
+      const configuredProvider = new InMemoryProvider(numberFlagSpec);
+
+      expect(() => configuredProvider.resolveNumberEvaluation('a-number-flag', defaultNumber)).toThrow(TypeMismatchError);
+    });
+
+    it('resolves to variant value with reason target match if context is provided and flag spec has context evaluator', async () => {
+      const numberFlagCtxSpec = {
+        'a-number-flag': {
+          variants: {
+            on: onNumber,
+            off: offNumber,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+          contextEvaluator: () => 'off',
+        },
+      };
+      const dummyContext = {};
+      const configuredProvider = new InMemoryProvider(numberFlagCtxSpec);
+
+      const resolution = configuredProvider.resolveNumberEvaluation('a-number-flag', defaultNumber, dummyContext);
+
+      expect(resolution).toEqual({
+        value: offNumber,
+        reason: StandardResolutionReasons.TARGETING_MATCH,
+        variant: 'off',
+      });
+    });
+  });
+
+  describe('Object flags', () => {
+    const defaultObject = { someKey: 'default' };
+    const onObject = { someKey: 'on' };
+    const offObject = { someKey: 'off' };
+    it('resolves to default variant with reason static', async () => {
+      const ObjectFlagSpec = {
+        'a-object-flag': {
+          variants: {
+            on: onObject,
+            off: offObject,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(ObjectFlagSpec);
+
+      const resolution = configuredProvider.resolveObjectEvaluation('a-object-flag', defaultObject);
+
+      expect(resolution).toEqual({ value: onObject, reason: StandardResolutionReasons.STATIC, variant: 'on' });
+    });
+
+    it('throws FlagNotFound if flag does not exist', async () => {
+      const ObjectFlagSpec = {
+        'a-Object-flag': {
+          variants: {
+            on: onObject,
+            off: offObject,
+          },
+          disabled: false,
+          defaultVariant: 'dummy',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(ObjectFlagSpec);
+
+      expect(() => configuredProvider.resolveObjectEvaluation('another-number-flag', defaultObject)).toThrow(FlagNotFoundError);
+    });
+
+    it('resolves to default value with reason disabled if flag is disabled', async () => {
+      const ObjectFlagDisabledSpec = {
+        'a-object-flag': {
+          variants: {
+            on: onObject,
+            off: offObject,
+          },
+          disabled: true,
+          defaultVariant: 'on',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(ObjectFlagDisabledSpec);
+
+      const resolution = configuredProvider.resolveObjectEvaluation('a-object-flag', defaultObject);
+
+      expect(resolution).toEqual({ value: defaultObject, reason: StandardResolutionReasons.DISABLED });
+    });
+
+    it('throws an error if variant does not exist', async () => {
+      const ObjectFlagSpec = {
+        'a-Object-flag': {
+          variants: {
+            on: onObject,
+            off: offObject,
+          },
+          disabled: false,
+          defaultVariant: 'dummy',
+        },
+      };
+      const configuredProvider = new InMemoryProvider(ObjectFlagSpec);
+
+      expect(() => configuredProvider.resolveObjectEvaluation('a-Object-flag', defaultObject)).toThrow();
+    });
+
+    it('throws TypeMismatchError if variant does not match with accessor method type', async () => {
+      const ObjectFlagSpec = {
+        'a-object-flag': {
+          variants: {
+            on: true,
+            off: false,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+        },
+      };
+
+      const configuredProvider = new InMemoryProvider(ObjectFlagSpec);
+
+      expect(() => configuredProvider.resolveObjectEvaluation('a-object-flag', defaultObject)).toThrow(TypeMismatchError);
+    });
+
+    it('resolves to variant value with reason target match if context is provided and flag spec has context evaluator', async () => {
+      const ObjectFlagCtxSpec = {
+        'a-object-flag': {
+          variants: {
+            on: onObject,
+            off: offObject,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+          contextEvaluator: () => 'off',
+        },
+      };
+      const dummyContext = {};
+      const configuredProvider = new InMemoryProvider(ObjectFlagCtxSpec);
+
+      const resolution = configuredProvider.resolveObjectEvaluation('a-object-flag', defaultObject, dummyContext);
+
+      expect(resolution).toEqual({
+        value: offObject,
+        reason: StandardResolutionReasons.TARGETING_MATCH,
+        variant: 'off',
+      });
+    });
+  });
+
+  describe('context propagation', () => {
+    it('forwards the supplied context for string, number, and object resolution', () => {
+      const contextEvaluator = (ctx: EvaluationContext) => (ctx.targetingKey === 'match' ? 'match' : 'default');
+      const provider = new InMemoryProvider({
+        'a-string-flag': {
+          variants: { default: 'default', match: 'matched' },
+          disabled: false,
+          defaultVariant: 'default',
+          contextEvaluator,
+        },
+        'a-number-flag': {
+          variants: { default: 1, match: 42 },
+          disabled: false,
+          defaultVariant: 'default',
+          contextEvaluator,
+        },
+        'an-object-flag': {
+          variants: { default: { selected: 'default' }, match: { selected: 'match' } },
+          disabled: false,
+          defaultVariant: 'default',
+          contextEvaluator,
+        },
+      });
+      const context = { targetingKey: 'match' };
+
+      expect([
+        provider.resolveStringEvaluation('a-string-flag', '', context).value,
+        provider.resolveNumberEvaluation('a-number-flag', 0, context).value,
+        provider.resolveObjectEvaluation('an-object-flag', {}, context).value,
+      ]).toEqual(['matched', 42, { selected: 'match' }]);
+    });
+
+    it('passes the supplied context to the contextEvaluator during resolution', async () => {
+      const provider = new InMemoryProvider({
+        'a-boolean-flag': {
+          variants: {
+            on: true,
+            off: false,
+          },
+          disabled: false,
+          defaultVariant: 'on',
+          contextEvaluator: (ctx: EvaluationContext) => (ctx.targetingKey === 'match' ? 'off' : 'on'),
+        },
+      });
+
+      const resolution = provider.resolveBooleanEvaluation('a-boolean-flag', true, { targetingKey: 'match' });
+
+      expect(resolution).toEqual({ value: false, reason: StandardResolutionReasons.TARGETING_MATCH, variant: 'off' });
+    });
+  });
+
+  describe('logger', () => {
+    let provider: any;
+    beforeEach(() => {
+      provider = new InMemoryProvider({});
+    });
+    const createLogger = () => ({
+      error: jest.fn(),
+      warn: jest.fn(),
+      info: jest.fn(),
+      debug: jest.fn(),
+    });
+
+    it('accepts and uses a logger for boolean resolution', async () => {
+      const logger = createLogger();
+
+      expect(() => provider.resolveBooleanEvaluation('missing-flag', false, undefined, logger)).toThrow(
+        FlagNotFoundError,
+      );
+      expect(logger.debug).toHaveBeenCalled();
+    });
+
+    it('accepts and uses a logger for string resolution', async () => {
+      const logger = createLogger();
+
+      expect(() => provider.resolveStringEvaluation('missing-flag', 'default', undefined, logger)).toThrow(
+        FlagNotFoundError,
+      );
+      expect(logger.debug).toHaveBeenCalled();
+    });
+
+    it('accepts and uses a logger for number resolution', async () => {
+      const logger = createLogger();
+
+      expect(() => provider.resolveNumberEvaluation('missing-flag', 1, undefined, logger)).toThrow(FlagNotFoundError);
+      expect(logger.debug).toHaveBeenCalled();
+    });
+
+    it('accepts and uses a logger for object resolution', async () => {
+      const logger = createLogger();
+
+      expect(() => provider.resolveObjectEvaluation('missing-flag', { someKey: 'default' }, undefined, logger)).toThrow(
+        FlagNotFoundError,
+      );
+      expect(logger.debug).toHaveBeenCalled();
+    });
+
+    it('reports a missing variant to the supplied logger', async () => {
+      const provider = new InMemoryProvider({
+        'a-boolean-flag': {
+          variants: {
+            on: true,
+            off: false,
+          },
+          disabled: false,
+          defaultVariant: 'dummy',
+        },
+      });
+      const logger = createLogger();
+
+      expect(() => provider.resolveBooleanEvaluation('a-boolean-flag', false, undefined, logger)).toThrow();
+      expect(logger.error).toHaveBeenCalled();
+    });
+  });
+});
