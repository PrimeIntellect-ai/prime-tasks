+    def test_toml_no_psr_section(self):
+        with tempfile.TemporaryDirectory() as project_dir:
+            toml_path = os.path.join(project_dir, "pyproject.toml")
+            with open(toml_path, "w") as toml_file:
+                toml_file.write('[tool.foo]\nbar = "baz"\n')
+
+            previous_dir = os.getcwd()
+            try:
+                os.chdir(project_dir)
+                importlib.reload(settings)
+                config = settings.config
+            finally:
+                os.chdir(previous_dir)
+                importlib.reload(settings)
+
+        self.assertEqual(config.get("hvcs"), "github")
+
+    def test_toml_without_psr_section_preserves_setup_cfg(self):
+        with tempfile.TemporaryDirectory() as project_dir:
+            with open(os.path.join(project_dir, "pyproject.toml"), "w") as toml_file:
+                toml_file.write('[tool.other]\nvalue = "ignored by semantic release"\n')
+            with open(os.path.join(project_dir, "setup.cfg"), "w") as ini_file:
+                ini_file.write(
+                    "[semantic_release]\n"
+                    "version_variable = package/__init__.py:__version__\n"
+                )
+
+            previous_dir = os.getcwd()
+            try:
+                os.chdir(project_dir)
+                importlib.reload(settings)
+                config = settings.config
+            finally:
+                os.chdir(previous_dir)
+                importlib.reload(settings)
+
+        self.assertEqual(
+            config.get("version_variable"), "package/__init__.py:__version__"
+        )
+        self.assertEqual(config.get("hvcs"), "github")
+
