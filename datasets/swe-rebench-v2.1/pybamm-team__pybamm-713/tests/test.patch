+    def test_neg_pos_bcs(self):
+        # 2d macroscale
+        mesh = get_1p1d_mesh_for_testing()
+        spatial_methods = {
+            "macroscale": pybamm.FiniteVolume,
+            "negative particle": pybamm.FiniteVolume,
+            "positive particle": pybamm.FiniteVolume,
+            "current collector": pybamm.FiniteVolume,
+        }
+        disc = pybamm.Discretisation(mesh, spatial_methods)
+
+        # var
+        var = pybamm.Variable("var", domain="current collector")
+        disc.set_variable_slices([var])
+        # grad
+        grad_eqn = pybamm.grad(var)
+
+        # bcs (on each tab)
+        boundary_conditions = {
+            var.id: {
+                "negative tab": (pybamm.Scalar(1), "Dirichlet"),
+                "positive tab": (pybamm.Scalar(0), "Neumann"),
+                "no tab": (pybamm.Scalar(8), "Dirichlet"),
+            }
+        }
+        disc.bcs = boundary_conditions
+
+        # check after disc that negative tab goes to left and positive tab goes
+        # to right
+        disc.process_symbol(grad_eqn)
+        self.assertEqual(disc.bcs[var.id]["left"][0].id, pybamm.Scalar(1).id)
+        self.assertEqual(disc.bcs[var.id]["left"][1], "Dirichlet")
+        self.assertEqual(disc.bcs[var.id]["right"][0].id, pybamm.Scalar(0).id)
+        self.assertEqual(disc.bcs[var.id]["right"][1], "Neumann")
+
+    def test_no_tab_bc(self):
+        # When a "no tab" boundary condition accompanies a condition for a
+        # single tab, the "no tab" condition must be applied to the opposite
+        # side that does not have a tab.
+        mesh = get_1p1d_mesh_for_testing()
+        spatial_methods = {
+            "macroscale": pybamm.FiniteVolume,
+            "negative particle": pybamm.FiniteVolume,
+            "positive particle": pybamm.FiniteVolume,
+            "current collector": pybamm.FiniteVolume,
+        }
+        disc = pybamm.Discretisation(mesh, spatial_methods)
+
+        var = pybamm.Variable("var", domain="current collector")
+        disc.set_variable_slices([var])
+        grad_eqn = pybamm.grad(var)
+
+        # negative tab is at "left" in this mesh, so the "no tab" condition
+        # must be applied to "right"
+        disc.bcs = {
+            var.id: {
+                "negative tab": (pybamm.Scalar(1), "Dirichlet"),
+                "no tab": (pybamm.Scalar(8), "Neumann"),
+            }
+        }
+        disc.process_symbol(grad_eqn)
+        self.assertEqual(disc.bcs[var.id]["left"][0].id, pybamm.Scalar(1).id)
+        self.assertEqual(disc.bcs[var.id]["left"][1], "Dirichlet")
+        self.assertEqual(disc.bcs[var.id]["right"][0].id, pybamm.Scalar(8).id)
+        self.assertEqual(disc.bcs[var.id]["right"][1], "Neumann")
+
+        # positive tab is at "right" in this mesh, so the "no tab" condition
+        # must be applied to "left"
+        disc.bcs = {
+            var.id: {
+                "positive tab": (pybamm.Scalar(2), "Neumann"),
+                "no tab": (pybamm.Scalar(9), "Dirichlet"),
+            }
+        }
+        disc.process_symbol(grad_eqn)
+        self.assertEqual(disc.bcs[var.id]["right"][0].id, pybamm.Scalar(2).id)
+        self.assertEqual(disc.bcs[var.id]["right"][1], "Neumann")
+        self.assertEqual(disc.bcs[var.id]["left"][0].id, pybamm.Scalar(9).id)
+        self.assertEqual(disc.bcs[var.id]["left"][1], "Dirichlet")
 
