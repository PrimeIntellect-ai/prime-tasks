diff --git a/tests/test_secretsmanager/test_secrets_duplication.py b/tests/test_secretsmanager/test_secrets_duplication.py
new file mode 100644
index 000000000..13cea0061
--- /dev/null
+++ b/tests/test_secretsmanager/test_secrets_duplication.py
@@ -0,0 +1,23 @@
+import boto3
+
+from moto import mock_aws
+
+
+@mock_aws
+def test_filter_with_primary_region():
+    primary_region = boto3.client("secretsmanager", region_name="us-east-1")
+    primary_region.create_secret(
+        Name="replicated", SecretString="secret", AddReplicaRegions=[{"Region": "us-east-2"}]
+    )
+
+    replica_region = boto3.client("secretsmanager", region_name="us-east-2")
+    matching_replicas = replica_region.list_secrets(
+        Filters=[{"Key": "primary-region", "Values": ["us-east-1"]}]
+    )["SecretList"]
+    assert {secret["Name"] for secret in matching_replicas} == {"replicated"}
+    assert matching_replicas[0]["PrimaryRegion"] == "us-east-1"
+
+    nonmatching_replicas = replica_region.list_secrets(
+        Filters=[{"Key": "primary-region", "Values": ["us-east-2"]}]
+    )["SecretList"]
+    assert nonmatching_replicas == []
