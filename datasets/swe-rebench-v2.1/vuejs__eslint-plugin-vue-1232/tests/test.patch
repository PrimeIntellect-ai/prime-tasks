+/**
+ * @author Yosuke Ota <https://github.com/ota-meshi>
+ * See LICENSE file in root directory for full license.
+ */
+'use strict'
+
+const Linter = require('eslint').Linter
+const parser = require('vue-eslint-parser')
+const rules = require('../..').rules
+
+describe("Don't crash even if without vue SFC.", () => {
+  const code = 'var a = 1'
+
+  const ruleIds = [
+    'vue/no-empty-component-block',
+    'vue/padding-line-between-blocks'
+  ]
+
+  for (const ruleId of ruleIds) {
+    it(ruleId, () => {
+      const linter = new Linter()
+      const config = {
+        parser: 'vue-eslint-parser',
+        parserOptions: { ecmaVersion: 2015 },
+        rules: {
+          [ruleId]: 'error'
+        }
+      }
+      linter.defineParser('vue-eslint-parser', parser)
+      linter.defineRule(ruleId, rules[ruleId.replace('vue/', '')])
+      linter.verifyAndFix(code, config, 'test.js')
+    })
+  }
+})
+
+describe('ParserServices.getDocumentFragment type', () => {
+  it('allows a null return value', () => {
+    const path = require('path')
+    const assert = require('assert')
+    const ts = require('typescript')
+
+    const cwd = path.resolve(__dirname, '..', '..')
+    const configFile = ts.readConfigFile(
+      path.join(cwd, 'tsconfig.json'),
+      ts.sys.readFile
+    )
+    const parsed = ts.parseJsonConfigFileContent(configFile.config, ts.sys, cwd)
+    const program = ts.createProgram(
+      [
+        path.join(
+          cwd,
+          'typings/eslint-plugin-vue/util-types/parser-services.ts'
+        )
+      ],
+      parsed.options
+    )
+    const checker = program.getTypeChecker()
+    const sourceFile = program.getSourceFile(
+      path.join(cwd, 'typings/eslint-plugin-vue/util-types/parser-services.ts')
+    )
+    assert(sourceFile, 'parser-services typings should exist')
+
+    let iface
+    ts.forEachChild(sourceFile, function visit(node) {
+      if (
+        ts.isInterfaceDeclaration(node) &&
+        node.name.text === 'ParserServices'
+      ) {
+        iface = node
+        return
+      }
+      ts.forEachChild(node, visit)
+    })
+    assert(iface, 'ParserServices interface should exist')
+
+    const symbol = checker.getSymbolAtLocation(iface.name)
+    const type = checker.getDeclaredTypeOfSymbol(symbol)
+    const prop = type.getProperty('getDocumentFragment')
+    assert(prop, 'getDocumentFragment should be declared')
+
+    const propType = checker.getTypeOfSymbolAtLocation(prop, iface)
+    const callable = checker.getNonNullableType(propType)
+    const signatures = callable.getCallSignatures()
+    assert(signatures.length > 0, 'getDocumentFragment should be callable')
+
+    const returnType = signatures[0].getReturnType()
+    assert(
+      checker.isTypeAssignableTo(checker.getNullType(), returnType),
+      `getDocumentFragment return type should allow null, got ${checker.typeToString(
+        returnType
+      )}`
+    )
+  })
+})
