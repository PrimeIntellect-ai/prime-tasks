+    def test_habitat_quality_exponential_decay(self):
+        """Habitat Quality: exponential decay uses the UG formula.
+
+        The User's Guide specifies that threats decay exponentially as
+        ``exp(-(2.99 / max_dist) * dist)``.  With a single threat pixel and
+        uniform sensitivity, the ratio of the degradation at two pixels at
+        known distances from the threat is therefore
+        ``exp(-2.99 * (d1 - d2) / max_dist)``, independent of how the decay
+        is aggregated over space.
+        """
+        from natcap.invest import habitat_quality
+
+        args = {
+            'half_saturation_constant': '0.5',
+            'workspace_dir': self.workspace_dir,
+            'n_workers': -1,
+        }
+
+        args['sensitivity_table_path'] = os.path.join(
+            args['workspace_dir'], 'sensitivity_samp.csv')
+        with open(args['sensitivity_table_path'], 'w') as open_table:
+            open_table.write('LULC,HABITAT,threat_1\n')
+            open_table.write('1,1.0,1.0\n')
+
+        args['lulc_cur_path'] = os.path.join(
+            args['workspace_dir'], 'lc_samp_cur_b.tif')
+        lulc_array = numpy.ones((100, 100), dtype=numpy.int8)
+        make_raster_from_array(lulc_array, args['lulc_cur_path'])
+
+        # A single threat pixel at (50, 50).
+        threat_array = numpy.zeros((100, 100), dtype=numpy.int8)
+        threat_array[50, 50] = 1
+        make_raster_from_array(
+            threat_array,
+            os.path.join(args['workspace_dir'], 'threat_1_c.tif'))
+
+        args['threats_table_path'] = os.path.join(
+            args['workspace_dir'], 'threats_samp.csv')
+        with open(args['threats_table_path'], 'w') as open_table:
+            open_table.write(
+                'MAX_DIST,WEIGHT,THREAT,DECAY,BASE_PATH,CUR_PATH,FUT_PATH\n')
+            open_table.write(
+                '0.07,1.0,threat_1,exponential,,threat_1_c.tif,\n')
+
+        habitat_quality.execute(args)
+
+        deg_sum_dataset = gdal.Open(os.path.join(
+            args['workspace_dir'], 'deg_sum_c.tif'))
+        deg_sum = deg_sum_dataset.GetRasterBand(1).ReadAsArray()
+
+        # The rasters use a 1m pixel size, so pixel distances equal distances
+        # in meters.  max_dist is 0.07km = 70m.
+        max_dist_m = 0.07 * 1000.0
+        d1 = 10.0  # distance from (50, 50) to (50, 60)
+        d2 = 30.0  # distance from (50, 50) to (50, 80)
+        expected_ratio = numpy.exp(-2.99 * (d1 - d2) / max_dist_m)
+        numpy.testing.assert_allclose(
+            deg_sum[50, 60] / deg_sum[50, 80], expected_ratio, rtol=1e-4)
+
