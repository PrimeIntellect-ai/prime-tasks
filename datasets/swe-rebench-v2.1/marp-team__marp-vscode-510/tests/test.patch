+  it('exports the text from a clean non-UTF-8 file correctly', async () => {
+    const directory = mkdtempSync(path.join(tmpdir(), 'marp-vscode-encoding-'))
+    const writeFileMock = jest
+      .spyOn(workspace.fs, 'writeFile')
+      .mockImplementation(async (uri, content) => {
+        writeFileSync(uri.fsPath, content)
+      })
+    const deleteMock = jest
+      .spyOn(workspace.fs, 'delete')
+      .mockImplementation(async (uri) => {
+        rmSync(uri.fsPath, { force: true })
+      })
+
+    try {
+      const workFile = await createWorkFile({
+        getText: jest.fn(() => '🐣'),
+        isDirty: false,
+        uri: { scheme: 'file', fsPath: path.join(directory, 'clean.md') },
+        encoding: 'utf16le',
+      } as any)
+
+      // A suitable temporary location is not tied to a particular directory.
+      expect(workFile.path).not.toBe(path.join(directory, 'clean.md'))
+
+      const outputPath = path.join(directory, 'slides.html')
+      await marpCliModule.marpCli([workFile.path, '--output', outputPath])
+      expect(readFileSync(outputPath, 'utf8')).toContain('🐣')
+
+      await workFile.cleanup()
+      expect(existsSync(workFile.path)).toBe(false)
+    } finally {
+      writeFileMock.mockRestore()
+      deleteMock.mockRestore()
+      rmSync(directory, { recursive: true, force: true })
+    }
+  })
