+def test_overlay_invalid_input():
+    invalid_polygon = Polygon([(0, 0), (1, 1), (1, 2), (1, 1), (0, 0)])
+    square = Polygon(((0, 0), (1, 0), (1, 1), (0, 1), (0, 0)))
+    df1 = geopandas.GeoDataFrame({"A": [1, 2]}, geometry=[invalid_polygon, square])
+    df2 = geopandas.GeoDataFrame({"B": [5, 6]}, geometry=[square, square])
+
+    result = df1.overlay(df2, keep_geom_type=True)
+
+    # Repairing the invalid polygon must not change the geometry family used
+    # to filter the result: the left input is polygonal.
+    assert not result.empty
+    assert result.geom_type.isin(["Polygon", "MultiPolygon"]).all()
+
