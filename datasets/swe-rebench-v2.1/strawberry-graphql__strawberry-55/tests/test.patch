+import strawberry
+
+
+def _normalize(representation):
+    return " ".join(representation.split())
+
+
+def test_interface():
+    @strawberry.interface
+    class Node:
+        id: strawberry.ID
+
+    node = Node("a")
+    representation = _normalize(repr(node))
+
+    assert node.id == "a"
+    assert representation.startswith("interface Node")
+    assert "id: ID!" in representation
+
+
+def test_implementing_interface():
+    @strawberry.interface
+    class Node:
+        id: strawberry.ID
+
+    @strawberry.type
+    class Post(Node):
+        title: str
+
+    post = Post("a", "abc")
+    representation = _normalize(repr(post))
+
+    assert post.id == "a"
+    assert post.title == "abc"
+    assert representation.startswith("type Post implements Node")
+    assert "id: ID!" in representation
+    assert "title: String!" in representation
