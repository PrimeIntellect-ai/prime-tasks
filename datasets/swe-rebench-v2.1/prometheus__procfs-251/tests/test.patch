+package procfs
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestLoadAvgReadsProcFile(t *testing.T) {
+	procDir := t.TempDir()
+	data := []byte("0.17 2.50 11.125 3/900 12345\n")
+	if err := os.WriteFile(filepath.Join(procDir, "loadavg"), data, 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	fs, err := NewFS(procDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := fs.LoadAvg()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if got.Load1 != 0.17 || got.Load5 != 2.50 || got.Load15 != 11.125 {
+		t.Errorf("unexpected load averages: got (%v, %v, %v), want (0.17, 2.50, 11.125)", got.Load1, got.Load5, got.Load15)
+	}
+}
