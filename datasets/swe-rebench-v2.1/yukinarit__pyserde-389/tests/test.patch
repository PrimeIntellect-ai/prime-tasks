@@ -1233,3 +1234,21 @@ def test_nested_dataclass_ignore_wrapper_options() -> None:
     serialized = serde.to_dict(a)
     assert {"foo": {"myLongName": 1}} == serialized
     assert a == serde.from_dict(Wrapper, serialized)
+
+
+def test_deserialize_from_incompatible_value() -> None:
+    @serde.deserialize
+    @dataclasses.dataclass
+    class Foo:
+        v: int
+
+    # A valid YAML document deserializes normally.
+    assert Foo(1) == from_yaml(Foo, "v: 1")
+
+    # A YAML document that does not match the target type is rejected.
+    with pytest.raises(serde.SerdeError):
+        from_yaml(Foo, "no: 1")
+
+    # An empty YAML document must not silently deserialize to None.
+    with pytest.raises(serde.SerdeError):
+        from_yaml(Foo, "")
