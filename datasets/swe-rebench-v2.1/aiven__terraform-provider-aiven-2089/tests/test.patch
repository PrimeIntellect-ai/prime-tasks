+func TestImportedUserHasNoPlanDiffAfterRead(t *testing.T) {
+	ctx := context.Background()
+	const projectName = "foo"
+	const serviceName = "bar"
+	const username = "baz"
+	const resourceID = "foo/bar/baz"
+
+	// Terraform import begins with an ID and no resource attributes. Reading it
+	// should populate all values needed to keep the configured resource in sync.
+	d := schema.TestResourceDataRaw(t, ResourcePGUserSchema, map[string]interface{}{})
+	d.SetId(resourceID)
+
+	client := mocks.NewMockClient(t)
+	client.EXPECT().ServiceUserGet(ctx, projectName, serviceName, username).Return(&service.ServiceUserGetOut{
+		Username: username,
+		Type:     "normal",
+		AccessControl: &service.AccessControlOut{
+			PgAllowReplication: lo.ToPtr(true),
+		},
+	}, nil)
+
+	err := ResourcePGUserRead(ctx, d, client)
+	require.NoError(t, err, "reading imported user")
+
+	config := sdkterraform.NewResourceConfigRaw(map[string]interface{}{
+		"project":              projectName,
+		"service_name":         serviceName,
+		"username":             username,
+		"pg_allow_replication": true,
+	})
+	diff, err := ResourcePGUser().Diff(ctx, d.State(), config, nil)
+	require.NoError(t, err)
+	require.True(t, diff.Empty(), "an imported user matching configuration should have no plan diff: %#v", diff)
+}
