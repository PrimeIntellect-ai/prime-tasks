+func TestParserSelectAggregatorDoesNotPanic(t *testing.T) {
+	for _, query := range []string{
+		"SELECT * FROM test LIMIT min(0)",
+		"SELECT * FROM test OFFSET x(*)",
+		"SELECT * FROM test LIMIT max(0)",
+	} {
+		t.Run(query, func(t *testing.T) {
+			require.NotPanics(t, func() {
+				_, _ = ParseQuery(context.Background(), query)
+			})
+		})
+	}
+}
