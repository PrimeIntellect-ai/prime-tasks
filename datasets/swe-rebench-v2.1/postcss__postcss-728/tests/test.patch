+    it('changes lines in strings', () => {
+        let error;
+        try {
+            tokenize(new Input('.s["] {\n}\n/* "" */'));
+        } catch (e) {
+            error = e;
+        }
+        expect(error.name).to.eql('CssSyntaxError');
+        expect(error.reason).to.eql('Unclosed quote');
+        expect(error.line).to.eql(3);
+        expect(error.column).to.eql(5);
+    });
+
     it('tokenizes at-word', () => {
         test('@word ', [ ['at-word', '@word', 1, 1, 1, 5], ['space', ' '] ]);
