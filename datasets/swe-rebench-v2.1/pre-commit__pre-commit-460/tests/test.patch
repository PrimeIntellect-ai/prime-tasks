+def test_standalone_preinstallation_preinstalls_each_repository(
+        tempdir_factory, mock_out_store_directory, cap_out, capsys,
+):
+    with pytest.raises(SystemExit):
+        main.main(['--help'])
+    help_output = capsys.readouterr().out
+    command_group = re.search(r'\{([^}]+)\}', help_output).group(1)
+    commands = set(command_group.replace('\n', '').split(','))
+    existing_commands = {
+        'install', 'uninstall', 'clean', 'autoupdate', 'run', 'help',
+    }
+    preparation_commands = commands - existing_commands
+    assert preparation_commands
+    preparation_command = sorted(preparation_commands)[0]
+    first_repo = make_repo(tempdir_factory, 'script_hooks_repo')
+    second_repo = make_repo(tempdir_factory, 'script_hooks_repo')
+    config = [
+        make_config_from_repo(first_repo),
+        make_config_from_repo(second_repo),
+    ]
+    path = git_dir(tempdir_factory)
+    write_config(path, config)
+
+    with cwd(path):
+        with io.open('input', 'w') as input_file:
+            input_file.write('check me\n')
+        cmd_output('git', 'add', 'input')
+        main.main([preparation_command])
+        shutil.rmtree(first_repo)
+        shutil.rmtree(second_repo)
+
+        assert main.main(['run', '--all-files']) == 0
+
+    assert cap_out.get().count('Bash hook') == 2
+
+
+def test_install_with_hooks_installs_each_repository(tempdir_factory):
+    root = tempdir_factory.get()
+
+    class FakeRepository(object):
+        def __init__(self, name):
+            self.environment = os.path.join(root, name)
+
+        def require_installed(self):
+            mkdirp(self.environment)
+
+    class FakeRunner(object):
+        repositories = [FakeRepository('first'), FakeRepository('second')]
+
+        def get_hook_path(self, hook_type):
+            return os.path.join(root, '.git', 'hooks', hook_type)
+
+    runner = FakeRunner()
+
+    install(runner, hooks=True)
+    assert all(os.path.isdir(repo.environment) for repo in runner.repositories)
+
