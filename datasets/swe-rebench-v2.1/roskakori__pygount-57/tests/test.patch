+    def test_can_find_python_files_in_dot(self):
+        # "pygount ." must scan the current directory instead of silently
+        # skipping it (see issue #56). This checks the public command line
+        # behavior, so any fix that makes "." work (be it by adjusting the
+        # folder skip patterns or by normalizing "." while handling the
+        # command line arguments) is accepted.
+        python_file_name = "some_module.py"
+        scan_folder = os.path.join(self.tests_temp_folder, "dot_scan")
+        os.makedirs(scan_folder, exist_ok=True)
+        with open(os.path.join(scan_folder, python_file_name), "w", encoding="utf-8") as python_file:
+            python_file.write("some_variable = 1\n")
+        output_path = os.path.join(self.tests_temp_folder, "dot_scan.xml")
+        previous_working_directory = os.getcwd()
+        os.chdir(scan_folder)
+        try:
+            exit_code = command.pygount_command(["--format", "cloc-xml", "--out", output_path, "."])
+        finally:
+            os.chdir(previous_working_directory)
+        assert exit_code == 0
+        cloc_xml_root = ElementTree.parse(output_path)
+        analyzed_names = [
+            os.path.basename(file_element.get("name")) for file_element in cloc_xml_root.findall("files/file")
+        ]
+        assert python_file_name in analyzed_names
