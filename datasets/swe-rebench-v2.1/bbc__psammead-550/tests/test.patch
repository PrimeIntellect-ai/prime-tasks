+import renderer from 'react-test-renderer';
+import 'jest-styled-components';
 import MediaIndicator from './index';
 
+const render = element => renderer.create(element).toJSON();
+
+const findAll = (node, predicate, acc = []) => {
+  if (!node || typeof node !== 'object') {
+    return acc;
+  }
+  if (Array.isArray(node)) {
+    node.forEach(child => findAll(child, predicate, acc));
+    return acc;
+  }
+  if (predicate(node)) {
+    acc.push(node);
+  }
+  if (node.children) {
+    node.children.forEach(child => findAll(child, predicate, acc));
+  }
+  return acc;
+};
+
+const findTimes = tree => findAll(tree, node => node.type === 'time');
+
+const textContent = node => {
+  if (node === null || node === undefined) {
+    return '';
+  }
+  if (typeof node === 'string') {
+    return node;
+  }
+  if (Array.isArray(node)) {
+    return node.map(textContent).join('');
+  }
+  return textContent(node.children);
+};
+
+// Render without a duration so the output is only the icon and its wrapper,
+// regardless of how the icon itself is built.
+const iconOutput = props =>
+  JSON.stringify(render(<MediaIndicator offscreenText="Media" {...props} />));
+
 describe('MediaIndicator', () => {
