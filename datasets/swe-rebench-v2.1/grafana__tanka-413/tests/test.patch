+package term
+
+import (
+	"errors"
+	"io"
+	"os"
+	"strings"
+	"testing"
+	"testing/iotest"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAlertConfirmFromBehavior(t *testing.T) {
+	tests := []struct {
+		name     string
+		input    string
+		expected error
+	}{
+		{name: "linux yes", input: "yes\n", expected: nil},
+		{name: "windows yes", input: "yes\r\n", expected: nil},
+		{name: "linux no", input: "no\n", expected: ErrConfirmationFailed},
+		{name: "windows no", input: "no\r\n", expected: ErrConfirmationFailed},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			in := strings.NewReader(tt.input)
+			out := &strings.Builder{}
+
+			err := confirmFrom(in, out, "foo", "yes")
+
+			assert.Equal(t, "foo\nPlease type 'yes' to confirm: ", out.String())
+
+			if tt.expected != nil {
+				assert.True(t, errors.Is(err, tt.expected), "expected %v, got %v", tt.expected, err)
+			} else {
+				assert.NoError(t, err)
+			}
+		})
+	}
+}
+
+// TestConfirmFromIOErrors verifies that failures while reading the user input
+// or writing the prompt are surfaced as errors instead of being ignored.
+func TestConfirmFromIOErrors(t *testing.T) {
+	t.Run("read error", func(t *testing.T) {
+		in := iotest.ErrReader(errors.New("read failure"))
+		out := &strings.Builder{}
+
+		err := confirmFrom(in, out, "foo", "yes")
+
+		assert.Error(t, err)
+	})
+
+	t.Run("write error", func(t *testing.T) {
+		in := strings.NewReader("yes\n")
+
+		err := confirmFrom(in, failingWriter{}, "foo", "yes")
+
+		assert.Error(t, err)
+	})
+}
+
+type failingWriter struct{}
+
+func (failingWriter) Write(p []byte) (int, error) {
+	return 0, errors.New("write failure")
+}
+
+// TestConfirm exercises the user-facing entry point, ensuring it accepts
+// Windows style line endings and reports the sentinel error on mismatch.
+func TestAlertConfirmBehavior(t *testing.T) {
+	tests := []struct {
+		name     string
+		input    string
+		expected error
+	}{
+		{name: "linux yes", input: "yes\n", expected: nil},
+		{name: "windows yes", input: "yes\r\n", expected: nil},
+		{name: "linux no", input: "no\n", expected: ErrConfirmationFailed},
+		{name: "windows no", input: "no\r\n", expected: ErrConfirmationFailed},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			inR, inW, err := os.Pipe()
+			require.NoError(t, err)
+			defer inR.Close()
+
+			oldStdin := os.Stdin
+			os.Stdin = inR
+			defer func() { os.Stdin = oldStdin }()
+
+			outR, outW, err := os.Pipe()
+			require.NoError(t, err)
+			defer outR.Close()
+
+			oldStdout := os.Stdout
+			os.Stdout = outW
+			defer func() { os.Stdout = oldStdout }()
+
+			go func() {
+				_, _ = inW.WriteString(tt.input)
+				inW.Close()
+			}()
+
+			err = Confirm("foo", "yes")
+			os.Stdout = oldStdout
+			require.NoError(t, outW.Close())
+			prompt, readErr := io.ReadAll(outR)
+			require.NoError(t, readErr)
+			assert.Equal(t, "foo\nPlease type 'yes' to confirm: ", string(prompt))
+
+			if tt.expected != nil {
+				assert.True(t, errors.Is(err, tt.expected), "expected %v, got %v", tt.expected, err)
+			} else {
+				assert.NoError(t, err)
+			}
+		})
+	}
+}
