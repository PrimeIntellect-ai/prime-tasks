index 99c534f..e8b2652 100644
--- a/src/pydap/tests/test_model.py
+++ b/src/pydap/tests/test_model.py
@@ -86,14 +86,43 @@ def test_BaseType_no_data():
     """Test empty data and dimensions attributes."""
     var = BaseType("var")
     assert var.data is None
-    assert var.dimensions == ()
+    assert list(var.dims) == []
 
 
 def test_BaseType_data_and_dimensions():
     """Test data and dimensions assignment."""
-    var = BaseType("var", [42], ("x",))
+    var = BaseType("var", [42])
+    var.dims = ["x"]
     assert var.data == [42]
-    assert var.dimensions == ("x",)
+    assert list(var.dims) == ["x"]
+
+
+def test_BaseType_dims_in_dds_response():
+    """The DAP2 DDS response serializes BaseType dimensions from ``dims``."""
+    from pydap.responses.dds import dds
+
+    var = BaseType("var", np.arange(6).reshape(2, 3))
+    var.dims = ("y", "x")
+    assert "Int32 var[y = 2][x = 3];" in "".join(dds(var))
+
+
+def test_BaseType_dims_in_dmr_response():
+    """The DAP4 DMR preserves fully qualified BaseType dimension names."""
+    from pydap.responses.dmr import dmr
+
+    var = BaseType("var", np.arange(6).reshape(2, 3))
+    var.dims = ("/group/y", "/group/x")
+    response = "".join(dmr(var))
+    assert '<Dim name="/group/y"/>' in response
+    assert '<Dim name="/group/x"/>' in response
+
+
+def test_BaseType_dims_from_dds_parser():
+    """The DAP2 DDS parser stores parsed dimension names on ``dims``."""
+    from pydap.parsers.dds import dds_to_dataset
+
+    dataset = dds_to_dataset("Dataset { Int32 c[c = 10]; } d;")
+    assert list(dataset["c"].dims) == ["c"]
 
 
