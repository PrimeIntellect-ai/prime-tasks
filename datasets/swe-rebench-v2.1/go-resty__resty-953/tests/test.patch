+
+func TestResetMultipartFieldReaderSeekStartError(t *testing.T) {
+	ts := createFilePostServer(t)
+	defer ts.Close()
+
+	testSeeker := &failingSeeker{
+		bytes.NewReader([]byte("test")),
+	}
+
+	c := dc().
+		SetRetryCount(2).
+		SetTimeout(time.Second * 3).
+		SetRetryResetReaders(true).
+		AddRetryAfterErrorCondition()
+
+	resp, err := c.R().
+		SetMultipartField("file", "audio.wav", "audio/wav", testSeeker).
+		Post(ts.URL + "/set-reset-multipart-readers-test")
+
+	assertEqual(t, 500, resp.StatusCode())
+	if err == nil {
+		t.Fatalf("expected seek failure error, got nil")
+	}
+}
+
+func TestResetMultipartFieldReaders(t *testing.T) {
+	var mu sync.Mutex
+	var bodies []string
+
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		mu.Lock()
+		bodies = append(bodies, string(body))
+		mu.Unlock()
+
+		w.WriteHeader(http.StatusInternalServerError)
+		_, _ = fmt.Fprintf(w, `{ "message": "error" }`)
+	}))
+	defer ts.Close()
+
+	content := "reset-multipart-field-reader-content"
+	bufReader := bytes.NewReader([]byte(content))
+
+	c := dc().
+		SetRetryCount(2).
+		SetTimeout(time.Second * 3).
+		SetRetryResetReaders(true).
+		AddRetryAfterErrorCondition()
+
+	resp, err := c.R().
+		SetMultipartField("file", "audio.wav", "audio/wav", bufReader).
+		Post(ts.URL + "/set-reset-multipart-readers-test")
+
+	assertEqual(t, 500, resp.StatusCode())
+	assertNil(t, err)
+
+	mu.Lock()
+	defer mu.Unlock()
+
+	// The initial request plus every retry must carry the complete
+	// multipart field content. This requires the field reader to be reset
+	// before each retry request is built, regardless of when the reset
+	// happens relative to retry hooks.
+	assertEqual(t, 3, len(bodies))
+	for _, body := range bodies {
+		assertEqual(t, true, strings.Contains(body, content))
+	}
+}
