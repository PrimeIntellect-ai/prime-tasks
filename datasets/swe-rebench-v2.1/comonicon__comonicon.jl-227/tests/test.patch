+module OrderedHelpOutput
+using Comonicon
+
+"""A command whose documented entries have a deliberately chosen order.
+
+# Args
+
+- `first_arg`: first positional argument.
+- `second_arg`: second positional argument.
+
+# Options
+
+- `--first-option`: first option.
+- `--second-option`: second option.
+
+# Flags
+
+- `--first-flag`: first flag.
+- `--second-flag`: second flag.
+"""
+@main function main(
+    first_arg, second_arg;
+    first_option::String = "", second_option::String = "",
+    first_flag::Bool = false, second_flag::Bool = false,
+) end
+end
+
+function capture_stdout(f)
+    pipe = Pipe()
+    Base.link_pipe!(pipe; reader_supports_async = true, writer_supports_async = true)
+    redirect_stdout(pipe) do
+        f()
+    end
+    close(pipe.in)
+    return read(pipe, String)
+end
+
+@testset "help preserves documented entry order" begin
+    output = capture_stdout() do
+        OrderedHelpOutput.command_main(["--help"])
+    end
+
+    args_section = split(output, "Args"; limit = 2)[2]
+    options_section = split(output, "Options"; limit = 2)[2]
+    flags_section = split(output, "Flags"; limit = 2)[2]
+    @test findfirst("first_arg", args_section) < findfirst("second_arg", args_section)
+    @test findfirst("first-option", options_section) < findfirst("second-option", options_section)
+    @test findfirst("first-flag", flags_section) < findfirst("second-flag", flags_section)
+end
+
