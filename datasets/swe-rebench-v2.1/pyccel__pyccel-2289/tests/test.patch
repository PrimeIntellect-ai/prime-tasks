+
+def test_dict_values(python_only_language):
+    def dict_values():
+        a = {1:1.0, 2:2.0, 3:3.0, 5:4.7}
+        value_sum = 0.0
+        for value in a.values(): #pylint:disable=consider-iterating-dictionary
+            value_sum += value
+
+        return value_sum
+
+    epyc_dict_values = epyccel(dict_values, language = python_only_language)
+    pyccel_result = epyc_dict_values()
+    python_result = dict_values()
+    assert python_result == pyccel_result
