+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from collections import deque
+from typing import Any
+
+import pytest
+
+from cfnlint.jsonschema._resolvers_cfn import ResolutionResult, Validator
+from cfnlint.jsonschema.exceptions import ValidationError
+from cfnlint.jsonschema.validators import CfnTemplateValidator, create
+
+
+def _resolver(validator: Validator, instance: Any) -> ResolutionResult:
+    if instance == "fail":
+        yield None, validator, ValidationError("Foo")
+        return
+
+    yield "foo", validator, None
+
+
+@pytest.fixture
+def validator():
+    validator = CfnTemplateValidator({})
+    validator.fn_resolvers = {
+        "Ref": _resolver,
+    }
+    validator.context = validator.context.evolve(functions=["Ref"])
+    return validator
+
+
+@pytest.mark.parametrize(
+    "name,instance,expected",
+    [
+        (
+            "Valid with function",
+            {"Ref": "fail"},
+            [(None, ValidationError("Foo", path=deque(["Ref"])))],
+        ),
+        ("Valid with function", {"Ref": "pass"}, [("foo", None)]),
+    ],
+)
+def test_validator_resolver(name, instance, expected, validator):
+    results = list(validator.resolve_value(instance))
+
+    assert results
+    for result in results:
+        assert isinstance(result, tuple)
+        assert len(result) == 3
+        assert result[1] is validator
+        assert result[2] is None or isinstance(result[2], ValidationError)
+    for expected_result in expected:
+        assert any(
+            result[0] == expected_result[0] and result[2] == expected_result[1]
+            for result in results
+        )
+
+
+def test_resolve_value_is_lazy(validator):
+    results = validator.resolve_value({"Ref": "pass"})
+
+    assert iter(results) is results
+    result = next(results)
+    assert result[0] == "foo"
+    assert result[1] is validator
+    assert result[2] is None
+
+
+def test_custom_resolver_can_be_supplied_when_creating_validator():
+    custom_validator = create(fn_resolvers={"Ref": _resolver})({})
+    custom_validator.context = custom_validator.context.evolve(functions=["Ref"])
+
+    results = list(custom_validator.resolve_value({"Ref": "pass"}))
+
+    assert results
+    for result in results:
+        assert isinstance(result, tuple)
+        assert len(result) == 3
+        assert result[1] is custom_validator
+        assert result[2] is None or isinstance(result[2], ValidationError)
+    assert any(result[0] == "foo" and result[2] is None for result in results)
