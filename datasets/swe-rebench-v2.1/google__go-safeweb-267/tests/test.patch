+func TestMultipartFormFileWithPathInName(t *testing.T) {
+	tests := []struct {
+		filename string
+	}{
+		{filename: "../tmp/myfile.txt"},
+		{filename: "../../private/other.txt"},
+		{filename: "uploads/user/avatar.png"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.filename, func(t *testing.T) {
+			fh := &multipart.FileHeader{Filename: tt.filename}
+			mf := &multipart.Form{File: map[string][]*multipart.FileHeader{"foo": {fh}}}
+			f := multipartFormFromRequest(t, mf)
+			filename := f.File("foo")[0].Filename
+			if strings.ContainsAny(filename, "/\\") {
+				t.Errorf("file name %q contains directory path information", filename)
+			}
+		})
+	}
+}
+
+func multipartFormFromRequest(t *testing.T, mf *multipart.Form) *MultipartForm {
+	t.Helper()
+	req := httptest.NewRequest("POST", "/", strings.NewReader(""))
+	req.Header.Set("Content-Type", "multipart/form-data; boundary=test")
+	req.MultipartForm = mf
+	f, err := NewIncomingRequest(req).MultipartForm(1024)
+	if err != nil {
+		t.Fatalf("MultipartForm: got error %v", err)
+	}
+	return f
+}
