 import pytest
 
 import pandas as pd
+import pandas._testing as tm
 
 pytest.importorskip("tabulate")
 
 
+def test_keyword_deprecation():
+    # GH 57280
+    msg = (
+        "Starting with pandas version 3.0.0 all arguments of to_markdown "
+        "except for the argument 'buf' will be keyword-only."
+    )
+    s = pd.Series()
+    with tm.assert_produces_warning(FutureWarning, match=msg):
+        s.to_markdown(None, "wt")
+
+
+def test_to_string_keyword_deprecation():
+    # GH 57280
+    msg = (
+        "Starting with pandas version 3.0.0 all arguments of to_string "
+        "except for the argument 'buf' will be keyword-only."
+    )
+    s = pd.Series(["a", "b"])
+    with tm.assert_produces_warning(FutureWarning, match=msg):
+        s.to_string(None, "NaN")
+
+
 def test_simple():
     buf = StringIO()
     df = pd.DataFrame([1, 2, 3])
