+type targetGroupAttributesMatcher struct {
+	expected *elbv2.ModifyTargetGroupAttributesInput
+}
+
+func (m targetGroupAttributesMatcher) Matches(got interface{}) bool {
+	actual, ok := got.(*elbv2.ModifyTargetGroupAttributesInput)
+	if !ok || aws.ToString(actual.TargetGroupArn) != aws.ToString(m.expected.TargetGroupArn) {
+		return false
+	}
+	wanted := make(map[string]string, len(m.expected.Attributes))
+	for _, attribute := range m.expected.Attributes {
+		wanted[aws.ToString(attribute.Key)] = aws.ToString(attribute.Value)
+	}
+	for _, attribute := range actual.Attributes {
+		key, value := aws.ToString(attribute.Key), aws.ToString(attribute.Value)
+		if expectedValue, found := wanted[key]; found && expectedValue == value {
+			delete(wanted, key)
+		}
+	}
+	if len(wanted) != 0 {
+		return false
+	}
+	// When no legacy attributes are expected, this request must still configure
+	// the requested interval (for example, when client IP preservation is enabled).
+	return len(m.expected.Attributes) != 0 || hasPositiveDrainingInterval(actual)
+}
+
+func (m targetGroupAttributesMatcher) String() string {
+	return "target group attributes include the expected existing settings"
+}
+
+type drainingIntervalMatcher struct{}
+
+func (drainingIntervalMatcher) Matches(got interface{}) bool {
+	actual, ok := got.(*elbv2.ModifyTargetGroupAttributesInput)
+	if !ok {
+		return false
+	}
+	return hasPositiveDrainingInterval(actual)
+}
+
+func hasPositiveDrainingInterval(input *elbv2.ModifyTargetGroupAttributesInput) bool {
+	for _, attribute := range input.Attributes {
+		if aws.ToString(attribute.Key) != "target_health_state.unhealthy.draining_interval_seconds" {
+			continue
+		}
+		seconds, err := strconv.Atoi(aws.ToString(attribute.Value))
+		return err == nil && seconds > 0
+	}
+	return false
+}
+
+func (drainingIntervalMatcher) String() string {
+	return "target group attributes include a positive unhealthy draining interval"
+}
