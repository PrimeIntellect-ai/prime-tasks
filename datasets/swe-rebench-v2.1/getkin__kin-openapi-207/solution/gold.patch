+func drillIntoSwaggerField(cursor interface{}, fieldName string) (interface{}, error) {
+	val := reflect.Indirect(reflect.ValueOf(cursor))
+
+	switch val.Kind() {
+	case reflect.Map:
+		elementValue := val.MapIndex(reflect.ValueOf(fieldName))
+		if !elementValue.IsValid() {
