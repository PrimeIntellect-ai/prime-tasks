+def test_fuzzing_invalid_test_raises_error():
+    # Invalid: @given with too many positional arguments
+    @given(st.integers(), st.integers())
+    def invalid_test(s):
+        pass
+
+    with pytest.raises(InvalidArgument, match="Too many positional arguments"):
+        # access the property to check error happens during setup
+        invalid_test.hypothesis.fuzz_one_input
+
+
+def test_fuzzing_invalid_test_retains_given_kwargs():
+    # Invalid: @given with an unexpected keyword argument
+    strat = st.integers()
+
+    @given(foo=strat)
+    def invalid_test():
+        pass
+
+    assert invalid_test.hypothesis._given_kwargs == {"foo": strat}
+
+
+def test_invalid_async_test_exposes_truthy_hypothesis_handle():
+    # Invalid: @given with an unexpected keyword argument, on an async test.
+    # Plugins such as pytest-asyncio detect Hypothesis tests by checking
+    # that the `hypothesis` attribute is present and truthy.
+    @given(foo=st.integers())
+    async def invalid_test():
+        pass
+
+    assert getattr(invalid_test, "hypothesis", False)
+    assert invalid_test.hypothesis
