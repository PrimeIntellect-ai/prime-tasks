+#[test]
+fn overlong_decimal_entity_remains_literal() {
+    // A decimal numeric character reference may contain at most 7 digits.
+    // An overlong reference such as `&#00000000;` (8 digits) must not be
+    // parsed as a character reference and is emitted literally instead.
+    let original = r##"&#00000000;
+"##;
+    let expected = r##"<p>&amp;#00000000;</p>
+"##;
+
+    test_markdown_html(original, expected, false, false, false);
+}
+
