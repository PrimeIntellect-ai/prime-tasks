+cached_test('autoload ambiguous proxy', async ({ provider, env, withCache }) => {
+    // Issue #173: Contract A contains proxy-like code, but it is a destination
+    // (factory) contract and must not be followed as a proxy.
+    const address = "0xe1164a7a364929c3ba3da9671c8003dd71975d2d";
+
+    const code = await withCache(
+        `${address}_code`,
+        async () => {
+            return await provider.getCode(address)
+        },
+    )
+    const result = await autoload(address, {
+        provider: whatsabi.providers.WithCachedCode(provider, {
+            [address]: code,
+        }),
+        followProxies: false,
         ...whatsabi.loaders.defaultsWithEnv(env),
     });
+
+    // With following disabled, autoload must preserve A's own contract data.
+    expect(result.address.toLowerCase()).toBe(address.toLowerCase());
     expect(result.isFactory).toBeTruthy();
+    expect(result.abi.length).toBeGreaterThan(0);
+
+    // Enabling following must not turn this destination contract into B.
+    const followedResult = await autoload(address, {
+        provider: whatsabi.providers.WithCachedCode(provider, {
+            [address]: code,
+        }),
+        followProxies: true,
+        ...whatsabi.loaders.defaultsWithEnv(env),
+    });
+    expect(followedResult.address.toLowerCase()).toBe(address.toLowerCase());
+});
+cached_test('autoload keeps the requested contract ABI and source when proxy following is disabled', async ({ provider, withCache }) => {
+    const addressA = "0xe1164a7a364929c3ba3da9671c8003dd71975d2d";
+    const addressB = "0x03bd8b73d316521c0e65b5672e5be3f174b8a519";
+    const code = await withCache(
+        `${addressA}_code`,
+        async () => await provider.getCode(addressA),
+    );
+
+    const abiA = [{ type: "function", name: "fromA", inputs: [], outputs: [], stateMutability: "view" }];
+    const abiB = [{ type: "function", name: "fromB", inputs: [], outputs: [], stateMutability: "view" }];
+    const sourceA = "contract A { function fromA() external view {} }";
+    const sourceB = "contract B { function fromB() external view {} }";
+    const abiLoader = {
+        name: "fixture loader",
+        loadABI: async (target: string) => target.toLowerCase() === addressA ? abiA : abiB,
+        getContract: async (target: string) => ({
+            abi: target.toLowerCase() === addressA ? abiA : abiB,
+            name: target.toLowerCase() === addressA ? "A" : "B",
+            ok: true,
+            getSources: async () => [{ content: target.toLowerCase() === addressA ? sourceA : sourceB }],
+        }),
+    };
+
+    const result = await autoload(addressA, {
+        provider: whatsabi.providers.WithCachedCode(provider, { [addressA]: code }),
+        abiLoader,
+        loadContractResult: true,
+        followProxies: false,
+    });
+
+    expect(result.address.toLowerCase()).toBe(addressA.toLowerCase());
+    expect(result.abi).toEqual(abiA);
+    const sources = await result.contractResult?.getSources?.();
+    expect(sources?.some(source => source.content === sourceA)).toBe(true);
+    expect(sources?.some(source => source.content === sourceB)).not.toBe(true);
 });
 
