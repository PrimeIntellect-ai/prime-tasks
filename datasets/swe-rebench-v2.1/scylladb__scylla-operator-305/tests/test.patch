+func TestRepairTaskCRDSchema(t *testing.T) {
+	data, err := ioutil.ReadFile("../../../config/operator/crd/bases/scylla.scylladb.com_scyllaclusters.yaml")
+	require.NoError(t, err)
+
+	var crd map[string]interface{}
+	require.NoError(t, yaml.Unmarshal(data, &crd))
+
+	lookup := func(path ...string) map[string]interface{} {
+		var cur interface{} = crd
+		for _, p := range path {
+			m, ok := cur.(map[string]interface{})
+			require.Truef(t, ok, "expected an object at %q", p)
+			cur, ok = m[p]
+			require.Truef(t, ok, "missing %q", p)
+		}
+		m, ok := cur.(map[string]interface{})
+		require.True(t, ok)
+		return m
+	}
+
+	for _, section := range []string{"spec", "status"} {
+		props := lookup("spec", "validation", "openAPIV3Schema", "properties", section, "properties", "repairs", "items", "properties")
+
+		intensity, ok := props["intensity"].(map[string]interface{})
+		require.Truef(t, ok, "%s.repairs.intensity must be defined", section)
+		require.Equalf(t, "string", intensity["type"], "%s.repairs.intensity must be a string", section)
+
+		require.Containsf(t, props, "parallel", "%s.repairs.parallel must be defined", section)
+	}
+}
