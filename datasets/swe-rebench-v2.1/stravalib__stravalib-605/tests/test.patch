+def test_exchange_code_for_token_athlete_without_extra_request(
+    mock_strava_api, client
+):
+    """The athlete summary is returned from the token exchange response
+    itself, without a separate request to the athlete endpoint."""
+    athlete_endpoint = "https://www.strava.com/api/v3/athlete"
+    athlete_request = mock.Mock(
+        return_value=(200, {}, '{"id": 10295934, "firstname": "Unexpected"}')
+    )
+    mock_strava_api.add_callback(
+        responses.GET, athlete_endpoint, callback=athlete_request
+    )
+    mock_strava_api.add(
+        responses.POST,
+        "https://www.strava.com/oauth/token",
+        json={
+            "access_token": "123456",
+            "refresh_token": "789sdf987",
+            "expires_at": 1732417459,
+            "athlete": {
+                "id": 10295934,
+                "username": "foo_bar",
+                "resource_state": 2,
+                "firstname": "Foo",
+                "lastname": "Bar",
+            },
+        },
+    )
+
+    try:
+        access_info, summary_athlete = client.exchange_code_for_token(
+            client_id=123,
+            client_secret="secret",
+            code="temp_code",
+            return_athlete=True,
+        )
+    finally:
+        mock_strava_api.remove(responses.GET, athlete_endpoint)
+        mock_strava_api.remove(
+            responses.POST, "https://www.strava.com/oauth/token"
+        )
+
+    assert access_info["access_token"] == "123456"
+    assert isinstance(summary_athlete, SummaryAthlete)
+    assert summary_athlete.firstname == "Foo"
+    athlete_request.assert_not_called()
