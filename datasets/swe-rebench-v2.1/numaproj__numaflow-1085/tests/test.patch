+func TestResumePausedPipelineRestoresReplicaCounts(t *testing.T) {
+	cl := fake.NewClientBuilder().Build()
+	ctx := context.TODO()
+	testIsbSvc := testNativeRedisIsbSvc.DeepCopy()
+	testIsbSvc.Status.MarkConfigured()
+	testIsbSvc.Status.MarkDeployed()
+	err := cl.Create(ctx, testIsbSvc)
+	assert.NoError(t, err)
+	r := &pipelineReconciler{
+		client:   cl,
+		scheme:   scheme.Scheme,
+		config:   fakeConfig,
+		image:    testFlowImage,
+		logger:   zaptest.NewLogger(t).Sugar(),
+		recorder: record.NewFakeRecorder(64),
+	}
+	testObj := testPipeline.DeepCopy()
+	testObj.Spec.Vertices[0].Source = &dfv1.Source{HTTP: &dfv1.HTTPSource{}}
+	testObj.Spec.Vertices[0].Scale.Min = pointer.Int32(3)
+	testObj.Spec.Vertices[1].Scale.Min = pointer.Int32(4)
+	_, err = r.reconcile(ctx, testObj)
+	assert.NoError(t, err)
+	err = cl.Create(ctx, testObj)
+	assert.NoError(t, err)
+
+	vertices := &dfv1.VertexList{}
+	err = cl.List(ctx, vertices, client.InNamespace(testNamespace))
+	assert.NoError(t, err)
+	for i := range vertices.Items {
+		vertices.Items[i].Spec.Replicas = pointer.Int32(0)
+		assert.NoError(t, cl.Update(ctx, &vertices.Items[i]))
+	}
+	testObj.Status.Phase = dfv1.PipelinePhasePaused
+	assert.NoError(t, cl.Status().Update(ctx, testObj))
+
+	request := reconcile.Request{NamespacedName: client.ObjectKeyFromObject(testObj)}
+	_, err = r.Reconcile(ctx, request)
+	assert.NoError(t, err)
+	vertices = &dfv1.VertexList{}
+	err = cl.List(ctx, vertices, client.InNamespace(testNamespace))
+	assert.NoError(t, err)
+	replicas := make(map[string]int32, len(vertices.Items))
+	for i := range vertices.Items {
+		replicas[vertices.Items[i].Name] = *vertices.Items[i].Spec.Replicas
+	}
+	assert.Equal(t, int32(3), replicas[testObj.Name+"-"+testObj.Spec.Vertices[0].Name])
+	assert.Equal(t, int32(1), replicas[testObj.Name+"-"+testObj.Spec.Vertices[1].Name])
+}
