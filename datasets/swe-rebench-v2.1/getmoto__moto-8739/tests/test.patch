diff --git a/tests/test_rds/test_integrations.py b/tests/test_rds/test_integrations.py
new file mode 100644
index 000000000..fe05ed383
--- /dev/null
+++ b/tests/test_rds/test_integrations.py
@@ -0,0 +1,32 @@
+"""Packaging behavior relevant to RDS integration tests."""
+
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+
+def test_build_wheel_has_no_deprecated_license_classifier_warning(tmp_path):
+    project_root = Path(__file__).resolve().parents[2]
+    build_root = tmp_path / "project"
+    build_root.mkdir()
+
+    for filename in ("setup.py", "setup.cfg", "README.md", "LICENSE"):
+        shutil.copy2(project_root / filename, build_root / filename)
+    shutil.copytree(project_root / "moto", build_root / "moto")
+
+    result = subprocess.run(
+        [
+            sys.executable,
+            "setup.py",
+            "bdist_wheel",
+            "--dist-dir",
+            str(tmp_path / "dist"),
+        ],
+        cwd=build_root,
+        capture_output=True,
+        text=True,
+    )
+
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert "License classifiers are deprecated" not in result.stdout + result.stderr
