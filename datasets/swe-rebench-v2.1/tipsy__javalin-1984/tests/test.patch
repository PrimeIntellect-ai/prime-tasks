+package io.javalin
+
+import io.javalin.http.HttpStatus
+import io.javalin.testing.TestUtil
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.Test
+
+class TestBeforeAfterMatched {
+
+    @Test
+    fun `matching-only handlers run for routes and not for unmatched requests`() = TestUtil.test { app, http ->
+        app.before { it.header("X-Ordinary-Before", "ran") }
+        app.after { it.header("X-Ordinary-After", "ran") }
+        app.beforeMatched { it.header("X-Matched-Before", "ran") }
+        app.afterMatched { it.header("X-Matched-After", "ran") }
+        app.get("/hello") { it.result("hello") }
+
+        val matched = http.get("/hello")
+        assertThat(matched.status).isEqualTo(HttpStatus.OK.code)
+        assertThat(matched.headers.getFirst("X-Matched-Before")).isEqualTo("ran")
+        assertThat(matched.headers.getFirst("X-Matched-After")).isEqualTo("ran")
+
+        val unmatched = http.get("/other")
+        assertThat(unmatched.status).isEqualTo(HttpStatus.NOT_FOUND.code)
+        assertThat(unmatched.body).isEqualTo("Not Found")
+        assertThat(unmatched.headers.getFirst("X-Matched-Before")).isNullOrEmpty()
+        assertThat(unmatched.headers.getFirst("X-Matched-After")).isNullOrEmpty()
+    }
+
+    @Test
+    fun `ordinary before and after handlers continue to run for unmatched requests`() = TestUtil.test { app, http ->
+        app.before { it.header("X-Ordinary-Before", "ran") }
+        app.after { it.header("X-Ordinary-After", "ran") }
+        app.get("/hello") { it.result("hello") }
+
+        val response = http.get("/other")
+        assertThat(response.status).isEqualTo(HttpStatus.NOT_FOUND.code)
+        assertThat(response.body).isEqualTo("Not Found")
+        assertThat(response.headers.getFirst("X-Ordinary-Before")).isEqualTo("ran")
+        assertThat(response.headers.getFirst("X-Ordinary-After")).isEqualTo("ran")
+    }
+
+    @Test
+    fun `default body of an unmatched request is Not Found when after handlers run`() = TestUtil.test { app, http ->
+        var bodySeenByAfterHandler: String? = null
+        app.after { ctx ->
+            bodySeenByAfterHandler = ctx.result()
+        }
+        app.get("/hello") { it.result("hello") }
+
+        val response = http.get("/other")
+        assertThat(response.status).isEqualTo(HttpStatus.NOT_FOUND.code)
+        assertThat(bodySeenByAfterHandler).isEqualTo("Not Found")
+    }
+}
