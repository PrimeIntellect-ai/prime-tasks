+func skippedAddressesForTest(t *testing.T, plan *cost.Plan) []string {
+	t.Helper()
+	accessor, ok := interface{}(plan).(interface{ SkippedAddresses() []string })
+	require.True(t, ok, "cost.Plan must expose skipped resource addresses")
+	return accessor.SkippedAddresses()
+}
+
+func skippedStateForTest(t *testing.T, addresses ...string) *cost.State {
+	t.Helper()
+	queries := make([]query.Resource, 0, len(addresses))
+	for _, address := range addresses {
+		queries = append(queries, query.Resource{Address: address})
+	}
+	state, err := cost.NewState(context.Background(), nil, queries)
+	require.NoError(t, err)
+	return state
+}
+
+func TestPlan_SkippedAddresses(t *testing.T) {
+	t.Run("OnlyPrior", func(t *testing.T) {
+		prior := skippedStateForTest(t, "aws_invalid_resource.test_skipped")
+		prior.Resources["aws_instance.test_valid"] = cost.Resource{
+			Components: map[string]cost.Component{
+				"EC2 instance hours": {
+					Quantity: decimal.NewFromInt(730),
+					Unit:     "Hrs",
+					Rate:     decimal.NewFromFloat(2.50),
+				},
+			},
+		}
+		skipped := skippedAddressesForTest(t, cost.NewPlan(prior, nil))
+		assert.ElementsMatch(t, []string{"aws_invalid_resource.test_skipped"}, skipped)
+	})
+
+	t.Run("OnlyPlanned", func(t *testing.T) {
+		planned := skippedStateForTest(t, "aws_invalid_resource.test_skipped")
+		planned.Resources["aws_instance.test_valid"] = cost.Resource{
+			Components: map[string]cost.Component{
+				"EC2 instance hours": {
+					Quantity: decimal.NewFromInt(730),
+					Unit:     "Hrs",
+					Rate:     decimal.NewFromFloat(2.50),
+				},
+			},
+		}
+		skipped := skippedAddressesForTest(t, cost.NewPlan(nil, planned))
+		assert.ElementsMatch(t, []string{"aws_invalid_resource.test_skipped"}, skipped)
+	})
+
+	t.Run("PriorAndPlanned", func(t *testing.T) {
+		prior := skippedStateForTest(t,
+			"aws_invalid_resource.skipped_prior_planned",
+			"aws_invalid_resource.skipped_prior",
+		)
+		planned := skippedStateForTest(t,
+			"aws_invalid_resource.skipped_prior_planned",
+			"aws_invalid_resource.skipped_planned",
+		)
+		skipped := skippedAddressesForTest(t, cost.NewPlan(prior, planned))
+		assert.ElementsMatch(t, []string{
+			"aws_invalid_resource.skipped_prior_planned",
+			"aws_invalid_resource.skipped_prior",
+			"aws_invalid_resource.skipped_planned",
+		}, skipped)
+	})
+}
