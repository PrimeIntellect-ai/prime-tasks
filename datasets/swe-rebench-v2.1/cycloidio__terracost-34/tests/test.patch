+func TestPlan_FreeProviderResourcesAreNotSkipped(t *testing.T) {
+	plan := terraform.NewPlan()
+	input := `{
+		"planned_values": {"root_module": {"resources": [
+			{"address":"null_resource.example","mode":"managed","type":"null_resource","name":"example","provider_name":"registry.terraform.io/hashicorp/null"},
+			{"address":"local_file.example","mode":"managed","type":"local_file","name":"example","provider_name":"registry.terraform.io/hashicorp/local"}
+		]}},
+		"configuration": {"root_module": {"resources": []}}
+	}`
+	require.NoError(t, plan.Read(strings.NewReader(input)))
+
+	queries, err := plan.ExtractPlannedQueries()
+	require.NoError(t, err)
+	state, err := cost.NewState(context.Background(), nil, queries)
+	require.NoError(t, err)
+	accessor, ok := interface{}(cost.NewPlan(nil, state)).(interface{ SkippedAddresses() []string })
+	require.True(t, ok, "cost.Plan must expose skipped resource addresses")
+	skipped := accessor.SkippedAddresses()
+	assert.NotContains(t, skipped, "null_resource.example")
+	assert.NotContains(t, skipped, "local_file.example")
+}
