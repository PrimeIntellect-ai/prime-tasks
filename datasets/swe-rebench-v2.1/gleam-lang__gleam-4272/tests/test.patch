+#[test]
+fn convert_to_pipe_does_not_pipe_an_expression_into_use() {
+    let source = "
+import gleam/result
+
+pub fn main() {
+  use x <- result.try(todo)
+  Ok(x + 1)
+}
+";
+    let project = TestProject::for_source(source);
+    let range = find_position_of("Ok(x + 1)")
+        .to_selection()
+        .find_range(project.src);
+    let actions = actions_with_title(vec![CONVERT_TO_PIPE], project, range);
+
+    for action in actions {
+        let changes = action
+            .edit
+            .expect("A code action should include an edit")
+            .changes
+            .expect("A code action should include text changes");
+        let result = apply_code_edit(source, changes);
+        assert!(
+            !result.contains("|> use"),
+            "Convert to pipe must not pipe an expression into a use expression: {result}"
+        );
+    }
+}
+
+#[test]
+fn convert_to_pipe_works_inside_body_of_use() {
+    let source = "
+pub fn main() {
+  use <- wibble(wobble)
+  woo(123)
+}
+";
+    let project = TestProject::for_source(source);
+    let range = find_position_of("woo").to_selection().find_range(project.src);
+    let result = apply_code_action(CONVERT_TO_PIPE, project, range);
+
+    assert!(
+        result.contains("  use <- wibble(wobble)
+  123 |> woo
+"),
+        "The body call should be converted without changing the surrounding use: {result}"
+    );
+}
+
