+    def test_redirect_from_error_keeps_original_scheme(self):
+        request_dict = {
+            'context': {'signing': {'bucket': 'foo'}},
+            'url': 'http://us-west-2.amazonaws.com/foo'
+        }
+        response = (None, {
+            'Error': {
+                'Code': 'PermanentRedirect',
+                'Endpoint': 'foo.eu-central-1.amazonaws.com',
+                'Bucket': 'foo'
+            },
+            'ResponseMetadata': {
+                'HTTPHeaders': {'x-amz-bucket-region': 'eu-central-1'}
+            }
+        })
+
+        self.redirector.redirect_from_error(
+            request_dict, response, self.operation)
+
+        self.assertNotEqual(
+            request_dict['url'], 'http://us-west-2.amazonaws.com/foo')
+        self.assertTrue(request_dict['url'].startswith('http://'))
+
