+import tail from '@plexis/tail';
+import * as plexis from 'plexis';
+
+it('Extracts the last length characters from the input text', () => {
+  expect(tail()).toBe('');
+  expect(tail('Hello')).toBe('o');
+  expect(tail('Hello', 2)).toBe('lo');
+  expect(tail('Hello', 100)).toBe('Hello');
+});
+
+it('exposes the tail utility under each named root-package alias', () => {
+  expect(plexis.tail('Hello', 2)).toBe('lo');
+  expect(plexis.rest('Hello', 2)).toBe('lo');
+  expect(plexis.last('Hello', 2)).toBe('lo');
+  expect(plexis.pop('Hello', 2)).toBe('lo');
+});
+
+it('keeps the root package utilities available regardless of export order', () => {
+  expect(Object.keys(plexis)).toEqual(
+    expect.arrayContaining([
+      'compare',
+      'compareLikeHuman',
