+package test
+
+import (
+	"testing"
+
+	"github.com/mgechev/revive/rule"
+)
+
+// IdenticalBranches rule.
+func TestIdenticalBranches(t *testing.T) {
+	testRule(t, "identical-branches", &rule.IdenticalBranchesRule{})
+}
+
+func TestIdenticalBranchesName(t *testing.T) {
+	r := &rule.IdenticalBranchesRule{}
+	if got := r.Name(); got != "identical-branches" {
+		t.Errorf("IdenticalBranchesRule.Name() = %q, want %q", got, "identical-branches")
+	}
+}
