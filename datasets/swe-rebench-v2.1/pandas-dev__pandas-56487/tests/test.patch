+
+def test_axis_columns_ignore_index():
+    # GH 56478
+    df = DataFrame([[1, 2]], columns=["d", "c"])
+    result = df.sort_index(axis="columns", ignore_index=True)
+    expected = DataFrame([[2, 1]])
+    tm.assert_frame_equal(result, expected)
+
+
+def test_axis_columns_ignore_index_with_multiindex_rows():
+    index = MultiIndex.from_tuples(
+        [("b", 1, "a"), ("a", 4, "b"), ("c", 3, "c")],
+        names=["b", "a", 1],
+    )
+    df = DataFrame({"e": [3, 1, 4], "d": [1, 2, 8]}, index=index)
+
+    result = df.sort_index(axis="columns", ignore_index=True)
+
+    expected = DataFrame(
+        [[1, 3], [2, 1], [8, 4]], index=index, columns=RangeIndex(2)
+    )
+    tm.assert_frame_equal(result, expected)
