diff --git a/src/main/java/dinkplugin/util/Region.java b/src/main/java/dinkplugin/util/Region.java
new file mode 100644
index 0000000..ccc0556
--- /dev/null
+++ b/src/main/java/dinkplugin/util/Region.java
@@ -0,0 +1,19 @@
+package dinkplugin.util;
+
+import lombok.Value;
+import net.runelite.api.Client;
+
+@Value
+public class Region {
+    int regionId;
+    int plane;
+    boolean instanced;
+
+    public static Region of(Client client, int regionId) {
+        return new Region(regionId, client.getPlane(), client.isInInstancedRegion());
+    }
+
+    public static Region of(Client client) {
+        return of(client, WorldUtils.getLocation(client).getRegionID());
+    }
+}
