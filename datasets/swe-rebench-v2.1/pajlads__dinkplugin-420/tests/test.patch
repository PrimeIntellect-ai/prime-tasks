+    private static final class ExpectedDeathData extends NotificationData {
+        private final long valueLost;
+        @SerializedName("isPvp")
+        private final boolean pvp;
+        private final String pker;
+        private final String killerName;
+        private final Integer killerNpcId;
+        private final List<SerializedItemStack> keptItems;
+        private final List<SerializedItemStack> lostItems;
+
+        private ExpectedDeathData(long valueLost, boolean pvp, String pker, String killerName,
+                                  Integer killerNpcId, List<SerializedItemStack> keptItems,
+                                  List<SerializedItemStack> lostItems) {
+            this.valueLost = valueLost;
+            this.pvp = pvp;
+            this.pker = pker;
+            this.killerName = killerName;
+            this.killerNpcId = killerNpcId;
+            this.keptItems = keptItems;
+            this.lostItems = lostItems;
+        }
+    }
+
+    private void verifyDeathNotification(NotificationBody expected) {
+        ArgumentCaptor<NotificationBody> bodyCaptor = ArgumentCaptor.forClass(NotificationBody.class);
+        verify(messageHandler).createMessage(PRIMARY_WEBHOOK_URL, false, bodyCaptor.capture());
+
+        NotificationBody actual = bodyCaptor.getValue();
+        Gson gson = new Gson();
+        JsonObject actualData = new JsonParser().parse(gson.toJson(actual.getExtra())).getAsJsonObject();
+        JsonObject expectedData = new JsonParser().parse(gson.toJson(expected.getExtra())).getAsJsonObject();
+        for (Map.Entry<String, com.google.gson.JsonElement> field : expectedData.entrySet()) {
+            org.junit.jupiter.api.Assertions.assertEquals(field.getValue(), actualData.get(field.getKey()));
+        }
+        org.junit.jupiter.api.Assertions.assertEquals(expected.withExtra(null), actual.withExtra(null));
+    }
+
