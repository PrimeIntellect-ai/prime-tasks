+  test("config file in .github/") {
+    val repo = Repo("test", "dot-github-config")
+    val repoDir = workspaceAlg.repoDir(repo).unsafeRunSync()
+    val rootConfigFile = repoDir / ".scala-steward.conf"
+    val dotGithubConfigFile = repoDir / ".github" / ".scala-steward.conf"
+    val initialState =
+      MockState.empty.addFiles(dotGithubConfigFile -> """assignees = [ "alice" ]""").unsafeRunSync()
+    val config = repoConfigAlg.readRepoConfig(repo).runA(initialState).unsafeRunSync()
+
+    assert(!fileAlg.isRegularFile(rootConfigFile).unsafeRunSync())
+    assert(fileAlg.isRegularFile(dotGithubConfigFile).unsafeRunSync())
+
+    assertEquals(config.maybeRepoConfig.map(_.assignees), Some(List("alice")))
+  }
+
+  test("root config takes precedence over .github config") {
+    val repo = Repo("test", "root-and-github-config")
+    val repoDir = workspaceAlg.repoDir(repo).unsafeRunSync()
+    val rootConfigFile = repoDir / ".scala-steward.conf"
+    val dotGithubConfigFile = repoDir / ".github" / ".scala-steward.conf"
+    val initialState = MockState.empty
+      .addFiles(
+        rootConfigFile -> """assignees = [ "root" ]""",
+        dotGithubConfigFile -> """assignees = [ "github" ]"""
+      )
+      .unsafeRunSync()
+    val config = repoConfigAlg.readRepoConfig(repo).runA(initialState).unsafeRunSync()
+
+    assertEquals(config.maybeRepoConfig.map(_.assignees), Some(List("root")))
+  }
+
+  test("documentation mentions the .github config location") {
+    val docsFile = Iterator
+      .iterate(new java.io.File(".").getAbsoluteFile)(_.getParentFile)
+      .takeWhile(_ != null)
+      .map(dir => new java.io.File(dir, "docs/repo-specific-configuration.md"))
+      .find(_.isFile)
+      .getOrElse(fail("docs/repo-specific-configuration.md not found"))
+    val content = scala.io.Source.fromFile(docsFile).mkString
+    val withoutComGithub = content.replace("com.github", "")
+    assert(clue(withoutComGithub).contains(".github"))
+  }
