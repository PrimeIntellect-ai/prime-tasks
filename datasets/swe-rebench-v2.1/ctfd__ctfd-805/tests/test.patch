+def test_register_admin_plugin_script():
+    """Admin plugin scripts are loaded by admin pages, not ordinary theme pages."""
+    app = create_ctfd()
+    with app.app_context():
+        script_paths = ['/fake/admin-script.js', 'http://ctfd.io/fake/admin-script.js']
+        for path in script_paths:
+            register_admin_plugin_script(path)
+
+        with app.test_client() as client:
+            ordinary_page = client.get('/')
+            ordinary_output = ordinary_page.get_data(as_text=True)
+            for path in script_paths:
+                assert path not in ordinary_output
+
+        with login_as_user(app, name="admin") as client:
+            for endpoint in ['/admin/statistics', '/admin/users']:
+                response = client.get(endpoint)
+                output = response.get_data(as_text=True)
+                assert response.status_code == 200
+                for path in script_paths:
+                    assert path in output
+    destroy_ctfd(app)
+
+
+def test_register_admin_plugin_stylesheet():
+    """Admin plugin stylesheets are loaded by admin pages, not ordinary theme pages."""
+    app = create_ctfd()
+    with app.app_context():
+        stylesheet_paths = ['/fake/admin-stylesheet.css', 'http://ctfd.io/fake/admin-stylesheet.css']
+        for path in stylesheet_paths:
+            register_admin_plugin_stylesheet(path)
+
+        with app.test_client() as client:
+            ordinary_page = client.get('/')
+            ordinary_output = ordinary_page.get_data(as_text=True)
+            for path in stylesheet_paths:
+                assert path not in ordinary_output
+
+        with login_as_user(app, name="admin") as client:
+            for endpoint in ['/admin/statistics', '/admin/users']:
+                response = client.get(endpoint)
+                output = response.get_data(as_text=True)
+                assert response.status_code == 200
+                for path in stylesheet_paths:
+                    assert path in output
+    destroy_ctfd(app)
+
