+def test_locate_docstring():
+    locate_plan = getattr(bps, "locate", None)
+    assert locate_plan is not None
+    assert locate_plan.__doc__ is not None
+    assert locate_plan.__doc__.lstrip().startswith("Locate some Movables and return their locations.")
+
+
+def test_locate(RE, hw):
+    # bps.locate should return a single Location when squeeze=True and one
+    # object is supplied, and a list of Locations otherwise.
+    class LocatableDevice(Locatable):
+        def set(self, value) -> Status:
+            return hw.motor.set(value)
+
+        def locate(self) -> Location:
+            return dict(setpoint=1.0, readback=1.1)  # noqa: C408
+
+    dev = LocatableDevice()
+    results = []
+
+    def plan():
+        results.append((yield from bps.locate(dev)))
+        results.append((yield from bps.locate(dev, squeeze=False)))
+        results.append((yield from bps.locate(dev, dev)))
+
+    RE(plan())
+    assert results[0] == dict(setpoint=1.0, readback=1.1)  # noqa: C408
+    assert results[1] == [dict(setpoint=1.0, readback=1.1)]  # noqa: C408
+    assert results[2] == [  # noqa: C408
+        dict(setpoint=1.0, readback=1.1),
+        dict(setpoint=1.0, readback=1.1),
+    ]
+
