@@ -12,6 +13,19 @@ from sanic_ext import openapi
 from .utils import get_path, get_spec
 
 
+def get_request_schema(app):
+    spec = get_spec(app)
+    schema = spec["paths"]["/"]["get"]["requestBody"]["content"][
+        "application/json"
+    ]["schema"]
+    while "$ref" in schema and schema["$ref"].startswith("#/"):
+        target = spec
+        for part in schema["$ref"][2:].split("/"):
+            target = target[part.replace("~1", "/").replace("~0", "~")]
+        schema = target
+    return schema
+
