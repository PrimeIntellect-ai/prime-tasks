+def test_definition_decorator_body_pydantic_field_metadata(app):
+    class Request(BaseModel):
+        name: str = Field(description="A person's name", example="Ada")
+
+    @app.route("/")
+    @openapi.definition(body={"application/json": Request.schema()})
+    async def handler(_):
+        ...
+
+    schema = get_request_schema(app)
+    name = schema["properties"]["name"]
+    assert name["example"] == "Ada"
+    assert name["description"] == "A person's name"
+
