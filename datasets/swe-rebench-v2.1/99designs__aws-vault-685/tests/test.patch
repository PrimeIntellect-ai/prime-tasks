+func TestSessionTagsFromProfileReachAssumeRole(t *testing.T) {
+	t.Setenv("AWS_SESSION_TAGS", "")
+	t.Setenv("AWS_TRANSITIVE_TAGS", "")
+	f := newConfigFile(t, []byte(`[profile base]
+[profile interim]
+role_arn = arn:aws:iam::123456789012:role/interim
+source_profile = base
+session_tags = interim=profile
+transitive_session_tags = interim
+[profile target]
+role_arn = arn:aws:iam::123456789012:role/target
+source_profile = interim
+session_tags = target=profile
+transitive_session_tags = target
+`))
+	defer os.Remove(f)
+
+	configFile, err := vault.LoadConfig(f)
+	if err != nil {
+		t.Fatal(err)
+	}
+	loader := &vault.ConfigLoader{File: configFile, ActiveProfile: "target"}
+	target, err := loader.LoadFromProfile("target")
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := newAssumeRoleTestServer(t)
+	defer server.Close()
+
+	assertAssumeRoleTags(t, server, target, map[string]string{"target": "profile"}, []string{"target"})
+	assertAssumeRoleTags(t, server, target.SourceProfile, map[string]string{"interim": "profile"}, []string{"interim"})
+}
