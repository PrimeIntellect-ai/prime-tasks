+func TestSessionTagsFromEnvironmentReachAssumeRole(t *testing.T) {
+	t.Setenv("AWS_SESSION_TAGS", "tagA=val1,tagB=val2")
+	t.Setenv("AWS_TRANSITIVE_TAGS", "tagB,tagA")
+	f := newConfigFile(t, []byte(`[profile target]
+role_arn = arn:aws:iam::123456789012:role/target
+`))
+	defer os.Remove(f)
+
+	configFile, err := vault.LoadConfig(f)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config, err := (&vault.ConfigLoader{File: configFile, ActiveProfile: "target"}).LoadFromProfile("target")
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := newAssumeRoleTestServer(t)
+	defer server.Close()
+
+	assertAssumeRoleTags(t, server, config, map[string]string{"tagA": "val1", "tagB": "val2"}, []string{"tagA", "tagB"})
+}
