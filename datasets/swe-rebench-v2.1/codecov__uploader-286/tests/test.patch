+describe('TravisCI upload', () => {
+  it('uploads a coverage report successfully from a Travis build', async () => {
+    const originalEnv = { ...process.env }
+    jest.spyOn(console, 'log').mockImplementation(() => {})
+    process.env.CI = 'true'
+    process.env.TRAVIS = 'true'
+    process.env.TRAVIS_BUILD_WEB_URL = 'https://travis-ci.com/example/project/jobs/1'
+    delete process.env.SHIPPABLE
+
+    nock('https://codecov.io')
+      .post('/upload/v4')
+      .query(true)
+      .reply(200, 'https://results.codecov.io\nhttps://codecov.io')
+    nock('https://codecov.io').put('/').reply(200, 'success')
+
+    try {
+      const result = await app.main({
+        file: 'test/fixtures/coverage.txt',
+        token: 'abcdefg',
+        url: 'https://codecov.io',
+        flags: '',
+      })
+
+      expect(result).toMatchObject({ status: 'success' })
+    } finally {
+      process.env = originalEnv
+      nock.cleanAll()
+      jest.restoreAllMocks()
+    }
+  }, 30000)
+})
