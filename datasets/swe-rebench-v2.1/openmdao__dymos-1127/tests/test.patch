+import unittest
+from openmdao.utils.testing_utils import use_tempdirs
+from openmdao.utils.assert_utils import assert_near_equal
+
+import openmdao.api as om
+import dymos as dm
+import numpy as np
+
+
+class MatrixParamODE(om.ExplicitComponent):
+    """
+    A simple ODE whose parameter is a matrix that varies at each node.
+    """
+
+    def initialize(self):
+        self.options.declare('num_nodes', types=int)
+        self.options.declare('static_params', types=bool, default=False)
+
+    def setup(self):
+        nn = self.options['num_nodes']
+        static = self.options['static_params']
+        self.add_input('x', val=np.ones((nn, 2)))
+        self.add_input('A', val=np.ones((2, 2)) if static else np.ones((nn, 2, 2)))
+        self.add_output('x_dot', val=np.zeros((nn, 2)))
+        self.declare_partials(of='*', wrt='*', method='fd')
+
+    def compute(self, inputs, outputs):
+        subscript = 'jk,ik->ij' if self.options['static_params'] else 'ijk,ik->ij'
+        outputs['x_dot'] = np.einsum(subscript, inputs['A'], inputs['x'])
+
+# @use_tempdirs
+class RankThreeParamODE(om.ExplicitComponent):
+    """ODE whose node-varying input parameter has rank three."""
+
+    def initialize(self):
+        self.options.declare('num_nodes', types=int)
+
+    def setup(self):
+        nn = self.options['num_nodes']
+        self.add_input('x', val=np.ones((nn, 2)))
+        self.add_input('tensor', val=np.ones((nn, 2, 2, 2)))
+        self.add_output('x_dot', val=np.zeros((nn, 2)))
+        self.declare_partials(of='*', wrt='*', method='fd')
+
+    def compute(self, inputs, outputs):
+        outputs['x_dot'] = np.einsum('nijk,nk->ni', inputs['tensor'], inputs['x'])
+
+
+class TestDocOscillator(unittest.TestCase):
+
+    def test_oscillator_vector_ode_phase_initialization(self):
+        from dymos.examples.oscillator.oscillator_ode import OscillatorVectorODE
+
+        for static_params in (False, True):
+            ode_probe = om.Problem()
+            ode_probe.model.add_subsystem(
+                'ode', OscillatorVectorODE(num_nodes=2, static_params=static_params))
+            ode_probe.setup()
+            rate_source = ode_probe.model.ode.list_outputs(
+                out_stream=None, val=False, prom_name=True)[0][1]['prom_name']
+
+            prob = om.Problem()
+            prob.driver = om.ScipyOptimizeDriver()
+            prob.driver.options['optimizer'] = 'SLSQP'
+            phase = dm.Phase(ode_class=OscillatorVectorODE,
+                             transcription=dm.Radau(num_segments=2, order=3),
+                             ode_init_kwargs={'static_params': static_params})
+            phase.set_time_options(fix_initial=True, duration_bounds=(1.0, 2.0),
+                                   duration_ref=1.0)
+            phase.add_state('x', fix_initial=True, rate_source=rate_source)
+            phase.add_parameter(
+                'A', val=np.array([[0.0, 1.0], [-1.0, 0.0]]), targets=['A'],
+                static_target=static_params)
+            phase.add_objective('time', loc='final', scaler=1.0)
+            traj = dm.Trajectory()
+            traj.add_phase('phase0', phase)
+            prob.model.add_subsystem('traj', traj)
+            prob.setup()
+            phase.set_state_val('x', vals=[[1.0, 0.0], [1.0, 0.0]])
+            dm.run_problem(prob, run_driver=True, simulate=True)
+
+            final_time = float(prob.get_val('traj.phase0.timeseries.time')[-1])
+            final_state = prob.get_val('traj.phase0.timeseries.x')[-1]
+            assert_near_equal(final_state,
+                              np.array([np.cos(final_time), -np.sin(final_time)]),
+                              tolerance=1e-5)
+
+    def test_simulate_rank_three_parameter(self):
+        prob = om.Problem()
+        phase = dm.Phase(ode_class=RankThreeParamODE,
+                         transcription=dm.Radau(num_segments=2, order=3))
+        phase.set_time_options(initial_val=0.0, duration_val=1.0,
+                               fix_initial=True, fix_duration=True)
+        phase.add_state('x', fix_initial=True, rate_source='x_dot')
+
+        tensor = np.zeros((2, 2, 2))
+        tensor[0, 0, 0] = 0.2
+        tensor[1, 0, 1] = -0.3
+        phase.add_parameter('tensor', val=tensor, targets=['tensor'])
+
+        traj = dm.Trajectory()
+        traj.add_phase('phase0', phase)
+        prob.model.add_subsystem('traj', traj)
+        prob.setup()
+        phase.set_state_val('x', [1.0, 1.0])
+
+        dm.run_problem(prob, run_driver=False, simulate=True)
+
+        final_state = prob.get_val('traj.phase0.timeseries.x')[-1]
+        self.assertEqual(final_state.shape, (2,))
+        self.assertTrue(np.all(np.isfinite(final_state)))
+
+    def test_matrix_param(self):
+
+        # Instantiate an OpenMDAO Problem instance.
+        prob = om.Problem()
+        prob.driver = om.ScipyOptimizeDriver()
+        prob.driver.options["optimizer"] = 'SLSQP'
+
+        static_params = False
+
+        t = dm.Radau(num_segments=2, order=3)
+        phase = dm.Phase(ode_class=MatrixParamODE, transcription=t,
+                         ode_init_kwargs={'static_params': static_params})
+
+        phase.set_time_options(fix_initial=True, duration_bounds=(1, 2), duration_ref=1)
+        phase.add_state("x", fix_initial=True, rate_source="x_dot")
+
+        A_mat = np.array(
+            [
+                [0, 1],
+                [-1, 0]
+            ]
+        )
+
+        # argument "dynamic" doesn't seem to help
+        phase.add_parameter("A", val=A_mat, targets=["A"], static_target=static_params)
+        phase.add_objective("time", loc="final", scaler=1)
+
+        traj = dm.Trajectory()
+        traj.add_phase("phase0", phase)
+
+        prob.model.add_subsystem("traj", traj)
+
+        prob.driver.declare_coloring()
+        prob.setup(force_alloc_complex=True)
+        phase.set_state_val('x', vals=[[1, 0], [1, 0]])
+
+        dm.run_problem(prob, run_driver=True, simulate=True, make_plots=True)
+        t_f = prob.get_val('traj.phase0.timeseries.time')[-1]
+        final_state = prob.get_val('traj.phase0.timeseries.x')[-1, :]
+        assert_near_equal(final_state, np.array([np.cos(t_f), -np.sin(t_f)]).ravel(),
+                          tolerance=1e-5)
+
