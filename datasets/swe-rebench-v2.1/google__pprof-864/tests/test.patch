+// TestMissingProfileCommand verifies that running the pprof command with a
+// missing profile reports the failure instead of panicking.
+func TestMissingProfileCommand(t *testing.T) {
+	cmd := exec.Command("go", "run", "../..", "./missing")
+	out, err := cmd.CombinedOutput()
+	if err == nil {
+		t.Fatalf("go run . ./missing: got no error, want non-zero exit; output:\n%s", out)
+	}
+	got := string(out)
+	for _, want := range []string{
+		"no such file or directory",
+		"pprof: failed to fetch any source profiles",
+		"exit status 2",
+	} {
+		if !strings.Contains(got, want) {
+			t.Errorf("go run . ./missing output does not contain %q; got:\n%s", want, got)
 		}
 	}
 }
