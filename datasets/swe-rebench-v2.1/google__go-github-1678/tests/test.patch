+func TestWebHookPayload_Marshal(t *testing.T) {
+	v := WebHookPayload{
+		Action:       String("created"),
+		Installation: &Installation{ID: Int64(1)},
+		Organization: &Organization{Login: String("octocat")},
+	}
+	data, err := json.Marshal(v)
+	if err != nil {
+		t.Fatalf("WebHookPayload.Marshal: %v", err)
+	}
+	var got map[string]interface{}
+	if err := json.Unmarshal(data, &got); err != nil {
+		t.Fatalf("WebHookPayload.Unmarshal: %v", err)
+	}
+	if got["action"] != "created" {
+		t.Errorf("action = %v, want %v", got["action"], "created")
+	}
+	installation, ok := got["installation"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("installation = %v, want a JSON object", got["installation"])
+	}
+	if installation["id"] != float64(1) {
+		t.Errorf("installation.id = %v, want %v", installation["id"], 1)
+	}
+	organization, ok := got["organization"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("organization = %v, want a JSON object", got["organization"])
+	}
+	if organization["login"] != "octocat" {
+		t.Errorf("organization.login = %v, want %v", organization["login"], "octocat")
 	}
