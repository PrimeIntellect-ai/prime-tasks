+// TestKeyStoreServiceKeyPersistsAcrossInstances verifies that the service encryption key is
+// created once and reused, so that a key stored by one instance of the service can be read by
+// another instance backed by the same storage.
+func TestKeyStoreServiceKeyPersistsAcrossInstances(t *testing.T) {
+	for _, test := range testutil.TestDatabases {
+		t.Run(test.Name, func(t *testing.T) {
+			db := test.ServiceStorage(t)
+			require.NotEmpty(t, db)
+
+			serviceConfig := config.KeyStoreServiceConfig{
+				BaseServiceConfig: &config.BaseServiceConfig{Name: "test-keystore"},
+				MasterKeyPassword: "test-password",
+			}
+
+			// first instance stores a key
+			first, err := keystore.NewKeyStoreService(serviceConfig, db)
+			require.NoError(t, err)
+			require.NotEmpty(t, first)
+
+			_, privKey, err := crypto.GenerateEd25519Key()
+			require.NoError(t, err)
+
+			keyID := "test-persisted-key"
+			err = first.StoreKey(context.Background(), keystore.StoreKeyRequest{
+				ID:               keyID,
+				Type:             crypto.Ed25519,
+				Controller:       "test-controller",
+				PrivateKeyBase58: base58.Encode(privKey),
+			})
+			require.NoError(t, err)
+
+			// a second instance (simulating another replica or a restart) must reuse the same service key
+			second, err := keystore.NewKeyStoreService(serviceConfig, db)
+			require.NoError(t, err)
+			require.NotEmpty(t, second)
+
+			got, err := second.GetKey(context.Background(), keystore.GetKeyRequest{ID: keyID})
+			require.NoError(t, err)
+			require.NotEmpty(t, got)
+			require.Equal(t, privKey, got.Key)
+		})
+	}
+}
