+// TestKeyStoreServiceFailsWhenServiceKeyCannotBeStored verifies that creating the keystore
+// service surfaces an error when the backing storage is unavailable and the service encryption
+// key cannot be created or stored.
+func TestKeyStoreServiceFailsWhenServiceKeyCannotBeStored(t *testing.T) {
+	file, err := os.CreateTemp("", "bolt")
+	require.NoError(t, err)
+	name := file.Name()
+	require.NoError(t, file.Close())
+	t.Cleanup(func() { _ = os.Remove(name) })
+
+	db, err := storage.NewStorage(storage.Bolt, storage.Option{ID: storage.BoltDBFilePathOption, Option: name})
+	require.NoError(t, err)
+	require.NoError(t, db.Close())
+
+	serviceConfig := config.KeyStoreServiceConfig{
+		BaseServiceConfig: &config.BaseServiceConfig{Name: "test-keystore"},
+		MasterKeyPassword: "test-password",
+	}
+
+	_, err = keystore.NewKeyStoreService(serviceConfig, db)
+	require.Error(t, err)
+}
