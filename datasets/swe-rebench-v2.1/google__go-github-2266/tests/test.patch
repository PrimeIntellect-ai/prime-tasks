+func TestPagesUpdate_GetHTTPSEnforced(tt *testing.T) {
+	var zeroValue bool
+	p := &PagesUpdate{HTTPSEnforced: &zeroValue}
+	if got := p.GetHTTPSEnforced(); got != false {
+		tt.Errorf("GetHTTPSEnforced() = %v, want false", got)
+	}
+	p = &PagesUpdate{HTTPSEnforced: Bool(true)}
+	if got := p.GetHTTPSEnforced(); got != true {
+		tt.Errorf("GetHTTPSEnforced() = %v, want true", got)
+	}
+	p = &PagesUpdate{}
+	if got := p.GetHTTPSEnforced(); got != false {
+		tt.Errorf("GetHTTPSEnforced() = %v, want false", got)
+	}
+	p = nil
+	if got := p.GetHTTPSEnforced(); got != false {
+		tt.Errorf("GetHTTPSEnforced() = %v, want false", got)
+	}
+}
