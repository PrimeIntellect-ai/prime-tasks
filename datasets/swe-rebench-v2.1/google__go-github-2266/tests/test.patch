+func TestRepositoriesService_UpdatePages_AdditionalParameters(t *testing.T) {
+	client, mux, _, teardown := setup()
+	defer teardown()
+
+	input := &PagesUpdate{
+		Public:        Bool(true),
+		HTTPSEnforced: Bool(true),
+	}
+
+	mux.HandleFunc("/repos/o/r/pages", func(w http.ResponseWriter, r *http.Request) {
+		testMethod(t, r, "PUT")
+
+		var body map[string]interface{}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Fatalf("unable to decode request body: %v", err)
+		}
+
+		if got, ok := body["public"]; !ok || got != true {
+			t.Errorf("Request body public = %v, want true", got)
+		}
+		if got, ok := body["https_enforced"]; !ok || got != true {
+			t.Errorf("Request body https_enforced = %v, want true", got)
+		}
+
+		fmt.Fprint(w, `{}`)
+	})
+
+	ctx := context.Background()
+	_, err := client.Repositories.UpdatePages(ctx, "o", "r", input)
+	if err != nil {
+		t.Errorf("Repositories.UpdatePages returned error: %v", err)
+	}
+}
