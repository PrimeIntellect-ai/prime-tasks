+@pytest.mark.isolated
+@pytest.mark.skipif(IS_PY2, reason='venv module used on Python 3 only')
+@pytest.mark.skipif(IS_PYPY3, reason='PyPy3 uses get path to create and provision venv')
+@pytest.mark.skipif(os.name != 'nt', reason='unsupported symlinks are probed on Windows')
+def test_venv_creation_honours_unsupported_symlinks(mocker):
+    mocker.patch.object(build.env, 'virtualenv', None)
+    mocker.patch('os.symlink', side_effect=OSError())
+    with build.env.IsolatedEnvBuilder() as env:
+        assert not os.path.islink(env.executable)
