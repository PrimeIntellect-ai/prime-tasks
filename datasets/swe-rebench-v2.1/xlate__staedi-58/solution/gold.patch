+      <element type="I11" minOccurs="1"/>
+      <element type="I12" minOccurs="1"/>
+      <element type="I13" minOccurs="1"/>
+      <element type="I14" minOccurs="1"/>
+      <element type="I15" minOccurs="1"/>
+    </sequence>
+  </segmentType>
+</schema>
