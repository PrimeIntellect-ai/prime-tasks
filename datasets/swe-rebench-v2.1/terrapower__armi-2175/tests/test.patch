@@ -152,3 +158,70 @@ class TestFlag(unittest.TestCase):
 
     def test_getitem(self):
         self.assertEqual(ExampleFlag["FOO"], ExampleFlag.FOO)
+
+    def test_duplicateFlags(self):
+        """Adding a flag whose name already exists must not corrupt the flag set."""
+
+        class F(Flag):
+            pass
+
+        F.extend({"FLAG0": auto()})
+        for i in range(1, 12):
+            F.extend({f"FLAG{i}": auto()})
+            try:
+                F.extend({f"FLAG{i - 1}": auto()})
+            except Exception:
+                # Rejecting a duplicate definition outright is acceptable; the
+                # important thing is that the flag set is not corrupted.
+                pass
+
+            # The flag set must remain consistent and packable.
+            ff = getattr(F, f"FLAG{i}")
+            FlagSerializer._packImpl([ff], F)
+
+    def test_soManyFlags(self):
+        """Show that many flags can be added without issue."""
+
+        class F(Flag):
+            pass
+
+        for i in range(1, 100):
+            num = len(F.fields())
+            flagName = f"FLAG{i}"
+            F.extend({flagName: auto()})
+            self.assertEqual(len(F.fields()), num + 1)
+
+            flag = getattr(F, flagName)
+            FlagSerializer._packImpl([flag], F)
+            self.assertEqual(len(F.fields()), num + 1)
+
+    def test_flagsWritableToDatabase(self):
+        """A flag set that previously could not be written to a database can now be written."""
+
+        class F(Flag):
+            pass
+
+        F.extend({"FLAG0": auto()})
+        for i in range(1, 12):
+            F.extend({f"FLAG{i}": auto()})
+            try:
+                F.extend({f"FLAG{i - 1}": auto()})
+            except Exception:
+                pass
+
+        data = [getattr(F, f"FLAG{i}") for i in range(1, 12)]
+        packed, attrs = FlagSerializer._packImpl(data, F)
+
+        # Write the packed flags to an HDF5 file, as the database does.
+        with tempfile.TemporaryDirectory() as tmpDir:
+            path = os.path.join(tmpDir, "flags.h5")
+            with h5py.File(path, "w") as f:
+                dataset = f.create_dataset("flags", data=packed)
+                for key, value in attrs.items():
+                    dataset.attrs[key] = value
+
+            with h5py.File(path, "r") as f:
+                readPacked = np.array(f["flags"][()])
+
+        out = [F.from_bytes(row.tobytes()) for row in readPacked]
+        self.assertEqual(data, out)
