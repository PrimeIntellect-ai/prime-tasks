+func portForURL(u *url.URL) string {
+	port := u.Port()
+	if port != "" {
+		return port
+	}
+	switch u.Scheme {
+	case "http":
+		return "80"
+	case "https":
+		return "443"
+	case "ssh":
+		return "22"
+	default:
+		return ""
+	}
+}
