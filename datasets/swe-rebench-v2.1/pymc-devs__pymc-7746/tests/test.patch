+def test_remove_minibatches():
+    data_size = 100
+    data = np.zeros((data_size,))
+    batch_size = 10
+    with pm.Model(coords={"d": range(5)}) as m1:
+        mb = pm.Minibatch(data, batch_size=batch_size)
+        mu = pm.Normal("mu", dims="d")
+        x = pm.Normal("x")
+        y = pm.Normal("y", x, observed=mb, total_size=100)
+
+    m2 = remove_minibatched_nodes(m1)
+    # The returned model must yield full-size observations. The contract allows
+    # the implementation to either mutate ``m1`` in place or return a new model,
+    # so we only inspect the returned model here.
+    assert m2.y.shape[0].eval() == data_size
+    # Coordinates and dim-length metadata must be preserved.
+    assert m2.coords["d"] == tuple(range(5))
+    assert m2.dim_lengths["d"].eval() == 5
+
