+def test_remove_minibatches_multiple():
+    data_size = 100
+    batch_size = 10
+    data1 = np.zeros((data_size,))
+    data2 = np.ones((data_size,))
+    with pm.Model() as m1:
+        mb1 = pm.Minibatch(data1, batch_size=batch_size)
+        mb2 = pm.Minibatch(data2, batch_size=batch_size)
+        x = pm.Normal("x")
+        y1 = pm.Normal("y1", x, observed=mb1, total_size=data_size)
+        y2 = pm.Normal("y2", x, observed=mb2, total_size=data_size)
+
+    m2 = remove_minibatched_nodes(m1)
+    # Every MinibatchOp output must be replaced, not just the first one.
+    assert m2.y1.shape[0].eval() == data_size
+    assert m2.y2.shape[0].eval() == data_size
+
+
+def test_remove_minibatches_paired_arrays():
+    # A single Minibatch call can wrap several arrays at once. Every output of
+    # that MinibatchOp must be replaced by its underlying input, not just the
+    # first one.
+    data_size = 100
+    batch_size = 10
+    X_full = np.random.default_rng(0).uniform(2, 10, size=(data_size, 3))
+    y_full = np.random.default_rng(1).normal(size=(data_size,))
+    with pm.Model() as m1:
+        X_mb, y_mb = pm.Minibatch(X_full, y_full, batch_size=batch_size)
+        b = pm.Normal("b", mu=0, sigma=3, shape=(3,))
+        mu = pm.Deterministic("mu", X_mb @ b)
+        y = pm.Normal("y", mu=mu, sigma=1, observed=y_mb, total_size=data_size)
+
+    m2 = remove_minibatched_nodes(m1)
+    # The observed variable must have full-dataset size...
+    assert m2.y.shape[0].eval() == data_size
+    # ...and so must the deterministic that consumed the other Minibatch output.
+    assert m2["mu"].shape[0].eval() == data_size
