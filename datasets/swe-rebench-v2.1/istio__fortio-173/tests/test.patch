+func TestCurlHeaderBeforeTarget(t *testing.T) {
+	const headerValue = "delivered-by-curl"
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		fmt.Fprintf(w, "request-marker:%s:%s", r.URL.Path, r.Header.Get("X-Contract-Header"))
+	}))
+	defer server.Close()
+
+	cmd := exec.Command("go", "run", "-mod=mod", "..", "curl", "-H", "X-Contract-Header: "+headerValue, server.URL+"/target")
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("curl command failed: %v\n%s", err, output)
+	}
+	if !strings.Contains(string(output), "request-marker:/target:"+headerValue) {
+		t.Errorf("curl did not request the supplied target with the supplied header; output: %s", output)
+	}
+	if strings.Contains(strings.ToLower(string(output)), "unexpected init with empty url") {
+		t.Errorf("curl initialized with an empty URL: %s", output)
+	}
+}
