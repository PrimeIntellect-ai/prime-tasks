+def test_python_35_support_dropped():
+    """Python 3.5 support should be dropped for v0.12+ (see problem statement)"""
+    repo_root = abspath(join(dirname(__file__), ".."))
+
+    # The tox test environments should no longer include Python 3.5
+    tox_config = configparser.ConfigParser()
+    tox_config.read(join(repo_root, "tox.ini"))
+    assert "py35" not in tox_config.get("tox", "envlist")
+    assert not tox_config.has_section("testenv:py35")
+
+    # Package metadata should no longer declare Python 3.5 support
+    setup_config = configparser.ConfigParser()
+    setup_config.read(join(repo_root, "setup.cfg"))
+    assert "Programming Language :: Python :: 3.5" not in setup_config.get("metadata", "classifiers")
+
+    # CI configuration should no longer run tests on Python 3.5
+    travis_path = join(repo_root, ".travis.yml")
+    if exists(travis_path):
+        with open(travis_path) as f:
+            travis_config = f.read()
+        assert not re.search(r'-\s*python:\s*["\']?3\.5["\']?', travis_config)
