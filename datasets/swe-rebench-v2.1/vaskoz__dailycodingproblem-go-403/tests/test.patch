+package day194_test
+
+import (
+	"testing"
+
+	"dailycodingproblem-go/day194"
+)
+
+var testcases = []struct {
+	p, q          []int
+	intersections int
+}{
+	{[]int{3, 1}, []int{1, 3}, 1},
+	{[]int{0, 10, 7, 4, 12, 9, 2}, []int{3, 5, 11, 6, 1, 13, 8}, 11},
+	// Shared left endpoints (equal p values) never count.
+	{[]int{1, 1}, []int{0, 1}, 0},
+	// Shared right endpoints (equal q values) never count.
+	{[]int{0, 1}, []int{2, 2}, 0},
+	// Coincident segments never count.
+	{[]int{5, 5}, []int{3, 3}, 0},
+	// Endpoint touching another segment's endpoint does not count; only the strict crossing does.
+	{[]int{0, 2, 2}, []int{2, 0, 4}, 1},
+	// Ties mixed with a single strict crossing: only the crossing counts.
+	{[]int{0, 1, 1}, []int{1, 0, 2}, 1},
+}
+
+func TestCountIntersectionsBrute(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		if result := day194.CountIntersectionsBrute(tc.p, tc.q); result != tc.intersections {
+			t.Errorf("Expected %v, got %v", tc.intersections, result)
+		}
+	}
+}
+
+func BenchmarkCountIntersectionsBrute(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			day194.CountIntersectionsBrute(tc.p, tc.q)
+		}
+	}
+}
