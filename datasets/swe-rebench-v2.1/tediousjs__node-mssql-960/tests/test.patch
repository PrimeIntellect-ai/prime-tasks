diff --git a/test/common/unit.js b/test/common/unit.js
index 8df698a..45ae3e7 100644
--- a/test/common/unit.js
+++ b/test/common/unit.js
@@ -5,6 +5,7 @@
 const sql = require('../../')
 const assert = require('assert')
 const cs = require('../../lib/connectionstring')
+const { EventEmitter } = require('events')
 
 describe('Connection String', () => {
   it('Connection String #1', done => {
@@ -273,4 +274,73 @@ describe('Unit', () => {
       command: 'select * from myTable where id in (@param1_0, @param1_1, @param1_2)'
     })
   })
+
+  it('tagged template literal request', () => {
+    const req = new sql.Request()
+    const sqlstr = req.template`select * from myTable where id = ${123}`
+    const placeholders = sqlstr.match(/@[A-Za-z_][A-Za-z0-9_]*/g) || []
+    const bound = Object.entries(req.parameters).filter(([name]) => placeholders.includes(`@${name}`))
+
+    assert.strictEqual(placeholders.length, 1)
+    assert.strictEqual(new Set(placeholders).size, 1)
+    assert.strictEqual(bound.length, 1)
+    assert.strictEqual(bound[0][1].value, 123)
+  })
+
+  it('tagged template literal request preserves multiple interpolations', () => {
+    const req = new sql.Request()
+    const sqlstr = req.template`select * from myTable where first = ${123} and second = ${'abc'}`
+    const placeholders = sqlstr.match(/@[A-Za-z_][A-Za-z0-9_]*/g) || []
+    const bound = Object.entries(req.parameters).filter(([name]) => placeholders.includes(`@${name}`))
+    const values = bound.map(([, parameter]) => parameter.value)
+
+    assert.strictEqual(placeholders.length, 2)
+    assert.strictEqual(new Set(placeholders).size, 2)
+    assert.strictEqual(bound.length, 2)
+    assert(values.includes(123))
+    assert(values.includes('abc'))
+  })
+
+  it('accepts a template-built query with a callback', done => {
+    const req = new sql.Request({ connected: false })
+    const value = 'hello world'
+    const sqlstr = req.template`select ${value}`
+
+    req.query(sqlstr, () => {
+      done()
+    })
+  })
+
+  it('template interpolation values are sent with the query when it executes', done => {
+    const sent = {}
+    const connection = new EventEmitter()
+    connection.execSql = tdsRequest => {
+      for (const param of tdsRequest.parameters) {
+        sent[param.name] = param.value
+      }
+      tdsRequest.callback(null, 0)
+    }
+    const parent = {
+      connected: true,
+      acquire: (_request, cb) => cb(null, connection, { options: {} }),
+      release: () => {}
+    }
+    const req = new sql.Request(parent)
+    const sqlstr = req.template`select * from myTable where first = ${123} and second = ${'abc'}`
+    const placeholders = sqlstr.match(/@[A-Za-z_][A-Za-z0-9_]*/g) || []
+
+    req.query(sqlstr, err => {
+      if (err) return done(err)
+      try {
+        const values = placeholders.map(placeholder => sent[placeholder.slice(1)])
+        assert.strictEqual(placeholders.length, 2)
+        assert.strictEqual(values.length, 2)
+        assert(values.includes(123))
+        assert(values.includes('abc'))
+        done()
+      } catch (error) {
+        done(error)
+      }
+    })
+  })
 })
