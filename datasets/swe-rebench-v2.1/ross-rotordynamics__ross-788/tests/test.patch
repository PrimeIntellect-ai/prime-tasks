+def _campbell_scatter_points(fig):
+    """Return the damping-coloured scatter traces of a Campbell figure."""
+    points = []
+    for trace in fig.data:
+        if trace.mode and "markers" in trace.mode:
+            color = trace.marker.color
+            if color is not None and not isinstance(color, str):
+                points.append(trace)
+    return points
+
+
+def _campbell_point_count(fig):
+    return sum(len(trace.x) for trace in _campbell_scatter_points(fig))
+
+
+def test_campbell_plot_figure(rotor1):
+    speed = np.linspace(0, 400, 101)
+    camp = rotor1.run_campbell(speed)
+    fig = camp.plot(
+        harmonics=[1, 2], damping_parameter="damping_ratio", frequency_units="RPM"
+    )
+
+    assert isinstance(fig, go.Figure)
+    assert "RPM" in fig.layout.xaxis.title.text
+    assert "RPM" in fig.layout.yaxis.title.text
+    # damping-coloured scatter points are present
+    assert _campbell_point_count(fig) > 0
+
+
+def test_campbell_plot_damping_ratio_colorbar(rotor1):
+    speed = np.linspace(0, 400, 101)
+    camp = rotor1.run_campbell(speed)
+    fig = camp.plot(damping_parameter="damping_ratio")
+
+    title = fig.layout.coloraxis.colorbar.title.text
+    assert title is not None
+    assert "damping ratio" in title.lower()
+
+    reference = go.Figure()
+    reference.update_layout(coloraxis_colorscale="rdbu")
+    assert tuple(fig.layout.coloraxis.colorscale) == tuple(
+        reference.layout.coloraxis.colorscale
+    )
+
+
+def test_campbell_plot_log_dec_colorbar(rotor1):
+    speed = np.linspace(0, 400, 101)
+    camp = rotor1.run_campbell(speed)
+    fig = camp.plot(damping_parameter="log_dec")
+
+    title = fig.layout.coloraxis.colorbar.title.text
+    assert title is not None
+    assert "damping ratio" not in title.lower()
+
+
+def test_campbell_plot_damping_parameter_validation(rotor1):
+    speed = np.linspace(0, 400, 101)
+    camp = rotor1.run_campbell(speed)
+
+    # both documented values are accepted
+    camp.plot(damping_parameter="log_dec")
+    camp.plot(damping_parameter="damping_ratio")
+
+    with pytest.raises(ValueError):
+        camp.plot(damping_parameter="not_a_parameter")
+
+
+def test_campbell_plot_frequency_range(rotor1):
+    speed = np.linspace(0, 400, 101)
+    camp = rotor1.run_campbell(speed)
+
+    unfiltered = camp.plot(frequency_units="RPM")
+    filtered = camp.plot(
+        frequency_range=Q_((2000, 10000), "RPM"), frequency_units="RPM"
+    )
+
+    for trace in _campbell_scatter_points(filtered):
+        ys = np.asarray(trace.y)
+        assert np.all(ys >= 2000)
+        assert np.all(ys <= 10000)
+
+    assert _campbell_point_count(filtered) < _campbell_point_count(unfiltered)
+
+
+def test_campbell_plot_frequency_range_tuple(rotor1):
+    speed = np.linspace(0, 400, 101)
+    camp = rotor1.run_campbell(speed)
+
+    unfiltered = camp.plot(frequency_units="RPM")
+    filtered = camp.plot(frequency_range=(0.0, 1.0e6), frequency_units="RPM")
+
+    # a plain tuple is accepted and the points inside the range are kept
+    assert _campbell_point_count(filtered) == _campbell_point_count(unfiltered)
+
+
+def test_campbell_plot_frequency_range_tuple_is_rad_per_second(rotor1):
+    speed = np.linspace(0, 400, 101)
+    camp = rotor1.run_campbell(speed)
+
+    unfiltered = camp.plot(frequency_units="RPM")
+    as_tuple = camp.plot(frequency_range=(0.0, 300.0), frequency_units="RPM")
+    as_quantity = camp.plot(
+        frequency_range=Q_((0.0, 300.0), "rad/s"), frequency_units="RPM"
+    )
+
+    # a plain tuple gives the same selection as the equivalent rad/s quantity
+    assert _campbell_point_count(as_tuple) == _campbell_point_count(as_quantity)
+    # and the window actually removes some modes
+    assert 0 < _campbell_point_count(as_tuple) < _campbell_point_count(unfiltered)
+
+
+def test_campbell_plot_damping_range(rotor1):
+    speed = np.linspace(0, 400, 101)
+    camp = rotor1.run_campbell(speed)
+
+    included = camp.plot(damping_parameter="damping_ratio", damping_range=(-1.0, 1.0))
+    excluded = camp.plot(damping_parameter="damping_ratio", damping_range=(0.5, 1.0))
+
+    assert _campbell_point_count(included) > 0
+    # every modal point of this rotor has a damping ratio close to zero,
+    # so a range of (0.5, 1.0) must remove all of them
+    assert _campbell_point_count(excluded) == 0
