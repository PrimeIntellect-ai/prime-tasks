+def test_explain_prediction_selects_top_k_by_shap_magnitude(output_format):
+    feature_values = {"a": 1, "b": 2, "c": 3, "d": 4, "e": 5, "f": 6}
+    pipeline = MagicMock()
+    pipeline.problem_type = ProblemTypes.REGRESSION
+    pipeline.compute_estimator_features.return_value = pd.DataFrame({name: [value] for name, value in feature_values.items()})
+    input_features = pd.DataFrame({name: [value] for name, value in feature_values.items()})
+    # Largest magnitudes are b (-5.0), c (4.0) and e (-3.0); the rest are small.
+    shap_values = {"a": [0.1], "b": [-5.0], "c": [4.0], "d": [0.2], "e": [-3.0], "f": [0.3]}
+
+    with patch("evalml.model_understanding.prediction_explanations._user_interface._compute_shap_values",
+               return_value=shap_values), \
+            patch("evalml.model_understanding.prediction_explanations._user_interface._normalize_shap_values",
+                  return_value=shap_values):
+        report = explain_prediction(pipeline, input_features, top_k=3, output_format=output_format)
+
+    if output_format == "dict":
+        selected = set(report["explanations"][0]["feature_names"])
+    else:
+        selected = {line.split()[0] for line in report.splitlines()
+                    if line.split() and line.split()[0] in feature_values}
+    assert selected == {"b", "c", "e"}
