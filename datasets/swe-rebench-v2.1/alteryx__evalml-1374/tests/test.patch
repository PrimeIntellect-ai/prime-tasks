+def test_explain_predictions_selects_by_shap_magnitude():
+    class TestPipeline(RegressionPipeline):
+        component_graph = [RandomForestRegressor]
+        custom_name = "prediction explanation test pipeline"
+
+    values = np.arange(40, dtype=float)
+    training_data = pd.DataFrame({
+        "largest": values,
+        "second_largest": values % 7,
+        "negative_contribution": np.sin(values),
+        "small_contribution": np.cos(values),
+    })
+    target = (100 * training_data["largest"] + 10 * training_data["second_largest"] -
+              3 * training_data["negative_contribution"] + 0.2 * training_data["small_contribution"])
+    pipeline = TestPipeline({}, random_state=7)
+    pipeline.fit(training_data, target)
+    input_features = training_data.iloc[[20]]
+
+    all_features_report = explain_predictions(
+        pipeline,
+        input_features,
+        top_k_features=8,
+        include_shap_values=True,
+        output_format="dict",
+    )
+    all_rows = all_features_report["explanations"][0]["explanations"][0]
+    assert len(all_rows["feature_names"]) == len(training_data.columns)
+    magnitude_threshold = sorted(
+        (abs(value) for value in all_rows["quantitative_explanation"]), reverse=True
+    )[1]
+
+    limited_report = explain_predictions(
+        pipeline,
+        input_features,
+        top_k_features=2,
+        include_shap_values=True,
+        output_format="dict",
+    )
+    limited_rows = limited_report["explanations"][0]["explanations"][0]
+    assert len(limited_rows["feature_names"]) == 2
+    assert all(abs(value) >= magnitude_threshold - 1e-10
+               for value in limited_rows["quantitative_explanation"])
+
+    best_worst_full = explain_predictions_best_worst(
+        pipeline,
+        training_data.iloc[:2],
+        target.iloc[:2],
+        num_to_explain=1,
+        top_k_features=8,
+        include_shap_values=True,
+        output_format="dict",
+    )
+    best_worst_limited = explain_predictions_best_worst(
+        pipeline,
+        training_data.iloc[:2],
+        target.iloc[:2],
+        num_to_explain=1,
+        top_k_features=2,
+        include_shap_values=True,
+        output_format="dict",
+    )
+    for full_section, limited_section in zip(
+            best_worst_full["explanations"], best_worst_limited["explanations"]):
+        full_rows = full_section["explanations"][0]
+        selected_rows = limited_section["explanations"][0]
+        assert len(full_rows["feature_names"]) == len(training_data.columns)
+        threshold = sorted(
+            (abs(value) for value in full_rows["quantitative_explanation"]), reverse=True
+        )[1]
+        assert len(selected_rows["feature_names"]) == 2
+        assert all(abs(value) >= threshold - 1e-10
+                   for value in selected_rows["quantitative_explanation"])
