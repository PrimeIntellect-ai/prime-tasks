+func TestAttachmentFilenameWithSemicolon(t *testing.T) {
+	message := "MIME-Version: 1.0\r\n" +
+		"Content-Type: multipart/mixed; boundary=boundary42\r\n" +
+		"\r\n" +
+		"--boundary42\r\n" +
+		"Content-Type: application/octet-stream; name=\"test;file.txt\"\r\n" +
+		"Content-Disposition: attachment; filename=\"test;file.txt\"\r\n" +
+		"Content-Transfer-Encoding: 7bit\r\n" +
+		"\r\n" +
+		"file contents\r\n" +
+		"--boundary42--\r\n"
+	env, err := ReadEnvelope(strings.NewReader(message))
+	if err != nil {
+		t.Fatalf("ReadEnvelope returned an error: %v", err)
+	}
+	if len(env.Attachments) != 1 {
+		t.Fatalf("got %d attachments, want 1", len(env.Attachments))
+	}
+	if got, want := env.Attachments[0].FileName, "test;file.txt"; got != want {
+		t.Errorf("attachment filename got %q, want %q", got, want)
+	}
+}
