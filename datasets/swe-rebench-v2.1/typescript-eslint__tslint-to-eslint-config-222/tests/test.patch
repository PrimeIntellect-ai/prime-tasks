+import { convertRules } from "../../convertRules";
+import { converters } from "../../converters";
+import { mergers } from "../../mergers";
+
+describe("variable-name conversion", () => {
+    test("converts an enabled TSLint rule instead of reporting it as missing", () => {
+        const result = convertRules(
+            { converters, mergers },
+            {
+                "variable-name": true,
+            },
+        );
+
+        expect(result.missing).toEqual([]);
+        expect(result.failed).toEqual([]);
+        expect(result.converted.size).toBeGreaterThan(0);
+    });
+});
