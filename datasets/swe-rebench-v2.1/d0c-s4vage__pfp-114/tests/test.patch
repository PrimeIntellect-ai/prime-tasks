+    def test_enum_compared_to_enum(self):
+        dom = self._test_parse_build(
+            "\x00\x00\x00\x01",
+            """
+                BigEndian();
+                enum <uchar> TEST_ENUM {
+                    BLAH1,
+                };
+
+                do {
+                    TEST_ENUM test = BLAH1;
+                } while (test == BLAH1);
+            """,
+        )
+        self.assertIsNotNone(dom)
+
+    def test_dex_template_enum_comparison(self):
+        """Parsing the DEX.bt template (which compares enum values with !=
+        inside a do-while loop) must complete without errors."""
+        import base64 as _b64
+
+        template = _b64.b64decode(_DEX_BT_B64).decode("utf-8")
+        data = _b64.b64decode(_DEX_MIN_B64)
+        dom = pfp.parse(io.BytesIO(data), template)
+        self.assertIsNotNone(dom)
