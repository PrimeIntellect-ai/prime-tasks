     assert SortImports(file_contents=test_input).output == 'from os.path import join, split\n'
+
+
+def test_ensure_support_for_non_typed_but_cased_alphabetic_sort_issue_890(tmpdir):
+    test_input = ('from pkg import BALL\n'
+                  'from pkg import RC\n'
+                  'from pkg import Action\n'
+                  'from pkg import Bacoo\n'
+                  'from pkg import RCNewCode\n'
+                  'from pkg import actual\n'
+                  'from pkg import rc\n'
+                  'from pkg import recorder\n')
+    expected_case_sensitive_output = ('from pkg import Action\n'
+                                      'from pkg import BALL\n'
+                                      'from pkg import Bacoo\n'
+                                      'from pkg import RC\n'
+                                      'from pkg import RCNewCode\n'
+                                      'from pkg import actual\n'
+                                      'from pkg import rc\n'
+                                      'from pkg import recorder\n')
+    sort_file = tmpdir.join('issue_890.py')
+
+    sort_file.write(test_input)
+    main.main(['--case-sensitive', '--dont-order-by-type', '--force-single-line-imports', str(sort_file)])
+    assert sort_file.read() == expected_case_sensitive_output
+
+    # Without the case-sensitive option the default (case-insensitive) ordering must still apply.
+    sort_file.write(test_input)
+    main.main(['--dont-order-by-type', '--force-single-line-imports', str(sort_file)])
+    default_lines = sort_file.read().splitlines()
+    assert default_lines != expected_case_sensitive_output.splitlines()
+    assert default_lines == sorted(default_lines, key=str.lower)
