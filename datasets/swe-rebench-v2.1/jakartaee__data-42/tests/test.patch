+    @Test
+    public void shouldCreatePageableWithSize() throws ReflectiveOperationException {
+        java.lang.reflect.Method factory = null;
+        Object pageSize = null;
+        Class<?>[] parameterTypes = {long.class, int.class, Long.class, Integer.class};
+        Object[] arguments = {50L, 50, 50L, 50};
+        for (String name : new String[] {"size", "ofSize", "of"}) {
+            for (int i = 0; i < parameterTypes.length; i++) {
+                try {
+                    java.lang.reflect.Method candidate = Pageable.class.getMethod(name, parameterTypes[i]);
+                    if (java.lang.reflect.Modifier.isStatic(candidate.getModifiers())
+                            && Pageable.class.isAssignableFrom(candidate.getReturnType())) {
+                        factory = candidate;
+                        pageSize = arguments[i];
+                        break;
+                    }
+                } catch (NoSuchMethodException ignored) {
+                    // Try the other supported factory signatures.
+                }
+            }
+            if (factory != null) {
+                break;
+            }
+        }
+        Assertions.assertNotNull(factory, "a one-argument page-size factory must be available");
+        Pageable pageable = (Pageable) factory.invoke(null, pageSize);
+        Assertions.assertEquals(50L, pageable.getSize());
+        Assertions.assertEquals(1L, pageable.getPage());
+    }
