+    def test_stop_gradient_functional(self):
+        a = layers.Input(shape=(2,))
+        b = layers.Dense(4, kernel_initializer="ones", use_bias=False)(a)
+        c = layers.Dense(4, kernel_initializer="ones", use_bias=False)(b)
+        d = ops.stop_gradient(b) + c
+        model = models.Model(inputs=a, outputs=d)
+        output = model(ops.convert_to_tensor([[1.0, 2.0]]))
+        self.assertAllClose(ops.convert_to_numpy(output), [[15.0] * 4])
+
+    @pytest.mark.skipif(
+        backend.backend() not in ("tensorflow", "jax", "torch"),
+        reason="Backend does not support gradient computation.",
+    )
+    def test_stop_gradient_functional_blocks_gradients(self):
+        a = layers.Input(shape=(2,))
+        model = models.Model(a, ops.stop_gradient(a))
+
+        if backend.backend() == "tensorflow":
+            import tensorflow as tf
+
+            x = tf.Variable([[1.0, 2.0]])
+            with tf.GradientTape() as tape:
+                output = model(x)
+                total = ops.sum(output)
+            gradient = tape.gradient(total, x)
+        elif backend.backend() == "jax":
+            import jax
+
+            x = ops.convert_to_tensor([[1.0, 2.0]])
+            output = model(x)
+            gradient = jax.grad(lambda value: ops.sum(model(value)))(x)
+        else:
+            import torch
+
+            x = torch.tensor([[1.0, 2.0]], requires_grad=True)
+            output = model(x)
+            gradient = None
+            if output.requires_grad:
+                gradient = torch.autograd.grad(
+                    ops.sum(output), x, allow_unused=True
+                )[0]
+
+        self.assertAllClose(ops.convert_to_numpy(output), [[1.0, 2.0]])
+        if gradient is not None:
+            self.assertAllClose(
+                ops.convert_to_numpy(gradient), [[0.0, 0.0]]
+            )
+
+    @pytest.mark.skipif(
+        backend.backend() not in ("tensorflow", "jax", "torch"),
+        reason="Backend does not support gradient computation.",
+    )
+    def test_stop_gradient_functional_preserves_other_gradients(self):
+        a = layers.Input(shape=(2,))
+        model = models.Model(a, ops.stop_gradient(a) + 2 * a)
+
+        if backend.backend() == "tensorflow":
+            import tensorflow as tf
+
+            x = tf.Variable([[1.0, 2.0]])
+            with tf.GradientTape() as tape:
+                output = model(x)
+                total = ops.sum(output)
+            gradient = tape.gradient(total, x)
+        elif backend.backend() == "jax":
+            import jax
+
+            x = ops.convert_to_tensor([[1.0, 2.0]])
+            output = model(x)
+            gradient = jax.grad(lambda value: ops.sum(model(value)))(x)
+        else:
+            import torch
+
+            x = torch.tensor([[1.0, 2.0]], requires_grad=True)
+            output = model(x)
+            gradient = torch.autograd.grad(ops.sum(output), x)[0]
+
+        self.assertAllClose(ops.convert_to_numpy(output), [[3.0, 6.0]])
+        self.assertAllClose(ops.convert_to_numpy(gradient), [[2.0, 2.0]])
+
