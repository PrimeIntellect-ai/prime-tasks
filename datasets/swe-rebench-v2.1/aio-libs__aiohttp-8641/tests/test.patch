+async def test_close_websocket_while_ping_inflight(
+    aiohttp_client: AiohttpClient,
+) -> None:
+    """Test that an in-flight ping task is not garbage collected."""
+    ping_received = False
+
+    async def handler(request: web.Request) -> web.WebSocketResponse:
+        nonlocal ping_received
+        ws = web.WebSocketResponse(autoping=False)
+        await ws.prepare(request)
+        msg = await ws.receive()
+        assert msg.type is aiohttp.WSMsgType.BINARY
+        msg = await ws.receive()
+        ping_received = msg.type is aiohttp.WSMsgType.PING
+        await ws.receive()
+        await ws.close()
+        return ws
+
+    app = web.Application()
+    app.router.add_route("GET", "/", handler)
+
+    client = await aiohttp_client(app)
+    resp = await client.ws_connect("/", heartbeat=0.1)
+    await resp.send_bytes(b"ask")
+
+    loop = asyncio.get_running_loop()
+    previous_factory = loop.get_task_factory()
+    ping_task_ref: Optional["weakref.ReferenceType[asyncio.Task[None]]"] = None
+    ping_started = asyncio.Event()
+
+    async def hold_task() -> None:
+        nonlocal ping_task_ref
+        ping_task_ref = weakref.ref(asyncio.current_task())
+        ping_started.set()
+        # Keep the task pending on a future with no reference outside itself.
+        await loop.create_future()
+
+    def task_factory(
+        loop: asyncio.AbstractEventLoop,
+        coro: object,
+        context: Optional[object] = None,
+    ) -> "asyncio.Task[None]":
+        coro.close()  # type: ignore[attr-defined]
+        kwargs = {} if context is None else {"context": context}
+        return asyncio.Task(hold_task(), loop=loop, **kwargs)
+
+    loop.set_task_factory(task_factory)
+    try:
+        # On event loops that eagerly complete the ping, the peer observes it
+        # instead; no in-flight task then needs to be retained.
+        deadline = loop.time() + 5
+        while not ping_started.is_set() and not ping_received:
+            assert loop.time() < deadline, "heartbeat ping did not start"
+            await asyncio.sleep(0.01)
+    finally:
+        loop.set_task_factory(previous_factory)
+
+    gc.collect()
+    if ping_task_ref is not None:
+        assert ping_task_ref() is not None
+
+    await resp.close()
+
+
+async def test_server_websocket_ping_task_not_gc(
+    aiohttp_client: AiohttpClient,
+) -> None:
+    """Server WebSocket ping tasks must not be garbage collected."""
+    ping_task_alive = False
+    ping_checked = asyncio.Event()
+
+    async def handler(request: web.Request) -> web.WebSocketResponse:
+        nonlocal ping_task_alive
+        ws = web.WebSocketResponse(heartbeat=0.1, autoping=False)
+        await ws.prepare(request)
+        loop = asyncio.get_running_loop()
+        previous_factory = loop.get_task_factory()
+        ping_task_ref: Optional["weakref.ReferenceType[asyncio.Task[None]]"] = None
+        ping_started = asyncio.Event()
+
+        async def hold_task() -> None:
+            nonlocal ping_task_ref
+            ping_task_ref = weakref.ref(asyncio.current_task())
+            ping_started.set()
+            # Keep the task pending on a future with no reference outside itself.
+            await loop.create_future()
+
+        def task_factory(
+            loop: asyncio.AbstractEventLoop,
+            coro: object,
+            context: Optional[object] = None,
+        ) -> "asyncio.Task[None]":
+            coro.close()  # type: ignore[attr-defined]
+            kwargs = {} if context is None else {"context": context}
+            return asyncio.Task(hold_task(), loop=loop, **kwargs)
+
+        loop.set_task_factory(task_factory)
+        try:
+            # A ping may finish eagerly on some event loops; otherwise the task
+            # factory exposes the in-flight scheduled task without depending on
+            # the route used to send its frame.
+            deadline = loop.time() + 0.5
+            while not ping_started.is_set() and loop.time() < deadline:
+                await asyncio.sleep(0.01)
+        finally:
+            loop.set_task_factory(previous_factory)
+
+        gc.collect()
+        ping_task_alive = ping_task_ref is None or ping_task_ref() is not None
+        ping_checked.set()
+        await ws.close()
+        return ws
+
+    app = web.Application()
+    app.router.add_route("GET", "/", handler)
+    client = await aiohttp_client(app)
+    resp = await client.ws_connect("/")
+    await ping_checked.wait()
+    await resp.close()
+    assert ping_task_alive is True
+
+
