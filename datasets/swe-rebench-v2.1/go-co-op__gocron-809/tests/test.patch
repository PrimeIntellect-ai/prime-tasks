+
+func TestAtTimesRepeatedCallsReturnConfiguredValuesInOrder(t *testing.T) {
+	at := NewAtTimes(
+		NewAtTime(9, 30, 0),
+		NewAtTime(9, 59, 0),
+	)
+
+	timesAsStrings := func() []string {
+		var times []string
+		for _, atTime := range at() {
+			times = append(times, TimeFromAtTime(atTime, time.UTC).Format("3:04"))
+		}
+		return times
+	}
+
+	expected := []string{"9:30", "9:59"}
+	assert.Equal(t, expected, timesAsStrings())
+	assert.Equal(t, expected, timesAsStrings())
+}
