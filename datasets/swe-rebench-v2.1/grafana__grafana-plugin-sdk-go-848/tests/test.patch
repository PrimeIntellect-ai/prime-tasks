diff --git a/backend/httpclient/custom_headers_middleware_test.go b/backend/httpclient/custom_headers_middleware_test.go
index 7b129d3..e314c07 100644
--- a/backend/httpclient/custom_headers_middleware_test.go
+++ b/backend/httpclient/custom_headers_middleware_test.go
@@ -59,4 +59,39 @@ func TestCustomHeadersMiddleware(t *testing.T) {
 		require.Equal(t, "ValueTwo", req.Header.Get("X-HeaderTwo"))
 		require.Equal(t, "ValueThree", req.Header.Get("X-HeaderThree"))
 	})
+
+	t.Run("With custom Host header set should apply Host to the request", func(t *testing.T) {
+		ctx := &testContext{}
+		var forwardedReq *http.Request
+		finalRoundTripper := RoundTripperFunc(func(req *http.Request) (*http.Response, error) {
+			ctx.callChain = append(ctx.callChain, "final")
+			forwardedReq = req
+			return &http.Response{StatusCode: http.StatusOK}, nil
+		})
+		customHeaders := CustomHeadersMiddleware()
+		rt := customHeaders.CreateMiddleware(Options{Headers: map[string]string{
+			"Host": "example.com",
+		}}, finalRoundTripper)
+		require.NotNil(t, rt)
+		middlewareName, ok := customHeaders.(MiddlewareName)
+		require.True(t, ok)
+		require.Equal(t, CustomHeadersMiddlewareName, middlewareName.MiddlewareName())
+
+		req, err := http.NewRequest(http.MethodGet, "http://", nil)
+		require.NoError(t, err)
+		res, err := rt.RoundTrip(req)
+		require.NoError(t, err)
+		require.NotNil(t, res)
+		if res.Body != nil {
+			require.NoError(t, res.Body.Close())
+		}
+		require.Len(t, ctx.callChain, 1)
+		require.ElementsMatch(t, []string{"final"}, ctx.callChain)
+
+		// The custom Host must be honored on the request that is actually sent
+		// downstream, regardless of whether the middleware mutates the original
+		// request or forwards a modified clone.
+		require.NotNil(t, forwardedReq)
+		require.Equal(t, "example.com", forwardedReq.Host)
+	})
 }
