+    def test_solve_remove_independent_variables_from_rhs(self):
+        model = pybamm.lithium_ion.SPM()
+        sim = pybamm.Simulation(
+            model,
+            discretisation_kwargs={"remove_independent_variables_from_rhs": True},
+        )
+        sol = sim.solve([0, 600])
+        reference = pybamm.Simulation(model).solve([0, 600])
+        np.testing.assert_allclose(
+            sol["Discharge capacity [A.h]"].data,
+            reference["Discharge capacity [A.h]"].data,
+            rtol=1e-5,
+            atol=1e-7,
+        )
+
+    def test_later_solution_cycle_throughput_matches_first_step(self):
+        model = pybamm.lithium_ion.SPM()
+        experiment = pybamm.Experiment(
+            [("Discharge at 1C until 3.5 V", "Charge at 1C until 4.1 V")]
+        )
+        previous = pybamm.Simulation(
+            model, experiment=experiment, solver=pybamm.CasadiSolver()
+        ).solve(calc_esoh=False)
+        initialized_model = model.set_initial_conditions_from(previous, inplace=False)
+        later = pybamm.Simulation(
+            initialized_model, experiment=experiment, solver=pybamm.CasadiSolver()
+        ).solve(calc_esoh=False)
+
+        cycle = later.cycles[0]
+        first_step = cycle.steps[0]
+        variable = "Throughput capacity [A.h]"
+        np.testing.assert_allclose(
+            cycle[variable](first_step.t), first_step[variable](first_step.t)
+        )
+
+    def test_build_for_experiment_discretisation_kwargs(self):
+        # discretisation_kwargs are forwarded to the Discretisation used when
+        # building models for an experiment
+        model = pybamm.lithium_ion.SPM()
+        # Make the model fail model checks so that check_model=False is observable
+        model.variables["Discharge capacity [A.h]"] = pybamm.Vector([1, 2, 3])
+        experiment = pybamm.Experiment(["Discharge at 1C until 2.5 V"])
+        sim = pybamm.Simulation(
+            model,
+            experiment=experiment,
+            discretisation_kwargs={"check_model": False},
+        )
+        sim.build_for_experiment()
+
+    def test_retired_check_model_argument(self):
+        # The check_model argument has been removed from build, solve and
+        # build_for_experiment
+        for method in (
+            pybamm.Simulation.build,
+            pybamm.Simulation.build_for_experiment,
+            pybamm.Simulation.solve,
+        ):
+            self.assertNotIn("check_model", inspect.signature(method).parameters)
+        sim = pybamm.Simulation(pybamm.lithium_ion.SPM())
+        with self.assertRaises(TypeError):
+            sim.build(check_model=False)
+        experiment = pybamm.Experiment(["Discharge at 1C until 2.5 V"])
+        sim_exp = pybamm.Simulation(pybamm.lithium_ion.SPM(), experiment=experiment)
+        with self.assertRaises(TypeError):
+            sim_exp.build_for_experiment(check_model=False)
+
