 const rule = require("../../../lib/rules/prefer-object-spread");
 
 const RuleTester = require("../../../lib/testers/rule-tester");
+const assert = require("chai").assert;
+const vm = require("vm");
 
 const parserOptions = {
     ecmaVersion: 2018,
@@ -811,3 +813,42 @@ ruleTester.run("prefer-object-spread", rule, {
         }
     ]
 });
+
+describe("prefer-object-spread with an empty Object.assign call", () => {
+    const Linter = require("../../../lib/linter");
+    const linter = new Linter();
+
+    linter.defineRule("prefer-object-spread", rule);
+
+    [
+        "Object.assign({ });",
+        "Object.assign({\n});"
+    ].forEach(code => {
+        it(`should report ${JSON.stringify(code)} without crashing and provide an autofix`, () => {
+            const config = {
+                rules: { "prefer-object-spread": 1 },
+                parserOptions
+            };
+            const messages = linter.verify(code, config);
+
+            assert.strictEqual(messages.length, 1);
+            assert.strictEqual(messages[0].ruleId, "prefer-object-spread");
+            assert.strictEqual(messages[0].messageId, "useLiteralMessage");
+            assert.strictEqual(messages[0].line, 1);
+            assert.strictEqual(messages[0].column, 1);
+            assert.ok(messages[0].fix, "The reported warning should be autofixable.");
+
+            const result = linter.verifyAndFix(code, config);
+
+            assert.strictEqual(result.fixed, true);
+            assert.strictEqual(result.messages.length, 0);
+            assert.ok(!result.output.includes("Object.assign"));
+
+            const expression = result.output.trim().replace(/;$/u, "");
+            const value = vm.runInNewContext(`(${expression})`);
+
+            assert.strictEqual(typeof value, "object");
+            assert.deepStrictEqual(Object.keys(value), []);
+        });
+    });
+});
