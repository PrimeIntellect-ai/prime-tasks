+func TestValidateDiskWithoutImageReportsPolicyResult(t *testing.T) {
+	dir, err := ioutil.TempDir(tmpDir, "terraform-validator-image-less-")
+	require.NoError(t, err)
+	defer os.RemoveAll(dir)
+
+	const planName = "example_compute_disk_empty_image.tfplan.json"
+	generateTestFiles(t, "../testdata/templates", dir, planName)
+	planPath := filepath.Join(dir, planName)
+	cmd := exec.Command("go", "run", "..", "validate",
+		"--project", data.Provider["project"],
+		"--offline", "--ancestry", data.Ancestry,
+		"--policy-path", "../testdata/sample_policies/always_violate",
+		planPath,
+	)
+	output, err := cmd.CombinedOutput()
+	result := string(output)
+	require.True(t,
+		strings.Contains(result, "Constraint ") || strings.Contains(result, "No violations found."),
+		"policy validation did not report violations or no violations (command error: %v): %s", err, result,
+	)
+}
+
+// compareConvertOutputIgnoringEmptyImage compares converted assets while
+// treating an empty image value as equivalent to no image value.
+func compareConvertOutputIgnoringEmptyImage(t *testing.T, expected []google.Asset, actual []google.Asset, offline bool) {
+	compareUnmergedConvertOutput(t, withoutEmptyImage(expected), withoutEmptyImage(actual), offline)
+}
+
+func withoutEmptyImage(assets []google.Asset) []google.Asset {
+	ret := make([]google.Asset, len(assets))
+	for i := range assets {
+		ret[i] = assets[i]
+		if assets[i].Resource == nil {
+			continue
+		}
+		res := *assets[i].Resource
+		data := make(map[string]interface{}, len(res.Data))
+		for k, v := range res.Data {
+			if k == "image" && v == "" {
+				continue
+			}
+			data[k] = v
+		}
+		res.Data = data
+		ret[i].Resource = &res
+	}
+	return ret
+}
