+// A disk without an image must convert successfully. The image field may be
+// omitted or be empty, but must not be resolved to an image.
+func TestReadPlannedAssetsDiskWithoutImage(t *testing.T) {
+	dir, err := ioutil.TempDir(tmpDir, "terraform")
+	if err != nil {
+		log.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+
+	const name = "example_compute_disk_empty_image"
+	generateTestFiles(t, "../testdata/templates", dir, name+".tfplan.json")
+	planfile := filepath.Join(dir, name+".tfplan.json")
+
+	got, err := tfgcv.ReadPlannedAssets(context.Background(), planfile, data.Provider["project"], data.Ancestry, true, false, zap.NewExample())
+	require.NoError(t, err)
+
+	var disk *google.Asset
+	for i := range got {
+		if got[i].Type == "compute.googleapis.com/Disk" {
+			disk = &got[i]
+		}
+	}
+	require.NotNil(t, disk, "expected a compute disk asset in the output")
+	require.NotNil(t, disk.Resource)
+
+	raw, err := json.Marshal(disk.Resource.Data)
+	require.NoError(t, err)
+	var d map[string]interface{}
+	require.NoError(t, json.Unmarshal(raw, &d))
+	require.Equal(t, "test-disk", d["name"])
+	diskType, _ := d["type"].(string)
+	require.True(t, strings.HasSuffix(diskType, "/diskTypes/pd-ssd"), "unexpected disk type: %v", d["type"])
+	require.EqualValues(t, 4096, d["physicalBlockSizeBytes"])
+	labels, ok := d["labels"].(map[string]interface{})
+	require.True(t, ok, "labels should be a map, got %T", d["labels"])
+	require.Equal(t, "dev", labels["environment"])
+	if img, present := d["image"]; present {
+		require.Empty(t, img, "no image was configured, so none may be resolved")
+	}
+}
