+def test_load_signed_integer(tmp_path, monkeypatch):
+    settings_file = tmp_path / "settings.toml"
+    settings_file.write_text("num = 1\n")
+    monkeypatch.setenv("DYNACONF_NUM", "-1")
+
+    loaded_settings = Dynaconf(settings_file=str(settings_file))
