+    def test_nonfinite_pprint(self):
+        m = ConcreteModel()
+
+        # Accessing a missing key returns the default; pprint must still work.
+        m.p = Param(Any, default=1)
+        self.assertEqual(m.p['foo'], 1)
+        m.p.pprint(StringIO())
+
+        # Explicitly initialized entries remain visible in pprint output.
+        entries = {1: 2, 'a': 3, 'bb': 4}
+        for mutable in (False, True):
+            m.p = Param(Any, default=1, mutable=mutable, initialize=entries)
+            OUT = StringIO()
+            m.p.pprint(OUT)
+            rendered = OUT.getvalue()
+            for key, val in entries.items():
+                self.assertIn(str(key), rendered)
+                self.assertIn(str(val), rendered)
+
 
