+
+async def test_filter_cookies_does_not_leak_memory() -> None:
+    """filter_cookies must not retain unbounded state for unmatched paths.
+
+    Regression test for https://github.com/aio-libs/aiohttp/issues/11052
+    """
+    jar = CookieJar()
+
+    # A cookie that is valid for every path on the host.
+    jar.update_cookies({"test_cookie": "value; Path=/"}, URL("http://example.com/"))
+    assert len(jar) == 1
+
+    def make_requests(start: int, count: int) -> None:
+        for i in range(start, start + count):
+            url = URL(f"http://example.com/api/v1/users/{i}/profile")
+            filtered = jar.filter_cookies(url)
+            # The cookie must still be returned for every request.
+            assert len(filtered) == 1
+            assert "test_cookie" in filtered
+
+    # Request a large number of distinct paths.  A correct implementation
+    # must not accumulate state for paths that have no cookies.
+    make_requests(0, 1000)
+    size_after_first_batch = len(jar._cookies)
+
+    make_requests(1000, 1000)
+    size_after_second_batch = len(jar._cookies)
+
+    # The number of stored cookies must not change.
+    assert len(jar) == 1
+
+    # Internal lookup state may be cached, but it must not keep growing with
+    # the number of distinct paths requested.  A correct implementation
+    # either never stores unmatched paths or prunes them, so the second batch
+    # of requests must not add a significant amount of new state.
+    assert size_after_second_batch - size_after_first_batch < 500
+
+
+async def test_filter_cookies_does_not_store_unmatched_paths() -> None:
+    jar = CookieJar()
+    jar.update_cookies({"irrelevant": "cookie; Path=/"}, URL("http://other.example/"))
+    jar.filter_cookies(URL("http://example.com/prime"))
+    initial_keys = set(jar._cookies)
+
+    for i in range(1000):
+        filtered = jar.filter_cookies(URL(f"http://example.com/unmatched/{i}"))
+        assert not filtered
+
+    assert set(jar._cookies) <= initial_keys
