+    def test_remove_prefix_configuration(self):
+        source = {"conform": {
+            "street": {"function": "remove_prefix", "field": "address",
+                       "field_to_remove": "prefix"},
+            "number": "number", "lon": "x", "lat": "y"
+        }, "fingerprint": "test"}
+        matching = row_transform_and_convert(
+            source, {"address": "123 MAPLE ST", "prefix": "123", "number": "123",
