+
+def test_bytecode_ends_with_cbor_length(tmp_path):
+    code = """
+@external
+def foo() -> uint256:
+    return 1
+"""
+    bar_path = tmp_path.joinpath("bar.vy")
+    with bar_path.open("w") as fp:
+        fp.write(code)
+
+    compiled = compile_files(
+        [bar_path], output_formats=["bytecode", "bytecode_runtime"], root_folder=tmp_path
+    )["bar.vy"]
+
+    for key in ("bytecode", "bytecode_runtime"):
+        bytecode = bytes.fromhex(compiled[key][2:])
+
+        # the last two bytes hold the big-endian length of the CBOR section,
+        # not counting the two length bytes themselves
+        cbor_len = int.from_bytes(bytecode[-2:], "big")
+        cbor = bytecode[-2 - cbor_len : -2]
+
+        assert cbor_len > 0
+        assert len(cbor) == cbor_len
+        assert cbor.startswith(b"\xa1\x65vyper")
 
 
