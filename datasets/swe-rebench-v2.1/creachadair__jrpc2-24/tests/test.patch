+// Verify that notifications for an order-sensitive method are processed in the
+// order they are received. The contract requires this for methods such as
+// textDocument/didChange, whose effects must be applied in arrival order.
+func TestDidChangeNotificationsRunInReceiptOrder(t *testing.T) {
+	const method = "textDocument/didChange"
+
+	var mu sync.Mutex
+	var completed []int
+	// Document versions increase, but need not be consecutive. Processing
+	// must still follow receipt order rather than waiting for missing versions.
+	versions := []int{1, 3, 7, 8, 12, 20, 21, 40, 100}
+
+	loc := server.NewLocal(handler.Map{
+		method: handler.New(func(_ context.Context, req *jrpc2.Request) error {
+			var seq int
+			if err := req.UnmarshalParams(&handler.Args{&seq}); err != nil {
+				t.Errorf("Invalid test parameters: %v", err)
+				return err
+			}
+			// Sleep in reverse order of arrival, so that if handlers are
+			// allowed to overlap they will finish out of order. A server that
+			// processes these notifications in arrival order will not start a
+			// later notification until the earlier one has completed.
+			for i, version := range versions {
+				if seq == version {
+					time.Sleep(time.Duration(len(versions)-i) * 10 * time.Millisecond)
+					break
+				}
+			}
+			mu.Lock()
+			completed = append(completed, seq)
+			mu.Unlock()
+			return nil
+		}),
+	}, &server.LocalOptions{
+		Server: &jrpc2.ServerOptions{Concurrency: 16},
+	})
+
+	for _, version := range versions {
+		if err := loc.Client.Notify(context.Background(), method, []int{version}); err != nil {
+			t.Errorf("Test notification failed: %v", err)
+		}
+	}
+	if err := loc.Close(); err != nil {
+		t.Logf("Warning: error at server exit: %v", err)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if len(completed) != len(versions) {
+		t.Errorf("Got %d completed notifications, want %d", len(completed), len(versions))
+	}
+	for i, version := range completed {
+		if i >= len(versions) {
+			break
+		}
+		if version != versions[i] {
+			t.Errorf("Notification completed out of order at position %d: got version %d, want %d", i, version, versions[i])
+		}
+	}
+}
