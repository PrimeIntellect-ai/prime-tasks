+func TestGetAccountByID__InstitutionDetails(t *testing.T) {
+	accountID := base.ID()
+	repo := &mockRepository{
+		Accounts: []*client.Account{
+			{
+				AccountID:     accountID,
+				RoutingNumber: "987654320",
+			},
+		},
+	}
+	testFedClient := &fed.MockClient{
+		Details: &client.InstitutionDetails{
+			Name:          "Test Bank",
+			RoutingNumber: "987654320",
+		},
+	}
+	handler := setupRouterWithFedClient(t, repo, testFedClient)
+
+	w := httptest.NewRecorder()
+	req := httptest.NewRequest("GET", fmt.Sprintf("/customers/%s/accounts/%s", base.ID(), accountID), nil)
+	handler.ServeHTTP(w, req)
+	w.Flush()
+
+	require.Equal(t, http.StatusOK, w.Code, w.Body.String())
+
+	var got client.Account
+	require.NoError(t, json.NewDecoder(w.Body).Decode(&got))
+	require.Equal(t, accountID, got.AccountID)
+	require.Equal(t, "Test Bank", got.Institution.Name)
+	require.Equal(t, "987654320", got.Institution.RoutingNumber)
+}
