+def test_reinstall_mod_after_manual_delete(mod: Mod, sqlite: Sqlite):
+    # An empty mods folder leaves the database row inactive after manual deletion.
+    sqlite.insert_mod(mod)
+    repo = RepoImpl(SimpleNamespace(mods=[]), sqlite, Downloader())
+
+    assert not repo.is_installed(mod.id)
+
+    # Reinstalling must not fail on the leftover inactive row.
+    repo.update_mod(mod)
+
+    # After reinstalling, the mod is present in the mods folder and the manager treats it as installed.
+    repo = RepoImpl(SimpleNamespace(mods=[mod]), sqlite, Downloader())
+
+    assert repo.is_installed(mod.id)
+
