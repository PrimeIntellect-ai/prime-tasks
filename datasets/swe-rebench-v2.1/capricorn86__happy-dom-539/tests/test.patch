index d31a756..2c2355b 100644
--- a/packages/happy-dom/test/nodes/node/Node.test.ts
+++ b/packages/happy-dom/test/nodes/node/Node.test.ts
@@ -624,4 +624,64 @@ describe('Node', () => {
 			expect(parentEvent).toBe(event);
 		});
 	});
+
+	describe('compareDocumentPosition()', () => {
+		const compare = (node: any, otherNode: any): number => node['compareDocumentPosition'](otherNode);
+
+		it('Returns zero when comparing a node with itself', () => {
+			const node = document.createElement('div');
+			expect(compare(node, node)).toBe(0);
+		});
+
+		it('Reports following and preceding order for sibling nodes', () => {
+			const parent = document.createElement('div');
+			const first = document.createElement('span');
+			const second = document.createElement('span');
+			parent.appendChild(first);
+			parent.appendChild(second);
+
+			expect(compare(first, second)).toBe(4);
+			expect(compare(second, first)).toBe(2);
+		});
+
+		it('Reports containment in both directions', () => {
+			const parent = document.createElement('div');
+			const child = document.createElement('span');
+			parent.appendChild(child);
+
+			expect(compare(parent, child)).toBe(20);
+			expect(compare(child, parent)).toBe(10);
+		});
+
+		it('Compares text nodes in tree order', () => {
+			const parent = document.createElement('div');
+			const first = document.createTextNode('first');
+			const second = document.createTextNode('second');
+			parent.appendChild(first);
+			parent.appendChild(second);
+
+			expect(compare(first, second)).toBe(4);
+			expect(compare(second, first)).toBe(2);
+		});
+
+		it('Reports disconnected nodes using disconnected and implementation-specific position bits', () => {
+			const first = document.createElement('div');
+			const second = document.createElement('div');
+			const position = compare(first, second);
+
+			expect(position & 1).toBe(1);
+			expect(position & 32).toBe(32);
+			expect(position & (2 | 4)).not.toBe(0);
+		});
+
+		it('Reports an implementation-specific relative position for attribute nodes', () => {
+			const element = document.createElement('div');
+			element.setAttribute('first', '1');
+			element.setAttribute('second', '2');
+			const position = compare(element.getAttributeNode('first'), element.getAttributeNode('second'));
+
+			expect(position & 32).toBe(32);
+			expect(position & (2 | 4)).not.toBe(0);
+		});
+	});
 });
