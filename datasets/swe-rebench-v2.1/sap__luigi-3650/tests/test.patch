+const rollup = require('rollup/dist/rollup.js');
+const svelte = require('rollup-plugin-svelte');
+const resolve = require('@rollup/plugin-node-resolve');
+const commonjs = require('@rollup/plugin-commonjs');
+const autoPreprocess = require('svelte-preprocess');
+const babel = require('@babel/core');
+
+function typescriptPlugin() {
+    return {
+        name: 'typescript-babel',
+        transform(code: string, id: string) {
+            if (!id.endsWith('.ts')) {
+                return null;
+            }
+            const result = babel.transformSync(code, {
+                filename: id,
+                presets: [
+                    [
+                        require.resolve('@babel/preset-env'),
+                        { targets: { node: 'current' }, loose: true, modules: false },
+                    ],
+                    require.resolve('@babel/preset-typescript'),
+                ],
+                babelrc: false,
+                configFile: false,
+            });
+            return { code: result!.code, map: null };
+        },
+    };
+}
+
+async function loadContainerEntry() {
+    const bundle = await rollup.rollup({
+        input: 'src/main.js',
+        plugins: [
+            svelte({
+                compilerOptions: { customElement: true, dev: true },
+                preprocess: autoPreprocess({ sourceMap: true }),
+            }),
+            typescriptPlugin(),
+            resolve({ browser: true, extensions: ['.ts', '.js', '.svelte', '.mjs'] }),
+            commonjs(),
+        ],
+        onwarn: () => {},
+    });
+    const { output } = await bundle.generate({ format: 'cjs', inlineDynamicImports: true });
+    const module = { exports: {} as any };
+    const evaluate = new Function('module', 'exports', 'require', output[0].code);
+    evaluate(module, module.exports, require);
+    return module.exports;
+}
+
+async function waitForIframe(element: any, timeout = 2000) {
+    const start = Date.now();
+    while (Date.now() - start < timeout) {
+        const iframe = element.shadowRoot && element.shadowRoot.querySelector('iframe');
+        if (iframe) {
+            return iframe;
+        }
+        await new Promise((resolve) => setTimeout(resolve, 10));
+    }
+    return null;
+}
+
+describe('luigi-container iframe configuration', () => {
+    beforeAll(async () => {
+        await loadContainerEntry();
+    });
+
+    it('applies allow-rules and sandbox-rules to the rendered iframe', async () => {
+        const allowRules = [
+            'geolocation https://maps.example.test',
+            'camera https://camera.example.test',
+        ];
+        const sandboxRules = ['allow-scripts', 'allow-forms'];
+
+        const element: any = document.createElement('luigi-container');
+        element.setAttribute('viewurl', 'https://example.com/microfrontend.html');
+        element.setAttribute('allow-rules', JSON.stringify(allowRules));
+        element.setAttribute('sandbox-rules', JSON.stringify(sandboxRules));
+        document.body.appendChild(element);
+
+        try {
+            const iframe = await waitForIframe(element);
+            expect(iframe).not.toBeNull();
+            const renderedAllowRules = iframe.getAttribute('allow') || '';
+            allowRules.forEach((rule) => {
+                expect(renderedAllowRules).toContain(rule);
+            });
+            const renderedSandboxRules = (iframe.getAttribute('sandbox') || '').split(/\s+/);
+            expect(renderedSandboxRules).toEqual(expect.arrayContaining(sandboxRules));
+        } finally {
+            element.remove();
+        }
+    });
+});
