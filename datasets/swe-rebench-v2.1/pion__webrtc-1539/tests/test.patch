+
+func TestWithMediaEngineUsesSharedInstance(t *testing.T) {
+	mediaEngine := &MediaEngine{}
+	api := NewAPI(WithMediaEngine(mediaEngine))
+
+	const codecName = "test-shared-codec"
+	assert.NoError(t, mediaEngine.RegisterCodec(RTPCodecParameters{
+		RTPCodecCapability: RTPCodecCapability{
+			MimeType:  "audio/" + codecName,
+			ClockRate: 48000,
+			Channels:  2,
+		},
+		PayloadType: 111,
+	}, RTPCodecTypeAudio))
+
+	pc, err := api.NewPeerConnection(Configuration{})
+	assert.NoError(t, err)
+	defer pc.Close()
+
+	_, err = pc.AddTransceiverFromKind(RTPCodecTypeAudio)
+	assert.NoError(t, err)
+
+	offer, err := pc.CreateOffer(nil)
+	assert.NoError(t, err)
+	assert.Contains(t, strings.ToLower(offer.SDP), strings.ToLower(codecName)+"/48000/2")
+}
