@@ -1,3 +1,5 @@
+import sys
+import tempfile
 from unittest.mock import patch
 
 from keras.src.testing import test_case
@@ -55,3 +57,20 @@ class TestIoUtils(test_case.TestCase):
     @patch("builtins.input", side_effect=["invalid", "n"])
     def test_ask_to_proceed_with_overwrite_invalid_then_no(self, _):
         self.assertFalse(io_utils.ask_to_proceed_with_overwrite("test_path"))
+
+    def test_predict_with_different_encoding(self):
+        # https://github.com/keras-team/keras/issues/19386
+        import numpy as np
+
+        import keras
+
+        io_utils.enable_interactive_logging()
+        model = keras.Sequential([keras.layers.Dense(1, input_shape=(2,))])
+        inputs = np.zeros((4, 2), dtype="float32")
+        ori_stdout = sys.stdout
+        try:
+            with tempfile.TemporaryFile(mode="w", encoding="cp1252") as tmp:
+                sys.stdout = tmp
+                model.predict(inputs, verbose=1)
+        finally:
+            sys.stdout = ori_stdout
