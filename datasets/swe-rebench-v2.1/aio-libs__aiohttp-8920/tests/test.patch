@@ -1450,3 +1451,30 @@ def test_basicauth_from_empty_netrc(
     """Test that no Authorization header is sent when netrc is empty"""
     req = make_request("get", "http://example.com", trust_env=True)
     assert hdrs.AUTHORIZATION not in req.headers
+
+
+async def test_keep_alive_through_proxy_reuses_connection(aiohttp_server: Any) -> None:
+    """An explicit keep-alive request through a proxy reuses the connection."""
+    peers = []
+
+    async def handler(request: aiohttp.web.Request) -> aiohttp.web.Response:
+        peers.append(request.transport.get_extra_info("peername"))
+        return aiohttp.web.Response(text="ok")
+
+    app = aiohttp.web.Application()
+    app.router.add_route("*", "/{tail:.*}", handler)
+    proxy = await aiohttp_server(app)
+    proxy_url = URL(f"http://127.0.0.1:{proxy.port}")
+
+    async with aiohttp.ClientSession() as session:
+        for _ in range(2):
+            async with session.get(
+                "http://target.example/path",
+                proxy=proxy_url,
+                headers={"Connection": "keep-alive"},
+            ) as resp:
+                assert resp.status == 200
+                assert await resp.text() == "ok"
+
+    assert len(peers) == 2
+    assert peers[0] == peers[1]
