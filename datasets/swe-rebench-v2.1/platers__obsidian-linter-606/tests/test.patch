+// https://github.com/platers/obsidian-linter/issues/588
+// The reported bug: the custom regex replacement that converts HTML anchors to
+// markdown links produced malformed output because the No Bare URLs rule wrapped
+// the URL inside the anchor in angle brackets before the custom regex ran.
+describe('No Bare URLs with a custom regex replacement', () => {
+  it('The supplied custom regex converts the example anchor tag into a markdown link', () => {
+    const before = dedent`
+      Wycinek utworzono z: <a href="https://www.tygodnikpowszechny.pl/zycie-pod-mikroskopem-151274" class="tc-tiddlylink-external" rel="noopener noreferrer" target="_blank">https://www.tygodnikpowszechny.pl/zycie-pod-mikroskopem-151274</a>
+    `;
+    const afterNoBareUrls = NoBareUrls.getRule().apply(before, undefined);
+    const rulesRunner = new RulesRunner();
+    const result = rulesRunner.runCustomRegexReplacement([{
+      find: `<a.*?href=["']([^"']*)["'][^>]*>([^<]*)<\/a>`,
+      replace: '[$2]($1)',
+      flags: 'igm',
+    }], afterNoBareUrls);
+
+    expect(result).toBe(dedent`
+      Wycinek utworzono z: [https://www.tygodnikpowszechny.pl/zycie-pod-mikroskopem-151274](https://www.tygodnikpowszechny.pl/zycie-pod-mikroskopem-151274)
+    `);
+  });
+});
