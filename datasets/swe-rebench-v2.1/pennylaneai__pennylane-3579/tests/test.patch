+def test_metric_tensor_matches_equivalent_adjoint_and_inverse_angle():
+    """An adjointed rotation and its equivalent negated angle have the same metric."""
+    dev = qml.device("default.qubit", wires=3)
+
+    def make_circuit(use_adjoint):
+        @qml.qnode(dev)
+        def circuit(x):
+            qml.RX(x[0], wires=0)
+            qml.CNOT(wires=[0, 1])
+            qml.RZ(0.4, wires=1)
+            qml.CNOT(wires=[0, 1])
+            qml.RX(x[0], wires=0)
+            if use_adjoint:
+                qml.adjoint(qml.RZ)(x[1], wires=0)
+            else:
+                qml.RZ(-x[1], wires=0)
+            return qml.expval(qml.PauliZ(0))
+
+        return circuit
+
+    x = np.array([0.543, 0.352], requires_grad=True)
+    inverse_metric = qml.metric_tensor(make_circuit(False))(x)
+    adjoint_metric = qml.metric_tensor(make_circuit(True))(x)
+
+    assert qml.math.allclose(adjoint_metric, inverse_metric, atol=1e-7, rtol=1e-7)
+
