+from pathlib import Path
+
+import cdsapi
+
+from earthkit.data import from_source
+from earthkit.data.sources.empty import EmptySource
+
+
+def test_cds_zipped_vector_is_not_empty(monkeypatch, tmp_path):
+    class Result:
+        location = "https://example.test/rgi6_vector.zip"
+
+        def download(self, target):
+            fixture = Path(__file__).parents[1] / "data" / "NUTS_RG_20M_2021_3035.shp.zip"
+            Path(target).write_bytes(fixture.read_bytes())
+
+    class Client:
+        def retrieve(self, dataset, request):
+            return Result()
+
+    monkeypatch.setenv("HOME", str(tmp_path))
+    (tmp_path / ".cdsapirc").write_text("url: https://example.test\nkey: test\n")
+    monkeypatch.setattr(cdsapi, "Client", lambda **kwargs: Client())
+
+    collection_id = "insitu-glaciers-extent"
+    request = {
+        "variable": "glacier_area",
+        "format": "zip",
+        "version": "6_0",
+        "product_type": "vector",
+    }
+    ds = from_source("cds", collection_id, request)
+
+    assert not isinstance(ds, EmptySource)
+
+
+if __name__ == "__main__":
+    from earthkit.data.testing import main
+
+    main(__file__)
