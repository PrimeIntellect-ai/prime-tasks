 	assert.Equal(t, expectedTable, rendered)
 }
+
+func minimumHeightCountLinesWithoutText(rendered string) int {
+	count := 0
+	for _, line := range strings.Split(rendered, "\n") {
+		hasText := false
+		for _, character := range line {
+			if unicode.IsLetter(character) || unicode.IsNumber(character) {
+				hasText = true
+				break
+			}
+		}
+		if !hasText {
+			count++
+		}
+	}
+	return count
+}
+
+func TestMinimumHeightPadsShortTableAndPreservesMultilineContentAndFooter(t *testing.T) {
+	baseModel := New([]Column{
+		NewColumn("id", "ID", 12),
+	}).WithRows([]Row{
+		NewRow(RowData{"id": "body"}).WithStyle(lipgloss.NewStyle().Height(3)),
+	}).WithStaticFooter("Footer")
+
+	withoutMinimum := baseModel.View()
+	rendered := baseModel.WithMinimumHeight(12).View()
+
+	assert.GreaterOrEqual(t, lipgloss.Height(rendered), 12)
+	assert.Greater(t, lipgloss.Height(rendered), lipgloss.Height(withoutMinimum))
+	assert.Greater(t, minimumHeightCountLinesWithoutText(rendered), minimumHeightCountLinesWithoutText(withoutMinimum))
+	assert.Contains(t, rendered, "ID")
+	assert.Contains(t, rendered, "body")
+	assert.Contains(t, rendered, "Footer")
+}
+
+func TestMinimumHeightDoesNotTruncateContent(t *testing.T) {
+	model := New([]Column{
+		NewColumn("id", "ID", 8),
+	}).WithRows([]Row{
+		NewRow(RowData{"id": "first"}),
+		NewRow(RowData{"id": "second"}),
+		NewRow(RowData{"id": "third"}),
+	}).WithStaticFooter("Footer")
+
+	withoutMinimum := model.View()
+	rendered := model.WithMinimumHeight(3).View()
+
+	assert.GreaterOrEqual(t, lipgloss.Height(rendered), lipgloss.Height(withoutMinimum))
+	assert.Contains(t, rendered, "first")
+	assert.Contains(t, rendered, "second")
+	assert.Contains(t, rendered, "third")
+	assert.Contains(t, rendered, "Footer")
+}
+
+func TestMinimumHeightExpandsEmptyTableWithoutHeader(t *testing.T) {
+	model := New([]Column{
+		NewColumn("id", "ID", 8),
+	}).WithHeaderVisibility(false).WithMinimumHeight(6)
+
+	rendered := model.View()
+
+	assert.GreaterOrEqual(t, lipgloss.Height(rendered), 6)
+}
