+func TestValidateServiceClusterIPRangeConsistency(t *testing.T) {
+	providers := []struct {
+		name     string
+		provider kops.CloudProviderSpec
+	}{
+		{name: "AWS", provider: kops.CloudProviderSpec{AWS: &kops.AWSSpec{}}},
+		{name: "Azure", provider: kops.CloudProviderSpec{Azure: &kops.AzureSpec{}}},
+		{name: "DigitalOcean", provider: kops.CloudProviderSpec{DO: &kops.DOSpec{}}},
+		{name: "GCE", provider: kops.CloudProviderSpec{GCE: &kops.GCESpec{}}},
+		{name: "Hetzner", provider: kops.CloudProviderSpec{Hetzner: &kops.HetznerSpec{}}},
+		{name: "Openstack", provider: kops.CloudProviderSpec{Openstack: &kops.OpenstackSpec{}}},
+		{name: "Scaleway", provider: kops.CloudProviderSpec{Scaleway: &kops.ScalewaySpec{}}},
+	}
+
+	outsideNonMasqueradeError := make(map[string]bool, len(providers))
+	for _, provider := range providers {
+		cluster := &kops.Cluster{Spec: kops.ClusterSpec{
+			KubernetesVersion: "1.20.0",
+			CloudProvider:     provider.provider,
+			Networking: kops.NetworkingSpec{
+				NetworkCIDR:           "10.0.0.0/8",
+				NonMasqueradeCIDR:     "100.64.0.0/10",
+				PodCIDR:               "100.96.0.0/11",
+				ServiceClusterIPRange: "192.168.0.0/16",
+			},
+		}}
+
+		serviceRangeHasError := false
+		for _, err := range ValidateCluster(cluster, false) {
+			if err.Field == "spec.networking.serviceClusterIPRange" {
+				serviceRangeHasError = true
+			}
+		}
+		outsideNonMasqueradeError[provider.name] = serviceRangeHasError
+	}
+
+	for provider, hasError := range outsideNonMasqueradeError {
+		if hasError != outsideNonMasqueradeError["GCE"] {
+			t.Errorf("serviceClusterIPRange outside NonMasqueradeCIDR is treated differently by %s and GCE: %s error=%t, GCE error=%t", provider, provider, hasError, outsideNonMasqueradeError["GCE"])
+		}
+	}
+}
