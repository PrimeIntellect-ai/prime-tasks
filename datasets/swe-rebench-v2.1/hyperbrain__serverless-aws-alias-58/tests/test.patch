diff --git a/test/removeAlias.test.js b/test/removeAlias.test.js
new file mode 100644
index 0000000..fb794d7
--- /dev/null
+++ b/test/removeAlias.test.js
@@ -0,0 +1,153 @@
+'use strict';
+/**
+ * Unit tests for createAliasStack..
+ */
+
+const getInstalledPath = require('get-installed-path');
+const BbPromise = require('bluebird');
+const chai = require('chai');
+const sinon = require('sinon');
+const _ = require('lodash');
+const AWSAlias = require('../index');
+
+const serverlessPath = getInstalledPath.sync('serverless', { local: true });
+const AwsProvider = require(`${serverlessPath}/lib/plugins/aws/provider/awsProvider`);
+const Serverless = require(`${serverlessPath}/lib/Serverless`);
+const AwsRemove = require(`${serverlessPath}/lib/plugins/aws/remove`);
+const Remove = require(`${serverlessPath}/lib/plugins/remove/remove`);
+
+chai.use(require('chai-as-promised'));
+chai.use(require('sinon-chai'));
+chai.use(require('chai-subset'));
+const expect = chai.expect;
+
+describe('removeAlias', () => {
+	let serverless;
+	let options;
+	let awsAlias;
+	// Sinon and stubs for SLS CF access
+	let sandbox;
+	let providerRequestStub;
+	let logStub;
+	let slsStack1;
+	let aliasStack1;
+	let aliasStack2;
+
+	before(() => {
+		sandbox = sinon.sandbox.create();
+	});
+
+	beforeEach(() => {
+		serverless = new Serverless();
+		options = {
+			alias: 'myAlias',
+			stage: 'myStage',
+			region: 'us-east-1',
+		};
+		serverless.setProvider('aws', new AwsProvider(serverless, options));
+		serverless.cli = new serverless.classes.CLI(serverless);
+		serverless.service.service = 'testService';
+		serverless.service.provider.compiledCloudFormationAliasTemplate = {};
+		awsAlias = new AWSAlias(serverless, options);
+		providerRequestStub = sandbox.stub(awsAlias._provider, 'request');
+		logStub = sandbox.stub(serverless.cli, 'log');
+
+		slsStack1 = _.cloneDeep(require('./data/sls-stack-1.json'));
+		aliasStack1 = _.cloneDeep(require('./data/alias-stack-1.json'));
+		aliasStack2 = _.cloneDeep(require('./data/alias-stack-2.json'));
+
+		logStub.returns();
+	});
+
+	afterEach(() => {
+		sandbox.restore();
+	});
+
+	describe('#removeAlias()', () => {
+		it('should do nothing with noDeploy', () => {
+			awsAlias._options = { noDeploy: true };
+
+			return expect(awsAlias.removeAlias()).to.be.fulfilled;
+		});
+
+		it('should error if an alias is deployed on stage removal', () => {
+			awsAlias._options = { alias: 'myStage' };
+			awsAlias._alias = 'myStage';
+
+			let removal;
+			try {
+				removal = awsAlias.removeAlias(slsStack1, [ aliasStack1 ], aliasStack2);
+			} catch (e) {
+				removal = BbPromise.reject(e);
+			}
+
+			return expect(removal).to.be.rejectedWith(serverless.classes.Error, /myAlias/);
+		});
+
+		it('should error if the master alias is not deployed on stage removal', () => {
+			awsAlias._options = { alias: 'myStage' };
+			awsAlias._alias = 'myStage';
+			providerRequestStub.callsFake((service, method) => {
+				if (service === 'CloudFormation' && method === 'getTemplate') {
+					return BbPromise.reject(new Error('Stack with id testService-myStage-myStage does not exist'));
+				}
+				return BbPromise.resolve({});
+			});
+
+			let removal;
+			try {
+				removal = awsAlias.removeAlias(slsStack1, [], {});
+			} catch (e) {
+				removal = BbPromise.reject(e);
+			}
+
+			return expect(removal).to.be.rejectedWith(serverless.classes.Error, /Internal error/);
+		});
+
+		it('should remove alias and service stack on stage removal', () => {
+			awsAlias._options = { alias: 'myStage' };
+			awsAlias._alias = 'myStage';
+			serverless.pluginManager.serverlessConfigFile = {};
+			serverless.config.servicePath = process.cwd();
+			serverless.service.provider.name = 'aws';
+			serverless.pluginManager.addPlugin(Remove);
+			serverless.pluginManager.addPlugin(AwsRemove);
+			providerRequestStub.callsFake((service, method, params) => {
+				if (service === 'S3' && method === 'listObjectsV2') {
+					return BbPromise.resolve({ Contents: [] });
+				}
+				if (service === 'CloudFormation' && method === 'describeStackEvents') {
+					return BbPromise.resolve({ StackEvents: [{
+						EventId: params.StackName,
+						ResourceType: 'AWS::CloudFormation::Stack',
+						ResourceStatus: 'DELETE_COMPLETE',
+						StackName: params.StackName,
+						LogicalResourceId: params.StackName,
+					}] });
+				}
+				if (service === 'CloudFormation' && method === 'getTemplate' && params.StackName === 'testService-myStage-myStage') {
+					return BbPromise.resolve({ TemplateBody: JSON.stringify(aliasStack2) });
+				}
+				return BbPromise.resolve({ StackId: params.StackName });
+			});
+			sandbox.stub(awsAlias._provider, 'getServerlessDeploymentBucketName').returns(BbPromise.resolve('deployment-bucket'));
+
+			const monitorFrequency = process.env.SLS_AWS_MONITORING_FREQUENCY;
+			process.env.SLS_AWS_MONITORING_FREQUENCY = '1';
+			return expect(awsAlias.removeAlias(slsStack1, [], aliasStack2)).to.be.fulfilled
+			.then(() => {
+				const deletedStacks = providerRequestStub.getCalls()
+					.filter(call => call.args[0] === 'CloudFormation' && call.args[1] === 'deleteStack')
+					.map(call => call.args[2].StackName);
+				expect(deletedStacks).to.have.members([ 'testService-myStage', 'testService-myStage-myStage' ]);
+			})
+			.finally(() => {
+				if (monitorFrequency === undefined) {
+					delete process.env.SLS_AWS_MONITORING_FREQUENCY;
+				} else {
+					process.env.SLS_AWS_MONITORING_FREQUENCY = monitorFrequency;
+				}
+			});
+		});
+	});
+});
