+
+// Tests for parsing a local file (Node.js readable stream) with an
+// auto-detected delimiter and a trailing empty line.
+if (typeof module !== 'undefined' && module.exports) {
+	describe('Local File Parse Tests', function() {
+		it('does not report UndetectableDelimiter for a local file with a trailing empty line when skipEmptyLines is true', function(done) {
+			var filePath = path.join(os.tmpdir(), 'papaparse-trailing-empty-line.csv');
+			fs.writeFileSync(filePath, 'a,b\n1,2\n3,4\n');
+			Papa.parse(fs.createReadStream(filePath, 'utf8'), {
+				header: true,
+				skipEmptyLines: true,
+				complete: function(results) {
+					assert.deepEqual(results.data, [{'a': '1', 'b': '2'}, {'a': '3', 'b': '4'}]);
+					assert.deepEqual(results.errors, []);
+					done();
+				},
+				error: function(err) {
+					done(err);
+				}
+			});
+		});
+	});
+}
