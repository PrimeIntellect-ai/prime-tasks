+var (
+	// Generated from "make cert".
+	caCrt  = "../cert-tmp/ca.crt"
+	svrCrt = "../cert-tmp/server.crt"
+	svrKey = "../cert-tmp/server.key"
+)
+
+// TestHTTPSServer verifies the echo/debug server serves HTTPS when both a
+// certificate and a key are provided.
+func TestHTTPSServer(t *testing.T) {
+	m, a := ServeTLS("0", "/debug", svrCrt, svrKey)
+	if m == nil || a == nil {
+		t.Fatalf("Failed to create server %v %v", m, a)
+	}
+	url := fmt.Sprintf("https://localhost:%d/debug", a.(*net.TCPAddr).Port)
+	o := HTTPOptions{URL: url, TLSOptions: TLSOptions{CACert: caCrt}, DisableFastClient: true}
+	client, _ := NewClient(&o)
+	code, data, header := client.Fetch(context.Background())
+	t.Logf("TestHTTPSServer result code %d, data len %d, headerlen %d", code, len(data), header)
+	if code != http.StatusOK {
+		t.Errorf("Got %d instead of 200", code)
+	}
+	o.URL = fmt.Sprintf("https://localhost:%d/echo", a.(*net.TCPAddr).Port)
+	echoClient, _ := NewClient(&o)
+	echoCode, _, _ := echoClient.Fetch(context.Background())
+	if echoCode != http.StatusOK {
+		t.Errorf("HTTPS /echo returned %d instead of %d", echoCode, http.StatusOK)
+	}
+}
+
+// TestHTTPSReturnedMuxUsesRunningServer verifies handlers added through the
+// returned mux are served by the listener started by ServeTLS.
+func TestHTTPSReturnedMuxUsesRunningServer(t *testing.T) {
+	mux, addr := ServeTLS("0", "/debug", svrCrt, svrKey)
+	if mux == nil || addr == nil {
+		t.Fatalf("Failed to create server %v %v", mux, addr)
+	}
+	const response = "served by the returned mux"
+	mux.HandleFunc("/mux-check", func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = w.Write([]byte(response))
+	})
+	url := fmt.Sprintf("https://localhost:%d/mux-check", addr.(*net.TCPAddr).Port)
+	o := HTTPOptions{URL: url, TLSOptions: TLSOptions{CACert: caCrt}, DisableFastClient: true}
+	client, _ := NewClient(&o)
+	_, data, _ := client.Fetch(context.Background())
+	if !bytes.Contains(data, []byte(response)) {
+		t.Errorf("Response %q does not contain the handler response %q", data, response)
+	}
+}
+
+// TestHTTPSPlainHTTPFallback verifies the echo/debug server falls back to plain
+// HTTP when either the certificate or the key is missing.
+func TestHTTPSPlainHTTPFallback(t *testing.T) {
+	cases := []struct {
+		name string
+		cert string
+		key  string
+	}{
+		{"no cert no key", "", ""},
+		{"cert only", svrCrt, ""},
+		{"key only", "", svrKey},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			m, a := ServeTLS("0", "/debug", tc.cert, tc.key)
+			if m == nil || a == nil {
+				t.Fatalf("Failed to create server %v %v", m, a)
+			}
+			url := fmt.Sprintf("http://localhost:%d/debug", a.(*net.TCPAddr).Port)
+			o := HTTPOptions{URL: url}
+			client, _ := NewClient(&o)
+			code, _, _ := client.Fetch(context.Background())
+			if code != http.StatusOK {
+				t.Errorf("Got %d instead of 200", code)
+			}
+		})
+	}
+}
+
+// TestHTTPSServerError verifies ServeTLS returns nil when it cannot listen.
+func TestHTTPSServerError(t *testing.T) {
+	_, addr := ServeTLS("0", "", svrCrt, svrKey)
+	port := fnet.GetPort(addr)
+	mux2, addr2 := ServeTLS(port, "", svrCrt, svrKey)
+	if mux2 != nil || addr2 != nil {
+		t.Errorf("2nd Serve() on same port %v should have failed: %v %v", port, mux2, addr2)
+	}
+}
+
+// TestHTTPSServerCommand verifies the user facing `fortio server -cert ... -key ...`
+// serves the echo/debug endpoint over HTTPS.
+func TestHTTPSServerCommand(t *testing.T) {
+	repoRoot, err := filepath.Abs("..")
+	if err != nil {
+		t.Fatal(err)
+	}
+	bin := filepath.Join(t.TempDir(), "fortio")
+	build := exec.Command("go", "build", "-o", bin, ".")
+	build.Dir = repoRoot
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("go build failed: %v\n%s", err, out)
+	}
+	// Pick a free port.
+	l, err := net.Listen("tcp", "localhost:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := l.Addr().(*net.TCPAddr).Port
+	l.Close()
+	certPath := filepath.Join(repoRoot, "cert-tmp", "server.crt")
+	keyPath := filepath.Join(repoRoot, "cert-tmp", "server.key")
+	caPath := filepath.Join(repoRoot, "cert-tmp", "ca.crt")
+	cmd := exec.Command(bin, "server",
+		"-http-port", fmt.Sprintf("%d", port),
+		"-cert", certPath,
+		"-key", keyPath,
+		"-grpc-port", "disabled",
+		"-tcp-port", "disabled",
+		"-udp-port", "disabled",
+		"-redirect-port", "disabled",
+		"-ui-path", "",
+		"-loglevel", "warning")
+	cmd.Dir = repoRoot
+	var outBuf bytes.Buffer
+	cmd.Stdout = &outBuf
+	cmd.Stderr = &outBuf
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("failed to start fortio server: %v", err)
+	}
+	defer func() {
+		_ = cmd.Process.Kill()
+		_ = cmd.Wait()
+	}()
+	url := fmt.Sprintf("https://localhost:%d/debug", port)
+	o := HTTPOptions{URL: url, TLSOptions: TLSOptions{CACert: caPath}, DisableFastClient: true, HTTPReqTimeOut: 500 * time.Millisecond}
+	client, _ := NewClient(&o)
+	deadline := time.Now().Add(30 * time.Second)
+	code := -1
+	for time.Now().Before(deadline) {
+		code, _, _ = client.Fetch(context.Background())
+		if code == http.StatusOK {
+			break
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+	if code != http.StatusOK {
+		t.Fatalf("fortio server -cert -key did not serve HTTPS (code %d)\n%s", code, outBuf.String())
+	}
+}
