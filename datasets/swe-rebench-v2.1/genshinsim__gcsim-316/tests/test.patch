+func TestEventWriteRecordsOrdering(t *testing.T) {
+	e := &Event{
+		Msg:      "test",
+		F:        1,
+		Typ:      core.LogCharacterEvent,
+		SrcChar:  0,
+		Logs:     map[string]interface{}{},
+		Ordering: make(map[string]int),
+	}
+
+	//write three key/value pairs in a known order
+	e.Write("a", 1, "b", true, "c", "stuff")
+
+	//each key must be recorded in Ordering with its zero-based insertion position
+	for i, k := range []string{"a", "b", "c"} {
+		got, ok := e.Ordering[k]
+		if !ok {
+			t.Fatalf("expected key %q to be recorded in Ordering", k)
+		}
+		if got != i {
+			t.Errorf("expected Ordering[%q] = %d, got %d", k, i, got)
+		}
+	}
+
+	//ordering must continue across successive Write calls on the same event
+	e.Write("d", 4)
+	if got, ok := e.Ordering["d"]; !ok || got != 3 {
+		t.Errorf("expected Ordering[\"d\"] = 3, got %d (present=%v)", got, ok)
+	}
+}
