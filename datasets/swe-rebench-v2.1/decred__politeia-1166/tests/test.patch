+func TestHandleSetInvoiceStatusReturnsInvoiceAuthor(t *testing.T) {
+	p, cleanup := newTestPoliteiawww(t)
+	defer cleanup()
+
+	d := newTestPoliteiad(t, p)
+	defer d.Close()
+
+	author, _ := newUser(t, p, true, false)
+	admin, adminIdentity := newUser(t, p, true, true)
+
+	const token = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+	invoiceInput := cms.InvoiceInput{
+		ContractorName:     "Test Contractor",
+		ContractorLocation: "Test Location",
+		ContractorContact:  "test@example.com",
+		ContractorRate:     5000,
+		PaymentAddress:     "test-address",
+		LineItems: []cms.LineItemsInput{{
+			Type:        cms.LineItemTypeLabor,
+			Domain:      "Development",
+			Subdomain:   "Testing",
+			Description: "Test work",
+			Labor:       60,
+		}},
+	}
+	inputJSON, err := json.Marshal(invoiceInput)
+	if err != nil {
+		t.Fatal(err)
+	}
+	general, err := mdstream.EncodeInvoiceGeneral(mdstream.InvoiceGeneral{
+		Version:   mdstream.VersionInvoiceGeneral,
+		PublicKey: author.PublicKey(),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	d.AddRecord(t, pd.Record{
+		Status:    pd.RecordStatusPublic,
+		Timestamp: time.Now().Unix(),
+		Version:   "1",
+		CensorshipRecord: pd.CensorshipRecord{
+			Token: token,
+		},
+		Metadata: []pd.MetadataStream{{
+			ID:      mdstream.IDInvoiceGeneral,
+			Payload: string(general),
+		}},
+		Files: []pd.File{{
+			Name:    invoiceFile,
+			Payload: base64.StdEncoding.EncodeToString(inputJSON),
+		}},
+	})
+
+	rpcIdentity, err := identity.New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	p.cfg.Identity = &rpcIdentity.Public
+	rpc := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var command pd.UpdateVettedMetadata
+		if err := json.NewDecoder(r.Body).Decode(&command); err != nil {
+			t.Errorf("decode metadata update: %v", err)
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		challenge, err := hex.DecodeString(command.Challenge)
+		if err != nil {
+			t.Errorf("decode challenge: %v", err)
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		response := rpcIdentity.SignMessage(challenge)
+		_ = json.NewEncoder(w).Encode(pd.UpdateVettedMetadataReply{
+			Response: hex.EncodeToString(response[:]),
+		})
+	}))
+	defer rpc.Close()
+	p.cfg.RPCHost = rpc.URL
+
+	p.cmsDB = &invoiceStatusTestDB{invoice: &cmsdatabase.Invoice{
+		Token:   token,
+		Status:  cms.InvoiceStatusNew,
+		Version: "1",
+	}}
+	status := cms.InvoiceStatusRejected
+	reason := "invoice needs correction"
+	message := fmt.Sprintf("%v%v%v%v", token, "1", status, reason)
+	signature := adminIdentity.SignMessage([]byte(message))
+	command := cms.SetInvoiceStatus{
+		Token:     token,
+		Status:    status,
+		Reason:    reason,
+		PublicKey: admin.PublicKey(),
+		Signature: hex.EncodeToString(signature[:]),
+	}
+	body, err := json.Marshal(command)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := httptest.NewRequest(http.MethodPost, cms.RouteSetInvoiceStatus, strings.NewReader(string(body)))
+	session, err := p.sessions.New(r, www.CookieSession)
+	if err != nil {
+		t.Fatal(err)
+	}
+	session.Values[sessionValueUserID] = admin.ID.String()
+	session.Values[sessionValueCreatedAt] = time.Now().Unix()
+	w := httptest.NewRecorder()
+	if err := p.sessions.Save(r, w, session); err != nil {
+		t.Fatal(err)
+	}
+	for _, cookie := range w.Result().Cookies() {
+		r.AddCookie(cookie)
+	}
+
+	w = httptest.NewRecorder()
+	p.handleSetInvoiceStatus(w, r)
+	if w.Code != http.StatusOK {
+		t.Fatalf("status code %v, want %v: %s", w.Code, http.StatusOK, w.Body.String())
+	}
+	var reply cms.SetInvoiceStatusReply
+	if err := json.Unmarshal(w.Body.Bytes(), &reply); err != nil {
+		t.Fatalf("unmarshal response: %v", err)
+	}
+	if reply.Invoice.Username != author.Username {
+		t.Errorf("invoice username %q, want author %q", reply.Invoice.Username, author.Username)
+	}
+}
