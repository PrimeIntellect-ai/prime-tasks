diff --git a/tests/test_config/test_utils.py b/tests/test_config/test_utils.py
new file mode 100644
index 0000000..9afc0fe
--- /dev/null
+++ b/tests/test_config/test_utils.py
@@ -0,0 +1,61 @@
+"""Behavioral tests for settings supplied in the configuration file."""
+
+from pathlib import Path
+
+from tests.conftest import inside_dir
+
+
+class TestIgnoreMissingVersionFromConfigFile:
+    """The CLI must honor ignore_missing_version set in the configuration file."""
+
+    def test_bump_does_not_abort_when_version_missing(self, tmp_path: Path):
+        """A config file setting ignore_missing_version=true skips files without the version."""
+        from click.testing import CliRunner
+
+        from bumpversion import cli
+
+        version_path = tmp_path / "VERSION"
+        version_path.write_text("this file has no version string\n")
+        config_file = tmp_path / ".bumpversion.toml"
+        config_file.write_text(
+            "[tool.bumpversion]\n"
+            'current_version = "1.2.3"\n'
+            "allow_dirty = true\n"
+            "ignore_missing_version = true\n\n"
+            "[[tool.bumpversion.files]]\n"
+            'filename = "VERSION"\n'
+        )
+
+        runner = CliRunner()
+        with inside_dir(tmp_path):
+            result = runner.invoke(cli.cli, ["bump", "patch"])
+
+        assert result.exit_code == 0, result.output
+        assert version_path.read_text() == "this file has no version string\n"
+
+    def test_bump_does_not_abort_for_missing_version_in_glob_match(self, tmp_path: Path):
+        """The global setting applies to files selected by a configured glob."""
+        from click.testing import CliRunner
+
+        from bumpversion import cli
+
+        submodule_dir = tmp_path / "submodule"
+        submodule_dir.mkdir()
+        version_path = submodule_dir / "pyproject.toml"
+        version_path.write_text("[project]\nname = \"submodule\"\n")
+        config_file = tmp_path / ".bumpversion.toml"
+        config_file.write_text(
+            "[tool.bumpversion]\n"
+            'current_version = "1.2.3"\n'
+            "allow_dirty = true\n"
+            "ignore_missing_version = true\n\n"
+            "[[tool.bumpversion.files]]\n"
+            'glob = "submodule/*.toml"\n'
+        )
+
+        runner = CliRunner()
+        with inside_dir(tmp_path):
+            result = runner.invoke(cli.cli, ["bump", "patch"])
+
+        assert result.exit_code == 0, result.output
+        assert version_path.read_text() == '[project]\nname = "submodule"\n'
