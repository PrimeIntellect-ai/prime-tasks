diff --git a/tests/helpers.js b/tests/helpers.js
index 2dad1b3..b25c05e 100644
--- a/tests/helpers.js
+++ b/tests/helpers.js
@@ -534,3 +534,61 @@ describe('helpers', function () {
     done();
   });
 });
+
+var lint = require('../index');
+
+describe('clean-import-paths - sass syntax', function () {
+  var lintSass = function (text, options) {
+    return lint.lintText({
+      'text': text,
+      'format': 'sass',
+      'filename': 'test.sass'
+    }, {
+      'options': {
+        'merge-default-rules': false
+      },
+      'rules': {
+        'clean-import-paths': [1, options || {}]
+      }
+    });
+  };
+
+  it('reports a filename extension in an unquoted import', function (done) {
+    var result = lintSass('@import foo.scss\n');
+
+    assert.equal(1, result.warningCount);
+    done();
+  });
+
+  it('reports a leading underscore in an unquoted import', function (done) {
+    var result = lintSass('@import _foo\n');
+
+    assert.equal(1, result.warningCount);
+    done();
+  });
+
+  it('accepts a clean unquoted import', function (done) {
+    var result = lintSass('@import foo\n');
+
+    assert.equal(0, result.warningCount);
+    done();
+  });
+
+  it('requires a leading underscore when configured', function (done) {
+    var result = lintSass('@import foo\n', {
+      'leading-underscore': true
+    });
+
+    assert.equal(1, result.warningCount);
+    done();
+  });
+
+  it('requires a filename extension when configured', function (done) {
+    var result = lintSass('@import foo\n', {
+      'filename-extension': true
+    });
+
+    assert.equal(1, result.warningCount);
+    done();
+  });
+});
