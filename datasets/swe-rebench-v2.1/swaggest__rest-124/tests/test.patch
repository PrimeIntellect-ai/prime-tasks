+
+func TestMiddleware_hijacker(t *testing.T) {
+	rb := []byte(strings.Repeat("A", 10000) + "!!!")
+	h := gzip.Middleware(http.HandlerFunc(func(rw http.ResponseWriter, r *http.Request) {
+		_, ok := rw.(http.Hijacker)
+		require.True(t, ok)
+
+		_, err := rw.Write(rb)
+		assert.NoError(t, err)
+	}))
+
+	srv := httptest.NewServer(h)
+	defer srv.Close()
+
+	r, err := http.NewRequest(http.MethodGet, srv.URL+"/", nil)
+
+	require.NoError(t, err)
+	r.Header.Set("Accept-Encoding", "gzip, deflate, br")
+
+	resp, err := http.DefaultTransport.RoundTrip(r)
+	require.NoError(t, err)
+
+	body, err := ioutil.ReadAll(resp.Body)
+	require.NoError(t, err)
+
+	require.NoError(t, resp.Body.Close())
+
+	assert.Equal(t, "gzip", resp.Header.Get("Content-Encoding"))
+	assert.Less(t, len(body), len(rb)) // Response is compressed.
+	assert.Equal(t, rb, gzipDecode(t, body))
+}
+
+// hijackableResponseWriter is a test http.ResponseWriter that also implements
+// http.Hijacker, recording the values returned by Hijack.
+type hijackableResponseWriter struct {
+	http.ResponseWriter
+
+	conn net.Conn
+	rw   *bufio.ReadWriter
+	err  error
+}
+
+func (w *hijackableResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	return w.conn, w.rw, w.err
+}
+
+// TestMiddleware_hijacker_delegates verifies that the gzip middleware preserves
+// hijacking semantics: calling Hijack on the writer passed to the handler must
+// perform the hijack on the original writer's connection and return its results.
+func TestMiddleware_hijacker_delegates(t *testing.T) {
+	serverConn, clientConn := net.Pipe()
+	defer serverConn.Close()
+	defer clientConn.Close()
+
+	sentinelErr := errors.New("hijack sentinel error")
+
+	var (
+		gotConn net.Conn
+		gotRW   *bufio.ReadWriter
+		gotErr  error
+	)
+
+	h := gzip.Middleware(http.HandlerFunc(func(rw http.ResponseWriter, r *http.Request) {
+		hj, ok := rw.(http.Hijacker)
+		require.True(t, ok)
+
+		gotConn, gotRW, gotErr = hj.Hijack()
+	}))
+
+	r, err := http.NewRequest(http.MethodGet, "/", nil)
+	require.NoError(t, err)
+	r.Header.Set("Accept-Encoding", "gzip, deflate, br")
+
+	base := &hijackableResponseWriter{
+		ResponseWriter: httptest.NewRecorder(),
+		conn:           serverConn,
+		rw:             bufio.NewReadWriter(bufio.NewReader(serverConn), bufio.NewWriter(serverConn)),
+		err:            sentinelErr,
+	}
+
+	h.ServeHTTP(base, r)
+
+	assert.Equal(t, serverConn, gotConn)
+	assert.Equal(t, base.rw, gotRW)
+	assert.Equal(t, sentinelErr, gotErr)
+}
