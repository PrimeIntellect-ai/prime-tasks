+def test_widget_import():
+    """
+    The widget viewer module must import successfully: the geometry
+    hash helper it uses was renamed and the import must follow.
+    """
+    import importlib
+    import sys
+    import types
+
+    # the widget viewer depends on optional GUI libraries which may not
+    # be installed here; provide minimal stand-ins so the module's
+    # imports can be resolved and the geometry-hash import is exercised.
+    if "pyglet" not in sys.modules:
+        try:
+            import pyglet  # noqa: F401
+        except BaseException:
+            pyglet = types.ModuleType("pyglet")
+            pyglet.version = "1.5.0"
+            pyglet.options = {}
+            window = types.ModuleType("pyglet.window")
+            window.Window = type("Window", (), {})
+            pyglet.window = window
+            gl = types.ModuleType("pyglet.gl")
+            pyglet.gl = gl
+            graphics = types.ModuleType("pyglet.graphics")
+            graphics.Group = type("Group", (), {})
+            pyglet.graphics = graphics
+            sys.modules["pyglet"] = pyglet
+            sys.modules["pyglet.window"] = window
+            sys.modules["pyglet.gl"] = gl
+            sys.modules["pyglet.graphics"] = graphics
+
+    if "glooey" not in sys.modules:
+        try:
+            import glooey  # noqa: F401
+        except BaseException:
+            glooey = types.ModuleType("glooey")
+            glooey.Widget = type("Widget", (), {})
+            sys.modules["glooey"] = glooey
+
+    # importing the widget viewer must not raise an ImportError
+    importlib.import_module("trimesh.viewer.widget")
