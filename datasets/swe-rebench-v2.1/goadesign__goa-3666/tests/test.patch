+package expr_test
+
+import (
+	"testing"
+
+	"goa.design/goa/v3/dsl"
+	"goa.design/goa/v3/expr"
+)
+
+func TestServerInterceptorReadsPayloadAttributeFromExtendedType(t *testing.T) {
+	expr.RunDSL(t, func() {
+		commonAttributes := dsl.Type("Common", func() {
+			dsl.Attribute("bar", dsl.String)
+		})
+		interceptor := dsl.Interceptor("test-interceptor", func() {
+			dsl.ReadPayload(func() {
+				dsl.Attribute("bar", dsl.String)
+			})
+		})
+		dsl.Service("test", func() {
+			dsl.ServerInterceptor(interceptor)
+			dsl.Method("get", func() {
+				dsl.Payload(func() {
+					dsl.Extend(commonAttributes)
+					dsl.Attribute("foo", dsl.String)
+					dsl.Required("bar", "foo")
+				})
+				dsl.Result(dsl.Int)
+			})
+		})
+	})
+}
