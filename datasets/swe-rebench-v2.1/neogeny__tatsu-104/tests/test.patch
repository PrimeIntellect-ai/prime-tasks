+
+    def test_sparse_keywords(self):
+        import parser
+
+        # The problem statement requires that @@namechars and @@keyword
+        # declarations may appear in either order in the grammar preamble.
+        # See https://github.com/neogeny/TatSu/issues/104
+        grammars = [
+            '''
+                @@namechars :: '_'
+                @@keyword :: if else not and or false true var let type
+
+                start = {id}+ $ ;
+
+                @name
+                id = /\w+/ ;
+            ''',
+            '''
+                @@keyword :: if else not and or false true var let type
+                @@namechars :: '_'
+
+                start = {id}+ $ ;
+
+                @name
+                id = /\w+/ ;
+            ''',
+        ]
+
+        for grammar in grammars:
+            model = compile(grammar, 'test')
+            c = codegen(model)
+            parser.suite(c)
+
+            ast = model.parse('hello world')
+            self.assertEqual(['hello', 'world'], ast)
+
+            for k in ('if', 'else', 'not', 'and', 'or', 'false', 'true', 'var', 'let', 'type'):
+                try:
+                    ast = model.parse("hello %s world" % k)
+                    self.assertEqual(['hello', k, 'world'], ast)
+                    self.fail('accepted keyword "%s" as name' % k)
+                except FailedParse as e:
+                    self.assertTrue('"%s" is a reserved word' % k in str(e))
