+def test_bar_formatspec():
+    """Test Bar.__format__ spec"""
+    from tqdm._tqdm import Bar
+    assert "{0:5a}".format(Bar(0.3)) == "#5   "
+    assert "{0:2}".format(Bar(0.5, charset=" .oO0")) == "0 "
+    assert "{0:2a}".format(Bar(0.5, charset=" .oO0")) == "# "
+    assert "{0:-6a}".format(Bar(0.5, 10)) == '##  '
+    assert "{0:2b}".format(Bar(0.5, 10)) == '  '
+
+
+def test_bar_formatspec_defaults():
+    """Test Bar format-spec defaults and charset types"""
+    from tqdm._tqdm import Bar
+    # Omitted length uses ten columns, and the omitted charset is public UTF.
+    default_bar = Bar(0.5)
+    assert len("{0}".format(default_bar)) == 10
+    assert "{0}".format(default_bar) == "{0}".format(Bar(0.5, charset=Bar.UTF))
+    assert "{0}".format(default_bar) == "{0:10u}".format(default_bar)
+    # no format spec uses the stored charset and default length
+    assert "{0}".format(Bar(0.5, 4, charset=Bar.ASCII)) == "##  "
+    # 'u' selects the unicode charset
+    assert "{0:4u}".format(Bar(0.5, charset=Bar.ASCII)) == "\u2588\u2588  "
+
+
+def test_bar_formatspec_width():
+    """Test bar width format-spec in bar_format"""
+    from tqdm._tqdm import Bar  # noqa: F401 (public API availability)
+    format_meter = tqdm.format_meter
+    # fixed width overrides ncols
+    assert format_meter(20, 100, 12, ncols=80, rate=8.1,
+                        bar_format=r'{bar:10a}') == '##        '
+    # blank type
+    assert format_meter(20, 100, 12, ncols=80, rate=8.1,
+                        bar_format=r'{bar:10b}') == ' ' * 10
+    # negative width subtracts from the automatic width
+    auto = format_meter(20, 100, 12, ncols=80, rate=8.1,
+                        bar_format=r'{bar:a}')
+    assert len(format_meter(20, 100, 12, ncols=80, rate=8.1,
+                            bar_format=r'{bar:-10a}')) == len(auto) - 10
+
+
