+package day213
+
+import (
+	"sort"
+	"testing"
+)
+
+var testcases = []struct {
+	digits string
+	ips    []string
+}{
+	{"2542540123", []string{"254.25.40.123", "254.254.0.123"}},
+	{"25525511135", []string{"255.255.11.135", "255.255.111.35"}},
+	{"101023", []string{"1.0.10.23", "1.0.102.3", "10.1.0.23", "10.10.2.3", "101.0.2.3"}},
+	{"0000", []string{"0.0.0.0"}},
+	{"010010", []string{"0.10.0.10", "0.100.1.0"}},
+	{"1234567890123", []string{}},
+	{"256256256256", []string{}},
+}
+
+func TestValidIPAddresses(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		result := ValidIPAddresses(tc.digits)
+		if !sameAddresses(tc.ips, result) {
+			t.Errorf("ValidIPAddresses(%q) = %v, want %v (in any order)", tc.digits, result, tc.ips)
+		}
+	}
+}
+
+// sameAddresses reports whether a and b contain the same addresses,
+// ignoring order, since the contract does not guarantee result order.
+func sameAddresses(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	ac := append([]string{}, a...)
+	bc := append([]string{}, b...)
+	sort.Strings(ac)
+	sort.Strings(bc)
+	for i := range ac {
+		if ac[i] != bc[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func BenchmarkValidIPAddresses(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			ValidIPAddresses(tc.digits)
+		}
+	}
+}
