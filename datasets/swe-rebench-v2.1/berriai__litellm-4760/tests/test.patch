+def test_vertex_ai_medlm_completion_cost():
+    os.environ["LITELLM_LOCAL_MODEL_COST_MAP"] = "True"
+    litellm.model_cost = litellm.get_model_cost_map(url="")
+
+    messages = [{"role": "user", "content": "Test MedLM completion cost."}]
+
+    medium_cost = completion_cost(model="medlm-medium", messages=messages)
+    large_cost = completion_cost(model="medlm-large", messages=messages)
+
+    # Both MedLM models must be mapped and return a positive cost estimate.
+    assert medium_cost > 0
+    assert large_cost > 0
+
+    # The estimate must be derived from the usage of the supplied messages:
+    # a longer prompt must cost strictly more than a shorter one.
+    longer_messages = [
+        {"role": "user", "content": "Test MedLM completion cost. " * 10}
+    ]
+    longer_medium_cost = completion_cost(
+        model="medlm-medium", messages=longer_messages
+    )
+    longer_large_cost = completion_cost(
+        model="medlm-large", messages=longer_messages
+    )
+    assert longer_medium_cost > medium_cost
+    assert longer_large_cost > large_cost
+
+
+@pytest.mark.parametrize("model", ["medlm-large", "medlm-medium"])
+def test_vertex_ai_medlm_model_info_is_available(model):
+    model_info = litellm.get_model_info(model=model)
+
+    assert model_info
+
