+def test_errorhandler_bare_decorator_imports_without_app(tmp_path):
+    decorated_module = tmp_path / "decorated.py"
+    decorated_module.write_text(
+        "import functions_framework\n"
+        "@functions_framework.errorhandler\n"
+        "def handle_exception(error):\n"
+        "    return 'Unhandled exception', 500\n"
+    )
+    env = os.environ.copy()
+    repository_root = str(pathlib.Path(__file__).resolve().parents[1])
+    env["PYTHONPATH"] = os.pathsep.join(
+        filter(None, [str(tmp_path), repository_root, env.get("PYTHONPATH", "")])
+    )
+
+    result = subprocess.run(
+        [sys.executable, "-c", "import decorated"],
+        cwd=str(tmp_path),
+        env=env,
+        capture_output=True,
+        text=True,
+    )
+
+    assert result.returncode == 0, result.stderr
