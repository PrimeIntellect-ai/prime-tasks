+func TestIssue71_example_max(t *testing.T) {
+	data := strings.NewReader(`{}`)
+	logic := strings.NewReader(`{"max":[-3, -2]}`)
+
+	var result bytes.Buffer
+	err := Apply(logic, data, &result)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	expected := `-2`
+	assert.JSONEq(t, expected, result.String())
+}
+
+func TestIssue71_example_max_including_zero(t *testing.T) {
+	tests := []struct {
+		name     string
+		operands string
+		want     string
+	}{
+		{name: "two zeros", operands: `[0, 0]`, want: `0`},
+		{name: "negative and zero", operands: `[-1, 0]`, want: `0`},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			logic := strings.NewReader(`{"max":` + test.operands + `}`)
+			data := strings.NewReader(`{}`)
+			var result bytes.Buffer
+			if err := Apply(logic, data, &result); err != nil {
+				t.Fatal(err)
+			}
+			assert.JSONEq(t, test.want, result.String())
+		})
+	}
+}
