+func TestIssue71_example_empty_min(t *testing.T) {
+	data := strings.NewReader(`{}`)
+	logic := strings.NewReader(`{"min":[]}`)
+
+	var result bytes.Buffer
+	err := Apply(logic, data, &result)
+	if err != nil {
+		// The contract allows an error for empty input; that is a valid
+		// outcome and must not be treated as a failure.
+		return
+	}
+
+	// Otherwise the result must be null, not a made-up sentinel value.
+	expected := `null`
+	assert.JSONEq(t, expected, result.String())
+}
+
