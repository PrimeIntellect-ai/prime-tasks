@@ -1,4 +1,22 @@
 @testset "chainrules.jl" begin
-    test_rrule(NamedDimsArray, rand(2, 3), (:a, :b); check_inferred=VERSION >= v"1.6")
-    test_rrule(NamedDimsArray{(:a, :b)}, (rand(2, 3)); check_inferred=VERSION >= v"1.6")
+    @testset "constructor" begin
+        test_rrule(NamedDimsArray, rand(2, 3), (:a, :b); check_inferred=VERSION >= v"1.6")
+        test_rrule(NamedDimsArray{(:a, :b)}, (rand(2, 3)); check_inferred=VERSION >= v"1.6")
+    end
+
+    @testset "ProjectTo ordinary arrays" begin
+        for (names, data) in (
+            ((:a,), rand(3)),
+            ((:a, :b), rand(3, 4)),
+            ((:a, :b, :c), rand(2, 3, 4)),
+            ((:a, :b), rand(Float32, 3, 4)),
+            ((:a, :b), rand(ComplexF64, 3, 4)),
+        )
+            nda = NamedDimsArray{names}(zero.(data))
+            projected = ProjectTo(nda)(data)
+            @test projected isa NamedDimsArray
+            @test dimnames(projected) == names
+            @test parent(projected) == data
+        end
+    end
 end
