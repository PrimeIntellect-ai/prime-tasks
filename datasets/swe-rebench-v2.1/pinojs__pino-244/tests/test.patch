diff --git a/test/pretty.test.js b/test/pretty.test.js
index daa7274..05b4fa3 100644
--- a/test/pretty.test.js
+++ b/test/pretty.test.js
@@ -231,3 +231,38 @@ test('can be enabled via constructor with pretty configuration', function (t) {
     t.notEqual(actual.match(/^INFO.*h/), null)
   })
 })
+
+test('works without time', function (t) {
+  t.plan(4)
+  var prettier = pretty()
+  prettier.pipe(split(function (line) {
+    t.ok(line.match(/.*hello world$/), 'end of line matches')
+    t.ok(line.match(/^INFO.*/), 'includes level')
+    t.ok(line.indexOf('' + process.pid) > 0, 'includes pid')
+    t.ok(line.indexOf('' + hostname) > 0, 'includes hostname')
+    return line
+  }))
+
+  var instance = pino({
+    timestamp: null
+  }, prettier)
+
+  instance.info('hello world')
+})
+
+test('pretty printing works without a timestamp when enabled on the logger', function (t) {
+  t.plan(2)
+  var output = ''
+  var destination = writeStream(function (chunk, enc, cb) {
+    output += chunk
+    t.ok(output.indexOf('INFO') >= 0, 'includes the log level')
+    t.ok(output.indexOf('hello without time') >= 0, 'includes the log message')
+    cb()
+  })
+  var instance = pino({
+    prettyPrint: true,
+    timestamp: false
+  }, destination)
+
+  instance.info('hello without time')
+})
