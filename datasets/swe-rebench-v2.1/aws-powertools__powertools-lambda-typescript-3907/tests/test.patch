--- /dev/null
+++ b/packages/parser/tests/unit/schema/appsync-events.test.ts
@@ -0,0 +1,394 @@
+import { describe, expect, it } from 'vitest';
+import * as schemas from '../../../src/schemas/index.js';
+import { getTestEvent, omit } from '../helpers/utils.js';
+
+type EventInfo = {
+  channel: { path: string; segments: string[] };
+  channelNamespace: { name: string };
+  operation: 'PUBLISH' | 'SUBSCRIBE';
+};
+type EventEnvelope = {
+  identity: unknown;
+  result: null;
+  request: { headers?: Record<string, string>; domainName: string | null };
+  info: EventInfo;
+  error: null;
+  prev: null;
+  stash: Record<string, unknown>;
+  outErrors: unknown[];
+  events: null | { payload: Record<string, unknown>; id: string }[];
+};
+type PublishEvent = Omit<EventEnvelope, 'info' | 'events'> & {
+  info: Omit<EventInfo, 'operation'> & { operation: 'PUBLISH' };
+  events: { payload: Record<string, unknown>; id: string }[];
+};
+type SubscribeEvent = Omit<EventEnvelope, 'info' | 'events'> & {
+  info: Omit<EventInfo, 'operation'> & { operation: 'SUBSCRIBE' };
+  events: null;
+};
+
+describe('Schema: AppSync Events', () => {
+  const eventsPath = 'appsync-events';
+  const baseEvent = getTestEvent<SubscribeEvent>({
+    eventsPath,
+    filename: 'base',
+  });
+
+  const publishEvent = (): PublishEvent => {
+    const event = structuredClone(
+      baseEvent
+    ) as unknown as PublishEvent;
+    event.info.operation = 'PUBLISH';
+    event.events = [
+      {
+        payload: {
+          event_1: 'data_1',
+        },
+        id: '5f7dfbd1-b8ff-4c20-924e-23b42db467a0',
+      },
+      {
+        payload: {
+          event_2: 'data_2',
+        },
+        id: 'ababdf65-a3e6-4c1d-acd3-87466eab433c',
+      },
+      {
+        payload: {
+          event_3: 'data_3',
+        },
+        id: '8bb2983a-0967-45a0-8243-0aeb8c83d80e',
+      },
+    ];
+
+    return event;
+  };
+
+  const subscribeEvent = (): SubscribeEvent => {
+    const event = structuredClone(baseEvent);
+    event.info.operation = 'SUBSCRIBE';
+    event.events = null;
+
+    return event;
+  };
+
+  type EventValidator = {
+    parse: (event: unknown) => unknown;
+  };
+  const validators = Object.values(schemas).filter(
+    (value): value is EventValidator => {
+      const candidate = value as Partial<EventValidator> | null;
+      return (
+        candidate !== null &&
+        typeof candidate === 'object' &&
+        typeof candidate.parse === 'function'
+      );
+    }
+  );
+  const accepts = (validator: EventValidator, event: unknown) => {
+    try {
+      validator.parse(event);
+      return true;
+    } catch {
+      return false;
+    }
+  };
+  const validatorFor = (event: unknown, otherOperationEvent: unknown) =>
+    validators.find(
+      (candidate) =>
+        accepts(candidate, event) && !accepts(candidate, otherOperationEvent)
+    );
+  const parseForOperation = (
+    event: unknown,
+    example: PublishEvent | SubscribeEvent,
+    otherOperation: 'PUBLISH' | 'SUBSCRIBE'
+  ) => {
+    const validator = validatorFor(
+      example,
+      withOperation(example, otherOperation)
+    );
+    if (!validator) {
+      throw new Error('No validator distinguishes this AppSync Events operation');
+    }
+    return validator.parse(event);
+  };
+  const withOperation = (
+    event: PublishEvent | SubscribeEvent,
+    operation: 'PUBLISH' | 'SUBSCRIBE'
+  ) => ({
+    ...event,
+    info: { ...event.info, operation },
+  });
+  const publishExample = publishEvent();
+  const subscribeExample = subscribeEvent();
+  const publishValidator: EventValidator = {
+    parse: (event) => parseForOperation(event, publishExample, 'SUBSCRIBE'),
+  };
+  const subscribeValidator: EventValidator = {
+    parse: (event) => parseForOperation(event, subscribeExample, 'PUBLISH'),
+  };
+
+  const identities = [
+    {
+      name: 'cognito',
+      identity: {
+        sub: '192879fc-a240-4bf1-ab5a-d6a00f3063f9',
+        issuer:
+          'https://cognito-idp.us-west-2.amazonaws.com/us-west-xxxxxxxxxxx',
+        username: 'jdoe',
+        claims: {
+          sub: '192879fc-a240-4bf1-ab5a-d6a00f3063f9',
+        },
+        sourceIp: ['1.1.1.1'],
+        defaultAuthStrategy: 'ALLOW',
+        groups: null,
+      },
+    },
+    {
+      name: 'iam',
+      identity: {
+        accountId: '012345678901',
+        cognitoIdentityPoolId: null,
+        cognitoIdentityId: null,
+        sourceIp: ['1.1.1.1'],
+        username: 'AROAXYKJUOW6FHGUSK5FA:username',
+        userArn: 'arn:aws:sts::012345678901:assumed-role/role',
+        cognitoIdentityAuthType: null,
+        cognitoIdentityAuthProvider: null,
+      },
+    },
+    {
+      name: 'oidc',
+      identity: {
+        claims: {
+          sub: 'sub',
+        },
+        issuer: 'issuer',
+        sub: 'sub',
+      },
+    },
+    {
+      name: 'lambda authorizer',
+      identity: {
+        handlerContext: {
+          field1: 'value',
+        },
+      },
+    },
+  ];
+
+  describe('publish events', () => {
+    it('parses a publish event', () => {
+      // Prepare
+      const event = publishEvent();
+
+      // Act
+      const parsedEvent = publishValidator.parse(event);
+
+      // Assess
+      expect(parsedEvent).toEqual(event);
+    });
+
+    it('throws when the event is invalid', () => {
+      // Prepare
+      const event = omit(['info'], publishEvent());
+
+      // Act & Assess
+      expect(() => publishValidator.parse(event)).toThrow();
+    });
+
+    it('throws when the operation is not PUBLISH', () => {
+      // Prepare
+      const event = publishEvent();
+      event.info.operation = 'SUBSCRIBE' as unknown as 'PUBLISH';
+
+      // Act & Assess
+      expect(() => publishValidator.parse(event)).toThrow();
+    });
+
+    it('throws when the events array is empty', () => {
+      // Prepare
+      const event = publishEvent();
+      event.events = [];
+
+      // Act & Assess
+      expect(() => publishValidator.parse(event)).toThrow();
+    });
+
+    it('throws when events is null', () => {
+      // Prepare
+      const event = publishEvent();
+      event.events = null as unknown as PublishEvent['events'];
+
+      // Act & Assess
+      expect(() => publishValidator.parse(event)).toThrow();
+    });
+
+    it('throws when an event entry is missing an id', () => {
+      // Prepare
+      const event = publishEvent();
+      event.events = [
+        {
+          payload: {
+            event_1: 'data_1',
+          },
+        },
+      ] as unknown as PublishEvent['events'];
+
+      // Act & Assess
+      expect(() => publishValidator.parse(event)).toThrow();
+    });
+
+    it('throws when an event entry is missing a payload', () => {
+      // Prepare
+      const event = publishEvent();
+      event.events = [
+        {
+          id: '5f7dfbd1-b8ff-4c20-924e-23b42db467a0',
+        },
+      ] as unknown as PublishEvent['events'];
+
+      // Act & Assess
+      expect(() => publishValidator.parse(event)).toThrow();
+    });
+
+    it('accepts a valid payload with arbitrary JSON values and optional headers', () => {
+      const event = publishEvent();
+      delete event.request.headers;
+      event.events[0].payload.nested = { items: [1, true, null] };
+
+      expect(publishValidator.parse(event)).toEqual(event);
+    });
+
+    it.each(identities)(
+      'parses a publish event with a $name identity',
+      ({ identity }) => {
+        // Prepare
+        const event = publishEvent();
+        event.identity = identity as PublishEvent['identity'];
+
+        // Act
+        const parsedEvent = publishValidator.parse(event);
+
+        // Assess
+        expect(parsedEvent).toEqual(event);
+      }
+    );
+  });
+
+  describe('subscribe events', () => {
+    it('parses a subscribe event', () => {
+      // Prepare
+      const event = subscribeEvent();
+
+      // Act
+      const parsedEvent = subscribeValidator.parse(event);
+
+      // Assess
+      expect(parsedEvent).toEqual(event);
+    });
+
+    it('throws when the event is invalid', () => {
+      // Prepare
+      const event = omit(['info'], subscribeEvent());
+
+      // Act & Assess
+      expect(() => subscribeValidator.parse(event)).toThrow();
+    });
+
+    it('throws when the operation is not SUBSCRIBE', () => {
+      // Prepare
+      const event = subscribeEvent();
+      event.info.operation = 'PUBLISH' as unknown as 'SUBSCRIBE';
+
+      // Act & Assess
+      expect(() => subscribeValidator.parse(event)).toThrow();
+    });
+
+    it('throws when events is not null', () => {
+      // Prepare
+      const event = subscribeEvent();
+      event.events = [
+        {
+          payload: {
+            event_1: 'data_1',
+          },
+          id: '5f7dfbd1-b8ff-4c20-924e-23b42db467a0',
+        },
+      ] as unknown as SubscribeEvent['events'];
+
+      // Act & Assess
+      expect(() => subscribeValidator.parse(event)).toThrow();
+    });
+
+    it('accepts a valid subscribe envelope without optional headers', () => {
+      const event = subscribeEvent();
+      delete event.request.headers;
+
+      expect(subscribeValidator.parse(event)).toEqual(event);
+    });
+
+    it.each(identities)(
+      'parses a subscribe event with a $name identity',
+      ({ identity }) => {
+        // Prepare
+        const event = subscribeEvent();
+        event.identity = identity as SubscribeEvent['identity'];
+
+        // Act
+        const parsedEvent = subscribeValidator.parse(event);
+
+        // Assess
+        expect(parsedEvent).toEqual(event);
+      }
+    );
+  });
+
+  const malformedEnvelopeFields: [string, (event: EventEnvelope) => void][] = [
+    ['identity', (event) => Object.assign(event, { identity: 'other-source' })],
+    ['result', (event) => Object.assign(event, { result: {} })],
+    ['request', (event) => Object.assign(event, { request: null })],
+    ['request headers', (event) => Object.assign(event.request, { headers: { key: 1 } })],
+    ['domain name', (event) => Object.assign(event.request, { domainName: 7 })],
+    ['info', (event) => Object.assign(event, { info: null })],
+    ['channel path', (event) => Object.assign(event.info.channel, { path: 7 })],
+    ['channel segments', (event) => Object.assign(event.info.channel, { segments: ['channel', 7] })],
+    ['channel namespace', (event) => Object.assign(event.info.channelNamespace, { name: 7 })],
+    ['operation', (event) => Object.assign(event.info, { operation: 'OTHER' })],
+    ['error', (event) => Object.assign(event, { error: {} })],
+    ['previous result', (event) => Object.assign(event, { prev: {} })],
+    ['stash', (event) => Object.assign(event, { stash: null })],
+    ['out errors', (event) => Object.assign(event, { outErrors: null })],
+  ];
+
+  it.each(malformedEnvelopeFields)(
+    'rejects a publish and subscribe envelope with malformed %s',
+    (_field, mutate) => {
+      const publish = publishEvent();
+      mutate(publish);
+      expect(() => publishValidator.parse(publish)).toThrow();
+
+      const subscribe = subscribeEvent();
+      mutate(subscribe);
+      expect(() => subscribeValidator.parse(subscribe)).toThrow();
+    }
+  );
+
+  it.each([
+    ['event id', { id: 7 }],
+    ['event payload', { payload: 'not-an-object' }],
+  ])('rejects a publish entry with a malformed %s', (_field, invalidValue) => {
+    const event = publishEvent();
+    Object.assign(event.events[0], invalidValue);
+
+    expect(() => publishValidator.parse(event)).toThrow();
+  });
+
+  it('rejects a non-AppSync message from another event source', () => {
+    const foreignMessage = {
+      Records: [{ eventSource: 'aws:sqs', body: 'message' }],
+    };
+
+    expect(() => publishValidator.parse(foreignMessage)).toThrow();
+    expect(() => subscribeValidator.parse(foreignMessage)).toThrow();
+  });
+});
