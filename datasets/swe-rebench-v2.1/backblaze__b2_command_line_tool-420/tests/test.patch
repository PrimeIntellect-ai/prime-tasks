+    def test_exclude_dir_b2_folder(self):
+        # The exclude-directory policy must be applied while scanning a B2
+        # folder, so that files inside an excluded directory are left out.
+        bucket = MagicMock()
+        api = MagicMock()
+        api.get_bucket_by_name.return_value = bucket
+        folder = B2Folder('bucket-name', 'folder', api)
+        bucket.ls.return_value = [
+            (
+                FileVersionInfo(
+                    'a1', 'folder/alfa/foo.txt', 100, 'text/plain', 'sha1', {}, 1000, 'upload'
+                ), 'folder'
+            ),
+            (
+                FileVersionInfo(
+                    'b1', 'folder/bravo/foo.txt', 100, 'text/plain', 'sha1', {}, 1000, 'upload'
+                ), 'folder'
+            ),
+        ]
+        policy = ScanPoliciesManager(exclude_dir_regexes=['alfa'])
+        self.assertEqual(
+            ['bravo/foo.txt'], [f.name for f in folder.all_files(None, policy)]
