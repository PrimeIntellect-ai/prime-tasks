+// Regression test for https://github.com/BurntSushi/ripgrep/issues/2884
+//
+// When case is ignored, an alternation such as `e.x|ex` must still match
+// `e-x`. This used to fail for the specific characters `e`, `k`, `s` and
+// `t`.
+#[test]
+fn regression_2884_specific_case_letters() {
+    for ch in ["e", "k", "s", "t"] {
+        let (_dir, mut cmd) = setup("regression_2884");
+        let pattern = format!("{}.x|{}x", ch, ch);
+        let haystack = format!("{}-x", ch);
+        cmd.arg("-i").arg(&pattern);
+        let got = cmd.pipe(haystack.as_bytes());
+        assert!(got.contains(&haystack));
+    }
+}
+
+// The regression above only affected the characters `e`, `k`, `s` and `t`
+// when case was ignored. Every other alphabetic character, and case
+// sensitive matching, must keep working.
+#[test]
+fn regression_2884_unaffected_cases() {
+    for ch in 'a'..='z' {
+        if matches!(ch, 'e' | 'k' | 's' | 't') {
+            continue;
+        }
+        let (_dir, mut cmd) = setup("regression_2884_unaffected");
+        let pattern = format!("{}.x|{}x", ch, ch);
+        let haystack = format!("{}-x", ch);
+        cmd.arg("-i").arg(&pattern);
+        let got = cmd.pipe(haystack.as_bytes());
+        assert!(got.contains(&haystack));
+    }
+
+    let (_dir, mut cmd) = setup("regression_2884_case_sensitive");
+    cmd.arg("e.x|ex");
+    let got = cmd.pipe(b"e-x");
+    assert!(got.contains("e-x"));
+}
