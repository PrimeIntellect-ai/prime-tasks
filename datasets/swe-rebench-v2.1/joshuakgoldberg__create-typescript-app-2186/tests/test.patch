+function withoutBuildDocsScript(value: unknown): unknown {
+	if (Array.isArray(value)) {
+		return value.map(withoutBuildDocsScript);
+	}
+
+	if (value !== null && typeof value === "object") {
+		return Object.fromEntries(
+			Object.entries(value).map(([key, child]) => [
+				key,
+				key === "build:docs"
+					? "<build:docs script>"
+					: withoutBuildDocsScript(child),
+			]),
+		);
+	}
+
+	return value;
+}
+
+function expectBuildDocsToBuildFirst(creation: unknown) {
+	expect(creation).toMatchObject({
+		addons: expect.arrayContaining([
+			expect.objectContaining({
+				addons: expect.objectContaining({
+					properties: expect.objectContaining({
+						scripts: expect.objectContaining({
+							"build:docs": expect.stringMatching(
+								/pnpm build --no-dts[\s\S]*eslint-doc-generator/,
+							),
+						}),
+					}),
+				}),
+			}),
+		]),
+	});
+}
