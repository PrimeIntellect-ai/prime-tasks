+def test_locale_identifiers_cache(monkeypatch):
+    original_listdir = localedata.os.listdir
+    listdir_calls = []
+
+    def listdir_spy(*args):
+        rv = original_listdir(*args)
+        listdir_calls.append((args, rv))
+        return rv
+
+    monkeypatch.setattr(localedata.os, 'listdir', listdir_spy)
+
+    # The first call may read the identifiers from disk (and populate any
+    # cache); subsequent calls must not read from disk again.
+    first = localedata.locale_identifiers()
+    assert first
+    calls_after_first = len(listdir_calls)
+
+    second = localedata.locale_identifiers()
+    assert set(second) == set(first)
+    assert len(listdir_calls) == calls_after_first
