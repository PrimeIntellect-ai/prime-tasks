 import json
 
+from autoconf.dictable import to_dict
 from autofit.mapper.mock.mock_model import MockClassx2Tuple
 import autofit as af
 
@@ -7,3 +8,46 @@ import autofit as af
 def test_tuple():
     model = af.Model(MockClassx2Tuple)
     json.dumps(model.dict())
+
+
+class PowerLaw:
+    def __init__(
+        self,
+        centre=(0.0, 0.0),
+        ell_comps=(0.0, 0.0),
+        einstein_radius=1.0,
+        slope=2.0,
+    ):
+        self.centre = centre
+        self.ell_comps = ell_comps
+        self.einstein_radius = einstein_radius
+        self.slope = slope
+
+
+class Isothermal(PowerLaw):
+    def __init__(
+        self,
+        centre=(0.0, 0.0),
+        ell_comps=(0.0, 0.0),
+        einstein_radius=1.0,
+    ):
+        super().__init__(
+            centre=centre,
+            ell_comps=ell_comps,
+            einstein_radius=einstein_radius,
+            slope=2.0,
+        )
+
+
+def test_isothermal_inheritance(tmp_path):
+    model = af.Collection(instance=Isothermal())
+    files = tmp_path / "files"
+    files.mkdir()
+    (tmp_path / "metadata").write_text("")
+    with open(files / "model.json", "w") as f:
+        json.dump(to_dict(model), f)
+
+    result = af.SearchOutput(tmp_path).model
+
+    assert isinstance(result.instance, Isothermal)
+    assert result.instance.slope == 2.0
