+def test_inverse_velocity_conversion():
+    # see issue #60: time/length quantities must not convert to ohms
+    import unyt as u
+
+    b = u.unyt_quantity(100, "s/m")
+    assert b.in_mks() == u.unyt_quantity(100, "s/m")
+    assert b.in_cgs() == u.unyt_quantity(1, "s/cm")
+    assert b.in_mks().units != Unit("ohm")
+    assert b.in_cgs().units != Unit("ohm")
+    # repeated conversion is stable
+    assert b.in_cgs().in_cgs() == u.unyt_quantity(1, "s/cm")
+
+    a = u.unyt_quantity(100, "m/s")
+    assert a.in_cgs() == u.unyt_quantity(10000, "cm/s")
+
