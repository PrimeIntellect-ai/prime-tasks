+def test_get_all_collections_deeply_nested(nested_catalog: pystac.Catalog) -> None:
+    catalog = nested_catalog
+    all_collections = list(catalog.get_all_collections())
+
+    assert len(all_collections) == 1
+    assert all(isinstance(c, pystac.Collection) for c in all_collections)
+
+
+def test_get_all_collections_depth_first() -> None:
+    root = pystac.Catalog("root", "root")
+    branch_a = pystac.Catalog("branch_a", "branch_a")
+    branch_b = pystac.Catalog("branch_b", "branch_b")
+    deep_a = pystac.Catalog("deep_a", "deep_a")
+    collection_a = pystac.Collection(
+        "collection_a", "collection_a", extent=ARBITRARY_EXTENT
+    )
+    collection_b = pystac.Collection(
+        "collection_b", "collection_b", extent=ARBITRARY_EXTENT
+    )
+
+    root.add_child(branch_a)
+    root.add_child(branch_b)
+    branch_a.add_child(deep_a)
+    deep_a.add_child(collection_a)
+    branch_b.add_child(collection_b)
+
+    collection_ids = [c.id for c in root.get_all_collections()]
+
+    assert collection_ids == ["collection_a", "collection_b"]
+
+
+def test_get_all_collections_propagates_child_errors() -> None:
+    class RaisingCatalog(pystac.Catalog):
+        def get_collections(self) -> Iterator[pystac.Collection]:
+            raise RuntimeError("child catalog failure")
+
+    root = pystac.Catalog("root", "root")
+    root.add_child(RaisingCatalog("raising", "raising"))
+
+    with pytest.raises(RuntimeError, match="child catalog failure"):
+        list(root.get_all_collections())
+
+
+def test_get_all_collections_returns_generator() -> None:
+    catalog = TestCases.case_1()
+
+    assert inspect.isgenerator(catalog.get_all_collections())
+
