+
+        with smart_open.open(
+            "azure://%s/%s" % (CONTAINER_NAME, blob_name),
+            "wb",
+            transport_params={
+                "client": blob_client,
+                "blob_kwargs": {"metadata": {"purpose": "test upload metadata"}},
+            },
+        ) as fout:
+            fout.write(test_string)
+
+        self.assertEqual(
+            blob_client.get_blob_properties().get("purpose"), "test upload metadata"
+        )
+
+        output = list(smart_open.open(
+            "azure://%s/%s" % (CONTAINER_NAME, blob_name),
+            "rb",
+            transport_params=dict(client=CLIENT),
+        ))
+        self.assertEqual(output, [test_string])
