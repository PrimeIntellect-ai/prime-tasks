diff --git a/tests/sass/no-vendor-prefixes.sass b/tests/sass/no-vendor-prefixes.sass
index 9c72206..f6059a6 100644
--- a/tests/sass/no-vendor-prefixes.sass
+++ b/tests/sass/no-vendor-prefixes.sass
@@ -21,3 +21,19 @@
 
 .ms-block
   -ms-hyphenate-limit-lines: no-limit
+
+// Issue #705 - ignore non standard properties
+html
+  -webkit-tap-highlight-color: $link-color-hover
+  -webkit-nonstandard-demo: none
+
+// Issue #702 - ignore non standard properties
+button::-moz-focus-inner,
+input::-moz-focus-inner
+  border: 0
+  padding: 0
+
+// Issue #702 - ignore non standard properties
+input[type="number"]::-webkit-inner-spin-button,
+input[type="number"]::-webkit-outer-spin-button
+  height: auto
diff --git a/tests/sass/no-vendor-prefixes.scss b/tests/sass/no-vendor-prefixes.scss
index af061db..ce56c12 100644
--- a/tests/sass/no-vendor-prefixes.scss
+++ b/tests/sass/no-vendor-prefixes.scss
@@ -21,3 +21,22 @@
 .ms-block {
   -ms-hyphenate-limit-lines: no-limit;
 }
+
+// Issue #705 - ignore non standard properties
+html {
+  -webkit-tap-highlight-color: $link-color-hover;
+  -webkit-nonstandard-demo: none;
+}
+
+// Issue #702 - ignore non standard properties
+button::-moz-focus-inner,
+input::-moz-focus-inner {
+  border: 0;
+  padding: 0;
+}
+
+// Issue #702 - ignore non standard properties
+input[type="number"]::-webkit-inner-spin-button,
+input[type="number"]::-webkit-outer-spin-button {
+  height: auto;
+}
