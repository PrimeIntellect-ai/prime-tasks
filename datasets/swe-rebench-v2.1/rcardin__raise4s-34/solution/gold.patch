+++ b/src/main/scala/in/rcard/raise4s/Runtime.scala
@@ -0,0 +1,7 @@
+package in.rcard.raise4s
+
+object Runtime {
+
+  private[raise4s] def _run[Error, A](block: Raise[Error] ?=> A): Error | A =
+    Raise.fold(block, identity, identity)
+}
