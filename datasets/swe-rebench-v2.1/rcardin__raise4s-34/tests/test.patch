+package in.rcard.raise4s
+
+import org.scalatest.flatspec.AnyFlatSpec
+import org.scalatest.matchers.should.Matchers
+
+class RuntimeSpec extends AnyFlatSpec with Matchers {
+  "Raise.run" should "return the happy path value if no error was raised" in {
+    val happyPathBlock: Int raises String = 42
+    val result: String | Int = Raise.run(happyPathBlock)
+    result should be(42)
+  }
+
+  it should "return the error value if an error was raised" in {
+    val errorBlock: Int raises String = Raise.raise("error")
+    val result: String | Int = Raise.run(errorBlock)
+    result should be("error")
+  }
+}
