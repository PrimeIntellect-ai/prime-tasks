+// TestInterceptorsExternalPayloadType verifies that the generated
+// service_interceptors.go file imports the package of a user type declared with
+// the "struct:pkg:path" metadata and references that type using the package
+// qualifier when the type is read from the method payload.
+func TestInterceptorsExternalPayloadType(t *testing.T) {
+	dslFn := func() {
+		var TenantID = dsl.Type("TenantID", dsl.String, func() {
+			dsl.Meta("struct:pkg:path", "ids")
+		})
+		dsl.Service("ExternalPayloadType", func() {
+			dsl.Interceptor("TenantID", func() {
+				dsl.ReadPayload(func() {
+					dsl.Attribute("tenantID", TenantID)
+				})
+			})
+			dsl.ServerInterceptor("TenantID")
+			dsl.Method("get", func() {
+				dsl.Payload(func() {
+					dsl.Attribute("id", dsl.String)
+					dsl.Attribute("tenantID", TenantID)
+					dsl.Required("tenantID", "id")
+				})
+				dsl.Result(dsl.Int)
+				dsl.HTTP(func() { dsl.GET("{tenantID}/resource/{id}") })
+			})
+		})
+	}
+	root := runDSL(t, dslFn)
+	require.Len(t, root.Services, 1)
+
+	files := Files("goa.design/goa/example", root.Services[0], make(map[string][]string))
+	dir := t.TempDir()
+	var code string
+	for _, f := range files {
+		if filepath.Base(f.Path) != "service_interceptors.go" {
+			continue
+		}
+		path, err := f.Render(dir)
+		require.NoError(t, err)
+		bs, err := os.ReadFile(path)
+		require.NoError(t, err)
+		code = string(bs)
+	}
+	require.NotEmpty(t, code, "service_interceptors.go was not generated")
+	assert.Contains(t, code, `"goa.design/goa/example/ids"`)
+	assert.Contains(t, code, "ids.TenantID")
+}
