+func TestLoadBalancerBackendPoolRefreshAfterNodeJoinsAvailabilitySetCache(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+
+	az := getCloudFromConfig(t, `{"aadClientId": "--aad-client-id--", "aadClientSecret": "--aad-client-secret--", "location": "westus"}`)
+	az.nodeInformerSynced = func() bool { return true }
+	az.LoadBalancerSku = consts.LoadBalancerSkuStandard
+	mockVMClient := mockvmclient.NewMockInterface(ctrl)
+	mockInterfaceClient := mockinterfaceclient.NewMockInterface(ctrl)
+	az.InterfacesClient = mockInterfaceClient
+	az.VirtualMachinesClient = mockVMClient
+	vmSet, err := newScaleSet(az)
+	assert.NoError(t, err)
+	ss := vmSet.(*ScaleSet)
+
+	vmList := []compute.VirtualMachine{{
+		Name: to.StringPtr("old-node"),
+		ID:   to.StringPtr("/subscriptions/subscription/resourceGroups/rg/providers/Microsoft.Compute/virtualMachines/old-node"),
+	}}
+	mockVMClient.EXPECT().List(gomock.Any(), gomock.Any()).DoAndReturn(
+		func(ctx context.Context, resourceGroup string) ([]compute.VirtualMachine, *retry.Error) {
+			return vmList, nil
+		}).AnyTimes()
+	mockVMClient.EXPECT().Get(gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any()).DoAndReturn(
+		func(ctx context.Context, resourceGroup, name string, expand compute.InstanceViewTypes) (compute.VirtualMachine, *retry.Error) {
+			for _, vm := range vmList {
+				if to.String(vm.Name) == name {
+					return vm, nil
+				}
+			}
+			return compute.VirtualMachine{}, nil
+		}).AnyTimes()
+
+	// Populate the cache while it contains a different, already available VM.
+	ss.updateNodeCaches(nil, &v1.Node{ObjectMeta: metav1.ObjectMeta{Name: "old-node"}})
+	_, err = ss.GetInstanceIDByNodeName("old-node")
+	assert.NoError(t, err)
+
+	// A new cluster node becomes available as an availability-set VM.
+	ss.updateNodeCaches(nil, &v1.Node{ObjectMeta: metav1.ObjectMeta{Name: "node1"}})
+	vmList = append(vmList, compute.VirtualMachine{
+		Name: to.StringPtr("node1"),
+		ID:   to.StringPtr("/subscriptions/subscription/resourceGroups/rg/providers/Microsoft.Compute/virtualMachines/node1"),
+		VirtualMachineProperties: &compute.VirtualMachineProperties{
+			NetworkProfile: &compute.NetworkProfile{
+				NetworkInterfaces: &[]compute.NetworkInterfaceReference{{
+					ID:                                  to.StringPtr("/subscriptions/subscription/resourceGroups/rg/providers/Microsoft.Network/networkInterfaces/node1-nic"),
+					NetworkInterfaceReferenceProperties: &compute.NetworkInterfaceReferenceProperties{Primary: to.BoolPtr(true)},
+				}},
+			},
+		},
+	})
+	mockInterfaceClient.EXPECT().Get(gomock.Any(), "rg", "node1-nic", gomock.Any()).Return(
+		network.Interface{Name: to.StringPtr("node1-nic"), InterfacePropertiesFormat: &network.InterfacePropertiesFormat{ProvisioningState: consts.NicFailedState}}, nil).AnyTimes()
+
+	service := getTestService("cache-refresh", v1.ProtocolTCP, nil, false, 80)
+	node := &v1.Node{ObjectMeta: metav1.ObjectMeta{Name: "node1"}}
+	err = ss.EnsureHostsInPool(&service, []*v1.Node{node}, "backend-pool", "", false)
+	assert.NoError(t, err)
+}
