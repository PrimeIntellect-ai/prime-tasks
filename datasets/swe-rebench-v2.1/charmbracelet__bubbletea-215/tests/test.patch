+
+func TestReadInputsBatchedMouse(t *testing.T) {
+	// Some terminals emit more than one mouse event in a single read. A mouse
+	// click, for example, can arrive as a press and a release together.
+	buf := []byte("\x1b[M +6\x1b[M#+6")
+
+	msgs, err := readInputs(bytes.NewReader(buf))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if len(msgs) != 2 {
+		t.Fatalf("expected 2 messages, got %d: %#v", len(msgs), msgs)
+	}
+
+	types := map[MouseEventType]bool{}
+	for _, m := range msgs {
+		mouse, ok := m.(MouseMsg)
+		if !ok {
+			t.Fatalf("expected a MouseMsg, got %T", m)
+		}
+		types[mouse.Type] = true
+	}
+	if !types[MouseLeft] || !types[MouseRelease] {
+		t.Fatalf("expected a left press and a release, got %#v", msgs)
+	}
+}
