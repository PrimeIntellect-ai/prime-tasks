+func TestUploadEmptyFileReader(t *testing.T) {
+	received := make(chan error, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		file, _, err := r.FormFile("file")
+		if err != nil {
+			received <- err
+			return
+		}
+		defer file.Close()
+
+		data, err := io.ReadAll(file)
+		if err == nil && len(data) != 0 {
+			err = fmt.Errorf("expected an empty uploaded file, got %d bytes", len(data))
+		}
+		received <- err
+	}))
+	defer server.Close()
+
+	_, err := New().R().SetFileReader("file", "empty.txt", bytes.NewReader(nil)).Post(server.URL)
+	if err != nil {
+		t.Fatalf("uploading an empty file failed: %v", err)
+	}
+	if err := <-received; err != nil {
+		t.Fatalf("server did not receive the empty file: %v", err)
+	}
+}
