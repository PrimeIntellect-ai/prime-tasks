+test("Menu has a link to the GitHub page", () => {
+  const mockedWindowOpen = jest
+    .spyOn(window, "open")
+    .mockReturnValue({ focus: jest.fn() } as unknown as Window);
+
+  expect(homepageURL).toContain("github.com");
+
+  const { container, getByText } = render(
+    React.createElement(Menu, { contentId: "main" }),
+  );
+
+  // A link may be rendered as an anchor pointing at the GitHub page...
+  const anchor = Array.from(container.querySelectorAll("a")).find((element) =>
+    (element.getAttribute("href") ?? "").includes("github.com"),
+  );
+  if (anchor) {
+    return;
+  }
+
+  // ...or as a clickable element that opens the GitHub page.
+  fireEvent.click(getByText("We are on GitHub"));
+
+  expect(mockedWindowOpen).toHaveBeenCalled();
+  expect(mockedWindowOpen.mock.calls[0][0]).toBe(homepageURL);
+});
