+import { convertRules } from "../../../convertRules";
+import { rulesConverters } from "../../../rulesConverters";
+
+describe("jsx-equals-spacing rule conversion", () => {
+    test("converts the rule through the normal rule registry", () => {
+        const result = convertRules(
+            {
+                converters: rulesConverters,
+                mergers: new Map(),
+            },
+            {
+                "jsx-equals-spacing": true,
+            },
+        );
+
+        expect(result.missing).toHaveLength(0);
+        expect(result.converted.has("react/jsx-equals-spacing")).toBe(true);
+    });
+});
