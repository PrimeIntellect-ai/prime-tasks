+// mockCrypto implements the op.Crypto interface without encrypting values.
+type mockCrypto struct{}
+
+func (c *mockCrypto) Encrypt(s string) (string, error) {
+	return s, nil
+}
+
+func (c *mockCrypto) Decrypt(s string) (string, error) {
+	return s, nil
+}
+
+func TestAuthResponseCodeEmptyStateRegression(t *testing.T) {
+	tests := []struct {
+		name         string
+		state        string
+		wantLocation string
+	}{
+		{
+			name:         "state follows code",
+			state:        "state1",
+			wantLocation: "/auth/callback/?code=id1&state=state1",
+		},
+		{
+			name:         "empty state is omitted",
+			state:        "",
+			wantLocation: "/auth/callback/?code=id1",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			storage := mock.NewMockStorage(ctrl)
+			storage.EXPECT().SaveAuthCode(gomock.Any(), gomock.Any(), gomock.Any()).AnyTimes()
+
+			authorizer := mock.NewMockAuthorizer(ctrl)
+			authorizer.EXPECT().Storage().Return(storage)
+			authorizer.EXPECT().Crypto().Return(&mockCrypto{})
+			authorizer.EXPECT().Encoder().Return(schema.NewEncoder())
+
+			authReq := &storageexample.AuthRequest{
+				ID:            "id1",
+				TransferState: tt.state,
+			}
+			w := httptest.NewRecorder()
+			op.AuthResponseCode(w, httptest.NewRequest(http.MethodPost, "/auth/callback/", nil), authReq, authorizer)
+			assert.Equal(t, tt.wantLocation, w.Result().Header.Get("Location"))
+		})
+	}
+}
