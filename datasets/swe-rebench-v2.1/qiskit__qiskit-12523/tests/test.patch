+    def test_roundtrip_to_matrix(self):
+        # Regression test for the reported gates: after a qasm2 round-trip, the
+        # resulting operation's ``to_matrix`` must work the same as the original.
+        for gate in (lib.XXPlusYYGate(0.1), lib.CSGate()):
+            with self.subTest(gate=gate.name):
+                qc = QuantumCircuit(2)
+                qc.append(gate, [0, 1])
+                program = qiskit.qasm2.dumps(qc)
+                parsed = QuantumCircuit.from_qasm_str(program)
+                expected = gate.to_matrix()
+                actual = parsed.data[0].operation.to_matrix()
+                np.testing.assert_allclose(actual, expected, atol=1e-8)
