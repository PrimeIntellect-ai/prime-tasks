@@ -75,3 +76,42 @@ test('importTraceEvents only begin events', async () => {
 test('importTraceEvents zero duration events', async () => {
   await checkProfileSnapshot('./sample/profiles/trace-event/zero-duration-events.json')
 })
+
+async function importInlineEvents(events: any[]): Promise<string[]> {
+  const buffer = Buffer.from(JSON.stringify(events))
+  const arrayBuffer = buffer.buffer.slice(buffer.byteOffset, buffer.byteOffset + buffer.byteLength)
+  const profileGroup = await importProfilesFromArrayBuffer('inline-trace.json', arrayBuffer)
+  expect(profileGroup).toBeTruthy()
+  if (!profileGroup) throw new Error('Failed to import inline trace events')
+  return dumpProfile(profileGroup.profiles[0]).stacks
+}
+
+test('importTraceEvents overlapping complete events retain their timing', async () => {
+  const stacks = await importInlineEvents([
+    {pid: 0, tid: 0, ph: 'X', ts: 0, dur: 10, name: 'alpha'},
+    {pid: 0, tid: 0, ph: 'X', ts: 5, dur: 10, name: 'beta'},
+  ])
+
+  expect(stacks).toEqual(['alpha 5.00µs', 'alpha;beta 10.00µs'])
+})
+
+test('importTraceEvents identical complete events use file order for nesting', async () => {
+  const stacks = await importInlineEvents([
+    {pid: 0, tid: 0, ph: 'X', ts: 0, dur: 20, name: 'alpha'},
+    {pid: 0, tid: 0, ph: 'X', ts: 0, dur: 20, name: 'beta'},
+  ])
+
+  expect(stacks).toEqual(['alpha;beta 20.00µs'])
+})
+
+test('importTraceEvents repeated complete-event collisions', async () => {
+  const stacks = await importInlineEvents([
+    {pid: 0, tid: 0, ph: 'X', ts: 0, dur: 10, name: 'alpha'},
+    {pid: 0, tid: 0, ph: 'X', ts: 1, dur: 1, name: 'beta'},
+    {pid: 0, tid: 0, ph: 'X', ts: 1, dur: 1, name: 'gamma'},
+    {pid: 0, tid: 0, ph: 'X', ts: 5, dur: 1, name: 'gamma'},
+    {pid: 0, tid: 0, ph: 'X', ts: 5, dur: 1, name: 'beta'},
+  ])
+  expect(stacks).toContain('alpha;beta;gamma 1.00µs')
+  expect(stacks).toContain('alpha;gamma;beta 1.00µs')
+})
