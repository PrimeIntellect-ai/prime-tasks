+package internal_test
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/ctreminiom/go-atlassian/jira/v2"
+	"github.com/ctreminiom/go-atlassian/jira/v3"
+	model "github.com/ctreminiom/go-atlassian/pkg/infra/models"
+)
+
+type groupUserPickerFinder interface {
+	Find(context.Context, *model.GroupUserPickerFindOptionScheme) (*model.GroupUserPickerFindScheme, *model.ResponseScheme, error)
+}
+
+func TestGroupUserPickerAvailableThroughVersionedClients(t *testing.T) {
+	versions := []struct {
+		name string
+		path string
+		new  func(*http.Client, string) (groupUserPickerFinder, bool, error)
+	}{
+		{
+			name: "v2",
+			path: "/rest/api/2/groupuserpicker",
+			new: func(client *http.Client, site string) (groupUserPickerFinder, bool, error) {
+				jiraClient, err := v2.New(client, site)
+				if err != nil {
+					return nil, false, err
+				}
+				return jiraClient.GroupUserPicker, jiraClient.GroupUserPicker != nil, nil
+			},
+		},
+		{
+			name: "v3",
+			path: "/rest/api/3/groupuserpicker",
+			new: func(client *http.Client, site string) (groupUserPickerFinder, bool, error) {
+				jiraClient, err := v3.New(client, site)
+				if err != nil {
+					return nil, false, err
+				}
+				return jiraClient.GroupUserPicker, jiraClient.GroupUserPicker != nil, nil
+			},
+		},
+	}
+
+	for _, version := range versions {
+		t.Run(version.name, func(t *testing.T) {
+			var gotMethod, gotPath, gotQuery string
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				gotMethod, gotPath, gotQuery = r.Method, r.URL.Path, r.URL.Query().Get("query")
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(`{
+"groups":{"groups":[{"groupId":"g-17","name":"jira-users","html":"<b>jira</b>-users","labels":[]}],"header":"1 group","total":1},
+"users":{"users":[{"accountId":"u-29","displayName":"Jira User","html":"<b>Jira</b> User","avatarUrl":"https://example.test/avatar.png"}],"header":"1 user","total":1}
+}`))
+			}))
+			defer server.Close()
+
+			picker, exposed, err := version.new(server.Client(), server.URL)
+			require.NoError(t, err)
+			if !assert.True(t, exposed, "group-user picker is exposed by the versioned client") {
+				return
+			}
+			result, _, err := picker.Find(context.Background(), &model.GroupUserPickerFindOptionScheme{Query: "jira"})
+
+			require.NoError(t, err)
+			assert.Equal(t, http.MethodGet, gotMethod)
+			assert.Equal(t, version.path, gotPath)
+			assert.Equal(t, "jira", gotQuery)
+			require.NotNil(t, result)
+			require.NotNil(t, result.Groups)
+			require.Len(t, result.Groups.Groups, 1)
+			assert.Equal(t, "g-17", result.Groups.Groups[0].GroupID)
+			assert.Equal(t, "jira-users", result.Groups.Groups[0].Name)
+			require.NotNil(t, result.Users)
+			require.Len(t, result.Users.Users, 1)
+			assert.Equal(t, "u-29", result.Users.Users[0].AccountID)
+			assert.Equal(t, "Jira User", result.Users.Users[0].DisplayName)
+		})
+	}
+}
