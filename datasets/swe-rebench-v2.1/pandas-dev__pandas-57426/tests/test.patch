+class TestSA05Docstrings:
+    # Methods that were on the SA05 ignore list before the cleanup.
+    _SA05_IGNORED_BEFORE = {
+        "pandas.core.groupby.SeriesGroupBy.first",
+        "pandas.core.groupby.SeriesGroupBy.last",
+        "pandas.core.resample.Resampler.first",
+        "pandas.core.resample.Resampler.last",
+        "pandas.core.window.expanding.Expanding.aggregate",
+        "pandas.core.window.rolling.Rolling.aggregate",
+        "pandas.plotting.bootstrap_plot",
+        "pandas.plotting.radviz",
+    }
+
+    @staticmethod
+    def _repo_root():
+        return Path(pd.__file__).resolve().parents[1]
+
+    def _sa05_ignored_now(self):
+        path = self._repo_root() / "ci" / "code_checks.sh"
+        lines = path.read_text().splitlines()
+        marker = "--errors=SA05 --ignore_functions"
+        start = next(i for i, line in enumerate(lines) if marker in line)
+        ignored = set()
+        for i, line in enumerate(lines):
+            if i <= start:
+                continue
+            code = line.partition("#")[0].strip()
+            continued = code.endswith("\\")
+            name = code.rstrip("\\").strip()
+            if name:
+                ignored.add(name)
+            if not continued:
+                break
+        return ignored
+
+    def _selected_methods(self):
+        return self._SA05_IGNORED_BEFORE - self._sa05_ignored_now()
+
+    def test_sa05_ignore_list_cleanup_count(self):
+        selected = self._selected_methods()
+        assert 2 <= len(selected) <= 4, sorted(selected)
+
+    def test_sa05_selected_methods_pass_validation(self):
+        selected = self._selected_methods()
+        script = self._repo_root() / "scripts" / "validate_docstrings.py"
+        for name in sorted(selected):
+            proc = subprocess.run(
+                [
+                    sys.executable,
+                    str(script),
+                    "--format=actions",
+                    "--errors=SA05",
+                    name,
+                ],
+                cwd=self._repo_root(),
+                capture_output=True,
+                text=True,
+            )
+            assert proc.returncode == 0, proc.stderr
+            assert "\tSA05\t" not in proc.stderr, f"{name}: {proc.stderr}"
