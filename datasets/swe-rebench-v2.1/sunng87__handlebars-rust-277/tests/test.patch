+#[test]
+fn test_nested_each() {
+    let hbs = Handlebars::new();
+
+    let data = json!({
+        "classes": [
+            {
+                "methods": [
+                    {"id": 1},
+                    {"id": 2}
+                ]
+            },
+            {
+                "methods": [
+                    {"id": 3},
+                    {"id": 4}
+                ]
+            },
+        ],
+    });
+
+    let template = "{{#each classes as |class|}}{{#each class.methods as |method|}}{{method.id}};{{/each}}{{/each}}";
+    assert_eq!(hbs.render_template(template, &data).unwrap(), "1;2;3;4;");
+}
+
+#[test]
+fn test_nested_each_with_qualified_outer_path() {
+    let hbs = Handlebars::new();
+
+    let data = json!({
+        "protocol": {
+            "classes": [
+                {
+                    "methods": [
+                        {"id": 1},
+                        {"id": 2}
+                    ]
+                },
+                {
+                    "methods": [
+                        {"id": 3},
+                        {"id": 4}
+                    ]
+                },
+            ]
+        }
+    });
+
+    let template = "{{#each protocol.classes as |class|}}{{#each class.methods as |method|}}{{method.id}};{{/each}}{{/each}}";
+    assert_eq!(hbs.render_template(template, &data).unwrap(), "1;2;3;4;");
 }
