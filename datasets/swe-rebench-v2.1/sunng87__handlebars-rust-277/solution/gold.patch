+fn join(segs: &VecDeque<&str>, sep: &str) -> String {
+    let mut out = String::new();
+    let mut iter = segs.into_iter();
+    if let Some(fst) = iter.next() {
+        out.push_str(fst);
+        for elt in iter {
+            out.push_str(sep);
+            out.push_str(elt);
+        }
+    }
+    out
+}
