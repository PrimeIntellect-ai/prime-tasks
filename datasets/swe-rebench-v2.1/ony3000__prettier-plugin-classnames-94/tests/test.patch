diff --git a/tests/v2-test/svelte/issue-93/absolute.test.ts b/tests/v2-test/svelte/issue-93/absolute.test.ts
new file mode 100644
index 0000000..58880ac
--- /dev/null
+++ b/tests/v2-test/svelte/issue-93/absolute.test.ts
@@ -0,0 +1,34 @@
+import { format } from 'prettier';
+import { describe, expect, test } from 'vitest';
+import { baseOptions } from 'test-settings';
+
+import { thisPlugin } from '../../adaptor';
+import { fixtures } from './fixtures';
+
+const options = {
+  ...baseOptions,
+  plugins: ['prettier-plugin-svelte', thisPlugin],
+  parser: 'svelte',
+  endingPosition: 'absolute',
+};
+
+const expressions = ["{anyBoolean ? 'yes' : 'no'}", "{'consectetur adipiscing elit proin'}"];
+
+describe.each(fixtures.map((fixture, index) => ({ fixture, expression: expressions[index] })))('$fixture.name', ({ fixture, expression }) => {
+  const fixedOptions = { ...options, ...(fixture.options ?? {}) };
+
+  test('preserves each expression as one separated class word', () => {
+    const formatted = format(fixture.input, fixedOptions);
+    const expressionIndex = formatted.indexOf(expression);
+
+    expect(expressionIndex).toBeGreaterThanOrEqual(0);
+    expect(formatted.slice(0, expressionIndex)).toMatch(/amet\s+$/);
+    expect(formatted.slice(expressionIndex + expression.length)).toMatch(/^\s+ex\b/);
+  });
+
+  test('formatting is consistent', () => {
+    const formatted = format(fixture.input, fixedOptions);
+
+    expect(format(formatted, fixedOptions)).toBe(formatted);
+  });
+});
