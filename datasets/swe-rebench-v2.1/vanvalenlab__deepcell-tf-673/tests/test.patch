 from itertools import product
 from unittest.mock import Mock
 
+import pytest
 import numpy as np
 
 from tensorflow.python.platform import test
@@ -299,3 +300,27 @@ class TestApplication(test.TestCase):
         x = np.random.rand(1, 128, 128, 1)
         y = app._predict_segmentation(x, image_mpp=1.3)
         self.assertEqual(x.shape, y.shape)
+
+
+@pytest.mark.parametrize(
+    "orig_img_shape",
+    (
+        (1, 216, 256, 1),  # x < model_img_shape
+        (1, 256, 64, 1),  # y < model_img_shape
+    ),
+)
+def test_untile_non_empty_slices(orig_img_shape):
+    """Test removing actual padding when the other spatial axis is unpadded."""
+    app = Application(DummyModel, model_image_shape=(256, 256, 1))
+
+    img = np.arange(np.prod(orig_img_shape)).reshape(orig_img_shape)
+    x_padding = (256 - orig_img_shape[1]) // 2
+    y_padding = (256 - orig_img_shape[2]) // 2
+    x_pad = (x_padding, x_padding)
+    y_pad = (y_padding, y_padding)
+    padded_img = np.pad(img, ((0, 0), x_pad, y_pad, (0, 0)))
+    tiles_info = {"padding": True, "x_pad": x_pad, "y_pad": y_pad}
+
+    untiled = app._untile_output(padded_img, tiles_info)
+    assert untiled.shape == orig_img_shape
+    np.testing.assert_array_equal(untiled, img)
