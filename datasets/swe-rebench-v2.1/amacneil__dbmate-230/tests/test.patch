+func assertHostlessConnectionString(t *testing.T, actual string) {
+	t.Helper()
+	if runtime.GOOS == "linux" {
+		require.Equal(t, "postgres://:5432/foo?host=%2Fvar%2Frun%2Fpostgresql", actual)
+		return
+	}
+
+	u, err := url.Parse(actual)
+	require.NoError(t, err)
+	require.Empty(t, u.Hostname())
+	require.True(t, strings.HasPrefix(u.Query().Get("host"), "/"), "expected a Unix-domain socket host")
+}
