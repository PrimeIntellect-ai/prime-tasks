+    def test_load_from_file(self):
+        """Test loading basic approximations from a file works.
+
+        Regression test of Qiskit/qiskit#12576.
+        """
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            fullpath = os.path.join(tmp_dir, "approximations.npy")
+
+            # Keep both forms from the same generated set so the comparison
+            # tests the effect of serialization, not a particular approximation.
+            approximations = generate_basic_approximations(
+                basis_gates=["h", "s", "sdg", "t", "tdg"], depth=3, filename=fullpath
+            )
+            in_memory = SolovayKitaev(recursion_degree=0, basic_approximations=approximations)
+            from_file = SolovayKitaev(recursion_degree=0, basic_approximations=fullpath)
+
+            circuits = []
+            for rotation, angle in (("rx", 0.8), ("ry", 1.1), ("rz", 0.7)):
+                circuit = QuantumCircuit(1)
+                getattr(circuit, rotation)(angle, 0)
+                circuits.append(circuit)
+
+            # P(pi/4) has the same SO(3) rotation as T but differs by a
+            # global phase, exercising preservation of phase-bearing entries.
+            phase_sensitive = QuantumCircuit(1)
+            phase_sensitive.p(np.pi / 4, 0)
+            circuits.append(phase_sensitive)
+
+            for circuit in circuits:
+                with self.subTest(circuit=circuit):
+                    expected = in_memory(circuit)
+                    actual = from_file(circuit)
+                    self.assertEqual(
+                        [instruction.operation.name for instruction in actual.data],
+                        [instruction.operation.name for instruction in expected.data],
+                    )
+                    self.assertAlmostEqual(actual.global_phase, expected.global_phase)
+
 
