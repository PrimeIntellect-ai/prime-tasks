+class TestSearch(unittest.TestCase):
+    def test_fuzzy_dict_search(self):
+        model = pybamm.BaseModel()
+        model.variables = {
+            "Electrolyte concentration": 111,
+            "Electrode potential": 222,
+        }
+
+        # Default search prints matching keys and returns None
+        with patch("sys.stdout", new=StringIO()) as fake_out:
+            result = model.variables.search("Electrode")
+            self.assertIsNone(result)
+            out = fake_out.getvalue()
+            self.assertIn("Electrode potential", out)
+            self.assertNotIn("Electrolyte concentration", out)
+            self.assertNotIn("222", out)
+
+        # Search is case-insensitive
+        with patch("sys.stdout", new=StringIO()) as fake_out:
+            model.variables.search("electrode")
+            out = fake_out.getvalue()
+            self.assertIn("Electrode potential", out)
+            self.assertNotIn("Electrolyte concentration", out)
+
+        # print_values=True prints matching keys together with their values
+        with patch("sys.stdout", new=StringIO()) as fake_out:
+            model.variables.search("Electrode", print_values=True)
+            out = fake_out.getvalue()
+            self.assertIn("Electrode potential", out)
+            self.assertIn("222", out)
+
+        # No results prints best-match suggestions
+        with patch("sys.stdout", new=StringIO()) as fake_out:
+            model.variables.search("bad var")
+            out = fake_out.getvalue()
+            self.assertIn("Electrolyte concentration", out)
+            self.assertIn("Electrode potential", out)
+
+    def test_parameter_values_search(self):
+        param = pybamm.ParameterValues({"alpha": 111, "beta": 222})
+
+        # Default search prints names and values and returns None
+        with patch("sys.stdout", new=StringIO()) as fake_out:
+            result = param.search("alpha")
+            self.assertIsNone(result)
+            out = fake_out.getvalue()
+            self.assertIn("alpha", out)
+            self.assertIn("111", out)
+            self.assertNotIn("beta", out)
+
+        # print_values=False prints only matching names
+        with patch("sys.stdout", new=StringIO()) as fake_out:
+            result = param.search("alpha", print_values=False)
+            self.assertIsNone(result)
+            out = fake_out.getvalue()
+            self.assertIn("alpha", out)
+            self.assertNotIn("111", out)
+
+
