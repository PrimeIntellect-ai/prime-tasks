diff --git a/tests/parser/syntax/test_dynamic_array.py b/tests/parser/syntax/test_dynamic_array.py
new file mode 100644
index 00000000..81c2435e
--- /dev/null
+++ b/tests/parser/syntax/test_dynamic_array.py
@@ -0,0 +1,26 @@
+import pytest
+
+from vyper.exceptions import StructureException, VyperException
+
+fail_list = [
+    (
+        """
+foo: DynArray[HashMap[uint8, uint8], 2]
+    """,
+        StructureException,
+    ),
+    (
+        """
+foo: public(DynArray[HashMap[uint8, uint8], 2])
+    """,
+        StructureException,
+    ),
+]
+
+
+@pytest.mark.parametrize("bad_code,exc", fail_list)
+def test_block_fail(assert_compile_failed, get_contract, bad_code, exc):
+    # The public contract only requires that declaring a dynamic array of
+    # HashMaps is rejected by the compiler. The exact exception class is an
+    # implementation detail, so accept any compiler exception.
+    assert_compile_failed(lambda: get_contract(bad_code), VyperException)
