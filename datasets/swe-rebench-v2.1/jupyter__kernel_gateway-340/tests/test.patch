+    def test_tls_server_accepts_tls_12_websocket_clients(self):
+        """The gateway's TLS listener must complete handshakes with clients
+        that offer TLS 1.2 (e.g. Safari 13.1+)."""
+        os.environ.pop('KG_SSL_VERSION', None)
+        with tempfile.TemporaryDirectory() as cert_dir:
+            certfile = os.path.join(cert_dir, 'server.crt')
+            keyfile = os.path.join(cert_dir, 'server.key')
+            subprocess.check_call([
+                'openssl', 'req', '-x509', '-newkey', 'rsa:2048', '-nodes',
+                '-keyout', keyfile, '-out', certfile, '-days', '1',
+                '-subj', '/CN=localhost',
+            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+            with socket.socket() as port_probe:
+                port_probe.bind(('127.0.0.1', 0))
+                port = port_probe.getsockname()[1]
+
+            app = KernelGatewayApp()
+            app.certfile = certfile
+            app.keyfile = keyfile
+            app.ip = '127.0.0.1'
+            app.port = port
+            app.web_app = Application()
+            app.init_http_server()
+
+            client_context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
+            client_context.check_hostname = False
+            client_context.verify_mode = ssl.CERT_NONE
+            client_context.minimum_version = ssl.TLSVersion.TLSv1_2
+
+            async def connect():
+                stream = await TCPClient().connect(
+                    '127.0.0.1', port, ssl_options=client_context)
+                stream.close()
+
+            try:
+                ioloop.IOLoop.current().run_sync(connect)
+            finally:
+                app.http_server.stop()
 
