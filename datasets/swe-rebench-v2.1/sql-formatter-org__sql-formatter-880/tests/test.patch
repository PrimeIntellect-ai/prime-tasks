+
+  // Issue #877
+  it('allows the use of the ODBC date format', () => {
+    const result = format(
+      `WITH [sales_query] AS (SELECT [customerId] FROM [segments].dbo.[sales] WHERE [salesdate] > {d'2024-01-01'})`
+    );
+    // The ODBC date literal must be accepted and preserved verbatim.
+    expect(result).toContain(`{d'2024-01-01'}`);
+    // The surrounding bracket-quoted identifiers must still be preserved.
+    expect(result).toContain('[sales_query]');
+    expect(result).toContain('[salesdate]');
+  });
+
+  // Issue #877
+  it('formats a bracket-quoted SQL Server CTE', () => {
+    const result = format(
+      `WITH [Contact] AS (SELECT [ContactID], [FirstName], [LastName] FROM [dbo].[Contact])`
+    );
+    expect(result).toContain('[Contact]');
+    expect(result).toContain('[ContactID]');
+    expect(result).toContain('[FirstName]');
+    expect(result).toContain('[LastName]');
+    expect(result).toContain('[dbo].[Contact]');
+  });
 });
