+def test_search_experiments_with_filter(sagemaker_client):
+    experiment_name = "experiment_name"
+    trial_component_name = "trial_component_name"
+    _set_up_trial_component(
+        sagemaker_client,
+        experiment_name=experiment_name,
+        trial_component_name=trial_component_name,
+    )
+
+    # The public contract only requires Contains filtering for model package
+    # groups.  For experiments we only assert the pre-existing Equals behaviour
+    # so that an implementation which fixes model groups in isolation is not
+    # wrongly rejected.
+    _verify_search_results(
+        {"Name": "ExperimentName", "Operator": "Equals", "Value": "_name"}, 0
+    )
+    _verify_search_results(
+        {"Name": "ExperimentName", "Operator": "Equals", "Value": experiment_name}, 1
+    )
+
+
+def test_search_model_package_groups_with_filter(sagemaker_client):
+    sagemaker_client.create_model_package_group(
+        ModelPackageGroupName="mpg_DEV",
+        ModelPackageGroupDescription="test-model-package-group-description",
+    )
+    sagemaker_client.create_model_package_group(
+        ModelPackageGroupName="mpg_PROD",
+        ModelPackageGroupDescription="test-model-package-group-description",
+    )
+
+    # A Contains filter must select only the groups whose name contains the
+    # filter value, even when matching and non-matching groups coexist.
+    dev_results = _search_results(
+        {"Name": "ModelPackageGroupName", "Operator": "Contains", "Value": "_DEV"},
+        resource="ModelPackageGroup",
+    )
+    assert [r["ModelPackageGroup"]["ModelPackageGroupName"] for r in dev_results] == [
+        "mpg_DEV"
+    ]
+
+    prod_results = _search_results(
+        {"Name": "ModelPackageGroupName", "Operator": "Contains", "Value": "_PROD"},
+        resource="ModelPackageGroup",
+    )
+    assert [r["ModelPackageGroup"]["ModelPackageGroupName"] for r in prod_results] == [
+        "mpg_PROD"
+    ]
+
+    no_results = _search_results(
+        {"Name": "ModelPackageGroupName", "Operator": "Contains", "Value": "_STAGING"},
+        resource="ModelPackageGroup",
+    )
+    assert no_results == []
+
+
+def _search_results(_filter, resource="Experiment"):
+    sagemaker_client = boto3.client("sagemaker", region_name=TEST_REGION_NAME)
+    return sagemaker_client.search(
+        Resource=resource, SearchExpression={"Filters": [_filter]}
+    )["Results"]
+
+
+def _verify_search_results(_filter, nr_of_results, resource="Experiment"):
+    results = _search_results(_filter, resource=resource)
+    assert len(results) == nr_of_results
+
+
