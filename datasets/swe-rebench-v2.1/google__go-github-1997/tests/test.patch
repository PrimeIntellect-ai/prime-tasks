+func TestActionsService_EnableAndDisableIndividualRepoInOrg_Behavior(t *testing.T) {
+	client, mux, _, teardown := setup()
+	defer teardown()
+
+	methods := make(map[string]bool)
+	mux.HandleFunc("/orgs/o/actions/permissions/repositories/123", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPut && r.Method != http.MethodDelete {
+			t.Errorf("unexpected request method %s", r.Method)
+		}
+		methods[r.Method] = true
+		w.WriteHeader(http.StatusNoContent)
+	})
+
+	ctx := context.Background()
+	if _, err := client.Actions.AddEnabledReposInOrg(ctx, "o", 123); err != nil {
+		t.Errorf("Actions.AddEnabledReposInOrg returned error: %v", err)
+	}
+	if !methods[http.MethodPut] {
+		t.Error("Actions.AddEnabledReposInOrg did not enable the individual repository")
+	}
+	if _, err := client.Actions.RemoveEnabledRepoInOrg(ctx, "o", 123); err != nil {
+		t.Errorf("Actions.RemoveEnabledRepoInOrg returned error: %v", err)
+	}
+	if !methods[http.MethodDelete] {
+		t.Error("Actions.RemoveEnabledRepoInOrg did not disable the individual repository")
+	}
+}
