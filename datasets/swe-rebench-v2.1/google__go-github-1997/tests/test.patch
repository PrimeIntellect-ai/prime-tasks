+func TestActionsService_SetEnabledReposInOrg_Behavior(t *testing.T) {
+	client, mux, _, teardown := setup()
+	defer teardown()
+
+	requested := false
+	mux.HandleFunc("/orgs/o/actions/permissions/repositories", func(w http.ResponseWriter, r *http.Request) {
+		requested = true
+		testMethod(t, r, http.MethodPut)
+		var body struct {
+			SelectedRepositoryIDs []int64 `json:"selected_repository_ids"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Errorf("could not read selected repository IDs: %v", err)
+		}
+		if !cmp.Equal(body.SelectedRepositoryIDs, []int64{123, 1234}) {
+			t.Errorf("selected repository IDs = %v, want [123 1234]", body.SelectedRepositoryIDs)
+		}
+		w.WriteHeader(http.StatusNoContent)
+	})
+
+	ctx := context.Background()
+	if _, err := client.Actions.SetEnabledReposInOrg(ctx, "o", []int64{123, 1234}); err != nil {
+		t.Errorf("Actions.SetEnabledReposInOrg returned error: %v", err)
+	}
+	if !requested {
+		t.Error("Actions.SetEnabledReposInOrg did not replace the selected repositories")
+	}
+}
