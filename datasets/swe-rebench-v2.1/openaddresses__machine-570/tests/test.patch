+    def test_render_geojson_address_counts(self):
+        class Feature:
+            def __init__(self, values):
+                self.values = values
+                self.geometry = Mock()
+                self.geometry.ExportToJson.return_value = '{"type":"Polygon","coordinates":[]}'
+
+            def GetFieldAsString(self, field):
+                return self.values[field]
+
+            def GetGeometryRef(self):
+                return self.geometry
+
+        sources = {}
+        for path, count in [('one.json', '4'), ('two.json', '7'), ('three.json', '9'), ('four.json', '6'), ('five.json', '13')]:
+            source = Mock()
+            source.state.address_count = count
+            source.datetime_tz = 'date'
+            sources[path] = source
+
+        countries = [Feature({'iso_a2': 'AA', 'name': 'Aggregated'}),
+                     Feature({'iso_a2': 'BB', 'name': 'Single source'})]
+        admin_areas = [Feature({'iso_3166_2': 'AA-1', 'name': 'Admin area'})]
+        standalone_geometry = Mock()
+        standalone_geometry.ExportToJson.return_value = '{"type":"Polygon","coordinates":[]}'
+        datasource_tuple = (None, [], [], [], countries, [], admin_areas, [], [])
+        handle, filename = tempfile.mkstemp(prefix='render-', suffix='.geojson')
+        os.close(handle)
+
+        try:
+            with patch('openaddr.render.load_geoids', return_value=({}, {})), \
+                    patch('openaddr.render.load_iso3166s', return_value=({'AA': ['one.json', 'two.json'], 'BB': ['three.json'], 'AA-1': ['five.json']}, {})), \
+                    patch('openaddr.render.load_geometries', return_value=({'four.json': standalone_geometry}, {})), \
+                    patch('openaddr.render.open_datasources', return_value=datasource_tuple), \
+                    patch.object(render.osr, 'SRS_WKT_WGS84', 'wgs84', create=True), \
+                    patch.object(render.osr, 'SpatialReference', return_value=Mock()):
+                render.render_geojson('', sources, filename, render.WORLD)
+
+            with open(filename) as file:
+                geojson = json.load(file)
+
+            property_values = [value for feature in geojson['features']
+                               for value in feature['properties'].values()]
+            for expected in (11, 9, 13, 6):
+                self.assertTrue(any(str(expected) in str(value) for value in property_values))
+        finally:
+            os.remove(filename)
+
