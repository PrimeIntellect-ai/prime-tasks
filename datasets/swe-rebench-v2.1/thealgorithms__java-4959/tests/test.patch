+package com.thealgorithms;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import com.thealgorithms.dynamicprogramming.Tribonacci;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for {@code Tribonacci}.
+ */
+public class TribonacciTest {
+
+    /**
+     * Tests the Tribonacci computation for a set of known values.
+     */
+    @Test
+    public void testKnownValues() {
+        assertEquals(0, Tribonacci.compute(0), "The 0th Tribonacci should be 0.");
+        assertEquals(1, Tribonacci.compute(1), "The 1st Tribonacci should be 1.");
+        assertEquals(1, Tribonacci.compute(2), "The 2nd Tribonacci should be 1.");
+        assertEquals(2, Tribonacci.compute(3), "The 3rd Tribonacci should be 2.");
+        assertEquals(4, Tribonacci.compute(4), "The 4th Tribonacci should be 4.");
+        assertEquals(7, Tribonacci.compute(5), "The 5th Tribonacci should be 7.");
+        assertEquals(13, Tribonacci.compute(6), "The 6th Tribonacci should be 13.");
+        assertEquals(149, Tribonacci.compute(10), "The 10th Tribonacci should be 149.");
+    }
+
+    /**
+     * Tests every supported index, including the upper endpoint.
+     */
+    @Test
+    public void testSupportedRange() {
+        int[] expected = {
+            0, 1, 1, 2, 4, 7, 13, 24, 44, 81, 149, 274, 504, 927, 1705, 3136, 5768, 10609, 19513,
+            35890, 66012, 121415, 223317, 410744, 755476, 1389537, 2555757, 4700770, 8646064,
+            15902591, 29249425, 53798080, 98950096, 181997601, 334745777, 615693474, 1132436852
+        };
+
+        for (int n = 0; n < expected.length; n++) {
+            assertEquals(expected[n], Tribonacci.compute(n), "Unexpected Tribonacci value at index " + n);
+        }
+    }
+}
