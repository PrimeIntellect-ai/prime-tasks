             ],
         )
         self.assertDictEqual(dict_block, class_block.to_dict())
+
+    def test_structural_children_are_parsed(self):
+        dict_block = {
+            "type": "rich_text",
+            "elements": [
+                {
+                    "type": "rich_text_section",
+                    "elements": [{"type": "rich_text_section", "elements": []}],
+                },
+                {
+                    "type": "rich_text_quote",
+                    "elements": [{"type": "rich_text_section", "elements": []}],
+                },
+                {
+                    "type": "rich_text_preformatted",
+                    "elements": [{"type": "rich_text_section", "elements": []}],
+                },
+                {
+                    "type": "rich_text_list",
+                    "elements": [{"type": "rich_text_section", "elements": []}],
+                },
+            ],
+        }
+        block = RichTextBlock(**dict_block)
+        for element in block.elements:
+            self.assertIsInstance(element.elements[0], RichTextSectionElement)
+
+    def test_non_section_structural_children_are_parsed(self):
+        nested_types = [
+            ("rich_text_list", RichTextListElement),
+            ("rich_text_quote", RichTextQuoteElement),
+            ("rich_text_preformatted", RichTextPreformattedElement),
+        ]
+        container_types = [
+            "rich_text_list",
+            "rich_text_section",
+            "rich_text_quote",
+            "rich_text_preformatted",
+        ]
+        block = RichTextBlock(
+            type="rich_text",
+            elements=[
+                {
+                    "type": container_type,
+                    "elements": [{"type": child_type, "elements": []} for child_type, _ in nested_types],
+                }
+                for container_type in container_types
+            ],
+        )
+
+        for container in block.elements:
+            for child, (_, expected_type) in zip(container.elements, nested_types):
+                self.assertIsInstance(child, expected_type)
