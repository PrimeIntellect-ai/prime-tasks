+    def test_compose_no_clbits_in_one(self):
+        """Test combining a circuit with cregs to one without"""
+        ansatz = TwoLocal(2, rotation_blocks="ry", entanglement_blocks="cx")
+
+        qc = QuantumCircuit(2)
+        qc.measure_all()
+        out = ansatz.compose(qc)
+        self.assertEqual(
+            len({bit for instruction in qc.data if instruction.operation.name == "measure" for bit in instruction.clbits}),
+            len({bit for instruction in out.data if instruction.operation.name == "measure" for bit in instruction.clbits}),
+        )
+        self.assertEqual(out.count_ops().get("measure", 0), qc.count_ops()["measure"])
+        for operation, count in qc.count_ops().items():
+            self.assertGreaterEqual(out.count_ops().get(operation, 0), count)
+        for instruction in out.data:
+            if instruction.operation.name == "measure":
+                self.assertTrue(set(instruction.clbits).issubset(out.clbits))
+
