+package org.jboss.weld.junit4.bean.extension;
+
+import java.util.concurrent.atomic.AtomicInteger;
+
+import javax.enterprise.event.Observes;
+import javax.enterprise.inject.spi.Extension;
+import javax.enterprise.inject.spi.ProcessAnnotatedType;
+
+/**
+ *
+ * @author <a href="mailto:manovotn@redhat.com">Matej Novotny</a>
+ */
+public class MyExtension implements Extension {
+
+    private static final AtomicInteger OBSERVED_BEANS = new AtomicInteger();
+
+    public void observePAT(@Observes ProcessAnnotatedType<GoodOldBean> event) {
+        OBSERVED_BEANS.incrementAndGet();
+    }
+
+    /**
+     * @return the number of {@link GoodOldBean} annotated types observed by this extension
+     */
+    public static int observedBeans() {
+        return OBSERVED_BEANS.get();
+    }
+
+    public static void reset() {
+        OBSERVED_BEANS.set(0);
+    }
+}
