+func TestMatrixoneTestAccessorIsAbsentFromProductionBuild(t *testing.T) {
+	output, err := exec.Command("go", "build", ".").CombinedOutput()
+	assert.NoError(t, err, string(output))
+
+	probeDir, err := os.MkdirTemp("..", "production-api-probe-")
+	assert.NoError(t, err)
+	defer os.RemoveAll(probeDir)
+	probe := `package main
+import "github.com/matrixorigin/matrixcube/raftstore"
+var _ raftstore.LogDBGetter
+func main() {}
+`
+	err = os.WriteFile(filepath.Join(probeDir, "main.go"), []byte(probe), 0600)
+	assert.NoError(t, err)
+	moduleDir, err := filepath.Abs("..")
+	assert.NoError(t, err)
+	command := exec.Command("go", "build", "-o", filepath.Join(probeDir, "client"), "./"+filepath.Base(probeDir))
+	command.Dir = moduleDir
+	output, err = command.CombinedOutput()
+	assert.Error(t, err)
+	assert.Contains(t, string(output), "undefined: raftstore.LogDBGetter")
+}
