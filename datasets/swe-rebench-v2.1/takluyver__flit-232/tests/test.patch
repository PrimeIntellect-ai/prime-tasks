 def test_normalize_file_permissions():
     assert normalize_file_permissions(0o100664) == 0o100644 # regular file
     assert normalize_file_permissions(0o40775) == 0o40755   # directory
+
+def test_wheel_tag_from_requires_python(tmp_path):
+    """A spaced Python-3 minimum produces a Python-3-only wheel tag."""
+    from flit.wheel import wheel_main
+
+    (tmp_path / 'module1.py').write_text(
+        '"""Example module"""\n\n__version__ = "0.1"\n'
+    )
+    (tmp_path / 'flit.ini').write_text(
+        "[metadata]\n"
+        "module=module1\n"
+        "author=Sir Robin\n"
+        "author-email=robin@camelot.uk\n"
+        "home-page=http://github.com/sirrobin/module1\n"
+        "requires-python=>= 3.7\n"
+    )
+
+    wheel_main(tmp_path / 'flit.ini')
+
+    dist = tmp_path / 'dist'
+    expected = dist / 'module1-0.1-py3-none-any.whl'
+    assert expected.is_file()
