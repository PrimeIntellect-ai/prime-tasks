+func TestFilesystemHonorsSharedRepositoryPermissions(t *testing.T) {
+	for _, tc := range []struct {
+		sharedRepo string
+		filePerms  os.FileMode
+		dirPerms   os.FileMode
+	}{
+		{"0777", 0666, 0777},
+		{"0660", 0660, 0770},
+		{"group", 0660, 0770},
+	} {
+		tmp, err := ioutil.TempDir("", "lfs-shared")
+		assert.Nil(t, err)
+		defer os.RemoveAll(tmp)
+
+		cmd := exec.Command("git", "init", "-q", tmp)
+		assert.Nil(t, cmd.Run())
+		cmd = exec.Command("git", "-C", tmp, "config", "core.sharedrepository", tc.sharedRepo)
+		assert.Nil(t, cmd.Run())
+
+		cfg := NewIn(tmp, filepath.Join(tmp, ".git"))
+		fs := cfg.Filesystem()
+
+		assert.Equal(t, tc.filePerms, fs.RepositoryPermissions(false), "sharedrepository=%s", tc.sharedRepo)
+		assert.Equal(t, tc.dirPerms, fs.RepositoryPermissions(true), "sharedrepository=%s", tc.sharedRepo)
+
+		dir := fs.LFSObjectDir()
+		for _, d := range []string{fs.LFSStorageDir, dir} {
+			fi, err := os.Stat(d)
+			assert.Nil(t, err)
+			assert.Equal(t, tc.dirPerms, fi.Mode().Perm(), "sharedrepository=%s dir=%s", tc.sharedRepo, d)
+		}
+	}
+}
