+func TestNewMeterHonorsSharedRepositoryPermissions(t *testing.T) {
+	cfg := config.NewFrom(config.Values{
+		Git: map[string][]string{
+			"core.sharedrepository": []string{"0777"},
+		},
+	})
+
+	m := tq.NewMeter(cfg)
+
+	dir, err := ioutil.TempDir("", "lfs-meter")
+	require.Nil(t, err)
+	defer os.RemoveAll(dir)
+
+	logfile := filepath.Join(dir, "logs", "progress.log")
+	w := m.LoggerToFile(logfile)
+	require.NotNil(t, w)
+
+	fi, err := os.Stat(filepath.Dir(logfile))
+	require.Nil(t, err)
+	assert.Equal(t, os.FileMode(0777), fi.Mode().Perm())
+}
