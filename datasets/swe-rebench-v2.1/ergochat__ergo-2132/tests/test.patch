+func writeEnvironmentTestConfig(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	configPath := filepath.Join(dir, "config.yaml")
+	configData := `network:
+    name: test.example
+server:
+    name: test.example
+    max-sendq: 96k
+    listeners:
+        "127.0.0.1:6667":
+    motd: long.motd.txt
+    coerce-ident: ""
+    compatibility:
+        send-unprefixed-sasl: true
+    websockets:
+        allowed-origins: ["https://www.ircv3.net"]
+accounts:
+    default-user-modes: "+i"
+    nick-reservation:
+        enabled: false
+history:
+    enabled: true
+datastore:
+    path: ircd.db
+limits:
+    awaylen: 100
+    channellen: 64
+    kicklen: 100
+    nicklen: 32
+    topiclen: 300
+allow-environment-overrides: true
+`
+	if err := os.WriteFile(configPath, []byte(configData), 0644); err != nil {
+		t.Fatal(err)
+	}
+	return configPath
+}
