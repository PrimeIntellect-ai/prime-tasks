+func TestEnvironmentOverrideLogging(t *testing.T) {
+	dir := t.TempDir()
+	configPath := filepath.Join(dir, "config.yaml")
+	configData := `network:
+    name: test.example
+server:
+    name: test.example
+    max-sendq: 96k
+    listeners:
+        "127.0.0.1:6667":
+datastore:
+    path: ircd.db
+limits:
+    awaylen: 100
+    channellen: 64
+    kicklen: 100
+    nicklen: 32
+    topiclen: 300
+allow-environment-overrides: true
+`
+	if err := os.WriteFile(configPath, []byte(configData), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	const secretValue = "supersecretvalue"
+	const envName = "ERGO__NETWORK__NAME"
+	if err := os.Setenv(envName, secretValue); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Unsetenv(envName)
+
+	logFile, err := os.CreateTemp(dir, "stderr")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer logFile.Close()
+
+	oldStderr := os.Stderr
+	oldLogOutput := log.Writer()
+	os.Stderr = logFile
+	log.SetOutput(logFile)
+	defer func() {
+		os.Stderr = oldStderr
+		log.SetOutput(oldLogOutput)
+	}()
+
+	if _, err := LoadConfig(configPath); err != nil {
+		t.Fatalf("LoadConfig failed: %v", err)
+	}
+
+	if err := logFile.Sync(); err != nil {
+		t.Fatal(err)
+	}
+	output, err := os.ReadFile(logFile.Name())
+	if err != nil {
+		t.Fatal(err)
+	}
+	logged := string(output)
+
+	if strings.Contains(logged, secretValue) {
+		t.Errorf("environment override value was printed to stderr: %q", logged)
+	}
+	if !strings.Contains(logged, "NETWORK__NAME") {
+		t.Errorf("environment override name was not printed to stderr: %q", logged)
 	}
 }
