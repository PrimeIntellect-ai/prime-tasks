 import numpy as np
 import pytest
 
+# Compatibility shim: the production code still uses the ``np.int`` alias that
+# was removed in NumPy 1.24. Restore it for the duration of the test run so the
+# RANSAC workflow can be exercised on modern NumPy.
+if not hasattr(np, "int"):
+    np.int = int
+
 from pyprep.find_noisy_channels import NoisyChannels
 
 
+@pytest.mark.usefixtures("raw", "montage")
+def test_a_ransac_seeded_picks_match_matlab(raw, montage):
+    """Seeded RANSAC sampling should retain MATLAB-compatible behavior."""
+    raw_tmp = raw.copy()
+    raw_tmp.set_montage(montage)
+    n_channels, n_times = raw_tmp._data.shape
+    times = np.arange(n_times) / raw_tmp.info["sfreq"]
+    # Give a subset of channels a shared signal while making the remaining
+    # channels distinguishable, so different seeded interpolation samples can
+    # change the observable RANSAC classifications.
+    signals = np.array(
+        [
+            np.sin(2 * np.pi * 10 * times)
+            if channel < 20
+            else np.sin(2 * np.pi * (1 + channel % 15) * times + channel * 0.5)
+            for channel in range(n_channels)
+        ]
+    )
+    raw_tmp._data = signals * 1e-6
+
+    noisy = NoisyChannels(raw_tmp, do_detrend=False, random_state=30)
+    noisy.find_bad_by_ransac(
+        n_samples=8,
+        fraction_good=0.5,
+        corr_window_secs=1,
+        corr_thresh=0.75,
+        fraction_bad=0.4,
+    )
+
+    assert "FT7" in noisy.bad_by_ransac
+
+
