+def test_get_random_subset():
+    """Test the function for getting random channel subsets."""
+    from pyprep.utils import _get_random_subset
+    # Compare random subset equivalence with MATLAB
+    expected_picks = [6, 47, 55, 31, 29, 44, 36, 15]
+
+    # A Python list of items is a supported input type
+    rng = np.random.RandomState(435656)
+    actual_picks = _get_random_subset(list(range(1, 61)), size=8, rand_state=rng)
+    assert isinstance(actual_picks, list)
+    assert actual_picks == expected_picks
+
+    # A one-dimensional numpy array is also a supported input type
+    rng = np.random.RandomState(435656)
+    actual_picks = _get_random_subset(np.arange(1, 61), size=8, rand_state=rng)
+    assert isinstance(actual_picks, list)
+    assert actual_picks == expected_picks
+
+    # Items are sampled without replacement and drawn from the input
+    rng = np.random.RandomState(1234)
+    picks = _get_random_subset(list(range(1, 61)), size=8, rand_state=rng)
+    assert len(picks) == 8
+    assert len(set(picks)) == 8
+    assert all(pick in range(1, 61) for pick in picks)
