+def test_molecular_hamiltonian_leaves_random_seed_unchanged():
+    """Tests that ``molecular_hamiltonian`` does not reset the global numpy random seed."""
+
+    symbols = ["H", "H"]
+    coordinates = np.array([0.0, 0.0, -0.6614, 0.0, 0.0, 0.6614])
+
+    # Stream produced by the caller's seed.
+    np.random.seed(1234)
+    seeded_stream = np.random.rand(1000)
+
+    np.random.seed(1234)
+    qchem.molecular_hamiltonian(symbols, coordinates)
+    draws_after_call = np.random.rand(5)
+
+    # The draws after the call must still come from the caller's seeded stream
+    # (possibly advanced), rather than from a stream started by a different seed.
+    matches = [
+        np.array_equal(seeded_stream[i : i + 5], draws_after_call)
+        for i in range(len(seeded_stream) - 4)
+    ]
+    assert any(matches)
+
