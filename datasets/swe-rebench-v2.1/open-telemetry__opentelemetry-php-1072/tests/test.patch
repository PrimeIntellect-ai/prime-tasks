+    public function test_complex_attribute_values_remain_invalid_for_traces(): void
+    {
+        $previousLogger = LoggerHolder::get();
+        LoggerHolder::disable();
+        try {
+            $tracer = (new TracerProviderBuilder())->build()->getTracer('scope');
+            $span = $tracer->spanBuilder('span')->startSpan();
+            $span->setAttribute('heterogeneous', ['one', 2]);
+            $span->setAttribute('nested', ['outer' => ['inner' => 'value']]);
+            $span->setAttribute('valid', ['one', 'two']);
+            $span->end();
+
+            $attributes = $span->toSpanData()->getAttributes();
+            $this->assertNull($attributes->get('heterogeneous'));
+            $this->assertNull($attributes->get('nested'));
+            $this->assertSame(['one', 'two'], $attributes->get('valid'));
+        } finally {
+            LoggerHolder::set($previousLogger);
+        }
+    }
+
+    public function test_complex_attribute_values_remain_invalid_for_metrics(): void
+    {
+        $previousLogger = LoggerHolder::get();
+        LoggerHolder::disable();
+        try {
+            $exporter = new InMemoryExporter();
+            $reader = new ExportingReader($exporter);
+            $meterProvider = MeterProvider::builder()->addReader($reader)->build();
+            $counter = $meterProvider->getMeter('scope')->createCounter('counter');
+            $counter->add(1, [
+                'heterogeneous' => ['one', 2],
+                'nested' => ['outer' => ['inner' => 'value']],
+                'valid' => ['one', 'two'],
+            ]);
+
+            $reader->collect();
+            $dataPoint = iterator_to_array($exporter->collect()[0]->data->dataPoints)[0];
+            $this->assertSame(['valid' => ['one', 'two']], $dataPoint->attributes->toArray());
+        } finally {
+            LoggerHolder::set($previousLogger);
+        }
+    }
