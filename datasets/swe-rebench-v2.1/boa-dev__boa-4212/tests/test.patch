+/// Evaluates `source` and returns the resulting value together with its context.
+fn eval(source: &str) -> (Context, JsValue) {
+    let mut context = Context::default();
+    let value = context.eval(Source::from_bytes(source)).unwrap();
+    (context, value)
+}
+
+#[test]
+fn test_to_json_undefined_does_not_panic() {
+    let (mut context, value) = eval("undefined");
+    // Converting a top-level `undefined` value must complete without panicking.
+    let _result = value.to_json(&mut context).unwrap();
+}
+
+#[test]
+fn test_to_json_object_omits_undefined_property() {
+    let (mut context, value) = eval("({ foo: undefined, bar: 1 })");
+    let result = value.to_json(&mut context).unwrap();
+    assert_eq!(
+        serde_json::to_value(&result).unwrap(),
+        serde_json::json!({ "bar": 1 })
+    );
+}
+
+#[test]
+fn test_to_json_array_replaces_undefined_with_null() {
+    let (mut context, value) = eval("[1, 2, undefined, 4]");
+    let result = value.to_json(&mut context).unwrap();
+    assert_eq!(
+        serde_json::to_value(&result).unwrap(),
+        serde_json::json!([1, 2, null, 4])
+    );
+}
+
+#[test]
+fn test_to_json_nested_undefined() {
+    let (mut context, value) = eval(
+        "({ outer_a: 1, outer_b: undefined, outer_c: [2, undefined, 3, { inner_a: undefined }] })",
+    );
+    let result = value.to_json(&mut context).unwrap();
+    assert_eq!(
+        serde_json::to_value(&result).unwrap(),
+        serde_json::json!({
+            "outer_a": 1,
+            "outer_c": [2, null, 3, {}]
+        })
+    );
+}
