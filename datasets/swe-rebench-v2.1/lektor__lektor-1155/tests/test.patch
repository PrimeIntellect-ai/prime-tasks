+def test_bag_gets_site_from_jinja_context(
+    scratch_env: Environment, scratch_pad: Pad
+) -> None:
+    template = scratch_env.jinja_env.from_string("{{ bag('testbag.foo') }}")
+    assert template.render(site=scratch_pad) == "bar"
