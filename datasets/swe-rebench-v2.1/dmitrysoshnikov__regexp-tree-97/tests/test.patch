+
+'use strict';
+
+const optimizer = require('../../index');
+
+function splitAlternatives(expression) {
+  const alternatives = [];
+  let depth = 0;
+  let start = 0;
+  let escaped = false;
+
+  for (let i = 0; i < expression.length; i++) {
+    const character = expression[i];
+
+    if (escaped) {
+      escaped = false;
+    } else if (character === '\\') {
+      escaped = true;
+    } else if (character === '(') {
+      depth++;
+    } else if (character === ')') {
+      depth--;
+    } else if (character === '|' && depth === 0) {
+      alternatives.push(expression.slice(start, i));
+      start = i + 1;
+    }
+  }
+
+  alternatives.push(expression.slice(start));
+  return alternatives;
+}
+
+function canonicalizeDisjunctions(expression) {
+  const alternatives = splitAlternatives(expression).map(alternative => {
+    const prefix = alternative.startsWith('(?:') ? '(?:' : '(';
+    if (alternative[0] !== '(') {
+      return alternative;
+    }
+
+    let depth = 0;
+    let escaped = false;
+    for (let i = 0; i < alternative.length; i++) {
+      const character = alternative[i];
+      if (escaped) {
+        escaped = false;
+      } else if (character === '\\') {
+        escaped = true;
+      } else if (character === '(') {
+        depth++;
+      } else if (character === ')') {
+        depth--;
+        if (depth === 0 && i === alternative.length - 1) {
+          return prefix + canonicalizeDisjunctions(
+            alternative.slice(prefix.length, -1)
+          ) + ')';
+        }
+      }
+    }
+
+    return alternative;
+  });
+
+  return alternatives.sort().join('|');
+}
+
+function canonicalizedOutput(regexp) {
+  const output = regexp.toString();
+  return canonicalizeDisjunctions(output.slice(1, output.lastIndexOf('/')));
+}
+
+describe('optimizer removes duplicate disjunction alternatives', () => {
+
+  it('removes duplicates from disjunction', () => {
+    const re = optimizer.optimize(/ab|bc|ab/);
+    expect(canonicalizedOutput(re)).toBe(canonicalizeDisjunctions('ab|bc'));
+  });
+
+  it('removes duplicates without requiring a particular alternative order', () => {
+    const re = optimizer.optimize(/bc|bc|ab/);
+    expect(canonicalizedOutput(re)).toBe(canonicalizeDisjunctions('bc|ab'));
+  });
+
+  it('replaces disjunction containing only one part', () => {
+    const re = optimizer.optimize(/ab|ab/);
+    expect(re.toString()).toBe('/ab/');
+  });
+
+  it('does not merge capturing groups', () => {
+    const re = optimizer.optimize(/(ab)|(ab)/);
+    expect(re.toString()).toBe('/(ab)|(ab)/');
+  });
+
+  it('handles recursion', () => {
+    const re = optimizer.optimize(/(ab|bc|ab)|(bc|cd|bc)/);
+    expect(canonicalizedOutput(re)).toBe(
+      canonicalizeDisjunctions('(ab|bc)|(bc|cd)')
+    );
+
+    const re2 = optimizer.optimize(/(?:ab|bc|ab)|(?:ab|bc|ab)/);
+    expect(canonicalizedOutput(re2)).toBe(canonicalizeDisjunctions('(?:ab|bc)'));
+  });
+
+});
