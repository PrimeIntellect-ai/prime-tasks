+def test_content_policy_violation_propagates_from_json_adapter():
+    class TestSignature(dspy.Signature):
+        question: str = dspy.InputField()
+        answer: str = dspy.OutputField(desc="String output field")
+
+    program = dspy.Predict(TestSignature)
+
+    dspy.configure(lm=dspy.LM(model="openai/gpt-4o-mini", cache=False), adapter=dspy.JSONAdapter())
+
+    with mock.patch("litellm.completion") as mock_completion:
+        mock_completion.side_effect = litellm.ContentPolicyViolationError(
+            message="The response was filtered due to the prompt triggering Azure OpenAI's content management policy.",
+            model="azure/gpt-4o",
+            llm_provider="azure",
+        )
+
+        with pytest.raises(litellm.ContentPolicyViolationError) as error:
+            program(question="Dummy question!")
+
+        assert "content management policy" in str(error.value)
+
+
+@pytest.mark.asyncio
+async def test_content_policy_violation_propagates_from_json_adapter_async():
+    class TestSignature(dspy.Signature):
+        question: str = dspy.InputField()
+        answer: str = dspy.OutputField(desc="String output field")
+
+    program = dspy.Predict(TestSignature)
+
+    with mock.patch("litellm.acompletion") as mock_acompletion:
+        with dspy.context(lm=dspy.LM(model="openai/gpt-4o-mini", cache=False), adapter=dspy.JSONAdapter()):
+            mock_acompletion.side_effect = litellm.ContentPolicyViolationError(
+                message="The response was filtered due to the prompt triggering Azure OpenAI's content management policy.",
+                model="azure/gpt-4o",
+                llm_provider="azure",
+            )
+
+            with pytest.raises(litellm.ContentPolicyViolationError) as error:
+                await program.acall(question="Dummy question!")
+
+            assert "content management policy" in str(error.value)
