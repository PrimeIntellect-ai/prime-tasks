+def test_create_directory_true(tmp_path, monkeypatch):
+    """Task execution saves output into missing directories when requested."""
+    from pathlib import Path
+
+    monkeypatch.chdir(tmp_path)
+    output_path = Path("nested/output.txt")
+    task = Task(
+        description="Test task",
+        expected_output="Test output",
+        output_file=str(output_path),
+        create_directory=True,
+    )
+    agent = Agent(
+        role="Researcher",
+        goal="Complete the task",
+        backstory="A test agent",
+        allow_delegation=False,
+    )
+
+    with patch.object(Agent, "execute_task", return_value="test content"):
+        task.execute_sync(agent=agent)
+
+    assert output_path.is_file()
+    assert output_path.read_text() == "test content"
+
+
+def test_create_directory_false_with_missing_parent(tmp_path, monkeypatch):
+    """A disabled directory option leaves missing parents untouched."""
+    from pathlib import Path
+
+    monkeypatch.chdir(tmp_path)
+    output_path = Path("nested/output.txt")
+    task = Task(
+        description="Test task",
+        expected_output="Test output",
+        output_file=str(output_path),
+        create_directory=False,
+    )
+    agent = Agent(
+        role="Researcher",
+        goal="Complete the task",
+        backstory="A test agent",
+        allow_delegation=False,
+    )
+
+    with patch.object(Agent, "execute_task", return_value="test content"):
+        with pytest.raises(RuntimeError):
+            task.execute_sync(agent=agent)
+
+    assert not output_path.parent.exists()
+
+
