+import pandas as pd
+
+from feature_engine.preprocessing import MatchCategories
+
+
+def test_match_categories_encodes_object_and_category_columns():
+    df = pd.DataFrame(
+        {
+            "object_values": ["red", "blue", "red"],
+            "category_values": pd.Categorical(["small", "large", "small"]),
+            "numeric_values": [1, 2, 3],
+        }
+    )
+
+    result = MatchCategories().fit_transform(df)
+
+    assert result.columns.tolist() == df.columns.tolist()
+    assert len(result) == len(df)
+    assert isinstance(result["object_values"].dtype, pd.CategoricalDtype)
+    assert isinstance(result["category_values"].dtype, pd.CategoricalDtype)
+    assert result["numeric_values"].tolist() == df["numeric_values"].tolist()
+    assert result["object_values"].tolist() == df["object_values"].tolist()
+    assert result["category_values"].tolist() == df["category_values"].tolist()
+
+
+def test_transform_uses_levels_learned_during_fit():
+    train = pd.DataFrame({"color": ["red", "blue", "red"]})
+    later = pd.DataFrame({"color": ["blue"]})
+    transformer = MatchCategories().fit(train)
+
+    train_result = transformer.transform(train)
+    later_result = transformer.transform(later)
+
+    assert list(later_result["color"].cat.categories) == list(
+        train_result["color"].cat.categories
+    )
+    assert later_result["color"].iloc[0] == "blue"
