diff --git a/tests/testthat/test-browse.R b/tests/testthat/test-browse.R
index 4e8b5a6..eac8f19 100644
--- a/tests/testthat/test-browse.R
+++ b/tests/testthat/test-browse.R
@@ -46,8 +46,82 @@ test_that("browse_XXX() goes to correct URL", {
   expect_match(browse_github_pulls("gh"), g("r-lib/gh/pulls"))
   expect_equal(browse_github_pulls("gh", 1), g("r-lib/gh/pull/1"))
 
-  expect_equal(browse_travis("usethis"), "https://travis-ci.org/r-lib/usethis")
-  expect_equal(browse_travis("usethis", ext = "com"), "https://travis-ci.com/r-lib/usethis")
+  expect_equal(browse_travis("usethis"), "https://travis-ci.com/r-lib/usethis")
+  expect_equal(browse_travis(), "https://travis-ci.com/r-lib/usethis")
+  expect_equal(browse_travis("usethis", ext = "org"), "https://travis-ci.org/r-lib/usethis")
 
   expect_equal(browse_cran("usethis"), "https://cran.r-project.org/package=usethis")
 })
+
+test_that("use_travis() defaults to travis-ci.com", {
+  scoped_temporary_package()
+  use_git()
+  use_git_remote(name = "origin", url = "https://github.com/fake/fake")
+  browser_opened <- FALSE
+  withr::local_options(list(
+    usethis.quiet = TRUE,
+    browser = function(url, ...) browser_opened <<- TRUE
+  ))
+  use_readme_md()
+
+  use_travis(browse = FALSE)
+
+  expect_false(browser_opened)
+  readme <- readLines(proj_path("README.md"))
+  expect_true(any(grepl("travis-ci.com", readme, fixed = TRUE)))
+})
+
+test_that("use_travis_badge() defaults to travis-ci.com", {
+  scoped_temporary_package()
+  use_git()
+  use_git_remote(name = "origin", url = "https://github.com/fake/fake")
+  withr::local_options(list(usethis.quiet = TRUE))
+  use_readme_md()
+
+  use_travis_badge()
+
+  readme <- readLines(proj_path("README.md"))
+  expect_true(any(grepl("travis-ci.com", readme, fixed = TRUE)))
+})
+
+test_that("use_travis() honors the requested Travis host", {
+  scoped_temporary_package()
+  use_git()
+  use_git_remote(name = "origin", url = "https://github.com/fake/fake")
+  withr::local_options(list(usethis.quiet = TRUE))
+  use_readme_md()
+
+  use_travis(browse = FALSE, ext = "org")
+
+  readme <- readLines(proj_path("README.md"))
+  expect_true(any(grepl("travis-ci.org", readme, fixed = TRUE)))
+})
+
+test_that("use_travis_badge() honors the requested Travis host", {
+  scoped_temporary_package()
+  use_git()
+  use_git_remote(name = "origin", url = "https://github.com/fake/fake")
+  withr::local_options(list(usethis.quiet = TRUE))
+  use_readme_md()
+
+  use_travis_badge(ext = "org")
+
+  readme <- readLines(proj_path("README.md"))
+  expect_true(any(grepl("travis-ci.org", readme, fixed = TRUE)))
+})
+
+test_that("use_travis() opens a browser when requested", {
+  scoped_temporary_package()
+  use_git()
+  use_git_remote(name = "origin", url = "https://github.com/fake/fake")
+  browser_opened <- FALSE
+  withr::local_options(list(
+    usethis.quiet = TRUE,
+    browser = function(url, ...) browser_opened <<- TRUE
+  ))
+  use_readme_md()
+
+  use_travis(browse = TRUE)
+
+  expect_true(browser_opened)
+})
