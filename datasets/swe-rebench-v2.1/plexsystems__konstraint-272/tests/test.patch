+func TestCreateKindMatchersKeepAPIGroups(t *testing.T) {
+	policyDir := t.TempDir()
+	outputDir := t.TempDir()
+
+	policy := `# @title Kind groups
+#
+# @kinds core/Pod apps/Deployment apps/StatefulSet
+package kindgroups
+
+violation[msg] {
+msg := "denied"
+}
+`
+	if err := ioutil.WriteFile(filepath.Join(policyDir, "src.rego"), []byte(policy), 0600); err != nil {
+		t.Fatalf("write policy: %v", err)
+	}
+
+	cmd := newCreateCommand()
+	cmd.SetArgs([]string{policyDir, "--output", outputDir})
+	cmd.SilenceUsage = true
+	cmd.SilenceErrors = true
+	if err := cmd.Execute(); err != nil {
+		t.Fatalf("create: %v", err)
+	}
+
+	files, err := ioutil.ReadDir(outputDir)
+	if err != nil {
+		t.Fatalf("read output dir: %v", err)
+	}
+	var constraintBytes []byte
+	for _, f := range files {
+		if strings.HasPrefix(f.Name(), "constraint_") {
+			constraintBytes, err = ioutil.ReadFile(filepath.Join(outputDir, f.Name()))
+			if err != nil {
+				t.Fatalf("read constraint: %v", err)
+			}
+		}
+	}
+	if constraintBytes == nil {
+		t.Fatal("no constraint was generated")
+	}
+
+	var constraint struct {
+		Spec struct {
+			Match struct {
+				Kinds []struct {
+					APIGroups []string `json:"apiGroups"`
+					Kinds     []string `json:"kinds"`
+				} `json:"kinds"`
+			} `json:"match"`
+		} `json:"spec"`
+	}
+	if err := yaml.Unmarshal(constraintBytes, &constraint); err != nil {
+		t.Fatalf("unmarshal constraint: %v", err)
+	}
+
+	got := map[string][]string{}
+	for _, matcher := range constraint.Spec.Match.Kinds {
+		if len(matcher.APIGroups) != 1 {
+			t.Fatalf("expected each kinds matcher to target one apiGroup, got %v", matcher.APIGroups)
+		}
+		group := matcher.APIGroups[0]
+		if _, ok := got[group]; ok {
+			t.Errorf("apiGroup %q appears in more than one kinds matcher", group)
+		}
+		kinds := append([]string(nil), matcher.Kinds...)
+		sort.Strings(kinds)
+		got[group] = kinds
+	}
+
+	want := map[string][]string{
+		"":     {"Pod"},
+		"apps": {"Deployment", "StatefulSet"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("unexpected kinds matchers. want %v, got %v", want, got)
+	}
+}
