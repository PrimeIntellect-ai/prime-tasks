+    /**
+     * ReadYamlMapping returns the correct value for empty maps and sequences.
+     */
+    @Test
+    public void dontTurnEmptyMapsAndArraysIntoStrings() {
+        final List<YamlLine> lines = new ArrayList<>();
+        lines.add(new RtYamlLine("def: {}", 0));
+        lines.add(new RtYamlLine("ghi: []", 1));
+        final YamlMapping map = new ReadYamlMapping(new AllYamlLines(lines));
+        final YamlNode mapNode = map.value("def");
+        MatcherAssert.assertThat(mapNode, Matchers.instanceOf(YamlMapping.class));
+        MatcherAssert.assertThat(mapNode.asMapping().keys(), Matchers.empty());
+        final YamlNode sequenceNode = map.value("ghi");
+        MatcherAssert.assertThat(
+                sequenceNode, Matchers.instanceOf(YamlSequence.class)
+        );
+        MatcherAssert.assertThat(
+                sequenceNode.asSequence().values(), Matchers.empty()
+        );
+    }
