+// A deleting snapshot can outlive its class during E2E cleanup. Once the
+// controller releases its protection finalizers, the API server can remove it.
+func TestDeletingSnapshotIsRemovedWhenClassIsGone(t *testing.T) {
+	if err := snapshotscheme.AddToScheme(scheme.Scheme); err != nil {
+		t.Fatal(err)
+	}
+	className := "already-removed"
+	pvcName := "source-pvc"
+	snapshot := &crdv1.VolumeSnapshot{
+		ObjectMeta: metav1.ObjectMeta{
+			Name: "cleanup-snapshot", Namespace: "default", ResourceVersion: "1",
+			DeletionTimestamp: &metav1.Time{Time: time.Now()},
+			Finalizers:        []string{utils.VolumeSnapshotAsSourceFinalizer, utils.VolumeSnapshotBoundFinalizer},
+		},
+		Spec: crdv1.VolumeSnapshotSpec{
+			VolumeSnapshotClassName: &className,
+			Source:                  crdv1.VolumeSnapshotSource{PersistentVolumeClaimName: &pvcName},
+		},
+	}
+	client := snapshotfake.NewSimpleClientset(snapshot)
+	client.PrependReactor("update", "volumesnapshots", func(action clienttesting.Action) (bool, runtime.Object, error) {
+		updated := action.(clienttesting.UpdateAction).GetObject().(*crdv1.VolumeSnapshot)
+		if updated.DeletionTimestamp != nil && len(updated.Finalizers) == 0 {
+			if err := client.Tracker().Delete(action.GetResource(), action.GetNamespace(), updated.Name); err != nil {
+				return true, nil, err
+			}
+			return true, updated, nil
+		}
+		return false, nil, nil
+	})
+	kubeClient := kubefake.NewSimpleClientset()
+	snapshotFactory := snapshotinformers.NewSharedInformerFactory(client, 0)
+	kubeFactory := coreinformers.NewSharedInformerFactory(kubeClient, 0)
+	controller := commoncontroller.NewCSISnapshotCommonController(
+		client, kubeClient,
+		snapshotFactory.Snapshot().V1beta1().VolumeSnapshots(),
+		snapshotFactory.Snapshot().V1beta1().VolumeSnapshotContents(),
+		snapshotFactory.Snapshot().V1beta1().VolumeSnapshotClasses(),
+		kubeFactory.Core().V1().PersistentVolumeClaims(), time.Hour,
+	)
+	stop := make(chan struct{})
+	defer close(stop)
+	snapshotFactory.Start(stop)
+	kubeFactory.Start(stop)
+	go controller.Run(1, stop)
+
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		_, err := client.SnapshotV1beta1().VolumeSnapshots("default").Get(context.Background(), snapshot.Name, metav1.GetOptions{})
+		if apierrors.IsNotFound(err) {
+			return
+		}
+		if err != nil {
+			t.Fatalf("could not check snapshot cleanup: %v", err)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("VolumeSnapshot remained after cleanup while its VolumeSnapshotClass was absent")
+}
+
+type deletionObservingSnapshotter struct {
+	mu         sync.Mutex
+	deletedIDs []string
+}
+
+func (s *deletionObservingSnapshotter) CreateSnapshot(context.Context, string, string, map[string]string, map[string]string) (string, string, time.Time, int64, bool, error) {
+	return "", "", time.Time{}, 0, false, nil
+}
+
+func (s *deletionObservingSnapshotter) DeleteSnapshot(_ context.Context, id string, _ map[string]string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.deletedIDs = append(s.deletedIDs, id)
+	return nil
+}
+
+func (s *deletionObservingSnapshotter) deletedSnapshotIDs() []string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return append([]string(nil), s.deletedIDs...)
+}
+
+func (s *deletionObservingSnapshotter) GetSnapshotStatus(context.Context, string, map[string]string) (bool, time.Time, int64, error) {
+	return false, time.Time{}, 0, nil
+}
+
+// Missing class metadata must not prevent the backend snapshot and its
+// associated content from being cleaned up. Credentials may come from any
+// available source and repeated deletion attempts are safe.
+func TestContentDeletionContinuesWhenSnapshotClassIsMissing(t *testing.T) {
+	if err := snapshotscheme.AddToScheme(scheme.Scheme); err != nil {
+		t.Fatal(err)
+	}
+	content := newContentArrayWithDeletionTimestamp("content-missing-class", "snapshot-id", "snapshot-name", "snapshot-id", "deleted-class", "", "volume-handle", deletePolicy, nil, &defaultSize, true, &timeNowMetav1)[0]
+	client := snapshotfake.NewSimpleClientset(content)
+	kubeClient := kubefake.NewSimpleClientset()
+	factory := snapshotinformers.NewSharedInformerFactory(client, 0)
+	spy := &deletionObservingSnapshotter{}
+	ctrl := NewCSISnapshotSideCarController(
+		client, kubeClient, mockDriverName,
+		factory.Snapshot().V1beta1().VolumeSnapshotContents(),
+		factory.Snapshot().V1beta1().VolumeSnapshotClasses(), spy,
+		time.Second, time.Second, "snapshot", -1,
+	)
+	stop := make(chan struct{})
+	factory.Start(stop)
+	go ctrl.Run(1, stop)
+	defer close(stop)
+
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		deletedAssociatedSnapshot := false
+		for _, id := range spy.deletedSnapshotIDs() {
+			if id == "snapshot-id" {
+				deletedAssociatedSnapshot = true
+				break
+			}
+		}
+		updated, err := client.SnapshotV1beta1().VolumeSnapshotContents().Get(context.Background(), content.Name, metav1.GetOptions{})
+		if err != nil {
+			t.Fatalf("could not inspect content cleanup: %v", err)
+		}
+		protected := false
+		for _, finalizer := range updated.Finalizers {
+			if finalizer == utils.VolumeSnapshotContentFinalizer {
+				protected = true
+			}
+		}
+		if deletedAssociatedSnapshot && !protected {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("backend snapshot deletion and content protection release did not both complete")
+}
