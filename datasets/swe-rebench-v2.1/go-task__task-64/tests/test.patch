+func TestDynamicShellVariablePreservesNewlines(t *testing.T) {
+	dir, err := ioutil.TempDir("", "task-multiline-vars-")
+	assert.NoError(t, err)
+	if err != nil {
+		return
+	}
+	defer os.RemoveAll(dir)
+
+	taskfile := `default:
+  cmds:
+    - task: file
+      vars:
+        CONTENT:
+          sh: "printf 'foo\\nbar\\n'"
+        FILE: "with-trailing-newline.txt"
+    - task: file
+      vars:
+        CONTENT:
+          sh: "printf 'foo\\nbar'"
+        FILE: "without-trailing-newline.txt"
+file:
+  cmds:
+    - |
+      cat << EOF > '{{.FILE}}'
+      {{.CONTENT}}
+      EOF
+`
+	assert.NoError(t, ioutil.WriteFile(filepath.Join(dir, "Taskfile.yml"), []byte(taskfile), 0600))
+
+	tt := fileContentTest{
+		Dir:       dir,
+		Target:    "default",
+		TrimSpace: true,
+		Files: map[string]string{
+			"with-trailing-newline.txt":    "foo\nbar",
+			"without-trailing-newline.txt": "foo\nbar",
+		},
+	}
+	tt.Run(t)
+}
 
