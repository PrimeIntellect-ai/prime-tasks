+// Asserts that the aToken emitted no accounting events (Mint, or Transfer from the zero address) for `account`.
+const expectNoAccountingEvents = (rcpt: TransactionReceipt, aToken: AToken, account: string) => {
+  const found: string[] = [];
+  for (const log of rcpt.logs) {
+    if (log.address.toLowerCase() !== aToken.address.toLowerCase()) continue;
+    let parsed;
+    try {
+      parsed = aToken.interface.parseLog(log);
+    } catch {
+      continue;
+    }
+    if (parsed.name === 'Mint' && parsed.args.onBehalfOf.toLowerCase() === account.toLowerCase()) {
+      found.push('Mint');
+    }
+    if (
+      parsed.name === 'Transfer' &&
+      parsed.args.from.toLowerCase() === ZERO_ADDRESS.toLowerCase() &&
+      parsed.args.to.toLowerCase() === account.toLowerCase()
+    ) {
+      found.push('Transfer');
+    }
+  }
+  expect(found, `accounting events emitted for ${account} with zero balance increase`).to.be.empty;
+};
