+
+    expect(stats.hasErrors()).toBe(false);
+
+    const dom = new jsdom.JSDOM(
+      '<!doctype html><html><body><h1>Page</h1></body></html>',
+      {
+        runScripts: 'dangerously',
+      }
+    );
+    const rangeErrors = [];
+
+    dom.window.addEventListener('error', (event) => {
+      if (event.error && event.error.name === 'RangeError') {
+        rangeErrors.push(event.error);
+      }
+
+      event.preventDefault();
+    });
+
+    try {
+      try {
+        dom.window.eval(readAsset('main.bundle.js', compiler, stats));
+      } catch (error) {
+        if (error.name === 'RangeError') {
+          rangeErrors.push(error);
+        }
+      }
+
+      expect(rangeErrors).toHaveLength(0);
+    } finally {
+      dom.window.close();
+    }
