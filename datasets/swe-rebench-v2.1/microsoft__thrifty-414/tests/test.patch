+        if (!generatedKotlin.files.any { it.getText('UTF-8').contains('class Builder') }) {
+            throw new GradleException("--kt-struct-builders did not generate a Kotlin Builder")
+        }
+    }
 }
+kompileTestThrift.configure { dependsOn kompileDefaultKotlinStructs }
 
