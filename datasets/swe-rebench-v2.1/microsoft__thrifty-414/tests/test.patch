 }
 
 
+def kompileDefaultKotlinStructs = tasks.register("kompileDefaultKotlinStructs", JavaExec) { t ->
+    def defaultOutput = "$projectDir/build/generated-src/thrifty/kotlin-default"
+    t.inputs.file("$projectDir/ClientThriftTest.thrift")
+    t.outputs.dir(defaultOutput)
+
+    t.classpath shadowJar.archiveFile
+
+    args = [
+            "--out=$defaultOutput",
+            "--lang=kotlin",
+            "$projectDir/ClientThriftTest.thrift"
+    ]
+
+    outputs.upToDateWhen { false }
+    doLast {
+        def generatedKotlin = fileTree(defaultOutput) {
+            include '**/*.kt'
+        }
+        def bonkFile = generatedKotlin.files.find { it.getText('UTF-8').contains('data class Bonk') }
+        if (bonkFile == null) {
+            throw new GradleException("Default Kotlin compilation did not generate the expected struct")
+        }
+        def bonkSource = bonkFile.getText('UTF-8')
+        def bonkStart = bonkSource.indexOf('data class Bonk')
+        def bodyStart = bonkSource.indexOf('{', bonkStart)
+        def depth = 0
+        def bonkEnd = -1
+        for (int i = bodyStart; i < bonkSource.length(); i++) {
+            if (bonkSource.charAt(i) == '{') {
+                depth++
+            } else if (bonkSource.charAt(i) == '}') {
+                depth--
+                if (depth == 0) {
+                    bonkEnd = i + 1
+                    break
+                }
+            }
+        }
+        if (bonkEnd < 0 || bonkSource.substring(bonkStart, bonkEnd).contains('class Builder')) {
+            throw new GradleException("Default Kotlin struct Bonk unexpectedly generated a Builder")
+        }
+    }
+}
+
