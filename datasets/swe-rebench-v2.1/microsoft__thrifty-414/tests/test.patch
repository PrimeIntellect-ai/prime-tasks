+    private fun KotlinCodeGenerator.withDataClassBuilders(): KotlinCodeGenerator {
+        val method = KotlinCodeGenerator::class.java.getMethod("withDataClassBuilders")
+        return method.invoke(this) as KotlinCodeGenerator
+    }
