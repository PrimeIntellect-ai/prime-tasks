+
+#[cfg(test)]
+#[cfg(unix)]
+mod ssh_remote_regression {
+    use super::*;
+
+    #[test]
+    fn git_at_remote_uses_ssh_transport() {
+        let dir = tmp_dir().build();
+
+        let output = binary()
+            .arg("generate")
+            .arg("--git")
+            .arg("git@github.com:ashleygwilliams/wasm-pack-template.git")
+            .arg("--name")
+            .arg("foobar-project")
+            .current_dir(&dir.path())
+            .output()
+            .unwrap();
+
+        let combined = format!(
+            "{}{}",
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr)
+        );
+
+        // A `git@host:user/repo.git` remote must be handled as an SSH remote.
+        // The unfixed behaviour rewrites it into an HTTPS URL and fails with an
+        // HTTP error, which is what this guards against.
+        assert!(
+            output.status.success()
+                || (!combined.contains("class=Http")
+                    && !combined.contains("unexpected http status code")),
+            "the `git@host:user/repo.git` remote failed as an HTTP request:\n{}",
+            combined
+        );
+    }
+}
