+    @responses.activate
+    def test_get_product_by_barcode(self, grocy):
+        product_data = {
+            "id": 4,
+            "name": "Crisps",
+            "location_id": 4,
+            "product_group_id": 1,
+            "qu_id_stock": 3,
+            "qu_id_purchase": 3,
+            "qu_factor_purchase_to_stock": 1.0,
+            "row_created_timestamp": "2021-11-22 13:20:22",
+            "min_stock_amount": 10,
+            "default_best_before_days": 0,
+            "barcode": "42141099",
+            "product_barcodes": [{"barcode": "42141099"}],
+        }
+        details = {
+            "product": product_data,
+            "quantity_unit_stock": {
+                "id": 3,
+                "name": "Pack",
+                "name_plural": "Packs",
+                "row_created_timestamp": "2021-11-22 13:20:19",
+            },
+            "stock_amount": 5,
+            "stock_amount_opened": 0,
+            "product_barcodes": [{"barcode": "42141099"}],
+        }
+
+        def lookup_response(request):
+            request_path = request.url.split("?", 1)[0].rstrip("/")
+            if "/objects/product_barcodes" in request_path:
+                body = [{"id": 3, "product_id": 4, "barcode": "42141099"}]
+            elif request_path.endswith("/objects/products"):
+                body = [product_data]
+            else:
+                body = details
+            return 200, {"Content-Type": "application/json"}, json.dumps(body)
+
+        responses.add_callback(
+            responses.GET, re.compile(r".*/api/.*"), callback=lookup_response
+        )
+        product = grocy.product_by_barcode("42141099")
+
+        product_id = product if isinstance(product, int) else product.id
+        assert int(product_id) == 4
