diff --git a/frost-ed25519/tests/frost.rs b/frost-ed25519/tests/frost.rs
index a6ebcda..9c449fa 100644
--- a/frost-ed25519/tests/frost.rs
+++ b/frost-ed25519/tests/frost.rs
@@ -1,4 +1,3 @@
-use frost_core::{Ciphersuite, Group, GroupError};
 use frost_ed25519::*;
 
 use curve25519_dalek::{edwards::EdwardsPoint, traits::Identity};
@@ -85,3 +84,13 @@ fn check_deserialize_non_prime_order() {
     let r = <Ed25519Sha512 as Ciphersuite>::Group::deserialize(&encoded_point);
     assert_eq!(r, Err(GroupError::InvalidNonPrimeOrderElement));
 }
+
+#[test]
+fn check_rand_core_reexport() {
+    use frost_ed25519::rand_core::{CryptoRng, RngCore};
+
+    fn assert_rng<R: RngCore + CryptoRng>(_: &R) {}
+
+    let rng = thread_rng();
+    assert_rng(&rng);
+}
