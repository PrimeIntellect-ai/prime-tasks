     # fixme: is there any nontrivial showable test we can do?
     @test !showable("text/html", PyObject(1))
+    @testset "showable on type (#816)" begin
+        py"""
+        class Issue816(object):
+            def _repr_html_(self):
+                return "<h1>Issue816</h1>"
+
+        class PropertyRepr(object):
+            @property
+            def _repr_html_(self):
+                return "<h1>PropertyRepr</h1>"
+        """
+        # ordinary instances with a callable _repr_html_ remain showable
+        @test showable("text/html", py"Issue816()")
+        # class objects must not raise (the reported TypeError) and are
+        # not showable
+        @test !showable("text/html", py"Issue816")
+        # a property-valued _repr_html_ on a class must not raise either
+        @test !showable("text/html", py"PropertyRepr")
+    end
 
