+import pytest
+import numpy as np
+import pyfar as pf
+import numpy.testing as npt
+
+
+@pytest.mark.parametrize(
+    "operator",
+    (
+        "-",
+        "+",
+    ),
+)
+@pytest.mark.parametrize(
+    "order",
+    (
+        True,
+        False,
+    ),
+)
+def test_arithmetic_coordinates(operator, order):
+    coords = pf.Coordinates([0, 1], [0, 1], [0, 1])
+    other = pf.Coordinates([1, 1], [1, 1], [1, 1])
+    part1 = coords if order else other
+    part2 = other if order else coords
+    if operator == "+":
+        new = part1 + part2
+        desired = pf.Coordinates([1, 2], [1, 2], [1, 2])
+    else:
+        new = part1 - part2
+        if order:
+            desired = pf.Coordinates([-1, 0], [-1, 0], [-1, 0])
+        else:
+            desired = pf.Coordinates([1, 0], [1, 0], [1, 0])
+    assert isinstance(new, pf.Coordinates)
+    npt.assert_array_equal(new.cartesian, desired.cartesian)
+
+
+@pytest.mark.parametrize(
+    ("coords", "other", "n_points"),
+    (
+        (pf.Coordinates(1, 1, 1), pf.Coordinates(1, 1, 1), 1),
+        (
+            pf.Coordinates([1, 1], [1, 1], [1, 1]),
+            pf.Coordinates([1, 1], [1, 1], [1, 1]),
+            2,
+        ),
+    ),
+)
+def test_dot_product(coords, other, n_points):
+    dot = pf.dot(coords, other)
+    # each point contributes 1 + 1 + 1 = 3 to the total
+    npt.assert_array_equal(np.sum(dot), 3 * n_points)
+
+
+def test_cross_product():
+    coords_1 = pf.Coordinates(1, 0, 0)
+    coords_2 = pf.Coordinates(0, 1, 0)
+    cross = pf.cross(coords_1, coords_2)
+    if isinstance(cross, pf.Coordinates):
+        cartesian = cross.cartesian
+    else:
+        cartesian = cross
+    npt.assert_array_equal(np.reshape(cartesian, (-1, 3)), [[0, 0, 1]])
