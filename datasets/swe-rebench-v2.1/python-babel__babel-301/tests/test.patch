+def test_catalog_merge_files():
+    # Refs issues #92, #162
+    def make_translations(filename, message, translated):
+        if PY2:
+            # Use the pure-Python StringIO so it can carry a name attribute.
+            from StringIO import StringIO
+            fp = StringIO()
+        else:
+            fp = BytesIO()
+        catalog = Catalog()
+        catalog.add(message, translated)
+        write_mo(fp, catalog)
+        fp.seek(0)
+        fp.name = filename
+        return support.Translations(fp)
+
+    t1 = make_translations("one.mo", "foo", "bar")
+    t2 = make_translations("two.mo", "baz", "quux")
+    t1.merge(t2)
+    assert set(t1.files) == {"one.mo", "two.mo"}
+    assert t1.gettext("foo") == "bar"
+    assert t1.gettext("baz") == "quux"
