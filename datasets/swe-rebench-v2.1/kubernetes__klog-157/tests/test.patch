+// Test that InfoS formats Stringer values nested inside structs via String.
+func TestInfoSStringerSubfield(t *testing.T) {
+	setFlags()
+	defer logging.swap(logging.newBuffers())
+	logging.logFile = ""
+	logging.file[infoLog] = &flushBuffer{}
+
+	timestamp := time.Date(2006, 1, 2, 15, 4, 5, .067890e9, time.UTC)
+	InfoS("test", "status", struct {
+		When time.Time
+	}{When: timestamp})
+
+	got := contents(infoLog)
+	if !strings.Contains(got, timestamp.String()) {
+		t.Errorf("InfoS did not use the String representation of a nested Stringer value: %s", got)
+	}
+	if strings.Contains(got, "wall:") {
+		t.Errorf("InfoS exposed the internal representation of a nested Stringer value: %s", got)
+	}
+}
