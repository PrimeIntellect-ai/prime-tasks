+    def test_hook_generator(self):
+        """
+        Ensure that `attrs.fields` are correctly recorded when field_transformer is a generator
+
+        Regression test for #1417
+        """
+
+        def hook(cls, attribs):
+            yield from attribs
+
+        @attr.s(auto_attribs=True, field_transformer=hook)
+        class Base:
+            x: int
+
+        assert ["x"] == [a.name for a in attr.fields(Base)]
+
+    def test_hook_generator_with_inheritance(self):
+        """
+        A generator field_transformer that makes fields after the first one
+        keyword-only on a base class does not break subclass construction.
+
+        Regression test for #1417.
+        """
+
+        def hook(cls, attribs):
+            i = iter(attribs)
+            first = next(i)
+            yield first
+            for a in i:
+                yield a.evolve(kw_only=True)
+
+        @attr.s(auto_attribs=True, field_transformer=hook)
+        class Base:
+            dag_id: str
+            has_default: str = "default"
+
+        @attr.s(auto_attribs=True)
+        class Subclass(Base):
+            other: bool
+
+        x = Subclass(dag_id="foo", other=False)
+        assert "foo" == x.dag_id
+        assert "default" == x.has_default
+        assert False is x.other
+
 
