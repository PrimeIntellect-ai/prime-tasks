+
+test('client sends setupClient headers with every configured request', (t) => {
+  t.plan(1)
+
+  const requestServer = helper.startServer()
+  const observed = []
+  requestServer.on('request', req => {
+    observed.push({ path: req.url, header: req.headers['x-shared-token'] })
+  })
+
+  const opts = requestServer.address()
+  opts.requests = [
+    { path: '/first', setupRequest: req => req },
+    { path: '/second', setupRequest: req => req }
+  ]
+  opts.setupClient = client => client.setHeaders({ 'X-Shared-Token': 'shared-value' })
+
+  const client = new Client(opts)
+  client.on('response', () => {
+    if (observed.length === 2) {
+      t.same(observed, [
+        { path: '/first', header: 'shared-value' },
+        { path: '/second', header: 'shared-value' }
+      ], 'the configured header is present on each request')
+      client.destroy()
+      requestServer.close()
+    }
+  })
+})
