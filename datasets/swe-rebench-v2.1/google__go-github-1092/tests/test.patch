+
+// projectCardAccessor is the public accessor contract for Timeline.ProjectCard.
+type projectCardAccessor interface {
+	GetProjectCard() *ProjectCard
+}
+
+func TestTimeline_GetProjectCard(t *testing.T) {
+	// A Timeline must expose GetProjectCard() *ProjectCard.
+	if _, ok := interface{}(&Timeline{}).(projectCardAccessor); !ok {
+		t.Fatalf("Timeline does not implement GetProjectCard() *ProjectCard")
+	}
+
+	// A populated project_card is returned.
+	populated := &Timeline{}
+	if err := json.Unmarshal([]byte(`{"project_card":{"id":1}}`), populated); err != nil {
+		t.Fatalf("unmarshaling timeline: %v", err)
+	}
+	got := interface{}(populated).(projectCardAccessor).GetProjectCard()
+	if got == nil {
+		t.Fatalf("Timeline.GetProjectCard = nil, want populated ProjectCard")
+	}
+	if got.GetID() != 1 {
+		t.Errorf("Timeline.GetProjectCard ID = %v, want 1", got.GetID())
+	}
+
+	// A nil receiver returns nil.
+	var nilTimeline *Timeline
+	if got := interface{}(nilTimeline).(projectCardAccessor).GetProjectCard(); got != nil {
+		t.Errorf("Timeline.GetProjectCard on nil receiver = %+v, want nil", got)
+	}
+
+	// An absent field returns nil.
+	if got := interface{}(&Timeline{}).(projectCardAccessor).GetProjectCard(); got != nil {
+		t.Errorf("Timeline.GetProjectCard with absent field = %+v, want nil", got)
 	}
 }
