+function isRunningProcess(pid) {
+	if (process.platform === 'linux') {
+		try {
+			const stat = fs.readFileSync(`/proc/${pid}/stat`, 'utf8');
+			const state = stat.slice(stat.lastIndexOf(')') + 2, stat.lastIndexOf(')') + 3);
+			return state !== 'Z';
+		} catch (error) {
+			return false;
+		}
+	}
+
+	return isRunning(pid);
+}
