+@pytest.mark.parametrize('value, expected', [
+    (1.2, 2),
+    (-1.2, -1),
+    (3.0, 3),
+])
+def test_math_ceil(value, expected):
+    result = compatibility.math_ceil(value)
+    assert result == expected
+    assert isinstance(result, int)
+
+
+def test_parse_memory():
+    mib = 2 ** 20
+    assert model.parse_memory(100) == 100
+    assert model.parse_memory(5.4) == 6
+    assert model.parse_memory('100') == 100
+    assert model.parse_memory('100 MiB') == 100
+    assert model.parse_memory('100 MB') == compatibility.math_ceil(100 * 1e6 / mib)
+    assert model.parse_memory('100M') == compatibility.math_ceil(100 * 1e6 / mib)
+    assert model.parse_memory('100Mi') == 100
+    assert model.parse_memory('5kB') == 1
+    assert model.parse_memory('5.4 MiB') == 6
+    assert model.parse_memory('0.9 MiB') == 1
+    assert model.parse_memory('1e3') == 1000
+    assert model.parse_memory('1e6 kB') == compatibility.math_ceil(1e6 * 1e3 / mib)
+
+    with pytest.raises(ValueError):
+        model.parse_memory('5 foos')
+
+    with pytest.raises(ValueError):
+        model.parse_memory('')
+
+    with pytest.raises(ValueError):
+        model.parse_memory('1.1.1GB')
+
+    with pytest.raises(ValueError):
+        model.parse_memory(-1)
+
+    with pytest.raises(ValueError):
+        model.parse_memory('-1.5 MiB')
+
+    with pytest.raises(TypeError):
+        model.parse_memory([])
+
