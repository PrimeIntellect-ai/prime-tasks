+func sameExprIgnoringListCount(a, b expr) bool {
+	switch a := a.(type) {
+	case *listExpr:
+		b, ok := b.(*listExpr)
+		if !ok || len(a.exprs) != len(b.exprs) {
+			return false
+		}
+		for i := range a.exprs {
+			if !sameExprIgnoringListCount(a.exprs[i], b.exprs[i]) {
+				return false
+			}
+		}
+		return true
+	case *mapExpr:
+		b, ok := b.(*mapExpr)
+		return ok && a.keys == b.keys && sameExprIgnoringListCount(a.expr, b.expr)
+	case *cmdExpr:
+		b, ok := b.(*cmdExpr)
+		return ok && a.name == b.name && sameExprIgnoringListCount(a.expr, b.expr)
+	default:
+		return reflect.DeepEqual(a, b)
+	}
+}
+
+func dispatchSpaceCount(t *testing.T, count int) (*nav, []string) {
+	t.Helper()
+
+	dirPath, err := ioutil.TempDir("", "lf-space-count-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dirPath)
+	for _, name := range []string{"a", "b", "c", "d", "e"} {
+		file, err := os.Create(filepath.Join(dirPath, name))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := file.Close(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	directory := newDir(dirPath)
+	directory.sort()
+	nav := &nav{
+		dirs:       []*dir{directory},
+		height:     10,
+		selections: make(map[string]int),
+	}
+	app := &app{nav: nav, ui: &ui{}}
+	keyUI := &ui{}
+	ch := make(chan expr, 8)
+
+	oldPreview, oldWrapscroll := gOpts.preview, gOpts.wrapscroll
+	defer func() {
+		gOpts.preview, gOpts.wrapscroll = oldPreview, oldWrapscroll
+	}()
+	gOpts.preview = false
+	gOpts.wrapscroll = false
+
+	if count < 0 {
+		keyUI.keyCount = []rune(strconv.Itoa(count))
+	} else {
+		for _, digit := range strconv.Itoa(count) {
+			keyUI.readEvent(ch, termbox.Event{Type: termbox.EventKey, Ch: digit})
+			<-ch // The incomplete key sequence requests a redraw.
+		}
+	}
+	keyUI.readEvent(ch, termbox.Event{Type: termbox.EventKey, Key: termbox.KeySpace})
+	for len(ch) > 0 {
+		(<-ch).eval(app, nil)
+	}
+
+	paths := make([]string, len(directory.files))
+	for i, file := range directory.files {
+		paths[i] = file.path
+	}
+	return nav, paths
+}
+
+func TestSpacePrefixCountDispatch(t *testing.T) {
+	nav, paths := dispatchSpaceCount(t, 3)
+	if nav.currDir().ind != 3 {
+		t.Fatalf("three space presses should advance to file 4; cursor index is %d", nav.currDir().ind)
+	}
+	if len(nav.selections) != 3 {
+		t.Fatalf("three space presses should select three files; got %d", len(nav.selections))
+	}
+	for _, path := range paths[:3] {
+		if _, ok := nav.selections[path]; !ok {
+			t.Errorf("space prefix did not select %q", path)
+		}
+	}
+}
+
+func TestNonpositiveSpacePrefixCountDispatch(t *testing.T) {
+	for _, count := range []int{0, -2} {
+		t.Run(strconv.Itoa(count), func(t *testing.T) {
+			nav, _ := dispatchSpaceCount(t, count)
+			if nav.currDir().ind != 0 || len(nav.selections) != 0 {
+				t.Errorf("space prefix %d should do nothing; cursor index is %d and %d files are selected", count, nav.currDir().ind, len(nav.selections))
+			}
+		})
+	}
+}
