+def test_pop_removes_returned_elements(language):
+    def pop_and_measure():
+        se = {2, 4, 9}
+        el1 = se.pop()
+        len1 = len(se)
+        el2 = se.pop()
+        len2 = len(se)
+        el3 = se.pop()
+        return el1, el2, el3, len1, len2, len(se)
+
+    compiled = epyccel(pop_and_measure, language=language)
+    result = compiled()
+    assert result[3:6] == (2, 1, 0)
+    assert len(set(result[:3])) == 3
