+func TestAppDeletesMultipleSelectedStacks(t *testing.T) {
+	deleted := map[string]bool{}
+	postDeleteDescribeCalls := map[string]int{}
+	var mu sync.Mutex
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if err := r.ParseForm(); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		switch r.Form.Get("Action") {
+		case "DescribeStacks":
+			name := r.Form.Get("StackName")
+			mu.Lock()
+			isDeleted := deleted[name]
+			if isDeleted {
+				postDeleteDescribeCalls[name]++
+			}
+			postDeleteCall := postDeleteDescribeCalls[name]
+			mu.Unlock()
+
+			stackXML := ""
+			if name != "" && !isDeleted {
+				stackXML = fmt.Sprintf(`<member><StackName>%s</StackName><StackStatus>CREATE_COMPLETE</StackStatus><CreationTime>2024-01-01T00:00:00Z</CreationTime><EnableTerminationProtection>false</EnableTerminationProtection></member>`, name)
+			} else if name != "" && postDeleteCall == 1 {
+				stackXML = fmt.Sprintf(`<member><StackName>%s</StackName><StackStatus>DELETE_COMPLETE</StackStatus></member>`, name)
+			}
+			_, _ = fmt.Fprintf(w, `<?xml version="1.0"?><DescribeStacksResponse xmlns="http://cloudformation.amazonaws.com/doc/2010-05-15/"><DescribeStacksResult><Stacks>%s</Stacks></DescribeStacksResult><ResponseMetadata><RequestId>test</RequestId></ResponseMetadata></DescribeStacksResponse>`, stackXML)
+		case "DeleteStack":
+			name := r.Form.Get("StackName")
+			mu.Lock()
+			deleted[name] = true
+			mu.Unlock()
+			_, _ = fmt.Fprint(w, `<?xml version="1.0"?><DeleteStackResponse xmlns="http://cloudformation.amazonaws.com/doc/2010-05-15/"><DeleteStackResult/><ResponseMetadata><RequestId>test</RequestId></ResponseMetadata></DeleteStackResponse>`)
+		default:
+			http.Error(w, "unexpected CloudFormation action: "+r.Form.Get("Action"), http.StatusBadRequest)
+		}
+	}))
+	defer server.Close()
+
+	cmd := osexec.Command("go", "run", "../../cmd/delstack", "--region", "us-east-1", "--stackName", "StackOne", "--stackName", "StackTwo")
+	cmd.Env = append(os.Environ(),
+		"AWS_ACCESS_KEY_ID=test-access-key",
+		"AWS_SECRET_ACCESS_KEY=test-secret-key",
+		"AWS_EC2_METADATA_DISABLED=true",
+		"AWS_ENDPOINT_URL_CLOUDFORMATION="+server.URL,
+		"AWS_ENDPOINT_URL="+server.URL,
+	)
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("CLI failed: %v\n%s", err, output)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	for _, name := range []string{"StackOne", "StackTwo"} {
+		if !deleted[name] {
+			t.Errorf("expected a deletion request for %s; CLI output: %s", name, output)
+		}
+	}
+}
