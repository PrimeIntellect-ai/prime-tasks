+func TestClientLogStackSkip(t *testing.T) {
+	client := testClient()
+	client.Log(ERR, errors.New("logged error"), 1)
+	transport, ok := client.Transport.(*TestTransport)
+	if !ok {
+		t.Fatal("expected TestTransport")
+	}
+	body := transport.Body
+	if body["data"] == nil {
+		t.Fatal("body should have data")
+	}
+	data := body["data"].(map[string]interface{})
+	if data["level"] != ERR {
+		t.Errorf("expected level %q, got %v", ERR, data["level"])
+	}
+	dataError := errorFromData(data)
+	if dataError["message"] != "logged error" {
+		t.Errorf("expected error message %q, got %v", "logged error", dataError["message"])
+	}
+	client.Close()
+
+	framesForSkip := func(skip int) int {
+		c := testClient()
+		c.Log(ERR, errors.New("logged error"), skip)
+		tr := c.Transport.(*TestTransport)
+		d := tr.Body["data"].(map[string]interface{})
+		b := d["body"].(map[string]interface{})
+		traceChain := b["trace_chain"].([]map[string]interface{})
+		frames := reflect.ValueOf(traceChain[0]["frames"])
+		c.Close()
+		return frames.Len()
+	}
+	small := framesForSkip(0)
+	large := framesForSkip(1000)
+	if small <= large {
+		t.Errorf("expected more stack frames with skip=0 than skip=1000, got %d and %d", small, large)
+	}
+}
