+  describe('Deprecated decorator', () => {
+    it('is a usable method decorator', () => {
+      // Loaded at runtime so that a missing module fails only this test.
+      // tslint:disable-next-line:no-var-requires
+      const { Deprecated } = require('../../../../src/decorators/deprecated');
+      class Sample {
+        public method(): void {
+          return;
