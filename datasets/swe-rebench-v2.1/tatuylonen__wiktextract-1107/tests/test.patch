+    def _ignore_unspecified_plural(self, expected, actual):
+        """Ignore the "plural" tag when comparing inflection output.
+
+        The public contract does not specify whether English third-person
+        forms carry a "plural" tag, so tests must accept implementations
+        that do or do not add it.
+        """
+        for data in (expected, actual):
+            for form in data["forms"]:
+                if "tags" in form:
+                    form["tags"] = [
+                        t for t in form["tags"] if t != "plural"
+                    ]
+        return actual
+
