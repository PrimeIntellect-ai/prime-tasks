+    def test_Ancient_Greek_noun_articles(self):
+        ret = self.xinfl(
+            "ἰχθυοκένταυρος",
+            "Ancient Greek",
+            "noun",
+            "Declension",
+            """
+<div class="NavFrame">
+<div class="NavHead">declension of ἰχθυοκένταυρος</div>
+<div class="NavContent">
+{| class="inflection-table"
+|-
+!
+! singular
+! dual
+! plural
+|-
+! nominative
+| ὁ, ἡ ἰχθυοκένταυρος
+| τὼ ἰχθυοκενταύρω
+| οἱ, αἱ ἰχθυοκένταυροι
+|-
+! genitive
+| τοῦ, τῆς ἰχθυοκενταύρου
+| τοῖν ἰχθυοκενταύροιν
+| τῶν ἰχθυοκενταύρων
+|-
+! dative
+| τῷ, τῇ ἰχθυοκενταύρῳ
+| τοῖν ἰχθυοκενταύροιν
+| τοῖς, ταῖς ἰχθυοκενταύροις
+|-
+! accusative
+| τὸν, τὴν ἰχθυοκένταυρον
+| τὼ ἰχθυοκενταύρω
+| τοὺς, τᾱ̀ς ἰχθυοκενταύρους
+|-
+! vocative
+| ἰχθυοκένταυρε
+| τὼ ἰχθυοκενταύρω
+| οἱ, αἱ ἰχθυοκένταυροι
+|-
+|}
+</div></div>
+""",
+        )
+        forms = [f["form"] for f in ret["forms"]]
+        # A comma-separated article must not be emitted as a separate form.
+        self.assertNotIn("ὁ", forms)
+        self.assertNotIn("οἱ", forms)
+        # The article is stripped from the form.
+        self.assertIn("ἰχθυοκένταυρος", forms)
+        self.assertIn("ἰχθυοκένταυροι", forms)
