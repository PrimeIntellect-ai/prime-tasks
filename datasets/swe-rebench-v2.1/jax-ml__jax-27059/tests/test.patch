+  def test_disable_jit_while_loop_with_mutation(self):
+    # Regression test for https://github.com/jax-ml/jax/issues/27019
+    # expi is implemented in terms of a while_loop whose carry is mutated in
+    # place; with jit disabled this must still produce the correct value.
+    for value in [-1.0, -0.9, -0.75, -0.5, -0.25, -0.1, -1e-3]:
+      x = jnp.array([value])
+      with jax.disable_jit(True):
+        result_nojit = jsp.special.expi(x)
+      with jax.disable_jit(False):
+        result_jit = jsp.special.expi(x)
+      self.assertAllClose(result_jit, result_nojit)
