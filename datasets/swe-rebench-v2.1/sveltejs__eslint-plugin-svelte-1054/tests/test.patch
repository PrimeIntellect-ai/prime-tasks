+import { RuleTester } from '../../utils/eslint-compat.js';
+import plugin from '../../../src/index.js';
+import { loadTestCases } from '../../utils/utils.js';
+
+const tester = new RuleTester({
+	languageOptions: {
+		ecmaVersion: 2020,
+		sourceType: 'module'
+	}
+});
+
+const testCases = loadTestCases('valid-style-parse');
+testCases.invalid = testCases.invalid.map((testCase) => ({ ...testCase, errors: 1 }));
+tester.run('valid-style-parse', plugin.rules['valid-style-parse'] as any, testCases);
