 const expect = chai.expect;
 
+// Collects DependsOn references that point to resources which are not part of the
+// given template. CloudFormation rejects such templates with
+// "Unresolved resource dependencies [...] in the Resources block of the template".
+function findUnresolvedDependsOn(template) {
+	const resources = _.get(template, 'Resources', {});
+	const unresolved = [];
+	_.forOwn(resources, (resource, name) => {
+		const deps = _.isArray(resource.DependsOn) ? resource.DependsOn :
+			(_.isString(resource.DependsOn) ? [ resource.DependsOn ] : []);
+		_.forEach(deps, dep => {
+			if (!_.has(resources, dep)) {
+				unresolved.push(`${name} -> ${dep}`);
+			}
+		});
+	});
+	return unresolved;
+}
