index 0000000..3a8df27
--- /dev/null
+++ b/csml_interpreter/tests/goto_vars.rs
@@ -0,0 +1,72 @@
+mod support;
+
+use csml_interpreter::data::context::Context;
+use csml_interpreter::data::csml_bot::CsmlBot;
+use csml_interpreter::data::csml_flow::CsmlFlow;
+use csml_interpreter::data::event::Event;
+use csml_interpreter::interpret;
+use std::collections::HashMap;
+
+use crate::support::tools::format_message;
+use crate::support::tools::message_to_json_value;
+
+use serde_json::Value;
+
+#[test]
+fn dotted_variable_resolves_step_destination() {
+    let msg = format_message(
+        Event::new("payload", "", serde_json::json!({})),
+        Context::new(HashMap::new(), HashMap::new(), None, None, "start", "flow"),
+        "CSML/basic_test/goto_vars.csml",
+    );
+
+    let actual: Value = message_to_json_value(msg);
+    assert_eq!(actual["messages"][0]["content"]["text"].as_str(), Some("OK"));
+}
+
+
+#[test]
+fn dotted_variable_resolves_flow_destination() {
+    let start = r#"
+start:
+    do destination = {
+        "name": "target"
+    }
+    goto flow $destination.name
+"#;
+    let target = r#"
+start:
+    say "FLOW DESTINATION"
+"#;
+    let fallback = r#"
+start:
+    say "WRONG FLOW"
+"#;
+    let bot = CsmlBot::new(
+        "id",
+        "bot",
+        None,
+        vec![
+            CsmlFlow::new("id", "default", start, Vec::default()),
+            CsmlFlow::new("id", "target", target, Vec::default()),
+            CsmlFlow::new("id", "fallback", fallback, Vec::default()),
+        ],
+        None,
+        None,
+        "default",
+        None,
+        None,
+    );
+    let message = interpret(
+        bot,
+        Context::new(HashMap::new(), HashMap::new(), None, None, "start", "default"),
+        Event::new("payload", "", serde_json::json!({})),
+        None,
+    );
+
+    let actual: Value = message_to_json_value(message);
+    assert_eq!(
+        actual["messages"][0]["content"]["text"].as_str(),
+        Some("FLOW DESTINATION")
+    );
+}
