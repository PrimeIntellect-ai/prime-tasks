@@ -413,6 +413,18 @@ final class UT_SpyFactory: XCTestCase {
     )
   }
 
+  func testDeclarationForcedUnwrappedVariable() throws {
+    let protocolDeclaration = try ProtocolDeclSyntax("""
+      protocol ServiceProtocol {
+          var data: String! { get set }
+      }
+      """)
+    let result = try SpyFactory().classDeclaration(for: protocolDeclaration)
+
+    XCTAssertTrue(hasOptionalStringProperty(named: "data", in: Syntax(result)))
+    XCTAssertFalse(containsNestedIUO(Syntax(result)))
+  }
+
   func testDeclarationExistentialVariable() throws {
     try assertProtocol(
       withDeclaration: """
@@ -505,3 +517,37 @@ final class UT_SpyFactory: XCTestCase {
     assertBuildResult(result, expectedDeclaration, file: file, line: line)
   }
 }
+
+private func hasOptionalStringProperty(named name: String, in syntax: Syntax) -> Bool {
+  if let declaration = syntax.as(VariableDeclSyntax.self) {
+    return declaration.bindings.contains { binding in
+      guard
+        binding.pattern.as(IdentifierPatternSyntax.self)?.identifier.text == name,
+        let type = binding.typeAnnotation?.type
+      else {
+        return false
+      }
+
+      if let optional = type.as(OptionalTypeSyntax.self) {
+        return optional.wrappedType.trimmedDescription == "String"
+      }
+      if let iuo = type.as(ImplicitlyUnwrappedOptionalTypeSyntax.self) {
+        return iuo.wrappedType.trimmedDescription == "String"
+      }
+      return false
+    }
+  }
+
+  return syntax.children(viewMode: .all).contains { hasOptionalStringProperty(named: name, in: $0) }
+}
+
+private func containsNestedIUO(_ syntax: Syntax, insideIUO: Bool = false) -> Bool {
+  let isIUO = syntax.is(ImplicitlyUnwrappedOptionalTypeSyntax.self)
+  if insideIUO && isIUO {
+    return true
+  }
+
+  return syntax.children(viewMode: .all).contains {
+    containsNestedIUO($0, insideIUO: insideIUO || isIUO)
+  }
+}
