+    public function test_nested_lazy_props_in_a_selected_list_are_resolved(): void
+    {
+        $request = Request::create('/foos', 'GET');
+        $request->headers->add(['X-Inertia' => 'true']);
+        $request->headers->add(['X-Inertia-Partial-Component' => 'Foos']);
+        $request->headers->add(['X-Inertia-Partial-Data' => 'foos']);
+
+        $response = new Response('Foos', [
+            'foos' => [
+                ['bar' => new LazyProp(function () {
+                    return 'Test';
+                })],
+            ],
+        ]);
+        $response = $response->toResponse($request);
+        $page = $response->getData();
+
+        $this->assertSame('Test', $page->props->foos[0]->bar);
+    }
