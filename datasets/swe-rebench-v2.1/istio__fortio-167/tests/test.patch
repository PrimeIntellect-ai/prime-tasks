+func TestUITriggeredRunsDoNotLeakConnections(t *testing.T) {
+	if _, err := os.Stat("/proc/self/fd"); err != nil {
+		t.Skip("process file descriptors are not available on this platform")
+	}
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := listener.Addr().(*net.TCPAddr).Port
+	if err := listener.Close(); err != nil {
+		t.Fatal(err)
+	}
+	serverPort := fmt.Sprintf("%d", port)
+	executable := filepath.Join(t.TempDir(), "fortio-server")
+	build := exec.Command("go", "build", "-a", "-mod=mod", "-o", executable, "..")
+	if output, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("building server: %v\n%s", err, output)
+	}
+	server := exec.Command(executable, "server", "-http-port="+serverPort, "-grpc-port=127.0.0.1:0",
+		"-redirect-port=disabled", "-ui-path=/fortio/", "-quiet", "-data-dir="+t.TempDir())
+	server.Env = []string{}
+	for _, env := range os.Environ() {
+		if !strings.HasPrefix(env, "GOGC=") {
+			server.Env = append(server.Env, env)
+		}
+	}
+	server.Env = append(server.Env, "GOGC=off")
+	if err := server.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		_ = server.Process.Kill()
+		_ = server.Wait()
+	}()
+	base := fmt.Sprintf("http://localhost:%d", port)
+	ready := false
+	for until := time.Now().Add(10 * time.Second); time.Now().Before(until); {
+		resp, err := http.Get(base + "/debug")
+		if err == nil {
+			_ = resp.Body.Close()
+			ready = true
+			break
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	if !ready {
+		t.Fatal("UI server did not become ready")
+	}
+	client := &http.Client{Timeout: 10 * time.Second, Transport: &http.Transport{DisableKeepAlives: true}}
+	requestURL := fmt.Sprintf("%s/fortio/fetch/localhost:%d/fortio/?url=%s/debug&load=Start&qps=-1&n=2&json=on", base, port, base)
+	goroutineCount := func() int {
+		resp, err := client.Get(base + "/debug/pprof/goroutine?debug=2")
+		if err != nil {
+			t.Fatalf("reading server goroutine profile: %v", err)
+		}
+		profile, err := io.ReadAll(resp.Body)
+		_ = resp.Body.Close()
+		if err != nil || resp.StatusCode != http.StatusOK {
+			t.Fatalf("reading server goroutine profile: status %d, error %v", resp.StatusCode, err)
+		}
+		return strings.Count(string(profile), "goroutine ")
+	}
+	runUI := func(run int) {
+		resp, err := client.Get(requestURL)
+		if err != nil {
+			t.Fatalf("UI run %d: %v", run+1, err)
+		}
+		body, readErr := io.ReadAll(resp.Body)
+		_ = resp.Body.Close()
+		if readErr != nil {
+			t.Fatalf("reading UI run %d: %v", run+1, readErr)
+		}
+		if resp.StatusCode != http.StatusOK || !strings.Contains(string(body), `"200"`) {
+			t.Fatalf("UI run %d did not report successful requests (status %d): %s", run+1, resp.StatusCode, body)
+		}
+	}
+	// Warm up first, then measure growth over the later runs.
+	const warmupRuns = 3
+	const measuredRuns = 15
+	for run := 0; run < warmupRuns; run++ {
+		runUI(run)
+	}
+	time.Sleep(200 * time.Millisecond)
+	goRoutinesBefore := goroutineCount()
+	fdBefore := countProcessFds(server.Process.Pid)
+	for run := warmupRuns; run < warmupRuns+measuredRuns; run++ {
+		runUI(run)
+	}
+	time.Sleep(200 * time.Millisecond)
+	fdAfter := countProcessFds(server.Process.Pid)
+	t.Logf("server descriptors before/after UI runs: %d/%d", fdBefore, fdAfter)
+	if fdBefore >= 0 && fdAfter > fdBefore+20 {
+		t.Errorf("server descriptors after repeated UI runs %d, expected near %d", fdAfter, fdBefore)
+	}
+	goRoutinesAfter := goroutineCount()
+	t.Logf("server goroutines before/after UI runs: %d/%d", goRoutinesBefore, goRoutinesAfter)
+	if goRoutinesAfter > goRoutinesBefore+10 {
+		t.Errorf("server goroutines after repeated UI runs %d, expected near %d", goRoutinesAfter, goRoutinesBefore)
+	}
+}
+
+func TestHttpNotLeakingFastClient(t *testing.T) {
+	testHTTPNotLeaking(t, &HTTPRunnerOptions{})
+}
+
+func TestHttpNotLeakingStdClient(t *testing.T) {
+	testHTTPNotLeaking(t, &HTTPRunnerOptions{HTTPOptions: HTTPOptions{DisableFastClient: true}})
+}
