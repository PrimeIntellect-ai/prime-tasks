+// countOpenFds returns the number of file descriptors currently open by the
+// process, or -1 when that information is not available on this platform.
+func countOpenFds() int {
+	entries, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		return -1
+	}
+	return len(entries)
+}
+
+func testHTTPNotLeaking(t *testing.T, opts *HTTPRunnerOptions) {
+	// Like the UI server (GOGC=off), keep finalizers from silently closing sockets
+	// that a client failed to release: the test must see such leaks itself.
+	defer debug.SetGCPercent(debug.SetGCPercent(-1))
+	port, mux := DynamicHTTPServer(false)
+	mux.HandleFunc("/echo100", EchoHandler)
+	url := fmt.Sprintf("http://localhost:%d/echo100", port)
+	numCalls := 20
+	opts.NumThreads = numCalls / 2
+	opts.Exactly = int64(numCalls)
+	opts.QPS = float64(numCalls)
+	opts.URL = url
+	runOnce := func(run int) {
+		res, err := RunHTTPTest(opts)
+		if err != nil {
+			t.Fatalf("run %d: %v", run+1, err)
+		}
+		if got := res.RetCodes[http.StatusOK]; opts.Exactly != got {
+			t.Fatalf("run %d: requested %d successful calls, got %v", run+1, opts.Exactly, res.RetCodes)
+		}
+	}
+	// Warm up first: a client may legitimately keep a bounded set of idle
+	// connections around for reuse, so measure growth after that is in place.
+	const warmupRuns = 3
+	const measuredRuns = 15
+	for run := 0; run < warmupRuns; run++ {
+		runOnce(run)
+	}
+	// Give asynchronous connection teardown a chance to finish.
+	runtime.GC()
+	time.Sleep(200 * time.Millisecond)
+	ngBefore := runtime.NumGoroutine()
+	fdBefore := countOpenFds()
+	for run := warmupRuns; run < warmupRuns+measuredRuns; run++ {
+		runOnce(run)
+	}
+	// No forced GC here: unreleased sockets would only be reclaimed by finalizers.
+	time.Sleep(200 * time.Millisecond)
+	// A per-run leak adds well over 20 descriptors across these runs, while a
+	// bounded pool of idle connections (at most one per thread, counted at both
+	// ends since the server runs in this process) stays within the tolerance.
+	if fdAfter := countOpenFds(); fdBefore >= 0 && fdAfter > fdBefore+20 {
+		t.Errorf("open file descriptors after repeated runs %d, expected near %d", fdAfter, fdBefore)
+	}
+	if got := runtime.NumGoroutine(); got > ngBefore+10 {
+		t.Errorf("goroutines after repeated runs %d, expected near %d", got, ngBefore)
+	}
+}
+
+func countProcessFds(pid int) int {
+	entries, err := os.ReadDir(fmt.Sprintf("/proc/%d/fd", pid))
+	if err != nil {
+		return -1
+	}
+	return len(entries)
+}
