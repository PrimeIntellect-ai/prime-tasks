@@ -619,3 +619,22 @@ def test_crop(gbox, shape):
     assert gbox.crop(shape).crs == gbox.crs
     assert gbox.crop(shape)[:1, :1] == gbox[:1, :1]
     assert gbox.crop(shape) == gbox.expand(shape)
+
+
+def test_dataset_reproject_honors_resolution():
+    import xarray as xr
+
+    from odc.geo.xr import wrap_xr
+
+    source_geobox = GeoBox.from_bbox(
+        (0, 0, 200, 160), "epsg:3857", shape=(8, 10)
+    )
+    source = xr.Dataset(
+        {"band": wrap_xr(np.zeros(source_geobox.shape), source_geobox)}
+    )
+
+    result = source.odc.reproject("epsg:6933", resolution=10)
+
+    assert result.odc.geobox.crs == "epsg:6933"
+    assert abs(result.odc.geobox.resolution.x) == pytest.approx(10)
+    assert abs(result.odc.geobox.resolution.y) == pytest.approx(10)
