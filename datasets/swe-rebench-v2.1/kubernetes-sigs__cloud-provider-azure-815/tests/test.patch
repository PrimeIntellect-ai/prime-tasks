+func TestAzureCreatedByTagsOnDiskAndStorageAccountCreation(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+
+	cloud := GetTestCloud(ctrl)
+	diskClient := cloud.DisksClient.(*mockdiskclient.MockInterface)
+	var createdDisk compute.Disk
+	diskClient.EXPECT().CreateOrUpdate(gomock.Any(), cloud.ResourceGroup, "tagged-disk", gomock.Any()).
+		DoAndReturn(func(ctx context.Context, resourceGroup, name string, parameters compute.Disk) *retry.Error {
+			createdDisk = parameters
+			return nil
+		})
+	diskClient.EXPECT().Get(gomock.Any(), cloud.ResourceGroup, "tagged-disk").
+		Return(compute.Disk{ID: to.StringPtr("disk-id"), Name: to.StringPtr("tagged-disk"), DiskProperties: &compute.DiskProperties{ProvisioningState: to.StringPtr("Succeeded")}}, nil).AnyTimes()
+	_, err := cloud.ManagedDiskController.CreateManagedDisk(&ManagedDiskOptions{
+		DiskName: "tagged-disk", StorageAccountType: compute.StandardLRS, ResourceGroup: cloud.ResourceGroup, SizeGB: 1,
+	})
+	assert.NoError(t, err)
+	assert.Equal(t, to.StringPtr("kubernetes-azure-dd"), createdDisk.Tags["k8s-azure-created-by"])
+
+	storageClient := mockstorageaccountclient.NewMockInterface(ctrl)
+	cloud.StorageAccountClient = storageClient
+	var createdAccount storage.AccountCreateParameters
+	storageClient.EXPECT().Create(gomock.Any(), "rg", gomock.Any(), gomock.Any()).
+		DoAndReturn(func(ctx context.Context, resourceGroup, name string, parameters storage.AccountCreateParameters) *retry.Error {
+			createdAccount = parameters
+			return nil
+		})
+	storageClient.EXPECT().ListKeys(gomock.Any(), "rg", gomock.Any()).Return(storage.AccountListKeysResult{
+		Keys: &[]storage.AccountKey{{Value: to.StringPtr("account-key")}},
+	}, nil)
+	_, _, err = cloud.EnsureStorageAccount(context.Background(), &AccountOptions{
+		ResourceGroup: "rg", CreateAccount: true, Tags: map[string]string{},
+	}, "tagged")
+	assert.NoError(t, err)
+	assert.Equal(t, to.StringPtr("azure"), createdAccount.Tags["k8s-azure-created-by"])
+}
+
+func TestListRoutesAppliesConfiguredResourceTags(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+	routeTables := mockroutetableclient.NewMockInterface(ctrl)
+	cloud := &Cloud{
+		RouteTablesClient:  routeTables,
+		Config:             Config{RouteTableResourceGroup: "rg", RouteTableName: "routes", RouteUpdateWaitingInSeconds: 0, Tags: "owner=team"},
+		unmanagedNodes:     sets.NewString(),
+		nodeInformerSynced: func() bool { return true },
+	}
+	cache, err := cloud.newRouteTableCache()
+	assert.NoError(t, err)
+	cloud.rtCache = cache
+	routeTable := network.RouteTable{Name: to.StringPtr("routes"), Location: to.StringPtr("location")}
+	routeTables.EXPECT().Get(gomock.Any(), "rg", "routes", "").Return(routeTable, nil).AnyTimes()
+	updated := make(chan struct{}, 1)
+	routeTables.EXPECT().CreateOrUpdate(gomock.Any(), "rg", "routes", gomock.Any(), gomock.Any()).
+		DoAndReturn(func(ctx context.Context, resourceGroup, name string, parameters network.RouteTable, etag string) *retry.Error {
+			assert.Equal(t, to.StringPtr("team"), parameters.Tags["owner"])
+			updated <- struct{}{}
+			return nil
+		})
+	cloud.routeUpdater = newDelayedRouteUpdater(cloud, time.Millisecond)
+	go cloud.routeUpdater.run()
+	_, err = cloud.ListRoutes(context.Background(), "cluster")
+	assert.NoError(t, err)
+	select {
+	case <-updated:
+	case <-time.After(time.Second):
+		t.Fatal("route-table tag reconciliation did not update Azure")
+	}
+}
