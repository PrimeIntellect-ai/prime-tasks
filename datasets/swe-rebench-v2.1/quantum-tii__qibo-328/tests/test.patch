+@pytest.mark.parametrize("nqubits", [7, 8])
+@pytest.mark.parametrize("use_gate", [False, True])
+def test_state_probabilities_large_density_matrix(backend, nqubits, use_gate):
+    """Regression test for measuring density matrices with more than six qubits.
+
+    Tensorflow einsum does not support repeated indices for rank > 6, so
+    calculating probabilities of a density matrix with more than six qubits
+    used to raise an ``UnimplementedError``.
+    """
+    state = states.MatrixState.plus_state(nqubits)
+    if use_gate:
+        from qibo import gates
+        mgate = gates.M(*range(nqubits))
+        probs = state.probabilities(measurement_gate=mgate)
+    else:
+        probs = state.probabilities(qubits=list(range(nqubits)))
+    target_probs = np.ones(nqubits * (2,)) / (2 ** nqubits)
+    np.testing.assert_allclose(probs, target_probs)
+
