+def test_meta_convert_error_joins_messages_with_newlines():
+    errors = ["first error", "second error"]
+    data = {"name": "foo"}
+    settings = {"option": True}
+    error = MetaConvertError(errors, data=data, settings=settings)
+    assert error.data == data
+    assert "first error\nsecond error" in str(error)
+
+
+def test_setup_reader_recovers_from_convert_error(tmp_path):
+    from pdm.models.setup import Setup
+
+    shutil.copy(FIXTURES / "poetry-error.toml", tmp_path / "pyproject.toml")
+    setup = Setup.from_directory(tmp_path)
+    assert setup.name == "test-poetry"
+    assert setup.version == "0.1.0"
+
+
+@pytest.mark.usefixtures("local_finder")
+def test_install_local_package_with_invalid_poetry_specifier(tmp_path, project, pdm):
+    package = tmp_path / "package"
+    package.mkdir()
+    (package / "test_poetry").mkdir()
+    (package / "test_poetry" / "__init__.py").write_text("")
+    (package / "README.md").write_text("package readme")
+    shutil.copy(FIXTURES / "poetry-error.toml", package / "pyproject.toml")
+
+    project.add_dependencies({"test-poetry": parse_requirement(str(package))})
+    result = pdm(["install"], obj=project)
+
+    assert result.exit_code == 0, result.output
+    assert "test-poetry" in project.environment.get_working_set()
+
+
