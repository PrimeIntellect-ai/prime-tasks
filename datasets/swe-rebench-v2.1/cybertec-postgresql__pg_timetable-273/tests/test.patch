+func TestFileLoggerFormat(t *testing.T) {
+	l := log.Init(config.LoggingOpts{LogLevel: "debug", LogFile: "test_json.log", LogFileFormat: "json"})
+	l.Info("json message")
+	data, err := os.ReadFile("test_json.log")
+	assert.NoError(t, err)
+	assert.True(t, json.Valid(data), "json log file should contain valid JSON")
+	_ = os.Remove("test_json.log")
+
+	l = log.Init(config.LoggingOpts{LogLevel: "debug", LogFile: "test_text.log", LogFileFormat: "text"})
+	l.Info("text message")
+	data, err = os.ReadFile("test_text.log")
+	assert.NoError(t, err)
+	assert.False(t, json.Valid(data), "text log file should not contain JSON")
+	_ = os.Remove("test_text.log")
+}
