+def test_merge_ordered_inner_monotonic_memory():
+    # GH#56115: merge_ordered(how="inner") on sorted keys should not
+    # materialize a large intermediate; peak memory should stay close to
+    # the size of the result instead of scaling with the input sizes.
+    import time
+    import tracemalloc
+
+    n = 1_000_000
+    left = DataFrame({"key": np.arange(0, n, 2), "val1": 1})
+    right = DataFrame({"key": np.arange(n // 2, n // 2 + n // 5, 1), "val2": 2})
+
+    # warm up any caches so the measurement only covers the merge itself
+    pd.merge_ordered(left.head(1000), right.head(1000), on="key", how="inner")
+
+    start = time.perf_counter()
+    result = pd.merge_ordered(left, right, on="key", how="inner")
+    elapsed = time.perf_counter() - start
+
+    tracemalloc.start()
+    try:
+        pd.merge_ordered(left, right, on="key", how="inner")
+        _, peak = tracemalloc.get_traced_memory()
+    finally:
+        tracemalloc.stop()
+
+    # the inner join keeps only the overlapping keys, in sorted order
+    expected_keys = np.arange(n // 2, n // 2 + n // 5, 2)
+    tm.assert_numpy_array_equal(result["key"].to_numpy(), expected_keys)
+    assert (result["val1"] == 1).all()
+    assert (result["val2"] == 2).all()
+    # The unoptimized path allocates ~90 MB and takes ~0.3 s for this
+    # input; the optimized path stays well below both bounds.
+    assert peak < 40 * 1024 * 1024
+    assert elapsed < 0.1
