+    public function testLetterSpacing(): void
+    {
+        $base = ["lines" => "letters"];
+
+        $defaultSVG = (new RendererController($base))->render();
+        $tenPxSVG = (new RendererController($base + ["letterSpacing" => "10px"]))->render();
+        $twentyPxSVG = (new RendererController($base + ["letterSpacing" => "20px"]))->render();
