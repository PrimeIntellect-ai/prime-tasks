+def test_default_depth_is_used_for_source_placement(coordinates, data):
+    """The default depth controls the actual vertical source locations."""
+    easting, northing, upward = coordinates
+    east_distances = np.hypot(np.diff(easting, axis=1), np.diff(northing, axis=1))
+    north_distances = np.hypot(np.diff(easting, axis=0), np.diff(northing, axis=0))
+    first_neighbour_distance = np.median(
+        np.concatenate((east_distances.ravel(), north_distances.ravel()))
+    )
+
+    eqs = EquivalentSources().fit(coordinates, data)
+    actual_depths = upward.ravel() - eqs.points_[2]
+    npt.assert_allclose(actual_depths, 4.5 * first_neighbour_distance)
