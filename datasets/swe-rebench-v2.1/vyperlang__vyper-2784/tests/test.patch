@@ -382,3 +382,15 @@ def foo(bs: DynArray[DynArray[DynArray[uint256, 3], 3], 3]) -> (uint256, Bytes[1
         [[19, 20, 21], [22, 23, 24], [25, 26, 27]],
     ]
     assert c.foo(bs) == [2 ** 256 - 1, abi_encode("(uint256[][][])", (bs,))]
+def test_abi_encode_empty_string(get_contract):
+    code = """
+@external
+def foo() -> Bytes[64]:
+    return _abi_encode("")
+"""
+
+    c = get_contract(code)
+
+    # The dynamic string's offset is 0x20, followed by its zero length.
+    expected_output = b"\x00" * 31 + b"\x20" + b"\x00" * 32
+    assert c.foo() == expected_output
