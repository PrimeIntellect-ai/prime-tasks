+def test_filter_by_regexp(meta_df):
+    # with `regexp=True`, the string is interpreted as a regular expression
+    obs = meta_df.filter(scenario='a_scenari.$', regexp=True)
+    assert list(obs['scenario'].unique()) == ['a_scenario']
+
+
+def test_filter_default_is_not_regexp(meta_df):
+    # without `regexp=True`, `.` and `$` are matched literally, so the
+    # pseudo-regexp pattern does not match the scenario 'a_scenario'
+    obs = meta_df.filter(scenario='a_scenari.$')
+    assert obs.scenarios().empty
+
+
