+def test_payee_triggered_equal_split(session):
+    acct = create_account(session, "Bank")
+    payee = create_payee(session, "My payee")
+    # two equal 50% shares, encoded with the options format documented on Action
+    actions = [
+        Action(
+            field=None,
+            op=ActionType.SET_SPLIT_AMOUNT,
+            value=50,
+            type=ValueType.NUMBER,
+            options={"method": "fixed-percent", "splitIndex": split_index},
+        )
+        for split_index in (1, 2)
+    ]
+    rule = Rule(
+        conditions=[Condition(field="description", op=ConditionType.IS, value=payee.id)],
+        actions=actions,
+    )
+    transaction = create_transaction(session, datetime.date(2024, 1, 1), acct, payee, amount=5.0)
+    session.flush()
+    RuleSet(rules=[rule]).run(transaction)
+    session.refresh(transaction)
+    amounts = [float(split.get_amount()) for split in transaction.splits]
+    assert len(amounts) == 2
+    assert amounts[0] == amounts[1]
+    assert sum(amounts) == 5.0
