diff --git a/test/specs/linters/single_line_per_property.js b/test/specs/linters/single_line_per_property.js
index 23ef320..72b5d7d 100644
--- a/test/specs/linters/single_line_per_property.js
+++ b/test/specs/linters/single_line_per_property.js
@@ -330,5 +330,119 @@ describe('lesshint', function () {
                 expect(result).to.be.undefined;
             });
         });
+
+        it('should default "allowSingleLineRules" to false', function () {
+            var Lesshint = require('../../../lib/lesshint');
+            var lesshint = new Lesshint();
+
+            lesshint.configure({
+                singleLinePerProperty: {
+                    enabled: true
+                }
+            });
+
+            var result = lesshint.checkString('.foo { color: red; }');
+            var ruleResults = result.filter(function (item) {
+                return item.linter === 'singleLinePerProperty';
+            });
+
+            expect(ruleResults).to.have.length(1);
+        });
+
+        it('should report each declaration sharing a line when "allowSingleLineRules" is "false"', function () {
+            var source = '.foo { color: red; margin-right: 10px; }';
+            var options = {
+                allowSingleLineRules: false
+            };
+
+            return spec.parse(source, function (ast) {
+                var result = spec.linter.lint(options, ast.root.first);
+
+                expect(result).to.have.length.above(0);
+            });
+        });
+
+        it('should allow single line rules when "allowSingleLineRules" is "true"', function () {
+            var source = '.foo { color: red; }';
+            var options = {
+                allowSingleLineRules: true
+            };
+
+            return spec.parse(source, function (ast) {
+                var result = spec.linter.lint(options, ast.root.first);
+
+                expect(result).to.be.undefined;
+            });
+        });
+
+        it('should not allow single line rules when "allowSingleLineRules" is "false"', function () {
+            var source = '.foo { color: red; }';
+            var options = {
+                allowSingleLineRules: false
+            };
+
+            var expected = [
+                {
+                    column: 8,
+                    line: 1,
+                    message: 'Each property should be on its own line.'
+                }
+            ];
+
+            return spec.parse(source, function (ast) {
+                var result = spec.linter.lint(options, ast.root.first);
+
+                expect(result).to.deep.equal(expected);
+            });
+        });
+
+        it('should not allow single line rules with multiple declarations when "allowSingleLineRules" is "true"', function () {
+            var source = '.foo { color: red; margin-right: 10px; }';
+            var options = {
+                allowSingleLineRules: true
+            };
+
+            var expected = [
+                {
+                    column: 8,
+                    line: 1,
+                    message: 'Each property should be on its own line.'
+                },
+                {
+                    column: 20,
+                    line: 1,
+                    message: 'Each property should be on its own line.'
+                }
+            ];
+
+            return spec.parse(source, function (ast) {
+                var result = spec.linter.lint(options, ast.root.first);
+
+                expect(result).to.deep.equal(expected);
+            });
+        });
+
+        it('should forward "allowSingleLineRules" from the public linter config', function () {
+            var linter = require('../../../lib/linter');
+            var source = '.foo { color: red; }';
+
+            var allowed = linter.lint(source, 'test.less', {
+                singleLinePerProperty: {
+                    enabled: true,
+                    allowSingleLineRules: true
+                }
+            });
+
+            expect(allowed).to.have.length(0);
+
+            var reported = linter.lint(source, 'test.less', {
+                singleLinePerProperty: {
+                    enabled: true,
+                    allowSingleLineRules: false
+                }
+            });
+
+            expect(reported).to.have.length(1);
+        });
     });
 });
