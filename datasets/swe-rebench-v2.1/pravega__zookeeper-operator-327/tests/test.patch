@@ -290,4 +294,42 @@ var _ = Describe("ZookeeperCluster DeepCopy", func() {
 			Ω(z2.Spec.Probes.LivenessProbe.FailureThreshold).To(Equal(int32(1)))
 		})
 	})
+	Context("with customized volume mounts", func() {
+		It("serializes customized mounts with the volumeMounts JSON key", func() {
+			var spec v1beta1.ZookeeperClusterSpec
+			Ω(json.Unmarshal([]byte(`{"volumeMounts":[{"name":"custom-volume","mountPath":"/custom/path"}]}`), &spec)).Should(Succeed())
+
+			field, found := reflect.TypeOf(spec).FieldByName("VolumeMounts")
+			Ω(found).Should(BeTrue())
+			Ω(field.Type).Should(Equal(reflect.TypeOf([]v1.VolumeMount{})))
+
+			encoded, err := json.Marshal(spec)
+			Ω(err).Should(Succeed())
+
+			var fields map[string]json.RawMessage
+			Ω(json.Unmarshal(encoded, &fields)).Should(Succeed())
+			Ω(fields).Should(HaveKey("volumeMounts"))
+
+			var got []v1.VolumeMount
+			Ω(json.Unmarshal(fields["volumeMounts"], &got)).Should(Succeed())
+			Ω(got).Should(Equal([]v1.VolumeMount{{Name: "custom-volume", MountPath: "/custom/path"}}))
+		})
+		It("should mount the customized volume mounts to the zookeeper container", func() {
+			z := &v1beta1.ZookeeperCluster{}
+			Ω(json.Unmarshal([]byte(`{"metadata":{"name":"example","namespace":"default"},"spec":{"volumeMounts":[{"name":"custom-volume","mountPath":"/custom/path"}]}}`), z)).Should(Succeed())
+			z.WithDefaults()
+			sts := zk.MakeStatefulSet(z)
+			var zkContainer *v1.Container
+			for i := range sts.Spec.Template.Spec.Containers {
+				if sts.Spec.Template.Spec.Containers[i].Name == "zookeeper" {
+					zkContainer = &sts.Spec.Template.Spec.Containers[i]
+				}
+			}
+			Ω(zkContainer).ToNot(BeNil())
+			Ω(zkContainer.VolumeMounts).To(ContainElement(v1.VolumeMount{
+				Name:      "custom-volume",
+				MountPath: "/custom/path",
+			}))
+		})
+	})
 })
