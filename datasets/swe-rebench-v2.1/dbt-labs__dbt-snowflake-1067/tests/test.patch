 import os
 from importlib import reload
-from unittest.mock import Mock
+from unittest.mock import Mock, patch
 import dbt.adapters.snowflake.connections as connections
 import dbt.adapters.events.logging
 
@@ -23,3 +23,28 @@ def test_connections_does_not_set_logs_in_response_to_env_var(monkeypatch):
 
     assert log_mock.debug.call_count == 0
     assert log_mock.set_adapter_dependency_log_level.call_count == 0
+
+
+def test_connnections_credentials_replaces_underscores_with_hyphens():
+    credentials = {
+        "account": "account_id_with_underscores",
+        "user": "user",
+        "password": "password",
+        "database": "database",
+        "warehouse": "warehouse",
+        "schema": "schema",
+    }
+    creds = connections.SnowflakeCredentials(**credentials)
+
+    connection = Mock()
+    connection.credentials = creds
+    connection.state = "init"
+
+    with patch(
+        "dbt.adapters.snowflake.connections.snowflake.connector.connect"
+    ) as connect:
+        connections.SnowflakeConnectionManager.open(connection)
+
+    # The account handed to the Snowflake connector must have underscores
+    # replaced with hyphens, regardless of how the credentials object stores it.
+    assert connect.call_args.kwargs["account"] == "account-id-with-underscores"
