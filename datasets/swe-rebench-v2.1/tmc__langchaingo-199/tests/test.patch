+package prompts
+
+import "testing"
+
+func TestFewShotPromptFormatsExamplesBetweenPrefixAndSuffix(t *testing.T) {
+	examplePrompt := NewPromptTemplate("{{.question}}: {{.answer}}", []string{"question", "answer"})
+	examples := []map[string]string{
+		{"question": "first", "answer": "one"},
+		{"question": "second", "answer": "two"},
+	}
+	prompt, err := NewFewShotPrompt(
+		examplePrompt, examples, nil,
+		"Start: {{.topic}}", "Try it: {{.topic}}",
+		map[string]interface{}{"topic": "animals"}, nil,
+		"\n", TemplateFormatGoTemplate, false,
+	)
+	if err != nil {
+		t.Fatalf("construct prompt: %v", err)
+	}
+
+	got, err := prompt.Format(map[string]interface{}{"topic": "animals"})
+	if err != nil {
+		t.Fatalf("format prompt: %v", err)
+	}
+	want := "Start: animals\nfirst: one\nsecond: two\nTry it: animals"
+	if got != want {
+		t.Errorf("unexpected prompt output: got %q, want %q", got, want)
+	}
+}
+
+func TestFewShotPromptAllowsOmittedPrefixOrSuffix(t *testing.T) {
+	examplePrompt := NewPromptTemplate("{{.question}}: {{.answer}}", []string{"question", "answer"})
+	examples := []map[string]string{{"question": "first", "answer": "one"}}
+
+	tests := []struct {
+		name   string
+		prefix string
+		suffix string
+		want   string
+	}{
+		{
+			name:   "omitted prefix",
+			suffix: "Try it: {{.topic}}",
+			want:   "first: one\nTry it: animals",
+		},
+		{
+			name:   "omitted suffix",
+			prefix: "Start: {{.topic}}",
+			want:   "Start: animals\nfirst: one",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			prompt, err := NewFewShotPrompt(
+				examplePrompt, examples, nil,
+				test.prefix, test.suffix,
+				map[string]interface{}{"topic": "animals"}, nil,
+				"\n", TemplateFormatGoTemplate, false,
+			)
+			if err != nil {
+				t.Fatalf("construct prompt: %v", err)
+			}
+
+			got, err := prompt.Format(map[string]interface{}{"topic": "animals"})
+			if err != nil {
+				t.Fatalf("format prompt: %v", err)
+			}
+			if got != test.want {
+				t.Errorf("unexpected prompt output: got %q, want %q", got, test.want)
+			}
+		})
+	}
+}
