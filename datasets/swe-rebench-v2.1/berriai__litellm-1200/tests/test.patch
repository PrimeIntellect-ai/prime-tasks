@@ -0,0 +1,57 @@
+import inspect
+
+from litellm import acompletion
+
+
+# The explicit parameters that `litellm.acompletion` must expose in its public
+# signature (see the problem statement's "Additional contract requirements").
+EXPECTED_PARAMS = [
+    "model",
+    "messages",
+    "functions",
+    "function_call",
+    "timeout",
+    "temperature",
+    "top_p",
+    "n",
+    "stream",
+    "stop",
+    "max_tokens",
+    "presence_penalty",
+    "frequency_penalty",
+    "logit_bias",
+    "user",
+    "response_format",
+    "seed",
+    "tools",
+    "tool_choice",
+    "logprobs",
+    "top_logprobs",
+    "deployment_id",
+    "base_url",
+    "api_version",
+    "api_key",
+    "model_list",
+]
+
+
+def test_acompletion_exposes_explicit_named_params():
+    params = inspect.signature(acompletion).parameters
+    missing = [name for name in EXPECTED_PARAMS if name not in params]
+    assert not missing, (
+        "litellm.acompletion must expose these parameters as explicit named "
+        f"parameters; missing: {missing}"
+    )
+
+
+def test_acompletion_has_no_positional_catch_all():
+    params = inspect.signature(acompletion).parameters
+    var_positional = [
+        name
+        for name, param in params.items()
+        if param.kind is inspect.Parameter.VAR_POSITIONAL
+    ]
+    assert not var_positional, (
+        "litellm.acompletion must not accept its arguments through a generic "
+        f"*args catch-all; found: {var_positional}"
+    )
