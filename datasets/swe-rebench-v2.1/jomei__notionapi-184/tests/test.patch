+// TestDownloadableFileBlockFallbacks verifies the URL and expiry-time fallback
+// behaviour for internal files, external files and blocks with no file at all.
+func TestDownloadableFileBlockFallbacks(t *testing.T) {
+	now := time.Now()
+	testCases := []struct {
+		name           string
+		block          DownloadableFileBlock
+		expectedURL    string
+		expectedExpiry *time.Time
+	}{
+		{
+			name:           "PDF with internal file",
+			block:          &PdfBlock{Pdf: Pdf{File: &FileObject{URL: "https://internal.com/file.pdf", ExpiryTime: &now}}},
+			expectedURL:    "https://internal.com/file.pdf",
+			expectedExpiry: &now,
+		},
+		{
+			name:           "PDF with external file",
+			block:          &PdfBlock{Pdf: Pdf{External: &FileObject{URL: "https://external.com/file.pdf"}}},
+			expectedURL:    "https://external.com/file.pdf",
+			expectedExpiry: nil,
+		},
+		{
+			name:           "PDF with no file",
+			block:          &PdfBlock{},
+			expectedURL:    "",
+			expectedExpiry: nil,
+		},
+		{
+			name:           "File with internal file",
+			block:          &FileBlock{File: BlockFile{File: &FileObject{URL: "https://internal.com/file.txt", ExpiryTime: &now}}},
+			expectedURL:    "https://internal.com/file.txt",
+			expectedExpiry: &now,
+		},
+		{
+			name:           "File with external file",
+			block:          &FileBlock{File: BlockFile{External: &FileObject{URL: "https://external.com/file.txt"}}},
+			expectedURL:    "https://external.com/file.txt",
+			expectedExpiry: nil,
+		},
+		{
+			name:           "File with no file",
+			block:          &FileBlock{},
+			expectedURL:    "",
+			expectedExpiry: nil,
+		},
+		{
+			name:           "Image with internal file",
+			block:          &ImageBlock{Image: Image{File: &FileObject{URL: "https://internal.com/image.jpg", ExpiryTime: &now}}},
+			expectedURL:    "https://internal.com/image.jpg",
+			expectedExpiry: &now,
+		},
+		{
+			name:           "Image with external file",
+			block:          &ImageBlock{Image: Image{External: &FileObject{URL: "https://external.com/image.jpg"}}},
+			expectedURL:    "https://external.com/image.jpg",
+			expectedExpiry: nil,
+		},
+		{
+			name:           "Image with no file",
+			block:          &ImageBlock{},
+			expectedURL:    "",
+			expectedExpiry: nil,
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			if url := tc.block.GetURL(); url != tc.expectedURL {
+				t.Errorf("Expected URL to be '%s', got '%s'", tc.expectedURL, url)
+			}
+
+			expiry := tc.block.GetExpiryTime()
+			if tc.expectedExpiry == nil {
+				if expiry != nil {
+					t.Errorf("Expected nil expiry time, got %v", expiry)
+				}
+				return
+			}
+			if expiry == nil || !expiry.Equal(*tc.expectedExpiry) {
+				t.Errorf("Expected expiry time to be %v, got %v", *tc.expectedExpiry, expiry)
+			}
+		})
+	}
+}
