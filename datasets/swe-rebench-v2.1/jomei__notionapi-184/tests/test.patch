+// TestDownloadableFileBlockEmbedsBlock verifies that DownloadableFileBlock
+// embeds the Block interface, so a value of the interface can be used wherever
+// a Block is expected.
+func TestDownloadableFileBlockEmbedsBlock(t *testing.T) {
+	testCases := []struct {
+		name      string
+		block     DownloadableFileBlock
+		blockType BlockType
+	}{
+		{
+			name:      "PDF",
+			block:     &PdfBlock{BasicBlock: BasicBlock{Type: "pdf"}},
+			blockType: "pdf",
+		},
+		{
+			name:      "File",
+			block:     &FileBlock{BasicBlock: BasicBlock{Type: "file"}},
+			blockType: "file",
+		},
+		{
+			name:      "Image",
+			block:     &ImageBlock{BasicBlock: BasicBlock{Type: "image"}},
+			blockType: "image",
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			var block Block = tc.block
+			if got := block.GetType(); got != tc.blockType {
+				t.Errorf("Expected block type %q, got %q", tc.blockType, got)
+			}
+		})
+	}
+}
