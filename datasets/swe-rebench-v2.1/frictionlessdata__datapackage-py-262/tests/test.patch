+def test_local_relative_parent_path_with_unsafe_option_issue_171(tmpdir):
+    # Create a real file so the resource can be read without relying on
+    # any fixture shipped outside of this test.
+    data_dir = tmpdir.mkdir('data')
+    data_dir.join('table.csv').write('id,name\n1,english\n2,\u4e2d\u56fd\u4eba\n')
+    descriptor = {'resources': [{'name': 'table', 'path': 'data/../data/table.csv'}]}
+    # unsafe=false (default)
+    with pytest.raises(exceptions.DataPackageException) as excinfo:
+        Package(descriptor, base_path=str(tmpdir))
+    assert 'is not safe' in str(excinfo.value)
+    # unsafe=true
+    package = Package(descriptor, base_path=str(tmpdir), unsafe=True)
+    assert package.get_resource('table').read() == [['1', 'english'], ['2', '\u4e2d\u56fd\u4eba']]
+
+
+def test_local_absolute_path_with_unsafe_option(tmpdir):
+    table = tmpdir.join('table.csv')
+    table.write('id,name\n1,english\n2,\u4e2d\u56fd\u4eba\n')
+    descriptor = {'resources': [{'name': 'table', 'path': str(table)}]}
+    # unsafe=false (default)
+    with pytest.raises(exceptions.DataPackageException) as excinfo:
+        Package(descriptor)
+    assert 'is not safe' in str(excinfo.value)
+    # unsafe=true
+    package = Package(descriptor, unsafe=True)
+    assert package.get_resource('table').read() == [['1', 'english'], ['2', '\u4e2d\u56fd\u4eba']]
+
