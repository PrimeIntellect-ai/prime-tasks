+
+func invokeCreateTokens(ra v2alpha1.RouterAccess, server v1.Secret, client v1.Secret) []*Token {
+	function := reflect.ValueOf(CreateTokens)
+	argument := reflect.ValueOf(server)
+	want := function.Type().In(1)
+	if want.Kind() == reflect.Ptr {
+		argument = reflect.ValueOf(&server)
+	} else if want != argument.Type() {
+		argument = argument.Convert(want)
+	}
+	results := function.Call([]reflect.Value{reflect.ValueOf(ra), argument, reflect.ValueOf(client)})
+	return results[0].Interface().([]*Token)
+}
