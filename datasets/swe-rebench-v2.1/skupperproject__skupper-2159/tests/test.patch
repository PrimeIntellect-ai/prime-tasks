+
+func invokeNewCertToken(generator *TokenGenerator, name, subject string) (Token, error) {
+	outputs := reflect.ValueOf(generator.NewCertToken).Call([]reflect.Value{reflect.ValueOf(name), reflect.ValueOf(subject)})
+	var err error
+	if len(outputs) == 2 && !outputs[1].IsNil() {
+		err = outputs[1].Interface().(error)
+	}
+	if outputs[0].IsNil() {
+		return nil, err
+	}
+	return outputs[0].Interface().(Token), err
+}
