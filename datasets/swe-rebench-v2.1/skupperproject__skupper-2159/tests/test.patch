+func TestCertificateManagerInvalidCA(t *testing.T) {
+	client, err := fakeclient.NewFakeClient("test", []runtime.Object{
+		secret("my-ca", "test", map[string][]byte{"tls.crt": []byte("not a certificate"), "tls.key": []byte("not a key")}, nil, nil),
+	}, []runtime.Object{
+		certificate("foo", "test", "my-ca", "my-subject", []string{"aaa"}, false, true, nil, nil),
+	}, "")
+	assert.Assert(t, err)
+	processor := watchers.NewEventProcessor("Controller", client)
+	mgr := NewCertificateManager(processor)
+	mgr.Watch(metav1.NamespaceAll)
+	stopCh := make(chan struct{})
+	defer close(stopCh)
+	processor.StartWatchers(stopCh)
+	processor.WaitForCacheSync(stopCh)
+	mgr.Recover()
+	processor.TestProcessAll()
+
+	actual, err := client.GetSkupperClient().SkupperV2alpha1().Certificates("test").Get(context.Background(), "foo", metav1.GetOptions{})
+	assert.Assert(t, err)
+	ready := meta.FindStatusCondition(actual.Status.Conditions, skupperv2alpha1.CONDITION_TYPE_READY)
+	assert.Assert(t, ready != nil, "certificate should report a Ready condition")
+	assert.Equal(t, ready.Status, metav1.ConditionFalse)
 }
