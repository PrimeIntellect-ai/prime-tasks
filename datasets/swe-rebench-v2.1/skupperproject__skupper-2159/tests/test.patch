+func generateSecretForTest(name, subject, hosts string, expiration time.Duration, ca *v1.Secret) *v1.Secret {
+	outputs := reflect.ValueOf(certs.GenerateSecret).Call([]reflect.Value{reflect.ValueOf(name), reflect.ValueOf(subject), reflect.ValueOf(hosts), reflect.ValueOf(expiration), reflect.ValueOf(ca)})
