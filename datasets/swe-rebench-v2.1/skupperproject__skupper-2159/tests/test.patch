+
+// Call the public generator across the legacy and error-returning signatures.
+func invokeGenerateSecret(name, subject, hosts string, expiration time.Duration, ca *corev1.Secret) (any, error) {
+	outputs := reflect.ValueOf(GenerateSecret).Call([]reflect.Value{reflect.ValueOf(name), reflect.ValueOf(subject), reflect.ValueOf(hosts), reflect.ValueOf(expiration), reflect.ValueOf(ca)})
+	var generationErr error
+	if len(outputs) == 2 && !outputs[1].IsNil() {
+		generationErr = outputs[1].Interface().(error)
+	}
+	if generationErr != nil {
+		return nil, generationErr
+	}
+	return outputs[0].Interface(), nil
+}
+
+// Normalize either supported Secret result representation for subsequent test setup.
+func mustGenerateSecret(t *testing.T, name, subject, hosts string, expiration time.Duration, ca *corev1.Secret) *corev1.Secret {
+	t.Helper()
+	result, err := invokeGenerateSecret(name, subject, hosts, expiration, ca)
+	if err != nil {
+		t.Fatal(err)
+	}
+	switch secret := any(result).(type) {
+	case *corev1.Secret:
+		return secret
+	case corev1.Secret:
+		return &secret
+	default:
+		t.Fatalf("unexpected generated Secret result %T", result)
+		return nil
+	}
+}
+
+// A failing randomness source makes RSA key generation fail deterministically.
+type failingRandomReader struct{}
+
+func (failingRandomReader) Read([]byte) (int, error) {
+	return 0, errors.New("randomness unavailable")
 }
