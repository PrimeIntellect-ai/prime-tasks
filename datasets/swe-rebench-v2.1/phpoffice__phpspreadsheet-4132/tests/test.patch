+<?php
+
+declare(strict_types=1);
+
+namespace PhpOffice\PhpSpreadsheetTests\Worksheet;
+
+use PhpOffice\PhpSpreadsheet\Spreadsheet;
+use PhpOffice\PhpSpreadsheet\Writer\Xlsx;
+use PHPUnit\Framework\TestCase;
+use ZipArchive;
+
+class Issue4128Test extends TestCase
+{
+    /**
+     * Setting a cell value must leave the sheet's selection untouched, and the
+     * saved Xlsx file must record that same active cell.
+     */
+    public function testIssue4128(): void
+    {
+        $spreadsheet = new Spreadsheet();
+        $sheet = $spreadsheet->getActiveSheet();
+        $activeBefore = $sheet->getActiveCell();
+        $selectedBefore = $sheet->getSelectedCells();
+        $sheet->setCellValue('D1', 'MyDate');
+
+        self::assertSame($activeBefore, $sheet->getActiveCell());
+        self::assertSame($selectedBefore, $sheet->getSelectedCells());
+        self::assertSame('MyDate', $sheet->getCell('D1')->getValue());
+
+        $file = tempnam(sys_get_temp_dir(), 'issue4128') . '.xlsx';
+        try {
+            $writer = new Xlsx($spreadsheet);
+            $writer->save($file);
+
+            $zip = new ZipArchive();
+            self::assertTrue($zip->open($file) === true);
+            $xml = $zip->getFromName('xl/worksheets/sheet1.xml');
+            $zip->close();
+            self::assertIsString($xml);
+
+            $worksheet = simplexml_load_string($xml);
+            self::assertNotFalse($worksheet);
+            $namespaces = $worksheet->getNamespaces(true);
+            $main = $namespaces[''] ?? 'http://schemas.openxmlformats.org/spreadsheetml/2006/main';
+            $worksheet->registerXPathNamespace('m', $main);
+            $selections = $worksheet->xpath('//m:sheetView/m:selection');
+
+            // Selection metadata is optional; when present, its active cell must be the original one.
+            foreach ($selections as $selection) {
+                $activeCell = (string) $selection['activeCell'];
+                if ($activeCell !== '') {
+                    self::assertSame($activeBefore, $activeCell);
+                }
+            }
+        } finally {
+            $spreadsheet->disconnectWorksheets();
+            if (file_exists($file)) {
+                unlink($file);
+            }
+        }
+    }
+}
