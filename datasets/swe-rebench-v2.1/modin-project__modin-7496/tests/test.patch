@@ -69,6 +69,37 @@ def test_dataframe_extension_overrides_existing_method(Backend1):
     assert df.set_backend(Backend1).sort_values().iloc[0, 0] == 3
 
 
+@pytest.mark.parametrize(
+    "method_name",
+    [
+        "pow",
+        "__pow__",
+        "__ipow__",
+    ],
+)
+def test_dataframe_extension_overrides_pow_github_issue_7495(method_name, Backend1):
+    register_dataframe_accessor(method_name, backend=Backend1)(
+        lambda *args, **kwargs: 4
+    )
+    assert getattr(pd.DataFrame([1]).set_backend(Backend1), method_name)() == 4
+
+
+def test_power_method_overrides_are_independent(Backend1):
+    expected = {
+        "pow": "pow_result",
+        "__pow__": "__pow___result",
+        "__ipow__": "__ipow___result",
+    }
+    for method_name, result in expected.items():
+        register_dataframe_accessor(method_name, backend=Backend1)(
+            lambda *args, result=result, **kwargs: result
+        )
+
+    df = pd.DataFrame([1]).set_backend(Backend1)
+    for method_name, result in expected.items():
+        assert getattr(df, method_name)() == result
+
+
