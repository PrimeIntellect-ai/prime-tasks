+def test_pragma_with_placeholders():
+    q = QubitPlaceholder()
+    q2 = QubitPlaceholder()
+    p = Program()
+    p.inst(Pragma('FENCE', [q, q2]))
+    address_map = {q: 0, q2: 1}
+    addressed_pragma = address_qubits(p, address_map)[0]
+    parse_equals('PRAGMA FENCE 0 1\n', addressed_pragma)
