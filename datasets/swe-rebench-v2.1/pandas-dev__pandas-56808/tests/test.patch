+def test_ex03_selected_methods_removed_from_code_checks_and_pass_validator():
+    repo_root = Path(__file__).parents[4]
+    code_checks = (repo_root / "ci" / "code_checks.sh").read_text()
+    removed = [
+        name
+        for name in _EX03_DOCSTRING_CANDIDATES
+        if not re.search(rf"(?<![\w.]){re.escape(name)}(?![\w.])", code_checks)
+    ]
+    assert 2 <= len(removed) <= 4, removed
+    for name in removed:
+        result = subprocess.run(
+            [
+                sys.executable,
+                str(repo_root / "scripts" / "validate_docstrings.py"),
+                "--format=actions",
+                "--errors=EX03",
+                name,
+            ],
+            capture_output=True,
+            text=True,
+            cwd=repo_root,
+            check=False,
+        )
+        output = result.stdout + result.stderr
+        assert "correct. :)" in output, f"{name} still fails EX03"
