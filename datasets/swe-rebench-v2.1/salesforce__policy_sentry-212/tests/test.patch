+    def test_minimize_collapses_policy_actions(self):
+        """minimize=True collapses the policy's actions using wildcards."""
+        crud_template = copy.deepcopy(get_crud_template_dict())
+        crud_template["read"].append(
+            "arn:aws:secretsmanager:us-east-1:123456789012:secret:mysecret"
+        )
+        crud_template["write"].append(
+            "arn:aws:secretsmanager:us-east-1:123456789012:secret:mysecret"
+        )
+        crud_template["list"].append("arn:aws:s3:::example-org-sbx-vmimport/stuff")
+        crud_template["tagging"].append(
+            "arn:aws:ssm:us-east-1:123456789012:parameter/test"
+        )
+        crud_template["permissions-management"].append(
+            "arn:aws:kms:us-east-1:123456789012:key/123456"
+        )
+        default_policy = write_policy_with_template(crud_template)
+        minimized_policy = write_policy_with_template(crud_template, minimize=True)
+
+        default_actions = [
+            action
+            for statement in default_policy["Statement"]
+            for action in statement["Action"]
+        ]
+        minimized_actions = [
+            action
+            for statement in minimized_policy["Statement"]
+            for action in statement["Action"]
+        ]
+        # Without minimize, the requested actions are listed explicitly.
+        self.assertTrue(default_actions)
+        self.assertTrue(all("*" not in action for action in default_actions))
+        # With minimize=True, the actions are collapsed using wildcards.
+        self.assertTrue(minimized_actions)
+        self.assertTrue(any("*" in action for action in minimized_actions))
+
