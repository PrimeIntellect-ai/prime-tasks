+def normalize_policy(policy):
+    """Return an order-insensitive representation of an IAM policy.
+
+    The public contract specifies that the returned dict has a "Version" key
+    and a "Statement" list whose statements include Sid, Effect, Action, and
+    Resource. It does not specify the order of statements, actions, or
+    resources, so normalize those before comparing.
+    """
+    assert "Version" in policy
+    assert "Statement" in policy
+    statements = []
+    for statement in policy["Statement"]:
+        statements.append(
+            (
+                statement["Sid"],
+                statement["Effect"],
+                tuple(sorted(statement["Action"])),
+                tuple(sorted(statement["Resource"])),
+            )
+        )
+    return policy["Version"], sorted(statements)
+
