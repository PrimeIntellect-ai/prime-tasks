diff --git a/test/middleware.js b/test/middleware.js
index 764b1b0..6fd6c31 100644
--- a/test/middleware.js
+++ b/test/middleware.js
@@ -53,4 +53,29 @@ describe('middleware', () => {
       .exitProcess(false) // defaults to true.
       .parse()
   })
+
+  it('runs middleware registered after the command before its handler', function (done) {
+    yargs(['mw'])
+      .command(
+        'mw',
+        'adds func list to middleware',
+        function () {},
+        function (argv) {
+          // middleware registered after the command should still run
+          argv.mw1.should.equal('mw1')
+          argv.mw2.should.equal('mw2')
+          return done()
+        }
+      )
+      .middleware([
+        function (argv) {
+          argv.mw1 = 'mw1'
+        },
+        function (argv) {
+          argv.mw2 = 'mw2'
+        }
+      ])
+      .exitProcess(false) // defaults to true.
+      .parse()
+  })
 })
