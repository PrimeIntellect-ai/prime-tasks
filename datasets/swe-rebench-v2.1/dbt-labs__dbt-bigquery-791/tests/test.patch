+def _make_adapter(entity, access_entries):
+    mock_dataset = MagicMock(name="GrantMockDataset")
+    mock_dataset.access_entries = access_entries
+    mock_client = MagicMock(name="MockBQClient")
+    mock_client.get_dataset.return_value = mock_dataset
+    mock_connection = MagicMock(name="MockConn")
+    mock_connection.handle = mock_client
+    mock_connection_mgr = MagicMock(name="GrantAccessMockMgr")
+    mock_connection_mgr.get_thread_connection.return_value = mock_connection
+    mock_connection_mgr.table_ref.return_value.to_api_repr.return_value = entity
+    adapter = object.__new__(BigQueryAdapter)
+    adapter.connections = mock_connection_mgr
+    return adapter, mock_client
+
+
+def _grant_target():
+    return {"dataset": "someDataset", "project": "someProject"}
+
+
+def test_grant_access_to_does_not_update_dataset_when_entry_already_exists():
+    entity = _entity_dict(identifier="my_view")
+    existing_entry = AccessEntry(None, "view", entity)
+    adapter, mock_client = _make_adapter(entity, [existing_entry])
+    with patch.object(AdapterLogger, "warning", autospec=True) as warning:
+        adapter.grant_access_to(
+            entity=_view_relation(),
+            entity_type="view",
+            role=None,
+            grant_target_dict=_grant_target(),
+        )
+    # An existing entry must not trigger another dataset update.
+    mock_client.update_dataset.assert_not_called()
+    # Any BigQuery adapter logger may emit the required warning.
+    assert any("already exists in dataset" in str(call.args) for call in warning.call_args_list)
+
+
+def test_grant_access_to_updates_dataset_when_entry_missing():
+    entity = _entity_dict(identifier="my_view")
+    adapter, mock_client = _make_adapter(entity, [])
+    adapter.grant_access_to(
+        entity=_view_relation(),
+        entity_type="view",
+        role=None,
+        grant_target_dict=_grant_target(),
+    )
+    expected_entry = AccessEntry(None, "view", entity).to_api_repr()
+    assert any(
+        expected_entry in [entry.to_api_repr() for entry in call.args[0].access_entries]
+        for call in mock_client.update_dataset.call_args_list
+    )
