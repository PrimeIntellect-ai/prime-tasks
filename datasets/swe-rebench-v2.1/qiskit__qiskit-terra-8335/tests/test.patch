+    def test_reverse_linear_real_amplitudes_matches_full_entanglement(self):
+        """A reduced linear CX layer preserves the full-entanglement unitary."""
+        num_qubits = 5
+        reps = 2
+        num_parameters = num_qubits * (reps + 1)
+        parameters = np.linspace(0.1, 1.2, num_parameters)
+
+        actual = RealAmplitudes(
+            num_qubits, reps=reps, entanglement="reverse_linear"
+        ).assign_parameters(parameters)
+
+        # Compare against the original all-to-all CX layer.
+        reference = QuantumCircuit(num_qubits)
+        parameter_index = 0
+        for _ in range(reps):
+            for qubit in range(num_qubits):
+                reference.ry(parameters[parameter_index], qubit)
+                parameter_index += 1
+            for control in range(num_qubits):
+                for target in range(control + 1, num_qubits):
+                    reference.cx(control, target)
+        for qubit in range(num_qubits):
+            reference.ry(parameters[parameter_index], qubit)
+            parameter_index += 1
+
+        decomposed = actual.decompose()
+        cx_instructions = [item for item in decomposed.data if item.operation.name == "cx"]
+        self.assertEqual(len(cx_instructions), reps * (num_qubits - 1))
+        self.assertTrue(
+            all(
+                abs(decomposed.find_bit(item.qubits[0]).index
+                    - decomposed.find_bit(item.qubits[1]).index) == 1
+                for item in cx_instructions
+            )
+        )
+        self.assertTrue(Operator(actual).equiv(Operator(reference)))
+
 
 if __name__ == "__main__":
     unittest.main()
