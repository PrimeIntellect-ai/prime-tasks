+@mock_aws
+@pytest.mark.parametrize("nr_of_headers", [1, 2])
+def test_create_distribution_with_custom_headers(nr_of_headers):
+    client = boto3.client("cloudfront", region_name="us-west-1")
+    config = scaffold.example_distribution_config("ref")
+    headers = [
+        {"HeaderName": f"X-Custom-Header{i}", "HeaderValue": f"v{i}"}
+        for i in range(nr_of_headers)
+    ]
+    config["Origins"]["Items"][0]["CustomHeaders"] = {
+        "Quantity": nr_of_headers,
+        "Items": headers,
+    }
+
+    dist = client.create_distribution(DistributionConfig=config)["Distribution"]
+
+    origin = dist["DistributionConfig"]["Origins"]["Items"][0]
+    custom_headers = origin["CustomHeaders"]
+    assert custom_headers["Quantity"] == nr_of_headers
+    assert {
+        (header["HeaderName"], header["HeaderValue"])
+        for header in custom_headers["Items"]
+    } == {(header["HeaderName"], header["HeaderValue"]) for header in headers}
+
+    config_response = client.get_distribution_config(Id=dist["Id"])
+    origin = config_response["DistributionConfig"]["Origins"]["Items"][0]
+    custom_headers = origin["CustomHeaders"]
+    assert custom_headers["Quantity"] == nr_of_headers
+    assert {
+        (header["HeaderName"], header["HeaderValue"])
+        for header in custom_headers["Items"]
+    } == {(header["HeaderName"], header["HeaderValue"]) for header in headers}
+
+
+@mock_aws
+def test_update_distribution_with_custom_headers():
+    client = boto3.client("cloudfront", region_name="us-west-1")
+    config = scaffold.example_distribution_config("custom-headers-update")
+    config["Origins"]["Items"][0]["CustomHeaders"] = {
+        "Quantity": 1,
+        "Items": [{"HeaderName": "X-Original", "HeaderValue": "original"}],
+    }
+    created = client.create_distribution(DistributionConfig=config)
+    distribution_id = created["Distribution"]["Id"]
+
+    updated_headers = [
+        {"HeaderName": "X-Updated", "HeaderValue": "updated-value"},
+        {"HeaderName": "X-Second", "HeaderValue": "second-value"},
+    ]
+    updated_config = created["Distribution"]["DistributionConfig"]
+    updated_config["Origins"]["Items"][0]["CustomHeaders"] = {
+        "Quantity": len(updated_headers),
+        "Items": updated_headers,
+    }
+
+    updated = client.update_distribution(
+        DistributionConfig=updated_config,
+        Id=distribution_id,
+        IfMatch=created["ETag"],
+    )["Distribution"]
+
+    origin = updated["DistributionConfig"]["Origins"]["Items"][0]
+    custom_headers = origin["CustomHeaders"]
+    assert custom_headers["Quantity"] == len(updated_headers)
+    assert {
+        (header["HeaderName"], header["HeaderValue"])
+        for header in custom_headers["Items"]
+    } == {("X-Updated", "updated-value"), ("X-Second", "second-value")}
+
+    config_response = client.get_distribution_config(Id=distribution_id)
+    origin = config_response["DistributionConfig"]["Origins"]["Items"][0]
+    custom_headers = origin["CustomHeaders"]
+    assert custom_headers["Quantity"] == len(updated_headers)
+    assert {
+        (header["HeaderName"], header["HeaderValue"])
+        for header in custom_headers["Items"]
+    } == {("X-Updated", "updated-value"), ("X-Second", "second-value")}
+
+
 @mock_aws
 @pytest.mark.parametrize("compress", [True, False])
 @pytest.mark.parametrize("qs", [True, False])
