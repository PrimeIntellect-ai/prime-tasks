index 8a2dddee..da68297e 100644
--- a/test/devices_tests/climate_test.py
+++ b/test/devices_tests/climate_test.py
@@ -1665,3 +1665,83 @@ class TestClimate:
             )
         )
         assert climate_percent.current_fan_speed == 55
+
+    async def test_fan_step_mode_is_controllable(self):
+        """Test reading and setting speed when fan mode is STEP."""
+        xknx = XKNX()
+        climate_step = Climate(
+            xknx,
+            name="TestClimate",
+            group_address_fan_speed="1/2/3",
+            group_address_fan_speed_state="1/2/4",
+            fan_speed_mode=FanSpeedMode.STEP,
+        )
+        xknx.devices.async_add(climate_step)
+
+        xknx.devices.process(
+            Telegram(
+                destination_address=GroupAddress("1/2/4"),
+                payload=GroupValueWrite(DPTArray(2)),
+            )
+        )
+        assert climate_step.current_fan_speed == 2
+
+        await climate_step.set_fan_speed(3)
+        telegram = xknx.telegrams.get_nowait()
+        assert telegram.destination_address == GroupAddress("1/2/3")
+        xknx.devices.process(
+            Telegram(
+                destination_address=GroupAddress("1/2/4"),
+                payload=telegram.payload,
+            )
+        )
+        assert climate_step.current_fan_speed == 3
+
+    async def test_swing(self):
+        """Test controlling vertical swing and receiving its state."""
+        xknx = XKNX()
+        climate_swing = Climate(
+            xknx,
+            name="TestClimate",
+            group_address_swing="1/2/3",
+            group_address_swing_state="1/2/4",
+        )
+        xknx.devices.async_add(climate_swing)
+
+        for desired_state in (True, False):
+            await climate_swing.set_swing(desired_state)
+            telegram = xknx.telegrams.get_nowait()
+            assert telegram.destination_address == GroupAddress("1/2/3")
+
+            # A device reporting the emitted command at its state address must
+            # report the state the caller selected, without requiring a wire DPT.
+            xknx.devices.process(
+                Telegram(
+                    destination_address=GroupAddress("1/2/4"),
+                    payload=telegram.payload,
+                )
+            )
+            assert climate_swing.current_swing is desired_state
+
+    async def test_horizontal_swing(self):
+        """Test controlling horizontal swing and receiving its state."""
+        xknx = XKNX()
+        climate_horizontal_swing = Climate(
+            xknx,
+            name="TestClimate",
+            group_address_horizontal_swing="1/2/3",
+            group_address_horizontal_swing_state="1/2/4",
+        )
+        xknx.devices.async_add(climate_horizontal_swing)
+
+        for desired_state in (True, False):
+            await climate_horizontal_swing.set_horizontal_swing(desired_state)
+            telegram = xknx.telegrams.get_nowait()
+            assert telegram.destination_address == GroupAddress("1/2/3")
+            xknx.devices.process(
+                Telegram(
+                    destination_address=GroupAddress("1/2/4"),
+                    payload=telegram.payload,
+                )
+            )
+            assert climate_horizontal_swing.current_horizontal_swing is desired_state
