diff --git a/tests/testthat/test-namespace_linter.R b/tests/testthat/test-namespace_linter.R
new file mode 100644
index 0000000..8afc698
--- /dev/null
+++ b/tests/testthat/test-namespace_linter.R
@@ -0,0 +1,67 @@
+context("namespace_linter")
+
+namespace_reference_linter <- function() {
+  candidates <- getNamespaceExports("lintr")
+  probe <- tempfile()
+  on.exit(unlink(probe))
+  writeLines("statts::sd()", probe)
+
+  for (candidate_name in candidates) {
+    value <- getExportedValue("lintr", candidate_name)
+    if (!is.function(value)) next
+
+    made <- tryCatch(value(), error = function(e) NULL)
+    options <- list(value, made)
+    for (linter in options) {
+      if (!is.function(linter)) next
+      found <- tryCatch(lintr::lint(probe, linters = list(linter)), error = function(e) NULL)
+      if (length(found) > 0L) return(linter)
+    }
+  }
+
+  stop("No exported linter checks namespace references.")
+}
+
+test_that("checks namespace references", {
+  linter <- namespace_reference_linter()
+
+  expect_lint("stats::sd",
+    NULL,
+    linter)
+
+  expect_lint("stats::sd(c(1,2,3))",
+    NULL,
+    linter)
+
+  expect_lint("\"stats\"::sd(c(1,2,3))",
+    NULL,
+    linter)
+
+  expect_lint("stats::\"sd\"(c(1,2,3))",
+    NULL,
+    linter)
+
+  expect_lint("stats::`sd`(c(1,2,3))",
+    NULL,
+    linter)
+
+  expect_lint("statts::sd(c(1,2,3))",
+    list(message = rex(".")),
+    linter)
+
+  expect_lint("stats::ssd(c(1,2,3))",
+    list(message = rex(".")),
+    linter)
+
+  expect_lint("stats:::print.formula",
+    NULL,
+    linter)
+
+  expect_lint("statts:::sd(c(1,2,3))",
+    list(message = rex(".")),
+    linter)
+
+  expect_lint("stats:::sdd(c(1,2,3))",
+    list(message = rex(".")),
+    linter)
+})
