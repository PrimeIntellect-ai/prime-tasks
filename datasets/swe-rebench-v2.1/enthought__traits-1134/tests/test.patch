+import subprocess
+import sys
+import unittest
+from unittest import mock
+
+from traits.api import HasTraits, Int
+from traits.testing.optional_dependencies import requires_traitsui
+
+
+class TestTraitsAPIImport(unittest.TestCase):
+
+    def test_importing_traits_api_does_not_import_traitsui(self):
+        code = (
+            "import sys; import traits.api; "
+            "assert 'traitsui' not in sys.modules"
+        )
+        subprocess.run([sys.executable, "-c", code], check=True)
+
+
+@requires_traitsui
+class TestTraitsUIHelper(unittest.TestCase):
+
+    def test_check_version_error(self):
+        from traits.util._traitsui_helpers import check_traitsui_major_version
+
+        with mock.patch("traitsui.__version__", "6.1.2"):
+            with self.assertRaises(RuntimeError) as exception_context:
+                check_traitsui_major_version(7)
+
+        self.assertEqual(
+            str(exception_context.exception),
+            "TraitsUI 7 or higher is required. Got version '6.1.2'"
+        )
+
+    def test_check_version_okay(self):
+        from traits.util._traitsui_helpers import check_traitsui_major_version
+
+        with mock.patch("traitsui.__version__", "7.0.0"):
+            self.assertIsNone(check_traitsui_major_version(7))
+
+        with mock.patch("traitsui.__version__", "8.2.0"):
+            self.assertIsNone(check_traitsui_major_version(7))
+
+    def test_trait_view_raises_for_old_traitsui(self):
+        # Requesting a view on a model must surface the version problem
+        # instead of silently falling back to the default view.
+        class Model(HasTraits):
+            x = Int()
+
+        model = Model()
+        with mock.patch("traitsui.__version__", "6.1.2"):
+            with self.assertRaises(RuntimeError) as exception_context:
+                model.trait_view()
+
+        self.assertEqual(
+            str(exception_context.exception),
+            "TraitsUI 7 or higher is required. Got version '6.1.2'",
+        )
+
+    def test_edit_traits_raises_for_old_traitsui(self):
+        class Model(HasTraits):
+            x = Int()
+
+        with mock.patch("traitsui.__version__", "6.1.2"):
+            with self.assertRaises(RuntimeError) as exception_context:
+                Model().edit_traits()
+
+        self.assertEqual(
+            str(exception_context.exception),
+            "TraitsUI 7 or higher is required. Got version '6.1.2'",
+        )
+
+    def test_configure_traits_raises_for_old_traitsui(self):
+        class Model(HasTraits):
+            x = Int()
+
+        with mock.patch("traitsui.__version__", "6.1.2"):
+            with self.assertRaises(RuntimeError) as exception_context:
+                Model().configure_traits()
+
+        self.assertEqual(
+            str(exception_context.exception),
+            "TraitsUI 7 or higher is required. Got version '6.1.2'",
+        )
