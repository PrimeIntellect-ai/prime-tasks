+func TestReconcileLoadBalancerProbeAnnotations(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+
+	const (
+		probeIntervalKey = "service.beta.kubernetes.io/azure-load-balancer-health-probe-interval"
+		numOfProbeKey    = "service.beta.kubernetes.io/azure-load-balancer-health-probe-num-of-probe"
+	)
+
+	testCases := []struct {
+		desc             string
+		annotations      map[string]string
+		expectedInterval *int32
+		expectedNumProbe *int32
+		expectErr        bool
+	}{
+		{
+			desc:             "default probe interval and number of probes",
+			annotations:      nil,
+			expectedInterval: to.Int32Ptr(5),
+			expectedNumProbe: to.Int32Ptr(2),
+		},
+		{
+			desc: "custom probe interval and number of probes",
+			annotations: map[string]string{
+				probeIntervalKey: "15",
+				numOfProbeKey:    "3",
+			},
+			expectedInterval: to.Int32Ptr(15),
+			expectedNumProbe: to.Int32Ptr(3),
+		},
+		{
+			desc: "custom probe interval only",
+			annotations: map[string]string{
+				probeIntervalKey: "48",
+			},
+			expectedInterval: to.Int32Ptr(48),
+			expectedNumProbe: to.Int32Ptr(2),
+		},
+		{
+			desc: "custom number of probes only",
+			annotations: map[string]string{
+				numOfProbeKey: "4",
+			},
+			expectedInterval: to.Int32Ptr(5),
+			expectedNumProbe: to.Int32Ptr(4),
+		},
+		{
+			desc: "probe interval below the minimum",
+			annotations: map[string]string{
+				probeIntervalKey: "3",
+			},
+			expectErr: true,
+		},
+		{
+			desc: "number of probes below the minimum",
+			annotations: map[string]string{
+				numOfProbeKey: "1",
+			},
+			expectErr: true,
+		},
+		{
+			desc: "probe interval is not a whole number",
+			annotations: map[string]string{
+				probeIntervalKey: "48.0",
+			},
+			expectErr: true,
+		},
+		{
+			desc: "number of probes is not a whole number",
+			annotations: map[string]string{
+				numOfProbeKey: "2.5",
+			},
+			expectErr: true,
+		},
+		{
+			desc: "total probe duration is not less than 120",
+			annotations: map[string]string{
+				probeIntervalKey: "60",
+				numOfProbeKey:    "2",
+			},
+			expectErr: true,
+		},
+		{
+			desc: "total probe duration is just below 120",
+			annotations: map[string]string{
+				probeIntervalKey: "59",
+				numOfProbeKey:    "2",
+			},
+			expectedInterval: to.Int32Ptr(59),
+			expectedNumProbe: to.Int32Ptr(2),
+		},
+	}
+
+	for i, test := range testCases {
+		az := GetTestCloud(ctrl)
+		az.Config.LoadBalancerSku = "standard"
+		service := getTestService("test1", v1.ProtocolTCP, test.annotations, false, 80)
+		probes, _, err := az.getExpectedLBRules(&service, true, "frontendIPConfigID", "backendPoolID", "lbname", to.Int32Ptr(0))
+		if test.expectErr {
+			assert.Error(t, err, "TestCase[%d]: %s", i, test.desc)
+			continue
+		}
+		if !assert.NoError(t, err, "TestCase[%d]: %s", i, test.desc) {
+			continue
+		}
+		if assert.Len(t, probes, 1, "TestCase[%d]: %s", i, test.desc) {
+			assert.Equal(t, test.expectedInterval, probes[0].IntervalInSeconds, "TestCase[%d]: %s", i, test.desc)
+			assert.Equal(t, test.expectedNumProbe, probes[0].NumberOfProbes, "TestCase[%d]: %s", i, test.desc)
+		}
+	}
+}
