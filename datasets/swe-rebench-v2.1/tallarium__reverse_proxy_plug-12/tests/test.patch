+    {"date", "Tue, 15 Nov 1994 08:12:31 GMT"}
+  ]
+
+  @host_header [
+    {"host", "example.com"}
+  ]
+
   defp get_stream_responder(status \\ 200, headers \\ [], body \\ "Success", no_chunks \\ 1) do
