+#[test]
+fn test_pause_dao_at_time() {
+    let mut app = mock_app();
+
+    let voting_period = Duration::Time(2000000);
+    let threshold = Threshold::ThresholdQuorum {
+        threshold: Decimal::percent(20),
+        quorum: Decimal::percent(10),
+    };
+    let (dao_addr, _cw20_addr, _staking_addr) = setup_test_case(
+        &mut app,
+        threshold,
+        voting_period,
+        coins(100, NATIVE_TOKEN_DENOM),
+        None,
+        None,
+    );
+
+    // Pause DAO until a point in time
+    let pause_time = app.block_info().time.plus_seconds(1000);
+    let pause_expiration = Expiration::AtTime(pause_time);
+    let wasm_msg = pause_dao_raw_wasm_message(&dao_addr, &pause_expiration);
+
+    let proposal_msg = ExecuteMsg::Propose(ProposeMsg {
+        title: String::from("Pause DAO"),
+        description: String::from("Pause governance until a point in time"),
+        msgs: vec![wasm_msg.into()],
+        latest: None,
+    });
+    let res = app
+        .execute_contract(Addr::unchecked(OWNER), dao_addr.clone(), &proposal_msg, &[])
+        .unwrap();
+    let proposal_id: u64 = res.custom_attrs(1)[2].value.parse().unwrap();
+
+    let yes_vote = ExecuteMsg::Vote(VoteMsg {
+        proposal_id,
+        vote: Vote::Yes,
+    });
+    app.execute_contract(Addr::unchecked(VOTER3), dao_addr.clone(), &yes_vote, &[])
+        .unwrap();
+
+    let execution = ExecuteMsg::Execute { proposal_id };
+    app.execute_contract(Addr::unchecked(OWNER), dao_addr.clone(), &execution, &[])
+        .unwrap();
+
+    // While paused, proposing is rejected
+    let err = app
+        .execute_contract(Addr::unchecked(OWNER), dao_addr.clone(), &proposal_msg, &[])
+        .unwrap_err();
+    assert_eq!(format!("{:?}", err.downcast::<ContractError>().unwrap()), "Paused");
+
+    // Still before the pause time, governance stays paused
+    app.update_block(|b| b.time = pause_time.minus_seconds(1));
+    let err = app
+        .execute_contract(Addr::unchecked(OWNER), dao_addr.clone(), &proposal_msg, &[])
+        .unwrap_err();
+    assert_eq!(format!("{:?}", err.downcast::<ContractError>().unwrap()), "Paused");
+
+    // Once the pause time is reached, governance resumes
+    app.update_block(|b| b.time = pause_time.plus_seconds(1));
+    let res = app.execute_contract(Addr::unchecked(OWNER), dao_addr.clone(), &proposal_msg, &[]);
+    assert!(res.is_ok());
+}
