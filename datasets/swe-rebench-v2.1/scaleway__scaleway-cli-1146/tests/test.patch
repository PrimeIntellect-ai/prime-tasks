+// TestInitCommandArgs checks that the init command exposes its standard options.
+func TestInitCommandArgs(t *testing.T) {
+	cmd := initCommand()
+
+	for _, name := range []string{
+		"secret-key",
+		"region",
+		"zone",
+		"send-telemetry",
+		"with-ssh-key",
+		"install-autocomplete",
+	} {
+		require.NotNil(t, cmd.ArgSpecs.GetByName(name),
+			"the %s argument must be part of the init command", name)
+	}
+}
