+    def test_use_with_basic_auth_applied_to_access_validation(self, cmd_devpi, reqmock):
+        import base64
+        import json as jsonlib
+        api_result = dict(
+            type="indexconfig",
+            result=dict(
+                pypisubmit="/post",
+                simpleindex="/index/",
+                index="foo/bar",
+                bases="root/pypi",
+                login="/+login",
+                authstatus=["noauth", ""]))
+        reqmock.mockresponse(
+            "http://devpi/foo/bar/+api", code=200, method="GET",
+            data=jsonlib.dumps(api_result).encode("utf-8"),
+            headers={"content-type": "application/json"})
+        seen = {}
+
+        def record_auth(request):
+            seen["authorization"] = request.headers.get("Authorization")
+
+        # the access validation request carries a query string, the stored
+        # credentials must still be applied to it
+        reqmock.mockresponse(
+            "http://devpi/foo/bar?no_projects=", code=200, method="GET",
+            data=jsonlib.dumps(dict(type="indexconfig", result=dict())).encode("utf-8"),
+            headers={"content-type": "application/json"},
+            on_request=record_auth)
+        cmd_devpi("use", "http://user:password@devpi/foo/bar")
+        expected = "Basic " + base64.b64encode(b"user:password").decode("ascii")
+        assert seen.get("authorization") == expected
+
