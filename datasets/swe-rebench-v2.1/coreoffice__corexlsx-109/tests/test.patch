+  func testWorksheetPathsAndNames() throws {
+    guard let file =
+      XLSXFile(filepath: "\(currentWorkingPath)/categories.xlsx") else {
+      XCTAssert(false, "failed to open the file")
+      return
+    }
+
+    let wbs = try file.parseWorkbooks()
+    let sheets = try file.parseWorksheetPathsAndNames(workbook: wbs[0])
+
+    // Each worksheet is associated with the name from the workbook's sheet
+    // definitions.
+    XCTAssertEqual(sheets.map { $0.name }, ["Sheet 1"])
+
+    // Each entry also carries the path of the worksheet part it describes.
+    let worksheetPaths = try file.parseWorksheetPaths()
+    XCTAssertEqual(Set(sheets.map { $0.path }), Set(worksheetPaths))
+
+    // The returned paths must actually locate worksheet parts in the package.
+    for sheet in sheets {
+      XCTAssertNoThrow(try file.parseWorksheet(at: sheet.path))
+    }
+  }
+
+  func testWorksheetPathsAndNamesUsesSuppliedWorkbook() throws {
+    guard let file =
+      XLSXFile(filepath: "\(currentWorkingPath)/categories.xlsx") else {
+      XCTAssert(false, "failed to open the file")
+      return
+    }
+
+    // The name is taken from the supplied workbook, not from the file itself.
+    let renamed = Workbook(views: nil, sheets: .init(items: [
+      .init(name: "Renamed", id: "1", relationship: "rId4"),
+    ]))
+    let renamedSheets = try file.parseWorksheetPathsAndNames(workbook: renamed)
+    XCTAssertEqual(renamedSheets.map { $0.name }, ["Renamed"])
+
+  }
+
