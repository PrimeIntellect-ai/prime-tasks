+func TestMageForwardsStdin(t *testing.T) {
+	for _, target := range []string{"forwardStdinTarget", "shellForwardStdinTarget"} {
+		t.Run(target, func(t *testing.T) {
+			c := exec.Command("go", "run", "main.go", target)
+			c.Dir = "./testdata"
+			c.Stdin = strings.NewReader("hi!")
+			actual, err := c.CombinedOutput()
+			if err != nil {
+				t.Fatalf("mage command failed: %v\n%s", err, actual)
+			}
+			if string(actual) != "hi!" {
+				t.Fatalf("expected stdin to be available to %s, got %q", target, actual)
+			}
+		})
+	}
+}
