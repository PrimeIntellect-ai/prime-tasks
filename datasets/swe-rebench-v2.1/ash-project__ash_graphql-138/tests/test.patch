diff --git a/test/resource_test.exs b/test/resource_test.exs
index e2b5368..c1ecff6 100644
--- a/test/resource_test.exs
+++ b/test/resource_test.exs
@@ -23,4 +23,88 @@ defmodule AshGraphql.ResourceTest do
     refute Map.has_key?(result, :errors)
     assert %{data: %{"noObjectCount" => [1, 2, 3, 4, 5]}} = result
   end
+
+  test "queries can be created with custom descriptions" do
+    {:ok, %{data: data}} =
+      """
+      query {
+        __schema {
+          queryType {
+            name
+            fields {
+              name
+              description
+            }
+          }
+        }
+      }
+      """
+      |> Absinthe.run(AshGraphql.Test.Schema)
+
+    get_post_with_custom_description_query =
+      data["__schema"]["queryType"]["fields"]
+      |> Enum.find(fn field -> field["name"] == "getPostWithCustomDescription" end)
+
+    assert get_post_with_custom_description_query["description"] ==
+             "A custom description"
+  end
+
+  test "queries and mutations fall back to their action descriptions" do
+    {:ok, %{data: data}} =
+      """
+      query {
+        __schema {
+          queryType {
+            fields {
+              name
+              description
+            }
+          }
+          mutationType {
+            fields {
+              name
+              description
+            }
+          }
+        }
+      }
+      """
+      |> Absinthe.run(AshGraphql.Test.Schema)
+
+    get_post_query =
+      data["__schema"]["queryType"]["fields"]
+      |> Enum.find(fn field -> field["name"] == "getPost" end)
+
+    simple_create_post_mutation =
+      data["__schema"]["mutationType"]["fields"]
+      |> Enum.find(fn field -> field["name"] == "simpleCreatePost" end)
+
+    assert get_post_query["description"] == "Description from the read action"
+    assert simple_create_post_mutation["description"] == "Description from the create action"
+  end
+
+  test "mutations can be created with custom descriptions" do
+    {:ok, %{data: data}} =
+      """
+      query {
+        __schema {
+          mutationType {
+            name
+            fields {
+              name
+              description
+            }
+          }
+        }
+      }
+      """
+      |> Absinthe.run(AshGraphql.Test.Schema)
+
+    create_post_with_custom_description_mutation =
+      data["__schema"]["mutationType"]["fields"]
+      |> Enum.find(fn field -> field["name"] == "createPostWithCustomDescription" end)
+
+    assert create_post_with_custom_description_mutation["description"] ==
+             "Another custom description"
+  end
 end
