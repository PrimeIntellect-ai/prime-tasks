+
+
+@pytest.mark.autograd
+def test_unwraps_hamiltonian_coeffs():
+    """Test that convert_to_numpy_parameters unwraps the coefficients of a
+    Hamiltonian, including the values accessible via ``Hamiltonian.coeffs``."""
+    from autograd.numpy.numpy_boxes import ArrayBox
+
+    coeffs = [ArrayBox(1.0, None, None), ArrayBox(2.0, None, None)]
+    H = qml.Hamiltonian(coeffs, [qml.PauliX(0), qml.PauliY(1)])
+    qs = qml.tape.QuantumScript([qml.RX(0.5, 0)], [qml.expval(H)])
+
+    new_qs = convert_to_numpy_parameters(qs)
+    new_H = new_qs.measurements[0].obs
+
+    assert not any(isinstance(c, ArrayBox) for c in new_H.coeffs)
+    assert qml.math.get_interface(*new_H.coeffs) == "numpy"
+    assert qml.math.get_interface(*new_H.data) == "numpy"
