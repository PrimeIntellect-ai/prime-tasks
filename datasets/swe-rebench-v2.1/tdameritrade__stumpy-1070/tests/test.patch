+def test_cache_save_and_clear_local_package_cache():
     T = np.random.rand(10)
     m = 3
-    stump(T, m)
+    local_cache_dir = Path(stumpy.__file__).parent / "__pycache__"
+    local_cache_dir.mkdir(exist_ok=True)
+    for cache_file in local_cache_dir.glob("*nb*"):
