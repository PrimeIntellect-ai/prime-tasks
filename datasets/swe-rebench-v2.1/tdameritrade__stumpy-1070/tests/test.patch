+def test_clear_defaults_to_site_packages(tmp_path):
+    site_packages = tmp_path / "site-packages"
+    installed_package = site_packages / "stumpy"
+    shutil.copytree(
+        Path(stumpy.__file__).parent,
+        installed_package,
+        ignore=shutil.ignore_patterns("__pycache__"),
+    )
+    installed_cache_dir = installed_package / "__pycache__"
+    installed_cache_dir.mkdir()
+    installed_files = [
+        installed_cache_dir / "sentinel.nbc",
+        installed_cache_dir / "sentinel.nbi",
+    ]
+    for cache_file in installed_files:
+        cache_file.touch()
+
+    working_dir = tmp_path / "user-working-directory"
+    working_dir.mkdir()
+    env = os.environ.copy()
+    env["PYTHONPATH"] = str(site_packages) + os.pathsep + env.get("PYTHONPATH", "")
+    program = (
+        "import site, warnings; "
+        f"site.getsitepackages = lambda: [{str(site_packages)!r}]; "
+        "from stumpy import cache; "
+        "warnings.simplefilter('ignore'); cache.clear()"
+    )
+    subprocess.run(
+        [sys.executable, "-c", program],
+        cwd=working_dir,
+        env=env,
+        check=True,
+    )
 
