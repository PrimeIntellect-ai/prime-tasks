-    cache.save()
-    comp_cache = cache._get_cache()
+    local_sentinel = local_cache_dir / "cache-contract.nbc"
+    local_sentinel.touch()
+    try:
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore")
+            try:
+                cache.clear(str(local_cache_dir))
