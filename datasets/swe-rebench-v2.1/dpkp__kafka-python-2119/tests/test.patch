+def test_kafka_producer_bad_init_raises_type_error():
+    with pytest.raises(TypeError):
+        KafkaProducer(bootstrap_servers=None, api_version='0.9')
+
+
+@pytest.mark.skipif(platform.python_implementation() != 'CPython',
+                    reason='Test relies on CPython-specific gc policies')
+def test_kafka_producer_bad_init_gc_no_secondary_error(monkeypatch):
+    if not hasattr(sys, 'unraisablehook'):
+        pytest.skip('sys.unraisablehook not available')
+    unraisable = []
+    monkeypatch.setattr(sys, 'unraisablehook', unraisable.append)
+
+    gc.collect()
+    raised = False
+    try:
+        KafkaProducer(bootstrap_servers=None, api_version='0.9')
+    except TypeError:
+        raised = True
+    assert raised
+    gc.collect()
+
+    # cleanup of the partially constructed producer must not raise a secondary error
+    secondary = [u for u in unraisable
+                 if getattr(u.object, '__qualname__', '').endswith('KafkaClient.__del__')]
+    assert secondary == []
+
