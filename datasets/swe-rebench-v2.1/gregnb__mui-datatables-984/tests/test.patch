+describe('<TableToolbar /> CSV download', function() {
+  it('should not fail when downloading CSV of an empty table', () => {
+    const toolbarOptions = {
+      download: true,
+      print: false,
+      search: false,
+      filter: false,
+      viewColumns: false,
+      textLabels,
+      downloadOptions: {
+        separator: ',',
+        filename: 'tableDownload.csv',
+      },
