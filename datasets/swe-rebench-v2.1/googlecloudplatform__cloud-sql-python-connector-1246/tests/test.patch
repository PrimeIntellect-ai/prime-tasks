+
+
+@pytest.mark.parametrize(
+    "domain_name, is_valid",
+    [
+        ("prod-db.mycompany.example.com", True),
+        ("example.com.", True),
+        ("_service.example", True),
+        ("a" * 63 + ".example", True),
+        ("a." + "b" * 63, True),
+        ("a." + "b" * 63 + ".", True),
+        ("-example.com", False),
+        ("example-.com", False),
+        ("a" * 64 + ".example", False),
+        ("a." + "b" * 64, False),
+        ("a.1example", False),
+        ("a._service", False),
+        ("a.example-", False),
+        ("example", False),
+        ("example..com", False),
+        ("Example.com", False),
+        ("127.0.0.1", False),
+        ("0:0:0:0:0:0:0:1", False),
+    ],
+)
+async def test_dns_resolver_validates_domain_before_lookup(
+    domain_name: str, is_valid: bool
+) -> None:
+    """Malformed domains are rejected without reaching DNS resolution."""
+    record = Mock()
+    record.to_text.return_value = '"project:region:instance"'
+    with patch(
+        "dns.asyncresolver.Resolver.resolve", return_value=[record]
+    ) as dns_lookup:
+        resolver = DnsResolver()
+        if is_valid:
+            await resolver.resolve(domain_name)
+            assert dns_lookup.await_count > 0
+        else:
+            with pytest.raises(Exception):
+                await resolver.resolve(domain_name)
+            dns_lookup.assert_not_awaited()
