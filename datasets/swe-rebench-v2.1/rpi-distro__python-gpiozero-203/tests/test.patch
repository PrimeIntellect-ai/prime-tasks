--- a/tests/test_devices.py
+++ b/tests/test_devices.py
@@ -13,5 +13,52 @@ from gpiozero.pins.mock import MockPin
 from gpiozero import *
 
 
-# TODO devices tests!
+# TODO add more devices tests!
 
+def test_device_init():
+    pin = MockPin(2)
+    device = GPIODevice(pin)
+    assert not device.closed
+    assert device.pin == pin
+
+def test_device_close():
+    pin = MockPin(2)
+    device = GPIODevice(pin)
+    device.close()
+    assert device.closed
+    assert device.pin is None
+
+def test_device_repr():
+    pin = MockPin(2)
+    device = GPIODevice(pin)
+    assert repr(device) == '<gpiozero.GPIODevice object on pin %s, is_active=False>' % pin
+
+def test_device_repr_after_close():
+    pin = MockPin(2)
+    device = GPIODevice(pin)
+    device.close()
+    assert repr(device) == '<gpiozero.GPIODevice object closed>'
+
+
+def test_input_device_repr_after_close():
+    pin = MockPin(2)
+    device = InputDevice(pin)
+    device.close()
+    assert repr(device) == '<gpiozero.InputDevice object closed>'
+
+
+def test_output_device_repr_after_close():
+    pin = MockPin(2)
+    device = LED(pin)
+    device.close()
+    assert repr(device) == '<gpiozero.LED object closed>'
+
+
+def test_subclass_repr_after_close():
+    class CustomGPIODevice(GPIODevice):
+        pass
+
+    pin = MockPin(2)
+    device = CustomGPIODevice(pin)
+    device.close()
+    assert repr(device) == '<gpiozero.CustomGPIODevice object closed>'
