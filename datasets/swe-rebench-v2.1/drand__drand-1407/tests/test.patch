+func TestJSONRoundTripPreservesPublicKey(t *testing.T) {
+	sch, err := crypto.GetSchemeFromEnv()
+	require.NoError(t, err)
+	_, group := test.BatchIdentities(t, 1, sch, "test_beacon")
+	info := NewChainInfo(group)
+
+	encoded, err := json.Marshal(info)
+	require.NoError(t, err)
+
+	var decoded Info
+	require.NoError(t, json.Unmarshal(encoded, &decoded))
+	require.True(t, info.PublicKey.Equal(decoded.PublicKey))
+}
