+    def test_debug(self, caplog):
+        caplog.set_level(logging.DEBUG)
+        session, _ = self.make_session_and_runner()
+
+        session.debug("meep")
+
+        assert "meep" in caplog.text
+
+    def test_debug_emits_at_debug_level(self, caplog):
+        caplog.set_level(logging.DEBUG)
+        session, _ = self.make_session_and_runner()
+
+        session.debug("meep")
+
+        record = next(record for record in caplog.records if record.getMessage() == "meep")
+        assert record.levelno == logging.DEBUG
+
