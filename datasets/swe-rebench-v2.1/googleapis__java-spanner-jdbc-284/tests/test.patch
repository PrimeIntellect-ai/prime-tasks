+  @Test
+  public void testLenient() throws SQLException {
+    // With lenient=true the driver should accept unknown properties and only generate a warning.
+    try (Connection connection =
+        DriverManager.getConnection(
+            String.format(
+                "jdbc:cloudspanner://localhost:%d/projects/p/instances/i/databases/d?usePlainText=true;credentials=%s;lenient=true;foo=bar",
+                server.getPort(), TEST_KEY_PATH))) {
+      assertThat(connection.isClosed()).isFalse();
+      assertThat((Throwable) connection.getWarnings()).isNotNull();
+      assertThat(connection.getWarnings().getMessage()).contains("foo");
+    }
+
+    // Without lenient the driver should throw an exception for unknown properties.
+    try (Connection connection =
+        DriverManager.getConnection(
+            String.format(
+                "jdbc:cloudspanner://localhost:%d/projects/p/instances/i/databases/d?usePlainText=true;credentials=%s;foo=bar",
+                server.getPort(), TEST_KEY_PATH))) {
+      fail("missing expected exception");
+    } catch (SQLException e) {
+      assertThat(e.getMessage()).contains("foo");
+    }
+
+    // Without lenient the driver should also reject unknown JDBC connection properties.
+    Properties properties = new Properties();
+    properties.setProperty("foo", "bar");
+    try (Connection connection =
+        DriverManager.getConnection(
+            String.format(
+                "jdbc:cloudspanner://localhost:%d/projects/p/instances/i/databases/d?usePlainText=true;credentials=%s",
+                server.getPort(), TEST_KEY_PATH),
+            properties)) {
+      fail("missing expected exception");
+    } catch (SQLException e) {
+      assertThat(e.getMessage()).contains("foo");
+    }
+  }
+
+  @Test
+  public void testLenientWithConnectionProperties() throws SQLException {
+    // With lenient=true supplied as a connection property the driver should accept unknown
+    // properties supplied as connection properties and only generate a warning.
+    Properties properties = new Properties();
+    properties.setProperty("lenient", "true");
+    properties.setProperty("foo", "bar");
+    try (Connection connection =
+        DriverManager.getConnection(
+            String.format(
+                "jdbc:cloudspanner://localhost:%d/projects/p/instances/i/databases/d?usePlainText=true;credentials=%s",
+                server.getPort(), TEST_KEY_PATH),
+            properties)) {
+      assertThat(connection.isClosed()).isFalse();
+      assertThat((Throwable) connection.getWarnings()).isNotNull();
+      assertThat(connection.getWarnings().getMessage()).contains("foo");
+    }
+  }
+
+  @Test
+  public void testLenientAppliesAcrossUrlAndConnectionProperties() throws SQLException {
+    String baseUrl =
+        String.format(
+            "jdbc:cloudspanner://localhost:%d/projects/p/instances/i/databases/d?usePlainText=true;credentials=%s",
+            server.getPort(), TEST_KEY_PATH);
+
+    // Lenient mode from the URL also applies to an unknown JDBC connection property.
+    Properties unknownProperty = new Properties();
+    unknownProperty.setProperty("foo", "bar");
+    try (Connection connection =
+        DriverManager.getConnection(baseUrl + ";lenient=true", unknownProperty)) {
+      assertThat(connection.isClosed()).isFalse();
+      assertThat((Throwable) connection.getWarnings()).isNotNull();
+      assertThat(connection.getWarnings().getMessage()).contains("foo");
+    }
+
+    // Lenient mode from JDBC connection properties also applies to an unknown URL property.
+    Properties lenientProperty = new Properties();
+    lenientProperty.setProperty("lenient", "true");
+    try (Connection connection =
+        DriverManager.getConnection(baseUrl + ";foo=bar", lenientProperty)) {
+      assertThat(connection.isClosed()).isFalse();
+      assertThat((Throwable) connection.getWarnings()).isNotNull();
+      assertThat(connection.getWarnings().getMessage()).contains("foo");
+    }
+  }
