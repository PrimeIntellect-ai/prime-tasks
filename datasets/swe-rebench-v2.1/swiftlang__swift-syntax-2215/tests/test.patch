+      var x: Int
+      """,
+      containing: ["@State", "// comment", "var x: Int"],
+      attachedAttributeAndDeclaration: "@Statevarx:Int"
+    )
+  }
+
+  func testAttributeAndEmptyAndCommentOnOwnLineBeforeVariable2() {
+    assertExpansionContains(
