+      @State
+      /*doc comment*/@Test
+      var x: Int
+      """,
+      containing: ["@State", "/*doc comment*/", "var x: Int"],
+      attachedAttributeAndDeclaration: "@Statevarx:Int"
+    )
+  }
+
+  func testEmptyBlockCommentEmpty() {
+    assertExpansionContains(
+      """
+      @Test /* comment */ @Test var value: Int
+      """,
+      containing: ["/* comment */", "var value: Int"]
+    )
+  }
+
