+import SwiftDiagnostics
+import SwiftParser
+import SwiftSyntax
+import SwiftSyntaxMacroExpansion
+import SwiftSyntaxMacros
+import SwiftSyntaxMacrosTestSupport
+import XCTest
+
+fileprivate struct NoOpPeerMacro: PeerMacro {
+  static func expansion(
+    of node: AttributeSyntax,
+    providingPeersOf declaration: some DeclSyntaxProtocol,
+    in context: some MacroExpansionContext
+  ) throws -> [DeclSyntax] {
+    return []
+  }
+}
+
+private func assertExpansionContains(
+  _ originalSource: String,
+  containing expectedFragments: [String],
+  attachedAttributeAndDeclaration: String? = nil,
+  file: StaticString = #file,
+  line: UInt = #line
+) {
+  let sourceFile = Parser.parse(source: originalSource)
+  let context = BasicMacroExpansionContext(
+    sourceFiles: [sourceFile: .init(moduleName: "TestModule", fullFilePath: "test.swift")]
+  )
+  let expandedSyntax = sourceFile.expand(
+    macros: ["Test": NoOpPeerMacro.self],
+    in: context,
+    indentationWidth: .spaces(4)
+  )
+  let expandedSource = expandedSyntax.description
+  for fragment in expectedFragments {
+    XCTAssertTrue(
+      expandedSource.contains(fragment),
+      "Expanded source did not contain \(fragment.debugDescription):\n\(expandedSource)",
+      file: file,
+      line: line
+    )
+  }
+  XCTAssertFalse(expandedSource.contains("@Test"), "The empty @Test attribute remained", file: file, line: line)
+  if let attachedAttributeAndDeclaration {
+    let commentStrippedSource = expectedFragments
+      .filter { $0.hasPrefix("//") || $0.hasPrefix("/*") }
+      .reduce(expandedSource) { $0.replacingOccurrences(of: $1, with: "") }
+    let compactedSource = commentStrippedSource.filter { !$0.isWhitespace }
+    XCTAssertTrue(
+      compactedSource.contains(attachedAttributeAndDeclaration),
+      "The surviving attribute was not attached to its declaration:\n\(expandedSource)",
+      file: file,
+      line: line
+    )
+  }
+}
+
+final class AttributeRemoverTests: XCTestCase {
+  func testEmptyOnSameLineAsVariable() {
+    assertMacroExpansion(
+      "@Test var x: Int",
+      expandedSource: "var x: Int",
+      macros: [
+        "Test": NoOpPeerMacro.self
+      ]
+    )
+  }
+
+  func testEmptyTwiceOnSameLineAsVariable() {
+    assertMacroExpansion(
+      "@Test @Test var x: Int",
+      expandedSource: "var x: Int",
+      macros: [
+        "Test": NoOpPeerMacro.self
+      ]
+    )
+  }
+
+  func testEmptyOnOwnLineBeforeVariable() {
+    assertExpansionContains(
+      """
+      @Test
+      var x: Int
+      """,
+      containing: ["var x: Int"]
+    )
+  }
+
+  func testEmptyTwiceOnOwnLineBeforeVariable() {
+    assertExpansionContains(
+      """
+      @Test @Test
+      var x: Int
+      """,
+      containing: ["var x: Int"]
+    )
+  }
+
+  func testEmptyAndAttributeOnOwnLineBeforeVariable() {
+    assertExpansionContains(
+      """
+      @Test @State
+      var x: Int
+      """,
+      containing: ["@State", "var x: Int"],
+      attachedAttributeAndDeclaration: "@Statevarx:Int"
+    )
+  }
+
+  func testAttributeAndEmptyOnOwnLineBeforeVariable() {
+    assertExpansionContains(
+      """
+      @State @Test
+      var x: Int
+      """,
+      containing: ["@State", "var x: Int"],
+      attachedAttributeAndDeclaration: "@Statevarx:Int"
+    )
+  }
+
+  func testAttributeAndEmptyAndCommentOnOwnLineBeforeVariable() {
+    assertExpansionContains(
+      """
