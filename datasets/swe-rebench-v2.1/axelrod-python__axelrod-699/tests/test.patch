@@ -0,0 +1,36 @@
+import unittest
+
+import axelrod as axl
+from axelrod import all_strategies
+
+
+class TestFilters(unittest.TestCase):
+
+    def test_filter_matches_native_boolean_classifier_values(self):
+        expected = {
+            strategy for strategy in all_strategies
+            if strategy.classifier['stochastic'] is True
+        }
+        self.assertEqual(
+            set(axl.filtered_strategies({'stochastic': True})), expected)
+        self.assertEqual(axl.filtered_strategies({'stochastic': 'true'}), [])
+
+    def test_list_filter_matches_classifier_list(self):
+        filter_value = ['game']
+        filtered = set(axl.filtered_strategies({'makes_use_of': filter_value}))
+        self.assertTrue(all(
+            set(filter_value).issubset(set(strategy.classifier['makes_use_of']))
+            for strategy in filtered
+        ))
+
+    def test_all_supplied_criteria_must_match(self):
+        filterset = {
+            'stochastic': True,
+            'inspects_source': False
+        }
+        expected = {
+            strategy for strategy in all_strategies
+            if strategy.classifier['stochastic'] == filterset['stochastic']
+            and strategy.classifier['inspects_source'] == filterset['inspects_source']
+        }
+        self.assertEqual(set(axl.filtered_strategies(filterset)), expected)
