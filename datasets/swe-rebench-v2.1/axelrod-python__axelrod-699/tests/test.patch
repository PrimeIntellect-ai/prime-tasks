+import unittest
+import axelrod as axl
+from axelrod import all_strategies
+
+
+class TestFiltersAgainstComprehensions(unittest.TestCase):
+    """
+    Test that the results of filtering strategies via a filterset dict
+    match the results from using a list comprehension.
+    """
+
+    def test_boolean_filtering(self):
+
+        classifiers = [
+            'stochastic',
+            'long_run_time',
+            'manipulates_state',
+            'manipulates_source',
+            'inspects_source']
+
+        for classifier in classifiers:
+            comprehension = set([
+                s for s in all_strategies if
+                s.classifier[classifier]])
+            filterset = {
+                classifier: True
+            }
+            filtered = set(axl.filtered_strategies(filterset))
+            self.assertEqual(comprehension, filtered)
+
+    def test_memory_depth_filtering(self):
+        for memory_depth in (1, 2, 5, 10, float('inf')):
+            comprehension = {
+                s for s in all_strategies
+                if s.classifier['memory_depth'] == memory_depth
+            }
+            filtered = set(axl.filtered_strategies({'memory_depth': memory_depth}))
+            self.assertEqual(comprehension, filtered)
+
+    def test_makes_use_of_filtering(self):
+        classifiers = [
+            ['game'],
+            ['length'],
+        ]
+
+        for classifier in classifiers:
+            filtered = set(axl.filtered_strategies({'makes_use_of': classifier}))
+            self.assertTrue(all(
+                set(classifier).issubset(set(strategy.classifier['makes_use_of']))
+                for strategy in filtered
+            ))
+
+    def test_multiple_criteria_are_all_applied(self):
+        filterset = {
+            'stochastic': True,
+            'inspects_source': False
+        }
+        expected = {
+            strategy for strategy in all_strategies
+            if strategy.classifier['stochastic'] == filterset['stochastic']
+            and strategy.classifier['inspects_source'] == filterset['inspects_source']
+        }
+        self.assertEqual(set(axl.filtered_strategies(filterset)), expected)
+
+    def test_string_boolean_values_are_not_converted(self):
+        self.assertEqual(axl.filtered_strategies({'stochastic': 'false'}), [])
