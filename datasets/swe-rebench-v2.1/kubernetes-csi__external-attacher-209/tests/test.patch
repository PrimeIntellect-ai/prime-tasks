+
+// TestModulePathIsV2 verifies that the repository is usable as a v2 Go module.
+// Go requires the module path of a major version >= 2 to end in the major
+// version suffix, otherwise requesting the module at that version is rejected
+// as an incompatible major version.
+func TestModulePathIsV2(t *testing.T) {
+	const want = "github.com/kubernetes-csi/external-attacher/v2"
+	out, err := exec.Command("go", "list", "-m").Output()
+	if err != nil {
+		t.Fatalf("failed to determine the module path: %v", err)
+	}
+	got := strings.TrimSpace(string(out))
+	if got != want {
+		t.Errorf("module path = %q, want %q", got, want)
+	}
+}
