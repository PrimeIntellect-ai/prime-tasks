+def test_series_select(dataframe):
+    """The exported selector selects Series index labels."""
+    series = dataframe.iloc[:, 0]
+    actual = jn.select(series, index="bar")
+    expected = series.loc(axis=0)[("bar", slice(None))]
+    assert_series_equal(actual, expected)
+
+
+def test_series_multiindex_selection(dataframe):
+    """Series index selection supports matching a MultiIndex level."""
+    series = dataframe.iloc[:, 0]
+    actual = jn.select(series, index={"A": "bar"})
+    expected = series.loc(axis=0)[("bar", slice(None))]
+    assert_series_equal(actual, expected)
+
+
+def test_series_axis_index(dataframe):
+    """Positional selectors with axis='index' work for the exported function."""
+    series = dataframe.iloc[:, 0]
+    actual = jn.select(series, "bar", axis="index")
+    expected = series.loc(axis=0)[("bar", slice(None))]
+    assert_series_equal(actual, expected)
+
+
+def test_series_args_and_index(dataframe):
+    """Positional args cannot be combined with index on a Series."""
+    series = dataframe.iloc[:, 0]
+    with pytest.raises(ValueError):
+        jn.select(series, "bar", index="bar")
+
+
+def test_series_invert(dataframe):
+    """invert=True drops matching Series index labels."""
+    series = dataframe.iloc[:, 0]
+    actual = jn.select(series, index="bar", invert=True)
+    expected = series.loc(axis=0)[(slice("baz", None), slice(None))]
+    assert_series_equal(actual, expected)
+
+
+def test_series_no_selection(dataframe):
+    """With no selection, the original Series is returned."""
+    series = dataframe.iloc[:, 0]
+    actual = jn.select(series)
+    assert_series_equal(actual, series)
+
+
+def test_series_flexible_selectors():
+    """The exported function supports flexible selectors for a Series."""
+    series = pd.Series(
+        [1, 2, 3, 4], index=["cobra", "viper", "sidewinder", "python"]
+    )
+    assert_series_equal(
+        jn.select(series, index="*er"), series.loc[["viper", "sidewinder"]]
+    )
+    assert_series_equal(
+        jn.select(series, index=re.compile(r"^s.*")), series.loc[["sidewinder"]]
+    )
+    assert_series_equal(
+        jn.select(series, index=slice("cobra", "sidewinder")),
+        series.loc["cobra":"sidewinder"],
+    )
+    assert_series_equal(
+        jn.select(series, index=["cobra", "viper"]), series.loc[["cobra", "viper"]]
+    )
+
