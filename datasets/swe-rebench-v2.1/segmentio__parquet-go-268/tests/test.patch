+func TestMapKeyTimestampOptionsAcrossTagForms(t *testing.T) {
+	candidates := []interface{}{
+		new(struct {
+			M map[int64]string `parquet:",key(timestamp)"`
+		}),
+		new(struct {
+			M map[int64]string `parquet:"," parquet-key:",timestamp"`
+		}),
+	}
+
+	for _, value := range candidates {
+		schema, ok := mapKeyTestSchema(value)
+		if ok && strings.Contains(schema, "key (TIMESTAMP") {
+			return
+		}
+	}
+	t.Error("no supported map-key property syntax produced a timestamp key")
+}
+
+func mapKeyTestSchema(value interface{}) (schema string, ok bool) {
+	defer func() {
+		if recover() != nil {
+			ok = false
+		}
+	}()
+	schema = parquet.SchemaOf(value).String()
+	return schema, true
+}
