+    @Test
+    public void testLocalSymbolTableAppend() throws Exception
+    {
+        writer.writeSymbol("taco");
+        writer.flush();
+        writer.writeSymbol("burrito");
+        writer.finish();
+        IonReader reader = system().newReader(writer.getBytes());
+        assertEquals(IonType.SYMBOL, reader.next());
+        assertEquals("taco", reader.stringValue());
+        assertEquals(15, reader.getSymbolTable().findSymbol("taco"));
+        assertEquals(-1, reader.getSymbolTable().findSymbol("burrito"));
+        assertEquals(IonType.SYMBOL, reader.next());
+        assertEquals("burrito", reader.stringValue());
+        assertEquals(15, reader.getSymbolTable().findSymbol("taco"));
+        assertEquals(16, reader.getSymbolTable().findSymbol("burrito"));
+        assertNull(reader.next());
+    }
+
+    @Test
+    public void testFlushImmediatelyAfterIVM() throws Exception
+    {
+        writer.flush();
+        writer.writeSymbol("burrito");
+        writer.finish();
+        IonReader reader = system().newReader(writer.getBytes());
+        assertEquals(IonType.SYMBOL, reader.next());
+        assertEquals("burrito", reader.stringValue());
+        assertEquals(-1, reader.getSymbolTable().findSymbol("taco"));
+        assertEquals(15, reader.getSymbolTable().findSymbol("burrito"));
+        assertNull(reader.next());
+    }
+
+    @Test
+    public void testNoNewSymbolsAfterFlush() throws Exception
+    {
+        writer.writeSymbol("taco");
+        writer.flush();
+        writer.writeInt(123);
+        writer.finish();
+
+        IonReader reader = system().newReader(writer.getBytes());
+        assertEquals(IonType.SYMBOL, reader.next());
+        assertEquals("taco", reader.stringValue());
+        assertEquals(15, reader.getSymbolTable().findSymbol("taco"));
+        assertEquals(IonType.INT, reader.next());
+        assertEquals(123, reader.intValue());
+        assertNull(reader.next());
+    }
+
+    @Test
+    public void testFlushWritesBufferedOutputWithoutFinalizingLST() throws Exception
+    {
+        writer.writeSymbol("taco");
+        writer.flush();
+        // The buffered value must be visible without calling finish().
+        IonReader reader = system().newReader(writer.getBytes());
+        assertEquals(IonType.SYMBOL, reader.next());
+        assertEquals("taco", reader.stringValue());
+        assertNull(reader.next());
+    }
+
+    @Test
+    public void testMultipleFlushesAppendSymbols() throws Exception
+    {
+        writer.writeSymbol("taco");
+        writer.flush();
+        writer.writeSymbol("burrito");
+        writer.flush();
+        writer.writeSymbol("nacho");
+        writer.finish();
+
+        IonReader reader = system().newReader(writer.getBytes());
+        reader.next();
+        assertEquals(15, reader.getSymbolTable().findSymbol("taco"));
+        assertEquals(-1, reader.getSymbolTable().findSymbol("burrito"));
+        assertEquals(-1, reader.getSymbolTable().findSymbol("nacho"));
+        reader.next();
+        assertEquals(15, reader.getSymbolTable().findSymbol("taco"));
+        assertEquals(16, reader.getSymbolTable().findSymbol("burrito"));
+        assertEquals(-1, reader.getSymbolTable().findSymbol("nacho"));
+        reader.next();
+        assertEquals(15, reader.getSymbolTable().findSymbol("taco"));
+        assertEquals(16, reader.getSymbolTable().findSymbol("burrito"));
+        assertEquals(17, reader.getSymbolTable().findSymbol("nacho"));
+        assertNull(reader.next());
+    }
