+    def test_compound_and_archaic_conjugation_forms_are_tagged(self):
+        self.wxr.wtp.start_page("amar")
+        self.wxr.wtp.add_page("Plantilla:lengua", 10, "Español")
+        self.wxr.wtp.add_page("Plantilla:verbo", 10, "Verbo")
+        self.wxr.wtp.add_page(
+            "Plantilla:es.v",
+            10,
+            """<div>
+{|
+|-
+! colspan=3 | Modo indicativo
+|-
+!
+! yo
+! tú
+|-
+! Pretérito perfecto compuesto
+| he amado
+| has amado
+|-
+! Pretérito imperfecto^†
+| amaba
+| amabas
+|}
+</div>""",
+        )
+        page_data = parse_page(
+            self.wxr,
+            "amar",
+            """== {{lengua|es}} ==
+=== {{verbo|es}} ===
+;1: Querer.
+=== Conjugación ===
+{{es.v}}""",
+        )
+        forms = {form["form"]: form for form in page_data[0]["forms"]}
+
+        self.assertIn("compound", forms["he amado"]["tags"])
+        self.assertIn("compound", forms["has amado"]["tags"])
+        self.assertIn("archaic", forms["amaba"]["tags"])
+        self.assertIn("archaic", forms["amabas"]["tags"])
