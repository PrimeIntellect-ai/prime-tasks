+describe('no-unsafe-references addInitScript behavior', () => {
+  const linter = new Linter()
+  const config = [
+    {
+      languageOptions: { ecmaVersion: 2022, sourceType: 'module' },
+      plugins: {
+        local: { rules: { 'no-unsafe-references': rule } },
+      },
+      rules: { 'local/no-unsafe-references': 'error' },
+    },
+  ]
+
+  for (const testCase of initScriptCases) {
+    it(`${testCase.name} reports and autofixes unsafe references`, () => {
+      expect(linter.verify(testCase.code, config)).toHaveLength(
+        testCase.errors.length,
+      )
+      expect(linter.verifyAndFix(testCase.code, config).output).not.toBe(
+        testCase.code,
+      )
+    })
+  }
+
+  it('autofix supplies a captured value so the fixed code is clean', () => {
+    const code = javascript`
+      const x = 10
+      page.addInitScript(() => x)
+    `
+    const fixed = linter.verifyAndFix(code, config).output
+
+    expect(fixed).not.toBe(code)
+    expect(fixed).toContain('page.addInitScript(')
+    expect(linter.verify(fixed, config)).toEqual([])
+  })
+})
