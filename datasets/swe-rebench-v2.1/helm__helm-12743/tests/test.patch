+
+func TestTemplateCmdWithSkipSchemaValidation(t *testing.T) {
+	chart := "testdata/testcharts/chart-with-schema-negative"
+	tests := []cmdTestCase{
+		{
+			name:      "template chart with values violating the schema fails",
+			cmd:       fmt.Sprintf("template %s", chart),
+			wantError: true,
+		},
+		{
+			name: "template chart with values violating the schema and --skip-schema-validation succeeds",
+			cmd:  fmt.Sprintf("template %s --skip-schema-validation", chart),
+		},
+	}
+	runTestCmd(t, tests)
+}
+
+func TestLintCmdWithSkipSchemaValidation(t *testing.T) {
+	chart := "testdata/testcharts/chart-with-schema-negative-skip-validation"
+	tests := []cmdTestCase{
+		{
+			name:      "lint chart with values violating the schema fails",
+			cmd:       fmt.Sprintf("lint %s", chart),
+			wantError: true,
+		},
+		{
+			name: "lint chart with values violating the schema and --skip-schema-validation succeeds",
+			cmd:  fmt.Sprintf("lint --skip-schema-validation %s", chart),
+		},
+	}
+	runTestCmd(t, tests)
+}
+
+func TestUpgradeCmdWithSkipSchemaValidation(t *testing.T) {
+	releaseName := "skip-schema-upgrade"
+	chart := "testdata/testcharts/chart-with-schema-negative"
+
+	// Without the flag the upgrade fails because the chart values violate the schema.
+	relMock, ch, _ := prepareMockRelease(releaseName, t)
+	defer resetEnv()()
+	store := storageFixture()
+	if err := store.Create(relMock(releaseName, 1, ch)); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := executeActionCommandC(store, fmt.Sprintf("upgrade %s %s", releaseName, chart)); err == nil {
+		t.Errorf("expected upgrade to fail without --skip-schema-validation")
+	}
+
+	// With the flag the upgrade succeeds.
+	relMock2, ch2, _ := prepareMockRelease(releaseName, t)
+	store2 := storageFixture()
+	if err := store2.Create(relMock2(releaseName, 1, ch2)); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := executeActionCommandC(store2, fmt.Sprintf("upgrade %s %s --skip-schema-validation", releaseName, chart)); err != nil {
+		t.Errorf("expected upgrade to succeed with --skip-schema-validation, got: %v", err)
+	}
+}
