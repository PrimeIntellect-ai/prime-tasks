+    it('requests PUT and PATCH resources with JSON object and array payloads', (done) => {
+
+        const cases = [
+            { method: 'put', payload: { my: 'object' } },
+            { method: 'put', payload: [{ value: 1 }, 'two'] },
+            { method: 'patch', payload: { my: 'object' } },
