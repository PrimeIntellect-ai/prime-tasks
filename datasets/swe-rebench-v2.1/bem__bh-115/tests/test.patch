diff --git a/test/test.options.js b/test/test.options.js
index 7e42e90..d0bafdc 100644
--- a/test/test.options.js
+++ b/test/test.options.js
@@ -1,6 +1,25 @@
 var BH = require('../lib/bh');
 require('chai').should();
 
+function normalizeJsAttribute(html) {
+    return html.replace(/\s(onclick|ondblclick)=(?:"([^"]*)"|'([^']*)')/g, function(_, name, doubleValue, singleValue) {
+        var value = doubleValue === undefined ? singleValue.replace(/"/g, '&quot;') : doubleValue;
+        return ' ' + name + '="' + value + '"';
+    });
+}
+
+function getDataBemJson(html) {
+    var attribute = html.match(/\bdata-bem='([^']*)'/);
+    attribute.should.not.equal(null);
+    var value = attribute[1]
+        .replace(/&#(?:0*39|x0*27);|&apos;/gi, "'")
+        .replace(/&quot;/g, '"')
+        .replace(/&lt;/g, '<')
+        .replace(/&gt;/g, '>')
+        .replace(/&amp;/g, '&');
+    return JSON.parse(value);
+}
+
 describe('options', function() {
     describe('jsAttr', function() {
         var bh;
@@ -8,7 +27,7 @@ describe('options', function() {
             bh = new BH();
         });
         it('should use onclick and js format as default', function() {
-            bh.apply({ block: 'button', js: true }).should.equal(
+            normalizeJsAttribute(bh.apply({ block: 'button', js: true })).should.equal(
                 '<div class="button i-bem" onclick="return {&quot;button&quot;:{}}"></div>'
             );
         });
@@ -20,7 +39,7 @@ describe('options', function() {
             bh.setOptions({
                 jsAttrName: 'ondblclick'
             });
-            bh.apply({ block: 'button', js: true }).should.equal(
+            normalizeJsAttribute(bh.apply({ block: 'button', js: true })).should.equal(
                 '<div class="button i-bem" ondblclick="return {&quot;button&quot;:{}}"></div>'
             );
         });
@@ -28,7 +47,7 @@ describe('options', function() {
             bh.setOptions({
                 jsAttrScheme: 'json'
             });
-            bh.apply({ block: 'button', js: true }).should.equal(
+            normalizeJsAttribute(bh.apply({ block: 'button', js: true })).should.equal(
                 '<div class="button i-bem" onclick="{&quot;button&quot;:{}}"></div>'
             );
         });
@@ -37,9 +56,15 @@ describe('options', function() {
                 jsAttrName: 'data-bem',
                 jsAttrScheme: 'json'
             });
-            bh.apply({ block: 'button', js: true }).should.equal(
-                '<div class="button i-bem" data-bem="{&quot;button&quot;:{}}"></div>'
-            );
+            getDataBemJson(bh.apply({ block: 'button', js: true })).should.deep.equal({ button: {} });
+        });
+        it('should safely preserve apostrophes in generated data-bem values', function() {
+            bh.setOptions({
+                jsAttrName: 'data-bem',
+                jsAttrScheme: 'json'
+            });
+            getDataBemJson(bh.apply({ block: 'button', js: { name: "O'Hara" } }))
+                .button.name.should.equal("O'Hara");
         });
     });
 });
