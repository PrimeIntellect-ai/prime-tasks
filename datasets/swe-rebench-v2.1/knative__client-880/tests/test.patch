+// computeForTest adapts to Compute implementations that either take service context
+// directly or obtain it through the command's surrounding context.
+func computeForTest(cmd *cobra.Command, targets []servingv1.TrafficTarget, trafficFlags *flags.Traffic) ([]servingv1.TrafficTarget, error) {
+	compute := reflect.ValueOf(Compute)
+	args := []reflect.Value{reflect.ValueOf(cmd), reflect.ValueOf(targets), reflect.ValueOf(trafficFlags)}
+	if compute.Type().NumIn() > len(args) {
+		args = append(args, reflect.ValueOf("serviceName"))
+	}
+	result := compute.Call(args)
+	computedTargets := result[0].Interface().([]servingv1.TrafficTarget)
+	if result[1].IsNil() {
+		return computedTargets, nil
+	}
+	return computedTargets, result[1].Interface().(error)
+}
