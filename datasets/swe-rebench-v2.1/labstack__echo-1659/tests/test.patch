+// Issue #1653
+func TestRouterPanicWhenParamNoRootOnlyChildsFailsFind(t *testing.T) {
+	e := New()
+	e.GET("/users/create", func(c Context) error {
+		return c.String(http.StatusOK, "create")
+	})
+	e.GET("/users/:id/edit", func(c Context) error {
+		return c.String(http.StatusOK, c.Param("id"))
+	})
+	e.GET("/users/:id/active", func(c Context) error {
+		return c.String(http.StatusOK, c.Param("id"))
+	})
+
+	for _, tc := range []struct {
+		path string
+		body string
+	}{
+		{path: "/users/alice/edit", body: "alice"},
+		{path: "/users/bob/active", body: "bob"},
+		{path: "/users/create", body: "create"},
+	} {
+		recorder := httptest.NewRecorder()
+		e.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, tc.path, nil))
+		assert.Equal(t, http.StatusOK, recorder.Code)
+		assert.Equal(t, tc.body, recorder.Body.String())
+	}
+
+	// This request panicked before the fix for Issue #1653.
+	recorder := httptest.NewRecorder()
+	e.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/users/createNotFound", nil))
+	assert.Equal(t, http.StatusNotFound, recorder.Code)
+}
