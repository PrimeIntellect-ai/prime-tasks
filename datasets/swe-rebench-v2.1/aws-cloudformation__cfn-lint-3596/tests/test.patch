+    def test_metadata_interface_parameter_exists(self):
+        """Warn when an interface metadata parameter is not a template parameter"""
+        config = ConfigMixIn(
+            [],
+            include_checks=["I"],
+            configure_rules={
+                "E3012": {
+                    "strict": True,
+                }
+            },
+            include_experimental=True,
+        )
+        configure_logging(None, False)
+        runner = Runner(config)
+
+        filename = "test/fixtures/templates/integration/metdata.yaml"
+        template, _ = decode_str(Path(filename).read_text())
+        matches = list(runner.validate_template(filename, template))
+        warnings = [m for m in matches if m.rule.id == "W4001"]
+        self.assertTrue(warnings)
+        self.assertTrue(
+            any(
+                m.message == "'Vpc' is not one of ['VpcId']"
+                and m.linenumber == 9
+                and m.columnnumber == 13
+                and m.linenumberend == 9
+                and m.columnnumberend == 16
+                for m in warnings
+            )
+        )
+
+        valid_template = """AWSTemplateFormatVersion: 2010-09-09
+Metadata:
+  AWS::CloudFormation::Interface:
+    ParameterGroups:
+      - Label:
+          default: Vpc Parameters
+        Parameters:
+          - VpcId
+Parameters:
+  VpcId:
+    Type: String
+Resources:
+  Test:
+    Type: AWS::S3::Bucket
+    Properties:
+      BucketName: !Ref VpcId
+"""
+        template, _ = decode_str(valid_template)
+        matches = list(runner.validate_template("valid.yaml", template))
+        self.assertEqual(
+            [m.rule.id for m in matches if m.rule.id == "W4001"],
+            [],
+        )
