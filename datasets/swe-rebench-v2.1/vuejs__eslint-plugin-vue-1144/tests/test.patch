diff --git a/tests/lib/rules/no-duplicate-attr-inheritance.js b/tests/lib/rules/no-duplicate-attr-inheritance.js
new file mode 100644
index 0000000..4e63762
--- /dev/null
+++ b/tests/lib/rules/no-duplicate-attr-inheritance.js
@@ -0,0 +1,174 @@
+/**
+ * @fileoverview Disable inheritAttrs when using v-bind=&#34;$attrs&#34;
+ * @author Hiroki Osame
+ */
+'use strict'
+
+// ------------------------------------------------------------------------------
+// Requirements
+// ------------------------------------------------------------------------------
+
+var plugin = require('../../../lib')
+var rule = plugin.rules['no-duplicate-attr-inheritance']
+var ruleModule
+try {
+  ruleModule = require('../../../lib/rules/no-duplicate-attr-inheritance')
+} catch (error) {
+  if (error.code !== 'MODULE_NOT_FOUND') {
+    throw error
+  }
+}
+var assert = require('assert')
+var Linter = require('eslint').Linter
+
+var RuleTester = require('eslint').RuleTester
+
+// ------------------------------------------------------------------------------
+// Tests
+// ------------------------------------------------------------------------------
+
+var ruleTester = new RuleTester({
+  parser: require.resolve('vue-eslint-parser'),
+  parserOptions: {
+    ecmaVersion: 2018,
+    sourceType: 'module'
+  }
+})
+if (rule) {
+  ruleTester.run('no-duplicate-attr-inheritance', rule, {
+
+  valid: [
+    {
+      filename: 'test.vue',
+      code: '<template><div><div></div></div></template>'
+    },
+    {
+      filename: 'test.vue',
+      code: `
+        <template><div><div></div></div></template>
+        <script>
+        export default { inheritAttrs: true }
+        </script>
+      `
+    },
+    {
+      filename: 'test.vue',
+      code: `
+        <template><div><div></div></div></template>
+        <script>
+        const data = {};
+        export default {
+          ...data,
+          inheritAttrs: true
+        }
+        </script>
+      `
+    },
+    {
+      filename: 'test.vue',
+      code: `
+        <template><div><div></div></div></template>
+        <script>
+        const inheritAttrs = false;
+        export default { inheritAttrs }
+        </script>
+      `
+    },
+    {
+      filename: 'test.vue',
+      code: `
+        <template><div><div v-bind="$attrs"></div></div></template>
+        <script>
+        export default { inheritAttrs: false }
+        </script>
+      `
+    },
+    {
+      filename: 'test.vue',
+      code: `
+        <template><div><div v-bind:foo="$attrs"></div></div></template>
+        <script>
+        export default {  }
+        </script>
+      `
+    }
+  ],
+
+  invalid: [
+    {
+      filename: 'test.vue',
+      code: '<template><div><div v-bind="$attrs"></div></div></template>',
+      errors: ['Set "inheritAttrs" to false.']
+    },
+    {
+      filename: 'test.vue',
+      code: `
+        <template><div><div v-bind="$attrs"></div></div></template>
+        <script>
+        export default {
+          inheritAttrs: true
+        }
+        </script>
+      `,
+      errors: ['Set "inheritAttrs" to false.']
+    }
+    ]
+  })
+}
+
+
+describe('inheritAttrs behavior', function () {
+  function lint(code) {
+    var linter = new Linter()
+    linter.defineRule('vue/no-duplicate-attr-inheritance', rule)
+    linter.defineParser('vue-eslint-parser', require('vue-eslint-parser'))
+    return linter.verify(code, {
+      parser: 'vue-eslint-parser',
+      parserOptions: { ecmaVersion: 2018, sourceType: 'module' },
+      rules: { 'vue/no-duplicate-attr-inheritance': 'error' }
+    }, 'test.vue')
+  }
+
+  it('reports a bare $attrs binding when inheritAttrs is explicitly true', function () {
+    var messages = lint(`
+      <template><div><div v-bind="$attrs"></div></div></template>
+      <script>export default { inheritAttrs: true }</script>
+    `)
+    assert.deepStrictEqual(messages.map(function (message) { return message.message }), [
+      'Set "inheritAttrs" to false.'
+    ])
+  })
+
+  it('does not report a bare $attrs binding when inheritAttrs is false', function () {
+    var messages = lint(`
+      <template><div><div v-bind="$attrs"></div></div></template>
+      <script>export default { inheritAttrs: false }</script>
+    `)
+    assert.deepStrictEqual(messages, [])
+  })
+})
+
+describe('public rule registration', function () {
+  it('reports when configured through the vue plugin rule name', function () {
+    var ruleId = 'vue/no-duplicate-attr-inheritance'
+    assert.ok(ruleModule, 'the rule must be implemented in its documented module')
+    assert.ok(rule, 'the rule must be available through the Vue plugin')
+    var linter = new Linter()
+    linter.defineRule(ruleId, plugin.rules['no-duplicate-attr-inheritance'])
+    linter.defineParser('vue-eslint-parser', require('vue-eslint-parser'))
+
+    var messages = linter.verify(
+      '<template><div><div v-bind="$attrs"></div></div></template>',
+      {
+        parser: 'vue-eslint-parser',
+        parserOptions: { ecmaVersion: 2018, sourceType: 'module' },
+        rules: { [ruleId]: 'error' }
+      },
+      'test.vue'
+    )
+
+    assert.deepStrictEqual(messages.map(function (message) { return message.message }), [
+      'Set "inheritAttrs" to false.'
+    ])
+    })
+})
