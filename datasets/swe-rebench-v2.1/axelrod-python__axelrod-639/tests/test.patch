+
+class TestContriteTitForTat(unittest.TestCase):
+
+    def test_tit_for_tat_without_noise_and_apology_after_noise(self):
+        c, d = C, D
+        candidate_strategies = axelrod.ordinary_strategies
+        opponents = [axelrod.Cooperator, axelrod.Defector,
+                     axelrod.Alternator, axelrod.TitForTat]
+
+        def matches_tit_for_tat(strategy):
+            for opponent in opponents:
+                actual = axelrod.Match(
+                    (strategy(), opponent()), turns=12).play()
+                expected = axelrod.Match(
+                    (axelrod.TitForTat(), opponent()), turns=12).play()
+                if actual != expected:
+                    return False
+            return True
+
+        def apologizes_after_noisy_defection(strategy):
+            player = strategy()
+            opponent = axelrod.TitForTat()
+            random_state = random.getstate()
+            try:
+                random.seed(31)
+                axelrod.Match((player, opponent), turns=3, noise=0.1).play()
+            finally:
+                random.setstate(random_state)
+            return (player.history[:3] == [d, c, c] and
+                    opponent.history[:3] == [c, d, c])
+
+        self.assertTrue(any(
+            matches_tit_for_tat(strategy) and
+            apologizes_after_noisy_defection(strategy)
+            for strategy in candidate_strategies
+        ))
