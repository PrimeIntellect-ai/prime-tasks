+    "be correct for global struct" in TestAstOnlyFixture(
+      """
+        |struct filesystem {
+        |	void (*open)(int a);
+        |};
+        |
+        |void my_open(int a) {
+        |	int b;
+        |	b = a;
+        |	return;
+        |}
+        |
+        |static const struct filesystem my_fs = {
+        |	.open = &my_open,
+        |};
+        |
+        |int main(int argc, char *argv[]) {
+        |	static int i;
+        |	static const struct filesystem my_other_fs = {
+        |		 .open = &my_open,
+        |	};
+        |	struct filesystem real_fs;
+        |	real_fs.open = &my_open;
+        |	i = 0;
+        |}
+      """.stripMargin
+    ) { cpg =>
+      cpg.method("main").local.name("my_other_fs").referencingIdentifiers.name.l shouldBe List("my_other_fs")
+      cpg.local.name("my_fs").referencingIdentifiers.name.l should contain ("my_fs")
+
+      // The global struct initializer must retain its designated member initializer,
+      // just like the local one does.
+      cpg
+        .local
+        .name("my_fs")
+        .referencingIdentifiers
+        .astParent
+        .isCall
+        .argument(2)
+        .astChildren
+        .astChildren
+        .code
+        .l shouldBe List(".open = &my_open")
+    }
