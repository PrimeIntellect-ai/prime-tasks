+
+func TestRateLimitSpacesOutRequests(t *testing.T) {
+	var mu sync.Mutex
+	var requestTimes []time.Time
+
+	cmd := newTestCommand(func(u *url.URL) (*fakeHTTPResponse, error) {
+		mu.Lock()
+		requestTimes = append(requestTimes, time.Now())
+		mu.Unlock()
+
+		body := []byte(nil)
+		if u.Path == "" || u.Path == "/" {
+			body = []byte(`<html><body><a href="/next">next</a><a href="/another">another</a></body></html>`)
+		}
+		return newFakeHTTPResponse(200, u.String(), "text/html", body), nil
+	})
+
+	assert.True(t, cmd.Run([]string{"--rate-limit", "2", "http://foo.com"}))
+
+	mu.Lock()
+	times := append([]time.Time(nil), requestTimes...)
+	mu.Unlock()
+	if !assert.Len(t, times, 3) {
+		return
+	}
+	elapsed := times[2].Sub(times[0])
+	assert.True(t, elapsed >= 400*time.Millisecond,
+		"three requests took only %s with a limit of 2 requests per second", elapsed)
+}
