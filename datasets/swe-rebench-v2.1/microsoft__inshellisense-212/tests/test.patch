+import { jest } from "@jest/globals";
+import wcwidth from "wcwidth";
+
+jest.unstable_mockModule("../../runtime/runtime", () => ({
+  getSuggestions: async () => ({
+    suggestions: [{ name: "美国人", allNames: ["美国人"], icon: "📀", priority: 60 }],
+  }),
+}));
+
+const { SuggestionManager } = await import("../../ui/suggestionManager");
+const { Shell } = await import("../../utils/shell");
+
+const ansiTokens = (text: string) => text.match(/\u001b\[[0-?]*[ -/]*[@-~]|./gs) ?? [];
+
+const renderedRowWidthsByColumn = (text: string) => {
+  let column = 0;
+  let rowStart = 0;
+  let rowWidth = 0;
+  const widths = new Map<number, number[]>();
+  const flush = () => {
+    if (rowWidth > 0) {
+      const rows = widths.get(rowStart) ?? [];
+      rows.push(rowWidth);
+      widths.set(rowStart, rows);
+      rowWidth = 0;
+    }
+  };
+
+  for (const token of ansiTokens(text)) {
+    if (token.startsWith("\u001b[")) {
+      const [, parameters, command] = token.match(/^\u001b\[([0-9;?]*)([A-Za-z])$/) ?? [];
+      if (!command) continue;
+      const values = parameters?.split(";").map(Number) ?? [];
+      const amount = values[0] || 1;
+      if ("ABDEFGHf".includes(command)) {
+        flush();
+        if (command === "G") column = amount - 1;
+        if (command === "H" || command === "f") column = (values[1] || 1) - 1;
+        if (command === "D") column = Math.max(0, column - amount);
+      } else if (command === "C") {
+        flush();
+        column += amount;
+      }
+      continue;
+    }
+    if (token === "\n" || token === "\r") {
+      flush();
+      column = 0;
+      continue;
+    }
+    const width = wcwidth(token);
+    if (width > 0) {
+      if (rowWidth === 0 && /^\s+$/.test(token)) {
+        column += width;
+        continue;
+      }
+      if (rowWidth === 0) rowStart = column;
+      rowWidth += width;
+      column += width;
+    }
+  }
+  flush();
+  return widths;
+};
+
+describe("dropdown box placement with wide characters", () => {
+  test("box borders line up when a suggestion contains chinese characters", async () => {
+    const term: any = {
+      cwd: "/tmp",
+      cols: 80,
+      getCommandState: () => ({ commandText: "cd 美国人" }),
+      getCursorState: () => ({ cursorX: 9, cursorY: 0, onLastLine: false, remainingLines: 20 }),
+      write: () => {},
+    };
+    const manager = new SuggestionManager(term, Shell.Bash);
+    const { data } = await manager.render(20);
+
+    const rowsByColumn = renderedRowWidthsByColumn(data);
+    const boxRows = rowsByColumn.get(term.getCursorState().cursorX) ?? [];
+    expect(boxRows.length).toBeGreaterThanOrEqual(3);
+    for (const widths of rowsByColumn.values()) {
+      expect(new Set(widths).size).toBe(1);
+    }
+  });
+});
