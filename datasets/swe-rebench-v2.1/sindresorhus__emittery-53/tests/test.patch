+
+function runWithDebugEnv(debugValue, script) {
+	const env = {...process.env};
+	delete env.DEBUG;
+	if (debugValue !== undefined) {
+		env.DEBUG = debugValue;
+	}
+
+	const result = spawnSync(process.execPath, ['-e', script], {env, encoding: 'utf8'});
+	return {status: result.status, output: `${result.stdout}${result.stderr}`};
+}
+
+const emitteryPath = JSON.stringify(path.resolve(process.cwd(), 'index.js'));
+
+for (const debugValue of ['emittery', '*']) {
+	test(`DEBUG=${debugValue} prints a trace that includes the emitted event name`, t => {
+		const script = `
+const Emittery = require(${emitteryPath});
+(async () => {
+const emitter = new Emittery();
+emitter.on('debugTraceCheck', () => {});
+await emitter.emit('debugTraceCheck', 'payload');
+})();
+`;
+		const {status, output} = runWithDebugEnv(debugValue, script);
+		t.is(status, 0);
+		t.true(output.includes('debugTraceCheck'));
+	});
+
+	test(`DEBUG=${debugValue} does not change what listeners receive`, t => {
+		const script = `
+const Emittery = require(${emitteryPath});
+(async () => {
+const emitter = new Emittery();
+const eventName = Symbol('traceSymbol');
+const received = [];
+emitter.on(eventName, data => received.push(data));
+await emitter.emit(eventName, {complex: ['data', 'structure', 1]});
+process.stdout.write('RESULT' + JSON.stringify(received));
+})();
+`;
+		const {status, output} = runWithDebugEnv(debugValue, script);
+		t.is(status, 0);
+		t.true(output.includes('RESULT[{"complex":["data","structure",1]}]'));
+	});
+}
+
+test('no event trace is printed when DEBUG is unset', t => {
+	const script = `
+const Emittery = require(${emitteryPath});
+(async () => {
+const emitter = new Emittery();
+emitter.on('debugTraceCheck', () => {});
+await emitter.emit('debugTraceCheck', 'payload');
+})();
+`;
+	const {status, output} = runWithDebugEnv(undefined, script);
+	t.is(status, 0);
+	t.false(output.includes('debugTraceCheck'));
+});
+
+test('debug tracing does not add a runtime dependency on the debug package', t => {
+	const pkg = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), 'package.json'), 'utf8'));
+	t.false(Object.keys(pkg.dependencies || {}).includes('debug'));
+});
