+class TestMixedDistribNoDeprecation(unittest.TestCase):
+    """
+    A matrix-free component that mixes distributed and non-distributed variables
+    should no longer emit a deprecation warning during setup.
+    """
+
+    def test_no_mixed_distrib_deprecation_warning(self):
+        prob = om.Problem()
+        ivc = prob.model.add_subsystem('ivc', om.IndepVarComp())
+        ivc.add_output('x_dist', shape=3, distributed=True)
+        ivc.add_output('x_nd', shape=3)
+        prob.model.add_subsystem('c', SimpleMixedDistrib2())
+        prob.model.connect('ivc.x_dist', 'c.in_dist')
+        prob.model.connect('ivc.x_nd', 'c.in_nd')
+
+        with assert_no_warning(OMDeprecationWarning):
+            prob.setup()
+
