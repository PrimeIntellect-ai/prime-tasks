+    def test_do_not_reorder_measurements(self):
+        """Measurements writing to one classical bit retain their order and behavior."""
+        coupling = CouplingMap([(0, 2), (2, 0), (1, 2), (2, 1)])
+        qc = QuantumCircuit(3, 1)
+        qc.compose(CCXGate().definition, [0, 1, 2], [], inplace=True)
+        qc.h(0)
+        qc.barrier()
+        qc.measure(0, 0)
+        qc.measure(1, 0)
+        transpiled = PassManager(SabreSwap(coupling, seed=0)).run(qc)
+
+        # Qubit 1 remains zero, so its later write must leave the shared bit at zero.
+        backend = BasicAer.get_backend("qasm_simulator")
+        basis_gates = ["u1", "u2", "u3", "cx", "id", "measure", "reset", "barrier"]
+        routed = transpile(transpiled, basis_gates=basis_gates)
+        counts = backend.run(routed, shots=128, seed_simulator=123).result().get_counts()
+        self.assertEqual(counts, {"0": 128})
+
+    def test_preserve_classical_bit_dependency_for_non_measurement_operation(self):
+        """An operation consuming a measured bit must stay after the measurement."""
+        qc = QuantumCircuit(3, 1)
+        qc.measure(0, 0)
+        qc.append(Instruction("classical_consumer", 1, 1, []), [1], [0])
+
+        transpiled = PassManager(SabreSwap(CouplingMap.from_line(3), seed=0)).run(qc)
+        operation_names = [operation.name for operation, _, _ in transpiled.data]
+        self.assertIn("classical_consumer", operation_names)
+        measure_index = operation_names.index("measure")
+        consumer_index = operation_names.index("classical_consumer")
+
+        self.assertLess(measure_index, consumer_index)
+
 
 if __name__ == "__main__":
     unittest.main()
