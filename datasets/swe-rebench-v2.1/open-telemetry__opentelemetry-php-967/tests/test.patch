diff --git a/tests/Unit/SDK/Logs/LoggerProviderBuilderTest.php b/tests/Unit/SDK/Logs/LoggerProviderBuilderTest.php
index 1187ac0..dd650dd 100644
--- a/tests/Unit/SDK/Logs/LoggerProviderBuilderTest.php
+++ b/tests/Unit/SDK/Logs/LoggerProviderBuilderTest.php
@@ -4,14 +4,18 @@ declare(strict_types=1);
 
 namespace OpenTelemetry\Tests\Unit\SDK\Logs;
 
+use OpenTelemetry\Context\ContextInterface;
 use OpenTelemetry\SDK\Logs\LoggerProvider;
 use OpenTelemetry\SDK\Logs\LoggerProviderInterface;
 use OpenTelemetry\SDK\Logs\LogRecordProcessorInterface;
+use OpenTelemetry\SDK\Logs\Processor\MultiLogsProcessor;
+use OpenTelemetry\SDK\Logs\ReadWriteLogRecord;
 use OpenTelemetry\SDK\Resource\ResourceInfo;
 use PHPUnit\Framework\TestCase;
 
 /**
  * @covers \OpenTelemetry\SDK\Logs\LoggerProviderBuilder
+ * @covers \OpenTelemetry\SDK\Logs\Processor\MultiLogsProcessor
  */
 class LoggerProviderBuilderTest extends TestCase
 {
@@ -20,9 +24,76 @@ class LoggerProviderBuilderTest extends TestCase
         $processor = $this->createMock(LogRecordProcessorInterface::class);
         $resource = $this->createMock(ResourceInfo::class);
         $provider = LoggerProvider::builder()
-            ->setLogRecordProcessor($processor)
+            ->addLogRecordProcessor($processor)
             ->setResource($resource)
             ->build();
         $this->assertInstanceOf(LoggerProviderInterface::class, $provider);
     }
+
+    public function test_add_multiple_log_record_processors(): void
+    {
+        $processor1 = $this->createMock(LogRecordProcessorInterface::class);
+        $processor2 = $this->createMock(LogRecordProcessorInterface::class);
+        $processor1->expects($this->once())->method('forceFlush')->willReturn(true);
+        $processor2->expects($this->once())->method('forceFlush')->willReturn(true);
+
+        $provider = LoggerProvider::builder()
+            ->addLogRecordProcessor($processor1)
+            ->addLogRecordProcessor($processor2)
+            ->build();
+
+        $this->assertTrue($provider->forceFlush());
+    }
+
+    public function test_multi_processor_on_emit(): void
+    {
+        $record = $this->createMock(ReadWriteLogRecord::class);
+        $context = $this->createMock(ContextInterface::class);
+        $processor1 = $this->createMock(LogRecordProcessorInterface::class);
+        $processor2 = $this->createMock(LogRecordProcessorInterface::class);
+        $processor1->expects($this->once())->method('onEmit')->with($record, $context);
+        $processor2->expects($this->once())->method('onEmit')->with($record, $context);
+
+        (new MultiLogsProcessor([$processor1, $processor2]))->onEmit($record, $context);
+    }
+
+    public function test_multi_processor_shutdown(): void
+    {
+        $processor1 = $this->createMock(LogRecordProcessorInterface::class);
+        $processor2 = $this->createMock(LogRecordProcessorInterface::class);
+        $processor1->expects($this->once())->method('shutdown')->willReturn(true);
+        $processor2->expects($this->once())->method('shutdown')->willReturn(true);
+
+        $this->assertTrue((new MultiLogsProcessor([$processor1, $processor2]))->shutdown());
+    }
+
+    public function test_multi_processor_shutdown_one_failed(): void
+    {
+        $processor1 = $this->createMock(LogRecordProcessorInterface::class);
+        $processor2 = $this->createMock(LogRecordProcessorInterface::class);
+        $processor1->expects($this->once())->method('shutdown')->willReturn(true);
+        $processor2->expects($this->once())->method('shutdown')->willReturn(false);
+
+        $this->assertFalse((new MultiLogsProcessor([$processor1, $processor2]))->shutdown());
+    }
+
+    public function test_multi_processor_force_flush(): void
+    {
+        $processor1 = $this->createMock(LogRecordProcessorInterface::class);
+        $processor2 = $this->createMock(LogRecordProcessorInterface::class);
+        $processor1->expects($this->once())->method('forceFlush')->willReturn(true);
+        $processor2->expects($this->once())->method('forceFlush')->willReturn(true);
+
+        $this->assertTrue((new MultiLogsProcessor([$processor1, $processor2]))->forceFlush());
+    }
+
+    public function test_multi_processor_force_flush_one_failed(): void
+    {
+        $processor1 = $this->createMock(LogRecordProcessorInterface::class);
+        $processor2 = $this->createMock(LogRecordProcessorInterface::class);
+        $processor1->expects($this->once())->method('forceFlush')->willReturn(true);
+        $processor2->expects($this->once())->method('forceFlush')->willReturn(false);
+
+        $this->assertFalse((new MultiLogsProcessor([$processor1, $processor2]))->forceFlush());
+    }
 }
