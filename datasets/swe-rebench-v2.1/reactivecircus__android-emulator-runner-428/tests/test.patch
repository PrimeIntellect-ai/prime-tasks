+describe('api-level handling', () => {
+  it('accepts an extension-suffixed api-level', async () => {
+    const inputs: Record<string, string> = {
+      'api-level': '35-ext15',
+      'system-image-api-level': '36-ext16',
+      target: 'default',
+      arch: 'x86',
+      'force-avd-creation': 'true',
+      'emulator-boot-timeout': '600',
+      'emulator-port': '5554',
+      'disable-animations': 'true',
+      'disable-spellchecker': 'false',
+      'disable-linux-hw-accel': 'auto',
+      'enable-hw-keyboard': 'false',
+      channel: 'stable',
+      script: 'echo hello',
+    };
+    (core.getInput as unknown as jest.Mock).mockImplementation((name: string) => inputs[name] ?? '');
+    require('../src/main');
+    // allow the action's async run() to complete; all of its dependencies are mocked
+    await new Promise((resolve) => setTimeout(resolve, 1000));
+    const commands = (exec.exec as jest.Mock).mock.calls.map(([command, args]) => `${command} ${args ?? ''}`);
+    expect(commands.some((command) => command.includes('system-images;android-36-ext16;'))).toBe(true);
+    expect(core.setFailed).not.toHaveBeenCalled();
+  });
+
+  it('uses the suffixed api-level for the system image when no override is supplied', async () => {
+    const inputs: Record<string, string> = {
+      'api-level': '35-ext15',
+      target: 'default',
+      arch: 'x86',
+      'force-avd-creation': 'true',
+      'emulator-boot-timeout': '600',
+      'emulator-port': '5554',
+      'disable-animations': 'true',
+      'disable-spellchecker': 'false',
+      'disable-linux-hw-accel': 'auto',
+      'enable-hw-keyboard': 'false',
+      channel: 'stable',
+      script: 'echo hello',
+    };
+    jest.resetModules();
+    const freshCore = require('@actions/core');
+    const freshExec = require('@actions/exec');
+    (freshCore.getInput as jest.Mock).mockImplementation((name: string) => inputs[name] ?? '');
+    require('../src/main');
+    await new Promise((resolve) => setTimeout(resolve, 1000));
+    const commands = (freshExec.exec as jest.Mock).mock.calls.map(([command, args]) => `${command} ${args ?? ''}`);
+    expect(commands.some((command) => command.includes('system-images;android-35-ext15;'))).toBe(true);
+  });
