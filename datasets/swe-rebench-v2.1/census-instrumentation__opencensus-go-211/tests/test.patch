+// TestStatsRepositoryUsesStandardContextOutsideGRPC verifies that non-gRPC packages use the
+// standard library context package rather than another context package.
+func TestStatsRepositoryUsesStandardContextOutsideGRPC(t *testing.T) {
+	_, thisFile, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("unable to locate the test source file")
+	}
+	root := filepath.Dir(filepath.Dir(thisFile))
+	err := filepath.Walk(root, func(path string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		if info.IsDir() {
+			if info.Name() == ".git" {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if !strings.HasSuffix(path, ".go") {
+			return nil
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		// The gRPC integration trees are the only packages exempt from this
+		// requirement.
+		if strings.HasPrefix(rel, "plugin/grpc/") || strings.HasPrefix(rel, "examples/grpc/") {
+			return nil
+		}
+		fset := token.NewFileSet()
+		f, err := parser.ParseFile(fset, path, nil, parser.ImportsOnly)
+		if err != nil {
+			return err
+		}
+		for _, imp := range f.Imports {
+			if imp.Path == nil {
+				continue
+			}
+			importPath := strings.Trim(imp.Path.Value, `"`)
+			if filepath.Base(importPath) == "context" && importPath != "context" {
+				t.Errorf("%s imports %s; non-gRPC packages must use the standard library context package", rel, importPath)
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
