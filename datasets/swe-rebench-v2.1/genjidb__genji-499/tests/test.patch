+
+	INSERT INTO foo (a, b) VALUES
+		(1, 'sample text 1'),
+		(2, 'sample text 2');
+	`)
+	assert.NoError(t, err)
+
+	res, err := db.Query(`SELECT * FROM foo ORDER BY a DESC`)
+	assert.NoError(t, err)
+	defer res.Close()
+
+	type item struct {
+		A int
+		B string
+	}
+
+	var items []item
+	err = document.ScanIterator(res, &items)
+	assert.NoError(t, err)
+
+	require.Equal(t, []item{
+		{A: 2, B: "sample text 2"},
+		{A: 1, B: "sample text 1"},
+	}, items)
+}
