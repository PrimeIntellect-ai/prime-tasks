+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+import pytest
+
+from cfnlint.core import get_rules, run_checks
+from cfnlint.jsonschema import ValidationError
+
+
+@pytest.fixture(scope="module")
+def rule():
+    return get_rules([], [], ["E3695"]).rules["E3695"]
+
+
+def test_rule_metadata(rule):
+    assert rule.id == "E3695"
+    assert rule.tags == ["resources"]
+    assert (
+        rule.source_url
+        == "https://docs.aws.amazon.com/AmazonElastiCache/latest/dg/supported-engine-versions.html"
+    )
+    assert (
+        rule.description
+        == "Validate the Elasticache cluster engine along with the engine version"
+    )
+
+
+@pytest.mark.parametrize("engine", ["memcached", "redis", "valkey"])
+def test_allowed_engine_values(engine, rule, validator):
+    errors = list(rule.validate(validator, "", {"Engine": engine}, {}))
+    assert not [
+        error
+        for error in errors
+        if isinstance(error, ValidationError)
+        and error.validator == "enum"
+        and list(error.path) == ["Engine"]
+    ]
+
+
+@pytest.mark.parametrize(
+    "version", ["4.0.10", "5.0.6", "6.0", "6.2", "7.0", "7.1"]
+)
+def test_allowed_redis_versions(version, rule, validator):
+    errors = list(
+        rule.validate(validator, "", {"Engine": "redis", "EngineVersion": version}, {})
+    )
+    assert not [
+        error
+        for error in errors
+        if isinstance(error, ValidationError)
+        and error.validator == "enum"
+        and list(error.path) == ["EngineVersion"]
+    ]
+
+
+@pytest.mark.parametrize(
+    "instance,offending_property",
+    [
+        ({"Engine": "redis", "EngineVersion": "7.1.0"}, "EngineVersion"),
+        ({"Engine": "oss-redis"}, "Engine"),
+        ({"Engine": "redis", "EngineVersion": "9.9"}, "EngineVersion"),
+    ],
+)
+def test_invalid_values_report_enum_validation_error(
+    instance, offending_property, rule, validator
+):
+    errors = list(rule.validate(validator, "", instance, {}))
+    assert any(
+        isinstance(error, ValidationError)
+        and error.validator == "enum"
+        and list(error.path) == [offending_property]
+        for error in errors
+    )
+
+
+@pytest.mark.parametrize(
+    "instance",
+    [
+        {"Engine": "redis"},
+        {},
+        {"Engine": "redis", "EngineVersion": {"Ref": "AWS::AccountId"}},
+    ],
+)
+def test_missing_or_intrinsic_values_are_not_enum_violations(instance, rule, validator):
+    errors = list(rule.validate(validator, "", instance, {}))
+    assert not [
+        error
+        for error in errors
+        if isinstance(error, ValidationError) and error.validator == "enum"
+    ]
+
+
+@pytest.mark.parametrize(
+    "resource_type,should_report",
+    [
+        ("AWS::ElastiCache::CacheCluster", True),
+        ("AWS::ElastiCache::ReplicationGroup", False),
+    ],
+)
+def test_rule_applies_to_cache_cluster_only(resource_type, should_report):
+    template = {
+        "Resources": {
+            "Cache": {
+                "Type": resource_type,
+                "Properties": {"Engine": "redis", "EngineVersion": "7.1.0"},
+            }
+        }
+    }
+    matches = run_checks(
+        "template.yaml", template, get_rules([], [], ["E3695"]), ["us-east-1"]
+    )
+    engine_version_matches = [
+        match
+        for match in matches
+        if match.rule.id == "E3695"
+        and list(match.path) == ["Resources", "Cache", "Properties", "EngineVersion"]
+    ]
+    assert bool(engine_version_matches) is should_report
+
+
+def test_unquoted_numeric_redis_version_is_valid():
+    template = {
+        "Resources": {
+            "Cache": {
+                "Type": "AWS::ElastiCache::CacheCluster",
+                "Properties": {
+                    "Engine": "redis",
+                    "EngineVersion": 7.1,
+                    "CacheNodeType": "cache.t4g.micro",
+                    "NumCacheNodes": 1,
+                },
+            }
+        }
+    }
+    matches = run_checks(
+        "template.yaml", template, get_rules([], [], ["E3695"]), ["us-east-1"]
+    )
+    assert not [
+        match
+        for match in matches
+        if match.rule.id == "E3695"
+        and list(match.path)
+        == ["Resources", "Cache", "Properties", "EngineVersion"]
+    ]
