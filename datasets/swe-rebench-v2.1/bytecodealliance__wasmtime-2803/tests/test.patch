+#[test]
+fn trap_doesnt_leak_instances() -> anyhow::Result<()> {
+    // Reproduces the scenario from the issue: a host function that traps is
+    // called from Wasm, and each iteration creates a fresh `Store`/instance
+    // with a grown memory. If the trap leaks the store (and therefore the
+    // host function's captured state), the canary is never dropped.
+    struct Canary(Arc<AtomicBool>);
+
+    impl Drop for Canary {
+        fn drop(&mut self) {
+            self.0.store(true, SeqCst);
+        }
+    }
+
+    let wat = r#"
+        (module
+            (import "" "" (func $host_hello))
+            (memory (export "memory") 0)
+            (func (export "hello") call $host_hello)
+        )
+    "#;
+
+    let mut canaries = Vec::new();
+    for _ in 0..4 {
+        let store = Store::default();
+        let module = Module::new(store.engine(), wat)?;
+
+        let canary = Canary(Arc::new(AtomicBool::new(false)));
+        let dtor_run = canary.0.clone();
+        let host_hello = Func::wrap(&store, move || -> Result<(), Trap> {
+            drop(&canary);
+            Err(Trap::new("it's a trap"))
+        });
+
+        let instance = Instance::new(&store, &module, &[host_hello.into()])?;
+
+        // Grow the memory so that any leaked per-instance allocation is
+        // meaningful, mirroring the original reproducer.
+        let mem = instance.get_memory("memory").unwrap();
+        mem.grow(10)?;
+
+        let hello = instance.get_typed_func::<(), ()>("hello")?;
+        assert!(hello.call(()).is_err());
+
+        // Dropping the store must release the host function's captured state.
+        drop((store, module, instance));
+        canaries.push(dtor_run);
+    }
+
+    for dtor_run in canaries {
+        assert!(dtor_run.load(SeqCst));
+    }
+    Ok(())
+}
