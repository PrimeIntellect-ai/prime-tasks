+func TestLegacyCFilterDeprecationDocumentation(t *testing.T) {
+	for _, method := range []string{"getcfilter", "getcfilterheader"} {
+		doc, err := os.ReadFile("../../docs/json_rpc_api.mediawiki")
+		if err != nil {
+			t.Fatalf("unable to read JSON API documentation: %v", err)
+		}
+		text := string(doc)
+		start := strings.Index(text, "===="+method+"====")
+		if start < 0 {
+			t.Fatalf("JSON API documentation has no %s entry", method)
+		}
+		section := text[start+len("===="+method+"===="):]
+		if end := strings.Index(section, "===="); end >= 0 {
+			section = section[:end]
+		}
+		if !strings.Contains(strings.ToLower(section), "deprecated") ||
+			!strings.Contains(section, "getcfilterv2") {
+			t.Errorf("JSON API documentation for %s must identify deprecation and refer to getcfilterv2", method)
+		}
+
+		help, err := newHelpCacher().rpcMethodHelp(types.Method(method))
+		if err != nil {
+			t.Fatalf("unable to generate RPC help for %s: %v", method, err)
+		}
+		if !strings.Contains(strings.ToLower(help), "deprecated") ||
+			!strings.Contains(strings.ToLower(help), "getcfilterv2") {
+			t.Errorf("RPC help for %s must identify deprecation and refer to the version 2 filter command", method)
+		}
+	}
+}
