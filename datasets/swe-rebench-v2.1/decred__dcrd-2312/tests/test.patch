+func TestLegacyCFilterGoDocumentation(t *testing.T) {
+	for _, tc := range []struct {
+		packagePath string
+		symbol      string
+		v2Reference string
+	}{
+		{"github.com/decred/dcrd/blockchain/v3/indexers", "CFIndex.FilterByBlockHash", "FilterByBlockHash"},
+		{"github.com/decred/dcrd/blockchain/v3/indexers", "CFIndex.FilterHeaderByBlockHash", "FilterByBlockHash"},
+	} {
+		output, err := exec.Command("go", "doc", tc.packagePath, tc.symbol).CombinedOutput()
+		if err != nil {
+			t.Fatalf("unable to obtain Go documentation for %s: %v\n%s", tc.symbol, err, output)
+		}
+		doc := strings.ToLower(string(output))
+		if !strings.Contains(doc, "deprecated") ||
+			!strings.Contains(doc, strings.ToLower(tc.v2Reference)) {
+			t.Errorf("Go documentation for %s must identify deprecation and refer to its version 2 alternative", tc.symbol)
+		}
+	}
+}
