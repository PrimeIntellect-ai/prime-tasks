+
+    def test_to_csv_escape_quotechar(self):
+        # GH61514
+        df = DataFrame([['a', 'b"c', 'def"'], ['a2', None, '"c']])
+
+        result = df.to_csv(
+            sep="\t",
+            index=False,
+            header=False,
+            quotechar='"',
+            escapechar="\\",
+            quoting=csv.QUOTE_NONE,
+        )
+        expected = 'a\tb\\"c\tdef\\"\na2\t\t\\"c\n'
+        assert result == expected
