+def test_outside_marker_is_painted_before_list_item():
+    image = Image.open(io.BytesIO(HTML(string="""
+      <style>
+        @page { size: 300px 100px; margin: 0 }
+        body { margin: 0 }
+        ul { margin: 0; padding: 0; list-style: disc outside }
+        li {
+          margin-left: 20px; padding-left: 50px;
+          border-left: 2px solid blue;
+        }
+        li::marker { color: red }
+      </style>
+      <ul><li>abc</li></ul>
+    """).write_png())).convert('RGB')
+    marker_x = []
+    item_edge_x = []
+    for y in range(image.height):
+        for x in range(image.width):
+            red, green, blue = image.getpixel((x, y))
+            if red > 150 and red > green * 1.5 and red > blue * 1.5:
+                marker_x.append(x)
+            elif blue > 150 and blue > red * 1.5 and blue > green * 1.5:
+                item_edge_x.append(x)
+    assert marker_x
+    assert item_edge_x
+    assert max(marker_x) < min(item_edge_x)
+
