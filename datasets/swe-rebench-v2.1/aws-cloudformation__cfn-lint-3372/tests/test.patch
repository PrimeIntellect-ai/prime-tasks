+def test_list_number_integer_default_does_not_emit_e1019():
+    template = """
+AWSTemplateFormatVersion: "2010-09-09"
+Parameters:
+  A:
+    Type: String
+  B:
+    Type: List<Number>
+    Default: 20
+Resources:
+  Topic:
+    Type: AWS::SNS::Topic
+    Properties:
+      DisplayName: !Sub "${A}-text"
+      TopicName: !Sub "${A}-text"
+"""
+
+    matches = lint(template)
+    e1019 = [match for match in matches if match.rule.id == "E1019"]
+
+    assert e1019 == [], f"Unexpected E1019 errors: {e1019!r}"
+
+
+def test_invalid_list_number_default_is_reported_at_its_source_line():
+    template = """
+AWSTemplateFormatVersion: "2010-09-09"
+Parameters:
+  A:
+    Type: String
+  B:
+    Type: List<Number>
+    Default: 30
+    AllowedValues:
+      - "10,20"
+Resources:
+  Topic:
+    Type: AWS::SNS::Topic
+    Properties:
+      DisplayName: !Sub "${A}-text"
+      TopicName: !Sub "${A}-text-${A}"
+      KmsMasterKeyId: !Ref A
+"""
+
+    matches = lint(template)
+    default_errors = [
+        match
+        for match in matches
+        if match.path_string == "Parameters/B/Default"
+    ]
+    e1019 = [match for match in matches if match.rule.id == "E1019"]
+
+    assert len(default_errors) == 1
+    assert default_errors[0].linenumber == 8
+    assert e1019 == []
+
+
+def test_other_parameters_remain_available_for_lint_validation():
+    template = """
+AWSTemplateFormatVersion: "2010-09-09"
+Parameters:
+  A:
+    Type: String
+    Default: "BAD NAME"
+  B:
+    Type: List<Number>
+    Default: 20
+Resources:
+  Bucket:
+    Type: AWS::S3::Bucket
+    Properties:
+      BucketName: !Sub "${A}"
+"""
+
+    matches = lint(template)
+    bucket_name_errors = [match for match in matches if "does not match" in match.message]
+
+    assert bucket_name_errors
