+func TestJetStreamDisabledHealthzInConfig(t *testing.T) {
+	s := RunRandClientPortServer()
+	defer s.Shutdown()
+
+	if s.JetStreamEnabled() {
+		t.Fatalf("Expected JetStream to be disabled")
+	}
+
+	// Start the monitoring endpoint so the /healthz handler can be queried.
+	opts := s.getOpts()
+	opts.HTTPHost = "127.0.0.1"
+	opts.HTTPPort = -1
+	require_NoError(t, s.StartMonitoring())
+
+	// JetStream is disabled in the config, so the health check should be ok
+	// even when only the enabled state is requested.
+	resp, err := http.Get(fmt.Sprintf("http://%s/healthz?js-enabled-only=true", s.MonitorAddr()))
+	if err != nil {
+		t.Fatalf("Error getting healthz: %v", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		t.Fatalf("Expected 200, got %d", resp.StatusCode)
+	}
+	var hs HealthStatus
+	if err := json.NewDecoder(resp.Body).Decode(&hs); err != nil {
+		t.Fatalf("Error decoding healthz response: %v", err)
+	}
+	if hs.Status != "ok" {
+		t.Fatalf("Expected ok status, got %q", hs.Status)
+	}
+}
