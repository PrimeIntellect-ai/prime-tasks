+func TestJetStreamHealthzChecksMetaState(t *testing.T) {
+	c := createJetStreamClusterExplicit(t, "HZC", 3)
+	defer c.shutdown()
+
+	s := c.randomServer()
+	if s == nil {
+		t.Fatal("Expected a running cluster server")
+	}
+	opts := s.getOpts()
+	opts.HTTPHost = "127.0.0.1"
+	opts.HTTPPort = -1
+	require_NoError(t, s.StartMonitoring())
+
+	// Leave a single server running so the Meta group cannot maintain a leader.
+	for _, member := range c.servers {
+		if member != s {
+			member.Shutdown()
+		}
+	}
+
+	request := func(query string) int {
+		t.Helper()
+		url := fmt.Sprintf("http://%s/healthz", s.MonitorAddr())
+		if query != "" {
+			url += "?" + query
+		}
+		resp, err := http.Get(url)
+		require_NoError(t, err)
+		defer resp.Body.Close()
+		return resp.StatusCode
+	}
+
+	checkFor(t, 5*time.Second, 100*time.Millisecond, func() error {
+		if status := request(""); status != http.StatusServiceUnavailable {
+			return fmt.Errorf("expected health check without parameters to include meta state, got HTTP %d", status)
+		}
+		return nil
+	})
+
+	if status := request("js-enabled-only=true"); status != http.StatusOK {
+		t.Fatalf("enabled-only check should stop before checking meta state, got HTTP %d", status)
+	}
+	if status := request("js-server-only=true"); status != http.StatusServiceUnavailable {
+		t.Fatalf("server-only check should report unavailable without a Meta Leader, got HTTP %d", status)
+	}
+}
