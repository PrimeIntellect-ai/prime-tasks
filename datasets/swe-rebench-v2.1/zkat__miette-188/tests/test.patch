+    fn remove_causes_fields(json: &str) -> String {
+        let mut result = json.to_string();
+        while let Some(key_start) = result.find("\"causes\"") {
+            let bytes = result.as_bytes();
+            let mut value_start = result[key_start..].find(':').unwrap() + key_start + 1;
+            while bytes[value_start].is_ascii_whitespace() {
+                value_start += 1;
+            }
+            let mut value_end = value_start;
+            let mut depth = 0usize;
+            let mut in_string = false;
+            let mut escaped = false;
+            while value_end < bytes.len() {
+                let byte = bytes[value_end];
+                if in_string {
+                    if escaped {
+                        escaped = false;
+                    } else if byte == b'\\' {
+                        escaped = true;
+                    } else if byte == b'"' {
+                        in_string = false;
+                    }
+                } else {
+                    match byte {
+                        b'"' => in_string = true,
+                        b'[' | b'{' => depth += 1,
+                        b']' | b'}' if depth > 0 => {
+                            depth -= 1;
+                            if depth == 0 {
+                                value_end += 1;
+                                break;
+                            }
+                        }
+                        b',' | b'}' if depth == 0 => break,
+                        _ => {}
+                    }
+                }
+                value_end += 1;
+            }
+            let mut remove_start = key_start;
+            let mut remove_end = value_end;
+            while remove_end < bytes.len() && bytes[remove_end].is_ascii_whitespace() {
+                remove_end += 1;
+            }
+            if remove_end < bytes.len() && bytes[remove_end] == b',' {
+                remove_end += 1;
+            } else {
+                while remove_start > 0 && bytes[remove_start - 1].is_ascii_whitespace() {
+                    remove_start -= 1;
+                }
+                if remove_start > 0 && bytes[remove_start - 1] == b',' {
+                    remove_start -= 1;
+                }
+            }
+            result.replace_range(remove_start..remove_end, "");
+        }
+        result
+    }
+
+    fn has_empty_causes(json: &str) -> bool {
+        let Some(key_start) = json.find("\"causes\"") else {
+            return false;
+        };
+        let Some(colon) = json[key_start..].find(':') else {
+            return false;
+        };
+        json[key_start + colon + 1..].trim_start().starts_with("[]")
+    }
+
