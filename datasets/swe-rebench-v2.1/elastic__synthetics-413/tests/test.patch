index 146880e..03cc8ce 100644
--- a/__tests__/core/runner.test.ts
+++ b/__tests__/core/runner.test.ts
@@ -655,4 +655,39 @@ describe('runner', () => {
       },
     });
   });
+
+  it('run - screenshot blocks must be timestamped before step and journey end', async () => {
+    const j1 = journey('journey1', async ({ page }) => {
+      step('step1', async () => {
+        await page.goto(server.TEST_PAGE);
+      });
+    });
+    runner.addJourney(j1);
+    await runner.run({
+      reporter: 'json',
+      screenshots: 'on',
+      ssblocks: true,
+      wsEndpoint,
+      outfd: fs.openSync(dest, 'w'),
+    });
+
+    const events = readAndCloseStreamJson();
+    const blocks = events.filter(event => event.type === 'screenshot/block');
+    const stepEnd = events.find(event => event.type === 'step/end');
+    const journeyEnd = events.find(event => event.type === 'journey/end');
+
+    expect(blocks.length).toBeGreaterThan(0);
+    expect(stepEnd).toBeDefined();
+    expect(journeyEnd).toBeDefined();
+    /**
+     * Screenshot blocks must carry the time the screenshot was taken, which
+     * is before the step and journey end events.
+     */
+    for (const block of blocks) {
+      expect(block['@timestamp']).toBeLessThanOrEqual(stepEnd['@timestamp']);
+      expect(block['@timestamp']).toBeLessThanOrEqual(
+        journeyEnd['@timestamp']
+      );
+    }
+  });
 });
