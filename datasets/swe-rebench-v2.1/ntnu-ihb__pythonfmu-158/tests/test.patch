+import pytest
+from pathlib import Path
+
+from pythonfmu import DefaultExperiment as PackageDefaultExperiment
+from pythonfmu.csvbuilder import FmuBuilder
+from pythonfmu.fmi2slave import DefaultExperiment
+
+
+def test_default_experiment_exposes_start_time():
+    supplied_start_time = 2.5
+
+    assert DefaultExperiment(start_time=supplied_start_time).start_time == supplied_start_time
+    assert PackageDefaultExperiment(start_time=supplied_start_time).start_time == supplied_start_time
+
+
+def test_default_experiment(tmp_path):
+    fmpy = pytest.importorskip(
+        "fmpy", reason="fmpy is not available for testing the produced FMU"
+    )
+
+    script_file = Path(__file__).parent / "slaves/pythonslave_read_file.py"
+    project_file = Path(__file__).parent / "data/hello.txt"
+    fmu = FmuBuilder.build_FMU(script_file, project_files=[project_file], dest=tmp_path, needsExecutionTool="false")
+    assert fmu.exists()
+
+    model_description = fmpy.read_model_description(fmu)
+
+    default_experiment = model_description.defaultExperiment
+    assert default_experiment is not None
+    assert default_experiment.startTime is not None
+    assert float(default_experiment.startTime) == 0.25
+    assert float(default_experiment.stopTime) == 1.75
