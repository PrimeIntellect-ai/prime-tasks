+describe('GCP Secrets Manager isBinary', () => {
+  const originalJson = '{"type":"service_account"}'
+  const encodedSecret = Buffer.from(originalJson, 'utf8').toString('base64')
+  let client
+  let backend
+
+  beforeEach(() => {
+    client = {
+      accessSecretVersion: sinon.stub().resolves([
+        { payload: { data: Buffer.from(encodedSecret, 'utf8') } }
+      ])
+    }
+    backend = new GCPSecretsManagerBackend({
+      logger: { info: sinon.stub(), warn: sinon.stub() },
+      client
+    })
+  })
+
+  it('makes an already base64 encoded secret available as binary file contents', async () => {
+    const data = await backend.getSecretManifestData({
+      spec: {
+        data: [{ name: 'credentials.json', key: 'service-account', isBinary: true }]
+      }
+    })
+
+    expect(Buffer.from(data['credentials.json'], 'base64').toString('utf8')).to.equal(originalJson)
+  })
+})
