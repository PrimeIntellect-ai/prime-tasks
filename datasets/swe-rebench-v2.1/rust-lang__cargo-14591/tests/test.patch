+/// Like [`cargo_test_support::publish::validate_crate_contents`], but the
+/// `autolib = false` line that packaging adds to the manifest is not required.
+pub(crate) fn validate_crate_contents(
+    mut reader: impl Read,
+    expected_crate_name: &str,
+    expected_files: &[&str],
+    expected_contents: &[(&str, &str)],
+) {
+    let mut bytes = Vec::new();
+    reader.read_to_end(&mut bytes).unwrap();
+    let (manifest, others) = split_manifest(expected_contents);
+    cargo_test_support::publish::validate_crate_contents(
+        &bytes[..],
+        expected_crate_name,
+        expected_files,
+        &others,
+    );
+    if let Some(expected) = manifest {
+        assert_packaged_manifest(&bytes, expected_crate_name, expected);
+    }
+}
+
+/// Like [`cargo_test_support::publish::validate_upload_with_contents`], but the
+/// `autolib = false` line that packaging adds to the manifest is not required.
+pub(crate) fn validate_upload_with_contents(
+    expected_json: &str,
+    expected_crate_name: &str,
+    expected_files: &[&str],
+    expected_contents: &[(&str, &str)],
+) {
+    let (manifest, others) = split_manifest(expected_contents);
+    cargo_test_support::publish::validate_upload_with_contents(
+        expected_json,
+        expected_crate_name,
+        expected_files,
+        &others,
+    );
+    if let Some(expected) = manifest {
+        let bytes = uploaded_crate_bytes();
+        assert_packaged_manifest(&bytes, expected_crate_name, expected);
+    }
+}
+
+fn split_manifest<'a>(
+    contents: &[(&'a str, &'a str)],
+) -> (Option<&'a str>, Vec<(&'a str, &'a str)>) {
+    let manifest = contents
+        .iter()
+        .find(|(name, _)| *name == "Cargo.toml")
+        .map(|(_, expected)| *expected);
+    let others = contents
+        .iter()
+        .filter(|(name, _)| *name != "Cargo.toml")
+        .copied()
+        .collect();
+    (manifest, others)
+}
+
+/// Returns the crate file of the most recent upload to the test registry.
+fn uploaded_crate_bytes() -> Vec<u8> {
+    let mut f = File::open(registry::api_path().join("api/v1/crates/new")).unwrap();
+    let mut len = [0u8; 4];
+    f.read_exact(&mut len).unwrap();
+    f.seek(SeekFrom::Current(u32::from_le_bytes(len) as i64))
+        .unwrap();
+    f.read_exact(&mut len).unwrap();
+    let mut bytes = vec![0; u32::from_le_bytes(len) as usize];
+    f.read_exact(&mut bytes).unwrap();
+    bytes
+}
+
+fn assert_packaged_manifest(crate_bytes: &[u8], crate_name: &str, expected: &str) {
+    let base = Path::new(
+        crate_name
+            .strip_suffix(".crate")
+            .expect("must end with .crate"),
+    );
+    let mut archive = Archive::new(GzDecoder::new(crate_bytes));
+    let mut actual = None;
+    for entry in archive.entries().unwrap() {
+        let mut entry = entry.unwrap();
+        if entry.path().unwrap().into_owned() == base.join("Cargo.toml") {
+            let mut contents = String::new();
+            entry.read_to_string(&mut contents).unwrap();
+            actual = Some(contents);
+        }
+    }
+    let actual = actual.expect("Cargo.toml missing from the crate");
+    assert_eq!(without_autolib(&actual), without_autolib(expected));
+}
+
+fn without_autolib(manifest: &str) -> String {
+    manifest
+        .lines()
+        .filter(|line| *line != "autolib = false")
+        .collect::<Vec<_>>()
+        .join("\n")
+}
