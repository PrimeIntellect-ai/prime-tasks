+#[cargo_test]
+fn test_no_autolib() {
+    let script = r#"#!/usr/bin/env cargo
+
+fn main() {
+    println!("Hello world!");
+}"#;
+    let p = cargo_test_support::project()
+        .file("script.rs", script)
+        .file(
+            "Cargo.toml",
+            r#"
+            [package]
+            name = "neighbor"
+            version = "0.1.0"
+            edition = "2021"
+
+            [dependencies]
+            hex = "0.4.3"
+            "#,
+        )
+        .file("src/lib.rs", "use hex;")
+        .build();
+
+    p.cargo("-Zscript -v script.rs --help")
+        .masquerade_as_nightly_cargo(&["script"])
+        .with_stdout_data(str![[r#"
+Hello world!
+
+"#]])
+        .run();
+}
