+/// Returns the total size of the files stored in a `.crate` file.
+fn archive_uncompressed_size(path: &Path) -> u64 {
+    let mut archive = Archive::new(GzDecoder::new(File::open(path).unwrap()));
+    archive
+        .entries()
+        .unwrap()
+        .map(|entry| entry.unwrap().header().size().unwrap())
+        .sum()
+}
