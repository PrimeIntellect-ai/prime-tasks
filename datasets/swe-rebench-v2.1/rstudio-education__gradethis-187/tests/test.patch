diff --git a/tests/testthat/test_unpipe.R b/tests/testthat/test_unpipe.R
index 799947b..42b6725 100644
--- a/tests/testthat/test_unpipe.R
+++ b/tests/testthat/test_unpipe.R
@@ -45,3 +45,56 @@ test_that("unpipe_all() can deal with function definitions", {
   expect_equal(unpipe_all(function1), function1)
   expect_equal(unpipe_all(function2), function2)
 })
+
+test_that("unpipe_all() accepts code as strings", {
+  pipe_str <- "a %>% b(x = 1) %>% c(y = 2)"
+  pipe_quo <- quote(a %>% b(x = 1) %>% c(y = 2))
+  unpipe_quo <- quote(c(b(a, x = 1), y = 2))
+
+  expect_equal(unpipe_all(pipe_str), unpipe_all(pipe_quo))
+  single_text <- unpipe_all_str(pipe_str)
+  expect_type(single_text, "character")
+  expect_length(single_text, 1)
+  expect_equal(
+    parse(text = single_text, keep.source = FALSE)[[1]],
+    unpipe_quo
+  )
+
+  # unpipe_all can receive strings with multiple expressions
+  pipe_str2 <- "d %>% e(x = 1) %>% f(y = 2)"
+  pipe_quo2 <- quote(d %>% e(x = 1) %>% f(y = 2))
+  unpipe_quo2 <- quote(f(e(d, x = 1), y = 2))
+  multiple <- paste0(pipe_str, "\n", pipe_str2)
+
+  expect_equal(
+    unpipe_all(multiple),
+    purrr::map(list(pipe_quo, pipe_quo2), unpipe_all)
+  )
+
+  # collapse = NULL gives one text element for each top-level expression
+  separate_text <- unpipe_all_str(multiple, collapse = NULL)
+  expect_type(separate_text, "character")
+  expect_length(separate_text, 2)
+  expect_equal(
+    parse(text = separate_text, keep.source = FALSE),
+    as.expression(list(unpipe_quo, unpipe_quo2))
+  )
+
+  # Multiple expressions are joined by the requested separator
+  default_text <- unpipe_all_str(multiple)
+  expect_type(default_text, "character")
+  expect_length(default_text, 1)
+  expect_equal(
+    default_text,
+    paste(unpipe_all_str(pipe_str), unpipe_all_str(pipe_str2), sep = "\n")
+  )
+  custom_separator <- " <NEXT> "
+  expect_equal(
+    unpipe_all_str(multiple, collapse = custom_separator),
+    paste(unpipe_all_str(pipe_str), unpipe_all_str(pipe_str2), sep = custom_separator)
+  )
+  expect_equal(
+    parse(text = default_text, keep.source = FALSE),
+    as.expression(list(unpipe_quo, unpipe_quo2))
+  )
+})
diff --git a/tests/testthat/test_zzzz-check_code.R b/tests/testthat/test_zzzz-check_code.R
index f26ac86..e2ba830 100644
--- a/tests/testthat/test_zzzz-check_code.R
+++ b/tests/testthat/test_zzzz-check_code.R
@@ -253,3 +253,32 @@ test_that("Spots differences in long calls", {
     is_correct = TRUE
   )
 })
+
+test_that("glue_pipe message returns unpiped text", {
+  user_code <- "x %>% a() %>% b() %>% c()"
+  expect_grade_code(
+    user_code = user_code,
+    solution_code = "b(a(x))",
+    is_correct = FALSE,
+    glue_pipe = "{unpipe_all_str(.user)}",
+    msg = unpipe_all_str(user_code)
+  )
+
+  # The default pipe message tells the student how their piped code was interpreted
+  expect_grade_code(
+    user_code = user_code,
+    solution_code = "b(a(x))",
+    is_correct = FALSE,
+    msg = "c(b(a(x)))"
+  )
+})
+test_that("default feedback omits a pipe interpretation for non-piped code", {
+  grade <- grade_code()(create_learnr_env(
+    user_code = "x(1)",
+    solution_code = "x(2)",
+    envir_prep = new.env(),
+    eval = FALSE
+  ))
+
+  expect_false(grepl("so I want to let you know that this is how I am interpretting your code", grade$message, fixed = TRUE))
+})
