+unpipe_all <- function(code_expr, .top_level = TRUE) {
+  if (is.character(code_expr) && .top_level) {
+    code_expr <- str2expression(code_expr)
+    if (length(code_expr) == 1) {
+      return(unpipe_all(code_expr[[1]]))
