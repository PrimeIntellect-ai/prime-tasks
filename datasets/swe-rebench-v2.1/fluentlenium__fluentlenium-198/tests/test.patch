+package org.fluentlenium.integration;
+
+import org.fluentlenium.core.domain.FluentWebElement;
+import org.fluentlenium.core.events.ElementListener;
+import org.fluentlenium.core.events.EventsRegistry;
+import org.fluentlenium.core.events.ExceptionListener;
+import org.fluentlenium.core.events.FindByListener;
+import org.fluentlenium.core.events.NavigateAllListener;
+import org.fluentlenium.core.events.NavigateListener;
+import org.fluentlenium.core.events.NavigateToListener;
+import org.fluentlenium.core.events.ScriptListener;
+import org.fluentlenium.integration.localtest.LocalFluentCase;
+import org.junit.Test;
+import org.mockito.Mockito;
+import org.openqa.selenium.By;
+import org.openqa.selenium.WebDriver;
+import org.openqa.selenium.support.events.EventFiringWebDriver;
+
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertSame;
+
+public class EventsTest extends LocalFluentCase {
+
+    private static final String ANOTHER_URL = BASE_URL + "anotherpage.html";
+
+    @Override
+    public WebDriver getDefaultDriver() {
+        return new EventFiringWebDriver(super.getDefaultDriver());
+    }
+
+    @Test
+    public void eventsReturnsRegistryForEventFiringDriver() {
+        assertNotNull(events());
+    }
+
+    @Test
+    public void registrationCanBeChained() {
+        ElementListener listener = Mockito.mock(ElementListener.class);
+        EventsRegistry registry = events();
+        assertSame(registry, registry.beforeClickOn(listener));
+        assertSame(registry, registry.afterClickOn(listener));
+        assertSame(registry, registry.beforeFindBy(Mockito.mock(FindByListener.class)));
+        assertSame(registry, registry.afterFindBy(Mockito.mock(FindByListener.class)));
+        assertSame(registry, registry.beforeNavigate(Mockito.mock(NavigateAllListener.class)));
+        assertSame(registry, registry.afterNavigate(Mockito.mock(NavigateAllListener.class)));
+        assertSame(registry, registry.beforeChangeValueOf(listener));
+        assertSame(registry, registry.afterChangeValueOf(listener));
+        assertSame(registry, registry.beforeScript(Mockito.mock(ScriptListener.class)));
+        assertSame(registry, registry.afterScript(Mockito.mock(ScriptListener.class)));
+        assertSame(registry, registry.onException(Mockito.mock(ExceptionListener.class)));
+    }
+
+    @Test
+    public void clickOn() {
+        ElementListener beforeListener = Mockito.mock(ElementListener.class);
+        ElementListener afterListener = Mockito.mock(ElementListener.class);
+
+        events().beforeClickOn(beforeListener);
+        events().afterClickOn(afterListener);
+        goTo(DEFAULT_URL);
+
+        click("button");
+
+        Mockito.verify(beforeListener, Mockito.times(1)).on(Mockito.<FluentWebElement>anyObject(), Mockito.<WebDriver>anyObject());
+        Mockito.verify(afterListener, Mockito.times(1)).on(Mockito.<FluentWebElement>anyObject(), Mockito.<WebDriver>anyObject());
+    }
+
+    @Test
+    public void findBy() {
+        FindByListener beforeListener = Mockito.mock(FindByListener.class);
+        FindByListener afterListener = Mockito.mock(FindByListener.class);
+
+        events().beforeFindBy(beforeListener);
+        events().afterFindBy(afterListener);
+        goTo(DEFAULT_URL);
+
+        findFirst("button");
+
+        Mockito.verify(beforeListener, Mockito.times(1)).on(Mockito.<By>anyObject(), Mockito.<FluentWebElement>anyObject(), Mockito.<WebDriver>anyObject());
+        Mockito.verify(afterListener, Mockito.times(1)).on(Mockito.<By>anyObject(), Mockito.<FluentWebElement>anyObject(), Mockito.<WebDriver>anyObject());
+    }
+
+    @Test
+    public void findByOnElement() {
+        FindByListener beforeListener = Mockito.mock(FindByListener.class);
+        FindByListener afterListener = Mockito.mock(FindByListener.class);
+
+        goTo(DEFAULT_URL);
+        FluentWebElement parent = findFirst(".parent");
+
+        events().beforeFindBy(beforeListener);
+        events().afterFindBy(afterListener);
+
+        parent.findFirst(".child");
+
+        Mockito.verify(beforeListener, Mockito.times(1)).on(Mockito.<By>anyObject(), Mockito.notNull(FluentWebElement.class), Mockito.<WebDriver>anyObject());
+        Mockito.verify(afterListener, Mockito.times(1)).on(Mockito.<By>anyObject(), Mockito.notNull(FluentWebElement.class), Mockito.<WebDriver>anyObject());
+    }
+
+    @Test
+    public void changeValue() {
+        ElementListener beforeListener = Mockito.mock(ElementListener.class);
+        ElementListener afterListener = Mockito.mock(ElementListener.class);
+
+        events().beforeChangeValueOf(beforeListener);
+        events().afterChangeValueOf(afterListener);
+        goTo(DEFAULT_URL);
+
+        findFirst("#name").clear();
+
+        Mockito.verify(beforeListener, Mockito.atLeastOnce()).on(Mockito.<FluentWebElement>anyObject(), Mockito.<WebDriver>anyObject());
+        Mockito.verify(afterListener, Mockito.atLeastOnce()).on(Mockito.<FluentWebElement>anyObject(), Mockito.<WebDriver>anyObject());
+    }
+
+    @Test
+    public void navigate() {
+        NavigateAllListener beforeListener = Mockito.mock(NavigateAllListener.class);
+        NavigateAllListener afterListener = Mockito.mock(NavigateAllListener.class);
+
+        events().beforeNavigate(beforeListener);
+        events().afterNavigate(afterListener);
+        goTo(DEFAULT_URL);
+
+        Mockito.verify(beforeListener, Mockito.times(1)).on(Mockito.eq(DEFAULT_URL), Mockito.<WebDriver>anyObject(), Mockito.<NavigateAllListener.Direction>anyObject());
+        Mockito.verify(afterListener, Mockito.times(1)).on(Mockito.eq(DEFAULT_URL), Mockito.<WebDriver>anyObject(), Mockito.<NavigateAllListener.Direction>anyObject());
+    }
+
+    @Test
+    public void navigateAllTypes() {
+        NavigateAllListener beforeListener = Mockito.mock(NavigateAllListener.class);
+        NavigateAllListener afterListener = Mockito.mock(NavigateAllListener.class);
+
+        events().beforeNavigate(beforeListener);
+        events().afterNavigate(afterListener);
+
+        goTo(DEFAULT_URL);
+        goTo(ANOTHER_URL);
+        getDriver().navigate().back();
+        getDriver().navigate().forward();
+
+        Mockito.verify(beforeListener, Mockito.atLeastOnce()).on(Mockito.eq(DEFAULT_URL), Mockito.<WebDriver>anyObject(), Mockito.<NavigateAllListener.Direction>anyObject());
+        Mockito.verify(beforeListener, Mockito.atLeastOnce()).on(Mockito.eq(ANOTHER_URL), Mockito.<WebDriver>anyObject(), Mockito.<NavigateAllListener.Direction>anyObject());
+        Mockito.verify(beforeListener, Mockito.atLeastOnce()).on(Mockito.<String>anyObject(), Mockito.<WebDriver>anyObject(), Mockito.eq(NavigateAllListener.Direction.BACK));
+        Mockito.verify(beforeListener, Mockito.atLeastOnce()).on(Mockito.<String>anyObject(), Mockito.<WebDriver>anyObject(), Mockito.eq(NavigateAllListener.Direction.FORWARD));
+
+        Mockito.verify(afterListener, Mockito.atLeastOnce()).on(Mockito.eq(DEFAULT_URL), Mockito.<WebDriver>anyObject(), Mockito.<NavigateAllListener.Direction>anyObject());
+        Mockito.verify(afterListener, Mockito.atLeastOnce()).on(Mockito.eq(ANOTHER_URL), Mockito.<WebDriver>anyObject(), Mockito.<NavigateAllListener.Direction>anyObject());
+        Mockito.verify(afterListener, Mockito.atLeastOnce()).on(Mockito.<String>anyObject(), Mockito.<WebDriver>anyObject(), Mockito.eq(NavigateAllListener.Direction.BACK));
+        Mockito.verify(afterListener, Mockito.atLeastOnce()).on(Mockito.<String>anyObject(), Mockito.<WebDriver>anyObject(), Mockito.eq(NavigateAllListener.Direction.FORWARD));
+    }
+
+    @Test
+    public void navigateSpecializedListeners() {
+        NavigateToListener beforeToListener = Mockito.mock(NavigateToListener.class);
+        NavigateToListener afterToListener = Mockito.mock(NavigateToListener.class);
+        NavigateListener beforeBackListener = Mockito.mock(NavigateListener.class);
+        NavigateListener afterBackListener = Mockito.mock(NavigateListener.class);
+        NavigateListener beforeForwardListener = Mockito.mock(NavigateListener.class);
+        NavigateListener afterForwardListener = Mockito.mock(NavigateListener.class);
+
+        events().beforeNavigateTo(beforeToListener);
+        events().afterNavigateTo(afterToListener);
+        events().beforeNavigateBack(beforeBackListener);
+        events().afterNavigateBack(afterBackListener);
+        events().beforeNavigateForward(beforeForwardListener);
+        events().afterNavigateForward(afterForwardListener);
+
+        goTo(DEFAULT_URL);
+        goTo(ANOTHER_URL);
+        getDriver().navigate().back();
+        getDriver().navigate().forward();
+
+        Mockito.verify(beforeToListener, Mockito.times(1)).on(Mockito.eq(DEFAULT_URL), Mockito.<WebDriver>anyObject());
+        Mockito.verify(beforeToListener, Mockito.times(1)).on(Mockito.eq(ANOTHER_URL), Mockito.<WebDriver>anyObject());
+        Mockito.verify(afterToListener, Mockito.times(1)).on(Mockito.eq(DEFAULT_URL), Mockito.<WebDriver>anyObject());
+        Mockito.verify(afterToListener, Mockito.times(1)).on(Mockito.eq(ANOTHER_URL), Mockito.<WebDriver>anyObject());
+
+        Mockito.verify(beforeBackListener, Mockito.times(1)).on(Mockito.<WebDriver>anyObject());
+        Mockito.verify(afterBackListener, Mockito.times(1)).on(Mockito.<WebDriver>anyObject());
+        Mockito.verify(beforeForwardListener, Mockito.times(1)).on(Mockito.<WebDriver>anyObject());
+        Mockito.verify(afterForwardListener, Mockito.times(1)).on(Mockito.<WebDriver>anyObject());
+    }
+
+    @Test
+    public void script() {
+        ScriptListener beforeListener = Mockito.mock(ScriptListener.class);
+        ScriptListener afterListener = Mockito.mock(ScriptListener.class);
+
+        events().beforeScript(beforeListener);
+        events().afterScript(afterListener);
+        goTo(DEFAULT_URL);
+
+        executeScript("return 1;");
+
+        Mockito.verify(beforeListener, Mockito.times(1)).on(Mockito.anyString(), Mockito.<WebDriver>anyObject());
+        Mockito.verify(afterListener, Mockito.times(1)).on(Mockito.anyString(), Mockito.<WebDriver>anyObject());
+    }
+
+    @Test
+    public void exception() {
+        ExceptionListener listener = Mockito.mock(ExceptionListener.class);
+
+        events().onException(listener);
+        goTo(DEFAULT_URL);
+
+        FluentWebElement element = findFirst("span");
+        goTo(ANOTHER_URL);
+        try {
+            element.click();
+        } catch (RuntimeException e) {
+            // the stale element operation is expected to fail
+        }
+
+        Mockito.verify(listener, Mockito.atLeastOnce()).on(Mockito.<Throwable>anyObject(), Mockito.<WebDriver>anyObject());
+    }
+}
