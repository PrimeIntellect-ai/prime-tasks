+    def test_detect_unsigned_integer_dtypes(self):
+        """Unsigned integer columns are numerical and use FloatFormatter."""
+        data = pd.DataFrame({
+            'UInt8': pd.Series([1, 2, 3, pd.NA], dtype='UInt8'),
+            'UInt16': pd.Series([1, 2, 3, pd.NA], dtype='UInt16'),
