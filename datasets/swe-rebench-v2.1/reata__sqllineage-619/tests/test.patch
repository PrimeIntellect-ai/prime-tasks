+@pytest.mark.parametrize("dialect", ["tsql"])
+def test_select_with_table_name_in_bracket(dialect: str):
+    assert_table_lineage_equal("SELECT * FROM [tab1]", {"tab1"}, dialect=dialect)
+
+
+@pytest.mark.parametrize("dialect", ["tsql"])
+def test_select_with_schema_in_bracket(dialect: str):
+    assert_table_lineage_equal(
+        "SELECT * FROM [schema1].[tab1]", {"schema1.tab1"}, dialect=dialect
+    )
+
+
+@pytest.mark.parametrize("dialect", ["tsql"])
+def test_select_with_bracket_and_unbracket_resolve_to_same_table(dialect: str):
+    """
+    A bracketed T-SQL table name and the same unbracketed name must resolve to
+    the same object, so that [t1] and t1 merge into a single intermediate table
+    instead of being treated as two distinct tables.
+    """
+    sql = "insert into [t1] select id from user_tab;insert into t2 select id from t1"
+    lr = LineageRunner(sql, dialect=dialect)
+    assert set(lr.source_tables) == {Table("user_tab")}
+    assert set(lr.target_tables) == {Table("t2")}
+    assert set(lr.intermediate_tables) == {Table("t1")}
+
+
+@pytest.mark.parametrize("dialect", ["tsql"])
+def test_bracketed_and_unbracketed_column_references_resolve_to_same_column(
+    dialect: str,
+):
+    sql = (
+        "INSERT INTO t1 ([id]) SELECT id FROM user_tab; "
+        "INSERT INTO t2 SELECT id FROM t1"
+    )
+    lr = LineageRunner(sql, dialect=dialect)
+    lineages = {
+        tuple(str(column) for column in lineage)
+        for lineage in lr.get_column_lineage()
+    }
+    assert lineages == {
+        ("<default>.user_tab.id", "<default>.t1.id", "<default>.t2.id")
+    }
+
