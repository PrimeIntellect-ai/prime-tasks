+                "2000-01-01 00:00:03",
+                "2000-01-01 00:00:22",
+                "2000-01-01 00:00:24",
+                "2000-01-01 00:00:31",
+                "2000-01-01 00:00:39",
+            ]
+        ),
+    )
+
+    # Resample to 5 second sampling and interpolate with the given method
+    ser_resampled = ser.resample("5s").interpolate(all_1d_no_arg_interpolation_methods)
+
+    # The resampled points from the first source observation onward are filled.
+    assert not ser_resampled.iloc[1:].isna().any()
+
+    if all_1d_no_arg_interpolation_methods in ["linear", "time"]:
+        expected_values = [
+            0.02631578947368421,
+            0.09210526315789473,
+            0.15789473684210525,
+            0.2236842105263158,
+            0.5357142857142857,
+            0.7142857142857143,
+            0.875,
+        ]
+        np.testing.assert_allclose(ser_resampled.iloc[1:].values, expected_values)
