+def test_resample_interpolate_off_grid_time_weighted():
+    # GH#21351
+    dates = date_range("2016-08-28", periods=5, freq="21h")
+    ser = Series(np.arange(5.0), dates)
+
+    result = ser.resample("15h").interpolate(method="time")
+
+    # The resampled index is preserved and the values are interpolated
+    # according to the actual timestamps of the original data points.
+    expected_index = date_range("2016-08-28", periods=6, freq="15h")
+    tm.assert_index_equal(result.index, expected_index)
+    expected = Series(
+        [0.0, 15 / 21, 30 / 21, 45 / 21, 60 / 21, 75 / 21],
+        index=expected_index,
+    )
+    tm.assert_series_equal(result.iloc[1:], expected.iloc[1:])
+
