+package cbor
+
+import "testing"
+
+func TestUnmarshalSimpleValueMajorType7Decode(t *testing.T) {
+	for i := 0; i <= 255; i++ {
+		if i >= 24 && i <= 31 {
+			continue
+		}
+
+		var data []byte
+		if i <= 23 {
+			data = []byte{byte(cborTypePrimitives) | byte(i)}
+		} else {
+			data = []byte{byte(cborTypePrimitives) | 24, byte(i)}
+		}
+
+		var got SimpleValue
+		if err := Unmarshal(data, &got); err != nil {
+			t.Errorf("Unmarshal(0x%x) returned error %v", data, err)
+			continue
+		}
+		if got != SimpleValue(i) {
+			t.Errorf("Unmarshal(0x%x) = %v, want %v", data, got, SimpleValue(i))
+		}
+	}
+}
+
+func TestSimpleValueDecodeRejectsOtherMajorTypes(t *testing.T) {
+	for _, data := range [][]byte{
+		{0x00},       // unsigned integer
+		{0x20},       // negative integer
+		{0x40},       // byte string
+		{0x60},       // text string
+		{0x80},       // array
+		{0xa0},       // map
+		{0xc0, 0x00}, // tag
+	} {
+		var got SimpleValue
+		if err := Unmarshal(data, &got); err == nil {
+			t.Errorf("Unmarshal(0x%x) succeeded with value %v", data, got)
+		}
+	}
+}
