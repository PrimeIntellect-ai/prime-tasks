+    test('radixString round trip with alternate separation character', () {
+      final lv = LogicValue.ofRadixString("10'b00.0010.0111", sepChar: '.');
+
+      for (final i in [2, 4, 8, 10, 16]) {
+        expect(
+            LogicValue.ofRadixString(lv.toRadixString(radix: i, sepChar: '.'),
+                sepChar: '.'),
+            equals(lv));
+      }
+      expect(() => lv.toRadixString(sepChar: 'q'),
+          throwsA(isA<LogicValueConversionException>()));
+      expect(() => lv.toRadixString(radix: 14),
+          throwsA(isA<LogicValueConversionException>()));
+    });
+    test('conversion exception includes provided message', () {
+      const message = 'a unique conversion failure message';
+      final e = LogicValueConversionException(message);
+      expect(e, isA<RohdException>());
+      expect(e.toString(), contains(message));
+    });
+    test('radixString space separators', () {
+      final lv = LogicValue.ofRadixString("10'b10 0010 0111", sepChar: ' ');
+      expect(lv.toInt(), equals(551));
+    });
+    test('radixString bad separator', () {
+      expect(() => LogicValue.ofRadixString("10'b10 0010_0111"),
+          throwsA(isA<LogicValueConstructionException>()));
+    });
+
+    test('radixString illegal separator', () {
+      expect(() => LogicValue.ofRadixString("10'b10q0010q0111", sepChar: 'q'),
+          throwsA(isA<LogicValueConstructionException>()));
+    });
+
+    test('radixString bad length', () {
+      expect(() => LogicValue.ofRadixString("10'b10_0010_0111_0000"),
+          throwsA(isA<LogicValueConstructionException>()));
+    });
