+def test_main_exclude_without_dependencies_keeps_dependency_packages(
+    mock_pkgs: Callable[[MockGraph], Iterator[Mock]],
+    capsys: pytest.CaptureFixture[str],
+) -> None:
+    graph: MockGraph = {
+        ("a", "1.0.0"): [("b", []), ("c", [])],
+        ("b", "2.0.0"): [("x", [])],
+        ("c", "3.0.0"): [],
+        ("x", "8.0.0"): [],
+        ("keep", "1.0.0"): [],
+    }
+    pkgs = list(mock_pkgs(graph))
+    with patch("pipdeptree.__main__.get_installed_distributions", return_value=pkgs):
+        main(["--exclude", "a"])
+
+    out = capsys.readouterr().out
+    assert "keep" in out
+    assert not any(line.startswith("a==") for line in out.splitlines())
+    for retained in ("b", "c", "x"):
+        assert retained in out
+
+
+def test_main_exclude_dependencies_prunes_dependencies(
+    mock_pkgs: Callable[[MockGraph], Iterator[Mock]],
+    capsys: pytest.CaptureFixture[str],
+) -> None:
+    graph: MockGraph = {
