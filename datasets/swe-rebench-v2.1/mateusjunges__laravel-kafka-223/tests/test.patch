 namespace Junges\Kafka\Tests\Producers;
 
-use Junges\Kafka\Config\Config;
+use Junges\Kafka\Facades\Kafka;
 use Junges\Kafka\Message\Message;
-use Junges\Kafka\Message\Serializers\JsonSerializer;
-use Junges\Kafka\Producers\Producer;
 use Junges\Kafka\Tests\LaravelKafkaTestCase;
+use Mockery as m;
+use RdKafka\Producer as KafkaProducer;
+use RdKafka\ProducerTopic;
 
 final class ProducerTest extends LaravelKafkaTestCase
 {
     public function testItDoesNotDoubleSerializeMessageWhenUsingJsonSerializer(): void
     {
         $this->mockKafkaProducer();
-        $producer = new Producer(new Config('broker', ['test-topic']), 'test-topic', new JsonSerializer());
+        $producer = Kafka::publish()->onTopic('test-topic')->build();
         $payload = ['key' => 'value'];
 
         $message = new Message(
             body: $payload,
         );
+        $message->onTopic('test-topic');
         $producer->produce($message);
         $producer->produce($message);
 
         $this->assertSame($payload, $message->getBody());
     }
+
+    public function testAbortingAfterASecondTopicFailsDiscardsEarlierTransactionalMessages(): void
+    {
+        $transactionOpen = false;
+        $pendingTopics = [];
+        $committedTopics = [];
+
+        $mockedKafkaProducer = m::mock(KafkaProducer::class)
+            ->shouldReceive('initTransactions')->andReturn()
+            ->shouldReceive('beginTransaction')->once()->andReturnUsing(function () use (&$transactionOpen) {
+                $transactionOpen = true;
+            })
+            ->shouldReceive('abortTransaction')->atLeast()->once()->andReturnUsing(function () use (&$transactionOpen, &$pendingTopics) {
+                $pendingTopics = [];
+                $transactionOpen = false;
+            })
+            ->shouldReceive('newTopic')->andReturnUsing(function (string $topicName) use (&$pendingTopics, &$committedTopics, &$transactionOpen) {
+                $topic = m::mock(ProducerTopic::class);
+                $topic->shouldReceive('producev')->once()->andReturnUsing(function () use ($topicName, &$pendingTopics, &$committedTopics, &$transactionOpen) {
+                    if ($topicName === 'topic-two') {
+                        throw new \RuntimeException('The second topic rejected the message.');
+                    }
+
+                    if ($transactionOpen) {
+                        $pendingTopics[] = $topicName;
+                    } else {
+                        $committedTopics[] = $topicName;
+                    }
+                });
+
+                return $topic;
+            })
+            ->shouldReceive('poll')->andReturn(RD_KAFKA_RESP_ERR_NO_ERROR)
+            ->shouldReceive('flush')->andReturn(RD_KAFKA_RESP_ERR_NO_ERROR)
+            ->getMock();
+
+        $this->app->bind(KafkaProducer::class, fn () => $mockedKafkaProducer);
+        $producer = Kafka::publish()->onTopic('topic-one')->build();
+        $producer->beginTransaction();
+        $producer->produce((new Message('first'))->onTopic('topic-one'));
+
+        $this->assertSame(['topic-one'], $pendingTopics);
+
+        $failed = false;
+        try {
+            $producer->produce((new Message('second'))->onTopic('topic-two'));
+        } catch (\Throwable $exception) {
+            $failed = true;
+            $producer->abortTransaction();
+        }
+
+        $this->assertTrue($failed);
+        $this->assertSame([], $pendingTopics);
+        $this->assertSame([], $committedTopics);
+    }
+
+    public function testItCanCommitATransaction(): void
+    {
+        $mockedKafkaProducer = m::mock(KafkaProducer::class)
+            ->shouldReceive('initTransactions')
+            ->andReturn()
+            ->shouldReceive('beginTransaction')
+            ->once()
+            ->andReturn()
+            ->shouldReceive('commitTransaction')
+            ->once()
+            ->andReturn()
+            ->getMock();
+
+        $this->app->bind(KafkaProducer::class, fn () => $mockedKafkaProducer);
+
+        $producer = Kafka::publish()->onTopic('test-topic')->build();
+
+        $producer->beginTransaction();
+        $producer->commitTransaction();
+
+        $this->assertTrue(true);
+    }
+
+    public function testItCanAbortATransaction(): void
+    {
+        $mockedKafkaProducer = m::mock(KafkaProducer::class)
+            ->shouldReceive('initTransactions')
+            ->andReturn()
+            ->shouldReceive('beginTransaction')
+            ->once()
+            ->andReturn()
+            ->shouldReceive('abortTransaction')
+            ->once()
+            ->andReturn()
+            ->getMock();
+
+        $this->app->bind(KafkaProducer::class, fn () => $mockedKafkaProducer);
+
+        $producer = Kafka::publish()->onTopic('test-topic')->build();
+
+        $producer->beginTransaction();
+        $producer->abortTransaction();
+
+        $this->assertTrue(true);
+    }
 }
