+    def test_is_hashable(self):
+        """
+        `in_` is hashable, so fields using it can be used with the include and
+        exclude filters.
+        """
+
+        @attr.s
+        class C:
+            x: int = attr.ib(validator=attr.validators.in_({1, 2}))
+
+        i = C(2)
+
+        attr.asdict(i, filter=attr.filters.include(lambda val: True))
+        attr.asdict(i, filter=attr.filters.exclude(lambda val: True))
+
+    @pytest.mark.parametrize(
+        ("serializer", "filter_factory", "expected"),
+        [
+            (attr.asdict, attr.filters.include, {"x": 1}),
+            (attr.asdict, attr.filters.exclude, {}),
+            (attr.astuple, attr.filters.include, (1,)),
+            (attr.astuple, attr.filters.exclude, ()),
+        ],
+    )
+    def test_frozen_in_validator_with_serialization_filters(
+        self, serializer, filter_factory, expected
+    ):
+        """Frozen instances can be serialized through either filter."""
+
+        @attr.s(frozen=True)
+        class C:
+            x = attr.ib(validator=attr.validators.in_({1, 2}))
+
+        instance = C(1)
+        field = attr.fields(C).x
+
+        assert serializer(instance, filter=filter_factory(field)) == expected
+
 
