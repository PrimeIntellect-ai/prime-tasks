+func TestConvenienceEvaluationsReturnDefaultsOnFailure(t *testing.T) {
+	client := openfeature.NewClient("example-client")
+	ctx := context.Background()
+	evalCtx := openfeature.EvaluationContext{}
+
+	cases := []struct {
+		name         string
+		defaultValue interface{}
+		object       bool
+	}{
+		{name: "boolean", defaultValue: true},
+		{name: "string", defaultValue: "fallback"},
+		{name: "float", defaultValue: 0.75},
+		{name: "integer", defaultValue: int64(19)},
+		{name: "object", defaultValue: map[string]string{"source": "fallback"}, object: true},
+	}
+
+	clientValue := reflect.ValueOf(client)
+	contextType := reflect.TypeOf((*context.Context)(nil)).Elem()
+	evaluationContextType := reflect.TypeOf(evalCtx)
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			defaultValue := reflect.ValueOf(tc.defaultValue)
+			outputType := defaultValue.Type()
+			inputType := defaultValue.Type()
+			if tc.object {
+				outputType = reflect.TypeOf((*interface{})(nil)).Elem()
+				inputType = outputType
+			}
+			var method reflect.Value
+			for i := 0; i < clientValue.NumMethod(); i++ {
+				candidate := clientValue.Method(i)
+				typ := candidate.Type()
+				if typ.NumOut() != 1 || typ.Out(0) != outputType || typ.NumIn() < 4 {
+					continue
+				}
+				if typ.In(0) != contextType || typ.In(1).Kind() != reflect.String ||
+					typ.In(2) != inputType || typ.In(3) != evaluationContextType {
+					continue
+				}
+				if typ.NumIn() != 4 && !typ.IsVariadic() {
+					continue
+				}
+				method = candidate
+				break
+			}
+			if !method.IsValid() {
+				t.Fatalf("no public direct-return %s convenience evaluation method found", tc.name)
+			}
+
+			// An invalid UTF-8 flag key makes evaluation fail before a provider is consulted.
+			got := method.Call([]reflect.Value{
+				reflect.ValueOf(ctx), reflect.ValueOf("\xff"), defaultValue, reflect.ValueOf(evalCtx),
+			})[0].Interface()
+			if !reflect.DeepEqual(got, tc.defaultValue) {
+				t.Errorf("evaluation failure returned %#v, want supplied default %#v", got, tc.defaultValue)
+			}
+		})
+	}
+}
