+func TestConvenienceEvaluationsReturnEvaluatedValues(t *testing.T) {
+	const clientName = "convenience-evaluation-success-test"
+	provider := memprovider.NewInMemoryProvider(map[string]memprovider.InMemoryFlag{
+		"boolean": {Key: "boolean", State: memprovider.Enabled, DefaultVariant: "on", Variants: map[string]interface{}{"on": true}},
+		"string":  {Key: "string", State: memprovider.Enabled, DefaultVariant: "greeting", Variants: map[string]interface{}{"greeting": "provider value"}},
+		"float":   {Key: "float", State: memprovider.Enabled, DefaultVariant: "fraction", Variants: map[string]interface{}{"fraction": float64(1.25)}},
+		"integer": {Key: "integer", State: memprovider.Enabled, DefaultVariant: "count", Variants: map[string]interface{}{"count": int(42)}},
+		"object":  {Key: "object", State: memprovider.Enabled, DefaultVariant: "payload", Variants: map[string]interface{}{"payload": map[string]interface{}{"enabled": true, "label": "provider"}}},
+	})
+	if err := openfeature.SetNamedProviderAndWait(clientName, provider); err != nil {
+		t.Fatalf("could not register evaluation provider: %v", err)
+	}
+
+	client := openfeature.NewClient(clientName)
+	ctx := context.Background()
+	evalCtx := openfeature.EvaluationContext{}
+	evaluate := func(outputType, inputType reflect.Type, flag string, defaultValue interface{}) interface{} {
+		var method reflect.Value
+		clientValue := reflect.ValueOf(client)
+		for i := 0; i < clientValue.NumMethod(); i++ {
+			candidate := clientValue.Method(i)
+			typ := candidate.Type()
+			if typ.NumOut() != 1 || typ.Out(0) != outputType || typ.NumIn() < 4 {
+				continue
+			}
+			if typ.In(0) != reflect.TypeOf((*context.Context)(nil)).Elem() || typ.In(1).Kind() != reflect.String ||
+				typ.In(2) != inputType || typ.In(3) != reflect.TypeOf(evalCtx) {
+				continue
+			}
+			if typ.NumIn() != 4 && !typ.IsVariadic() {
+				continue
+			}
+			method = candidate
+			break
+		}
+		if !method.IsValid() {
+			t.Fatalf("no public direct-return evaluation method found for %v", outputType)
+		}
+		return method.Call([]reflect.Value{
+			reflect.ValueOf(ctx), reflect.ValueOf(flag), reflect.ValueOf(defaultValue), reflect.ValueOf(evalCtx),
+		})[0].Interface()
+	}
+
+	if got := evaluate(reflect.TypeOf(false), reflect.TypeOf(false), "boolean", false); got != true {
+		t.Errorf("boolean evaluation returned %v, want provider value true", got)
+	}
+	if got := evaluate(reflect.TypeOf(""), reflect.TypeOf(""), "string", "fallback"); got != "provider value" {
+		t.Errorf("string evaluation returned %q, want provider value %q", got, "provider value")
+	}
+	if got := evaluate(reflect.TypeOf(float64(0)), reflect.TypeOf(float64(0)), "float", 0.5); got != float64(1.25) {
+		t.Errorf("float evaluation returned %v, want provider value 1.25", got)
+	}
+	if got := evaluate(reflect.TypeOf(int64(0)), reflect.TypeOf(int64(0)), "integer", int64(7)); got != int64(42) {
+		t.Errorf("integer evaluation returned %v, want provider value 42", got)
+	}
+	wantObject := map[string]interface{}{"enabled": true, "label": "provider"}
+	interfaceType := reflect.TypeOf((*interface{})(nil)).Elem()
+	if got := evaluate(interfaceType, interfaceType, "object", map[string]interface{}{"fallback": true}); !reflect.DeepEqual(got, wantObject) {
+		t.Errorf("object evaluation returned %#v, want provider value %#v", got, wantObject)
+	}
+}
