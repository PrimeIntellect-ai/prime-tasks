+    def test_validate_noninteger_soil_raster(self):
+        """Floating-point soil pixels are rejected or safely supported."""
+        from natcap.invest import stormwater
+
+        (_, biophysical_table_path, _, lulc_path, soil_group_array,
+         soil_group_path, _, precipitation_path, retention_cost,
+         _) = self.basic_setup(self.workspace_dir)
+        float_soils = soil_group_array.astype(numpy.float32)
+        to_raster(float_soils, soil_group_path, pixel_size=(20, -20))
+
+        args = {
+            'workspace_dir': self.workspace_dir,
+            'results_suffix': 'float_soils',
+            'lulc_path': lulc_path,
+            'soil_group_path': soil_group_path,
+            'precipitation_path': precipitation_path,
+            'biophysical_table': biophysical_table_path,
+            'adjust_retention_ratios': False,
+            'retention_radius': None,
+            'road_centerlines_path': None,
+            'aggregate_areas_path': None,
+            'replacement_cost': retention_cost
+        }
+        validation_messages = stormwater.validate(args)
+        soil_warnings = [
+            message for keys, message in validation_messages
+            if tuple(keys) == ('soil_group_path',)]
+        if soil_warnings:
+            self.assertTrue(soil_warnings[0])
+            return
+
+        # Implementations that do not report this from validate may instead
+        # handle the raster, or reject it during model startup. In particular,
+        # the indexing error from using float pixels as array indices must not
+        # escape to the caller.
+        try:
+            stormwater.execute(args)
+        except Exception as error:
+            self.assertNotIsInstance(error, IndexError)
+
