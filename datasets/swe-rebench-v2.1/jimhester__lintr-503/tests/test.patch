+test_that("lint() results from file or text should be consistent", {
+  linters <- list(assignment_linter(), infix_spaces_linter())
+  file <- tempfile()
+  lines <- c(
+    "x<-1",
+    "x+1"
+  )
+  writeLines(lines, file)
+  text <- paste0(lines, collapse = "\n")
+  file <- normalizePath(file)
+
+  lint_from_file <- lint(file, linters = linters)
+  lint_from_lines <- lint(linters = linters, text = lines)
+  lint_from_text <- lint(linters = linters, text = text)
+
+  # Remove file before linting to ensure that lint works and do not
+  # assume that file exists when both filename and text are supplied.
+  unlink(file)
+  lint_from_text2 <- lint(file, linters = linters, text = text)
+
+  expect_gt(length(lint_from_file), 0)
+
+  without_filename <- function(lints) {
+    result <- as.data.frame(lints)
+    result$filename <- NULL
+    result
+  }
+
+  expect_equal(without_filename(lint_from_file), without_filename(lint_from_text2))
+  expect_equal(without_filename(lint_from_file), without_filename(lint_from_lines))
+  expect_equal(without_filename(lint_from_file), without_filename(lint_from_text))
+})
+
+test_that("lint() returns lints for supplied text without a file", {
+  linters <- list(infix_spaces_linter())
+  lint_from_lines <- lint(linters = linters, text = c("x<-1", "y<-2"))
+  lint_from_text <- lint(NULL, linters = linters, text = "x<-1\ny<-2")
+
+  expect_gt(length(lint_from_lines), 0)
+  expect_gt(length(lint_from_text), 0)
+})
+
+test_that("lint() applies exclusion rules to in-memory text", {
+  linters <- list(assignment_linter())
+  lints <- lint(linters = linters, text = c("x = 1", "y = 2 # nolint"))
+
+  lints_without_excluded_line <- lint(linters = linters, text = "x = 1")
+  expect_equal(as.data.frame(lints), as.data.frame(lints_without_excluded_line))
+})
+
+test_that("lint() respects project settings when linting supplied text", {
+  dir <- tempfile()
+  dir.create(dir)
+  on.exit(unlink(dir, recursive = TRUE))
+  cat("linters: with_defaults(assignment_linter = NULL)\n", file = file.path(dir, ".lintr"))
+  copied_source_dir <- file.path(dir, "editor-copy")
+  dir.create(copied_source_dir)
+  file <- file.path(copied_source_dir, "file.R")
+
+  # The source copy is below, but not beside, the project configuration.
+  source <- "x = 1"
+  lints <- lint(file, text = source)
+  expected_lints <- lint(
+    file,
+    linters = with_defaults(assignment_linter = NULL),
+    parse_settings = FALSE,
+    text = source
+  )
+
+  expect_equal(as.data.frame(lints), as.data.frame(expected_lints))
+})
+
