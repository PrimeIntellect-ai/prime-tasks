+func Test_Import_OverwriteContent(t *testing.T) {
+	env := testenv.New(t)
+	defer env.RemoveAll()
+	{
+		wd, err := os.Getwd()
+		assert.NoError(t, err)
+		defer func() { assert.NoError(t, os.Chdir(wd)) }()
+	}
+	assert.NoError(t, os.Chdir(env.GetPath(".")))
+
+	cmd := GetCommand()
+	_ = cmd.PersistentFlags().Set("overwrite", "false")
+	_ = cmd.PersistentFlags().Set("parents", "false")
+
+	env.WriteFile("importfile", "new content")
+	env.WriteFile("/var/lib/warewulf/overlays/to1/rootfs/importfile", "old content")
+
+	cmd.SetArgs([]string{"to1", "importfile", "--overwrite"})
+	stdout := new(bytes.Buffer)
+	cmd.SetOut(stdout)
+	stderr := new(bytes.Buffer)
+	cmd.SetErr(stderr)
+	err := cmd.Execute()
+	assert.NoError(t, err, stderr)
+	assert.Equal(t, "new content", env.ReadFile("/var/lib/warewulf/overlays/to1/rootfs/importfile"))
+}
