+func TestAuditEntry_Referrer(tt *testing.T) {
+	const referrer = "https://github.com/example/repo/pull/42"
+
+	var entry AuditEntry
+	if err := json.Unmarshal([]byte(`{"referrer":"`+referrer+`"}`), &entry); err != nil {
+		tt.Fatalf("json.Unmarshal returned error: %v", err)
+	}
+
+	encoded, err := json.Marshal(&entry)
+	if err != nil {
+		tt.Fatalf("json.Marshal returned error: %v", err)
+	}
+	var got map[string]interface{}
+	if err := json.Unmarshal(encoded, &got); err != nil {
+		tt.Fatalf("json.Unmarshal of encoded entry returned error: %v", err)
+	}
+	if got["referrer"] != referrer {
+		tt.Errorf("AuditEntry referrer = %v, want %q", got["referrer"], referrer)
+	}
+}
