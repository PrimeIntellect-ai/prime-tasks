+#[test]
+fn change_lifetime_anon_to_named_not_applicable_away_from_anon_lifetime() {
+    use crate::{Assist, AssistConfig};
+    use ra_db::FileRange;
+    use test_utils::extract_range_or_offset;
+
+    // cursor on the function name, not on the anonymous lifetime
+    let (selection, text) = extract_range_or_offset(r#"fn my_<|>fun(x: X<'_>) {}"#);
+    let (db, file_id) = super::with_single_file(&text);
+    let frange = FileRange { file_id, range: selection.into() };
+    let assists = Assist::resolved(&db, &AssistConfig::default(), frange);
+    assert!(
+        assists.iter().all(|assist| assist.assist.id.0 != "change_lifetime_anon_to_named"),
+        "assist must not be offered away from an anonymous lifetime"
+    );
+
+    // cursor on a named lifetime, not an anonymous one
+    let (selection, text) = extract_range_or_offset(r#"fn my_fun<'a>(x: X<'<|>a>) {}"#);
+    let (db, file_id) = super::with_single_file(&text);
+    let frange = FileRange { file_id, range: selection.into() };
+    let assists = Assist::resolved(&db, &AssistConfig::default(), frange);
+    assert!(
+        assists.iter().all(|assist| assist.assist.id.0 != "change_lifetime_anon_to_named"),
+        "assist must not be offered on a named lifetime"
+    );
+}
