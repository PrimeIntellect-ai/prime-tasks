+#[test]
+fn change_lifetime_anon_to_named_uses_fresh_consistent_names() {
+    use crate::{Assist, AssistConfig};
+    use ra_db::FileRange;
+    use test_utils::extract_range_or_offset;
+
+    let (selection, input) = extract_range_or_offset(
+        r#"fn my_fun<'b>(f: &Foo, b: &'b Bar) -> X<'_<|>> {}"#,
+    );
+    let (db, file_id) = super::with_single_file(&input);
+    let frange = FileRange { file_id, range: selection.into() };
+    let resolved = Assist::resolved(&db, &AssistConfig::default(), frange)
+        .into_iter()
+        .find(|assist| assist.assist.id.0 == "change_lifetime_anon_to_named")
+        .expect("the anonymous function lifetime should be nameable");
+    let mut actual = input.clone();
+    resolved.source_change.source_file_edits.into_iter().next().unwrap().edit.apply(&mut actual);
+
+    let normalized: String = actual.chars().filter(|ch| !ch.is_whitespace()).collect();
+    let parameter_list_start = normalized.find("fnmy_fun<").unwrap() + "fnmy_fun<".len();
+    let parameter_list_end = parameter_list_start + normalized[parameter_list_start..].find(">(").unwrap();
+    let declared_parameters = &normalized[parameter_list_start..parameter_list_end];
+    let new_name = normalized
+        .split("f:&")
+        .nth(1)
+        .and_then(|text| text.split("Foo").next())
+        .unwrap();
+    assert_ne!(new_name, "'b", "the generated name must not conflict with an existing lifetime");
+    assert!(declared_parameters.split(',').any(|name| name == new_name));
+    assert!(normalized.contains(&format!("->X<{new_name}>")));
+
+    let (selection, input) = extract_range_or_offset(
+        r#"impl<'a, 'b> Cursor<'a, 'b, '_<|>> {}"#,
+    );
+    let (db, file_id) = super::with_single_file(&input);
+    let frange = FileRange { file_id, range: selection.into() };
+    let resolved = Assist::resolved(&db, &AssistConfig::default(), frange)
+        .into_iter()
+        .find(|assist| assist.assist.id.0 == "change_lifetime_anon_to_named")
+        .expect("the anonymous impl lifetime should be nameable");
+    let mut actual = input.clone();
+    resolved.source_change.source_file_edits.into_iter().next().unwrap().edit.apply(&mut actual);
+
+    let normalized: String = actual.chars().filter(|ch| !ch.is_whitespace()).collect();
+    let impl_parameters_start = normalized.find("impl<").unwrap() + "impl<".len();
+    let impl_parameters_end = impl_parameters_start + normalized[impl_parameters_start..].find(">Cursor").unwrap();
+    let declared_parameters = &normalized[impl_parameters_start..impl_parameters_end];
+    let type_arguments = normalized
+        .split("Cursor<")
+        .nth(1)
+        .and_then(|text| text.split('>').next())
+        .unwrap();
+    let new_name = type_arguments.rsplit(',').next().unwrap();
+    assert_ne!(new_name, "'a", "the generated name must not conflict with an existing lifetime");
+    assert_ne!(new_name, "'b", "the generated name must not conflict with an existing lifetime");
+    assert!(declared_parameters.split(',').any(|name| name == new_name));
+    assert!(!normalized.contains("'_"));
+}
