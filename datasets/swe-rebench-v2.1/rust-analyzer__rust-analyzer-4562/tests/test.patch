+#[test]
+fn doctest_change_lifetime_anon_to_named() {
+    use crate::{Assist, AssistConfig};
+    use ra_db::FileRange;
+    use test_utils::extract_range_or_offset;
+
+    let (selection, input) = extract_range_or_offset(
+        r#####"
+impl Cursor<'_<|>> {
+    fn node(self) -> &SyntaxNode {
+        match self {
+            Cursor::Replace(node) | Cursor::Before(node) => node,
+        }
+    }
+}
+"#####,
+    );
+    let (db, file_id) = super::with_single_file(&input);
+    let frange = FileRange { file_id, range: selection.into() };
+    let resolved = Assist::resolved(&db, &AssistConfig::default(), frange)
+        .into_iter()
+        .find(|assist| assist.assist.id.0 == "change_lifetime_anon_to_named")
+        .expect("the anonymous impl lifetime should be nameable");
+    let mut actual = input;
+    resolved.source_change.source_file_edits.into_iter().next().unwrap().edit.apply(&mut actual);
+
+    let normalized: String = actual.chars().filter(|ch| !ch.is_whitespace()).collect();
+    let declared_parameters = normalized
+        .split("impl<")
+        .nth(1)
+        .and_then(|text| text.split(">Cursor").next())
+        .unwrap();
+    let type_argument = normalized
+        .split("Cursor<")
+        .nth(1)
+        .and_then(|text| text.split('>').next())
+        .unwrap();
+    assert!(declared_parameters.split(',').any(|name| name == type_argument));
+    assert!(!normalized.contains("'_"));
+}
+#[test]
+fn doctest_change_lifetime_anon_to_named_multiple_impl_lifetimes() {
+    use crate::{Assist, AssistConfig};
+    use ra_db::FileRange;
+    use test_utils::extract_range_or_offset;
+
+    let (selection, input) = extract_range_or_offset(r#"impl Cursor<'_, '_<|>> {}"#);
+    let (db, file_id) = super::with_single_file(&input);
+    let frange = FileRange { file_id, range: selection.into() };
+    let resolved = Assist::resolved(&db, &AssistConfig::default(), frange)
+        .into_iter()
+        .find(|assist| assist.assist.id.0 == "change_lifetime_anon_to_named")
+        .expect("the selected anonymous impl lifetime should be nameable");
+    let mut actual = input;
+    resolved.source_change.source_file_edits.into_iter().next().unwrap().edit.apply(&mut actual);
+
+    let normalized: String = actual.chars().filter(|ch| !ch.is_whitespace()).collect();
+    let impl_parameters = normalized
+        .split("impl<")
+        .nth(1)
+        .and_then(|text| text.split(">Cursor").next())
+        .unwrap();
+    let type_arguments = normalized
+        .split("Cursor<")
+        .nth(1)
+        .and_then(|text| text.split('>').next())
+        .unwrap();
+    let mut lifetimes = type_arguments.split(',');
+    let unselected_lifetime = lifetimes.next().unwrap();
+    let selected_lifetime = lifetimes.next().unwrap();
+
+    assert_eq!(unselected_lifetime, "'_");
+    assert_ne!(selected_lifetime, "'_");
+    assert!(impl_parameters
+        .split(',')
+        .any(|parameter| parameter == selected_lifetime));
+}
