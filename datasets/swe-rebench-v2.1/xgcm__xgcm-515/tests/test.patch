+    def test_cumsum_chunk_checking_bug(self):
+        # see issue #507
+        ds = (
+            xr.DataArray(
+                np.ones(10) * 0.5, dims="Z", coords={"Z": np.arange(0.5, 10, 1)}
+            )
+            .chunk({"Z": -1})
+            .to_dataset(name="drF")
+        )
+        ds.coords["Zp1"] = xr.DataArray(
+            np.arange(11), dims="Zp1", coords={"Zp1": np.arange(11)}
+        )
+        grid = Grid(ds, coords={"Z": {"center": "Z", "outer": "Zp1"}})
+
+        result = grid.cumsum(ds.drF, "Z", boundary="extend")
+        expected = xr.DataArray(
+            np.concatenate(([0.5], np.cumsum(np.ones(10) * 0.5))),
+            dims="Zp1",
+            coords={"Zp1": ds.Zp1},
+        )
+        assert_equal(result.compute(), expected)
+
+    def test_cumsum_dask_core_dim_split_across_chunks(self):
