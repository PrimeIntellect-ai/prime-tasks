@@ -0,0 +1,39 @@
+const babel = require('babel-core');
+const content = `
+import type {Foo} from './foo';
+import type {Foo as Bar} from './bar';
+
+type Props = {
+  foo: Foo,
+  bar: Bar,
+};
+
+class C extends React.Component {
+    props: Props
+};
+`;
+
+it('uses the prop-type export from each imported type module', () => {
+  const res = babel.transform(content, {
+    babelrc: false,
+    presets: ['es2015', 'stage-1', 'react'],
+    plugins: ['syntax-flow', require('../')],
+  }).code;
+
+  const fooResult = {};
+  const barResult = {};
+  const fooType = function () {};
+  const barType = function () {};
+  fooType.isRequired = jest.fn(() => fooResult);
+  barType.isRequired = jest.fn(() => barResult);
+
+  const C = new Function('require', 'React', `${res}\nreturn C;`)(name => {
+    if (name === './foo') return { bpfrpt_proptype_Foo: fooType };
+    if (name === './bar') return { bpfrpt_proptype_Foo: barType };
+    if (name === 'prop-types') return { shape: jest.fn() };
+    return require(name);
+  }, { Component: function Component() {} });
+
+  expect(C.propTypes.foo()).toBe(fooResult);
+  expect(C.propTypes.bar()).toBe(barResult);
+});
