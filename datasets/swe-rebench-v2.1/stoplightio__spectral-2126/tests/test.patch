diff --git a/packages/rulesets/src/asyncapi/__tests__/asyncapi-message-examples.test.ts b/packages/rulesets/src/asyncapi/__tests__/asyncapi-message-examples.test.ts
new file mode 100644
index 0000000..4d8daaa
--- /dev/null
+++ b/packages/rulesets/src/asyncapi/__tests__/asyncapi-message-examples.test.ts
@@ -0,0 +1,292 @@
+import { DiagnosticSeverity } from '@stoplight/types';
+import testRule, { createWithRules } from './__helpers__/tester';
+
+testRule('asyncapi-message-examples' as any, [
+  {
+    name: 'valid case',
+    document: {
+      asyncapi: '2.0.0',
+      channels: {
+        someChannel: {
+          publish: {
+            message: {
+              payload: {
+                type: 'string',
+              },
+              headers: {
+                type: 'object',
+              },
+              examples: [
+                {
+                  payload: 'foobar',
+                  headers: {
+                    someKey: 'someValue',
+                  },
+                },
+              ],
+            },
+          },
+        },
+      },
+    },
+    errors: [],
+  },
+
+  {
+    name: 'invalid case',
+    document: {
+      asyncapi: '2.0.0',
+      channels: {
+        someChannel: {
+          publish: {
+            message: {
+              payload: {
+                type: 'string',
+              },
+              headers: {
+                type: 'object',
+              },
+              examples: [
+                {
+                  payload: 2137,
+                  headers: {
+                    someKey: 'someValue',
+                  },
+                },
+              ],
+            },
+          },
+        },
+      },
+    },
+    errors: [
+      {
+        severity: DiagnosticSeverity.Error,
+      },
+    ],
+  },
+
+  {
+    name: 'invalid case (oneOf case)',
+    document: {
+      asyncapi: '2.0.0',
+      channels: {
+        someChannel: {
+          publish: {
+            message: {
+              oneOf: [
+                {
+                  payload: {
+                    type: 'string',
+                  },
+                  headers: {
+                    type: 'object',
+                  },
+                  examples: [
+                    {
+                      payload: 2137,
+                      headers: {
+                        someKey: 'someValue',
+                      },
+                    },
+                  ],
+                },
+              ],
+            },
+          },
+        },
+      },
+    },
+    errors: [
+      {
+        severity: DiagnosticSeverity.Error,
+      },
+    ],
+  },
+
+  {
+    name: 'invalid case (inside components.messages)',
+    document: {
+      asyncapi: '2.0.0',
+      components: {
+        messages: {
+          someMessage: {
+            payload: {
+              type: 'string',
+            },
+            headers: {
+              type: 'object',
+            },
+            examples: [
+              {
+                payload: 2137,
+                headers: {
+                  someKey: 'someValue',
+                },
+              },
+            ],
+          },
+        },
+      },
+    },
+    errors: [
+      {
+        severity: DiagnosticSeverity.Error,
+      },
+    ],
+  },
+
+
+  {
+    name: 'valid case (no examples)',
+    document: {
+      asyncapi: '2.0.0',
+      channels: {
+        someChannel: {
+          publish: {
+            message: {
+              payload: {
+                type: 'string',
+              },
+              headers: {
+                type: 'object',
+              },
+            },
+          },
+        },
+      },
+    },
+    errors: [],
+  },
+]);
+
+describe('asyncapi-message-examples schema violations', () => {
+  it.each([
+    ['payload', 2137, { someKey: 'someValue' }],
+    ['headers', 'someValue', 'someValue'],
+  ])('reports an invalid example %s', async (_target, payload, headers) => {
+    const spectral = createWithRules(['asyncapi-message-examples' as any]);
+    const document = {
+      asyncapi: '2.0.0',
+      components: {
+        messages: {
+          someMessage: {
+            payload: { type: 'string' },
+            headers: { type: 'object' },
+            examples: [{ payload, headers }],
+          },
+        },
+      },
+    };
+
+    const diagnostics = (await spectral.run(JSON.stringify(document))).filter(
+      ({ code }) => code === 'asyncapi-message-examples',
+    );
+
+    expect(diagnostics.length).toBeGreaterThanOrEqual(1);
+  });
+});
+
+const runMessageExamplesRule = async (message: unknown) => {
+  const spectral = createWithRules(['asyncapi-message-examples' as any]);
+  const document = {
+    asyncapi: '2.0.0',
+    components: {
+      messages: {
+        someMessage: message,
+      },
+    },
+  };
+
+  return (await spectral.run(JSON.stringify(document))).filter(({ code }) => code === 'asyncapi-message-examples');
+};
+
+describe('asyncapi-message-examples checks every example', () => {
+  it.each([
+    ['payload', { payload: 2137, headers: { someKey: 'someValue' } }],
+    ['headers', { payload: 'foobar', headers: 'someValue' }],
+  ])('reports an invalid %s in an example that is not the first one', async (_target, invalidExample) => {
+    const diagnostics = await runMessageExamplesRule({
+      payload: { type: 'string' },
+      headers: { type: 'object' },
+      examples: [{ payload: 'foobar', headers: { someKey: 'someValue' } }, invalidExample],
+    });
+
+    expect(diagnostics.length).toBeGreaterThanOrEqual(1);
+  });
+
+  it('reports nothing when every example conforms to the schemas', async () => {
+    const diagnostics = await runMessageExamplesRule({
+      payload: { type: 'string' },
+      headers: { type: 'object' },
+      examples: [
+        { payload: 'foobar', headers: { someKey: 'someValue' } },
+        { payload: 'barfoo', headers: { otherKey: 'otherValue' } },
+      ],
+    });
+
+    expect(diagnostics).toHaveLength(0);
+  });
+});
+
+describe('asyncapi-message-examples checks nested schema constraints', () => {
+  const message = {
+    payload: {
+      type: 'object',
+      properties: {
+        id: { type: 'integer' },
+        tags: { type: 'array', items: { type: 'string' } },
+      },
+      required: ['id'],
+    },
+    headers: {
+      type: 'object',
+      properties: {
+        traceId: { type: 'string' },
+      },
+      required: ['traceId'],
+    },
+  };
+
+  it.each([
+    ['payload is missing a required property', { payload: { tags: ['a'] }, headers: { traceId: 'abc' } }],
+    ['payload has a wrong nested property type', { payload: { id: 'not-a-number' }, headers: { traceId: 'abc' } }],
+    ['payload has a wrong array item type', { payload: { id: 1, tags: [1] }, headers: { traceId: 'abc' } }],
+    ['headers are missing a required property', { payload: { id: 1 }, headers: { other: 'x' } }],
+    ['headers have a wrong nested property type', { payload: { id: 1 }, headers: { traceId: 42 } }],
+  ])('reports an example where %s', async (_name, example) => {
+    const diagnostics = await runMessageExamplesRule({
+      ...message,
+      examples: [example],
+    });
+
+    expect(diagnostics.length).toBeGreaterThanOrEqual(1);
+  });
+
+  it('reports nothing for an example that satisfies nested constraints', async () => {
+    const diagnostics = await runMessageExamplesRule({
+      ...message,
+      examples: [{ payload: { id: 1, tags: ['a', 'b'] }, headers: { traceId: 'abc' } }],
+    });
+
+    expect(diagnostics).toHaveLength(0);
+  });
+});
+describe('asyncApi2MessageExamplesValidation', () => {
+  it('returns undefined when the message has no examples', () => {
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const module = require('../functions/asyncApi2MessageExamplesValidation');
+    const asyncApi2MessageExamplesValidation = module.default ?? module.asyncApi2MessageExamplesValidation;
+
+    const result = asyncApi2MessageExamplesValidation(
+      {
+        payload: { type: 'string' },
+        headers: { type: 'object' },
+      },
+      null,
+      { path: [] },
+    );
+
+    expect(result).toBeUndefined();
+  });
+});
