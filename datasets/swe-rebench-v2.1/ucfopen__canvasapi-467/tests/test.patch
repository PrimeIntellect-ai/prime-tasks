+    def test_request_403(self, m):
+        register_uris({"requests": ["403"]}, m)
+
+        with self.assertRaises(Forbidden) as exc:
+            self.requester.request("GET", "403")
+
+        rate_limit_exception = getattr(exceptions, "RateLimitExceeded", None)
+        self.assertIsNotNone(rate_limit_exception)
+        self.assertNotIsInstance(exc.exception, rate_limit_exception)
+
+    def test_request_403_rate_limit(self, m):
+        register_uris({"requests": ["403_rate_limit"]}, m)
+
+        rate_limit_exception = getattr(exceptions, "RateLimitExceeded", None)
+        self.assertIsNotNone(rate_limit_exception)
+
+        with self.assertRaises(rate_limit_exception) as exc:
+            self.requester.request("GET", "403_rate_limit")
+
+        self.assertIsInstance(exc.exception, Forbidden)
+        self.assertIn("3.14159265359", str(exc.exception))
+
+    def test_request_403_rate_limit_no_remaining_header(self, m):
+        register_uris({"requests": ["403_rate_limit_no_remaining_header"]}, m)
+
+        rate_limit_exception = getattr(exceptions, "RateLimitExceeded", None)
+        self.assertIsNotNone(rate_limit_exception)
+
+        with self.assertRaises(rate_limit_exception) as exc:
+            self.requester.request("GET", "403_rate_limit_no_remaining_header")
+
+        self.assertIsInstance(exc.exception, Forbidden)
