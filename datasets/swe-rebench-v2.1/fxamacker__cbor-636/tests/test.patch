 }
+
+func TestUnmarshalRawTagOnBadData(t *testing.T) {
+	testCases := []struct {
+		name string
+		data []byte
+	}{
+		{name: "truncated tag number", data: hexDecode("d8")},
+		{name: "tag number not followed by tag content", data: hexDecode("da")},
+		{name: "truncated tag content", data: hexDecode("c074323031332d30332d32315432303a30343a3030")},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			var v RawTag
+			err := v.UnmarshalCBOR(tc.data)
+			if err == nil {
+				t.Fatalf("UnmarshalCBOR(%x) didn't return error", tc.data)
+			}
+			if !strings.HasPrefix(err.Error(), io.ErrUnexpectedEOF.Error()) {
+				t.Errorf("UnmarshalCBOR(%x) returned error %q, want prefix %q", tc.data, err.Error(), io.ErrUnexpectedEOF.Error())
+			}
+		})
+	}
+}
