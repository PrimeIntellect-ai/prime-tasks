+(deftest cookies-on-different-ports
+  (testing "http without a port matches explicit port 80"
+    (-> (session app)
+        (request "http://www.example.com/set" :params {"value" "1"})
+        (request "http://www.example.com/show")
+        (doto
+          (#(is (= (rur/get-header (:request %) "cookie")
+                   "value=1"))))
+        (request "http://www.example.com:80/set" :params {"value" "2"})
+        (doto
+          (#(is (= (rur/get-header (:request %) "cookie")
+                   "value=1"))))
+        (request "http://www.example.com/show")
+        (doto
+          (#(is (= (rur/get-header (:request %) "cookie")
+                   "value=2"))))))
+  (testing "https without a port matches explicit port 443"
+    (-> (session app)
+        (request "https://www.example.com/set" :params {"value" "1"})
+        (request "https://www.example.com/show")
+        (doto
+          (#(is (= (rur/get-header (:request %) "cookie")
+                   "value=1"))))
+        (request "https://www.example.com:443/set" :params {"value" "2"})
+        (doto
+          (#(is (= (rur/get-header (:request %) "cookie")
+                   "value=1"))))
+        (request "https://www.example.com/show")
+        (doto
+          (#(is (= (rur/get-header (:request %) "cookie")
+                   "value=2")))))))
+
