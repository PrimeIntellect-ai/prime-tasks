+    @pytest.mark.parametrize("z", [-2, 3, 2])
+    def test_adjoint_integer_power(self, z, power_method):
+        """Test the `adjoint` method for integer powers."""
+        base = qml.RX(0.123, wires=0)
+        op: Pow = power_method(base=base, z=z)
+        adj_op = op.adjoint()
+
+        assert isinstance(adj_op, Pow)
+        assert adj_op.z == op.z
+        assert qml.math.allclose(qml.matrix(adj_op.base), qml.math.conj(qml.matrix(base)).T)
+
+    @pytest.mark.parametrize("z", [-2.0, 1.0, 0.32])
+    def test_adjoint_non_integer_power_raises(self, z, power_method):
+        """Test that the `adjoint` method raises and error for non-integer powers."""
+
+        base = qml.PauliX(0)
+        op: Pow = power_method(base=base, z=z)
+        with pytest.raises(AdjointUndefinedError, match="The adjoint of Pow operators"):
+            _ = op.adjoint()
+
+    @pytest.mark.parametrize("z", [0.5, 0.32, 1.5])
+    def test_adjoint_lazy_matches_eager_fractional_power(self, z, power_method):
+        """Test that the adjoint of a fractional power is the same for lazy=True and lazy=False."""
+        powered_op = power_method(base=qml.Hadamard(0), z=z)
+
+        adj_lazy = qml.adjoint(powered_op, lazy=True)
+        adj_eager = qml.adjoint(powered_op, lazy=False)
+
+        assert qml.math.allclose(qml.matrix(adj_lazy), qml.matrix(adj_eager))
+        assert qml.math.allclose(qml.matrix(adj_lazy), qml.math.conj(qml.matrix(powered_op)).T)
