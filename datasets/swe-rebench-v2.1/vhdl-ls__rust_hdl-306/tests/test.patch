diff --git a/vhdl_lang/tests/integration_tests.rs b/vhdl_lang/tests/integration_tests.rs
new file mode 100644
index 0000000..7ff887a
--- /dev/null
+++ b/vhdl_lang/tests/integration_tests.rs
@@ -0,0 +1,24 @@
+use std::error::Error;
+use std::process::Command;
+
+#[test]
+fn unused_declaration_is_reported_at_configured_severity() -> Result<(), Box<dyn Error>> {
+    let output = Command::new(env!("CARGO_BIN_EXE_vhdl_lang"))
+        .args([
+            "--config",
+            "tests/unused_declarations/vhdl_ls.toml",
+        ])
+        .output()?;
+    let diagnostics = format!(
+        "{}{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+
+    assert!(
+        diagnostics.contains("error:") && diagnostics.contains("baz"),
+        "expected an error-severity unused-declaration diagnostic, got:\n{diagnostics}"
+    );
+
+    Ok(())
+}
