+    def test_gradients_without_specified_frequencies(self):
+        """Finite-difference and parameter-shift derivatives agree when frequencies are inferred."""
+
+        dev = qml.device("default.qubit", wires=1)
+        hamiltonian = qml.Hamiltonian([0.7], [qml.PauliX(0)])
+
+        @qml.qnode(dev)
+        def circuit(time):
+            qml.PauliX(0)
+            qml.CommutingEvolution(hamiltonian, time)
+            return qml.expval(qml.PauliZ(0))
+
+        time = np.array(0.37, requires_grad=True)
+        expected = 1.4 * np.sin(1.4 * time)
+        finite_difference = qml.gradients.finite_diff(circuit)(time)
+        parameter_shift = qml.gradients.param_shift(circuit)(time)
+
+        assert np.allclose(finite_difference, expected, atol=1e-5)
+        assert np.allclose(parameter_shift, expected, atol=1e-5)
+
