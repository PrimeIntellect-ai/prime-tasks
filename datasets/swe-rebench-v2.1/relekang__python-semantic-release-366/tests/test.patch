+import pytest
+
+from semantic_release.vcs_helpers import get_last_version
+
+
+class FakeCommit:
+    def __init__(self, committed_date):
+        self.committed_date = committed_date
+
+
+class FakeTag:
+    def __init__(self, name, committed_date):
+        self.name = name
+        self.commit = FakeCommit(committed_date)
+
+
+@pytest.fixture
+def set_repo_tags(mocker):
+    def _set(*tags):
+        fake_tags = [FakeTag(name, date) for name, date in tags]
+        mocker.patch(
+            "git.repo.base.Repo.tags",
+            new_callable=mocker.PropertyMock,
+            return_value=fake_tags,
+        )
+
+    return _set
+
+
+@pytest.mark.parametrize("tag_name", ["1.2.3", "v1.2.3"])
+def test_latest_version_recognizes_tag_style(set_repo_tags, tag_name):
+    set_repo_tags((tag_name, 1))
+
+    assert get_last_version() == "1.2.3"
+
+
+@pytest.mark.parametrize(
+    "older_tag,newer_tag",
+    [
+        ("v1.2.2", "1.2.3"),
+        ("1.2.2", "v1.2.3"),
+    ],
+)
+def test_latest_version_uses_most_recent_tag_regardless_of_prefix(
+    set_repo_tags, older_tag, newer_tag
+):
+    set_repo_tags((older_tag, 1), (newer_tag, 2))
+
+    assert get_last_version() == "1.2.3"
