+    def test_unique_profile(self):
+        """The unique proxy supports the profile provider, whose
+        return value is a dict (an unhashable type)."""
+
+        fake = Faker()
+
+        profiles = [fake.unique.profile() for _ in range(10)]
+
+        for i, profile in enumerate(profiles):
+            assert isinstance(profile, dict)
+            for other in profiles[i + 1 :]:
+                assert profile != other
