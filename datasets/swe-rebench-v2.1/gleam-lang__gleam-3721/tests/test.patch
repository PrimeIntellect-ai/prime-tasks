+
+// https://github.com/gleam-lang/gleam/issues/3720
+#[test]
+fn constant_record_after_multiline_record_starts_on_its_own_line() {
+    let source = r#"const commands = [
+  Command(
+    "dev",
+    "Start a file watcher that automatically re-compiles your app on all file changes.",
+  ), Command("help", "Show this help text."),
+]
+"#;
+    let mut formatted = String::new();
+    crate::format::pretty(
+        &mut formatted,
+        &source.into(),
+        camino::Utf8Path::new("<stdin>"),
+    )
+    .unwrap();
+
+    let constructor_lines = formatted
+        .lines()
+        .filter(|line| line.trim_start().starts_with("Command("))
+        .count();
+    assert_eq!(constructor_lines, 2);
+}
