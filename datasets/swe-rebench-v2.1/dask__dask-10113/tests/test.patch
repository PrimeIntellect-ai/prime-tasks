diff --git a/dask/tests/test_compatibility.py b/dask/tests/test_compatibility.py
new file mode 100644
index 00000000..dfdfbbe5
--- /dev/null
+++ b/dask/tests/test_compatibility.py
@@ -0,0 +1,18 @@
+import pytest
+
+from dask.compatibility import entry_points
+
+
+def test_entry_points_with_group():
+    with pytest.warns(DeprecationWarning):
+        console_scripts = entry_points(group="console_scripts")
+    assert all(ep.group == "console_scripts" for ep in console_scripts)
+
+
+def test_entry_points_without_group():
+    with pytest.warns(DeprecationWarning, match="importlib_metadata") as warning:
+        all_entries = entry_points()
+
+    assert all_entries is not None
+    message = str(warning[0].message).lower()
+    assert "entry_points" in message
