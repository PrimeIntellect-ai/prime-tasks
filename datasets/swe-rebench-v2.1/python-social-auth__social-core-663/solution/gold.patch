 from ..utils import append_slash
 from .oauth import BaseOAuth2
@@ -22,15 +22,26 @@ class OktaMixin(BaseOAuth2):
     def _url(self, path):
         return urljoin(append_slash(self.setting("API_URL")), path)
 
-    def oidc_config(self):
-        return self.get_json(
-            self._url(
