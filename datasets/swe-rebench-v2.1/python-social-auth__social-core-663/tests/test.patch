 import json
+import re
+from urllib.parse import urlparse
 
 import responses
 
@@ -187,3 +189,48 @@ class OktaOpenIdConnectTest(OpenIdConnectTest):
 
     def test_everything_works(self):
         self.do_login()
+
+    def test_default_authorization_server_discovery_during_authentication(self):
+        self.strategy.set_settings(
+            {
+                "SOCIAL_AUTH_OKTA_OPENIDCONNECT_API_URL": "https://dev-000000.oktapreview.com/oauth2",
+            }
+        )
+        responses.add(
+            responses.GET,
+            re.compile(
+                r"^https://dev-000000\.oktapreview\.com/\.well-known/openid-configuration(?:\?.*)?$"
+            ),
+            status=200,
+            body=self.openid_config_body,
+            content_type="application/json",
+        )
+
+        self.backend.use_basic_auth()
+
+        requested_path = urlparse(responses.calls[-1].request.url).path
+        self.assertEqual(requested_path, "/.well-known/openid-configuration")
+
+    def test_custom_authorization_server_discovery_during_authentication(self):
+        self.strategy.set_settings(
+            {
+                "SOCIAL_AUTH_OKTA_OPENIDCONNECT_API_URL": "https://dev-000000.oktapreview.com/oauth2/id-123456",
+            }
+        )
+        responses.add(
+            responses.GET,
+            re.compile(
+                r"^https://dev-000000\.oktapreview\.com/oauth2/id-123456/\.well-known/openid-configuration(?:\?.*)?$"
+            ),
+            status=200,
+            body=self.openid_config_body,
+            content_type="application/json",
+        )
+
+        self.backend.use_basic_auth()
+
+        requested_path = urlparse(responses.calls[-1].request.url).path
+        self.assertEqual(
+            requested_path,
+            "/oauth2/id-123456/.well-known/openid-configuration",
+        )
