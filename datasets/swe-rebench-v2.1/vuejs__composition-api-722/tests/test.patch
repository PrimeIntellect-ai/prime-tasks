diff --git a/test/ssr/ssrReactive.spec.ts b/test/ssr/ssrReactive.spec.ts
index 5c8510c..102567a 100644
--- a/test/ssr/ssrReactive.spec.ts
+++ b/test/ssr/ssrReactive.spec.ts
@@ -90,4 +90,50 @@ describe('SSR Reactive', () => {
 
     done()
   })
+
+  // #721
+  it('should behave correctly', () => {
+    const state = ref({ old: ref(false) })
+    set(state.value, 'new', ref(true))
+    // console.log(process.server, 'state.value', JSON.stringify(state.value))
+
+    expect(state.value).toMatchObject({
+      old: false,
+      new: true,
+    })
+  })
+
+  // #721
+  it('should keep the property added with set reactive', () => {
+    const state = ref({ old: ref(false) })
+    const newValue = ref(true)
+    set(state.value, 'new', newValue)
+
+    expect((state.value as any).new).toBe(true)
+
+    // Reading the property reflects later changes to the Ref it was set with.
+    newValue.value = false
+    expect((state.value as any).new).toBe(false)
+
+    // Assigning a new Ref to the property is unwrapped when read back.
+    ;(state.value as any).new = ref('updated')
+    expect((state.value as any).new).toBe('updated')
+  })
+
+  // #721
+  it('should return the value passed to set', () => {
+    const state = ref({ old: ref(false) })
+    const newValue = ref(true)
+
+    expect(set(state.value, 'new', newValue)).toBe(newValue)
+    expect(set(state.value, 'plain', 42)).toBe(42)
+  })
+  // #721
+  it('should update an existing property with set', () => {
+    const state = ref({ old: false })
+    const newValue = ref(true)
+
+    set(state.value, 'old', newValue)
+    expect((state.value as any).old).toBe(true)
+  })
 })
