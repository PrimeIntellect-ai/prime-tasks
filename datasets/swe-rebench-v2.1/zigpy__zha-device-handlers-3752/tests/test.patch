+async def test_pay2byax_battery_and_illuminance(MockAppController, ieee_mock):
+    """Test _TZE200_pay2byax reports one CR2032 battery and one illuminance entity."""
+
+    raw_device = zigpy.device.Device(MockAppController, ieee_mock, t.NWK(0x1234))
+    raw_device.manufacturer = "_TZE200_pay2byax"
+    raw_device.model = "TS0601"
+    endpoint = raw_device.add_endpoint(1)
+    endpoint.profile_id = 0x0104
+    endpoint.device_type = 0x0402
+    for cluster_id in (0x0000, 0x0001, 0x0003, 0x0400, 0x0500, 0xEF00):
+        endpoint.add_input_cluster(cluster_id)
+
+    device = zigpy.quirks.get_device(raw_device)
+    endpoint = device.endpoints[1]
+
+    power = endpoint.power
+    assert power.get("battery_size") == 0x0A  # CR2032
+    assert power.get("battery_quantity") == 1
+
+    # Count user-visible illuminance entities regardless of whether they are
+    # provided by a standard cluster or by a metadata entity.
+    illuminance_entities = [
+        entity
+        for entities in device.exposes_metadata.values()
+        for entity in entities
+        if getattr(entity, "device_class", None) == SensorDeviceClass.ILLUMINANCE
+    ]
+    if endpoint.illuminance is not None:
+        illuminance_entities.append(endpoint.illuminance)
+    assert len(illuminance_entities) == 1
+
