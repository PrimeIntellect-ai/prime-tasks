+    def test_vcd_testbench_trace_is_at_top_level(self):
+        dut = Module()
+        design_signal = Signal(name="design_signal")
+        bench_signal = Signal(name="bench_signal")
+        dut.d.comb += design_signal.eq(0)
+        sim = Simulator(dut)
+
+        with tempfile.TemporaryDirectory() as tmpdir:
+            vcd_path = os.path.join(tmpdir, "trace.vcd")
+            with sim.write_vcd(vcd_path, traces=[bench_signal]):
+                sim.run()
+
+            scopes = []
+            signal_scopes = {}
+            with open(vcd_path) as vcd_file:
+                for line in vcd_file:
+                    fields = line.split()
+                    if fields[:1] == ["$scope"]:
+                        scopes.append(fields[2])
+                    elif fields[:1] == ["$upscope"]:
+                        scopes.pop()
+                    elif fields[:1] == ["$var"]:
+                        signal_scopes[fields[4]] = tuple(scopes)
+
+        self.assertIn("top", signal_scopes["design_signal"])
+        self.assertEqual(signal_scopes["bench_signal"], signal_scopes["design_signal"][:-1])
