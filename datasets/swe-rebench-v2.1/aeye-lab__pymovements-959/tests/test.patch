+def test_provo_has_retrievable_osf_data():
+    definition = pm.datasets.Provo()
+    configured_sources = [
+        (mirror, resource)
+        for category, enabled in definition.has_files.items()
+        if enabled
+        for mirror in definition.mirrors.get(category, ())
+        for resource in definition.resources.get(category, ())
+    ]
+
+    assert configured_sources
+    assert any(
+        (parsed := urlparse(mirror)).scheme == 'https'
+        and parsed.hostname is not None
+        and (parsed.hostname == 'osf.io' or parsed.hostname.endswith('.osf.io'))
+        for mirror, _ in configured_sources
+    )
+    assert all(
+        resource.get('resource') and resource.get('filename')
+        for _, resource in configured_sources
+    )
