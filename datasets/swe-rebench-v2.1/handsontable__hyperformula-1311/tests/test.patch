diff --git a/test/ranges.spec.ts b/test/ranges.spec.ts
new file mode 100644
index 00000000..253362c8
--- /dev/null
+++ b/test/ranges.spec.ts
@@ -0,0 +1,33 @@
+import {DetailedCellError, HyperFormula} from '../src'
+import {adr} from './testUtils'
+
+describe('Ranges', () => {
+  describe('when operating on infinite ranges with array arithmetic enabled', () => {
+    it('returns a cell error when an operation produces an infinite column range not starting at index 0', () => {
+      const engine = HyperFormula.buildFromArray([[1, 2]], {useArrayArithmetic: true})
+      engine.setCellContents(adr('B2'), '=A:A+B1')
+
+      const result = engine.getCellValue(adr('B2'))
+      expect(result).toBeInstanceOf(DetailedCellError)
+      expect(result).toEqual(expect.objectContaining({message: expect.stringContaining('Invalid range size')}))
+    })
+
+    it('returns a cell error when an operation produces ranges with infinite width and height', () => {
+      const engine = HyperFormula.buildFromArray([[1]], {useArrayArithmetic: true})
+      engine.setCellContents(adr('B2'), '=A:A+1:1')
+
+      const result = engine.getCellValue(adr('B2'))
+      expect(result).toBeInstanceOf(DetailedCellError)
+      expect(result).toEqual(expect.objectContaining({message: expect.stringContaining('Invalid range size')}))
+    })
+
+    it('returns a cell error for sheet-qualified infinite ranges with an invalid size', () => {
+      const engine = HyperFormula.buildFromSheets({'Sheet1': [['1']]}, {licenseKey: 'gpl-v3', useArrayArithmetic: true})
+      engine.setCellContents(adr('A1'), "='Sheet1'!A:A+'Sheet1'!1:1")
+
+      const result = engine.getCellValue(adr('A1'))
+      expect(result).toBeInstanceOf(DetailedCellError)
+      expect(result).toEqual(expect.objectContaining({message: expect.stringContaining('Invalid range size')}))
+    })
+  })
+})
