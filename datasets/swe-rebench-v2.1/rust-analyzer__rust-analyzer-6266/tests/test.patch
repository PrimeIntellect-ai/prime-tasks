+#[test]
+fn generated_diagnostic_docs_are_generated() {
+    let path = project_root().join("docs/user/generated_diagnostic.adoc");
+
+    // `Mode::Verify` succeeds when the file is up to date and errors when it is not.
+    codegen::generate_diagnostic_docs(Mode::Overwrite).unwrap();
+    codegen::generate_diagnostic_docs(Mode::Verify).unwrap();
+    std::fs::write(&path, "stale contents").unwrap();
+    assert!(codegen::generate_diagnostic_docs(Mode::Verify).is_err());
+
+    // `Mode::Overwrite` replaces a stale file with the generated documentation,
+    // which lists every diagnostic by its code.
+    std::fs::write(&path, "stale contents").unwrap();
+    codegen::generate_diagnostic_docs(Mode::Overwrite).unwrap();
+    let text = read_file(&path).unwrap();
+    assert!(!text.contains("stale contents"), "the generated file was not overwritten");
+    for code in [
+        "unresolved-module",
+        "unresolved-extern-crate",
+        "unresolved-import",
+        "no-such-field",
+        "missing-structure-fields",
+        "missing-pat-fields",
+        "missing-match-arm",
+        "missing-ok-in-tail-expr",
+        "break-outside-of-loop",
+        "missing-unsafe",
+        "mismatched-arg-count",
+        "incorrect-ident-case",
+    ] {
+        assert!(text.contains(code), "diagnostic `{}` is not documented", code);
+    }
+}
