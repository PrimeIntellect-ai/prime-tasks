+def test_grid_scan_accepts_movable_instance_attributes():
+    """An object that satisfies the movable interface through instance
+    attributes must be accepted when grid_scan classifies its arguments
+    (see the reported rejection of yaqc-bluesky settable objects)."""
+
+    class Device:
+        def __init__(self):
+            for attr in ('name', 'parent', 'read', 'describe',
+                         'read_configuration', 'describe_configuration',
+                         'set', 'stop'):
+                setattr(self, attr, None)
+
+    device = Device()
+    # grid_scan classifies its arguments with this helper. A movable object
+    # must be recognized as the motor instead of being rejected.
+    pattern = classify_outer_product_args_pattern([device, 0, 1, 11])
+    assert pattern == OuterProductArgsPattern.PATTERN_1
+
