+def test_spline_custom_region():
+    "Use a given region to build the regular grid of forces"
+    region = (1000, 5000, -8000, -7000)
+    synth = CheckerBoard(region=region)
+    data = synth.scatter(size=1500, random_state=1)
+    coords = (data.easting, data.northing)
+    force_region = (2000, 4000, -7500, -7200)
+    spline = Spline(shape=(10, 10), region=force_region).fit(coords,
+                                                             data.scalars)
+    npt.assert_allclose(spline.force_coords_[0].min(), force_region[0])
+    npt.assert_allclose(spline.force_coords_[0].max(), force_region[1])
+    npt.assert_allclose(spline.force_coords_[1].min(), force_region[2])
+    npt.assert_allclose(spline.force_coords_[1].max(), force_region[3])
+
+
+def test_spline_custom_region_with_spacing():
+    "A given region bounds a force grid configured by spacing"
+    force_region = (2000, 4000, -7500, -7200)
+    data = CheckerBoard(region=(1000, 5000, -8000, -7000)).scatter(
+        size=1500, random_state=1)
+    spline = Spline(spacing=(100, 500), region=force_region).fit(
+        (data.easting, data.northing), data.scalars)
+    npt.assert_allclose(spline.force_coords_[0].min(), force_region[0])
+    npt.assert_allclose(spline.force_coords_[0].max(), force_region[1])
+    npt.assert_allclose(spline.force_coords_[1].min(), force_region[2])
+    npt.assert_allclose(spline.force_coords_[1].max(), force_region[3])
+
+
+def test_spline_custom_region_set_params():
+    "A region set through set_params controls the regular force grid"
+    data_region = (1000, 5000, -8000, -7000)
+    data = CheckerBoard(region=data_region).scatter(size=1500,
+                                                    random_state=1)
+    coords = (data.easting, data.northing)
+    force_region = (2000, 4000, -7500, -7200)
+    spline = Spline(shape=(10, 10)).set_params(region=force_region)
+    spline.fit(coords, data.scalars)
+    npt.assert_allclose(spline.force_coords_[0].min(), force_region[0])
+    npt.assert_allclose(spline.force_coords_[0].max(), force_region[1])
+    npt.assert_allclose(spline.force_coords_[1].min(), force_region[2])
+    npt.assert_allclose(spline.force_coords_[1].max(), force_region[3])
+
+
+def test_spline_region_fixed_after_first_fit():
+    "The region inferred from the first fit is kept for later fits"
+    region = (1000, 5000, -8000, -7000)
+    synth = CheckerBoard(region=region)
+    data = synth.scatter(size=1500, random_state=1)
+    coords = (data.easting, data.northing)
+    spline = Spline(shape=(10, 10)).fit(coords, data.scalars)
+    first_coords = spline.force_coords_
+    other = CheckerBoard(region=(0, 1000, 0, 1000)).scatter(size=1500,
+                                                            random_state=2)
+    spline.fit((other.easting, other.northing), other.scalars)
+    npt.assert_allclose(spline.force_coords_[0], first_coords[0])
+    npt.assert_allclose(spline.force_coords_[1], first_coords[1])
+
