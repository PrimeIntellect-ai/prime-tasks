+func TestRemoveScriptRemovesRouterUsingInternalPlatformFile(t *testing.T) {
+	tempDir := t.TempDir()
+	dataHome := filepath.Join(tempDir, "data")
+	namespaceDir := filepath.Join(dataHome, "skupper", "namespaces", "sample")
+	platformDir := filepath.Join(namespaceDir, "internal")
+	assert.NilError(t, os.MkdirAll(platformDir, 0755))
+	assert.NilError(t, os.WriteFile(filepath.Join(platformDir, "platform.yaml"), []byte("platform: podman\n"), 0644))
+
+	binDir := filepath.Join(tempDir, "bin")
+	platformTestFakeCommands(t, binDir)
+	commandLog := filepath.Join(tempDir, "commands.log")
+	command := exec.Command("../../../cmd/bootstrap/remove.sh", "sample")
+	command.Env = platformTestEnvironment(map[string]string{
+		"PATH":            binDir + string(os.PathListSeparator) + os.Getenv("PATH"),
+		"UID":             "1000",
+		"XDG_DATA_HOME":   dataHome,
+		"XDG_CONFIG_HOME": filepath.Join(tempDir, "config"),
+		"COMMAND_LOG":     commandLog,
+	})
+	output, err := command.CombinedOutput()
+	assert.NilError(t, err, string(output))
+
+	commands, err := os.ReadFile(commandLog)
+	assert.NilError(t, err)
+	assert.Assert(t, routerRemovedWithForce(string(commands), "sample-skupper-router"), string(commands))
+	_, err = os.Stat(namespaceDir)
+	assert.Assert(t, os.IsNotExist(err))
+}
+
+func platformTestFakeCommands(t *testing.T, dir string) {
+	t.Helper()
+	assert.NilError(t, os.MkdirAll(dir, 0755))
+	commands := map[string]string{
+		"id":        "#!/bin/sh\ncase \"$1\" in -g) echo 1000 ;; -un) echo tester ;; *) echo 1000 ;; esac\n",
+		"podman":    "#!/bin/sh\necho \"$*\" >> \"$COMMAND_LOG\"\n",
+		"systemctl": "#!/bin/sh\n[ \"$1\" != \"list-units\" ]\n",
+		"python":    "#!/bin/sh\ntrue\n",
+		"skrouterd": "#!/bin/sh\ntrue\n",
+	}
+	for name, contents := range commands {
+		assert.NilError(t, os.WriteFile(filepath.Join(dir, name), []byte(contents), 0755))
+	}
+}
+
+func platformTestEnvironment(overrides map[string]string) []string {
+	var env []string
+	for _, value := range os.Environ() {
+		key := strings.SplitN(value, "=", 2)[0]
+		if _, replaced := overrides[key]; !replaced {
+			env = append(env, value)
+		}
+	}
+	for key, value := range overrides {
+		env = append(env, key+"="+value)
+	}
+	return env
+}
+
+func platformTestPathProvider(t *testing.T) api.InternalPathProvider {
+	baseDir := t.TempDir()
+	return func(namespace string, internalPath api.InternalPath) string {
+		if namespace == "" {
+			namespace = "default"
+		}
+		return path.Join(baseDir, namespace, string(internalPath))
+	}
+}
+
+// routerRemovedWithForce reports whether the recorded podman invocations
+// include a forced removal of the named container.
+func routerRemovedWithForce(log, container string) bool {
+	for _, line := range strings.Split(log, "\n") {
+		fields := strings.Fields(line)
+		hasRm, hasForce, hasContainer := false, false, false
+		for _, f := range fields {
+			switch {
+			case f == "rm":
+				hasRm = true
+			case f == "-f" || f == "--force":
+				hasForce = true
+			case f == container:
+				hasContainer = true
+			}
+		}
+		if hasRm && hasForce && hasContainer {
+			return true
+		}
+	}
+	return false
+}
