+func TestBundleInstallWritesPlatformFileUnderInternalDir(t *testing.T) {
+	tempDir := t.TempDir()
+	siteRoot := filepath.Join(tempDir, "site-data")
+	sourceNamespace := filepath.Join(siteRoot, "sample")
+	for _, dir := range []string{
+		filepath.Join(sourceNamespace, "runtime", "router"),
+		filepath.Join(sourceNamespace, "runtime", "resources", "site"),
+		filepath.Join(sourceNamespace, "internal", "scripts"),
+	} {
+		assert.NilError(t, os.MkdirAll(dir, 0755))
+	}
+	assert.NilError(t, os.WriteFile(filepath.Join(sourceNamespace, "runtime", "router", "skrouterd.json"), []byte("{}\n"), 0644))
+	assert.NilError(t, os.WriteFile(filepath.Join(sourceNamespace, "runtime", "resources", "site", "site.yaml"), []byte("name: sample-site\n"), 0644))
+	assert.NilError(t, os.WriteFile(filepath.Join(sourceNamespace, "internal", "scripts", "router_free_port.py"), []byte(""), 0644))
+
+	tarball := utils.NewTarball()
+	assert.NilError(t, tarball.AddFiles(siteRoot))
+	generator := &bundle.TarballBundle{
+		SiteName:   "sample-site",
+		Namespace:  "sample",
+		OutputPath: tempDir,
+	}
+	assert.NilError(t, generator.Generate(tarball, "systemd"))
+
+	workingDir := filepath.Join(tempDir, "extracted")
+	assert.NilError(t, os.MkdirAll(workingDir, 0755))
+	unpack := exec.Command("tar", "-xzf", generator.InstallFile(), "-C", workingDir)
+	output, err := unpack.CombinedOutput()
+	assert.NilError(t, err, string(output))
+
+	binDir := filepath.Join(tempDir, "bin")
+	platformTestFakeCommands(t, binDir)
+	dataHome := filepath.Join(tempDir, "data")
+	command := exec.Command(filepath.Join(workingDir, "install.sh"), "-p", "systemd", "-n", "alternate")
+	command.Dir = workingDir
+	command.Env = platformTestEnvironment(map[string]string{
+		"PATH":            binDir + string(os.PathListSeparator) + os.Getenv("PATH"),
+		"UID":             "1000",
+		"XDG_DATA_HOME":   dataHome,
+		"XDG_CONFIG_HOME": filepath.Join(tempDir, "config"),
+	})
+	output, err = command.CombinedOutput()
+	assert.NilError(t, err, string(output))
+
+	platformFile := filepath.Join(dataHome, "skupper", "namespaces", "alternate", "internal", "platform.yaml")
+	data, err := os.ReadFile(platformFile)
+	assert.NilError(t, err)
+	var platformConfig struct {
+		Platform string `yaml:"platform"`
+	}
+	assert.NilError(t, yaml.Unmarshal(data, &platformConfig))
+	assert.Equal(t, platformConfig.Platform, "systemd")
+	_, err = os.Stat(filepath.Join(dataHome, "skupper", "namespaces", "alternate", "runtime", "platform.yaml"))
+	assert.Assert(t, os.IsNotExist(err))
+}
