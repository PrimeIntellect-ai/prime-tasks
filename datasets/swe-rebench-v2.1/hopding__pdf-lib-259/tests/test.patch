+  describe(`setLanguage() method`, () => {
+    let pdfDoc: PDFDocument;
+    beforeAll(async () => {
+      const parseSpeed = ParseSpeeds.Fastest;
+      pdfDoc = await PDFDocument.load(unencryptedPdfBytes, { parseSpeed });
+    });
+
+    it(`sets the language of the document`, () => {
+      const getLanguage = () => {
+        const serialized = String(pdfDoc.catalog.get(PDFName.of('Lang')));
+        if (serialized.startsWith('(') && serialized.endsWith(')')) {
+          return serialized.slice(1, -1);
+        }
+
+        if (serialized.startsWith('<') && serialized.endsWith('>')) {
+          const hex = serialized.slice(1, -1);
+          const bytes = hex.match(/.{1,2}/g) || [];
+          const decoded = bytes.map((byte) => parseInt(byte.padEnd(2, '0'), 16));
+          if (decoded[0] === 0xfe && decoded[1] === 0xff) {
+            return decoded
+              .slice(2)
+              .reduce(
+                (text, byte, index, remaining) =>
+                  index % 2 === 0
+                    ? text + String.fromCharCode((byte << 8) | remaining[index + 1])
+                    : text,
+                '',
+              );
+          }
+          return decoded.map((byte) => String.fromCharCode(byte)).join('');
+        }
+
+        throw new Error('Lang is not a PDF text string');
+      };
+
+      expect(pdfDoc.catalog.get(PDFName.of('Lang'))).toBe(undefined);
+      pdfDoc.setLanguage('fr-FR');
+      expect(getLanguage()).toBe('fr-FR');
+      pdfDoc.setLanguage('en');
+      expect(getLanguage()).toBe('en');
+      pdfDoc.setLanguage('');
+      expect(getLanguage()).toBe('');
+    });
+  });
+
