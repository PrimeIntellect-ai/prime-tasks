+def test_export_compiler_info_str_and_path(tmp_path):
+    compiler = Compiler('GNU')
+    str_file = tmp_path / 'str_config.json'
+    path_file = tmp_path / 'path_config.json'
+    assert compiler.export_compiler_info(compiler_export_filename=str(str_file)) is None
+    assert compiler.export_compiler_info(path_file) is None
+    assert str_file.is_file()
+    assert path_file.is_file()
+    with open(str_file, encoding='utf-8') as f:
+        str_data = json.load(f)
+    with open(path_file, encoding='utf-8') as f:
+        path_data = json.load(f)
+    assert str_data == path_data
+
+#------------------------------------------------------------------------------
+def test_export_compiler_info_creates_directory(tmp_path):
+    compiler = Compiler('GNU')
+    out_file = tmp_path / 'new_folder' / 'nested' / 'config.json'
+    assert compiler.export_compiler_info(out_file) is None
+    assert out_file.is_file()
+    with open(out_file, encoding='utf-8') as f:
+        json.load(f)
+
+#------------------------------------------------------------------------------
+def test_export_compiler_info_oserror(tmp_path):
+    compiler = Compiler('GNU')
+    blocker = tmp_path / 'blocker'
+    blocker.write_text('not a directory')
+    with pytest.raises(OSError):
+        compiler.export_compiler_info(blocker / 'config.json')
+
+#------------------------------------------------------------------------------
+def test_export_flag_does_not_consume_next_option(tmp_path):
+    out_file = tmp_path / 'compiler_config.json'
+    cmd = [shutil.which("pyccel"), '--export-compiler-config',
+           '--compiler-family', 'intel', str(out_file)]
+    subprocess.run(cmd, check=True)
+    with open(out_file, encoding='utf-8') as f:
+        exported_config = json.load(f)
+    assert exported_config['c']['exec'] == 'icx'
+
