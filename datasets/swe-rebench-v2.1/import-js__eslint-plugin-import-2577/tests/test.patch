+// #2347: the autofix must remove duplicate imported identifiers.
+//
+// These inputs contain duplicate identifiers, which is a fatal parse error for
+// ESPREE (the default parser) and TS_OLD, so they are parsed with BABEL_OLD and
+// TS_NEW. The assertions check the set of imported names in the fixed output
+// rather than its exact whitespace, because the contract only requires that the
+// duplicate names are removed (it does not require any particular formatting).
+describe('no-duplicates autofix removes duplicate identifiers', () => {
+  const linter = new Linter();
+  linter.defineRule('no-duplicates', rule);
+
+  const parsersToUse = flatMap([parsers.BABEL_OLD, parsers.TS_NEW], (parserPath, index) => {
+    if (!parserPath) return []; // TS_NEW is not always available
+    const name = `no-duplicates-parser-${index}`;
+    const parser = require(parserPath);
+    linter.defineParser(name, parser);
+    return [{ name, parser }];
+  });
+
+  function fixedImportedNames(code, parserName, parser) {
+    const result = linter.verifyAndFix(code, {
+      parser: parserName,
+      parserOptions: { ecmaVersion: 2020, sourceType: 'module' },
+      rules: { 'no-duplicates': 'error' },
+    });
+    const ast = parser.parse(result.output, { ecmaVersion: 2020, sourceType: 'module' });
+    const names = [];
+    for (const node of ast.body) {
+      if (node.type === 'ImportDeclaration') {
+        for (const specifier of node.specifiers) {
+          if (specifier.type === 'ImportSpecifier') {
+            names.push(specifier.imported.name);
+          }
+        }
+      }
+    }
+    return names;
+  }
+
+  parsersToUse.forEach(({ name, parser }) => {
+    it(`removes duplicate identifiers (${name})`, () => {
+      assert.deepStrictEqual(
+        fixedImportedNames("import {a} from './foo'; import { a } from './foo'", name, parser).sort(),
+        ['a'],
+      );
+      assert.deepStrictEqual(
+        fixedImportedNames("import {a,b} from './foo'; import { b, c } from './foo'; import {b,c,d} from './foo'", name, parser).sort(),
+        ['a', 'b', 'c', 'd'],
+      );
+    });
+  });
+});
+
