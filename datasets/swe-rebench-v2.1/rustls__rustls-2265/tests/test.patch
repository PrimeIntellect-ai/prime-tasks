+#[derive(Debug)]
+struct FixedResolver(Arc<CertifiedKey>);
+
+impl ResolvesServerCert for FixedResolver {
+    fn resolve(&self, _client_hello: ClientHello<'_>) -> Option<Arc<CertifiedKey>> {
+        Some(self.0.clone())
+    }
+}
+
+#[derive(Debug)]
+struct RecordingResolver {
+    inner: Arc<dyn ResolvesServerCert>,
+    observed: Mutex<Option<Vec<DistinguishedName>>>,
+}
+
+impl ResolvesServerCert for RecordingResolver {
+    fn resolve(&self, client_hello: ClientHello<'_>) -> Option<Arc<CertifiedKey>> {
+        *self.observed.lock().unwrap() = client_hello
+            .certificate_authorities()
+            .map(|cas| cas.to_vec());
+        self.inner.resolve(client_hello)
+    }
+}
