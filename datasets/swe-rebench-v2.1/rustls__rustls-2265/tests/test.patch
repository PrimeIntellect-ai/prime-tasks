+#[test]
+fn cas_extension_in_client_hello_if_server_verifier_requests_it() {
+    let ca_name = DistinguishedName::from(KeyType::Rsa2048.ca_distinguished_name().to_vec());
+
+    let mut root_cert_store = RootCertStore::empty();
+    root_cert_store.add(KeyType::Rsa2048.ca_cert()).unwrap();
+
+    let server_verifier = WebPkiServerVerifier::builder_with_provider(
+        Arc::new(root_cert_store),
+        Arc::new(provider::default_provider()),
+    )
+    .build()
+    .unwrap();
+    let cas_sending_server_verifier = Arc::new(ServerCertVerifierWithCasExt {
+        verifier: server_verifier,
+        ca_names: vec![ca_name.clone()],
+    });
+
+    for (protocol_version, cas_extension_expected) in [(&TLS12, false), (&TLS13, true)] {
+        let client_config = Arc::new(
+            client_config_builder_with_versions(&[protocol_version])
+                .dangerous()
+                .with_custom_certificate_verifier(cas_sending_server_verifier.clone())
+                .with_no_client_auth(),
+        );
+
+        let resolver = Arc::new(RecordingResolver {
+            inner: Arc::new(FixedResolver(
+                KeyType::Rsa2048.certified_key_with_cert_chain().unwrap(),
+            )),
+            observed: Mutex::new(None),
+        });
+        let server_config = Arc::new(
+            server_config_builder_with_versions(&[protocol_version])
+                .with_no_client_auth()
+                .with_cert_resolver(resolver.clone()),
+        );
+
+        let (mut client, mut server) = make_pair_for_arc_configs(&client_config, &server_config);
+        do_handshake(&mut client, &mut server);
+
+        let observed = resolver.observed.lock().unwrap().clone();
+        assert_eq!(
+            observed.is_some(),
+            cas_extension_expected,
+            "certificate_authorities presence mismatch for {protocol_version:?}"
+        );
+        if let Some(observed) = observed {
+            assert_eq!(observed.len(), 1);
+            assert_eq!(observed[0].as_ref(), ca_name.as_ref());
+        }
+    }
+}
