+def test_create_archive_action_pass_env_vars(upstream_instance):
+    """verify that the create-archive action receives the specfile path env var"""
+    u, upstream = upstream_instance
+    archive_path = u / "beerware-0.1.0.tar.gz"
+    archive_path.touch()
+    specfile_path_file = u / "specfile_path.txt"
+    upstream.package_config.actions = {
+        ActionName.create_archive: [
+            [
+                "bash",
+                "-c",
+                f"echo $PACKIT_SPECFILE_PATH > {specfile_path_file}; echo {archive_path}",
+            ],
+        ],
+    }
+
+    upstream.create_archive()
+
+    assert specfile_path_file.read_text().strip() == "beer.spec"
+
+
 @pytest.mark.parametrize(
