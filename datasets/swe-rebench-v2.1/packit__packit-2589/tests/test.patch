+def test_package_config_base_env_contains_common_variables():
+    """The package configuration exposes the environment variables
+    common to all actions for a single-package configuration."""
+    pc = PackageConfig(
+        packages={
+            "beer": CommonPackageConfig(
+                specfile_path="beer.spec",
+                upstream_package_name="beerware",
+                downstream_package_name="beer",
+                upstream_project_url="_",
+            ),
+        },
+    )
+
+    env = pc.get_base_env()
+
+    assert isinstance(env, dict)
+    assert all(isinstance(k, str) and isinstance(v, str) for k, v in env.items())
+    assert env["PACKIT_CONFIG_PACKAGE_NAME"] == "beer"
+    assert env["PACKIT_UPSTREAM_PACKAGE_NAME"] == "beerware"
+    assert env["PACKIT_DOWNSTREAM_PACKAGE_NAME"] == "beer"
+    assert env["PACKIT_SPECFILE_PATH"] == "beer.spec"
