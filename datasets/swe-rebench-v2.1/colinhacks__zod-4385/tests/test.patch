+
+test("override receives the resolved JSON Schema for optional schemas", () => {
+  const schema = z.string().optional();
+  let rootFragment: Record<string, unknown> | undefined;
+  z.toJSONSchema(schema, {
+    override(ctx) {
+      if (ctx.zodSchema === schema) {
+        rootFragment = { ...ctx.jsonSchema };
+      }
+    },
+  });
+
+  expect(rootFragment).toBeDefined();
+  expect(rootFragment).not.toHaveProperty("_ref");
+  expect(rootFragment).toEqual(expect.objectContaining({ type: "string" }));
+});
