+func TestLintCommandHonorsKubeVersionFlag(t *testing.T) {
+	testChart := "testdata/testcharts/chart-with-deprecated-api"
+	tests := []struct {
+		name        string
+		cmd         string
+		wantWarning bool
+		wantError   bool
+	}{
+		{
+			name:        "supplied version reports the applicable deprecated API warning",
+			cmd:         fmt.Sprintf("lint --kube-version 1.22.0 %s", testChart),
+			wantWarning: true,
+		},
+		{
+			name:        "strict mode treats the applicable deprecated API warning as failure",
+			cmd:         fmt.Sprintf("lint --kube-version 1.22.0 --strict %s", testChart),
+			wantWarning: true,
+			wantError:   true,
+		},
+		{
+			name: "omitted version retains the existing default",
+			cmd:  fmt.Sprintf("lint %s", testChart),
+		},
+		{
+			name: "older supplied version does not report this deprecation",
+			cmd:  fmt.Sprintf("lint --kube-version 1.21.0 --strict %s", testChart),
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			defer resetEnv()()
+			_, out, err := executeActionCommandC(storageFixture(), tt.cmd)
+			if tt.wantError && err == nil {
+				t.Errorf("expected strict lint to fail, output: %s", out)
+			}
+			if !tt.wantError && err != nil {
+				t.Errorf("expected lint to succeed, got %v; output: %s", err, out)
+			}
+			gotWarning := strings.Contains(out, "[WARNING]") && strings.Contains(out, "autoscaling/v2beta1")
+			if gotWarning != tt.wantWarning {
+				t.Errorf("deprecated autoscaling/v2beta1 warning presence = %t, want %t; output: %s", gotWarning, tt.wantWarning, out)
+			}
+		})
+	}
+}
