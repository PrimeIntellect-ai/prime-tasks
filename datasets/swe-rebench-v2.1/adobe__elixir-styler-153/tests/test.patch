   end
 
+  test "deep nesting of an alias" do
+    {_, styled, _} =
+      style("""
+      alias Foo.Bar.Baz
+
+      Baz.Bop.Boom.wee()
+      Baz.Bop.Boom.wee()
+      """)
+
+    calls_through_existing_alias =
+      length(Regex.scan(~r/(?<![.[:alnum:]_])Baz\s*\.\s*Bop\s*\.\s*Boom\s*\.\s*wee\s*\(/, styled)) == 2
+
+    calls_fully_qualified =
+      length(Regex.scan(~r/Foo\s*\.\s*Bar\s*\.\s*Baz\s*\.\s*Bop\s*\.\s*Boom\s*\.\s*wee\s*\(/, styled)) == 2
+
+    lifted_alias_calls =
+      case Regex.run(
+             ~r/alias\s+Foo\s*\.\s*Bar\s*\.\s*Baz\s*\.\s*Bop\s*\.\s*Boom(?:\s*,\s*as:\s*([A-Z][[:alnum:]_]*))?/,
+             styled
+           ) do
+        [_, explicit_name] when is_binary(explicit_name) -> explicit_name
+        [_] -> "Boom"
+        nil -> nil
+      end
+
+    calls_through_lifted_alias =
+      is_binary(lifted_alias_calls) and
+        length(
+          Regex.scan(
+            Regex.compile!("(?<![.[:alnum:]_])#{Regex.escape(lifted_alias_calls)}\\s*\\.\\s*wee\\s*\\("),
+            styled
+          )
+        ) == 2
+
+    assert calls_through_existing_alias or calls_fully_qualified or calls_through_lifted_alias
+  end
+
