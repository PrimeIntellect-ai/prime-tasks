+    def test_saved_approximations_preserve_depth_10_decomposition(self):
+        """Saving and reloading the reported approximation set preserves the decomposition."""
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            fullpath = os.path.join(tmp_dir, "approximations.npy")
+            approximations = generate_basic_approximations(
+                basis_gates=["t", "tdg", "h"], depth=10, filename=fullpath
+            )
+
+            circuit = QuantumCircuit(1)
+            # This is the reported SO(3) rotation, expressed as a circuit operation.
+            circuit.ry(np.pi / 2, 0)
+
+            in_memory = dag_to_circuit(
+                SolovayKitaev(2, approximations).run(circuit_to_dag(circuit))
+            )
+            loaded = dag_to_circuit(
+                SolovayKitaev(2, fullpath).run(circuit_to_dag(circuit))
+            )
+
+        self.assertEqual(
+            [instruction.operation.name for instruction in loaded.data],
+            [instruction.operation.name for instruction in in_memory.data],
+        )
+        self.assertAlmostEqual(loaded.global_phase, in_memory.global_phase)
+
