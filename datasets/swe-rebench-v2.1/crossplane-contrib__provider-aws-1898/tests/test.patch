+func canonicalPolicyValue(value any) any {
+	switch value := value.(type) {
+	case map[string]any:
+		normalized := make(map[string]any, len(value))
+		for key, item := range value {
+			if key == "Principal" && item == "*" {
+				normalized[key] = map[string]any{}
+				continue
+			}
+			if key == "Statement" {
+				if statement, ok := item.(map[string]any); ok {
+					normalized[key] = []any{canonicalPolicyValue(statement)}
+					continue
+				}
+			}
+			if key == "Condition" {
+				operators, _ := item.(map[string]any)
+				canonical := make(map[string]any, len(operators))
+				for operator, settingsValue := range operators {
+					settings, _ := settingsValue.(map[string]any)
+					canonicalSettings := make(map[string]any, len(settings))
+					for setting, settingValue := range settings {
+						settingValue = canonicalPolicyValue(settingValue)
+						if _, ok := settingValue.([]any); !ok {
+							settingValue = []any{settingValue}
+						}
+						canonicalSettings[setting] = settingValue
+					}
+					canonical[operator] = canonicalSettings
+				}
+				normalized[key] = canonical
+				continue
+			}
+			item = canonicalPolicyValue(item)
+			if key == "Action" || key == "NotAction" || key == "Resource" || key == "NotResource" || key == "Service" || key == "AWS" {
+				if _, ok := item.(string); ok {
+					item = []any{item}
+				}
+			}
+			normalized[key] = item
+		}
+		return normalized
+	case []any:
+		normalized := make([]any, len(value))
+		for i, item := range value {
+			normalized[i] = canonicalPolicyValue(item)
+		}
+		return normalized
+	default:
+		return value
+	}
+}
