+func TestPolicyDifferenceDetectedForListCondition(t *testing.T) {
+	desired := `{
+  "Version": "2008-10-17",
+  "Statement": [{
+    "Sid": "AllowPublishFromS3",
+    "Effect": "Allow",
+    "Principal": {"Service": "s3.amazonaws.com"},
+    "Action": "sns:Publish",
+    "Resource": "arn:aws:sns:eu-west-1:027159582536:fairmoney-dev-demo-application-uploads",
+    "Condition": {"ArnLike": {"aws:SourceArn": ["arn:aws:s3:*:*:fairmoney-dev-demo-application"]}}
+  }]
+}`
+	params := v1beta1.TopicParameters{Policy: &desired}
+	attrs := topicAttributes(withAttrPolicy(&testPolicyA))
+
+	upToDateResult := reflect.ValueOf(IsSNSTopicUpToDate).Call([]reflect.Value{
+		reflect.ValueOf(params), reflect.ValueOf(attrs),
+	})
+	if upToDateResult[0].Bool() {
+		t.Fatal("topic with a different current policy was reported up to date")
+	}
+	if len(upToDateResult) > 1 && !upToDateResult[1].IsNil() {
+		t.Fatalf("valid policies could not be compared: %v", upToDateResult[1].Interface())
+	}
+
+}
