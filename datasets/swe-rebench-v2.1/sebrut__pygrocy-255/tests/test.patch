+    def test_grocy_datetime_str(self):
+        date = datetime(2022, 7, 10, 21, 17, 34, 633809, tzinfo=None)
+        date_str = utils.grocy_datetime_str(date)
+
+        assert date_str == "2022-07-10 21:17:34"
+
+    @responses.activate
+    def test_execute_chore_sends_grocy_datetime_format(self):
+        responses.add(
+            responses.POST,
+            f"{CONST_BASE_URL}:{CONST_PORT}/api/chores/1/execute",
+            status=200,
+        )
+        grocy = Grocy(
+            CONST_BASE_URL, "demo_mode", verify_ssl=CONST_SSL, port=CONST_PORT
+        )
+
+        grocy.execute_chore(1, tracked_time=datetime(2022, 7, 10, 21, 17, 34))
+
+        request_body = json.loads(responses.calls[0].request.body)
+        tracked_time = request_body["tracked_time"]
+
+        assert re.fullmatch(r"\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}", tracked_time)
+        assert tracked_time == "2022-07-10 21:17:34"
+
+    @responses.activate
+    def test_execute_chore_converts_aware_tracked_time_to_local_time(self):
+        responses.add(
+            responses.POST,
+            f"{CONST_BASE_URL}:{CONST_PORT}/api/chores/1/execute",
+            status=200,
+        )
+        grocy = Grocy(
