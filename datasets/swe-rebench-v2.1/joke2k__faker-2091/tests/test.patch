@@ -1865,17 +1865,66 @@ class TestEnIn:
     """Test en_IN address provider methods"""
 
     def test_city_name(self, faker, num_samples):
+        """Tests `city names` are fetched correctly"""
+
         for _ in range(num_samples):
             city_name = faker.city_name()
             assert isinstance(city_name, str)
             assert city_name in EnInAddressProvider.cities
 
     def test_state(self, faker, num_samples):
+        """Tests `states` are fetched correctly"""
+
         for _ in range(num_samples):
             state = faker.state()
             assert isinstance(state, str)
             assert state in EnInAddressProvider.states
 
+    def test_union_territory(self, faker, num_samples):
+        territory_names = {
+            "andaman",
+            "chandigarh",
+            "dadra",
+            "daman",
+            "delhi",
+            "jammu",
+            "ladakh",
+            "lakshadweep",
+            "pondicherry",
+            "puducherry",
+        }
+        for _ in range(num_samples):
+            territory = faker.union_territory()
+            assert isinstance(territory, str)
+            assert any(name in territory.casefold() for name in territory_names)
+
+    @pytest.mark.parametrize(
+        "state_abbr, low, high",
+        [
+            ("GA", 403000, 403999),
+            ("TN", 600000, 669999),
+        ],
+    )
+    def test_pincode_in_state(self, faker, num_samples, state_abbr, low, high):
+        for _ in range(num_samples):
+            pincode = faker.pincode_in_state(state_abbr=state_abbr)
+            assert low <= pincode <= high
+
+    @pytest.mark.parametrize(
+        "pincode_method",
+        [
+            "pincode_in_military",
+            "pincode_in_army",
+            "zipcode_in_army",
+            "postcode_in_army",
+            "zipcode_in_military",
+            "postcode_in_military",
+        ],
+    )
+    def test_pincodes_in_military(self, faker, num_samples, pincode_method):
+        for _ in range(num_samples):
+            assert 900000 <= getattr(faker, pincode_method)() <= 999999
+
 
