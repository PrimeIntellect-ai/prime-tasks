diff --git a/test/rules/security/compiler-version.js b/test/rules/security/compiler-version.js
index e69b115..4a39ee0 100644
--- a/test/rules/security/compiler-version.js
+++ b/test/rules/security/compiler-version.js
@@ -187,4 +187,35 @@ describe('Linter - compiler-version', () => {
 
     assert.equal(report.errorCount, 0)
   })
+
+  it('should still validate an incompatible Solidity pragma alongside pragma experimental', () => {
+    const report = linter.processStr(
+      `pragma solidity ^0.6.0;
+       pragma experimental ABIEncoderV2;
+
+       contract Main {
+       }`,
+      {
+        rules: { 'compiler-version': ['error', '^0.7.4'] }
+      }
+    )
+
+    assertErrorCount(report, 1)
+    assert.equal(report.messages[0].ruleId, 'compiler-version')
+  })
+
+  it(`should not report compiler version error with correct pragma and pragma experimental`, () => {
+    const report = linter.processStr(
+      `pragma solidity ^0.7.4;
+       pragma experimental ABIEncoderV2;
+
+       contract Main {
+       }`,
+      {
+        rules: { 'compiler-version': ['error', '^0.7.4'] }
+      }
+    )
+
+    assert.equal(report.errorCount, 0)
+  })
 })
