+import EventEmitter from 'events';
+import { VoiceConnection, VoiceConnectionStatus } from '../../VoiceConnection';
+import { entersState } from '../entersState';
+
+function createFakeVoiceConnection() {
+	const vc = new EventEmitter() as any;
+	vc.state = { status: VoiceConnectionStatus.Signalling };
+	return vc as VoiceConnection;
+}
+
+describe('numeric entersState timeout cancellation', () => {
+	beforeEach(() => {
+		jest.useFakeTimers();
+	});
+
+	test('creates a controller that aborts at the timeout and rejects the pending wait', async () => {
+		const NativeAbortController = global.AbortController;
+		let createdController: AbortController | undefined;
+		class ObservedAbortController extends NativeAbortController {
+			constructor() {
+				super();
+				createdController = this;
+			}
+		}
+
+		global.AbortController = ObservedAbortController;
+		try {
+			const promise = entersState(createFakeVoiceConnection(), VoiceConnectionStatus.Ready, 1000);
+			jest.advanceTimersByTime(999);
+			expect(createdController).toBeDefined();
+			expect(createdController!.signal.aborted).toBe(false);
+			jest.advanceTimersByTime(1);
+			await expect(promise).rejects.toThrowError();
+			expect(createdController!.signal.aborted).toBe(true);
+		} finally {
+			global.AbortController = NativeAbortController;
+		}
+	});
+});
diff --git a/src/util/__tests__/entersState.test.ts b/src/util/__tests__/entersState.test.ts
