diff --git a/test/unit/regression/bugs.js b/test/unit/regression/bugs.js
new file mode 100644
index 0000000..56a868e
--- /dev/null
+++ b/test/unit/regression/bugs.js
@@ -0,0 +1,52 @@
+import assert from 'assert';
+import http from 'http';
+import axios from '../../../index.js';
+
+describe('issues', function () {
+  describe('4999', function () {
+    let server;
+    let baseURL;
+
+    before(function (done) {
+      server = http.createServer(function (req, res) {
+        res.setHeader('Content-Type', 'application/json');
+        res.end(JSON.stringify({url: req.url}));
+      });
+
+      server.listen(0, '127.0.0.1', function () {
+        baseURL = `http://127.0.0.1:${server.address().port}`;
+        done();
+      });
+    });
+
+    after(function (done) {
+      server.close(done);
+    });
+
+    it('should not fail with query parsing', async function () {
+      const {data} = await axios.get(`${baseURL}/get?foo1=bar1&foo2=bar2`);
+
+      const received = new URL(data.url, baseURL);
+
+      assert.strictEqual(received.pathname, '/get');
+      assert.strictEqual(received.searchParams.get('foo1'), 'bar1');
+      assert.strictEqual(received.searchParams.get('foo2'), 'bar2');
+    });
+
+    it('should preserve query values containing spaces and reserved characters', async function () {
+      const {data} = await axios.get(
+        `${baseURL}/get?q=sort:committer-date-desc merge:false repo:org/reponame&per_page=50&page=1`
+      );
+
+      const received = new URL(data.url, baseURL);
+
+      assert.strictEqual(received.pathname, '/get');
+      assert.strictEqual(
+        received.searchParams.get('q'),
+        'sort:committer-date-desc merge:false repo:org/reponame'
+      );
+      assert.strictEqual(received.searchParams.get('per_page'), '50');
+      assert.strictEqual(received.searchParams.get('page'), '1');
+    });
+  });
+});
