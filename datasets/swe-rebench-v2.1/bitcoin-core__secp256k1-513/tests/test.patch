+/* In the fixed-window NAF, a coefficient of 1 must be zero when the coefficient
+ * directly below it is negative, and a coefficient of -1 must be zero when the
+ * coefficient directly below it is positive. */
+void test_fixed_wnaf_sign_rule(const int *wnaf, int w) {
+    int i;
+    for (i = 1; i < WNAF_SIZE(w); ++i) {
+        CHECK(!(wnaf[i] == 1 && wnaf[i-1] < 0));
+        CHECK(!(wnaf[i] == -1 && wnaf[i-1] > 0));
+    }
+}
