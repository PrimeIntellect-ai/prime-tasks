+package day276
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+// nolint
+var testcases = []struct {
+	input, substr string
+	expected      int
+}{
+	{"hello world!", "wor", 6},
+	{"hello world!", "hello", 0},
+	{"hello world!", "ll", 2},
+	{"hello world!", "llo w", 2},
+	{"hello world!", "ld", 9},
+}
+
+func TestStringMatchKMP(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		if result := StringMatchKMP(tc.input, tc.substr); result != tc.expected {
+			t.Errorf("Expected %v, got %v", tc.expected, result)
+		}
+	}
+}
+
+func BenchmarkStringMatchKMP(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			StringMatchKMP(tc.input, tc.substr)
+		}
+	}
+}
+
+func TestStringMatchKMPNoMatch(t *testing.T) {
+	input, substr := "hello world!", "buddy"
+	result := StringMatchKMP(input, substr)
+	if result >= 0 && result+len(substr) <= len(input) {
+		t.Fatalf("result %d identifies a possible match location for an absent pattern", result)
+	}
+}
+
+func TestStringMatchKMPRepeatedPartialMatches(t *testing.T) {
+	input := strings.Repeat("a", 100000)
+	substr := strings.Repeat("a", 50000) + "b"
+
+	start := time.Now()
+	result := StringMatchKMP(input, substr)
+	if elapsed := time.Since(start); elapsed > 500*time.Millisecond {
+		t.Fatalf("search took %v on repeated partial matches; expected sub-quadratic behavior", elapsed)
+	}
+	if result >= 0 && result+len(substr) <= len(input) {
+		t.Fatalf("result %d identifies a possible match location for an absent pattern", result)
+	}
+}
