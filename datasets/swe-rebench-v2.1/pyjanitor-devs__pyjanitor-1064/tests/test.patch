+@pytest.mark.functions
+def test_unselected_new_name_does_not_replace_selected_column():
+    """Only columns named in ``column_names`` are transformed."""
+    source = pd.DataFrame(
+        {
+            "col1": [5, 10, 15],
+            "col2": [3, 6, 9],
+            "col3": [10, 100, 1000],
+        }
+    )
+
+    result = source.transform_columns(
+        ["col1", "col3"],
+        np.log10,
+        new_column_names={"col1": "transform1", "col2": "transform2"},
+    )
+
+    assert_series_equal(result["col1"], source["col1"])
+    assert_series_equal(result["col2"], source["col2"])
+    assert_series_equal(
+        result["col3"],
+        np.log10(source["col3"]).rename("col3"),
+        check_dtype=False,
+    )
+    assert_series_equal(
+        result["transform1"],
+        np.log10(source["col1"]).rename("transform1"),
+        check_dtype=False,
+    )
+    assert "transform2" not in result.columns
+
+
