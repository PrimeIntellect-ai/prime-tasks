+describe('HTTP API default access log format', () => {
+  let serverless;
+  let httpApiEvents;
+
+  beforeEach(() => {
+    const HttpApiEvents = require('../httpApi');
+    serverless = new Serverless();
+    serverless.service.service = 'new-service';
+    serverless.service.provider.compiledCloudFormationTemplate = { Resources: {}, Outputs: {} };
+    serverless.setProvider('aws', new AwsProvider(serverless));
+    serverless.service.provider.logs = { httpApi: true };
+    serverless.service.functions = {
+      foo: {
+        events: [{ httpApi: 'GET /foo' }],
+      },
+    };
+    httpApiEvents = new HttpApiEvents(serverless);
+  });
+
+  it('should produce a valid JSON access log format without an extra enclosing "{}"', () => {
+    httpApiEvents.hooks['package:compileEvents']();
+
+    const naming = serverless.getProvider('aws').naming;
+    const stage =
+      serverless.service.provider.compiledCloudFormationTemplate.Resources[
+        naming.getHttpApiStageLogicalId()
+      ];
+    const format = stage.Properties.AccessLogSettings.Format;
+
+    expect(() => JSON.parse(format)).to.not.throw();
+    const parsed = JSON.parse(format);
+    expect(parsed).to.be.an('object');
+    for (const field of [
+      'requestId',
+      'ip',
+      'requestTime',
+      'httpMethod',
+      'routeKey',
+      'status',
+      'protocol',
+      'responseLength',
+    ]) {
+      expect(parsed).to.have.property(field);
+    }
+  });
+});
