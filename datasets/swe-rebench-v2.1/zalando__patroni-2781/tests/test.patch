diff --git a/tests/test_file_perm.py b/tests/test_file_perm.py
new file mode 100644
index 0000000..4a60762
--- /dev/null
+++ b/tests/test_file_perm.py
@@ -0,0 +1,32 @@
+import unittest
+import stat
+
+from mock import patch
+
+from patroni.file_perm import pg_perm
+
+
+class TestFilePermissions(unittest.TestCase):
+
+    @patch('os.stat')
+    @patch('os.umask')
+    def test_set_umask(self, mock_umask, mock_stat):
+        failure = OSError('umask unavailable')
+        mock_umask.side_effect = failure
+        mock_stat.return_value.st_mode = stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP
+        with self.assertLogs('patroni.file_perm', level='ERROR') as captured:
+            self.assertIsNone(pg_perm.set_permissions_from_data_directory('test'))
+
+        applied_mask = mock_umask.call_args[0][0]
+        record = next(record for record in captured.records
+                      if record.msg == 'Can not set umask to %03o: %r')
+        self.assertEqual(record.args, (applied_mask, failure))
+
+    @patch('os.stat', side_effect=FileNotFoundError)
+    def test_set_permissions_from_data_directory(self, mock_stat):
+        with self.assertLogs('patroni.file_perm', level='ERROR') as captured:
+            self.assertIsNone(pg_perm.set_permissions_from_data_directory('test'))
+        record = next(record for record in captured.records
+                      if record.msg == 'Can not check permissions on %s: %r')
+        self.assertEqual(record.args[0], 'test')
+        self.assertIsInstance(record.args[1], FileNotFoundError)
