+func TestEchoStartH2CServerListenerNetworkInvalid(t *testing.T) {
+	e := New()
+	setEchoListenerNetwork(t, e, "unix")
+	h2s := &http2.Server{}
+
+	errCh := make(chan error, 1)
+	go func() {
+		errCh <- e.StartH2CServer(":0", h2s)
+	}()
+
+	select {
+	case err := <-errCh:
+		assertInvalidListenerNetworkError(t, err)
+	case <-time.After(500 * time.Millisecond):
+		e.Close()
+		t.Fatal("StartH2CServer ignored the configured ListenerNetwork")
+	}
+}
