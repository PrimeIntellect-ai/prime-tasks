+func setEchoListenerNetwork(t *testing.T, e *Echo, network string) {
+	t.Helper()
+	field := reflect.ValueOf(e).Elem().FieldByName("ListenerNetwork")
+	if !field.IsValid() || !field.CanSet() || field.Kind() != reflect.String {
+		t.Fatal("Echo does not expose a settable ListenerNetwork string field")
+	}
+	field.SetString(network)
+}
+
+func assertInvalidListenerNetworkError(t *testing.T, err error) {
+	t.Helper()
+	if err == nil {
+		t.Fatal("expected an error for an unsupported listener network")
+	}
+	var networkError *net.OpError
+	if errors.As(err, &networkError) {
+		t.Fatalf("unsupported listener network was passed to the network listener: %v", err)
+	}
+}
+
+var listenerNetworkTests = []struct {
+	test    string
+	network string
+	address string
+}{
+	{"tcp ipv4 address", "tcp", "127.0.0.1:0"},
+	{"tcp ipv6 address", "tcp", "[::1]:0"},
+	{"tcp4 ipv4 address", "tcp4", "127.0.0.1:0"},
+	{"tcp6 ipv6 address", "tcp6", "[::1]:0"},
+}
+
+func TestEchoListenerNetwork(t *testing.T) {
+	for _, tt := range listenerNetworkTests {
+		t.Run(tt.test, func(t *testing.T) {
+			if strings.HasPrefix(tt.address, "[") {
+				listener, err := net.Listen(tt.network, "[::1]:0")
+				if err != nil {
+					t.Skipf("IPv6 loopback is unavailable: %v", err)
+				}
+				_ = listener.Close()
+			}
+			e := New()
+			setEchoListenerNetwork(t, e, tt.network)
+
+			// HandlerFunc
+			e.GET("/ok", func(c Context) error {
+				return c.String(http.StatusOK, "OK")
+			})
+
+			errCh := make(chan error, 1)
+
+			go func() {
+				errCh <- e.Start(tt.address)
+			}()
+
+			time.Sleep(200 * time.Millisecond)
+			if e.Listener == nil {
+				t.Fatal("server did not create a listener")
+			}
+
+			if resp, err := http.Get(fmt.Sprintf("http://%s/ok", e.Listener.Addr())); err == nil {
+				defer resp.Body.Close()
+				assert.Equal(t, http.StatusOK, resp.StatusCode)
+
+				if body, err := ioutil.ReadAll(resp.Body); err == nil {
+					assert.Equal(t, "OK", string(body))
+				} else {
+					assert.Fail(t, err.Error())
+				}
+
+			} else {
+				assert.Fail(t, err.Error())
+			}
+
+			if err := e.Close(); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestEchoStartServerListenerNetwork(t *testing.T) {
+	e := New()
+	e.HideBanner = true
+	e.HidePort = true
+	setEchoListenerNetwork(t, e, "tcp6")
+	server := &http.Server{Addr: "127.0.0.1:0"}
+	errCh := make(chan error, 1)
+
+	go func() {
+		errCh <- e.StartServer(server)
+	}()
+
+	select {
+	case err := <-errCh:
+		if err == nil {
+			t.Fatal("StartServer accepted an IPv4 address for a TCP6 listener")
+		}
+	case <-time.After(2 * time.Second):
+		if e.Listener != nil {
+			_ = e.Listener.Close()
+		}
+		<-errCh
+		t.Fatal("StartServer did not use the configured TCP6 network")
+	}
+}
+
+func TestEchoStartListenerNetwork(t *testing.T) {
+	e := New()
+	e.HideBanner = true
+	e.HidePort = true
+	setEchoListenerNetwork(t, e, "tcp6")
+	errCh := make(chan error, 1)
+
+	go func() {
+		errCh <- e.Start("127.0.0.1:0")
+	}()
+
+	select {
+	case err := <-errCh:
+		if err == nil {
+			t.Fatal("Start accepted an IPv4 address for a TCP6 listener")
+		}
+	case <-time.After(2 * time.Second):
+		if e.Listener != nil {
+			_ = e.Listener.Close()
+		}
+		<-errCh
+		t.Fatal("Start did not use the configured TCP6 network")
+	}
+}
