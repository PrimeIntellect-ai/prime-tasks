+func TestEchoListenerNetworkInvalid(t *testing.T) {
+	e := New()
+	setEchoListenerNetwork(t, e, "unix")
+
+	// HandlerFunc
+	e.GET("/ok", func(c Context) error {
+		return c.String(http.StatusOK, "OK")
+	})
+
+	assertInvalidListenerNetworkError(t, e.Start(":1323"))
+}
