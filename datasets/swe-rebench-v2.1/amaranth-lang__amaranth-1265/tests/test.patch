+class DuplicateElaboratableTestCase(FHDLTestCase):
+    def test_duplicate(self):
+        sub = Module()
+        m = Module()
+        m.submodules.a = sub
+        m.submodules.b = sub
+        with self.assertRaises(DuplicateElaboratable) as cm:
+            Fragment.get(m, None).prepare()
+        self.assertTrue(str(cm.exception))
+
+    def test_duplicate_nested(self):
+        shared = Module()
+        container = Module()
+        container.submodules.shared = shared
+        top = Module()
+        top.submodules.shared = shared
+        top.submodules.container = container
+
+        with self.assertRaises(DuplicateElaboratable) as cm:
+            Fragment.get(top, None).prepare()
+        self.assertTrue(str(cm.exception))
+
