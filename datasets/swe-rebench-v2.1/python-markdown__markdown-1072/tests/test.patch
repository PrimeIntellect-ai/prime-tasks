+    def test_raw_unclosed_tag_in_code_span(self):
+        output = markdown.markdown(
+            self.dedent(
+                """
+                `<div`.
+
+                <div>
+                hello
+                </div>
+                """
+            )
+        )
+        self.assertIn('<code>&lt;div</code>', output)
+        self.assertIn('<div>\nhello\n</div>', output)
+
+    def test_raw_unclosed_tag_in_code_span_space(self):
+        output = markdown.markdown(
+            self.dedent(
+                """
+                ` <div `.
+
+                <div>
+                hello
+                </div>
+                """
+            )
+        )
+        self.assertIn('<code>&lt;div</code>', output)
+        self.assertIn('<div>\nhello\n</div>', output)
+
+    def test_raw_unclosed_tag_in_code_span_with_php(self):
+        output = markdown.markdown(
+            self.dedent(
+                """
+                `<?php <div`
+
+                <div>
+                hello
+                </div>
+                """
+            )
+        )
+        self.assertIn('<code>&lt;?php &lt;div</code>', output)
+        self.assertIn('<div>\nhello\n</div>', output)
+        self.assertNotIn('?&gt;', output)
+
