+// TestRestClientRetryFunction is the single test that exercises the default
+// (normal-rate) retry behavior. It must keep using the default retry logic so
+// that the normal timeout path stays covered.
+func TestRestClientRetryFunction(t *testing.T) {
+	queryStr := baseQuery + "/get_block"
+
+	// Build Request
+	req, err := http.NewRequest("GET", queryStr, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Query Args
+	rq := req.URL.Query()
+	rq.Add("blockNumber", "1")
+	rq.Add("blockHash", "hash")
+	req.URL.RawQuery = rq.Encode()
+
+	// Build Response Object
+	rr := httptest.NewRecorder()
+
+	errorMessage := "feeder gateway failed"
+	httpClient.DoReturns(nil, errors.New(errorMessage))
+
+	// Send Request expecting an error
+	start := time.Now()
+	restHandler.GetBlock(rr, req)
+	assertFeederFailure(t, rr)
+	elapsed := time.Since(start)
+
+	// This is the one test that must retain the normal (slow) retry rate.
+	assert.Assert(t, elapsed >= 8*time.Second, "the normal-rate retry test did not exercise the default retry behavior, took %s", elapsed)
+}
+
+// TestRestClientFastFailure ensures a representative failing REST request does not
+// wait for the normal retry back-off used by the separate normal-rate test.
+func TestRestClientFastFailure(t *testing.T) {
+	req, err := http.NewRequest("GET", baseQuery+"/get_block?blockHash=hash&blockNumber=1", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rr := httptest.NewRecorder()
+
+	start := time.Now()
+	failRestHandler.GetBlock(rr, req)
+	assertFeederFailure(t, rr)
+	elapsed := time.Since(start)
+
+	assert.Assert(t, elapsed < 5*time.Second, "failing request did not complete quickly, took %s", elapsed)
+}
+
