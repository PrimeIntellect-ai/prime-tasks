+// assertFeederFailure checks that the handler reported the feeder failure to the caller.
+func assertFeederFailure(t *testing.T, rr *httptest.ResponseRecorder) {
+	t.Helper()
+	assert.Equal(t, rr.Code, http.StatusBadRequest)
+	assert.Assert(t, strings.Contains(rr.Body.String(), "feeder gateway failed"), "response does not report the feeder failure: %q", rr.Body.String())
+}
