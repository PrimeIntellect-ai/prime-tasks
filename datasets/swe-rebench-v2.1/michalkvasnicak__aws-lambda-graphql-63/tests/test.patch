+  it('obtains connection and subscription managers from the server, not from the context', async () => {
+    const connectionManager = {
+      sendToConnection: jest.fn(),
+    };
+    const subscriptionManager = {
+      subscribersByEventName: jest.fn(() => ({
+        [$$asyncIterator]: () =>
+          createAsyncIterator([
+            [
+              {
+                connection: {
+                  id: '1',
+                  data: { context: { authorId: '1' } },
+                } as any,
+                event: 'test',
+                operationId: '1',
+                operation: { query, variables: {} },
+              },
+            ] as ISubscriber[],
+          ]),
+      })),
+    };
+
+    const server = new Server({
+      context: { pubSub: new PubSub({ eventStore: {} as any }) },
+      connectionManager: connectionManager as any,
+      eventProcessor: new DynamoDBEventProcessor(),
+      schema: createSchema(),
+      subscriptionManager: subscriptionManager as any,
+    });
+
+    // Simulate GraphQL options whose context does not carry the managers, so
+    // the event processor has to obtain them from the server itself.
+    const createGraphQLServerOptions = server.createGraphQLServerOptions.bind(
+      server,
+    );
+    server.createGraphQLServerOptions = (async (event, ctx, internal) => {
+      const options = await createGraphQLServerOptions(event, ctx, internal);
+      const internalWithoutManagers = { ...options.$$internal } as any;
+      delete internalWithoutManagers.connectionManager;
+      delete internalWithoutManagers.subscriptionManager;
+      return { ...options, $$internal: internalWithoutManagers };
+    }) as any;
+
+    const eventProcessor = server.createEventHandler();
+
+    const Records: DynamoDBRecord[] = [
+      {
+        dynamodb: {
+          NewImage: DynamoDB.Converter.marshall({
+            event: 'test',
