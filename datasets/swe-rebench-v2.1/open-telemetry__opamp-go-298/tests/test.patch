+func TestHeaderFuncCalledOnEveryRequest(t *testing.T) {
+	testClients(t, func(t *testing.T, client OpAMPClient) {
+		// Start a server that records the Authorization header of every request.
+		srv := internal.StartMockServer(t)
+		observed := make(chan string, 10)
+		srv.OnConnect = func(r *http.Request) {
+			observed <- r.Header.Get("Authorization")
+		}
+
+		// Capture the server side of the WebSocket connection so that the test
+		// can force a reconnect (which performs another HTTP handshake).
+		var serverConn atomic.Value
+		srv.OnWSConnect = func(conn *websocket.Conn) {
+			serverConn.Store(conn)
+		}
+
+		// HeaderFunc returns a different value on every invocation so that a
+		// cached (stale) header can be detected.
+		var calls int64
+		hf := func(header http.Header) http.Header {
+			n := atomic.AddInt64(&calls, 1)
+			h := http.Header{}
+			for k, v := range header {
+				h[k] = v
+			}
+			h.Set("Authorization", fmt.Sprintf("Bearer %d", n))
+			return h
+		}
+
+		// Start a client.
+		settings := types.StartSettings{
+			OpAMPServerURL: "ws://" + srv.Endpoint,
+			HeaderFunc:     hf,
+		}
+		startClient(t, settings, client)
+
+		// Wait for the first request.
+		var first string
+		select {
+		case first = <-observed:
+		case <-time.After(5 * time.Second):
+			t.Fatal("timed out waiting for the first request")
+		}
+
+		// Trigger a second request to the server.
+		switch client.(type) {
+		case *httpClient:
+			// Each message send is a separate HTTP request.
+			assert.NoError(t, client.SetAgentDescription(createAgentDescr()))
+		case *wsClient:
+			// Drop the server side of the connection so the client reconnects,
+			// performing another HTTP handshake.
+			eventually(t, func() bool { return serverConn.Load() != nil })
+			conn := serverConn.Load().(*websocket.Conn)
+			assert.NoError(t, conn.Close())
+		}
+
+		// Wait for the second request and verify the headers were recomputed.
+		select {
+		case second := <-observed:
+			assert.NotEqual(t, first, second,
+				"HeaderFunc must be invoked again for each request")
+		case <-time.After(5 * time.Second):
+			t.Fatal("timed out waiting for the second request")
+		}
+
+		// Shutdown the Server and the client.
+		srv.Close()
+		_ = client.Stop(context.Background())
+	})
+}
