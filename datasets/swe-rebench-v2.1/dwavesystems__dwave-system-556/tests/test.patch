+        """DWaveSampler() can be used as a context manager and the underlying
+        client is closed on exit.
+        """
+
+        with DWaveSampler():
+            pass
+        MockClient.from_config.return_value.close.assert_called()
+
+        MockClient.reset_mock()
+        with self.assertRaises(RuntimeError):
+            with DWaveSampler():
