+    test('ol with indent', () {
+      final delta = Delta()
+        ..insert('Hello')
+        ..insert('\n', {'block': 'ol'})
+        ..insert('This is a')
+        ..insert('\n', {'block': 'ol', 'indent': 1})
+        ..insert('List')
+        ..insert('\n', {'block': 'ol'});
+      // Encoding a multi-level list must not throw and must keep the content.
+      final result =
+          parchmentMarkdown.encode(ParchmentDocument.fromDelta(delta));
+      expect(result, contains('Hello'));
+      expect(result, contains('This is a'));
+      expect(result, contains('List'));
+      // The nested item must be represented as an indented list item.
+      final nestedLine =
+          result.split('\n').firstWhere((line) => line.contains('This is a'));
+      expect(nestedLine, matches(RegExp(r'^\s+\S')));
+    });
+
+    test('ul with indent', () {
+      // Reproducer from the issue: an unordered list item with indent 1.
+      final delta = Delta()
+        ..insert('Hello')
+        ..insert('\n', {'block': 'ul'})
+        ..insert('World')
+        ..insert('\n', {'block': 'ul', 'indent': 1})
+        ..insert('\n');
+      final result =
+          parchmentMarkdown.encode(ParchmentDocument.fromDelta(delta));
+      expect(result, contains('Hello'));
+      expect(result, contains('World'));
+      final nestedLine =
+          result.split('\n').firstWhere((line) => line.contains('World'));
+      expect(nestedLine, matches(RegExp(r'^\s+\S')));
+    });
