+
+func TestGenerateServerCustomPrincipal(t *testing.T) {
+	target, err := ioutil.TempDir(".", "custom_principal_")
+	require.NoError(t, err)
+	defer os.RemoveAll(target)
+
+	opts := testGenOpts()
+	opts.Target = target
+	opts.Spec = "../fixtures/codegen/tasklist.basic.yml"
+	opts.Principal = "github.com/my/project/auth.Agent"
+
+	require.NoError(t, GenerateServer("", nil, []string{"createTask"}, opts))
+
+	handlerFile := filepath.Join(target, "restapi", "operations", "tasks", "create_task.go")
+	content, err := ioutil.ReadFile(handlerFile)
+	require.NoError(t, err)
+	generated := string(content)
+	require.Regexp(t, `HandlerFunc func\([^)]*,\s*\*\w+\.Agent\)`, generated)
+	require.Contains(t, generated, "github.com/my/project/auth")
+}
