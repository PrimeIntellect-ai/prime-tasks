@@ -567,3 +567,55 @@ func TestDecode_weakEmptyStringToInt(t *testing.T) {
 		t.Errorf("expected \n%#v, got: \n%#v", expectedResultWeak, resultWeak)
 	}
 }
+
+// GH-231: decode hooks receive the wrong type for the `to` argument.
+//
+// In the struct-to-struct case the decode hook must be given the real
+// destination type (here time.Time), not map[string]interface{}.
+func TestMapSquash(t *testing.T) {
+	type Input struct {
+		T *time.Time
+	}
+	type Output struct {
+		T time.Time
+	}
+
+	v := time.Now()
+
+	var toTypes []reflect.Type
+	hook := func(from, to reflect.Type, data interface{}) (interface{}, error) {
+		toTypes = append(toTypes, to)
+		return data, nil
+	}
+
+	out := &Output{}
+	d, err := NewDecoder(&DecoderConfig{
+		DecodeHook: hook,
+		Result:     out,
+	})
+	if err != nil {
+		t.Fatalf("err: %s", err)
+	}
+	if err := d.Decode(&Input{T: &v}); err != nil {
+		t.Fatalf("err: %s", err)
+	}
+
+	// The decode hook must receive time.Time as the destination type and must
+	// never be handed map[string]interface{} for this struct-to-struct decode.
+	var sawTime bool
+	for _, to := range toTypes {
+		if to == reflect.TypeOf(time.Time{}) {
+			sawTime = true
+		}
+		if to == reflect.TypeOf(map[string]interface{}{}) {
+			t.Fatalf("decode hook received map[string]interface{} as to type: %v", toTypes)
+		}
+	}
+	if !sawTime {
+		t.Fatalf("decode hook did not receive time.Time as to type: %v", toTypes)
+	}
+
+	if !v.Equal(out.T) {
+		t.Fatalf("expected %v, got %v", v, out.T)
+	}
+}
