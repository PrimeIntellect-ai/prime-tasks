@@ -13,8 +13,23 @@
 # limitations under the License.
 
 import datetime
+import os
 
+import pytest
+
+from google.auth import _helpers
 from google.auth import credentials
+from google.auth import crypt
+from google.auth import jwt
+
+
+DATA_DIR = os.path.join(os.path.dirname(__file__), 'data')
+
+with open(os.path.join(DATA_DIR, 'privatekey.pem'), 'rb') as fh:
+    PRIVATE_KEY_BYTES = fh.read()
+
+with open(os.path.join(DATA_DIR, 'public_cert.pem'), 'rb') as fh:
+    PUBLIC_CERT_BYTES = fh.read()
 
 
 class CredentialsImpl(credentials.Credentials):
@@ -37,8 +52,21 @@ def test_expired_and_valid():
     assert credentials.valid
     assert not credentials.expired
 
+    # Set the expiration in the past, but because of clock skew accomodation
+    # the credentials should still be valid.
+    credentials.expiry = (
+        datetime.datetime.utcnow() -
+        datetime.timedelta(seconds=1))
+
+    assert credentials.valid
+    assert not credentials.expired
+
+    # Set the credentials far enough in the past to exceed the clock skew
+    # accomodation. They should now be expired.
     credentials.expiry = (
-        datetime.datetime.utcnow() - datetime.timedelta(seconds=60))
+        datetime.datetime.utcnow() -
+        datetime.timedelta(minutes=5) -
+        datetime.timedelta(seconds=1))
 
     assert not credentials.valid
     assert credentials.expired
@@ -123,3 +151,29 @@ def test_create_scoped_if_required_not_scopes():
         unscoped_credentials, ['one', 'two'])
 
     assert scoped_credentials is unscoped_credentials
+
+
+def _make_jwt(expiry):
+    signer = crypt.RSASigner.from_string(PRIVATE_KEY_BYTES, '1')
+    now = _helpers.datetime_to_secs(_helpers.utcnow())
+    payload = {
+        'iat': now,
+        'exp': _helpers.datetime_to_secs(expiry),
+    }
+    return jwt.encode(signer, payload)
+
+
+def test_jwt_expiration_clock_skew():
+    # A token that expired less than five minutes ago is still accepted.
+    jwt.decode(
+        _make_jwt(_helpers.utcnow() - datetime.timedelta(seconds=1)),
+        certs=PUBLIC_CERT_BYTES)
+
+    # A token that expired more than five minutes ago is rejected.
+    with pytest.raises(ValueError) as excinfo:
+        jwt.decode(
+            _make_jwt(
+                _helpers.utcnow() - datetime.timedelta(minutes=5) -
+                datetime.timedelta(seconds=1)),
+            certs=PUBLIC_CERT_BYTES)
+    assert excinfo.match(r'Token expired')
