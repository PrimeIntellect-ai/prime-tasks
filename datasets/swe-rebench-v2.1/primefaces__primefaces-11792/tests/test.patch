+    @Test
+    void isIntegral() throws Exception {
+        // values
+        doReturn(BigDecimal.class).when(renderer).getTypeFromValueExpression(context, inputNumber);
+        assertFalse(callIsIntegral(BigDecimal.valueOf(5.5)));
+        doReturn(Number.class).when(renderer).getTypeFromValueExpression(context, inputNumber);
+        assertFalse(callIsIntegral(BigDecimal.valueOf(5.5)));
+        assertFalse(callIsIntegral(Double.valueOf(5.5)));
+        assertFalse(callIsIntegral(Float.valueOf(5.5f)));
+        doReturn(Number.class).when(renderer).getTypeFromValueExpression(context, inputNumber);
+        assertTrue(callIsIntegral(Integer.valueOf(3)));
+        assertTrue(callIsIntegral(Byte.valueOf((byte) 3)));
+        assertTrue(callIsIntegral(Short.valueOf((short) 3)));
+        assertTrue(callIsIntegral(Long.valueOf(3)));
+        assertTrue(callIsIntegral(BigInteger.valueOf(3)));
+
+        // nulls
+        doReturn(Integer.class).when(renderer).getTypeFromValueExpression(context, inputNumber);
+        assertTrue(callIsIntegral(null));
+        doReturn(Short.class).when(renderer).getTypeFromValueExpression(context, inputNumber);
+        assertTrue(callIsIntegral(null));
+        doReturn(Byte.class).when(renderer).getTypeFromValueExpression(context, inputNumber);
+        assertTrue(callIsIntegral(null));
+        doReturn(BigInteger.class).when(renderer).getTypeFromValueExpression(context, inputNumber);
+        assertTrue(callIsIntegral(null));
+        doReturn(Long.class).when(renderer).getTypeFromValueExpression(context, inputNumber);
+        assertTrue(callIsIntegral(null));
+        doReturn(BigDecimal.class).when(renderer).getTypeFromValueExpression(context, inputNumber);
+        assertFalse(callIsIntegral(null));
+        // GitHub #11791
+        doReturn(Number.class).when(renderer).getTypeFromValueExpression(context, inputNumber);
+        assertFalse(callIsIntegral(null));
+        // unknown type
+        doReturn(null).when(renderer).getTypeFromValueExpression(context, inputNumber);
+        assertFalse(callIsIntegral(null));
+    }
+
+    @Test
+    void isIntegralIsProtected() throws NoSuchMethodException {
+        assertTrue(Modifier.isProtected(isIntegralMethod().getModifiers()));
+    }
+
+    private Method isIntegralMethod() throws NoSuchMethodException {
+        return InputNumberRenderer.class.getDeclaredMethod("isIntegral", FacesContext.class, InputNumber.class, Object.class);
+    }
+
+    private boolean callIsIntegral(Object value) throws Exception {
+        Method method = isIntegralMethod();
+        method.setAccessible(true);
+        return (boolean) method.invoke(renderer, context, inputNumber, value);
+    }
