+
+// https://github.com/gleam-lang/gleam/issues/4625
+#[test]
+fn no_variable_completions_after_case_scope() {
+    let code = "
+pub fn main() {
+  case todo {
+    something -> Nil
+  }
+  s
+}
+";
+
+    let completions = completion(TestProject::for_source(code), Position::new(5, 3));
+    assert!(!completions.iter().any(|item| item.label == "something"));
+}
+
+// https://github.com/gleam-lang/gleam/issues/4625
+#[test]
+fn no_variable_completions_after_case_clause_scope() {
+    let code = "
+pub fn main() {
+  case todo {
+    something -> {
+      let x = 1
+    }
+    something_else -> s
+  }
+  s
+}
+";
+
+    let completions = completion(TestProject::for_source(code), Position::new(6, 23));
+    assert!(!completions.iter().any(|item| item.label == "something"));
+    assert!(!completions.iter().any(|item| item.label == "x"));
+}
+
+// https://github.com/gleam-lang/gleam/issues/4625
+#[test]
+fn no_variable_completions_before_case_clause() {
+    let code = "
+pub fn main() {
+  case todo {
+    something -> s
+    something_else -> Nil
+  }
+  s
+}
+";
+
+    let completions = completion(TestProject::for_source(code), Position::new(3, 18));
+    assert!(!completions.iter().any(|item| item.label == "something_else"));
+}
+
+#[test]
+fn no_later_arm_body_locals_in_current_arm_completions() {
+    let code = "
+pub fn main() {
+  case todo {
+    current_arm -> {
+      let current = 1
+      s
+    }
+    later_arm -> {
+      let later_body = 2
+    }
+  }
+}
+";
+
+    let completions = completion(TestProject::for_source(code), Position::new(5, 7));
+    assert!(!completions.iter().any(|item| item.label == "later_arm"));
+    assert!(!completions.iter().any(|item| item.label == "later_body"));
+}
+
+#[test]
+fn no_arm_body_locals_after_case_expression() {
+    let code = "
+pub fn main() {
+  case todo {
+    arm_pattern -> {
+      let arm_body = 1
+    }
+    other_pattern -> Nil
+  }
+  s
+}
+";
+
+    let completions = completion(TestProject::for_source(code), Position::new(8, 3));
+    assert!(!completions.iter().any(|item| item.label == "arm_pattern"));
+    assert!(!completions.iter().any(|item| item.label == "arm_body"));
+}
