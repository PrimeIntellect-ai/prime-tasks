@@ -0,0 +1,43 @@
+package printer
+
+import (
+	"io/ioutil"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/doitintl/kube-no-trouble/pkg/judge"
+)
+
+func TestTextPrinterPrint(t *testing.T) {
+	tmpFile, err := ioutil.TempFile(os.TempDir(), "kubent-tests-")
+	if err != nil {
+		t.Fatalf("failed to create temp file for testing: %v", err)
+	}
+	tmpFile.Close()
+	defer os.Remove(tmpFile.Name())
+
+	p, err := NewPrinter("text", tmpFile.Name())
+	if err != nil {
+		t.Fatalf("unexpected error creating printer: %v", err)
+	}
+	defer p.Close()
+
+	version, _ := judge.NewVersion("1.2.3")
+	results := []judge.Result{{"Name", "Namespace", "Kind", "1.2.3", "Test", "4.5.6", version}}
+
+	if err := p.Print(results); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	readBytes, err := ioutil.ReadFile(tmpFile.Name())
+	if err != nil {
+		t.Fatalf("unexpected error reading back the file: %v", err)
+	}
+	if len(readBytes) == 0 {
+		t.Fatalf("expected non-empty output file")
+	}
+	if !strings.Contains(string(readBytes), "Name") {
+		t.Fatalf("expected output to contain the result name, got: %q", string(readBytes))
+	}
+}
