@@ -161,3 +161,37 @@ func TestContext(t *testing.T) {
 		}
 	}
 }
+
+func TestOutputFileFromFlags(t *testing.T) {
+	oldArgs := os.Args[1]
+	defer func() { os.Args[1] = oldArgs }()
+
+	tests := []struct {
+		name         string
+		arg          string
+		want         string
+		errorAllowed bool
+	}{
+		{"stdout", "-", "-", false},
+		{"relative", "my.log", "my.log", false},
+		{"absolute", "/my.log", "/my.log", false},
+		{"empty", "", "", true},
+		{"does-not-exist", "/this/directory/is/unlikely/to/exist", "/this/directory/is/unlikely/to/exist", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			pflag.CommandLine = pflag.NewFlagSet(os.Args[0], pflag.ContinueOnError)
+			os.Args[1] = "--output-file=" + tt.arg
+			config, err := NewFromFlags()
+			if err != nil {
+				if !tt.errorAllowed {
+					t.Fatalf("unexpected error parsing output-file flag: %v", err)
+				}
+				return
+			}
+			if config.OutputFile != tt.want {
+				t.Errorf("expected output file %q, got %q", tt.want, config.OutputFile)
+			}
+		})
+	}
+}
