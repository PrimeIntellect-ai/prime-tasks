+func Test_ResolvesHostnameFromSshConfig(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+
+	s := conn.Setup(ctrl).
+		CheckRepos(nil, nil).
+		GetBranchNames("@main_issue1", nil, nil).
+		GetMergedBranchNames("@main_issue1", nil, nil).
+		GetLog([]conn.LogStub{
+			{"main", "main_issue1Merged"}, {"issue1", "issue1Merged"},
+		}, nil, nil).
+		GetAssociatedRefNames([]conn.AssociatedBranchNamesStub{
+			{"b8a2645298053fb62ea03e27feea6c483d3fd27e", "main_issue1"},
+			{"a97e9630426df5d34ca9ee77ae1159bdfd5ff8f0", "main_issue1"},
+			{"6ebe3d30d23531af56bd23b5a098d3ccae2a534a", "main_issue1"},
+		}, nil, nil).
+		GetPullRequests("issue1Merged", nil, nil).
+		GetUncommittedChanges("", nil, nil).
+		GetConfig([]conn.ConfigStub{
+			{"branch.main.merge", "main"},
+			{"branch.issue1.merge", "issue1"},
+		}, nil, nil)
+
+	s.Conn.EXPECT().GetRemoteNames().Return(
+		"origin\tgit@github.com-work:owner/repo.git (fetch)\n"+
+			"origin\tgit@github.com-work:owner/repo.git (push)\n", nil)
+	s.Conn.EXPECT().GetRepoNames("github.com", "owner/repo").Return(
+		`{"defaultBranchRef":{"name":"main"},"name":"repo","owner":{"id":"1","login":"owner"},"parent":null}`, nil)
+
+	sshConn := withSshConfig(s.Conn, "user owner\nhostname github.com\n", nil)
+
+	actual, err := GetBranches(sshConn, false)
+
+	assert.Contains(t, sshConn.names, "github.com-work")
+	assert.Nil(t, err)
+	assert.Equal(t, []Branch{
+		{
+			false, "issue1", true,
+			[]string{
+				"a97e9630426df5d34ca9ee77ae1159bdfd5ff8f0",
+			},
+			[]PullRequest{
+				{
+					"issue1", Merged, false, 1,
+					[]string{
+						"a97e9630426df5d34ca9ee77ae1159bdfd5ff8f0",
+					},
+					"https://github.com/owner/repo/pull/1", "owner",
+				},
+			},
+			Deletable,
+		},
+		{
+			true, "main", true,
+			[]string{},
+			[]PullRequest{},
+			NotDeletable,
+		},
+	}, actual)
+}
