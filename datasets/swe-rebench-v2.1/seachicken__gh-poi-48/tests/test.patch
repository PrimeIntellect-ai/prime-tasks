+func invokeGetSshConfig(t *testing.T, target interface{}, name string) (string, error) {
+	t.Helper()
+	method := reflect.ValueOf(target).MethodByName("GetSshConfig")
+	if !method.IsValid() {
+		t.Fatalf("%T does not expose GetSshConfig", target)
+	}
+	results := method.Call([]reflect.Value{reflect.ValueOf(name)})
+	output := results[0].String()
+	if results[1].IsNil() {
+		return output, nil
+	}
+	err, ok := results[1].Interface().(error)
+	if !ok {
+		t.Fatalf("GetSshConfig returned %T as its error result", results[1].Interface())
+	}
+	return output, err
+}
+
+func Test_GetSshConfigInvokesSshAndReturnsItsOutput(t *testing.T) {
+	method, ok := reflect.TypeOf((*Connection)(nil)).Elem().MethodByName("GetSshConfig")
+	if !ok {
+		t.Fatal("Connection does not expose GetSshConfig")
+	}
+	assert.Equal(t, 1, method.Type.NumIn())
+	assert.Equal(t, reflect.TypeOf(""), method.Type.In(0))
+	assert.Equal(t, 2, method.Type.NumOut())
+	assert.Equal(t, reflect.TypeOf(""), method.Type.Out(0))
+	assert.Equal(t, reflect.TypeOf((*error)(nil)).Elem(), method.Type.Out(1))
+
+	dir := t.TempDir()
+	sshPath := filepath.Join(dir, "ssh")
+	argsPath := filepath.Join(dir, "args")
+	script := "#!/bin/sh\nprintf '%s\\n' \"$@\" > '" + argsPath + "'\nprintf 'hostname github.com\\nmarker-ssh-config-9f3a\\n'\n"
+	if err := os.WriteFile(sshPath, []byte(script), 0755); err != nil {
+		t.Fatal(err)
+	}
+
+	oldPath := os.Getenv("PATH")
+	os.Setenv("PATH", dir+string(os.PathListSeparator)+oldPath)
+	defer os.Setenv("PATH", oldPath)
+
+	actual, err := invokeGetSshConfig(t, &conn.Connection{}, "github.com-work")
+
+	assert.Nil(t, err)
+	assert.Equal(t, "hostname github.com\nmarker-ssh-config-9f3a\n", actual)
+	args, readErr := os.ReadFile(argsPath)
+	assert.NoError(t, readErr)
+	assert.Equal(t, "-T\n-G\ngithub.com-work\n", string(args))
+}
+
+func Test_GetSshConfigReturnsAnErrorWhenSshFails(t *testing.T) {
+	dir := t.TempDir()
+	sshPath := filepath.Join(dir, "ssh")
+	if err := os.WriteFile(sshPath, []byte("#!/bin/sh\nprintf 'some error\\n' >&2\nexit 1\n"), 0755); err != nil {
+		t.Fatal(err)
+	}
+
+	oldPath := os.Getenv("PATH")
+	os.Setenv("PATH", dir+string(os.PathListSeparator)+oldPath)
+	defer os.Setenv("PATH", oldPath)
+
+	_, err := invokeGetSshConfig(t, &conn.Connection{}, "github.com")
+
+	assert.NotNil(t, err)
+}
