+type sshConfigTestConnection struct {
+	*mocks.MockConnection
+	output string
+	err    error
+	names  []string
+}
+
+func (c *sshConfigTestConnection) GetSshConfig(name string) (string, error) {
+	c.names = append(c.names, name)
+	return c.output, c.err
+}
+
+func withSshConfig(mock *mocks.MockConnection, output string, err error) *sshConfigTestConnection {
+	return &sshConfigTestConnection{MockConnection: mock, output: output, err: err}
+}
