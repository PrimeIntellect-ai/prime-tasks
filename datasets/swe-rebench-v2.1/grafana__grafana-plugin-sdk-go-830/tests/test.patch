+
+func TestRepeatedDatasourceHeadersAreSentOnOutboundRequest(t *testing.T) {
+	settings, err := parseHTTPSettings(
+		[]byte(`{"httpHeaderName1":"X-Multi", "httpHeaderName2":"X-Multi"}`),
+		map[string]string{"httpHeaderValue1": "first", "httpHeaderValue2": "second"},
+	)
+	require.NoError(t, err)
+
+	values := make(chan []string, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		values <- r.Header.Values("X-Multi")
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+
+	client, err := httpclient.New(settings.HTTPClientOptions())
+	require.NoError(t, err)
+	res, err := client.Get(server.URL)
+	require.NoError(t, err)
+	require.NoError(t, res.Body.Close())
+	require.ElementsMatch(t, []string{"first", "second"}, <-values)
+}
