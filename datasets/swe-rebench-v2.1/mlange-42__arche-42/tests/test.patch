+func TestArchetypeGraph(t *testing.T) {
+	world := NewWorld()
+
+	posID := ComponentID[position](&world)
+	velID := ComponentID[velocity](&world)
+	rotID := ComponentID[rotation](&world)
+	entity := world.NewEntity()
+	archEmpty := world.entities[entity.id].arch
+
+	world.Add(entity, posID)
+	arch0 := world.entities[entity.id].arch
+	world.Remove(entity, posID)
+	assert.Same(t, archEmpty, world.entities[entity.id].arch)
+
+	world.Add(entity, posID, velID)
+	arch01 := world.entities[entity.id].arch
+	world.Add(entity, rotID)
+	arch012 := world.entities[entity.id].arch
+	assert.ElementsMatch(t, []ID{posID, velID, rotID}, arch012.ids)
+
+	extraID := ComponentID[uint64](&world)
+	created := world.findOrCreateArchetype(arch012, []ID{extraID}, []ID{rotID})
+	assert.ElementsMatch(t, []ID{posID, velID, extraID}, created.ids)
+	assert.Same(t, created, world.findOrCreateArchetype(arch012, []ID{extraID}, []ID{rotID}))
+
+	world.Remove(entity, posID, rotID, velID)
+	assert.Same(t, archEmpty, world.entities[entity.id].arch)
+
+	checkTransition := func(arch *archetype, method string, id ID, target *archetype, exists bool) {
+		t.Helper()
+		result := reflect.ValueOf(arch).MethodByName(method)
+		if !result.IsValid() {
+			t.Fatalf("archetype does not provide %s", method)
+		}
+		values := result.Call([]reflect.Value{reflect.ValueOf(id)})
+		assert.Equal(t, exists, values[1].Bool())
+		if exists {
+			assert.Same(t, target, values[0].Interface())
+		}
+	}
+	checkTransition(archEmpty, "GetTransitionAdd", posID, arch0, true)
+	checkTransition(arch0, "GetTransitionRemove", posID, archEmpty, true)
+	checkTransition(arch0, "GetTransitionAdd", velID, arch01, true)
+	checkTransition(arch01, "GetTransitionAdd", rotID, arch012, true)
+	checkTransition(archEmpty, "GetTransitionRemove", posID, nil, false)
+}
