+
+test('Makes generated source maps available for functions', async (t) => {
+  const { tmpDir } = await zipNode(t, 'node-module-and-local-imports', {
+    opts: { config: { '*': { nodeBundler: ESBUILD, nodeSourcemap: true, sourcemap: true } } },
+  })
+
+  const findSourceMaps = async (directory) => {
+    const entries = await pReaddir(directory, { withFileTypes: true })
+    const nestedMaps = await Promise.all(
+      entries.map(async (entry) => {
+        const entryPath = join(directory, entry.name)
+
+        if (entry.isDirectory()) {
+          return findSourceMaps(entryPath)
+        }
+
+        if (entry.name.endsWith('.map')) {
+          return [JSON.parse(await pReadFile(entryPath, 'utf8'))]
+        }
+
+        if (entry.name.endsWith('.js')) {
+          const source = await pReadFile(entryPath, 'utf8')
+          const [sourceMappingUrl] = source.match(/sourceMappingURL=(data:application\/json[^\s]*)/) || []
+
+          if (sourceMappingUrl) {
+            const dataUrl = sourceMappingUrl.slice('sourceMappingURL='.length)
+            const [metadata, encodedMap] = dataUrl.split(',', 2)
+            const mapContents = metadata.includes(';base64')
+              ? Buffer.from(encodedMap, 'base64').toString('utf8')
+              : decodeURIComponent(encodedMap)
+
+            return [JSON.parse(mapContents)]
+          }
+        }
+
+        return []
+      }),
+    )
+
+    return nestedMaps.flat()
+  }
+
+  const sourceMaps = await findSourceMaps(tmpDir)
+
+  t.true(
+    sourceMaps.some(
+      ({ version, sources, mappings }) =>
+        version === 3 && Array.isArray(sources) && sources.length > 0 && typeof mappings === 'string' && mappings.length > 0,
+    ),
+  )
+})
