+  const wrapper = container.querySelector(".react-datepicker__year-wrapper")!;
+  const plainOption = document.createElement("span");
+  plainOption.className = "react-datepicker__year-text";
+  wrapper.appendChild(plainOption);
+
+  try {
+    const expectedStyle = window.getComputedStyle(plainOption);
+    const yearOptions = wrapper.querySelectorAll(
+      ".react-datepicker__year-text:not(:last-child)",
