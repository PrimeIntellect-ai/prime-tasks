+            if (url === "variables" || url === "mixins") {
+              return new URL(`rebench:/${url}`);
+            }
+            return null;
+          },
+          load(url) {
+            const name = url.pathname.slice(1);
+            return {
+              contents: readFileSync(`src/stylesheets/${name}.scss`, "utf8"),
+              syntax: "scss",
+            };
+          },
+        },
+      ],
+    },
+  ).css;
+  document.head.appendChild(style);
