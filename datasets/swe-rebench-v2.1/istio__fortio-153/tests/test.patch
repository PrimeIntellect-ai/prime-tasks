+func TestDebugHandlerHostFirstLexicalOrder(t *testing.T) {
+	p, m := DynamicHTTPServer(false)
+	m.HandleFunc("/debug", DebugHandler)
+	url := fmt.Sprintf("http://localhost:%d/debug", p)
+	o := HTTPOptions{URL: url, DisableFastClient: true}
+	o.AddAndValidateExtraHeader("BBB: bbb")
+	o.AddAndValidateExtraHeader("CCC: ccc")
+	o.AddAndValidateExtraHeader("ZZZ: zzz")
+	o.AddAndValidateExtraHeader("AAA: aaa")
+	client := NewClient(&o)
+	code, data, header := client.Fetch() // used to panic/bug #127
+	t.Logf("TestDebugHandlerHostFirstLexicalOrder result code %d, data len %d, headerlen %d", code, len(data), header)
+	if code != http.StatusOK {
+		t.Errorf("Got %d instead of 200", code)
+	}
+	// Check only the displayed headers; unrelated request framing and line endings
+	// are not part of the ordering requirement.
+	body := strings.ReplaceAll(string(data), "\r\n", "\n")
+	start := strings.Index(body, "headers:\n")
+	if start < 0 {
+		t.Fatal("response does not contain a headers section")
+	}
+	start += len("headers:\n")
+	section := strings.TrimLeft(body[start:], "\n")
+	if end := strings.Index(section, "\n\n"); end >= 0 {
+		section = section[:end]
+	}
+	lines := strings.Split(strings.TrimSpace(section), "\n")
+	if len(lines) == 0 || lines[0] == "" {
+		t.Fatalf("expected a Host header in the displayed headers, got %q", section)
+	}
+	if !strings.HasPrefix(lines[0], "Host:") {
+		t.Errorf("Host header should be first, got %q", lines[0])
+	}
+
+	names := make([]string, 0, len(lines)-1)
+	for _, line := range lines[1:] {
+		parts := strings.SplitN(line, ":", 2)
+		if len(parts) != 2 {
+			t.Fatalf("malformed displayed header line %q", line)
+		}
+		names = append(names, parts[0])
+	}
+	for _, expected := range []string{"Aaa", "Bbb", "Ccc", "Zzz"} {
+		found := false
+		for _, name := range names {
+			if strings.EqualFold(name, expected) {
+				found = true
+				break
+			}
+		}
+		if !found {
+			t.Errorf("displayed headers do not include %s", expected)
+		}
+	}
+	if !sort.StringsAreSorted(names) {
+		t.Errorf("non-Host headers are not sorted by name: %v", names)
+	}
+}
