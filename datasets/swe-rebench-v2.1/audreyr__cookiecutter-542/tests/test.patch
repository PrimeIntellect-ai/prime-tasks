+def test_choices(context_file, default_context):
+    """Keep the configured choice value among the available options."""
+    generated_context = generate.generate_context(
+        context_file, default_context
+    )
+
+    choices = generated_context['choices_template']['orientation']
+    assert isinstance(choices, list)
+    assert set(choices) == {'all', 'landscape', 'portrait'}
+
+
+def test_choice_prompt_available_with_default_context(
+        context_file, default_context):
+    """Offer choices and select the configured choice when input is empty."""
+    generated_context = generate.generate_context(
+        context_file, default_context
+    )
+    context = {'cookiecutter': {
+        'orientation': generated_context['choices_template']['orientation'],
+    }}
+
+    @click.command()
+    def run_prompt():
+        result = prompt.prompt_for_config(context)
+        click.echo(result['orientation'])
+
+    result = CliRunner().invoke(run_prompt, input='\n')
+
+    assert result.exit_code == 0
+    assert all(
+        option in result.output for option in ('all', 'landscape', 'portrait')
+    )
+    assert result.output.rstrip().endswith('landscape')
