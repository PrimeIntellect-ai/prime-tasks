+defmodule Test.Regressions.I154CrashOnSymbolicInputTest do
+  use ExUnit.Case
+
+  test "as_ast does not crash on symbolic input" do
+    md = "\\[{:}"
+    assert {:ok, _ast, _messages} = Earmark.as_ast(md)
+  end
+
+  test "as_html renders symbolic input" do
+    md = "\\[{:}"
+    html = "<p>\n[{:}</p>\n"
+    assert Earmark.as_html(md) == {:ok, html, []}
+  end
+end
