diff --git a/test/jsonapi/view_test.exs b/test/jsonapi/view_test.exs
index a2675b1..7c76717 100644
--- a/test/jsonapi/view_test.exs
+++ b/test/jsonapi/view_test.exs
@@ -17,6 +17,16 @@ defmodule JSONAPI.ViewTest do
     use JSONAPI.View, type: "posts", namespace: "/api"
   end
 
+  defmodule UserView do
+    use JSONAPI.View,
+      type: "users",
+      namespace: "/api"
+
+    def fields do
+      [:age, :first_name, :last_name]
+    end
+  end
+
   alias JSONAPI.ViewTest.CommentView
 
   test "type/0 when specified via using macro" do
@@ -41,4 +51,28 @@ defmodule JSONAPI.ViewTest do
   test "render/2 is not defined when 'Phoenix' is not loaded" do
     refute {:render, 2} in PostView.__info__(:functions)
   end
+
+  test "attributes with `:underscore_to_dash` are emitted with dashes" do
+    previous_setting = Application.get_env(:jsonapi, :underscore_to_dash)
+    Application.put_env(:jsonapi, :underscore_to_dash, true)
+
+    try do
+      resource = JSONAPI.Serializer.serialize(UserView, %{id: 1, age: 100, first_name: "Jason", last_name: "S"}, nil)
+      |> Poison.encode!()
+      |> Poison.decode!()
+      |> Map.fetch!("data")
+
+      assert Map.fetch!(resource, "attributes") == %{
+        "age" => 100,
+        "first-name" => "Jason",
+        "last-name" => "S"
+      }
+    after
+      if is_nil(previous_setting) do
+        Application.delete_env(:jsonapi, :underscore_to_dash)
+      else
+        Application.put_env(:jsonapi, :underscore_to_dash, previous_setting)
+      end
+    end
+  end
 end
