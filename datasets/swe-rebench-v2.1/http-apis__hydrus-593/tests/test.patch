+    def test_collection_managed_class_foreign_key_cascades(
+            self, test_app_client, constants, doc, session):
+        """Database-level deletion of a managed class cascades to collection members."""
+        api_name = constants['API_NAME']
+        endpoints = test_app_client.get(f'/{api_name}').json['collections']
+
+        for endpoint in endpoints:
+            collection_name = '/'.join(
+                endpoint['@id'].split(f'/{api_name}/')[1:])
+            collection = doc.collections[collection_name]['collection']
+            if not collection.manages:
+                continue
+            managed_class = collection.manages['object'].split(DocUrl.doc_url)[1]
+            foreign_keys = [
+                key for key in inspect(session.get_bind()).get_foreign_keys(
+                    collection.name)
+                if key['referred_table'] == managed_class
+            ]
+            assert foreign_keys, (
+                f'{collection.name} must reference managed class {managed_class}')
+
+            foreign_key = foreign_keys[0]
+            dummy_object = gen_dummy_object(collection.name, doc)
+            response = test_app_client.put(
+                endpoint['@id'], data=json.dumps(dummy_object))
+            assert response.status_code == 201
+            member_id = get_ids_list(dummy_object).split(',')[0]
+            member_column = foreign_key['constrained_columns'][0]
+
+            before = session.execute(
+                text(f'SELECT COUNT(*) FROM "{collection.name}" '
+                     f'WHERE "{member_column}" = :member_id'),
+                {'member_id': member_id}).scalar()
+            assert before == 1
+
+            # Delete directly in the database, not through the application's
+            # class-deletion path, so only the database constraint can cascade.
+            session.execute(
+                text(f'DELETE FROM "{managed_class}" WHERE id = :member_id'),
+                {'member_id': member_id})
+            session.commit()
+            after = session.execute(
+                text(f'SELECT COUNT(*) FROM "{collection.name}" '
+                     f'WHERE "{member_column}" = :member_id'),
+                {'member_id': member_id}).scalar()
+            assert after == 0
+            return
+
+        pytest.fail('No collection directly manages a class in the API document')
+
