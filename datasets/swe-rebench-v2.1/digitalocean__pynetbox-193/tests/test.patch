+++ b/tests/unit/test_query.py
@@ -0,0 +1,84 @@
+import json
+import unittest
+
+import six
+
+from pynetbox.core.query import Request, RequestError, ContentError
+
+if six.PY3:
+    from unittest.mock import Mock
+else:
+    from mock import Mock
+from six.moves.urllib.parse import urlparse, parse_qs, urlencode
+
+
+class RequestTestCase(unittest.TestCase):
+    def _make_request(self, filters=None):
+        test_obj = Request(
+            http_session=Mock(),
+            base="http://localhost:8001/api/dcim/devices",
+            filters=filters,
+        )
+        test_obj.http_session.get.return_value.ok = True
+        test_obj.http_session.get.return_value.json.return_value = {
+            "count": 42,
+            "next": "http://localhost:8001/api/dcim/devices?limit=1&offset=1",
+            "previous": False,
+            "results": [],
+        }
+        return test_obj
+
+    def _requested_url(self, test_obj):
+        args, kwargs = test_obj.http_session.get.call_args
+        if args:
+            return args[0]
+        return kwargs["url"]
+
+    def _requested_params(self, test_obj):
+        args, kwargs = test_obj.http_session.get.call_args
+        url = args[0] if args else kwargs.get("url", "")
+        query = urlparse(url).query
+        extra = urlencode(kwargs.get("params", {}), doseq=True)
+        return parse_qs("&".join(part for part in (query, extra) if part))
+
+    def _assert_single_item_limit(self, params):
+        # A count request must not download the full dataset: the
+        # limit must be present and cap the result items at one.
+        self.assertIn("limit", params)
+        self.assertIn(params["limit"][0], ["0", "1"])
+
+    def test_get_count(self):
+        test_obj = self._make_request(filters={"q": "abcd"})
+        test = test_obj.get_count()
+        self.assertEqual(test, 42)
+        url = self._requested_url(test_obj)
+        self.assertIn("devices", url)
+        params = self._requested_params(test_obj)
+        self.assertEqual(params.get("q"), ["abcd"])
+        self._assert_single_item_limit(params)
+
+    def test_get_count_no_filters(self):
+        test_obj = self._make_request()
+        test = test_obj.get_count()
+        self.assertEqual(test, 42)
+        url = self._requested_url(test_obj)
+        self.assertIn("devices", url)
+        params = self._requested_params(test_obj)
+        self._assert_single_item_limit(params)
+
+    def test_get_count_request_error(self):
+        test_obj = self._make_request(filters={"q": "abcd"})
+        test_obj.http_session.get.return_value.ok = False
+        with self.assertRaises(RequestError):
+            test_obj.get_count()
+
+    def test_get_count_content_error(self):
+        test_obj = self._make_request(filters={"q": "abcd"})
+        response = test_obj.http_session.get.return_value
+        response.text = "not json"
+        response.content = b"not json"
+        response.json.side_effect = json.JSONDecodeError(
+            "Expecting value", "not json", 0
+        )
+        with self.assertRaises(ContentError):
+            test_obj.get_count()
