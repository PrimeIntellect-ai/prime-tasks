diff --git a/test/absinthe/federation/notation_test.exs b/test/absinthe/federation/notation_test.exs
index 32dbe2e..2500ce7 100644
--- a/test/absinthe/federation/notation_test.exs
+++ b/test/absinthe/federation/notation_test.exs
@@ -162,5 +162,37 @@ defmodule Absinthe.Federation.NotationTest do
       assert sdl =~ ~s{directive @custom on SCHEMA}
       assert sdl =~ ~s{directive @other on OBJECT}
     end
+
+    test "schema with an interfaceObject is valid" do
+      defmodule InterfaceObjectSchema do
+        use Absinthe.Schema
+        use Absinthe.Federation.Schema
+
+        extend schema do
+          directive :link, url: "https://specs.apollo.dev/federation/v2.3", import: ["@interfaceObject", "@key"]
+        end
+
+        import_sdl """
+        type Query {
+          hello: Media
+        }
+
+        type Media @interfaceObject @key(fields: "id") {
+          id: ID! @external
+          reviews: [Review!]!
+        }
+
+        type Review {
+          score: Int!
+        }
+        """
+      end
+
+      sdl = Absinthe.Schema.to_sdl(InterfaceObjectSchema)
+
+      [media_type] = Regex.run(~r/type Media\b[^{}]*\{/, sdl)
+      assert media_type =~ "@interfaceObject"
+      assert media_type =~ ~s{@key(fields: "id")}
+    end
   end
 end
