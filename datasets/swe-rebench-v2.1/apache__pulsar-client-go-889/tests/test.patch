+// fakeConnection is a no-op Connection that lets the reconnection logic run
+// without a real broker.
+type fakeConnection struct {
+	mu        sync.Mutex
+	listeners map[uint64]internal.ConnectionListener
+	handlers  map[uint64]internal.ConsumerHandler
+}
+
+func (c *fakeConnection) SendRequest(requestID uint64, req *pb.BaseCommand, callback func(*pb.BaseCommand, error)) {
+}
+func (c *fakeConnection) SendRequestNoWait(req *pb.BaseCommand) error { return nil }
+func (c *fakeConnection) WriteData(data internal.Buffer)              {}
+func (c *fakeConnection) RegisterListener(id uint64, listener internal.ConnectionListener) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.listeners == nil {
+		c.listeners = make(map[uint64]internal.ConnectionListener)
+	}
+	c.listeners[id] = listener
+	return nil
+}
+func (c *fakeConnection) UnregisterListener(id uint64) {
+	c.mu.Lock()
+	delete(c.listeners, id)
+	c.mu.Unlock()
+}
+func (c *fakeConnection) AddConsumeHandler(id uint64, handler internal.ConsumerHandler) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.handlers == nil {
+		c.handlers = make(map[uint64]internal.ConsumerHandler)
+	}
+	c.handlers[id] = handler
+	return nil
+}
+func (c *fakeConnection) DeleteConsumeHandler(id uint64) {
+	c.mu.Lock()
+	delete(c.handlers, id)
+	c.mu.Unlock()
+}
+
+// disconnect simulates the broker connection closing and notifies its users.
+func (c *fakeConnection) disconnect() {
+	c.mu.Lock()
+	listeners := make([]internal.ConnectionListener, 0, len(c.listeners))
+	for _, listener := range c.listeners {
+		listeners = append(listeners, listener)
+	}
+	handlers := make([]internal.ConsumerHandler, 0, len(c.handlers))
+	for _, handler := range c.handlers {
+		handlers = append(handlers, handler)
+	}
+	c.mu.Unlock()
+	for _, listener := range listeners {
+		listener.ConnectionClosed()
+	}
+	for _, handler := range handlers {
+		handler.ConnectionClosed()
+	}
+}
+func (c *fakeConnection) ID() string               { return "fake" }
+func (c *fakeConnection) GetMaxMessageSize() int32 { return 5 * 1024 * 1024 }
+func (c *fakeConnection) Close()                   {}
+
+// fakeRPCClient answers every request with a successful response so that
+// consumers, producers and readers can be created without a broker.
+type fakeRPCClient struct {
+	conn     *fakeConnection
+	id       uint64
+	requests chan time.Time
+}
+
+func (r *fakeRPCClient) NewRequestID() uint64  { r.id++; return r.id }
+func (r *fakeRPCClient) NewProducerID() uint64 { r.id++; return r.id }
+func (r *fakeRPCClient) NewConsumerID() uint64 { r.id++; return r.id }
+func (r *fakeRPCClient) RequestToAnyBroker(requestID uint64, cmdType pb.BaseCommand_Type, message proto.Message) (*internal.RPCResult, error) {
+	return nil, nil
+}
+func (r *fakeRPCClient) Request(logicalAddr *url.URL, physicalAddr *url.URL, requestID uint64, cmdType pb.BaseCommand_Type, message proto.Message) (*internal.RPCResult, error) {
+	r.requests <- time.Now()
+	return &internal.RPCResult{
+		Cnx:      r.conn,
+		Response: &pb.BaseCommand{Type: pb.BaseCommand_SUCCESS.Enum()},
+	}, nil
+}
+func (r *fakeRPCClient) RequestOnCnxNoWait(cnx internal.Connection, cmdType pb.BaseCommand_Type, message proto.Message) error {
+	return nil
+}
+func (r *fakeRPCClient) RequestOnCnx(cnx internal.Connection, requestID uint64, cmdType pb.BaseCommand_Type, message proto.Message) (*internal.RPCResult, error) {
+	return &internal.RPCResult{Cnx: cnx, Response: &pb.BaseCommand{Type: pb.BaseCommand_SUCCESS.Enum()}}, nil
+}
+
+// newFakeClient returns a client backed by in-memory fakes so that client
+// operations can be exercised without a running broker.
+func newFakeClient() *client {
+	c, _, _ := newFakeClientWithConnection()
+	return c
+}
+
+func newFakeClientWithConnection() (*client, *fakeConnection, chan time.Time) {
+	conn := &fakeConnection{}
+	requests := make(chan time.Time, 100)
+	c := &client{
+		rpcClient:     &fakeRPCClient{conn: conn, requests: requests},
+		lookupService: &fakeLookupService{},
+		handlers:      internal.NewClientHandlers(),
+		metrics:       internal.NewMetricsProvider(4, map[string]string{}, prometheus.DefaultRegisterer),
+		log:           plog.DefaultNopLogger(),
+	}
+	return c, conn, requests
+}
+
+// assertPublicReconnectDelay triggers a connection loss and checks that the
+// next broker request follows the delay returned by the supplied policy.
+func assertPublicReconnectDelay(t *testing.T, conn *fakeConnection, requests chan time.Time, policy *recordingBackoffPolicy) {
+	t.Helper()
+	for len(requests) > 0 {
+		<-requests
+	}
+	conn.disconnect()
+	var policyCalled time.Time
+	select {
+	case policyCalled = <-policy.calls:
+	case <-time.After(10 * time.Second):
+		t.Fatal("reconnection did not request a backoff delay")
+	}
+	select {
+	case attempt := <-requests:
+		assert.GreaterOrEqual(t, attempt.Sub(policyCalled), policy.delay-20*time.Millisecond,
+			"broker reconnection was attempted before the policy delay elapsed")
+	case <-time.After(10 * time.Second):
+		t.Fatal("no broker reconnection request followed the connection loss")
+	}
+}
+
+func setBackoffPolicyField(t *testing.T, opts interface{}, policy internal.BackoffPolicy) {
+	t.Helper()
+	field := reflect.ValueOf(opts).Elem().FieldByName("BackoffPolicy")
+	if !field.IsValid() || !field.CanSet() {
+		t.Fatalf("%T does not expose a writable BackoffPolicy field", opts)
+	}
+	field.Set(reflect.ValueOf(policy))
+}
