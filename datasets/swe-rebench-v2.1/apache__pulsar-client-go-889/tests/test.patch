+// recordingBackoffPolicy records when a reconnection delay is requested.
+type recordingBackoffPolicy struct {
+	delay time.Duration
+	calls chan time.Time
+}
+
+func (b *recordingBackoffPolicy) Next() time.Duration {
+	b.calls <- time.Now()
+	return b.delay
+}
+
+// fakeLookupService resolves every topic to a fixed address without contacting
+// a real broker.
+type fakeLookupService struct{}
+
+func (f *fakeLookupService) Lookup(topic string) (*internal.LookupResult, error) {
+	u, _ := url.Parse("pulsar://localhost:6650")
+	return &internal.LookupResult{LogicalAddr: u, PhysicalAddr: u}, nil
+}
+
+func (f *fakeLookupService) GetPartitionedTopicMetadata(topic string) (*internal.PartitionedTopicMetadata, error) {
+	return &internal.PartitionedTopicMetadata{Partitions: 0}, nil
+}
+
+func (f *fakeLookupService) GetTopicsOfNamespace(namespace string, mode internal.GetTopicsOfNamespaceMode) ([]string, error) {
+	return nil, nil
+}
+
+func (f *fakeLookupService) GetSchema(topic string, schemaVersion []byte) (*pb.Schema, error) {
+	return nil, nil
+}
+
+func (f *fakeLookupService) Close() {}
