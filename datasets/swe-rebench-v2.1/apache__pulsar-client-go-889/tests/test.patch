+// minimalBackoffPolicy implements only the Next method of the public
+// BackoffPolicy contract.
+type minimalBackoffPolicy struct {
+delay time.Duration
+}
+
+func (m minimalBackoffPolicy) Next() time.Duration {
+return m.delay
+}
+
+func TestBackoffPolicyContractIsNextDelay(t *testing.T) {
+var policy internal.BackoffPolicy = minimalBackoffPolicy{delay: 250 * time.Millisecond}
+assert.Equal(t, 250*time.Millisecond, policy.Next())
+}
