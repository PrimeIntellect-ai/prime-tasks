+def test_time_parsing_with_offset(value, expected):
+    # A time string carrying a UTC offset may either be rejected as unsupported
+    # or parsed with its timezone preserved; silently discarding the offset is not allowed.
+    try:
+        result = parse_time(value)
+    except errors.TimeError:
+        return
+    assert result == expected
