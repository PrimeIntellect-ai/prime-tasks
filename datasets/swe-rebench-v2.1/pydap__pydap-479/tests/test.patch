 from pydap.handlers.netcdf import NetCDFHandler
 
 
+def _local_dim_names(dims):
+    """Return the local (unqualified) name of each dimension identifier.
+
+    The DMR data model permits dimension identifiers to be either
+    semi-fully-qualified (e.g. ``["/time", "Y", "X"]``) or fully-qualified
+    (e.g. ``["/time", "/Group/Y", "/Group/X"]``).  Comparing the local names
+    keeps the test agnostic to that choice while still verifying the
+    dimension identity and ordering.
+    """
+    return [dim.split("/")[-1] for dim in dims]
+
+
