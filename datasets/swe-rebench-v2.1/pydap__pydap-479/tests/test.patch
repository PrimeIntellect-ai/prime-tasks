+@pytest.fixture(scope="module")
+def global_attr_file(tmpdir_factory):
+    file_name = str(tmpdir_factory.mktemp("nc").join("global_attr.nc"))
+    with Dataset(file_name, "w") as output:
+        output.createDimension("index", 3)
+        output.createVariable("index", "<i4", ("index",))
+        output.description = "A simple group for testing."
+        output.title = "Test dataset"
+    return file_name
+
+
+def test_handler_attributes_flat(global_attr_file):
+    """Global attributes are exposed flat, without an ``NC_GLOBAL`` container."""
+    dataset = NetCDFHandler(global_attr_file).dataset
+    assert "NC_GLOBAL" not in dataset.attributes
+    assert dataset.attributes["description"] == "A simple group for testing."
+    assert dataset.attributes["title"] == "Test dataset"
+
+
+def test_handler_dimensions_is_plain_dict(simple_handler2):
+    """Dataset dimensions are exposed as a dictionary mapping."""
+    dataset = simple_handler2.dataset
+    assert isinstance(dataset.dimensions, dict)
+    assert dataset.dimensions == {"time": 1, "nv": 2}
+
+
+def test_handler_dims_is_list(simple_group_array_file):
+    """Array dimension identifiers are exposed as a list."""
+    dataset = NetCDFHandler(simple_group_array_file).dataset
+    temp = dataset["/Group/temperature"]
+    assert isinstance(temp.dims, list)
+    assert _local_dim_names(temp.dims) == ["time", "Y", "X"]
