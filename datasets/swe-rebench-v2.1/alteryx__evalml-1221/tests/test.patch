+def _search_with_explicit_splitter(problem_type, X, y, max_iterations=2):
+    automl = AutoMLSearch(
+        problem_type=problem_type,
+        max_iterations=max_iterations,
+        data_split=StratifiedKFold(n_splits=3, shuffle=True, random_state=0),
+    )
+    # The search always builds its default splitter from its random state, which the
+    # installed scikit-learn rejects for an unshuffled splitter; clear it so the search runs.
+    automl.random_state = None
+    # The iteration plot needs an optional widget backend that is not installed here;
+    # it is unrelated to the scores under test, so it is stubbed out.
+    with patch('evalml.automl.pipeline_search_plots.PipelineSearchPlots.search_iteration_plot'):
+        automl.search(X, y, data_checks='disabled', show_iteration_plot=False)
+    return automl
+
+
+def test_validation_score_is_first_cv_fold_score(X_y_binary):
+    X, y = X_y_binary
+    automl = _search_with_explicit_splitter('binary', X, y)
+
+    first_fold_scores = {}
+    for pipeline_id, results in automl.results['pipeline_results'].items():
+        assert results['validation_score'] == results['cv_data'][0]['score']
+        first_fold_scores[pipeline_id] = results['cv_data'][0]['score']
+
+    expected_ranking_columns = ['id', 'pipeline_name', 'score', 'validation_score',
+                                'percent_better_than_baseline', 'high_variance_cv', 'parameters']
+    for rankings in (automl.rankings, automl.full_rankings):
+        assert list(rankings.columns) == expected_ranking_columns
+        assert len(rankings) > 0
+        for row in rankings.itertuples(index=False):
+            assert row.validation_score == first_fold_scores[row.id]
+
+
+@patch('evalml.pipelines.BinaryClassificationPipeline.score')
+def test_validation_score_reuses_first_cv_fold_score(mock_score, X_y_binary):
+    X, y = X_y_binary
+    # Every score computation returns a distinct value, so a validation score that
+    # is recomputed instead of reused cannot match the first fold's score by accident.
+    mock_score.side_effect = [
+        {'Log Loss Binary': float(index)} for index in range(1000)
+    ]
+    automl = _search_with_explicit_splitter('binary', X, y)
+
+    first_fold_scores = {}
+    for pipeline_id, results in automl.results['pipeline_results'].items():
+        assert results['validation_score'] == results['cv_data'][0]['score']
+        first_fold_scores[pipeline_id] = results['cv_data'][0]['score']
+    for rankings in (automl.rankings, automl.full_rankings):
+        for row in rankings.itertuples(index=False):
+            assert row.validation_score == first_fold_scores[row.id]
 
 
