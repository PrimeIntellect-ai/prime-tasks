+describe('Given a map instance', function () {
+
+  it('should expose filterFeature and return features matching the supplied dimension and value', function () {
+    var data = [{NAME: 'Gert'}, {NAME: 'Peter', age: 23}, {NAME: 'Peter', age: 35}, {NAME: 'Max'}];
+    var map = new GMP({async: false, id: 'mymap', lat: 41.3833, lng: 2.1833});
+
+    expect(map.filterFeature).to.be.a('function');
+
+    var cf = crossfilter(data);
+    map.json.filter = {NAME: cf.dimension(function(d) {return d.NAME;})};
+
+    var result = map.filterFeature({NAME: 'Peter'});
+    expect(result).to.have.deep.members([data[1], data[2]]);
+  });
+
+});
