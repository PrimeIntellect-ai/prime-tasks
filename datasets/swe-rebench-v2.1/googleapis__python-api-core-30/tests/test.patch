+def test_stream_reopening_does_not_reenter_request_generator():
+    import threading
+
+    request_started = threading.Event()
+    allow_request_to_finish = threading.Event()
+    request_results = []
+
+    def requests():
+        request_started.set()
+        allow_request_to_finish.wait()
+        yield "request"
+
+    request_iterator = requests()
+
+    def consume_request():
+        request_results.append(next(request_iterator))
+
+    request_thread = threading.Thread(target=consume_request)
+    request_thread.start()
+
+    class ResponseStream:
+        def __iter__(self):
+            return self
+
+        def __next__(self):
+            # Reopening a bidirectional stream can race with request consumption.
+            return next(request_iterator)
+
+    class StreamingRpc(grpc.StreamStreamMultiCallable):
+        def __call__(self, _requests):
+            return ResponseStream()
+
+    # The transport may disable eager response consumption for bidirectional
+    # streaming, so opening/reopening the response stream must not re-enter the
+    # request generator while another consumer is advancing it.
+    streaming_rpc = StreamingRpc()
+    streaming_rpc._prefetch_first_result_ = False
+    wrapped_rpc = grpc_helpers.wrap_errors(streaming_rpc)
+    try:
+        assert request_started.wait(timeout=5)
+        wrapped_rpc(request_iterator)
+        wrapped_rpc(request_iterator)
+    finally:
+        allow_request_to_finish.set()
+        request_thread.join(timeout=2)
+
+    assert not request_thread.is_alive()
+    assert request_results == ["request"]
+
+
 def test_wrap_stream_iterable_iterface():
