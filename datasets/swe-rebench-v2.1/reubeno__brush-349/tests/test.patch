+#[cfg(test)]
+mod non_extended_test_comparison_tests {
+    use crate::{CreateOptions, Shell};
+
+    #[tokio::test]
+    async fn bracket_test_equals_compares_pattern_syntax_literally() -> anyhow::Result<()> {
+        let options = CreateOptions::default();
+        let mut shell = Shell::new(&options).await?;
+        let result = shell
+            .run_string(
+                r#"[ "foo" = "fo?" ]"#.to_owned(),
+                &shell.default_exec_params(),
+            )
+            .await?;
+
+        assert_eq!(result.exit_code, 1);
+        Ok(())
+    }
