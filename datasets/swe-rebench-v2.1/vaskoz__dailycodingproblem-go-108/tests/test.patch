+package day49
+
+import (
+	"testing"
+	"time"
+)
+
+var testcases = []struct {
+	arr    []int
+	maxSum int
+}{
+	{[]int{34, -50, 42, 14, -5, 86}, 137},
+	{[]int{-5, -1, -8, -9}, 0},
+}
+
+func TestMaxSubArray(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		if result := MaxSubArray(tc.arr); result != tc.maxSum {
+			t.Errorf("Expected %d got %d", tc.maxSum, result)
+		}
+	}
+}
+
+// TestMaxSubArrayLinearTime exercises the O(N) time requirement on a large
+// input. A quadratic implementation would take far longer than the generous
+// bound below, while a linear implementation completes almost instantly.
+func TestMaxSubArrayLinearTime(t *testing.T) {
+	const n = 200000
+	arr := make([]int, n)
+	for i := range arr {
+		arr[i] = 1
+	}
+
+	start := time.Now()
+	result := MaxSubArray(arr)
+	elapsed := time.Since(start)
+
+	if result != n {
+		t.Fatalf("Expected %d got %d", n, result)
+	}
+	if elapsed > 3*time.Second {
+		t.Fatalf("MaxSubArray took %v for %d elements; expected O(N) time", elapsed, n)
+	}
+}
+
+func BenchmarkMaxSubArray(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			MaxSubArray(tc.arr)
+		}
+	}
+}
