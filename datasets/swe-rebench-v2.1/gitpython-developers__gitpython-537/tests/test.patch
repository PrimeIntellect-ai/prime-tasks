+    @with_rw_directory
+    def test_explicit_repo_path_takes_precedence_over_git_dir(self, rwdir):
+        requested_path = osp.join(rwdir, 'requested')
+        environment_path = osp.join(rwdir, 'environment')
+        git.Repo.init(requested_path)
+        other = git.Repo.init(environment_path)
+        old_git_dir = os.environ.get('GIT_DIR')
+        try:
+            os.environ['GIT_DIR'] = other.git_dir
+            repo = git.Repo(requested_path)
+            assert osp.samefile(repo.working_tree_dir, requested_path)
+            repo.git.status()
+        finally:
+            if old_git_dir is None:
+                os.environ.pop('GIT_DIR', None)
+            else:
+                os.environ['GIT_DIR'] = old_git_dir
+
