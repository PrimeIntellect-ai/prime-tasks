+func (s *APISuite) TestValidateConfigReportsUnknownParameter() {
+	s.T().Run("unknown_spec_key", func(t *testing.T) {
+		output := s.validateConfigOutput(`
+apiVersion: k0s.k0sproject.io/v1beta1
+kind: Cluster
+metadata:
+  name: foobar
+spec:
+  api:
+    address: 1.2.3.4
+    addressWRONG: 172.x.x.x
+`)
+		s.Contains(output, "addressWRONG")
+	})
+
+	s.T().Run("unknown_nested_key", func(t *testing.T) {
+		output := s.validateConfigOutput(`
+apiVersion: k0s.k0sproject.io/v1beta1
+kind: Cluster
+metadata:
+  name: foobar
+spec:
+  installConfig:
+    users:
+      etcdUserWRONG: etcd
+`)
+		s.Contains(output, "etcdUserWRONG")
+	})
+}
