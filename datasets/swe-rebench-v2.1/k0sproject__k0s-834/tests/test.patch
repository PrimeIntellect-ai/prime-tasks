+func (s *APISuite) TestControllerRejectsInvalidConfigBeforeStartup() {
+	tempDir := s.T().TempDir()
+	configPath := filepath.Join(tempDir, "k0s.yaml")
+	dataDir := filepath.Join(tempDir, "data")
+	yamlData := `
+apiVersion: k0s.k0sproject.io/v1beta1
+kind: Cluster
+metadata:
+  name: foobar
+spec:
+  api:
+    address: 172.WRONG.x.x
+`
+	s.Require().NoError(os.WriteFile(configPath, []byte(yamlData), 0600))
+
+	rootDir, err := filepath.Abs("../../../")
+	s.Require().NoError(err)
+	assetSourcePath := filepath.Join(rootDir, "pkg", "assets", "stage.go")
+	assetSource, err := os.ReadFile(assetSourcePath)
+	s.Require().NoError(err)
+	assetSource = append(assetSource, []byte("\nvar BinData = map[string]struct{ offset, size int64 }{}\nvar BinDataSize int64\n")...)
+	assetOverlayPath := filepath.Join(tempDir, "stage.go")
+	s.Require().NoError(os.WriteFile(assetOverlayPath, assetSource, 0600))
+	overlay, err := json.Marshal(struct {
+		Replace map[string]string
+	}{Replace: map[string]string{
+		assetSourcePath: assetOverlayPath,
+	}})
+	s.Require().NoError(err)
+	overlayPath := filepath.Join(tempDir, "overlay.json")
+	s.Require().NoError(os.WriteFile(overlayPath, overlay, 0600))
+
+	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
+	defer cancel()
+	command := exec.CommandContext(ctx, "go", "run", "-overlay", overlayPath, ".", "controller", "--config", configPath, "--data-dir", dataDir)
+	command.Dir = rootDir
+	output, err := command.CombinedOutput()
+
+	s.Error(err)
+	s.Contains(string(output), "spec.api.address")
+}
+
+// validateConfigOutput runs `k0s validate config` on the given YAML and returns its combined output.
+func (s *APISuite) validateConfigOutput(yamlData string) string {
+	tempDir := s.T().TempDir()
+	configPath := filepath.Join(tempDir, "k0s.yaml")
+	s.Require().NoError(os.WriteFile(configPath, []byte(yamlData), 0600))
+
+	rootDir, err := filepath.Abs("../../../")
+	s.Require().NoError(err)
+	assetSourcePath := filepath.Join(rootDir, "pkg", "assets", "stage.go")
+	assetSource, err := os.ReadFile(assetSourcePath)
+	s.Require().NoError(err)
+	assetSource = append(assetSource, []byte("\nvar BinData = map[string]struct{ offset, size int64 }{}\nvar BinDataSize int64\n")...)
+	assetOverlayPath := filepath.Join(tempDir, "stage.go")
+	s.Require().NoError(os.WriteFile(assetOverlayPath, assetSource, 0600))
+	overlay, err := json.Marshal(struct {
+		Replace map[string]string
+	}{Replace: map[string]string{
+		assetSourcePath: assetOverlayPath,
+	}})
+	s.Require().NoError(err)
+	overlayPath := filepath.Join(tempDir, "overlay.json")
+	s.Require().NoError(os.WriteFile(overlayPath, overlay, 0600))
+
+	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
+	defer cancel()
+	command := exec.CommandContext(ctx, "go", "run", "-overlay", overlayPath, ".", "validate", "config", "--config", configPath)
+	command.Dir = rootDir
+	output, _ := command.CombinedOutput()
+	return string(output)
+}
