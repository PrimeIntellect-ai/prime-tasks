+
+def test_less_than_plain_numbers():
+    assert Constant(1.0) < 2.0
+    assert 1.0 < Constant(2.0)
+    assert not Constant(2.0) < 1.0
+    assert not 2.0 < Constant(1.0)
+
+
+def test_sort_mixed_constants_and_floats():
+    values = [Constant(3.0), 1.0, Constant(2.0)]
+
+    result = sorted(values)
+
+    assert result == [1.0, 2.0, 3.0]
