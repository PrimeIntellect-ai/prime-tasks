+func TestServiceExternalNameDoesNotFailTargetsPod(t *testing.T) {
+	file, err := os.Open("testdata/service-externalname.yaml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+
+	sc, err := Score(Configuration{AllFiles: []io.Reader{file}})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	for _, objectScores := range sc.Scores {
+		for _, result := range objectScores {
+			if result.Name == "Service Targets Pod" && result.Grade == scorecard.GradeCritical {
+				t.Fatalf("ExternalName Service failed Service Targets Pod: %v", result.Comments)
+			}
+		}
+	}
