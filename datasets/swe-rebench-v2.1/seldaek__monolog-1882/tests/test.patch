+        $this->assertTrue(stream_wrapper_register('monologretry', StreamHandlerTestWriteFailureStream::class));
+        StreamHandlerTestWriteFailureStream::$contents = '';
+        StreamHandlerTestWriteFailureStream::$failuresRemaining = 0;
