+/** A stream that can fail a chosen number of writes before accepting data. */
+class StreamHandlerTestWriteFailureStream
+{
+    public $context;
+    public static $contents = '';
+    public static $failuresRemaining = 0;
+    public static $alwaysFail = false;
+
+    public function stream_open($path, $mode, $options, &$openedPath): bool
+    {
+        return true;
+    }
+
+    public function stream_write(string $data): int
+    {
+        if (self::$alwaysFail || self::$failuresRemaining > 0) {
+            --self::$failuresRemaining;
+            trigger_error('temporary stream write failure', E_USER_WARNING);
+
+            return 0;
+        }
+
+        self::$contents .= $data;
+
+        return strlen($data);
+    }
+
+    public function stream_set_option(int $option, int $arg1, int $arg2): bool
+    {
+        return true;
+    }
+
+    public function stream_stat(): array
+    {
+        return [];
+    }
+}
