+            $handler = new StreamHandler('monologretry://log');
+            $handler->setFormatter($this->getIdentityFormatter());
+
+            $failureWasReported = false;
+            set_error_handler(function () use (&$failureWasReported) {
+                $failureWasReported = true;
+
+                return true;
+            });
+            try {
+                $handler->handle($this->getRecord(Logger::WARNING, 'unwritten record'));
+            } catch (\Throwable $failure) {
+                $failureWasReported = true;
+            } finally {
+                restore_error_handler();
+            }
+
+            self::assertTrue($failureWasReported, 'A record that cannot be written must not be reported as successfully logged.');
+            self::assertSame('', StreamHandlerTestWriteFailureStream::$contents);
+        } finally {
+            stream_wrapper_unregister('monologretry');
+        }
+    }
