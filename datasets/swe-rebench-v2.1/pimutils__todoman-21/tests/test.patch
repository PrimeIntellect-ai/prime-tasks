+def test_dtstamp(tmpdir, runner, create):
+    """
+    A newly created todo's calendar data includes the required DTSTAMP.
+    """
+    result = runner.invoke(cli, ['new', '-l', 'default', 'test event'])
+    assert not result.exception
+
+    calendar_file = next((Path(str(tmpdir)) / 'default').glob('*.ics'))
+    calendar = Calendar.from_ical(calendar_file.read_bytes())
+    todo = calendar.walk('VTODO')[0]
+    assert todo.get('DTSTAMP') is not None
