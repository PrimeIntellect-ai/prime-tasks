diff --git a/test/nn/conv/test_message_passing.py b/test/nn/conv/test_message_passing.py
index 76ff02dc..b583854b 100644
--- a/test/nn/conv/test_message_passing.py
+++ b/test/nn/conv/test_message_passing.py
@@ -740,3 +740,57 @@ def test_pickle(tmp_path):
 
     model = torch.load(path)
     torch.jit.script(model)
+
+
+class MyOptionalEdgeAttrConv(MessagePassing):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x, edge_index, edge_attr=None):
+        # The optional `edge_attr` argument is intentionally omitted from the
+        # `propagate` call, matching the reported reproduction.
+        return self.propagate(edge_index, x=x)
+
+    def message(self, x_j, edge_attr=None):
+        # `edge_attr` is optional and defaults to `None`; it must be usable
+        # even though it was never passed to `propagate`.
+        assert edge_attr is None
+        return x_j
+
+
+def test_my_optional_edge_attr_conv():
+    conv = MyOptionalEdgeAttrConv()
+
+    x = torch.randn(4, 8)
+    edge_index = torch.tensor([[0, 1, 2, 3], [0, 0, 1, 1]])
+
+    # `edge_attr` is not passed to `propagate` at all, even though `message`
+    # declares it as an optional argument with a default value of `None`.
+    out = conv(x, edge_index)
+    assert out.size() == (4, 8)
+
+
+class MyExplicitOptionalEdgeAttrConv(MessagePassing):
+    def __init__(self):
+        super().__init__()
+
+    def forward(self, x, edge_index, edge_attr=None):
+        return self.propagate(edge_index, x=x, edge_attr=edge_attr)
+
+    def message(self, x_j, edge_attr=None):
+        return x_j if edge_attr is None else x_j * edge_attr.view(-1, 1)
+
+
+def test_my_explicit_optional_edge_attr_conv():
+    conv = MyExplicitOptionalEdgeAttrConv()
+
+    x = torch.randn(4, 8)
+    edge_index = torch.tensor([[0, 1, 2, 3], [0, 0, 1, 1]])
+
+    # Passing `edge_attr` explicitly (including as `None`) must also work.
+    out = conv(x, edge_index)
+    assert out.size() == (4, 8)
+
+    edge_attr = torch.randn(edge_index.size(1), 1)
+    out = conv(x, edge_index, edge_attr=edge_attr)
+    assert out.size() == (4, 8)
