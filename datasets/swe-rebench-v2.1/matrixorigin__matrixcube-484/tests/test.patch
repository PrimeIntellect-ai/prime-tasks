+func TestDoExecCompactLogDoesNotCompactWhenPersistentLogIndexFails(t *testing.T) {
+	s := NewSingleTestClusterStore(t).GetStore(0).(*store)
+	pr := newTestReplica(Shard{ID: 1, Epoch: Epoch{Version: 2}, Replicas: []Replica{{ID: 2}}}, Replica{ID: 2}, s)
+	err := pr.sm.logdb.SaveRaftState(pr.shardID, pr.replicaID, raft.Ready{
+		Entries: []raftpb.Entry{
+			{Index: 1, Term: 1},
+			{Index: 2, Term: 1},
+			{Index: 3, Term: 1},
+			{Index: 4, Term: 1},
+			{Index: 5, Term: 1},
+		},
+		HardState: raftpb.HardState{Commit: 5, Term: 1},
+	}, pr.sm.logdb.NewWorkerContext())
+	require.NoError(t, err)
+
+	pr.sm.dataStorage = &testDataStorage{
+		persistentLogIndex:        2,
+		persistentLogIndexErr:     errors.New("persistent log index unavailable"),
+		persistentLogIndexShardID: pr.shardID,
+	}
+	batch := newTestAdminRequestBatch("", 0, rpc.AdminCmdType_CompactLog, protoc.MustMarshal(&rpc.CompactLogRequest{
+		CompactIndex: 4,
+	}))
+	batch.Header.ShardID = pr.shardID
+	handler := &testReplicaResultHandler{}
+	pr.sm.resultHandler = handler
+	pr.lr.SetRange(0, 100)
+	pr.sm.applyCommittedEntries([]raftpb.Entry{{
+		Index: 1,
+		Term:  1,
+		Data:  protoc.MustMarshal(&batch),
+	}})
+	assert.NotEmpty(t, handler.resp.Header.Error.Message)
 }
