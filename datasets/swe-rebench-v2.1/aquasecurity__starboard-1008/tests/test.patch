+func TestPackagedOperatorDefaultsUseNewerTrivyImage(t *testing.T) {
+	defaults := []struct {
+		file string
+		key  string
+	}{
+		{file: filepath.Join("..", "..", "..", "deploy", "helm", "values.yaml"), key: "imageRef:"},
+		{file: filepath.Join("..", "..", "..", "deploy", "static", "03-starboard-operator.config.yaml"), key: "trivy.imageRef:"},
+		{file: filepath.Join("..", "..", "..", "deploy", "static", "starboard.yaml"), key: "trivy.imageRef:"},
+	}
+
+	for _, item := range defaults {
+		t.Run(item.file, func(t *testing.T) {
+			content, err := os.ReadFile(item.file)
+			require.NoError(t, err)
+			var imageRef string
+			for _, line := range strings.Split(string(content), "\n") {
+				trimmed := strings.TrimSpace(line)
+				if strings.HasPrefix(trimmed, item.key) {
+					imageRef = strings.Trim(strings.TrimSpace(strings.TrimPrefix(trimmed, item.key)), "\"'")
+					break
+				}
+			}
+			require.NotEmpty(t, imageRef, "operator default image reference should be present in %s", item.file)
+			assertTrivyImageVersionGreaterThan024(t, imageRef)
+		})
+	}
+}
+
+func assertTrivyImageVersionGreaterThan024(t *testing.T, imageRef string) {
+	t.Helper()
+	tagStart := strings.LastIndex(imageRef, ":")
+	require.NotEqual(t, -1, tagStart, "image reference should include a version tag")
+	imageVersion, err := version.NewVersion(imageRef[tagStart+1:])
+	require.NoError(t, err, "image reference should have a parseable version tag")
+	minimum, err := version.NewVersion("0.24")
+	require.NoError(t, err)
+	assert.True(t, imageVersion.GreaterThan(minimum), "Trivy version %s must be greater than 0.24", imageVersion)
+}
