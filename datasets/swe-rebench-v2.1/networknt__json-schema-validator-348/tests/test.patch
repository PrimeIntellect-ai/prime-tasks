+package com.networknt.schema;
+
+import org.junit.Test;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.fail;
+
+public class Issue347Test {
+
+    @Test
+    public void failure() {
+        JsonSchemaFactory factory = JsonSchemaFactory.getInstance(SpecVersion.VersionFlag.V7);
+        try {
+            factory.getSchema(Thread.currentThread().getContextClassLoader().getResourceAsStream("schema/issue347-v7.json"));
+            fail("Expected a JsonSchemaException to be thrown for an $id without a scheme");
+        } catch (JsonSchemaException e) {
+            assertEquals("test: null is an invalid segment for URI {2}", e.getMessage());
+        }
+    }
+}
