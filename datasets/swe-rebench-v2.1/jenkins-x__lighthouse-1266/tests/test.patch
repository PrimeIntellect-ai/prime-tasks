+
+func TestJobSpecsPreserveAllPipelineRunParams(t *testing.T) {
+	params := []job.PipelineRunParam{
+		{Name: "FIRST_PARAM", ValueTemplate: "first-value"},
+		{Name: "SECOND_PARAM", ValueTemplate: "second-value"},
+	}
+	tests := []struct {
+		name string
+		spec func() v1alpha1.LighthouseJobSpec
+	}{
+		{
+			name: "presubmit",
+			spec: func() v1alpha1.LighthouseJobSpec {
+				return PresubmitSpec(job.Presubmit{Base: job.Base{PipelineRunParams: params}}, v1alpha1.Refs{})
+			},
+		},
+		{
+			name: "postsubmit",
+			spec: func() v1alpha1.LighthouseJobSpec {
+				return PostsubmitSpec(job.Postsubmit{Base: job.Base{PipelineRunParams: params}}, v1alpha1.Refs{})
+			},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			actual := tc.spec().PipelineRunParams
+			remaining := append([]job.PipelineRunParam(nil), actual...)
+			for _, configured := range params {
+				found := -1
+				for i, got := range remaining {
+					if reflect.DeepEqual(got, configured) {
+						found = i
+						break
+					}
+				}
+				if found == -1 {
+					t.Errorf("configured parameter %#v is missing from generated job spec %#v", configured, actual)
+					continue
+				}
+				remaining = append(remaining[:found], remaining[found+1:]...)
+			}
+		})
+	}
+}
