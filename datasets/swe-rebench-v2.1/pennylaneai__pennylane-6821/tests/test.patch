+    @pytest.mark.parametrize("basis_set", [[], (), {}])
+    def test_compile_empty_basis_set(self, basis_set):
+        """Test that compiling with an empty basis set decomposes any decomposable operation."""
+        ops = (
+            qml.RX(0.1, 0),
+            qml.H(1),
+            qml.Barrier([0, 1]),
+            qml.CNOT([1, 0]),
+            qml.PauliY(0),
+            qml.CY([0, 1]),
+        )
+        tape = qml.tape.QuantumScript(ops)
+        [transformed_tape], _ = qml.compile(tape, basis_set=basis_set)
+
+        # Decomposition continues recursively until no operation can be decomposed.
+        assert all(not op.has_decomposition for op in transformed_tape.operations)
+
+        # The compiled circuit must be equivalent to the original circuit.
+        dev = qml.device("default.qubit", wires=[0, 1])
+        original_result = qml.execute([tape], dev, None)[0]
+        compiled_result = qml.execute([transformed_tape], dev, None)[0]
+        assert np.allclose(original_result, compiled_result)
+
+    def test_compile_empty_basis_set_preserves_non_decomposable_operation(self):
+        """An operation without a decomposition remains in the expanded tape."""
+        class OpaqueOperation(qml.operation.Operation):
+            num_wires = 1
+            num_params = 0
+
+        tape = qml.tape.QuantumScript([OpaqueOperation(wires=0)])
+
+        [transformed_tape], _ = qml.compile(tape, basis_set=[], pipeline=[])
+
+        assert transformed_tape.operations == tape.operations
+
