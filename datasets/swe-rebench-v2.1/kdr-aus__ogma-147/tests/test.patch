+#[test]
+fn last_testing_bug_116() {
+    let defs = &Definitions::new();
+
+    let x = process_w_nil(
+        r#"ls | grp name | fold 0 { \$row | get value | last get:Num size }"#,
+        defs,
+    );
+    match x {
+        Ok(Value::Num(_)) => {}
+        Err(err) => {
+            let message = err.to_string();
+            assert!(message.contains("Table"), "error should mention `Table`: {message}");
+            assert!(message.contains("String"), "error should mention `String`: {message}");
+        }
+        other => panic!("expected a numeric result or a type-inference diagnostic, got {other:?}"),
+    }
+}
+
+#[test]
+fn last_type_inference_error_suggests_types() {
+    let defs = &Definitions::new();
+
+    // `last` is defined for string and table inputs. When another input type
+    // conflicts, the diagnostic must name both supported public types.
+    let err = process_w_num("last", defs).unwrap_err().to_string();
+    assert!(err.contains("Table"), "error should suggest `Table`: {err}");
+    assert!(
+        err.contains("String"),
+        "error should name the public string type `String`: {err}"
+    );
+}
