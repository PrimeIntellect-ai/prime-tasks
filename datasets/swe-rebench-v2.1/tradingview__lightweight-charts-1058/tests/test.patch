index 0000000..8603ba7
--- /dev/null
+++ b/tests/unittests/get-series-data-creator.spec.ts
@@ -0,0 +1,199 @@
+import { expect } from 'chai';
+import { after, beforeEach, describe, it } from 'mocha';
+
+import type { LineData } from '../../src/api/data-consumer';
+import type { IChartApi, MouseEventParams } from '../../src/api/ichart-api';
+import type { ISeriesApi } from '../../src/api/iseries-api';
+import type { Logical, Time } from '../../src/model/time-data';
+
+// `fancy-canvas` is shipped as an ES module only, so it cannot be `require`d
+// from the CommonJS unit-test environment. Stub it out so the chart can be
+// created in Node.
+declare const require: any;
+const fancyCanvasPath = require.resolve('fancy-canvas/coordinate-space');
+require.cache[fancyCanvasPath] = {
+	exports: {
+		bindToDevicePixelRatio: (canvas: unknown): unknown => new Proxy({ canvas } as Record<string, unknown>, {
+			get(target: Record<string, unknown>, prop: string | symbol): unknown {
+				if (prop in target) {
+					return target[prop as string];
+				}
+				if (typeof prop === 'symbol' || prop === 'then') {
+					return undefined;
+				}
+				return (): { width: number; height: number } => ({ width: 0, height: 0 });
+			},
+		}),
+		Binding: class {},
+	},
+};
+
+// A minimal in-memory DOM: enough for a chart to be created and for pointer
+// events to be dispatched to the element listeners it registers.
+interface Listener {
+	type: string;
+	handler: (event: unknown) => void;
+}
+
+const registeredListeners: Listener[] = [];
+
+function createElementStub(): unknown {
+	const cache: Record<string, unknown> = {};
+	return new Proxy(function stub(): void {}, {
+		get(_target: unknown, prop: string | symbol): unknown {
+			if (typeof prop === 'symbol' || prop === 'then') {
+				return undefined;
+			}
+			if (prop in cache) {
+				return cache[prop];
+			}
+			let value: unknown;
+			switch (prop) {
+				case 'getBoundingClientRect':
+					value = (): object => ({ left: 0, top: 0, width: 600, height: 400, right: 600, bottom: 400 });
+					break;
+				case 'addEventListener':
+					value = (type: string, handler: (event: unknown) => void): void => {
+						registeredListeners.push({ type, handler });
+					};
+					break;
+				case 'classList':
+					value = { add(): void {}, remove(): void {}, contains(): boolean { return false; }, toggle(): void {} };
+					break;
+				case 'style':
+					value = {};
+					break;
+				case 'clientWidth':
+				case 'offsetWidth':
+					value = 600;
+					break;
+				case 'clientHeight':
+				case 'offsetHeight':
+					value = 400;
+					break;
+				case 'measureText':
+					value = (): object => ({ width: 10, actualBoundingBoxAscent: 5, actualBoundingBoxDescent: 2, fontBoundingBoxAscent: 5, fontBoundingBoxDescent: 2, actualBoundingBoxLeft: 0, actualBoundingBoxRight: 10 });
+					break;
+				case 'ownerDocument':
+					value = (globalThis as Record<string, unknown>).document;
+					break;
+				default:
+					value = (): unknown => createElementStub();
+			}
+			cache[prop] = value;
+			return value;
+		},
+		set(_target: unknown, prop: string | symbol, value: unknown): boolean {
+			cache[prop as string] = value;
+			return true;
+		},
+	});
+}
+
+// The globals are defined as non-enumerable and removed again after this suite,
+// so they do not leak into the other unit tests.
+function defineGlobal(name: string, value: unknown): void {
+	Object.defineProperty(globalThis, name, { value, configurable: true, enumerable: false, writable: true });
+}
+
+const stubWindow = {
+	navigator: { userAgent: 'node', maxTouchPoints: 0, platform: '' },
+	devicePixelRatio: 1,
+	requestAnimationFrame: (): number => 0,
+	cancelAnimationFrame(): void {},
+	addEventListener(): void {},
+	removeEventListener(): void {},
+};
+
+const stubDocument = {
+	createElement: (): unknown => createElementStub(),
+	body: createElementStub(),
+	documentElement: createElementStub(),
+	activeElement: null,
+	addEventListener(): void {},
+	removeEventListener(): void {},
+	getSelection: (): null => null,
+};
+
+defineGlobal('navigator', stubWindow.navigator);
+defineGlobal('window', stubWindow);
+defineGlobal('document', stubDocument);
+defineGlobal('requestAnimationFrame', stubWindow.requestAnimationFrame);
+defineGlobal('cancelAnimationFrame', stubWindow.cancelAnimationFrame);
+
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const { createChart } = require('../../src/api/create-chart');
+
+// Dispatches the pointer events a user produces when hovering the chart at the given coordinates.
+function hoverChartAt(x: number, y: number): void {
+	const event = {
+		clientX: x,
+		clientY: y,
+		offsetX: x,
+		offsetY: y,
+		pageX: x,
+		pageY: y,
+		screenX: x,
+		screenY: y,
+		buttons: 0,
+		button: 0,
+		ctrlKey: false,
+		altKey: false,
+		shiftKey: false,
+		metaKey: false,
+		timeStamp: 1,
+		sourceCapabilities: { firesTouchEvents: false },
+		preventDefault(): void {},
+		stopPropagation(): void {},
+	};
+
+	for (const type of ['mouseenter', 'mousemove']) {
+		registeredListeners
+			.filter((listener: Listener) => listener.type === type)
+			.forEach((listener: Listener) => listener.handler({ ...event, type }));
+	}
+}
+
+describe('MouseEventParams.seriesData for a Line series', () => {
+	beforeEach(() => {
+		registeredListeners.length = 0;
+	});
+
+	after(() => {
+		const globals = globalThis as Record<string, unknown>;
+		delete globals.navigator;
+		delete globals.window;
+		delete globals.document;
+		delete globals.requestAnimationFrame;
+		delete globals.cancelAnimationFrame;
+	});
+
+	it('should include the color of LineData in seriesData when the mouse moves over the point', () => {
+		const container = createElementStub() as HTMLElement;
+		const chart: IChartApi = createChart(container, { width: 600, height: 400 });
+		const lineSeries: ISeriesApi<'Line'> = chart.addLineSeries();
+
+		const data: LineData[] = [
+			{ time: 1649931070 as Time, value: 1, color: '#FF0000' },
+			{ time: 1649931130 as Time, value: 2 },
+		];
+		lineSeries.setData(data);
+		chart.timeScale().setVisibleLogicalRange({ from: 0, to: 4 });
+
+		const received: MouseEventParams[] = [];
+		chart.subscribeCrosshairMove((param: MouseEventParams) => received.push(param));
+
+		const x = chart.timeScale().logicalToCoordinate(0 as Logical);
+		expect(x).to.not.equal(null);
+		hoverChartAt(x as number, 200);
+
+		const param = received[received.length - 1];
+		expect(param).to.not.equal(undefined);
+
+		const seriesData = param.seriesData.get(lineSeries) as LineData | undefined;
+		expect(seriesData).to.not.equal(undefined);
+		expect(seriesData?.time).to.equal(1649931070);
+		expect(seriesData?.value).to.equal(1);
+		expect(seriesData?.color).to.equal('#FF0000');
+	});
+});
