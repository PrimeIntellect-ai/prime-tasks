+    def test_add_periodic_task_explicit_names_allow_same_signature(self):
+
+        @self.app.task
+        def add(x, y):
+            pass
+        sig = add.s(2, 2)
+        self.app.conf.beat_schedule['existing'] = {'task': 'existing.task'}
+        self.app.add_periodic_task(10, sig, name='first', expires=3)
+        self.app.add_periodic_task(20, sig, name='second', expires=3)
+        assert 'first' in self.app.conf.beat_schedule
+        assert 'second' in self.app.conf.beat_schedule
+        assert 'existing' in self.app.conf.beat_schedule
+
+    def test_add_periodic_task_unexpected_override(self, caplog):
+
+        @self.app.task
+        def add(x, y):
+            pass
+        sig = add.s(2, 2)
+        self.app.add_periodic_task(10, sig, expires=3)
+
+        collision_reported = False
+        try:
+            self.app.add_periodic_task(20, sig, expires=3)
+        except Exception:
+            collision_reported = True
+        else:
+            collision_reported = any(
+                record.levelname in {'WARNING', 'ERROR', 'CRITICAL'}
+                for record in caplog.records
+            )
+
+        assert collision_reported
+
