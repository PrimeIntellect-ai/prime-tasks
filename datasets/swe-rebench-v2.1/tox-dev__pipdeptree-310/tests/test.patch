+def test_json_modes_agree_on_unconstrained_dependency_version(
+    mock_pkgs: Callable[[MockGraph], Iterator[Mock]],
+    monkeypatch: pytest.MonkeyPatch,
+    capsys: pytest.CaptureFixture[str],
+) -> None:
+    graph: dict[tuple[str, str], list[tuple[str, list[tuple[str, str]]]]] = {
+        ("a", "1.2.3"): [("b", [])],
+        ("b", "2.2.0"): [],
+    }
+    packages = list(mock_pkgs(graph))
+    monkeypatch.setattr("pipdeptree.__main__.get_installed_distributions", lambda **_: packages)
+
+    outputs: dict[str, Any] = {}
+    for option in ("--json", "--json-tree"):
+        main([option, "-p", "a"])
+        outputs[option] = json.loads(capsys.readouterr().out)
+
+    json_output = outputs["--json"]
+    tree_output = outputs["--json-tree"]
+    flat_required_versions = {
+        dependency["required_version"]
+        for entry in json_output
+        for dependency in entry["dependencies"]
+    }
+    assert flat_required_versions == {"Any"}
+
+    tree_required_versions = {tree_output[0]["dependencies"][0]["required_version"]}
+    assert tree_required_versions == flat_required_versions
