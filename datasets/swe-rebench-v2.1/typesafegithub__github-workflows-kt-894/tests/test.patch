@@ -347,4 +347,43 @@ class JobsToYamlTest : DescribeSpec({
             ),
         )
     }
+    it("renders a job with a list of runs-on labels") {
+        // given
+        val jobs = listOf(
+            Job(
+                id = "Job-1",
+                runsOn = RunnerType.Labelled("self-hosted", "X64"),
+                steps = listOf(
+                    CommandStep(
+                        id = "someId",
+                        name = "Some command",
+                        command = "echo 'test!'",
+                    ),
+                ),
+                outputs = JobOutputs.EMPTY,
+            ),
+        )
+
+        // when
+        val yaml = jobs.jobsToYaml()
+
+        // then
+        val jobYaml = yaml.getValue("Job-1") as Map<*, *>
+        val runsOn = jobYaml["runs-on"]
+        val labels = when (runsOn) {
+            is Iterable<*> -> runsOn.toList()
+            is Array<*> -> runsOn.toList()
+            else -> error("Expected runs-on to be a YAML sequence, but got $runsOn")
+        }
+        labels shouldBe listOf("self-hosted", "X64")
+        (jobYaml - "runs-on") shouldBe mapOf(
+            "steps" to listOf(
+                mapOf(
+                    "id" to "someId",
+                    "name" to "Some command",
+                    "run" to "echo 'test!'",
+                ),
+            ),
+        )
+    }
 })
