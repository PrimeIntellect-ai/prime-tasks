+package day186
+
+import (
+	"testing"
+)
+
+var testcases = []struct {
+	nums []int
+	diff int
+}{
+	{[]int{5, 10, 15, 20, 25}, 5},
+	{[]int{1, 2}, 1},
+	{[]int{1, 2, 3, 4}, 0},
+	{[]int{3, 3, 3}, 3},
+	{[]int{2, 7, 11}, 2},
+}
+
+func TestSubsetsSmallestDifference(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		s1, s2 := SubsetsSmallestDifference(tc.nums)
+		if !preservesInputPartition(tc.nums, s1, s2) {
+			t.Errorf("returned subsets %v and %v do not partition input %v", s1, s2, tc.nums)
+		}
+		if got := testSubsetDifference(s1, s2); got != tc.diff {
+			t.Errorf("expected minimum difference %v, got %v for input %v (subsets %v and %v)", tc.diff, got, tc.nums, s1, s2)
+		}
+	}
+}
+
+func preservesInputPartition(input, s1, s2 []int) bool {
+	counts := make(map[int]int)
+	for _, value := range input {
+		counts[value]++
+	}
+	for _, subset := range [][]int{s1, s2} {
+		for _, value := range subset {
+			counts[value]--
+		}
+	}
+	for _, count := range counts {
+		if count != 0 {
+			return false
+		}
+	}
+	return true
+}
+
+func testSubsetDifference(s1, s2 []int) int {
+	total1, total2 := 0, 0
+	for _, value := range s1 {
+		total1 += value
+	}
+	for _, value := range s2 {
+		total2 += value
+	}
+	if total1 < total2 {
+		return total2 - total1
+	}
+	return total1 - total2
+}
+
+func BenchmarkSubsetsSmallestDifference(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			SubsetsSmallestDifference(tc.nums)
+		}
+	}
+}
