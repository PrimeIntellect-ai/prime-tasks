+(defn- read-chunked-body
+  "Reads every chunk from a Netty ChunkedInput and returns the concatenated body string."
+  [^ChunkedInput body]
+  (let [sb (StringBuilder.)]
+    (loop []
+      (when-let [^HttpContent chunk (.readChunk body ByteBufAllocator/DEFAULT)]
+        (.append sb (bs/to-string (.content chunk)))
+        (recur)))
+    (str sb)))
 
