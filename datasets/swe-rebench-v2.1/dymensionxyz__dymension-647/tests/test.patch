+func (suite *RollappTestSuite) TestGetPendingFinalizationQueue() {
+	suite.SetupTest()
+
+	initialheight := uint64(10)
+	suite.Ctx = suite.Ctx.WithBlockHeight(int64(initialheight))
+	ctx := &suite.Ctx
+
+	keeper := suite.App.RollappKeeper
+
+	// Create a rollapp
+	rollapp := suite.CreateDefaultRollapp()
+
+	// Create a sequencer
+	proposer := suite.CreateDefaultSequencer(*ctx, rollapp)
+
+	// Create a state update
+	_, err := suite.PostStateUpdate(*ctx, rollapp, proposer, 1, uint64(10))
+	suite.Require().Nil(err)
+
+	suite.Ctx = suite.Ctx.WithBlockHeight(int64(initialheight + 1))
+	// Create a state update
+	_, err = suite.PostStateUpdate(*ctx, rollapp, proposer, 11, uint64(10))
+	suite.Require().Nil(err)
+
+	// The dispute period is a configured parameter; read it so the assertions
+	// below are expressed in terms of the configured value.
+	disputePeriod := keeper.DisputePeriodInBlocks(*ctx)
+
+	// stateInfoStatus returns the current status of the state info with the
+	// given index for the rollapp under test.
+	stateInfoStatus := func(index uint64) types.StateStatus {
+		stateInfo, found := keeper.GetStateInfo(*ctx, rollapp, index)
+		suite.Require().True(found)
+		return stateInfo.Status
+	}
+
+	// Finalize pending queues and check
+	suite.App.EndBlocker(suite.Ctx, abci.RequestEndBlock{Height: suite.Ctx.BlockHeight()})
+	// No dispute period has elapsed yet, so no state info may be finalized.
+	suite.Require().Equal(types.STATE_STATUS_RECEIVED, stateInfoStatus(1))
+	suite.Require().Equal(types.STATE_STATUS_RECEIVED, stateInfoStatus(2))
+	suite.Require().Len(keeper.GetAllBlockHeightToFinalizationQueue(*ctx), 2)
+
+	// Increase height
+	suite.Ctx = suite.Ctx.WithBlockHeight(int64(initialheight + disputePeriod))
+
+	// Finalize pending queues and check
+	suite.App.EndBlocker(suite.Ctx, abci.RequestEndBlock{Height: suite.Ctx.BlockHeight()})
+	// The dispute period of the first state info has elapsed, so it must be
+	// finalized; the second one is still within its dispute period.
+	suite.Require().Equal(types.STATE_STATUS_FINALIZED, stateInfoStatus(1))
+	suite.Require().Equal(types.STATE_STATUS_RECEIVED, stateInfoStatus(2))
+	suite.Require().Len(keeper.GetAllBlockHeightToFinalizationQueue(*ctx), 1)
+
+	// Increase height
+	suite.Ctx = suite.Ctx.WithBlockHeight(int64(initialheight + disputePeriod + 1))
+
+	// Finalize pending queues and check
+	suite.App.EndBlocker(suite.Ctx, abci.RequestEndBlock{Height: suite.Ctx.BlockHeight()})
+	// Both state infos must now be finalized.
+	suite.Require().Equal(types.STATE_STATUS_FINALIZED, stateInfoStatus(1))
+	suite.Require().Equal(types.STATE_STATUS_FINALIZED, stateInfoStatus(2))
+	suite.Require().Len(keeper.GetAllBlockHeightToFinalizationQueue(*ctx), 0)
+}
+
+// TestDisputePeriodInBlocks verifies that the keeper exposes the configured
+// dispute period (measured in block heights).
+func (suite *RollappTestSuite) TestDisputePeriodInBlocks() {
+	suite.SetupTest()
+	ctx := &suite.Ctx
+	keeper := suite.App.RollappKeeper
+
+	keeper.SetParams(*ctx, types.NewParams(true, 7, nil))
+	suite.Require().Equal(uint64(7), keeper.DisputePeriodInBlocks(*ctx))
+}
+
+// TestGetAllBlockHeightToFinalizationQueueEmpty verifies that the getter returns
+// an empty slice when no queue entries are stored.
+func TestGetAllBlockHeightToFinalizationQueueEmpty(t *testing.T) {
+	keeper, ctx := keepertest.RollappKeeper(t)
+	require.Len(t, keeper.GetAllBlockHeightToFinalizationQueue(ctx), 0)
+}
