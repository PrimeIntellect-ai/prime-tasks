+func TestMappingStringFlowNestedValues(t *testing.T) {
+	type flowStyleSetter interface {
+		SetIsFlowStyle(bool)
+	}
+
+	source := `
+volumes:
+  name: config-volume
+  configMap:
+    name: app-config
+`
+	f, err := parser.ParseBytes([]byte(source), parser.ParseComments)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(f.Docs) != 1 {
+		t.Fatalf("expected one document, got %d", len(f.Docs))
+	}
+	root, ok := f.Docs[0].Body.(flowStyleSetter)
+	if !ok {
+		t.Fatalf("document body does not support flow style: %T", f.Docs[0].Body)
+	}
+	root.SetIsFlowStyle(true)
+
+	const expected = `{volumes: {name: config-volume, configMap: {name: app-config}}}`
+	if got := f.Docs[0].Body.String(); got != expected {
+		t.Fatalf("unexpected flow-style mapping:\nwant: %s\n got: %s", expected, got)
+	}
+}
