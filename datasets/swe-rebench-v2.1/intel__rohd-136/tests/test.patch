+      expect(
+          // % normal
+          LogicValue.ofString('0001') % LogicValue.ofString('0011'),
+          equals(LogicValue.ofString('0001')) // 1 % 3 = 1
+          );
+      expect(
+          // % normal
+          LogicValue.ofString('0100') % LogicValue.ofString('0010'),
+          equals(LogicValue.ofString('0000')) // 4 % 2 = 0
+          );
+      expect(
+          // % 0 mod
+          LogicValue.ofString('0000') % LogicValue.ofString('0011'),
+          equals(LogicValue.ofString('0000')) // 0 % 3 = 0
+          );
+      expect(
+          // mod-by-0
+          () => LogicValue.ofString('0100') % LogicValue.ofString('0000'),
+          throwsA(isA<Exception>()));
+      expect(
+          // % num by num
+          LogicValue.ofString('0100') % LogicValue.ofString('0100'),
+          equals(LogicValue.ofString('0000')));
+      expect(
+          // % with an int operand
+          LogicValue.ofString('0100') % 3,
+          equals(LogicValue.ofString('0001')) // 4 % 3 = 1
+          );
+      expect(
+          // % with a BigInt operand
+          LogicValue.ofString('0100') % BigInt.from(3),
+          equals(LogicValue.ofString('0001')) // 4 % 3 = 1
+          );
+      expect(
+          // % propagates x from the dividend
+          LogicValue.ofString('000x') % LogicValue.ofString('0011'),
+          equals(LogicValue.ofString('xxxx')));
+      expect(
+          // % propagates x from the divisor
+          LogicValue.ofString('0001') % LogicValue.ofString('00x1'),
+          equals(LogicValue.ofString('xxxx')));
+      expect(
+          // % propagates z from the dividend
+          LogicValue.ofString('000z') % LogicValue.ofString('0011'),
+          equals(LogicValue.ofString('xxxx')));
+      expect(
+          // % result is width-aware (matches the left operand width)
+          LogicValue.ofString('00000100') % 3,
+          equals(LogicValue.ofString('00000001')) // 4 % 3 = 1
+          );
