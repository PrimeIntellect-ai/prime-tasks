@@ -0,0 +1,170 @@
+@testset "Unit" begin
+  a = [2.7, 2.9, 2.2, 1.4, 1.8, 3.3] * u"m"
+  b = [300, 500, missing, 800, missing, 400] * u"cm"
+  c = [8, 2, 5, 7, 9, 4] * u"km"
+  d = [0.3, 0.1, 0.9, 0.2, 0.7, 0.4]
+  e = ["no", "no", "yes", "yes", "no", "yes"]
+  t = Table(; a, b, c, d, e)
+
+  a = [2.7, 2.9, 2.2, 1.4, 1.8, 3.3] * u"m"
+  b = [300, 500, missing, 800, missing, 400] * u"cm"
+  c = [8, 2, 5, 7, 9, 4] * u"km"
+  d = [29.1, missing, 29.2, missing, 28.4, 26.4] * u"°C"
+  e = [0.9, 0.4, 0.5, 0.1, 0.3, 0.6] * u"kg"
+  f = 0.5u"ppm" * e
+  t = Table(; a, b, c, d, e, f)
+
+  # convert a single column by index
+  T = Unit(4 => u"K")
+  n, cache = apply(T, t)
+  @test unit(eltype(n.a)) == u"m"
+  @test unit(eltype(n.b)) == u"cm"
+  @test unit(eltype(n.c)) == u"km"
+  @test unit(eltype(n.d)) == u"K"
+  @test unit(eltype(n.e)) == u"kg"
+  @test unit(eltype(n.f)) == u"kg * ppm"
+  @test all(isequal.(n.d, uconvert.(u"K", t.d)))
+  @test n.a == t.a
+  @test isequal(n.b, t.b)
+  @test n.c == t.c
+  @test n.e == t.e
+  @test n.f == t.f
+
+  # convert a single column by name (Symbol)
+  T = Unit(:e => u"g")
+  n, cache = apply(T, t)
+  @test unit(eltype(n.a)) == u"m"
+  @test unit(eltype(n.b)) == u"cm"
+  @test unit(eltype(n.c)) == u"km"
+  @test unit(eltype(n.d)) == u"°C"
+  @test unit(eltype(n.e)) == u"g"
+  @test unit(eltype(n.f)) == u"kg * ppm"
+  @test all(isequal.(n.e, uconvert.(u"g", t.e)))
+  @test n.a == t.a
+  @test isequal(n.b, t.b)
+  @test n.c == t.c
+  @test isequal(n.d, t.d)
+  @test n.f == t.f
+
+  # convert a single column by name (String)
+  T = Unit("f" => u"kg")
+  n, cache = apply(T, t)
+  @test unit(eltype(n.a)) == u"m"
+  @test unit(eltype(n.b)) == u"cm"
+  @test unit(eltype(n.c)) == u"km"
+  @test unit(eltype(n.d)) == u"°C"
+  @test unit(eltype(n.e)) == u"kg"
+  @test unit(eltype(n.f)) == u"kg"
+  @test all(isequal.(n.f, uconvert.(u"kg", t.f)))
+  @test n.a == t.a
+  @test isequal(n.b, t.b)
+  @test n.c == t.c
+  @test isequal(n.d, t.d)
+  @test n.e == t.e
+
+  # convert a collection of columns by index
+  T = Unit([1, 2, 3] => u"m")
+  n, cache = apply(T, t)
+  @test unit(eltype(n.a)) == u"m"
+  @test unit(eltype(n.b)) == u"m"
+  @test unit(eltype(n.c)) == u"m"
+  @test unit(eltype(n.d)) == u"°C"
+  @test unit(eltype(n.e)) == u"kg"
+  @test unit(eltype(n.f)) == u"kg * ppm"
+  @test all(isequal.(n.a, uconvert.(u"m", t.a)))
+  @test all(isequal.(n.b, uconvert.(u"m", t.b)))
+  @test all(isequal.(n.c, uconvert.(u"m", t.c)))
+  @test isequal(n.d, t.d)
+  @test n.e == t.e
+  @test n.f == t.f
+
+  # convert a collection of columns by name (Symbol)
+  T = Unit([:a, :b, :c] => u"cm")
+  n, cache = apply(T, t)
+  @test unit(eltype(n.a)) == u"cm"
+  @test unit(eltype(n.b)) == u"cm"
+  @test unit(eltype(n.c)) == u"cm"
+  @test unit(eltype(n.d)) == u"°C"
+  @test unit(eltype(n.e)) == u"kg"
+  @test unit(eltype(n.f)) == u"kg * ppm"
+  @test all(isequal.(n.a, uconvert.(u"cm", t.a)))
+  @test all(isequal.(n.b, uconvert.(u"cm", t.b)))
+  @test all(isequal.(n.c, uconvert.(u"cm", t.c)))
+  @test isequal(n.d, t.d)
+  @test n.e == t.e
+  @test n.f == t.f
+
+  # convert a collection of columns by name (String)
+  T = Unit(["a", "b", "c"] => u"km")
+  n, cache = apply(T, t)
+  @test unit(eltype(n.a)) == u"km"
+  @test unit(eltype(n.b)) == u"km"
+  @test unit(eltype(n.c)) == u"km"
+  @test unit(eltype(n.d)) == u"°C"
+  @test unit(eltype(n.e)) == u"kg"
+  @test unit(eltype(n.f)) == u"kg * ppm"
+  @test all(isequal.(n.a, uconvert.(u"km", t.a)))
+  @test all(isequal.(n.b, uconvert.(u"km", t.b)))
+  @test all(isequal.(n.c, uconvert.(u"km", t.c)))
+  @test isequal(n.d, t.d)
+  @test n.e == t.e
+  @test n.f == t.f
+
+  # convert columns selected by regex
+  T = Unit(r"[abc]" => u"m")
+  n, cache = apply(T, t)
+  @test unit(eltype(n.a)) == u"m"
+  @test unit(eltype(n.b)) == u"m"
+  @test unit(eltype(n.c)) == u"m"
+  @test unit(eltype(n.d)) == u"°C"
+  @test unit(eltype(n.e)) == u"kg"
+  @test unit(eltype(n.f)) == u"kg * ppm"
+  @test all(isequal.(n.a, uconvert.(u"m", t.a)))
+  @test all(isequal.(n.b, uconvert.(u"m", t.b)))
+  @test all(isequal.(n.c, uconvert.(u"m", t.c)))
+  @test isequal(n.d, t.d)
+  @test n.e == t.e
+  @test n.f == t.f
+
+  # convert columns selected by a ColumnSelector object
+  T = Unit(CS.selector(:a) => u"cm")
+  n, cache = apply(T, t)
+  @test unit(eltype(n.a)) == u"cm"
+  @test unit(eltype(n.b)) == u"cm"
+  @test unit(eltype(n.c)) == u"km"
+  @test all(isequal.(n.a, uconvert.(u"cm", t.a)))
+  @test isequal(n.b, t.b)
+  @test n.c == t.c
+  @test isequal(n.d, t.d)
+  @test n.e == t.e
+  @test n.f == t.f
+
+  T = Unit(CS.selector([:b, :c]) => u"m")
+  n, cache = apply(T, t)
+  @test unit(eltype(n.a)) == u"m"
+  @test unit(eltype(n.b)) == u"m"
+  @test unit(eltype(n.c)) == u"m"
+  @test n.a == t.a
+  @test all(isequal.(n.b, uconvert.(u"m", t.b)))
+  @test all(isequal.(n.c, uconvert.(u"m", t.c)))
+  @test isequal(n.d, t.d)
+  @test n.e == t.e
+  @test n.f == t.f
+
+  # apply multiple pairs together
+  T = Unit(:a => u"cm", [:b, :c] => u"m")
+  n, cache = apply(T, t)
+  @test unit(eltype(n.a)) == u"cm"
+  @test unit(eltype(n.b)) == u"m"
+  @test unit(eltype(n.c)) == u"m"
+  @test unit(eltype(n.d)) == u"°C"
+  @test unit(eltype(n.e)) == u"kg"
+  @test unit(eltype(n.f)) == u"kg * ppm"
+  @test all(isequal.(n.a, uconvert.(u"cm", t.a)))
+  @test all(isequal.(n.b, uconvert.(u"m", t.b)))
+  @test all(isequal.(n.c, uconvert.(u"m", t.c)))
+  @test isequal(n.d, t.d)
+  @test n.e == t.e
+  @test n.f == t.f
+
+end
