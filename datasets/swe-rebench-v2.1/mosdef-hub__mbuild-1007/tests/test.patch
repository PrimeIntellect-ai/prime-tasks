+    def test_get_boundingbox_extrema(self):
+        h1 = mb.Compound()
+        h2 = mb.Compound()
+        h1.pos = [-0.07590747, 0.00182889, 0.00211742]
+        h2.pos = [0.07590747, -0.00182889, -0.00211742]
+        container = mb.Compound([h1, h2])
+        distances = container.maxs - container.mins
+        with pytest.raises(
+            MBuildError, match=r"The vectors to define the box are co\-linear\,"
+        ):
+            container.get_boundingbox()
+        distance_list = [val for val in distances]
+        distance_list = [val + 1.0 for val in distance_list]
+        np.testing.assert_almost_equal(
+            container.get_boundingbox(pad_box=1.0).lengths,
+            distance_list,
+            decimal=6,
+        )
+
+        distance_list = [val for val in distances]
+        distance_list[0] = distance_list[0] + 1.0
+        distance_list[1] = distance_list[1] + 2.0
+        distance_list[2] = distance_list[2] + 3.0
+        np.testing.assert_almost_equal(
+            container.get_boundingbox(pad_box=[1.0, 2.0, 3.0]).lengths,
+            distance_list,
+            decimal=6,
+        )
+
+    def test_get_boundingbox_returns_box(self):
+        compound = mb.Compound(
+            [mb.Compound(pos=[0.0, 0.0, 0.0]), mb.Compound(pos=[1.0, 1.0, 1.0])]
+        )
+        assert isinstance(compound.get_boundingbox(), mb.Box)
+        assert isinstance(compound.get_boundingbox(pad_box=1.0), mb.Box)
+
+    @pytest.mark.parametrize(
+        "bad_value", [[1.0, 2.0], set([1, 2, 3]), {"x": 1.0}]
+    )
+    def test_get_boundingbox_error(self, bad_value):
+        compound = mb.Compound(
+            [mb.Compound(pos=[0.0, 0.0, 0.0]), mb.Compound(pos=[1.0, 1.0, 1.0])]
+        )
+        # A valid padding value is accepted ...
+        compound.get_boundingbox(pad_box=1.0)
+        # ... while an invalid one raises TypeError.
+        with pytest.raises(TypeError):
+            compound.get_boundingbox(pad_box=bad_value)
+
+    def test_get_boundingbox_pad_box_forms(self):
+        h1 = mb.Compound()
+        h2 = mb.Compound()
+        h1.pos = [-0.07590747, 0.00182889, 0.00211742]
+        h2.pos = [0.07590747, -0.00182889, -0.00211742]
+        container = mb.Compound([h1, h2])
+        distances = container.maxs - container.mins
+
+        # A numeric string is applied uniformly.
+        np.testing.assert_almost_equal(
+            container.get_boundingbox(pad_box="1").lengths,
+            [val + 1.0 for val in distances],
+            decimal=6,
+        )
+        # A length-one list is applied uniformly.
+        np.testing.assert_almost_equal(
+            container.get_boundingbox(pad_box=[2.0]).lengths,
+            [val + 2.0 for val in distances],
+            decimal=6,
+        )
+        # A length-one tuple is applied uniformly.
+        np.testing.assert_almost_equal(
+            container.get_boundingbox(pad_box=(3.0,)).lengths,
+            [val + 3.0 for val in distances],
+            decimal=6,
+        )
+        # A length-three tuple is applied per axis.
+        np.testing.assert_almost_equal(
+            container.get_boundingbox(pad_box=(1.0, 2.0, 3.0)).lengths,
+            [
+                distances[0] + 1.0,
+                distances[1] + 2.0,
+                distances[2] + 3.0,
+            ],
+            decimal=6,
+        )
+
+    def test_get_boundingbox_pad_box_conversion_error(self):
+        compound = mb.Compound(
+            [mb.Compound(pos=[0.0, 0.0, 0.0]), mb.Compound(pos=[1.0, 1.0, 1.0])]
+        )
+        # A convertible padding value is accepted ...
+        compound.get_boundingbox(pad_box=[1.0])
+        # ... while one that cannot be converted to float raises TypeError.
+        with pytest.raises(TypeError):
+            compound.get_boundingbox(pad_box=[None])
+
