+func TestDescribeTriggerWithEmptyFilters(t *testing.T) {
+	emptyAttributes := v1alpha1.TriggerFilterAttributes{}
+	for _, filter := range []*v1alpha1.TriggerFilter{nil, {}, {Attributes: &emptyAttributes}} {
+		client := clientv1alpha1.NewMockKnEventingClient(t)
+		trigger := &v1alpha1.Trigger{
+			ObjectMeta: metav1.ObjectMeta{Name: "empty-filter-trigger", Namespace: "default"},
+			Spec: v1alpha1.TriggerSpec{
+				Broker:     "default",
+				Filter:     filter,
+				Subscriber: duckv1.Destination{Ref: &duckv1.KReference{Name: "sink", Kind: "Service", Namespace: "default"}},
+			},
+		}
+		recorder := client.Recorder()
+		recorder.GetTrigger(trigger.Name, trigger, nil)
+
+		output := new(bytes.Buffer)
+		params := &commands.KnParams{
+			Output:            output,
+			NewEventingClient: func(string) (clientv1alpha1.KnEventingClient, error) { return client, nil },
+		}
+		cmd := triggercmd.NewTriggerDescribeCommand(params)
+		cmd.SetArgs([]string{"--namespace", "default", trigger.Name})
+		cmd.SetOutput(output)
+		assert.NilError(t, cmd.Execute())
+		recorder.Validate()
+	}
+}
+
+func TestCreateTriggerWithoutFilterFlag(t *testing.T) {
+	client := clientv1alpha1.NewMockKnEventingClient(t)
+	dynamicClient := dynamicfake.CreateFakeKnDynamicClient("default", &servingv1.Service{
+		TypeMeta:   metav1.TypeMeta{Kind: "Service", APIVersion: "serving.knative.dev/v1"},
+		ObjectMeta: metav1.ObjectMeta{Name: "sink", Namespace: "default"},
+	})
+
+	expected := clientv1alpha1.NewTriggerBuilder("unfiltered-trigger").
+		Namespace("default").
+		Broker("default").
+		Filters(nil).
+		Subscriber(&duckv1.Destination{Ref: &duckv1.KReference{
+			Name: "sink", Kind: "Service", APIVersion: "serving.knative.dev/v1", Namespace: "default",
+		}}).
+		Build()
+	assertNoFilterCriteria(t, expected.Spec.Filter)
+	client.Recorder().CreateTrigger(expected, nil)
+
+	output := new(bytes.Buffer)
+	params := &commands.KnParams{
+		Output: output,
+		NewDynamicClient: func(string) (kn_dynamic.KnDynamicClient, error) {
+			return dynamicClient, nil
+		},
+		NewEventingClient: func(string) (clientv1alpha1.KnEventingClient, error) {
+			return client, nil
+		},
+	}
+	cmd := triggercmd.NewTriggerCreateCommand(params)
+	cmd.SetArgs([]string{"--namespace", "default", "unfiltered-trigger", "--broker", "default", "--sink", "svc:sink"})
+	cmd.SetOutput(output)
+	assert.NilError(t, cmd.Execute())
+	client.Recorder().Validate()
+}
