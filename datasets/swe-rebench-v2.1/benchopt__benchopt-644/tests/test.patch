+def test_warm_up():
+
+    solver1 = """from benchopt import BaseSolver
+    import time
+    import numpy as np
+
+    class Solver(BaseSolver):
+        name = 'solver1'
+        sampling_strategy = 'iteration'
+
+        def set_objective(self, X, y, lmbd):
+            self.n_features = X.shape[1]
+            self._compiled = False
+
+        def _compile(self):
+            # Simulate a costly one-time compilation step.
+            time.sleep(0.5)
+            self._compiled = True
+
+        def warm_up(self):
+            print("WARMUP")
+            self._compile()
+            self.run_once(1)
+
+        def run(self, n_iter):
+            # If warm_up was not called, the compilation happens here and
+            # would be accounted for in the benchmark results.
+            if not self._compiled:
+                self._compile()
+
+        def get_result(self, **data):
+            return {'beta': np.zeros(self.n_features)}
+    """
+
+    with temp_benchmark(solvers=[solver1]) as benchmark:
+        with CaptureRunOutput() as out:
+            run([
+                str(benchmark.benchmark_dir),
+                *'-s solver1 -d test-dataset -n 0 -r 5 --no-plot'.split(),
+                *'-o dummy*[reg=0.5]'.split()
+            ], standalone_mode=False)
+
+            result_files = list(
+                (benchmark.benchmark_dir / "outputs").glob("*.parquet")
+            )
+            assert len(result_files) == 1
+            df = pd.read_parquet(result_files[0])
+
+        # Make sure warmup is called exactly once
+        out.check_output("WARMUP", repetition=1)
+
+    # The warm-up compilation time must not be accounted for in the
+    # benchmark results: once compiled, the solver's `run` is a no-op, so
+    # the recorded time should be far below the warm-up duration.
+    assert df["time"].max() < 0.25
+
+
