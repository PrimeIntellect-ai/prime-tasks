+func TestEncodeDefinedStringKindKeyMap(t *testing.T) {
+	type K string
+	type U struct {
+		M map[K]string
+	}
+	bytes, err := yaml.Marshal(U{
+		M: map[K]string{K("x"): "y"},
+	})
+	if err != nil {
+		t.Fatalf("%+v", err)
+	}
+	var actual map[string]map[string]string
+	if err := yaml.Unmarshal(bytes, &actual); err != nil {
+		t.Fatalf("could not parse encoded YAML: %+v", err)
+	}
+	if len(actual) != 1 || len(actual["m"]) != 1 || actual["m"]["x"] != "y" {
+		t.Fatalf("unexpected mapping value: %#v", actual)
+	}
+}
