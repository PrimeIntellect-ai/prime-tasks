+    def test_submodule_named_empty(self):
+        from amaranth import Elaboratable
+        from amaranth.back import rtlil
+
+        class Child(Elaboratable):
+            def elaborate(self, platform):
+                m = Module()
+                m.d.sync += Signal().eq(1)
+                return m
+
+        module_child = Module()
+        module_child.d.sync += Signal().eq(1)
+        for child in (module_child, Child()):
+            m = Module()
+            try:
+                m.submodules[""] = child
+            except Exception:
+                # Rejecting the invalid name while adding the submodule is valid.
+                continue
+
+            class Top(Elaboratable):
+                def elaborate(self, platform):
+                    return m
+
+            # If addition succeeds, RTLIL conversion must emit the submodule cell.
+            rtlil_text = rtlil.convert(Top(), ports=[])
+            cell_lines = [line.strip() for line in rtlil_text.splitlines()
+                          if line.lstrip().startswith("cell ")]
+            self.assertTrue(cell_lines)
+            for cell_line in cell_lines:
+                self.assertRegex(cell_line, r"^cell\s+(?:\\\S+|\$\S+)\s+(?:\\\S+|\$\S+)$")
+
     def test_submodule_get(self):
         m1 = Module()
         m2 = Module()
