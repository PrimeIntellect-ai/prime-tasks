+func TestWellformedRejectsMalformedData(t *testing.T) {
+	malformed := []byte{0xff} // A break marker is not a standalone data item.
+	if err := Wellformed(malformed); err == nil {
+		t.Error("Wellformed accepted a standalone break marker")
+	}
+	dm, err := (DecOptions{}).DecMode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := dm.Wellformed(malformed); err == nil {
+		t.Error("DecMode.Wellformed accepted a standalone break marker")
+	}
+}
