+func TestWellformedConfiguredCollectionLimits(t *testing.T) {
+	array := []byte{0x91} // 17-element array
+	for i := 0; i < 17; i++ {
+		array = append(array, 0x00)
+	}
+	arrayMode, err := (DecOptions{MaxArrayElements: 16}).DecMode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := arrayMode.Wellformed(array); err == nil {
+		t.Error("DecMode.Wellformed accepted an array over MaxArrayElements")
+	}
+
+	mp := []byte{0xb1} // 17-pair map
+	for i := byte(0); i < 17; i++ {
+		mp = append(mp, i, i)
+	}
+	mapMode, err := (DecOptions{MaxMapPairs: 16}).DecMode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := mapMode.Wellformed(mp); err == nil {
+		t.Error("DecMode.Wellformed accepted a map over MaxMapPairs")
+	}
+}
+
+func TestWellformedDefaultLimits(t *testing.T) {
+	nested := make([]byte, 34)
+	for i := 0; i < 33; i++ {
+		nested[i] = 0x81
+	}
+	nested[33] = 0x00
+	if err := Wellformed(nested); err == nil {
+		t.Error("Wellformed accepted data exceeding the default nesting limit")
+	}
+
+	const maxElements = 131072
+	array := make([]byte, 5+maxElements+1)
+	copy(array, []byte{0x9a, 0x00, 0x02, 0x00, 0x01}) // maxElements + 1
+	if err := Wellformed(array); err == nil {
+		t.Error("Wellformed accepted an array exceeding the default element limit")
+	}
+
+	mp := make([]byte, 5+2*(maxElements+1))
+	copy(mp, []byte{0xba, 0x00, 0x02, 0x00, 0x01}) // maxElements + 1 pairs
+	if err := Wellformed(mp); err == nil {
+		t.Error("Wellformed accepted a map exceeding the default pair limit")
+	}
+}
+
+func TestDecModeWellformedRejectsTrailingData(t *testing.T) {
+	dm, err := (DecOptions{}).DecMode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := dm.Wellformed([]byte{0x00, 0x01}); err == nil {
+		t.Fatal("DecMode.Wellformed accepted trailing data")
+	} else {
+		var extraneous *ExtraneousDataError
+		if !errors.As(err, &extraneous) {
+			t.Errorf("DecMode.Wellformed error type %T, want *ExtraneousDataError", err)
+		}
+	}
+}
