+func TestValidDeprecatedAndCompatible(t *testing.T) {
+	dm, err := (DecOptions{}).DecMode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, data := range [][]byte{{0x01}, {0xff}, {0x01, 0x02}} {
+		for name, validErr := range map[string]error{"Valid": Valid(data), "DecMode.Valid": dm.Valid(data)} {
+			wellformedErr := Wellformed(data)
+			if (validErr == nil) != (wellformedErr == nil) {
+				t.Errorf("%s and Wellformed disagree for 0x%x: legacy error %v, Wellformed error %v", name, data, validErr, wellformedErr)
+			}
+		}
+	}
+
+	for _, symbol := range []string{"Valid", "DecMode.Valid"} {
+		output, err := exec.Command("go", "doc", symbol).CombinedOutput()
+		if err != nil {
+			t.Fatalf("could not read the public %s documentation: %v\n%s", symbol, err, output)
+		}
+		if !strings.Contains(string(output), "Deprecated:") {
+			t.Errorf("public %s documentation does not identify the API as deprecated", symbol)
+		}
+	}
+}
