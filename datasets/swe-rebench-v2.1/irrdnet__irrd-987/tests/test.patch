+class _InMemoryConnection:
+    """Minimal stand-in for a client socket, as used by the whois worker."""
+
+    def __init__(self, request: bytes):
+        self.rfile = BytesIO(request)
+        self.wfile = BytesIO()
+
+    def makefile(self, mode, bufsize):
+        return self.wfile if "w" in mode else self.rfile
+
+    def sendall(self, data):
+        self.wfile.write(data)
+
+    def shutdown(self, flags):
+        pass
+
+    def close(self):
+        pass
+
+    def settimeout(self, timeout):
+        pass
+
+
+def run_whois_connection(monkeypatch, database_handler, request: bytes) -> bytes:
+    """
+    Send raw request lines to a whois worker, as a client connection would,
+    and return the bytes the server wrote back.
+    """
+    monkeypatch.setattr("irrd.server.whois.server.Preloader", lambda: Mock(spec=Preloader))
+    monkeypatch.setattr(
+        "irrd.server.whois.server.DatabaseHandler", lambda readonly: database_handler
+    )
+    queue = Queue()
+    worker = WhoisWorker(queue)
+    connection = _InMemoryConnection(request)
+    queue.put((connection, ("192.0.2.1", 99999)))
+    worker.run(keep_running=False)
+    return connection.wfile.getvalue()
+
