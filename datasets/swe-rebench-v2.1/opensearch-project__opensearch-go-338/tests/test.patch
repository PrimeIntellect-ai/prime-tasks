@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The OpenSearch Contributors require contributions made to
+// this file be licensed under the Apache-2.0 license or a
+// compatible open source license.
+//
+// Modifications Copyright OpenSearch Contributors. See
+// GitHub history for details.
+
+package opensearchapi
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	"github.com/aws/aws-sdk-go-v2/config"
+	"github.com/opensearch-project/opensearch-go/v2/opensearchtransport"
+	"github.com/opensearch-project/opensearch-go/v2/signer/awsv2"
+	"github.com/stretchr/testify/require"
+)
+
+type dataStreamStatsStubTransport struct {
+	req      *http.Request
+	response *http.Response
+}
+
+func (t *dataStreamStatsStubTransport) Perform(req *http.Request) (*http.Response, error) {
+	t.req = req
+	if t.response != nil {
+		return t.response, nil
+	}
+	return &http.Response{}, nil
+}
+
+func TestDataStreamStatsNoNameUsesStatsPath(t *testing.T) {
+	tt := dataStreamStatsStubTransport{}
+	req := IndicesGetDataStreamStatsRequest{}
+
+	expectedPath := "/_data_stream/_stats"
+
+	_, err := req.Do(context.Background(), &tt)
+	if err != nil {
+		t.Fatalf("Error getting response: %s", err)
+	}
+
+	require.Equal(t, expectedPath, tt.req.URL.Path)
+}
+
+func TestDataStreamStatsWithNameUsesNamedStatsPath(t *testing.T) {
+	tt := dataStreamStatsStubTransport{}
+	req := IndicesGetDataStreamStatsRequest{
+		Name: "demo-1",
+	}
+
+	expectedPath := fmt.Sprintf("/_data_stream/%s/_stats", req.Name)
+
+	_, err := req.Do(context.Background(), &tt)
+	if err != nil {
+		t.Fatalf("Error getting response: %s", err)
+	}
+
+	require.Equal(t, expectedPath, tt.req.URL.Path)
+}
+
+type dataStreamStatsRoundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f dataStreamStatsRoundTripFunc) RoundTrip(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+// TestDataStreamStatsNoNameAWSSignedPath exercises the Data Stream
+// Stats request with no name through the real AWS signing transport. It
+// verifies that the request is signed and that the signed path is the one the
+// server expects, so the signature cannot mismatch.
+func TestDataStreamStatsNoNameAWSSignedPath(t *testing.T) {
+	var captured *http.Request
+	rt := dataStreamStatsRoundTripFunc(func(req *http.Request) (*http.Response, error) {
+		captured = req
+		return &http.Response{
+			StatusCode: 200,
+			Status:     "200 OK",
+			Header:     http.Header{"Content-Type": []string{"application/json"}},
+			Body:       io.NopCloser(strings.NewReader(`{"data_streams":[]}`)),
+		}, nil
+	})
+
+	awsCfg, err := config.LoadDefaultConfig(context.Background(),
+		config.WithRegion("us-west-2"),
+		config.WithCredentialsProvider(aws.CredentialsProviderFunc(
+			func(ctx context.Context) (aws.Credentials, error) {
+				return aws.Credentials{
+					AccessKeyID:     "AKID",
+					SecretAccessKey: "SECRET_KEY",
+					SessionToken:    "TOKEN",
+				}, nil
+			},
+		)),
+	)
+	require.NoError(t, err)
+
+	awsSigner, err := awsv2.NewSigner(awsCfg)
+	require.NoError(t, err)
+
+	tp, err := opensearchtransport.New(opensearchtransport.Config{
+		URLs:      []*url.URL{{Scheme: "https", Host: "localhost:9200"}},
+		Signer:    awsSigner,
+		Transport: rt,
+	})
+	require.NoError(t, err)
+
+	req := IndicesGetDataStreamStatsRequest{}
+	_, err = req.Do(context.Background(), tp)
+	require.NoError(t, err)
+
+	require.NotNil(t, captured)
+	require.Equal(t, "/_data_stream/_stats", captured.URL.Path)
+	require.NotEmpty(t, captured.Header.Get("Authorization"))
+}
+
+func TestDataStreamStatsNoNameReturnsStreamsAndStats(t *testing.T) {
+	body := `{"data_stream_count":1,"backing_indices":2,"data_streams":[{"data_stream":"logs-app","backing_indices":2,"store_size_bytes":512}]}`
+	transport := dataStreamStatsStubTransport{response: &http.Response{
+		StatusCode: 200,
+		Header:     make(http.Header),
+		Body:       io.NopCloser(strings.NewReader(body)),
+	}}
+
+	resp, err := (IndicesGetDataStreamStatsRequest{}).Do(context.Background(), &transport)
+	require.NoError(t, err)
+	require.NotNil(t, resp)
+	require.NotNil(t, resp.Body)
+	defer resp.Body.Close()
+
+	var result struct {
+		DataStreamCount int `json:"data_stream_count"`
+		BackingIndices  int `json:"backing_indices"`
+		DataStreams     []struct {
+			Name           string `json:"data_stream"`
+			BackingIndices int    `json:"backing_indices"`
+			StoreSizeBytes int    `json:"store_size_bytes"`
+		} `json:"data_streams"`
+	}
+	require.NoError(t, json.NewDecoder(resp.Body).Decode(&result))
+	require.Equal(t, 1, result.DataStreamCount)
+	require.Equal(t, 2, result.BackingIndices)
+	require.Len(t, result.DataStreams, 1)
+	require.Equal(t, "logs-app", result.DataStreams[0].Name)
+	require.Equal(t, 2, result.DataStreams[0].BackingIndices)
+	require.Equal(t, 512, result.DataStreams[0].StoreSizeBytes)
+}
