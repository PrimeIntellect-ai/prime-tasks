+#[test]
+fn ring_edge() {
+    let hex = Hex::new(-189, 35);
+    let edge = hex.ring_edge(48, DiagonalDirection::TopRight);
+    assert_eq!(edge.len(), edge.count());
+    // empty
+    let edge = hex.ring_edge(0, DiagonalDirection::TopRight);
+    let len = edge.len();
+    let edge: Vec<_> = edge.collect();
+    assert_eq!(edge.len(), len);
+    assert_eq!(edge, vec![hex]);
+    // len 1
+    let edge = hex.ring_edge(1, DiagonalDirection::TopRight);
+    let len = edge.len();
+    let edge: Vec<_> = edge.collect();
+    assert_eq!(edge.len(), len);
+    assert_eq!(edge.len(), 2);
+}
+
+#[test]
+#[allow(clippy::cast_possible_truncation)]
+fn wedge() {
+    let hex = Hex::new(98, -123);
+    for dir in DiagonalDirection::ALL_DIRECTIONS {
+        for range in 0..=30 {
+            let wedge: Vec<_> = hex.wedge(0..=range, dir).collect();
+            assert_eq!(wedge.len() as u32, range * (range + 3) / 2 + 1);
+        }
+    }
+}
+
+fn assert_exact_size_iterator<I: ExactSizeIterator<Item = Hex>>(mut iter: I) -> usize {
+    let total = iter.len();
+    assert_eq!(iter.size_hint(), (total, Some(total)));
+    let mut yielded = 0;
+    while iter.next().is_some() {
+        yielded += 1;
+        assert_eq!(iter.len(), total - yielded);
+        assert_eq!(iter.size_hint(), (total - yielded, Some(total - yielded)));
+    }
+    assert_eq!(yielded, total);
+    total
+}
+
+#[test]
+fn exact_size_shapes() {
+    let hex = Hex::new(1, 2);
+    assert_eq!(
+        assert_exact_size_iterator(hex.range(6)),
+        Hex::range_count(6)
+    );
+    assert_exact_size_iterator(Hex::ZERO.line_to(Hex::new(4, -7)));
+    assert_exact_size_iterator(Hex::new(-189, 35).ring_edge(7, DiagonalDirection::TopRight));
+    assert_exact_size_iterator(crate::shapes::hexagon(hex, 6));
+    assert_exact_size_iterator(crate::shapes::triangle(5));
+    assert_exact_size_iterator(crate::shapes::parallelogram(
+        Hex::new(-2, -3),
+        Hex::new(4, 2),
+    ));
+    assert_exact_size_iterator(crate::shapes::pointy_rectangle([-3, 4, -2, 5]));
+    assert_exact_size_iterator(crate::shapes::flat_rectangle([-3, 4, -2, 5]));
+    let bounds = crate::bounds::HexBounds {
+        center: hex,
+        radius: 4,
+    };
+    assert_eq!(
+        assert_exact_size_iterator(bounds.all_coords()),
+        Hex::range_count(4)
+    );
+}
