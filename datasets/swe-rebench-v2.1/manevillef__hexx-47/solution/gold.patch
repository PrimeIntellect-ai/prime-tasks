+    }
+
+    #[test]
+    fn parallelogram_test() {
+        for min in 0..=30 {
+            for max in 0..=30 {
+                let iter = parallelogram(Hex::splat(min), Hex::splat(min + max));
+                assert_eq!(iter.len(), iter.count());
+            }
+        }
+    }
