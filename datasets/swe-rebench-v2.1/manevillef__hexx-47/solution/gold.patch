+    #[test]
+    fn hexagon_test() {
+        let hex = Hex::new(3, -987);
+        for range in 0..=30 {
+            let iter = hexagon(hex, range);
+            assert_eq!(iter.len(), iter.count());
+        }
+    }
+
+    #[test]
