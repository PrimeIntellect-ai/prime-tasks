+    def test_remove_without_multiprocess(self):
+        registry = CollectorRegistry()
+        counter = Counter('c', 'help', labelnames=['label'], registry=registry)
+        counter.labels('label').inc()
+        self.assertEqual(1, registry.get_sample_value('c_total', {'label': 'label'}))
+        counter.remove('label')
+        self.assertIsNone(registry.get_sample_value('c_total', {'label': 'label'}))
+
+    def test_clear_without_multiprocess(self):
+        registry = CollectorRegistry()
+        counter = Counter('c', 'help', labelnames=['label'], registry=registry)
