+  describe "disclosure_button/1" do
+    test "default" do
+      assigns = %{}
+
+      html =
+        parse_heex(~H"""
+        <Doggo.disclosure_button controls="data-table">
+          Data Table
+        </Doggo.disclosure_button>
+        """)
+
+      button = find_one(html, "button:root")
+      assert attribute(button, "type") == "button"
+      assert attribute(button, "aria-expanded") == "false"
+      assert attribute(button, "aria-controls") == "data-table"
+      assert text(button) == "Data Table"
+    end
+
+    test "declares required inputs" do
+      component = Doggo.__components__()[:disclosure_button]
+
+      assert Enum.any?(component.attrs, &(&1.name == :controls and &1.required))
+      assert Enum.any?(component.attrs, &(&1.name == :controls and &1.type == :string))
+      assert Enum.any?(component.slots, &(&1.name == :inner_block and &1.required))
+    end
+  end
