 #  ___________________________________________________________________________
 #
 import re
+import sys
+import warnings
 import pyomo.common.unittest as unittest
 from pyomo.common.tee import capture_output
+from pyomo.common.log import LoggingIntercept
 
 from pyomo.environ import SolverFactory
 from pyomo.scripting.driver_help import help_solvers, help_transformations
+from pyomo.scripting.pyomo_main import main
 
 
 class Test(unittest.TestCase):
+
+    def _run_main(self, args):
+        # Capture warnings emitted through logging, Python warnings, or the
+        # command-line streams. Returns their text and the SystemExit instance.
+        exit_exc = None
+        with warnings.catch_warnings(record=True) as caught:
+            warnings.simplefilter("always")
+            with LoggingIntercept() as LOG:
+                with capture_output() as STREAM:
+                    try:
+                        main(args=args)
+                    except SystemExit as e:
+                        exit_exc = e
+        output = (
+            LOG.getvalue()
+            + STREAM.getvalue()
+            + "\n".join(str(w.message) for w in caught)
+        )
+        return output, exit_exc
+
+    def test_pyomo_main_deprecation(self):
+        output, exit_exc = self._run_main(['--solvers=glpk', 'foo.py'])
+        self.assertIsNotNone(exit_exc)
+        self.assertIn("Running the 'pyomo' script with no subcommand", output)
+
+    def test_pyomo_main_defaults_to_solve(self):
+        # An old-style invocation with no subcommand is routed to 'solve'
+        # instead of being rejected as an unknown subcommand.
+        output, exit_exc = self._run_main(['--solver=glpk', '--help'])
+        self.assertIsNotNone(exit_exc)
+        self.assertIn('--solver', output)
+        self.assertIn("Running the 'pyomo' script with no subcommand", output)
+
+    def test_pyomo_main_uses_sys_argv(self):
+        old_argv = sys.argv
+        sys.argv = ['pyomo', '--solvers=glpk', 'foo.py']
+        try:
+            output, exit_exc = self._run_main(None)
+        finally:
+            sys.argv = old_argv
+        self.assertIsNotNone(exit_exc)
+        self.assertIn("Running the 'pyomo' script with no subcommand", output)
+
     def test_help_solvers(self):
         with capture_output() as OUT:
             help_solvers()
