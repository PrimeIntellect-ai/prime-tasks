+@pytest.mark.parametrize("dialect", ["bigquery"])
+def test_insert_without_into_keyword(dialect: str):
+    """
+    INTO is optional in BigQuery INSERT statement:
+        https://cloud.google.com/bigquery/docs/reference/standard-sql/dml-syntax#insert_statement
+    """
+    assert_table_lineage_equal(
+        "INSERT tab1 SELECT * FROM tab2",
+        {"tab2"},
+        {"tab1"},
+        dialect=dialect,
+    )
+    # the contract's example uses backtick-quoted, fully qualified table names
+    assert_table_lineage_equal(
+        "INSERT `project.dataset.table_2` SELECT * FROM `project.dataset.table_1`",
+        {"project.dataset.table_1"},
+        {"project.dataset.table_2"},
+        dialect=dialect,
+    )
+
