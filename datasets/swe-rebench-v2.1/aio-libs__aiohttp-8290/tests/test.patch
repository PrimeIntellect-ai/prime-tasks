+
+async def test_instantiation_with_invalid_timeout_value():
+    with pytest.raises(ValueError):
+        ClientSession(timeout=1)
+
+
+async def test_invalid_timeout_is_rejected_before_connector_creation(monkeypatch):
+    def unexpected_connector_creation(*args, **kwargs):
+        raise AssertionError("connector creation preceded timeout validation")
+
+    monkeypatch.setattr(client, "TCPConnector", unexpected_connector_creation)
+    with pytest.raises(ValueError):
+        ClientSession(timeout=1)
+
+
+async def test_invalid_timeout_does_not_leave_unclosed_session(caplog):
+    with pytest.raises(ValueError):
+        ClientSession(timeout=1)
+
+    gc.collect()
+    assert "Unclosed client session" not in caplog.text
