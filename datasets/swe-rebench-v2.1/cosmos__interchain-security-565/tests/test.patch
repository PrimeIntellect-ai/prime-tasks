+// TestSlashThrottlingUsesProviderPowerWithAssignedConsumerKey ensures slash
+// throttling accounts for provider voting power when the consumer uses a
+// different consensus key for the validator.
+func (s *CCVTestSuite) TestSlashThrottlingUsesProviderPowerWithAssignedConsumerKey() {
+	s.SetupTest()
+	s.SetupAllCCVChannels()
+	s.setupValidatorPowers()
+
+	providerKeeper := s.providerApp.GetProviderKeeper()
+	params := providertypes.DefaultParams()
+	params.SlashMeterReplenishFraction = "0.2"
+	providerKeeper.SetParams(s.providerCtx(), params)
+	providerKeeper.CheckForSlashMeterReplenishment(s.getCtxWithReplenishPeriodElapsed(s.providerCtx()))
+	s.Require().Equal(int64(800), providerKeeper.GetSlashMeter(s.providerCtx()).Int64())
+
+	validator, consumerKey := generateNewConsumerKey(s, 0)
+	err := providerKeeper.AssignConsumerKey(s.providerCtx(), s.getFirstBundle().Chain.ChainID, validator, consumerKey)
+	s.Require().NoError(err)
+	consumerPubKey, err := tmencoding.PubKeyFromProto(consumerKey)
+	s.Require().NoError(err)
+	consumerAddress := consumerPubKey.Address()
+	providerAddress := s.getValConsAddr(*s.providerChain.Vals.Validators[0])
+	s.Require().NotEqual(providerAddress, consumerAddress)
+
+	s.setDefaultValSigningInfo(*s.providerChain.Vals.Validators[0])
+	packet := s.constructSlashPacketFromConsumer(s.getFirstBundle(), *s.providerChain.Vals.Validators[0], stakingtypes.Downtime, 1)
+	var packetData ccvtypes.SlashPacketData
+	ccvtypes.ModuleCdc.MustUnmarshalJSON(packet.Data, &packetData)
+	packetData.Validator.Address = consumerAddress
+	packet.Data = packetData.GetBytes()
+	sendOnConsumerRecvOnProvider(s, s.getFirstBundle().Path, packet)
+
+	s.Require().Equal(int64(-200), providerKeeper.GetSlashMeter(s.providerCtx()).Int64())
+	s.Require().True(s.providerApp.GetE2eStakingKeeper().GetAllValidators(s.providerCtx())[0].IsJailed())
+}
