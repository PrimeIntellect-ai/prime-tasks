+func TestIssue174(t *testing.T) {
+	// https://github.com/microcosm-cc/bluemonday/issues/174
+	//
+	// Allow all URL schemes
+	p := UGCPolicy()
+	matcher, ok := interface{}(p).(interface {
+		AllowURLSchemesMatching(*regexp.Regexp) *Policy
+	})
+	if !ok {
+		t.Fatal("policy cannot match URL schemes")
+	}
+	p = matcher.AllowURLSchemesMatching(regexp.MustCompile(`.+`))
+
+	input := `<a href="cbthunderlink://somebase64string"></a>
+<a href="matrix:roomid/psumPMeAfzgAeQpXMG:feneas.org?action=join"></a>`
+	out := p.Sanitize(input)
+	for _, href := range []string{
+		"cbthunderlink://somebase64string",
+		"matrix:roomid/psumPMeAfzgAeQpXMG:feneas.org?action=join",
+	} {
+		if !strings.Contains(out, `href="`+href+`"`) {
+			t.Errorf("sanitization did not retain URL %q: %s", href, out)
+		}
+	}
+}
