+    {
+        // Given
+        var console = new TestConsole();
+        var text = new Text("foo pneumonoultramicroscopicsilicovolcanoconiosis bar qux")
+            .Overflow(Overflow.Crop);
+        var panel = new Panel(text)
+        {
+            Width = 20,
+        };
+
+        // When
+        console.Write(panel);
+
+        // Then
+        return Verifier.Verify(console.Output);
+    }
