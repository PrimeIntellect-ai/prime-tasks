+fn directory_contains_file_with_contents(directory: &Path, expected: &str) -> bool {
+    fs::read_dir(directory).unwrap().any(|entry| {
+        let path = entry.unwrap().path();
+        if path.is_dir() {
+            directory_contains_file_with_contents(&path, expected)
+        } else {
+            fs::read_to_string(path)
+                .map(|contents| contents == expected)
+                .unwrap_or(false)
+        }
+    })
+}
