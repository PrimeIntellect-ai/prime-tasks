+#[test]
+fn download_filename_with_parent_directory_traversal() {
+    let root = tempdir().unwrap();
+    let dir = root.path().join("downloads");
+    fs::create_dir(&dir).unwrap();
+    let escape_name = "outside";
+    let escaped_path = root.path().join(escape_name);
+    let header = format!(r#"attachment; filename="../{escape_name}""#);
+    let server = server::http(move |_req| {
+        let header = header.clone();
+        async move {
+            hyper::Response::builder()
+                .header("Content-Disposition", header)
+                .body("file".into())
+                .unwrap()
+        }
+    });
+
+    get_command()
+        .args(["--download", &server.base_url()])
+        .current_dir(&dir)
+        .assert()
+        .success();
+
+    assert!(
+        !escaped_path.exists(),
+        "download wrote outside its download directory"
+    );
+    assert!(directory_contains_file_with_contents(&dir, "file"));
 }
 
