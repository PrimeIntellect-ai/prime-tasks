+func TestUseProviderSecretAssumeRoleWithDeprecatedARN(t *testing.T) {
+	profile := "default"
+	roleARN := "test-arn-deprecated"
+	credentials := []byte(fmt.Sprintf(awsCredentialsFileFormat, profile, "testID", "testSecret"))
+	pc := &v1beta1.ProviderConfig{Spec: v1beta1.ProviderConfigSpec{AssumeRoleARN: &roleARN}}
+
+	config, err := UseProviderSecretAssumeRole(context.Background(), credentials, profile, "us-west-2", pc)
+	if err != nil {
+		t.Fatalf("expected role assumption to accept the deprecated ARN configuration, got error: %v", err)
+	}
+	if config == nil || config.Credentials == nil {
+		t.Fatal("expected role assumption to produce AWS credentials")
+	}
+}
