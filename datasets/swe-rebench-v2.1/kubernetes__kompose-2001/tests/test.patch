+// Two env_file entries with the same base name but different paths must
+// produce separate ConfigMaps whose names retain the distinguishing paths.
+func TestEnvFilePathsProduceDistinctConfigMaps(t *testing.T) {
+	tmpDir := t.TempDir()
+
+	oneDir := filepath.Join(tmpDir, "one")
+	twoDir := filepath.Join(tmpDir, "two")
+	if err := os.MkdirAll(oneDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(twoDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(oneDir, "custom.env"), []byte("FOO=one\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(twoDir, "custom.env"), []byte("BAR=two\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	composeFile := filepath.Join(tmpDir, "docker-compose.yaml")
+	if err := os.WriteFile(composeFile, []byte("services:\n  nginx:\n    image: nginx\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	service := kobject.ServiceConfig{
+		ContainerName: "nginx",
+		Image:         "nginx",
+		EnvFile:       []string{"one/custom.env", "two/custom.env"},
+	}
+
+	komposeObject := kobject.KomposeObject{
+		ServiceConfigs: map[string]kobject.ServiceConfig{
+			"nginx": service,
+		},
+	}
+
+	k := Kubernetes{}
+	objects, err := k.Transform(komposeObject, kobject.ConvertOptions{CreateD: true, InputFiles: []string{composeFile}})
+	if err != nil {
+		t.Fatal(errors.Wrap(err, "k.Transform failed"))
+	}
+
+	configMaps := map[string]*api.ConfigMap{}
+	for _, obj := range objects {
+		if cm, ok := obj.(*api.ConfigMap); ok {
+			configMaps[cm.Name] = cm
+		}
+	}
+
+	if len(configMaps) != 2 {
+		t.Fatalf("expected 2 distinct ConfigMaps for two env files with the same name, got %d: %v", len(configMaps), configMaps)
+	}
+	nameForData := map[string]string{}
+	for _, cm := range configMaps {
+		for key := range cm.Data {
+			nameForData[key] = cm.Name
+		}
+	}
+	if !strings.Contains(nameForData["FOO"], "one") || !strings.Contains(nameForData["BAR"], "two") {
+		t.Errorf("expected ConfigMap names to include their distinct directory paths, got %v", nameForData)
+	}
+
+	// Each env file's data must be preserved in its own ConfigMap.
+	values := map[string]string{}
+	for _, cm := range configMaps {
+		for key, value := range cm.Data {
+			values[key] = value
+		}
+	}
+	if values["FOO"] != "one" || values["BAR"] != "two" {
+		t.Errorf("expected both env files to be rendered, got %v", values)
+	}
+}
