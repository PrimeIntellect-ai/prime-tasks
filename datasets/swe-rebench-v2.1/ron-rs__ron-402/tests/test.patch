+use ron::error::Error;
+use serde::{Deserialize, Serialize};
+
+#[derive(Serialize, Deserialize, Debug)]
+#[serde(rename = "Hello World")]
+struct InvalidStruct;
+
+#[derive(Serialize, Deserialize, Debug)]
+#[serde(rename = "")]
+struct EmptyStruct;
+
+#[derive(Serialize, Deserialize, PartialEq, Eq, Debug)]
+#[serde(rename = "Hello+World")]
+#[serde(deny_unknown_fields)]
+struct RawStruct {
+    #[serde(rename = "ab.cd-ef")]
+    field: bool,
+}
+
+#[derive(Serialize, Deserialize, PartialEq, Eq, Debug)]
+enum RawEnum {
+    #[serde(rename = "Hello-World")]
+    RawVariant,
+}
+
+#[test]
+fn test_invalid_identifiers() {
+    let ser = ron::ser::to_string_pretty(
+        &InvalidStruct,
+        ron::ser::PrettyConfig::default().struct_names(true),
+    );
+    assert!(format!("{:?}", ser.unwrap_err()).contains("InvalidIdentifier"));
+
+    let ser = ron::ser::to_string_pretty(
+        &EmptyStruct,
+        ron::ser::PrettyConfig::default().struct_names(true),
+    );
+    assert!(format!("{:?}", ser.unwrap_err()).contains("InvalidIdentifier"));
+
+    let de = ron::from_str::<InvalidStruct>("Hello World").unwrap_err();
+    assert!(matches!(de.code, Error::ExpectedDifferentStructName { .. }));
+
+    let de = ron::from_str::<EmptyStruct>("").unwrap_err();
+    assert!(matches!(de.code, Error::ExpectedUnit));
+
+    let de = ron::from_str::<RawStruct>("").unwrap_err();
+    assert!(matches!(de.code, Error::ExpectedNamedStructLike(_)));
+
+    let de = ron::from_str::<RawStruct>("Hello+World").unwrap_err();
+    let diagnostic = format!("{:?}", de.code);
+    assert!(diagnostic.contains("SuggestRawIdentifier"));
+    assert!(diagnostic.contains("Hello+World"));
+
+    let de = ron::from_str::<RawStruct>(
+        "r#Hello+World(
+        ab.cd-ef: true,
+    )",
+    )
+    .unwrap_err();
+    let diagnostic = format!("{:?}", de.code);
+    assert!(diagnostic.contains("SuggestRawIdentifier"));
+    assert!(diagnostic.contains("ab.cd-ef"));
+
+    let de = ron::from_str::<RawStruct>(
+        "r#Hello+World(
+        r#ab.cd+ef: true,
+    )",
+    )
+    .unwrap_err();
+    assert!(matches!(de.code, Error::NoSuchStructField { .. }));
+
+    let de = ron::from_str::<RawEnum>("Hello-World").unwrap_err();
+    let diagnostic = format!("{:?}", de.code);
+    assert!(diagnostic.contains("SuggestRawIdentifier"));
+    assert!(diagnostic.contains("Hello-World"));
+
+    let de = ron::from_str::<RawEnum>("r#Hello+World").unwrap_err();
+    assert!(matches!(de.code, Error::NoSuchEnumVariant { .. }));
+}
+
+#[test]
+fn test_raw_identifier_roundtrip() {
+    let val = RawStruct { field: true };
+
+    let ser =
+        ron::ser::to_string_pretty(&val, ron::ser::PrettyConfig::default().struct_names(true))
+            .unwrap();
+    assert!(ser.contains("r#Hello+World"));
+    assert!(ser.contains("r#ab.cd-ef"));
+
+    let de: RawStruct = ron::from_str(&ser).unwrap();
+    assert_eq!(de, val);
+
+    let val = RawEnum::RawVariant;
+
+    let ser = ron::ser::to_string(&val).unwrap();
+    assert!(ser.contains("r#Hello-World"));
+
+    let de: RawEnum = ron::from_str(&ser).unwrap();
+    assert_eq!(de, val);
+}
