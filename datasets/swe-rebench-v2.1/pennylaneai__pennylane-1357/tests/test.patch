+class TestNegativeChannelProbabilities:
+    """Negative values are outside the probability range of noise channels."""
+
+    @pytest.mark.parametrize(
+        "operation",
+        [
+            pytest.param(
+                lambda: channel.AmplitudeDamping(-0.1, wires=0).kraus_matrices,
+                id="amplitude-damping-gamma",
+            ),
+            pytest.param(
+                lambda: channel.GeneralizedAmplitudeDamping(-0.1, 0.5, wires=0).kraus_matrices,
+                id="generalized-amplitude-damping-gamma",
+            ),
+            pytest.param(
+                lambda: channel.GeneralizedAmplitudeDamping(0.5, -0.1, wires=0).kraus_matrices,
+                id="generalized-amplitude-damping-p",
+            ),
+            pytest.param(
+                lambda: channel.PhaseDamping(-0.1, wires=0).kraus_matrices,
+                id="phase-damping-gamma",
+            ),
+            pytest.param(
+                lambda: channel.BitFlip(-0.1, wires=0).kraus_matrices,
+                id="bit-flip-p",
+            ),
+            pytest.param(
+                lambda: channel.PhaseFlip(-0.1, wires=0).kraus_matrices,
+                id="phase-flip-p",
+            ),
+            pytest.param(
+                lambda: channel.DepolarizingChannel(-0.1, wires=0).kraus_matrices,
+                id="depolarizing-channel-p",
+            ),
+            pytest.param(
+                lambda: channel.ResetError(-0.1, 0.0, wires=0).kraus_matrices,
+                id="reset-error-p0",
+            ),
+            pytest.param(
+                lambda: channel.ResetError(0.0, -0.1, wires=0).kraus_matrices,
+                id="reset-error-p1",
+            ),
+        ],
+    )
+    def test_negative_probability_is_rejected(self, operation):
+        with pytest.raises(Exception):
+            operation()
+
 
