+// TestInstallOutputDirWithReleaseNameCLI verifies that the helm template command
+// can place a release's rendered output under a release-specific path so that
+// renders of different releases do not collide in the same output directory.
+func TestInstallOutputDirWithReleaseNameCLI(t *testing.T) {
+	dir, err := ioutil.TempDir("", "output-dir")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+
+	repoRoot, err := filepath.Abs(filepath.Join("..", ".."))
+	if err != nil {
+		t.Fatal(err)
+	}
+	chartPath := filepath.Join(repoRoot, "pkg", "chartutil", "testdata", "subpop", "charts", "subchart1")
+
+	releaseNames := []string{"release-one", "release-two"}
+	for _, releaseName := range releaseNames {
+		cmd := exec.Command("go", "run", "helm.sh/helm/v3/cmd/helm", "template", releaseName, chartPath, "--output-dir", dir, "--release-name")
+		cmd.Dir = repoRoot
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("helm template failed for release %q: %v\n%s", releaseName, err, out)
+		}
+	}
+
+	for _, releaseName := range releaseNames {
+		expected := filepath.Join(dir, releaseName, "subchart1", "templates", "service.yaml")
+		if _, err := os.Stat(expected); err != nil {
+			t.Errorf("expected rendered file at %s: %v", expected, err)
+		}
+	}
+}
