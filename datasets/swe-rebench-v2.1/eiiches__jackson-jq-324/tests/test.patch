+package net.thisptr.jackson.jq.extra.functions;
+
+import java.util.List;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.node.TextNode;
+import net.thisptr.jackson.jq.JsonQuery;
+import net.thisptr.jackson.jq.Scope;
+import net.thisptr.jackson.jq.Versions;
+import net.thisptr.jackson.jq.exception.JsonQueryException;
+import net.thisptr.jackson.jq.extra.TestUtils;
+import net.thisptr.jackson.jq.module.loaders.BuiltinModuleLoader;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+public class Uuid35FunctionTest {
+
+    @Test
+    public void testUuid5() throws JsonQueryException {
+        List<JsonNode> results = TestUtils.runQuery("extras::uuid5(\"6ba7b810-9dad-11d1-80b4-00c04fd430c8\")", TextNode.valueOf("example.com"), Versions.JQ_1_6);
+        assertThat(results).containsExactly(TextNode.valueOf("cfbff0d1-9375-5685-968c-48ce8b15ae17"));
+    }
+
+    @Test
+    public void testUuid5ProblemStatementExample() throws JsonQueryException {
+        List<JsonNode> results = TestUtils.runQuery("extras::uuid5(\"2eb04e17-176e-4ba1-95b5-05834ca864d7\")", TextNode.valueOf("name"), Versions.JQ_1_6);
+        assertThat(results).containsExactly(TextNode.valueOf("52f527cc-e264-50b3-9bb1-15917606a90e"));
+    }
+    @Test
+    public void testUuid5IsNotAvailableInRootScope() {
+        Scope rootScope = Scope.newEmptyScope();
+        rootScope.setModuleLoader(BuiltinModuleLoader.getInstance());
+        assertThatThrownBy(() -> JsonQuery.compile("uuid5(\"2eb04e17-176e-4ba1-95b5-05834ca864d7\")", Versions.JQ_1_6)
+                .apply(rootScope, TextNode.valueOf("name"), ignored -> {}))
+                .isInstanceOf(JsonQueryException.class);
+    }
+
+}
