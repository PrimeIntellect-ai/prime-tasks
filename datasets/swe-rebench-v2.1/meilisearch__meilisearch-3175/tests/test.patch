 pub fn default_settings(dir: impl AsRef<Path>) -> Opt {
+    // Configure the dump directory through the public `--dump-dir` option so that this helper
+    // does not depend on the internal field name. When the option is not available (unfixed
+    // code), fall back to the defaults.
+    let dump_dir = dir.as_ref().join("dumps");
+    let parsed = Opt::try_parse_from(["meilisearch", "--dump-dir", dump_dir.to_str().unwrap()])
+        .unwrap_or_else(|_| Parser::parse_from(None as Option<&str>));
     Opt {
         db_path: dir.as_ref().join("db"),
-        dumps_dir: dir.as_ref().join("dump"),
         env: "development".to_owned(),
         #[cfg(all(not(debug_assertions), feature = "analytics"))]
         no_analytics: true,
@@ -199,6 +204,77 @@ pub fn default_settings(dir: impl AsRef<Path>) -> Opt {
         },
         #[cfg(feature = "metrics")]
         enable_metrics_route: true,
-        ..Parser::parse_from(None as Option<&str>)
+        ..parsed
+    }
+}
+
+#[cfg(test)]
+mod dump_dir_rename {
+    use super::*;
+
+    /// The binary option accepts `--dump-dir` and uses its supplied path.
+    #[test]
+    fn cli_option_is_renamed() {
+        let temp = tempfile::tempdir().unwrap();
+        let dump_dir = temp.path().join("cli-dumps");
+        let db_path = temp.path().join("db");
+        let options = Opt::try_parse_from([
+            "meilisearch",
+            "--dump-dir",
+            dump_dir.to_str().unwrap(),
+            "--db-path",
+            db_path.to_str().unwrap(),
+        ])
+        .unwrap();
+        setup_meilisearch(&options).unwrap();
+        assert!(dump_dir.is_dir(), "the directory given to `--dump-dir` should be used");
+    }
+
+    /// The environment variable `MEILI_DUMP_DIR` selects the dump directory.
+    #[test]
+    fn environment_variable_is_renamed() {
+        let temp = tempfile::tempdir().unwrap();
+        let new_dir = temp.path().join("env-dumps");
+        let db_path = temp.path().join("db");
+        temp_env::with_vars(
+            vec![
+                ("MEILI_DUMP_DIR", Some(new_dir.to_str().unwrap())),
+                ("MEILI_DB_PATH", Some(db_path.to_str().unwrap())),
+            ],
+            || {
+                let options = Opt::try_parse_from(["meilisearch"]).unwrap();
+                setup_meilisearch(&options).unwrap();
+                assert!(new_dir.is_dir(), "`MEILI_DUMP_DIR` should be used");
+            },
+        );
+    }
+
+    /// The configuration file setting `dump_dir` selects the dump directory.
+    #[test]
+    fn config_file_setting_is_renamed() {
+        let temp = tempfile::tempdir().unwrap();
+        let dump_dir = temp.path().join("cfg-dumps");
+        let db_path = temp.path().join("db");
+        let config = format!(
+            "dump_dir = {:?}\ndb_path = {:?}\n",
+            dump_dir.to_str().unwrap(),
+            db_path.to_str().unwrap(),
+        );
+        let options: Opt = toml::from_str(&config).unwrap();
+        setup_meilisearch(&options).unwrap();
+        assert!(dump_dir.is_dir(), "the directory given to `dump_dir` should be used");
+    }
+
+    /// The default configuration file shipped with the repository must use the renamed setting.
+    #[test]
+    fn default_config_file_uses_renamed_setting() {
+        let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../config.toml");
+        let content = std::fs::read_to_string(path).unwrap();
+        assert!(
+            content.contains("dump_dir"),
+            "the default config file should use the `dump_dir` setting"
+        );
+        // The shipped default configuration must remain loadable.
+        let _: Opt = toml::from_str(&content).unwrap();
     }
 }
