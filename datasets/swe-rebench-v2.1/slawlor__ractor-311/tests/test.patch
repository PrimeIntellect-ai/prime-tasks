@@ -1564,3 +1564,86 @@ async fn draining_children_will_shutdown_parent_too() {
     // Child's post-stop should have been called.
     assert_eq!(1, flag.load(Ordering::Relaxed));
 }
+
+#[crate::concurrency::test]
+#[tracing_test::traced_test]
+async fn get_children_is_non_destructive() {
+    struct Child;
+    struct Supervisor;
+
+    #[cfg_attr(feature = "async-trait", crate::async_trait)]
+    impl Actor for Child {
+        type Msg = ();
+        type State = ();
+        type Arguments = ();
+        async fn pre_start(
+            &self,
+            _this_actor: ActorRef<Self::Msg>,
+            _: (),
+        ) -> Result<Self::State, ActorProcessingErr> {
+            Ok(())
+        }
+    }
+
+    #[cfg_attr(feature = "async-trait", crate::async_trait)]
+    impl Actor for Supervisor {
+        type Msg = ();
+        type State = ();
+        type Arguments = ();
+        async fn pre_start(
+            &self,
+            _this_actor: ActorRef<Self::Msg>,
+            _: (),
+        ) -> Result<Self::State, ActorProcessingErr> {
+            Ok(())
+        }
+    }
+
+    let (supervisor_ref, s_handle) = Actor::spawn(None, Supervisor, ())
+        .await
+        .expect("Supervisor panicked on startup");
+
+    let supervisor_cell: ActorCell = supervisor_ref.clone().into();
+
+    let mut child_ids = Vec::new();
+    let mut child_handles = Vec::new();
+    for _ in 0..3 {
+        let (child_ref, c_handle) =
+            Actor::spawn_linked(None, Child, (), supervisor_cell.clone())
+                .await
+                .expect("Child panicked on startup");
+        child_ids.push(child_ref.get_id());
+        child_handles.push(c_handle);
+    }
+
+    // Wait until all the children are linked to the supervisor
+    periodic_check(
+        || supervisor_ref.get_children().len() == 3,
+        Duration::from_secs(5),
+    )
+    .await;
+
+    // Retrieving the children must not modify the supervision tree, so
+    // repeated calls return the same set of linked children.
+    let first = supervisor_ref.get_children();
+    let second = supervisor_ref.get_children();
+
+    assert_eq!(3, first.len());
+    assert_eq!(first.len(), second.len());
+
+    let mut first_ids: Vec<_> = first.iter().map(|c| c.get_id()).collect();
+    let mut second_ids: Vec<_> = second.iter().map(|c| c.get_id()).collect();
+    let mut expected_ids = child_ids.clone();
+    first_ids.sort();
+    second_ids.sort();
+    expected_ids.sort();
+    assert_eq!(expected_ids, first_ids);
+    assert_eq!(first_ids, second_ids);
+
+    // Cleanup
+    supervisor_ref.stop(None);
+    s_handle.await.unwrap();
+    for handle in child_handles {
+        handle.await.unwrap();
+    }
+}
