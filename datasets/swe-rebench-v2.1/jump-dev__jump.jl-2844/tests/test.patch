+function test_Plural_returns()
+    model = Model()
+    vars = @variables(model, begin
+        x
+        y[1:2]
+    end)
+    @test collect(vars) == [x, y]
+    eqs = @constraints(model, begin
+        E_x, x == 0
+        E_y[i = 1:2], y[i] == 0
+    end)
+    @test collect(eqs) == [E_x, E_y]
+    unnamed_eqs = @constraints(model, begin
+        x <= 1
+        E_y2, y[1] <= 1
+    end)
+    @test length(unnamed_eqs) == 2
+    @test unnamed_eqs[1] isa JuMP.ConstraintRef
+    @test unnamed_eqs[2] == E_y2
+    nl_eqs = @NLconstraints(model, begin
+        NL_x, x == 0
+        NL_y[i = 1:2], y[i] == 0
+    end)
+    @test collect(nl_eqs) == [NL_x, NL_y]
+    nl_parameters = @NLparameters(model, begin
+        a == 1
+        b[i = 1:2] == i
+    end)
+    @test collect(nl_parameters) == [a, b]
+    expressions = @expressions(model, begin
+        expr_x, x + 1
+        expr_y[i = 1:2], x + y[i]
+    end)
+    @test collect(expressions) == [expr_x, expr_y]
+    nl_expressions = @NLexpressions(model, begin
+        nl_expr_x, x^2
+        nl_expr_y[i = 1:2], x * y[i]
+    end)
+    @test collect(nl_expressions) == [nl_expr_x, nl_expr_y]
+    sd_constraints = @SDconstraints(model, begin
+        S_x, [x 0; 0 1] ⪰ 0
+        S_y, [y[1] 0; 0 1] ⪰ 0
+    end)
+    @test collect(sd_constraints) == [S_x, S_y]
+    return
+end
