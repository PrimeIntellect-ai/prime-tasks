+async function onceResolvesWithPredicate(eventNames, predicate, emissions, expected) {
+	for (const predicateArgument of predicateArgumentForms(predicate)) {
+		const emitter = new Emittery();
+		let promise;
+
+		try {
+			promise = emitter.once(eventNames, predicateArgument);
+		} catch {
+			continue;
+		}
+
+		for (const [eventName, data] of emissions) {
+			await emitter.emit(eventName, data);
+		}
+
+		const result = await Promise.race([
+			promise.then(value => ({settled: true, value}), () => ({settled: true})),
+			delay(25).then(() => ({settled: false})),
+		]);
+
+		if (result.settled && result.value === expected) {
+			return result.value;
+		}
+
+		promise.off?.();
+	}
+}
