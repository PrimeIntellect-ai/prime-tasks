+module veryl_testcase_Module46;
+    logic          a;
+    logic [10-1:0] b;
+    logic [10-1:0] c;
+    logic [10-1:0] d;
+    logic [10-1:0] e;
+
+    always_ff @ (posedge a) begin
+        logic [10-1:0] x;
+        x = 1;
+        d <= 1;
+        b <= x * 1;
+    end
+
+    always_comb begin
+        logic [10-1:0] y;
+        y = 1;
+        e = 1;
+        c = y * 1;
+    end
+
+    function automatic logic [10-1:0] FuncA(
+        input  logic [10-1:0] a,
+        output logic [10-1:0] b,
+        ref    logic [10-1:0] c
+    ) ;
+        int unsigned d;
+        c = a / 1;
+        d = 1;
+        b = a + 1 + d;
+        return a + 2;
+    endfunction
+endmodule
