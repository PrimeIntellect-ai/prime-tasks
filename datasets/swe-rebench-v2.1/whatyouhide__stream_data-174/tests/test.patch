index 9130431..76ab4de 100644
--- a/test/stream_data_test.exs
+++ b/test/stream_data_test.exs
@@ -241,6 +241,24 @@ defmodule StreamDataTest do
     end
   end
 
+  test "repeatedly/1 invokes its function for each generated value" do
+    counter = :atomics.new(1, [])
+    data = repeatedly(fn -> :atomics.add_get(counter, 1, 1) end)
+
+    assert Enum.take(data, 5) == [1, 2, 3, 4, 5]
+  end
+
+  test "repeatedly/1 does not shrink generated values" do
+    data = repeatedly(fn -> :value end)
+
+    assert {:error, metadata} =
+             StreamData.check_all(data, [initial_seed: :os.timestamp(), max_runs: 1], fn value ->
+               {:error, value}
+             end)
+
+    assert metadata.nodes_visited == 0
+  end
+
   property "boolean/0" do
     check all bool <- boolean() do
       assert is_boolean(bool)
