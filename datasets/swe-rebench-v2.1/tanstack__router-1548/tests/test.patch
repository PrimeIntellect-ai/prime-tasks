+describe('a redirect without "to" updates the current route params', () => {
+  it('resolves to the updated pathname on the same route', async () => {
+    const rootRoute = createRootRoute()
+    const postsRoute = createRoute({
+      getParentRoute: () => rootRoute,
+      path: '/posts',
+    })
+    const postRoute = createRoute({
+      getParentRoute: () => postsRoute,
+      path: '/$slug',
+      beforeLoad: ({ params }: any) => {
+        if (params.slug === 'tanner') {
+          throw redirect({ params: { slug: 'tkdodo' } } as any)
+        }
+      },
+    })
+    const router = createRouter({
+      routeTree: rootRoute.addChildren([postsRoute.addChildren([postRoute])]),
+      history: createMemoryHistory({ initialEntries: ['/posts/tanner'] }),
+    })
+    router.isServer = true
+
+    await router.load()
+
+    expect(router.state.redirect?.href).toBe('/posts/tkdodo')
+  })
+})
