+describe('router.navigate without "to" updates browser history', () => {
+  it('reflects the updated path param in the browser history', async () => {
+    const history = createMemoryHistory({ initialEntries: ['/posts/tanner'] })
+    const { router } = createTestRouter(history)
+
+    await router.load()
+
+    expect(history.location.pathname).toBe('/posts/tanner')
+
+    const historyLocations: Array<string> = []
+    const unsubscribe = history.subscribe(() => {
+      historyLocations.push(history.location.pathname)
+    })
+
+    await router.navigate({ params: { slug: 'tkdodo' } })
+    await router.invalidate()
+
+    unsubscribe()
+
+    // The browser history was updated to the new location...
+    expect(history.location.pathname).toBe('/posts/tkdodo')
+    // ...the router's internal state agrees...
+    expect(router.state.location.pathname).toBe('/posts/tkdodo')
+    // ...and a history change was actually emitted
+    expect(historyLocations).toContain('/posts/tkdodo')
+  })
+})
