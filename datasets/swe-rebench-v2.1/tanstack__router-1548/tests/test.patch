+describe('router.navigate without "to" keeps the route component hierarchy', () => {
+  it('keeps the same matched routes when only a path param changes', async () => {
+    const { router } = createTestRouter(
+      createMemoryHistory({ initialEntries: ['/p/router/v1/react'] }),
+    )
+
+    await router.load()
+
+    const matchedRouteIdsBefore = router.state.matches.map((m) => m.routeId)
+
+    await router.navigate({ params: { version: 'v3' } })
+    await router.invalidate()
+
+    expect(router.state.location.pathname).toBe('/p/router/v3/react')
+    expect(router.state.matches.map((m) => m.routeId)).toEqual(
+      matchedRouteIdsBefore,
+    )
+  })
+})
