+package day58
+
+import (
+	"testing"
+	"time"
+)
+
+var day58ProblemCases = []struct {
+	sorted   []int
+	target   int
+	expected int
+}{
+	{[]int{13, 18, 25, 2, 8, 10}, 8, 4},
+	{[]int{13, 18, 25, 27, 2, 8, 10}, 8, 5},
+	{[]int{13, 18, 25, 27, 2, 8, 10}, 18, 1},
+	{[]int{13, 18, 25, 27, 2, 8, 10}, 14, -1},
+	{[]int{13, 18, 25, 27, 30, 36, 54, 100, 2}, 2, 8},
+	{[]int{13, 18, 25, 27, 30, 36, 54, 100, 2}, 1, -1},
+	{[]int{13, 18, 25, 27, 30, 36, 54, 100, 2}, 13, 0},
+}
+
+func TestDay58RotatedLookupExamples(t *testing.T) {
+	t.Parallel()
+	for _, tc := range day58ProblemCases {
+		if index := IndexSortedRotated(tc.sorted, tc.target); index != tc.expected {
+			t.Errorf("Expected %v got %v", tc.expected, index)
+		}
+	}
+}
+
+// day58RotateCopy returns a copy of a rotated left by k positions.
+func day58RotateCopy(a []int, k int) []int {
+	n := len(a)
+	out := make([]int, n)
+	for i := 0; i < n; i++ {
+		out[i] = a[(i+k)%n]
+	}
+	return out
+}
+
+// TestDay58RotatedLookupLargeInputs checks the result on larger rotated arrays
+// for every element and for absent targets.
+func TestDay58RotatedLookupLargeInputs(t *testing.T) {
+	t.Parallel()
+	const n = 4096
+	base := make([]int, n)
+	for i := range base {
+		base[i] = i * 7
+	}
+	for _, k := range []int{0, 1, n / 3, n / 2, n - 1} {
+		rotated := day58RotateCopy(base, k)
+		for i, v := range rotated {
+			if got := IndexSortedRotated(rotated, v); got != i {
+				t.Fatalf("rotation %d: target %d expected index %d got %d", k, v, i, got)
+			}
+		}
+		if got := IndexSortedRotated(rotated, -1); got != -1 {
+			t.Fatalf("rotation %d: absent target expected -1 got %d", k, got)
+		}
+		if got := IndexSortedRotated(rotated, base[n-1]+7); got != -1 {
+			t.Fatalf("rotation %d: absent target expected -1 got %d", k, got)
+		}
+	}
+}
+
+// TestDay58RotatedLookupBeatsLinearScan verifies the contract requirement that the
+// lookup is faster than a linear scan. It compares the implementation against
+// a reference linear scan on the same machine and input, so the check is
+// independent of absolute hardware speed.
+func TestDay58RotatedLookupBeatsLinearScan(t *testing.T) {
+	const n = 1 << 21
+	base := make([]int, n)
+	for i := range base {
+		base[i] = i
+	}
+	rotated := day58RotateCopy(base, n/4)
+	target := rotated[n-1] // worst case for a linear scan: it must scan everything
+
+	// Reference linear scan, best of several runs.
+	linear := time.Duration(1) << 62
+	want := -1
+	for r := 0; r < 5; r++ {
+		start := time.Now()
+		want = -1
+		for i, v := range rotated {
+			if v == target {
+				want = i
+				break
+			}
+		}
+		if d := time.Since(start); d < linear {
+			linear = d
+		}
+	}
+
+	// Implementation under test, best of several runs.
+	fast := time.Duration(1) << 62
+	got := -1
+	for r := 0; r < 5; r++ {
+		start := time.Now()
+		got = IndexSortedRotated(rotated, target)
+		if d := time.Since(start); d < fast {
+			fast = d
+		}
+	}
+
+	if got != want {
+		t.Fatalf("expected index %d got %d", want, got)
+	}
+	if fast >= linear {
+		t.Fatalf("IndexSortedRotated took %v, which is not faster than a linear scan (%v)", fast, linear)
+	}
+}
+
+func BenchmarkDay58RotatedLookupExamples(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range day58ProblemCases {
+			IndexSortedRotated(tc.sorted, tc.target)
+		}
+	}
+}
