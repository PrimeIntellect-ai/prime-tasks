+function test_value_type()
+    for T in (Int, Float64, BigFloat)
+        model = GenericModel{T}()
+        @variable(model, x)
+        @test value_type(typeof(x)) == T
+        @test value_type(typeof(one(T) * x)) == T
+        @test value_type(typeof(one(T) * x * x)) == T
+        @test value_type(typeof(log(x))) == T
+    end
+    model = GenericModel{Float32}()
+    @variable(model, x)
+    @variable(model, y in ComplexPlane())
+    @test value_type(typeof(x)) == Float32
+    @test value_type(typeof(y)) == ComplexF32
+    return
+end
+
 end  # TestExpr
