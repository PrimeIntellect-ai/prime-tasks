+(deftest test-api-request-includes-version-and-authorization-headers
+  (testing "GitHub API requests include the pinned version and optional authorization headers"
+    (doseq [[options expected-authorization]
+            [[{} nil]
+             [{:github-token "hello"} "Bearer hello"]]]
+      (let [request-settings (atom nil)]
+        (with-redefs [http/get (fn [_url settings]
+                                 (reset! request-settings settings)
+                                 {:body "{\"license\": {\"name\": \"MIT License\"}}"})]
+          (g/api-get-license ["" "owner" "repo"] options rate-limits))
+        (let [headers (:headers @request-settings)
+              header-value (fn [wanted-name]
+                             (some (fn [[name value]]
+                                     (when (= wanted-name (str/lower-case name))
+                                       value))
+                                   headers))]
+          (is (= "2022-11-28" (header-value "x-github-api-version")))
+          (if expected-authorization
+            (is (= expected-authorization (header-value "authorization")))
+            (is (nil? (header-value "authorization")))))))))
