+import unittest
+
+from pypika.terms import Psuedocolumn
+
+
+class PseudocolumnsTest(unittest.TestCase):
+    def test_database_specific_terms_are_not_quoted(self):
+        for name in ('ROWNUM', 'SYSDATE', 'VendorSpecificTerm'):
+            with self.subTest(name=name):
+                self.assertEqual(name, Psuedocolumn(name).to_sql(quote_char='"'))
