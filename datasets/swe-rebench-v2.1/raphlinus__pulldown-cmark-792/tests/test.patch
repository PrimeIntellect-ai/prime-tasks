+
+#[test]
+fn issue_791_quoted_text_is_not_both_title_and_content() {
+    let original = r##"[foo]: https://example.com
+'[foo]'bar
+"##;
+    // Either reading is acceptable: the quoted text is paragraph text, or it is
+    // the link title. It must not be both at once.
+    let as_text = r##"<p>'<a href="https://example.com">foo</a>'bar</p>
+"##;
+    let as_title = r##"<p><a href="https://example.com" title="[foo]">foo</a>bar</p>
+"##;
+
+    let mut html = String::new();
+    pulldown_cmark::html::push_html(&mut html, pulldown_cmark::Parser::new(original));
+
+    assert!(
+        html == as_text || html == as_title,
+        "unexpected rendering: {html:?}"
+    );
+}
+
+#[test]
+fn issue_791_list_link_keeps_its_title() {
+    let original = r##"- [foo]: https://example.com
+'[foo]'
+[foo]
+"##;
+    let expected = r##"<ul>
+<li>
+<a href="https://example.com" title="[foo]">foo</a>
+</li>
+</ul>
+"##;
+    test_markdown_html(original, expected, false, false, false);
+}
