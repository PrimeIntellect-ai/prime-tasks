+    @Test
+    public void testLabelFetchingResolvesOrdinaryPropertyIds() throws Exception {
+        String manifestJson = TestingData.jsonFromFile("manifest/wikidata-manifest-v1.0.json");
+        Manifest manifest = ManifestParser.parse(manifestJson);
+        EntityCache.setEntityCache(manifest.getSiteIri(), new EntityCacheStub());
+        try {
+            QAWarningStore qaWarningStore = new QAWarningStore();
+            QAWarning qaWarning = new QAWarning("my-warning", "my-warning", Severity.WARNING, 1);
+            qaWarning.setProperty("example_property", Datamodel.makeWikidataPropertyIdValue("P6"));
+            qaWarningStore.addWarning(qaWarning);
+
+            EditInspector editInspector = new EditInspector(qaWarningStore, manifest, false);
+            editInspector.inspect(Collections.emptyList(), new WikibaseSchema());
+
+            Object resolvedProperty = qaWarning.getProperties().get("example_property");
+            assertTrue(resolvedProperty instanceof SuggestedPropertyIdValue);
+            String resolvedLabel = ((SuggestedPropertyIdValue) resolvedProperty).getLabel();
+            assertTrue(resolvedLabel != null && !resolvedLabel.isEmpty());
+        } finally {
+            EntityCache.removeEntityCache(manifest.getSiteIri());
+        }
+    }
+
