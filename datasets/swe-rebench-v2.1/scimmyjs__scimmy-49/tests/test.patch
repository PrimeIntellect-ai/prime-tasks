+        } finally {
+            name.subAttributes.splice(index, 0, honorificPrefix);
+            SCIMMY.Resources.User.ingress(() => {
+                throw new SCIMMY.Types.Error(501, null, "Method 'ingress' not implemented by resource 'User'");
+            });
+        }
+    });
