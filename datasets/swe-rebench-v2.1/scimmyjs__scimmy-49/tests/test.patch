+describe("SCIMMY.Schemas.User", () => {
+    it("should ignore sub-attributes that have been truncated from the user definition", () => {
+        const name = SCIMMY.Schemas.User.definition.attribute("name");
+        const index = name.subAttributes.findIndex(a => a.name === "honorificPrefix");
+        const honorificPrefix = name.subAttributes[index];
+
+        name.truncate("honorificPrefix");
+
+        try {
+            let result;
+            assert.doesNotThrow(() => (result = SCIMMY.Schemas.User.definition.coerce({
+                userName: "elenafadel",
+                name: {givenName: "Jacklyn", honorificPrefix: "Mrs."}
+            })), "Complex attribute coercion rejected a value containing a truncated sub-attribute");
+            assert.ok(!("honorificPrefix" in result.name),
+                "Complex attribute coercion did not ignore a truncated sub-attribute");
+            assert.strictEqual(result.name.givenName, "Jacklyn",
+                "Complex attribute coercion did not retain declared sub-attribute values");
+        } finally {
+            name.subAttributes.splice(index, 0, honorificPrefix);
+        }
+    });
+
+    it("should ignore truncated sub-attributes when processing the reported user creation input", async () => {
+        const definition = SCIMMY.Schemas.User.definition;
+        const name = definition.attribute("name");
+        const index = name.subAttributes.findIndex(a => a.name === "honorificPrefix");
+        const honorificPrefix = name.subAttributes[index];
+        const input = {
+            addresses: [{
+                country: "Philippines",
+                streetAddress: "870 McLaughlin Turnpike",
+                formatted: "Suite 431 1780 Albert Green, Holliefort, NE 20440-9954",
+                postalCode: "40331",
+                locality: "Tanikaport",
+                primary: true
+            }],
+            displayName: "Lavonda Runolfsdottir",
+            nickName: "Sherman Wadd Evver",
+            externalId: "travis.spinka",
+            active: true,
+            userName: "elenafadel",
+            title: "Forward Creative Director",
+            phoneNumbers: [{value: "818-532-0271", primary: true}],
+            emails: [{value: "joya.considine@opensource.suvera.dev", primary: true}],
+            password: "garth.yost",
+            schemas: ["urn:ietf:params:scim:schemas:core:2.0:User"],
+            name: {
+                formatted: "Cathrine Gleason",
+                familyName: "Becker",
+                givenName: "Jacklyn",
+                honorificPrefix: "Mrs."
+            }
+        };
+
+        definition.truncate("name.honorificPrefix");
+        SCIMMY.Resources.User.ingress((resource, user) => ({...user, id: "created-user"}));
