+func TestUse(t *testing.T) {
+	require := require.New(t)
+	e := newEngine(t)
+
+	// Using a database that does not exist fails.
+	_, _, err := e.Query(newCtx(), "USE bar")
+	require.Error(err)
+
+	// Using an existing database succeeds and produces no result rows.
+	_, iter, err := e.Query(newCtx(), "USE foo")
+	require.NoError(err)
+
+	rows, err := sql.RowIterToRows(iter)
+	require.NoError(err)
+	require.Len(rows, 0)
+
+	// The database in use has changed: mytable only exists in the database
+	// that was in use before the USE statement.
+	_, _, err = e.Query(newCtx(), "SELECT * FROM mytable")
+	require.Error(err)
+}
