diff --git a/tests/Unit/MessageTest.php b/tests/Unit/MessageTest.php
new file mode 100644
index 0000000..efeb7b7
--- /dev/null
+++ b/tests/Unit/MessageTest.php
@@ -0,0 +1,66 @@
+<?php
+
+use DirectoryTree\ImapEngine\Connection\ImapConnection;
+use DirectoryTree\ImapEngine\Connection\Streams\FakeStream;
+use DirectoryTree\ImapEngine\Folder;
+use DirectoryTree\ImapEngine\Mailbox;
+use DirectoryTree\ImapEngine\Message;
+
+test('it moves message using MOVE when capable', function () {
+    $mailbox = Mailbox::make([
+        'username' => 'foo',
+        'password' => 'bar',
+    ]);
+
+    $mailbox->connect(ImapConnection::fake([
+        '* OK Welcome to IMAP',
+        'TAG1 OK Logged in',
+        '* CAPABILITY IMAP4rev1 STARTTLS MOVE AUTH=PLAIN',
+        'TAG2 OK CAPABILITY completed',
+        'TAG3 OK MOVE completed',
+    ]));
+
+    $folder = new Folder($mailbox, 'INBOX', [], '/');
+
+    $message = new Message($folder, 1, [], 'header', 'body');
+
+    $message->move('INBOX.Sent');
+})->throwsNoExceptions();
+
+test('it moves message with UIDPLUS when incapable of MOVE', function () {
+    $stream = new class extends FakeStream {
+        public array $writes = [];
+
+        public function fwrite(string $data): int|false
+        {
+            $this->writes[] = $data;
+
+            return parent::fwrite($data);
+        }
+    };
+    $stream->open();
+    $stream->feed([
+        '* OK Welcome to IMAP',
+        'TAG1 OK Logged in',
+        '* CAPABILITY IMAP4rev1 STARTTLS UIDPLUS AUTH=PLAIN',
+        'TAG2 OK CAPABILITY completed',
+        'TAG3 OK COPY completed',
+        'TAG4 OK STORE completed',
+    ]);
+
+    $mailbox = Mailbox::make([
+        'username' => 'foo',
+        'password' => 'bar',
+    ]);
+    $mailbox->connect(new ImapConnection($stream));
+
+    $folder = new Folder($mailbox, 'INBOX', [], '/');
+    $message = new Message($folder, 1, [], 'header', 'body');
+
+    $message->move('INBOX.Sent');
+
+    $commands = implode('', $stream->writes);
+
+    expect($commands)->toContain('INBOX.Sent');
+    expect($commands)->toMatch('/STORE 1[^\r\n]*\\\\Deleted/');
+});
