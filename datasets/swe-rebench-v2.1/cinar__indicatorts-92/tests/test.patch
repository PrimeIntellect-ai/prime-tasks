+// Copyright (c) 2022 Onur Cinar. All Rights Reserved.
+// https://github.com/cinar/indicatorts
+
+import { deepStrictEqual, ok } from 'assert';
+import { ema } from '../trend/ema';
+import { defaultPercentagePriceOscillator } from './percentagePriceOscillator';
+
+describe('Percent Price Oscillator (PPO)', () => {
+  it('should be able to compute ppo', () => {
+    const prices: number[] = [];
+    for (let i = 0; i < 300; i++) {
+      prices.push(100 + 20 * Math.sin(i / 7) + 0.3 * i + 5 * Math.sin(i / 3.1));
+    }
+
+    const fastEma = ema(12, prices);
+    const slowEma = ema(26, prices);
+    const expectedPpo = fastEma.map(
+      (value, i) => ((value - slowEma[i]) / slowEma[i]) * 100
+    );
+    const expectedSignal = ema(9, expectedPpo);
+    const expectedHistogram = expectedPpo.map(
+      (value, i) => value - expectedSignal[i]
+    );
+
+    const actual = defaultPercentagePriceOscillator(prices);
+
+    deepStrictEqual(actual.ppo.length, prices.length);
+    deepStrictEqual(actual.signal.length, prices.length);
+    deepStrictEqual(actual.histogram.length, prices.length);
+
+    for (let i = 0; i < prices.length; i++) {
+      ok(
+        Math.abs(actual.histogram[i] - (actual.ppo[i] - actual.signal[i])) <
+          1e-9,
+        `histogram[${i}] should equal ppo[${i}] - signal[${i}]`
+      );
+    }
+
+    // The way the moving averages are seeded is not observable from the
+    // contract, so only the converged portion of the series is compared.
+    const start = 180;
+    for (let i = start; i < prices.length; i++) {
+      ok(
+        Math.abs(actual.ppo[i] - expectedPpo[i]) < 0.01,
+        `ppo[${i}] expected ${expectedPpo[i]} but got ${actual.ppo[i]}`
+      );
+      ok(
+        Math.abs(actual.signal[i] - expectedSignal[i]) < 0.01,
+        `signal[${i}] expected ${expectedSignal[i]} but got ${actual.signal[i]}`
+      );
+      ok(
+        Math.abs(actual.histogram[i] - expectedHistogram[i]) < 0.01,
+        `histogram[${i}] expected ${expectedHistogram[i]} but got ${actual.histogram[i]}`
+      );
+    }
+  });
+
+  it('should accept zero and negative price values', () => {
+    const prices = [
+      0, -5, 10, -3, 0, 7, -2, 4, 0, -1, 8, -6, 3, 0, 5, -4, 9, -7, 2, 6, -8,
+      1, 0, -9, 11, -10, 12, -11, 13, -12,
+    ];
+
+    const actual = defaultPercentagePriceOscillator(prices);
+
+    deepStrictEqual(actual.ppo.length, prices.length);
+    deepStrictEqual(actual.signal.length, prices.length);
+    deepStrictEqual(actual.histogram.length, prices.length);
+  });
+});
