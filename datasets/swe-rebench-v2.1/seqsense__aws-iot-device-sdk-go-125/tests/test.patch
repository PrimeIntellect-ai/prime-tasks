+func TestOnErrorForUnparseableMessage(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	s, cli := newTestShadow(t, ctx)
+
+	errorsReceived := make(chan error, 1)
+	s.OnError(func(err error) { errorsReceived <- err })
+	cli.Serve(&mqtt.Message{Topic: topic("get/rejected"), Payload: []byte("not-json")})
+
+	select {
+	case err := <-errorsReceived:
+		if err == nil {
+			t.Fatal("OnError received a nil error")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("OnError was not called for an unparseable message")
+	}
 }
