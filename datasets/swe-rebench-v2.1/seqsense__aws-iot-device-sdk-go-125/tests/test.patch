+func topic(operation string) string {
+	return "$aws/things/" + thingName + "/shadow/" + operation
+}
+
+func requestToken(payload []byte) (string, error) {
+	var req map[string]interface{}
+	if err := json.Unmarshal(payload, &req); err != nil {
+		return "", err
+	}
+	tok, _ := req["clientToken"].(string)
+	return tok, nil
+}
+
+func callOperation(s shadow.Shadow, method string, args ...interface{}) error {
+	methodValue := reflect.ValueOf(s).MethodByName(method)
+	values := make([]reflect.Value, len(args))
+	for i, arg := range args {
+		values[i] = reflect.ValueOf(arg)
+	}
+	for _, result := range methodValue.Call(values) {
+		if result.Type().Implements(reflect.TypeOf((*error)(nil)).Elem()) {
+			if result.IsNil() {
+				return nil
+			}
+			return result.Interface().(error)
 		}
+	}
+	return nil
+}
 
