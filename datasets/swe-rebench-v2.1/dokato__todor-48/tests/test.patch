--- a/tests/testthat/test_internal.R
+++ b/tests/testthat/test_internal.R
@@ -50,3 +50,32 @@ test_that("test clean_comments", {
   expect_match(p, "TODO abc abc")
 })
 
+
+test_that("inline HTML TODOs become markers on their source lines", {
+  file <- tempfile(fileext = ".Rmd")
+  on.exit(unlink(file))
+  writeLines(c(
+    "Ordinary prose before the marker.",
+    "Participants were followed up ( <!-- TODO capture this date --> )",
+    "Ordinary prose after the marker."
+  ), file)
+
+  captured <- NULL
+  original_sink <- get("build_rstudio_markers", envir = globalenv())
+  assign("build_rstudio_markers", function(markers) {
+    captured <<- markers
+    invisible(NULL)
+  }, envir = globalenv())
+  on.exit(assign("build_rstudio_markers", original_sink, envir = globalenv()),
+          add = TRUE)
+  todor(todo_types = "TODO", file = file)
+
+  matching <- Filter(function(marker) {
+    grepl("capture this date", marker$message, fixed = TRUE)
+  }, captured)
+  expect_length(matching, 1)
+  if (length(matching) == 1) {
+    expect_equal(matching[[1]]$line, 2)
+    expect_equal(matching[[1]]$file, file)
+  }
+})
