+def test_angstrom_aod():
+    """Test Angstrom turbidity model functions."""
+    aod550 = 0.15
+    aod1240 = 0.05
+    alpha = atmosphere.angstrom_alpha(aod550, 550, aod1240, 1240)
+    assert np.isclose(alpha, 1.3513924317859232)
+    aod700 = atmosphere.angstrom_aod_at_lambda(aod550, 550, alpha)
+    assert np.isclose(aod700, 0.10828110997681031)
+    # a caller-specified target wavelength other than the 700 nm default
+    aod500 = atmosphere.angstrom_aod_at_lambda(aod550, 550, alpha, 500)
+    assert np.isclose(aod500, 0.1706196396979338)
+    # converting to the second reference wavelength recovers its AOD
+    aod1240_back = atmosphere.angstrom_aod_at_lambda(aod550, 550, alpha, 1240)
+    assert np.isclose(aod1240_back, aod1240)
+
+
+def test_bird_hulstrom80_aod_bb():
+    """Test Bird_Hulstrom broadband AOD."""
+    aod380, aod500 = 0.22072480948195175, 0.1614279181106312
+    bird_hulstrom = atmosphere.bird_hulstrom80_aod_bb(aod380, aod500)
+    assert np.isclose(0.11738229553812768, bird_hulstrom)
+
+
+@pytest.mark.parametrize(
+    "aod1, lambda1, aod2, lambda2",
+    [(0.2, 400, 0.1, 800), (0.12, 500, 0.08, 750)],
+)
+def test_angstrom_alpha_general_inputs(aod1, lambda1, aod2, lambda2):
+    expected = -np.log(aod1 / aod2) / np.log(lambda1 / lambda2)
+    actual = atmosphere.angstrom_alpha(aod1, lambda1, aod2, lambda2)
+    assert np.isclose(actual, expected)
+
+
+@pytest.mark.parametrize("target", [None, 600.0])
+def test_angstrom_aod_at_lambda_general_inputs(target):
+    aod0, lambda0, alpha = 0.2, 400.0, 1.0
+    target_wavelength = 700.0 if target is None else target
+    expected = aod0 * (target_wavelength / lambda0) ** (-alpha)
+    if target is None:
+        actual = atmosphere.angstrom_aod_at_lambda(aod0, lambda0, alpha)
+    else:
+        actual = atmosphere.angstrom_aod_at_lambda(
+            aod0, lambda0, alpha, lambda1=target
+        )
+    assert np.isclose(actual, expected)
+
+
+def test_bird_hulstrom_aod_bb_general_inputs():
+    aod380, aod500 = 0.3, 0.2
+    expected = 0.27583 * aod380 + 0.35 * aod500
+    actual = atmosphere.bird_hulstrom80_aod_bb(aod380, aod500)
+    assert np.isclose(actual, expected)
+
+
+def _kasten96_lt_from_documented_contributions(airmass, water, aerosol):
+    clean_dry = -0.101 + 0.235 * airmass ** (-0.16)
+    water_depth = 0.112 * airmass ** (-0.55) * water ** 0.34
+    return (9.4 + 0.9 * airmass) * (clean_dry + water_depth + aerosol)
+
+
+@pytest.mark.parametrize(
+    "airmass, water, aerosol",
+    [(2.0, 1.0, 0.2), (2.0, 2.0, 0.2), (2.0, 1.0, 0.17),
+     (2.5, 1.7, 0.23), (3.25, 1.25, 0.31)],
+)
+def test_kasten96_lt_general_inputs_and_contributions(airmass, water, aerosol):
+    expected = _kasten96_lt_from_documented_contributions(
+        airmass, water, aerosol
+    )
+    actual = atmosphere.kasten96_lt(airmass, water, aerosol)
+    assert np.isclose(actual, expected)
+
+
+def test_kasten96_lt_accepts_molineaux_700_nm_aod():
+    aod550, alpha = 0.2, 1.1
+    aod700 = atmosphere.angstrom_aod_at_lambda(aod550, 550, alpha)
+    expected = _kasten96_lt_from_documented_contributions(2.0, 1.0, aod700)
+    actual = atmosphere.kasten96_lt(2.0, 1.0, aod700)
+    assert np.isclose(actual, expected)
