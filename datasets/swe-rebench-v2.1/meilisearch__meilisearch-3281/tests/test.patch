+
+fn parse_options(arguments: &[&str]) -> Result<Opt, clap::Error> {
+    Opt::try_parse_from(std::iter::once("meilisearch").chain(arguments.iter().copied()))
+}
+
+#[test]
+fn schedule_snapshot_cli_values() {
+    assert!(parse_options(&[]).is_ok());
+    assert!(parse_options(&["--schedule-snapshot"]).is_ok());
+    assert!(parse_options(&["--schedule-snapshot", "3600"]).is_ok());
+
+    assert!(parse_options(&["--snapshot-interval-sec", "3600"]).is_err());
+}
+
+/// Starts a server with the given snapshot arguments, waits a few seconds, and returns how many
+/// `snapshotCreation` tasks were registered by the runtime scheduler.
+async fn scheduled_snapshot_tasks(arguments: &[&str]) -> usize {
+    let temp = tempfile::tempdir().unwrap();
+    let snapshot_dir = tempfile::tempdir().unwrap();
+    let db_path = temp.path().join("db");
+    let dump_path = temp.path().join("dumps");
+
+    let mut args = vec![
+        "meilisearch",
+        "--db-path",
+        db_path.to_str().unwrap(),
+        "--dump-dir",
+        dump_path.to_str().unwrap(),
+        "--snapshot-dir",
+        snapshot_dir.path().to_str().unwrap(),
+    ];
+    args.extend_from_slice(arguments);
+    let options = Opt::try_parse_from(args).unwrap();
+
+    let server = Server::new_with_options(options).await.unwrap();
+    sleep(Duration::from_secs(3)).await;
+
+    let (response, code) = server.tasks().await;
+    assert_eq!(code, 200, "response: {}", response);
+    response["results"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .filter(|task| task["type"] == "snapshotCreation")
+        .count()
+}
+
+#[actix_rt::test]
+async fn snapshots_are_not_scheduled_when_the_option_is_omitted() {
+    assert_eq!(scheduled_snapshot_tasks(&[]).await, 0);
+}
+
+#[actix_rt::test]
+async fn bare_schedule_snapshot_flag_does_not_snapshot_within_seconds() {
+    // The default interval is 24 hours, so no snapshot may be registered shortly after startup.
+    assert_eq!(scheduled_snapshot_tasks(&["--schedule-snapshot"]).await, 0);
+}
+
+#[actix_rt::test]
+async fn numeric_schedule_snapshot_value_snapshots_at_that_interval() {
+    // With a 1 second interval, at least one snapshot must be registered within 3 seconds.
+    assert!(scheduled_snapshot_tasks(&["--schedule-snapshot", "1"]).await > 0);
+}
+
+#[test]
+fn default_config_uses_the_combined_snapshot_setting() {
+    let config: toml::Value = toml::from_str(include_str!("../../../config.toml")).unwrap();
+    assert!(config.get("snapshot_interval_sec").is_none());
+    if let Some(schedule_snapshot) = config.get("schedule_snapshot") {
+        assert_eq!(schedule_snapshot.as_bool(), Some(false));
+    }
+}
