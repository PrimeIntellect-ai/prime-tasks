+def test_at_most_one_error_per_turn():
+    """A non-fatal error (such as a timeout) must not add more than one error per turn."""
+    class BadMove:
+        def __len__(self):
+            return 2
+
+    def timing_out(bot, state):
+        # returning a non-iterable move triggers a non-fatal error
+        return BadMove(), state
+
+    def stopping(bot, state):
+        return bot.position, state
+
+    l = Path("layouts/small_without_dead_ends_100.layout").read_text()
+    parsed_l = layout.parse_layout(l)
+    final_state = run_game([timing_out, stopping], max_rounds=1, layout_dict=parsed_l)
+    # team 0 has two turns in the first round and errors on both of them
+    assert len(final_state['errors'][0]) == 2
+    assert len(final_state['errors'][1]) == 0
+    for bot_index in (0, 2):
+        old_position = parsed_l['bots'][bot_index]
+        new_position = final_state['bots'][bot_index]
+        assert new_position not in parsed_l['walls']
+        assert abs(new_position[0] - old_position[0]) + abs(new_position[1] - old_position[1]) <= 1
 
