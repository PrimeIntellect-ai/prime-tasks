+func Test_ParseFeatures_DialectOption(t *testing.T) {
+	fsys := fstest.MapFS{
+		"features/login.feature": &fstest.MapFile{
+			Data: []byte(`
+Fitur: login
+  Skenario: Login sukses
+    Jika username gw adalah dokter_jakbar1
+    Ketika gw login pake password 12345678
+    Maka access_token ga boleh kosong
+    Dan http status code harus 200
+`),
+		},
+	}
+
+	suite := TestSuite{
+		Options: &Options{
+			Dialect: "id",
+			FS:      fsys,
+			Paths:   []string{"features"},
+		},
+	}
+
+	features, err := suite.RetrieveFeatures()
+	require.NoError(t, err)
+	require.Len(t, features, 1)
+}
