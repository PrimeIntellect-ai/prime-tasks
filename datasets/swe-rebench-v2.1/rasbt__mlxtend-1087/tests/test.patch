+def test_get_feature_names_out():
+    """Assert TransactionEncoder has attribute get_feature_names_out."""
+    oht = TransactionEncoder()
+    assert hasattr(oht, "get_feature_names_out")
+    oht.fit(dataset)
+    feature_names = oht.get_feature_names_out()
+    assert isinstance(feature_names, np.ndarray)
+    np.testing.assert_array_equal(feature_names, oht.columns_)
+
+
+def test_set_output():
+    """Assert TransactionEncoder has attribute set_output.
+
+    When transform="pandas", the transformed output of
+    TransactionEncoder should be a pandas.DataFrame with the correct
+    column names and the values should match those of the original
+    numpy.array.
+    """
+    oht = TransactionEncoder()
+    assert hasattr(oht, "set_output")
+    configured = oht.set_output(transform="pandas")
+    assert configured is oht
+    out = oht.fit_transform(dataset)
+    assert isinstance(out, pd.DataFrame)
+    np.testing.assert_array_equal(out.columns, oht.columns_)
+    np.testing.assert_array_equal(out.to_numpy(), expect)
+
+
+def test_set_output_transform():
+    """Assert transform returns a pandas.DataFrame when pandas output is set.
+
+    When transform="pandas", a direct call to transform should return a
+    pandas.DataFrame whose column names match the fitted columns and whose
+    values match the numpy.array output.
+    """
+    oht = TransactionEncoder()
+    oht = oht.set_output(transform="pandas")
+    oht.fit(dataset)
+    out = oht.transform(dataset)
+    assert isinstance(out, pd.DataFrame)
+    np.testing.assert_array_equal(out.columns, oht.columns_)
+    np.testing.assert_array_equal(out.to_numpy(), expect)
+
+
+def test_scikit_learn_minimum_version():
+    """Package metadata must require a scikit-learn version with set_output."""
+    requirements_file = Path(__file__).resolve().parents[3] / "requirements.txt"
+    sklearn_requirement = next(
+        Requirement(line.strip())
+        for line in requirements_file.read_text().splitlines()
+        if line.strip() and Requirement(line.strip()).name == "scikit-learn"
+    )
+    lower_bounds = [
+        Version(specifier.version)
+        for specifier in sklearn_requirement.specifier
+        if specifier.operator in (">=", ">", "~=")
+    ]
+    minimum = Version("1.2.2")
+    assert max(lower_bounds, default=Version("0")) >= minimum or (
+        sklearn_requirement.specifier.contains(str(minimum))
+        and not sklearn_requirement.specifier.contains("1.2.1")
+    )
