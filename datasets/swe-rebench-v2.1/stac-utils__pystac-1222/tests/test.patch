+def test_permissive_temporal_extent_deserialization(collection: Collection) -> None:
+    collection_dict = collection.to_dict(include_self_link=False, transform_hrefs=False)
+    interval = ["2020-01-01T00:00:00Z", "2020-12-31T23:59:59Z"]
+    collection_dict["extent"]["temporal"]["interval"] = interval
+
+    with pytest.warns(UserWarning):
+        deserialized = Collection.from_dict(collection_dict)
+
+    assert isinstance(deserialized, Collection)
+    assert deserialized.extent.temporal.to_dict()["interval"] == [interval]
