+
+#[test]
+fn footnotes_indented_definitions_under_four_spaces() {
+    let original = r##"References [^one] [^two] [^three] [^four] [^missing]
+
+    [^four]: four
+
+ [^one]: one
+  [^two]: two
+   [^three]: three
+"##;
+
+    let mut options = Options::empty();
+    options.insert(Options::ENABLE_FOOTNOTES);
+    let mut rendered = String::new();
+    html::push_html(&mut rendered, Parser::new_ext(original, options));
+
+    for label in ["one", "two", "three"] {
+        assert!(rendered.contains(&format!("href=\"#{label}\"")));
+        assert!(rendered.contains(&format!("id=\"{label}\"")));
+    }
+    assert!(rendered.contains("<pre><code>[^four]: four\n</code></pre>"));
+    assert!(!rendered.contains("id=\"four\""));
+}
