+        <div>
+          <div
+            className="card grid h-full flex-grow place-items-center
+              bg-base-300"
+          >
+            content
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
+`,
+];
+
+describe('babel/consistency (nested div)', () => {
+  for (const [index, input] of nestedDivInputs.entries()) {
+    test(`issue #41 nested div (${index + 1})`, () => {
+      const fixedOptions = {
+        ...options,
+        endingPosition: 'absolute-with-indent',
+      };
+      const formattedText = format(input, fixedOptions);
+      const doubleFormattedText = format(formattedText, fixedOptions);
+
+      expect(doubleFormattedText).toBe(formattedText);
+    });
+  }
+
+  test('both nested div layouts converge to the same format', () => {
+    const fixedOptions = {
+      ...options,
+      endingPosition: 'absolute-with-indent',
+    };
+    const formattedTexts = nestedDivInputs.map((input) => format(input, fixedOptions));
+
+    expect(formattedTexts[0]).toBe(formattedTexts[1]);
+  });
+});
