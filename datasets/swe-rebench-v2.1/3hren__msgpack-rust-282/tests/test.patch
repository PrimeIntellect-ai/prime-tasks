+// The contract fixes the maximum container nesting depth at 1024. A value nested deeper than
+// this must be rejected with `Error::DepthLimitExceeded`.
+const MAX_DEPTH: usize = rmpv::decode::MAX_DEPTH;
+
+/// Builds a MessagePack buffer containing `MAX_DEPTH + 1` nested single-element arrays with a
+/// boolean leaf, i.e. a value whose container nesting strictly exceeds the maximum depth.
+fn deeply_nested_buf() -> Vec<u8> {
+    let mut buf: Vec<u8> = (0..MAX_DEPTH + 1).map(|_| 0x91).collect();
+    buf.push(0xc3);
+    buf
+}
+
+#[test]
+fn test_public_max_depth_value() {
+    assert_eq!(rmpv::decode::MAX_DEPTH, 1024);
+}
+
+#[test]
+fn test_accepts_deep_value_within_depth_limit() {
+    // This nested value is safely within the decoder's supported depth.
+    let mut buf: Vec<u8> = (0..(MAX_DEPTH - 1) / 2).map(|_| 0x91).collect();
+    buf.push(0xc3);
+
+    // A separate large-stack thread keeps this boundary check safe even on implementations
+    // whose normal test-thread stack is small.
+    let result = std::thread::Builder::new()
+        .stack_size(64 * 1024 * 1024)
+        .spawn(move || rmpv::decode::read_value(&mut &buf[..]))
+        .unwrap()
+        .join()
+        .unwrap();
+
+    assert!(result.is_ok(), "a deeply nested value within the depth limit must be accepted: {:?}", result);
+}
+
+#[test]
+fn test_rejects_value_beyond_depth_limit() {
+    let buf = deeply_nested_buf();
+
+    // Run the decode on a thread with a large stack: an implementation without a depth limit
+    // would otherwise abort the whole test process with a stack overflow instead of failing the
+    // assertion below.
+    let result = std::thread::Builder::new()
+        .stack_size(64 * 1024 * 1024)
+        .spawn(move || rmpv::decode::read_value(&mut &buf[..]))
+        .unwrap()
+        .join()
+        .unwrap();
+
+    assert!(
+        matches!(result, Err(rmpv::decode::Error::DepthLimitExceeded)),
+        "expected a depth-limit error, got {:?}",
+        result,
+    );
+}
+
+#[test]
+fn test_stack_depth_checking_ref() {
+    // `read_value_ref` must enforce the same maximum depth as `read_value`.
+    let buf = deeply_nested_buf();
+
+    let outcome = std::thread::Builder::new()
+        .stack_size(64 * 1024 * 1024)
+        .spawn(move || {
+            let mut rd = &buf[..];
+            matches!(
+                rmpv::decode::read_value_ref(&mut rd),
+                Err(rmpv::decode::Error::DepthLimitExceeded),
+            )
+        })
+        .unwrap()
+        .join()
+        .unwrap();
+
+    assert!(outcome, "expected read_value_ref to enforce the depth limit");
+}
+
 #[test]
