+    @testset "spaced prefix multiplication traversal" begin
+        x = CSTParser.parse("*(p) * 2")
+        ordered = collect(x)
+        binary_operators = findall(node -> node.head === :OPERATOR && node.val == "*", ordered)
+        right_operand = findfirst(node -> node.head === :INTEGER && node.val == "2", ordered)
+        @test !isempty(binary_operators)
+        @test right_operand !== nothing
