+
+    def test_multiline_pattern(self):
+        class RegexReceiver:
+            def _pattern(self, pattern):
+                return re.compile(pattern)
+
+        grammar = r'''
+            start =
+            /(?x)
+            foo
+            bar
+            / $ ;
+        '''
+        model = compile(grammar=trim(grammar))
+        generated = codegen(model.rules[0].exp.sequence[0])
+        pattern = eval(generated, {}, {'self': RegexReceiver()})
+        self.assertIsNotNone(pattern.fullmatch('foobar'))
+
+        grammar = r'''
+            start =
+            /(?x)foo\nbar
+            blort/ $ ;
+        '''
+        model = compile(grammar=trim(grammar))
+        generated = codegen(model.rules[0].exp.sequence[0])
+        pattern = eval(generated, {}, {'self': RegexReceiver()})
+        self.assertIsNotNone(pattern.fullmatch('foo\nbarblort'))
