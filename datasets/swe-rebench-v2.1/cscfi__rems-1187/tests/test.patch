+(defn sort-emails [emails]
+  (sort-by #(or (:to %) (:to-user %)) emails))
+
+(defn email-contains? [expected actual]
+  (every? (fn [[k v]] (= v (get actual k))) expected))
+
+(defn emails-match? [expected actual]
+  (and (= (count expected) (count actual))
+       (every? true?
+               (map (fn [exp act]
+                      (every? true? (map email-contains? exp act)))
+                    expected actual))))
+
