+class TestTransformPrimaryIdentifiers(TestCase):
+    """End-to-end checks for mapped primary identifiers on generated resources."""
+
+    def _e3019_matches(self, template_obj):
+        rules = Rules()
+        rules.register(PrimaryIdentifiers())
+        config = ConfigMixIn(regions=["us-east-1"])
+        runner = TemplateRunner("", template_obj, config, rules)
+        return [m for m in runner.run() if m.rule.id == "E3019"]
+
+    def _template_with_role_names(self, second_name):
+        return convert_dict(
+            {
+                "Mappings": {
+                    "Roles": {
+                        "A": {"RoleName": "Alpha"},
+                        "B": {"RoleName": second_name},
+                    },
+                },
+                "Transform": "AWS::LanguageExtensions",
+                "Resources": {
+                    "Fn::ForEach::TestRole": [
+                        "Role",
+                        ["A", "B"],
+                        {
+                            "${Role}": {
+                                "Type": "AWS::IAM::Role",
+                                "Properties": {
+                                    "RoleName": {
+                                        "Fn::FindInMap": [
+                                            "Roles",
+                                            {"Ref": "Role"},
+                                            "RoleName",
+                                        ]
+                                    },
+                                    "AssumeRolePolicyDocument": {
+                                        "Version": "2012-10-17",
+                                        "Statement": [
+                                            {
+                                                "Principal": {"AWS": "*"},
+                                                "Effect": "Allow",
+                                                "Action": "sts:AssumeRole",
+                                            }
+                                        ],
+                                    },
+                                },
+                            }
+                        },
+                    ]
+                },
+            }
+        )
+
+    def test_foreach_findinmap_unique_primary_identifiers(self):
+        self.assertEqual(
+            self._e3019_matches(self._template_with_role_names("Bravo")), []
+        )
+
+    def test_foreach_findinmap_duplicate_primary_identifiers(self):
+        self.assertTrue(self._e3019_matches(self._template_with_role_names("Alpha")))
+
+
