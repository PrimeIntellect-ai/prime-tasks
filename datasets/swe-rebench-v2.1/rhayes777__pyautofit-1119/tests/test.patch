+def _fit_graphical_model(collection, tmp_path):
+    search = af.m.MockSearch(name="graph_fit")
+    search.paths = af.DirectoryPaths(name="graph_fit", path_prefix=tmp_path)
+    search.paths.remove_files = False
+
+    class Analysis(af.Analysis):
+        def log_likelihood_function(self, instance):
+            return collection.log_likelihood_function(instance)
+
+    search.fit(collection.global_prior_model, Analysis())
+    return search
+
+
+def test_fit_writes_model_info(model_factor, model_factor_2, tmp_path):
+    """
+    When a graphical model is fitted a `model.info` file is written which is
+    identical to the analysis summing format (rather than the graphical format).
+    """
+    collection = g.FactorGraphModel(model_factor, model_factor_2)
+    search = _fit_graphical_model(collection, tmp_path)
+
+    info_file = search.paths.output_path / "model.info"
+    assert info_file.exists()
+
+    info = info_file.read_text()
+    # The analysis summing format is used, not the graphical format
+    assert "Total Free Parameters" in info
+    assert "PriorFactors" not in info
+
+
+def test_fit_writes_model_graph(model_factor, model_factor_2, tmp_path):
+    """
+    When a graphical model is fitted a `model.graph` file is written which
+    describes the factor graph in the graphical format.
+    """
+    collection = g.FactorGraphModel(model_factor, model_factor_2)
+    search = _fit_graphical_model(collection, tmp_path)
+
+    graph_file = search.paths.output_path / "model.graph"
+    assert graph_file.exists()
+
+    graph = graph_file.read_text()
+    # The graphical format is used, describing the factor graph
+    assert "PriorFactors" in graph
+    assert "AnalysisFactors" in graph
