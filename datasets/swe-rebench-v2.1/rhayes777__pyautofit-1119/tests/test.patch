+def test_fit_writes_model_info_and_graph(graph, model, tmp_path):
+    """
+    When a hierarchical graphical model is fitted both a `model.info` file
+    (in the analysis summing format) and a `model.graph` file (in the
+    graphical format) are written.
+    """
+    search = af.m.MockSearch(name="hierarchical_fit")
+    search.paths = af.DirectoryPaths(name="hierarchical_fit", path_prefix=tmp_path)
+    search.paths.remove_files = False
+
+    class Analysis(af.Analysis):
+        def log_likelihood_function(self, instance):
+            return graph.log_likelihood_function(instance)
+
+    search.fit(model, Analysis())
+
+    output_path = search.paths.output_path
+
+    info_file = output_path / "model.info"
+    assert info_file.exists()
+    info = info_file.read_text()
+    assert "Total Free Parameters" in info
+    assert "PriorFactors" not in info
+
+    graph_file = output_path / "model.graph"
+    assert graph_file.exists()
+    graph_text = graph_file.read_text()
+    assert "PriorFactors" in graph_text
+    assert "AnalysisFactors" in graph_text
