     )
+
+
+def test_template_with_if_inside_foreach():
+    template = "{{#each items}} {{some_variable}} {{#if some_other_var}} print me {{/if}} {{/each}}"
+    kwargs = {
+        "items": [
+            {"some_variable": "a", "some_other_var": True},
+            {"some_variable": "b", "some_other_var": False},
+        ]
+    }
+    assert parse_template(template, kwargs) == " a  print me   b  "
+
+
+def test_template_with_nested_foreaches():
+    template = (
+        "{{#each l}} - {{obj}} {{#each l2}} {{o1}} {{/each}} infix-each {{/each}}"
+    )
+    kwargs = {
+        "name": True,
+        "l": [
+            {
+                "obj": "it1",
+                "l2": [{"o1": "ob1", "o2": "ob2"}, {"o1": "oc1", "o2": "oc2"}],
+            },
+            {"obj": "it2", "l2": [{"o1": "ob3"}]},
+        ],
+    }
+    assert (
+        parse_template(template, kwargs)
+        == " - it1  ob1  oc1  infix-each  - it2  ob3  infix-each "
+    )
+
+
+def test_template_with_nested_ifs_and_foreaches():
