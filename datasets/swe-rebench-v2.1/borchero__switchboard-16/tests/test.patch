+
+func getDNSRecords(
+	ctx context.Context, t *testing.T, ctrlClient client.Client, namespace string,
+) []*endpoint.Endpoint {
+	var list endpoint.DNSEndpointList
+	err := ctrlClient.List(ctx, &list, &client.ListOptions{
+		Namespace: namespace,
+	})
+	require.Nil(t, err)
+
+	records := make([]*endpoint.Endpoint, 0)
+	for _, item := range list.Items {
+		records = append(records, item.Spec.Endpoints...)
+	}
+	return records
+}
