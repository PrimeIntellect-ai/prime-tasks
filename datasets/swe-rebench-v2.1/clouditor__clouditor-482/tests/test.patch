+func TestConfiguredAssessmentTarget(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	assert.NoError(t, err)
+	defer listener.Close()
+
+	server := grpc.NewServer()
+	connected := make(chan struct{}, 1)
+	assessment.RegisterAssessmentServer(server, &assessmentTargetServer{connected: connected})
+	go server.Serve(listener)
+	defer server.Stop()
+
+	service := NewService(WithAssessmentAddress(listener.Addr().String()))
+	_, _ = service.Start(context.Background(), &discovery.StartDiscoveryRequest{})
+	select {
+	case <-connected:
+	case <-time.After(2 * time.Second):
+		t.Fatal("the configured assessment service did not receive a stream")
+	}
+}
+
+type assessmentTargetServer struct {
+	assessment.UnimplementedAssessmentServer
+	connected chan struct{}
+}
+
