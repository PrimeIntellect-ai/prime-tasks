+// TestConfiguredGRPCTargets verifies that evidence assessment connects to both configured services.
+func TestConfiguredGRPCTargets(t *testing.T) {
+	evidenceListener, err := net.Listen("tcp", "127.0.0.1:0")
+	assert.NoError(t, err)
+	defer evidenceListener.Close()
+	orchestratorListener, err := net.Listen("tcp", "127.0.0.1:0")
+	assert.NoError(t, err)
+	defer orchestratorListener.Close()
+
+	evidenceServer := grpc.NewServer()
+	evidence.RegisterEvidenceStoreServer(evidenceServer, service_evidenceStore.NewService())
+	go evidenceServer.Serve(evidenceListener)
+	defer evidenceServer.Stop()
+
+	orchestratorServer := grpc.NewServer()
+	orchestrator.RegisterOrchestratorServer(orchestratorServer, service_orchestrator.NewService())
+	go orchestratorServer.Serve(orchestratorListener)
+	defer orchestratorServer.Stop()
+
+	service := NewService(
+		WithEvidenceStoreAddress(evidenceListener.Addr().String()),
+		WithOrchestratorAddress(orchestratorListener.Addr().String()),
+	)
+	response, err := service.AssessEvidence(context.Background(), &assessment.AssessEvidenceRequest{Evidence: &evidence.Evidence{
+		Id:        "11111111-1111-1111-1111-111111111111",
+		ToolId:    "mock",
+		Timestamp: timestamppb.Now(),
+		Resource:  toStruct(voc.VirtualMachine{Compute: &voc.Compute{CloudResource: &voc.CloudResource{ID: "configured-target-resource", Type: []string{"VirtualMachine"}}}}, t),
+	}})
+	assert.NoError(t, err)
+	assert.NotNil(t, response)
 }
 
