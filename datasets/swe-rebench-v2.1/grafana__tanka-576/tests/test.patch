+package tanka
+
+import (
+"os"
+"path/filepath"
+"strings"
+"testing"
+
+"github.com/grafana/tanka/pkg/helm"
+"github.com/stretchr/testify/assert"
+"github.com/stretchr/testify/require"
+)
+
+// TestHelmTemplateAPIVersionsAsSeparateFlags verifies that every API version is
+// handed to the helm binary as its own --api-versions flag, rather than as a
+// single comma-separated value.
+func TestHelmTemplateAPIVersionsAsSeparateFlags(t *testing.T) {
+dir := t.TempDir()
+argsFile := filepath.Join(dir, "args.txt")
+
+// A stand-in for the helm binary that records the arguments it receives,
+// one per line, and produces no manifests.
+script := filepath.Join(dir, "helm")
+content := "#!/bin/sh\nprintf '%s\\n' \"$@\" > \"" + argsFile + "\"\n"
+require.NoError(t, os.WriteFile(script, []byte(content), 0755))
+t.Setenv("TANKA_HELM_PATH", script)
+
+_, err := helm.ExecHelm{}.Template("my-app", "charts/my-app", helm.TemplateOpts{
+APIVersions: []string{"v1", "apps/v1", "monitoring.coreos.com/v1"},
+})
+require.NoError(t, err)
+
+raw, err := os.ReadFile(argsFile)
+require.NoError(t, err)
+
+var apiFlags []string
+for _, line := range strings.Split(strings.TrimSpace(string(raw)), "\n") {
+if strings.HasPrefix(line, "--api-versions") {
+apiFlags = append(apiFlags, line)
+}
+}
+
+assert.ElementsMatch(t, []string{
+"--api-versions=v1",
+"--api-versions=apps/v1",
+"--api-versions=monitoring.coreos.com/v1",
+}, apiFlags)
+}
