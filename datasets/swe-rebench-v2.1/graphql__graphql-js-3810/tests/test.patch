+  it('does not include nested default values when introspecting an SDL default', () => {
+    const schema = buildSchema(`
+      input A {
+        a: B = {}
+      }
+
+      input B {
+        c: Int = 0
+      }
+
+      type Query {
+        f(arg: A): String
+      }
+    `);
+
+    const introspection: any = introspectionFromSchema(schema);
+    const aType = introspection.__schema.types.find(
+      (type: any) => type.name === 'A',
+    );
+    const aField = aType.inputFields.find((field: any) => field.name === 'a');
+
+    // The default value of `A.a` was declared as the empty object literal, so
+    // introspection must not fill in the nested default declared on `B.c`.
+    expect(aField.defaultValue).to.match(/^\{\s*\}$/);
+    expect(printSchema(schema)).to.match(/a: B = \{\s*\}/);
+  });
