+type rejectConflictingHighAvailabilityRulesClient struct {
+	loadbalancerclient.Interface
+}
+
+func (client *rejectConflictingHighAvailabilityRulesClient) CreateOrUpdate(ctx context.Context, resourceGroupName, loadBalancerName string, parameters network.LoadBalancer, etag string) *retry.Error {
+	if parameters.LoadBalancingRules != nil {
+		rules := *parameters.LoadBalancingRules
+		for currentIndex, current := range rules {
+			currentProperties := current.LoadBalancingRulePropertiesFormat
+			if currentProperties == nil || currentProperties.FrontendIPConfiguration == nil || currentProperties.BackendAddressPool == nil || !to.Bool(currentProperties.EnableFloatingIP) {
+				continue
+			}
+			for _, other := range rules[currentIndex+1:] {
+				otherProperties := other.LoadBalancingRulePropertiesFormat
+				if otherProperties == nil || otherProperties.FrontendIPConfiguration == nil || otherProperties.BackendAddressPool == nil || !to.Bool(otherProperties.EnableFloatingIP) {
+					continue
+				}
+				conflict := to.String(currentProperties.FrontendIPConfiguration.ID) == to.String(otherProperties.FrontendIPConfiguration.ID) &&
+					to.String(currentProperties.BackendAddressPool.ID) == to.String(otherProperties.BackendAddressPool.ID) &&
+					currentProperties.Protocol == otherProperties.Protocol &&
+					to.Int32(currentProperties.BackendPort) == to.Int32(otherProperties.BackendPort)
+				if conflict {
+					return &retry.Error{HTTPStatusCode: http.StatusBadRequest}
+				}
+			}
+		}
+	}
+	return client.Interface.CreateOrUpdate(ctx, resourceGroupName, loadBalancerName, parameters, etag)
+}
