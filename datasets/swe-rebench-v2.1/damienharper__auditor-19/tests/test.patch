+    }
+
+    /**
+     * Set the value of id.
+     *
+     * @return DataObject
+     */
+    public function setId(int $id): self
+    {
+        $this->id = $id;
+
+        return $this;
+    }
+
+    /**
+     * Get the value of data.
+     */
