diff --git a/test/node-resolver.spec.ts b/test/node-resolver.spec.ts
new file mode 100644
index 00000000..f94bdf1d
--- /dev/null
+++ b/test/node-resolver.spec.ts
@@ -0,0 +1,106 @@
+import path from 'node:path'
+import { cwd } from 'node:process'
+import { createNodeResolver } from '../src/node-resolver';
+
+const resolver = createNodeResolver()
+
+function expectResolve(source: string, expected: boolean | string) {
+  it(`${source} => ${expected}`, () => {
+    const result = resolver.resolve(source, __filename);
+
+    if (typeof expected === 'string') {
+      expect(result.path).toBe(path.resolve(cwd(), expected))
+    } else {
+      expect(result.found).toBe(expected)
+    }
+  })
+}
+
+function expectResolveFrom(source: string, sourceFile: string, expected: boolean | string) {
+  it(`${source} (from ${path.relative(cwd(), sourceFile)}) => ${expected}`, () => {
+    const result = resolver.resolve(source, sourceFile);
+
+    if (typeof expected === 'string') {
+      expect(result.path).toBe(path.resolve(cwd(), expected))
+    } else {
+      expect(result.found).toBe(expected)
+    }
+  })
+}
+
+describe('builtin', () => {
+  expectResolve('path', true)
+  expectResolve('node:path', true)
+
+  it('reports built-ins as found with a null path', () => {
+    expect(resolver.resolve('path', __filename)).toEqual({ found: true, path: null })
+    expect(resolver.resolve('node:path', __filename)).toEqual({ found: true, path: null })
+  })
+})
+
+describe('data url', () => {
+  it('reports data: URLs as found with a null path', () => {
+    expect(resolver.resolve('data:text/javascript,export default 1', __filename)).toEqual({
+      found: true,
+      path: null,
+    })
+  })
+})
+
+describe('modules', () => {
+  expectResolve('jest', true)
+  expectResolve('@sukka/does-not-exists', false)
+})
+
+describe('package exports', () => {
+  expectResolve('eslint/use-at-your-own-risk', 'node_modules/eslint/lib/unsupported-api.js')
+})
+
+describe('package imports', () => {
+  expectResolveFrom(
+    '#get-tsconfig',
+    path.resolve(cwd(), 'node_modules/get-tsconfig/dist/index.cjs'),
+    'node_modules/get-tsconfig/dist/index.mjs',
+  )
+})
+
+describe('relative', () => {
+  expectResolve('../package.json', 'package.json')
+  expectResolve('../.github/dependabot.yml', false)
+  expectResolve('../babel.config.js', 'babel.config.js')
+  expectResolve('../test/index.js', 'test/index.js')
+  expectResolve('../test/', 'test/index.js')
+  expectResolve('../test', 'test/index.js')
+
+  expectResolve('../inexistent.js', false)
+})
+
+describe('resolver metadata', () => {
+  it('exposes interface version 3', () => {
+    expect(resolver.interfaceVersion).toBe(3)
+  })
+
+  it('exposes a descriptive name', () => {
+    expect(typeof resolver.name).toBe('string')
+    expect(resolver.name.length).toBeGreaterThan(0)
+  })
+})
+
+describe('resolver options', () => {
+  it('honors custom extensions', () => {
+    const custom = createNodeResolver({ extensions: ['.json'] })
+
+    expect(custom.resolve('../package.json', __filename).found).toBe(true)
+    expect(custom.resolve('../test', __filename).found).toBe(false)
+  })
+
+  it('honors custom conditionNames', () => {
+    const custom = createNodeResolver({ conditionNames: ['require'] })
+    const result = custom.resolve('eslint-compat-utils/eslint', __filename)
+
+    expect(result.found).toBe(true)
+    expect(result.path).toBe(
+      path.resolve(cwd(), 'node_modules/eslint-compat-utils/dist/eslint.cjs'),
+    )
+  })
+})
