 (({foo : {bar: Bool} | default = {bar = false}} & {foo.bar = true}).foo.bar
   | #Assert) &&
 
+// nested_metavalues
+// Regression test for #402
+(let myContract = { x | Str } in
+{
+  foo | #myContract | default = { x = "From foo" },
+  bar | #{..} | default = foo
+} == { foo.x = "From foo", bar.x = "From foo"} | #Assert) &&
+
+// Contracts on both the value and its default remain observable when defaults nest.
+(let Mark = fun l x => x ++ "!" in
+  let MarkX = { x | #Mark } in
+  {
+    foo | #MarkX | default = { x = "From foo" },
+    bar | #{ x | #Mark } | default = foo
+  } == { foo.x = "From foo!", bar.x = "From foo!!"}
+  | #Assert) &&
+
 true
