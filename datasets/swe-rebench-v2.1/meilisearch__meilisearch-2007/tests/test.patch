+
+#[actix_rt::test]
+async fn supplied_primary_key_is_ignored_after_index_creation() {
+    let server = Server::new().await;
+    let index = server.index("test");
+
+    let documents = json!([
+        {
+            "title": "11",
+            "desc": "foobar"
+        }
+    ]);
+
+    index.add_documents(documents.clone(), Some("title")).await;
+    index.wait_task(0).await;
+    let (response, _code) = index.get_task(0).await;
+    assert_eq!(response["status"], "succeeded");
+
+    // Once the index has a primary key, a later supplied value is ignored.
+    index.add_documents(documents.clone(), Some("desc")).await;
+    index.wait_task(1).await;
+    let (response, _code) = index.get_task(1).await;
+    assert_eq!(response["status"], "succeeded");
+
+    index.add_documents(documents, Some("title")).await;
+    index.wait_task(2).await;
+    let (response, _code) = index.get_task(2).await;
+    assert_eq!(response["status"], "succeeded");
+}
