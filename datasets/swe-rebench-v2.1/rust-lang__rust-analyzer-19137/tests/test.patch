+"#
+    .trim();
+    let (analysis, file_id) = fixture::file(source);
+    let text = analysis.file_text(file_id).unwrap();
+    let highlights = analysis.highlight(HL_CONFIG, file_id).unwrap();
+
+    for name in ["SomeCrate", "SomeAlias"] {
+        let start = text.find(name).unwrap();
+        let range = TextRange::new((start as u32).into(), ((start + name.len()) as u32).into());
+        if let Some(highlight) = highlights.iter().find(|it| it.range == range) {
+            assert_ne!(highlight.highlight.tag, HlTag::UnresolvedReference, "{name}");
+        }
+    }
+}
