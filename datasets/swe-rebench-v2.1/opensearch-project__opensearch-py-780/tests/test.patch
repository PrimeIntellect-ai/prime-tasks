+@pytest.mark.parametrize(  # type: ignore[misc]
+    "minimum_should_match",
+    [50, "50", "50%", 1, -1, "1", "-1", "-50%", "1<50%"],
+)
+def test_bool_with_minimum_should_match_as_int_or_string(
+    minimum_should_match: Any,
+) -> None:
+    q1 = query.Bool(
+        minimum_should_match=minimum_should_match,
+        should=[
+            query.Q("term", field="aa1"),
+            query.Q("term", field="aa2"),
+        ],
+    )
+
+    q2 = query.Bool(
+        minimum_should_match=minimum_should_match,
+        should=[
+            query.Q("term", field="bb1"),
+            query.Q("term", field="bb2"),
+        ],
+    )
+
+    q3 = q1 & q2
+
+    # Combining Bool queries must accept the value and retain every clause
+    # supplied by either operand; the serialized representation may normalize
+    # equivalent minimum_should_match values.
+    d3 = q3.to_dict()
+    for field in ("aa1", "aa2", "bb1", "bb2"):
+        assert _contains(d3, {"term": {"field": field}})
+
+
+def _contains(node: Any, target: Any) -> bool:
+    if node == target:
+        return True
+    if isinstance(node, dict):
+        return any(_contains(value, target) for value in node.values())
+    if isinstance(node, list):
+        return any(_contains(item, target) for item in node)
+    return False
+
+
+@pytest.mark.parametrize(  # type: ignore[misc]
+    "minimum_should_match",
+    ["50", "50%", "-50%", "1<50%"],
+)
+def test_search_filter_with_string_minimum_should_match(
+    minimum_should_match: str,
+) -> None:
+    s = Search().query(
+        query.Bool(
+            minimum_should_match=minimum_should_match,
+            should=[
+                query.Q("term", field="aa1"),
+                query.Q("term", field="aa2"),
+            ],
+        )
+    )
+
+    # ``Search.filter`` combines the existing query with a new Bool via
+    # ``Bool.__and__``; a string ``minimum_should_match`` used to raise a
+    # TypeError here.
+    s = s.filter("terms", field="bb1")
+
+    d = s.to_dict()
+
+    assert _contains(d, {"terms": {"field": "bb1"}})
+    assert _contains(d, {"term": {"field": "aa1"}})
+    assert _contains(d, {"term": {"field": "aa2"}})
