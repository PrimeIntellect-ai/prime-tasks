+package io.github.kevincianfarini.cardiologist.impl
+
+import io.github.kevincianfarini.cardiologist.RecurringJobMode
+import io.github.kevincianfarini.cardiologist.intervalPulse
+import io.github.kevincianfarini.cardiologist.testClock
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.test.runTest
+import kotlinx.datetime.Instant
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.time.Duration.Companion.milliseconds
+
+class FlowCollectCurrentTest {
+
+    @Test
+    fun skip_mode_skips_pulses_while_previous_action_is_running() = runTest {
+        val pulse = testClock.intervalPulse(100.milliseconds).take(3)
+        val executed = mutableListOf<Instant>()
+        val completed = mutableListOf<Instant>()
+        pulse.beat(mode = RecurringJobMode.Skip) { scheduled, _ ->
+            executed += scheduled
+            delay(250)
+            completed += scheduled
+        }
+        assertEquals(
+            expected = listOf(Instant.fromEpochMilliseconds(100)),
+            actual = executed,
+        )
+        assertEquals(
+            expected = listOf(Instant.fromEpochMilliseconds(100)),
+            actual = completed,
+        )
+    }
+
+    @Test
+    fun skip_mode_runs_a_pulse_after_the_previous_action_completes() = runTest {
+        val pulse = testClock.intervalPulse(100.milliseconds).take(4)
+        val executed = mutableListOf<Instant>()
+        pulse.beat(mode = RecurringJobMode.Skip) { scheduled, _ ->
+            executed += scheduled
+            delay(150)
+        }
+        assertEquals(
+            expected = listOf(
+                Instant.fromEpochMilliseconds(100),
+                Instant.fromEpochMilliseconds(300),
+            ),
+            actual = executed,
+        )
+    }
+}
