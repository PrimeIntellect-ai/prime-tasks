+import { shorthands } from '..';
+
+describe('shorthands.transition', () => {
+  it('expresses the reported transition through the public shorthand API', () => {
+    expect(shorthands.transition('all', '.3s', '0s', 'cubic-bezier(.33,0,0,1)')).toEqual({
+      transitionProperty: 'all',
+      transitionDuration: '.3s',
+      transitionDelay: '0s',
+      transitionTimingFunction: 'cubic-bezier(.33,0,0,1)',
+    });
+  });
+});
