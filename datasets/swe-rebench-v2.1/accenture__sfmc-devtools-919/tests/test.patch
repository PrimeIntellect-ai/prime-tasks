+function runExecuteCommand(businessUnit, keys) {
+    const cliPath = path.resolve(__dirname, '../lib/cli.js');
+    const fixturePath = path.resolve(__dirname, 'resourceFactory.js');
+    const output = execFileSync(
+        process.execPath,
+        ['-r', fixturePath, cliPath, 'execute', businessUnit, 'query', keys.join(',')],
+        {
+            cwd: path.join(__dirname, 'mockRoot'),
+            env: { ...process.env, MCDEV_CLI_TEST: '1' },
+            encoding: 'utf8',
+        }
+    );
+    return output
+        .split('\n')
+        .filter((line) => line.startsWith('MCDEV_CLI_API '))
+        .map((line) => JSON.parse(line.slice('MCDEV_CLI_API '.length)))
+        .filter(
+            (request) =>
+                request.url.includes('/automation/v1/queries/') &&
+                request.url.includes('/actions/start/')
+        );
+}
