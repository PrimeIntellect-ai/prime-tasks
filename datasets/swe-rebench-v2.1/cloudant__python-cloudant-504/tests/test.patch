+class ViewBooleanKeyTests(unittest.TestCase):
+    """
+    Test cases for querying a view using a boolean key.
+    """
+
+    @mock.patch('cloudant._client_session.Session.request')
+    def test_get_view_result_boolean_key(self, m_req):
+        """
+        Test that querying a view with a boolean key does not raise.
+        """
+        m_response = mock.MagicMock()
+        type(m_response).status_code = mock.PropertyMock(return_value=200)
+        type(m_response).text = mock.PropertyMock(return_value='{"rows": []}')
+        m_req.return_value = m_response
+
+        client = Cloudant(
+            'foo', 'bar', url='http://localhost:5984', use_basic_auth=True)
+        client.connect()
+        db = CloudantDatabase(client, 'animaldb')
+
+        db.get_view_result(
+            '_design/doc', 'view-name', raw_result=True, key=False)
+
