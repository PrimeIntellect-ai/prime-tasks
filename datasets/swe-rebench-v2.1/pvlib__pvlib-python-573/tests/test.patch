+def test_scalars():
+    apparent_zenith = 10
+    apparent_azimuth = 180
+    tracker_data = tracking.singleaxis(apparent_zenith, apparent_azimuth,
+                                       axis_tilt=0, axis_azimuth=0,
+                                       max_angle=90, backtrack=True,
+                                       gcr=2.0/7.0)
+    assert isinstance(tracker_data, dict)
+    expect = {'tracker_theta': 0, 'aoi': 10, 'surface_azimuth': 90,
+              'surface_tilt': 0}
+    for k, v in expect.items():
+        assert_allclose(tracker_data[k], v)
+
+
+def test_singleaxis_defaults():
+    # Omitting optional arguments uses the documented backtracking defaults.
+    tracker_data = tracking.singleaxis(80, 90)
+    expected = {
+        'tracker_theta': 27.42833409,
+        'aoi': 52.57166591,
+        'surface_azimuth': 90,
+        'surface_tilt': 27.42833409,
+    }
+    assert set(tracker_data) == set(expected)
+    for key, value in expected.items():
+        assert_allclose(tracker_data[key], value, atol=1e-3)
+
+
