+    two_dimensional_azimuth = np.array([[180, 180], [180, 180]])
+
+    # Reject multidimensional inputs whether one or both angles have them.
+    for apparent_zenith, apparent_azimuth in [
+            (two_dimensional, two_dimensional_azimuth),
+            (two_dimensional, one_dimensional_azimuth),
