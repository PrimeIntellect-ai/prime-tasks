+@skip_36
+def test_abstract_generic_type_recursion():
+    T = TypeVar('T')
+
+    class BaseInnerClass(GenericModel, abc.ABC, Generic[T]):
+        base_data: T
+
+        @abc.abstractmethod
+        def base_abstract(self) -> None:
+            pass
+
+    class ConcreteInnerClass(BaseInnerClass[T], Generic[T]):
+        def base_abstract(self) -> None:
+            return None
+
+    class OuterClass(GenericModel, Generic[T]):
+        inner_class: BaseInnerClass[T]
+
+    outer = OuterClass[int](inner_class=ConcreteInnerClass[int](base_data=2))
+    assert isinstance(outer.inner_class, BaseInnerClass)
+    assert outer.inner_class.base_data == 2
+
+
+@skip_36
+def test_generic_subclass():
+    T = TypeVar('T')
+
+    class A(GenericModel, Generic[T]):
+        ...
+
+    class B(A[T], Generic[T]):
+        ...
+
+    assert B[int].__name__ == 'B[int]'
+    assert issubclass(B[int], B)
+    assert issubclass(B[int], A[int])
+    assert not issubclass(B[int], A[str])
+
+
+@skip_36
+def test_generic_subclass_with_partial_application():
+    T = TypeVar('T')
+    S = TypeVar('S')
+
+    class A(GenericModel, Generic[T]):
+        ...
+
+    class B(A[S], Generic[T, S]):
+        ...
+
+    PartiallyAppliedB = B[str, T]
+    assert issubclass(PartiallyAppliedB[int], A[int])
+    assert not issubclass(PartiallyAppliedB[int], A[str])
+    assert not issubclass(PartiallyAppliedB[str], A[int])
+
+
