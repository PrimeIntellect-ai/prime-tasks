+function test_error_parsing_reference_sets()
+    model = Model()
+    @variable(model, a)
+    function check_macro_error(f, macro_name, failure_kind, expression)
+        err = try
+            f()
+            nothing
+        catch caught
+            caught
+        end
+        @test err isa ErrorException
+        if err isa ErrorException
+            message = sprint(showerror, err)
+            lowered_message = lowercase(message)
+            macro_label = lowercase(replace(macro_name, "@" => ""))
+            @test occursin(macro_name, message) ||
+                  occursin("$(macro_label) macro", lowered_message)
+            if failure_kind == "reference set"
+                @test occursin(r"(reference|index)[ -]?set", lowered_message)
+            else
+                @test occursin(failure_kind, lowered_message)
+            end
+            @test occursin(r"(parse|error|fail|unable|cannot|could not|invalid)"i, message)
+            # The expression may be rendered as source text or structurally; its
+            # operands must still be identifiable in the diagnostic.
+            for term in eachmatch(r"[[:alnum:]_]+", expression)
+                @test occursin(term.match, message)
+            end
+        end
+        return
+    end
+    check_macro_error(
+        () -> @variable(model, b[1:a]),
+        "@variable",
+        "reference set",
+        "1:a",
+    )
+    check_macro_error(
+        () -> @variable(model, b[1:2, 1:a]),
+        "@variable",
+        "reference set",
+        "1:a",
+    )
+    check_macro_error(
+        () -> @variable(model, b[i = 1:a, 1:i]),
+        "@variable",
+        "reference set",
+        "1:a",
+    )
+    check_macro_error(
+        () -> @variable(model, b[i = 1:2, a:i]),
+        "@variable",
+        "reference set",
+        "a:i",
+    )
+    check_macro_error(
+        () -> @variable(model, b[i = 1:2; i < a]),
+        "@variable",
+        "condition",
+        "i < a",
+    )
+    check_macro_error(
+        () -> @expression(model, b[1:a], a + 1),
+        "@expression",
+        "reference set",
+        "1:a",
+    )
+    check_macro_error(
+        () -> @expression(model, b[1:2, 1:a], a + 1),
+        "@expression",
+        "reference set",
+        "1:a",
+    )
+    check_macro_error(
+        () -> @expression(model, b[i = 1:a, 1:i], a + 1),
+        "@expression",
+        "reference set",
+        "1:a",
+    )
+    check_macro_error(
+        () -> @expression(model, b[i = 1:2, a:i], a + 1),
+        "@expression",
+        "reference set",
+        "a:i",
+    )
+    check_macro_error(
+        () -> @expression(model, b[i = 1:2; i < a], a + 1),
+        "@expression",
+        "condition",
+        "i < a",
+    )
+    check_macro_error(
+        () -> @constraint(model, b[i = 1:a], a <= 1),
+        "@constraint",
+        "reference set",
+        "1:a",
+    )
+    check_macro_error(
+        () -> @constraint(model, b[i = 1:2; i < a], a <= 1),
+        "@constraint",
+        "condition",
+        "i < a",
+    )
+    return
+end
+
 end  # module
