+async def test_ssl_none_preserves_default_verification(
+    aiohttp_server,
+    ssl_ctx,
+) -> None:
+    async def handler(request):
+        return web.Response()
+
+    app = web.Application()
+    app.router.add_get("/", handler)
+    srv = await aiohttp_server(app, ssl=ssl_ctx)
+
+    for connector in (
+        aiohttp.TCPConnector(),
+        aiohttp.TCPConnector(ssl=None),
+        aiohttp.TCPConnector(ssl=True),
+    ):
+        async with aiohttp.ClientSession(connector=connector) as session:
+            with pytest.raises(aiohttp.ClientConnectorCertificateError):
+                await session.get(srv.make_url("/"))
+
+
+async def test_ssl_none_with_verify_ssl_false() -> None:
+    # Reported in #8097: aiobotocore passes both verify_ssl=False and ssl=None.
+    # The reported call must not raise a ValueError.
+    conn = aiohttp.TCPConnector(ssl=None, verify_ssl=False)
+    assert isinstance(conn, aiohttp.TCPConnector)
+
+
