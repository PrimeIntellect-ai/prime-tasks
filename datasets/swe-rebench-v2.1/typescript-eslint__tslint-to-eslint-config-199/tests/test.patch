+import { convertRules } from "../../convertRules";
+import { converters } from "../../converters";
+
+describe("no-duplicate-imports conversion", () => {
+    test("converts the rule through the normal rule conversion path", () => {
+        const result = convertRules(
+            {
+                converters,
+                mergers: new Map(),
+            },
+            {
+                "no-duplicate-imports": {},
+            },
+        );
+
+        expect(result.failed).toHaveLength(0);
+        expect(result.missing).toHaveLength(0);
+        expect(result.converted.has("no-duplicate-imports")).toBe(true);
+    });
+});
