+func TestDefaultDeltaTemporalityAcrossCollections(t *testing.T) {
+	ctx := context.Background()
+	gatherer, err := NewGatherer()
+	require.NoError(t, err)
+	provider := sdkmetric.NewMeterProvider(sdkmetric.WithReader(gatherer))
+	meter := provider.Meter("apmotel_delta_test")
+
+	counter, err := meter.Int64Counter("delta.counter")
+	require.NoError(t, err)
+	counter.Add(ctx, 4)
+	histogram, err := meter.Float64Histogram("delta.histogram")
+	require.NoError(t, err)
+	histogram.Record(ctx, 2.5)
+	var observed float64 = 3
+	observableCounter, err := meter.Float64ObservableCounter("delta.observable_counter")
+	require.NoError(t, err)
+	registration, err := meter.RegisterCallback(func(_ context.Context, observer metric.Observer) error {
+		observer.ObserveFloat64(observableCounter, observed)
+		return nil
+	}, observableCounter)
+	require.NoError(t, err)
+	defer registration.Unregister()
+
+	collect := func() map[string]metricdata.Metrics {
+		var data metricdata.ResourceMetrics
+		require.NoError(t, gatherer.Collect(ctx, &data))
+		metrics := make(map[string]metricdata.Metrics)
+		for _, scope := range data.ScopeMetrics {
+			for _, m := range scope.Metrics {
+				metrics[m.Name] = m
+			}
+		}
+		return metrics
+	}
+
+	first := collect()
+	firstCounter, ok := first["delta.counter"].Data.(metricdata.Sum[int64])
+	require.True(t, ok)
+	assert.Equal(t, metricdata.DeltaTemporality, firstCounter.Temporality)
+	assert.Len(t, firstCounter.DataPoints, 1)
+	assert.Equal(t, int64(4), firstCounter.DataPoints[0].Value)
+	firstObservable, ok := first["delta.observable_counter"].Data.(metricdata.Sum[float64])
+	require.True(t, ok)
+	assert.Equal(t, metricdata.DeltaTemporality, firstObservable.Temporality)
+	assert.Len(t, firstObservable.DataPoints, 1)
+	assert.Equal(t, float64(3), firstObservable.DataPoints[0].Value)
+	firstHistogram, ok := first["delta.histogram"].Data.(metricdata.Histogram[float64])
+	require.True(t, ok)
+	assert.Equal(t, metricdata.DeltaTemporality, firstHistogram.Temporality)
+	assert.Len(t, firstHistogram.DataPoints, 1)
+	assert.Equal(t, uint64(1), firstHistogram.DataPoints[0].Count)
+
+	counter.Add(ctx, 3)
+	histogram.Record(ctx, 7.5)
+	observed = 5
+	second := collect()
+	secondCounter, ok := second["delta.counter"].Data.(metricdata.Sum[int64])
+	require.True(t, ok)
+	assert.Equal(t, metricdata.DeltaTemporality, secondCounter.Temporality)
+	assert.Len(t, secondCounter.DataPoints, 1)
+	assert.Equal(t, int64(3), secondCounter.DataPoints[0].Value)
+	secondObservable, ok := second["delta.observable_counter"].Data.(metricdata.Sum[float64])
+	require.True(t, ok)
+	assert.Equal(t, metricdata.DeltaTemporality, secondObservable.Temporality)
+	assert.Len(t, secondObservable.DataPoints, 1)
+	assert.Equal(t, float64(2), secondObservable.DataPoints[0].Value)
+	secondHistogram, ok := second["delta.histogram"].Data.(metricdata.Histogram[float64])
+	require.True(t, ok)
+	assert.Equal(t, metricdata.DeltaTemporality, secondHistogram.Temporality)
+	assert.Len(t, secondHistogram.DataPoints, 1)
+	assert.Equal(t, uint64(1), secondHistogram.DataPoints[0].Count)
+}
