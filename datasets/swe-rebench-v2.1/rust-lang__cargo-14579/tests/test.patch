+#[cargo_test]
+fn home_config_works_without_extension() {
+    write_config_at(
+        paths::cargo_home().join("config"),
+        "\
+[foo]
+f1 = 1
+",
+    );
+    let p = project_in_home("foo").file("src/lib.rs", "").build();
+
+    p.cargo("-vV")
+        .with_stderr_data(str![[r#"
+[WARNING] `[ROOT]/home/.cargo/config` is deprecated in favor of `config.toml`
+[NOTE] if you need to support cargo 1.38 or earlier, you can symlink `config` to `config.toml`
+
+"#]])
+        .run();
+}
+
+#[cargo_test]
+fn home_config_ambiguous_filename_warns_once() {
+    write_config_at(
+        paths::cargo_home().join("config"),
+        "\
+[foo]
+f1 = 1
+",
+    );
+    write_config_at(
+        paths::cargo_home().join("config.toml"),
+        "\
+[foo]
+f1 = 2
+",
+    );
+    let p = project_in_home("foo").file("src/lib.rs", "").build();
+
+    p.cargo("-vV")
+        .with_stderr_data(str![[r#"
+[WARNING] both `[ROOT]/home/.cargo/config` and `[ROOT]/home/.cargo/config.toml` exist. Using `[ROOT]/home/.cargo/config`
+
+"#]])
+        .run();
+}
