diff --git a/test/samples/for-of.js b/test/samples/for-of.js
index ec9b643..0a6f6a9 100644
--- a/test/samples/for-of.js
+++ b/test/samples/for-of.js
@@ -225,3 +225,41 @@ module.exports = [
 			}`
 	}
 ];
+
+// Assignment patterns in for-of heads must be transpiled; retaining native
+// for-of syntax itself is permitted.
+var assert = require('assert');
+var buble = require('../../dist/buble.umd.js');
+
+describe('destructuring assignments in for-of heads', function () {
+	function run(input) {
+		var code = buble.transform(input, {
+			transforms: { dangerousForOf: true }
+		}).code;
+
+		assert(!/\bfor\s*\(\s*(?:\{[^}]*\}|\[[^\]]*\])\s*of\b/.test(code), 'destructuring pattern remains in for-of head');
+		return Function(code + '\nreturn seen;')();
+	}
+
+	it('transpiles object-pattern assignments and assigns each iteration value', function () {
+		var result = run(`
+			var x, y, seen = [];
+			for ({x, y} of [{x: 1, y: 2}, {x: 3, y: 4}]) {
+				seen.push([x, y]);
+			}
+		`);
+
+		assert.deepEqual(result, [[1, 2], [3, 4]]);
+	});
+
+	it('transpiles array-pattern assignments and assigns each iteration value', function () {
+		var result = run(`
+			var x, y, seen = [];
+			for ([x, y] of [[1, 2], [3, 4]]) {
+				seen.push([x, y]);
+			}
+		`);
+
+		assert.deepEqual(result, [[1, 2], [3, 4]]);
+	});
+});
