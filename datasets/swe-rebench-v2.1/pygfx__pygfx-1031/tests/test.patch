+import numpy as np
+from pygfx.utils import cm
+
+
+def test_sparse_colormap_interpolates_across_full_range():
+    data = cm.create_colormap([(0, 0, 0), (1, 1, 1)]).texture.data
+    assert data.ndim == 2
+    assert data.shape[1] == 4
+    assert len(data) > 2
+    np.testing.assert_allclose(data[0, :3], (0, 0, 0), atol=1e-6)
+    np.testing.assert_allclose(data[-1, :3], (1, 1, 1), atol=1e-6)
+    assert np.all((data[1:-1, :3] > 0) & (data[1:-1, :3] < 1))
