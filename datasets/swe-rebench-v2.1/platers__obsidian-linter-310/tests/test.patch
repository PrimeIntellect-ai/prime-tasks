+describe('Disabled YAML Timestamp', () => {
+  it('does not add a timestamp when all rules are disabled in frontmatter', () => {
+    const text = dedent`
+      ---
+      disabled rules: [all]
+      ---
+      Note content
+    `;
+    const ruleConfigs = Object.fromEntries(rules.map((rule) => [rule.name, rule.getDefaultOptions()]));
+    const timestampRule = rules.find((rule) => rule.alias() === 'yaml-timestamp');
+    ruleConfigs[timestampRule.name][timestampRule.enabledOptionName()] = true;
+    ruleConfigs[timestampRule.name]['Date Created'] = true;
+    const plugin = Object.create(LinterPlugin.prototype) as LinterPlugin;
+    plugin.settings = {ruleConfigs, foldersToIgnore: []} as any;
+
+    const result = plugin.lintText(text, {
+      basename: 'note',
+      stat: {ctime: 1659024000000, mtime: 1659024000000},
+    } as any);
+
+    expect(result).not.toMatch(/date (created|modified):/);
+  });
+});
