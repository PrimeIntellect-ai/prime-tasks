+describe('route tree rebuild after lazy preload', () => {
+  it('keeps the route id consistent after preloading a lazy route and rebuilding the route tree', async () => {
+    const rootRoute = createRootRoute()
+    const protectedRoute = createRoute({
+      getParentRoute: () => rootRoute,
+      id: '_protected',
+    })
+    const testRoute = createRoute({
+      getParentRoute: () => protectedRoute,
+      path: '/test',
+    }).lazy(() =>
+      import('./lazy/heavy').then((d) => d.default('/_protected/test')),
+    )
+
+    const routeTree = rootRoute.addChildren([
+      protectedRoute.addChildren([testRoute]),
+    ])
+
+    const router = createRouter({
+      routeTree,
+      history: createMemoryHistory({ initialEntries: ['/'] }),
+    })
+
+    expect(testRoute.id).toBe('/_protected/test')
+
+    await router.preloadRoute({ to: '/test' })
+
+    router.buildRouteTree()
+    router.buildRouteTree()
+    router.buildRouteTree()
+
+    expect(testRoute.id).toBe('/_protected/test')
+    expect(router.routesById['/_protected/test']).toBe(testRoute)
+  })
+})
