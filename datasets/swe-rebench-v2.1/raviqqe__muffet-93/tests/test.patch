+				200,
+				pageURL,
+				"text/html",
+				[]byte(`<a name="legacy-target"></a><section id="current-target"></section>`),
+			), nil
+		}),
+	)
+
+	go checker.Check(createTestPage(t, nil, map[string]error{
+		pageURL + "#legacy-target":  nil,
+		pageURL + "#current-target": nil,
+	}))
