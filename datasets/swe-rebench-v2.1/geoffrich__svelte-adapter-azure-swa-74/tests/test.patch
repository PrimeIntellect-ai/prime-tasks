diff --git a/test/headers.test.js b/test/headers.test.js
new file mode 100644
index 0000000..1ab985d
--- /dev/null
+++ b/test/headers.test.js
@@ -0,0 +1,122 @@
+import { installPolyfills } from '@sveltejs/kit/node/polyfills';
+import { expect, describe, test, vi } from 'vitest';
+
+installPolyfills();
+
+// The generated serverless function imports the SvelteKit server and manifest,
+// which are substituted at build time. Mock them so the response handling can be
+// exercised directly. SvelteKit combines multiple cookies into a single
+// Set-Cookie header in the build, which is the scenario reported in the issue.
+vi.mock('SERVER', () => ({
+	Server: class {
+		init() {}
+		async respond() {
+			const headers = new Headers();
+			headers.append('Content-Type', 'text/plain');
+			headers.append('Set-Cookie', 'key1=val1; Path=/, key2=val2; Path=/, key3=val3; Path=/');
+			return new Response('ok', { status: 200, headers });
+		}
+	}
+}));
+
+vi.mock('MANIFEST', () => ({ manifest: {} }));
+
+globalThis.DEBUG = false;
+
+describe('header processing', () => {
+	test('no cookies', async () => {
+		const { splitCookiesFromHeaders } = await import('../files/headers');
+
+		const headers = new Headers();
+		headers.append('Location', '/');
+		headers.append('Content-Type', 'application/json');
+
+		const cookies = splitCookiesFromHeaders(headers);
+
+		expect(cookies).toEqual({
+			cookies: [],
+			headers: {
+				'content-type': 'application/json',
+				location: '/'
+			}
+		});
+	});
+
+	test('multiple cookies', async () => {
+		const { splitCookiesFromHeaders } = await import('../files/headers');
+
+		const headers = new Headers();
+
+		// https://httpwg.org/specs/rfc7231.html#http.date
+		const exp1 = 'Sun, 06 Nov 1994 08:49:37 GMT';
+		const exp2 = 'Sunday, 06-Nov-94 08:49:37 GMT';
+		const exp3 = 'Sun Nov  6 08:49:37 1994 GMT';
+
+		headers.append('Set-Cookie', `key1=val1; Expires=${exp1}`);
+		headers.append('Set-Cookie', `key2=val2; Expires=${exp2}`);
+		headers.append('Set-Cookie', `key3=val3; Expires=${exp3}`);
+
+		const cookies = splitCookiesFromHeaders(headers);
+
+		expect(cookies.headers).toEqual({});
+		expect(cookies.cookies).toHaveLength(3);
+		expect(
+			cookies.cookies.map((cookie) => ({
+				name: cookie.name,
+				value: cookie.value,
+				expires: cookie.expires
+			}))
+			.sort((a, b) => a.name.localeCompare(b.name))
+		).toEqual([
+			{ name: 'key1', value: 'val1', expires: new Date('1994-11-06T08:49:37.000Z') },
+			{ name: 'key2', value: 'val2', expires: new Date('1994-11-06T08:49:37.000Z') },
+			{ name: 'key3', value: 'val3', expires: new Date('1994-11-06T08:49:37.000Z') }
+		]);
+	});
+
+	test('cookies combined into a single header', async () => {
+		const { splitCookiesFromHeaders } = await import('../files/headers');
+
+		const headers = new Headers();
+		headers.append('Content-Type', 'text/plain');
+		headers.append('Set-Cookie', 'key1=val1; Path=/, key2=val2; Path=/');
+
+		const cookies = splitCookiesFromHeaders(headers);
+
+		expect(cookies.headers).toEqual({ 'content-type': 'text/plain' });
+		expect(
+			cookies.cookies
+				.map(({ name, value, path }) => ({ name, value, path }))
+				.sort((a, b) => a.name.localeCompare(b.name))
+		).toEqual([
+			{ name: 'key1', value: 'val1', path: '/' },
+			{ name: 'key2', value: 'val2', path: '/' }
+		]);
+	});
+});
+
+describe('build response', () => {
+	test('sets every cookie from a combined Set-Cookie header', async () => {
+		const { index } = await import('../files/entry.js');
+
+		const context = {
+			req: {
+				method: 'GET',
+				headers: { 'x-ms-original-url': 'https://example.com/' },
+				rawBody: null
+			},
+			log: () => {},
+			res: undefined
+		};
+
+		await index(context);
+
+		expect(context.res.cookies).toBeDefined();
+		expect(context.res.cookies.map((cookie) => `${cookie.name}=${cookie.value}`).sort()).toEqual([
+			'key1=val1',
+			'key2=val2',
+			'key3=val3'
+		]);
+		expect(context.res.headers['set-cookie']).toBeUndefined();
+	});
+});
