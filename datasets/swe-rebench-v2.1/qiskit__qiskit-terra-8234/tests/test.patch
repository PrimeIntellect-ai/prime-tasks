+    def test_qasm_unitary_noop(self):
+        """Test that an identifier unitary can be converted to OpenQASM 2"""
+        qc = QuantumCircuit(QuantumRegister(3, "q0"))
+        qc.unitary(numpy.eye(8), qc.qubits, label="unitary_identity")
+        exported = qc.qasm()
+        restored = QuantumCircuit.from_qasm_str(exported)
+        self.assertTrue(Operator(restored).equiv(Operator(qc)))
+
+    def test_qasm_nontrivial_unitary_preserves_operation(self):
+        """A nontrivial optimized unitary body preserves its operation."""
+        qr = QuantumRegister(3, name="qr")
+        subcircuit = QuantumCircuit(qr, name="subcircuit")
+        subcircuit.append(CXGate(), qargs=[qr[0], qr[1]], cargs=[])
+        subcircuit.append(CU1Gate(3), qargs=[qr[0], qr[1]], cargs=[])
+        circuit = QuantumCircuit(qr)
+        circuit.append(subcircuit, qargs=qr)
+        circuit.append(subcircuit, qargs=qr)
+        circuit = transpile(circuit, optimization_level=3)
+
+        restored = QuantumCircuit.from_qasm_str(circuit.qasm())
+        self.assertTrue(Operator(restored).equiv(Operator(circuit)))
+
+    def test_qasm_unitary_unused_qubits(self):
+        """Test that the reported optimized circuit exports readable QASM.
+
+        Regression test for the reported issue: transpiling a circuit that
+        contains ``CXGate`` and ``CU1Gate`` at optimization level 3 produced a
+        ``UnitaryGate`` whose OpenQASM 2 definition was empty, so the exported
+        QASM could not be read back.
+        """
+        qr = QuantumRegister(3, name="qr")
+        cr = ClassicalRegister(3, name="cr")
+        qc = QuantumCircuit(qr, cr, name="qc")
+        subcircuit = QuantumCircuit(qr, name="subcircuit")
+        subcircuit.append(CXGate(), qargs=[qr[0], qr[1]], cargs=[])
+        subcircuit.append(CU1Gate(3), qargs=[qr[0], qr[1]], cargs=[])
+        qc.append(subcircuit, qargs=qr)
+        qc.append(subcircuit.inverse(), qargs=qr)
+        qc.measure(qr, cr)
+        qc = transpile(qc, optimization_level=3)
+
+        exported = qc.qasm()
+        # The exported QASM must be readable again (no empty gate definition).
+        parsed = QuantumCircuit.from_qasm_str(exported)
+        self.assertEqual(parsed.num_qubits, 3)
+
