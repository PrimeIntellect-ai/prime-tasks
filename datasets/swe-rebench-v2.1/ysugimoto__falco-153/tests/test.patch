+func TestEmptyReturnStatement(t *testing.T) {
+	t.Run("Error on state-machine-methods", func(t *testing.T) {
+		// The public contract requires rejecting an empty return in vcl_recv.
+		// Implementations may or may not extend this rule to other
+		// state-machine subroutines, so only the contract-mandated case is
+		// asserted here.
+		input := `
+sub vcl_recv {
+#FASTLY RECV
+return;
+}`
+		assertError(t, input)
+	})
+}
