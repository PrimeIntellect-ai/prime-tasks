diff --git a/test/sam.c b/test/sam.c
index 036349f..172819a 100644
--- a/test/sam.c
+++ b/test/sam.c
@@ -281,6 +281,17 @@ static int aux_fields1(void)
 
     size_t nvals, i;
 
+    {
+        bam1_t *empty = bam_init1();
+        if (!empty)
+            fail("could not allocate empty alignment for aux iteration");
+        else {
+            if (bam_aux_first(empty) != NULL)
+                fail("empty alignment has an auxiliary field");
+            bam_destroy1(empty);
+        }
+    }
+
     if (sam_read1(in, header, aln) >= 0) {
         if ((p = check_bam_aux_get(aln, "XA", 'A')) && bam_aux2A(p) != 'k')
             fail("XA field is '%c', expected 'k'", bam_aux2A(p));
@@ -289,6 +300,37 @@ static int aux_fields1(void)
         if (bam_aux_get(aln,"XA"))
             fail("XA field was not deleted");
 
+        {
+            static const char expected_tags[][2] = {
+                {'X', 'i'}, {'X', 'f'}, {'X', 'd'}, {'X', 'Z'}, {'X', 'H'},
+                {'X', 'B'}, {'B', '0'}, {'B', '1'}, {'B', '2'}, {'B', '3'},
+                {'B', '4'}, {'B', '5'}, {'B', 'f'}, {'Z', 'Z'}, {'F', '2'},
+                {'Y', '1'}, {'Y', '2'}, {'Y', '3'}, {'Y', '4'}, {'Y', '5'},
+                {'Y', '6'}, {'Y', '7'}, {'Y', '8'}
+            };
+            const uint8_t *itr;
+            int n = 0, saw_y2 = 0, saw_y3 = 0, saw_y8 = 0;
+
+            for (itr = bam_aux_first(aln); itr; itr = bam_aux_next(aln, itr)) {
+                if (n >= NELE(expected_tags) ||
+                    memcmp(itr - 2, expected_tags[n], 2) != 0)
+                    fail("auxiliary fields were not visited in record order");
+                n++;
+                if (itr[-2] == 'Y' && itr[-1] == '2') {
+                    if (*itr != 'i') fail("Y2 field has an unexpected type");
+                    saw_y2 = 1;
+                } else if (itr[-2] == 'Y' && itr[-1] == '3') {
+                    if (*itr != 'c') fail("Y3 field has an unexpected type");
+                    saw_y3 = 1;
+                } else if (itr[-2] == 'Y' && itr[-1] == '8') {
+                    if (*itr != 'I') fail("Y8 field has an unexpected type");
+                    saw_y8 = 1;
+                }
+            }
+            if (n != NELE(expected_tags) || !saw_y2 || !saw_y3 || !saw_y8)
+                fail("auxiliary field iteration missed a field");
+        }
+
         if ((p = check_bam_aux_get(aln, "Xi", 'C')) && bam_aux2i(p) != 37)
             fail("Xi field is %"PRId64", expected 37", bam_aux2i(p));
 
@@ -2246,5 +2288,12 @@ int main(int argc, char **argv)
     test_bam_set1_write_and_read_back();
     test_cigar_api();
 
+    /* Emit a named result so the test harness can attribute this test's
+       outcome (the rest of the suite is driven by test.pl). */
+    if (status == EXIT_SUCCESS)
+        printf("sam: .. ok\n\n");
+    else
+        printf("sam: .. failed\n\n");
+
     return status;
 }
