+def test_tidy_imports_black_explicit_width_without_black_config(tmp_path):
+    from pathlib import Path
+
+    (tmp_path / "pyproject.toml").write_text("")
+    source = "from somepackage import alphaone, alphatwo, alphathree, alphafour, alphafive\n"
+    command = [
+        sys.executable,
+        str(Path(__file__).parents[1] / "bin" / "tidy-imports"),
+        "--black",
+        "--width=40",
+        "--no-add-missing",
+        "--no-remove-unused",
+        "--no-add-mandatory",
+        "--no-canonicalize",
+        "--print",
+    ]
+    result = subprocess.run(
+        command, input=source, text=True, capture_output=True, cwd=tmp_path
+    )
+    assert result.returncode == 0
+    lines = result.stdout.splitlines()
+    import_start = next(
+        i for i, line in enumerate(lines)
+        if line.startswith("from somepackage import")
+    )
+    import_block = [lines[import_start]]
+    if "(" in lines[import_start]:
+        import_block = lines[import_start:next(
+            i for i in range(import_start + 1, len(lines)) if ")" in lines[i]
+        ) + 1]
+    assert max(map(len, import_block)) <= 40
