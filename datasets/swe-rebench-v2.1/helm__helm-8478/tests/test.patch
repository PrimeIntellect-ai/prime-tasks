+
+func TestUpdateUnmanagedRepositoryRange(t *testing.T) {
+	server, err := repotest.NewTempServer("testdata/*.tgz*")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Stop()
+	if err := server.LinkIndices(); err != nil {
+		t.Fatal(err)
+	}
+
+	root := t.TempDir()
+	chartDir := filepath.Join(root, "parent")
+	dependency := &chart.Dependency{
+		Name:       "local-subchart",
+		Repository: server.URL(),
+		Version:    "^0.1.0",
+	}
+	parent := &chart.Chart{Metadata: &chart.Metadata{
+		Name:         "parent",
+		Version:      "1.0.0",
+		APIVersion:   "v2",
+		Dependencies: []*chart.Dependency{dependency},
+	}}
+	if err := chartutil.SaveDir(parent, root); err != nil {
+		t.Fatal(err)
+	}
+
+	t.Setenv("HELM_CACHE_HOME", root)
+	cacheDir := filepath.Join(root, "repository")
+	configPath := filepath.Join(root, "repositories.yaml")
+	manager := &Manager{
+		ChartPath: chartDir,
+		Out:       &bytes.Buffer{},
+		Getters: getter.Providers{getter.Provider{
+			Schemes: []string{"http", "https"},
+			New:     getter.NewHTTPGetter,
+		}},
+		RepositoryConfig: configPath,
+		RepositoryCache:  cacheDir,
+	}
+	if err := manager.Update(); err != nil {
+		t.Fatal(err)
+	}
+
+	lockData, err := os.ReadFile(filepath.Join(chartDir, "Chart.lock"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var lock chart.Lock
+	if err := yaml.Unmarshal(lockData, &lock); err != nil {
+		t.Fatal(err)
+	}
+	if len(lock.Dependencies) != 1 {
+		t.Fatalf("expected one locked dependency, got %d", len(lock.Dependencies))
+	}
+	if lock.Dependencies[0].Version != "0.1.0" {
+		t.Errorf("expected a concrete locked version matching the requested range, got %q", lock.Dependencies[0].Version)
+	}
+
+	configData, err := os.ReadFile(configPath)
+	if err == nil {
+		var config struct {
+			Repositories []*repo.Entry `yaml:"repositories"`
+		}
+		if err := yaml.Unmarshal(configData, &config); err != nil {
+			t.Fatal(err)
+		}
+		for _, entry := range config.Repositories {
+			if entry.URL == server.URL() {
+				t.Errorf("unmanaged repository URL was added to user repository configuration")
+			}
+		}
+	} else if !os.IsNotExist(err) {
+		t.Fatal(err)
+	}
+}
