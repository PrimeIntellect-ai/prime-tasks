+// foreignLayer wraps a v1.Layer and reports a foreign (non-distributable)
+// media type so that it is skipped when pushed.
+type foreignLayer struct {
+	v1.Layer
+}
+
+func (f foreignLayer) MediaType() (types.MediaType, error) {
+	return types.DockerForeignLayer, nil
+}
+
+// TestRebaseForeignLayers ensures that rebasing an image onto a new base that
+// contains a foreign layer preserves the foreign layer's descriptor (media type
+// and URLs) so that the rebased image remains usable.
+func TestRebaseForeignLayers(t *testing.T) {
+	// Set up a fake registry.
+	s := httptest.NewServer(registry.New())
+	defer s.Close()
+	u, err := url.Parse(s.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Build a new base image whose only layer is a foreign layer with a URL.
+	fl, err := random.Layer(1024, types.DockerLayer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	newBase, err := mutate.Append(empty.Image, mutate.Addendum{
+		Layer: foreignLayer{fl},
+		URLs:  []string{"http://example.com/foreign"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	newBaseRef, err := name.ParseReference(fmt.Sprintf("%s/newbase:latest", u.Host))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := Write(newBaseRef, newBase); err != nil {
+		t.Fatalf("Write(newBase): %v", err)
+	}
+
+	// Pull the new base back so that its layers are remote layers.
+	pulledNewBase, err := Image(newBaseRef)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Build an original image based on an old base.
+	oldBase := setupImage(t)
+	top, err := random.Layer(1024, types.DockerLayer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	orig, err := mutate.AppendLayers(oldBase, top)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Rebase the original image onto the new base.
+	rebased, err := mutate.Rebase(orig, oldBase, pulledNewBase)
+	if err != nil {
+		t.Fatalf("Rebase: %v", err)
+	}
+
+	// The rebased image must retain the foreign layer's descriptor, including
+	// its media type and URLs, otherwise the foreign layer can no longer be
+	// fetched.
+	m, err := rebased.Manifest()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(m.Layers) == 0 {
+		t.Fatal("rebased image has no layers")
+	}
+	if got, want := m.Layers[0].MediaType, types.DockerForeignLayer; got != want {
+		t.Errorf("rebased foreign layer media type = %q, want %q", got, want)
+	}
+	if got, want := m.Layers[0].URLs, []string{"http://example.com/foreign"}; !cmp.Equal(got, want) {
+		t.Errorf("rebased foreign layer URLs = %v, want %v", got, want)
+	}
+
+	// The rebased image must be pushable.
+	rebasedRef, err := name.ParseReference(fmt.Sprintf("%s/rebased:latest", u.Host))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := Write(rebasedRef, rebased); err != nil {
+		t.Fatalf("Write(rebased): %v", err)
+	}
+}
