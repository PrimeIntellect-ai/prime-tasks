+func TestUpdateAccessApplicationClearsSAMLCustomAttributes(t *testing.T) {
+	setup()
+	defer teardown()
+
+	handler := func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if !assert.NoError(t, err) {
+			return
+		}
+		var request map[string]json.RawMessage
+		if !assert.NoError(t, json.Unmarshal(body, &request)) {
+			return
+		}
+		var saasApp map[string]json.RawMessage
+		if !assert.NoError(t, json.Unmarshal(request["saas_app"], &saasApp)) {
+			return
+		}
+		rawAttributes, present := saasApp["custom_attributes"]
+		assert.True(t, present, "an empty array must be sent to clear existing attributes")
+		if present {
+			var attributes []any
+			if assert.NoError(t, json.Unmarshal(rawAttributes, &attributes)) {
+				assert.Equal(t, []any{}, attributes, "custom attributes must be an empty array")
+			}
+		}
+		w.Header().Set("content-type", "application/json")
+		fmt.Fprint(w, `{"success":true,"result":{}}`)
+	}
+	mux.HandleFunc("/accounts/"+testAccountID+"/access/apps/"+testAccessApplicationID, handler)
+
+	var params UpdateAccessApplicationParams
+	err := json.Unmarshal([]byte(`{"id":"`+testAccessApplicationID+`","name":"SAML app","domain":"example.com","saas_app":{"custom_attributes":[]}}`), &params)
+	if !assert.NoError(t, err) {
+		return
+	}
+	_, err = client.UpdateAccessApplication(context.Background(), AccountIdentifier(testAccountID), params)
+	assert.NoError(t, err)
+}
