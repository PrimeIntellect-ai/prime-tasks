+func TestFxModuleGraphExcludesBenbjohnsonClockModule(t *testing.T) {
+	cmd := exec.Command("go", "list", "-m", "all")
+	cmd.Dir = "../.."
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("could not inspect Go module graph: %v\n%s", err, output)
+	}
+
+	for _, module := range strings.Fields(string(output)) {
+		if strings.SplitN(module, "@", 2)[0] == "github.com/benbjohnson/clock" {
+			t.Fatalf("archived clock module remains in dependency graph: %s", module)
+		}
+	}
+}
