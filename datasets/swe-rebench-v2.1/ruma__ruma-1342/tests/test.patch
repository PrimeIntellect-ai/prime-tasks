+
+#[test]
+fn make_replacement_no_reply() {
+    let content = RoomMessageEventContent::text_html(
+        "This is _an edited_ message.",
+        "This is <em>an edited</em> message.",
+    );
+    let event_id = event_id!("$143273582443PhrSn:example.org").to_owned();
+
+    let content = content.make_replacement(event_id.clone(), None);
+
+    // The replacement relation must reference the original event and carry the new content.
+    let replacement = match content.relates_to {
+        Some(Relation::Replacement(replacement)) => replacement,
+        other => panic!("expected a replacement relation, got {other:?}"),
+    };
+    assert_eq!(replacement.event_id, event_id);
+    assert_matches!(
+        replacement.new_content,
+        MessageType::Text(TextMessageEventContent { body, .. })
+            if body == "This is _an edited_ message."
+    );
+
+    let (body, formatted) = assert_matches!(
+        content.msgtype,
+        MessageType::Text(TextMessageEventContent { body, formatted, .. }) => (body, formatted)
+    );
+    let has_fallback = !body.trim().is_empty()
+        || formatted.as_ref().map_or(false, |formatted| !formatted.body.trim().is_empty());
+    assert!(has_fallback, "replacement content must provide a fallback");
+}
+
+#[test]
+fn make_replacement_with_reply() {
+    let replied_to_message = OriginalRoomMessageEvent {
+        content: RoomMessageEventContent::text_html(
+            "# This is the first message",
+            "<h1>This is the first message</h1>",
+        ),
+        event_id: event_id!("$143273582443PhrSn:example.org").to_owned(),
+        origin_server_ts: MilliSecondsSinceUnixEpoch(uint!(10_000)),
+        room_id: room_id!("!testroomid:example.org").to_owned(),
+        sender: user_id!("@user:example.org").to_owned(),
+        unsigned: MessageLikeUnsigned::default(),
+    };
+
+    let content = RoomMessageEventContent::text_html(
+        "This is _an edited_ reply.",
+        "This is <em>an edited</em> reply.",
+    );
+    let event_id = event_id!("$143273582443PhrSn:example.org").to_owned();
+
+    let content = content.make_replacement(event_id.clone(), Some(&replied_to_message));
+
+    // The replacement relation must reference the original event and carry the new content.
+    let replacement = match content.relates_to {
+        Some(Relation::Replacement(replacement)) => replacement,
+        other => panic!("expected a replacement relation, got {other:?}"),
+    };
+    assert_eq!(replacement.event_id, event_id);
+    assert_matches!(
+        replacement.new_content,
+        MessageType::Text(TextMessageEventContent { body, .. })
+            if body == "This is _an edited_ reply."
+    );
+
+    let (body, formatted) = assert_matches!(
+        content.msgtype,
+        MessageType::Text(TextMessageEventContent { body, formatted, .. }) => (body, formatted)
+    );
+    let fallback = format!(
+        "{body} {}",
+        formatted.as_ref().map_or("", |formatted| formatted.body.as_str())
+    );
+    assert!(fallback.contains("first message"), "reply fallback must be included");
+}
