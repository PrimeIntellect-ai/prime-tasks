+func TestGroup_RouteNotFoundMiddlewareFallbackRegression(t *testing.T) {
+	testCases := []struct {
+		name     string
+		whenURL  string
+		wantBody string
+	}{
+		{
+			name:     "root fallback handles unmatched root-level path",
+			whenURL:  "/test3",
+			wantBody: "root fallback",
+		},
+		{
+			name:     "group fallback handles unmatched path with middleware",
+			whenURL:  "/group/test3",
+			wantBody: "group fallback",
+		},
+	}
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			e := New()
+			e.RouteNotFound("/*", func(c Context) error {
+				return c.String(http.StatusNotFound, "root fallback")
+			})
+
+			g := e.Group("/group")
+			g.Use(func(next HandlerFunc) HandlerFunc {
+				return func(c Context) error {
+					return next(c)
+				}
+			})
+			g.RouteNotFound("/*", func(c Context) error {
+				return c.String(http.StatusNotFound, "group fallback")
+			})
+
+			req := httptest.NewRequest(http.MethodGet, tc.whenURL, nil)
+			rec := httptest.NewRecorder()
+			e.ServeHTTP(rec, req)
+
+			assert.Equal(t, http.StatusNotFound, rec.Code)
+			assert.Equal(t, tc.wantBody, rec.Body.String())
+		})
+	}
+}
