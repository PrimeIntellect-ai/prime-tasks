+function compatible_constructor(constructor, kwargs)
+    try
+        return constructor(; kwargs..., actevap = fill(0.0, length(kwargs.area)))
+    catch err
+        err isa MethodError || rethrow()
+        return constructor(; kwargs...)
+    end
+end
