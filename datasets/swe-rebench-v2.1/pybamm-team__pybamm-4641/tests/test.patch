+import pytest
+import pybamm
+
+
+@pytest.mark.parametrize(
+    "test_string, unit_string",
+    [
+        ("123e-1 W", "W"),
+        ("-1.1729285959021311e-05 W", "W"),
+        ("123K", "K"),
+        ("1A", "A"),
+        ("2.0 mV", "mV"),
+        ("0.5 Ohm", "Ohm"),
+        ("1e0hours", "hours"),
+    ],
+)
+def test_read_units(test_string, unit_string):
+    assert unit_string == pybamm.experiment.step.base_step.get_unit_from(test_string)
+
+
+@pytest.mark.parametrize(
+    "test_string, expected_value",
+    [
+        ("Discharge at 1.1729285959021311e-05 W for 1 hour", 1.1729285959021311e-05),
+        ("Discharge at 1e0 A for 1 hour", 1.0),
+        ("Discharge at 1E0 V for 1 hour", 1.0),
+        ("Charge at 1.5e-3 Ohm for 1 hour", -1.5e-3),
+        ("Discharge at -1.1729285959021311e-05 W for 1 hour", -1.1729285959021311e-05),
+        ("Discharge at 2.5e-1 mV for 1 hour", 2.5e-4),
+    ],
+)
+def test_parse_electric_with_exponent(test_string, expected_value):
+    step = pybamm.step.string(test_string)
+    assert step.value == pytest.approx(expected_value)
