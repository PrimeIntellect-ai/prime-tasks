+int foo() {
+  return 42;
+}
+
+int bar() __attribute__((ifunc("resolve_bar")));
+
+void *resolve_bar() { return foo; }
+
+typedef int (*int_f_ptr_t)(void);
+
+int_f_ptr_t bar2 = bar;
