+fn multiple_fix_rule_yaml() -> String {
+  r"
+id: test-id
+message: test rule
+severity: info
+language: TypeScript
+rule:
+  pattern: foo
+fix:
+  - template: bar
+    title: first option
+  - template: baz
+    title: second option"
+    .to_string()
+}
+
+#[test]
+fn test_rule_accepts_multiple_fix_options() {
+  let globals = GlobalRules::default();
+  let rule = from_yaml_string::<SgLang>(&multiple_fix_rule_yaml(), &globals)
+    .expect("a rule may provide multiple fix alternatives")
+    .into_iter()
+    .next()
+    .expect("the rule should be parsed");
+  let matcher = rule.get_matcher(&globals).expect("rule should compile");
+  let fixers = rule
+    .get_fixer()
+    .expect("fix alternatives should be available");
+  assert_eq!(fixers.len(), 2, "both alternatives must be available");
+  let titles: Vec<_> = fixers.iter().map(|fixer| fixer.title()).collect();
+  assert_eq!(titles, [Some("first option"), Some("second option")]);
+  let lang = SgLang::from(SupportLang::TypeScript);
+  let grep = lang.ast_grep("foo");
+  let matched = grep.root().find("foo").expect("the rule should match");
+  let replacements: Vec<_> = fixers
+    .iter()
+    .map(|fixer| {
+      let edit = matched.make_edit(&matcher, fixer);
+      String::from_utf8(edit.inserted_text).expect("replacement is UTF-8")
+    })
+    .collect();
+  assert_eq!(replacements, ["bar", "baz"]);
+}
+
+#[test]
+fn test_bulk_scan_uses_first_fix_alternative() {
+  let dir = tempfile::tempdir().expect("temporary directory");
+  let source = dir.path().join("input.ts");
+  std::fs::write(&source, "const item = foo;\n").expect("write source");
+  let binary = std::env::current_exe()
+    .expect("test executable path")
+    .parent()
+    .and_then(std::path::Path::parent)
+    .expect("Cargo target directory")
+    .join("ast-grep");
+  let output = Command::new(&binary)
+    .args([
+      "scan",
+      "--inline-rules",
+      multiple_fix_rule_yaml().as_str(),
+      "--color",
+      "never",
+      "--report-style",
+      "rich",
+    ])
+    .arg(&source)
+    .output()
+    .expect("scan should run");
+  assert!(output.status.success(), "scan should accept the rule");
+  let stdout = String::from_utf8(output.stdout).expect("scan output is UTF-8");
+  assert!(stdout.contains("+const item = bar;"), "{stdout}");
+  assert!(!stdout.contains("+const item = baz;"), "{stdout}");
+}
