+@patch('pyinaturalist.v1.observations.update_observation')
+def test_upload__with_photo_ids(mock_update_observation, requests_mock):
+    requests_mock.register_uri(ANY, ANY, json={'id': 5678})
+    operation_response = MagicMock()
+    payload = {'id': 5678}
+    operation_response.json.return_value = payload
+    mock_update_observation.return_value = operation_response
+
+    observation_ids = (1234, 2345)
+    responses = [
+        upload(observation_id, access_token='token', photo_ids=[5678])
+        for observation_id in observation_ids
+    ]
+
+    if mock_update_observation.called:
+        attached_observations = set()
+        for call in mock_update_observation.call_args_list:
+            args, kwargs = call
+            observation_id = kwargs.get('observation_id', args[0] if args else None)
+            passed_ids = kwargs.get('photo_ids')
+            assert '5678' in str(passed_ids)
+            attached_observations.add(str(observation_id))
+        assert attached_observations == {'1234', '2345'}
+    else:
+        for observation_id in observation_ids:
+            assert any(
+                str(observation_id) in f'{request.url} {request.body}'
+                and '5678' in f'{request.url} {request.body}'
+                for request in requests_mock.request_history
+            )
+    assert responses == [[payload], [payload]]
+
