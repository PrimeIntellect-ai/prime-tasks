+def test_parse_environment_yml__editable_self_dependency__no_error_logged(
+    write_tmp_files, caplog
+):
+    environment_yml = """\
+        name: myenv
+        channels:
+          - conda-forge
+        dependencies:
+          # Core Python and conda packages
+          - python=3.12
+          - pip
+          - setuptools
+
+          # Pip packages
+          - pip:
+            - -e ./
+        """
+    tmp_path = write_tmp_files({"environment.yml": environment_yml})
+    path = tmp_path / "environment.yml"
+
+    caplog.set_level(logging.ERROR)
+    result = list(parse_environment_yml(path))
+    names = {dep.name for dep in result}
+    assert {"pip", "setuptools"} <= names
+    assert not [rec for rec in caplog.records if rec.levelno >= logging.ERROR]
+
+
