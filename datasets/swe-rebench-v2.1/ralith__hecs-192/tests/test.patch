+
+#[test]
+fn query_or() {
+    let mut world = World::new();
+    let left_only = world.spawn(("left", 123));
+    let neither = world.spawn(("neither",));
+    let right_only = world.spawn(("right", true));
+    let both = world.spawn(("both", 456, false));
+
+    let results = world
+        .query::<(&&str, Or<&i32, &bool>)>()
+        .iter()
+        .map(|(entity, _)| entity)
+        .collect::<Vec<_>>();
+
+    assert_eq!(results.len(), 3);
+    assert!(results.contains(&left_only));
+    assert!(results.contains(&right_only));
+    assert!(results.contains(&both));
+    assert!(!results.contains(&neither));
+}
+
+#[test]
+fn query_or_fetches_composite_subsets() {
+    let mut world = World::new();
+    let left_only = world.spawn((10i32, true));
+    let right_only = world.spawn((20u32, 'r'));
+    let both = world.spawn((30i32, false, 40u32, 'b'));
+    let neither = world.spawn(("neither",));
+
+    let results = world
+        .query::<Or<(&i32, &bool), (&u32, &char)>>()
+        .iter()
+        .map(|(entity, _)| entity)
+        .collect::<Vec<_>>();
+
+    assert_eq!(results.len(), 3);
+    assert!(results.contains(&left_only));
+    assert!(results.contains(&right_only));
+    assert!(results.contains(&both));
+    assert!(!results.contains(&neither));
+}
