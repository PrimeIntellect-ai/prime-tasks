+def test_from_table_csv(tmp_path, monkeypatch):
+    import pandas as pd
+    import xlrd
+
+    def not_an_excel_file(*args, **kwargs):
+        raise xlrd.biffh.XLRDError("not an Excel workbook")
+
+    monkeypatch.setattr(pd, "read_excel", not_an_excel_file)
+    path = tmp_path / "bearing.csv"
+    path.write_text(
+        "kxx,cxx,kyy,kxy,kyx,cyy,cxy,cyx,w\n"
+        "10.5,2,30,4,5,6,7,8,3000\n"
+    )
+
+    bearing = BearingElement.from_table(2, str(path))
+
+    assert_allclose(bearing.kxx.coefficient, [10.5])
