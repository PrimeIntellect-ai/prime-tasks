+	@Test
+	public void testReadTimeoutIsThrownForApiCall() throws Exception {
+		CountDownLatch requestReceived = new CountDownLatch(1);
+		HttpServer server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+		server.createContext("/api", exchange -> {
+			requestReceived.countDown();
+			try {
+				Thread.sleep(700);
+			} catch (InterruptedException e) {
+				Thread.currentThread().interrupt();
+				return;
+			}
+			byte[] body = "{}".getBytes("UTF-8");
+			try {
+				exchange.sendResponseHeaders(200, body.length);
+				exchange.getResponseBody().write(body);
+			} catch (IOException ignored) {
+				// The client may already have disconnected after its timeout.
+			} finally {
+				exchange.close();
+			}
+		});
+		server.start();
+		try {
+			BasicApiConnection api = new BasicApiConnection(
+					"http://127.0.0.1:" + server.getAddress().getPort() + "/api");
+			invokeSetReadTimeout(api, 200);
+			Map<String, String> parameters = new HashMap<>();
+			parameters.put("action", "query");
+			parameters.put("format", "json");
+			boolean threw = false;
+			try (InputStream response = api.sendRequest("POST", parameters)) {
+				Assert.fail("An API call that exceeds its read timeout must throw an exception");
+			} catch (IOException expected) {
+				threw = true;
+			}
+			assertTrue("The delayed local server should receive the API call",
+					requestReceived.await(2, TimeUnit.SECONDS));
+			assertTrue("The API call should propagate the timeout as an exception", threw);
+		} finally {
+			server.stop(0);
+		}
+	}
+
+	@Test
+	public void testNegativeTimeoutsAllowDelayedApiResponse() throws Exception {
+		HttpServer server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+		server.createContext("/api", exchange -> {
+			try {
+				Thread.sleep(400);
+				byte[] body = "{}".getBytes("UTF-8");
+				exchange.sendResponseHeaders(200, body.length);
+				exchange.getResponseBody().write(body);
+			} catch (InterruptedException e) {
+				Thread.currentThread().interrupt();
+			} catch (IOException ignored) {
+			} finally {
+				exchange.close();
+			}
+		});
+		server.start();
+		try {
+			BasicApiConnection api = new BasicApiConnection(
+					"http://127.0.0.1:" + server.getAddress().getPort() + "/api");
+			invokeSetConnectTimeout(api, -5);
+			invokeSetReadTimeout(api, -5);
+			Map<String, String> parameters = new HashMap<>();
+			parameters.put("action", "query");
+			parameters.put("format", "json");
+			try (InputStream response = api.sendRequest("POST", parameters)) {
+				assertNotNull("A negative timeout should allow the delayed response", response);
+			}
+		} finally {
+			server.stop(0);
+		}
+	}
