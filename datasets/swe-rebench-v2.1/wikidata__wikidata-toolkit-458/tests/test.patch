+	@Test
+	public void testConnectTimeoutFailsBlockedApiCall() throws Exception {
+		BasicApiConnection api = new BasicApiConnection("http://192.0.2.1:81/api");
+		invokeSetConnectTimeout(api, 500);
+		Map<String, String> parameters = new HashMap<>();
+		parameters.put("action", "query");
+		parameters.put("format", "json");
+		CountDownLatch finished = new CountDownLatch(1);
+		AtomicReference<IOException> failure = new AtomicReference<>();
+		Thread request = new Thread(() -> {
+			try (InputStream response = api.sendRequest("POST", parameters)) {
+				// A response is unexpected for this unreachable destination.
+			} catch (IOException e) {
+				failure.set(e);
+			} finally {
+				finished.countDown();
+			}
+		}, "connect-timeout-test");
+		request.setDaemon(true);
+		request.start();
+
+		assertTrue("The blocked API request should finish within a bounded time",
+				finished.await(5, TimeUnit.SECONDS));
+		assertNotNull("The unavailable network should cause the API call to fail",
+				failure.get());
+	}
+
+	private static void invokeSetConnectTimeout(ApiConnection con, int timeout) throws Exception {
