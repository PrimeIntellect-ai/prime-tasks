+		return (Integer) ApiConnection.class.getMethod("getConnectTimeout").invoke(con);
+	}
+
+	private static void invokeSetReadTimeout(ApiConnection con, int timeout) throws Exception {
+		ApiConnection.class.getMethod("setReadTimeout", int.class).invoke(con, timeout);
+	}
+
+	private static int invokeGetReadTimeout(ApiConnection con) throws Exception {
+		return (Integer) ApiConnection.class.getMethod("getReadTimeout").invoke(con);
+	}
