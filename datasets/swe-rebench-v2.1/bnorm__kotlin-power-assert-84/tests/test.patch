+package com.bnorm.power
+
+import kotlin.test.Test
+
+class VarargTest {
+  @Test
+  fun `implicit array of vararg parameters is excluded from diagram`() {
+    assertMessage(
+      """
+      fun main() {
+        var i = 0
+        assert(listOf("a", "b", "c") == listOf(i++, i++, i++))
+      }""",
+      """
+      Assertion failed
+      assert(listOf("a", "b", "c") == listOf(i++, i++, i++))
+             |                     |  |      |    |    |
+             |                     |  |      |    |    2
+             |                     |  |      |    1
+             |                     |  |      0
+             |                     |  [0, 1, 2]
+             |                     false
+             [a, b, c]
+      """.trimIndent(),
+    )
+  }
+
+  @Test
+  fun `spread non-constant array omits the synthetic array`() {
+    val message = executeAssertion(
+      """
+      fun main() {
+        val values = arrayOf("b", "a")
+        assert(values.toString().isEmpty() and (listOf("a", "c") == listOf(*values)))
+      }""",
+    )
+
+    val arrayIdentities = Regex("\\[Ljava\\.lang\\.String;@[0-9a-f]+").findAll(message)
+      .map { it.value }
+      .toSet()
+    kotlin.test.assertTrue(arrayIdentities.size <= 1, message)
+  }
+}
