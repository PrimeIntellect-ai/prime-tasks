+#[cfg(not(feature = "idna"))]
+#[test]
+fn test_idna_feature_disabled() {
+    // With the `idna` feature disabled, IDNA processing is unavailable, so a
+    // host that requires it (a non-ASCII domain) must be rejected rather than
+    // silently accepted.
+    assert!("http://你好你好".parse::<Url>().is_err());
+    assert!("http://☃.net/".parse::<Url>().is_err());
+    // ASCII-only hosts keep working without IDNA.
+    assert!("http://example.com/".parse::<Url>().is_ok());
+}
