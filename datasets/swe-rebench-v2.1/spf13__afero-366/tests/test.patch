+func TestIOFSReadDirUsesNativeEntriesWhenAvailable(t *testing.T) {
+	t.Parallel()
+
+	memfs := NewMemMapFs()
+	if err := memfs.Mkdir("dir", 0755); err != nil {
+		t.Fatal(err)
+	}
+	entries := []fs.DirEntry{iofsTestDirEntry{name: "native-entry"}}
+	iofs := NewIOFS(&iofsReadDirFs{Fs: memfs, entries: entries})
+
+	got, err := iofs.ReadDir("dir")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != len(entries) {
+		t.Fatalf("expected %d entry, got %d", len(entries), len(got))
+	}
+	if got[0].Name() != "native-entry" {
+		t.Fatalf("expected native entry, got %q", got[0].Name())
+	}
+}
+
+type iofsReadDirFs struct {
+	Fs
+	entries []fs.DirEntry
+}
+
+func (f *iofsReadDirFs) Open(name string) (File, error) {
+	file, err := f.Fs.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	return &iofsReadDirFile{File: file, entries: f.entries}, nil
+}
+
+type iofsReadDirFile struct {
+	File
+	entries []fs.DirEntry
+}
+
+func (f *iofsReadDirFile) ReadDir(n int) ([]fs.DirEntry, error) {
+	return f.entries, nil
+}
