+func Test_FindOverlaysCommandShowsShadowedOverlayOnce(t *testing.T) {
+	env := testenv.New(t)
+	defer env.RemoveAll()
+
+	env.MkdirAll(filepath.Join("usr/share/warewulf/overlays", "shared", "rootfs"))
+	env.MkdirAll(filepath.Join("var/lib/warewulf/overlays", "shared", "rootfs"))
+
+	configPath := env.GetPath("warewulf.conf")
+	config := fmt.Sprintf("paths:\n  datadir: %s\n  wwoverlaydir: %s\n",
+		env.GetPath("usr/share"),
+		env.GetPath("var/lib/warewulf/overlays"),
+	)
+	env.WriteFile("warewulf.conf", config)
+
+	_, sourceFile, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("could not determine repository location")
+	}
+	repoRoot := filepath.Clean(filepath.Join(filepath.Dir(sourceFile), "../../.."))
+	cmd := exec.Command("go", "run", "./cmd/wwctl", "--warewulfconf", configPath, "overlay", "list")
+	cmd.Dir = repoRoot
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("wwctl overlay list failed: %v\n%s", err, output)
+	}
+	assert.Equal(t, 1, strings.Count(string(output), "shared"), "the shadowed overlay should appear once")
+}
+
+func Test_FindOverlaysIgnoresNonOverlays(t *testing.T) {
+	env := testenv.New(t)
+	defer env.RemoveAll()
+
+	env.MkdirAll(filepath.Join("usr/share/warewulf/overlays", "dist"))
+	env.MkdirAll(filepath.Join("var/lib/warewulf/overlays", "site"))
+
+	// dot-prefixed directories are not overlays
+	env.MkdirAll(filepath.Join("usr/share/warewulf/overlays", ".hidden-dist"))
+	env.MkdirAll(filepath.Join("var/lib/warewulf/overlays", ".hidden-site"))
+
+	// regular files are not overlays
+	env.WriteFile(filepath.Join("usr/share/warewulf/overlays", "dist-file"), "not a directory")
+	env.WriteFile(filepath.Join("var/lib/warewulf/overlays", "site-file"), "not a directory")
+
+	overlayList := findOverlays(t)
+	assert.ElementsMatch(t, []string{"dist", "site"}, overlayList)
+}
+
+// findOverlays invokes the public FindOverlays entry point and verifies its
+// documented single []string result.
+func findOverlays(t *testing.T) []string {
+	t.Helper()
+	functionType := reflect.TypeOf(FindOverlays)
+	if functionType.NumOut() != 1 {
+		t.Fatalf("FindOverlays must return exactly one value, got %d", functionType.NumOut())
+	}
+	if functionType.Out(0) != reflect.TypeOf([]string{}) {
+		t.Fatalf("FindOverlays must return []string, got %s", functionType.Out(0))
+	}
+	results := reflect.ValueOf(FindOverlays).Call(nil)
+	return results[0].Interface().([]string)
+}
