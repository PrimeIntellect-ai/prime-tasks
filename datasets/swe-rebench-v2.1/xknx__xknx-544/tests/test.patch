+
+    def test_tunneling_configuration_can_enable_nat_compatible_mode(self):
+        """A configured tunneling connection uses route-back HPAIs for control requests."""
+        xknx = XKNX()
+        Config(xknx).parse(
+            {
+                "connection": {
+                    "tunneling": {
+                        "gateway_ip": "127.0.0.2",
+                        "local_ip": "127.0.0.1",
+                        "route_back": True,
+                    }
+                }
+            }
+        )
+        interface = KNXIPInterface(xknx, xknx.connection_config)
+        sent_frames = []
+
+        def reply_to_request(udp_client, frame):
+            sent_frames.append(frame)
+            response_types = {
+                KNXIPServiceType.CONNECT_REQUEST: KNXIPServiceType.CONNECT_RESPONSE,
+                KNXIPServiceType.CONNECTIONSTATE_REQUEST: KNXIPServiceType.CONNECTIONSTATE_RESPONSE,
+                KNXIPServiceType.DISCONNECT_REQUEST: KNXIPServiceType.DISCONNECT_RESPONSE,
+            }
+            response_type = response_types.get(frame.header.service_type_ident)
+            if response_type is None:
+                return
+            response = KNXIPFrame(xknx)
+            response.init(response_type)
+            if response_type == KNXIPServiceType.CONNECT_RESPONSE:
+                response.body.communication_channel = 23
+                response.body.identifier = 7
+            elif response_type == KNXIPServiceType.CONNECTIONSTATE_RESPONSE:
+                response.body.communication_channel_id = 23
+            elif response_type == KNXIPServiceType.DISCONNECT_RESPONSE:
+                response.body.communication_channel_id = 23
+            udp_client.handle_knxipframe(response)
+
+        with patch("xknx.io.tunnel.HEARTBEAT_RATE", 0.1), patch(
+            "xknx.io.UDPClient.send", autospec=True, side_effect=reply_to_request
+        ):
+            self.loop.run_until_complete(interface.start())
+            self.loop.run_until_complete(asyncio.sleep(0.11))
+            self.assertTrue(xknx.connected.is_set())
+            self.loop.run_until_complete(interface.stop())
+            self.loop.run_until_complete(asyncio.sleep(0.01))
+
+        requests = {
+            frame.header.service_type_ident: frame.body for frame in sent_frames
+        }
+        self.assertIn(KNXIPServiceType.CONNECT_REQUEST, requests)
+        self.assertIn(KNXIPServiceType.CONNECTIONSTATE_REQUEST, requests)
+        self.assertIn(KNXIPServiceType.DISCONNECT_REQUEST, requests)
+        connect_request = requests[KNXIPServiceType.CONNECT_REQUEST]
+        self.assertEqual(
+            (connect_request.control_endpoint.ip_addr, connect_request.control_endpoint.port),
+            ("0.0.0.0", 0),
+        )
+        self.assertEqual(
+            (connect_request.data_endpoint.ip_addr, connect_request.data_endpoint.port),
+            ("0.0.0.0", 0),
+        )
+        connectionstate_request = requests[KNXIPServiceType.CONNECTIONSTATE_REQUEST]
+        self.assertEqual(
+            (
+                connectionstate_request.control_endpoint.ip_addr,
+                connectionstate_request.control_endpoint.port,
+            ),
+            ("0.0.0.0", 0),
+        )
+        disconnect_request = requests[KNXIPServiceType.DISCONNECT_REQUEST]
+        self.assertEqual(
+            (disconnect_request.control_endpoint.ip_addr, disconnect_request.control_endpoint.port),
+            ("0.0.0.0", 0),
+        )
