+# Check for thunks that define functions (fixes #792)
+function defines_function(ci)
+    isa(ci, CodeInfo) || return false
+    if length(ci.code) == 1
+        stmt = ci.code[1]
+        if isa(stmt, Core.ReturnNode)
+            val = stmt.val
+            isexpr(val, :method) && return true
+        end
+    end
+    return false
+end
 
