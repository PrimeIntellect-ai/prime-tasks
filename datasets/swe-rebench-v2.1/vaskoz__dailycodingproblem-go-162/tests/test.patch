+package day76
+
+import "testing"
+
+var minRemoveColumnsContractCases = []struct {
+	input    [][]rune
+	expected int
+}{
+	{[][]rune{
+		[]rune("cba"),
+		[]rune("daf"),
+		[]rune("ghi"),
+	}, 1},
+	{[][]rune{
+		[]rune("abcdef"),
+	}, 0},
+	{[][]rune{
+		[]rune("zyx"),
+		[]rune("wvu"),
+		[]rune("tsr"),
+	}, 3},
+	// An empty matrix is a valid input and requires no removal.
+	{[][]rune{}, 0},
+	// Equal characters in a column are allowed (non-decreasing).
+	{[][]rune{
+		[]rune("aa"),
+		[]rune("aa"),
+	}, 0},
+	// Equal characters are kept while a decreasing column is removed.
+	{[][]rune{
+		[]rune("ab"),
+		[]rune("aa"),
+	}, 1},
+}
+
+func TestContractMinRemoveColumns(t *testing.T) {
+	t.Parallel()
+	for _, tc := range minRemoveColumnsContractCases {
+		if result := MinRemoveColumns(tc.input); result != tc.expected {
+			t.Errorf("Expected %v got %v", tc.expected, result)
+		}
+	}
+}
+
+// TestContractMinRemoveColumnsLargeInput checks the result on a large matrix.
+func TestContractMinRemoveColumnsLargeInput(t *testing.T) {
+	t.Parallel()
+	const n = 3000
+	matrix := make([][]rune, n)
+	for i := range matrix {
+		row := make([]rune, n)
+		for j := range row {
+			row[j] = rune('a' + j%26)
+		}
+		matrix[i] = row
+	}
+	if result := MinRemoveColumns(matrix); result != 0 {
+		t.Errorf("Expected 0 got %v", result)
+	}
+}
+
+func BenchmarkContractMinRemoveColumns(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range minRemoveColumnsContractCases {
+			MinRemoveColumns(tc.input)
+		}
+	}
+}
