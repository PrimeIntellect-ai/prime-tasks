+def test_transaction_cross_device_metadata_error_is_tolerated(tmpdir):
+    fs = LocalFileSystem()
+    destination = os.path.join(str(tmpdir), "afile")
+    original_rename = os.rename
+    original_chmod = os.chmod
+    cross_device_fallback = False
+
+    def rename_if_on_different_parent(src, dst, *args, **kwargs):
+        nonlocal cross_device_fallback
+        if os.path.dirname(os.path.abspath(src)) != os.path.dirname(
+            os.path.abspath(dst)
+        ):
+            cross_device_fallback = True
+            raise OSError(errno.EXDEV, "Invalid cross-device link")
+        return original_rename(src, dst, *args, **kwargs)
+
+    def chmod_permission_error_during_fallback(path, mode, *args, **kwargs):
+        if cross_device_fallback:
+            raise PermissionError("Operation not permitted")
+        return original_chmod(path, mode, *args, **kwargs)
+
+    with (
+        patch("os.rename", side_effect=rename_if_on_different_parent),
+        patch("os.chmod", side_effect=chmod_permission_error_during_fallback),
+    ):
+        with fs.transaction, fs.open(destination, "wb") as f:
+            f.write(b"data")
+
+    assert fs.cat(destination) == b"data"
+
