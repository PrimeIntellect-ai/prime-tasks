+
+class TestScopeDecoration(unittest.TestCase):
+    def _assert_client_id_is_preserved_in_request(self, client_id, other_scopes):
+        requested_scopes = [client_id] + other_scopes
+
+        class DiscoveryHttpClient:
+            def __init__(self):
+                self.request_data = {}
+
+            def get(self, url, **kwargs):
+                return MinimalResponse(
+                    status_code=200,
+                    text=json.dumps({
+                        "authorization_endpoint": (
+                            "https://login.microsoftonline.com/adfs/oauth2/authorize"),
+                        "token_endpoint": (
+                            "https://login.microsoftonline.com/adfs/oauth2/token")}))
+
+            def post(self, url, data=None, **kwargs):
+                self.request_data.update(data or {})
+                return MinimalResponse(status_code=400, text='{"error": "test_error"}')
+
+        http_client = DiscoveryHttpClient()
+        app = PublicClientApplication(
+            client_id,
+            authority="https://login.microsoftonline.com/adfs",
+            instance_discovery=False,
+            http_client=http_client)
+        app.acquire_token_by_username_password(
+            "user", "password", requested_scopes)
+
+        self.assertEqual(
+            set(http_client.request_data["scope"].split()),
+            set(requested_scopes + ["openid", "profile", "offline_access"]))
+
+    def test_client_id_should_be_a_valid_scope(self):
+        self._assert_client_id_is_preserved_in_request("client_id", [])
+        self._assert_client_id_is_preserved_in_request("client_id", ["foo"])
+
