+package reactable
+
+import (
+	"math"
+	"testing"
+
+	"github.com/genshinsim/gcsim/internal/artifacts/paleflame"
+	"github.com/genshinsim/gcsim/internal/characters/eula"
+	"github.com/genshinsim/gcsim/pkg/core"
+)
+
+func newEulaPaleFlameFixture(t *testing.T) (*core.Core, core.Character) {
+	t.Helper()
+	c := testCore()
+
+	prof := core.CharacterProfile{}
+	prof.Base.Element = core.Cryo
+	prof.Base.Key = core.Eula
+	prof.Base.Cons = 0
+	prof.Talents.Attack = 8
+	prof.Talents.Burst = 8
+	prof.Talents.Skill = 8
+	prof.Base.Level = 90
+	prof.Base.MaxLevel = 90
+	prof.Stats = make([]float64, core.EndStatType)
+	prof.Stats[core.ATKP] = 0.249
+	prof.Sets = map[string]int{"pale flame": 4}
+	prof.SetParams = make(map[string]map[string]int)
+
+	x, err := eula.NewChar(c, prof)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.Chars = append(c.Chars, x)
+	c.CharPos[x.Key()] = 0
+	x.SetIndex(0)
+
+	// target at index 0 is the player (attacks are not self harm); the enemy
+	// sits at index 1 so Eula's attacks land on it.
+	dummy := &testTarget{src: 0}
+	dummy.Reactable = &Reactable{}
+	dummy.Init(dummy, c)
+	c.Targets = append(c.Targets, dummy)
+
+	trg := &testTarget{src: 1}
+	trg.Reactable = &Reactable{}
+	trg.Init(trg, c)
+	c.Targets = append(c.Targets, trg)
+
+	paleflame.New(x, c, 4, nil)
+	c.Init()
+	return c, x
+}
+
+func prepareEulaHoldWithTwoGrimheartStacks(c *core.Core, x core.Character) {
+	// Tap E grants one Grimheart stack. Wait until its Pale Flame proc expires.
+	x.Skill(map[string]int{"hold": 0})
+	for i := 0; i < 40; i++ {
+		c.Tick()
+	}
+	for i := 0; i < 600; i++ {
+		c.Tick()
+	}
+	// Burst grants the second Grimheart stack.
+	x.Burst(map[string]int{})
+	for i := 0; i < 120; i++ {
+		c.Tick()
+	}
+}
+
+func TestEulaHoldEGivesTwoPaleFlameStacks(t *testing.T) {
+	c, x := newEulaPaleFlameFixture(t)
+	prepareEulaHoldWithTwoGrimheartStacks(c, x)
+
+	beforeATK := x.Stat(core.ATKP)
+	beforePhysical := x.Stat(core.PhyP)
+
+	// Hold E with 2 Grimheart stacks.
+	x.Skill(map[string]int{"hold": 1})
+	for i := 0; i < 200; i++ {
+		c.Tick()
+	}
+
+	afterATK := x.Stat(core.ATKP)
+	afterPhysical := x.Stat(core.PhyP)
+	// 4pc Pale Flame grants 9% ATK per stack; 2 stacks is +18% ATK.
+	if got := afterATK - beforeATK; math.Abs(got-0.18) > 1e-9 {
+		t.Errorf("expected 2 stacks of 4pc Pale Flame (+0.18 ATK) after Hold E, got +%v ATK", got)
+	}
+	// Reaching two stacks also grants 25% Physical DMG.
+	if got := afterPhysical - beforePhysical; math.Abs(got-0.25) > 1e-9 {
+		t.Errorf("expected the two-stack Physical DMG bonus (+0.25) after Hold E, got +%v", got)
+	}
+}
+
+func TestEulaFollowingN5ReceivesTwoPaleFlameStacks(t *testing.T) {
+	c, x := newEulaPaleFlameFixture(t)
+	prepareEulaHoldWithTwoGrimheartStacks(c, x)
+
+	beforeATK := x.Stat(core.ATKP)
+	beforePhysical := x.Stat(core.PhyP)
+	var n5Snapshot *core.AttackEvent
+	n5SourceFrame := -1
+	c.Events.Subscribe(core.OnDamage, func(args ...interface{}) bool {
+		atk := args[1].(*core.AttackEvent)
+		if atk.Info.ActorIndex == x.CharIndex() && atk.Info.AttackTag == core.AttackTagNormal && atk.SourceFrame == n5SourceFrame && n5Snapshot == nil {
+			n5Snapshot = atk
+		}
+		return false
+	}, "capture-eula-following-n5")
+
+	// Begin the normal chain immediately after Hold E; queued normal hits
+	// resolve after their own attack delays.
+	holdFrames, _ := x.Skill(map[string]int{"hold": 1})
+	for i := 0; i < holdFrames; i++ {
+		c.Tick()
+	}
+	for i := 0; i < 5; i++ {
+		if i == 4 {
+			n5SourceFrame = c.F
+		}
+		frames, _ := x.Attack(map[string]int{})
+		for j := 0; j < frames; j++ {
+			c.Tick()
+		}
+	}
+	for i := 0; i < 80; i++ {
+		c.Tick()
+	}
+	if n5Snapshot == nil {
+		t.Fatal("the N5 following Hold E did not resolve")
+	}
+	if got := n5Snapshot.Snapshot.Stats[core.ATKP] - beforeATK; math.Abs(got-0.18) > 1e-9 {
+		t.Errorf("following N5 expected +0.18 ATK from two Pale Flame stacks, got +%v", got)
+	}
+	if got := n5Snapshot.Snapshot.Stats[core.PhyP] - beforePhysical; math.Abs(got-0.25) > 1e-9 {
+		t.Errorf("following N5 expected +0.25 Physical DMG from two Pale Flame stacks, got +%v", got)
+	}
+}
