+package day379
+
+import (
+	"reflect"
+	"testing"
+)
+
+var day379SubsequenceCases = []struct {
+	input  string
+	subseq []string
+}{
+	{"xyz", []string{"x", "y", "z", "xy", "xz", "yz", "xyz"}},
+}
+
+func TestDay379AllPossibleSubsequencesContract(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range day379SubsequenceCases {
+		result := AllPossibleSubsequences(tc.input)
+		got := day379SubsequenceValues(t, result)
+		want := make(map[string]struct{}, len(tc.subseq))
+		for _, subsequence := range tc.subseq {
+			want[subsequence] = struct{}{}
+		}
+		if !reflect.DeepEqual(got, want) || reflect.ValueOf(result).Len() != len(want) {
+			t.Errorf("for %q, expected subsequences %v, got %v", tc.input, want, got)
+		}
+	}
+}
+
+func day379SubsequenceValues(t *testing.T, result interface{}) map[string]struct{} {
+	t.Helper()
+	value := reflect.ValueOf(result)
+	values := make(map[string]struct{})
+	switch value.Kind() {
+	case reflect.Map:
+		if value.Type().Key().Kind() != reflect.String {
+			t.Fatalf("subsequence collection map must have string keys, got %s", value.Type())
+		}
+		for _, key := range value.MapKeys() {
+			values[key.String()] = struct{}{}
+		}
+	case reflect.Array, reflect.Slice:
+		for i := 0; i < value.Len(); i++ {
+			item := value.Index(i)
+			if item.Kind() != reflect.String {
+				t.Fatalf("subsequence collection elements must be strings, got %s", item.Type())
+			}
+			values[item.String()] = struct{}{}
+		}
+	default:
+		t.Skipf("cannot enumerate custom subsequence set of kind %s", value.Kind())
+	}
+	return values
+}
+
+func BenchmarkDay379AllPossibleSubsequencesContract(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range day379SubsequenceCases {
+			AllPossibleSubsequences(tc.input)
+		}
+	}
+}
