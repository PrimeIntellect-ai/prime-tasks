+import pytest
+
+import altair.vegalite.v3 as alt
+
+
+@pytest.fixture
+def chart():
+    return alt.Chart('data.csv').mark_bar().encode(x='x:Q')
+
+
+def test_vega_themes_available():
+    from altair.vegalite.v3.theme import VEGA_THEMES
+    assert len(VEGA_THEMES) > 0
+    registered = alt.themes.names()
+    for theme in VEGA_THEMES:
+        assert theme in registered
+
+
+def test_vega_themes(chart):
+    from altair.vegalite.v3.theme import VEGA_THEMES
+    with alt.themes.enable('default'):
+        default_spec = chart.to_dict()
+    for theme in VEGA_THEMES:
+        with alt.themes.enable(theme):
+            themed_spec = chart.to_dict()
+        assert themed_spec != default_spec
+
+
+def test_builtin_vega_theme(chart):
+    with alt.themes.enable('default'):
+        default_spec = chart.to_dict()
+    with alt.themes.enable('dark'):
+        dark_spec = chart.to_dict()
+    assert dark_spec != default_spec
+
+
+def test_theme_restoration(chart):
+    before = chart.to_dict()
+    with alt.themes.enable('dark'):
+        chart.to_dict()
+    after = chart.to_dict()
+    assert after == before
+
+
+def test_enable_unregistered_raises():
+    with pytest.raises(Exception):
+        alt.themes.enable('this-theme-is-not-registered')
+
+
+def test_user_registered_theme_remains_usable(chart):
+    theme_name = 'user-specified-test-theme'
+    alt.themes.register(theme_name, lambda: {'config': {'background': 'pink'}})
+    try:
+        with alt.themes.enable(theme_name):
+            dct = chart.to_dict()
+        assert dct['config']['background'] == 'pink'
+    finally:
+        alt.themes.register(theme_name, None)
