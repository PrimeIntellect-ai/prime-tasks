new file mode 100644
index 0000000..1688b91
--- /dev/null
+++ b/tests/parallel/revision_lock.rs
@@ -0,0 +1,30 @@
+use crate::setup::{Input, ParDatabase, ParDatabaseImpl};
+use salsa::{Database, ParallelDatabase};
+use std::sync::mpsc;
+
+/// A revision lock keeps consecutive reads consistent while another
+/// database handle attempts to write.
+#[test]
+fn queries_stay_consistent_while_revision_locked() {
+    let db = ParDatabaseImpl::default();
+    db.query(Input).set('a', 1);
+
+    let lock = db.salsa_runtime().lock_revision();
+    let (attempted_tx, attempted_rx) = mpsc::channel();
+    let writer = std::thread::spawn({
+        let db = db.fork();
+        move || {
+            attempted_tx.send(()).unwrap();
+            db.query(Input).set('a', 2);
+        }
+    });
+
+    // Let the writer reach its write attempt while this thread holds the guard.
+    attempted_rx.recv().unwrap();
+    assert_eq!(db.input('a'), 1);
+    assert_eq!(db.input('a'), 1);
+
+    drop(lock);
+    writer.join().unwrap();
+    assert_eq!(db.input('a'), 2);
+}
