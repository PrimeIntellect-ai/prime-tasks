         )
     }
+
+    @Test
+    @Tag(WarningNames.WRONG_NAME_OF_VARIABLE_INSIDE_ACCESSOR)
+    fun `shouldn't be triggered when there's a method with the same name as the property`() {
+        lintMethod(
+            """
+                    |class A {
+                    |
+                    |   val blaBla: String
+                    |       get() = "bla".blaBla("bla")
+                    |   
+                    |   fun blaBla(string: String): String = this + string
+                    |
+                    |}
+                """.trimMargin()
+        )
+    }
+
+    @Test
+    @Tag(WarningNames.WRONG_NAME_OF_VARIABLE_INSIDE_ACCESSOR)
+    fun `shouldn't be triggered when an extension property getter calls a method with the same name`() {
+        lintMethod(
+            """
+                    |val String.blaBla: String
+                    |    get() = "bla".blaBla("bla")
+                    |
+                    |fun String.blaBla(string: String): String = this + string
+                """.trimMargin()
+        )
+    }
 }
