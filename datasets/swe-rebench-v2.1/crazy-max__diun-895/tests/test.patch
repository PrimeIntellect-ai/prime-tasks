+func TestRunOnStartupDisabledStillRunsScheduledChecks(t *testing.T) {
+	requests := make(chan struct{}, 8)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		select {
+		case requests <- struct{}{}:
+		default:
 		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer srv.Close()
+
+	tmpDir := t.TempDir()
+	imageFile := filepath.Join(tmpDir, "images.yml")
+	require.NoError(t, os.WriteFile(imageFile, []byte("[]"), 0600))
+	cfgContent := fmt.Sprintf(`db:
+  path: %s
+watch:
+  runOnStartup: false
+  schedule: "@every 1s"
+  jitter: 0s
+  healthchecks:
+    baseURL: %s
+    uuid: test-uuid
+providers:
+  file:
+    filename: %s
+`, filepath.Join(tmpDir, "diun.db"), srv.URL, imageFile)
+	cfgFile := filepath.Join(tmpDir, "diun.yml")
+	require.NoError(t, os.WriteFile(cfgFile, []byte(cfgContent), 0600))
+
+	cfg, err := config.Load(cfgFile)
+	require.NoError(t, err)
+	di, err := app.New(model.Meta{Name: "diun"}, cfg, "127.0.0.1:0")
+	require.NoError(t, err)
+	defer di.Close()
+
+	go func() { _ = di.Start() }()
+	select {
+	case <-requests:
+	case <-time.After(5 * time.Second):
+		t.Fatal("expected a scheduled update check while startup execution is disabled")
 	}
 }
