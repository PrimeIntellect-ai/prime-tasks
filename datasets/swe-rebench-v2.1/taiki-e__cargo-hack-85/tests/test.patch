+        .test_dir("tests/fixtures/powerset_deduplication")
+        .assert_success()
+        .assert_stderr_contains(
+            "running `cargo check --no-default-features --features a` on deduplication",
+        )
+        .assert_stderr_contains(
+            "running `cargo check --no-default-features --features b` on deduplication",
+        )
+        .assert_stderr_not_contains(
+            "--features a,b
+             --features b,c
+             --features b,e
+             --features d,e",
+        );
+}
