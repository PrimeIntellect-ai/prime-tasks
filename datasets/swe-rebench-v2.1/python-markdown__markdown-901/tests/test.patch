+    def testRawHtmlWithEntity(self):
+        """ Test Headers with raw HTML containing an HTML entity. """
+        text = '# Foo <b>Bar &amp; Baz</b>'
+        self.md.convert(text)
+        self.assertEqual(self.md.toc_tokens, [
+            {'level': 1, 'id': 'foo-bar-baz', 'name': 'Foo Bar &amp; Baz', 'children': []},
+        ])
+
+    def testStashedHTML2text(self):
+        """ Test stashedHTML2text entity handling. """
+        from markdown.extensions.toc import stashedHTML2text
+        md = markdown.Markdown(extensions=['toc'])
+        placeholder = md.htmlStash.store('<b>Bar &amp; Baz</b>')
+        preserved = stashedHTML2text(placeholder, md, strip_entities=False)
+        self.assertIn('Bar', preserved)
+        self.assertIn('Baz', preserved)
+        self.assertIn('&amp;', preserved)
+        self.assertNotIn('<b>', preserved)
+        stripped = stashedHTML2text(placeholder, md, strip_entities=True)
+        self.assertIn('Bar', stripped)
+        self.assertIn('Baz', stripped)
+        self.assertNotIn('&amp;', stripped)
+        self.assertNotIn('<b>', stripped)
+
+    def testStashedHTML2textMultipleFragments(self):
+        """ Test stashed HTML substitution for every placeholder. """
+        from markdown.extensions.toc import stashedHTML2text
+        md = markdown.Markdown(extensions=['toc'])
+        first = md.htmlStash.store('<b>First &amp; item</b>')
+        second = md.htmlStash.store('<i>Second &#33;</i>')
+        text = first + ' middle ' + second + ' end'
+
+        self.assertEqual(
+            stashedHTML2text(text, md, strip_entities=False),
+            'First &amp; item middle Second &#33; end'
+        )
+        self.assertEqual(
+            stashedHTML2text(text, md),
+            'First  item middle Second  end'
+        )
 
