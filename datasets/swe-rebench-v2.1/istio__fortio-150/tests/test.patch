+// Mirrors the command line flow of "fortio curl -H Foo:Bar URL": the -H
+// values are added to a zero value options object before the URL is set.
+func TestCommandLineHeaderFlowDoesNotPanic(t *testing.T) {
+	gotHeader := make(chan string, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotHeader <- r.Header.Get("Foo")
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	var opts HTTPOptions
+	if err := opts.AddAndValidateExtraHeader("Foo:Bar"); err != nil {
+		t.Fatalf("Adding header from the command line returned an error: %v", err)
+	}
+	opts.URL = server.URL
+	if code, _, _ := NewClient(&opts).Fetch(); code != http.StatusOK {
+		t.Fatalf("Request returned status %d, want %d", code, http.StatusOK)
+	}
+	if got := <-gotHeader; got != "Bar" {
+		t.Errorf("Server received Foo header %q, want %q", got, "Bar")
+	}
+}
