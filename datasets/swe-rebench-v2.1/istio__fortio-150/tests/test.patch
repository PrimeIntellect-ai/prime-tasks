+func TestExtraHeaderSentWithRequest(t *testing.T) {
+	gotHeader := make(chan string, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotHeader <- r.Header.Get("X-Extra-Test")
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	o := &HTTPOptions{URL: server.URL}
+	if err := o.AddAndValidateExtraHeader("X-Extra-Test: sent"); err != nil {
+		t.Fatalf("Adding a valid header returned an error: %v", err)
+	}
+	client := NewStdClient(o)
+	if client == nil {
+		t.Fatal("Could not create an HTTP client")
+	}
+	if code, _, _ := client.Fetch(); code != http.StatusOK {
+		t.Fatalf("Request returned status %d, want %d", code, http.StatusOK)
+	}
+	if got := <-gotHeader; got != "sent" {
+		t.Errorf("Server received X-Extra-Test %q, want %q", got, "sent")
 	}
 }
 
