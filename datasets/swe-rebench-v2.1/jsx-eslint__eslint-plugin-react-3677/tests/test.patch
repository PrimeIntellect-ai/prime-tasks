+
+describe('jsx-one-expression-per-line with allow non-jsx', () => {
+  const linter = new Linter();
+  linter.defineRule('jsx-one-expression-per-line', rule);
+
+  const verify = (code) => linter.verify(code, {
+    parserOptions,
+    rules: {
+      'jsx-one-expression-per-line': ['error', { allow: 'non-jsx' }],
+    },
+  });
+
+  it('continues to report direct JSX element children', () => {
+    assert(verify('<App><Foo /></App>').length > 0);
+    assert(verify('<App><Bar /> <Baz /></App>').length > 0);
+  });
+
+  it('continues to report direct JSX fragment children', () => {
+    assert(verify('<App><><Foo /></></App>').length > 0);
+  });
+});
