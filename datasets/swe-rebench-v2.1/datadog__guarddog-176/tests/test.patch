+def test_scan_current_directory_detects_postinstall_script(tmp_path, monkeypatch):
+    """
+    Regression test for https://github.com/DataDog/guarddog/issues/175.
+
+    `guarddog npm scan .` must scan the local current directory (instead of
+    treating "." as a remote package name) and report postinstall scripts
+    found in the scanned tree.
+    """
+    package_dir = tmp_path / "package"
+    package_dir.mkdir()
+    (package_dir / "package.json").write_text(
+        '{"name": "pizza-pasta", "version": "1.0.3", '
+        '"scripts": {"postinstall": "node ./malicious.js"}}'
+    )
+    monkeypatch.chdir(tmp_path)
+
+    result = CliRunner().invoke(guarddog.cli.cli, ["npm", "scan", "."])
+
+    assert result.exception is None
+    assert "npm-install-script" in result.output
