+package day5
+
+import "testing"
+
+func TestCar(t *testing.T) {
+	t.Parallel()
+	pair := Cons(3, 4)
+	result := Car(pair)
+	if result != 3 {
+		t.Errorf("Expected 3 but got %v", result)
+	}
+}
+
+func TestCdr(t *testing.T) {
+	t.Parallel()
+	pair := Cons(3, 4)
+	result := Cdr(pair)
+	if result != 4 {
+		t.Errorf("Expected 4 but got %v", result)
+	}
+}
