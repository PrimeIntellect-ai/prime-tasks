+func TestMatchesIntegration(t *testing.T) {
+	cls := "ingress"
+	selector := switchboard.NewSelector(&cls)
+
+	// With no ignore annotation, the integration remains eligible.
+	assert.True(t, matchesIntegration(t, selector, map[string]string{}, "external-dns"))
+
+	// Ignore all
+	assert.False(t, matchesIntegration(t, selector, map[string]string{
+		"switchboard.borchero.com/ignore": "true",
+	}, "external-dns"))
+	assert.False(t, matchesIntegration(t, selector, map[string]string{
+		"switchboard.borchero.com/ignore": "all",
+	}, "external-dns"))
+
+	// Ignore only one
+	assert.False(t, matchesIntegration(t, selector, map[string]string{
+		"switchboard.borchero.com/ignore": "external-dns",
+	}, "external-dns"))
+	assert.True(t, matchesIntegration(t, selector, map[string]string{
+		"switchboard.borchero.com/ignore": "cert-manager",
+	}, "external-dns"))
+
+	// Ignore multiple
+	assert.False(t, matchesIntegration(t, selector, map[string]string{
+		"switchboard.borchero.com/ignore": "external-dns,cert-manager",
+	}, "external-dns"))
+	assert.False(t, matchesIntegration(t, selector, map[string]string{
+		"switchboard.borchero.com/ignore": "external-dns,cert-manager",
+	}, "cert-manager"))
+	assert.True(t, matchesIntegration(t, selector, map[string]string{
+		"switchboard.borchero.com/ignore": "external-dns,cert-manager",
+	}, "unknown"))
+
+	// Ignore with space in between
+	assert.False(t, matchesIntegration(t, selector, map[string]string{
+		"switchboard.borchero.com/ignore": "external-dns, cert-manager",
+	}, "external-dns"))
+	assert.False(t, matchesIntegration(t, selector, map[string]string{
+		"switchboard.borchero.com/ignore": "external-dns, cert-manager",
+	}, "cert-manager"))
+	assert.True(t, matchesIntegration(t, selector, map[string]string{
+		"switchboard.borchero.com/ignore": "external-dns, cert-manager",
+	}, "unknown"))
+}
