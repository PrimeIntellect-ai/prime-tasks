+func TestReconcileSkipsCertManagerAndRunsExternalDNS(t *testing.T) {
+	ctx := context.Background()
+	ingress := &traefik.IngressRoute{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "site",
+			Namespace: "default",
+			Annotations: map[string]string{
+				"switchboard.borchero.com/ignore": "cert-manager",
+			},
+		},
+		Spec: traefik.IngressRouteSpec{
+			Routes: []traefik.Route{{
+				Kind:  "Rule",
+				Match: "Host(`site.example.com`)",
+			}},
+			TLS: &traefik.TLS{SecretName: "site-tls"},
+		},
+	}
+	scheme := k8tests.NewScheme()
+	kubeClient := fake.NewClientBuilder().WithScheme(scheme).WithObjects(ingress).Build()
+	reconciler, err := controllers.NewIngressRouteReconciler(kubeClient, zap.NewNop(), configv1.Config{
+		Integrations: configv1.IntegrationConfigs{
+			ExternalDNS: &configv1.ExternalDNSIntegrationConfig{TargetIPs: []string{"192.0.2.1"}},
+			CertManager: &configv1.CertManagerIntegrationConfig{Template: certmanager.Certificate{}},
+		},
+	})
+	require.NoError(t, err)
+
+	_, err = reconciler.Reconcile(ctx, structRequest("default", "site"))
+	require.NoError(t, err)
+
+	certificate := &certmanager.Certificate{}
+	err = kubeClient.Get(ctx, types.NamespacedName{Namespace: "default", Name: "site-tls"}, certificate)
+	assert.True(t, apierrors.IsNotFound(err), "an ignored integration must not create its resource")
+	dnsEndpoint := &endpoint.DNSEndpoint{}
+	err = kubeClient.Get(ctx, types.NamespacedName{Namespace: "default", Name: "site"}, dnsEndpoint)
+	assert.NoError(t, err, "an integration not named in the ignore annotation should create its resource")
+}
+
+func structRequest(namespace, name string) ctrl.Request {
+	return ctrl.Request{NamespacedName: types.NamespacedName{Namespace: namespace, Name: name}}
+}
+
+func matchesIntegration(t *testing.T, selector switchboard.Selector, annotations map[string]string, integration string) bool {
+	t.Helper()
+	type integrationMatcher interface {
+		MatchesIntegration(map[string]string, string) bool
+	}
+	matcher, ok := interface{}(selector).(integrationMatcher)
+	if !assert.True(t, ok, "selector must support per-integration matching") {
+		return false
+	}
+	return matcher.MatchesIntegration(annotations, integration)
+}
