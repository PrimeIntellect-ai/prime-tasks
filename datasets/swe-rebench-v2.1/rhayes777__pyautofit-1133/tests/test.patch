+import autofit as af
+from autofit import SamplesPDF
+
+
+class Analysis(af.Analysis):
+    def log_likelihood_function(self, instance):
+        return 1.0
+
+    def compute_latent_variables(self, instance):
+        return {
+            "galaxies.lens.shear.magnitude": 2.0,
+            "galaxies.lens.shear.angle": 1.0,
+        }
+
+
+def test_dotted_path_latent_variables():
+    analysis = Analysis()
+    latent_samples = analysis.compute_latent_samples(
+        SamplesPDF(
+            model=af.Model(af.Gaussian),
+            sample_list=[
+                af.Sample(
+                    log_likelihood=1.0,
+                    log_prior=0.0,
+                    weight=1.0,
+                    kwargs={
+                        "centre": 1.0,
+                        "normalization": 2.0,
+                        "sigma": 3.0,
+                    },
+                )
+            ],
+        ),
+    )
+
+    instance = latent_samples.model.instance_from_prior_medians()
+    assert instance.galaxies.lens.shear.magnitude == 2.0
+    assert instance.galaxies.lens.shear.angle == 1.0
+
+    # Computing the covariance must handle the dotted latent paths.
+    latent_samples.covariance_matrix
