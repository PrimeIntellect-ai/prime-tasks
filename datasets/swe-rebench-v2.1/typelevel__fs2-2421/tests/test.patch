+  /** Extracts the underlying NIO channel from a `Socket` so that the socket
+    * options actually applied to it can be observed.
+    */
+  private def underlyingChannel(socket: Socket[IO]): AsynchronousSocketChannel = {
+    val field = socket.getClass.getDeclaredFields
+      .find(_.getType == classOf[AsynchronousSocketChannel])
+      .getOrElse(throw new AssertionError("socket does not wrap an AsynchronousSocketChannel"))
+    field.setAccessible(true)
+    field.get(socket).asInstanceOf[AsynchronousSocketChannel]
+  }
