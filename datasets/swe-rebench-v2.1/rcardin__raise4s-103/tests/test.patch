+  "Values extension method" should "extract the values from the iterable" in {
+    val iterableWithInnerRaise: List[Int raises String] = List(1, 2, 3, 4, 5)
+    val iterableWithRaiseAcc: List[Int] raises List[String] = iterableWithInnerRaise.values
+
+    val actual = Raise.fold(
+      iterableWithRaiseAcc,
+      error => fail(s"An error occurred: $error"),
+      identity
+    )
+
+    actual shouldBe List(1, 2, 3, 4, 5)
+  }
+
+  it should "accumulate all the errors" in {
+    val iterableWithInnerRaise: List[Int raises String] = List(1, 2, 3, 4, 5).map(value =>
+      if (value % 2 == 0) {
+        Raise.raise(value.toString)
+      } else {
+        value
+      }
+    )
+
+    val iterableWithRaiseAcc: List[Int] raises List[String] = iterableWithInnerRaise.values
+
+    val actual = Raise.fold(
+      iterableWithRaiseAcc,
+      identity,
+      identity
+    )
+
+    actual.toSet shouldBe Set("2", "4")
+  }
+
+  it should "accept a non-List iterable and return its values in a RaiseAcc context" in {
+    val computations: Vector[Int raises String] = Vector(1, 2, 3).map(identity)
+    val accumulated: RaiseAcc[String] ?=> List[Int] = computations.values
+
+    val actual = Raise.fold(
+      accumulated,
+      error => fail(s"An error occurred: $error"),
+      identity
+    )
+
+    actual shouldBe List(1, 2, 3)
+  }
+
+  it should "accumulate errors from a non-List iterable" in {
+    val computations: Vector[Int raises String] = Vector(1, 2, 3, 4).map(value =>
+      if (value % 2 == 0) Raise.raise(value.toString) else value
+    )
+    val accumulated: RaiseAcc[String] ?=> List[Int] = computations.values
+
+    val actual = Raise.fold(accumulated, identity, identity)
+
+    actual.toSet shouldBe Set("2", "4")
+  }
+
   case class MyError2(errors: List[String])
