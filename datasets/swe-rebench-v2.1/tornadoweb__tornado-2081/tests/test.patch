index 00000000..25b55fd6
--- /dev/null
+++ b/tornado/test/autoreload_test.py
@@ -0,0 +1,65 @@
+from __future__ import absolute_import, division, print_function
+import os
+import subprocess
+from subprocess import Popen
+import sys
+import time
+from tempfile import mkdtemp
+
+from tornado.test.util import unittest
+
+
+MAIN = """\
+import os
+import sys
+
+from tornado import autoreload
+from tornado.ioloop import IOLoop
+
+# This import will fail if path is not set up correctly
+from .foo import Bar
+
+print('Starting')
+if 'TESTAPP_STARTED' not in os.environ:
+    os.environ['TESTAPP_STARTED'] = '1'
+    sys.stdout.flush()
+    autoreload.start(check_time=100)
+    IOLoop.current().start()
+"""
+
+
+class AutoreloadTest(unittest.TestCase):
+    def test_reload_module(self):
+        # Create temporary test application
+        path = mkdtemp()
+        os.mkdir(os.path.join(path, 'testapp'))
+        open(os.path.join(path, 'testapp/__init__.py'), 'w').close()
+        with open(os.path.join(path, 'testapp/foo.py'), 'w') as f:
+            f.write("Bar = 'Bar'\n")
+        with open(os.path.join(path, 'testapp/__main__.py'), 'w') as f:
+            f.write(MAIN)
+
+        # Make sure the tornado module under test is available to the test
+        # application
+        pythonpath = os.getcwd()
+        if 'PYTHONPATH' in os.environ:
+            pythonpath += os.pathsep + os.environ['PYTHONPATH']
+
+        p = Popen(
+            [sys.executable, '-m', 'testapp'], stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE, cwd=path,
+            env=dict(os.environ, PYTHONPATH=pythonpath),
+            universal_newlines=True)
+        try:
+            # Let autoreload establish its initial file timestamps before
+            # changing a module imported by the application.
+            time.sleep(1)
+            os.utime(os.path.join(path, 'testapp/foo.py'),
+                     (time.time() + 2, time.time() + 2))
+            out, err = p.communicate(timeout=10)
+        except subprocess.TimeoutExpired:
+            p.kill()
+            p.communicate()
+            self.fail('autoreload did not restart the application')
+        self.assertEqual(p.returncode, 0, err)
+        self.assertEqual(out, 'Starting\nStarting\n')
