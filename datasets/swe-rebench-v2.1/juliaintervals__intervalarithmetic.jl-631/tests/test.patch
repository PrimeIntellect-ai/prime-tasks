+
+@testset "SparseArrays zero compatibility" begin
+    source = [1.0 0.0; 0.0 0.0]
+    sparse_intervals = interval.(sparse(source))
+    @test_nowarn sparse_intervals .= zero(eltype(sparse_intervals))
+    @test all(isthinzero, sparse_intervals)
+end
+
+@testset "SparseArrays signed zero" begin
+    sparse_values = spzeros(Float64, 1, 1)
+    sparse_values[1, 1] = -0.0
+    @test nnz(sparse_values) == 1
+    @test signbit(sparse_values[1, 1])
+
+    sparse_positive = spzeros(Float64, 1, 1)
+    sparse_positive[1, 1] = 0.0
+    @test nnz(sparse_positive) == 0
+end
