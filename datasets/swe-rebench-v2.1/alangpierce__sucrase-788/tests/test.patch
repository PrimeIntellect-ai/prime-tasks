+import {ok, throws} from "assert";
 
 import {transform, Options} from "../src";
 import {IMPORT_DEFAULT_PREFIX, JSX_PREFIX} from "./prefixes";
@@ -7,6 +7,26 @@ import {jsxDevArgs} from "./util";
 
 const {devProps} = util;
 
+function assertPreservedJSXResult(
+  source: string,
+  options: Options,
+  isExpected: (code: string) => boolean,
+): void {
+  for (const preservationOptions of [
+    {...options, jsx: "preserve"},
+    {...options, jsxRuntime: "preserve"},
+  ]) {
+    try {
+      if (isExpected(transform(source, preservationOptions as Options).code)) {
+        return;
+      }
+    } catch (_error) {
+      // Try the other supported spelling of the preservation setting.
+    }
+  }
+  ok(false, "JSX output did not meet the expected behavior");
+}
+
 interface JSXExpectations {
   expectedClassicDevESMResult?: string;
   expectedClassicProdESMResult?: string;
@@ -1169,4 +1189,37 @@ describe("transform JSX", () => {
       },
     );
   });
+
+  it("allows preserving JSX", () => {
+    assertPreservedJSXResult(
+      `<div />`,
+      {transforms: ["jsx"]},
+      (code) => code.includes("<div") && code.includes("/>"),
+    );
+  });
+
+  it("transforms valid JSX names with imports transform when preserving JSX", () => {
+    assertPreservedJSXResult(
+      `import {foo, Bar, baz, abc, test, def, ghi} from "./utils";
+      function render() {
+        return <><foo /><Bar /><baz.abc /><div test={def}>{ghi}</div></>;
+      }`,
+      {transforms: ["jsx", "imports"]},
+      (code) =>
+        code.includes("require(") &&
+        !code.includes("import {foo") &&
+        code.includes("<foo") &&
+        (/<[^>]*\.Bar\s*\/>/.test(code) || /\b(?:var|let|const)\s+Bar\s*=/.test(code)) &&
+        (/<[^>]*\.baz\.abc\s*\/>/.test(code) || /\b(?:var|let|const)\s+baz\s*=/.test(code)) &&
+        code.includes("<div"),
+    );
+  });
+
+  it("removes JSX TS type arguments when preserving JSX", () => {
+    assertPreservedJSXResult(
+      `<Foo<number> />`,
+      {transforms: ["jsx", "typescript"]},
+      (code) => code.includes("<Foo") && !code.includes("<Foo<number>"),
+    );
+  });
 });
