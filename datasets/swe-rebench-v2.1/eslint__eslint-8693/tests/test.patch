+//------------------------------------------------------------------------------
+// Tests for safe autofix of async arrow functions
+//------------------------------------------------------------------------------
+
+describe("arrow-parens: async arrow autofix", () => {
+    const CLIEngine = require("../../../lib/cli-engine");
+
+    /**
+     * Lints and autofixes the given code with the arrow-parens rule.
+     * @param {string} code The code to lint.
+     * @param {Array} options The rule options.
+     * @returns {string} The autofixed code (or the original code when no fix is applied).
+     */
+    function autofix(code, options) {
+        const cliEngine = new CLIEngine({
+            useEslintrc: false,
+            fix: true,
+            parserOptions: { ecmaVersion: 8 },
+            rules: { "arrow-parens": ["error"].concat(options) }
+        });
+        const result = cliEngine.executeOnText(code).results[0];
+
+        return typeof result.output === "undefined" ? code : result.output;
+    }
+
+    it("does not join async and the parameter when removing parentheses", () => {
+        const output = autofix("async(a) => a", ["as-needed"]);
+
+        assert.notStrictEqual(output, "asynca => a");
+        assert.ok(
+            output === "async a => a" || output === "async(a) => a",
+            `Unexpected autofix output: ${output}`
+        );
+    });
+
+    it("does not join async and the parameter for a block-bodied arrow", () => {
+        const output = autofix("async(bar) => {\n}", ["as-needed"]);
+
+        assert.notStrictEqual(output, "asyncbar => {\n}");
+        assert.ok(
+            output === "async bar => {\n}" || output === "async(bar) => {\n}",
+            `Unexpected autofix output: ${output}`
+        );
+    });
+
+    it("does not join async and the parameter with requireForBlockBody", () => {
+        const output = autofix("async(a) => a", ["as-needed", { requireForBlockBody: true }]);
+
+        assert.notStrictEqual(output, "asynca => a");
+        assert.ok(
+            output === "async a => a" || output === "async(a) => a",
+            `Unexpected autofix output: ${output}`
+        );
+    });
+});
