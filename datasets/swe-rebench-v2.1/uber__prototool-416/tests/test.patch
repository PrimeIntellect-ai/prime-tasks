diff --git a/internal/cmd/cmd_test.go b/internal/cmd/cmd_test.go
index c38a067..2f52bbe 100644
--- a/internal/cmd/cmd_test.go
+++ b/internal/cmd/cmd_test.go
@@ -721,6 +721,47 @@ func TestLint(t *testing.T) {
 		51:7:ENUM_ZERO_VALUES_INVALID_EXCEPT_MESSAGE`,
 		"testdata/lint/enumexceptmessages/foo.proto",
 	)
+
+	t.Run("field comments", func(t *testing.T) {
+		dir, err := ioutil.TempDir("testdata/lint", "prototool-field-comments")
+		require.NoError(t, err)
+		defer os.RemoveAll(dir)
+		filePath := filepath.Join(dir, "fields.proto")
+		protoFile := `syntax = "proto3";
+package foo.v1;
+
+enum Example {
+  // The unspecified value.
+  EXAMPLE_UNSPECIFIED = 0;
+  // An incomplete description
+  EXAMPLE_ONE = 1;
+  EXAMPLE_TWO = 2;
+}
+
+message Outer {
+  message Inner {
+    map<string, string> values = 1;
+    oneof choice {
+      int32 selected = 2;
+    }
+    // An incomplete description
+    int32 incomplete = 3;
+    // A complete description.
+    int32 documented = 4;
+  }
+}`
+		require.NoError(t, ioutil.WriteFile(filePath, []byte(protoFile), 0600))
+		config := `{"lint":{"group":"uber2","rules":{"add":["ENUM_FIELDS_HAVE_COMMENTS","ENUM_FIELDS_HAVE_SENTENCE_COMMENTS","MESSAGE_FIELDS_HAVE_COMMENTS","MESSAGE_FIELDS_HAVE_SENTENCE_COMMENTS"]}}}`
+		output, exitCode := testDo(t, true, "lint", filePath, "--config-data", config)
+		assert.Equal(t, 255, exitCode)
+		assert.Contains(t, output, "ENUM_FIELDS_HAVE_COMMENTS")
+		// The incomplete and absent enum comments both violate the sentence rule.
+		assert.True(t, strings.Count(output, "ENUM_FIELDS_HAVE_SENTENCE_COMMENTS") >= 2)
+		// The incomplete message comment and both nested map/oneof omissions violate the sentence rule.
+		assert.True(t, strings.Count(output, "MESSAGE_FIELDS_HAVE_SENTENCE_COMMENTS") >= 3)
+		// Both nested map and oneof fields are missing comments.
+		assert.True(t, strings.Count(output, "MESSAGE_FIELDS_HAVE_COMMENTS") >= 2)
+	})
 }
 
