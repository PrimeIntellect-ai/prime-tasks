+func TestDropViewStatementParsing(t *testing.T) {
+	_, testFile, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("unable to locate test source")
+	}
+	root := filepath.Dir(filepath.Dir(testFile))
+	program := `package main
+import (
+	"fmt"
+	"strings"
+	"github.com/cloudspannerecosystem/memefish"
+)
+func main() {
+	sql := "DROP VIEW view_to_keep"
+	stmt, err := memefish.ParseStatement("", sql)
+	if err != nil {
+		panic(err)
+	}
+	if !strings.Contains(stmt.SQL(), "view_to_keep") {
+		panic(fmt.Sprintf("parsed SQL %q does not preserve the target name", stmt.SQL()))
+	}
+}`
+	file := filepath.Join(t.TempDir(), "drop_view_check.go")
+	if err := os.WriteFile(file, []byte(program), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("go", "run", file)
+	cmd.Dir = root
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("DROP VIEW statement was not parsed with its target name: %v\n%s", err, output)
+	}
+}
+
