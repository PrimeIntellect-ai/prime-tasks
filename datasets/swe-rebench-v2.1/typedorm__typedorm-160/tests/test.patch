@@ -0,0 +1,113 @@
+// assuming there is a EMAIL_INDEX loaded before anything else
+process.env.EMAIL_INDEX = 'email-index-v2';
+
+import {testTable} from './test-table';
+import {EntityManager} from '@typedorm/core';
+import {createTestConnection, resetTestConnection} from '@typedorm/testing';
+import EntityData from './test-entity';
+let entityManager: EntityManager;
+
+const dcMock = {
+  query: jest.fn(),
+  get: jest.fn(),
+};
+beforeEach(() => {
+  const connection = createTestConnection({
+    entities: [EntityData],
+    table: testTable,
+    documentClient: dcMock,
+  });
+  entityManager = new EntityManager(connection);
+});
+
+afterEach(() => {
+  resetTestConnection();
+});
+
+test('entityManager find returns attributes that has the same name as key', async () => {
+  dcMock.query.mockReturnValue({
+    promise: () => ({
+      Items: [
+        {
+          SK: 'root',
+          stringSet: ['test'],
+          email: 'test-entity@gmail.com',
+          PK: 'entity#12345678',
+          name: 'ABCD',
+          secret: 'hidden-value',
+        },
+      ],
+    }),
+  });
+
+  const response = await entityManager.find(
+    EntityData,
+    'test-entity@gmail.com',
+    {
+      queryIndex: process.env.EMAIL_INDEX!,
+      limit: 1,
+    }
+  );
+
+  expect(response.items[0]).toBeInstanceOf(EntityData);
+  // the index attribute (email) must be present in the returned entity
+  expect(response.items[0].email).toEqual('test-entity@gmail.com');
+  expect(response.items[0].name).toEqual('ABCD');
+  // internal dynamo keys must not leak into the response
+  expect((response.items[0] as any).PK).toBeUndefined();
+  expect((response.items[0] as any).SK).toBeUndefined();
+  // hidden attributes must not be exposed
+  expect((response.items[0] as any).secret).toBeUndefined();
+});
+
+test('entityManager findOne returns the attribute used by a secondary index', async () => {
+  dcMock.get.mockReturnValue({
+    promise: () => ({
+      Item: {
+        SK: 'root',
+        email: 'test-entity@gmail.com',
+        PK: 'en#12345678',
+        name: 'ABCD',
+      },
+    }),
+  });
+
+  const response = await entityManager.findOne(EntityData, {});
+
+  expect(response?.email).toEqual('test-entity@gmail.com');
+});
+
+test('entityManager find queries the supplied secondary index with the given limit', async () => {
+  dcMock.query.mockReturnValue({
+    promise: () => ({Items: []}),
+  });
+
+  await entityManager.find(EntityData, 'test-entity@gmail.com', {
+    queryIndex: process.env.EMAIL_INDEX!,
+    limit: 1,
+  });
+
+  expect(dcMock.query).toHaveBeenCalledWith(
+    expect.objectContaining({
+      IndexName: process.env.EMAIL_INDEX,
+      Limit: 1,
+    })
+  );
+});
+
+test('entityManager find returns an empty items array when nothing matches', async () => {
+  dcMock.query.mockReturnValue({
+    promise: () => ({Items: []}),
+  });
+
+  const response = await entityManager.find(
+    EntityData,
+    'test-entity@gmail.com',
+    {
+      queryIndex: process.env.EMAIL_INDEX!,
+      limit: 1,
+    }
+  );
+
+  expect(response.items).toEqual([]);
+});
