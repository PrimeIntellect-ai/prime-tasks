+def test_decorate_async_generator_with_error_is_logged(writer):
+    logger.add(writer, format="{message}", diagnose=False, backtrace=False, colorize=False)
+
+    @logger.catch
+    async def generator():
+        yield 1
+        raise ValueError("boom")
+
+    async def coro():
+        return [value async for value in generator()]
+
+    assert asyncio.run(coro()) == [1]
+    assert "ValueError: boom" in writer.read()
+
+
+def test_decorate_async_generator_then_async_send_value():
+    @logger.catch
+    async def generator():
+        received = yield 1
+        yield received
+
+    async def coro():
+        gen = generator()
+        assert await gen.asend(None) == 1
+        sentinel = object()
+        assert await gen.asend(sentinel) is sentinel
+
+    asyncio.run(coro())
+
+
+def test_decorate_async_generator_then_async_throw_positional_arguments():
+    @logger.catch
+    async def generator():
+        try:
+            yield 1
+        except ValueError as error:
+            yield str(error)
+
+    async def coro():
+        gen = generator()
+        await gen.asend(None)
+        result = await gen.athrow(ValueError, ValueError("boom"), None)
+        assert result == "boom"
+
+    asyncio.run(coro())
+
+
+def test_decorate_async_generator_then_async_throw_returns_result():
+    @logger.catch
+    async def generator():
+        try:
+            yield 1
+        except ValueError:
+            yield 42
+
+    async def coro():
+        gen = generator()
+        await gen.asend(None)
+        result = await gen.athrow(ValueError)
+        assert result == 42
+
+    asyncio.run(coro())
+
+
