+func TestWorkflowRun_UnmarshalReferencedWorkflows(t *testing.T) {
+	const payload = `{"referenced_workflows":[{"path":".github/workflows/reusable.yml","sha":"abc123","ref":"refs/heads/main"},{"path":".github/workflows/another.yml","sha":"def456"}]}`
+
+	var run WorkflowRun
+	if err := json.Unmarshal([]byte(payload), &run); err != nil {
+		t.Fatalf("json.Unmarshal returned error: %v", err)
+	}
+	encoded, err := json.Marshal(&run)
+	if err != nil {
+		t.Fatalf("json.Marshal returned error: %v", err)
+	}
+	var roundTrip struct {
+		ReferencedWorkflows []struct {
+			Path string `json:"path"`
+			SHA  string `json:"sha"`
+			Ref  string `json:"ref"`
+		} `json:"referenced_workflows"`
+	}
+	if err := json.Unmarshal(encoded, &roundTrip); err != nil {
+		t.Fatalf("decoding marshaled workflow run returned error: %v", err)
+	}
+	want := []struct{ path, sha, ref string }{
+		{".github/workflows/reusable.yml", "abc123", "refs/heads/main"},
+		{".github/workflows/another.yml", "def456", ""},
+	}
+	if len(roundTrip.ReferencedWorkflows) != len(want) {
+		t.Fatalf("got %d referenced workflows, want %d", len(roundTrip.ReferencedWorkflows), len(want))
+	}
+	for i, workflow := range roundTrip.ReferencedWorkflows {
+		if workflow.Path != want[i].path || workflow.SHA != want[i].sha || workflow.Ref != want[i].ref {
+			t.Errorf("referenced workflow %d = (%q, %q, %q), want (%q, %q, %q)", i, workflow.Path, workflow.SHA, workflow.Ref, want[i].path, want[i].sha, want[i].ref)
+		}
+	}
+}
+
+func TestWorkflowRun_UnmarshalReferencedWorkflows_Null(t *testing.T) {
+	var run WorkflowRun
+	if err := json.Unmarshal([]byte(`{"referenced_workflows":null}`), &run); err != nil {
+		t.Fatalf("json.Unmarshal of null referenced_workflows returned error: %v", err)
+	}
+}
