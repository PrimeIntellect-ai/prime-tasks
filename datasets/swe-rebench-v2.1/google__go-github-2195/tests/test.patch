+func TestIssuesService_CanClearMilestone(t *testing.T) {
+	client, mux, _, teardown := setup()
+	defer teardown()
+	cleared := false
+	mux.HandleFunc("/repos/o/r/issues/1", func(w http.ResponseWriter, r *http.Request) {
+		testMethod(t, r, "PATCH")
+
+		var payload map[string]interface{}
+		if err := json.NewDecoder(r.Body).Decode(&payload); err != nil {
+			t.Fatalf("Error decoding request body: %v", err)
+		}
+		milestone, ok := payload["milestone"]
+		if !ok || milestone != nil {
+			t.Errorf("request milestone = %v (present: %t), want null", milestone, ok)
+		}
+		cleared = true
+		fmt.Fprint(w, `{}`)
+	})
+
+	method := reflect.ValueOf(client.Issues).MethodByName("RemoveMilestone")
+	if !method.IsValid() {
+		t.Fatal("IssuesService does not provide RemoveMilestone")
+	}
+	ctx := context.Background()
+	args := []reflect.Value{reflect.ValueOf(ctx), reflect.ValueOf("o"), reflect.ValueOf("r"), reflect.ValueOf(1)}
+	methodType := method.Type()
+	if methodType.NumIn() < len(args) {
+		t.Fatalf("RemoveMilestone accepts %d arguments, want at least %d", methodType.NumIn(), len(args))
+	}
+	for i, arg := range args {
+		wantType := methodType.In(i)
+		if arg.Type().AssignableTo(wantType) {
+			continue
+		}
+		if arg.Type().ConvertibleTo(wantType) {
+			args[i] = arg.Convert(wantType)
+			continue
+		}
+		t.Fatalf("RemoveMilestone argument %d has type %v, want assignable or convertible to %v", i, arg.Type(), wantType)
+	}
+	for i := len(args); i < methodType.NumIn(); i++ {
+		args = append(args, reflect.Zero(methodType.In(i)))
+	}
+	if methodType.IsVariadic() {
+		method.CallSlice(args)
+	} else {
+		method.Call(args)
+	}
+	if !cleared {
+		t.Error("RemoveMilestone did not send a request to clear the milestone")
+	}
+}
