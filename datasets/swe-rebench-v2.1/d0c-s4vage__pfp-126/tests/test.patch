 import sys
@@ -318,6 +319,40 @@ class TestArrays(utils.PfpTestCase):
         self.assertEqual(items[2].second, 0x48)
         self.assertEqual(items[2].third, 0x49)
 
+    def test_array_with_root_scope(self):
+        # Implicit arrays must be resolvable through the scope, not only as a
+        # struct/union child.  The contract's example prints the first byte of
+        # the implicit array on every iteration; the exact zero-padding of the
+        # printed value is not part of the contract, so accept both the padded
+        # ("00") and unpadded ("0") representations of the same value.
+        fake_stdout = io.StringIO()
+        old_stdout = sys.stdout
+        sys.stdout = fake_stdout
+        try:
+            self._test_parse_build(
+                "\x00\x01\x02\x03",
+                """
+                    typedef struct {
+                        char a_byte;
+                        Printf("%02x|", item[0].a_byte);
+                    } simple_struct;
+
+                    while (!FEof()) {
+                        simple_struct item;
+                    }
+                """,
+            )
+        finally:
+            sys.stdout = old_stdout
+
+        output = fake_stdout.getvalue()
+        values = output.split("|")
+        self.assertEqual(values[-1], "")
+        values = values[:-1]
+        self.assertEqual(len(values), 4)
+        for value in values:
+            self.assertEqual(int(value, 16), 0)
+
 
 if __name__ == "__main__":
     unittest.main()
