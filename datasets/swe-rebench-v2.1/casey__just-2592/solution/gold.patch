diff --git a/src/assignment.rs b/src/assignment.rs
index 5822fc6a..c41ecbab 100644
--- a/src/assignment.rs
+++ b/src/assignment.rs
@@ -5,9 +5,14 @@ pub(crate) type Assignment<'src> = Binding<'src, Expression<'src>>;
 
 impl Display for Assignment<'_> {
   fn fmt(&self, f: &mut Formatter) -> fmt::Result {
+    if self.private {
+      writeln!(f, "[private]")?;
+    }
+
     if self.export {
       write!(f, "export ")?;
     }
+
     write!(f, "{} := {}", self.name, self.value)
   }
 }
