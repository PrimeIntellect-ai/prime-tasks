+func TestBackupProgramVersion(t *testing.T) {
+	env, cleanup := withTestEnvironment(t)
+	defer cleanup()
+
+	testSetupBackupData(t, env)
+	originalVersion := version
+	defer func() { version = originalVersion }()
+	creationVersion := "older-client-version"
+	version = creationVersion
+	testRunBackup(t, "", []string{env.testdata}, BackupOptions{}, env.gopts)
+
+	// Snapshot JSON must retain the version used at creation, even when a newer
+	// client lists the snapshot later.
+	version = "newer-client-version"
+	buf, err := withCaptureStdout(func() error {
+		env.gopts.JSON = true
+		opts := SnapshotOptions{}
+		return runSnapshots(context.TODO(), opts, env.gopts, []string{})
+	})
+	rtest.OK(t, err)
+
+	var snapshots []map[string]interface{}
+	rtest.OK(t, json.Unmarshal(buf.Bytes(), &snapshots))
+	if len(snapshots) != 1 {
+		t.Fatalf("expected exactly one snapshot, got %d", len(snapshots))
+	}
+
+	var containsVersion func(interface{}) bool
+	containsVersion = func(value interface{}) bool {
+		switch value := value.(type) {
+		case string:
+			return strings.Contains(value, creationVersion)
+		case map[string]interface{}:
+			for _, nested := range value {
+				if containsVersion(nested) {
+					return true
+				}
+			}
+		case []interface{}:
+			for _, nested := range value {
+				if containsVersion(nested) {
+					return true
+				}
+			}
+		}
+		return false
+	}
+	rtest.Assert(t, containsVersion(snapshots[0]), "expected snapshot JSON to identify creation version %q, got %v", creationVersion, snapshots[0])
+}
