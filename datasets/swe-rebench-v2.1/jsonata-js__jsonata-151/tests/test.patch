+// The AST node type used to represent literal values (numbers, strings and
+// true/false/null) is an internal representation detail.  Accept either the
+// historical 'literal' type or the more specific token-derived types.
+function normalizeLiteralTypes(node) {
+    if (Array.isArray(node)) {
+        return node.map(normalizeLiteralTypes);
+    }
+    if (node !== null && typeof node === 'object') {
+        var normalized = {};
+        Object.keys(node).forEach(function(key) {
+            var value = node[key];
+            if (key === 'type' && (value === 'number' || value === 'value' || value === 'string')) {
+                normalized[key] = 'literal';
+            } else {
+                normalized[key] = normalizeLiteralTypes(value);
+            }
+        });
+        return normalized;
+    }
+    return node;
+}
