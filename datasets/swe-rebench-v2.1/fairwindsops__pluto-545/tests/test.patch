+// TestKubeconfigFlag exercises the command-line --kubeconfig flag: the file
+// given to the flag must be used as the kubeconfig for the command, taking
+// precedence over the KUBECONFIG environment variable.
+func TestKubeconfigFlag(t *testing.T) {
+	repoRoot, err := filepath.Abs(filepath.Join("..", ".."))
+	if err != nil {
+		t.Fatalf("could not determine repository root: %v", err)
+	}
+
+	bin := filepath.Join(t.TempDir(), "pluto")
+	build := exec.Command("go", "build", "-o", bin, "./cmd/pluto")
+	build.Dir = repoRoot
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("could not build pluto: %v\n%s", err, out)
+	}
+
+	validConfig := filepath.Join(repoRoot, "pkg", "kube", "testdata", "kubeconfig")
+	invalidConfig := filepath.Join(repoRoot, "pkg", "kube", "testdata", "kubeconfig_invalid")
+
+	// The valid kubeconfig points at the server 127.0.0.1:54753. Each
+	// cluster-backed command must accept the flag and use its value instead
+	// of the environment setting. Commands that expose a connection error
+	// include the server address in that error.
+	for _, command := range []string{"detect-helm", "detect-api-resources", "detect-all-in-cluster"} {
+		t.Run(command, func(t *testing.T) {
+			run := exec.Command(bin, command, "--kubeconfig", validConfig)
+			run.Dir = repoRoot
+			run.Env = append(os.Environ(), "KUBECONFIG="+invalidConfig)
+			out, _ := run.CombinedOutput()
+			if command == "detect-helm" {
+				assert.Contains(t, string(out), "127.0.0.1:54753")
+			} else {
+				assert.NotContains(t, string(out), "unknown flag")
+			}
+
+			// An explicitly supplied invalid file must not silently fall back
+			// to the valid KUBECONFIG environment value.
+			invalidRun := exec.Command(bin, command, "--kubeconfig", invalidConfig)
+			invalidRun.Dir = repoRoot
+			invalidRun.Env = append(os.Environ(), "KUBECONFIG="+validConfig)
+			if _, err := invalidRun.CombinedOutput(); err == nil {
+				t.Fatal("command succeeded despite the explicitly selected invalid kubeconfig")
+			}
+		})
+	}
+}
