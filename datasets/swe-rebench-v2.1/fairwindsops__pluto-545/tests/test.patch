+// callGetConfig loads a Kubernetes REST configuration for the given context and
+// optional kubeconfig file path. It accepts both the two-argument form and the
+// legacy one-argument form so that a solution which ignores the kubeconfig path
+// fails on behaviour rather than on compilation.
+func callGetConfig(kubeContext, kubeConfigPath string) error {
+	switch fn := interface{}(GetConfig).(type) {
+	case func(string, string) (*rest.Config, error):
+		_, err := fn(kubeContext, kubeConfigPath)
+		return err
+	case func(string) (*rest.Config, error):
+		_, err := fn(kubeContext)
+		return err
+	default:
+		return fmt.Errorf("GetConfig has an unexpected signature")
+	}
+}
