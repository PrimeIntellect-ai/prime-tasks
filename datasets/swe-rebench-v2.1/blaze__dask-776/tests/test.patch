+def test_reductions_2D_nans():
+    # chunks are a mix of some/all/no NaNs
+    x = np.full((4, 4), np.nan)
+    x[:2, :2] = np.array([[1, 2], [3, 4]])
+    x[2, 2] = 5
+    x[3, 3] = 6
+    a = da.from_array(x, chunks=(2, 2))
+
+    for axis in (None, 0, 1, (1, 0)):
+        assert eq(da.nanmax(a, axis=axis), np.nanmax(x, axis=axis))
+
+    assert eq(da.nanmax(a, axis=1, keepdims=True),
+              np.nanmax(x, axis=1, keepdims=True))
+
