+    def test_preset_pass_manager_default_approximation_matches_transpile(self):
+        """Test that generate_preset_pass_manager, called without approximation_degree,
+        produces the same circuit as transpile on a backend target.
+
+        Approximation changes the output on this input at optimization level 3, so the default
+        approximation behaviour of the preset pass manager is observable here.
+        """
+        backend = FakeManilaV2()
+        circuit = random_circuit(4, 6, max_operands=2, seed=0)
+        expected = transpile(circuit, backend, optimization_level=3, seed_transpiler=1)
+        pass_manager = generate_preset_pass_manager(
+            optimization_level=3, target=backend.target, seed_transpiler=1
+        )
+        self.assertEqual(pass_manager.run(circuit), expected)
+
 
