+// TestRichMenuSwitchAction verifies that a rich menu switch action can be
+// represented in the rich menu action object and round-trips through JSON with
+// the richmenuswitch type and the target rich menu alias id.
+func TestRichMenuSwitchAction(t *testing.T) {
+	raw := `{"type":"richmenuswitch","richMenuAliasId":"richmenu-alias-a","data":"action=richmenu-changed-to-a"}`
+	var action RichMenuAction
+	if err := json.Unmarshal([]byte(raw), &action); err != nil {
+		t.Fatal(err)
+	}
+	gotJSON, err := json.Marshal(action)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]interface{}{}
+	if err := json.Unmarshal(gotJSON, &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["type"] != "richmenuswitch" {
+		t.Errorf("type %v; want %v", got["type"], "richmenuswitch")
+	}
+	if got["richMenuAliasId"] != "richmenu-alias-a" {
+		t.Errorf("richMenuAliasId %v; want %v", got["richMenuAliasId"], "richmenu-alias-a")
+	}
+}
+
+func TestPostbackParamsExposeRichMenuSwitchFields(t *testing.T) {
+	params := Params{
+		NewRichMenuAliasID: "richmenu-alias-a",
+		Status:             "SUCCESS",
+	}
+	if params.NewRichMenuAliasID != "richmenu-alias-a" {
+		t.Errorf("NewRichMenuAliasID = %q, want %q", params.NewRichMenuAliasID, "richmenu-alias-a")
+	}
+	if params.Status != "SUCCESS" {
+		t.Errorf("Status = %q, want %q", params.Status, "SUCCESS")
+	}
+}
