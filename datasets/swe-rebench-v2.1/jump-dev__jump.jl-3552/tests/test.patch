+function test_SkipModelConvertScalarSetWrapper()
+    # The type is public: it is exported by JuMP.
+    @test :SkipModelConvertScalarSetWrapper in names(JuMP)
+    @test JuMP.SkipModelConvertScalarSetWrapper ===
+          SkipModelConvertScalarSetWrapper
+    # The wrapper is a subtype of MOI.AbstractScalarSet.
+    @test SkipModelConvertScalarSetWrapper <: MOI.AbstractScalarSet
+    model = Model()
+    @variable(model, x)
+    for set in (MOI.EqualTo(1 // 2), MOI.Interval(1 // 3, 2 // 3))
+        wrapper = SkipModelConvertScalarSetWrapper(set)
+        # The constructor preserves the concrete type and value of the set.
+        @test wrapper.set === set
+        # The wrapper is immutable.
+        @test isimmutable(wrapper)
+        # moi_set returns the inner set.
+        @test moi_set(ScalarConstraint(x, wrapper)) === set
+    end
+    # Wrapping prevents promotion of the set to the model's value type.
+    set = MOI.EqualTo(1 // 2)
+    @variable(model, y)
+    c1 = @constraint(model, x in set)
+    c2 = @constraint(model, y in SkipModelConvertScalarSetWrapper(set))
+    @test constraint_object(c1).set === MOI.EqualTo(0.5)
+    @test constraint_object(c2).set === MOI.EqualTo(1 // 2)
+    return
+end
+
+function test_SkipModelConvertScalarSetWrapper_solver_set()
+    model = Model()
+    set_optimizer(
+        model,
+        () -> MOIU.MockOptimizer(
+            MOIU.Model{Rational{Int}}();
+            eval_objective_value = false,
+            eval_variable_constraint_dual = false,
+        ),
+    )
+    @variable(model, x)
+    @variable(model, y)
+    set1 = MOI.EqualTo(1 // 2)
+    set2 = MOI.Interval(1 // 3, 2 // 3)
+    c1 = @constraint(model, x in SkipModelConvertScalarSetWrapper(set1))
+    c2 = @constraint(model, y in SkipModelConvertScalarSetWrapper(set2))
+    MOIU.attach_optimizer(model)
+    # The set received by the optimizer is the set supplied by the user.
+    @test MOI.get(
+        unsafe_backend(model),
+        MOI.ConstraintSet(),
+        optimizer_index(c1),
+    ) === set1
+    @test MOI.get(
+        unsafe_backend(model),
+        MOI.ConstraintSet(),
+        optimizer_index(c2),
+    ) === set2
+    return
 end
+
+end  # module
