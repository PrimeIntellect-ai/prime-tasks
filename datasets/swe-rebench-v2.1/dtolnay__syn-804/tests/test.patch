+#[macro_use]
+mod macros;
+
+use quote::quote;
+use syn::ItemTrait;
+
+#[test]
+fn test_const_underscore_in_trait() {
+    let input = quote! {
+        pub trait A {
+            const _: () = ();
+        }
+    };
+
+    snapshot!(input as ItemTrait, @r###"
+    ItemTrait {
+        vis: Visibility::Public,
+        ident: "A",
+        generics: Generics,
+        items: [
+            TraitItem::Const {
+                ident: "_",
+                ty: Type::Tuple,
+                default: Some(Expr::Tuple),
+            },
+        ],
+    }
+    "###);
+}
