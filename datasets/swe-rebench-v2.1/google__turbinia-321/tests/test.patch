 from __future__ import unicode_literals
 
+import importlib.util
+import os
+import sys
+import types
 import unittest
+from unittest import mock
 
 from turbinia.jobs import interface
 from turbinia.jobs import manager
 
+TOOL_PATH = os.path.join(
+    os.path.dirname(os.path.abspath(__file__)), '..', '..', 'tools',
+    'turbinia_job_graph.py')
+
+
+class GraphInputEvidence(object):
+  """Test evidence type consumed by a test job."""
+
+
+class GraphOutputEvidence(object):
+  """Test evidence type produced by a test job."""
+
+
+class TestGraphJob(interface.TurbiniaJob):
+  """Test job with evidence inputs and outputs."""
+
+  NAME = 'testgraphjob'
+  evidence_input = [GraphInputEvidence]
+  evidence_output = [GraphOutputEvidence]
+
+  # pylint: disable=unused-argument
+  def create_tasks(self, evidence):
+    """Returns None, for testing."""
+    return None
+
+
+class FakeDigraph(object):
+  """Stand-in for graphviz.Digraph that records nodes and edges."""
+
+  def __init__(self, *args, **kwargs):
+    self.node_names = set()
+    self.edges = set()
+
+  def node(self, name, *args, **kwargs):
+    self.node_names.add(name)
+
+  def edge(self, tail_name, head_name, *args, **kwargs):
+    self.edges.add((tail_name, head_name))
+
 
 class TestJob1(interface.TurbiniaJob):
   """Test job."""
@@ -94,6 +138,30 @@ class JobsManagerTest(unittest.TestCase):
     for job in jobs:
       self.assertIsInstance(job, interface.TurbiniaJob)
 
+  def testJobGraphToolCreatesJobEvidenceGraph(self):
+    """Tests that the job graph tool builds a graph from registered jobs."""
+    fake_graphviz = types.ModuleType('graphviz')
+    fake_graphviz.Digraph = FakeDigraph
+
+    spec = importlib.util.spec_from_file_location(
+        'turbinia_job_graph', TOOL_PATH)
+    graph_tool = importlib.util.module_from_spec(spec)
+
+    manager.JobsManager.RegisterJob(TestGraphJob)
+    try:
+      with mock.patch.dict(sys.modules, {'graphviz': fake_graphviz}):
+        spec.loader.exec_module(graph_tool)
+        graph = graph_tool.create_graph()
+    finally:
+      manager.JobsManager.DeregisterJob(TestGraphJob)
+
+    self.assertIsInstance(graph, FakeDigraph)
+    self.assertIn('testgraphjob', graph.node_names)
+    self.assertIn('GraphInputEvidence', graph.node_names)
+    self.assertIn('GraphOutputEvidence', graph.node_names)
+    self.assertIn(('GraphInputEvidence', 'testgraphjob'), graph.edges)
+    self.assertIn(('testgraphjob', 'GraphOutputEvidence'), graph.edges)
+
 
 if __name__ == '__main__':
   unittest.main()
