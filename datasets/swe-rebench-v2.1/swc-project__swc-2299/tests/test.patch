+#[test]
+fn issue_2297_1() {
+    crate::tests::Tester::run(|tester| {
+        let mark1 = Mark::fresh(Mark::root());
+        let mark2 = Mark::fresh(Mark::root());
+
+        let stmts = tester
+            .parse_stmts(
+                "actual1.js",
+                "
+                var _bar = require('./Bar');
+                var makeX = function(props) {
+                    var _bar = props.bar;
+                    var list = _bar.list;
+                    return list.map(function() {
+                        return _bar.bar;
+                    });
+                };
+                ",
+            )?
+            .fold_with(&mut OnceMarker::new(&[(
+                "_bar",
+                &[mark1, mark2, mark2, mark1],
+            )]));
+
+        let module = Module {
+            span: DUMMY_SP,
+            body: stmts.into_iter().map(ModuleItem::Stmt).collect(),
+            shebang: None,
+        };
+
+        let module = module.fold_with(&mut hygiene_with_config(Default::default()));
+        let actual = tester.print(&module);
+
+        // The additional contract requirements require the hygiene pass to give
+        // the two bindings different names; either one may be renamed.
+        let import_name = var_name_before(&actual, " = require(")
+            .expect("generated import binding not found");
+        let fn_var_name =
+            var_name_before(&actual, " = props.bar").expect("function variable not found");
+
+        assert_ne!(
+            import_name, fn_var_name,
+            "generated import name must not conflict with function variable:\n{}",
+            actual
+        );
+
+        // The renamed binding must be used consistently.
+        assert!(
+            actual.contains(&format!("{}.list", fn_var_name)),
+            "function variable references were not updated:\n{}",
+            actual
+        );
+        assert!(
+            actual.contains(&format!("{}.bar", import_name)),
+            "import references were not updated:\n{}",
+            actual
+        );
+
+        Ok(())
+    });
+}
+
+fn var_name_before(output: &str, marker: &str) -> Option<String> {
+    let idx = output.find(marker)?;
+    let before = &output[..idx];
+    let start = before.rfind("var ")? + "var ".len();
+    Some(before[start..].trim().to_string())
+}
