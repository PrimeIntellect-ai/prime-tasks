index a64e54f..4358774 100644
--- a/test/stream.js
+++ b/test/stream.js
@@ -189,3 +189,48 @@ test('destroying got.stream() cancels the request', async t => {
 	stream.destroy();
 	t.truthy(req.aborted);
 });
+
+test('piping to got.stream.put()', async t => {
+	const server = await createServer();
+
+	try {
+		let method;
+		const chunks = [];
+		let resolveReceived;
+		const received = new Promise(resolve => {
+			resolveReceived = resolve;
+		});
+
+		server.on('/post', (request, response) => {
+			method = request.method;
+			request.on('data', chunk => {
+				chunks.push(chunk);
+			});
+			request.on('end', () => {
+				response.end('ok');
+				resolveReceived();
+			});
+		});
+
+		await server.listen(server.port);
+
+		const putStream = got.stream.put(`${server.url}/post`);
+		let requestError;
+		const errored = new Promise(resolve => {
+			putStream.on('error', error => {
+				requestError = error;
+				resolve();
+			});
+		});
+
+		toReadableStream('wow').pipe(putStream);
+
+		await Promise.race([received, errored]);
+
+		t.falsy(requestError);
+		t.is(method, 'PUT');
+		t.is(Buffer.concat(chunks).toString(), 'wow');
+	} finally {
+		await server.close();
+	}
+});
