+        # Equivalent dimensions to the reported atomic-unit preferences: length,
+        # time, mass, and current specified with compound charge/time units.
+        Unitful.preferunits(cm, u"ns", kg, C/u"ns")
+        @test dimension(upreferred(V/cm)) == dimension(V/cm)
