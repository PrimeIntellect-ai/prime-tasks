+    def test_relative_url_conversion(self):
+        # see github issue #1817 - converting an OTIO to OTIOZ fails when a
+        # media target_url is a relative path with only one name after the "."
+        # (ie "./blah" but not "./blah/blah")
+        media_basename = os.path.basename(MEDIA_EXAMPLE_PATH_ABS)
+        with tempfile.TemporaryDirectory() as tempdir:
+            shutil.copyfile(
+                MEDIA_EXAMPLE_PATH_ABS,
+                os.path.join(tempdir, media_basename),
+            )
+
+            timeline = otio.adapters.read_from_file(SCREENING_EXAMPLE_PATH)
+            for clip in timeline.find_clips():
+                clip.media_reference = otio.schema.ExternalReference(
+                    target_url=os.path.join(".", media_basename)
+                )
+
+            output_path = os.path.join(tempdir, "output.otioz")
+            cwd = os.getcwd()
+            try:
+                os.chdir(tempdir)
+                otio.adapters.write_to_file(timeline, output_path)
+            finally:
+                os.chdir(cwd)
+
+            self.assertTrue(os.path.exists(output_path))
+
+            # the bundled media should be readable back out of the OTIOZ
+            result = otio.adapters.read_from_file(output_path)
+            for clip in result.find_clips():
+                self.assertIn(
+                    media_basename,
+                    clip.media_reference.target_url,
+                )
+
 
 if __name__ == "__main__":
     unittest.main()
