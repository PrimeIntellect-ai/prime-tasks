+def _render_app(monkeypatch, param, checked_index):
+    """
+    Run the application once with the sidebar checkbox at ``checked_index`` checked
+    (``None`` leaves every sidebar checkbox unchecked). Returns the sidebar checkbox
+    labels in the order they were rendered and the rendered admissions and census charts.
+    """
+    import penn_chime.view.st_app as st_app
+
+    class _FakeSidebar:
+        def __init__(self, session_state):
+            self.session_state = session_state
+            self.checkbox_labels = []
+
+        def markdown(self, *args, **kwargs):
+            return None
+
+        def subheader(self, *args, **kwargs):
+            return None
+
+        def text_input(self, *args, **kwargs):
+            return ""
+
+        def button(self, *args, **kwargs):
+            return False
+
+        def checkbox(self, label=None, value=None, **kwargs):
+            index = len(self.checkbox_labels)
+            self.checkbox_labels.append(label)
+            lowered = str(label).lower()
+            checked = index == checked_index or "social" in lowered or "distanc" in lowered
+            key = kwargs.get("key")
+            if key is not None:
+                self.session_state[key] = checked
+            return checked
+
+        def number_input(self, label=None, **kwargs):
+            return kwargs.get("value")
+
+        def date_input(self, label=None, **kwargs):
+            return kwargs.get("value")
+
+    class _FakeStreamlit:
+        def __init__(self):
+            self.session_state = {}
+            self.sidebar = _FakeSidebar(self.session_state)
+            self.rendered_charts = []
+
+        def markdown(self, *args, **kwargs):
+            return None
+
+        def subheader(self, *args, **kwargs):
+            return None
+
+        def altair_chart(self, chart, **kwargs):
+            self.rendered_charts.append(chart)
+
+        def checkbox(self, *args, **kwargs):
+            return False
+
+        def image(self, *args, **kwargs):
+            return None
+
+    class _FakeParameters:
+        @staticmethod
+        def create(*args, **kwargs):
+            return param
+
+    class _FakePPE:
+        def __init__(self, *args, **kwargs):
+            self.filename = "ppe.xlsx"
+            self.src = ""
+            self.screenshot = ""
+
+    monkeypatch.setattr(st_app, "Parameters", _FakeParameters)
+    monkeypatch.setattr(st_app, "PPE", _FakePPE)
+    monkeypatch.setattr(st_app, "display_header", lambda *a, **k: None)
+    monkeypatch.setattr(st_app, "display_download_link", lambda *a, **k: None)
+    monkeypatch.setattr(st_app, "display_excel_download_link", lambda *a, **k: None)
+    monkeypatch.setattr(st_app, "display_footer", lambda *a, **k: None)
+
+    fake_st = _FakeStreamlit()
+    monkeypatch.setattr(st_app, "st", fake_st)
+    st_app.main()
+
+    admits = [
+        chart
+        for chart in fake_st.rendered_charts
+        if admits_hospitalized_key in chart.data.columns
+    ]
+    census = [
+        chart
+        for chart in fake_st.rendered_charts
+        if census_hospitalized_key in chart.data.columns
+    ]
+    assert admits, "Expected the application to render the admissions chart"
+    assert census, "Expected the application to render the census chart"
+    return fake_st.sidebar.checkbox_labels, admits + census
+
+
+def _sidebar_checkboxes_enabling_log_scale(monkeypatch, param):
+    """Return the indices of sidebar checkboxes which, when checked alone, switch every chart to log scale."""
+    labels, _ = _render_app(monkeypatch, param, None)
+    enabling = []
+    for index in range(len(labels)):
+        try:
+            _, charts = _render_app(monkeypatch, param, index)
+        except Exception:
+            # Some checkboxes route the fake inputs into an unsupported configuration and the
+            # app cannot render charts at all; such a checkbox does not switch the scale to log.
+            continue
+        if all("log" in _y_scale_types(chart) for chart in charts):
+            enabling.append(index)
+    return labels, enabling
+
+
+def test_sidebar_log_scale_checkbox(monkeypatch, param):
+    """
+    The sidebar must expose a checkbox that, when checked, switches the charts'
+    Y-axis scale to logarithmic.
+    """
+    labels, enabling = _sidebar_checkboxes_enabling_log_scale(monkeypatch, param)
+    assert labels, "Expected the sidebar to render checkboxes"
+    assert enabling, f"Expected a sidebar checkbox that enables log scale, found {labels}"
+
+
+def test_sidebar_log_scale_checkbox_unchecked(monkeypatch, param):
+    """With every sidebar checkbox unchecked, the charts keep the non-log default scale."""
+    _, charts = _render_app(monkeypatch, param, None)
+    assert charts
+    for chart in charts:
+        assert "log" not in _y_scale_types(chart)
+
+
+def test_sidebar_log_scale_checkbox_at_bottom(monkeypatch, param):
+    """
+    The log-scale checkbox sits at the bottom of the sidebar, after the other
+    parameter controls.
+    """
+    labels, enabling = _sidebar_checkboxes_enabling_log_scale(monkeypatch, param)
+    assert labels, "Expected the sidebar to render checkboxes"
+    assert enabling == [len(labels) - 1], (
+        "Expected the log-scale checkbox to be the last checkbox in the sidebar, "
+        f"but the checkboxes were {labels} and the log-enabling ones were {enabling}"
+    )
+
+
+def test_sidebar_checkbox_controls_chart_log_scale(monkeypatch, param):
+    """
+    Checking the sidebar log-scale checkbox must cause the charts rendered by the
+    application to use a logarithmic Y-axis, and leaving it unchecked must keep them linear.
+    """
+    labels, enabling = _sidebar_checkboxes_enabling_log_scale(monkeypatch, param)
+    assert enabling, f"Expected a sidebar checkbox that enables log scale, found {labels}"
+    for index in enabling:
+        _, charts = _render_app(monkeypatch, param, index)
+        assert charts
+        for chart in charts:
+            assert "log" in _y_scale_types(chart)
