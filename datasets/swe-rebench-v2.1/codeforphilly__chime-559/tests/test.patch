+def _find_y_encodings(spec):
+    """Recursively collect every ``y`` encoding from a Vega-Lite chart spec."""
+    found = []
+    if isinstance(spec, dict):
+        for key, value in spec.items():
+            if key == "y" and isinstance(value, dict):
+                found.append(value)
+            else:
+                found.extend(_find_y_encodings(value))
+    elif isinstance(spec, list):
+        for item in spec:
+            found.extend(_find_y_encodings(item))
+    return found
+
+
+def _y_scale_types(chart):
+    """Return the set of scale types applied to the chart's Y axis/axes."""
+    types = set()
+    for encoding in _find_y_encodings(chart.to_dict()):
+        scale = encoding.get("scale")
+        if isinstance(scale, dict) and "type" in scale:
+            types.add(scale["type"])
+    return types
+
