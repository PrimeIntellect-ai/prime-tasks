 import { Options } from "../../../../shared/types.js";
 import { createWorkflows } from "./createWorkflows.js";
 
+const removePermissionBlocks = (workflow: string) => {
+	const lines: string[] = [];
+	let permissionIndentation: number | undefined;
+
+	for (const line of workflow.split("\n")) {
+		if (permissionIndentation !== undefined) {
+			if (line.trim() === "") {
+				lines.push(line);
+				continue;
+			}
+
+			const indentation = line.match(/^ */)?.[0].length ?? 0;
+			if (indentation > permissionIndentation) {
+				continue;
+			}
+			permissionIndentation = undefined;
+		}
+
+		const permission = line.match(/^( *)permissions:/);
+		if (permission) {
+			if (lines.at(-1) === "") {
+				lines.pop();
+			}
+			permissionIndentation = permission[1].length;
+			continue;
+		}
+
+		lines.push(line);
+	}
+
+	return lines.join("\n");
+};
