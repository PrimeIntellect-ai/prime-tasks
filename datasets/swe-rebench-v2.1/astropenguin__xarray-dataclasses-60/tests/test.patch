+def _contains_type(annotation: object, referenced_class: type) -> bool:
+    return annotation is referenced_class or any(
+        _contains_type(argument, referenced_class) for argument in get_args(annotation)
+    )
+
+
+def _has_array_metadata(descriptor: object, dims: tuple[str, ...], dtype: str) -> bool:
+    descriptor_type = getattr(descriptor, "type", None)
+    if isinstance(descriptor_type, dict):
+        return descriptor_type == {"dims": dims, "dtype": dtype}
+    return descriptor.dims == dims and descriptor.dtype == dtype
 
 
