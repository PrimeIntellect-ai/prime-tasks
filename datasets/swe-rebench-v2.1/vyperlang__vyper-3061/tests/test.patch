+def test_empty_nested_dynarray(get_contract, get_logs):
+    code = """
+event E:
+    _: DynArray[DynArray[uint256, 5], 5]
+
+@external
+def createEvent(x: uint256):
+    arr: DynArray[DynArray[uint256, 5], 5] = [[], []]
+    arr[0] = [0, 0]
+    arr[1] = [0, 0]
+    arr[0][0] = x
+    arr[0][1] = x + 1
+    arr[1][0] = x + 2
+    arr[1][1] = x + 3
+    log E(arr)
+    """
+    c = get_contract(code)
+    logs = get_logs(c.createEvent(42, transact={}), c, "E")
+
+    assert len(logs) == 1
+    assert list(logs[0].args.values())[0] == [[42, 43], [44, 45]]
+
