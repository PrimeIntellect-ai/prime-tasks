+it('count in nested object', async () => {
+  const state = proxyWithHistory({ nested: { count: 0 } })
+
+  const Counter: React.FC = () => {
+    const snap = useSnapshot(state)
+    return (
+      <>
+        <div>count: {snap.value.nested.count}</div>
+        <button onClick={() => ++state.value.nested.count}>inc</button>
+        <button onClick={snap.undo}>undo</button>
+        <button onClick={snap.redo}>redo</button>
+      </>
+    )
+  }
+
+  const { getByText, findByText } = render(
+    <StrictMode>
+      <Counter />
+    </StrictMode>
+  )
+
+  await findByText('count: 0')
+
+  fireEvent.click(getByText('inc'))
+  await findByText('count: 1')
+
+  fireEvent.click(getByText('inc'))
+  await findByText('count: 2')
+
+  fireEvent.click(getByText('inc'))
+  await findByText('count: 3')
+
+  fireEvent.click(getByText('undo'))
+  await findByText('count: 2')
+
+  fireEvent.click(getByText('redo'))
+  await findByText('count: 3')
+
+  fireEvent.click(getByText('undo'))
+  await findByText('count: 2')
+
+  fireEvent.click(getByText('undo'))
+  await findByText('count: 1')
+
+  fireEvent.click(getByText('undo'))
+  await findByText('count: 0')
+
+  fireEvent.click(getByText('inc'))
+  await findByText('count: 1')
+
+  fireEvent.click(getByText('undo'))
+  await findByText('count: 0')
+})
+
+it('count in array', async () => {
+  const state = proxyWithHistory({ items: [0] })
+
+  const Counter: React.FC = () => {
+    const snap = useSnapshot(state)
+    return (
+      <>
+        <div>items: {snap.value.items.join(',')}</div>
+        <button onClick={() => state.value.items.push(state.value.items.length)}>
+          inc
+        </button>
+        <button onClick={snap.undo}>undo</button>
+        <button onClick={snap.redo}>redo</button>
+      </>
+    )
+  }
+
+  const { getByText, findByText } = render(
+    <StrictMode>
+      <Counter />
+    </StrictMode>
+  )
+
+  await findByText('items: 0')
+
+  fireEvent.click(getByText('inc'))
+  await findByText('items: 0,1')
+
+  fireEvent.click(getByText('inc'))
+  await findByText('items: 0,1,2')
+
+  fireEvent.click(getByText('undo'))
+  await findByText('items: 0,1')
+
+  fireEvent.click(getByText('redo'))
+  await findByText('items: 0,1,2')
+
+  fireEvent.click(getByText('undo'))
+  await findByText('items: 0,1')
+
+  fireEvent.click(getByText('undo'))
+  await findByText('items: 0')
+
+  fireEvent.click(getByText('undo'))
+  await findByText('items: 0')
+
+  fireEvent.click(getByText('inc'))
+  await findByText('items: 0,1')
+
+  fireEvent.click(getByText('undo'))
+  await findByText('items: 0')
+})
+
+it('canUndo and canRedo', async () => {
+  const state = proxyWithHistory({ count: 0 })
+
+  const Counter: React.FC = () => {
+    const snap = useSnapshot(state)
+    return (
+      <>
+        <div>count: {snap.value.count}</div>
+        <div>canUndo: {String(snap.canUndo())}</div>
+        <div>canRedo: {String(snap.canRedo())}</div>
+        <button onClick={() => ++state.value.count}>inc</button>
+        <button onClick={snap.undo}>undo</button>
+        <button onClick={snap.redo}>redo</button>
+      </>
+    )
+  }
+
+  const { getByText, findByText } = render(
+    <StrictMode>
+      <Counter />
+    </StrictMode>
+  )
+
+  await findByText('count: 0')
+  await findByText('canUndo: false')
+  await findByText('canRedo: false')
+
+  fireEvent.click(getByText('inc'))
+  await findByText('count: 1')
+  await findByText('canUndo: true')
+  await findByText('canRedo: false')
+
+  fireEvent.click(getByText('undo'))
+  await findByText('count: 0')
+  await findByText('canUndo: false')
+  await findByText('canRedo: true')
+
+  // undo at the oldest snapshot is a no-op
+  fireEvent.click(getByText('undo'))
+  await findByText('count: 0')
+  await findByText('canUndo: false')
+  await findByText('canRedo: true')
+
+  fireEvent.click(getByText('redo'))
+  await findByText('count: 1')
+  await findByText('canUndo: true')
+  await findByText('canRedo: false')
+
+  // redo at the latest snapshot is a no-op
+  fireEvent.click(getByText('redo'))
+  await findByText('count: 1')
+  await findByText('canUndo: true')
+  await findByText('canRedo: false')
 })
