+
+func TestDurableReplacedUsingPublicOption(t *testing.T) {
+	opts := GetDefaultOptions()
+	replaceDurable := reflect.ValueOf(opts).Elem().FieldByName("ReplaceDurable")
+	if !replaceDurable.IsValid() || replaceDurable.Kind() != reflect.Bool || !replaceDurable.CanSet() {
+		t.Fatal("Options must expose a public boolean ReplaceDurable field")
+	}
+	replaceDurable.SetBool(true)
+	s := runServerWithOpts(t, opts, nil)
+	defer s.Shutdown()
+
+	testDurableReplaced(t)
+}
+
+func TestDurableReplacedDisabledByDefault(t *testing.T) {
+	s := runServer(t, clusterName)
+	defer s.Shutdown()
+	sc := NewDefaultConnection(t)
+	defer sc.Close()
+
+	if _, err := sc.Subscribe("foo", func(*stan.Msg) {}, stan.DurableName("dur")); err != nil {
+		t.Fatalf("Unable to start durable: %v", err)
+	}
+	if _, err := sc.Subscribe("foo", func(*stan.Msg) {}, stan.DurableName("dur")); err == nil || !strings.Contains(err.Error(), "duplicate durable") {
+		t.Fatalf("Expected duplicate durable error with default options, got %v", err)
+	}
+}
+
+// enableReplaceDurable turns on the replace-durable behavior through the
+// public configuration-file key.
+func enableReplaceDurable(t *testing.T, opts *Options) {
+	t.Helper()
+	confFile := createConfFile(t, []byte("replace_durable: true"))
+	defer os.Remove(confFile)
+	if err := ProcessConfigFile(confFile, opts); err != nil {
+		t.Fatalf("Error processing config file: %v", err)
+	}
+}
+
+func testDurableReplaced(t *testing.T) {
+	sc := NewDefaultConnection(t)
+	defer sc.Close()
+
+	oldDelivered := make(chan *stan.Msg, 1)
+	newDelivered := make(chan *stan.Msg, 1)
+	dur1, err := sc.Subscribe("foo", func(m *stan.Msg) { oldDelivered <- m }, stan.DurableName("dur"))
+	if err != nil {
+		t.Fatalf("Unable to start durable: %v", err)
+	}
+	_ = dur1
+
+	if _, err = sc.Subscribe("foo", func(m *stan.Msg) { newDelivered <- m }, stan.DurableName("dur")); err != nil {
+		t.Fatalf("Unable to replace durable: %v", err)
+	}
+	if err := sc.Publish("foo", []byte("msg")); err != nil {
+		t.Fatalf("Unable to publish: %v", err)
+	}
+
+	select {
+	case <-newDelivered:
+	case <-time.After(2 * time.Second):
+		t.Fatal("Replacement durable did not receive the message")
+	}
+	select {
+	case <-oldDelivered:
+		t.Fatal("Replaced durable received the message")
+	case <-time.After(200 * time.Millisecond):
+	}
+}
