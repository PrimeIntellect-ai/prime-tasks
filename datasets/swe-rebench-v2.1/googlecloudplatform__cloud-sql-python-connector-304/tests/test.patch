+def test_connect_unsupported_driver_raises_keyerror() -> None:
+    """Test that connect() raises KeyError for an unsupported driver."""
+    connect_string = "test-project:test-region:test-instance"
+    _, _, metadata = _build_keys_and_metadata()
+    icm = MockInstanceConnectionManager(metadata=metadata)
+    default_connector = connector.Connector()
+    connector._default_connector = default_connector
+    with patch.dict(default_connector._instances, {connect_string: icm}):
+        with pytest.raises(KeyError):
+            connector.connect(connect_string, "unsupported-driver")
+    default_connector._instances = {}
