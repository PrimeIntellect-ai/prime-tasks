+def test_connect_invokes_driver_connect_routine(
+    driver: str, driver_target: str, driver_kwargs: Dict[str, Any]
+) -> None:
+    """Each supported driver dials the selected IP address, wraps the socket
+    with the instance SSL context, and its result is returned to the caller."""
+    connect_string = "test-project:test-region:test-instance"
+    _, _, metadata = _build_keys_and_metadata()
+    # A mock SSL context lets the socket wrapping be observed without a server.
+    ctx = MagicMock()
+    metadata.context = ctx
+    icm = MockInstanceConnectionManager(metadata=metadata)
+    default_connector = connector.Connector()
+    connector._default_connector = default_connector
+    with patch.dict(default_connector._instances, {connect_string: icm}):
+        with patch("socket.create_connection") as mock_create_connection, patch(
+            driver_target
+        ) as mock_driver:
+            expected = MagicMock()
+            mock_driver.return_value = expected
+            result = connector.connect(
+                connect_string, driver, ip_type=IPTypes.PRIVATE, **driver_kwargs
+            )
+            assert result is expected
+            # The selected private IP reaches the network layer, either as the
+            # dialed address or as an argument handed to the driver.
+            observed = repr(mock_create_connection.call_args) + repr(
+                mock_driver.call_args
+            )
+            assert "5.6.7.8" in observed
+            # The instance SSL context is used, either to wrap the socket or
+            # passed straight to the driver.
+            driver_call = mock_driver.call_args
+            driver_args = [*driver_call.args, *driver_call.kwargs.values()]
+            assert ctx.wrap_socket.called or any(a is ctx for a in driver_args)
+    default_connector._instances = {}
+
