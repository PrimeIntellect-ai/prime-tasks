+func TestDependabotAlertState_GetDismissedComment(tt *testing.T) {
+	comment := "some comment"
+	d := &DependabotAlertState{DismissedComment: &comment}
+	if got := d.GetDismissedComment(); got != comment {
+		tt.Errorf("GetDismissedComment() = %q, want %q", got, comment)
+	}
+	d = &DependabotAlertState{}
+	if got := d.GetDismissedComment(); got != "" {
+		tt.Errorf("GetDismissedComment() = %q, want empty string", got)
+	}
+	d = nil
+	if got := d.GetDismissedComment(); got != "" {
+		tt.Errorf("GetDismissedComment() = %q, want empty string", got)
+	}
+}
