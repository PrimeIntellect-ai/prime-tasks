+    def test_clone_cant_mutate_original(self) -> None:
+        collection = TestCases.test_case_8()
+        collection.extra_fields["nested"] = {"values": ["original"]}
+        assert collection.keywords is not None
+        self.assertListEqual(collection.keywords, ["disaster", "open"])
+        collection.summaries.add("custom", ["original"])
+        clone = collection.clone()
+
+        clone.extra_fields["nested"]["values"].append("clone")
+        self.assertEqual(collection.extra_fields["nested"]["values"], ["original"])
+        clone.keywords.append("clone")
+        self.assertListEqual(collection.keywords, ["disaster", "open"])
+
+        assert clone.providers is not None
+        assert clone.providers[0].roles is not None
+        clone.providers[0].roles.append("host")
+        assert collection.providers is not None
+        assert collection.providers[0].roles is not None
+        self.assertNotIn("host", collection.providers[0].roles)
+
+        clone.summaries.lists["custom"].append("clone")
+        self.assertEqual(collection.summaries.lists["custom"], ["original"])
+
+        assert clone.stac_extensions is not None
+        clone.stac_extensions.append("https://example.com/schema.json")
+        assert collection.stac_extensions is not None
+        self.assertNotIn(
+            "https://example.com/schema.json", collection.stac_extensions
+        )
+
+        original_bbox_count = len(collection.extent.spatial.bboxes)
+        clone.extent.spatial.bboxes.append([1, 2, 3, 4])
+        self.assertEqual(len(collection.extent.spatial.bboxes), original_bbox_count)
+
