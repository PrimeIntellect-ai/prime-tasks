+    @testset "learning-rate adjustment" begin
+      # Change the rate on a stateful rule other than Momentum or Adam. Compare
+      # against a run using the new rate from the start, with the same history.
+      x = Float32[4, 3, 2]
+      g1 = Float32[1, 10, 100]
+      g2 = Float32[2, 3, 4]
+      old = Optimisers.setup(RMSProp(0.1), x)
+      old, x1 = Optimisers.update(old, x, g1)
+
+      changed = Optimisers.adjust(old, 0.2)
+      changed, x2 = Optimisers.update(changed, x1, g2)
+
+      reference = Optimisers.setup(RMSProp(0.2), x)
+      reference, _ = Optimisers.update(reference, x, g1)
+      _, x2_reference = Optimisers.update(reference, x1, g2)
+
+      @test x2 ≈ x2_reference
+    end
