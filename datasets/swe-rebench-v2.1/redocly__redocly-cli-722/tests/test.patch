@@ -0,0 +1,53 @@
+import { spawnSync } from 'child_process';
+import { existsSync, readFileSync, unlinkSync } from 'fs';
+import { join } from 'path';
+import { parseYaml } from '../../../../core/src/utils';
+
+describe('join tag option combinations', () => {
+  const fixture = join(__dirname, '../../../../../__tests__/join/without-x-tag-groups');
+  const tsNode = join(__dirname, '../../../../../node_modules/.bin/ts-node');
+  const cli = join(__dirname, '../../index.ts');
+  const combinations = [
+    ['--prefix-tags-with-filename', '--prefix-tags-with-info-prop=title'],
+    ['--prefix-tags-with-filename', '--without-x-tag-groups'],
+    ['--prefix-tags-with-info-prop=title', '--without-x-tag-groups'],
+    ['--prefix-tags-with-filename', '--prefix-tags-with-info-prop=title', '--without-x-tag-groups'],
+  ];
+
+  it('writes a merged document without tag groups and keeps the first tag description', () => {
+    const output = join(fixture, 'openapi.yaml');
+    if (existsSync(output)) unlinkSync(output);
+
+    try {
+      const result = spawnSync(
+        tsNode,
+        ['--transpile-only', cli, 'join', 'foo.yaml', 'bar.yaml', '--without-x-tag-groups'],
+        {
+          cwd: fixture,
+          env: { ...process.env, NODE_ENV: 'development', NO_COLOR: 'TRUE' },
+        },
+      );
+
+      expect(result.status).toBe(0);
+      expect(existsSync(output)).toBe(true);
+      const merged = parseYaml(readFileSync(output, 'utf8')) as any;
+      expect(merged.tags.find((tag: any) => tag.name === 'Pet').description).toBe('Pet Discription');
+      expect(merged).not.toHaveProperty('x-tagGroups');
+    } finally {
+      if (existsSync(output)) unlinkSync(output);
+    }
+  });
+
+  test.each(combinations)('rejects incompatible options: %s', (...options) => {
+    const result = spawnSync(
+      tsNode,
+      ['--transpile-only', cli, 'join', 'foo.yaml', 'bar.yaml', ...options],
+      {
+        cwd: fixture,
+        env: { ...process.env, NODE_ENV: 'test', NO_COLOR: 'TRUE' },
+      },
+    );
+
+    expect(result.status).not.toBe(0);
+  });
+});
