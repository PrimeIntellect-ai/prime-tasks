+#[test]
+fn struct_repr_callback_reports_attributes() {
+    let db = ChalkDatabase::with(
+        "
+            struct Plain {}
+            #[repr(C)] struct CLayout {}
+            #[repr(packed)] struct PackedLayout {}
+            #[repr(C)] #[repr(packed)] struct Both {}
+        ",
+        SolverChoice::default(),
+    );
+
+    db.with_program(|program| {
+        for (name, expected_c, expected_packed) in [
+            ("Plain", false, false),
+            ("CLayout", true, false),
+            ("PackedLayout", false, true),
+            ("Both", true, true),
+        ] {
+            let id = program
+                .adt_ids
+                .iter()
+                .find(|(adt_name, _)| adt_name.to_string() == name)
+                .unwrap()
+                .1;
+            let repr = db.adt_repr(*id);
+            assert_eq!(repr.repr_c, expected_c, "unexpected repr(C) for {name}");
+            assert_eq!(
+                repr.repr_packed, expected_packed,
+                "unexpected repr(packed) for {name}"
+            );
+        }
+    });
+}
