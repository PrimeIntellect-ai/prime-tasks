+def test_failed_calculation_directory_is_renamed(tmp_path):
+    class FailingCalculator(Calculator):
+        implemented_properties = ["energy"]
+
+        def calculate(self, atoms=None, properties=("energy",), system_changes=None):
+            raise ValueError("calculation failed")
+
+    atoms = bulk("Cu")
+    atoms.calc = FailingCalculator()
+    scratch_dir = tmp_path / "scratch"
+    results_dir = tmp_path / "results"
+
+    with change_settings({"SCRATCH_DIR": scratch_dir, "RESULTS_DIR": results_dir}):
+        try:
+            run_calc(atoms)
+        except Exception:
+            pass
+
+    assert list(scratch_dir.glob("failed-quacc-*"))
+
+
+@pytest.mark.parametrize("runner", [run_opt, run_vib], ids=["optimization", "vibration"])
+def test_other_calculation_failures_rename_directory(tmp_path, runner):
+    class FailingCalculator(Calculator):
+        implemented_properties = ["energy", "forces"]
+
+        def calculate(self, atoms=None, properties=("energy",), system_changes=None):
+            raise ValueError("calculation failed")
+
+    atoms = bulk("Cu")
+    atoms.calc = FailingCalculator()
+    scratch_dir = tmp_path / "scratch"
+    results_dir = tmp_path / "results"
+
+    with change_settings({"SCRATCH_DIR": scratch_dir, "RESULTS_DIR": results_dir}):
+        with pytest.raises(Exception):
+            runner(atoms)
+
+    assert len(list(scratch_dir.glob("failed-quacc-*"))) == 1
+    assert not list(scratch_dir.glob("tmp-quacc-*"))
