+    i.remove(); // remove null
+
+    expect(i.hasNext(), isTrue);
+    expect(i.next(), "Bulbasaur");
+
+    expect(i.hasNext(), isTrue);
+    expect(i.next(), "Ivysaur");
+
+    expect(i.hasNext(), isFalse);
+
+    expect(pokemon, listOf("Bulbasaur", "Ivysaur"));
