+
+func TestVersionInvocationReportsVersion(t *testing.T) {
+	if os.Getenv("TEST_VERSION_OUTPUT") == "1" {
+		os.Args = []string{os.Args[0], os.Getenv("TEST_VERSION_INVOCATION")}
+		main()
+		return
+	}
+
+	invocations := [][]string{{"--version"}, {"version"}}
+	var failures []string
+	for _, args := range invocations {
+		cmd := exec.Command(os.Args[0], "-test.run=TestVersionInvocationReportsVersion")
+		cmd.Env = append(os.Environ(), "TEST_VERSION_OUTPUT=1", "TEST_VERSION_INVOCATION="+args[0])
+		out, err := cmd.CombinedOutput()
+		if err == nil && strings.Contains(string(out), version) && !strings.Contains(string(out), "Initializing collectors and retrieving data") {
+			return
+		}
+		failures = append(failures, fmt.Sprintf("%v: error=%v output=%s", args, err, out))
+	}
+	t.Fatalf("expected at least one supported version invocation to exit successfully and report %q; attempts: %s", version, strings.Join(failures, "; "))
+}
