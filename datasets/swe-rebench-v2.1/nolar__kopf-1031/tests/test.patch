+async def test_closed_session_triggers_reauthentication(
+        fake_vault, enforced_context, settings, logger):
+    """
+    A request that finds its session closed (e.g. by a concurrent
+    re-authentication) must trigger a re-authentication and recover,
+    instead of dying with a generic "Session is closed" error.
+    """
+    # Simulate a session that was closed by a concurrent re-authentication.
+    await enforced_context.session.close()
+
+    reauthenticated = asyncio.Event()
+
+    async def reauth():
+        await fake_vault.wait_for_emptiness()
+        reauthenticated.set()
+        await fake_vault.populate({})
+
+    task = asyncio.ensure_future(reauth())
+    try:
+        with pytest.raises(LoginError):
+            await api.request('get', '/', settings=settings, logger=logger)
+    finally:
+        task.cancel()
+        try:
+            await task
+        except asyncio.CancelledError:
+            pass
+
+    assert reauthenticated.is_set()
