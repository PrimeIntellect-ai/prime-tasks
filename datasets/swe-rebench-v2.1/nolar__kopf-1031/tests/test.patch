 import datetime
 
 import freezegun
 import iso8601
 import pytest
 
+from kopf._cogs.clients import api
 from kopf._cogs.structs.credentials import ConnectionInfo, LoginError, Vault, VaultKey
 
 
+@contextlib.asynccontextmanager
+async def _reauthentication(vault, src):
+    """
+    Simulate the authentication activity for a vault.
+
+    The activity waits until the vault is empty (i.e. a re-authentication
+    is requested by an invalidation), and then provides new credentials.
+    The task is cancelled if the block exits without the re-authentication
+    having been requested (e.g. when the operation under test fails early).
+    """
+    async def reauth():
+        await vault.wait_for_emptiness()
+        await vault.populate(src)
+
+    task = asyncio.ensure_future(reauth())
+    try:
+        yield
+    finally:
+        task.cancel()
+        try:
+            await task
+        except asyncio.CancelledError:
+            pass
+
