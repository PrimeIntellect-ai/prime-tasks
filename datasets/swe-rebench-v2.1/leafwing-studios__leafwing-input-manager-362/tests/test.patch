+#[test]
+fn mouse_wheel_single_axis_inverted() {
+    let mut app = test_app();
+    app.insert_resource(InputMap::new([(
+        SingleAxis {
+            axis_type: AxisType::MouseWheel(MouseWheelAxisType::X),
+            positive_low: 0.0,
+            negative_low: 0.0,
+            inverted: true,
+            value: None,
+        },
+        AxislikeTestAction::X,
+    )]));
+
+    // A positive raw mouse wheel movement should produce a negative action value when inverted.
+    let input = SingleAxis {
+        axis_type: AxisType::MouseWheel(MouseWheelAxisType::X),
+        value: Some(1.),
+        positive_low: 0.0,
+        negative_low: 0.0,
+        inverted: false,
+    };
+    app.send_input(input);
+    app.update();
+    let action_state = app.world.resource::<ActionState<AxislikeTestAction>>();
+    assert_eq!(action_state.value(AxislikeTestAction::X), -1.0);
+
+    // A negative raw mouse wheel movement should produce a positive action value when inverted.
+    let input = SingleAxis {
+        axis_type: AxisType::MouseWheel(MouseWheelAxisType::X),
+        value: Some(-1.),
+        positive_low: 0.0,
+        negative_low: 0.0,
+        inverted: false,
+    };
+    app.send_input(input);
+    app.update();
+    let action_state = app.world.resource::<ActionState<AxislikeTestAction>>();
+    assert_eq!(action_state.value(AxislikeTestAction::X), 1.0);
+}
