+func TestIntegerRangeIteration(t *testing.T) {
+	for _, bounds := range [][2]int{{3, 7}, {-4, 1}, {10, 13}, {17, 29}, {-23, -11}} {
+		from, to := bounds[0], bounds[1]
+		name := fmt.Sprintf("integer_range_%d_%d", from, to)
+		content := fmt.Sprintf(`{{ range i := ints(%d, %d) }}{{ i }}|{{ end }}`, from, to)
+		template, err := JetTestingSet.LoadTemplate(name, content)
+		if err != nil {
+			t.Fatalf("could not parse range template for bounds %v: %v", bounds, err)
+		}
+		var output bytes.Buffer
+		if err := template.Execute(&output, nil, nil); err != nil {
+			t.Fatalf("could not render range for bounds %v: %v", bounds, err)
+		}
+
+		parts := strings.Split(strings.TrimSuffix(output.String(), "|"), "|")
+		if len(parts) != to-from && len(parts) != to-from+1 {
+			t.Fatalf("range %v yielded %d values (%q); expected contiguous iteration with either endpoint convention", bounds, len(parts), output.String())
+		}
+		for i, part := range parts {
+			var value int
+			if _, err := fmt.Sscanf(part, "%d", &value); err != nil {
+				t.Fatalf("range %v yielded non-integer value %q: %v", bounds, part, err)
+			}
+			if value != from+i {
+				t.Fatalf("range %v yielded %q at position %d; values should be contiguous from the requested start", bounds, part, i)
+			}
+		}
+	}
+}
