+type rangeHeapObserver struct {
+	writes   int
+	baseline uint64
+	peak     uint64
+}
+
+func (w *rangeHeapObserver) Write(p []byte) (int, error) {
+	w.writes++
+	if w.writes%8192 == 0 {
+		runtime.GC()
+		var stats runtime.MemStats
+		runtime.ReadMemStats(&stats)
+		if stats.HeapAlloc > w.baseline && stats.HeapAlloc-w.baseline > w.peak {
+			w.peak = stats.HeapAlloc - w.baseline
+		}
+	}
+	return len(p), nil
+}
+
+func TestIntegerRangeDoesNotMaterializeRangeSizedStorage(t *testing.T) {
+	measurePeak := func(name string, count int) uint64 {
+		content := fmt.Sprintf(`{{ range i := ints(0, %d) }}{{ i }}{{ end }}`, count)
+		template, err := JetTestingSet.LoadTemplate(name, content)
+		if err != nil {
+			t.Fatal(err)
+		}
+		runtime.GC()
+		var baseline runtime.MemStats
+		runtime.ReadMemStats(&baseline)
+		observer := &rangeHeapObserver{baseline: baseline.HeapAlloc}
+		if err := template.Execute(observer, nil, nil); err != nil {
+			t.Fatal(err)
+		}
+		return observer.peak
+	}
+
+	smallPeak := measurePeak("small_integer_range_live_heap", 100000)
+	largePeak := measurePeak("large_integer_range_live_heap", 2000000)
+	if largePeak > smallPeak+32*1024 {
+		t.Fatalf("live heap increased from %d to %d bytes as the integer range grew; iteration should not retain range-sized storage", smallPeak, largePeak)
+	}
+}
