+def _assert_respects_coupling_map(tape, coupling_map):
+    """Assert that every two-qubit operation in ``tape`` acts on a connected pair of wires."""
+    edges = set()
+    for w0, w1 in coupling_map:
+        edges.add((w0, w1))
+        edges.add((w1, w0))
+    for op in tape.operations:
+        if len(op.wires) == 2:
+            assert tuple(op.wires) in edges, (
+                f"Operation {op} acts on wires {op.wires}, which are not connected in "
+                f"the coupling map {coupling_map}."
+            )
+
+
 class TestTranspile:
     """Unit tests for transpile function"""
 
