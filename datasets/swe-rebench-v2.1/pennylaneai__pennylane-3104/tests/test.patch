+    def test_transpile_ops_anywires(self):
+        """test that transpile does not alter output for expectation value of an observable if the qfunc contains
+        operations that act on any number of wires"""
+        dev = qml.device("default.qubit", wires=[0, 1, 2])
+
+        def circuit(param):
+            qml.RX(0.1, wires=0)
+            qml.RY(0.2, wires=1)
+            qml.MultiRZ(param, wires=[0, 1])
+            qml.PhaseShift(param, wires=2)
+            qml.MultiRZ(param, wires=[0, 2])
+            return qml.probs(wires=[0, 1, 2])
+
+        param = 0.3
+
+        # build circuit without transpile
+        original_qnode = qml.QNode(circuit, dev)
+        original_expectation = original_qnode(param)
+
+        # build circuit with transpile
+        transpiled_qfunc = transpile(coupling_map=[(0, 1), (1, 2)])(circuit)
+        transpiled_qnode = qml.QNode(transpiled_qfunc, dev)
+        transpiled_expectation = transpiled_qnode(param)
+
+        # the transpiled circuit must only use gates acting on connected wires
+        _assert_respects_coupling_map(transpiled_qnode.qtape, [(0, 1), (1, 2)])
+
+        # SWAP gates must be inserted to route the non-adjacent MultiRZ
+        assert any(isinstance(op, qml.SWAP) for op in transpiled_qnode.qtape.operations)
+
+        # transpilation must preserve the circuit's behaviour
+        assert qml.math.allclose(
+            original_expectation, transpiled_expectation, atol=np.finfo(float).eps
+        )
+
+    def test_transpile_ops_anywires_1_qubit(self):
+        """test that transpile does not alter output for expectation value of an observable if the qfunc contains
+        1-qubit operations with AnyWires defined for the operation"""
+        dev = qml.device("default.qubit", wires=[0, 1, 2])
+
+        def circuit(param):
+            qml.RX(0.1, wires=0)
+            qml.RY(0.2, wires=1)
+            qml.MultiRZ(param, wires=[0])
+            qml.PhaseShift(param, wires=2)
+            qml.MultiRZ(param, wires=[0, 2])
+            return qml.probs(wires=[0, 1, 2])
+
+        param = 0.3
+
+        # build circuit without transpile
+        original_qnode = qml.QNode(circuit, dev)
+        original_expectation = original_qnode(param)
+
+        # build circuit with transpile
+        transpiled_qfunc = transpile(coupling_map=[(0, 1), (1, 2)])(circuit)
+        transpiled_qnode = qml.QNode(transpiled_qfunc, dev)
+        transpiled_expectation = transpiled_qnode(param)
+
+        # the transpiled circuit must only use gates acting on connected wires
+        _assert_respects_coupling_map(transpiled_qnode.qtape, [(0, 1), (1, 2)])
+
+        # SWAP gates must be inserted to route the non-adjacent MultiRZ
+        assert any(isinstance(op, qml.SWAP) for op in transpiled_qnode.qtape.operations)
+
+        # transpilation must preserve the circuit's behaviour
+        assert qml.math.allclose(
+            original_expectation, transpiled_expectation, atol=np.finfo(float).eps
+        )
+
+    def test_transpile_accepts_networkx_graph(self):
+        """test that transpile accepts a networkx graph as the coupling map"""
+        import networkx as nx
+
+        dev = qml.device("default.qubit", wires=[0, 1, 2])
+
+        def circuit(param):
+            qml.RX(0.1, wires=0)
+            qml.MultiRZ(param, wires=[0, 2])
+            return qml.probs(wires=[0, 1, 2])
+
+        param = 0.3
+        original_expectation = qml.QNode(circuit, dev)(param)
+
+        graph = nx.Graph([(0, 1), (1, 2)])
+        transpiled_qfunc = transpile(coupling_map=graph)(circuit)
+        transpiled_qnode = qml.QNode(transpiled_qfunc, dev)
+        transpiled_expectation = transpiled_qnode(param)
+
+        _assert_respects_coupling_map(transpiled_qnode.qtape, [(0, 1), (1, 2)])
+        assert qml.math.allclose(
+            original_expectation, transpiled_expectation, atol=np.finfo(float).eps
+        )
+
+    def test_transpile_accepts_quantum_tape(self):
+        """test that transpile accepts a QuantumTape and returns a transpiled tape"""
+        param = 0.3
+
+        with qml.tape.QuantumTape() as tape:
+            qml.RX(0.1, wires=0)
+            qml.MultiRZ(param, wires=[0, 2])
+            qml.probs(wires=[0, 1, 2])
+
+        transpiled_tape = transpile(coupling_map=[(0, 1), (1, 2)])(tape)
+
+        assert isinstance(transpiled_tape, qml.tape.QuantumTape)
+        _assert_respects_coupling_map(transpiled_tape, [(0, 1), (1, 2)])
