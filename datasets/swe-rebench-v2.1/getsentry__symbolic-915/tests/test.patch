+#[test]
+fn test_wasm_symbol_table_functions_are_preserved() -> Result<(), Error> {
+    // Three tiny functions with names in the standard WASM name section.
+    let wasm = [
+        b'\0', b'a', b's', b'm', 1, 0, 0, 0, // Header
+        1, 4, 1, 0x60, 0, 0, // One function type: () -> ()
+        3, 4, 3, 0, 0, 0, // Three local functions
+        10, 10, 3, 2, 0, 0x0b, 2, 0, 0x0b, 2, 0, 0x0b, // Three bodies
+        0, 28, 4, b'n', b'a', b'm', b'e', 1, 21, 3, // Name section, function subsection
+        0, 5, b'a', b'l', b'p', b'h', b'a',
+        1, 4, b'b', b'e', b't', b'a',
+        2, 5, b'g', b'a', b'm', b'm', b'a',
+    ];
+    let object = Object::parse(&wasm)?;
+    let expected_symbols = object.symbols().collect::<Vec<_>>();
+    assert_eq!(expected_symbols.len(), 3);
+
+    let mut serialized = Vec::new();
+    let mut converter = SymCacheConverter::new();
+    converter.process_object(&object)?;
+    converter.serialize(&mut Cursor::new(&mut serialized))?;
+    let symcache = SymCache::parse(&serialized)?;
+
+    for (symbol, expected_name) in expected_symbols.iter().zip(["alpha", "beta", "gamma"]) {
+        let locations = symcache.lookup(symbol.address).collect::<Vec<_>>();
+        assert_eq!(locations.len(), 1);
+        assert_eq!(locations[0].function().name(), expected_name);
+        assert_eq!(locations[0].function().entry_pc(), symbol.address as u32);
+    }
+
+    Ok(())
 }
