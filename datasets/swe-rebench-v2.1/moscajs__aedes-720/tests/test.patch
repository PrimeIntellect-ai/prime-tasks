+test('subscriber will not receive retained messages when QoS is 128', function (t) {
+  t.plan(7)
+
+  const broker = aedes()
+  t.teardown(broker.close.bind(broker))
+
+  const pubPacket = {
+    cmd: 'publish',
+    topic: 'hello',
+    payload: 'world',
+    qos: 1,
+    retain: true,
+    messageId: 42
+  }
+
+  let denyNextSubscription = true
+  broker.authorizeSubscribe = function (client, sub, callback) {
+    if (denyNextSubscription) {
+      denyNextSubscription = false
+      callback(null, null)
+    } else {
+      callback(null, sub)
+    }
+  }
+
+  const publisher = connect(setup(broker), { clean: true })
+  function afterPublish (packet) {
+    if (packet.cmd !== 'puback') {
+      return publisher.outStream.once('data', afterPublish)
+    }
+
+    const subscriber = connect(setup(broker), { clean: true })
+    subscriber.outStream.on('data', function (packet) {
+      if (packet.cmd === 'publish') {
+        t.fail('denied subscription must not receive retained messages')
+      }
+    })
+    subscriber.outStream.once('data', function (packet) {
+      t.equal(packet.cmd, 'suback')
+      t.same(packet.granted, [128])
+      t.equal(packet.messageId, 24)
+
+      const permittedSubscriber = connect(setup(broker), { clean: true })
+      permittedSubscriber.outStream.on('data', function (packet) {
+        if (packet.cmd === 'publish') {
+          t.ok(packet.retain && packet.topic === pubPacket.topic && packet.payload.toString() === 'world', 'retained message remains available to a permitted subscriber')
+        }
+      })
+      subscribe(t, permittedSubscriber, pubPacket.topic, 1)
+    })
+    subscriber.inStream.write({
+      cmd: 'subscribe',
+      messageId: 24,
+      subscriptions: [{
+        topic: pubPacket.topic,
+        qos: 1
+      }]
+    })
+  }
+  publisher.outStream.once('data', afterPublish)
+  publisher.inStream.write(pubPacket)
+})
+
 // [MQTT-3.3.1-6]
