+test('subscribe event reports granted QoS for permitted and denied subscriptions', function (t) {
+  t.plan(4)
+
+  const s = connect(setup())
+  t.teardown(s.broker.close.bind(s.broker))
+
+  s.broker.authorizeSubscribe = function (client, sub, cb) {
+    cb(null, sub.topic === 'denied' ? null : sub)
+  }
+
+  s.broker.once('subscribe', function (subs) {
+    const actualSubs = subs.map(sub => [sub.topic, sub.qos]).sort((a, b) => a[0].localeCompare(b[0]))
+    t.same(actualSubs, [['allowed', 1], ['denied', 128]])
+  })
+
+  s.outStream.once('data', function (packet) {
+    t.equal(packet.cmd, 'suback')
+    t.same(packet.granted, [128, 1])
+    t.equal(packet.messageId, 25)
+  })
+
+  s.inStream.write({
+    cmd: 'subscribe',
+    messageId: 25,
+    subscriptions: [{
+      topic: 'denied',
+      qos: 2
+    }, {
+      topic: 'allowed',
+      qos: 1
+    }]
+  })
+})
+
