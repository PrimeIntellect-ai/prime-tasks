+
+def test_class_var() -> None:
+    from serde.se import serialize, to_dict
+
+    @serialize
+    class Default:
+        value: ClassVar[str] = "abc"
+
+    assert to_dict(Default()) == {}
+
+    @serialize(serialize_class_var=True)
+    class EnabledSerialize:
+        value: ClassVar[str] = "enabled"
+
+    assert to_dict(EnabledSerialize()) == {"value": "enabled"}
+
+    @serde.serde(serialize_class_var=True)
+    @dataclasses.dataclass
+    class Enabled:
+        v: ClassVar[int] = 10
+
+    b = Enabled()
+    assert {"v": 10} == serde.to_dict(b)
+
+    @serde.serde
+    @dataclasses.dataclass
+    class Foo:
+        v: int
+
+    @serde.serde(serialize_class_var=True)
+    @dataclasses.dataclass
+    class Dataclass:
+        v: ClassVar[Foo] = Foo(10)
+
+    c = Dataclass()
+    assert {"v": {"v": 10}} == serde.to_dict(c)
+
+    @serde.serde(serialize_class_var=True)
+    @dataclasses.dataclass
+    class ClassList:
+        v: ClassVar[List[Foo]] = [Foo(10), Foo(20)]
+
+    d = ClassList()
+    assert {"v": [{"v": 10}, {"v": 20}]} == serde.to_dict(d)
+
+    @serde.serde(serialize_class_var=True)
+    @dataclasses.dataclass
+    class Bar:
+        v: ClassVar[int] = 100
+
+    @serde.serde(serialize_class_var=True)
+    @dataclasses.dataclass
+    class Nested:
+        v: ClassVar[Bar] = Bar()
+
+    f = Nested()
+    assert {"v": {"v": 100}} == serde.to_dict(f)
