+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from cfnlint import ConfigMixIn
+from cfnlint.rules import Rules
+from cfnlint.runner import TemplateRunner
+
+
+def _validate_service(properties):
+    template = {
+        "Resources": {
+            "Service": {
+                "Type": "AWS::ECS::Service",
+                "Properties": properties,
+            }
+        }
+    }
+    runner = TemplateRunner(
+        filename=None,
+        template=template,
+        config=ConfigMixIn(include_experimental=True),
+        rules=Rules.create_from_directory("src/cfnlint/rules"),
+    )
+    return list(runner.run())
+
+
+def _reports_validation_error(failures):
+    return bool(failures)
+
+
+def test_template_validation_reports_missing_load_balancer():
+    failures = _validate_service({"HealthCheckGracePeriodSeconds": 30})
+
+    assert _reports_validation_error(failures)
+
+
+def test_template_validation_reports_empty_load_balancer_list():
+    failures = _validate_service(
+        {"HealthCheckGracePeriodSeconds": 30, "LoadBalancers": []}
+    )
+
+    assert _reports_validation_error(failures)
+
+
+def test_template_validation_accepts_configured_load_balancer():
+    failures = _validate_service(
+        {
+            "HealthCheckGracePeriodSeconds": 30,
+            "LoadBalancers": [
+                {"ContainerName": "app", "ContainerPort": 80}
+            ],
+        }
+    )
+
+    assert not _reports_validation_error(failures)
