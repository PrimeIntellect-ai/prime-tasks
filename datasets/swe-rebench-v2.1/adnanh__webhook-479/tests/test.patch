+func TestArgumentGetRequestErrors(t *testing.T) {
+	// A nil request must produce an error rather than a value.
+	if _, err := (&Argument{Source: "request", Name: "remote-addr"}).Get(nil); err == nil {
+		t.Errorf("expected an error for a nil request")
+	}
+
+	// A request source with a missing RawRequest must produce an error.
+	if _, err := (&Argument{Source: "request", Name: "remote-addr"}).Get(&Request{}); err == nil {
+		t.Errorf("expected an error when RawRequest is missing")
+	}
+
+	// An unsupported request key must produce an error.
+	r := &Request{RawRequest: &http.Request{Method: "POST", RemoteAddr: "127.0.0.1:1234"}}
+	if _, err := (&Argument{Source: "request", Name: "unsupported"}).Get(r); err == nil {
+		t.Errorf("expected an error for an unsupported request key")
+	}
+}
