+def test_config_field(app, client):
+    from apiflask.fields import Config
+
+    app.config['API_TITLE'] = 'Pet API'
+
+    class GoodSchema(Schema):
+        title = Config('API_TITLE')
+
+    class BadSchema(Schema):
+        description = Config('API_DESCRIPTION')
+
+    @app.get('/good')
+    @app.output(GoodSchema)
+    def good():
+        return {}
+
+    rv = client.get('/openapi.json')
+    assert rv.status_code == 200
+
+    rv = client.get('/good')
+    assert rv.status_code == 200
+    assert rv.json == {'title': 'Pet API'}
+
+    with pytest.raises(ValueError, match=r'The key.*is not found in the app config.'):
+        with app.app_context():
+            bad = BadSchema()
+            bad.dump({})
+
+
+
+def test_config_field_ignores_conflicting_mapping_value(app):
+    from apiflask.fields import Config
+
+    app.config['API_TITLE'] = 'Pet API'
+
+    class ConfigSchema(Schema):
+        title = Config('API_TITLE')
+
+    with app.app_context():
+        assert ConfigSchema().dump({'title': 'Raw title'}) == {'title': 'Pet API'}
+
+
+def test_config_field_ignores_conflicting_object_attribute(app):
+    from apiflask.fields import Config
+
+    app.config['API_TITLE'] = 'Pet API'
+
+    class ConfigSchema(Schema):
+        title = Config('API_TITLE')
+
+    with app.app_context():
+        assert ConfigSchema().dump(SimpleNamespace(title='Object title')) == {'title': 'Pet API'}
+
+
+def test_config_field_accepts_extra_kwargs(app, client):
+    from apiflask.fields import Config
+
+    app.config['API_TITLE'] = 'Pet API'
+
+    class KwSchema(Schema):
+        title = Config('API_TITLE', metadata={'description': 'The API title.'})
+
+    @app.get('/kw')
+    @app.output(KwSchema)
+    def kw():
+        return {}
+
+    rv = client.get('/kw')
+    assert rv.status_code == 200
+    assert rv.json == {'title': 'Pet API'}
