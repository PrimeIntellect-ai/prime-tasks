+
+    @testset "BitArray indexing preserves or drops names appropriately" begin
+        nda = NamedDimsArray(reshape(1:24, 2,3,4), (:x, :y, :z))
+        ndv = NamedDimsArray(collect(1:4), :x)
+
+        # A one-dimensional mask indexes one original dimension; its name
+        # remains alongside dimensions not removed by scalar indices.
+        mask1 = BitVector([true, false])
+        @test dimnames(nda[mask1, 1, :]) == (:x, :z)
+        @test dimnames(ndv[BitVector([true, false, true, false])]) == (:x,)
+
+        # A multidimensional mask used as the sole index flattens the result,
+        # which must not retain the names of the source dimensions.
+        mask3 = falses(2,3,4)
+        mask3[1,2,3] = true
+        result = nda[mask3]
+        @test result isa AbstractVector
+        @test !(result isa NamedDimsArray)
+    end
 end
 
 
