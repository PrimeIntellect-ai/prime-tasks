+package org.sonar.javascript.checks;
+
+import java.io.File;
+import java.util.List;
+import org.junit.Test;
+import org.sonar.check.Rule;
+import org.sonar.plugins.javascript.api.JavaScriptCheck;
+import org.sonar.javascript.checks.verifier.JavaScriptCheckVerifier;
+
+public class ErrorWithoutThrowCheckTest {
+
+  @Test
+  public void test() throws Exception {
+    List<Class> checks = CheckList.getChecks();
+    Class<?> ruleClass = checks.stream()
+      .filter(check -> {
+        Rule rule = (Rule) check.getAnnotation(Rule.class);
+        return rule != null && "S3984".equals(rule.key());
+      })
+      .findFirst()
+      .get();
+
+    JavaScriptCheckVerifier.verify(
+      (JavaScriptCheck) ruleClass.newInstance(),
+      new File("src/test/resources/checks/ErrorWithoutThrow.js"));
+  }
+}
