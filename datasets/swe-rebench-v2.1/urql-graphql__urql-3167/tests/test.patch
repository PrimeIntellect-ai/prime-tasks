+import {
+  createClient,
+  ExchangeIO,
+  Operation,
+  OperationResult,
+  gql,
+} from '@urql/core';
+import { describe, it, expect, vi } from 'vitest';
+import { pipe, map, makeSubject, publish, share } from 'wonka';
+
+import { cacheExchange } from '../cacheExchange';
+import { queryResponse } from '../../../../packages/core/src/test-utils';
+
+describe('deferred cache reads', () => {
+  it('forwards a later query when its data is missing from the cache', () => {
+    const client = createClient({ url: 'http://example.test', exchanges: [] });
+    const { source: operations$, next } = makeSubject<Operation>();
+    const forwarded = vi.fn((operation: Operation): OperationResult => ({
+      ...queryResponse,
+      operation,
+      data: { __typename: 'Query', ready: true },
+    }));
+    const forward: ExchangeIO = operations$ =>
+      pipe(operations$, map(forwarded), share);
+
+    pipe(
+      cacheExchange({})({
+        forward,
+        client,
+        dispatchDebug: vi.fn(),
+      })(operations$),
+      publish
+    );
+
+    const deferredQuery = client.createRequestOperation('query', {
+      key: 1,
+      query: gql`
+        {
+          ready
+          ... @defer {
+            later
+          }
+        }
+      `,
+      variables: undefined,
+    });
+    next(deferredQuery);
+
+    const missingQuery = client.createRequestOperation('query', {
+      key: 2,
+      query: gql`
+        {
+          missing
+        }
+      `,
+      variables: undefined,
+    });
+    next(missingQuery);
+
+    expect(forwarded.mock.calls.map(([operation]) => operation.key)).toContain(
+      missingQuery.key
+    );
+  });
+
+  it('forwards a later query when data is missing after a chunked result', () => {
+    const client = createClient({ url: 'http://example.test', exchanges: [] });
+    const { source: operations$, next } = makeSubject<Operation>();
+    const chunkedQueryKey = 3;
+    const forwarded = vi.fn((operation: Operation): OperationResult => ({
+      ...queryResponse,
+      operation,
+      data: { __typename: 'Query', ready: true },
+      hasNext: operation.key === chunkedQueryKey,
+    }));
+    const forward: ExchangeIO = operations$ =>
+      pipe(operations$, map(forwarded), share);
+
+    pipe(
+      cacheExchange({})({
+        forward,
+        client,
+        dispatchDebug: vi.fn(),
+      })(operations$),
+      publish
+    );
+
+    const chunkedQuery = client.createRequestOperation('query', {
+      key: chunkedQueryKey,
+      query: gql`
+        {
+          ready
+        }
+      `,
+      variables: undefined,
+    });
+    next(chunkedQuery);
+
+    const missingQuery = client.createRequestOperation('query', {
+      key: 4,
+      query: gql`
+        {
+          missing
+        }
+      `,
+      variables: undefined,
+    });
+    next(missingQuery);
+
+    expect(forwarded.mock.calls.map(([operation]) => operation.key)).toContain(
+      missingQuery.key
+    );
+  });
+});
