+// On Windows, an EXCEPTION_ACCESS_VIOLATION records the faulting address in
+// the exception information rather than in the exception address field, and
+// on 32-bit CPUs that address must be truncated to 32 bits.
+#[test]
+fn test_crash_address_windows_access_violation() {
+    let context = synth_minidump::x86_context(Endian::Little, 0xf00800, 0x1010);
+    let stack = Memory::with_section(
+        Section::with_endian(Endian::Little).append_repeated(0, 0x1000),
+        0x1000,
+    );
+    let thread = Thread::new(Endian::Little, 0x1234, &stack, &context);
+
+    // A MINIDUMP_SYSTEM_INFO describing a 32-bit Windows process.
+    let system_info_section = Section::with_endian(Endian::Little)
+        .D16(0) // processor_architecture: x86
+        .D16(0) // processor_level
+        .D16(0) // processor_revision
+        .D8(0) // number_of_processors
+        .D8(0) // product_type
+        .D32(0) // major_version
+        .D32(0) // minor_version
+        .D32(0) // build_number
+        .D32(3) // platform_id: VER_PLATFORM_WIN32_NT
+        .D32(0) // csd_version_rva
+        .D16(0) // suite_mask
+        .D16(0) // reserved2
+        .D32(0) // x86 cpu info: vendor_id[0]
+        .D32(0) // vendor_id[1]
+        .D32(0) // vendor_id[2]
+        .D32(0) // version_information
+        .D32(0) // feature_information
+        .D32(0); // amd_extended_cpu_features
+
+    // A MINIDUMP_EXCEPTION_STREAM describing an access violation whose
+    // faulting address is sign-extended in exception_information[1].
+    let exception_section = Section::with_endian(Endian::Little)
+        .D32(0x1234) // thread_id
+        .D32(0) // __alignment
+        .D32(0xc0000005) // exception_code: EXCEPTION_ACCESS_VIOLATION
+        .D32(0) // exception_flags
+        .D64(0) // exception_record
+        .D64(0xffff_ffff_dead_beef) // exception_address (not the faulting address)
+        .D32(2) // number_parameters
+        .D32(0) // __align
+        .D64(0) // exception_information[0]: read
+        .D64(0xffff_ffff_e5e5_e5e5) // exception_information[1]: faulting address
+        .append_repeated(0, 13 * 8) // remaining exception_information
+        .D32(0) // thread_context data_size
+        .D32(0); // thread_context rva
+
+    let dump = SynthMinidump::with_endian(Endian::Little)
+        .add_thread(thread)
+        .add(context)
+        .add_memory(stack)
+        .add_stream(SimpleStream {
+            // MINIDUMP_STREAM_TYPE::SystemInfoStream
+            stream_type: 7,
+            section: system_info_section,
+        })
+        .add_stream(SimpleStream {
+            // MINIDUMP_STREAM_TYPE::ExceptionStream
+            stream_type: 6,
+            section: exception_section,
+        })
+        .finish()
+        .unwrap();
+
+    let synth_path = test_output("windows-access-violation.dmp");
+    {
+        let mut file = File::create(&synth_path).unwrap();
+        file.write_all(&dump).unwrap();
+    }
+
+    let bin = env!("CARGO_BIN_EXE_minidump-stackwalk");
+    let output = Command::new(bin)
+        .arg("--json")
+        .arg(&synth_path)
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .output()
+        .unwrap();
+
+    let stdout = String::from_utf8(output.stdout).unwrap();
+    let stderr = String::from_utf8(output.stderr).unwrap();
+
+    assert!(output.status.success(), "stderr: {}", stderr);
+    assert!(
+        stdout.contains("\"address\":\"0xe5e5e5e5\""),
+        "unexpected crash address in output: {}",
+        stdout
+    );
+}
