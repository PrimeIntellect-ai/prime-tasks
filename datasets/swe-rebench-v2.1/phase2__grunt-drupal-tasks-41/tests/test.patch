@@ -0,0 +1,103 @@
+var assert = require('assert');
+var os = require('os');
+
+describe('Utility Functions', function() {
+  describe('provides a capability to adapt the basepath via configuration', function() {
+    var originalDomain;
+
+    before(function() {
+      originalDomain = process.env.GDT_DOMAIN;
+      delete process.env.GDT_DOMAIN;
+    });
+
+    after(function() {
+      if (originalDomain === undefined) {
+        delete process.env.GDT_DOMAIN;
+      }
+      else {
+        process.env.GDT_DOMAIN = originalDomain;
+      }
+    });
+
+    function makeGrunt(initialConfig) {
+      var store = initialConfig || {};
+      function get(key) {
+        return key.split('.').reduce(function(obj, part) {
+          return (obj === undefined || obj === null) ? undefined : obj[part];
+        }, store);
+      }
+      function set(key, value) {
+        var parts = key.split('.');
+        var last = parts.pop();
+        var target = parts.reduce(function(obj, part) {
+          if (obj[part] === undefined || obj[part] === null) {
+            obj[part] = {};
+          }
+          return obj[part];
+        }, store);
+        target[last] = value;
+        return value;
+      }
+      var config = function(key, value) {
+        if (arguments.length === 1) {
+          return get(key);
+        }
+        return set(key, value);
+      };
+      config.get = get;
+      config.set = set;
+      return { config: config };
+    }
+
+    it('uses the configured domain as the basepath', function() {
+      var init = require('../lib/init');
+      var grunt = makeGrunt({ config: { domain: 'configured.example.com' } });
+      var GDT = init(grunt);
+      assert.equal(GDT.domain(), 'configured.example.com');
+    });
+
+    it('uses the operating system hostname when no domain is configured', function() {
+      var init = require('../lib/init');
+      var grunt = makeGrunt();
+      var GDT = init(grunt);
+      assert.equal(GDT.domain(), os.hostname());
+      GDT.init();
+      assert.equal(grunt.config('config.domain'), os.hostname());
+    });
+
+    it('allows the basepath to be swapped with the GDT_DOMAIN environment variable', function() {
+      var init = require('../lib/init');
+      var grunt = makeGrunt({ config: { domain: 'configured.example.com' } });
+      process.env.GDT_DOMAIN = 'env.example.com';
+      try {
+        var GDT = init(grunt);
+        assert.equal(GDT.domain(), 'env.example.com');
+      }
+      finally {
+        delete process.env.GDT_DOMAIN;
+      }
+    });
+
+    it('applies the effective domain to the project configuration', function() {
+      var init = require('../lib/init');
+      var grunt = makeGrunt({ config: { domain: 'configured.example.com' } });
+      var GDT = init(grunt);
+      GDT.init();
+      assert.equal(grunt.config('config.domain'), 'configured.example.com');
+    });
+
+    it('publishes the environment-selected domain to the project configuration', function() {
+      var init = require('../lib/init');
+      var grunt = makeGrunt({ config: { domain: 'configured.example.com' } });
+      process.env.GDT_DOMAIN = 'env.example.com';
+      try {
+        var GDT = init(grunt);
+        GDT.init();
+        assert.equal(grunt.config('config.domain'), 'env.example.com');
+      }
+      finally {
+        delete process.env.GDT_DOMAIN;
+      }
+    });
+  });
+});
