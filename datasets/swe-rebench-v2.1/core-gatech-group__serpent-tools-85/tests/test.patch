+class CleanupBehaviorTester(unittest.TestCase):
+    """Check that the requested non-test cleanup is visible in the package."""
+
+    @staticmethod
+    def has_main_guard(tree):
+        for node in ast.walk(tree):
+            if not isinstance(node, ast.If):
+                continue
+            test = node.test
+            if not isinstance(test, ast.Compare):
+                continue
+            operands = [test.left] + test.comparators
+            has_name = any(isinstance(value, ast.Name) and
+                           value.id == '__name__' for value in operands)
+            has_main = any(getattr(value, 'value', getattr(value, 's', None)) ==
+                           '__main__' for value in operands)
+            if has_name and has_main:
+                return True
+        return False
+
+    def test_detector_has_no_debug_main_guard_but_test_script_keeps_its_guard(
+            self):
+        root = Path(__file__).resolve().parents[1]
+        detector = ast.parse((root / 'parsers' / 'detector.py').read_text())
+        test_script = ast.parse(Path(__file__).read_text())
+
+        self.assertFalse(self.has_main_guard(detector))
+        self.assertTrue(self.has_main_guard(test_script))
+
+    def test_root_initializer_has_no_todo_list(self):
+        root = Path(__file__).resolve().parents[1]
+        initializer = root / '__init__.py'
+        with initializer.open() as source:
+            comments = [token.string for token in tokenize.generate_tokens(
+                source.readline) if token.type == tokenize.COMMENT]
+
+        self.assertFalse(any('TODO' in comment.upper()
+                             for comment in comments))
+
 if __name__ == '__main__':
     unittest.main()
