+func TestGenericTypeArgumentPackages(t *testing.T) {
+	fixtureDir := "testpackages/genericreturn"
+	otherPackageDir := filepath.Join(fixtureDir, "otherpackage")
+	if err := os.MkdirAll(otherPackageDir, 0o750); err != nil {
+		t.Fatalf("create interface package directory: %s", err)
+	}
+	created := []string{}
+	writeIfMissing := func(path string, source []byte) error {
+		if _, err := os.Stat(path); err == nil {
+			return nil
+		} else if !os.IsNotExist(err) {
+			return err
+		}
+		if err := os.WriteFile(path, source, 0o600); err != nil {
+			return err
+		}
+		created = append(created, path)
+		return nil
+	}
+	defer func() {
+		for _, path := range created {
+			_ = os.Remove(path)
+		}
+		_ = os.Remove(otherPackageDir)
+		_ = os.Remove(fixtureDir)
+	}()
+	if err := writeIfMissing(filepath.Join(otherPackageDir, "otherpackage.go"), []byte(`package otherpackage
+
+type Foo struct{}
+`)); err != nil {
+		t.Fatalf("create generic argument package: %s", err)
+	}
+	if err := writeIfMissing(filepath.Join(fixtureDir, "genericreturn.go"), []byte(`package genericreturn
+
+import "github.com/matryer/moq/pkg/moq/testpackages/genericreturn/otherpackage"
+
+type GenericBar[T any] struct { Bar T }
+
+type IFooBar interface {
+	Foobar() GenericBar[otherpackage.Foo]
+	Barfoo(bar GenericBar[otherpackage.Foo])
+}
+`)); err != nil {
+		t.Fatalf("create generic interface fixture: %s", err)
+	}
+
+	m, err := New(Config{SrcDir: fixtureDir})
+	if err != nil {
+		t.Fatalf("moq.New: %s", err)
+	}
+	var buf bytes.Buffer
+	if err := m.Mock(&buf, "IFooBar"); err != nil {
+		t.Fatalf("m.Mock: %s", err)
+	}
+	generated := buf.String()
+	for _, want := range []string{
+		`"github.com/matryer/moq/pkg/moq/testpackages/genericreturn/otherpackage"`,
+		`Foobar() GenericBar[otherpackage.Foo]`,
+		`Barfoo(bar GenericBar[otherpackage.Foo])`,
+	} {
+		if !strings.Contains(generated, want) {
+			t.Errorf("generated mock is missing %q", want)
+		}
+	}
+}
+
