+// assertGeneratedDecoderCompiles checks that a decoder emitted for a request
+// body is valid Go without constraining how it represents the decoded value.
+func assertGeneratedDecoderCompiles(t *testing.T, code string) {
+	t.Helper()
+	dir, err := ioutil.TempDir(".", "decode-compile-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	constructor := "NewMethodBodyObjectValidatePayload"
+	source := `package compilecheck
+import (
+	"io"
+	"net/http"
+	goa "goa.design/goa/v3/pkg"
+	goahttp "goa.design/goa/v3/http"
+)
+func ` + constructor + `(interface{}) interface{} { return nil }
+` + code
+	if err := ioutil.WriteFile(filepath.Join(dir, "decode.go"), []byte(source), 0600); err != nil {
+		t.Fatal(err)
+	}
+	dirAbs, err := filepath.Abs(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	root := dirAbs
+	for {
+		if _, err := os.Stat(filepath.Join(root, "go.mod")); err == nil {
+			break
+		}
+		parent := filepath.Dir(root)
+		if parent == root {
+			t.Fatal("could not find module root")
+		}
+		root = parent
+	}
+	packagePath, err := filepath.Rel(root, dirAbs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("go", "test", "-run=^$", "./"+filepath.ToSlash(packagePath))
+	cmd.Dir = root
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("generated decoder does not compile: %v\n%s", err, output)
+	}
+	assertGeneratedServerTypesCompile(t, dir, packagePath)
+}
+
+func assertGeneratedServerTypesCompile(t *testing.T, dir, packagePath string) {
+	t.Helper()
+	genpkg := "goa.design/goa/v3/" + filepath.ToSlash(packagePath) + "/gen"
+	files := ServerTypeFiles(genpkg, expr.Root)
+	if len(files) != 1 {
+		t.Fatalf("got %d server type files, want one", len(files))
+	}
+	var source bytes.Buffer
+	for _, section := range files[0].SectionTemplates {
+		if err := section.Write(&source); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// The generated server file imports these packages in addition to the
+	// transport types under test. Supply minimal package stand-ins so the
+	// compiler checks the emitted body conversion code itself.
+	serviceDir := filepath.Join(dir, "gen", "service_body_object_validate")
+	viewsDir := filepath.Join(serviceDir, "views")
+	if err := os.MkdirAll(viewsDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := ioutil.WriteFile(filepath.Join(serviceDir, "types.go"), []byte("package servicebodyobjectvalidate\ntype MethodBodyObjectValidatePayload struct { B string }\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := ioutil.WriteFile(filepath.Join(viewsDir, "types.go"), []byte("package views\ntype Placeholder struct{}\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	// Keep generated imports valid even when this minimal design does not need
+	// every helper package imported by the common server-type header.
+	source.WriteString("\nvar _ = utf8.RuneCountInString\nvar _ = goa.MergeErrors\nvar _ = servicebodyobjectvalidateviews.Placeholder{}\n")
+	serverDir := filepath.Join(dir, "server")
+	if err := os.MkdirAll(serverDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := ioutil.WriteFile(filepath.Join(serverDir, "types.go"), source.Bytes(), 0600); err != nil {
+		t.Fatal(err)
+	}
+	dirAbs, err := filepath.Abs(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	root := dirAbs
+	for {
+		if _, err := os.Stat(filepath.Join(root, "go.mod")); err == nil {
+			break
+		}
+		parent := filepath.Dir(root)
+		if parent == root {
+			t.Fatal("could not find module root")
+		}
+		root = parent
+	}
+	cmd := exec.Command("go", "test", "-run=^$", "./"+filepath.ToSlash(filepath.Join(packagePath, "server")))
+	cmd.Dir = root
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("generated server types do not compile: %v\n%s", err, output)
+	}
+}
