@@ -0,0 +1,54 @@
+expect_rendered_caption <- function(caption, expected) {
+  table_html <- as_raw_html(gt(exibble, caption = caption))
+
+  # The caption element may carry attributes, so only require the element
+  expect_true(grepl("<caption[^>]*>", table_html))
+  expect_true(grepl(expected, table_html, fixed = TRUE))
+}
+
+test_that("caption inputs are rendered in the table output", {
+  expect_rendered_caption("hello & goodbye", "hello &amp; goodbye")
+  expect_rendered_caption(
+    md("**hello & goodbye**"),
+    "<strong>hello &amp; goodbye</strong>"
+  )
+  expect_rendered_caption(I("**hello & goodbye**"), "**hello & goodbye**")
+  expect_rendered_caption(
+    htmltools::strong("hello & goodbye"),
+    "<strong>hello &amp; goodbye</strong>"
+  )
+  expect_rendered_caption(
+    htmltools::HTML("<strong>hello &amp; goodbye</strong>"),
+    "<strong>hello &amp; goodbye</strong>"
+  )
+  expect_rendered_caption(
+    I("<strong>hello &amp; goodbye</strong>"),
+    "<strong>hello &amp; goodbye</strong>"
+  )
+  expect_rendered_caption("", "</caption>")
+})
+
+test_that("bookdown-style crossrefs are added when knitting", {
+  old_label <- knitr::opts_current$get("label")
+  old_bookdown_label <- knitr::opts_knit$get("bookdown.internal.label")
+  old_knitr_progress <- getOption("knitr.in.progress")
+  on.exit({
+    knitr::opts_current$set(label = old_label)
+    knitr::opts_knit$set(bookdown.internal.label = old_bookdown_label)
+    options(knitr.in.progress = old_knitr_progress)
+  }, add = TRUE)
+
+  options(knitr.in.progress = TRUE)
+  knitr::opts_current$set(label = "foo")
+  knitr::opts_knit$set(bookdown.internal.label = TRUE)
+
+  table_html <- as_raw_html(gt(exibble, caption = "A table"))
+  expect_true(grepl("<caption[^>]*>", table_html))
+  # The label prefixes the caption text; whitespace between them is not specified
+  expect_true(grepl("\\(\\\\#tab:foo\\)\\s*A table", table_html))
+})
+
+test_that("tables without captions omit the caption element", {
+  table_html <- as_raw_html(gt(exibble))
+  expect_false(grepl("<caption", table_html, fixed = TRUE))
+})
