+function test_set_abstract_string()
+    abstract_string = split("foo.bar", ".")[1]
+    model = Model() do
+        return MOI.Utilities.MockOptimizer(
+            MOI.Utilities.UniversalFallback(MOI.Utilities.Model{Float64}()),
+        )
+    end
+    # The contract permits either accepting the `AbstractString` value (by
+    # converting it internally) or producing a useful diagnostic hint. Both are
+    # acceptable, but the confusing `SetAttributeNotAllowed` error is not.
+    function check_set_and_get(set, get)
+        try
+            set()
+            @test get() == "foo"
+        catch err
+            @test !(err isa MOI.SetAttributeNotAllowed)
+        end
+        return
+    end
+    check_set_and_get(
+        () -> set_attribute(model, MOI.Name(), abstract_string),
+        () -> get_attribute(model, MOI.Name()),
+    )
+    @variable(model, x)
+    check_set_and_get(
+        () -> set_attribute(x, MOI.VariableName(), abstract_string),
+        () -> get_attribute(x, MOI.VariableName()),
+    )
+    c = @constraint(model, 2x >= 1)
+    check_set_and_get(
+        () -> set_attribute(c, MOI.ConstraintName(), abstract_string),
+        () -> get_attribute(c, MOI.ConstraintName()),
+    )
+    return
+end
+
 end  # module TestModels
