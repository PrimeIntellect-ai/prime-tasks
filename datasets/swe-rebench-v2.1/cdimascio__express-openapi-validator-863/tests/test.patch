diff --git a/test/headers.spec.ts b/test/headers.spec.ts
index dae8ff8..1aad539 100644
--- a/test/headers.spec.ts
+++ b/test/headers.spec.ts
@@ -70,5 +70,158 @@ describe(packageJson.name, () => {
           tag: 'cat',
         })
         .expect(200));
+
+    it('should succeed in sending a content-type: "application/json; version=1" in multiple ways', async () =>{
+      await request(app)
+        .post(`${app.basePath}/pets_content_types`)
+        .set('Content-Type', 'application/json; version=1')
+        .set('Accept', 'application/json')
+        .send({
+          name: 'myPet',
+          tag: 'cat',
+        })
+        .expect(200);
+
+      await request(app)
+        .post(`${app.basePath}/pets_content_types`)
+        .set('Content-Type', 'application/json;version=1')
+        .set('Accept', 'application/json')
+        .send({
+          name: 'myPet',
+          tag: 'cat',
+        })
+        .expect(200);
+    });
+
+    it('should succeed for content-types with multiple parameters supplied in different orders', async () => {
+      await request(app)
+        .post(`${app.basePath}/pets_content_types_multi`)
+        .set('Content-Type', 'application/json; param1=1; charset=utf-8; version=1')
+        .set('Accept', 'application/json')
+        .send({
+          name: 'myPet',
+          tag: 'cat',
+        })
+        .expect(200);
+
+      await request(app)
+        .post(`${app.basePath}/pets_content_types_multi`)
+        .set('Content-Type', 'application/json; version=1; charset=utf-8; param1=1')
+        .set('Accept', 'application/json')
+        .send({
+          name: 'myPet',
+          tag: 'cat',
+        })
+        .expect(200);
+    });
+
+    it('should throw a 415 error for unsupported "application/json; version=2" content type', async () =>
+      request(app)
+        .post(`${app.basePath}/pets_content_types`)
+        .set('Content-Type', 'application/json; version=2')
+        .set('Accept', 'application/json')
+        .send({
+          name: 'myPet',
+          tag: 'cat',
+        })
+        .expect(415));
+
+    it('should keep an unsupported parameter name unsupported after a valid cached request', async () => {
+      await request(app)
+        .post(`${app.basePath}/pets_content_types`)
+        .set('Content-Type', 'application/json; version=1')
+        .set('Accept', 'application/json')
+        .send({ name: 'myPet', tag: 'cat' })
+        .expect(200);
+
+      await request(app)
+        .post(`${app.basePath}/pets_content_types`)
+        .set('Content-Type', 'application/json; param1=1')
+        .set('Accept', 'application/json')
+        .send({ name: 'myPet', tag: 'cat' })
+        .expect(415);
+    });
+
+    it('should keep an absent declared parameter unsupported after a valid cached request', async () => {
+      await request(app)
+        .post(`${app.basePath}/pets_content_types`)
+        .set('Content-Type', 'application/json; version=1')
+        .set('Accept', 'application/json')
+        .send({ name: 'myPet', tag: 'cat' })
+        .expect(200);
+
+      await request(app)
+        .post(`${app.basePath}/pets_content_types`)
+        .set('Content-Type', 'application/json')
+        .set('Accept', 'application/json')
+        .send({ name: 'myPet', tag: 'cat' })
+        .expect(415);
+    });
+
+    it('should throw a 415 error for a path/method which has previously succeeded using different request body content types', async () => {
+      await request(app)
+        .post(`${app.basePath}/pets_content_types`)
+        .set('Content-Type', 'application/json;version=1')
+        .set('Accept', 'application/json')
+        .send({
+          name: 'myPet',
+          tag: 'cat',
+        })
+        .expect(200);
+
+      await request(app)
+        .post(`${app.basePath}/pets_content_types`)
+        .set('Content-Type', 'application/json; version=3')
+        .set('Accept', 'application/json')
+        .send({
+          name: 'myPet',
+          tag: 'cat',
+        })
+        .expect(415);
+    });
+    it('should validate each parameter set against its own request body schema after another parameter set was validated', async () => {
+      await request(app)
+        .post(`${app.basePath}/pets_content_types_schemas`)
+        .set('Content-Type', 'application/json; version=1')
+        .set('Accept', 'application/json')
+        .send({ name: 'myPet', tag: 'cat' })
+        .expect(200);
+
+      await request(app)
+        .post(`${app.basePath}/pets_content_types_schemas`)
+        .set('Content-Type', 'application/json; param1=1')
+        .set('Accept', 'application/json')
+        .send({ id: 1 })
+        .expect(200);
+
+      await request(app)
+        .post(`${app.basePath}/pets_content_types_schemas`)
+        .set('Content-Type', 'application/json; version=1')
+        .set('Accept', 'application/json')
+        .send({ id: 1 })
+        .expect(400);
+    });
+    it('should accept a reordered content-type when the other ordering was sent first', async () => {
+      await request(app)
+        .post(`${app.basePath}/pets_content_types_multi`)
+        .set('Content-Type', 'application/json; version=1; charset=utf-8; param1=1')
+        .set('Accept', 'application/json')
+        .send({ name: 'myPet', tag: 'cat' })
+        .expect(200);
+
+      await request(app)
+        .post(`${app.basePath}/pets_content_types_multi`)
+        .set('Content-Type', 'application/json; param1=1; charset=utf-8; version=1')
+        .set('Accept', 'application/json')
+        .send({ name: 'myPet', tag: 'cat' })
+        .expect(200);
+
+      await request(app)
+        .post(`${app.basePath}/pets_content_types_multi`)
+        .set('Content-Type', 'application/json; charset=utf-8; param1=1')
+        .set('Accept', 'application/json')
+        .send({ name: 'myPet', tag: 'cat' })
+        .expect(415);
+    });
   });
 });
