+def test_from_type_constrained_date_rewrites_comparison_filter(monkeypatch):
+    try:
+        import annotated_types as at
+    except ImportError:
+        class BaseMetadata:
+            pass
+
+        class Gt(BaseMetadata):
+            def __init__(self, gt):
+                self.gt = gt
+
+        class OtherMetadata(BaseMetadata):
+            pass
+
+        at = ModuleType("annotated_types")
+        at.BaseMetadata = BaseMetadata
+        at.Gt = Gt
+        at.Ge = at.Lt = at.Le = at.MinLen = at.MaxLen = at.Predicate = OtherMetadata
+        monkeypatch.setitem(sys.modules, "annotated_types", at)
+
+    impossible_date = Annotated[dt.date, at.Gt(dt.date.max)]
+    assert st.from_type(impossible_date).is_empty
+
+
+def test_dates_filter_rewriting():
+    today = dt.date.today()
+
+    # Comparisons that no date can satisfy give an empty strategy.
+    assert st.dates().filter(partial(operator.lt, dt.date.max)).is_empty
+    assert st.dates().filter(partial(operator.gt, dt.date.min)).is_empty
+    assert st.dates(min_value=today).filter(partial(operator.gt, today)).is_empty
+    assert st.dates(max_value=today).filter(partial(operator.lt, today)).is_empty
+
+    # Comparisons that every date satisfies still generate valid dates.
+    vacuous_max = st.dates().filter(partial(operator.ge, dt.date.max))
+    assert not vacuous_max.is_empty
+    assert_all_examples(vacuous_max, lambda value: value <= dt.date.max)
+    vacuous_min = st.dates().filter(partial(operator.le, dt.date.min))
+    assert not vacuous_min.is_empty
+    assert_all_examples(vacuous_min, lambda value: value >= dt.date.min)
+
+    # A useful comparison restricts the generated dates to those satisfying it.
+    new = st.dates().filter(partial(operator.le, today))
+    assert not new.is_empty
+    assert_all_examples(new, lambda value: value >= today)
+
+    # A narrow satisfiable bound must not rely on rejection sampling, which
+    # would fail the filtering health check.
+    lower = dt.date(9999, 12, 1)
+    narrow = st.dates().filter(partial(operator.le, lower))
+    assert_all_examples(narrow, lambda value: value >= lower)
+
+    equal_to_max = st.dates().filter(partial(operator.eq, dt.date.max))
+    assert_all_examples(equal_to_max, lambda value: value == dt.date.max)
