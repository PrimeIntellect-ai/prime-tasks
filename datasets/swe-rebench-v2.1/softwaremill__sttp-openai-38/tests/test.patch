+package sttp.openai.requests.moderations
+
+import org.scalatest.EitherValues
+import org.scalatest.flatspec.AnyFlatSpec
+import org.scalatest.matchers.should.Matchers
+import sttp.model.Method
+import sttp.openai.OpenAi
+import sttp.openai.json.SttpUpickleApiExtension
+import sttp.openai.requests.moderations.ModerationsRequestBody.ModerationsBody
+import sttp.openai.requests.moderations.ModerationsResponseData._
+
+class ModerationsDataSpec extends AnyFlatSpec with Matchers with EitherValues {
+  "Given create moderation request" should "expose a response decoded as moderation data" in {
+    val request = new OpenAi("test-token").createModeration(ModerationsBody("text"))
+
+    val response: sttp.client4.ResponseAs[Either[_, ModerationData]] =
+      request.response
+
+    response should not be null
+  }
+
+  "Given create moderation request" should "be sent as a POST to the moderations endpoint" in {
+    // given
+    val openAi = new OpenAi("test-token")
+    val input = "I want to kill them."
+
+    // when
+    val request = openAi.createModeration(ModerationsBody(input))
+
+    // then
+    request.method shouldBe Method.POST
+    request.uri.toString shouldBe "https://api.openai.com/v1/moderations"
+    request.body.show should include(input)
+  }
+
+  "Given moderation response as Json" should "be properly deserialized to case class" in {
+    // given
+    val json =
+      """{
+        |  "id": "modr-5MWoLO",
+        |  "model": "text-moderation-001",
+        |  "results": [
+        |    {
+        |      "flagged": true,
+        |      "categories": {
+        |        "sexual": true,
+        |        "hate": false,
+        |        "violence": false,
+        |        "self-harm": true,
+        |        "sexual/minors": false,
+        |        "hate/threatening": true,
+        |        "violence/graphic": false
+        |      },
+        |      "category_scores": {
+        |        "sexual": 0.91,
+        |        "hate": 0.12,
+        |        "violence": 0.23,
+        |        "self-harm": 0.34,
+        |        "sexual/minors": 0.45,
+        |        "hate/threatening": 0.56,
+        |        "violence/graphic": 0.67
+        |      }
+        |    }
+        |  ]
+        |}""".stripMargin
+
+    val expected = ModerationData(
+      id = "modr-5MWoLO",
+      model = "text-moderation-001",
+      results = Seq(
+        Result(
+          flagged = true,
+          categories = Categories(
+            sexual = true,
+            hate = false,
+            violence = false,
+            `self-harm` = true,
+            `sexual/minors` = false,
+            `hate/threatening` = true,
+            `violence/graphic` = false
+          ),
+          categoryScores = CategoryScores(
+            sexual = 0.91,
+            hate = 0.12,
+            violence = 0.23,
+            `self-harm` = 0.34,
+            `sexual/minors` = 0.45,
+            `hate/threatening` = 0.56,
+            `violence/graphic` = 0.67
+          )
+        )
+      )
+    )
+
+    // when
+    val givenResponse: Either[Exception, ModerationData] =
+      SttpUpickleApiExtension.deserializeJsonSnake[ModerationData].apply(json)
+
+    // then
+    givenResponse.value shouldBe expected
+  }
+
+  "Given moderation result with category flags as Json" should "map every category flag to its field" in {
+    // given
+    val json =
+      """{
+        |  "flagged": false,
+        |  "categories": {
+        |    "sexual": false,
+        |    "hate": true,
+        |    "violence": false,
+        |    "self-harm": false,
+        |    "sexual/minors": true,
+        |    "hate/threatening": false,
+        |    "violence/graphic": true
+        |  },
+        |  "category_scores": {
+        |    "sexual": 0.01,
+        |    "hate": 0.82,
+        |    "violence": 0.03,
+        |    "self-harm": 0.04,
+        |    "sexual/minors": 0.75,
+        |    "hate/threatening": 0.06,
+        |    "violence/graphic": 0.87
+        |  }
+        |}""".stripMargin
+
+    // when
+    val givenResult: Either[Exception, Result] =
+      SttpUpickleApiExtension.deserializeJsonSnake[Result].apply(json)
+
+    // then
+    val result = givenResult.value
+    result.flagged shouldBe false
+    result.categories shouldBe Categories(
+      sexual = false,
+      hate = true,
+      violence = false,
+      `self-harm` = false,
+      `sexual/minors` = true,
+      `hate/threatening` = false,
+      `violence/graphic` = true
+    )
+    result.categoryScores shouldBe CategoryScores(
+      sexual = 0.01,
+      hate = 0.82,
+      violence = 0.03,
+      `self-harm` = 0.04,
+      `sexual/minors` = 0.75,
+      `hate/threatening` = 0.06,
+      `violence/graphic` = 0.87
+    )
+  }
+}
