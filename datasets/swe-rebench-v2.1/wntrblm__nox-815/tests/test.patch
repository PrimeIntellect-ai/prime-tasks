+def test_run_forwards_io_and_timeout_controls(tmp_path: Path):
+    stdout_path = tmp_path / "stdout.txt"
+    stderr_path = tmp_path / "stderr.txt"
+    with stdout_path.open("w+") as stdout, stderr_path.open("w+") as stderr:
+        result = nox.command.run(
+            [
+                PYTHON,
+                "-c",
+                "import sys; print('out'); print('err', file=sys.stderr)",
+            ],
+            stdout=stdout,
+            stderr=stderr,
+            interrupt_timeout=5.0,
+            terminate_timeout=6.0,
+        )
+        stdout.seek(0)
+        stderr.seek(0)
+
+        assert result is True
+        assert stdout.read().strip() == "out"
+        assert stderr.read().strip() == "err"
+
+
+def test_run_interfaces_name_supported_keyword_controls():
+    from inspect import Parameter, signature
+
+    interfaces = {
+        nox.command.run: {
+            "env", "paths", "silent", "success_codes", "log", "external",
+            "stdout", "stderr", "interrupt_timeout", "terminate_timeout",
+        },
+        nox.sessions.Session.run: {
+            "env", "include_outer_env", "silent", "success_codes", "log",
+            "external", "stdout", "stderr", "interrupt_timeout", "terminate_timeout",
+        },
+        nox.sessions.Session.run_install: {
+            "env", "include_outer_env", "silent", "success_codes", "log",
+            "external", "stdout", "stderr", "interrupt_timeout", "terminate_timeout",
+        },
+        nox.sessions.Session.run_always: {
+            "env", "include_outer_env", "silent", "success_codes", "log",
+            "external", "stdout", "stderr", "interrupt_timeout", "terminate_timeout",
+        },
+        nox.sessions.Session.install: {
+            "env", "include_outer_env", "silent", "success_codes", "log",
+            "external", "stdout", "stderr", "interrupt_timeout", "terminate_timeout",
+        },
+        nox.sessions.Session.conda_install: {
+            "auto_offline", "channel", "env", "include_outer_env", "silent",
+            "success_codes", "log", "stdout", "stderr", "interrupt_timeout",
+            "terminate_timeout",
+        },
+    }
+
+    for interface, expected_parameters in interfaces.items():
+        parameters = signature(interface).parameters
+        assert expected_parameters <= parameters.keys()
+        assert all(
+            parameter.kind is not Parameter.VAR_KEYWORD
+            for parameter in parameters.values()
+        )
 
 
