+package com.zynger.floorplan
+
+import org.junit.Test
+import java.nio.file.Files
+import java.nio.file.Paths
+
+class InputParserTest {
+
+    @Test
+    fun `CLI opens schema paths relative to the home directory`() {
+        val home = Paths.get(System.getProperty("user.home"))
+        val schema = Files.createTempFile(home, "floorplan-", ".json")
+        try {
+            Files.write(
+                schema,
+                """{"formatVersion":1,"database":{"version":1,"identityHash":"test","entities":[],"setupQueries":[]}}""".toByteArray(Charsets.UTF_8)
+            )
+
+            main(arrayOf("~/" + schema.fileName.toString()))
+        } finally {
+            Files.deleteIfExists(schema)
+        }
+    }
+}
