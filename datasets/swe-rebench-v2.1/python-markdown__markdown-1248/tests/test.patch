+    def testFencedCodeEscapedAttrs(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                ``` { ."weird #"foo bar=">baz }
+                # Some python code
+                ```
+                '''
+            ),
+            self.dedent(
+                '''
+                <pre id="&quot;foo"><code class="language-&quot;weird" bar="&quot;&gt;baz"># Some python code
+                </code></pre>
+                '''
+            ),
+            extensions=['fenced_code', 'attr_list']
+        )
+
+    def testFencedCodeQuotedStandaloneClass(self):
+        output = markdown.markdown(
+            self.dedent(
+                '''
+                ``` { .python ."odd }
+                code
+                ```
+                '''
+            ),
+            extensions=['fenced_code', 'attr_list']
+        )
+        match = re.fullmatch(
+            r'<pre class="([^"]*)"><code class="language-python">code\n</code></pre>',
+            output
+        )
+        self.assertIsNotNone(match)
+        self.assertEqual(unescape(match.group(1)), '"odd')
