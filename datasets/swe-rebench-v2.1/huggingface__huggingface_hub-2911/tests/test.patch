+    @pytest.mark.asyncio
+    async def test_async_client_forwards_model_to_custom_conversational_endpoint(self):
+        received_payloads = []
+
+        async def handle_chat_completion(request):
+            received_payloads.append(await request.json())
+            return web.json_response(
+                {
+                    "choices": [
+                        {
+                            "finish_reason": "stop",
+                            "index": 0,
+                            "message": {"role": "assistant", "content": "Hello!"},
+                        }
+                    ],
+                    "created": 0,
+                    "id": "test-completion",
+                    "model": "actual-model",
+                    "system_fingerprint": "",
+                    "usage": {"completion_tokens": 1, "prompt_tokens": 1, "total_tokens": 2},
+                }
+            )
+
+        app = web.Application()
+        app.router.add_post("/v1/chat/completions", handle_chat_completion)
+        server = TestServer(app)
+        await server.start_server()
+
+        client = AsyncInferenceClient(str(server.make_url("/v1/chat/completions")), token="hf_test_token")
+        try:
+            await client.chat_completion(
+                [{"role": "user", "content": "Hello!"}],
+                model="username/repo_name",
+            )
+        finally:
+            await client.close()
+            await server.close()
+
+        assert received_payloads[0]["model"] == "username/repo_name"
