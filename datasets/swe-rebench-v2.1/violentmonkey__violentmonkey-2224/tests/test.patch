+
+function withLanguages(languages, callback) {
+  const original = Object.getOwnPropertyDescriptor(navigator, 'languages');
+  Object.defineProperty(navigator, 'languages', { configurable: true, value: languages });
+  try {
+    callback();
+  } finally {
+    if (original) Object.defineProperty(navigator, 'languages', original);
+    else delete navigator.languages;
+  }
+}
+
+test('getLocaleString matches Traditional Chinese regional metadata', () => {
+  const meta = {
+    'name': 'name without locale',
+    'name:zh': 'name for zh',
+    'name:zh-CN': 'name for zh-CN',
+    'name:zh-TW': 'name for zh-TW',
+  };
+  withLanguages(['zh-Hant-TW'], () => {
+    expect(getLocaleString(meta, 'name')).toBe('name for zh-TW');
+  });
+});
+
+test('getLocaleString matches Simplified Chinese regional metadata', () => {
+  const meta = {
+    'name': 'name without locale',
+    'name:zh-CN': 'name for zh-CN',
+  };
+  withLanguages(['zh-Hans-CN'], () => {
+    expect(getLocaleString(meta, 'name')).toBe('name for zh-CN');
+  });
+});
+
+test('getLocaleString honors browser language preference order', () => {
+  const meta = {
+    'name': 'name without locale',
+    'name:zh': 'name for zh',
+    'name:zh-CN': 'name for zh-CN',
+  };
+  withLanguages(['zh-CN', 'zh'], () => {
+    expect(getLocaleString(meta, 'name')).toBe('name for zh-CN');
+  });
+  withLanguages(['zh', 'zh-CN'], () => {
+    expect(getLocaleString(meta, 'name')).toBe('name for zh');
+  });
+});
+
+test('getLocaleString falls back to the unlocalized value or empty string', () => {
+  withLanguages(['en', 'en-US'], () => {
+    expect(getLocaleString({ name: 'name without locale', 'name:zh': 'name for zh' }, 'name'))
+      .toBe('name without locale');
+    expect(getLocaleString({ 'name:zh': 'name for zh' }, 'name')).toBe('');
+  });
+});
