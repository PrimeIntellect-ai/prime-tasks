+
+func TestModelGeneration_Issue2346(t *testing.T) {
+	targetdir, err := os.MkdirTemp(".", "swagger_model")
+	require.NoErrorf(t, err, "failed to create a test target directory: %v", err)
+	targetdir, err = filepath.Abs(targetdir)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		_ = os.RemoveAll(targetdir)
+	})
+
+	mainSpec := `swagger: "2.0"
+info:
+  title: main
+  version: "1.0.0"
+paths:
+  /business:
+    $ref: "business.yaml#/paths/~1business"
+`
+	businessSpec := `swagger: "2.0"
+info:
+  title: business
+  version: "1.0.0"
+paths:
+  /business:
+    post:
+      operationId: createBusiness
+      parameters:
+        - name: body
+          in: body
+          required: true
+          schema:
+            $ref: "#/definitions/Business"
+      responses:
+        200:
+          description: OK
+          schema:
+            type: object
+            properties:
+              accepted:
+                type: boolean
+definitions:
+  Business:
+    type: object
+    properties:
+      children:
+        type: array
+        items:
+          $ref: "#/definitions/Business"
+      users:
+        type: array
+        items:
+          type: object
+          properties:
+            role:
+              type: string
+`
+	mainSpecPath := filepath.Join(targetdir, "swagger.yaml")
+	require.NoError(t, os.WriteFile(mainSpecPath, []byte(mainSpec), 0o600))
+	require.NoError(t, os.WriteFile(filepath.Join(targetdir, "business.yaml"), []byte(businessSpec), 0o600))
+
+	repoRoot, err := filepath.Abs("..")
+	require.NoError(t, err)
+	outputDir := filepath.Join(targetdir, "generated")
+	require.NoError(t, os.Mkdir(outputDir, 0o755))
+	cmd := exec.Command("go", "run", "./cmd/swagger", "generate", "model", "--with-flatten=expand", "-f", mainSpecPath, "-t", outputDir)
+	cmd.Dir = repoRoot
+	output, err := cmd.CombinedOutput()
+	require.NoErrorf(t, err, "model generation failed: %s", output)
+}
