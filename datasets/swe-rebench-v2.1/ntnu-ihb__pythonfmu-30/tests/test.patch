diff --git a/pythonfmu/tests/test_fmi2slave.py b/pythonfmu/tests/test_fmi2slave.py
new file mode 100644
index 0000000..ccef89f
--- /dev/null
+++ b/pythonfmu/tests/test_fmi2slave.py
@@ -0,0 +1,45 @@
+import pytest
+
+from pythonfmu import Fmi2Slave, Boolean, Integer, Real, String
+
+
+ACCESSORS = [
+    (Boolean, "boolean", [True, False]),
+    (Integer, "integer", [11, 22]),
+    (Real, "real", [1.25, 2.5]),
+    (String, "string", ["first", "second"]),
+]
+
+
+@pytest.mark.parametrize("fmi_type,kind,values", ACCESSORS)
+def test_typed_getters_return_values_in_reference_order(fmi_type, kind, values):
+    class Slave(Fmi2Slave):
+        def __init__(self, instance_name):
+            super().__init__(instance_name)
+            self.first, self.second = values
+            self.register_variable(fmi_type("first"))
+            self.register_variable(fmi_type("second"))
+
+        def do_step(self, t, dt):
+            return True
+
+    slave = Slave("instanceSlave")
+    assert getattr(slave, f"get_{kind}")([1, 0]) == list(reversed(values))
+
+
+@pytest.mark.parametrize("fmi_type,kind,values", ACCESSORS)
+def test_typed_setters_update_values_read_by_getters(fmi_type, kind, values):
+    class Slave(Fmi2Slave):
+        def __init__(self, instance_name):
+            super().__init__(instance_name)
+            self.first = None
+            self.second = None
+            self.register_variable(fmi_type("first"))
+            self.register_variable(fmi_type("second"))
+
+        def do_step(self, t, dt):
+            return True
+
+    slave = Slave("instanceSlave")
+    getattr(slave, f"set_{kind}")([1, 0], values)
+    assert getattr(slave, f"get_{kind}")([0, 1]) == list(reversed(values))
