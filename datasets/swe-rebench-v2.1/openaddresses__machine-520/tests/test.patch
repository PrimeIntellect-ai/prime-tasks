+    def test_main_south_america_collection(self):
+        ''' Check that the collection pipeline builds a South America collection
+            and classifies South American sources into it.
+        '''
+        tmpdir = mkdtemp(prefix='TestCollect-main-')
+        self.addCleanup(rmtree, tmpdir)
+
+        handle, south_america_zip = mkstemp(suffix='.zip'); close(handle)
+        self.addCleanup(remove, south_america_zip)
+        with ZipFile(south_america_zip, 'w') as zipfile:
+            zipfile.writestr('br.csv', 'LON,LAT\n-46.6,-23.5\n')
+
+        handle, europe_zip = mkstemp(suffix='.zip'); close(handle)
+        self.addCleanup(remove, europe_zip)
+        with ZipFile(europe_zip, 'w') as zipfile:
+            zipfile.writestr('fr.csv', 'LON,LAT\n2.3,48.8\n')
+
+        the_set = SimpleNamespace(owner='openaddresses', repository='openaddresses',
+                                  commit_sha='ff9900', id=1)
+        south_america = LocalProcessedResult('br', south_america_zip, RunState(None), None)
+        europe = LocalProcessedResult('fr', europe_zip, RunState(None), None)
+
+        args = mock.Mock(owner='openaddresses', repository='openaddresses',
+                         bucket=None, sns_arn=None, loglevel=logging.INFO,
+                         database_url=None)
+        uploaded_collections = []
+
+        def record_upload(bucket, filename, keyname, **kwargs):
+            with ZipFile(filename) as archive:
+                uploaded_collections.append((keyname, set(archive.namelist())))
+            return SimpleNamespace(name=keyname)
+
+        with patch('openaddr.ci.collect.parser.parse_args', return_value=args), \
+             patch('openaddr.ci.collect.setup_logger'), \
+             patch('openaddr.ci.collect.S3'), \
+             patch('openaddr.ci.collect.util.prepare_db_kwargs', return_value={}), \
+             patch('openaddr.ci.collect.db_connect'), \
+             patch('openaddr.ci.collect.db_cursor'), \
+             patch('openaddr.ci.collect.read_latest_set', return_value=the_set), \
+             patch('openaddr.ci.collect.read_completed_runs_to_date', return_value=[]), \
+             patch('openaddr.ci.collect.mkdtemp', return_value=tmpdir), \
+             patch('openaddr.ci.collect.rmtree'), \
+             patch('openaddr.ci.collect.iterate_local_processed_files',
+                   return_value=[south_america, europe]), \
+             patch('openaddr.ci.collect.write_to_s3', side_effect=record_upload), \
+             patch('openaddr.ci.collect.util.summarize_result_licenses', return_value='license'), \
+             patch('openaddr.ci.collect.util.s3_key_url', return_value='http://example.com/x.zip'):
+            collect.main()
+
