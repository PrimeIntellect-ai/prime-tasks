+    def test_invalid_grant_should_not_remove_rt(self):
+        # https://github.com/AzureAD/microsoft-authentication-library-for-python/issues/315
+        # An invalid_grant for one scope/tenant does not necessarily mean the RT
+        # is unusable for another scope/tenant, so it must be kept in the cache.
+        error_response = '{"error": "invalid_grant", "error_description": "xyz"}'
+        def tester(url, **kwargs):
+            return MinimalResponse(status_code=400, text=error_response)
+        self.app.acquire_token_silent_with_error(
+            self.scopes, self.account, post=tester)
+        self.assertNotEqual(
+            [],
+            self.cache.find(
+                msal.TokenCache.CredentialType.REFRESH_TOKEN,
+                query={"secret": self.rt}),
+            "The RT should be persisted even after receiving invalid_grant")
+
