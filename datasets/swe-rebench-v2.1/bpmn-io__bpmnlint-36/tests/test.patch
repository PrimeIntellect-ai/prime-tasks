+
+          const config = {
+            extends: [
+              'plugin:@ns/bpmnlint-plugin-test/other'
+            ],
+            rules: {
+              '@ns/test/foo': 'error'
+            }
+          };
+
+          // when
+          const rules = await linter.resolveConfiguredRules(config);
+
+          // then
+          expect([
+            rules['@ns/test/foo'],
+            rules['@ns/bpmnlint-plugin-test/foo']
+          ]).to.include('error');
+
+          Object.keys(rules)
+            .filter(key => key.endsWith('/foo'))
+            .forEach(key => expect(rules[key]).to.equal('error'));
+        });
+
+
+        it('should normalize multiple', async function() {
+
+          // given
+          const linter = new Linter({ resolver });
+
+          const config = {
+            extends: [
+              'plugin:@ns/test/other',
+              'plugin:@ns/bpmnlint-plugin-test/recommended',
+              'plugin:test/recommended'
+            ],
+            rules: {
+              '@ns/bpmnlint-plugin-test/bar': 'off',
+              '@ns/bpmnlint-plugin-test/foo': 'error'
+            }
+          };
+
+          // when
+          const rules = await linter.resolveConfiguredRules(config);
+
+          // then
+          expect([
+            rules['@ns/test/foo'],
+            rules['@ns/bpmnlint-plugin-test/foo']
+          ]).to.include('error');
+          expect([
+            rules['@ns/test/bar'],
+            rules['@ns/bpmnlint-plugin-test/bar']
+          ]).to.include('off');
+
+          Object.keys(rules).forEach(key => {
+            expect(key).to.match(/\/(foo|bar)$/);
+          });
+
+          Object.keys(rules)
