+
+    def test_mapped_trait_does_not_emit_deprecation_warning(self):
+        # Traits' own use of mapping-based traits must not raise the
+        # deprecation warning for TraitMap.
+        with warnings.catch_warnings(record=True) as record:
+            warnings.simplefilter("always", DeprecationWarning)
+
+            class Mapped(HasTraits):
+                value = Trait("one", {"one": 1, "two": 2})
+
+            mapped = Mapped()
+            mapped.value = "two"
+
+        self.assertEqual(mapped.value, "two")
+        messages = [str(w.message) for w in record]
+        self.assertFalse(
+            [message for message in messages if "TraitMap" in message],
+            messages,
+        )
