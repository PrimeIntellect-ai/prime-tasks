+def test_apply_tuple_of_measurements_raises_in_circuit():
+    """Test the reported circuit, which applies a tuple of measurement processes,
+    raises an error instead of silently returning an empty result."""
+    dev = qml.device("default.qubit", wires=2, shots=1024)
+    op = qml.sample(qml.X(0) + qml.Y(0)), qml.sample(qml.X(0))
+
+    @qml.qnode(dev)
+    def circuit():
+        qml.RX(np.pi / 3, 0)
+        qml.RZ(np.pi / 3, 0)
+        return qml.apply(op)
+
+    with pytest.raises(Exception):
+        circuit()
