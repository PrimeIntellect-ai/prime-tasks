+func TestGoTransformOptionalEnumDefaultWithPointerTarget(t *testing.T) {
+	root := RunDSL(t, func() {
+		dsl.Type("ColorChoice", func() {
+			dsl.Attribute("color", dsl.String, func() {
+				dsl.Enum("red", "blue")
+				dsl.Default("red")
+			})
+		})
+	})
+	colorChoice := root.UserType("ColorChoice")
+	code, _, err := GoTransform(
+		&expr.AttributeExpr{Type: colorChoice},
+		&expr.AttributeExpr{Type: colorChoice},
+		"source", "target",
+		NewAttributeContext(false, false, true, "", NewNameScope()),
+		NewAttributeContext(true, false, true, "", NewNameScope()),
+		"", true,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	src := "package generated\n" +
+		"type Source struct { Color string }\n" +
+		"type ColorChoice struct { Color *string }\n" +
+		"func transform(source *Source) {\n" + code + "\n_ = target\n}\n"
+	fset := token.NewFileSet()
+	file, err := parser.ParseFile(fset, "generated.go", src, parser.AllErrors)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := new(types.Config).Check("generated", fset, []*ast.File{file}, nil); err != nil {
+		t.Errorf("generated code does not type-check with pointer target fields: %v\n%s", err, code)
+	}
+}
