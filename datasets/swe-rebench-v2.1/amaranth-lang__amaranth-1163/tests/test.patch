 class PinTestCase(FHDLTestCase):
+    def test_signature_rejects_invalid_parameters(self):
+        for width in (-1, 1.5):
+            with self.subTest(width=width):
+                with self.assertRaises(Exception):
+                    Pin.Signature(width, dir="i")
+
+        for xdr in (-1, 1.5):
+            with self.subTest(xdr=xdr):
+                with self.assertRaises(Exception):
+                    Pin.Signature(1, dir="i", xdr=xdr)
+
+        with self.assertRaises(Exception):
+            Pin.Signature(1, dir="unsupported")
+
+    def test_flipped_reverses_member_flows(self):
+        pin = Pin(2, dir="io", xdr=3)
+        view = flipped(pin)
+        self.assertIsInstance(view, FlippedInterface)
+        for name, member in pin.signature.members.items():
+            with self.subTest(member=name):
+                expected_flow = In if member.flow is Out else Out
+                self.assertIs(view.signature.members[name].flow, expected_flow)
