+use crate::common::*;
+
+#[test]
+fn dont_run_duplicate_recipes() {
+  Test::new()
+    .justfile(
+      "
+      foo:
+        # foo
+    ",
+    )
+    .args(&["foo", "foo"])
+    .stderr(
+      "
+      # foo
+    ",
+    )
+    .run();
+}
+
+#[test]
+fn dependency_runs_once_when_requested_after_dependent_recipe() {
+  Test::new()
+    .justfile(
+      "
+      build:
+        @echo build
+
+      test: build
+        @echo test
+    ",
+    )
+    .args(&["test", "build"])
+    .stdout(
+      "
+      build
+      test
+    ",
+    )
+    .run();
+}
+
+#[test]
+fn shared_dependency_runs_once() {
+  Test::new()
+    .justfile(
+      "
+      a: c
+        @echo a
+
+      b: c
+        @echo b
+
+      c:
+        @echo c
+    ",
+    )
+    .args(&["a", "b", "c"])
+    .stdout(
+      "
+      c
+      a
+      b
+    ",
+    )
+    .run();
+}
