+#[cfg(unix)]
+#[test]
+fn test_make_uds() {
+    use std::os::unix::net::UnixListener;
+
+    let temp_sock = Builder::new()
+        .prefix("tmp")
+        .suffix(".sock")
+        .rand_bytes(12)
+        .make(|path| UnixListener::bind(path))
+        .unwrap();
+
+    let path = temp_sock.path().to_path_buf();
+    let name = path.file_name().unwrap().to_str().unwrap();
+    assert!(name.starts_with("tmp"));
+    assert!(name.ends_with(".sock"));
+    assert!(path.exists());
+
+    // The temporary socket path must be removed once the temporary object is
+    // dropped (i.e. when the server shuts down).
+    drop(temp_sock);
+    assert!(!path.exists());
+}
