+#[test]
+fn test_make_does_not_retry_other_errors() {
+    use std::io::{Error, ErrorKind};
+
+    let mut calls = 0;
+    let result: std::io::Result<NamedTempFile<()>> = Builder::new().make(|_| {
+        calls += 1;
+        if calls == 1 {
+            Err(Error::from(ErrorKind::PermissionDenied))
+        } else {
+            Ok(())
+        }
+    });
+
+    match result {
+        Err(error) => assert_eq!(error.kind(), ErrorKind::PermissionDenied),
+        Ok(_) => panic!("callback error should be returned"),
+    }
+    assert_eq!(calls, 1);
+}
