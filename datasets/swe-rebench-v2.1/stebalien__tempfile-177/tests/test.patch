+#[test]
+fn test_make_in() {
+    let tmp_dir = tempdir().unwrap();
+    let mut callback_was_called = false;
+
+    let tmpfile = Builder::new()
+        .prefix("in-prefix-")
+        .suffix("-in-suffix")
+        .make_in(tmp_dir.path(), |path| {
+            callback_was_called = true;
+            File::create(path)
+        })
+        .unwrap();
+
+    assert!(tmpfile.path().is_file());
+    assert_eq!(
+        tmpfile.path().parent().unwrap().canonicalize().unwrap(),
+        tmp_dir.path().canonicalize().unwrap()
+    );
+    let file_name = tmpfile.path().file_name().unwrap().to_string_lossy();
+    assert!(file_name.starts_with("in-prefix-"));
+    assert!(file_name.ends_with("-in-suffix"));
+    assert!(callback_was_called);
+}
