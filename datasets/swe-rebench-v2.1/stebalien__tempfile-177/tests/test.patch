+#[test]
+fn test_make_retries_on_already_exists() {
+    use std::io::{Error, ErrorKind};
+
+    let mut attempted_paths = Vec::new();
+    let tmpfile = Builder::new()
+        .rand_bytes(32)
+        .make(|path| {
+            attempted_paths.push(path.to_path_buf());
+            if attempted_paths.len() < 3 {
+                Err(Error::from(ErrorKind::AlreadyExists))
+            } else {
+                File::create(path)
+            }
+        })
+        .unwrap();
+
+    assert_eq!(attempted_paths.len(), 3);
+    assert_ne!(attempted_paths[0], attempted_paths[1]);
+    assert_ne!(attempted_paths[1], attempted_paths[2]);
+    assert_eq!(tmpfile.path(), attempted_paths[2]);
+}
+
+#[test]
+fn test_make_in_retries_on_retryable_errors() {
+    use std::io::{Error, ErrorKind};
+
+    for error_kind in &[ErrorKind::AlreadyExists, ErrorKind::AddrInUse] {
+        let tmp_dir = tempdir().unwrap();
+        let mut attempted_paths = Vec::new();
+
+        let tmpfile = Builder::new()
+            .rand_bytes(32)
+            .make_in(tmp_dir.path(), |path| {
+                attempted_paths.push(path.to_path_buf());
+                if attempted_paths.len() == 1 {
+                    Err(Error::from(*error_kind))
+                } else {
+                    File::create(path)
+                }
+            })
+            .unwrap();
+
+        assert_eq!(attempted_paths.len(), 2);
+        assert_ne!(attempted_paths[0], attempted_paths[1]);
+        assert_eq!(tmpfile.path(), attempted_paths[1]);
+        assert_eq!(
+            tmpfile.path().parent().unwrap().canonicalize().unwrap(),
+            tmp_dir.path().canonicalize().unwrap()
+        );
+    }
+}
