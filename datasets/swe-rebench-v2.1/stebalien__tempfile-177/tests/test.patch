+#[test]
+fn test_make() {
+    let tmpfile = Builder::new()
+        .prefix("make-prefix-")
+        .suffix("-make-suffix")
+        .make(|path| File::create(path))
+        .unwrap();
+    let path = tmpfile.path().to_path_buf();
+
+    assert!(path.is_file());
+    assert_eq!(
+        path.parent().unwrap().canonicalize().unwrap(),
+        env::temp_dir().canonicalize().unwrap()
+    );
+    let file_name = path.file_name().unwrap().to_string_lossy();
+    assert!(file_name.starts_with("make-prefix-"));
+    assert!(file_name.ends_with("-make-suffix"));
+
+    drop(tmpfile);
+    assert!(!path.exists());
+}
