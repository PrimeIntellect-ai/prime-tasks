+#[test]
+fn test_make_retries_on_addr_in_use() {
+    use std::io::{Error, ErrorKind};
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::sync::Arc;
+
+    // The callback fails with `AddrInUse` a few times before succeeding; the
+    // builder must retry with a fresh path instead of giving up.
+    let calls = Arc::new(AtomicUsize::new(0));
+    let calls2 = calls.clone();
+
+    let tmpfile = Builder::new()
+        .make(move |path| {
+            let n = calls2.fetch_add(1, Ordering::Relaxed);
+            if n < 3 {
+                Err(Error::from(ErrorKind::AddrInUse))
+            } else {
+                File::create(path)
+            }
+        })
+        .unwrap();
+
+    assert!(tmpfile.path().is_file());
+    assert!(calls.load(Ordering::Relaxed) > 1);
+}
