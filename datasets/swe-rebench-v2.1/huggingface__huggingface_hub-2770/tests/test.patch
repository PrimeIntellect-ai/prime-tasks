+class _FakeSummaryWriter:
+    """Minimal stand-in for tensorboard's `SummaryWriter`, which is not installed in tests."""
+
+    def __init__(self, logdir=None, **kwargs):
+        self.logdir = logdir or "/tmp/fake_logdir"
+
+
+def _init_hf_summary_writer(repo_id="test", logdir="/tmp/fake_logdir"):
+    """Instantiate `HFSummaryWriter` offline and return the model card it updated.
+
+    `HFSummaryWriter` needs tensorboard to be installed and otherwise talks to the Hub. Both are
+    replaced here so that its tag-handling logic can be exercised without network access.
+    """
+    import huggingface_hub._tensorboard_logger as tensorboard_logger
+
+    fake_tensorboardx = types.ModuleType("tensorboardX")
+    fake_tensorboardx.SummaryWriter = _FakeSummaryWriter
+    original_tensorboardx = sys.modules.get("tensorboardX")
+    sys.modules["tensorboardX"] = fake_tensorboardx
+    try:
+        importlib.reload(tensorboard_logger)
+    finally:
+        if original_tensorboardx is None:
+            sys.modules.pop("tensorboardX", None)
+        else:
+            sys.modules["tensorboardX"] = original_tensorboardx
+
+    pushed_cards = []
+
+    def _record_push(self, **kwargs):
+        pushed_cards.append(self)
+
+    try:
+        with patch.object(tensorboard_logger, "CommitScheduler", MagicMock()), patch.object(
+            ModelCard, "load", side_effect=EntryNotFoundError("no card")
+        ), patch.object(ModelCard, "push_to_hub", _record_push):
+            tensorboard_logger.HFSummaryWriter(repo_id=repo_id, logdir=logdir)
+    finally:
+        # Restore the module to its original (tensorboard-less) state.
+        importlib.reload(tensorboard_logger)
+
+    return pushed_cards[-1]
+
