+
+@particle_input(require='ion')
+def _require_ion(particle: Particle):
+    return particle
+
+
+@particle_input(any_of='ion')
+def _any_of_ion(particle: Particle):
+    return particle
+
+
+@particle_input(exclude='ion')
+def _exclude_ion(particle: Particle):
+    return particle
+
+
+def test_particle_input_ion_category():
+    """
+    Test that the `@particle_input` decorator's `require`, `any_of`, and
+    `exclude` keyword arguments treat an explicitly neutral atom as not
+    being an ion.
+    """
+    assert _require_ion('D+') == Particle('D+')
+    assert _any_of_ion('D+') == Particle('D+')
+    assert _exclude_ion('H-1 0+') == Particle('H-1 0+')
+
+    with pytest.raises(AtomicError):
+        _require_ion('H-1 0+')
+
+    with pytest.raises(AtomicError):
+        _any_of_ion('H-1 0+')
+
+    with pytest.raises(AtomicError):
+        _exclude_ion('D+')
