+  tbl_html %>% render_as_html() %>%
+    html_fragment_within(
+      "<colgroup>",
+      "<col style=\"width:25%;\"/>",
+      "<col style=\"width:50%;\"/>",
+      "<col/>",
+      "<col/>",
+      "</colgroup>"
+    ) %>%
+    expect_true()
+})
+
+test_that("CSS length values are validated", {
+
+  # Expect that a vector of valid CSS lengths (with empty
+  # strings ignored) returns `TRUE`
+  expect_true(
+    validate_css_lengths(c("", "3px", "3em", "3rem", "20%"))
+  )
+
+  # Expect an error if an incorrect unit is present
+  # in any vector element of CSS length values
+  expect_error(
+    validate_css_lengths(c("", "3", "3em", "3rem", "3dem"))
+  )
 })
