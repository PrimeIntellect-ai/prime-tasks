+import boto3
+
+from moto import mock_aws
+
+
+@mock_aws
+def test_get_cost_and_usage_returns_response():
+    ce = boto3.client("ce", region_name="eu-west-1")
+
+    response = ce.get_cost_and_usage(
+        TimePeriod={"Start": "2024-01-01", "End": "2024-02-01"},
+        Granularity="DAILY",
+        Metrics=["UnblendedCost"],
+    )
+
+    assert isinstance(response["ResultsByTime"], list)
+    assert isinstance(response["DimensionValueAttributes"], list)
