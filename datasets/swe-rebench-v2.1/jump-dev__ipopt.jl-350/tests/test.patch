+            cols[1] = 1
+            rows[2] = 1
+            cols[2] = 2
+            rows[3] = 1
+            cols[3] = 3
+            rows[4] = 1
+            cols[4] = 4
+            rows[5] = 2
+            cols[5] = 1
+            rows[6] = 2
+            cols[6] = 2
+            rows[7] = 2
+            cols[7] = 3
+            rows[8] = 2
+            cols[8] = 4
+        else
+            values[1] = x[2] * x[3] * x[4]
+            values[2] = x[1] * x[3] * x[4]
+            values[3] = x[1] * x[2] * x[4]
+            values[4] = x[1] * x[2] * x[3]
+            values[5] = 2 * x[1]
+            values[6] = 2 * x[2]
+            values[7] = 2 * x[3]
+            values[8] = 2 * x[4]
