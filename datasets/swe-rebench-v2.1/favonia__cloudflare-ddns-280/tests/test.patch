+// TestEmojiEnvironmentIntegration verifies that the application actually applies
+// the EMOJI environment variable to its logger. Setting EMOJI=false must make
+// the application emit emoji-free output, while the default keeps the emojis.
+func TestEmojiEnvironmentIntegration(t *testing.T) {
+	t.Parallel()
+
+	repoRoot, err := filepath.Abs(filepath.Join("..", ".."))
+	require.NoError(t, err)
+
+	bin := filepath.Join(t.TempDir(), "ddns")
+	build := exec.Command("go", "build", "-o", bin, "./cmd")
+	build.Dir = repoRoot
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("failed to build the application: %v\n%s", err, out)
+	}
+
+	run := func(emoji *string) string {
+		t.Helper()
+		ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+		defer cancel()
+		cmd := exec.CommandContext(ctx, bin)
+		cmd.Env = make([]string, 0, len(os.Environ())+1)
+		for _, entry := range os.Environ() {
+			if !strings.HasPrefix(entry, "EMOJI=") {
+				cmd.Env = append(cmd.Env, entry)
+			}
+		}
+		if emoji != nil {
+			cmd.Env = append(cmd.Env, "EMOJI="+*emoji)
+		}
+		out, _ := cmd.CombinedOutput()
+		return string(out)
+	}
+
+	trueValue := "true"
+	falseValue := "false"
+	withEmoji := run(&trueValue)
+	withoutEmoji := run(&falseValue)
+	defaultOutput := run(nil)
+
+	require.True(t, hasEmoji(withEmoji),
+		"the application should emit emojis when EMOJI=true, got:\n%s", withEmoji)
+	require.False(t, hasEmoji(withoutEmoji),
+		"the application should emit no emojis when EMOJI=false, got:\n%s", withoutEmoji)
+	require.NotEmpty(t, strings.TrimSpace(withoutEmoji),
+		"the application should preserve textual log messages when EMOJI=false")
+	require.True(t, hasEmoji(defaultOutput),
+		"the application should emit emojis when EMOJI is unset, got:\n%s", defaultOutput)
+}
+
+func hasEmoji(s string) bool {
+	for _, r := range s {
+		if (r >= 0x1F000 && r <= 0x1FAFF) || (r >= 0x2600 && r <= 0x27BF) {
+			return true
+		}
+	}
+	return false
+}
+
