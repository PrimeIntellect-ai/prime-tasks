+var some = path.join(modules, "some");
+var nestedOther = path.join(some, "node_modules", "other");
+var hoistedOther = path.join(modules, "other");
+fs.mkdirSync(some, {recursive: true});
+fs.mkdirSync(nestedOther, {recursive: true});
+fs.mkdirSync(hoistedOther, {recursive: true});
+fs.writeFileSync(path.join(root, "package.json"), JSON.stringify({
+name: "flat-lookup-test",
+version: "1.0.0",
+dependencies: {some: "1.0.0"}
+}));
+fs.writeFileSync(path.join(some, "package.json"), JSON.stringify({
+name: "some",
+version: "1.0.0",
+main: "main.js",
+dependencies: {other: "*"}
+}));
+fs.writeFileSync(path.join(some, "main.js"), 'module.exports.other = require("other").value;');
+fs.writeFileSync(path.join(nestedOther, "package.json"), JSON.stringify({
+name: "other",
+version: "1.0.0",
+main: "main.js"
+}));
+fs.writeFileSync(path.join(nestedOther, "main.js"), 'module.exports.value = "nested";');
+fs.writeFileSync(path.join(hoistedOther, "package.json"), JSON.stringify({
+name: "other",
+version: "1.0.0",
+main: "main.js"
+}));
+fs.writeFileSync(path.join(hoistedOther, "main.js"), 'module.exports.value = "hoisted";');
+
+var steal = makeSteal({config: path.join(root, "package.json") + "!npm"});
+steal.startup().then(function(){
+return steal.System.import("some");
+}).then(function(module){
+assert.equal(module.other, "hoisted");
+}).then(function(){
+fs.rmSync(root, {recursive: true, force: true});
+done();
+}, function(error){
+fs.rmSync(root, {recursive: true, force: true});
+done(error);
+});
+});
+
+	it("uses the nested algorithm when configured", function (done) {
+		var steal = makeSteal({
+			config: __dirname+"/nested-npm-algorithm/package.json!npm"
+		});
+		steal.startup().then(function(){
+			return steal.System.import("some");
+		}).then(function(module){
+			assert.equal(module.some, "some");
+			assert.equal(module.other, "other");
+		}).then(done, done);
+	});
+});
+
