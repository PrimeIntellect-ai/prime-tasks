+    @patch("pandasai.connectors.SqliteConnector._init_connection")
+    def test_two_connector_equal(self, mock_init_connection):
+        conn1 = SqliteConnector(self.config)
+
+        conn2 = SqliteConnector(self.config)
+
+        assert conn1.equals(conn2)
+
+        config2 = SqliteConnectorConfig(
+            dialect="sqlite", database="path_todb.db", table="different_table"
+        ).dict()
+        conn3 = SqliteConnector(config2)
+
+        assert conn1.equals(conn3)
+
+    def test_not_equal_to_non_sqlite_object_with_matching_configuration(self):
+        from types import SimpleNamespace
+
+        other = SimpleNamespace(
+            config=SimpleNamespace(
+                dialect=self.connector.config.dialect,
+                driver=self.connector.config.driver,
+                database=self.connector.config.database,
+            )
+        )
+
+        self.assertFalse(self.connector.equals(other))
+
+    @patch("pandasai.connectors.SqliteConnector._init_connection")
+    def test_two_connector_not_equal(self, mock_init_connection):
+        conn1 = SqliteConnector(self.config)
+
+        config2 = SqliteConnectorConfig(
+            dialect="sqlite", database="path_todb2.db", table="yourtable"
+        ).dict()
+        conn3 = SqliteConnector(config2)
+
+        assert not conn1.equals(conn3)
+
+    @patch("pandasai.connectors.SqliteConnector._init_connection")
+    def test_two_connector_not_equal_when_dialect_differs(self, mock_init_connection):
+        conn1 = SqliteConnector(self.config)
+
+        conn2 = SqliteConnector(self.config)
+        conn2.config.dialect = "mysql"
+
+        assert not conn1.equals(conn2)
+
+    @patch("pandasai.connectors.SqliteConnector._init_connection")
+    def test_two_connector_not_equal_when_driver_differs(self, mock_init_connection):
+        config1 = SqliteConnectorConfig(
+            dialect="sqlite",
+            database="path_todb.db",
+            table="yourtable",
+            driver="sqlite3",
+        ).dict()
+        config2 = SqliteConnectorConfig(
+            dialect="sqlite",
+            database="path_todb.db",
+            table="yourtable",
+            driver="pysqlite",
+        ).dict()
+
+        conn1 = SqliteConnector(config1)
+        conn2 = SqliteConnector(config2)
+
+        assert not conn1.equals(conn2)
+
+    @patch("pandasai.connectors.sql.pd.read_sql", autospec=True)
