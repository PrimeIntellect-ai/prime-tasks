+
+    return runTest {
+      fakeNetworkMonitor._isOnline.value = true
+
+      fakeNetworkMonitor.isOnline.test {
+        // The current state is observable
+        assertEquals(true, awaitItem())
+
+        // Going offline is observable
+        fakeNetworkMonitor._isOnline.value = false
+        assertEquals(false, awaitItem())
+
+        // Coming back online is observable
+        fakeNetworkMonitor._isOnline.value = true
+        assertEquals(true, awaitItem())
+      }
