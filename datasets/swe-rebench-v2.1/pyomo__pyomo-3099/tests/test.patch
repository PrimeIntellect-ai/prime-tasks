+    def test_linear_exprs_issue_3096(self):
+        from pyomo.contrib.mindtpy.tests.feasibility_pump1 import FeasPump1
+
+        from pyomo.core.expr.visitor import identify_variables
+
+        m = FeasPump1()
+        m.c1.pprint()
+        variables = list(identify_variables(m.c1.body))
+        symbolic = differentiate(
+            m.c1.body, wrt_list=variables, mode='reverse_symbolic'
+        )
+        for y1, y2 in ((0, 0), (0.5, 1.25), (2, -1)):
+            m.y1.value = y1
+            m.y2.value = y2
+            self.assertAlmostEqual(pyo.value(symbolic[0]), 2 * y1 - 1)
+            self.assertAlmostEqual(pyo.value(symbolic[1]), 2 * y2 - 1)
+
 
