diff --git a/src/test/java/crawlercommons/domains/EffectiveTldFinderTest.java b/src/test/java/crawlercommons/domains/EffectiveTldFinderTest.java
index 53b458e..4ecad0e 100644
--- a/src/test/java/crawlercommons/domains/EffectiveTldFinderTest.java
+++ b/src/test/java/crawlercommons/domains/EffectiveTldFinderTest.java
@@ -219,6 +219,34 @@ public class EffectiveTldFinderTest {
         // in strict mode: there should nothing be returned for invalid
         // hostnames
         assertNull(EffectiveTldFinder.getAssignedDomain("www..example..com", true, false));
+        // prohibited Unicode characters in internationalized domain name (IDN),
+        // test for #231): � (U+FFFD REPLACEMENT CHARACTER) is prohibited by
+        // RFC3490
+        // (1) in public suffix
+        assertNull(EffectiveTldFinder.getAssignedDomain("www.example.c\ufffdm", true, false));
+        // (1a) in wildcard part of a public suffix
+        assertNull(EffectiveTldFinder.getAssignedDomain("\ufffd.kawasaki.jp", true, false));
+        // Non-strict mode must fall back to the unmodified hostname rather than throw.
+        assertEquals("\ufffd.kawasaki.jp", EffectiveTldFinder.getAssignedDomain("\ufffd.kawasaki.jp", false, false));
+        // (2) in dot-separated segment immediately before public suffix
+        // => fail / null : there is no valid domain name
+        assertNull(EffectiveTldFinder.getAssignedDomain("www.ex\ufffdmple.com", true, false));
+        // Non-strict mode falls back to the original hostname when the
+        // registrable-domain label itself contains a prohibited character.
+        assertEquals("www.ex\ufffdmple.com",
+                EffectiveTldFinder.getAssignedDomain("www.ex\ufffdmple.com", false, false));
+        // Other prohibited IDN code points must also be handled without
+        // propagating IllegalArgumentException.
+        assertNull(EffectiveTldFinder.getAssignedDomain("www.ex\ufdd0mple.com", true, false));
+        assertEquals("www.ex\ufdd0mple.com",
+                EffectiveTldFinder.getAssignedDomain("www.ex\ufdd0mple.com", false, false));
+        // (3) in dot-separated segment not part of the effective TLD
+        // A prohibited label outside the assigned domain does not prevent
+        // determining the valid assigned domain.
+        String assigned = EffectiveTldFinder.getAssignedDomain("\ufffd.example.com", true, false);
+        assertEquals("example.com", assigned);
+        String fallback = EffectiveTldFinder.getAssignedDomain("\ufffd.example.com", false, false);
+        assertEquals("example.com", fallback);
     }
 
 }
