+#[test]
+fn panel_style_uses_most_left_and_right_cell_styles() {
+    let table = Table::new(&[(0, 1)])
+        .with(tabled::Panel("Numbers", 0))
+        .with(Style::modern())
+        .to_string();
+
+    let expected = concat!(
+        "┌───────────┐\n",
+        "│Numbers    │\n",
+        "├───────────┤\n",
+        "│ i32 │ i32 │\n",
+        "├─────┼─────┤\n",
+        "│  0  │  1  │\n",
+        "└─────┴─────┘\n",
+    );
+
+    assert_eq!(table, expected);
+}
+
+#[test]
+fn panel_style_uses_most_left_and_right_cell_styles_with_more_than_two_columns() {
+    let table = Table::new(&[(0, 1, 2)])
+        .with(tabled::Panel("Numbers", 0))
+        .with(Style::modern())
+        .to_string();
+
+    let expected = concat!(
+        "┌─────────────────┐\n",
+        "│Numbers          │\n",
+        "├─────────────────┤\n",
+        "│ i32 │ i32 │ i32 │\n",
+        "├─────┼─────┼─────┤\n",
+        "│  0  │  1  │  2  │\n",
+        "└─────┴─────┴─────┘\n",
+    );
+
+    assert_eq!(table, expected);
+}
