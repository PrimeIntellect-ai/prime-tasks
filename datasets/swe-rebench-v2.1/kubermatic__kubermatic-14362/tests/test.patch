+// parseINI returns the sections of a rendered cloud.conf keyed by their header
+// text (for example `LoadBalancerClass "public"`), with unquoted key/value pairs.
+func parseINI(t *testing.T, content string) map[string]map[string]string {
+	t.Helper()
+	sections := map[string]map[string]string{}
+	var current map[string]string
+	for _, line := range strings.Split(content, "\n") {
+		line = strings.TrimSpace(line)
+		switch {
+		case line == "" || strings.HasPrefix(line, ";") || strings.HasPrefix(line, "#"):
+			continue
+		case strings.HasPrefix(line, "[") && strings.HasSuffix(line, "]"):
+			current = map[string]string{}
+			sections[strings.TrimSpace(line[1:len(line)-1])] = current
+		case current != nil && strings.Contains(line, "="):
+			key, value, _ := strings.Cut(line, "=")
+			current[strings.TrimSpace(key)] = strings.Trim(strings.TrimSpace(value), `"`)
+		}
+	}
+	return sections
+}
+
+func TestOpenStackLoadBalancerClassesInCloudConfig(t *testing.T) {
+	dc := &kubermaticv1.Datacenter{}
+	if err := json.Unmarshal([]byte(`{
+		"spec": {
+			"openstack": {
+				"loadBalancerClasses": [
+					{"name": "public", "config": {"floatingNetworkID": "net-public", "floatingSubnetID": "subnet-public"}},
+					{"name": "restricted-public", "config": {"floatingSubnetID": "subnet-restricted"}},
+					{"name": "internal", "config": {"floatingSubnetID": "subnet-internal"}}
+				]
+			}
+		}
+	}`), dc); err != nil {
+		t.Fatalf("failed to parse datacenter spec: %v", err)
+	}
+
+	cluster := &kubermaticv1.Cluster{}
+	cluster.Spec.Cloud.Openstack = &kubermaticv1.OpenstackCloudSpec{}
+
+	cc := openstack.ForCluster(cluster, dc, resources.Credentials{})
+	cloudConfig, err := cc.String()
+	if err != nil {
+		t.Fatalf("failed to render cloud.conf: %v", err)
+	}
+
+	sections := parseINI(t, cloudConfig)
+	expected := map[string]map[string]string{
+		`LoadBalancerClass "public"`: {
+			"floating-network-id": "net-public",
+			"floating-subnet-id":  "subnet-public",
+		},
+		`LoadBalancerClass "restricted-public"`: {
+			"floating-subnet-id": "subnet-restricted",
+		},
+		`LoadBalancerClass "internal"`: {
+			"floating-subnet-id": "subnet-internal",
+		},
+	}
+
+	for header, settings := range expected {
+		section, ok := sections[header]
+		if !ok {
+			t.Errorf("cloud.conf has no [%s] section:\n%s", header, cloudConfig)
+			continue
+		}
+		for key, want := range settings {
+			assert.Equal(t, want, section[key], "[%s] %s", header, key)
+		}
+	}
+}
