+test("cli project name and version populate bom-ref", async () => {
+  const tmpDir = mkdtempSync(join(tmpdir(), "cdxgen-cli-"));
+  copyFileSync(
+    "./test/data/package-lock-v3.json",
+    join(tmpDir, "package-lock.json")
+  );
+  const outFile = join(tmpDir, "bom.json");
+  try {
+    execFileSync(
+      process.execPath,
+      [
+        "bin/cdxgen.js",
+        "-t",
+        "js",
+        "--no-babel",
+        "--project-name",
+        "cdxgen",
+        "--project-version",
+        "latest",
+        "-o",
+        outFile,
+        tmpDir
+      ],
+      { cwd: process.cwd(), stdio: "ignore" }
+    );
+    const bom = JSON.parse(readFileSync(outFile, "utf8"));
+    expect(bom.metadata.component.name).toEqual("cdxgen");
+    expect(bom.metadata.component.version).toEqual("latest");
+    expect(bom.metadata.component["bom-ref"]).toEqual("pkg:npm/cdxgen@latest");
+  } finally {
+    rmSync(tmpDir, { recursive: true, force: true });
+  }
 });
 
