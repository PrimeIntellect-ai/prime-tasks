+    @pytest.mark.parametrize("method", ["nlargest", "nsmallest"])
+    def test_nlargest_duplicate_index_performance(self, method):
+        # GH#55767
+        # Runtime should grow roughly linearly with length when the index
+        # contains many duplicate values, not quadratically.
+        def best_time(ser):
+            best = float("inf")
+            for _ in range(5):
+                start = time.perf_counter()
+                getattr(ser, method)()
+                best = min(best, time.perf_counter() - start)
+            return best
+
+        def dup_series(n):
+            return pd.Series(np.arange(n), index=[0] * n)
+
+        small, large = 5000, 20000
+        small_ser = dup_series(small)
+        large_ser = dup_series(large)
+
+        # warm up
+        getattr(small_ser, method)()
+        getattr(large_ser, method)()
+
+        small_time = best_time(small_ser)
+        large_time = best_time(large_ser)
+
+        # Quadrupling the length gives ~4x for linear and ~16x for quadratic
+        # growth; 10x separates the two while tolerating timing noise.
+        assert large_time < 10 * small_time
+
+        # Sanity check that the result values and original labels are preserved.
+        dup = dup_series(10000)
+        if method == "nlargest":
+            expected_values = np.arange(9999, 9994, -1)
+        else:
+            expected_values = np.arange(5)
+        expected = pd.Series(expected_values, index=[0] * 5)
+        tm.assert_series_equal(getattr(dup, method)(), expected)
+
