+test('next function is called with G and ctx', () => {
+  const flow = Flow({
+    phases: {
+      A: {
+        start: true,
+        next: (G, ctx) => (G.go && ctx.numPlayers === 3 ? 'C' : 'B'),
+      },
+      B: {},
+      C: {},
+    },
+  });
+
+  let state = { G: { go: true }, ctx: flow.ctx(3) } as State;
+  state = flow.processEvent(state, gameEvent('endPhase'));
+
+  expect(state.ctx.phase).toEqual('C');
+});
+
+test('next function returning undefined leaves no active phase', () => {
+  const flow = Flow({
+    phases: {
+      A: { start: true, next: () => undefined },
+      B: {},
+    },
+  });
+
+  let state = { ctx: flow.ctx(3) } as State;
+  state = flow.processEvent(state, gameEvent('endPhase'));
+
+  expect(state.ctx.phase).toBeFalsy();
+});
