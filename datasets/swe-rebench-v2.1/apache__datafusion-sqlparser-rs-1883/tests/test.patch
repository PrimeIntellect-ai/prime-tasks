+#[test]
+fn parse_create_table_cluster_by_expressions() {
+    // BigQuery `CLUSTER BY` without parentheses (NoWrapping) must accept
+    // full expressions, not just plain identifiers.
+    let sql = "CREATE TABLE mydataset.newtable (x INT64) CLUSTER BY my_func(x), y";
+    match bigquery().verified_stmt(sql) {
+        Statement::CreateTable(CreateTable { cluster_by, .. }) => {
+            assert_eq!(
+                Some(WrappedCollection::NoWrapping(vec![
+                    Expr::Function(Function {
+                        name: ObjectName::from(vec![Ident::new("my_func")]),
+                        uses_odbc_syntax: false,
+                        parameters: FunctionArguments::None,
+                        args: FunctionArguments::List(FunctionArgumentList {
+                            args: vec![FunctionArg::Unnamed(FunctionArgExpr::Expr(
+                                Expr::Identifier(Ident::new("x"))
+                            ))],
+                            duplicate_treatment: None,
+                            clauses: vec![],
+                        }),
+                        filter: None,
+                        null_treatment: None,
+                        over: None,
+                        within_group: vec![],
+                    }),
+                    Expr::Identifier(Ident::new("y")),
+                ])),
+                cluster_by
+            );
+        }
+        _ => unreachable!(),
+    }
+}
