+@pytest.mark.end_to_end()
+@pytest.mark.skipif(
+    sys.platform == "win32" and os.environ.get("CI") == "true",
+    reason="Windows does not pick up the right Python interpreter.",
+)
+def test_execute_tasks_multiple_times_via_api(tmp_path):
+    """See #625."""
+    source = """
+    from pathlib import Path
+    from typing_extensions import Annotated
+    from pytask import build, ExitCode, Product, task
+    import sys
+
+    @task
+    def task1(product: Annotated[Path, Product] = Path("artifact.txt")) -> None:
+        product.write_text("created")
+        with Path("calls.txt").open("a") as file:
+            file.write("called")
+
+    def task2() -> None: pass
+
+    if __name__ == "__main__":
+        session1 = build(tasks=[task1, task2])
+        session2 = build(tasks=[task1, task2])
+        assert session1.exit_code == ExitCode.OK
+        assert session2.exit_code == ExitCode.OK
+        assert Path("artifact.txt").read_text() == "created"
+        assert Path("calls.txt").read_text().splitlines() == ["called"]
+        sys.exit(session2.exit_code)
+    """
+    tmp_path.joinpath("task_module.py").write_text(textwrap.dedent(source))
+    result = subprocess.run(
+        ("python", tmp_path.joinpath("task_module.py").as_posix()),
+        cwd=tmp_path,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    assert result.returncode == ExitCode.OK
+    assert result.stdout.count("Summary") >= 2
+
+
