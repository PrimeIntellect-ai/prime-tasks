+func TestParsePatchHeaderReplyMarkerCleaning(t *testing.T) {
+	input := `From: Morton Haypenny <mhaypenny@example.com>
+Subject: Re: [PATCH] A sample commit to test header parsing
+
+`
+
+	tests := []struct {
+		name    string
+		options []PatchHeaderOption
+		title   string
+	}{
+		{
+			name:  "default removes reply marker",
+			title: "A sample commit to test header parsing",
+		},
+		{
+			name: "whitespace mode retains reply marker",
+			options: []PatchHeaderOption{
+				WithSubjectCleanMode(SubjectCleanWhitespace),
+			},
+			title: "Re: [PATCH] A sample commit to test header parsing",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			header, err := ParsePatchHeader(input, test.options...)
+			if err != nil {
+				t.Fatalf("parsing patch header: %v", err)
+			}
+			if header.Title != test.title {
+				t.Errorf("unexpected title: want %q, got %q", test.title, header.Title)
+			}
+		})
+	}
+}
