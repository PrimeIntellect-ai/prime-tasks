+test('registered Error allowlists apply only to that error class', () => {
+  class UsernameTakenError extends Error {
+    suggestedUserName: string;
+    privateToken: string;
+
+    constructor(suggestedUserName: string) {
+      super('Username is taken');
+      this.name = 'UsernameTakenError';
+      Object.setPrototypeOf(this, UsernameTakenError.prototype);
+      this.suggestedUserName = suggestedUserName;
+      this.privateToken = 'do-not-serialize';
+    }
+  }
+
+  class AnotherError extends Error {
+    suggestedUserName: string;
+
+    constructor(suggestedUserName: string) {
+      super('A different failure');
+      Object.setPrototypeOf(this, AnotherError.prototype);
+      this.suggestedUserName = suggestedUserName;
+    }
+  }
+
+  SuperJSON.registerClass(UsernameTakenError, {
+    allowProps: ['suggestedUserName'],
+  });
+
+  const parsed: any = SuperJSON.parse(
+    SuperJSON.stringify({
+      registered: new UsernameTakenError('available-name'),
+      other: new AnotherError('sensitive-name'),
+    })
+  );
+
+  expect(parsed.registered).toBeInstanceOf(UsernameTakenError);
+  expect(parsed.registered.suggestedUserName).toBe('available-name');
+  expect(parsed.registered.privateToken).toBeUndefined();
+  expect(parsed.other).toBeInstanceOf(Error);
+  expect(parsed.other.suggestedUserName).toBeUndefined();
+});
+
