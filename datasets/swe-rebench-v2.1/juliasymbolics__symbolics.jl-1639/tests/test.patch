+@testset "get_differential_vars" begin
+    @variables t x u(x, t) v(t)
+    Dt = Differential(t)
+    Dx = Differential(x)
+
+    # Expressions without differentials have no differential terms.
+    @test isempty(Symbolics.get_differential_vars(u + v + x))
+
+    # Differential terms are found in sums and under other operations.
+    expr = Dx(u) + Dt(u) + sin(Dt(v))
+    diff_vars = Symbolics.get_differential_vars(expr)
+    @test any(x -> isequal(Symbolics.value(x), Symbolics.value(Dt(u))), diff_vars)
+    @test any(x -> isequal(Symbolics.value(x), Symbolics.value(Dx(u))), diff_vars)
+    @test any(x -> isequal(Symbolics.value(x), Symbolics.value(Dt(v))), diff_vars)
+
+    # Both the outer and inner terms of a nested differential are found.
+    nested = Dx(Dt(u)) + u
+    nested_diff_vars = Symbolics.get_differential_vars(nested)
+    @test any(x -> isequal(Symbolics.value(x), Symbolics.value(Dx(Dt(u)))), nested_diff_vars)
+    @test any(x -> isequal(Symbolics.value(x), Symbolics.value(Dt(u))), nested_diff_vars)
+
+    # A Num-wrapped expression is also inspected.
+    wrapped = Num(Dt(u)) + Num(u)
+    wrapped_diff_vars = Symbolics.get_differential_vars(wrapped)
+    @test any(x -> isequal(Symbolics.value(x), Symbolics.value(Dt(u))), wrapped_diff_vars)
+end
