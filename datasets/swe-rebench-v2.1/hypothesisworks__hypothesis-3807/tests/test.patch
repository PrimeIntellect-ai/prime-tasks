@@ -89,3 +89,21 @@ def test_cannot_infer(c):
 def test_cannot_infer_takes_self():
     with pytest.raises(ResolutionFailed):
         st.builds(Inferrables, has_default_factory_takes_self=...).example()
+
+
+@attr.s
+class HasPrivateAttribute:
+    _x: int = attr.ib()
+
+
+@pytest.mark.parametrize("s", [st.just(42), ...])
+def test_private_attribute(s):
+    st.builds(HasPrivateAttribute, x=s).example()
+
+
+def test_private_attribute_inferred():
+    # The constructor exposes the private attribute as ``x`` (attrs strips the
+    # leading underscore), so builds() must infer a strategy for it.
+    obj = st.builds(HasPrivateAttribute).example()
+    assert isinstance(obj, HasPrivateAttribute)
+    assert isinstance(obj._x, int)
