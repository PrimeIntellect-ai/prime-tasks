+def test_compression_gzip():
+    from moto.moto_server.werkzeug_app import create_backend_app
+
+    request_body = gzip_compress(data=b"{}")
+    app = create_backend_app("dynamodb")
+    response = app.test_client().post(
+        "/",
+        data=request_body,
+        headers={
+            "Content-Encoding": "gzip",
+            "Content-Type": "application/x-amz-json-1.0",
+            "X-Amz-Target": "DynamoDB_20120810.ListTables",
+        },
+    )
+
+    assert response.status_code == 200
+    assert json.loads(response.get_data(as_text=True)) == {"TableNames": []}
+
+
+def test_compression_gzip_in_s3():
+    body = b"some random data"
+    request = AWSPreparedRequest(
+        "GET",
+        url="http://request",
+        headers={"Content-Encoding": "gzip"},
+        body=body,
+        stream_output=False,
+    )
+    response = S3Response()
+    response.setup_class(request, request.url, request.headers)
+
+    actual = response.body
+    if isinstance(actual, str):
+        actual = actual.encode("utf-8")
+    assert actual == body
