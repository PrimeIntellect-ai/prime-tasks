new file mode 100644
index 0000000..ed7e098
--- /dev/null
+++ b/src/shared/packages.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, it, vi } from "vitest";
+
+import { uninstallPackages } from "../steps/uninstallPackages.js";
+
+const mockExecaCommand = vi.fn();
+const mockShellCommand = vi.fn().mockResolvedValue(undefined);
+
+vi.mock("execa", () => ({
+	$: (...arguments_: unknown[]) => mockShellCommand(...arguments_),
+	get execaCommand() {
+		return mockExecaCommand;
+	},
+}));
+
+vi.mock("./packages.js", async (importOriginal) => {
+	const actual = await importOriginal<typeof import("./packages.js")>();
+
+	return {
+		...actual,
+		readPackageData: async () => ({
+			dependencies: {},
+			devDependencies: {},
+		}),
+	};
+});
+
+describe("initialization package cleanup", () => {
+	it("does not run a bare removal command when no initialization-only packages are present", async () => {
+		await uninstallPackages();
+
+		const commands = [
+			...mockExecaCommand.mock.calls.map(([command]) => command),
+			...mockShellCommand.mock.calls.map(([template, ...values]) =>
+				(template as TemplateStringsArray)
+					.reduce(
+						(command, segment, index) =>
+							`${command}${segment}${values[index] ?? ""}`,
+						"",
+					)
+					.replace(/\s+/g, " ")
+					.trim(),
+			),
+		];
+		const removalCommands = commands.filter((command) =>
+			command.startsWith("pnpm remove"),
+		);
+
+		expect(
+			removalCommands.every((command) =>
+				command
+					.trim()
+					.split(/\s+/)
+					.slice(2)
+					.some((argument) => !argument.startsWith("-")),
+			),
+		).toBe(true);
+	});
+});
