diff --git a/test/time_input_test.test.js b/test/time_input_test.test.js
index ee3c73c..5bcf056 100644
--- a/test/time_input_test.test.js
+++ b/test/time_input_test.test.js
@@ -69,4 +69,54 @@ describe("timeInput", () => {
       new Date(new Date().setHours(14, 0, 0, 0)),
     );
   });
+
+  it("should preserve the selected date when the time input changes", () => {
+    const mockOnChange = jest.fn();
+    const selectedDate = new Date(2023, 8, 30, 9, 15);
+    const datePicker = mount(
+      <DatePicker
+        inline
+        showTimeInput
+        selected={selectedDate}
+        onChange={mockOnChange}
+      />,
+    );
+
+    datePicker.find(InputTimeComponent).find("input").simulate("change", {
+      target: { value: "13:00" },
+    });
+
+    expect(mockOnChange).toHaveBeenCalled();
+    const changedDate = mockOnChange.mock.calls[0][0];
+    expect(changedDate.getFullYear()).toBe(selectedDate.getFullYear());
+    expect(changedDate.getMonth()).toBe(selectedDate.getMonth());
+    expect(changedDate.getDate()).toBe(selectedDate.getDate());
+    expect(changedDate.getHours()).toBe(13);
+    expect(changedDate.getMinutes()).toBe(0);
+  });
+
+  it("should trigger onChange event with the default date when date prop is missing", () => {
+    const mockOnChange = jest.fn();
+    const mockCurrentDate = new Date("2023-09-30");
+    const dateSpy = jest
+      .spyOn(global, "Date")
+      .mockImplementation(() => mockCurrentDate);
+
+    const timeComponent = shallow(
+      <InputTimeComponent onChange={mockOnChange} />,
+    );
+
+    const newTime = "13:00";
+    const input = timeComponent.find("input");
+    input.simulate("change", { target: { value: newTime } });
+
+    const expectedDate = new Date(mockCurrentDate);
+    const [expectedHours, expectedMinutes] = newTime.split(":");
+    expectedDate.setHours(expectedHours);
+    expectedDate.setMinutes(expectedMinutes);
+
+    expect(mockOnChange).toHaveBeenCalledWith(expectedDate);
+
+    dateSpy.mockRestore();
+  });
 });
