+
+class TestBitness:
+    def teardown_method(self):
+        importlib.reload(tags)
+
+    @pytest.mark.parametrize(
+        "platform_name, expected_tag, wrong_tag",
+        [
+            ("linux_x86_64", "linux_x86_64", "linux_i686"),
+            ("linux_aarch64", "linux_aarch64", "linux_armv8l"),
+        ],
+    )
+    def test_64_bit_graalpy_platform_tags(
+        self, platform_name, expected_tag, wrong_tag, monkeypatch
+    ):
+        real_calcsize = struct.calcsize
+
+        def calcsize(fmt):
+            if fmt == "P":
+                return 8
+            return real_calcsize(fmt)
+
+        monkeypatch.setattr(sys.implementation, "name", "graalpy")
+        monkeypatch.setattr(sys, "maxsize", 2147483647)
+        monkeypatch.setattr(struct, "calcsize", calcsize)
+        monkeypatch.setattr(platform, "system", lambda: "Linux")
+        monkeypatch.setattr(sysconfig, "get_platform", lambda: platform_name)
+        monkeypatch.setattr(os, "confstr", lambda x: "glibc 2.20", raising=False)
+        monkeypatch.setattr(tags._manylinux, "_is_compatible", lambda *args: False)
+        importlib.reload(tags)
+
+        platforms = list(tags.platform_tags())
+        assert expected_tag in platforms
+        assert wrong_tag not in platforms
