 public class DecimalTest {
@@ -20,4 +21,61 @@ public class DecimalTest {
 
         assertEquals(decimalFromString.multipliedBy(decimalFromDouble), decimalFromDouble.multipliedBy(decimalFromString));
     }
+
+    @Test
+    public void testValueOfBigDecimalPreservesExactValue(){
+        BigDecimal value = new BigDecimal("10.123456789123456789123456789");
+        Decimal decimal = Decimal.valueOf(value);
+
+        // The wrapped value must be preserved exactly, without loss of precision.
+        assertEquals(value, decimal.getDelegate());
+        assertEquals(0, value.compareTo(decimal.getDelegate()));
+    }
+
+    @Test
+    public void testValueOfBigDecimalKeepsScale(){
+        BigDecimal value = new BigDecimal("1.2300");
+        Decimal decimal = Decimal.valueOf(value);
+
+        // The exact BigDecimal (including its scale) is preserved.
+        assertEquals(value, decimal.getDelegate());
+        assertEquals(value.scale(), decimal.getDelegate().scale());
+    }
+
+    @Test
+    public void testGetDelegateReturnsUnderlyingBigDecimal(){
+        BigDecimal value = BigDecimal.valueOf(10);
+        Decimal decimal = Decimal.valueOf(value);
+
+        // getDelegate() exposes the BigDecimal backing this Decimal.
+        assertEquals(value, decimal.getDelegate());
+        assertEquals(0, value.compareTo(decimal.getDelegate()));
+    }
+
+    @Test
+    public void testDecimalToBigDecimalConversion(){
+        BigDecimal value = new BigDecimal("42.424242424242424242424242");
+        Decimal decimal = Decimal.valueOf(value);
+
+        // Converting a Decimal back to a BigDecimal yields the exact original value.
+        BigDecimal converted = decimal.getDelegate();
+        assertEquals(value, converted);
+        assertEquals(0, value.compareTo(converted));
+    }
+
+    @Test
+    public void testBigDecimalArithmetic(){
+        BigDecimal ten = BigDecimal.valueOf(10);
+        Decimal decimalTen = Decimal.valueOf(ten);
+        Decimal zero = decimalTen.minus(Decimal.valueOf(BigDecimal.valueOf(10)));
+
+        BigDecimal tenPlaces = BigDecimal.valueOf(10.1234567891);
+        Decimal tenPlacesDecimal = Decimal.valueOf(tenPlaces);
+
+        assertDecimalEquals(zero, 0);
+
+        assertEquals(tenPlaces, tenPlacesDecimal.getDelegate());
+        assertEquals(tenPlaces.multiply(ten), decimalTen.multipliedBy(tenPlacesDecimal).getDelegate()); // BigDecimal = BigDecimal
+        assertEquals(Decimal.valueOf(tenPlaces.multiply(ten)), decimalTen.multipliedBy(tenPlacesDecimal)); // Decimal = Decimal
+    }
 }
