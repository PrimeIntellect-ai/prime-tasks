index 0000000..c4eb12f
--- /dev/null
+++ b/tests/issues/issue-447/issue-447.test.ts
@@ -0,0 +1,32 @@
+import { compareFiles } from 'tests/common';
+import { describe, expect, it } from 'vitest';
+
+/**
+ * Removes whitespace inside interpolation constructs (`#[...]` and `#{...}`)
+ * so that collapsing whitespace inside an interpolation is not penalised.
+ * Whitespace between constructs is left untouched, so it is still compared.
+ *
+ * @param text Formatted Pug text.
+ * @returns The text with whitespace inside interpolations removed.
+ */
+function ignoreInnerInterpolationSpaces(text: string): string {
+  return text
+    .split('\n')
+    .map((line) =>
+      line
+        .replace(/#\[[^\]]*\]/g, (match) => match.replace(/\s+/g, ''))
+        .replace(/#\{[^}]*\}/g, (match) => match.replace(/\s+/g, '')),
+    )
+    .join('\n');
+}
+
+describe('Issues', () => {
+  it('preserves whitespace between interpolations', () => {
+    const { actual, expected } = compareFiles(__dirname);
+
+    expect(expected).not.toBeNull();
+    expect(ignoreInnerInterpolationSpaces(actual)).toBe(
+      ignoreInnerInterpolationSpaces(expected as string),
+    );
+  });
+});
