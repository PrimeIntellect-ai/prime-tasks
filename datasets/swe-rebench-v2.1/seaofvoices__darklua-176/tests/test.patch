+fn apply_rule_with_tokens(input: &str) -> String {
+    use darklua_core::generator::{LuaGenerator, TokenBasedLuaGenerator};
+    use darklua_core::rules::ContextBuilder;
+    use darklua_core::Parser;
+
+    let mut block = Parser::default()
+        .preserve_tokens()
+        .parse(input)
+        .expect("input should parse");
+
+    let resources = darklua_core::Resources::from_memory();
+    resources.write("src/test.lua", input).unwrap();
+    let context = ContextBuilder::new("src/test.lua", &resources, input).build();
+
+    RemoveCompoundAssignment::default()
+        .process(&mut block, &context)
+        .expect("rule should succeed");
+
+    let mut generator = TokenBasedLuaGenerator::new(input);
+    generator.write_block(&block);
+    generator.into_string()
+}
+
+#[test]
+fn keeps_comments_inside_compound_assignments() {
+    for (input, comment) in [
+        ("i += 1 -- comment", "-- comment"),
+        ("\ni += 1 -- comment", "-- comment"),
+        ("i += --[[ comment ]] 1", "--[[ comment ]]"),
+        ("i --[[ comment ]] += 1", "--[[ comment ]]"),
+    ] {
+        let output = apply_rule_with_tokens(input);
+        assert_eq!(
+            output.matches(comment).count(),
+            1,
+            "comment `{}` should appear exactly once for input `{}`, output:\n{}",
+            comment,
+            input,
+            output
+        );
+    }
+}
+
+#[test]
+fn does_not_copy_newlines_inside_compound_assignments() {
+    let input = "\ni += 1 -- comment";
+    let output = apply_rule_with_tokens(input);
+    assert_eq!(
+        output.lines().count(),
+        input.lines().count(),
+        "no newline should be copied, output:\n{}",
+        output
+    );
+}
+
+#[test]
+fn does_not_copy_comments_or_newlines_from_preceding_statements() {
+    let input = "local x = 0\nx += 1-- this is ok\n\nlocal y = 0\nprint(y) \ny += 1-- this is ok\n\n\nlocal y = 0\n\ny += 1-- one newline appears\n\nlocal z = 0\n--duplicate\nz += 1--it copies the comments\n\nlocal a = 0\n--copies\n--all\n--comments\n\n--in between\na += 1";
+
+    let output = apply_rule_with_tokens(input);
+
+    for comment in ["--duplicate", "--copies", "--all", "--comments", "--in between"] {
+        assert_eq!(
+            output.matches(comment).count(),
+            1,
+            "comment `{}` should not be copied, output:\n{}",
+            comment,
+            output
+        );
+    }
+
+    assert_eq!(
+        output.lines().count(),
+        input.lines().count(),
+        "no newline should be copied, output:\n{}",
+        output
+    );
+
+    use darklua_core::nodes::{BinaryOperator, Expression, Statement, Variable};
+    use darklua_core::Parser;
+    let output_block = Parser::default()
+        .parse(&output)
+        .expect("rewritten output should parse");
+    let is_expected_assignment = matches!(
+        output_block.iter_statements().last(),
+        Some(Statement::Assign(assign))
+            if matches!(assign.get_variables().first(), Some(Variable::Identifier(identifier)) if identifier.get_name() == "a")
+                && matches!(
+                    assign.last_value(),
+                    Some(Expression::Binary(binary))
+                        if binary.operator() == BinaryOperator::Plus
+                            && matches!(binary.left(), Expression::Identifier(identifier) if identifier.get_name() == "a")
+                            && matches!(binary.right(), Expression::Number(number) if number.compute_value() == 1.0)
+                )
+    );
+    assert!(
+        is_expected_assignment,
+        "the final compound assignment should become a = a + 1, output:\n{}",
+        output
+    );
+}
