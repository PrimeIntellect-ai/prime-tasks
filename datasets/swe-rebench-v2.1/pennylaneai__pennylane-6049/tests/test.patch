+def test_center_dla_linear_combination():
+    """Test the motivating example from the problem statement, in which the center
+    element is a linear combination of the DLA basis elements."""
+    dla = qml.lie_closure(
+        [qml.X(0), qml.X(1), qml.X(0) @ qml.X(1) + qml.Y(0) @ qml.Y(1) + qml.Z(0) @ qml.Z(1)]
+    )
+    res = center(dla)
+    assert len(res) > 0
+    # X(0) + X(1) lies in the span of the returned center
+    vspace = qml.pauli.PauliVSpace(res)
+    assert not vspace.is_independent((qml.X(0) + qml.X(1)).pauli_rep)
