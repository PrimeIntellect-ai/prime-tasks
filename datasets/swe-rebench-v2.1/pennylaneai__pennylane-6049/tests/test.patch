+def assert_same_span(actual, expected):
+    """Assert that two sets of operators span the same Pauli space."""
+    actual_space = qml.pauli.PauliVSpace(actual)
+    expected_space = qml.pauli.PauliVSpace(expected)
+    assert len(actual_space) == len(expected_space)
+    if len(actual_space):
+        assert actual_space == expected_space
 
 
