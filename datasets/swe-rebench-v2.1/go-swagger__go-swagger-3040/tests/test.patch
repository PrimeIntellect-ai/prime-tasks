+func TestGenerateServerOpsImportPathsWithClientTagGroup(t *testing.T) {
+	tmp := t.TempDir()
+	spec := filepath.Join(tmp, "swagger.yaml")
+	contents := `swagger: "2.0"
+info:
+  title: import-paths
+  version: "1.0"
+paths:
+  /client:
+    get:
+      operationId: getClientItem
+      tags: [client]
+      responses:
+        "200":
+          description: success
+  /budgets:
+    get:
+      operationId: getBudgetItem
+      tags: [budgets]
+      responses:
+        "200":
+          description: success
+`
+	require.NoError(t, os.WriteFile(spec, []byte(contents), 0o600))
+
+	opts := testGenOpts()
+	opts.Spec = spec
+	opts.Target = filepath.Join(tmp, "server")
+	require.NoError(t, os.MkdirAll(opts.Target, 0o700))
+	require.NoError(t, os.WriteFile(filepath.Join(opts.Target, "go.mod"), []byte("module example.com/import-paths\n\ngo 1.17\n"), 0o600))
+	opts.MainPackage = "testserver"
+	require.NoError(t, GenerateServer("", nil, nil, opts))
+
+	apiFiles, err := filepath.Glob(filepath.Join(opts.Target, defaultServerTarget, defaultOperationsTarget, "*_api.go"))
+	require.NoError(t, err)
+	require.NotEmpty(t, apiFiles)
+
+	var generated string
+	for _, filename := range apiFiles {
+		data, readErr := os.ReadFile(filename)
+		require.NoError(t, readErr)
+		generated += string(data)
+	}
+	assert.Contains(t, generated, "/restapi/operations/client")
+	assert.Contains(t, generated, "/restapi/operations/budgets")
+}
+
