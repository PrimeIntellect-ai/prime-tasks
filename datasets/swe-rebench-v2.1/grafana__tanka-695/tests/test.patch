+// TestApplyServerSide exercises the requested feature through Tanka's apply
+// workflow: `tk apply --server-side` must reach `kubectl apply --server-side`.
+func TestApplyServerSide(t *testing.T) {
+	log := fakeKubectl(t)
+
+	dir := t.TempDir()
+	writeFile(t, filepath.Join(dir, "jsonnetfile.json"), `{}`)
+	writeFile(t, filepath.Join(dir, "main.jsonnet"), `{
+  apiVersion: 'v1',
+  kind: 'ConfigMap',
+  metadata: { name: 'config' },
+}`)
+	writeFile(t, filepath.Join(dir, "spec.json"), `{
+  "apiVersion": "tanka.dev/v1alpha1",
+  "kind": "Environment",
+  "metadata": { "name": "test" },
+  "spec": { "apiServer": "https://localhost", "namespace": "test" }
+}`)
+
+	if err := tanka.Apply(dir, tanka.ApplyOpts{AutoApprove: true, ServerSide: true}); err != nil {
+		t.Fatal(err)
+	}
+
+	args := lastCall(t, log, "apply")
+	if !sets.NewString(args...).Has("--server-side") {
+		t.Errorf("kubectl apply args = %v missing --server-side", args)
+	}
+}
