+// fakeKubectl installs a fake `kubectl` executable that records every
+// invocation and answers the subcommands Tanka relies on. It returns the path
+// of the recorded call log.
+func fakeKubectl(t *testing.T) string {
+	t.Helper()
+
+	dir := t.TempDir()
+	log := filepath.Join(dir, "calls.log")
+	bin := filepath.Join(dir, "kubectl")
+
+	script := `#!/bin/sh
+printf '%s\n' "$*" >> "` + log + `"
+case "$1" in
+config)
+  printf '%s' '{"clusters":[{"name":"fake","cluster":{"server":"https://localhost"}}],"contexts":[{"name":"foo-context","context":{"cluster":"fake","user":"fake","namespace":"default"}}],"current-context":"foo-context"}'
+  ;;
+version)
+  printf '%s' '{"clientVersion":{"gitVersion":"v1.20.0"},"serverVersion":{"gitVersion":"v1.20.0"}}'
+  ;;
+get)
+  printf '%s' '{"apiVersion":"v1","kind":"List","items":[{"metadata":{"name":"test"}}]}'
+  ;;
+api-resources)
+  printf '%s\n' 'NAME                                SHORTNAMES                             APIVERSION                             NAMESPACED   KIND' 'configmaps                          cm                                     v1                                     true         ConfigMap'
+  ;;
+esac
+exit 0
+`
+	if err := os.WriteFile(bin, []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("TANKA_KUBECTL_PATH", bin)
+	return log
+}
+
+// kubectlCalls returns the recorded kubectl invocations, each split into its
+// individual arguments.
+func kubectlCalls(t *testing.T, log string) [][]string {
+	t.Helper()
+
+	raw, err := os.ReadFile(log)
+	if err != nil {
+		t.Fatal(err)
 	}
 
-	type args struct {
-		data manifest.List
-		opts ApplyOpts
+	var calls [][]string
+	for _, line := range strings.Split(strings.TrimSpace(string(raw)), "\n") {
+		if strings.TrimSpace(line) == "" {
+			continue
+		}
+		calls = append(calls, strings.Fields(line))
+	}
+	return calls
+}
+
+// lastCall returns the arguments of the last recorded invocation of the given
+// kubectl subcommand.
+func lastCall(t *testing.T, log, subcommand string) []string {
+	t.Helper()
+
+	var found []string
+	for _, c := range kubectlCalls(t, log) {
+		if len(c) > 0 && c[0] == subcommand {
+			found = c
+		}
+	}
+	if found == nil {
+		t.Fatalf("no %q invocation recorded in %s", subcommand, log)
+	}
+	return found
+}
+
+func writeFile(t *testing.T, path, content string) {
+	t.Helper()
+	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+		t.Fatal(err)
 	}
+}
