+function test_print_omit_vector()
+    n = 100
+    model = Model()
+    @variable(model, x[1:n, 1:n])
+    @constraint(model, vec(x) >= 0)
+    output = sprint(print, model)
+    number_of_terms = sum(
+        occursin(string("x[", i, ",", j, "]"), output) for i in 1:n, j in 1:n
+    )
+    @test number_of_terms < n^2
+    return
+end
+
 end  # TestPrint
