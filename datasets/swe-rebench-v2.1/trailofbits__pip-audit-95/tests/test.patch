+def get_sdist_mock(name="Flask", version="2.0.1"):
+    # A well-formed gzipped tarball whose single top-level directory holds a minimal project.
+    archive = BytesIO()
+    with tarfile.open(fileobj=archive, mode="w:gz") as t:
+        top = f"{name}-{version}"
+        files = {
+            f"{top}/PKG-INFO": f"Metadata-Version: 2.1\nName: {name}\nVersion: {version}\n",
+            f"{top}/setup.py": (
+                "from setuptools import setup\n"
+                f"setup(name={name!r}, version={version!r})\n"
+            ),
+        }
+        for path, content in files.items():
+            data = content.encode()
+            info = tarfile.TarInfo(path)
+            info.size = len(data)
+            t.addfile(info, BytesIO(data))
+    return get_package_mock(archive.getvalue())
+
+
