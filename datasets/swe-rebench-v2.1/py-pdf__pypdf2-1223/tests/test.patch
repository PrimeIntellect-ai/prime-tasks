+def test_merge_page_with_octal_escape_before_string_delimiter():
+    source_writer = PdfWriter()
+    source_page = source_writer.add_blank_page(width=100, height=100)
+    content = DecodedStreamObject()
+    content.set_data(b"BT (\\1) Tj ET")
+    source_page[NameObject("/Contents")] = content
+
+    source_pdf = BytesIO()
+    source_writer.write(source_pdf)
+    source_pdf.seek(0)
+    source_page = PdfReader(source_pdf).pages[0]
+
+    merged_writer = PdfWriter()
+    merged_page = merged_writer.add_blank_page(width=100, height=100)
+    merged_page.merge_page(source_page)
+
+    merged_pdf = BytesIO()
+    merged_writer.write(merged_pdf)
+    merged_pdf.seek(0)
+    assert len(PdfReader(merged_pdf).pages) == 1
 
 
