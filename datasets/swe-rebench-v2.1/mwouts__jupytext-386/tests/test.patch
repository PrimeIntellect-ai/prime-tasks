+
+
+@requires_nbconvert
+def test_execute_in_subfolder(tmpdir):
+    tmpdir.mkdir('subfolder')
+
+    tmp_csv = str(tmpdir.join('subfolder', 'inputs.csv'))
+    tmp_py = str(tmpdir.join('subfolder', 'notebook.py'))
+    tmp_ipynb = str(tmpdir.join('subfolder', 'notebook.ipynb'))
+
+    with open(tmp_csv, 'w') as fp:
+        fp.write("1\n2\n")
+
+    with open(tmp_py, 'w') as fp:
+        fp.write("""import ast
+
+with open('inputs.csv') as fp:
+    text = fp.read()
+
+sum(ast.literal_eval(line) for line in text.splitlines())
+""")
+
+    jupytext(args=[tmp_py, '--to', 'ipynb', '--execute'])
+
+    nb = read(tmp_ipynb)
+    assert any(output.get('data', {}).get('text/plain') == '3'
+               for cell in nb.cells for output in cell.outputs)
+
+
+@requires_nbconvert
+def test_execute_existing_ipynb_in_subfolder(tmpdir):
+    tmpdir.mkdir('subfolder')
+
+    tmp_csv = str(tmpdir.join('subfolder', 'inputs.csv'))
+    tmp_py = str(tmpdir.join('subfolder', 'notebook.py'))
+    tmp_ipynb = str(tmpdir.join('subfolder', 'notebook.ipynb'))
+
+    with open(tmp_csv, 'w') as fp:
+        fp.write("1\n2\n")
+
+    with open(tmp_py, 'w') as fp:
+        fp.write("""import ast
+
+with open('inputs.csv') as fp:
+    text = fp.read()
+
+sum(ast.literal_eval(line) for line in text.splitlines())
+""")
+
+    # Create the notebook first, then execute that existing .ipynb file.
+    jupytext(args=[tmp_py, '--to', 'ipynb'])
+    jupytext(args=[tmp_ipynb, '--execute'])
+
+    nb = read(tmp_ipynb)
+    assert any(output.get('data', {}).get('text/plain') == '3'
+               for cell in nb.cells for output in cell.outputs)
