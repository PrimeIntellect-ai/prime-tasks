diff --git a/Tests/SpyableMacroTests/Macro/UT_SpyableMacro.swift b/Tests/SpyableMacroTests/Macro/UT_SpyableMacro.swift
index b84fe3c..8106952 100644
--- a/Tests/SpyableMacroTests/Macro/UT_SpyableMacro.swift
+++ b/Tests/SpyableMacroTests/Macro/UT_SpyableMacro.swift
@@ -1,3 +1,6 @@
+import SwiftParser
+import SwiftSyntax
+import SwiftSyntaxMacroExpansion
 import SwiftSyntaxMacros
 import SwiftSyntaxMacrosTestSupport
 import XCTest
@@ -207,4 +210,39 @@ final class UT_SpyableMacro: XCTestCase {
       macros: sut
     )
   }
+
+  func testSpyableFlagIsHonoredAfterOtherAttributes() {
+    let source = Parser.parse(source: """
+      @MainActor
+      @available(*, deprecated)
+      @Spyable(behindPreprocessorFlag: "CUSTOM")
+      public protocol ServiceProtocol {
+          var variable: Bool? { get set }
+      }
+      """)
+    let context = BasicMacroExpansionContext(
+      sourceFiles: [source: .init(moduleName: "TestModule", fullFilePath: "test.swift")]
+    )
+    let expanded = source.expand(macros: sut, in: context)
+    func syntaxContainsSpy(_ node: Syntax) -> Bool {
+      if let declaration = node.as(ClassDeclSyntax.self), declaration.name.text == "ServiceProtocolSpy" {
+        return true
+      }
+      return node.children(viewMode: .all).contains(where: syntaxContainsSpy)
+    }
+    func clauses(in node: Syntax) -> [IfConfigClauseSyntax] {
+      let current = node.as(IfConfigClauseSyntax.self).map { [$0] } ?? []
+      return current + node.children(viewMode: .all).flatMap(clauses)
+    }
+
+    let guardedSpyExists = clauses(in: Syntax(expanded)).contains { clause in
+      guard clause.condition?.description.trimmingCharacters(in: CharacterSet.whitespacesAndNewlines) == "CUSTOM",
+            let elements = clause.elements else {
+        return false
+      }
+      return syntaxContainsSpy(elements._syntaxNode)
+    }
+
+    XCTAssertTrue(guardedSpyExists)
+  }
 }
