+#[test]
+fn nested_record_update_with_blocks() {
+    // A block expression containing a singular record update used to be
+    // compiled to invalid Erlang (a parenthesised comma sequence). The
+    // generated Erlang must be valid, so we compile it with `erlc` rather
+    // than pinning an exact textual representation.
+    let src = "pub type A { A(b: B) }
+pub type B { B(c: C) }
+pub type C { C(val: Int) }
+
+pub fn main(a: A) {
+    A(..a, b: {
+        B(..a.b, c: {
+            C(..a.b.c, val: 0)
+        })
+    })
+}";
+    let compiled = super::compile_test_project(
+        src,
+        "/root/project/test/my/mod.gleam",
+        None,
+    );
+
+    let dir = std::env::temp_dir().join(format!(
+        "gleam_nested_record_update_with_blocks_{}",
+        std::process::id()
+    ));
+    std::fs::create_dir_all(&dir).expect("should create temp dir");
+    let file = dir.join("my@mod.erl");
+    std::fs::write(&file, &compiled).expect("should write generated erlang");
+
+    let output = std::process::Command::new("erlc")
+        .arg("-o")
+        .arg(&dir)
+        .arg(&file)
+        .output()
+        .expect("erlc should be available");
+
+    assert!(
+        output.status.success(),
+        "generated Erlang is not valid:\n{}\n--- erlc stderr ---\n{}",
+        compiled,
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
