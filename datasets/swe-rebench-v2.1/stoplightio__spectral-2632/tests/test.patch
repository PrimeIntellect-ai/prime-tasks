@@ -0,0 +1,105 @@
+import { DiagnosticSeverity } from '@stoplight/types';
+import { Spectral, RulesetDefinition } from '@stoplight/spectral-core';
+import { httpAndFileResolver } from '@stoplight/spectral-ref-resolver';
+import oasRuleset from '../index';
+
+const message = 'Schemas with "type: array", require a sibling "items" field';
+
+async function arrayDiagnostics(document: Record<string, unknown>) {
+  const spectral = new Spectral({ resolver: httpAndFileResolver });
+  spectral.setRuleset(oasRuleset as RulesetDefinition);
+  const results = await spectral.run(JSON.stringify(document));
+
+  return results
+    .filter(result => result.message === message)
+    .map(({ message, path, severity }) => ({ message, path, severity }));
+}
+
+describe('array schemas require items', () => {
+  it('does not report arrays that have an items field, including nested arrays', async () => {
+    await expect(
+      arrayDiagnostics({
+        openapi: '3.0.0',
+        responses: {
+          200: { type: 'array', items: {} },
+          201: { type: 'array', items: { type: 'array', items: {} } },
+        },
+      }),
+    ).resolves.toEqual([]);
+  });
+
+  it('reports missing items on an array schema and on nested array schemas', async () => {
+    await expect(
+      arrayDiagnostics({
+        openapi: '3.0.0',
+        responses: {
+          200: { type: 'array' },
+          201: { type: 'array', items: { type: 'array' } },
+        },
+      }),
+    ).resolves.toEqual([
+      {
+        message,
+        path: ['responses', '200'],
+        severity: DiagnosticSeverity.Error,
+      },
+      {
+        message,
+        path: ['responses', '201', 'items'],
+        severity: DiagnosticSeverity.Error,
+      },
+    ]);
+  });
+
+  it('reports the complete path in the nested OpenAPI example', async () => {
+    await expect(
+      arrayDiagnostics({
+        openapi: '3.0.3',
+        info: { title: 'test', description: 'Test specification file', version: '1.0' },
+        servers: [{ url: 'http://localhost:3000' }],
+        paths: {
+          '/users': {
+            get: {
+              responses: {
+                200: {
+                  description: 'OK',
+                  content: {
+                    'application/json': {
+                      schema: {
+                        type: 'object',
+                        properties: {
+                          favoriteColorSets: {
+                            type: 'array',
+                            items: { type: 'array' },
+                          },
+                        },
+                      },
+                    },
+                  },
+                },
+              },
+            },
+          },
+        },
+      }),
+    ).resolves.toEqual([
+      {
+        message,
+        path: [
+          'paths',
+          '/users',
+          'get',
+          'responses',
+          '200',
+          'content',
+          'application/json',
+          'schema',
+          'properties',
+          'favoriteColorSets',
+          'items',
+        ],
+        severity: DiagnosticSeverity.Error,
+      },
+    ]);
+  });
+});
