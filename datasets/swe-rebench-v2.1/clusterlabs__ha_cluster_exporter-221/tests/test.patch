+func TestSbdCollectorExportsDevicesWithSpaceAfterSemicolon(t *testing.T) {
+	configPath := filepath.Join(t.TempDir(), "sbd.conf")
+	assert.NoError(t, os.WriteFile(configPath, []byte("SBD_DEVICE=/dev/vdc; /dev/vdd\n"), 0600))
+
+	sbdCollector, err := NewCollector("../../test/fake_sbd_dump.sh", configPath, false, log.NewNopLogger())
+	assert.NoError(t, err)
+
+	registry := prometheus.NewRegistry()
+	assert.NoError(t, registry.Register(sbdCollector))
+	metricFamilies, err := registry.Gather()
+	assert.NoError(t, err)
+
+	var devices []string
+	for _, family := range metricFamilies {
+		if family.GetName() != "ha_cluster_sbd_devices" {
+			continue
+		}
+		for _, metric := range family.GetMetric() {
+			for _, label := range metric.GetLabel() {
+				if label.GetName() == "device" {
+					devices = append(devices, label.GetValue())
+				}
+			}
+		}
+	}
+	assert.ElementsMatch(t, []string{"/dev/vdc", "/dev/vdd"}, devices)
+}
