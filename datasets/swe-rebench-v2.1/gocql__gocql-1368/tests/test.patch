+func TestConcurrentPreparedQueryCancellationIsIsolated(t *testing.T) {
+	srv := NewTestServer(t, defaultProto, context.Background())
+	srv.prepareStarted = make(chan struct{}, 1)
+	srv.prepareDelay = 300 * time.Millisecond
+	defer srv.Stop()
+
+	db, err := testCluster(defaultProto, srv.Address).CreateSession()
+	if err != nil {
+		t.Fatalf("NewCluster: %v", err)
+	}
+	defer db.Close()
+
+	canceledCtx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	results := make(chan struct {
+		name string
+		err  error
+	}, 2)
+	statement := "INSERT INTO cancellation_test (value) VALUES (1)"
+
+	go func() {
+		results <- struct {
+			name string
+			err  error
+		}{name: "canceled", err: db.Query(statement).WithContext(canceledCtx).Exec()}
+	}()
+
+	select {
+	case <-srv.prepareStarted:
+	case <-time.After(5 * time.Second):
+		t.Fatal("timed out waiting for the statement to be prepared")
+	}
+
+	go func() {
+		results <- struct {
+			name string
+			err  error
+		}{name: "active", err: db.Query(statement).WithContext(context.Background()).Exec()}
+	}()
+	time.Sleep(20 * time.Millisecond)
+	cancel()
+
+	var canceledErr, activeErr error
+	for i := 0; i < 2; i++ {
+		result := <-results
+		if result.name == "canceled" {
+			canceledErr = result.err
+		} else {
+			activeErr = result.err
+		}
+	}
+	if !errors.Is(canceledErr, context.Canceled) {
+		t.Errorf("canceled query returned %v, want %v", canceledErr, context.Canceled)
+	}
+	if activeErr != nil {
+		t.Errorf("query with an independent context failed: %v", activeErr)
+	}
+}
