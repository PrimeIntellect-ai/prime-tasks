+def test_pickle(rig, tmpdir):
+    p = rig.create_cloud_path("dir_0/file0_0.txt")
+
+    with (tmpdir / "test.pkl").open("wb") as f:
+        pickle.dump(p, f)
+
+    with (tmpdir / "test.pkl").open("rb") as f:
+        pickled = pickle.load(f)
+
+    # test a call to the network
+    assert pickled.exists()
+
+    # check we unpickled, and that client is the default client
+    assert str(pickled) == str(p)
+    assert pickled.client == p.client
+
+
+def test_pickle_uses_default_client_for_non_default_source(rig, tmpdir):
+    default_path = rig.create_cloud_path("dir_0/file0_0.txt")
+    default_client = default_path.client
+    source_client = rig.client_class()
+    assert source_client is not default_client
+
+    path = rig.path_class(str(default_path), client=source_client)
+    assert path.client is source_client
+
+    with (tmpdir / "non-default-client.pkl").open("wb") as f:
+        pickle.dump(path, f)
+    with (tmpdir / "non-default-client.pkl").open("rb") as f:
+        restored = pickle.load(f)
+
+    assert str(restored) == str(path)
+    assert restored.client is default_client
+    assert restored.exists()
