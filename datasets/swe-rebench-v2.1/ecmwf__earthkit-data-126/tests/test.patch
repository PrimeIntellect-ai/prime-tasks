+# granted to it by virtue of its status as an intergovernmental organisation
+# nor does it submit to any jurisdiction.
+#
+
+import pytest
+
+from earthkit.data import settings
+
+
+def test_settings_invalid():
+    # invalid param
+    with pytest.raises(KeyError):
+        settings.get("_invalid_")
+
+    with pytest.raises(KeyError):
+        settings.set("_invalid_", 1)
+
+
+@pytest.mark.parametrize(
+    "param,set_value,stored_value,raise_error",
+    [
+        ("reader-type-check-bytes", 8, 8, None),
+        ("reader-type-check-bytes", 4096, 4096, None),
+        ("reader-type-check-bytes", 7, None, ValueError),
+        ("reader-type-check-bytes", 4097, None, ValueError),
+    ],
+)
+def test_settings_set_numbers(param, set_value, stored_value, raise_error):
+    original = settings.get(param)
+    try:
+        if raise_error is None:
+            settings.set(param, set_value)
+            assert settings.get(param) == stored_value
+        else:
+            with pytest.raises(raise_error):
+                settings.set(param, set_value)
+    finally:
+        settings.set(param, original)
+
+
+def test_reader_type_check_bytes_default_and_type_validation():
+    assert settings.get("reader-type-check-bytes") == 64
+    with pytest.raises(TypeError):
+        settings.set("reader-type-check-bytes", None)
+
+
+if __name__ == "__main__":
+    from earthkit.data.testing import main
+
+    main(__file__)
