+#!/usr/bin/env python3
+
+# (C) Copyright 2020 ECMWF.
+#
+# This software is licensed under the terms of the Apache Licence Version 2.0
+# which can be obtained at http://www.apache.org/licenses/LICENSE-2.0.
+# In applying this licence, ECMWF does not waive the privileges and immunities
+# granted to it by virtue of its status as an intergovernmental organisation
+# nor does it submit to any jurisdiction.
+#
+
+import pytest
+
+from earthkit.data import from_source, settings
+from earthkit.data.core.temporary import temp_file
+from earthkit.data.testing import earthkit_examples_file
+
+
+@pytest.mark.parametrize(
+    "file_path",
+    [
+        "test.grib",
+        "temp_10.bufr",
+    ],
+)
+def test_reader_padding_bytes(file_path):
+    path = earthkit_examples_file(file_path)
+
+    def check(ds):
+        # Successfully reading records demonstrates recognition without relying
+        # on a particular reader class or a fixture-specific record count.
+        assert len(ds) > 0
+
+    # zero padding before the format signature
+    tmp = temp_file()
+    with open(tmp.path, "wb") as f_tmp, open(path, "rb") as f:
+        f_tmp.write(bytes([0 for _ in range(20)]))
+        f_tmp.write(f.read())
+    check(from_source("file", tmp.path))
+
+    # non-zero data transmission header before the format signature
+    tmp = temp_file()
+    with open(tmp.path, "wb") as f_tmp, open(path, "rb") as f:
+        f_tmp.write(b"WMO TRANSMISSION HEADER 0123456789")
+        f_tmp.write(f.read())
+    check(from_source("file", tmp.path))
+
+    # more padding than the default number of type-check bytes
+    tmp = temp_file()
+    with open(tmp.path, "wb") as f_tmp, open(path, "rb") as f:
+        f_tmp.write(bytes([0 for _ in range(80)]))
+        f_tmp.write(f.read())
+    original = settings.get("reader-type-check-bytes")
+    try:
+        settings.set("reader-type-check-bytes", 100)
+        check(from_source("file", tmp.path))
+    finally:
+        settings.set("reader-type-check-bytes", original)
+
+
+if __name__ == "__main__":
+    from earthkit.data.testing import main
+
+    main()
