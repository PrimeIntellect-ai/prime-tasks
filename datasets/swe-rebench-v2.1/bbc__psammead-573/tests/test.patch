+import * as fontStyles from './font-styles';
+
+const services = ['news', 'persian', 'igbo', 'pidgin', 'yoruba'];
+
+const fontStyleKeys = [
+  'getSansRegular',
+  'getSansItalic',
+  'getSansBold',
+  'getSansBoldItalic',
+  'getSerifRegular',
+  'getSerifMedium',
+  'getSerifMediumItalic',
+];
+
+const families = {
+  news: {
+    sans: 'ReithSans, Helvetica, Arial, sans-serif',
+    serif: 'ReithSerif, Helvetica, Arial, sans-serif',
+  },
+  persian: {
+    sans: 'NassimPersian, Arial, Verdana, Geneva, Helvetica, sans serif',
+    serif: 'NassimPersian, Arial, Verdana, Geneva, Helvetica, sans serif',
+  },
+  igbo: {
+    sans: 'Helmet, Freesans, Helvetica, Arial, sans serif',
+    serif: 'Helmet, Freesans, Helvetica, Arial, sans serif',
+  },
+  pidgin: {
+    sans: 'Helmet, Freesans, Helvetica, Arial, sans serif',
+    serif: 'Helmet, Freesans, Helvetica, Arial, sans serif',
+  },
+  yoruba: {
+    sans: 'Helmet, Freesans, Helvetica, Arial, sans serif',
+    serif: 'Helmet, Freesans, Helvetica, Arial, sans serif',
+  },
+};
+
+const expected = {
+  news: {
+    getSansRegular: { family: 'sans', weight: '400', style: 'normal' },
+    getSansItalic: { family: 'sans', weight: '400', style: 'italic' },
+    getSansBold: { family: 'sans', weight: '700', style: 'normal' },
+    getSansBoldItalic: { family: 'sans', weight: '700', style: 'italic' },
+    getSerifRegular: { family: 'serif', weight: '400', style: 'normal' },
+    getSerifMedium: { family: 'serif', weight: '500', style: 'normal' },
+    getSerifMediumItalic: { family: 'serif', weight: '500', style: 'italic' },
+  },
+  persian: {
+    getSansRegular: { family: 'sans', weight: '400', style: 'normal' },
+    getSansItalic: { family: 'sans', weight: '400', style: 'normal' },
+    getSansBold: { family: 'sans', weight: '700', style: 'normal' },
+    getSansBoldItalic: { family: 'sans', weight: '700', style: 'normal' },
+    getSerifRegular: { family: 'sans', weight: '400', style: 'normal' },
+    getSerifMedium: { family: 'sans', weight: '700', style: 'normal' },
+    getSerifMediumItalic: { family: 'sans', weight: '700', style: 'normal' },
+  },
+  igbo: {
+    getSansRegular: { family: 'sans', weight: '400', style: 'normal' },
+    getSansItalic: { family: 'sans', weight: '400', style: 'italic' },
+    getSansBold: { family: 'sans', weight: '700', style: 'normal' },
+    getSansBoldItalic: { family: 'sans', weight: '700', style: 'italic' },
+    getSerifRegular: { family: 'sans', weight: '400', style: 'normal' },
+    getSerifMedium: { family: 'sans', weight: '700', style: 'normal' },
+    getSerifMediumItalic: { family: 'sans', weight: '700', style: 'italic' },
+  },
+  pidgin: {
+    getSansRegular: { family: 'sans', weight: '400', style: 'normal' },
+    getSansItalic: { family: 'sans', weight: '400', style: 'italic' },
+    getSansBold: { family: 'sans', weight: '700', style: 'normal' },
+    getSansBoldItalic: { family: 'sans', weight: '700', style: 'italic' },
+    getSerifRegular: { family: 'sans', weight: '400', style: 'normal' },
+    getSerifMedium: { family: 'sans', weight: '700', style: 'normal' },
+    getSerifMediumItalic: { family: 'sans', weight: '700', style: 'italic' },
+  },
+  yoruba: {
+    getSansRegular: { family: 'sans', weight: '400', style: 'normal' },
+    getSansItalic: { family: 'sans', weight: '400', style: 'italic' },
+    getSansBold: { family: 'sans', weight: '700', style: 'normal' },
+    getSansBoldItalic: { family: 'sans', weight: '700', style: 'italic' },
+    getSerifRegular: { family: 'sans', weight: '400', style: 'normal' },
+    getSerifMedium: { family: 'sans', weight: '700', style: 'normal' },
+    getSerifMediumItalic: { family: 'sans', weight: '700', style: 'italic' },
+  },
+};
+
+const getProperty = (css, property) => {
+  const match = css.match(new RegExp(`${property}\\s*:\\s*([^;\\n]+)`));
+  return match ? match[1].replace(/\s+/g, ' ').trim() : null;
+};
+
+services.forEach(service => {
+  fontStyleKeys.forEach(fontStyle => {
+    const style = fontStyle.replace('get', '');
+    const { family, weight, style: fontStyleValue } = expected[service][fontStyle];
+    it(`should render ${style} correctly for ${service}`, () => {
+      const css = fontStyles[fontStyle](service);
+      expect(getProperty(css, 'font-family')).toBe(families[service][family]);
+      expect(getProperty(css, 'font-weight')).toBe(weight);
+      expect(getProperty(css, 'font-style')).toBe(fontStyleValue);
+    });
+  });
+});
+
+fontStyleKeys.forEach(fontStyle => {
+  describe(fontStyle, () => {
+    it(`should fail gracefully and return null when ${fontStyle} given an invalid service name`, () => {
+      expect(fontStyles[fontStyle]('default')).toBeNull();
+    });
+  });
+});
+
+// The package entry delegates to generated dist output, which is not present in
+// this source-only test checkout. Provide the source module at that boundary so
+// the package entry itself is still exercised.
+jest.mock('../dist/font-styles', () => require('./font-styles'), { virtual: true });
+import * as packageFontStyles from '../font-styles';
+
+describe('font-styles package module', () => {
+  fontStyleKeys.forEach(fontStyle => {
+    it(`exports ${fontStyle} for package consumers`, () => {
+      expect(typeof packageFontStyles[fontStyle]).toBe('function');
+      const css = packageFontStyles[fontStyle]('news');
+      const { family, weight, style } = expected.news[fontStyle];
+      expect(getProperty(css, 'font-family')).toBe(families.news[family]);
+      expect(getProperty(css, 'font-weight')).toBe(weight);
+      expect(getProperty(css, 'font-style')).toBe(style);
+    });
+  });
+});
