+package day83
+
+import "testing"
+
+func TestInvertBinaryTree(t *testing.T) {
+	t.Parallel()
+	input := &BinaryTree{Value: "a",
+		Left:  &BinaryTree{Value: "b", Left: &BinaryTree{Value: "d"}, Right: &BinaryTree{Value: "e"}},
+		Right: &BinaryTree{Value: "c", Left: &BinaryTree{Value: "f"}},
+	}
+	inverted := &BinaryTree{Value: "a",
+		Left:  &BinaryTree{Value: "c", Right: &BinaryTree{Value: "f"}},
+		Right: &BinaryTree{Value: "b", Left: &BinaryTree{Value: "e"}, Right: &BinaryTree{Value: "d"}},
+	}
+
+	InvertBinaryTree(input)
+	if !equalTrees(input, inverted) {
+		t.Errorf("Expected the result to be the inverted tree")
+	}
+}
+
+func BenchmarkInvertBinaryTree(b *testing.B) {
+	input := &BinaryTree{Value: "a",
+		Left:  &BinaryTree{Value: "b", Left: &BinaryTree{Value: "d"}, Right: &BinaryTree{Value: "e"}},
+		Right: &BinaryTree{Value: "c", Left: &BinaryTree{Value: "f"}},
+	}
+	for i := 0; i < b.N; i++ {
+		InvertBinaryTree(input)
+	}
+}
+
+func equalTrees(one, two *BinaryTree) bool {
+	if one == nil && two == nil {
+		return true
+	} else if (one == nil && two != nil) || (one != nil && two == nil) || (one.Value != two.Value) {
+		return false
+	}
+	return equalTrees(one.Left, two.Left) && equalTrees(one.Right, two.Right)
+}
