+++ b/test/unit/rules/resources/ecs/test_service_network_configuration.py
@@ -0,0 +1,64 @@
+"""Behavioral checks for ECS service network configuration."""
+
+import json
+
+from cfnlint.api import lint
+
+
+def _template(network_mode="awsvpc", network_configuration=None):
+    service_properties = {"TaskDefinition": {"Ref": "TaskDefinition"}}
+    if network_configuration is not None:
+        service_properties["NetworkConfiguration"] = network_configuration
+    return {
+        "Resources": {
+            "TaskDefinition": {
+                "Type": "AWS::ECS::TaskDefinition",
+                "Properties": {
+                    "NetworkMode": network_mode,
+                    "ContainerDefinitions": [],
+                },
+            },
+            "Service": {
+                "Type": "AWS::ECS::Service",
+                "Properties": service_properties,
+            },
+        }
+    }
+
+
+def _lint(template):
+    return lint(json.dumps(template), regions=["us-east-1"])
+
+
+def test_awsvpc_service_requires_network_configuration():
+    errors = _lint(_template())
+
+    assert errors
+
+
+def test_awsvpc_service_accepts_valid_network_configuration():
+    errors = _lint(
+        _template(
+            network_configuration={
+                "AwsvpcConfiguration": {"Subnets": ["subnet-12345678"]}
+            }
+        )
+    )
+
+    assert not errors
+
+
+def test_network_configuration_must_have_aws_vpc_configuration_shape():
+    errors = _lint(
+        _template(
+            network_configuration={"AwsvpcConfiguration": "not-an-object"}
+        )
+    )
+
+    assert errors
+
+
+def test_non_awsvpc_service_does_not_require_network_configuration():
+    errors = _lint(_template(network_mode="bridge"))
+
+    assert not errors
diff --git a/test/unit/rules/resources/ecs/test_task_definition_aws_vpc.py b/test/unit/rules/resources/ecs/test_task_definition_aws_vpc.py
