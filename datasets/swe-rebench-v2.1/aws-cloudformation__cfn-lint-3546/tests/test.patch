@@ -0,0 +1,63 @@
+"""Behavioral checks for awsvpc task-definition port mappings."""
+
+import json
+
+from cfnlint.api import lint
+
+
+def _template(network_mode="awsvpc", port_mapping=None):
+    container = {"Name": "container", "Image": "example/image"}
+    if port_mapping is not None:
+        container["PortMappings"] = [port_mapping]
+    return {
+        "Resources": {
+            "TaskDefinition": {
+                "Type": "AWS::ECS::TaskDefinition",
+                "Properties": {
+                    "NetworkMode": network_mode,
+                    "ContainerDefinitions": [container],
+                },
+            }
+        }
+    }
+
+
+def _lint(template):
+    return lint(json.dumps(template), regions=["us-east-1"])
+
+
+def test_awsvpc_host_port_must_match_container_port():
+    errors = _lint(
+        _template(
+            port_mapping={"ContainerPort": 8080, "HostPort": 80}
+        )
+    )
+
+    assert errors
+
+
+def test_awsvpc_host_port_may_equal_container_port():
+    errors = _lint(
+        _template(
+            port_mapping={"ContainerPort": 8080, "HostPort": 8080}
+        )
+    )
+
+    assert not errors
+
+
+def test_awsvpc_host_port_may_be_omitted():
+    errors = _lint(_template(port_mapping={"ContainerPort": 8080}))
+
+    assert not errors
+
+
+def test_other_network_modes_do_not_apply_awsvpc_host_port_constraint():
+    errors = _lint(
+        _template(
+            network_mode="bridge",
+            port_mapping={"ContainerPort": 8080, "HostPort": 80},
+        )
+    )
+
+    assert not errors
