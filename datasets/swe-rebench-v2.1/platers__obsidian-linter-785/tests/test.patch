+
+describe('MoveFootnotesToTheBottom with duplicate footnote definitions', () => {
+  it('does not hang and moves both definitions below the reference', () => {
+    const output = MoveFootnotesToTheBottom.getRule().apply(dedent`
+      [^2]: a
+      ${''}
+      a[^2]
+      ${''}
+      [^2]: b
+    `, {});
+    const nonEmptyLines = output.split('\n').filter(line => line.trim().length > 0);
+
+    expect(nonEmptyLines[0]).toBe('a[^2]');
+    expect(new Set(nonEmptyLines.slice(-2))).toEqual(new Set(['[^2]: a', '[^2]: b']));
+  });
+});
+
+// The re-index-footnotes rule shares the same footnote-wrapping edge case as
+// move-footnotes-to-the-bottom (see https://github.com/platers/obsidian-linter/issues/784).
+// When a footnote key has more than one footnote definition, re-indexing cannot work, so the
+// user must be notified of the problem instead of the linter hanging.
+describe('ReIndexFootnotes with multiple footnotes for a key', () => {
+  it('notifies the user by raising an error instead of hanging when a footnote key has more than one footnote', () => {
+    const rule = ReIndexFootnotes.getRule();
+    expect(() => rule.apply(dedent`
+      [^2]: a
+      ${''}
+      a[^2]
+      ${''}
+      [^2]: b
+    `, {})).toThrow();
+  });
+});
