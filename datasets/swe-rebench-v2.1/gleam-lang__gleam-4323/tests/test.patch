+/// Compiles the given Gleam source to Erlang and asserts that the generated
+/// Erlang is valid by compiling it with `erlc`.
+///
+/// This is a behavioural check: it does not care about the exact shape of the
+/// generated code, only that the compiler produces Erlang that the Erlang
+/// compiler accepts.
+fn assert_erlang_compiles(src: &str) {
+    let compiled =
+        crate::erlang::tests::compile_test_project(src, "/root/project/test/my/mod.gleam", None);
+
+    // `compile_test_project` replaces the echo runtime template with a comment
+    // to keep snapshots readable. Restore it so the generated module is
+    // complete and can be compiled.
+    let module = compiled.replace(
+        "% ...omitted code from `templates/echo.erl`...",
+        include_str!("../../../templates/echo.erl"),
+    );
+
+    let dir = std::env::temp_dir().join(format!(
+        "gleam_echo_codegen_{}_{}",
+        std::process::id(),
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .expect("system time")
+            .as_nanos()
+    ));
+    std::fs::create_dir_all(&dir).expect("create temp dir");
+    std::fs::write(dir.join("my@mod.erl"), &module).expect("write generated erlang");
+
+    let output = std::process::Command::new("erlc")
+        .arg("my@mod.erl")
+        .current_dir(&dir)
+        .output()
+        .expect("run erlc");
+
+    let _ = std::fs::remove_dir_all(&dir);
+
+    assert!(
+        output.status.success(),
+        "generated Erlang did not compile:\n{}\n{}",
+        module,
+        String::from_utf8_lossy(&output.stderr),
+    );
+}
+
+#[test]
+pub fn echo_at_start_of_pipeline_generates_valid_erlang() {
+    assert_erlang_compiles(
+        r#"
+pub fn main() {
+  echo
+    123
+    |> wibble
+    |> wibble
+}
+
+pub fn wibble(n) { n }
+"#,
+    );
+}
