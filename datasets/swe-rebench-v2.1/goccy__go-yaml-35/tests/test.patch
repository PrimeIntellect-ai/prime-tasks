+
+type multilineField string
+
+func (s *multilineField) UnmarshalYAML(data []byte) error {
+	var value string
+	if err := yaml.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	*s = multilineField(value)
+	return nil
+}
+
+type multilineParent struct {
+	Text string
+}
+
+func (p *multilineParent) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var fields struct {
+		Text multilineField `yaml:"text"`
+	}
+	if err := unmarshal(&fields); err != nil {
+		return err
+	}
+	p.Text = string(fields.Text)
+	return nil
+}
+
+func TestCustomUnmarshalRetainsMultilineField(t *testing.T) {
+	var parent multilineParent
+	err := yaml.Unmarshal([]byte("text: |\n  first line\n  second line\n  third line\n"), &parent)
+	if err != nil {
+		t.Fatalf("unmarshal multiline field: %v", err)
+	}
+	if !strings.Contains(parent.Text, "first line\nsecond line\nthird line") {
+		t.Fatalf("multiline field was truncated: got %q", parent.Text)
+	}
+}
