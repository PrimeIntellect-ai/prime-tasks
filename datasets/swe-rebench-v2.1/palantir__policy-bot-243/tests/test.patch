+// TestFromBranchForkedPullRequest verifies that the pattern is matched against
+// the full owner:branch value returned for a forked pull request.
+func TestFromBranchForkedPullRequest(t *testing.T) {
+	ctx := context.Background()
+
+	t.Run("matches full owner:branch value", func(t *testing.T) {
+		pred := fromBranchPredicate(t, "^testorg2:test-branch$")
+		ok, _, err := pred.Evaluate(ctx, &pulltest.Context{BranchHeadName: "testorg2:test-branch"})
+		require.NoError(t, err)
+		assert.True(t, ok, "pattern should match the full owner:branch value")
+	})
+
+	t.Run("does not match bare branch name", func(t *testing.T) {
+		pred := fromBranchPredicate(t, "^test-branch$")
+		ok, _, err := pred.Evaluate(ctx, &pulltest.Context{BranchHeadName: "testorg2:test-branch"})
+		require.NoError(t, err)
+		assert.False(t, ok, "pattern should not match the bare branch name of a fork")
+	})
+}
