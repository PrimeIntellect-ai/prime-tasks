+type branchesTestCase struct {
+	name       string
+	expected   bool
+	branchName string
+}
+
+func runBranchesTestCase(t *testing.T, regex string, cases []branchesTestCase) {
+	ctx := context.Background()
+
+	for _, tc := range cases {
+
+		compiledRegexp := common.NewCompiledRegexp(regexp.MustCompile(regex))
+		targetsPredicate := &predicate.TargetsBranch{
+			Pattern: compiledRegexp,
+		}
+
+		targetsContext := &pulltest.Context{
+			BranchBaseName: tc.branchName,
+		}
+		fromContext := &pulltest.Context{
+			BranchHeadName: tc.branchName,
+		}
+
+		t.Run(tc.name+" targets_branch", func(t *testing.T) {
+			ok, _, err := targetsPredicate.Evaluate(ctx, targetsContext)
+			if assert.NoError(t, err, "targets_branch predicate evaluation failed") {
+				assert.Equal(t, tc.expected, ok, "targets_branch predicate was not correct")
+			}
+		})
+
+		t.Run(tc.name+" from_branch", func(t *testing.T) {
+			fromPredicate := fromBranchPredicate(t, regex)
+			ok, _, err := fromPredicate.Evaluate(ctx, fromContext)
+			if assert.NoError(t, err, "from_branch predicate evaluation failed") {
+				assert.Equal(t, tc.expected, ok, "from_branch predicate was not correct")
+			}
+		})
+	}
+}
+
+// fromBranchPredicate builds the from_branch predicate from a policy
+// configuration, verifying that the predicate is recognized and configurable.
+func fromBranchPredicate(t *testing.T, pattern string) predicate.Predicate {
+	t.Helper()
+
+	var preds approval.Predicates
+	require.NoError(t, yaml.UnmarshalStrict([]byte(fmt.Sprintf("from_branch:\n  pattern: %q\n", pattern)), &preds), "from_branch must be a recognized policy predicate")
+
+	ps := preds.Predicates()
+	require.Len(t, ps, 1, "from_branch should configure exactly one predicate")
+	return ps[0]
+}
+
+// TestFromBranchPolicy verifies the end-to-end use case: a policy that only
+// allows pull requests to master that originate from develop.
+func TestFromBranchPolicy(t *testing.T) {
+	ctx := context.Background()
+
+	cases := []struct {
+		name     string
+		pattern  string
+		head     string
+		approved bool
+	}{
+		{"exact match", "^develop$", "develop", true},
+		{"non match", "^develop$", "feature", false},
+		{"tests anchoring", "^develop$", "not-develop", false},
+		{"alternation", "^(develop|staging)$", "staging", true},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			policyText := fmt.Sprintf(`
+policy:
+  approval:
+    - from-branch-rule
+approval_rules:
+  - name: from-branch-rule
+    if:
+      from_branch:
+        pattern: %q
+    requires:
+      count: 0
+`, tc.pattern)
+
+			var config policy.Config
+			require.NoError(t, yaml.UnmarshalStrict([]byte(policyText), &config), "from_branch must be a recognized policy predicate")
+
+			eval, err := policy.ParsePolicy(&config)
+			require.NoError(t, err)
+
+			res := eval.Evaluate(ctx, &pulltest.Context{
+				BranchBaseName: "master",
+				BranchHeadName: tc.head,
+			})
+			require.NoError(t, res.Error)
+
+			if tc.approved {
+				assert.Equal(t, common.StatusApproved, res.Status, "PR from %q should satisfy the from_branch policy", tc.head)
+			} else {
+				assert.Equal(t, common.StatusSkipped, res.Status, "PR from %q should not satisfy the from_branch policy", tc.head)
+			}
+		})
+	}
 }
 
