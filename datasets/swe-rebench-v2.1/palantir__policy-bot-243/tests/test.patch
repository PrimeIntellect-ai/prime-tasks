+func TestFromBranchDescription(t *testing.T) {
 	ctx := context.Background()
 
+	t.Run("match has empty description", func(t *testing.T) {
+		pred := fromBranchPredicate(t, "^develop$")
+		ok, desc, err := pred.Evaluate(ctx, &pulltest.Context{BranchHeadName: "develop"})
+		require.NoError(t, err)
+		assert.True(t, ok, "matching source branch should satisfy the predicate")
+		assert.Empty(t, desc, "description should be empty on a match")
+	})
+
+	t.Run("mismatch explains the mismatch", func(t *testing.T) {
+		pred := fromBranchPredicate(t, "^develop$")
+		ok, desc, err := pred.Evaluate(ctx, &pulltest.Context{BranchHeadName: "feature"})
+		require.NoError(t, err)
+		assert.False(t, ok, "non-matching source branch should not satisfy the predicate")
+		assert.NotEmpty(t, desc, "description should explain the mismatch")
+	})
+}
