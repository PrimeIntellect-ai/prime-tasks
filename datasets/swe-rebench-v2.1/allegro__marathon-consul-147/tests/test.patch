diff --git a/time/time_test.go b/time/time_test.go
new file mode 100644
index 0000000..859c4de
--- /dev/null
+++ b/time/time_test.go
@@ -0,0 +1,46 @@
+package time
+
+import (
+"encoding/json"
+"testing"
+gotime "time"
+
+"github.com/stretchr/testify/assert"
+)
+
+func TestDurationStringParsing(t *testing.T) {
+t.Parallel()
+
+// given
+var out Interval
+
+// when
+err := json.Unmarshal([]byte(`"15m"`), &out)
+
+// then
+assert.NoError(t, err)
+assert.Equal(t, 15*gotime.Minute, out.Duration)
+}
+
+func TestDurationMarshal(t *testing.T) {
+t.Parallel()
+
+// given
+out := Interval{Duration: 15 * gotime.Minute}
+
+// when
+bytes, err := json.Marshal(out)
+
+// then
+assert.NoError(t, err)
+
+// the serialized form is a human-readable duration string, not a nanosecond integer
+var asString string
+err = json.Unmarshal(bytes, &asString)
+assert.NoError(t, err)
+
+var roundtrip Interval
+err = json.Unmarshal(bytes, &roundtrip)
+assert.NoError(t, err)
+assert.Equal(t, 15*gotime.Minute, roundtrip.Duration)
+}
