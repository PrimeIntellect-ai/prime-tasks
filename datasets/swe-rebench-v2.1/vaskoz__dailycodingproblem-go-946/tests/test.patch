+package day470
+
+import "testing"
+
+// nolint
+var testcases = []struct {
+	nums        []int
+	targetIndex int
+	expected    int
+}{
+	{[]int{4, 1, 3, 5, 6}, 0, 3},
+	{[]int{4, 1, 3, 5, 6}, 4, -1},
+	{[]int{4, 1, 3, 5, 6}, 1, 0},
+}
+
+// checkNearestLarger verifies that got is a valid answer for nums at index i:
+// -1 when no strictly larger value exists, otherwise an index holding a
+// strictly larger value whose distance equals the minimum possible distance.
+// Any of several equally near larger values is accepted.
+func checkNearestLarger(t *testing.T, nums []int, i, got int) {
+	t.Helper()
+
+	minDist := -1
+	for j, v := range nums {
+		if v <= nums[i] {
+			continue
+		}
+		d := j - i
+		if d < 0 {
+			d = -d
+		}
+		if minDist < 0 || d < minDist {
+			minDist = d
+		}
+	}
+
+	if minDist < 0 {
+		if got != -1 {
+			t.Errorf("nums=%v index=%d: no larger value exists, expected -1 got %d", nums, i, got)
+		}
+		return
+	}
+
+	if got < 0 || got >= len(nums) {
+		t.Errorf("nums=%v index=%d: expected an index of a larger value, got %d", nums, i, got)
+		return
+	}
+	if nums[got] <= nums[i] {
+		t.Errorf("nums=%v index=%d: index %d does not hold a strictly larger value", nums, i, got)
+	}
+	d := got - i
+	if d < 0 {
+		d = -d
+	}
+	if d != minDist {
+		t.Errorf("nums=%v index=%d: expected a larger value at distance %d, got index %d (distance %d)",
+			nums, i, minDist, got, d)
+	}
+}
+
+// exhaustiveArrays returns every array of length 1 to 5 with values 0 to 2.
+func exhaustiveArrays() [][]int {
+	var all [][]int
+	for n := 1; n <= 5; n++ {
+		total := 1
+		for k := 0; k < n; k++ {
+			total *= 3
+		}
+		for code := 0; code < total; code++ {
+			arr := make([]int, n)
+			c := code
+			for k := 0; k < n; k++ {
+				arr[k] = c % 3
+				c /= 3
+			}
+			all = append(all, arr)
+		}
+	}
+	return all
+}
+
+func TestClosestLargerNumberIndexBrute(t *testing.T) {
+	t.Parallel()
+
+	extra := []struct {
+		nums        []int
+		targetIndex int
+	}{
+		{[]int{7, 1, 3, 9, 0}, 1},
+		{[]int{2, 1}, 1},
+		{[]int{2, 1}, 0},
+		{[]int{5, 5, 5}, 0},
+		{[]int{9}, 0},
+		{[]int{1, 8, 2, 7, 3, 6, 4, 5}, 3},
+	}
+
+	for _, tc := range testcases {
+		result := ClosestLargerNumberIndexBrute(tc.nums, tc.targetIndex)
+		checkNearestLarger(t, tc.nums, tc.targetIndex, result)
+		if tc.expected == -1 && result != -1 {
+			t.Errorf("nums=%v index=%d: expected -1 got %d", tc.nums, tc.targetIndex, result)
+		}
+	}
+
+	for _, tc := range extra {
+		checkNearestLarger(t, tc.nums, tc.targetIndex, ClosestLargerNumberIndexBrute(tc.nums, tc.targetIndex))
+	}
+}
+
+func TestClosestLargerNumberIndexBruteAllSmallArrays(t *testing.T) {
+	t.Parallel()
+
+	for _, nums := range exhaustiveArrays() {
+		for i := range nums {
+			checkNearestLarger(t, nums, i, ClosestLargerNumberIndexBrute(nums, i))
+		}
+	}
+}
+
+func BenchmarkClosestLargerNumberIndexBrute(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			ClosestLargerNumberIndexBrute(tc.nums, tc.targetIndex)
+		}
+	}
+}
+
+func TestPreprocessClosestLargerNumberIndex(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range testcases {
+		pre := PreprocessClosestLargerNumberIndex(tc.nums)
+		if len(pre) != len(tc.nums) {
+			t.Fatalf("nums=%v: expected %d answers got %d", tc.nums, len(tc.nums), len(pre))
+		}
+		for i := range tc.nums {
+			checkNearestLarger(t, tc.nums, i, pre[i])
+		}
+	}
+}
+
+func TestPreprocessClosestLargerNumberIndexAllSmallArrays(t *testing.T) {
+	t.Parallel()
+
+	for _, nums := range exhaustiveArrays() {
+		pre := PreprocessClosestLargerNumberIndex(nums)
+		if len(pre) != len(nums) {
+			t.Fatalf("nums=%v: expected %d answers got %d", nums, len(nums), len(pre))
+		}
+		for i := range nums {
+			checkNearestLarger(t, nums, i, pre[i])
+		}
+	}
+}
+
+func BenchmarkPreprocessClosestLargerNumberIndex(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			PreprocessClosestLargerNumberIndex(tc.nums)
+		}
+	}
+}
