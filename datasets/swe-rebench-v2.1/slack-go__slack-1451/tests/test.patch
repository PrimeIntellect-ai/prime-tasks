+func TestUpdateMessage(t *testing.T) {
+	type messageTest struct {
+		endpoint string
+		opt      []MsgOption
+		expected url.Values
+		fileIDs  []string
+	}
+	fileIDsOption := func(fileIDs ...string) MsgOption {
+		constructor := reflect.ValueOf(MsgOptionFileIDs)
+		var args []reflect.Value
+		if constructor.Type().IsVariadic() {
+			for _, fileID := range fileIDs {
+				args = append(args, reflect.ValueOf(fileID))
+			}
+		} else {
+			args = []reflect.Value{reflect.ValueOf(fileIDs)}
+		}
+		return constructor.Call(args)[0].Interface().(MsgOption)
+	}
+	tests := map[string]messageTest{
+		"empty file_ids": {
+			endpoint: "/chat.update",
+			opt:      []MsgOption{},
+			expected: url.Values{
+				"channel": []string{"CXXX"},
+				"token":   []string{"testing-token"},
+				"ts":      []string{"1234567890.123456"},
+			},
+		},
+		"with file_ids": {
+			endpoint: "/chat.update",
+			opt:      []MsgOption{fileIDsOption("F123", "F456")},
+			fileIDs:  []string{"F123", "F456"},
+			expected: url.Values{
+				"channel": []string{"CXXX"},
+				"token":   []string{"testing-token"},
+				"ts":      []string{"1234567890.123456"},
+			},
+		},
+	}
+
+	once.Do(startServer)
+	api := New(validToken, OptionAPIURL("http://"+serverAddr+"/"))
+
+	for name, test := range tests {
+		t.Run(name, func(t *testing.T) {
+			http.DefaultServeMux = new(http.ServeMux)
+			http.HandleFunc(test.endpoint, func(rw http.ResponseWriter, r *http.Request) {
+				body, err := io.ReadAll(r.Body)
+				if err != nil {
+					t.Errorf("unexpected error: %v", err)
+					return
+				}
+				actual, err := url.ParseQuery(string(body))
+				if err != nil {
+					t.Errorf("unexpected error: %v", err)
+					return
+				}
+				for key, values := range test.expected {
+					if !reflect.DeepEqual(actual[key], values) {
+						t.Errorf("%s: got %q, want %q", key, actual[key], values)
+					}
+				}
+				if len(test.fileIDs) == 0 {
+					if actual.Has("file_ids") {
+						t.Errorf("file_ids should be omitted when no IDs are supplied; got %q", actual["file_ids"])
+					}
+					return
+				}
+				var gotFileIDs []string
+				if values := actual["file_ids"]; len(values) != 1 || json.Unmarshal([]byte(values[0]), &gotFileIDs) != nil {
+					t.Errorf("file_ids should contain the supplied IDs; got %q", values)
+					return
+				}
+				wantIDs := make(map[string]int, len(test.fileIDs))
+				for _, id := range test.fileIDs {
+					wantIDs[id]++
+				}
+				for _, id := range gotFileIDs {
+					if wantIDs[id] == 0 {
+						t.Errorf("file_ids contains unexpected ID %q", id)
+						return
+					}
+					wantIDs[id]--
+				}
+				if len(gotFileIDs) != len(test.fileIDs) {
+					t.Errorf("file_ids: got %q, want IDs %q", gotFileIDs, test.fileIDs)
+					return
+				}
+				for id, count := range wantIDs {
+					if count != 0 {
+						t.Errorf("file_ids is missing ID %q", id)
+					}
+				}
+			})
+
+			_, _, _, _ = api.UpdateMessage("CXXX", "1234567890.123456", test.opt...)
+		})
+	}
+}
