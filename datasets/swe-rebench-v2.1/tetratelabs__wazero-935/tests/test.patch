+
+func Test_IsTerminalTerminalBackedStdio(t *testing.T) {
+	if os.Getenv("WAZERO_TERMINAL_STDIO_CHILD") == "1" {
+		config := wazero.NewModuleConfig().WithStdin(os.Stdin).WithStdout(os.Stdout).WithStderr(os.Stderr)
+		mod, r, _ := requireProxyModule(t, config)
+		defer r.Close(testCtx)
+
+		for _, fd := range []uint32{internalsys.FdStdin, internalsys.FdStdout, internalsys.FdStderr} {
+			maskMemory(t, mod, 24)
+			requireErrno(t, ErrnoSuccess, mod, fdFdstatGetName, uint64(fd), 0)
+			actual, ok := mod.Memory().Read(0, 24)
+			require.True(t, ok)
+			require.True(t, actual[0] == 2)
+		}
+		return
+	}
+
+	script, err := exec.LookPath("script")
+	if err != nil {
+		t.Skip("pseudo-terminal utility is unavailable")
+	}
+	command := "'" + strings.ReplaceAll(os.Args[0], "'", `'\''`) + "' -test.run=^Test_IsTerminalTerminalBackedStdio$ -test.v"
+	cmd := exec.Command(script, "-q", "-c", command, "/dev/null")
+	cmd.Env = append(os.Environ(), "WAZERO_TERMINAL_STDIO_CHILD=1")
+	output, err := cmd.CombinedOutput()
+	require.NoError(t, err, string(output))
+	require.True(t, strings.Contains(string(output), "--- PASS: Test_IsTerminalTerminalBackedStdio"), string(output))
+}
