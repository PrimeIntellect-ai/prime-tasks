@@ -110,10 +110,18 @@ func testFdReaddirStat(t *testing.T, bin []byte) {
 
 	console := compileAndRun(t, moduleConfig.WithFS(fstest.MapFS{}), bin)
 
+	// stdin may be a terminal depending on the host running the test.
+	lines := strings.Split(console, "\n")
+	for i, line := range lines {
+		if strings.HasPrefix(line, "stdin isatty: ") {
+			lines = append(lines[:i], lines[i+1:]...)
+			break
+		}
+	}
+	console = strings.Join(lines, "\n")
 	require.Equal(t, `
-stdin isatty: true
-stdout isatty: true
-stderr isatty: true
+stdout isatty: false
+stderr isatty: false
 / isatty: false
 `, "\n"+console)
 }
