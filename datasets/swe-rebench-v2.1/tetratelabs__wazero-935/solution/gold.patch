diff --git a/internal/platform/terminal.go b/internal/platform/terminal.go
new file mode 100644
index 00000000..326a16b8
--- /dev/null
+++ b/internal/platform/terminal.go
@@ -0,0 +1,14 @@
+//go:build darwin || linux || freebsd
+
+package platform
+
+import (
+	"syscall"
+	"unsafe"
+)
+
+func isTerminal(fd uintptr) bool {
+	var val syscall.Termios
+	_, _, err := syscall.Syscall6(syscall.SYS_IOCTL, fd, ioctlReadTermios, uintptr(unsafe.Pointer(&val)), 0, 0, 0)
+	return err == 0
+}
