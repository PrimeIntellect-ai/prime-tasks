+"""Tests for pretty-printing of Message subclasses.
+
+The public contract is in .rebench_contract/problem_statement.md and
+.rebench_contract/interface.md.  These tests exercise the *contents* and
+general shape of the representations, not exact whitespace, quoting,
+ordering or truncation width.
+"""
+import pytest
+import requests
+
+import pandasdmx as sdmx
+from pandasdmx.message import (
+    DataMessage,
+    Footer,
+    Header,
+    Message,
+    StructureMessage,
+    )
+
+from . import specimen
+
+
+#: Header fields named in the contract.
+HEADER_FIELDS = ('error', 'id', 'prepared', 'receiver', 'sender')
+
+#: StructureMessage DictLike attributes.
+STRUCTURE_ATTRS = (
+    'category_scheme', 'codelist', 'concept_scheme', 'constraint',
+    'dataflow', 'structure', 'organisation_scheme', 'provisionagreement',
+    )
+EMPTY_STRUCTURE_SUMMARIES = {
+    'constraint': 'ContentConstraint',
+    'organisation_scheme': 'AgencyScheme',
+    'provisionagreement': 'ProvisionAgreement',
+    }
+
+#: Specimen files and the Message subclass they parse to.
+SPECIMENS = [
+    ('insee-IPI-2010-A21-datastructure.xml', StructureMessage),
+    ('insee-dataflow.xml', StructureMessage),
+    ('ecb_exr_sg_xs.xml', DataMessage),
+    ('exr-action-delete.json', DataMessage),
+    ]
+
+
+def _open(pattern):
+    with specimen(pattern) as f:
+        return sdmx.open_file(f)
+
+
+@pytest.mark.parametrize('pattern, cls', SPECIMENS)
+def test_repr_includes_header_fields(pattern, cls):
+    msg = _open(pattern)
+    r = repr(msg)
+    assert '<Header>' in r
+    for field in HEADER_FIELDS:
+        value = getattr(msg.header, field)
+        if value is None:
+            continue
+        assert field in r
+        if isinstance(value, str):
+            assert value in r
+
+
+def test_structure_message_summarizes_nonempty_dictlike():
+    msg = _open('insee-IPI-2010-A21-datastructure.xml')
+    assert isinstance(msg, StructureMessage)
+    r = repr(msg)
+    lines = r.splitlines()
+
+    nonempty = 0
+    for name in STRUCTURE_ATTRS:
+        attr = getattr(msg, name)
+        if len(attr) == 0:
+            continue
+        nonempty += 1
+        count = len(attr)
+        keys = list(attr.keys())
+        # A summary line mentions the number of objects and at least one ID.
+        assert any(
+            '({})'.format(count) in line and any(k in line for k in keys)
+            for line in lines), (name, r)
+
+    assert nonempty > 0
+    # Empty DictLike attributes have no zero-count summary.
+    for name, value_class in EMPTY_STRUCTURE_SUMMARIES.items():
+        if len(getattr(msg, name)) == 0:
+            assert '{} (0):'.format(value_class) not in r
+
+
+def test_data_message_repr():
+    msg = _open('ecb_exr_sg_xs.xml')
+    assert isinstance(msg, DataMessage)
+    r = repr(msg)
+    assert 'DataSet (1)' in r
+    assert 'dataflow' in r
+    assert 'observation_dimension' in r
+
+
+def test_empty_data_message_repr_includes_zero_datasets():
+    msg = DataMessage(data=[])
+    assert 'DataSet (0)' in repr(msg)
+
+
+def test_data_message_repr_two_datasets():
+    msg = _open('exr-action-delete.json')
+    assert isinstance(msg, DataMessage)
+    r = repr(msg)
+    assert 'DataSet (2)' in r
+    assert 'dataflow' in r
+    assert 'observation_dimension' in r
+
+
+def test_header_repr_includes_error():
+    header = Header(id='x', error='some error')
+    r = repr(header)
+    assert '<Header>' in r
+    assert 'error' in r
+    assert 'some error' in r
+
+
+def test_message_repr_includes_footer():
+    msg = Message(header=Header(id='x'),
+                  footer=Footer(severity='Error', code=100))
+    r = repr(msg)
+    assert 'footer' in r
+
+
+def test_message_repr_includes_response():
+    msg = Message(header=Header(id='x'), response=requests.Response())
+    r = repr(msg)
+    assert 'response' in r
+
+
