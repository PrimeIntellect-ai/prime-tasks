+trait ReceiveValue<T> {
+    fn into_message(self) -> T;
+    fn is_terminal(self) -> bool;
+}
+
+impl<T, E> ReceiveValue<T> for Result<T, E> {
+    fn into_message(self) -> T {
+        match self {
+            Ok(value) => value,
+            Err(_) => panic!("expected a received message"),
+        }
+    }
+
+    fn is_terminal(self) -> bool {
+        self.is_err()
+    }
+}
+
+impl<T> ReceiveValue<T> for Option<T> {
+    fn into_message(self) -> T {
+        self.expect("expected a received message")
+    }
+
+    fn is_terminal(self) -> bool {
+        self.is_none()
+    }
+}
+
+#[test]
+fn test_bounded_receiver_recv_messages_and_finishes_after_close() {
+    let (dropped_tx, dropped_rx) = oneshot::channel();
+    let (tx, mut rx) = mpsc::channel(1);
+    thread::spawn(move || {
+        block_on(async move {
+            send_one_two_three(tx).await;
+            dropped_tx.send(()).unwrap();
+        });
+    });
+
+    let res = block_on(async move {
+        let mut res = Vec::new();
+        for _ in 0..3 {
+            res.push(rx.recv().await.into_message());
+        }
+        dropped_rx.await.unwrap();
+        let terminal = rx.recv().await.is_terminal();
+        (res, terminal)
+    });
+    assert_eq!(res.0, [1, 2, 3]);
+    assert!(res.1, "a drained, closed receiver should report termination");
+}
