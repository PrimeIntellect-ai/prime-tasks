+    @pytest.mark.parametrize("num_wires", [1, 2, 3])
+    def test_apply_specialunitary(self, tol, num_wires):
+        """Tests that a special unitary is correctly applied"""
+        np.random.seed(2514)
+        theta = np.random.random(4**num_wires - 1)
+
+        dev = qml.device("default.mixed", wires=num_wires)
+        dev.apply([qml.SpecialUnitary(theta, wires=list(range(num_wires)))])
+
+        mat = qml.SpecialUnitary.compute_matrix(theta, num_wires)
+        init_rho = np.zeros((2**num_wires, 2**num_wires))
+        init_rho[0, 0] = 1
+        target_rho = mat @ init_rho @ mat.conj().T
+
+        assert np.allclose(dev.state, target_rho, atol=tol, rtol=0)
+
+    def test_special_unitary_supported(self):
+        """Tests that the default.mixed device supports SpecialUnitary natively.
+
+        Native support means the operation is not decomposed, so its parameters
+        remain trainable when the device is used with automatic differentiation.
+        """
+        dev = qml.device("default.mixed", wires=1)
+        assert dev.supports_operation("SpecialUnitary")
+
+    @pytest.mark.jax
+    def test_special_unitary_gradient(self):
+        """Tests that a SpecialUnitary gate on default.mixed is trainable with JAX,
+        i.e. that its gradient does not vanish."""
+        import jax
+
+        jax.config.update("jax_enable_x64", True)
+
+        dev = qml.device("default.mixed", wires=1)
+
+        @qml.qnode(dev, interface="jax")
+        def circuit(x):
+            qml.SpecialUnitary(x, wires=[0])
+            return qml.expval(qml.PauliZ(0))
+
+        x = jax.numpy.array([0.2, 0.1, 0.6])
+        grad = jax.grad(circuit)(x)
+
+        expected_grad = np.array([-0.68453361, -0.3422668, 0.03581418])
+        assert np.allclose(np.asarray(grad), expected_grad, atol=1e-6)
+
