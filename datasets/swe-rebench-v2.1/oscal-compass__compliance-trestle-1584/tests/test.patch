+def _validate_component_definition_port_range(
+    tmp_trestle_dir: pathlib.Path, monkeypatch: MonkeyPatch, port_range: dict, expected_rc: int
+) -> None:
+    """Validate a component-definition whose single port range is the given value."""
+    with open(test_data_dir / 'validate' / 'component-definitions' / 'x2' / 'component-definition.json') as f:
+        comp_def = json.load(f)
+    comp_def['component-definition']['components'][0]['protocols'][0]['port-ranges'] = [port_range]
+
+    tdir = tmp_trestle_dir / test_utils.COMPONENT_DEF_DIR / 'my_test_model'
+    tdir.mkdir(exist_ok=True, parents=True)
+    tpth = tdir / 'component-definition.json'
+    with open(tpth, 'w') as f:
+        json.dump(comp_def, f)
+
+    test_utils.execute_command_and_assert(f'trestle validate -f {tpth}', expected_rc, monkeypatch)
+
+
+def test_validate_component_definition_port_range_without_transport(
+    tmp_trestle_dir: pathlib.Path, monkeypatch: MonkeyPatch
+) -> None:
+    """A port range without a transport value is valid."""
+    _validate_component_definition_port_range(tmp_trestle_dir, monkeypatch, {'start': 443, 'end': 443}, 0)
+
+
+def test_validate_component_definition_port_range_negative_end(
+    tmp_trestle_dir: pathlib.Path, monkeypatch: MonkeyPatch
+) -> None:
+    """A port range with a negative end value is invalid."""
+    _validate_component_definition_port_range(tmp_trestle_dir, monkeypatch, {'start': 443, 'end': -443}, 1)
