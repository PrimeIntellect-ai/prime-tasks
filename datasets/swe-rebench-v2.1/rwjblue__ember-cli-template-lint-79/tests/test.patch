diff --git a/node-tests/unit/plugins/lint-bare-strings-test.js b/node-tests/unit/plugins/lint-bare-strings-test.js
index 08bec12..56f3d3e 100644
--- a/node-tests/unit/plugins/lint-bare-strings-test.js
+++ b/node-tests/unit/plugins/lint-bare-strings-test.js
@@ -28,8 +28,72 @@ generateRuleTests({
     '<!-- template-lint enabled=false -->'
   ],
 
-  bad: [
-    { template: '\n howdy', message: "Non-translated string used (\'layout.hbs\') `\n howdy`" },
-    { template: '1234', message: "Non-translated string used (\'layout.hbs\') `1234`" }
-  ]
+  bad: []
+});
+
+describe('bare-strings diagnostics', function() {
+  var assert = require('assert');
+  var compile = require('htmlbars').compile;
+  var plugins = require('../../../ext/plugins');
+
+  function lint(template, config) {
+    var messages = [];
+    var addonContext = {
+      logLintingError: function(pluginName, moduleName, message) {
+        messages.push(message);
+      },
+      loadConfig: function() {
+        return { 'bare-strings': config === undefined ? true : config };
+      }
+    };
+
+    compile(template, {
+      moduleName: 'layout.hbs',
+      plugins: {
+        ast: [plugins['bare-strings'](addonContext)]
+      }
+    });
+
+    return messages;
+  }
+
+  [
+    { template: '\n howdy', bare: '\n howdy' },
+    { template: '<div>\n  1234\n</div>', bare: '\n  1234\n' }
+  ].forEach(function(item) {
+    var template = item.template;
+
+    it('reports the bare string ' + JSON.stringify(item.bare) + ' without depending on location formatting', function() {
+      var messages = lint(template);
+
+      assert.strictEqual(messages.length, 1);
+      assert.ok(messages[0].indexOf('Non-translated string used') === 0, messages[0]);
+      assert.ok(messages[0].indexOf('`' + item.bare + '`') !== -1, messages[0]);
+    });
+
+    it('passes with ' + JSON.stringify(template) + ' when rule is disabled', function() {
+      assert.deepEqual(lint(template, false), []);
+    });
+
+    it('passes with ' + JSON.stringify(template) + ' when disabled via inline comment', function() {
+      var messages = [];
+      var addonContext = {
+        logLintingError: function(pluginName, moduleName, message) {
+          messages.push(message);
+        },
+        loadConfig: function() {
+          return { 'bare-strings': true };
+        }
+      };
+
+      compile('<!-- template-lint bare-strings=false -->\n' + template, {
+        moduleName: 'layout.hbs',
+        plugins: {
+          ast: [plugins['bare-strings'](addonContext)]
+        }
+      });
+
+      assert.deepEqual(messages, []);
+    });
+  });
 });
diff --git a/node-tests/unit/plugins/lint-block-indentation-test.js b/node-tests/unit/plugins/lint-block-indentation-test.js
index cfbc8b9..0a3e752 100644
--- a/node-tests/unit/plugins/lint-block-indentation-test.js
+++ b/node-tests/unit/plugins/lint-block-indentation-test.js
@@ -152,16 +152,47 @@ generateRuleTests({
         '  {{/some-thing}}\n' +
         '</div>',
       message: "Incorrect indentation for `some-thing` beginning at ('layout.hbs'@ L2:C18). Expected `{{/some-thing}}` ending at ('layout.hbs'@ L3:C17) to be at an indentation of 18 but was found at 2."
-    },
-    {
-      // Start and end of multi-line element must be aligned, even when start
-      // has other content preceding it on its line
-      template: '{{#if foo}}\n' +
-        '  {{foo}} <p>\n' +
-        '    Bar\n' +
-        '  </p>\n' +
-        '{{/if}}',
-      message: "Incorrect indentation for `p` beginning at ('layout.hbs'@ L2:C10). Expected `</p>` ending at ('layout.hbs'@ L4:C6) to be at an indentation of 10 but was found at 2."
     }
   ]
 });
+
+describe('block-indentation with text nodes in block contents', function() {
+  var assert = require('assert');
+  var compile = require('htmlbars').compile;
+  var plugins = require('../../../ext/plugins');
+
+  function lint(template) {
+    var messages = [];
+    var addonContext = {
+      logLintingError: function(pluginName, moduleName, message) {
+        messages.push(message);
+      },
+      loadConfig: function() {
+        return { 'block-indentation': 2 };
+      }
+    };
+
+    compile(template, {
+      moduleName: 'layout.hbs',
+      plugins: {
+        ast: [plugins['block-indentation'](addonContext)]
+      }
+    });
+
+    return messages;
+  }
+
+  it('does not report correctly indented leading whitespace in a block', function() {
+    assert.deepEqual(lint('{{#if foo}}\n  {{foo}}\n{{/if}}'), []);
+  });
+
+  it('reports genuine indentation problems while processing text in a block', function() {
+    var messages = lint('{{#if foo}}\n' +
+      '  {{foo}} <p>\n' +
+      '    Bar\n' +
+      '  </p>\n' +
+      '{{/if}}');
+
+    assert.ok(messages.length > 0, 'an indentation diagnostic should be reported');
+  });
+});
