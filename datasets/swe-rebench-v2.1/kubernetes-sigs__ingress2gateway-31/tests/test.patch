+// writeKubeConfig points KUBECONFIG at a kubeconfig whose current context
+// selects the "ctx-ns" namespace and talks to the given server.
+func writeKubeConfig(t *testing.T, server string) {
+	t.Helper()
+
+	dir, err := os.MkdirTemp("", "i2gw-kube")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+
+	kubeConfigFile := filepath.Join(dir, "config")
+	content := fmt.Sprintf(`apiVersion: v1
+kind: Config
+clusters:
+- cluster:
+    server: %s
+  name: test
+contexts:
+- context:
+    cluster: test
+    user: test
+    namespace: ctx-ns
+  name: test
+current-context: test
+users:
+- name: test
+  user: {}
+`, server)
+
+	if err := os.WriteFile(kubeConfigFile, []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Setenv("KUBECONFIG", kubeConfigFile); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func captureStdout(t *testing.T, f func()) string {
+	t.Helper()
+
+	old := os.Stdout
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	os.Stdout = w
+
+	done := make(chan string)
+	go func() {
+		var buf bytes.Buffer
+		_, _ = io.Copy(&buf, r)
+		done <- buf.String()
+	}()
+
+	f()
+
+	w.Close()
+	os.Stdout = old
+	return <-done
+}
