+// Test_printCmd_namespaceFlags verifies that the print command exposes the
+// --namespace/-n and --all-namespaces/-A flags required by the contract.
+func Test_printCmd_namespaceFlags(t *testing.T) {
+	namespaceFlag := printCmd.Flags().Lookup("namespace")
+	if namespaceFlag == nil {
+		namespaceFlag = printCmd.InheritedFlags().Lookup("namespace")
+	}
+	if namespaceFlag == nil {
+		t.Fatalf("expected the print command to expose a --namespace flag")
+	}
+	if namespaceFlag.Shorthand != "n" {
+		t.Errorf("expected --namespace shorthand to be %q, got %q", "n", namespaceFlag.Shorthand)
+	}
+
+	allNamespacesFlag := printCmd.Flags().Lookup("all-namespaces")
+	if allNamespacesFlag == nil {
+		allNamespacesFlag = printCmd.InheritedFlags().Lookup("all-namespaces")
+	}
+	if allNamespacesFlag == nil {
+		t.Fatalf("expected the print command to expose a --all-namespaces flag")
+	}
+	if allNamespacesFlag.Shorthand != "A" {
+		t.Errorf("expected --all-namespaces shorthand to be %q, got %q", "A", allNamespacesFlag.Shorthand)
+	}
+}
