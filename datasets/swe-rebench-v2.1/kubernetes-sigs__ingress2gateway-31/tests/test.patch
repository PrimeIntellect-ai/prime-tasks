+// startFakeAPIServer starts an HTTP server that mimics the subset of the
+// Kubernetes API used by the print command: discovery plus listing Ingresses.
+// Ingresses are returned according to the namespace encoded in the request
+// path, so a namespaced query only returns resources from that namespace.
+func startFakeAPIServer(t *testing.T) *httptest.Server {
+	t.Helper()
+
+	ingresses := []string{
+		ingressJSON("ing-foo", "foo"),
+		ingressJSON("ing-bar", "bar"),
+		ingressJSON("ing-ctx", "ctx-ns"),
+	}
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/api":
+			fmt.Fprint(w, `{"kind":"APIVersions","versions":["v1"],"serverAddressByClientCIDRs":[]}`)
+		case "/apis":
+			fmt.Fprint(w, `{"kind":"APIGroupList","apiVersion":"v1","groups":[{"name":"networking.k8s.io","versions":[{"groupVersion":"networking.k8s.io/v1","version":"v1"}],"preferredVersion":{"groupVersion":"networking.k8s.io/v1","version":"v1"}}]}`)
+		case "/api/v1":
+			fmt.Fprint(w, `{"kind":"APIResourceList","groupVersion":"v1","resources":[]}`)
+		case "/apis/networking.k8s.io/v1":
+			fmt.Fprint(w, `{"kind":"APIResourceList","apiVersion":"v1","groupVersion":"networking.k8s.io/v1","resources":[{"name":"ingresses","singularName":"ingress","namespaced":true,"kind":"Ingress","verbs":["get","list"]}]}`)
+		default:
+			items := ingresses
+			const prefix = "/apis/networking.k8s.io/v1/namespaces/"
+			if strings.HasPrefix(r.URL.Path, prefix) {
+				ns := strings.Split(strings.TrimPrefix(r.URL.Path, prefix), "/")[0]
+				items = nil
+				for _, ing := range ingresses {
+					if strings.Contains(ing, fmt.Sprintf(`"namespace":%q`, ns)) {
+						items = append(items, ing)
+					}
+				}
+			}
+			fmt.Fprintf(w, `{"kind":"IngressList","apiVersion":"networking.k8s.io/v1","metadata":{},"items":[%s]}`, strings.Join(items, ","))
+		}
+	}))
+	return srv
+}
+
+func ingressJSON(name, namespace string) string {
+	return fmt.Sprintf(`{"apiVersion":"networking.k8s.io/v1","kind":"Ingress","metadata":{"name":%q,"namespace":%q},"spec":{"rules":[{"host":%q,"http":{"paths":[{"path":"/","pathType":"Prefix","backend":{"service":{"name":"svc","port":{"number":80}}}}]}}]}}`,
+		name, namespace, name+".example.com")
+}
