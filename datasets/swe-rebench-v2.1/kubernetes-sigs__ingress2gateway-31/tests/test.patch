+// Test_printCmd_namespaceFiltering verifies that the namespace selected via the
+// command flags is applied to the resources that are queried and printed.
+func Test_printCmd_namespaceFiltering(t *testing.T) {
+	testCases := []struct {
+		name        string
+		args        []string
+		wantPresent []string
+		wantAbsent  []string
+	}{
+		{
+			name:        "namespace flag restricts output to the requested namespace",
+			args:        []string{"--namespace=foo"},
+			wantPresent: []string{"ing-foo"},
+			wantAbsent:  []string{"ing-bar", "ing-ctx"},
+		},
+		{
+			name:        "all-namespaces flag includes every namespace",
+			args:        []string{"-A"},
+			wantPresent: []string{"ing-foo", "ing-bar", "ing-ctx"},
+		},
+		{
+			name:        "current context namespace is used when no flag is given",
+			wantPresent: []string{"ing-ctx"},
+			wantAbsent:  []string{"ing-foo", "ing-bar"},
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			srv := startFakeAPIServer(t)
+			defer srv.Close()
+			writeKubeConfig(t, srv.URL)
+
+			for _, name := range []string{"namespace", "all-namespaces"} {
+				flag := printCmd.Flags().Lookup(name)
+				if flag == nil {
+					flag = printCmd.InheritedFlags().Lookup(name)
+				}
+				if flag != nil {
+					if err := flag.Value.Set(flag.DefValue); err != nil {
+						t.Fatalf("failed to reset --%s: %v", name, err)
+					}
+					flag.Changed = false
+				}
+			}
+
+			rootCmd.SetArgs(append([]string{"print"}, tc.args...))
+			var runErr error
+			output := captureStdout(t, func() {
+				runErr = rootCmd.Execute()
+			})
+			if runErr != nil {
+				t.Fatalf("print command returned error: %v", runErr)
+			}
+
+			for _, want := range tc.wantPresent {
+				if !strings.Contains(output, want) {
+					t.Errorf("expected output to contain %q, got:\n%s", want, output)
+				}
+			}
+			for _, absent := range tc.wantAbsent {
+				if strings.Contains(output, absent) {
+					t.Errorf("expected output not to contain %q, got:\n%s", absent, output)
+				}
+			}
+		})
+	}
+}
