+func TestGeneratePrivateDefault(t *testing.T) {
+	withAWSResponses(t)
+	generator, ok := genv1alpha1.GetGeneratorByName("ECRAuthorizationToken")
+	if !ok {
+		t.Fatal("ECR token generator is not registered")
+	}
+	spec := &apiextensions.JSON{Raw: []byte(`apiVersion: generators.external-secrets.io/v1alpha1
+kind: ECRAuthorizationToken
+spec:
+  region: us-east-1`)}
+	got, err := generator.Generate(context.Background(), spec, nil, "")
+	if err != nil {
+		t.Fatalf("Generate() returned an error: %v", err)
+	}
+	want := map[string][]byte{
+		"username":       []byte("private-user"),
+		"password":       []byte("private-pass"),
+		"proxy_endpoint": []byte("https://private.example"),
+		"expires_at":     []byte("1234"),
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("Generate() = %v, want %v", got, want)
+	}
+}
