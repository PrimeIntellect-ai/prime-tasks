+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripFunc) RoundTrip(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+func withAWSResponses(t *testing.T) {
+	withAWSResponse(t, base64.StdEncoding.EncodeToString([]byte("private-user:private-pass")))
+}
+
+func withAWSResponse(t *testing.T, privateToken string) {
+	t.Helper()
+	t.Setenv("AWS_ACCESS_KEY_ID", "test-access-key")
+	t.Setenv("AWS_SECRET_ACCESS_KEY", "test-secret-key")
+	t.Setenv("AWS_REGION", "us-east-1")
+	previous := http.DefaultTransport
+	http.DefaultTransport = roundTripFunc(func(req *http.Request) (*http.Response, error) {
+		var body string
+		contentType := "application/x-amz-json-1.1"
+		if strings.Contains(req.URL.Host, "sts") {
+			contentType = "text/xml"
+			body = `<AssumeRoleResponse xmlns="https://sts.amazonaws.com/doc/2011-06-15/"><AssumeRoleResult><Credentials><AccessKeyId>assumed-key</AccessKeyId><SecretAccessKey>assumed-secret</SecretAccessKey><SessionToken>assumed-session</SessionToken><Expiration>2030-01-01T00:00:00Z</Expiration></Credentials><AssumedRoleUser><AssumedRoleId>role-id:session</AssumedRoleId><Arn>arn:aws:sts::123456789012:assumed-role/my-role/session</Arn></AssumedRoleUser></AssumeRoleResult><ResponseMetadata><RequestId>request-id</RequestId></ResponseMetadata></AssumeRoleResponse>`
+		} else if strings.Contains(req.URL.Host, "ecr-public") {
+			body = `{"authorizationData":{"authorizationToken":"` + base64.StdEncoding.EncodeToString([]byte("public-user:public-pass")) + `","expiresAt":5678}}`
+		} else {
+			body = `{"authorizationData":[{"authorizationToken":"` + privateToken + `","expiresAt":1234,"proxyEndpoint":"https://private.example"}]}`
+		}
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Header:     http.Header{"Content-Type": []string{contentType}},
+			Body:       io.NopCloser(strings.NewReader(body)),
+			Request:    req,
+		}, nil
+	})
+	t.Cleanup(func() { http.DefaultTransport = previous })
+}
