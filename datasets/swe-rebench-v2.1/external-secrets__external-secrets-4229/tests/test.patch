+func TestGeneratePublicAuthorizationToken(t *testing.T) {
+	withAWSResponses(t)
+	// Public authorization may be exposed as a public scope on the existing
+	// generator or as its own generator kind.
+	candidates := []struct {
+		kind string
+		spec string
+	}{
+		{kind: "ECRAuthorizationToken", spec: `scope: public`},
+		{kind: "ECRPublicAuthorizationToken", spec: ``},
+	}
+	var failures []string
+	for _, candidate := range candidates {
+		generator, ok := genv1alpha1.GetGeneratorByName(candidate.kind)
+		if !ok {
+			continue
+		}
+		spec := &apiextensions.JSON{Raw: []byte(`apiVersion: generators.external-secrets.io/v1alpha1
+kind: ` + candidate.kind + `
+spec:
+  region: us-east-1
+  ` + candidate.spec)}
+		got, err := generator.Generate(context.Background(), spec, nil, "")
+		if err == nil && string(got["username"]) == "public-user" && string(got["password"]) == "public-pass" {
+			return
+		}
+		if err != nil {
+			failures = append(failures, candidate.kind+": "+err.Error())
+		} else {
+			failures = append(failures, candidate.kind+": returned different credentials")
+		}
+	}
+	t.Fatalf("public authorization-token generation was unavailable or returned incorrect credentials: %s", strings.Join(failures, "; "))
 }
