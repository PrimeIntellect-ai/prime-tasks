+def _make_simulated_dl1(path, write_images):
+    """
+    Write a small simulated DL1 file with the public DataWriter,
+    without relying on any downloaded dataset.
+    """
+    from types import SimpleNamespace
+
+    import numpy as np
+    from astropy import units as u
+
+    from ctapipe.containers import (
+        ArrayEventContainer,
+        DL1CameraContainer,
+        ImageParametersContainer,
+        SimulatedCameraContainer,
+        SimulatedEventContainer,
+        SimulationConfigContainer,
+        TelescopePointingContainer,
+    )
+    from ctapipe.instrument import (
+        CameraDescription,
+        CameraGeometry,
+        CameraReadout,
+        OpticsDescription,
+        SubarrayDescription,
+        TelescopeDescription,
+    )
+    from ctapipe.io.datawriter import DataWriter
+
+    optics = OpticsDescription(
+        "LST",
+        num_mirrors=1,
+        equivalent_focal_length=28 * u.m,
+        mirror_area=386 * u.m**2,
+        num_mirror_tiles=198,
+    )
+    geometry = CameraGeometry.make_rectangular(npix_x=10, npix_y=10)
+    readout = CameraReadout(
+        "synthetic",
+        sampling_rate=1 * u.GHz,
+        reference_pulse_shape=np.ones((1, 10)),
+        reference_pulse_sample_width=1 * u.ns,
+    )
+    camera = CameraDescription("synthetic", geometry, readout)
+    telescope = TelescopeDescription("LST", "LST", optics, camera)
+    subarray = SubarrayDescription(
+        "synthetic",
+        tel_positions={1: [0, 0, 0] * u.m},
+        tel_descriptions={1: telescope},
+    )
+    source = SimpleNamespace(
+        is_simulation=True,
+        subarray=subarray,
+        obs_ids=[1],
+        simulation_config={1: SimulationConfigContainer()},
+    )
+
+    n_pix = geometry.n_pixels
+
+    def make_event(event_id):
+        event = ArrayEventContainer()
+        event.index.obs_id = 1
+        event.index.event_id = event_id
+        event.trigger.time = 1000.0 * u.s
+        event.trigger.tels_with_trigger = [1]
+        event.pointing.array_altitude = 70 * u.deg
+        event.pointing.array_azimuth = 0 * u.deg
+        event.pointing.tel[1] = TelescopePointingContainer(
+            altitude=70 * u.deg, azimuth=0 * u.deg
+        )
+        event.simulation = SimulatedEventContainer()
+        event.simulation.tel[1] = SimulatedCameraContainer(
+            true_image=np.arange(n_pix, dtype=np.int32),
+            true_image_sum=float(np.arange(n_pix).sum()),
+            true_parameters=ImageParametersContainer(),
+        )
+        event.dl1.tel[1] = DL1CameraContainer(
+            image=np.arange(n_pix, dtype=np.float32),
+            parameters=ImageParametersContainer(),
+        )
+        return event
+
+    with DataWriter(
+        event_source=source,
+        output_path=path,
+        overwrite=True,
+        write_images=write_images,
+        write_parameters=True,
+    ) as writer:
+        for event_id in range(3):
+            writer(make_event(event_id))
+
+    return path
+
+
+def test_simulated_true_image_sum_without_true_image(tmp_path):
+    """
+    The simulated image table keeps the true image sum when the full
+    true image is not requested, and only then the full true image
+    is omitted.
+    """
+    with_images = _make_simulated_dl1(tmp_path / "with_images.dl1.h5", True)
+    without_images = _make_simulated_dl1(tmp_path / "without_images.dl1.h5", False)
+
+    t = read_table(with_images, "/simulation/event/telescope/images/tel_001")
+    assert "true_image" in t.colnames
+    assert "true_image_sum" in t.colnames
+
+    t = read_table(without_images, "/simulation/event/telescope/images/tel_001")
+    assert "true_image" not in t.colnames
+    assert "true_image_sum" in t.colnames
+
+
+def test_merge_skip_images_keeps_true_image_sum(tmp_path):
+    """
+    Merging with --skip-images keeps the true image sum
+    while the full true image is omitted.
+    """
+    from ctapipe.tools.merge import MergeTool
+
+    input_path = _make_simulated_dl1(tmp_path / "input.dl1.h5", True)
+    output = tmp_path / "merged_skip_images.dl1.h5"
+    ret = run_tool(
+        MergeTool(),
+        argv=[str(input_path), f"--output={output}", "--skip-images", "--overwrite"],
+        cwd=tmp_path,
+    )
+    assert ret == 0
+
+    t = read_table(output, "/simulation/event/telescope/images/tel_001")
+    assert "true_image" not in t.colnames
+    assert "true_image_sum" in t.colnames
+    assert len(t) == 3
+
+    with tables.open_file(output, "r") as f:
+        assert "images" not in f.root.dl1.event.telescope
