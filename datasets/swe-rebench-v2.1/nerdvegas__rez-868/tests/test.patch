+"""Behavioral checks for package ordering configured through rezconfig."""
+
+import os
+import sys
+import tempfile
+
+from rez.config import config
+from rez.tests.util import TestBase
+from rez.vendor.version.requirement import Requirement
+
+
+class TestConfiguredPackageOrdering(TestBase):
+    @classmethod
+    def setUpClass(cls):
+        dirname = os.path.realpath(os.path.dirname(__file__))
+        cls.package_path = os.path.join(dirname, "data", "packages", "py_packages")
+        cls.settings = dict(
+            packages_path=[cls.package_path],
+            package_filter=None,
+            implicit_packages=[],
+            resolve_caching=False)
+
+    def test_family_scoped_soft_timestamp_is_used_for_resolution(self):
+        config.override("package_orderers", [
+            {
+                "type": "per_family",
+                "orderers": [
+                    {
+                        "type": "soft_timestamp",
+                        "packages": ["timestamped"],
+                        "timestamp": 3001,
+                        "rank": 3
+                    }
+                ]
+            }
+        ])
+
+        import collections
+        from collections import abc
+
+        aliases = ("Sequence", "MutableSequence", "Set", "MutableSet",
+                   "KeysView", "ValuesView", "ItemsView")
+        missing = [name for name in aliases if not hasattr(collections, name)]
+        for name in missing:
+            setattr(collections, name, getattr(abc, name))
+        import hashlib
+
+        # This older codebase hashes text directly; adapt that call for Python 3.
+        original_sha1 = hashlib.sha1
+
+        def compatible_sha1(data=b"", *args, **kwargs):
+            if isinstance(data, str):
+                data = data.encode("utf-8")
+            return original_sha1(data, *args, **kwargs)
+
+        hashlib.sha1 = compatible_sha1
+        try:
+            from rez.resolved_context import ResolvedContext
+        finally:
+            hashlib.sha1 = original_sha1
+            for name in missing:
+                delattr(collections, name)
+
+        original_stdin = sys.stdin
+        try:
+            with open(os.devnull) as sys.stdin:
+                context = ResolvedContext(
+                    [Requirement("timestamped")],
+                    package_paths=[self.package_path], caching=False,
+                    add_implicit_packages=False, verbosity=0)
+                with tempfile.TemporaryDirectory() as unlisted_path:
+                    for version, timestamp in (("1.1.0", 3000),
+                                               ("1.1.1", 4000),
+                                               ("2.1.5", 8000)):
+                        package_dir = os.path.join(
+                            unlisted_path, "other_timestamped", version)
+                        os.makedirs(package_dir)
+                        with open(os.path.join(package_dir, "package.py"), "w") as f:
+                            f.write("name = 'other_timestamped'\n")
+                            f.write("version = '%s'\n" % version)
+                            f.write("timestamp = %d\n" % timestamp)
+
+                    unlisted_family_context = ResolvedContext(
+                        [Requirement("other_timestamped")],
+                        package_paths=[self.package_path, unlisted_path],
+                        caching=False, add_implicit_packages=False,
+                        verbosity=0)
+        finally:
+            sys.stdin = original_stdin
+
+        self.assertTrue(context.success)
+        self.assertEqual("1.1.1", str(context.resolved_packages[0].version))
+        self.assertTrue(unlisted_family_context.success)
+        self.assertEqual(
+            "2.1.5",
+            str(unlisted_family_context.resolved_packages[0].version))
