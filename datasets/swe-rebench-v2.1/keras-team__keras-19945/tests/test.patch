+
+    def test_fit_with_custom_python_generator_one_batch(self):
+        # A Python generator yielding a single batch must drive one training
+        # step; the batch must not be consumed by the model build step.
+        x = np.random.rand(4, 3).astype("float32")
+        y = np.random.rand(4, 1).astype("float32")
+
+        def generator():
+            yield x, y
+
+        model = Sequential([layers.Input(shape=(3,)), layers.Dense(1)])
+        model.compile(optimizer="sgd", loss="mse")
+        history = model.fit(
+            generator(), epochs=1, steps_per_epoch=1, verbose=0
+        )
+        self.assertLen(history.history["loss"], 1)
