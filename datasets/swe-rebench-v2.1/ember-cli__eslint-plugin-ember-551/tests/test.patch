+'use strict';
+
+//------------------------------------------------------------------------------
+// Requirements
+//------------------------------------------------------------------------------
+
+const assert = require('assert');
+const plugin = require('../../../lib');
+const rule = plugin.rules['no-classic-components'];
+const RuleTester = require('eslint').RuleTester;
+
+//------------------------------------------------------------------------------
+// Tests
+//------------------------------------------------------------------------------
+
+assert.ok(rule, 'the plugin should expose no-classic-components');
+
+const parserOptions = {
+  ecmaVersion: 6,
+  sourceType: 'module',
+};
+const ruleTester = new RuleTester({ parserOptions });
+
+ruleTester.run('no-classic-components', rule, {
+  valid: ["import Component from '@glimmer/component';"],
+
+  invalid: [
+    {
+      code: "import Component from '@ember/component';",
+      errors: 1,
+    },
+  ],
+});
