diff --git a/lib/rules/no-classic-components.js b/lib/rules/no-classic-components.js
new file mode 100644
index 00000000..f3db6fc5
--- /dev/null
+++ b/lib/rules/no-classic-components.js
@@ -0,0 +1,35 @@
+'use strict';
+
+const ERROR_MESSAGE =
+  'Use Glimmer components(@glimmer/component) instead of classic components(@ember/component)';
+
+module.exports = {
+  meta: {
+    docs: {
+      description: 'Enforces Glimmer components',
+      category: 'Ember Octane',
+      recommended: false,
+      url:
+        'https://github.com/ember-cli/eslint-plugin-ember/tree/master/docs/rules/no-classic-components.md',
+    },
+    fixable: null,
+  },
+
+  ERROR_MESSAGE,
+
+  create(context) {
+    const report = function(node) {
+      context.report(node, ERROR_MESSAGE);
+    };
+
+    return {
+      ImportDeclaration(node) {
+        const importSource = node.source.value;
+
+        if (importSource === '@ember/component') {
+          report(node);
+        }
+      },
+    };
+  },
+};
