+/// Regression test for https://github.com/tafia/quick-xml/issues/671.
+///
+/// A present but empty optional attribute must deserialize as `Some("")`,
+/// distinct from a missing attribute which deserializes as `None`.
+#[test]
+fn issue671() {
+    #[derive(Debug, Deserialize, Serialize, PartialEq, Eq)]
+    struct Name {
+        #[serde(rename = "@first_name", skip_serializing_if = "Option::is_none")]
+        first_name: Option<String>,
+        #[serde(rename = "@second_name", skip_serializing_if = "Option::is_none")]
+        second_name: Option<String>,
+    }
+
+    let expected = Name {
+        first_name: Some("aaa".to_string()),
+        second_name: Some("".to_string()),
+    };
+
+    let name = from_str::<Name>(r#"<Name first_name="aaa" second_name=""/>"#).unwrap();
+    assert_eq!(expected, name);
+
+    let s = to_string(&name).unwrap();
+    assert_eq!(r#"<Name first_name="aaa" second_name=""/>"#, s);
+}
