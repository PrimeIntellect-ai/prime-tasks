diff --git a/tests/lib/rules/require-fetch-import.js b/tests/lib/rules/require-fetch-import.js
new file mode 100644
index 0000000..cbb0aef
--- /dev/null
+++ b/tests/lib/rules/require-fetch-import.js
@@ -0,0 +1,54 @@
+'use strict';
+
+const rule = require('../../../lib/rules/require-fetch-import');
+const plugin = require('../../../lib');
+const RuleTester = require('eslint').RuleTester;
+
+const ERROR_MESSAGE = 'Explicitly import `fetch` instead of using `window.fetch`';
+
+const ruleTester = new RuleTester({
+  parserOptions: { ecmaVersion: 6, sourceType: 'module' },
+  env: { browser: true },
+});
+
+ruleTester.run('require-fetch-import', rule, {
+  valid: [
+    `
+      import fetch from 'fetch';
+
+      fetch('/something');
+    `,
+    `
+      fetch('/something');
+
+      import fetch from 'fetch';
+    `,
+    `
+      import { default as fetch } from 'fetch';
+
+      fetch('/something');
+    `,
+    "foo('/something');",
+  ],
+
+  invalid: [
+    {
+      code: "fetch('/something');",
+      errors: [{ message: ERROR_MESSAGE }],
+    },
+    {
+      code: "fetch('/one');\nfetch('/two');",
+      errors: [{ message: ERROR_MESSAGE }, { message: ERROR_MESSAGE }],
+    },
+  ],
+});
+
+describe('require-fetch-import', () => {
+  it('is available in the plugin rule registry', () => {
+    expect(plugin.rules).toHaveProperty('require-fetch-import');
+  });
+
+  it('exports the required error message', () => {
+    expect(rule.ERROR_MESSAGE).toBe(ERROR_MESSAGE);
+  });
+});
