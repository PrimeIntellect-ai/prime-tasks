+function test_issue_3812()
+    model = Model()
+    @variable(model, b, Bin)
+    @variable(model, x)
+    c = @constraint(model, b => {x in MOI.EqualTo(1.0)})
+    o = constraint_object(c)
+    @test length(o.func) == 2
+    # The function may be represented either as `[b, x]` or as an equivalent
+    # vector-affine function, so compare the components after converting to a
+    # common representation.
+    @test isequal_canonical(convert(AffExpr, o.func[1]), convert(AffExpr, b))
+    @test isequal_canonical(convert(AffExpr, o.func[2]), convert(AffExpr, x))
+    @test o.set == MOI.Indicator{MOI.ACTIVATE_ON_ONE}(MOI.EqualTo(1.0))
+    return
+end
+
 end  # module
