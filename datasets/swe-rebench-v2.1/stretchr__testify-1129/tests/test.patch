+func TestNotErrorAsAssertionBehavior(t *testing.T) {
+	tests := []struct {
+		err    error
+		result bool
+	}{
+		{fmt.Errorf("wrap: %w", &customError{}), false},
+		{io.EOF, true},
+		{nil, true},
+	}
+	for _, tt := range tests {
+		tt := tt
+		var target *customError
+		t.Run(fmt.Sprintf("NotErrorAs(%#v,%#v)", tt.err, target), func(t *testing.T) {
+			mockT := new(testing.T)
+			res := NotErrorAs(mockT, tt.err, &target)
+			if res != tt.result {
+				t.Errorf("NotErrorAs(%#v,%#v) should not return %t", tt.err, target, tt.result)
+			}
+			if res == mockT.Failed() {
+				t.Errorf("The test result (%t) should be reflected in the testing.T type (%t)", res, !mockT.Failed())
 			}
 		})
 	}
 }
+
+func TestRequireNotErrorAsConvenience(t *testing.T) {
+	program := `package main
+
+import (
+"errors"
+"fmt"
+
+"github.com/stretchr/testify/require"
+)
+
+type typedError struct{}
+
+func (*typedError) Error() string { return "typed error" }
+
+type recordingT struct {
+failed  bool
+stopped bool
+}
+
+func (t *recordingT) Errorf(string, ...interface{}) { t.failed = true }
+func (t *recordingT) FailNow()                     { t.stopped = true }
+
+func main() {
+var target *typedError
+passing := new(recordingT)
+require.NotErrorAs(passing, errors.New("unrelated"), &target)
+if passing.failed || passing.stopped {
+panic("require.NotErrorAs failed for an unrelated error")
+}
+
+failing := new(recordingT)
+require.NotErrorAs(failing, fmt.Errorf("wrapped: %w", &typedError{}), &target)
+if !failing.failed || !failing.stopped {
+panic("require.NotErrorAs did not stop after a matching error")
+}
+}
+`
+	workingDir, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	moduleRoot := filepath.Dir(workingDir)
+	file, err := os.CreateTemp(moduleRoot, "require-not-error-as-*.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(file.Name())
+	if _, err := file.WriteString(program); err != nil {
+		file.Close()
+		t.Fatal(err)
+	}
+	if err := file.Close(); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("go", "run", file.Name())
+	cmd.Dir = moduleRoot
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("require.NotErrorAs public API failed: %v\n%s", err, output)
+	}
+}
