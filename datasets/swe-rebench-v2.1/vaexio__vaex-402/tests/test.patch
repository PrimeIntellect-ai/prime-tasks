+@pytest.mark.parametrize('how', ['left', 'right'])
+def test_join_mixed_unmatched_text_presentation(how):
+    left = vaex.from_arrays(key=np.array(['A', 'B', 'B', 'C']),
+                            left_value=np.array([0, 1, 2, 3]))
+    right = vaex.from_arrays(key=np.array(['B', 'C', 'D']),
+                             right_value=np.array([10, 20, 30]))
+    joined = left.join(right, on='key', how=how, rsuffix='_right', allow_duplication=True)
+
+    repr(joined)
+    str(joined)
+    print(joined)
