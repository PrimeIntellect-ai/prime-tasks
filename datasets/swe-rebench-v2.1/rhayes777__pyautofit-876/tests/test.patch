+import os
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
 from autoconf.conf import with_config
 
+import autofit as af
+from autofit.non_linear.grid import sensitivity as s
+
 
 @with_config("general", "model", "ignore_prior_limits", value=True)
 def test_sensitivity(sensitivity):
@@ -19,3 +28,70 @@ def test_sensitivity(sensitivity):
         )
         assert "     0,  0.25,  0.25,  0.25,   2.0,   2.0,   0.0\n" in all_lines
         assert "     1,  0.25,  0.25,  0.75,   2.0,   2.0,   0.0\n" in all_lines
+
+
+def test_serial(sensitivity):
+    sensitivity.number_of_cores = 1
+
+    results = sensitivity.run()
+    assert len(results) == 8
+
+
+def test_number_of_cores_stored(sensitivity):
+    sensitivity_with_none = s.Sensitivity(
+        simulation_instance=sensitivity.instance,
+        base_model=sensitivity.model,
+        perturb_model=sensitivity.perturb_model,
+        simulate_cls=sensitivity.simulate_cls,
+        base_fit_cls=sensitivity.base_fit_cls,
+        perturb_fit_cls=sensitivity.perturb_fit_cls,
+        paths=af.DirectoryPaths(),
+        number_of_steps=2,
+        number_of_cores=None,
+    )
+
+    assert sensitivity_with_none.number_of_cores is None
+
+
+class JobError(Exception):
+    pass
+
+
+def failing_fit(dataset, model, paths):
+    raise JobError("job failed")
+
+
+@with_config("general", "model", "ignore_prior_limits", value=True)
+def test_job_exception_propagated(sensitivity):
+    sensitivity.perturb_fit_cls = failing_fit
+
+    with pytest.raises(JobError):
+        sensitivity.run()
+
+
+class ConstantFit:
+    def __call__(self, dataset, model, paths):
+        return SimpleNamespace(log_likelihood=0.0)
+
+
+class RecordingFit:
+    def __init__(self, worker_directory):
+        self.worker_directory = worker_directory
+
+    def __call__(self, dataset, model, paths):
+        time.sleep(0.25)
+        self.worker_directory.mkdir(parents=True, exist_ok=True)
+        (self.worker_directory / f"{os.getpid()}-{threading.get_ident()}").touch()
+        return SimpleNamespace(log_likelihood=0.0)
+
+
+@with_config("general", "model", "ignore_prior_limits", value=True)
+def test_parallel_uses_multiple_workers(sensitivity, tmp_path):
+    sensitivity.number_of_cores = 3
+    sensitivity.base_fit_cls = ConstantFit()
+    sensitivity.perturb_fit_cls = RecordingFit(tmp_path / "workers")
+
+    results = sensitivity.run()
+
+    assert len(results) == 8
+    assert len(list((tmp_path / "workers").iterdir())) > 1
