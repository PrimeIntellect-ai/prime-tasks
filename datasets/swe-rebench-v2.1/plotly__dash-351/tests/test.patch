+    def test_pathname_prefix_assets(self):
+        from dash._utils import get_asset_path
+
+        req = '/'
+        routes = '/'
+        path = get_asset_path(req, routes, 'reset.css')
+        self.assertEqual('/assets/reset.css', path)
+
+        req = '/requests/'
+        path = get_asset_path(req, routes, 'reset.css')
+        self.assertEqual('/requests/assets/reset.css', path)
+
+        req = '/requests/routes/'
+        routes = '/routes/'
+        path = get_asset_path(req, routes, 'reset.css')
+        self.assertEqual('/requests/assets/reset.css', path)
+
+    def test_assets_served_with_requests_pathname_prefix(self):
+        props = {
+            'children': {'type': {'name': 'node'}, 'required': False,
+                         'description': ''},
+            'id': {'type': {'name': 'string'}, 'required': False,
+                   'description': ''},
+        }
+        Div = generate_class('Div', props, '', 'dash_html_components')
+
+        app = dash.Dash(
+            assets_folder='tests/assets',
+            assets_ignore='.*ignored.*',
+            url_base_pathname=None,
+            requests_pathname_prefix='/requests/',
+            routes_pathname_prefix='/',
+        )
+        app.layout = Div(id='root')
+
+        response = app.server.test_client().get('/')
+        self.assertEqual(200, response.status_code)
+        body = response.get_data(as_text=True)
+        self.assertIn('/requests/assets/reset.css', body)
+
 
 if __name__ == '__main__':
     unittest.main()
