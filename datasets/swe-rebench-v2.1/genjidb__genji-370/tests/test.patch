+// TestIssue360DropIndexExplainQueryNoCrash reproduces https://github.com/genjidb/genji/issues/360:
+// after dropping an index, running a query that would have used it must not crash.
+func TestIssue360DropIndexExplainQueryNoCrash(t *testing.T) {
+	db, err := genji.Open(":memory:")
+	require.NoError(t, err)
+	defer db.Close()
+
+	require.NoError(t, db.Exec("CREATE TABLE foo"))
+	require.NoError(t, db.Exec("CREATE INDEX idx_foo_a ON foo(a)"))
+	require.NoError(t, db.Exec("INSERT INTO foo (a) VALUES ([1, 2, 3])"))
+	require.NoError(t, db.Exec("INSERT INTO foo (a) VALUES ([4, 5, 6])"))
+
+	require.NoError(t, db.Exec("DROP INDEX idx_foo_a"))
+
+	// Running the same query after dropping the index must return a plan.
+	doc, err := db.QueryDocument("EXPLAIN SELECT * FROM foo WHERE a = [1, 2, 3]")
+	require.NoError(t, err)
+	plan, err := doc.GetByField("plan")
+	require.NoError(t, err)
+	require.NotEmpty(t, plan.V)
+}
