+        def _hamiltonians_allclose(h1, h2):
+            """Compare two Hamiltonians up to floating-point tolerance."""
+            pr1, pr2 = h1.pauli_rep, h2.pauli_rep
+            if pr1 is None or pr2 is None:
+                return h1.compare(h2)
+            pr1.simplify()
+            pr2.simplify()
+            if set(pr1.keys()) != set(pr2.keys()):
+                return False
+            return all(qml.math.allclose(pr1[k], pr2[k]) for k in pr1)
+
+        assert _hamiltonians_allclose(cost_h, cost_hamiltonian)
+        assert _hamiltonians_allclose(mixer_h, mixer_hamiltonian)
