+            qaoa.mixer_layer(alpha, mixer)
+
+        actual = qml.matrix(qml.tape.QuantumScript(rec.operations, []), wire_order=mixer.wires)
+        expected = qml.matrix(qml.ApproxTimeEvolution(mixer, alpha, 1), wire_order=mixer.wires)
+        assert qml.math.allclose(actual, expected)
