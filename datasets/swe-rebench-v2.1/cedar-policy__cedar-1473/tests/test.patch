+    /// Duplicate errors expose the documented display text through the public API.
+    #[test]
+    fn duplicate_error_display_includes_conflicting_uid() {
+        let first = Entity::from_json_value(
+            serde_json::json!({
+                "uid" : { "type" : "User", "id" : "alice" },
+                "attrs" : {"location": "Greenland"},
+                "parents": []
+            }),
+            None,
+        )
+        .unwrap();
+        let second = Entity::from_json_value(
+            serde_json::json!({
+                "uid" : { "type" : "User", "id" : "alice" },
+                "attrs" : {"location": "London"},
+                "parents": []
+            }),
+            None,
+        )
+        .unwrap();
+
+        let error = Entities::from_entities([first, second], None).unwrap_err();
+        assert_eq!(
+            error.to_string(),
+            r#"duplicate entity entry `User::"alice"`"#
+        );
+        assert_matches!(error, EntitiesError::Duplicate(_));
+    }
+
+    /// Structurally identical duplicates within the iterator are ignored by
