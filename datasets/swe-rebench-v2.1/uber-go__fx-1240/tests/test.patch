@@ -415,3 +426,46 @@ func TestConsoleLogger(t *testing.T) {
 func joinLines(lines ...string) string {
 	return strings.Join(lines, "\n") + "\n"
 }
+
+type runEventRecorder struct {
+	runs []*fxevent.Run
+}
+
+func (r *runEventRecorder) LogEvent(event fxevent.Event) {
+	if run, ok := event.(*fxevent.Run); ok {
+		r.runs = append(r.runs, run)
+	}
+}
+
+type runtimeProbe struct{}
+
+func slowRuntimeConstructor() runtimeProbe {
+	time.Sleep(10 * time.Millisecond)
+	return runtimeProbe{}
+}
+
+func TestRunEventIncludesConstructorRuntime(t *testing.T) {
+	recorder := new(runEventRecorder)
+	app := fx.New(
+		fx.Provide(slowRuntimeConstructor),
+		fx.Invoke(func(runtimeProbe) {}),
+		fx.WithLogger(func() fxevent.Logger { return recorder }),
+	)
+	require.NoError(t, app.Err())
+
+	for _, run := range recorder.runs {
+		if strings.Contains(run.Name, "slowRuntimeConstructor") {
+			assert.Equal(t, "provide", run.Kind)
+			runtimeField := reflect.ValueOf(run).Elem().FieldByName("Runtime")
+			if !runtimeField.IsValid() || !runtimeField.CanInterface() {
+				t.Fatal("Run does not expose a public Runtime field")
+			}
+			if runtimeField.Type() != reflect.TypeOf(time.Duration(0)) {
+				t.Fatalf("Run.Runtime has type %v, want time.Duration", runtimeField.Type())
+			}
+			assert.GreaterOrEqual(t, time.Duration(runtimeField.Int()), 10*time.Millisecond)
+			return
+		}
+	}
+	t.Fatal("Fx did not emit a Run event for the constructor")
+}
