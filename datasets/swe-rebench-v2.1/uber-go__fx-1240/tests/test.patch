+// assertEventFields compares the structured fields logged for an event with
+// the expected ones. Run events may carry additional fields, so for them only
+// the expected fields must be present with the expected values.
+func assertEventFields(t *testing.T, give Event, want, got map[string]interface{}) {
+	t.Helper()
+
+	if _, isRun := give.(*Run); !isRun {
+		assert.Equal(t, want, got)
+		return
+	}
+	for key, value := range want {
+		assert.Equal(t, value, got[key], "field %q", key)
+	}
+}
