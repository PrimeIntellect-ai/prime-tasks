+    @pytest.mark.unit
+    def test_cli_wraps_multi_paragraph_description(self):
+        """Wrap long description paragraphs through the command-line path."""
+        source = (
+            "def func():\n"
+            '    """Summary.\n\n'
+            "    This line is quite long. In fact it is longer than eighty "
+            "characters so it should be wrapped after some words and still be "
+            "wrapped.\n\n"
+            "    Another paragraph is also quite long and should be split "
+            "onto multiple lines instead of remaining as one unwrapped "
+            "description paragraph.\n"
+            '    """\n'
+        )
+        result = subprocess.run(
+            [
+                sys.executable,
+                "-m",
+                "docformatter",
+                "--wrap-descriptions",
+                "60",
+                "--wrap-summaries",
+                "120",
+                "-",
+            ],
+            input=source,
+            capture_output=True,
+            text=True,
+            check=True,
+        )
+
+        formatted_docstring = result.stdout.split('"""')[1]
+        paragraphs = formatted_docstring.strip().split("\n\n")
+        description_paragraphs = paragraphs[1:]
+        assert len(description_paragraphs) == 2
+        assert all(
+            len(paragraph.splitlines()) > 1
+            for paragraph in description_paragraphs
+        )
+        assert all(
+            len(line) <= 60
+            for paragraph in description_paragraphs
+            for line in paragraph.splitlines()
+        )
+        assert "wrapped." in description_paragraphs[0]
+        assert "description paragraph." in description_paragraphs[1]
+
