+#[test]
+// https://github.com/gleam-lang/gleam/issues/4499
+fn fill_labels_with_function_with_unlabelled_arguments() {
+    let src = "
+pub fn main() {
+    fold(0, over: [], with: fn(acc, item) { acc + item })
+}
+
+pub fn fold(over list, from initial, with fun) { todo }";
+
+    // The positional argument `0` is passed to the labelled parameter `from`,
+    // so no label is actually missing. The code action must never produce
+    // invalid code: it can either not be offered at all, or fill the label in
+    // the correct position. What it must not do is append the label at the
+    // end, which would break the call's arity.
+    let project = TestProject::for_source(src);
+    let range = find_position_of("fold").to_selection().find_range(src);
+    let actions = actions_with_title(vec![FILL_LABELS], project, range);
+
+    for action in actions {
+        let changes = action
+            .edit
+            .expect("No workspace edit found")
+            .changes
+            .expect("No text edit found");
+        let result = apply_code_edit(src, changes);
+        assert!(
+            compiles(&result),
+            "The `Fill labels` code action produced invalid code:\n{result}"
+        );
+    }
+}
