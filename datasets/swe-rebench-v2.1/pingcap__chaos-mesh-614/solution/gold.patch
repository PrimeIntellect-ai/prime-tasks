+func filterPodByNode(pods []v1.Pod, nodes []v1.Node) []v1.Pod {
+	if len(nodes) == 0 {
+		return nil
+	}
+	var filteredList []v1.Pod
+	for _, pod := range pods {
+		for _, node := range nodes {
+			if pod.Spec.NodeName == node.Name {
+				filteredList = append(filteredList, pod)
+			}
+		}
+	}
+	return filteredList
+}
