 fn build_with_crate_types_for_foo() {
     let p = project().file("src/lib.rs", "").build();
 
-    p.cargo("rustc -v --crate-type lib,cdylib")
+    // The problem statement specifically describes the `cdylib,lib` ordering,
+    // where the first requested crate type is the dynamic library.
+    p.cargo("rustc -v --crate-type cdylib,lib")
         .with_stderr_data(str![[r#"
 [COMPILING] foo v0.0.1 ([ROOT]/foo)
-[RUNNING] `rustc --crate-name foo --edition=2015 src/lib.rs [..]--crate-type lib,cdylib [..]`
+[RUNNING] `rustc --crate-name foo --edition=2015 src/lib.rs [..]`
 [FINISHED] `dev` profile [unoptimized + debuginfo] target(s) in [ELAPSED]s
 
 "#]])
         .run();
+
+    // Both requested crate types must be uplifted, regardless of how the
+    // crate types are forwarded to `rustc`.
+    assert!(p.root().join("target/debug/libfoo.rlib").is_file());
+    let fname = format!(
+        "{}foo{}",
+        std::env::consts::DLL_PREFIX,
+        std::env::consts::DLL_SUFFIX
+    );
+    assert!(p.root().join("target/debug").join(&fname).is_file());
 }
 
