index f602116e..88ee185d 100644
--- a/tests/test_ref_cycles.py
+++ b/tests/test_ref_cycles.py
@@ -2,6 +2,7 @@
 Test for unwanted reference cycles
 
 """
+import gc
 import warnings
 import weakref
 
@@ -13,7 +14,10 @@ app = pg.mkQApp()
 
 def assert_alldead(refs):
     for ref in refs:
-        assert ref() is None
+        obj = ref()
+        assert obj is None or (
+            isinstance(obj, pg.QtCore.QObject) and not pg.Qt.isQObjectAlive(obj)
+        )
 
 def qObjectTree(root):
     """Return root and its entire tree of qobject children"""
@@ -64,3 +68,63 @@ def test_ImageView():
 
     for _ in range(5):
         assert_alldead(mkobjs())
+
+
+def test_PlotItem_menu_destroyed_after_layout_removal():
+    layout = pg.GraphicsLayoutWidget()
+    menu_refs = []
+
+    for index in range(5):
+        plot = pg.PlotItem()
+        plot.plot(x=[0, index, 5], y=[0.0, 1.0, 0.0])
+        menus = [plot.getMenu()]
+        seen_menus = set()
+        while menus:
+            menu = menus.pop()
+            if id(menu) in seen_menus:
+                continue
+            seen_menus.add(id(menu))
+            menu_refs.extend(mkrefs(menu))
+            menus.extend(
+                action.menu() for action in menu.actions()
+                if action.menu() is not None
+            )
+        layout.addItem(plot)
+        app.processEvents()
+        layout.removeItem(plot)
+        del plot
+        gc.collect()
+
+    assert_alldead(menu_refs)
+
+
+def test_PlotItem_menu_destroyed():
+    """
+    The PlotItem context menu and its submenus must be destroyed when the
+    plot is closed, rather than accumulating.
+    """
+    def mkobjs():
+        w = pg.PlotWidget()
+        pi = w.plotItem
+        menu = pi.getMenu()
+        submenus = []
+        menus_to_visit = [menu]
+        while menus_to_visit:
+            current = menus_to_visit.pop()
+            for action in current.actions():
+                submenu = action.menu()
+                if submenu is not None and submenu not in submenus:
+                    submenus.append(submenu)
+                    menus_to_visit.append(submenu)
+        assert len(submenus) > 0
+        menu_ref = weakref.ref(menu)
+        pi.close()
+        del menu
+        return pi, menu_ref, submenus
+
+    for _ in range(5):
+        pi, menu_ref, submenus = mkobjs()
+        gc.collect()
+        menu = menu_ref()
+        assert menu is None or not pg.Qt.isQObjectAlive(menu)
+        assert all(not pg.Qt.isQObjectAlive(m) for m in submenus)
