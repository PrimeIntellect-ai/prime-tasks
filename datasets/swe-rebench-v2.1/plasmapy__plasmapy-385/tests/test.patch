+
+
+@pytest.mark.parametrize(
+    "particle, mass_numb",
+    [
+        (6, None),
+        (Particle("C"), None),
+        (6, 12),
+        ("C", 12),
+        (Particle("C", mass_numb=12), None),
+    ],
+)
+def test_mass_energy_accepts_particle_inputs_and_mass_number(particle, mass_numb):
+    expected_particle = Particle(particle, mass_numb=mass_numb)
+    result = mass_energy(particle, mass_numb=mass_numb)
+
+    assert result.unit == u.J
+    assert np.isclose(
+        result.to_value(u.J),
+        expected_particle.mass_energy.to_value(u.J),
+        rtol=1e-12,
+        atol=0,
+    )
