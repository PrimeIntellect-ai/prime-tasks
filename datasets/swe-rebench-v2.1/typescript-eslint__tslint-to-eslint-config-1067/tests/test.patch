+import { convertRules } from "../../convertRules";
+import { ruleConverters } from "../../ruleConverters";
+import { ruleMergers } from "../../ruleMergers";
+
+describe("no-empty-line-after-opening-brace conversion", () => {
+    test("uses padded-blocks to prohibit blank lines after opening braces", () => {
+        const { converted } = convertRules(
+            { ruleConverters, ruleMergers },
+            { "no-empty-line-after-opening-brace": { ruleSeverity: "error" } },
+            new Map<string, string[]>(),
+        );
+
+        const paddedBlocks = converted.get("padded-blocks");
+        expect(paddedBlocks).toBeDefined();
+
+        const options = paddedBlocks?.ruleArguments ?? [];
+        expect(
+            options.some(
+                (option) =>
+                    option === "never" ||
+                    (typeof option === "object" &&
+                        option !== null &&
+                        option.blocks === "never"),
+            ),
+        ).toBe(true);
+    });
+});
