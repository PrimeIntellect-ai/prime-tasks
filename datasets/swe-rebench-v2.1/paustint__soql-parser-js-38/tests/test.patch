+// A subquery's concrete SObject is unknown; both an omitted field and null
+// represent that state. Normalize only that distinction in JSON fixture checks.
+const nativeStringify = JSON.stringify;
+JSON.stringify = ((value: any, replacer?: any, space?: any) => {
+  if (replacer !== undefined) {
+    return nativeStringify(value, replacer, space);
+  }
+  return nativeStringify(
+    value,
+    (key: string, item: any) => (key === 'sObject' && item === null ? undefined : item),
+    space
+  );
+}) as typeof JSON.stringify;
