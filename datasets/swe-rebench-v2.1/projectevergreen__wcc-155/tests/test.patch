@@ -0,0 +1,80 @@
+/*
+ * Use Case
+ * Run wcc against an "HTML" Web Component.
+ * https://blog.jim-nielsen.com/2023/html-web-components/
+ *
+ * User Result
+ * Should return the light DOM children supplied to custom elements
+ * (including content from nested custom elements) in the serialized HTML.
+ *
+ * User Workspace
+ * src/
+ *   components/
+ *     caption.js
+ *     picture-frame.js
+ *   pages/
+ *     index.js
+ */
+import chai from 'chai';
+import { JSDOM } from 'jsdom';
+import { renderToString } from '../../../src/wcc.js';
+
+const expect = chai.expect;
+
+describe('Run WCC For ', function() {
+  const LABEL = 'HTML (Light DOM) Web Components';
+  let dom;
+  let pictureFrame;
+  let actualHtml;
+
+  before(async function() {
+    const { html } = await renderToString(new URL('./src/pages/index.js', import.meta.url));
+
+    actualHtml = html;
+    dom = new JSDOM(actualHtml);
+    pictureFrame = dom.window.document.querySelectorAll('wcc-picture-frame');
+  });
+
+  describe(LABEL, function() {
+    it('should render at least one <wcc-picture-frame> tag from the page', function() {
+      expect(pictureFrame.length).to.be.greaterThan(0);
+    });
+
+    it('should have the expected image from userland in the HTML', () => {
+      const imgs = [...pictureFrame[0].querySelectorAll('.picture-frame img')].filter(img => img.getAttribute('alt') === 'Greenwood logo');
+
+      expect(imgs.length).to.be.greaterThan(0);
+      expect(imgs[0].getAttribute('src')).to.equal('https://www.greenwoodjs.io/assets/greenwood-logo-og.png');
+      expect(actualHtml).to.include('<img src="https://www.greenwoodjs.io/assets/greenwood-logo-og.png" alt="Greenwood logo">');
+    });
+
+    it('should have the expected Author name <span> from userland in the HTML', () => {
+      const spans = [...pictureFrame[0].querySelectorAll('.picture-frame span')];
+
+      expect(spans.some(span => span.textContent === 'Author: WCC')).to.equal(true);
+    });
+
+    it('should have the expected title attribute content in the nested <wcc-caption> tag', () => {
+      const headings = [...pictureFrame[0].querySelectorAll('.picture-frame wcc-caption .heading')];
+
+      expect(headings.some(heading => heading.textContent === 'Greenwood')).to.equal(true);
+    });
+
+    it('should have the expected copyright content in the nested <wcc-caption> tag', () => {
+      const spans = [...pictureFrame[0].querySelectorAll('.picture-frame wcc-caption span')];
+
+      expect(spans.some(span => span.textContent === '© 2024')).to.equal(true);
+    });
+
+    it('should not drop any light DOM content or nested component content from the picture frame', () => {
+      const frame = pictureFrame[0].querySelector('.picture-frame');
+
+      expect(frame).to.not.equal(null);
+      expect(frame.querySelector('img')).to.not.equal(null);
+      expect(frame.querySelector('wcc-caption')).to.not.equal(null);
+      expect(frame.textContent).to.include('Author: WCC');
+      expect(frame.textContent).to.include('Greenwood');
+      expect(frame.textContent).to.include('© 2024');
+    });
+  });
+});
