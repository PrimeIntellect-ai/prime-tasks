+// findSubcommand returns the named subcommand of the named top-level command
+// registered with the CLI.
+func findSubcommand(t *testing.T, commandName, subcommandName string) cli.Command {
+	t.Helper()
+	for _, c := range command.Retrieve() {
+		if c.Name != commandName {
+			continue
+		}
+		for _, sc := range c.Subcommands {
+			if sc.Name == subcommandName {
+				return sc
+			}
+		}
+	}
+	t.Fatalf("command %q subcommand %q not found", commandName, subcommandName)
+	return cli.Command{}
+}
+
+// TestCertificateInspectWithBOM is a regression test for certificate files prefixed with a UTF BOM.
+func TestCertificateInspectWithBOM(t *testing.T) {
+	tests := []struct {
+		name string
+		bom  []byte
+	}{
+		{name: "UTF-8", bom: []byte{0xEF, 0xBB, 0xBF}},
+		{name: "UTF-16 big-endian", bom: []byte{0xFE, 0xFF}},
+		{name: "UTF-16 little-endian", bom: []byte{0xFF, 0xFE}},
+		{name: "UTF-32 big-endian", bom: []byte{0x00, 0x00, 0xFE, 0xFF}},
+		{name: "UTF-32 little-endian", bom: []byte{0xFF, 0xFE, 0x00, 0x00}},
+	}
+
+	inspect := findSubcommand(t, "certificate", "inspect")
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			name := filepath.Join(dir, "server.crt")
+			contents := append(append([]byte(nil), tc.bom...), []byte(bomPEMCertificate)...)
+			if err := os.WriteFile(name, contents, 0600); err != nil {
+				t.Fatal(err)
+			}
+
+			out, runErr := runCertificateInspect(t, inspect, name)
+			if runErr == nil {
+				if !bytes.HasPrefix(out, []byte("Certificate:")) {
+					t.Fatalf("expected output to begin with certificate heading, got %q", out)
+				}
+				if !bytes.Contains(out, []byte("example.com")) {
+					t.Fatalf("expected certificate details including its subject identity, got %q", out)
+				}
+			}
+		})
+	}
+}
+
+func runCertificateInspect(t *testing.T, inspect cli.Command, name string) ([]byte, error) {
+	t.Helper()
+	app := cli.NewApp()
+	set := flag.NewFlagSet("test", 0)
+	if err := set.Parse([]string{"inspect", name}); err != nil {
+		t.Fatal(err)
+	}
+	ctx := cli.NewContext(app, set, nil)
+
+	oldStdout := os.Stdout
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		os.Stdout = oldStdout
+		_ = w.Close()
+		_ = r.Close()
+	}()
+	os.Stdout = w
+	runErr := inspect.Run(ctx)
+	_ = w.Close()
+	os.Stdout = oldStdout
+	out, err := io.ReadAll(r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return out, runErr
+}
