diff --git a/__tests__/proper-ellipsis.tests.ts b/__tests__/proper-ellipsis.tests.ts
new file mode 100644
index 0000000..a105155
--- /dev/null
+++ b/__tests__/proper-ellipsis.tests.ts
@@ -0,0 +1,20 @@
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+import ProperEllipsis from '../src/rules/proper-ellipsis';
+
+ruleTest({
+  RuleBuilderClass: ProperEllipsis,
+  testCases: [
+    {
+      testName: 'Does not modify embedded links',
+      before: dedent`
+        ![title](a...b.md)
+        ![](c...d.png)
+      `,
+      after: dedent`
+        ![title](a...b.md)
+        ![](c...d.png)
+      `,
+    },
+  ],
+});
