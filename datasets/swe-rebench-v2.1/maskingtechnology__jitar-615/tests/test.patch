index 0000000..615db1d
--- /dev/null
+++ b/packages/serialization/test/serializers/BufferSerializer.spec.ts
@@ -0,0 +1,48 @@
+import { describe, expect, it } from 'vitest';
+
+import SerializerBuilder from '../../src/SerializerBuilder';
+
+import { BUFFERS } from './fixtures';
+
+const serializer = SerializerBuilder.build();
+
+describe('buffer serialization through the framework', () =>
+{
+    it('serializes a Buffer to the portable buffer representation', async () =>
+    {
+        const result = await serializer.serialize(BUFFERS.VALID);
+
+        expect(result).toStrictEqual(BUFFERS.VALID_SERIALIZED);
+    });
+
+    it('reconstructs a Buffer from its serialized representation', async () =>
+    {
+        const result = await serializer.deserialize(BUFFERS.VALID_SERIALIZED);
+
+        expect(Buffer.isBuffer(result)).toBe(true);
+        expect(result).toStrictEqual(BUFFERS.VALID);
+    });
+
+    it('reconstructs buffers without a deprecated Buffer-constructor warning', async () =>
+    {
+        const warningCodes: (string | undefined)[] = [];
+        const onWarning = (warning: Error): void =>
+        {
+            warningCodes.push((warning as NodeJS.ErrnoException).code);
+        };
+
+        process.on('warning', onWarning);
+
+        try
+        {
+            await serializer.deserialize(BUFFERS.VALID_SERIALIZED);
+            await new Promise(resolve => setImmediate(resolve));
+
+            expect(warningCodes).not.toContain('DEP0005');
+        }
+        finally
+        {
+            process.off('warning', onWarning);
+        }
+    });
+});
