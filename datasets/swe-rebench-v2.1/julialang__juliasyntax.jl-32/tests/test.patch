+
+@testset "dotop miscellanea" begin
+    @test strtok("a .-> b")  ==  ["a", " ", ".-", ">", " ", "b", ""]
+    @test strtok(".>: b")    ==  [".>:", " ", "b", ""]
+    @test strtok(".<: b")    ==  [".<:", " ", "b", ""]
+    @test strtok("a ||₁ b")  ==  ["a", " ", "||", "₁", " ", "b", ""]
+    @test strtok("a ||̄ b")   ==  ["a", " ", "||", "̄", " ", "b", ""]
+    @test strtok("a .||₁ b") ==  ["a", " ", ".||", "₁", " ", "b", ""]
+    @test strtok("a &&₁ b")  ==  ["a", " ", "&&", "₁", " ", "b", ""]
+    @test strtok("a &&̄ b")   ==  ["a", " ", "&&", "̄", " ", "b", ""]
+    @test strtok("a .&&₁ b") ==  ["a", " ", ".&&", "₁", " ", "b", ""]
+end
+
+@testset "malformed logical operator suffixes report errors" begin
+    for s in ["a ||₁ b", "a ||̄ b", "a .||₁ b", "a &&₁ b", "a &&̄ b", "a .&&₁ b"]
+        @test Tokens.iserror(tok(s, 4).kind)
+    end
+end
