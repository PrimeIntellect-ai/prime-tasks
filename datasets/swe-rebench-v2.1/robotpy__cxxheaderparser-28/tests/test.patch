+def test_final_parameter_name_and_default():
+    content = """
+        class A {
+            __declspec( dllexport ) Standard_CString CFail (
+                const Standard_Integer num,
+                const Standard_Boolean final = true
+            ) const;
+        };
+    """
+    data = parse_string(content, cleandoc=True)
+
+    method = data.namespace.classes[0].methods[0]
+    assert len(method.parameters) == 2
+    assert method.parameters[1].name == "final"
+    assert [token.value for token in method.parameters[1].default.tokens] == ["true"]
