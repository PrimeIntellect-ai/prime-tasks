+func Test_Node_Set_Tag_Does_Not_Override_Profile_Tags(t *testing.T) {
+	env := testenv.New(t)
+	defer env.RemoveAll(t)
+
+	env.WriteFile(t, "etc/warewulf/nodes.conf", `WW_INTERNAL: 43
+nodeprofiles:
+  p1:
+    comment: testit 1
+    tags:
+      p1tag1: p1val1
+  p2:
+    comment: testit 1
+    tags:
+      p2tag2: p1val2
+nodes:
+  n01:
+    profiles:
+    - p1
+    - p2`)
+	warewulfd.SetNoDaemon()
+
+	baseCmd := GetCommand()
+	baseCmd.SetArgs([]string{"--tagadd", "nodetag1=nodevalue1", "n01", "--yes"})
+	buf := new(bytes.Buffer)
+	baseCmd.SetOut(buf)
+	baseCmd.SetErr(buf)
+	assert.NoError(t, baseCmd.Execute())
+
+	content := env.ReadFile(t, "etc/warewulf/nodes.conf")
+	var conf map[string]interface{}
+	assert.NoError(t, yaml.Unmarshal([]byte(content), &conf))
+
+	nodes, ok := conf["nodes"].(map[interface{}]interface{})
+	assert.True(t, ok, "nodes section missing")
+	n01, ok := nodes["n01"].(map[interface{}]interface{})
+	assert.True(t, ok, "node n01 missing")
+	tags, _ := n01["tags"].(map[interface{}]interface{})
+
+	assert.Equal(t, "nodevalue1", tags["nodetag1"])
+
+	for key, profileValue := range map[string]string{"p1tag1": "p1val1", "p2tag2": "p1val2"} {
+		if nodeValue, present := tags[key]; present {
+			assert.NotEqual(t, "", nodeValue, "profile tag must not be overridden by an empty node value: "+key)
+			assert.Equal(t, profileValue, nodeValue, "node-level tag must keep the profile value: "+key)
+		}
+	}
+}
