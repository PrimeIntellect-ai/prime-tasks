+    def test_sub_obs_from_op(self):
+        """Operator subtraction represents the mathematical difference."""
+        lhs = qml.S(0)
+        rhs = qml.PauliX(1)
+        result = lhs - rhs
+        wire_order = [0, 1]
+
+        expected = qml.matrix(lhs, wire_order=wire_order) - qml.matrix(
+            rhs, wire_order=wire_order
+        )
+        assert np.allclose(result.matrix(wire_order=wire_order), expected)
+
+    def test_sub_prod_simplifies(self):
+        """Subtraction involving a product can be simplified without changing its value."""
+        lhs = qml.PauliZ(0)
+        rhs = qml.prod(qml.PauliX(0), qml.PauliY(1))
+        result = lhs - rhs
+        simplified = result.simplify()
+        wire_order = [0, 1]
+
+        expected = qml.matrix(lhs, wire_order=wire_order) - qml.matrix(
+            rhs, wire_order=wire_order
+        )
+        assert np.allclose(result.matrix(wire_order=wire_order), expected)
+        assert np.allclose(simplified.matrix(wire_order=wire_order), expected)
+
