+#[test]
+fn test_temppath_persist() {
+    let mut tmpfile = NamedTempFile::new().unwrap();
+    write!(tmpfile, "abcde").unwrap();
+    let old_path = tmpfile.path().to_path_buf();
+
+    let tmppath = tmpfile.into_temp_path();
+
+    let persist_path = env::temp_dir().join("persisted_temppath_file");
+
+    {
+        assert!(exists(&old_path));
+        tmppath.persist(&persist_path).unwrap();
+        assert!(!exists(&old_path));
+    }
+
+    {
+        // Try opening it at the new path.
+        let mut f = File::open(&persist_path).unwrap();
+        f.seek(SeekFrom::Start(0)).unwrap();
+        let mut buf = String::new();
+        f.read_to_string(&mut buf).unwrap();
+        assert_eq!("abcde", buf);
+    }
+
+    std::fs::remove_file(&persist_path).unwrap();
+}
+
+#[test]
+fn test_temppath_persist_noclobber() {
+    let mut tmpfile = NamedTempFile::new().unwrap();
+    write!(tmpfile, "abcde").unwrap();
+    let old_path = tmpfile.path().to_path_buf();
+
+    let mut tmppath = tmpfile.into_temp_path();
+
+    let mut persist_target = NamedTempFile::new().unwrap();
+    write!(persist_target, "existing").unwrap();
+    let persist_path = persist_target.path().to_path_buf();
+
+    assert!(exists(&old_path));
+
+    {
+        let error = match tmppath.persist_noclobber(&persist_path) {
+            Ok(()) => panic!("persist_noclobber replaced an existing destination"),
+            Err(error) => error,
+        };
+        let _underlying_error: &std::io::Error = &error.error;
+        assert!(exists(&old_path));
+        assert!(exists(&persist_path));
+        persist_target.seek(SeekFrom::Start(0)).unwrap();
+        let mut destination_contents = String::new();
+        persist_target.read_to_string(&mut destination_contents).unwrap();
+        assert_eq!("existing", destination_contents);
+        tmppath = error.into();
+        drop(persist_target);
+    }
+
+    tmppath.persist_noclobber(&persist_path).unwrap();
+
+    // Try opening it at the new path.
+    let mut f = File::open(&persist_path).unwrap();
+    f.seek(SeekFrom::Start(0)).unwrap();
+    let mut buf = String::new();
+    f.read_to_string(&mut buf).unwrap();
+    assert_eq!("abcde", buf);
+    std::fs::remove_file(&persist_path).unwrap();
+}
