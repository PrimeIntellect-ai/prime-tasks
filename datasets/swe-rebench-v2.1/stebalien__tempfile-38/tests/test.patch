+#[test]
+fn test_temppath_persist_failure_retains_path() {
+    let mut tmpfile = NamedTempFile::new().unwrap();
+    write!(tmpfile, "recover me").unwrap();
+    let old_path = tmpfile.path().to_path_buf();
+    let tmppath = tmpfile.into_temp_path();
+
+    let target_dir = tempfile::tempdir().unwrap();
+    let invalid_target = target_dir.path().join("missing").join("target");
+    let error = match tmppath.persist(&invalid_target) {
+        Ok(()) => panic!("persist unexpectedly succeeded"),
+        Err(error) => error,
+    };
+
+    assert!(exists(&old_path));
+    let recovered: TempPath = error.into();
+    let destination = target_dir.path().join("recovered");
+    recovered.persist(&destination).unwrap();
+    assert!(!exists(&old_path));
+
+    let mut contents = String::new();
+    File::open(&destination).unwrap().read_to_string(&mut contents).unwrap();
+    assert_eq!("recover me", contents);
+}
