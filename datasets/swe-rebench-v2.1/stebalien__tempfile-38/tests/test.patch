+#[test]
+#[cfg(target_os = "linux")]
+fn test_into_temp_path_closes_handle() {
+    let mut tmpfile = NamedTempFile::new().unwrap();
+    write!(tmpfile, "abcde").unwrap();
+    let path = tmpfile.path().to_path_buf();
+
+    let fds_before = open_fds_for(&path);
+    let tmppath = tmpfile.into_temp_path();
+    let fds_after = open_fds_for(&path);
+
+    if let (Some(before), Some(after)) = (fds_before, fds_after) {
+        assert!(before >= 1);
+        assert_eq!(after, 0);
+    }
+    drop(tmppath);
+}
