+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestErrcheckCommandHonorsTestsOptionWhenRun(t *testing.T) {
+	originalTest := config.Test
+	defer func() { config.Test = originalTest }()
+
+	cases := []struct {
+		name       string
+		tests      bool
+		ignoreTest bool
+	}{
+		{name: "tests disabled", tests: false, ignoreTest: true},
+		{name: "tests enabled", tests: true, ignoreTest: false},
+	}
+
+	for _, testcase := range cases {
+		t.Run(testcase.name, func(t *testing.T) {
+			capturePath := filepath.Join(t.TempDir(), "arguments")
+			helperPath := filepath.Join(t.TempDir(), "capture-args")
+			helper := "#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$ARG_CAPTURE\"\n"
+			if err := os.WriteFile(helperPath, []byte(helper), 0700); err != nil {
+				t.Fatal(err)
+			}
+			t.Setenv("ARG_CAPTURE", capturePath)
+
+			linter := getLinterByName("errcheck", LinterConfig{})
+			linter.Command = strings.Replace(linter.Command, "errcheck", helperPath, 1)
+			config.Test = testcase.tests
+			issues, errs := runLinters(map[string]*Linter{"errcheck": linter}, []string{"."}, 1, nil, nil)
+			for range issues {
+			}
+			for err := range errs {
+				assert.NoError(t, err)
+			}
+
+			arguments, err := os.ReadFile(capturePath)
+			if !assert.NoError(t, err) {
+				return
+			}
+			args := strings.Fields(string(arguments))
+			hasIgnoreTests := false
+			for _, arg := range args {
+				if arg == "-ignoretests" || arg == "-ignoretests=true" {
+					hasIgnoreTests = true
+				}
+			}
+			if testcase.ignoreTest {
+				assert.True(t, hasIgnoreTests, "errcheck must be told to ignore tests")
+			} else {
+				assert.False(t, hasIgnoreTests, "errcheck must not be told to ignore tests")
+			}
+		})
+	}
+}
