         find_position_of("Wibble")
     );
 }
+
+// https://github.com/gleam-lang/gleam/issues/4553
+#[test]
+fn rename_local_variable_with_label_shorthand() {
+    assert_rename!(
+        "
+pub type Wibble {
+  Wibble(first: Int, second: Int)
+}
+
+pub fn main() {
+  let second = 2
+  Wibble(first: 1, second:)
+}
+",
+        "something",
+        find_position_of("second:)")
+    );
+}
+
+#[test]
+fn rename_local_variable_from_definition_with_label_shorthand() {
+    let source = "\npub type Wibble {\n  Wibble(first: Int, second: Int)\n}\n\npub fn main() {\n  let second = 2\n  Wibble(first: 1, second:)\n}\n";
+    let project = TestProject::for_source(source);
+    let position = find_position_of("second =").find_position(source);
+    let (_, renamed) = apply_rename(&project, "something", position);
+
+    assert_eq!(
+        renamed["app"],
+        "\npub type Wibble {\n  Wibble(first: Int, second: Int)\n}\n\npub fn main() {\n  let something = 2\n  Wibble(first: 1, second: something)\n}\n"
+    );
+}
