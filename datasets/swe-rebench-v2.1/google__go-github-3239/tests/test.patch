+func invokeProvisionAndInviteSCIMUser(service *SCIMService, ctx context.Context, org string, opts *SCIMUserAttributes) (*SCIMUserAttributes, *Response, error, int) {
+	values := reflect.ValueOf(service).MethodByName("ProvisionAndInviteSCIMUser").Call([]reflect.Value{
+		reflect.ValueOf(ctx), reflect.ValueOf(org), reflect.ValueOf(opts),
+	})
+	resultCount := len(values)
+	var user *SCIMUserAttributes
+	var resp *Response
+	var err error
+	if resultCount == 3 {
+		user, _ = values[0].Interface().(*SCIMUserAttributes)
+		resp, _ = values[1].Interface().(*Response)
+		if !values[2].IsNil() {
+			err, _ = values[2].Interface().(error)
+		}
+	} else if resultCount == 2 {
+		resp, _ = values[0].Interface().(*Response)
+		if !values[1].IsNil() {
+			err, _ = values[1].Interface().(error)
+		}
+	}
+	return user, resp, err, resultCount
+}
