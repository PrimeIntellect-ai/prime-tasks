+func TestPrepareEnvContractUtxo(t *testing.T) {
+	logger := log.New("module", "xmodel")
+	logger.SetHandler(log.StreamHandler(os.Stderr, log.LogfmtFormat()))
+	xmodel := &XModel{logger: logger}
+
+	contractInputs := []*pb.TxInput{
+		&pb.TxInput{
+			RefTxid:   []byte("refTxid"),
+			RefOffset: 0,
+			FromAddr:  []byte("fromAddr"),
+		},
+	}
+	contractOutputs := []*pb.TxOutput{
+		&pb.TxOutput{
+			Amount: []byte("100"),
+			ToAddr: []byte("toAddr"),
+		},
+	}
+	inBytes, err := marshalMessages(contractInputs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	outBytes, err := marshalMessages(contractOutputs)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// A transaction that really contains the contract UTXO must be accepted.
+	validTx := &pb.Transaction{
+		Txid: []byte("validTx"),
+		TxInputs: []*pb.TxInput{
+			&pb.TxInput{
+				RefTxid:   []byte("refTxid"),
+				RefOffset: 0,
+				FromAddr:  []byte("fromAddr"),
+			},
+		},
+		TxOutputs: []*pb.TxOutput{
+			&pb.TxOutput{
+				Amount: []byte("100"),
+				ToAddr: []byte("toAddr"),
+			},
+		},
+		TxOutputsExt: []*pb.TxOutputExt{
+			&pb.TxOutputExt{
+				Bucket: TransientBucket,
+				Key:    contractUtxoInputKey,
+				Value:  inBytes,
+			},
+			&pb.TxOutputExt{
+				Bucket: TransientBucket,
+				Key:    contractUtxoOutputKey,
+				Value:  outBytes,
+			},
+		},
+	}
+	if _, err := xmodel.PrepareEnv(validTx); err != nil {
+		t.Fatalf("PrepareEnv rejected a transaction with a valid contract utxo: %v", err)
+	}
+
+	// A transaction whose contract response was manually changed so that the
+	// declared contract output is not present in tx.TxOutputs must be rejected.
+	tamperedTx := &pb.Transaction{
+		Txid: []byte("tamperedTx"),
+		TxInputs: []*pb.TxInput{
+			&pb.TxInput{
+				RefTxid:   []byte("refTxid"),
+				RefOffset: 0,
+				FromAddr:  []byte("fromAddr"),
+			},
+		},
+		TxOutputs: []*pb.TxOutput{
+			&pb.TxOutput{
+				Amount: []byte("999"),
+				ToAddr: []byte("attacker"),
+			},
+		},
+		TxOutputsExt: []*pb.TxOutputExt{
+			&pb.TxOutputExt{
+				Bucket: TransientBucket,
+				Key:    contractUtxoInputKey,
+				Value:  inBytes,
+			},
+			&pb.TxOutputExt{
+				Bucket: TransientBucket,
+				Key:    contractUtxoOutputKey,
+				Value:  outBytes,
+			},
+		},
+	}
+	if _, err := xmodel.PrepareEnv(tamperedTx); err == nil {
+		t.Error("PrepareEnv accepted a transaction with a manually changed contract response")
+	}
+
+	// A declared contract input absent from the transaction must also be rejected.
+	missingInputTx := *validTx
+	missingInputTx.Txid = []byte("missingInputTx")
+	missingInputTx.TxInputs = nil
+	if _, err := xmodel.PrepareEnv(&missingInputTx); err == nil {
+		t.Error("PrepareEnv accepted a transaction missing a declared contract input")
+	}
+}
