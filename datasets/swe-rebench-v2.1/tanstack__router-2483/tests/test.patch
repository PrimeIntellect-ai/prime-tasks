+
+describe('invalidate', () => {
+  it('after router.invalid(), routes should be `valid` again after loading', async () => {
+    const { router } = createTestRouter(
+      createMemoryHistory({ initialEntries: ['/'] }),
+    )
+
+    await act(() => router.load())
+
+    router.state.matches.forEach((match) => {
+      expect(match.invalid).toBe(false)
+    })
+
+    await act(() => router.invalidate())
+
+    router.state.matches.forEach((match) => {
+      expect(match.invalid).toBe(false)
+    })
+
+    await act(() => router.load())
+
+    router.state.matches.forEach((match) => {
+      expect(match.invalid).toBe(false)
+    })
+  })
+
+  it('after router.invalidate(), loaders run again but only once when defaultStaleTime is Infinity', async () => {
+    const loaderMock = vi.fn()
+
+    const rootRoute = createRootRoute({})
+    const indexRoute = createRoute({
+      getParentRoute: () => rootRoute,
+      path: '/',
+      loader: () => {
+        loaderMock()
+        return {}
+      },
+    })
+    const routeTree = rootRoute.addChildren([indexRoute])
+    const router = createRouter({
+      routeTree,
+      history: createMemoryHistory({ initialEntries: ['/'] }),
+      defaultStaleTime: Infinity,
+    })
+
+    await act(() => router.load())
+    expect(loaderMock).toHaveBeenCalledTimes(1)
+
+    // The route is fresh, so a subsequent load should not re-run the loader
+    await act(() => router.load())
+    expect(loaderMock).toHaveBeenCalledTimes(1)
+
+    // Invalidating marks the matches stale, so the loader runs again
+    await act(() => router.invalidate())
+    expect(loaderMock).toHaveBeenCalledTimes(2)
+
+    // After the invalidate cycle the match is valid again, so the loader
+    // should not run again on the next load
+    await act(() => router.load())
+    expect(loaderMock).toHaveBeenCalledTimes(2)
+  })
+})
