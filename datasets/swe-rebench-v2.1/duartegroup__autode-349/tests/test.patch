+def test_dic_back_transform_preserves_periodic_dihedral_step():
+    mol = h2o2_mol()
+    dihedral = PrimitiveDihedralAngle(2, 0, 1, 3)
+    coords = mol.coordinates.copy()
+
+    # Rotate the terminal hydrogen around the O-O bond to put the torsion
+    # just below the periodic boundary.
+    axis = coords[1] - coords[0]
+    axis /= np.linalg.norm(axis)
+    origin = coords[1].copy()
+    relative = coords[3] - origin
+    candidates = []
+    for angle in np.linspace(-np.pi, np.pi, 1001):
+        rotated = (
+            relative * np.cos(angle)
+            + np.cross(axis, relative) * np.sin(angle)
+            + axis * np.dot(axis, relative) * (1.0 - np.cos(angle))
+        )
+        trial = coords.copy()
+        trial[3] = origin + rotated
+        candidates.append((abs(float(dihedral(trial)) - (np.pi - 0.01)), trial))
+
+    coords = min(candidates, key=lambda candidate: candidate[0])[1]
+    x = CartesianCoordinates(coords)
+    primitives = AnyPIC.from_species(mol)
+    dic = DIC.from_cartesian(x, primitives=primitives)
+
+    torsion_index = next(
+        i for i, primitive in enumerate(primitives) if primitive == dihedral
+    )
+    primitive_step = np.zeros(len(primitives))
+    primitive_step[torsion_index] = 0.2
+    requested_step = dic.U.T @ primitive_step
+
+    updated_dic = dic + requested_step
+    actual_step = np.asarray(updated_dic) - np.asarray(dic)
+
+    # Crossing the +/- pi boundary must not turn this small move into a
+    # large apparent step in the final DIC values.
+    assert np.linalg.norm(actual_step - requested_step) < 0.1
+
