@@ -293,6 +293,29 @@ function test_get_model()
     return
 end
 
+function test_copy_ConstraintDualStart_VariableIndex()
+    source = MOI.Utilities.UniversalFallback(MOI.Utilities.Model{Float64}())
+    variables = MOI.add_variables(source, 3)
+    constraints = (
+        MOI.add_constraint(source, variables[1], MOI.LessThan(4.0)),
+        MOI.add_constraint(source, variables[2], MOI.GreaterThan(-2.0)),
+        MOI.add_constraint(source, variables[3], MOI.EqualTo(1.5)),
+    )
+    starts = (-3.25, 2.5, -1.75)
+    for (constraint, start) in zip(constraints, starts)
+        MOI.set(source, MOI.ConstraintDualStart(), constraint, start)
+    end
+
+    destination = Ipopt.Optimizer()
+    index_map = MOI.copy_to(destination, source)
+    for (constraint, start) in zip(constraints, starts)
+        copied_constraint = index_map[constraint]
+        @test MOI.get(destination, MOI.ConstraintDualStart(), copied_constraint) ==
+              start
+    end
+    return
+end
+
 end  # module TestMOIWrapper
 
 TestMOIWrapper.runtests()
