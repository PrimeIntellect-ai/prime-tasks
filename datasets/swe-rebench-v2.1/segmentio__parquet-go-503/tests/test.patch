+// https://github.com/segmentio/parquet-go/issues/501
+func TestBooleanRoundTripWithFlushes(t *testing.T) {
+	type booleanRow struct {
+		A bool
+		B bool
+	}
+
+	const rowCount = 100
+	var encoded bytes.Buffer
+	writer := NewGenericWriter[booleanRow](&encoded)
+	want := make([]booleanRow, 0, rowCount+8)
+	random := rand.New(rand.NewSource(0))
+
+	for i := 0; i < rowCount; i++ {
+		row := booleanRow{}
+		if random.Intn(2) == 0 {
+			row.A = true
+		} else {
+			row.B = true
+		}
+		want = append(want, row)
+		if _, err := writer.Write(want[len(want)-1:]); err != nil {
+			t.Fatal(err)
+		}
+		if i%10 == 0 {
+			if err := writer.Flush(); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+
+	// Also flush a complete mixed batch after the single-row writes.
+	batch := make([]booleanRow, 8)
+	for i := range batch {
+		batch[i].A = i%2 == 0
+	}
+	want = append(want, batch...)
+	if _, err := writer.Write(batch); err != nil {
+		t.Fatal(err)
+	}
+	if err := writer.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	reader := NewGenericReader[booleanRow](bytes.NewReader(encoded.Bytes()))
+	got := make([]booleanRow, len(want))
+	n, _ := reader.Read(got)
+	if n != len(want) {
+		t.Fatalf("wrong number of rows read: want %d, got %d", len(want), n)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Errorf("boolean values changed at row %d: want %+v, got %+v", i, want[i], got[i])
+		}
+	}
+}
