+def test_set_response_id_propagation_empty_to_valid(initialized_custom_stream_wrapper: CustomStreamWrapper):
+    """Test that response_id is properly set when first chunk has empty ID and second chunk has valid ID"""
+
+    model_response1 = ModelResponseStream(id="", created=1742056047, model=None)
+    model_response1 = initialized_custom_stream_wrapper.set_model_id(model_response1.id, model_response1)
+
+    model_response2 = ModelResponseStream(id="valid-id-123", created=1742056048, model=None)
+    model_response2 = initialized_custom_stream_wrapper.set_model_id("valid-id-123", model_response2)
+    assert model_response2.id == "valid-id-123"
+    assert initialized_custom_stream_wrapper.response_id == "valid-id-123"
+
+
+@pytest.mark.parametrize("invalid_id", ["", " \t "])
+def test_set_response_id_propagation_valid_to_invalid(
+    initialized_custom_stream_wrapper: CustomStreamWrapper, invalid_id: str
+):
+    """Test that response_id is maintained when a later chunk has an invalid ID"""
+
+    model_response1 = ModelResponseStream(id="first-valid-id", created=1742056049, model=None)
+    model_response1 = initialized_custom_stream_wrapper.set_model_id("first-valid-id", model_response1)
+    assert model_response1.id == "first-valid-id"
+    assert initialized_custom_stream_wrapper.response_id == "first-valid-id"
+
+    model_response2 = ModelResponseStream(id=invalid_id, created=1742056050, model=None)
+    model_response2 = initialized_custom_stream_wrapper.set_model_id(invalid_id, model_response2)
+    assert model_response2.id == "first-valid-id"
+    assert initialized_custom_stream_wrapper.response_id == "first-valid-id"
+
+
+def test_openrouter_streaming_preserves_gen_id():
+    """OpenRouter gen-... IDs must be preserved in streamed chunks, not replaced by LiteLLM-generated IDs."""
+    from litellm.llms.openrouter.chat.transformation import (
+        OpenRouterChatCompletionStreamingHandler,
+    )
+
+    gen_id = "gen-1747832343-r1R4jd69FBv5lkWPp9e6"
+    raw_chunks = [
+        "data: "
+        + json.dumps(
+            {
+                "id": gen_id,
+                "object": "chat.completion.chunk",
+                "created": 1747832343,
+                "model": "openai/gpt-3.5-turbo",
+                "choices": [
+                    {"index": 0, "delta": {"content": "Hello"}, "finish_reason": None}
+                ],
+            }
+        ),
+        "data: "
+        + json.dumps(
+            {
+                "id": gen_id,
+                "object": "chat.completion.chunk",
+                "created": 1747832343,
+                "model": "openai/gpt-3.5-turbo",
+                "choices": [
+                    {"index": 0, "delta": {"content": " world"}, "finish_reason": None}
+                ],
+            }
+        ),
+        "data: "
+        + json.dumps(
+            {
+                "id": gen_id,
+                "object": "chat.completion.chunk",
+                "created": 1747832343,
+                "model": "openai/gpt-3.5-turbo",
+                "choices": [{"index": 0, "delta": {}, "finish_reason": "stop"}],
+            }
+        ),
+        "data: [DONE]",
+    ]
+
+    completion_stream = OpenRouterChatCompletionStreamingHandler(
+        streaming_response=iter(raw_chunks), sync_stream=True
+    )
+    response = CustomStreamWrapper(
+        completion_stream=completion_stream,
+        model="openai/gpt-3.5-turbo",
+        custom_llm_provider="openrouter",
+        logging_obj=MagicMock(),
+    )
+
+    chunk_ids = [chunk.id for chunk in response]
+    assert len(chunk_ids) > 0
+    assert all(chunk_id == gen_id for chunk_id in chunk_ids)
+
+
+def test_openrouter_streaming_reuses_id_when_chunk_id_missing():
+    """A chunk with a missing/empty id must reuse the previously seen OpenRouter id."""
+    from litellm.llms.openrouter.chat.transformation import (
+        OpenRouterChatCompletionStreamingHandler,
+    )
+
+    gen_id = "gen-1747832343-r1R4jd69FBv5lkWPp9e6"
+    raw_chunks = [
+        "data: "
+        + json.dumps(
+            {
+                "id": gen_id,
+                "object": "chat.completion.chunk",
+                "created": 1747832343,
+                "model": "openai/gpt-3.5-turbo",
+                "choices": [
+                    {"index": 0, "delta": {"content": "Hello"}, "finish_reason": None}
+                ],
+            }
+        ),
+        "data: "
+        + json.dumps(
+            {
+                "id": "",
+                "object": "chat.completion.chunk",
+                "created": 1747832343,
+                "model": "openai/gpt-3.5-turbo",
+                "choices": [
+                    {"index": 0, "delta": {"content": " world"}, "finish_reason": None}
+                ],
+            }
+        ),
+        "data: [DONE]",
+    ]
+
+    completion_stream = OpenRouterChatCompletionStreamingHandler(
+        streaming_response=iter(raw_chunks), sync_stream=True
+    )
+    response = CustomStreamWrapper(
+        completion_stream=completion_stream,
+        model="openai/gpt-3.5-turbo",
+        custom_llm_provider="openrouter",
+        logging_obj=MagicMock(),
+    )
+
+    chunk_ids = [chunk.id for chunk in response]
+    assert len(chunk_ids) >= 2
+    assert all(chunk_id == gen_id for chunk_id in chunk_ids)
+
