+func TestCommentMapRoundTrip(t *testing.T) {
+	var value any
+	comments := yaml.CommentMap{}
+	if err := yaml.UnmarshalWithOptions([]byte(`"a#b": c # retained comment`), &value, yaml.CommentToMap(comments)); err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := yaml.MarshalWithOptions(value, yaml.WithComment(comments))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(encoded), "retained comment") {
+		t.Fatalf("comment for quoted mapping key was not retained: %s", encoded)
+	}
+}
