+/// Build a real [`DefaultCallManager`] over the dummy machine, for exercising the
+/// production call-manager behaviour.
+fn build_default_call_manager() -> DefaultCallManager<DummyMachine> {
+    let machine = DummyMachine::new_stub().unwrap();
+    let engine_pool = EnginePool::new((&machine.ctx.network).into()).unwrap();
+    let engine = engine_pool.acquire();
+    DefaultCallManager::<DummyMachine>::new(
+        machine,
+        engine,
+        0,
+        0,
+        Address::new_id(0),
+        None,
+        Address::new_id(0),
+        0,
+        TokenAmount::zero(),
+    )
+}
+
+/// Actor debug messages are exposed in the execution trace and are not printed to stdout.
+#[test]
+fn actor_log_is_recorded_in_the_execution_trace() {
+    const CHILD: &str = "FVM_ACTOR_LOG_STDOUT_CHILD";
+    const MESSAGE: &str = "hello from actor";
+
+    // Run the logging operation in a child test process so its uncaptured stdout can
+    // be checked without interfering with output capture for other tests.
+    if std::env::var_os(CHILD).is_some() {
+        let mut kern = DefaultKernel::<DefaultCallManager<DummyMachine>>::new(
+            build_default_call_manager(),
+            kernel::BlockRegistry::default(),
+            0,
+            0,
+            0,
+            TokenAmount::zero(),
+            false,
+        );
+        kern.log(MESSAGE.to_string());
+        return;
+    }
+
+    let output = std::process::Command::new(std::env::current_exe().unwrap())
+        .args([
+            "--exact",
+            "actor_log_is_recorded_in_the_execution_trace",
+            "--nocapture",
+        ])
+        .env(CHILD, "1")
+        .output()
+        .expect("should run the actor logging test in a child process");
+    assert!(
+        output.status.success(),
+        "child test failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert!(
+        !String::from_utf8_lossy(&output.stdout).contains(MESSAGE),
+        "actor debug log was written to stdout: {}",
+        String::from_utf8_lossy(&output.stdout)
+    );
+
+    let mut kern = DefaultKernel::<DefaultCallManager<DummyMachine>>::new(
+        build_default_call_manager(),
+        kernel::BlockRegistry::default(),
+        0,
+        0,
+        0,
+        TokenAmount::zero(),
+        false,
+    );
+    kern.log(MESSAGE.to_string());
+    let (call_manager, _blocks) = kern.into_inner();
+    let (ret, _machine) = call_manager.finish();
+    let ret = ret.expect("call manager should finish cleanly");
+    assert!(
+        format!("{:?}", ret.exec_trace).contains(MESSAGE),
+        "actor log should be present in the execution trace"
+    );
 }
