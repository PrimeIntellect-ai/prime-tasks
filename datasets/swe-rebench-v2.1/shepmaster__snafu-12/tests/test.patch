diff --git a/tests/backtrace.rs b/tests/backtrace.rs
new file mode 100644
index 0000000..24e1414
--- /dev/null
+++ b/tests/backtrace.rs
@@ -0,0 +1,52 @@
+extern crate snafu;
+
+use snafu::{Backtrace, Snafu, ResultExt, ErrorCompat};
+
+type AnotherError = Box<std::error::Error>;
+
+#[derive(Debug, Snafu)]
+enum Error {
+    #[snafu_display("Invalid user {}", "user_id")]
+    InvalidUser { user_id: i32, backtrace: Backtrace },
+    WithSource { source: AnotherError, backtrace: Backtrace },
+    MissingUser,
+}
+
+type Result<T, E = Error> = std::result::Result<T, E>;
+
+fn check_less_than(user_id: i32) -> Result<()> {
+    if user_id < 42 { InvalidUser { user_id }.fail()?; }
+    Ok(())
+}
+
+fn check_greater_than(user_id: i32) -> Result<()> {
+    if user_id > 42 { InvalidUser { user_id }.fail()?; }
+    Ok(())
+}
+
+fn example(user_id: i32) -> Result<()> {
+    check_less_than(user_id)?;
+    check_greater_than(user_id)?;
+
+    Ok(())
+}
+
+#[test]
+fn has_a_backtrace() {
+    let e = example(0).unwrap_err();
+    assert!(ErrorCompat::backtrace(&e).is_some());
+}
+
+#[test]
+fn no_backtrace_when_not_declared() {
+    let e = MissingUser.fail::<()>().unwrap_err();
+    assert!(ErrorCompat::backtrace(&e).is_none());
+}
+
+fn trigger() -> Result<(), AnotherError> { Err("boom".into()) }
+
+#[test]
+fn from_conversion_constructs_a_backtrace() {
+    let e: Error = trigger().context(WithSource).unwrap_err().into();
+    assert!(ErrorCompat::backtrace(&e).is_some());
+}
