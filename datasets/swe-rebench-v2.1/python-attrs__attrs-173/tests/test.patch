+"""
+Tests for optional conversion.
+"""
+
+from __future__ import absolute_import
+
+import attr
+from attr.converters import optional
+import pytest
+
+
+class TestOptional(object):
+    def test_success_with_type(self):
+        """Non-None values are passed through the supplied converter."""
+        c = optional(int)
+        assert c("42") == 42
+
+    def test_success_with_none(self):
+        """None bypasses conversion."""
+        c = optional(int)
+        assert c(None) is None
+
+    def test_fail(self):
+        """Errors from converting non-None values are propagated."""
+        c = optional(int)
+        with pytest.raises(ValueError):
+            c("not_an_int")
+
+    def test_attribute_initialization(self):
+        """The optional converter can be used for an attribute."""
+        @attr.s
+        class Item(object):
+            value = attr.ib(convert=optional(int))
+
+        assert Item("42").value == 42
+        assert Item(None).value is None
