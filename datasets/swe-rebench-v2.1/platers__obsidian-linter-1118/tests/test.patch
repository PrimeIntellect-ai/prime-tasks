+
+const nestedCallouts = dedent`
+  > [!multi-column]
+  >
+  > > \`\`\`
+  > > some query or basic code-block
+  > > \`\`\`
+  >
+  > > \`\`\`
+  > > another query or basic code-block
+  > > \`\`\`
+`;
+
+function expectSingleMarkerBetweenChildCallouts(text: string): void {
+  const lines = text.split('\n');
+  const fences = lines.reduce<number[]>((indices, line, index) => {
+    if (line.includes('```')) indices.push(index);
+    return indices;
+  }, []);
+  const separator = lines.slice(fences[1] + 1, fences[2]);
+  const markerCount = separator.reduce((count, line) => count + (line.match(/>/g) ?? []).length, 0);
+
+  expect(markerCount).toBe(1);
+}
+
+describe('Nested callouts containing code fences', () => {
+  it('does not add a blockquote marker between child callouts when enabled', () => {
+    const settings = {
+      ruleConfigs: {
+        'empty-line-around-code-fences': {enabled: true},
+      },
+    } as unknown as LinterSettings;
+
+    const [result] = EmptyLineAroundCodeFences.applyIfEnabled(nestedCallouts, settings, []);
+
+    expectSingleMarkerBetweenChildCallouts(result);
+  });
+
+  it('does not add a blockquote marker between child callouts when disabled', () => {
+    const settings = {
+      ruleConfigs: {
+        'empty-line-around-code-fences': {enabled: false},
+      },
+    } as unknown as LinterSettings;
+
+    const [result] = EmptyLineAroundCodeFences.applyIfEnabled(nestedCallouts, settings, []);
+
+    expectSingleMarkerBetweenChildCallouts(result);
+  });
+});
