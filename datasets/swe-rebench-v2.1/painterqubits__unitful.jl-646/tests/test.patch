+# A number type that defines only `<=`, not `==` or `<`
+struct Issue399 <: Integer
+    num::Int
+end
+Base.:<(::Issue399, ::Issue399) = error("< not defined")
+Base.:(==)(::Issue399, ::Issue399) = error("== not defined")
+Base.:(<=)(x::Issue399, y::Issue399) = x.num <= y.num
+
