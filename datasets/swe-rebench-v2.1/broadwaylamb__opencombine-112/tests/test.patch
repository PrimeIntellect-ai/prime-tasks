+//
+//  ObservableObjectPublisherTests.swift
+//
+//
+//  Created by Sergej Jaskiewicz on 26.11.2019.
+//
+
+import XCTest
+
+#if OPENCOMBINE_COMPATIBILITY_TEST
+import Combine
+#else
+import OpenCombine
+#endif
+
+@available(macOS 10.15, iOS 13.0, *)
+final class ObservableObjectPublisherTests: XCTestCase {
+
+    func testBasicBehavior() {
+        let publisher = ObservableObjectPublisher()
+        var downstreamSubscription: Subscription?
+        let tracking = TrackingSubscriberBase<Void, Never>(
+            receiveSubscription: { downstreamSubscription = $0 }
+        )
+        publisher.subscribe(tracking)
+        XCTAssertEqual(Array(tracking.subscriptions).count, 1)
+
+        downstreamSubscription?.request(.max(1))
+        publisher.send()
+        XCTAssertEqual(Array(tracking.inputs).count, 1)
+
+        // No signal may be delivered without demand. Implementations may
+        // discard, coalesce, or retain signals that are pending demand.
+        publisher.send()
+        XCTAssertEqual(Array(tracking.inputs).count, 1)
+
+        downstreamSubscription?.cancel()
+        publisher.send()
+        downstreamSubscription?.request(.unlimited)
+        XCTAssertEqual(Array(tracking.inputs).count, 1)
+    }
+}
diff --git a/Tests/OpenCombineTests/PublishedTests.swift b/Tests/OpenCombineTests/PublishedTests.swift
new file mode 100644
index 0000000..40de194
--- /dev/null
+++ b/Tests/OpenCombineTests/PublishedTests.swift
@@ -0,0 +1,111 @@
+//
+//  PublishedTests.swift
+//
+//
+//  Created by Sergej Jaskiewicz on 08/09/2019.
+//
+
+import XCTest
+
+#if swift(>=5.1)
+
+#if OPENCOMBINE_COMPATIBILITY_TEST
+import Combine
+
+@available(macOS 10.15, iOS 13.0, *)
+private typealias Published = Combine.Published
+
+@available(macOS 10.15, iOS 13.0, *)
+private typealias ObservableObject = Combine.ObservableObject
+#else
+import OpenCombine
+
+private typealias Published = OpenCombine.Published
+
+private typealias ObservableObject = OpenCombine.ObservableObject
+#endif
+
+@available(macOS 10.15, iOS 13.0, *)
+final class PublishedTests: XCTestCase {
+
+    func testBasicBehavior() {
+        let testObject = TestObject()
+        var downstreamSubscription1: Subscription?
+        let tracking1 = TrackingSubscriberBase<Int, Never>(
+            receiveSubscription: { downstreamSubscription1 = $0 }
+        )
+        testObject.$state.subscribe(tracking1)
+
+        // Subscribing attaches the subscriber. The concrete publisher and its
+        // subscription are implementation details, so only the fact that a
+        // subscription was established is checked here.
+        XCTAssertEqual(Array(tracking1.subscriptions).count, 1)
+
+        // The current value is delivered first.
+        downstreamSubscription1?.request(.max(2))
+        XCTAssertEqual(Array(tracking1.inputs).first, 0)
+
+        testObject.state += 1
+        testObject.state += 2
+        testObject.state += 3
+
+        // The first update is delivered. Updates made while there is no demand
+        // may either be coalesced to the latest value or delivered
+        // individually once demand becomes available; both are acceptable.
+        let intermediate = Array(tracking1.inputs)
+        XCTAssertEqual(intermediate.first, 0)
+        XCTAssertTrue(intermediate.dropFirst().allSatisfy { [1, 3, 6].contains($0) },
+                      "Unexpected values: \(intermediate)")
+
+        downstreamSubscription1?.request(.max(10))
+        XCTAssertEqual(Array(tracking1.inputs).last, 6)
+
+        let tracking2 = TrackingSubscriberBase<Int, Never>(
+            receiveSubscription: { $0.request(.unlimited) }
+        )
+        testObject.$state.subscribe(tracking2)
+        // A new subscriber receives the current value first.
+        XCTAssertEqual(Array(tracking2.inputs), [6])
+
+        testObject.state = 42
+        XCTAssertEqual(Array(tracking1.inputs).last, 42)
+        XCTAssertEqual(Array(tracking2.inputs), [6, 42])
+
+        downstreamSubscription1?.cancel()
+        testObject.state = -1
+        XCTAssertEqual(Array(tracking1.inputs).last, 42)
+        XCTAssertEqual(Array(tracking2.inputs), [6, 42, -1])
+    }
+
+    func testObservableObjectWithCustomObjectWillChange() {
+        let testObject = TestObject()
+        var observedValues: [Int] = []
+        let tracking = TrackingSubscriberBase<Void, Never>(
+            receiveSubscription: { $0.request(.unlimited) },
+            receiveValue: { _ in
+                observedValues.append(testObject.state)
+                return .none
+            }
+        )
+        testObject.objectWillChange.subscribe(tracking)
+
+        testObject.state = 100
+
+        // If a custom change notification is emitted, it precedes the update.
+        XCTAssertTrue(observedValues.allSatisfy { $0 == 0 })
+    }
+}
+
+@available(macOS 10.15, iOS 13.0, *)
+private final class TestObject: ObservableObject {
+
+    let objectWillChange = ObservableObjectPublisher()
+
+    @Published var state: Int
+
+    init() {
+        _state = Published(initialValue: 0)
+    }
+}
+
+#endif
