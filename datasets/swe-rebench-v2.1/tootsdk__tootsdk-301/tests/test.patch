+
+    func testPixelfedStatusCountEncodedAsStringDecodesAsInteger() throws {
+        let json = Data(#"""
+        {
+          "version": "Pixelfed 0.12.3",
+          "stats": { "status_count": "29662653" }
+        }
+        """#.utf8)
+        let result = try TootDecoder().decode(Instance.self, from: json)
+
+        XCTAssertEqual(result.stats.postCount, 29_662_653)
+    }
 }
