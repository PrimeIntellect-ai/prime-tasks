+func TestScalingGroupUpdateUsesEachResolvedSubnetOnce(t *testing.T) {
+	g := gomega.NewGomegaWithT(t)
+	ig := MockInstanceGroup()
+	configuration := ig.GetEKSConfiguration()
+	configuration.Subnets = []string{"subnet-111", "subnet-111", "subnet-222"}
+	ec2Mock := NewEc2Mocker()
+	ec2Mock.Subnets = []*ec2.Subnet{
+		MockSubnet("subnet-111", false, ""),
+		MockSubnet("subnet-222", false, ""),
 	}
+	asgMock := NewAutoScalingMocker()
+	captured := &capturingAutoScalingClient{MockAutoScalingClient: asgMock}
+	w := MockAwsWorker(asgMock, NewIamMocker(), NewEksMocker(), ec2Mock, NewSsmMocker())
+	w.AsgClient = captured
+	ctx := MockContext(ig, MockKubernetesClientSet(), w)
+	ctx.SetDiscoveredState(&DiscoveredState{ScalingGroup: &autoscaling.Group{
+		AutoScalingGroupName:    aws.String("scaling-group"),
+		LaunchConfigurationName: aws.String("launch-configuration"),
+		MinSize:                 aws.Int64(1),
+		MaxSize:                 aws.Int64(3),
+		VPCZoneIdentifier:       aws.String("subnet-existing"),
+	}})
+
+	_, err := ctx.UpdateScalingGroup("launch-configuration", nil)
+	g.Expect(err).NotTo(gomega.HaveOccurred())
+	g.Expect(captured.update).NotTo(gomega.BeNil())
+	got := strings.Split(aws.StringValue(captured.update.VPCZoneIdentifier), ",")
+	sort.Strings(got)
+	g.Expect(got).To(gomega.Equal([]string{"subnet-111", "subnet-222"}))
+}
+
+type capturingAutoScalingClient struct {
+	*MockAutoScalingClient
+	update *autoscaling.UpdateAutoScalingGroupInput
+}
+
+func (c *capturingAutoScalingClient) UpdateAutoScalingGroup(input *autoscaling.UpdateAutoScalingGroupInput) (*autoscaling.UpdateAutoScalingGroupOutput, error) {
+	c.update = input
+	return c.MockAutoScalingClient.UpdateAutoScalingGroup(input)
 }
 
