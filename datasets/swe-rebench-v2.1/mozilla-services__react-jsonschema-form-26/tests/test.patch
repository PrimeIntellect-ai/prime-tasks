+    describe("custom widget", () => {
+      const schema = {
+        type: "string"
+      };
+
+      const uiSchema = {
+        widget: (props) => {
+          return (
+            <input type="text"
+              className="custom"
+              value={props.value}
+              defaultValue={props.defaultValue}
+              required={props.required}
+              onChange={(event) => props.onChange(event.target.value)} />
+          );
+        }
+      };
+
+      it("should render a custom widget", () => {
+        const {node} = createComponent({schema, uiSchema});
+
+        expect(node.querySelectorAll(".custom")).to.have.length.of(1);
+      });
+    });
+
+    describe("custom widget on an object property", () => {
+      const schema = {
+        type: "object",
+        required: ["foo"],
+        properties: {
+          foo: {
+            type: "string",
+            description: "Property placeholder",
+            default: "schema default",
+          },
+        },
+      };
+      let widgetProps;
+      function CustomWidget(props) {
+        widgetProps = props;
+        return (
+          <input
+            className="property-custom"
+            value={props.value}
+            onChange={(event) => props.onChange(event.target.value)} />
+        );
+      }
+      const uiSchema = {
+        foo: {widget: CustomWidget},
+      };
+
+      it("should render the widget and provide the field props", () => {
+        const {node} = createComponent({
+          schema,
+          uiSchema,
+          formData: {foo: "current value"},
+        });
+
+        expect(node.querySelectorAll(".property-custom")).to.have.length.of(1);
+        expect(widgetProps.placeholder).eql("Property placeholder");
+        expect(widgetProps.value).eql("current value");
+        expect(widgetProps.defaultValue).eql("schema default");
+        expect(widgetProps.required).eql(true);
+      });
+
+      it("should update form data when the widget changes", () => {
+        const {comp, node} = createComponent({
+          schema,
+          uiSchema,
+          formData: {foo: "before"},
+        });
+
+        Simulate.change(node.querySelector(".property-custom"), {
+          target: {value: "after"},
+        });
+
+        expect(comp.state.formData).eql({foo: "after"});
+      });
+    });
+
