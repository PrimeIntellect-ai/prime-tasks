@@ -21,3 +22,39 @@ describe('CommonJS module API', () => {
 		});
 	});
 });
+
+describe('TypeScript declarations', () => {
+	const fs = require('fs'),
+		path = require('path'),
+		pkg = require('../package.json');
+
+	function resolveDeclarationFile() {
+		// Prefer the explicit package.json entry point, fall back to the
+		// declaration file TypeScript looks for next to the "main" entry.
+		var declared = pkg.types || pkg.typings;
+
+		if (!declared && typeof pkg.main === 'string') {
+			declared = pkg.main.replace(/\.js$/, '.d.ts');
+		}
+
+		return declared ? path.resolve(__dirname, '..', declared) : null;
+	}
+
+	it('should ship a .d.ts declaration file', () => {
+		const declarationFile = resolveDeclarationFile();
+
+		assert.ok(declarationFile, 'package.json should expose a types/typings entry point');
+		assert.ok(/\.d\.ts$/.test(declarationFile), 'declaration file should have a .d.ts extension');
+		assert.ok(fs.existsSync(declarationFile), 'declaration file should exist: ' + declarationFile);
+	});
+
+	it('should declare the analyze function returning a Promise', () => {
+		const declarationFile = resolveDeclarationFile();
+		const source = fs.readFileSync(declarationFile, 'utf8');
+
+		assert.ok(
+			/\bfunction\s+analyze\s*\([\s\S]*?\)\s*:\s*Promise\s*</.test(source),
+			'declaration file should declare analyze with a Promise return type'
+		);
+	});
+});
