+    @Test
+    @Tag(WarningNames.ENUMS_SEPARATED)
+    fun `last element with comment`() {
+        fixAndCompareIgnoringCommaCommentSpacing("LastElementCommentExpected.kt", "LastElementCommentTest.kt")
+    }
+
+    private fun fixAndCompareIgnoringCommaCommentSpacing(expectedName: String, inputName: String) {
+        fun readResource(name: String) = javaClass.classLoader
+            .getResource("$resourceFilePath/$name")!!
+            .readText()
+        fun normalize(text: String) = text.replace(Regex(",[\\t ]*(?=//|/\\*)"), ",")
+
+        val actual = format(
+            { rules -> DiktatRuleSetProvider4Test(::EnumsSeparated, rules) },
+            readResource(inputName),
+            inputName
+        )
+        Assertions.assertEquals(normalize(readResource(expectedName)), normalize(actual))
     }
