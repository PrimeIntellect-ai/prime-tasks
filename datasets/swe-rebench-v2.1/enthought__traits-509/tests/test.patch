diff --git a/traits/tests/test_category.py b/traits/tests/test_category.py
index da07bcfe..f72550d6 100644
--- a/traits/tests/test_category.py
+++ b/traits/tests/test_category.py
@@ -104,3 +104,56 @@ class CategoryTestCase(unittest.TestCase):
         except SystemError:
             pass
         return
+
+    def test_subclasses_dont_modify_category_base_class(self):
+        # Regression test for enthought/traits#507.
+        self.assertEqual(Category.__class_traits__, {})
+
+        class A(HasTraits):
+            a = Str()
+
+        class B(Category, A):
+            b = Str()
+
+        class C(Category, A):
+            c = Str()
+
+        self.assertEqual(Category.__class_traits__, {})
+
+    def test_multiple_category_hierarchies_are_independent(self):
+        # Regression test for enthought/traits#507: defining a second,
+        # unrelated Category hierarchy in the same file must not fail.
+        class A(HasTraits):
+            a = Str()
+
+        class B(Category, A):
+            b = Str()
+
+        class C(Category, A):
+            c = Str()
+
+        class D(HasTraits):
+            d = Str()
+
+        class E(Category, D):
+            e = Str()
+
+        # The Category base class is not modified by any of the
+        # subclass definitions.
+        self.assertEqual(Category.__class_traits__, {})
+
+        # The two hierarchies are independent: traits from one hierarchy
+        # do not leak into the other.
+        a = A()
+        self.assertEqual(a.a, "")
+        self.assertEqual(a.b, "")
+        self.assertEqual(a.c, "")
+        self.assertFalse(hasattr(a, "d"))
+        self.assertFalse(hasattr(a, "e"))
+
+        d = D()
+        self.assertEqual(d.d, "")
+        self.assertEqual(d.e, "")
+        self.assertFalse(hasattr(d, "a"))
+        self.assertFalse(hasattr(d, "b"))
+        self.assertFalse(hasattr(d, "c"))
