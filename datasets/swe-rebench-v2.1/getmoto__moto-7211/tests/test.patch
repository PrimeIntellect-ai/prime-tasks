+@mock_s3
+@mock_sagemakerruntime
+def test_invoke_endpoint_async():
+    client = boto3.client("sagemaker-runtime", region_name="us-east-1")
+    base_url = (
+        "localhost:5000" if settings.TEST_SERVER_MODE else "motoapi.amazonaws.com"
+    )
+
+    sagemaker_result = {
+        "results": [
+            {
+                "Body": "first body",
+                "ContentType": "text/xml",
+                "InvokedProductionVariant": "prod",
+                "CustomAttributes": "my_attr",
+            },
+            {"Body": "plain text output: not-json {unstructured"},
+        ]
+    }
+    requests.post(
+        f"http://{base_url}/moto-api/static/sagemaker/endpoint-results",
+        json=sagemaker_result,
+    )
+
+    # Make an initial invocation before checking an invocation with an inference ID.
+    client.invoke_endpoint_async(
+        EndpointName="asdf", InputLocation="s3://input-bucket/input-key"
+    )
+    # Invoke again with a different input and the supplied inference ID.
+    body = client.invoke_endpoint_async(
+        EndpointName="asdf",
+        InputLocation="s3://input-bucket/other-key",
+        InferenceId="sth",
+    )
+    response_values = [str(value) for value in body.values()]
+    response_values.extend(body["ResponseMetadata"]["HTTPHeaders"].values())
+    second_output_location = next(
+        value for value in response_values if value.startswith("s3://")
+    )
+    assert "sth" in response_values
+
+    s3 = boto3.client("s3", "us-east-1")
+    output_uri = urlsplit(second_output_location)
+    assert output_uri.scheme == "s3"
+    # A successful read confirms the returned location contains a retrievable result.
+    result = s3.get_object(
+        Bucket=output_uri.netloc, Key=output_uri.path.lstrip("/")
+    )["Body"].read()
+    assert b"plain text output: not-json {unstructured" in result
