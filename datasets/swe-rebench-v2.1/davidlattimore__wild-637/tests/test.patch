+//#CompArgs:-fPIC -ftls-model=global-dynamic
+//#CompSoArgs:-fPIC -ftls-model=global-dynamic -DSHARED_LIB
+//#Shared:dynamic-bss-only.c
+//#LinkerDriver:gcc
+//#LinkArgs:-Wl,-z,now
+//#DiffIgnore:.dynamic.DT_RELAENT
+//#DiffIgnore:.dynamic.DT_RELA
+//#DiffIgnore:.dynamic.DT_NEEDED
+//#DiffIgnore:section.rodata
+#ifdef SHARED_LIB
+
+__attribute__ ((aligned(256)))
+static __thread long int tvar1;
+
+long int get_tvar1(void) {
+    return tvar1;
+}
+
+void set_tvar1(long int value) {
+    tvar1 = value;
+}
+
+#else
+
+long int get_tvar1(void);
+void set_tvar1(long int value);
+static __thread long int main_tls;
+
+int main() {
+    main_tls = 7;
+    set_tvar1(42);
+    if (main_tls != 7) return 1;
+    return (int)get_tvar1();
+}
+
+#endif
