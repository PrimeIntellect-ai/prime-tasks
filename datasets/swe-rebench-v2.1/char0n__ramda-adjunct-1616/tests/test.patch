diff --git a/test/catchP.js b/test/catchP.js
new file mode 100644
index 0000000..583c29e
--- /dev/null
+++ b/test/catchP.js
@@ -0,0 +1,80 @@
+import { assert } from 'chai';
+import * as R from 'ramda';
+
+import * as RA from '../src';
+
+describe('catchP', function () {
+  context('given applied on rejected Promise', function () {
+    specify(
+      'should resolve with the result of the onRejected function',
+      async function () {
+        const promise = RA.rejectP(1);
+        const expected = await RA.catchP(R.add(1), promise);
+
+        assert.strictEqual(expected, 2);
+      }
+    );
+  });
+
+  context('given applied on fulfilled Promise', function () {
+    specify(
+      'should resolve with the original fulfillment value',
+      async function () {
+        const promise = RA.resolveP(1);
+        const result = RA.catchP(() => 'handled', promise);
+
+        assert.instanceOf(result, Promise);
+        assert.strictEqual(await result, 1);
+      }
+    );
+  });
+
+  context('given onRejected returns a Promise', function () {
+    specify(
+      'should resolve with the result of the returned Promise',
+      async function () {
+        const promise = RA.rejectP(1);
+        const expected = await RA.catchP(() => RA.resolveP(2), promise);
+
+        assert.strictEqual(expected, 2);
+      }
+    );
+  });
+
+  context('given onRejected throws', function () {
+    specify('should reject with the thrown error', async function () {
+      const error = new Error('onRejected failed');
+      const promise = RA.rejectP(1);
+
+      let rejectedWith;
+      try {
+        await RA.catchP(() => {
+          throw error;
+        }, promise);
+      } catch (e) {
+        rejectedWith = e;
+      }
+
+      assert.strictEqual(rejectedWith, error);
+    });
+  });
+
+  context('given applied on Thenable', function () {
+    specify('should throw TypeError', function () {
+      const thenable = { then: (fn) => RA.rejectP(fn(1)) };
+
+      assert.throws(() => RA.catchP(R.identity, thenable), TypeError);
+    });
+  });
+
+  context('given applied on non-thenable', function () {
+    specify('should throw TypeError', function () {
+      assert.throws(() => RA.catchP(R.identity, {}), TypeError);
+    });
+  });
+
+  it('should be curried', async function () {
+    assert.strictEqual(await RA.catchP(R.identity, RA.rejectP(1)), 1);
+    assert.strictEqual(await RA.catchP(R.identity)(RA.rejectP(1)), 1);
+  });
+});
diff --git a/types/test/catchP.ts b/types/test/catchP.ts
