+
+func TestCreateConfiguration(t *testing.T) {
+	t.Cleanup(test.CleanConfigDir(t))
+
+	cmd := createCommand()
+	cmd.PersistentFlags().AddFlagSet(config.Flags)
+	cmd.SetArgs([]string{"config1", "--registry.address=address", "--registry.insecure=true"})
+	if err := cmd.Execute(); err != nil {
+		t.Fatal(err)
+	}
+	c, err := config.Read("config1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.Registry.Address != "address" || !c.Registry.Insecure {
+		t.Errorf("config1 did not save explicitly supplied registry values: %+v", c.Registry)
+	}
+
+	cmd = createCommand()
+	cmd.PersistentFlags().AddFlagSet(config.Flags)
+	cmd.SetArgs([]string{"config3", "--registry.location", "location"})
+	if err := cmd.Execute(); err != nil {
+		t.Fatal(err)
+	}
+	if c, err = config.Read("config3"); err != nil {
+		t.Fatal(err)
+	}
+	if c.Registry.Location != "location" {
+		t.Errorf("config3 did not save explicitly supplied location: %q", c.Registry.Location)
+	}
+
+	cmd = createCommand()
+	cmd.PersistentFlags().AddFlagSet(config.Flags)
+	cmd.SetArgs([]string{"config4", "--registry.project", "project"})
+	if err := cmd.Execute(); err != nil {
+		t.Fatal(err)
+	}
+	if c, err = config.Read("config4"); err != nil {
+		t.Fatal(err)
+	}
+	if c.Registry.Project != "project" {
+		t.Errorf("config4 did not save explicitly supplied project: %q", c.Registry.Project)
+	}
+}
