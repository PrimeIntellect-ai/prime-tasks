+
+func TestShowValuesPreservesSource(t *testing.T) {
+	dir, err := ioutil.TempDir("", "helm-show-values")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+
+	chartYAML := []byte("apiVersion: v2\nname: comments\nversion: 0.1.0\n")
+	valuesYAML := "# Controls the greeting shown to users.\n\ngreeting: \"hello\"\n"
+	if err := ioutil.WriteFile(filepath.Join(dir, "Chart.yaml"), chartYAML, 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := ioutil.WriteFile(filepath.Join(dir, "values.yaml"), []byte(valuesYAML), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	cmd := exec.Command("go", "run", "../../cmd/helm", "show", "values", dir)
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("helm show values failed: %v\n%s", err, output)
+	}
+	assert.Contains(t, string(output), valuesYAML)
+}
