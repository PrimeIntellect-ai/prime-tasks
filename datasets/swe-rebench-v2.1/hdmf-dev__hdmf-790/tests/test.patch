+    def test_get_object_resources_returns_all_registered_keys(self):
+        er = ExternalResources(name='terms')
+        table = DynamicTable(name='test_table', description='test table description')
+        table.add_column(name='test_col', description='test column description')
+        table.add_row(test_col='Mouse')
+        table.add_row(test_col='Human')
+
+        er.add_ref(container=table, attribute='test_col', key='Mouse',
+                   resource_name='NCBI_Taxonomy', resource_uri='https://example.org/taxonomy',
+                   entity_id='mouse-id', entity_uri='https://example.org/taxonomy/mouse')
+        er.add_ref(container=table, attribute='test_col', key='Human',
+                   resource_name='NCBI_Taxonomy', resource_uri='https://example.org/taxonomy',
+                   entity_id='human-id', entity_uri='https://example.org/taxonomy/human')
+
+        received = er.get_object_resources(table['test_col'])
+        expected = pd.DataFrame(
+            data=[[0, 0, 'mouse-id', 'https://example.org/taxonomy/mouse'],
+                  [1, 0, 'human-id', 'https://example.org/taxonomy/human']],
+            columns=['keys_idx', 'resource_idx', 'entity_id', 'entity_uri'])
+        self.assertEqual(list(received.columns), list(expected.columns))
+        self.assertEqual(set(map(tuple, received.to_numpy())), set(map(tuple, expected.to_numpy())))
+
+    def test_get_object_resources_roundtrip(self):
+        # Regression test for the reported ValueError about the shape of the
+        # DataFrame generated by get_object_resources. After the ExternalResources
+        # is written and read back, the entities table is backed by a numpy
+        # structured array; the getter must still return a DataFrame with one row
+        # per resource linked to the keys used by the container.
+        er = ExternalResources(name='terms')
+        table = DynamicTable(name='test_table', description='test table description')
+        table.add_column(name='test_col', description='test column description')
+        table.add_row(test_col='Mouse')
+        er.add_ref(container=table, key='Mouse',
+                   resource_name='NCBI_Taxonomy',
+                   resource_uri='https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi',
+                   entity_id='NCBI:txid10090',
+                   entity_uri='https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?id=10090')
+
+        filename = 'test_get_object_resources_roundtrip.h5'
+        try:
+            with HDF5IO(filename, manager=get_manager(), mode='w') as io:
+                io.write(er)
+            with HDF5IO(filename, manager=get_manager(), mode='r') as io:
+                read_er = io.read()
+                received = read_er.get_object_resources(container=table, relative_path='', field='')
+                expected = pd.DataFrame(
+                    data=[[0, 0, 'NCBI:txid10090',
+                           'https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?id=10090']],
+                    columns=['keys_idx', 'resource_idx', 'entity_id', 'entity_uri'])
+                # The contract fixes the column names and row values, not the
+                # integer dtypes, which depend on how the table was serialized.
+                pd.testing.assert_frame_equal(received, expected, check_dtype=False)
+        finally:
+            remove_test_file(filename)
+
