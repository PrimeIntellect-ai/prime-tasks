+func TestGetRuleParamNamesAcrossRules(t *testing.T) {
+	ruleTexts := []string{
+		`first = input.parameters.z { x := input.parameters.a }`,
+		`second = input.parameters.b { x := input.parameters.z; y := input.parameters.c }`,
+	}
+	rules := make([]*ast.Rule, 0, len(ruleTexts))
+	for _, text := range ruleTexts {
+		rule, err := ast.ParseRule(text)
+		if err != nil {
+			t.Fatalf("parse rule: %s", err)
+		}
+		rules = append(rules, rule)
+	}
+
+	want := []string{"z", "a", "b", "c"}
+	got := getRuleParamNames(rules)
+	if !reflect.DeepEqual(want, got) {
+		t.Errorf("unexpected parameter names: want %v, got %v", want, got)
 	}
 }
 
