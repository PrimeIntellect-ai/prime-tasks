+def test_duplicate_dists(flake8_dist):
+    # some poorly packaged pythons put lib and lib64 on sys.path resulting in
+    # duplicates from `importlib.metadata.distributions`
+    with mock.patch.object(
+        importlib_metadata,
+        "distributions",
+        return_value=[
+            flake8_dist,
+            flake8_dist,
+        ],
+    ):
+        # flake8 should start up without error.  previously the duplicate
+        # distributions caused the same plugin options (e.g. --max-complexity)
+        # to be registered twice which raised ``argparse.ArgumentError``.
+        app = Application()
+        app.initialize(["--isolated"])
+
+    # initialization completed and plugins were discovered
+    assert app.plugins is not None
+
