diff --git a/tests/OptionsTest.php b/tests/OptionsTest.php
index 4e53612..392beb1 100644
--- a/tests/OptionsTest.php
+++ b/tests/OptionsTest.php
@@ -316,4 +316,58 @@ final class OptionsTest extends TestCase
         $model = new RendererModel("src/templates/main.php", $params);
         $this->assertEquals(false, $model->repeat);
     }
+
+    /**
+     * Test separator set to something other than ";"
+     */
+    public function testSeparator(): void
+    {
+        $params = [
+            "lines" => "text;text2||tex;;t3",
+            "separator" => "||",
+        ];
+        $model = new RendererModel("src/templates/main.php", $params);
+        $this->assertEquals(["text;text2", "tex;;t3"], $model->lines);
+    }
+
+    /**
+     * Test that the separator defaults to ";" when omitted
+     */
+    public function testDefaultSeparator(): void
+    {
+        $params = [
+            "lines" => "text;text2",
+        ];
+        $model = new RendererModel("src/templates/main.php", $params);
+        $this->assertEquals(["text", "text2"], $model->lines);
+    }
+
+    /**
+     * Test that lines split with a custom separator are HTML-escaped
+     */
+    public function testSeparatorEscapesLines(): void
+    {
+        $params = [
+            "lines" => "a<b||c&d",
+            "separator" => "||",
+        ];
+        $model = new RendererModel("src/templates/main.php", $params);
+        $this->assertEquals(["a&lt;b", "c&amp;d"], $model->lines);
+    }
+
+    /**
+     * Test that a non-default delimiter separates lines without consuming semicolons in them
+     */
+    public function testSemicolonsInsideLinesWithCustomSeparator(): void
+    {
+        $controller = new RendererController([
+            "lines" => "First;line||Second;;line",
+            "separator" => "||",
+        ]);
+        $svg = $controller->render();
+
+        $this->assertStringContainsString("First;line", $svg);
+        $this->assertStringContainsString("Second;;line", $svg);
+        $this->assertStringNotContainsString("||", $svg);
+    }
 }
