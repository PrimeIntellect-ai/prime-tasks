+func testWSNoCorruptionWithFrameSizeLimit(t *testing.T, total, payloadSize int) {
+	tmpl := `
+               listen: "127.0.0.1:-1"
+               cluster {
+                       name: "local"
+                       port: -1
+                       %s
+               }
+               websocket {
+                       listen: "127.0.0.1:-1"
+                       no_tls: true
+               }
+       `
+	conf1 := createConfFile(t, []byte(fmt.Sprintf(tmpl, _EMPTY_)))
+	s1, o1 := RunServerWithConfig(conf1)
+	defer s1.Shutdown()
+
+	routes := fmt.Sprintf("routes: [\"nats://127.0.0.1:%d\"]", o1.Cluster.Port)
+	conf2 := createConfFile(t, []byte(fmt.Sprintf(tmpl, routes)))
+	s2, o2 := RunServerWithConfig(conf2)
+	defer s2.Shutdown()
+
+	conf3 := createConfFile(t, []byte(fmt.Sprintf(tmpl, routes)))
+	s3, o3 := RunServerWithConfig(conf3)
+	defer s3.Shutdown()
+
+	checkClusterFormed(t, s1, s2, s3)
+
+	nc3 := natsConnect(t, fmt.Sprintf("ws://127.0.0.1:%d", o3.Websocket.Port))
+	defer nc3.Close()
+
+	nc2 := natsConnect(t, fmt.Sprintf("ws://127.0.0.1:%d", o2.Websocket.Port))
+	defer nc2.Close()
+
+	payload := make([]byte, payloadSize)
+	for i := 0; i < len(payload); i++ {
+		payload[i] = 'A' + byte(i%26)
+	}
+	errCh := make(chan error, 1)
+	doneCh := make(chan struct{}, 1)
+	count := int32(0)
+
+	createSub := func(nc *nats.Conn) {
+		sub := natsSub(t, nc, "foo", func(m *nats.Msg) {
+			if !bytes.Equal(m.Data, payload) {
+				stop := len(m.Data)
+				if l := len(payload); l < stop {
+					stop = l
+				}
+				start := 0
+				for i := 0; i < stop; i++ {
+					if m.Data[i] != payload[i] {
+						start = i
+						break
+					}
+				}
+				if stop-start > 20 {
+					stop = start + 20
+				}
+				select {
+				case errCh <- fmt.Errorf("Invalid message: [%d bytes same]%s[...]", start, m.Data[start:stop]):
+				default:
+				}
+				return
+			}
+			if n := atomic.AddInt32(&count, 1); int(n) == 3*total {
+				doneCh <- struct{}{}
+			}
+		})
+		sub.SetPendingLimits(-1, -1)
+	}
+	createSub(nc2)
+	createSub(nc3)
+
+	// Also verify ordinary NATS subscribers remain intact while WebSocket
+	// subscribers are receiving the same publications.
+	ncCore := natsConnect(t, fmt.Sprintf("nats://127.0.0.1:%d", o1.Port))
+	defer ncCore.Close()
+	createSub(ncCore)
+
+	checkSubInterest(t, s1, globalAccountName, "foo", time.Second)
+
+	nc1 := natsConnect(t, fmt.Sprintf("ws://127.0.0.1:%d", o1.Websocket.Port))
+	defer nc1.Close()
+	natsFlush(t, nc1)
+
+	var browserDone <-chan error
+	if total <= 1000 {
+		browserConn, browserReader, _ := testNewWSClient(t, testWSClientOptions{
+			web: true, host: o1.Websocket.Host, port: o1.Websocket.Port, noTLS: true,
+		})
+		defer browserConn.Close()
+		if err := browserConn.SetReadDeadline(time.Now().Add(30 * time.Second)); err != nil {
+			t.Fatalf("Could not set browser WebSocket read deadline: %v", err)
+		}
+		connect := testWSCreateClientMsg(wsBinaryMessage, 1, true, false, []byte("CONNECT {\"verbose\":false,\"protocol\":1}\r\nPING\r\n"))
+		if _, err := browserConn.Write(connect); err != nil {
+			t.Fatalf("Could not initialize browser WebSocket client: %v", err)
+		}
+		if pong := testWSReadFrame(t, browserReader); !bytes.HasPrefix(pong, []byte("PONG\r\n")) {
+			t.Fatalf("Expected PONG after browser connection, got %q", pong)
+		}
+		sub := testWSCreateClientMsg(wsBinaryMessage, 1, true, false, []byte("SUB foo 99\r\nPING\r\n"))
+		if _, err := browserConn.Write(sub); err != nil {
+			t.Fatalf("Could not subscribe browser WebSocket client: %v", err)
+		}
+		if pong := testWSReadFrame(t, browserReader); !bytes.HasPrefix(pong, []byte("PONG\r\n")) {
+			t.Fatalf("Expected PONG after browser subscription, got %q", pong)
+		}
+		done := make(chan error, 1)
+		browserDone = done
+		go func() { done <- readBrowserNATSMessages(browserReader, payload, total) }()
+	}
+
+	for i := 0; i < total; i++ {
+		natsPub(t, nc1, "foo", payload)
+		if i%100 == 0 {
+			select {
+			case err := <-errCh:
+				t.Fatalf("Error: %v", err)
+			default:
+			}
+		}
+	}
+	select {
+	case err := <-errCh:
+		t.Fatalf("Error: %v", err)
+	case <-doneCh:
+		if browserDone != nil {
+			select {
+			case err := <-browserDone:
+				if err != nil {
+					t.Fatalf("Browser WebSocket delivery failed: %v", err)
+				}
+			case <-time.After(10 * time.Second):
+				t.Fatalf("Timed out waiting for browser WebSocket messages")
+			}
+		}
+		return
+	case <-time.After(10 * time.Second):
+		t.Fatalf("Test timed out")
+	}
+}
