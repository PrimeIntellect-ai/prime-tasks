+func TestWSNoCorruptionWithFrameSizeLimitJetStreamReplay(t *testing.T) {
+	conf := createConfFile(t, []byte(fmt.Sprintf(`
+               port: -1
+               jetstream { store_dir: %q }
+               websocket { listen: "127.0.0.1:-1"; no_tls: true }
+       `, t.TempDir())))
+	s, opts := RunServerWithConfig(conf)
+	defer s.Shutdown()
+
+	ncCore := natsConnect(t, fmt.Sprintf("nats://127.0.0.1:%d", opts.Port))
+	defer ncCore.Close()
+	ncWS := natsConnect(t, fmt.Sprintf("ws://127.0.0.1:%d", opts.Websocket.Port))
+	defer ncWS.Close()
+	ncWS2 := natsConnect(t, fmt.Sprintf("ws://127.0.0.1:%d", opts.Websocket.Port))
+	defer ncWS2.Close()
+
+	js, err := ncWS.JetStream()
+	if err != nil {
+		t.Fatalf("Could not create JetStream context over WebSocket: %v", err)
+	}
+	if _, err := js.AddStream(&nats.StreamConfig{Name: "TEST", Subjects: []string{"foo"}}); err != nil {
+		t.Fatalf("Could not create stream: %v", err)
+	}
+	pull, err := js.PullSubscribe("foo", "WS_REPLAY", nats.BindStream("TEST"))
+	if err != nil {
+		t.Fatalf("Could not create WebSocket pull consumer: %v", err)
+	}
+	js2, err := ncWS2.JetStream()
+	if err != nil {
+		t.Fatalf("Could not create second JetStream context over WebSocket: %v", err)
+	}
+	pull2, err := js2.PullSubscribe("foo", "WS_REPLAY_2", nats.BindStream("TEST"))
+	if err != nil {
+		t.Fatalf("Could not create second WebSocket pull consumer: %v", err)
+	}
+	coreSub := natsSubSync(t, ncCore, "foo")
+	if err := ncCore.Flush(); err != nil {
+		t.Fatalf("Could not flush core subscription: %v", err)
+	}
+
+	payload := make([]byte, 100000)
+	for i := range payload {
+		payload[i] = 'A' + byte(i%26)
+	}
+	const total = 100
+	for i := 0; i < total; i++ {
+		if _, err := js.Publish("foo", payload); err != nil {
+			t.Fatalf("Could not publish JetStream message %d: %v", i, err)
+		}
+		coreMsg := natsNexMsg(t, coreSub, time.Second)
+		if !bytes.Equal(coreMsg.Data, payload) {
+			t.Fatalf("Core NATS message %d was corrupted (got %d bytes)", i, len(coreMsg.Data))
+		}
+	}
+
+	type fetchResult struct {
+		msgs []*nats.Msg
+		err  error
+	}
+	results := make(chan fetchResult, 2)
+	for _, sub := range []*nats.Subscription{pull, pull2} {
+		go func(sub *nats.Subscription) {
+			msgs, err := sub.Fetch(total, nats.MaxWait(10*time.Second))
+			results <- fetchResult{msgs: msgs, err: err}
+		}(sub)
+	}
+	for consumer := 0; consumer < 2; consumer++ {
+		result := <-results
+		if result.err != nil {
+			t.Fatalf("Could not retrieve JetStream batch for consumer %d: %v", consumer, result.err)
+		}
+		if len(result.msgs) != total {
+			t.Fatalf("Expected %d JetStream messages, got %d", total, len(result.msgs))
+		}
+		for i, msg := range result.msgs {
+			if !bytes.Equal(msg.Data, payload) {
+				t.Fatalf("JetStream message %d for consumer %d was corrupted (got %d bytes)", i, consumer, len(msg.Data))
+			}
+			msg.Ack()
+		}
+	}
+}
