+func readWSMessageForTest(r io.Reader) ([]byte, error) {
+	var message []byte
+	for {
+		var header [2]byte
+		if _, err := io.ReadFull(r, header[:]); err != nil {
+			return nil, err
+		}
+		length := uint64(header[1] & 0x7f)
+		switch length {
+		case 126:
+			var extended [2]byte
+			if _, err := io.ReadFull(r, extended[:]); err != nil {
+				return nil, err
+			}
+			length = uint64(binary.BigEndian.Uint16(extended[:]))
+		case 127:
+			var extended [8]byte
+			if _, err := io.ReadFull(r, extended[:]); err != nil {
+				return nil, err
+			}
+			length = binary.BigEndian.Uint64(extended[:])
+		}
+		if length > uint64(^uint(0)>>1) {
+			return nil, fmt.Errorf("WebSocket frame is too large: %d", length)
+		}
+		frame := make([]byte, int(length))
+		if _, err := io.ReadFull(r, frame); err != nil {
+			return nil, err
+		}
+		message = append(message, frame...)
+		if header[0]&wsFinalBit != 0 {
+			return message, nil
+		}
+	}
+}
+
+func readBrowserNATSMessages(r io.Reader, payload []byte, total int) error {
+	var pending []byte
+	for received := 0; received < total; {
+		frame, err := readWSMessageForTest(r)
+		if err != nil {
+			return err
+		}
+		pending = append(pending, frame...)
+		for {
+			lineEnd := bytes.Index(pending, []byte("\r\n"))
+			if lineEnd < 0 {
+				break
+			}
+			fields := strings.Fields(string(pending[:lineEnd]))
+			if len(fields) < 4 || fields[0] != "MSG" || fields[1] != "foo" {
+				return fmt.Errorf("unexpected NATS message header %q", pending[:lineEnd])
+			}
+			var size int
+			if _, err := fmt.Sscanf(fields[len(fields)-1], "%d", &size); err != nil || size < 0 {
+				return fmt.Errorf("invalid NATS message size in %q", pending[:lineEnd])
+			}
+			start, end := lineEnd+2, lineEnd+2+size
+			if len(pending) < end+2 {
+				break
+			}
+			if !bytes.Equal(pending[start:end], payload) {
+				return fmt.Errorf("browser WebSocket message %d did not retain its original bytes", received)
+			}
+			if !bytes.Equal(pending[end:end+2], []byte("\r\n")) {
+				return fmt.Errorf("browser WebSocket message %d has an invalid terminator", received)
+			}
+			pending = pending[end+2:]
+			received++
+		}
+	}
+	return nil
+}
