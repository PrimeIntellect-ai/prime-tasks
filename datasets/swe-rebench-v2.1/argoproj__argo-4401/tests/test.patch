+func TestFromUnstructuredObj(t *testing.T) {
+	un := &unstructured.Unstructured{}
+	err := yaml.Unmarshal([]byte(`apiVersion: argoproj.io/v1alpha1
+kind: Workflow
+metadata:
+  generateName: hello-world-parameters-
+spec:
+  entrypoint: whalesay
+  arguments:
+    parameters:
+      - name: age
+        value: 30
+  templates:
+    - name: whalesay
+      inputs:
+        parameters:
+          - name: age
+            value: 20
+      container:
+        image: my-image`), un)
+	assert.NoError(t, err)
+	wf, err := FromUnstructured(un)
+	if assert.NoError(t, err) {
+		assert.Equal(t, wfv1.Int64OrStringPtr("30"), wf.Spec.Arguments.Parameters[0].Value)
+		assert.Equal(t, wfv1.Int64OrStringPtr("20"), wf.Spec.Templates[0].Inputs.Parameters[0].Value)
+	}
+}
