+    def test_convert_dtypes_pyarrow_engine_csv(self):
+        # GH#56581
+        pytest.importorskip("pyarrow")
+        data = "Date Arrived,Arrival Time\n12/19/23,18:42\n"
+        df = pd.read_csv(StringIO(data), engine="pyarrow")
+        result = df.convert_dtypes()
+        # converting must not raise a TypeError (GH#56581)
+        assert isinstance(result, pd.DataFrame)
+        assert result.index.equals(df.index)
+        assert result.columns.equals(df.columns)
+        values_match = result.eq(df) | (result.isna() & df.isna())
+        assert values_match.fillna(False).to_numpy().all()
