+
+@testset "`Postwalk`/`PassThrough` convert integer-valued float exponents" begin
+    @syms X
+
+    function make_int_exps(expr)
+        Rewriters.Postwalk(Rewriters.PassThrough(_make_int_exps))(unwrap(expr))
+    end
+    function _make_int_exps(expr)
+        !iscall(expr) && return expr
+        if operation(expr) == ^
+            if isinteger(sorted_arguments(expr)[2])
+                return sorted_arguments(expr)[1]^Int64(sorted_arguments(expr)[2])
+            else
+                error("An non integer exponent was found.")
+            end
+        end
+    end
+
+    eq = 2.0 * X^3.0
+    res = make_int_exps(eq)
+
+    # Preserve the coefficient and base while converting the exponent to an integer.
+    factors = arguments(res)
+    pow = only(filter(arg -> iscall(arg) && operation(arg) == ^, factors))
+    @test 2.0 in factors
+    @test isequal(arguments(pow)[1], X)
+    @test arguments(pow)[2] isa Integer
+    @test isequal(arguments(pow)[2], 3)
+end
