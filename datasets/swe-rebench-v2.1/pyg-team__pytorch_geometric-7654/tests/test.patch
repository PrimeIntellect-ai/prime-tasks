+def test_add_random_edge_does_not_add_existing_edges_on_dense_graph():
+    edge_ids = torch.arange(25)
+    edge_index = torch.stack([edge_ids // 5, edge_ids % 5])
+    out = add_random_edge(edge_index, p=0.5, num_nodes=5)
+    assert_no_existing_edges(edge_index, out[1])
+
+
+def test_add_random_edge_adds_edges_when_non_edges_are_available():
+    edge_index = torch.tensor([[0], [1]])
+    _, edge_index_to_add = add_random_edge(edge_index, p=1.0, num_nodes=4)
+    assert edge_index_to_add.size(1) > 0
+    assert_no_existing_edges(edge_index, edge_index_to_add)
