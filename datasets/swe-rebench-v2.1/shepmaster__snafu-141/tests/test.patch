diff --git a/tests/source_and_backtrace.rs b/tests/source_and_backtrace.rs
new file mode 100644
index 0000000..3ce506d
--- /dev/null
+++ b/tests/source_and_backtrace.rs
@@ -0,0 +1,49 @@
+extern crate snafu;
+
+use snafu::{Backtrace, ErrorCompat, ResultExt, Snafu};
+
+#[derive(Debug, Snafu)]
+enum InnerError {
+    InnerVariant { backtrace: Backtrace },
+}
+
+#[derive(Debug, Snafu)]
+enum Error {
+    SourceAndBacktraceAttrs {
+        // Testing source and backtrace attributes; the field should be recognized as a source,
+        // and allow us to get a backtrace delegated from the source error
+        #[snafu(source, backtrace)]
+        cause: InnerError,
+    },
+}
+
+fn example() -> Result<(), Error> {
+    InnerVariant.fail().context(SourceAndBacktraceAttrs)
+}
+
+#[test]
+fn delegated_backtrace_works() {
+    let e = example().unwrap_err();
+    ErrorCompat::backtrace(&e).unwrap();
+}
+
+#[derive(Debug, Snafu)]
+enum TransformedError {
+    SourceFromAndBacktrace {
+        // A source transformation combined with backtrace delegation: the field is still a
+        // source (with the transformation applied) and the backtrace is delegated to it.
+        #[snafu(backtrace)]
+        #[snafu(source(from(InnerError, Box::new)))]
+        my_source: Box<InnerError>,
+    },
+}
+
+fn transformed_example() -> Result<(), TransformedError> {
+    InnerVariant.fail().context(SourceFromAndBacktrace)
+}
+
+#[test]
+fn delegated_backtrace_with_transformation_works() {
+    let e = transformed_example().unwrap_err();
+    ErrorCompat::backtrace(&e).unwrap();
+}
