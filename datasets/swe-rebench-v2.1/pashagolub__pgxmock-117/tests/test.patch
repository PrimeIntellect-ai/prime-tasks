+
+// mockConn adapts NewConn to the example interface without imposing a Close signature.
+type mockConn struct {
+	PgxIface
+	conn pgxmock.PgxConnIface
+}
+
+func (conn mockConn) Begin(ctx context.Context) (pgx.Tx, error) {
+	return conn.conn.Begin(ctx)
+}
+
+// pgxpool.Pool has no BeginTxFunc method, so the public pool interface must not require it.
+func TestPoolInterfaceDoesNotRequireBeginTxFunc(t *testing.T) {
+	poolInterface := reflect.TypeOf((*pgxmock.PgxPoolIface)(nil)).Elem()
+	if _, exists := poolInterface.MethodByName("BeginTxFunc"); exists {
+		t.Fatal("PgxPoolIface must not require BeginTxFunc")
+	}
+}
