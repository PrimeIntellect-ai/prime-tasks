+import { converters } from "../../converters";
+import { convertRules } from "../../convertRules";
+import { mergers } from "../../mergers";
+
+describe("trailing-comma rule conversion", () => {
+    test("dispatches the TSLint rule to an ESLint rule instead of reporting it missing", () => {
+        const result = convertRules(
+            { converters, mergers },
+            { "trailing-comma": { ruleArguments: [] } },
+        );
+
+        expect(result.missing).toEqual([]);
+        expect(result.converted.has("comma-dangle")).toBe(true);
+    });
+});
