+
+#[test]
+fn unsupported_target_for_unused_import() {
+    // If we import a function which doesn't support the current target,
+    // even if we don't use it, the compiler should error
+    let _ = super::module_error(
+        "import mod.{wobble}",
+        vec![(
+            "thepackage",
+            "mod",
+            r#"@external(javascript, "wibble", "wobble") pub fn wobble()"#,
+        )],
+    );
+}
+
+#[test]
+fn supported_target_for_imported_value() {
+    assert_infer_with_module!(
+        (
+            "mod",
+            r#"@external(erlang, "wibble", "wobble") pub fn wobble() -> Int"#
+        ),
+        "import mod.{wobble}
+pub const wobble = wobble",
+        vec![("wobble", "fn() -> Int")],
+    );
+}
+
+#[test]
+fn unsupported_target_for_unused_import_on_javascript() {
+    // The reported case: importing an Erlang-only value while compiling for
+    // JavaScript must be rejected even if the value is never used.
+    let _ = super::module_error_with_target(
+        "import mod.{wobble}",
+        vec![(
+            "thepackage",
+            "mod",
+            r#"@external(erlang, "wibble", "wobble") pub fn wobble() -> Int"#,
+        )],
+        crate::build::Target::JavaScript,
+    );
+}
