+
+"""Tests for Start End Packer layer."""
+
+
+import tensorflow as tf
+from tensorflow import keras
+
+try:
+    from keras_nlp.layers import StartEndPacker
+except ImportError:
+    from keras_nlp.layers.start_end_packer import StartEndPacker
+
+
+class StartEndPackerTest(tf.test.TestCase):
+    def test_is_keras_layer(self):
+        packer = StartEndPacker(sequence_length=5)
+
+        self.assertIsInstance(packer, keras.layers.Layer)
+
+    def test_dense_input(self):
+        input_data = tf.constant([5, 6, 7])
+        start_end_packer = StartEndPacker(sequence_length=5)
+        output = start_end_packer(input_data)
+        self.assertAllEqual(tf.shape(output), [5])
+        self.assertAllEqual(output[:3], [5, 6, 7])
+
+    def test_dense_input_error(self):
+        input_data = tf.constant([[5, 6, 7]])
+        start_end_packer = StartEndPacker(sequence_length=5)
+        with self.assertRaises(Exception):
+            start_end_packer(input_data)
+
+    def test_ragged_input(self):
+        input_data = tf.ragged.constant([[5, 6, 7], [8, 9, 10, 11]])
+        start_end_packer = StartEndPacker(sequence_length=5)
+        output = start_end_packer(input_data)
+        self.assertAllEqual(tf.shape(output), [2, 5])
+        self.assertAllEqual(output[0, :3], [5, 6, 7])
+        self.assertAllEqual(output[1, :4], [8, 9, 10, 11])
+
+    def test_ragged_input_error(self):
+        input_data = tf.ragged.constant([[[5, 6, 7], [8, 9, 10, 11]]])
+        start_end_packer = StartEndPacker(sequence_length=5)
+        with self.assertRaises(Exception):
+            start_end_packer(input_data)
+
+    def test_start_end_token(self):
+        input_data = tf.ragged.constant([[5, 6, 7], [8, 9, 10, 11]])
+        start_end_packer = StartEndPacker(
+            sequence_length=6, start_value=1, end_value=2
+        )
+        output = start_end_packer(input_data)
+        self.assertAllEqual(tf.shape(output), [2, 6])
+        self.assertAllEqual(output[0, :5], [1, 5, 6, 7, 2])
+        self.assertAllEqual(output[1], [1, 8, 9, 10, 11, 2])
+
+    def test_start_token_only(self):
+        input_data = tf.ragged.constant([[5, 6, 7], [8, 9, 10, 11]])
+        start_end_packer = StartEndPacker(sequence_length=5, start_value=1)
+        output = start_end_packer(input_data)
+        self.assertAllEqual(tf.shape(output), [2, 5])
+        self.assertAllEqual(output[0, :4], [1, 5, 6, 7])
+        self.assertAllEqual(output[1], [1, 8, 9, 10, 11])
+
+    def test_end_token_only(self):
+        input_data = tf.ragged.constant([[5, 6, 7], [8, 9, 10, 11]])
+        start_end_packer = StartEndPacker(sequence_length=5, end_value=2)
+        output = start_end_packer(input_data)
+        self.assertAllEqual(tf.shape(output), [2, 5])
+        self.assertAllEqual(output[0, :4], [5, 6, 7, 2])
+        self.assertAllEqual(output[1], [8, 9, 10, 11, 2])
+
+    def test_start_end_padding_value(self):
+        input_data = tf.ragged.constant([[5, 6, 7], [8, 9, 10, 11]])
+        start_end_packer = StartEndPacker(
+            sequence_length=7, start_value=1, end_value=2, pad_value=3
+        )
+        output = start_end_packer(input_data)
+        expected_output = [[1, 5, 6, 7, 2, 3, 3], [1, 8, 9, 10, 11, 2, 3]]
+        self.assertAllEqual(output, expected_output)
+
+    def test_end_token_value_during_truncation(self):
+        input_data = tf.ragged.constant([[5, 6], [8, 9, 10, 11, 12, 13]])
+        start_end_packer = StartEndPacker(
+            sequence_length=5, start_value=1, end_value=2, pad_value=0
+        )
+        output = start_end_packer(input_data)
+        self.assertAllEqual(tf.shape(output), [2, 5])
+        self.assertAllEqual(output[0], [1, 5, 6, 2, 0])
+        self.assertEqual(output[1, 0].numpy(), 1)
+        retained_tokens = tuple(value.numpy() for value in output[1, 1:4])
+        possible_windows = [tuple(range(i, i + 3)) for i in range(8, 12)]
+        self.assertIn(retained_tokens, possible_windows)
+        self.assertEqual(output[1, 4].numpy(), 2)
+
+    def test_string_input(self):
+        input_data = tf.ragged.constant(
+            [["KerasNLP", "is", "awesome"], ["amazing"]]
+        )
+        start_end_packer = StartEndPacker(
+            sequence_length=5,
+            start_value="[START]",
+            end_value="[END]",
+            pad_value="[PAD]",
+        )
+        output = start_end_packer(input_data)
+        expected_output = [
+            ["[START]", "KerasNLP", "is", "awesome", "[END]"],
+            ["[START]", "amazing", "[END]", "[PAD]", "[PAD]"],
+        ]
+        self.assertAllEqual(output, expected_output)
+
+    def test_string_input_default_pad_value(self):
+        input_data = tf.ragged.constant(
+            [["KerasNLP", "is", "awesome"], ["amazing"]]
+        )
+        start_end_packer = StartEndPacker(
+            sequence_length=5,
+            start_value="[START]",
+            end_value="[END]",
+        )
+        output = start_end_packer(input_data)
+        self.assertAllEqual(tf.shape(output), [2, 5])
+        self.assertAllEqual(
+            output[0], ["[START]", "KerasNLP", "is", "awesome", "[END]"]
+        )
+        self.assertAllEqual(output[1, :3], ["[START]", "amazing", "[END]"])
+
+    def test_functional_model(self):
+        input_data = tf.constant([5, 6, 7])
+        start_end_packer = StartEndPacker(
+            sequence_length=7, start_value=1, end_value=2, pad_value=3
+        )
+
+        inputs = keras.Input(dtype=tf.int32, shape=())
+        outputs = start_end_packer(inputs)
+        model = keras.Model(inputs, outputs)
+        model_output = model(input_data)
+
+        expected_output = [1, 5, 6, 7, 2, 3, 3]
+        self.assertAllEqual(model_output, expected_output)
+
+    def test_batch(self):
+        start_end_packer = StartEndPacker(
+            sequence_length=7, start_value=1, end_value=2, pad_value=3
+        )
+
+        ds = tf.data.Dataset.from_tensor_slices(
+            tf.ragged.constant([[5, 6, 7], [8, 9, 10, 11]])
+        )
+        ds = ds.batch(2).map(start_end_packer)
+        output = ds.take(1).get_single_element()
+
+        exp_output = [[1, 5, 6, 7, 2, 3, 3], [1, 8, 9, 10, 11, 2, 3]]
+
+        for i in range(output.shape[0]):
+            self.assertAllEqual(output[i], exp_output[i])
