+def test_getitem_triggering_unnecessary_alignment():
+    df = pd.DataFrame(
+        {
+            "A": [1, 2, 3, 4, 5, 6, 7, 8, 9],
+            "B": [9, 8, 7, 6, 5, 4, 3, 2, 1],
+            "C": [True, False, True] * 3,
+        },
+        columns=list("ABC"),
+    )
+    ddf = from_pandas(df, 2)
+
+    # Boolean filter with a plain co-aligned predicate
+    result = ddf[ddf.C]
+    assert result.expr.optimize().__dask_graph__()
+    assert_eq(result, df[df.C])
+
+    # Boolean filter with a repartitioned predicate must lower fully
+    result = ddf[ddf.C.repartition([0, 2, 5, 8])]
+    assert result.expr.optimize().__dask_graph__()
+    assert_eq(result, df[df.C])
+
+
