+func TestAnchorAliasMergeRoundtripBehavior(t *testing.T) {
+	t.Run("irreversible", func(t *testing.T) {
+		type foo struct {
+			K1 string
+			K2 string
+		}
+
+		type bar struct {
+			K1 string
+			K3 string
+		}
+
+		type doc struct {
+			Foo foo
+			Bar bar
+		}
+		yml := `
+foo:
+ <<: &test-anchor
+   k1: "One"
+ k2: "Two"
+
+bar:
+ <<: *test-anchor
+ k3: "Three"
+`
+		var v doc
+		if err := yaml.Unmarshal([]byte(yml), &v); err != nil {
+			t.Fatalf("%+v", err)
+		}
+		bytes, err := yaml.Marshal(v)
+		if err != nil {
+			t.Fatalf("%+v", err)
+		}
+		// The contract requires the unmarshaled structure to be marshalable as
+		// printable YAML; it does not mandate a specific textual rendering
+		// (quoting, indentation or key order). Verify the marshaled output is
+		// valid YAML that preserves the merged data instead of comparing the
+		// exact source text.
+		var got doc
+		if err := yaml.Unmarshal(bytes, &got); err != nil {
+			t.Fatalf("failed to unmarshal marshaled output %q: %+v", string(bytes), err)
+		}
+		if got != v {
+			t.Fatalf("round trip mismatch: expected %+v but got %+v (yaml: %s)", v, got, string(bytes))
+		}
+	})
+	t.Run("reversible", func(t *testing.T) {
+		type foo struct {
+			K1 string
+			K2 string
+		}
+		type bar struct {
+			K1 string
+			K3 string
+		}
+		type doc struct {
+			Foo foo
+			Bar bar
+		}
+		yml := `
+foo:
+ <<: &test-anchor
+   k1: "One"
+ k2: "Two"
+
+bar:
+ <<: *test-anchor
+ k3: "Three"
+`
+		var v doc
+		if err := yaml.Unmarshal([]byte(yml), &v); err != nil {
+			t.Fatalf("%+v", err)
+		}
+		if v.Foo.K1 != "One" || v.Foo.K2 != "Two" {
+			t.Fatalf("unexpected foo: %+v", v.Foo)
+		}
+		if v.Bar.K1 != "One" || v.Bar.K3 != "Three" {
+			t.Fatalf("unexpected bar: %+v", v.Bar)
+		}
+		bytes, err := yaml.Marshal(v)
+		if err != nil {
+			t.Fatalf("%+v", err)
+		}
+		// The public contract only requires that the unmarshaled structure can
+		// be marshaled back to printable YAML. It does not require reproducing
+		// the original anchor/alias syntax, so verify the marshaled YAML is
+		// valid and preserves the data instead of comparing the exact source.
+		var got doc
+		if err := yaml.Unmarshal(bytes, &got); err != nil {
+			t.Fatalf("failed to unmarshal marshaled output %q: %+v", string(bytes), err)
+		}
+		if got != v {
+			t.Fatalf("round trip mismatch: expected %+v but got %+v (yaml: %s)", v, got, string(bytes))
+		}
+	})
+}
