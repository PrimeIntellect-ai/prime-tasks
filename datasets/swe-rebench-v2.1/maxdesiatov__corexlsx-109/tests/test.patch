+  func testWorksheetPathsAndNames() throws {
+    let cases = [
+      ("categories.xlsx", "Sheet 1"),
+      ("HelloWorld.xlsx", "Arkusz1"),
+    ]
+
+    for (filename, expectedName) in cases {
+      guard let file = XLSXFile(filepath: "\(currentWorkingPath)/\(filename)") else {
+        XCTFail("failed to open \(filename)")
+        continue
+      }
+
+      let workbooks = try file.parseWorkbooks()
+      let sheets = try file.parseWorksheetPathsAndNames(workbook: workbooks[0])
+      let associations = Set(sheets.map { "\($0.name ?? "<unnamed>")|\($0.path)" })
+      XCTAssertEqual(associations, Set(["\(expectedName)|xl/worksheets/sheet1.xml"]))
+    }
+
+    guard let file =
+      XLSXFile(filepath: "\(currentWorkingPath)/categories.xlsx") else {
+      XCTFail("failed to open categories.xlsx")
+      return
+    }
+
+    let workbookWithSeveralNames = Workbook(views: nil, sheets: .init(items: [
+      .init(name: "Another sheet", id: "2", relationship: "rId3"),
+      .init(name: "Requested sheet", id: "1", relationship: "rId4"),
+    ]))
+    let sheets = try file.parseWorksheetPathsAndNames(workbook: workbookWithSeveralNames)
+    let associations = Set(sheets.map { "\($0.name ?? "<unnamed>")|\($0.path)" })
+    XCTAssertEqual(associations, Set(["Requested sheet|xl/worksheets/sheet1.xml"]))
+  }
+
