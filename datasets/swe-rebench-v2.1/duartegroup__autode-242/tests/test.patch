+def test_div_mul_generate_floats():
+
+    e = PotentialEnergy(2.0)
+    other = PotentialEnergy(4.0)
+
+    division = e / other
+    assert division == 0.5
+    if isinstance(division, Value):
+        assert division.units is None
+
+    class ScalarProductEnthalpy(Enthalpy):
+        def __rmul__(self, value):
+            return float(value) * float(self)
+
+    product = e * ScalarProductEnthalpy(4.0)
+    assert float(product) == 8.0
+    if isinstance(product, Value):
+        assert product.units != e.units
