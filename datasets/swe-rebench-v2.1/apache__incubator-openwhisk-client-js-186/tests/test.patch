+test('create a new rule with annotations', t => {
+  t.plan(1)
+  const client = { options: {} }
+  const annotations = { foo: 'bar', baz: 'qux' }
+  const rules = new Rules(client)
+
+  client.request = (method, path, options) => {
+    t.deepEqual(
+      (options.body.annotations || []).slice().sort((a, b) => a.key.localeCompare(b.key)),
+      [
+        { key: 'baz', value: 'qux' },
+        { key: 'foo', value: 'bar' }
+      ]
+    )
+  }
+
+  return rules.create({ name: '12345', action: '/hello/some_action', trigger: '/hello/some_trigger', annotations })
+})
+
