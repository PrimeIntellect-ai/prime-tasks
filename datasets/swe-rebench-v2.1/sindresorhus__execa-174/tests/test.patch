+
+// eslint-disable-next-line no-use-extend-native/no-use-extend-native
+if (Promise.prototype.finally) {
+	test('finally preserves the fulfilled value and calls back without arguments', async t => {
+		const output = `finally-${process.pid}-${Date.now()}`;
+		const child = m('noop', [output]);
+		let argumentCount;
+		const result = await child.finally((...args) => {
+			argumentCount = args.length;
+			return 'cleanup result';
+		});
+		t.is(argumentCount, 0);
+		t.is(result.stdout, output);
+	});
+
+	test('finally waits for a fulfilled cleanup promise', async t => {
+		const output = `finally-${process.pid}-${Date.now()}`;
+		let resolveCleanup;
+		let startCleanup;
+		const cleanupStarted = new Promise(resolve => {
+			startCleanup = resolve;
+		});
+		const cleanup = new Promise(resolve => {
+			resolveCleanup = resolve;
+		});
+		let settled = false;
+		const result = m('noop', [output]).finally(() => {
+			startCleanup();
+			return cleanup;
+		});
+		result.then(() => {
+			settled = true;
+		}, () => {
+			settled = true;
+		});
+
+		await cleanupStarted;
+		await delay(20);
+		t.false(settled);
+		resolveCleanup();
+		t.is((await result).stdout, output);
+	});
+
+	test('finally function is executed on failure without arguments', async t => {
+		let called = false;
+		let argumentCount;
+		const marker = `finally-${process.pid}-${Date.now()}`;
+		const child = m('exit', ['2', marker]);
+		const err = await t.throws(child.finally((...args) => {
+			called = true;
+			argumentCount = args.length;
+			return 'cleanup result';
+		}));
+		t.is(called, true);
+		t.is(argumentCount, 0);
+		t.is(err.code, 2);
+		t.is(err.cmd, `exit 2 ${marker}`);
+		t.true(err.failed);
+		t.is(typeof err.stdout, 'string');
+		t.is(typeof err.stderr, 'string');
+	});
+
+	test('a fulfilled cleanup promise preserves a child rejection', async t => {
+		const child = m('exit', ['2']);
+		const originalError = await t.throws(child);
+		const err = await t.throws(child.finally(() => Promise.resolve('cleanup result')));
+		t.is(err.code, originalError.code);
+		t.is(err.cmd, originalError.cmd);
+	});
+
+	test('a rejecting promise from finally rejects with the callback error', async t => {
+		const callbackError = new Error('callback failed');
+		const result = m('noop', ['foo']).finally(() => Promise.reject(callbackError));
+		await result.then(
+			() => t.fail('expected the callback rejection'),
+			error => t.is(error, callbackError)
+		);
+	});
+
+	test('a rejecting promise from finally overrides a child rejection', async t => {
+		const callbackError = new Error('callback failed');
+		const result = m('exit', ['2']).finally(() => Promise.reject(callbackError));
+		const error = await t.throws(result);
+		t.is(error, callbackError);
+	});
+
+	test('throw in finally function bubbles up on success', async t => {
+		const callbackError = new Error('called');
+		const result = await t.throws(m('noop', ['foo']).finally(() => {
+			throw callbackError;
+		}));
+		t.is(result, callbackError);
+	});
+
+	test('throw in finally bubbles up on error', async t => {
+		const callbackError = new Error('called');
+		const result = await t.throws(m('exit', ['2']).finally(() => {
+			throw callbackError;
+		}));
+		t.is(result, callbackError);
+	});
+}
