@@ -491,3 +538,19 @@ func jsonResponse(body string, code int) *http.Response {
 		StatusCode: code,
 	}
 }
+
+func publishBodySetsRoleMain(body interface{}) bool {
+	data, err := json.Marshal(body)
+	if err != nil {
+		return false
+	}
+	var decoded map[string]interface{}
+	if err := json.Unmarshal(data, &decoded); err != nil {
+		return false
+	}
+	theme, ok := decoded["theme"].(map[string]interface{})
+	if !ok {
+		return false
+	}
+	return theme["role"] == "main"
+}
