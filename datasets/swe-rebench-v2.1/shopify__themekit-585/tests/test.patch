+package cmd
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestPublish(t *testing.T) {
+	ctx, client, _, stdOut, _ := createTestCtx()
+	ctx.Env.ThemeID = "123456"
+	client.On("PublishTheme").Return(nil)
+	err := publish(ctx)
+	assert.Nil(t, err)
+	assert.Contains(t, stdOut.String(), "Successfully published theme")
+	assert.Contains(t, stdOut.String(), "123456")
+	client.AssertExpectations(t)
+}
+
+func TestPublishError(t *testing.T) {
+	ctx, client, _, _, _ := createTestCtx()
+	publishErr := errors.New("publish failed")
+	client.On("PublishTheme").Return(publishErr)
+	err := publish(ctx)
+	assert.True(t, err == publishErr, "publish should return the client's error unchanged")
+	client.AssertExpectations(t)
+}
+
+func TestPublishCommandIsReachable(t *testing.T) {
+	ThemeCmd.SetArgs([]string{"publish", "--help"})
+	defer ThemeCmd.SetArgs(nil)
+
+	command, err := ThemeCmd.ExecuteC()
+	if assert.NoError(t, err) && assert.NotNil(t, command) {
+		assert.Equal(t, "publish", command.Name())
+	}
+}
