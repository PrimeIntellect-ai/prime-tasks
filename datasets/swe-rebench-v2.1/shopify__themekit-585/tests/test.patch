+func TestThemeClient_PublishTheme(t *testing.T) {
+	testcases := []struct {
+		themeID, resp, resperr, validationMessage string
+		code                                      int
+		wantError                                 bool
+	}{
+		{wantError: true},
+		{themeID: "nope", resp: `{"errors": "Not Found"}`, code: 200, wantError: true},
+		{themeID: "123456", resperr: "(Client.Timeout exceeded while awaiting headers)", wantError: true},
+		{themeID: "123456", resp: `{"theme":{"id": 123456,"name":"timberland","role":"main","previewable":true}}`, code: 200},
+		{themeID: "123456", resp: `{"errors":{"role":["cannot be set to main: missing required file layout/theme.liquid"]}}`, code: 422, validationMessage: "cannot be set to main: missing required file layout/theme.liquid", wantError: true},
+		{themeID: "123456", resp: "{}", code: 404, wantError: true},
+	}
+
+	for i, testcase := range testcases {
+		m := new(mocks.HttpAdapter)
+		client, _ := NewClient(&env.Env{ThemeID: testcase.themeID})
+		client.http = m
+
+		expectation := m.On(
+			"Put",
+			fmt.Sprintf("/admin/themes/%s.json", testcase.themeID),
+			mock.MatchedBy(publishBodySetsRoleMain),
+		)
+		if testcase.resperr != "" {
+			expectation.Return(nil, errors.New(testcase.resperr))
+		} else {
+			expectation.Return(jsonResponse(testcase.resp, testcase.code), nil)
+		}
+
+		err := client.PublishTheme()
+
+		if testcase.wantError {
+			if assert.Error(t, err, fmt.Sprintf("expected err in testcase: %d", i)) && testcase.validationMessage != "" {
+				assert.Contains(t, err.Error(), testcase.validationMessage)
+			}
+		} else {
+			assert.NoError(t, err, fmt.Sprintf("unexpected err in testcase: %d", i))
+		}
+
+		if testcase.resp != "" || testcase.resperr != "" {
+			m.AssertExpectations(t)
+		}
+	}
+}
