     mark_location,
     matrix_multiply,
     read_block_backwards,
@@ -212,3 +213,14 @@ def test_read_previous_line2():
         b"d" * (2 * io.DEFAULT_BUFFER_SIZE),
         6,
     )
+
+
+def test_get_max_pdf_version_header():
+    assert _get_max_pdf_version_header(b"%PDF-1.3", b"%PDF-1.7") == b"%PDF-1.7"
+    assert _get_max_pdf_version_header(b"%PDF-1.7", b"%PDF-1.3") == b"%PDF-1.7"
+    assert _get_max_pdf_version_header(b"%PDF-1.4", b"%PDF-1.4") == b"%PDF-1.4"
+    assert _get_max_pdf_version_header(b"%PDF-1.3", b"not-a-header") == b"%PDF-1.3"
+
+    with pytest.raises(ValueError) as exc:
+        _get_max_pdf_version_header(b"", b"PDF-1.2")
+    assert exc.value.args[0] == "neither b'' nor b'PDF-1.2' are proper headers"
diff --git a/tests/test_writer.py b/tests/test_writer.py
index a412e35..6b9f225 100644
--- a/tests/test_writer.py
+++ b/tests/test_writer.py
@@ -499,3 +499,20 @@ def test_write_bookmark_on_page_fitv():
 
     # cleanup
     os.remove("tmp-merger-do-not-commit.pdf")
+
+
+def test_pdf_header():
+    writer = PdfWriter()
+    assert writer.pdf_header == b"%PDF-1.3"
+
+    reader = PdfReader(os.path.join(RESOURCE_ROOT, "crazyones.pdf"))
+    writer.add_page(reader.pages[0])
+    assert writer.pdf_header == b"%PDF-1.5"
+
+    writer.pdf_header = b"%PDF-1.6"
+    assert writer.pdf_header == b"%PDF-1.6"
+
+    # The header exposed by the property is the one written to the output.
+    output = BytesIO()
+    writer.write(output)
+    assert output.getvalue().startswith(b"%PDF-1.6")
