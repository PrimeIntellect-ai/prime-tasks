 imprecise_warning = "`binning.precise == false`. You may be getting points outside the binning."
 b = RectangularBinning(5)
 @test_logs (:warn, imprecise_warning) ComplexityMeasures.transferoperator(D, b; warn_precise = true)
+
+# ---------------
+# Reproducibility
+# ---------------
+
+# Resetting the RNG gives reproducible direct invariant-measure estimates.
+direct_iv1 = invariantmeasure(D, b; rng = MersenneTwister(1234))
+direct_iv2 = invariantmeasure(D, b; rng = MersenneTwister(1234))
+direct_p1, _ = invariantmeasure(direct_iv1)
+direct_p2, _ = invariantmeasure(direct_iv2)
+@test all(direct_p1 .== direct_p2)
+
+# Resetting rng will lead to identical TransferOperator probability estimates.
+p1 = probabilities(TransferOperator(b; rng = MersenneTwister(1234)), D)
+p2 = probabilities(TransferOperator(b; rng = MersenneTwister(1234)), D)
+@test all(p1 .== p2)
