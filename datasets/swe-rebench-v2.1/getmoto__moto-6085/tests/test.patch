+@mock_iot
+def test_delete_certificate_force():
+    policy_name = "my-policy"
+    client = boto3.client("iot", "us-east-1")
+    client.create_policy(policyName=policy_name, policyDocument="doc")
+
+    cert_arn = client.create_keys_and_certificate(setAsActive=True)["certificateArn"]
+    cert_id = cert_arn.split("/")[-1]
+
+    client.attach_policy(policyName=policy_name, target=cert_arn)
+
+    # Forced deletion does not work if the status is ACTIVE
+    with pytest.raises(ClientError) as e:
+        client.delete_certificate(certificateId=cert_id, forceDelete=True)
+
+    client.update_certificate(certificateId=cert_id, newStatus="INACTIVE")
+    # If does work if the status is INACTIVE, even though we still have policies attached
+    client.delete_certificate(certificateId=cert_id, forceDelete=True)
+
+    res = client.list_certificates()
+    res.should.have.key("certificates").which.should.have.length_of(0)
+
+
+@mock_iot
+def test_force_delete_certificate_attached_to_thing_is_rejected():
+    client = boto3.client("iot", region_name="us-east-1")
+    certificate = client.create_keys_and_certificate(setAsActive=True)
+    certificate_id = certificate["certificateId"]
+    certificate_arn = certificate["certificateArn"]
+    thing_name = "thing-with-certificate"
+
+    client.create_thing(thingName=thing_name)
+    client.attach_thing_principal(thingName=thing_name, principal=certificate_arn)
+    client.update_certificate(certificateId=certificate_id, newStatus="INACTIVE")
+
+    with pytest.raises(ClientError):
+        client.delete_certificate(certificateId=certificate_id, forceDelete=True)
+
+    certificates = client.list_certificates()["certificates"]
+    certificates.should.have.length_of(1)
+    certificates[0]["certificateId"].should.equal(certificate_id)
+
+
