+        query4 = Query.from_(table4).select(table4.faz)
+
+        three_query_union = str(query1 + query2 + query3)
+        self.assertEqual(2, three_query_union.count(' UNION '))
+        self.assertIn('SELECT "foo" FROM "abc"', three_query_union)
