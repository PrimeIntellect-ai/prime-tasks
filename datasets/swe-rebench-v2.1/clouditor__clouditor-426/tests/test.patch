+func TestAssessmentListIncludesCompliance(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if !assert.NoError(t, err) {
+		return
+	}
+	server := grpc.NewServer()
+	assessment.RegisterAssessmentServer(server, assessmentListServer{
+		response: &assessment.ListAssessmentResultsResponse{
+			Results: []*assessment.AssessmentResult{
+				{Compliant: true},
+				{Compliant: false},
+			},
+		},
+	})
+	go server.Serve(listener)
+	defer server.Stop()
+	defer listener.Close()
+
+	folder, err := os.MkdirTemp("", "clouditor-assessment-list")
+	if !assert.NoError(t, err) {
+		return
+	}
+	defer os.RemoveAll(folder)
+	previousFolder := viper.GetString("session-directory")
+	viper.Set("session-directory", folder)
+	defer viper.Set("session-directory", previousFolder)
+	assert.NoError(t, (&cli.Session{URL: listener.Addr().String(), Folder: folder}).Save())
+
+	previousOutput := cli.Output
+	var output bytes.Buffer
+	cli.Output = &output
+	defer func() { cli.Output = previousOutput }()
+
+	cmd := assessmentcmd.NewListResultsCommand()
+	if !assert.NoError(t, cmd.RunE(cmd, nil)) {
+		return
+	}
+
+	var listed struct {
+		Results []struct {
+			Compliant *bool `json:"compliant"`
+		} `json:"results"`
+	}
+	if assert.NoError(t, json.Unmarshal(output.Bytes(), &listed)) && assert.Len(t, listed.Results, 2) {
+		if assert.NotNil(t, listed.Results[0].Compliant) {
+			assert.True(t, *listed.Results[0].Compliant)
+		}
+		if assert.NotNil(t, listed.Results[1].Compliant) {
+			assert.False(t, *listed.Results[1].Compliant)
+		}
+	}
+}
+
+type assessmentListServer struct {
+	assessment.UnimplementedAssessmentServer
+	response *assessment.ListAssessmentResultsResponse
+}
+
+func (s assessmentListServer) ListAssessmentResults(context.Context, *assessment.ListAssessmentResultsRequest) (*assessment.ListAssessmentResultsResponse, error) {
+	return s.response, nil
+}
