+func TestRemoteCollectionCreateWithOptionsSkipInsteadofKeepsURL(t *testing.T) {
+	t.Parallel()
+	repo := createTestRepo(t)
+	defer cleanupTestRepo(t, repo)
+
+	config, err := repo.Config()
+	checkFatal(t, err)
+	err = config.SetString("url.git@github.com:.insteadof", "https://github.com/")
+	checkFatal(t, err)
+	const url = "https://github.com/libgit2/TestGitRepository"
+	const fetchSpec = "+refs/heads/main:refs/remotes/origin/custom-main"
+	option := &RemoteCreateOptions{
+		Name:      "origin",
+		FetchSpec: fetchSpec,
+		Flags:     RemoteCreateSkipInsteadof,
+	}
+	remote, err := repo.Remotes.CreateWithOptions(url, option)
+	checkFatal(t, err)
+	defer remote.Free()
+
+	if got := remote.Name(); got != "origin" {
+		t.Errorf("remote name = %q, want %q", got, "origin")
+	}
+	if got := remote.Url(); got != url {
+		t.Errorf("remote URL = %q, want unchanged URL %q", got, url)
+	}
+	fetchSpecs, err := remote.FetchRefspecs()
+	checkFatal(t, err)
+	foundFetchSpec := false
+	for _, got := range fetchSpecs {
+		if got == fetchSpec {
+			foundFetchSpec = true
+		}
+	}
+	if !foundFetchSpec {
+		t.Errorf("remote fetch refspecs = %q, want to include %q", fetchSpecs, fetchSpec)
+	}
+}
