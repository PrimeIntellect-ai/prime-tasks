+#[test]
+fn undefined_name_for_nested_view() {
+    let mut builder = LibraryBuilder::with_standard(VHDL2019);
+    let code = builder.code(
+        "libname",
+        "\
+package test is
+    type my_rec_t is record
+        a : bit;
+        b : bit;
+     end record;
+     view invalid_view of my_rec_t is
+         a : view undefined_view;
+         b : view undefined_view;
+     end view;
+end package;
+    ",
+    );
+    check_diagnostics(
+        builder.analyze(),
+        vec![
+            Diagnostic::new(
+                code.s("undefined_view", 1),
+                "No declaration of 'undefined_view'",
+                ErrorCode::Unresolved,
+            ),
+            Diagnostic::new(
+                code.s("undefined_view", 2),
+                "No declaration of 'undefined_view'",
+                ErrorCode::Unresolved,
+            ),
+        ],
+    )
+}
