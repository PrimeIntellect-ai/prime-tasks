+package xmpp
+
+import (
+	"bytes"
+	"encoding/xml"
+	"net"
+	"testing"
+
+	"gosrc.io/xmpp/stanza"
+)
+
+func TestClientSendRawAndMessageKeepLiteralPercentAndUnicode(t *testing.T) {
+	tests := []struct {
+		name string
+		data string
+	}{
+		{
+			name: "percent-encoded URL",
+			data: "https://da.wikipedia.org/wiki/J%C3%A6vnd%C3%B8gn",
+		},
+		{
+			name: "non-ASCII characters",
+			data: "Septemberjævndøgn ⌘ 🔭",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			for _, send := range []struct {
+				name string
+				call func(*Client) error
+			}{
+				{
+					name: "raw",
+					call: func(client *Client) error { return client.SendRaw(tt.data) },
+				},
+				{
+					name: "message",
+					call: func(client *Client) error {
+						return client.Send(stanza.Message{Body: tt.data})
+					},
+				},
+			} {
+				t.Run(send.name, func(t *testing.T) {
+					buffer := &bytes.Buffer{}
+					conn, peer := net.Pipe()
+					defer conn.Close()
+					defer peer.Close()
+
+					client := Client{
+						conn:    conn,
+						Session: &Session{streamLogger: buffer},
+					}
+					if err := send.call(&client); err != nil {
+						t.Fatalf("sending content returned an error: %v", err)
+					}
+
+					if send.name == "raw" {
+						if got := buffer.String(); got != tt.data {
+							t.Errorf("SendRaw wrote %q; want the original content %q", got, tt.data)
+						}
+						return
+					}
+
+					var message stanza.Message
+					if err := xml.Unmarshal(buffer.Bytes(), &message); err != nil {
+						t.Fatalf("sent message is not valid XML: %v", err)
+					}
+					if message.Body != tt.data {
+						t.Errorf("sent message body is %q; want the original content %q", message.Body, tt.data)
+					}
+				})
+			}
+		})
+	}
+}
