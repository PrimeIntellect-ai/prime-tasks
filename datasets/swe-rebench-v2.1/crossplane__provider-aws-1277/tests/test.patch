+func TestReplicationGroupMultiAZEnabledJSON(t *testing.T) {
+	var params v1beta1.ReplicationGroupParameters
+	if err := json.Unmarshal([]byte(`{"multiAZEnabled":true}`), &params); err != nil {
+		t.Fatalf("unmarshal Multi-AZ setting: %v", err)
+	}
+	data, err := json.Marshal(params)
+	if err != nil {
+		t.Fatalf("marshal replication group parameters: %v", err)
+	}
+	var got map[string]json.RawMessage
+	if err := json.Unmarshal(data, &got); err != nil {
+		t.Fatalf("unmarshal serialized parameters: %v", err)
+	}
+	var enabled bool
+	if err := json.Unmarshal(got["multiAZEnabled"], &enabled); err != nil {
+		t.Fatalf("read serialized Multi-AZ setting: %v", err)
+	}
+	if !enabled {
+		t.Errorf("serialized multiAZEnabled = %v, want true", enabled)
+	}
+}
