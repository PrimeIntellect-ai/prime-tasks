+
+#[test]
+fn table_without_blank_line_in_list_item_is_recognized() {
+    let original = r##"* A table:
+  | inside | a |
+  | ------ | - |
+  | list   | item |
+"##;
+    let options = Options::ENABLE_TABLES;
+
+    let mut in_item = false;
+    let mut table_in_item = false;
+    for event in Parser::new_ext(original, options) {
+        match event {
+            Event::Start(Tag::Item) => in_item = true,
+            Event::Start(Tag::Table(_)) if in_item => table_in_item = true,
+            _ => {}
+        }
+    }
+    assert!(table_in_item, "expected a table block within the list item");
+}
