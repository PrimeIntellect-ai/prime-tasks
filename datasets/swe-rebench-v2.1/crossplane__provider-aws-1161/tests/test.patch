+// setQueueArn sets the queueArn field of a QueueConfiguration to arn. It uses
+// reflection so that the test does not depend on whether the field is a string
+// or a *string.
+func setQueueArn(qc *v1beta1.QueueConfiguration, arn string) {
+	f := reflect.ValueOf(qc).Elem().FieldByName("QueueArn")
+	if f.Kind() == reflect.Ptr {
+		f.Set(reflect.ValueOf(&arn))
+		return
+	}
+	f.Set(reflect.ValueOf(arn))
+}
+
+// getQueueArn returns the queueArn field of a QueueConfiguration as a string,
+// regardless of whether the field is a string or a *string.
+func getQueueArn(qc v1beta1.QueueConfiguration) string {
+	f := reflect.ValueOf(qc).FieldByName("QueueArn")
+	if f.Kind() == reflect.Ptr {
+		if f.IsNil() {
+			return ""
+		}
+		return f.Elem().String()
+	}
+	return f.String()
+}
+
+// generateQueueConfiguration returns a QueueConfiguration with the queueArn
+// field set, regardless of whether that field is a string or a *string.
+func generateQueueConfiguration(id *string) v1beta1.QueueConfiguration {
+	qc := v1beta1.QueueConfiguration{
+		Events: generateNotificationEvents(),
+		Filter: generateNotificationFilter(),
+		ID:     id,
+	}
+	setQueueArn(&qc, queueArn)
+	return qc
+}
+
 func generateNotificationEvents() []string {
