+func TestResolveReferencesQueueArn(t *testing.T) {
+	queueARN := "arn:aws:sqs:us-east-1:123456789012:test-queue"
+	externalName := "test-queue"
+
+	b := &v1beta1.Bucket{
+		Spec: v1beta1.BucketSpec{
+			ForProvider: v1beta1.BucketParameters{
+				NotificationConfiguration: &v1beta1.NotificationConfiguration{
+					QueueConfigurations: []v1beta1.QueueConfiguration{{
+						QueueArnRef: &xpv1.Reference{Name: "test-queue"},
+					}},
+				},
+			},
+		},
+	}
+
+	c := &test.MockClient{
+		MockGet: func(_ context.Context, _ client.ObjectKey, obj client.Object) error {
+			q, ok := obj.(*sqsv1beta1.Queue)
+			if !ok {
+				return nil
+			}
+			q.Status.AtProvider.ARN = queueARN
+			meta.SetExternalName(q, externalName)
+			return nil
+		},
+	}
+
+	if err := b.ResolveReferences(context.Background(), c); err != nil {
+		t.Fatalf("ResolveReferences() unexpected error: %v", err)
+	}
+
+	got := getQueueArn(b.Spec.ForProvider.NotificationConfiguration.QueueConfigurations[0])
+	if got != queueARN {
+		t.Errorf("ResolveReferences() resolved queueArn = %q, want %q (the referenced Queue's ARN, not its external name %q)", got, queueARN, externalName)
+	}
+}
