+#[test]
+fn unnamed_snippet_shows_message() {
+    #[derive(Debug, Diagnostic, Error)]
+    #[error("oops!")]
+    #[diagnostic(code(oops::my::bad), help("try doing it better next time?"))]
+    struct MyBad {
+        src: String,
+        #[snippet(src, message("This is the part that broke"))]
+        ctx: SourceSpan,
+    }
+    let src = "source_text_here".to_string();
+    let len = src.len();
+    let err = MyBad {
+        src,
+        ctx: (0, len).into(),
+    };
+    let out = fmt_report(err.into());
+    println!("{}", out);
+    assert!(out.lines().any(|line| {
+        line.contains("This is the part that broke")
+            && (line.contains("line 1, column 1") || line.contains("1:1"))
+    }));
+}
+
+#[test]
+fn unnamed_arc_snippet_header_includes_position_and_message() {
+    #[derive(Debug, Diagnostic, Error)]
+    #[error("oops!")]
+    #[diagnostic(code(oops::arc::source))]
+    struct ArcSourceError {
+        src: Arc<String>,
+        #[snippet(src, message("Arc snippet context"))]
+        ctx: SourceSpan,
+    }
+
+    let src = Arc::new("source_text_here".to_string());
+    let len = src.len();
+    let out = fmt_report(
+        ArcSourceError {
+            src,
+            ctx: (0, len).into(),
+        }
+        .into(),
+    );
+
+    assert!(
+        out.lines().any(|line| {
+            line.contains("Arc snippet context")
+                && (line.contains("line 1, column 1") || line.contains("1:1"))
+        }),
+        "expected an unnamed Arc source header with its position and message:\n{}",
+        out
+    );
+}
+
+#[test]
+fn named_snippet_header_includes_name_position_and_message() {
+    #[derive(Debug, Diagnostic, Error)]
+    #[error("oops!")]
+    #[diagnostic(code(oops::named::source))]
+    struct NamedSourceError {
+        src: NamedSource,
+        #[snippet(src, message("Named snippet context"))]
+        ctx: SourceSpan,
+    }
+
+    let src = "source_text_here".to_string();
+    let len = src.len();
+    let out = fmt_report(
+        NamedSourceError {
+            src: NamedSource::new("example.txt", src),
+            ctx: (0, len).into(),
+        }
+        .into(),
+    );
+
+    assert!(out.lines().any(|line| {
+        line.contains("example.txt")
+            && line.contains("line 1, column 1")
+            && line.contains("Named snippet context")
+    }),
+        "expected a named source header with its position and message:\n{}",
+        out
+    );
+}
