+
+func TestConfiguredJWTAccessTokenIsJWT(t *testing.T) {
+	oidcConfig := &schema.IdentityProvidersOpenIDConnect{
+		HMACSecret: "a-long-enough-secret-for-this-test-configuration",
+		JSONWebKeys: []schema.JWK{{
+			Use:       oidc.KeyUseSignature,
+			Algorithm: oidc.SigningAlgRSAUsingSHA256,
+			Key:       keyRSA2048,
+		}},
+		Clients: []schema.IdentityProvidersOpenIDConnectClient{{
+			ID:                           "jwt-access-token-client",
+			Secret:                       tOpenIDConnectPlainTextClientSecret,
+			AuthorizationPolicy:          "two_factor",
+			RedirectURIs:                 []string{"https://client.example/callback"},
+			AccessTokenSignedResponseAlg: oidc.SigningAlgRSAUsingSHA256,
+		}},
+	}
+
+	configuration := &schema.Configuration{
+		IdentityProviders: schema.IdentityProviders{OIDC: oidcConfig},
+	}
+	validator := schema.NewStructValidator()
+	ValidateIdentityProviders(NewValidateCtx(), configuration, validator)
+	require.Empty(t, validator.Errors())
+
+	providerConfig := oidc.NewConfig(oidcConfig, oidc.NewIssuer(oidcConfig.JSONWebKeys), nil)
+	request := oauth2.NewRequest()
+	request.Client = oidc.NewClient(oidcConfig.Clients[0], oidcConfig, nil)
+	request.Session = oidc.NewSession()
+	token, _, err := providerConfig.Strategy.Core.GenerateAccessToken(context.Background(), request)
+	require.NoError(t, err)
+
+	assert.Len(t, strings.Split(token, "."), 3, "a signed JWT access token has three compact serialization segments")
+}
