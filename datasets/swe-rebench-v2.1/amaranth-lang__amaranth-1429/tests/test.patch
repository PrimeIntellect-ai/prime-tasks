+    def test_enum(self):
+        from amaranth.lib import data
+
+        class QSPIMode(AmaranthEnum):
+            PutX1 = 3
+
+        layout_const = data.StructLayout({"mode": QSPIMode}).const(
+            {"mode": QSPIMode.PutX1})
+        self.assertEqual(layout_const.as_value().value, QSPIMode.PutX1.value)
+
+        e1 = Const(UnsignedEnum.FOO)
+        self.assertIsInstance(e1, Const)
+        self.assertEqual(e1.shape(), unsigned(2))
+        self.assertEqual(e1.value, UnsignedEnum.FOO.value)
+        e2 = Const(SignedEnum.FOO)
+        self.assertIsInstance(e2, Const)
+        self.assertEqual(e2.shape(), signed(2))
+        self.assertEqual(e2.value, SignedEnum.FOO.value)
+        e3 = Const(TypedEnum.FOO)
+        self.assertIsInstance(e3, Const)
+        self.assertEqual(e3.shape(), unsigned(2))
+        self.assertEqual(e3.value, TypedEnum.FOO.value)
+        e4 = Const(UnsignedEnum.FOO, 4)
+        self.assertIsInstance(e4, Const)
+        self.assertEqual(e4.shape(), unsigned(4))
+        self.assertEqual(e4.value, UnsignedEnum.FOO.value)
+
