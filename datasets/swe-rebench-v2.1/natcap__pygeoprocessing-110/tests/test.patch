+    def test_convolve_2d_patchy_signal_with_nodata(self):
+        """Nodata around a valid patch must not corrupt convolution output."""
+        signal_nodata = -1.0
+        signal_array = numpy.full((5, 5), signal_nodata, dtype=numpy.float32)
+        signal_array[1:3, 1:3] = [[1, 2], [3, 4]]
+        signal_path = os.path.join(self.workspace_dir, 'patchy_signal.tif')
+        _array_to_raster(signal_array, signal_nodata, signal_path)
+
+        kernel_path = os.path.join(self.workspace_dir, 'patch_kernel.tif')
+        _array_to_raster(
+            numpy.ones((3, 3), dtype=numpy.float32), None, kernel_path)
+        target_path = os.path.join(self.workspace_dir, 'patch_convolution.tif')
+
+        # A successful result for this option combination must behave like
+        # convolution after replacing signal nodata with zero.  Rejecting the
+        # call is also safe, because it cannot emit a corrupt raster.
+        try:
+            pygeoprocessing.convolve_2d(
+                (signal_path, 1), (kernel_path, 1), target_path,
+                mask_nodata=False, ignore_nodata_and_edges=True, n_threads=1)
+        except Exception:
+            pass
+        else:
+            zero_filled = signal_array.copy()
+            zero_filled[zero_filled == signal_nodata] = 0
+            zero_filled_path = os.path.join(
+                self.workspace_dir, 'patchy_signal_zero_filled.tif')
+            _array_to_raster(zero_filled, -9, zero_filled_path)
+            reference_path = os.path.join(
+                self.workspace_dir, 'zero_filled_convolution.tif')
+            pygeoprocessing.convolve_2d(
+                (zero_filled_path, 1), (kernel_path, 1), reference_path,
+                mask_nodata=False, ignore_nodata_and_edges=True, n_threads=1)
+            result = pygeoprocessing.raster_to_numpy_array(target_path)
+            reference = pygeoprocessing.raster_to_numpy_array(reference_path)
+            numpy.testing.assert_allclose(result, reference, atol=1e-6)
+
+        # With signal masking enabled, output nodata follows the signal mask.
+        pygeoprocessing.convolve_2d(
+            (signal_path, 1), (kernel_path, 1), target_path,
+            mask_nodata=True, ignore_nodata_and_edges=False, n_threads=1)
+        result = pygeoprocessing.raster_to_numpy_array(target_path)
+        output_nodata = pygeoprocessing.get_raster_info(
+            target_path)['nodata'][0]
+        valid_signal = signal_array != signal_nodata
+        self.assertTrue(numpy.all(result[~valid_signal] == output_nodata))
+        numpy.testing.assert_allclose(
+            result[valid_signal], numpy.full(4, 10.0, dtype=numpy.float32),
+            atol=1e-6)
+
