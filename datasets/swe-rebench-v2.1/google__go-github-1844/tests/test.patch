+func TestPullRequestTargetEvent_DecodeJSON(t *testing.T) {
+	payload := []byte(`{
+"action":"synchronize",
+"before":"old-commit",
+"after":"new-commit",
+"assignee":{"login":"assigned-user"},
+"changes":{"title":{"from":"old title"}},
+"installation":{"id":71},
+"label":{"name":"bug"},
+"number":12,
+"organization":{"login":"event-org"},
+"pull_request":{"number":34,"title":"event pull request"},
+"repository":{"name":"event-repo"},
+"requested_reviewer":{"login":"reviewer-user"},
+"requested_team":{"slug":"review-team"},
+"sender":{"login":"sender-user"}
+}`)
+
+	parsed, err := ParseWebHook("pull_request_target", payload)
+	if err != nil {
+		t.Fatalf("ParseWebHook(pull_request_target) returned error: %v", err)
+	}
+	parsedType := reflect.TypeOf(parsed)
+	if parsedType.Kind() != reflect.Ptr || parsedType.Elem().Name() != "PullRequestTargetEvent" {
+		t.Fatalf("ParseWebHook returned %T, want a PullRequestTargetEvent payload", parsed)
+	}
+
+	// Decode the same JSON directly into the public payload type returned by the parser.
+	decoded := reflect.New(parsedType.Elem())
+	if err := json.Unmarshal(payload, decoded.Interface()); err != nil {
+		t.Fatalf("json.Unmarshal returned error: %v", err)
+	}
+	event := decoded.Elem()
+	assertField := func(want interface{}, path ...string) {
+		t.Helper()
+		value := event
+		for _, name := range path {
+			for value.Kind() == reflect.Ptr {
+				if value.IsNil() {
+					t.Errorf("field %v is nil", path)
+					return
+				}
+				value = value.Elem()
+			}
+			if value.Kind() != reflect.Struct {
+				t.Errorf("field %v cannot be read from %s", path, value.Kind())
+				return
+			}
+			value = value.FieldByName(name)
+			if !value.IsValid() {
+				t.Errorf("field %v is missing", path)
+				return
+			}
+		}
+		for value.Kind() == reflect.Ptr {
+			if value.IsNil() {
+				t.Errorf("field %v is nil", path)
+				return
+			}
+			value = value.Elem()
+		}
+		if !reflect.DeepEqual(value.Interface(), want) {
+			t.Errorf("field %v = %v, want %v", path, value.Interface(), want)
+		}
+	}
+
+	assertField("synchronize", "Action")
+	assertField("old-commit", "Before")
+	assertField("new-commit", "After")
+	assertField("assigned-user", "Assignee", "Login")
+	assertField("old title", "Changes", "Title", "From")
+	assertField(int64(71), "Installation", "ID")
+	assertField("bug", "Label", "Name")
+	assertField(12, "Number")
+	assertField("event-org", "Organization", "Login")
+	assertField(34, "PullRequest", "Number")
+	assertField("event pull request", "PullRequest", "Title")
+	assertField("event-repo", "Repo", "Name")
+	assertField("reviewer-user", "RequestedReviewer", "Login")
+	assertField("review-team", "RequestedTeam", "Slug")
+	assertField("sender-user", "Sender", "Login")
+	assertGetter := func(methodName, fieldName string) {
+		t.Helper()
+		method := reflect.ValueOf(parsed).MethodByName(methodName)
+		if !method.IsValid() {
+			t.Errorf("payload does not expose %s", methodName)
+			return
+		}
+		results := method.Call(nil)
+		if len(results) != 1 {
+			t.Errorf("%s returned %d values, want one", methodName, len(results))
+			return
+		}
+		want := event.FieldByName(fieldName)
+		got := results[0]
+		if want.Kind() == reflect.Ptr && got.Kind() != reflect.Ptr {
+			if want.IsNil() {
+				t.Errorf("field %s is nil", fieldName)
+				return
+			}
+			want = want.Elem()
+		}
+		if !reflect.DeepEqual(got.Interface(), want.Interface()) {
+			t.Errorf("%s() = %v, want the decoded %s value %v", methodName, got.Interface(), fieldName, want.Interface())
+		}
+	}
+	assertGetter("GetAction", "Action")
+	assertGetter("GetAfter", "After")
+	assertGetter("GetAssignee", "Assignee")
+	assertGetter("GetBefore", "Before")
+	assertGetter("GetChanges", "Changes")
+	assertGetter("GetInstallation", "Installation")
+	assertGetter("GetLabel", "Label")
+	assertGetter("GetNumber", "Number")
+	assertGetter("GetOrganization", "Organization")
+	assertGetter("GetPullRequest", "PullRequest")
+	assertGetter("GetRepo", "Repo")
+	assertGetter("GetRequestedReviewer", "RequestedReviewer")
+	assertGetter("GetRequestedTeam", "RequestedTeam")
+	assertGetter("GetSender", "Sender")
+}
