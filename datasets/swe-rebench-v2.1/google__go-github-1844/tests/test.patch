+func TestPullRequestTargetEvent_AccessorsReturnZeroValuesWhenAbsent(tt *testing.T) {
+	payload, err := ParseWebHook("pull_request_target", []byte(`{}`))
+	if err != nil {
+		tt.Fatalf("ParseWebHook(pull_request_target) returned error: %v", err)
+	}
+	payloadType := reflect.TypeOf(payload)
+	if payloadType.Kind() != reflect.Ptr || payloadType.Elem().Name() != "PullRequestTargetEvent" {
+		tt.Fatalf("ParseWebHook returned %T, want a PullRequestTargetEvent payload", payload)
+	}
+
+	methods := []struct {
+		name string
+		kind reflect.Kind
+	}{
+		{"GetAction", reflect.String}, {"GetAfter", reflect.String}, {"GetAssignee", reflect.Ptr},
+		{"GetBefore", reflect.String}, {"GetChanges", reflect.Ptr}, {"GetInstallation", reflect.Ptr},
+		{"GetLabel", reflect.Ptr}, {"GetNumber", reflect.Int}, {"GetOrganization", reflect.Ptr},
+		{"GetPullRequest", reflect.Ptr}, {"GetRepo", reflect.Ptr}, {"GetRequestedReviewer", reflect.Ptr},
+		{"GetRequestedTeam", reflect.Ptr}, {"GetSender", reflect.Ptr},
+	}
+	receivers := []reflect.Value{reflect.Zero(payloadType), reflect.New(payloadType.Elem())}
+	for _, receiver := range receivers {
+		for _, test := range methods {
+			method := receiver.MethodByName(test.name)
+			if !method.IsValid() {
+				tt.Errorf("payload does not expose %s", test.name)
+				continue
+			}
+			results := method.Call(nil)
+			if len(results) != 1 {
+				tt.Errorf("%s returned %d values, want one", test.name, len(results))
+				continue
+			}
+			result := results[0]
+			if result.Kind() != test.kind {
+				tt.Errorf("%s returns %s, want %s", test.name, result.Kind(), test.kind)
+				continue
+			}
+			if (result.Kind() == reflect.Ptr && !result.IsNil()) ||
+				(result.Kind() == reflect.String && result.String() != "") ||
+				(result.Kind() == reflect.Int && result.Int() != 0) {
+				tt.Errorf("%s on an event without data returned %v, want its zero value", test.name, result.Interface())
+			}
+		}
+	}
+}
