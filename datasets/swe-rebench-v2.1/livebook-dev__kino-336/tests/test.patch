+          max: ~U[2023-01-01 17:32:12Z]
+        )
+      end
+    end
+
+    test "accepts valid bounds and a default within them" do
+      assert %Kino.Input{} =
+               Kino.Input.utc_datetime("Input",
+                 min: ~U[2023-01-01 00:00:00Z],
+                 max: ~U[2023-03-01 00:00:00Z],
+                 default: ~U[2023-02-01 00:00:00Z]
+               )
+    end
+  end
