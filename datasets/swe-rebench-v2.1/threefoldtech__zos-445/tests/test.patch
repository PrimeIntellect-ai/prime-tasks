+func TestRegisterNodeUsesDirectoryNodesNamespace(t *testing.T) {
+	pool, conn := getTestPool()
+	gedis := Gedis{pool: pool}
+
+	conn.On("Do", mock.MatchedBy(func(command string) bool {
+		return strings.HasPrefix(command, "tfgrid.directory.nodes.")
+	}), mock.Anything).
+		Return(mustMarshal(t, Args{"node_id": "node-1"}), nil)
+
+	id, err := gedis.RegisterNode(pkg.StrIdentifier("node-1"), pkg.FarmID(1), "v1", geoip.Location{})
+
+	require.NoError(t, err)
+	require.Equal(t, "node-1", id)
+}
+
+func TestRegisterFarmUsesDirectoryFarmsNamespace(t *testing.T) {
+	pool, conn := getTestPool()
+	gedis := Gedis{pool: pool}
+
+	conn.On("Do", mock.MatchedBy(func(command string) bool {
+		return strings.HasPrefix(command, "tfgrid.directory.farms.")
+	}), mock.Anything).
+		Return(mustMarshal(t, Args{"farm_id": 123}), nil)
+
+	id, err := gedis.RegisterFarm(10, "farm", "farm@example.com", nil)
+
+	require.NoError(t, err)
+	require.Equal(t, pkg.FarmID(123), id)
+}
