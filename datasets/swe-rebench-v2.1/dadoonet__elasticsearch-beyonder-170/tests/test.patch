+    @Test
+    public void testBeyonderLoadsPipelines() throws Exception {
+        HttpServer server = HttpServer.create(new InetSocketAddress("localhost", 0), 0);
+        // Requests as "METHOD path" in the order they were received, and the body of each PUT by path
+        List<String> requests = new CopyOnWriteArrayList<>();
+        Map<String, String> putBodies = new ConcurrentHashMap<>();
+        server.createContext("/", exchange -> {
+            String requestMethod = exchange.getRequestMethod();
+            String requestPath = exchange.getRequestURI().getPath();
+            requests.add(requestMethod + " " + requestPath);
+            ByteArrayOutputStream requestBody = new ByteArrayOutputStream();
+            byte[] buffer = new byte[1024];
+            int length;
+            while ((length = exchange.getRequestBody().read(buffer)) != -1) {
+                requestBody.write(buffer, 0, length);
+            }
+            if ("PUT".equals(requestMethod)) {
+                putBodies.put(requestPath, new String(requestBody.toByteArray(), StandardCharsets.UTF_8));
+            }
+            // The pipeline does not exist yet: a lookup answers 404, anything else is acknowledged
+            int status = "GET".equals(requestMethod) ? 404 : 200;
+            byte[] response = (status == 404 ? "{\"error\":\"not found\"}" : "{\"acknowledged\":true}")
+                    .getBytes(StandardCharsets.UTF_8);
+            exchange.sendResponseHeaders(status, response.length);
+            try (OutputStream output = exchange.getResponseBody()) {
+                output.write(response);
+            }
+        });
+        server.start();
+
+        try (RestClient client = RestClient.builder(
+                new HttpHost("localhost", server.getAddress().getPort(), "http")).build()) {
+            ElasticsearchBeyonder.start(client, "models/pipelines");
+            String pipelinePath = "/_ingest/pipeline/twitter_pipeline";
+            assertThat(putBodies.keySet(), hasItem(pipelinePath));
+            assertThat(putBodies.get(pipelinePath), containsString("Twitter pipeline"));
+            assertThat(requests, hasItem("PUT " + pipelinePath));
+        } finally {
+            server.stop(0);
+        }
+    }
+
+    @Test
+    public void testPipelines() throws Exception {
+        // 1 template
+        testBeyonder("models/pipelines",
+                null,
+                null,
+                null,
+                null,
+                singletonList("twitter_pipeline"));
     }
 }
