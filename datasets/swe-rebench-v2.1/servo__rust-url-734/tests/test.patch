diff --git a/url/tests/unit.rs b/url/tests/unit.rs
index 401eaf9..673aa7f 100644
--- a/url/tests/unit.rs
+++ b/url/tests/unit.rs
@@ -43,6 +43,26 @@ fn test_set_empty_host() {
     assert_eq!(base.as_str(), "moz:/baz");
     base.set_host(Some("servo")).unwrap();
     assert_eq!(base.as_str(), "moz://servo/baz");
+
+    // The set_host(None) documentation example must continue to serialize without a host.
+    let mut base: Url = "foo://example.net".parse().unwrap();
+    base.set_host(None).unwrap();
+    assert_eq!(base.as_str(), "foo:/");
+    assert_eq!(base.as_str().parse::<Url>().unwrap().host(), None);
+
+    let mut base: Url = "file://server/share/foo/bar".parse().unwrap();
+    base.set_host(None).unwrap();
+    assert_eq!(base.as_str(), "file:///share/foo/bar");
+
+    let mut base: Url = "file://server/share/foo/bar".parse().unwrap();
+    base.set_host(Some("foo")).unwrap();
+    assert_eq!(base.as_str(), "file://foo/share/foo/bar");
+
+    // The reported file URL must also permit host removal.
+    let mut base: Url = "file://a/b/c".parse().unwrap();
+    base.set_host(None).unwrap();
+    assert_eq!(base.as_str(), "file:///b/c");
+    assert_eq!(base.as_str().parse::<Url>().unwrap().host(), None);
 }
 
 #[test]
