+
+func Test_AddCommand_AddToExistingWithComplexStdStreamAssertions(t *testing.T) {
+	existing := []byte(`
+tests:
+  exists:
+    command: echo exists
+    stdout:
+      contains:
+        - exists
+      not-contains:
+        - byebye
+    stderr:
+      not-contains:
+        - stderr not
+      line-count: 10
+      lines:
+        1: line1
+        2: line2
+    exit-code: 0
+`)
+
+	content, err := AddCommand("echo hello", existing)
+
+	if !assert.NoError(t, err) {
+		return
+	}
+
+	serialized := string(content)
+	addedPosition := strings.Index(serialized, "echo hello:")
+	existingPosition := strings.Index(serialized, "exists:")
+	assert.True(t, addedPosition >= 0)
+	assert.True(t, existingPosition >= 0)
+	assert.True(t, addedPosition < existingPosition)
+
+	parsed := suite.ParseYAML(content)
+	added, err := parsed.GetTestByTitle("echo hello")
+	if assert.NoError(t, err) {
+		assert.Equal(t, "echo hello", added.Command.Cmd)
+		assert.Equal(t, 0, added.Expected.ExitCode)
+		assert.Equal(t, []string{"hello"}, added.Expected.Stdout.Contains)
+	}
+
+	existingTest, err := parsed.GetTestByTitle("exists")
+	if assert.NoError(t, err) {
+		assert.Equal(t, "echo exists", existingTest.Command.Cmd)
+		assert.Equal(t, 0, existingTest.Expected.ExitCode)
+		assert.Equal(t, []string{"exists"}, existingTest.Expected.Stdout.Contains)
+		assert.Equal(t, []string{"byebye"}, existingTest.Expected.Stdout.NotContains)
+		assert.Equal(t, map[int]string{1: "line1", 2: "line2"}, existingTest.Expected.Stderr.Lines)
+		assert.Equal(t, 10, existingTest.Expected.Stderr.LineCount)
+		assert.Equal(t, []string{"stderr not"}, existingTest.Expected.Stderr.NotContains)
+	}
+}
