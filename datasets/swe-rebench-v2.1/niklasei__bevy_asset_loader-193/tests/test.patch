diff --git a/bevy_asset_loader/tests/same_collection_multiple_times.rs b/bevy_asset_loader/tests/same_collection_multiple_times.rs
new file mode 100644
index 0000000..efa830e
--- /dev/null
+++ b/bevy_asset_loader/tests/same_collection_multiple_times.rs
@@ -0,0 +1,166 @@
+use bevy::app::AppExit;
+use bevy::audio::AudioPlugin;
+use bevy::log::tracing_subscriber;
+use bevy::log::tracing_subscriber::layer::{Context, SubscriberExt};
+use bevy::log::tracing_subscriber::Layer;
+use bevy::prelude::*;
+use bevy::utils::tracing::field::{Field, Visit};
+use bevy::utils::tracing::{Event, Level, Subscriber};
+use bevy_asset_loader::prelude::*;
+use std::sync::{Arc, Mutex};
+
+#[derive(Clone, Default)]
+struct LogCapture {
+    events: Arc<Mutex<Vec<(Level, String)>>>,
+}
+
+impl LogCapture {
+    fn clear(&self) {
+        self.events.lock().unwrap().clear();
+    }
+
+    fn warnings(&self) -> Vec<String> {
+        self.events
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(level, _)| *level == Level::WARN)
+            .map(|(_, message)| message.clone())
+            .collect()
+    }
+}
+
+struct MessageVisitor(String);
+
+impl Visit for MessageVisitor {
+    fn record_debug(&mut self, field: &Field, value: &dyn std::fmt::Debug) {
+        if field.name() == "message" {
+            self.0 = format!("{:?}", value);
+        }
+    }
+}
+
+impl<S: Subscriber> Layer<S> for LogCapture {
+    fn on_event(&self, event: &Event<'_>, _context: Context<'_, S>) {
+        let mut visitor = MessageVisitor(String::new());
+        event.record(&mut visitor);
+        self.events
+            .lock()
+            .unwrap()
+            .push((*event.metadata().level(), visitor.0));
+    }
+}
+
+#[derive(Clone, Copy)]
+enum Duplicate {
+    None,
+    ViaLoadingState,
+    ViaConfig,
+}
+
+fn run_app(duplicate: Duplicate) {
+    let mut app = App::new();
+    app.init_state::<MyStates>();
+
+    #[cfg(feature = "progress_tracking")]
+    app.add_plugins(iyes_progress::ProgressPlugin::new(MyStates::Load));
+    app.add_plugins((
+        MinimalPlugins,
+        AssetPlugin::default(),
+        AudioPlugin::default(),
+    ));
+
+    let mut loading_state = LoadingState::new(MyStates::Load)
+        .continue_to_state(MyStates::Play)
+        .load_collection::<MyAssets>();
+    if let Duplicate::ViaLoadingState = duplicate {
+        loading_state = loading_state.load_collection::<MyAssets>();
+    }
+    app.add_loading_state(loading_state);
+
+    if let Duplicate::ViaConfig = duplicate {
+        app.configure_loading_state(
+            LoadingStateConfig::new(MyStates::Load).load_collection::<MyAssets>(),
+        );
+    }
+
+    app.add_systems(Update, (quit.run_if(in_state(MyStates::Play)), timeout))
+        .add_systems(OnEnter(MyStates::Play), use_loading_assets)
+        .run();
+}
+
+#[test]
+fn same_collection_multiple_times() {
+    let capture = LogCapture::default();
+    let subscriber = tracing_subscriber::registry().with(capture.clone());
+    bevy::utils::tracing::subscriber::set_global_default(subscriber)
+        .expect("Failed to set the global tracing subscriber");
+
+    capture.clear();
+    run_app(Duplicate::None);
+    let baseline = capture.warnings();
+
+    capture.clear();
+    run_app(Duplicate::ViaLoadingState);
+    let via_loading_state = capture.warnings();
+
+    capture.clear();
+    run_app(Duplicate::ViaConfig);
+    let via_config = capture.warnings();
+
+    assert_extra_warning(
+        &baseline,
+        &via_loading_state,
+        "Registering the same collection twice through LoadingState::load_collection",
+    );
+    assert_extra_warning(
+        &baseline,
+        &via_config,
+        "Registering the same collection through LoadingStateConfig::load_collection",
+    );
+}
+
+/// Asserts that the run with a duplicated collection produced at least one warning
+/// that the baseline run (without duplicates) did not.
+fn assert_extra_warning(baseline: &[String], with_duplicate: &[String], context: &str) {
+    let has_new_message = with_duplicate
+        .iter()
+        .any(|warning| !baseline.contains(warning));
+    let has_more_warnings = with_duplicate.len() > baseline.len();
+    assert!(
+        has_new_message || has_more_warnings,
+        "{context} should emit a warning. \
+         Baseline warnings: {baseline:?}, warnings with duplicates: {with_duplicate:?}"
+    );
+}
+
+#[derive(AssetCollection, Resource)]
+struct MyAssets {
+    #[asset(path = "audio/background.ogg")]
+    background: Handle<AudioSource>,
+}
+
+#[derive(Clone, Copy, Debug, States, Default, PartialEq, Eq, Hash)]
+enum MyStates {
+    #[default]
+    Load,
+    Play,
+}
+
+fn use_loading_assets(assets: Res<MyAssets>, asset_server: Res<AssetServer>) {
+    assert!(
+        asset_server.is_loaded_with_dependencies(&assets.background),
+        "The collection is not fully loaded!"
+    );
+}
+
+fn timeout(time: Res<Time>) {
+    if time.elapsed_seconds_f64() > 30. {
+        panic!("The app did not finish in 30 seconds");
+    }
+}
+
+fn quit(mut exit: EventWriter<AppExit>) {
+    info!("Everything fine, quitting the app");
+    exit.send(AppExit);
+}
