+    describe("Endianness", () => {
+      it("should return the same parser instance to allow chaining", () => {
+        const parser = new Parser();
+        ok((parser as any).endianness("little") === parser);
+        ok((parser as any).endianness("big") === parser);
+      });
+
+      it("should accept the byte order case-insensitively", () => {
+        const little = (new Parser() as any).endianness("LITTLE").uint16("a");
+        deepStrictEqual(little.parse(factory([0x01, 0x02])), { a: 0x0201 });
+
+        const big = (new Parser() as any).endianness("Big").uint16("a");
+        deepStrictEqual(big.parse(factory([0x01, 0x02])), { a: 0x0102 });
+      });
+
+      it("should configure the byte order of subsequent primitive fields", () => {
+        const little = (new Parser() as any)
+          .endianness("little")
+          .uint16("a")
+          .uint32("b");
+        deepStrictEqual(
+          little.parse(factory([0x01, 0x02, 0x03, 0x04, 0x05, 0x06])),
+          { a: 0x0201, b: 0x06050403 }
+        );
+
+        const big = (new Parser() as any).endianness("big").uint16("a").uint32("b");
+        deepStrictEqual(
+          big.parse(factory([0x01, 0x02, 0x03, 0x04, 0x05, 0x06])),
+          { a: 0x0102, b: 0x03040506 }
+        );
+      });
+
+      it("should throw an Error for an unsupported byte order", () => {
+        throws(() => (new Parser() as any).endianness("middle"), Error);
+      });
+    });
