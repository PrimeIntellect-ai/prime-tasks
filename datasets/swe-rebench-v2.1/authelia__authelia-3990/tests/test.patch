+func (suite *AccessControl) TestShouldValidateQueryRules() {
+	domains := []string{"public.example.com"}
+	suite.config.AccessControl.Rules = []schema.ACLRule{
+		{
+			Domains: domains,
+			Policy:  "bypass",
+			Query: [][]schema.ACLQueryRule{
+				{
+					{Operator: "present", Key: "example"},
+				},
+				{
+					{Operator: "equal", Key: "example", Value: "test"},
+				},
+			},
+		},
+		{
+			Domains: domains,
+			Policy:  "bypass",
+			Query: [][]schema.ACLQueryRule{
+				{
+					{Operator: "pattern", Key: "a", Value: "^(x|y|z)$"},
+				},
+			},
+		},
+	}
+
+	ValidateRules(suite.config, suite.validator)
+
+	suite.Assert().Len(suite.validator.Warnings(), 0)
+	suite.Assert().Len(suite.validator.Errors(), 0)
+}
+
+func (suite *AccessControl) TestShouldErrorOnInvalidRulesQuery() {
+	testCases := []struct {
+		name  string
+		query [][]schema.ACLQueryRule
+	}{
+		{
+			"ShouldErrorOnEqualWithoutValue",
+			[][]schema.ACLQueryRule{{{Operator: "equal", Key: "example"}}},
+		},
+		{
+			"ShouldErrorOnMissingKey",
+			[][]schema.ACLQueryRule{{{Operator: "present"}}},
+		},
+		{
+			"ShouldErrorOnEmptyRule",
+			[][]schema.ACLQueryRule{{{}}},
+		},
+		{
+			"ShouldErrorOnInvalidOperator",
+			[][]schema.ACLQueryRule{{{Operator: "not", Key: "a", Value: "a"}}},
+		},
+		{
+			"ShouldErrorOnInvalidPattern",
+			[][]schema.ACLQueryRule{{{Operator: "pattern", Key: "a", Value: "(bad pattern"}}},
+		},
+	}
+
+	for _, tc := range testCases {
+		suite.T().Run(tc.name, func(t *testing.T) {
+			validator := schema.NewStructValidator()
+			config := &schema.Configuration{
+				AccessControl: schema.AccessControlConfiguration{
+					DefaultPolicy: policyDeny,
+					Networks:      schema.DefaultACLNetwork,
+					Rules: []schema.ACLRule{
+						{
+							Domains: []string{"public.example.com"},
+							Policy:  "bypass",
+							Query:   tc.query,
+						},
+					},
+				},
+			}
+
+			ValidateRules(config, validator)
+
+			assert.NotEmpty(t, validator.Errors())
+		})
+	}
+}
+
 func TestAccessControl(t *testing.T) {
 	suite.Run(t, new(AccessControl))
 }
