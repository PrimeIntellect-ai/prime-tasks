index 87c47a85..595b291e 100644
--- a/test/arb/Complex-test.jl
+++ b/test/arb/Complex-test.jl
@@ -45,6 +45,7 @@ end
   @test CC("1.0 +/- 0") == a
   @test CC("+1.00000e+0") == a
   @test CC(BigFloat(1)) == a
+  @test CC(Complex{Int}(1)) == a
 
   b = CC(2,3)
   @test CC("2","3") == b
@@ -55,6 +56,7 @@ end
   @test CC(Rational{BigInt}(2), Rational{BigInt}(3)) == b
   @test CC(2.0, 3.0) == b
   @test CC(BigFloat(2), BigFloat(3)) == b
+  @test CC(Complex{Int}(2, 3)) == b
   @test real(b) == 2
   @test imag(b) == 3
 
@@ -165,6 +167,25 @@ end
     @test x ^ T(4) == 16
   end
 
+  xx = CC(2, 2)
+  for T in [Complex{Int}, Complex{Float64}]
+    @test xx + T(2, 2) == T(2, 2) + xx == CC(4, 4)
+    @test xx * T(0, 1) == T(0, 1) * xx == CC(-2, 2)
+    @test xx // T(0, 1) == CC(2, -2)
+    @test T(0, 1) // xx == CC(1//4, 1//4)
+    @test typeof(T(0, 1) // xx) == typeof(xx)
+    @test xx - T(2, 2) == -(T(2, 2) - xx) == zero(CC)
+  end
+
+  # Complex{Bool} values such as `im` must be supported too
+  @test xx * im == im * xx == CC(-2, 2)
+  @test xx + im == im + xx == CC(2, 3)
+  @test xx - im == CC(2, 1)
+  @test im - xx == CC(-2, -1)
+  @test xx // im == CC(2, -2)
+  @test im // xx == CC(1//4, 1//4)
+  @test typeof(im // xx) == typeof(xx)
+
   for T in [Float64, BigFloat, RealFieldElem]
     @test contains(x + T(4), 6)
     @test contains(x - T(4), -2)
