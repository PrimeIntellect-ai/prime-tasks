+
+#[test]
+fn event_content_supports_both_account_data_kinds() {
+    use std::{fs, process::Command};
+
+    let events_manifest = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("Cargo.toml");
+    let workspace = events_manifest.parent().unwrap().parent().unwrap().parent().unwrap();
+    let temporary_crate =
+        std::env::temp_dir().join(format!("ruma-double-kind-{}", std::process::id()));
+    let source_dir = temporary_crate.join("src");
+    fs::create_dir_all(&source_dir).unwrap();
+    fs::write(
+        temporary_crate.join("Cargo.toml"),
+        format!(
+            "[package]\nname = \"double-kind-contract-check\"\nversion = \"0.0.0\"\nedition = \"2021\"\n\n[dependencies]\nruma-events = {{ path = {:?} }}\nserde = {{ version = \"1\", features = [\"derive\"] }}\n",
+            events_manifest.parent().unwrap(),
+        ),
+    )
+    .unwrap();
+
+    let declarations = [
+        "GlobalAccountData + RoomAccountData",
+        "(GlobalAccountData, RoomAccountData)",
+        "GlobalAccountData | RoomAccountData",
+        "GlobalAndRoomAccountData",
+    ];
+    let mut successful = false;
+    let mut failures = Vec::new();
+
+    for kind in declarations {
+        let source = format!(
+            r#"use ruma_events::macros::EventContent;
+use serde::{{Deserialize, Serialize}};
+
+#[derive(Clone, Debug, Deserialize, Serialize, EventContent)]
+#[ruma_event(type = "m.macro.test", kind = {kind})]
+struct Content {{ value: String }}
+
+fn main() {{
+    let content = Content {{ value: String::new() }};
+    assert_eq!(ruma_events::GlobalAccountDataEventContent::event_type(&content).to_string(), "m.macro.test");
+    assert_eq!(ruma_events::RoomAccountDataEventContent::event_type(&content).to_string(), "m.macro.test");
+}}
+"#
+        );
+        fs::write(source_dir.join("main.rs"), source).unwrap();
+
+        let output = Command::new(env!("CARGO"))
+            .arg("run")
+            .arg("--offline")
+            .arg("--quiet")
+            .arg("--manifest-path")
+            .arg(temporary_crate.join("Cargo.toml"))
+            .env("CARGO_TARGET_DIR", workspace.join("target"))
+            .output()
+            .expect("could not run cargo for the account-data contract check");
+
+        if output.status.success() {
+            successful = true;
+            break;
+        }
+        failures.push(format!("kind = {kind}: {}", String::from_utf8_lossy(&output.stderr)));
+    }
+
+    let _ = fs::remove_dir_all(&temporary_crate);
+    assert!(
+        successful,
+        "no supported declaration provided both account-data behaviors:\n{}",
+        failures.join("\n")
+    );
+}
