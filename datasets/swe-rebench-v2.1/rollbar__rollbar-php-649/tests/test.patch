@@ -20,4 +20,26 @@ class TelemetryEventTest extends BaseRollbarTest
         self::assertGreaterThanOrEqual($before, $event->timestamp);
         self::assertLessThanOrEqual($after, $event->timestamp);
     }
+
+    /**
+     * @since 4.1.1
+     */
+    public function testBodyRetainsNestedEntriesAndMessage(): void
+    {
+        $nestedEntry = ['data' => 'some data'];
+        $event = new TelemetryEvent(EventType::Log, EventLevel::Info, [$nestedEntry]);
+
+        $serializedBody = json_decode(json_encode($event->body->serialize()), true);
+        self::assertContains($nestedEntry, array_values($serializedBody), true);
+
+        $nestedEntryWithNumericKey = ['id' => 'some id'];
+        $event = new TelemetryEvent(EventType::Log, EventLevel::Info, [
+            0 => $nestedEntryWithNumericKey,
+            'message' => 'test message',
+        ]);
+
+        $serializedBody = json_decode(json_encode($event->body->serialize()), true);
+        self::assertSame('test message', $serializedBody['message']);
+        self::assertContains($nestedEntryWithNumericKey, array_values($serializedBody), true);
+    }
 }
