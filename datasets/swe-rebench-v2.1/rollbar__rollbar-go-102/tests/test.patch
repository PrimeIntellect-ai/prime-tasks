+package rollbar
+
+import (
+	"os"
+	"os/exec"
+	"runtime"
+	"testing"
+	"time"
+)
+
+func TestDisableDefaultClientStopsBackgroundWorker(t *testing.T) {
+	const childMarker = "ROLLBAR_DISABLE_DEFAULT_CLIENT_CHILD"
+	if os.Getenv(childMarker) != "1" {
+		cmd := exec.Command(os.Args[0], "-test.run=^TestDisableDefaultClientStopsBackgroundWorker$")
+		cmd.Env = append(os.Environ(), childMarker+"=1")
+		if output, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("isolated default-client check failed: %v\n%s", err, output)
+		}
+		return
+	}
+
+	// Use an isolated process so unrelated tests cannot mask a leaked worker.
+	goroutinesBefore := runtime.NumGoroutine()
+	time.Sleep(100 * time.Millisecond)
+	if current := runtime.NumGoroutine(); current > goroutinesBefore {
+		goroutinesBefore = current
+	}
+	DisableDefaultClient(false)
+
+	deadline := time.Now().Add(2 * time.Second)
+	for runtime.NumGoroutine() >= goroutinesBefore && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if got := runtime.NumGoroutine(); got >= goroutinesBefore {
+		t.Fatalf("disabling the default client did not stop its background worker (goroutines before=%d, after=%d)", goroutinesBefore, got)
+	}
+}
