+func TestLogHookDatabaseLevel(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	debugHook := NewHook(ctx, nil, "foo", 100, "debug")
+	assert.ElementsMatch(t, logrus.AllLevels, debugHook.Levels())
+
+	infoHook := NewHook(ctx, nil, "foo", 100, "info")
+	infoLevels := infoHook.Levels()
+	assert.Contains(t, infoLevels, logrus.InfoLevel)
+	assert.Contains(t, infoLevels, logrus.ErrorLevel)
+	assert.NotContains(t, infoLevels, logrus.DebugLevel)
+	assert.NotContains(t, infoLevels, logrus.TraceLevel)
+
+	errorHook := NewHook(ctx, nil, "foo", 100, "error")
+	errorLevels := errorHook.Levels()
+	assert.Contains(t, errorLevels, logrus.ErrorLevel)
+	assert.NotContains(t, errorLevels, logrus.WarnLevel)
+	assert.NotContains(t, errorLevels, logrus.InfoLevel)
+	assert.NotContains(t, errorLevels, logrus.DebugLevel)
+	assert.NotContains(t, errorLevels, logrus.TraceLevel)
+}
+
+func TestDatabaseLogLevelOption(t *testing.T) {
+	infoLevels := []logrus.Level{
+		logrus.PanicLevel,
+		logrus.FatalLevel,
+		logrus.ErrorLevel,
+		logrus.WarnLevel,
+		logrus.InfoLevel,
+	}
+	errorLevels := []logrus.Level{
+		logrus.PanicLevel,
+		logrus.FatalLevel,
+		logrus.ErrorLevel,
+	}
+	tests := []struct {
+		name     string
+		args     []string
+		expected []logrus.Level
+	}{
+		{name: "default", args: []string{"--log-level=debug"}, expected: infoLevels},
+		{name: "debug", args: []string{"--log-level=debug", "--log-database-level=debug"}, expected: logrus.AllLevels},
+		{name: "info", args: []string{"--log-level=debug", "--log-database-level=info"}, expected: infoLevels},
+		{name: "error", args: []string{"--log-level=debug", "--log-database-level=error"}, expected: errorLevels},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			opts := config.NewCmdOptions(test.args...)
+			assert.Equal(t, "debug", opts.Logging.LogLevel)
+
+			logger := appLog.Init(opts.Logging).(*logrus.Logger)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			pge := &PgEngine{l: logger, CmdOptions: *opts}
+			pge.AddLogHook(ctx)
+
+			assert.Equal(t, logrus.DebugLevel, logger.GetLevel())
+			hooks := logger.Hooks[logrus.ErrorLevel]
+			foundExpectedLevels := false
+			for _, hook := range hooks {
+				accepted := make(map[logrus.Level]bool)
+				for _, level := range hook.Levels() {
+					accepted[level] = true
+				}
+				if len(accepted) != len(test.expected) {
+					continue
+				}
+				foundExpectedLevels = true
+				for _, level := range test.expected {
+					if !accepted[level] {
+						foundExpectedLevels = false
+						break
+					}
+				}
+				if foundExpectedLevels {
+					break
+				}
+			}
+			assert.True(t, foundExpectedLevels)
+		})
+	}
+}
