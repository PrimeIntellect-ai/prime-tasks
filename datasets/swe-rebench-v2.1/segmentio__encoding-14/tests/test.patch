+
+type Issue13 struct {
+	Stringer fmt.Stringer
+	Field    int `json:"MyInt"`
+}
+
+type S string
+
+func (s S) String() string { return string(s) }
+
+func TestGithubIssue13(t *testing.T) {
+	// https://github.com/segmentio/encoding/issues/13
+	//
+	// Marshaling a struct with a nil interface member must succeed and
+	// produce JSON data, matching the behavior of encoding/json.
+	v := Issue13{Field: 2}
+
+	b, err := Marshal(v)
+	if err != nil {
+		t.Fatal("unexpected error:", err)
+	}
+	if want := `{"Stringer":null,"MyInt":2}`; string(b) != want {
+		t.Errorf("unexpected JSON output:\ngot:  %s\nwant: %s", b, want)
+	}
+}
