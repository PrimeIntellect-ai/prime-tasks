+func TestValidateIdentityProvidersShouldNotPanicOnJWKWithoutKey(t *testing.T) {
+	testCases := []struct {
+		name   string
+		config *schema.IdentityProviders
+	}{
+		{
+			"ShouldNotPanicIssuerJWKWithoutKeyID",
+			&schema.IdentityProviders{
+				OIDC: &schema.IdentityProvidersOpenIDConnect{
+					HMACSecret: "abc",
+					JSONWebKeys: []schema.JWK{
+						{Use: oidc.KeyUseSignature, Key: nil},
+					},
+				},
+			},
+		},
+		{
+			"ShouldNotPanicIssuerJWKWithKeyID",
+			&schema.IdentityProviders{
+				OIDC: &schema.IdentityProvidersOpenIDConnect{
+					HMACSecret: "abc",
+					JSONWebKeys: []schema.JWK{
+						{KeyID: "example", Use: oidc.KeyUseSignature, Key: nil},
+					},
+				},
+			},
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			validator := schema.NewStructValidator()
+
+			require.NotPanics(t, func() {
+				ValidateIdentityProviders(NewValidateCtx(), tc.config, validator)
+			})
+
+			assert.NotEmpty(t, validator.Errors())
+		})
+	}
+}
+
+func TestValidateIdentityProvidersShouldFailOnClientJWKWithoutKey(t *testing.T) {
+	config := &schema.IdentityProviders{
+		OIDC: &schema.IdentityProvidersOpenIDConnect{
+			HMACSecret: "abc",
+			Clients: []schema.IdentityProvidersOpenIDConnectClient{
+				{
+					ID: "test",
+					JSONWebKeys: []schema.JWK{
+						{KeyID: "test", Use: oidc.KeyUseSignature, Algorithm: oidc.SigningAlgRSAUsingSHA256, Key: nil},
+					},
+				},
+			},
+		},
+	}
+
+	validator := schema.NewStructValidator()
+
+	require.NotPanics(t, func() {
+		ValidateIdentityProviders(NewValidateCtx(), config, validator)
+	})
+
+	var found bool
+
+	for _, err := range validator.Errors() {
+		if strings.Contains(err.Error(), "client 'test'") && strings.Contains(err.Error(), "key #1") && strings.Contains(err.Error(), "option 'key' must be provided") {
+			found = true
+		}
+	}
+
+	assert.True(t, found, "expected a client key error naming the client, the key and the missing 'key' option, got: %v", validator.Errors())
+}
