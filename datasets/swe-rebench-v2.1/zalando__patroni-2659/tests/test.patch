+class TestKubernetesRoleLabels(BaseTestKubernetes):
+
+    def setUp(self, config=None):
+        super(TestKubernetesRoleLabels, self).setUp({
+            'leader_label_value': 'true',
+            'follower_label_value': 'false',
+        })
+
+    @patch.object(k8s_client.CoreV1Api, 'patch_namespaced_pod', create=True)
+    def test_touch_member_role_labels(self, mock_patch_namespaced_pod):
+        mock_patch_namespaced_pod.return_value.metadata.resource_version = '10'
+        self.k._name = 'p-1'
+        self.k.touch_member({'state': 'running', 'role': 'replica'})
+        self.assertEqual(mock_patch_namespaced_pod.call_args.args[2].metadata.labels['role'], 'false')
+
+        self.k._name = 'p-0'
+        self.k.touch_member({'role': 'primary'})
+        self.assertEqual(mock_patch_namespaced_pod.call_args.args[2].metadata.labels['role'], 'true')
+
+
+class TestKubernetesRoleLabelDefaults(BaseTestKubernetes):
+
+    @patch.object(k8s_client.CoreV1Api, 'patch_namespaced_pod', create=True)
+    def test_leader_label_defaults_to_master(self, mock_patch_namespaced_pod):
+        mock_patch_namespaced_pod.return_value.metadata.resource_version = '10'
+        self.k.touch_member({'role': 'primary'})
+        labels = mock_patch_namespaced_pod.call_args.args[2].metadata.labels
+        self.assertEqual(labels['role'], 'master')
+
+    @patch.object(k8s_client.CoreV1Api, 'patch_namespaced_pod', create=True)
+    def test_replica_label_defaults_to_replica(self, mock_patch_namespaced_pod):
+        self.k._name = 'p-1'
+        mock_patch_namespaced_pod.return_value.metadata.resource_version = '10'
+        self.k.touch_member({'state': 'running', 'role': 'replica'})
+        labels = mock_patch_namespaced_pod.call_args.args[2].metadata.labels
+        self.assertEqual(labels['role'], 'replica')
+
