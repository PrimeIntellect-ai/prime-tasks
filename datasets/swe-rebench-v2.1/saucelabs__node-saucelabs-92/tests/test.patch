+const swagger = require('../apis/sauce.json')
+
+test('should describe team-aware concurrency in the v1.2 Swagger response', () => {
+    const endpoint = swagger.paths['/v1.2/users/{username}/concurrency']
+    expect(endpoint).toBeDefined()
+
+    const definitions = swagger.definitions
+    const resolve = (schema) => {
+        if (!schema) return schema
+        if (schema.$ref) {
+            return resolve(definitions[schema.$ref.replace('#/definitions/', '')])
+        }
+
+        const combined = (schema.allOf || []).map(resolve).reduce(
+            (result, part) => ({
+                ...result,
+                ...part,
+                properties: { ...result.properties, ...part.properties }
+            }),
+            { ...schema }
+        )
+        delete combined.allOf
+        if (combined.properties) {
+            combined.properties = Object.fromEntries(
+                Object.entries(combined.properties).map(([name, value]) => [name, resolve(value)])
+            )
+        }
+        if (combined.additionalProperties && typeof combined.additionalProperties === 'object') {
+            combined.additionalProperties = resolve(combined.additionalProperties)
+        }
+        return combined
+    }
+
+    const response = resolve(endpoint.get.responses['200'].schema)
+    const concurrency = response.properties.concurrency
+    expect(concurrency.type).toBe('object')
+
+    const group = concurrency.additionalProperties
+    const current = group.properties.current
+    const allowed = group.properties.allowed
+    for (const values of [current, allowed]) {
+        const properties = values.properties
+        expect(properties.mac_vms.type).toBe('integer')
+        expect(properties.rds.type).toBe('integer')
+        expect(properties.vms.type).toBe('integer')
+        expect(properties.id.type).toBe('string')
+    }
+})
 
