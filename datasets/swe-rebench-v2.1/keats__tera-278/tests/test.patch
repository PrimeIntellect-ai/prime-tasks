+#[test]
+fn render_array_with_filters() {
+    let context = Context::new();
+
+    let inputs = vec![
+        ("{% set i = ['a'|upper, 'b'] %}{{ i }}", "[A, b]"),
+        ("{% for a in ['x'|upper, 'y'] %}{{a}}{% endfor %}", "Xy"),
+    ];
+
+    for (input, expected) in inputs {
+        assert_eq!(render_template(input, &context).unwrap(), expected);
+    }
+}
+
+#[test]
+fn render_array_elements_expressions() {
+    let context = Context::new();
+
+    let inputs = vec![("{% set i = [range(end=2)] %}{{ i }}", "[[0, 1]]")];
+
+    for (input, expected) in inputs {
+        assert_eq!(render_template(input, &context).unwrap(), expected);
+    }
+
+    let arithmetic = render_template(
+        "{% set values = [1 + 1, range(end=2)] %}{{ values }}",
+        &context,
+    )
+    .unwrap();
+    assert!(arithmetic == "[2, [0, 1]]" || arithmetic == "[2.0, [0, 1]]");
+}
