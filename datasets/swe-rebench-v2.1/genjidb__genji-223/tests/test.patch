+func TestParenthesizedExpressionEvaluation(t *testing.T) {
+	parseAndEvaluate := func(source string) (expr.Expr, document.Value) {
+		t.Helper()
+		parsed, _, err := NewParser(strings.NewReader(source)).ParseExpr()
+		require.NoError(t, err)
+		value, err := parsed.Eval(expr.EvalStack{})
+		require.NoError(t, err)
+		return parsed, value
+	}
+
+	_, scalar := parseAndEvaluate("(1)")
+	require.Equal(t, document.NewIntegerValue(1), scalar)
+
+	parsed, list := parseAndEvaluate("(1 + 1, 3 > 5)")
+	_, isLiteralList := parsed.(expr.LiteralExprList)
+	require.True(t, isLiteralList, "a parenthesized multi-member list is a LiteralExprList")
+	require.Equal(t, document.ArrayValue, list.Type)
+	var values []document.Value
+	err := list.V.(document.Array).Iterate(func(_ int, value document.Value) error {
+		values = append(values, value)
+		return nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, []document.Value{
+		document.NewIntegerValue(2),
+		document.NewBoolValue(false),
+	}, values)
+}
+
+func TestParenthesizedListMembership(t *testing.T) {
+	for _, test := range []struct {
+		name string
+		left string
+		want bool
+	}{
+		{name: "member", left: "1", want: true},
+		{name: "non-member", left: "3", want: false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			evaluate := func(source string) document.Value {
+				t.Helper()
+				parsed, _, err := NewParser(strings.NewReader(source)).ParseExpr()
+				require.NoError(t, err)
+				value, err := parsed.Eval(expr.EvalStack{})
+				require.NoError(t, err)
+				return value
+			}
+			parenthesized := evaluate(test.left + " IN (1, 2)")
+			bracketed := evaluate(test.left + " IN [1, 2]")
+			require.Equal(t, bracketed, parenthesized)
+			require.Equal(t, document.NewBoolValue(test.want), parenthesized)
+		})
+	}
+}
