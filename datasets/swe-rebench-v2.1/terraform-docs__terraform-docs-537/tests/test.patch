+package cli
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestConfigOutputTemplateCLI(t *testing.T) {
+	moduleDir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(moduleDir, "main.tf"), []byte("\n"), 0600))
+	readmePath := filepath.Join(moduleDir, "README.md")
+
+	cmd := exec.Command("go", "run", "../..",
+		"--output-file", "README.md",
+		"--output-template", `<!-- BEGIN_TF_DOCS -->\n{{ .Content }}\n<!-- END_TF_DOCS -->`,
+		"markdown", "table", moduleDir,
+	)
+	output, err := cmd.CombinedOutput()
+	require.NoError(t, err, string(output))
+
+	readme, err := os.ReadFile(readmePath)
+	require.NoError(t, err)
+	assert.Contains(t, string(readme), "<!-- BEGIN_TF_DOCS -->\n")
+	assert.Contains(t, string(readme), "\n<!-- END_TF_DOCS -->")
+}
