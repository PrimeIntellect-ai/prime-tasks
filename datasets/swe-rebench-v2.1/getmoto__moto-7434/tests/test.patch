+def test_put_logging_w_bucket_policy_w_prefix(bucket_name=None):
+    s3_client = boto3.client("s3", region_name=DEFAULT_REGION_NAME)
+
+    log_bucket_name = f"{uuid4()}"
+    s3_client.create_bucket(Bucket=log_bucket_name)
