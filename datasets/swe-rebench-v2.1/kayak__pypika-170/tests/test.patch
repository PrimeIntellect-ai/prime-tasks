+
+class QuoteTests(unittest.TestCase):
+    def test_extraneous_quotes(self):
+        t1 = Table('table1', alias='t1')
+        t2 = Table('table2', alias='t2')
+
+        query = Query.from_(t1).join(t2).on(t1.Value.between(t2.start, t2.end)).select(t1.value)
+
+        self.assertEqual('SELECT t1.value FROM table1 t1 '
+                         'JOIN table2 t2 ON t1.Value '
+                         'BETWEEN t2.start AND t2.end', query.get_sql(quote_char=None))
+
+    def test_between_field_lower_bound_uses_query_formatting(self):
+        t1 = Table('table1', alias='t1')
+        t2 = Table('table2', alias='t2')
+
+        query = Query.from_(t1).join(t2).on(t1.value.between(t2.start, 10)).select(t1.value)
+
+        self.assertEqual('SELECT `t1`.`value` FROM `table1` `t1` '
+                         'JOIN `table2` `t2` ON `t1`.`value` '
+                         'BETWEEN `t2`.`start` AND 10', query.get_sql(quote_char='`'))
+
+    def test_between_field_upper_bound_uses_query_formatting(self):
+        t1 = Table('table1', alias='t1')
+        t2 = Table('table2', alias='t2')
+
+        query = Query.from_(t1).join(t2).on(t1.value.between(10, t2.end)).select(t1.value)
+
+        self.assertEqual('SELECT `t1`.`value` FROM `table1` `t1` '
+                         'JOIN `table2` `t2` ON `t1`.`value` '
+                         'BETWEEN 10 AND `t2`.`end`', query.get_sql(quote_char='`'))
+
+    def test_between_non_field_sql_term_lower_bound_uses_query_formatting(self):
+        t1 = Table('table1', alias='t1')
+        t2 = Table('table2', alias='t2')
+
+        query = Query.from_(t1).join(t2).on(t1.value.between(t2.start + 1, 10)).select(t1.value)
+
+        sql = query.get_sql(quote_char='`')
+
+        self.assertRegex(sql, r'^SELECT `t1`\.`value` FROM `table1` `t1` '
+                              r'JOIN `table2` `t2` ON `t1`\.`value` '
+                              r'BETWEEN \(?`t2`\.`start` ?\+ ?1\)? AND 10$')
+
+    def test_between_non_field_sql_term_upper_bound_uses_query_formatting(self):
+        t1 = Table('table1', alias='t1')
+        t2 = Table('table2', alias='t2')
+
+        query = Query.from_(t1).join(t2).on(t1.value.between(10, t2.end + 1)).select(t1.value)
+
+        sql = query.get_sql(quote_char='`')
+
+        self.assertRegex(sql, r'^SELECT `t1`\.`value` FROM `table1` `t1` '
+                              r'JOIN `table2` `t2` ON `t1`\.`value` '
+                              r'BETWEEN 10 AND \(?`t2`\.`end` ?\+ ?1\)?$')
