+def test_arima_prediction_intervals_accept_unfamiliar_column_label(ts_data):
+    X_train, X_test, y_train = ts_data(no_features=True)
+    clf = ARIMARegressor(use_covariates=False)
+    clf.fit(X_train, y_train)
+
+    lower = np.arange(len(X_test), dtype=float)
+    upper = lower + 10
+    intervals = pd.DataFrame(
+        np.column_stack([lower, upper]),
+        columns=pd.MultiIndex.from_tuples(
+            [
+                ("future_target_label", 0.95, "lower"),
+                ("future_target_label", 0.95, "upper"),
+            ],
+        ),
+    )
+    with patch(
+        "sktime.forecasting.arima.AutoARIMA.predict_interval",
+        return_value=intervals,
+    ):
+        result = clf.get_prediction_intervals(X_test, coverage=[0.95])
+
+    pd.testing.assert_series_equal(
+        result["0.95_lower"], pd.Series(lower, index=X_test.index)
+    )
+    pd.testing.assert_series_equal(
+        result["0.95_upper"], pd.Series(upper, index=X_test.index)
+    )
