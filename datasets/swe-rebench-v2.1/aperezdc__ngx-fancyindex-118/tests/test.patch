diff --git a/t/12-local-footer-nested.test b/t/12-local-footer-nested.test
new file mode 100644
index 0000000..25bd1fd
--- /dev/null
+++ b/t/12-local-footer-nested.test
@@ -0,0 +1,61 @@
+#! /bin/bash
+cat <<---
+The header and footer directives accept an omitted kind as a subrequest,
+accept an explicit subrequest kind, and reject unknown kinds.
+--
+
+# Verify that omitted kinds fetch the configured URIs as subrequests.
+echo '<div id="defaultheader">header-subrequest</div>' > "${TESTDIR}/scn2-header"
+echo '<div id="defaultfooter">footer-subrequest</div>' > "${TESTDIR}/scn2-footer"
+nginx_start 'fancyindex_header "/scn2-header";
+             fancyindex_footer "/scn2-footer";'
+P=$(fetch /)
+[[ $P == *header-subrequest* ]] || fail 'Path-only header did not use a subrequest'
+[[ $P == *footer-subrequest* ]] || fail 'Path-only footer did not use a subrequest'
+nginx_stop
+
+# Use a URI that names an existing local file too: its URI response differs
+# from the local-file contents, making the selected kind observable.
+echo '<div id="localfooter">LOCAL_CONTENT_UNIQUE_1287</div>' > "${TESTDIR}/order-footer"
+mkdir -p "${TESTDIR}${TESTDIR}"
+echo '<div id="requestfooter">request-footer</div>' > "${TESTDIR}${TESTDIR}/order-footer"
+cat > "${NGINX_CONF}" <<EOF_CONF
+worker_processes 1;
+events { worker_connections 1024; }
+http {
+    include mime.types;
+    default_type application/octet-stream;
+    server {
+        listen 127.0.0.1:8889;
+        location /tools/memdisk { return 204; }
+    }
+    server {
+        listen 127.0.0.1:8888;
+        root ${TESTDIR};
+        location / {
+            fancyindex on;
+            fancyindex_footer "${TESTDIR}/order-footer";
+            fancyindex_header "/scn2-header" subrequest;
+        }
+    }
+}
+EOF_CONF
+nginx -t || fail 'Footer-first path-only configuration was rejected'
+nginx_start
+P=$(fetch /)
+[[ $P == *header-subrequest* ]] || fail 'Explicit subrequest header was not included'
+[[ $P == *request-footer* ]] || fail 'Path-only footer did not default to subrequest'
+[[ $P != *LOCAL_CONTENT_UNIQUE_1287* ]] || fail 'Path-only footer used local-file contents'
+nginx_stop
+
+# An unrecognized kind on either directive must reject the configuration and
+# produce a diagnostic in the nginx error log.
+for directive in fancyindex_header fancyindex_footer; do
+    before=$(wc -c < "${PREFIX}/logs/error.log" 2>/dev/null || echo 0)
+    nginx_conf "${directive} \"/scn2-file\" bogus;"
+    if nginx -t; then
+        fail "Nginx accepted an unknown kind for ${directive}"
+    fi
+    after=$(wc -c < "${PREFIX}/logs/error.log" 2>/dev/null || echo 0)
+    [[ ${after} -gt ${before} ]] || fail "No error logged for unknown kind on ${directive}"
+done
