+)
+def test_equivalent_invocations_give_same_advice(runner, args, equivalent_args):
+    """
+    Semantically identical invocations must produce the same "To update, run" advice.
+    """
+    assert _update_command(runner, args) == _update_command(runner, equivalent_args)
+
+
+def test_short_options_are_shown_in_long_form(runner):
+    command = _update_command(
+        runner, ["-p", "-f", "links", "-i", "https://foo", "-o", "out.txt"]
+    )
+
+    assert _split_command(command)[0] == [
+        ("--find-links", "links"),
+        ("--index-url", "https://foo"),
+        ("--output-file", "out.txt"),
+        ("--pre", None),
+    ]
+
