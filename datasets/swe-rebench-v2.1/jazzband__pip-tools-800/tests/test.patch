+def test_arguments_sorted_regardless_of_input_order(runner):
+    args = [
+        "--client-cert",
+        "client.pem",
+        "--cert",
+        "ca.pem",
+        "--trusted-host",
+        "example.com",
+        "--no-annotate",
+        "--extra-index-url",
+        "https://b",
+        "--output-file",
+        "requirements.txt",
+    ]
+    command = _update_command(runner, args, src_files=("b.in", "a.in"))
+
+    options, files = _split_command(command)
+    assert options == [
+        ("--cert", "ca.pem"),
+        ("--client-cert", "client.pem"),
+        ("--extra-index-url", "https://b"),
+        ("--no-annotate", None),
+        ("--output-file", "requirements.txt"),
+        ("--trusted-host", "example.com"),
+    ]
+    assert files == ["a.in", "b.in"]
+
