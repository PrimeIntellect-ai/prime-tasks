+)
+def test_get_compile_command(runner, cli_args, expected_command):
+    """
+    Test general scenarios for the normalized "To update, run" command.
+    """
+    command = _update_command(runner, cli_args)
+    assert _split_command(command)[0] == _split_command(expected_command)[0]
+
+
+@mark.parametrize(
+    "filename", ["requirements.in", "my requirements.in", "απαιτήσεις.txt"]
+)
+def test_get_compile_command_with_files(runner, filename):
+    """
+    Test that the source file names in the command are quoted correctly,
+    so the command can be pasted into a shell.
+    """
+    os.mkdir("sub")
+
+    path = os.path.join("sub", filename)
+    command = _update_command(
+        runner, ["--output-file", "requirements.txt"], src_files=(path,)
+    )
+
+    assert _split_command(command)[1] == [path]
+
+
+def test_get_compile_command_sort_args(runner):
+    """
+    Test that the advice sorts its options and its source files alphabetically.
+    """
+    args = [
+        "--no-index",
+        "--no-emit-trusted-host",
+        "--no-annotate",
+        "--find-links",
+        "foo",
+        "--find-links",
+        "bar",
+        "--output-file",
+        "requirements.txt",
+    ]
+    command = _update_command(runner, args, src_files=("requirements.in", "base.in"))
+
+    options, files = _split_command(command)
+    assert options == [
+        ("--find-links", "bar"),
+        ("--find-links", "foo"),
+        ("--no-annotate", None),
+        ("--no-emit-trusted-host", None),
+        ("--no-index", None),
+        ("--output-file", "requirements.txt"),
+    ]
+    assert files == ["base.in", "requirements.in"]
+
+
