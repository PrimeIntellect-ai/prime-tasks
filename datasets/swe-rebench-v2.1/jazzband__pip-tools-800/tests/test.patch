+# Options whose value is given as the following argument (not with "=")
+VALUE_OPTIONS = {
+    "--cert",
+    "--client-cert",
+    "--extra-index-url",
+    "--find-links",
+    "--index-url",
+    "--max-rounds",
+    "--output-file",
+    "--trusted-host",
+    "-f",
+    "-i",
+    "-o",
+}
+
+
+def _update_command(runner, args, src_files=("requirements.in",)):
+    """
+    Run pip-compile (dry run) and return the command from its "To update, run:" advice.
+    """
+    for name in src_files:
+        with open(name, "w"):
+            pass
+
+    result = runner.invoke(compile_cli, ["--dry-run"] + list(args) + list(src_files))
+    assert result.exit_code == 0, result.output
+
+    commands = [
+        line[len("#    ") :]
+        for line in result.output.splitlines()
+        if line.startswith("#    pip-compile")
+    ]
+    assert len(commands) == 1, result.output
+    return commands[0]
+
+
+def _split_command(command):
+    """
+    Split an advice command into a list of (option, value) pairs and a list of files.
+
+    Quoting is resolved, so the result does not depend on how values are spelled.
+    """
+    tokens = shlex.split(command)
+    assert tokens[0] == "pip-compile"
+
+    options, files = [], []
+    rest = tokens[1:]
+    while rest:
+        token = rest.pop(0)
+        if not token.startswith("-"):
+            files.append(token)
+        elif "=" in token:
+            name, value = token.split("=", 1)
+            options.append((name, value))
+        elif token in VALUE_OPTIONS:
+            options.append((token, rest.pop(0)))
+        else:
+            options.append((token, None))
+    return options, files
+
+
