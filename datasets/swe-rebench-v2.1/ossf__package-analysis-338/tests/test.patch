+func TestParseUnlink(t *testing.T) {
+	tests := []struct {
+		name     string
+		input    string
+		wantPath string
+	}{
+		{
+			name:     "unlink",
+			input:    "I0902 01:19:17.729518     303 strace.go:625] [   4:   4] python3 X unlink(0x7ff5f78e4980 /tmp/lbosrzlp) = 0 (0x0) (58.552Âµs)",
+			wantPath: "/tmp/lbosrzlp",
+		},
+		{
+			name:     "unlinkat",
+			input:    "I0902 01:19:18.991729     303 strace.go:631] [   4:   4] python3 X unlinkat(0x3 /tmp/pip-unpack-7xfj8327, 0x7ff5f790c410 temps-0.3.0.tar.gz, 0x0) = 0 (0x0) (39.914Âµs)",
+			wantPath: "/tmp/pip-unpack-7xfj8327/temps-0.3.0.tar.gz",
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			r := strings.NewReader(test.input)
+			res, err := strace.Parse(r)
+			if err != nil || res == nil {
+				t.Fatalf(`Parse(r) = %v, %v, want _, nil`, res, err)
+			}
+			files := res.Files()
+			if len(files) != 1 || files[0].Path != test.wantPath {
+				t.Fatalf(`Files() = %v, want one entry with path %q`, files, test.wantPath)
+			}
+			if !fileDeleted(files[0]) {
+				t.Errorf(`Files()[0] = %v, want the file recorded as deleted`, files[0])
+			}
+		})
+	}
+}
+
+// fileDeleted reports whether a FileInfo records the file as deleted. It reads
+// the public Delete field dynamically so the test also compiles against
+// implementations that have not yet added the field.
+func fileDeleted(f strace.FileInfo) bool {
+	v := reflect.ValueOf(f).FieldByName("Delete")
+	return v.IsValid() && v.Kind() == reflect.Bool && v.Bool()
+}
