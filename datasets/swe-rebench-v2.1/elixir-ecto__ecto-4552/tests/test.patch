+  test "does not warn on associations to schemas defined later in the same file" do
+    path =
+      Path.join(
+        System.tmp_dir!(),
+        "ecto_schema_later_assoc_#{System.unique_integer([:positive])}.exs"
+      )
+
+    File.write!(path, """
+    defmodule Ecto.SchemaTest.LaterAssocOwner do
+      use Ecto.Schema
+
+      schema "later_assoc_owner" do
+        belongs_to :later, Ecto.SchemaTest.LaterAssocTarget
+      end
+    end
+
+    defmodule Ecto.SchemaTest.LaterAssocTarget do
+      use Ecto.Schema
+
+      schema "later_assoc_target" do
+        field :name, :string
+      end
+    end
+    """)
+
+    try do
+      warnings =
+        ExUnit.CaptureIO.capture_io(:stderr, fn ->
+          assert {:ok, _modules, _warnings} = Kernel.ParallelCompiler.compile([path])
+        end)
+
+      refute warnings =~ "invalid association"
+    after
+      File.rm(path)
+    end
+  end
+
+  test "does not warn on associations to schemas compiled from separate files" do
+    suffix = System.unique_integer([:positive])
+    owner = "Ecto.SchemaTest.CrossFileAssocOwner#{suffix}"
+    target = "Ecto.SchemaTest.CrossFileAssocTarget#{suffix}"
+    root = Path.join(System.tmp_dir!(), "ecto_schema_cross_file_assoc_#{suffix}")
+    owner_path = root <> "_owner.exs"
+    target_path = root <> "_target.exs"
+
+    File.write!(owner_path, """
+    defmodule #{owner} do
+      use Ecto.Schema
+
+      schema "cross_file_assoc_owner" do
+        belongs_to :target, #{target}
+      end
+    end
+    """)
+
+    File.write!(target_path, """
+    defmodule #{target} do
+      use Ecto.Schema
+
+      schema "cross_file_assoc_target" do
+        field :name, :string
+      end
+    end
+    """)
+
+    try do
+      warnings =
+        ExUnit.CaptureIO.capture_io(:stderr, fn ->
+          assert {:ok, _modules, _warnings} =
+                   Kernel.ParallelCompiler.compile([owner_path, target_path])
+        end)
+
+      refute warnings =~ "invalid association"
+    after
+      File.rm(owner_path)
+      File.rm(target_path)
+    end
+  end
+
