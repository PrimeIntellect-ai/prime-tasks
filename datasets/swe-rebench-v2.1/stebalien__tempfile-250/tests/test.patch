+fn regression_tempdir_prefix_in_custom_parent() {
+    let parent = TempDir::new().unwrap();
+    let tmpdir = TempDir::with_prefix_in("prefix", parent.path()).unwrap();
+    let name = tmpdir.path().file_name().unwrap().to_string_lossy();
+    assert!(name.starts_with("prefix"));
+    assert!(tmpdir.path().starts_with(parent.path()));
+    let path = tmpdir.path().to_path_buf();
+    let child = path.join("nested-file");
+    fs::write(&child, b"contents").unwrap();
+    drop(tmpdir);
+    assert!(!path.exists());
+    assert!(!child.exists());
+    assert!(parent.path().exists());
+}
+
+fn regression_tempdir_prefix_default() {
+    let tmpdir = TempDir::with_prefix("prefix").unwrap();
+    let name = tmpdir.path().file_name().unwrap().to_string_lossy();
+    assert!(name.starts_with("prefix"));
+    assert!(tmpdir.path().starts_with(env::temp_dir()));
+}
+
+fn regression_tempdir_prefix_removed_on_drop() {
+    let path = {
+        let tmpdir = TempDir::with_prefix("prefix").unwrap();
+        let path = tmpdir.path().to_path_buf();
+        assert!(path.exists());
+        let child = path.join("nested-file");
+        fs::write(&child, b"contents").unwrap();
+        assert!(child.exists());
+        (path, child)
+    };
+    assert!(!path.0.exists());
+    assert!(!path.1.exists());
+}
