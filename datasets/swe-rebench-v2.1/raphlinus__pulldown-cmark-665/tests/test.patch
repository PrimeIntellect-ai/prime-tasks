+
+#[test]
+fn regression_test_84() {
+    let original = r##"
+  | A   | B   |
+  | --- | --- |
+  | 1   | 2   |
+
+  ```rust
+  println!("Foo Bar");
+  ```
+"##;
+    let mut options = pulldown_cmark::Options::empty();
+    options.insert(pulldown_cmark::Options::ENABLE_TABLES);
+    let parser = pulldown_cmark::Parser::new_ext(original, options);
+    let mut actual = String::new();
+    pulldown_cmark::html::push_html(&mut actual, parser);
+
+    assert!(actual.contains("<table"), "{actual}");
+    assert!(
+        actual.contains("<th") && actual.contains("A</th>") && actual.contains("B</th>"),
+        "{actual}"
+    );
+    assert!(
+        actual.contains("<td") && actual.contains("1</td>") && actual.contains("2</td>"),
+        "{actual}"
+    );
+    assert!(
+        actual.contains("<pre><code") && actual.contains("println!") && actual.contains("Foo Bar"),
+        "{actual}"
+    );
+}
