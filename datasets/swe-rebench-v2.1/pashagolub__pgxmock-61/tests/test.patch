+
+func TestBeginTxWithUnexpectedOptionsDoesNotDeadlockExpectationsWereMet(t *testing.T) {
+	beginCalls := []struct {
+		name string
+		call func(PgxConnIface)
+	}{
+		{
+			name: "BeginTx",
+			call: func(mock PgxConnIface) {
+				_, _ = mock.BeginTx(context.Background(), pgx.TxOptions{IsoLevel: pgx.ReadCommitted})
+			},
+		},
+		{
+			name: "BeginTxFunc",
+			call: func(mock PgxConnIface) {
+				_ = mock.BeginTxFunc(context.Background(), pgx.TxOptions{IsoLevel: pgx.ReadCommitted}, func(pgx.Tx) error {
+					return nil
+				})
+			},
+		},
+	}
+
+	for _, begin := range beginCalls {
+		t.Run(begin.name, func(t *testing.T) {
+			mock, err := NewConn()
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			mock.ExpectBeginTx(pgx.TxOptions{IsoLevel: pgx.Serializable})
+			begin.call(mock)
+
+			result := make(chan error, 1)
+			go func() {
+				result <- mock.ExpectationsWereMet()
+			}()
+
+			select {
+			case err := <-result:
+				if err == nil {
+					t.Fatal("expected an error for the unfulfilled transaction expectation")
+				}
+			case <-time.After(time.Second):
+				t.Fatal("ExpectationsWereMet did not return after an unexpected transaction-options call")
+			}
+		})
+	}
+}
