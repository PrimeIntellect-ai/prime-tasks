+++ b/test/issues/0346.js
@@ -0,0 +1,22 @@
+'use strict';
+
+var assert = require('assert');
+var yaml = require('../../');
+
+
+test('should not emit spaces in arrays in flow mode between entries using condenseFlow: true', function () {
+  var output = yaml.dump([ 'a', 'b' ], { flowLevel: 0, indent: 0, condenseFlow: true });
+
+  assert(/\[.*\]/.test(output));
+  assert(!/\s,|,\s/.test(output));
+  assert.deepEqual(yaml.load(output), [ 'a', 'b' ]);
+});
+
+test('should condense nested flow arrays when condenseFlow is enabled', function () {
+  var value = [ [ 'a', 'b' ], [ 'c', 'd' ] ];
+  var output = yaml.dump(value, { flowLevel: 0, indent: 0, condenseFlow: true });
+
+  assert(/\[.*\]/.test(output));
+  assert(!/\s,|,\s/.test(output));
+  assert.deepEqual(yaml.load(output), value);
+});
