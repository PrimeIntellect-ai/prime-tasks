+  describe('with error in router and custom error handler', () => {
+    it('should invoke the configured error handler when the router throws', (done) => {
+      const proxyMiddleware = createProxyMiddleware({
+        // cSpell:ignore notworkinghost
+        target: `http://notworkinghost:6789`,
+        router: async () => {
+          throw new Error('router failure');
+        },
+        on: {
