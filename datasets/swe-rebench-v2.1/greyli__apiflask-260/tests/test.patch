+def test_apply_custom_error_callback_for_generic_errors():
+    app = APIFlask(__name__, json_errors=False)
+    client = app.test_client()
+
+    @app.error_processor
+    def custom_error_handler(e):
+        # the processor may receive either an HTTPError or a WerkzeugHTTPException
+        status_code = getattr(e, 'status_code', None) or e.code
+        return {'message': 'custom handler'}, status_code
+
+    rv = client.get('/not-exist')
+    assert rv.status_code == 404
+    assert 'message' in rv.json
+    assert rv.json['message'] == 'custom handler'
+
+    @app.get('/error')
+    def error():
+        raise RuntimeError('boom')
+
+    rv = client.get('/error')
+    assert rv.status_code == 500
+    assert rv.json['message'] == 'custom handler'
+
+
 def test_skip_raw_blueprint(app, client):
