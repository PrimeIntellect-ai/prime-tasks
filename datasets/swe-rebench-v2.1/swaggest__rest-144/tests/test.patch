+
+	// ETag is a canonical HTTP header name, its canonical form is "Etag".
+	// Header names must be matched case-insensitively, so a value provided under
+	// the canonical "Etag" name must be validated against the "ETag" schema.
+	assert.NoError(t, validator.ValidateData(rest.ParamInHeader, map[string]interface{}{
+		"Etag": "abc",
+	}))
+	assert.Error(t, validator.ValidateData(rest.ParamInHeader, map[string]interface{}{
+		"Etag": "abcd", // maxLength:"3" violated.
+	}))
+}
+
+func TestResponseValidator_HeaderCaseInsensitive(t *testing.T) {
+	type output struct {
+		ETag string `header:"ETag" json:"-" required:"true"`
+		Name string `json:"name"`
+	}
+
+	validator := jsonschema.NewFactory(&openapi.Collector{}, &openapi.Collector{}).
+		MakeResponseValidator(http.StatusOK, "application/json", new(output), nil)
+
+	e := response.Encoder{}
+	ht := rest.HandlerTrait{
+		SuccessContentType: "application/json",
+		RespValidator:      validator,
+	}
+	e.SetupOutput(output{}, &ht)
+
+	r, err := http.NewRequest(http.MethodGet, "/", nil)
+	require.NoError(t, err)
+
+	w := httptest.NewRecorder()
+	out := e.MakeOutput(w, ht).(*output)
+	out.ETag = "abc"
+	out.Name = "John"
+
+	e.WriteSuccessfulResponse(w, r, out, ht)
+
+	assert.Equal(t, http.StatusOK, w.Code)
+	assert.Equal(t, "abc", w.Header().Get("ETag"))
 }
 
