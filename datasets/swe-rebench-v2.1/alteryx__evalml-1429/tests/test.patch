+def test_core_requirements_not_in_installed_package(current_dir, tmp_path):
+    repo_root = os.path.abspath(os.path.join(current_dir, '..', '..', '..'))
+    src = str(tmp_path / 'src')
+    shutil.copytree(
+        repo_root, src,
+        ignore=shutil.ignore_patterns('.git', 'build', '*.egg-info', '__pycache__', 'docs'))
+    dist_dir = str(tmp_path / 'dist')
+    os.makedirs(dist_dir, exist_ok=True)
+    result = subprocess.run(
+        [sys.executable, 'setup.py', 'bdist_wheel', '--dist-dir', dist_dir],
+        cwd=src, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+    assert result.returncode == 0, result.stdout.decode()
+    wheels = glob.glob(os.path.join(dist_dir, '*.whl'))
+    assert wheels, "Expected setup.py to build a wheel"
+    with zipfile.ZipFile(wheels[0]) as wheel:
+        names = wheel.namelist()
+    assert not any(os.path.basename(name) == 'core-requirements.txt' for name in names)
