+
+#[test]
+fn validation_errors_can_be_deserialized() {
+    let mut errors = ValidationErrors::new();
+    errors.add("field", ValidationError::new("code"));
+
+    let serialized = serde_json::to_string(&errors).unwrap();
+    let deserialized: ValidationErrors = serde_json::from_str(&serialized).unwrap();
+
+    assert_eq!(errors, deserialized);
+}
+
+#[test]
+fn validation_errors_can_be_deserialized_with_nested_errors() {
+    #[derive(Validate)]
+    struct Child {
+        #[validate(length(min = 5))]
+        value: String,
+    }
+
+    #[derive(Validate)]
+    struct Parent {
+        #[validate(nested)]
+        child: Child,
+    }
+
+    let errors = Parent { child: Child { value: "bad".to_owned() } }.validate().unwrap_err();
+    let serialized = serde_json::to_string(&errors).unwrap();
+    let deserialized: ValidationErrors = serde_json::from_str(&serialized).unwrap();
+
+    assert_eq!(errors, deserialized);
+}
+
+#[test]
+fn validation_errors_map_is_cow_keyed() {
+    let mut errors = ValidationErrors::new();
+    errors.add("field", ValidationError::new("code"));
+
+    assert!(errors.errors().contains_key("field"));
+
+    let map = errors.into_errors();
+    assert!(map.contains_key("field"));
+}
+
+#[test]
+fn field_errors_excludes_nested_errors() {
+    #[derive(Validate)]
+    struct Child {
+        #[validate(length(min = 5))]
+        value: String,
+    }
+
+    #[derive(Validate)]
+    struct Parent {
+        #[validate(length(min = 5))]
+        field: String,
+        #[validate(nested)]
+        child: Child,
+    }
+
+    let errors = Parent {
+        field: "bad".to_owned(),
+        child: Child { value: "bad".to_owned() },
+    }
+    .validate()
+    .unwrap_err();
+
+    let field_errors = errors.field_errors();
+    assert!(field_errors.contains_key("field"));
+    assert!(!field_errors.contains_key("child"));
+}
