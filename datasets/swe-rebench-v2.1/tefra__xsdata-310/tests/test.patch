 class NodeParserTests(TestCase):
+    def test_parse_any_type_element_with_matching_xsi_type(self):
+        @dataclass
+        class Container:
+            item: object = field(metadata={"type": "Element"})
+
+        source = BytesIO(
+            b'<Container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">'
+            b'<item xsi:type="Foo"><a>1</a><b>2</b><c>3</c></item>'
+            b'</Container>'
+        )
+
+        result = XmlParser().parse(source, Container)
+
+        self.assertEqual(Foo(1, 2, 3), result.item)
+
+    def test_parse_any_type_list_items_with_matching_xsi_type(self):
+        @dataclass
+        class Container:
+            items: List[object] = field(
+                default_factory=list, metadata={"type": "Element"}
+            )
+
+        source = BytesIO(
+            b'<Container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">'
+            b'<items xsi:type="Foo"><a>1</a><b>2</b><c>3</c></items>'
+            b'<items xsi:type="Foo"><a>4</a><b>5</b><c>6</c></items>'
+            b'</Container>'
+        )
+
+        result = XmlParser().parse(source, Container)
+
+        self.assertEqual([Foo(1, 2, 3), Foo(4, 5, 6)], result.items)
+
+    def test_parse_any_type_element_with_prefixed_xsi_type(self):
+        @dataclass
+        class Container:
+            item: object = field(metadata={"type": "Element"})
+
+        source = BytesIO(
+            b'<Container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"'
+            b' xmlns:api="http://tempuri.org/">'
+            b'<item xsi:type="api:Add"><api:intA>1</api:intA>'
+            b'<api:intB>2</api:intB></item>'
+            b'</Container>'
+        )
+
+        result = XmlParser().parse(source, Container)
+
+        self.assertEqual(Add(int_a=1, int_b=2), result.item)
+
+    def test_parse_any_type_list_items_with_prefixed_xsi_type(self):
+        @dataclass
+        class Container:
+            items: List[object] = field(
+                default_factory=list, metadata={"type": "Element"}
+            )
+
+        source = BytesIO(
+            b'<Container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"'
+            b' xmlns:api="http://tempuri.org/">'
+            b'<items xsi:type="api:Add"><api:intA>1</api:intA>'
+            b'<api:intB>2</api:intB></items>'
+            b'<items xsi:type="api:Add"><api:intA>3</api:intA>'
+            b'<api:intB>4</api:intB></items>'
+            b'</Container>'
+        )
+
+        result = XmlParser().parse(source, Container)
+
+        self.assertEqual(
+            [Add(int_a=1, int_b=2), Add(int_a=3, int_b=4)], result.items
+        )
