+    def test_multiprocessing_value_does_not_return_truncated_pickle(self):
+        import multiprocessing
+        import pickletools
+
+        value = multiprocessing.Value('i')
+        try:
+            serialized = cloudpickle.dumps(value)
+        except Exception:
+            return
+
+        # A successful serialization must be a complete pickle stream.
+        list(pickletools.genops(serialized))
