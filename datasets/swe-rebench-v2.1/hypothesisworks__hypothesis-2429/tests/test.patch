+def test_none_valued_parameters_use_a_consistent_annotation_policy():
+    annotations = complex_numbers.__annotations__
+    parameters = ("min_magnitude", "max_magnitude", "allow_infinity", "allow_nan")
+    explicitly_optional = [
+        type(None) in getattr(annotations[name], "__args__", ()) for name in parameters
+    ]
+    assert all(explicitly_optional) or not any(explicitly_optional)
+
+
 def test_minimal_min_magnitude_none():
     assert minimal(complex_numbers(min_magnitude=None), lambda x: True) == 0
 
