diff --git a/tests/test_reinstall.py b/tests/test_reinstall.py
index 38f013f..c501745 100644
--- a/tests/test_reinstall.py
+++ b/tests/test_reinstall.py
@@ -54,3 +54,18 @@ def test_reinstall_specifier(pipx_temp_env, capsys):
     assert not run_pipx_cli(["reinstall", "--python", sys.executable, "pylint"])
     captured = capsys.readouterr()
     assert "installed package pylint 2.3.1" in captured.out
+
+
+def test_reinstall_with_path_keeps_directory(pipx_temp_env, capsys, tmp_path_factory):
+    # Keep the path free of underscores/dots so that pipx's name canonicalisation
+    # does not redirect the argument to a different location.
+    source = tmp_path_factory.mktemp("localsource") / "project"
+    source.mkdir()
+    marker = source / "marker.txt"
+    marker.write_text("keep me")
+
+    run_pipx_cli(["reinstall", str(source)])
+    capsys.readouterr()
+
+    assert source.is_dir()
+    assert marker.read_text() == "keep me"
