+function makeTempDir() {
+  return fs.mkdtempSync(path.join(os.tmpdir(), 'ember-intl-'));
+}
+
+function writeTranslation(dir, locale, value) {
+  fs.mkdirSync(dir, { recursive: true });
+  fs.writeFileSync(path.join(dir, `${locale}.json`), JSON.stringify(value));
+}
+
+describe('translation precedence', function() {
+  let appRoot;
+  let addonRoot;
+
+  beforeEach(function() {
+    appRoot = makeTempDir();
+    addonRoot = makeTempDir();
+  });
+
+  afterEach(function() {
+    fs.rmSync(appRoot, { recursive: true, force: true });
+    fs.rmSync(addonRoot, { recursive: true, force: true });
+  });
+
+  it('application translations override addon translations', async function() {
+    writeTranslation(path.join(appRoot, 'translations'), 'en-us', { greet: 'from-app' });
+    writeTranslation(path.join(addonRoot, 'translations'), 'en-us', { greet: 'from-addon', addonOnly: 'preserved' });
+
+    const project = {
+      root: appRoot,
+      addons: [{ root: addonRoot, name: 'zzzz', addons: [] }]
+    };
+
+    const context = {
+      project,
+      opts: { inputPath: 'translations', outputPath: '.', requiresTranslation: () => true },
+      treeGenerator: p => new WatchedDir(p),
+      isSilent: true
+    };
+    const reducer = addon.generateTranslationTree.call(context, {
+      filename: key => `${key}.json`,
+      wrapEntry: obj => JSON.stringify(obj)
     });
+    const builder = createBuilder(reducer);
+
+    try {
+      await builder.build();
+
+      const output = builder.read();
+      const translations = JSON.parse(output['en-us.json']);
+
+      expect(translations.greet).to.equal('from-app');
+      expect(translations.addonOnly).to.equal('preserved');
+    } finally {
+      await builder.dispose();
+    }
   });
 });
