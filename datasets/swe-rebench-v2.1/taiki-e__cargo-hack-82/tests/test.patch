+fn assert_grouped_features(args: &[&str], groups: &[&[&str]]) {
+    let mut command = cargo_hack(args);
+    let output = command.test_dir("tests/fixtures/real").output().unwrap();
+    assert!(output.status.success());
+
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    let feature_sets = stderr
+        .lines()
+        .filter_map(|line| {
+            let command = line.split_once('`')?.1.split_once('`')?.0;
+            let mut words = command.split_whitespace();
+            let mut features = Vec::new();
+            while let Some(word) = words.next() {
+                let value = if word == "--features" {
+                    words.next()
+                } else {
+                    word.strip_prefix("--features=")
+                };
+                if let Some(value) = value {
+                    features.extend(value.split(',').map(str::to_owned));
+                }
+            }
+            (!features.is_empty()).then_some(features)
+        })
+        .collect::<Vec<_>>();
+
+    for group in groups {
+        assert!(
+            feature_sets.iter().any(|features| {
+                group.iter().all(|feature| features.iter().any(|enabled| enabled == feature))
+            }),
+            "no powerset run enabled group {:?} together; stderr: {}",
+            group,
+            stderr,
+        );
+        for feature in *group {
+            assert!(
+                !feature_sets.iter().any(|features| features.len() == 1 && features[0] == *feature),
+                "feature {:?} was enabled independently; stderr: {}",
+                feature,
+                stderr,
+            );
+        }
+    }
+}
+
+#[test]
+fn powerset_grouped_feature_behavior() {
+    assert_grouped_features(
+        &["check", "--feature-powerset", "--group-features", "a,b"],
+        &[&["a", "b"]],
+    );
+
+    // --group-features is also a valid selector for --ignore-unknown-features.
+    assert_grouped_features(
+        &[
+            "check",
+            "--feature-powerset",
+            "--ignore-unknown-features",
+            "--group-features",
+            "a,b",
+        ],
+        &[&["a", "b"]],
+    );
+
+    // Space-separated group
+    assert_grouped_features(
+        &["check", "--feature-powerset", "--group-features", "a b"],
+        &[&["a", "b"]],
+    );
+
+    assert_grouped_features(
+        &["check", "--feature-powerset", "--group-features", "a,b,c"],
+        &[&["a", "b", "c"]],
+    );
+
+    // Each occurrence contributes a separate group; overlap behavior is not constrained.
+    assert_grouped_features(
+        &[
+            "check",
+            "--feature-powerset",
+            "--group-features",
+            "a,b",
+            "--group-features",
+            "a,c",
+        ],
+        &[&["a", "b"], &["a", "c"]],
+    );
+}
