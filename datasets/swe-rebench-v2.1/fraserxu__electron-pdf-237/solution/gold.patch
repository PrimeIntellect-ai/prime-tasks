   _loadURL (window, url) {
-    const loadOpts = {}
-    loadOpts.extraHeaders = ''
-    if (this.args.acceptLanguage) {
-      loadOpts.extraHeaders += `Accept-Language: ${this.args.acceptLanguage}\n`
-    }
-    if (this.args.disableCache) {
-      loadOpts.extraHeaders += 'pragma: no-cache\n'
+    const loadOpts = {
+      extraHeaders: _.join(this._getHeaders(), '\n')
     }
     this.emit(`${RENDER_EVENT_PREFIX}loadurl`, { url: url })
     window.loadURL(wargs.urlWithArgs(url, null), loadOpts)
   }
 
+  _getHeaders () {
+    const headers = []
+    this.args.acceptLanguage && headers.push(`Accept-Language: ${this.args.acceptLanguage}`)
+    this.args.disableCache && headers.push('pragma: no-cache')
+    // Request headers to pass through
+    if (this.args.requestHeaders) {
+      _.each(JSON.parse(this.args.requestHeaders), (v, k) => headers.push(`${k}: ${v}`))
+    }
+    return headers
+  }
+
