+// Header forwarding
+function outgoingHeaderLines (jobArgs) {
+  // Run a real export and capture the options handed to the window's loadURL
+  const exportJob = new ExportJob(['https://example.test'], 'output.pdf', _.extend({ pageSize: 'Letter' }, jobArgs), options)
+  let loadOptions
+  const fakeWindow = {
+    id: 1,
+    webContents: {
+      on () {},
+      removeAllListeners () {},
+      session: { cookies: { set () {} } }
+    },
+    getSize: () => [0, 0],
+    setSize () {},
+    close () {},
+    loadURL (url, opts) {
+      loadOptions = opts
+    }
+  }
+  exportJob._launchBrowserWindow = () => {
+    exportJob.window = fakeWindow
+  }
+  exportJob.render()
+  return (loadOptions.extraHeaders || '').split('\n').filter(Boolean)
+}
+
+test('custom request headers are sent with the request', t => {
+  const lines = outgoingHeaderLines({ requestHeaders: '{"H1": "V1", "H2": "V2"}' })
+  t.true(lines.includes('H1: V1'))
+  t.true(lines.includes('H2: V2'))
+})
+
+test('acceptLanguage is sent as an Accept-Language request header', t => {
+  const lines = outgoingHeaderLines({ acceptLanguage: 'en' })
+  t.true(lines.includes('Accept-Language: en'))
+})
+
+test('disableCache sends a pragma no-cache request header', t => {
+  const lines = outgoingHeaderLines({ disableCache: true })
+  t.true(lines.includes('pragma: no-cache'))
+})
+
+test('request headers retain the required source ordering', t => {
+  const lines = outgoingHeaderLines({
+    acceptLanguage: 'en',
+    disableCache: true,
+    requestHeaders: '{"H1": "V1", "H2": "V2"}'
+  })
+  t.is(lines[0], 'Accept-Language: en')
+  t.is(lines[1], 'pragma: no-cache')
+  t.true(lines.indexOf('H1: V1') > 1)
+  t.true(lines.indexOf('H2: V2') > 1)
+})
+
+test('no additional request headers are sent when none are supplied', t => {
+  t.deepEqual(outgoingHeaderLines({}), [])
+})
+
+// CLI Option Tests
+test('requestHeaders option is parsed from --requestHeaders', t => {
+  const parsed = minimist(['--requestHeaders', '{"H1": "V1"}'], argOptions)
+  t.is(parsed.requestHeaders, '{"H1": "V1"}')
+})
+
+test('requestHeaders option is parsed from -r', t => {
+  const parsed = minimist(['-r', '{"H1": "V1"}'], argOptions)
+  t.is(parsed.requestHeaders, '{"H1": "V1"}')
+})
+
+test('requestHeaders parsed from the CLI is used to build headers', t => {
+  const parsed = minimist(['--requestHeaders', '{"H1": "V1"}'], argOptions)
+  const lines = outgoingHeaderLines(parsed)
+  t.true(lines.includes('H1: V1'))
+})
+
