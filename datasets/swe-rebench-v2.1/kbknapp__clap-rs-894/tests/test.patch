+
+#[test]
+fn customize_version_and_help() {
+    let mut app = App::new("customize")
+        .version("0.1")
+        .author("Nobody <odysseus@example.com>")
+        .about("You can customize the version and help text")
+        .help_message("Show command usage")
+        .version_message("Display release version");
+
+    let _ = app.get_matches_from_safe_borrow(vec!["customize"]);
+    let mut help_buffer = Vec::new();
+    app.write_help(&mut help_buffer).unwrap();
+    let help_output = String::from_utf8(help_buffer).unwrap();
+
+    assert!(help_output.contains("Show command usage"));
+    assert!(help_output.contains("Display release version"));
+}
