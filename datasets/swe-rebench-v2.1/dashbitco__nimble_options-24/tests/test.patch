diff --git a/test/nimble_options_test.exs b/test/nimble_options_test.exs
index 279c75b..5ca6b40 100644
--- a/test/nimble_options_test.exs
+++ b/test/nimble_options_test.exs
@@ -873,6 +873,54 @@ defmodule NimbleOptionsTest do
 
       assert NimbleOptions.docs(schema) == docs
     end
+
+    test "the option doesn't appear in the documentation when the :doc option is false" do
+      schema = [
+        name: [type: :atom, doc: "An atom."],
+        secret: [type: :string, doc: false],
+        count: [type: :integer]
+      ]
+
+      docs = """
+        * `:name` - An atom.
+
+        * `:count`
+
+      """
+
+      assert NimbleOptions.docs(schema) == docs
+    end
+
+    test "the option and its children don't appear in the documentation when the :doc option is false" do
+      schema = [
+        producer: [
+          type: :keyword_list,
+          doc: false,
+          keys: [
+            name: [type: :atom],
+            concurrency: [type: :pos_integer]
+          ]
+        ]
+      ]
+
+      docs = """
+      """
+
+      assert NimbleOptions.docs(schema) == docs
+    end
+
+    test "options with doc: false are still validated" do
+      schema = [
+        name: [type: :atom, doc: "An atom."],
+        secret: [type: :string, doc: false]
+      ]
+
+      assert NimbleOptions.validate([name: :foo, secret: "bar"], schema) ==
+               {:ok, [name: :foo, secret: "bar"]}
+
+      assert NimbleOptions.validate([name: :foo, secret: 123], schema) ==
+               {:error, "expected :secret to be an string, got: 123"}
+    end
   end
 
