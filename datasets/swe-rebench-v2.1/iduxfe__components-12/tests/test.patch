+import { ButtonMode, ComponentSize } from '@idux/components/core/types'
+import { mount } from '@vue/test-utils'
+import { PropType } from 'vue'
+import ts from 'typescript'
+import ButtonGroup from '../src/ButtonGroup.vue'
+import Button from '../src/Button.vue'
+import { ButtonGroupProps, ButtonShape } from '../src/types'
+
+const TestComponent = {
+  components: { ButtonGroup, Button },
+  template: `
+  <ButtonGroup :mode="mode" :size="size" :shape="shape">
+    <Button>default</Button>
+    <Button mode="primary">primary</Button>
+    <Button size="large">large</Button>
+    <Button shape="circle">circle</Button>
+  </ButtonGroup>
+  `,
+  props: {
+    mode: String as PropType<ButtonMode>,
+    size: String as PropType<ComponentSize>,
+    shape: String as PropType<ButtonShape>,
+  },
+}
+
+const groupProps: ButtonGroupProps = { mode: 'dashed', size: 'small', shape: 'round' }
+
+describe('ButtonGroup.vue', () => {
+  test('renders its wrapper and contained content', () => {
+    const wrapper = mount(TestComponent)
+    expect(wrapper.element.tagName).toBe('DIV')
+    expect(wrapper.classes()).toContain('ix-button-group')
+    expect(wrapper.findAll('.ix-button').length).toBe(4)
+    expect(wrapper.text()).toContain('default')
+    expect(wrapper.text()).toContain('primary')
+  })
+
+  test('accepts mode, size, and shape group settings', () => {
+    const wrapper = mount(TestComponent, { props: groupProps })
+    const buttonWithoutOverrides = wrapper.find('.ix-button')
+    expect(buttonWithoutOverrides.classes()).toContain('ix-button-dashed')
+    expect(buttonWithoutOverrides.classes()).toContain('ix-button-small')
+    expect(buttonWithoutOverrides.classes()).toContain('ix-button-round')
+  })
+
+  test('declares the group props and supported button shapes', () => {
+    const virtualFile = `${process.cwd()}/packages/components/button/__tests__/buttonGroup.contract.ts`
+    const source = `
+      import { ButtonGroupProps, ButtonShape } from '../src/types'
+      const props: ButtonGroupProps = { mode: 'primary', size: 'large', shape: 'circle' }
+      const mode: ButtonGroupProps['mode'] = props.mode
+      const size: ButtonGroupProps['size'] = props.size
+      const shape: ButtonGroupProps['shape'] = props.shape
+      const round: ButtonShape = 'round'
+      // @ts-expect-error unsupported button shapes must not be accepted
+      const invalid: ButtonShape = 'square'
+      void [mode, size, shape, round, invalid]
+    `
+    const options: ts.CompilerOptions = {
+      baseUrl: process.cwd(),
+      module: ts.ModuleKind.CommonJS,
+      moduleResolution: ts.ModuleResolutionKind.NodeJs,
+      noEmit: true,
+      paths: { '@idux/*': ['packages/*'] },
+      skipLibCheck: true,
+      strict: true,
+      target: ts.ScriptTarget.ES2015,
+      types: [],
+    }
+    const host = ts.createCompilerHost(options)
+    const getSourceFile = host.getSourceFile.bind(host)
+    const fileExists = host.fileExists.bind(host)
+    const readFile = host.readFile.bind(host)
+    host.getSourceFile = (fileName, languageVersion, onError, shouldCreateNewSourceFile) =>
+      fileName === virtualFile
+        ? ts.createSourceFile(fileName, source, languageVersion, true)
+        : getSourceFile(fileName, languageVersion, onError, shouldCreateNewSourceFile)
+    host.fileExists = fileName => fileName === virtualFile || fileExists(fileName)
+    host.readFile = fileName => fileName === virtualFile ? source : readFile(fileName)
+
+    const program = ts.createProgram([virtualFile], options, host)
+    const diagnostics = ts.getPreEmitDiagnostics(program).map(diagnostic =>
+      ts.flattenDiagnosticMessageText(diagnostic.messageText, '\n'),
+    )
+    expect(diagnostics).toEqual([])
+  })
+
+  test('mode work', async () => {
+    const wrapper = mount(TestComponent)
+
+    await wrapper.setProps({ mode: 'dashed' })
+
+    expect(wrapper.find('.ix-button').classes()).toContain('ix-button-dashed')
+  })
+
+  test('size work', async () => {
+    const wrapper = mount(TestComponent)
+
+    await wrapper.setProps({ size: 'small' })
+
+    expect(wrapper.find('.ix-button').classes()).toContain('ix-button-small')
+  })
+
+  test('shape work', async () => {
+    const wrapper = mount(TestComponent)
+
+    await wrapper.setProps({ shape: 'round' })
+
+    expect(wrapper.find('.ix-button').classes()).toContain('ix-button-round')
+  })
+})
