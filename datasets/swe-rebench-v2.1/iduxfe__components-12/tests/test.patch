+import { mount, MountingOptions, VueWrapper } from '@vue/test-utils'
+import { DefineComponent, defineComponent, h } from 'vue'
+import ts from 'typescript'
+import { useGlobalConfig } from '@idux/components/core/config'
+import Button from '../src/Button.vue'
+import { ButtonProps } from '../src/types'
+
+describe('Button.vue', () => {
+  let buttonMount: (
+    options?: MountingOptions<Partial<ButtonProps>>,
+  ) => VueWrapper<InstanceType<DefineComponent<ButtonProps>>>
+
+  beforeEach(() => {
+    buttonMount = (options = {}) => {
+      return mount<ButtonProps>(Button, {
+        ...options,
+      })
+    }
+  })
+
+  test('render work', () => {
+    const wrapper = buttonMount()
+    expect(wrapper.classes()).toContain('ix-button')
+    expect(wrapper.element.tagName).toEqual('BUTTON')
+  })
+
+  test('declares ButtonProps fields with their documented value domains', () => {
+    const virtualFile = `${process.cwd()}/packages/components/button/__tests__/button.contract.ts`
+    const source = `
+      import { ButtonProps } from '../src/types'
+      const props: ButtonProps = {
+        mode: 'primary', danger: true, ghost: false, disabled: false,
+        loading: false, size: 'large', shape: 'circle', block: true, icon: 'star',
+      }
+      const mode: ButtonProps['mode'] = 'link'
+      const size: ButtonProps['size'] = 'small'
+      const shape: ButtonProps['shape'] = 'round'
+      const danger: ButtonProps['danger'] = true
+      const ghost: ButtonProps['ghost'] = true
+      const disabled: ButtonProps['disabled'] = true
+      const loading: ButtonProps['loading'] = true
+      const block: ButtonProps['block'] = true
+      const icon: ButtonProps['icon'] = 'star'
+      // @ts-expect-error unsupported button modes are not part of the API
+      const badMode: ButtonProps['mode'] = 'secondary'
+      // @ts-expect-error unsupported sizes are not part of the API
+      const badSize: ButtonProps['size'] = 'tiny'
+      // @ts-expect-error unsupported shapes are not part of the API
+      const badShape: ButtonProps['shape'] = 'square'
+      // @ts-expect-error state properties are boolean
+      const badDanger: ButtonProps['danger'] = 'yes'
+      // @ts-expect-error icon names are strings
+      const badIcon: ButtonProps['icon'] = true
+      void [props, mode, size, shape, danger, ghost, disabled, loading, block, icon,
+        badMode, badSize, badShape, badDanger, badIcon]
+    `
+    const options: ts.CompilerOptions = {
+      baseUrl: process.cwd(),
+      module: ts.ModuleKind.CommonJS,
+      moduleResolution: ts.ModuleResolutionKind.NodeJs,
+      noEmit: true,
+      paths: { '@idux/*': ['packages/*'] },
+      skipLibCheck: true,
+      strict: true,
+      target: ts.ScriptTarget.ES2015,
+      types: [],
+    }
+    const host = ts.createCompilerHost(options)
+    const getSourceFile = host.getSourceFile.bind(host)
+    const fileExists = host.fileExists.bind(host)
+    const readFile = host.readFile.bind(host)
+    host.getSourceFile = (fileName, languageVersion, onError, shouldCreateNewSourceFile) =>
+      fileName === virtualFile
+        ? ts.createSourceFile(fileName, source, languageVersion, true)
+        : getSourceFile(fileName, languageVersion, onError, shouldCreateNewSourceFile)
+    host.fileExists = fileName => fileName === virtualFile || fileExists(fileName)
+    host.readFile = fileName => fileName === virtualFile ? source : readFile(fileName)
+
+    const program = ts.createProgram([virtualFile], options, host)
+    const diagnostics = ts.getPreEmitDiagnostics(program).map(diagnostic =>
+      ts.flattenDiagnosticMessageText(diagnostic.messageText, '\n'),
+    )
+    expect(diagnostics).toEqual([])
+  })
+
+  test('uses global button mode and size when no props override them', () => {
+    const ConfiguredButton = defineComponent({
+      setup() {
+        useGlobalConfig('button', { mode: 'primary', size: 'large' })
+        return () => h(Button)
+      },
+    })
+    const wrapper = mount(ConfiguredButton)
+    const button = wrapper.find('.ix-button')
+
+    expect(button.classes()).toContain('ix-button-primary')
+    expect(button.classes()).toContain('ix-button-large')
+  })
+
+  test('uses the documented default mode and size', () => {
+    const wrapper = buttonMount()
+
+    expect(wrapper.classes()).toContain('ix-button')
+    expect(wrapper.classes()).not.toContain('ix-button-primary')
+    expect(wrapper.classes()).not.toContain('ix-button-dashed')
+    expect(wrapper.classes()).not.toContain('ix-button-text')
+    expect(wrapper.classes()).not.toContain('ix-button-link')
+    expect(wrapper.classes()).not.toContain('ix-button-large')
+    expect(wrapper.classes()).not.toContain('ix-button-small')
+  })
+
+  test('mode work', async () => {
+    const wrapper = buttonMount({ props: { mode: 'primary' } })
+
+    expect(wrapper.classes()).toContain('ix-button-primary')
+    expect(wrapper.element.tagName).toEqual('BUTTON')
+
+    await wrapper.setProps({ mode: 'dashed' })
+
+    expect(wrapper.classes()).toContain('ix-button-dashed')
+    expect(wrapper.element.tagName).toEqual('BUTTON')
+
+    await wrapper.setProps({ mode: 'link' })
+
+    expect(wrapper.classes()).toContain('ix-button-link')
+    expect(wrapper.element.tagName).toEqual('A')
+  })
+
+  test('danger work', async () => {
+    const wrapper = buttonMount()
+
+    expect(wrapper.classes()).not.toContain('ix-button-danger')
+
+    await wrapper.setProps({ danger: true })
+
+    expect(wrapper.classes()).toContain('ix-button-danger')
+  })
+
+  test('ghost work', async () => {
+    const wrapper = buttonMount()
+
+    expect(wrapper.classes()).not.toContain('ix-button-ghost')
+
+    await wrapper.setProps({ ghost: true })
+
+    expect(wrapper.classes()).toContain('ix-button-ghost')
+  })
+
+  test('disabled work', async () => {
+    const wrapper = buttonMount({ props: { mode: 'primary' } })
+
+    expect(wrapper.classes()).not.toContain('ix-button-disabled')
+
+    await wrapper.setProps({ disabled: true })
+
+    expect(wrapper.classes()).toContain('ix-button-disabled')
+  })
+
+  test('disabled attribute work', async () => {
+    const wrapper = buttonMount()
+
+    expect(wrapper.attributes('disabled')).toBeUndefined()
+
+    await wrapper.setProps({ disabled: true })
+
+    expect(wrapper.attributes('disabled')).toBeDefined()
+
+    await wrapper.setProps({ disabled: false, loading: true })
+
+    expect(wrapper.attributes('disabled')).toBeDefined()
+  })
+
+  test('loading work', async () => {
+    const wrapper = buttonMount({ props: { icon: 'up' } })
+
+    expect(wrapper.find('.ix-icon-up').exists()).toBeTruthy()
+    expect(wrapper.find('.ix-icon-loading').exists()).toBeFalsy()
+    expect(wrapper.classes()).not.toContain('ix-button-loading')
+
+    await wrapper.setProps({ loading: true })
+
+    expect(wrapper.find('.ix-icon-up').exists()).toBeFalsy()
+    expect(wrapper.find('.ix-icon-loading').exists()).toBeTruthy()
+    expect(wrapper.classes()).toContain('ix-button-loading')
+  })
+
+  test('size work', async () => {
+    const wrapper = buttonMount({ props: { size: 'large' } })
+
+    expect(wrapper.classes()).toContain('ix-button-large')
+
+    await wrapper.setProps({ size: 'small' })
+
+    expect(wrapper.classes()).not.toContain('ix-button-large')
+    expect(wrapper.classes()).toContain('ix-button-small')
+  })
+
+  test('shape work', async () => {
+    const wrapper = buttonMount({ props: { shape: 'circle' } })
+
+    expect(wrapper.classes()).toContain('ix-button-circle')
+
+    await wrapper.setProps({ shape: 'round' })
+
+    expect(wrapper.classes()).not.toContain('ix-button-circle')
+    expect(wrapper.classes()).toContain('ix-button-round')
+  })
+
+  test('block work', async () => {
+    const wrapper = buttonMount()
+
+    expect(wrapper.classes()).not.toContain('ix-button-block')
+
+    await wrapper.setProps({ block: true })
+
+    expect(wrapper.classes()).toContain('ix-button-block')
+  })
+
+  test('icon work', async () => {
+    const wrapper = buttonMount({ props: { icon: 'up' } })
+
+    expect(wrapper.find('.ix-icon-up').exists()).toBeTruthy()
+
+    await wrapper.setProps({ icon: 'down' })
+
+    expect(wrapper.find('.ix-icon-down').exists()).toBeTruthy()
+  })
+
+  test('slot work', async () => {
+    const text = 'Button'
+    const wrapper = buttonMount({
+      slots: {
+        default: text,
+      },
+    })
+    expect(wrapper.text()).toEqual(text)
+  })
+
+  test('native button attributes work', () => {
+    const wrapper = buttonMount({ attrs: { type: 'submit', name: 'foo' } })
+
+    expect(wrapper.attributes('type')).toEqual('submit')
+    expect(wrapper.attributes('name')).toEqual('foo')
+  })
+
+  test('native anchor attributes work', () => {
+    const wrapper = buttonMount({
+      props: { mode: 'link' },
+      attrs: { href: 'https://example.com', target: '_blank' },
+    })
+
+    expect(wrapper.element.tagName).toEqual('A')
+    expect(wrapper.attributes('href')).toEqual('https://example.com')
+    expect(wrapper.attributes('target')).toEqual('_blank')
+  })
+
+  test('slot renders after icon', () => {
+    const wrapper = buttonMount({ props: { icon: 'up' }, slots: { default: 'Hello' } })
+
+    const html = wrapper.html()
+    expect(html).toContain('ix-icon-up')
+    expect(html).toContain('Hello')
+    expect(html.indexOf('ix-icon-up')).toBeLessThan(html.indexOf('Hello'))
+  })
+})
