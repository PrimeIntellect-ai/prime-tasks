diff --git a/tests/testthat/test-board-rsconnect.R b/tests/testthat/test-board-rsconnect.R
index dd15c8d..e9e1b85 100644
--- a/tests/testthat/test-board-rsconnect.R
+++ b/tests/testthat/test-board-rsconnect.R
@@ -35,3 +35,29 @@ if (test_board_is_registered("rsconnect")) {
     })
   }
 }
+
+test_that("pin creation uses user-supplied html for the Connect page", {
+  html_path <- tempfile(fileext = ".html")
+  writeLines("<html><body>Custom pin page</body></html>", html_path)
+  withr::local_options(list(RSCONNECT_HTML_PATH = html_path))
+
+  output_dir <- tempfile()
+  dir.create(output_dir)
+  withr::local_dir(output_dir)
+
+  board_name <- paste0("rsconnect-html-", Sys.getpid())
+  board_register(
+    "rsconnect",
+    name = board_name,
+    cache = tempfile(),
+    output_files = TRUE
+  )
+  on.exit(board_deregister(board_name), add = TRUE)
+
+  pin(data.frame(value = 1), "sample", board = board_name)
+
+  expect_identical(
+    readLines(file.path("sample", "index.html")),
+    "<html><body>Custom pin page</body></html>"
+  )
+})
