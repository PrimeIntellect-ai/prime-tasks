 import pytest  # type: ignore
 
@@ -128,3 +133,36 @@ def test_list_short(pipx_temp_env, monkeypatch, capsys):
 
     assert "pycowsay 0.0.0.2" in captured.out
     assert "pylint 2.3.1" in captured.out
+
+
+def test_skip_maintenance(pipx_temp_env):
+    assert not run_pipx_cli(["install", PKG["pycowsay"]["spec"]])
+    assert not run_pipx_cli(["install", PKG["pylint"]["spec"]])
+
+    shared_pip = constants.PIPX_SHARED_LIBS / ("Scripts" if constants.WINDOWS else "bin")
+    shared_pip /= "pip.exe" if constants.WINDOWS else "pip"
+    stale_time = time.time() - 31 * 24 * 60 * 60
+    os.utime(shared_pip, (stale_time, stale_time))
+    stale_mtime = shared_pip.stat().st_mtime
+
+    child_env = os.environ.copy()
+    child_env.update(
+        {
+            "PIPX_HOME": str(constants.PIPX_HOME),
+            "PIPX_SHARED_LIBS": str(constants.PIPX_SHARED_LIBS),
+            "PIPX_BIN_DIR": str(constants.LOCAL_BIN_DIR),
+            "PIPX_MAN_DIR": str(constants.LOCAL_MAN_DIR),
+            "PYTHONPATH": str(Path(__file__).resolve().parents[1] / "src"),
+        }
+    )
+    result = subprocess.run(
+        [sys.executable, "-m", "pipx", "list", "--skip-maintenance"],
+        env=child_env,
+        capture_output=True,
+        text=True,
+    )
+
+    assert result.returncode == 0
+    assert "pycowsay" in result.stdout
+    assert "pylint" in result.stdout
+    assert shared_pip.stat().st_mtime == stale_mtime
