diff --git a/Sources/JWTKit/EdDSA/OctetKeyPair.swift b/Sources/JWTKit/EdDSA/OctetKeyPair.swift
new file mode 100644
index 00000000..29e4c8f4
--- /dev/null
+++ b/Sources/JWTKit/EdDSA/OctetKeyPair.swift
@@ -0,0 +1,32 @@
+import Foundation
+
+// https://www.rfc-editor.org/rfc/rfc8037.html#appendix-A
+enum OctetKeyPair {
+    case `public`(x: Data)
+    case `private`(x: Data, d: Data)
+    
+    init(x: Data, d: Data) throws {
+        self = .`private`(x: x, d: d)
+    }
+    
+    init(x: Data) throws {
+        self = .`public`(x: x)
+    }
+    
+    var publicKey: Data {
+        switch self {
+            case .`public`(let x), .`private`(let x, _):
+                return x
+        }
+    }
+    
+    var privateKey: Data? {
+        switch self {
+            case .`private`(_ , let d):
+                return d
+                
+            case .`public`:
+                return nil
+        }
+    }
+}
