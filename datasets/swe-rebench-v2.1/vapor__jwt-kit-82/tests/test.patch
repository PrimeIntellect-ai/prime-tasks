+    func testVerifyingEdDSAKeyUsingJWKWithPublicKeyOnly() throws {
+        struct Foo: JWTPayload {
+            var bar: Int
+            func verify(using signer: JWTSigner) throws { }
+        }
+
+        // sign jwt with the private key
+        let signer = try JWTSigner.eddsa(
+            .private(x: eddsaPublicKeyBase64, d: eddsaPrivateKeyBae64, curve: .ed25519)
+        )
+        let jwt = try signer.sign(Foo(bar: 42), kid: "vapor")
+
+        // verify using a JWK that only carries the public key (no "d" member),
+        // supplied in base64 form
+        let jwksBase64 = """
+        {
+            "keys": [
+                {
+                    "kty": "OKP",
+                    "crv": "Ed25519",
+                    "use": "sig",
+                    "kid": "vapor",
+                    "x": "\(eddsaPublicKeyBase64)"
+                }
+            ]
+        }
+        """
+
+        let base64Signers = JWTSigners()
+        try base64Signers.use(jwksJSON: jwksBase64)
+        XCTAssertEqual(try base64Signers.verify(jwt, as: Foo.self).bar, 42)
+
+        // verify using a public-only JWK supplied in base64url form
+        let jwksBase64URL = """
+        {
+            "keys": [
+                {
+                    "kty": "OKP",
+                    "crv": "Ed25519",
+                    "use": "sig",
+                    "kid": "vapor",
+                    "x": "\(eddsaPublicKeyBase64Url)"
+                }
+            ]
+        }
+        """
+
+        let base64URLSigners = JWTSigners()
+        try base64URLSigners.use(jwksJSON: jwksBase64URL)
+        XCTAssertEqual(try base64URLSigners.verify(jwt, as: Foo.self).bar, 42)
+    }
