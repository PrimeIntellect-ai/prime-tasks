+
+func TestConvertNamedVolumeCombinesExistingAndContainerSubpaths(t *testing.T) {
+	workload := &score.Workload{
+		Metadata: score.WorkloadMetadata{"name": "test"},
+		Containers: score.WorkloadContainers{
+			"backend": {
+				Image: "busybox",
+				Volumes: []score.ContainerVolumesElem{{
+					Source: "${resources.data}",
+					Target: "/mnt/data",
+					Path:   util.Ref("container/path"),
+				}},
+			},
+		},
+		Resources: map[string]score.Resource{"data": {Type: "volume"}},
+	}
+	state := &project.State{
+		Workloads: map[string]framework.ScoreWorkloadState[project.WorkloadExtras]{},
+		Resources: map[framework.ResourceUid]framework.ScoreResourceState[framework.NoExtras]{},
+	}
+	state, _ = state.WithWorkload(workload, nil, project.WorkloadExtras{})
+	state, _ = state.WithPrimedResources()
+	state.Resources["volume.default#test.data"] = framework.ScoreResourceState[framework.NoExtras]{
+		Outputs: map[string]interface{}{
+			"type":   "volume",
+			"source": "example",
+			"volume": map[string]interface{}{"subpath": "resource/path"},
+		},
+	}
+
+	converted, err := ConvertSpec(state, workload)
+	assert.NoError(t, err)
+	if assert.NotNil(t, converted) {
+		volumes := converted.Services["test-backend"].Volumes
+		if assert.Len(t, volumes, 1) && assert.NotNil(t, volumes[0].Volume) {
+			assert.Equal(t, filepath.Join("resource/path", "container/path"), volumes[0].Volume.Subpath)
+		}
+	}
+}
