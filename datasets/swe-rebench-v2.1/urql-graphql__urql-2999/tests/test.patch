@@ -314,3 +316,97 @@ describe('offline', () => {
     );
   });
 });
+
+describe('cache results', () => {
+  it('keeps loop-blocked partial results stale', () => {
+    vi.useFakeTimers();
+
+    const client = createClient({ url: 'http://0.0.0.0' });
+    const { source: operations$, next } = makeSubject<Operation>();
+    const reexecutions: Operation[] = [];
+    vi.spyOn(client, 'reexecuteOperation').mockImplementation(operation => {
+      reexecutions.push(operation);
+    });
+
+    const initialQuery = gql`
+      query {
+        todos {
+          id
+          text
+          __typename
+        }
+      }
+    `;
+    const partialQuery = gql`
+      query {
+        todos {
+          id
+          text
+          complete
+          author {
+            id
+            name
+            __typename
+          }
+          __typename
+        }
+      }
+    `;
+
+    const dependentOperation = client.createRequestOperation('query', {
+      key: 2,
+      query: partialQuery,
+      variables: undefined,
+    });
+    const initialOperation = client.createRequestOperation('query', {
+      key: 1,
+      query: initialQuery,
+      variables: undefined,
+    });
+    const initialData = {
+      __typename: 'Query',
+      todos: [
+        { __typename: 'Todo', id: '123', text: 'Learn' },
+        { __typename: 'Todo', id: '456', text: 'Teach' },
+      ],
+    };
+    const forward = (source: typeof operations$) =>
+      pipe(
+        source,
+        filter(operation => operation.key === initialOperation.key),
+        delay(1),
+        map(() => ({ operation: initialOperation, data: initialData }))
+      );
+    const results = vi.fn();
+
+    pipe(
+      cacheExchange({
+        schema: minifyIntrospectionQuery(
+          require('./test-utils/simple_schema.json')
+        ),
+      })({ forward, client, dispatchDebug })(operations$),
+      tap(results),
+      publish
+    );
+
+    // Register the more specific query before data arrives so that the initial
+    // query's cache write schedules it again. Its partial cache result is then
+    // suppressed from causing another reexecution to prevent a loop.
+    next(dependentOperation);
+    next(initialOperation);
+    vi.runAllTimers();
+    reexecutions.forEach(operation => next(operation));
+
+    const partialResult = results.mock.calls
+      .map(([result]) => result as OperationResult)
+      .find(result => result.operation.key === dependentOperation.key);
+
+    expect(partialResult?.data).toMatchObject({
+      todos: [
+        { id: '123', text: 'Learn' },
+        { id: '456', text: 'Teach' },
+      ],
+    });
+    expect(partialResult?.stale).toBe(true);
+  });
+});
