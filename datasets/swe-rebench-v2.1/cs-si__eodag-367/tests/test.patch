+class TestStacQueryFragment(unittest.TestCase):
+    """STAC API Query fragment: filter Items on arbitrary fields"""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.plugins_manager = PluginManager(load_default_config())
+
+    def _get_stac_search_plugin(self):
+        return next(
+            self.plugins_manager.get_search_plugins(
+                product_type="S2_MSI_L1C", provider="earth_search"
+            )
+        )
+
+    def test_stac_query_fragment_filters_arbitrary_extension_field(self):
+        plugin = self._get_stac_search_plugin()
+        query_params, _ = plugin.build_query_string(
+            "S2_MSI_L1C", **{"eo:cloud_cover": 10}
+        )
+        self.assertEqual(query_params["query"]["eo:cloud_cover"], {"eq": "10"})
+
+    def test_stac_query_fragment_filters_arbitrary_plain_field(self):
+        plugin = self._get_stac_search_plugin()
+        query_params, _ = plugin.build_query_string(
+            "S2_MSI_L1C", **{"cloud_cover": 10}
+        )
+        self.assertEqual(query_params["query"]["cloud_cover"], {"eq": "10"})
+
+    def test_stac_query_fragment_supports_cloud_cover_less_than(self):
+        plugin = next(
+            self.plugins_manager.get_search_plugins(
+                product_type="LANDSAT_C2L1", provider="usgs_satapi_aws"
+            )
+        )
+        query_params, _ = plugin.build_query_string("LANDSAT_C2L1", cloudCover=10)
+        self.assertEqual(query_params["query"]["eo:cloud_cover"], {"lte": 10})
