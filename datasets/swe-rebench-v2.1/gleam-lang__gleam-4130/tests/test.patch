@@ -3025,3 +3025,15 @@ pub fn main() {
         vec![("main", "fn() -> Int")]
     );
 }
+
+#[test]
+fn type_annotation_naming_private_type_of_other_module_is_rejected() {
+    let result = compile_module(
+        "main",
+        "\nimport wibble\n\ntype Wibble {\n  Wibble(wibble.Wibble)\n}\n",
+        None,
+        vec![("thepackage", "wibble", "type Wibble")],
+    );
+
+    assert!(result.is_err());
+}
