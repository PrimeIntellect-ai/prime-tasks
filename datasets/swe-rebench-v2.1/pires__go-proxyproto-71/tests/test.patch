+
+// Test that an oversized header is rejected without consuming an arbitrary stream.
+type dataSource struct {
+	data  []byte
+	NRead int
+}
+
+func (ds *dataSource) Read(b []byte) (int, error) {
+	if ds.NRead >= len(ds.data) {
+		return 0, io.EOF
+	}
+	n := copy(b, ds.data[ds.NRead:])
+	ds.NRead += n
+	return n, nil
+}
+
+func TestReadV1RejectsOverlongHeaderWithoutUnboundedRead(t *testing.T) {
+	data := append([]byte("PROXY "), bytes.Repeat([]byte(" "), 64*1024)...)
+	ds := &dataSource{data: data}
+	reader := bufio.NewReaderSize(ds, 16)
+
+	if _, err := Read(reader); err == nil {
+		t.Fatal("expected oversized header to be rejected")
+	}
+	if maxRead := 4096 + reader.Size(); ds.NRead > maxRead {
+		t.Fatalf("oversized header consumed %d bytes before rejection; expected a bounded read of at most %d bytes", ds.NRead, maxRead)
+	}
+}
