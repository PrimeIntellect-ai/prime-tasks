+package diff_test
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/google/yamlfmt/engine"
+)
+
+// staticFormatter implements the public yamlfmt.Formatter interface and always
+// returns a fixed formatted result. It lets a test observe the diff between the
+// original content and the formatted content through the engine's public
+// dry-run entry point.
+type staticFormatter struct {
+	formatted string
+}
+
+func (f *staticFormatter) Type() string { return "static" }
+
+func (f *staticFormatter) Format(content []byte) ([]byte, error) {
+	return []byte(f.formatted), nil
+}
+
+// dryRunDiff returns the diff produced by a dry run of the formatter over the
+// given original content, where the formatter produces the given formatted
+// content.
+func dryRunDiff(t *testing.T, before, after string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "input.yaml")
+	if err := os.WriteFile(path, []byte(before), 0644); err != nil {
+		t.Fatalf("failed to write input file: %v", err)
+	}
+	e := &engine.Engine{Formatter: &staticFormatter{formatted: after}}
+	out, err := e.DryRunFile(path)
+	if err != nil {
+		t.Fatalf("dry run failed: %v", err)
+	}
+	return out
+}
+
+func TestMultilineDiff(t *testing.T) {
+	testCases := []struct {
+		name          string
+		before        string
+		after         string
+		expectedLines []string
+	}{
+		{
+			name: "multiple line diff",
+			before: `this
+is
+a
+first input`,
+			after: `this
+is
+the
+second input`,
+			expectedLines: []string{"- a", "+ the", "- first input", "+ second input"},
+		},
+		{
+			name: "add blank line",
+			before: `foo
+bar`,
+			after: `foo
+
+bar`,
+			expectedLines: []string{"+ "},
+		},
+		{
+			name: "remove blank line",
+			before: `foo
+
+bar`,
+			after: `foo
+bar`,
+			expectedLines: []string{"- "},
+		},
+		{
+			name: "changed lines without requiring unchanged context",
+			before: `first
+stable
+old`,
+			after: `first
+stable
+new`,
+			expectedLines: []string{"- old", "+ new"},
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			diffStr := dryRunDiff(t, tc.before, tc.after)
+			if diffStr == "" {
+				t.Fatal("there should have been a diff")
+			}
+			assertReadableDiff(t, diffStr)
+			for _, expected := range tc.expectedLines {
+				if !containsDiffLine(diffStr, expected) {
+					t.Errorf("diff should contain line %q:\n%s", expected, diffStr)
+				}
+			}
+		})
+	}
+}
+
+func TestMultilineDiffNoDiff(t *testing.T) {
+	content := "content"
+
+	diffStr := dryRunDiff(t, content, content)
+	if diffStr != "" {
+		t.Fatalf("diff output should be empty with no diff, output contained:\n%s", diffStr)
+	}
+}
+
+// assertReadableDiff checks the properties a readable, line-oriented diff must
+// have: it must not contain string-array display elements, and each line must
+// carry a removal, addition, or unchanged-line prefix.
+func assertReadableDiff(t *testing.T, diffStr string) {
+	t.Helper()
+	if strings.Contains(diffStr, "[]string{") {
+		t.Errorf("diff should not contain string array display elements:\n%s", diffStr)
+	}
+	for _, line := range strings.Split(diffStr, "\n") {
+		if line == "" {
+			continue
+		}
+		if !strings.HasPrefix(line, "-") && !strings.HasPrefix(line, "+") && !strings.HasPrefix(line, "  ") {
+			t.Errorf("diff line is not prefixed with a diff marker: %q", line)
+		}
+	}
+}
+
+func TestMultilineDiffPreservesLiteralQuotes(t *testing.T) {
+	before := `message: "old value"`
+	after := `message: "new value"`
+	diffStr := dryRunDiff(t, before, after)
+	assertReadableDiff(t, diffStr)
+	for _, line := range []string{`- message: "old value"`, `+ message: "new value"`} {
+		if !containsDiffLine(diffStr, line) {
+			t.Errorf("diff should preserve YAML content line %q:\n%s", line, diffStr)
+		}
+	}
+}
+
+func TestLintMultilineDiffReadable(t *testing.T) {
+	before := `message: "old value"`
+	after := `message: "new value"`
+	path := filepath.Join(t.TempDir(), "input.yaml")
+	if err := os.WriteFile(path, []byte(before), 0644); err != nil {
+		t.Fatalf("failed to write input file: %v", err)
+	}
+	e := &engine.Engine{Formatter: &staticFormatter{formatted: after}}
+	err := e.LintFile(path)
+	if err == nil {
+		t.Fatal("lint should report content that would be reformatted")
+	}
+	diffStr := err.Error()
+	assertReadableDiff(t, diffStr)
+	for _, line := range []string{`- message: "old value"`, `+ message: "new value"`} {
+		if !containsDiffLine(diffStr, line) {
+			t.Errorf("lint output should preserve YAML content line %q:\n%s", line, diffStr)
+		}
+	}
+}
+
+// containsDiffLine reports whether diffStr contains a line that carries the
+// same marker and content as expected. A single space between the marker and
+// the content is optional, so "- a" and "-a" both denote a removed line "a".
+func containsDiffLine(diffStr, expected string) bool {
+	for _, line := range strings.Split(diffStr, "\n") {
+		if sameDiffLine(line, expected) {
+			return true
+		}
+	}
+	return false
+}
+
+func sameDiffLine(line, expected string) bool {
+	if line == "" || expected == "" || line[0] != expected[0] {
+		return false
+	}
+	return strings.TrimPrefix(line[1:], " ") == strings.TrimPrefix(expected[1:], " ")
+}
