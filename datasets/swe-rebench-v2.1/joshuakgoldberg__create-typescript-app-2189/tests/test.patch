+function getSetupNodeVersion(creation: ReturnType<typeof testBlock>) {
+	const actionYml = (
+		creation.files![".github"] as Record<
+			string,
+			Record<string, Record<string, string>>
+		>
+	).actions.prepare["action.yml"];
+
+	const action = jsYaml.load(actionYml) as {
+		runs: { steps: { uses?: string; with?: Record<string, unknown> }[] };
+	};
+	const setupNodeStep = action.runs.steps.find((step) =>
+		step.uses?.startsWith("actions/setup-node"),
+	);
+
+	return setupNodeStep?.with?.["node-version"];
+}
