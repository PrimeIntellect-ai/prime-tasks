+
+    screen.open('/')
+    image = screen.find_by_class('q-img__image')
+    screen.should_load_image(image)
+
+
+def test_assigning_local_file_to_source(screen: Screen):
+    image_element = ui.image()
+    image_element.source = str(example_file)
+
+    screen.open('/')
+    image = screen.find_by_class('q-img__image')
