+
+test("a job declared manual does not run unless explicitly requested", async () => {
+    const cwd = fs.mkdtempSync(path.join(process.cwd(), "tests", ".manual-rules-"));
+    fs.writeFileSync(path.join(cwd, ".gitlab-ci.yml"), `stages: [test]
+manual-job:
+  stage: test
+  script: touch manual-job-ran
+  when: manual
+  rules:
+    - {}
+`);
+
+    try {
+        const automaticStreams = new WriteStreamsMock();
+        await handler({cwd: path.relative(process.cwd(), cwd)}, automaticStreams);
+        expect(fs.existsSync(path.join(cwd, "manual-job-ran"))).toBe(false);
+
+        const manualStreams = new WriteStreamsMock();
+        await handler({cwd: path.relative(process.cwd(), cwd), manual: ["manual-job"]}, manualStreams);
+        expect(fs.existsSync(path.join(cwd, "manual-job-ran"))).toBe(true);
+    } finally {
+        fs.removeSync(cwd);
+    }
+});
