+// Ambiguous bases can be treated as missing when applying the frequency filter
+#[test]
+fn filter_ambig_as_missing() {
+    let sandbox = TestSetup::setup();
+
+    let without_flag_output = Command::new(cargo_bin("ska"))
+        .current_dir(sandbox.get_wd())
+        .arg("align")
+        .arg(sandbox.file_string("merge_k9.skf", TestDir::Input))
+        .args(&["--filter", "no-filter", "--min-freq", "1.0"])
+        .output()
+        .unwrap();
+    assert!(without_flag_output.status.success());
+
+    let with_flag_output = Command::new(cargo_bin("ska"))
+        .current_dir(sandbox.get_wd())
+        .arg("align")
+        .arg(sandbox.file_string("merge_k9.skf", TestDir::Input))
+        .args(&["--filter", "no-filter", "--min-freq", "1.0"])
+        .arg("--filter-ambig-as-missing")
+        .output()
+        .unwrap();
+    assert!(with_flag_output.status.success());
+    // Enabling missing-ambiguous filtering removes a column from this alignment.
+    let alignment_width = |output: &[u8]| {
+        String::from_utf8_lossy(output)
+            .lines()
+            .find(|line| !line.starts_with('>'))
+            .unwrap()
+            .len()
+    };
+    assert!(alignment_width(&without_flag_output.stdout) > alignment_width(&with_flag_output.stdout));
+}
