+// The default minimum k-mer count for FASTQ input is 5
+#[test]
+fn min_count_default() {
+    let sandbox = TestSetup::setup();
+    let rfile_name = sandbox.create_rfile(&"test", FxType::Fastq);
+
+    // Build using the default minimum k-mer count
+    Command::new(cargo_bin("ska"))
+        .current_dir(sandbox.get_wd())
+        .arg("build")
+        .arg("-f")
+        .arg(rfile_name)
+        .arg("-o")
+        .arg("default_min_count")
+        .args(&["-k", "9", "--min-qual", "2"])
+        .assert()
+        .success();
+
+    // Build with an explicit minimum k-mer count of 5
+    Command::new(cargo_bin("ska"))
+        .current_dir(sandbox.get_wd())
+        .arg("build")
+        .arg("-f")
+        .arg(rfile_name)
+        .arg("-o")
+        .arg("explicit_min_count")
+        .args(&["-k", "9", "--min-qual", "2", "--min-count", "5"])
+        .assert()
+        .success();
+
+    let default_align = Command::new(cargo_bin("ska"))
+        .current_dir(sandbox.get_wd())
+        .arg("align")
+        .arg("default_min_count.skf")
+        .args(&["--filter", "no-filter", "--min-freq", "0"])
+        .output()
+        .unwrap();
+    assert!(default_align.status.success());
+
+    let explicit_align = Command::new(cargo_bin("ska"))
+        .current_dir(sandbox.get_wd())
+        .arg("align")
+        .arg("explicit_min_count.skf")
+        .args(&["--filter", "no-filter", "--min-freq", "0"])
+        .output()
+        .unwrap();
+    assert!(explicit_align.status.success());
+
+    assert_eq!(var_hash(&default_align.stdout), var_hash(&explicit_align.stdout));
+}
