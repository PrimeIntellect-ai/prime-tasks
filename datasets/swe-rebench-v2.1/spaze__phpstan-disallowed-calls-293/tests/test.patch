@@ -0,0 +1,45 @@
+<?php
+declare(strict_types = 1);
+
+function optional()
+{
+}
+
+function optionalSomething()
+{
+}
+
+/**
+ * @template T
+ * @param T $value
+ */
+function genericFunction(mixed $value): void
+{
+}
+
+class Bug288DocblockTemplateCallableParam
+{
+
+	// A method name that merely contains a forbidden function name as a substring
+	// is not a call to that function and must not be reported.
+	public function testItHandlesSomeOptional(): void
+	{
+	}
+
+	public function testItDoesNothing(): void
+	{
+		// A function name that merely contains a forbidden function name as a substring
+		// is not a call to that function and must not be reported.
+		optionalSomething();
+		// A string that happens to match a forbidden function name is not an actual call
+		// to that function and must not be reported.
+		genericFunction('optional');
+	}
+
+	public function testItCallsTheForbiddenFunction(): void
+	{
+		// This is an actual call to the forbidden function and must be reported.
+		optional();
+	}
+
+}
