+func TestViaFieldsAreNullable(t *testing.T) {
+	for _, item := range []struct {
+		name  string
+		value interface{}
+	}{
+		{name: "Ticket", value: Ticket{}},
+		{name: "TicketComment", value: TicketComment{}},
+	} {
+		t.Run(item.name, func(t *testing.T) {
+			field, ok := reflect.TypeOf(item.value).FieldByName("Via")
+			if !ok {
+				t.Fatalf("%s does not expose a Via field", item.name)
+			}
+			if field.Type.Kind() != reflect.Ptr {
+				t.Fatalf("%s Via field must be nullable, got %s", item.name, field.Type.Kind())
+			}
+		})
+	}
+}
