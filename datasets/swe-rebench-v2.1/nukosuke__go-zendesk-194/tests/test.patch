+func TestAbsentViaIsOmittedFromWriteRequests(t *testing.T) {
+	requests := make(chan []byte, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := ioutil.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("Failed to read request body: %s", err)
+		}
+		requests <- body
+		if r.Method == http.MethodPost {
+			w.WriteHeader(http.StatusCreated)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{}`))
+	}))
+	defer server.Close()
+	client := newTestClient(server)
+
+	assertOmitted := func(t *testing.T, operation func() error, getVias func([]byte) ([]json.RawMessage, error)) {
+		t.Helper()
+		if err := operation(); err != nil {
+			t.Fatalf("Request failed: %s", err)
+		}
+		body := <-requests
+		vias, err := getVias(body)
+		if err != nil {
+			t.Fatalf("Failed to decode request payload: %s", err)
+		}
+		for _, via := range vias {
+			if via != nil {
+				t.Fatalf("Expected the via property to be omitted, got %s", via)
+			}
+		}
+	}
+
+	ticketVias := func(body []byte) ([]json.RawMessage, error) {
+		var payload struct {
+			Ticket map[string]json.RawMessage `json:"ticket"`
+		}
+		if err := json.Unmarshal(body, &payload); err != nil {
+			return nil, err
+		}
+		var comment map[string]json.RawMessage
+		if err := json.Unmarshal(payload.Ticket["comment"], &comment); err != nil {
+			return nil, err
+		}
+		return []json.RawMessage{payload.Ticket["via"], comment["via"]}, nil
+	}
+	commentVias := func(body []byte) ([]json.RawMessage, error) {
+		var payload struct {
+			Ticket struct {
+				Comment map[string]json.RawMessage `json:"comment"`
+			} `json:"ticket"`
+		}
+		if err := json.Unmarshal(body, &payload); err != nil {
+			return nil, err
+		}
+		return []json.RawMessage{payload.Ticket.Comment["via"]}, nil
+	}
+
+	t.Run("create ticket", func(t *testing.T) {
+		assertOmitted(t, func() error {
+			_, err := client.CreateTicket(ctx, Ticket{Comment: TicketComment{Body: "new comment"}})
+			return err
+		}, ticketVias)
+	})
+	t.Run("update ticket", func(t *testing.T) {
+		assertOmitted(t, func() error {
+			_, err := client.UpdateTicket(ctx, 2, Ticket{Comment: TicketComment{Body: "updated comment"}})
+			return err
+		}, ticketVias)
+	})
+	t.Run("create ticket comment", func(t *testing.T) {
+		assertOmitted(t, func() error {
+			_, err := client.CreateTicketComment(ctx, 2, TicketComment{})
+			return err
+		}, commentVias)
+	})
+}
