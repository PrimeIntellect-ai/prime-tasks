+// TestApplyInterfaceSupportsIntValues exercises the requested behaviour
+// through the public ApplyInterface entry point. The contract requires
+// integer number values to be supported, including the supplied example
+// where the rule compares the "impact_levels" variable to the integer 1.
+func TestApplyInterfaceSupportsIntValues(t *testing.T) {
+	tests := []struct {
+		name   string
+		rule   interface{}
+		data   interface{}
+		expect interface{}
+	}{
+		{
+			name: "supplied example: int variable compared to int literal",
+			rule: map[string]interface{}{
+				"==": []interface{}{
+					map[string]interface{}{
+						"var": "impact_levels",
+					},
+					1,
+				},
+			},
+			data: map[string]interface{}{
+				"impact_levels": 1,
+			},
+			expect: true,
+		},
+		{
+			name: "int literal compared to equal int literal",
+			rule: map[string]interface{}{
+				"==": []interface{}{1, 1},
+			},
+			data:   map[string]interface{}{},
+			expect: true,
+		},
+		{
+			name: "int literal compared to different int literal",
+			rule: map[string]interface{}{
+				"==": []interface{}{1, 2},
+			},
+			data:   map[string]interface{}{},
+			expect: false,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			output, err := ApplyInterface(test.rule, test.data)
+			assert.NoError(t, err)
+			assert.Equal(t, test.expect, output)
+		})
+	}
+}
