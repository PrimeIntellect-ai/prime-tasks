+package rpc_response_test
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/golang/protobuf/ptypes/any"
+	grpcapi "github.com/nacos-group/nacos-sdk-go/v2/api/grpc"
+	"github.com/nacos-group/nacos-sdk-go/v2/common/constant"
+	"github.com/nacos-group/nacos-sdk-go/v2/common/nacos_server"
+	rpcclient "github.com/nacos-group/nacos-sdk-go/v2/common/remote/rpc"
+	"github.com/nacos-group/nacos-sdk-go/v2/common/remote/rpc/rpc_request"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+)
+
+type successFallbackRPCServer struct {
+	grpcapi.UnimplementedRequestServer
+}
+
+func (successFallbackRPCServer) Request(_ context.Context, request *grpcapi.Payload) (*grpcapi.Payload, error) {
+	responseType := "HealthCheckResponse"
+	body := `{"resultCode":200,"errorCode":0}`
+	if request.GetMetadata().GetType() == "ServerCheckRequest" {
+		responseType = "ServerCheckResponse"
+		body = `{"resultCode":200,"connectionId":"test-connection"}`
+	}
+	return &grpcapi.Payload{
+		Metadata: &grpcapi.Metadata{Type: responseType},
+		Body:     &any.Any{Value: []byte(body)},
+	}, nil
+}
+
+type successFallbackStreamServer struct {
+	grpcapi.UnimplementedBiRequestStreamServer
+}
+
+func (successFallbackStreamServer) RequestBiStream(stream grpcapi.BiRequestStream_RequestBiStreamServer) error {
+	for {
+		if _, err := stream.Recv(); err != nil {
+			return err
+		}
+	}
+}
+
+func TestRPCRequestTreatsMissingSuccessWithResultCode200AsSuccessful(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	_, portText, err := net.SplitHostPort(listener.Addr().String())
+	require.NoError(t, err)
+	port, err := strconv.Atoi(portText)
+	require.NoError(t, err)
+
+	server := grpc.NewServer()
+	grpcapi.RegisterRequestServer(server, successFallbackRPCServer{})
+	grpcapi.RegisterBiRequestStreamServer(server, successFallbackStreamServer{})
+	go func() { _ = server.Serve(listener) }()
+	t.Cleanup(server.Stop)
+
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	nacosServer, err := nacos_server.NewNacosServer(ctx,
+		[]constant.ServerConfig{{IpAddr: "127.0.0.1", Port: uint64(port), GrpcPort: uint64(port)}},
+		constant.ClientConfig{}, nil, 1000, "", nil)
+	require.NoError(t, err)
+	client := rpcclient.NewGrpcClient(ctx, fmt.Sprintf("response-success-%d", port), nacosServer)
+	client.Start()
+	t.Cleanup(client.Shutdown)
+
+	deadline := time.Now().Add(3 * time.Second)
+	for !client.IsRunning() && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	require.True(t, client.IsRunning(), "RPC client should connect to the local server")
+
+	response, err := client.Request(rpc_request.NewHealthCheckRequest(), 1000)
+	require.NoError(t, err)
+	require.NotNil(t, response)
+	require.True(t, response.IsSuccess())
+}
