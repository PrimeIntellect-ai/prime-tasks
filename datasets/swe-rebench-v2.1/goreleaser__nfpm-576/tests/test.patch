+func TestTrailingSlashDestinationInstallsFileInDirectory(t *testing.T) {
+	source := filepath.Join(t.TempDir(), "file.txt")
+	require.NoError(t, os.WriteFile(source, []byte("content"), 0o600))
+
+	info := nfpm.WithDefaults(&nfpm.Info{
+		Name:       "foo",
+		Version:    "1.0.0",
+		Arch:       "amd64",
+		Maintainer: "test",
+		Overridables: nfpm.Overridables{
+			Contents: []*files.Content{{
+				Source:      source,
+				Destination: "/usr/local/share/file/",
+			}},
+		},
+	})
+
+	var packageData bytes.Buffer
+	require.NoError(t, deb.Default.Package(info, &packageData))
+
+	arReader := ar.NewReader(bytes.NewReader(packageData.Bytes()))
+	var dataArchive []byte
+	for {
+		header, err := arReader.Next()
+		if err == io.EOF {
+			break
+		}
+		require.NoError(t, err)
+		if strings.HasPrefix(header.Name, "data.tar") {
+			dataArchive, err = io.ReadAll(arReader)
+			require.NoError(t, err)
+			break
+		}
+	}
+	require.NotEmpty(t, dataArchive)
+
+	compressed, err := gzip.NewReader(bytes.NewReader(dataArchive))
+	require.NoError(t, err)
+	defer compressed.Close()
+	tarReader := tar.NewReader(compressed)
+	var installed bool
+	for {
+		header, err := tarReader.Next()
+		if err == io.EOF {
+			break
+		}
+		require.NoError(t, err)
+		if strings.TrimPrefix(path.Clean(header.Name), "./") == "usr/local/share/file/file.txt" {
+			installed = true
+			break
+		}
+	}
+	require.True(t, installed, "package should contain the source file inside the destination directory")
+}
