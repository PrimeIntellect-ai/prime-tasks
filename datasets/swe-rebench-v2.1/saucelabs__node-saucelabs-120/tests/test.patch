+test('should list tunnels using the supported v1 endpoint', async () => {
+    const SauceLabs = jest.requireActual('../src/index.js').default
+    const api = new SauceLabs({ user: 'foo', key: 'bar' })
+    await api.listTunnels('someuser', { all: true, full: true })
+
+    const [uri, req = {}] = got.mock.calls[got.mock.calls.length - 1]
+    const requestUrl = new URL(uri, 'https://saucelabs.example')
+    expect(requestUrl.pathname).toMatch(/\/v1\/someuser\/tunnels$/)
+
+    // Query parameters may be provided in the URL or through got's
+    // `searchParams` option, which accepts a string, a URLSearchParams
+    // instance or a plain object. Normalise all of them into one lookup.
+    const query = new URLSearchParams(requestUrl.search)
+    for (const [key, value] of new URLSearchParams(req.searchParams)) {
+        query.set(key, value)
+    }
+    expect(query.get('all')).toBe('true')
+    expect(query.get('full')).toBe('true')
+})
+
+
+test('the listTunnels CLI command forwards all and full query parameters', async () => {
+    run()
+    const tunnelCommandCall = yargs.command.mock.calls.find(
+        ([command]) => command.includes('listTunnels <username>')
+    )
+
+    expect(tunnelCommandCall).toBeDefined()
+    const [, , , handler] = tunnelCommandCall
+    const params = {
+        user: 'foobaruser',
+        key: 'barfookey',
+        username: 'someuser',
+        all: true,
+        full: true,
+        returnValue: []
+    }
+
+    const api = await handler(params)
+
+    expect(api.listTunnels).toBeCalledWith('someuser', expect.objectContaining({
+        all: true,
+        full: true
+    }))
+})
