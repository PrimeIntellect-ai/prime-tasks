+# Starlark float values are encoded using decimal point notation, even if
+# the value is an integer, so that the float type is preserved.
+assert.eq(json.encode(float(1)), "1.0")
+def check_float_encoding():
+    for f in [float(0.0), float(1.0), float(-1.0), float(2.0), float(-7.0), float(42.0), float(100.0), float(1000.0), float(123456.0)]:
+        enc = json.encode(f)
+        assert.true("." in enc, "%s encoded as %s, want decimal point notation" % (f, enc))
+        assert.eq(type(json.decode(enc)), "float")
+        assert.eq(json.decode(enc), f)
+check_float_encoding()
