+
+func TestLegacyEmailsDisabledUpdate(t *testing.T) {
+	cases := map[string]struct {
+		legacyDisabled    bool
+		observedEnabled   bool
+		configuredEnabled *bool
+		wantEnabled       bool
+	}{
+		"legacy disabled overrides enabled observation": {
+			legacyDisabled: true, observedEnabled: true, wantEnabled: false,
+		},
+		"legacy enabled overrides disabled observation": {
+			legacyDisabled: false, observedEnabled: false, wantEnabled: true,
+		},
+		"explicit enabled setting takes precedence": {
+			legacyDisabled: true, observedEnabled: false, configuredEnabled: gitlab.Ptr(true), wantEnabled: true,
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			resource := group(withExternalName(extName))
+			resource.Spec.ForProvider.EmailsDisabled = &tc.legacyDisabled
+			resource.Spec.ForProvider.EmailsEnabled = tc.configuredEnabled
+			var gotEnabled *bool
+			e := &external{client: &fake.MockClient{
+				MockGetGroup: func(gid interface{}, options ...gitlab.RequestOptionFunc) (*gitlab.Group, *gitlab.Response, error) {
+					return &gitlab.Group{ID: groupID, EmailsEnabled: tc.observedEnabled}, &gitlab.Response{}, nil
+				},
+				MockUpdateGroup: func(gid interface{}, opt *gitlab.UpdateGroupOptions, options ...gitlab.RequestOptionFunc) (*gitlab.Group, *gitlab.Response, error) {
+					gotEnabled = opt.EmailsEnabled
+					return &gitlab.Group{ID: groupID}, &gitlab.Response{}, nil
+				},
+			}}
+
+			if _, err := e.Observe(context.Background(), resource); err != nil {
+				t.Fatalf("Observe returned an error: %v", err)
+			}
+			if _, err := e.Update(context.Background(), resource); err != nil {
+				t.Fatalf("Update returned an error: %v", err)
+			}
+			if gotEnabled == nil || *gotEnabled != tc.wantEnabled {
+				t.Errorf("updated emails_enabled = %v, want %t", gotEnabled, tc.wantEnabled)
+			}
+		})
+	}
+}
