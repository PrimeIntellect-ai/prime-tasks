+    /** @test */
+    public function it_doesnt_lose_json_column_data_when_saving_a_published_model()
+    {
+        $model = Post::factory()->create([
+            'values' => ['alt_title' => 'Original alt title', 'alt_body' => 'Original alt body'],
+        ]);
+
+        $this->assertTrue($model->published());
+
+        $this
+            ->actingAs(User::make()->id('user-1')->makeSuper()->save())
+            ->patch(cp_route('runway.update', ['resource' => 'post', 'model' => $model->id]), [
+                'published' => true,
+                'slug' => $model->slug,
+                'body' => $model->body,
+                'values->alt_title' => 'Updated alt title',
+                'values->alt_body' => 'Original alt body',
+                'author_id' => [$model->author_id],
+            ]);
+
+        $workingCopy = $model->workingCopy();
+
+        $this->assertNotNull($workingCopy);
+
+        $data = $workingCopy->attributes()['data'];
+
+        $this->assertArrayHasKey('values', $data);
+        $this->assertEquals('Updated alt title', $data['values']['alt_title']);
+        $this->assertEquals('Original alt body', $data['values']['alt_body']);
+    }
