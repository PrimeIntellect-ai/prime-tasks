+def test_optimiser_trust_radius_is_distance():
+    """The trust radius (maximum step size) must be a unit-aware Distance"""
+
+    for optimiser_cls in (CRFOptimiser, RFOptimiser, PRFOptimiser):
+        optimiser = optimiser_cls(maxiter=1, gtol=1e-5, etol=1e-5)
+        assert isinstance(optimiser.alpha, val.Distance)
+
+    # A plain float init_alpha/init_trust must still yield a Distance
+    optimiser = CRFOptimiser(
+        init_alpha=0.05, maxiter=1, gtol=1e-5, etol=1e-5
+    )
+    assert isinstance(optimiser.alpha, val.Distance)
+
+    trm = HybridTRMOptimiser(maxiter=1, gtol=1e-5, etol=1e-5)
+    assert isinstance(trm.alpha, val.Distance)
