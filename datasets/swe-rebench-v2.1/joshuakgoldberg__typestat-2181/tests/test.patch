+describe("createProcessOutput sanitization", () => {
+	let logDirectory: string;
+
+	beforeEach(() => {
+		logDirectory = fs.mkdtempSync(path.join(os.tmpdir(), "typestat-output-"));
+		vi.spyOn(process.stdout, "write").mockImplementation(() => true);
+	});
+
+	afterEach(() => {
+		vi.restoreAllMocks();
+		fs.rmSync(logDirectory, { force: true, recursive: true });
+	});
+
+	it("removes ANSI control sequences from logged process output", () => {
+		const logFile = path.join(logDirectory, "output.log");
+		const output = createProcessOutput(logFile);
+
+		output.stdout("\u001b[31mred\u001b[39m text");
+
+		const logged = fs.readFileSync(logFile, "utf8");
+
+		expect(logged).toContain("red text");
+		expect(logged).not.toContain("\u001b");
+	});
+
+	it("sanitizes process output with Node's stripVTControlCharacters", () => {
+		const logFile = path.join(logDirectory, "output.log");
+		const output = createProcessOutput(logFile);
+
+		output.stderr("\u001b[1mbold\u001b[22m");
+
+		expect(vi.mocked(util.stripVTControlCharacters)).toHaveBeenCalled();
+	});
+});
+
+describe("package manifest", () => {
