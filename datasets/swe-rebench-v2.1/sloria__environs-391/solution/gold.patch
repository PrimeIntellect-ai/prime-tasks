-
-# marshmallow validator
+# built-in validator
 try:
     env.str(
         "NODE_ENV",
-        validate=OneOf(
+        validate=validate.OneOf(
             ["production", "development"], error="NODE_ENV must be one of: {choices}"
         ),
     )
@@ -31,6 +20,19 @@ except EnvError as err:
 
 # multiple validators
 try:
-    env.str("EMAIL", validate=[Length(min=4), Email()])
