-
-from environs import Env, EnvError
+from environs import EnvError, ValidationError, env, validate
 
 os.environ["TTL"] = "-2"
 os.environ["NODE_ENV"] = "invalid"
 os.environ["EMAIL"] = "^_^"
 
-
-env = Env()
-
-# simple validator
-try:
-    env.int("TTL", validate=lambda n: n > 0)
-except EnvError as err:
