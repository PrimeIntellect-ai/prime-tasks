diff --git a/test/kino/shorts_test.exs b/test/kino/shorts_test.exs
new file mode 100644
index 0000000..2e57784
--- /dev/null
+++ b/test/kino/shorts_test.exs
@@ -0,0 +1,47 @@
+defmodule Kino.ShortsTest do
+  use Kino.LivebookCase, async: true
+
+  test "imports text shortcut" do
+    assert {:plain_text, "Hello"} = render_shortcut(quote do: text("Hello"))
+  end
+
+  test "imports markdown shortcut" do
+    assert {:markdown, "**hello**"} = render_shortcut(quote do: markdown("**hello**"))
+  end
+
+  test "imports mermaid shortcut" do
+    assert {:js, _info} = render_shortcut(quote do: mermaid("graph TD; A-->B;"))
+  end
+
+  test "imports image shortcut" do
+    assert {:image, "image bytes", "image/jpeg"} =
+             render_shortcut(quote do: image("image bytes", "image/jpeg"))
+  end
+
+  test "imports tree shortcut" do
+    assert tree_output?(render_shortcut(quote do: tree([1, 2])))
+  end
+
+  test "imports frame shortcut" do
+    assert {:frame, _outputs, _info} = render_shortcut(quote do: frame())
+  end
+
+  defp render_shortcut(ast) do
+    module = Enum.find([Kino.Shorts, Kino.Shortcuts], &Code.ensure_loaded?/1)
+    if is_nil(module), do: raise("no importable Kino shortcut module is available")
+
+    {value, _binding} =
+      Code.eval_quoted(
+        quote do
+          import unquote(module)
+          unquote(ast)
+        end
+      )
+
+    Kino.Render.to_livebook(value)
+  end
+
+  defp tree_output?({:grid, _outputs, _info}), do: true
+  defp tree_output?({:js, _info}), do: true
+  defp tree_output?(_output), do: false
+end
