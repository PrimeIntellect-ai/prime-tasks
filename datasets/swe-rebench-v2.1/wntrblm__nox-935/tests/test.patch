@@ -1071,3 +1071,25 @@ def test_noxfile_no_script_mode(monkeypatch: pytest.MonkeyPatch) -> None:
     )
     assert job.returncode == 1
     assert "No module named 'cowsay'" in job.stderr
+
+
+def test_noxfile_script_mode_url_req(tmp_path: Path) -> None:
+    job = subprocess.run(
+        [
+            sys.executable,
+            "-m",
+            "nox",
+            "-f",
+            Path(RESOURCES) / "noxfile_script_mode_url_req.py",
+            "-s",
+            "example",
+            "--envdir",
+            str(tmp_path / "nox-env"),
+        ],
+        check=False,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+    )
+    assert job.returncode == 0, job.stderr
+    assert any(line in {"2024.10.09", "2024.10.9"} for line in job.stdout.splitlines())
