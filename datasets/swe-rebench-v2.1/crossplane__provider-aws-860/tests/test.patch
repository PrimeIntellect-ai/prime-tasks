+func TestNumNodeGroupsCanBeUpdated(t *testing.T) {
+	crd, err := os.ReadFile("../../../package/crds/cache.aws.crossplane.io_replicationgroups.yaml")
+	if err != nil {
+		t.Fatalf("Read replication-group API schema: %v", err)
+	}
+	data, err := utilyaml.ToJSON(crd)
+	if err != nil {
+		t.Fatalf("Decode replication-group API schema: %v", err)
+	}
+	var definition map[string]interface{}
+	if err := json.Unmarshal(data, &definition); err != nil {
+		t.Fatalf("Parse replication-group API schema: %v", err)
+	}
+	spec := definition["spec"].(map[string]interface{})
+	versions := spec["versions"].([]interface{})
+	version := versions[0].(map[string]interface{})
+	schema := version["schema"].(map[string]interface{})["openAPIV3Schema"].(map[string]interface{})
+	properties := schema["properties"].(map[string]interface{})
+	resourceSpec := properties["spec"].(map[string]interface{})
+	forProvider := resourceSpec["properties"].(map[string]interface{})["forProvider"].(map[string]interface{})
+	nodeGroups := forProvider["properties"].(map[string]interface{})["numNodeGroups"].(map[string]interface{})
+
+	// Update admission must not require a value to remain equal to its old value.
+	if validations, ok := nodeGroups["x-kubernetes-validations"].([]interface{}); ok {
+		for _, validation := range validations {
+			rule := validation.(map[string]interface{})["rule"].(string)
+			normalizedRule := strings.ReplaceAll(rule, " ", "")
+			immutable := normalizedRule == "self==oldSelf" || normalizedRule == "oldSelf==self" ||
+				normalizedRule == "!has(oldSelf)||self==oldSelf" || normalizedRule == "!has(oldSelf)||oldSelf==self"
+			if immutable {
+				t.Errorf("numNodeGroups update validation prevents changing an existing value: %q", rule)
+			}
+		}
+	}
+}
