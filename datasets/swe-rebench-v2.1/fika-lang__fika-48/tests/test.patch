+  # Evaluates a translated Erlang abstract expression and returns its value.
+  defp eval(ast, binding \\ []) do
+    {:value, value, _} = :erl_eval.expr(ast, binding)
+    value
+  end
+
+  # Normalizes a string value to a binary, regardless of whether the
+  # implementation represents strings as binaries or charlists.
+  defp string_value(value) when is_binary(value), do: value
+  defp string_value(value) when is_list(value), do: IO.iodata_to_binary(value)
+
