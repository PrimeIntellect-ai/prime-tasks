+func TestIssue58_example(t *testing.T) {
+	data := strings.NewReader(`{"foo": "bar"}`)
+	logic := strings.NewReader(`{"if":[
+		{"==":[{"var":"foo"},"bar"]},{"foo":"is_bar","path":"foo_is_bar"},
+		{"foo":"not_bar","path":"default_object"}
+	]}`)
+
+	var result bytes.Buffer
+	err := Apply(logic, data, &result)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	expected := `{"foo":"is_bar","path":"foo_is_bar"}`
+	assert.JSONEq(t, expected, result.String())
+}
+
+func TestIssue58_objectFromAlternateBranch(t *testing.T) {
+	logic := strings.NewReader(`{"if":[
+{"==":[{"var":"foo"},"bar"]},
+{"first":"bar branch","kind":"selected"},
+{"second":"alternate branch","count":2}
+]}`)
+	data := strings.NewReader(`{"foo":"other"}`)
+
+	var result bytes.Buffer
+	if err := Apply(logic, data, &result); err != nil {
+		t.Fatal(err)
+	}
+
+	assert.JSONEq(t, `{"second":"alternate branch","count":2}`, result.String())
+}
+
+func TestIssue58_objectInsideArray(t *testing.T) {
+	logic := strings.NewReader(`[{"first":"value","second":2}]`)
+	data := strings.NewReader(`{}`)
+
+	var result bytes.Buffer
+	if err := Apply(logic, data, &result); err != nil {
+		t.Fatal(err)
+	}
+
+	assert.JSONEq(t, `[{"first":"value","second":2}]`, result.String())
+}
+
+func TestIssue58_threeKeyObject(t *testing.T) {
+	logic := strings.NewReader(`{"if":[
+{"==":[{"var":"choice"},"first"]},
+{"first":"selected","kind":"result","count":3},
+{"first":"alternate","kind":"result","count":4}
+]}`)
+	data := strings.NewReader(`{"choice":"first"}`)
+
+	var result bytes.Buffer
+	if err := Apply(logic, data, &result); err != nil {
+		t.Fatal(err)
+	}
+
+	assert.JSONEq(t, `{"first":"selected","kind":"result","count":3}`, result.String())
+}
+
+func TestIssue58_multiKeyRuleAsWholeRule(t *testing.T) {
+logic := strings.NewReader(`{"name":{"var":"foo"},"kind":"static"}`)
+data := strings.NewReader(`{"foo":"bar"}`)
+
+var result bytes.Buffer
+if err := Apply(logic, data, &result); err != nil {
+t.Fatal(err)
+}
+
+assert.JSONEq(t, `{"name":{"var":"foo"},"kind":"static"}`, result.String())
