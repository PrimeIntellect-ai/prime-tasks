+    def test_array_with_Data_objects(self):
+        # NumPy arrays of Data objects represent references; their payload dimensions are not part of the array shape.
+        data = np.empty((2,), dtype=object)
+        data[0] = Data(name="a", data=[1, 2])
+        data[1] = Data(name="b", data=[3, 4, 5])
+        self.assertTupleEqual(get_data_shape(data), (2, ))
+
+    def test_list_with_Data_objects(self):
+        # list of Data objects
+        res = get_data_shape([Data(name="a", data=[1, 2]), Data(name="b", data=[3, 4])])
+        self.assertTupleEqual(res, (2, ))
+
+        # list of list of Data objects
+        res = get_data_shape(
+            [
+                [Data(name="a", data=[1, 2, 3]), Data(name="b", data=[3, 4, 5]), Data(name="c", data=[3, 4, 5])],
+                [Data(name="d", data=[1, 2, 3]), Data(name="e", data=[3, 4, 5]), Data(name="f", data=[3, 4, 5])],
+            ]
+        )
+        self.assertTupleEqual(res, (2, 3))
+
+
+    def test_writing_image_references_does_not_warn_about_payload_shape(self):
+        class Image(Data):
+            @property
+            def data_type(self):
+                return 'Image'
+
+        class ImageReferences(Data):
+            @property
+            def data_type(self):
+                return 'ImageReferences'
+
+        image_spec = DatasetSpec(doc='Image payload', data_type_def='Image', dtype='int')
+        references_spec = DatasetSpec(
+            doc='References to images',
+            data_type_def='ImageReferences',
+            dtype=RefSpec('Image', 'object'),
+            shape=[None],
+            dims=['image'],
+        )
+        spec_catalog = SpecCatalog()
+        spec_catalog.register_spec(image_spec, 'test.yaml')
+        spec_catalog.register_spec(references_spec, 'test.yaml')
+        namespace = SpecNamespace(
+            doc='Test namespace',
+            name='test_core',
+            schema=[{'source': 'test.yaml'}],
+            version='0.1.0',
+            catalog=spec_catalog,
+        )
+        namespace_catalog = NamespaceCatalog()
+        namespace_catalog.add_namespace('test_core', namespace)
+        type_map = TypeMap(namespace_catalog)
+        type_map.register_container_type('test_core', 'Image', Image)
+        type_map.register_container_type('test_core', 'ImageReferences', ImageReferences)
+        manager = BuildManager(type_map)
+        references = ImageReferences(
+            name='images',
+            data=[
+                Image(name='first', data=[[1, 2], [3, 4]]),
+                Image(name='second', data=[[5, 6], [7, 8]]),
+            ],
+        )
+
+        with warnings.catch_warnings(record=True) as caught_warnings:
+            warnings.simplefilter('always')
+            manager.build(references, source='test.h5')
+
+        self.assertFalse(any(isinstance(w.message, IncorrectDatasetShapeBuildWarning)
+                             for w in caught_warnings))
+
+
