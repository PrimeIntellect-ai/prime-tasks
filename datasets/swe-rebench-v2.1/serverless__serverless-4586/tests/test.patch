diff --git a/lib/utils/getCommandSuggestion.test.js b/lib/utils/getCommandSuggestion.test.js
new file mode 100644
index 00000000..66ed8f8b
--- /dev/null
+++ b/lib/utils/getCommandSuggestion.test.js
@@ -0,0 +1,29 @@
+'use strict';
+
+const expect = require('chai').expect;
+const Serverless = require('../../lib/Serverless');
+
+const serverless = new Serverless();
+serverless.init();
+
+describe('CLI command suggestions', () => {
+  it('suggests the intended command in the unknown-command error by default', () => {
+    const processedInput = serverless.processedInput;
+    serverless.processedInput = { commands: ['deploi'], options: {} };
+
+    let error;
+    try {
+      serverless.run();
+    } catch (caughtError) {
+      error = caughtError;
+    } finally {
+      serverless.processedInput = processedInput;
+    }
+
+    expect(error).to.be.instanceof(Error);
+    expect(error.message).to.equal([
+      'Serverless command "deploi" not found. Did you mean "deploy"?',
+      ' Run "serverless help" for a list of all available commands.',
+    ].join(''));
+  });
+});
