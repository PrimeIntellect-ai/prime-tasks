+package bot_test
+
+import (
+	"bufio"
+	"os"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/infracloudio/botkube/pkg/bot"
+	"github.com/slack-go/slack/slacktest"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestSlackBot_UnmarshallingErrorLogOmitsEventDetails(t *testing.T) {
+	server := slacktest.NewTestServer()
+	server.Start()
+	defer server.Stop()
+
+	readEnd, writeEnd, err := os.Pipe()
+	if !assert.NoError(t, err) {
+		return
+	}
+	originalStdoutFD, err := syscall.Dup(1)
+	if !assert.NoError(t, err) {
+		return
+	}
+	if !assert.NoError(t, syscall.Dup2(int(writeEnd.Fd()), 1)) {
+		_ = syscall.Close(originalStdoutFD)
+		return
+	}
+	defer func() {
+		_ = syscall.Dup2(originalStdoutFD, 1)
+		_ = syscall.Close(originalStdoutFD)
+		_ = writeEnd.Close()
+	}()
+
+	lines := make(chan string, 100)
+	go func() {
+		scanner := bufio.NewScanner(readEnd)
+		for scanner.Scan() {
+			lines <- scanner.Text()
+		}
+		close(lines)
+	}()
+
+	slackBot := &bot.SlackBot{Token: "test-token", SlackURL: server.GetAPIURL()}
+	go slackBot.Start()
+
+	const sensitiveMarker = "sensitive-user-data-73912"
+	event := `{"type":"user_huddle_changed","user":{"id":"` + sensitiveMarker + `","team_id":"team-secret"},"event_ts":"1652949120.004700"}`
+	server.SendToWebsocket(event)
+
+	var captured strings.Builder
+	deadline := time.After(5 * time.Second)
+waitForLog:
+	for {
+		select {
+		case line := <-lines:
+			captured.WriteString(line)
+			captured.WriteByte('\n')
+			if strings.Contains(line, "Slack unmarshalling error") {
+				break waitForLog
+			}
+		case <-deadline:
+			break waitForLog
+		}
+	}
+
+	// Stop capturing process output after observing (or timing out while waiting for) the log.
+	_ = syscall.Dup2(originalStdoutFD, 1)
+	_ = writeEnd.Close()
+	for line := range lines {
+		captured.WriteString(line)
+		captured.WriteByte('\n')
+	}
+	_ = readEnd.Close()
+
+	logs := captured.String()
+	assert.NotContains(t, logs, sensitiveMarker, "Slack unmarshalling-error logs must not expose user data")
+	assert.NotContains(t, logs, event, "Slack unmarshalling-error logs must not include the event payload")
+}
