+class TestEthereumTesterEthSimulateV1:
+    _mock_simulate_v1_result = [
+        {
+            "baseFeePerGas": "0xa",
+            "number": "0x12",
+            "gasUsed": "0x5208",
+            "calls": [
+                {
+                    "returnData": "0x",
+                    "logs": [],
+                    "gasUsed": "0x5208",
+                    "status": "0x1",
+                }
+            ],
+        }
+    ]
+
+    _simulate_v1_payload = {
+        "blockStateCalls": [
+            {
+                "calls": [
+                    {
+                        "from": "0xc100000000000000000000000000000000000000",
+                        "to": "0xc100000000000000000000000000000000000000",
+                    }
+                ]
+            }
+        ]
+    }
+
+    def test_eth_simulate_v1_returns_formatted_results(
+        self, w3: "Web3", request_mocker
+    ) -> None:
+        requests = []
+
+        def _mock_simulate_v1(method, params):
+            requests.append((method, params))
+            return self._mock_simulate_v1_result
+
+        with request_mocker(w3, mock_results={"eth_simulateV1": _mock_simulate_v1}):
+            result = w3.eth.simulate_v1(self._simulate_v1_payload, "latest")
+
+        # the simulation request is sent to the node
+        assert len(requests) == 1
+        assert requests[0][0] == "eth_simulateV1"
+        assert requests[0][1][1] == "latest"
+        assert "blockStateCalls" in requests[0][1][0]
+
+        # the full simulation result set is returned and formatted
+        assert len(result) == 1
+        assert result[0]["baseFeePerGas"] == 10
+        assert result[0]["number"] == 18
+        assert result[0]["gasUsed"] == 21000
+
+        calls = result[0]["calls"]
+        assert len(calls) == 1
+        assert calls[0]["gasUsed"] == 21000
+        assert calls[0]["status"] == 1
+        assert HexBytes(calls[0]["returnData"]) == HexBytes("0x")
+        assert calls[0]["logs"] == []
+
+    @pytest.mark.asyncio
+    async def test_async_eth_simulate_v1_returns_formatted_results(
+        self, request_mocker
+    ) -> None:
+        async_w3 = AsyncWeb3(AsyncEthereumTesterProvider())
+        requests = []
+
+        def _mock_simulate_v1(method, params):
+            requests.append((method, params))
+            return self._mock_simulate_v1_result
+
+        async with request_mocker(
+            async_w3, mock_results={"eth_simulateV1": _mock_simulate_v1}
+        ):
+            result = await async_w3.eth.simulate_v1(self._simulate_v1_payload, "latest")
+
+        # the simulation request is sent to the node
+        assert len(requests) == 1
+        assert requests[0][0] == "eth_simulateV1"
+        assert requests[0][1][1] == "latest"
+        assert "blockStateCalls" in requests[0][1][0]
+
+        # the full simulation result set is returned and formatted
+        assert len(result) == 1
+        assert result[0]["baseFeePerGas"] == 10
+        assert result[0]["number"] == 18
+        assert result[0]["gasUsed"] == 21000
+
+        calls = result[0]["calls"]
+        assert len(calls) == 1
+        assert calls[0]["gasUsed"] == 21000
+        assert calls[0]["status"] == 1
+        assert HexBytes(calls[0]["returnData"]) == HexBytes("0x")
