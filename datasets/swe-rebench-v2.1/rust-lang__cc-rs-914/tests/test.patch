+#[test]
+fn compile_intermediates() {
+    reset_env();
+    let test = Test::gnu();
+    let intermediates = test
+        .gcc()
+        .file("foo.c")
+        .file("bar.asm")
+        .file("baz.S")
+        .asm_flag("--abc")
+        .compile_intermediates();
+
+    assert_eq!(intermediates.len(), 3);
+
+    // The object files are returned in the order the source files were added.
+    assert!(intermediates[0]
+        .display()
+        .to_string()
+        .ends_with("d1fba762150c532c-foo.o"));
+    assert!(intermediates[1]
+        .display()
+        .to_string()
+        .ends_with("bar.o"));
+    assert!(intermediates[2]
+        .display()
+        .to_string()
+        .ends_with("baz.o"));
+
+    // Inspect every compiler invocation without assuming how many processes
+    // are used. Each source must be compiled to the corresponding returned path.
+    let mut invocations = Vec::new();
+    for entry in std::fs::read_dir(test.td.path()).unwrap() {
+        let path = entry.unwrap().path();
+        if path.file_name().unwrap().to_string_lossy().starts_with("out") {
+            let contents = std::fs::read_to_string(path).unwrap();
+            assert!(
+                !contents.lines().any(|arg| arg.ends_with(".a") || arg.ends_with(".lib")),
+                "compile_intermediates must not invoke an archive output: {}",
+                contents
+            );
+            invocations.extend(contents.lines().map(str::to_owned));
+        }
+    }
+
+    assert!(!invocations.is_empty(), "the compiler must be invoked");
+    for source in &["foo.c", "bar.asm", "baz.S"] {
+        assert!(
+            invocations.iter().any(|arg| arg.ends_with(source)),
+            "no compiler invocation included source {}: {:?}",
+            source,
+            invocations
+        );
+    }
+    for object in &intermediates {
+        let object_name = object.file_name().unwrap().to_string_lossy();
+        assert!(
+            invocations.iter().any(|arg| arg.ends_with(object_name.as_ref())),
+            "no compiler invocation targeted returned object {}: {:?}",
+            object.display(),
+            invocations
+        );
+    }
+}
