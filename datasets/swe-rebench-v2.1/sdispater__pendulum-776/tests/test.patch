+def test_deepcopy_on_transition():
+    dt = pendulum.datetime(2023, 11, 5, 1, 0, 0, tz="US/Pacific")
+    clone = deepcopy(dt)
+
+    assert clone is not dt
+    assert isinstance(clone, pendulum.DateTime)
+    assert dt == clone
+    assert dt.offset == clone.offset
+    assert clone.timestamp() == dt.timestamp()
+    assert clone.fold == dt.fold
+    assert clone.tz == dt.tz
+    assert (
+        clone.year,
+        clone.month,
+        clone.day,
+        clone.hour,
+        clone.minute,
+        clone.second,
+        clone.microsecond,
+    ) == (
+        dt.year,
+        dt.month,
+        dt.day,
+        dt.hour,
+        dt.minute,
+        dt.second,
+        dt.microsecond,
+    )
+
+
