+func TestMarathonTaskToConsulServiceMapping_IgnoredHealthcheckTypesParsing(t *testing.T) {
+	t.Parallel()
+
+	healthChecks := []apps.HealthCheck{
+		{Path: "/api/health", Protocol: "HTTP", PortIndex: 0, IntervalSeconds: 60, TimeoutSeconds: 20},
+		{Protocol: "TCP", PortIndex: 1, IntervalSeconds: 40, TimeoutSeconds: 20},
+		{
+			Protocol: "COMMAND",
+			Command: struct {
+				Value string `json:"value"`
+			}{Value: "echo 1"},
+			IntervalSeconds: 30,
+			TimeoutSeconds:  20,
+		},
+	}
+
+	testCases := []struct {
+		name     string
+		ignored  string
+		expected []string
+	}{
+		{"empty configuration ignores nothing", "", []string{"HTTP", "TCP", "COMMAND"}},
+		{"commas and whitespace only ignore nothing", " , ", []string{"HTTP", "TCP", "COMMAND"}},
+		{"lowercase type is ignored", "command", []string{"HTTP", "TCP"}},
+		{"uppercase type is ignored", "COMMAND", []string{"HTTP", "TCP"}},
+		{"mixed case type is ignored", "Command", []string{"HTTP", "TCP"}},
+		{"surrounding whitespace is trimmed", " command , tcp ", []string{"HTTP"}},
+		{"multiple types are ignored", "command,tcp", []string{"HTTP"}},
+	}
+
+	for _, testCase := range testCases {
+		testCase := testCase
+		t.Run(testCase.name, func(t *testing.T) {
+			t.Parallel()
+			registrations := registeredHealthCheckTypes(t, testCase.ignored, healthChecks)
+			assertRegisteredHealthCheckTypes(t, testCase.expected, registrations)
+		})
+	}
+}
