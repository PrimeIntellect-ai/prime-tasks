+func registeredHealthCheckTypes(t *testing.T, ignored string, healthChecks []apps.HealthCheck) [][]string {
+	t.Helper()
+	var mu sync.Mutex
+	var registrations []*consulapi.AgentServiceRegistration
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPut || r.URL.Path != "/v1/agent/service/register" {
+			http.NotFound(w, r)
+			return
+		}
+		var registration consulapi.AgentServiceRegistration
+		if err := json.NewDecoder(r.Body).Decode(&registration); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		mu.Lock()
+		registrations = append(registrations, &registration)
+		mu.Unlock()
+		w.WriteHeader(http.StatusOK)
+	}))
+	t.Cleanup(server.Close)
+
+	host, port, err := net.SplitHostPort(server.Listener.Addr().String())
+	assert.NoError(t, err)
+	config := Config{Port: port, Tag: "marathon"}
+	ignoredHealthChecks := reflect.ValueOf(&config).Elem().FieldByName("IgnoredHealthChecks")
+	if !ignoredHealthChecks.IsValid() || !ignoredHealthChecks.CanSet() {
+		t.Fatalf("Config must expose a public IgnoredHealthChecks field")
+	}
+	ignoredHealthChecks.SetString(ignored)
+	consul := New(config)
+	assert.NoError(t, consul.AddAgent(host))
+	app := &apps.App{
+		ID:           "someApp",
+		HealthChecks: healthChecks,
+		Labels:       map[string]string{"consul": "true"},
+	}
+	task := &apps.Task{ID: "someTask", AppID: app.ID, Host: host, Ports: []int{8090, 8443}}
+	assert.NoError(t, consul.Register(task, app))
+
+	mu.Lock()
+	defer mu.Unlock()
+	registeredTypes := make([][]string, 0, len(registrations))
+	for _, registration := range registrations {
+		var types []string
+		for _, check := range registration.Checks {
+			switch {
+			case check.HTTP != "":
+				types = append(types, "HTTP")
+			case check.TCP != "":
+				types = append(types, "TCP")
+			case check.Script != "":
+				types = append(types, "COMMAND")
+			}
+		}
+		registeredTypes = append(registeredTypes, types)
+	}
+	return registeredTypes
+}
+
+func assertRegisteredHealthCheckTypes(t *testing.T, expected []string, registrations [][]string) {
+	t.Helper()
+	assert.NotEmpty(t, registrations)
+	expected = append([]string(nil), expected...)
+	sort.Strings(expected)
+	for _, types := range registrations {
+		sort.Strings(types)
+		assert.Equal(t, expected, types)
+	}
+}
