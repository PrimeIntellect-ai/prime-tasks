+def test_boyer_moore_example():
+    positions = find("THIS IS A TEST TEXT", "TEST", "boyer_moore")
+    assert [int(p) for p in ast.literal_eval(str(positions))] == [10]
+
+
+class _CountingText(str):
+    def __new__(cls, value):
+        obj = super().__new__(cls, value)
+        obj.reads = 0
+        return obj
+
+    def __getitem__(self, index):
+        self.reads += 1
+        return super().__getitem__(index)
+
+
+def test_boyer_moore_skips_text():
+    # The query's characters never occur in the text, so a Boyer-Moore
+    # search shifts the query past large parts of the text instead of
+    # examining every character of it.
+    n = 10000
+    text = _CountingText("a" * n)
+    positions = find(text, "b" * 10, "boyer_moore")
+    assert positions.size == 0
+    assert text.reads < n // 2
