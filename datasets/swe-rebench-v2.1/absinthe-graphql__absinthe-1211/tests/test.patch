+          name
+        }
+      }
+    }
+    """
+
+    expected_data = %{
+      "users" => [
+        %{"organization" => %{"name" => "Organization: #1 - unresolved"}},
+        %{"organization" => %{"name" => "Organization: #2 - unresolved"}},
+        %{"organization" => %{"name" => "Organization: #3 - unresolved"}}
+      ]
+    }
+
+    assert {:ok, %{data: data}} = Absinthe.run(doc, DefaultSchema)
+    assert expected_data == data
+
+    assert_receive(:loading)
+  end
