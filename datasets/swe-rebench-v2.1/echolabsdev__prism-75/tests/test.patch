+
+it('represents nullable schema types as unions with null', function (): void {
+    $nullableSchemas = [
+        'string' => new StringSchema('name', 'the users name', true),
+        'number' => new NumberSchema('age', 'the users age', true),
+        'boolean' => new BooleanSchema('is_admin', 'is an administrative user', true),
+        'array' => new ArraySchema(
+            'hobbies',
+            'the users hobbies',
+            new StringSchema('hobby', 'the users hobby'),
+            true
+        ),
+        'object' => new ObjectSchema(
+            'user',
+            'a user object',
+            [],
+            [],
+            false,
+            true
+        ),
+    ];
+
+    foreach ($nullableSchemas as $type => $schema) {
+        $serializedType = $schema->toArray()['type'];
+        expect($serializedType)->toBeArray()->toContain($type)->toContain('null');
+    }
+
+    $serializedEnum = (new EnumSchema(
+        'status',
+        'the users status',
+        ['active', 'inactive', 'suspended'],
+        true
+    ))->toArray();
+
+    expect($serializedEnum['type'])->toBeArray()->toContain('string')->toContain('null');
+    expect($serializedEnum['enum'])->toBe(['active', 'inactive', 'suspended']);
+    expect($serializedEnum['description'])->toBe('the users status');
+});
+
+it('adds null to mixed enum types without changing its allowed values or description', function (): void {
+    $serialized = (new EnumSchema(
+        'temp',
+        'sick or fever temp',
+        [98.6, 100, 'unknown', 105],
+        true
+    ))->toArray();
+
+    expect($serialized['type'])->toBeArray()->toContain('number')->toContain('string')->toContain('null');
+    expect($serialized['enum'])->toBe([98.6, 100, 'unknown', 105]);
+    expect($serialized['description'])->toBe('sick or fever temp');
+});
+
+it('defaults each schema type to non-nullable when omitted', function (): void {
+    $schemas = [
+        new StringSchema('name', 'the users name'),
+        new NumberSchema('age', 'the users age'),
+        new BooleanSchema('is_admin', 'is an administrative user'),
+        new ArraySchema('hobbies', 'the users hobbies', new StringSchema('hobby', 'the users hobby')),
+        new ObjectSchema('user', 'a user object', []),
+        new EnumSchema('status', 'the users status', ['active', 'inactive']),
+    ];
+
+    foreach ($schemas as $schema) {
+        expect($schema->toArray()['type'])->not->toContain('null');
+    }
+});
+
+it('non-nullable enum retains its description and values', function (): void {
+    $enumSchema = new EnumSchema(
+        name: 'user_type',
+        description: 'the type of user',
+        options: ['admin', 'super_admin', 'standard']
+    );
+
+    $serialized = $enumSchema->toArray();
+    unset($serialized['type']);
+
+    expect($serialized)->toBe([
+        'description' => 'the type of user',
+        'enum' => ['admin', 'super_admin', 'standard'],
+    ]);
+});
+
+it('accepts nullable as the final optional constructor argument', function (): void {
+    foreach ([
+        StringSchema::class,
+        NumberSchema::class,
+        BooleanSchema::class,
+        ArraySchema::class,
+        ObjectSchema::class,
+        EnumSchema::class,
+    ] as $schemaClass) {
+        $parameters = (new \ReflectionClass($schemaClass))->getConstructor()->getParameters();
+        $nullable = $parameters[array_key_last($parameters)];
+
+        expect($nullable->getName())->toBe('nullable');
+        expect($nullable->isOptional())->toBeTrue();
+        expect($nullable->getDefaultValue())->toBeFalse();
+    }
+});
+
+it('nullable properties remain required', function (): void {
+    $schema = new ObjectSchema(
+        'record',
+        'a record',
+        [new StringSchema('value', 'a possibly absent value', true)],
+        ['value']
+    );
+
+    $serialized = $schema->toArray();
+
+    expect($serialized['properties']['value']['type'])->toContain('null');
+    expect($serialized['required'])->toContain('value');
+});
