diff --git a/src/Concerns/NullableSchema.php b/src/Concerns/NullableSchema.php
new file mode 100644
index 0000000..0719244
--- /dev/null
+++ b/src/Concerns/NullableSchema.php
@@ -0,0 +1,14 @@
+<?php
+
+namespace EchoLabs\Prism\Concerns;
+
+trait NullableSchema
+{
+    /**
+     * @return array<int, string>
+     */
+    protected function castToNullable(string $type): array
+    {
+        return [$type, 'null'];
+    }
+}
