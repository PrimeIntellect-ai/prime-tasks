+func TestConfiguredAlbumStrategyUsedByFolderUpload(t *testing.T) {
+	source := t.TempDir()
+	for _, p := range []string{"2018/Christmas/photo.jpg", "2019/Christmas/photo.jpg"} {
+		full := filepath.Join(source, filepath.FromSlash(p))
+		if err := os.MkdirAll(filepath.Dir(full), 0755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(full, []byte("x"), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	configDir := t.TempDir()
+	configText := fmt.Sprintf(`{
+  SecretsBackendType: auto,
+  APIAppCredentials: { ClientID: "client", ClientSecret: "secret" },
+  jobs: [{
+    account: "user@example.com",
+    sourceFolder: %q,
+    makeAlbums: { enabled: true, use: "folderPath" },
+    deleteAfterUpload: false,
+    uploadVideos: true,
+    includePatterns: ["*"],
+    excludePatterns: []
+  }]
+}`, source)
+	if err := os.WriteFile(filepath.Join(configDir, "config.hjson"), []byte(configText), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	cfg, err := config.LoadConfig(configDir)
+	if err != nil {
+		t.Fatalf("LoadConfig failed: %v", err)
+	}
+	jobConfig := cfg.Jobs[0]
+	client, rec := newAlbumRecordingClient(t)
+	options := NewJobOptions(jobConfig.MakeAlbums.Enabled, jobConfig.MakeAlbums.Use, jobConfig.DeleteAfterUpload,
+		NewFilter(jobConfig.IncludePatterns, jobConfig.ExcludePatterns, jobConfig.UploadVideos))
+	job := NewFolderUploadJob(client, noopFileTracker{}, jobConfig.SourceFolder, options)
+	items, err := job.ScanFolder(log.Discard)
+	if err != nil {
+		t.Fatalf("ScanFolder failed: %v", err)
+	}
+	if len(items) != 2 {
+		t.Errorf("ScanFolder returned %d items, want the 2 eligible files", len(items))
+	}
+
+	want := map[string]bool{"2018_Christmas": false, "2019_Christmas": false}
+	for _, title := range rec.all() {
+		if _, ok := want[title]; ok {
+			want[title] = true
+		}
+	}
+	for title, found := range want {
+		if !found {
+			t.Errorf("configured folderPath strategy did not create album %q; got %v", title, rec.all())
+		}
+	}
+}
