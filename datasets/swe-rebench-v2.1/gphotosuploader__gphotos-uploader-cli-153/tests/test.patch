+// TestJob_ScanFolder_AlbumName verifies that the album created for an uploaded
+// item follows the configured naming strategy. Two files living in folders that
+// share the same last component ("2018/Christmas" and "2019/Christmas") must
+// not collide when the full folder path is used.
+func TestJob_ScanFolder_AlbumName(t *testing.T) {
+	source := t.TempDir()
+	for _, p := range []string{"2018/Christmas/photo.jpg", "2019/Christmas/photo.jpg"} {
+		full := filepath.Join(source, filepath.FromSlash(p))
+		if err := os.MkdirAll(filepath.Dir(full), 0755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(full, []byte("x"), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	t.Run("folderPath", func(t *testing.T) {
+		client, rec := newAlbumRecordingClient(t)
+		opt := NewJobOptions(true, "folderPath", false, NewFilter([]string{"*"}, nil, true))
+		job := NewFolderUploadJob(client, noopFileTracker{}, source, opt)
+		items, err := job.ScanFolder(log.Discard)
+		if err != nil {
+			t.Fatalf("ScanFolder failed: %v", err)
+		}
+		if len(items) != 2 {
+			t.Errorf("ScanFolder returned %d items, want the 2 eligible files", len(items))
+		}
+
+		titles := rec.all()
+		if len(titles) < 2 {
+			t.Fatalf("expected an album per folder, got %v", titles)
+		}
+		var has2018, has2019 bool
+		for _, title := range titles {
+			if strings.Contains(title, "2018") && strings.Contains(title, "Christmas") {
+				has2018 = true
+			}
+			if strings.Contains(title, "2019") && strings.Contains(title, "Christmas") {
+				has2019 = true
+			}
+		}
+		if !has2018 || !has2019 {
+			t.Errorf("folderPath must use more than the last folder component, got %v", titles)
+		}
+	})
+
+	t.Run("folderName", func(t *testing.T) {
+		client, rec := newAlbumRecordingClient(t)
+		opt := NewJobOptions(true, "folderName", false, NewFilter([]string{"*"}, nil, true))
+		job := NewFolderUploadJob(client, noopFileTracker{}, source, opt)
+		items, err := job.ScanFolder(log.Discard)
+		if err != nil {
+			t.Fatalf("ScanFolder failed: %v", err)
+		}
+		if len(items) != 2 {
+			t.Errorf("ScanFolder returned %d items, want the 2 eligible files", len(items))
+		}
+
+		titles := rec.all()
+		if len(titles) == 0 {
+			t.Fatal("expected at least one album to be created")
+		}
+		for _, title := range titles {
+			if title != "Christmas" {
+				t.Errorf("folderName must use only the last folder component, got %v", titles)
+			}
+		}
+	})
+}
