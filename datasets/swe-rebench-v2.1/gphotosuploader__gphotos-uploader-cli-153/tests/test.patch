+// noopFileTracker is a FileTracker that never reports a file as already uploaded.
+type noopFileTracker struct{}
+
+func (noopFileTracker) CacheAsAlreadyUploaded(string) error    { return nil }
+func (noopFileTracker) IsAlreadyUploaded(string) (bool, error) { return false, nil }
+func (noopFileTracker) RemoveAsAlreadyUploaded(string) error   { return nil }
+
+// albumRecorder records the titles of the albums created through the Google
+// Photos API.
+type albumRecorder struct {
+	mu     sync.Mutex
+	titles []string
+}
+
+func (r *albumRecorder) add(title string) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.titles = append(r.titles, title)
+}
+
+func (r *albumRecorder) all() []string {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return append([]string(nil), r.titles...)
+}
+
+// newAlbumRecordingClient returns a gphotos client backed by a fake Google
+// Photos API that records the title of every album it is asked to create.
+func newAlbumRecordingClient(t *testing.T) (*gphotos.Client, *albumRecorder) {
+	t.Helper()
+
+	rec := &albumRecorder{}
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch {
+		case r.Method == http.MethodGet && r.URL.Path == "/v1/albums":
+			fmt.Fprint(w, `{"albums":[]}`)
+		case r.Method == http.MethodPost && r.URL.Path == "/v1/albums":
+			var req struct {
+				Album struct {
+					Title string `json:"title"`
+				} `json:"album"`
+			}
+			_ = json.NewDecoder(r.Body).Decode(&req)
+			rec.add(req.Album.Title)
+			fmt.Fprintf(w, `{"id":"album-id","title":%q}`, req.Album.Title)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	t.Cleanup(srv.Close)
+
+	client, err := gphotos.NewClient(srv.Client())
+	if err != nil {
+		t.Fatalf("failed to create gphotos client: %v", err)
+	}
+	client.BasePath = srv.URL + "/"
+	return client, rec
+}
