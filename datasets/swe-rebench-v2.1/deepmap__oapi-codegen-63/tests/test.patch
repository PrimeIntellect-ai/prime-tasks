+package codegen
+
+import (
+	"testing"
+
+	"github.com/getkin/kin-openapi/openapi3"
+)
+
+func TestOperationDefinitionsGenerateMissingOperationIDs(t *testing.T) {
+	swagger := &openapi3.Swagger{}
+	swagger.AddOperation("/v1/items", "GET", &openapi3.Operation{})
+	swagger.AddOperation("/v1/items", "POST", &openapi3.Operation{})
+	swagger.AddOperation("/v1/owners", "GET", &openapi3.Operation{OperationID: "LookupOwner"})
+
+	operations, err := OperationDefinitions(swagger)
+	if err != nil {
+		t.Fatalf("OperationDefinitions returned an error for operations without IDs: %v", err)
+	}
+	if len(operations) != 3 {
+		t.Fatalf("got %d operation definitions, want 3", len(operations))
+	}
+
+	ids := make(map[string]bool, len(operations))
+	for _, operation := range operations {
+		if operation.OperationId == "" {
+			t.Fatalf("operation %s %s has no generated ID", operation.Method, operation.Path)
+		}
+		if ids[operation.OperationId] {
+			t.Fatalf("generated operation ID %q is not unique", operation.OperationId)
+		}
+		ids[operation.OperationId] = true
+	}
+	if !ids["LookupOwner"] {
+		t.Fatalf("explicit operation ID was not preserved; got IDs %v", ids)
+	}
+}
