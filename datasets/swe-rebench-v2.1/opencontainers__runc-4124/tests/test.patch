+
+	spec := &specs.Spec{
+		Root: &specs.Root{Path: "rootfs"},
+		Linux: &specs.Linux{
+			Namespaces: []specs.LinuxNamespace{{Type: "user", Path: "/proc/1/ns/user"}},
+		},
+	}
+	config, err := CreateLibcontainerConfig(&CreateOpts{Spec: spec})
+	if err != nil {
+		t.Fatalf("joining a user namespace without explicit mappings should succeed: %v", err)
+	}
+
+	if got := config.Namespaces.PathOf(configs.NEWUSER); got != "/proc/1/ns/user" {
+		t.Errorf("user namespace path = %q, want %q", got, "/proc/1/ns/user")
+	}
+}
