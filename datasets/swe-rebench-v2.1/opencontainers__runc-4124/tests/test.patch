+func TestJoinUserNamespaceUsesEffectiveMappingsWithoutExplicitMappings(t *testing.T) {
+	if _, err := os.Stat("/proc/self/ns/user"); os.IsNotExist(err) {
+		t.Skip("Test requires userns.")
