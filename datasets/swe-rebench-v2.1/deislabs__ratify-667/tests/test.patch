+// Verifies that a configured client ID takes precedence over the environment ID
+// when the public auth-provider configuration creates a workload identity provider.
+func TestAzureWIConfiguredClientIDPrecedesEnvironment(t *testing.T) {
+	observedClientID := make(chan string, 1)
+	certificatePEM, certificate := azureAuthorityCertificate(t)
+	azureEndpoint := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if strings.Contains(r.URL.Path, "/discovery/instance") {
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = io.WriteString(w, `{"tenant_discovery_endpoint":"https://login.microsoftonline.com/test-tenant/v2.0/.well-known/openid-configuration","metadata":[{"preferred_network":"login.microsoftonline.com","preferred_cache":"login.microsoftonline.com","aliases":["login.microsoftonline.com"]}]}`)
+			return
+		}
+		if r.Method == http.MethodGet {
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = io.WriteString(w, `{"issuer":"https://login.microsoftonline.com/test-tenant/v2.0","authorization_endpoint":"https://login.microsoftonline.com/test-tenant/oauth2/v2.0/authorize","token_endpoint":"https://login.microsoftonline.com/test-tenant/oauth2/v2.0/token"}`)
+			return
+		}
+		if err := r.ParseForm(); err != nil {
+			http.Error(w, "invalid form", http.StatusBadRequest)
+			return
+		}
+		observedClientID <- r.PostForm.Get("client_id")
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusBadRequest)
+		_, _ = io.WriteString(w, `{"error":"invalid_grant","error_description":"test token endpoint"}`)
+	}))
+	azureEndpoint.TLS = &tls.Config{Certificates: []tls.Certificate{certificate}}
+	azureEndpoint.StartTLS()
+	defer azureEndpoint.Close()
+
+	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodConnect {
+			http.Error(w, "CONNECT required", http.StatusMethodNotAllowed)
+			return
+		}
+		client, buffered, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			return
+		}
+		defer client.Close()
+		_, _ = buffered.WriteString("HTTP/1.1 200 Connection Established\r\n\r\n")
+		if err := buffered.Flush(); err != nil {
+			return
+		}
+		upstream, err := net.Dial("tcp", azureEndpoint.Listener.Addr().String())
+		if err != nil {
+			return
+		}
+		defer upstream.Close()
+		go func() { _, _ = io.Copy(upstream, client); _ = upstream.Close() }()
+		_, _ = io.Copy(client, upstream)
+	}))
+	defer proxy.Close()
+
+	certFile := filepath.Join(t.TempDir(), "authority.pem")
+	if err := os.WriteFile(certFile, certificatePEM, 0600); err != nil {
+		t.Fatalf("failed to write local authority certificate: %v", err)
+	}
+	t.Setenv("SSL_CERT_FILE", certFile)
+	t.Setenv("HTTPS_PROXY", proxy.URL)
+	t.Setenv("https_proxy", proxy.URL)
+	t.Setenv("NO_PROXY", "")
+	t.Setenv("no_proxy", "")
+	t.Setenv("AZURE_TENANT_ID", "test-tenant")
+	t.Setenv("AZURE_CLIENT_ID", "service-account-client")
+	t.Setenv("AZURE_FEDERATED_TOKEN_FILE", filepath.Join(t.TempDir(), "federated-token"))
+	if err := os.WriteFile(os.Getenv("AZURE_FEDERATED_TOKEN_FILE"), []byte("header.payload.signature"), 0600); err != nil {
+		t.Fatalf("failed to write federated token: %v", err)
+	}
+	t.Setenv("AZURE_AUTHORITY_HOST", "https://login.microsoftonline.com/")
+
+	workloadIdentityProvider, err := authprovider.CreateAuthProviderFromConfig(map[string]interface{}{
+		"name":     "azureWorkloadIdentity",
+		"clientID": "configured-client",
+	})
+	if err == nil {
+		// A provider may defer obtaining its token until credentials are requested.
+		_, _ = workloadIdentityProvider.Provide(context.Background(), "https://example.azurecr.io")
+	}
+
+	select {
+	case got := <-observedClientID:
+		if got != "configured-client" {
+			t.Fatalf("token exchange client ID = %q, want configured client ID", got)
+		}
+	default:
+		t.Fatal("workload-identity token request did not use the configured client ID")
+	}
+}
