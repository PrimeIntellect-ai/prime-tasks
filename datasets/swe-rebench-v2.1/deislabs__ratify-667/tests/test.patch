+// Verifies that a Store's parameters.authProvider configuration carries the
+// workload identity client ID into the rendered Store custom resource.
+func TestStoreCRD_AuthProviderClientID(t *testing.T) {
+	root := repoRoot(t)
+	templatePath := filepath.Join(root, "charts", "ratify", "templates", "store.yaml")
+	templateBytes, err := os.ReadFile(templatePath)
+	if err != nil {
+		t.Fatalf("failed to read store template: %v", err)
+	}
+
+	funcs := template.FuncMap{
+		"include": func(name string, data interface{}) string { return "ratify-service-account" },
+	}
+	storeTemplate, err := template.New("store").Funcs(funcs).Parse(string(templateBytes))
+	if err != nil {
+		t.Fatalf("failed to parse store template: %v", err)
+	}
+
+	const clientID = "190d0258-5c9d-4ef2-890f-e12c163a2b3e"
+	values := map[string]interface{}{
+		"Values": map[string]interface{}{
+			"oras": map[string]interface{}{
+				"useHttp": false,
+				"authProviders": map[string]interface{}{
+					"azureWorkloadIdentityEnabled": true,
+				},
+				"cache": map[string]interface{}{"enabled": false},
+			},
+			"cosign":                map[string]interface{}{"enabled": false},
+			"azureWorkloadIdentity": map[string]interface{}{"clientId": clientID},
+			"azureManagedIdentity":  map[string]interface{}{"clientId": ""},
+		},
+	}
+
+	var rendered bytes.Buffer
+	if err := storeTemplate.Execute(&rendered, values); err != nil {
+		t.Fatalf("failed to render store template: %v", err)
+	}
+
+	var store map[string]interface{}
+	if err := yaml.Unmarshal(rendered.Bytes(), &store); err != nil {
+		t.Fatalf("failed to parse rendered store: %v", err)
+	}
+
+	spec, ok := store["spec"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("rendered store has no spec: %v", store)
+	}
+	parameters, ok := spec["parameters"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("rendered store has no spec.parameters: %v", spec)
+	}
+	authProvider, ok := parameters["authProvider"].(map[string]interface{})
+	if !ok {
+		t.Fatalf("rendered store has no spec.parameters.authProvider: %v", parameters)
+	}
+	if got := authProvider["clientID"]; got != clientID {
+		t.Fatalf("rendered store authProvider.clientID = %v, want %v", got, clientID)
+	}
+}
