+    /**
+     * @covers \horstoeko\zugferd\ZugferdDocumentBuilder::addDocumentSellerId
+     * @covers \horstoeko\zugferd\ZugferdDocumentBuilder::addDocumentBuyerId
+     */
+    public function testAddMultipleSellerAndBuyerIdsInBasicProfile(): void
+    {
+        $document = ZugferdDocumentBuilder::CreateNew(ZugferdProfiles::PROFILE_BASIC);
+        $document->setDocumentSeller("Lieferant GmbH", "549910");
+        $document->addDocumentSellerId("910");
+        $document->addDocumentSellerId("seller-secondary");
+        $document->setDocumentBuyer("Kunden AG Mitte", "549911");
+        $document->addDocumentBuyerId("911");
+        $document->addDocumentBuyerId("buyer-secondary");
+
+        $xml = new \SimpleXMLElement($document->getContent());
+
+        $sellerIds = $xml->xpath('/rsm:CrossIndustryInvoice/rsm:SupplyChainTradeTransaction/ram:ApplicableHeaderTradeAgreement/ram:SellerTradeParty/ram:ID');
+        $this->assertCount(3, $sellerIds);
+        $this->assertEquals("549910", (string)$sellerIds[0]);
+        $this->assertEquals("910", (string)$sellerIds[1]);
+        $this->assertEquals("seller-secondary", (string)$sellerIds[2]);
+
+        $buyerIds = $xml->xpath('/rsm:CrossIndustryInvoice/rsm:SupplyChainTradeTransaction/ram:ApplicableHeaderTradeAgreement/ram:BuyerTradeParty/ram:ID');
+        $this->assertCount(3, $buyerIds);
+        $this->assertEquals("549911", (string)$buyerIds[0]);
+        $this->assertEquals("911", (string)$buyerIds[1]);
+        $this->assertEquals("buyer-secondary", (string)$buyerIds[2]);
+    }
+
+    public function testAddSellerAndBuyerIdsWithoutExistingIdsInBasicProfile(): void
+    {
+        $document = ZugferdDocumentBuilder::CreateNew(ZugferdProfiles::PROFILE_BASIC);
+        $document->setDocumentSeller("Seller without an identifier");
+        $document->setDocumentBuyer("Buyer without an identifier");
+        $document->addDocumentSellerId("seller-without-prior-id");
+        $document->addDocumentBuyerId("buyer-without-prior-id");
+
+        $xml = new \SimpleXMLElement($document->getContent());
+        $sellerIds = $xml->xpath('/rsm:CrossIndustryInvoice/rsm:SupplyChainTradeTransaction/ram:ApplicableHeaderTradeAgreement/ram:SellerTradeParty/ram:ID');
+        $buyerIds = $xml->xpath('/rsm:CrossIndustryInvoice/rsm:SupplyChainTradeTransaction/ram:ApplicableHeaderTradeAgreement/ram:BuyerTradeParty/ram:ID');
+
+        $this->assertCount(1, $sellerIds);
+        $this->assertSame("seller-without-prior-id", (string)$sellerIds[0]);
+        $this->assertCount(1, $buyerIds);
+        $this->assertSame("buyer-without-prior-id", (string)$buyerIds[0]);
+    }
+
