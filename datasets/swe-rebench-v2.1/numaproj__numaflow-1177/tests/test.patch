+func TestJetStreamSingleReplicaCanCreateSideInputStoreOnSingleMember(t *testing.T) {
+	server := natsTest.RunJetStreamServer(t)
+	defer natsTest.ShutdownJetStreamServer(t, server)
+
+	client := natsTest.JetStreamClient(t, server)
+	defer client.Close()
+	t.Setenv(dfv1.EnvISBSvcJetStreamURL, server.ClientURL())
+	t.Setenv(dfv1.EnvISBSvcJetStreamUser, "user")
+	t.Setenv(dfv1.EnvISBSvcJetStreamPassword, "password")
+
+	service, err := isbsvc.NewISBJetStreamSvc("single", isbsvc.WithJetStreamClient(client))
+	if !assert.NoError(t, err) {
+		return
+	}
+	err = service.CreateBuffersAndBuckets(context.Background(), []string{"buffer"}, nil, "side-inputs", isbsvc.WithConfig("stream:\n  replicas: 1\n"))
+	if !assert.NoError(t, err, "a single-member JetStream server must accept the buffer and side-input configuration") {
+		return
+	}
+
+	jetStream, err := client.JetStreamContext()
+	if !assert.NoError(t, err) {
+		return
+	}
+	streamInfo, err := jetStream.StreamInfo(isbsvc.JetStreamName("buffer"))
+	if !assert.NoError(t, err) {
+		return
+	}
+	assert.Equal(t, 1, streamInfo.Config.Replicas)
+	_, err = jetStream.KeyValue(isbsvc.JetStreamSideInputsStoreKVName("side-inputs"))
+	assert.NoError(t, err, "the configured side-input store must be created")
+}
