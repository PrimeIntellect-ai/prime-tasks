+test("Duration#normalize makes fields nonnegative when the total is positive", () => {
+  const durations = [
+    { seconds: -44, milliseconds: -100, minutes: 1 },
+    { hours: 96, minutes: 0, seconds: -10 },
+    { minutes: 2, seconds: -90, milliseconds: 500 },
+  ];
+
+  durations.forEach((values) => {
+    const normalized = Duration.fromObject(values).normalize();
+    expect(normalized.toMillis()).toBeGreaterThan(0);
+    expect(Object.values(normalized.toObject()).every((value) => value >= 0)).toBe(true);
+  });
+});
