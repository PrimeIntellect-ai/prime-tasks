+
+#[test]
+pub fn using_all_from_generic_package() {
+    let mut builder = LibraryBuilder::new();
+    builder.code(
+        "libname",
+        "
+package foo is
+  generic (
+    x: natural := 1
+  );
+  type exposed_type is (first, second);
+end package;
+
+package bar is
+  generic (
+    package foo0 is new work.foo
+        generic map (<>)
+  );
+  use foo0.all;
+  subtype local_type is exposed_type;
+end package;
+  ",
+    );
+
+    let diag = builder.analyze();
+    check_no_diagnostics(&diag);
+}
