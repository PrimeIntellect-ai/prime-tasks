+
+  test("bad sql in sql block", () => {
+    const badModel = new BetaModel(`sql: { select: """)""" }`);
+    expect(badModel).modelParsed();
+    const needSchema = badModel.translate();
+    expect(needSchema.compileSQL).toBeDefined();
+    if (needSchema.compileSQL) {
+      badModel.update({
+        errors: {
+          compileSQL: {
+            [needSchema.compileSQL.name]: "ZZZZ",
+          },
+        },
+      });
+    }
+    badModel.translate();
+    const errors = badModel.errors().errors;
+    expect(errors.length).toBeGreaterThan(0);
+    const message = errors[0].message;
+    // The underlying SQL error must be preserved in the reported message.
+    expect(message).toContain("ZZZZ");
+    // It must be reported as a SQL error, not as a generic schema error.
+    expect(message).toMatch(/SQL/i);
+    expect(message).not.toMatch(/schema error/i);
+  });
+
+  test("bad sql in sql block preserves diagnostic content", () => {
+    const badModel = new BetaModel(`sql: { select: """)""" }`);
+    expect(badModel).modelParsed();
+    const needSchema = badModel.translate();
+    expect(needSchema.compileSQL).toBeDefined();
+    if (needSchema.compileSQL) {
+      badModel.update({
+        errors: {
+          compileSQL: {
+            [needSchema.compileSQL.name]: "first line\nsecond line",
+          },
+        },
+      });
+    }
+    badModel.translate();
+    const errors = badModel.errors().errors;
+    expect(errors.length).toBeGreaterThan(0);
+    const message = errors[0].message;
+    // The underlying SQL error must be preserved.
+    expect(message).toContain("first line");
+    expect(message).toContain("second line");
+  });
