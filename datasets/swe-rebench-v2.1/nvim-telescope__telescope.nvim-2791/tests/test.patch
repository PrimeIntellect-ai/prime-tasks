+
+describe("separates file path location", function()
+  -- `file` is only checked where the contract defines the stripped path.
+  local suites = {
+    {
+      input = "file.txt:12:4",
+      file = "file.txt",
+      row = 12,
+      col = 4,
+    },
+    {
+      input = "file.txt:12",
+      file = "file.txt",
+      row = 12,
+      col = 0,
+    },
+    {
+      input = "file:12:4",
+      file = "file",
+      row = 12,
+      col = 4,
+    },
+    {
+      input = "lua/telescope/utils.lua:12:4",
+      file = "lua/telescope/utils.lua",
+      row = 12,
+      col = 4,
+    },
+    {
+      input = "file.txt",
+      file = "file.txt",
+      row = 0,
+      col = 0,
+    },
+    {
+      input = "file:12:",
+      row = 12,
+      col = 0,
+    },
+    {
+      input = "file:",
+      row = 0,
+      col = 0,
+    },
+    {
+      input = "file:line",
+      row = 0,
+      col = 0,
+    },
+  }
+
+  for _, suite in ipairs(suites) do
+    it("separtates file path for " .. suite.input, function()
+      local file, row, col = utils.__separate_file_path_location(suite.input)
+
+      if suite.file then
+        assert.are.equal(suite.file, file)
+      end
+      assert.are.equal("number", type(row))
+      assert.are.equal("number", type(col))
+      assert.are.equal(row, math.floor(row))
+      assert.are.equal(col, math.floor(col))
+      assert.are.equal(suite.row, row)
+      assert.are.equal(suite.col, col)
+    end)
+  end
+end)
+
+describe("file location input", function()
+  local tester = require "telescope.testharness"
+
+  -- The picker harness runs inside a child Neovim where a deprecation shim
+  -- that is unavailable in this environment is hit when a picker opens.
+  -- Silencing deprecation warnings does not change the behaviour under test.
+  local prelude = "vim.deprecate = function() end\n"
+
+  it("searches using the path without its location suffix", function()
+    tester.run_string(prelude .. [[
+      runner.picker('find_files', 'lua/telescope/utils.lua:12:4', {
+        post_typed = {
+          { true, function()
+              for _, line in ipairs(GetResults()) do
+                if line:find('lua/telescope/utils.lua', 1, true) then
+                  return true
+                end
+              end
+              return false
+            end },
+        },
+      })
+    ]])
+  end)
+
+  -- The harness sends one extra <CR> after the selection, which moves the cursor
+  -- down by one line (to the first non-blank character), so the row may be the
+  -- requested line or the line after it.
+  it("opens the selected file at the requested line and column", function()
+    tester.run_string(prelude .. [[
+      runner.picker('find_files', 'lua/telescope/utils.lua:12:4', {
+        post_close = {
+          { 'utils.lua', GetFile },
+          { true, function()
+              local cursor = vim.api.nvim_win_get_cursor(0)
+              return (cursor[1] == 12 or cursor[1] == 13) and (cursor[2] == 0 or cursor[2] == 3 or cursor[2] == 4)
+            end },
+        },
+      })
+    ]])
+  end)
+
+  it("opens the selected file at the requested line when no column is given", function()
+    tester.run_string(prelude .. [[
+      runner.picker('find_files', 'lua/telescope/utils.lua:12', {
+        post_close = {
+          { 'utils.lua', GetFile },
+          { true, function()
+              local cursor = vim.api.nvim_win_get_cursor(0)
+              return (cursor[1] == 12 or cursor[1] == 13) and cursor[2] == 0
+            end },
+        },
+      })
+    ]])
+  end)
+end)
