+	it('should automatically detect misspelled license files', async () => {
+		const manifest = {
+			name: 'test',
+			publisher: 'mocha',
+			version: '0.0.1',
+			description: 'test extension',
+			engines: Object.create(null),
+		};
+
+		for (const licensePath of [
+			'extension/LICENCE',
+			'extension/LICENCE.md',
+			'extension/LICENCE.txt',
+			'extension/licence',
+			'extension/licence.md',
+			'extension/licence.txt',
+		]) {
+			const result = await toXMLManifest(manifest, [{ path: licensePath, contents: '' }]);
+			const expectedPaths = path.extname(licensePath) ? [licensePath] : [licensePath, `${licensePath}.txt`];
+			assert.ok(
+				result.PackageManifest.Metadata[0].License?.some(license => expectedPaths.includes(license)),
+				`Expected ${licensePath} to be detected as the license`
+			);
+			assert.ok(
+				result.PackageManifest.Assets[0].Asset.some(
+					asset =>
+						asset.$.Type === 'Microsoft.VisualStudio.Services.Content.License' &&
+						expectedPaths.includes(asset.$.Path)
+				),
+				`Expected ${licensePath} to be emitted as a license asset`
+			);
+		}
+	});
+
