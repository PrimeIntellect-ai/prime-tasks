+// testWebsocketNoTLSOptions returns the WebSocket options obtained by
+// processing a configuration that enables the non-TLS WebSocket transport.
+func testWebsocketNoTLSOptions(t *testing.T) WebsocketOpts {
+	t.Helper()
+	conf := createConfFile(t, []byte(`websocket { no_tls: true }`))
+	defer os.Remove(conf)
+	o, err := ProcessConfigFile(conf)
+	if err != nil {
+		t.Fatalf("Error processing configuration: %v", err)
+	}
+	return o.Websocket
+}
 
+func TestWebsocketNoTLS(t *testing.T) {
+	conf := createConfFile(t, []byte(`
+		websocket {
+			host: "127.0.0.1"
+			port: -1
+			no_tls: true
+		}
+	`))
+	defer os.Remove(conf)
+	o, err := ProcessConfigFile(conf)
+	if err != nil {
+		t.Fatalf("Error processing configuration: %v", err)
+	}
+	s := RunServer(o)
+	defer s.Shutdown()
+
+	// The WebSocket listener must accept a plain (non-TLS) connection and
+	// complete the WebSocket upgrade handshake.
+	addr := fmt.Sprintf("%s:%d", o.Websocket.Host, o.Websocket.Port)
+	c, err := net.Dial("tcp", addr)
+	if err != nil {
+		t.Fatalf("Error dialing websocket: %v", err)
+	}
+	defer c.Close()
+	req := &http.Request{
+		Method: "GET",
+		Host:   addr,
+		Proto:  "HTTP/1.1",
+		Header: http.Header{},
+	}
+	req.Header.Set("Upgrade", "websocket")
+	req.Header.Set("Connection", "Upgrade")
+	req.Header.Set("Sec-Websocket-Key", "dGhlIHNhbXBsZSBub25jZQ==")
+	req.Header.Set("Sec-Websocket-Version", "13")
+	req.URL, _ = url.Parse("ws://" + addr)
+	if err := req.Write(c); err != nil {
+		t.Fatalf("Error sending request: %v", err)
+	}
+	br := bufio.NewReader(c)
+	resp, err := http.ReadResponse(br, req)
+	if err != nil {
+		t.Fatalf("Error reading response: %v", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusSwitchingProtocols {
+		t.Fatalf("Expected response status %v, got %v", http.StatusSwitchingProtocols, resp.StatusCode)
+	}
+}
+
