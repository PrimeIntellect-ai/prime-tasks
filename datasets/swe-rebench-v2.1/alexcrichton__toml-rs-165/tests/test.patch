+#[test]
+fn deserialize_unit_enum_from_toml_string() {
+    #[derive(Deserialize, PartialEq, Debug)]
+    struct Foo { a: Sort }
+
+    #[derive(Deserialize, PartialEq, Debug)]
+    #[serde(rename_all = "lowercase")]
+    enum Sort {
+        Asc,
+        Desc,
+    }
+
+    let from_text: Foo = t!(toml::from_str("a = \"desc\""));
+    assert_eq!(from_text, Foo { a: Sort::Desc });
+
+    let from_text: Foo = t!(toml::from_str("a = \"asc\""));
+    assert_eq!(from_text, Foo { a: Sort::Asc });
+}
