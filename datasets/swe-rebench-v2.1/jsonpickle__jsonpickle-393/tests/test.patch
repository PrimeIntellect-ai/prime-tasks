+def test_np_poly1d():
+    # issue 391, test poly1d roundtrip
+    obj = np.poly1d([1, 2, 3])
+    assert obj == jsonpickle.decode(jsonpickle.encode(obj))
+
+
+class _PolyHolder(object):
+    def __init__(self, poly):
+        self.poly = poly
+
+
+def test_np_poly1d_as_object_property():
+    # a poly1d stored as a property of another object must restore cleanly
+    holder = _PolyHolder(np.poly1d([1, 2, 3], variable='x'))
+    restored = roundtrip(holder)
+    assert isinstance(restored, _PolyHolder)
+    assert isinstance(restored.poly, np.poly1d)
+    assert restored.poly == holder.poly
+    npt.assert_array_equal(restored.poly.coeffs, holder.poly.coeffs)
+
+
 if __name__ == '__main__':
     pytest.main([__file__])
