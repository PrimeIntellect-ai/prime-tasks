+def test_min_if(language):
+    def f(x : 'int', y : 'int'):
+        if min(x+x+y, x+y+y) < (x+y):
+            return x+y
+        else:
+            return x-y
+
+    epyc_f = epyccel(f, language=language)
+
+    for int_args in ((1, 1), (-1, 2)):
+        assert epyc_f(*int_args) == f(*int_args)
+
+def side_effecting_call_in_if_condition(k: int):
+    values = {1: 1.0, 2: 2.0}
+    conditions = {1: True, 2: False}
+    if conditions.pop(k):
+        return values.pop(k)
+    else:
+        return 3.0
+
+def test_side_effecting_call_in_if_condition():
+    epyc_f = epyccel(side_effecting_call_in_if_condition, language='c')
+
+    assert epyc_f(1) == side_effecting_call_in_if_condition(1) == 1.0
+    assert epyc_f(2) == side_effecting_call_in_if_condition(2) == 3.0
+
+def test_min_in_min(language):
+    def f(x : 'int', y : 'int'):
+        if min(min(x+x,+y), min(x+y,y)) < (x+y): #pylint: disable=nested-min-max
+            return x+y
+        else:
+            return x-y
+
+    epyc_f = epyccel(f, language=language)
+
+    int_args = [randint(min_int//3, max_int//3) for _ in range(2)]
+
+    assert epyc_f(*int_args) == f(*int_args)
+
