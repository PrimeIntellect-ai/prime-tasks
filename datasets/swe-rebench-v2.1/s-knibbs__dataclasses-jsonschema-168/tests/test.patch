+def _canonicalize_one_of_order(value):
+    if isinstance(value, dict):
+        normalized = {key: _canonicalize_one_of_order(item) for key, item in value.items()}
+        if 'oneOf' in normalized:
+            normalized['oneOf'] = sorted(
+                normalized['oneOf'], key=lambda alternative: json.dumps(alternative, sort_keys=True)
+            )
+        return normalized
+    if isinstance(value, list):
+        return [_canonicalize_one_of_order(item) for item in value]
+    return value
+
