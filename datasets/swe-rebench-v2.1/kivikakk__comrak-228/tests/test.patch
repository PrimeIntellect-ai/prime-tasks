+#[test]
+fn cli_commonmark_width_before_unwrappable_line() {
+    use std::io::Write;
+    use std::process::{Command, Stdio};
+
+    let input = concat!(
+        "item that doesn't need wrapping\n",
+        "\n",
+        "a-long-line-that-won't-be-wrapped-because-there-is-no-character-it-can-break-on\n"
+    );
+    let expected = input;
+
+    let test_executable = std::env::current_exe().unwrap();
+    let cli_executable = test_executable
+        .parent()
+        .unwrap()
+        .parent()
+        .unwrap()
+        .join(format!("comrak{}", std::env::consts::EXE_SUFFIX));
+    let mut child = Command::new(cli_executable)
+        .args(&["--config-file", "none", "--to", "commonmark", "--width", "72"])
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    child.stdin.take().unwrap().write_all(input.as_bytes()).unwrap();
+    let result = child.wait_with_output().unwrap();
+    assert!(result.status.success(), "CLI failed: {}", String::from_utf8_lossy(&result.stderr));
+    compare_strs(&String::from_utf8(result.stdout).unwrap(), expected, "regular");
+}
