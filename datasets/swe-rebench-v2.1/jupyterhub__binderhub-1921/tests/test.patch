+        (
+            GistRepoProvider,
+            "user/12345",
+            "https://2i2c.mybinder.org/v2/gist/user/12345/HEAD",
+        ),
+        (
+            GistRepoProvider,
+            "user/12345/",
+            "https://2i2c.mybinder.org/v2/gist/user/12345/HEAD",
+        ),
+    ],
+)
+def test_detect_regex(provider, repo, expected_launch_url):
+    """A repo URL with a trailing slash must not produce a doubled slash in the
+    launch URL.
+
+    The frontend extracts the repository spec from the user input using the
+    provider's public ``detect.regex`` and then builds the launch URL as
+    ``v2/{provider_id}/{repo}/{ref}``.  This test reproduces that public
+    behaviour and asserts the resulting launch URL.
+    """
+    config = provider.display_config
+    detect_regex = _js_regex(config["detect"]["regex"])
+
+    match = detect_regex.match(repo)
+    assert match is not None
+    repo = match.group("repo")
+
+    ref = config["ref"]["default"]
+    launch_url = f"https://2i2c.mybinder.org/v2/{config['id']}/{repo}/{ref}"
+    assert launch_url == expected_launch_url
