+def _js_regex(pat):
+    """compile a javascript regular expression
+
+    converts js '?<name>' to Python '?P<name>' syntax
+    """
+    return re.compile(pat.replace("?<", "?P<"))
+
+
+@pytest.mark.parametrize(
+    "provider, repo, expected_launch_url",
+    [
+        (
+            GitHubRepoProvider,
+            "https://github.com/org/repo",
+            "https://2i2c.mybinder.org/v2/gh/org/repo/HEAD",
+        ),
+        (
+            GitHubRepoProvider,
+            "http://github.com/org/repo/",
+            "https://2i2c.mybinder.org/v2/gh/org/repo/HEAD",
+        ),
+        (
+            GitHubRepoProvider,
+            "org/repo",
+            "https://2i2c.mybinder.org/v2/gh/org/repo/HEAD",
+        ),
+        (
+            GitHubRepoProvider,
+            "org/repo/",
+            "https://2i2c.mybinder.org/v2/gh/org/repo/HEAD",
+        ),
+        (
+            GitLabRepoProvider,
+            "https://gitlab.com/org/repo",
+            "https://2i2c.mybinder.org/v2/gl/org/repo/HEAD",
