@@ -5,6 +5,72 @@ const os = require('os');
 const semver = require('semver');
 
 const EOL = os.EOL || '\n';
+const ESC = '\x1B';
+
+function isBrightRedRgb(red, green, blue) {
+  return red >= 180 && red >= green * 1.5 && red >= blue * 1.5;
+}
+
+// Walks the output in order, tracking bold and red as cumulative state, so the
+// attributes may come from the same or separate SGR sequences. Bold red is
+// only accepted when both are active over visible text.
+function isBrightRedOutput(output) {
+  const sgr = new RegExp(`${ESC}\\[([0-9;]*)m`, 'g');
+  let bold = false;
+  let red = false;
+  let position = 0;
+  let match = sgr.exec(output);
+  while (match !== null) {
+    if (match.index > position && bold && red) {
+      return true;
+    }
+    position = match.index + match[0].length;
+    const codes = match[1] === '' ? [0] : match[1].split(';').map(Number);
+    for (let i = 0; i < codes.length; i++) {
+      const code = codes[i];
+      if (code === 0) {
+        bold = false;
+        red = false;
+      } else if (code === 1) {
+        bold = true;
+      } else if (code === 22) {
+        bold = false;
+      } else if (code === 31) {
+        red = true;
+      } else if (code === 39) {
+        red = false;
+      } else if (code === 91) {
+        return true;
+      } else if (code === 38 && codes[i + 1] === 5 && codes[i + 2] !== undefined) {
+        const index = codes[i + 2];
+        i += 2;
+        if (index === 9) {
+          return true;
+        }
+        if (index >= 16 && index <= 231) {
+          const levels = [0, 95, 135, 175, 215, 255];
+          const color = index - 16;
+          if (isBrightRedRgb(levels[Math.floor(color / 36)], levels[Math.floor((color % 36) / 6)], levels[color % 6])) {
+            return true;
+          }
+        }
+      } else if (code === 38 && codes[i + 1] === 2 && codes[i + 4] !== undefined) {
+        const rgb = codes.slice(i + 2, i + 5);
+        i += 4;
+        if (isBrightRedRgb(rgb[0], rgb[1], rgb[2])) {
+          return true;
+        }
+      }
+    }
+    match = sgr.exec(output);
+  }
+  return position < output.length && bold && red;
+}
+
+function assertBrightRedOutput(assert, output, expectedText) {
+  assert.ok(isBrightRedOutput(output), 'errors are rendered in bright red');
+  assert.equal(output.replace(new RegExp(`${ESC}\\[[0-9;]*m`, 'g'), ''), expectedText);
+}
 
