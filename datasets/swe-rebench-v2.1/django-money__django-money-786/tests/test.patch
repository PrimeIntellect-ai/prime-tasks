+def test_display_for_field_avoid_link():
+    """Django 5.2 added the `avoid_link` keyword argument to `display_for_field`.
+
+    The djmoney monkey-patch must accept and forward it."""
+    money_field = ModelWithVanillaMoneyField._meta.get_field("money")
+    assert admin_utils.display_for_field(Money(10, "RUB"), money_field, "") == str(Money(10, "RUB"))
+    url_field = models.URLField()
+    assert admin_utils.display_for_field("https://example.com", url_field, "", avoid_link=True) == "https://example.com"
