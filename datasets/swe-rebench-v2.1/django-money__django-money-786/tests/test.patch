+@pytest.mark.skipif(django.VERSION < (5, 2), reason="Deserializer API were added in Django 5.2")
+def test_custom_model_resolution_is_used():
+    """A customized Django model lookup determines the deserialized model."""
+    data = '[{"model": "testapp.unknown_model", "pk": 1, "fields": {"money_currency": "USD", "money": "1.00"}}]'
+    get_model = apps.get_model
+
+    def resolve_model(identifier, *args, **kwargs):
+        if identifier == "testapp.unknown_model":
+            return ModelWithDefaultAsInt
+        return get_model(identifier, *args, **kwargs)
+
+    with patch.object(apps, "get_model", side_effect=resolve_model):
+        for obj in Deserializer(data):
+            obj.save()
+    assert ModelWithDefaultAsInt.objects.get().money == Money(1, "USD")
+
+
+@pytest.mark.skipif(django.VERSION < (5, 2), reason="Deserializer API were added in Django 5.2")
+def test_unresolved_model_raises_deserialization_error():
+    data = '[{"model": "testapp.unknown_model", "pk": 1, "fields": {}}]'
+
