+def test_subset_basic_db(anno_db):
+    anno_db.add_feature(
+        seqid="I", name="selected", biotype="gene", spans=[(10, 20)]
+    )
+    anno_db.add_feature(
+        seqid="II", name="not-selected", biotype="gene", spans=[(30, 40)]
+    )
+
+    subset = anno_db.subset(seqid="I")
+    assert type(subset) is type(anno_db)
+    assert {record["name"] for record in subset.get_records_matching()} == {"selected"}
+
+
+def test_subset_gff3_db(gff_db):
+    subset = gff_db.subset(seqid="I", start=40, end=70, allow_partial=True)
+    # manual inspection of the original GFF3 file indicates 7 records
+    # BUT the CDS records get merged into a single row
+    assert len(subset) == 6
+    # a fresh instance of the same concrete class is returned
+    assert subset is not gff_db
+    assert type(subset) is type(gff_db)
+
+
+def test_subset_returns_new_instance(gff_db):
+    original_len = len(gff_db)
+    subset = gff_db.subset(seqid="I", start=40, end=70, allow_partial=True)
+    # the result is a new object of the same concrete class
+    assert subset is not gff_db
+    assert type(subset) is type(gff_db)
+    # the original db is left unchanged
+    assert len(gff_db) == original_len
+
+
+def test_subset_empty_db(gff_db):
+    subset = gff_db.subset(seqid="X", start=40, end=70, allow_partial=True)
+    # no records
+    assert not len(subset)
+    assert subset is not gff_db
+    assert type(subset) is type(gff_db)
+
+
+def test_subset_gff3_db_with_user(gff_db):
+    record = dict(
+        seqid="I", name="gene-01", biotype="gene", spans=[(23, 43)], strand="+"
+    )
+    gff_db.add_feature(**record)
+    subset = gff_db.subset(seqid="I", start=40, end=70, allow_partial=True)
+    # manual inspection of the original GFF3 file indicates 7 records
+    # BUT the CDS records get merged into a single row
+    assert len(subset) == 7
+
+
+def test_subset_gb_db(gb_db):
+    subset = gb_db.subset(biotype="gene")
+    # manual inspection of the original annotated gb file indicates 2 genes
+    assert len(subset) == 2
+    assert subset is not gb_db
+    assert type(subset) is type(gb_db)
+
+
+def test_subset_allow_partial(gff_db):
+    # records fully contained within the range
+    contained = gff_db.subset(seqid="I", start=40, end=70, allow_partial=False)
+    # the default is allow_partial=False
+    default = gff_db.subset(seqid="I", start=40, end=70)
+    assert len(default) == len(contained)
+    # records that only partially overlap the range are excluded by default
+    partial = gff_db.subset(seqid="I", start=40, end=70, allow_partial=True)
+    assert len(partial) > len(contained)
+    contained_names = {r["name"] for r in contained.get_records_matching()}
+    partial_names = {r["name"] for r in partial.get_records_matching()}
+    # every fully contained record is present when partial overlaps are allowed
+    assert contained_names < partial_names
+
+
+def test_subset_protocol_declares_subset():
+    # SupportsQueryFeatures must declare a subset method whose query
+    # arguments match those of get_records_matching
+    assert hasattr(SupportsQueryFeatures, "subset")
+    params = set(inspect.signature(SupportsQueryFeatures.subset).parameters)
+    assert {"seqid", "biotype", "name", "start", "end", "strand", "attributes"} <= params
+
+
+def test_subset_matches_query(gff_db):
+    query = dict(seqid="I", start=40, end=70, allow_partial=True)
+    subset = gff_db.subset(**query)
+
+    expected_names = {record["name"] for record in gff_db.get_records_matching(**query)}
+    subset_names = {record["name"] for record in subset.get_records_matching()}
+    assert subset_names == expected_names
+    assert type(subset) is type(gff_db)
