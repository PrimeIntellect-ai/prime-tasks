 const validator = new Validator();
 
+/**
+ * Calls `ValidationError.toString` with the `showConstraintMessages` flag set to true.
+ * The cast keeps the call compiling against the pre-feature signature so that the
+ * assertion (rather than a TypeScript error) is what distinguishes the behaviour.
+ */
+const toStringWithConstraintMessages = (error: { toString: (...args: any[]) => string }): string =>
+  error.toString(undefined, undefined, undefined, true);
+
 /**
  * TODO: needs to split these test into
