+
+  it('should wrap the output in ANSI bold codes when shouldDecorate is true', async () => {
+    class DecoratedClass {
+      @IsString()
+      public title: string;
+
+      constructor() {
+        this.title = 5 as any;
+      }
+    }
+
+    const validationErrors = await validator.validate(new DecoratedClass());
+    expect(validationErrors).toHaveLength(1);
+
+    const plain = validationErrors[0].toString();
+    const decorated = validationErrors[0].toString(true);
+
+    // default (shouldDecorate = false) must not contain any ANSI escape codes
+    expect(plain).not.toMatch(/\x1b\[/);
+    // shouldDecorate = true must wrap the output in ANSI bold codes
+    expect(decorated).toContain('\x1b[1m');
+    expect(decorated).toContain('\x1b[22m');
+    // removing the ANSI codes yields exactly the undecorated output
+    expect(decorated.replace(/\x1b\[[0-9;]*m/g, '')).toEqual(plain);
+  });
+
+  it('should use the actual constraint message values when showConstraintMessages is true', async () => {
+    class CustomMessageClass {
+      @IsString({ message: 'title must be a custom string' })
+      public title: string;
+
+      constructor() {
+        this.title = 5 as any;
+      }
+    }
+
+    const validationErrors = await validator.validate(new CustomMessageClass());
+    expect(validationErrors).toHaveLength(1);
+
+    // by default the constraint name is shown, not the message
+    expect(validationErrors[0].toString()).toContain('isString');
+    expect(validationErrors[0].toString()).not.toContain('title must be a custom string');
+    // with showConstraintMessages the actual (custom) message value is shown
+    expect(toStringWithConstraintMessages(validationErrors[0])).toContain(
+      'title must be a custom string'
+    );
   });
