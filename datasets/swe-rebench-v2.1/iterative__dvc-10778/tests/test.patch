+import os
 import sys
 
 import pytest
@@ -20,4 +21,43 @@ def test_site_cache_dir_on_unix(monkeypatch):
 
 def test_site_cache_dir_env_var(monkeypatch):
     monkeypatch.setenv(DVC_SITE_CACHE_DIR, "foo_bar")
-    assert site_cache_dir() == "foo_bar"
+    assert site_cache_dir().endswith("foo_bar")
+
+
+def test_repo_site_cache_dir_env_var_overrides_config(tmp_path, monkeypatch):
+    from dvc.repo import Repo
+
+    config_dir = tmp_path / "config_site_cache"
+    env_dir = tmp_path / "env_site_cache"
+    monkeypatch.setenv(DVC_SITE_CACHE_DIR, os.fspath(env_dir))
+    repo = Repo(
+        os.fspath(tmp_path),
+        uninitialized=True,
+        config={"core": {"site_cache_dir": os.fspath(config_dir)}},
+    )
+    try:
+        env_root = os.path.realpath(env_dir)
+        cache_dir = os.path.realpath(repo.site_cache_dir)
+        assert os.path.commonpath((cache_dir, env_root)) == env_root
+    finally:
+        repo.close()
+
+
+def test_repo_site_cache_dir_uses_config_when_env_var_is_absent(
+    tmp_path, monkeypatch
+):
+    from dvc.repo import Repo
+
+    monkeypatch.delenv(DVC_SITE_CACHE_DIR, raising=False)
+    config_dir = tmp_path / "config_site_cache"
+    repo = Repo(
+        os.fspath(tmp_path),
+        uninitialized=True,
+        config={"core": {"site_cache_dir": os.fspath(config_dir)}},
+    )
+    try:
+        config_root = os.path.realpath(config_dir)
+        cache_dir = os.path.realpath(repo.site_cache_dir)
+        assert os.path.commonpath((cache_dir, config_root)) == config_root
+    finally:
+        repo.close()
