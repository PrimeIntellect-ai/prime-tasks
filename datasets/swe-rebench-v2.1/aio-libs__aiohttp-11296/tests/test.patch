+
+async def test_formdata_file_upload_307_redirect(
+    aiohttp_client: AiohttpClient, tmp_path: pathlib.Path
+) -> None:
+    """A multipart file upload built with FormData must survive a 307 redirect.
+
+    This is the exact scenario from the bug report: a file stream is added to a
+    FormData and posted to a URL that redirects. The server must receive the same
+    well-formed multipart body (with the file part) on both requests.
+    """
+    async def handler(request: web.Request) -> web.Response:
+        if str(request.url.path).endswith("/"):
+            # Consume the incoming multipart body before redirecting.
+            await request.read()
+            return web.Response(
+                status=307,
+                headers={
+                    "Location": str(request.url.with_path(request.url.path.rstrip("/")))
+                },
+            )
+
+        # Parse the multipart body the same way a real server would.
+        data = await request.post()
+        file_field = data.get("file")
+        file_content = (
+            await asyncio.to_thread(file_field.file.read) if file_field else b""
+        )
+        return web.json_response(
+            {"file_content": file_content.decode("ascii")}
+        )
+
+    app = web.Application()
+    app.router.add_post("/upload/", handler)
+    app.router.add_post("/upload", handler)
+
+    client = await aiohttp_client(app)
+
+    test_file = tmp_path / "formdata_upload.txt"
+    content = b"FormData file content for redirect test."
+    await asyncio.to_thread(test_file.write_bytes, content)
+
+    f = await asyncio.to_thread(open, test_file, "rb")
+    try:
+        form = aiohttp.FormData()
+        form.add_field("file", f, filename="upload.txt")
+        async with client.post("/upload/", data=form) as resp:
+            assert resp.status == 200
+            result = await resp.json()
+
+            # The server must see the file part with its full content after the
+            # redirect, exactly as it would without a redirect.
+            assert result["file_content"] == content.decode("ascii")
+    finally:
+        await asyncio.to_thread(f.close)
