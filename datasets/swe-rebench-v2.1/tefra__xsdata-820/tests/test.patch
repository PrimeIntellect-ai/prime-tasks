+    def test_required_attribute_override_is_emitted_in_derived_class(self):
+        xsd = """<?xml version="1.0" encoding="UTF-8"?>
+        <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
+          <xsd:complexType name="parent">
+            <xsd:attribute name="id" type="xsd:string" use="optional"/>
+          </xsd:complexType>
+          <xsd:element name="test">
+            <xsd:complexType>
+              <xsd:complexContent>
+                <xsd:restriction base="parent">
+                  <xsd:attribute name="id" type="xsd:string" use="required"/>
+                </xsd:restriction>
+              </xsd:complexContent>
+            </xsd:complexType>
+          </xsd:element>
+        </xsd:schema>"""
+
+        schema = SchemaParser().from_string(xsd, Schema)
+        classes = SchemaMapper.map(schema)
+        container = ClassContainer(config=GeneratorConfig())
+        container.extend(classes)
+        result = ClassAnalyzer.process(container)
+
+        target = next(obj for obj in result if obj.name == "test")
+        attrs = {attr.name: attr for attr in target.attrs}
+
+        self.assertIn("id", attrs)
+        self.assertEqual(1, attrs["id"].restrictions.min_occurs)
+        self.assertEqual(1, attrs["id"].restrictions.max_occurs)
+
+        packages = {obj.qname: obj.target_module for obj in result}
+        resolver = DependenciesResolver(packages)
+        source = DataclassGenerator(GeneratorConfig()).render_module(resolver, result)
+        self.assertIn('"required": True', source)
+
     def test_resolve_conflicts(self):
