+@pytest.fixture
+def df():
+    return pd.DataFrame(
+        {
+            "name": ("black", "black", "black", "red", "red"),
+            "type": ("chair", "chair", "sofa", "sofa", "plate"),
+            "num": (4, 5, 12, 4, 3),
+            "nulls": (1, 1, np.nan, np.nan, 3),
+        }
+    )
+
+
+def test_groupby_agg_null_columns(df):
+    """
+    Test that aggregation on null column retains the null entries and returns
+    the right aggregated value.
+    """
+    expected = df.copy()
+    expected["num_count"] = (
+        expected.fillna("rar").groupby(["nulls"])["type"].transform("size")
+    )
+    assert_frame_equal(
+        df.groupby_agg(
+            by="nulls",
+            new_column_name="num_count",
+            agg_column_name="num",
+            agg="size",
+        ),
+        expected,
+    )
+
+
+def test_groupby_agg_null_columns_mean(df):
+    """
+    Test that aggregation on a null column retains the null entries and
+    returns the right aggregated value for a non-count aggregation.
+    """
+    expected = df.copy()
+    expected["num_mean"] = (
+        expected.fillna("rar").groupby(["nulls"])["num"].transform("mean")
+    )
+    assert_frame_equal(
+        df.groupby_agg(
+            by="nulls",
+            new_column_name="num_mean",
+            agg_column_name="num",
+            agg="mean",
+        ),
+        expected,
+    )
+
+
+def test_groupby_agg_null_multi_column_keys():
+    df = pd.DataFrame(
+        {
+            "region": ["north", None, None, None, "south"],
+            "kind": ["a", "a", "a", None, "a"],
+            "value": [10, 20, 30, 40, 50],
+        }
+    )
+
+    result = df.groupby_agg(
+        by=["region", "kind"],
+        new_column_name="group_count",
+        agg_column_name="value",
+        agg="size",
+    )
+
+    assert len(result) == len(df)
+    assert result["group_count"].tolist() == [1, 2, 2, 1, 1]
