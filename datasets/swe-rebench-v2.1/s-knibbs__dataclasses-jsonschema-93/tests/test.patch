+FOO_JSON = """
+{
+  "a": "2018-06-03T12:00:00+00:00",
+  "b": [
+    {
+      "z": 1.2,
+      "y": 1.5
+    }
+  ],
+  "c": {
+    "Mon": 1,
+    "Tue": 2
+  },
+  "d": "Wednesday",
+  "f": [
+    "xyz",
+    6
+  ],
+  "g": [
+    "abc"
+  ],
+  "e": "testing",
+  "h": {
+    "z": 0.5,
+    "y": 1.0
+  }
+}
+"""
+
+
+def test_from_json_to_json():
+    data = FOO_JSON
+    f = Foo.from_json(data)
+    assert f.f == ('xyz', 6)
+    assert f.g == ('abc',)
+    assert json.loads(f.to_json()) == json.loads(data)
+
+
+def test_to_json_round_trip():
+    f = Foo.from_json(FOO_JSON)
+    text = f.to_json()
+    assert isinstance(text, str)
+    assert Foo.from_json(text).to_dict() == f.to_dict()
+
+
 def test_invalid_data():
     with pytest.raises(ValidationError):
         Point.from_dict({'z': 3.14, 'y': 'wrong'})
