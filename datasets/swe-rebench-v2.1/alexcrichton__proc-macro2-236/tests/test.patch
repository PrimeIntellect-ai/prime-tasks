+#[test]
+fn literal_iter_negative() {
+    fn check_negative(tokens: TokenStream, expected: &str) {
+        let mut iter = tokens.into_iter();
+        match iter.next().unwrap() {
+            TokenTree::Punct(punct) => {
+                assert_eq!(punct.as_char(), '-');
+                assert_eq!(punct.spacing(), Spacing::Alone);
+            }
+            unexpected => panic!("unexpected token {:?}", unexpected),
+        }
+        match iter.next().unwrap() {
+            TokenTree::Literal(literal) => {
+                assert_eq!(literal.to_string(), expected);
+            }
+            unexpected => panic!("unexpected token {:?}", unexpected),
+        }
+        assert!(iter.next().is_none());
+    }
+
+    // Conversion through `From<TokenTree>`.
+    check_negative(
+        TokenStream::from(TokenTree::Literal(Literal::i32_suffixed(-3))),
+        "3i32",
+    );
+
+    // The reproduction from the issue uses `TokenStream::extend`.
+    let mut tokens = TokenStream::new();
+    tokens.extend(std::iter::once(TokenTree::Literal(Literal::i32_suffixed(-3))));
+    check_negative(tokens, "3i32");
+
+    // Negative integer literals of other types are split the same way.
+    check_negative(
+        TokenStream::from(TokenTree::Literal(Literal::i64_suffixed(-3))),
+        "3i64",
+    );
+    check_negative(
+        TokenStream::from(TokenTree::Literal(Literal::isize_suffixed(-3))),
+        "3isize",
+    );
+    check_negative(
+        TokenStream::from(TokenTree::Literal(Literal::i32_unsuffixed(-3))),
+        "3",
+    );
+}
