+def test_plugin_list_filenames(tmp_path):
+    plugins_path = tmp_path
+    plugin = plugins_path.joinpath("amazing_plugin.py")
+    plugin.write_text("")
+
+    results = list(plugins._list_plugin_filenames(plugins_path))
+
+    assert len(results) == 1
+    name, path = results[0]
+    assert name == "amazing_plugin"
+    assert os.path.isabs(path)
+    assert os.path.exists(path)
+
+
+def test_plugin_skip_broken_links(tmp_path, caplog):
+    plugins_path = tmp_path
+    plugin = plugins_path.joinpath("amazing_plugin.py")
+    link_target = plugins_path.joinpath("nonexistent_file.py")
+    plugin.symlink_to(link_target)
+
+    with caplog.at_level(logging.WARNING):
+        assert list(plugins._list_plugin_filenames(plugins_path)) == []
+
+    assert any(
+        record.levelno == logging.WARNING for record in caplog.records
+    ), "Skipping a broken symlink should log a warning"
+
+
+def test_plugin_list_filenames_accepts_string_directory(tmp_path):
+    plugin = tmp_path / "string_plugin.py"
+    plugin.write_text("")
+
+    results = list(plugins._list_plugin_filenames(str(tmp_path)))
+
+    assert results == [("string_plugin", str(plugin.resolve()))]
+
+
+def test_plugin_list_filenames_includes_packages(tmp_path):
+    package = tmp_path / "example_package"
+    package.mkdir()
+    (package / "__init__.py").write_text("")
+
+    results = list(plugins._list_plugin_filenames(tmp_path))
+
+    assert ("example_package", str(package.resolve())) in results
