+class ProjectSchemaTest(BaseProjectTest):
+
+    def test_project_records_data_model_schema_version(self):
+        self.assertTrue(hasattr(signac.version, 'SCHEMA_VERSION'))
+        self.assertEqual(
+            self.project.config.get('schema_version'),
+            signac.version.SCHEMA_VERSION)
+
+    def test_existing_project_with_legacy_signac_version(self):
+        config = get_config(self.project.fn('signac.rc'))
+        config.pop('schema_version', None)
+        config['signac_version'] = '0.1.0'
+        config.write()
+
+        project = signac.get_project(root=self.project.root_directory())
+        self.assertEqual(project.id, self.project.id)
+        job = project.open_job({'legacy_configuration': True})
+        job.init()
+        self.assertIn(job, project)
+
