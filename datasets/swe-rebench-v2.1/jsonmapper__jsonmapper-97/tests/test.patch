+    /**
+     * @coversNothing
+     */
+    public function testPackageAllowsPhp71(): void
+    {
+        $metadata = json_decode(file_get_contents(dirname(__DIR__, 2) . '/composer.json'), true);
+
+        self::assertSame(JSON_ERROR_NONE, json_last_error());
+        self::assertTrue(self::composerConstraintAllows($metadata['require']['php'], '7.1.0'));
+
+        // Sanity checks that the constraint evaluation used above is not vacuous.
+        self::assertFalse(self::composerConstraintAllows('^7.2 || ^8.0', '7.1.0'));
+        self::assertFalse(self::composerConstraintAllows('>=7.2', '7.1.0'));
+        self::assertTrue(self::composerConstraintAllows('7.1 - 8.0 || ^8.1', '7.1.0'));
+    }
+
+    private static function composerConstraintAllows(string $constraint, string $version): bool
+    {
+        foreach (explode('||', $constraint) as $alternative) {
+            $alternative = preg_replace_callback(
+                '/(\S+)\s+-\s+(\S+)/',
+                static function (array $match): string {
+                    $upper = $match[2];
+                    $upperParts = explode('.', $upper);
+                    $upperOp = count($upperParts) === 3 && !preg_match('/[*xX]/', $upper) ? '<=' : '<';
+                    $upperVersion = $upperOp === '<' ? self::incrementVersion($upper, count($upperParts) - 1) : $upper;
+
+                    return '>=' . $match[1] . ' ' . $upperOp . $upperVersion;
+                },
+                trim($alternative)
+            );
+
+            $comparators = preg_split('/[\s,]+/', trim($alternative), -1, PREG_SPLIT_NO_EMPTY);
+            $allHold = $comparators !== [];
+            foreach ($comparators as $comparator) {
+                if (!self::comparatorAllows($comparator, $version)) {
+                    $allHold = false;
+                    break;
+                }
+            }
+
+            if ($allHold) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private static function comparatorAllows(string $comparator, string $version): bool
+    {
+        if (!preg_match('/^(\^|~|>=|<=|>|<|!=|=)?\s*(\d+|[*xX])(?:\.(\d+|[*xX]))?(?:\.(\d+|[*xX]))?$/', $comparator, $match)) {
+            return false;
+        }
+
+        $operator = $match[1] ?? '';
+        $parts = array_values(array_filter(array_slice($match, 2), static function ($part): bool {
+            return $part !== null && $part !== '';
+        }));
+        $numeric = [];
+        foreach ($parts as $part) {
+            if (!preg_match('/^\d+$/', $part)) {
+                break;
+            }
+            $numeric[] = $part;
+        }
+        $isWildcard = count($numeric) < count($parts) || count($numeric) < 3 && $operator === '';
+        $count = count($numeric);
+        $lower = implode('.', array_pad($numeric, 3, '0'));
+
+        if ($count === 0) {
+            return true;
+        }
+
+        switch ($operator) {
+            case '':
+            case '=':
+                if (!$isWildcard) {
+                    return version_compare($version, $lower, '==');
+                }
+
+                return version_compare($version, $lower, '>=')
+                    && version_compare($version, self::incrementVersion($lower, $count - 1), '<');
+            case '^':
+                $index = $count - 1;
+                foreach ($numeric as $i => $part) {
+                    if ((int) $part !== 0) {
+                        $index = min($i, $count - 1);
+                        break;
+                    }
+                }
+
+                return version_compare($version, $lower, '>=')
+                    && version_compare($version, self::incrementVersion($lower, $index), '<');
+            case '~':
+                $index = $count >= 3 ? 1 : 0;
+
+                return version_compare($version, $lower, '>=')
+                    && version_compare($version, self::incrementVersion($lower, $index), '<');
+            case '>=':
+                return version_compare($version, $lower, '>=');
+            case '>':
+                if ($count === 3) {
+                    return version_compare($version, $lower, '>');
+                }
+
+                return version_compare($version, self::incrementVersion($lower, $count - 1), '>=');
+            case '<':
+                return version_compare($version, $lower, '<');
+            case '<=':
+                if ($count === 3) {
+                    return version_compare($version, $lower, '<=');
+                }
+
+                return version_compare($version, self::incrementVersion($lower, $count - 1), '<');
+            case '!=':
+                return version_compare($version, $lower, '!=');
+        }
+
+        return false;
+    }
+
+    private static function incrementVersion(string $version, int $index): string
+    {
+        $parts = array_map('intval', explode('.', $version));
+        $parts[$index] = $parts[$index] + 1;
+        for ($i = $index + 1; $i < 3; $i++) {
+            $parts[$i] = 0;
+        }
+
+        return implode('.', array_pad(array_slice($parts, 0, 3), 3, 0));
+    }
+
+    /**
+     * @coversNothing
+     */
+    public function testLibrarySourcesParseForPhp71(): void
+    {
+        $parser = (new \PhpParser\ParserFactory())->create(
+            \PhpParser\ParserFactory::PREFER_PHP7,
+            new \PhpParser\Lexer\Emulative(['phpVersion' => '7.1'])
+        );
+        $sourceFiles = new \RecursiveIteratorIterator(
+            new \RecursiveDirectoryIterator(dirname(__DIR__, 2) . '/src')
+        );
+
+        foreach ($sourceFiles as $sourceFile) {
+            if (!$sourceFile->isFile() || $sourceFile->getExtension() !== 'php') {
+                continue;
+            }
+
+            $statements = $parser->parse(file_get_contents($sourceFile->getPathname()));
+            self::assertTrue(is_array($statements));
+
+            $usesUnsupportedObjectType = false;
+            $visitor = new class($usesUnsupportedObjectType) extends \PhpParser\NodeVisitorAbstract {
+                private $detected;
+
+                public function __construct(&$detected)
+                {
+                    $this->detected = &$detected;
+                }
+
+                public function enterNode(\PhpParser\Node $node)
+                {
+                    $types = [];
+                    if ($node instanceof \PhpParser\Node\Param) {
+                        $types[] = $node->type;
+                    }
+                    if ($node instanceof \PhpParser\Node\Stmt\Function_ ||
+                        $node instanceof \PhpParser\Node\Stmt\ClassMethod ||
+                        $node instanceof \PhpParser\Node\Expr\Closure ||
+                        $node instanceof \PhpParser\Node\Expr\ArrowFunction) {
+                        $types[] = $node->getReturnType();
+                    }
+                    if ($node instanceof \PhpParser\Node\Stmt\Property) {
+                        $types[] = $node->type;
+                    }
+
+                    $pendingTypes = $types;
+                    while ($pendingTypes !== []) {
+                        $type = array_pop($pendingTypes);
+                        if ($type instanceof \PhpParser\Node\NullableType) {
+                            $pendingTypes[] = $type->type;
+                        } elseif ($type instanceof \PhpParser\Node\UnionType ||
+                            $type instanceof \PhpParser\Node\IntersectionType) {
+                            $pendingTypes = array_merge($pendingTypes, $type->types);
+                        } elseif (($type instanceof \PhpParser\Node\Name || $type instanceof \PhpParser\Node\Identifier) &&
+                            strtolower((string) $type) === 'object') {
+                            $this->detected = true;
+                        }
+                    }
+                }
+            };
+            $traverser = new \PhpParser\NodeTraverser();
+            $traverser->addVisitor($visitor);
+            $traverser->traverse($statements);
+            self::assertFalse($usesUnsupportedObjectType, $sourceFile->getPathname());
+        }
+    }
 }
