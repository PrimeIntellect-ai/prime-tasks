+describe("create mode crash handling", () => {
+	it("does not offer to restore the repository when the create run crashes", async () => {
+		const consoleLog = vi.spyOn(console, "log").mockImplementation(() => {});
+		const consoleError = vi.spyOn(console, "error").mockImplementation(() => {});
+		const stdoutWrite = vi
+			.spyOn(process.stdout, "write")
+			.mockImplementation(() => true);
+		const stderrWrite = vi
+			.spyOn(process.stderr, "write")
+			.mockImplementation(() => true);
+		mockDetectEmailRedundancy.mockReturnValue(false);
+		mockAugmentOptionsWithExcludes.mockImplementation(
+			(options: Partial<Options>) => ({
+				...options,
+				...mockOptions,
+			}),
+		);
+		mockEnsureRepositoryExists.mockResolvedValue({
+			octokit: undefined,
+			repository: mockOptions.repository,
+		});
+		mockGetPrefillOrPromptedOption.mockImplementation(() => ({
+			value: "mock",
+		}));
+		mockCreateAndEnterGitDirectory.mockResolvedValue(true);
+		mockCreateWithOptions.mockRejectedValue(new Error("Mock create failure"));
+
+		let thrown: unknown;
+		try {
+			await create(["--base", mockOptions.base]);
+		} catch (error) {
+			thrown = error;
+		}
+
+		expect(mockConfirm).not.toHaveBeenCalled();
+
+		const crashOutput = [
+			...consoleLog.mock.calls,
+			...consoleError.mock.calls,
+			...stdoutWrite.mock.calls,
+			...stderrWrite.mock.calls,
+			...(thrown === undefined ? [] : [[thrown]]),
+		]
+			.flat()
+			.map((value) =>
+				value instanceof Error ? (value.stack ?? value.message) : String(value),
+			)
+			.join("\n");
+		expect(crashOutput).toContain("Mock create failure");
+		expect(crashOutput).toMatch(/\n\s+at /);
+	});
+});
