+
+        suppressed = [
+            "standard file not found: should have one of foo.py, bar.py",
+            "standard file 'setup.py' not found",
+        ]
+        for msg in suppressed:
+            mm.warn(msg)
+        assert capsys.readouterr().err == ''
+
+        # unrelated warnings must still be emitted
+        mm.warn("some unrelated warning")
+        assert "some unrelated warning" in capsys.readouterr().err
