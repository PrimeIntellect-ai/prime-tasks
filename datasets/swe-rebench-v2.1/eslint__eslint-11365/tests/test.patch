+
+describe("prefer-spread autofix", () => {
+    it("leaves Array.apply with an array-like argument unchanged when fixing", () => {
+        const linter = new Linter();
+        const code = "Array.apply(null, { length: 10 });";
+
+        linter.defineRule("prefer-spread", rule);
+
+        const result = linter.verifyAndFix(code, {
+            parserOptions: { ecmaVersion: 6 },
+            rules: { "prefer-spread": "error" }
+        });
+
+        assert.strictEqual(result.output, code);
+    });
