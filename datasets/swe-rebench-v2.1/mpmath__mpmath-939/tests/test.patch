+@pytest.mark.parametrize('rnd', ('d', 'u', 'f', 'n'))
+def test_mpf_bernoulli_rounding(rnd):
+    # B_10 = 5/66; the result must be correctly rounded at the requested
+    # precision using the caller-supplied rounding mode.
+    from mpmath.libmp import mpf_bernoulli, from_rational
+    prec = 336
+    assert mpf_bernoulli(10, prec, rnd=rnd) == from_rational(5, 66, prec, rnd)
+
+
+def test_mpf_bernoulli_normalized():
+    from mpmath.libmp import mpf_bernoulli
+    prec = 336
+    for rnd in ('d', 'u', 'f', 'n'):
+        value = mpf_bernoulli(10, prec, rnd=rnd)
+        assert value[1].bit_length() <= prec
+
+
