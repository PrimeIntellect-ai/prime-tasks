+# -*- fundamental -*-
+#
+# Tests for parsing inflection tables
+#
+# Copyright (c) 2021, 2022 Tatu Ylonen.  See file LICENSE and https://ylonen.org
+import unittest
+
+from wikitextprocessor import Wtp
+
+from wiktextract.config import WiktionaryConfig
+from wiktextract.page import parse_page
+from wiktextract.thesaurus import close_thesaurus_db
+from wiktextract.wxr_context import WiktextractContext
+
+
+class InflTests(unittest.TestCase):
+    def setUp(self):
+        self.maxDiff = None
+        self.wxr = WiktextractContext(
+            Wtp(), WiktionaryConfig(capture_language_codes=None)
+        )
+        self.wxr.wtp.start_page("testpage")
+        self.wxr.wtp.start_section("Assyrian Neo-Aramaic")
+
+    def tearDown(self) -> None:
+        self.wxr.wtp.close_db_conn()
+        close_thesaurus_db(
+            self.wxr.thesaurus_db_path, self.wxr.thesaurus_db_conn
+        )
+
+    def test_aii_table_pipeline(self):
+        """Regression test for #973.
+
+        ``Template:aii-infl-prep/1c`` is pre-expanded into a wikitext table
+        that itself contains templates.  The page-extraction pipeline must
+        not split that table apart, so that the inflection forms reach the
+        extracted entry data.
+        """
+        self.wxr.wtp.add_page(
+            "Template:l",
+            10,
+            '<span class="Syrc" lang="aii">'
+            "[[{{{2}}}#Assyrian_Neo-Aramaic|{{{2}}}]]</span>",
+        )
+        self.wxr.wtp.add_page(
+            "Template:inflection-table-top",
+            10,
+            '<div class="inflection-table-wrapper">',
+            need_pre_expand=True,
+        )
+        self.wxr.wtp.add_page(
+            "Template:inflection-table-bottom",
+            10,
+            "</div>",
+            need_pre_expand=True,
+        )
+        self.wxr.wtp.add_page(
+            "Template:aii-infl-prep/1c",
+            10,
+            """{{inflection-table-top}}
+{| class="inflection-table"
+|-
+! base form
+|-
+| {{l|aii|{{{1|ܛܠܵܐ}}}}}
+|-
+! 1st person
+|-
+| {{l|aii|ܛܠܬܝ}}
+|}
+{{inflection-table-bottom}}""",
+            need_pre_expand=True,
+        )
+        lst = parse_page(
+            self.wxr,
+            "ܛܠܐ",
+            """
+==Assyrian Neo-Aramaic==
+===Preposition===
+{{head|aii|preposition}}
+# gloss
+
+====Conjugation====
+{{aii-infl-prep/1c|ܛܠܵܐ}}
+""",
+        )
+        forms = {
+            form.get("form")
+            for entry in lst
+            for form in entry.get("forms", [])
+        }
+        self.assertIn("ܛܠܬܝ", forms)
