+def test_accessor_drop(sample_df):
+    xfail_dask_and_koalas(sample_df)
+
+    schema_df = sample_df.copy()
+    schema_df.ww.init()
+
+    def assert_same_columns_and_data(expected, actual):
+        assert set(expected.columns) == set(actual.columns)
+        for column in expected.columns:
+            pd.testing.assert_series_equal(expected[column], actual[column], check_dtype=False)
+
+    single_input_df = schema_df.ww.drop('is_registered')
+    assert len(single_input_df.ww.columns) == (len(schema_df.columns) - 1)
+    assert 'is_registered' not in single_input_df.ww.columns
+    assert_same_columns_and_data(
+        to_pandas(schema_df).drop('is_registered', axis='columns'), to_pandas(single_input_df))
+
+    list_input_df = schema_df.ww.drop(['is_registered'])
+    assert len(list_input_df.ww.columns) == (len(schema_df.columns) - 1)
+    assert 'is_registered' not in list_input_df.ww.columns
+    assert_same_columns_and_data(
+        to_pandas(schema_df).drop('is_registered', axis='columns'), to_pandas(list_input_df))
+    # Both forms of input remove the same column and retain its other data.
+    assert_same_columns_and_data(to_pandas(single_input_df), to_pandas(list_input_df))
+
+    multiple_list_df = schema_df.ww.drop(['age', 'full_name', 'is_registered'])
+    assert len(multiple_list_df.ww.columns) == (len(schema_df.columns) - 3)
+    assert 'is_registered' not in multiple_list_df.ww.columns
+    assert 'full_name' not in multiple_list_df.ww.columns
+    assert 'age' not in multiple_list_df.ww.columns
+
+    assert_same_columns_and_data(
+        to_pandas(schema_df).drop(['is_registered', 'age', 'full_name'], axis='columns'),
+        to_pandas(multiple_list_df))
+
+
+def test_accessor_drop_indices(sample_df):
+    xfail_dask_and_koalas(sample_df)
+
+    sample_df.ww.init(index='id', time_index='signup_date')
+    assert sample_df.ww.index == 'id'
+    assert sample_df.ww.time_index == 'signup_date'
+
+    dropped_index_df = sample_df.ww.drop('id')
+    assert 'id' not in dropped_index_df.ww.columns
+    assert dropped_index_df.ww.index is None
+    assert dropped_index_df.ww.time_index == 'signup_date'
+
+    dropped_time_index_df = sample_df.ww.drop(['signup_date'])
+    assert 'signup_date' not in dropped_time_index_df.ww.columns
+    assert dropped_time_index_df.ww.time_index is None
+    assert dropped_time_index_df.ww.index == 'id'
+
+
+def test_accessor_drop_preserves_original_schema(sample_df):
+    xfail_dask_and_koalas(sample_df)
+
+    schema_df = sample_df.copy()
+    # Explicitly set a logical type that differs from the inferred type so that
+    # re-inferring types from the remaining data would produce a different schema.
+    schema_df.ww.init(logical_types={'age': 'Double'}, semantic_tags={'age': 'custom_tag'})
+    assert schema_df.ww.logical_types['age'] == Double
+
+    dropped_df = schema_df.ww.drop('is_registered')
+
+    # The remaining columns must keep the original typing information rather than
+    # being re-inferred from the remaining data.
+    assert dropped_df.ww.logical_types['age'] == Double
+    assert 'custom_tag' in dropped_df.ww.semantic_tags['age']
+    assert dropped_df.ww.logical_types == {col: ltype for col, ltype in schema_df.ww.logical_types.items()
+                                           if col != 'is_registered'}
