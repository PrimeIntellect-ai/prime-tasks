+class ConstructModeContainer(Container):
+    """A Container that records the value of _in_construct_mode while __init__ runs."""
+
+    @docval({'name': 'name', 'type': str, 'doc': 'the name of this container'})
+    def __init__(self, **kwargs):
+        self.construct_mode_during_init = self._in_construct_mode
+        super().__init__(**kwargs)
+
+
+class StrictContainer(Container):
+    """A Container that rejects invalid data unless it is being constructed from a file."""
+
+    @docval({'name': 'name', 'type': str, 'doc': 'the name of this container'},
+            {'name': 'value', 'type': int, 'doc': 'a value that must be non-negative'})
+    def __init__(self, **kwargs):
+        name, value = getargs('name', 'value', kwargs)
+        if value < 0:
+            msg = 'value must be non-negative'
+            if self._in_construct_mode:
+                warnings.warn(msg)
+            else:
+                raise ValueError(msg)
+        super().__init__(name=name)
+        self.value = value
+
+
+class TestConstructMode(TestCase):
+    """Test that object construction is distinguishable from creation by a user."""
+
+    CORE_NAMESPACE = 'test_core'
+
+    def setUp(self):
+        self.spec = GroupSpec('A test group specification with a data type',
+                              data_type_def='ConstructModeContainer')
+        self.strict_spec = GroupSpec('A test group specification with a data type',
+                                     data_type_def='StrictContainer',
+                                     datasets=[DatasetSpec('a value', 'int', name='value')])
+        spec_catalog = SpecCatalog()
+        spec_catalog.register_spec(self.spec, 'test.yaml')
+        spec_catalog.register_spec(self.strict_spec, 'test.yaml')
+        namespace = SpecNamespace('a test namespace', self.CORE_NAMESPACE,
+                                  [{'source': 'test.yaml'}], version='0.1.0', catalog=spec_catalog)
+        namespace_catalog = NamespaceCatalog()
+        namespace_catalog.add_namespace(self.CORE_NAMESPACE, namespace)
+        self.type_map = TypeMap(namespace_catalog)
+        self.type_map.register_container_type(self.CORE_NAMESPACE, 'ConstructModeContainer',
+                                              ConstructModeContainer)
+        self.type_map.register_container_type(self.CORE_NAMESPACE, 'StrictContainer', StrictContainer)
+        self.manager = BuildManager(self.type_map)
+        self.mapper = ObjectMapper(self.spec)
+        self.strict_mapper = ObjectMapper(self.strict_spec)
+
+    def test_construct_mode_true_during_object_construction(self):
+        """Constructing an object from a builder sets _in_construct_mode while __init__ runs."""
+        builder = GroupBuilder(
+            name='root',
+            attributes={'data_type': 'ConstructModeContainer',
+                        'namespace': self.CORE_NAMESPACE,
+                        'object_id': str(uuid4())}
+        )
+        container = self.mapper.construct(builder, self.manager)
+        self.assertTrue(container.construct_mode_during_init)
+        self.assertFalse(container._in_construct_mode)
+
+    def test_construct_mode_false_for_user_creation(self):
+        """Creating an object directly does not set _in_construct_mode."""
+        container = ConstructModeContainer(name='root')
+        self.assertFalse(container.construct_mode_during_init)
+        self.assertFalse(container._in_construct_mode)
+
+    def test_invalid_data_warns_during_object_construction(self):
+        """Invalid data produces a warning, not an error, when constructing an object from a builder."""
+        builder = GroupBuilder(
+            name='root',
+            datasets={'value': DatasetBuilder(name='value', data=-1)},
+            attributes={'data_type': 'StrictContainer',
+                        'namespace': self.CORE_NAMESPACE,
+                        'object_id': str(uuid4())}
+        )
+        with self.assertWarnsWith(UserWarning, 'value must be non-negative'):
+            container = self.strict_mapper.construct(builder, self.manager)
+        self.assertEqual(container.value, -1)
+
+    def test_invalid_data_raises_for_user_creation(self):
+        """Invalid data raises an error when a user creates the object directly."""
+        with self.assertRaisesWith(ValueError, 'value must be non-negative'):
+            StrictContainer(name='root', value=-1)
