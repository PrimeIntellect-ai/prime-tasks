+it('includes .php lang file in nested subdirectory in .json', () => {
+    const files = parseAll(__dirname + '/fixtures/lang/');
+    const langEn = JSON.parse(fs.readFileSync(files[0].path).toString())
+
+    expect(langEn['nested.cars.car.is_electric']).toBe('Electric');
+    expect(langEn['nested.cars.car.foo.level1.level2']).toBe('barpt');
+})
+
+it('includes translations from directories deeper than two levels', () => {
+    const folder = fs.mkdtempSync(__dirname + '/fixtures/lang-depth-');
+    const languageFolder = folder + '/en/one/two/three';
+
+    fs.mkdirSync(languageFolder, { recursive: true });
+    fs.writeFileSync(languageFolder + '/deep.php', "<?php return ['answer' => 'found'];");
+
+    try {
+        const files = parseAll(folder);
+        expect(files).toHaveLength(1);
+
+        if (files[0]) {
+            const langEn = JSON.parse(fs.readFileSync(files[0].path).toString());
+            expect(langEn['one.two.three.deep.answer']).toBe('found');
+        }
+    } finally {
+        fs.rmSync(folder, { recursive: true, force: true });
+    }
+});
