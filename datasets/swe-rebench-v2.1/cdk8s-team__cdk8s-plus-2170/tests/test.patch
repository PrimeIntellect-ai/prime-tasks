+
+test('expose via service copies container port names to service ports', () => {
+
+  const chart = Testing.chart();
+
+  const deployment = new kplus.Deployment(chart, 'Deployment', {
+    containers: [{
+      image: 'image',
+      ports: [
+        {
+          number: 8080,
+          name: 'http',
+        },
+        {
+          number: 9090,
+          name: 'dashboard',
+        },
+      ],
+    }],
+  });
+
+  deployment.exposeViaService();
+
+  const spec = Testing.synth(chart)[1].spec;
+  expect(spec.ports).toHaveLength(2);
+  expect(spec.ports).toEqual(expect.arrayContaining([
+    expect.objectContaining({ name: 'http', port: 8080, targetPort: 8080 }),
+    expect.objectContaining({ name: 'dashboard', port: 9090, targetPort: 9090 }),
+  ]));
+
+});
