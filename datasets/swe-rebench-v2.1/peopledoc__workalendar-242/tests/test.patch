+    def test_federal_year_2017(self):
+        # Calendars that include Christmas Eve observe Christmas Day on the
+        # 26th when Christmas falls on a Monday (2017).
+        holidays = Arkansas().holidays(2017)
+        expected_christmas = {
+            (date(2017, 12, 24), "Christmas Eve"),
+            (date(2017, 12, 25), "Christmas Day"),
+            (date(2017, 12, 25), "Christmas Eve (Observed)"),
+            (date(2017, 12, 26), "Christmas Day (Observed)"),
+        }
+        self.assertTrue(expected_christmas.issubset(set(holidays)))
+        self.assertNotIn(date(2017, 12, 27),
+                         {holiday_date for holiday_date, _ in holidays})
