+def test_descriptor_table_tabular_multipart_noheader_local():
+    descriptor = {
+        'name': 'name',
+        'profile': 'tabular-data-resource',
+        'path': ['chunk2.csv', 'chunk2.csv'],
+        'schema': 'resource_schema.json',
+        'dialect': {'header': False},
+    }
+    resource = Resource(descriptor, base_path='data')
+    assert resource.table.read(keyed=True) == [
+        {'id': 2, 'name': '中国人'},
+        {'id': 2, 'name': '中国人'},
+    ]
+
+def test_descriptor_table_tabular_multipart_binary_local():
+    # Generic (non-tabular) multipart resources concatenate chunks as-is
+    descriptor = {
+        'name': 'name',
+        'path': ['foo.txt', 'foo_newline_bar.txt'],
+    }
+    resource = Resource(descriptor, base_path='data')
+    assert resource.tabular is False
+    assert resource.multipart is True
+    assert resource.raw_read() == b'foo\nfoo\nbar\n'
+
+def test_descriptor_table_tabular_multipart_raw_read(patch_get):
+    # raw_read on a tabular multipart resource must apply the same
+    # header-row handling as table.read: duplicate chunk header rows
+    # are discarded through the multipart iterator.
+    descriptor = {
+        'name': 'name',
+        'profile': 'tabular-data-resource',
+        'path': [
+            'http://example.com/chunk1.csv',
+            'http://example.com/chunk2.csv',
+        ],
+        'schema': 'resource_schema.json',
+    }
+    # Mocks
+    patch_get('http://example.com/chunk1.csv', body="id,name\n1,english")
+    patch_get('http://example.com/chunk2.csv', body="id,name\n2,中国人\n")
+    # Tests
+    resource = Resource(descriptor, base_path='data')
+    assert resource.raw_read().decode('utf-8').splitlines() == [
+        'id,name',
+        '1,english',
+        '2,中国人',
+    ]
+
 
