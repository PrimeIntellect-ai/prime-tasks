+func TestVolumesCommandFiltersByMultipleServices(t *testing.T) {
+	composeFile := writeComposeFile(t, `
+name: testProject
+services:
+  service1:
+    image: busybox
+    volumes:
+      - vol1:/data
+  service2:
+    image: busybox
+    volumes:
+      - vol2:/data
+  service3:
+    image: busybox
+    volumes:
+      - vol3:/data
+volumes:
+  vol1:
+  vol2:
+  vol3:
+`)
+	vol1 := &volume.Volume{Name: "testProject_vol1", Labels: map[string]string{api.ProjectLabel: testProject}}
+	vol2 := &volume.Volume{Name: "testProject_vol2", Labels: map[string]string{api.ProjectLabel: testProject}}
+	vol3 := &volume.Volume{Name: "testProject_vol3", Labels: map[string]string{api.ProjectLabel: testProject}}
+	containers := []container.Summary{
+		{
+			Labels: map[string]string{api.ServiceLabel: "service1"},
+			Mounts: []container.MountPoint{{Name: "testProject_vol1"}},
+		},
+		{
+			Labels: map[string]string{api.ServiceLabel: "service2"},
+			Mounts: []container.MountPoint{{Name: "testProject_vol2"}},
+		},
+		{
+			Labels: map[string]string{api.ServiceLabel: "service3"},
+			Mounts: []container.MountPoint{{Name: "testProject_vol3"}},
+		},
+	}
+
+	out, err := runVolumesCommand(t, composeFile, []*volume.Volume{vol1, vol2, vol3}, nil, containers, "service1", "service2")
+	assert.NilError(t, err)
+	assert.Assert(t, strings.Contains(out, "testProject_vol1"),
+		"expected service1's volume to be listed, got: %q", out)
+	assert.Assert(t, strings.Contains(out, "testProject_vol2"),
+		"expected service2's volume to be listed, got: %q", out)
+	assert.Assert(t, !strings.Contains(out, "testProject_vol3"),
+		"service3's volume must not be listed, got: %q", out)
+}
