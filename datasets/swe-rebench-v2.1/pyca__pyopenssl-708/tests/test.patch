+# Copyright (c) Frederick Dean
+# See LICENSE for details.
+
+"""
+Unit tests for `OpenSSL.rand`.
+"""
+
+import os
+
+import pytest
+
+from OpenSSL import rand
+
+
+class TestRand(object):
+
+    @pytest.mark.parametrize('args', [
+        (b"foo", None),
+        (None, 3),
+    ])
+    def test_add_wrong_args(self, args):
+        """
+        `OpenSSL.rand.add` raises `TypeError` if called with arguments not of
+        type `bytes` and `int`.
+        """
+        with pytest.raises(TypeError):
+            rand.add(*args)
+
+    def test_add(self):
+        """
+        `OpenSSL.rand.add` accepts a byte string and an integer entropy
+        estimate and returns `None`.
+        """
+        assert rand.add(b'hamburger', 3) is None
+
+    def test_status(self):
+        """
+        `OpenSSL.rand.status` returns an integer indicating whether the PRNG
+        has sufficient entropy.
+        """
+        status = rand.status()
+        assert isinstance(status, int)
+
+    def test_status_after_adding_sufficient_entropy(self):
+        """
+        The status is 1 when sufficient entropy has been added to the PRNG.
+        """
+        rand.add(os.urandom(64), 64)
+
+        assert rand.status() == 1
