     final width = stringRepresentation.length;
 
     if (width <= _INT_BITS) {
-      final value = int.parse(valueString, radix: 2);
-      final invalid = int.parse(invalidString, radix: 2);
+      final value = _unsignedBinaryParse(valueString);
