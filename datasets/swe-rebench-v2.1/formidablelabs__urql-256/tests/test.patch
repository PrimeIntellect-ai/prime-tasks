new file mode 100644
index 0000000..ddf09b7
--- /dev/null
+++ b/src/hooks/useImmediateState.test.ts
@@ -0,0 +1,46 @@
+import { renderHook } from 'react-hooks-testing-library';
+import { useMutation } from './useMutation';
+import { useQuery } from './useQuery';
+
+jest.mock('../client', () => {
+  const { interval, map, pipe } = require('wonka');
+  const mock = {
+    executeQuery: jest.fn(() =>
+      pipe(
+        interval(400),
+        map((i: number) => ({ data: i, error: i + 1 }))
+      )
+    ),
+    executeMutation: jest.fn(() =>
+      pipe(
+        interval(400),
+        map((i: number) => ({ data: i, error: i + 1 }))
+      )
+    ),
+  };
+  return { createClient: () => mock };
+});
+
+it('keeps the useMutation result stable across rerenders', () => {
+  const { result, rerender } = renderHook(() =>
+    useMutation('mutation Example { example }')
+  );
+
+  const [state, executeMutation] = result.current;
+  rerender();
+  const [nextState, nextExecuteMutation] = result.current;
+
+  expect(nextExecuteMutation).toBe(executeMutation);
+  expect(nextState).toBe(state);
+});
+
+it('applies useQuery state changes immediately on mount', () => {
+  let firstRenderState: any;
+  renderHook(() => {
+    const [state] = useQuery({ query: 'query Example { example }' });
+    if (firstRenderState === undefined) firstRenderState = state;
+    return state;
+  });
+
+  expect(firstRenderState).toHaveProperty('fetching', true);
+});
