diff --git a/tests/lib/rules/no-contradiction-with-assertion.ts b/tests/lib/rules/no-contradiction-with-assertion.ts
new file mode 100644
index 0000000..7e9b85e
--- /dev/null
+++ b/tests/lib/rules/no-contradiction-with-assertion.ts
@@ -0,0 +1,81 @@
+import assert from "assert"
+import { Linter, RuleTester } from "eslint"
+import rule from "../../../lib/rules/no-contradiction-with-assertion"
+
+const tester = new RuleTester({
+    parserOptions: {
+        ecmaVersion: 2020,
+        sourceType: "module",
+    },
+})
+
+tester.run("no-contradiction-with-assertion", rule as any, {
+    valid: [
+        // Ignore trivially accepting/rejecting assertions
+        String.raw`/a\ba/`,
+        String.raw`/(?!)a/`,
+        String.raw`/(?=)a/`,
+        String.raw`/$a/`,
+
+        // Other valid regexes
+        String.raw`/(^|[\s\S])\bfoo/`,
+        String.raw`/(?:aa|a\b)-?a/`,
+    ],
+    invalid: [
+        {
+            code: String.raw`/a\b-?a/`,
+            errors: [
+                {
+                    messageId: "alwaysEnterQuantifier",
+                    suggestions: [{ output: String.raw`/a\b-{1}a/` }],
+                },
+            ],
+        },
+        {
+            code: String.raw`/a\b(a|-)/`,
+            errors: [
+                {
+                    messageId: "alternative",
+                    suggestions: [],
+                },
+            ],
+        },
+        {
+            code: String.raw`/a\ba*-/`,
+            errors: [
+                {
+                    messageId: "cannotEnterQuantifier",
+                    suggestions: [{ output: String.raw`/a\b-/` }],
+                },
+            ],
+        },
+
+        {
+            code: String.raw`/(^[\t ]*)#(?:comments-start|cs)[\s\S]*?^[ \t]*#(?:comments-end|ce)/m`,
+            errors: [
+                {
+                    messageId: "alwaysEnterQuantifier",
+                    suggestions: [{} as any],
+                },
+            ],
+        },
+    ],
+})
+
+const code = String.raw`/(^[\t ]*)#(?:comments-start|cs)[\s\S]*?^[ \t]*#(?:comments-end|ce)/m`
+const linter = new Linter()
+linter.defineRule("no-contradiction-with-assertion", rule as any)
+const [message] = linter.verify(code, {
+    parserOptions: { ecmaVersion: 2020, sourceType: "module" },
+    rules: { "no-contradiction-with-assertion": "error" },
+})
+assert.strictEqual(message.messageId, "alwaysEnterQuantifier")
+assert.strictEqual(message.suggestions?.length, 1)
+const suggestion = message.suggestions![0]
+const [start, end] = suggestion.fix.range
+const suggestedCode = code.slice(0, start) + suggestion.fix.text + code.slice(end)
+assert.ok(
+    suggestedCode === String.raw`/(^[\t ]*)#(?:comments-start|cs)[\s\S]+?^[ \t]*#(?:comments-end|ce)/m` ||
+        suggestedCode === String.raw`/(^[\t ]*)#(?:comments-start|cs)[\s\S]{1,}?^[ \t]*#(?:comments-end|ce)/m`,
+    `Expected the suggested quantifier to have minimum 1, preserve its unbounded maximum, and remain lazy; received ${suggestedCode}`,
+)
