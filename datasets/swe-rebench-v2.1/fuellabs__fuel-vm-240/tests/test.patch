+use super::*;
+use fuel_tx::{ConsensusParameters, Transaction};
+use fuel_types::RegisterId;
+
+/// Executes the `mlog` instruction with the given exponent and base and
+/// returns the value written to the destination register.
+fn mlog(exp: Word, base: Word) -> Word {
+    let mut vm = Interpreter::with_memory_storage();
+
+    let params = ConsensusParameters::default();
+    let script = Opcode::RET(0x10).to_bytes().to_vec();
+    let block_height = 0;
+    let tx = Transaction::script(
+        0,
+        params.max_gas_per_tx,
+        0,
+        script,
+        vec![],
+        vec![],
+        vec![],
+        vec![],
+    );
+    let tx = tx.check(block_height, &params).expect("failed to check tx");
+
+    vm.init_script(tx).expect("Failed to init VM");
+
+    let ra: RegisterId = 0x10;
+    let rb: RegisterId = 0x11;
+    let rc: RegisterId = 0x12;
+
+    vm.registers[rb] = exp;
+    vm.registers[rc] = base;
+
+    vm.instruction(Opcode::MLOG(ra, rb, rc).into())
+        .expect("mlog instruction should succeed for valid inputs");
+
+    vm.registers[ra]
+}
+
+/// Check for https://github.com/FuelLabs/fuel-vm/issues/150
+///
+/// The `mlog` instruction must round the logarithm down to the nearest
+/// integer, e.g. `1000.logarithm(10) == 3`, while retaining the other
+/// documented results.
+#[test]
+fn mlog_rounding_issues() {
+    let cases = [
+        (4u64, 2u64, 2u64),
+        (16, 2, 4),
+        (9, 3, 2),
+        (100, 10, 2),
+        (999, 10, 2),
+        (1000, 10, 3),
+        (1001, 10, 3),
+    ];
+
+    for (exp, base, expected) in cases {
+        assert_eq!(
+            mlog(exp, base),
+            expected,
+            "mlog({exp}, {base}) should round down to {expected}"
+        );
+    }
+}
