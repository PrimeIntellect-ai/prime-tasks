+
+func TestServicePullPolicyLoadedFromYAML(t *testing.T) {
+	actual, err := loadYAML(`
+services:
+  hello-world:
+    image: redis:alpine
+    pull_policy: always
+`)
+	assert.NilError(t, err)
+	svc, err := actual.GetService("hello-world")
+	assert.NilError(t, err)
+	assert.Equal(t, "always", svc.PullPolicy)
