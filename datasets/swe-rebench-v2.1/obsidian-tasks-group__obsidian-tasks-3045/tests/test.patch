@@ -2,37 +2,160 @@
  * @jest-environment jsdom
  */
 import moment from 'moment';
+import { Menu, MenuItem } from 'obsidian';
+import * as ObsidianFile from '../../src/Obsidian/File';
+import type { AllTaskDateFields } from '../../src/DateTime/DateFieldTypes';
 import { State } from '../../src/Obsidian/Cache';
 import { QueryResultsRenderer } from '../../src/Renderer/QueryResultsRenderer';
 import { TasksFile } from '../../src/Scripting/TasksFile';
+import type { Task } from '../../src/Task/Task';
 import { verifyWithFileExtension } from '../TestingTools/ApprovalTestHelpers';
 import { prettifyHTML } from '../TestingTools/HTMLHelpers';
 import { TaskBuilder } from '../TestingTools/TaskBuilder';
 
 window.moment = moment;
 
+const dateFields: Array<[AllTaskDateFields, string]> = [
+    ['createdDate', 'created date'],
+    ['startDate', 'start date'],
+    ['scheduledDate', 'scheduled date'],
+    ['dueDate', 'due date'],
+    ['cancelledDate', 'cancelled date'],
+    ['doneDate', 'done date'],
+];
+
+beforeEach(() => {
+    jest.useFakeTimers();
+    jest.setSystemTime(new Date('2024-08-19'));
+});
+
+afterEach(() => {
+    jest.useRealTimers();
+});
+
+async function renderFullyPopulatedTask(): Promise<HTMLElement> {
+    const renderer = new QueryResultsRenderer(
+        'block-language-tasks',
+        '',
+        new TasksFile('query.md'),
+        () => Promise.resolve(),
+        null,
+    );
+    const allTasks = [TaskBuilder.createFullyPopulatedTask()];
+    const queryRendererParameters = {
+        allTasks,
+        allMarkdownFiles: [],
+        backlinksClickHandler: () => Promise.resolve(),
+        backlinksMousedownHandler: () => Promise.resolve(),
+        editTaskPencilClickHandler: () => Promise.resolve(),
+    };
+    const container = document.createElement('div');
+
+    await renderer.render(State.Warm, allTasks, container, queryRendererParameters);
+
+    return container;
+}
+
 describe('QueryResultsRenderer tests', () => {
     it('fully populated task', async () => {
-        const renderer = new QueryResultsRenderer(
-            'block-language-tasks',
-            '',
-            new TasksFile('query.md'),
-            () => Promise.resolve(),
-            null,
-        );
-        const allTasks = [TaskBuilder.createFullyPopulatedTask()];
-        const queryRendererParameters = {
-            allTasks,
-            allMarkdownFiles: [],
-            backlinksClickHandler: () => Promise.resolve(),
-            backlinksMousedownHandler: () => Promise.resolve(),
-            editTaskPencilClickHandler: () => Promise.resolve(),
-        };
-        const container = document.createElement('div');
-
-        await renderer.render(State.Warm, allTasks, container, queryRendererParameters);
+        const container = await renderFullyPopulatedTask();
 
         const prettyHTML = prettifyHTML(container.outerHTML);
         verifyWithFileExtension(prettyHTML, 'html');
     });
 });
+
+describe('right-clicking date emojis in task results', () => {
+    // The mock Menu class does not implement the methods used to display a menu,
+    // so provide spies that record the menu instances that the renderer displays.
+    // Both of the Obsidian APIs for showing a menu are supported, so that any
+    // reasonable implementation of the right-click behaviour is accepted.
+    const shownMenus: Menu[] = [];
+    const menuPrototype = Menu.prototype as unknown as {
+        showAtPosition?: unknown;
+        showAtMouseEvent?: unknown;
+    };
+    const originalShowAtPosition = menuPrototype.showAtPosition;
+    const originalShowAtMouseEvent = menuPrototype.showAtMouseEvent;
+
+    beforeEach(() => {
+        shownMenus.length = 0;
+        const recordMenu = jest.fn(function (this: Menu) {
+            shownMenus.push(this);
+        });
+        menuPrototype.showAtPosition = recordMenu;
+        menuPrototype.showAtMouseEvent = recordMenu;
+    });
+
+    afterEach(() => {
+        menuPrototype.showAtPosition = originalShowAtPosition;
+        menuPrototype.showAtMouseEvent = originalShowAtMouseEvent;
+    });
+
+    it.each(dateFields)('should apply a chosen date-menu action to the %s field', async (dateField) => {
+        const menuActions: Array<(evt: MouseEvent | KeyboardEvent) => unknown> = [];
+        const originalOnClick = MenuItem.prototype.onClick;
+        const onClickSpy = jest.spyOn(MenuItem.prototype, 'onClick').mockImplementation(
+            function (this: MenuItem, callback: (evt: MouseEvent | KeyboardEvent) => any) {
+                menuActions.push(callback);
+                return originalOnClick.call(this, callback);
+            },
+        );
+        const saveTaskSpy = jest.spyOn(ObsidianFile, 'replaceTaskWithTasks').mockResolvedValue();
+
+        try {
+            const container = await renderFullyPopulatedTask();
+            const targetLabel = dateFields.find(([field]) => field === dateField)![1];
+            const titlePrefix = `Click to edit ${targetLabel}`;
+            const dateSpan = Array.from(container.querySelectorAll<HTMLElement>('[title]')).find(
+                (element) => element.title.startsWith(titlePrefix),
+            );
+            expect(dateSpan).toBeDefined();
+            dateSpan!.dispatchEvent(new MouseEvent('contextmenu', { bubbles: true, cancelable: true }));
+
+            let changedTask: { originalTask: Task; newTask: Task } | undefined;
+            for (const menuAction of menuActions) {
+                saveTaskSpy.mockClear();
+                await menuAction(new MouseEvent('click'));
+                const saved = saveTaskSpy.mock.calls[0]?.[0];
+                if (saved === undefined) {
+                    continue;
+                }
+                const newTask = Array.isArray(saved.newTasks) ? saved.newTasks[0] : saved.newTasks;
+                const oldDate = saved.originalTask[dateField];
+                const newDate = newTask[dateField];
+                if (oldDate === null ? newDate !== null : newDate === null || !newDate.isSame(oldDate)) {
+                    changedTask = { originalTask: saved.originalTask, newTask };
+                    break;
+                }
+            }
+
+            expect(changedTask).toBeDefined();
+            const originalDate = changedTask!.originalTask[dateField];
+            const updatedDate = changedTask!.newTask[dateField];
+            expect(originalDate === null ? updatedDate !== null : updatedDate === null || !updatedDate.isSame(originalDate)).toBe(true);
+            for (const [otherField] of dateFields.filter(([field]) => field !== dateField)) {
+                const oldDate = changedTask!.originalTask[otherField];
+                const newDate = changedTask!.newTask[otherField];
+                expect(newDate === null ? oldDate === null : oldDate !== null && newDate.isSame(oldDate)).toBe(true);
+            }
+        } finally {
+            saveTaskSpy.mockRestore();
+            onClickSpy.mockRestore();
+        }
+    });
+
+    it.each(dateFields.map(([, fieldLabel]) => fieldLabel))('should open a menu when right-clicking the %s emoji', async (dateFieldLabel) => {
+        const container = await renderFullyPopulatedTask();
+        const titlePrefix = `Click to edit ${dateFieldLabel}`;
+        const dateSpan = Array.from(container.querySelectorAll<HTMLElement>('[title]')).find(
+            (element) => element.title.startsWith(titlePrefix),
+        );
+
+        expect(dateSpan).toBeDefined();
+        expect(dateSpan!.title).toBe(`${titlePrefix}, Right-click for more options`);
+        dateSpan!.dispatchEvent(new MouseEvent('contextmenu', { bubbles: true, cancelable: true }));
+
+        expect(shownMenus).toHaveLength(1);
+    });
+});
