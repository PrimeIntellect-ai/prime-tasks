diff --git a/src/tests/date-picker/DatePicker.spec.ts b/src/tests/date-picker/DatePicker.spec.ts
index 2ff9089e..aec566cf 100644
--- a/src/tests/date-picker/DatePicker.spec.ts
+++ b/src/tests/date-picker/DatePicker.spec.ts
@@ -560,4 +560,103 @@ describe('DatePicker', () => {
 
 		expect(trigger).toBeDisabled();
 	});
+
+	test('initial numberOfMonths option renders and updates the requested month count', async () => {
+		const { getAllByTestId, getByTestId, user } = setup({ numberOfMonths: 3 });
+
+		expect(getAllByTestId(/^grid-\d+$/)).toHaveLength(3);
+
+		await user.click(getByTestId('numberOfMonths'));
+		expect(getAllByTestId(/^grid-\d+$/)).toHaveLength(4);
+	});
+
+	test('initial fixedWeeks option renders and updates the week layout', async () => {
+		const { getByTestId, user } = setup({
+			defaultPlaceholder: new CalendarDate(2024, 2, 1),
+			fixedWeeks: true,
+		});
+		const grid = getByTestId('grid-0');
+
+		expect(grid.querySelectorAll('[data-testid^="week-"]')).toHaveLength(6);
+
+		await user.click(getByTestId('fixedWeeks'));
+		expect(grid.querySelectorAll('[data-testid^="week-"]')).toHaveLength(5);
+	});
+
+	test('initial weekStartsOn option determines and updates weekday ordering', async () => {
+		const { getByTestId, user } = setup({ weekStartsOn: 1 });
+		const weekdays = getByTestId('weekdays');
+		const getDisplayedWeekdays = () =>
+			Array.from(weekdays.children, (day) => day.textContent?.trim());
+
+		expect(getDisplayedWeekdays()).toEqual([...narrowWeekdays.slice(1), narrowWeekdays[0]]);
+
+		await user.click(getByTestId('weekStartsOn'));
+		expect(getDisplayedWeekdays()).toEqual([
+			...narrowWeekdays.slice(2),
+			...narrowWeekdays.slice(0, 2),
+		]);
+	});
+
+	test('dynamically change numberOfMonths option even if numberOfMonths is specified as an option', async () => {
+		const { queryByTestId, getByTestId, user } = setup({
+			numberOfMonths: 1,
+		});
+
+		let grid0 = queryByTestId('grid-0');
+		let grid1 = queryByTestId('grid-1');
+		expect(grid0).toBeInTheDocument();
+		expect(grid1).toBeNull();
+
+		const numberOfMonthsButton = getByTestId('numberOfMonths');
+		await user.click(numberOfMonthsButton);
+
+		grid0 = queryByTestId('grid-0');
+		grid1 = queryByTestId('grid-1');
+		expect(grid0).toBeInTheDocument();
+		expect(grid1).toBeInTheDocument();
+	});
+
+	test('dynamically change weekStartsOn option even if weekStartsOn option is set', async () => {
+		const { getByTestId, user } = setup({
+			weekStartsOn: 0,
+		});
+
+		const weekDaysCopy = [...narrowWeekdays];
+
+		let weekdayElement = getByTestId(`weekdays`);
+
+		for (let i = 0; i < weekDaysCopy.length; i++) {
+			expect(weekdayElement.children[i]).toHaveTextContent(weekDaysCopy[i]);
+		}
+
+		const weekStartsOnButton = getByTestId('weekStartsOn');
+		await user.click(weekStartsOnButton);
+		const first = weekDaysCopy.shift();
+		if (first) {
+			weekDaysCopy.push(first);
+		}
+
+		weekdayElement = getByTestId(`weekdays`);
+		for (let i = 0; i < weekDaysCopy.length; i++) {
+			expect(weekdayElement.children[i]).toHaveTextContent(weekDaysCopy[i]);
+		}
+	});
+
+	test('dynamically change fixedWeeks option even if fixedWeeks option is set', async () => {
+		const { getByTestId, queryByTestId, user } = setup({
+			fixedWeeks: false,
+		});
+
+		const nextButton = getByTestId('next-button');
+
+		while (queryByTestId('week-6') !== null) {
+			await user.click(nextButton);
+		}
+
+		const fixedWeeksButton = getByTestId('fixedWeeks');
+		await user.click(fixedWeeksButton);
+
+		expect(queryByTestId('week-6')).not.toBeNull();
+	});
 });
