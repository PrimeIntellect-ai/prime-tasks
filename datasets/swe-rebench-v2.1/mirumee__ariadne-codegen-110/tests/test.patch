+
+
+@pytest.mark.parametrize(
+    "operation_str, expected_field_name, result_file_name",
+    [
+        ("query TestQuery { testQ }", "testQ", "test_query.py"),
+        ("mutation TestMutation { testM }", "testM", "test_mutation.py"),
+    ],
+)
+def test_generate_client_supports_custom_operation_type_names(
+    operation_str, expected_field_name, result_file_name, tmp_path
+):
+    schema = build_schema(
+        """
+        schema {
+            query: CustomQueryType
+            mutation: CustomMutationType
+        }
+        type CustomQueryType { testQ: String! }
+        type CustomMutationType { testM: String! }
+        """
+    )
+    generator = PackageGenerator(
+        package_name="generated_client",
+        target_path=str(tmp_path),
+        schema=schema,
+        include_comments=False,
+        convert_to_snake_case=False,
+    )
+    generator.add_operation(parse(operation_str).definitions[0])
+
+    generator.generate()
+
+    generated_result_types = ast.parse(
+        (tmp_path / "generated_client" / result_file_name).read_text()
+    )
+    generated_field_names = {
+        node.target.id
+        for class_def in ast.walk(generated_result_types)
+        if isinstance(class_def, ast.ClassDef)
+        for node in class_def.body
+        if isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name)
+    }
+    assert expected_field_name in generated_field_names
