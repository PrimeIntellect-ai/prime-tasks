+
+func TestDeleteAllSucceedOnNoCaches(t *testing.T) {
+	noCaches := func(reg *httpmock.Registry) {
+		reg.Register(
+			httpmock.REST("GET", "repos/OWNER/REPO/actions/caches"),
+			httpmock.JSONResponse(shared.CachePayload{
+				ActionsCaches: []shared.Cache{},
+				TotalCount:    0,
+			}),
+		)
+	}
+
+	tests := []struct {
+		name    string
+		args    []string
+		stubs   func(*httpmock.Registry)
+		wantErr bool
+	}{
+		{
+			name:  "no caches to delete",
+			args:  []string{"--all", "--succeed-on-no-caches"},
+			stubs: noCaches,
+		},
+		{
+			name:    "no caches to delete without the option",
+			args:    []string{"--all"},
+			stubs:   noCaches,
+			wantErr: true,
+		},
+		{
+			name: "listing caches fails",
+			args: []string{"--all", "--succeed-on-no-caches"},
+			stubs: func(reg *httpmock.Registry) {
+				reg.Register(
+					httpmock.REST("GET", "repos/OWNER/REPO/actions/caches"),
+					httpmock.StatusStringResponse(500, ""),
+				)
+			},
+			wantErr: true,
+		},
+		{
+			name: "deleting a cache fails",
+			args: []string{"--all", "--succeed-on-no-caches"},
+			stubs: func(reg *httpmock.Registry) {
+				reg.Register(
+					httpmock.REST("GET", "repos/OWNER/REPO/actions/caches"),
+					httpmock.JSONResponse(shared.CachePayload{
+						ActionsCaches: []shared.Cache{
+							{Id: 123, Key: "foo"},
+						},
+					}),
+				)
+				reg.Register(
+					httpmock.REST("DELETE", "repos/OWNER/REPO/actions/caches/123"),
+					httpmock.StatusStringResponse(500, ""),
+				)
+			},
+			wantErr: true,
+		},
+		{
+			name: "caches are deleted",
+			args: []string{"--all", "--succeed-on-no-caches"},
+			stubs: func(reg *httpmock.Registry) {
+				reg.Register(
+					httpmock.REST("GET", "repos/OWNER/REPO/actions/caches"),
+					httpmock.JSONResponse(shared.CachePayload{
+						ActionsCaches: []shared.Cache{
+							{Id: 123, Key: "foo"},
+							{Id: 456, Key: "bar"},
+						},
+					}),
+				)
+				reg.Register(
+					httpmock.REST("DELETE", "repos/OWNER/REPO/actions/caches/123"),
+					httpmock.StatusStringResponse(204, ""),
+				)
+				reg.Register(
+					httpmock.REST("DELETE", "repos/OWNER/REPO/actions/caches/456"),
+					httpmock.StatusStringResponse(204, ""),
+				)
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			reg := &httpmock.Registry{}
+			tt.stubs(reg)
+			defer reg.Verify(t)
+
+			ios, _, _, _ := iostreams.Test()
+			f := &cmdutil.Factory{
+				IOStreams: ios,
+				HttpClient: func() (*http.Client, error) {
+					return &http.Client{Transport: reg}, nil
+				},
+				BaseRepo: func() (ghrepo.Interface, error) {
+					return ghrepo.New("OWNER", "REPO"), nil
+				},
+			}
+			cmd := NewCmdDelete(f, nil)
+			cmd.SetArgs(tt.args)
+			cmd.SetIn(&bytes.Buffer{})
+			cmd.SetOut(&bytes.Buffer{})
+			cmd.SetErr(&bytes.Buffer{})
+
+			_, err := cmd.ExecuteC()
+			if tt.wantErr {
+				assert.Error(t, err)
+			} else {
+				assert.NoError(t, err)
+			}
+		})
+	}
+}
