+func TestUninstallWaitFailure(t *testing.T) {
+	store := storageFixture()
+	rel := release.Mock(&release.MockReleaseOptions{Name: "aeneas"})
+	if err := store.Create(rel); err != nil {
+		t.Fatal(err)
+	}
+
+	client := &uninstallWaitFailureClient{
+		FailingKubeClient: &kubefake.FailingKubeClient{
+			PrintingKubeClient: kubefake.PrintingKubeClient{Out: &bytes.Buffer{}},
+		},
+	}
+	cfg := &action.Configuration{
+		Releases:     store,
+		KubeClient:   client,
+		Capabilities: chartutil.DefaultCapabilities,
+		Log:          func(string, ...interface{}) {},
+	}
+	args := []string{"uninstall", "aeneas", "--wait", "--timeout", "1ms", "--no-hooks"}
+	output := &bytes.Buffer{}
+	root, err := newRootCmd(cfg, output, args)
+	if err != nil {
+		t.Fatal(err)
+	}
+	root.SetOut(output)
+	root.SetErr(output)
+	root.SetArgs(args)
+	if _, err := root.ExecuteC(); err == nil {
+		t.Fatal("expected uninstall to fail when resources remain after the wait period")
+	} else if strings.Contains(err.Error(), "unknown flag") {
+		t.Fatalf("expected --wait to be accepted before the timeout, got: %v", err)
+	}
+	for _, period := range client.waitedFor {
+		if period > time.Millisecond {
+			t.Errorf("resources were waited on for %v, which exceeds the configured --timeout of 1ms", period)
+		}
+	}
+}
+
+// uninstallWaitFailureClient simulates a release resource that remains present
+// for the whole wait period. Any wait operation reports a timeout while the
+// resource remains, and records the period it was asked to wait for.
+type uninstallWaitFailureClient struct {
+	*kubefake.FailingKubeClient
+	waitedFor []time.Duration
+}
+
+func (c *uninstallWaitFailureClient) Build(_ io.Reader, _ bool) (kube.ResourceList, error) {
+	return kube.ResourceList{&resource.Info{
+		Object: &corev1.Secret{},
+	}}, nil
+}
+
+func (c *uninstallWaitFailureClient) remaining(resources kube.ResourceList, timeout time.Duration) error {
+	if len(resources) == 0 {
+		return nil
+	}
+	c.waitedFor = append(c.waitedFor, timeout)
+	return errors.New("timed out waiting for resources to be deleted")
+}
+
+func (c *uninstallWaitFailureClient) WaitForDelete(resources kube.ResourceList, timeout time.Duration) error {
+	return c.remaining(resources, timeout)
+}
+
+func (c *uninstallWaitFailureClient) Wait(resources kube.ResourceList, timeout time.Duration) error {
+	return c.remaining(resources, timeout)
+}
+
+func (c *uninstallWaitFailureClient) WaitWithJobs(resources kube.ResourceList, timeout time.Duration) error {
+	return c.remaining(resources, timeout)
+}
