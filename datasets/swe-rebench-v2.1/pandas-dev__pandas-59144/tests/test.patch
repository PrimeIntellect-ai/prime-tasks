+    def test_complex_eval(self, engine, parser):
+        # GH#21374
+        df = DataFrame({"a": [1 + 2j], "b": [1 + 1j]})
+        result = df.eval("a/b", engine=engine, parser=parser)
+        expected = Series([1.5 + 0.5j])
         tm.assert_series_equal(result, expected)
 
+    def test_complex_eval_assign_existing_column(self, engine, parser):
+        # GH#21374
+        df = DataFrame({"a": [1 + 2j], "b": [1 + 1j], "c": [1j]})
+        result = df.eval("c = a/b", engine=engine, parser=parser)
+        expected = DataFrame({"a": [1 + 2j], "b": [1 + 1j], "c": [1.5 + 0.5j]})
+        tm.assert_frame_equal(result, expected)
+
+    def test_complex_eval_inplace(self, engine, parser):
+        # GH#21374
+        df = DataFrame({"a": [1 + 2j], "b": [1 + 1j], "c": [1j]})
+        df.eval("c = a/b", inplace=True, engine=engine, parser=parser)
+        expected = DataFrame({"a": [1 + 2j], "b": [1 + 1j], "c": [1.5 + 0.5j]})
+        tm.assert_frame_equal(df, expected)
