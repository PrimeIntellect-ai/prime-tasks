+func TestDisplayOutputFiltering(t *testing.T) {
+	tests := []struct {
+		name              string
+		format            string
+		showNonDeprecated bool
+		want              string
+	}{
+		{
+			name:              "json filters non-deprecated when show-all disabled",
+			format:            "json",
+			showNonDeprecated: false,
+			want:              `[{"file":"some name two","api":{"version":"extensions/v1beta1","kind":"Deployment","deprecated-in":"v1.16.0"}}]`,
+		},
+		{
+			name:              "json includes non-deprecated when show-all enabled",
+			format:            "json",
+			showNonDeprecated: true,
+			want:              `[{"file":"some name one","api":{"version":"apps/v1","kind":"Deployment"}},{"file":"some name two","api":{"version":"extensions/v1beta1","kind":"Deployment","deprecated-in":"v1.16.0"}}]`,
+		},
+		{
+			name:              "yaml filters non-deprecated when show-all disabled",
+			format:            "yaml",
+			showNonDeprecated: false,
+			want:              "- file: some name two\n  api:\n    version: extensions/v1beta1\n    kind: Deployment\n    deprecated-in: v1.16.0",
+		},
+		{
+			name:              "yaml includes non-deprecated when show-all enabled",
+			format:            "yaml",
+			showNonDeprecated: true,
+			want:              "- file: some name one\n  api:\n    version: apps/v1\n    kind: Deployment\n- file: some name two\n  api:\n    version: extensions/v1beta1\n    kind: Deployment\n    deprecated-in: v1.16.0",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			old := os.Stdout
+			r, w, err := os.Pipe()
+			assert.NoError(t, err)
+			os.Stdout = w
+			displayErr := DisplayOutput([]*Output{testOutput1, testOutput2}, tt.format, tt.showNonDeprecated, targetVersion116)
+			w.Close()
+			os.Stdout = old
+			out, _ := ioutil.ReadAll(r)
+			assert.NoError(t, displayErr)
+			assert.Equal(t, tt.want, strings.TrimSpace(string(out)))
 		})
 	}
 }
