+// terminateDealsToleratingRejection attempts to terminate the given deals. The
+// public contract does not specify whether terminating an already-terminated
+// deal is a no-op or an error, so this helper tolerates either: it returns true
+// if the call completed and false if the actor rejected it by aborting.
+func (h *marketActorTestHarness) terminateDealsToleratingRejection(rt *mock.Runtime, minerAddr address.Address, dealIds ...abi.DealID) (completed bool) {
+	rt.SetCaller(minerAddr, builtin.StorageMinerActorCodeID)
+	rt.ExpectValidateCallerType(builtin.StorageMinerActorCodeID)
+
+	params := &market.OnMinerSectorsTerminateParams{DealIDs: dealIds}
+
+	defer func() {
+		if r := recover(); r != nil {
+			// Only tolerate an actor abort; re-panic on anything else.
+			if !strings.HasPrefix(fmt.Sprint(r), "abort(") {
+				panic(r)
+			}
+			completed = false
+		}
+		rt.Verify()
+	}()
+
+	ret := rt.Call(h.OnMinerSectorsTerminate, params)
+	require.Nil(h.t, ret)
+	return true
+}
+
