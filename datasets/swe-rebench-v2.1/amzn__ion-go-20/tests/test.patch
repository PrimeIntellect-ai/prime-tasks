+func TestParseTextEscapeValues(t *testing.T) {
+	tests := []struct {
+		name     string
+		text     string
+		wantType Type
+		want     []string
+	}{
+		{
+			name:     "strings",
+			text:     `"\x48\u03BB\U0001F642"`,
+			wantType: TypeString,
+			want:     []string{"Hλ🙂"},
+		},
+		{
+			name:     "symbols",
+			text:     `'\x48\u03BB\U0001F642'`,
+			wantType: TypeSymbol,
+			want:     []string{"Hλ🙂"},
+		},
+		{
+			name:     "clobs",
+			text:     `{{"\x48\x69"}}`,
+			wantType: TypeClob,
+			want:     []string{"Hi"},
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			digest, err := ParseText(strings.NewReader(test.text))
+			if err != nil {
+				t.Fatalf("ParseText returned an error: %v", err)
+			}
+			values := digest.Value()
+			if len(values) != len(test.want) {
+				t.Fatalf("got %d values, want %d", len(values), len(test.want))
+			}
+			for i, value := range values {
+				if value.Type() != test.wantType {
+					t.Errorf("value %d has type %v, want %v", i, value.Type(), test.wantType)
+				}
+				var got string
+				switch value := value.(type) {
+				case String:
+					got = value.Value()
+				case Symbol:
+					got = value.Value()
+				case Clob:
+					got = value.Value()
+				default:
+					t.Fatalf("value %d has type %T", i, value)
+				}
+				if got != test.want[i] {
+					t.Errorf("value %d = %q, want %q", i, got, test.want[i])
+				}
+			}
+		})
+	}
+}
