+func TestReleaseAsset_GetDigest(tt *testing.T) {
+	tt.Parallel()
+	digest := "sha256:abc123"
+	var apiAsset ReleaseAsset
+	if err := json.Unmarshal([]byte(`{"digest":"sha256:abc123"}`), &apiAsset); err != nil {
+		tt.Fatalf("Unmarshal release asset digest: %v", err)
+	}
+	if got := apiAsset.GetDigest(); got != digest {
+		tt.Errorf("GetDigest() after unmarshalling API response = %q, want %q", got, digest)
+	}
+
+	r := &ReleaseAsset{Digest: &digest}
+	if got := r.GetDigest(); got != digest {
+		tt.Errorf("GetDigest() = %q, want %q", got, digest)
+	}
+
+	r = &ReleaseAsset{}
+	if got := r.GetDigest(); got != "" {
+		tt.Errorf("GetDigest() with nil Digest = %q, want empty string", got)
+	}
+
+	var nilAsset *ReleaseAsset
+	if got := nilAsset.GetDigest(); got != "" {
+		tt.Errorf("GetDigest() on nil receiver = %q, want empty string", got)
+	}
+}
