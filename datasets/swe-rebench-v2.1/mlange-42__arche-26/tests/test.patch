@@ -0,0 +1,39 @@
+package ecs
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestBitPool(t *testing.T) {
+	p := newBitPool()
+
+	allocated := map[uint8]bool{}
+	for i := 0; i < MaskTotalBits; i++ {
+		b := p.Get()
+		assert.True(t, int(b) < MaskTotalBits, "bit out of range: %d", b)
+		assert.False(t, allocated[b], "bit %d was allocated twice", b)
+		allocated[b] = true
+	}
+	assert.Equal(t, MaskTotalBits, len(allocated))
+
+	assert.Panics(t, func() { p.Get() })
+
+	recycled := map[uint8]bool{}
+	for i := 0; i < 10; i++ {
+		p.Recycle(uint8(i))
+		recycled[uint8(i)] = true
+	}
+
+	reused := map[uint8]bool{}
+	for i := 0; i < len(recycled); i++ {
+		b := p.Get()
+		assert.True(t, recycled[b], "Get returned a bit that was not recycled: %d", b)
+		assert.False(t, reused[b], "recycled bit %d was returned twice", b)
+		reused[b] = true
+	}
+	assert.Equal(t, len(recycled), len(reused))
+
+	assert.Panics(t, func() { p.Get() })
+}
