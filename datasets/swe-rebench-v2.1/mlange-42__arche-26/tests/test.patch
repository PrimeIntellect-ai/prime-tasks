+
+	// The world supports at most MaskTotalBits concurrent queries.
+	queries := make([]Query, 0, MaskTotalBits)
+	for i := 0; i < MaskTotalBits; i++ {
+		queries = append(queries, world.Query(posID, rotID))
+	}
+	assert.True(t, world.IsLocked())
+	assert.Panics(t, func() { world.Query(posID, rotID) })
+
+	for i := range queries {
+		queries[i].Close()
+	}
+	assert.False(t, world.IsLocked())
+}
