+
+#[test]
+fn doc_comment_about_handles_both_abouts() {
+    /// Opts doc comment summary
+    #[derive(Parser, Debug)]
+    pub struct Opts {
+        #[clap(subcommand)]
+        pub cmd: Sub,
+    }
+
+    /// Sub doc comment summary
+    ///
+    /// Sub doc comment body
+    #[derive(Parser, PartialEq, Eq, Debug)]
+    pub enum Sub {
+        Compress { output: String },
+    }
+
+    let app = Opts::into_app();
+    assert_eq!(app.get_about(), Some("Opts doc comment summary"));
+    // clap will fallback to `about` on `None`.  The main care about is not providing a `Sub` doc
+    // comment.
+    assert_eq!(app.get_long_about(), None);
+
+    // The rendered help must reflect the parent's doc comment.
+    let help = utils::get_help::<Opts>();
+    assert!(help.contains("Opts doc comment summary"));
+
+    let long_help = utils::get_long_help::<Opts>();
+    assert!(long_help.contains("Opts doc comment summary"));
+}
