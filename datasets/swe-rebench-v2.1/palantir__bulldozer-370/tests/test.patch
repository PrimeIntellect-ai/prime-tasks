 package bulldozer
 
 import (
+	"bytes"
 	"context"
+	"fmt"
+	"io"
+	"net/http"
 	"testing"
 
+	"github.com/google/go-github/v47/github"
 	"github.com/palantir/bulldozer/pull"
 	"github.com/palantir/bulldozer/pull/pulltest"
 	"github.com/stretchr/testify/assert"
@@ -181,3 +186,51 @@ func TestPushRestrictionMerger(t *testing.T) {
 	assert.Equal(t, 1, normal.DeleteCount, "normal delete was incorrectly called")
 	assert.Equal(t, 1, restricted.DeleteCount, "restricted delete was not called")
 }
+
+func TestAttemptMergeSuccessful(t *testing.T) {
+	merger := &MockMerger{}
+	ctx := context.Background()
+	pullCtx := &pulltest.MockPullContext{MergeStateValue: &pull.MergeState{Closed: false, Mergeable: boolVal(true)}}
+
+	merged, _ := attemptMerge(ctx, pullCtx, merger, SquashAndMerge, CommitMessage{})
+
+	assert.True(t, merged, "should report a successful merge")
+}
+
+func TestBaseBranchChangedRetry(t *testing.T) {
+	merger := &MockMerger{
+		MergeError: github.CheckResponse(
+			&http.Response{
+				StatusCode: http.StatusMethodNotAllowed,
+				Body: io.NopCloser(
+					bytes.NewReader([]byte(
+						fmt.Sprintf(`{"message": "%s"}`, "Base branch was modified. Review and try the merge again.")))),
+			},
+		),
+	}
+	ctx := context.Background()
+	pullCtx := &pulltest.MockPullContext{MergeStateValue: &pull.MergeState{Closed: false, Mergeable: boolVal(true)}}
+
+	merged, retry := attemptMerge(ctx, pullCtx, merger, SquashAndMerge, CommitMessage{})
+	assert.False(t, merged, "should not report a merge when the merge was rejected")
+	assert.True(t, retry, "should retry on base branch changed error")
+}
+
+func TestMergeRejectedOtherReasonNoRetry(t *testing.T) {
+	merger := &MockMerger{
+		MergeError: github.CheckResponse(
+			&http.Response{
+				StatusCode: http.StatusMethodNotAllowed,
+				Body: io.NopCloser(
+					bytes.NewReader([]byte(
+						fmt.Sprintf(`{"message": "%s"}`, "Merge rejected due to unsatisfied condition: \"Required status check is expected.\"")))),
+			},
+		),
+	}
+	ctx := context.Background()
+	pullCtx := &pulltest.MockPullContext{MergeStateValue: &pull.MergeState{Closed: false, Mergeable: boolVal(true)}}
+
+	merged, retry := attemptMerge(ctx, pullCtx, merger, SquashAndMerge, CommitMessage{})
+	assert.False(t, retry, "should not retry when merge is rejected for a reason other than a modified base branch")
+	assert.False(t, merged, "should not report a merge when the merge failed")
+}
