+start:
+    goto end
+
+forget_all:
+    remember toto = "text"
+    say _memory
+    forget *
+    say _memory
+
+    goto end
+
+forget_single:
+    remember toto = "text"
+    say _memory
+    forget tutu
+    say _memory
+
+    goto end
+
+forget_list:
+    remember toto = "text"
+    say _memory
+    forget [tutu, tata]
+    say _memory
+
+    goto end
diff --git a/csml_interpreter/tests/forget.rs b/csml_interpreter/tests/forget.rs
new file mode 100644
index 0000000..7accd45
--- /dev/null
+++ b/csml_interpreter/tests/forget.rs
@@ -0,0 +1,84 @@
+mod support;
+
+use csml_interpreter::data::context::Context;
+use csml_interpreter::data::{event::Event, primitive::PrimitiveString, Interval};
+use std::collections::HashMap;
+
+use crate::support::tools::format_message;
+use crate::support::tools::message_to_json_value;
+
+use serde_json::Value;
+
+/// Build a set of pre-existing client memories, as they would be loaded from
+/// the client's stored memories before a flow runs.
+fn client_memories() -> HashMap<String, csml_interpreter::data::Literal> {
+    let mut current = HashMap::new();
+    current.insert(
+        "tutu".to_owned(),
+        PrimitiveString::get_literal("tutu_value", Interval::default()),
+    );
+    current.insert(
+        "tata".to_owned(),
+        PrimitiveString::get_literal("tata_value", Interval::default()),
+    );
+    current.insert(
+        "titi".to_owned(),
+        PrimitiveString::get_literal("titi_value", Interval::default()),
+    );
+    current
+}
+
+fn run(step: &str) -> Value {
+    let msg = format_message(
+        Event::new("payload", "", serde_json::json!({})),
+        Context::new(client_memories(), HashMap::new(), None, None, step, "flow"),
+        "CSML/basic_test/syntax/forget.csml",
+    );
+
+    message_to_json_value(msg)
+}
+
+#[test]
+fn forget_all() {
+    let data = r#"{
+        "memories":[],
+        "messages":[
+            {"content": {"tata": "tata_value", "titi": "titi_value", "toto": "text", "tutu": "tutu_value"}, "content_type": "object"},
+            {"content": {}, "content_type": "object"}
+        ]
+    }"#;
+
+    let v1: Value = run("forget_all");
+    let v2: Value = serde_json::from_str(data).unwrap();
+    assert_eq!(v1, v2)
+}
+
+#[test]
+fn forget_single() {
+    let data = r#"{
+        "memories":[{"key": "toto", "value": "text"}],
+        "messages":[
+            {"content": {"tata": "tata_value", "titi": "titi_value", "toto": "text", "tutu": "tutu_value"}, "content_type": "object"},
+            {"content": {"tata": "tata_value", "titi": "titi_value", "toto": "text"}, "content_type": "object"}
+        ]
+    }"#;
+
+    let v1: Value = run("forget_single");
+    let v2: Value = serde_json::from_str(data).unwrap();
+    assert_eq!(v1, v2)
+}
+
+#[test]
+fn forget_list() {
+    let data = r#"{
+        "memories":[{"key": "toto", "value": "text"}],
+        "messages":[
+            {"content": {"tata": "tata_value", "titi": "titi_value", "toto": "text", "tutu": "tutu_value"}, "content_type": "object"},
+            {"content": {"titi": "titi_value", "toto": "text"}, "content_type": "object"}
+        ]
+    }"#;
+
+    let v1: Value = run("forget_list");
+    let v2: Value = serde_json::from_str(data).unwrap();
+    assert_eq!(v1, v2)
+}
