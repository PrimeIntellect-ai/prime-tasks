+def test_signature_fields_after_dump_and_load_state(tmp_path):
+    class CustomSignature(dspy.Signature):
+        """A signature with metadata on more than two fields."""
+
+        sentence = dspy.InputField(desc="Input description", prefix="Text to analyze:")
+        sentiment = dspy.OutputField(desc="Sentiment description", prefix="Sentiment label:")
+        rationale = dspy.OutputField(desc="Reasoning description", prefix="Reasoning:")
+
+    file_path = tmp_path / "tmp.json"
+    original_instance = Predict(CustomSignature)
+    original_instance.save(file_path)
+
+    class DifferentSignature(dspy.Signature):
+        """Different metadata that must be replaced by the saved state."""
+
+        sentence = dspy.InputField(desc="Different input", prefix="Different input:")
+        sentiment = dspy.OutputField(desc="Different output", prefix="Different output:")
+        rationale = dspy.OutputField(desc="Different rationale", prefix="Different rationale:")
+
+    new_instance = Predict(DifferentSignature)
+    new_instance.load(file_path)
+
+    expected_metadata = {
+        "sentence": ("Text to analyze:", "Input description"),
+        "sentiment": ("Sentiment label:", "Sentiment description"),
+        "rationale": ("Reasoning:", "Reasoning description"),
+    }
+    for name, (expected_prefix, expected_description) in expected_metadata.items():
+        metadata = new_instance.signature.fields[name].json_schema_extra
+        assert metadata["prefix"] == expected_prefix
+        assert metadata["desc"] == expected_description
+
 
 def test_forward_method():
     program = Predict("question -> answer")
