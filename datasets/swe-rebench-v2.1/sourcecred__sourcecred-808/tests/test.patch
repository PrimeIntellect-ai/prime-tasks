 describe("plugins/github/edges", () => {
+  it("connects a comment to an earlier comment by a mentioned author", () => {
+    const data = exampleData();
+    const issue = data.repository.issues.nodes.find((node) => node.number === 2);
+    issue.comments.nodes[1].body = "@decentralion";
+    const view = new RelationalView();
+    view.addData(data);
+    const comments = Array.from(view.comments());
+    const graphEdges = Array.from(createGraph(view).edges());
+    const hasMentionEdge = comments.some((comment, index) => {
+      const precedingComments = comments.slice(0, index);
+      return precedingComments.some((earlierComment) => {
+        const sameThread =
+          GN.toRaw(comment.parent().address()) ===
+          GN.toRaw(earlierComment.parent().address());
+        const earlierAuthors = Array.from(earlierComment.authors());
+        const mentionsEarlierAuthor = earlierAuthors.some((author) =>
+          comment.body().includes(`@${author.login()}`)
+        );
+        const source = GN.toRaw(comment.address());
+        const destination = GN.toRaw(earlierComment.address());
+        const edgeExists = graphEdges.some(
+          (edge) => edge.src === source && edge.dst === destination
+        );
+        return sameThread && mentionsEarlierAuthor && edgeExists;
+      });
+    });
+    expect(hasMentionEdge).toBe(true);
+  });
