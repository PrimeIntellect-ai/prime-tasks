+test("getPipFrozenTree handles circular python dependencies", () => {
+  // Build a synthetic python environment that contains a dependency cycle.
+  const tmpDir = mkdtempSync(join(tmpdir(), "cdxgen-piptree-test-"));
+  const siteDir = join(tmpDir, "site");
+  mkdirSync(siteDir);
+  for (const [name, dep] of [
+    ["pkgA", "pkgB"],
+    ["pkgB", "pkgA"],
+    ["pkgC", "pkgA"]
+  ]) {
+    const distInfo = join(siteDir, `${name}-1.0.0.dist-info`);
+    mkdirSync(distInfo);
+    writeFileSync(
+      join(distInfo, "METADATA"),
+      `Metadata-Version: 2.1\nName: ${name}\nVersion: 1.0.0\nRequires-Dist: ${dep}\n`
+    );
+    writeFileSync(
+      join(distInfo, "RECORD"),
+      `${name}-1.0.0.dist-info/METADATA,,\n`
+    );
+  }
+  const oldVenv = process.env.VIRTUAL_ENV;
+  const oldPythonPath = process.env.PYTHONPATH;
+  process.env.VIRTUAL_ENV = tmpDir;
+  process.env.PYTHONPATH = siteDir;
+  try {
+    const result = getPipFrozenTree(tmpDir, null, join(tmpDir, "venv"));
+    expect(Array.isArray(result.pkgList)).toBe(true);
+    expect(result.pkgList.some((p) => p.name === "pkgc")).toBe(true);
+  } finally {
+    if (oldVenv === undefined) {
+      delete process.env.VIRTUAL_ENV;
+    } else {
+      process.env.VIRTUAL_ENV = oldVenv;
+    }
+    if (oldPythonPath === undefined) {
+      delete process.env.PYTHONPATH;
+    } else {
+      process.env.PYTHONPATH = oldPythonPath;
+    }
+  }
+});
+
+test("Python BOM generation completes for an unpinned requirements project", async () => {
+  const tmpDir = mkdtempSync(join(tmpdir(), "cdxgen-python-project-"));
+  const siteDir = join(tmpDir, "site");
+  mkdirSync(siteDir);
+  for (const [name, dep] of [
+    ["pkgA", "pkgB"],
+    ["pkgB", "pkgA"],
+    ["pkgC", "pkgA"]
+  ]) {
+    const distInfo = join(siteDir, `${name}-1.0.0.dist-info`);
+    mkdirSync(distInfo);
+    writeFileSync(
+      join(distInfo, "METADATA"),
+      `Metadata-Version: 2.1\nName: ${name}\nVersion: 1.0.0\nRequires-Dist: ${dep}\n`
+    );
+    writeFileSync(
+      join(distInfo, "RECORD"),
+      `${name}-1.0.0.dist-info/METADATA,,\n`
+    );
+  }
+  writeFileSync(
+    join(tmpDir, "requirements.txt"),
