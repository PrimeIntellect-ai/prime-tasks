+async def test_client_session_get_with_link_local_resolution(
+    aiohttp_server, loop, monkeypatch
+) -> None:
+    async def handler(request):
+        return web.Response(text="connected")
+
+    app = web.Application()
+    app.router.add_get("/", handler)
+    server = await aiohttp_server(app)
+    port = server.port
+
+    async def getaddrinfo(host, requested_port, **kwargs):
+        assert host == "link-local.example"
+        return [
+            (
+                socket.AF_INET6,
+                socket.SOCK_STREAM,
+                socket.IPPROTO_TCP,
+                "",
+                ("fe80::1", requested_port, 0, 3),
+            ),
+            (
+                socket.AF_INET,
+                socket.SOCK_STREAM,
+                socket.IPPROTO_TCP,
+                "",
+                ("127.0.0.1", requested_port),
+            ),
+        ]
+
+    async def getnameinfo(address, flags):
+        if flags == socket.AI_NUMERICHOST | socket.AI_NUMERICSERV:
+            raise socket.gaierror("invalid flags for getnameinfo")
+        # Route the simulated device to the local test server after the lookup.
+        return "127.0.0.1", str(port)
+
+    monkeypatch.setattr(loop, "getaddrinfo", getaddrinfo)
+    monkeypatch.setattr(loop, "getnameinfo", getnameinfo)
+    connector = aiohttp.TCPConnector(
+        resolver=ThreadedResolver(loop=loop),
+        use_dns_cache=False,
+    )
+    async with aiohttp.ClientSession(connector=connector) as session:
+        async with session.get(f"http://link-local.example:{port}/") as response:
+            assert response.status == 200
+            assert await response.text() == "connected"
+
+
