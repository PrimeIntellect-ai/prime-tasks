+    it('derives the name of a module command from its filename when command is omitted', function () {
+      var commandModule = require('./fixtures/cmddir_noname/nameless')
+      var handler = commandModule.handler
+      delete commandModule.handler
+      var y = yargs('nameless').command(commandModule)
+      var commands = y.getUsageInstance().getCommands()
+      var argv
+      try {
+        argv = y.argv
+      } finally {
+        commandModule.handler = handler
+      }
+
+      commands[0][0].should.equal('nameless')
+      argv._.should.include('nameless')
+      argv.banana.should.equal('cool')
+    })
+
