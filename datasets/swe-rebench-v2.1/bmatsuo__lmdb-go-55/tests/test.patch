+
+func TestMapResizedDefaultDelayGrowsWithRetries(t *testing.T) {
+	ctx := context.Background()
+	env, err := newEnv(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lmdbtest.Destroy(env.Env)
+
+	mapResized := &lmdb.OpError{Op: "lmdbsync_test_op", Errno: lmdb.MapResized}
+	const samples = 80
+	meanDelay := func(attempt int) time.Duration {
+		var total time.Duration
+		for i := 0; i < samples; i++ {
+			handler := MapResizedHandler(3, nil)
+			attemptCtx := ctx
+			for j := 0; j <= attempt; j++ {
+				started := time.Now()
+				var result error
+				attemptCtx, result = handler.HandleTxnErr(attemptCtx, env, mapResized)
+				elapsed := time.Since(started)
+				if result != ErrTxnRetry {
+					t.Fatalf("attempt %d: unexpected error: %v", j, result)
+				}
+				if j == attempt {
+					total += elapsed
+				}
+			}
+		}
+		return total / samples
+	}
+
+	first := meanDelay(1)
+	later := meanDelay(2)
+	if later <= first {
+		t.Errorf("default retry delay did not grow: second-attempt average %v, third-attempt average %v", first, later)
+	}
+}
