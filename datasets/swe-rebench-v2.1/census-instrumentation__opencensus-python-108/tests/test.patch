+    def test_intercept_handler_exception(self):
+        exported_traces = []
+
+        class RecordingExporter(object):
+            def export(self, trace):
+                exported_traces.append(trace)
+
+        interceptor = server_interceptor.OpenCensusServerInterceptor(
+            None, RecordingExporter())
+        mock_context = mock.Mock()
+        mock_context.invocation_metadata = mock.Mock(return_value=None)
+        mock_details = mock.Mock()
+        mock_details.invocation_metadata = None
+        mock_handler = mock.Mock()
+        handler_error = Exception('Test')
+        mock_handler.unary_unary = mock.Mock(side_effect=handler_error)
+        mock_continuation = mock.Mock(return_value=mock_handler)
+        rpc_wrapper = interceptor.intercept_handler(
+            mock_continuation, mock_details)
+        with self.assertRaises(Exception) as raised:
+            rpc_wrapper.unary_unary(mock.Mock(), mock_context)
+
+        self.assertIs(raised.exception, handler_error)
+        span = exported_traces[0]['spans'][0]
+        attributes = span['attributes']['attributeMap']
+        self.assertEqual(
+            attributes['/error/message']['string_value']['value'], 'Test')
+
+    def test_intercept_handler_ends_span_after_handler(self):
+        """The server span must end only after the handler has executed."""
+        events = []
+
+        class RecordingExporter(object):
+            def export(self, trace):
+                events.append('end_span')
+
+        interceptor = server_interceptor.OpenCensusServerInterceptor(
+            None, RecordingExporter())
+        mock_context = mock.Mock()
+        mock_context.invocation_metadata = mock.Mock(return_value=None)
+        mock_details = mock.Mock()
+        mock_details.invocation_metadata = None
+
+        def handler(request, context):
+            events.append('handler')
+            return 'response'
+
+        mock_handler = mock.Mock()
+        mock_handler.unary_unary = handler
+        mock_continuation = mock.Mock(return_value=mock_handler)
+
+        rpc_wrapper = interceptor.intercept_handler(
+            mock_continuation, mock_details)
+        rpc_wrapper.unary_unary(mock.Mock(), mock_context)
+
+        self.assertEqual(events, ['handler', 'end_span'])
+
 
