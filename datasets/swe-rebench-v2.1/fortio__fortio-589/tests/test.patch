+func TestGrpcPingHealthExitStatus(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal("failed to listen for gRPC health server:", err)
+	}
+	defer listener.Close()
+	server := grpc.NewServer()
+	healthServer := health.NewServer()
+	healthServer.SetServingStatus("foo", grpc_health_v1.HealthCheckResponse_SERVING)
+	healthServer.SetServingStatus("foo_down", grpc_health_v1.HealthCheckResponse_NOT_SERVING)
+	grpc_health_v1.RegisterHealthServer(server, healthServer)
+	go func() { _ = server.Serve(listener) }()
+	defer server.Stop()
+	addr := listener.Addr().String()
+	for _, tc := range []struct {
+		service string
+		wantOK  bool
+	}{
+		{service: "foo", wantOK: true},
+		{service: "foo_down", wantOK: false},
+	} {
+		t.Run(tc.service, func(t *testing.T) {
+			cmd := exec.Command("go", "run", ".", "grpcping", "-health", "-healthservice", tc.service, "-n", "1", addr)
+			cmd.Dir = ".."
+			output, err := cmd.CombinedOutput()
+			if tc.wantOK && err != nil {
+				t.Fatalf("SERVING health check failed: %v\n%s", err, output)
+			}
+			if !tc.wantOK && err == nil {
+				t.Fatalf("NOT_SERVING health check unexpectedly succeeded\n%s", output)
+			}
+		})
+	}
+}
