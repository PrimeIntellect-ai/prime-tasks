index 0000000..de87767
--- /dev/null
+++ b/packages/data-point-codemods/transforms/__tests__/change-path-reducer-accessing-root-path.test.js
@@ -0,0 +1,68 @@
+/* eslint-env jest */
+
+'use strict'
+
+const fs = require('fs')
+const path = require('path')
+const jscodeshift = require('jscodeshift')
+
+const transformsDirectory = path.resolve(__dirname, '..')
+const fixturesDirectory = path.resolve(__dirname, '../__testfixtures__')
+const transformFiles = fs
+  .readdirSync(transformsDirectory)
+  .filter(filename => filename.endsWith('.js'))
+
+function literalValues (source) {
+  const root = jscodeshift(source)
+  const values = []
+
+  root.find(jscodeshift.Literal).forEach(({ value }) => {
+    if (typeof value.value === 'string') values.push(value.value)
+  })
+  root.find(jscodeshift.TemplateLiteral).forEach(({ value }) => {
+    value.quasis.forEach(quasi => values.push(quasi.value.raw))
+  })
+
+  return values.sort()
+}
+
+function appliesExpectedChanges (source, expectedValues) {
+  return transformFiles.some(filename => {
+    try {
+      const transform = require(path.join(transformsDirectory, filename))
+      if (typeof transform !== 'function') return false
+
+      const transformed = transform(
+        { source },
+        { jscodeshift, j: jscodeshift }
+      )
+      return (
+        typeof transformed === 'string' &&
+        JSON.stringify(literalValues(transformed)) ===
+          JSON.stringify(expectedValues)
+      )
+    } catch (error) {
+      return false
+    }
+  })
+}
+
+describe('PathReducer root notation codemod', () => {
+  ;[
+    'change-path-reducer-accessing-root-path-single-quote',
+    'change-path-reducer-accessing-root-path-double-quote'
+  ].forEach(fixture => {
+    test(`replaces root notation in strings and templates (${fixture})`, () => {
+      const source = fs.readFileSync(
+        path.join(fixturesDirectory, `${fixture}.input.js`),
+        'utf8'
+      )
+      const expected = fs.readFileSync(
+        path.join(fixturesDirectory, `${fixture}.output.js`),
+        'utf8'
+      )
+
+      expect(appliesExpectedChanges(source, literalValues(expected))).toBe(true)
+    })
+  })
+})
