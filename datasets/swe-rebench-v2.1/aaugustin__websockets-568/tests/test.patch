+
+    def test_connection_closed_ok_is_subclass(self):
+        self.assertTrue(issubclass(ConnectionClosedOK, ConnectionClosed))
+
+    def test_connection_closed_error_is_subclass(self):
+        self.assertTrue(issubclass(ConnectionClosedError, ConnectionClosed))
+
+    def test_connection_closed_ok_represents_normal_closure(self):
+        for code in (1000, 1001):
+            with self.subTest(code=code):
+                exception = ConnectionClosedOK(code, "bye")
+                self.assertIsInstance(exception, ConnectionClosedOK)
+                self.assertIsInstance(exception, ConnectionClosed)
+                self.assertEqual(exception.code, code)
+                self.assertEqual(exception.reason, "bye")
+
+    def test_connection_closed_error_represents_abnormal_closure(self):
+        for code in (1002, 1006, 1016, 3000, 4000):
+            with self.subTest(code=code):
+                exception = ConnectionClosedError(code, "oops")
+                self.assertIsInstance(exception, ConnectionClosedError)
+                self.assertIsInstance(exception, ConnectionClosed)
+                self.assertEqual(exception.code, code)
+                self.assertEqual(exception.reason, "oops")
+
+    def test_normal_closure_raises_connection_closed_ok(self):
+        async def handler(ws, path):
+            await ws.close(1000, "bye")
+
+        async def run():
+            async with websockets.serve(handler, "localhost", 0) as server:
+                port = server.sockets[0].getsockname()[1]
+                async with websockets.connect(f"ws://localhost:{port}") as ws:
+                    with self.assertRaises(ConnectionClosedOK) as context:
+                        await ws.recv()
+                    self.assertEqual(context.exception.code, 1000)
+
+        loop = asyncio.new_event_loop()
+        asyncio.set_event_loop(loop)
+        try:
+            loop.run_until_complete(run())
+        finally:
+            loop.close()
+
+    def test_abnormal_closure_raises_connection_closed_error(self):
+        async def handler(ws, path):
+            await ws.close(4000, "oops")
+
+        async def run():
+            async with websockets.serve(handler, "localhost", 0) as server:
+                port = server.sockets[0].getsockname()[1]
+                async with websockets.connect(f"ws://localhost:{port}") as ws:
+                    with self.assertRaises(ConnectionClosedError) as context:
+                        await ws.recv()
+                    self.assertEqual(context.exception.code, 4000)
+
+        loop = asyncio.new_event_loop()
+        asyncio.set_event_loop(loop)
+        try:
+            loop.run_until_complete(run())
+        finally:
+            loop.close()
