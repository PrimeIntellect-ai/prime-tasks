+// TestPublishSBOMCopyFailure verifies that apko-publish returns a non-nil error
+// when the generated SBOM files cannot be copied into sbomPath. Here sbomPath
+// points at an existing regular file, so moving the SBOMs into it must fail.
+func TestPublishSBOMCopyFailure(t *testing.T) {
+	ctx := context.Background()
+	tmp := t.TempDir()
+
+	r := registry.New()
+	s := httptest.NewServer(r)
+	defer s.Close()
+	u, err := url.Parse(s.URL)
+	require.NoError(t, err)
+
+	dst := fmt.Sprintf("%s/test/publish", u.Host)
+
+	config := filepath.Join("testdata", "tzdata.yaml")
+
+	// sbomPath is an existing regular file, not a directory, so the SBOM copy
+	// cannot succeed.
+	sbomPath := filepath.Join(tmp, "not-a-directory")
+	require.NoError(t, os.WriteFile(sbomPath, []byte("not a directory"), 0o600))
+
+	cmd := cli.New()
+	cmd.SetArgs([]string{"publish", "--quiet", "--arch=amd64,arm64", "--sbom-path", sbomPath, config, dst})
+	err = cmd.ExecuteContext(ctx)
+	require.Error(t, err)
