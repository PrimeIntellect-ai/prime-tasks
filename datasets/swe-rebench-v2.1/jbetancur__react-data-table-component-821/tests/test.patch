+	test('selecting a different row replaces the selection when selectableRowsSingle is enabled', () => {
+		const mock = dataMock();
+		const { container } = render(
+			<DataTable data={mock.data} columns={mock.columns} selectableRows selectableRowsSingle />,
+		);
+
+		const rows = Array.from(container.querySelectorAll('[role="row"]'));
+		const firstRow = rows.find(row => row.textContent?.includes('Apple'));
+		const secondRow = rows.find(row => row.textContent?.includes('Zuchinni'));
+		const firstRowSelection = firstRow?.querySelector('input') as HTMLInputElement;
+		const secondRowSelection = secondRow?.querySelector('input') as HTMLInputElement;
+
+		fireEvent.click(firstRowSelection);
+		fireEvent.click(secondRowSelection);
+
+		expect(firstRowSelection.checked).toBe(false);
+		expect(secondRowSelection.checked).toBe(true);
+	});
+
+	test('selecting a second row keeps the first selected when selectableRowsSingle is not enabled', () => {
+		const mock = dataMock();
+		const { container } = render(<DataTable data={mock.data} columns={mock.columns} selectableRows />);
+
+		const rows = Array.from(container.querySelectorAll('[role="row"]'));
+		const firstRow = rows.find(row => row.textContent?.includes('Apple'));
+		const secondRow = rows.find(row => row.textContent?.includes('Zuchinni'));
+		const firstRowSelection = firstRow?.querySelector('input') as HTMLInputElement;
+		const secondRowSelection = secondRow?.querySelector('input') as HTMLInputElement;
+
+		fireEvent.click(firstRowSelection);
+		fireEvent.click(secondRowSelection);
+
+		expect(firstRowSelection.checked).toBe(true);
+		expect(secondRowSelection.checked).toBe(true);
+	});
