+		It("allows the stable Redwood engine in the cluster API schema", func() {
+			crdBytes, err := os.ReadFile(filepath.Join("..", "..", "config", "crd", "bases", "apps.foundationdb.org_foundationdbclusters.yaml"))
+			Expect(err).NotTo(HaveOccurred())
+
+			var crd map[string]interface{}
+			Expect(yaml.Unmarshal(crdBytes, &crd)).To(Succeed())
+
+			// Collect every schema node that describes the storage_engine field.
+			var engineSchemas []map[string]interface{}
+			var findEngineSchemas func(interface{})
+			findEngineSchemas = func(value interface{}) {
+				switch node := value.(type) {
+				case map[string]interface{}:
+					if field, ok := node["storage_engine"].(map[string]interface{}); ok {
+						engineSchemas = append(engineSchemas, field)
+					}
+					for _, child := range node {
+						findEngineSchemas(child)
+					}
+				case []interface{}:
+					for _, child := range node {
+						findEngineSchemas(child)
+					}
+				}
+			}
+			findEngineSchemas(crd)
+
+			Expect(engineSchemas).NotTo(BeEmpty())
+			// Every constraint the schema places on the field must accept the stable engine name.
+			for _, field := range engineSchemas {
+				if allowedValues, ok := field["enum"].([]interface{}); ok {
+					Expect(allowedValues).To(ContainElement("ssd-redwood-1"))
+				}
+				if pattern, ok := field["pattern"].(string); ok {
+					// OpenAPI patterns are ECMA regexes; only evaluate those Go can compile.
+					if matched, err := regexp.MatchString(pattern, "ssd-redwood-1"); err == nil {
+						Expect(matched).To(BeTrue())
+					}
+				}
+			}
+		})
 	})
 
