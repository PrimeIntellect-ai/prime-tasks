+describe('cell editing', () => {
+  test('double-click editing of an editable node starts without a TypeError', () => {
+    const graph = createGraphWithoutContainer();
+    const parent = graph.getDefaultParent();
+    const vertex = graph.insertVertex(parent, 'v1', 'label', 0, 0, 100, 80, {
+      editable: true,
+    });
+    graph.getView().validate();
+
+    expect(graph.isCellEditable(vertex)).toBeTruthy();
+    expect(() => graph.startEditingAtCell(vertex)).not.toThrow();
+    expect(graph.isEditing(vertex)).toBeTruthy();
+  });
+});
