diff --git a/test/transport-stream.test.js b/test/transport-stream.test.js
new file mode 100644
index 0000000..305cd1b
--- /dev/null
+++ b/test/transport-stream.test.js
@@ -0,0 +1,69 @@
+'use strict'
+
+const { test } = require('tap')
+
+test('should import', async (t) => {
+  t.plan(2)
+  const mockRealRequire = (target) => {
+    return {
+      default: {
+        default: () => {
+          t.equal(target, 'pino-pretty')
+          return Promise.resolve()
+        }
+      }
+    }
+  }
+  const mockRealImport = async () => { await Promise.resolve(); throw Object.assign(new Error(), { code: 'ERR_MODULE_NOT_FOUND' }) }
+
+  /** @type {typeof import('../lib/transport-stream.js')} */
+  const loadTransportStreamBuilder = t.mock('../lib/transport-stream.js', { 'real-require': { realRequire: mockRealRequire, realImport: mockRealImport } })
+
+  const fn = await loadTransportStreamBuilder('pino-pretty')
+
+  t.resolves(fn())
+  t.end()
+})
+
+test('returns a callable builder for a usable transport', async (t) => {
+  t.plan(2)
+  const mockRealRequire = () => ({ default: { default: () => Promise.resolve() } })
+  const mockRealImport = async () => () => Promise.resolve()
+
+  /** @type {typeof import('../lib/transport-stream.js')} */
+  const loadTransportStreamBuilder = t.mock('../lib/transport-stream.js', { 'real-require': { realRequire: mockRealRequire, realImport: mockRealImport } })
+
+  const fn = await loadTransportStreamBuilder('pino-pretty')
+
+  t.equal(typeof fn, 'function')
+  t.resolves(fn())
+  t.end()
+})
+
+test('should throw if the target cannot be loaded', async (t) => {
+  t.plan(1)
+  const mockRealRequire = () => {
+    throw Object.assign(new Error('Cannot find module'), { code: 'MODULE_NOT_FOUND' })
+  }
+  const mockRealImport = async () => {
+    throw Object.assign(new Error('Cannot find module'), { code: 'ERR_MODULE_NOT_FOUND' })
+  }
+
+  /** @type {typeof import('../lib/transport-stream.js')} */
+  const loadTransportStreamBuilder = t.mock('../lib/transport-stream.js', { 'real-require': { realRequire: mockRealRequire, realImport: mockRealImport } })
+
+  await t.rejects(loadTransportStreamBuilder('does-not-exist'), Error)
+  t.end()
+})
+
+test('should throw if the target does not export a callable function', async (t) => {
+  t.plan(1)
+  const mockRealRequire = () => ({ default: { default: {} } })
+  const mockRealImport = async () => ({ default: {} })
+
+  /** @type {typeof import('../lib/transport-stream.js')} */
+  const loadTransportStreamBuilder = t.mock('../lib/transport-stream.js', { 'real-require': { realRequire: mockRealRequire, realImport: mockRealImport } })
+
+  await t.rejects(loadTransportStreamBuilder('pino-pretty'), Error)
+  t.end()
+})
