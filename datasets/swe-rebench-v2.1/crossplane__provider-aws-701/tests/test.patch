+func TestRawAccountIDMatchesReportedRootARN(t *testing.T) {
+	const accountID = "999999999999"
+	body := &v1alpha1.RepositoryPolicyBody{
+		Version: "2012-10-17",
+		Statements: []v1alpha1.RepositoryPolicyStatement{{
+			Effect: "Allow",
+			Action: []string{"ecr:ListImages"},
+			Principal: &v1alpha1.RepositoryPrincipal{
+				AWSPrincipals: []v1alpha1.AWSPrincipal{{AWSAccountID: aws.String(accountID)}},
+			},
+		}},
+	}
+	serialized, err := Serialize(body)
+	if err != nil {
+		t.Fatalf("serialize desired policy: %v", err)
+	}
+	localBytes, err := json.Marshal(serialized)
+	if err != nil {
+		t.Fatalf("marshal desired policy: %v", err)
+	}
+	local := string(localBytes)
+	remote := `{"Version":"2012-10-17","Statement":[{"Action":"ecr:ListImages","Effect":"Allow","Principal":{"AWS":"arn:aws:iam::999999999999:root"}}]}`
+	if !IsRepositoryPolicyUpToDate(&local, &remote) {
+		t.Fatal("policy using a raw AWS account ID should match the reported root ARN")
+	}
+}
