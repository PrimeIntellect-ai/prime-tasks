+// assertFieldTags renders the template for data, checks the rendered text up to the
+// struct field tag against expected, then checks the struct tag values (independently of
+// their order) against wantTags.
+func (tt *templateTest) assertFieldTags(data interface{}, expected string, wantTags map[string]string) {
+	tt.t.Helper()
+	buf := bytes.NewBuffer(nil)
+	require.NoError(tt.t, tt.template.Execute(buf, data))
+	out := strings.TrimLeft(buf.String(), "\n\t ")
+
+	const fieldPrefix = "SomeName string "
+	idx := strings.Index(out, fieldPrefix)
+	require.GreaterOrEqual(tt.t, idx, 0, "rendered field declaration not found")
+	require.Equal(tt.t, strings.TrimLeft(expected, "\n\t "), out[:idx+len(fieldPrefix)])
+
+	lit := strings.TrimSpace(out[idx+len(fieldPrefix):])
+	var raw string
+	if strings.HasPrefix(lit, "`") {
+		raw = strings.TrimSuffix(strings.TrimPrefix(lit, "`"), "`")
+	} else {
+		var err error
+		raw, err = strconv.Unquote(lit)
+		require.NoError(tt.t, err, "tag must be a valid Go string literal")
+	}
+
+	tag := reflect.StructTag(raw)
+	for key, want := range wantTags {
+		got, ok := tag.Lookup(key)
+		require.True(tt.t, ok, "tag %q not found in %s", key, raw)
+		require.Equal(tt.t, want, got, "tag %q", key)
+	}
+}
