@@ -0,0 +1,214 @@
+package generator
+
+import (
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestPrintTags(t *testing.T) {
+	type tagFixture struct {
+		Title        string
+		Schema       GenSchema
+		ExpectedTags string
+		// ExpectedContains lists tag fragments that must be present. It is used
+		// when the exact position of a fragment is not constrained by the contract.
+		ExpectedContains []string
+		QuotedContains   []string
+	}
+
+	mustJSON := func(in interface{}) string {
+		b, _ := asJSON(in)
+		return b
+	}
+
+	fixtures := []tagFixture{
+		{
+			Title: "no extra: default json",
+			Schema: GenSchema{
+				OriginalName: "field",
+			},
+			ExpectedTags: "`json:\"field\"`",
+		},
+		{
+			Title: "no extra: default json, omitempty",
+			Schema: GenSchema{
+				OriginalName: "field",
+				resolvedType: resolvedType{
+					IsEmptyOmitted: true,
+				},
+			},
+			ExpectedTags: "`json:\"field,omitempty\"`",
+		},
+		{
+			Title: "no extra: default json, required, omitempty",
+			Schema: GenSchema{
+				OriginalName: "field",
+				resolvedType: resolvedType{
+					IsEmptyOmitted: true,
+				},
+				sharedValidations: sharedValidations{
+					Required: true,
+				},
+			},
+			ExpectedTags: "`json:\"field\"`",
+		},
+		{
+			Title: "no extra: default json, omitempty, as JSON string",
+			Schema: GenSchema{
+				OriginalName: "field",
+				resolvedType: resolvedType{
+					IsEmptyOmitted: true,
+					IsJSONString:   true,
+				},
+			},
+			ExpectedTags: "`json:\"field,omitempty,string\"`",
+		},
+		{
+			Title: "with xml name",
+			Schema: GenSchema{
+				OriginalName: "field",
+				resolvedType: resolvedType{
+					IsEmptyOmitted: true,
+				},
+				sharedValidations: sharedValidations{
+					Required: true,
+				},
+				XMLName: "xmlfield",
+			},
+			ExpectedContains: []string{`json:"field"`, `xml:"xmlfield"`},
+		},
+		{
+			Title: "with example (1/3)",
+			Schema: GenSchema{
+				OriginalName: "field",
+				resolvedType: resolvedType{
+					IsEmptyOmitted: true,
+				},
+				sharedValidations: sharedValidations{
+					Required: true,
+				},
+				Example:    mustJSON("xyz"),
+				StructTags: []string{"example"},
+			},
+			ExpectedContains: []string{`json:"field"`, `example:"\"xyz\""`},
+		},
+		{
+			Title: "with example (2/3)",
+			Schema: GenSchema{
+				OriginalName: "field",
+				resolvedType: resolvedType{
+					IsEmptyOmitted: true,
+				},
+				sharedValidations: sharedValidations{
+					Required: true,
+				},
+				Example:    mustJSON(15),
+				StructTags: []string{"example"},
+			},
+			ExpectedContains: []string{`json:"field"`, `example:"15"`},
+		},
+		{
+			Title: "with example (3/3)",
+			Schema: GenSchema{
+				OriginalName: "field",
+				resolvedType: resolvedType{
+					IsEmptyOmitted: true,
+				},
+				sharedValidations: sharedValidations{
+					Required: true,
+				},
+				Example: mustJSON(struct {
+					A string `json:"a"`
+					B int64  `json:"b"`
+				}{A: "xyz", B: 12}),
+				StructTags: []string{"example"},
+			},
+			ExpectedContains: []string{`json:"field"`, `example:"{\"a\":\"xyz\",\"b\":12}"`},
+		},
+		{
+			Title: "with example, xml, omitempty, custom tag",
+			Schema: GenSchema{
+				OriginalName: "field",
+				resolvedType: resolvedType{
+					IsEmptyOmitted: true,
+				},
+				Example:    mustJSON(15),
+				StructTags: []string{"example"},
+				XMLName:    "xmlfield,attr",
+				CustomTag:  `metric:"on"`,
+			},
+			ExpectedContains: []string{
+				`json:"field,omitempty"`,
+				`xml:"xmlfield,attr,omitempty"`,
+				`example:"15"`,
+				`metric:"on"`,
+			},
+		},
+		{
+			Title: "requested struct tags are rendered alongside json and example",
+			Schema: GenSchema{
+				OriginalName: "field",
+				resolvedType: resolvedType{
+					IsEmptyOmitted: true,
+				},
+				Example:    mustJSON(15),
+				StructTags: []string{"example", "db"},
+			},
+			ExpectedContains: []string{`json:"field,omitempty"`, `example:"15"`, `db:"field,omitempty"`},
+		},
+		{
+			Title: "requested struct tags without example",
+			Schema: GenSchema{
+				OriginalName: "field",
+				StructTags:   []string{"db", "yaml"},
+			},
+			ExpectedContains: []string{`json:"field"`, `db:"field"`, `yaml:"field"`},
+		},
+		{
+			Title: "with backticks",
+			Schema: GenSchema{
+				OriginalName: "field",
+				Example: mustJSON(struct {
+					A string `json:"a"`
+					B int64  `json:"b"`
+				}{A: "`xyz`", B: 12}),
+				StructTags: []string{"example"},
+			},
+			QuotedContains: []string{`json:"field"`, "`xyz`"},
+		},
+		{
+			Title: "xml name containing backticks",
+			Schema: GenSchema{
+				OriginalName: "field",
+				XMLName:      "KeyValuePair`2",
+			},
+			QuotedContains: []string{`json:"field"`, "xml:\"KeyValuePair`2\""},
+		},
+	}
+
+	for _, toPin := range fixtures {
+		fixture := toPin
+		t.Run(fixture.Title, func(t *testing.T) {
+			tags := fixture.Schema.PrintTags()
+			contents, err := strconv.Unquote(tags)
+			require.NoError(t, err, "PrintTags must return a valid Go string literal")
+			if fixture.ExpectedTags != "" {
+				expected, err := strconv.Unquote(fixture.ExpectedTags)
+				require.NoError(t, err)
+				require.Equal(t, expected, contents)
+			}
+			for _, fragment := range fixture.ExpectedContains {
+				require.Contains(t, contents, fragment)
+			}
+			if len(fixture.QuotedContains) > 0 {
+				require.True(t, strings.HasPrefix(tags, `"`) && strings.HasSuffix(tags, `"`), "tag with a backtick value must be a double-quoted Go string literal")
+				for _, fragment := range fixture.QuotedContains {
+					require.Contains(t, contents, fragment)
+				}
+			}
+		})
+	}
+}
