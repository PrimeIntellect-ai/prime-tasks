@@ -0,0 +1,80 @@
+// Copyright (C) 2022 Michael J. Fromberger. All Rights Reserved.
+
+package testutil_test
+
+import (
+	"testing"
+
+	"github.com/creachadair/jrpc2/internal/testutil"
+)
+
+func TestParseRequests(t *testing.T) {
+	t.Run("Invalid", func(t *testing.T) {
+		req, err := testutil.ParseRequest(`{this is invalid}`)
+		if err == nil {
+			t.Errorf("ParseRequest: got %+v, wanted error", req)
+		} else {
+			t.Logf("Invalid OK: %v", err)
+		}
+	})
+	t.Run("Call", func(t *testing.T) {
+		req := testutil.MustParseRequest(t, `{"jsonrpc":"2.0","id":1,"method":"OK"}`)
+		t.Logf("Call OK: %+v", req)
+	})
+	t.Run("Notification", func(t *testing.T) {
+		req := testutil.MustParseRequest(t, `{"jsonrpc":"2.0","id":null,"method":"OK"}`)
+		t.Logf("Note OK: %+v", req)
+	})
+
+	// A structurally malformed request ID must be reported as an error, not
+	// silently accepted as a notification.
+	t.Run("MalformedID", func(t *testing.T) {
+		req, err := testutil.ParseRequest(`{"jsonrpc":"2.0","id":[],"method":"OK"}`)
+		if err == nil {
+			t.Errorf("ParseRequest: got %+v, wanted error", req)
+		} else {
+			t.Logf("MalformedID OK: %v", err)
+		}
+	})
+
+	// A request with a missing version marker must be reported as an error.
+	t.Run("MissingVersion", func(t *testing.T) {
+		req, err := testutil.ParseRequest(`{"id":1,"method":"OK"}`)
+		if err == nil {
+			t.Errorf("ParseRequest: got %+v, wanted error", req)
+		} else {
+			t.Logf("MissingVersion OK: %v", err)
+		}
+	})
+
+	// A batch is not a single request and must be reported as an error.
+	t.Run("Batch", func(t *testing.T) {
+		req, err := testutil.ParseRequest(`[{"jsonrpc":"2.0","id":1,"method":"OK"}]`)
+		if err == nil {
+			t.Errorf("ParseRequest: got %+v, wanted error", req)
+		} else {
+			t.Logf("Batch OK: %v", err)
+		}
+	})
+
+	// MustParseRequest must report a test failure when parsing fails.
+	t.Run("MustParseRequestFails", func(t *testing.T) {
+		fake := new(fakeTB)
+		if req := testutil.MustParseRequest(fake, `{this is invalid}`); req != nil {
+			t.Errorf("MustParseRequest: got %+v, want nil", req)
+		}
+		if !fake.failed {
+			t.Error("MustParseRequest did not report a failure for invalid input")
+		}
+	})
+}
+
+// fakeTB is a minimal testing.TB that records whether Fatalf was called.
+type fakeTB struct {
+	testing.TB
+	failed bool
+}
+
+func (f *fakeTB) Helper() {}
+
+func (f *fakeTB) Fatalf(string, ...interface{}) { f.failed = true }
