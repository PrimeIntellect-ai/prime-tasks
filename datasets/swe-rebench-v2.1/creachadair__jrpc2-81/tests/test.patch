index 0000000..c7c957b
--- /dev/null
+++ b/internal/testutil/testutil.go
@@ -0,0 +1,103 @@
+// Copyright (C) 2022 Michael J. Fromberger. All Rights Reserved.
+
+// Package testutil defines internal support code for writing tests.
+package testutil
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/creachadair/jrpc2"
+	"github.com/creachadair/jrpc2/channel"
+)
+
+// ParseRequest parses a single JSON request object.
+func ParseRequest(s string) (_ *jrpc2.Request, err error) {
+	// A single request must be a JSON object, not a batch array or any other
+	// JSON value.
+	if t := strings.TrimSpace(s); len(t) == 0 || t[0] != '{' {
+		return nil, fmt.Errorf("not a single request: %q", s)
+	}
+
+	cch, sch := channel.Direct()
+	rs := newRequestStub()
+	srv := jrpc2.NewServer(rs, nil).Start(sch)
+
+	// The server invokes the handler only for valid requests. If the request is
+	// invalid, it sends an error response instead. Read the response
+	// concurrently so we can detect that case.
+	rspc := make(chan []byte, 1)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		if raw, rerr := cch.Recv(); rerr == nil {
+			rspc <- raw
+		}
+	}()
+	defer func() {
+		cch.Close()
+		<-done
+		serr := srv.Wait()
+		if err == nil {
+			err = serr
+		}
+	}()
+
+	if serr := cch.Send([]byte(s)); serr != nil {
+		return nil, serr
+	}
+
+	select {
+	case req := <-rs.reqc:
+		if !req.IsNotification() {
+			<-rspc // consume the response
+		}
+		return req, nil
+	case raw := <-rspc:
+		// The server replied without invoking the handler, so the request was
+		// invalid. Report the error it sent.
+		var rsp struct {
+			Error *jrpc2.Error `json:"error"`
+		}
+		if jerr := json.Unmarshal(raw, &rsp); jerr != nil {
+			return nil, jerr
+		}
+		if rsp.Error != nil {
+			return nil, rsp.Error
+		}
+		// The response was a success, so the handler was invoked; wait for it.
+		return <-rs.reqc, nil
+	}
+}
+
+// MustParseRequest calls ParseRequest and fails t if it reports an error.
+func MustParseRequest(t testing.TB, s string) *jrpc2.Request {
+	t.Helper()
+
+	req, err := ParseRequest(s)
+	if err != nil {
+		t.Fatalf("Parsing %#q failed: %v", s, err)
+	}
+	return req
+}
+
+func newRequestStub() *requestStub {
+	return &requestStub{reqc: make(chan *jrpc2.Request, 1)}
+}
+
+type requestStub struct {
+	reqc   chan *jrpc2.Request
+	isNote bool
+}
+
+func (r *requestStub) Assign(context.Context, string) jrpc2.Handler { return r }
+
+func (r *requestStub) Handle(_ context.Context, req *jrpc2.Request) (interface{}, error) {
+	defer close(r.reqc)
+	r.isNote = req.IsNotification()
+	r.reqc <- req
+	return nil, nil
+}
