+    def testMerge(self):
+        self.install.reassign_word('install', 'subcommand')
+        self.install.set_install()
+        self.install2.reassign_word('install', 'subcommand')
+        self.install2.set_install()
+        self.remove.reassign_word('purge', 'subcommand')
+        self.remove.set_remove()
+        # merge the second install into the first install
+        self.assertTrue(self.install.merge(self.install2))
+        self.assertCountEqual(self.install.words, ['git', 'ca-certificates'])
+        # merge the remove command
+        self.assertTrue(self.install.merge(self.remove))
+        # try to merge the download command
+        self.assertFalse(self.install.merge(self.download))
+        # try to merge an ignored command
+        self.download.set_ignore()
+        self.assertFalse(self.install.merge(self.download))
+        # try to merge some other object
+        with self.assertRaises(TypeError):
+            self.install.merge('test')
+
+    def testSplitSemicolonCommands(self):
+        # shell commands separated by ';' should be treated as separate
+        # commands so that the package manager command is recognized
+        line = ('set -eux; apk add --no-cache --virtual .build-deps '
+                'bash gcc musl-dev openssl go; '
+                'export GOROOT_BOOTSTRAP="$(go env GOROOT)"')
+        commands, report = filter_install_commands(line)
+        apk_commands = [c for c in commands if c.name == 'apk']
+        self.assertEqual(len(apk_commands), 1)
+        for package in ['bash', 'gcc', 'musl-dev', 'openssl', 'go']:
+            self.assertIn(package, apk_commands[0].words)
+
+    def testRecognizedRemoveCommand(self):
+        commands, report = filter_install_commands('apk del .build-deps')
+        apk_commands = [command for command in commands if command.name == 'apk']
+        self.assertEqual(len(apk_commands), 1)
+        self.assertTrue(apk_commands[0].is_remove())
+        self.assertIn('.build-deps', apk_commands[0].words)
+
 
 if __name__ == '__main__':
     unittest.main()
