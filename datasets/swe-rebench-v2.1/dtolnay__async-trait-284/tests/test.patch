+pub mod issue283 {
+    use async_trait::async_trait;
+
+    #[async_trait]
+    pub trait Trait {
+        async fn a();
+    }
+
+    pub trait Bound {
+        fn b();
+    }
+
+    impl Bound for () {
+        fn b() {}
+    }
+
+    #[async_trait]
+    impl<T: Bound> Trait for T {
+        async fn a() {
+            Self::b();
+        }
+    }
+
+    #[test]
+    fn calls_plain_bound_method_through_self() {
+        futures::executor::block_on(<() as Trait>::a());
+    }
+}
+
+pub mod issue283_async_bound {
+    use async_trait::async_trait;
+
+    #[async_trait]
+    pub trait Trait {
+        async fn a();
+    }
+
+    #[async_trait]
+    pub trait Bound {
+        async fn b();
+    }
+
+    #[async_trait]
+    impl<T: Bound> Trait for T {
+        async fn a() {
+            Self::b().await;
+        }
+    }
+
+    #[async_trait]
+    impl Bound for () {
+        async fn b() {}
+    }
+
+    #[test]
+    fn calls_async_annotated_bound_method_through_self() {
+        futures::executor::block_on(<() as Trait>::a());
+    }
+}
