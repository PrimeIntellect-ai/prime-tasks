+func TestScrapeTargetSendsSNMPOverTCP(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("Could not start local TCP listener: %v", err)
+	}
+	defer listener.Close()
+
+	type receivedRequest struct {
+		data []byte
+		err  error
+	}
+	requestCh := make(chan receivedRequest, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			requestCh <- receivedRequest{err: err}
+			return
+		}
+		defer conn.Close()
+		_ = conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+		buf := make([]byte, 2048)
+		n, err := conn.Read(buf)
+		requestCh <- receivedRequest{data: buf[:n], err: err}
+	}()
+
+	retries := 0
+	module := &config.Module{
+		Get: []string{"1.3.6.1.2.1.1.1.0"},
+		WalkParams: config.WalkParams{
+			Retries: &retries,
+			Timeout: time.Second,
+		},
+	}
+	target := "tcp://" + listener.Addr().String()
+	_, _ = ScrapeTarget(context.Background(), target, &config.DefaultAuth, module, log.NewNopLogger(), newInternalMetrics(prometheus.NewRegistry()))
+
+	select {
+	case request := <-requestCh:
+		if request.err != nil {
+			t.Fatalf("Reading SNMP request from TCP connection: %v", request.err)
+		}
+		if len(request.data) < 2 || request.data[0] != 0x30 {
+			t.Fatalf("TCP connection did not carry an SNMP BER sequence: %x", request.data)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("Scrape did not send an SNMP request over TCP")
+	}
+}
