+func TestParseMultiStringSliceFromEnvWithDestination(t *testing.T) {
+	os.Clearenv()
+	_ = os.Setenv("APP_INTERVALS", "20,30,40")
+
+	dest := &StringSlice{}
+	_ = (&App{
+		Flags: []Flag{
+			stringSliceFlagWithDestination(t, &StringSliceFlag{Name: "intervals", Aliases: []string{"i"}, EnvVars: []string{"APP_INTERVALS"}}, dest),
+		},
+		Action: func(ctx *Context) error {
+			if !reflect.DeepEqual(dest.Value(), []string{"20", "30", "40"}) {
+				t.Errorf("main name not set from env")
+			}
+			if !reflect.DeepEqual(dest.Value(), []string{"20", "30", "40"}) {
+				t.Errorf("short name not set from env")
+			}
+			return nil
+		},
+	}).Run([]string{"run"})
+}
+
+func TestParseMultiStringSliceWithDestinationAndFilePath(t *testing.T) {
+	os.Clearenv()
+
+	temp, err := ioutil.TempFile("", "test-file-path")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, _ = io.WriteString(temp, "20,30,40")
+	_ = temp.Close()
+	defer func() {
+		_ = os.Remove(temp.Name())
+	}()
+
+	dest := &StringSlice{}
+	_ = (&App{
+		Flags: []Flag{
+			stringSliceFlagWithDestination(t, &StringSliceFlag{Name: "intervals", Aliases: []string{"i"}, FilePath: temp.Name()}, dest),
+		},
+		Action: func(ctx *Context) error {
+			if !reflect.DeepEqual(dest.Value(), []string{"20", "30", "40"}) {
+				t.Errorf("main name not set from file: %v", dest.Value())
+			}
+			return nil
+		},
+	}).Run([]string{"run"})
+}
