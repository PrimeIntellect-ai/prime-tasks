+func stringSliceFlagWithDestination(t *testing.T, flag *StringSliceFlag, destination *StringSlice) *StringSliceFlag {
+	t.Helper()
+	field := reflect.ValueOf(flag).Elem().FieldByName("Destination")
+	if !field.IsValid() || !field.CanSet() {
+		t.Fatal("StringSliceFlag must expose a settable Destination field")
+	}
+	field.Set(reflect.ValueOf(destination))
+	return flag
+}
+
+func TestStringSliceDestinationReceivesCommandLineValues(t *testing.T) {
+	dest := &StringSlice{}
+	_ = (&App{
+		Flags: []Flag{
+			stringSliceFlagWithDestination(t, &StringSliceFlag{Name: "serve", Aliases: []string{"s"}}, dest),
+		},
+		Action: func(ctx *Context) error {
+			expected := []string{"10", "20"}
+			if !reflect.DeepEqual(dest.Value(), expected) {
+				t.Errorf("main name not set: %v != %v", expected, ctx.StringSlice("serve"))
+			}
+			if !reflect.DeepEqual(dest.Value(), expected) {
+				t.Errorf("short name not set: %v != %v", expected, ctx.StringSlice("s"))
+			}
+			return nil
+		},
+	}).Run([]string{"run", "-s", "10", "-s", "20"})
+}
+
+func TestParseMultiStringSliceWithDestinationAndEnv(t *testing.T) {
+	os.Clearenv()
+	_ = os.Setenv("APP_INTERVALS", "20,30,40")
+
+	dest := &StringSlice{}
+	_ = (&App{
+		Flags: []Flag{
+			stringSliceFlagWithDestination(t, &StringSliceFlag{Name: "serve", Aliases: []string{"s"}, EnvVars: []string{"APP_INTERVALS"}}, dest),
+		},
+		Action: func(ctx *Context) error {
+			expected := []string{"10", "20"}
+			if !reflect.DeepEqual(dest.Value(), expected) {
+				t.Errorf("main name not set: %v != %v", expected, ctx.StringSlice("serve"))
+			}
+			if !reflect.DeepEqual(dest.Value(), expected) {
+				t.Errorf("short name not set: %v != %v", expected, ctx.StringSlice("s"))
+			}
+			return nil
+		},
+	}).Run([]string{"run", "-s", "10", "-s", "20"})
+}
