 import pytest
 
-from earthkit.data import from_source
+import earthkit.data.sources.cds as cds_module
+from earthkit.data import from_source, settings
 from earthkit.data.testing import NO_CDS
 
 
+def test_cds_request_accepts_date_list(monkeypatch, tmp_path):
+    submitted_requests = []
+
+    class OfflineClient:
+        def retrieve(self, dataset, request, target):
+            submitted_requests.append(request)
+            with open(target, "wb"):
+                pass
+
+    monkeypatch.setattr(cds_module, "client", lambda: OfflineClient())
+
+    with settings.temporary(
+        {"cache-policy": "user", "user-cache-directory": str(tmp_path)}
+    ):
+        from_source(
+            "cds",
+            "reanalysis-era5-single-levels",
+            variable=["2t"],
+            product_type="reanalysis",
+            area=[50, -50, 20, 50],
+            date=["2007-01-01", "2008-02-04"],
+            time="12:00",
+        )
+
+    assert submitted_requests[0]["date"] == ["2007-01-01", "2008-02-04"]
+
+
