+// TestPointMethodsUnexported checks that no method defined on a point is exported.
+func TestPointMethodsUnexported(t *testing.T) {
+	typ := reflect.TypeOf(&point{})
+	if n := typ.NumMethod(); n != 0 {
+		names := make([]string, 0, n)
+		for i := 0; i < n; i++ {
+			names = append(names, typ.Method(i).Name)
+		}
+		t.Errorf("point has exported methods %v, want none", names)
+	}
