+def test_program_with_backslash_in_string_concatenation():
+    """Check that a program containing a character declaration whose
+    initialisation concatenates a string containing a backslash with
+    another string parses successfully and retains the backslash.
+
+    """
+    code = (
+        "program simple\n"
+        "    character(len=10) :: foo = '\\' // 'b'\n"
+        "end program simple\n"
+    )
+    obj = Program(get_reader(code))
+    assert isinstance(obj, Program)
+    # The backslash must be preserved as part of the character literal.
+    assert "\\" in str(obj)
