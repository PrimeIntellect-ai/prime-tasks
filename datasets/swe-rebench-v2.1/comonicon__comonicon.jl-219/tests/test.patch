     include("julia/plugin.jl")
 end
 
+module Issue218
+
+using Comonicon
+
+const PRINTED = Ref{Any}(nothing)
+const COMMAND_VERSION = v"0.1.0"
+
+@cast function print(file)
+    PRINTED[] = file
+end
+
+@main
+
+end
+
+function capture_issue218_cli(args)
+    mktemp() do _, stream
+        result = try
+            redirect_stdout(stream) do
+                Issue218.command_main(args)
+            end
+            nothing
+        catch err
+            err
+        end
+        flush(stream)
+        seekstart(stream)
+        return result, read(stream, String)
+    end
+end
+
+@testset "issue#218: casted print and global flags" begin
+    # Global flags must not be sent to the user-defined `print` command.
+    Issue218.PRINTED[] = nothing
+    help_error, help_output = capture_issue218_cli(["-h"])
+    @test occursin("Usage", help_output)
+    @test help_error === nothing
+    @test Issue218.PRINTED[] === nothing
+
+    Issue218.PRINTED[] = nothing
+    version_error, version_output = capture_issue218_cli(["--version"])
+    @test occursin("0.1.0", version_output)
+    @test version_error === nothing
+    @test Issue218.PRINTED[] === nothing
+
+    # The similarly named subcommand remains available to users.
+    Issue218.PRINTED[] = nothing
+    Issue218.command_main(["print", "foo.txt"])
+    @test Issue218.PRINTED[] == "foo.txt"
+end
+
 @testset "ZSHCompletions.emit" begin
     include("zsh/zsh.jl")
 end
