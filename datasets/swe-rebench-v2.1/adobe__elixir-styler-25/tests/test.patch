+
+  defp from_call_with_in?({callee, _meta, args}) when is_list(args) do
+    (from_call?(callee) and contains_in?(args)) or
+      Enum.any?([callee | args], &from_call_with_in?/1)
+  end
+
+  defp from_call_with_in?(tuple) when is_tuple(tuple),
+    do: tuple |> Tuple.to_list() |> Enum.any?(&from_call_with_in?/1)
+
+  defp from_call_with_in?(list) when is_list(list),
+    do: Enum.any?(list, &from_call_with_in?/1)
+
+  defp from_call_with_in?(_), do: false
+
+  defp from_call?({:., _meta, [_module, :from]}), do: true
+  defp from_call?(:from), do: true
+  defp from_call?(_), do: false
+
+  defp contains_in?({:in, _meta, [_left, _right]}), do: true
+  defp contains_in?({{:., _meta, [_module, :in]}, _call_meta, [_left, _right]}), do: true
+
+  defp contains_in?(tuple) when is_tuple(tuple),
+    do: tuple |> Tuple.to_list() |> Enum.any?(&contains_in?/1)
+
+  defp contains_in?(list) when is_list(list),
+    do: Enum.any?(list, &contains_in?/1)
+
+  defp contains_in?(_), do: false
 end
