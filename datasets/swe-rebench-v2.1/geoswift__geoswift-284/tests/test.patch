+/// Verifies the package manifest's declared minimum platform versions and
+/// Swift tools version, which are the public requirements of this change.
+final class PackageManifestTests: XCTestCase {
+
+    private func dumpPackage() throws -> [String: Any] {
+        let packageRoot = URL(fileURLWithPath: #filePath)
+            .deletingLastPathComponent()
+            .deletingLastPathComponent()
+            .deletingLastPathComponent()
+            .deletingLastPathComponent()
+
+        let process = Process()
+        process.executableURL = URL(fileURLWithPath: "/usr/bin/env")
+        process.arguments = ["swift", "package", "dump-package"]
+        process.currentDirectoryURL = packageRoot
+        let stdout = Pipe()
+        process.standardOutput = stdout
+        try process.run()
+        process.waitUntilExit()
+        let data = stdout.fileHandleForReading.readDataToEndOfFile()
+        let json = try JSONSerialization.jsonObject(with: data)
+        return try XCTUnwrap(json as? [String: Any], "Unable to parse package manifest")
+    }
+
+    private func majorMinor(_ version: String?) -> (major: Int, minor: Int)? {
+        guard let version = version else { return nil }
+        let parts = version.split(separator: ".")
+        guard parts.count >= 2,
+              let major = Int(parts[0]),
+              let minor = Int(parts[1]) else { return nil }
+        return (major, minor)
+    }
+
+    func testMinimumPlatformVersions() throws {
+        let manifest = try dumpPackage()
+        let platforms = try XCTUnwrap(manifest["platforms"] as? [[String: Any]])
+        var versions: [String: String] = [:]
+        for platform in platforms {
+            if let name = platform["platformName"] as? String,
+               let version = platform["version"] as? String {
+                versions[name] = version
+            }
+        }
+        XCTAssertEqual(versions["ios"], "12.0")
+        XCTAssertEqual(versions["tvos"], "12.0")
+        XCTAssertEqual(versions["macos"], "10.13")
+        XCTAssertEqual(versions["watchos"], "4.0")
+    }
+
+    func testSwiftToolsVersion() throws {
+        let manifest = try dumpPackage()
+        let toolsVersion = try XCTUnwrap(manifest["toolsVersion"] as? [String: Any])
+        let version = try XCTUnwrap(toolsVersion["_version"] as? String)
+        XCTAssertEqual(majorMinor(version)?.major, 5)
+        XCTAssertEqual(majorMinor(version)?.minor, 9)
     }
 }
