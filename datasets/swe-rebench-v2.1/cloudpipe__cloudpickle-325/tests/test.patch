+    def test_dynamic_module_with_unpicklable_builtin(self):
+        # Reproducer of https://github.com/cloudpipe/cloudpickle/issues/316:
+        # scipy can expose PyCapsule values through a module's builtins.
+        capsule_new = getattr(ctypes.pythonapi, 'PyCapsule_New', None)
+        if capsule_new is None:
+            self.skipTest('PyCapsule construction is unavailable')
+        capsule_new.restype = ctypes.py_object
+        capsule_new.argtypes = [ctypes.c_void_p, ctypes.c_char_p,
+                                ctypes.c_void_p]
+
+        mod = types.ModuleType("mod")
+
+        exec('f = lambda x: abs(x)', mod.__dict__)
+        assert mod.f(-1) == 1
+
+        payload = ctypes.create_string_buffer(1)
+        capsule = capsule_new(ctypes.cast(payload, ctypes.c_void_p), None, None)
+        builtins_dict = mod.__dict__['__builtins__']
+        if not isinstance(builtins_dict, dict):
+            builtins_dict = builtins_dict.__dict__
+        mod.__dict__['__builtins__'] = builtins_dict.copy()
+        mod.__dict__['__builtins__']['capsule'] = capsule
+
+        depickled_mod = pickle_depickle(mod, protocol=self.protocol)
+        # The restored module need not expose builtins through a particular
+        # namespace entry; what matters is that its function still works.
+        assert depickled_mod.f(-1) == 1
+
