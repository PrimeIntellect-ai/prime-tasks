+#[test]
+fn parse_numbers_with_underscore() {
+    // ClickHouse accepts underscores as separators inside numeric literals,
+    // e.g. `SELECT 10_000_000` denotes the number 10000000.
+    let stmts = clickhouse()
+        .parse_sql_statements("SELECT 10_000_000")
+        .unwrap();
+    assert_eq!(stmts.len(), 1);
+    let Statement::Query(query) = &stmts[0] else {
+        panic!("expected a query, got {:?}", stmts[0]);
+    };
+    let SetExpr::Select(select) = &*query.body else {
+        panic!("expected a select, got {:?}", query.body);
+    };
+    assert_eq!(select.projection.len(), 1);
+    let SelectItem::UnnamedExpr(Expr::Value(Value::Number(n, _))) = &select.projection[0] else {
+        panic!(
+            "expected a single numeric projection, got {:?}",
+            select.projection[0]
+        );
+    };
+    // The literal denotes the number 10000000, whether or not the separator
+    // is preserved in the stored value.
+    let digits: String = n.to_string().chars().filter(|c| *c != '_').collect();
+    assert_eq!(digits, "10000000");
+}
+
 fn clickhouse() -> TestedDialects {
     TestedDialects::new(vec![Box::new(ClickHouseDialect {})])
 }
