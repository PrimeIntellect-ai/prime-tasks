+@pytest.mark.asyncio
+async def test_schedule_refresh_replaces_expired_result_with_failed_refresh(
+    instance: Instance, test_rate_limiter: AsyncRateLimiter
+) -> None:
+    """
+    Test to check that a failed refresh replaces a current result whose
+    certificate has already expired, so connections never reuse expired metadata.
+    """
+    # allow more frequent refreshes for tests
+    setattr(instance, "_refresh_rate_limiter", test_rate_limiter)
+
+    # wait for the initial refresh so it cannot overwrite the value set below
+    await instance._current
+
+    # set current to metadata that expired 10 minutes ago
+    expired_task = asyncio.create_task(mocks.instance_metadata_expired())
+    await expired_task
+    instance._current = expired_task
+
+    # stub _perform_refresh to throw an error
+    setattr(instance, "_perform_refresh", mocks.instance_metadata_error)
+
+    # schedule refresh immediately and wait for it to fail
+    refresh_task = instance._schedule_refresh(0)
+    with pytest.raises(mocks.BadRefresh):
+        assert await refresh_task
+
+    # check that the expired result was replaced by the failed refresh
+    assert instance._current is not expired_task
+    with pytest.raises(mocks.BadRefresh):
+        assert await instance._current
+    await instance.close()
+
+
