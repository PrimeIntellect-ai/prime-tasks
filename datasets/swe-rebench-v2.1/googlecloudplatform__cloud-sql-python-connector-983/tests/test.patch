+@pytest.mark.asyncio
+async def test_connect_info_reads_certificate_expiry_without_deprecation_warning(
+    mock_instance: mocks.FakeCSQLInstance,
+    fake_credentials: Credentials,
+) -> None:
+    loop = asyncio.get_running_loop()
+    keys = asyncio.create_task(generate_keys())
+    _, client_key = await keys
+
+    with aioresponses() as mocked:
+        mocked.get(
+            f"https://sqladmin.googleapis.com/sql/v1beta4/projects/{mock_instance.project}/instances/{mock_instance.name}/connectSettings",
+            status=200,
+            body=mock_instance.connect_settings(),
+            repeat=True,
+        )
+        mocked.post(
+            f"https://sqladmin.googleapis.com/sql/v1beta4/projects/{mock_instance.project}/instances/{mock_instance.name}:generateEphemeralCert",
+            status=200,
+            body=mock_instance.generate_ephemeral(client_key),
+            repeat=True,
+        )
+        refreshed_instance = Instance(
+            f"{mock_instance.project}:{mock_instance.region}:{mock_instance.name}",
+            "pg8000",
+            keys,
+            loop,
+            fake_credentials,
+        )
+        try:
+            with warnings.catch_warnings(record=True) as caught:
+                warnings.simplefilter("always", CryptographyDeprecationWarning)
+                metadata, _ = await refreshed_instance.connect_info(IPTypes.PUBLIC)
+            assert metadata.expiration.utcoffset() == datetime.timedelta(0)
+            assert not any(
+                issubclass(warning.category, CryptographyDeprecationWarning)
+                for warning in caught
+            )
+        finally:
+            await refreshed_instance.close()
+
+
