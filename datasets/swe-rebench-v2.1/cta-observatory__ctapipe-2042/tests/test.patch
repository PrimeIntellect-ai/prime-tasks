+def test_transforms_follow_named_fields_with_interleaved_string(tmp_path):
+    path = tmp_path / "field_transforms.h5"
+
+    class MixedFields(Container):
+        distance = Field(12 * u.m, "distance")
+        label = Field("camera", "label", type=str, max_length=16)
+        duration = Field(3 * u.s, "duration")
+
+    original = MixedFields()
+    with HDF5TableWriter(path, mode="w") as writer:
+        writer.write("mixed", original)
+
+    with HDF5TableReader(path) as reader:
+        result = next(reader.read("/mixed", MixedFields))
+
+    assert result.distance == 12 * u.m
+    assert result.label == "camera"
+    assert result.duration == 3 * u.s
+
