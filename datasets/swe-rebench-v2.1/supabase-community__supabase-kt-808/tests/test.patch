+    @Test
+    fun testSendingExpiredToken() {
+        val channelId = "channelId"
+        val expiredToken = generateToken(Clock.System.now().epochSeconds - 10)
+        runTest {
+            createTestClient(
+                wsHandler = { i, o ->
+                    // Nothing should reach the channel after the expired token was set, so wait for a while and record everything
+                    val sentTokens = i.receiveSentTokens(o, "realtime:$channelId", untilToken = null, timeout = 2.seconds)
+                    assertFalse(expiredToken in sentTokens, "The expired token was sent to the channel: $sentTokens")
+                },
+                supabaseHandler = {
+                    val channel = it.channel(channelId)
+                    channel.subscribe(blockUntilSubscribed = true)
+                    it.realtime.setAuth(expiredToken)
+                }
+            )
+        }
+    }
+
+    @Test
+    fun testSendingValidToken() {
+        val channelId = "channelId"
+        val validToken = generateToken(Clock.System.now().epochSeconds + 3600)
+        runTest {
+            createTestClient(
+                wsHandler = { i, o ->
+                    val sentTokens = i.receiveSentTokens(o, "realtime:$channelId", untilToken = validToken, timeout = 5.seconds)
+                    assertTrue(validToken in sentTokens, "The valid token was never sent to the channel: $sentTokens")
+                },
+                supabaseHandler = {
+                    val channel = it.channel(channelId)
+                    channel.subscribe(blockUntilSubscribed = true)
+                    it.realtime.setAuth(validToken)
+                }
+            )
+        }
+    }
+
+    /**
+     * Acts as the Realtime server: answers the channel join so the channel becomes subscribed, then records
+     * every access token pushed to the channel. Returns as soon as [untilToken] was received, or after [timeout].
+     */
+    private suspend fun ReceiveChannel<RealtimeMessage>.receiveSentTokens(
+        outgoing: SendChannel<RealtimeMessage>,
+        topic: String,
+        untilToken: String?,
+        timeout: Duration
+    ): List<String?> {
+        val sentTokens = mutableListOf<String?>()
+        withContext(Dispatchers.Default) {
+            withTimeoutOrNull(timeout) {
+                while (true) {
+                    val message = receive()
+                    when (message.event) {
+                        RealtimeChannel.CHANNEL_EVENT_JOIN -> outgoing.send(
+                            RealtimeMessage(topic, RealtimeChannel.CHANNEL_EVENT_SYSTEM, buildJsonObject { put("status", "ok") }, "")
+                        )
+                        RealtimeChannel.CHANNEL_EVENT_ACCESS_TOKEN -> {
+                            val token = message.payload["access_token"]?.jsonPrimitive?.contentOrNull
+                            sentTokens += token
+                            if (untilToken != null && token == untilToken) break
+                        }
+                    }
+                }
+            }
+        }
+        return sentTokens
+    }
+
+    private fun generateToken(exp: Long) = buildString {
+        append("test.")
+        append(buildJsonObject {
+            put("exp", exp)
+        }.toString().encodeBase64())
+        append(".test")
+    }
+
