+
+    it("preserves notices from a single converted output", () => {
+        const tslintRule: TSLintRuleOptions = {
+            ruleArguments: [],
+            ruleName: "tslint-rule-a",
+            ruleSeverity: "error",
+        };
+        const conversionResult = {
+            rules: [{ notices: ["single output notice"], ruleName: "eslint-rule-a" }],
+        };
+        const converters = new Map([[tslintRule.ruleName, () => conversionResult]]);
+        const mergers = new Map();
+
+        const { converted } = convertRules(
+            { converters, mergers },
+            { [tslintRule.ruleName]: tslintRule },
+        );
+
+        expect(converted.get("eslint-rule-a")!.notices).toEqual(["single output notice"]);
+    });
+
+    it("merges notices when two outputs exist for a converted rule with a merger", () => {
+        // Arrange
+        const tslintRule: TSLintRuleOptions = {
+            ruleArguments: [],
+            ruleName: "tslint-rule-a",
+            ruleSeverity: "error",
+        };
+        const conversionResult = {
+            rules: [
+                {
+                    notices: ["first notice"],
+                    ruleName: "eslint-rule-a",
+                },
+                {
+                    notices: ["second notice"],
+                    ruleName: "eslint-rule-a",
+                },
+            ],
+        };
+        const converters = new Map([[tslintRule.ruleName, () => conversionResult]]);
+        const mergers = new Map([[conversionResult.rules[0].ruleName, () => []]]);
+
+        // Act
+        const { converted } = convertRules(
+            { converters, mergers },
+            { [tslintRule.ruleName]: tslintRule },
+        );
+
+        // Assert
+        expect(new Set(converted.get("eslint-rule-a")!.notices)).toEqual(
+            new Set(["first notice", "second notice"]),
         );
     });
 
