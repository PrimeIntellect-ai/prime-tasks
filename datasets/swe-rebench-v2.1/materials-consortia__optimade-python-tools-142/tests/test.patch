+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+
+class TestSetup(unittest.TestCase):
+    """Test ./setup.py"""
+
+    def test_distributions_package(self):
+        """Make sure a distribution includes all grammar files"""
+        package_root = Path(__file__).parent.parent.resolve()
+        expected_grammar_files = {
+            file_.relative_to(package_root).as_posix()
+            for file_ in package_root.joinpath("optimade/grammar").rglob("*.lark")
+        }
+
+        with tempfile.TemporaryDirectory() as temp_dir:
+            subprocess.run(
+                [
+                    "python",
+                    str(package_root.joinpath("setup.py")),
+                    "egg_info",
+                    "--egg-base",
+                    temp_dir,
+                ],
+                cwd=package_root,
+                check=True,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.STDOUT,
+                text=True,
+            )
+            sources = Path(temp_dir, "optimade.egg-info", "SOURCES.txt")
+            included_grammar_files = {
+                line
+                for line in sources.read_text().splitlines()
+                if line.endswith(".lark")
+            }
+
+        self.assertTrue(expected_grammar_files <= included_grammar_files)
