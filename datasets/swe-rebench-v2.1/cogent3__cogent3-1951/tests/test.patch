diff --git a/tests/test_core/test_new_moltype.py b/tests/test_core/test_new_moltype.py
index bcdb1a26f..943d02802 100644
--- a/tests/test_core/test_new_moltype.py
+++ b/tests/test_core/test_new_moltype.py
@@ -519,3 +519,59 @@ def test_count_variants():
     assert p("H") == 3
     assert p("NRH") == 24
     assert p("AUGCNGUCAG-AURGAUC--GAUHCGAUACGWS") == 96
+
+
+def test_degenerate_from_seq_dna():
+    dna = new_moltype.DNA
+    degenerate = dna.degenerate_from_seq
+
+    # DNA ambiguity symbols must be based on the DNA alphabet, including T.
+    assert degenerate("AT") == "W"
+    assert degenerate("AG") == "R"
+    assert degenerate("CT") == "Y"
+    # Existing ambiguity symbols stand for their represented residue sets.
+    assert degenerate("RY") == "N"
+    assert degenerate("AAA") == "A"
+    # Gaps and missing symbols have their documented special outcomes.
+    assert degenerate("---") == dna.gap
+    assert degenerate("A-") == dna.missing
+    assert degenerate("A?") == dna.missing
+
+
+def test_degenerate_from_seq():
+    """RnaMolType degenerate_from_seq should give correct results"""
+    rna = new_moltype.get_moltype("rna")
+    d = rna.degenerate_from_seq
+    # check monomers
+    assert d("A") == "A"
+    assert d("C") == "C"
+    # check seq of monomers
+    assert d("AAA") == "A"
+    # check some 2- to 4-way cases
+    assert d("AG") == "R"
+    assert d("CG") == "S"
+    assert d("ACG") == "V"
+    assert d("AGCU") == "N"
+    # Missing symbols propagate even when no gap is present.
+    assert d("A?") == rna.missing
+    # check some cases with gaps
+    assert d("A---ACU") == "?"
+    assert d("AAA-") == "?"
+    assert d("---") == "-"
+    # check mixed case example
+    assert d("AAAAAA") == "A"
+    # check example with degenerate symbols in set
+    assert d("RS") == "V"
+    assert d("RN-") == "?"
+    # check that it works for proteins as well
+    protein = new_moltype.get_moltype("protein")
+    p = protein.degenerate_from_seq
+    assert p("A") == "A"
+    assert p("AAA") == "A"
+    assert p("A?") == protein.missing
+    assert p("DN") == "B"
+    assert p("---") == "-"
+    assert p("ACD") == "X"
+    assert p("ABD") == "X"
+    assert p("ACX") == "X"
+    assert p("AC-") == "?"
