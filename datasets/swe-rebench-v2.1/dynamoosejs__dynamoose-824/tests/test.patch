+	describe("Model.scan with a nested property", () => {
+		let scanParams;
+		beforeEach(() => {
+			dynamoose.model.defaults.set({"create": false, "waitForActive": false});
+			dynamoose.aws.ddb.set({
+				"scan": (request) => {
+					scanParams = request;
+					return {"promise": async () => ({"Items": []})};
+				}
+			});
+		});
+		afterEach(() => {
+			dynamoose.aws.ddb.revert();
+			dynamoose.model.defaults.set({});
+			scanParams = null;
+		});
+
+		it("Should send a filter expression with separate path segments for a nested property", async () => {
+			const Model = dynamoose.model("NestedFilterCat", {"id": Number, "name": Object});
+			await Model.scan("name.first").eq("Charlie").exec();
+			expect(scanParams.FilterExpression).to.match(/^#\S+\.#\S+ = :v0$/);
+			expect(Object.values(scanParams.ExpressionAttributeNames)).to.have.members(["name", "first"]);
+			expect(scanParams.ExpressionAttributeValues).to.eql({":v0": {"S": "Charlie"}});
+		});
+
+		it("Should map every segment in a deeply nested scan filter", async () => {
+			const Model = dynamoose.model("DeepNestedFilterCat", {"id": Number, "name": Object});
+			await Model.scan("name.first.middle").eq("Charlie").exec();
+			const path = scanParams.FilterExpression.split(" = ")[0];
+			const placeholders = path.match(/#[A-Za-z0-9_]+/g);
+			expect(path).to.equal(placeholders.join("."));
+			expect(placeholders.map((placeholder) => scanParams.ExpressionAttributeNames[placeholder])).to.eql(["name", "first", "middle"]);
+			expect(scanParams.ExpressionAttributeValues).to.eql({":v0": {"S": "Charlie"}});
+		});
+	});
 });
