+    def test_loads_settings_before_importing_route_module(self):
+        temp_dir = mkdtemp()
+        self.addCleanup(shutil.rmtree, temp_dir)
+        suffix = os.path.basename(temp_dir)
+        settings_module = "settings_" + suffix
+        route_module = "handler_" + suffix
+
+        with open(os.path.join(temp_dir, settings_module + ".py"), "w") as settings_file:
+            settings_file.write('import os\nos.environ["SALMON_TEST_SETUP_DONE"] = "ready"\n')
+        with open(os.path.join(temp_dir, route_module + ".py"), "w") as route_file:
+            route_file.write(
+                'import os\n'
+                'if os.environ.get("SALMON_TEST_SETUP_DONE") != "ready":\n'
+                '    raise RuntimeError("settings were not loaded before route import")\n'
+                'from salmon.routing import route, stateless\n'
+                '@route("(to)@(host)", to=".+", host=".+")\n'
+                '@stateless\n'
+                'def START(message, to=None, host=None):\n'
+                '    pass\n'
+            )
+
+        env = os.environ.copy()
+        env["SALMON_SETTINGS_MODULE"] = settings_module
+        env.pop("SALMON_TEST_SETUP_DONE", None)
+        cli_args = ["routes", route_module, "--test", "user@example.com", "--path", temp_dir]
+        command = "from salmon.commands import main; main.main(args=%r)" % cli_args
+        process = subprocess.Popen(
+            [sys.executable, "-c", command], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            env=env, universal_newlines=True)
+        stdout, stderr = process.communicate()
+        self.assertEqual(process.returncode, 0, stderr)
+        self.assertIn(route_module + ".START", stdout)
+
     def test_no_args(self):
