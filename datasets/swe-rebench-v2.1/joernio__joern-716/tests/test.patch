+      assigment2.name shouldBe Operators.assignment
+      assigment2.methodFullName shouldBe Operators.assignment
+
+      // The declared variables are the left-hand sides of the initializations.
+      assigment1.ast.isIdentifier.name.l shouldBe List("foo")
+      assigment2.ast.isIdentifier.name.l shouldBe List("bar")
+
+      // The initializer values are preserved.
+      assigment1.ast.isLiteral.code.l shouldBe List("1")
+      assigment2.ast.isLiteral.code.l shouldBe List("0", "1", "2")
+    }
