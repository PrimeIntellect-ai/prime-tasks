+@testset "zip" begin
+    a = rand(10, 9, 2)
+    b = rand(10, 9, 2)
+    da = _DiskArray(a; chunksize=(5, 3, 2))
+    db = _DiskArray(b; chunksize=(2, 3, 1))
+    z = zip(a, b)
+    zd = zip(da, db)
+    @test all(zd .== z)
+    @test all(collect(zd) .== collect(z))
+
+    # Iteration follows the first chunked DiskArray even when it appears
+    # after regular arrays, and keeps each tuple aligned at its logical index.
+    x = reshape(collect(1:60), 10, 6)
+    y = reshape(collect(101:160), 10, 6)
+    dx = _DiskArray(x; chunksize=(3, 2))
+    dy = _DiskArray(y; chunksize=(2, 5))
+    mixed = zip(y, dx, x, dy)
+    expected = [(y[I], x[I], x[I], y[I]) for c in DiskArrays.eachchunk(dx) for I in CartesianIndices(c)]
+    @test vec([t for t in mixed]) == expected
+end
