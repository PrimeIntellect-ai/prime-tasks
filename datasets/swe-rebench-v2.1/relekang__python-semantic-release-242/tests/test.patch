+def test_changelog_table():
+    output = changelog_table(
+        {
+            "feature": [("commit1", "sha1"), ("commit2", "sha2")],
+            "fix": [("commit3", "sha3")],
+        },
+        ["feature", "fix"],
+    )
+    lines = output.splitlines()
+    assert lines[0] == "| Type | Change |"
+    # The second line is a Markdown table separator
+    assert set(lines[1]) <= set("|-: ")
+    assert "-" in lines[1]
+    assert "| Feature | commit1 (sha1)<br>commit2 (sha2) |" in output
+    assert "| Fix | commit3 (sha3) |" in output
+
+
+def test_changelog_table_ignores_keyword_arguments():
+    changelog = {"feature": [("commit1", "sha1")]}
+    assert changelog_table(changelog, ["feature"]) == changelog_table(
+        changelog, ["feature"], some_future_option=True
+    )
+
+
