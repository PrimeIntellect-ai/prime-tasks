+
+func TestParseDNMemoryUsage(t *testing.T) {
+	// Parsing a subject string whose attribute value is a malformed
+	// BER-encoded value must return an error without allocating an
+	// unexpectedly large amount of memory.
+	const subject = "DF=#6666666666665006838820013100000746939546349182108463491821809FBFFFFFFFFF"
+
+	var before, after runtime.MemStats
+	runtime.GC()
+	runtime.ReadMemStats(&before)
+	_, err := ParseDN(subject)
+	runtime.ReadMemStats(&after)
+
+	if err == nil {
+		t.Fatalf("expected parsing %q to fail, but it succeeded", subject)
+	}
+	if allocated := after.TotalAlloc - before.TotalAlloc; allocated > 1<<30 {
+		t.Fatalf("parsing %q allocated %d bytes, which is unexpectedly high", subject, allocated)
+	}
+}
