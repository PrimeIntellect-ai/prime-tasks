+class TestMetadataNegotiation(unittest2.TestCase):
+    def test_broker_supporting_v5_uses_v5_request_and_response(self):
+        listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+        listener.bind(('127.0.0.1', 0))
+        listener.listen(1)
+        listener.settimeout(5)
+        port = listener.getsockname()[1]
+        received = []
+        server_errors = []
+
+        def serve_one_request():
+            try:
+                connection, _ = listener.accept()
+                with connection:
+                    header = connection.recv(4)
+                    while len(header) < 4:
+                        header += connection.recv(4 - len(header))
+                    request_size = struct.unpack('!i', header)[0]
+                    request = b''
+                    while len(request) < request_size:
+                        request += connection.recv(request_size - len(request))
+                    received.append(request)
+
+                    pack = lambda fmt, *values: struct.pack('!' + fmt, *values)
+                    payload = b''.join([
+                        pack('i', 37),                  # throttle time
+                        pack('i', 1),                   # brokers
+                        pack('i', 11),                  # broker id
+                        pack('h', 6), b'broker',         # host
+                        pack('i', 9092),                # port
+                        pack('h', 4), b'rack',           # rack
+                        pack('h', 7), b'cluster',        # cluster id
+                        pack('i', 11),                  # controller id
+                        pack('i', 1),                   # topics
+                        pack('h', 0),                    # topic error
+                        pack('h', 1), b't',              # topic name
+                        b'\x01',                        # internal topic
+                        pack('i', 1),                   # partitions
+                        pack('h', 0),                    # partition error
+                        pack('i', 0),                   # partition id
+                        pack('i', 11),                  # leader
+                        pack('i', 1), pack('i', 11),    # replicas
+                        pack('i', 1), pack('i', 11),    # ISR
+                        pack('i', 1), pack('i', 11),    # offline replicas
+                    ])
+                    response_body = pack('i', 0) + payload  # correlation id + V5 body
+                    connection.sendall(pack('i', len(response_body)) + response_body)
+            except Exception as error:
+                server_errors.append(error)
+            finally:
+                listener.close()
+
+        server_thread = threading.Thread(target=serve_one_request)
+        server_thread.daemon = True
+        server_thread.start()
+        broker = Broker(
+            id_=11,
+            host='127.0.0.1',
+            port=port,
+            handler=ThreadingHandler(),
+            socket_timeout_ms=5000,
+            offsets_channel_socket_timeout_ms=5000,
+            api_versions={3: protocol.ApiVersionsSpec(3, 5, 5)},
+        )
+        try:
+            response = broker.request_metadata()
+        finally:
+            server_thread.join(5)
+
+        self.assertFalse(server_errors)
+        self.assertTrue(received)
+        self.assertEqual(struct.unpack('!h', received[0][0:2])[0], 3)
+        self.assertEqual(struct.unpack('!h', received[0][2:4])[0], 5)
+        self.assertEqual(response.throttle_time_ms, 37)
+        self.assertEqual(response.cluster_id, b'cluster')
+        self.assertEqual(response.controller_id, 11)
+        self.assertEqual(response.brokers[11].rack, b'rack')
+        self.assertEqual(response.topics[b't'].is_internal, True)
+        partition = response.topics[b't'].partitions[0]
+        self.assertEqual(partition.leader, 11)
+        self.assertEqual(partition.replicas, [11])
+        self.assertEqual(partition.isr, [11])
+        self.assertEqual(partition.offline_replicas, [11])
+
+
 class TestProduceAPI(unittest2.TestCase):
     maxDiff = None
 
