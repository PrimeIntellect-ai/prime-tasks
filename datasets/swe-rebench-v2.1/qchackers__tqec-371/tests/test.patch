+def test_plaquette_identity_and_string_representation_use_name() -> None:
+    plaquette_x = make_css_surface_code_plaquette("X")
+    plaquette_z = make_css_surface_code_plaquette("Z")
+    qubits = plaquette_x.qubits
+    same_name_a = Plaquette("shared_name", qubits, plaquette_x.circuit)
+    same_name_b = Plaquette("shared_name", qubits, plaquette_z.circuit)
+    other_name = Plaquette("other_name", qubits, plaquette_x.circuit)
+    assert same_name_a == same_name_b
+    assert hash(same_name_a) == hash(same_name_b)
+    assert same_name_a != other_name
+    assert str(same_name_a) == "shared_name"
+    assert str(other_name) == "other_name"
+    assert str(plaquette_x) == "CSS_basis(X)_VERTICAL"
