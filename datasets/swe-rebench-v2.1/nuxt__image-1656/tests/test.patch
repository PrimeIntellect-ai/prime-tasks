+import { expect } from 'vitest'
+
+function unorderedQuery(url: string) {
+  const [path, query] = url.split('?')
+  const escape = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+  const permutations = (params: string[]): string[][] => params.length
+    ? params.flatMap((param, index) => permutations(params.filter((_, i) => i !== index)).map(rest => [param, ...rest]))
+    : [[]]
+  const queries = permutations(query.split('&')).map(params => params.map(escape).join('&')).join('|')
+  return expect.stringMatching(new RegExp(`^${escape(path)}\\?(?:${queries})$`))
+}
