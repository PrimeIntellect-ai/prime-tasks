 package main
 
 import (
+	"fmt"
+	"strings"
 	"testing"
 )
 
@@ -208,3 +210,95 @@ func TestInstall(t *testing.T) {
 func TestInstallOutputCompletion(t *testing.T) {
 	outputFlagCompletionTest(t, "install")
 }
+
+func TestInstallVersionCompletion(t *testing.T) {
+	repoSetup := "--repository-config testdata/helmhome/helm/repositories.yaml --repository-cache testdata/helmhome/helm/repository"
+	for _, cmd := range []string{
+		"__complete install releasename testing/alpine --version ''",
+		"__complete install --generate-name testing/alpine --version ''",
+	} {
+		assertVersionCompletion(t, fmt.Sprintf("%s %s", repoSetup, cmd), []string{"0.3.0-rc.1", "0.2.0", "0.1.0"})
+	}
+}
+
+// assertVersionCompletion checks that a valid chart reference yields the available versions, independent of their order.
+func assertVersionCompletion(t *testing.T, cmd string, want []string) {
+	t.Helper()
+	assertVersionCompletions(t, cmd, want)
+}
+
+func assertVersionCompletions(t *testing.T, cmd string, want []string) {
+	t.Helper()
+	defer resetEnv()()
+	_, out, err := executeActionCommandC(storageFixture(), cmd)
+	if err != nil {
+		t.Fatalf("unexpected error running %q: %v", cmd, err)
+	}
+	got := versionCompletions(out)
+	wantSet := make(map[string]bool, len(want))
+	for _, version := range want {
+		wantSet[version] = true
+	}
+	gotSet := make(map[string]bool, len(got))
+	for _, version := range got {
+		gotSet[version] = true
+	}
+	if len(gotSet) != len(wantSet) {
+		t.Errorf("cmd %q: expected versions %v, got %v (raw output: %q)", cmd, wantSet, gotSet, out)
+		return
+	}
+	for version := range wantSet {
+		if !gotSet[version] {
+			t.Errorf("cmd %q: expected version %q in %v (raw output: %q)", cmd, version, got, out)
+		}
+	}
+}
+
+func versionCompletions(out string) []string {
+	var completions []string
+	for _, line := range strings.Split(out, "\n") {
+		if strings.HasPrefix(line, ":") {
+			break
+		}
+		if line != "" {
+			completions = append(completions, line)
+		}
+	}
+	return completions
+}
+
+// assertVersionCompletionPrefix runs a `__complete` invocation and asserts that
+// the suggested version strings (the lines before the directive line) exactly
+// match want. This exercises the prefix-filtering contract of --version
+// completion, which the empty-prefix golden cases cannot cover.
+func assertVersionCompletionPrefix(t *testing.T, cmd, want string) {
+	t.Helper()
+	assertVersionCompletions(t, cmd, []string{want})
+}
+
+func TestInstallVersionCompletionOtherChart(t *testing.T) {
+	repoSetup := "--repository-config testdata/helmhome/helm/repositories.yaml --repository-cache testdata/helmhome/helm/repository"
+	assertVersionCompletion(t,
+		fmt.Sprintf("%s __complete install releasename testing/mariadb --version ''", repoSetup),
+		[]string{"0.3.0"})
+}
+
+func TestInstallVersionCompletionOtherPrefix(t *testing.T) {
+	repoSetup := "--repository-config testdata/helmhome/helm/repositories.yaml --repository-cache testdata/helmhome/helm/repository"
+	assertVersionCompletion(t,
+		fmt.Sprintf("%s __complete install releasename testing/alpine --version '0.1'", repoSetup),
+		[]string{"0.1.0"})
+}
+
+func TestInstallVersionCompletionPrefix(t *testing.T) {
+	repoFile := "testdata/helmhome/helm/repositories.yaml"
+	repoCache := "testdata/helmhome/helm/repository"
+
+	repoSetup := fmt.Sprintf("--repository-config %s --repository-cache %s", repoFile, repoCache)
+
+	// A non-empty prefix must filter the returned versions: only 0.2.0 matches
+	// the "0.2" prefix, so 0.1.0 and 0.3.0-rc.1 must not be suggested.
+	assertVersionCompletionPrefix(t,
+		fmt.Sprintf("%s __complete install releasename testing/alpine --version '0.2'", repoSetup),
+		"0.2.0")
+}
