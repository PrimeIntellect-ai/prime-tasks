@@ -423,3 +426,79 @@ func TestSignEncode(t *testing.T) {
 		}
 	})
 }
+
+type scriptedCreateResponse struct {
+	*bytes.Reader
+}
+
+func (r *scriptedCreateResponse) Write(p []byte) (int, error) {
+	return len(p), nil
+}
+
+func TestCreateKeyReturnsBlobsWithoutHandle(t *testing.T) {
+	privateWant := []byte{0x11, 0x22}
+	publicWant := []byte{0x33, 0x44}
+	hashWant := []byte{0x55, 0x66}
+	creationData, err := (&CreationData{
+		PCRSelection:        PCRSelection{},
+		ParentName:          Name{},
+		ParentQualifiedName: Name{},
+	}).encode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	ticketWant := Ticket{
+		Type:      tpmutil.Tag(0x8021),
+		Hierarchy: 0x40000001,
+		Digest:    []byte{0x77, 0x88},
+	}
+	parameters, err := tpmutil.Pack(
+		tpmutil.U16Bytes(privateWant),
+		tpmutil.U16Bytes(publicWant),
+		tpmutil.U16Bytes(creationData),
+		tpmutil.U16Bytes(hashWant),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ticketBytes, err := tpmutil.Pack(ticketWant.Type, ticketWant.Hierarchy, ticketWant.Digest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	responseBody, err := tpmutil.Pack(uint32(len(parameters)), tpmutil.RawBytes(parameters), tpmutil.RawBytes(ticketBytes))
+	if err != nil {
+		t.Fatal(err)
+	}
+	response, err := tpmutil.Pack(
+		TagSessions,
+		uint32(10+len(responseBody)),
+		tpmutil.RCSuccess,
+		tpmutil.RawBytes(responseBody),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	private, public, gotCreationData, gotHash, gotTicket, err := CreateKey(
+		&scriptedCreateResponse{bytes.NewReader(response)},
+		tpmutil.Handle(0x81000001), pcrSelection7, "", "", defaultKeyParams,
+	)
+	if err != nil {
+		t.Fatalf("CreateKey failed: %v", err)
+	}
+	if !bytes.Equal(private, privateWant) {
+		t.Errorf("private blob = %x, want %x", private, privateWant)
+	}
+	if !bytes.Equal(public, publicWant) {
+		t.Errorf("public blob = %x, want %x", public, publicWant)
+	}
+	if !bytes.Equal(gotCreationData, creationData) {
+		t.Errorf("creation data = %x, want %x", gotCreationData, creationData)
+	}
+	if !bytes.Equal(gotHash, hashWant) {
+		t.Errorf("creation hash = %x, want %x", gotHash, hashWant)
+	}
+	if !reflect.DeepEqual(gotTicket, ticketWant) {
+		t.Errorf("creation ticket = %+v, want %+v", gotTicket, ticketWant)
+	}
+}
