+package day131
+
+import "testing"
+
+func TestDeepCloneRandomSinglyLL(t *testing.T) {
+	testCases := []struct {
+		name string
+		head *RandomSinglyLL
+	}{
+		{name: "nil head"},
+		{name: "single node with no random pointer", head: &RandomSinglyLL{Value: 7}},
+		{name: "self random pointer", head: &RandomSinglyLL{Value: 8}},
+		{name: "forward backward and nil random pointers", head: makeRandomPointerList()},
+	}
+	testCases[2].head.Random = testCases[2].head
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			original := collectTestInputNodes(tc.head)
+			originalNext := make([]*RandomSinglyLL, len(original))
+			originalRandom := make([]*RandomSinglyLL, len(original))
+			originalSet := make(map[*RandomSinglyLL]bool, len(original))
+			index := make(map[*RandomSinglyLL]int, len(original))
+			for i, node := range original {
+				originalNext[i] = node.Next
+				originalRandom[i] = node.Random
+				originalSet[node] = true
+				index[node] = i
+			}
+
+			cloneHead := DeepCloneRandomSinglyLL(tc.head)
+			if tc.head == nil {
+				if cloneHead != nil {
+					t.Fatal("nil input must produce a nil clone")
+				}
+				return
+			}
+			if cloneHead == nil {
+				t.Fatal("non-nil input produced a nil clone")
+			}
+
+			clones := make([]*RandomSinglyLL, 0, len(original))
+			for node := cloneHead; node != nil && len(clones) <= len(original); node = node.Next {
+				clones = append(clones, node)
+			}
+			if len(clones) != len(original) {
+				t.Fatalf("clone has %d nodes; want %d", len(clones), len(original))
+			}
+
+			seen := make(map[*RandomSinglyLL]bool, len(clones))
+			for i, source := range original {
+				clone := clones[i]
+				if originalSet[clone] {
+					t.Errorf("node %d aliases a node from the input list", i)
+				}
+				if seen[clone] {
+					t.Errorf("multiple list positions share clone node %d", i)
+				}
+				seen[clone] = true
+				if clone.Value != source.Value {
+					t.Errorf("node %d value = %d; want %d", i, clone.Value, source.Value)
+				}
+				var wantNext *RandomSinglyLL
+				if i+1 < len(clones) {
+					wantNext = clones[i+1]
+				}
+				if clone.Next != wantNext {
+					t.Errorf("node %d does not point to the corresponding next clone", i)
+				}
+				wantRandom := (*RandomSinglyLL)(nil)
+				if source.Random != nil {
+					randomIndex, ok := index[source.Random]
+					if !ok {
+						t.Fatalf("test input random pointer at node %d is not in the list", i)
+					}
+					wantRandom = clones[randomIndex]
+				}
+				if clone.Random != wantRandom {
+					t.Errorf("node %d random pointer does not target the corresponding clone", i)
+				}
+				if source.Next != originalNext[i] || source.Random != originalRandom[i] {
+					t.Errorf("cloning changed input node %d", i)
+				}
+			}
+		})
+	}
+}
+
+func makeRandomPointerList() *RandomSinglyLL {
+	first := &RandomSinglyLL{Value: 10}
+	second := &RandomSinglyLL{Value: 20}
+	third := &RandomSinglyLL{Value: 30}
+	fourth := &RandomSinglyLL{Value: 40}
+	first.Next = second
+	second.Next = third
+	third.Next = fourth
+	first.Random = third
+	second.Random = first
+	third.Random = third
+	return first
+}
+
+func collectTestInputNodes(head *RandomSinglyLL) []*RandomSinglyLL {
+	var nodes []*RandomSinglyLL
+	for node := head; node != nil; node = node.Next {
+		nodes = append(nodes, node)
+	}
+	return nodes
+}
