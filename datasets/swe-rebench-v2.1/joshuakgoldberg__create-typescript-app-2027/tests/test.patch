 			});
 		});
 	});
+
+	describe("migrated README badges", () => {
+		function createReadme(
+			badges: string[],
+			logo: Awaited<ReturnType<typeof readLogo>>,
+		) {
+			return testBlock(blockREADME, {
+				addons: { badges },
+				options: { ...optionsBase, logo, usage: "Use it." },
+			}).files["README.md"];
+		}
+
+		function badgeParagraphs(readme: string) {
+			return [...readme.matchAll(/<p align="center">([\s\S]*?)<\/p>/g)].map(
+				(match) => match[1],
+			);
+		}
+
+		it("keeps existing shields.io badges in the generated badge collection", async () => {
+			const badgeLabel = "Build status";
+			const badge = `<img alt="${badgeLabel}" src="https://img.shields.io/github/actions/workflow/status/test-owner/test-repository/ci.yml" />`;
+			const logo = await readLogo(() => Promise.resolve(`\n${badge}`));
+			const readme = createReadme([badge], logo);
+
+			expect(
+				badgeParagraphs(readme).some((paragraph) =>
+					paragraph.includes(badgeLabel),
+				),
+			).toBe(true);
+			expect(
+				readme.replace(/<p align="center">[\s\S]*?<\/p>/g, ""),
+			).not.toContain(badgeLabel);
+		});
+
+		it("keeps an All Contributors image in the badge collection, not as the project logo", async () => {
+			const badgeLabel = "All Contributors";
+			const badge = `<img alt="${badgeLabel}: 1" src="https://img.shields.io/badge/all_contributors-1-21bb42.svg" />`;
+			const logo = await readLogo(() => Promise.resolve(`\n${badge}`));
+			const readme = createReadme([badge], logo);
+			const paragraphs = badgeParagraphs(readme);
+
+			expect(
+				paragraphs.some((paragraph) => paragraph.includes(badgeLabel)),
+			).toBe(true);
+			expect(
+				readme.replace(/<p align="center">[\s\S]*?<\/p>/g, ""),
+			).not.toContain(badgeLabel);
+		});
+	});
 });
