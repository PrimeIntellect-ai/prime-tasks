+#[cw_serde]
+pub struct MapMsg {
+    btree: std::collections::BTreeMap<String, u32>,
+    hash: std::collections::HashMap<String, u32>,
+}
+
+#[test]
+fn map_msg_constructs_with_expected_fields() {
+    let msg = MapMsg {
+        btree: std::collections::BTreeMap::from([("a".to_string(), 1)]),
+        hash: std::collections::HashMap::from([("b".to_string(), 2)]),
+    };
+
+    assert_eq!(msg.btree.get("a"), Some(&1));
+    assert_eq!(msg.hash.get("b"), Some(&2));
+}
+
+#[test]
+fn assert_maps_generate_correctly() {
+    let schema = cosmwasm_schema::schema_for!(MapMsg);
+    let json = serde_json::to_value(&schema).unwrap();
+
+    for field in ["btree", "hash"] {
+        let additional = &json["properties"][field]["additionalProperties"];
+        assert_eq!(additional["type"], "integer");
+        assert_eq!(additional["format"], "uint32");
+    }
+}
+
