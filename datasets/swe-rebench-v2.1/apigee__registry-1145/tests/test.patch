+func TestFQNameUnspecifiedLocation(t *testing.T) {
+	originalDirectory := config.Directory
+	config.Directory = t.TempDir()
+	t.Cleanup(func() { config.Directory = originalDirectory })
+	originalFlags := config.Flags
+	config.Flags = config.CreateFlagSet()
+	t.Cleanup(func() { config.Flags = originalFlags })
+
+	cmd := configurationcmd.Command()
+	cmd.PersistentFlags().AddFlagSet(config.Flags)
+	cmd.SetArgs([]string{"create", "local", "--registry.address=localhost:8080", "--registry.project=project1"})
+	if err := cmd.Execute(); err != nil {
+		t.Fatal(err)
+	}
+
+	c, err := ActiveConfig()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, want := c.FQName("apis/foo"), "projects/project1/locations/global/apis/foo"; got != want {
+		t.Errorf("omitted location: want %q, got %q", want, got)
+	}
+	if got, want := c.FQName("locations/foo/apis/bar"), "projects/project1/locations/foo/apis/bar"; got != want {
+		t.Errorf("explicit location: want %q, got %q", want, got)
+	}
+}
