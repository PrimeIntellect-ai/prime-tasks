+def test_page_rotation():
+    reader = PdfReader(os.path.join(RESOURCE_ROOT, "crazyones.pdf"))
+    page = reader.pages[0]
+
+    # A positive angle rotates the page clockwise and updates /Rotate.
+    result = page.rotate(90)
+    assert result is page
+    assert page.get(PG.ROTATE) % 360 == 90
+
+    # A negative angle rotates the page counter-clockwise.
+    result = page.rotate(-90)
+    assert result is page
+    assert page.get(PG.ROTATE) % 360 == 0
+
+    # Rotating a fresh page counter-clockwise is equivalent to a 270 degree
+    # clockwise rotation; the stored /Rotate may be normalized to 0-359.
+    page2 = reader.pages[0]
+    assert page2.rotate(-90) is page2
+    assert page2.get(PG.ROTATE) % 360 == 270
+
