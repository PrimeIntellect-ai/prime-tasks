@@ -64,9 +68,36 @@ defmodule JSONAPI.ViewTest do
     refute {:render, 2} in PostView.__info__(:functions)
   end
 
+  test "hidden fields are omitted from the rendered response attributes" do
+    data = %{id: 1, age: 100, first_name: "Jason", last_name: "S", password: "securepw"}
+    encoded = JSONAPI.Serializer.serialize(UserView, data, nil)
+    attributes = encoded[:data][:attributes]
+
+    refute Map.has_key?(attributes, :password)
+    assert attributes[:age] == 100
+    assert attributes[:first_name] == "Jason"
+    assert attributes[:last_name] == "S"
+  end
+
+  test "hidden fields remain in ordinary fields for input consumers" do
+    assert :password in UserView.fields()
+  end
+
+  test "hidden fields are accepted from posted and patched input" do
+    posted_attributes = %{age: 100, password: "posted-password"}
+    patched_attributes = %{password: "patched-password"}
+
+    accepted_posted_attributes = Map.take(posted_attributes, UserView.fields())
+    accepted_patched_attributes = Map.take(patched_attributes, UserView.fields())
+
+    assert accepted_posted_attributes == posted_attributes
+    assert accepted_patched_attributes == patched_attributes
+  end
+
   test "attributes/2 with `:underscore_to_dash` option" do
     Application.put_env(:jsonapi, :underscore_to_dash, true)
     expected_map = %{age: 100, "first-name": "Jason", "last-name": "S"}
     assert expected_map == UserView.attributes(%{age: 100, first_name: "Jason", last_name: "S"}, nil)
+    Application.put_env(:jsonapi, :underscore_to_dash, false)
