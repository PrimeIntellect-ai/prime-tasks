+def test_flake8_error_severity_for_selected_pyflakes_codes(workspace):
+    doc_str = dedent(
+        """\
+        import os
+
+        x = 1
+
+
+        def undefined_name():
+            return missing_name
+
+
+        def shadowing():
+            print(x)
+            x = 2
+            return x
+
+
+        def unused_local():
+            value = 8
+
+
+        def duplicate_arguments(a, a):
+            return a
+        """
+    )
+    doc = Document("", workspace, doc_str)
+    diags = flake8_lint.pylsp_lint(workspace, doc)
+
+    def severity_of(code):
+        matches = [d["severity"] for d in diags if d["code"] == code]
+        assert matches, f"expected a {code} diagnostic"
+        return matches[0]
+
+    # Definite pyflakes errors are reported as errors.
+    assert severity_of("F821") == lsp.DiagnosticSeverity.Error
+    assert severity_of("F823") == lsp.DiagnosticSeverity.Error
+    assert severity_of("F831") == lsp.DiagnosticSeverity.Error
+    # Other pyflakes diagnostics are only warnings.
+    assert severity_of("F401") == lsp.DiagnosticSeverity.Warning
+    assert severity_of("F841") == lsp.DiagnosticSeverity.Warning
