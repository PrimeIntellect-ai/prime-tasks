 package table
 
 import (
+	"strings"
 	"testing"
 
 	"github.com/stretchr/testify/assert"
 )
 
+func assertRenderedRowOrder(t *testing.T, table *Table, expected ...string) {
+	t.Helper()
+	rendered := table.Render()
+	previous := -1
+	for _, rowID := range expected {
+		position := strings.Index(rendered, rowID)
+		assert.GreaterOrEqual(t, position, 0, "rendered table should contain row %q", rowID)
+		assert.Greater(t, position, previous, "rendered row %q should follow the prior row", rowID)
+		previous = position
+	}
+}
+
+func TestTable_sortRows_MissingCells(t *testing.T) {
+	table := Table{}
+	table.AppendRows([]Row{
+		{"missing-z", "z"},
+		{"missing-a", "a"},
+		{"missing-b", "b"},
+		{"text-z", "z", "x"},
+		{"text-a", "a", "x"},
+	})
+	table.SetStyle(StyleDefault)
+
+	// Missing third-column values compare like empty strings in descending
+	// order, and the second key still orders rows whose first key is missing.
+	table.SortBy([]SortBy{{Number: 3, Mode: Dsc}, {Number: 2, Mode: Asc}})
+	assertRenderedRowOrder(t, &table, "text-a", "text-z", "missing-a", "missing-b", "missing-z")
+}
+
+func TestTable_sortRows_InvalidMode(t *testing.T) {
+	table := Table{}
+	table.AppendRows([]Row{
+		{1, "Arya", "Stark", 3000},
+		{11, "Sansa", "Stark", 3000},
+		{20, "Jon", "Snow", 2000, "You know nothing, Jon Snow!"},
+		{300, "Tyrion", "Lannister", 5000},
+	})
+	table.SetStyle(StyleDefault)
+
+	// A numeric-only mode leaves nonnumeric values in their original order.
+	table.SortBy([]SortBy{{Number: 2, Mode: AscNumeric}})
+	assertRenderedRowOrder(t, &table, "Arya", "Sansa", "Jon", "Tyrion")
+}
+
+func TestTable_sortRows_MixedMode(t *testing.T) {
+	table := Table{}
+	table.AppendRows([]Row{
+		{"ten", "10"},
+		{"alpha", "alpha"},
+		{"zebra", "zebra"},
+		{"two", "2"},
+		{"beta", "beta"},
+		{"negative", "-3"},
+	})
+	table.SetStyle(StyleDefault)
+
+	table.SortBy([]SortBy{{Number: 2, Mode: AscAlphaNumeric}})
+	assertRenderedRowOrder(t, &table, "alpha", "beta", "zebra", "negative", "two", "ten")
+
+	table.SortBy([]SortBy{{Number: 2, Mode: AscNumericAlpha}})
+	assertRenderedRowOrder(t, &table, "negative", "two", "ten", "alpha", "beta", "zebra")
+
+	table.SortBy([]SortBy{{Number: 2, Mode: DscAlphaNumeric}})
+	assertRenderedRowOrder(t, &table, "zebra", "beta", "alpha", "ten", "two", "negative")
+
+	table.SortBy([]SortBy{{Number: 2, Mode: DscNumericAlpha}})
+	assertRenderedRowOrder(t, &table, "ten", "two", "negative", "zebra", "beta", "alpha")
+}
+
