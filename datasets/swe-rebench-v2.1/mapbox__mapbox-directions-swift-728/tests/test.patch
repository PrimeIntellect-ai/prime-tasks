+    func testCommandLineToolAcceptsDirectionsRequestURL() throws {
+        guard let executableURL = commandLineToolExecutableURL() else {
+            XCTFail("The command line tool executable could not be located.")
+            return
+        }
+        
+        let repositoryRoot = URL(fileURLWithPath: #filePath)
+            .deletingLastPathComponent()
+            .deletingLastPathComponent()
+            .deletingLastPathComponent()
+        let inputURL = repositoryRoot
+            .appendingPathComponent("Tests/MapboxDirectionsTests/Fixtures/v5/v5_driving_dc_polyline.json")
+        XCTAssertTrue(FileManager.default.fileExists(atPath: inputURL.path),
+                      "The input fixture is missing at \(inputURL.path).")
+        
+        let outputURL = URL(fileURLWithPath: NSTemporaryDirectory())
+            .appendingPathComponent("mapbox-directions-swift-cli-\(UUID().uuidString).json")
+        defer { try? FileManager.default.removeItem(at: outputURL) }
+        
+        let requestURL = "https://api.mapbox.com/directions/v5/mapbox/driving-traffic/-121.913565,37.331832;-121.916282,37.328707.json"
+        
+        let process = Process()
+        process.executableURL = executableURL
+        process.arguments = ["route", requestURL, "--input", inputURL.path, "--output", outputURL.path]
+        var environment = ProcessInfo.processInfo.environment
+        environment["MAPBOX_ACCESS_TOKEN"] = "pk.eyJ1IjoiZXhhbXBsZSJ9.example"
+        process.environment = environment
+        
+        try process.run()
+        process.waitUntilExit()
+        
+        XCTAssertEqual(process.terminationStatus, 0,
+                       "The command line tool did not accept a Directions API request URL as input.")
+        let outputData = (try? Data(contentsOf: outputURL)) ?? Data()
+        XCTAssertFalse(outputData.isEmpty,
+                       "The command line tool produced no output for a Directions API request URL.")
+    }
+    
+    private func commandLineToolExecutableURL() -> URL? {
+        let bundleURL = URL(fileURLWithPath: Bundle.main.bundlePath)
+        let candidates = [
+            bundleURL.appendingPathComponent("mapbox-directions-swift"),
+            bundleURL.deletingLastPathComponent().appendingPathComponent("mapbox-directions-swift"),
+        ]
+        return candidates.first { FileManager.default.isExecutableFile(atPath: $0.path) }
+    }
+    
