+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+import pytest
+
+from cfnlint import lint
+
+
+def _template(source_fifo, dlq_fifo):
+    source_fifo_property = (
+        "" if source_fifo is None else f"      FifoQueue: {str(source_fifo).lower()}\n"
+    )
+    dlq_fifo_property = (
+        "" if dlq_fifo is None else f"      FifoQueue: {str(dlq_fifo).lower()}\n"
+    )
+    source_name = "source.fifo" if source_fifo else "source"
+    dlq_name = "dead-letter.fifo" if dlq_fifo else "dead-letter"
+    return f"""Resources:
+  DeadLetterQueue:
+    Type: AWS::SQS::Queue
+    Properties:
+      QueueName: {dlq_name}
+{dlq_fifo_property}  SourceQueue:
+    Type: AWS::SQS::Queue
+    Properties:
+      QueueName: {source_name}
+{source_fifo_property}      RedrivePolicy:
+        deadLetterTargetArn: !GetAtt DeadLetterQueue.Arn
+        maxReceiveCount: 3
+"""
+
+
+@pytest.mark.parametrize(
+    "source_fifo,dlq_fifo",
+    [(True, False), (False, True), (None, True)],
+)
+def test_mismatched_queue_types_add_validation_error(source_fifo, dlq_fifo):
+    matching_dlq_fifo = bool(source_fifo)
+    mismatched_matches = lint(_template(source_fifo, dlq_fifo))
+    matching_matches = lint(_template(source_fifo, matching_dlq_fifo))
+
+    assert len(mismatched_matches) > len(matching_matches)
+
+
+def test_public_validate_returns_iterable(validator):
+    from cfnlint.rules.resources.sqs.QueueDLQ import QueueDLQ
+
+    assert list(QueueDLQ().validate(validator, "", {}, {})) == []
