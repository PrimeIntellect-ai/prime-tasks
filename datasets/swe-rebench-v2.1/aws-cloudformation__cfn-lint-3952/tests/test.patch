+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+from cfnlint import lint
+
+
+def _template(dlq_fifo):
+    dlq_name = "dead-letter.fifo" if dlq_fifo else "dead-letter"
+    dlq_fifo_property = "      FifoQueue: true\n" if dlq_fifo else ""
+    return f"""Resources:
+  DeadLetterQueue:
+    Type: AWS::SQS::Queue
+    Properties:
+      QueueName: {dlq_name}
+{dlq_fifo_property}  SourceQueue:
+    Type: AWS::SQS::Queue
+    Properties:
+      QueueName: source.fifo
+      FifoQueue: true
+      RedrivePolicy:
+        deadLetterTargetArn: !GetAtt [DeadLetterQueue, Arn]
+        maxReceiveCount: 3
+"""
+
+
+def test_getatt_list_target_type_mismatch_adds_validation_error():
+    mismatched_matches = lint(_template(False))
+    matching_matches = lint(_template(True))
+
+    assert len(mismatched_matches) > len(matching_matches)
