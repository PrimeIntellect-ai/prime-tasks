diff --git a/cmd/helm/version_test.go b/cmd/helm/version_test.go
index 89b89093..f863f3d1 100644
--- a/cmd/helm/version_test.go
+++ b/cmd/helm/version_test.go
@@ -16,7 +16,10 @@ limitations under the License.
 package main
 
 import (
+	"strings"
 	"testing"
+
+	"helm.sh/helm/v3/internal/version"
 )
 
 func TestVersion(t *testing.T) {
@@ -34,4 +37,37 @@ func TestVersion(t *testing.T) {
 		golden: "output/version-template.txt",
 	}}
 	runTestCmd(t, tests)
+
+	// The Helm 2 compatibility shorthand must be accepted and print client
+	// version information. The compatibility format does not require a
+	// Helm 2-specific prefix or serialization.
+	t.Run("client shorthand", func(t *testing.T) {
+		defer resetEnv()()
+		_, out, err := executeActionCommandC(storageFixture(), "version -c")
+		if err != nil {
+			t.Fatalf("expected version -c to succeed, got error: %v", err)
+		}
+		out = strings.TrimSpace(out)
+		if out == "" {
+			t.Fatal("expected version -c to print client version information, got empty output")
+		}
+		if !strings.Contains(out, version.GetVersion()) {
+			t.Errorf("expected version -c output to contain version %q, got %q", version.GetVersion(), out)
+		}
+	})
+
+	// The compatibility shorthand is accepted but must not be advertised.
+	t.Run("client shorthand hidden", func(t *testing.T) {
+		defer resetEnv()()
+		_, out, err := executeActionCommandC(storageFixture(), "version --help")
+		if err != nil {
+			t.Fatalf("expected version --help to succeed, got error: %v", err)
+		}
+		for _, field := range strings.Fields(out) {
+			if strings.TrimRight(field, ",") == "-c" {
+				t.Errorf("expected -c to be hidden from help output, got:\n%s", out)
+				break
+			}
+		}
+	})
 }
