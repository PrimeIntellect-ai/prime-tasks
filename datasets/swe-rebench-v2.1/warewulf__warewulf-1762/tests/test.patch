+// TestWWboolBoolDefaultTrue verifies the public WWbool.BoolDefaultTrue method
+// that the OnBoot default-true behaviour relies on. The method is looked up
+// dynamically so that a missing method is reported as a behavioural test
+// failure rather than a build error.
+func TestWWboolBoolDefaultTrue(t *testing.T) {
+	wwboolType := reflect.TypeOf(wwtype.WWbool(""))
+	method, ok := wwboolType.MethodByName("BoolDefaultTrue")
+	if !assert.True(t, ok, "WWbool must provide a BoolDefaultTrue method") {
+		return
+	}
+	assert.Equal(t, 1, method.Type.NumIn(), "BoolDefaultTrue must take no arguments")
+	assert.Equal(t, 1, method.Type.NumOut(), "BoolDefaultTrue must return a single value")
+	assert.Equal(t, reflect.Bool, method.Type.Out(0).Kind(), "BoolDefaultTrue must return a bool")
+
+	tests := map[string]bool{
+		"":      true,
+		"true":  true,
+		"false": false,
+		"yes":   true,
+		"no":    false,
+	}
+	for value, expected := range tests {
+		t.Run(value, func(t *testing.T) {
+			result := method.Func.Call([]reflect.Value{reflect.ValueOf(wwtype.WWbool(value))})
+			assert.Equal(t, expected, result[0].Bool())
+		})
+	}
+}
+
+func withoutOnBootSetting(output string) string {
+	var lines []string
+	for _, line := range strings.Split(output, "\n") {
+		if !strings.HasPrefix(line, "ONBOOT=") {
+			lines = append(lines, line)
+		}
+	}
+	return strings.Join(lines, "\n")
+}
