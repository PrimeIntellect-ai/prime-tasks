diff --git a/number_test.go b/number_test.go
index ce33b5e..d36a496 100644
--- a/number_test.go
+++ b/number_test.go
@@ -252,6 +252,17 @@ func TestNumberInRange(t *testing.T) {
 	value.NotInRange(1234+1, 1234-1)
 	value.chain.assertOK(t)
 	value.chain.reset()
+
+	value.NotInRange(1234+1, "1234+2")
+	value.chain.assertFailed(t)
+	value.chain.reset()
+	value.NotInRange("1234+1", 1234+2)
+	value.chain.assertFailed(t)
+	value.chain.reset()
+
+	value.NotInRange(1234+1, 1234+2)
+	value.chain.assertOK(t)
+	value.chain.reset()
 }
 
