 }
+
+func TestChartWithDependencyAliasedTwiceAndDoublyReferencedSubDependency(t *testing.T) {
+	cmd := osexec.Command("go", "run", "../../../../cmd/helm", "template", "aliases", "testdata/chart-with-dependency-aliased-twice")
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("rendering chart failed: %v\n%s", err, output)
+	}
+
+	resources := strings.Split(string(output), "\n---\n")
+	for _, rendered := range []struct {
+		name  string
+		value string
+	}{
+		{name: "grandchild-foo", value: "foo"},
+		{name: "grandchild-bar", value: "bar"},
+	} {
+		found := false
+		for _, resource := range resources {
+			if strings.Contains(resource, "name: "+rendered.name) && strings.Contains(resource, "from: "+rendered.value) {
+				found = true
+				break
+			}
+		}
+		if !found {
+			t.Errorf("rendered grandchild resource %q with from value %q was not found in:\n%s", rendered.name, rendered.value, output)
+		}
+	}
+}
