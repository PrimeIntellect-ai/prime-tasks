+func TestGeneratorInterceptor_UnbindRemoteStream(t *testing.T) {
+	const interval = time.Millisecond * 10
+	f, err := NewGeneratorInterceptor(
+		GeneratorInterval(interval),
+		GeneratorLog(logging.NewDefaultLoggerFactory().NewLogger("test")),
+	)
+	require.NoError(t, err)
+
+	i, err := f.NewInterceptor("")
+	require.NoError(t, err)
+
+	info := &interceptor.StreamInfo{
+		SSRC:         1,
+		RTCPFeedback: []interceptor.RTCPFeedback{{Type: "nack"}},
+	}
+	stream := test.NewMockStream(info, i)
+	defer func() {
+		require.NoError(t, stream.Close())
+	}()
+
+	// Packets 11 and 12 are missing, so the generator keeps requesting them.
+	for _, seqNum := range []uint16{10, 13} {
+		stream.ReceiveRTP(&rtp.Packet{Header: rtp.Header{SequenceNumber: seqNum}})
+		select {
+		case r := <-stream.ReadRTP():
+			require.NoError(t, r.Err)
+			require.Equal(t, seqNum, r.Packet.SequenceNumber)
+		case <-time.After(100 * time.Millisecond):
+			t.Fatal("receiver rtp packet not found")
+		}
+	}
+
+	nackFor := func(pkts []rtcp.Packet, ssrc uint32) bool {
+		for _, pkt := range pkts {
+			if nack, ok := pkt.(*rtcp.TransportLayerNack); ok && nack.MediaSSRC == ssrc {
+				return true
+			}
+		}
+		return false
+	}
+
+	select {
+	case pkts := <-stream.WrittenRTCP():
+		require.True(t, nackFor(pkts, 1), "nack expected before the remote stream is removed")
+	case <-time.After(time.Second):
+		t.Fatal("nack not written before the remote stream is removed")
+	}
+
+	i.UnbindRemoteStream(info)
+
+	// Drain any nack that was written before the removal took effect.
+	drained := true
+	for drained {
+		select {
+		case <-stream.WrittenRTCP():
+		default:
+			drained = false
+		}
+	}
+
+	// Once the remote stream is removed, no further nacks should be generated for it.
+	timeout := time.NewTimer(interval * 5)
+	defer timeout.Stop()
+	for {
+		select {
+		case pkts := <-stream.WrittenRTCP():
+			require.False(t, nackFor(pkts, 1), "no nack expected for a removed remote stream")
+		case <-timeout.C:
+			return
+		}
+	}
+}
