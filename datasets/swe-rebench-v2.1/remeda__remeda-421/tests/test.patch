+import { debounce } from './index';
+
+describe('debounce', () => {
+  it('defers a burst of updates and uses the latest input', async () => {
+    vi.useFakeTimers();
+
+    try {
+      const update = vi.fn();
+      const debounced = debounce(update, { waitMs: 25 });
+
+      debounced.call('first');
+      debounced.call('second');
+      debounced.call('latest');
+
+      expect(update).not.toHaveBeenCalled();
+
+      await vi.runAllTimersAsync();
+
+      expect(update).toHaveBeenCalledTimes(1);
+      expect(update).toHaveBeenCalledWith('latest');
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+});
