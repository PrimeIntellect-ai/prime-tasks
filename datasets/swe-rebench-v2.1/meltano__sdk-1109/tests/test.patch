+def test_requests_library_auth(rest_tap: Tap):
+    """Validate that a requests.auth object can be used as an authenticator."""
+    stream: RESTStream = rest_tap.streams["proxy_auth_stream"]
+    r = stream.prepare_request(None, None)
+
+    assert r.headers["Proxy-Authorization"] == "Basic dXNlcm5hbWU6cGFzc3dvcmQ="
+
+
+def test_custom_requests_authenticator_is_applied(rest_tap: Tap):
+    """Validate that a third-party Requests-compatible auth callable is applied."""
+
+    class PackageAuthenticator(AuthBase):
+        def __call__(self, request: requests.PreparedRequest):
+            request.headers["X-Package-Authentication"] = "applied"
+            return request
+
+    class PackageAuthStream(RESTStream):
+        url_base = "https://example.com"
+        schema = {"type": "object", "properties": {}}
+        path = "/custom-auth"
+
+        @property
+        def authenticator(self):
+            return PackageAuthenticator()
+
+    stream = PackageAuthStream(rest_tap, name="package_auth_stream")
+    prepared = stream.prepare_request(None, None)
+
+    assert prepared.headers["X-Package-Authentication"] == "applied"
+
+
+def test_api_authenticator_is_callable_by_requests(rest_tap: Tap):
+    """Validate that Requests delegates to an SDK authenticator."""
+
+    class ObservableAuthenticator(APIAuthenticatorBase):
+        def authenticate_request(self, request: requests.PreparedRequest):
+            request.headers["X-SDK-Authentication"] = "delegated"
+            return request
+
+    authenticator = ObservableAuthenticator(
+        stream=rest_tap.streams["some_stream"]
+    )
+    session = requests.Session()
+    prepared = session.prepare_request(
+        requests.Request("GET", "https://example.com", auth=authenticator)
+    )
+
+    assert prepared.headers["X-SDK-Authentication"] == "delegated"
