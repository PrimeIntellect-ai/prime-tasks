+    @patch("black.dump_to_file", dump_to_stderr)
+    def test_trailing_comma_in_def_py35(self) -> None:
+        source = (
+            "def foo_func(bar, *, lorem=None, ipsum=None, dolor=None, sit=None, "
+            "amet=None, consectetur=None):\n"
+            "    print('lorem ipsum dolor sit amet')\n"
+        )
+        # A trailing comma in a function signature that contains a bare `*`
+        # argument is invalid in Python 3.5, so black must not add one when
+        # formatting for that target version.
+        actual = black.format_str(
+            source,
+            mode=black.FileMode(
+                target_versions={black.TargetVersion.PY35}, line_length=80
+            ),
+        )
+        self.assertNotIn("consectetur=None,\n)", actual)
+
     def test_get_future_imports(self) -> None:
