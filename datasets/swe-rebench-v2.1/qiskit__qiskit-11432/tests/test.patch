+    def test_assign_parameters_by_name(self):
+        """Test that parameters can be assigned by name as well as value."""
+        a = Parameter("a")
+        b = Parameter("b")
+        c = Parameter("c")
+        qc = QuantumCircuit(2, global_phase=a * 2)
+        qc.rx(b + 0.125 * c, 0)
+
+        self.assertEqual(
+            qc.assign_parameters({a: 1, b: 2, c: 3}), qc.assign_parameters({"a": 1, "b": 2, "c": 3})
+        )
+
+    def test_assign_parameters_by_name_partial(self):
+        a = Parameter("a")
+        b = Parameter("b")
+        qc = QuantumCircuit(1)
+        qc.rx(a, 0)
+        qc.ry(b, 0)
+
+        bound = qc.assign_parameters({"a": 1})
+        self.assertEqual(bound, qc.assign_parameters({a: 1}))
+        self.assertEqual(bound.parameters, {b})
+
