+def drop_unset_settings(obs, expect):
+    """Ignore settings entries that are unset (None) and not named in expect.
+
+    Only the environment-selection setting is an unset entry that the
+    expectations leave out; every other settings entry is still compared.
+    """
+    obs_settings = obs.get("settings", {})
+    obs_settings = {
+        k: v
+        for k, v in obs_settings.items()
+        if v is not None or k in expect.get("settings", {})
+    }
+    return {**obs, "settings": obs_settings}
+
