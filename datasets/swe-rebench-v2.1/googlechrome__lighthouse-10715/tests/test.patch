+];
 
 /* eslint-env jest */
 
@@ -270,4 +289,80 @@ describe('Audit', () => {
       });
     });
   });
+
+  describe('scored audit control points', () => {
+    it('uses the p10 and median points for the existing scoring curves', () => {
+      const expectedPoints = {
+        'bootup-time': [[1282, 3500]],
+        'mainthread-work-breakdown': [[2017, 4000]],
+        'total-byte-weight': [[2667 * 1024, 4000 * 1024]],
+        'uses-long-cache-ttl': [[28 * 1024, 128 * 1024]],
+        'dom-size': [[818, 1400]],
+        'cumulative-layout-shift': [[0.1, 0.25]],
+        'estimated-input-latency': [[58, 100]],
+        'first-contentful-paint-3g': [[3504, 6000]],
+        'first-contentful-paint': [[2336, 4000], [934, 1600]],
+        'first-cpu-idle': [[3572, 6500], [2468, 4500]],
+        'first-meaningful-paint': [[2336, 4000], [934, 1600]],
+        'interactive': [[3785, 7300], [2468, 4500]],
+        'largest-contentful-paint': [[2500, 4000]],
+        'max-potential-fid': [[130, 250]],
+        'speed-index': [[3387, 5800], [1311, 2300]],
+        'total-blocking-time': [[287, 600]],
+      };
+
+      for (const ScoredAudit of scoredAudits) {
+        const actualPoints = [];
+
+        function collectScoringPoints(value) {
+          if (!value || typeof value !== 'object') return;
+          if (Object.prototype.hasOwnProperty.call(value, 'scoring')) {
+            actualPoints.push([value.scoring.p10, value.scoring.median]);
+            for (const [key, child] of Object.entries(value)) {
+              if (key !== 'scoring') collectScoringPoints(child);
+            }
+            return;
+          }
+          if (Object.prototype.hasOwnProperty.call(value, 'median')) {
+            actualPoints.push([value.p10, value.median]);
+            return;
+          }
+          for (const child of Object.values(value)) collectScoringPoints(child);
+        }
+
+        collectScoringPoints(ScoredAudit.defaultOptions);
+        const expected = expectedPoints[ScoredAudit.meta.id];
+        assert.deepEqual(actualPoints.map(([, median]) => median).sort((a, b) => a - b),
+          expected.map(([, median]) => median).sort((a, b) => a - b));
+
+        for (const [p10, median] of actualPoints) {
+          assert(p10 > 0 && p10 < median);
+          assert.strictEqual(Audit.computeLogNormalScore({p10, median}, p10), 0.9);
+          assert.strictEqual(Audit.computeLogNormalScore({p10, median}, median), 0.5);
+
+          // The legacy control points were rounded to integers. Preserve their curves
+          // without requiring a migrated p10 to use that rounded representation.
+          const legacyP10 = expected.find(point => point[1] === median)[0];
+          assert(Math.abs(Audit.computeLogNormalScore({p10, median}, legacyP10) - 0.9) <= 0.01);
+        }
+      }
+    });
+  });
+
+  describe('#computeLogNormalScore', () => {
+    it('clamps the score to two decimal places', () => {
+      const params = {
+        median: 1000,
+        p10: 500,
+      };
+
+      assert.strictEqual(Audit.computeLogNormalScore(params, 0), 1);
+      assert.strictEqual(Audit.computeLogNormalScore(params, 250), 0.99);
+      assert.strictEqual(Audit.computeLogNormalScore(params, 1500), 0.23);
+      assert.strictEqual(Audit.computeLogNormalScore(params, 2500), 0.05);
+      assert.strictEqual(Audit.computeLogNormalScore(params, 4000), 0.01);
+      assert(statistics.getLogNormalScore(params, 4100) > 0);
+      assert.strictEqual(Audit.computeLogNormalScore(params, 4100), 0);
+    });
+  });
 });
