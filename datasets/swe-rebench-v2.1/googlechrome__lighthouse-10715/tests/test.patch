 'use strict';
 
 const Audit = require('../../audits/audit.js');
+const statistics = require('../../lib/statistics.js');
 const assert = require('assert').strict;
+const scoredAudits = [
+  require('../../audits/bootup-time.js'),
+  require('../../audits/mainthread-work-breakdown.js'),
+  require('../../audits/byte-efficiency/total-byte-weight.js'),
+  require('../../audits/byte-efficiency/uses-long-cache-ttl.js'),
+  require('../../audits/dobetterweb/dom-size.js'),
+  require('../../audits/metrics/cumulative-layout-shift.js'),
+  require('../../audits/metrics/estimated-input-latency.js'),
+  require('../../audits/metrics/first-contentful-paint-3g.js'),
+  require('../../audits/metrics/first-contentful-paint.js'),
+  require('../../audits/metrics/first-cpu-idle.js'),
+  require('../../audits/metrics/first-meaningful-paint.js'),
+  require('../../audits/metrics/interactive.js'),
+  require('../../audits/metrics/largest-contentful-paint.js'),
+  require('../../audits/metrics/max-potential-fid.js'),
+  require('../../audits/metrics/speed-index.js'),
