diff --git a/tests/integration/test_hug.py b/tests/integration/test_hug.py
new file mode 100644
index 0000000..411fee4
--- /dev/null
+++ b/tests/integration/test_hug.py
@@ -0,0 +1,117 @@
+# coding=utf-8
+"""
+Verify that Hug HTTP requests are recorded by Scout.
+"""
+from __future__ import absolute_import, division, print_function, unicode_literals
+
+from contextlib import contextmanager
+
+import pytest
+from webtest import TestApp
+
+from scout_apm.api import Config
+from scout_apm.compat import kwargs_only
+
+integrate_scout = None
+try:
+    import hug
+except ImportError:
+    hug = None
+else:
+    try:
+        from scout_apm.hug import integrate_scout
+    except ImportError:
+        pass
+
+
+if hug is not None:
+    # Hug doesn't (seem to) support individual apps, since they're automatically
+    # module scoped, so use a single module level app:
+
+    @hug.get("/")
+    def home():
+        return "Welcome home."
+
+    @hug.get("/versioned", versions=1)
+    def versioned_v1():
+        return "Version 1"
+
+    @hug.get("/versioned", versions=2)
+    def versioned_v2():
+        return "Version 2"
+
+
+skip_if_hug_unavailable = pytest.mark.skipif(hug is None, reason="Hug isn't available")
+pytestmark = [skip_if_hug_unavailable]
+
+scout_integrated = False
+
+
+@contextmanager
+@kwargs_only
+def app_with_scout(scout_config=None):
+    """
+    Context manager that yields the global Hug app with Scout configured.
+    """
+    global scout_integrated
+
+    if scout_config is None:
+        scout_config = {}
+
+    scout_config["core_agent_launch"] = False
+    scout_config.setdefault("monitor", True)
+    Config.set(**scout_config)
+
+    if not scout_integrated:
+        integrate_scout(__name__, config={})
+        scout_integrated = True
+
+    try:
+        # Hug attaches magic names to the current module when you use the @hug
+        # decorators, we're interested in the WSGI app:
+        yield __hug_wsgi__  # noqa: F821
+    finally:
+        Config.reset_all()
+
+
+def test_supplied_config_enables_monitoring(tracked_requests):
+    global scout_integrated
+
+    assert integrate_scout is not None
+
+    Config.set(monitor=False, core_agent_launch=False)
+    integrate_scout(
+        __name__, config={"monitor": True, "core_agent_launch": False}
+    )
+    scout_integrated = True
+
+    try:
+        TestApp(__hug_wsgi__).get("/")
+    finally:
+        Config.reset_all()
+
+    assert len(tracked_requests) == 1
+
+
+@pytest.mark.skipif(integrate_scout is None, reason="Hug integration is unavailable")
+def test_home(tracked_requests):
+    with app_with_scout() as app:
+        response = TestApp(app).get("/")
+
+    assert response.status_int == 200
+    assert response.text == '"Welcome home."'
+    assert len(tracked_requests) == 1
+    tracked_request = tracked_requests[0]
+    assert tracked_request.tags["path"] == "/"
+
+
+@pytest.mark.skipif(integrate_scout is None, reason="Hug integration is unavailable")
+def test_versioned_route_is_tracked(tracked_requests):
+    with app_with_scout() as app:
+        response = TestApp(app).get("/versioned", headers={"X-API-Version": "1"})
+
+    assert response.status_int == 200
+    assert response.text == "\"Version 1\""
+    assert len(tracked_requests) == 1
+    tracked_request = tracked_requests[0]
+    assert tracked_request.tags["path"] == "/versioned"
