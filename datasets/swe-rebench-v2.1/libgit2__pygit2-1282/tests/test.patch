diff --git a/test/test_remote.py b/test/test_remote.py
index 27b872c5..f7341c57 100644
--- a/test/test_remote.py
+++ b/test/test_remote.py
@@ -25,7 +25,10 @@
 
 """Tests for Remote objects."""
 
+import socket
+import subprocess
 import sys
+import time
 
 import pytest
 
@@ -356,3 +359,101 @@ def test_push_non_fast_forward_commits_to_remote_fails(origin, clone, remote):
 
     with pytest.raises(pygit2.GitError):
         remote.push(['refs/heads/master'])
+
+
+def test_push_options(origin, clone, tmp_path):
+    bare_path = tmp_path / 'push-options.git'
+    subprocess.run(
+        ['git', 'clone', '--bare', origin.path, str(bare_path)],
+        check=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+    subprocess.run(
+        [
+            'git',
+            '--git-dir=' + str(bare_path),
+            'config',
+            'receive.advertisePushOptions',
+            'true',
+        ],
+        check=True,
+    )
+
+    hook_output = tmp_path / 'received-options'
+    hook_script = (
+        '#!/bin/sh\n'
+        'printf "%s\\n" "$GIT_PUSH_OPTION_COUNT" >> "' + str(hook_output) + '"\n'
+        'if [ "$GIT_PUSH_OPTION_COUNT" -gt 0 ]; then\n'
+        '  printf "%s\\n" "$GIT_PUSH_OPTION_0" >> "' + str(hook_output) + '"\n'
+        'fi\n'
+        'if [ "$GIT_PUSH_OPTION_COUNT" -gt 1 ]; then\n'
+        '  printf "%s\\n" "$GIT_PUSH_OPTION_1" >> "' + str(hook_output) + '"\n'
+        'fi\n'
+    )
+    for hook_name in ('pre-receive', 'post-receive'):
+        hook = bare_path / 'hooks' / hook_name
+        hook.write_text(hook_script)
+        hook.chmod(0o755)
+
+    with socket.socket() as sock:
+        sock.bind(('127.0.0.1', 0))
+        port = sock.getsockname()[1]
+
+    daemon = subprocess.Popen(
+        [
+            'git',
+            'daemon',
+            '--reuseaddr',
+            '--base-path=' + str(tmp_path),
+            '--export-all',
+            '--enable=receive-pack',
+            '--listen=127.0.0.1',
+            '--port=' + str(port),
+        ],
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+    )
+    try:
+        for _ in range(50):
+            try:
+                with socket.create_connection(('127.0.0.1', port), timeout=0.1):
+                    break
+            except OSError:
+                time.sleep(0.1)
+        else:
+            pytest.fail('Git daemon did not start')
+
+        remote = clone.remotes.create(
+            'push-options', 'git://127.0.0.1:%d/push-options.git' % port
+        )
+        tip = clone[clone.head.target]
+        clone.create_commit(
+            'refs/heads/master',
+            tip.author,
+            tip.author,
+            'push without options',
+            tip.tree.id,
+            [tip.id],
+        )
+        remote.push(['refs/heads/master'], push_options=[])
+
+        tip = clone[clone.head.target]
+        clone.create_commit(
+            'refs/heads/master',
+            tip.author,
+            tip.author,
+            'push with options',
+            tip.tree.id,
+            [tip.id],
+        )
+        remote.push(
+            ['refs/heads/master'], push_options=['foo', 'Option A']
+        )
+    finally:
+        daemon.terminate()
+        daemon.wait(timeout=5)
+
+    assert hook_output.read_text() == (
+        '0\n0\n2\nfoo\nOption A\n2\nfoo\nOption A\n'
+    )
