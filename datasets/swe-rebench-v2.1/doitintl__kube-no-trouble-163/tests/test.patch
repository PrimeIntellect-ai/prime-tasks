+func TestIngressDeprecationsAndReplacement(t *testing.T) {
+	testCases := []struct {
+		name       string
+		manifest   string
+		kind       string
+		apiVersion string
+	}{
+		{
+			name: "Ingress networking beta",
+			manifest: `apiVersion: networking.k8s.io/v1beta1
+kind: Ingress
+metadata:
+  name: test-ingress
+`,
+			kind:       "Ingress",
+			apiVersion: "networking.k8s.io/v1beta1",
+		},
+		{
+			name: "Ingress extensions beta",
+			manifest: `apiVersion: extensions/v1beta1
+kind: Ingress
+metadata:
+  name: test-ingress
+`,
+			kind:       "Ingress",
+			apiVersion: "extensions/v1beta1",
+		},
+		{
+			name: "IngressClass networking beta",
+			manifest: `apiVersion: networking.k8s.io/v1beta1
+kind: IngressClass
+metadata:
+  name: test-class
+`,
+			kind:       "IngressClass",
+			apiVersion: "networking.k8s.io/v1beta1",
+		},
+	}
+
+	loadedRules, err := rules.FetchRegoRules([]schema.GroupVersionKind{})
+	if err != nil {
+		t.Fatalf("failed to load rules: %v", err)
+	}
+	apiJudge, err := judge.NewRegoJudge(&judge.RegoOpts{}, loadedRules)
+	if err != nil {
+		t.Fatalf("failed to create judge: %v", err)
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			var manifest map[string]interface{}
+			if err := yaml.Unmarshal([]byte(tc.manifest), &manifest); err != nil {
+				t.Fatalf("failed to parse manifest: %v", err)
+			}
+
+			results, err := apiJudge.Eval([]map[string]interface{}{manifest})
+			if err != nil {
+				t.Fatalf("failed to evaluate manifest: %v", err)
+			}
+			foundDeprecation := false
+			for _, result := range results {
+				if result.Kind == tc.kind && result.ApiVersion == tc.apiVersion && result.ReplaceWith == "networking.k8s.io/v1" {
+					foundDeprecation = true
+					break
+				}
+			}
+			if !foundDeprecation {
+				t.Errorf("expected a deprecation finding for kind %q and API version %q replaced by networking.k8s.io/v1; got %#v", tc.kind, tc.apiVersion, results)
+			}
+		})
+	}
+}
