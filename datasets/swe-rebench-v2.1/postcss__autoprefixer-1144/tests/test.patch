+  it('does not duplicate place-self grid alignment on reprocessing', () => {
+    let input = '.a { place-self: center; }'
+    let instance = autoprefixer({ browsers: 'ie 11', grid: true })
+    let once = postcss([instance]).process(input).css
+    let twice = postcss([instance]).process(once).css
+    expect(once.match(/-ms-grid-row-align/g).length).toBe(1)
+    expect(twice.match(/-ms-grid-row-align/g).length).toBe(1)
+    expect(twice.match(/-ms-grid-column-align/g).length).toBe(1)
+  })
