+
+describe('basepath case sensitivity during navigation', () => {
+  function createRouterWithBasepath(initialEntry: string) {
+    const rootRoute = createRootRoute({})
+    const indexRoute = createRoute({
+      getParentRoute: () => rootRoute,
+      path: '/',
+    })
+    const fooRoute = createRoute({
+      getParentRoute: () => rootRoute,
+      path: '/foo',
+    })
+    return createRouter({
+      routeTree: rootRoute.addChildren([indexRoute, fooRoute]),
+      basepath: '/App',
+      history: createMemoryHistory({ initialEntries: [initialEntry] }),
+    })
+  }
+
+  it('does not mangle the URL when navigating to a differently-cased basepath path', async () => {
+    const router = createRouterWithBasepath('/App')
+    await router.load()
+
+    await router.navigate({ to: '/app/foo' })
+    await router.invalidate()
+
+    expect(router.state.location.pathname.toLowerCase()).toBe('/app/foo')
+    expect(router.state.matches.map((match) => match.routeId)).toContain('/foo')
+  })
+})
