diff --git a/test/pages/releases.test.tsx b/test/pages/releases.test.tsx
new file mode 100644
index 0000000..7ba2328
--- /dev/null
+++ b/test/pages/releases.test.tsx
@@ -0,0 +1,78 @@
+import fs from 'fs';
+import path from 'path';
+import React from 'react';
+import { render, waitFor } from '@testing-library/react';
+import fetchMock from 'jest-fetch-mock';
+import '../__mocks__/intersectionObserverMock';
+import { createGeneralPageData } from '../__fixtures__/page';
+import ReleasesPage from '../../src/pages/releases';
+
+const mockData = createGeneralPageData();
+
+const releasesMarkdownPath = path.resolve(
+  __dirname,
+  '../../content/about/releases.md'
+);
+
+describe('Releases page', () => {
+  beforeEach(() => {
+    fetchMock.enableMocks();
+    fetchMock.mockResponse(
+      JSON.stringify({
+        v12: {
+          start: '2019-04-23',
+          end: '2099-04-30',
+          lts: '2019-10-21',
+          maintenance: '2020-11-30',
+          codename: 'Erbium',
+        },
+        v14: {
+          start: '2020-04-21',
+          end: '2099-04-30',
+          lts: '2020-10-27',
+          maintenance: '2021-10-19',
+          codename: 'Fermium',
+        },
+      })
+    );
+  });
+
+  afterEach(() => {
+    fetchMock.resetMocks();
+  });
+
+  it('is the page component for the /releases route', () => {
+    const pagePath = path.resolve(__dirname, '../../src/pages/releases.tsx');
+    expect(fs.existsSync(pagePath)).toBe(true);
+  });
+
+  it('uses the releases document as its content source', () => {
+    expect(fs.existsSync(releasesMarkdownPath)).toBe(true);
+
+    const releasesMarkdown = fs.readFileSync(releasesMarkdownPath, 'utf-8');
+
+    const frontmatter = releasesMarkdown.match(/^---\s*\n([\s\S]*?)\n---/);
+    const body = releasesMarkdown.replace(/^---[\s\S]*?---\s*/, '');
+
+    // The releases page must present the same content as the releases document.
+    expect(frontmatter).not.toBeNull();
+    expect(frontmatter?.[1]).toMatch(/^title:\s*['\"]?Releases['\"]?\s*$/m);
+    expect(body).toContain('Current');
+    expect(body).toContain('LTS');
+    expect(body).toContain('schedule.svg');
+  });
+
+  it('renders the releases document content', async () => {
+    const releasesMarkdown = fs.readFileSync(releasesMarkdownPath, 'utf-8');
+    const body = releasesMarkdown.replace(/^---[\s\S]*?---/, '').trim();
+
+    const data = createGeneralPageData();
+    data.data.page.html = body;
+
+    const { container } = render(<ReleasesPage data={data.data} />);
+
+    await waitFor(() => {
+      expect(container.textContent).toContain('Major Node.js versions enter');
+    });
+  });
+});
