+#[test]
+fn basic_workspace_root_package_exists() {
+    // First try with dependencies
+    let meta = MetadataCommand::new()
+        .manifest_path("tests/basic_workspace/Cargo.toml")
+        .exec()
+        .unwrap();
+    assert_eq!(meta.root_package().unwrap().name, "ex_bin");
+    // Now with no_deps, it should still work exactly the same
+    let meta = MetadataCommand::new()
+        .manifest_path("tests/basic_workspace/Cargo.toml")
+        .no_deps()
+        .exec()
+        .unwrap();
+    assert_eq!(
+        meta.root_package()
+            .expect("workspace root still exists when no_deps used")
+            .name,
+        "ex_bin"
+    );
+}
+
+#[test]
+fn basic_workspace_no_deps_includes_all_members() {
+    // With no_deps, cargo metadata reports the workspace members rather than
+    // only the root package, so every member must still be present.
+    let meta = MetadataCommand::new()
+        .manifest_path("tests/basic_workspace/Cargo.toml")
+        .no_deps()
+        .exec()
+        .unwrap();
+    let names: Vec<&str> = meta.packages.iter().map(|p| p.name.as_str()).collect();
+    assert!(
+        names.contains(&"ex_bin"),
+        "root package missing from no_deps metadata: {names:?}"
+    );
+    assert!(
+        names.contains(&"ex_lib"),
+        "workspace member missing from no_deps metadata: {names:?}"
+    );
+}
+
+#[test]
+fn root_package_none_without_root_package() {
+    // A virtual workspace has no root package: the workspace manifest is not
+    // itself a package, so no package can be identified as the root.
+    let json = r#"
+{
+  "packages": [
+    {
+      "name": "member",
+      "version": "0.1.0",
+      "id": "member 0.1.0 (path+file:///ws/member)",
+      "license": null,
+      "license_file": null,
+      "description": null,
+      "source": null,
+      "dependencies": [],
+      "targets": [
+        {
+          "kind": ["lib"],
+          "crate_types": ["lib"],
+          "name": "member",
+          "src_path": "/ws/member/src/lib.rs"
+        }
+      ],
+      "features": {},
+      "manifest_path": "/ws/member/Cargo.toml"
+    }
+  ],
+  "workspace_members": ["member 0.1.0 (path+file:///ws/member)"],
+  "resolve": null,
+  "target_directory": "/ws/target",
+  "version": 1,
+  "workspace_root": "/ws"
+}
+"#;
+    let meta: Metadata = serde_json::from_str(json).unwrap();
+    assert!(meta.root_package().is_none());
+}
