diff --git a/test/infer/test_mcmc.py b/test/infer/test_mcmc.py
index c938781..3f871aa 100644
--- a/test/infer/test_mcmc.py
+++ b/test/infer/test_mcmc.py
@@ -1208,3 +1208,18 @@ def test_extra_fields_include_unconstrained_samples():
     mcmc = MCMC(NUTS(model), num_warmup=10, num_samples=10)
     mcmc.run(random.PRNGKey(0), extra_fields=("z.x",))
     assert_allclose(mcmc.get_samples()["x"], jnp.exp(mcmc.get_extra_fields()["z.x"]))
+
+
+def test_all_deterministic():
+    expected_values = [1.0, jnp.array([1.0, 2.0])]
+
+    for value in expected_values:
+        def model():
+            numpyro.deterministic("x", value)
+
+        num_samples = 10
+        mcmc = MCMC(NUTS(model), num_warmup=10, num_samples=num_samples)
+        mcmc.run(random.PRNGKey(0))
+        samples = mcmc.get_samples()
+        assert samples["x"].shape == (num_samples,) + jnp.shape(value)
+        assert_allclose(samples["x"], jnp.broadcast_to(value, samples["x"].shape))
