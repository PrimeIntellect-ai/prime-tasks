+// mockAddService registers an AddService expectation that ignores the
+// proxy-protocol field, since the contract does not require the controller to
+// omit it when its annotation is absent.
+func mockAddService(fx *hcops.LoadBalancerOpsFixture, opts hcloud.LoadBalancerAddServiceOpts, lb *hcloud.LoadBalancer) *hcloud.Action {
+	action := &hcloud.Action{ID: rand.Int()}
+	fx.LBClient.On("AddService", fx.Ctx, lb, mock.MatchedBy(func(actual hcloud.LoadBalancerAddServiceOpts) bool {
+		opts.Proxyprotocol = nil
+		actual.Proxyprotocol = nil
+		return assert.ObjectsAreEqual(opts, actual)
+	})).Return(action, nil, nil)
+	return action
+}
+
+// mockUpdateService registers an UpdateService expectation that ignores the
+// proxy-protocol field, since the contract does not require the controller to
+// omit it when its annotation is absent.
+func mockUpdateService(fx *hcops.LoadBalancerOpsFixture, opts hcloud.LoadBalancerUpdateServiceOpts, lb *hcloud.LoadBalancer, listenPort int) *hcloud.Action {
+	action := &hcloud.Action{ID: rand.Int()}
+	fx.LBClient.On("UpdateService", fx.Ctx, lb, listenPort, mock.MatchedBy(func(actual hcloud.LoadBalancerUpdateServiceOpts) bool {
+		opts.Proxyprotocol = nil
+		actual.Proxyprotocol = nil
+		return assert.ObjectsAreEqual(opts, actual)
+	})).Return(action, nil, nil)
+	return action
+}
