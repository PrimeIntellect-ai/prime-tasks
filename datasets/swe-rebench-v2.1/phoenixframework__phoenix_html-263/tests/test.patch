+  describe "inputs_for/4" do
+    test "generate a new form builder for the given parameter" do
+      conn = conn()
+
+      form =
+          form_for(conn, "/", [as: :user], fn form ->
+            inputs_for(form, :company, fn company_form ->
+              text_input company_form, :name
+            end)
+          end)
+          |> safe_to_string()
+
+      assert form =~ ~s(<input name="_utf8" type="hidden" value="✓">)
+      assert form =~ ~s(<input id="user_company_name" name="user[company][name]" type="text">)
+    end
+
+    test "generate a new form builder with hidden inputs when they are present" do
+      parent = %Phoenix.HTML.Form{
+        source: :user,
+        impl: Phoenix.HTML.FormTest.HiddenFieldData,
+        id: "user",
+        name: "user"
+      }
+
+      form =
+        inputs_for(parent, :company, fn _company_form ->
+          "nested content"
+        end)
+        |> safe_to_string()
+
+      assert form =~ ~s(name="user[company][id]")
+      assert form =~ ~s(type="hidden")
+      assert form =~ ~s(value="1")
+      assert form =~ "nested content"
+    end
+
+    test "skip hidden inputs" do
+      parent = %Phoenix.HTML.Form{
+        source: :user,
+        impl: Phoenix.HTML.FormTest.HiddenFieldData,
+        id: "user",
+        name: "user"
+      }
+
+      form =
+        inputs_for(parent, :company, [skip_hidden: true], fn _company_form ->
+          "nested content"
+        end)
+        |> safe_to_string()
+
+      refute form =~ ~s(name="user[company][id]")
+      assert form =~ "nested content"
+    end
+  end
