+import re
+import subprocess
+import sys
+
+from persistent.list import PersistentList
+from persistent.mapping import PersistentMapping
+
+from ZODB import DB
+from ZODB.tests.util import TestCase
+
+
+class FsdumpFsstatsTests(TestCase):
+    def setUp(self):
+        super(FsdumpFsstatsTests, self).setUp()
+        # create storage ``data.fs`` with several transactions
+        # and objects of more than one class
+        db = DB("data.fs")
+        conn = db.open()
+        root = conn.root()
+        root["map"] = PersistentMapping()
+        root["list"] = PersistentList()
+        conn.transaction_manager.commit()
+        root["map"]["a"] = PersistentMapping(x=1)
+        root["list"].extend(range(50))
+        conn.transaction_manager.commit()
+        root["map"]["b"] = PersistentMapping(y="z" * 500)
+        root["list"].append("w" * 300)
+        conn.transaction_manager.commit()
+        conn.close()
+        db.close()
+
+    def run_module(self, module, *args):
+        result = subprocess.run(
+            [sys.executable, "-m", module, *args],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            universal_newlines=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        return result.stdout
+
+    def dump(self):
+        return self.run_module("ZODB.FileStorage.fsdump", "data.fs")
+
+    def transactions(self, dump):
+        return [line for line in dump.splitlines()
+                if line.startswith("Trans ")]
+
+    def data_records(self, dump):
+        return [line for line in dump.splitlines()
+                if line.startswith("  data")]
+
+    def section(self, stats, title, following):
+        # text of the report titled ``title`` up to the next report
+        text = stats.split(title + "\n", 1)[1]
+        return text.split(following, 1)[0]
+
+    def test_fsdump(self):
+        dump = self.dump()
+        transactions = self.transactions(dump)
+        self.assertGreaterEqual(len(transactions), 3)
+        for transaction in transactions:
+            self.assertRegex(transaction, r"\bsize=\d+")
+
+        records = self.data_records(dump)
+        self.assertGreaterEqual(len(records), 3)
+        for record in records:
+            self.assertRegex(record, r"\boid=[0-9a-f]+ size=\d+ class=\S+")
+        classes = {re.search(r"class=(\S+)", r).group(1) for r in records}
+        self.assertIn("persistent.mapping.PersistentMapping", classes)
+        self.assertIn("persistent.list.PersistentList", classes)
+
+    def test_fsstats_transaction_sizes(self):
+        dump = self.dump()
+        with open("data.dmp", "w") as f:
+            f.write(dump)
+        stats = self.run_module("ZODB.scripts.fsstats", "data.dmp")
+
+        sizes = [int(re.search(r"\bsize=(\d+)", transaction).group(1))
+                 for transaction in self.transactions(dump)]
+        self.assertGreaterEqual(len(sizes), 3)
+
+        summary = re.search(r"Summary: (\d+) txns", stats)
+        self.assertIsNotNone(summary)
+        self.assertEqual(int(summary.group(1)), len(sizes))
+
+        report = self.section(stats, "Transaction size (bytes)",
+                              "Transaction size (objects)")
+        total = int(re.search(r"Total\s+(\d+)", report).group(1))
+        self.assertEqual(total, len(sizes))
+        maximum = int(re.search(r"Max\s+(\d+)", report).group(1))
+        self.assertEqual(maximum, max(sizes))
+        mean = float(re.search(r"Mean\s+([\d.]+)", report).group(1))
+        self.assertAlmostEqual(mean, sum(sizes) / len(sizes), places=2)
+
+    def test_fsstats_object_sizes(self):
+        dump = self.dump()
+        with open("data.dmp", "w") as f:
+            f.write(dump)
+        stats = self.run_module("ZODB.scripts.fsstats", "data.dmp")
+
+        sizes = []
+        counts = {}
+        for record in self.data_records(dump):
+            match = re.search(r"\boid=[0-9a-f]+ size=(\d+) class=(\S+)",
+                              record)
+            sizes.append(int(match.group(1)))
+            counts[match.group(2)] = counts.get(match.group(2), 0) + 1
+        self.assertGreaterEqual(len(sizes), 3)
+        self.assertEqual(len(counts), 2)
+
+        report = self.section(stats, "Object size", "Number of revisions")
+        total = int(re.search(r"Total\s+(\d+)", report).group(1))
+        self.assertEqual(total, len(sizes))
+        maximum = int(re.search(r"Max\s+(\d+)", report).group(1))
+        self.assertEqual(maximum, max(sizes))
+
+        # per-class summary: number of objects for each class
+        for klass, count in counts.items():
+            row = re.search(
+                r"^\s*(\d+)\s+\S+\s+\S+\s+\S+\s+" + re.escape(klass) +
+                r"\s*$", stats, re.M)
+            self.assertIsNotNone(row, klass)
+            self.assertEqual(int(row.group(1)), count)
