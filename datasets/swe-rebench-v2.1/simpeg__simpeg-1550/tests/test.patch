+"""
+Test ``spectral_ip_mappings`` function.
+"""
+
+import pytest
+import numpy as np
+
+import discretize
+from simpeg.electromagnetics.static.spectral_induced_polarization import (
+    spectral_ip_mappings,
+)
+
+
+class TestActiveCells:
+    """Test deprecated ``indActive`` argument ``spectral_ip_mappings``."""
+
+
+    @pytest.fixture
+    def mesh(self):
+        """Sample mesh."""
+        return discretize.TensorMesh([10, 10, 10], "CCN")
+
+    @pytest.fixture
+    def active_cells(self, mesh):
+        """Sample active cells for the mesh."""
+        active_cells = np.ones(mesh.n_cells, dtype=bool)
+        active_cells[0] = False
+        return active_cells
+
+    def test_active_cells_used_in_mappings(self, mesh, active_cells):
+        """
+        Test that ``active_cells`` is used to build the returned mappings.
+        """
+        eta_map, tau_map, c_map, wires = spectral_ip_mappings(
+            mesh,
+            active_cells=active_cells,
+            inactive_eta=2.0,
+            inactive_tau=3.0,
+            inactive_c=4.0,
+        )
+        n_active = int(active_cells.sum())
+        # the mappings are built for the active cells only
+        assert eta_map.shape == (mesh.n_cells, 3 * n_active)
+        assert tau_map.shape == (mesh.n_cells, 3 * n_active)
+        assert c_map.shape == (mesh.n_cells, 3 * n_active)
+
+        model = np.zeros(3 * n_active)
+        eta = eta_map * model
+        tau = tau_map * model
+        c = c_map * model
+        assert eta.shape == (mesh.n_cells,)
+        assert tau.shape == (mesh.n_cells,)
+        assert c.shape == (mesh.n_cells,)
+
+        # inactive cells are filled with the requested inactive values
+        assert np.allclose(eta[~active_cells], 2.0)
+        assert np.allclose(tau[~active_cells], 3.0)
+        assert np.allclose(c[~active_cells], 4.0)
+        # active cells are filled with exp(model) = 1
+        assert np.allclose(eta[active_cells], 1.0)
+        assert np.allclose(tau[active_cells], 1.0)
+        assert np.allclose(c[active_cells], 1.0)
