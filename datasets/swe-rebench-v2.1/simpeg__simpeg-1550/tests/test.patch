+"""
+Test functions in ``static_utils``.
+"""
+
+import numpy as np
+
+import discretize
+from simpeg import maps
+from simpeg.electromagnetics.static.utils.static_utils import drapeTopotoLoc
+
+
+def test_active_cells_used_for_draping():
+    """
+    Test that ``active_cells`` defines the surface used to drape points.
+    """
+    mesh = discretize.TensorMesh([np.ones(5), np.ones(5)], origin=[0, 0])
+    active_cells = np.ones(mesh.n_cells, dtype=bool)
+    active_cells = active_cells.reshape(
+        (mesh.vnC[0], mesh.vnC[1]), order="F"
+    ).copy()
+    # lower the surface for the first column of cells
+    active_cells[0, 3:] = False
+    active_cells = active_cells.reshape(-1, order="F")
+
+    pts = np.array([[0.5, 0.5], [2.5, 0.5], [4.5, 0.5]])
+    draped = drapeTopotoLoc(mesh, pts, active_cells=active_cells)
+
+    assert draped.shape == (3, 2)
+    # the draped vertical coordinate follows the surface defined by the mask
+    assert np.isclose(draped[0, 1], 3.0)
+    assert np.isclose(draped[1, 1], 5.0)
+    assert np.isclose(draped[2, 1], 5.0)
+
+
+def test_active_cells_keyword_in_other_public_mapping():
+    """The active-cell name is consistent in public mapping APIs."""
+    mesh = discretize.TensorMesh([np.ones(4), np.ones(3)])
+    active_cells = np.ones(mesh.n_cells, dtype=bool)
+    active_cells[::3] = False
+
+    mapping = maps.ParametricPolyMap(
+        mesh,
+        order=0,
+        logSigma=False,
+        normal="Y",
+        active_cells=active_cells,
+    )
+    mapped_values = mapping * np.array([1.0, 2.0, 1.5])
+
+    assert mapped_values.shape == (int(active_cells.sum()),)
