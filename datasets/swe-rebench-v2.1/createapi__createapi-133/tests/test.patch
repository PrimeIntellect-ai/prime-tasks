+    func testRenamedBooleanPropertyWithoutSwiftyPrefixWhenDisabled() throws {
+        let spec = """
+        openapi: 3.0.0
+        info:
+          title: Rename boolean property
+          version: 1.0.0
+        paths: {}
+        components:
+          schemas:
+            Pet:
+              type: object
+              properties:
+                enabled:
+                  type: boolean
+        """
+        let configuration = """
+        useSwiftyPropertyNames: false
+        rename:
+          properties:
+            Pet.enabled: something_else
+        """
+        let specURL = URL(fileURLWithPath: temp.path(for: "rename-boolean.yml"))
+        let configurationURL = URL(fileURLWithPath: temp.path(for: "rename-boolean-config.yml"))
+        let outputURL = URL(fileURLWithPath: temp.path(for: "rename-boolean-output"))
+        try Data(spec.utf8).write(to: specURL)
+        try Data(configuration.utf8).write(to: configurationURL)
+
+        try generate([
+            "--module", "RenameBoolean",
+            "--output", outputURL.path,
+            "--config", configurationURL.path,
+            specURL.path
+        ])
+
+        let generatedEntity = try String(contentsOf: outputURL.appendingPathComponent("Entities/Pet.swift"), encoding: .utf8)
+        XCTAssertTrue(generatedEntity.contains("somethingElse"))
+        XCTAssertFalse(generatedEntity.contains("isSomethingElse"))
+    }
