+package com.alibaba.fescar.discovery.loadbalance;
+
+import org.testng.Assert;
+import org.testng.annotations.DataProvider;
+import org.testng.annotations.Test;
+import org.testng.collections.Lists;
+
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+import java.lang.reflect.ParameterizedType;
+import java.lang.reflect.Type;
+import java.lang.reflect.TypeVariable;
+import java.net.InetSocketAddress;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+
+public class LoadBalanceTest {
+
+    @Test
+    public void testPublicApi() throws Exception {
+        Assert.assertTrue(Modifier.isPublic(LoadBalance.class.getModifiers()));
+        Assert.assertTrue(Modifier.isPublic(RandomLoadBalance.class.getModifiers()));
+        Assert.assertTrue(Modifier.isPublic(RoundRobinLoadBalance.class.getModifiers()));
+
+        Method select = LoadBalance.class.getMethod("select", List.class);
+        Assert.assertTrue(Modifier.isPublic(select.getModifiers()));
+        TypeVariable<Method>[] typeParameters = select.getTypeParameters();
+        Assert.assertEquals(typeParameters.length, 1);
+        Assert.assertEquals(select.getGenericReturnType(), typeParameters[0]);
+        Type genericParameter = select.getGenericParameterTypes()[0];
+        Assert.assertTrue(genericParameter instanceof ParameterizedType);
+        ParameterizedType listParameter = (ParameterizedType)genericParameter;
+        Assert.assertEquals(listParameter.getRawType(), List.class);
+        Assert.assertEquals(listParameter.getActualTypeArguments()[0], typeParameters[0]);
+        Assert.assertTrue(containsException(select.getExceptionTypes(), Exception.class));
+
+        Method factory = LoadBalanceFactory.class.getMethod("getInstance");
+        Assert.assertTrue(Modifier.isPublic(factory.getModifiers()));
+        Assert.assertTrue(Modifier.isStatic(factory.getModifiers()));
+    }
+
+    @Test(dataProvider = "addressProvider")
+    public void testRandomLoadBalance_select(List<InetSocketAddress> addresses) throws Exception {
+        RandomLoadBalance loadBalance = new RandomLoadBalance();
+        for (int i = 0; i < 1000; i++) {
+            InetSocketAddress selected = loadBalance.select(addresses);
+            Assert.assertTrue(addresses.contains(selected), "selection must come from the supplied addresses");
+        }
+    }
+
+    @Test(dataProvider = "addressProvider")
+    public void testRoundRobinLoadBalance_select(List<InetSocketAddress> addresses) {
+        int runs = 10000;
+        Map<InetSocketAddress, AtomicLong> counter = getSelectedCounter(runs, addresses, new RoundRobinLoadBalance());
+        for (InetSocketAddress address : counter.keySet()) {
+            Long count = counter.get(address).get();
+            Assert.assertTrue(Math.abs(count - runs / (0f + addresses.size())) < 1f, "selection counts should be balanced");
+        }
+    }
+
+    @Test
+    public void testRoundRobinLoadBalance_preservesListOrder() throws Exception {
+        List<String> values = Arrays.asList("first", "second", "third", "fourth", "fifth");
+        RoundRobinLoadBalance loadBalance = new RoundRobinLoadBalance();
+        int firstIndex = values.indexOf(loadBalance.select(values));
+        Assert.assertTrue(firstIndex >= 0, "selection must come from the supplied values");
+        for (int i = 1; i < values.size() * 3; i++) {
+            String selected = loadBalance.select(values);
+            Assert.assertEquals(selected, values.get((firstIndex + i) % values.size()));
+        }
+    }
+
+    @Test
+    public void testStrategiesSelectFromSuppliedList() throws Exception {
+        List<String> singleton = Arrays.asList("only value");
+        Assert.assertEquals(new RandomLoadBalance().select(singleton), "only value");
+        Assert.assertEquals(new RoundRobinLoadBalance().select(singleton), "only value");
+        Assert.assertTrue(singleton.contains(LoadBalanceFactory.getInstance().select(singleton)));
+
+        List<String> multipleValues = Arrays.asList("alpha", "beta", "gamma");
+        Assert.assertTrue(multipleValues.contains(new RandomLoadBalance().select(multipleValues)));
+        Assert.assertTrue(multipleValues.contains(new RoundRobinLoadBalance().select(multipleValues)));
+    }
+
+    @Test
+    public void testLoadBalanceFactory_getInstance() throws Exception {
+        LoadBalance loadBalance = LoadBalanceFactory.getInstance();
+        Assert.assertNotNull(loadBalance, "LoadBalanceFactory.getInstance() should return a LoadBalance");
+        List<InetSocketAddress> addresses = Lists.newArrayList();
+        addresses.add(new InetSocketAddress("127.0.0.1", 8091));
+        addresses.add(new InetSocketAddress("127.0.0.1", 8092));
+        InetSocketAddress selected = loadBalance.select(addresses);
+        Assert.assertTrue(addresses.contains(selected), "selected address should be one of the provided addresses");
+    }
+
+    public Map<InetSocketAddress, AtomicLong> getSelectedCounter(int runs, List<InetSocketAddress> addresses, LoadBalance loadBalance) {
+        Assert.assertNotNull(loadBalance);
+        Map<InetSocketAddress, AtomicLong> counter = new ConcurrentHashMap<>();
+        for (InetSocketAddress address : addresses) {
+            counter.put(address, new AtomicLong(0));
+        }
+        try {
+            for (int i = 0; i < runs; i++) {
+                InetSocketAddress selectAddress = loadBalance.select(addresses);
+                counter.get(selectAddress).incrementAndGet();
+            }
+        } catch (Exception e) {
+            // Preserve the historical aggregate assertion behavior.
+        }
+        return counter;
+    }
+
+    private boolean containsException(Class<?>[] exceptions, Class<?> expected) {
+        for (Class<?> exception : exceptions) {
+            if (expected.isAssignableFrom(exception)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    @DataProvider
+    public static Object[][] addressProvider() {
+        List<InetSocketAddress> addresses = Lists.newArrayList();
+        addresses.add(new InetSocketAddress("127.0.0.1", 8091));
+        addresses.add(new InetSocketAddress("127.0.0.1", 8092));
+        addresses.add(new InetSocketAddress("127.0.0.1", 8093));
+        addresses.add(new InetSocketAddress("127.0.0.1", 8094));
+        addresses.add(new InetSocketAddress("127.0.0.1", 8095));
+        return new Object[][] {{addresses}};
+    }
+}
