+    public function testItCanMapArrayFromString(): void
+    {
+        // Arrange
+        $mapper = (new JsonMapperFactory())->bestFit();
+        $object = new SimpleObject();
+        $json = '[{"name": "one"}, {"name": "two"}]';
+
+        // Act
+        $result = $this->mapJsonString($mapper, 'mapArrayFromString', $json, $object);
+
+        // Assert
+        self::assertContainsOnly(SimpleObject::class, $result);
+        self::assertSame('one', $result[0]->getName());
+        self::assertSame('two', $result[1]->getName());
+    }
+
+    public function testItClonesThePrototypeForEachArrayElementWhenMappingArrayFromString(): void
+    {
+        // Arrange
+        $mapper = (new JsonMapperFactory())->bestFit();
+        $prototype = new Popo();
+        $prototype->date = new \DateTimeImmutable('2020-01-01');
+        $json = '[{"name": "one"}, {"name": "two"}]';
+
+        // Act
+        $result = $this->mapJsonString($mapper, 'mapArrayFromString', $json, $prototype);
+
+        // Assert
+        self::assertCount(2, $result);
+        self::assertSame('one', $result[0]->name);
+        self::assertSame('two', $result[1]->name);
+        self::assertEquals($prototype->date, $result[0]->date);
+        self::assertEquals($prototype->date, $result[1]->date);
+    }
+
+    private function mapJsonString(JsonMapperInterface $mapper, string $method, string $json, object $prototype)
+    {
+        $parameters = (new \ReflectionMethod($mapper, $method))->getParameters();
+        $firstParameterType = $parameters[0]->getType()->getName();
+        $arguments = $firstParameterType === 'object' ? [$prototype, $json] : [$json, $prototype];
+
+        return $mapper->{$method}(...$arguments);
+    }
