+// parameterIgnore checks the public field without coupling this test to a
+// particular JSON encoding implementation.
+func parameterIgnore(t *testing.T, parameter types.Parameter) bool {
+	t.Helper()
+	field, found := reflect.TypeOf(parameter).FieldByName("Ignore")
+	if !assert.True(t, found, "Parameter must expose Ignore") {
+		return false
+	}
+	if !assert.Equal(t, reflect.Bool, field.Type.Kind(), "Parameter.Ignore must be boolean") {
+		return false
+	}
+	return reflect.ValueOf(parameter).FieldByIndex(field.Index).Bool()
 }
