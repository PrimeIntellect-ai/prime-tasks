+// TestGetParameterIgnoreHiddenFromReference verifies that a parameter marked
+// with the "+ignore" annotation is omitted from the user-facing reference
+// output, while ordinary parameters are still shown.
+func TestGetParameterIgnoreHiddenFromReference(t *testing.T) {
+	template := `
+parameter: {
+// +usage=Which image would you like to use for your service
+// +short=i
+image: string
+
+// +ignore
+// +usage=If addRevisionLabel is true, the appRevision label will be added to the underlying pods
+addRevisionLabel: *false | bool
+}
+`
+	capability := types.Capability{
+		Name:        "ignore-annotation-test",
+		Type:        types.TypeWorkload,
+		Category:    types.CUECategory,
+		CueTemplate: template,
+	}
+
+	dir, err := ioutil.TempDir("", "vela-ignore-test")
+	assert.NoError(t, err)
+	defer os.RemoveAll(dir)
+
+	ref := &plugins.MarkdownReference{}
+	err = ref.CreateMarkdown(context.Background(), []types.Capability{capability}, dir, plugins.ReferenceSourcePath)
+	assert.NoError(t, err)
+
+	content, err := ioutil.ReadFile(filepath.Join(dir, plugins.WorkloadTypePath, "ignore-annotation-test.md"))
+	assert.NoError(t, err)
+	assert.Contains(t, string(content), "image")
+	assert.NotContains(t, string(content), "addRevisionLabel")
+}
+
+// TestGetParameterIgnoreHiddenFromNestedReference verifies ignored fields are
+// omitted even when they are nested in a structured CUE parameter.
+func TestGetParameterIgnoreHiddenFromNestedReference(t *testing.T) {
+	template := `
+parameter: {
+	image: string
+	settings: {
+		visible: string
+		credentials: {
+			name: string
+			// +ignore
+			secretKey: string
+		}
+	}
+}
+`
+	capability := types.Capability{
+		Name:        "nested-ignore-annotation-test",
+		Type:        types.TypeWorkload,
+		Category:    types.CUECategory,
+		CueTemplate: template,
+	}
+
+	dir, err := ioutil.TempDir("", "vela-nested-ignore-test")
+	assert.NoError(t, err)
+	defer os.RemoveAll(dir)
+
+	ref := &plugins.MarkdownReference{}
+	err = ref.CreateMarkdown(context.Background(), []types.Capability{capability}, dir, plugins.ReferenceSourcePath)
+	assert.NoError(t, err)
+
+	content, err := ioutil.ReadFile(filepath.Join(dir, plugins.WorkloadTypePath, "nested-ignore-annotation-test.md"))
+	assert.NoError(t, err)
+	assert.Contains(t, string(content), "image")
+	assert.Contains(t, string(content), "visible")
+	assert.NotContains(t, string(content), "secretKey")
+}
