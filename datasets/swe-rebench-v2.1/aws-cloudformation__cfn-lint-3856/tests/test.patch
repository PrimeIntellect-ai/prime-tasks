+def test_find_in_map_sub_account_id_reproduction_has_no_e1011():
+    template = """%YAML 1.2
+---
+AWSTemplateFormatVersion: 2010-09-09
+Mappings:
+  BucketMap:
+    BucketGroup:
+      234567890123AccountBucketName: Bucket
+Transform: AWS::LanguageExtensions
+Resources:
+  Resource:
+    Type: AWS::S3::Bucket
+    Properties:
+      BucketName: !FindInMap
+        - BucketMap
+        - BucketGroup
+        - !Sub ${AWS::AccountId}AccountBucketName
+"""
+
+    matches = lint(s=template, regions=["us-east-2"])
+
+    assert not any(match.rule.id == "E1011" for match in matches)
