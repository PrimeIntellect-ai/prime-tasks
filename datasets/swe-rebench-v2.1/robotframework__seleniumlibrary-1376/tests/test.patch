+class OpenBrowserAliasTests(unittest.TestCase):
+
+    def setUp(self):
+        self.sl = SeleniumLibrary()
+
+    def tearDown(self):
+        unstub()
+
+    def test_same_alias_reuses_browser(self):
+        browser = mock()
+        when(webdriver).Chrome(options=None).thenReturn(browser)
+        first = self.sl.open_browser('http://example.com/1', 'chrome', alias='alias')
+        second = self.sl.open_browser('http://example.com/2', 'chrome', alias='alias')
+        self.assertEqual(first, second)
+        verify(browser, times=1).get('http://example.com/1')
+        verify(browser, times=1).get('http://example.com/2')
+
+    def test_same_alias_reuses_browser_when_browser_changes(self):
+        chrome = mock()
+        firefox = mock()
+        when(webdriver).Chrome(options=None).thenReturn(chrome)
+        when(webdriver).Firefox(options=None).thenReturn(firefox)
+        first = self.sl.open_browser('http://example.com/1', 'chrome', alias='alias')
+        second = self.sl.open_browser('http://example.com/2', 'firefox', alias='alias')
+        self.assertEqual(first, second)
+        verify(chrome, times=1).get('http://example.com/2')
+
+    def test_different_alias_opens_new_browser(self):
+        browser = mock()
+        when(webdriver).Chrome(options=None).thenReturn(browser)
+        first = self.sl.open_browser('http://example.com', 'chrome', alias='alias1')
+        second = self.sl.open_browser('http://example.com', 'chrome', alias='alias2')
+        self.assertNotEqual(first, second)
+
+    def test_no_alias_opens_new_browser(self):
+        browser = mock()
+        when(webdriver).Chrome(options=None).thenReturn(browser)
+        first = self.sl.open_browser('http://example.com', 'chrome')
+        second = self.sl.open_browser('http://example.com', 'chrome')
+        self.assertNotEqual(first, second)
+
+    def test_none_like_alias_opens_new_browser(self):
+        browser = mock()
+        when(webdriver).Chrome(options=None).thenReturn(browser)
+        for alias in (None, 'None', 'none', 'NONE'):
+            first = self.sl.open_browser('http://example.com/1', 'chrome', alias=alias)
+            second = self.sl.open_browser('http://example.com/2', 'chrome', alias=alias)
+            self.assertNotEqual(first, second)
