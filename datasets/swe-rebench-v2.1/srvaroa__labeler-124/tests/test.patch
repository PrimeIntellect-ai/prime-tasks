+func TestAuthorCanMergeInvalidValue(t *testing.T) {
+	config := LabelerConfigV1{
+		Version: 1,
+		Labels: []LabelMatcher{
+			{
+				Label:          "Test",
+				AuthorCanMerge: "not-a-bool",
+			},
+		},
+	}
+
+	for _, payloadName := range []string{"create_pr", "create_pr_non_owner"} {
+		payload, err := loadPayload(payloadName)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		var applied []string
+		l := Labeler{
+			FetchRepoConfig: func() (*LabelerConfigV1, error) {
+				return &config, nil
+			},
+			GetCurrentLabels: func(target *Target) ([]string, error) {
+				return []string{}, nil
+			},
+			ReplaceLabels: func(target *Target, labels []string) error {
+				applied = labels
+				return nil
+			},
+			Client: &FakeHttpClient{},
+			GitHubFacade: &GitHubFacade{
+				GetRawDiff: func(owner, repo string, prNumber int) (string, error) {
+					return "", nil
+				},
+			},
+		}
+
+		err = l.HandleEvent("pull_request", &payload)
+		if err != nil {
+			// A valid implementation may report the malformed value as an error.
+			continue
+		}
+		if len(applied) != 0 {
+			t.Fatalf("%s: an invalid author-can-merge value must not match any PR, got labels %v",
+				payloadName, applied)
+		}
+	}
+}
