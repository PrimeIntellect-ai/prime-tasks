+def test_compute_estimator_features_names_for_generated_features(X_y_binary):
+    _, y = X_y_binary
+    X = pd.DataFrame({"when": pd.date_range("2020-01-01", periods=len(y), freq="h")})
+
+    class DateFeaturizedPipeline(BinaryClassificationPipeline):
+        component_graph = ["DateTime Featurization Component", "Standard Scaler", "Logistic Regression Classifier"]
+
+    pipeline = DateFeaturizedPipeline({
+        "DateTime Featurization Component": {"features_to_extract": ["year", "hour"]},
+    })
+    pipeline.fit(X, y)
+
+    transformed = pipeline.compute_estimator_features(X)
+
+    assert set(transformed.columns) == {"when_year", "when_hour"}
