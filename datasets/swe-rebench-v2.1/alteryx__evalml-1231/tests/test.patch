+def test_compute_estimator_features(X_y_binary):
+    X, y = X_y_binary
+    X = pd.DataFrame(X)
+    X.iloc[0, 0] = np.nan
+
+    class PreprocessingPipeline(BinaryClassificationPipeline):
+        component_graph = ['Imputer', 'Standard Scaler', 'Logistic Regression Classifier']
+
+    pipeline = PreprocessingPipeline({})
+    pipeline.fit(X, y)
+
+    X_t = pipeline.compute_estimator_features(X)
+
+    # The result is a DataFrame of the preprocessed features, not the estimator output.
+    assert isinstance(X_t, pd.DataFrame)
+    assert X_t.shape == X.shape
+    # Column names are preserved by the preprocessing components.
+    assert list(X_t.columns) == list(X.columns)
+    # The preprocessing components were applied: missing values were imputed ...
+    assert not X_t.isnull().any().any()
+    # ... and the features were standardized.
+    np.testing.assert_allclose(X_t.mean().values, np.zeros(X_t.shape[1]), atol=1e-6)
+    np.testing.assert_allclose(X_t.std(ddof=0).values, np.ones(X_t.shape[1]), atol=1e-6)
+
+
+def test_compute_estimator_features_non_dataframe_input(X_y_binary):
+    X, y = X_y_binary
+
+    class PreprocessingPipeline(BinaryClassificationPipeline):
+        component_graph = ['Imputer', 'Standard Scaler', 'Logistic Regression Classifier']
+
+    pipeline = PreprocessingPipeline({})
+    pipeline.fit(X, y)
+
+    # X is a numpy array here, not a DataFrame.
+    X_t = pipeline.compute_estimator_features(X)
+
+    assert isinstance(X_t, pd.DataFrame)
+    assert X_t.shape[0] == X.shape[0]
+
