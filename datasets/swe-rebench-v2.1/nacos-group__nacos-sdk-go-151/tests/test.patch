+package nacos_server
+
+import (
+	"net/http"
+	"testing"
+
+	"github.com/golang/mock/gomock"
+	"github.com/nacos-group/nacos-sdk-go/common/constant"
+	"github.com/nacos-group/nacos-sdk-go/common/http_agent"
+	"github.com/nacos-group/nacos-sdk-go/mock"
+	"github.com/stretchr/testify/assert"
+)
+
+func requestConfigWithServer(t *testing.T, serverCfg constant.ServerConfig, expectedURL string) {
+	controller := gomock.NewController(t)
+	defer controller.Finish()
+
+	mockHttpAgent := mock.NewMockIHttpAgent(controller)
+	clientCfg := constant.ClientConfig{TimeoutMs: 10000}
+	server, err := NewNacosServer([]constant.ServerConfig{serverCfg}, clientCfg, mockHttpAgent, clientCfg.TimeoutMs, "")
+	assert.Nil(t, err)
+
+	mockHttpAgent.EXPECT().Request(gomock.Eq(http.MethodGet),
+		gomock.Eq(expectedURL),
+		gomock.Any(),
+		gomock.Any(),
+		gomock.Any(),
+	).Times(1).Return(http_agent.FakeHttpResponse(200, "content"), nil)
+
+	content, err := server.ReqConfigApi("/v1/cs/configs", map[string]string{}, map[string]string{}, http.MethodGet, clientCfg.TimeoutMs)
+	assert.Nil(t, err)
+	assert.Equal(t, "content", content)
+}
+
+func Test_ConfigRequestUsesConfiguredScheme(t *testing.T) {
+	requestConfigWithServer(t, constant.ServerConfig{
+		ContextPath: "/nacos",
+		Port:        80,
+		IpAddr:      "console.nacos.io",
+		Scheme:      "https",
+	}, "https://console.nacos.io:80/nacos/v1/cs/configs")
+
+	requestConfigWithServer(t, constant.ServerConfig{
+		ContextPath: "/nacos",
+		Port:        80,
+		IpAddr:      "console.nacos.io",
+		Scheme:      "http",
+	}, "http://console.nacos.io:80/nacos/v1/cs/configs")
+}
+
+func Test_ConfigRequestKeepsSchemeGivenInIpAddr(t *testing.T) {
+	requestConfigWithServer(t, constant.ServerConfig{
+		ContextPath: "/nacos",
+		Port:        80,
+		IpAddr:      "http://console.nacos.io",
+	}, "http://console.nacos.io:80/nacos/v1/cs/configs")
+
+	requestConfigWithServer(t, constant.ServerConfig{
+		ContextPath: "/nacos",
+		Port:        80,
+		IpAddr:      "https://console.nacos.io",
+	}, "https://console.nacos.io:80/nacos/v1/cs/configs")
+}
