diff --git a/test/ecto/query_test.exs b/test/ecto/query_test.exs
index 3f71812d..33352dd9 100644
--- a/test/ecto/query_test.exs
+++ b/test/ecto/query_test.exs
@@ -1,5 +1,19 @@
 Code.require_file "../support/eval_helpers.exs", __DIR__
 
+# The Postgres SQL connection module is only compiled when Postgrex is available
+# at compile time. Load it here so the SQL translation of macro-generated
+# predicates can be asserted.
+unless Code.ensure_loaded?(Ecto.Adapters.Postgres.Connection) do
+  build = Mix.Project.build_path()
+
+  for app <- ~w(postgrex db_connection connection decimal) do
+    Code.append_path(Path.join([build, "lib", app, "ebin"]))
+  end
+
+  Code.compile_file("lib/ecto/adapters/postgres/datetime.ex")
+  Code.compile_file("lib/ecto/adapters/postgres/connection.ex")
+end
+
 defmodule Ecto.QueryTest do
   use ExUnit.Case, async: true
 
@@ -32,6 +46,63 @@ defmodule Ecto.QueryTest do
       from(p in "posts", select: [macro_map(^key)])
     end
 
+    defmacrop macrotest(x), do: quote(do: is_nil(unquote(x)) or unquote(x) == "A")
+    defmacrop deeper_macrotest(x), do: quote(do: macrotest(unquote(x)) or unquote(x) == "B")
+    defmacrop macro_and_test(x), do: quote(do: unquote(x) != "I" and unquote(x) == "A")
+    defmacrop deeper_and_macrotest(x), do: quote(do: macro_and_test(unquote(x)) or unquote(x) == "B")
+
+    test "allows macro in where" do
+      query = from(p in "posts", where: p.title == "C" or macrotest(p.title), select: p.title)
+      sql = postgres_sql(query)
+
+      assert sql =~ ~r/\"title\"\s*=\s*'C'/
+      assert sql =~ "OR"
+      assert sql =~ ~r/\"title\"\s+IS NULL/
+      assert sql =~ ~r/\"title\"\s*=\s*'A'/
+
+      query = from(p in "posts", where: p.title == "C" or deeper_macrotest(p.title), select: p.title)
+      sql = postgres_sql(query)
+
+      assert sql =~ "OR"
+      assert sql =~ ~r/\"title\"\s+IS NULL/
+      assert sql =~ ~r/\"title\"\s*=\s*'A'/
+      assert sql =~ ~r/\"title\"\s*=\s*'B'/
+
+      query = from(p in "posts", where: macro_and_test(p.title), select: p.title)
+      sql = postgres_sql(query)
+
+      assert sql =~ "AND"
+      assert sql =~ ~r/\"title\"\s*!=\s*'I'/
+      assert sql =~ ~r/\"title\"\s*=\s*'A'/
+
+      query = from(p in "posts", where: deeper_and_macrotest(p.title), select: p.title)
+      sql = postgres_sql(query)
+
+      assert sql =~ "AND"
+      assert sql =~ "OR"
+      assert sql =~ ~r/\"title\"\s*!=\s*'I'/
+      assert sql =~ ~r/\"title\"\s*=\s*'A'/
+      assert sql =~ ~r/\"title\"\s*=\s*'B'/
+    end
+
+    test "allows a macro-generated predicate in a join condition" do
+      query =
+        from(p in "posts",
+          join: c in "comments",
+          on: p.title == c.title and macrotest(c.title),
+          select: p.title
+        )
+
+      sql = postgres_sql(query)
+
+      assert sql =~ "JOIN"
+      assert sql =~ ~r/\"title\"\s*=\s*\w+\.\"title\"/
+      assert sql =~ "AND"
+      assert sql =~ "OR"
+      assert sql =~ ~r/\"title\"\s+IS NULL/
+      assert sql =~ ~r/\"title\"\s*=\s*'A'/
+    end
+
     test "does not allow nils in comparison at compile time" do
       assert_raise Ecto.Query.CompileError,
                    ~r"comparison with nil is forbidden as it is unsafe", fn ->
@@ -356,4 +427,11 @@ defmodule Ecto.QueryTest do
              ~s[#Ecto.Query<from p in \"posts\", where: fragment("héllò")>]
     end
   end
+
+  defp postgres_sql(query) do
+    {query, _params, _key} = Ecto.Query.Planner.prepare(query, :all, Ecto.Adapters.Postgres, 0)
+    {query, _} = Ecto.Query.Planner.normalize(query, :all, Ecto.Adapters.Postgres, 0)
+    query |> Ecto.Adapters.Postgres.Connection.all() |> IO.iodata_to_binary()
+  end
+
 end
