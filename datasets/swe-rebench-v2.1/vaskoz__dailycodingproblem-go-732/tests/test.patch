+package day313
+
+import "testing"
+
+// nolint
+var testcases = []struct {
+	start, target [3]int
+	deadEnds      [][3]int
+	expected      int
+}{
+	{
+		[3]int{0, 0, 0},
+		[3]int{7, 1, 9},
+		[][3]int{{1, 1, 1}},
+		5,
+	},
+	{
+		[3]int{0, 0, 0},
+		[3]int{0, 0, 0},
+		[][3]int{{1, 1, 1}},
+		0,
+	},
+	{
+		[3]int{0, 0, 0},
+		[3]int{5, 5, 5},
+		[][3]int{{1, 0, 0}, {0, 1, 0}, {9, 0, 0}, {0, 9, 0}, {0, 0, 1}, {0, 0, 9}},
+		-1,
+	},
+	{
+		[3]int{0, 0, 0},
+		[3]int{5, 5, 5},
+		[][3]int{{0, 1, 0}, {9, 0, 0}, {0, 9, 0}, {0, 0, 1}, {0, 0, 9}},
+		15,
+	},
+}
+
+func TestMovesToUnlock(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range testcases {
+		result := MovesToUnlock(tc.start, tc.target, tc.deadEnds)
+		if tc.expected < 0 {
+			if result >= 0 {
+				t.Errorf("Expected an impossible result (negative), got %v", result)
+			}
+			continue
+		}
+		if result != tc.expected {
+			t.Errorf("Expected %v, got %v", tc.expected, result)
+		}
+	}
+}
+
+func TestMovesToUnlockDeadEndTargetIsImpossible(t *testing.T) {
+	t.Parallel()
+
+	start := [3]int{0, 0, 0}
+	target := [3]int{0, 0, 1}
+	deadEnds := [][3]int{target}
+	if result := MovesToUnlock(start, target, deadEnds); result >= 0 {
+		t.Errorf("Expected an impossible result (negative) for a dead-end target, got %v", result)
+	}
+}
+
+func TestMovesToUnlockUsesSuppliedStart(t *testing.T) {
+	t.Parallel()
+
+	start := [3]int{4, 5, 6}
+	target := [3]int{4, 5, 7}
+	if got := MovesToUnlock(start, target, nil); got != 1 {
+		t.Errorf("MovesToUnlock(%v, %v, nil) = %d, want 1", start, target, got)
+	}
+}
+
+func TestMovesToUnlockFindsLongerSafeRouteAroundInteriorDeadEnd(t *testing.T) {
+	t.Parallel()
+
+	start := [3]int{0, 0, 0}
+	target := [3]int{0, 2, 0}
+	deadEnds := [][3]int{{0, 1, 0}}
+	if got := MovesToUnlock(start, target, deadEnds); got != 4 {
+		t.Errorf("MovesToUnlock(%v, %v, %v) = %d, want 4", start, target, deadEnds, got)
+	}
+}
