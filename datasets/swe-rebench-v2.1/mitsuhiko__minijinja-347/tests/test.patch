+
+#[test]
+fn test_int_div_overflow() {
+    let env = Environment::new();
+    let err = env
+        .render_str("{{ a // b }}", context! { a => i128::MIN, b => -1i128 })
+        .unwrap_err();
+    assert_eq!(err.kind(), ErrorKind::InvalidOperation);
+    assert_eq!(
+        err.detail(),
+        Some("unable to calculate -170141183460469231731687303715884105728 // -1")
+    );
+}
