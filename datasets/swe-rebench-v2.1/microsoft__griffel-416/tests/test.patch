+import { Linter } from 'eslint';
+import * as fs from 'fs';
+import * as path from 'path';
+
+import plugin = require('../index');
+
+const exportedRules = Object.entries((plugin as any).rules) as Array<[string, any]>;
+const parser = '@typescript-eslint/parser';
+
+function lintWithExportedRule(code: string, filename = 'input.ts') {
+  return exportedRules.map(([ruleName, rule]) => {
+    const linter = new Linter();
+    linter.defineParser(parser, require('@typescript-eslint/parser'));
+    linter.defineRule(ruleName, rule);
+    const config = {
+      parser,
+      parserOptions: { ecmaVersion: 2018 as const, sourceType: 'module' as const, jsx: true },
+      rules: { [ruleName]: 'error' as const },
+    };
+
+    return {
+      ruleName,
+      linter,
+      config,
+      diagnostics: linter.verify(code, config, filename),
+      fixed: linter.verifyAndFix(code, config, filename),
+    };
+  });
+}
+
+describe('exported pseudo-element naming behavior', () => {
+  it.each([
+    {
+      name: 'before',
+      code: "import { makeStyles } from '@griffel/react'; const styles = makeStyles({ root: { ':before': {} } });",
+      fixedProperty: '::before',
+    },
+    {
+      name: 'after',
+      code: "import { makeStyles } from '@griffel/react'; const styles = makeStyles({ root: { ':after': {} } });",
+      fixedProperty: '::after',
+    },
+    {
+      name: 'nested before',
+      code: "import { makeStyles } from '@griffel/react'; const styles = makeStyles({ root: { ':hover': { ':before': {} } } });",
+      fixedProperty: '::before',
+    },
+  ])('reports and fixes $name through an exported rule', ({ code, fixedProperty }) => {
+    const matchingRule = lintWithExportedRule(code).find(
+      candidate =>
+        candidate.diagnostics.length > 0 &&
+        candidate.fixed.output.includes(fixedProperty) &&
+        !/(^|[^:]):(?:before|after)\b/.test(candidate.fixed.output),
+    );
+
+    expect(matchingRule).toBeDefined();
+  });
+
+  it('accepts valid pseudo-elements and pseudo-element slot names', () => {
+    const code = `
+import { makeStyles } from '@griffel/react';
+makeStyles({
+  root: { '::before': {}, '::after': {} },
+  ':before': { color: 'red' },
+  ':after': { color: 'blue' },
+});
+`;
+    const matchingRule = lintWithExportedRule(
+      "import { makeStyles } from '@griffel/react'; makeStyles({ root: { ':before': {} } });",
+    ).find(candidate => candidate.fixed.output.includes('::before'));
+
+    expect(matchingRule).toBeDefined();
+    expect(matchingRule!.linter.verify(code, matchingRule!.config)).toHaveLength(0);
+  });
+
+  it('can audit and autofix legacy pseudo-element selectors in an existing style', () => {
+    const filename = path.resolve('packages/devtools/src/SlotCSSRules.tsx');
+    const source = fs.readFileSync(filename, 'utf8');
+    const matchingRule = lintWithExportedRule(source, filename).find(
+      candidate =>
+        candidate.diagnostics.length > 0 &&
+        candidate.fixed.output !== source &&
+        !/(^|[^:]):(?:before|after)\b/.test(candidate.fixed.output),
+    );
+
+    const auditedStyle = matchingRule ? matchingRule.fixed.output : source;
+
+    expect(auditedStyle).not.toMatch(/(^|[^:]):(?:before|after)\b/);
+    if (matchingRule) {
+      expect(matchingRule.fixed.messages).toHaveLength(0);
+    }
+  });
+});
