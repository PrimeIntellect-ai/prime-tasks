+import unittest
+
+try:
+    from unittest.mock import patch, MagicMock
+except ImportError:
+    from mock import patch, MagicMock
+
+from streamlink import Streamlink
+
+
+class TestPluginYouNow(unittest.TestCase):
+    def test_api_request_uses_https_endpoint(self):
+        session = Streamlink()
+        plugin = session.resolve_url("http://younow.com/someuser")
+
+        # an empty (offline) API response is enough to observe the request URL
+        response = MagicMock()
+        response.encoding = "utf-8"
+        response.text = "{}"
+
+        with patch.object(session.http, "get", return_value=response) as mock_get:
+            plugin.streams()
+
+        self.assertTrue(mock_get.called)
+        requested_url = mock_get.call_args[0][0]
+        self.assertEqual(
+            requested_url,
+            "https://api.younow.com/php/api/broadcast/info/curId=0/user=someuser")
