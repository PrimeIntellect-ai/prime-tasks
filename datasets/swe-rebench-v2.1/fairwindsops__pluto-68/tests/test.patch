+				return
+			}
+
+			if format == "yaml" {
+				var versions []Version
+				assert.NoError(t, yaml.Unmarshal(out, &versions))
+				assert.NotEmpty(t, versions)
+				assert.Contains(t, versions, Version{"apps/v1", "Deployment", "", "", ""})
