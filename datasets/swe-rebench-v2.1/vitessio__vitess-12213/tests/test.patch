+
+func TestDeregisterDialerRemovesRegisteredProtocol(t *testing.T) {
+	const protocol = "test3"
+
+	RegisterDialer(protocol, func(context.Context, string) (Impl, error) {
+		return nil, nil
+	})
+
+	DeregisterDialer(protocol)
+
+	_, err := DialProtocol(context.Background(), protocol, "")
+	if err == nil || err.Error() != "no dialer registered for VTGate protocol "+protocol {
+		t.Fatalf("protocol: %s is not registered, should return error: %v", protocol, err)
+	}
+}
+
+func TestDeregisterDialerUnknownNameLeavesOtherProtocolsAvailable(t *testing.T) {
+	const unknown = "test4-unknown"
+	const other = "test4-other"
+
+	// Deregistering a name that was never registered must not panic.
+	DeregisterDialer(unknown)
+
+	RegisterDialer(other, func(context.Context, string) (Impl, error) {
+		return nil, nil
+	})
+	defer DeregisterDialer(other)
+
+	// Deregistering an unknown name must not affect other registered dialers.
+	DeregisterDialer(unknown)
+
+	c, err := DialProtocol(context.Background(), other, "")
+	if err != nil || c == nil {
+		t.Fatalf("deregistering an unknown protocol must not affect other dialers: %v %v", err, c)
+	}
+}
