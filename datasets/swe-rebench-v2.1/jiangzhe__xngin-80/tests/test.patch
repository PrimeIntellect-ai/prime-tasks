+/// Simple estimator with presettings based on query set.
+/// The join kind, condition and filter predicates are all ignored.
+#[derive(Debug, Default, Clone)]
+struct PresetEstimator {
+    // rows per query
+    qmap: HashMap<VertexSet, f64>,
+    // selectivity per join
+    jmap: HashMap<(VertexSet, VertexSet), f64>,
+}
+
+impl PresetEstimator {
+    fn add_qry(&mut self, vset: VertexSet, count: f64) {
+        self.qmap.insert(vset, count);
+    }
+
+    fn add_join(&mut self, l_vset: VertexSet, r_vset: VertexSet, sel: f64) {
+        self.jmap.insert((l_vset, r_vset), sel);
+        self.jmap.insert((r_vset, l_vset), sel);
+    }
+}
+
+impl Estimate for PresetEstimator {
+    fn estimated_qry_rows(&mut self, vset: VertexSet) -> Result<f64> {
+        self.qmap
+            .get(&vset)
+            .cloned()
+            .ok_or(Error::InvalidJoinVertexSet)
+    }
+
+    fn estimated_join_rows(
+        &mut self,
+        _kind: JoinKind,
+        l_vset: VertexSet,
+        r_vset: VertexSet,
+        e_vset: VertexSet,
+        _cond: &[xngin_expr::Expr],
+        _filt: &[xngin_expr::Expr],
+    ) -> Result<f64> {
+        match (
+            self.qmap.get(&l_vset).cloned(),
+            self.qmap.get(&r_vset).cloned(),
+        ) {
+            (Some(l_rows), Some(r_rows)) => {
+                if let Some(sel) = self.jmap.get(&(e_vset & l_vset, e_vset & r_vset)).cloned() {
+                    let rows = l_rows * r_rows * sel;
+                    self.qmap.insert(l_vset | r_vset, rows);
+                    Ok(rows)
+                } else {
+                    Err(Error::InvalidJoinVertexSet)
+                }
+            }
+            _ => Err(Error::InvalidJoinVertexSet),
+        }
+    }
+}
+
+fn build_preset_estimator(
+    qry_set: &mut QuerySet,
+    graph: &JoinGraph,
+    tbl_map: &HashMap<&'static str, TableID>,
+    qry_rows: &[(&'static str, f64)],
+    join_sels: &[(&'static str, &'static str, f64)],
+) -> PresetEstimator {
+    let mut name2vset: HashMap<&'static str, VertexSet> = HashMap::new();
+    for vid in graph.vertexes {
+        let qid = graph.vmap.get(&vid).cloned().unwrap();
+        let tbl_id = get_tbl_id(qry_set, qid).unwrap();
+        for (tn, tid) in tbl_map.iter() {
+            if *tid == tbl_id {
+                let mut vs = VertexSet::default();
+                vs |= vid;
+                name2vset.insert(*tn, vs);
+            }
+        }
+    }
+    let mut est = PresetEstimator::default();
+    for (tn, rows) in qry_rows {
+        if let Some(vs) = name2vset.get(tn) {
+            est.add_qry(*vs, *rows);
+        }
+    }
+    for (l, r, sel) in join_sels {
+        let lv = *name2vset.get(l).unwrap();
+        let rv = *name2vset.get(r).unwrap();
+        est.add_join(lv, rv, *sel);
+    }
+    est
+}
+
+fn collect_tbl_ids(op: &Op, qry_set: &QuerySet, out: &mut Vec<TableID>) {
+    match op {
+        Op::Table(_, id) => out.push(*id),
+        Op::Query(qid) => {
+            if let Some(subq) = qry_set.get(qid) {
+                collect_tbl_ids(&subq.root, qry_set, out);
+            }
+        }
+        Op::Join(j) => match j.as_ref() {
+            Join::Cross(jos) => {
+                for jo in jos {
+                    collect_tbl_ids(jo.as_ref(), qry_set, out);
+                }
+            }
+            Join::Qualified(q) => {
+                collect_tbl_ids(q.left.as_ref(), qry_set, out);
+                collect_tbl_ids(q.right.as_ref(), qry_set, out);
+            }
+        },
+        Op::Proj(p) => collect_tbl_ids(&p.source, qry_set, out),
+        Op::Filt(f) => collect_tbl_ids(&f.source, qry_set, out),
+        _ => {}
+    }
+}
+
+fn root_join_sides(op: &Op, qry_set: &QuerySet) -> Option<(Vec<TableID>, Vec<TableID>)> {
+    match op {
+        Op::Proj(p) => root_join_sides(&p.source, qry_set),
+        Op::Filt(f) => root_join_sides(&f.source, qry_set),
+        Op::Query(qid) => qry_set
+            .get(qid)
+            .and_then(|subq| root_join_sides(&subq.root, qry_set)),
+        Op::Join(j) => match j.as_ref() {
+            Join::Qualified(q) => {
+                let mut l = vec![];
+                collect_tbl_ids(q.left.as_ref(), qry_set, &mut l);
+                let mut r = vec![];
+                collect_tbl_ids(q.right.as_ref(), qry_set, &mut r);
+                Some((l, r))
+            }
+            _ => None,
+        },
+        _ => None,
+    }
+}
+
+fn tbl_name(tbl_map: &HashMap<&'static str, TableID>, id: TableID) -> &'static str {
+    for (tn, tid) in tbl_map.iter() {
+        if *tid == id {
+            return tn;
+        }
+    }
+    panic!("table id not found")
+}
