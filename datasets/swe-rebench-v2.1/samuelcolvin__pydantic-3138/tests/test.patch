+def test_inherited_subscripted_frozendict_field_metadata_is_inspectable():
+    class Parent(BaseModel):
+        value: frozendict[str, int]
+
+    class Child(Parent):
+        pass
+
+    field = Child.__fields__['value']
+    assert field.outer_type_.__origin__ is frozendict
+    assert field.outer_type_.__args__ == (str, int)
+    repr(Child.__fields__)
