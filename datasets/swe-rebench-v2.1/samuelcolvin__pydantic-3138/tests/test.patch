+@pytest.mark.skipif(sys.version_info < (3, 9), reason='built-in generic aliases need 3.9')
+def test_subscripted_frozendict_retains_type():
+    class Model(BaseModel):
+        value: frozendict[str, int]
+
+    model = Model(value=frozendict({'answer': '42'}))
+    assert isinstance(model.value, frozendict)
+    assert model.value == {'answer': 42}
