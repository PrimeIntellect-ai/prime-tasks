+      assignedCodeRule.value = new FshCode('bright', 'Visible|1.2.3');
+      brightInstance.rules.push(assignedCodeRule);
+      doc.instances.set(brightInstance.name, brightInstance);
+
+      const visibleSystem = new FshCodeSystem('Visible');
