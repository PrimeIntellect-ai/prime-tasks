+    )
+    def test_plugins_apis_usgs_query_by_id(
+        self,
+        mock_dataset_filters,
+        mock_api_download_options,
+        mock_api_scene_search,
+        mock_api_logout,
+        mock_api_login,
+    ):
+        """UsgsApi.query by id must search using usgs api"""
+
+        search_kwargs = {
+            "productType": "LANDSAT_C2L1",
+            "id": "SOME_PRODUCT_ID",
+            "prep": PreparedSearch(
+                items_per_page=1,
+                page=1,
+            ),
+        }
+        unrelated_scene = self.SCENE_SEARCH_RETURN["data"]["results"][0]
+        matching_scene = {**unrelated_scene, "displayId": search_kwargs["id"]}
+
+        def scene_search_response(*args, **kwargs):
+            # The service returns the requested scene only when the search
+            # request carries the ID; otherwise it returns an unrelated scene.
+            scene = (
+                matching_scene
+                if search_kwargs["id"] in repr((args, kwargs))
+                else unrelated_scene
+            )
+            return {
+                **self.SCENE_SEARCH_RETURN,
+                "data": {
+                    **self.SCENE_SEARCH_RETURN["data"],
+                    "results": [scene],
+                },
+            }
+
+        mock_api_scene_search.side_effect = scene_search_response
+        search_results, _ = self.api_plugin.query(**search_kwargs)
+
+        # Search results identify the requested product, not an unrelated scene.
+        self.assertEqual(len(search_results), 1)
+        self.assertEqual(search_results[0].properties["id"], search_kwargs["id"])
+        self.assertEqual(search_results[0].provider, "usgs")
+        self.assertEqual(search_results[0].product_type, "LANDSAT_C2L1")
+
+        # With one result per page, a full 139-page catalog walk would take
+        # at least as many requests as catalog hits; trying other filters is OK.
+        self.assertLess(
+            len(mock_api_scene_search.call_args_list),
+            self.SCENE_SEARCH_RETURN["data"]["totalHits"],
+        )
+
