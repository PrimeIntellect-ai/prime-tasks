+
+func TestEqualLoadBalancerRulePropertiesFormat(t *testing.T) {
+	var enableTCPReset, disableTCPReset *bool = to.BoolPtr(true), to.BoolPtr(false)
+	var frontPort, backendPort *int32 = to.Int32Ptr(80), to.Int32Ptr(8080)
+	var idleTimeout, otherIdleTimeout *int32 = to.Int32Ptr(4), to.Int32Ptr(5)
+
+	testcases := []struct {
+		desc     string
+		s        *network.LoadBalancingRulePropertiesFormat
+		t        *network.LoadBalancingRulePropertiesFormat
+		wantLb   bool
+		expected bool
+	}{
+		{
+			desc: "TCP rules with the same EnableTCPReset are equal",
+			s: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:       network.TransportProtocolTCP,
+				EnableTCPReset: enableTCPReset,
+				FrontendPort:   frontPort,
+			},
+			t: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:       network.TransportProtocolTCP,
+				EnableTCPReset: enableTCPReset,
+				FrontendPort:   frontPort,
+			},
+			wantLb:   true,
+			expected: true,
+		},
+		{
+			desc: "TCP rules with different EnableTCPReset are not equal",
+			s: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:       network.TransportProtocolTCP,
+				EnableTCPReset: enableTCPReset,
+				FrontendPort:   frontPort,
+			},
+			t: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:       network.TransportProtocolTCP,
+				EnableTCPReset: disableTCPReset,
+				FrontendPort:   frontPort,
+			},
+			wantLb:   true,
+			expected: false,
+		},
+		{
+			desc: "non-TCP rules ignore EnableTCPReset",
+			s: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:       network.TransportProtocolUDP,
+				EnableTCPReset: disableTCPReset,
+				FrontendPort:   frontPort,
+			},
+			t: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:       network.TransportProtocolUDP,
+				EnableTCPReset: enableTCPReset,
+				FrontendPort:   frontPort,
+			},
+			wantLb:   true,
+			expected: true,
+		},
+		{
+			desc: "different protocols are not equal",
+			s: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:     network.TransportProtocolTCP,
+				FrontendPort: frontPort,
+			},
+			t: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:     network.TransportProtocolUDP,
+				FrontendPort: frontPort,
+			},
+			wantLb:   true,
+			expected: false,
+		},
+		{
+			desc: "different frontend IP configurations are not equal",
+			s: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:                network.TransportProtocolTCP,
+				FrontendIPConfiguration: &network.SubResource{ID: to.StringPtr("fip-1")},
+				FrontendPort:            frontPort,
+			},
+			t: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:                network.TransportProtocolTCP,
+				FrontendIPConfiguration: &network.SubResource{ID: to.StringPtr("fip-2")},
+				FrontendPort:            frontPort,
+			},
+			wantLb:   true,
+			expected: false,
+		},
+		{
+			desc: "different backend address pools are not equal",
+			s: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:           network.TransportProtocolTCP,
+				BackendAddressPool: &network.SubResource{ID: to.StringPtr("pool-1")},
+				FrontendPort:       frontPort,
+			},
+			t: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:           network.TransportProtocolTCP,
+				BackendAddressPool: &network.SubResource{ID: to.StringPtr("pool-2")},
+				FrontendPort:       frontPort,
+			},
+			wantLb:   true,
+			expected: false,
+		},
+		{
+			desc: "different load distributions are not equal",
+			s: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:         network.TransportProtocolTCP,
+				LoadDistribution: network.LoadDistributionDefault,
+				FrontendPort:     frontPort,
+			},
+			t: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:         network.TransportProtocolTCP,
+				LoadDistribution: network.LoadDistributionSourceIP,
+				FrontendPort:     frontPort,
+			},
+			wantLb:   true,
+			expected: false,
+		},
+		{
+			desc: "different frontend ports are not equal",
+			s: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:     network.TransportProtocolTCP,
+				FrontendPort: frontPort,
+			},
+			t: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:     network.TransportProtocolTCP,
+				FrontendPort: to.Int32Ptr(81),
+			},
+			wantLb:   true,
+			expected: false,
+		},
+		{
+			desc: "different backend ports are not equal",
+			s: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:    network.TransportProtocolTCP,
+				BackendPort: backendPort,
+			},
+			t: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:    network.TransportProtocolTCP,
+				BackendPort: to.Int32Ptr(9090),
+			},
+			wantLb:   true,
+			expected: false,
+		},
+		{
+			desc: "different floating IP settings are not equal",
+			s: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:         network.TransportProtocolTCP,
+				EnableFloatingIP: to.BoolPtr(true),
+			},
+			t: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:         network.TransportProtocolTCP,
+				EnableFloatingIP: to.BoolPtr(false),
+			},
+			wantLb:   true,
+			expected: false,
+		},
+		{
+			desc: "different outbound SNAT settings are not equal",
+			s: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:            network.TransportProtocolTCP,
+				DisableOutboundSnat: to.BoolPtr(true),
+			},
+			t: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:            network.TransportProtocolTCP,
+				DisableOutboundSnat: to.BoolPtr(false),
+			},
+			wantLb:   true,
+			expected: false,
+		},
+		{
+			desc: "different idle timeouts are not equal when wantLb is true",
+			s: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:             network.TransportProtocolTCP,
+				IdleTimeoutInMinutes: idleTimeout,
+			},
+			t: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:             network.TransportProtocolTCP,
+				IdleTimeoutInMinutes: otherIdleTimeout,
+			},
+			wantLb:   true,
+			expected: false,
+		},
+		{
+			desc: "different idle timeouts are ignored when wantLb is false",
+			s: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:             network.TransportProtocolTCP,
+				IdleTimeoutInMinutes: idleTimeout,
+			},
+			t: &network.LoadBalancingRulePropertiesFormat{
+				Protocol:             network.TransportProtocolTCP,
+				IdleTimeoutInMinutes: otherIdleTimeout,
+			},
+			wantLb:   false,
+			expected: true,
+		},
+	}
+
+	for _, tc := range testcases {
+		assert.Equal(t, tc.expected, equalLoadBalancingRulePropertiesFormat(tc.s, tc.t, tc.wantLb), tc.desc)
+	}
+}
