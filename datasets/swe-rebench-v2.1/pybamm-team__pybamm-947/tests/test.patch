+    def test_discretise_model(self):
+        # Make sure a 0D model is automatically discretised
+        model = pybamm.BaseModel()
+        v = pybamm.Variable("v")
+        model.rhs = {v: -1}
+        model.initial_conditions = {v: 1}
+
+        solver = pybamm.ScipySolver()
+        t_eval = np.linspace(0, 1, 11)
+        solution = solver.solve(model, t_eval)
+        # dv/dt = -1 with v(0) = 1 gives v(t) = 1 - t
+        np.testing.assert_allclose(solution.y[0], 1 - t_eval, rtol=1e-5, atol=1e-6)
+
+    def test_setup_already_discretised_model(self):
+        model = pybamm.BaseModel()
+        variable = pybamm.Variable(
+            "v", domain=["negative electrode", "separator", "positive electrode"]
+        )
+        model.rhs = {variable: -variable}
+        model.initial_conditions = {variable: 1}
+
+        mesh = get_mesh_for_testing()
+        discretisation = pybamm.Discretisation(
+            mesh, {"macroscale": pybamm.FiniteVolume()}
+        )
+        discretisation.process_model(model)
+
+        pybamm.BaseSolver().set_up(model, {})
