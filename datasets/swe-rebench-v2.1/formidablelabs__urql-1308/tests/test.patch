+// This regression is exercised through React so that the cursor update passes
+// through the Suspense-enabled query source used by application renders.
+
+it('keeps the updated relay page across Suspense development renders', async () => {
+  const Pagination = gql`
+    query($cursor: String) {
+      items(last: 1, before: $cursor) {
+        edges {
+          node {
+            id
+          }
+        }
+      }
+    }
+  `;
+
+  const fetchExchange: Exchange = () => operations$ =>
+    pipe(
+      operations$,
+      filter(operation => operation.kind === 'query'),
+      delay(0),
+      map((operation: Operation) => ({
+        operation,
+        data: {
+          __typename: 'Query',
+          items: {
+            __typename: 'ItemsConnection',
+            edges: [
+              {
+                __typename: 'ItemEdge',
+                node: {
+                  __typename: 'Item',
+                  id: operation.variables.cursor ? 'updated' : 'original',
+                },
+              },
+            ],
+          },
+        },
+      }))
+    );
+  const client = createClient({
+    url: 'http://localhost',
+    exchanges: [
+      cacheExchange({
+        resolvers: { Query: { items: relayPagination() } },
+      }),
+      fetchExchange,
+    ],
+    suspense: true,
+  });
+
+  let changeCursor: (() => void) | undefined;
+  const rendered: string[] = [];
+  const List = () => {
+    const [cursor, setCursor] = useState<string | null>(null);
+    changeCursor = () => setCursor('next-page');
+    const [{ data }] = useQuery({ query: Pagination, variables: { cursor } });
+    if (data) rendered.push(data.items.edges[0].node.id);
+    return React.createElement('div', null, data && data.items.edges[0].node.id);
+  };
+  const app = renderer.create(
+    React.createElement(
+      (React as any).StrictMode,
+      null,
+      React.createElement(
+        Provider,
+        { value: client },
+        React.createElement(
+          (React as any).Suspense,
+          { fallback: React.createElement('div', null, 'loading') },
+          React.createElement(List)
+        )
+      )
+    )
+  );
+
+  await act(async () => {
+    await new Promise(resolve => setTimeout(resolve, 10));
+  });
+  expect(app.root.findByType('div').children).toContain('original');
+
+  const firstUpdatedRender = rendered.length;
+  await act(async () => {
+    changeCursor!();
+    await new Promise(resolve => setTimeout(resolve, 10));
+  });
+
+  const updatedRenders = rendered.slice(firstUpdatedRender);
+  expect(
+    updatedRenders.filter(id => id === 'updated').length
+  ).toBeGreaterThanOrEqual(2);
+  const firstUpdated = updatedRenders.indexOf('updated');
+  expect(updatedRenders.slice(firstUpdated)).not.toContain('original');
+  app.unmount();
+});
