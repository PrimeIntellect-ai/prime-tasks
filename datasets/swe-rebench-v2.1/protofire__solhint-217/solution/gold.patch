+  /**
+   * Traverses the tree up and checks `predicate` in each node.
+   *
+   * @returns {boolean}
+   */
+  someParent(node, predicate) {
+    let parent = node.parent
+    while (parent) {
+      if (predicate(parent)) {
+        return true
+      }
+      parent = parent.parent
+    }
+
+    return false
+  }
