@@ -159,3 +163,36 @@ class TestDirectives(BaseCliTestCase):
     def test_templates(self):
         '''Test ignoring certain rules'''
         self.run_scenarios()
+
+    def test_capitalization_error_suggests_correct_property(self):
+        """A capitalization typo identifies the correctly cased property."""
+        template = """Resources:
+  TransformFunction:
+    Type: AWS::Lambda::Function
+    Properties:
+      Code:
+        Zipfile: |
+          exports.handler = async () => {};
+      Handler: index.handler
+      Role: arn:aws:iam::123456789012:role/example
+      Runtime: nodejs18.x
+"""
+        with tempfile.NamedTemporaryFile(mode='w', suffix='.yaml') as template_file:
+            template_file.write(template)
+            template_file.flush()
+            result = subprocess.run(
+                ['cfn-lint', '--format', 'json', '--', template_file.name],
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                universal_newlines=True,
+                check=False,
+            )
+
+        matches = json.loads(result.stdout)
+        property_errors = [match for match in matches if match['Rule']['Id'] == 'E3002']
+        self.assertTrue(any(
+            match['Location']['Path'] == [
+                'Resources', 'TransformFunction', 'Properties', 'Code', 'Zipfile'
+            ] and 'ZipFile' in match['Message']
+            for match in property_errors
+        ))
