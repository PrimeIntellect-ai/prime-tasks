+;; version/version-stable?
+
+
+(def params-version-stable?
+  [["1.7.0" true "Release only"]
+   ["1.7.0.post1" true "Post release"]
+   ["1.7.0.a1" false "Pre release"]
+   ["1.7.0.dev12" false "Dev version"]])
+
+(deftest test-version-stable?
+  (testing "Is version stable?"
+    (doseq [[version-str expected description] params-version-stable?]
+      (testing description
+        (let [version (v/parse-version version-str)
+              stable? (some-> (ns-resolve 'pip-license-checker.version 'version-stable?) deref)]
+          (is (and (fn? stable?) (= expected (stable? version)))))))))
+
+(deftest test-filter-versions-default-includes-prereleases
+  (let [specifiers [[v/ge (v/parse-version "1")]]
+        versions (mapv v/parse-version ["1.9.9" "2.0.0.a2" "2.0.0.dev1"])
+        actual (set (map :orig (v/filter-versions specifiers versions)))]
+    (is (= #{"1.9.9" "2.0.0.a2" "2.0.0.dev1"} actual))))
+
+(deftest test-get-version-default-includes-prereleases
+  (let [specifiers [[v/le (v/parse-version "2")]]]
+    (testing "The highest matching pre-release is selected by default"
+      (is (= "2.0.0.a2"
+             (v/get-version specifiers
+                            (mapv v/parse-version ["1.9.9" "2.0.0.a1" "2.0.0.a2"])))))
+    (testing "A matching development release is selected when it is the highest"
+      (is (= "2.0.0.dev1"
+             (v/get-version specifiers
+                            (mapv v/parse-version ["1.9.9" "2.0.0.dev1"])))))))
