+;; pypi/get-requirement-version with :pre
+
+(def params-get-requirement-version-pre
+  [[{:name "aiohttp"
+     :specifiers [[version/le (version/parse-version "2")]]}
+    false
+    {:ok? true
+     :requirement {:name "aiohttp" :version "1.9.9"}
+     :response "https://pypi.org/pypi/aiohttp/1.9.9/json"}
+    "Stable version when :pre is false"]
+   [{:name "aiohttp"
+     :specifiers [[version/le (version/parse-version "2")]]}
+    true
+    {:ok? true
+     :requirement {:name "aiohttp" :version "2.0.0.a2"}
+     :response "https://pypi.org/pypi/aiohttp/2.0.0.a2/json"}
+    "Pre-release version when :pre is true"]])
+
+(deftest ^:request test-get-requirement-version-pre
+  (testing "Selecting a PyPI version honoring :pre"
+    (doseq [[requirement pre expected description] params-get-requirement-version-pre]
+      (testing description
+        (with-redefs
+         [http/get (fn [url & _] {:body url})
+          pypi/get-releases (constantly [(version/parse-version "1.9.8")
+                                         (version/parse-version "1.9.9")
+                                         (version/parse-version "2.0.0.a1")
+                                         (version/parse-version "2.0.0.a2")])]
+          (is (= expected (pypi/get-requirement-version requirement :pre pre))))))))
+
+;; pypi/requirement->license with :pre
+
+(def params-requirement->license-pre
+  [[{:name "aiohttp"
+     :specifiers [[version/le (version/parse-version "2")]]}
+    false
+    "1.9.9"
+    "Stable version when :pre is false"]
+   [{:name "aiohttp"
+     :specifiers [[version/le (version/parse-version "2")]]}
+    true
+    "2.0.0.a2"
+    "Pre-release version when :pre is true"]])
+
+(deftest ^:request test-requirement->license-pre
+  (testing "Forwarding :pre when resolving a license"
+    (doseq [[requirement pre expected-version description] params-requirement->license-pre]
+      (testing description
+        (with-redefs
+         [http/get (constantly {:body "{}"})
+          pypi/get-releases (constantly [(version/parse-version "1.9.8")
+                                         (version/parse-version "1.9.9")
+                                         (version/parse-version "2.0.0.a1")
+                                         (version/parse-version "2.0.0.a2")])]
+          (is (= expected-version
+                 (:version (:requirement (pypi/requirement->license requirement :pre pre))))))))))
+
+(deftest test-validate-pre-cli-flags
+  (testing "The CLI enables or disables pre-release selection explicitly"
+    (is (= {:pre true} (:options (core/validate-args ["--pre" "django"]))))
+    (is (= {:pre false} (:options (core/validate-args ["--no-pre" "django"]))))))
+
+(deftest ^:request test-core-propagates-pre-option
+  (testing "Parsed CLI options determine the version used for license resolution"
+    (doseq [[pre expected-version] [[false "1.9.9"] [true "2.0.0.a2"]]]
+      (let [requested-urls (atom [])]
+        (with-redefs
+          [http/get (fn [url & _]
+                      (swap! requested-urls conj url)
+                      {:body "{\"info\": {\"license\": \"MIT License\"}}"})
+           pypi/get-releases (constantly (mapv version/parse-version
+                                                ["1.9.8" "1.9.9" "2.0.0.a1" "2.0.0.a2"]))]
+          (let [results (vec (core/get-parsed-requiements
+                              ["aiohttp<=2"] [] {:pre pre}))]
+            (is (= expected-version (get-in (first results) [:requirement :version]))
+                (str "pre=" pre))
+            (is (some #(= (str "https://pypi.org/pypi/aiohttp/" expected-version "/json") %)
+                      @requested-urls))))))))
+
+(deftest ^:request test-get-requirement-version-no-match-with-pre
+  (testing "A requirement with no matching release requests the package-level response"
+    (let [requested-urls (atom [])
+          requirement {:name "aiohttp"
+                       :specifiers [[version/eq (version/parse-version "9.9.9")]]}]
+      (with-redefs
+        [http/get (fn [url & _]
+                    (swap! requested-urls conj url)
+                    {:body url})
+         pypi/get-releases (constantly (mapv version/parse-version ["1.9.9" "2.0.0.a2"]))]
+        (let [result (pypi/get-requirement-version requirement :pre true)]
+          (is (= false (:ok? result)))
+          (is (= "aiohttp" (get-in result [:requirement :name])))
+          (is (some #{"https://pypi.org/pypi/aiohttp/json"} @requested-urls)))))))
