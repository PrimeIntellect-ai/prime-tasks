+@testset "Mixed CartesianIndex and range indexing" begin
+    data = reshape(1:24, 2, 3, 4)
+    a = AccessCountDiskArray(data, chunksize=(2, 2, 2))
+    # The exact form from the issue: a CartesianIndex followed by a range
+    @test a[CartesianIndex(1, 2), 1:end] == data[CartesianIndex(1, 2), 1:end]
+    @test a[CartesianIndex(1, 2), :] == data[CartesianIndex(1, 2), :]
+    @test a[CartesianIndex(1, 2), 1:4] == data[CartesianIndex(1, 2), 1:4]
+    @test a[CartesianIndex(1, 2), 2:3] == data[CartesianIndex(1, 2), 2:3]
+end
