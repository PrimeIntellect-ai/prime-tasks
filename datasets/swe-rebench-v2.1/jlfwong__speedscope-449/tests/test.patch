+  test('imports a compact evented profile', async () => {
+    const source = readFileSync('./sample/profiles/speedscope/0.0.1/simple.speedscope.json', 'utf8')
+    const profile = JSON.parse(source)
+    const compactProfile = JSON.stringify({
+      version: profile.version,
+      $schema: profile.$schema,
+      shared: profile.shared,
+      profiles: profile.profiles.map((p: any) => ({
+        type: p.type,
+        name: p.name,
+        unit: p.unit,
+        startValue: p.startValue,
+        endValue: p.endValue,
+        events: p.events.map((event: any) => ({
+          type: event.type,
+          frame: event.frame,
+          at: event.at,
+        })),
+      })),
+    })
+    const buffer = Buffer.from(compactProfile, 'utf8')
+    const arrayBuffer = buffer.buffer.slice(
+      buffer.byteOffset,
+      buffer.byteOffset + buffer.byteLength,
+    )
+    const imported = await importProfilesFromArrayBuffer('simple.speedscope.json', arrayBuffer)
+    expect(imported).not.toBeNull()
+  })
+
