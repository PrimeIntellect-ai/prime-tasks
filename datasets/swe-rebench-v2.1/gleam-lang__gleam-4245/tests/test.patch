+#[test]
+fn generate_function_takes_labels_into_account() {
+    let src = "
+pub fn main() {
+  wibble(2, n: 1)
+}
+";
+    let generated = apply_code_action(
+        GENERATE_FUNCTION,
+        TestProject::for_source(src),
+        find_position_of("wibble").to_selection().find_range(src),
+    );
+
+    let signature = generated
+        .lines()
+        .find(|line| line.trim_start().starts_with("fn wibble("))
+        .expect("generated function signature");
+    let parameters = signature
+        .trim()
+        .strip_prefix("fn wibble(")
+        .and_then(|signature| signature.split_once(')'))
+        .map(|(parameters, _)| parameters)
+        .expect("generated function parameters");
+    let parameters = parameters.split(", ").collect_vec();
+
+    assert_eq!(parameters.len(), 2);
+    assert_eq!(
+        parameters[0]
+            .split(':')
+            .next()
+            .unwrap()
+            .split_whitespace()
+            .count(),
+        1
+    );
+    assert!(parameters[1].starts_with("n "));
+    assert_eq!(
+        parameters[1]
+            .split(':')
+            .next()
+            .unwrap()
+            .split_whitespace()
+            .count(),
+        2
+    );
+}
+
+#[test]
+fn generate_function_does_not_trigger_if_labels_are_in_the_wrong_order() {
+    assert_no_code_actions!(
+        GENERATE_FUNCTION,
+        "
+pub fn main() {
+  wibble(n: 2, 1)
+}
+",
+        find_position_of("wibble").to_selection()
+    );
+}
+
+#[test]
+fn generate_function_does_not_trigger_if_there_are_repeated_labels() {
+    assert_no_code_actions!(
+        GENERATE_FUNCTION,
+        "
+pub fn main() {
+  wibble(n: 2, n: 1)
+}
+",
+        find_position_of("wibble").to_selection()
+    );
+}
+
