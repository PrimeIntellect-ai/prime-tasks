+def test_PlotItem_maxTraces_shows_newest_n_traces():
+    item = pg.PlotItem()
+    curves = [pg.PlotDataItem(np.full(10, i)) for i in range(10)]
+    for curve in curves:
+        item.addItem(curve)
+
+    item.ctrl.maxTracesSpin.setValue(3)
+    item.ctrl.maxTracesCheck.setChecked(True)
+
+    assert [curve.isVisible() for curve in curves] == [False] * 7 + [True] * 3
