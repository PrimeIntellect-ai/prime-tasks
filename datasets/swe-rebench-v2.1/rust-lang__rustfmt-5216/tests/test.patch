diff --git a/tests/rustfmt/main.rs b/tests/rustfmt/main.rs
index 8effb1c6..9e33cb5d 100644
--- a/tests/rustfmt/main.rs
+++ b/tests/rustfmt/main.rs
@@ -106,3 +106,19 @@ fn inline_config() {
             && contains("format_strings = true")
     );
 }
+
+#[test]
+fn rustfmt_usage_text() {
+    let (stdout, _) = rustfmt(&["--help"]);
+    let usage = stdout
+        .lines()
+        .find(|line| line.starts_with("usage:"))
+        .expect("help output should include usage text");
+    let mut bin_dir = env::current_exe().unwrap();
+    bin_dir.pop();
+    if bin_dir.ends_with("deps") {
+        bin_dir.pop();
+    }
+    let rustfmt_path = bin_dir.join(format!("rustfmt{}", env::consts::EXE_SUFFIX));
+    assert!(!usage.contains(rustfmt_path.to_str().unwrap()));
+}
