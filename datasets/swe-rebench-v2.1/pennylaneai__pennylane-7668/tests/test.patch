+class TestDrawMPLWorkWires:
+    """Tests that ``qml.draw_mpl`` can draw circuits containing work wires."""
+
+    def test_draw_mpl_with_work_wires(self):
+        """A circuit whose operators contain work wires can be drawn with ``qml.draw_mpl``."""
+        dev = qml.device("default.qubit")
+
+        @qml.qnode(dev)
+        def circuit():
+            qml.ctrl(qml.CRZ(0.5, [0, 2]), control=[3], work_wires=[1])
+            return qml.probs(wires=[3])
+
+        fig, ax = qml.draw_mpl(circuit)()
+        assert isinstance(fig, mpl.figure.Figure)
+
+    def test_draw_mpl_omits_work_only_wires(self):
+        """Work-only wires are not drawn by ``qml.draw_mpl``."""
+        dev = qml.device("default.qubit")
+
+        @qml.qnode(dev)
+        def circuit():
+            qml.ctrl(qml.CRZ(0.5, [0, 2]), control=[3], work_wires=["work"])
+            return qml.probs(wires=[3])
+
+        _, ax = qml.draw_mpl(circuit)()
+        drawn_labels = {text.get_text() for text in ax.texts}
+        assert "work" not in drawn_labels
