+    def test_work_wires(self):
+        """Test wire map works with string work wires, leading to a difference
+        between full_wire_map and used_wire_map."""
+
+        ops = [qml.PauliY("a"), qml.MultiControlledX(["b", 0, 9, 4], work_wires=[1, 5, "a"])]
