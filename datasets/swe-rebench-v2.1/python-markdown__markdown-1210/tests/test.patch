index 7a3e1c3..ea5016e 100644
--- a/tests/test_syntax/inline/test_links.py
+++ b/tests/test_syntax/inline/test_links.py
@@ -350,3 +350,18 @@ class TestReferenceLinks(TestCase):
             '<p>I would like to tell you about the [code of</p>\n'
             '<p>conduct][] we are using in this project.</p>'
         )
+
+    def test_ref_link_nested_left_bracket(self):
+        # A link whose text contains a code span with brackets and a colon
+        # must not be mistaken for a reference link definition.
+        self.assertMarkdownRenders(
+            '[Hello `[T]::world()` link](https://example.com)',
+            '<p><a href="https://example.com">Hello <code>[T]::world()</code> link</a></p>'
+        )
+
+    def test_inline_link_with_code_containing_brackets(self):
+        self.assertMarkdownRenders(
+            '[Hello `[T]::world()` link](https://example.com)',
+            '<p><a href="https://example.com">Hello <code>[T]::world()</code> link</a></p>'
+        )
+
