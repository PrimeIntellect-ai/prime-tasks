+@mock.patch("semantic_release.hvcs.config.get", wrapped_config_get(hvcs="github"))
+@mock.patch(
+    "os.environ",
+    {
+        "GITHUB_API_URL": "api.github.enterprise",
+        "GITHUB_SERVER_URL": "github.enterprise",
+    },
+)
+def test_ghe_domain_should_be_retrieved_from_env():
+    assert get_hvcs().domain() == "github.enterprise"
+    assert get_hvcs().api_url() == "https://api.github.enterprise"
+
+
+def test_github_configuration_domains_take_precedence_over_environment():
+    with mock.patch(
+        "semantic_release.hvcs.config.get",
+        wrapped_config_get(
+            hvcs="github",
+            hvcs_domain="configured.github.enterprise",
+            hvcs_api_domain="api.configured.github.enterprise",
+        ),
+    ):
+        with mock.patch(
+            "os.environ",
+            {
+                "GITHUB_SERVER_URL": "https://environment.github.enterprise",
+                "GITHUB_API_URL": "https://api.environment.github.enterprise",
+            },
+        ):
+            assert Github.domain() == "configured.github.enterprise"
+            assert Github.api_url() == "https://api.configured.github.enterprise"
+
+
