+// sarifDocsMatch reports whether got and want are the same JSON document once
+// the per-result "properties" objects are ignored, since they carry result
+// metadata that the expected document does not define.
+func sarifDocsMatch(got, want []byte) (bool, error) {
+	var g, w map[string]interface{}
+	if err := json.Unmarshal(got, &g); err != nil {
+		return false, err
+	}
+	if err := json.Unmarshal(want, &w); err != nil {
+		return false, err
+	}
+	dropResultProperties(g)
+	dropResultProperties(w)
+	return reflect.DeepEqual(g, w), nil
+}
+
+func dropResultProperties(doc map[string]interface{}) {
+	runs, _ := doc["runs"].([]interface{})
+	for _, r := range runs {
+		run, _ := r.(map[string]interface{})
+		results, _ := run["results"].([]interface{})
+		for _, res := range results {
+			if result, ok := res.(map[string]interface{}); ok {
+				delete(result, "properties")
+			}
+		}
+	}
+}
+
+// TestDefaultConfigSlackTokens checks the built-in rules against a real
+// multi-segment Slack token and against a placeholder-like string.
+func TestDefaultConfigSlackTokens(t *testing.T) {
+	viper.Reset()
+	viper.SetConfigType("toml")
+	if err := viper.ReadConfig(strings.NewReader(config.DefaultConfig)); err != nil {
+		t.Fatal(err)
+	}
+	var vc config.ViperConfig
+	if err := viper.Unmarshal(&vc); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := vc.Translate()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	flagged := func(s string) bool {
+		for _, rule := range cfg.Rules {
+			if rule.Regex != nil && rule.Regex.MatchString(s) {
+				return true
+			}
+		}
+		return false
+	}
+
+	for _, token := range []string{
+		"xoxp-41684372915-1320496754-45609968301-e708ba56e1517a99f6b5fb07349476ef",
+		"xoxb-17653672481-19874698323-pdFZKVeTuE8sk7oOcBrzbqgy",
+	} {
+		if !flagged(token) {
+			t.Errorf("expected Slack token %q to be detected", token)
+		}
+	}
+	if flagged("xoxp-yourtokenhere") {
+		t.Errorf("placeholder %q should not be detected as a Slack token", "xoxp-yourtokenhere")
+	}
+}
