+// csvRowsMatch reports whether got has the same records as want, comparing
+// each expected field. Columns that want does not define are ignored, so
+// output may carry additional trailing columns.
+func csvRowsMatch(got, want []byte) (bool, error) {
+	gotRows, err := csv.NewReader(bytes.NewReader(got)).ReadAll()
+	if err != nil {
+		return false, err
+	}
+	wantRows, err := csv.NewReader(bytes.NewReader(want)).ReadAll()
+	if err != nil {
+		return false, err
+	}
+	if len(gotRows) != len(wantRows) {
+		return false, nil
+	}
+	for i := range wantRows {
+		if len(gotRows[i]) < len(wantRows[i]) {
+			return false, nil
+		}
+		for j := range wantRows[i] {
+			if gotRows[i][j] != wantRows[i][j] {
+				return false, nil
+			}
+		}
+	}
+	return true, nil
+}
