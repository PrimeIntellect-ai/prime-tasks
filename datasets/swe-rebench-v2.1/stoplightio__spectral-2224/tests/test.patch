index 00000000..3511b8b8
--- /dev/null
+++ b/packages/rulesets/src/asyncapi/__tests__/asyncapi-message-messageId-uniqueness.test.ts
@@ -0,0 +1,149 @@
+import { DiagnosticSeverity } from '@stoplight/types';
+import testRule, { createWithRules } from './__helpers__/tester';
+
+testRule('asyncapi-message-messageId-uniqueness', [
+  {
+    name: 'validate a correct object',
+    document: {
+      asyncapi: '2.4.0',
+      channels: {
+        someChannel1: {
+          subscribe: {
+            message: {
+              messageId: 'id1',
+            },
+          },
+        },
+        someChannel2: {
+          subscribe: {
+            message: {
+              messageId: 'id2',
+            },
+          },
+          publish: {
+            message: {
+              messageId: 'id3',
+            },
+          },
+        },
+      },
+    },
+    errors: [],
+  },
+
+  {
+    name: 'validate a correct object (oneOf case)',
+    document: {
+      asyncapi: '2.4.0',
+      channels: {
+        someChannel1: {
+          subscribe: {
+            message: {
+              messageId: 'id1',
+            },
+          },
+        },
+        someChannel2: {
+          subscribe: {
+            message: {
+              oneOf: [
+                {
+                  messageId: 'id2',
+                },
+                {
+                  messageId: 'id3',
+                },
+              ],
+            },
+          },
+          publish: {
+            message: {
+              messageId: 'id4',
+            },
+          },
+        },
+      },
+    },
+    errors: [],
+  },
+
+  {
+    name: 'validate a correct object (messages without messageId)',
+    document: {
+      asyncapi: '2.4.0',
+      channels: {
+        someChannel1: {
+          subscribe: {
+            message: {},
+          },
+        },
+        someChannel2: {
+          subscribe: {
+            message: {
+              messageId: 'id1',
+            },
+          },
+          publish: {
+            message: {
+              oneOf: [{}, {}],
+            },
+          },
+        },
+      },
+    },
+    errors: [],
+  },
+
+
+
+]);
+
+const ruleName = 'asyncapi-message-messageId-uniqueness';
+
+async function expectDuplicateMessageId(document: Record<string, unknown>): Promise<void> {
+  const spectral = createWithRules([ruleName]);
+  const results = await spectral.run(JSON.stringify(document));
+  const findings = results.filter(result => result.code === ruleName);
+
+  expect(findings.length).toBeGreaterThan(0);
+  expect(findings.every(result => result.severity === DiagnosticSeverity.Error)).toBe(true);
+}
+
+describe('duplicate messageId detection', () => {
+  it('reports duplicate IDs on messages in different channels', async () => {
+    await expectDuplicateMessageId({
+      asyncapi: '2.4.0',
+      channels: {
+        first: { subscribe: { message: { messageId: 'same' } } },
+        second: { publish: { message: { messageId: 'same' } } },
+      },
+    });
+  });
+
+  it('reports duplicate IDs on messages in the same channel', async () => {
+    await expectDuplicateMessageId({
+      asyncapi: '2.4.0',
+      channels: {
+        events: {
+          subscribe: { message: { messageId: 'same' } },
+          publish: { message: { messageId: 'same' } },
+        },
+      },
+    });
+  });
+
+  it('reports duplicate IDs between oneOf message alternatives', async () => {
+    await expectDuplicateMessageId({
+      asyncapi: '2.4.0',
+      channels: {
+        events: {
+          publish: {
+            message: {
+              oneOf: [{ messageId: 'same' }, { messageId: 'same' }],
+            },
+          },
+        },
+      },
+    });
+  });
+});
