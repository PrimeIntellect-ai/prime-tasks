+func TestRepositoriesService_RemoveRequiredStatusChecks_context(t *testing.T) {
+	client, mux, _, teardown := setup()
+	defer teardown()
+
+	mux.HandleFunc("/repos/o/r/branches/b/protection/required_status_checks", func(w http.ResponseWriter, r *http.Request) {
+		testMethod(t, r, "DELETE")
+		w.WriteHeader(http.StatusNoContent)
+	})
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	_, err := client.Repositories.RemoveRequiredStatusChecks(ctx, "o", "r", "b")
+	if err == nil {
+		t.Error("Repositories.RemoveRequiredStatusChecks with canceled context returned nil error, want error")
+	}
+}
