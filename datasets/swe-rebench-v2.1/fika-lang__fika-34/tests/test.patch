diff --git a/test/fika/parser_test.exs b/test/fika/parser_test.exs
index cba3158..7d9970f 100644
--- a/test/fika/parser_test.exs
+++ b/test/fika/parser_test.exs
@@ -666,6 +666,47 @@ defmodule Fika.ParserTest do
     end
   end
 
+  describe "map" do
+    test "parses map with key values" do
+      str = """
+      {"a" => 1}
+      """
+
+      assert {:ok, [_ast], "", _, _, _} = TestParser.expression(str)
+
+      assert {:ok, {map, _type, _}} = TE.eval(~s({"a" => 1}))
+      assert Map.values(map) == [1]
+    end
+
+    test "parses map with complex expression" do
+      str = """
+      {[1+1, 2] => {"1" => {1, 2, 3}}}
+      """
+
+      assert {:ok, [_ast], "", _, _, _} = TestParser.expression(str)
+
+      str = """
+      {true & false => false}
+      """
+
+      assert {:ok, [_ast], "", _, _, _} = TestParser.expression(str)
+    end
+
+    test "parses map with function as key-values" do
+      str = """
+      {foo(1, 2) => bar(true)}
+      """
+
+      assert {:ok, [_ast], "", _, _, _} = TestParser.expression(str)
+
+      str = """
+      {&foo.bar => jar(true)}
+      """
+
+      assert {:ok, [_ast], "", _, _, _} = TestParser.expression(str)
+    end
+  end
+
   describe "tuple" do
     test "parses tuple with one element" do
       str = """
diff --git a/test/fika/type_checker_test.exs b/test/fika/type_checker_test.exs
index 6a26924..ad6eb2b 100644
--- a/test/fika/type_checker_test.exs
+++ b/test/fika/type_checker_test.exs
@@ -335,6 +335,37 @@ defmodule Fika.TypeCheckerTest do
     end
   end
 
+  describe "map" do
+    test "type check for a valid expression" do
+      str = ~s({"foo" => 123, "bar" => 345})
+
+      ast = TestParser.expression!(str)
+
+      assert {:ok, type, _} = TypeChecker.infer_exp(Env.init(), ast)
+      assert String.replace(type, " ", "") == "Map(String,Int)"
+
+      # The example from the contract
+      ast = TestParser.expression!(~s({"foo" => 123}))
+
+      assert {:ok, type, _} = TypeChecker.infer_exp(Env.init(), ast)
+      assert String.replace(type, " ", "") == "Map(String,Int)"
+    end
+
+    test "type check for map with mixed type" do
+      str = ~s({1 => [1, 2], "foo" => 345})
+
+      ast = TestParser.expression!(str)
+
+      assert {:error, _} = TypeChecker.infer_exp(Env.init(), ast)
+
+      str = ~s({"foo" => [1, 2], "bar" => 345})
+
+      ast = TestParser.expression!(str)
+
+      assert {:error, _} = TypeChecker.infer_exp(Env.init(), ast)
+    end
+  end
+
   describe "function reference" do
     test "with args" do
       str = "&bar.sum(Int, Int)"
