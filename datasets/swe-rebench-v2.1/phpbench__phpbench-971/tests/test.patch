+<?php
+
+namespace PhpBench\Tests\Unit\Util;
+
+use PhpBench\Expression\Ast\DisplayAsNode;
+use PhpBench\Expression\Ast\IntegerNode;
+use PhpBench\Expression\Ast\StringNode;
+use PhpBench\Expression\Ast\UnitNode;
+use PhpBench\Tests\Unit\Expression\NodePrinterTestCase;
+
+class NumberFormatTest extends NodePrinterTestCase
+{
+    public function testDisplayedNumberCanBeConfiguredToOmitFractionalPaddingZeros(): void
+    {
+        $display = new DisplayAsNode(
+            new IntegerNode(1000000),
+            new UnitNode(new StringNode('k'))
+        );
+        $stripped = $this->print($display, [], [
+            'expression.strip_tailing_zeros' => true,
+        ]);
+        $padded = $this->print($display, [], [
+            'expression.strip_tailing_zeros' => false,
+        ]);
+
+        self::assertDoesNotMatchRegularExpression('/\.\d*0kb$/', $stripped);
+        self::assertSame(1000.0, (float) str_replace(',', '', substr($stripped, 0, -2)));
+        self::assertMatchesRegularExpression('/\.0+kb$/', $padded);
+        self::assertSame(1000.0, (float) str_replace(',', '', substr($padded, 0, -2)));
+
+        $withSignificantFraction = new DisplayAsNode(
+            new IntegerNode(1230050),
+            new UnitNode(new StringNode('k'))
+        );
+        $fractionalOutput = $this->print($withSignificantFraction, [], [
+            'expression.strip_tailing_zeros' => true,
+        ]);
+        self::assertDoesNotMatchRegularExpression('/\.\d*0kb$/', $fractionalOutput);
+        self::assertSame(1230.05, (float) str_replace(',', '', substr($fractionalOutput, 0, -2)));
+    }
+}
