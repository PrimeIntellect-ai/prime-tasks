+++ b/src/options/readAllContributors.test.ts
@@ -0,0 +1,81 @@
+import { createMockSystems } from "bingo-testers";
+import { testBlock } from "bingo-stratum-testers";
+import { describe, expect, it, vi } from "vitest";
+
+import { base } from "../base.js";
+import { blockAllContributors } from "../blocks/blockAllContributors.js";
+import { blockREADME } from "../blocks/blockREADME.js";
+import { optionsBase } from "../blocks/options.fakes.js";
+
+const mockInputFromFileJSON = vi.fn();
+
+vi.mock("input-from-file-json", () => ({
+	get inputFromFileJSON() {
+		return mockInputFromFileJSON;
+	},
+}));
+
+const mockInputFromOctokit = vi.fn();
+
+vi.mock("../inputs/inputFromOctokit.js", () => ({
+	get inputFromOctokit() {
+		return mockInputFromOctokit;
+	},
+}));
+
+const { take } = createMockSystems();
+
+describe("setup contributors", () => {
+	it("uses the current GitHub user as the base contributors fallback", async () => {
+		mockInputFromFileJSON.mockResolvedValueOnce(new Error("Oh no!"));
+		mockInputFromOctokit.mockResolvedValueOnce({
+			avatar_url: "avatar_url",
+			blog: "blog",
+			login: "login",
+			name: "name",
+		});
+
+		const prepared = base.prepare!({ options: {}, take } as never);
+		const contributors =
+			typeof prepared.contributors === "function"
+				? await (prepared.contributors as () => Promise<unknown[]>)()
+				: prepared.contributors;
+
+		expect(contributors).toEqual(
+			expect.arrayContaining([expect.objectContaining({ login: "login" })]),
+		);
+	});
+
+	it("creates a Contributors heading and table in the README for a new repository", async () => {
+		mockInputFromFileJSON.mockResolvedValueOnce(new Error("Oh no!"));
+		mockInputFromOctokit.mockResolvedValueOnce({
+			avatar_url: "avatar_url",
+			blog: "blog",
+			login: "login",
+			name: "name",
+		});
+
+		const prepared = base.prepare!({ options: {}, take } as never);
+		const contributors =
+			typeof prepared.contributors === "function"
+				? await (prepared.contributors as () => Promise<unknown[]>)()
+				: prepared.contributors;
+		const creation = testBlock(blockAllContributors, {
+			options: {
+				...optionsBase,
+				contributors: contributors as typeof optionsBase.contributors,
+			},
+		});
+		const readmeAddon = (creation.addons?.[0] as {
+			addons: { badges?: string[]; notices?: string[]; sections?: string[] };
+		}).addons;
+		const readmeCreation = testBlock(blockREADME, {
+			addons: readmeAddon,
+			options: { ...optionsBase, title: "Test Title", usage: "Use it." },
+		});
+		const readme = readmeCreation.files?.["README.md"] ?? "";
+
+		expect(readme).toContain("## Contributors");
+		expect(readme).toMatch(/<table\b|^\s*\|.*\|\s*\n\s*\|[\s:|-]+\|/im);
+	});
+});
