+class EggErrorBehaviorTestCase(unittest.TestCase):
+    """Behavior checks for egg-discovery failures."""
+
+    def test_add_eggs_on_path_does_not_raise_system_error(self):
+        from envisage.egg_utils import add_eggs_on_path
+
+        class WorkingSetWithDiscoveryError:
+            def find_plugins(self, environment):
+                return [], {"broken distribution": ValueError("broken")}
+
+            def add(self, distribution):
+                raise AssertionError("no distribution should be added")
+
+        with tempfile.TemporaryDirectory() as path:
+            with self.assertRaises(Exception) as error:
+                add_eggs_on_path(WorkingSetWithDiscoveryError(), path)
+        self.assertNotIsInstance(error.exception, SystemError)
+
+    def test_legacy_egg_examples_do_not_raise_system_error(self):
+        import builtins
+        import io
+        import logging
+        import os
+        import runpy
+        from unittest.mock import patch
+
+        examples = [
+            "MOTD_Using_Eggs/dist/run.py",
+            "plugins/workbench/AcmeLabUsingEggs/dist/run.py",
+        ]
+        root = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
+        for relative_path in examples:
+            with self.subTest(example=relative_path):
+                logger = logging.getLogger()
+                handlers_before = logger.handlers[:]
+                try:
+                    with patch.object(builtins, "file", lambda *a, **k: io.StringIO(), create=True):
+                        module = runpy.run_path(
+                            os.path.join(root, "examples", "legacy", relative_path),
+                            run_name="legacy_egg_example",
+                        )
+                    with patch("pkg_resources.Environment", return_value=object()):
+                        with patch.object(
+                            pkg_resources.working_set,
+                            "find_plugins",
+                            return_value=([], {"broken distribution": ValueError("broken")}),
+                        ):
+                            with self.assertRaises(Exception) as error:
+                                module["main"]()
+                    self.assertNotIsInstance(error.exception, SystemError)
+                finally:
+                    for handler in logger.handlers[:]:
+                        if handler not in handlers_before:
+                            logger.removeHandler(handler)
+                            handler.close()
+
+    def test_legacy_color_views_do_not_raise_system_error_for_unknown_toolkit(self):
+        import importlib.util
+        import os
+        from traits.etsconfig.api import ETSConfig
+        from unittest.mock import patch
+
+        root = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
+        examples = [
+            "plugins/workbench/AcmeLab/acme/workbench/view/color_view.py",
+            "plugins/workbench/AcmeLabUsingEggs/src/acme.workbench/acme/workbench/view/color_view.py",
+        ]
+        for index, relative_path in enumerate(examples):
+            with self.subTest(example=relative_path):
+                spec = importlib.util.spec_from_file_location(
+                    "legacy_color_view_{}".format(index),
+                    os.path.join(root, "examples", "legacy", relative_path),
+                )
+                module = importlib.util.module_from_spec(spec)
+                spec.loader.exec_module(module)
+                with patch.object(ETSConfig, "_toolkit", "rebench_unknown_toolkit"):
+                    view = object.__new__(module.ColorView)
+                    view.name = "red"
+                    with self.assertRaises(Exception) as error:
+                        view.create_control(None)
+                self.assertNotIsInstance(error.exception, SystemError)
