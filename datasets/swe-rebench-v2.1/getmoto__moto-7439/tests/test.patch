+@mock_aws
+def test_update_secret_version_stage_moves_and_removes_non_current_stage():
+    sm_client = boto3.client("secretsmanager", "us-east-1")
+    sm_client.create_secret(Name="test-secret", SecretString="old_secret")
+    first_version = sm_client.put_secret_value(
+        SecretId="test-secret",
+        SecretString="previous_secret",
+        VersionStages=["AWSCURRENT"],
+    )["VersionId"]
+
+    token = str(uuid4())
+    sm_client.put_secret_value(
+        SecretId="test-secret",
+        ClientRequestToken=token,
+        SecretString="new_secret",
+        VersionStages=["AWSPENDING"],
+    )
+
+    # Move the AWSPENDING label from the pending version to the current version
+    sm_client.update_secret_version_stage(
+        SecretId="test-secret",
+        VersionStage="AWSPENDING",
+        MoveToVersionId=first_version,
+        RemoveFromVersionId=token,
+    )
+
+    pending = sm_client.get_secret_value(
+        SecretId="test-secret", VersionStage="AWSPENDING"
+    )
+    assert pending["SecretString"] == "previous_secret"
+
+    # Remove the AWSPENDING label entirely
+    sm_client.update_secret_version_stage(
+        SecretId="test-secret",
+        VersionStage="AWSPENDING",
+        RemoveFromVersionId=first_version,
+    )
+    version = sm_client.get_secret_value(SecretId="test-secret", VersionId=first_version)
+    assert "AWSPENDING" not in version["VersionStages"]
