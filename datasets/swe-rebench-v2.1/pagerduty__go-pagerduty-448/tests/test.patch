+// A service returned with null alert-grouping parameters can be sent back in an update.
+func TestService_UpdateWithUnsetAlertGroupingParameters(t *testing.T) {
+	setup()
+	defer teardown()
+
+	mux.HandleFunc("/services/1", func(w http.ResponseWriter, r *http.Request) {
+		switch r.Method {
+		case http.MethodGet:
+			_, _ = w.Write([]byte(`{"service":{"id":"1","alert_grouping_parameters":{"type":null,"config":null}}}`))
+		case http.MethodPut:
+			var payload map[string]json.RawMessage
+			if err := json.NewDecoder(r.Body).Decode(&payload); err != nil {
+				t.Errorf("could not decode update request: %v", err)
+				http.Error(w, "invalid request", http.StatusBadRequest)
+				return
+			}
+			var service map[string]json.RawMessage
+			if err := json.Unmarshal(payload["service"], &service); err != nil {
+				t.Errorf("could not decode service in update request: %v", err)
+				http.Error(w, "invalid request", http.StatusBadRequest)
+				return
+			}
+			var grouping map[string]json.RawMessage
+			if raw := service["alert_grouping_parameters"]; len(raw) > 0 && string(raw) != "null" {
+				if err := json.Unmarshal(raw, &grouping); err != nil {
+					t.Errorf("could not decode alert-grouping parameters: %v", err)
+					http.Error(w, "invalid request", http.StatusBadRequest)
+					return
+				}
+				var config map[string]json.RawMessage
+				if rawConfig := grouping["config"]; len(rawConfig) > 0 && string(rawConfig) != "null" {
+					if err := json.Unmarshal(rawConfig, &config); err != nil {
+						t.Errorf("could not decode grouping config: %v", err)
+						http.Error(w, "invalid request", http.StatusBadRequest)
+						return
+					}
+					if len(config) == 0 {
+						w.Header().Set("Content-Type", "application/json")
+						w.WriteHeader(http.StatusBadRequest)
+						_, _ = w.Write([]byte(`{"error":{"message":"alert grouping parameters are invalid","code":2001}}`))
+						return
+					}
+				}
+			}
+			_, _ = w.Write([]byte(`{"service":{"id":"1"}}`))
+		default:
+			t.Errorf("unexpected request method %s", r.Method)
+			http.Error(w, "unexpected method", http.StatusMethodNotAllowed)
+		}
+	})
+
+	client := defaultTestClient(server.URL, "foo")
+	service, err := client.GetService("1", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := client.UpdateService(*service); err != nil {
+		t.Fatalf("updating a service with unset alert-grouping parameters failed: %v", err)
+	}
+}
