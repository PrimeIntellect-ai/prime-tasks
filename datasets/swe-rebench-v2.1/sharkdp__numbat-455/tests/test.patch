+#[test]
+fn typed_holes() {
+    assert!(matches!(
+        get_typecheck_error("a + ?"),
+        TypeCheckError::TypedHoleInStatement(_, type_, _) if type_ == "A"
+    ));
+
+    assert!(matches!(
+        get_typecheck_error("c + a × ?"),
+        TypeCheckError::TypedHoleInStatement(_, type_, _) if type_ == "B"
+    ));
+
+    assert!(matches!(
+        get_typecheck_error("let x: B = c / ?"),
+        TypeCheckError::TypedHoleInStatement(_, type_, _) if type_ == "A"
+    ));
+
+    assert!(matches!(
+        get_typecheck_error("if true then a else ?"),
+        TypeCheckError::TypedHoleInStatement(_, type_, _) if type_ == "A"
+    ));
+
+    assert!(matches!(
+        get_typecheck_error("let x: C = ?(a, b)"),
+        TypeCheckError::TypedHoleInStatement(_, type_, _) if type_ == "Fn[(A, B) -> A × B]"
+    ));
+}
+
+#[test]
+fn issue_example_hole_infers_electric_permittivity() {
+    let code = "dimension Scalar = 1\ndimension ElectricCharge\ndimension Action\ndimension Speed\ndimension ElectricPermittivity = ElectricCharge^2 / Action / Speed\nunit electron_charge: ElectricCharge\nunit ℏ: Action\nunit c: Speed\nlet x: Scalar = electron_charge^2 / (? ℏ c)\n";
+    let statements = parse(code, 0).expect("issue example should parse");
+    let transformed_statements = Transformer::new()
+        .transform(statements)
+        .expect("issue example should transform");
+
+    match TypeChecker::default().check(transformed_statements) {
+        Err(TypeCheckError::TypedHoleInStatement(_, inferred_type, statement)) => {
+            assert_eq!(inferred_type, "ElectricPermittivity");
+            assert!(statement.contains('?'));
+        }
+        other => panic!("expected an inferred typed hole, got {other:?}"),
+    }
+}
+
+// Type-check `input` against a small, self-contained prelude and return the
+// resulting error together with the full source code that was checked.
+fn typed_hole_error(input: &str) -> (TypeCheckError, String) {
+    let prelude = "dimension A\ndimension B\ndimension C = A * B\nunit a: A\nunit b: B\nunit c: C = a * b\n";
+    let code = format!("{prelude}{input}");
+
+    let statements = parse(&code, 0).expect("No parse errors for inputs in this test suite");
+    let transformed_statements = Transformer::new()
+        .transform(statements)
+        .expect("No transform errors for inputs in this test suite");
+
+    match TypeChecker::default().check(transformed_statements) {
+        Err(err) => (err, code),
+        Ok(_) => panic!("Input was expected to yield a type check error"),
+    }
+}
+
+#[test]
+fn typed_holes_carry_span_and_statement() {
+    for input in ["a + ?", "let x: B = c / ?"] {
+        let (err, code) = typed_hole_error(input);
+
+        match err {
+            TypeCheckError::TypedHoleInStatement(span, _type, statement) => {
+                let hole_byte = code
+                    .find('?')
+                    .expect("The input contains a typed hole") as u32;
+
+                // The span points at the `?` character in the source code.
+                assert_eq!(
+                    span.start.byte, hole_byte,
+                    "span should start at the typed hole for input {input:?}"
+                );
+                assert_eq!(
+                    span.end.byte,
+                    hole_byte + 1,
+                    "span should cover the typed hole for input {input:?}"
+                );
+
+                // The statement is the pretty-printed statement containing the hole.
+                assert!(
+                    statement.contains('?'),
+                    "statement should contain the typed hole for input {input:?}, got {statement:?}"
+                );
+            }
+            other => panic!("expected TypedHoleInStatement for input {input:?}, got {other:?}"),
+        }
+    }
+}
