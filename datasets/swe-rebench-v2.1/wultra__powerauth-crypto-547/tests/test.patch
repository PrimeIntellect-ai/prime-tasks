+package io.getlime.security.powerauth.crypto.lib.totp;
+
+import org.junit.jupiter.api.Test;
+
+import java.io.BufferedReader;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.time.LocalDateTime;
+import java.time.ZoneOffset;
+import java.time.ZonedDateTime;
+import java.time.format.DateTimeFormatter;
+import java.util.ArrayList;
+import java.util.HexFormat;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** Test for {@link Totp}. */
+class TotpTest {
+
+    private static final int DIGITS_NUMBER = 8;
+    private static final String DATA_RESOURCE = "/io/getlime/security/powerauth/crypto/lib/totp/data.csv";
+
+    @Test
+    void testGenerateTotp() throws Exception {
+        for (String[] row : dataRows()) {
+            final Instant instant = parse(row[1]).toInstant(ZoneOffset.UTC);
+            final byte[] result;
+            if ("HmacSHA256".equals(row[4])) {
+                result = Totp.generateTotpSha256(fromHex(row[5]), instant, DIGITS_NUMBER);
+            } else if ("HmacSHA512".equals(row[4])) {
+                result = Totp.generateTotpSha512(fromHex(row[5]), instant, DIGITS_NUMBER);
+            } else {
+                throw new AssertionError("Unexpected algorithm in test data: " + row[4]);
+            }
+            assertEquals(row[3], new String(result, StandardCharsets.UTF_8));
+        }
+    }
+
+    @Test
+    void testValidateTotpCurrentStep() throws Exception {
+        for (String[] row : dataRows()) {
+            final Instant instant = parse(row[1]).toInstant(ZoneOffset.UTC);
+            final boolean result;
+            if ("HmacSHA256".equals(row[4])) {
+                result = Totp.validateTotpSha256(row[3].getBytes(StandardCharsets.UTF_8), fromHex(row[5]), instant, DIGITS_NUMBER);
+            } else if ("HmacSHA512".equals(row[4])) {
+                result = Totp.validateTotpSha512(row[3].getBytes(StandardCharsets.UTF_8), fromHex(row[5]), instant, DIGITS_NUMBER);
+            } else {
+                throw new AssertionError("Unexpected algorithm in test data: " + row[4]);
+            }
+            assertTrue(result);
+        }
+    }
+
+    @Test
+    void testValidateTotpOneStepBack() throws Exception {
+        for (String[] row : dataRows()) {
+            final Instant instant = parse(row[1]).plusSeconds(30).toInstant(ZoneOffset.UTC);
+            final boolean result;
+            if ("HmacSHA256".equals(row[4])) {
+                result = Totp.validateTotpSha256(row[3].getBytes(StandardCharsets.UTF_8), fromHex(row[5]), instant, DIGITS_NUMBER);
+            } else if ("HmacSHA512".equals(row[4])) {
+                result = Totp.validateTotpSha512(row[3].getBytes(StandardCharsets.UTF_8), fromHex(row[5]), instant, DIGITS_NUMBER);
+            } else {
+                throw new AssertionError("Unexpected algorithm in test data: " + row[4]);
+            }
+            assertTrue(result);
+        }
+    }
+
+    @Test
+    void testValidateTotpRejectsCodeTwoStepsBack() throws Exception {
+        for (String[] row : dataRows()) {
+            final Instant instant = parse(row[1]).plusSeconds(60).toInstant(ZoneOffset.UTC);
+            final boolean result;
+            if ("HmacSHA256".equals(row[4])) {
+                result = Totp.validateTotpSha256(row[3].getBytes(StandardCharsets.UTF_8), fromHex(row[5]), instant, DIGITS_NUMBER);
+            } else if ("HmacSHA512".equals(row[4])) {
+                result = Totp.validateTotpSha512(row[3].getBytes(StandardCharsets.UTF_8), fromHex(row[5]), instant, DIGITS_NUMBER);
+            } else {
+                throw new AssertionError("Unexpected algorithm in test data: " + row[4]);
+            }
+            assertFalse(result);
+        }
+    }
+
+    @Test
+    void testGenerateTotpLeftPaddedWithZero() throws Exception {
+        final Instant instant = parse("2023-04-27T01:26:29Z").toInstant(ZoneOffset.UTC);
+        final String result = new String(Totp.generateTotpSha256("12345678901234567890".getBytes(StandardCharsets.UTF_8), instant, DIGITS_NUMBER), StandardCharsets.UTF_8);
+        assertEquals("01760428", result);
+    }
+
+    @Test
+    void testGenerateTotpAtAdditionalTimestampWithLeadingZero() throws Exception {
+        final Instant instant = Instant.ofEpochSecond(1_200_000_150L);
+        final byte[] key = "12345678901234567890".getBytes(StandardCharsets.UTF_8);
+        final String result = new String(Totp.generateTotpSha256(key, instant, DIGITS_NUMBER), StandardCharsets.UTF_8);
+        assertEquals("02997038", result);
+    }
+
+    @Test
+    void testValidateTotpAtAdditionalTimestampAcceptsOnlyMatchingCode() throws Exception {
+        final Instant instant = Instant.ofEpochSecond(1_200_000_150L);
+        final byte[] key = "12345678901234567890".getBytes(StandardCharsets.UTF_8);
+        assertTrue(Totp.validateTotpSha256("02997038".getBytes(StandardCharsets.UTF_8), key, instant, DIGITS_NUMBER));
+        assertFalse(Totp.validateTotpSha256("02997039".getBytes(StandardCharsets.UTF_8), key, instant, DIGITS_NUMBER));
+    }
+
+    private static List<String[]> dataRows() throws Exception {
+        final List<String[]> rows = new ArrayList<>();
+        final InputStream stream = TotpTest.class.getResourceAsStream(DATA_RESOURCE);
+        if (stream == null) {
+            throw new IllegalStateException("Missing test data resource");
+        }
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(stream, StandardCharsets.UTF_8))) {
+            String line;
+            reader.readLine();
+            while ((line = reader.readLine()) != null) {
+                if (!line.trim().isEmpty()) {
+                    final String[] columns = line.split(",");
+                    for (int i = 0; i < columns.length; i++) {
+                        columns[i] = columns[i].trim();
+                    }
+                    rows.add(columns);
+                }
+            }
+        }
+        return rows;
+    }
+
+    private static byte[] fromHex(final String source) {
+        return HexFormat.of().parseHex(source);
+    }
+
+    private static LocalDateTime parse(String source) {
+        return ZonedDateTime.parse(source, DateTimeFormatter.ISO_DATE_TIME)
+                .toLocalDateTime();
+    }
+}
