diff --git a/src/rules/dollar-variable-no-namespaced-assignment/__tests__/index.js b/src/rules/dollar-variable-no-namespaced-assignment/__tests__/index.js
new file mode 100644
index 0000000..994d05a
--- /dev/null
+++ b/src/rules/dollar-variable-no-namespaced-assignment/__tests__/index.js
@@ -0,0 +1,52 @@
+import { lint } from "stylelint";
+
+const ruleName = "scss/dollar-variable-no-namespaced-assignment";
+
+testRule({
+  ruleName,
+  config: [true],
+  customSyntax: "postcss-scss",
+
+  accept: [
+    {
+      code: `
+      p {
+        $foo: 10px;
+      }
+    `,
+      description: "Non-namespaced assignment"
+    },
+    {
+      code: `
+      p {
+        a: imported.$foo;
+      }
+    `,
+      description: "Namespaced usage"
+    }
+  ]
+});
+
+describe("namespaced assignment is reported under the public rule identifier", () => {
+  it("reports a namespaced assignment on the assignment line", () => {
+    return lint({
+      code: `
+      p {
+        imported.$foo: 10px;
+      }
+    `,
+      customSyntax: "postcss-scss",
+      config: {
+        plugins: ["./src"],
+        rules: { [ruleName]: true }
+      }
+    }).then(output => {
+      const { warnings, parseErrors } = output.results[0];
+
+      expect(parseErrors).toEqual([]);
+      expect(warnings).toHaveLength(1);
+      expect(warnings[0].rule).toBe(ruleName);
+      expect(warnings[0].line).toBe(3);
+    });
+  });
+});
