 #[test]
@@ -17,8 +13,16 @@ fn bytes_mut() {
     test!(BytesMut).assert_identical::<Bytes>();
 }
 
-fn is_array_of_u64(value: &Value) -> bool {
-    value
-        .as_array()
-        .is_some_and(|a| a.iter().all(Value::is_u64))
+#[test]
+fn small_integer_schemas_have_full_inclusive_ranges() {
+    assert_integer_range::<i8>(i8::MIN as f64, i8::MAX as f64);
+    assert_integer_range::<i16>(i16::MIN as f64, i16::MAX as f64);
+    assert_integer_range::<u8>(u8::MIN as f64, u8::MAX as f64);
+    assert_integer_range::<u16>(u16::MIN as f64, u16::MAX as f64);
+}
+
+fn assert_integer_range<T: JsonSchema>(minimum: f64, maximum: f64) {
+    let schema = serde_json::to_value(schemars::schema_for!(T)).unwrap();
+    assert_eq!(schema["minimum"].as_f64(), Some(minimum));
+    assert_eq!(schema["maximum"].as_f64(), Some(maximum));
 }
