+func TestRuleBasedScannerTrailingWhitespaceCompletes(t *testing.T) {
+	assert := assert.New(t)
+
+	stmt := "SELECT "
+	sc := NewRuleBased([]rune(stmt), ruleset.Default)
+	next := sc.Next()
+	assert.Equal(token.KeywordSelect, next.Type())
+	eof := sc.Next()
+	assert.Equal(token.EOF, eof.Type())
+}
