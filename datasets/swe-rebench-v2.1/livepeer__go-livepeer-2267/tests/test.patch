+
+type watcherEventClient struct {
+	latest  *MiniHeader
+	byHash  *MiniHeader
+	hashErr error
+	logs    []types.Log
+}
+
+func (c *watcherEventClient) HeaderByNumber(number *big.Int) (*MiniHeader, error) {
+	return c.latest, nil
+}
+
+func (c *watcherEventClient) HeaderByHash(hash common.Hash) (*MiniHeader, error) {
+	return c.byHash, c.hashErr
+}
+
+func (c *watcherEventClient) FilterLogs(query ethereum.FilterQuery) ([]types.Log, error) {
+	return c.logs, nil
+}
+
+func newBackfillWatcher(t *testing.T, headerErr error) (*Watcher, chan []*Event) {
+	t.Helper()
+	original := &MiniHeader{
+		Number: big.NewInt(FakeBlockNumber - 2),
+		Hash:   common.HexToHash("0x01"),
+	}
+	store := &stubMiniHeaderStore{headers: []*MiniHeader{original}}
+	client := &watcherEventClient{
+		latest:  &MiniHeader{Number: big.NewInt(FakeBlockNumber)},
+		byHash:  &MiniHeader{L1BlockNumber: big.NewInt(FakeL1BlockNumber)},
+		hashErr: headerErr,
+		logs:    []types.Log{logStub},
+	}
+	cfg := config
+	cfg.Store = store
+	cfg.Client = client
+	watcher := New(cfg)
+	events := make(chan []*Event, 1)
+	watcher.Subscribe(events)
+	return watcher, events
+}
+
+func TestBackfillEventEnrichmentPreservesHeader(t *testing.T) {
+	watcher, events := newBackfillWatcher(t, nil)
+	_ = watcher.BackfillEventsIfNeeded(context.Background())
+
+	select {
+	case got := <-events:
+		require.NotEmpty(t, got)
+		require.NotNil(t, got[0].BlockHeader)
+		assert.Equal(t, common.HexToHash(FakeHash), got[0].BlockHeader.Hash)
+		assert.Equal(t, big.NewInt(FakeBlockNumber), got[0].BlockHeader.Number)
+		assert.Equal(t, big.NewInt(FakeL1BlockNumber), got[0].BlockHeader.L1BlockNumber)
+		assert.Equal(t, []types.Log{logStub}, got[0].BlockHeader.Logs)
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for backfilled block event")
+	}
+}
+
+func TestBackfillEventEnrichmentFailurePreservesHeader(t *testing.T) {
+	watcher, events := newBackfillWatcher(t, errors.New("L1 header unavailable"))
+	_ = watcher.BackfillEventsIfNeeded(context.Background())
+
+	select {
+	case got := <-events:
+		require.NotEmpty(t, got)
+		require.NotNil(t, got[0].BlockHeader)
+		assert.Equal(t, common.HexToHash(FakeHash), got[0].BlockHeader.Hash)
+		assert.Equal(t, big.NewInt(FakeBlockNumber), got[0].BlockHeader.Number)
+		assert.Nil(t, got[0].BlockHeader.L1BlockNumber)
+		assert.Equal(t, []types.Log{logStub}, got[0].BlockHeader.Logs)
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for backfilled block event")
+	}
+}
