+/// `Raw::deserialize_content` is provided by an inherent `impl` block on `Raw`, so it must be
+/// callable without importing the (removed) `RawExt` trait.
+#[test]
+fn deserialize_content_is_an_inherent_method() {
+    let json_data = json!({
+        "answer": {
+            "type": "answer",
+            "sdp": "Hello"
+        },
+        "call_id": "foofoo",
+        "version": 1
+    });
+
+    let raw: Raw<AnyMessageLikeEventContent> = from_json_value(json_data).unwrap();
+
+    // No `RawExt` import is in scope here: this only compiles because `deserialize_content` is
+    // an inherent method on `Raw`.
+    let content = raw.deserialize_content("m.call.answer").unwrap();
+
+    assert_matches!(
+        content,
+        AnyMessageLikeEventContent::CallAnswer(CallAnswerEventContent {
+            answer: SessionDescription { session_type: SessionDescriptionType::Answer, sdp, .. },
+            call_id,
+            version,
+            ..
+        }) if sdp == "Hello" && call_id == "foofoo" && version == UInt::new(1).unwrap()
+    );
+}
+
+/// The `RawExt` extension trait must be removed: content deserialization is provided by an
+/// inherent `impl` block on `Raw`, and the old trait must no longer be part of the public API.
+///
+/// This is verified by compiling a small program that imports `ruma_common::events::RawExt`
+/// against the freshly built `ruma_common` crate; it must fail to compile.
+#[test]
+fn rawext_trait_is_removed() {
+    use std::{env, fs, process::Command};
+
+    let deps_dir = env::current_exe()
+        .expect("current test executable")
+        .parent()
+        .expect("test executable directory")
+        .to_owned();
+
+    let rlib = fs::read_dir(&deps_dir)
+        .expect("read dependency directory")
+        .filter_map(|entry| entry.ok())
+        .map(|entry| entry.path())
+        .filter(|path| {
+            path.file_name().and_then(|name| name.to_str()).map_or(false, |name| {
+                name.starts_with("libruma_common-") && name.ends_with(".rlib")
+            })
+        })
+        .max_by_key(|path| fs::metadata(path).and_then(|meta| meta.modified()).ok())
+        .expect("compiled `ruma_common` library");
+
+    let compile = |name: &str, source: &str| {
+        let unique = format!("ruma_rawext_{}_{}", std::process::id(), name);
+        let src_path = env::temp_dir().join(format!("{}.rs", unique));
+        let bin_path = env::temp_dir().join(unique);
+        fs::write(&src_path, source).expect("write probe source");
+
+        Command::new("rustc")
+            .arg("--edition=2018")
+            .arg("--crate-type=bin")
+            .arg("--extern")
+            .arg(format!("ruma_common={}", rlib.display()))
+            .arg("-L")
+            .arg(format!("dependency={}", deps_dir.display()))
+            .arg("-o")
+            .arg(&bin_path)
+            .arg(&src_path)
+            .output()
+            .expect("run rustc")
+    };
+
+    // Sanity check: a program that uses the public API must compile, so that a failure below
+    // is really caused by the missing trait and not by a broken probe setup.
+    let control = compile(
+        "control",
+        "use ruma_common::events::EventContent;\nfn main() { fn _assert<T: EventContent>() {} }\n",
+    );
+    assert!(
+        control.status.success(),
+        "control probe failed to compile:\n{}",
+        String::from_utf8_lossy(&control.stderr),
+    );
+
+    let probe = compile("probe", "use ruma_common::events::RawExt;\nfn main() {}\n");
+    assert!(
+        !probe.status.success(),
+        "`RawExt` must be removed, but importing it still compiles",
+    );
+}
