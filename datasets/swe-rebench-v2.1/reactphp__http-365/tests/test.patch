+
+    public function testServerCanBeConstructedWithUnlimitedPostSize()
+    {
+        $autoload = dirname(__DIR__) . '/vendor/autoload.php';
+        $code = 'require ' . var_export($autoload, true) . '; new \React\Http\Server(function () {});';
+        $command = escapeshellarg(PHP_BINARY) . ' -d post_max_size=0 -r ' . escapeshellarg($code);
+        $process = @proc_open($command, array(
+            0 => array('pipe', 'r'),
+            1 => array('pipe', 'w'),
+            2 => array('pipe', 'w')
+        ), $pipes, dirname(__DIR__));
+
+        if ($process === false) {
+            $this->markTestSkipped('Unable to start a PHP subprocess');
+        }
+
+        fclose($pipes[0]);
+        $output = stream_get_contents($pipes[1]);
+        fclose($pipes[1]);
+        $error = stream_get_contents($pipes[2]);
+        fclose($pipes[2]);
+
+        $this->assertSame(0, proc_close($process), $output . $error);
+    }
+
 }
