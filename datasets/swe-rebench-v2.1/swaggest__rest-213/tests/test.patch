+
+type contentTypeValidationInput struct {
+	Field1 string `json:"field1" formData:"field1" required:"true"`
+	Field2 int    `json:"field2" formData:"field2" required:"true"`
+}
+
+func (contentTypeValidationInput) ForceJSONRequestBody() {}
+
+func TestService_ContentTypeValidationForMultipleRepresentations(t *testing.T) {
+	type output struct {
+		Field1 string `json:"field1"`
+		Field2 int    `json:"field2"`
+	}
+
+	service := web.NewService(openapi31.NewReflector())
+	service.Post("/content-type-validation", usecase.NewIOI(new(contentTypeValidationInput), new(output),
+		func(_ context.Context, in, out interface{}) error {
+			input := in.(*contentTypeValidationInput)
+			result := out.(*output)
+			result.Field1 = input.Field1
+			result.Field2 = input.Field2
+			return nil
+		},
+	))
+
+	tests := []struct {
+		name         string
+		contentType  string
+		body         string
+		wantAccepted bool
+		wantField1   string
+		wantField2   int
+	}{
+		{
+			name:         "JSON request",
+			contentType:  "application/json",
+			body:         `{"field1":"json-value","field2":12}`,
+			wantAccepted: true,
+			wantField1:   "json-value",
+			wantField2:   12,
+		},
+		{
+			name:         "form request",
+			contentType:  "application/x-www-form-urlencoded",
+			body:         "field1=form-value&field2=34",
+			wantAccepted: true,
+			wantField1:   "form-value",
+			wantField2:   34,
+		},
+		{
+			name:         "JSON missing required field",
+			contentType:  "application/json",
+			body:         `{"field1":"json-value"}`,
+			wantAccepted: false,
+		},
+		{
+			name:         "form missing required field",
+			contentType:  "application/x-www-form-urlencoded",
+			body:         "field1=form-value",
+			wantAccepted: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			req, err := http.NewRequest(http.MethodPost, "/content-type-validation", strings.NewReader(tt.body))
+			require.NoError(t, err)
+			req.Header.Set("Content-Type", tt.contentType)
+			rw := httptest.NewRecorder()
+
+			service.ServeHTTP(rw, req)
+
+			accepted := rw.Code >= http.StatusOK && rw.Code < http.StatusMultipleChoices
+			assert.Equal(t, tt.wantAccepted, accepted, rw.Body.String())
+			if !tt.wantAccepted {
+				return
+			}
+
+			var got output
+			require.NoError(t, json.NewDecoder(rw.Body).Decode(&got))
+			assert.Equal(t, output{Field1: tt.wantField1, Field2: tt.wantField2}, got)
+		})
+	}
+}
