+function fq_nmod(a::FqNmodFiniteField, b::Vector{UInt})
+   r = a()
+   len = degree(a)
+   length(b) != len && error("Vector does not have correct length")
+   norm = 0
+   V = unsafe_wrap(Vector{UInt}, reinterpret(Ptr{UInt}, r.coeffs), len)
+   for i = 1:len
+      V[i] = b[i]
+      if b[i] != 0
+         norm = i
+      end
+   end
+   r.length = norm
+   return r
+end
