+    def laplacian(graph):
+        adjacency = torch.zeros(graph.num_nodes, graph.num_nodes)
+        adjacency[graph.edge_index[0], graph.edge_index[1]] = 1
+        return torch.diag(adjacency.sum(dim=1)) - adjacency
