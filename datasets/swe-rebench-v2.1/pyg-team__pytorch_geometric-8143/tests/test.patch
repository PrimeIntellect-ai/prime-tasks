+    vector1 = out1.x[:, 0]
+    vector2 = out2.x[:, 0]
+    # The graph is disconnected, so the requested eigenvalue is repeated.
+    # Check that both labelings produce non-zero vectors in the zero
+    # eigenspace, without constraining their scale or basis.
+    assert vector1.norm() > 0
+    assert vector2.norm() > 0
+    assert torch.allclose(laplacian1 @ vector1, torch.zeros_like(vector1),
