+fn ignored_argument_is_called_arg() {
+    let mut config = PackageConfig::default();
+    config.name = EcoString::from("test_project_name");
+    let modules = vec![("app.gleam", "pub fn one(_) { 1 }")];
+    assert!(compile(config, modules).contains("one(arg: a)"));
+}
+
+#[test]
+fn explicitly_typed_ignored_argument_is_called_arg() {
+    let mut config = PackageConfig::default();
+    config.name = EcoString::from("test_project_name");
+    let modules = vec![("app.gleam", "pub fn one(_: Int) { 1 }")];
+    assert!(compile(config, modules).contains("one(arg: Int)"));
+}
