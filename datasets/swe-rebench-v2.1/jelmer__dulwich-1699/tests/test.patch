+    def test_git_config_global(self) -> None:
+        # GIT_CONFIG_GLOBAL overrides the default global configuration paths.
+        with tempfile.TemporaryDirectory() as home_dir:
+            default_global = os.path.join(home_dir, ".gitconfig")
+            with open(default_global, "wb") as f:
+                f.write(b"[user]\n\tname = Default User\n")
+            self.overrideEnv("HOME", home_dir)
+            self.overrideEnv("XDG_CONFIG_HOME", None)
+
+            with tempfile.NamedTemporaryFile(
+                suffix=".gitconfig", delete=False
+            ) as global_config:
+                global_config.write(b"[user]\n\tname = Override User\n")
+                global_config.flush()
+                config_path = global_config.name
+
+            try:
+                self.overrideEnv("GIT_CONFIG_GLOBAL", config_path)
+                config = StackedConfig.default()
+                # The override must take effect: the default global config
+                # must not be consulted.
+                self.assertEqual(b"Override User", config.get((b"user",), b"name"))
+            finally:
+                os.unlink(config_path)
+
+    def test_git_config_system(self) -> None:
+        # GIT_CONFIG_SYSTEM overrides the default system configuration path.
+        with tempfile.NamedTemporaryFile(
+            suffix=".gitconfig", delete=False
+        ) as system_config:
+            system_config.write(b"[core]\n\tautocrlf = true\n")
+            system_config.flush()
+            config_path = system_config.name
+
+        try:
+            self.overrideEnv("GIT_CONFIG_SYSTEM", config_path)
+            self.overrideEnv("GIT_CONFIG_NOSYSTEM", None)
+            config = StackedConfig.default()
+            self.assertEqual(b"true", config.get((b"core",), b"autocrlf"))
+        finally:
+            os.unlink(config_path)
+
+    def test_git_config_nosystem_precedence(self) -> None:
+        # GIT_CONFIG_SYSTEM selects the system configuration path, while the
+        # existing GIT_CONFIG_NOSYSTEM setting still disables system
+        # configuration when no override is given.
+        with tempfile.NamedTemporaryFile(
+            suffix=".gitconfig", delete=False
+        ) as system_config:
+            system_config.write(b"[core]\n\ttest = value\n")
+            system_config.flush()
+            config_path = system_config.name
+
+        try:
+            # With GIT_CONFIG_SYSTEM set, the custom system config is used.
+            self.overrideEnv("GIT_CONFIG_SYSTEM", config_path)
+            self.overrideEnv("GIT_CONFIG_NOSYSTEM", None)
+            config = StackedConfig.default()
+            self.assertEqual(b"value", config.get((b"core",), b"test"))
+
+            # Without GIT_CONFIG_SYSTEM, GIT_CONFIG_NOSYSTEM disables the
+            # system configuration entirely.
+            self.overrideEnv("GIT_CONFIG_SYSTEM", None)
+            self.overrideEnv("GIT_CONFIG_NOSYSTEM", "1")
+            config = StackedConfig.default()
+            self.assertRaises(KeyError, config.get, (b"core",), b"test")
+        finally:
+            os.unlink(config_path)
+
 
