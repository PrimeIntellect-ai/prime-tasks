+// Resolve a CloudFormation intrinsic value into a plain string so the test can
+// assert on the resulting endpoint instead of a particular template encoding.
+// The contract only requires a valid ServiceEndpoint, so any intrinsic function
+// that resolves to the correct URL (Fn::Join, Fn::Sub, ...) is acceptable.
+const resolveValue = value => {
+  if (typeof value === 'string') {
+    return value;
+  }
+  if (value['Fn::Join']) {
+    const [delimiter, parts] = value['Fn::Join'];
+    return parts.map(resolveValue).join(delimiter);
+  }
+  if (value['Fn::Sub']) {
+    const sub = value['Fn::Sub'];
+    const template = Array.isArray(sub) ? sub[0] : sub;
+    const variables = Array.isArray(sub) ? sub[1] : {};
+    return template.replace(/\$\{([^}]+)\}/g, (match, name) => {
+      if (Object.prototype.hasOwnProperty.call(variables, name)) {
+        return resolveValue(variables[name]);
+      }
+      return resolveValue({ Ref: name });
+    });
+  }
+  if (value.Ref) {
+    switch (value.Ref) {
+      case 'AWS::Region':
+        return 'us-east-1';
+      case 'AWS::URLSuffix':
+        return 'amazonaws.com';
+      case 'AWS::Stage':
+        return 'dev';
+      case 'ApiGatewayRestApi':
+        return 'restApiId';
+      default:
+        return JSON.stringify(value);
+    }
+  }
+  return JSON.stringify(value);
+};
+
