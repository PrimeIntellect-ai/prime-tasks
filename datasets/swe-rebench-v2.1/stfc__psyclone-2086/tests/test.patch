+def test_generate_lfric_harness_logical_scalar(fortran_reader, fortran_writer):
+    """A logical kernel scalar is initialized, passed to the kernel, and is
+    omitted from the generated numeric inner-product sums."""
+    code = TL_CODE.replace("dimension(2)", "dimension(3)")
+    code = code.replace("gh_write, w3, cell_column",
+                        "gh_write, w3, gh_logical, cell_column")
+    code = code.replace(
+        "arg_type(gh_field,  gh_real, gh_write,  w3)  &",
+        "arg_type(gh_scalar, gh_logical, gh_read),       &\n"
+        "             arg_type(gh_field,  gh_real, gh_write,  w3)  &")
+    code = code.replace("nlayers, ascalar, field, ndf_w3",
+                        "nlayers, ascalar, logical_value, field, ndf_w3")
+    code = code.replace("real(kind=r_def), intent(in) :: ascalar\n",
+                        "real(kind=r_def), intent(in) :: ascalar\n"
+                        "    logical, intent(in) :: logical_value\n")
+    tl_psyir = fortran_reader.psyir_from_source(code)
+    harness = generate_lfric_adjoint_harness(tl_psyir)
+    generated = fortran_writer(harness).lower()
+
+    logical_decl = next(line for line in generated.splitlines()
+                        if re.search(r"\blogical\b.*::", line))
+    name_match = re.search(r"::\s*(\w+)", logical_decl)
+    assert name_match
+    logical_name = name_match.group(1)
+    compact = " ".join(generated.split())
+    logical_init = re.search(
+        r"\b" + re.escape(logical_name) + r"\s*=\s*\S+", compact)
+    kernel_call = re.search(
+        r"testkern_type\([^)]*\b" + re.escape(logical_name) + r"\b[^)]*\)",
+        compact)
+    assert logical_init and kernel_call
+    assert logical_init.start() < kernel_call.start()
+
+    inner_product_updates = [
+        line for line in generated.splitlines()
+        if re.search(r"(\w+)\s*=\s*\1\s*\+", line)]
+    assert inner_product_updates
+    assert not any(logical_name in line for line in inner_product_updates)
+
+
