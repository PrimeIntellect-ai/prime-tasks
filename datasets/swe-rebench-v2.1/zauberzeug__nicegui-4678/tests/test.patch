+def test_editing_after_emoji_updates_value(screen: Screen):
+    changes: List[str] = []
+    editor = ui.codemirror('a🙂b', on_change=lambda event: changes.append(event.value))
+
+    screen.open('/')
+    screen.find_element(editor).click()
+    screen.type(Keys.END + Keys.LEFT + 'x')
+    screen.wait_for(lambda: bool(changes))
+
+    assert changes[-1] == 'a🙂xb'
