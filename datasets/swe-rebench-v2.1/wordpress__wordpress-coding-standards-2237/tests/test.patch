+	/**
+	 * Ensure hierarchy accesses do not inherit a class name from an earlier expression.
+	 *
+	 * @return void
+	 */
+	public function testClassNameCaseDoesNotUseAnEarlierExpressionForHierarchyCalls() {
+		$temp_file = tempnam( sys_get_temp_dir(), 'wpcs-class-name-case-' );
+		$php_file  = $temp_file . '.php';
+		unlink( $temp_file );
+
+		$code = <<<'PHP'
+<?php
+class Foo {
+	public function bar() {
+		wp_styles();
+		self::foo();
+		wp_styles();
+		static::foo();
+		func( wp_styles(), self::method() );
+	}
+}
+PHP;
+
+		file_put_contents( $php_file, $code );
+
+		try {
+			$command = array(
+				dirname( __DIR__, 3 ) . '/vendor/bin/phpcs',
+				'-s',
+				'--standard=WordPress',
+				'--sniffs=WordPress.WP.ClassNameCase',
+				$php_file,
+			);
+			$process = proc_open(
+				$command,
+				array(
+					1 => array( 'pipe', 'w' ),
+					2 => array( 'pipe', 'w' ),
+				),
+				$pipes
+			);
+			$this->assertIsResource( $process );
+
+			$output = stream_get_contents( $pipes[1] ) . stream_get_contents( $pipes[2] );
+			fclose( $pipes[1] );
+			fclose( $pipes[2] );
+			$status = proc_close( $process );
+
+			$this->assertSame( 0, $status, $output );
+			$this->assertStringNotContainsString( 'ClassNameCase.Incorrect', $output );
+		} finally {
+			unlink( $php_file );
+		}
+	}
+
 }
