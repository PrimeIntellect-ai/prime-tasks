+import numpy as np
+from scipy.stats import kstest
+from scipy.special import gamma
+from scipy.integrate import cumtrapz
+
+
+def test_schechter_vdf():
+    from skypy.galaxies.velocity_dispersion import schechter_vdf
+
+    # test schechter velocity dispersion function
+    vd_min = 1
+    vd_max = 300
+    size = 5000
+    alpha = 2.32
+    beta = 2.67
+    vd_star = 161
+    resolution = 3000
+    phi_star = 8e-3
+    np.random.seed(0)
+    samples = schechter_vdf(alpha=alpha, beta=beta, vd_star=vd_star,
+                            vd_min=vd_min, vd_max=vd_max, size=size, resolution=resolution)
+
+    # test output is a numpy array of the requested size within the bounds
+    assert isinstance(samples, np.ndarray)
+    assert len(samples) == size
+    assert np.all(samples >= vd_min)
+    assert np.all(samples <= vd_max)
+
+    # test that sampling corresponds to sampling from the right pdf
+    def calc_pdf(vd):
+        return phi_star*(vd/vd_star)**alpha*np.exp(-(vd/vd_star)**beta) * \
+            (beta/gamma(alpha/beta))*(1/vd)
+
+    def calc_cdf(m):
+        pdf = calc_pdf(m)
+        cdf = cumtrapz(pdf, m, initial=0)
+        cdf /= cdf[-1]
+        return cdf
+
+    p_value = kstest(samples, calc_cdf)[1]
+    assert p_value > 1e-4
+
+
+def test_schechter_vdf_optional_arguments_default():
+    from inspect import signature
+    from skypy.galaxies.velocity_dispersion import schechter_vdf
+
+    parameters = signature(schechter_vdf).parameters
+    assert parameters["size"].default is None
+    assert parameters["resolution"].default == 1000
+
+    np.random.seed(0)
+    sample = schechter_vdf(alpha=2.32, beta=2.67, vd_star=161,
+                           vd_min=1, vd_max=300)
+
+    assert np.all(np.asarray(sample) >= 1)
+    assert np.all(np.asarray(sample) <= 300)
