+    /**
+     * Test that the excluded days text uses the excludeDaysLabel color, independent of the dates color
+     */
+    public function testExcludeDaysParameter(): void
+    {
+        $this->testParams["exclude_days"] = "Sun,Sat";
+        $this->testParams["excludeDaysLabel"] = "12ab34";
+        $this->testStats["excludedDays"] = ["Sun", "Sat"];
+        $render = generateOutput($this->testStats, $this->testParams)["body"];
+
+        preg_match_all("/<text\\b([^>]*)>(.*?)<\\/text>/s", $render, $textElements, PREG_SET_ORDER);
+        $excludeDaysTextAttributes = null;
+        $ordinaryDateTextAttributes = null;
+        foreach ($textElements as $textElement) {
+            if (strpos($textElement[2], "* Excluding Sun, Sat") !== false) {
+                $excludeDaysTextAttributes = $textElement[1];
+            }
+            if (strpos($textElement[2], " - ") !== false) {
+                $ordinaryDateTextAttributes = $textElement[1];
+            }
+        }
+        $this->assertNotNull($excludeDaysTextAttributes, "The excluded-days text should be rendered.");
+        $this->assertNotNull($ordinaryDateTextAttributes, "An ordinary date range should be rendered.");
+        $this->assertEquals("12ab34", $this->svgFillColor($excludeDaysTextAttributes));
+        $this->assertEquals("999999", $this->svgFillColor($ordinaryDateTextAttributes));
+    }
+
+    /**
+     * Get the fill color of an SVG element's attributes, normalized to lowercase hex digits without a leading "#"
+     */
+    private function svgFillColor(string $attributes): ?string
+    {
+        if (!preg_match("/\\sfill=[\"']#?([^\"']*)[\"']/i", " " . $attributes, $match)) {
+            return null;
+        }
+        return strtolower($match[1]);
+    }
 }
