--- a/compiler-core/src/parse/tests.rs
+++ b/compiler-core/src/parse/tests.rs
@@ -1672,3 +1672,45 @@ type Wibble {
 "#
     );
 }
+
+#[test]
+// https://github.com/gleam-lang/gleam/issues/3870
+fn nested_tuple_access_after_function() {
+    assert!(
+        crate::parse::parse_statement_sequence("tuple().0.1").is_ok(),
+        "nested tuple access after a function call should parse"
+    );
+}
+
+// https://github.com/gleam-lang/gleam/issues/3870
+#[test]
+fn nested_tuple_access_after_function_call_compiles() {
+    let src = "fn tups_int() -> #(#(Int), #(Int)) {
+  #(#(1), #(2))
+}
+pub fn main() -> Int {
+  tups_int().0.0
+}
+";
+    let result = crate::type_::tests::compile_module("test_module", src, None, vec![]);
+    assert!(
+        result.is_ok(),
+        "expected the module to compile without errors"
+    );
+}
+
+// https://github.com/gleam-lang/gleam/issues/3870
+#[test]
+fn nested_tuple_access_after_function_call_is_formatted_on_one_line() {
+    let src = "pub fn main() {
+  tups_int().0.0
+}
+";
+    let mut writer = String::new();
+    crate::format::pretty(&mut writer, &src.into(), camino::Utf8Path::new("<stdin>"))
+        .expect("should format");
+    assert!(
+        writer.lines().any(|line| line.contains("tups_int().0.0")),
+        "the nested tuple-access chain should remain on one line"
+    );
+}
