+
+@pytest.mark.parametrize("na_option", ["top", "bottom"])
+def test_groupby_op_with_nullables(na_option):
+    # GH 54206
+    df = DataFrame({"x": [None]}, dtype="Float64")
+    result = df.groupby("x", dropna=False)["x"].rank(method="min", na_option=na_option)
+
+    df_numpy = df.astype("float64")
+    expected = df_numpy.groupby("x", dropna=False)["x"].rank(
+        method="min", na_option=na_option
+    )
+    tm.assert_series_equal(result, expected, check_dtype=False)
+
+
+@pytest.mark.parametrize("na_option", ["top", "bottom"])
+@pytest.mark.parametrize("dtype", ["Float64", "Int64"])
+def test_groupby_op_with_nullables_mixed_values(na_option, dtype):
+    values = [2, pd.NA, 1, pd.NA, 3]
+    df = DataFrame({"group": ["a", "a", "a", "b", "b"], "value": values})
+    df["value"] = df["value"].astype(dtype)
+
+    result = df.groupby("group")["value"].rank(method="min", na_option=na_option)
+
+    df_numpy = df.astype({"value": "float64"})
+    expected = df_numpy.groupby("group")["value"].rank(
+        method="min", na_option=na_option
+    )
+    tm.assert_series_equal(result, expected, check_dtype=False)
