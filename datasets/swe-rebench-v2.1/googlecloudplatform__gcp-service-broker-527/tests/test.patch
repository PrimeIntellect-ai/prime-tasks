+func TestDeleteCredentialsRemovesServiceAccountFromProjectPolicy(t *testing.T) {
+	const email = "service@example.iam.gserviceaccount.com"
+	const otherMember = "user:keep@example.com"
+	const anotherOtherMember = "user:also-keep@example.com"
+	var updatedPolicy *cloudresourcemanager.Policy
+	var policyUpdated, accountDeleted bool
+
+	transport := deleteCredentialsPolicyTransportFunc(func(req *http.Request) (*http.Response, error) {
+		var status int
+		var body string
+		switch {
+		case req.URL.Host == "token.example":
+			status, body = http.StatusOK, `{"access_token":"test-token","token_type":"Bearer","expires_in":3600}`
+		case strings.Contains(req.URL.Path, ":getIamPolicy"):
+			status, body = http.StatusOK, `{"bindings":[{"role":"roles/viewer","members":["serviceAccount:`+email+`","`+otherMember+`"]},{"role":"roles/editor","members":["serviceAccount:`+email+`","`+anotherOtherMember+`"]}]}`
+		case strings.Contains(req.URL.Path, ":setIamPolicy"):
+			var request cloudresourcemanager.SetIamPolicyRequest
+			if err := json.NewDecoder(req.Body).Decode(&request); err != nil {
+				t.Errorf("decode project policy update: %v", err)
+			}
+			updatedPolicy = request.Policy
+			policyUpdated = true
+			status, body = http.StatusOK, `{}`
+		case strings.Contains(req.URL.Path, "/serviceAccounts/") && req.Method == http.MethodDelete:
+			accountDeleted = true
+			status, body = http.StatusOK, `{}`
+		default:
+			t.Errorf("unexpected request: %s %s", req.Method, req.URL)
+			status, body = http.StatusNotFound, `{}`
+		}
+		return &http.Response{
+			StatusCode: status,
+			Header:     make(http.Header),
+			Body:       io.NopCloser(strings.NewReader(body)),
+			Request:    req,
+		}, nil
+	})
+
+	key, err := rsa.GenerateKey(rand.Reader, 1024)
+	if err != nil {
+		t.Fatal(err)
+	}
+	privateKey := pem.EncodeToMemory(&pem.Block{
+		Type:  "RSA PRIVATE KEY",
+		Bytes: x509.MarshalPKCS1PrivateKey(key),
+	})
+	ctx := context.WithValue(context.Background(), oauth2.HTTPClient, &http.Client{Transport: transport})
+	manager := &ServiceAccountManager{
+		ProjectId: "project",
+		HttpConfig: &jwt.Config{
+			Email:      "broker@example.com",
+			PrivateKey: privateKey,
+			Scopes:     []string{"https://www.googleapis.com/auth/cloud-platform"},
+			TokenURL:   "https://token.example/token",
+		},
+	}
+	details, err := json.Marshal(ServiceAccountInfo{
+		Email:    email,
+		UniqueId: "unique-id",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	err = manager.DeleteCredentials(ctx, models.ServiceBindingCredentials{
+		OtherDetails: string(details),
+	})
+	if err != nil {
+		t.Fatalf("DeleteCredentials returned an error: %v", err)
+	}
+	if !policyUpdated {
+		t.Fatal("expected the project IAM policy to be updated")
+	}
+	if !accountDeleted {
+		t.Fatal("expected the service account to be deleted")
+	}
+	if updatedPolicy == nil {
+		t.Fatal("expected the updated project policy to be returned")
+	}
+	members := utils.NewStringSet()
+	for _, binding := range updatedPolicy.Bindings {
+		members.Add(binding.Members...)
+	}
+	if members.Contains("serviceAccount:" + email) {
+		t.Fatalf("service account %q remains in the updated project policy", email)
+	}
+	if !members.Contains(otherMember) {
+		t.Fatalf("unrelated policy member %q was not preserved", otherMember)
+	}
+	if !members.Contains(anotherOtherMember) {
+		t.Fatalf("unrelated policy member %q was not preserved", anotherOtherMember)
+	}
+}
+
+type deleteCredentialsPolicyTransportFunc func(*http.Request) (*http.Response, error)
+
+func (f deleteCredentialsPolicyTransportFunc) RoundTrip(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
