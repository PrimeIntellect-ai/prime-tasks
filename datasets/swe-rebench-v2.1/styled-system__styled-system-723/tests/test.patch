@@ -270,3 +270,21 @@ test('sorts media queries when responsive object values are used', () => {
     'padding',
   ])
 })
+
+test('transforms values using the resolved scale and other props', () => {
+  const parser = system({
+    margin: {
+      property: 'margin',
+      scale: 'space',
+      transform: (n, scale, props) => {
+        const m = props.multiply || 1
+        return m * scale[n]
+      }
+    }
+  })
+  const theme = { space: { 8: 5, 12: 7 } }
+  const a = parser({ theme, margin: 8 })
+  const b = parser({ theme, margin: 12, multiply: 2 })
+  expect(a).toEqual({ margin: 5 })
+  expect(b).toEqual({ margin: 14 })
+})
