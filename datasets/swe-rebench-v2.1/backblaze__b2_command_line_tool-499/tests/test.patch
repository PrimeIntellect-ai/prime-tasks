+    def test_reauthorize_with_app_key(self):
+        # authorize and create a key
+        self._authorize_account()
+        key = self.api.create_key(['listBuckets'], 'key1')
+
+        # authorize with the key
+        self.api.authorize_account('production', key['applicationKeyId'], key['applicationKey'])
+
+        # Expiry is observable on an operation that uses the issued token.
+        auth_token = self.account_info.get_account_auth_token()
+        self.raw_api.expire_auth_token(auth_token)
+        try:
+            self.raw_api.list_buckets(
+                self.account_info.get_api_url(),
+                auth_token,
+                self.account_info.get_account_id(),
+            )
+        except InvalidAuthToken as error:
+            self.assertEqual('auth_token_expired', error.code)
+        else:
+            self.fail('an expired authorization token must be rejected')
+
+        # The API client should reauthorize with the application key and continue.
+        self.api.list_buckets()
+
