+/// When `with_symbol_table` is enabled, an address that has no DWARF debug
+/// information must still resolve through the object file's symbol table.
+#[test]
+fn release_fixture_symbol_table_fallback() {
+    let (target, debug) = release_fixture_path();
+    let mappings = get_test_addresses(target.as_path());
+
+    // A mapping that only consults DWARF debug information.
+    let mut dwarf_only = addr2line::Options::default()
+        .with_functions()
+        .build(&debug)
+        .unwrap();
+
+    // A mapping that also falls back to the symbol table.
+    let mut with_symbols = addr2line::Options::default()
+        .with_functions()
+        .with_symbol_table()
+        .build(&debug)
+        .unwrap();
+
+    let symbol_names = text_symbol_names(target.as_path());
+    let mut fallback_hits = 0;
+    for addr in mappings {
+        // Addresses with no DWARF information resolve to `None` when the
+        // symbol table is not consulted.
+        if dwarf_only.locate(addr).unwrap().is_some() {
+            continue;
+        }
+
+        // With the symbol table enabled, the address must resolve to a
+        // location that carries the symbol's function name.
+        if let Some((_, _, func)) = with_symbols.locate(addr).unwrap() {
+            let func = func.expect("symbol-table fallback with function lookup has a name");
+            assert!(
+                symbol_names.get(&addr).map_or(false, |names| names.contains(func.as_ref())),
+                "fallback name {:?} for {:#x} is not a text symbol name",
+                func,
+                addr
+            );
+            fallback_hits += 1;
+        }
+    }
+
+    assert_ne!(fallback_hits, 0);
+}
+
+/// Obtain the names of text symbols, allowing aliases at the same address.
+fn text_symbol_names(target: &path::Path) -> HashMap<u64, HashSet<String>> {
+    let output = process::Command::new("/usr/bin/nm")
+        .arg(target)
+        .output()
+        .expect("failed to execute nm");
+    let mut names = HashMap::new();
+    for line in String::from_utf8_lossy(&output.stdout).lines() {
+        let mut fields = line.split_whitespace();
+        let address = match fields.next().and_then(|value| u64::from_str_radix(value, 16).ok()) {
+            Some(address) => address,
+            None => continue,
+        };
+        match fields.next() {
+            Some("T") | Some("t") => {}
+            _ => continue,
+        }
+        if let Some(name) = fields.next() {
+            names.entry(address).or_insert_with(HashSet::new).insert(name.to_owned());
+        }
+    }
+    names
+}
