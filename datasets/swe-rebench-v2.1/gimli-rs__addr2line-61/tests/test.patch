+/// The file component of a location, which may be optional or a plain path
+/// (an empty path means that no file is known).
+trait FileComponent {
+    fn to_file_str(&self) -> Option<Cow<str>>;
+}
+
+impl FileComponent for Option<PathBuf> {
+    fn to_file_str(&self) -> Option<Cow<str>> {
+        self.as_ref().map(|f| f.to_string_lossy())
+    }
+}
+
+impl FileComponent for PathBuf {
+    fn to_file_str(&self) -> Option<Cow<str>> {
+        if self.as_os_str().is_empty() {
+            None
+        } else {
+            Some(self.to_string_lossy())
+        }
+    }
+}
