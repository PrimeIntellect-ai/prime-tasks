+    @Test
+    public void willPropagateExceptions_toScenarioStacktrace() throws Exception {
+        String scenariosJsonAsString = SmartUtils.readJsonAsString("unit_test_files/java_apis/03_test_json_java_service_method_Exception.json");
+        final ScenarioSpec scenarioSpec = smartUtils.getMapper().readValue(scenariosJsonAsString, ScenarioSpec.class);
+
+        ZeroCodeMultiStepsScenarioRunner scenarioRunner = injector.getInstance(ZeroCodeMultiStepsScenarioRunner.class);
+
+        final List<Failure> failures = new ArrayList<>();
+        RunNotifier notifier = new RunNotifier();
+        notifier.addListener(new RunListener() {
+            @Override
+            public void testFailure(Failure failure) {
+                failures.add(failure);
+            }
+        });
+
+        PrintStream originalErr = System.err;
+        ByteArrayOutputStream capturedErr = new ByteArrayOutputStream();
+        System.setErr(new PrintStream(capturedErr, true));
+        try {
+            Description description = Description.createTestDescription(JavaMethodExecutorImplTest.class, "scenarioException");
+            scenarioRunner.runScenario(scenarioSpec, notifier, description);
+        } finally {
+            System.setErr(originalErr);
+        }
+
+        // The scenario must report that the Java API operation failed.
+        assertThat(failures.isEmpty(), is(false));
+
+        // The exception thrown by the java api operation and its stacktrace must be shown
+        // as part of the scenario stacktrace
+        StringBuilder scenarioStackTrace = new StringBuilder(capturedErr.toString());
+        for (Failure failure : failures) {
+            StringWriter failureTrace = new StringWriter();
+            failure.getException().printStackTrace(new PrintWriter(failureTrace));
+            scenarioStackTrace.append(failureTrace);
+        }
+        String reportedStackTrace = scenarioStackTrace.toString();
+        String originalMessage;
+        try {
+            Double.parseDouble("not-a-number");
+            throw new AssertionError("Expected invalid input to fail parsing");
+        } catch (NumberFormatException originalException) {
+            originalMessage = originalException.getMessage();
+        }
+        assertThat(reportedStackTrace, containsString(originalMessage));
+        assertThat(reportedStackTrace, containsString("java.lang.Double.parseDouble"));
+    }
+
+}
