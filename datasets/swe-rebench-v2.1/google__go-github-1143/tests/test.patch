+func callRepositoriesPagesMethod(t *testing.T, client *Client, name, owner, repo string) []reflect.Value {
+	t.Helper()
+	method := reflect.ValueOf(client.Repositories).MethodByName(name)
+	if !method.IsValid() {
+		t.Errorf("RepositoriesService does not expose %s", name)
+		return nil
+	}
+	return method.Call([]reflect.Value{reflect.ValueOf(context.Background()), reflect.ValueOf(owner), reflect.ValueOf(repo)})
+}
+
+func assertPagesResultType(t *testing.T, results []reflect.Value, index int, want reflect.Type) {
+	t.Helper()
+	if results[index].Type() != want {
+		t.Errorf("result %d has type %v, want %v", index, results[index].Type(), want)
+	}
+}
+
+func assertPagesMethodSucceeded(t *testing.T, results []reflect.Value, wantResults int, name string) {
+	t.Helper()
+	if results == nil {
+		return
+	}
+	if len(results) != wantResults {
+		t.Fatalf("%s returned %d values, want %d", name, len(results), wantResults)
+	}
+	if !results[wantResults-1].IsNil() {
+		t.Errorf("Repositories.%s returned error: %v", name, results[wantResults-1].Interface())
+	}
+}
+
+func assertPagesMethodReturnedError(t *testing.T, results []reflect.Value, wantResults int, name string) {
+	t.Helper()
+	if results == nil {
+		return
+	}
+	if len(results) != wantResults {
+		t.Fatalf("%s returned %d values, want %d", name, len(results), wantResults)
+	}
+	if results[wantResults-1].IsNil() {
+		t.Errorf("Repositories.%s returned no error", name)
+	}
+}
+
+func assertPagesField(t *testing.T, value reflect.Value, name string, want interface{}) {
+	t.Helper()
+	got := pagesFieldValue(t, value, name)
+	if got.IsValid() && !reflect.DeepEqual(got.Interface(), want) {
+		t.Errorf("Pages field %s = %v, want %v", name, got.Interface(), want)
+	}
+}
+
+func pagesFieldValue(t *testing.T, value reflect.Value, name string) reflect.Value {
+	t.Helper()
+	if !value.IsValid() {
+		t.Errorf("cannot read Pages field %s from an invalid value", name)
+		return reflect.Value{}
+	}
+	for value.Kind() == reflect.Interface || value.Kind() == reflect.Ptr {
+		if value.IsNil() {
+			t.Errorf("cannot read Pages field %s from a nil value", name)
+			return reflect.Value{}
+		}
+		value = value.Elem()
+	}
+	field := value.FieldByName(name)
+	if !field.IsValid() {
+		t.Errorf("Pages response has no %s field", name)
+		return reflect.Value{}
+	}
+	if field.Kind() == reflect.Interface || field.Kind() == reflect.Ptr {
+		if field.IsNil() {
+			t.Errorf("Pages response field %s is nil", name)
+			return reflect.Value{}
+		}
+		field = field.Elem()
+	}
+	return field
+}
