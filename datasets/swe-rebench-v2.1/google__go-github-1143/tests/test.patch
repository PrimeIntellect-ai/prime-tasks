+
+	mux.HandleFunc("/repos/o/r/pages", func(w http.ResponseWriter, r *http.Request) {
+		testMethod(t, r, "DELETE")
+		if accept := strings.Join(r.Header["Accept"], ", "); !strings.Contains(accept, "application/vnd.github.switcheroo-preview+json") {
+			t.Errorf("Accept header %q does not include switcheroo preview media type", accept)
+		}
+	})
+
+	results := callRepositoriesPagesMethod(t, client, "DisablePages", "o", "r")
+	assertPagesMethodSucceeded(t, results, 2, "DisablePages")
+	if results != nil {
+		assertPagesResultType(t, results, 0, reflect.TypeOf((*Response)(nil)))
+		assertPagesResultType(t, results, 1, reflect.TypeOf((*error)(nil)).Elem())
+	}
+}
