+func TestPagesPreview_EnablePages(t *testing.T) {
+	client, mux, _, teardown := setup()
+	defer teardown()
+
+	mux.HandleFunc("/repos/o/r/pages", func(w http.ResponseWriter, r *http.Request) {
+		testMethod(t, r, "POST")
+		accept := strings.Join(r.Header["Accept"], ", ")
+		for _, want := range []string{"application/vnd.github.switcheroo-preview+json", "application/vnd.github.mister-fantastic-preview+json"} {
+			if !strings.Contains(accept, want) {
+				t.Errorf("Accept header %q does not include %q", accept, want)
+			}
+		}
+		fmt.Fprint(w, `{"url":"u","status":"s","cname":"c","custom_404":false,"html_url":"h", "source": {"branch":"master", "path":"/"}}`)
+	})
+
+	results := callRepositoriesPagesMethod(t, client, "EnablePages", "o", "r")
+	if results == nil {
+		return
+	}
+	if len(results) != 3 {
+		t.Fatalf("EnablePages returned %d values, want 3", len(results))
+	}
+	assertPagesResultType(t, results, 0, reflect.TypeOf((*Pages)(nil)))
+	assertPagesResultType(t, results, 1, reflect.TypeOf((*Response)(nil)))
+	assertPagesResultType(t, results, 2, reflect.TypeOf((*error)(nil)).Elem())
+	if !results[2].IsNil() {
+		t.Fatalf("Repositories.EnablePages returned error: %v", results[2].Interface())
+	}
+
+	page := results[0]
+	assertPagesField(t, page, "URL", "u")
+	assertPagesField(t, page, "Status", "s")
+	assertPagesField(t, page, "CNAME", "c")
+	assertPagesField(t, page, "Custom404", false)
+	assertPagesField(t, page, "HTMLURL", "h")
+	source := pagesFieldValue(t, page, "Source")
+	assertPagesField(t, source, "Branch", "master")
+	assertPagesField(t, source, "Path", "/")
+}
