+def test_rarfile_is_not_a_mandatory_dependency() -> None:
+    project = tomli.loads(open('pyproject.toml', encoding='utf-8').read())
+    dependency_names = {
+        re.match(r'\s*([A-Za-z0-9][A-Za-z0-9._-]*)', dependency).group(1).lower()
+        for dependency in project['project']['dependencies']
+    }
+    assert 'rarfile' not in dependency_names
+
+
+def test_scan_videos_without_rarfile(tmp_path) -> None:
+    """Subliminal remains usable when the optional rarfile dependency is not installed."""
+    (tmp_path / 'movie.rar').write_bytes(b'not a rar archive')
+    code = (
+        "import sys\n"
+        "sys.modules['rarfile'] = None\n"
+        "import subliminal\n"
+        "videos = subliminal.scan_videos(r'{}', archives=True)\n"
+        "assert videos == [], videos\n"
+    ).format(tmp_path)
+    result = subprocess.run([sys.executable, '-c', code], capture_output=True, text=True)
+    assert result.returncode == 0, result.stderr
