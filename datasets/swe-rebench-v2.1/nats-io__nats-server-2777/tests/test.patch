+func TestJetStreamMaxStoreString(t *testing.T) {
+	// A quoted string value for the JetStream storage options should be
+	// accepted and converted to a byte count.
+	conf := createConfFile(t, []byte(`
+jetstream {
+max_file_store: "200M"
+max_memory_store: "1G"
+}
+`))
+	defer removeFile(t, conf)
+
+	opts, err := ProcessConfigFile(conf)
+	if err != nil {
+		t.Fatalf("Error processing config file: %v", err)
+	}
+	if opts.JetStreamMaxStore != 200*1024*1024 {
+		t.Fatalf("Expected max_file_store to be %v, got %v", 200*1024*1024, opts.JetStreamMaxStore)
+	}
+	if opts.JetStreamMaxMemory != 1024*1024*1024 {
+		t.Fatalf("Expected max_memory_store to be %v, got %v", 1024*1024*1024, opts.JetStreamMaxMemory)
+	}
+
+	// Numeric values should keep working.
+	conf = createConfFile(t, []byte(`
+jetstream {
+max_file_store: 100
+max_memory_store: 200
+}
+`))
+	defer removeFile(t, conf)
+
+	opts, err = ProcessConfigFile(conf)
+	if err != nil {
+		t.Fatalf("Error processing config file: %v", err)
+	}
+	if opts.JetStreamMaxStore != 100 {
+		t.Fatalf("Expected max_file_store to be 100, got %v", opts.JetStreamMaxStore)
+	}
+	if opts.JetStreamMaxMemory != 200 {
+		t.Fatalf("Expected max_memory_store to be 200, got %v", opts.JetStreamMaxMemory)
+	}
+
+	// An empty string is treated as zero.
+	conf = createConfFile(t, []byte(`
+jetstream {
+max_file_store: ""
+}
+`))
+	defer removeFile(t, conf)
+
+	opts, err = ProcessConfigFile(conf)
+	if err != nil {
+		t.Fatalf("Error processing config file: %v", err)
+	}
+	if opts.JetStreamMaxStore != 0 {
+		t.Fatalf("Expected max_file_store to be 0, got %v", opts.JetStreamMaxStore)
+	}
+
+	// Malformed strings, unsupported suffixes and unsupported types should be
+	// rejected with an error.
+	for _, tc := range []string{`"abc"`, `"1L"`, `"TT"`, `true`} {
+		conf = createConfFile(t, []byte(fmt.Sprintf(`
+jetstream {
+max_file_store: %s
+}
+`, tc)))
+		if _, err := ProcessConfigFile(conf); err == nil {
+			t.Fatalf("Expected an error for max_file_store: %s", tc)
+		}
+		removeFile(t, conf)
+	}
+}
