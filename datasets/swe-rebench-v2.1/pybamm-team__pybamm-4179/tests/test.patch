+    def test_legacy_electrode_diffusivity_parameter_values(self):
+        # Regression test for the documented legacy ParameterValues scenario:
+        # a parameter set that uses the old "electrode diffusivity" key must
+        # still be usable in a simulation.
+        parameter_values = pybamm.ParameterValues("Chen2020")
+        parameter_values.update(
+            {
+                "Negative electrode diffusivity [m2.s-1]": parameter_values[
+                    "Negative particle diffusivity [m2.s-1]"
+                ],
+            },
+            check_already_exists=False,
+        )
+        del parameter_values["Negative particle diffusivity [m2.s-1]"]
+
+        model = pybamm.lithium_ion.DFN()
+        experiment = pybamm.Experiment(["Discharge at 1C until 3 V"])
+        sim = pybamm.Simulation(
+            model, parameter_values=parameter_values, experiment=experiment
+        )
+        sol = sim.solve()
+        voltage = sol["Voltage [V]"].data
+        self.assertGreater(len(voltage), 0)
+        self.assertTrue(all(v == v for v in voltage))
 
