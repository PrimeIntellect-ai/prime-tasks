diff --git a/test/src/commands/create/e2e/flutter_package/flutter_pkg_test.dart b/test/src/commands/create/e2e/flutter_package/flutter_pkg_test.dart
new file mode 100644
index 0000000..f52bce7
--- /dev/null
+++ b/test/src/commands/create/e2e/flutter_package/flutter_pkg_test.dart
@@ -0,0 +1,48 @@
+import 'package:mason/mason.dart';
+import 'package:path/path.dart' as path;
+import 'package:pubspec_parse/pubspec_parse.dart';
+import 'package:test/test.dart';
+import 'package:universal_io/io.dart';
+
+import '../../../../../helpers/helpers.dart';
+
+void main() {
+  test(
+    'flutter_pkg creates a Flutter package with the requested description',
+    withRunner((commandRunner, logger, updater, logs) async {
+      final directory = Directory.systemTemp.createTempSync();
+      addTearDown(() => directory.deleteSync(recursive: true));
+      const projectName = 'very_good_flutter';
+      const description = 'A reusable example Flutter package.';
+
+      final result = await commandRunner.run(
+        [
+          'create',
+          'flutter_pkg',
+          projectName,
+          '-o',
+          directory.path,
+          '--description',
+          description,
+        ],
+      );
+
+      expect(result, equals(ExitCode.success.code));
+
+      final projectDirectory = path.join(directory.path, projectName);
+      final pubspec = File(path.join(projectDirectory, 'pubspec.yaml'));
+      expect(pubspec.existsSync(), isTrue);
+      final parsedPubspec = Pubspec.parse(pubspec.readAsStringSync());
+      expect(parsedPubspec.name, projectName);
+      expect(parsedPubspec.description, description);
+      expect(parsedPubspec.dependencies.containsKey('flutter'), isTrue);
+
+      final libraryFiles = Directory(path.join(projectDirectory, 'lib'))
+          .listSync(recursive: true)
+          .whereType<File>()
+          .where((file) => path.extension(file.path) == '.dart');
+      expect(libraryFiles, isNotEmpty);
+    }),
+    timeout: const Timeout(Duration(minutes: 2)),
+  );
+}
