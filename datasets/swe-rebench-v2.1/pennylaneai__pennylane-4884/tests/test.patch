+class TestAdditionalCond:
+    """Test additional/misc functionality relating to qml.cond"""
+
+    def test_map_wires(self):
+        """Conditional control measurements are remapped with their script."""
+        with qml.queuing.AnnotatedQueue() as q:
+            m_0 = qml.measure(0)
+            qml.cond(m_0, qml.PauliX)(1)
+
+        script = qml.tape.QuantumScript.from_queue(q)
+        [mapped_script], _ = qml.map_wires(script, {0: "a", 1: "b"})
+        mapped_cond = mapped_script.operations[1]
+        [mapped_measurement] = mapped_cond.meas_val.measurements
+        assert list(mapped_measurement.wires) == ["a"]
+
+    def test_map_wires_for_compound_measurement_value(self):
+        """All measurements controlling a conditional are remapped with its script."""
+        with qml.queuing.AnnotatedQueue() as q:
+            m_0 = qml.measure(0)
+            m_1 = qml.measure(1)
+            qml.cond(m_0 + m_1, qml.PauliX)(2)
+
+        script = qml.tape.QuantumScript.from_queue(q)
+        [mapped_script], _ = qml.map_wires(
+            script, {0: "control-a", 1: "control-b", 2: "target"}
+        )
+        [mapped_cond] = [
+            op for op in mapped_script.operations if isinstance(op, qml.ops.Conditional)
+        ]
+        mapped_wires = {
+            wire
+            for measurement in mapped_cond.meas_val.measurements
+            for wire in measurement.wires
+        }
+
+        assert mapped_wires == {"control-a", "control-b"}
+
+
