+    /**
+     * Once the table directory has been prepared, writing a page must not recreate it:
+     * if the directory has been removed, the write has to fail instead of silently
+     * recreating the directory hierarchy.
+     */
+    @Test
+    public void testWritePageFailsWhenTableDirectoryIsRemoved() throws Exception {
+        Path base = folder.newFolder().toPath();
+        try (FileDataStorageManager man = new FileDataStorageManager(base);) {
+            man.initTable("test1", "table1");
+            deleteRecursively(base);
+            List<Record> page = Arrays.asList(
+                new Record(Bytes.from_int(1), Bytes.from_int(2)));
+            try {
+                man.writePage("test1", "table1", 1L, page);
+                fail("writePage must fail when the table directory has been removed");
+            } catch (DataStorageManagerException expected) {
+                // expected: the directory is not recreated on every page write
+            }
+        }
+    }
+
+    /**
+     * Same as {@link #testWritePageFailsWhenTableDirectoryIsRemoved()} for index pages.
+     */
+    @Test
+    public void testWriteIndexPageFailsWhenIndexDirectoryIsRemoved() throws Exception {
+        Path base = folder.newFolder().toPath();
+        try (FileDataStorageManager man = new FileDataStorageManager(base);) {
+            man.initIndex("test1", "table1");
+            deleteRecursively(base);
+            byte[] page = Bytes.intToByteArray(1);
+            try {
+                man.writeIndexPage("test1", "table1", 1L, (out) -> {
+                    out.writeArray(page);
+                });
+                fail("writeIndexPage must fail when the index directory has been removed");
+            } catch (DataStorageManagerException expected) {
+                // expected: the directory is not recreated on every page write
+            }
+        }
+    }
+
+    private static void deleteRecursively(Path path) throws IOException {
+        if (!Files.exists(path)) {
+            return;
+        }
+        try (Stream<Path> walk = Files.walk(path);) {
+            walk.sorted(Comparator.reverseOrder()).forEach(p -> {
+                try {
+                    Files.delete(p);
+                } catch (IOException err) {
+                    throw new UncheckedIOException(err);
+                }
+            });
+        }
+    }
+
