+    public function testConfiguredPluginOrderDoesNotEmitDeprecation()
+    {
+        $deprecations = array();
+        set_error_handler(function ($severity, $message) use (&$deprecations) {
+            if ($severity === E_DEPRECATED && strpos($message, '::$pluginOrder') !== false) {
+                $deprecations[] = $message;
+                return true;
+            }
+            return false;
+        });
+
+        try {
+            $plugins = new PluginRegister(array('test-plugin2', 'test-plugin1'));
+            $plugins->getPluginsJS();
+        } finally {
+            restore_error_handler();
+        }
+
+        $this->assertSame(array(), $deprecations);
+    }
+
+    public function testGlobalPluginsDoNotEmitDeprecation()
+    {
+        $deprecations = array();
+        set_error_handler(function ($severity, $message) use (&$deprecations) {
+            if ($severity === E_DEPRECATED) {
+                if (strpos($message, 'VocabularyConfig::$globalPlugins') !== false) {
+                    $deprecations[] = $message;
+                }
+                return true;
+            }
+            return false;
+        });
+
+        try {
+            $graph = new EasyRdf\Graph();
+            $resource = $graph->resource('http://example.org/vocabulary');
+            $vocabularyConfig = new VocabularyConfig($resource, array('global-plugin'));
+            $vocabularyConfig->getPluginArray();
+        } finally {
+            restore_error_handler();
+        }
+
+        $this->assertSame(array(), $deprecations);
+    }
+
