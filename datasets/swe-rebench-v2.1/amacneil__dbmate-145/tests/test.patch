+// TestMainRedactsPasswordInStderr verifies that the redactor is applied to the
+// error text written to stderr, not merely available as a helper.
+func TestMainRedactsPasswordInStderr(t *testing.T) {
+	if os.Getenv("DBMATE_TEST_RUN_MAIN") == "1" {
+		os.Args = []string{"dbmate", "up"}
+		main()
+		return
+	}
+
+	cmd := exec.Command(os.Args[0], "-test.run=TestMainRedactsPasswordInStderr")
+	env := []string{}
+	for _, e := range os.Environ() {
+		if strings.HasPrefix(e, "DATABASE_URL=") || strings.HasPrefix(e, "DBMATE_TEST_RUN_MAIN=") {
+			continue
+		}
+		env = append(env, e)
+	}
+	env = append(env,
+		"DBMATE_TEST_RUN_MAIN=1",
+		"DATABASE_URL=mysql://username:otS33+tb/e4=@localhost:3306/database",
+	)
+	cmd.Env = env
+
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	cmd.Stdout = &bytes.Buffer{}
+
+	_ = cmd.Run()
+
+	out := stderr.String()
+	require.NotContains(t, out, "otS33+tb/e4=")
+}
