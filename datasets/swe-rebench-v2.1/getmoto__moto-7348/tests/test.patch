+@mock_aws
+def test_too_many_key_schema_attributes():
+    ddb = boto3.resource("dynamodb", "us-east-1")
+    TableName = "my_test_"
+
+    AttributeDefinitions = [
+        {"AttributeName": "UUID", "AttributeType": "S"},
+        {"AttributeName": "ComicBook", "AttributeType": "S"},
+        {"AttributeName": "Creator", "AttributeType": "S"},
+    ]
+
+    KeySchema = [
+        {"AttributeName": "UUID", "KeyType": "HASH"},
+        {"AttributeName": "ComicBook", "KeyType": "RANGE"},
+        {"AttributeName": "Creator", "KeyType": "RANGE"},
+    ]
+
+    ProvisionedThroughput = {"ReadCapacityUnits": 5, "WriteCapacityUnits": 5}
+
+    with pytest.raises(Exception):
+        ddb.create_table(
+            TableName=TableName,
+            KeySchema=KeySchema,
+            AttributeDefinitions=AttributeDefinitions,
+            ProvisionedThroughput=ProvisionedThroughput,
+        )
+
+
+@mock_aws
+def test_create_table_returns_requested_secondary_indexes():
+    dynamodb = boto3.client("dynamodb", region_name="us-east-1")
+    created = dynamodb.create_table(
+        TableName="indexes-table",
+        BillingMode="PAY_PER_REQUEST",
+        KeySchema=[{"AttributeName": "pk", "KeyType": "HASH"}],
+        AttributeDefinitions=[
+            {"AttributeName": "pk", "AttributeType": "S"},
+            {"AttributeName": "local_sk", "AttributeType": "S"},
+            {"AttributeName": "gsi_pk", "AttributeType": "S"},
+            {"AttributeName": "gsi_sk", "AttributeType": "S"},
+        ],
+        LocalSecondaryIndexes=[
+            {
+                "IndexName": "local-index",
+                "KeySchema": [
+                    {"AttributeName": "pk", "KeyType": "HASH"},
+                    {"AttributeName": "local_sk", "KeyType": "RANGE"},
+                ],
+                "Projection": {"ProjectionType": "ALL"},
+            }
+        ],
+        GlobalSecondaryIndexes=[
+            {
+                "IndexName": "global-index",
+                "KeySchema": [
+                    {"AttributeName": "gsi_pk", "KeyType": "HASH"},
+                    {"AttributeName": "gsi_sk", "KeyType": "RANGE"},
+                ],
+                "Projection": {"ProjectionType": "ALL"},
+            }
+        ],
+    )
+
+    description = created["TableDescription"]
+    local_indexes = {
+        index["IndexName"]: index for index in description["LocalSecondaryIndexes"]
+    }
+    global_indexes = {
+        index["IndexName"]: index for index in description["GlobalSecondaryIndexes"]
+    }
+    assert set(local_indexes) == {"local-index"}
+    assert set(global_indexes) == {"global-index"}
+    assert {
+        (key["AttributeName"], key["KeyType"])
+        for key in local_indexes["local-index"]["KeySchema"]
+    } == {("pk", "HASH"), ("local_sk", "RANGE")}
+    assert {
+        (key["AttributeName"], key["KeyType"])
+        for key in global_indexes["global-index"]["KeySchema"]
+    } == {("gsi_pk", "HASH"), ("gsi_sk", "RANGE")}
+
+
+@mock_aws
+def test_create_table_reports_pay_per_request_billing_mode():
+    dynamodb = boto3.client("dynamodb", region_name="us-east-1")
+    dynamodb.create_table(
+        TableName="on-demand-table",
+        BillingMode="PAY_PER_REQUEST",
+        KeySchema=[{"AttributeName": "pk", "KeyType": "HASH"}],
+        AttributeDefinitions=[{"AttributeName": "pk", "AttributeType": "S"}],
+    )
+
+    description = dynamodb.describe_table(TableName="on-demand-table")["Table"]
+    assert description["BillingModeSummary"]["BillingMode"] == "PAY_PER_REQUEST"
