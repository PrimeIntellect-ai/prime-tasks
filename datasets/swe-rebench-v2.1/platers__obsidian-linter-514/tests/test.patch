+describe('File Name Heading', () => {
+  it('Inserts the heading on the line after the frontmatter of the file when it is the only thing in the file', () => {
+    const rule = FileNameHeading.getRule();
+    const before = dedent`
+      ---
+      hello: test
+      ---
+    `;
+
+    const result = rule.apply(before, {fileName: 'Test note'});
+
+    // The front matter must be preserved as-is.
+    expect(result).toContain('---\nhello: test\n---');
+    // The heading must be added below the front matter on its own line.
+    // The contract allows the heading to be separated from the closing
+    // delimiter by a blank line, so accept one or more newlines here.
+    expect(result).toMatch(/^---\nhello: test\n---\n+# Test note\s*$/);
+  });
+});
