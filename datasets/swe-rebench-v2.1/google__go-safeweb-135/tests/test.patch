+func TestIncomingRequestMultipartRemoveFiles(t *testing.T) {
+	tmpDir, err := os.MkdirTemp("", "safehttp-multipart-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(tmpDir)
+	t.Setenv("TMPDIR", tmpDir)
+
+	content := strings.Repeat("x", 1024)
+	body := "--123\r\n" +
+		"Content-Disposition: form-data; name=\"file\"; filename=\"large-file\"\r\n" +
+		"\r\n" + content + "\r\n" +
+		"--123--\r\n"
+	r := safehttptest.NewRequest(safehttp.MethodPost, "/", strings.NewReader(body))
+	r.Header.Set("Content-Type", `multipart/form-data; boundary="123"`)
+
+	f, err := r.MultipartForm(1)
+	if err != nil {
+		t.Fatalf("r.MultipartForm(1): %v", err)
+	}
+	defer func() {
+		if err := removeMultipartFiles(f); err != nil {
+			t.Errorf("f.RemoveFiles(): %v", err)
+		}
+	}()
+
+	files, err := os.ReadDir(tmpDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(files) == 0 {
+		t.Fatal("multipart parsing did not create a temporary file")
+	}
+
+	if err := removeMultipartFiles(f); err != nil {
+		t.Fatalf("f.RemoveFiles(): %v", err)
+	}
+	files, err = os.ReadDir(tmpDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(files) != 0 {
+		t.Errorf("temporary files remain after cleanup: %v", files)
+	}
+}
+
+func multipartFiles(t *testing.T, f *safehttp.MultipartForm, param string) []*multipart.FileHeader {
+	t.Helper()
+	form, ok := interface{}(f).(interface {
+		File(string) []*multipart.FileHeader
+	})
+	if !ok {
+		t.Fatal("MultipartForm does not provide file access")
+	}
+	return form.File(param)
+}
+
+func removeMultipartFiles(f *safehttp.MultipartForm) error {
+	if form, ok := interface{}(f).(interface {
+		RemoveFiles() error
+	}); ok {
+		return form.RemoveFiles()
+	}
+	if form, ok := interface{}(f).(interface {
+		RemoveFiles()
+	}); ok {
+		form.RemoveFiles()
+		return nil
+	}
+	return errors.New("MultipartForm does not provide file cleanup")
+}
