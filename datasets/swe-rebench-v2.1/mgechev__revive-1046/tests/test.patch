@@ -13,3 +16,54 @@ func TestReceiverNamingTypeParams(t *testing.T) {
 	}
 	testRule(t, "receiver-naming-issue-669", &rule.ReceiverNamingRule{})
 }
+
+func TestRepeatedArgumentInvalidTypes(t *testing.T) {
+	fixture := "../testdata/receiver-naming-issue-1040.go"
+	source, err := os.ReadFile(fixture)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	repeated := &rule.EnforceRepeatedArgTypeStyleRule{}
+	linter := lint.New(func(filename string) ([]byte, error) {
+		return os.ReadFile(filename)
+	}, 0)
+	failures, err := linter.Lint([][]string{{fixture}}, []lint.Rule{
+		&rule.UnexportedReturnRule{},
+		repeated,
+	}, lint.Config{Rules: map[string]lint.RuleConfig{
+		repeated.Name(): {Arguments: []any{"short"}},
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var repeatedArgumentLines []int
+	for failure := range failures {
+		if failure.RuleName == repeated.Name() {
+			repeatedArgumentLines = append(repeatedArgumentLines, failure.Position.Start.Line)
+		}
+	}
+
+	lineFor := func(signature string) int {
+		index := strings.Index(string(source), signature)
+		if index < 0 {
+			t.Fatalf("fixture is missing signature %q", signature)
+		}
+		return strings.Count(string(source[:index]), "\n") + 1
+	}
+	findingsByLine := make(map[int]bool, len(repeatedArgumentLines))
+	for _, line := range repeatedArgumentLines {
+		findingsByLine[line] = true
+	}
+	if line := lineFor("func genuineRepeated(a int, b int) {}"); !findingsByLine[line] {
+		t.Errorf("genuine repeated argument types on line %d were not reported; findings were at lines %v", line, repeatedArgumentLines)
+	}
+	for _, signature := range []string{
+		"func invalidDistinct(a missing.Value, b otherMissing.Value) {}",
+	} {
+		if line := lineFor(signature); findingsByLine[line] {
+			t.Errorf("invalid argument types on line %d were reported as repeated; findings were at lines %v", line, repeatedArgumentLines)
+		}
+	}
+}
