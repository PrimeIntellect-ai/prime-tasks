+
+    private function verifyNullableStringPropertyWithMinLengthValidatesCorrectly(): void
+    {
+        $temporaryDirectory = sys_get_temp_dir() . '/jane-nullable-min-length-' . uniqid('', true);
+        mkdir($temporaryDirectory);
+        $schemaFile = $temporaryDirectory . '/openapi.json';
+        $configFile = $temporaryDirectory . '/.jane-openapi';
+        $generatedDirectory = $temporaryDirectory . '/Generated';
+        $namespace = 'Jane\\Component\\JsonSchema\\Tests\\Validation\\GeneratedNullable';
+
+        file_put_contents($schemaFile, json_encode([
+            'openapi' => '3.0.3',
+            'info' => ['title' => 'Nullable validation', 'version' => '1.0.0'],
+            'paths' => new \stdClass(),
+            'components' => [
+                'schemas' => [
+                    'NullableString' => [
+                        'type' => 'object',
+                        'properties' => [
+                            'name' => [
+                                'type' => 'string',
+                                'minLength' => 1,
+                                'nullable' => true,
+                            ],
+                        ],
+                    ],
+                ],
+            ],
+        ]));
+        file_put_contents($configFile, '<?php return ' . var_export([
+            'openapi-file' => $schemaFile,
+            'namespace' => $namespace,
+            'directory' => $generatedDirectory,
+            'validation' => true,
+        ], true) . ';');
+
+        $command = new \Jane\Component\OpenApiCommon\Console\Command\GenerateCommand(
+            new \Jane\Component\OpenApiCommon\Console\Loader\ConfigLoader(),
+            new \Jane\Component\OpenApiCommon\Console\Loader\SchemaLoader(),
+            new \Jane\Component\OpenApiCommon\Console\Loader\OpenApiMatcher()
+        );
+        $input = new ArrayInput(['--config-file' => $configFile], $command->getDefinition());
+        $command->execute($input, new NullOutput());
+
+        spl_autoload_register(static function (string $class) use ($namespace, $generatedDirectory): void {
+            $prefix = $namespace . '\\';
+            if (0 === strpos($class, $prefix)) {
+                $file = $generatedDirectory . '/' . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
+                if (is_file($file)) {
+                    require_once $file;
+                }
+            }
+        });
+
+        $normalizerClass = $namespace . '\\Normalizer\\NullableStringNormalizer';
+        $modelClass = $namespace . '\\Model\\NullableString';
+        $normalizer = new $normalizerClass();
+        $data = $normalizer->denormalize(['name' => null], $modelClass);
+        self::assertInstanceOf($modelClass, $data);
+        self::assertNull($data->getName());
+
+        $caughtException = null;
+        try {
+            $normalizer->denormalize(['name' => ''], $modelClass);
+        } catch (\Throwable $exception) {
+            $caughtException = $exception;
+        }
+
+        self::assertInstanceOf($namespace . '\\Runtime\\Normalizer\\ValidationException', $caughtException);
+    }
 }
