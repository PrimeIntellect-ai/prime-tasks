+describe('Repeated linting of math indicators', () => {
+  it('does not duplicate text preceding a block-math delimiter on subsequent passes', () => {
+    const rule = MoveMathBlockIndicatorsToOwnLine.getRule();
+    const firstPass = rule.apply('a$$b$$');
