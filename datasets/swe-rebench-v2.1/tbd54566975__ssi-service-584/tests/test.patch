+func TestServiceKeyIsUnaffectedByKeyStoreID(t *testing.T) {
+	for _, test := range testutil.TestDatabases {
+		t.Run(test.Name, func(t *testing.T) {
+			db := test.ServiceStorage(t)
+			require.NotEmpty(t, db)
+
+			keyStoreRouter, keyStoreService, _ := testKeyStore(t, db)
+			storeKey := func(id string) *httptest.ResponseRecorder {
+				_, privateKey, err := crypto.GenerateKeyByKeyType(crypto.Ed25519)
+				require.NoError(t, err)
+				privateKeyBytes, err := crypto.PrivKeyToBytes(privateKey)
+				require.NoError(t, err)
+
+				request := router.StoreKeyRequest{
+					ID:               id,
+					Type:             crypto.Ed25519,
+					Controller:       "did:test:caller",
+					PrivateKeyBase58: base58.Encode(privateKeyBytes),
+				}
+				response := httptest.NewRecorder()
+				storeRequest := httptest.NewRequest(http.MethodPut, "https://ssi-service.com/v1/keys", newRequestValue(t, request))
+				keyStoreRouter.StoreKey(newRequestContext(response, storeRequest))
+				return response
+			}
+
+			const callerKeyID = "caller-key-for-service-key-isolation"
+			callerKeyResponse := storeKey(callerKeyID)
+			require.True(t, util.Is2xxResponse(callerKeyResponse.Code))
+
+			// An implementation may reject the reserved ID. If it accepts the write,
+			// it must not replace the key used to encrypt the caller's stored key.
+			storeKey("ssi-service-key")
+
+			gotKey, err := keyStoreService.GetKey(context.Background(), keystore.GetKeyRequest{ID: callerKeyID})
+			require.NoError(t, err)
+			require.NotNil(t, gotKey)
+			assert.Equal(t, callerKeyID, gotKey.ID)
+		})
+	}
+}
