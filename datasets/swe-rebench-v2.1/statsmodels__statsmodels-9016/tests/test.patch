+
+
+def _get_pacf_axes(obj):
+    # plot_pacf may return either a Figure or an Axes.
+    if hasattr(obj, "get_xlim"):
+        return obj
+    return obj.axes[0]
+
+
+@pytest.mark.matplotlib
+def test_plot_pacf_small_sample():
+    idx = [pd.Timestamp.now() + pd.Timedelta(seconds=i) for i in range(10)]
+    df = pd.DataFrame(
+        index=idx,
+        columns=["a"],
+        data=list(range(10))
+    )
+    fig = plot_pacf(df)
+    # GH 9016: the default number of lags must be capped at 50% of the
+    # sample size so that the call does not raise for small samples.
+    ax = _get_pacf_axes(fig)
+    plotted_lags = np.asarray(ax.lines[-1].get_xdata())
+    assert plotted_lags.max() <= len(df) // 2
