+func TestDecModeWithSharedTagsMaxLimits(t *testing.T) {
+	tags := NewTagSet()
+	dm, err := DecOptions{MaxArrayElements: 2147483647, MaxMapPairs: 2147483647}.DecModeWithSharedTags(tags)
+	if err != nil {
+		t.Fatalf("DecModeWithSharedTags() returned error %v", err)
+	}
+	if got := dm.DecOptions().MaxArrayElements; got != 2147483647 {
+		t.Errorf("DecOptions().MaxArrayElements = %d, want %d", got, 2147483647)
+	}
+	if got := dm.DecOptions().MaxMapPairs; got != 2147483647 {
+		t.Errorf("DecOptions().MaxMapPairs = %d, want %d", got, 2147483647)
+	}
+}
+
+func TestDecModeWithSharedTagsInvalidMaxLimits(t *testing.T) {
+	tags := NewTagSet()
+	testCases := []struct {
+		name         string
+		opts         DecOptions
+		wantErrorMsg string
+	}{
+		{
+			name:         "MaxArrayElements > 2147483647",
+			opts:         DecOptions{MaxArrayElements: 2147483648},
+			wantErrorMsg: "cbor: invalid MaxArrayElements 2147483648 (range is [16, 2147483647])",
+		},
+		{
+			name:         "MaxMapPairs > 2147483647",
+			opts:         DecOptions{MaxMapPairs: 2147483648},
+			wantErrorMsg: "cbor: invalid MaxMapPairs 2147483648 (range is [16, 2147483647])",
+		},
+	}
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := tc.opts.DecModeWithSharedTags(tags)
+			if err == nil {
+				t.Errorf("DecModeWithSharedTags() didn't return an error")
+			} else if err.Error() != tc.wantErrorMsg {
+				t.Errorf("DecModeWithSharedTags() returned error %q, want %q", err.Error(), tc.wantErrorMsg)
+			}
+		})
+	}
+}
