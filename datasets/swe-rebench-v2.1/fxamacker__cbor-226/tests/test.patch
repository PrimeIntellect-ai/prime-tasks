+func TestDecModeMaxArrayElementsUpperBound(t *testing.T) {
+	for _, v := range []int{134217729, 2147483647} {
+		dm, err := DecOptions{MaxArrayElements: v}.DecMode()
+		if err != nil {
+			t.Errorf("DecMode() with MaxArrayElements %d returned error %v", v, err)
+			continue
+		}
+		if got := dm.DecOptions().MaxArrayElements; got != v {
+			t.Errorf("DecOptions().MaxArrayElements = %d, want %d", got, v)
+		}
+	}
+}
