+"use strict";
+
+const stylelint = require("stylelint");
+const ruleName = "scss/block-no-redundant-nesting";
+
+testRule({
+  ruleName,
+  config: true,
+  customSyntax: "postcss-scss",
+
+  accept: [
+    {
+      code: `
+        .foo .bar {}
+        .foo-bar {}
+        .foo {
+          color: red;
+        }
+      `,
+      description: "no nesting"
+    },
+    {
+      code: `
+        .foo {
+          .bar {}
+          &-baz {}
+        }
+      `,
+      description: "multiple child blocks"
+    },
+    {
+      code: `
+        .foo,
+        .bar {
+            &-baz {}
+        }
+      `,
+      description: "multiple outer selectors"
+    },
+    {
+      code: `
+        .foo {
+          .bar, .baz {}
+        }
+      `,
+      description: "multiple inner selectors"
+    },
+    {
+      code: `
+        .foo {
+            color: red;
+
+            &-baz {}
+        }
+      `,
+      description: "property and single child block"
+    },
+    {
+      code: `
+        .foo {
+            &-baz {}
+
+            @media (min-width: 10px) {}
+        }
+      `,
+      description: "at-rule and single child block"
+    },
+    {
+      code: `
+        .foo {
+          font: {
+            size: 16px;
+          }
+        }
+      `,
+      description: "Sass' nested properties"
+    }
+  ],
+
+  reject: []
+});
+
+describe("reports redundant nesting", () => {
+  const config = {
+    plugins: ["./src"],
+    rules: { [ruleName]: true }
+  };
+
+  async function warningCount(code) {
+    const result = await stylelint.lint({
+      code,
+      customSyntax: "postcss-scss",
+      config
+    });
+
+    return result.results[0].warnings.length;
+  }
+
+  test("reports a single nested child without an ampersand", async () => {
+    expect(await warningCount(`
+      .foo {
+        .bar {}
+      }
+    `)).toBe(1);
+  });
+
+  test("reports a single ampersand-prefixed child containing a declaration", async () => {
+    expect(await warningCount(`
+      .foo {
+        &-bar {
+          color: red;
+        }
+      }
+    `)).toBe(1);
+  });
+
+  test("reports nesting when a selector's comma is not a selector-list separator", async () => {
+    expect(await warningCount(`
+      .foo:not(.bar, .baz) {
+        .bar {}
+      }
+    `)).toBe(1);
+  });
+
+  test("reports each single-child level in separate nested blocks", async () => {
+    expect(await warningCount(`
+      .foo {
+        .bar {}
+      }
+      .foo {
+        &-bar {
+          &-baz {
+            color: red;
+          }
+        }
+      }
+    `)).toBe(3);
+  });
+});
