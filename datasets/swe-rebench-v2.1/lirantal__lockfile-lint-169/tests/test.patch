diff --git a/packages/lockfile-lint-api/__tests__/parseNpmLockfile3.test.js b/packages/lockfile-lint-api/__tests__/parseNpmLockfile3.test.js
new file mode 100644
index 0000000..a6ec76b
--- /dev/null
+++ b/packages/lockfile-lint-api/__tests__/parseNpmLockfile3.test.js
@@ -0,0 +1,81 @@
+/* eslint-disable no-new */
+'use strict'
+
+const ParseLockfile = require('../src/ParseLockfile')
+const path = require('path')
+const childProcess = require('child_process')
+
+describe('ParseLockfile v3 Npm', () => {
+  it('parsing an npm lockfile returns an object with packages', () => {
+    const mockNpmLockfilePath = path.join(__dirname, './__fixtures__/package-lock-v3.json')
+    const options = {
+      lockfilePath: mockNpmLockfilePath,
+      lockfileType: 'npm'
+    }
+    const parser = new ParseLockfile(options)
+    const lockfile = parser.parseSync()
+
+    expect(lockfile.type).toEqual('success')
+    const packages = Object.values(lockfile.object)
+    expect(packages).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({
+          version: '4.3.4',
+          resolved: 'http://registry.npmjs.org/debug/-/debug-4.3.4.tgz',
+          integrity: expect.stringMatching(/^sha1-/)
+        })
+      ])
+    )
+  })
+
+  it('the HTTPS option validates package URLs in an npm v3 lockfile', () => {
+    const lockfilePath = path.join(__dirname, './__fixtures__/package-lock-v3.json')
+    const cliPath = path.join(__dirname, '../../lockfile-lint/bin/lockfile-lint.js')
+    const result = childProcess.spawnSync(process.execPath, [
+      cliPath,
+      '--type', 'npm',
+      '--path', lockfilePath,
+      '--validate-https'
+    ], {encoding: 'utf8'})
+
+    expect(result.status).toBe(1)
+  })
+
+  it('the integrity option validates package hashes in an npm v3 lockfile', () => {
+    const lockfilePath = path.join(__dirname, './__fixtures__/package-lock-v3.json')
+    const cliPath = path.join(__dirname, '../../lockfile-lint/bin/lockfile-lint.js')
+    const result = childProcess.spawnSync(process.execPath, [
+      cliPath,
+      '--type', 'npm',
+      '--path', lockfilePath,
+      '--validate-integrity'
+    ], {encoding: 'utf8'})
+
+    expect(result.status).toBe(1)
+  })
+
+  it('parsing an npm lockfile with invalid content throws an error', () => {
+    const mockNpmLockfilePath = path.join(__dirname, './__fixtures__/bad-package-lock-v3.json')
+    const options = {
+      lockfilePath: mockNpmLockfilePath,
+      lockfileType: 'npm'
+    }
+    const parser = new ParseLockfile(options)
+    expect(() => parser.parseSync()).toThrowError(
+      `Unable to parse npm lockfile "${mockNpmLockfilePath}"`
+    )
+  })
+
+  it('parsing an npm lockfile with no packages doesnt trigger an error', () => {
+    const mockNpmLockfilePath = path.join(__dirname, './__fixtures__/package-lock-v3-empty.json')
+    const options = {
+      lockfilePath: mockNpmLockfilePath,
+      lockfileType: 'npm'
+    }
+    const parser = new ParseLockfile(options)
+    const lockfile = parser.parseSync()
+
+    expect(lockfile.type).toEqual('success')
+    expect(lockfile.object).toEqual({})
+  })
+})
