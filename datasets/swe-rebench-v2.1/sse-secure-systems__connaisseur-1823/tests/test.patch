+// workloadImages returns the image references of all containers of a workload
+// object in a stable order, so tests can verify that validation does not mutate
+// the workload's image references.
+func workloadImages(wlo *kubernetes.WorkloadObject) []string {
+	images := []string{}
+	for _, c := range wlo.Containers {
+		images = append(images, c.Image)
+	}
+	for _, c := range wlo.InitContainers {
+		images = append(images, c.Image)
+	}
+	for _, c := range wlo.EphemeralContainers {
+		images = append(images, c.Image)
 	}
+	return images
 }
 
