+func TestApplyToPodSpec(t *testing.T) {
+	runAsUser := int64(1001)
+	runAsUser0 := int64(0)
+	priority := int32(100)
+
+	abstractPodTemplate := &dfv1.AbstractPodTemplate{
+		Metadata: &dfv1.Metadata{
+			Annotations: map[string]string{"my-annotation-name": "my-annotation-value"},
+			Labels:      map[string]string{"my-label-name": "my-label-value"},
+		},
+		NodeSelector: map[string]string{"my-node-selector-name": "my-node-selector-value"},
+		SecurityContext: &corev1.PodSecurityContext{
+			RunAsUser:  &runAsUser,
+			RunAsGroup: &runAsUser0,
+		},
+		Tolerations: []corev1.Toleration{{
+			Key: "my-toleration-key", Operator: "Equal", Value: "my-toleration-value", Effect: "NoSchedule",
+		}},
+		ImagePullSecrets:  []corev1.LocalObjectReference{{Name: "template-image-pull-secret"}},
+		PriorityClassName: "my-priority-class-name",
+		Priority:          &priority,
+		Affinity: &corev1.Affinity{
+			NodeAffinity: &corev1.NodeAffinity{
+				RequiredDuringSchedulingIgnoredDuringExecution: &corev1.NodeSelector{
+					NodeSelectorTerms: []corev1.NodeSelectorTerm{{
+						MatchExpressions: []corev1.NodeSelectorRequirement{{Key: "m", Operator: "n", Values: []string{"o"}}},
+					}},
+				},
+			},
+		},
+		ServiceAccountName: "template-sa",
+	}
+
+	podSpec := &corev1.PodSpec{
+		ServiceAccountName: "spec-sa",
+		ImagePullSecrets:   []corev1.LocalObjectReference{{Name: "spec-image-pull-secret"}},
+	}
+	abstractPodTemplate.ApplyToPodSpec(podSpec)
+
+	assert.Equal(t, abstractPodTemplate.NodeSelector, podSpec.NodeSelector)
+	assert.Equal(t, abstractPodTemplate.Tolerations, podSpec.Tolerations)
+	assert.Equal(t, abstractPodTemplate.SecurityContext, podSpec.SecurityContext)
+	assert.Equal(t, abstractPodTemplate.PriorityClassName, podSpec.PriorityClassName)
+	assert.Equal(t, abstractPodTemplate.Priority, podSpec.Priority)
+	assert.Equal(t, abstractPodTemplate.Affinity, podSpec.Affinity)
+}
+
+func TestVertexServiceAccountOverridesPipelineTemplate(t *testing.T) {
+	const namespace = "test-ns"
+	const pipelineName = "test-pipeline"
+	const vertexName = "test-pipeline-cat"
+
+	scheme := runtime.NewScheme()
+	require.NoError(t, corev1.AddToScheme(scheme))
+	require.NoError(t, dfv1.AddToScheme(scheme))
+
+	isbsvc := &dfv1.InterStepBufferService{
+		ObjectMeta: metav1.ObjectMeta{Namespace: namespace, Name: dfv1.DefaultISBSvcName},
+		Spec:       dfv1.InterStepBufferServiceSpec{Redis: &dfv1.RedisBufferService{Native: &dfv1.NativeRedis{Version: "test"}}},
+	}
+	isbsvc.Status.MarkConfigured()
+	isbsvc.Status.MarkDeployed()
+
+	pipeline := &dfv1.Pipeline{
+		ObjectMeta: metav1.ObjectMeta{Namespace: namespace, Name: pipelineName},
+		Spec: dfv1.PipelineSpec{
+			Templates: &dfv1.Templates{VertexTemplate: &dfv1.VertexTemplate{
+				AbstractPodTemplate: dfv1.AbstractPodTemplate{Metadata: &dfv1.Metadata{}, ServiceAccountName: "template-sa"},
+			}},
+		},
+	}
+	vertex := &dfv1.Vertex{
+		ObjectMeta: metav1.ObjectMeta{Namespace: namespace, Name: vertexName},
+		Spec: dfv1.VertexSpec{
+			PipelineName: pipelineName,
+			AbstractVertex: dfv1.AbstractVertex{
+				Name: "cat", UDF: &dfv1.UDF{Builtin: &dfv1.Function{Name: "cat"}},
+				AbstractPodTemplate: dfv1.AbstractPodTemplate{ServiceAccountName: "test-two"},
+			},
+		},
+	}
+
+	cl := fake.NewClientBuilder().WithScheme(scheme).WithObjects(isbsvc, pipeline, vertex).Build()
+	r := vertexcontroller.NewReconciler(
+		cl, scheme, reconciler.FakeGlobalConfig(t, nil), "test-image", scaling.NewScaler(cl),
+		zaptest.NewLogger(t).Sugar(), record.NewFakeRecorder(10),
+	)
+	_, err := r.Reconcile(context.Background(), ctrl.Request{NamespacedName: types.NamespacedName{Namespace: namespace, Name: vertexName}})
+	require.NoError(t, err)
+
+	pods := &corev1.PodList{}
+	require.NoError(t, cl.List(context.Background(), pods, client.InNamespace(namespace), client.MatchingLabels(map[string]string{dfv1.KeyVertexName: "cat"})))
+	require.NotEmpty(t, pods.Items)
+	assert.Equal(t, "test-two", pods.Items[0].Spec.ServiceAccountName)
+}
