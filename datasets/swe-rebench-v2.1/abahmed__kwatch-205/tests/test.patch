+func TestSlackLegacyWebhookWithoutChannel(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var payload map[string]interface{}
+		if err := json.NewDecoder(r.Body).Decode(&payload); err != nil {
+			http.Error(w, "invalid payload", http.StatusBadRequest)
+			return
+		}
+		if channel, ok := payload["channel"].(string); ok && channel == "<nil>" {
+			http.Error(w, "unknown channel", http.StatusNotFound)
+			return
+		}
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("ok"))
+	}))
+	defer server.Close()
+
+	provider := slack.NewSlack(map[string]interface{}{"webhook": server.URL}, &config.App{ClusterName: "dev"})
+	if assert.NotNil(t, provider) {
+		assert.NoError(t, provider.SendMessage("hello"))
+	}
+}
