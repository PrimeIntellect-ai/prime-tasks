+
+// https://github.com/dtolnay/async-trait/issues/234
+pub mod issue234 {
+    #![allow(rust_2021_compatibility)]
+
+    use async_trait::async_trait;
+
+    pub struct Droppable;
+
+    impl Drop for Droppable {
+        fn drop(&mut self) {}
+    }
+
+    pub struct Tuple<T, U>(T, U);
+
+    #[async_trait]
+    pub trait Trait {
+        async fn f(arg: Tuple<Droppable, i32>);
+    }
+
+    pub struct UnderscorePattern;
+
+    #[async_trait]
+    impl Trait for UnderscorePattern {
+        async fn f(Tuple(_, _int): Tuple<Droppable, i32>) {}
+    }
+
+    pub struct DotDotPattern;
+
+    #[async_trait]
+    impl Trait for DotDotPattern {
+        async fn f(Tuple { 1: _int, .. }: Tuple<Droppable, i32>) {}
+    }
+}
+
+#[test]
+fn drop_behavior_is_independent_of_callers_edition() {
+    let source = r#"
+use async_trait::async_trait;
+use std::sync::atomic::{AtomicUsize, Ordering};
+static DROPS: AtomicUsize = AtomicUsize::new(0);
+struct Droppable;
+impl Drop for Droppable {
+    fn drop(&mut self) {
+        DROPS.fetch_add(1, Ordering::SeqCst);
+    }
+}
+struct Tuple<T, U>(T, U);
+#[async_trait]
+trait Trait {
+    async fn underscore(arg: Tuple<Droppable, i32>);
+    async fn rest(arg: Tuple<Droppable, i32>);
+}
+struct Struct;
+#[async_trait]
+impl Trait for Struct {
+    async fn underscore(Tuple(_, _int): Tuple<Droppable, i32>) {}
+    async fn rest(Tuple { 1: _int, .. }: Tuple<Droppable, i32>) {}
+}
+fn main() {
+    let future = Struct::underscore(Tuple(Droppable, 1));
+    println!("underscore-called:{}", DROPS.load(Ordering::SeqCst));
+    drop(future);
+    println!("underscore-future-dropped:{}", DROPS.load(Ordering::SeqCst));
+    DROPS.store(0, Ordering::SeqCst);
+    let future = Struct::rest(Tuple(Droppable, 1));
+    println!("rest-called:{}", DROPS.load(Ordering::SeqCst));
+    drop(future);
+    println!("rest-future-dropped:{}", DROPS.load(Ordering::SeqCst));
+}
+"#;
+    let deps = std::env::current_exe()
+        .unwrap()
+        .parent()
+        .unwrap()
+        .to_owned();
+    let macro_library = std::fs::read_dir(&deps)
+        .unwrap()
+        .filter_map(Result::ok)
+        .map(|entry| entry.path())
+        .filter(|path| {
+            path.file_name()
+                .and_then(|name| name.to_str())
+                .map_or(false, |name| {
+                    name.starts_with("libasync_trait-") && name.ends_with(".so")
+                })
+        })
+        .max_by_key(|path| {
+            std::fs::metadata(path)
+                .and_then(|metadata| metadata.modified())
+                .ok()
+        })
+        .unwrap();
+    let dir = std::env::temp_dir().join(format!(
+        "async-trait-issue234-{}",
+        std::process::id()
+    ));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir(&dir).unwrap();
+    let source_path = dir.join("edition_behavior.rs");
+    std::fs::write(&source_path, source).unwrap();
+
+    let mut edition_output = Vec::new();
+    for edition in &["2018", "2021"] {
+        let binary_path = dir.join(format!("edition-{edition}"));
+        let compile = std::process::Command::new(
+            std::env::var_os("RUSTC").unwrap_or_else(|| "rustc".into()),
+        )
+        .arg(format!("--edition={edition}"))
+        .arg(&source_path)
+        .arg("--extern")
+        .arg(format!("async_trait={}", macro_library.display()))
+        .arg("-L")
+        .arg(format!("dependency={}", deps.display()))
+        .arg("-o")
+        .arg(&binary_path)
+        .output()
+        .unwrap();
+        assert!(
+            compile.status.success(),
+            "edition {edition} compilation failed:\n{}",
+            String::from_utf8_lossy(&compile.stderr)
+        );
+        let run = std::process::Command::new(&binary_path).output().unwrap();
+        assert!(
+            run.status.success(),
+            "edition {edition} program failed:\n{}",
+            String::from_utf8_lossy(&run.stderr)
+        );
+        edition_output.push(String::from_utf8(run.stdout).unwrap());
+    }
+    assert_eq!(edition_output[0], edition_output[1]);
+
+    for edition in &["2018", "2021"] {
+        let lint_binary = dir.join(format!("edition-{edition}-lint"));
+        let compile = std::process::Command::new(
+            std::env::var_os("RUSTC").unwrap_or_else(|| "rustc".into()),
+        )
+        .arg(format!("--edition={edition}"))
+        .arg("-D")
+        .arg("rust_2021_compatibility")
+        .arg(&source_path)
+        .arg("--extern")
+        .arg(format!("async_trait={}", macro_library.display()))
+        .arg("-L")
+        .arg(format!("dependency={}", deps.display()))
+        .arg("-o")
+        .arg(lint_binary)
+        .output()
+        .unwrap();
+        assert!(
+            compile.status.success(),
+            "edition {edition} compatibility-lint compilation failed:\n{}",
+            String::from_utf8_lossy(&compile.stderr)
+        );
+    }
+    std::fs::remove_dir_all(dir).unwrap();
+}
