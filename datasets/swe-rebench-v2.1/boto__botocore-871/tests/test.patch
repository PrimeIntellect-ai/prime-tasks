+    def test_assume_role_refresher_serializes_datetime(self):
+        client = mock.Mock()
+        time_zone = tzutc()
+        expiration = datetime(
+            year=2016, month=11, day=6, hour=1, minute=30, tzinfo=time_zone)
+        client.assume_role.return_value = {
+            'Credentials': {
+                'AccessKeyId': 'foo',
+                'SecretAccessKey': 'bar',
+                'SessionToken': 'baz',
+                'Expiration': expiration,
+            }
+        }
+        params = {'RoleArn': 'arn:example:role', 'RoleSessionName': 'session'}
+        refresh = create_assume_role_refresher(client, params)
+        refreshed = refresh()
+        client.assume_role.assert_called_once_with(**params)
+        self.assertEqual(refreshed['access_key'], 'foo')
+        self.assertEqual(refreshed['secret_key'], 'bar')
+        self.assertEqual(refreshed['token'], 'baz')
+        self.assertEqual(refreshed['expiry_time'], '2016-11-06T01:30:00UTC')
+
+    def test_assume_role_refresher_preserves_timezone(self):
+        client = mock.Mock()
+        time_zone = tzoffset('EST', -18000)
+        expiration = datetime(
+            year=2016, month=11, day=6, hour=1, minute=30, tzinfo=time_zone)
+        client.assume_role.return_value = {
+            'Credentials': {
+                'AccessKeyId': 'foo',
+                'SecretAccessKey': 'bar',
+                'SessionToken': 'baz',
+                'Expiration': expiration,
+            }
+        }
+        refresh = create_assume_role_refresher(client, {})
+        self.assertEqual(
+            refresh()['expiry_time'], '2016-11-06T01:30:00EST')
+
+    def test_assume_role_refresher_propagates_error(self):
+        client = mock.Mock()
+        client.assume_role.side_effect = botocore.exceptions.ClientError(
+            {'Error': {'Code': 'AccessDenied', 'Message': 'denied'}},
+            'AssumeRole')
+        refresh = create_assume_role_refresher(client, {})
+        with self.assertRaises(botocore.exceptions.ClientError):
+            refresh()
+
