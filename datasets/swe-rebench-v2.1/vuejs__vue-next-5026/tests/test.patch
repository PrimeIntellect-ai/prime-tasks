+describe('ShallowRef public type', () => {
+  const repoRoot = path.resolve(__dirname, '../../../..')
+
+  // Runs declaration emit on an in-memory module (resolving `vue` and
+  // `@vue/*` to this repository's sources) and returns the diagnostics
+  // reported for that module.
+  function declarationDiagnostics(source: string): string[] {
+    const fileName = path.join(repoRoot, 'packages', '__shallow_ref_check__.ts')
+    const options: ts.CompilerOptions = {
+      strict: true,
+      declaration: true,
+      emitDeclarationOnly: true,
+      target: ts.ScriptTarget.ES2016,
+      module: ts.ModuleKind.ESNext,
+      moduleResolution: ts.ModuleResolutionKind.NodeJs,
+      esModuleInterop: true,
+      types: [],
+      baseUrl: repoRoot,
+      paths: {
+        '@vue/compat': ['packages/vue-compat/src'],
+        '@vue/*': ['packages/*/src'],
+        vue: ['packages/vue/src']
+      }
+    }
+    const host = ts.createCompilerHost(options)
+    const getSourceFile = host.getSourceFile
+    host.getSourceFile = (name, languageVersion, ...rest) =>
+      name === fileName
+        ? ts.createSourceFile(name, source, languageVersion, true)
+        : getSourceFile(name, languageVersion, ...rest)
+    const fileExists = host.fileExists
+    host.fileExists = name => name === fileName || fileExists(name)
+    const readFile = host.readFile
+    host.readFile = name => (name === fileName ? source : readFile(name))
+    const program = ts.createProgram(
+      [fileName, path.join(repoRoot, 'packages/global.d.ts')],
+      options,
+      host
+    )
+    const sourceFile = program.getSourceFile(fileName)!
+    return [
+      ...program.getDeclarationDiagnostics(sourceFile),
+      ...program.getSemanticDiagnostics(sourceFile)
+    ].map(d => ts.flattenDiagnosticMessageText(d.messageText, '\n'))
+  }
+
+  test('ShallowRef can be imported as a type from @vue/reactivity', () => {
+    const diagnostics = declarationDiagnostics(`
+import { shallowRef } from '@vue/reactivity'
+import type { ShallowRef } from '@vue/reactivity'
+export const r: ShallowRef<number> = shallowRef(1)
+`)
+    expect(diagnostics).toEqual([])
+  }, 120000)
+
+  test('declarations for a setup returning a shallowRef emit no error', () => {
+    const diagnostics = declarationDiagnostics(`
+import { defineComponent, shallowRef } from 'vue'
+export const App = defineComponent({
+  setup() {
+    const foo = shallowRef('bar')
+    return { foo }
+  }
+})
+`)
+    expect(diagnostics).toEqual([])
+  }, 120000)
+})
