+def test_estimated_row_count_across_frame_sizes(cloud_df):
+    for row_count in (0, 1, 8):
+        qc = type(cloud_df._query_compiler)(
+            pandas.DataFrame({"value": range(row_count)})
+        )
+        assert qc._max_shape()[0] == row_count
+
+
+def test_estimated_column_count_matches_frame_width():
+    for column_count in (0, 1, 4):
+        frame = pandas.DataFrame(
+            {f"column_{index}": range(3) for index in range(column_count)}
+        )
+        qc = NativeQueryCompiler(frame)
+        assert qc._max_shape()[1] == column_count
+
+
+def test_switch_cost_uses_subclass_row_estimate():
+    class EstimatedRowsQC(CloudForBigDataQC):
+        def _max_shape(self):
+            return 20, 1
+
+    source_qc = EstimatedRowsQC(pandas.DataFrame({"value": range(3)}))
+    cost = LocalForSmallDataQC.move_to_me_cost(
+        source_qc, None, "operation", MappingProxyType({})
+    )
+    assert cost == QCCoercionCost.COST_IMPOSSIBLE
+
+
