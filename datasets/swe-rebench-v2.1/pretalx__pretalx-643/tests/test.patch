+@pytest.mark.django_db
+def test_infoform_accepts_standard_form_arguments(event):
+    # https://github.com/pretalx/pretalx/issues/642
+    bound = InfoForm(event, data={'title': 'A title'})
+    assert bound.is_bound
+    assert bound['title'].value() == 'A title'
+
+    unbound = InfoForm(event, initial={'abstract': 'Preset abstract'})
+    assert not unbound.is_bound
+    assert unbound['abstract'].value() == 'Preset abstract'
