+use Attribute\On\Property\Two;
+use Attribute\On\Property\Three;
+use Atrribute\On\Method;
+
+#[Strict]
+class Test
+{
+    #[One,Two]
+    public string $foo;
+    #[Three]
+    public string $bar;
+    
+    #[Method]
+    public function doIt(): void {
+    
+    }
 }
+file;
