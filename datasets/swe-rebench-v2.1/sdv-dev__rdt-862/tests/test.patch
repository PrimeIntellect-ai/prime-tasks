+    def test_import_rdt_does_not_import_sklearn_mixture(self):
+        """Test that importing ``rdt`` does not eagerly import ``sklearn.mixture``.
+
+        The ``BayesianGaussianMixture`` import must be deferred until functionality
+        that requires it is used so that ``import rdt`` is fast.
+        """
+        # Run
+        repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..', '..'))
+        result = subprocess.run(
+            [
+                sys.executable,
+                '-c',
+                'import sys; import rdt; '
+                'assert "sklearn.mixture" not in sys.modules, '
+                '"sklearn.mixture was imported eagerly by import rdt"; '
+                'import pandas as pd; '
+                'from rdt.transformers.numerical import ClusterBasedNormalizer; '
+                'ClusterBasedNormalizer(max_clusters=2).fit(pd.DataFrame({\"value\": [0.0, 1.0, 2.0]}), \"value\"); '
+                'assert "sklearn.mixture" in sys.modules, '
+                '"sklearn.mixture was not loaded when fitting required it"',
+            ],
+            capture_output=True,
+            text=True,
+            cwd=repo_root,
+        )
+
+        # Assert
+        assert result.returncode == 0, result.stderr
