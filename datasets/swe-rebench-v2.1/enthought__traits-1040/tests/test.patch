+class TestSharedItemValidator(unittest.TestCase):
+    """Default validation is shared and preserves arbitrary items."""
+
+    def test_default_validation_accepts_arbitrary_item_unchanged(self):
+        from traits.trait_dict_object import TraitDict
+        from traits.trait_list_object import TraitList
+
+        item = object()
+        trait_list = TraitList([item])
+        trait_set = TraitSet([item])
+        trait_dict = TraitDict({item: item})
+
+        validators = (
+            trait_list.item_validator,
+            trait_set.item_validator,
+            trait_dict.key_validator,
+            trait_dict.value_validator,
+        )
+        self.assertTrue(all(validator is validators[0]
+                            for validator in validators[1:]))
+        self.assertIs(trait_list[0], item)
+        self.assertIs(next(iter(trait_set)), item)
+        key = next(iter(trait_dict))
+        self.assertIs(key, item)
+        self.assertIs(trait_dict[key], item)
