+++ b/tests/test_bases.py
@@ -0,0 +1,25 @@
+# standard library
+from dataclasses import fields, is_dataclass
+
+
+# dependencies
+from xarray_dataclasses import DataArrayClass
+from xarray_dataclasses.bases import DataArrayClass as BasesDataArrayClass
+from xarray_dataclasses.typing import DataArray
+
+
+class Image(DataArrayClass):
+    data: DataArray[("x", "y"), float]
+    x: DataArray["x", int] = 0
+    y: DataArray["y", int] = 0
+
+
+def test_dataarrayclass_is_available_from_bases():
+    assert isinstance(BasesDataArrayClass, type)
+
+
+def test_subclass_fields_are_dataclass_fields():
+    assert is_dataclass(Image)
+    assert {"data", "x", "y"}.issubset(
+        {field.name for field in fields(Image)}
+    )
