+type emptyDisplayNameUser struct {
+	*defaultUser
+}
+
+func (user *emptyDisplayNameUser) WebAuthnDisplayName() string {
+	return ""
+}
+
+func TestBeginRegistrationIncludesEmptyDisplayName(t *testing.T) {
+	webauthn, err := New(&Config{
+		RPID:          "example.com",
+		RPDisplayName: "Example",
+		RPOrigins:     []string{"https://example.com"},
+	})
+	if !assert.NoError(t, err) {
+		return
+	}
+
+	creation, _, err := webauthn.BeginRegistration(&emptyDisplayNameUser{
+		defaultUser: &defaultUser{id: []byte("123")},
+	})
+	if !assert.NoError(t, err) {
+		return
+	}
+
+	data, err := json.Marshal(creation)
+	if !assert.NoError(t, err) {
+		return
+	}
+
+	var encoded struct {
+		PublicKey struct {
+			User map[string]json.RawMessage `json:"user"`
+		} `json:"publicKey"`
+	}
+	if !assert.NoError(t, json.Unmarshal(data, &encoded)) {
+		return
+	}
+
+	displayName, present := encoded.PublicKey.User["displayName"]
+	if !assert.True(t, present, "registration options must include displayName") {
+		return
+	}
+	var value string
+	if assert.NoError(t, json.Unmarshal(displayName, &value)) {
+		assert.Equal(t, "", value)
+	}
+}
