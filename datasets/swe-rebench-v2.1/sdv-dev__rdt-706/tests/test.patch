+    def test_uniform(self):
+        """Test it works when distribution='uniform'."""
+        # Setup
+        data = pd.DataFrame(np.linspace(0.001, 0.999, 1000), columns=['a'])
+        ct = GaussianNormalizer(distribution='uniform')
+
+        # Run
+        ct.fit(data, 'a')
+        transformed = ct.transform(data)
+        reverse = ct.reverse_transform(transformed)
+
+        # Assert
+        assert isinstance(transformed, pd.DataFrame)
+        assert transformed.shape == (1000, 1)
+
+        np.testing.assert_almost_equal(transformed['a'].mean(), 0, decimal=1)
+        np.testing.assert_almost_equal(transformed['a'].std(), 1, decimal=1)
+
+        np.testing.assert_array_almost_equal(reverse, data, decimal=1)
+
+    def test_uniform_class(self):
+        """Test it works when distribution=UniformUnivariate."""
+        # Setup
+        data = pd.DataFrame(np.linspace(0.001, 0.999, 1000), columns=['a'])
+        ct = GaussianNormalizer(distribution=univariate.UniformUnivariate)
+
+        # Run
+        ct.fit(data, 'a')
+        transformed = ct.transform(data)
+        reverse = ct.reverse_transform(transformed)
+
+        # Assert
+        assert isinstance(transformed, pd.DataFrame)
+        assert transformed.shape == (1000, 1)
+
+        np.testing.assert_almost_equal(transformed['a'].mean(), 0, decimal=1)
+        np.testing.assert_almost_equal(transformed['a'].std(), 1, decimal=1)
+
+        np.testing.assert_array_almost_equal(reverse, data, decimal=1)
+
+    @pytest.mark.parametrize(
+        'distribution',
+        ['uniform', univariate.UniformUnivariate, univariate.UniformUnivariate()],
+    )
+    def test_uniform_distribution_scores(self, distribution):
+        """Test the selected uniform distribution determines the transformed scores."""
+        data = pd.DataFrame({'a': [0., 1., 2., 3., 4., 10.]})
+        ct = GaussianNormalizer(distribution=distribution)
+
+        ct.fit(data, 'a')
+        transformed = ct.transform(data)
+
+        expected = norm.ppf(np.array([1., 2., 3., 4.]) / 10.)
+        np.testing.assert_allclose(transformed['a'].iloc[1:5], expected, atol=1e-6)
+
+    def test_uniform_instance(self):
+        """Test it works when a UniformUnivariate instance is supplied."""
+        data = pd.DataFrame(np.linspace(0.001, 0.999, 1000), columns=['a'])
+        ct = GaussianNormalizer(distribution=univariate.UniformUnivariate())
+
+        ct.fit(data, 'a')
+        transformed = ct.transform(data)
+        reverse = ct.reverse_transform(transformed)
+
+        assert isinstance(transformed, pd.DataFrame)
+        assert transformed.shape == (1000, 1)
+        np.testing.assert_array_almost_equal(reverse, data, decimal=1)
+
 
