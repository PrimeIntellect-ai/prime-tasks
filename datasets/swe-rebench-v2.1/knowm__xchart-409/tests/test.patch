+package org.knowm.xchart.standalone.issues;
+
+import java.awt.image.BufferedImage;
+import org.knowm.xchart.BitmapEncoder;
+import org.knowm.xchart.CategoryChart;
+import org.knowm.xchart.CategoryChartBuilder;
+import org.knowm.xchart.SwingWrapper;
+import org.knowm.xchart.demo.charts.ExampleChart;
+import org.knowm.xchart.style.Styler.LegendPosition;
+
+public class TestForIssue402 implements ExampleChart<CategoryChart> {
+
+  public static void main(String[] args) {
+    checkStylerAccessors();
+    checkAnnotationPositionChangesRendering();
+    checkTotalAnnotationsChangeRendering();
+    System.out.println("TestForIssue402: all checks passed");
+  }
+
+  private static void checkStylerAccessors() {
+    CategoryChart chart = buildChart(false, 0.5f);
+    assertTrue(!chart.getStyler().isShowTotalAnnotations(), "total annotations are off by default");
+
+    chart.getStyler().setShowTotalAnnotations(true);
+    assertTrue(chart.getStyler().isShowTotalAnnotations(), "total annotations can be enabled");
+    chart.getStyler().setShowTotalAnnotations(false);
+    assertTrue(!chart.getStyler().isShowTotalAnnotations(), "total annotations can be disabled");
+
+    chart.getStyler().setAnnotationsPosition(0.25f);
+    assertTrue(
+        chart.getStyler().getAnnotationsPosition() == 0.25f,
+        "annotations position reads back the value that was set");
+  }
+
+  private static void checkAnnotationPositionChangesRendering() {
+    BufferedImage bottom = render(buildChart(false, 0f));
+    BufferedImage top = render(buildChart(false, 1f));
+    assertTrue(
+        !sameImage(bottom, top),
+        "changing the annotations position from 0 to 1 changes where annotations are drawn");
+  }
+
+  private static void checkTotalAnnotationsChangeRendering() {
+    BufferedImage withoutTotals = render(buildChart(false, 0.5f));
+    BufferedImage withTotals = render(buildChart(true, 0.5f));
+    assertTrue(
+        !sameImage(withoutTotals, withTotals),
+        "enabling total annotations on a stacked chart draws the total values");
+  }
+
+  private static CategoryChart buildChart(boolean showTotals, float annotationsPosition) {
+
+    CategoryChart chart =
+        new CategoryChartBuilder()
+            .width(800)
+            .height(600)
+            .title("TestForIssue402")
+            .xAxisTitle("x")
+            .yAxisTitle("y")
+            .build();
+
+    chart.getStyler().setLegendPosition(LegendPosition.OutsideE);
+    chart.getStyler().setStacked(true);
+    chart.getStyler().setHasAnnotations(true);
+    chart.getStyler().setAnnotationsPosition(annotationsPosition);
+    chart.getStyler().setShowTotalAnnotations(showTotals);
+
+    chart.addSeries("a", new double[] {0, 1, 2, 3, 4}, new double[] {40, 35, -45, -60, -60});
+    chart.addSeries("b", new double[] {0, 1, 2, 3, 4}, new double[] {50, 65, 60, -70, 30});
+    chart.addSeries("c", new double[] {0, 1, 2, 3, 4}, new double[] {70, 45, -55, -80, 40});
+    chart.addSeries("d", new double[] {0, 1, 2, 3, 4}, new double[] {90, 80, 75, 75, 50});
+    return chart;
+  }
+
+  private static BufferedImage render(CategoryChart chart) {
+    return BitmapEncoder.getBufferedImage(chart);
+  }
+
+  private static boolean sameImage(BufferedImage a, BufferedImage b) {
+    if (a.getWidth() != b.getWidth() || a.getHeight() != b.getHeight()) {
+      return false;
+    }
+    for (int x = 0; x < a.getWidth(); x++) {
+      for (int y = 0; y < a.getHeight(); y++) {
+        if (a.getRGB(x, y) != b.getRGB(x, y)) {
+          return false;
+        }
+      }
+    }
+    return true;
+  }
+
+  private static void assertTrue(boolean condition, String message) {
+    if (!condition) {
+      throw new AssertionError(message);
+    }
+  }
+
+  @Override
+  public CategoryChart getChart() {
+    return buildChart(true, 0.5f);
+  }
+}
