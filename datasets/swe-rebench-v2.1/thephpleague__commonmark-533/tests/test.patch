+    public function testRepeatedHeadingsHaveDistinctPermalinkAnchors(): void
+    {
+        $environment = Environment::createCommonMarkEnvironment();
+        $environment->addExtension(new HeadingPermalinkExtension());
+
+        $converter = new CommonMarkConverter([], $environment);
+        $html = $converter->convertToHtml("# Hello World!\n\n# Hello World!");
+
+        preg_match_all('/<a\\b[^>]*\\bhref="#([^"]+)"[^>]*>/', $html, $permalinkLinks);
+        preg_match_all('/\\b(?:id|name)="([^"]+)"/', $html, $targets);
+
+        $this->assertCount(2, $permalinkLinks[1]);
+        $this->assertCount(2, array_unique($permalinkLinks[1]));
+        foreach ($permalinkLinks[1] as $fragment) {
+            $this->assertContains($fragment, $targets[1]);
+        }
+    }
+
+    public function testTableOfContentsLinksToDistinctRepeatedHeadingAnchors(): void
+    {
+        $environment = Environment::createCommonMarkEnvironment();
+        $environment->addExtension(new HeadingPermalinkExtension());
+        $environment->addExtension(new TableOfContentsExtension());
+
+        $converter = new CommonMarkConverter([], $environment);
+        $html = $converter->convertToHtml("# Hello World!\n\n# Hello World!");
+
+        preg_match('/<ul\\b[^>]*>(.*?)<\\/ul>/s', $html, $toc);
+        preg_match_all('/<a\\b[^>]*\\bhref="#([^"]+)"[^>]*>/', $toc[1], $tocLinks);
+        preg_match_all('/\\b(?:id|name)="([^"]+)"/', $html, $targets);
+
+        $this->assertCount(2, $tocLinks[1]);
+        $this->assertCount(2, array_unique($tocLinks[1]));
+        foreach ($tocLinks[1] as $fragment) {
+            $this->assertContains($fragment, $targets[1]);
+        }
+    }
+
