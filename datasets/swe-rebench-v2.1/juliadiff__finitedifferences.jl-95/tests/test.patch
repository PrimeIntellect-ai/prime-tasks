+        rng, fdm = MersenneTwister(123456), central_fdm(5, 1)
+
+        # `j′vp` is permitted to return either a tuple of adjoints (one per primal
+        # input) or a single adjoint vector. Flatten either shape to one vector so
+        # that the checks below do not depend on which permitted shape is returned.
+        flatten_adjoint(r::Tuple) = vcat(map(flatten_adjoint, r)...)
+        flatten_adjoint(r) = vec(r)
+
+        @testset "x with length $N, y with length $M" for (N, M) in
+                ((2, 3), (0, 0), (0, 3), (3, 0))
+            x, y = randn(rng, T, N), randn(rng, T, M)
+            z̄ = randn(rng, T, N + M)
+            xy = vcat(x, y)
+            x̄ȳ_manual = j′vp(fdm, xy->sin.(xy), z̄, xy)
+            x̄ȳ_auto = j′vp(fdm, x->sin.(vcat(x[1], x[2])), z̄, (x, y))
+            x̄ȳ_multi = j′vp(fdm, (x, y)->sin.(vcat(x, y)), z̄, x, y)
+            @test flatten_adjoint(x̄ȳ_manual) ≈ flatten_adjoint(x̄ȳ_auto)
+            @test flatten_adjoint(x̄ȳ_manual) ≈ flatten_adjoint(x̄ȳ_multi)
+            @test length(flatten_adjoint(x̄ȳ_manual)) == N + M
+            if N + M == 0
+                # An empty primal input must yield an empty adjoint.
+                @test isempty(flatten_adjoint(x̄ȳ_manual))
+            end
+        end
 
+        @testset "empty primal with scalar output" begin
+            foo(x) = isempty(x) ? zero(eltype(x)) : first(x)
+            x̄ = j′vp(fdm, foo, one(T), T[])[1]
+            @test isempty(x̄)
+        end
+    end
     # Tests for complex numbers, to prevent regressions against
