+
+func decodeCommentRequestBody(t *testing.T, data []byte) map[string]json.RawMessage {
+	t.Helper()
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(data, &fields); err != nil {
+		t.Fatalf("request body is not a JSON object: %v (%s)", err, data)
+	}
+	return fields
+}
+
+// captureCommentRequest registers a handler on path and returns a pointer that receives the request body.
+func captureCommentRequest(t *testing.T, path, method string) *[]byte {
+	body := new([]byte)
+	testMux.HandleFunc(path, func(w http.ResponseWriter, r *http.Request) {
+		testMethod(t, r, method)
+		b, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("reading request body: %v", err)
+		}
+		*body = b
+		w.WriteHeader(http.StatusCreated)
+		fmt.Fprint(w, `{"id":"10001"}`)
+	})
+	return body
+}
+
+func TestIssueService_CommentRequest_OmitsAbsentParts(t *testing.T) {
+	setup()
+	defer teardown()
+	addBody := captureCommentRequest(t, "/rest/api/2/issue/10000/comment", http.MethodPost)
+	updateBody := captureCommentRequest(t, "/rest/api/2/issue/10000/comment/10001", http.MethodPut)
+
+	if _, _, err := testClient.Issue.AddComment(context.Background(), "10000", &Comment{Body: "Lorem ipsum"}); err != nil {
+		t.Fatalf("AddComment() error: %v", err)
+	}
+	if _, _, err := testClient.Issue.UpdateComment(context.Background(), "10000", &Comment{ID: "10001", Body: "Lorem ipsum"}); err != nil {
+		t.Fatalf("UpdateComment() error: %v", err)
+	}
+
+	for name, body := range map[string]*[]byte{"AddComment": addBody, "UpdateComment": updateBody} {
+		fields := decodeCommentRequestBody(t, *body)
+		for _, key := range []string{"visibility", "author", "updateAuthor"} {
+			if _, ok := fields[key]; ok {
+				t.Errorf("%s: request body contains %q although it was not provided: %s", name, key, *body)
+			}
+		}
+	}
+}
+
+func TestIssueService_CommentRequest_KeepsProvidedParts(t *testing.T) {
+	setup()
+	defer teardown()
+	addBody := captureCommentRequest(t, "/rest/api/2/issue/10000/comment", http.MethodPost)
+
+	c := &Comment{}
+	if err := json.Unmarshal([]byte(`{"body":"Lorem ipsum","author":{"name":"alice"},"updateAuthor":{"name":"bob"},"visibility":{"type":"role","value":"Administrators"}}`), c); err != nil {
+		t.Fatalf("unmarshal comment: %v", err)
+	}
+	if _, _, err := testClient.Issue.AddComment(context.Background(), "10000", c); err != nil {
+		t.Fatalf("AddComment() error: %v", err)
+	}
+
+	fields := decodeCommentRequestBody(t, *addBody)
+	decodeField := func(key string, v interface{}) {
+		raw, ok := fields[key]
+		if !ok {
+			t.Fatalf("request body is missing %q: %s", key, *addBody)
+		}
+		if err := json.Unmarshal(raw, v); err != nil {
+			t.Fatalf("decode %q: %v", key, err)
+		}
+	}
+
+	var author, updateAuthor struct {
+		Name string `json:"name"`
+	}
+	decodeField("author", &author)
+	decodeField("updateAuthor", &updateAuthor)
+	if author.Name != "alice" {
+		t.Errorf("author.name = %q, want %q", author.Name, "alice")
+	}
+	if updateAuthor.Name != "bob" {
+		t.Errorf("updateAuthor.name = %q, want %q", updateAuthor.Name, "bob")
+	}
+
+	var visibility struct {
+		Type  string `json:"type"`
+		Value string `json:"value"`
+	}
+	decodeField("visibility", &visibility)
+	if visibility.Type != "role" || visibility.Value != "Administrators" {
+		t.Errorf("visibility = %+v, want type %q value %q", visibility, "role", "Administrators")
+	}
+}
