diff --git a/tests/test_pydantic_factory.py b/tests/test_pydantic_factory.py
index c26168d..beaeb8a 100644
--- a/tests/test_pydantic_factory.py
+++ b/tests/test_pydantic_factory.py
@@ -1047,3 +1047,71 @@ def test_skip_validation() -> None:
 
     AFactory = ModelFactory.create_factory(A)
     assert AFactory.build()
+
+
+@pytest.mark.skipif(_IS_PYDANTIC_V1, reason="Pydantic 1 doesn't support examples")
+def test_use_examples_not_defined() -> None:
+    class Payment(BaseModel):
+        amount: int = Field(0)
+        currency: int = Field(ge=10, examples=[-1, -2])
+
+    class PaymentFactory(ModelFactory[Payment]): ...
+
+    instance = PaymentFactory.build()
+
+    assert instance.currency >= 10
+
+
+@pytest.mark.skipif(_IS_PYDANTIC_V1, reason="Pydantic 1 doesn't support examples")
+def test_use_examples_true() -> None:
+    class Payment(BaseModel):
+        amount: int = Field(0)
+        currency: str = Field(examples=["USD", "EUR", "INR"])
+
+    class PaymentFactory(ModelFactory[Payment]):
+        __use_examples__ = True
+
+    instance = PaymentFactory.build()
+    assert instance.currency in ["USD", "EUR", "INR"]
+
+
+@pytest.mark.skipif(_IS_PYDANTIC_V1, reason="Pydantic 1 doesn't support examples")
+def test_use_examples_false() -> None:
+    class Payment(BaseModel):
+        amount: int = Field(0)
+        currency: int = Field(ge=10, examples=[-1, -2])
+
+    class PaymentFactory(ModelFactory[Payment]):
+        __use_examples__ = False
+
+    instance = PaymentFactory.build()
+    assert instance.currency >= 10
+
+
+@pytest.mark.skipif(_IS_PYDANTIC_V1, reason="Pydantic 1 doesn't support examples")
+def test_use_examples_value_override() -> None:
+    class Payment(BaseModel):
+        amount: int = Field(0)
+        currency: str = Field(examples=["USD", "EUR", "INR"])
+
+    class PaymentFactory(ModelFactory[Payment]):
+        __use_examples__ = True
+
+    instance = PaymentFactory.build(currency="DKK")
+    assert instance.currency == "DKK"
+
+
+@pytest.mark.skipif(_IS_PYDANTIC_V1, reason="Pydantic 1 doesn't support examples")
+def test_use_examples_selects_randomly() -> None:
+    examples = ["USD", "EUR", "INR"]
+
+    class Payment(BaseModel):
+        amount: int = Field(0)
+        currency: str = Field(examples=examples)
+
+    class PaymentFactory(ModelFactory[Payment]):
+        __use_examples__ = True
+
+    values = {PaymentFactory.build().currency for _ in range(100)}
+    assert values <= set(examples)
+    assert len(values) > 1
