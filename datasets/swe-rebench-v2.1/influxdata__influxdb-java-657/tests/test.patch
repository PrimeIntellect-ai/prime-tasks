+    /**
+     * Invokes the public Builder.time(Number, TimeUnit) method.
+     */
+    private static Point.Builder time(Point.Builder builder, Number timeToSet, TimeUnit precision) throws Exception {
+        Method method = Point.Builder.class.getMethod("time", Number.class, TimeUnit.class);
+        return (Point.Builder) method.invoke(builder, timeToSet, precision);
+    }
+
+    @Test
+    public void testNumberTimeReturnsSameBuilder() throws Exception {
+        Point.Builder builder = Point.measurement("measurement");
+        Number timestamp = new BigInteger("12345678901234567890");
+
+        assertThat(time(builder, timestamp, TimeUnit.NANOSECONDS)).isSameAs(builder);
+    }
+
+    /**
+     * Tests for #267
+     *
+     * @throws Exception
+     */
+    @Test
+    public void testLineProtocolBigInteger() throws Exception {
+        // GIVEN a point with nanosecond precision farther in the future than a long can hold
+        Instant instant = Instant.EPOCH.plus(600L * 365, ChronoUnit.DAYS);
+        BigInteger nanos = BigInteger.valueOf(instant.getEpochSecond())
+                .multiply(BigInteger.valueOf(1000000000L))
+                .add(BigInteger.valueOf(instant.getNano()));
+        Point p = time(Point.measurement("measurement").addField("foo", "bar"), nanos, TimeUnit.NANOSECONDS).build();
+
+        // WHEN i call lineProtocol(TimeUnit.NANOSECONDS)
+        String nanosTime = p.lineProtocol(TimeUnit.NANOSECONDS).replace("measurement foo=\"bar\" ", "");
+
+        // THEN the timestamp is in nanoseconds
+        assertThat(nanosTime).isEqualTo(nanos.toString());
+    }
+
