+    /**
+     * The Long overload must remain available and behave like the Number overload.
+     *
+     * @throws Exception
+     */
+    @Test
+    public void testTimeLongOverloadRetained() throws Exception {
+        // the declared Long overload must exist and be public
+        Method longOverload = Point.Builder.class.getMethod("time", Long.class, TimeUnit.class);
+        assertThat(Modifier.isPublic(longOverload.getModifiers())).isTrue();
+        assertThat(longOverload.getReturnType()).isEqualTo(Point.Builder.class);
+
+        // and it must behave like the generic Number overload
+        Point p = Point
+                .measurement("measurement")
+                .addField("foo", "bar")
+                .time(Long.valueOf(1234567890123L), TimeUnit.MILLISECONDS)
+                .build();
+
+        assertThat(p.lineProtocol(TimeUnit.MILLISECONDS)).isEqualTo("measurement foo=\"bar\" 1234567890123");
+    }
