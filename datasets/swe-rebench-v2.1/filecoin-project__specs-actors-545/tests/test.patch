+
+func loadMinerInfoFromState(t testing.TB, rt *mock.Runtime, st *miner.State) *miner.MinerInfo {
+	infoField := reflect.ValueOf(st).Elem().FieldByName("Info")
+	require.True(t, infoField.IsValid(), "miner state must expose its MinerInfo field")
+	infoCID, isCID := infoField.Interface().(cid.Cid)
+	require.True(t, isCID, "miner state MinerInfo field must contain a CID")
+
+	var info miner.MinerInfo
+	err := adt.AsStore(rt).Get(context.Background(), infoCID, &info)
+	require.NoError(t, err)
+	return &info
+}
