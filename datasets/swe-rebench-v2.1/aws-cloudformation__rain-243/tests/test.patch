+// hasFlowMapping reports whether s contains a mapping written in flow style
+// (for example `{a: b}`) rather than block style.
+func hasFlowMapping(s string) bool {
+	var doc yaml.Node
+	if err := yaml.Unmarshal([]byte(s), &doc); err != nil {
+		return false
+	}
+
+	var walk func(*yaml.Node) bool
+	walk = func(n *yaml.Node) bool {
+		if n.Kind == yaml.MappingNode && n.Style&yaml.FlowStyle != 0 {
+			return true
+		}
+		for _, c := range n.Content {
+			if walk(c) {
+				return true
+			}
+		}
+		return false
+	}
+
+	return walk(&doc)
+}
+
+func TestRoundTrip(t *testing.T) {
+	input, err := os.ReadFile("../../test/templates/roundtrip.yaml")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	source, err := parse.String(string(input))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	for _, unsorted := range []bool{false, true} {
+		// Round trip through JSON and back to YAML, as `rain fmt` does.
+		jsonOut := format.String(source, format.Options{
+			JSON:     true,
+			Unsorted: unsorted,
+		})
+
+		jsonTemplate, err := parse.String(jsonOut)
+		if err != nil {
+			t.Fatalf("unsorted=%v: unable to parse JSON output: %s", unsorted, err)
+		}
+
+		yamlOut := format.String(jsonTemplate, format.Options{
+			Unsorted: unsorted,
+		})
+
+		// The round trip must preserve the meaning of the template.
+		if err := parse.Verify(source, yamlOut); err != nil {
+			t.Fatalf("unsorted=%v: %s", unsorted, err)
+		}
+
+		// Without --unsorted the output must be block-style YAML rather
+		// than the compact JSON-style flow representation.
+		if !unsorted && hasFlowMapping(yamlOut) {
+			t.Fatalf("unsorted=%v: expected block-style YAML, got:\n%s", unsorted, yamlOut)
+		}
+
+		// The output must be written on multiple lines.
+		if strings.Count(strings.TrimSpace(yamlOut), "\n") < 1 {
+			t.Fatalf("unsorted=%v: expected output on multiple lines, got:\n%s", unsorted, yamlOut)
+		}
+	}
+}
