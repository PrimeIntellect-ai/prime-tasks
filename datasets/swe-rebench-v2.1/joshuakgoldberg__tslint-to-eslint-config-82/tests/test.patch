@@ -68,4 +74,33 @@ describe("findESLintConfiguration", () => {
             rules: {},
         });
     });
+    it("loads an ESLint configuration from a CLI path containing spaces", async () => {
+        const directory = fs.mkdtempSync(path.join(os.tmpdir(), "eslint-config-space-"));
+        const bin = path.join(directory, "bin");
+        const config = path.join(directory, "path with spaces", "eslint.json");
+        fs.mkdirSync(bin);
+        fs.mkdirSync(path.dirname(config));
+        fs.writeFileSync(config, JSON.stringify({ rules: { "sample-rule": 2 } }));
+        fs.writeFileSync(
+            path.join(bin, "eslint"),
+            '#!/bin/sh\n[ "$#" -eq 2 ] && [ "$1" = "--print-config" ] && [ -f "$2" ] && cat "$2"\n',
+        );
+        fs.chmodSync(path.join(bin, "eslint"), 0o755);
+        const dependencies = {
+            exec: (command: string) =>
+                new Promise<{ stderr: string; stdout: string }>((resolve, reject) =>
+                    childExec(
+                        command,
+                        { env: { ...process.env, PATH: `${bin}:${process.env.PATH}` } },
+                        (error, stdout, stderr) =>
+                            error ? reject(error) : resolve({ stdout, stderr }),
+                    ),
+                ),
+        };
+
+        const result = await findESLintConfiguration(dependencies, { config, eslint: config });
+
+        expect(result).toEqual({ env: {}, rules: { "sample-rule": 2 } });
+        fs.rmdirSync(directory, { recursive: true });
+    });
 });
