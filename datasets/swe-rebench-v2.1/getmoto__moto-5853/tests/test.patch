+@mock_ses
+def test_render_template__with_foreach():
+    conn = boto3.client("ses", region_name="us-east-1")
+    kwargs = dict(
+        TemplateName="MTT",
+        TemplateData=json.dumps(
+            {
+                "items": [
+                    {"itemName": "item1", "itemDesc": "description 1"},
+                    {"itemName": "item2", "itemDesc": "description 2"},
+                ]
+            }
+        ),
+    )
+
+    conn.create_template(
+        Template={
+            "TemplateName": "MTT",
+            "SubjectPart": "..",
+            "TextPart": "..",
+            "HtmlPart": '{{#each items}} <a href="{{itemName}}">{{itemDesc}}</a> {{/each}}',
+        }
+    )
+    rendered = conn.test_render_template(**kwargs)["RenderedTemplate"]
+    rendered.should.contain('<a href="item1">description 1</a>')
+    rendered.should.contain('<a href="item2">description 2</a>')
+
+
