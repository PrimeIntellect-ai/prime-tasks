+func assertSiblingExplicitNameConflictRejected(t *testing.T, cli interface{}, commandName string) {
+	t.Helper()
+	rejected := false
+	var output bytes.Buffer
+	func() {
+		defer func() {
+			if recover() != nil {
+				rejected = true
+			}
+		}()
+		parser, err := kong.New(cli, kong.Exit(func(int) {}), kong.Writers(&output, &output))
+		if err != nil {
+			rejected = true
+			return
+		}
+		if parser == nil {
+			return
+		}
+		_, err = parser.Parse([]string{"--help"})
+		rejected = err != nil
+	}()
+	listed := 0
+	for _, line := range strings.Split(output.String(), "\n") {
+		if strings.TrimSpace(line) == commandName {
+			listed++
+		}
+	}
+	assert.True(t, rejected && listed < 2)
+}
+
+func TestSiblingExplicitNameConflictRejected(t *testing.T) {
+	var cli struct {
+		DupA struct{} `cmd:"" name:"duplicate"`
+		DupB struct{} `cmd:"" name:"duplicate"`
+	}
+	assertSiblingExplicitNameConflictRejected(t, &cli, "duplicate")
+}
+
+func TestNestedSiblingExplicitNameConflictRejected(t *testing.T) {
+	var cli struct {
+		A struct {
+			DupA struct{} `cmd:"" name:"duplicate"`
+			DupB struct{} `cmd:"" name:"duplicate"`
+		} `cmd:""`
+		B struct{} `cmd:""`
+	}
+	assertSiblingExplicitNameConflictRejected(t, &cli, "a duplicate")
+}
+
+func TestNonSiblingExplicitNameReuseAllowed(t *testing.T) {
+	var cli struct {
+		A struct {
+			A struct{} `cmd:"" name:"duplicateA"`
+			B struct{} `cmd:"" name:"duplicateB"`
+		} `cmd:"" name:"duplicateA"`
+		B struct{} `cmd:"" name:"duplicateB"`
+	}
+	p := mustNew(t, &cli)
+	_, err := p.Parse([]string{"duplicateA", "duplicateB"})
+	assert.NoError(t, err)
+	_, err = p.Parse([]string{"duplicateB"})
+	assert.NoError(t, err)
+}
