+SETTINGS_TOML = """
+[default]
+name = "Dynaconf"
+age = 15
+
+[production]
+name = "prod"
+"""
+
+
+def make_settings(tmpdir):
+    tmpdir.join("settings.toml").write(SETTINGS_TOML)
+    return LazySettings(ROOT_PATH_FOR_DYNACONF=str(tmpdir))
+
+
+def test_as_dict_has_only_settings_file_values(tmpdir):
+    config = make_settings(tmpdir)
+    data = config.as_dict()
+    assert data["NAME"] == "Dynaconf"
+    assert data["AGE"] == 15
+    for name in (
+        "SETTINGS_MODULE",
+        "PROJECT_ROOT_FOR_DYNACONF",
+        "SETTINGS_MODULE_FOR_DYNACONF",
+    ):
+        assert name not in data
+
+
+def test_as_dict_is_flattened_for_current_env(tmpdir):
+    config = make_settings(tmpdir)
+    assert config.as_dict()["NAME"] == "Dynaconf"
+
+
+def test_as_dict_with_env_returns_that_namespace(tmpdir):
+    config = make_settings(tmpdir)
+    assert config.as_dict(env="production")["NAME"] == "prod"
+    assert config.as_dict()["NAME"] == "Dynaconf"
+
+
+def test_as_dict_reflects_modified_settings(tmpdir):
+    config = make_settings(tmpdir)
+    config.set("NAME", "changed")
+    config.set("NEW_KEY", 1)
+    data = config.as_dict()
+    assert data["NAME"] == "changed"
+    assert data["NEW_KEY"] == 1
+
+
 def test_list_with_all(testdir):
     """Test list command with --all includes interval vars"""
     result = run(["list", "-a"], env={"ROOT_PATH_FOR_DYNACONF": testdir})
