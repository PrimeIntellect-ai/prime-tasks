+    func testVariableDeclarationSingleArgumentWithEscapingAttribute() throws {
+        let sourceFile = Parser.parse(
+            source: """
+            @Spyable
+            protocol Service {
+                func foo(completion: @escaping () -> Void)
+            }
+            """
+        )
+        let protocolDeclaration = try XCTUnwrap(
+            sourceFile.statements.first?.item.as(ProtocolDeclSyntax.self)
+        )
+        let attribute = try XCTUnwrap(
+            protocolDeclaration.attributes?.compactMap { $0.as(AttributeSyntax.self) }.first
+        )
+        let expansions = try SpyableMacro.expansion(
+            of: attribute,
+            providingPeersOf: protocolDeclaration,
+            in: BasicMacroExpansionContext()
+        )
+        let generatedSpy = try XCTUnwrap(expansions.first?.as(ClassDeclSyntax.self))
+        let receivedArguments = try XCTUnwrap(
+            generatedSpy.memberBlock.members
+                .compactMap { $0.decl.as(VariableDeclSyntax.self) }
+                .first { variable in
+                    let name = variable.bindings.first?.pattern.as(IdentifierPatternSyntax.self)?.identifier.text ?? ""
+                    return name.contains("Received") && !name.contains("Invocations")
+                }
+        )
+        let receivedType = try XCTUnwrap(receivedArguments.bindings.first?.typeAnnotation?.type)
+
+        XCTAssertFalse(receivedType.description.contains("@escaping"))
+    }
