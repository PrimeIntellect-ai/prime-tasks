+class SingleTallyTester(TestCase):
+    """Test storing detector data with a single tally"""
+
+    def setUp(self):
+        self.detector = read(SINGLE_TALLY_FILE, 'det').detectors['one']
+
+    def test_singleTally(self):
+        """A single tally is a scalar or a one-element vector."""
+        tallies = self.detector.tallies
+        is_single_value = isscalar(tallies) or (
+            isinstance(tallies, ndarray) and tallies.shape == (1,))
+        self.assertTrue(is_single_value)
+        assert_equal(tallies, 8.19312E17)
+        assert_equal(self.detector.errors, 0.05187)
+
