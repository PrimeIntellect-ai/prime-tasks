diff --git a/test/boolean.js b/test/boolean.js
new file mode 100644
index 0000000..95693db
--- /dev/null
+++ b/test/boolean.js
@@ -0,0 +1,30 @@
+'use strict';
+
+var S = require ('..');
+
+var eq = require ('./internal/eq');
+
+
+test ('boolean', function() {
+
+  eq (typeof S.boolean) ('function');
+  eq (S.show (S.boolean)) ('boolean :: a -> a -> Boolean -> a');
+
+  eq (S.boolean ('no') ('yes') (false)) ('no');
+  eq (S.boolean ('no') ('yes') (true)) ('yes');
+
+  // The alternatives may be any value of the result type, including falsy
+  // values, which must be returned as-is rather than substituted.
+  eq (S.boolean (0) (1) (false)) (0);
+  eq (S.boolean (1) (0) (true)) (0);
+  eq (S.boolean ('') ('x') (false)) ('');
+  eq (S.boolean ('x') ('') (true)) ('');
+  eq (S.boolean (false) (true) (false)) (false);
+  eq (S.boolean (true) (false) (true)) (false);
+
+  // The function is curried: each application returns a function until the
+  // Boolean argument is supplied.
+  eq (typeof S.boolean ('no')) ('function');
+  eq (typeof S.boolean ('no') ('yes')) ('function');
+
+});
