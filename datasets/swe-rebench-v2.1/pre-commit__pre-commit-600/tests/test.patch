 import mock
 import pytest
@@ -18,6 +20,62 @@ from testing.fixtures import git_dir
 from testing.util import get_head_sha
 
 
+def _render_log_args(args):
+    msg, params = args[0], args[1:]
+    return msg % params if params else msg
+
+
+def _rendered_log_messages(log_info_mock):
+    return [
+        _render_log_args(args) for args, _ in log_info_mock.call_args_list
+    ]
+
+
+def _hold_store_lock(directory, acquired, release):
+    with Store(directory).exclusive_lock():
+        acquired.set()
+        release.wait(10)
+
+
+def test_lock_wait_message_is_emitted_when_contended(
+        store, log_info_mock,
+):
+    os.mkdir(store.directory)
+    acquired = multiprocessing.Event()
+    release = multiprocessing.Event()
+    process = multiprocessing.Process(
+        target=_hold_store_lock,
+        args=(store.directory, acquired, release),
+    )
+    process.start()
+    timer = None
+    try:
+        assert acquired.wait(5)
+
+        def release_after_wait_message(*args):
+            if _render_log_args(args) == 'Locking pre-commit directory':
+                release.set()
+
+        log_info_mock.side_effect = release_after_wait_message
+        # Ensure the lock holder is released even if no message is emitted.
+        timer = threading.Timer(5, release.set)
+        timer.start()
+        with store.exclusive_lock():
+            pass
+        assert 'Locking pre-commit directory' in (
+            _rendered_log_messages(log_info_mock)
+        )
+    finally:
+        release.set()
+        if timer is not None:
+            timer.cancel()
+        process.join(5)
+        if process.is_alive():
+            process.terminate()
+            process.join()
+    assert process.exitcode == 0
+
+
