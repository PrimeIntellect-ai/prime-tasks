+
+fileprivate struct RepeatOK: ParsableArguments {
+  @Flag(exclusivity: .chooseFirst)
+  var color: Color
+}
+
+extension FlagsEndToEndTests {
+  func testParsingCaseIterable_RepeatableFlags() throws {
+    AssertParse(RepeatOK.self, ["--pink", "--purple"]) { options in
+      XCTAssertEqual(options.color, .pink)
+    }
+
+    AssertParse(RepeatOK.self, ["--silver", "--purple", "--pink"]) { options in
+      XCTAssertEqual(options.color, .silver)
+    }
+  }
+}
+
+
+enum ShortFlagValue: String, CaseIterable {
+  case s
+  case t
+  case u
+}
+
+fileprivate struct ShortRepeatOK: ParsableArguments {
+  @Flag(name: .short, exclusivity: .chooseFirst)
+  var flag1: ShortFlagValue
+}
+
+extension FlagsEndToEndTests {
+  func testParsingCaseIterable_RepeatableShortFlags() throws {
+    AssertParse(ShortRepeatOK.self, ["-s", "-t"]) { options in
+      XCTAssertEqual(options.flag1, .s)
+    }
+  }
+}
