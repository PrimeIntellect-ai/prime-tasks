 const { mock } = require('pactum');
 const assert = require('assert');
 const { publish } = require('../src');
+const http = require('http');
+
+async function publishWithSlackGroupMention(groupId) {
+  let requestBody;
+  const server = http.createServer((req, res) => {
+    const chunks = [];
+    req.on('data', chunk => chunks.push(chunk));
+    req.on('end', () => {
+      requestBody = JSON.parse(Buffer.concat(chunks).toString());
+      res.writeHead(200);
+      res.end();
+    });
+  });
+  await new Promise(resolve => server.listen(0, resolve));
+
+  try {
+    const address = server.address();
+    await publish({
+      config: {
+        reports: [{
+          targets: [{
+            name: 'slack',
+            inputs: { url: `http://localhost:${address.port}/message` },
+            extensions: [{
+              name: 'mentions',
+              inputs: { users: [{ name: 'mom', slack_gid: groupId }] }
+            }]
+          }],
+          results: [{ type: 'testng', files: ['test/data/testng/single-suite-failures.xml'] }]
+        }]
+      }
+    });
+  } finally {
+    await new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+  }
+
+  return JSON.stringify(requestBody);
+}
 
