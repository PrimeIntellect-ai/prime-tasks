+  @Test fun `a factory class is generated for provided properties in a separate module`() {
+    assumeFalse(useDagger)
+
+    // Module A provides a property.
+    val moduleA = compile(
+        """
+        package com.squareup.test
+
+        import dagger.Module
+        import dagger.Provides
+
+        class Foo
+
+        @Module
+        class MyModule {
+          @get:Provides val foo: Foo = Foo()
+        }
+        """
+    ) {
+      assertThat(exitCode).isEqualTo(OK)
+    }
+
+    // Module B depends on module A and declares a component that consumes the provided property.
+    val moduleB = compileWithClasspath(
+        classpath = listOf(moduleA.outputDirectory),
+        source = """
+        package com.squareup.test
+
+        import dagger.Component
+
+        @Component(modules = [MyModule::class])
+        interface MyComponent {
+          fun foo(): Foo
+        }
+        """
+    )
+
+    assertThat(moduleB.exitCode).isEqualTo(OK)
+  }
+
+  private fun compileWithClasspath(
+    classpath: List<File>,
+    source: String
+  ): Result {
+    return KotlinCompilation()
+        .apply {
+          compilerPlugins = listOf(AnvilComponentRegistrar())
+          useIR = USE_IR
+          inheritClassPath = true
+          jvmTarget = JvmTarget.JVM_1_8.description
+          classpaths = classpath
+          annotationProcessors = listOf(ComponentProcessor())
+
+          val commandLineProcessor = AnvilCommandLineProcessor()
+          commandLineProcessors = listOf(commandLineProcessor)
+          pluginOptions = listOf(
+              PluginOption(
+                  pluginId = commandLineProcessor.pluginId,
+                  optionName = srcGenDirName,
+                  optionValue = File(workingDir, "build/anvil").absolutePath
+              ),
+              PluginOption(
+                  pluginId = commandLineProcessor.pluginId,
+                  optionName = generateDaggerFactoriesName,
+                  optionValue = "false"
+              )
+          )
+
+          sources = listOf(SourceFile.kotlin("Source.kt", source, trimIndent = true))
+        }
+        .compile()
+  }
