+  @Test fun `a non-nullable provided property getter rejects a null runtime value`() {
+    compile(
+        """
+        package com.squareup.test
+
+        import dagger.Module
+        import dagger.Provides
+
+        @Module
+        class DaggerModule1 {
+          @get:Provides val string: String = "abc"
+        }
+        """
+    ) {
+      val factoryClass = daggerModule1.moduleFactoryClass("getString")
+      val module = daggerModule1.newInstance()
+      daggerModule1.getDeclaredField("string").apply { isAccessible = true }.set(module, null)
+      val staticMethods = factoryClass.declaredMethods.filter { it.isStatic }
+      val getter = staticMethods.first {
+        it.name == "getString" && it.parameterTypes.contentEquals(arrayOf(daggerModule1))
+      }
+
+      val getterFailure = try {
+        getter.invoke(null, module)
+        null
+      } catch (exception: java.lang.reflect.InvocationTargetException) {
+        exception.targetException
+      }
+      assertThat(getterFailure).isNotNull()
+
+      val create = staticMethods.first {
+        it.name == "create" && it.parameterTypes.contentEquals(arrayOf(daggerModule1))
+      }
+      val factory = create.invoke(null, module) as Factory<*>
+      val factoryFailure = try {
+        factory.get()
+        null
+      } catch (exception: java.lang.reflect.InvocationTargetException) {
+        exception.targetException
+      } catch (exception: Throwable) {
+        exception
+      }
+      assertThat(factoryFailure).isNotNull()
+    }
+  }
