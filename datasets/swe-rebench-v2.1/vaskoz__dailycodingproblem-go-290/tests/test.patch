@@ -0,0 +1,69 @@
+package day138
+
+import "testing"
+
+var testcases = []struct {
+	denom    []int
+	n        int
+	expected int
+	err      error
+}{
+	{[]int{1, 5, 10, 25}, 16, 3, nil},
+	{[]int{25}, 16, 0, ErrNotPossible()},
+	{[]int{2, 5}, 16, 5, nil},
+	{[]int{2, 3, 6}, 6, 1, nil},
+	{[]int{1, 3, 4}, 6, 2, nil},
+	{[]int{1, 5, 10, 25}, 0, 0, nil},
+	{[]int{25}, 0, 0, nil},
+}
+
+func TestMinCurrencyRequiredBrute(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		result, err := MinCurrencyRequiredBrute(tc.n, tc.denom)
+		if tc.err != nil {
+			if err != ErrNotPossible() {
+				t.Errorf("Expected an impossible-amount error, got %v", err)
+			}
+		} else if err != nil || result != tc.expected {
+			t.Errorf("Expected (%v,nil) got (%v,%v)", tc.expected, result, err)
+		}
+	}
+}
+
+func BenchmarkMinCurrencyRequiredBrute(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			MinCurrencyRequiredBrute(tc.n, tc.denom)
+		}
+	}
+}
+
+func TestMinCurrencyRequiredSmarter(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		result, err := MinCurrencyRequiredSmarter(tc.n, tc.denom)
+		if tc.err != nil {
+			if err != ErrNotPossible() {
+				t.Errorf("Expected an impossible-amount error, got %v", err)
+			}
+		} else if err != nil || result != tc.expected {
+			t.Errorf("Expected (%v,nil) got (%v,%v)", tc.expected, result, err)
+		}
+	}
+}
+
+func BenchmarkMinCurrencyRequiredSmarter(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			MinCurrencyRequiredSmarter(tc.n, tc.denom)
+		}
+	}
+}
+
+func TestErrNotPossibleIsSentinel(t *testing.T) {
+	t.Parallel()
+	if ErrNotPossible() != ErrNotPossible() {
+		t.Error("ErrNotPossible should return the same error value on each call")
+	}
+}
