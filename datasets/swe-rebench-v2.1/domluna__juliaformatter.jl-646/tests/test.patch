diff --git a/test/issues.jl b/test/issues.jl
index 0718643..7363826 100644
--- a/test/issues.jl
+++ b/test/issues.jl
@@ -1464,4 +1464,28 @@
         """
         @test fmt(s, 4, 92, pipe_to_function_call = true) == s_
     end
+
+    @testset "644" begin
+        s = """
+        @foo @noinline Base.@constprop :none aaaaaaaaaaaaa() = 0
+        @foo @noinline Base.@constprop :none bbbbbbbbbbbbbbbbbbb()     = 0
+        @foo @foo @ccccccccccccccccccccccccccccccccccccccccccccccccc() = 0
+        """
+        out = fmt(s, 4, 92, align_assignment = true)
+        lines = split(chomp(out), '\n')
+        @test length(lines) == 3
+        # only whitespace may change
+        @test replace(out, r" +" => " ") == replace(s, r" +" => " ")
+        # the `=` of each assignment line starts at the same column
+        eq_cols = [findfirst('=', l) for l in lines]
+        @test all(==(eq_cols[1]), eq_cols)
+
+        # no manual edit
+        s = """
+        @foo @noinline Base.@constprop :none aaaaaaaaaaaaa() = 0
+        @foo @noinline Base.@constprop :none bbbbbbbbbbbbbbbbbbbbbbb() = 0
+        @foo @foo @ccccccccccccccccccccccccccccccccccccccccccccccccc() = 0
+        """
+        @test fmt(s, 4, 92, align_assignment = true) == s
+    end
 end
