+describe('getCacheBustedUrl', function() {
+  it('should append the cache-busting parameter', function(done) {
+    var url = 'http://example.com/';
+    var cacheBustedUrl = externalFunctions.getCacheBustedUrl(url);
+    assert.notStrictEqual(url, cacheBustedUrl);
+    done();
+  });
+
+  it('should produce the same output when called with the same "now" parameter', function(done) {
+    var url = 'http://example.com/';
+    var now = 123;
+    var cacheBustedUrl = externalFunctions.getCacheBustedUrl(url, now);
+    var cacheBustedUrlPrime = externalFunctions.getCacheBustedUrl(url, now);
+    assert.strictEqual(cacheBustedUrl, cacheBustedUrlPrime);
+    done();
+  });
+
+  it('should produce different output when called twice, with a delay in between', function(done) {
+    var url = 'http://example.com/';
+    var cacheBustedUrl = externalFunctions.getCacheBustedUrl(url);
+    setTimeout(function() {
+      var cacheBustedUrlPrime = externalFunctions.getCacheBustedUrl(url);
+      assert.notStrictEqual(cacheBustedUrl, cacheBustedUrlPrime);
+      done();
+    }, 2);
+  });
+
+  it('should append the URL parameter without modifying any existing parameters', function(done) {
+    var url = 'http://example.com/?one=two';
+    var cacheBustedUrl = externalFunctions.getCacheBustedUrl(url);
+    // The cache-busted URL should consist of the basic URL, followed by '&' and then the
+    // cached-busting parameters, in order to keep the same semantics.
+    assert(cacheBustedUrl.indexOf(url + '&') === 0);
+    done();
+  });
+});
+
+describe('cache keys', function() {
+  // Evaluate the generated service worker in a minimal mock of the service worker
+  // environment, trigger its install event, and report the keys used to store responses.
+  function getCacheKeys(serviceWorker, callback) {
+    var putCalls = [];
+    var handlers = {};
+
+    function makeCache(name) {
+      function record(key) {
+        putCalls.push({cacheName: name, key: key});
+      }
+
+      return {
+        put: function(key) {
+          record(key);
+          return Promise.resolve();
+        },
+        add: function(key) {
+          record(key);
+          return Promise.resolve();
+        },
+        addAll: function(keys) {
+          keys.forEach(record);
+          return Promise.resolve();
+        },
+        match: function() {
+          return Promise.resolve(undefined);
+        },
+        keys: function() {
+          return Promise.resolve([]);
+        }
+      };
+    }
+
+    var sandbox = {
+      self: {
+        location: 'http://example.com/',
+        registration: {scope: 'http://example.com/'},
+        addEventListener: function(type, handler) {
+          handlers[type] = handler;
+        }
+      },
+      caches: {
+        keys: function() {
+          return Promise.resolve([]);
+        },
+        open: function(name) {
+          return Promise.resolve(makeCache(name));
+        },
+        delete: function() {
+          return Promise.resolve(true);
+        }
+      },
+      Request: function(url) {
+        this.url = url;
+        this.clone = function() {
+          return new sandbox.Request(url);
+        };
+      },
+      fetch: function() {
+        return Promise.resolve({ok: true, status: 200});
+      },
+      console: console,
+      Promise: Promise,
+      URL: URL,
+      Date: Date
+    };
+    sandbox.global = sandbox;
+
+    vm.runInNewContext(serviceWorker, sandbox);
+
+    var waitPromise;
+    handlers.install({waitUntil: function(promise) {
+      waitPromise = promise;
+    }});
+
+    waitPromise.then(function() {
+      callback(null, putCalls);
+    }, callback);
+  }
+
+  it('should store responses under the asset URL without the cache-busting parameter', function(done) {
+    generate({logger: NOOP, staticFileGlobs: ['test/data/one/**']}, function(error, serviceWorker) {
+      assert.ifError(error);
+
+      getCacheKeys(serviceWorker, function(error, putCalls) {
+        assert.ifError(error);
+        assert(putCalls.length > 0, 'expected at least one response to be cached');
+
+        var keys = putCalls.map(function(call) {
+          var key = call.key;
+          return (key && typeof key === 'object' && key.url) ? key.url : String(key);
+        });
+
+        keys.forEach(function(key) {
+          assert(key.indexOf('sw-precache=') === -1,
+            'cache key should not include the cache-busting parameter, but was: ' + key);
+        });
+
+        assert.deepEqual(keys.sort(), [
+          'http://example.com/test/data/one/a.txt',
+          'http://example.com/test/data/one/c.txt'
+        ]);
+        done();
+      });
+    });
+  });
+});
