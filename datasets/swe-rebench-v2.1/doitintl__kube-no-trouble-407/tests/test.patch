+// gcpAuthProviderKubeconfig configures a cluster that uses the deprecated gcp
+// auth provider. Loading it makes the Kubernetes client emit a klog warning,
+// which the binary must suppress.
+const gcpAuthProviderKubeconfig = `apiVersion: v1
+kind: Config
+clusters:
+- name: gcp-cluster
+  cluster:
+    server: https://127.0.0.1:1
+contexts:
+- name: gcp-context
+  context:
+    cluster: gcp-cluster
+    user: gcp-user
+current-context: gcp-context
+users:
+- name: gcp-user
+  user:
+    auth-provider:
+      name: gcp
+`
+
+// TestMainSuppressesClientWarnings verifies that the binary does not display
+// the deprecated-auth-provider warning emitted while loading a kubeconfig.
+func TestMainSuppressesClientWarnings(t *testing.T) {
+	tmpDir, err := ioutil.TempDir(os.TempDir(), "kubent-gcp-")
+	if err != nil {
+		t.Fatalf("failed to create temp dir for testing: %v", err)
+	}
+	defer os.RemoveAll(tmpDir)
+
+	kubeconfig := filepath.Join(tmpDir, "gcp.config")
+	if err := os.WriteFile(kubeconfig, []byte(gcpAuthProviderKubeconfig), 0600); err != nil {
+		t.Fatalf("failed to write gcp kubeconfig: %v", err)
+	}
+
+	args := []string{"--helm3=false", "-k=" + kubeconfig}
+	base64Args, _ := encodeBase64(args)
+
+	var stdout, stderr bytes.Buffer
+	cmd := exec.Command(os.Args[0], "-test.run=TestMainExitCodes")
+	cmd.Env = append(os.Environ(),
+		"TEST_EXIT_CODE=1",
+		"TEST_ARGS="+base64Args)
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	_ = cmd.Run()
+
+	errStr := stderr.String()
+	if strings.Contains(errStr, "gcp auth plugin is deprecated") {
+		t.Fatalf("expected go-client warnings to be suppressed, instead got: %s", errStr)
+	}
+}
+
+// TestMainSuppressesAPIWarnings verifies that warning headers returned by an
+// API server do not appear in the executable's output, regardless of their text.
+func TestMainSuppressesAPIWarnings(t *testing.T) {
+	const warning = `299 - "API deprecation warning sentinel"`
+	requests := make(chan struct{}, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		select {
+		case requests <- struct{}{}:
+		default:
+		}
+		w.Header().Set("Warning", warning)
+		w.Header().Set("Content-Type", "application/json")
+		if r.URL.Path == "/version" {
+			_, _ = w.Write([]byte(`{"major":"1","minor":"23","gitVersion":"v1.23.0"}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"kind":"APIGroupList","apiVersion":"v1","groups":[]}`))
+	}))
+	defer server.Close()
+
+	tmpDir, err := ioutil.TempDir(os.TempDir(), "kubent-api-warning-")
+	if err != nil {
+		t.Fatalf("failed to create temporary directory: %v", err)
+	}
+	defer os.RemoveAll(tmpDir)
+
+	kubeconfig := filepath.Join(tmpDir, "warning.config")
+	config := "apiVersion: v1\nkind: Config\nclusters:\n- name: test\n  cluster:\n    server: " + server.URL + "\ncontexts:\n- name: test\n  context:\n    cluster: test\n    user: test\ncurrent-context: test\nusers:\n- name: test\n  user: {}\n"
+	if err := os.WriteFile(kubeconfig, []byte(config), 0600); err != nil {
+		t.Fatalf("failed to write kubeconfig: %v", err)
+	}
+
+	args := []string{"--helm3=false", "-k=" + kubeconfig}
+	base64Args, _ := encodeBase64(args)
+	cmd := exec.Command(os.Args[0], "-test.run=TestMainExitCodes")
+	cmd.Env = append(os.Environ(), "TEST_EXIT_CODE=1", "TEST_ARGS="+base64Args)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	_ = cmd.Run()
+
+	select {
+	case <-requests:
+	default:
+		t.Fatal("the executable did not make a request to the API server")
+	}
+	output := stdout.String() + stderr.String()
+	if strings.Contains(output, "API deprecation warning sentinel") {
+		t.Fatalf("API response warning appeared in executable output: %s", output)
+	}
+}
