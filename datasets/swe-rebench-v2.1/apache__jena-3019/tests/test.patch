+    public void test() {
+        if ( expectsUniqueLangResults(test) )
+            testUniqueLangValueNodes(test);
+        else
+            ShaclTest.shaclTest(test);
+    }
+
+    private static boolean expectsUniqueLangResults(ShaclTestItem test) {
+        return test.getResult().getModel()
+                .contains(null, SHACLM.sourceConstraintComponent, SHACLM.UniqueLangConstraintComponent);
+    }
+
+    /**
+     * An sh:uniqueLang result must identify the duplicated value node(s).
+     * The rest of the report is compared with the expected report, ignoring the value nodes.
+     */
+    private static void testUniqueLangValueNodes(ShaclTestItem test) {
+        Graph shapesGraph = RDFDataMgr.loadGraph(test.getShapesGraph().getURI());
+        Graph dataGraph = RDFDataMgr.loadGraph(test.getDataGraph().getURI());
+        ValidationReport vReportGot = ShaclValidator.get().validate(shapesGraph, dataGraph);
+        ValidationReport vReportExpected = ValidationReport.fromGraph(test.getResult().getModel().getGraph());
+
+        Model modelGot = withoutValueNodes(VR.strip(vReportGot.getResource().getModel()));
+        Model modelExpected = withoutValueNodes(VR.strip(vReportExpected.getResource().getModel()));
+        assertTrue("Report models differ : " + test.origin(), modelGot.isIsomorphicWith(modelExpected));
+
+        Model data = ModelFactory.createModelForGraph(dataGraph);
+        Model reportModel = vReportGot.getResource().getModel();
+        List<Resource> results = reportModel
+                .listSubjectsWithProperty(SHACLM.sourceConstraintComponent, SHACLM.UniqueLangConstraintComponent)
+                .toList();
+        assertFalse("No sh:uniqueLang results : " + test.origin(), results.isEmpty());
+        for ( Resource result : results ) {
+            RDFNode value = result.getProperty(SHACLM.value) != null ? result.getProperty(SHACLM.value).getObject() : null;
+            assertNotNull("sh:uniqueLang result has no value node : " + test.origin(), value);
+            assertTrue("sh:uniqueLang value node is not a language-tagged literal : " + value,
+                       value.isLiteral() && !value.asLiteral().getLanguage().isEmpty());
+            Resource focus = result.getPropertyResourceValue(SHACLM.focusNode);
+            Resource path = result.getPropertyResourceValue(SHACLM.resultPath);
+            assertNotNull("No focus node : " + test.origin(), focus);
+            assertNotNull("No result path : " + test.origin(), path);
+            Property p = ResourceFactory.createProperty(path.getURI());
+            String lang = value.asLiteral().getLanguage();
+            // The value node must be one of the duplicated values on the focus node.
+            long sameLang = data.listObjectsOfProperty(focus, p).toList().stream()
+                    .filter(n -> n.isLiteral() && n.asLiteral().getLanguage().equalsIgnoreCase(lang))
+                    .count();
+            assertTrue("Value node " + value + " is not a duplicate language tag on " + focus, sameLang >= 2);
+            assertTrue("Value node " + value + " is not a value of " + focus,
+                       data.contains(focus, p, value));
+        }
+    }
+
+    private static Model withoutValueNodes(Model model) {
+        Model m = ModelFactory.createDefaultModel();
+        m.add(model);
+        m.removeAll(null, SHACLM.value, null);
+        return m;
+    }
