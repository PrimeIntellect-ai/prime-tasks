+#[test]
+fn gzip() {
+    let server = server::http(|_req| async move {
+        let compressed_bytes = vec![
+            0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x03, 0xf3, 0x48,
+            0xcd, 0xc9, 0xc9, 0x57, 0x28, 0xcf, 0x2f, 0xca, 0x49, 0xe1, 0x02, 0x00,
+            0xd5, 0xe0, 0x39, 0xb7, 0x0c, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+            0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+        ];
+
+        hyper::Response::builder()
+            .header("content-encoding", "gzip")
+            .body(compressed_bytes.into())
+            .unwrap()
+    });
+
+    let output = get_command()
+        .arg(server.base_url())
+        .assert()
+        .success()
+        .get_output()
+        .stdout
+        .clone();
+    let output = String::from_utf8_lossy(&output);
+    assert!(output.contains("Content-Encoding: gzip"));
+    assert!(output.contains("Content-Length: 48"));
+    assert!(output.contains("Hello world"));
+}
+
+#[test]
+fn deflate() {
+    let server = server::http(|_req| async move {
+        let compressed_bytes = vec![
+            0x78, 0x9c, 0xf3, 0x48, 0xcd, 0xc9, 0xc9, 0x57, 0x28, 0xcf, 0x2f, 0xca,
+            0x49, 0xe1, 0x02, 0x00, 0x1c, 0xf2, 0x04, 0x47,
+        ];
+
+        hyper::Response::builder()
+            .header("content-encoding", "deflate")
+            .body(compressed_bytes.into())
+            .unwrap()
+    });
+
+    let output = get_command()
+        .arg(server.base_url())
+        .assert()
+        .success()
+        .get_output()
+        .stdout
+        .clone();
+    let output = String::from_utf8_lossy(&output);
+    assert!(output.contains("Content-Encoding: deflate"));
+    assert!(output.contains("Content-Length: 20"));
+}
+
+#[test]
+fn brotli() {
+    let server = server::http(|_req| async move {
+        let compressed_bytes = vec![
+            0x1b, 0x0b, 0x00, 0x00, 0x24, 0x15, 0x40, 0x90, 0x4a, 0x91, 0x45, 0x6a,
+            0xfa, 0x9c, 0x75, 0x02, 0x00,
+        ];
+
+        hyper::Response::builder()
+            .header("content-encoding", "br")
+            .body(compressed_bytes.into())
+            .unwrap()
+    });
+
+    let output = get_command()
+        .arg(server.base_url())
+        .assert()
+        .success()
+        .get_output()
+        .stdout
+        .clone();
+    let output = String::from_utf8_lossy(&output);
+    assert!(output.contains("Content-Encoding: br"));
+    assert!(output.contains("Content-Length: 17"));
+    assert!(output.contains("Hello world"));
+}
+
+#[test]
+fn empty_response_with_content_encoding() {
+    let server = server::http(|_req| async move {
+        hyper::Response::builder()
+            .header("content-encoding", "gzip")
+            .body("".into())
+            .unwrap()
+    });
+
+    let output = get_command()
+        .arg(server.base_url())
+        .assert()
+        .success()
+        .get_output()
+        .stdout
+        .clone();
+    let output = String::from_utf8_lossy(&output);
+    assert!(output.contains("Content-Encoding: gzip"));
+    assert!(output.contains("Content-Length: 0"));
+}
