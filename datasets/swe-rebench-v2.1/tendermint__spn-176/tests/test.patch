+package types
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/tendermint/spn/testutil/sample"
+)
+
+func TestMsgDeleteCoordinator_ValidateBasic(t *testing.T) {
+	serviceType := reflect.TypeOf((*MsgServer)(nil)).Elem()
+	method, exists := serviceType.MethodByName("DeleteCoordinator")
+	require.True(t, exists, "MsgServer must expose DeleteCoordinator")
+	if !exists {
+		return
+	}
+	requestType := method.Type.In(1)
+	require.Equal(t, "MsgDeleteCoordinator", requestType.Elem().Name())
+	addressField, exists := requestType.Elem().FieldByName("Address")
+	require.True(t, exists)
+	if !exists {
+		return
+	}
+	require.Equal(t, reflect.TypeOf(""), addressField.Type)
+
+	validateAddress := func(address string) error {
+		message := reflect.New(requestType.Elem())
+		message.Elem().FieldByName("Address").SetString(address)
+		validateBasic := message.MethodByName("ValidateBasic")
+		require.True(t, validateBasic.IsValid(), "deletion request must expose ValidateBasic")
+		if !validateBasic.IsValid() {
+			return nil
+		}
+		results := validateBasic.Call(nil)
+		if results[0].IsNil() {
+			return nil
+		}
+		return results[0].Interface().(error)
+	}
+
+	require.Error(t, validateAddress("invalid address"))
+	require.NoError(t, validateAddress(sample.AccAddress()))
+}
