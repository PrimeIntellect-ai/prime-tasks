+package keeper
+
+import (
+	"context"
+	"reflect"
+	"testing"
+
+	sdk "github.com/cosmos/cosmos-sdk/types"
+	"github.com/stretchr/testify/require"
+	"github.com/tendermint/spn/x/profile/types"
+)
+
+func TestMsgDeleteCoordinator(t *testing.T) {
+	serviceType := reflect.TypeOf((*types.MsgServer)(nil)).Elem()
+	method, exists := serviceType.MethodByName("DeleteCoordinator")
+	require.True(t, exists, "MsgServer must expose DeleteCoordinator")
+	if !exists {
+		return
+	}
+	require.Equal(t, 2, method.Type.NumIn())
+	require.Equal(t, reflect.TypeOf((*context.Context)(nil)).Elem(), method.Type.In(0))
+	requestType := method.Type.In(1)
+	require.Equal(t, "MsgDeleteCoordinator", requestType.Elem().Name())
+	addressField, exists := requestType.Elem().FieldByName("Address")
+	require.True(t, exists)
+	if !exists {
+		return
+	}
+	require.Equal(t, reflect.TypeOf(""), addressField.Type)
+	require.Equal(t, 2, method.Type.NumOut())
+	require.Equal(t, "MsgDeleteCoordinatorResponse", method.Type.Out(0).Elem().Name())
+	require.Equal(t, reflect.TypeOf((*error)(nil)).Elem(), method.Type.Out(1))
+
+	msgCoord := msgCreateCoordinator()
+	k, sdkCtx := setupKeeper(t)
+	ctx := sdk.WrapSDKContext(sdkCtx)
+	srv := NewMsgServerImpl(*k)
+	if _, err := srv.CreateCoordinator(ctx, &msgCoord); err != nil {
+		t.Fatal(err)
+	}
+
+	invokeDelete := func(address string) (reflect.Value, error) {
+		request := reflect.New(requestType.Elem())
+		request.Elem().FieldByName("Address").SetString(address)
+		results := reflect.ValueOf(srv).MethodByName("DeleteCoordinator").Call([]reflect.Value{
+			reflect.ValueOf(ctx), request,
+		})
+		if !results[1].IsNil() {
+			return reflect.Value{}, results[1].Interface().(error)
+		}
+		return results[0], nil
+	}
+
+	_, err := invokeDelete(msgCoord.Address)
+	require.NoError(t, err)
+	_, err = k.CoordinatorByAddress(ctx, &types.QueryGetCoordinatorByAddressRequest{Address: msgCoord.Address})
+	require.Error(t, err, "coordinator address association was not removed")
+	coordinators, err := k.CoordinatorAll(ctx, &types.QueryAllCoordinatorRequest{})
+	require.NoError(t, err)
+	require.Empty(t, coordinators.Coordinator, "coordinator record was not removed")
+}
