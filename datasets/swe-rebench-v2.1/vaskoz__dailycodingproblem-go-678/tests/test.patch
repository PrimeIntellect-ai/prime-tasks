@@ -0,0 +1,109 @@
+package day327
+
+import "testing"
+
+// nolint
+var testcases = []struct {
+	one, two, merged *BinaryTree
+}{
+	{
+		one: &BinaryTree{
+			Val:   5,
+			Left:  &BinaryTree{Val: 9},
+			Right: &BinaryTree{Val: 11},
+		},
+		two: &BinaryTree{
+			Val:   6,
+			Left:  &BinaryTree{Val: 10},
+			Right: &BinaryTree{Val: 21},
+		},
+		merged: &BinaryTree{
+			Val:   11,
+			Left:  &BinaryTree{Val: 19},
+			Right: &BinaryTree{Val: 32},
+		},
+	},
+	{
+		one: &BinaryTree{
+			Val:  5,
+			Left: &BinaryTree{Val: 9},
+		},
+		two: &BinaryTree{
+			Val:   6,
+			Right: &BinaryTree{Val: 21},
+		},
+		merged: &BinaryTree{
+			Val:   11,
+			Left:  &BinaryTree{Val: 9},
+			Right: &BinaryTree{Val: 21},
+		},
+	},
+	{
+		one: &BinaryTree{
+			Val:  5,
+			Left: &BinaryTree{Val: 9},
+		},
+		merged: &BinaryTree{
+			Val:  5,
+			Left: &BinaryTree{Val: 9},
+		},
+	},
+}
+
+func TestMergeBinaryTree(t *testing.T) {
+	t.Parallel()
+	for tcid, tc := range testcases {
+		if result := MergeBinaryTrees(tc.one, tc.two); !equal(result, tc.merged) {
+			t.Errorf("Trees in TCID%d don't match", tcid)
+		}
+	}
+}
+
+func BenchmarkMergeBinaryTree(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			MergeBinaryTrees(tc.one, tc.two)
+		}
+	}
+}
+
+func equal(a, b *BinaryTree) bool {
+	switch {
+	case a == nil && b != nil:
+		return false
+	case a != nil && b == nil:
+		return false
+	case a == nil && b == nil:
+		return true
+	case a.Val != b.Val:
+		return false
+	}
+	return equal(a.Left, b.Left) && equal(a.Right, b.Right)
+}
+
+func TestMergeBinaryTreesBothRootsNil(t *testing.T) {
+	if MergeBinaryTrees(nil, nil) != nil {
+		t.Error("merging two nil roots should return nil")
+	}
+}
+
+func cloneTree(node *BinaryTree) *BinaryTree {
+	if node == nil {
+		return nil
+	}
+	return &BinaryTree{Val: node.Val, Left: cloneTree(node.Left), Right: cloneTree(node.Right)}
+}
+
+func TestMergeBinaryTreesKeepsInputsUnchanged(t *testing.T) {
+	for tcid, tc := range testcases {
+		one, two := cloneTree(tc.one), cloneTree(tc.two)
+		wantOne, wantTwo := cloneTree(tc.one), cloneTree(tc.two)
+		MergeBinaryTrees(one, two)
+		if !equal(one, wantOne) {
+			t.Errorf("first input in TCID%d was modified by the merge", tcid)
+		}
+		if !equal(two, wantTwo) {
+			t.Errorf("second input in TCID%d was modified by the merge", tcid)
+		}
+	}
+}
