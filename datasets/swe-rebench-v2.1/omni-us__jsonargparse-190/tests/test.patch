+conditional_model_branch = True
+
+
+def conditional_model_first(option: int = 1):
+    pass
+
+
+def conditional_model_second(option: int = 1):
+    pass
+
+
+class ConditionalKwargsModel:
+    def __init__(self, **kwargs):
+        if conditional_model_branch:
+            conditional_model_first(**kwargs)
+        else:
+            conditional_model_second(**kwargs)
+
+
+class OtherTests(unittest.TestCase):
+
+    def test_namespace_clone_non_deepcopyable_value(self):
+        class NotDeepcopyable:
+            def __deepcopy__(self, memo):
+                raise TypeError('cannot deepcopy')
+
+        value = NotDeepcopyable()
+        namespace = Namespace(a=value)
+        cloned = namespace.clone()
+        self.assertIn('a', cloned)
+
+    def test_subcommand_parse_with_non_deepcopyable_default(self):
+        class NotDeepcopyable:
+            def __deepcopy__(self, memo):
+                raise TypeError('cannot deepcopy')
+
+        value = NotDeepcopyable()
+        parser = ArgumentParser(error_handler=None)
+        subcommands = parser.add_subcommands()
+        subparser = ArgumentParser(error_handler=None)
+        subparser.add_class_arguments(ConditionalKwargsModel, 'model')
+        subparser.add_argument('--value', default=value)
+        subcommands.add_subcommand('run', subparser)
+
+        parsed = parser.parse_args(['run', '--model.option=2'])
+        self.assertIn('value', parsed.run)
+        self.assertEqual(parsed.run.model.option, 2)
+
+
 if __name__ == '__main__':
     unittest.main(verbosity=2)
