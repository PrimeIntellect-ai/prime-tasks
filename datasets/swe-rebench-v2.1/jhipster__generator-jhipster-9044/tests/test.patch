+
+// Exercise the generated glue classes rather than requiring the configuration
+// class to live in one particular package.
+describe('generated Cucumber context configuration', () => {
+    it('configures the Spring context in one glue class, not the shared step-definition base', done => {
+        const path = require('path');
+        const fs = require('fs');
+        const helpers = require('yeoman-test');
+
+        helpers
+            .run(path.join(__dirname, '../../generators/app'))
+            .withOptions({ 'from-cli': true, skipInstall: true, skipChecks: true })
+            .withPrompts({
+                baseName: 'jhipster',
+                clientFramework: 'angularX',
+                packageName: 'com.mycompany.myapp',
+                packageFolder: 'com/mycompany/myapp',
+                serviceDiscoveryType: false,
+                authenticationType: 'jwt',
+                cacheProvider: 'ehcache',
+                enableHibernateCache: true,
+                databaseType: 'sql',
+                devDatabaseType: 'h2Disk',
+                prodDatabaseType: 'mysql',
+                useSass: false,
+                enableTranslation: true,
+                nativeLanguage: 'en',
+                languages: ['en'],
+                buildTool: 'maven',
+                rememberMeKey: '5c37379956bd1242f5636c8cb322c2966ad81277',
+                testFrameworks: ['cucumber'],
+                jhiPrefix: 'jhi',
+                applicationType: 'monolith'
+            })
+            .on('end', () => {
+                const cucumberDir = path.join('src/test/java/com/mycompany/myapp/cucumber');
+                const stepDefs = fs.readFileSync(path.join(cucumberDir, 'stepdefs/StepDefs.java'), 'utf8');
+                const configuredFiles = [];
+                const visit = directory => {
+                    fs.readdirSync(directory, { withFileTypes: true }).forEach(entry => {
+                        const file = path.join(directory, entry.name);
+                        if (entry.isDirectory()) {
+                            visit(file);
+                        } else if (entry.name.endsWith('.java')) {
+                            const content = fs.readFileSync(file, 'utf8');
+                            if (/@(?:[\w$.]*\.)?(?:SpringBootTest|ContextConfiguration|WebAppConfiguration)\b/.test(content)) {
+                                configuredFiles.push(file);
+                            }
+                        }
+                    });
+                };
+                visit(cucumberDir);
+
+                try {
+                    if (/@(?:[\w$.]*\.)?(?:SpringBootTest|ContextConfiguration|WebAppConfiguration)\b/.test(stepDefs)) {
+                        throw new Error('The shared step-definition base configures the Spring context');
+                    }
+                    if (configuredFiles.length !== 1) {
+                        throw new Error(`Expected one Cucumber context-configuring class, found ${configuredFiles.length}`);
+                    }
+                    done();
+                } catch (error) {
+                    done(error);
+                }
+            })
+            .on('error', done);
+    });
+});
