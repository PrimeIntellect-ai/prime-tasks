--- a/test/aggregates/registry_test.exs
+++ b/test/aggregates/registry_test.exs
@@ -1,9 +1,34 @@
 defmodule SupervisorTest do
   use Commanded.StorageCase
 
+  @registry_provider Application.get_env(:commanded, :registry_provider, Registry)
+
   test "should let use integer, atom or string as aggregate_uuid" do
     Enum.each([1, :atom, "string"], fn aggregate_uuid ->
-      {:ok, _aggregate} = Commanded.Aggregates.Supervisor.open_aggregate(Commanded.ExampleDomain.BankAccount, aggregate_uuid)
+      {:ok, ^aggregate_uuid} = Commanded.Aggregates.Supervisor.open_aggregate(Commanded.ExampleDomain.BankAccount, aggregate_uuid)
     end)
   end
+
+  test "opening an already-running aggregate returns its UUID" do
+    aggregate_uuid = "already-running-witness"
+    aggregate_module = Commanded.ExampleDomain.BankAccount
+
+    assert {:ok, ^aggregate_uuid} = Commanded.Aggregates.Supervisor.open_aggregate(aggregate_module, aggregate_uuid)
+    assert {:ok, ^aggregate_uuid} = Commanded.Aggregates.Supervisor.open_aggregate(aggregate_module, aggregate_uuid)
+
+    Commanded.Helpers.Process.shutdown(aggregate_module, aggregate_uuid)
+  end
+
+  test "shutdown stops the aggregate process identified by module and UUID" do
+    aggregate_uuid = UUID.uuid4()
+    aggregate_module = Commanded.ExampleDomain.BankAccount
+
+    assert {:ok, ^aggregate_uuid} = Commanded.Aggregates.Supervisor.open_aggregate(aggregate_module, aggregate_uuid)
+    pid = apply(@registry_provider, :whereis_name, [{:aggregate_registry, {aggregate_module, aggregate_uuid}}])
+    assert is_pid(pid)
+    ref = Process.monitor(pid)
+
+    Commanded.Helpers.Process.shutdown(aggregate_module, aggregate_uuid)
+    assert_receive {:DOWN, ^ref, :process, ^pid, _reason}, 5_000
+  end
 end
