+
+func handleEditImageEndpointCheckingMask(w http.ResponseWriter, r *http.Request, wantMask bool) {
+	if err := r.ParseMultipartForm(1 << 20); err != nil {
+		http.Error(w, "could not read request", http.StatusBadRequest)
+		return
+	}
+	maskFile, _, err := r.FormFile("mask")
+	gotMask := err == nil
+	if maskFile != nil {
+		maskFile.Close()
+	}
+	if gotMask != wantMask {
+		http.Error(w, "unexpected mask part", http.StatusBadRequest)
+		return
+	}
