+// TestHostnameAntiAffinityModes verifies the host anti-affinity helper used by
+// the etcd StatefulSet: "required" yields a required term, everything else
+// yields a single preferred term of weight 100 selecting the given app.
+func TestHostnameAntiAffinityModes(t *testing.T) {
+	for _, mode := range []kubermaticv1.AntiAffinityType{"", kubermaticv1.AntiAffinityTypePreferred} {
+		affinity := resources.HostnameAntiAffinity("my-app", mode)
+		if affinity == nil || affinity.PodAntiAffinity == nil {
+			t.Fatalf("mode %q: expected pod anti-affinity, got %#v", mode, affinity)
+		}
+		if len(affinity.PodAntiAffinity.RequiredDuringSchedulingIgnoredDuringExecution) != 0 {
+			t.Errorf("mode %q: expected no required terms, got %d", mode, len(affinity.PodAntiAffinity.RequiredDuringSchedulingIgnoredDuringExecution))
+		}
+		preferred := affinity.PodAntiAffinity.PreferredDuringSchedulingIgnoredDuringExecution
+		if len(preferred) != 1 {
+			t.Fatalf("mode %q: expected exactly one preferred term, got %d", mode, len(preferred))
+		}
+		if preferred[0].Weight != 100 {
+			t.Errorf("mode %q: expected preferred weight 100, got %d", mode, preferred[0].Weight)
+		}
+		if preferred[0].PodAffinityTerm.TopologyKey != resources.TopologyKeyHostname {
+			t.Errorf("mode %q: expected topology key %q, got %q", mode, resources.TopologyKeyHostname, preferred[0].PodAffinityTerm.TopologyKey)
+		}
+		if preferred[0].PodAffinityTerm.LabelSelector.MatchLabels[resources.AppLabelKey] != "my-app" {
+			t.Errorf("mode %q: expected app label %q, got %q", mode, "my-app", preferred[0].PodAffinityTerm.LabelSelector.MatchLabels[resources.AppLabelKey])
+		}
+	}
+
+	affinity := resources.HostnameAntiAffinity("my-app", kubermaticv1.AntiAffinityTypeRequired)
+	if affinity == nil || affinity.PodAntiAffinity == nil {
+		t.Fatalf("required: expected pod anti-affinity, got %#v", affinity)
+	}
+	if len(affinity.PodAntiAffinity.PreferredDuringSchedulingIgnoredDuringExecution) != 0 {
+		t.Errorf("required: expected no preferred terms, got %d", len(affinity.PodAntiAffinity.PreferredDuringSchedulingIgnoredDuringExecution))
+	}
+	required := affinity.PodAntiAffinity.RequiredDuringSchedulingIgnoredDuringExecution
+	if len(required) != 1 {
+		t.Fatalf("required: expected exactly one required term, got %d", len(required))
+	}
+	if required[0].TopologyKey != resources.TopologyKeyHostname {
+		t.Errorf("required: expected topology key %q, got %q", resources.TopologyKeyHostname, required[0].TopologyKey)
+	}
+	if required[0].LabelSelector.MatchLabels[resources.AppLabelKey] != "my-app" {
+		t.Errorf("required: expected app label %q, got %q", "my-app", required[0].LabelSelector.MatchLabels[resources.AppLabelKey])
+	}
+}
