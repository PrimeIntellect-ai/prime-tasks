+// TestEtcdStatefulSetRequiredAntiAffinityPreventsCoLocation verifies that the
+// required anti-affinity terms select the etcd pods and use the hostname
+// topology key, which is what prevents two etcd pods from running on the same
+// node.
+func TestEtcdStatefulSetRequiredAntiAffinityPreventsCoLocation(t *testing.T) {
+	cluster := &kubermaticv1.Cluster{
+		ObjectMeta: metav1.ObjectMeta{Name: "test-cluster"},
+		Spec: kubermaticv1.ClusterSpec{
+			ComponentsOverride: kubermaticv1.ComponentSettings{
+				Etcd: kubermaticv1.EtcdStatefulSetSettings{
+					HostAntiAffinity: kubermaticv1.AntiAffinityTypeRequired,
+					ZoneAntiAffinity: kubermaticv1.AntiAffinityTypeRequired,
+				},
+			},
+		},
+	}
+	data := &fakeEtcdStatefulSetData{cluster: cluster, supportsZoneAntiAffinity: true}
+
+	_, reconciler := etcd.StatefulSetReconciler(data, false, false)()
+	set, err := reconciler(&appsv1.StatefulSet{})
+	if err != nil {
+		t.Fatalf("failed to reconcile etcd StatefulSet: %v", err)
+	}
+
+	affinity := set.Spec.Template.Spec.Affinity
+	if affinity == nil || affinity.PodAntiAffinity == nil {
+		t.Fatalf("expected pod anti-affinity to be configured, got %#v", affinity)
+	}
+
+	required := affinity.PodAntiAffinity.RequiredDuringSchedulingIgnoredDuringExecution
+	if len(required) == 0 {
+		t.Fatalf("expected required pod anti-affinity terms, got none")
+	}
+
+	foundHostname := false
+	for _, term := range required {
+		if term.LabelSelector == nil {
+			t.Errorf("required anti-affinity term has no label selector")
+			continue
+		}
+		if term.LabelSelector.MatchLabels[resources.AppLabelKey] != resources.EtcdStatefulSetName {
+			t.Errorf("required anti-affinity term selects app=%q, want %q", term.LabelSelector.MatchLabels[resources.AppLabelKey], resources.EtcdStatefulSetName)
+		}
+		if term.TopologyKey == resources.TopologyKeyHostname {
+			foundHostname = true
+		}
+	}
+	if !foundHostname {
+		t.Errorf("expected a required anti-affinity term with topology key %q to keep etcd pods off the same node", resources.TopologyKeyHostname)
+	}
+}
