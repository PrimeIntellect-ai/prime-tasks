+// fakeEtcdStatefulSetData is a minimal implementation of the data interface
+// consumed by the etcd StatefulSet reconciler. It only carries the cluster
+// settings that influence the pod anti-affinity configuration.
+type fakeEtcdStatefulSetData struct {
+	cluster                  *kubermaticv1.Cluster
+	supportsZoneAntiAffinity bool
+}
+
+func (f *fakeEtcdStatefulSetData) Cluster() *kubermaticv1.Cluster {
+	return f.cluster
+}
+
+func (f *fakeEtcdStatefulSetData) GetPodTemplateLabels(_ string, _ []corev1.Volume, baseLabels map[string]string) (map[string]string, error) {
+	return baseLabels, nil
+}
+
+func (f *fakeEtcdStatefulSetData) RewriteImage(image string) (string, error) {
+	return image, nil
+}
+
+func (f *fakeEtcdStatefulSetData) EtcdDiskSize() resource.Quantity {
+	return resource.MustParse("5Gi")
+}
+
+func (f *fakeEtcdStatefulSetData) EtcdLauncherImage() string {
+	return "etcd-launcher"
+}
+
+func (f *fakeEtcdStatefulSetData) EtcdLauncherTag() string {
+	return "v1"
+}
+
+func (f *fakeEtcdStatefulSetData) GetClusterRef() metav1.OwnerReference {
+	return metav1.OwnerReference{}
+}
+
+func (f *fakeEtcdStatefulSetData) SupportsFailureDomainZoneAntiAffinity() bool {
+	return f.supportsZoneAntiAffinity
+}
+
+func sortedStrings(in []string) []string {
+	out := append([]string(nil), in...)
+	sort.Strings(out)
+	return out
+}
+
+func requiredTopologyKeys(terms []corev1.PodAffinityTerm) []string {
+	keys := []string{}
+	for _, term := range terms {
+		keys = append(keys, term.TopologyKey)
+	}
+	return sortedStrings(keys)
+}
+
+func preferredTopologyKeys(terms []corev1.WeightedPodAffinityTerm) []string {
+	keys := []string{}
+	for _, term := range terms {
+		keys = append(keys, term.PodAffinityTerm.TopologyKey)
+	}
+	return sortedStrings(keys)
+}
+
+// TestEtcdStatefulSetAntiAffinityModes verifies that the etcd StatefulSet
+// reflects the configured host and zone anti-affinity modes. In particular it
+// pins down that the empty string and "preferred" behave identically (both
+// produce preferred anti-affinity) and that "required" produces required
+// anti-affinity, which is what keeps two etcd pods from being scheduled onto
+// the same node/zone.
+func TestEtcdStatefulSetAntiAffinityModes(t *testing.T) {
+	tests := []struct {
+		name             string
+		hostAntiAffinity kubermaticv1.AntiAffinityType
+		zoneAntiAffinity kubermaticv1.AntiAffinityType
+		wantRequired     []string
+		wantPreferred    []string
+	}{
+		{
+			name:             "empty values default to preferred anti-affinity",
+			hostAntiAffinity: "",
+			zoneAntiAffinity: "",
+			wantRequired:     []string{},
+			wantPreferred:    []string{resources.TopologyKeyHostname, resources.TopologyKeyZone},
+		},
+		{
+			name:             "explicit preferred matches the default behaviour",
+			hostAntiAffinity: kubermaticv1.AntiAffinityTypePreferred,
+			zoneAntiAffinity: kubermaticv1.AntiAffinityTypePreferred,
+			wantRequired:     []string{},
+			wantPreferred:    []string{resources.TopologyKeyHostname, resources.TopologyKeyZone},
+		},
+		{
+			name:             "required zone anti-affinity",
+			hostAntiAffinity: "",
+			zoneAntiAffinity: kubermaticv1.AntiAffinityTypeRequired,
+			wantRequired:     []string{resources.TopologyKeyZone},
+			wantPreferred:    []string{resources.TopologyKeyHostname},
+		},
+		{
+			name:             "required host anti-affinity",
+			hostAntiAffinity: kubermaticv1.AntiAffinityTypeRequired,
+			zoneAntiAffinity: "",
+			wantRequired:     []string{resources.TopologyKeyHostname},
+			wantPreferred:    []string{resources.TopologyKeyZone},
+		},
+		{
+			name:             "required host and zone anti-affinity",
+			hostAntiAffinity: kubermaticv1.AntiAffinityTypeRequired,
+			zoneAntiAffinity: kubermaticv1.AntiAffinityTypeRequired,
+			wantRequired:     []string{resources.TopologyKeyHostname, resources.TopologyKeyZone},
+			wantPreferred:    []string{},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			cluster := &kubermaticv1.Cluster{
+				ObjectMeta: metav1.ObjectMeta{Name: "test-cluster"},
+				Spec: kubermaticv1.ClusterSpec{
+					ComponentsOverride: kubermaticv1.ComponentSettings{
+						Etcd: kubermaticv1.EtcdStatefulSetSettings{
+							HostAntiAffinity: test.hostAntiAffinity,
+							ZoneAntiAffinity: test.zoneAntiAffinity,
+						},
+					},
+				},
+			}
+			data := &fakeEtcdStatefulSetData{cluster: cluster, supportsZoneAntiAffinity: true}
+
+			_, reconciler := etcd.StatefulSetReconciler(data, false, false)()
+			set, err := reconciler(&appsv1.StatefulSet{})
+			if err != nil {
+				t.Fatalf("failed to reconcile etcd StatefulSet: %v", err)
+			}
+
+			affinity := set.Spec.Template.Spec.Affinity
+			if affinity == nil || affinity.PodAntiAffinity == nil {
+				t.Fatalf("expected pod anti-affinity to be configured, got %#v", affinity)
+			}
+
+			gotRequired := requiredTopologyKeys(affinity.PodAntiAffinity.RequiredDuringSchedulingIgnoredDuringExecution)
+			gotPreferred := preferredTopologyKeys(affinity.PodAntiAffinity.PreferredDuringSchedulingIgnoredDuringExecution)
+
+			if !reflect.DeepEqual(gotRequired, sortedStrings(test.wantRequired)) {
+				t.Errorf("required anti-affinity topology keys = %v, want %v", gotRequired, sortedStrings(test.wantRequired))
+			}
+			if !reflect.DeepEqual(gotPreferred, sortedStrings(test.wantPreferred)) {
+				t.Errorf("preferred anti-affinity topology keys = %v, want %v", gotPreferred, sortedStrings(test.wantPreferred))
+			}
+		})
+	}
+}
