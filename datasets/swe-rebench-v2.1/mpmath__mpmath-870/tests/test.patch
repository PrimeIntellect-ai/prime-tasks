@@ -99,3 +99,20 @@ def test_trivial():
     assert findroot(lambda x: 0, 1) == 1
     assert findroot(lambda x: x, 0) == 0
     #assert findroot(lambda x, y: x + y, (1, -1)) == (1, -1)
+
+def test_issue_869():
+    # the four-equation system from the report must not make findroot hang;
+    # finishing with a result or a ValueError (ComplexResult is one) is fine
+    def F(a, b, c, d):
+        N0 = 38 + 34 + 0 + 49
+        S0 = mpf(34)/49
+        T0 = mpf(0)/49
+        phi = mpf('-0.44')
+        return [N0 - (a + b + c + d),
+                b - S0*d,
+                c - T0*d,
+                phi - (a*d - b*c)/sqrt((a + b)*(c + d)*(a + c)*(b + d))]
+    try:
+        findroot(F, (mpf(38), mpf(34), mpf(0), mpf(49)), maxsteps=2, tol=1e-6)
+    except ValueError:
+        pass
