+def test_http_request_parser_bad_uri(parser: Any) -> None:
+    with pytest.raises(Exception):
+        parser.feed_data(b"GET ! HTTP/1.1\r\n\r\n")
+
+
+async def test_http_request_parser_bad_uri_returns_400(aiohttp_client: Any) -> None:
+    async def handler(request: Any) -> Any:
+        return web.Response()
+
+    app = web.Application()
+    app.router.add_get("/", handler)
+    client = await aiohttp_client(app)
+
+    reader, writer = await asyncio.open_connection(client.host, client.port)
+    writer.write(b"GET ! HTTP/1.1\r\nHost: localhost\r\n\r\n")
+    await writer.drain()
+    try:
+        status_line = await reader.readline()
+        assert status_line.split()[1] == b"400"
+        await asyncio.wait_for(reader.read(), timeout=1)
+    finally:
+        writer.close()
+
+
