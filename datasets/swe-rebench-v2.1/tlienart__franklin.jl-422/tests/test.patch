@@ -111,3 +111,38 @@ end
     """ |> fd2html_td
     @test isapproxstr(h, "good lord")
 end
+
+@testset "Double brace" begin
+    s = """
+        @def title = "hello"
+        {{title}}{{title}}
+        """ |> fd2html_td
+    @test isapproxstr(s, "<p>hellohello</p>")
+end
+
+@testset "Double brace priority" begin
+    # `toc` is an internal hfun; the shorthand `{{toc}}` must not shadow it
+    # (the shorthand has least priority in case of ambiguity)
+    s = """
+        @def toc = "hello"
+        {{toc}}
+        """
+    out = try
+        s |> fd2html_td
+    catch
+        ""
+    end
+    @test !occursin("hello", out)
+end
+
+@testset "Double brace block precedence" begin
+    s = """
+        @def active = true
+        @def end = "shadow"
+        {{if active}}
+        kept
+        {{end}}
+        """ |> seval
+    @test occursin("kept", s)
+    @test !occursin("shadow", s)
+end
