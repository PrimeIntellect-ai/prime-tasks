+import { convertRules } from "../../convertRules";
+import { converters, mergers } from "../../converters";
+
+describe("quotemark conversion", () => {
+    test("converts an enabled quotemark rule through the normal rule workflow", () => {
+        const { converted, failed, missing } = convertRules(
+            { converters, mergers },
+            { quotemark: { ruleArguments: ["single"] } },
+        );
+
+        expect(missing).not.toContainEqual(
+            expect.objectContaining({ ruleName: "quotemark" }),
+        );
+        expect(failed).toEqual([]);
+        expect(converted.size).toBeGreaterThan(0);
+    });
+});
