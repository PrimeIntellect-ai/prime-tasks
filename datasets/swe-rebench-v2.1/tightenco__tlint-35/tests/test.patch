+<?php
+
+use PHPUnit\Framework\TestCase;
+use Symfony\Component\Console\Application;
+use Symfony\Component\Console\Tester\CommandTester;
+use Tighten\Commands\LintCommand;
+
+class NoDdTest extends TestCase
+{
+    /** @test */
+    public function the_normal_lint_workflow_reports_dd_calls_but_not_comment_text()
+    {
+        $cases = [
+            ["<?php\n// dd(\$commentedOut);\n", false],
+            ["<?php\ndd(\$value);\n", true],
+        ];
+
+        foreach ($cases as [$source, $shouldReportLint]) {
+            $file = sys_get_temp_dir() . '/tlint-' . uniqid('', true) . '.php';
+            file_put_contents($file, $source);
+
+            try {
+                $application = new Application;
+                $command = new LintCommand;
+                $application->add($command);
+                $commandTester = new CommandTester($command);
+
+                $commandTester->execute([
+                    'command' => $command->getName(),
+                    'file or directory' => $file,
+                ]);
+
+                $this->assertSame($shouldReportLint, $commandTester->getStatusCode() !== 0);
+            } finally {
+                unlink($file);
+            }
+        }
+    }
+}
