+func TestAdvertisedAWSServicesCanBeIngested(t *testing.T) {
+	services := GetSupportedServices()
+	assert.ElementsMatch(t, []string{"AmazonEC2", "AmazonRDS", "AWSELB"}, services)
+
+	// Every advertised service must be accepted by NewIngester.
+	for _, svc := range services {
+		newIngester(t, svc, "eu-west-3")
+	}
+}
+
+// newIngester checks successful construction without requiring a particular
+// number of return values from the public constructor.
+func newIngester(t *testing.T, service, region string, options ...Option) *Ingester {
+	t.Helper()
+	args := []reflect.Value{reflect.ValueOf(service), reflect.ValueOf(region)}
+	for _, option := range options {
+		args = append(args, reflect.ValueOf(option))
+	}
+	results := reflect.ValueOf(NewIngester).Call(args)
+	if len(results) > 1 && !results[1].IsNil() {
+		t.Fatalf("NewIngester rejected supported service %q: %v", service, results[1].Interface())
+	}
+	ing, ok := results[0].Interface().(*Ingester)
+	if !ok || ing == nil {
+		t.Fatalf("NewIngester did not return an Ingester for supported service %q", service)
+	}
+	return ing
+}
