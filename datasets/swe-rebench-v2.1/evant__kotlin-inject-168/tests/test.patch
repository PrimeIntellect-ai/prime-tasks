+package me.tatarka.inject.internal
+
+import assertk.assertThat
+import assertk.assertions.each
+import assertk.assertions.isEqualTo
+import assertk.assertions.isSameAs
+import kotlin.native.concurrent.TransferMode
+import kotlin.native.concurrent.Worker
+import kotlin.test.Test
+
+class LazyMapTestNative {
+
+    @Test
+    fun caches_value_from_multiple_threads() {
+        val lazyMap = LazyMap()
+        val count = 100
+        val results = List(count) {
+            Worker.start().execute(TransferMode.SAFE, { lazyMap }) {
+                it.get("test") { Any() }
+            }
+        }.map { it.result }
+
+        assertThat(results).each {
+            it.isSameAs(results.first())
+        }
+    }
+
+    @Test
+    fun caches_values_consistently_across_concurrent_workers() {
+        val lazyMap = LazyMap()
+        val workerCount = 8
+        val futures = List(workerCount) {
+            Worker.start().execute(TransferMode.SAFE, { lazyMap }) { map ->
+                List(1000) { key -> map.get("key$key") { Any() } }
+            }
+        }
+        val results = futures.map { it.result }
+
+        val first = results.first()
+        results.forEach { assertThat(it).isEqualTo(first) }
+    }
+}
