+def test_dynamic_value_recalculation_counts_eligible_user_solves():
+    app = create_ctfd(enable_plugins=True, user_mode="users")
+    with app.app_context():
+        register_user(app)
+        admin = login_as_user(app, name="admin", password="password")
+        admin.post(
+            "/api/v1/challenges",
+            json={
+                "name": "dynamic",
+                "category": "category",
+                "description": "description",
+                "value": 100,
+                "decay": 20,
+                "minimum": 1,
+                "state": "visible",
+                "type": "dynamic",
+            },
+        )
+        gen_flag(app.db, challenge_id=1, content="flag")
+
+        solvers = []
+        for i in range(10):
+            name = "solver{}".format(i)
+            email = "solver{}@ctfd.io".format(i)
+            user = gen_user(app.db, name=name, email=email)
+            solvers.append(user)
+            with app.test_client() as client:
+                with client.session_transaction() as session:
+                    session["id"] = user.id
+                    session["name"] = name
+                    session["type"] = "user"
+                    session["email"] = email
+                    session["nonce"] = "fake-nonce"
+                response = client.post(
+                    "/api/v1/challenges/attempt",
+                    json={"submission": "flag", "challenge_id": 1},
+                )
+                assert response.get_json()["data"]["status"] == "correct"
+
+        for user in solvers[-2:]:
+            Users.query.filter_by(id=user.id).update({"banned": True})
+        app.db.session.commit()
+
+        response = admin.patch(
+            "/api/v1/challenges/1",
+            json={"initial": 100, "minimum": 1, "decay": 20},
+        )
+        assert response.status_code == 200
+        assert response.get_json()["data"]["value"] == 85
+    destroy_ctfd(app)
+
+
+def test_banned_user_solve_does_not_contribute_to_dynamic_decay():
+    app = create_ctfd(enable_plugins=True, user_mode="users")
+    with app.app_context():
+        register_user(app)
+        admin = login_as_user(app, name="admin", password="password")
+        challenge_data = {
+            "name": "name",
+            "category": "category",
+            "description": "description",
+            "value": 100,
+            "decay": 20,
+            "minimum": 1,
+            "state": "visible",
+            "type": "dynamic",
+        }
+        admin.post("/api/v1/challenges", json=challenge_data)
+        gen_flag(app.db, challenge_id=1, content="flag")
+
+        def session_account(name, email, banned=False):
+            user = gen_user(app.db, name=name, email=email, banned=banned)
+            return {"id": user.id, "name": name, "email": email}
+
+        eligible_users = [
+            session_account("eligible{}".format(i), "eligible{}@ctfd.io".format(i))
+            for i in range(19)
+        ]
+        formerly_eligible_user = session_account("formerly-eligible", "formerly-eligible@ctfd.io")
+        final_user = session_account("final", "final@ctfd.io")
+
+        def submit_correct_flag(user):
+            with app.test_client() as client:
+                with client.session_transaction() as session:
+                    session["id"] = user["id"]
+                    session["name"] = user["name"]
+                    session["type"] = "user"
+                    session["email"] = user["email"]
+                    session["nonce"] = "fake-nonce"
+                return client.post(
+                    "/api/v1/challenges/attempt",
+                    json={"submission": "flag", "challenge_id": 1},
+                )
+
+        for user in eligible_users:
+            submit_correct_flag(user)
+        submit_correct_flag(formerly_eligible_user)
+        value_before_account_is_banned = DynamicChallenge.query.filter_by(id=1).first().value
+        Users.query.filter_by(id=formerly_eligible_user["id"]).update({"banned": True})
+        app.db.session.commit()
+        submit_correct_flag(final_user)
+
+        challenge = DynamicChallenge.query.filter_by(id=1).first()
+        assert challenge.value == value_before_account_is_banned
+    destroy_ctfd(app)
