+
+func TestLoad2_2AcceptsNOASSERTIONRelationshipTarget(t *testing.T) {
+	content := `SPDXVersion: SPDX-2.2
+DataLicense: CC0-1.0
+SPDXID: SPDXRef-DOCUMENT
+DocumentName: example
+DocumentNamespace: https://example.com/spdx
+Creator: Person: Example Author
+Created: 2020-01-01T00:00:00Z
+Relationship: SPDXRef-ion-tester CONTAINS NOASSERTION
+`
+
+	doc, err := tvloader.Load2_2(strings.NewReader(content))
+	if err != nil {
+		t.Fatalf("loading a valid Relationship with NOASSERTION on the right returned an error: %v", err)
+	}
+	if doc == nil || len(doc.Relationships) != 1 {
+		t.Fatalf("expected one parsed Relationship, got %#v", doc)
+	}
+}
