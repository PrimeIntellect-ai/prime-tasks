+++ b/salsa-2022-tests/tests/debug.rs
@@ -0,0 +1,113 @@
+//! Test that `DeriveWithDb` is correctly derived.
+
+use salsa::DebugWithDb;
+
+#[salsa::jar(db = Db)]
+struct Jar(
+    MyInput,
+    ComplexStruct,
+    MyTracked,
+    tracked_value,
+    InternedValue,
+);
+
+trait Db: salsa::DbWithJar<Jar> {}
+
+#[salsa::input]
+struct MyInput {
+    field: String,
+}
+
+#[derive(Debug, Eq, PartialEq, Clone)]
+struct NotSalsa {
+    field: String,
+}
+
+#[salsa::input]
+struct ComplexStruct {
+    my_input: MyInput,
+    not_salsa: NotSalsa,
+}
+
+#[salsa::tracked]
+struct MyTracked {
+    text: String,
+}
+
+#[salsa::tracked]
+fn tracked_value(db: &dyn Db, input: MyInput) -> MyTracked {
+    MyTracked::new(db, input.field(db).clone())
+}
+
+#[salsa::interned]
+struct InternedValue {
+    text: String,
+}
+
+#[salsa::db(Jar)]
+#[derive(Default)]
+struct Database {
+    storage: salsa::Storage<Self>,
+}
+
+impl salsa::Database for Database {
+    fn salsa_runtime(&self) -> &salsa::Runtime {
+        self.storage.runtime()
+    }
+}
+
+impl Db for Database {}
+
+#[test]
+fn input() {
+    let mut db = Database::default();
+
+    let input = MyInput::new(&mut db, "input value".to_string());
+    let not_salsa = NotSalsa {
+        field: "it's salsa time".to_string(),
+    };
+    let complex_struct = ComplexStruct::new(&mut db, input, not_salsa);
+
+    let actual = format!("{:?}", complex_struct.debug(&db));
+    let duplicate_input = MyInput::new(&mut db, "input value".to_string());
+    let duplicate_complex = ComplexStruct::new(
+        &mut db,
+        duplicate_input,
+        NotSalsa {
+            field: "it's salsa time".to_string(),
+        },
+    );
+    let duplicate_actual = format!("{:?}", duplicate_complex.debug(&db));
+
+    assert!(actual.contains("input value"));
+    assert!(actual.contains("it's salsa time"));
+    // The input and its containing struct each have a numeric identity. Their
+    // field values deliberately contain no digits, so the digits come from IDs.
+    assert!(actual.chars().filter(|c| c.is_ascii_digit()).count() >= 2);
+    assert_ne!(actual, duplicate_actual);
+
+    // Ordinary Debug is available as well as database-aware Debug.
+    let _ordinary_input = format!("{input:?}");
+    let _ordinary_complex_struct = format!("{complex_struct:?}");
+}
+
+#[test]
+fn tracked_and_interned() {
+    let mut db = Database::default();
+
+    let input = MyInput::new(&mut db, "tracked value".to_string());
+    let tracked = tracked_value(&db, input);
+    let tracked_debug = format!("{:?}", tracked.debug(&db));
+    let duplicate_input = MyInput::new(&mut db, "tracked value".to_string());
+    let duplicate_tracked = tracked_value(&db, duplicate_input);
+    let duplicate_tracked_debug = format!("{:?}", duplicate_tracked.debug(&db));
+    assert!(tracked_debug.contains("tracked value"));
+    assert!(tracked_debug.chars().any(|c| c.is_ascii_digit()));
+    assert_ne!(tracked_debug, duplicate_tracked_debug);
+    let _ordinary_tracked = format!("{tracked:?}");
+
+    let interned = InternedValue::new(&db, "interned value".to_string());
+    let interned_debug = format!("{:?}", interned.debug(&db));
+    assert!(interned_debug.contains("interned value"));
+    let _ordinary_interned = format!("{interned:?}");
+}
