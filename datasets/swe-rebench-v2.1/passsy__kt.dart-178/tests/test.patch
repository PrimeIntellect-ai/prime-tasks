+  group("flatMapTo", () {
+    test("flatMapTo int to string", () {
+      final result = mutableListOf<int>();
+      final iterable = iterableOf([1, 2, 3]);
+      final returned =
+          iterable.flatMapTo(result, (it) => iterableOf([it, it + 1, it + 2]));
+      expect(result, listOf(1, 2, 3, 2, 3, 4, 3, 4, 5));
+      expect(returned, same(result));
+    });
+
+    test("flatMapTo keeps existing destination elements", () {
+      final result = mutableListOf(42);
+      final iterable = iterableOf([1, 2]);
+      iterable.flatMapTo(result, (it) => iterableOf([it, it + 1]));
+      expect(result, listOf(42, 1, 2, 2, 3));
+    });
+  });
+
+  group("flatMapIndexed", () {
