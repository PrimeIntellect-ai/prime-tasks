+    def assertUnusedImportReported(self, source):
+        """
+        Check that the source reports an unused import. Other diagnostics
+        are permitted, since the invalid declaration itself may or may not
+        be reported separately.
+        """
+        tree = ast.parse(textwrap.dedent(source))
+        w = checker.Checker(tree)
+        self.assertIn(
+            m.UnusedImport, [type(msg) for msg in w.messages],
+            'no UnusedImport reported for:\n%s\ngot: %r' % (
+                source, [str(msg) for msg in w.messages]))
+
+    def test_ignored_when_not_directly_assigned(self):
+        self.assertUnusedImportReported('''
+        import bar
+        (__all__,) = ("foo",)
+        ''')
+
+    def test_complex_list_unpacking_is_not_an_export_declaration(self):
+        self.assertUnusedImportReported('''
+        import bar
+        [__all__] = ["bar"]
+        ''')
+
+    def test_starred_unpacking_is_not_an_export_declaration(self):
+        self.assertUnusedImportReported('''
+        import bar
+        (*__all__,) = ('bar',)
+        ''')
+
