       @test Cartesian(T(1), T(1)) == Cartesian(T(1) * u"m", T(1) * u"m")
       @test Cartesian(T(1), T(1), T(1)) == Cartesian(T(1) * u"m", T(1) * u"m", T(1) * u"m")
       @test Cartesian(T(1) * u"m", 1 * u"m") == Cartesian(T(1) * u"m", T(1) * u"m")
+      @test Cartesian((T(1), T(1))) == Cartesian((T(1) * u"m", T(1) * u"m"))
+      @test Cartesian((T(1), T(1), T(1))) == Cartesian((T(1) * u"m", T(1) * u"m", T(1) * u"m"))
+      @test Cartesian((T(1) * u"m", 1 * u"m")) == Cartesian((T(1) * u"m", T(1) * u"m"))
+
+      # default datum is NoDatum when the type parameter is omitted
+      @test datum(Cartesian((T(1), T(1)))) === NoDatum
+      @test datum(Cartesian((T(1) * u"m", T(1) * u"m"))) === NoDatum
+
+      # explicit datum type parameter is accepted and retained
+      @test Cartesian{WGS84Latest}((T(1), T(1))) == Cartesian{WGS84Latest}(T(1) * u"m", T(1) * u"m")
+      @test Cartesian{WGS84Latest}((T(1) * u"m", T(1) * u"m")) == Cartesian{WGS84Latest}(T(1) * u"m", T(1) * u"m")
+      @test Cartesian{WGS84Latest}((T(1), T(1))) isa Cartesian{WGS84Latest}
+
+      # promoted floating-point numeric type
+      @test Cartesian((1, 2)).x isa typeof(1.0u"m")
+
+      # error: raw-number tuple with a quantity element
+      @test_throws ArgumentError Cartesian((T(1) * u"m", T(1)))
+      # error: length-quantity tuple with a non-length value
+      @test_throws ArgumentError Cartesian((T(1) * u"m", T(1) * u"s"))
 
       c = Cartesian(T(1))
       @test sprint(show, c) == "Cartesian{NoDatum}(x: 1.0 m)"
