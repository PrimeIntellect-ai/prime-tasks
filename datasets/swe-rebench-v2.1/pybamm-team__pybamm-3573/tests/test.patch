+    def test_insert_reference_electrode(self):
+        model = pybamm.lithium_ion.SPM()
+        model.insert_reference_electrode()
+        self.assertIn("Negative electrode 3E potential [V]", model.variables)
+        self.assertIn("Positive electrode 3E potential [V]", model.variables)
+        self.assertIn("Reference electrode potential [V]", model.variables)
+
+        model = pybamm.lithium_ion.SPM({"working electrode": "positive"})
+        model.insert_reference_electrode()
+        self.assertIn("Positive electrode 3E potential [V]", model.variables)
+        self.assertIn("Reference electrode potential [V]", model.variables)
+
+        model = pybamm.lithium_ion.SPM({"dimensionality": 2})
+        with self.assertRaisesRegex(
+            NotImplementedError, "Reference electrode can only be"
+        ):
+            model.insert_reference_electrode()
+
+    def test_insert_reference_electrode_position(self):
+        model = pybamm.lithium_ion.SPM()
+        param = model.default_parameter_values
+        geometry = model.default_geometry
+        param.process_geometry(geometry)
+        mesh = pybamm.Mesh(
+            geometry, model.default_submesh_types, model.default_var_pts
+        )
+
+        domains = ["negative electrode", "separator", "positive electrode"]
+        nodes = np.concatenate([mesh[domain].nodes for domain in domains])
+        y = np.arange(len(nodes))[:, np.newaxis].astype(float)
+
+        def reference_value(position):
+            model = pybamm.lithium_ion.SPM()
+            model.insert_reference_electrode(position)
+            model.default_parameter_values.process_model(model)
+            disc = pybamm.Discretisation(mesh, model.default_spatial_methods)
+            disc.process_model(model)
+            ref = model.variables["Reference electrode potential [V]"]
+            phi = model.variables["Electrolyte potential [V]"]
+            ref_value = ref.evaluate(y=y).flatten()
+
+            positive_cc = model.variables["Positive electrode potential [V]"].evaluate(
+                y=y
+            ).flatten()[-1]
+            positive_3e = model.variables["Positive electrode 3E potential [V]"].evaluate(
+                y=y
+            ).flatten()
+            # the base wording orders this difference either way round
+            np.testing.assert_allclose(
+                np.abs(positive_3e), np.abs(positive_cc - ref_value)
+            )
+
+            if "Negative electrode 3E potential [V]" in model.variables:
+                negative_cc = model.variables["Negative electrode potential [V]"].evaluate(
+                    y=y
+                ).flatten()[0]
+                negative_3e = model.variables["Negative electrode 3E potential [V]"].evaluate(
+                    y=y
+                ).flatten()
+                np.testing.assert_allclose(negative_3e, negative_cc - ref_value)
+
+            return ref_value, phi.evaluate(y=y)
+
+        # a caller-supplied position is honoured
+        position = mesh["separator"].nodes[2]
+        ref_value, phi_value = reference_value(pybamm.Scalar(position))
+        idx = np.argmin(np.abs(nodes - position))
+        np.testing.assert_allclose(ref_value, phi_value[idx])
+
+        # with no position, the separator midpoint is used
+        ref_value, phi_value = reference_value(None)
+        midpoint = (
+            param["Negative electrode thickness [m]"]
+            + param["Separator thickness [m]"] / 2
+        )
+        # the midpoint may fall between two mesh nodes, so accept either
+        nearest = np.argsort(np.abs(nodes - midpoint))[:2]
+        self.assertTrue(
+            any(np.allclose(ref_value, phi_value[i]) for i in nearest)
+        )
+
 
