diff --git a/__tests__/mock/prototype.js b/__tests__/mock/prototype.js
index aa8f0c8..e84034d 100644
--- a/__tests__/mock/prototype.js
+++ b/__tests__/mock/prototype.js
@@ -1,3 +1,37 @@
+import { JSDOM } from 'jsdom';
+import mockWindow from '../../src/window';
+
+
+/**
+ * Replaces the global canvas prototype methods with plain functions, mocks the canvas methods
+ * through a window-like object that has no usable prototype, and checks that the global
+ * canvas prototype still ends up with mocked methods.
+ */
+function expectGlobalFallback(partialWin) {
+  const originalGetContext = HTMLCanvasElement.prototype.getContext;
+  const originalToBlob = HTMLCanvasElement.prototype.toBlob;
+  const originalToDataURL = HTMLCanvasElement.prototype.toDataURL;
+
+  HTMLCanvasElement.prototype.getContext = function getContext() {};
+  HTMLCanvasElement.prototype.toBlob = function toBlob() {};
+  HTMLCanvasElement.prototype.toDataURL = function toDataURL() {};
+
+  try {
+    expect(() => mockWindow(partialWin)).not.toThrow();
+    expect(jest.isMockFunction(HTMLCanvasElement.prototype.getContext)).toBe(
+      true
+    );
+    expect(jest.isMockFunction(HTMLCanvasElement.prototype.toBlob)).toBe(true);
+    expect(jest.isMockFunction(HTMLCanvasElement.prototype.toDataURL)).toBe(
+      true
+    );
+  } finally {
+    HTMLCanvasElement.prototype.getContext = originalGetContext;
+    HTMLCanvasElement.prototype.toBlob = originalToBlob;
+    HTMLCanvasElement.prototype.toDataURL = originalToDataURL;
+  }
+}
+
 let canvas;
 
 beforeEach(() => {
@@ -117,4 +151,28 @@ describe('mock', () => {
     const second = canvas.getContext('2d');
     expect(first).toBe(second);
   });
+
+  it('mocks the canvas methods on the supplied window', () => {
+    const mockWin = new JSDOM().window;
+
+    mockWindow(mockWin);
+
+    expect(
+      jest.isMockFunction(mockWin.HTMLCanvasElement.prototype.getContext)
+    ).toBe(true);
+    expect(jest.isMockFunction(mockWin.HTMLCanvasElement.prototype.toBlob)).toBe(
+      true
+    );
+    expect(
+      jest.isMockFunction(mockWin.HTMLCanvasElement.prototype.toDataURL)
+    ).toBe(true);
+  });
+
+  it('falls back to the global prototype when the passed window lacks HTMLCanvasElement.prototype', () => {
+    expectGlobalFallback({ document: {} });
+  });
+
+  it('falls back to the global prototype when the passed window HTMLCanvasElement has no prototype', () => {
+    expectGlobalFallback({ document: {}, HTMLCanvasElement: {} });
+  });
 });
