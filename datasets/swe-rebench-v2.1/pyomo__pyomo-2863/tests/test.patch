+
+    def test_pow(self):
+        m = ConcreteModel()
+        m.x = Var()
+        m.y = Var()
+
+        cfg = VisitorConfig()
+        repn = QuadraticRepnVisitor(*cfg).walk_expression(
+            (1 + 3 * m.x + 4 * m.y) ** 2.0
+        )
+        self.assertEqual(repn.multiplier * repn.constant, 1)
+        self.assertEqual(
+            {var: repn.multiplier * coef for var, coef in repn.linear.items()},
+            {id(m.x): 6, id(m.y): 8},
+        )
+        self.assertEqual(
+            {
+                pair: repn.multiplier * coef
+                for pair, coef in repn.quadratic.items()
+            },
+            {(id(m.x), id(m.x)): 9, (id(m.y), id(m.y)): 16, (id(m.x), id(m.y)): 24},
+        )
+
+    def test_float_power_lp_export(self):
+        m = ConcreteModel()
+        m.x = Var()
+        m.obj = Objective(expr=m.x**2.0 + m.x - 2)
+
+        with tempfile.TemporaryDirectory() as tmpdir:
+            filename = os.path.join(tmpdir, "model.lp")
+            m.write(
+                filename,
+                io_options={"allow_quadratic_objective": True},
+            )
+
+            with open(filename) as output:
+                self.assertTrue(output.read())
