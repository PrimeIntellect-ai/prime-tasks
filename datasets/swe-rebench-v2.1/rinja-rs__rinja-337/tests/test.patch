+use std::fmt::Display;
+
+use rinja::Template;
+
+#[test]
+fn test_blocks() {
+    #[derive(Template)]
+    #[template(
+        ext = "txt",
+        source = "
+            {%- block first -%} first=<{{first}}> {%- endblock -%}
+            {%- block second -%} second=<{{second}}> {%- endblock -%}
+            {%- block third -%} third=<{{third}}> {%- endblock -%}
+        ",
+        blocks = ["first", "second", "third"]
+    )]
+    struct WithBlocks<'a, S: Display, T>
+    where
+        T: Display,
+    {
+        first: &'a str,
+        second: S,
+        third: &'a T,
+    }
+
+    let tmpl = WithBlocks {
+        first: "number one",
+        second: 2,
+        third: &"bronze",
+    };
+
+    assert_eq!(tmpl.as_first().render().unwrap(), "first=<number one>");
+    assert_eq!(tmpl.as_second().render().unwrap(), "second=<2>");
+    assert_eq!(tmpl.as_third().render().unwrap(), "third=<bronze>");
+    assert_eq!(tmpl.render().unwrap(), "first=<number one>second=<2>third=<bronze>");
+}
+
+#[test]
+fn test_inherited_block() {
+    #[derive(Template)]
+    #[template(path = "child.html", blocks = ["foo"])]
+    struct ChildTemplate<'a> {
+        title: &'a str,
+    }
+
+    let tmpl = ChildTemplate { title: "Greeting" };
+    assert_eq!(tmpl.as_foo().render().unwrap(), "Foo");
+    assert!(tmpl.render().unwrap().contains("Greeting"));
+}
