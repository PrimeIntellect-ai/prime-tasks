+func TestJobMutationWebhookHandlesJobWithoutTemplate(t *testing.T) {
+	ctrlContext := setupContext(t, nil, nil)
+	hook, err := jobmutatingwebhook.NewWebhook(ctrlContext)
+	if err != nil {
+		t.Fatalf("cannot construct Job webhook: %v", err)
+	}
+
+	job := &v1alpha1.Job{
+		ObjectMeta: metav1.ObjectMeta{
+			Namespace: metav1.NamespaceDefault,
+			Name:      "job-without-template",
+		},
+	}
+	rawJob, err := json.Marshal(job)
+	if err != nil {
+		t.Fatalf("cannot encode Job admission object: %v", err)
+	}
+
+	_, _ = hook.Handle(context.Background(), &admissionv1.AdmissionRequest{
+		Operation: admissionv1.Create,
+		Kind:      metav1.GroupVersionKind(v1alpha1.GVKJob),
+		Object:    runtime.RawExtension{Raw: rawJob},
+	})
+}
