 @testset "Flux issue 1826" begin
diff --git a/test/interface.jl b/test/interface.jl
new file mode 100644
index 0000000..33eacd4
--- /dev/null
+++ b/test/interface.jl
@@ -0,0 +1,47 @@
+@testset "@def" begin 
+    Optimisers.@def struct DummyRule
+        eta = 1.0
+        b1 = 1
+        b2 = 2.5f0
+        c = (1.0, 2.0)
+    end
+
+    # no args
+    r = DummyRule()
+    @test r.eta === 1.0
+    @test r.b1 === 1
+    @test r.b2 === 2.5f0
+    @test r.c === (1.0, 2.0)
+
+    # some positional args
+    r = DummyRule(2, 2, 4.5)
+    @test r.eta == 2  # the value is kept, whether or not it is promoted to float
+    @test r.b1 == 2
+    @test r.b2 == 4.5  # value kept, not truncated
+    @test r.c === (1.0, 2.0)
+
+    # supplied types which are compatible are representable, not forced to Float64
+    @test DummyRule(0.5f0).eta isa Float32
+    @test DummyRule(eta=0.5f0).eta === 0.5f0
+    @test Optimisers.Adam(0.1f0).eta isa Float32
+end
+
+@testset "adjusted learning rate is used by later updates" begin
+    m = (x = [1.0, 2.0, 3.0], y = [4.0, 5.0])
+    g = (x = [1.0, -2.0, 0.5], y = [0.3, 0.1])
+
+    st = Optimisers.setup(Optimisers.Nesterov(0.1, 0.9), m)
+    st2 = Optimisers.adjust(st, 0.2)
+    _, m2 = Optimisers.update(st2, m, g)
+    _, m_new = Optimisers.update(Optimisers.setup(Optimisers.Nesterov(0.2, 0.9), m), m, g)
+    _, m_old = Optimisers.update(st, m, g)
+    @test m2.x ≈ m_new.x
+    @test m2.y ≈ m_new.y
+    @test !(m_old.x ≈ m_new.x)  # the old learning rate gives a different step
+
+    st3 = Optimisers.setup(Optimisers.Nesterov(0.1, 0.9), m)
+    Optimisers.adjust!(st3, 0.2)
+    _, m3 = Optimisers.update(st3, m, g)
+    @test m3.x ≈ m_new.x
+    @test m3.y ≈ m_new.y
+end
