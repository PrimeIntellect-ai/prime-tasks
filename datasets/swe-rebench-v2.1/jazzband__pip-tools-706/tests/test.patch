+def _pip_install_input(args):
+    """Collect package arguments and any requirements files passed to pip."""
+    values = [str(arg) for arg in args]
+    for index, arg in enumerate(args):
+        path = None
+        if arg in ('-r', '--requirement') and index + 1 < len(args):
+            path = args[index + 1]
+        elif arg.startswith('--requirement='):
+            path = arg.split('=', 1)[1]
+        if path is not None:
+            with open(path) as req_file:
+                values.append(req_file.read())
+    return '\n'.join(values)
+
