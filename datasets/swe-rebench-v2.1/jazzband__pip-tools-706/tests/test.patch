+def test_sync_accepts_any_matching_hash_and_rejects_nonmatching_artifacts(from_line, tmp_path):
+    wheel_path = tmp_path / 'hash_check_fixture-1.0-py3-none-any.whl'
+    files = {
+        'hash_check_fixture/__init__.py': b'VALUE = 1\n',
+        'hash_check_fixture-1.0.dist-info/METADATA': (
+            b'Metadata-Version: 2.1\nName: hash-check-fixture\nVersion: 1.0\n'
+        ),
+        'hash_check_fixture-1.0.dist-info/WHEEL': (
+            b'Wheel-Version: 1.0\nGenerator: test\nRoot-Is-Purelib: true\n'
+            b'Tag: py3-none-any\n'
+        ),
+    }
+    record = io.StringIO()
+    writer = csv.writer(record, lineterminator='\n')
+    for name, contents in files.items():
+        digest = base64.urlsafe_b64encode(hashlib.sha256(contents).digest()).rstrip(b'=')
+        writer.writerow((name, 'sha256=' + digest.decode('ascii'), len(contents)))
+    writer.writerow(('hash_check_fixture-1.0.dist-info/RECORD', '', ''))
+    files['hash_check_fixture-1.0.dist-info/RECORD'] = record.getvalue().encode('utf-8')
+
+    with zipfile.ZipFile(str(wheel_path), 'w') as wheel:
+        for name, contents in files.items():
+            wheel.writestr(name, contents)
+
+    actual_hash = hashlib.sha256(wheel_path.read_bytes()).hexdigest()
+    target = tmp_path / 'installed-matching'
+
+    def install_with_pip(args, *extra, **kwargs):
+        # Run the real pip from the same interpreter, whatever launcher form was used
+        # to invoke it; only the subcommand and its arguments are forwarded.
+        subprocess.check_call([sys.executable, '-m', 'pip'] + args[args.index('install'):])
+
+    with mock.patch('piptools.sync.check_call', side_effect=install_with_pip):
+        sync(
+            {from_line('hash-check-fixture==1.0', options={
+                'hashes': {'sha256': ['0' * 64, actual_hash]},
+            })},
+            set(),
+            install_flags=[
+                '--no-index', '--find-links', str(tmp_path), '--target', str(target),
+            ],
+        )
+
+        assert (target / 'hash_check_fixture' / '__init__.py').is_file()
+
+        try:
+            result = sync(
+                {from_line('hash-check-fixture==1.0', options={
+                    'hashes': {'sha256': ['0' * 64]},
+                })},
+                set(),
+                install_flags=[
+                    '--no-index', '--find-links', str(tmp_path),
+                    '--target', str(tmp_path / 'installed-nonmatching'),
+                ],
+            )
+        except (Exception, SystemExit):
+            pass
+        else:
+            assert isinstance(result, int) and result != 0
