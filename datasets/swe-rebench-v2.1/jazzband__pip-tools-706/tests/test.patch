+def test_sync_install_raises_when_pip_fails(from_line):
+    with mock.patch('piptools.sync.check_call') as check_call:
+        check_call.side_effect = CalledProcessError(1, 'pip')
+        to_install = {
+            from_line('django==1.8', options={
+                'hashes': {
+                    'sha256': [
+                        '6a03ce2feafdd193a0ba8a26dbd9773e757d2e5d5e7933a62eac129813bd381a',
+                    ]
+                }
+            }),
+        }
+
+        try:
+            result = sync(to_install, set())
+        except (Exception, SystemExit):
+            pass
+        else:
+            assert isinstance(result, int) and result != 0
+
