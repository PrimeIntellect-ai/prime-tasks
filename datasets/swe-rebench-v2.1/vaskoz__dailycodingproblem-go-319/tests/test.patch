+package day153
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+var testcases = []struct {
+	text, one, two string
+	expected       int
+}{
+	{"dog cat hello cat dog dog hello cat world", "hello", "world", 1},
+	{"dog cat hello cat dog dog hello cat world", "hello", "cat", 0},
+}
+
+func TestSmallestDistanceBetweenWords(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		if result := SmallestDistanceBetweenWords(tc.text, tc.one, tc.two); result != tc.expected {
+			t.Errorf("Expected %v got %v", tc.expected, result)
+		}
+	}
+}
+
+func BenchmarkSmallestDistanceBetweenWords(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			SmallestDistanceBetweenWords(tc.text, tc.one, tc.two)
+		}
+	}
+}
+
+func TestSmallestDistanceBetweenWordsManyOccurrences(t *testing.T) {
+	const occurrences = 80000
+	text := strings.TrimSpace(strings.Repeat("one ", occurrences) + strings.Repeat("two ", occurrences))
+
+	started := time.Now()
+	got := SmallestDistanceBetweenWords(text, "one", "two")
+	elapsed := time.Since(started)
+	if got != 0 {
+		t.Fatalf("expected adjacent target words to have distance 0, got %d", got)
+	}
+	if elapsed > 2*time.Second {
+		t.Fatalf("expected efficient handling of many occurrences, took %v", elapsed)
+	}
+}
