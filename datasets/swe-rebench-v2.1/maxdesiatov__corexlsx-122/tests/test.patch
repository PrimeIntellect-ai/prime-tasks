+  bytes += le32(0x0403_4B50)
+  bytes += le16(20)
+  bytes += le16(0)
+  bytes += le16(0)
+  bytes += le16(0)
+  bytes += le16(0)
+  bytes += le32(crc)
+  bytes += le32(size)
