+  central += le32(0x0201_4B50)
+  central += le16(20)
+  central += le16(20)
+  central += le16(0)
+  central += le16(0)
+  central += le16(0)
+  central += le16(0)
+  central += le32(crc)
+  central += le32(size)
+  central += le32(size)
+  central += le16(UInt16(nameBytes.count))
+  central += le16(0)
+  central += le16(0)
