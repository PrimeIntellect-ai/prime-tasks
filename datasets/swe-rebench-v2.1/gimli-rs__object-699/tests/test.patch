+#[test]
+fn sparc32_address_size() {
+    let mut elf = [0u8; 52];
+    elf[..4].copy_from_slice(b"\x7fELF");
+    elf[4] = 1; // ELFCLASS32
+    elf[5] = 2; // Big endian
+    elf[6] = 1; // Current ELF version
+    elf[16..18].copy_from_slice(&1u16.to_be_bytes()); // ET_REL
+    elf[18..20].copy_from_slice(&2u16.to_be_bytes()); // EM_SPARC
+    elf[20..24].copy_from_slice(&1u32.to_be_bytes());
+    elf[40..42].copy_from_slice(&52u16.to_be_bytes());
+
+    let file = read::File::parse(&elf[..]).unwrap();
+    assert_eq!(file.architecture().address_size().unwrap().bytes(), 4);
+}
