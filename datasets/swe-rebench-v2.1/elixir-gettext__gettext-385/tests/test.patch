diff --git a/test/gettext/extractor_test.exs b/test/gettext/extractor_test.exs
index b12d859..0fea48c 100644
--- a/test/gettext/extractor_test.exs
+++ b/test/gettext/extractor_test.exs
@@ -32,10 +32,10 @@ defmodule Gettext.ExtractorTest do
       structs =
         Extractor.merge_pot_files(extracted_po_structs, [paths.tomerge, paths.ignored], [])
 
-      # Unchanged files are not returned
-      assert List.keyfind(structs, paths.ignored, 0) == nil
+      # Unchanged files are not reported as changed
+      refute changed_contents(structs, paths.ignored)
 
-      {_, contents} = List.keyfind(structs, paths.tomerge, 0)
+      contents = changed_contents(structs, paths.tomerge)
 
       assert IO.iodata_to_binary(contents) == """
              msgid "foo"
@@ -45,7 +45,7 @@ defmodule Gettext.ExtractorTest do
              msgstr ""
              """
 
-      {_, contents} = List.keyfind(structs, paths.new, 0)
+      contents = changed_contents(structs, paths.new)
       contents = IO.iodata_to_binary(contents)
 
       assert contents =~ """
@@ -385,7 +385,15 @@ defmodule Gettext.ExtractorTest do
     assert [] = Extractor.pot_files(:unknown, [])
 
     pot_files = Extractor.pot_files(:test_application, [])
-    dumped = Enum.map(pot_files, fn {k, v} -> {k, IO.iodata_to_binary(v)} end)
+
+    dumped =
+      pot_files
+      |> Enum.flat_map(fn {k, _} = entry ->
+        case changed_contents([entry], k) do
+          nil -> []
+          v -> [{k, IO.iodata_to_binary(v)}]
+        end
+      end)
 
     # We check that dumped strings end with the `expected` string because
     # there's the informative comment at the start of each dumped string.
@@ -437,4 +445,15 @@ defmodule Gettext.ExtractorTest do
     path |> Path.dirname() |> File.mkdir_p!()
     File.write!(path, contents)
   end
+
+  # Returns the serialized contents for `path` if it was reported as changed,
+  # or nil if it was not reported or is unchanged.
+  defp changed_contents(structs, path) do
+    case List.keyfind(structs, path, 0) do
+      {_, :unchanged} -> nil
+      {_, {:changed, contents}} -> contents
+      {_, contents} when is_list(contents) or is_binary(contents) -> contents
+      nil -> nil
+    end
+  end
 end
