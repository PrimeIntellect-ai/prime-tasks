+@pytest.mark.end_to_end
+def test_show_errors_immediately(tmp_path):
+    finished = tmp_path.joinpath("slow-task-finished")
+    source = f"""
+    import time
+    from pathlib import Path
+    import pytask
+
+    @pytask.mark.try_first
+    def task_a_error(): raise ValueError("first task failed")
+
+    @pytask.mark.try_last
+    def task_b_slow():
+        time.sleep(3)
+        Path({str(finished)!r}).touch()
+    """
+    tmp_path.joinpath("task_error.py").write_text(textwrap.dedent(source))
+
+    process = subprocess.Popen(
+        [
+            "python",
+            "-m",
+            "pytask",
+            tmp_path.as_posix(),
+            "--show-errors-immediately",
+        ],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+    )
+    output = b""
+    saw_traceback = False
+    while process.poll() is None:
+        readable, _, _ = select.select([process.stdout], [], [], 0.1)
+        if readable:
+            chunk = os.read(process.stdout.fileno(), 4096)
+            output += chunk
+            if b"Traceback" in output:
+                saw_traceback = True
+                break
+
+    if saw_traceback:
+        assert not finished.exists()
+
+    remaining, _ = process.communicate(timeout=10)
+    output += remaining
+    assert process.returncode != 0
+    assert saw_traceback, output.decode(errors="replace")
+
+
+@pytest.mark.end_to_end
+def test_errors_are_reported_without_switch(runner, tmp_path):
+    tmp_path.joinpath("task_error.py").write_text(
+        "def task_error(): raise ValueError('task failed')"
+    )
+    result = runner.invoke(cli, [tmp_path.as_posix()])
+
+    assert result.exit_code != 0
+    assert "Traceback" in result.output
