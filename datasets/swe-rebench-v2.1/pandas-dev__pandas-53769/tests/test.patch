+    def test_iloc_callable_tuple_return_value(self):
+        # GH53769
+        df = DataFrame(np.arange(40).reshape(10, 4), index=range(0, 20, 2))
+        msg = "callable with iloc"
+        with tm.assert_produces_warning(FutureWarning, match=msg):
+            try:
+                result = df.iloc[lambda _: (0,)]
+            except Exception:
+                # Rejecting tuple returns is also supported.
+                pass
+            else:
+                expected = df.iloc[[0]]
+                tm.assert_numpy_array_equal(
+                    result.to_numpy().reshape(1, -1), expected.to_numpy()
+                )
+
+        result = df.copy()
+        with tm.assert_produces_warning(FutureWarning, match=msg):
+            try:
+                result.iloc[lambda _: (0,)] = 1
+            except Exception:
+                # Rejecting tuple returns is also supported.
+                pass
+            else:
+                expected = df.copy()
+                expected.iloc[0] = 1
+                tm.assert_frame_equal(result, expected)
+
