diff --git a/tests/test_firehose/test_firehose_destination_types.py b/tests/test_firehose/test_firehose_destination_types.py
index 8390db19..87a22209 100644
--- a/tests/test_firehose/test_firehose_destination_types.py
+++ b/tests/test_firehose/test_firehose_destination_types.py
@@ -366,3 +366,55 @@ def test_create_http_stream():
             "HasMoreDestinations": False,
         }
     )
+
+
+@mock_firehose
+def test_create_redshift_delivery_stream_with_s3_backup():
+    """S3 backup configuration is exposed separately from the primary S3 destination."""
+    client = boto3.client("firehose", region_name=TEST_REGION)
+
+    stream_name = f"stream_{mock_random.get_random_hex(6)}"
+    client.create_delivery_stream(
+        DeliveryStreamName=stream_name,
+        RedshiftDestinationConfiguration={
+            "RoleARN": f"arn:aws:iam::{ACCOUNT_ID}:role/firehose_delivery_role",
+            "ClusterJDBCURL": "jdbc:redshift://host.amazonaws.com:5439/database",
+            "CopyCommand": {
+                "DataTableName": "outputTable",
+                "CopyOptions": "CSV DELIMITER ',' NULL '\\0'",
+            },
+            "Username": "username",
+            "Password": "password",
+            "S3Configuration": {
+                "RoleARN": f"arn:aws:iam::{ACCOUNT_ID}:role/firehose_delivery_role",
+                "BucketARN": "arn:aws:s3:::firehose-primary",
+                "Prefix": "primary/",
+                "CompressionFormat": "UNCOMPRESSED",
+            },
+            "S3BackupMode": "Enabled",
+            "S3BackupConfiguration": {
+                "RoleARN": f"arn:aws:iam::{ACCOUNT_ID}:role/firehose_delivery_role",
+                "BucketARN": "arn:aws:s3:::firehose-backup",
+                "Prefix": "backup/",
+                "CompressionFormat": "UNCOMPRESSED",
+            },
+        },
+    )
+
+    desc = client.describe_delivery_stream(DeliveryStreamName=stream_name)[
+        "DeliveryStreamDescription"
+    ]
+    dest = desc["Destinations"][0]["RedshiftDestinationDescription"]
+
+    dest.should.have.key("S3BackupDescription")
+    dest["S3BackupDescription"]["BucketARN"].should.equal(
+        "arn:aws:s3:::firehose-backup"
+    )
+    dest["S3BackupDescription"]["Prefix"].should.equal("backup/")
+    dest.shouldnt.have.key("S3BackupConfiguration")
+
+    dest.should.have.key("S3DestinationDescription")
+    dest["S3DestinationDescription"]["BucketARN"].should.equal(
+        "arn:aws:s3:::firehose-primary"
+    )
+    dest["S3DestinationDescription"]["Prefix"].should.equal("primary/")
