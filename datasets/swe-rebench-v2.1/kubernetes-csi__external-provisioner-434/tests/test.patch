+// TestNewCloningProtectionController verifies that the cloning-protection controller is only
+// created when the driver advertises the CLONE_VOLUME controller capability.
+func TestNewCloningProtectionController(t *testing.T) {
+	testcases := map[string]struct {
+		capabilities rpc.ControllerCapabilitySet
+		expectNil    bool
+	}{
+		"clone volume capability enabled": {
+			capabilities: rpc.ControllerCapabilitySet{
+				csi.ControllerServiceCapability_RPC_CLONE_VOLUME: true,
+			},
+			expectNil: false,
+		},
+		"clone volume capability disabled": {
+			capabilities: rpc.ControllerCapabilitySet{},
+			expectNil:    true,
+		},
+		"only other capabilities enabled": {
+			capabilities: rpc.ControllerCapabilitySet{
+				csi.ControllerServiceCapability_RPC_CREATE_DELETE_VOLUME: true,
+			},
+			expectNil: true,
+		},
+	}
+
+	for k, tc := range testcases {
+		tc := tc
+		t.Run(k, func(t *testing.T) {
+			t.Parallel()
+
+			clientSet := fakeclientset.NewSimpleClientset()
+			informerFactory := informers.NewSharedInformerFactory(clientSet, 1*time.Second)
+			claimInformer := informerFactory.Core().V1().PersistentVolumeClaims().Informer()
+			claimLister := informerFactory.Core().V1().PersistentVolumeClaims().Lister()
+			rateLimiter := workqueue.NewItemExponentialFailureRateLimiter(time.Second, 2*time.Second)
+			claimQueue := workqueue.NewNamedRateLimitingQueue(rateLimiter, "claims")
+
+			cloningProtector := NewCloningProtectionController(
+				clientSet,
+				claimLister,
+				claimInformer,
+				claimQueue,
+				tc.capabilities,
+			)
+
+			if tc.expectNil && cloningProtector != nil {
+				t.Errorf("expected a nil controller when CLONE_VOLUME capability is absent, got: %v", cloningProtector)
+			}
+			if !tc.expectNil && cloningProtector == nil {
+				t.Errorf("expected a non-nil controller when CLONE_VOLUME capability is present, got nil")
+			}
+		})
+	}
+}
