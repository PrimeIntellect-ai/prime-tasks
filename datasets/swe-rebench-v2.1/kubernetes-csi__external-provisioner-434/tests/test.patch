+// TestCloningProtectionControllerNotRunWhenDisabled starts the provisioner
+// against a CSI driver that does not advertise the CLONE_VOLUME controller
+// capability and verifies that startup does not attempt to run the
+// cloning-protection controller.
+func TestCloningProtectionControllerNotRunWhenDisabled(t *testing.T) {
+	tmpdir, err := ioutil.TempDir("", "cloning-protection-disabled-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(tmpdir)
+
+	// Build the provisioner binary.
+	binPath := filepath.Join(tmpdir, "csi-provisioner")
+	build := exec.Command("go", "build", "-o", binPath, "github.com/kubernetes-csi/external-provisioner/cmd/csi-provisioner")
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("failed to build csi-provisioner: %v\n%s", err, out)
+	}
+
+	// Fake Kubernetes API server that serves an empty cluster.
+	apiServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch {
+		case r.URL.Path == "/version":
+			fmt.Fprint(w, `{"major":"1","minor":"20","gitVersion":"v1.20.0","gitCommit":"x","gitTreeState":"clean","buildDate":"2020-01-01T00:00:00Z","goVersion":"go1.15","compiler":"gc","platform":"linux/amd64"}`)
+		case r.URL.Query().Get("watch") == "true":
+			w.WriteHeader(http.StatusOK)
+		default:
+			fmt.Fprint(w, `{"kind":"List","apiVersion":"v1","metadata":{"resourceVersion":"1"},"items":[]}`)
+		}
+	}))
+	defer apiServer.Close()
+
+	kubeconfig := fmt.Sprintf(`apiVersion: v1
+kind: Config
+clusters:
+- cluster:
+    server: %s
+  name: fake
+contexts:
+- context:
+    cluster: fake
+    user: fake
+  name: fake
+current-context: fake
+users:
+- name: fake
+  user: {}
+`, apiServer.URL)
+	kubeconfigPath := filepath.Join(tmpdir, "kubeconfig")
+	if err := ioutil.WriteFile(kubeconfigPath, []byte(kubeconfig), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	// Fake CSI driver that does not advertise CLONE_VOLUME.
+	mockController := gomock.NewController(t)
+	defer mockController.Finish()
+	controllerServer := driver.NewMockControllerServer(mockController)
+	controllerServer.EXPECT().ControllerGetCapabilities(gomock.Any(), gomock.Any()).Return(&csi.ControllerGetCapabilitiesResponse{}, nil).AnyTimes()
+
+	drv := driver.NewCSIDriver(&driver.CSIDriverServers{
+		Identity:   &fakeIdentityServer{},
+		Controller: controllerServer,
+	})
+	sock := filepath.Join(tmpdir, "csi.sock")
+	listener, err := net.Listen("unix", sock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := drv.Start(listener); err != nil {
+		t.Fatal(err)
+	}
+	defer drv.Stop()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, binPath, "--csi-address", sock, "--kubeconfig", kubeconfigPath)
+	out, err := cmd.CombinedOutput()
+	if strings.Contains(string(out), "panic:") {
+		t.Fatalf("starting the provisioner with a driver lacking CLONE_VOLUME panicked:\n%s", out)
+	}
+	if ctx.Err() == nil {
+		t.Fatalf("provisioner exited unexpectedly (err=%v):\n%s", err, out)
+	}
+}
