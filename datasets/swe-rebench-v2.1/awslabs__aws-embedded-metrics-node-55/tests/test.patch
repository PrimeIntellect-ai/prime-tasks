diff --git a/src/config/__tests__/EnvironmentConfigurationProvider.test.ts b/src/config/__tests__/EnvironmentConfigurationProvider.test.ts
index 6c29648..04d95dd 100644
--- a/src/config/__tests__/EnvironmentConfigurationProvider.test.ts
+++ b/src/config/__tests__/EnvironmentConfigurationProvider.test.ts
@@ -207,3 +207,45 @@ test('if environment override cannot be parsed, default to unknown', () => {
   const result = config.environmentOverride;
   expect(result).toBe(Environments.Unknown);
 });
+
+const emittedNamespaces = async (): Promise<string[]> => {
+  const { MetricsLogger } = require('../../logger/MetricsLogger');
+  const { ConsoleSink } = require('../../sinks/ConsoleSink');
+  const environment = {
+    probe: async () => true,
+    getName: () => 'test-service',
+    getType: () => 'test-type',
+    getLogGroupName: () => 'test-log-group',
+    configureContext: () => undefined,
+    getSink: () => new ConsoleSink(),
+  };
+  const logger = new MetricsLogger(async () => environment);
+  const output = jest.spyOn(console, 'log').mockImplementation(() => undefined);
+
+  try {
+    logger.putMetric('sample', 1);
+    await logger.flush();
+    const eventLine = output.mock.calls.map(call => call[0]).find((line: string) => line.startsWith('{'));
+    const event = JSON.parse(eventLine);
+    return event._aws.CloudWatchMetrics.map((entry: { Namespace: string }) => entry.Namespace);
+  } finally {
+    output.mockRestore();
+  }
+};
+
+test('emitted metrics use the namespace set in the environment', async () => {
+  const expectedValue = faker.random.word();
+  process.env.AWS_EMF_NAMESPACE = expectedValue;
+
+  const namespaces = await emittedNamespaces();
+
+  expect(namespaces).toContain(expectedValue);
+});
+
+test('emitted metrics use the existing namespace default when no override is set', async () => {
+  delete process.env.AWS_EMF_NAMESPACE;
+
+  const namespaces = await emittedNamespaces();
+
+  expect(namespaces).toContain('aws-embedded-metrics');
+});
