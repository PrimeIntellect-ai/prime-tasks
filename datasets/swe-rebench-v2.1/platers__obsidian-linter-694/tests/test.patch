+import {spawnSync} from 'child_process';
+import '../src/rules-registry';
+import {createRunLinterRulesOptions, RulesRunner} from '../src/rules-runner';
+import {rules} from '../src/rules';
+import type {LinterSettings} from '../src/rules';
+import {NormalArrayFormats} from '../src/utils/yaml';
+import EmptyLineAroundTables from '../src/rules/empty-line-around-tables';
+
+const malformedTables = [
+  'Before\n| Header 1 | Header 2 |\n| --- | --- | --- |\n| value | value |\nAfter',
+  'Before\n| Header 1 | Header 2 |\n| --- || --- |\n| value | value |\nAfter',
+  'Before\n| Header 1 | Header 2 |\n| --- |  | --- |\n| value | value |\nAfter',
+  'Before\n> | Header 1 | Header 2 |\n> | value | value |\nAfter',
+  `h|h\n|${'-'.repeat(3000)}\n${'x|'.repeat(3000)}\nAfter`,
+];
+
+const rule = EmptyLineAroundTables.getRule();
+
+function runMalformedLintInChild(testName: string) {
+  const result = spawnSync(process.execPath, [
+    require.resolve('jest/bin/jest'),
+    '--runInBand',
+    '--runTestsByPath',
+    __filename,
+    '--testNamePattern',
+    testName,
+  ], {
+    encoding: 'utf8',
+    env: {...process.env, MALFORMED_TABLE_CHILD: '1'},
+    timeout: 10000,
+  });
+
+  expect(result.error).toBeUndefined();
+  expect(result.status).toBe(0);
+}
+
+describe('Table linting in callouts', () => {
+  it('keeps the table quoted and does not add more blank lines on repeated linting', () => {
+    const text = [
+      '> [!warning]- Test',
+      '>',
+      '> | column1 | column2 |',
+      '> | ------ | ------- |',
+      '> |   test1     |   test2      |',
+      '>',
+    ].join('\n');
+    const ruleConfigs = Object.fromEntries(rules.map((registeredRule) => [registeredRule.alias, registeredRule.getDefaultOptions()]));
+    ruleConfigs['empty-line-around-tables'].enabled = true;
+    ruleConfigs['paragraph-blank-lines'].enabled = true;
+    const settings = {
+      ruleConfigs,
+      lintOnSave: false,
+      displayChanged: false,
+      settingsConvertedToConfigKeyValues: false,
+      recordLintOnSaveLogs: false,
+      foldersToIgnore: [],
+      linterLocale: 'en',
+      logLevel: 0,
+      lintCommands: [],
+      customRegexes: [],
+      commonStyles: {
+        aliasArrayStyle: NormalArrayFormats.SingleLine,
+        tagArrayStyle: NormalArrayFormats.SingleLine,
+        minimumNumberOfDollarSignsToBeAMathBlock: 2,
+        escapeCharacter: '"',
+        removeUnnecessaryEscapeCharsForMultiLineArrays: false,
+      },
+    } as LinterSettings;
+    const runner = new RulesRunner();
+    const lint = (markdown: string) => runner.lintText(createRunLinterRulesOptions(markdown, null, 'en', settings));
+    const linted = lint(text);
+    const tableLines = linted.split('\n').filter((line) => line.includes('|'));
+
+    expect(tableLines.length).toBe(3);
+    expect(linted.split('\n').every((line) => line.startsWith('>'))).toBe(true);
+    expect(lint(linted)).toBe(linted);
+  });
+});
+
+describe('Malformed tables during linting', () => {
+  it('leaves malformed table-like text unchanged', () => {
+    if (process.env.MALFORMED_TABLE_CHILD === '1') {
+      for (const text of malformedTables) {
+        expect(rule.apply(text)).toBe(text);
+      }
+      return;
+    }
+
+    runMalformedLintInChild('leaves malformed table-like text unchanged');
+  });
+
+  it('terminates when linting malformed table input', () => {
+    if (process.env.MALFORMED_TABLE_CHILD === '1') {
+      for (const text of malformedTables) {
+        rule.apply(text);
+      }
+      return;
+    }
+
+    runMalformedLintInChild('terminates when linting malformed table input');
+  });
+});
