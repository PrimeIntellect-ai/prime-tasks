+def test_filter_subsets_max_subset_rank_tie():
+    data = generate_samples(seed=0, n_samples=5, n_categories=3)
+    tested_non_tie = False
+    tested_tie = False
+    full = UpSet(data, subset_size="count").intersections
+    prev = None
+    for max_rank in range(1, 5):
+        cur = UpSet(data, subset_size="count", max_subset_rank=max_rank).intersections
+        if prev is not None:
+            if cur.shape[0] > prev.shape[0]:
+                # check we add rows only when they are new
+                assert cur.min() < prev.min()
+                tested_non_tie = True
+            elif cur.shape[0] != full.shape[0]:
+                assert (cur == cur.min()).sum() > 1
+                tested_tie = True
+
+        prev = cur
+    assert tested_non_tie
+    assert tested_tie
+    assert cur.shape[0] == full.shape[0]
+
+
+def test_max_subset_rank_uses_aggregated_sizes_and_keeps_cutoff_ties():
+    memberships = [
+        (True, False),
+        (False, True),
+        (True, True),
+        (False, False),
+    ]
+    values = [1] * 4 + [10] * 3 + [15] * 2 + [1]
+    index = pd.MultiIndex.from_tuples(
+        [membership for membership, count in zip(memberships, [4, 3, 2, 1])
+         for _ in range(count)],
+        names=["left", "right"],
+    )
+    data = pd.Series(values, index=index)
+
+    intersections = UpSet(
+        data, subset_size="sum", max_subset_rank=1, sort_categories_by="input"
+    ).intersections
+
+    assert intersections.to_dict() == {
+        (False, True): 30,
+        (True, True): 30,
+    }
+
+
+def test_max_subset_rank_limits_plot():
+    data = generate_samples(seed=0, n_samples=5000, n_categories=3)
+    full = UpSet(data, subset_size="auto")
+    limited = UpSet(data, subset_size="auto", max_subset_rank=3)
+    n_full = len(full.intersections)
+    n_limited = len(limited.intersections)
+    assert n_limited < n_full
+
+    # The plot must display only the limited intersections.
+    fig = matplotlib.figure.Figure()
+    axes = limited.plot(fig)
+    assert len(axes["intersections"].patches) == n_limited
+    # The module-level plot entry point accepts the option too.
+    fig = matplotlib.figure.Figure()
+    axes = plot(data, fig, subset_size="auto", max_subset_rank=3)
+    assert len(axes["intersections"].patches) == n_limited
+
