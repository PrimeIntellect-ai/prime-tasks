@@ -0,0 +1,91 @@
+import { createElement, useState } from "react";
+import * as Ariakit from "@ariakit/react";
+import { click, render } from "@ariakit/test";
+
+function CollectionExample() {
+  const [items, setItems] = useState<Ariakit.CollectionStoreState["items"]>([]);
+  const collection = Ariakit.useCollectionStore({ items, setItems });
+  return createElement(
+    Ariakit.Collection,
+    { store: collection },
+    createElement("div", null, `Collection count: ${items.length}`),
+    createElement(Ariakit.CollectionItem, null, "Apple"),
+    createElement(Ariakit.CollectionItem, null, "Grape"),
+    createElement(Ariakit.CollectionItem, null, "Orange"),
+  );
+}
+
+function SelectExample({ portal }: { portal?: boolean }) {
+  const [items, setItems] = useState<Ariakit.CollectionStoreState["items"]>([]);
+  const select = Ariakit.useSelectStore({ items, setItems });
+  return createElement(
+    "div",
+    null,
+    createElement("div", null, `Select count: ${items.length}`),
+    createElement(
+      "div",
+      null,
+      `Select items: ${items.map((item) => item.value).join(", ")}`,
+    ),
+    createElement(Ariakit.Select, { store: select }),
+    createElement(
+      Ariakit.SelectPopover,
+      { store: select, portal },
+      createElement(Ariakit.SelectItem, { value: "Apple" }),
+      createElement(Ariakit.SelectItem, { value: "Banana" }),
+      createElement(Ariakit.SelectItem, { value: "Grape" }),
+      createElement(Ariakit.SelectItem, { value: "Orange" }),
+    ),
+  );
+}
+
+test("controlled collection items", async () => {
+  const { findByText: find } = render(createElement(CollectionExample));
+  expect(await find("Collection count: 3")).toBeInTheDocument();
+});
+
+test("controlled select items", async () => {
+  const { findByText: find } = render(createElement(SelectExample, {}));
+  expect(await find("Select count: 4")).toBeInTheDocument();
+  expect(
+    await find("Select items: Apple, Banana, Grape, Orange"),
+  ).toBeInTheDocument();
+});
+
+test("controlled select items with portal", async () => {
+  const { findByText: find } = render(
+    createElement(SelectExample, { portal: true }),
+  );
+  expect(await find("Select count: 4")).toBeInTheDocument();
+  expect(
+    await find("Select items: Apple, Banana, Grape, Orange"),
+  ).toBeInTheDocument();
+});
+
+function RemovableCollectionExample() {
+  const [items, setItems] = useState<Ariakit.CollectionStoreState["items"]>([]);
+  const [showGrape, setShowGrape] = useState(true);
+  const collection = Ariakit.useCollectionStore({ items, setItems });
+  return createElement(
+    Ariakit.Collection,
+    { store: collection },
+    createElement("div", null, `Collection count: ${items.length}`),
+    createElement(
+      "button",
+      { onClick: () => setShowGrape(false) },
+      "Remove Grape",
+    ),
+    createElement(Ariakit.CollectionItem, null, "Apple"),
+    showGrape && createElement(Ariakit.CollectionItem, null, "Grape"),
+    createElement(Ariakit.CollectionItem, null, "Orange"),
+  );
+}
+
+test("controlled collection removes an unrendered item", async () => {
+  const { findByText: find } = render(
+    createElement(RemovableCollectionExample),
+  );
+  expect(await find("Collection count: 3")).toBeInTheDocument();
+  await click(await find("Remove Grape"));
+  expect(await find("Collection count: 2")).toBeInTheDocument();
+});
