+                if (null !== $shortTokens) {
+                    // Replace tag+type in order to avoid replacing type multiple times (when same type is used in multiple places)
+                    $phpDocContent = str_replace(
+                        $matches[0][$i],
+                        '@'.$matches[1][$i].' '.implode('', array_map(
