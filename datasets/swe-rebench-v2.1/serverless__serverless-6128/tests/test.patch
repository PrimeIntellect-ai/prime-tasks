diff --git a/lib/plugins/aws/lib/getServiceState.test.js b/lib/plugins/aws/lib/getServiceState.test.js
new file mode 100644
index 000000000..3faeea3c3
--- /dev/null
+++ b/lib/plugins/aws/lib/getServiceState.test.js
@@ -0,0 +1,38 @@
+'use strict';
+
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const AwsProvider = require('../provider/awsProvider');
+const AwsCompileApigEvents = require('../package/compile/events/apiGateway');
+const Serverless = require('../../../Serverless');
+
+describe('deployment from a package directory', () => {
+  it('completes the post-deploy hook using packaged functions', () => {
+    const servicePath = fs.mkdtempSync(path.join(os.tmpdir(), 'sls-packaged-deploy-'));
+    const packagePath = path.join(servicePath, 'package');
+    fs.mkdirSync(packagePath);
+
+    const serverless = new Serverless();
+    serverless.config.servicePath = servicePath;
+    const options = { stage: 'dev', region: 'us-east-1', package: 'package' };
+    serverless.setProvider('aws', new AwsProvider(serverless, options));
+    const apiGateway = new AwsCompileApigEvents(serverless, options);
+    const stateFileName = 'serverless-state.json';
+    fs.writeFileSync(path.join(packagePath, stateFileName), JSON.stringify({
+      service: {
+        functions: {
+          withEvents: { events: [{ schedule: 'rate(5 minutes)' }] },
+          withoutEvents: { handler: 'handler.hello' },
+        },
+      },
+    }));
+
+    return apiGateway.hooks['after:deploy:deploy']()
+      .finally(() => {
+        fs.unlinkSync(path.join(packagePath, stateFileName));
+        fs.rmdirSync(packagePath);
+        fs.rmdirSync(servicePath);
+      });
+  });
+});
