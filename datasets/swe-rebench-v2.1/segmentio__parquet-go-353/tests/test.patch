+
+func TestIssue347(t *testing.T) {
+	type TestType struct {
+		Key int
+	}
+
+	// instantiating with concrete type shouldn't panic
+	_ = parquet.NewGenericBuffer[TestType]()
+
+	// instantiating with schema and interface type parameter shouldn't panic
+	schema := parquet.SchemaOf(TestType{})
+	_ = parquet.NewGenericBuffer[any](schema)
+
+	// A missing schema may be rejected at construction or reported by Write,
+	// but it must not cause a nil-pointer dereference while handling rows.
+	func() {
+		defer func() {
+			if r := recover(); r != nil && strings.Contains(fmt.Sprint(r), "nil pointer dereference") {
+				t.Errorf("writing without a schema caused a nil-pointer dereference: %v", r)
+			}
+		}()
+
+		buffer := parquet.NewGenericBuffer[any]()
+		_, _ = buffer.Write([]any{TestType{Key: 0}})
+	}()
+}
