+            "Enum entries should be retained after autofix, but got:\n$formatted"
+        }
+        val functionIndex = formatted.indexOf("fun f()")
+        val companionIndex = formatted.indexOf("companion object")
+        Assertions.assertTrue(functionIndex >= 0 && companionIndex >= 0 && functionIndex < companionIndex) {
+            "Function should be placed before companion object after autofix, but got:\n$formatted"
+        }
+    }
 }
