+package day293
+
+import (
+	"fmt"
+	"testing"
+)
+
+// nolint
+var testcases = []struct {
+	stones []int
+	cost   int
+}{
+	{
+		[]int{1, 1, 3, 3, 2, 1},
+		2,
+	},
+	{
+		[]int{0, 0, 0, 9, 9, 0},
+		17,
+	},
+	{
+		[]int{2, 9, 7, 1},
+		15,
+	},
+	{
+		[]int{2, 9, 7, 9, 9},
+		27,
+	},
+	{
+		[]int{9, 9, 9},
+		23,
+	},
+}
+
+func TestLowestCostPyramid(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range testcases {
+		t.Run(fmt.Sprint(tc.stones), func(t *testing.T) {
+			pyramid, cost := LowestCostPyramid(tc.stones)
+			if len(pyramid) != len(tc.stones) {
+				t.Fatalf("got pyramid length %d, want %d", len(pyramid), len(tc.stones))
+			}
+
+			first, last := -1, -1
+			reductionCost := 0
+			for i, height := range pyramid {
+				if height < 0 || height > tc.stones[i] {
+					t.Fatalf("height at index %d is %d, outside [0,%d]", i, height, tc.stones[i])
+				}
+				reductionCost += tc.stones[i] - height
+				if height > 0 {
+					if first < 0 {
+						first = i
+					}
+					last = i
+				}
+			}
+			if first < 0 || pyramid[first] != 1 || pyramid[last] != 1 {
+				t.Fatalf("pyramid %v must have a contiguous positive segment with endpoints of height one", pyramid)
+			}
+			peak := first
+			for i := first + 1; i <= last; i++ {
+				if pyramid[i] == 0 {
+					t.Fatalf("pyramid %v has a zero inside its positive segment", pyramid)
+				}
+				if pyramid[i] > pyramid[peak] {
+					peak = i
+				}
+			}
+			for i := first + 1; i <= peak; i++ {
+				if pyramid[i] != pyramid[i-1]+1 {
+					t.Fatalf("pyramid %v does not rise by one to its peak", pyramid)
+				}
+			}
+			for i := peak + 1; i <= last; i++ {
+				if pyramid[i] != pyramid[i-1]-1 {
+					t.Fatalf("pyramid %v does not fall by one from its peak", pyramid)
+				}
+			}
+			if reductionCost != cost {
+				t.Errorf("reported cost %d does not equal total reduction %d", cost, reductionCost)
+			}
+			if cost != tc.cost {
+				t.Errorf("minimum cost: got %d, want %d", cost, tc.cost)
+			}
+		})
+	}
+}
+
+func BenchmarkLowestCostPyramid(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		for _, tc := range testcases {
+			LowestCostPyramid(tc.stones)
+		}
+	}
+}
