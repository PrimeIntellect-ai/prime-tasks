+func TestFetchPreservesEscapedQuery(t *testing.T) {
+	mux, addr := Serve("0", "")
+	mux.HandleFunc("/query", func(w http.ResponseWriter, r *http.Request) {
+		fmt.Fprint(w, r.URL.Query().Get("value"))
+	})
+	mux.Handle("/fetch/", http.StripPrefix("/fetch/", http.HandlerFunc(FetcherHandler)))
+	url := fmt.Sprintf("localhost:%d/fetch/localhost:%d/query?value=left%%2Cright", addr.Port, addr.Port)
+	code, data := Fetch(&HTTPOptions{URL: url})
+	if code != http.StatusOK {
+		t.Fatalf("Got %d %s instead of ok for %s", code, DebugSummary(data, 256), url)
+	}
+	if !bytes.Contains(data, []byte("left,right")) {
+		t.Errorf("Fetched response %s does not contain the decoded query value", DebugSummary(data, 512))
+	}
+}
