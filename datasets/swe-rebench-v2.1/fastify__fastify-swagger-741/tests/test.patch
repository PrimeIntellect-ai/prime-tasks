diff --git a/test/transform.js b/test/transform.js
index a63cbdc..df782a2 100644
--- a/test/transform.js
+++ b/test/transform.js
@@ -139,3 +139,162 @@ test('transform can hide routes based on openapi version', async (t) => {
   const openapiObject = fastify.swagger()
   t.notOk(openapiObject.paths['/example'])
 })
+
+test('transformObject can modify the openapi object', async (t) => {
+  t.plan(1)
+  const fastify = Fastify()
+
+  await fastify.register(fastifySwagger, {
+    openapi: { info: { version: '2.0.0' } },
+    transformObject: ({ openapiObject }) => {
+      openapiObject.info.title = 'Transformed'
+      return openapiObject
+    }
+  })
+
+  await fastify.ready()
+  const openapiObject = fastify.swagger()
+  t.equal(openapiObject.info.title, 'Transformed')
+})
+
+test('transformObject can modify the swagger object', async (t) => {
+  t.plan(1)
+  const fastify = Fastify()
+
+  await fastify.register(fastifySwagger, {
+    swagger: { info: { version: '2.0.0' } },
+    transformObject: ({ swaggerObject }) => {
+      swaggerObject.info.title = 'Transformed'
+      return swaggerObject
+    }
+  })
+
+  await fastify.ready()
+  const swaggerObject = fastify.swagger()
+  t.equal(swaggerObject.info.title, 'Transformed')
+})
+
+test('transformObject can inject components into the openapi object', async (t) => {
+  t.plan(1)
+  const fastify = Fastify()
+
+  await fastify.register(fastifySwagger, {
+    openapi: { info: { version: '2.0.0' } },
+    transformObject: ({ openapiObject }) => {
+      openapiObject.components.schemas = Object.assign({}, openapiObject.components.schemas, {
+        JobId: { type: 'string' }
+      })
+      return openapiObject
+    }
+  })
+
+  await fastify.ready()
+  const openapiObject = fastify.swagger()
+  t.same(openapiObject.components.schemas.JobId, { type: 'string' })
+})
+
+test('transformObject can inject definitions into the swagger object', async (t) => {
+  t.plan(1)
+  const fastify = Fastify()
+
+  await fastify.register(fastifySwagger, {
+    swagger: { info: { version: '2.0.0' } },
+    transformObject: ({ swaggerObject }) => {
+      swaggerObject.definitions = Object.assign({}, swaggerObject.definitions, {
+        JobId: { type: 'string' }
+      })
+      return swaggerObject
+    }
+  })
+
+  await fastify.ready()
+  const swaggerObject = fastify.swagger()
+  t.same(swaggerObject.definitions.JobId, { type: 'string' })
+})
+
+test('transformObject uses the returned OpenAPI document', async (t) => {
+  const fastify = Fastify()
+  const replacement = {
+    openapi: '3.0.3',
+    info: { title: 'Returned OpenAPI document', version: '1.0.0' },
+    paths: {},
+    components: { schemas: { JobId: { type: 'string' } } }
+  }
+
+  await fastify.register(fastifySwagger, {
+    openapi: { info: { version: '2.0.0' } },
+    transformObject: () => replacement
+  })
+
+  await fastify.ready()
+  const openapiObject = fastify.swagger()
+  t.equal(openapiObject.info.title, 'Returned OpenAPI document')
+  t.same(openapiObject.components.schemas.JobId, { type: 'string' })
+})
+
+test('transformObject uses the returned Swagger document', async (t) => {
+  const fastify = Fastify()
+  const replacement = {
+    swagger: '2.0',
+    info: { title: 'Returned Swagger document', version: '1.0.0' },
+    paths: {},
+    definitions: { JobId: { type: 'string' } }
+  }
+
+  await fastify.register(fastifySwagger, {
+    swagger: { info: { version: '2.0.0' } },
+    transformObject: () => replacement
+  })
+
+  await fastify.ready()
+  const swaggerObject = fastify.swagger()
+  t.equal(swaggerObject.info.title, 'Returned Swagger document')
+  t.same(swaggerObject.definitions.JobId, { type: 'string' })
+})
+
+test('transformObject can replace the openapi components section', async (t) => {
+  const fastify = Fastify()
+  const replacementComponents = {
+    schemas: { Replacement: { type: 'number' } }
+  }
+
+  await fastify.register(fastifySwagger, {
+    openapi: {
+      info: { version: '2.0.0' },
+      components: {
+        schemas: { Existing: { type: 'string' } },
+        securitySchemes: { ExistingAuth: { type: 'http', scheme: 'bearer' } }
+      }
+    },
+    transformObject: ({ openapiObject }) => {
+      openapiObject.components = replacementComponents
+      return openapiObject
+    }
+  })
+
+  await fastify.ready()
+  const openapiObject = fastify.swagger()
+  t.same(openapiObject.components, replacementComponents)
+})
+
+test('transformObject can replace the swagger definitions section', async (t) => {
+  const fastify = Fastify()
+  const replacementDefinitions = {
+    Replacement: { type: 'number' }
+  }
+
+  await fastify.register(fastifySwagger, {
+    swagger: {
+      info: { version: '2.0.0' },
+      definitions: { Existing: { type: 'string' } }
+    },
+    transformObject: ({ swaggerObject }) => {
+      swaggerObject.definitions = replacementDefinitions
+      return swaggerObject
+    }
+  })
+
+  await fastify.ready()
+  const swaggerObject = fastify.swagger()
+  t.same(swaggerObject.definitions, replacementDefinitions)
+})
