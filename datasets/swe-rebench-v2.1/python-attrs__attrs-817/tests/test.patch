diff --git a/tests/test_functional.py b/tests/test_functional.py
index a17023f..792540b 100644
--- a/tests/test_functional.py
+++ b/tests/test_functional.py
@@ -687,3 +687,69 @@ class TestFunctional(object):
             "2021-06-01.  Please use `eq` and `order` instead."
             == w.message.args[0]
         )
+
+    @pytest.mark.parametrize("slots", [True, False])
+    def test_no_setattr_if_validate_without_validators(self, slots):
+        """
+        If a class has on_setattr=attr.setters.validate (default in NG APIs)
+        but sets no validators, don't use the (slower) setattr in __init__.
+
+        Regression test for #816.
+        """
+
+        @attr.s(on_setattr=attr.setters.validate, slots=slots)
+        class C(object):
+            x = attr.ib()
+
+        @attr.s(on_setattr=attr.setters.validate, slots=slots)
+        class D(C):
+            y = attr.ib()
+
+        # Without any validators there is nothing to validate, so the class
+        # must not install a validating __setattr__.
+        assert object.__setattr__ == D.__setattr__
+
+        # Attributes are still set and can be assigned normally.
+        d = D(1, 2)
+        assert (1, 2) == (d.x, d.y)
+        d.x = 3
+        assert 3 == d.x
+
+    def test_on_setattr_detect_inherited_validators(self):
+        """
+        If a class has on_setattr=attr.setters.validate and an inherited field
+        has a validator, the validating __setattr__ is used.
+        """
+
+        @attr.s(on_setattr=attr.setters.validate)
+        class C(object):
+            x = attr.ib(validator=attr.validators.instance_of(int))
+
+        @attr.s(on_setattr=attr.setters.validate)
+        class D(C):
+            y = attr.ib()
+
+        d = D(1, 2)
+        with pytest.raises(TypeError):
+            d.x = "not an int"
+
+    def test_no_setattr_if_validate_without_validators_define(self):
+        """
+        The new API (attr.define) defaults to on_setattr=attr.setters.validate;
+        without any validators no validating __setattr__ is installed.
+        """
+
+        @attr.define
+        class C(object):
+            x: int
+
+        @attr.define
+        class D(C):
+            y: int
+
+        assert object.__setattr__ == D.__setattr__
+
+        d = D(1, 2)
+        assert (1, 2) == (d.x, d.y)
+        d.x = 3
+        assert 3 == d.x
