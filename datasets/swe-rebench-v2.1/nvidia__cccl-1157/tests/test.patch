diff --git a/test/cmake/test_export/CMakeLists.txt b/test/cmake/test_export/CMakeLists.txt
index cfa86f2e3..5412a656a 100644
--- a/test/cmake/test_export/CMakeLists.txt
+++ b/test/cmake/test_export/CMakeLists.txt
@@ -66,6 +66,8 @@ function(do_find_package pkg_name pkg_prefix)
   if (NOT ${pkg_name}_FOUND)
     message(FATAL_ERROR "Failed: find_package(${pkg_name} ${arg_str})")
   endif()
+  # Re-execute find_package to ensure that repeated calls don't break:
+  find_package(${pkg_name} ${arg_list})
 endfunction()
 
 # Run find package with the requested configuration:
@@ -93,6 +95,17 @@ else()
   message(FATAL_ERROR "Invalid PACKAGE_TYPE: ${PACKAGE_TYPE}")
 endif()
 
+# A lookup from a child directory must also tolerate the already-created target.
+if (PACKAGE_TYPE STREQUAL "CCCL" AND TARGET CCCL::Thrust)
+  set(repeated_lookup_dir "${CMAKE_CURRENT_BINARY_DIR}/repeated_lookup")
+  file(MAKE_DIRECTORY "${repeated_lookup_dir}")
+  file(WRITE "${repeated_lookup_dir}/CMakeLists.txt"
+    "cmake_minimum_required(VERSION 3.21)\n"
+    "project(CCCLRepeatedLookup LANGUAGES CXX)\n"
+    "find_package(CCCL REQUIRED COMPONENTS Thrust NO_DEFAULT_PATH HINTS \"${CCCL_ROOT}\")\n")
+  add_subdirectory("${repeated_lookup_dir}" "${repeated_lookup_dir}/build")
+endif()
+
 if (COMPONENTS STREQUAL "DEFAULT")
   set(COMPONENTS libcudacxx CUB Thrust)
 endif()
