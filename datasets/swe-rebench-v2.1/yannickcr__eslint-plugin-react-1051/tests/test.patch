diff --git a/tests/lib/rules/void-dom-elements-no-children.js b/tests/lib/rules/void-dom-elements-no-children.js
new file mode 100644
index 0000000..fe8273a
--- /dev/null
+++ b/tests/lib/rules/void-dom-elements-no-children.js
@@ -0,0 +1,99 @@
+/**
+ * @fileoverview Tests for void-dom-elements-no-children
+ * @author Joe Lencioni
+ */
+
+'use strict';
+
+// -----------------------------------------------------------------------------
+// Requirements
+// -----------------------------------------------------------------------------
+
+var rule = require('../../../').rules['void-dom-elements-no-children'] || {
+  create: function() {
+    return {};
+  }
+};
+var RuleTester = require('eslint').RuleTester;
+
+var parserOptions = {
+  ecmaVersion: 6,
+  ecmaFeatures: {
+    experimentalObjectRestSpread: true,
+    jsx: true
+  }
+};
+
+// -----------------------------------------------------------------------------
+// Tests
+// -----------------------------------------------------------------------------
+
+// Every element React treats as a void DOM element must be recognized.
+var voidDomElements = [
+  'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input',
+  'keygen', 'link', 'menuitem', 'meta', 'param', 'source', 'track', 'wbr'
+];
+
+var voidElementInvalidCases = voidDomElements.reduce(function(cases, elementName) {
+  return cases.concat([
+    {
+      code: '<' + elementName + '>Foo</' + elementName + '>;',
+      errors: 1,
+      parserOptions: parserOptions
+    },
+    {
+      code: '<' + elementName + ' children="Foo" />;',
+      errors: 1,
+      parserOptions: parserOptions
+    },
+    {
+      code: '<' + elementName + ' dangerouslySetInnerHTML={{ __html: "Foo" }} />;',
+      errors: 1,
+      parserOptions: parserOptions
+    }
+  ]);
+}, []);
+
+var ruleTester = new RuleTester();
+ruleTester.run('void-dom-elements-no-children', rule, {
+  valid: [
+    {
+      code: '<img src="path/to/img.jpg" />;',
+      parserOptions: parserOptions
+    },
+    {
+      code: '<div>Foo</div>;',
+      parserOptions: parserOptions
+    },
+    {
+      code: '<div children="Foo" />;',
+      parserOptions: parserOptions
+    },
+    {
+      code: '<div dangerouslySetInnerHTML={{ __html: "Foo" }} />;',
+      parserOptions: parserOptions
+    }
+  ],
+  invalid: [
+    {
+      code: '<br>Foo</br>;',
+      errors: 1,
+      parserOptions: parserOptions
+    },
+    {
+      code: '<br children="Foo" />;',
+      errors: 1,
+      parserOptions: parserOptions
+    },
+    {
+      code: '<img {...props} children="Foo" />;',
+      errors: 1,
+      parserOptions: parserOptions
+    },
+    {
+      code: '<br dangerouslySetInnerHTML={{ __html: "Foo" }} />;',
+      errors: 1,
+      parserOptions: parserOptions
+    }
+  ].concat(voidElementInvalidCases)
+});
