diff --git a/test/lexers/javascript-lexer.test.js b/test/lexers/javascript-lexer.test.js
index 1f2ec02..10d14c7 100644
--- a/test/lexers/javascript-lexer.test.js
+++ b/test/lexers/javascript-lexer.test.js
@@ -1,6 +1,7 @@
 import { assert } from 'chai'
 
 import JavascriptLexer from '../../src/lexers/javascript-lexer'
+import JsxLexer from '../../src/lexers/jsx-lexer'
 
 describe('JavascriptLexer', () => {
   it('extracts keys from translation components', (done) => {
@@ -259,4 +260,35 @@ describe('JavascriptLexer', () => {
     ])
     assert.strictEqual(warningCount, 2)
   })
+
+  it('extracts non-interpolated tagged templates', () => {
+    const Lexer = new JsxLexer()
+    const content = 'const { t } = useTranslation(); <div>{t`Language`}</div>'
+    assert.deepEqual(Lexer.extract(content), [
+      {
+        key: 'Language',
+      },
+    ])
+  })
+
+  it('emits warnings on interpolated tagged templates', () => {
+    const Lexer = new JsxLexer()
+    const content =
+      'const { t } = useTranslation(); <div>{t`some-key${someVar}keykey`}</div>'
+
+    let warningCount = 0
+    Lexer.on('warning', (warning) => {
+      if (
+        warning.indexOf(
+          'A key that is a template string must not have any interpolations.'
+        ) === 0
+      ) {
+        warningCount++
+      }
+    })
+
+    Lexer.extract(content)
+
+    assert.isAtLeast(warningCount, 1)
+  })
 })
