+class TestMountedLifespan:
+    async def test_mounted_server_lifespan_is_entered(self):
+        entries = []
+
+        @asynccontextmanager
+        async def lifespan(mcp: FastMCP):
+            entries.append(True)
+            yield {}
+
+        root = FastMCP("Root")
+        sub = FastMCP("Sub", lifespan=lifespan)
+
+        @sub.tool()
+        def hello() -> str:
+            return "hello"
+
+        root.mount("sub", sub)
+
+        async with Client(root) as client:
+            await client.call_tool("sub_hello", {})
+
+        assert entries
+
+    async def test_mounted_tool_receives_mounted_lifespan_context(self):
+        @asynccontextmanager
+        async def lifespan(mcp: FastMCP):
+            yield {"mounted_value": "from mounted lifespan"}
+
+        root = FastMCP("Root")
+        sub = FastMCP("Sub", lifespan=lifespan)
+
+        @sub.tool()
+        def read_lifespan_context(ctx: Context) -> str:
+            return ctx.request_context.lifespan_context["mounted_value"]
+
+        root.mount("sub", sub)
+
+        async with Client(root) as client:
+            result = await client.call_tool("sub_read_lifespan_context", {})
+
+        assert result[0].text == "from mounted lifespan"
