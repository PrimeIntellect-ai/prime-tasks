+describe("camelcase destructuring defaults", function() {
+    it("reports bindings and default expressions without reporting a default twice", function() {
+        const linter = new Linter();
+
+        linter.defineRule("camelcase", rule);
+
+        const messages = linter.verify(
+            "const no_camelcased = 0; function foo({ camelcased_value = no_camelcased}) {}",
+            {
+                parserOptions: { ecmaVersion: 6 },
+                rules: { camelcase: 2 }
+            }
+        );
+
+        assert.deepEqual(messages.map(message => message.message).sort(), [
+            "Identifier 'camelcased_value' is not in camel case.",
+            "Identifier 'no_camelcased' is not in camel case."
+        ].sort());
+
+        const parameterMessages = linter.verify(
+            "function snakeCase({ param_1 = 'default value', param_2 = 'another default' } = {}) {}",
+            {
+                parserOptions: { ecmaVersion: 6 },
+                rules: { camelcase: [2, { properties: "never" }] }
+            }
+        );
+
+        assert.deepEqual(parameterMessages.map(message => message.message).sort(), [
+            "Identifier 'param_1' is not in camel case.",
+            "Identifier 'param_2' is not in camel case."
+        ].sort());
+    });
+});
