+def test_deprecations_reconstructing_fractional_octave_bands_frequencies():
+    expected_warning = (
+        "Return parameter 'frequencies' will be removed in pyfar 0.9.0. "
+        "To get the fractional octave center frequencies, use "
+        "`pyfar.dsp.filter.fractional_octave_frequencies` instead.")
+    with pytest.warns(PyfarDeprecationWarning) as warning:
+        result = pfilt.reconstructing_fractional_octave_bands(
+            None, num_fractions=3, frequency_range=(63, 12000),
+            sampling_rate=44.1e3)
+    assert warning[0].message.message == expected_warning
+
+    # the center frequencies are still returned for backward compatibility
+    assert isinstance(result, tuple)
+    assert result[0] is not None
+    _, expected = pfilt.fractional_octave_frequencies(
+        num_fractions=3, frequency_range=(63, 12000))
+    npt.assert_array_equal(result[-1], expected)
+
+    # the same holds when a signal is filtered
+    signal = pf.signals.impulse(2**12, sampling_rate=44.1e3)
+    with pytest.warns(PyfarDeprecationWarning):
+        result = pfilt.reconstructing_fractional_octave_bands(
+            signal, num_fractions=3, frequency_range=(63, 12000))
+    assert isinstance(result, tuple)
+    npt.assert_array_equal(result[-1], expected)
+
+
+def test_fractional_octave_function_parameter_conventions():
+    """Keep both fractional-octave APIs' established parameter conventions."""
+    reconstructing_parameters = inspect.signature(
+        pfilt.reconstructing_fractional_octave_bands).parameters
+    assert reconstructing_parameters["num_fractions"].default == 1
+    assert list(reconstructing_parameters)[-1] == "sampling_rate"
+
+    fractional_parameters = inspect.signature(
+        pfilt.fractional_octave_bands).parameters
+    assert fractional_parameters["num_fractions"].default is inspect.Parameter.empty
+    assert list(fractional_parameters).index("sampling_rate") == (
+        list(fractional_parameters).index("num_fractions") + 1)
