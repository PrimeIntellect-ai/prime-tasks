+<?php
+
+declare(strict_types=1);
+
+namespace Tests\Providers\XAI;
+
+use EchoLabs\Prism\Prism;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+use Tests\Fixtures\FixtureResponse;
+
+beforeEach(function (): void {
+    config()->set('prism.providers.xai.api_key', env('XAI_API_KEY', 'xai-123'));
+});
+
+describe('Text generation for XAI', function (): void {
+    it('can generate text using its configured endpoint and API key', function (): void {
+        config()->set('prism.providers.xai.api_key', 'xai-secret');
+        config()->set('prism.providers.xai.url', 'https://custom-xai.example/v1');
+        FixtureResponse::fakeResponseSequence('chat/completions', 'xai/generate-text-with-a-prompt');
+
+        $response = Prism::text()
+            ->using('xai', 'grok-beta')
+            ->withPrompt('Who are you?')
+            ->generate();
+
+        expect($response->text)->toBe(
+            "I am Grok, an AI developed by xAI. I'm here to provide helpful and truthful answers to your questions, often with a dash of outside perspective on humanity. What's on your mind?"
+        );
+
+        Http::assertSent(fn (Request $request): bool =>
+            str_starts_with($request->url(), 'https://custom-xai.example/v1/')
+            && $request->header('Authorization') === ['Bearer xai-secret']
+            && $request->data()['model'] === 'grok-beta'
+            && collect($request->data()['messages'])->contains(fn (array $message): bool =>
+                $message['role'] === 'user'
+                && (is_string($message['content'])
+                    ? $message['content'] === 'Who are you?'
+                    : collect($message['content'])->contains(fn (array $part): bool => ($part['text'] ?? null) === 'Who are you?'))
+            )
+        );
+    });
+
+    it('keeps endpoint and API-key settings independent from OpenAI', function (): void {
+        config()->set('prism.providers.xai.api_key', 'xai-isolated-key');
+        config()->set('prism.providers.xai.url', 'https://xai-isolated.example/v1');
+        config()->set('prism.providers.openai.api_key', 'openai-isolated-key');
+        config()->set('prism.providers.openai.url', 'https://openai-isolated.example/v1');
+
+        Http::fake([
+            '*' => Http::response([
+                'choices' => [[
+                    'message' => ['content' => 'ok'],
+                    'finish_reason' => 'stop',
+                ]],
+                'usage' => ['prompt_tokens' => 1, 'completion_tokens' => 1],
+                'id' => 'isolated-response',
+                'model' => 'test-model',
+            ]),
+        ])->preventStrayRequests();
+
+        Prism::text()->using('xai', 'grok-beta')->withPrompt('xai prompt')->generate();
+        Prism::text()->using('openai', 'gpt-4')->withPrompt('openai prompt')->generate();
+
+        Http::assertSent(fn (Request $request): bool =>
+            str_starts_with($request->url(), 'https://xai-isolated.example/v1/')
+            && $request->header('Authorization') === ['Bearer xai-isolated-key']
+        );
+        Http::assertSent(fn (Request $request): bool =>
+            str_starts_with($request->url(), 'https://openai-isolated.example/v1/')
+            && $request->header('Authorization') === ['Bearer openai-isolated-key']
+        );
+    });
+
+    it('uses the XAI_API_KEY environment variable', function (): void {
+        $previousConfig = config('prism.providers.xai');
+        $previousProcessValue = getenv('XAI_API_KEY');
+        $hadEnvValue = array_key_exists('XAI_API_KEY', $_ENV);
+        $previousEnvValue = $_ENV['XAI_API_KEY'] ?? null;
+        $hadServerValue = array_key_exists('XAI_API_KEY', $_SERVER);
+        $previousServerValue = $_SERVER['XAI_API_KEY'] ?? null;
+
+        try {
+            putenv('XAI_API_KEY=xai-from-environment');
+            $_ENV['XAI_API_KEY'] = 'xai-from-environment';
+            $_SERVER['XAI_API_KEY'] = 'xai-from-environment';
+            $providerConfig = require dirname(__DIR__, 3).'/config/prism.php';
+            config()->set('prism.providers.xai', $providerConfig['providers']['xai']);
+            config()->set('prism.providers.xai.url', 'https://env-key-xai.example/v1');
+
+            Http::fake(['*' => Http::response([
+                'choices' => [[
+                    'message' => ['content' => 'ok'],
+                    'finish_reason' => 'stop',
+                ]],
+                'usage' => ['prompt_tokens' => 1, 'completion_tokens' => 1],
+                'id' => 'env-key-response',
+                'model' => 'grok-beta',
+            ])])->preventStrayRequests();
+
+            Prism::text()->using('xai', 'grok-beta')->withPrompt('environment key')->generate();
+
+            Http::assertSent(fn (Request $request): bool =>
+                str_starts_with($request->url(), 'https://env-key-xai.example/v1/')
+                && $request->header('Authorization') === ['Bearer xai-from-environment']
+            );
+        } finally {
+            config()->set('prism.providers.xai', $previousConfig);
+            $previousProcessValue === false ? putenv('XAI_API_KEY') : putenv('XAI_API_KEY='.$previousProcessValue);
+            if ($hadEnvValue) {
+                $_ENV['XAI_API_KEY'] = $previousEnvValue;
+            } else {
+                unset($_ENV['XAI_API_KEY']);
+            }
+            if ($hadServerValue) {
+                $_SERVER['XAI_API_KEY'] = $previousServerValue;
+            } else {
+                unset($_SERVER['XAI_API_KEY']);
+            }
+        }
+    });
+
+    it('uses the XAI_URL environment variable', function (): void {
+        $previousConfig = config('prism.providers.xai');
+        $previousProcessValue = getenv('XAI_URL');
+        $hadEnvValue = array_key_exists('XAI_URL', $_ENV);
+        $previousEnvValue = $_ENV['XAI_URL'] ?? null;
+        $hadServerValue = array_key_exists('XAI_URL', $_SERVER);
+        $previousServerValue = $_SERVER['XAI_URL'] ?? null;
+
+        try {
+            putenv('XAI_URL=https://env-url-xai.example/v1');
+            $_ENV['XAI_URL'] = 'https://env-url-xai.example/v1';
+            $_SERVER['XAI_URL'] = 'https://env-url-xai.example/v1';
+            $providerConfig = require dirname(__DIR__, 3).'/config/prism.php';
+            config()->set('prism.providers.xai', $providerConfig['providers']['xai']);
+            config()->set('prism.providers.xai.api_key', 'xai-url-environment-key');
+
+            Http::fake(['*' => Http::response([
+                'choices' => [[
+                    'message' => ['content' => 'ok'],
+                    'finish_reason' => 'stop',
+                ]],
+                'usage' => ['prompt_tokens' => 1, 'completion_tokens' => 1],
+                'id' => 'env-url-response',
+                'model' => 'grok-beta',
+            ])])->preventStrayRequests();
+
+            Prism::text()->using('xai', 'grok-beta')->withPrompt('environment URL')->generate();
+
+            Http::assertSent(fn (Request $request): bool =>
+                str_starts_with($request->url(), 'https://env-url-xai.example/v1/')
+                && $request->header('Authorization') === ['Bearer xai-url-environment-key']
+            );
+        } finally {
+            config()->set('prism.providers.xai', $previousConfig);
+            $previousProcessValue === false ? putenv('XAI_URL') : putenv('XAI_URL='.$previousProcessValue);
+            if ($hadEnvValue) {
+                $_ENV['XAI_URL'] = $previousEnvValue;
+            } else {
+                unset($_ENV['XAI_URL']);
+            }
+            if ($hadServerValue) {
+                $_SERVER['XAI_URL'] = $previousServerValue;
+            } else {
+                unset($_SERVER['XAI_URL']);
+            }
+        }
+    });
+
+    it('uses the documented default endpoint when XAI_URL is not set', function (): void {
+        $previousConfig = config('prism.providers.xai');
+        $previousProcessValue = getenv('XAI_URL');
+        $hadEnvValue = array_key_exists('XAI_URL', $_ENV);
+        $previousEnvValue = $_ENV['XAI_URL'] ?? null;
+        $hadServerValue = array_key_exists('XAI_URL', $_SERVER);
+        $previousServerValue = $_SERVER['XAI_URL'] ?? null;
+
+        try {
+            putenv('XAI_URL');
+            unset($_ENV['XAI_URL'], $_SERVER['XAI_URL']);
+            $providerConfig = require dirname(__DIR__, 3).'/config/prism.php';
+            config()->set('prism.providers.xai', $providerConfig['providers']['xai']);
+            config()->set('prism.providers.xai.api_key', 'xai-default-endpoint-key');
+
+            Http::fake(['*' => Http::response([
