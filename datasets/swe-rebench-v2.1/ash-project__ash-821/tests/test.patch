              }
            ] = changeset.errors
@@ -146,11 +146,7 @@ defmodule Type.KeywordTest do
                changeset: nil,
                query: nil,
                error_context: [],
-               vars: [
-                 field: :bar,
-                 message: "must be more than or equal to %{min}",
-                 path: [:metadata]
-               ],
+               vars: [min: 0],
                path: [:metadata]
              }
            ] = changeset.errors
@@ -200,9 +196,23 @@ defmodule Type.KeywordTest do
                changeset: nil,
                query: nil,
                error_context: [],
-               vars: [field: :foo, message: "value must not be nil", path: [:metadata]],
+               vars: [],
                path: [:metadata]
              }
            ] = changeset.errors
   end
+
+  test "InvalidAttribute vars exclude reserved metadata and retain interpolation values" do
+    error =
+      Ash.Error.Changes.InvalidAttribute.exception(
+        field: :name,
+        message: "must be at least %{min}",
+        value: "bad",
+        path: [:profile],
+        vars: [field: :name, message: "must be at least %{min}", path: [:profile], min: 3]
+      )
+
+    assert error.vars == [min: 3]
+    assert Exception.message(error) =~ "must be at least 3"
+  end
 end
