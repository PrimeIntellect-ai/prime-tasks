+import { useField, useForm } from '@/vee-validate';
+import { mountWithHoc, flushPromises } from '../helpers';
+import { onMounted } from 'vue';
+
+describe('form dirty state after reset', () => {
+  test('tracks edits after resetting to fetched values with an optional undefined field', async () => {
+    let meta: any;
+    let setFieldValue: any;
+
+    mountWithHoc({
+      setup() {
+        const form = useForm();
+        meta = form.meta;
+        setFieldValue = form.setFieldValue;
+        useField('field1');
+        useField('field2');
+        useField('field3');
+
+        onMounted(async () => {
+          const fetchedValues = await Promise.resolve({
+            field1: undefined,
+            field2: 'value2',
+            field3: 'value3',
+          });
+          form.resetForm({ values: fetchedValues });
+        });
+
+        return {};
+      },
+      template: '<div></div>',
+    });
+
+    await flushPromises();
+    expect(meta.value.dirty).toBe(false);
+
+    setFieldValue('field3', 'edited');
+    await flushPromises();
+    expect(meta.value.dirty).toBe(true);
+  });
+});
