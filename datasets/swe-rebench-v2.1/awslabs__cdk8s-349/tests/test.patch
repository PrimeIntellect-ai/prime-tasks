+test('included YAML parses leading-zero octal values as base eight', () => {
+  const tmpdir = fs.mkdtempSync(path.join(os.tmpdir(), 'cdk8s-'));
+  const filePath = path.join(tmpdir, 'temp.yaml');
+  fs.writeFileSync(filePath, [
+    'apiVersion: v1',
+    'kind: ConfigMap',
+    'metadata:',
+    '  name: octal-test',
+    'data:',
+    '  value: 0666',
+  ].join('\n'));
+
+  const chart = Testing.chart();
+  new Include(chart, 'included', { url: filePath });
+
+  const [manifest] = Testing.synth(chart);
+  expect(manifest.data.value).toBe(438);
+});
+
+test('helm chart output parses leading-zero octal values as base eight', () => {
+  const tmpdir = fs.mkdtempSync(path.join(os.tmpdir(), 'cdk8s-fake-helm-'));
+  const executable = path.join(tmpdir, 'fake-helm');
+  fs.writeFileSync(executable, [
+    '#!/bin/sh',
+    'cat <<\'EOF\'',
+    'apiVersion: v1',
+    'kind: ConfigMap',
+    'metadata:',
+    '  name: helm-octal-test',
+    'data:',
+    '  value: 0666',
+    'EOF',
+  ].join('\n'));
+  fs.chmodSync(executable, 0o755);
+
+  const chart = Testing.chart();
+  new Helm(chart, 'sample', { chart: tmpdir, helmExecutable: executable });
+
+  const [manifest] = Testing.synth(chart);
+  expect(manifest.data.value).toBe(438);
+});
