+func TestInstallationContextShipCustomerReleasePayloadFitsAnnotationLimit(t *testing.T) {
+	v := viper.New()
+	ctx := &InstallationContext{
+		Meta: api.ReleaseMetadata{
+			ConfigSpec:  strings.Repeat("config-value ", 24000),
+			CollectSpec: strings.Repeat("collect-value ", 8000),
+			AnalyzeSpec: strings.Repeat("analyze-value ", 8000),
+			GithubContents: []api.GithubContent{{
+				Repo:  "example/repository",
+				Files: []api.GithubFile{{Name: "release.yaml", Data: strings.Repeat("file-data ", 8000)}},
+			}},
+		},
+		Viper:  v,
+		Logger: &logger.TestLogger{T: t},
+	}
+	builder := (&BuilderBuilder{Viper: v, Logger: &logger.TestLogger{T: t}}).NewBuilder(ctx)
+
+	payload, err := builder.String(`{{repl ShipCustomerRelease }}`)
+	require.NoError(t, err)
+	require.True(t, len(payload) <= 262144, "release metadata must fit within the ConfigMap annotation limit")
+}
+
+func TestInstallationContextShipCustomerReleaseKeepsTitledEntitlements(t *testing.T) {
+	v := viper.New()
+	ctx := &InstallationContext{
+		Meta: api.ReleaseMetadata{
+			ShipAppMetadata: api.ShipAppMetadata{Name: "titled"},
+			Entitlements: api.Entitlements{
+				Values: []api.EntitlementValue{{Key: "num_seats", Value: "3"}},
+			},
+		},
+		Viper:  v,
+		Logger: &logger.TestLogger{T: t},
+	}
+	builder := (&BuilderBuilder{Viper: v, Logger: &logger.TestLogger{T: t}}).NewBuilder(ctx)
+
+	payload, err := builder.String(`{{repl ShipCustomerRelease }}`)
+	require.NoError(t, err)
+
+	var release api.ReleaseMetadata
+	require.NoError(t, yaml.Unmarshal([]byte(payload), &release))
+	require.Equal(t, "titled", release.ShipAppMetadata.Name)
+	require.Len(t, release.Entitlements.Values, 1)
+	require.Equal(t, "num_seats", release.Entitlements.Values[0].Key)
+	require.Equal(t, "3", release.Entitlements.Values[0].Value)
+}
