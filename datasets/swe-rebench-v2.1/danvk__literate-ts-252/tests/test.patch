index bece97f..1dce5d9 100644
--- a/src/test/code-sample.test.ts
+++ b/src/test/code-sample.test.ts
@@ -5,8 +5,11 @@ import {
   applyReplacements,
   addResolvedChecks,
 } from '../code-sample.js';
+import ts from 'typescript';
+
 import {PrefixedCodeSample} from '../types.js';
 import {dedent} from '../utils.js';
+import {checkTs} from '../ts-checker.js';
 import {baseExtract, baseSample} from './common.js';
 
 const ASCIIDOC_PREPEND = `
@@ -555,4 +558,53 @@ describe('addResolvedChecks', () => {
       //   ^? type SynthT2 = "x" | "y"
       `);
   });
+
+  it('should patch a type assertion on a value', async () => {
+    const config = ts.parseJsonConfigFileContent(
+      {
+        compilerOptions: {
+          strictNullChecks: true,
+          module: 'commonjs',
+          esModuleInterop: true,
+        },
+      },
+      ts.sys,
+      process.cwd(),
+    );
+    const host = ts.createCompilerHost(config.options, true);
+    const bundle = {host, options: config.options};
+
+    const check = async (equivalentType: string) => {
+      const samples = applyPrefixes(
+        extractSamples(
+          dedent`
+            You can use the same pattern with values as well as types:
+
+            [source,ts]
+            ----
+            interface Point {
+              x: number;
+              y: number;
+            }
+            function foo(pt: Point) {
+              let k: keyof Point;
+              for (k in pt) {
+                // ^? let k: keyof Point (equivalent to ${equivalentType})
+              }
+            }
+            ----
+          `,
+          'equivalent-assertion',
+          'source.asciidoc',
+        ),
+      );
+      const patched = addResolvedChecks(samples[0]);
+      return checkTs(patched, false, bundle, {skipCache: true});
+    };
+
+    // A value assertion whose type is equivalent to the stated type passes.
+    expect((await check('"x" | "y"')).passed).toBe(true);
+    // A value assertion whose type is not equivalent to the stated type fails.
+    expect((await check('"x" | "y" | "z"')).passed).toBe(false);
+  }, 40_000);
 });
