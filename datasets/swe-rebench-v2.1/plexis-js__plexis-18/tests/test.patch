+++ b/packages/toLower/test/index.js
@@ -0,0 +1,37 @@
+import packageToLower from '@plexis/to-lower';
+import {toLower as plexisToLower, toFirstLower, decapitalize} from 'plexis';
+import toLower from '../src';
+
+it('lowercase only the first letter in single word', () => {
+  expect(toLower('HeLLo', false)).toBe('heLLo');
+});
+
+it('lowercase only the first letter in multiword sentense', () => {
+  expect(toLower('HeLLo WorLD', false)).toBe('heLLo WorLD');
+});
+
+it('lowercase all single word letters', () => {
+  expect(toLower('HeLLo', true)).toBe('hello');
+});
+
+it('lowercase all multiword sentense letters', () => {
+  expect(toLower('HeLLo WorLD', true)).toBe('hello world');
+});
+
+it('lowercase only the first letter when the second argument is omitted', () => {
+  expect(toLower('FOO Bar')).toBe('fOO Bar');
+});
+
+it('preserves the rest of the string when the second argument is omitted', () => {
+  expect(toLower('foo Bar')).toBe('foo Bar');
+});
+
+it('is available as the default import from @plexis/to-lower', () => {
+  expect(packageToLower('FOO Bar')).toBe('fOO Bar');
+});
+
+it('is available from plexis under all documented aliases', () => {
+  expect(plexisToLower('FOO Bar')).toBe('fOO Bar');
+  expect(toFirstLower('FOO Bar')).toBe('fOO Bar');
+  expect(decapitalize('FOO Bar')).toBe('fOO Bar');
+});
