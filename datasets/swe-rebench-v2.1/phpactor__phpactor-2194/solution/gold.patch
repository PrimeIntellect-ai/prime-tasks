diff --git a/lib/Indexer/Model/Record/HasFlagsTrait.php b/lib/Indexer/Model/Record/HasFlagsTrait.php
new file mode 100644
index 00000000..442d421e
--- /dev/null
+++ b/lib/Indexer/Model/Record/HasFlagsTrait.php
@@ -0,0 +1,32 @@
+<?php
+
+namespace Phpactor\Indexer\Model\Record;
+
+trait HasFlagsTrait
+{
+    private int $flags = 0;
+
+    public function setFlags(int $flags): self
+    {
+        $this->flags = $flags;
+
+        return $this;
+    }
+
+    public function addFlag(int $flag): self
+    {
+        $this->flags = $this->flags | $flag;
+
+        return $this;
+    }
+
+    public function hasFlag(int $flag): bool
+    {
+        return (bool) ($this->flags & $flag);
+    }
+
+    public function flags(): int
+    {
+        return $this->flags;
+    }
+}
