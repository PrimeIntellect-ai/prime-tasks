+
+test('Push a release over the configured SSH transport when credentials are available', async t => {
+  const {cwd, repositoryUrl} = await gitRepo(true);
+  const sshRepositoryUrl = 'ssh://git@host.null/owner/repo.git';
+  await gitAddConfig(`url.${repositoryUrl}.insteadOf`, sshRepositoryUrl, {cwd});
+
+  // Exercise the fallback path once, then allow subsequent SSH pushes normally.
+  const prePushHook = `${cwd}/.git/hooks/pre-push`;
+  await fs.promises.writeFile(
+    prePushHook,
+    '#!/bin/sh\nmarker="$(dirname "$0")/pre-push-seen"\nif [ ! -e "$marker" ]; then touch "$marker"; exit 1; fi\nexit 0\n',
+    {mode: 0o755}
+  );
+
+  const semanticRelease = proxyquire('../', {
+    'env-ci': () => ({isCi: true, branch: 'master', isPr: false}),
+  });
+
+  await semanticRelease(
+    {
+      branch: 'master',
+      repositoryUrl: sshRepositoryUrl,
+      verifyConditions: false,
+      analyzeCommits: async () => 'patch',
+      verifyRelease: false,
+      generateNotes: async () => 'Release notes',
+      prepare: false,
+      publish: false,
+      success: false,
+      fail: false,
+    },
+    {
+      cwd,
+      env: {...process.env, GIT_CREDENTIALS: 'user:pass'},
+      stdout: {write: () => {}},
+      stderr: {write: () => {}},
+    }
+  );
+
+  t.truthy(await execa.stdout('git', ['ls-remote', sshRepositoryUrl, 'refs/tags/v1.0.0'], {cwd}));
+});
