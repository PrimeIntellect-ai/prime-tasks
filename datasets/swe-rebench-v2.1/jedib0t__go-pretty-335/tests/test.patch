+func TestTable_Render_HyperlinkAlignment(t *testing.T) {
+	const url = "https://example.com/item"
+	render := func(firstCell string) string {
+		tw := NewWriter()
+		tw.AppendHeader(Row{"NAME", "VALUE"})
+		tw.AppendRows([]Row{{firstCell, "one"}, {"Beta", "two"}})
+		tw.SetStyle(StyleLight)
+		return tw.Render()
+	}
+
+	columnBoundary := func(rendered, wanted string) int {
+		for _, line := range strings.Split(rendered, "\n") {
+			if strings.Contains(line, wanted) {
+				separator := strings.Index(line, " │ ")
+				if separator >= 0 {
+					return text.RuneWidthWithoutEscSequences(line[:separator])
+				}
+			}
+		}
+		return -1
+	}
+
+	plain := render("Alpha")
+	linked := render(text.Hyperlink(url, "Alpha"))
+	coloredLinked := render(text.FgCyan.Sprint(text.Hyperlink(url, "Alpha")))
+	for _, cell := range []string{"NAME", "Alpha", "Beta"} {
+		plainBoundary := columnBoundary(plain, cell)
+		assert.GreaterOrEqual(t, plainBoundary, 0, cell)
+		for _, annotated := range []string{linked, coloredLinked} {
+			annotatedBoundary := columnBoundary(annotated, cell)
+			assert.GreaterOrEqual(t, annotatedBoundary, 0, cell)
+			assert.Equal(t, plainBoundary, annotatedBoundary, cell)
+		}
+	}
+}
