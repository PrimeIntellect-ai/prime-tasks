+func TestTable_Render_AutoWidth(t *testing.T) {
+	tw := NewWriter()
+	tw.AppendHeader(testHeader)
+	tw.AppendRows(testRows)
+	tw.AppendFooter(testFooter)
+	tw.SetStyle(StyleLight)
+
+	widths := func(rendered string) []int {
+		lines := strings.Split(rendered, "\n")
+		result := make([]int, len(lines))
+		for idx, line := range lines {
+			result[idx] = len([]rune(line))
+		}
+		return result
+	}
+
+	// A positive minimum expands the complete table when its natural width is
+	// smaller, without requiring a particular allocation among columns.
+	setTableSizeOptions(t, tw, 0, 0)
+	naturalWidths := widths(tw.Render())
+	assert.Less(t, naturalWidths[0], 100)
+	setTableSizeOptions(t, tw, 0, 100)
+	minWidths := widths(tw.Render())
+	assert.NotEmpty(t, minWidths)
+	for _, width := range minWidths {
+		assert.GreaterOrEqual(t, width, 100)
+	}
+
+	// With no maximum the natural table stays wider than 60 characters; a
+	// positive maximum bounds every rendered row and marks truncated rows.
+	setTableSizeOptions(t, tw, 0, 0)
+	unboundedWidths := widths(tw.Render())
+	assert.Greater(t, unboundedWidths[0], 60)
+	setTableSizeOptions(t, tw, 60, 0)
+	maxRendered := tw.Render()
+	unfinishedRowFound := false
+	for _, line := range strings.Split(maxRendered, "\n") {
+		assert.LessOrEqual(t, text.RuneWidthWithoutEscSequences(line), 60)
+		if strings.HasPrefix(line, tw.Style().Box.Left) && strings.HasSuffix(line, tw.Style().Box.UnfinishedRow) {
+			unfinishedRowFound = true
+		}
+	}
+	assert.True(t, unfinishedRowFound, "content exceeding WidthMax must end with the unfinished-row marker")
+}
