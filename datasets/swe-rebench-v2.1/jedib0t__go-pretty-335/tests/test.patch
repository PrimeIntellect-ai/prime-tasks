+func TestTable_Render_AutoWidthZeroMinimumAppliesNoMinimum(t *testing.T) {
+	// With no minimum configured, a very small table must stay small: the
+	// width is not replaced by any externally detected or default width.
+	tw := NewWriter()
+	tw.AppendHeader(Row{"A"})
+	tw.AppendRow(Row{"b"})
+	tw.SetStyle(StyleLight)
+	setTableSizeOptions(t, tw, 0, 0)
+
+	for _, line := range strings.Split(tw.Render(), "\n") {
+		assert.LessOrEqual(t, text.RuneWidthWithoutEscSequences(line), 10, line)
+	}
+}
