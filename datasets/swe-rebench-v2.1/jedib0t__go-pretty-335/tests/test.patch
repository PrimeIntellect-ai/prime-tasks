+func setTableSizeOptions(t *testing.T, tw Writer, widthMax, widthMin int) {
+	t.Helper()
+	size := reflect.ValueOf(tw.Style()).Elem().FieldByName("Size")
+	if !size.IsValid() || size.Kind() != reflect.Struct || size.Type().Name() != "SizeOptions" {
+		t.Fatalf("Style must expose SizeOptions as its Size field")
+	}
+	maxField := size.FieldByName("WidthMax")
+	minField := size.FieldByName("WidthMin")
+	if !maxField.IsValid() || maxField.Kind() != reflect.Int || !minField.IsValid() || minField.Kind() != reflect.Int {
+		t.Fatalf("Style.Size must expose integer WidthMax and WidthMin fields")
+	}
+	maxField.SetInt(int64(widthMax))
+	minField.SetInt(int64(widthMin))
+}
