diff --git a/strum_tests/tests/enum_count.rs b/strum_tests/tests/enum_count.rs
index bdb5b74..ff63cd4 100644
--- a/strum_tests/tests/enum_count.rs
+++ b/strum_tests/tests/enum_count.rs
@@ -15,9 +15,89 @@ enum Week {
     Saturday,
 }
 
+// The derive macro must no longer emit a `<enum-name>_COUNT` constant. If it
+// still did, this module-level constant would clash with the generated one and
+// the crate would fail to compile.
+const WEEK_COUNT: usize = 0;
+
+#[allow(dead_code)]
+enum Manual {
+    A,
+    B,
+    C,
+}
+
+impl EnumCount for Manual {
+    const COUNT: usize = 3;
+}
+
 #[test]
 fn simple_test() {
-    assert_eq!(7, Week::count());
-    assert_eq!(Week::count(), WEEK_COUNT);
-    assert_eq!(Week::iter().count(), WEEK_COUNT);
+    assert_eq!(7, Week::COUNT);
+    assert_eq!(Week::iter().count(), Week::COUNT);
+}
+
+#[test]
+fn manual_impl_uses_associated_constant() {
+    assert_eq!(3, Manual::COUNT);
+}
+
+#[test]
+fn generated_count_constant_is_gone() {
+    assert_eq!(0, WEEK_COUNT);
+}
+
+#[test]
+fn old_count_method_is_not_available() {
+    use std::fs;
+    use std::process::Command;
+
+    let deps_dir = std::env::current_exe()
+        .unwrap()
+        .parent()
+        .unwrap()
+        .to_path_buf();
+    let strum_rlib = fs::read_dir(&deps_dir)
+        .unwrap()
+        .map(|entry| entry.unwrap().path())
+        .find(|path| {
+            path.file_name()
+                .and_then(|name| name.to_str())
+                .map(|name| name.starts_with("libstrum-") && name.ends_with(".rlib"))
+                .unwrap_or(false)
+        })
+        .expect("the strum library should be available beside this test binary");
+    let scratch = std::env::temp_dir().join(format!(
+        "strum_enum_count_api_{}",
+        std::process::id()
+    ));
+    fs::create_dir_all(&scratch).unwrap();
+    let source = scratch.join("old_api.rs");
+    fs::write(
+        &source,
+        "extern crate strum;\n\
+         use strum::EnumCount;\n\
+         struct Example;\n\
+         impl EnumCount for Example { const COUNT: usize = 1; }\n\
+         pub fn old_api() -> usize { Example::count() }\n",
+    )
+    .unwrap();
+
+    let output = Command::new("rustc")
+        .arg("--edition=2015")
+        .arg("--crate-type=lib")
+        .arg("--out-dir")
+        .arg(&scratch)
+        .arg("-L")
+        .arg(format!("dependency={}", deps_dir.display()))
+        .arg("--extern")
+        .arg(format!("strum={}", strum_rlib.display()))
+        .arg(&source)
+        .output()
+        .unwrap();
+
+    assert!(!output.status.success(), "EnumCount::count() must not compile");
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    assert!(stderr.contains("count"), "unexpected compiler error: {}", stderr);
+    fs::remove_dir_all(scratch).unwrap();
 }
