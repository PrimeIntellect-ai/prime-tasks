+func TestInvalidDestinationFeaturesFailPayment(t *testing.T) {
+	t.Parallel()
+
+	ctx, cleanUp, err := createTestCtxFromFile(101, basicGraphFilePath)
+	if err != nil {
+		t.Fatalf("unable to create router: %v", err)
+	}
+	defer cleanUp()
+
+	var paymentHash [32]byte
+	paymentHash[0] = 1
+	payment := LightningPayment{
+		Target:       ctx.aliases["sophon"],
+		Amount:       lnwire.NewMSatFromSatoshis(1000),
+		FeeLimit:     noFeeLimit,
+		PaymentHash:  paymentHash,
+		DestFeatures: payAddrFeatures,
+	}
+
+	_, _, err = ctx.router.SendPayment(&payment)
+	if err == nil {
+		t.Fatal("payment with invalid destination features should fail")
+	}
+
+	// The failed attempt must not leave the payment hash in flight, so a
+	// retry must be accepted by the payment control rather than being
+	// rejected as already in flight.
+	_, _, err = ctx.router.SendPayment(&payment)
+	if errors.Is(err, channeldb.ErrPaymentInFlight) {
+		t.Fatal("payment left in flight after invalid destination features")
+	}
+}
+
