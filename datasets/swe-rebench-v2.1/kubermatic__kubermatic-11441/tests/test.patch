+func TestKubeVirtCSIControllerDoesNotReserveHostPorts(t *testing.T) {
+	const namespace = "cluster-test"
+
+	cluster := &kubermaticv1.Cluster{
+		ObjectMeta: metav1.ObjectMeta{Name: "test"},
+		Spec: kubermaticv1.ClusterSpec{
+			Cloud: kubermaticv1.CloudSpec{
+				ProviderName: string(kubermaticv1.KubevirtCloudProvider),
+				Kubevirt:     &kubermaticv1.KubevirtCloudSpec{},
+			},
+			ClusterNetwork: kubermaticv1.ClusterNetworkingConfig{
+				DNSDomain: "cluster.local",
+			},
+		},
+		Status: kubermaticv1.ClusterStatus{
+			NamespaceName: namespace,
+			Versions: kubermaticv1.ClusterVersionsStatus{
+				ControllerManager: *semver.NewSemverOrDie("1.28.0"),
+			},
+		},
+	}
+
+	client := fake.NewClientBuilder().WithObjects(
+		&corev1.Secret{ObjectMeta: metav1.ObjectMeta{Namespace: namespace, Name: resources.AdminKubeconfigSecretName}},
+		&corev1.Secret{ObjectMeta: metav1.ObjectMeta{Namespace: namespace, Name: resources.KubeVirtCSISecretName}},
+		&corev1.Service{
+			ObjectMeta: metav1.ObjectMeta{Namespace: namespace, Name: resources.DNSResolverServiceName},
+			Spec:       corev1.ServiceSpec{ClusterIP: "10.240.16.10"},
+		},
+	).Build()
+
+	data := resources.NewTemplateDataBuilder().
+		WithContext(context.Background()).
+		WithClient(client).
+		WithCluster(cluster).
+		Build()
+
+	creators := csi.DeploymentsCreators(data)
+	require.NotEmpty(t, creators, "expected CSI deployments for a KubeVirt cluster")
+
+	for _, getter := range creators {
+		name, create := getter()
+		deployment, err := create(&appsv1.Deployment{})
+		require.NoError(t, err, "failed to create deployment %q", name)
+
+		for _, container := range deployment.Spec.Template.Spec.Containers {
+			for _, port := range container.Ports {
+				assert.Zero(t, port.HostPort, "container %q of deployment %q must not reserve host port %d, otherwise a replacement pod cannot be scheduled on a single-node seed while the old pod runs", container.Name, name, port.HostPort)
+			}
+		}
+	}
