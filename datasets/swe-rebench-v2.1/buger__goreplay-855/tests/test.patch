+// TestMessageUUIDIncorporatesSeqAndTimestamp checks that the generated
+// identifier is a deterministic function of the packet sequence number and
+// capture timestamp.
+func TestMessageUUIDIncorporatesSeqAndTimestamp(t *testing.T) {
+	msgs := make(chan *Message, 8)
+	pool := NewMessagePool(1<<20, time.Millisecond*100, nil, func(m *Message) { msgs <- m })
+	pool.End = func(m *Message) bool { return true }
+
+	base := time.Unix(1600000000, 0)
+
+	newPacket := func(seq uint32, ts time.Time) gopacket.Packet {
+		p := GetPackets(1, 1, nil)[0]
+		p.Data()[14:][20:][13] = 2 // SYN flag
+		p.Metadata().Timestamp = ts
+		binary.BigEndian.PutUint32(p.Data()[14:][20:][4:8], seq)
+		return p
+	}
+
+	// the identifier is stable for a given message
+	pool.Handler(newPacket(0, base))
+	m := <-msgs
+	u1 := m.UUID()
+	if again := m.UUID(); !bytes.Equal(u1, again) {
+		t.Errorf("expected UUID to be stable for the same message, got %s then %s", u1, again)
+	}
+
+	// same sequence number, different capture timestamps
+	pool.Handler(newPacket(0, base.Add(time.Second)))
+	u2 := collectUUIDs(t, msgs, 1)[0]
+	if bytes.Equal(u1, u2) {
+		t.Errorf("expected UUID to depend on the capture timestamp, got %s for both", u1)
+	}
+
+	// different sequence number, same capture timestamp
+	pool.Handler(newPacket(12345, base))
+	u3 := collectUUIDs(t, msgs, 1)[0]
+	if bytes.Equal(u1, u3) {
+		t.Errorf("expected UUID to depend on the sequence number, got %s for both", u1)
+	}
+
+	// identical messages get identical identifiers
+	pool.Handler(newPacket(0, base))
+	u4 := collectUUIDs(t, msgs, 1)[0]
+	if !bytes.Equal(u1, u4) {
+		t.Errorf("expected identical messages to share UUID, got %s and %s", u1, u4)
+	}
+}
+
+// collectUUIDs reads n messages from msgs and returns their UUIDs.
+func collectUUIDs(t *testing.T, msgs chan *Message, n int) [][]byte {
+	t.Helper()
+	uuids := make([][]byte, 0, n)
+	for i := 0; i < n; i++ {
+		select {
+		case m := <-msgs:
+			uuids = append(uuids, m.UUID())
+		case <-time.After(2 * time.Second):
+			t.Fatalf("timed out waiting for message %d of %d", i+1, n)
+		}
 	}
+	return uuids
 }
 
