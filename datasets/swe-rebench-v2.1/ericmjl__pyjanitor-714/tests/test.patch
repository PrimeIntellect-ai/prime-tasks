+import janitor as jn
+import pandas as pd
+import pytest
+
+
+@pytest.fixture
+def df():
+    return pd.DataFrame(
+        [
+            {"age": 22, "major": "science", "ID": 145, "result": "pass"},
+            {"age": 20, "major": "history", "ID": 322, "result": "fail"},
+            {"age": 23, "major": "history", "ID": 321, "result": "pass"},
+            {"age": 21, "major": "law", "ID": 49, "result": "fail"},
+            {"age": 19, "major": "mathematics", "ID": 224, "result": "pass"},
+            {"age": 20, "major": "science", "ID": 132, "result": "pass"},
+        ]
+    )
+
+
+def assert_selected_rows(result, expected_ids_by_group):
+    observed_ids_by_group = {
+        group: list(result.loc[result["result"].eq(group), "ID"])
+        for group in result["result"].unique()
+    }
+    assert observed_ids_by_group == expected_ids_by_group
+
+
+def test_ascending_groupby_k_2(df):
+    """Return the two lowest-age rows from each group, in sorted order."""
+    result = jn.groupby_topk(df, "result", "age", 2, {})
+    assert_selected_rows(result, {"pass": [224, 132], "fail": [322, 49]})
+
+
+def test_descending_groupby_k_3(df):
+    """Return up to three highest-age rows from each group, in sorted order."""
+    result = jn.groupby_topk(
+        df, "result", "age", 3, {"ascending": False}
+    )
+    assert_selected_rows(result, {"pass": [321, 145, 132], "fail": [49, 322]})
+
+
+def test_function_style_api_selects_sorted_source_rows(df):
+    result = jn.groupby_topk(
+        df, "result", "age", 2, {"ascending": False}
+    )
+
+    assert_selected_rows(result, {"pass": [321, 145], "fail": [49, 322]})
+    assert set(result.columns) == set(df.columns)
+    expected_ids = {321, 145, 49, 322}
+    observed_rows = result.set_index("ID").sort_index().sort_index(axis=1)
+    expected_rows = (
+        df.loc[df["ID"].isin(expected_ids)]
+        .set_index("ID")
+        .sort_index()
+        .sort_index(axis=1)
+    )
+    pd.testing.assert_frame_equal(
+        observed_rows, expected_rows, check_dtype=False
+    )
