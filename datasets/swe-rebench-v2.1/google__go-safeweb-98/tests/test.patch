+type testResponseWriter interface {
+	Write(safehttp.Response) safehttp.Result
+	Header() safehttp.Header
+	ServerError(safehttp.StatusCode) safehttp.Result
+	Interceptor(string) safehttp.Interceptor
+}
+
+// newTestHandler adapts the test's writer interface to the HandlerFunc shape
+// supplied by this version of safehttp without fixing that shape in these tests.
+func newTestHandler(fn func(testResponseWriter, *safehttp.IncomingRequest) safehttp.Result) safehttp.HandlerFunc {
+	t := reflect.TypeOf(safehttp.HandlerFunc(nil))
+	v := reflect.MakeFunc(t, func(args []reflect.Value) []reflect.Value {
+		w, ok := args[0].Interface().(testResponseWriter)
+		if !ok {
+			panic("handler writer does not provide the required response operations")
+		}
+		request := args[1].Interface().(*safehttp.IncomingRequest)
+		return []reflect.Value{reflect.ValueOf(fn(w, request))}
+	})
+	return v.Interface().(safehttp.HandlerFunc)
+}
