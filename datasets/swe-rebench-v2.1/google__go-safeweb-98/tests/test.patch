+func TestResponseWriterWriteTwicePanic(t *testing.T) {
+	methods := []string{"Write", "WriteTemplate", "ClientError", "ServerError", "Redirect"}
+	for _, method := range methods {
+		t.Run(method, func(t *testing.T) {
+			var body strings.Builder
+			underlying := newResponseRecorder(&body)
+			w := safehttp.NewResponseWriter(testDispatcher{}, underlying, nil)
+			ir := safehttptest.NewRequest(safehttp.MethodGet, "/", nil)
+			tmpl := template.Must(template.New("name").Parse("{{ . }}"))
+			write := func(value string) {
+				switch method {
+				case "Write":
+					w.Write(safehtml.HTMLEscaped(value))
+				case "WriteTemplate":
+					w.WriteTemplate(tmpl, value)
+				case "ClientError":
+					w.ClientError(safehttp.StatusBadRequest)
+				case "ServerError":
+					w.ServerError(safehttp.StatusInternalServerError)
+				case "Redirect":
+					w.Redirect(ir, "/"+value, safehttp.StatusMovedPermanently)
+				}
+			}
+
+			write("first")
+			bodyBefore := body.String()
+			statusBefore := underlying.status
+			headersBefore := underlying.header.Clone()
+			panicked := false
+			func() {
+				defer func() { panicked = recover() != nil }()
+				write("second")
+			}()
+			if !panicked {
+				t.Error("second response-writing attempt did not panic")
+			}
+			if got := body.String(); got != bodyBefore {
+				t.Errorf("body after rejected write = %q, want %q", got, bodyBefore)
+			}
+			if got := underlying.status; got != statusBefore {
+				t.Errorf("status after rejected write = %d, want %d", got, statusBefore)
+			}
+			if diff := cmp.Diff(headersBefore, underlying.header); diff != "" {
+				t.Errorf("headers after rejected write mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
+
+func TestResponseWriterDoesNotEmitSecondResponse(t *testing.T) {
+	var body strings.Builder
+	underlying := newResponseRecorder(&body)
+	w := safehttp.NewResponseWriter(testDispatcher{}, underlying, nil)
+	first := safehtml.HTMLEscaped("first response")
+	w.Write(first)
+
+	func() {
+		defer func() {
+			if recover() == nil {
+				t.Error("second response-writing attempt did not panic")
+			}
+		}()
+		w.Write(safehtml.HTMLEscaped("second response"))
+	}()
+
+	if got, want := body.String(), first.String(); got != want {
+		t.Errorf("body after rejected write = %q, want original response %q", got, want)
+	}
+}
+
+func TestResponseWriterRejectsDifferentSecondWriteMethod(t *testing.T) {
+	var body strings.Builder
+	underlying := newResponseRecorder(&body)
+	w := safehttp.NewResponseWriter(testDispatcher{}, underlying, nil)
+	first := safehtml.HTMLEscaped("first response")
+	w.Write(first)
+
+	func() {
+		defer func() {
+			if recover() == nil {
+				t.Error("second response-writing attempt did not panic")
+			}
+		}()
+		w.ClientError(safehttp.StatusBadRequest)
+	}()
+
+	if got, want := body.String(), first.String(); got != want {
+		t.Errorf("body after rejected write = %q, want original response %q", got, want)
+	}
+	if got, want := underlying.status, 200; got != want {
+		t.Errorf("status after rejected write = %d, want %d", got, want)
+	}
+}
