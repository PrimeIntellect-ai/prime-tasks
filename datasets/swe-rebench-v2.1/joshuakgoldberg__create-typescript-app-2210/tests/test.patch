+import { testBlock } from "bingo-stratum-testers";
+import { ESLint } from "eslint";
+import yml from "eslint-plugin-yml";
+import { describe, expect, test } from "vitest";
+
+import { blockESLintYML } from "./blockESLintYML.js";
+import { optionsBase } from "./options.fakes.js";
+
+function collectRuleNames(configs: { rules?: Record<string, unknown> }[]) {
+	const names = new Set<string>();
+	for (const config of configs) {
+		for (const name of Object.keys(config.rules ?? {})) {
+			names.add(name);
+		}
+	}
+	return names;
+}
+
+describe("blockESLintYML", () => {
+	test("production", () => {
+		const creation = testBlock(blockESLintYML, {
+			options: optionsBase,
+		});
+
+		expect(creation).toMatchInlineSnapshot(`
+			{
+			  "addons": [
+			    {
+			      "addons": {
+			        "extensions": [
+			          {
+			            "extends": [
+			              "yml.configs["flat/standard"]",
+			              "yml.configs["flat/prettier"]",
+			            ],
+			            "files": [
+			              "**/*.{yml,yaml}",
+			            ],
+			            "rules": {
+			              "yml/file-extension": [
+			                "error",
+			                {
+			                  "extension": "yml",
+			                },
+			              ],
+			              "yml/sort-keys": [
+			                "error",
+			                {
+			                  "order": {
+			                    "type": "asc",
+			                  },
+			                  "pathPattern": "^.*$",
+			                },
+			              ],
+			              "yml/sort-sequence-values": [
+			                "error",
+			                {
+			                  "order": {
+			                    "type": "asc",
+			                  },
+			                  "pathPattern": "^.*$",
+			                },
+			              ],
+			            },
+			          },
+			        ],
+			        "imports": [
+			          {
+			            "source": "eslint-plugin-yml",
+			            "specifier": "yml",
+			          },
+			        ],
+			      },
+			      "block": [Function],
+			    },
+			  ],
+			}
+		`);
+	});
+
+	test("the repository ESLint configuration uses the yml standard preset", async () => {
+		const standardRules = collectRuleNames(yml.configs["flat/standard"]);
+		const recommendedRules = collectRuleNames(yml.configs["flat/recommended"]);
+		const standardOnlyRules = [...standardRules].filter(
+			(rule) => !recommendedRules.has(rule),
+		);
+
+		const eslint = new ESLint({
+			overrideConfigFile: new URL("../../eslint.config.js", import.meta.url)
+				.pathname,
+		});
+
+		const [result] = await eslint.lintText("#comment\na: 1\n", {
+			filePath: "example.yml",
+		});
+
+		const reportedRules = new Set(
+			result.messages.map((message) => message.ruleId),
+		);
+
+		expect(
+			[...reportedRules].some(
+				(rule) => rule !== null && standardOnlyRules.includes(rule),
+			),
+		).toBe(true);
+	});
+});
