index 5f9c01f7b..a3fd1beab 100644
--- a/tests/llm_translation/test_bedrock_completion.py
+++ b/tests/llm_translation/test_bedrock_completion.py
@@ -2579,4 +2579,55 @@ def test_bedrock_custom_deepseek():
 
         except Exception as e:
             print(f"Error: {str(e)}")
-            raise e
+
+@pytest.mark.parametrize(
+    "model, expected_params",
+    [
+        ("bedrock/anthropic.claude-3-sonnet-20240229-v1:0", {"top_k": 2}),
+        ("bedrock/converse/us.amazon.nova-pro-v1:0", {"inferenceConfig": {"topK": 2}}),
+        ("bedrock/meta.llama3-70b-instruct-v1:0", {}),
+    ],
+)
+def test_bedrock_top_k_param(model, expected_params, monkeypatch):
+    import json
+
+    # Provide dummy AWS credentials so request signing does not require a real
+    # environment; the HTTP call itself is mocked below.
+    monkeypatch.setenv("AWS_ACCESS_KEY_ID", "test")
+    monkeypatch.setenv("AWS_SECRET_ACCESS_KEY", "test")
+    monkeypatch.setenv("AWS_REGION_NAME", "us-west-2")
+
+    client = HTTPHandler()
+
+    with patch.object(client, "post") as mock_post:
+        mock_response = Mock()
+        mock_response.text = json.dumps(
+            {
+                "output": {
+                    "message": {
+                        "role": "assistant",
+                        "content": [{"text": "Here's a joke..."}],
+                    }
+                },
+                "usage": {"inputTokens": 12, "outputTokens": 6, "totalTokens": 18},
+                "stopReason": "stop",
+            }
+        )
+        mock_response.status_code = 200
+        # Add required response attributes
+        mock_response.headers = {"Content-Type": "application/json"}
+        mock_response.json = lambda: json.loads(mock_response.text)
+        mock_post.return_value = mock_response
+
+        litellm.completion(
+            model=model,
+            messages=[{"role": "user", "content": "Hello, world!"}],
+            top_k=2,
+            client=client,
+        )
+        data = json.loads(mock_post.call_args.kwargs["data"])
+        if expected_params:
+            assert data["additionalModelRequestFields"] == expected_params
+        else:
+            # Models without top_k support must not receive it in the extra fields
+            assert not data.get("additionalModelRequestFields")
