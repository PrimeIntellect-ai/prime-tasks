+@async_test
+async def test_instance_app(tracked_requests):
+    with app_with_scout() as app:
+        communicator = ApplicationCommunicator(
+            app, asgi_http_scope(path="/instance-app/")
+        )
+        await communicator.send_input({"type": "http.request"})
+        # Read the response.
+        response_start = await communicator.receive_output()
+        response_body = await communicator.receive_output()
+
+    assert response_start["type"] == "http.response.start"
+    assert response_start["status"] == 200
+    assert response_body["type"] == "http.response.body"
+    assert response_body["body"] == b"Welcome home from an app that's a class instance."
+    assert any(
+        tracked_request.tags.get("path") == "/instance-app/"
+        and any(
+            span.operation.startswith("Controller/")
+            and span.operation.endswith("InstanceApp")
+            for span in tracked_request.complete_spans
+        )
+        for tracked_request in tracked_requests
+    )
