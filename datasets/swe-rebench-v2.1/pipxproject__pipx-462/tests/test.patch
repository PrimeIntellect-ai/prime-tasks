+def test_install_bare_vcs_url_with_editable(pipx_temp_env, tmp_path, monkeypatch):
+    git_executable = shutil.which("git", path="/usr/local/bin:/usr/bin:/bin")
+    assert git_executable is not None
+
+    repository = tmp_path / "bare-vcs-package"
+    repository.mkdir()
+    (repository / "setup.py").write_text(
+        "from setuptools import setup\n"
+        "setup(name='pipx-bare-vcs-test', version='0.1', "
+        "py_modules=['sample'], "
+        "entry_points={'console_scripts': ['pipx-bare-vcs-test=sample:main']})\n"
+    )
+    (repository / "sample.py").write_text(
+        "def main():\n    print('installed')\n"
+    )
+    for git_args in (["init", "-q"], ["add", "setup.py", "sample.py"]):
+        subprocess.run([git_executable, *git_args], cwd=repository, check=True)
+    subprocess.run(
+        [
+            git_executable,
+            "-c",
+            "user.name=pipx test",
+            "-c",
+            "user.email=pipx-test@example.invalid",
+            "commit",
+            "-qm",
+            "initial commit",
+        ],
+        cwd=repository,
+        check=True,
+    )
+
+    monkeypatch.setenv(
+        "PATH",
+        os.pathsep.join([str(Path(git_executable).parent), os.environ["PATH"]]),
+    )
+    bare_vcs_url = "git+" + repository.as_uri()
+
+    assert not run_pipx_cli(["install", "--editable", bare_vcs_url])
