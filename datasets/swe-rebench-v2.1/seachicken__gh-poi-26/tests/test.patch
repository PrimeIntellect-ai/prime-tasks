+// contract requires are invoked by name, so a missing method fails the test
+// instead of silently skipping it.
+type compatStub struct {
+*connmock.Stub
+t *testing.T
+}
+
+func compatSetup(t *testing.T, ctrl *gomock.Controller) *compatStub {
+return &compatStub{connmock.Setup(ctrl), t}
+}
+
+func (s *compatStub) CheckRepos(err error, conf *connmock.Conf) *compatStub {
+s.Stub.CheckRepos(err, conf)
+return s
+}
+func (s *compatStub) GetRepoNames(name string, err error, conf *connmock.Conf) *compatStub {
+s.Stub.GetRepoNames(name, err, conf)
+return s
+}
+func (s *compatStub) WithBranches(name string, err error, conf *connmock.Conf) *compatStub {
+if name == "@issue1" {
+s.Conn.EXPECT().GetBranchNames().Return("*,issue1,356a192b7913b04c54574d18c28d46e6395428ab", err).AnyTimes()
+} else {
+s.Stub.GetBranchNames(name, err, conf)
+}
+return s
+}
+func (s *compatStub) GetLog(stubs []connmock.LogStub, err error, conf *connmock.Conf) *compatStub {
+s.Stub.GetLog(stubs, err, conf)
+return s
+}
+func (s *compatStub) WithAssociatedRefs(stubs []connmock.AssociatedBranchNamesStub, err error, conf *connmock.Conf) *compatStub {
+for _, stub := range stubs {
+if stub.Filename == "issue1_origin-main" {
+setMockCall(s.t, s.Conn, "GetAssociatedRefNames", []interface{}{stub.Oid}, []interface{}{"refs/heads/issue1\nrefs/remotes/origin/main", err})
+} else {
+callDynamic(s.t, s.Stub, "GetAssociatedRefNames", []connmock.AssociatedBranchNamesStub{stub}, err, conf)
+}
+}
+return s
+}
+func (s *compatStub) GetPullRequests(name string, err error, conf *connmock.Conf) *compatStub {
+s.Stub.GetPullRequests(name, err, conf)
+return s
+}
+func (s *compatStub) WithWorkingTree(changes string, err error, conf *connmock.Conf) *compatStub {
+callDynamic(s.t, s.Stub, "GetUncommittedChanges", changes, err, conf)
+return s
+}
+func (s *compatStub) AllowCheckout(err error, conf *connmock.Conf) *compatStub {
+callDynamic(s.t, s.Stub, "CheckoutBranch", err, conf)
+return s
+}
+
+func callDynamic(t *testing.T, receiver interface{}, name string, args ...interface{}) []reflect.Value {
+t.Helper()
+method := reflect.ValueOf(receiver).MethodByName(name)
+if !method.IsValid() {
+t.Fatalf("%s is not available", name)
+}
+values := make([]reflect.Value, len(args))
+for i, arg := range args {
+if arg == nil {
+values[i] = reflect.Zero(method.Type().In(i))
+} else {
+values[i] = reflect.ValueOf(arg)
+}
+}
+return method.Call(values)
+}
+
+func setMockCall(t *testing.T, receiver interface{}, name string, args, results []interface{}) {
+t.Helper()
+recorder := reflect.ValueOf(receiver).MethodByName("EXPECT").Call(nil)[0]
+call := callDynamic(t, recorder.Interface(), name, args...)[0]
+values := make([]reflect.Value, len(results))
+for i, result := range results {
+if result == nil {
+values[i] = reflect.Zero(call.MethodByName("Return").Type().In(0).Elem())
+} else {
+values[i] = reflect.ValueOf(result)
+}
+}
+configured := call.MethodByName("Return").Call(values)[0]
+configured.MethodByName("AnyTimes").Call(nil)
+}
+
+func callGetBranches(t *testing.T, conn interface{}, check bool) ([]Branch, error) {
+t.Helper()
+function := reflect.ValueOf(GetBranches)
+args := []reflect.Value{reflect.ValueOf(conn)}
+if function.Type().NumIn() > 1 {
+args = append(args, reflect.ValueOf(check))
+}
+result := function.Call(args)
+branches := result[0].Interface().([]Branch)
+if result[1].IsNil() {
+return branches, nil
+}
+return branches, result[1].Interface().(error)
+}
+
+func expectCheckoutCall(t *testing.T, receiver interface{}, branch interface{}, count int) {
+t.Helper()
+recorderMethod := reflect.ValueOf(receiver).MethodByName("EXPECT")
+if !recorderMethod.IsValid() {
+t.Errorf("connection cannot verify the required branch checkout")
+return
+}
+recorder := recorderMethod.Call(nil)[0]
+checkout := recorder.MethodByName("CheckoutBranch")
+if !checkout.IsValid() {
+t.Errorf("connection does not provide branch checkout")
+return
+}
+call := checkout.Call([]reflect.Value{reflect.ValueOf(branch)})[0]
+call.MethodByName("Return").Call([]reflect.Value{
+reflect.ValueOf(""),
+reflect.Zero(reflect.TypeOf((*error)(nil)).Elem()),
+})
+if count > 0 {
+call.MethodByName("MinTimes").Call([]reflect.Value{reflect.ValueOf(count)})
+} else {
+call.MethodByName("Times").Call([]reflect.Value{reflect.ValueOf(0)})
+}
+}
+
+func callStringError(t *testing.T, receiver interface{}, name string, args ...interface{}) (string, error) {
+t.Helper()
+result := callDynamic(t, receiver, name, args...)
+var err error
+if !result[1].IsNil() {
+err = result[1].Interface().(error)
+}
+return result[0].String(), err
+}
