+func Test_GetUncommittedChangesReturnsStatusWhenThereAreChanges(t *testing.T) {
+	dir := initGitRepo(t)
+
+	chdir(t, dir)
+	conn := &ConnectionImpl{}
+
+	changes, err := callStringError(t, conn, "GetUncommittedChanges")
+	assert.NoError(t, err)
+	assert.Equal(t, "", changes)
+
+	writeFile(t, dir, "README.md", "hello\nworld\n")
+
+	changes, err = callStringError(t, conn, "GetUncommittedChanges")
+	assert.NoError(t, err)
+	assert.NotEqual(t, "", changes)
+}
+
+func Test_CheckoutBranchSwitchesToTheBranch(t *testing.T) {
+	dir := initGitRepo(t)
+	gitRun(t, dir, "checkout", "-qb", "issue1")
+
+	chdir(t, dir)
+	conn := &ConnectionImpl{}
+
+	_, err := callStringError(t, conn, "CheckoutBranch", "main")
+	assert.NoError(t, err)
+	assert.Equal(t, "main", gitRun(t, dir, "rev-parse", "--abbrev-ref", "HEAD"))
+}
+
+func Test_GetAssociatedRefNamesReturnsRefsContainingTheCommit(t *testing.T) {
+	dir := initGitRepo(t)
+	gitRun(t, dir, "checkout", "-qb", "issue1")
+	writeFile(t, dir, "issue1.txt", "issue1\n")
+	gitRun(t, dir, "add", "issue1.txt")
+	gitRun(t, dir, "commit", "-qm", "issue1")
+	oid := gitRun(t, dir, "rev-parse", "HEAD")
+	gitRun(t, dir, "update-ref", "refs/remotes/origin/issue1", oid)
+
+	chdir(t, dir)
+	conn := &ConnectionImpl{}
+
+	refNames, err := callStringError(t, conn, "GetAssociatedRefNames", oid)
+	assert.NoError(t, err)
+	assert.Contains(t, refNames, "issue1")
+	assert.Contains(t, refNames, "origin/issue1")
+}
+
+func Test_ConnectionProvidesTheBranchOperations(t *testing.T) {
+	connType := reflect.TypeOf((*Connection)(nil)).Elem()
+	for _, name := range []string{"GetAssociatedRefNames", "GetUncommittedChanges", "CheckoutBranch"} {
+		_, ok := connType.MethodByName(name)
+		assert.True(t, ok, "Connection should declare %s", name)
+	}
+
+	dir := initGitRepo(t)
+	gitRun(t, dir, "checkout", "-qb", "issue1")
+	oid := gitRun(t, dir, "rev-parse", "HEAD")
+
+	chdir(t, dir)
+	conn := &ConnectionImpl{}
+
+	changes, err := callStringError(t, conn, "GetUncommittedChanges")
+	assert.NoError(t, err)
+	assert.Equal(t, "", changes)
+
+	refNames, err := callStringError(t, conn, "GetAssociatedRefNames", oid)
+	assert.NoError(t, err)
+	assert.Contains(t, refNames, "issue1")
+
+	_, err = callStringError(t, conn, "CheckoutBranch", "main")
+	assert.NoError(t, err)
+	assert.Equal(t, "main", gitRun(t, dir, "rev-parse", "--abbrev-ref", "HEAD"))
+}
+
+func initGitRepo(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	gitRun(t, dir, "init", "-q", "-b", "main")
+	gitRun(t, dir, "config", "user.email", "test@example.com")
+	gitRun(t, dir, "config", "user.name", "test")
+	writeFile(t, dir, "README.md", "hello\n")
+	gitRun(t, dir, "add", "README.md")
+	gitRun(t, dir, "commit", "-qm", "initial")
+	return dir
+}
+
+func writeFile(t *testing.T, dir string, name string, content string) {
+	t.Helper()
+	if err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func gitRun(t *testing.T, dir string, args ...string) string {
+	t.Helper()
+	cmd := exec.Command("git", args...)
+	cmd.Dir = dir
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("git %v failed: %v\n%s", args, err, out)
+	}
+	return strings.TrimSpace(string(out))
+}
+
+func chdir(t *testing.T, dir string) {
+	t.Helper()
+	old, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chdir(dir); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.Chdir(old) })
+}
