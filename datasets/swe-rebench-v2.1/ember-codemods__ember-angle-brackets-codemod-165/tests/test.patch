+test('handles link-to concat', () => {
+  let input = `
+    {{#link-to
+      (concat someVariable ".detail")
+      class="some-class"
+    }}click{{/link-to}}
+  `;
+
+  let output = runTest('handles-link-to-concat.hbs', input);
+  let route = output.match(/@route=([^>]+)/);
+  expect(route).not.toBeNull();
+  expect(route[1]).toContain('concat');
+  expect(route[1]).toContain('someVariable');
+  expect(route[1]).toContain('.detail');
+});
