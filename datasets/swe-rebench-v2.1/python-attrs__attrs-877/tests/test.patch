         MatchTester("A1")  # test flags and using re.match
 
+    def test_precompiled_pattern(self):
+        """
+        Pre-compiled patterns are accepted.
+        """
+        pattern = re.compile("a")
+
+        @attr.s
+        class RePatternTester(object):
+            val = attr.ib(validator=matches_re(pattern))
+
+        RePatternTester("a")
+        with pytest.raises(ValueError):
+            RePatternTester("b")
+
+        # A pre-compiled pattern carries its own flags and cannot be
+        # combined with a 'flags' argument.
+        with pytest.raises(
+            TypeError, match="can only be used with a string pattern"
+        ):
+            matches_re(pattern, flags=re.IGNORECASE)
+
+    def test_precompiled_pattern_honors_flags(self):
+        """Options on the compiled expression affect validation."""
+        pattern = re.compile("a", re.IGNORECASE)
+
+        @attr.s
+        class RePatternTester(object):
+            val = attr.ib(validator=matches_re(pattern))
+
+        RePatternTester("A")
+
