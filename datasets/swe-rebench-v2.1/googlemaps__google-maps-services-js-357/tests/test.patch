 import axios from "axios";
 
+// Captures the headers of the outgoing request made through a client so that
+// the test observes what is actually sent over the wire rather than how the
+// header happens to be stored on the Axios instance.
+function captureRequestHeaders(): {
+  adapter: (config: any) => Promise<any>;
+  state: { headers?: any };
+} {
+  const state: { headers?: any } = {};
+  const adapter = (config: any) => {
+    state.headers = config.headers;
+    return Promise.resolve({
+      data: {},
+      status: 200,
+      statusText: "OK",
+      headers: {},
+      config,
+      request: {}
+    });
+  };
+  return { adapter, state };
+}
+
