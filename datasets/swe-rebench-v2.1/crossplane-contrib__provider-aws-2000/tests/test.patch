+func TestImportedInstanceMasterUsernameConnectionDetails(t *testing.T) {
+	ctx := context.Background()
+	cr := instance(withMasterUsername(&masterUsername))
+	describe := func(_ context.Context, _ *awsrds.DescribeDBInstancesInput, _ []func(*awsrds.Options)) (*awsrds.DescribeDBInstancesOutput, error) {
+		return &awsrds.DescribeDBInstancesOutput{DBInstances: []awsrdstypes.DBInstance{{
+			DBInstanceStatus: aws.String(string(v1beta1.RDSInstanceStateAvailable)),
+			MasterUsername:   aws.String(masterUsername),
+		}}}, nil
+	}
+
+	observer := &external{client: &fake.MockRDSClient{MockDescribe: describe}}
+	observed, err := observer.Observe(ctx, cr)
+	if err != nil {
+		t.Fatalf("Observe imported instance: %v", err)
+	}
+
+	key := xpv1.ResourceCredentialsSecretUserKey
+	if string(observed.ConnectionDetails[key]) == masterUsername {
+		return
+	}
+
+	updater := &external{client: &fake.MockRDSClient{
+		MockDescribe: describe,
+		MockModify: func(_ context.Context, _ *awsrds.ModifyDBInstanceInput, _ []func(*awsrds.Options)) (*awsrds.ModifyDBInstanceOutput, error) {
+			return &awsrds.ModifyDBInstanceOutput{}, nil
+		},
+	}}
+	updated, err := updater.Update(ctx, cr)
+	if err != nil {
+		t.Fatalf("Update imported instance: %v", err)
+	}
+	if string(updated.ConnectionDetails[key]) != masterUsername {
+		t.Fatalf("configured username %q was absent from both observation and update connection details", masterUsername)
+	}
+}
