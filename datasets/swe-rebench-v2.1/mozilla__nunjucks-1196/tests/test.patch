+      var loaded;
+      if (typeof path === 'undefined') {
+        this.skip();
+        return;
+      }
+      env = new Environment(new Loader(templatesPath));
+      loaded = [];
+      env.on('load', function(name, source) {
+        loaded.push(source.path);
+      });
+
+      // extends: base-inherit.njk extends base.njk
+      env.render('base-inherit.njk', {});
+      expect(loaded).to.contain(path.resolve(templatesPath, 'base.njk'));
+
+      // import: import-macro-call-undefined-macro.njk imports
+      // macro-call-undefined-macro.njk
