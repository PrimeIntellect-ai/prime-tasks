+func TestWebhook_ServeRequest(t *testing.T) {
+	webhook := NewWebhook(
+		HandlerFunc(func(ctx context.Context, update *Update) error {
+			return update.Respond(ctx, tg.NewSendMessageCall(update.Message.Chat, "test"))
+		}),
+		&tg.Client{},
+		"http://test.io/",
+		WithWebhookSecuritySubnets(),
+		WithWebhookSecurityToken(""),
+	)
+
+	serveRequest := reflect.ValueOf(webhook).MethodByName("ServeRequest")
+	if !serveRequest.IsValid() {
+		t.Fatal("Webhook.ServeRequest is not available")
+	}
+	methodType := serveRequest.Type()
+	contextType := reflect.TypeOf((*context.Context)(nil)).Elem()
+	if methodType.NumIn() != 2 || methodType.In(0) != contextType {
+		t.Fatalf("ServeRequest must accept context.Context and *WebhookRequest; got %s", methodType)
+	}
+	requestType := methodType.In(1)
+	if requestType.Kind() != reflect.Ptr || requestType.Elem().Kind() != reflect.Struct || requestType.Elem().Name() != "WebhookRequest" {
+		t.Fatalf("ServeRequest must accept *WebhookRequest; got %s", requestType)
+	}
+	if methodType.NumOut() != 1 || methodType.Out(0).Kind() != reflect.Ptr || methodType.Out(0).Elem().Kind() != reflect.Struct || methodType.Out(0).Elem().Name() != "WebhookResponse" {
+		t.Fatalf("ServeRequest must return *WebhookResponse; got %s", methodType)
+	}
+
+	request := reflect.New(requestType.Elem())
+	setField := func(name string, value reflect.Value, want reflect.Type) {
+		t.Helper()
+		field := request.Elem().FieldByName(name)
+		if !field.IsValid() || !field.CanSet() || field.Type() != want || !value.Type().AssignableTo(want) {
+			t.Fatalf("WebhookRequest.%s must have type %s", name, want)
+		}
+		field.Set(value)
+	}
+	setField("Method", reflect.ValueOf(http.MethodPost), reflect.TypeOf(""))
+	setField("ContentType", reflect.ValueOf("application/json"), reflect.TypeOf(""))
+	setField("IP", reflect.ValueOf(netip.MustParseAddr("1.1.1.1")), reflect.TypeOf(netip.Addr{}))
+	setField("SecurityToken", reflect.ValueOf(""), reflect.TypeOf(""))
+	setField("Body", reflect.ValueOf(strings.NewReader(`{"update_id": 123456, "message": {"chat": {"id": 1234}}}`)), reflect.TypeOf((*io.Reader)(nil)).Elem())
+
+	responseValues := serveRequest.Call([]reflect.Value{reflect.ValueOf(context.Background()), request})
+	response := responseValues[0]
+	if response.IsNil() {
+		t.Fatal("ServeRequest returned a nil response")
+	}
+	responseField := func(name string, want reflect.Type) reflect.Value {
+		t.Helper()
+		field := response.Elem().FieldByName(name)
+		if !field.IsValid() || field.Type() != want {
+			t.Fatalf("WebhookResponse.%s must have type %s", name, want)
+		}
+		return field
+	}
+	_ = responseField("Status", reflect.TypeOf(int(0)))
+	_ = responseField("ContentType", reflect.TypeOf(""))
+	body := responseField("Body", reflect.TypeOf([]byte(nil))).Bytes()
+	assert.Equal(t, `{"chat_id":"1234","method":"sendMessage","text":"test"}`, string(body))
+}
