+#[test]
+fn multiple_multi_valued_positionals_emit_one_rest_entry() {
+    let name = "my-app";
+    let mut cmd = common::two_multi_valued_arguments_command(name);
+    let mut buf = vec![];
+    clap_complete::generate(clap_complete::shells::Zsh, &mut cmd, name, &mut buf);
+    let output = String::from_utf8(buf).unwrap();
+
+    // zsh rejects a completion script that defines more than one catch-all
+    // (rest) positional argument with "doubled rest argument definition".
+    // The generated script must therefore emit at most one `*:` catch-all.
+    let rest_definitions = output
+        .lines()
+        .filter(|line| line.trim_start().starts_with("'*:"))
+        .count();
+    assert!(
+        rest_definitions <= 1,
+        "zsh completion defines {} catch-all rest arguments:\n{}",
+        rest_definitions,
+        output
+    );
+}
