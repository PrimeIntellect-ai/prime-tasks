diff --git a/fluent/tests/format.rs b/fluent/tests/format.rs
new file mode 100644
index 0000000..014b25f
--- /dev/null
+++ b/fluent/tests/format.rs
@@ -0,0 +1,56 @@
+extern crate fluent;
+
+use self::fluent::context::MessageContext;
+
+#[test]
+fn format() {
+    let mut ctx = MessageContext::new(&["x-testing"]);
+    ctx.add_messages(
+        "
+foo = Foo
+    .attr = Attribute
+-term = Term
+",
+    );
+
+    let value = ctx.format("foo", None);
+    assert_eq!(value, Some("Foo".to_string()));
+
+    let value = ctx.format("foo.attr", None);
+    assert_eq!(value, Some("Attribute".to_string()));
+
+    let value = ctx.format("foo.missing", None);
+    assert_eq!(value, None);
+
+    let value = ctx.format("missing", None);
+    assert_eq!(value, None);
+
+    let value = ctx.format("missing.attr", None);
+    assert_eq!(value, None);
+}
+
+// `MessageContext::get_message` must no longer be part of the public API.
+//
+// This is a compile-time check. If `MessageContext` still exposes a public
+// inherent `get_message` method, that inherent method takes precedence over
+// the trait method defined below, and the call in `get_message_is_removed`
+// fails to type-check because the inherent method returns
+// `Option<&ast::Message>` instead of `GetMessageProbe`.
+struct GetMessageProbe;
+
+trait ProbeGetMessage {
+    fn get_message(&self, id: &str) -> GetMessageProbe;
+}
+
+impl<'ctx> ProbeGetMessage for MessageContext<'ctx> {
+    fn get_message(&self, _id: &str) -> GetMessageProbe {
+        GetMessageProbe
+    }
+}
+
+#[test]
+fn get_message_is_removed() {
+    fn assert_probe(_: GetMessageProbe) {}
+    let ctx = MessageContext::new(&["x-testing"]);
+    assert_probe(ctx.get_message("foo"));
+}
