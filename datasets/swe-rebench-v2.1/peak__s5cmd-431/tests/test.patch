+
+func TestUsageError(t *testing.T) {
+	t.Parallel()
+
+	_, s5cmd, cleanup := setup(t)
+	defer cleanup()
+
+	cmd := s5cmd("--recursive", "ls")
+	result := icmd.RunCmd(cmd)
+
+	if result.ExitCode == 0 {
+		t.Fatalf("expected a non-zero exit code, got 0")
+	}
+
+	assertLines(t, result.Stdout(), map[int]compareFunc{})
+
+	stderr := result.Stderr()
+	first := "Incorrect Usage: flag provided but not defined: -recursive"
+	second := "See 's5cmd --help' for usage"
+
+	firstIndex := strings.Index(stderr, first)
+	secondIndex := strings.Index(stderr, second)
+
+	if firstIndex < 0 {
+		t.Errorf("expected stderr to contain %q, got: %q", first, stderr)
+	}
+	if secondIndex < 0 {
+		t.Errorf("expected stderr to contain %q, got: %q", second, stderr)
+	}
+	if firstIndex >= 0 && secondIndex >= 0 && firstIndex > secondIndex {
+		t.Errorf("expected %q to appear before %q in stderr, got: %q", first, second, stderr)
+	}
+}
