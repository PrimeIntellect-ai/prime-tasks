+    /**
+     * @see https://github.com/martin-helmich/typo3-typoscript-lint/issues/101
+     */
+    public function testWarningIsGeneratedForNotIndentedLinesInConditions()
+    {
+        $code = <<<EOF
+[globalString = GP:foo = 1]
+foo.bar = 3
+[global]
+EOF;
+
+        $sniff = new IndentationSniff(["indentConditions" => true]);
+        $tokens = (new Tokenizer())->tokenizeString($code);
+        $file = new File("file");
+
+        $sniff->sniff($tokens, $file, new LinterConfiguration());
+
+        $warnings = $file->getIssues();
+
+        $this->assertNotEmpty(array_filter($warnings, function ($warning) {
+            return $warning->getLine() === 2;
+        }), 'An indentation warning should be reported for line 2.');
+    }
+
+    public function testTwoSpacesAreNotEnoughIndentationInsideConditions()
+    {
+        $code = <<<EOF
+[globalString = GP:foo = 1]
+  foo.bar = 3
+[global]
+EOF;
+
+        $sniff = new IndentationSniff(["indentConditions" => true]);
+        $tokens = (new Tokenizer())->tokenizeString($code);
+        $file = new File("file");
+
+        $sniff->sniff($tokens, $file, new LinterConfiguration());
+
+        $warnings = $file->getIssues();
+
+        $this->assertNotEmpty(array_filter($warnings, function ($warning) {
+            return $warning->getLine() === 2;
+        }), 'Two spaces should not satisfy the four-space indentation requirement on line 2.');
+    }
 }
