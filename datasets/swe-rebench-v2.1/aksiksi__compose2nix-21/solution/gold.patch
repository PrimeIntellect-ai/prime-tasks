+func (g *Generator) GetRootPath() (string, error) {
+	if g.RootPath != "" {
+		return g.RootPath, nil
+	}
+	cwd, err := os.Getwd()
+	if err != nil {
+		return "", fmt.Errorf("failed to get current working directory: %w", err)
+	}
+	return cwd, nil
+}
