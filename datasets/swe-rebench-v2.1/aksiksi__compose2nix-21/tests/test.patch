@@ -198,3 +200,42 @@ func TestNetworkAndVolumeNames(t *testing.T) {
 	}
 	runSubtestsWithGenerator(t, g)
 }
+
+func TestRelativeServiceVolumes(t *testing.T) {
+	composePath, _ := getPaths(t, false)
+	g := &Generator{Inputs: []string{composePath}}
+	for _, runtime := range []ContainerRuntime{ContainerRuntimeDocker, ContainerRuntimePodman} {
+		t.Run(runtime.String(), func(t *testing.T) {
+			g.Runtime = runtime
+			var warnings bytes.Buffer
+			previousLogOutput := log.Writer()
+			log.SetOutput(&warnings)
+			defer log.SetOutput(previousLogOutput)
+			c, err := g.Run(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			output := c.String()
+			warned := warnings.Len() > 0
+			for _, target := range []string{"/abc", "/other"} {
+				var source string
+				for _, line := range strings.Split(output, "\n") {
+					marker := ":" + target + ":"
+					if index := strings.Index(line, marker); index >= 0 {
+						source = strings.Trim(strings.TrimSpace(line[:index]), `"`)
+						break
+					}
+				}
+				if source == "" {
+					if !warned {
+						t.Errorf("bind mount targeting %s was neither emitted nor warned about", target)
+					}
+					continue
+				}
+				if !path.IsAbs(source) && !warned {
+					t.Errorf("relative bind source %q was emitted without a warning", source)
+				}
+			}
+		})
+	}
+}
