+// TestConcurrentEnforceWithMatching verifies patterned-role authorization stays valid
+// during concurrent requests and on later requests with the same parameters.
+func TestConcurrentEnforceWithMatching(t *testing.T) {
+	e, err := NewEnforcer("examples/rbac_with_pattern_model.conf", "examples/rbac_with_pattern_policy.csv")
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.AddNamedMatchingFunc("g2", "keyMatch2", util.KeyMatch2)
+
+	const numGoroutines = 20
+	const numIterations = 100
+	var denied int64
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+
+	for i := 0; i < numGoroutines; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			for j := 0; j < numIterations; j++ {
+				allowed, err := e.Enforce("alice", "/book/123", "GET")
+				if err != nil {
+					t.Errorf("Enforce failed: %v", err)
+					return
+				}
+				if !allowed {
+					atomic.AddInt64(&denied, 1)
+				}
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+
+	if denied != 0 {
+		t.Errorf("%d of %d concurrent authorized requests were denied", denied, numGoroutines*numIterations)
+	}
+	for i := 0; i < numIterations; i++ {
+		allowed, err := e.Enforce("alice", "/book/123", "GET")
+		if err != nil {
+			t.Fatalf("Enforce after concurrent requests failed: %v", err)
+		}
+		if !allowed {
+			t.Fatalf("authorized request was denied after concurrent Enforce calls")
+		}
+	}
+}
