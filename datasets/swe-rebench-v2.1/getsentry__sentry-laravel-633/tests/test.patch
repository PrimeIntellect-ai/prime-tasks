+<?php
+
+namespace Sentry\Laravel\Tests\EventHandler;
+
+use Exception;
+use Illuminate\Contracts\Debug\ExceptionHandler;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Sentry\Breadcrumb;
+use Sentry\Event;
+use Sentry\Laravel\Tests\TestCase;
+use function Sentry\addBreadcrumb;
+
+class QueueEventsTest extends TestCase
+{
+    public function testQueueJobThatThrowsLeavesPushedScopeWithBreadcrumbs(): void
+    {
+        try {
+            dispatch(new QueueEventsTestJobThatThrowsAnUnhandledExceptionWithBreadcrumb);
+        } catch (Exception $e) {
+            $this->reportException($e);
+        }
+
+        // The breadcrumb added inside the job should be attached to the reported exception
+
+        $this->assertSomeEventContainsBreadcrumb('test', 'test');
+    }
+
+    public function testQueueJobsThatThrowPopsAndPushesScopeWithBreadcrumbsBeforeNewJob(): void
+    {
+        try {
+            dispatch(new QueueEventsTestJobThatThrowsAnUnhandledExceptionWithBreadcrumb('test #1'));
+        } catch (Exception $e) {
+            $this->reportException($e);
+        }
+
+        try {
+            dispatch(new QueueEventsTestJobThatThrowsAnUnhandledExceptionWithBreadcrumb('test #2'));
+        } catch (Exception $e) {
+            $this->reportException($e);
+        }
+
+        // The reported exception for the second job should contain the breadcrumb from the second job
+
+        $event = $this->getLastEventContainingBreadcrumb('test');
+
+        $this->assertNotNull($event);
+
+        $this->assertEventContainsBreadcrumb($event, 'test', 'test #2');
+    }
+
+    private function reportException(Exception $exception): void
+    {
+        $this->app->make(ExceptionHandler::class)->report($exception);
+    }
+
+    /**
+     * @return array<int, Event>
+     */
+    private function getCapturedEvents(): array
+    {
+        return array_map(static function (array $entry): Event {
+            return $entry[0];
+        }, $this->lastSentryEvents);
+    }
+
+    private function assertSomeEventContainsBreadcrumb(string $category, ?string $message = null): void
+    {
+        foreach ($this->getCapturedEvents() as $event) {
+            if ($this->eventContainsBreadcrumb($event, $category, $message)) {
+                $this->assertTrue(true);
+
+                return;
+            }
+        }
+
+        $this->fail(sprintf(
+            'Failed asserting that a captured event contains a breadcrumb with category "%s"%s.',
+            $category,
+            $message !== null ? sprintf(' and message "%s"', $message) : ''
+        ));
+    }
+
+    private function getLastEventContainingBreadcrumb(string $category): ?Event
+    {
+        $lastEvent = null;
+
+        foreach ($this->getCapturedEvents() as $event) {
+            if ($this->eventContainsBreadcrumb($event, $category)) {
+                $lastEvent = $event;
+            }
+        }
+
+        return $lastEvent;
+    }
+
+    private function assertEventContainsBreadcrumb(Event $event, string $category, ?string $message = null): void
+    {
+        if (!$this->eventContainsBreadcrumb($event, $category, $message)) {
+            $this->fail(sprintf(
+                'Failed asserting that the event contains a breadcrumb with category "%s"%s.',
+                $category,
+                $message !== null ? sprintf(' and message "%s"', $message) : ''
+            ));
+        }
+
+        $this->assertTrue(true);
+    }
+
+    private function assertEventDoesNotContainBreadcrumb(Event $event, string $category, ?string $message = null): void
+    {
+        if ($this->eventContainsBreadcrumb($event, $category, $message)) {
+            $this->fail(sprintf(
+                'Failed asserting that the event does not contain a breadcrumb with category "%s"%s.',
+                $category,
+                $message !== null ? sprintf(' and message "%s"', $message) : ''
+            ));
+        }
+
+        $this->assertTrue(true);
+    }
+
+    private function eventContainsBreadcrumb(Event $event, string $category, ?string $message = null): bool
+    {
+        foreach ($event->getBreadcrumbs() as $breadcrumb) {
+            if ($breadcrumb->getCategory() === $category && ($message === null || $breadcrumb->getMessage() === $message)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+}
+
+function queueEventsTestAddTestBreadcrumb($message = null): void
+{
+    addBreadcrumb(
+        new Breadcrumb(
+            Breadcrumb::LEVEL_INFO,
+            Breadcrumb::LEVEL_DEBUG,
+            'test',
+            $message ?? 'test'
+        )
+    );
+}
+
+class QueueEventsTestJobThatThrowsAnUnhandledExceptionWithBreadcrumb implements ShouldQueue
+{
+    private $message;
+
+    public function __construct($message = null)
+    {
+        $this->message = $message;
+    }
+
+    public function handle(): void
+    {
+        queueEventsTestAddTestBreadcrumb($this->message);
+
+        throw new Exception('This is a test exception');
+    }
+}
