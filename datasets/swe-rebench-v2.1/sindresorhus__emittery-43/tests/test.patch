+test('symbol event names work with iterators, clearing, and catch-all observers', async t => {
+const emitter = new Emittery();
+const eventName = Symbol('eventName');
+const calls = [];
+const anyCalls = [];
+const iterator = emitter.events(eventName);
+const anyIterator = emitter.anyEvent();
+emitter.on(eventName, data => calls.push(data));
+emitter.onAny((name, data) => anyCalls.push([name, data]));
+
+await emitter.emit(eventName, 'before clearing');
+const event = await iterator.next();
+t.false(event.done);
+t.true(event.value === 'before clearing' || (Array.isArray(event.value) && event.value[0] === eventName && event.value[1] === 'before clearing'));
+t.deepEqual(await anyIterator.next(), {done: false, value: [eventName, 'before clearing']});
+t.deepEqual(anyCalls, [[eventName, 'before clearing']]);
+
+emitter.clearListeners(eventName);
+await emitter.emit(eventName, 'after clearing');
+t.deepEqual(calls, ['before clearing']);
+t.deepEqual(await iterator.next(), {done: true});
+});
