+test('TypeScript declarations accept symbol event names', t => {
+	const fileName = path.join(process.cwd(), '__symbol_event_types__.ts');
+	const source = `
+import Emittery = require('.');
+
+const eventWithData: unique symbol = Symbol('data');
+const emptyEvent: unique symbol = Symbol('empty');
+const emitter = new Emittery();
+const listener = (data?: unknown): void => {};
+emitter.on(eventWithData, listener);
+emitter.off(eventWithData, listener);
+emitter.once(eventWithData);
+emitter.events(eventWithData);
+emitter.emit(eventWithData, 'data');
+emitter.emitSerial(eventWithData, 'data');
+emitter.clearListeners(eventWithData);
+emitter.listenerCount(eventWithData);
+
+type EventMap = {[eventWithData]: string};
+const typedEmitter = new Emittery.Typed<EventMap, typeof emptyEvent>();
+const dataListener = (data: string): void => {};
+typedEmitter.on(eventWithData, dataListener);
+typedEmitter.off(eventWithData, dataListener);
+typedEmitter.once(eventWithData);
+typedEmitter.events(eventWithData);
+typedEmitter.emit(eventWithData, 'data');
+typedEmitter.emitSerial(eventWithData, 'data');
+typedEmitter.on(emptyEvent, () => {});
+typedEmitter.off(emptyEvent, () => {});
+typedEmitter.once(emptyEvent);
+typedEmitter.emit(emptyEvent);
+typedEmitter.emitSerial(emptyEvent);
+`;
+	const options = {
+		noEmit: true,
+		strict: true,
+		module: typescript.ModuleKind.CommonJS,
+		moduleResolution: typescript.ModuleResolutionKind.NodeJs,
+		target: typescript.ScriptTarget.ES2018,
+		types: []
+	};
+	const host = typescript.createCompilerHost(options);
+	const getSourceFile = host.getSourceFile.bind(host);
+	const fileExists = host.fileExists.bind(host);
+	const readFile = host.readFile.bind(host);
+	host.getSourceFile = (name, languageVersion, onError, shouldCreateNewSourceFile) => name === fileName ? typescript.createSourceFile(name, source, languageVersion) : getSourceFile(name, languageVersion, onError, shouldCreateNewSourceFile);
+	host.fileExists = name => name === fileName || fileExists(name);
+	host.readFile = name => name === fileName ? source : readFile(name);
+	const program = typescript.createProgram([fileName], options, host);
+	t.deepEqual(typescript.getPreEmitDiagnostics(program), []);
+});
