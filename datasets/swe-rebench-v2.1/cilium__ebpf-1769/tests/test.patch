+func TestBpf2goGeneratedStructCompiles(t *testing.T) {
+	_, source, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("can't locate repository")
+	}
+	repo := filepath.Dir(filepath.Dir(source))
+	work := t.TempDir()
+	generatedDir := filepath.Join(work, "generated")
+	if err := os.Mkdir(generatedDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+
+	helper := `package main
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"github.com/cilium/ebpf/btf"
+	"github.com/cilium/ebpf/cmd/bpf2go/gen"
+)
+func main() {
+	var output bytes.Buffer
+	err := gen.Generate(gen.GenerateArgs{
+		Package: "generated",
+		Stem: "test",
+		ObjectFile: "object.o",
+		Types: []btf.Type{&btf.Struct{Name: "sample", Size: 4, Members: []btf.Member{{Name: "Value", Type: &btf.Int{Size: 4}}}}},
+		Output: &output,
+	})
+	if err != nil { panic(err) }
+	if err := os.WriteFile(filepath.Join(os.Args[1], "generated.go"), output.Bytes(), 0600); err != nil { panic(err) }
+}
+`
+	helperPath := filepath.Join(work, "generate.go")
+	if err := os.WriteFile(helperPath, []byte(helper), 0600); err != nil {
+		t.Fatal(err)
+	}
+	generate := exec.Command("go", "run", helperPath, generatedDir)
+	generate.Dir = repo
+	if output, err := generate.CombinedOutput(); err != nil {
+		t.Fatalf("generate source: %v\n%s", err, output)
+	}
+	generated, err := os.ReadFile(filepath.Join(generatedDir, "generated.go"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(generated), "structs.HostLayout") {
+		t.Fatal("generated struct is missing the HostLayout marker")
+	}
+	if err := os.WriteFile(filepath.Join(generatedDir, "object.o"), nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	mod := "module generated\n\ngo 1.23.0\n\nrequire github.com/cilium/ebpf v0.0.0\n\nreplace github.com/cilium/ebpf => " + repo + "\n"
+	if err := os.WriteFile(filepath.Join(generatedDir, "go.mod"), []byte(mod), 0600); err != nil {
+		t.Fatal(err)
+	}
+	compile := exec.Command("go", "test", "./...")
+	compile.Dir = generatedDir
+	compile.Env = append(os.Environ(), "GOWORK=off", "GOFLAGS=-mod=mod")
+	if output, err := compile.CombinedOutput(); err != nil {
+		t.Fatalf("compile generated source: %v\n%s", err, output)
+	}
+}
