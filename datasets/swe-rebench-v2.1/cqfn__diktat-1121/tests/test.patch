+    @Test
+    fun `should fix long inline comments`() {
+        val expected = readResource("LongInlineCommentsExpected.kt")
+        val actual = formatResource("LongInlineCommentsTest.kt")
+        Assertions.assertEquals(
+            expected.normalizeIndentation().ignoreCallTrailingComma(),
+            actual.normalizeIndentation().ignoreCallTrailingComma(),
+            "Long inline comments should be moved above their statements"
+        )
+    }
+
+    @Test
+    fun `should preserve the trailing comma shown in the multiline call example`() {
+        val longComment = "f".repeat(180)
+        val source = """
+            fun foobar() {
+                foo(
+                    bar() // $longComment
+                )
+            }
+        """.trimIndent()
+        val config = rulesConfigListLineLength + listOf(
+            RulesConfig(TRAILING_COMMA.name, true, mapOf("valueArgument" to "true")),
+            RulesConfig(DIKTAT_COMMON, true, mapOf("kotlinVersion" to "1.4.21"))
+        )
+        val actual = format(
+            { configuredRules ->
+                object : RuleSetProvider {
+                    override fun get() = RuleSet(
+                        "test",
+                        LineLength(configuredRules ?: emptyList()),
+                        TrailingCommaRule(configuredRules ?: emptyList())
+                    )
+                }
+            },
+            source,
+            "PublicExample1.kt",
+            config
+        )
+        val lines = actual.lines().map { it.trim() }
+        val commentLine = lines.indexOf("// $longComment")
+        val barLine = lines.indexOf("bar(),")
+
+        Assertions.assertTrue(
+            commentLine >= 0 && barLine > commentLine,
+            "The relocated comment must precede bar(), with the example's trailing comma preserved"
+        )
+    }
+
+    private fun readResource(fileName: String): String =
+        File(javaClass.classLoader.getResource("$resourceFilePath/$fileName")!!.file).readText()
+
+    private fun formatResource(fileName: String): String {
+        val text = readResource(fileName)
+        return format({ config -> DiktatRuleSetProvider4Test(::LineLength, config) }, text, fileName, rulesConfigListLineLength)
+    }
+
+    /**
+     * The public contract only requires that overlong inline comments are moved above their
+     * statements while preserving the code; the exact indentation of the moved code is not
+     * specified, so it is ignored when comparing.
+     */
+    private fun String.normalizeIndentation(): String =
+        lines().joinToString("\n") { it.trimStart() }
+
+    private fun String.ignoreCallTrailingComma(): String =
+        lines().joinToString("\n") { line ->
+            val trimmed = line.trimEnd()
+            if (trimmed.endsWith("(),")) trimmed.dropLast(1) else trimmed
+        }
