+package day225
+
+import "testing"
+
+var testcases = []struct {
+	n, k, survivor int
+}{
+	{5, 2, 3},
+	{41, 2, 19},
+	{5, 3, 4},
+	{1, 100, 1},
+}
+
+func TestJosephusGeneral(t *testing.T) {
+	t.Parallel()
+	for _, tc := range testcases {
+		if survivor := JosephusGeneral(tc.n, tc.k); survivor != tc.survivor {
+			t.Errorf("Given N=%d, k=%d, expected %d, got %d", tc.n, tc.k, tc.survivor, survivor)
+		}
+	}
+}
+
+func TestJosephusKTwoLargeN(t *testing.T) {
+	// This input is practical for a logarithmic method but not for a recurrence
+	// that performs one step for every prisoner.
+	const n = (1 << 30) + 12345
+	const want = 24691
+	if got := JosephusGeneral(n, 2); got != want {
+		t.Fatalf("JosephusGeneral(%d, 2) = %d, want %d", n, got, want)
+	}
+}
