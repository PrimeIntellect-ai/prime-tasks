+    @Test
+    fun `x-extensible-enum definitions are strings by default and can be enabled as enums`() {
+        val tempDir = Files.createTempDirectory("fabrikt-extensible-enums")
+        val apiFile = tempDir.resolve("api.yaml")
+        Files.write(apiFile, """
+            openapi: 3.0.0
+            info:
+              title: extensible enums
+              version: 1.0.0
+            paths: {}
+            components:
+              schemas:
+                Holder:
+                  type: object
+                  properties:
+                    status:
+                      ${'$'}ref: '#/components/schemas/Status'
+                Status:
+                  type: string
+                  x-extensible-enum:
+                    - active
+                    - inactive
+        """.trimIndent().toByteArray())
+
+        fun generate(outputDir: Path, option: String? = null): String {
+            val args = mutableListOf(
+                "--base-package", "examples.enumexamples",
+                "--api-file", apiFile.toString(),
+                "--output-directory", outputDir.toString(),
+                "--targets", "HTTP_MODELS"
+            )
+            if (option != null) {
+                args.add("--http-model-opts")
+                args.add(option)
+            }
+            CodeGen.main(args.toTypedArray())
+            return Files.walk(outputDir).use { files ->
+                files.filter { it.toString().endsWith(".kt") }
+                    .map { it.toFile().readText() }
+                    .collect(Collectors.joining("\n"))
+            }
+        }
+
+        val defaults = generate(tempDir.resolve("default"))
+        assertThat(defaults)
+            .contains("val status: String?")
+            .doesNotContain("enum class Status")
+
+        val enabledOption = ModelCodeGenOptionType.values()
+            .firstOrNull { it.name == "X_EXTENSIBLE_ENUMS" }?.name ?: "X_EXTENSIBLE_ENUMS"
+        generate(tempDir.resolve("extensible-enums-configured"), enabledOption)
+        val enumOptionOutput = generate(tempDir.resolve("extensible-enums-enabled"), enabledOption)
+        assertThat(enumOptionOutput)
+            .contains("enum class Status")
+            .contains("val status: Status?")
+            .contains("active")
+            .contains("inactive")
+    }
+
