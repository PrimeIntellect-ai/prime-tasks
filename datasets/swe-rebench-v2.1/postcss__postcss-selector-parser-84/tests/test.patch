+
+test('selector created with spaces keeps them when appended', (t) => {
+    let appendedSelector;
+    parser((selectors) => {
+        appendedSelector = parser.selector({
+            spaces: {before: ' ', after: ' '},
+        });
+        appendedSelector.append(parser.tag({value: 'span'}));
+        selectors.append(appendedSelector);
+    }).process('div');
+    t.deepEqual(appendedSelector.spaces, {before: ' ', after: ' '});
+});
