--- a/tests/test_strtree.py
+++ b/tests/test_strtree.py
@@ -177,3 +177,37 @@ def test_nearest_items(geoms, items):
     with pytest.warns(ShapelyDeprecationWarning):
         tree = STRtree(geoms, items)
     assert tree.nearest_item(None) is None
+
+
+@pytest.mark.skipif(geos_version < (3, 6, 0), reason="GEOS 3.6.0 required")
+def test_nearest_exclusive():
+    geoms = [
+        Point(0, 0.5),
+        Polygon([(1, 0), (2, 0), (2, 1), (1, 1)]),
+        Polygon([(0, 2), (1, 2), (1, 3), (0, 3)]),
+    ]
+    with pytest.warns(ShapelyDeprecationWarning):
+        tree = STRtree(geoms)
+
+    assert tree.nearest(Point(0, 0.5), exclusive=True).equals(geoms[1])
+
+
+@pytest.mark.skipif(geos_version < (3, 6, 0), reason="GEOS 3.6.0 required")
+def test_nearest_exclusive_can_find_first_and_second_distinct_points():
+    origin = Point(0, 0)
+    points = [origin, Point(1, 1), Point(2, 2)]
+    with pytest.warns(ShapelyDeprecationWarning):
+        tree = STRtree(points)
+
+    first = tree.nearest(origin, exclusive=True)
+    assert first.equals(Point(1, 1))
+
+    # Exclude the origin and the result already found to search the same
+    # origin for the next distinct point.
+    remaining = [
+        point for point in points if not point.equals(origin) and not point.equals(first)
+    ]
+    with pytest.warns(ShapelyDeprecationWarning):
+        remaining_tree = STRtree(remaining)
+    second = remaining_tree.nearest(origin)
+    assert second.equals(Point(2, 2))
