+func TestParseGoLock_Replacements_NoVersion(t *testing.T) {
+	t.Parallel()
+
+	packages, err := lockfile.ParseGoLock("fixtures/go/replace-no-version.mod")
+
+	if err != nil {
+		t.Errorf("Got unexpected error: %v", err)
+	}
+
+	want := lockfile.PackageDetails{
+		Name:      "example.com/fork/net",
+		Version:   "1.4.5",
+		Ecosystem: lockfile.GoEcosystem,
+		CompareAs: lockfile.GoEcosystem,
+	}
+	if len(packages) == 0 {
+		t.Fatal("expected replacement package")
+	}
+	for _, pkg := range packages {
+		if pkg != want {
+			t.Errorf("expected replacement package %v, got %v", want, pkg)
+		}
+	}
+}
