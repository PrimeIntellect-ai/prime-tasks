+func Test_GoogleUnencryptedDiskWarningIdentifiesGeneratedKey(t *testing.T) {
+	source := `
+resource "google_compute_disk" "my-disk" {
+}`
+	results := scanHCL(source, t)
+	for _, res := range results {
+		if res.RuleID == rules.GoogleUnencryptedDisk {
+			description := strings.ToLower(res.Description)
+			if !strings.Contains(description, "generat") || !strings.Contains(description, "key") {
+				t.Errorf("GCP001 warning should identify its reliance on a generated key, got %q", res.Description)
+			}
+			return
+		}
+	}
+	t.Fatal("expected GCP001 warning for disk without a disk_encryption_key block")
+}
