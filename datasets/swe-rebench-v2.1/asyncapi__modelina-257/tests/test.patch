@@ -0,0 +1,40 @@
+import { Interpreter } from '../../../src/interpreter/Interpreter';
+
+describe('Interpretation of additionalItems', () => {
+  test('represents a schema for additional array items', () => {
+    const model = new Interpreter().interpret({
+      type: 'array',
+      additionalItems: { type: 'string' }
+    });
+
+    expect((model as any)?.additionalItems).toBeDefined();
+    expect((model as any)?.additionalItems?.type).toEqual('string');
+  });
+
+  test('represents additional items after the declared tuple items', () => {
+    const model = new Interpreter().interpret({
+      type: 'array',
+      items: [{ type: 'number' }],
+      additionalItems: { type: 'string' }
+    });
+
+    expect(model?.items).toHaveLength(1);
+    expect((model as any)?.additionalItems?.type).toEqual('string');
+  });
+
+  test('uses the permissive schema when additionalItems is absent', () => {
+    const model = new Interpreter().interpret({ type: 'array' });
+
+    expect((model as any)?.additionalItems).toBeDefined();
+    expect((model as any)?.additionalItems?.type).toEqual(expect.arrayContaining(['object', 'string', 'number', 'array', 'boolean', 'null', 'integer']));
+  });
+
+  test('does not attach additional items to a non-array model', () => {
+    const model = new Interpreter().interpret({
+      type: 'string',
+      additionalItems: { type: 'number' }
+    });
+
+    expect((model as any)?.additionalItems).toBeUndefined();
+  });
+});
