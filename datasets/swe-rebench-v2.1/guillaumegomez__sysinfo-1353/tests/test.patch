+// This test ensures that `refresh_processes_specifics` can remove a dead process when
+// requested, and keeps it otherwise.
+#[test]
+fn test_refresh_process_specifics_removes_dead_process() {
+    if !sysinfo::IS_SUPPORTED_SYSTEM || cfg!(feature = "apple-sandbox") {
+        return;
+    }
+    let mut p = start_proc!("300", "RefreshProcessSpecificsRemove");
+
+    let pid = Pid::from_u32(p.id() as _);
+    std::thread::sleep(std::time::Duration::from_secs(1));
+
+    let mut s = System::new();
+    let refresh_kind = ProcessRefreshKind::new();
+    s.refresh_processes_specifics(ProcessesToUpdate::Some(&[pid]), false, refresh_kind);
+    assert!(s.process(pid).is_some());
+
+    p.kill().expect("Unable to kill process.");
+    // We need this, otherwise the process will still be around as a zombie on linux.
+    let _ = p.wait();
+    // Let's give some time to the system to clean up...
+    std::thread::sleep(std::time::Duration::from_secs(1));
+
+    // Without removal, the dead process stays in the list.
+    assert_eq!(
+        s.refresh_processes_specifics(ProcessesToUpdate::Some(&[pid]), false, refresh_kind),
+        0
+    );
+    assert!(s.process(pid).is_some());
+
+    // With removal, the dead process is removed.
+    assert_eq!(
+        s.refresh_processes_specifics(ProcessesToUpdate::Some(&[pid]), true, refresh_kind),
+        0
+    );
+    assert!(s.process(pid).is_none());
 }
 
