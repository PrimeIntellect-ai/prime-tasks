--- a/tests/selectors_test.py
+++ b/tests/selectors_test.py
@@ -1,3 +1,5 @@
+from __future__ import annotations
+
 from typing import Any
 
 import pandas as pd
@@ -61,3 +63,46 @@ def test_categorical() -> None:
     result = nw.to_native(df.select(categorical()))
     expected = {"b": ["a", "b", "c"]}
     compare_dicts(result, expected)
+
+
+@pytest.mark.parametrize("constructor", [pd.DataFrame, pl.DataFrame])
+@pytest.mark.parametrize(
+    ("selector", "expected"),
+    [
+        (numeric() | boolean(), ["a", "c", "d"]),
+        (numeric() & boolean(), []),
+        (numeric() & by_dtype(nw.Int64), ["a"]),
+        (numeric() | by_dtype(nw.Int64), ["a", "c"]),
+        (~numeric(), ["b", "d"]),
+        (boolean() & True, ["d"]),
+        (boolean() | True, ["d"]),
+        (numeric() - 1, ["a", "c"]),
+        (numeric() - by_dtype(nw.Int64), ["c"]),
+    ],
+)
+def test_set_ops(
+    constructor: Any, selector: nw.selectors.Selector, expected: list[str]
+) -> None:
+    df = nw.from_native(constructor(data))
+    result = df.select(selector).columns
+    assert sorted(result) == expected
+
+
+@pytest.mark.parametrize("constructor", [pd.DataFrame, pl.DataFrame])
+def test_all(constructor: Any) -> None:
+    from narwhals.selectors import all
+
+    df = nw.from_native(constructor(data))
+    result = df.select(all()).columns
+    assert sorted(result) == ["a", "b", "c", "d"]
+
+
+def test_set_ops_return_selector() -> None:
+    from narwhals.selectors import Selector
+    from narwhals.selectors import all
+
+    assert isinstance(numeric() | boolean(), Selector)
+    assert isinstance(numeric() & boolean(), Selector)
+    assert isinstance(numeric() - by_dtype(nw.Int64), Selector)
+    assert isinstance(~numeric(), Selector)
+    assert isinstance(all(), Selector)
