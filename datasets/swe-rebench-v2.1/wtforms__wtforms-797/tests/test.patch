+++ b/tests/validators/test_disabled.py
@@ -0,0 +1,42 @@
+from tests.common import DummyPostData
+
+from wtforms import Form
+from wtforms import IntegerField
+from wtforms import SelectField
+from wtforms import StringField
+from wtforms.validators import disabled
+
+
+def test_disabled():
+    class F(Form):
+        value = StringField(validators=[disabled()])
+
+    form = F(value="foobar")
+    assert "disabled" in form.value()
+    assert form.validate()
+
+    form = F(DummyPostData(value=["submitted"]))
+    assert not form.validate()
+
+
+def test_disabled_on_numeric_field():
+    class F(Form):
+        value = IntegerField(validators=[disabled()])
+
+    form = F(value=3)
+    assert "disabled" in form.value()
+
+    form = F(DummyPostData(value=["12"]))
+    assert not form.validate()
+
+
+def test_disabled_on_select_field():
+    class F(Form):
+        value = SelectField(choices=[("a", "A"), ("b", "B")], validators=[disabled()])
+
+    form = F(value="a")
+    assert "disabled" in form.value()
+    assert form.validate()
+
+    form = F(DummyPostData(value=["a"]))
+    assert not form.validate()
diff --git a/tests/validators/test_readonly.py b/tests/validators/test_readonly.py
new file mode 100644
index 0000000..832d0ec
--- /dev/null
+++ b/tests/validators/test_readonly.py
@@ -0,0 +1,98 @@
+from datetime import date
+from decimal import Decimal
+
+from tests.common import DummyPostData
+
+from wtforms import DateField
+from wtforms import DecimalField
+from wtforms import Form
+from wtforms import IntegerField
+from wtforms import PasswordField
+from wtforms import StringField
+from wtforms import TextAreaField
+from wtforms.validators import readonly
+
+
+def test_readonly():
+    class F(Form):
+        value = StringField(validators=[readonly()])
+
+    form = F(value="foobar")
+    assert "readonly" in form.value()
+    assert form.validate()
+
+    form = F(DummyPostData(value=["foobar"]), data={"value": "foobar"})
+    assert form.validate()
+
+    form = F(DummyPostData(value=["foobarbaz"]), data={"value": "foobar"})
+    valid = form.validate()
+    assert not valid or form.value.data == "foobar"
+
+
+def test_readonly_with_default():
+    class F(Form):
+        value = StringField(validators=[readonly()], default="foobar")
+
+    form = F(DummyPostData(value=["foobar"]))
+    assert form.validate()
+
+    form = F(DummyPostData(value=["foobarbaz"]))
+    valid = form.validate()
+    assert not valid or form.value.data == "foobar"
+
+
+def test_readonly_text_area_rendering_and_protection():
+    class F(Form):
+        value = TextAreaField(validators=[readonly()])
+
+    form = F(value="original")
+    assert "readonly" in form.value()
+
+    form = F(DummyPostData(value=["changed"]), data={"value": "original"})
+    valid = form.validate()
+    assert not valid or form.value.data == "original"
+
+
+def test_readonly_integer_field_protection():
+    class F(Form):
+        value = IntegerField(validators=[readonly()])
+
+    form = F(DummyPostData(value=["2"]), data={"value": 1})
+    valid = form.validate()
+    assert not valid or form.value.data == 1
+
+
+def test_readonly_numeric_field_rendering_and_protection():
+    class F(Form):
+        value = DecimalField(validators=[readonly()])
+
+    form = F(value=Decimal("1.25"))
+    assert "readonly" in form.value()
+
+    form = F(DummyPostData(value=["2.50"]), data={"value": Decimal("1.25")})
+    valid = form.validate()
+    assert not valid or form.value.data == Decimal("1.25")
+
+
+def test_readonly_password_field_rendering_and_protection():
+    class F(Form):
+        value = PasswordField(validators=[readonly()])
+
+    form = F(value="original")
+    assert "readonly" in form.value()
+
+    form = F(DummyPostData(value=["changed"]), data={"value": "original"})
+    valid = form.validate()
+    assert not valid or form.value.data == "original"
+
+
+def test_readonly_date_field_rendering_and_protection():
+    class F(Form):
+        value = DateField(validators=[readonly()])
+
+    form = F(value=date(2024, 1, 1))
+    assert "readonly" in form.value()
+
+    form = F(DummyPostData(value=["2024-01-02"]), data={"value": date(2024, 1, 1)})
+    valid = form.validate()
+    assert not valid or form.value.data == date(2024, 1, 1)
