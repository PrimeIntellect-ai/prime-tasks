diff --git a/test/arguments.js b/test/arguments.js
index 6546888..ec41e57 100644
--- a/test/arguments.js
+++ b/test/arguments.js
@@ -1,9 +1,11 @@
 import {URL} from 'universal-url';
 import test from 'ava';
+import pEvent from 'p-event';
 import got from '..';
 import {createServer} from './helpers/server';
 
 let s;
+let streamAttempts = 0;
 
 test.before('setup', async () => {
 	s = await createServer();
@@ -21,6 +23,23 @@ test.before('setup', async () => {
 		res.end(req.url);
 	});
 
+	s.on('/stream', (req, res) => {
+		res.end('ok');
+	});
+
+	s.on('/stream-retry', (req, res) => {
+		if (streamAttempts++ === 0) {
+			setTimeout(() => res.end('late response'), 100);
+			return;
+		}
+
+		res.end('retried');
+	});
+
+	s.on('/stream-timeout', (req, res) => {
+		setTimeout(() => res.end('too late'), 100);
+	});
+
 	await s.listen(s.port);
 });
 
@@ -81,6 +100,45 @@ test('WHATWG URL support', async t => {
 	await t.notThrows(got(wURL));
 });
 
+test('should return streams when using stream option', async t => {
+	const stream = got(`${s.url}/stream`, {stream: true});
+	const responsePromise = pEvent(stream, 'response');
+	const dataPromise = pEvent(stream, 'data');
+	const [response, data] = await Promise.all([responsePromise, dataPromise]);
+	t.is(response.statusCode, 200);
+	t.is(data.toString(), 'ok');
+});
+
+test('should not allow stream and JSON option at the same time', async t => {
+	await t.throws(got(`${s.url}/stream`, {stream: true, json: true}));
+});
+
+test('stream option retries after a socket timeout', async t => {
+	streamAttempts = 0;
+	const stream = got(`${s.url}/stream-retry`, {
+		stream: true,
+		timeout: {socket: 20},
+		retries: iter => iter === 1 ? 1 : 0
+	});
+	const responsePromise = pEvent(stream, 'response');
+	const dataPromise = pEvent(stream, 'data');
+	const [response, data] = await Promise.all([responsePromise, dataPromise]);
+
+	t.is(response.statusCode, 200);
+	t.is(data.toString(), 'retried');
+	t.is(streamAttempts, 2);
+});
+
+test('stream option honors request timeout', async t => {
+	const stream = got(`${s.url}/stream-timeout`, {
+		stream: true,
+		timeout: {request: 20},
+		retries: 0
+	});
+	await t.throws(pEvent(stream, 'response'));
+});
+
+
 test.after('cleanup', async () => {
 	await s.close();
 });
