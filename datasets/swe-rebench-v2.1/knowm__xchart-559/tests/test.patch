+package org.knowm.xchart;
+
+import java.awt.Color;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import javax.imageio.ImageIO;
+import org.junit.Assert;
+import org.junit.Test;
+
+public class AnnotationLineTest {
+
+  private static XYChart newChart() {
+    double[] xData = new double[] {0.0, 1.0, 2.0};
+    double[] yData = new double[] {2.0, 1.0, 0.0};
+    return QuickChart.getChart("Sample Chart", "X", "Y", "y(x)", xData, yData);
+  }
+
+  private static BufferedImage render(XYChart chart) throws IOException {
+    OutputStream output = new ByteArrayOutputStream();
+    BitmapEncoder.saveBitmap(chart, output, BitmapEncoder.BitmapFormat.PNG);
+    return ImageIO.read(new ByteArrayInputStream(((ByteArrayOutputStream) output).toByteArray()));
+  }
+
+  @Test
+  public void annotationLineShouldNotSpanOverWholeWidth() throws IOException {
+    // given
+    XYChart chart = newChart();
+
+    // when
+    AnnotationLine annotation = new AnnotationLine(0.5d, false, false);
+    chart.addAnnotation(annotation);
+    render(chart);
+
+    // test
+    Assert.assertTrue(annotation.getBounds().getX() > 50);
+    Assert.assertTrue(annotation.getBounds().getWidth() < 500);
+  }
+
+  @Test
+  public void verticalAnnotationLineIsDrawnVertically() throws IOException {
+    // given
+    XYChart chart = newChart();
+
+    // when
+    AnnotationLine vertical = new AnnotationLine(0.5d, true, false);
+    AnnotationLine horizontal = new AnnotationLine(0.5d, false, false);
+    chart.addAnnotation(vertical);
+    chart.addAnnotation(horizontal);
+    render(chart);
+
+    // test: a vertical line has a narrow bounding box, a horizontal line a wide one
+    Assert.assertTrue(vertical.getBounds().getWidth() < horizontal.getBounds().getWidth());
+  }
+
+  @Test
+  public void verticalAnnotationStaysInsidePlotSurface() throws IOException {
+    XYChart chart = newChart();
+    chart.getStyler().setAnnotationLineColor(Color.MAGENTA);
+    AnnotationLine vertical = new AnnotationLine(0.5d, true, false);
+    AnnotationLine horizontal = new AnnotationLine(0.5d, false, false);
+    chart.addAnnotation(vertical);
+    chart.addAnnotation(horizontal);
+
+    BufferedImage image = render(chart);
+    int x = (int) vertical.getBounds().getX();
+    int annotationColor = Color.MAGENTA.getRGB();
+
+    boolean visibleInside = false;
+    for (int y = 10; y < image.getHeight() - 10; y++) {
+      if (image.getRGB(x, y) == annotationColor) {
+        visibleInside = true;
+        break;
+      }
+    }
+    Assert.assertTrue("vertical annotation should be visible in the plot", visibleInside);
+    for (int y = 0; y < 10; y++) {
+      Assert.assertTrue(
+          "vertical annotation must not reach above the plot",
+          image.getRGB(x, y) != annotationColor);
+    }
+    for (int y = image.getHeight() - 10; y < image.getHeight(); y++) {
+      Assert.assertTrue(
+          "vertical annotation must not reach below the plot",
+          image.getRGB(x, y) != annotationColor);
+    }
+
+    int horizontalY = (int) horizontal.getBounds().getY();
+    boolean horizontalVisibleInside = false;
+    for (int pixelX = 10; pixelX < image.getWidth() - 10; pixelX++) {
+      if (image.getRGB(pixelX, horizontalY) == annotationColor) {
+        horizontalVisibleInside = true;
+        break;
+      }
+    }
+    Assert.assertTrue("horizontal annotation should be visible in the plot", horizontalVisibleInside);
+    for (int pixelX = 0; pixelX < 10; pixelX++) {
+      Assert.assertTrue(
+          "horizontal annotation must not reach left of the plot",
+          image.getRGB(pixelX, horizontalY) != annotationColor);
+    }
+    for (int pixelX = image.getWidth() - 10; pixelX < image.getWidth(); pixelX++) {
+      Assert.assertTrue(
+          "horizontal annotation must not reach right of the plot",
+          image.getRGB(pixelX, horizontalY) != annotationColor);
+    }
+  }
+
+  @Test
+  public void chartSpaceValuesControlLinePositions() throws IOException {
+    XYChart chart = newChart();
+    AnnotationLine lowerX = new AnnotationLine(0.5d, true, false);
+    AnnotationLine higherX = new AnnotationLine(1.5d, true, false);
+    AnnotationLine lowerY = new AnnotationLine(0.5d, false, false);
+    AnnotationLine higherY = new AnnotationLine(1.5d, false, false);
+    chart.addAnnotation(lowerX);
+    chart.addAnnotation(higherX);
+    chart.addAnnotation(lowerY);
+    chart.addAnnotation(higherY);
+
+    render(chart);
+
+    Assert.assertTrue(
+        "larger chart-space x values must appear farther right",
+        lowerX.getBounds().getX() < higherX.getBounds().getX());
+    Assert.assertTrue(
+        "larger chart-space y values must appear higher on screen",
+        lowerY.getBounds().getY() > higherY.getBounds().getY());
+  }
+
+  @Test
+  public void screenSpaceValueIsInterpretedAsScreenCoordinate() throws IOException {
+    // given
+    XYChart chart = newChart();
+
+    // when
+    AnnotationLine horizontal = new AnnotationLine(100d, false, true);
+    AnnotationLine vertical = new AnnotationLine(100d, true, true);
+    chart.addAnnotation(horizontal);
+    chart.addAnnotation(vertical);
+    render(chart);
+
+    // test: the value is a pixel coordinate, not a chart-space value
+    Assert.assertEquals(chart.getHeight() - 100d, horizontal.getBounds().getY(), 1.0);
+    Assert.assertEquals(100d, vertical.getBounds().getX(), 1.0);
+  }
+}
