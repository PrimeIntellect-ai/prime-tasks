+        # A trailing `#` at end of input (with or without comment text) must
+        # leave `let` unclosed, i.e. incomplete rather than a parse error.
+        for str in ["let x = 1 #", "let x = 1 # comment"]
+            ex = JuliaSyntax.core_parser_hook(str, "somefile", 1, 0, :statement)[1]
+            @test Base.incomplete_tag(ex) != :none
+            ex = JuliaSyntax.core_parser_hook(str, "somefile", 1, 0, :all)[1]
+            @test ex.head == :toplevel
+            @test Base.incomplete_tag(ex.args[end]) != :none
+        end
         # Should not throw
         @test JuliaSyntax.core_parser_hook("+=", "somefile", 1, 0, :statement)[1] isa Expr
     end
