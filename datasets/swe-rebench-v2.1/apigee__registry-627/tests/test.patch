+
+// TestServerMaintainsStorageConnection verifies that a server keeps its
+// database connection open for its lifetime instead of opening a new
+// connection for each request. A shared in-memory database only survives while
+// a connection to it is held open, so a server that opens and closes a
+// connection per request loses the schema created during setup.
+func TestServerMaintainsStorageConnection(t *testing.T) {
+	ctx := context.Background()
+	server, err := New(Config{
+		Database: "sqlite3",
+		DBConfig: "file:reuse_test?mode=memory&cache=shared",
+	})
+	if err != nil {
+		t.Fatalf("Setup: failed to create server: %s", err)
+	}
+
+	if _, err := server.CreateProject(ctx, &rpc.CreateProjectRequest{
+		ProjectId: "reuse",
+		Project:   &rpc.Project{},
+	}); err != nil {
+		t.Errorf("CreateProject failed: %s", err)
+	}
+}
+
+// TestServerCloseReleasesStorage verifies that closing a server releases the
+// underlying storage connection so that it can no longer be used.
+func TestServerCloseReleasesStorage(t *testing.T) {
+	ctx := context.Background()
+	server, err := New(Config{
+		Database: "sqlite3",
+		DBConfig: "file:close_test?mode=memory&cache=shared",
+	})
+	if err != nil {
+		t.Fatalf("Setup: failed to create server: %s", err)
+	}
+
+	if _, err := server.CreateProject(ctx, &rpc.CreateProjectRequest{
+		ProjectId: "close",
+		Project:   &rpc.Project{},
+	}); err != nil {
+		t.Fatalf("CreateProject failed: %s", err)
+	}
+
+	closer, ok := interface{}(server).(interface{ Close() })
+	if !ok {
+		t.Fatalf("RegistryServer must provide a Close method")
+	}
+	closer.Close()
+
+	if _, err := server.CreateProject(ctx, &rpc.CreateProjectRequest{
+		ProjectId: "after-close",
+		Project:   &rpc.Project{},
+	}); err == nil {
+		t.Errorf("CreateProject succeeded after Close: storage connection was not released")
+	}
+}
