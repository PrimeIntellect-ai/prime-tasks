+
+describe('donejs add app <folder> --yes', function() {
+  var rootDir = path.join(__dirname, '..');
+  var folder = 'add-app-yes-project';
+  var realExit;
+  var initBinaryCall;
+
+  beforeEach(function() {
+    process.chdir(rootDir);
+    deleteFolder();
+
+    realExit = process.exit;
+    process.exit = function(code) {
+      throw new Error('donejs exited with code ' + code +
+        ' instead of running the command');
+    };
+
+    initBinaryCall = Q.defer();
+
+    mockery.enable({
+      useCleanCache: true,
+      warnOnUnregistered: false
+    });
+
+    mockery.registerMock('../utils', {
+      mkdirp: utils.mkdirp,
+      log: function() {},
+      versionRange: function() { return 'latest'; },
+      spawn: function() { return Q(true); }
+    });
+
+    mockery.registerMock('./run-binary', function(args) {
+      initBinaryCall.resolve(args);
+      return Q(true);
+    });
+  });
+
+  afterEach(function() {
+    process.exit = realExit;
+    process.chdir(rootDir);
+    deleteFolder();
+    mockery.disable();
+    mockery.deregisterAll();
+  });
+
+  // runs the public `donejs` command program with the given arguments
+  function runDonejs(argv) {
+    var program = require('../lib/cli');
+    program.parse(['node', 'donejs'].concat(argv));
+  }
+
+  it('accepts --yes instead of rejecting it as an unknown option', function() {
+    runDonejs(['add', 'app', folder, '--yes']);
+
+    return initBinaryCall.promise.then(function(args) {
+      assert(includes(args, 'init'), 'should run donejs init');
+    });
+  });
+
+  it('passes --yes through to the donejs init command', function() {
+    runDonejs(['add', 'app', folder, '--yes']);
+
+    return initBinaryCall.promise.then(function(args) {
+      assert(includes(args, '--yes'), 'init should receive --yes');
+    });
+  });
+
+  it('does not pass --yes when the flag is omitted', function() {
+    runDonejs(['add', 'app', folder]);
+
+    return initBinaryCall.promise.then(function(args) {
+      assert(!includes(args, '--yes'), 'init should not receive --yes');
+    });
+  });
+
+  function deleteFolder() {
+    if (fs.existsSync(folder)) {
+      rimraf.sync(folder);
+    }
+  }
+
+  function includes(collection, value) {
+    return (collection || []).indexOf(value) !== -1;
+  }
 });
