+#[cfg(test)]
+mod tests {
+    use crate::db::ChalkDatabase;
+    use crate::interner::ChalkIr;
+    use crate::SolverChoice;
+    use chalk_ir::{FnSig, Safety};
+
+    fn assert_copy<T: Copy>() {}
+    fn assert_clone<T: Clone>() {}
+    fn assert_debug<T: std::fmt::Debug>() {}
+    fn assert_eq_hash<T: PartialEq + Eq + std::hash::Hash>() {}
+
+    #[test]
+    fn fn_sig_implements_expected_traits() {
+        assert_copy::<FnSig<ChalkIr>>();
+        assert_clone::<FnSig<ChalkIr>>();
+        assert_debug::<FnSig<ChalkIr>>();
+        assert_eq_hash::<FnSig<ChalkIr>>();
+    }
+
+    #[test]
+    fn fn_pointer_exposes_shared_signature() {
+        let pointer = chalk_ir::FnPointer::<ChalkIr> {
+            num_binders: 0,
+            sig: FnSig {
+                abi: <ChalkIr as chalk_ir::interner::Interner>::FnAbi::Rust,
+                safety: Safety::Safe,
+                variadic: false,
+            },
+            substitution: chalk_ir::Substitution::empty(&ChalkIr),
+        };
+
+        assert_eq!(
+            pointer.sig.abi,
+            <ChalkIr as chalk_ir::interner::Interner>::FnAbi::Rust
+        );
+        assert_eq!(pointer.sig.safety, Safety::Safe);
+        assert!(!pointer.sig.variadic);
+    }
+
+    #[test]
+    fn fn_def_uses_shared_signature() {
+        let db = ChalkDatabase::with("fn foo();", SolverChoice::default());
+        db.with_program(|program| {
+            let datum = program
+                .fn_def_data
+                .values()
+                .next()
+                .expect("expected a function definition");
+            let sig: &FnSig<ChalkIr> = &datum.sig;
+            assert_eq!(sig.safety, Safety::Safe);
+            assert!(!sig.variadic);
+        });
+    }
+}
