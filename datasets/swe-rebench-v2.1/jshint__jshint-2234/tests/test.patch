diff --git a/tests/unit/options.js b/tests/unit/options.js
index 21413d4..9e66d0b 100644
--- a/tests/unit/options.js
+++ b/tests/unit/options.js
@@ -2290,3 +2290,30 @@ exports.futureHostile = function (test) {
 
   test.done();
 };
+
+
+exports.varstmt = function (test) {
+  JSHINT(["var x;"]);
+  test.ok(!JSHINT.errors.some(function (error) {
+    return error && error.line === 1;
+  }), "varstmt warnings should be disabled by default");
+
+  var code = [
+    "var x;",
+    "var y = 5;",
+    "var fn = function() {",
+    "  var x;",
+    "  var y = 5;",
+    "};"
+  ];
+
+  JSHINT(code, { varstmt: true });
+
+  [1, 2, 3, 4, 5].forEach(function (line) {
+    test.ok(JSHINT.errors.some(function (error) {
+      return error && error.line === line;
+    }), "expected a warning for the var declaration on line " + line);
+  });
+
+  test.done();
+};
