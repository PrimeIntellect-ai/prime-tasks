+    def test_getmodified_falls_back_when_mdtm_is_unavailable(self):
+        self.fs.writetext("mtime-fallback.txt", "content")
+        self.fs.features.pop("MDTM", None)
+
+        ordinary_modified = self.fs.getinfo(
+            "mtime-fallback.txt", namespaces=["details"]
+        ).modified
+        self.assertIsNotNone(ordinary_modified)
+
+        source_fs = open_fs("mem://")
+        try:
+            source_fs.writetext("mtime-fallback.txt", "source")
+            source_fs.setinfo(
+                "mtime-fallback.txt", {"details": {"modified": 4102444800}}
+            )
+            copy_dir_if_newer(source_fs, "/", self.fs, "/")
+        finally:
+            source_fs.close()
+
+        self.assertEqual(self.fs.readtext("mtime-fallback.txt"), "source")
+
+    def test_copy_dir_if_newer_uses_mdtm_for_comparison(self):
+        self.assertIn("MDTM", self.fs.features)
+        source_fs = open_fs("mem://")
+        try:
+            source_fs.writetext("bar", "source")
+            source_fs.setinfo("bar", {"details": {"modified": 0}})
+            self.fs.writetext("bar", "destination")
+
+            commands = []
+            original_putcmd = self.fs.ftp.putcmd
+
+            def recording_putcmd(command):
+                commands.append(command)
+                return original_putcmd(command)
+
+            with mock.patch.object(self.fs.ftp, "putcmd", recording_putcmd):
+                copy_dir_if_newer(source_fs, "/", self.fs, "/")
+
+            command_names = [command.split()[0].upper() for command in commands]
+            self.assertIn("MDTM", command_names)
+            # The compared file itself must not be fetched with full information.
+            full_info_on_file = [
+                command
+                for command in commands
+                if command.split()[0].upper() in ("MLST", "LIST")
+                and command.split()[-1].endswith("bar")
+            ]
+            self.assertEqual(full_info_on_file, [])
+        finally:
+            source_fs.close()
+
