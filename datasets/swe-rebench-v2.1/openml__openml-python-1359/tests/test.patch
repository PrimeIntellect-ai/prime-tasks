+def test_openml_cache_dir_env_var(tmp_path: Path) -> None:
+    expected_path = tmp_path / "test-cache"
+    environment = os.environ.copy()
+    environment["OPENML_CACHE_DIR"] = str(expected_path)
+
+    result = subprocess.run(
+        [
+            sys.executable,
+            "-c",
+            "import openml.config; print(openml.config.get_cache_directory())",
+        ],
+        check=True,
+        capture_output=True,
+        text=True,
+        env=environment,
+    )
+
+    # The public getter gives the server-specific cache directory within the
+    # configured root cache directory.
+    assert Path(result.stdout.strip()).is_relative_to(expected_path.resolve())
