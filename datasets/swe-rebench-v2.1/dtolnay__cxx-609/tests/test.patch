+#[test]
+fn test_shared_ptr_weak_ptr() {
+    let shared_ptr = ffi::c_return_shared_ptr();
+    let weak_ptr = ffi::c_make_weak_ptr(&shared_ptr);
+    {
+        let locked = ffi::c_lock_weak_ptr(&weak_ptr);
+        assert!(!locked.is_null());
+    }
+
+    drop(shared_ptr);
+    assert!(ffi::c_lock_weak_ptr(&weak_ptr).is_null());
+
+    let shared_string = ffi::c_return_shared_ptr_string();
+    let weak_string = ffi::c_make_weak_string(&shared_string);
+    {
+        let locked = ffi::c_lock_weak_string(&weak_string);
+        assert!(!locked.is_null());
+    }
+
+    drop(shared_string);
+    assert!(ffi::c_lock_weak_string(&weak_string).is_null());
+}
