+// TestPostgresConnectionWithoutPort verifies that a PostgreSQL configuration
+// without an explicit port does not produce a connection string containing
+// ":0". The connection attempt is expected to fail (there is no database in
+// the test environment), but the failure must not be caused by an appended
+// zero port.
+func TestPostgresConnectionWithoutPort(t *testing.T) {
+	client := fake.NewSimpleClientset(&apiv1.Secret{
+		ObjectMeta: metav1.ObjectMeta{Name: "s", Namespace: "default"},
+		Data:       map[string][]byte{"user": []byte("u"), "pass": []byte("p")},
+	})
+	cfg := &config.PostgreSQLConfig{}
+	cfg.Host = "127.0.0.1"
+	cfg.Database = "db"
+	cfg.TableName = "t"
+	cfg.UsernameSecret = apiv1.SecretKeySelector{LocalObjectReference: apiv1.LocalObjectReference{Name: "s"}, Key: "user"}
+	cfg.PasswordSecret = apiv1.SecretKeySelector{LocalObjectReference: apiv1.LocalObjectReference{Name: "s"}, Key: "pass"}
+
+	_, _, err := sqldb.CreatePostGresDBSession(client, "default", cfg, nil)
+	if err != nil {
+		assert.NotContains(t, err.Error(), ":0")
+	}
 }
