+describe("migrate README", () => {
+	it("preserves the paragraph after the project logo and before the first h2", async () => {
+		const introParagraph = "Existing introduction paragraph.";
+		mockReadFileSafe.mockResolvedValueOnce(`<h1 align="center">Title</h1>
+
+<p align="center">Description.</p>
+
+<p align="center">
+(existing badges)
+</p>
+
+<img align="right" alt="Project logo: Test" src="./logo.png">
+
+Existing introduction
+paragraph.
+
+## Getting Started
+`);
+
+		await migrateWithOptions({ options: migrationOptions });
+
+		const writtenReadme = mockWriteFile.mock.calls.at(-1)?.[1] ?? "";
