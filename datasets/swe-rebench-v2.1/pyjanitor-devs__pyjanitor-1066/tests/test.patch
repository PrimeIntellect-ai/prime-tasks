+@pytest.mark.functions
+def test_default_case_sensitive(dataframe):
+    """Checks that omitting case_sensitive defaults to case-sensitive
+    counting.
+    """
+    dataframe["ccu"] = ["a", "b", "c", "A", "B", "C", "a", "b", "c"]
+    df = dataframe.count_cumulative_unique(
