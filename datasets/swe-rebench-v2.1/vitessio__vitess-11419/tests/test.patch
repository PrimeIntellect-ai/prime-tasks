+func TestRewritesScalarSubqueryWithSelectAlias(in *testing.T) {
+	// A scalar subquery in the SELECT list that references an earlier SELECT alias
+	// must not be unnested into a bare column reference: the alias is only in
+	// scope inside the subquery, so unnesting produces an invalid query.
+	// See https://github.com/vitessio/vitess/issues/11246
+	stmt, err := Parse("select 1 as formsTotal, (select formsTotal) as formsInFolderTotal")
+	require.NoError(in, err)
+
+	result, err := RewriteAST(stmt, "ks", SQLSelectLimitUnset, "", nil)
+	require.NoError(in, err)
+
+	sel, ok := result.AST.(*Select)
+	require.True(in, ok, "expected a Select, got %T", result.AST)
+	require.Len(in, sel.SelectExprs, 2)
+
+	second, ok := sel.SelectExprs[1].(*AliasedExpr)
+	require.True(in, ok, "expected an AliasedExpr, got %T", sel.SelectExprs[1])
+	_, isSubquery := second.Expr.(*Subquery)
+	assert.True(in, isSubquery, "the scalar subquery referencing the earlier alias must be preserved, got %q", String(result.AST))
+}
