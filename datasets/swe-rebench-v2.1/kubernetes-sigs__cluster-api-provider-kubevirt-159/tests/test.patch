+	usersFrom := func(generated []byte) *yaml.Node {
+		var document yaml.Node
+		Expect(yaml.Unmarshal(generated, &document)).To(Succeed())
+		root := document.Content[0]
+		var users *yaml.Node
+		usersFields := 0
+		for i := 0; i < len(root.Content); i += 2 {
+			if root.Content[i].Value == "users" {
+				usersFields++
+				users = root.Content[i+1]
+			}
+		}
+		Expect(usersFields).To(Equal(1))
+		Expect(users.Kind).To(Equal(yaml.SequenceNode))
+		return users
+	}
+	userField := func(user *yaml.Node, name string) *yaml.Node {
+		for i := 0; i < len(user.Content); i += 2 {
+			if user.Content[i].Value == name {
+				return user.Content[i+1]
+			}
+		}
+		return nil
+	}
+	userNamed := func(users *yaml.Node, name string) *yaml.Node {
+		for _, user := range users.Content {
+			if value := userField(user, "name"); value != nil && value.Value == name {
+				return user
+			}
+		}
+		return nil
+	}
+
+	It("generates one users field containing custom users and the CAPK account", func() {
+		generated := generateBootstrapUserData(`#cloud-config
+users:
+  - name: johndoe
+    group: users
+`)
+
+		users := usersFrom(generated)
+		Expect(users.Content).To(HaveLen(2))
+		Expect([]string{userField(users.Content[0], "name").Value, userField(users.Content[1], "name").Value}).To(ConsistOf("johndoe", "capk"))
+		capk := userNamed(users, "capk")
+		Expect(userField(capk, "gecos").Value).To(Equal("CAPK User"))
+		Expect(userField(capk, "sudo").Value).To(Equal("ALL=(ALL) NOPASSWD:ALL"))
+		Expect(userField(capk, "groups").Value).To(Equal("users, admin"))
+		keys := userField(capk, "ssh_authorized_keys")
+		Expect(keys.Kind).To(Equal(yaml.SequenceNode))
+		authorizedKeys := make([]string, 0, len(keys.Content))
+		for _, key := range keys.Content {
+			authorizedKeys = append(authorizedKeys, key.Value)
+		}
+		Expect(authorizedKeys).To(ContainElement("sha-rsa 1234"))
+	})
