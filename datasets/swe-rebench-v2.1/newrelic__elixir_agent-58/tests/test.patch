+  defp nested_query_segments?(segments) when is_list(segments) do
+    Enum.any?(segments, fn
+      [_, _, _, _, children | _] = segment ->
+        (segment_named?(segment, "ExternalService", "query") and
+           Enum.any?(children, &segment_named?(&1, "HelperModule", "function"))) or
+          nested_query_segments?(children)
+
+      _ ->
+        false
+    end)
+  end
+
+  defp segment_named?(segment, module_name, function_name) do
+    segment
+    |> Enum.filter(&is_binary/1)
+    |> Enum.join(".")
+    |> then(&(String.contains?(&1, module_name) and String.contains?(&1, function_name)))
+  end
