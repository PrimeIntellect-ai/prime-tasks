+#[test]
+fn large_arc_round_trip() {
+    let oid = ObjectIdentifier::new_unwrap("1.2.16384");
+    let decoded = ObjectIdentifier::from_bytes(oid.as_bytes()).unwrap();
+    assert_eq!(decoded.arc(2).unwrap(), 16384);
+
+    let oid = ObjectIdentifier::new_unwrap("1.2.128");
+    let decoded = ObjectIdentifier::from_bytes(oid.as_bytes()).unwrap();
+    assert_eq!(decoded.arc(2).unwrap(), 128);
+}
