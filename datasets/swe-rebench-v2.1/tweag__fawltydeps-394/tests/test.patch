+def test_fawltydeps_self_analysis__resolves_own_imports():
+    # FawltyDeps imports "pkg_resources", which is provided by the "setuptools"
+    # package. When FawltyDeps analyzes itself, this import must be resolved via
+    # the current Python environment (i.e. sys.path), so that "pkg_resources" is
+    # not reported as undeclared and "setuptools" is not reported as unused.
+    repo_root = Path(__file__).parent.parent
+    output, _errors, _returncode = run_fawltydeps_subprocess(
+        "--check",
+        "--json",
+        config_file=repo_root / "pyproject.toml",
+        cwd=repo_root,
+    )
+    result = json.loads(output)
+    assert result["undeclared_deps"] == []
+    assert "setuptools" not in {dep["name"] for dep in result["unused_deps"]}
+
