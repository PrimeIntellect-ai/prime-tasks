@@ -288,4 +289,84 @@ func TestOptions_OnDirExists(t *testing.T) {
 	b, err = ioutil.ReadFile("test/data.copy/case10/dest.3/" + "foo/" + "text_aaa")
 	Expect(t, err).ToBe(nil)
 	Expect(t, string(b)).ToBe("This is text_aaa from dest")
+
+	When(t, "PreserveTimes is true with Untouchable", func(t *testing.T) {
+		// Prepare a destination that already contains a "foo" directory
+		// but does not contain a "bar" directory yet.
+		err = Copy("test/data/case10/dest", "test/data.copy/case10/dest.4")
+		Expect(t, err).ToBe(nil)
+
+		opt := Options{
+			OnDirExists:   func(src, dest string) DirExistsAction { return Untouchable },
+			PreserveTimes: true,
+		}
+		// The copy must not leave the destination in a broken state: the
+		// subdirectory that did not exist yet has to be created and copied.
+		err = Copy("test/data/case10/src", "test/data.copy/case10/dest.4", opt)
+		Expect(t, err).ToBe(nil)
+
+		// The directory that already existed is left untouched.
+		b, err = ioutil.ReadFile("test/data.copy/case10/dest.4/foo/text_aaa")
+		Expect(t, err).ToBe(nil)
+		Expect(t, string(b)).ToBe("This is text_aaa from dest")
+
+		// The directory that did not exist is created and copied, even
+		// though OnDirExists returns Untouchable and PreserveTimes is set.
+		stat, err = os.Stat("test/data.copy/case10/dest.4/bar/text_ccc")
+		Expect(t, err).ToBe(nil)
+		Expect(t, stat).Not().ToBe(nil)
+	})
+}
+
+func TestUntouchablePreserveTimesCopiesMissingDirectoryContents(t *testing.T) {
+	root, err := ioutil.TempDir("", "copy-untouchable-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(root)
+
+	src := filepath.Join(root, "src")
+	dest := filepath.Join(root, "dest")
+	for _, dir := range []string{
+		filepath.Join(src, "foo"),
+		filepath.Join(src, "bar"),
+		filepath.Join(dest, "foo"),
+	} {
+		if err := os.MkdirAll(dir, 0755); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	const sourceExisting = "source version"
+	const destinationExisting = "destination version"
+	const missingContents = "contents from the missing directory"
+	if err := ioutil.WriteFile(filepath.Join(src, "foo", "text_aaa"), []byte(sourceExisting), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := ioutil.WriteFile(filepath.Join(dest, "foo", "text_aaa"), []byte(destinationExisting), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := ioutil.WriteFile(filepath.Join(src, "bar", "text_ccc"), []byte(missingContents), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	opt := Options{
+		OnDirExists:   func(src, dest string) DirExistsAction { return Untouchable },
+		PreserveTimes: true,
+	}
+	if err := Copy(src, dest, opt); err != nil {
+		t.Fatalf("Copy returned an error: %v", err)
+	}
+
+	gotExisting, err := ioutil.ReadFile(filepath.Join(dest, "foo", "text_aaa"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	Expect(t, string(gotExisting)).ToBe(destinationExisting)
+
+	gotMissing, err := ioutil.ReadFile(filepath.Join(dest, "bar", "text_ccc"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	Expect(t, string(gotMissing)).ToBe(missingContents)
 }
