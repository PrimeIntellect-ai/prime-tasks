+    def test_list_lists_in_two_wire_qnode(self):
+        """The documentation example runs with nested-list weights."""
+        weights = [[0.1, -2.1, 1.4]]
+        dev = qml.device("default.qubit", wires=2)
+
+        @qml.qnode(dev)
+        def circuit(weights):
+            qml.RandomLayers(weights=weights, wires=range(2))
+            return qml.expval(qml.PauliZ(0))
+
+        result = circuit(weights)
+        assert np.shape(result) == ()
+        assert np.isfinite(result)
+
+    def test_list_lists(self):
+        """Tests the weights as a list of lists."""
+        weights = [[0.1, -2.1, 1.4]]
+
+        op = qml.RandomLayers(weights, wires=range(3), seed=42)
+
+        decomp = op.decomposition()
+        expected = [
+            qml.RX(weights[0][0], wires=1),
+            qml.RX(weights[0][1], wires=0),
+            qml.CNOT(wires=[1, 0]),
+            qml.RZ(weights[0][2], wires=2),
+        ]
+
+        for op1, op2 in zip(decomp, expected):
+            assert op1.name == op2.name
+            assert op1.data == op2.data
+            assert op1.wires == op2.wires
+
