index 13780d7..eb3dfe7 100644
--- a/tests/testthat/test-get_-functions.R
+++ b/tests/testthat/test-get_-functions.R
@@ -214,6 +214,32 @@ test_that("get_duplicate_forecasts() works as expected with a data.frame", {
   expect_equal(nrow(duplicates), 20)
 })
 
+test_that("get_duplicate_forecasts() shows counts correctly", {
+  duplicates <- get_duplicate_forecasts(
+    rbind(example_quantile, example_quantile[101:110, ]),
+    counts = TRUE
+  )
+  expect_equal(nrow(duplicates), 2)
+  expect_equal(unique(duplicates$n_duplicates), 10)
+  expect_type(duplicates$n_duplicates, "integer")
+})
+
+test_that("get_duplicate_forecasts() returns duplicate rows grouped together", {
+  ex <- rbind(example_quantile, example_quantile[c(1000:1010, 2000:2010)])
+  duplicates <- as.data.frame(get_duplicate_forecasts(ex))
+
+  forecast_unit <- get_forecast_unit(duplicates)
+  group <- do.call(
+    paste,
+    c(
+      as.list(duplicates[, c(forecast_unit, "quantile_level")]),
+      list(sep = "_")
+    )
+  )
+  runs <- rle(as.character(group))
+  expect_false(any(duplicated(runs$values)))
+})
+
 
