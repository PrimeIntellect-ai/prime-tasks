 })
+
+test_that("Ensuring that the `gt()` function works as expected", {
+
+  # Expect an error if there are any shared names across `rowname_col`
+  # and `groupname_col`
+  expect_error(
+    exibble %>%
+      gt(rowname_col = "row", groupname_col = "row")
+  )
+  expect_error(
+    exibble %>%
+      gt(rowname_col = "group", groupname_col = "group")
+  )
+  expect_error(
+    exibble %>%
+      gt(rowname_col = "rowname", groupname_col = "rowname")
+  )
+  expect_error(
+    exibble %>%
+      dplyr::group_by(group) %>%
+      gt(rowname_col = "group")
+  )
+  expect_error(
+    exibble %>%
+      dplyr::group_by(date, row) %>%
+      gt(rowname_col = "row")
+  )
+
+  # Expect that a `gt_tbl` object is returned when the
+  # `rowname_col` and `groupname_col` values are distinct
+  expect_s3_class(
+    exibble %>%
+      gt(rowname_col = "row", groupname_col = "group"),
+    "gt_tbl"
+  )
+})
