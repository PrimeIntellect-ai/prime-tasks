+
+            @testset "ustrip broadcasting over ranges with differing element and step units" begin
+                ranges = (
+                    StepRange{typeof(1m),typeof(1cm)}(1m, 1cm, 2m),
+                    StepRange{typeof(0m),typeof(1cm)}(1m, 1cm, 2m),
+                    StepRangeLen{typeof(1f0m)}(1.0m, 1.0cm, 101),
+                )
+                for r in ranges
+                    stripped = ustrip.(r)
+                    expected = range(ustrip(r[1]), step=ustrip(uconvert(unit(r[1]), step(r))), length=length(r))
+                    @test length(stripped) == length(r) && all(isapprox.(collect(stripped), expected))
+                end
+            end
