+// Assert Workflows cannot be run without using workflowTemplateRef in reference mode
+func TestControllerReferenceMode(t *testing.T) {
+	wf := unmarshalWF(globalVariablePlaceholders)
+	cancel, controller := newController()
+	defer cancel()
+	controller.Config.WorkflowRestrictions = &config.WorkflowRestrictions{}
+	controller.Config.WorkflowRestrictions.TemplateReferencing = config.TemplateReferencingStrict
+	woc := newWorkflowOperationCtx(wf, controller)
+	woc.operate()
+	assert.Equal(t, wfv1.NodeError, woc.wf.Status.Phase)
+	assert.Equal(t, "workflows must use workflowTemplateRef to be executed when the controller is in reference mode", woc.wf.Status.Message)
+
+	controller.Config.WorkflowRestrictions.TemplateReferencing = config.TemplateReferencingSecure
+	woc = newWorkflowOperationCtx(wf, controller)
+	woc.operate()
+	assert.Equal(t, wfv1.NodeError, woc.wf.Status.Phase)
+	assert.Equal(t, "workflows must use workflowTemplateRef to be executed when the controller is in reference mode", woc.wf.Status.Message)
+
+	controller.Config.WorkflowRestrictions = nil
+	woc = newWorkflowOperationCtx(wf, controller)
+	woc.operate()
+	assert.Equal(t, wfv1.NodeRunning, woc.wf.Status.Phase)
+}
+
+func TestValidReferenceMode(t *testing.T) {
+	wf := test.LoadTestWorkflow("testdata/workflow-template-ref.yaml")
+	wfTmpl := test.LoadTestWorkflowTemplate("testdata/workflow-template-submittable.yaml")
+	cancel, controller := newController(wf, wfTmpl)
+	defer cancel()
+	controller.Config.WorkflowRestrictions = &config.WorkflowRestrictions{}
+	controller.Config.WorkflowRestrictions.TemplateReferencing = config.TemplateReferencingSecure
+	woc := newWorkflowOperationCtx(wf, controller)
+	woc.operate()
+	assert.Equal(t, wfv1.NodeRunning, woc.wf.Status.Phase)
+
+	// Change the referenced WorkflowTemplate spec
+	wfTmpl.Spec.Templates[0].Container.Image = "docker/whalesay:different"
+	updateWorkflowTemplate(t, controller, wfTmpl)
+
+	woc.operate()
+	assert.Equal(t, wfv1.NodeError, woc.wf.Status.Phase)
+	assert.Equal(t, "workflowTemplateRef reference may not change during execution when the controller is in reference mode", woc.wf.Status.Message)
+}
+
+func TestStrictReferenceMode(t *testing.T) {
+	wf := test.LoadTestWorkflow("testdata/workflow-template-ref.yaml")
+	wfTmpl := test.LoadTestWorkflowTemplate("testdata/workflow-template-submittable.yaml")
+	cancel, controller := newController(wf, wfTmpl)
+	defer cancel()
+	controller.Config.WorkflowRestrictions = &config.WorkflowRestrictions{}
+	controller.Config.WorkflowRestrictions.TemplateReferencing = config.TemplateReferencingStrict
+
+	// A change to the referenced WorkflowTemplate is not rejected in Strict mode
+	wfTmpl.Spec.Templates[0].Container.Image = "docker/whalesay:different"
+	updateWorkflowTemplate(t, controller, wfTmpl)
+
+	woc := newWorkflowOperationCtx(wf, controller)
+	woc.operate()
+	assert.Equal(t, wfv1.NodeRunning, woc.wf.Status.Phase)
+}
+
+func updateWorkflowTemplate(t *testing.T, controller *WorkflowController, wfTmpl *wfv1.WorkflowTemplate) {
+	_, err := controller.wfclientset.ArgoprojV1alpha1().WorkflowTemplates(wfTmpl.Namespace).Update(wfTmpl)
+	assert.NoError(t, err)
+	err = wait.Poll(10*time.Millisecond, 10*time.Second, func() (bool, error) {
+		tmpl, err := controller.wftmplInformer.Lister().WorkflowTemplates(wfTmpl.Namespace).Get(wfTmpl.Name)
+		if err != nil {
+			return false, nil
+		}
+		return tmpl.Spec.Templates[0].Container.Image == wfTmpl.Spec.Templates[0].Container.Image, nil
+	})
+	assert.NoError(t, err)
+}
+
+func TestWorkflowRestrictions(t *testing.T) {
+	var nilRestrictions *config.WorkflowRestrictions
+	assert.False(t, nilRestrictions.MustUseReference())
+	assert.False(t, nilRestrictions.MustNotChangeSpec())
+
+	unrestricted := &config.WorkflowRestrictions{}
+	assert.False(t, unrestricted.MustUseReference())
+	assert.False(t, unrestricted.MustNotChangeSpec())
+
+	strict := &config.WorkflowRestrictions{TemplateReferencing: config.TemplateReferencingStrict}
+	assert.True(t, strict.MustUseReference())
+	assert.False(t, strict.MustNotChangeSpec())
+
+	secure := &config.WorkflowRestrictions{TemplateReferencing: config.TemplateReferencingSecure}
+	assert.True(t, secure.MustUseReference())
+	assert.True(t, secure.MustNotChangeSpec())
+}
