@@ -0,0 +1,45 @@
+import { expect } from "chai";
+import * as fs from "fs-extra";
+import * as os from "os";
+import * as path from "path";
+
+import * as optionsHelper from "../../../extensions/emulator/optionsHelper";
+
+describe("optionsHelper", () => {
+  it("resolves an automatically populated default while building emulator options", async () => {
+    const originalDirectory = process.cwd();
+    const extensionDirectory = fs.mkdtempSync(path.join(os.tmpdir(), "extension-emulator-"));
+
+    try {
+      fs.writeFileSync(
+        path.join(extensionDirectory, "extension.yaml"),
+        [
+          "name: test-extension",
+          "specVersion: v1beta",
+          "version: 0.1.0",
+          "license: apache-2.0",
+          "resources: []",
+          "params:",
+          "  - param: SELECTED_DATABASE_INSTANCE",
+          "    label: Database instance",
+          '    default: "${DATABASE_INSTANCE}"',
+          '    validationRegex: "^([0-9a-z_.-]*)$"',
+          "",
+        ].join("\n")
+      );
+      const paramsFile = path.join(extensionDirectory, "test-params.env");
+      fs.writeFileSync(paramsFile, "# no user-supplied parameters\n");
+      process.chdir(extensionDirectory);
+
+      const emulatorOptions = await optionsHelper.buildOptions({
+        project: "test-project",
+        testParams: paramsFile,
+      });
+
+      expect(emulatorOptions.extensionEnv.SELECTED_DATABASE_INSTANCE).to.equal("test-project");
+    } finally {
+      process.chdir(originalDirectory);
+      fs.removeSync(extensionDirectory);
+    }
+  });
+});
