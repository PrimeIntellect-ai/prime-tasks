+#[cfg(test)]
+mod tests {
+    use cosmwasm_std::{Deps, DepsMut, Env, MessageInfo, Response, StdError};
+    use sylvia::interface;
+
+    #[interface]
+    pub trait Group {
+        type Error: From<StdError>;
+
+        #[msg(exec)]
+        fn update_admin(
+            &self,
+            ctx: (DepsMut, Env, MessageInfo),
+            admin: String,
+        ) -> Result<Response, Self::Error>;
+
+        #[msg(exec)]
+        fn update_members(
+            &self,
+            ctx: (DepsMut, Env, MessageInfo),
+            members: Vec<String>,
+        ) -> Result<Response, Self::Error>;
+
+        #[msg(query)]
+        fn member(&self, ctx: (Deps, Env), addr: String) -> Result<Response, Self::Error>;
+    }
+
+    const INTERFACE_EXEC_MESSAGES: [&'static str; 2] = ExecMsg::messages();
+    const INTERFACE_QUERY_MESSAGES: [&'static str; 1] = QueryMsg::messages();
+
+    #[test]
+    fn exec_msgs() {
+        assert_eq!(INTERFACE_EXEC_MESSAGES, ["update_admin", "update_members"]);
+    }
+
+    #[test]
+    fn query_msgs() {
+        assert_eq!(INTERFACE_QUERY_MESSAGES, ["member"]);
+    }
 }
