+    def test_config_dir_can_be_selected_without_changing_home(self):
+        user_dir = os.path.join(
+            tempfile.gettempdir(), "eodag-config-" + uuid.uuid4().hex
+        )
+        home_env_before = os.environ.get("HOME")
+        os.environ["EODAG_CFG_DIR"] = user_dir
+        try:
+            self.execution_involving_conf_dir(inspect="eodag.yml", conf_dir=user_dir)
+        finally:
+            del os.environ["EODAG_CFG_DIR"]
+            if os.path.exists(user_dir):
+                shutil.rmtree(user_dir)
+        self.assertEqual(os.environ.get("HOME"), home_env_before)
+
+    def test_read_only_home_dir(self):
+        with tempfile.TemporaryDirectory() as temp_root:
+            home = os.path.join(temp_root, "home")
+            os.makedirs(home)
+            default_dir = os.path.join(home, ".config", "eodag")
+            make_directory = os.mkdir
+
+            def reject_default_directory(path, mode=0o777, *, dir_fd=None):
+                if os.fspath(path) == default_dir:
+                    raise OSError("default configuration directory is unwritable")
+                return make_directory(path, mode, dir_fd=dir_fd)
+
+            with mock.patch.dict(os.environ, {"HOME": home}, clear=True):
+                with mock.patch("os.mkdir", side_effect=reject_default_directory):
+                    dag = EODataAccessGateway()
+
+            self.assertTrue(os.path.isdir(dag.conf_dir))
+            with tempfile.NamedTemporaryFile(dir=dag.conf_dir):
+                pass
