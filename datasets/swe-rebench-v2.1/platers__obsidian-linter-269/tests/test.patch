@@ -171,4 +171,32 @@ describe('Paragraph blank lines', () => {
 
     expect(rulesDict['paragraph-blank-lines'].apply(before)).toBe(after);
   });
+  it('Leaves a multiline comment at the start of the document unchanged', () => {
+    const comment = dedent`
+    %%
+    due-date:: [[2022-06-10]]
+    %%
+    `;
+
+    expect(rulesDict['paragraph-blank-lines'].apply(comment)).toBe(comment);
+  });
+  it('Does not insert blank lines inside an Obsidian multiline comment', () => {
+    const before = dedent`
+    Here is some inline comments: %%You can't see this text%% (Can't see it)
+
+    Here is a block comment:
+    %%
+    It can span
+    multiple lines
+    %%
+    `;
+    const comment = dedent`
+    %%
+    It can span
+    multiple lines
+    %%
+    `;
+
+    expect(rulesDict['paragraph-blank-lines'].apply(before)).toContain(comment);
+  });
 });
