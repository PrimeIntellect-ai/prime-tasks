+class TestCfnTypeMapping(Base):
+    def test_bad_mapping_null_value(self):
+        # The reproduced nested null value must be rejected during template validation.
+        template, _ = decode_str(
+            """
+            Mappings:
+              qa:
+                global:
+                  global:
+                  subnet: abc123
+            Resources: {}
+            """
+        )
+        runner = TemplateRunner(
+            filename=None,
+            template=template,
+            config=ConfigMixIn(regions=["us-east-1"]),
+            rules=Rules.create_from_directory(_DEFAULT_RULESDIR),
+        )
+        errors = list(runner.run())
+
+        def identifies_invalid_mapping(error):
+            diagnostic = " ".join(str(part) for part in error.path)
+            diagnostic += f" {error.message}"
+            return "qa" in diagnostic and "global" in diagnostic
+
+        self.assertTrue(
+            any(
+                error.rule.id == "E7001" and identifies_invalid_mapping(error)
+                for error in errors
+            ),
+            msg=f"Expected E7001 to identify qa/global, got {errors!r}",
+        )
