+@assert_no_logs
+def test_page_names_10():
+    pages = render_pages('''
+      <style>
+        #running { position: running(running); }
+        #fixed { position: fixed; }
+        @page { size: 200px 200px; @top-center { content: element(header); }}
+        section { page: small; }
+        @page small { size: 100px 100px; }
+        .pagebreak { break-after: page; }
+      </style>
+      <div id="running">running</div>
+      <div id="fixed">fixed</div>
+      <section>
+        <h1>text</h1>
+        <div class="pagebreak"></div>
+        <article>text</article>
+      </section>
+    ''')
+    page1, page2 = pages
+
+    assert (page1.width, page1.height) == (100, 100)
+    assert (page2.width, page2.height) == (100, 100)
+
+
+@assert_no_logs
+@pytest.mark.parametrize('position', ('fixed', 'running(trailing)'))
+def test_page_names_trailing_out_of_flow(position):
+    pages = render_pages('''
+      <style>
+        @page { size: 200px 200px }
+        @page named { size: 100px 100px }
+        @page other { size: 50px 50px }
+        .named { page: named }
+        .pagebreak { break-after: page }
+        #trailing { position: %s; page: other }
+      </style>
+      <div>
+        <section class="named">
+          <p>First named page</p>
+          <div class="pagebreak"></div>
+          <p>Second named page</p>
+          <div id="trailing">out-of-flow content</div>
+        </section>
+      </div>
+      <p>Following content</p>
+    ''' % position)
+
+    assert len(pages) == 2
+    assert [(page.width, page.height) for page in pages] == [(100, 100), (100, 100)]
+
+
+@assert_no_logs
+def test_page_names_trailing_running_page_value():
+    pages = render_pages('''
+      <style>
+        @page { size: 200px 200px }
+        @page other { size: 50px 50px }
+        #running { position: running(header); page: other }
+      </style>
+      <div><div id="running">running content</div></div>
+      <p>In-flow content</p>
+    ''')
+
+    assert len(pages) == 1
+    assert (pages[0].width, pages[0].height) == (200, 200)
+
+
