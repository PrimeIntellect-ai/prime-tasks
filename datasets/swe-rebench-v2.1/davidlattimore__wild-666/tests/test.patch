+/// Compiles `source` to a position-independent object file at `output`.
+fn compile_pic_object(source: &Path, output: &Path) -> Result {
+    let status = Command::new("gcc")
+        .args(["-c", "-fPIC"])
+        .arg(source)
+        .arg("-o")
+        .arg(output)
+        .status()
+        .context("Failed to run gcc")?;
+    if !status.success() {
+        bail!("gcc failed to compile `{}`", source.display());
+    }
+    Ok(())
+}
+
+/// Links the visibility-merging fixtures, together with an object that refers to one of the merged
+/// symbols, into a shared object with wild. Checks that the protected symbol is still exported and
+/// that references to the merged symbols are bound directly rather than through dynamic
+/// relocations.
+#[test]
+fn visibility_merging_dynamic_output() -> Result {
+    let out_dir = build_dir().join("visibility-merging-dynamic-output");
+    std::fs::create_dir_all(&out_dir)?;
+    let sources = base_dir().join("tests/sources");
+    let main_obj = out_dir.join("visibility-merging.o");
+    let other_obj = out_dir.join("visibility-merging-1.o");
+    let refs_src = out_dir.join("visibility-merging-refs.c");
+    let refs_obj = out_dir.join("visibility-merging-refs.o");
+    let out_so = out_dir.join("visibility-merging.so");
+
+    std::fs::write(
+        &refs_src,
+        "extern int data3;\nint get_data3(void) {\n    return data3;\n}\n",
+    )?;
+
+    compile_pic_object(&sources.join("visibility-merging.c"), &main_obj)?;
+    compile_pic_object(&sources.join("visibility-merging-1.c"), &other_obj)?;
+    compile_pic_object(&refs_src, &refs_obj)?;
+
+    let status = Command::new(wild_path())
+        .args(["-shared", "-z", "now", "-o"])
+        .arg(&out_so)
+        .arg(&main_obj)
+        .arg(&other_obj)
+        .arg(&refs_obj)
+        .status()
+        .context("Failed to run wild")?;
+    if !status.success() {
+        bail!("wild failed to link `{}`", out_so.display());
+    }
+
+    let bytes = std::fs::read(&out_so)?;
+    let obj = ElfFile64::parse(bytes.as_slice())?;
+
+    let mut exported = HashSet::new();
+    let mut names = HashMap::new();
+    for sym in obj.dynamic_symbols() {
+        let name = sym.name()?.to_owned();
+        names.insert(sym.index(), name.clone());
+        exported.insert(name);
+    }
+
+    // `data3` is protected in one of its definitions. It must remain exported.
+    if !exported.contains("data3") {
+        bail!("Expected `data3` to be exported as a dynamic symbol");
+    }
+
+    // `get_data1` and `get_data3` refer to merged symbols that must not be preemptible, so the
+    // references must bind directly rather than through a dynamic relocation.
+    let mut relocated = HashSet::new();
+    for (_, reloc) in obj.dynamic_relocations().into_iter().flatten() {
+        if let object::RelocationTarget::Symbol(index) = reloc.target() {
+            if let Some(name) = names.get(&index) {
+                relocated.insert(name.clone());
+            }
+        }
+    }
+    for name in ["data1", "data3"] {
+        if relocated.contains(name) {
+            bail!("A reference to `{name}` is bound through a dynamic relocation");
+        }
+    }
+
+    Ok(())
+}
