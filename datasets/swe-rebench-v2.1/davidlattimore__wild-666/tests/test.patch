+//#Static:false
+//#LinkArgs:-shared -z now
+//#Object:visibility-merging-1.c
+//#RunEnabled:false
+//#DiffIgnore:section.got
+
+// This definition is selected, but the definition in our other file is hidden, so references to
+// this symbol must not be preemptible.
+int data1 __attribute__ ((weak)) = 0x42;
+
+// This symbol is only defined here, so it stays a default-visibility export.
+int data2 __attribute__ ((weak)) = 0x88888888;
+
+// The definition in the second file is protected, so this symbol must remain exported.
+int data3 __attribute__ ((weak)) = 0x55;
+
+// Protected here and hidden in our second object.
+int data4 __attribute__ ((weak, visibility(("protected")))) = 0x99;
+
+// References to `data1` bind directly, since one of its definitions is hidden.
+int get_data1(void) {
+    return data1;
+}
+
