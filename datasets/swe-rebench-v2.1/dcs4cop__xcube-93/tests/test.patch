+import os
+import numpy as np
+import xarray as xr
+
+# Compatibility shim: some environments ship an importlib_metadata whose
+# entry_points() returns an EntryPoints object rather than a mapping, which
+# breaks xarray's backend discovery (and therefore xr.open_zarr).  This only
+# affects the test environment, not the behaviour under test.
+import importlib_metadata
+import xarray.backends.plugins as _xr_backends_plugins
+
+if not hasattr(importlib_metadata.entry_points(), 'get'):
+    def _entry_points_mapping():
+        mapping = {}
+        for entry_point in importlib_metadata.entry_points():
+            mapping.setdefault(entry_point.group, []).append(entry_point)
+        return mapping
+
+    _xr_backends_plugins.entry_points = _entry_points_mapping
+    if hasattr(_xr_backends_plugins.list_engines, 'cache_clear'):
+        _xr_backends_plugins.list_engines.cache_clear()
+
+from test.cli.helpers import CliTest
+from xcube.api import assert_cube, new_cube
+from xcube.api.readwrite import write_cube
+from xcube.util.dsio import rimraf
+
+
+class PruneTest(CliTest):
+
+    def test_help_option(self):
+        result = self.invoke_cli(['prune', '--help'])
+        self.assertEqual(0, result.exit_code)
+
+
+class PruneDataTest(CliTest):
+    TEST_CUBE = "test.zarr"
+
+    def setUp(self) -> None:
+        rimraf(self.TEST_CUBE)
+        cube = new_cube(time_periods=3,
+                        variables=dict(precipitation=np.nan,
+                                       temperature=np.nan)).chunk(dict(time=1, lat=90, lon=90))
+
+        write_cube(cube, self.TEST_CUBE, "zarr", cube_asserted=True)
+
+    def tearDown(self) -> None:
+        rimraf(self.TEST_CUBE)
+
+    def test_dry_run(self):
+        files_before = {
+            variable: set(os.listdir(os.path.join(self.TEST_CUBE, variable)))
+            for variable in ('precipitation', 'temperature')
+        }
+        result = self.invoke_cli(['prune', self.TEST_CUBE, "--dry-run"])
+        self.assertEqual(0, result.exit_code)
+        self.assertEqual("Opening cube from 'test.zarr'...\n"
+                         "Identifying empty blocks...\n"
+                         "Deleting 24 empty block file(s) for variable 'precipitation'...\n"
+                         "Deleting 24 empty block file(s) for variable 'temperature'...\n"
+                         "Done, 48 block file(s) deleted.\n",
+                         result.stdout)
+        for variable, original_files in files_before.items():
+            self.assertEqual(original_files, set(os.listdir(os.path.join(self.TEST_CUBE, variable))))
+        ds = xr.open_zarr('test.zarr')
+        assert_cube(ds)
+        self.assertIn('precipitation', ds)
+        self.assertEqual((3, 180, 360), ds.precipitation.shape)
+        self.assertEqual(('time', 'lat', 'lon'), ds.precipitation.dims)
+        self.assertIn('temperature', ds)
+        self.assertEqual((3, 180, 360), ds.temperature.shape)
+        self.assertEqual(('time', 'lat', 'lon'), ds.temperature.dims)
+
+    def test_no_dry_run(self):
+        metadata_before = {
+            variable: {name for name in os.listdir(os.path.join(self.TEST_CUBE, variable))
+                       if name.startswith('.')}
+            for variable in ('precipitation', 'temperature')
+        }
+        result = self.invoke_cli(['prune', self.TEST_CUBE])
+        self.assertEqual(0, result.exit_code)
+        self.assertEqual("Opening cube from 'test.zarr'...\n"
+                         "Identifying empty blocks...\n"
+                         "Deleting 24 empty block file(s) for variable 'precipitation'...\n"
+                         "Deleting 24 empty block file(s) for variable 'temperature'...\n"
+                         "Done, 48 block file(s) deleted.\n",
+                         result.stdout)
+        for variable, metadata_files in metadata_before.items():
+            remaining_files = set(os.listdir(os.path.join(self.TEST_CUBE, variable)))
+            self.assertEqual(metadata_files, remaining_files)
+        ds = xr.open_zarr('test.zarr')
+        assert_cube(ds)
+        self.assertIn('precipitation', ds)
+        self.assertEqual((3, 180, 360), ds.precipitation.shape)
+        self.assertEqual(('time', 'lat', 'lon'), ds.precipitation.dims)
+        self.assertIn('temperature', ds)
+        self.assertEqual((3, 180, 360), ds.temperature.shape)
+        self.assertEqual(('time', 'lat', 'lon'), ds.temperature.dims)
+
+    def test_mixed_empty_and_populated_chunks(self):
+        rimraf(self.TEST_CUBE)
+        precipitation = np.full((3, 180, 360), np.nan)
+        precipitation[0, :90, :90] = 7.0
+        cube = new_cube(time_periods=3,
+                        variables=dict(precipitation=precipitation,
+                                       temperature=np.nan)).chunk(dict(time=1, lat=90, lon=90))
+        write_cube(cube, self.TEST_CUBE, "zarr", cube_asserted=True)
+
+        result = self.invoke_cli(['prune', self.TEST_CUBE])
+        self.assertEqual(0, result.exit_code)
+        self.assertEqual("Opening cube from 'test.zarr'...\n"
+                         "Identifying empty blocks...\n"
+                         "Deleting 23 empty block file(s) for variable 'precipitation'...\n"
+                         "Deleting 24 empty block file(s) for variable 'temperature'...\n"
+                         "Done, 47 block file(s) deleted.\n",
+                         result.stdout)
+
+        precipitation_files = os.listdir(os.path.join(self.TEST_CUBE, 'precipitation'))
+        temperature_files = os.listdir(os.path.join(self.TEST_CUBE, 'temperature'))
+        self.assertEqual(1, sum(not name.startswith('.') for name in precipitation_files))
+        self.assertEqual(0, sum(not name.startswith('.') for name in temperature_files))
+
+        ds = xr.open_zarr(self.TEST_CUBE)
+        self.assertEqual(7.0, ds.precipitation.values[0, 0, 0])
+
+    def test_variable_without_empty_chunks_is_reported(self):
+        rimraf(self.TEST_CUBE)
+        cube = new_cube(time_periods=3,
+                        variables=dict(precipitation=1.0,
+                                       temperature=np.nan)).chunk(dict(time=1, lat=90, lon=90))
+        write_cube(cube, self.TEST_CUBE, "zarr", cube_asserted=True)
+
+        result = self.invoke_cli(['prune', self.TEST_CUBE])
+        self.assertEqual(0, result.exit_code)
+        self.assertEqual("Opening cube from 'test.zarr'...\n"
+                         "Identifying empty blocks...\n"
+                         "Deleting 0 empty block file(s) for variable 'precipitation'...\n"
+                         "Deleting 24 empty block file(s) for variable 'temperature'...\n"
+                         "Done, 24 block file(s) deleted.\n",
+                         result.stdout)
+
+        precipitation_files = os.listdir(os.path.join(self.TEST_CUBE, 'precipitation'))
+        self.assertEqual(24, sum(not name.startswith('.') for name in precipitation_files))
+        temperature_files = os.listdir(os.path.join(self.TEST_CUBE, 'temperature'))
+        self.assertEqual(0, sum(not name.startswith('.') for name in temperature_files))
