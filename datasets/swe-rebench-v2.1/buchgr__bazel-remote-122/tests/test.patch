diff --git a/server/grpc_test.go b/server/grpc_test.go
index 9cb00e0..7bb16bd 100644
--- a/server/grpc_test.go
+++ b/server/grpc_test.go
@@ -114,6 +114,15 @@ func checkBadDigestErr(t *testing.T, err error, bd badDigest) {
 	}
 }
 
+// withoutMetadata returns a copy of ar with ExecutionMetadata removed, so that
+// tests can compare ActionResults without depending on whether the server
+// chooses to enrich them with metadata.
+func withoutMetadata(ar *pb.ActionResult) *pb.ActionResult {
+	clone := proto.Clone(ar).(*pb.ActionResult)
+	clone.ExecutionMetadata = nil
+	return clone
+}
+
 func TestGrpcAc(t *testing.T) {
 	ar := pb.ActionResult{
 		StdoutRaw: []byte("pretend action stdout"),
@@ -173,7 +182,9 @@ func TestGrpcAc(t *testing.T) {
 		t.Fatal(err)
 	}
 
-	if !proto.Equal(&ar, upACResp) {
+	// The contract does not require ExecutionMetadata to be added, but if
+	// it is then it must not affect the rest of the ActionResult.
+	if !proto.Equal(withoutMetadata(&ar), withoutMetadata(upACResp)) {
 		t.Fatal("Error: uploaded and returned ActionResult differ")
 	}
 
@@ -202,11 +213,15 @@ func TestGrpcAc(t *testing.T) {
 		ActionDigest: &zeroDigest,
 		ActionResult: &zeroActionResult,
 	}
-	_, err = acClient.UpdateActionResult(ctx, &zeroReq)
-	s, ok = status.FromError(err)
-	if !ok || s.Code() != codes.InvalidArgument ||
-		err.Error() != errEmptyActionResult.Error() {
-		t.Fatal("expected empty ActionResult to be rejected", err)
+	// A zero-length serialized ActionResult is a legitimate value and must
+	// not be rejected.
+	zeroResp, err := acClient.UpdateActionResult(ctx, &zeroReq)
+	if err != nil {
+		t.Fatal("expected a zero-length ActionResult to be accepted", err)
+	}
+
+	if !proto.Equal(withoutMetadata(zeroReq.ActionResult), withoutMetadata(zeroResp)) {
+		t.Fatal("expected returned ActionResult to match the request")
 	}
 
 	// GetActionResultRequest again, expect cache hit.
@@ -216,7 +231,7 @@ func TestGrpcAc(t *testing.T) {
 		t.Fatal(err)
 	}
 
-	if !proto.Equal(&ar, gacrResp) {
+	if !proto.Equal(withoutMetadata(&ar), withoutMetadata(gacrResp)) {
 		t.Fatal("Error: uploaded and returned ActionResult differ")
 	}
 }
