+    public function testTraceDoesNotAddBaggageHeaderWhenTheDestinationIsNotApproved(): void
+    {
+        $client = $this->createMock(ClientInterface::class);
+        $client->expects($this->any())
+            ->method('getOptions')
+            ->willReturn(new Options());
+
+        $hub = new Hub($client);
+
+        $transaction = $hub->startTransaction(new TransactionContext());
+
+        $hub->setSpan($transaction);
+
+        $middleware = GuzzleTracingMiddleware::trace($hub);
+        $function = $middleware(function (Request $request): PromiseInterface {
+            $this->assertNotEmpty($request->getHeader('sentry-trace'));
+            $this->assertEmpty($request->getHeader('baggage'));
+
+            return new FulfilledPromise(new Response());
+        });
+
+        $function(new Request('GET', 'https://www.example.com'), [])->wait();
+
+        $transaction->finish();
+    }
+
