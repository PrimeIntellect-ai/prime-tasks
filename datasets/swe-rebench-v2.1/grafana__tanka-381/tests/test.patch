+package helm
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/grafana/tanka/pkg/kubernetes/manifest"
+)
+
+func TestNativeFuncReportsDuplicateRenderedKeys(t *testing.T) {
+	duplicateResources := manifest.List{
+		secret("foo", map[string]interface{}{"id": 1}),
+		secret("foo", map[string]interface{}{"id": 2}),
+	}
+
+	_, err := callNativeFunc(t, duplicateResources, "")
+	if err == nil {
+		t.Fatal("expected an error when rendered resources have the same key")
+	}
+}
+
+func TestNativeFuncReportsDuplicateKeysUnderCustomFormat(t *testing.T) {
+	resources := manifest.List{
+		configMap("alpha"),
+		configMap("beta"),
+	}
+
+	_, err := callNativeFunc(t, resources, `{{ .kind }}`)
+	if err == nil {
+		t.Fatal("expected an error when rendered resources have the same key under a custom name format")
+	}
+}
+
+func TestNativeFuncProducesUsableKeys(t *testing.T) {
+	resources := manifest.List{
+		configMap("alpha"),
+		deployment("beta"),
+	}
+	format := `{{ print .metadata.name "_" .kind }}`
+
+	first := renderWithNativeFunc(t, resources, format)
+	second := renderWithNativeFunc(t, resources, format)
+	if !reflect.DeepEqual(first, second) {
+		t.Fatalf("keys changed between identical renders: first=%v second=%v", first, second)
+	}
+
+	want := map[string]interface{}{
+		"alpha_ConfigMap": configMap("alpha"),
+		"beta_Deployment": deployment("beta"),
+	}
+	if !reflect.DeepEqual(first, want) {
+		t.Fatalf("rendered map does not expose the requested resource keys: got=%v want=%v", first, want)
+	}
+}
+
+func TestNativeFuncUsesDistinctStableKeysByDefault(t *testing.T) {
+	resources := manifest.List{
+		configMap("alpha"),
+		deployment("beta"),
+	}
+
+	first := renderWithNativeFunc(t, resources, "")
+	second := renderWithNativeFunc(t, resources, "")
+	if !reflect.DeepEqual(first, second) {
+		t.Fatalf("default resource keys changed between identical renders: first=%v second=%v", first, second)
+	}
+	if len(first) != len(resources) {
+		t.Fatalf("expected one distinct key per resource, got %d keys for %d resources: %v", len(first), len(resources), first)
+	}
+
+	foundConfigMap, foundDeployment := false, false
+	for key, resource := range first {
+		if key == "" {
+			t.Fatal("default format produced an unusable empty resource key")
+		}
+		switch {
+		case reflect.DeepEqual(resource, configMap("alpha")):
+			foundConfigMap = true
+		case reflect.DeepEqual(resource, deployment("beta")):
+			foundDeployment = true
+		default:
+			t.Errorf("unexpected resource stored under default key %q: %v", key, resource)
+		}
+	}
+	if !foundConfigMap || !foundDeployment {
+		t.Fatalf("default keys do not address both rendered resources: %v", first)
+	}
+}
+
+func renderWithNativeFunc(t *testing.T, resources manifest.List, nameFormat string) map[string]interface{} {
+	t.Helper()
+	result, err := callNativeFunc(t, resources, nameFormat)
+	if err != nil {
+		t.Fatalf("rendering failed: %v", err)
+	}
+	out, ok := result.(map[string]interface{})
+	if !ok {
+		t.Fatalf("expected rendered resources as a map, got %T", result)
+	}
+	return out
+}
+
+func callNativeFunc(t *testing.T, resources manifest.List, nameFormat string) (interface{}, error) {
+	t.Helper()
+	dir := t.TempDir()
+	if err := os.Mkdir(filepath.Join(dir, "chart"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	return NativeFunc(stubHelm{resources: resources}).Func([]interface{}{
+		"release",
+		"chart",
+		map[string]interface{}{
+			"calledFrom": filepath.Join(dir, "main.jsonnet"),
+			"nameFormat": nameFormat,
+		},
+	})
+}
+
+type stubHelm struct {
+	resources manifest.List
+}
+
+func (h stubHelm) Pull(string, string, PullOpts) error { return nil }
+func (h stubHelm) RepoUpdate(Opts) error               { return nil }
+func (h stubHelm) Template(string, string, TemplateOpts) (manifest.List, error) {
+	return h.resources, nil
+}
+
+func configMap(name string) map[string]interface{} {
+	return map[string]interface{}{
+		"apiVersion": "v1",
+		"kind":       "ConfigMap",
+		"metadata":   map[string]interface{}{"name": name},
+		"data":       map[string]interface{}{},
+	}
+}
+
+func deployment(name string) map[string]interface{} {
+	return map[string]interface{}{
+		"apiVersion": "apps/v1",
+		"kind":       "Deployment",
+		"metadata":   map[string]interface{}{"name": name},
+		"spec":       map[string]interface{}{},
+	}
+}
+
+func secret(name string, data map[string]interface{}) map[string]interface{} {
+	if data == nil {
+		data = map[string]interface{}{}
+	}
+
+	return map[string]interface{}{
+		"apiVersion": "v1",
+		"kind":       "Secret",
+		"metadata":   map[string]interface{}{"name": name},
+		"data":       data,
+	}
+}
