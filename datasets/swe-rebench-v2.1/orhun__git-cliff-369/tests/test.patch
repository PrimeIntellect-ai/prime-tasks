+#[test]
+fn generate_changelog_with_footer_template() -> Result<()> {
+	let config = footer_config();
+	let changelog = Changelog::new(footer_releases(), &config)?;
+	let mut out = Vec::new();
+	changelog.generate(&mut out)?;
+	let out = String::from_utf8(out).expect("changelog is not valid UTF-8");
+	assert!(
+		out.contains("[v2.0.0]: https://example.com/compare/v2.0.0...HEAD"),
+		"footer template was not rendered with the releases: {out}"
+	);
+	assert!(
+		out.contains("[v1.0.0]: https://example.com/compare/v1.0.0...HEAD"),
+		"footer template was not rendered with the releases: {out}"
 	);
+	Ok(())
+}
 
+#[test]
+fn write_context_serializes_releases() -> Result<()> {
+	let config = footer_config();
+	let changelog = Changelog::new(footer_releases(), &config)?;
+	let mut out = Vec::new();
+	changelog.write_context(&mut out)?;
+	let json = String::from_utf8(out).expect("context is not valid UTF-8");
+	assert!(
+		json.contains("\"version\":\"v2.0.0\""),
+		"releases were not serialized to JSON: {json}"
+	);
+	assert!(
+		json.contains("\"version\":\"v1.0.0\""),
+		"releases were not serialized to JSON: {json}"
+	);
 	Ok(())
