+@pytest.mark.skipif(sys.version_info < (3, 10), reason="No UnionType < Py3.10")
+def test_task_field_with_none_union():
+    """A task field annotated with ``X | None`` is a valid definition and must not
+    raise when the task is created or its inputs are set."""
+
+    @mark.task
+    @mark.annotate({"return": {"smoothed_image": Path}})
+    def smooth_image(input_image: Path, smoothed_image: Path | None) -> Path:
+        return smoothed_image
+
+    task = smooth_image(input_image=Path("/tmp/input"), smoothed_image=None)
+    assert task.inputs.smoothed_image is None
+
+    task = smooth_image(
+        input_image=Path("/tmp/input"), smoothed_image=Path("/tmp/output")
+    )
+    assert os.fspath(task.inputs.smoothed_image) == "/tmp/output"
+
 
