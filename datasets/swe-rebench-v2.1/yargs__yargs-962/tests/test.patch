+
+  describe('hidden options', () => {
+    it('--help should display described and undescribed options, but omit hidden ones', () => {
+      const r = checkUsage(() => yargs('--help')
+          .options({
+            foo: {
+              describe: 'FOO'
+            },
+            bar: {},
+            baz: {
+              describe: 'BAZ',
+              hidden: true
+            }
+          })
+          .argv
+        )
+
+      r.logs[0].should.match(/--foo/)
+      r.logs[0].should.match(/--bar\s*$/m)
+      r.logs[0].should.not.match(/--baz/)
+    })
+
+    it('option() with hidden: true omits the option from help', () => {
+      const r = checkUsage(() => yargs('--help')
+          .option('foo', { describe: 'FOO', hidden: true })
+          .argv
+        )
+
+      r.logs[0].should.not.match(/--foo/)
+    })
+
+    it('should still accept a hidden option registered with option()', () => {
+      const argv = yargs('--foo hello')
+        .option('foo', { hidden: true })
+        .argv
+
+      argv.foo.should.equal('hello')
+    })
+
+    it('should still parse a hidden option registered with options()', () => {
+      const argv = yargs('--foo hello')
+        .options({ foo: { hidden: true } })
+        .argv
+
+      argv.foo.should.equal('hello')
+    })
+  })
 })
