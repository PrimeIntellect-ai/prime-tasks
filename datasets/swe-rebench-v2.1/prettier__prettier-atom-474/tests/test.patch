+
+describe('format on save with an absolute Atom project path', () => {
+  it('does not log a RangeError when saving a user stylesheet', async () => {
+    const filePath = '/Users/johndoe/.atom/styles.less';
+    const options = {
+      'prettier-atom.formatOnSaveOptions.enabled': true,
+      'prettier-atom.formatOnSaveOptions.excludedGlobs': [],
+      'prettier-atom.formatOnSaveOptions.whitelistedGlobs': [],
+      'prettier-atom.formatOnSaveOptions.respectEslintignore': false,
+      'prettier-atom.formatOnSaveOptions.isDisabledIfNotInPackageJson': false,
+      'prettier-atom.formatOnSaveOptions.isDisabledIfNoConfigFile': false,
+    };
+    atom = {
+      config: { get: key => options[key] },
+      project: { relativizePath: () => [null, filePath] },
+      notifications: { addError: jest.fn() },
+    };
+    const editor = textEditor({ buffer: { file: { getPath: () => filePath } } });
+    const originalConsoleError = console.error; // eslint-disable-line no-console
+    const consoleError = jest.fn();
+    console.error = consoleError; // eslint-disable-line no-console
+
+    try {
+      await formatOnSave(editor);
+    } finally {
+      console.error = originalConsoleError; // eslint-disable-line no-console
+    }
+
+    const loggedErrors = consoleError.mock.calls.map(([error]) => error);
+    expect(loggedErrors.some(error => error instanceof RangeError)).toBe(false);
+  });
+});
