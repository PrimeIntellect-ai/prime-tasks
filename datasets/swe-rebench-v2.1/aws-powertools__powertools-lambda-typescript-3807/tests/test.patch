diff --git a/packages/parser/tests/unit/schema/apigw-websocket.test.ts b/packages/parser/tests/unit/schema/apigw-websocket.test.ts
new file mode 100644
index 00000000..b61ddf0c
--- /dev/null
+++ b/packages/parser/tests/unit/schema/apigw-websocket.test.ts
@@ -0,0 +1,200 @@
+import { describe, expect, it } from 'vitest';
+import { APIGatewayProxyWebsocketEventSchema } from '../../../src/schemas/index.js';
+import { getTestEvent } from '../helpers/utils.js';
+
+describe('Schema: API Gateway WebSocket event', () => {
+  const baseEvent = getTestEvent<Record<string, unknown>>({
+    eventsPath: 'apigw-websocket',
+    filename: 'connectEvent',
+  });
+
+  const withRequestContext = (
+    overrides: Record<string, unknown>,
+    removeKeys: string[] = []
+  ): Record<string, unknown> => {
+    const event = structuredClone(baseEvent);
+    const requestContext = {
+      ...(event.requestContext as Record<string, unknown>),
+      ...overrides,
+    };
+    for (const key of removeKeys) {
+      delete requestContext[key];
+    }
+    event.requestContext = requestContext;
+
+    return event;
+  };
+
+  it('parses a valid API Gateway WebSocket event via the schema exports', () => {
+    const event = structuredClone(baseEvent);
+
+    const result = APIGatewayProxyWebsocketEventSchema.parse(event);
+
+    expect(result.methodArn).toBe(event.methodArn);
+    expect(result.requestContext.connectionId).toBe(
+      (event.requestContext as Record<string, unknown>).connectionId
+    );
+  });
+
+  it('rejects events that omit any required top-level field', () => {
+    const requiredFields = [
+      'type',
+      'methodArn',
+      'headers',
+      'multiValueHeaders',
+      'requestContext',
+      'isBase64Encoded',
+    ];
+
+    for (const field of requiredFields) {
+      const invalidEvent = structuredClone(baseEvent);
+      delete invalidEvent[field];
+
+      expect(() => APIGatewayProxyWebsocketEventSchema.parse(invalidEvent)).toThrow();
+    }
+  });
+
+  it('rejects fields whose values do not match their event structure', () => {
+    const invalidEvents = [
+      { ...structuredClone(baseEvent), type: 1 },
+      { ...structuredClone(baseEvent), methodArn: 1 },
+      { ...structuredClone(baseEvent), headers: { Connection: 1 } },
+      {
+        ...structuredClone(baseEvent),
+        multiValueHeaders: { Connection: 'upgrade' },
+      },
+      {
+        ...structuredClone(baseEvent),
+        multiValueHeaders: { Connection: [1] },
+      },
+      {
+        ...structuredClone(baseEvent),
+        requestContext: {
+          ...(baseEvent.requestContext as Record<string, unknown>),
+          eventType: 'UNKNOWN',
+        },
+      },
+      {
+        ...structuredClone(baseEvent),
+        requestContext: {
+          ...(baseEvent.requestContext as Record<string, unknown>),
+          identity: { sourceIp: 1 },
+        },
+      },
+      { ...structuredClone(baseEvent), requestContext: null },
+      { ...structuredClone(baseEvent), isBase64Encoded: 'false' },
+      { ...structuredClone(baseEvent), queryStringParameters: [] },
+      { ...structuredClone(baseEvent), stageVariables: { stage: 1 } },
+      {
+        ...structuredClone(baseEvent),
+        multiValueQueryStringParameters: { QueryString1: 'queryValue1' },
+      },
+      { ...structuredClone(baseEvent), body: 1 },
+    ];
+
+    for (const invalidEvent of invalidEvents) {
+      expect(() => APIGatewayProxyWebsocketEventSchema.parse(invalidEvent)).toThrow();
+    }
+  });
+
+  it('rejects request context objects that omit a required field', () => {
+    const requiredContextFields = [
+      'routeKey',
+      'eventType',
+      'extendedRequestId',
+      'requestTime',
+      'messageDirection',
+      'stage',
+      'connectedAt',
+      'requestTimeEpoch',
+      'identity',
+      'requestId',
+      'domainName',
+      'connectionId',
+      'apiId',
+    ];
+
+    for (const field of requiredContextFields) {
+      const invalidEvent = withRequestContext({}, [field]);
+
+      expect(() => APIGatewayProxyWebsocketEventSchema.parse(invalidEvent)).toThrow();
+    }
+  });
+
+  it('accepts each documented event type and message direction', () => {
+    for (const eventType of ['CONNECT', 'DISCONNECT', 'MESSAGE']) {
+      for (const messageDirection of ['IN', 'OUT']) {
+        const event = withRequestContext({ eventType, messageDirection });
+
+        expect(() => APIGatewayProxyWebsocketEventSchema.parse(event)).not.toThrow();
+      }
+    }
+  });
+
+  it('rejects event types and message directions outside the documented values', () => {
+    const invalidEvents = [
+      withRequestContext({ eventType: 'connect' }),
+      withRequestContext({ messageDirection: 'IN_OUT' }),
+      withRequestContext({ messageDirection: 1 }),
+    ];
+
+    for (const invalidEvent of invalidEvents) {
+      expect(() => APIGatewayProxyWebsocketEventSchema.parse(invalidEvent)).toThrow();
+    }
+  });
+
+  it('rejects identity objects without a string source IP', () => {
+    const missingSourceIp = withRequestContext({ identity: { userAgent: 'agent' } });
+    const numericSourceIp = withRequestContext({ identity: { sourceIp: 192 } });
+
+    expect(() => APIGatewayProxyWebsocketEventSchema.parse(missingSourceIp)).toThrow();
+    expect(() => APIGatewayProxyWebsocketEventSchema.parse(numericSourceIp)).toThrow();
+  });
+
+  it('accepts an identity with a user agent', () => {
+    const event = withRequestContext({
+      identity: { sourceIp: '192.0.2.1', userAgent: 'agent/1.0' },
+    });
+
+    expect(() => APIGatewayProxyWebsocketEventSchema.parse(event)).not.toThrow();
+  });
+
+  it('rejects numeric request context timestamps supplied as strings', () => {
+    const stringConnectedAt = withRequestContext({ connectedAt: '1674162806344' });
+    const stringRequestTime = withRequestContext({ requestTimeEpoch: '1674162806345' });
+
+    expect(() => APIGatewayProxyWebsocketEventSchema.parse(stringConnectedAt)).toThrow();
+    expect(() => APIGatewayProxyWebsocketEventSchema.parse(stringRequestTime)).toThrow();
+  });
+
+  it('accepts an event when optional WebSocket payload fields are absent', () => {
+    const event = structuredClone(baseEvent);
+    delete event.queryStringParameters;
+    delete event.multiValueQueryStringParameters;
+    delete event.stageVariables;
+    delete event.body;
+
+    expect(() => APIGatewayProxyWebsocketEventSchema.parse(event)).not.toThrow();
+  });
+
+  it('accepts null for the optional query string, stage variable and body fields', () => {
+    const event = {
+      ...structuredClone(baseEvent),
+      queryStringParameters: null,
+      multiValueQueryStringParameters: null,
+      stageVariables: null,
+      body: null,
+    };
+
+    expect(() => APIGatewayProxyWebsocketEventSchema.parse(event)).not.toThrow();
+  });
+
+  it('accepts a string body on a message event', () => {
+    const event = {
+      ...withRequestContext({ eventType: 'MESSAGE', messageDirection: 'IN' }),
+      body: '{"action":"sendMessage"}',
+    };
+
+    expect(() => APIGatewayProxyWebsocketEventSchema.parse(event)).not.toThrow();
+  });
+});
