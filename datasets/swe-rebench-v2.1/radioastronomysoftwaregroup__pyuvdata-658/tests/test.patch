+def test_upos_tol_reds():
+    # Checks that the u-positive convention in get_antenna_redundancies
+    # is enforced to the specificed tolerance.
+
+    # Make a layout with two NS baselines, one with u ~ -2*eps, and another with u == 0
+    # This would previously cause one to be flipped, when they should be redundant.
+
+    eps = 1e-5
+    tol = 3 * eps
+
+    ant_pos = np.array([
+        [-eps, 1., 0.],
+        [1., 1., 0.],
+        [eps, 0., 0.],
+        [1., 0., 0.]
+    ])
+
+    ant_nums = np.arange(4)
+
+    red_grps, _, _ = uvutils.get_antenna_redundancies(ant_nums, ant_pos, tol=tol)
+
+    assert len(red_grps) == 4
+
+    # The two north-south baselines, (0, 2) and (1, 3), point in opposite
+    # directions and must be placed in the same redundant group.
+    def group_of(ant_a, ant_b):
+        bls = [uvutils.antnums_to_baseline(ant_a, ant_b, 4),
+               uvutils.antnums_to_baseline(ant_b, ant_a, 4)]
+        return [gi for gi, gp in enumerate(red_grps) if any(bl in gp for bl in bls)]
+
+    grp_02 = group_of(0, 2)
+    assert len(grp_02) == 1
+    assert group_of(1, 3) == grp_02
