+func TestPushSecretComparesDecryptedValue(t *testing.T) {
+	fakeSecret := &corev1.Secret{Data: map[string][]byte{fakeSecretKey: []byte(fakeValue)}}
+	managedByESO := ssm.Tag{Key: &managedBy, Value: &externalSecrets}
+	for _, tc := range []struct {
+		name         string
+		remoteValue  string
+		wantPutCalls int
+	}{
+		{name: "matching value is not written", remoteValue: fakeValue, wantPutCalls: 0},
+		{name: "different value is written", remoteValue: "a different value", wantPutCalls: 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var getInput *ssm.GetParameterInput
+			client := fakeps.Client{
+				GetParameterWithContextFn: func(_ aws.Context, input *ssm.GetParameterInput, _ ...request.Option) (*ssm.GetParameterOutput, error) {
+					getInput = input
+					return &ssm.GetParameterOutput{Parameter: &ssm.Parameter{Value: aws.String(tc.remoteValue)}}, nil
+				},
+				PutParameterWithContextFn:        fakeps.NewPutParameterWithContextFn(&ssm.PutParameterOutput{}, nil),
+				ListTagsForResourceWithContextFn: fakeps.NewListTagsForResourceWithContextFn(&ssm.ListTagsForResourceOutput{TagList: []*ssm.Tag{&managedByESO}}, nil),
+			}
+			ps := ParameterStore{client: &client}
+			metadata := &apiextensionsv1.JSON{Raw: []byte(`{"parameterStoreType":"SecureString"}`)}
+			data := fake.PushSecretData{SecretKey: fakeSecretKey, RemoteKey: remoteKey, Metadata: metadata}
+
+			require.NoError(t, ps.PushSecret(context.Background(), fakeSecret, data))
+			require.NotNil(t, getInput)
+			assert.True(t, aws.BoolValue(getInput.WithDecryption), "remote value must be returned decrypted for comparison")
+			assert.Equal(t, tc.wantPutCalls, client.PutParameterWithContextCalledN)
+		})
+	}
+}
