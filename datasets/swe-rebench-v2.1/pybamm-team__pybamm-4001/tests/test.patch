+    def test_import_with_preset_multiprocessing_start_method(self):
+        # Importing PyBaMM after another library has already set the
+        # multiprocessing start method must not fail, and must not require the
+        # user to change that configuration.
+        code = (
+            "import multiprocessing as mp\n"
+            "mp.set_start_method('spawn')\n"
+            "import pybamm\n"
+        )
+        result = subprocess.run(
+            [sys.executable, "-c", code],
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(result.returncode, 0, result.stderr)
