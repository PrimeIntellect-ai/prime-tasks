+func TestListIPStatusesFollowResponse(t *testing.T) {
+	response := `{"items":["172.0.0.1","192.168.1.1"],"assignable_to_pools":["192.168.1.1"],"details":[{"ip":"192.168.1.1","is_on_warmup":true},{"ip":"172.0.0.1","is_on_warmup":false}]}`
+	testServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(response))
+	}))
+	defer testServer.Close()
+
+	mg := mailgun.NewMailgun(testKey)
+	require.NoError(t, mg.SetAPIBase(testServer.URL))
+	list, err := mg.ListIPs(context.Background(), false, false)
+	require.NoError(t, err)
+
+	type ipStatus struct {
+		IP                string `json:"ip"`
+		AssignableToPools bool   `json:"assignable_to_pools"`
+		IsOnWarmup        bool   `json:"is_on_warmup"`
+	}
+	var statuses []ipStatus
+	encoded, err := json.Marshal(list)
+	require.NoError(t, err)
+	require.NoError(t, json.Unmarshal(encoded, &statuses))
+
+	assert.ElementsMatch(t, []ipStatus{
+		{IP: "172.0.0.1", AssignableToPools: false, IsOnWarmup: false},
+		{IP: "192.168.1.1", AssignableToPools: true, IsOnWarmup: true},
+	}, statuses)
+}
