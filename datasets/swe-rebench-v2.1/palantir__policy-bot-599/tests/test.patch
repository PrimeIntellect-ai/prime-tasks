+func TestCommitsDoNotLoadPushedDate(t *testing.T) {
+	rp := &ResponsePlayer{}
+	rp.AddRule(
+		GraphQLNodePrefixMatcher("repository.pullRequest.commits"),
+		"testdata/responses/pull_commits_fallback.yml",
+	)
+	fallbackRule := rp.AddRule(
+		GraphQLNodePrefixMatcher("repository.object"),
+		"testdata/responses/pull_commits_history.yml",
+	)
+
+	ctx := makeContextWithOptions(t, rp, nil, true)
+
+	commits, err := ctx.Commits()
+	require.NoError(t, err)
+
+	// The head commit has no pushed date in the pull request response. When
+	// pushed dates are not loaded, the fallback history API must not be used.
+	assert.Zero(t, fallbackRule.Count, "fallback history must not be queried")
+
+	var headCommit *Commit
+	for _, commit := range commits {
+		if commit.SHA == "e05fcae367230ee709313dd2720da527d178ce43" {
+			headCommit = commit
+			break
+		}
+	}
+	require.NotNil(t, headCommit, "pull request head commit should be returned")
+	assert.Nil(t, headCommit.PushedAt, "pushed date should not be loaded")
+	assert.Equal(t, 6, reflect.TypeOf(NewGitHubContext).NumIn(), "constructor should accept the pushed-date option")
+}
