+package tanka
+
+import (
+	"io/ioutil"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/grafana/tanka/pkg/spec/v1alpha1"
+	"github.com/stretchr/testify/require"
+)
+
+func TestExportFormatPreservesPathSeparatorInsideTemplateAction(t *testing.T) {
+	markerPath := "jsonnetfile.json"
+	require.NoError(t, ioutil.WriteFile(markerPath, []byte(`{"dependencies":{}}`), 0644))
+	defer os.Remove(markerPath)
+
+	root, err := ioutil.TempDir(".", "export-")
+	require.NoError(t, err)
+	defer os.RemoveAll(root)
+	envDir := root
+	require.NoError(t, os.MkdirAll(envDir, 0755))
+	require.NoError(t, ioutil.WriteFile(filepath.Join(envDir, "spec.json"), []byte(`{
+"apiVersion":"tanka.dev/v1alpha1",
+"kind":"Environment",
+"spec":{"apiServer":"https://localhost","namespace":"default"}
+}`), 0644))
+	require.NoError(t, ioutil.WriteFile(filepath.Join(envDir, "main.jsonnet"), []byte(`{
+apiVersion: 'v1',
+kind: 'ConfigMap',
+metadata: {
+name: 'resource',
+labels: { 'app.kubernetes.io/name': 'demo' },
+},
+}`), 0644))
+
+	env, err := Peek(envDir, Opts{})
+	require.NoError(t, err)
+
+	outputDir := filepath.Join(root, "output")
+	format := `{{index .metadata.labels "app.kubernetes.io/name"}}` + string(os.PathSeparator) + `{{.metadata.name}}`
+	err = ExportEnvironments([]*v1alpha1.Environment{env}, outputDir, &ExportEnvOpts{
+		Format:    format,
+		Extension: "yaml",
+	})
+	require.NoError(t, err)
+
+	manifestPath := filepath.Join(outputDir, "demo", "resource.yaml")
+	_, err = os.Stat(manifestPath)
+	require.NoError(t, err)
+}
