--- a/tests/Feature/Generators/MigrationGeneratorTest.php
+++ b/tests/Feature/Generators/MigrationGeneratorTest.php
@@ -549,6 +549,50 @@ class MigrationGeneratorTest extends TestCase
         $this->assertEquals(['created' => [$post_migration, $user_migration, $image_migration]], $this->subject->output($tree));
     }
 
+    /**
+     * @test
+     */
+    public function output_works_with_multiple_morphto_statements_in_polymorphic_relationship()
+    {
+        $this->filesystem->expects('stub')
+            ->with('migration.stub')
+            ->andReturn($this->stub('migration.stub'));
+
+        $now = Carbon::now();
+        Carbon::setTestNow($now);
+
+        $image_migration = str_replace('timestamp', $now->format('Y_m_d_His'), 'database/migrations/timestamp_create_images_table.php');
+
+        $this->filesystem->expects('exists')->andReturn(false);
+
+        $this->filesystem->expects('put')
+            ->with($image_migration, \Mockery::on(function ($migration) {
+                foreach (['imageable', 'tagable'] as $relationship) {
+                    $usesMorphHelper = false;
+                    foreach (['morphs', 'nullableMorphs', 'uuidMorphs', 'ulidMorphs'] as $helper) {
+                        foreach (["'", '\"'] as $quote) {
+                            if (strpos($migration, '->' . $helper . '(' . $quote . $relationship . $quote . ')') !== false) {
+                                $usesMorphHelper = true;
+                            }
+                        }
+                    }
+                    $hasIdAndTypeColumns = strpos($migration, $relationship . '_id') !== false
+                        && strpos($migration, $relationship . '_type') !== false;
+
+                    if (! $usesMorphHelper && ! $hasIdAndTypeColumns) {
+                        return false;
+                    }
+                }
+
+                return true;
+            }));
+
+        $tokens = $this->blueprint->parse($this->fixture('drafts/polymorphic-relationships-multiple-morphto.yaml'));
+        $tree = $this->blueprint->analyze($tokens);
+
+        $this->assertEquals(['created' => [$image_migration]], $this->subject->output($tree));
+    }
+
     /**
      * @test
      */
