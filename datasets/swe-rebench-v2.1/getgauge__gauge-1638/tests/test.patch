+// assertTableDataMatchesScenarios checks that every table driven scenario in the
+// merged result points at the table row whose data is used in the scenario name.
+func assertTableDataMatchesScenarios(t *testing.T, res *result.SpecResult) {
+	t.Helper()
+	table := mergedTable(res)
+	if table == nil {
+		t.Fatalf("merged result does not contain a table")
+	}
+	for _, item := range res.ProtoSpec.Items {
+		if item.ItemType != gm.ProtoItem_TableDrivenScenario {
+			continue
+		}
+		scn := item.TableDrivenScenario
+		idx := int(scn.TableRowIndex)
+		if idx < 0 || idx >= len(table.Rows) {
+			t.Errorf("scenario %q has TableRowIndex %d which is out of range for a table with %d rows", scn.Scenario.ScenarioHeading, idx, len(table.Rows))
+			continue
+		}
+		want := strings.TrimPrefix(scn.Scenario.ScenarioHeading, "scenario ")
+		row := table.Rows[idx].Cells
+		if len(row) == 0 || row[0] != want {
+			t.Errorf("scenario %q points at table row %v, expected the row %q", scn.Scenario.ScenarioHeading, row, want)
+		}
+	}
+}
+
+func mergedTable(res *result.SpecResult) *gm.ProtoTable {
+	for _, item := range res.ProtoSpec.Items {
+		if item.ItemType == gm.ProtoItem_Table {
+			return item.Table
+		}
 	}
+	return nil
 }
 
