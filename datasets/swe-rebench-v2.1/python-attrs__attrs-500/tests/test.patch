+    @pytest.mark.parametrize("slots", [True, False])
+    @pytest.mark.parametrize("frozen", [True, False])
+    def test_auto_exc(self, slots, frozen):
+        """
+        Classes with auto_exc=True have a Exception-style __str__, are neither
+        comparable nor hashable, and store the fields additionally in
+        self.args.
+        """
+
+        @attr.s(auto_exc=True, slots=slots, frozen=frozen)
+        class FooError(Exception):
+            x = attr.ib()
+            y = attr.ib(init=False, default=42)
+            z = attr.ib(init=False)
+            a = attr.ib()
+
+        FooErrorMade = attr.make_class(
+            "FooErrorMade",
+            bases=(Exception,),
+            attrs={
+                "x": attr.ib(),
+                "y": attr.ib(init=False, default=42),
+                "z": attr.ib(init=False),
+                "a": attr.ib(),
+            },
+            auto_exc=True,
+            slots=slots,
+            frozen=frozen,
+        )
+
+        assert FooError(1, "foo") != FooError(1, "foo")
+        assert FooErrorMade(1, "foo") != FooErrorMade(1, "foo")
+
+        for cls in (FooError, FooErrorMade):
+            with pytest.raises(cls) as ei:
+                raise cls(1, "foo")
+
+            e = ei.value
+
+            assert e == e
+            assert "(1, 'foo')" == str(e)
+            assert (1, "foo") == e.args
+            # Keyword construction still follows attribute definition order.
+            assert (1, "foo") == cls(a="foo", x=1).args
+
+            with pytest.raises(TypeError):
+                hash(e)
+
+
+    def test_auto_exc_hash_true_remains_unhashable(self):
+        """Explicit hash generation does not override exception behavior."""
+
+        @attr.s(auto_exc=True, hash=True)
+        class DecoratedError(Exception):
+            x = attr.ib()
+            y = attr.ib()
+
+        MadeError = attr.make_class(
+            "MadeError",
+            {"x": attr.ib(), "y": attr.ib()},
+            bases=(Exception,),
+            auto_exc=True,
+            hash=True,
+        )
+
+        for error_type in (DecoratedError, MadeError):
+            with pytest.raises(TypeError):
+                hash(error_type("first", "second"))
+
+    def test_auto_exc_str_true_keeps_exception_string(self):
+        """Explicit attrs string generation does not replace exception str."""
+
+        @attr.s(auto_exc=True, str=True)
+        class DecoratedError(Exception):
+            x = attr.ib()
+            y = attr.ib()
+
+        MadeError = attr.make_class(
+            "MadeError",
+            {"x": attr.ib(), "y": attr.ib()},
+            bases=(Exception,),
+            auto_exc=True,
+            str=True,
+        )
+
+        for error_type in (DecoratedError, MadeError):
+            error = error_type("first", "second")
+            assert error.args == ("first", "second")
+            assert str(error) == str(error.args)
+
+    @pytest.mark.parametrize("slots", [True, False])
+    @pytest.mark.parametrize("frozen", [True, False])
+    def test_auto_exc_one_attrib(self, slots, frozen):
+        """
+        Having one attribute works with auto_exc=True.
+
+        Easy to get wrong with tuple literals.
+        """
+
+        @attr.s(auto_exc=True, slots=slots, frozen=frozen)
+        class FooError(Exception):
+            x = attr.ib()
+
+        FooError(1)
+
+    def test_auto_exc_defaults_to_false(self):
+        """Omitting auto_exc retains attrs' value-comparison behavior."""
+
+        @attr.s
+        class FooError(Exception):
+            x = attr.ib()
+
+        assert FooError(1) == FooError(1)
