+def _make_class_builder(cls, **kwargs):
+    """
+    Instantiate ``_ClassBuilder`` for *cls*.
+
+    Implementations are free to add extra constructor arguments (for example
+    to support exception classes), so only forward ``is_exc`` when the
+    constructor actually accepts it.
+    """
+    if "is_exc" not in inspect.signature(_ClassBuilder.__init__).parameters:
+        kwargs.pop("is_exc", None)
+
+    return _ClassBuilder(cls, **kwargs)
+
