+func TestPVEnableThresholdStartsThroughUpdate(t *testing.T) {
+	Voltage = 230
+	delay := 5 * time.Second
+	clck := clock.NewMock()
+	ctrl := gomock.NewController(t)
+	charger := mock.NewMockCharger(ctrl)
+	lp := &LoadPoint{
+		log:         util.NewLogger("foo"),
+		clock:       clck,
+		bus:         evbus.New(),
+		charger:     charger,
+		chargeMeter: &Null{},
+		chargeRater: &Null{},
+		chargeTimer: &Null{},
+		MinCurrent:  minA,
+		MaxCurrent:  maxA,
+		Phases:      1,
+		Mode:        api.ModePV,
+		status:      api.StatusB,
+		Enable: ThresholdConfig{
+			Threshold: -500,
+			Delay:     delay,
+		},
+	}
+
+	start := clck.Now()
+	started := false
+	charger.EXPECT().Status().Return(api.StatusB, nil).AnyTimes()
+	charger.EXPECT().Enabled().Return(false, nil).AnyTimes()
+	charger.EXPECT().MaxCurrent(gomock.Any()).Return(nil).AnyTimes()
+	charger.EXPECT().Enable(true).Do(func(bool) {
+		if elapsed := clck.Since(start); elapsed < delay {
+			t.Errorf("charging started before the enable delay elapsed: %v", elapsed)
+		}
+		started = true
+	}).Return(nil).AnyTimes()
+
+	lp.Update(-500)
+	clck.Add(delay - time.Nanosecond)
+	lp.Update(-500)
+	clck.Add(time.Nanosecond)
+	lp.Update(-500)
+	if !started {
+		t.Error("charging did not start after the enable threshold delay")
+	}
+	ctrl.Finish()
+}
