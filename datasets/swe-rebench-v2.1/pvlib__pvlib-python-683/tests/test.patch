+def test_erbs_min_cos_zenith_max_zenith():
+    times = pd.DatetimeIndex(['2016-07-19 06:11:00'], tz='America/Phoenix')
+
+    # The min_cos_zenith control keeps kt bounded near 90 degrees.
+    out = irradiance.erbs(1.0, 89.99999, times,
+                          min_cos_zenith=0.065, max_zenith=100)
+    unbounded_kt = irradiance.erbs(1.0, 89.99999, times, min_cos_zenith=0,
+                                  max_zenith=100)['kt']
+    assert np.isfinite(out['kt']).all()
+    assert (out['kt'] < unbounded_kt).all()
+
+    # The max_zenith control prevents DNI from growing at near-90 zenith.
+    out = irradiance.erbs(1.0, 89.99999, times, max_zenith=89.9)
+    unbounded_dni = irradiance.erbs(1.0, 89.99999, times, max_zenith=100)['dni']
+    assert np.isfinite(out['dni']).all()
+    assert (out['dni'] < unbounded_dni).all()
+
+
+def test_erbs_zenith_near_90():
+    times = pd.DatetimeIndex(['2016-07-19 06:11:00'], tz='America/Phoenix')
+    ghi = pd.Series([1.0], index=times)
+    zenith = pd.Series([90.0], index=times)
+
+    out = irradiance.erbs(ghi, zenith, times)
+
+    assert np.isfinite(out[['dni', 'dhi', 'kt']].to_numpy()).all()
+
+
