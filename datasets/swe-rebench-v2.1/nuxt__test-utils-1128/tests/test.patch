 import { beforeEach, describe, expect, it } from 'vitest'
 import { rollup } from 'rollup'
+import { parseAst } from 'rollup/parseAst'
 import { type MockPluginContext, createMockPlugin } from '../../src/module/plugins/mock'
 
+// The transform must always emit a syntactically valid ES module. This is the
+// behavioural property that broke when `vi` was imported explicitly: the mock
+// setup was spliced into the middle of the existing `vi` import statement.
+const parseModule = (code: string) => parseAst(code)
+
+// number of `import ... from 'vitest'` statements in the generated module
+const vitestImports = (code: string) => code.match(/from\s*['"]vitest['"]/g) ?? []
+
+// local `vi` bindings imported from Vitest, independent of formatting/order
+const vitestViBindings = (code: string) => {
+  const ast = parseModule(code) as { body: Array<{ type: string, source?: { value: string }, specifiers?: Array<{ type: string, imported?: { name?: string }, local?: { name?: string } }> }> }
+  return ast.body
+    .filter(node => node.type === 'ImportDeclaration' && node.source?.value === 'vitest')
+    .flatMap(node => node.specifiers ?? [])
+    .filter(specifier => specifier.type === 'ImportSpecifier' && specifier.imported?.name === 'vi' && specifier.local?.name === 'vi')
+}
+
+// the generated module registers a mock for `name`
+const mocksModule = (code: string, name: string) =>
+  new RegExp(`vi\\.mock\\(\\s*['"]${name}['"]`).test(code)
+
+// Run emitted registrations with an explicit vi binding, then invoke the
+// registered factory as Vitest does when importing the mocked module.
+const runMockFactory = async (code: string) => {
+  const ast = parseModule(code) as { body: Array<{ type: string, start: number, end: number }> }
+  let executable = code
+  for (const declaration of ast.body.filter(node => node.type === 'ImportDeclaration').sort((a, b) => b.start - a.start)) {
+    executable = executable.slice(0, declaration.start) + executable.slice(declaration.end)
+  }
+
+  const globals: Record<string, unknown> = {}
+  const registrations: Array<{ id: string, factory: (importOriginal: (id: string) => Promise<Record<string, unknown>>) => Promise<Record<string, unknown>> }> = []
+  const vi = {
+    hoisted: (factory: () => unknown) => factory(),
+    stubGlobal: (name: string, value: unknown) => { globals[name] = value },
+    mock: (id: string, factory: (importOriginal: (id: string) => Promise<Record<string, unknown>>) => Promise<Record<string, unknown>>) => registrations.push({ id, factory }),
+  }
+  new Function('vi', 'globalThis', executable)(vi, globals)
+  const registration = registrations.find(mock => mock.id === 'bob')
+  if (!registration) throw new Error('The transformed module did not register the expected mock')
+  return await registration.factory(async () => ({ useSomeExport: 'original' }))
+}
