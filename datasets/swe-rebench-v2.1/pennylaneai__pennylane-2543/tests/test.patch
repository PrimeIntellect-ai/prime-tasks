+    def test_gradient_of_qnode_with_hermitian(self, tol):
+        """Test that computing the gradient of a QNode that obtains the
+        expectation value of a Hermitian operator works correctly."""
+        dev = qml.device("default.qubit", wires=3)
+
+        def ansatz(a, b, c):
+            qml.RX(a, wires=0)
+            qml.RX(b, wires=1)
+            qml.RX(c, wires=2)
+            qml.CNOT(wires=[0, 1])
+            qml.CNOT(wires=[1, 2])
+
+        mx = qml.matrix(qml.PauliX(0) @ qml.PauliY(2))
+
+        @qml.qnode(dev, diff_method="adjoint")
+        def circ(a, b, c):
+            ansatz(a, b, c)
+            qml.RX(a, wires=0)
+            return qml.expval(qml.Hermitian(mx, wires=[0, 2]))
+
+        a = np.array(0.5, requires_grad=True)
+        b = np.array(0.3, requires_grad=True)
+        c = np.array(-0.7, requires_grad=True)
+
+        res = qml.grad(circ)(a, b, c)
+
+        expected = [
+            np.cos(a) * np.sin(b) * np.sin(c),
+            np.cos(b) * np.sin(a) * np.sin(c),
+            np.cos(c) * np.sin(b) * np.sin(a),
+        ]
+        assert np.allclose(res, expected, atol=tol, rtol=0)
+
+    def test_training_with_hermitian_matches_backprop(self):
+        """Training with an adjoint QNode should match backprop for a custom observable."""
+        dev = qml.device("default.qubit", wires=2)
+        observable = np.array([[1.0, 0.0], [0.0, 0.0]], requires_grad=False)
+        inputs = np.array(
+            [[0.1, 0.7], [0.5, -0.2], [-0.4, 0.8], [0.9, 0.3]], requires_grad=False
+        )
+        targets = np.array([0.2, -0.1, 0.4, 0.0], requires_grad=False)
+
+        def make_model(diff_method):
+            @qml.qnode(dev, diff_method=diff_method)
+            def model(features, weights):
+                for wire in range(2):
+                    qml.Hadamard(wires=wire)
+                    qml.RZ(2.0 * features[wire], wires=wire)
+                qml.CNOT(wires=[0, 1])
+                qml.RY(weights[0], wires=0)
+                qml.RY(weights[1], wires=1)
+                return qml.expval(qml.Hermitian(observable, wires=[0]))
+
+            return model
+
+        def train(diff_method):
+            model = make_model(diff_method)
+            weights = np.array([0.12, -0.23], requires_grad=True)
+
+            def loss(parameters):
+                predictions = np.stack([model(x, parameters) for x in inputs])
+                return np.mean((predictions - targets) ** 2)
+
+            for _ in range(8):
+                weights = weights - 0.1 * qml.grad(loss)(weights)
+
+            return weights, np.stack([model(x, weights) for x in inputs])
+
+        adjoint_weights, adjoint_predictions = train("adjoint")
+        backprop_weights, backprop_predictions = train("backprop")
+
+        assert np.allclose(adjoint_weights, backprop_weights, atol=1e-7, rtol=0)
+        assert np.allclose(adjoint_predictions, backprop_predictions, atol=1e-7, rtol=0)
+        assert not np.allclose(adjoint_weights, np.array([0.12, -0.23]))
