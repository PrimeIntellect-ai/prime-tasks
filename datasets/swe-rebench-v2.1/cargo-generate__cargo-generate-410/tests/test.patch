+#[test]
+fn it_prefers_a_specified_path_over_a_favorite() {
+    let path_template = tmp_dir()
+        .file(
+            "Cargo.toml",
+            r#"[package]
+name = "{{project-name}}"
+description = "A wonderful project"
+version = "0.1.0"
+"#,
+        )
+        .file("marker.txt", "from-path")
+        .build();
+
+    let favorite_template = tmp_dir()
+        .file(
+            "Cargo.toml",
+            r#"[package]
+name = "{{project-name}}"
+description = "A wonderful project"
+version = "0.1.0"
+"#,
+        )
+        .file("marker.txt", "from-favorite")
+        .init_git()
+        .build();
+
+    let config = tmp_dir()
+        .file(
+            "cargo-generate",
+            format!(
+                "[favorites.test]\ndescription = \"test\"\ngit = \"{}\"\n",
+                favorite_template.path().display()
+            )
+            .as_str(),
+        )
+        .build();
+
+    let dir = tmp_dir().build();
+
+    binary()
+        .arg("generate")
+        .arg("--config")
+        .arg(config.path().join("cargo-generate"))
+        .arg("--name")
+        .arg("foobar-project")
+        .arg("--path")
+        .arg(path_template.path())
+        .arg("test")
+        .current_dir(&dir.path())
+        .assert()
+        .success()
+        .stdout(predicates::str::contains("Done!").from_utf8());
+
+    assert_eq!(dir.read("foobar-project/marker.txt"), "from-path");
+}
