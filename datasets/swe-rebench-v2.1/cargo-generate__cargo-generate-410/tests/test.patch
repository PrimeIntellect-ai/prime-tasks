+#[test]
+fn it_can_use_a_specified_path() {
+    let template = tmp_dir()
+        .file(
+            "Cargo.toml",
+            r#"[package]
+name = "{{project-name}}"
+description = "A wonderful project"
+version = "0.1.0"
+"#,
+        )
+        .build();
+
+    let dir = tmp_dir().build();
+
+    binary()
+        .arg("generate")
+        .arg("--name")
+        .arg("foobar-project")
+        .arg("--path")
+        .arg(template.path())
+        .current_dir(&dir.path())
+        .assert()
+        .success()
+        .stdout(predicates::str::contains("Done!").from_utf8());
+
+    Command::new("git")
+        .arg("status")
+        .current_dir(&dir.path().join("foobar-project"))
+        .assert()
+        .success()
+        .stdout(predicates::str::contains("On branch main").from_utf8());
+}
+
