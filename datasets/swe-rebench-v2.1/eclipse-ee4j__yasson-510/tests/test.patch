+    @Test
+    public void testImplicitJsonbSerializers() {
+        Jsonb jsonb = JsonbBuilder.create(new JsonbConfig().withSerializers(new ExplicitJsonbSerializer()));
+        String expected = "{\"value\":\"123\"}";
+        Box box = new Box();
+        box.boxStr = "Box";
+        assertEquals(expected, jsonb.toJson(box));
