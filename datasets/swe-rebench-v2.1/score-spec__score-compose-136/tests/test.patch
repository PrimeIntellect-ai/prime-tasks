+
+func TestGeneratePreservesWorkloadAnnotationsAfterRegeneration(t *testing.T) {
+	td := changeToTempDir(t)
+	stdout, _, err := executeAndResetCommand(context.Background(), rootCmd, []string{"init"})
+	assert.NoError(t, err)
+	assert.Equal(t, "", stdout)
+	assert.NoError(t, os.WriteFile(filepath.Join(td, "score.yaml"), []byte(`
+apiVersion: score.dev/v1b1
+metadata:
+  name: example
+  annotations:
+    example.com/fizz: buzz
+containers:
+  example:
+    image: foo
+`), 0644))
+	var composeDoc struct {
+		Services map[string]struct {
+			Annotations map[string]string `yaml:"annotations"`
+		} `yaml:"services"`
+	}
+	stdout, _, err = executeAndResetCommand(context.Background(), rootCmd, []string{"generate", "score.yaml"})
+	assert.NoError(t, err)
+
+	raw, err := os.ReadFile(filepath.Join(td, "compose.yaml"))
+	assert.NoError(t, err)
+	assert.NoError(t, yaml.Unmarshal(raw, &composeDoc))
+	assert.Equal(t, "buzz", composeDoc.Services["example-example"].Annotations["example.com/fizz"])
+
+	stdout, _, err = executeAndResetCommand(context.Background(), rootCmd, []string{"generate"})
+	assert.NoError(t, err)
+
+	raw, err = os.ReadFile(filepath.Join(td, "compose.yaml"))
+	assert.NoError(t, err)
+	assert.NoError(t, yaml.Unmarshal(raw, &composeDoc))
+	assert.Equal(t, "buzz", composeDoc.Services["example-example"].Annotations["example.com/fizz"])
+
+	// Adding a second copy of the workload must not drop the annotations from the
+	// existing workload.
+	assert.NoError(t, os.WriteFile(filepath.Join(td, "score2.yaml"), []byte(`
+apiVersion: score.dev/v1b1
+metadata:
+  name: example2
+  annotations:
+    example.com/fizz: buzz
+containers:
+  example:
+    image: foo
+`), 0644))
+	stdout, _, err = executeAndResetCommand(context.Background(), rootCmd, []string{"generate", "score2.yaml"})
+	assert.NoError(t, err)
+
+	raw, err = os.ReadFile(filepath.Join(td, "compose.yaml"))
+	assert.NoError(t, err)
+	assert.NoError(t, yaml.Unmarshal(raw, &composeDoc))
+	assert.Equal(t, "buzz", composeDoc.Services["example-example"].Annotations["example.com/fizz"])
+	assert.Equal(t, "buzz", composeDoc.Services["example2-example"].Annotations["example.com/fizz"])
+}
