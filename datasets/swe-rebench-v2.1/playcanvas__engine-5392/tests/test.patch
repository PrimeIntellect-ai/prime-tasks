+
+describe('AnimComponent#reset', function () {
+
+    let app;
+
+    beforeEach(function () {
+        const canvas = new HTMLCanvasElement(500, 500);
+        app = new Application(canvas);
+    });
+
+    afterEach(function () {
+        app.destroy();
+    });
+
+    it('copies state graph parameters so instance changes do not mutate the origin', function () {
+        const entity = new Entity();
+        entity.addComponent('anim');
+        const stateGraph = new AnimStateGraph({
+            layers: [
+                {
+                    name: 'Base',
+                    states: [
+                        { name: 'START', speed: 1 },
+                        { name: 'Initial State', speed: 1, loop: true, defaultState: true }
+                    ],
+                    transitions: [
+                        { from: 'START', to: 'Initial State' }
+                    ]
+                }
+            ],
+            parameters: {
+                param: { name: 'param', type: 'FLOAT', value: 0.5 },
+                enabled: { name: 'enabled', type: 'BOOLEAN', value: false }
+            }
+        });
+        entity.anim.loadStateGraph(stateGraph);
+        entity.anim.setFloat('param', 1.5);
+        entity.anim.setBoolean('enabled', true);
+        entity.anim.reset();
+        expect(entity.anim.getFloat('param')).to.equal(0.5);
+        expect(entity.anim.getBoolean('enabled')).to.equal(false);
+        entity.anim.setFloat('param', 2.5);
+        entity.anim.setBoolean('enabled', true);
+        expect(stateGraph.parameters.param.value).to.equal(0.5);
+        expect(stateGraph.parameters.enabled.value).to.equal(false);
+    });
+
+});
