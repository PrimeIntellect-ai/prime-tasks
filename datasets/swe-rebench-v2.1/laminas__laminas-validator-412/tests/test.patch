@@ -144,4 +145,34 @@ final class RegexTest extends TestCase
         /** @psalm-suppress InvalidArgument */
         new Regex($options);
     }
+
+    public function testTranslatorOptionIsAppliedAlongsideMessageOverrides(): void
+    {
+        $translator = new Translator([
+            "The input does not match against pattern '%pattern%'" => 'Translated mismatch',
+        ]);
+        $validator = new Regex([
+            'pattern'    => '/^\\d+$/',
+            'translator' => $translator,
+        ]);
+
+        self::assertFalse($validator->isValid('not a number'));
+        self::assertSame(['Translated mismatch'], array_values($validator->getMessages()));
+    }
+
+    public function testMessageOptionsOverrideTheDefaultRegexFailureMessage(): void
+    {
+        $validator = new Regex([
+            'pattern'  => '/^\d+$/',
+            'messages' => [
+                Regex::NOT_MATCH => 'Numbers only',
+            ],
+        ]);
+
+        self::assertFalse($validator->isValid('Not numbers'));
+        $messages = $validator->getMessages();
+        self::assertSame([
+            Regex::NOT_MATCH => 'Numbers only',
+        ], $messages);
+    }
 }
