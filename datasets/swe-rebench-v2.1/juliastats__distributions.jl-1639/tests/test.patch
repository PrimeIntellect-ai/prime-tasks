@@ -0,0 +1,37 @@
+using Distributions
+
+using Test
+
+@testset "weibull.jl" begin
+    # issue #1638
+    @testset "pdf/logpdf: special cases" begin
+        for S in (Float32, Float64), T in (Int, Float64, Float32)
+            for α in (1, 2, 2.5), θ in (1, 1.5, 3)
+                d = Weibull(S(α), S(θ))
+
+                # negative inputs: pdf is zero, logpdf is -Inf
+                @test pdf(d, T(-3)) == 0
+                @test logpdf(d, T(-3)) == -Inf
+
+                # zero input
+                @test pdf(d, T(0)) ≈ (α == 1 ? S(α) / S(θ) : 0)
+                if α != 1
+                    @test logpdf(d, T(0)) ≈ -Inf
+                end
+
+                # positive finite input: matches the density formula
+                x = T(2)
+                z = abs(x) / S(θ)
+                @test pdf(d, x) ≈ (S(α) / S(θ)) * z^(S(α) - 1) * exp(-z^S(α))
+                @test logpdf(d, x) ≈ log(S(α) / S(θ)) + (S(α) - 1) * log(z) - z^S(α)
+
+                if T <: AbstractFloat
+                    @test pdf(d, T(-Inf)) == 0
+                    @test logpdf(d, T(-Inf)) == -Inf
+                    @test pdf(d, T(Inf)) == 0
+                    @test logpdf(d, T(Inf)) == -Inf
+                end
+            end
+        end
+    end
+end
