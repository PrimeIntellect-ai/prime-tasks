+def test_parse_array_dimensions_attributes(fortran_reader):
+    """Check that array attributes are represented through declarations."""
+    code = """subroutine test(var1, var1_upper)
+      integer, intent(in) :: var1, var1_upper
+      integer, dimension(:) :: array1
+      integer, dimension(:,:,:) :: array2
+      integer, dimension(3,5) :: array3
+      integer, dimension(var1) :: array4
+      integer, dimension(0:3,var1) :: array5
+      integer, dimension(0:3,var1:var1_upper) :: array6
+    end subroutine
+    """
+    routine = fortran_reader.psyir_from_source(code).walk(Routine)[0]
+    symbols = routine.symbol_table
+    assert symbols.lookup("array1").datatype.shape == [ArrayType.Extent.ATTRIBUTE]
+    assert symbols.lookup("array2").datatype.shape == [
+        ArrayType.Extent.ATTRIBUTE] * 3
+    shape = symbols.lookup("array3").datatype.shape
+    assert [dim.upper.value for dim in shape] == ["3", "5"]
+    assert all(dim.lower.value == "1" for dim in shape)
+    shape = symbols.lookup("array4").datatype.shape
+    assert shape[0].lower.value == "1"
+    assert shape[0].upper.symbol is symbols.lookup("var1")
+    shape = symbols.lookup("array5").datatype.shape
+    assert shape[0].lower.value == "0" and shape[0].upper.value == "3"
+    assert shape[1].lower.value == "1"
+    assert shape[1].upper.symbol is symbols.lookup("var1")
+    shape = symbols.lookup("array6").datatype.shape
+    assert shape[1].lower.symbol is symbols.lookup("var1")
+    assert shape[1].upper.symbol is symbols.lookup("var1_upper")
 
 
