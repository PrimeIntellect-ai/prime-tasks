+def test_structure_component_array_bounds(f2008_parser):
+    '''Check array bounds on a structure component are expression nodes.'''
+    test_code = '''\
+    subroutine test()
+      integer, parameter :: nelem = 10
+      type :: y
+        integer, dimension(3) :: jp
+      end type
+      type :: x
+        type(y), dimension(nelem) :: y
+      end type
+    end subroutine'''
+    reader = FortranStringReader(test_code)
+    ptree = f2008_parser(reader)
+    processor = Fparser2Reader()
+    psyir = processor.generate_psyir(ptree)
+    routine = psyir.walk(Routine)[0]
+    table = routine.symbol_table
+    xsym = table.lookup("x")
+    assert isinstance(xsym, DataTypeSymbol)
+    dtype = xsym.datatype
+    assert isinstance(dtype, StructureType)
+    ycompt = dtype.components["y"]
+    # The member 'y' must be an array whose shape refers to "nelem" in the
+    # table of the Routine.
+    assert isinstance(ycompt.datatype, ArrayType)
+    assert isinstance(ycompt.datatype.shape[0], ArrayType.ArrayBounds)
+    assert isinstance(ycompt.datatype.shape[0].lower, DataNode)
+    assert isinstance(ycompt.datatype.shape[0].upper, DataNode)
