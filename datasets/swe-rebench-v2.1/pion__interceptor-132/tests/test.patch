+
+func TestSendSideBWE_WriteRTCPAfterCloseDoesNotPanic(t *testing.T) {
+	bwe, err := NewSendSideBWE()
+	require.NoError(t, err)
+	_ = bwe.Close()
+
+	pkts := []rtcp.Packet{&rtcp.TransportLayerCC{}}
+	require.NotPanics(t, func() {
+		_ = bwe.WriteRTCP(pkts, nil)
+	})
+}
+
+func TestSendSideBWE_WriteRTCPConcurrentWithCloseDoesNotPanic(t *testing.T) {
+	bwe, err := NewSendSideBWE()
+	require.NoError(t, err)
+
+	// A large report keeps WriteRTCP busy after it has started, so Close races
+	// with processing of the feedback rather than only with the initial call.
+	feedback := &rtcp.TransportLayerCC{
+		PacketChunks: []rtcp.PacketStatusChunk{
+			&rtcp.RunLengthChunk{
+				PacketStatusSymbol: rtcp.TypeTCCPacketNotReceived,
+				RunLength:          60000,
+			},
+		},
+	}
+	writeStarted := make(chan struct{})
+	writeDone := make(chan struct{})
+	writePanic := make(chan interface{}, 1)
+	go func() {
+		defer close(writeDone)
+		defer func() {
+			if recovered := recover(); recovered != nil {
+				writePanic <- recovered
+			}
+		}()
+		close(writeStarted)
+		_ = bwe.WriteRTCP([]rtcp.Packet{feedback}, nil)
+	}()
+
+	<-writeStarted
+	time.Sleep(time.Millisecond)
+	_ = bwe.Close()
+	<-writeDone
+	select {
+	case recovered := <-writePanic:
+		require.Failf(t, "WriteRTCP panicked while Close was in progress", "%v", recovered)
+	default:
+	}
+}
