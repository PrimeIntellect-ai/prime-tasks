+  private static Geometry removeRepeatedPoints(Geometry geom) {
+    if (geom instanceof Polygon) {
+      Polygon poly = (Polygon) geom;
+      LinearRing shell = removeRepeatedPoints(poly.getExteriorRing());
+      LinearRing[] holes = new LinearRing[poly.getNumInteriorRing()];
+      for (int i = 0; i < holes.length; i++) {
+        holes[i] = removeRepeatedPoints(poly.getInteriorRingN(i));
+      }
+      return geom.getFactory().createPolygon(shell, holes);
+    }
+    if (geom instanceof MultiPolygon) {
+      MultiPolygon mp = (MultiPolygon) geom;
+      Polygon[] polys = new Polygon[mp.getNumGeometries()];
+      for (int i = 0; i < polys.length; i++) {
+        polys[i] = (Polygon) removeRepeatedPoints(mp.getGeometryN(i));
+      }
+      return geom.getFactory().createMultiPolygon(polys);
+    }
+    return geom;
+  }
+
+  private static LinearRing removeRepeatedPoints(LineString ring) {
+    Coordinate[] pts = CoordinateArrays.removeRepeatedPoints(ring.getCoordinates());
+    return ring.getFactory().createLinearRing(pts);
   }
