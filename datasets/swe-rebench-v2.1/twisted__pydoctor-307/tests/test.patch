+def test_cache_can_be_disabled() -> None:
+    """A CLI option can disable intersphinx object caching."""
+    defaults, _ = driver.getparser().parse_args([])
+    assert defaults.enable_intersphinx_cache
+
+    help_text = driver.getparser().format_help()
+    flags = re.findall(r"(?<!\w)(?:--[\w-]+|-[A-Za-z])(?=[\s,=])", help_text)
+    values = ("off", "false", "0", "no", "disabled")
+    attempts = [[flag] for flag in flags]
+    for flag in flags:
+        attempts.extend([[flag, value] for value in values])
+        attempts.extend([[f"{flag}={value}"] for value in values])
+
+    for arguments in attempts:
+        try:
+            with redirect_stdout(StringIO()), redirect_stderr(StringIO()):
+                options, _ = driver.getparser().parse_args(arguments)
+        except SystemExit:
+            continue
+        if not options.enable_intersphinx_cache:
+            return
+
+    assert False, "no CLI option disables intersphinx caching"
 
 
