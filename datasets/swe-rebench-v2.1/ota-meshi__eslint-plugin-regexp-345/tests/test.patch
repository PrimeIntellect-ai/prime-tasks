diff --git a/tests/lib/rules/use-ignore-case.ts b/tests/lib/rules/use-ignore-case.ts
new file mode 100644
index 0000000..189b1db
--- /dev/null
+++ b/tests/lib/rules/use-ignore-case.ts
@@ -0,0 +1,50 @@
+import { RuleTester } from "eslint"
+import plugin from "../../../lib"
+
+const rule = plugin.rules["use-ignore-case"]
+
+const tester = new RuleTester({
+    parserOptions: {
+        ecmaVersion: 2020,
+        sourceType: "module",
+    },
+})
+
+tester.run("use-ignore-case", rule as any, {
+    valid: [
+        String.raw`/regexp/`,
+        String.raw`/[aA]/i`,
+        String.raw`/[aA]a/`,
+        String.raw`/[aAb]/`,
+        String.raw`/[aaaa]/`,
+
+        // adding the `i` flag would change which characters the pattern matches
+        String.raw`/[a-zA-Z]b/`,
+        String.raw`/[a-zA-Z]B/`,
+        // In Unicode mode, adding `i` changes which characters `\w` matches.
+        String.raw`/[aA]\w/u`,
+    ],
+    invalid: [
+        {
+            code: String.raw`/[a-zA-Z]/`,
+            output: String.raw`/[a-z]/i`,
+            errors: [
+                "The character class(es) '[a-zA-Z]' can be simplified using the `i` flag.",
+            ],
+        },
+        {
+            code: String.raw`/\b0[xX][a-fA-F0-9]+\b/`,
+            output: String.raw`/\b0[x][a-f0-9]+\b/i`,
+            errors: [
+                "The character class(es) '[xX]', '[a-fA-F0-9]' can be simplified using the `i` flag.",
+            ],
+        },
+        {
+            code: String.raw`RegExp("[a-zA-Z]")`,
+            output: String.raw`RegExp("[a-z]", "i")`,
+            errors: [
+                "The character class(es) '[a-zA-Z]' can be simplified using the `i` flag.",
+            ],
+        },
+    ],
+})
