+def test_can_respond_with_cookies():
+    router = respx.MockRouter(using=None)
+    router.get("https://foo.bar/").respond(cookies={"foo": "bar", "ham": "spam"})
+    transport = httpx.MockTransport(router.handler)
+    with httpx.Client(transport=transport) as client:
+        response = client.get("https://foo.bar/")
+    assert dict(response.cookies) == {"foo": "bar", "ham": "spam"}
+
+
+def test_can_respond_with_httpx_cookies():
+    cookies = httpx.Cookies()
+    router = respx.MockRouter(using=None)
+    router.get("https://foo.bar/").respond(cookies=cookies)
+    transport = httpx.MockTransport(router.handler)
+    with httpx.Client(transport=transport) as client:
+        response = client.get("https://foo.bar/")
+    assert response.status_code == 200
+
