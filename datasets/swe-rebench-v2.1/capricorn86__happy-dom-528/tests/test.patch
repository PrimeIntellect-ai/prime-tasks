+/**
+ * Minimal implementation of dom-testing-library's getByRole() role resolution.
+ * It resolves the implicit role of an element by matching it against the
+ * ARIA in HTML role selectors.
+ *
+ * @param container Container to search in.
+ * @param role Role to find.
+ * @returns Matching element or null.
+ */
+function getByRole(
+	container: IHTMLElement,
+	role: string,
+	options: { name?: RegExp } = {}
+): IHTMLElement {
+	const roleSelectors = {
+		searchbox: (element: IHTMLElement) =>
+			element.matches('input:not([list])[type="search"]'),
+		textbox: (element: IHTMLElement) =>
+			element.matches('input:not([list])') && element.getAttribute('type') === 'text',
+		checkbox: (element: IHTMLElement) => element.matches('input:not([list])[type="checkbox"]')
+	};
+	const elements = <IHTMLElement[]>Array.from(container.querySelectorAll('*'));
+	return (
+		elements.find((element) => {
+			if (!roleSelectors[role](element)) {
+				return false;
+			}
+			const accessibleName = element.getAttribute('aria-label');
+			return !options.name || (!!accessibleName && options.name.test(accessibleName));
+		}) || null
+	);
+}
+
