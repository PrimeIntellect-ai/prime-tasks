--- /dev/null
+++ b/tests/float.rs
@@ -0,0 +1,15 @@
+#[macro_use]
+mod support;
+
+mod float32 {
+    use glam::FloatExt;
+
+    glam_test!(test_lerp, {
+        let start = -4.0_f32;
+        let end = 12.0_f32;
+        assert_eq!(f32::lerp(start, end, 0.0), start);
+        assert_eq!(f32::lerp(start, end, 0.25), 0.0);
+        assert_eq!(f32::lerp(start, end, 0.5), 4.0);
+        assert_eq!(f32::lerp(start, end, 1.0), end);
+    });
+}
