+def test_tags_can_be_used_when_ctypes_cannot_be_imported():
+    script = """
+import builtins
+original_import = builtins.__import__
+def import_without_ctypes(name, *args, **kwargs):
+    if name == "ctypes":
+        raise ImportError("ctypes is unavailable")
+    return original_import(name, *args, **kwargs)
+builtins.__import__ = import_without_ctypes
+import platform
+from packaging import tags
+generated = list(tags.sys_tags())
+assert generated
+system = platform.system()
+if system == "Linux":
+    assert any(
+        tag.platform.startswith(("linux_", "manylinux")) for tag in generated
+    )
+elif system == "Darwin":
+    assert any(tag.platform.startswith("macosx_") for tag in generated)
+elif system == "Windows":
+    assert any(tag.platform.startswith("win_") for tag in generated)
+else:
+    assert any(tag.platform != "any" for tag in generated)
+"""
+    subprocess.check_call([sys.executable, "-c", script])
 
 
