+    def test_append_unsupported_type_raises_on_append(self):
+        writer = aiohttp.multipart.MultipartWriter(boundary=':')
+        with self.assertRaises(TypeError):
+            writer.append(object())
+
+    def test_append_int_does_not_fail_when_serialized(self):
+        writer = aiohttp.multipart.MultipartWriter(boundary=':')
+        try:
+            writer.append(1)
+        except TypeError:
+            # rejecting the value early on append is acceptable
+            return
+        body = b''.join(writer.serialize())
+        self.assertIn(b'1', body)
+
 
