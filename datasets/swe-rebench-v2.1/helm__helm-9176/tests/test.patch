+func TestChartOperationsRejectDependencyClash(t *testing.T) {
+	root, err := filepath.Abs("../../../")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cli := filepath.Join(t.TempDir(), "helm")
+	build := exec.Command("go", "build", "-o", cli, "./cmd/helm")
+	build.Dir = root
+	if output, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("building Helm CLI: %v\n%s", err, output)
+	}
+
+	chartDir := filepath.Join(t.TempDir(), "clashing-chart")
+	if err := os.MkdirAll(filepath.Join(chartDir, "charts", "foo"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	chartYAML := `apiVersion: v2
+name: clashing-chart
+version: 0.1.0
+dependencies:
+  - name: foo
+    version: 1.0.0
+  - name: foo
+    version: 1.2.3
+`
+	if err := os.WriteFile(filepath.Join(chartDir, "Chart.yaml"), []byte(chartYAML), 0644); err != nil {
+		t.Fatal(err)
+	}
+	subchartYAML := `apiVersion: v2
+name: foo
+version: 1.0.0
+`
+	if err := os.WriteFile(filepath.Join(chartDir, "charts", "foo", "Chart.yaml"), []byte(subchartYAML), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	home := t.TempDir()
+	operations := []struct {
+		name string
+		args []string
+	}{
+		{name: "template", args: []string{"template", chartDir}},
+		{name: "install", args: []string{"install", "--dry-run", "clash-test", chartDir}},
+		{name: "upgrade", args: []string{"upgrade", "--dry-run", "clash-test", chartDir}},
+	}
+	for _, operation := range operations {
+		t.Run(operation.name, func(t *testing.T) {
+			cmd := exec.Command(cli, operation.args...)
+			cmd.Env = append(os.Environ(), "HOME="+home)
+			output, err := cmd.CombinedOutput()
+			if err == nil {
+				t.Fatalf("%s succeeded for a chart with clashing dependencies", operation.name)
+			}
+			if !strings.Contains(string(output), "foo") {
+				t.Fatalf("%s did not identify the conflicting dependency: %s", operation.name, output)
+			}
+		})
+	}
+}
