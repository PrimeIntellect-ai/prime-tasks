+func TestDependenciesUnique(t *testing.T) {
+	// A chart whose declared dependencies clash must be rejected when it is
+	// loaded for templating, installation or upgrading.
+	tests := []struct {
+		name      string
+		chartYaml string
+	}{
+		{
+			"duplicate dependency names",
+			`apiVersion: v2
+name: badchart
+version: 0.1.0
+dependencies:
+  - name: foo
+    version: 1.0.0
+  - name: foo
+    version: 1.2.3
+`,
+		},
+		{
+			"alias shadowing a dependency name",
+			`apiVersion: v2
+name: badchart
+version: 0.1.0
+dependencies:
+  - name: foo
+    alias: bar
+    version: 1.0.0
+  - name: bar
+    version: 1.0.0
+`,
+		},
+		{
+			"duplicate dependency aliases",
+			`apiVersion: v2
+name: badchart
+version: 0.1.0
+dependencies:
+  - name: foo
+    alias: baz
+    version: 1.0.0
+  - name: bar
+    alias: baz
+    version: 1.0.0
+`,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			dir := t.TempDir()
+			if err := os.WriteFile(filepath.Join(dir, "Chart.yaml"), []byte(tt.chartYaml), 0644); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := loader.LoadDir(dir); err == nil {
+				t.Error("expected loading a chart with clashing dependencies to fail")
+			}
+		})
+	}
+}
+
+func TestDependenciesUniqueLint(t *testing.T) {
+	cases := []struct {
+		name      string
+		chartYAML string
+	}{
+		{
+			name: "duplicate names",
+			chartYAML: `apiVersion: v2
+name: badchart
+version: 0.1.0
+dependencies:
+  - name: foo
+    version: 1.0.0
+  - name: foo
+    version: 1.2.3
+`,
+		},
+		{
+			name: "duplicate aliases",
+			chartYAML: `apiVersion: v2
+name: badchart
+version: 0.1.0
+dependencies:
+  - name: foo
+    alias: baz
+    version: 1.0.0
+  - name: bar
+    alias: baz
+    version: 1.0.0
+`,
+		},
+		{
+			name: "alias shadows a dependency name",
+			chartYAML: `apiVersion: v2
+name: badchart
+version: 0.1.0
+dependencies:
+  - name: foo
+    alias: bar
+    version: 1.0.0
+  - name: bar
+    version: 1.0.0
+`,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			if err := os.WriteFile(filepath.Join(dir, "Chart.yaml"), []byte(tc.chartYAML), 0644); err != nil {
+				t.Fatal(err)
+			}
+			for _, name := range []string{"foo", "bar"} {
+				subDir := filepath.Join(dir, "charts", name)
+				if err := os.MkdirAll(subDir, 0755); err != nil {
+					t.Fatal(err)
+				}
+				subChartYAML := "apiVersion: v2\nname: " + name + "\nversion: 1.0.0\n"
+				if err := os.WriteFile(filepath.Join(subDir, "Chart.yaml"), []byte(subChartYAML), 0644); err != nil {
+					t.Fatal(err)
+				}
+			}
+
+			linter := support.Linter{ChartDir: dir}
+			Dependencies(&linter)
+			if len(linter.Messages) == 0 {
+				t.Error("expected linting a chart with clashing dependencies to report an error")
+			}
+		})
+	}
+}
