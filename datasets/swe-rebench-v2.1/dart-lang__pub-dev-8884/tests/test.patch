+import 'package:html/parser.dart' show HtmlParser;
+import 'package:test/test.dart';
+
+import '../../shared/test_services.dart';
+import '_utils.dart';
+
+/// Whether the page offers a way to search for [query].
+///
+/// The contract allows this either as a link to the search page or by
+/// pre-filling the search bar, so both forms are accepted.
+bool _offersSearchFor(String content, String query) {
+  if (content.contains('/packages?q=$query')) return true;
+  final document = HtmlParser(content).parse();
+  final searchInput = document.querySelector('input[name="q"]');
+  return searchInput?.attributes['value'] == query;
+}
+
+void main() {
+  group('404 page', () {
+    testWithProfile('without additional action', fn: () async {
+      final rs = await issueGet('/subdir/not-existing-package');
+      await expectHtmlResponse(
+        rs,
+        status: 404,
+        present: [
+          '404 Not Found',
+        ],
+      );
+    });
+
+    testWithProfile('link to package page', fn: () async {
+      final rs = await issueGet('/oxygen');
+      final content = await expectHtmlResponse(
+        rs,
+        status: 404,
+        present: [
+          '404 Not Found',
+          '/packages/oxygen', // link to package page
+        ],
+      );
+      expect(
+        _offersSearchFor(content, 'oxygen'),
+        isTrue,
+        reason: 'Expected a search action for "oxygen".',
+      );
+    });
+
+    testWithProfile('link to search page', fn: () async {
+      final rs = await issueGet('/not-oxygen');
+      final content = await expectHtmlResponse(
+        rs,
+        status: 404,
+        present: [
+          '404 Not Found',
+        ],
+        absent: [
+          '/packages/not-oxygen', // link to package page
+        ],
+      );
+      expect(
+        _offersSearchFor(content, 'not-oxygen'),
+        isTrue,
+        reason: 'Expected a search action for "not-oxygen".',
+      );
+    });
+  });
+}
