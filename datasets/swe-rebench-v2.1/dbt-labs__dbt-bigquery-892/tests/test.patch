+    def test_partition_config_parse_validates_direct_input(self):
+        from dbt.adapters.bigquery import PartitionConfig as PublicPartitionConfig
+
+        config = PublicPartitionConfig.parse(
+            {
+                "field": "created_at",
+                "data_type": "timestamp",
+                "granularity": "hour",
+                "time_ingestion_partitioning": True,
+                "copy_partitions": False,
+            }
+        )
+        assert isinstance(config, PublicPartitionConfig)
+        assert config.field == "created_at"
+        assert config.data_type == "timestamp"
+        assert config.granularity == "hour"
+        assert config.time_ingestion_partitioning is True
+        assert config.copy_partitions is False
+
+        with self.assertRaises(dbt.exceptions.DbtValidationError):
+            PublicPartitionConfig.parse({"field": 123})
+
+    def test_parse_partition_by_invalid_types(self):
+        with self.assertRaises(dbt.exceptions.DbtValidationError):
+            PartitionConfig.parse({"field": "ts", "time_ingestion_partitioning": "not-a-bool"})
+
+        with self.assertRaises(dbt.exceptions.DbtValidationError):
+            PartitionConfig.parse({"field": 123})
+
