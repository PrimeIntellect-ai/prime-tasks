diff --git a/tests/test_settings.py b/tests/test_settings.py
index c11cdbb..344385a 100644
--- a/tests/test_settings.py
+++ b/tests/test_settings.py
@@ -890,6 +890,57 @@ def test_secrets_path(tmp_path):
     assert Settings().dict() == {'foo': 'foo_secret_value_str'}
 
 
+def test_secrets_case_sensitive(tmp_path):
+    (tmp_path / 'SECRET_VAR').write_text('foo_env_value_str')
+
+    class Settings(BaseSettings):
+        secret_var: Optional[str]
+
+        class Config:
+            secrets_dir = tmp_path
+            case_sensitive = True
+
+    assert Settings().dict() == {'secret_var': None}
+
+
+def test_secrets_case_sensitive_matching(tmp_path):
+    (tmp_path / 'secret_var').write_text('exact_case_secret')
+
+    class Settings(BaseSettings):
+        secret_var: Optional[str]
+
+        class Config:
+            secrets_dir = tmp_path
+            case_sensitive = True
+
+    assert Settings().secret_var == 'exact_case_secret'
+
+
+def test_secrets_case_insensitive(tmp_path):
+    (tmp_path / 'SECRET_VAR').write_text('foo_env_value_str')
+
+    class Settings(BaseSettings):
+        secret_var: Optional[str]
+
+        class Config:
+            secrets_dir = tmp_path
+            case_sensitive = False
+
+    settings = Settings().dict()
+    assert settings == {'secret_var': 'foo_env_value_str'}
+
+
+def test_find_case_path(tmp_path):
+    from pydantic.env_settings import find_case_path
+
+    (tmp_path / 'SECRET_VAR').write_text('foo_env_value_str')
+
+    assert find_case_path(tmp_path, 'SECRET_VAR', case_sensitive=True) == tmp_path / 'SECRET_VAR'
+    assert find_case_path(tmp_path, 'secret_var', case_sensitive=True) is None
+    assert find_case_path(tmp_path, 'secret_var', case_sensitive=False) == tmp_path / 'SECRET_VAR'
+    assert find_case_path(tmp_path, 'missing', case_sensitive=False) is None
+
+
 def test_secrets_path_url(tmp_path):
     (tmp_path / 'foo').write_text('http://www.example.com')
     (tmp_path / 'bar').write_text('snap')
@@ -940,6 +991,7 @@ def test_secrets_missing(tmp_path):
 
     with pytest.raises(ValidationError) as exc_info:
         Settings()
+
     assert exc_info.value.errors() == [{'loc': ('foo',), 'msg': 'field required', 'type': 'value_error.missing'}]
 
 
