+#[test]
+fn wrap_multiline_keeps_existing_behavior() {
+    let table = init_table::<3, 3, _, _>([
+        ((0, 1), "H\nel\nlo World"),
+        ((2, 2), "multi\nline string\n"),
+    ])
+    .with(Style::markdown())
+    .with(Modify::new(Columns::new(1..2).not(Rows::single(0))).with(Width::wrap(3)))
+    .to_string();
+
+    assert_eq!(
+        table,
+        static_table!(
+            "| N | column 0 |  column 1   | column 2 |"
+            "|---|----------|-------------|----------|"
+            "| 0 |   H      |     0-1     |   0-2    |"
+            "|   |   el     |             |          |"
+            "|   |          |             |          |"
+            "|   |   lo     |             |          |"
+            "|   |   Wor    |             |          |"
+            "|   |   ld     |             |          |"
+            "| 1 |   1-0    |     1-1     |   1-2    |"
+            "| 2 |   2-0    | multi       |   2-2    |"
+            "|   |          | line string |          |"
+            "|   |          |             |          |"
+        )
+    );
+}
