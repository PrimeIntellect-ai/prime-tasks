+#[test]
+fn table_truncate_multiline_priority() {
+    let table = init_table::<3, 3, _, _>([
+        ((0, 1), "H\nel\nlo World"),
+        ((2, 2), "multi\nline string\n"),
+    ])
+    .with(Style::markdown())
+    .with(Width::truncate(20).priority::<PriorityMax>().multiline())
+    .to_string();
+
+    assert_eq!(
+        table,
+        static_table!(
+            "| N | co | co | co |"
+            "|---|----|----|----|"
+            "| 0 | H  | 0- | 0- |"
+            "|   | el |    |    |"
+            "|   | lo |    |    |"
+            "| 1 | 1- | 1- | 1- |"
+            "| 2 | 2- | mu | 2- |"
+            "|   |    | li |    |"
+            "|   |    |    |    |"
+        )
+    );
+}
