+    suffix: &'a str,
+    width: usize,
+    twidth: usize,
+    suffix_color: bool,
+) -> Cow<'a, str> {
+    if width == 0 {
+        if twidth == 0 {
+            Cow::Borrowed("")
+        } else {
+            Cow::Borrowed(suffix)
+        }
+    } else {
+        truncate_text(text, width, suffix, suffix_color)
+    }
+}
