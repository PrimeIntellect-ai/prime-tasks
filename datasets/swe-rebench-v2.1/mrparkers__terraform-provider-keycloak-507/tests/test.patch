+// TestKeycloakClientAdditionalHeaders verifies that headers supplied to the
+// client constructor are attached to every outgoing Keycloak REST request,
+// including the authentication request and regular admin API requests.
+func TestKeycloakClientAdditionalHeaders(t *testing.T) {
+	additionalHeaders := map[string]string{
+		"foo": "bar",
+	}
+
+	var mu sync.Mutex
+	type recordedRequest struct {
+		path   string
+		header http.Header
+	}
+	var recorded []recordedRequest
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		recorded = append(recorded, recordedRequest{path: r.URL.Path, header: r.Header.Clone()})
+		mu.Unlock()
+
+		w.Header().Set("Content-Type", "application/json")
+		switch {
+		case strings.HasSuffix(r.URL.Path, "/protocol/openid-connect/token"):
+			_, _ = w.Write([]byte(`{"access_token":"access-token","refresh_token":"refresh-token","token_type":"Bearer"}`))
+		case strings.HasSuffix(r.URL.Path, "/serverinfo"):
+			_, _ = w.Write([]byte(`{"systemInfo":{"version":"12.0.4"}}`))
+		default:
+			_, _ = w.Write([]byte(`{}`))
+		}
+	}))
+	defer server.Close()
+
+	keycloakClient, err := newKeycloakClientWithHeaders(server.URL, "/auth", "client-id", "client-secret", "realm", "", "", true, 5, "", false, "", additionalHeaders)
+	if err != nil {
+		t.Fatalf("unexpected error creating client: %s", err)
+	}
+
+	// Trigger a regular admin API request as well.
+	if _, err := keycloakClient.GetRealm("some-realm"); err != nil {
+		t.Fatalf("unexpected error getting realm: %s", err)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+
+	if len(recorded) == 0 {
+		t.Fatal("expected the client to send at least one request")
+	}
+
+	tokenRequestSeen := false
+	adminRequestSeen := false
+	for _, request := range recorded {
+		if strings.HasSuffix(request.path, "/protocol/openid-connect/token") {
+			tokenRequestSeen = true
+		}
+		if strings.Contains(request.path, "/admin/") {
+			adminRequestSeen = true
+		}
+		if got := request.header.Get("foo"); got != "bar" {
+			t.Errorf("expected request to %s to include additional header foo=bar, got %q", request.path, got)
+		}
+	}
+	if !tokenRequestSeen || !adminRequestSeen {
+		t.Fatalf("expected token and admin API requests, got token=%t admin=%t", tokenRequestSeen, adminRequestSeen)
+	}
+}
+
+func TestNewKeycloakClientSignature(t *testing.T) {
+	constructorType := reflect.TypeOf(NewKeycloakClient)
+	wantInputs := []reflect.Type{
+		reflect.TypeOf(""), reflect.TypeOf(""), reflect.TypeOf(""), reflect.TypeOf(""),
+		reflect.TypeOf(""), reflect.TypeOf(""), reflect.TypeOf(""), reflect.TypeOf(false),
+		reflect.TypeOf(int(0)), reflect.TypeOf(""), reflect.TypeOf(false), reflect.TypeOf(""),
+		reflect.TypeOf(map[string]string{}),
+	}
+	if constructorType.NumIn() != len(wantInputs) {
+		t.Fatalf("NewKeycloakClient accepts %d arguments, want %d", constructorType.NumIn(), len(wantInputs))
+	}
+	for index, want := range wantInputs {
+		if got := constructorType.In(index); got != want {
+			t.Errorf("argument %d has type %s, want %s", index+1, got, want)
+		}
+	}
+	if constructorType.NumOut() != 2 || constructorType.Out(0) != reflect.TypeOf((*KeycloakClient)(nil)) || constructorType.Out(1) != reflect.TypeOf((*error)(nil)).Elem() {
+		t.Fatalf("NewKeycloakClient must return (*KeycloakClient, error)")
+	}
+}
+
+// Use reflection so that a base implementation with the previous constructor
+// arity still builds and reaches behavioral assertions about missing headers.
+func newKeycloakClientWithHeaders(url, basePath, clientId, clientSecret, realm, username, password string, initialLogin bool, clientTimeout int, caCert string, tlsInsecureSkipVerify bool, userAgent string, additionalHeaders map[string]string) (*KeycloakClient, error) {
+	constructor := reflect.ValueOf(NewKeycloakClient)
+	arguments := []interface{}{url, basePath, clientId, clientSecret, realm, username, password, initialLogin, clientTimeout, caCert, tlsInsecureSkipVerify, userAgent}
+	if constructor.Type().NumIn() == 13 {
+		arguments = append(arguments, additionalHeaders)
+	}
+	values := make([]reflect.Value, len(arguments))
+	for index, argument := range arguments {
+		values[index] = reflect.ValueOf(argument)
+	}
+	results := constructor.Call(values)
+	var client *KeycloakClient
+	if !results[0].IsNil() {
+		client = results[0].Interface().(*KeycloakClient)
+	}
+	if results[1].IsNil() {
+		return client, nil
+	}
+	return client, results[1].Interface().(error)
+}
