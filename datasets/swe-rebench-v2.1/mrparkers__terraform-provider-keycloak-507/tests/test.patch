+func TestProviderAdditionalHeaders(t *testing.T) {
+	additionalHeaders := map[string]string{
+		"X-Proxy-Key":   "proxy-secret",
+		"X-Proxy-Scope": "terraform",
+	}
+	requests := make(chan *http.Request, 4)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests <- r.Clone(r.Context())
+		w.Header().Set("Content-Type", "application/json")
+		if strings.HasSuffix(r.URL.Path, "/protocol/openid-connect/token") {
+			_, _ = w.Write([]byte(`{"access_token":"access-token","refresh_token":"refresh-token","token_type":"Bearer"}`))
+			return
+		}
+		if strings.HasSuffix(r.URL.Path, "/serverinfo") {
+			_, _ = w.Write([]byte(`{"systemInfo":{"version":"12.0.4"}}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{}`))
+	}))
+	defer server.Close()
+
+	configuredProvider := KeycloakProvider(nil)
+	resourceData := schema.TestResourceDataRaw(t, configuredProvider.Schema, map[string]interface{}{
+		"url":            server.URL,
+		"base_path":      "/auth",
+		"client_id":      "client-id",
+		"client_secret":  "client-secret",
+		"realm":          "master",
+		"initial_login":  true,
+		"client_timeout": 5,
+		"additional_headers": map[string]interface{}{
+			"X-Proxy-Key":   "proxy-secret",
+			"X-Proxy-Scope": "terraform",
+		},
+	})
+	configuredClient, diagnostics := configuredProvider.ConfigureContextFunc(context.Background(), resourceData)
+	if diagnostics.HasError() {
+		t.Fatalf("unexpected provider configuration error: %v", diagnostics)
+	}
+	client, ok := configuredClient.(*keycloak.KeycloakClient)
+	if !ok || client == nil {
+		t.Fatalf("provider configuration returned %T, want a Keycloak client", configuredClient)
+	}
+	if _, err := client.GetRealm("example"); err != nil {
+		t.Fatalf("unexpected admin API request error: %s", err)
+	}
+
+	close(requests)
+	if len(requests) < 2 {
+		t.Fatalf("expected token and admin API requests, got %d", len(requests))
+	}
+	tokenRequestSeen := false
+	adminRequestSeen := false
+	for request := range requests {
+		if strings.HasSuffix(request.URL.Path, "/protocol/openid-connect/token") {
+			tokenRequestSeen = true
+		}
+		if strings.Contains(request.URL.Path, "/admin/") {
+			adminRequestSeen = true
+		}
+		for name, want := range additionalHeaders {
+			if got := request.Header.Get(name); got != want {
+				t.Errorf("request to %s has %s=%q, want %q", request.URL.Path, name, got, want)
+			}
+		}
+	}
+	if !tokenRequestSeen || !adminRequestSeen {
+		t.Fatalf("expected token and admin API requests, got token=%t admin=%t", tokenRequestSeen, adminRequestSeen)
+	}
+
+	resourceDataWithoutHeaders := schema.TestResourceDataRaw(t, configuredProvider.Schema, map[string]interface{}{
+		"url":            server.URL,
+		"base_path":      "/auth",
+		"client_id":      "client-id",
+		"client_secret":  "client-secret",
+		"realm":          "master",
+		"initial_login":  false,
+		"client_timeout": 5,
+	})
+	clientWithoutHeaders, diagnostics := configuredProvider.ConfigureContextFunc(context.Background(), resourceDataWithoutHeaders)
