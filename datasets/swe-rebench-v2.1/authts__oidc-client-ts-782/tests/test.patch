+describe("OidcClientSettings resource forwarding", () => {
+    it("should forward multiple resources from global settings to the signin request", async () => {
+        // arrange
+        const client = new OidcClient({
+            authority: "authority",
+            client_id: "client",
+            redirect_uri: "redirect",
+            resource: ["foo", "bar"] as unknown as string,
+        });
+        jest.spyOn(client.metadataService, "getAuthorizationEndpoint")
+            .mockImplementation(() => Promise.resolve("http://sts/authorize"));
+
+        // act
+        const request = await client.createSigninRequest({
+            response_type: "code",
+            scope: "openid",
+        });
+
+        // assert
+        expect(new URL(request.url).searchParams.getAll("resource").sort()).toEqual(["bar", "foo"]);
+    });
+});
