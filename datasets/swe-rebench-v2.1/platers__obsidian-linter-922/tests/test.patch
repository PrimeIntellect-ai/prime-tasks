+// accounts for https://github.com/platers/obsidian-linter/issues/921
+describe('Capitalize Headings', () => {
+  it('Make sure that a header with inline code is properly ignored for capitalization', () => {
+    const rule = CapitalizeHeadings.getRule();
+    const before = dedent`
+      ## \`= durationformat(date(this.day) - date(2023-10-06),"dd")\` th days passed since the Black Shabbat
+    `;
+    const result = rule.apply(before, {style: 'ALL CAPS'});
+
+    // The inline code must be preserved exactly as written (not capitalized).
+    expect(result).toContain('`= durationformat(date(this.day) - date(2023-10-06),"dd")`');
+    // The surrounding text should still be capitalized.
+    expect(result).toContain('TH DAYS PASSED');
+    expect(result).toContain('THE BLACK SHABBAT');
+  });
+});
