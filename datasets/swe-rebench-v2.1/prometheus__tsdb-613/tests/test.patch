+// compactionFailedMetricValue returns the value of the
+// prometheus_tsdb_compactions_failed_total counter registered with g, or 0
+// if the metric is not registered.
+func compactionFailedMetricValue(t *testing.T, g prometheus.Gatherer) float64 {
+	t.Helper()
+	mfs, err := g.Gather()
+	testutil.Ok(t, err)
+	for _, mf := range mfs {
+		if mf.GetName() != "prometheus_tsdb_compactions_failed_total" {
+			continue
+		}
+		for _, m := range mf.GetMetric() {
+			return m.GetCounter().GetValue()
+		}
+	}
+	return 0
+}
