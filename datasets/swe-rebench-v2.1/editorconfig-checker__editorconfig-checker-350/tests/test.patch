+// errAnyError is a sentinel used in table tests to assert that some error is
+// returned without pinning the exact message, which the contract leaves open.
+var errAnyError = errors.New("any error")
+
+// errorsMatch reports whether actual satisfies expected. The sentinel
+// errAnyError matches any non-nil error, since the contract permits any
+// validation error for some cases.
+func errorsMatch(actual, expected error) bool {
+	if expected == errAnyError {
+		return actual != nil
+	}
+	return reflect.DeepEqual(actual, expected)
+}
