+func TestIssueUnlinkCommandRemovesIssueLink(t *testing.T) {
+	const (
+		issue1 = `{"key":"TEST-1","fields":{"issuelinks":[{"id":"link-42","outwardIssue":{"key":"TEST-2"}}]}}`
+		issue2 = `{"key":"TEST-2","fields":{"issuelinks":[{"id":"link-42","inwardIssue":{"key":"TEST-1"}}]}}`
+	)
+
+	deleted := false
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch {
+		case r.Method == http.MethodGet && r.URL.Path == "/rest/api/2/issue/TEST-1":
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = w.Write([]byte(issue1))
+		case r.Method == http.MethodGet && r.URL.Path == "/rest/api/2/issue/TEST-2":
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = w.Write([]byte(issue2))
+		case (r.Method == http.MethodGet || r.Method == http.MethodPost) && r.URL.Path == "/rest/api/2/search":
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = w.Write([]byte(`{"issues":[` + issue1 + `,` + issue2 + `]}`))
+		case r.Method == http.MethodDelete && r.URL.Path == "/rest/api/2/issueLink/link-42":
+			deleted = true
+			w.WriteHeader(http.StatusNoContent)
+		default:
+			t.Errorf("unexpected Jira request: %s %s", r.Method, r.URL.String())
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+
+	configFile := filepath.Join(t.TempDir(), "jira.yml")
+	config := "server: " + server.URL + "\nlogin: user\napi_token: token\n"
+	if err := ioutil.WriteFile(configFile, []byte(config), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	cmd := exec.Command("go", "run", "../../cmd/jira", "--config", configFile, "issue", "unlink", "TEST-1", "TEST-2")
+	cmd.Env = append(os.Environ(), "JIRA_API_TOKEN=token")
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("unlink command failed: %v\n%s", err, output)
+	}
+	assert.True(t, deleted, "the command should remove the matching Jira issue link")
+}
