+def test_bbox_updates():
+    psd = PSDImage.open(full_name('hidden-groups.psd'))
+    group1 = psd[1]
+    group1.visible = False
+    assert group1.bbox == (0, 0, 0 ,0)
+    group1.visible = True
+    with pytest.raises(AttributeError):
+        group1.bbox = (1, 2, 3, 4)
+
+
+def test_composite_after_toggling_visibility():
+    psd = PSDImage.open(full_name('hidden-groups.psd'))
+    group = psd[1]
+
+    # Composite once while the group is hidden.
+    hidden = np.asarray(psd.composite(ignore_preview=True))
+
+    # Toggling the group on must change the composited image.
+    group.visible = True
+    visible = np.asarray(psd.composite(ignore_preview=True))
+    assert not np.array_equal(hidden, visible)
+
+    # Toggling it back off must restore the original composited image.
+    group.visible = False
+    hidden_again = np.asarray(psd.composite(ignore_preview=True))
+    assert np.array_equal(hidden, hidden_again)
+
+    # The composited image with the group visible matches a fresh composite.
+    reference_psd = PSDImage.open(full_name('hidden-groups.psd'))
+    reference_psd[1].visible = True
+    reference = np.asarray(reference_psd.composite(ignore_preview=True))
+    assert np.array_equal(visible, reference)
