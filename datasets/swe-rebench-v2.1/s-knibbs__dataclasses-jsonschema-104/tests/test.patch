+
+def test_additional_properties_rejected():
+    @dataclass
+    class StrictRecord(JsonSchemaMixin, allow_additional_props=False):
+        value: int
+
+    with pytest.raises(ValidationError):
+        StrictRecord.from_dict({"value": 1, "undeclared": 2})
+
+    assert StrictRecord.json_schema()["additionalProperties"] is False
+
+    @dataclass
+    class PermissiveRecord(JsonSchemaMixin):
+        value: int
+
+    assert PermissiveRecord.from_dict(
+        {"value": 1, "undeclared": 2}
+    ) == PermissiveRecord(value=1)
