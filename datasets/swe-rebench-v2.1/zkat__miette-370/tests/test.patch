+
+#[test]
+fn test_boxed_report_preserves_source_code() {
+    let report = Report::new(CustomDiagnostic::new());
+    let source_span = SourceSpan::from(0..CustomDiagnostic::SOURCE_CODE.len());
+    let original_source = report
+        .source_code()
+        .expect("the original diagnostic provides source code")
+        .read_span(&source_span, 0, 0)
+        .expect("read original source code")
+        .data()
+        .to_owned();
+
+    let boxed: Box<dyn Diagnostic> = report.into();
+    let boxed_source = boxed
+        .source_code()
+        .expect("boxing the report preserves available source code")
+        .read_span(&source_span, 0, 0)
+        .expect("read boxed source code")
+        .data()
+        .to_owned();
+
+    assert_eq!(boxed_source, original_source);
+}
