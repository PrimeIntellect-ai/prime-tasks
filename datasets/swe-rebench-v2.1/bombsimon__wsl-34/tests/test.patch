+func caseTrailingWhitespaceConfig(allow bool) *Configuration {
+	config := DefaultConfig()
+	field := reflect.ValueOf(&config).Elem().FieldByName("AllowCaseTrailingWhitespace")
+	if field.IsValid() && field.CanSet() {
+		field.SetBool(allow)
+	}
+
+	return &config
+}
+
+func TestDefaultConfigDisallowsCaseTrailingWhitespace(t *testing.T) {
+	config := DefaultConfig()
+	field := reflect.ValueOf(&config).Elem().FieldByName("AllowCaseTrailingWhitespace")
+	require.True(t, field.IsValid(), "default configuration exposes the case trailing whitespace setting")
+	assert.False(t, field.Bool())
+}
+
+func TestCaseTrailingWhitespaceConfiguration(t *testing.T) {
+	cases := []struct {
+		name           string
+		code           string
+		allow          bool
+		expectedErrors int
+	}{
+		{
+			name: "allows whitespace before another case",
+			code: `package main
+
+func main() {
+switch {
+case 1:
+fmt.Println(1)
+
+case 2:
+fmt.Println(2)
+}
+}`,
+			allow: true,
+		},
+		{
+			name: "does not allow whitespace after the final case",
+			code: `package main
+
+func main() {
+switch {
+case 1:
+fmt.Println(1)
+
+}
+}`,
+			allow:          true,
+			expectedErrors: 1,
+		},
+		{
+			name: "does not allow whitespace at the start of a block",
+			code: `package main
+
+func main() {
+switch {
+case 1:
+
+fmt.Println(1)
+case 2:
+fmt.Println(2)
+}
+}`,
+			allow:          true,
+			expectedErrors: 1,
+		},
+		{
+			name: "does not allow whitespace at the end of another block",
+			code: `package main
+
+func main() {
+if true {
+fmt.Println(1)
+
+}
+}`,
+			allow:          true,
+			expectedErrors: 1,
+		},
+		{
+			name: "disabled setting disallows whitespace before another case",
+			code: `package main
+
+func main() {
+switch {
+case 1:
+fmt.Println(1)
+
+case 2:
+fmt.Println(2)
+}
+}`,
+			allow:          false,
+			expectedErrors: 1,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			filename := filepath.Join(t.TempDir(), "main.go")
+			require.NoError(t, os.WriteFile(filename, []byte(tc.code), 0600))
+			processor := NewProcessorWithConfig(*caseTrailingWhitespaceConfig(tc.allow))
+			results, _ := processor.ProcessFiles([]string{filename})
+
+			require.Len(t, results, tc.expectedErrors)
+		})
+	}
+}
+
