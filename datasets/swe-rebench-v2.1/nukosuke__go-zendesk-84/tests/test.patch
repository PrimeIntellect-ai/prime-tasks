+func TestUpdateGroupReturnsUpdatedGroupFromResponse(t *testing.T) {
+	mockAPI := newMockAPIWithStatus(http.MethodPut, "groups.json", http.StatusOK)
+	client := newTestClient(mockAPI)
+	defer mockAPI.Close()
+
+	updatedGroup, err := client.UpdateGroup(int64(1234), Group{})
+	if err != nil {
+		t.Fatalf("Failed to send request to update group: %s", err)
+	}
+
+	expectedID := int64(360002440594)
+	if updatedGroup.ID != expectedID {
+		t.Fatalf("Updated group %v did not have expected id %d", updatedGroup, expectedID)
+	}
+}
+
+func TestDeleteGroupSendsDeleteForGroupPath(t *testing.T) {
+	type requestDetails struct {
+		method string
+		path   string
+	}
+	requests := make(chan requestDetails, 1)
+	mockAPI := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests <- requestDetails{method: r.Method, path: r.URL.Path}
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer mockAPI.Close()
+
+	c := newTestClient(mockAPI)
+	if err := c.DeleteGroup(1234); err != nil {
+		t.Fatalf("Failed to delete group: %s", err)
+	}
+
+	request := <-requests
+	if request.method != http.MethodDelete {
+		t.Errorf("expected DELETE request, got %s", request.method)
+	}
+	if request.path != "/groups/1234.json" {
+		t.Errorf("expected request for group 1234, got path %q", request.path)
+	}
+}
+
+func TestUpdateGroupReturnsErrorOnRequestFailure(t *testing.T) {
+	mockAPI := newMockAPIWithStatus(http.MethodPut, "groups.json", http.StatusInternalServerError)
+	client := newTestClient(mockAPI)
+	defer mockAPI.Close()
+
+	if _, err := client.UpdateGroup(1234, Group{}); err == nil {
+		t.Fatal("expected update request failure to be returned")
+	}
+}
+
+func TestDeleteGroupReturnsErrorOnRequestFailure(t *testing.T) {
+	mockAPI := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+	}))
+	client := newTestClient(mockAPI)
+	defer mockAPI.Close()
+
+	if err := client.DeleteGroup(1234); err == nil {
+		t.Fatal("expected delete request failure to be returned")
+	}
