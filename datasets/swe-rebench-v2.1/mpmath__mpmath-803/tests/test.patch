@@ -967,6 +967,26 @@ def test_log1p():
     assert log1p(inf) == inf
     assert log1p(1e-50).ae(1e-50)
     assert (log1p(1e-10)*1e10).ae(0.99999999995)
+    # issue 790: log1p of a small complex argument must not lose the
+    # real part to cancellation.  The accurate value is obtained by
+    # evaluating at much higher precision.
+    for c in [1.8370676479640493e-39-4.6885882517313053e-20j,
+              -2.0476815825463086e-80-2.0235857941734692e-40j,
+              -6.4922176418510124e-21+1.1394926627101214e-10j,
+              -1.430796815051627e-72+1.691624553529315e-36j,
+              -3.1061140011623543e-21+7.881768838480807e-11j]:
+        with workprec(500):
+            expected = log1p(c)
+        result = log1p(c)
+        assert result.real.ae(expected.real, 1e-12, 0)
+        assert result.imag.ae(expected.imag, 1e-12, 0)
+    # The high-precision evaluation is the accurate reference.
+    with workprec(500):
+        assert log1p(1.8370676479640493e-39-4.6885882517313053e-20j).real.ae(
+            2.93621063767769e-39, 1e-12, 0)
+    # A contrived case where the leading terms cancel almost entirely.
+    assert log1p(-1.999999873062092e-40+1.999999936531045e-20j).ae(
+        1.9999997461241924e-80+1.999999936531045e-20j)
 
