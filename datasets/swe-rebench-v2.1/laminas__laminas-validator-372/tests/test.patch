diff --git a/test/BackedEnumValueTest.php b/test/BackedEnumValueTest.php
new file mode 100644
index 00000000..5088adad
--- /dev/null
+++ b/test/BackedEnumValueTest.php
@@ -0,0 +1,47 @@
+<?php
+
+declare(strict_types=1);
+
+namespace LaminasTest\Validator;
+
+use BackedEnum;
+use Laminas\Validator\BackedEnumValue;
+use LaminasTest\Validator\TestAsset\ExampleIntBackedEnum;
+use LaminasTest\Validator\TestAsset\ExampleStringBackedEnum;
+use PHPUnit\Framework\Attributes\DataProvider;
+use PHPUnit\Framework\TestCase;
+
+class BackedEnumValueTest extends TestCase
+{
+    /**
+     * @return iterable<int, array{0: class-string<BackedEnum>, 1: mixed, 2: bool}>
+     */
+    public static function basicProvider(): iterable
+    {
+        foreach (ExampleIntBackedEnum::cases() as $case) {
+            yield [ExampleIntBackedEnum::class, $case->value, true];
+        }
+
+        foreach (ExampleStringBackedEnum::cases() as $case) {
+            yield [ExampleStringBackedEnum::class, $case->value, true];
+        }
+
+        yield from [
+            [ExampleStringBackedEnum::class, 'Not There', false],
+            [ExampleStringBackedEnum::class, 10, false],
+            [ExampleStringBackedEnum::class, ['foo'], false],
+            [ExampleIntBackedEnum::class, 123, false],
+            [ExampleIntBackedEnum::class, ['foo'], false],
+            [ExampleIntBackedEnum::class, 'foo', false],
+        ];
+    }
+
+    /** @param class-string<BackedEnum> $enum */
+    #[DataProvider('basicProvider')]
+    public function testBasic(string $enum, mixed $value, bool $expect): void
+    {
+        $validator = new BackedEnumValue(['enum' => $enum]);
+
+        self::assertSame($expect, $validator->isValid($value));
+    }
+}
diff --git a/test/EnumCaseTest.php b/test/EnumCaseTest.php
