+describe('resolveNavlinks', () => {
+  const routeDef: UIDLStateDefinition = {
+    type: 'string',
+    defaultValue: 'home-link',
+    values: [
+      {
+        value: 'home-link',
+        meta: {
+          path: '/home',
+        },
+      },
+    ],
+  }
+
+  it('replaces the transitionTo attribute content', () => {
+    const navlink = elementNode('navlink', {
+      transitionTo: staticNode('home-link'),
+    })
+
+    const uidlNode = elementNode('container', {}, [elementNode('div', {}, [navlink])])
+
+    resolveNavlinks(uidlNode, routeDef)
+    expect(navlink.content.attrs.transitionTo.content).toBe('/home')
+  })
+
+  it('throws an error for dynamic attributes', () => {
+    const navlink = elementNode('navlink', {
+      transitionTo: dynamicNode('prop', 'path'),
+    })
+
+    expect(() => resolveNavlinks(navlink, routeDef)).toThrow(
+      "Navlink does not support dynamic 'transitionTo' attributes"
+    )
+  })
+
+  it('warns when no path is defined for the referenced state', () => {
+    const navlink = elementNode('navlink', {
+      transitionTo: staticNode('non-existing-state'),
+    })
+
+    const warn = jest.spyOn(global.console, 'warn')
+
+    resolveNavlinks(navlink, routeDef)
+
+    expect(warn).toHaveBeenCalledWith("No path was defined for router state: 'non-existing-state'.")
+  })
+
+
+  it('applies the project route definition during normal UIDL resolution', () => {
+    const projectRouteDefinition: UIDLStateDefinition = {
+      type: 'string',
+      defaultValue: 'home-link',
+      values: [
+        { value: 'home-link', meta: { path: '/home' } },
+        { value: 'about-link', meta: { path: '/about-us' } },
+      ],
+    }
+
+    const uidl = component(
+      'Navigation Component',
+      elementNode('container', {}, [
+        elementNode('navlink', {
+          transitionTo: staticNode('home-link'),
+        }),
+        elementNode('navlink', {
+          transitionTo: staticNode('about-link'),
+        }),
+      ])
+    )
+
+    const resolved = new Resolver().resolveUIDL(uidl, { projectRouteDefinition })
+    const resolvedRoot = resolved.node.content as UIDLElement
+    const homeLink = resolvedRoot.children[0].content as UIDLElement
+    const aboutLink = resolvedRoot.children[1].content as UIDLElement
+
+    expect(homeLink.attrs.transitionTo.content).toBe('/home')
+    expect(aboutLink.attrs.transitionTo.content).toBe('/about-us')
+  })
+})
