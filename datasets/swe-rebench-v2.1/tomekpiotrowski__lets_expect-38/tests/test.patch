+#[cfg(test)]
+mod compile_fail {
+    use std::fs;
+    use std::path::PathBuf;
+    use std::process::Command;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    static COUNTER: AtomicUsize = AtomicUsize::new(0);
+
+    fn repo_root() -> PathBuf {
+        PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+    }
+
+    fn cargo_bin() -> String {
+        std::env::var("CARGO").unwrap_or_else(|_| "cargo".to_string())
+    }
+
+    fn compiles(snippet: &str) -> bool {
+        let id = COUNTER.fetch_add(1, Ordering::SeqCst);
+        let dir = std::env::temp_dir().join(format!(
+            "lets_expect_compile_probe_{}_{}",
+            std::process::id(),
+            id
+        ));
+        let _ = fs::remove_dir_all(&dir);
+        fs::create_dir_all(dir.join("src")).unwrap();
+
+        let manifest = format!(
+            "[package]\nname = \"lets_expect_compile_probe\"\nversion = \"0.0.0\"\nedition = \"2021\"\n\n[dependencies]\nlets_expect = {{ path = {:?} }}\n\n[workspace]\n",
+            repo_root()
+        );
+        fs::write(dir.join("Cargo.toml"), manifest).unwrap();
+        fs::write(dir.join("src/main.rs"), snippet).unwrap();
+
+        let target_dir = dir.join("target");
+        let status = Command::new(cargo_bin())
+            .arg("check")
+            .arg("--offline")
+            .arg("--quiet")
+            .current_dir(&dir)
+            .env("CARGO_TARGET_DIR", &target_dir)
+            .status();
+
+        let ok = matches!(status, Ok(s) if s.success());
+        let _ = fs::remove_dir_all(&dir);
+        ok
+    }
+
+    #[test]
+    fn when_with_commas_compiles() {
+        let snippet = r#"
+use lets_expect::lets_expect;
+
+lets_expect! {
+    expect(a + b) {
+        when(a = 1, b = 2) {
+            to equal(3)
+        }
+    }
+}
+
+fn main() {}
+"#;
+        assert!(compiles(snippet), "comma-separated `when` should compile");
+    }
+
+    #[test]
+    fn when_with_semicolons_fails_to_compile() {
+        let snippet = r#"
+use lets_expect::lets_expect;
+
+lets_expect! {
+    expect(a + b) {
+        when(a = 1; b = 2) {
+            to equal(3)
+        }
+    }
+}
+
+fn main() {}
+"#;
+        assert!(!compiles(snippet), "semicolon-separated `when` should not compile");
+    }
+
+    #[test]
+    fn when_with_no_assignments_fails_to_compile() {
+        let snippet = r#"
+use lets_expect::lets_expect;
+
+lets_expect! {
+    expect(a) {
+        when() {
+            to equal(1)
+        }
+    }
+}
+
+fn main() {}
+"#;
+        assert!(!compiles(snippet), "empty `when` should not compile");
     }
 }
