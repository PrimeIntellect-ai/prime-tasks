+    def test_zt_parse_true_options(self):
+        native = self._tabs(
+            """package zerotier
+
+config zerotier 'ow_zt'
+
+config network
+    option id '9536600adf654321'
+    option allow_global '1'
+    option allow_default '1'
+    option allow_dns '1'
+"""
+        )
+
+        network = OpenWrt(native=native).config["zerotier"][0]["networks"][0]
+        self.assertEqual(
+            network,
+            {
+                "id": "9536600adf654321",
+                "ifname": "owzt654321",
+                "allow_global": True,
+                "allow_default": True,
+                "allow_dns": True,
+            },
+        )
