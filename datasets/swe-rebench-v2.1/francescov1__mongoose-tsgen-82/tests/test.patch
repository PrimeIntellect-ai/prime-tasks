     expect(parseKey("test2a", { type: [Number] })).toBe("test2a: number[];\n");
   });
 });
+
+describe("parseSchema subdocument type names", () => {
+  // returns the names of all types/interfaces declared in the generated string
+  const declaredNames = (schema: mongoose.Schema, modelName: string) => {
+    const output = parser.parseSchema({
+      schema,
+      modelName,
+      isDocument: false,
+      shouldLeanIncludeVirtuals: false
+    });
+    const names: string[] = [];
+    const pattern = /(?:type|interface) (\w+)/g;
+    let match = pattern.exec(output);
+    while (match) {
+      names.push(match[1]);
+      match = pattern.exec(output);
+    }
+    return names;
+  };
+
+  test("singularizes subdocument names ending in sses by removing the trailing es", () => {
+    const schema = new mongoose.Schema({
+      glasses: [new mongoose.Schema({ name: String })],
+      classes: [new mongoose.Schema({ name: String })]
+    });
+
+    const names = declaredNames(schema, "Store");
+    expect(names).toContain("StoreGlass");
+    expect(names).toContain("StoreClass");
+    expect(names).not.toContain("StoreGlasse");
+    expect(names).not.toContain("StoreClasse");
+  });
+
+  test("singularizes subdocument names ending in ses by removing only the final s", () => {
+    const schema = new mongoose.Schema({
+      vases: [new mongoose.Schema({ name: String })],
+      houses: [new mongoose.Schema({ name: String })]
+    });
+
+    const names = declaredNames(schema, "Store");
+    expect(names).toContain("StoreVase");
+    expect(names).toContain("StoreHouse");
+  });
+});
