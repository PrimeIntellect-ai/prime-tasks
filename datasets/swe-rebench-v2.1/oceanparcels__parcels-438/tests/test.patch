+@pytest.mark.parametrize('mode', ['scipy', 'jit'])
+def test_particlefile_version_metadata(fieldset, mode, tmpdir):
+    filepath = tmpdir.join("pfile_version_metadata")
+
+    def IncrLon(particle, fieldset, time, dt):
+        particle.lon += 1.
+
+    pset = ParticleSet(fieldset, pclass=ptype[mode], lon=[0.5], lat=[0.5])
+    outfile = pset.ParticleFile(name=filepath, outputdt=0.1)
+    pset.execute(IncrLon, runtime=0.2, dt=0.1, output_file=outfile)
+    ncfile = Dataset(filepath+".nc", 'r', 'NETCDF4')
+    assert ncfile.parcels_version == parcels.__version__
+    ncfile.close()
+
+
+@pytest.mark.parametrize('mode', ['scipy', 'jit'])
+def test_particlefile_add_metadata(fieldset, mode, tmpdir):
+    filepath = tmpdir.join("pfile_metadata")
+
+    def IncrLon(particle, fieldset, time, dt):
+        particle.lon += 1.
+
+    pset = ParticleSet(fieldset, pclass=ptype[mode], lon=[0.5], lat=[0.5])
+    outfile = pset.ParticleFile(name=filepath, outputdt=0.1)
+    assert outfile.add_metadata('runtime', 42) is None
+    pset.execute(IncrLon, runtime=0.2, dt=0.1, output_file=outfile)
+    ncfile = Dataset(filepath+".nc", 'r', 'NETCDF4')
+    assert ncfile.runtime == 42
+    ncfile.close()
