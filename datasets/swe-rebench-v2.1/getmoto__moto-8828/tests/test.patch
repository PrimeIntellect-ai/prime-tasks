+
+
+@mock_aws
+def test_s3_get_object_from_glacierir():
+    s3_client = boto3.client("s3", region_name="us-east-1")
+    bucket_name = "tests3getobjectfromglacierir"
+    s3_client.create_bucket(Bucket=bucket_name)
+
+    s3_client.put_object(
+        Bucket=bucket_name, Key="test.txt", Body="contents", StorageClass="GLACIER_IR"
+    )
+
+    resp = s3_client.get_object(Bucket=bucket_name, Key="test.txt")
+
+    # GLACIER_IR supports instant retrieval, so the body is available immediately
+    assert resp["Body"].read() == b"contents"
+
+
+@mock_aws
+def test_s3_copy_object_from_glacierir_is_immediately_retrievable():
+    s3_client = boto3.client("s3", region_name="us-east-1")
+    bucket_name = "tests3copyfromglacierir"
+    s3_client.create_bucket(Bucket=bucket_name)
+    s3_client.put_object(
+        Bucket=bucket_name, Key="source.txt", Body="contents", StorageClass="GLACIER_IR"
+    )
+
+    s3_client.copy_object(
+        CopySource={"Bucket": bucket_name, "Key": "source.txt"},
+        Bucket=bucket_name,
+        Key="copy.txt",
+    )
+
+    copied_object = s3_client.get_object(Bucket=bucket_name, Key="copy.txt")
+    assert copied_object["Body"].read() == b"contents"
+
+
+@mock_aws
+def test_s3_restore_object_rejects_glacierir():
+    s3_client = boto3.client("s3", region_name="us-east-1")
+    bucket_name = "tests3restoreglacierir"
+    s3_client.create_bucket(Bucket=bucket_name)
+    s3_client.put_object(
+        Bucket=bucket_name, Key="test.txt", Body="contents", StorageClass="GLACIER_IR"
+    )
+
+    with pytest.raises(ClientError) as exc:
+        s3_client.restore_object(
+            Bucket=bucket_name, Key="test.txt", RestoreRequest={"Days": 1}
+        )
+
+    assert exc.value.response["Error"]["Code"] == "InvalidObjectState"
