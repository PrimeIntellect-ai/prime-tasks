+
+#[test]
+fn version_does_not_write_to_stdout() {
+    // When run as the child process, exercise the version path and let the
+    // parent observe this process' stdout.
+    if std::env::var("CLAP_VERSION_STDOUT_CHILD").is_ok() {
+        let _ = App::new("test")
+            .version("1.3")
+            .try_get_matches_from(vec!["myprog", "--version"]);
+        return;
+    }
+
+    let exe = std::env::current_exe().expect("current test executable");
+    let output = std::process::Command::new(exe)
+        .args(&["version_does_not_write_to_stdout", "--exact", "--nocapture"])
+        .env("CLAP_VERSION_STDOUT_CHILD", "1")
+        .output()
+        .expect("failed to run child test process");
+
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    assert!(
+        !stdout.contains("test 1.3"),
+        "version output was written directly to stdout: {:?}",
+        stdout
+    );
 }
 
 #[test]
