+
+  test('simulator reset waits for simulation to complete', () async {
+    var resetCompleted = false;
+
+    bool endSimulationAction() {
+      Simulator.endSimulation();
+      return true;
+    }
+
+    bool resetAction() {
+      Simulator.reset().then((_) => resetCompleted = true);
+      return true;
+    }
+
+    bool noopAction() => true;
+
+    Simulator.registerAction(100, endSimulationAction);
+    Simulator.registerAction(100, resetAction);
+    Simulator.registerAction(100, noopAction);
+
+    await Simulator.run();
+
+    // The reset should only complete once the simulation has fully ended.
+    await Future(() {});
+    expect(resetCompleted, isTrue);
+  });
+
+  test('simulator reset clears internal state', () async {
+    Simulator.registerAction(100, () => true);
+    await Simulator.run();
+
+    // The simulation ran to completion and advanced time.
+    expect(Simulator.time, equals(100));
+    expect(Simulator.simulationHasEnded, isTrue);
+
+    await Simulator.reset();
+
+    // After reset, the simulator is back to its initial state.
+    expect(Simulator.time, equals(0));
+    expect(Simulator.simulationHasEnded, isFalse);
+    expect(Simulator.hasStepsRemaining(), isFalse);
+  });
