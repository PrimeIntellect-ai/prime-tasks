--- a/test/hooks.jl
+++ b/test/hooks.jl
@@ -202,6 +202,23 @@ end
         end
         JuliaSyntax.enable_in_core!(false)
 
+        # Multiline comment input remains incomplete in both parser modes.
+        for str in [
+            "function f()\nbody #comment",
+            "a = [\n1,\n2, #comment",
+            "a = [\n1,\n2, #comment\n\n\n",
+        ]
+            @testset "$(repr(str))" begin
+                for option in (:statement, :all)
+                    ex = JuliaSyntax.core_parser_hook(str, "somefile", 1, 0, option)[1]
+                    if Meta.isexpr(ex, :toplevel)
+                        incomplete_exprs = filter(arg -> arg isa Expr && Base.incomplete_tag(arg) != :none, ex.args)
+                        ex = isempty(incomplete_exprs) ? ex : last(incomplete_exprs)
+                    end
+                    @test Base.incomplete_tag(ex) != :none
+                end
+            end
+        end
         # Should not throw
         @test JuliaSyntax.core_parser_hook("+=", "somefile", 1, 0, :statement)[1] isa Expr
     end
