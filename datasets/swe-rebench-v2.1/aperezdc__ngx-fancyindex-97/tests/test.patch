diff --git a/t/bug95-square-brackets.test b/t/bug95-square-brackets.test
new file mode 100644
index 0000000..04d6aff
--- /dev/null
+++ b/t/bug95-square-brackets.test
@@ -0,0 +1,27 @@
+#! /bin/bash
+cat <<---
+Bug #95: FancyIndex does not encode square brackets
+https://github.com/aperezdc/ngx-fancyindex/issues/95
+--
+use pup
+
+# Prepare a directory with a file that contains square brackets in the name.
+mkdir -p "${TESTDIR}/bug95"
+printf 'bracket filename content' > "${TESTDIR}/bug95/bug[95].txt"
+
+nginx_start
+content=$(fetch /bug95/)
+test -n "${content}" || fail 'Empty response'
+
+expected_href='bug%5B95%5D.txt'
+obtained_href=$(pup -p body tbody 'tr:nth-child(2)' a 'attr{href}' <<< "${content}")
+test "${expected_href}" = "${obtained_href}" || \
+	fail 'Expected: %s - Obtained: %s' "${expected_href}" "${obtained_href}"
+
+# An encoded href must also resolve to the file it names.
+if requested_content=$(fetch '/bug95/bug%5B95%5D.txt') ; then
+	test "${requested_content}" = 'bracket filename content' || \
+		fail 'Unexpected content returned for the encoded filename'
+else
+	fail 'Encoded filename request failed'
+fi
