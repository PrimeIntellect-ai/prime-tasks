+    @Test
+    public void testIssue1706() throws Exception {
+        String path = "/issue-1706/SimpleRequestResponseRef.json";
+
+        ParseOptions options = new ParseOptions();
+        options.setResolve(true);
+        // Added this parseOption to make requestBody inline in the operation resolve processing flow.
+        ParseOptions.class.getMethod("setResolveRequestBody", boolean.class).invoke(options, true);
+
+        // The flag reports the state that was set.
+        assertTrue((Boolean) ParseOptions.class.getMethod("isResolveRequestBody").invoke(options));
+
+        OpenAPI openAPI = new OpenAPIV3Parser().readLocation(path, null, options).getOpenAPI();
+
+        // RequestBody should be inline
+        assertTrue(openAPI.getPaths().get("/resource").getPost().getRequestBody().get$ref() == null);
+        assertTrue(openAPI.getPaths().get("/resource").getPost().getRequestBody().getContent() != null);
+        assertTrue(openAPI.getPaths().get("/resource").getPost().getRequestBody().getContent().get("application/json").getSchema().getProperties().containsKey("rqname"));
+
+        // Responses are already by default made inline in case referenced.
+        assertTrue(openAPI.getPaths().get("/resource").getPost().getResponses().get("200").get$ref() == null);
+        assertTrue(openAPI.getPaths().get("/resource").getPost().getResponses().get("200").getContent() != null);
+        assertTrue(openAPI.getPaths().get("/resource").getPost().getResponses().get("200").getContent().get("application/json").getSchema().getProperties().containsKey("rname"));
+    }
+
+    @Test
+    public void testIssue1706ResolveRequestBodyDefaultDisabled() throws Exception {
+        String path = "/issue-1706/SimpleRequestResponseRef.json";
+
+        ParseOptions options = new ParseOptions();
+        options.setResolve(true);
+
+        // The flag defaults to false and reports that state.
+        assertFalse((Boolean) ParseOptions.class.getMethod("isResolveRequestBody").invoke(options));
+
+        OpenAPI openAPI = new OpenAPIV3Parser().readLocation(path, null, options).getOpenAPI();
+
+        // Without enabling requestBody resolution the referenced requestBody is left untouched.
+        assertNotNull(openAPI.getPaths().get("/resource").getPost().getRequestBody().get$ref());
+    }
+
+    @Test
+    public void testIssue1706ResolveAndFlatten() throws Exception {
+        String path = "/issue-1706/SimpleRequestResponseRef.json";
+
+        ParseOptions options = new ParseOptions();
+        options.setResolve(true);
+        options.setFlatten(true);
+        ParseOptions.class.getMethod("setResolveRequestBody", boolean.class).invoke(options, true);
+
+        OpenAPI openAPI = new OpenAPIV3Parser().readLocation(path, null, options).getOpenAPI();
+
+        // The reported resolve + flatten workflow inlines the referenced requestBody.
+        assertTrue(openAPI.getPaths().get("/resource").getPost().getRequestBody().get$ref() == null);
+        assertTrue(openAPI.getPaths().get("/resource").getPost().getRequestBody().getContent() != null);
+        Schema flattenedSchema = openAPI.getPaths().get("/resource").getPost().getRequestBody().getContent().get("application/json").getSchema();
+        assertNotNull(flattenedSchema.get$ref());
+        String componentPrefix = "#/components/schemas/";
+        assertTrue(flattenedSchema.get$ref().startsWith(componentPrefix));
+        String componentName = flattenedSchema.get$ref().substring(componentPrefix.length());
+        assertTrue(openAPI.getComponents().getSchemas().containsKey(componentName));
+        assertTrue(openAPI.getComponents().getSchemas().get(componentName).getProperties().containsKey("rqname"));
+    }
+
