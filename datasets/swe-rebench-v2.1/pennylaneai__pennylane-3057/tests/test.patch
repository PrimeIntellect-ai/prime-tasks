+    @pytest.mark.autograd
+    @pytest.mark.parametrize("requires_grad", (True, False))
+    def test_tensor_with_pauliz_autograd(self, requires_grad):
+        """Test the matrix for the case when the coefficient is autograd and
+        the diagonalizing gates don't act on every wire for the matrix."""
+        phi = qml.numpy.array(-0.345, requires_grad=requires_grad)
+        base = qml.PauliZ(0) @ qml.PauliY(1)
+        autograd_op = Exp(base, phi)
+        mat = qml.math.expm(phi * qml.matrix(base))
+
+        assert qml.math.allclose(autograd_op.matrix(), mat)
+
+    @pytest.mark.autograd
+    @pytest.mark.parametrize("requires_grad", (True, False))
+    def test_matrix_with_wire_order(self, requires_grad):
+        """Test that a supplied wire_order is used to place the matrix correctly
+        when the operator does not act on a contiguous set of wires."""
+        phi = qml.numpy.array(0.25, requires_grad=requires_grad)
+        base = qml.PauliZ(0) @ qml.PauliY(1) @ qml.PauliZ(4)
+        op = Exp(base, phi)
+
+        default_expected = qml.math.expm(phi * qml.matrix(base))
+        assert qml.math.allclose(op.matrix(), default_expected)
+
+        for wire_order in ([4, 1, 0], [0, 1, 2, 3, 4], [4, 3, 2, 1, 0]):
+            expected = qml.math.expm(phi * qml.matrix(base, wire_order=wire_order))
+            assert qml.math.allclose(op.matrix(wire_order=wire_order), expected)
+
+    @pytest.mark.autograd
+    def test_matrix_autograd_requires_grad_is_differentiable(self):
+        """Test that the matrix is differentiable with respect to an autograd
+        coefficient that requires grad, i.e. the non-differentiable expm path
+        is avoided."""
+        base = qml.PauliX(0)
+        phi = qml.numpy.array(0.3, requires_grad=True)
+
+        def f(x):
+            return qml.math.real(qml.exp(base, x).matrix()[0, 0])
+
+        grad = qml.grad(f)(phi)
+        base_mat = qml.matrix(base)
+        expected = qml.math.real((base_mat @ qml.exp(base, phi).matrix())[0, 0])
+        assert qml.math.allclose(grad, expected)
+
