+func TestNewAccessTokenConnector(t *testing.T) {
+	dsn := "Server=server.database.windows.net;Database=db"
+	connector, err := NewAccessTokenConnector(dsn, func() (string, error) {
+		return "token", nil
+	})
+	if err != nil {
+		t.Fatalf("creating access-token connector: %v", err)
+	}
+	if connector == nil {
+		t.Fatal("expected a connector")
+	}
+}
+
+func TestAccessTokenConnectorFailsToConnectIfNoAccessToken(t *testing.T) {
+	providerErr := errors.New("token unavailable")
+	dsn := "Server=server.database.windows.net;Database=db"
+	providerCalls := 0
+	tp := func() (string, error) {
+		providerCalls++
+		return "", providerErr
+	}
+	sut, err := NewAccessTokenConnector(dsn, tp)
+	if err != nil {
+		t.Fatalf("expected err==nil, but got %+v", err)
+	}
+	_, err = sut.Connect(context.TODO())
+	if err == nil {
+		t.Fatal("expected token-provider failure to be returned")
+	}
+	if providerCalls == 0 {
+		t.Fatal("expected token provider to be called during connection")
+	}
+}
+
+func TestAccessTokenConnectorSendsTokenInLogin(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+
+	loginPackets := make(chan []byte, 2)
+	serverErr := make(chan error, 1)
+	go func() {
+		for i := 0; i < 2; i++ {
+			conn, err := listener.Accept()
+			if err != nil {
+				serverErr <- err
+				return
+			}
+			func() {
+				defer conn.Close()
+				_ = conn.SetDeadline(time.Now().Add(2 * time.Second))
+				readPacket := func() ([]byte, error) {
+					header := make([]byte, 8)
+					if _, err := io.ReadFull(conn, header); err != nil {
+						return nil, err
+					}
+					packetLength := int(binary.BigEndian.Uint16(header[2:4]))
+					packet := make([]byte, packetLength-8)
+					if _, err := io.ReadFull(conn, packet); err != nil {
+						return nil, err
+					}
+					return append(header, packet...), nil
+				}
+				if _, err := readPacket(); err != nil {
+					serverErr <- err
+					return
+				}
+				// Negotiate no encryption so that the login request is visible to this local peer.
+				prelogin := []byte{4, 1, 0, 15, 0, 0, 1, 0, 1, 0, 6, 0, 1, 255, 2}
+				if _, err := conn.Write(prelogin); err != nil {
+					serverErr <- err
+					return
+				}
+				packet, err := readPacket()
+				if err != nil {
+					serverErr <- err
+					return
+				}
+				loginPackets <- packet
+			}()
+		}
+	}()
+
+	port := listener.Addr().(*net.TCPAddr).Port
+	token := "first-token"
+	connector, err := NewAccessTokenConnector(
+		"Server=127.0.0.1;Port="+strconv.Itoa(port)+";Database=db;encrypt=disable",
+		func() (string, error) { return token, nil },
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	readLogin := func() []byte {
+		t.Helper()
+		_, _ = connector.Connect(context.Background()) // the peer closes after observing the login
+		select {
+		case err := <-serverErr:
+			t.Fatalf("local SQL peer: %v", err)
+		case packet := <-loginPackets:
+			return packet
+		case <-time.After(3 * time.Second):
+			t.Fatal("timed out waiting for SQL login exchange")
+			return nil
+		}
+		return nil
+	}
+	firstLogin := readLogin()
+	token = "second-token"
+	secondLogin := readLogin()
+
+	for _, tc := range []struct {
+		packet []byte
+		token  string
+	}{{firstLogin, "first-token"}, {secondLogin, "second-token"}} {
+		encodedToken := make([]byte, 0, len(tc.token)*2)
+		for i := 0; i < len(tc.token); i++ {
+			encodedToken = append(encodedToken, tc.token[i], 0)
+		}
+		if !bytes.Contains(tc.packet, encodedToken) {
+			t.Fatalf("access token %q was not present in its SQL login exchange", tc.token)
+		}
+	}
+}
