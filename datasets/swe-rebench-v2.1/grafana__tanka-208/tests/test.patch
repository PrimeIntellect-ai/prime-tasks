+func TestReconcileDoesNotInjectNamespace(t *testing.T) {
+	raw := map[string]interface{}{
+		"ns": map[string]interface{}{
+			"apiVersion": "v1",
+			"kind":       "Namespace",
+			"metadata": map[string]interface{}{
+				"name": "dev",
+			},
+		},
+	}
+
+	spec := v1alpha1.New().Spec
+	spec.Namespace = "testing"
+
+	got, err := Reconcile(raw, spec, nil)
+	require.NoError(t, err)
+	require.Len(t, got, 1)
+	assert.Empty(t, got[0].Metadata().Namespace(), "the spec namespace must not be injected into the manifest")
+}
