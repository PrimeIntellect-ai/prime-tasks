+package com.bnorm.power
+
+import kotlin.test.Test
+import kotlin.test.assertContains
+
+class OperatorTest {
+  @Test
+  fun `contains operator is correctly aligned`() {
+    assertMessage(
+      """
+      fun main() {
+        assert("Name" in listOf("Hello", "World"))
+      }""",
+      """
+      Assertion failed
+      assert("Name" in listOf("Hello", "World"))
+                    |  |
+                    |  [Hello, World]
+                    false
+      """.trimIndent(),
+    )
+  }
+
+  @Test
+  fun `negative contains operator is processed without throwing`() {
+    val message = executeAssertion(
+      """
+      fun main() {
+        assert("Hello" !in listOf("Hello", "World"))
+      }""",
+    )
+    assertContains(message, "Assertion failed")
+    assertContains(message, """assert("Hello" !in listOf("Hello", "World"))""")
+    assertContains(message, "false")
+  }
+
+  @Test
+  fun `contains operator with string is correctly aligned`() {
+    val message = executeAssertion(
+      """
+      fun main() {
+        assert("Hello" in "World")
+      }""",
+    )
+    assertContains(message, "Assertion failed")
+    assertContains(message, """assert("Hello" in "World")""")
+    assertContains(message, "false")
+  }
+
+  @Test
+  fun `negative contains operator with string is correctly aligned`() {
+    val message = executeAssertion(
+      """
+      fun main() {
+        assert("Hello" !in "Hello World")
+      }""",
+    )
+    assertContains(message, "Assertion failed")
+    assertContains(message, """assert("Hello" !in "Hello World")""")
+    assertContains(message, "false")
+  }
+}
