+def test_requirement_source_non_editable_without_egg_fragment(monkeypatch):
+    source = requirement.RequirementSource([Path("requirements1.txt")], ResolveLibResolver())
+    line = "git+https://github.com/unbit/uwsgi.git@1bb9ad77c6d2d310c2d6d1d9ad62de61f725b824"
+
+    monkeypatch.setattr(pip_requirements_parser, "get_file_content", lambda _: line)
+
+    specs = list(source.collect())
+    skipped = [s for s in specs if isinstance(s, SkippedDependency) and s.name == line]
+    assert len(skipped) == 1
+    # The reason should explain that an egg fragment can be supplied.
+    assert "egg" in skipped[0].skip_reason.lower()
+    assert not [s for s in specs if isinstance(s, ResolvedDependency)]
+
