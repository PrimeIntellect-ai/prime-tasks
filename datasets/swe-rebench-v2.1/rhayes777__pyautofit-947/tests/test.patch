         af.Gaussian,
     )
+
+
+def test_model_with_parameterless_component():
+    child = af.Gaussian()
+    model = af.Model(
+        af.Gaussian,
+        centre=child,
+    )
+    model = db.Object.from_object(model)()
+    instance = model.instance_from_prior_medians()
+    assert isinstance(instance.centre, af.Gaussian)
+
+
+
+
+def test_model_with_parameterless_component_from_vector():
+    model = af.Model(af.Gaussian, centre=af.Gaussian())
+    model = db.Object.from_object(model)()
+
+    instance = model.instance_from_vector(model.physical_values_from_prior_medians)
+
+    assert isinstance(instance.centre, af.Gaussian)
