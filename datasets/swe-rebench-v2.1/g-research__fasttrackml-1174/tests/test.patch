@@ -176,6 +176,64 @@ func (s *QueryTestSuite) TestPostgresDialector_Ok() {
 			assert.Equal(s.T(), tt.expectedVars, tx.Statement.Vars)
 		})
 	}
+
+	// Behavioral checks: tag queries must find runs by tag value regardless of
+	// the exact SQL translation (join, subquery, etc.) used to express them.
+	s.Run("TestTagsAttribute", func() {
+		s.assertTagQueryFindsRun(`(run.tags.foo == "bar")`, "foo", "bar")
+	})
+	s.Run("TestTagsSubscript", func() {
+		s.assertTagQueryFindsRun(`(run.tags["my.tag"] == "something")`, "my.tag", "something")
+	})
+}
+
+// assertTagQueryFindsRun parses the given tag query and executes it against an
+// in-memory database containing two runs, only one of which carries the
+// requested tag key/value. It asserts that exactly the matching run is returned.
+func (s *QueryTestSuite) assertTagQueryFindsRun(query, key, value string) {
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{})
+	require.Nil(s.T(), err)
+	require.Nil(s.T(), db.AutoMigrate(&models.Run{}, &models.Tag{}))
+
+	runs := []models.Run{
+		{
+			ID:             "matching-run",
+			Name:           "matching",
+			SourceType:     "UNKNOWN",
+			Status:         models.StatusRunning,
+			LifecycleStage: models.LifecycleStageActive,
+		},
+		{
+			ID:             "other-run",
+			Name:           "other",
+			SourceType:     "UNKNOWN",
+			Status:         models.StatusRunning,
+			LifecycleStage: models.LifecycleStageActive,
+		},
+	}
+	require.Nil(s.T(), db.Create(&runs).Error)
+	require.Nil(s.T(), db.Create(&models.Tag{RunID: "matching-run", Key: key, Value: value}).Error)
+	require.Nil(s.T(), db.Create(&models.Tag{RunID: "other-run", Key: key, Value: "different"}).Error)
+
+	pq := QueryParser{
+		Default: DefaultExpression{
+			Contains:   "run.archived",
+			Expression: "not run.archived",
+		},
+		Tables: map[string]string{
+			"runs":        "runs",
+			"experiments": "Experiment",
+			"metrics":     "metrics",
+		},
+		Dialector: sqlite.Dialector{}.Name(),
+	}
+	parsedQuery, err := pq.Parse(query)
+	require.Nil(s.T(), err)
+
+	var got []models.Run
+	require.Nil(s.T(), parsedQuery.Filter(db.Model(&models.Run{})).Find(&got).Error)
+	require.Len(s.T(), got, 1)
+	assert.Equal(s.T(), "matching-run", got[0].ID)
 }
 
