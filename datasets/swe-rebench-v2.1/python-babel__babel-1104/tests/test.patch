diff --git a/tests/test_dates.py b/tests/test_dates.py
index fb90131..c87ee3d 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -751,3 +751,26 @@ def test_issue_892():
     assert dates.format_timedelta(timedelta(days=1), format='narrow', locale='pt_BR') == '1 dia'
     assert dates.format_timedelta(timedelta(days=30), format='narrow', locale='pt_BR') == '1 mês'
     assert dates.format_timedelta(timedelta(days=365), format='narrow', locale='pt_BR') == '1 ano'
+
+
+def _is_babel_error(exc):
+    return type(exc).__module__.split(".")[0] == "babel"
+
+
+def test_issue_1089():
+    # A locale identifier with a modifier whose data file is unavailable must
+    # not leak a FileNotFoundError.  The contract permits either raising a
+    # Babel error (of any kind) or falling back to a reasonable default (e.g.
+    # the data file without the modifier).
+    locales = ["ja_JP@mod"]
+    try:
+        locales.append(Locale.parse("ja_JP@mod"))
+    except Exception as exc:
+        assert _is_babel_error(exc), f"expected a Babel error, got {exc!r}"
+    for locale in locales:
+        try:
+            result = dates.format_datetime(datetime.utcnow(), locale=locale)
+        except Exception as exc:
+            assert _is_babel_error(exc), f"expected a Babel error, got {exc!r}"
+            continue
+        assert result
