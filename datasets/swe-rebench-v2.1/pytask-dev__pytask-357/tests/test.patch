+@pytest.mark.end_to_end()
+def test_task_is_not_reexecuted_when_modification_changed_file_not(runner, tmp_path):
+    task_path = tmp_path.joinpath("task_example.py")
+    task_path.write_text(
+        "import pytask\n\n"
+        "@pytask.mark.produces('upstream.txt')\n"
+        "def task_upstream(produces):\n"
+        "    with produces.open('a') as file:\n"
+        "        file.write('run\\n')\n\n"
+        "@pytask.mark.depends_on('upstream.txt')\n"
+        "@pytask.mark.produces('downstream.txt')\n"
+        "def task_downstream(depends_on, produces):\n"
+        "    with produces.open('a') as file:\n"
+        "        file.write('run\\n')\n"
+    )
+    result = runner.invoke(cli, [tmp_path.as_posix()])
+    assert result.exit_code == ExitCode.OK
+    assert tmp_path.joinpath("upstream.txt").read_text() == "run\n"
+    assert tmp_path.joinpath("downstream.txt").read_text() == "run\n"
+
+    stat = task_path.stat()
+    os.utime(task_path, (stat.st_atime, stat.st_mtime + 10))
+    result = runner.invoke(cli, [tmp_path.as_posix()])
+
+    assert result.exit_code == ExitCode.OK
+    assert tmp_path.joinpath("upstream.txt").read_text() == "run\n"
+    assert tmp_path.joinpath("downstream.txt").read_text() == "run\n"
+
+
+@pytest.mark.end_to_end()
+def test_changed_python_task_file_is_recognized(runner, tmp_path):
+    task_path = tmp_path.joinpath("task_example.py")
+    task_path.write_text(
+        "import pytask\n\n"
+        "@pytask.mark.produces('output.txt')\n"
+        "def task_example(produces):\n"
+        "    with produces.open('a') as file:\n"
+        "        file.write('run\\n')\n"
+    )
+    result = runner.invoke(cli, [tmp_path.as_posix()])
+    assert result.exit_code == ExitCode.OK
+    assert tmp_path.joinpath("output.txt").read_text() == "run\n"
+
+    stat = task_path.stat()
+    task_path.write_text(
+        "import pytask\n\n"
+        "@pytask.mark.produces('output.txt')\n"
+        "def task_example(produces):\n"
+        "    with produces.open('a') as file:  # changed\n"
+        "        file.write('run\\n')\n"
+    )
+    os.utime(task_path, (stat.st_atime, stat.st_mtime + 10))
+    result = runner.invoke(cli, [tmp_path.as_posix()])
+
+    assert result.exit_code == ExitCode.OK
+    assert tmp_path.joinpath("output.txt").read_text() == "run\nrun\n"
+
+
+@pytest.mark.end_to_end()
+def test_changed_non_python_file_retains_timestamp_detection(runner, tmp_path):
+    tmp_path.joinpath("task_example.py").write_text(
+        "import pytask\n\n"
+        "@pytask.mark.depends_on('input.txt')\n"
+        "@pytask.mark.produces('output.txt')\n"
+        "def task_example(depends_on, produces):\n"
+        "    with produces.open('a') as file:\n"
+        "        file.write('run\\n')\n"
+    )
+    input_path = tmp_path.joinpath("input.txt")
+    input_path.write_text("same content")
+
+    result = runner.invoke(cli, [tmp_path.as_posix()])
+    assert result.exit_code == ExitCode.OK
+    assert tmp_path.joinpath("output.txt").read_text() == "run\n"
+
+    stat = input_path.stat()
+    os.utime(input_path, (stat.st_atime, stat.st_mtime + 10))
+    result = runner.invoke(cli, [tmp_path.as_posix()])
+
+    assert result.exit_code == ExitCode.OK
+    assert tmp_path.joinpath("output.txt").read_text() == "run\nrun\n"
