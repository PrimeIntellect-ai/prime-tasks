+def test_list_inference_endpoints_with_whole_second_timestamps():
+    response = Mock()
+    response.json.return_value = {
+        "items": [
+            {
+                "name": "endpoint",
+                "type": "protected",
+                "model": {
+                    "repository": "repo",
+                    "revision": "revision",
+                    "task": "text-generation",
+                    "framework": "pytorch",
+                },
+                "status": {
+                    "createdAt": "2024-11-20T20:01:58Z",
+                    "updatedAt": "2024-11-21T10:02:03Z",
+                    "state": "pending",
+                },
+            }
+        ]
+    }
+    session = Mock()
+    session.get.return_value = response
+
+    with patch("huggingface_hub.hf_api.get_session", return_value=session):
+        endpoints = HfApi().list_inference_endpoints(namespace="namespace", token=False)
+
+    assert len(endpoints) == 1
+    endpoint = endpoints[0]
+    assert endpoint.name == "endpoint"
+    assert endpoint.created_at == datetime(2024, 11, 20, 20, 1, 58, tzinfo=timezone.utc)
+    assert endpoint.updated_at == datetime(2024, 11, 21, 10, 2, 3, tzinfo=timezone.utc)
