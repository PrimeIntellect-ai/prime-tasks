diff --git a/tests/testthat/test-forecast.R b/tests/testthat/test-forecast.R
index f8e1664..0711295 100644
--- a/tests/testthat/test-forecast.R
+++ b/tests/testthat/test-forecast.R
@@ -173,6 +173,32 @@ test_that("output of as_forecasts() is accepted as input to score()", {
   expect_equal(score_check, suppressMessages(score(as_forecast(example_binary))))
 })
 
+
+test_that("as_forecast() notifies when point observations could be binary", {
+  test_data <- data.frame(
+    observed = c(1, 0, 0, 1, 0, 1),
+    predicted = c(0.2, 0.4, 0.1, 0.8, 0.1, 0.3),
+    model = c("model1", "model2"),
+    date = rep(1:3, times = 2)
+  )
+
+  notifications <- character()
+  withCallingHandlers(
+    as_forecast(test_data),
+    message = function(condition) {
+      notifications <<- c(notifications, conditionMessage(condition))
+      invokeRestart("muffleMessage")
+    },
+    warning = function(condition) {
+      notifications <<- c(notifications, conditionMessage(condition))
+      invokeRestart("muffleWarning")
+    }
+  )
+
+  expect_gt(length(notifications), 0)
+})
+
+
