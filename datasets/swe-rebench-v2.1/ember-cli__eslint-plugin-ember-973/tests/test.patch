diff --git a/tests/lib/rules/no-try-invoke.js b/tests/lib/rules/no-try-invoke.js
new file mode 100644
index 0000000..21a6a99
--- /dev/null
+++ b/tests/lib/rules/no-try-invoke.js
@@ -0,0 +1,43 @@
+const plugin = require('../../../lib');
+const RuleTester = require('eslint').RuleTester;
+const rule = plugin.rules['no-try-invoke'];
+
+const ruleTester = new RuleTester({
+  parserOptions: {
+    ecmaVersion: 2018,
+    sourceType: 'module',
+  },
+});
+
+ruleTester.run('no-try-invoke', rule, {
+  valid: [
+    "tryInvoke(this, 'foo');",
+    "import { tryInvoke } from '@ember/utils'; foo.tryInvoke(this, 'foo');",
+    "import { tryInvoke } from '@ember/utils'; tryInvoke.foo(this, 'foo');",
+    "import { tryInvoke } from '@ember/utils'; foo();",
+    "import { tryInvoke } from 'some-other-module'; tryInvoke(this, 'foo');",
+  ],
+  invalid: [
+    {
+      code: `
+        import { tryInvoke } from '@ember/utils';
+        tryInvoke(this, 'foo');
+      `,
+      errors: 1,
+    },
+    {
+      code: `
+        import { tryInvoke, isPresent } from '@ember/utils';
+        tryInvoke(this, 'foo', ['bar']);
+      `,
+      errors: 1,
+    },
+    {
+      code: `
+        import { tryInvoke as invoke } from '@ember/utils';
+        invoke(this, 'foo');
+      `,
+      errors: 1,
+    },
+  ],
+});
