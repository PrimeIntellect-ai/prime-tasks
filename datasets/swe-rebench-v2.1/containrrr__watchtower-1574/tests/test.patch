+
+var _ = Describe("the container no-pull integration", func() {
+	var docker *cli.Client
+	var mockServer *ghttp.Server
+
+	BeforeEach(func() {
+		mockServer = ghttp.NewServer()
+		docker, _ = cli.NewClientWithOpts(
+			cli.WithHost(mockServer.URL()),
+			cli.WithHTTPClient(mockServer.HTTPTestServer.Client()))
+	})
+
+	AfterEach(func() {
+		mockServer.Close()
+	})
+
+	When("a container is marked with the no-pull label", func() {
+		It("should not pull the image when checking whether it is stale", func() {
+			container := *MockContainer(
+				WithImageName("sha256:fa5269854a5e615e51a72b17ad3fd1e01268f278a6684c8ed3c5f0cdce3f230b"),
+				WithLabels(map[string]string{
+					"com.centurylinklabs.watchtower.no-pull": "true",
+				}),
+			)
+			mockServer.AppendHandlers(
+				ghttp.RespondWithJSONEncoded(http.StatusOK, types.ImageInspect{ID: "image_id"}),
+			)
+			client := dockerClient{api: docker, ClientOptions: ClientOptions{PullImages: true}}
+			_, _, err := client.IsContainerStale(container)
+			Expect(err).NotTo(HaveOccurred())
+		})
+	})
+})
