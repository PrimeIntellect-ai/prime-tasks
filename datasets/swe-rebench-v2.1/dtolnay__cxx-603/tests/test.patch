+void c_take_slice_r(rust::Slice<const R> s) {
+  if (s.size() != 2 || s[0].get() != 2020 || s[1].get() != 2021) {
+    return;
+  }
+
+  std::size_t expected = 2020;
+  std::size_t count = 0;
+  for (const R &r : s) {
+    if (r.get() != expected++) {
+      return;
+    }
+    ++count;
+  }
+  if (count == s.size() && expected == 2022) {
+    cxx_test_suite_set_correct();
+  }
+}
