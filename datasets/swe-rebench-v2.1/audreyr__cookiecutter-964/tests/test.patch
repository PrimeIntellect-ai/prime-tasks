+@pytest.mark.usefixtures('clean_system', 'remove_additional_folders')
+def test_run_failing_post_hook_preserves_existing_output_files():
+    repo_path = os.path.abspath('tests/test-hooks/')
+    hooks_path = os.path.join(repo_path, 'hooks')
+    template_path = os.path.join(repo_path, 'input{{cookiecutter.hooks}}')
+    os.mkdir(repo_path)
+    os.mkdir(hooks_path)
+    os.mkdir(template_path)
+
+    with open(os.path.join(hooks_path, 'post_gen_project.py'), 'w') as f:
+        f.write("#!/usr/bin/env python\n")
+        f.write("import sys; sys.exit(1)\n")
+
+    os.mkdir('inputhooks')
+    existing_file = os.path.join('inputhooks', 'existing_file.txt')
+    with open(existing_file, 'w') as f:
+        f.write('pre-existing content\n')
+
+    with pytest.raises(FailedHookException):
+        generate.generate_files(
+            context={'cookiecutter': {'hooks': 'hooks'}},
+            repo_dir='tests/test-hooks/',
+            overwrite_if_exists=True
+        )
+
+    with open(existing_file) as f:
+        assert f.read() == 'pre-existing content\n'
+
+
