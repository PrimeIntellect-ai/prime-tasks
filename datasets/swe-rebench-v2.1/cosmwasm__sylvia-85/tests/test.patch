+
+#[test]
+fn serde_attributes_are_forwarded_to_message_fields() {
+    // `desc` is annotated with `#[serde(default)]` on the interface method
+    // parameter, so the generated message field must be optional when
+    // deserializing and fall back to its default value when omitted.
+    let json = br#"{"argumented_execution":{"addr":"owner","coef":"0.1"}}"#;
+    let msg: interface::ExecMsg = cosmwasm_std::from_slice(json).unwrap();
+    match msg {
+        interface::ExecMsg::ArgumentedExecution { addr, coef, desc } => {
+            assert_eq!(addr, Addr::unchecked("owner"));
+            assert_eq!(coef, Decimal::percent(10));
+            assert_eq!(desc, String::default());
+        }
+        _ => panic!("unexpected variant"),
+    }
+
+    // The contract message forwards `#[serde(default)]` from `_coef` and
+    // `_desc`, so both may be omitted while `_addr` stays required.
+    let json = br#"{"argumented_execution":{"_addr":"owner"}}"#;
+    let msg: contract::ExecMsg = cosmwasm_std::from_slice(json).unwrap();
+    match msg {
+        contract::ExecMsg::ArgumentedExecution { _addr, _coef, _desc } => {
+            assert_eq!(_addr, Addr::unchecked("owner"));
+            assert_eq!(_coef, Decimal::default());
+            assert_eq!(_desc, String::default());
+        }
+        _ => panic!("unexpected variant"),
+    }
+}
