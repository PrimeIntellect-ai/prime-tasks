+    # Character ranges index the source string by characters rather than bytes,
+    # so they remain valid when the source contains multi-byte Unicode characters.
+    src = "ab + αβ"
+    t = parsestmt(SyntaxNode, src)
+    @test JuliaSyntax.char_range(t[1]) == 1:2
+    @test JuliaSyntax.char_range(t[2]) == 4:4
+    @test JuliaSyntax.char_range(t[3]) == 6:8
+    @test src[JuliaSyntax.char_range(t[3])] == "αβ"
 end
 
