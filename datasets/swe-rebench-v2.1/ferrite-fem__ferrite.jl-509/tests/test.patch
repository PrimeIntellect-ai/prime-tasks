 # misc constraint tests
+
+@testset "constructors and error checking" begin
+    grid = generate_grid(Triangle, (2, 2))
+    Γ = getfaceset(grid, "left")
+    face_map = collect_periodic_faces(grid, "left", "right")
+    dh = DofHandler(grid)
+    push!(dh, :s, 1)
+    push!(dh, :v, 2)
+    close!(dh)
+
+    function constrained_dofs(condition)
+        ch = ConstraintHandler(dh)
+        add!(ch, condition)
+        return sort(ch.prescribed_dofs)
+    end
+
+    # Omitting components constrains every component of a Dirichlet field.
+    @test constrained_dofs(Dirichlet(:s, Γ, (x, t) -> 0)) ==
+          constrained_dofs(Dirichlet(:s, Γ, (x, t) -> 0, [1]))
+    @test constrained_dofs(Dirichlet(:v, Γ, (x, t) -> 0)) ==
+          constrained_dofs(Dirichlet(:v, Γ, (x, t) -> 0, [1, 2]))
+
+    # The same default applies to every PeriodicDirichlet overload.
+    @test constrained_dofs(PeriodicDirichlet(:s, face_map)) ==
+          constrained_dofs(PeriodicDirichlet(:s, face_map, [1]))
+    @test constrained_dofs(PeriodicDirichlet(:v, face_map)) ==
+          constrained_dofs(PeriodicDirichlet(:v, face_map, [1, 2]))
+    @test constrained_dofs(PeriodicDirichlet(:v, face_map, (x, t) -> 0 * x)) ==
+          constrained_dofs(PeriodicDirichlet(:v, face_map, (x, t) -> 0 * x, [1, 2]))
+    @test constrained_dofs(PeriodicDirichlet(:v, face_map, rotation_tensor(0.0))) ==
+          constrained_dofs(PeriodicDirichlet(:v, face_map, rotation_tensor(0.0), [1, 2]))
+    # The same Dirichlet default applies when adding through a FieldHandler.
+    mixed_grid = generate_grid(Quadrilateral, (2, 2))
+    addcellset!(mixed_grid, "allcells", Set(1:4))
+    mixed_dh = MixedDofHandler(mixed_grid)
+    vector_field = Field(:v, Lagrange{2, RefCube, 1}(), 2)
+    push!(mixed_dh, FieldHandler([vector_field], getcellset(mixed_grid, "allcells")))
+    close!(mixed_dh)
+    mixed_faces = getfaceset(mixed_grid, "left")
+    function fieldhandler_constrained_dofs(condition)
+        ch = ConstraintHandler(mixed_dh)
+        add!(ch, mixed_dh.fieldhandlers[1], condition)
+        return sort(ch.prescribed_dofs)
+    end
+    @test fieldhandler_constrained_dofs(Dirichlet(:v, mixed_faces, (x, t) -> 0)) ==
+          fieldhandler_constrained_dofs(Dirichlet(:v, mixed_faces, (x, t) -> 0, [1, 2]))
+end
+
