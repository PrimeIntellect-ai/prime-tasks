+    @Test
+    public void testHeadingsAccessors() {
+        GHRequest req = new GHRequest();
+        // an empty heading list is allowed
+        assertSame(req, req.setHeadings(Collections.emptyList()));
+        assertEquals(Collections.emptyList(), req.getHeadings());
+        // a single heading is allowed
+        List<Double> single = Collections.singletonList(90.);
+        assertSame(req, req.setHeadings(single));
+        assertEquals(single, req.getHeadings());
+        // NaN entries denote "no heading" and are preserved
+        List<Double> withNaN = Arrays.asList(90., Double.NaN);
+        assertSame(req, req.setHeadings(withNaN));
+        assertEquals(withNaN, req.getHeadings());
+    }
