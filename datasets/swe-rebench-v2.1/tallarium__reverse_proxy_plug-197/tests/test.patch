diff --git a/test/reverse_proxy_plug_test.exs b/test/reverse_proxy_plug_test.exs
index 7110bf9..d7b04bb 100644
--- a/test/reverse_proxy_plug_test.exs
+++ b/test/reverse_proxy_plug_test.exs
@@ -36,6 +36,10 @@ defmodule ReverseProxyPlugTest do
 
   setup :verify_on_exit!
 
+  defmodule MyCustomAdapter do
+    # Used for adapter configuration testing
+  end
+
   test "receives buffer response" do
     headers = [{"host", "example.com"}, {"content-length", "42"}]
 
@@ -680,7 +684,31 @@ defmodule ReverseProxyPlugTest do
   test "must be initialized with either global or local config set" do
     prev = Application.get_env(:reverse_proxy_plug, :http_client)
 
-    on_exit(fn -> Application.put_env(:reverse_proxy_plug, :http_client, prev) end)
+    on_exit(fn ->
+      Application.put_env(:reverse_proxy_plug, :http_client, prev)
+      Code.ensure_loaded(ReverseProxyPlug.HTTPClient.Adapters.HTTPoison)
+    end)
+
+    # Simulate the adapter module not being loaded yet, as happens in a real
+    # application where the configured adapter is loaded lazily. A globally
+    # configured streaming-capable adapter must still work with the default
+    # :stream response mode.
+    :code.purge(ReverseProxyPlug.HTTPClient.Adapters.HTTPoison)
+    :code.delete(ReverseProxyPlug.HTTPClient.Adapters.HTTPoison)
+
+    Application.put_env(
+      :reverse_proxy_plug,
+      :http_client,
+      ReverseProxyPlug.HTTPClient.Adapters.HTTPoison
+    )
+
+    assert opts =
+             ReverseProxyPlug.init(
+               upstream: "",
+               error_callback: {__MODULE__, :error_handler, []}
+             )
+
+    assert opts[:client] == ReverseProxyPlug.HTTPClient.Adapters.HTTPoison
 
     Application.put_env(:reverse_proxy_plug, :http_client, nil)
 
