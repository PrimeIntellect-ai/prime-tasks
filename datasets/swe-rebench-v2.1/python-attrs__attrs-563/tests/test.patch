+    def test_auto_exc_preserves_user_defined_comparison_and_hash(self):
+        @attr.s(auto_exc=True, cmp=False, hash=False)
+        class CustomError(Exception):
+            value = attr.ib()
+
+            def __eq__(self, other):
+                if not isinstance(other, CustomError):
+                    return NotImplemented
+                return self.value == other.value
+
+            def __hash__(self):
+                return 17
+
+        first = CustomError(1)
+        second = CustomError(1)
+
+        assert first == second
+        assert hash(first) == 17
+        assert hash(second) == 17
 
