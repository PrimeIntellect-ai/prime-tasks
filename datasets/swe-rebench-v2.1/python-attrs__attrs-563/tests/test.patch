+    @pytest.mark.parametrize("cmp", [True, False])
+    @pytest.mark.parametrize("hash_setting", [None, True, False])
+    def test_auto_exc_hash_and_comparison_ignore_settings(self, cmp, hash_setting):
+        @attr.s(auto_exc=True, cmp=cmp, hash=hash_setting)
+        class ConfiguredError(Exception):
+            value = attr.ib()
+
+        first = ConfiguredError(1)
+        second = ConfiguredError(1)
+
