+
+describe('Recording and replaying encoded responses through http.get', () => {
+  const decodeBody = (buffer, contentEncoding) => {
+    const codings = contentEncoding
+      .split(',')
+      .map(coding => coding.trim().toLowerCase())
+      .reverse()
+    let body = buffer
+    for (const coding of codings) {
+      if (coding === 'gzip') body = zlib.gunzipSync(body)
+      else if (coding === 'deflate') body = zlib.inflateSync(body)
+      else if (coding === 'br') body = zlib.brotliDecompressSync(body)
+    }
+    return body.toString('utf8')
+  }
+
+  const getWithHttp = url =>
+    new Promise((resolve, reject) => {
+      http
+        .get(url, response => {
+          const chunks = []
+          response.on('data', chunk => chunks.push(chunk))
+          response.on('end', () =>
+            resolve({
+              headers: response.headers,
+              body: Buffer.concat(chunks),
+            }),
+          )
+          response.on('error', reject)
+        })
+        .on('error', reject)
+    })
+
+  const encodings = [
+    ['gzip', text => zlib.gzipSync(text)],
+    ['deflate', text => zlib.deflateSync(text)],
+    ['br', text => zlib.brotliCompressSync(text)],
+    ['gzip, br', text => zlib.brotliCompressSync(zlib.gzipSync(text))],
+  ]
+
+  for (const [contentEncoding, compress] of encodings) {
+    it(`records and replays ${contentEncoding} responses`, async () => {
+      const exampleText = '<html><body>example</body></html>'
+
+      const { origin } = await startHttpServer((request, response) => {
+        response.writeHead(200, { 'content-encoding': contentEncoding })
+        response.end(compress(exampleText))
+      })
+
+      nock.restore()
+      nock.recorder.clear()
+      expect(nock.recorder.play()).to.be.empty()
+
+      nock.recorder.rec({
+        dont_print: true,
+        output_objects: true,
+      })
+
+      const response1 = await getWithHttp(origin)
+      expect(decodeBody(response1.body, contentEncoding)).to.equal(exampleText)
+      expect(response1.headers['content-encoding']).to.equal(contentEncoding)
+
+      nock.restore()
+      const recorded = nock.recorder.play()
+      nock.recorder.clear()
+      nock.activate()
+
+      expect(recorded).to.have.lengthOf(1)
+      const nocks = nock.define(recorded)
+
+      const response2 = await getWithHttp(origin)
+      expect(decodeBody(response2.body, contentEncoding)).to.equal(exampleText)
+      expect(response2.headers['content-encoding']).to.equal(contentEncoding)
+
+      nocks.forEach(nock => nock.done())
+    })
+  }
