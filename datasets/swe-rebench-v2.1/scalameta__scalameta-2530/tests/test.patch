+            Ctor.Secondary(
+              Nil,
+              Name(""),
+              List(List(Term.Param(Nil, Term.Name("x"), Some(Type.Name("Int")), None))),
+              Init(Type.Singleton(Term.This(Name(""))), Name(""), List(List())),
+              Nil
+            )
+          ),
+          Nil
+        )
+      )
+    )
+  }
+
