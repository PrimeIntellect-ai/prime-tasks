+
+def test_motifs_with_max_matches_none():
+    T = np.array([0.0, 1, 2, 2, 0, 1, 2, 2, 0, 0, 0, 0])
+    m = 3
+
+    mp = naive.stump(T, m, row_wise=True)
+    comp_distance, comp_indices = motifs(
+        T,
+        mp[:, 0].astype(np.float64),
+        min_neighbors=1,
+        max_distance=np.inf,
+        cutoff=np.inf,
+        max_matches=None,
+        max_motifs=1,
+    )
+
+    npt.assert_(comp_distance.shape[1] > 1)
+    npt.assert_(comp_indices.shape[1] > 1)
