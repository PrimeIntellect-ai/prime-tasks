+class _RetryableUploadHandler(BaseHTTPRequestHandler):
+    """Test HTTP handler that records PUT bodies and fails the first request."""
+
+    def do_PUT(self):
+        content_length = int(self.headers.get("Content-Length", 0))
+        body = self.rfile.read(content_length) if content_length else b""
+        self.server.received_bodies.append(body)
+        self.send_response(500 if len(self.server.received_bodies) == 1 else 200)
+        self.end_headers()
+
+    def log_message(self, *args):
+        pass
+
