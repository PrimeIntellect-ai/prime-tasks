+class TestHttpBackoffSliceFileObj(unittest.TestCase):
+    """`http_backoff` must re-send the full content when retrying seekable file-like request data."""
+
+    def test_http_backoff_retries_slice_fileobj(self):
+        content = bytes(range(256)) * 8
+        with _local_server(_RetryableUploadHandler, received_bodies=[]) as server:
+            url = f"http://127.0.0.1:{server.server_port}/upload"
+            with SliceFileObj(BytesIO(content), seek_from=100, read_limit=200) as fileobj_slice:
+                response = http_backoff(
+                    "PUT",
+                    url,
+                    data=fileobj_slice,
+                    retry_on_status_codes=(500,),
+                    base_wait_time=0.0,
+                )
+
+        self.assertEqual(response.status_code, 200)
+        # The request must have been retried after the transient 500.
+        self.assertEqual(len(server.received_bodies), 2)
+        # Both attempts must carry the full slice content, not an exhausted stream.
+        self.assertEqual(server.received_bodies[0], content[100:300])
+        self.assertEqual(server.received_bodies[1], content[100:300])
+
+    def test_http_backoff_retries_bytesio_body(self):
+        content = bytes(range(256)) * 8
+        with _local_server(_RetryableUploadHandler, received_bodies=[]) as server:
+            url = f"http://127.0.0.1:{server.server_port}/upload"
+            response = http_backoff(
+                "PUT",
+                url,
+                data=BytesIO(content),
+                retry_on_status_codes=(500,),
+                base_wait_time=0.0,
+            )
+
+        self.assertEqual(response.status_code, 200)
+        # The request must have been retried after the transient 500.
+        self.assertEqual(len(server.received_bodies), 2)
+        # Both attempts must carry the full content of the file-like body.
+        self.assertEqual(server.received_bodies[0], content)
+        self.assertEqual(server.received_bodies[1], content)
