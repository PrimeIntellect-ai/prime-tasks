+class _LfsMultipartHandler(BaseHTTPRequestHandler):
+    """Fails the first part upload with a transient 500, then accepts part uploads and the completion request."""
+
+    def do_PUT(self):
+        content_length = int(self.headers.get("Content-Length", 0))
+        body = self.rfile.read(content_length) if content_length else b""
+        if not self.server.failed_once:
+            self.server.failed_once = True
+            self._respond(500)
+            return
+        self.server.accepted_parts[self.path] = body
+        part_number = self.path.rsplit("/", 1)[-1]
+        self._respond(200, etag=f"etag-{part_number}")
+
+    def do_POST(self):
+        content_length = int(self.headers.get("Content-Length", 0))
+        body = self.rfile.read(content_length) if content_length else b""
+        self.server.completion_payloads.append(json.loads(body))
+        self._respond(200)
+
+    def _respond(self, status, etag=None):
+        self.send_response(status)
+        if etag is not None:
+            self.send_header("ETag", etag)
+        self.send_header("Content-Length", "0")
+        self.end_headers()
+
+    def log_message(self, *args):
+        pass
+
+
+class TestLfsUploadRetry(unittest.TestCase):
+    def test_lfs_multipart_upload_retries_transient_part_failure(self):
+        chunk_size = 2048
+        content = bytes(range(256)) * 16  # 4096 bytes, uploaded as two parts
+        with _local_server(
+            _LfsMultipartHandler, failed_once=False, accepted_parts={}, completion_payloads=[]
+        ) as server:
+            base_url = f"http://127.0.0.1:{server.server_port}"
+            lfs_batch_action = {
+                "oid": sha256(content).hexdigest(),
+                "size": len(content),
+                "actions": {
+                    "upload": {
+                        "href": f"{base_url}/complete",
+                        "header": {
+                            "chunk_size": chunk_size,
+                            "1": f"{base_url}/parts/1",
+                            "2": f"{base_url}/parts/2",
+                        },
+                    }
+                }
+            }
+            operation = CommitOperationAdd(path_in_repo="file.bin", path_or_fileobj=content)
+            # Must not raise even though the first part upload fails transiently.
+            lfs_upload(operation=operation, lfs_batch_action=lfs_batch_action)
+
+        # The transient failure really happened, and the upload still completed.
+        self.assertTrue(server.failed_once)
+        self.assertEqual(server.accepted_parts["/parts/1"], content[:chunk_size])
+        self.assertEqual(server.accepted_parts["/parts/2"], content[chunk_size:])
+        self.assertEqual(len(server.completion_payloads), 1)
+        payload = server.completion_payloads[0]
+        self.assertEqual(payload["oid"], sha256(content).hexdigest())
+        self.assertEqual(
+            [(part["partNumber"], part["etag"]) for part in payload["parts"]],
+            [(1, "etag-1"), (2, "etag-2")],
+        )
