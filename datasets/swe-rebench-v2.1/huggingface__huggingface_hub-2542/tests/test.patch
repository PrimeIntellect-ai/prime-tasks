+class _DisconnectOnceHandler(BaseHTTPRequestHandler):
+    """Drop the first connection to simulate a transient request failure."""
+
+    def do_GET(self):
+        self.server.request_count += 1
+        if self.server.request_count == 1:
+            self.connection.shutdown(socket.SHUT_RDWR)
+            self.connection.close()
+            return
+        self.send_response(200)
+        self.end_headers()
+
+    def log_message(self, *args):
+        pass
+
+
+class TestHttpBackoffExceptions(unittest.TestCase):
+    def test_http_backoff_retries_configured_connection_exception(self):
+        with _local_server(_DisconnectOnceHandler, request_count=0) as server:
+            response = http_backoff(
+                "GET",
+                f"http://127.0.0.1:{server.server_port}/resource",
+                max_retries=1,
+                base_wait_time=0.0,
+                retry_on_exceptions=(requests.ConnectionError,),
+            )
+
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(server.request_count, 2)
