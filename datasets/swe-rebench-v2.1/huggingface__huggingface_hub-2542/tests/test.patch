+@contextmanager
+def _local_server(handler_class, **state):
+    """Run an HTTP server on localhost in a background thread, with extra attributes set on the server."""
+    server = HTTPServer(("127.0.0.1", 0), handler_class)
+    for key, value in state.items():
+        setattr(server, key, value)
+    thread = threading.Thread(target=server.serve_forever)
+    thread.start()
+    try:
+        yield server
+    finally:
+        server.shutdown()
+        thread.join()
+        server.server_close()
+
