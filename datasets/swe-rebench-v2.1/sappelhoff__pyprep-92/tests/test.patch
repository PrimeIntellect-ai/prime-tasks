+def _make_channel_bad(raw, bad_kind):
+    """Make the first channel of ``raw`` bad in the requested way."""
+    if bad_kind == "nan":
+        raw._data[0, -1] = np.nan
+    elif bad_kind == "flat":
+        raw._data[0, :] = 1e-6
+    elif bad_kind == "snr":
+        times = raw.times
+        signal = np.zeros_like(times)
+        for freq in (10, 15, 20, 25, 30):
+            signal += np.sin(2 * np.pi * times * freq)
+        raw._data[0, :] = signal * 1e-6
+        hf_noise = np.zeros_like(times)
+        for freq in (70, 72, 75, 78, 80):
+            hf_noise += np.sin(2 * np.pi * times * freq)
+        raw._data[0, :] += hf_noise * 1e-6 * 10
+
+
+@pytest.mark.usefixtures("raw", "montage")
+@pytest.mark.parametrize("bad_kind", ["nan", "flat", "snr"])
+def test_interpolated_channels_included_in_reference(raw, montage, bad_kind):
+    """Test that interpolated channels are used in the final average reference.
+
+    Channels flagged as bad by NaN, flat, or low SNR on the initial pass must
+    still contribute to the average reference signal after interpolation.
+    """
+    ch_names = raw.info["ch_names"]
+
+    raw_tmp = raw.copy()
+    raw_tmp.set_montage(montage)
+
+    # Make a single channel bad so that it gets interpolated
+    _make_channel_bad(raw_tmp, bad_kind)
+
+    params = {"ref_chs": ch_names, "reref_chs": ch_names}
+    reference = Reference(raw_tmp, params, ransac=False)
+    reference.perform_reference()
+
+    # The final average reference must be computed over all reference
+    # channels, including the ones that were interpolated
+    dummy = raw_tmp.copy()
+    dummy.info["bads"] = reference.noisy_channels["bad_all"]
+    dummy.interpolate_bads()
+    expected = np.nanmean(dummy.get_data(picks=ch_names), axis=0) * 1e6
+    assert np.allclose(reference.reference_signal, expected)
+
+
