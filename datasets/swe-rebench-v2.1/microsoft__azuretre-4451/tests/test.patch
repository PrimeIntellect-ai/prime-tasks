+async def test_patch_resource_with_install_action_applies_non_updateable_property(_, template_repo, ___, resource_repo, resource_history_repo):
+    """
+    A patch applied with the install action persists properties that are not marked updateable.
+    """
+
+    template_repo.enrich_template = MagicMock(return_value=sample_resource_template())
+    resource_repo.update_item_with_etag = AsyncMock(return_value=None)
+
+    resource = sample_resource()
+    patch = ResourcePatch(properties={'os_image': 'Windows 10'})
