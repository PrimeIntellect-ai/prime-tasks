+@patch('db.repositories.resources.ResourceTemplateRepository.enrich_template')
+def test_validate_patch_with_install_action_allows_non_updateable_fields(template_repo, resource_repo):
+    """
+    Install patches may set properties that are not marked updateable.
+    """
+
+    template_repo.enrich_template = MagicMock(return_value=sample_resource_template())
+    template = sample_resource_template()
+
+    # os_image is not updateable, but install should still accept it
+    patch = ResourcePatch(isEnabled=True, properties={'os_image': 'Windows 10'})
+    resource_repo.validate_patch(patch, template_repo, template, "install")
+
+
+@pytest.mark.asyncio
+@patch("db.repositories.resources_history.ResourceHistoryRepository.save_item", return_value=AsyncMock())
