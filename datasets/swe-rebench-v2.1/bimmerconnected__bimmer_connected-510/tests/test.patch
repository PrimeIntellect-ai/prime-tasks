+@pytest.mark.asyncio
+async def test_vehicle_image_view_directions(caplog):
+    """Test that supported view directions retrieve images without reported failures."""
+    vehicle = (await get_mocked_account()).get_vehicle(VIN_G01)
+
+    for view_direction in (
+        VehicleViewDirection.FRONTSIDE,
+        VehicleViewDirection.FRONT,
+        VehicleViewDirection.SIDE,
+    ):
+        with account_mock() as mock_api:
+            def image_response(request):
+                # These values are the ones reported to return 424.
+                rejected_views = {"VehicleInfo", "ChargingHistory"}
+                status = 424 if request.url.params.get("carView") in rejected_views else 200
+                return httpx.Response(status, content="png_image", headers={"content-type": "image/png"})
+
+            mock_api.get(
+                path__regex=r"(.*)/eadrax-ics/v3/presentation/vehicles/\w*/images",
+            ).mock(side_effect=image_response)
+            assert b"png_image" == await vehicle.get_vehicle_image(view_direction)
+
+    assert len(get_deprecation_warning_count(caplog)) == 0
+
