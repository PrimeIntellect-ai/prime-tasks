+          },
+        ],
+      }).apply(compiler);
+
+      const arrayOfStats = [];
+      const watching = compiler.watch({}, (error, stats) => {
+        if (error || stats.hasErrors()) {
+          return;
+        }
+
+        arrayOfStats.push(stats);
+      });
+
+      try {
