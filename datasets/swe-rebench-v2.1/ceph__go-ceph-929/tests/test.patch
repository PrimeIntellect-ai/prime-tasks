+
+func TestFileOpsStable(t *testing.T) {
+	// These methods must be available without the ceph_preview build tag.
+	mt := reflect.TypeOf(&MountInfo{})
+	for _, name := range []string{"Mknod", "Futime", "Futimens", "Futimes"} {
+		_, ok := mt.MethodByName(name)
+		assert.True(t, ok, "MountInfo.%s should be available", name)
+	}
+}
+
+func TestAPIStatus(t *testing.T) {
+	type apiEntry struct {
+		Name                string `json:"name"`
+		BecameStableVersion string `json:"became_stable_version"`
+	}
+	type packageStatus struct {
+		StableAPI     []apiEntry `json:"stable_api"`
+		DeprecatedAPI []apiEntry `json:"deprecated_api"`
+		PreviewAPI    []apiEntry `json:"preview_api"`
+	}
+
+	contents, err := os.ReadFile("../docs/api-status.json")
+	assert.NoError(t, err)
+	if err != nil {
+		return
+	}
+	var status map[string]packageStatus
+	assert.NoError(t, json.Unmarshal(contents, &status))
+	if status == nil {
+		return
+	}
+	for _, pkg := range []string{"cephfs", "rbd", "cephfs/admin"} {
+		assert.Contains(t, status, pkg, "API status should describe %s", pkg)
+	}
+
+	for pkg, names := range map[string][]string{
+		"cephfs": {"MountInfo.Mknod", "MountInfo.Futime", "MountInfo.Futimens", "MountInfo.Futimes"},
+		"rbd":    {"Image.LockAcquire", "Image.LockBreak", "Image.LockGetOwners", "Image.LockIsExclusiveOwner", "Image.LockRelease"},
+	} {
+		stable := make(map[string]string)
+		for _, entry := range status[pkg].StableAPI {
+			stable[entry.Name] = entry.BecameStableVersion
+		}
+		for _, name := range names {
+			assert.Equal(t, "v0.24.0", stable[name], "%s should be listed as stable in v0.24.0", name)
+		}
+	}
+
+	adminStatus := status["cephfs/admin"]
+	for _, entries := range [][]apiEntry{adminStatus.StableAPI, adminStatus.DeprecatedAPI, adminStatus.PreviewAPI} {
+		for _, entry := range entries {
+			assert.NotEqual(t, "New", entry.Name, "removed admin.New should not appear in API status")
+		}
+	}
+}
+
+func TestAdminNewRemoved(t *testing.T) {
+	cmd := exec.Command("go", "doc", "github.com/ceph/go-ceph/cephfs/admin.New")
+	assert.Error(t, cmd.Run(), "cephfs/admin.New should no longer be an exported API")
+}
