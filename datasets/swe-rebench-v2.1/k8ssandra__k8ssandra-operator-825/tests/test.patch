+func TestServiceAccountFlowsToGeneratedDatacenter(t *testing.T) {
+	base := GetDatacenterConfig()
+	tests := []struct {
+		name                  string
+		clusterServiceAccount string
+		dcServiceAccount      string
+		want                  string
+	}{
+		{
+			name:                  "cluster default",
+			clusterServiceAccount: "cluster-account",
+			want:                  "cluster-account",
+		},
+		{
+			name:                  "datacenter override",
+			clusterServiceAccount: "cluster-account",
+			dcServiceAccount:      "dc-account",
+			want:                  "dc-account",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			clusterInput, err := yaml.Marshal(map[string]interface{}{
+				"serverVersion":  base.ServerVersion.String(),
+				"storageConfig":  base.StorageConfig,
+				"serviceAccount": tc.clusterServiceAccount,
+				"serverType":     base.ServerType,
+			})
+			require.NoError(t, err)
+			clusterTemplate := &api.CassandraClusterTemplate{}
+			require.NoError(t, yaml.Unmarshal(clusterInput, clusterTemplate))
+
+			dcInput, err := yaml.Marshal(map[string]interface{}{
+				"size":           3,
+				"serviceAccount": tc.dcServiceAccount,
+			})
+			require.NoError(t, err)
+			dcTemplate := &api.CassandraDatacenterTemplate{}
+			require.NoError(t, yaml.Unmarshal(dcInput, dcTemplate))
+
+			config := Coalesce("cluster", clusterTemplate, dcTemplate)
+			dc, err := NewDatacenter(types.NamespacedName{Name: "cluster", Namespace: "test-namespace"}, config)
+			require.NoError(t, err)
+			assert.Equal(t, tc.want, dc.Spec.ServiceAccount)
+		})
+	}
+}
+
+// TestServiceAccountExposedInCRD verifies that the ServiceAccount option is exposed through the
+// CassandraCluster CRD schema. This ensures users can configure a pre-existing service account on
+// a CassandraCluster custom resource, not only through Go structs.
+func TestServiceAccountExposedInCRD(t *testing.T) {
+	crdPath := filepath.Join("..", "..", "config", "crd", "bases", "k8ssandra.io_k8ssandraclusters.yaml")
+	data, err := os.ReadFile(crdPath)
+	require.NoError(t, err)
+
+	var crd apiextensionsv1.CustomResourceDefinition
+	require.NoError(t, yaml.Unmarshal(data, &crd))
+	require.NotEmpty(t, crd.Spec.Versions)
+
+	schema := crd.Spec.Versions[0].Schema.OpenAPIV3Schema
+	require.NotNil(t, schema)
+
+	cassandra := schema.Properties["spec"].Properties["cassandra"]
+
+	// Cluster-level DatacenterOptions (inlined into CassandraClusterTemplate).
+	require.Contains(t, cassandra.Properties, "serviceAccount",
+		"cluster-level DatacenterOptions must expose serviceAccount in the CRD schema")
+	assert.Equal(t, "string", cassandra.Properties["serviceAccount"].Type)
+
+	// Datacenter-level DatacenterOptions (inlined into CassandraDatacenterTemplate).
+	dcItems := cassandra.Properties["datacenters"].Items
+	require.NotNil(t, dcItems)
+	require.Contains(t, dcItems.Schema.Properties, "serviceAccount",
+		"datacenter-level DatacenterOptions must expose serviceAccount in the CRD schema")
+	assert.Equal(t, "string", dcItems.Schema.Properties["serviceAccount"].Type)
+}
