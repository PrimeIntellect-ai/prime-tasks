+    @Test
+    void testMysqlConnectorJManagedVersion() throws Exception {
+        String bom = Files.readString(findDependenciesPom());
+        Matcher m = Pattern.compile("<groupId>com\\.mysql</groupId>\\s*<artifactId>mysql-connector-j</artifactId>\\s*"
+                                            + "<version>\\s*([^<\\s]+)\\s*</version>")
+                .matcher(bom);
+        assertThat("Managed mysql-connector-j entry in dependency management", m.find(), is(true));
+        String version = m.group(1);
+        if (version.startsWith("${") && version.endsWith("}")) {
+            String propName = version.substring(2, version.length() - 1);
+            Matcher p = Pattern.compile("<" + Pattern.quote(propName) + ">\\s*([^<\\s]+)\\s*</"
+                                                + Pattern.quote(propName) + ">").matcher(bom);
+            assertThat("Managed mysql-connector-j version property " + propName, p.find(), is(true));
+            version = p.group(1);
+        }
+        assertThat("Managed mysql-connector-j version " + version + " must be 8.2.0 or newer",
+                   compareVersions(version, "8.2.0"), greaterThanOrEqualTo(0));
+    }
+
+    private static Path findDependenciesPom() {
+        Path dir = Path.of("").toAbsolutePath();
+        while (dir != null) {
+            Path candidate = dir.resolve("dependencies").resolve("pom.xml");
+            if (Files.isRegularFile(candidate)) {
+                return candidate;
+            }
+            dir = dir.getParent();
+        }
+        throw new IllegalStateException("Cannot locate dependencies/pom.xml above " + Path.of("").toAbsolutePath());
+    }
+
+    private static int compareVersions(String actual, String expected) {
+        String[] a = actual.split("\\.");
+        String[] e = expected.split("\\.");
+        for (int i = 0; i < Math.max(a.length, e.length); i++) {
+            int ai = i < a.length ? leadingNumber(a[i]) : 0;
+            int ei = i < e.length ? leadingNumber(e[i]) : 0;
+            if (ai != ei) {
+                return Integer.compare(ai, ei);
+            }
+        }
+        return 0;
+    }
+
+    private static int leadingNumber(String part) {
+        int end = 0;
+        while (end < part.length() && Character.isDigit(part.charAt(end))) {
+            end++;
+        }
+        return end == 0 ? 0 : Integer.parseInt(part.substring(0, end));
+    }
+
     private static String scopeExpr(String meterName, String key, String value, String suffix) {
         return meterName + "{" + key + "=\"" + value + "\",} " + suffix;
     }
