diff --git a/test/chol.jl b/test/chol.jl
new file mode 100644
index 0000000..f1a9f5e
--- /dev/null
+++ b/test/chol.jl
@@ -0,0 +1,33 @@
+using LinearAlgebra, PDMats
+using PDMats: chol_lower, chol_upper
+
+@testset "chol_lower" begin
+    A = rand(100, 100)
+    C = A'A
+    size_of_one_copy = sizeof(C)
+    @assert size_of_one_copy > 100  # ensure the matrix is large enough that few-byte allocations don't matter
+
+    chol_lower(C)
+    @test (@allocated chol_lower(C)) < 1.05 * size_of_one_copy  # allow 5% overhead
+
+    # the returned value is the lower Cholesky factor of C
+    L = chol_lower(C)
+    @test L * L' ≈ C
+
+    # a dense matrix is interpreted as Hermitian using its lower triangle
+    M = copy(C)
+    M[1, 2] += 1.0  # perturb the upper triangle only
+    Lm = chol_lower(M)
+    @test Lm * Lm' ≈ Hermitian(M, :L)
+
+    for uplo in (:L, :U)
+        ch = cholesky(Symmetric(C, uplo))
+        chol_lower(ch)
+        @test (@allocated chol_lower(ch)) < 50  # allow small overhead for wrapper types
+        chol_upper(ch)
+
+        # the returned values are the lower/upper Cholesky factors of C
+        @test chol_lower(ch) * chol_lower(ch)' ≈ C
+        @test chol_upper(ch)' * chol_upper(ch) ≈ C
+    end
+end
