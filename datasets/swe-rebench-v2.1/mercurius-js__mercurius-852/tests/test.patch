   }))
 })
 
+test('subscription connection replies to a keepalive ping with a pong', async (t) => {
+  const { EventEmitter } = require('events')
+  const socket = new EventEmitter()
+  socket.protocol = GRAPHQL_TRANSPORT_WS
+  const sent = []
+  socket.send = message => sent.push(JSON.parse(message))
+
+  new SubscriptionConnection(socket, {})
+  socket.emit('message', Buffer.from(JSON.stringify({ type: 'ping' })), true)
+  await new Promise(resolve => setImmediate(resolve))
+
+  t.ok(sent.some(message => message.type === 'pong'))
+})
+
+test('subscription connection tolerates a received pong without replying', async (t) => {
+  const { EventEmitter } = require('events')
+  const socket = new EventEmitter()
+  socket.protocol = GRAPHQL_TRANSPORT_WS
+  const sent = []
+  socket.send = message => sent.push(JSON.parse(message))
+
+  new SubscriptionConnection(socket, {})
+  socket.emit('message', Buffer.from(JSON.stringify({ type: 'pong' })), true)
+  await new Promise(resolve => setImmediate(resolve))
+
+  t.same(sent, [])
+})
+
