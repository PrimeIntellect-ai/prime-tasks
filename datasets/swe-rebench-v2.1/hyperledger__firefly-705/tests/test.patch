+func TestHandleContractAPIBroadcastIDMismatchIsRejectedWithoutRetry(t *testing.T) {
+	dh, bs := newTestDefinitionHandlers(t)
+	api := testContractAPI()
+	api.Location = fftypes.JSONAnyPtr(`{"address":"same"}`)
+	dataBytes, err := json.Marshal(api)
+	assert.NoError(t, err)
+	data := &fftypes.Data{Value: fftypes.JSONAnyPtrBytes(dataBytes)}
+
+	existing := testContractAPI()
+	existing.Namespace = api.Namespace
+	existing.Name = api.Name
+	existing.Location = api.Location
+	mbi := dh.database.(*databasemocks.Plugin)
+	mbi.On("GetContractAPIByName", mock.Anything, api.Namespace, api.Name).Return(existing, nil)
+	mbi.On("UpsertContractAPI", mock.Anything, mock.Anything).Return(database.IDMismatch)
+
+	action, err := dh.HandleDefinitionBroadcast(context.Background(), bs, &fftypes.Message{
+		Header: fftypes.MessageHeader{Tag: fftypes.SystemTagDefineContractAPI},
+	}, fftypes.DataArray{data}, fftypes.NewUUID())
+	assert.Equal(t, ActionReject, action.Action)
+	assert.NoError(t, err)
+}
