+func TestUpsertContractAPIDistinguishesNamespaceAndName(t *testing.T) {
+	s, cleanup := newSQLiteTestProvider(t)
+	defer cleanup()
+	ctx := context.Background()
+
+	makeAPI := func(namespace, name string) *fftypes.ContractAPI {
+		id := fftypes.NewUUID()
+		api := &fftypes.ContractAPI{
+			ID:        id,
+			Namespace: namespace,
+			Name:      name,
+			Interface: &fftypes.FFIReference{ID: fftypes.NewUUID()},
+			Location:  fftypes.JSONAnyPtr(`{"owner":"original"}`),
+			Message:   fftypes.NewUUID(),
+		}
+		for _, event := range []fftypes.ChangeEventType{fftypes.ChangeEventTypeCreated, fftypes.ChangeEventTypeUpdated} {
+			s.callbacks.On("UUIDCollectionNSEvent", database.CollectionContractAPIs, event, namespace, id, mock.Anything).Maybe().Return()
+		}
+		return api
+	}
+
+	// An existing row in the same namespace but with another name must not be updated.
+	namespaceDecoy := makeAPI("pair-ns", "another-name")
+	assert.NoError(t, s.UpsertContractAPI(ctx, namespaceDecoy))
+	namespaceTarget := makeAPI("pair-ns", "new-name")
+	assert.NoError(t, s.UpsertContractAPI(ctx, namespaceTarget))
+	stored, err := s.GetContractAPIByName(ctx, namespaceDecoy.Namespace, namespaceDecoy.Name)
+	assert.NoError(t, err)
+	if assert.NotNil(t, stored) {
+		assert.Equal(t, namespaceDecoy.ID, stored.ID)
+		assert.JSONEq(t, namespaceDecoy.Location.String(), stored.Location.String())
+	}
+	stored, err = s.GetContractAPIByName(ctx, namespaceTarget.Namespace, namespaceTarget.Name)
+	assert.NoError(t, err)
+	if assert.NotNil(t, stored) {
+		assert.Equal(t, namespaceTarget.ID, stored.ID)
+	}
+
+	// An existing row with the same name in another namespace must not be updated.
+	nameDecoy := makeAPI("another-ns", "shared-name")
+	assert.NoError(t, s.UpsertContractAPI(ctx, nameDecoy))
+	nameTarget := makeAPI("target-ns", "shared-name")
+	assert.NoError(t, s.UpsertContractAPI(ctx, nameTarget))
+	stored, err = s.GetContractAPIByName(ctx, nameDecoy.Namespace, nameDecoy.Name)
+	assert.NoError(t, err)
+	if assert.NotNil(t, stored) {
+		assert.Equal(t, nameDecoy.ID, stored.ID)
+		assert.JSONEq(t, nameDecoy.Location.String(), stored.Location.String())
+	}
+	stored, err = s.GetContractAPIByName(ctx, nameTarget.Namespace, nameTarget.Name)
+	assert.NoError(t, err)
+	if assert.NotNil(t, stored) {
+		assert.Equal(t, nameTarget.ID, stored.ID)
+	}
+}
