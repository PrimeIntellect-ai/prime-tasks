+def _props_sql(self: Generator, expressions: t.List[exp.Expression]) -> str:
+    props = []
+    size = len(expressions)
+
+    for i, prop in enumerate(expressions):
+        sql = self.indent(f"{prop.name} {self.sql(prop, 'value')}")
