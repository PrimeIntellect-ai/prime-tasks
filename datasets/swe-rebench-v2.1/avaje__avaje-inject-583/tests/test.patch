@@ -0,0 +1,23 @@
+package org.example.myapp.other;
+
+import io.avaje.inject.Bean;
+import io.avaje.inject.Factory;
+import jakarta.inject.Named;
+
+import java.util.Map;
+
+@Factory
+class ConfigFactory {
+
+  @Bean
+  @Named("map1")
+  Map<String, Long> map1() {
+    return Map.of("one", 1L, "two", 2L);
+  }
+
+  @Bean
+  @Named("map2")
+  Map<String, String> map2(Map<String, Long> map1) {
+    return Map.of("a","hi", "b", "there", "count", String.valueOf(map1.size()));
+  }
+}
diff --git a/blackbox-test-inject/src/test/java/org/example/myapp/other/ConfigFactoryTest.java b/blackbox-test-inject/src/test/java/org/example/myapp/other/ConfigFactoryTest.java
new file mode 100644
index 00000000..5f0f3d85
--- /dev/null
+++ b/blackbox-test-inject/src/test/java/org/example/myapp/other/ConfigFactoryTest.java
@@ -0,0 +1,39 @@
+package org.example.myapp.other;
+
+import io.avaje.inject.BeanScope;
+import io.avaje.inject.spi.GenericType;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Type;
+import java.util.Map;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class ConfigFactoryTest {
+
+  final Type TYPE_MapStringString = new GenericType<Map<String, String>>(){}.type();
+  final Type TYPE_MapStringLong = new GenericType<Map<String, Long>>(){}.type();
+
+  @SuppressWarnings("unchecked")
+  @Test
+  void factoryMapsAreRetrievableByTheirFullGenericTypes() {
+    try (BeanScope beanScope = BeanScope.builder().build()) {
+      var map1 = (Map<String, Long>) beanScope.get(TYPE_MapStringLong);
+      var map2 = (Map<String, String>) beanScope.get(TYPE_MapStringString);
+
+      assertThat(map1).containsEntry("one", 1L).containsEntry("two", 2L);
+      assertThat(map2).containsEntry("a", "hi").containsEntry("b", "there");
+    }
+  }
+
+  @SuppressWarnings("unchecked")
+  @Test
+  void factoryMethodReceivesTheMapWithTheMatchingGenericType() {
+    try (BeanScope beanScope = BeanScope.builder().build()) {
+      var map1 = (Map<String, Long>) beanScope.get(TYPE_MapStringLong);
+      var map2 = (Map<String, String>) beanScope.get(TYPE_MapStringString);
+
+      assertThat(map2).containsEntry("count", String.valueOf(map1.size()));
+    }
+  }
+}
