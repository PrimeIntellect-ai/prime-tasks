diff --git a/tests/BackgroundColorTest.php b/tests/BackgroundColorTest.php
new file mode 100644
index 0000000..d7670fe
--- /dev/null
+++ b/tests/BackgroundColorTest.php
@@ -0,0 +1,52 @@
+<?php
+namespace nadar\quill\tests;
+
+use nadar\quill\Lexer;
+use nadar\quill\listener\BackgroundColor;
+
+class BackgroundColorTest extends DeltaTestCase
+{
+    public $json = <<<'JSON'
+{
+  "ops": [
+    {
+      "attributes": {
+        "background": "#000000"
+      },
+      "insert": "xyz"
+    },
+    {
+      "insert": "\n"
+    },
+    {
+      "attributes": {
+        "background": "#fff"
+      },
+      "insert": "xyz"
+    },
+    {
+      "insert": "\n"
+    }
+  ]
+}
+JSON;
+
+    public function testOutput()
+    {
+        $html = $this->getLexer()->render();
+
+        $this->assertRegExp('~<span style="[^"]*background-color\s*:\s*#000000[^"]*">xyz</span>~', $html);
+        $this->assertRegExp('~<span style="[^"]*background-color\s*:\s*#fff[^"]*">xyz</span>~', $html);
+    }
+
+    public function testIgnoreKeepsOriginalHtml()
+    {
+        $lexer = new Lexer($this->json);
+
+        $backgroundColor = new BackgroundColor();
+        $backgroundColor->ignore = true;
+        $lexer->registerListener($backgroundColor);
+
+        $this->assertSame('<p>xyz</p><p>xyz</p>', str_replace(PHP_EOL, '', trim($lexer->render())));
+    }
+}
