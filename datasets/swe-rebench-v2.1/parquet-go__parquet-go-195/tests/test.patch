+type recordedReadRange struct {
+	offset int64
+	length int
+}
+
+type recordingReaderAt struct {
+	reader io.ReaderAt
+	ranges []recordedReadRange
+}
+
+func (r *recordingReaderAt) ReadAt(p []byte, off int64) (int, error) {
+	r.ranges = append(r.ranges, recordedReadRange{offset: off, length: len(p)})
+	return r.reader.ReadAt(p, off)
+}
+
+func TestOpenFileOptimisticReadControlsFooterRead(t *testing.T) {
+	const path = "testdata/nested_structs.rust.parquet"
+	readFooterRange := func(options ...parquet.FileOption) int {
+		t.Helper()
+
+		f, err := os.Open(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer f.Close()
+
+		info, err := f.Stat()
+		if err != nil {
+			t.Fatal(err)
+		}
+		r := &recordingReaderAt{reader: f}
+		options = append(options, parquet.SkipPageIndex(true), parquet.SkipBloomFilters(true))
+		if _, err := parquet.OpenFile(r, info.Size(), options...); err != nil {
+			t.Fatal(err)
+		}
+
+		var footerRangeLength int
+		for _, read := range r.ranges {
+			if read.offset+int64(read.length) == info.Size() && read.length > footerRangeLength {
+				footerRangeLength = read.length
+			}
+		}
+		if footerRangeLength == 0 {
+			t.Fatal("no read reached the end of the file")
+		}
+		return footerRangeLength
+	}
+
+	legacyRange := readFooterRange(parquet.OptimisticRead(false))
+	optimisticRange := readFooterRange(parquet.OptimisticRead(true))
+	if optimisticRange <= legacyRange {
+		t.Errorf("enabling optimistic reads should request a larger footer range: disabled=%d enabled=%d", legacyRange, optimisticRange)
+	}
+}
