+describe('existing S3 custom resource handler', () => {
+  it('should preserve the casing of the suffix in the S3 event filter rule', () => {
+    const putBucketNotificationConfiguration = sinon.stub().returns({
+      promise: () => Promise.resolve(),
+    });
+    const getBucketNotificationConfiguration = sinon.stub().returns({
+      promise: () => Promise.resolve({ LambdaFunctionConfigurations: [] }),
+    });
+    const AWS = require('aws-sdk');
+    const s3Stub = sinon.stub(AWS, 'S3').returns({
+      getBucketNotificationConfiguration,
+      putBucketNotificationConfiguration,
+    });
+    const { handler } = proxyquire('./s3/handler', {
+      './lib/permissions': { addPermission: () => Promise.resolve() },
+    });
+    const request = { on: sinon.stub(), write: sinon.stub(), end: sinon.stub() };
+    const requestStub = sinon.stub(https, 'request').callsFake((options, callback) => {
+      callback({ statusCode: 200, headers: {} });
+      return request;
+    });
+
+    const event = {
+      RequestType: 'Create',
+      ResponseURL: 'https://cloudformation.example/response',
+      ResourceProperties: {
+        FunctionName: 'my-function',
+        BucketName: 'my-bucket',
+        BucketConfig: { Event: 's3:ObjectCreated:*', Rules: [{ suffix: '.TXT' }] },
+      },
+    };
+    const context = {
+      invokedFunctionArn: 'arn:aws:lambda:us-east-1:123456:function:custom-resource',
+      logStreamName: 'test-log-stream',
+    };
+
+    return new Promise((resolve, reject) => {
+      handler(event, context, error => {
+        if (error) reject(error);
+        else resolve();
+      });
+    })
+      .then(() => {
+        const payload = putBucketNotificationConfiguration.args[0][0];
+        const configuration = payload.NotificationConfiguration.LambdaFunctionConfigurations[0];
+        const filterRules = configuration.Filter.Key.FilterRules;
+
+        expect(filterRules.some(rule => rule.Value === '.TXT')).to.equal(true);
+      })
+      .finally(() => {
+        requestStub.restore();
+        s3Stub.restore();
+      });
+  });
+});
