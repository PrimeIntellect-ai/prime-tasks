@@ -0,0 +1,135 @@
+const RuleTester = require('eslint').RuleTester;
+const { Linter } = require('eslint');
+const rule = require('../../../lib/rules/no-settled-after-test-helper');
+const plugin = require('../../../lib');
+
+const ruleTester = new RuleTester({
+  parser: require.resolve('babel-eslint'),
+  parserOptions: {
+    ecmaVersion: 2015,
+    sourceType: 'module',
+  },
+});
+
+ruleTester.run('no-settled-after-test-helper', rule, {
+  valid: [
+    `
+      import { waitFor, settled } from '@ember/test-helpers';
+
+      async () => {
+        await waitFor('.foo');
+        await settled();
+      }
+    `,
+    `
+      import { waitFor, settled } from '@ember/test-helpers';
+
+      async () => {
+        await waitFor('.foo');
+        await settled;
+      }
+    `,
+    `
+      import { settled } from '@ember/test-helpers';
+
+      async () => {
+        await settled();
+      }
+    `,
+    `
+      import { settled } from '@ember/test-helpers';
+
+      async () => {
+        this.set('foo', 42);
+        await settled();
+      }
+    `,
+    `
+      import { settled } from '@ember/test-helpers';
+
+      async () => {
+        let promise = waitFor('.foo');
+        await promise;
+        await settled();
+      }
+    `,
+    `
+      import { settled } from '@ember/test-helpers';
+
+      function click() {}
+
+      async () => {
+        await click('.foo');
+        await settled();
+      }
+    `,
+  ],
+  invalid: [],
+});
+
+describe('no-settled-after-test-helper', () => {
+  it('is available through the plugin rules export', () => {
+    expect(plugin.rules).toHaveProperty('no-settled-after-test-helper');
+  });
+
+  const linter = new Linter();
+  linter.defineRule('no-settled-after-test-helper', rule);
+  linter.defineParser('babel-eslint', require('babel-eslint'));
+
+  const config = {
+    parser: 'babel-eslint',
+    parserOptions: {
+      ecmaVersion: 2015,
+      sourceType: 'module',
+    },
+    rules: {
+      'no-settled-after-test-helper': 'error',
+    },
+  };
+
+  function lint(code) {
+    return linter.verify(code, config);
+  }
+
+  it('reports `await settled()` directly after `await click(...)`', () => {
+    const messages = lint(`
+      import { click, settled } from '@ember/test-helpers';
+
+      async () => {
+        await click('.foo');
+        await settled();
+      }
+    `);
+
+    expect(messages).toHaveLength(1);
+    expect(messages[0].ruleId).toBe('no-settled-after-test-helper');
+  });
+
+  it('reports `await settled()` directly after `await fillIn(...)`', () => {
+    const messages = lint(`
+      import { fillIn, settled } from '@ember/test-helpers';
+
+      async () => {
+        await fillIn('.foo');
+        await settled();
+      }
+    `);
+
+    expect(messages).toHaveLength(1);
+    expect(messages[0].ruleId).toBe('no-settled-after-test-helper');
+  });
+
+  it('reports `await settled()` directly after an aliased test helper', () => {
+    const messages = lint(`
+      import { click as cliiiick, settled } from '@ember/test-helpers';
+
+      async () => {
+        await cliiiick('.foo');
+        await settled();
+      }
+    `);
+
+    expect(messages).toHaveLength(1);
+    expect(messages[0].ruleId).toBe('no-settled-after-test-helper');
+  });
+});
