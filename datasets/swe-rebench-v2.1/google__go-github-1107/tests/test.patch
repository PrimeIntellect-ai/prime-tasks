+// TestRepositoriesService_GetContents_Symlink verifies that RepositoryContent
+// exposes the target of a symlink that does not point to a normal file.
+func TestRepositoriesService_GetContents_Symlink(t *testing.T) {
+	client, mux, _, teardown := setup()
+	defer teardown()
+	mux.HandleFunc("/repos/o/r/contents/p", func(w http.ResponseWriter, r *http.Request) {
+		testMethod(t, r, "GET")
+		fmt.Fprint(w, `{
+  "type": "symlink",
+  "target": "some/dir",
+  "name": "link",
+  "path": "link"
+}`)
+	})
+	fileContents, _, _, err := client.Repositories.GetContents(context.Background(), "o", "r", "p", &RepositoryContentGetOptions{})
+	if err != nil {
+		t.Fatalf("Repositories.GetContents returned error: %v", err)
+	}
+	if got, want := fileContents.GetType(), "symlink"; got != want {
+		t.Fatalf("RepositoryContent.Type = %q, want %q", got, want)
+	}
+
+	// The Target field must be exposed for symlinks. Reflection is used so the
+	// test compiles even when the field is absent, and fails with a clear
+	// behavioural message in that case.
+	target := reflect.ValueOf(fileContents).Elem().FieldByName("Target")
+	if !target.IsValid() {
+		t.Fatalf("RepositoryContent is missing the Target field required for symlinks")
+	}
+	var got string
+	switch target.Kind() {
+	case reflect.Ptr:
+		if target.IsNil() {
+			t.Fatalf("RepositoryContent.Target is nil for a symlink, want %q", "some/dir")
+		}
+		got = target.Elem().String()
+	case reflect.String:
+		got = target.String()
+	default:
+		t.Fatalf("RepositoryContent.Target has unexpected kind %v", target.Kind())
+	}
+	if want := "some/dir"; got != want {
+		t.Errorf("RepositoryContent.Target = %q, want %q", got, want)
+	}
+}
