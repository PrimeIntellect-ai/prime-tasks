+    def test_xx_minus_yy_definition(self):
+        """Test XX-YY gate decomposition."""
+        theta, beta = np.random.uniform(-10, 10, size=2)
+        gate = XXMinusYYGate(theta, beta)
+        circuit = QuantumCircuit(2)
+        circuit.append(gate, [0, 1])
+        decomposed_circuit = circuit.decompose()
+        self.assertTrue(len(decomposed_circuit) > len(circuit))
+        operations = decomposed_circuit.data
+        uses_xy_conversion_rotations = any(
+            operations[index][0].name == "x"
+            and operations[index + 1][0].name == "xx_plus_yy"
+            and operations[index + 2][0].name == "x"
+            and operations[index][1] == operations[index + 2][1]
+            for index in range(len(operations) - 2)
+        )
+        self.assertFalse(uses_xy_conversion_rotations)
+        self.assertTrue(Operator(circuit).equiv(Operator(decomposed_circuit), atol=1e-7))
