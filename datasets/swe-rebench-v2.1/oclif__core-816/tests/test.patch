+
+describe('package initialization without access', () => {
+  it('loads the root package and its plugin when access fails', async () => {
+    const sandbox = createSandbox()
+    const directory = await fs.promises.mkdtemp(join(tmpdir(), 'oclif-pkg-'))
+    const root = join(directory, 'cli')
+    const plugin = join(root, 'plugins', 'fixture-plugin')
+    try {
+      await fs.promises.mkdir(join(root, 'commands'), {recursive: true})
+      await fs.promises.mkdir(join(plugin, 'commands'), {recursive: true})
+      const manifest = JSON.stringify({version: '1.0.0', commands: {}})
+      await fs.promises.writeFile(
+        join(root, 'package.json'),
+        JSON.stringify({
+          name: 'fixture-cli',
+          version: '1.0.0',
+          files: [],
+          oclif: {commands: './commands', plugins: [{name: 'fixture-plugin', root: plugin}]},
+        }),
+      )
+      await fs.promises.writeFile(join(root, 'oclif.manifest.json'), manifest)
+      await fs.promises.writeFile(
+        join(plugin, 'package.json'),
+        JSON.stringify({name: 'fixture-plugin', version: '1.0.0', files: [], oclif: {commands: './commands'}}),
+      )
+      await fs.promises.writeFile(join(plugin, 'oclif.manifest.json'), manifest)
+
+      const packageFiles = new Set([join(root, 'package.json'), join(plugin, 'package.json')])
+      const access = fs.promises.access
+      sandbox.stub(fs.promises, 'access').callsFake(async (path) => {
+        if (packageFiles.has(String(path))) throw Object.assign(new Error('not accessible'), {code: 'ENOENT'})
+        return access(path)
+      })
+      const config = await Config.load({root, devPlugins: false})
+
+      expect(config.getPluginsList().map((loaded) => loaded.name)).to.include.members(['fixture-cli', 'fixture-plugin'])
+    } finally {
+      sandbox.restore()
+      await fs.promises.rm(directory, {force: true, recursive: true})
+    }
+  })
+})
