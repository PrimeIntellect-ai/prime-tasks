+def test_dataloader_sparse():
+    adj_t = torch.sparse_coo_tensor(
+        indices=torch.tensor([[0, 1, 1, 2], [1, 0, 0, 1]]),
+        values=torch.tensor([1.0, 2.0, 3.0, 4.0]),
+        size=(3, 3),
+    )
+    assert not adj_t.is_coalesced()
+
+    data = Data(adj_t=adj_t)
+    loader = DataLoader([data, data], batch_size=2)
+    for batch in loader:
+        assert batch.adj_t.size() == (6, 6)
+        assert batch.adj_t._nnz() == 8
+
