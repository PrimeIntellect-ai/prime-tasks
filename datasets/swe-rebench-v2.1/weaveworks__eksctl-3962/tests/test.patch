 var _ = Describe("create nodegroup", func() {
@@ -170,6 +181,62 @@ var _ = Describe("create nodegroup", func() {
 				error: unsupportedWindowsError,
 			}),
 		)
+		It("inherits the control plane version when --version is omitted", func() {
+			cmd := newMockEmptyCmd("nodegroup", "--managed", "--cluster", "clusterName")
+			controlPlaneVersion := "1.19"
+			cmdutils.AddResourceCmd(cmdutils.NewGrouping(), cmd.parentCmd, func(cmd *cmdutils.Cmd) {
+				createNodeGroupCmdWithRunFunc(cmd, func(cmd *cmdutils.Cmd, ng *api.NodeGroup, options nodegroupOptions) error {
+					loader := cmdutils.NewCreateNodeGroupLoader(cmd, ng, filter.NewNodeGroupFilter(), options.CreateNGOptions, options.CreateManagedNGOptions)
+					if err := loader.Load(); err != nil {
+						return err
+					}
+					cmd.ClusterConfig.Metadata.Region = "us-west-2"
+					cmd.ClusterConfig.Status = &api.ClusterStatus{Endpoint: "https://localhost/", CertificateAuthorityData: []byte("dGVzdAo=")}
+					cluster := testutils.NewFakeCluster("clusterName", "ACTIVE")
+					cluster.Version = aws.String(controlPlaneVersion)
+					provider := mockprovider.NewMockProvider()
+					ctl := &eks.ClusterProvider{
+						Provider: provider,
+						Status:   &eks.ProviderStatus{ClusterInfo: &eks.ClusterInfo{Cluster: cluster}},
+					}
+					manager := actionnodegroup.New(cmd.ClusterConfig, ctl, nil)
+					func() {
+						defer func() { _ = recover() }()
+						_ = manager.Create(actionnodegroup.CreateOpts{DryRun: true}, filter.NewNodeGroupFilter())
+					}()
+					managedNG := cmd.ClusterConfig.ManagedNodeGroups[0]
+					stack := builder.NewManagedNodeGroup(provider.EC2(), cmd.ClusterConfig, managedNG, nil,
+						nodebootstrap.NewManagedBootstrapper(cmd.ClusterConfig, managedNG), false, new(vpcfakes.FakeImporter))
+					if err := stack.AddAllResources(); err != nil {
+						return err
+					}
+					rawTemplate, err := stack.RenderJSON()
+					if err != nil {
+						return err
+					}
+					template, err := goformation.ParseJSON(rawTemplate)
+					if err != nil {
+						return err
+					}
+					resource, ok := template.Resources[builder.ManagedNodeGroupResourceName]
+					Expect(ok).To(BeTrue())
+					managedResource, ok := resource.(*gfneks.Nodegroup)
+					Expect(ok).To(BeTrue())
+					// An omitted EKS nodegroup version defaults to the control plane version;
+					// an explicitly supplied version must match it.
+					Expect(managedResource.Version == nil || managedResource.Version.String() == controlPlaneVersion).To(BeTrue())
+					return nil
+				})
+			})
+			_, err := cmd.execute()
+			Expect(err).NotTo(HaveOccurred())
+		})
 
+		It("rejects --version for managed nodegroups", func() {
+			cmd := newDefaultCmd("nodegroup", "--managed", "--cluster", "clusterName", "--version", "1.18")
+			_, err := cmd.execute()
+			Expect(err).To(HaveOccurred())
+			Expect(err).To(MatchError(ContainSubstring("--version is only valid with unmanaged nodegroups")))
+		})
 	})
