+// TestExtendedRuleAllowlist runs the extension check in a fresh process: the
+// package-level extension depth counter is shared with other tests in this
+// package, which load extended configurations of their own.
+func TestExtendedRuleAllowlist(t *testing.T) {
+	cmd := exec.Command(os.Args[0], "-test.run=^TestExtendedRuleAllowlistWorker$")
+	cmd.Env = append(os.Environ(), "GITLEAKS_EXTENSION_WORKER=1")
+	output, err := cmd.CombinedOutput()
+	require.NoError(t, err, string(output))
+}
+
+func TestExtendedRuleAllowlistWorker(t *testing.T) {
+	if os.Getenv("GITLEAKS_EXTENSION_WORKER") != "1" {
+		return
+	}
+	t.Cleanup(viper.Reset)
+
+	extendPath, err := filepath.Abs(filepath.Join(configPath, "extend_3.toml"))
+	require.NoError(t, err)
+
+	// The local configuration lives in a temporary directory so that it does
+	// not collide with fixtures of the same name.
+	localPath := filepath.Join(t.TempDir(), "local.toml")
+	local := fmt.Sprintf(`title = "local extension"
+
+[extend]
+path = %q
+
+[[rules]]
+id = "aws-secret-key-again-again"
+[rules.allowlist]
+commits = ['''abcdefg1''']
+regexes = ['''foo.+bar''']
+paths = ['''ignore\.xaml''']
+stopwords = ['''example''']
+`, extendPath)
+	require.NoError(t, os.WriteFile(localPath, []byte(local), 0o600))
+
+	viper.SetConfigFile(localPath)
+	viper.SetConfigType("toml")
+	require.NoError(t, viper.ReadInConfig())
+	var vc ViperConfig
+	require.NoError(t, viper.Unmarshal(&vc))
+	cfg, err := vc.Translate()
+	require.NoError(t, err)
+
+	pattern := func(re *regexp.Regexp) string {
+		if re == nil {
+			return ""
+		}
+		return re.String()
+	}
+	patterns := func(res []*regexp.Regexp) []string {
+		out := make([]string, 0, len(res))
+		for _, re := range res {
+			out = append(out, pattern(re))
+		}
+		return out
+	}
+
+	rule, ok := cfg.Rules["aws-secret-key-again-again"]
+	require.True(t, ok)
+	assert.Equal(t, `(?i)aws_(.{0,20})?=?.[\'\"0-9a-zA-Z\/+]{40}`, pattern(rule.Regex))
+	assert.ElementsMatch(t, []string{"abcdefg1", "inherited-commit"}, rule.Allowlist.Commits)
+	assert.ElementsMatch(t, []string{"foo.+bar", `inherited.+regex`}, patterns(rule.Allowlist.Regexes))
+	assert.ElementsMatch(t, []string{`ignore\.xaml`, `inherited\.xaml`}, patterns(rule.Allowlist.Paths))
+	assert.ElementsMatch(t, []string{"example", "inherited-word"}, rule.Allowlist.StopWords)
+}
