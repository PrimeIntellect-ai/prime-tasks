+/// Asserts that a label containing newlines is rendered as readable,
+/// indented lines rather than being emitted verbatim (which would break
+/// the surrounding layout).
+fn assert_multiline_label(out: &str, label: &str) {
+    let lines: Vec<&str> = label.split('\n').collect();
+    assert!(lines.len() > 1, "expected a multi-line label");
+    // The label must not be dumped verbatim with its embedded newlines.
+    assert!(
+        !out.contains(label),
+        "multi-line label was not reformatted:\n{}",
+        out
+    );
+    // Each segment must occur on a distinct, indented output row. Do not
+    // constrain what formatting may follow the label text on that row.
+    let mut rendered_rows = Vec::new();
+    for line in &lines {
+        let (row_number, rendered) = out
+            .lines()
+            .enumerate()
+            .find(|(_, rendered)| rendered.contains(line))
+            .unwrap_or_else(|| panic!("label line {:?} missing from output:\n{}", line, out));
+        assert!(
+            !rendered_rows.contains(&row_number),
+            "label segments were not rendered on separate rows:\n{}",
+            out
+        );
+        rendered_rows.push(row_number);
+        let prefix = rendered.split_once(line).unwrap().0;
+        assert!(
+            !prefix.is_empty(),
+            "label line {:?} is not indented: {:?}",
+            line,
+            rendered
+        );
+    }
+}
