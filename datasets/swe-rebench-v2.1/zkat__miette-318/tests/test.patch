+#[test]
+fn multiple_multi_line_labels() -> Result<(), MietteError> {
+    #[derive(Debug, Diagnostic, Error)]
+    #[error("oops!")]
+    #[diagnostic(code(oops::my::bad), help("try doing it better next time?"))]
+    struct MyBad {
+        #[source_code]
+        src: NamedSource,
+        #[label = "first-label-line\nfirst-label-continuation"]
+        highlight1: SourceSpan,
+        #[label = "second-label-line\nsecond-label-continuation"]
+        highlight2: SourceSpan,
+        #[label = "third-label-line\nthird-label-continuation"]
+        highlight3: SourceSpan,
+    }
+
+    let src = "source\n  text text text text text\n    here".to_string();
+    let err = MyBad {
+        src: NamedSource::new("bad_file.rs", src),
+        highlight1: (9, 4).into(),
+        highlight2: (14, 4).into(),
+        highlight3: (24, 4).into(),
+    };
+    let out = fmt_report(err.into());
+    println!("Error: {}", out);
+    assert_multiline_label(&out, "first-label-line\nfirst-label-continuation");
+    assert_multiline_label(&out, "second-label-line\nsecond-label-continuation");
+    assert_multiline_label(&out, "third-label-line\nthird-label-continuation");
+    Ok(())
+}
