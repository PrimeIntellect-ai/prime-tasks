+    @mock_athena
+    def test_catalog_generation_for_federated_query_catalog(self, mock_aws_service):
+        mock_aws_service.create_data_catalog(
+            catalog_name=FEDERATED_QUERY_CATALOG_NAME, catalog_type="LAMBDA"
+        )
+
+        # Moto does not support Athena metadata APIs for federated catalogs, so the
+        # table metadata is served by a patched API call. Both Athena metadata
+        # operations return the same table description.
+        orig = botocore.client.BaseClient._make_api_call
+        table_metadata = {
+            "Name": "bar",
+            "TableType": "EXTERNAL_TABLE",
+            "Columns": [
+                {"Name": "id", "Type": "string"},
+                {"Name": "country", "Type": "string"},
+            ],
+            "PartitionKeys": [{"Name": "dt", "Type": "date"}],
+        }
+
+        def mock_athena_list_table_metadata(client, operation_name, kwargs):
+            if operation_name == "ListTableMetadata":
+                return {"TableMetadataList": [table_metadata]}
+            if operation_name == "GetTableMetadata":
+                return {"TableMetadata": table_metadata}
+            return orig(client, operation_name, kwargs)
+
+        manifest = mock.MagicMock()
+        manifest.nodes = {"model.root.model5": self.mock_manifest.nodes["model.root.model5"]}
+        manifest.sources = {}
+        manifest.get_used_schemas.return_value = {(FEDERATED_QUERY_CATALOG_NAME, "foo")}
+
+        with patch("botocore.client.BaseClient._make_api_call", new=mock_athena_list_table_metadata):
+            actual, errors = self.adapter.get_catalog(manifest)
+
+        assert not errors
+        rows = [dict(zip(actual.column_names, row.values())) for row in actual.rows.values()]
+        discovered_metadata = {
+            (
+                row["table_database"],
+                row["table_schema"],
+                row["table_name"],
+                row["column_name"],
+                row["column_type"],
+            )
+            for row in rows
+        }
+        assert discovered_metadata == {
+            (FEDERATED_QUERY_CATALOG_NAME, "foo", "bar", "id", "string"),
+            (FEDERATED_QUERY_CATALOG_NAME, "foo", "bar", "country", "string"),
+            (FEDERATED_QUERY_CATALOG_NAME, "foo", "bar", "dt", "date"),
+        }
 
     @mock_athena
     @mock_sts
