+def test_reachability_renders_source_optional(device: AntaDevice) -> None:
+    """Verify the ping command omits the source when not provided and includes it when provided."""
+    test_instance = VerifyReachability(device, inputs={"hosts": [{"destination": "10.0.0.1"}, {"destination": "10.0.0.2", "source": "10.0.0.5"}]})
+    commands = [command.command for command in test_instance.instance_commands]
+    assert len(commands) == 2
+    assert "source" not in commands[0]
+    assert "source" in commands[1]
+    assert "10.0.0.5" in commands[1]
+
+
+def test_reachability_rejects_mismatched_source_family(device: AntaDevice) -> None:
+    """Verify a supplied source whose IP family differs from the destination is rejected."""
+    test_instance = VerifyReachability(device, inputs={"hosts": [{"destination": "10.0.0.1", "source": "fd12:3456:789a:1::1"}]})
+    assert test_instance.result.result == "error"
