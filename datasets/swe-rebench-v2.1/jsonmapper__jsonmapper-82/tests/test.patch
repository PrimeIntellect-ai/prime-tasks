@@ -6,10 +6,12 @@ namespace JsonMapper\Tests\Unit\Middleware;
 
 use JsonMapper\Builders\PropertyBuilder;
 use JsonMapper\Enums\Visibility;
+use JsonMapper\JsonMapperBuilder;
 use JsonMapper\JsonMapperInterface;
 use JsonMapper\Middleware\NamespaceResolver;
 use JsonMapper\Tests\Helpers\AssertThatPropertyTrait;
 use JsonMapper\Tests\Implementation\ComplexObject;
+use JsonMapper\Tests\Implementation\JsonMapper as TestJsonMapper;
 use JsonMapper\Tests\Implementation\Models\User;
 use JsonMapper\Tests\Implementation\SimpleObject;
 use JsonMapper\ValueObjects\PropertyMap;
@@ -163,4 +165,98 @@ class NamespaceResolverTest extends TestCase
         $this->assertThatProperty($propertyMap->getProperty('child'))
             ->hasType(SimpleObject::class . '[]', false);
     }
+
+    /**
+     * @covers \JsonMapper\Middleware\NamespaceResolver
+     * @covers \JsonMapper\JsonMapperBuilder
+     */
+    public function testRepeatedMappingReusesImportsAndPreservesResolvedTypes(): void
+    {
+        self::assertTrue(stream_wrapper_register('namespace-cache-probe', NamespaceResolverImportCountingStream::class));
+        try {
+            NamespaceResolverImportCountingStream::$contents = <<<'PHP'
+<?php
+namespace JsonMapper\Tests\Unit\Middleware;
+use JsonMapper\Tests\Implementation\Models\User;
+class NamespaceResolverCacheProbe
+{
+    /** @var User */
+    public $user;
+}
+PHP;
+            include 'namespace-cache-probe://fixture.php';
+            NamespaceResolverImportCountingStream::$readCount = 0;
+
+            $mapper = JsonMapperBuilder::new()
+                ->withJsonMapperClassName(TestJsonMapper::class)
+                ->withDocBlockAnnotationsMiddleware()
+                ->withNamespaceResolverMiddleware()
+                ->build();
+            $object = new NamespaceResolverCacheProbe();
+
+            $mapper->mapObjectFromString('{"user":{}}', $object);
+            self::assertInstanceOf(User::class, $object->user);
+            $readsAfterFirstMapping = NamespaceResolverImportCountingStream::$readCount;
+
+            $mapper->mapObjectFromString('{"user":{}}', $object);
+            self::assertInstanceOf(User::class, $object->user);
+            self::assertSame($readsAfterFirstMapping, NamespaceResolverImportCountingStream::$readCount);
+        } finally {
+            stream_wrapper_unregister('namespace-cache-probe');
+        }
+    }
+
+}
+
+/** @internal Test stream that makes source-file reads observable. */
+class NamespaceResolverImportCountingStream
+{
+    public static $contents = '';
+    public static $readCount = 0;
+    public $context;
+    private $position = 0;
+
+    public function stream_open(string $path, string $mode, int $options, ?string &$openedPath): bool
+    {
+        $this->position = 0;
+        return true;
+    }
+
+    public function stream_read(int $count): string
+    {
+        $data = substr(self::$contents, $this->position, $count);
+        $this->position += strlen($data);
+        ++self::$readCount;
+        return $data;
+    }
+
+    public function stream_eof(): bool
+    {
+        return $this->position >= strlen(self::$contents);
+    }
+
+    public function stream_stat(): array
+    {
+        return $this->statData();
+    }
+
+    public function url_stat(string $path, int $flags): array
+    {
+        return $this->statData();
+    }
+
+    public function stream_set_option(int $option, int $arg1, int $arg2): bool
+    {
+        return false;
+    }
+
+    private function statData(): array
+    {
+        $stat = array_fill(0, 13, 0);
+        $stat[2] = 0100444;
+        $stat[7] = strlen(self::$contents);
+        $stat['mode'] = 0100444;
+        $stat['size'] = strlen(self::$contents);
+        return $stat;
+    }
 }
