+
+
+def test_dynamic_array_does_not_overlap_following_variable(get_contract):
+    code = """
+arr: DynArray[uint256[2], 3]
+interfere: uint256
+
+@external
+def run() -> uint256:
+    self.arr.append([1, 2])
+    self.arr.append([3, 4])
+    self.arr.append([5, 6])
+    self.interfere = 7
+    return self.arr[2][1]
+
+@external
+def get_arr(i: uint256, j: uint256) -> uint256:
+    return self.arr[i][j]
+
+@external
+def get_len() -> uint256:
+    return len(self.arr)
+
+@external
+def get_interfere() -> uint256:
+    return self.interfere
+"""
+    c = get_contract(code)
+
+    # run as a transaction; the following variable must not clobber the array
+    c.run(transact={})
+    assert c.get_len() == 3
+    assert [c.get_arr(i, j) for i in range(3) for j in range(2)] == [1, 2, 3, 4, 5, 6]
+    assert c.get_interfere() == 7
+
+
+def test_dynamic_array_return_value_is_not_clobbered(get_contract):
+    code = """
+arr: DynArray[uint256[2], 3]
+interfere: uint256
+
+@external
+def run() -> uint256:
+    self.arr.append([1, 2])
+    self.arr.append([3, 4])
+    self.arr.append([5, 6])
+    self.interfere = 7
+    return self.arr[2][1]
+"""
+    c = get_contract(code)
+
+    # the reported execution, called rather than transacted, returns 6
+    assert c.run() == 6
