+
+def test_empty_scalar_reduction_select(constructor: Constructor) -> None:
+    data = {"int": [0, 1, 2, 3, 4]}
+    df = nw.from_native(constructor(data)).filter(nw.col("int") > 10)
+
+    result = df.select(
+        max=nw.col("int").max(),
+        mean=nw.col("int").mean(),
+        min=nw.col("int").min(),
+    )
+    assert_equal_data(result, {"max": [None], "mean": [None], "min": [None]})
+
+
+def test_empty_scalar_reduction_with_columns() -> None:
+    data = pd.DataFrame({"name": ["John", "Doe", "Jane"]})
+    df = nw.from_native(data).filter(nw.col("name") == "Boo")
+
+    result = df.with_columns(nw.col("name").sum())
+    assert_equal_data(result, {"name": []})
+
+
+def test_empty_scalar_reduction_series(constructor_eager: ConstructorEager) -> None:
+    data = {"int": [0, 1, 2, 3, 4]}
+    df = nw.from_native(constructor_eager(data), eager_only=True).filter(
+        nw.col("int") > 10
+    )
+    result = {
+        "max": [df["int"].max()],
+        "mean": [df["int"].mean()],
+        "min": [df["int"].min()],
+    }
+    assert_equal_data(result, {"max": [None], "mean": [None], "min": [None]})
