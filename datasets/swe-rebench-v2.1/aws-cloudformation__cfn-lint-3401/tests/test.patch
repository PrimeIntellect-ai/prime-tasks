+"""
+Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+SPDX-License-Identifier: MIT-0
+"""
+
+import pytest
+
+from cfnlint.api import lint
+
+JOIN_CIDR_TEMPLATE = """
+Parameters:
+  additionalSubnetBits:
+    Type: Number
+  additionalVpcCidr:
+    Type: String
+Resources:
+  Bucket:
+    Type: AWS::S3::Bucket
+    Properties:
+      BucketName: !Join ['-', !Cidr [!Ref additionalVpcCidr, 4, !Ref additionalSubnetBits]]
+"""
+
+INVALID_JOIN_TEMPLATE = """
+Resources:
+  Bucket:
+    Type: AWS::S3::Bucket
+    Properties:
+      BucketName: !Join ['-', 'foo']
+"""
+
+
+def _errors(matches):
+    return [match for match in matches if match.rule.id.startswith("E")]
+
+
+def test_join_accepts_cidr():
+    errors = _errors(lint(JOIN_CIDR_TEMPLATE))
+    assert errors == [], f"got {errors!r}"
+
+
+def test_join_still_rejects_non_list():
+    errors = _errors(lint(INVALID_JOIN_TEMPLATE))
+    assert errors, "non-list Fn::Join argument was not reported"
