--- a/test_isort.py
+++ b/test_isort.py
@@ -1796,3 +1796,39 @@ def test_plone_style():
     options = {'force_single_line': True,
                'force_alphabetical_sort': True}
     assert SortImports(file_contents=test_input, **options).output == test_input
+
+
+def test_third_party_case_sensitive():
+    """A differently cased import must not inherit a standard-library classification."""
+    test_input = ("import thirdparty\n"
+                  "import os\n"
+                  "import ABC\n")
+
+    output = SortImports(file_contents=test_input).output
+    sections = [set(section.splitlines()) for section in output.strip().split('\n\n')]
+    assert not any({'import os', 'import ABC'} <= section for section in sections)
+
+
+def test_standard_library_modules_in_nonstandard_location(tmpdir, monkeypatch):
+    """Standard-library modules remain standard-library imports outside versioned paths."""
+    import sys
+    import sysconfig
+
+    runtime = tmpdir.mkdir('custom-runtime')
+    library = runtime.mkdir('lib')
+    library.join('ftplib.py').write('')
+    library.join('numbers.py').write('')
+    monkeypatch.setattr(sys, 'prefix', str(runtime))
+    monkeypatch.syspath_prepend(str(library))
+    original_get_paths = sysconfig.get_paths
+    monkeypatch.setattr(sysconfig, 'get_paths',
+                        lambda: dict(original_get_paths(), stdlib=str(library)))
+
+    test_input = ('import numbers\n'
+                  'import colorama\n'
+                  'import ftplib\n'
+                  'import os\n')
+    output = SortImports(file_contents=test_input, known_third_party=['colorama']).output
+    sections = [frozenset(section.splitlines()) for section in output.strip().split('\n\n')]
+    assert set(sections) == {frozenset(('import ftplib', 'import numbers', 'import os')),
+                             frozenset(('import colorama',))}
