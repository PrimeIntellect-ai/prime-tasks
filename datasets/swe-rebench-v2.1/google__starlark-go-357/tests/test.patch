+func TestMathModulePow(t *testing.T) {
+	// A Go client can import the exported module and provide it to Starlark code.
+	const source = `package main
+import (
+    "fmt"
+    "os"
+    starlark "go.starlark.net/starlark"
+    mathlib "go.starlark.net/lib/math"
+    "go.starlark.net/syntax"
+)
+func main() {
+    src, err := os.ReadFile("testdata/math.star")
+    if err != nil { panic(err) }
+    globals, err := starlark.ExecFile(&starlark.Thread{}, "testdata/math.star", src,
+        starlark.StringDict{"math": mathlib.Module})
+    if err != nil { panic(err) }
+    equal, err := starlark.Compare(syntax.EQL, globals["answer"], starlark.True)
+    if err != nil { panic(err) }
+    fmt.Println(equal)
+}`
+	filename := filepath.Join(t.TempDir(), "main.go")
+	if err := os.WriteFile(filename, []byte(source), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("go", "run", filename)
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Errorf("Go math library call failed: %v\n%s", err, out)
+	} else if strings.TrimSpace(string(out)) != "true" {
+		t.Errorf("Go math library call printed %q, want true", out)
+	}
+}
