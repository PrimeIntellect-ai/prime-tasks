     assert seen == {'SampleExpression': 2, 'TemporalSeq': 1}
+
+
+def test_constructing_walker_preserves_cached_dispatch():
+    class Item:
+        pass
+
+    class PW(DepthFirstWalker):
+        def walk_Item(self, item, *args, **kwargs):
+            return 'original'
+
+    first = PW()
+    item = Item()
+    assert first.walk(item) == 'original'
+
+    def replacement(self, item, *args, **kwargs):
+        return 'replacement'
+
+    PW.walk_Item = replacement
+    second = PW()
+    assert first.walk(item) == 'original'
