@@ -0,0 +1,20 @@
+import { QueryClient } from 'react-query'
+import type { Mutation } from 'react-query'
+
+function readStatus(mutation: Mutation<string, unknown, string>): string {
+  return mutation.state.status
+}
+
+describe('Mutation type export', () => {
+  it('is importable from the public entry point and types mutations built by the client', async () => {
+    const queryClient = new QueryClient()
+    const mutation: Mutation<string, unknown, string> = queryClient
+      .getMutationCache()
+      .build(queryClient, {
+        mutationFn: () => Promise.resolve('done'),
+      })
+
+    await expect(mutation.execute()).resolves.toBe('done')
+    expect(readStatus(mutation)).toBe('success')
+  })
+})
