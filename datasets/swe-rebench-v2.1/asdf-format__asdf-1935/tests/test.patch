+import warnings
+
 import pytest
 
 import asdf
@@ -10,3 +12,21 @@ def test_resolver_deprecation():
 
     with pytest.warns(DeprecationWarning, match="resolver is deprecated"):
         asdf.schema.load_schema("http://stsci.edu/schemas/asdf/asdf-schema-1.0.0", resolver=resolver)
+
+
+@pytest.mark.parametrize("value", (True, False))
+def test_deprecate_refresh_extension_manager(value):
+    af = asdf.AsdfFile({"foo": 1})
+
+    for call in (
+        lambda: af.schema_info(refresh_extension_manager=value),
+        lambda: af.info(refresh_extension_manager=value),
+    ):
+        with warnings.catch_warnings(record=True) as recorded:
+            warnings.simplefilter("always")
+            try:
+                call()
+            except TypeError:
+                # Removing the retired option is also a valid way to retire it.
+                continue
+        assert any(issubclass(warning.category, DeprecationWarning) for warning in recorded)
