 public class TS_ExecSPARQL {
+    public static class LateralQueryBehavior {
+
+        @Test public void lateral_without_join() {
+            String query = """
+                SELECT * {
+                    BIND('x' AS ?xIn)
+                    LATERAL {
+                        { SELECT ?xIn ?xOut { BIND(?xIn AS ?xOut) } }
+                    }
+                }
+                """;
+            DatasetGraph dsg = DatasetGraphFactory.empty();
+            RowSet rowSet = QueryExec.dataset(dsg).query(query).select();
+            Binding row = rowSet.next();
+            Node x = row.get("xOut");
+            assertEquals("x", x.getLiteralLexicalForm());
+        }
 
+        @Test public void lateral_with_join() {
+            String query = """
+                SELECT * {
+                    BIND( 'x' AS ?xIn )
+                    LATERAL {
+                        BIND("foo" AS ?foo)
+                        { SELECT ?xIn ?xOut { BIND(?xIn AS ?xOut) } }
+                    }
+                }
+                """;
+            DatasetGraph dsg = DatasetGraphFactory.empty();
+            RowSet rowSet = QueryExec.dataset(dsg).query(query).select();
+            Binding row = rowSet.next();
+            Node x = row.get("xOut");
+            assertEquals("x", x.getLiteralLexicalForm());
+        }
+    }
 }
