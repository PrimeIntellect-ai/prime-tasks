+@pytest.mark.parametrize(
+    "with_packages,",
+    [
+        (),  # no extra packages
+        ("black",),  # duplicate from requirements file
+        ("ipython",),  # additional package
+    ],
+)
+def test_inject_with_req_file(pipx_temp_env, capfd, caplog, tmp_path, with_packages):
+    caplog.set_level(logging.INFO)
+
+    req_file = tmp_path / "inject-requirements.txt"
+    req_file.write_text(
+        textwrap.dedent(
+            f"""
+                {PKG["black"]["spec"]} # a comment inline
+
+                # comment on separate line
+            """
+        ).strip()
+    )
+    second_req_file = tmp_path / "additional-requirements.txt"
+    second_req_file.write_text(
+        textwrap.dedent(
+            f"""
+                {PKG["nox"]["spec"]}
+                {PKG["pylint"]["spec"]}
+            """
+        ).strip()
+    )
+    assert not run_pipx_cli(["install", "pycowsay"])
+
+    assert not run_pipx_cli(
+        [
+            "inject",
+            "pycowsay",
+            *(PKG[pkg]["spec"] for pkg in with_packages),
+            "-r",
+            str(req_file),
+            "--requirement",
+            str(second_req_file),
+        ]
+    )
+
+    packages = [
+        ("black", PKG["black"]["spec"]),
+        ("nox", PKG["nox"]["spec"]),
+        ("pylint", PKG["pylint"]["spec"]),
+    ]
+    packages.extend((pkg, PKG[pkg]["spec"]) for pkg in with_packages)
+    packages = sorted(set(packages))
+
+    # Check arguments and files have been parsed correctly
+    assert f"Injecting packages: {[p for _, p in packages]!r}" in caplog.text
+
+    # Check they're actually installed into the correct venv
+    capfd.readouterr()
+    assert not run_pipx_cli(["runpip", "pycowsay", "freeze"])
+    captured = capfd.readouterr()
+    installed = {re.sub(r"[-_.]+", "-", line.split("==")[0]).lower() for line in captured.out.splitlines()}
+    for pkg, _ in packages:
+        assert re.sub(r"[-_.]+", "-", pkg).lower() in installed
+
+    # Check they're registered individually as injected dependencies
+    assert not run_pipx_cli(["list", "--include-injected"])
+    captured = capfd.readouterr()
+    injected_section = captured.out.split("Injected Packages:")[-1]
+    for pkg, _ in packages:
+        assert f"- {pkg} " in injected_section
+
+
+@pytest.mark.parametrize(
+    "upgrade_args",
+    [
+        ("upgrade", "--include-injected", "pycowsay"),
+        ("upgrade-all", "--include-injected"),
+    ],
+)
+def test_req_file_packages_are_upgraded(pipx_temp_env, capsys, tmp_path, upgrade_args):
+    req_file = tmp_path / "upgrade-requirements.txt"
+    req_file.write_text(PKG["black"]["spec"])
+
+    assert not run_pipx_cli(["install", "pycowsay"])
+    assert not run_pipx_cli(["inject", "pycowsay", "--requirement", str(req_file)])
+
+    assert not run_pipx_cli(list(upgrade_args))
+    assert "upgraded package black" in capsys.readouterr().out
