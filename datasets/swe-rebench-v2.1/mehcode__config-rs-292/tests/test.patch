+#[test]
+fn test_legacy_prefix_delimiter_differs_from_nested_delimiter() {
+    env::set_var("APP_TLS__CERTIFICATE", "abc");
+
+    let environment = Environment::with_prefix("APP")
+        .separator("__")
+        .prefix_separator("_");
+
+    assert!(environment.collect().unwrap().contains_key("tls.certificate"));
+
+    env::remove_var("APP_TLS__CERTIFICATE");
+}
+
+#[test]
+fn test_explicit_prefix_delimiter_overrides_path_delimiter() {
+    env::set_var("C-B.A", "abc");
+
+    let environment = Environment::with_prefix("C")
+        .separator(".")
+        .prefix_separator("-");
+
+    assert!(environment.collect().unwrap().contains_key("b.a"));
+
+    env::remove_var("C-B.A");
+}
