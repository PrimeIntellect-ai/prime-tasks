+// TestForceHTTPSLeavesHTTPSRequestsAlone checks that, with the option enabled,
+// a request that already arrives over HTTPS is not redirected to HTTPS again.
+func TestForceHTTPSLeavesHTTPSRequestsAlone(t *testing.T) {
+	bin := filepath.Join(t.TempDir(), "oauth2_proxy")
+	build := exec.Command("go", "build", "-o", bin, ".")
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("failed to build oauth2_proxy: %v\n%s", err, out)
+	}
+
+	certFile, keyFile := writeSelfSignedCert(t, t.TempDir())
+
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("failed to allocate a port: %v", err)
+	}
+	addr := l.Addr().String()
+	l.Close()
+
+	args := []string{
+		"-https-address=" + addr,
+		"-tls-cert-file=" + certFile,
+		"-tls-key-file=" + keyFile,
+		"-cookie-secret=0123456789abcdef",
+		"-client-id=test",
+		"-client-secret=test",
+		"-email-domain=*",
+		"-force-https",
+	}
+	cmd := exec.Command(bin, args...)
+	var output bytes.Buffer
+	cmd.Stdout = &output
+	cmd.Stderr = &output
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("failed to start oauth2_proxy: %v", err)
+	}
+	defer func() {
+		cmd.Process.Kill()
+		cmd.Wait()
+	}()
+
+	var conn *tls.Conn
+	deadline := time.Now().Add(15 * time.Second)
+	for {
+		conn, err = tls.Dial("tcp", addr, &tls.Config{InsecureSkipVerify: true})
+		if err == nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("proxy did not start serving HTTPS traffic: %v\n%s", err, output.String())
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+	defer conn.Close()
+
+	if _, err := conn.Write([]byte("GET / HTTP/1.1\r\nHost: " + addr + "\r\nConnection: close\r\n\r\n")); err != nil {
+		t.Fatalf("failed to send HTTPS request: %v", err)
+	}
+	res, err := http.ReadResponse(bufio.NewReader(conn), nil)
+	if err != nil {
+		t.Fatalf("failed to read HTTPS response: %v\n%s", err, output.String())
+	}
+	defer res.Body.Close()
+
+	assert.NotEqual(t, http.StatusPermanentRedirect, res.StatusCode, "an HTTPS request should not be redirected to HTTPS again")
+}
