+// TestForceHTTPSProxyTraffic checks the command-line option through the
+// running proxy: enabling it redirects plain HTTP traffic to the configured
+// HTTPS address, while omitting it does not force that redirect.
+func TestForceHTTPSProxyTraffic(t *testing.T) {
+	bin := filepath.Join(t.TempDir(), "oauth2_proxy")
+	build := exec.Command("go", "build", "-o", bin, ".")
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("failed to build oauth2_proxy: %v\n%s", err, out)
+	}
+
+	for _, tc := range []struct {
+		name       string
+		forceHTTPS bool
+	}{
+		{name: "disabled by default"},
+		{name: "enabled", forceHTTPS: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			l, err := net.Listen("tcp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatalf("failed to allocate a port: %v", err)
+			}
+			addr := l.Addr().String()
+			l.Close()
+
+			args := []string{
+				"-http-address=" + addr,
+				"-https-address=https://example.com",
+				"-cookie-secret=0123456789abcdef",
+				"-client-id=test",
+				"-client-secret=test",
+				"-email-domain=*",
+			}
+			if tc.forceHTTPS {
+				args = append(args, "-force-https")
+			}
+			cmd := exec.Command(bin, args...)
+			var output bytes.Buffer
+			cmd.Stdout = &output
+			cmd.Stderr = &output
+			if err := cmd.Start(); err != nil {
+				t.Fatalf("failed to start oauth2_proxy: %v", err)
+			}
+			defer func() {
+				cmd.Process.Kill()
+				cmd.Wait()
+			}()
+
+			client := &http.Client{
+				CheckRedirect: func(req *http.Request, via []*http.Request) error {
+					return http.ErrUseLastResponse
+				},
+			}
+			requestURL := "http://" + addr + "/"
+			var res *http.Response
+			deadline := time.Now().Add(15 * time.Second)
+			for {
+				res, err = client.Get(requestURL)
+				if err == nil {
+					break
+				}
+				if time.Now().After(deadline) {
+					t.Fatalf("proxy did not start serving traffic: %v\n%s", err, output.String())
+				}
+				time.Sleep(100 * time.Millisecond)
+			}
+			defer res.Body.Close()
+
+			if tc.forceHTTPS {
+				assert.Equal(t, http.StatusPermanentRedirect, res.StatusCode, "running proxy should redirect plain HTTP requests to HTTPS")
+				location, err := url.Parse(res.Header.Get("Location"))
+				if assert.NoError(t, err, "redirect location should be a valid URL") {
+					port := location.Port()
+					assert.True(t, strings.EqualFold(location.Scheme, "https") &&
+						strings.EqualFold(location.Hostname(), "example.com") &&
+						(port == "" || port == "443"), "redirect should target the configured HTTPS address")
+				}
+			} else {
+				assert.NotEqual(t, http.StatusPermanentRedirect, res.StatusCode, "the default must not force plain HTTP requests to HTTPS")
+			}
+		})
+	}
+}
