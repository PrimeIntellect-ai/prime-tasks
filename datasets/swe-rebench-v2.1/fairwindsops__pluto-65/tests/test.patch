+func TestDetectHelmReportsUnreachableAPI(t *testing.T) {
+	configPath := filepath.Join(t.TempDir(), "kubeconfig")
+	config := `apiVersion: v1
+kind: Config
+clusters:
+- cluster:
+    server: http://127.0.0.1:1
+  name: unreachable
+contexts:
+- context:
+    cluster: unreachable
+    user: unused
+  name: unreachable
+current-context: unreachable
+users:
+- name: unused
+  user: {}
+`
+	if err := ioutil.WriteFile(configPath, []byte(config), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, version := range []string{"2", "3"} {
+		t.Run(version, func(t *testing.T) {
+			command := exec.Command("go", "run", "../..", "detect-helm", "--helm-version", version)
+			command.Env = append(command.Environ(), "KUBECONFIG="+configPath)
+			output, err := command.CombinedOutput()
+			assert.Error(t, err, "detect-helm should fail when the Kubernetes API is unreachable: %s", output)
+			assert.NotContains(t, strings.ToLower(string(output)), "there were no apiversions found")
+		})
+	}
+}
