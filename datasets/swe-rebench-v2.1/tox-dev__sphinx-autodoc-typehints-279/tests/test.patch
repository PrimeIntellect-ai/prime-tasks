diff --git a/tests/test_sphinx_autodoc_typehints.py b/tests/test_sphinx_autodoc_typehints.py
index 8fd463b..c29e8a8 100644
--- a/tests/test_sphinx_autodoc_typehints.py
+++ b/tests/test_sphinx_autodoc_typehints.py
@@ -1121,3 +1121,41 @@ def test_sphinx_output_with_use_signature_and_return(app: SphinxTestApp, status:
           "str"
     """
     assert text_contents == dedent(expected_contents)
+
+
+@pytest.mark.sphinx("text", testroot="dummy")
+@patch("sphinx.writers.text.MAXWIDTH", 2000)
+@pytest.mark.parametrize("typehints_defaults", ["comma", "braces", "braces-after"])
+def test_default_annotation_without_typehints(
+    app: SphinxTestApp, status: StringIO, typehints_defaults: str
+) -> None:
+    set_python_path()
+    app.config.master_doc = "without_complete_typehints"  # type: ignore # create flag
+    app.config.typehints_defaults = typehints_defaults  # type: ignore
+    app.build()
+    assert "build succeeded" in status.getvalue()
+    text_path = pathlib.Path(app.srcdir) / "_build" / "text" / "without_complete_typehints.txt"
+    text_contents = text_path.read_text().replace("–", "--")
+
+    sections = {}
+    for part in text_contents.split("dummy_module_without_complete_typehints.")[1:]:
+        sections[part.split("(", 1)[0].strip()] = part
+
+    # Every function has a parameter ``y`` that has a default (``None``) but no
+    # type hint, so its documentation must include a default clause.
+    for name in (
+        "function_with_some_defaults_and_without_typehints",
+        "function_with_some_defaults_and_some_typehints",
+        "function_with_some_defaults_and_more_typehints",
+        "function_with_defaults_and_some_typehints",
+    ):
+        section = sections[name]
+        assert re.search(r"default\b[^\n]*None", section), section
+
+    # Parameters that do have type hints keep showing their type.
+    assert '"int"' in sections["function_with_some_defaults_and_some_typehints"]
+    assert '"int"' in sections["function_with_some_defaults_and_more_typehints"]
+    assert '"int"' in sections["function_with_defaults_and_some_typehints"]
+    # The return type is still documented.
+    assert '"str"' in sections["function_with_some_defaults_and_more_typehints"]
+    assert '"str"' in sections["function_with_defaults_and_some_typehints"]
