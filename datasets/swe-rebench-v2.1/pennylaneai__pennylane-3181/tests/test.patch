             assert coeff1 == coeff2
 
+    def test_hermitian_tensor_prod(self):
+        """Test that the tensor product of a Hamiltonian with Hermitian observable works."""
+        tensor = qml.PauliX(0) @ qml.PauliX(1)
+        herm = qml.Hermitian([[1, 0], [0, 1]], wires=4)
+
+        left = qml.Hamiltonian([1.0, 1.0], [tensor, qml.PauliX(2)])
+        right = qml.Hamiltonian([1.0], [herm])
+        product = left @ right
+
+        wire_order = [0, 1, 2, 4]
+        expected = qml.matrix(left, wire_order=wire_order) @ qml.matrix(right, wire_order=wire_order)
+        assert np.allclose(qml.matrix(product, wire_order=wire_order), expected)
+
 
