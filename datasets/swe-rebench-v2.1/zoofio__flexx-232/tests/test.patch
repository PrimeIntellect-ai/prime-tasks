+def test_list_both_models_survive_synchronization_jitter():
+    session = app.manager.get_default_session()
+    if session is None:
+        app.manager.create_default_session()
+
+    class TestModel(Model):
+        def __enter__(self):
+            return self
+
+        def __exit__(self, type, value, traceback):
+            pass
+
+    class Container(TestModel):
+        class Both:
+            @event.prop
+            def items(self, v=()):
+                return list(v)
+
+    container = Container()
+    item = TestModel()
+    item_ref = weakref.ref(item)
+
+    container.items = [item]
+    assert container.items == [item]
+
+    # During synchronization, the list can temporarily stop referring to a Model.
+    container.items = []
+    event.loop.iter()
+    del item
+    gc.collect()
+
+    assert container.items == []
+    assert item_ref() is not None
+
+
 run_tests_if_main()
