+#[test]
+fn fully_applied_primitive_operators_evaluate_their_operands() {
+    // A fully applied primitive operator must demand its operands rather than
+    // silently returning a result without evaluating or checking them. Only
+    // ordinary operator syntax is used here, so the check does not depend on
+    // how primitives are spelled.
+    assert!(eval_string("1 + (1 + true)").is_err());
+    assert!(eval_string("(1 + true) + 1").is_err());
+    assert!(matches!(eval_string("1 + (2 + 3) == 6"), Ok(Bool(true))));
+}
