+/// Parse, typecheck and evaluate a Nickel expression, using the standard
+/// library. This lets us check the runtime behaviour of primitive operators
+/// (and of the library wrappers exposing them) rather than their concrete
+/// syntactic representation.
+fn eval_string(s: &str) -> Result<Term, Error> {
+    let mut program = Program::new_from_source(Cursor::new(s), "<test>").unwrap();
+    program.eval()
+}
