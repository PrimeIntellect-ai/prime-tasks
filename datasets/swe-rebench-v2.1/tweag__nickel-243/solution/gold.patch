+    isRecord : Dyn -> Bool = fun x => %isRecord% x;
+
+    seq : forall a. Dyn -> a -> a = fun x y => %seq% x y;
+    deepSeq : forall a. Dyn -> a -> a = fun x y => %deepSeq% x y;
+  }
+}
