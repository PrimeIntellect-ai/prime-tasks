+
+func TestBoundaryChangeAppliesToAllResources(t *testing.T) {
+	g := gomega.NewGomegaWithT(t)
+	mergeBoundaries := `
+merge:
+- spec.eks.configuration.suspendProcesses`
+	restrictedBoundaries := `
+restricted:
+- spec.eks.configuration.suspendProcesses`
+	resources := []*v1alpha1.InstanceGroup{MockResource(), MockResource()}
+	resources[0].Name = "first-resource"
+	resources[1].Name = "second-resource"
+	for _, resource := range resources {
+		resource.Spec.EKSSpec.EKSConfiguration.SuspendedProcesses = []string{"AZRebalance"}
+	}
+
+	// Both resources initially retain the value while the field is mergeable.
+	mergeConfigMap := MockConfigMap(MockConfigData("boundaries", mergeBoundaries))
+	for _, resource := range resources {
+		configuration, err := NewProvisionerConfiguration(mergeConfigMap, resource)
+		g.Expect(err).NotTo(gomega.HaveOccurred())
+		g.Expect(configuration.SetDefaults()).To(gomega.Succeed())
+		g.Expect(configuration.InstanceGroup.Spec.EKSSpec.EKSConfiguration.SuspendedProcesses).To(gomega.Equal([]string{"AZRebalance"}))
+	}
+
+	// After the boundary changes, every existing resource must reflect the new policy.
+	restrictedConfigMap := MockConfigMap(MockConfigData("boundaries", restrictedBoundaries))
+	for _, resource := range resources {
+		configuration, err := NewProvisionerConfiguration(restrictedConfigMap, resource)
+		g.Expect(err).NotTo(gomega.HaveOccurred())
+		g.Expect(configuration.SetDefaults()).To(gomega.Succeed())
+		g.Expect(configuration.InstanceGroup.Spec.EKSSpec.EKSConfiguration.SuspendedProcesses).To(gomega.BeNil())
+	}
+}
