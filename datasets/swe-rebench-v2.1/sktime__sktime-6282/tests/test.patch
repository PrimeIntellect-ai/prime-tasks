+def test_dask_dataframe_extra_allows_compatible_release():
+    """The dataframe extra allows the release that resolves import failures."""
+    from pathlib import Path
+
+    import tomli
+    from packaging.requirements import Requirement
+
+    project = tomli.loads(Path("pyproject.toml").read_text())
+    optional = project["project"]["optional-dependencies"]
+
+    dask_requirements = []
+    for extra, dependencies in optional.items():
+        for dependency in dependencies:
+            requirement = Requirement(dependency)
+            if requirement.name.lower() != "dask":
+                continue
+            applies_to_dataframe = extra == "dataframe" or (
+                requirement.marker is None
+                or requirement.marker.evaluate({"extra": "dataframe"})
+            )
+            if applies_to_dataframe:
+                dask_requirements.append(requirement)
+
+    assert any(
+        requirement.specifier.contains("2024.4.1")
+        for requirement in dask_requirements
+    )
+
+
