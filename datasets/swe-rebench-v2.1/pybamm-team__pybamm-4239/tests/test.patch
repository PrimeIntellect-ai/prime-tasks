+    def test_low_c_rate_voltage_cutoff_runs_past_one_day(self):
+        experiment = pybamm.Experiment(["Discharge at 0.01C until 2.5 V"])
+        model = pybamm.lithium_ion.DFN()
+        parameter_values = pybamm.ParameterValues("Chen2020")
+        sim = pybamm.Simulation(
+            model, parameter_values=parameter_values, experiment=experiment
+        )
+
+        solution = sim.solve()
+
+        final_time_hours = solution["Time [s]"].entries[-1] / 3600
+        self.assertGreater(final_time_hours, 24)
+        self.assertAlmostEqual(final_time_hours, 100, delta=15)
+        self.assertAlmostEqual(solution["Voltage [V]"].entries[-1], 2.5, delta=0.05)
+
