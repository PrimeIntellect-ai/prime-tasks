+type mockSpan struct {
+	opentracing.Span
+	finished bool
+}
+
+func (m *mockSpan) Finish() {
+	m.finished = true
+}
+
+func (m *mockSpan) FinishWithOptions(opentracing.FinishOptions) {
+	m.finished = true
+}
+
+type mockTracer struct {
+	opentracing.Tracer
+	span *mockSpan
+}
+
+func (m *mockTracer) StartSpan(operationName string, options ...opentracing.StartSpanOption) opentracing.Span {
+	span := &mockSpan{Span: opentracing.NoopTracer{}.StartSpan(operationName, options...)}
+	if m.span == nil {
+		m.span = span
+	}
+	return span
+}
+
+func TestRootSpanFinish(t *testing.T) {
+	e := newEngine(t)
+	tracer := &mockTracer{}
+	sessionManager := server.NewSessionManager(
+		func(_ *mysql.Conn, _ string) sql.Session { return sql.NewBaseSession() },
+		tracer,
+		nil,
+		"",
+	)
+	ctx := sessionManager.NewContextWithQuery(&mysql.Conn{ConnectionID: 1}, "SELECT 1")
+
+	_, iter, err := e.Query(ctx, "SELECT 1")
+	require.NoError(t, err)
+
+	_, err = sql.RowIterToRows(iter)
+	require.NoError(t, err)
+
+	require.NotNil(t, tracer.span)
+	require.True(t, tracer.span.finished)
+}
