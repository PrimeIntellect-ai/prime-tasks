+@mock_aws
+def test_list_streams_stream_discription():
+    conn = boto3.client("kinesis", region_name="us-west-2")
+
+    stream_names = [f"stream{i}" for i in range(3)]
+    for i, stream_name in enumerate(stream_names):
+        conn.create_stream(StreamName=stream_name, ShardCount=i + 1)
+
+    resp = conn.list_streams()
+
+    # Legacy fields are still part of the response
+    assert isinstance(resp["HasMoreStreams"], bool)
+    assert resp["HasMoreStreams"] is False
+    assert isinstance(resp["StreamNames"], list)
+    assert sorted(resp["StreamNames"]) == sorted(stream_names)
+
+    # StreamSummaries mirrors the per-stream metadata returned by AWS
+    summaries = resp["StreamSummaries"]
+    assert isinstance(summaries, list)
+    assert len(summaries) == 3
+    summaries_by_name = {summary["StreamName"]: summary for summary in summaries}
+    assert sorted(summaries_by_name) == sorted(stream_names)
+    for stream_name in stream_names:
+        stream = summaries_by_name[stream_name]
+        assert (
+            stream["StreamARN"]
+            == f"arn:aws:kinesis:us-west-2:{ACCOUNT_ID}:stream/{stream_name}"
+        )
+        assert stream["StreamStatus"] == "ACTIVE"
+        # StreamCreationTimestamp is optional per the API contract; if present it
+        # must be a valid timestamp value.
+        if "StreamCreationTimestamp" in stream:
+            assert stream["StreamCreationTimestamp"]
+
+
