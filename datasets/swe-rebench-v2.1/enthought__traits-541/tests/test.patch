+    def test_sync_lists_partial_slice(self):
+        """ Test synchronization of list traits when there is a partial slice.
+
+        Regression test for enthought/traits#540
+        """
+
+        a = A()
+        b = B()
+
+        a.sync_trait("l", b)
+
+        # Change list items with an empty slice.
+        a.l[:] = [7]
+        self.assertEqual(a.l, [7])
+        self.assertEqual(b.l, [7])
+
+        # Change list items with a partial slice.
+        a.l[:0] = [6]
+        self.assertEqual(a.l, [6, 7])
+        self.assertEqual(b.l, [6, 7])
+
+    def test_sync_lists_partial_slice_mutual(self):
+        """ Test an index-less slice assignment with mutual synchronization.
+
+        Regression test for enthought/traits#540.
+        """
+
+        a = A()
+        b = B()
+
+        a.l = [-1, -2, -3]
+        b.l = []
+        a.sync_trait("l", b, mutual=True)
+
+        # Change list items with an index-less slice.
+        b.l[:] = [1, 2, 3]
+        self.assertEqual(a.l, [1, 2, 3])
+        self.assertEqual(b.l, [1, 2, 3])
+
