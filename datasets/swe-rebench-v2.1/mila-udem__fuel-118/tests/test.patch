+class TestDownloadProgress(object):
+    def _download_in_subprocess(self, url):
+        script = (
+            "import sys, os\n"
+            "from fuel.downloaders.base import download\n"
+            "with open(os.devnull, 'wb') as fh:\n"
+            "    download(sys.argv[1], fh)\n"
+        )
+        # Run the download in a child process whose stdout/stderr are a
+        # pseudo-terminal, so that a progress bar is rendered regardless of
+        # whether the implementation only draws on an interactive terminal.
+        master, slave = pty.openpty()
+        proc = subprocess.Popen(
+            [sys.executable, '-c', script, url], cwd=repo_root,
+            stdout=slave, stderr=slave)
+        os.close(slave)
+        chunks = []
+        while True:
+            try:
+                data = os.read(master, 4096)
+            except OSError:
+                break
+            if not data:
+                break
+            chunks.append(data)
+        proc.wait()
+        os.close(master)
+        return proc.returncode, b''.join(chunks)
+
+    def test_progress_bar_with_content_length(self):
+        with _LocalServer(b'progress bar body\n' * 100) as base:
+            returncode, output = self._download_in_subprocess(
+                base + '/with_content_length')
+        assert returncode == 0
+        assert output
+
+    def test_progress_bar_without_content_length(self):
+        with _LocalServer(b'progress bar body\n' * 100) as base:
+            returncode, output = self._download_in_subprocess(
+                base + '/no_content_length')
+        assert returncode == 0
+        assert output
 
 
