+class TestDownload(object):
+    def test_download_content(self):
+        with tempfile.SpooledTemporaryFile() as f:
+            download(iris_url, f)
+            f.seek(0)
+            assert_equal(hashlib.md5(f.read()).hexdigest(), iris_hash)
+
+    def test_download_returns_none(self):
+        with tempfile.SpooledTemporaryFile() as f:
+            assert download(iris_url, f) is None
+
+    def test_download_chunk_size(self):
+        with tempfile.SpooledTemporaryFile() as f:
+            download(iris_url, f, chunk_size=64)
+            f.seek(0)
+            assert_equal(hashlib.md5(f.read()).hexdigest(), iris_hash)
+
+    def test_download_raises_on_network_failure(self):
+        with tempfile.SpooledTemporaryFile() as f:
+            assert_raises(requests.exceptions.RequestException,
+                          download, 'http://127.0.0.1:1/', f)
