+@pytest.mark.parametrize("fl_type", FL_TYPES)
+@pytest.mark.parametrize("array_backend", ARRAY_BACKENDS)
+def test_grib_to_numpy_1_index(fl_type, array_backend):
+    ds = load_grib_data("test_single.grib", fl_type, array_backend, folder="data")
+
+    v = ds.to_numpy(flatten=True, index=slice(None, None))
+    assert isinstance(v, np.ndarray)
+    assert v.dtype == np.float64
+    assert v.shape == (1, 84)
+    assert np.allclose(v[0], ds[0].values)
+
+
+@pytest.mark.parametrize("fl_type", FL_TYPES)
+@pytest.mark.parametrize("array_backend", ARRAY_BACKENDS)
+def test_grib_to_numpy_18_index(fl_type, array_backend):
+    ds = load_grib_data("tuv_pl.grib", fl_type, array_backend)
+
+    eps = 1e-5
+
+    v = ds.to_numpy(flatten=True, index=slice(None, 2))
+    assert isinstance(v, np.ndarray)
+    assert v.dtype == np.float64
+    assert v.shape == (18, 2)
+    vf0 = v[0].flatten()
+    assert np.allclose(vf0, [272.56417847, 272.56417847])
+    vf15 = v[15].flatten()
+    assert np.allclose(vf15, [226.65315247, 226.65315247])
+
+    v = ds.to_numpy(flatten=True, index=slice(None, None))
+    assert isinstance(v, np.ndarray)
+    assert v.dtype == np.float64
+    assert v.shape == (18, 84)
+    vf0 = v[0].flatten()
+    check_array(
+        vf0,
+        (84,),
+        first=272.5642,
+        last=240.56417846679688,
+        meanv=279.70703560965404,
+        eps=eps,
+    )
+
+    vf15 = v[15].flatten()
+    check_array(
+        vf15,
+        (84,),
+        first=226.6531524658203,
+        last=206.6531524658203,
+        meanv=227.84362865629652,
+        eps=eps,
+    )
+
+
+@pytest.mark.parametrize("fl_type", FL_TYPES)
+def test_grib_to_numpy_indexes_fields_before_combining(fl_type, monkeypatch):
+    ds = load_grib_data("tuv_pl.grib", fl_type, "numpy")
+    original_array = np.array
+    last_field_start = ds[-1].values[:2]
+
+    def reject_unselected_combined_array(values, *args, **kwargs):
+        if (
+            isinstance(values, list)
+            and len(values) == len(ds)
+            and all(getattr(value, "shape", None) == (84,) for value in values)
+        ):
+            pytest.fail("full field arrays were combined before applying the index")
+        return original_array(values, *args, **kwargs)
+
+    monkeypatch.setattr(np, "array", reject_unselected_combined_array)
+    result = ds.to_numpy(flatten=True, index=slice(None, 2))
+    assert result.shape == (18, 2)
+    assert np.allclose(result[0], [272.56417847, 272.56417847])
+    assert np.allclose(result[-1], last_field_start)
+
+
