       doctest @cache
 
+      defp includes_value?(term, expected) do
+        cond do
+          term == expected ->
+            true
+
+          is_map(term) ->
+            term |> Map.to_list() |> Enum.any?(fn {key, value} ->
+              includes_value?(key, expected) or includes_value?(value, expected)
+            end)
+
+          is_tuple(term) ->
+            term |> Tuple.to_list() |> Enum.any?(&includes_value?(&1, expected))
+
+          is_list(term) ->
+            Enum.any?(term, &includes_value?(&1, expected))
+
+          true ->
+            false
+        end
+      end
+
