+    // Assigning Quantities with value 0 (e.g., Age)
+    it('should assign a Quantity with value 0 (and not drop the 0)', () => {
+      // short syntax: * valueQuantity = 0 'mm' "mm"
+      const shortInstance = new Instance('ZeroValueShortObservation');
+      shortInstance.instanceOf = 'Observation';
+      const shortRule = new AssignmentRule('valueQuantity');
+      shortRule.value = new FshQuantity(0, new FshCode('mm', 'http://unitsofmeasure.org', 'mm'));
+      shortInstance.rules.push(shortRule);
+      doc.instances.set(shortInstance.name, shortInstance);
+
+      // nested syntax: * valueQuantity.value = 0, * valueQuantity.code = #mm, etc.
+      const nestedInstance = new Instance('ZeroValueNestedObservation');
+      nestedInstance.instanceOf = 'Observation';
+      const valueRule = new AssignmentRule('valueQuantity.value');
+      valueRule.value = 0;
+      const codeRule = new AssignmentRule('valueQuantity.code');
+      codeRule.value = new FshCode('mm');
+      const systemRule = new AssignmentRule('valueQuantity.system');
+      systemRule.value = 'http://unitsofmeasure.org';
+      const unitRule = new AssignmentRule('valueQuantity.unit');
+      unitRule.value = 'mm';
+      nestedInstance.rules.push(valueRule, codeRule, systemRule, unitRule);
+      doc.instances.set(nestedInstance.name, nestedInstance);
+
+      const exportedShort = exportInstance(shortInstance);
+      const exportedNested = exportInstance(nestedInstance);
+
+      expect(exportedShort.valueQuantity).toEqual({
+        value: 0,
+        code: 'mm',
+        system: 'http://unitsofmeasure.org',
+        unit: 'mm'
+      });
+      // the short syntax must produce the same result as the equivalent nested assignment
+      expect(exportedShort.valueQuantity).toEqual(exportedNested.valueQuantity);
+    });
+
