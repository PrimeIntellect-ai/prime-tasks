+  // Launches a fresh JVM with a plain `java -cp` classpath, so the application
+  // classloader is not a URLClassLoader on JDK 9+.
+  private def runOnJava(mainClass: String, args: String*): Int = {
+    val loaders = Seq(
+      getClass.getClassLoader,
+      Metac.getClass.getClassLoader,
+      classOf[scala.Option[_]].getClassLoader,
+      classOf[scala.tools.nsc.Global].getClassLoader
+    )
+    val loaderEntries = loaders.iterator.flatMap { initial =>
+      Iterator.iterate(initial)(_.getParent).takeWhile(_ != null).flatMap {
+        case loader: java.net.URLClassLoader => loader.getURLs.iterator
+            .filter(_.getProtocol == "file").map(url => Paths.get(url.toURI).toString)
+        case _ => Iterator.empty
+      }
+    }
+    val systemEntries = Option(System.getProperty("java.class.path")).toSeq
+      .flatMap(_.split(java.io.File.pathSeparator))
+    val classpath = (systemEntries ++ loaderEntries :+ scalaLibraryLocation.toString).distinct
+      .mkString(java.io.File.pathSeparator)
+    val java = Paths.get(System.getProperty("java.home"), "bin", if (Properties.isWin) "java.exe" else "java")
+    val command = List(java.toString, "-cp", classpath, mainClass) ++ args
+    new ProcessBuilder(command: _*).inheritIO().start().waitFor()
+  }
