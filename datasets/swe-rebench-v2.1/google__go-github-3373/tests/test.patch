+func TestTeamsService_IDBasedOperationsDeprecated(tt *testing.T) {
+	tt.Parallel()
+	// Team operations that identify the team by its numeric ID must carry a
+	// Deprecated notice; every other TeamsService operation must not.
+	wantDeprecated := map[string]bool{
+		"GetTeamByID":                           true,
+		"EditTeamByID":                          true,
+		"DeleteTeamByID":                        true,
+		"ListChildTeamsByParentID":              true,
+		"ListTeamReposByID":                     true,
+		"IsTeamRepoByID":                        true,
+		"AddTeamRepoByID":                       true,
+		"RemoveTeamRepoByID":                    true,
+		"ListTeamProjectsByID":                  true,
+		"ReviewTeamProjectsByID":                true,
+		"AddTeamProjectByID":                    true,
+		"RemoveTeamProjectByID":                 true,
+		"ListIDPGroupsForTeamByID":              true,
+		"CreateOrUpdateIDPGroupConnectionsByID": true,
+	}
+	fset := token.NewFileSet()
+	pkgs, err := parser.ParseDir(fset, ".", func(fi fs.FileInfo) bool {
+		return !strings.HasSuffix(fi.Name(), "_test.go")
+	}, parser.ParseComments)
+	if err != nil {
+		tt.Fatalf("parsing package sources: %v", err)
+	}
+	seen := map[string]bool{}
+	for _, pkg := range pkgs {
+		for _, file := range pkg.Files {
+			for _, decl := range file.Decls {
+				fd, ok := decl.(*ast.FuncDecl)
+				if !ok || fd.Recv == nil || len(fd.Recv.List) != 1 {
+					continue
+				}
+				if recvName(fd.Recv.List[0].Type) != "TeamsService" {
+					continue
+				}
+				name := fd.Name.Name
+				if !ast.IsExported(name) {
+					continue
+				}
+				seen[name] = true
+				deprecated := false
+				if fd.Doc != nil {
+					for _, line := range strings.Split(fd.Doc.Text(), "\n") {
+						if strings.HasPrefix(line, "Deprecated: ") {
+							deprecated = true
+						}
+					}
+				}
+				if deprecated != wantDeprecated[name] {
+					tt.Errorf("TeamsService.%v deprecated = %v, want %v", name, deprecated, wantDeprecated[name])
+				}
+			}
+		}
+	}
+	for name := range wantDeprecated {
+		if !seen[name] {
+			tt.Errorf("TeamsService.%v not found", name)
+		}
+	}
+}
+
+func recvName(expr ast.Expr) string {
+	if star, ok := expr.(*ast.StarExpr); ok {
+		expr = star.X
+	}
+	if id, ok := expr.(*ast.Ident); ok {
+		return id.Name
+	}
+	return ""
+}
