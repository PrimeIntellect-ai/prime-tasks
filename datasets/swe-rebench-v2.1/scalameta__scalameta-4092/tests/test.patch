@@ -960,4 +960,18 @@ class GivenSyntax36Suite extends BaseDottySuite {
     runTestAssert[Stat](code, layout)(tree)
   }
 
+  test("#4091 given") {
+    val code = "given List[Int] => Object {}"
+    code.parse[Stat].get match {
+      case g: Defn.Given =>
+        assert(g.name.isInstanceOf[Name.Anonymous])
+        assertEquals(g.templ.inits.map(_.tpe.syntax), List("Object"))
+        val structure = g.structure
+        assert(structure.contains("\"List\""), clue = structure)
+        assert(structure.contains("\"Int\""), clue = structure)
+      case other =>
+        fail(s"expected a given definition, got: ${other.productPrefix}")
+    }
+  }
+
 }
