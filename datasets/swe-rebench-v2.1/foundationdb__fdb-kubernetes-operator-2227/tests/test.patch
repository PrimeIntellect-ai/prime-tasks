+package controllers
+
+import (
+	"context"
+
+	"github.com/FoundationDB/fdb-kubernetes-operator/v2/internal"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/types"
+)
+
+var _ = Describe("ConfigMap annotations", func() {
+	It("reconciles a cluster with custom ConfigMap annotations", func() {
+		cluster := internal.CreateDefaultCluster()
+		Expect(k8sClient.Create(context.TODO(), cluster)).To(Succeed())
+		_, err := reconcileCluster(cluster)
+		Expect(err).NotTo(HaveOccurred())
+
+		key := types.NamespacedName{Namespace: cluster.Namespace, Name: cluster.Name}
+		Expect(k8sClient.Get(context.TODO(), key, cluster)).To(Succeed())
+		cluster.Spec.ConfigMap = &corev1.ConfigMap{
+			ObjectMeta: metav1.ObjectMeta{
+				Annotations: map[string]string{
+					"example.com/custom": "configured-value",
+				},
+			},
+		}
+		Expect(k8sClient.Update(context.TODO(), cluster)).To(Succeed())
+		_, err = reconcileCluster(cluster)
+		Expect(err).NotTo(HaveOccurred())
+
+		configMap := &corev1.ConfigMap{}
+		configMapKey := types.NamespacedName{Namespace: cluster.Namespace, Name: cluster.Name + "-config"}
+		Expect(k8sClient.Get(context.TODO(), configMapKey, configMap)).To(Succeed())
+		Expect(configMap.Annotations).To(HaveKeyWithValue("example.com/custom", "configured-value"))
+	})
+})
