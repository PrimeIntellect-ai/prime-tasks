+# pylint: disable=missing-class-docstring,missing-module-docstring
+
+import inspect
+
+from qiskit.circuit import QuantumCircuit, QuantumRegister, ClassicalRegister, Qubit, Clbit, IfElseOp
+from qiskit.test import QiskitTestCase
+from qiskit.test._canonical import canonicalize_control_flow
+from qiskit.transpiler import PassManager, TransformationPass
+import qiskit.transpiler.passes as transpiler_passes
+
+
+def _find_condition_conversion_pass():
+    """Find the publicly exported transformation with the required observable behaviour."""
+    bits = [Qubit(), Clbit()]
+    base = QuantumCircuit(bits)
+    base.x(0).c_if(0, 1)
+
+    for _, candidate in inspect.getmembers(transpiler_passes, inspect.isclass):
+        if candidate is TransformationPass or not issubclass(candidate, TransformationPass):
+            continue
+        try:
+            output = PassManager([candidate()]).run(base.copy())
+        except Exception:
+            continue
+        if len(output.data) != 1 or not isinstance(output.data[0].operation, IfElseOp):
+            continue
+        converted = output.data[0].operation
+        condition = converted.condition
+        if condition != (output.clbits[0], True) or len(converted.blocks) != 1:
+            continue
+        body = converted.blocks[0]
+        if len(body.data) == 1 and body.data[0].operation.name == "x":
+            return candidate
+    raise AssertionError("No public transpiler transformation performs the required conversion")
+
+
+def _assert_circuits_match_ignoring_control_flow_wire_footprint(test_case, actual, expected):
+    """Compare circuit contents without requiring minimal control-flow block wires."""
+
+    def signatures(circuit, qubit_map, clbit_map):
+        result = []
+        for item in circuit.data:
+            operation = item.operation
+            qargs = tuple(qubit_map[circuit.qubits.index(bit)] for bit in item.qubits)
+            cargs = tuple(clbit_map[circuit.clbits.index(bit)] for bit in item.clbits)
+            blocks = getattr(operation, "blocks", ())
+            condition = repr(getattr(operation, "condition", None))
+            metadata = repr(getattr(operation, "indexset", None))
+            is_control_flow = bool(blocks)
+            result.append(("operation", type(operation).__name__, operation.name,
+                           repr(()) if is_control_flow else repr(getattr(operation, "params", ())),
+                           () if is_control_flow else qargs,
+                           () if is_control_flow else cargs, condition, metadata))
+            for block in blocks:
+                child_qubits = {index: qargs[index] for index in range(len(block.qubits))}
+                child_clbits = {index: cargs[index] for index in range(len(block.clbits))}
+                result.extend(signatures(block, child_qubits, child_clbits))
+        return result
+
+    actual_signatures = signatures(actual, dict(enumerate(range(actual.num_qubits))),
+                                   dict(enumerate(range(actual.num_clbits))))
+    expected_signatures = signatures(expected, dict(enumerate(range(expected.num_qubits))),
+                                     dict(enumerate(range(expected.num_clbits))))
+    test_case.assertCountEqual(actual_signatures, expected_signatures)
+
+
+class TestConvertConditionsToIfOps(QiskitTestCase):
+    @classmethod
+    def setUpClass(cls):
+        super().setUpClass()
+        cls.conversion_pass = _find_condition_conversion_pass()
+    def test_simple_loose_bits(self):
+        """Test that basic conversions work when operating on loose classical bits."""
+        bits = [Qubit(), Qubit(), Clbit(), Clbit()]
+
+        base = QuantumCircuit(bits)
+        base.h(0)
+        base.x(0).c_if(0, 1)
+        base.z(1).c_if(1, 0)
+        base.measure(0, 0)
+        base.measure(1, 1)
+        base.h(0)
+        base.x(0).c_if(0, 1)
+        base.cx(0, 1).c_if(1, 0)
+
+        expected = QuantumCircuit(bits)
+        expected.h(0)
+        with expected.if_test((expected.clbits[0], True)):
+            expected.x(0)
+        with expected.if_test((expected.clbits[1], False)):
+            expected.z(1)
+        expected.measure(0, 0)
+        expected.measure(1, 1)
+        expected.h(0)
+        with expected.if_test((expected.clbits[0], True)):
+            expected.x(0)
+        with expected.if_test((expected.clbits[1], False)):
+            expected.cx(0, 1)
+        expected = canonicalize_control_flow(expected)
+
+        output = PassManager([self.conversion_pass()]).run(base)
+        _assert_circuits_match_ignoring_control_flow_wire_footprint(self, output, expected)
+
+    def test_simple_registers(self):
+        """Test that basic conversions work when operating on conditions over registers."""
+        registers = [QuantumRegister(2), ClassicalRegister(2), ClassicalRegister(1)]
+
+        base = QuantumCircuit(*registers)
+        base.h(0)
+        base.x(0).c_if(base.cregs[0], 1)
+        base.z(1).c_if(base.cregs[1], 0)
+        base.measure(0, 0)
+        base.measure(1, 2)
+        base.h(0)
+        base.x(0).c_if(base.cregs[0], 1)
+        base.cx(0, 1).c_if(base.cregs[1], 0)
+
+        expected = QuantumCircuit(*registers)
+        expected.h(0)
+        with expected.if_test((expected.cregs[0], 1)):
+            expected.x(0)
+        with expected.if_test((expected.cregs[1], 0)):
+            expected.z(1)
+        expected.measure(0, 0)
+        expected.measure(1, 2)
+        expected.h(0)
+        with expected.if_test((expected.cregs[0], 1)):
+            expected.x(0)
+        with expected.if_test((expected.cregs[1], 0)):
+            expected.cx(0, 1)
+        expected = canonicalize_control_flow(expected)
+
+        output = PassManager([self.conversion_pass()]).run(base)
+        _assert_circuits_match_ignoring_control_flow_wire_footprint(self, output, expected)
+
+    def test_nested_control_flow(self):
+        """Test that the pass successfully converts instructions nested within control-flow
+        blocks."""
+        bits = [Clbit()]
+        registers = [QuantumRegister(3), ClassicalRegister(2)]
+
+        base = QuantumCircuit(*registers, bits)
+        base.x(0).c_if(bits[0], False)
+        with base.if_test((base.cregs[0], 0)) as else_:
+            base.z(1).c_if(bits[0], False)
+        with else_:
+            base.z(1).c_if(base.cregs[0], 1)
+        with base.for_loop(range(2)):
+            with base.while_loop((base.cregs[0], 1)):
+                base.cx(1, 2).c_if(base.cregs[0], 1)
+        base = canonicalize_control_flow(base)
+
+        expected = QuantumCircuit(*registers, bits)
+        with expected.if_test((bits[0], False)):
+            expected.x(0)
+        with expected.if_test((expected.cregs[0], 0)) as else_:
+            with expected.if_test((bits[0], False)):
+                expected.z(1)
+        with else_:
+            with expected.if_test((expected.cregs[0], 1)):
+                expected.z(1)
+        with expected.for_loop(range(2)):
+            with expected.while_loop((expected.cregs[0], 1)):
+                with expected.if_test((expected.cregs[0], 1)):
+                    expected.cx(1, 2)
+        expected = canonicalize_control_flow(expected)
+
+        output = PassManager([self.conversion_pass()]).run(base)
+        _assert_circuits_match_ignoring_control_flow_wire_footprint(self, output, expected)
+
+    def test_no_op(self):
+        """Test that the pass works when recursing into control-flow structures, but there's nothing
+        that actually needs replacing."""
+        bits = [Clbit()]
+        registers = [QuantumRegister(3), ClassicalRegister(2)]
+
+        base = QuantumCircuit(*registers, bits)
+        base.x(0)
+        with base.if_test((base.cregs[0], 0)) as else_:
+            base.z(1)
+        with else_:
+            base.z(2)
+        with base.for_loop(range(2)):
+            with base.while_loop((base.cregs[0], 1)):
+                base.cx(1, 2)
+        base = canonicalize_control_flow(base)
+        output = PassManager([self.conversion_pass()]).run(base)
+        self.assertEqual(output, base)
