+def test_pi_support_uses_bundle_data(tmp_path):
+    package_dir = Path(localedata.__file__).resolve().parent
+    app_dir = tmp_path / 'app'
+    bundle_dir = tmp_path / 'bundle'
+    app_dir.mkdir()
+    bundle_dir.mkdir()
+    bundle_package_dir = bundle_dir / 'babel'
+    bundle_package_dir.mkdir()
+    shutil.copytree(
+        package_dir,
+        app_dir / 'babel',
+        ignore=shutil.ignore_patterns('locale-data', 'global.dat', '__pycache__'),
+    )
+    shutil.copytree(package_dir / 'locale-data', bundle_dir / 'locale-data')
+    shutil.copy2(package_dir / 'global.dat', bundle_dir / 'global.dat')
+    shutil.copytree(package_dir / 'locale-data', bundle_package_dir / 'locale-data')
+    shutil.copy2(package_dir / 'global.dat', bundle_package_dir / 'global.dat')
+
+    code = '''
+import sys
+sys.frozen = True
+sys._MEIPASS = %r
+from babel import localedata
+from babel.core import get_global
+assert localedata.load('en_US')['languages']['sv'] == 'Swedish'
+assert get_global('zone_aliases')
+''' % str(bundle_dir)
+    env = os.environ.copy()
+    env['PYTHONPATH'] = str(app_dir)
+    subprocess.run(
+        [sys.executable, '-c', code], cwd=str(tmp_path), env=env, check=True,
+    )
