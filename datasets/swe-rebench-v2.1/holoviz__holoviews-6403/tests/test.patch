+    @pytest.mark.skipif(bokeh_version < Version("3.6"), reason="requires Bokeh >= 3.6")
+    @pytest.mark.parametrize("enabled1", [True, False])
+    @pytest.mark.parametrize("enabled2", [True, False])
+    @pytest.mark.parametrize("enabled3", [True, False])
+    def test_scalebar_with_subcoordinate_y(self, enabled1, enabled2, enabled3):
+        from bokeh.models import ScaleBar
+
+        enabled = [enabled1, enabled2, enabled3]
+        curves = [
+            Curve([i, i + 1, i + 2], label=f"c{i}").opts(scalebar=e, subcoordinate_y=True)
+            for i, e in enumerate(enabled, 1)
+        ]
+        overlay = curves[0] * curves[1] * curves[2]
+
+        plot = bokeh_renderer.get_plot(overlay).handles["plot"]
+        scalebar_ranges = [c.range for c in plot.center if isinstance(c, ScaleBar)]
+        assert len(scalebar_ranges) == sum(enabled)
+
+        for curve, e in zip(curves, enabled):
+            y_values = list(curve.dimension_values(1))
+            renderer = next(
+                r for r in plot.renderers if list(r.data_source.data["y"]) == y_values
+            )
+            y_source = renderer.coordinates.y_source
+            assert any(y_source is sr for sr in scalebar_ranges) == e
+
 
