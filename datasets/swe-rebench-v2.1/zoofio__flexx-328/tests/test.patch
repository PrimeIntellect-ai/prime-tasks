@@ -1462,4 +1462,16 @@ def test_deep2(Node):
     return res
 
 
+def test_slider_initial_value():
+    # The reported case: min=3, max=10, value=6
+    from flexx import app, ui
+    session = app.Session('test_slider_initial_value')
+    s = ui.Slider(session=session, min=3, max=10, value=6, step=1.)
+    assert s.value == 6
+    # The initial value must be honored regardless of the order in which
+    # the properties are specified.
+    s2 = ui.Slider(session=session, value=6, min=3, max=10, step=1.)
+    assert s2.value == 6
+
+
 run_tests_if_main()
