+    def test_marginal_counts_result_memory(self):
+        """Test that a Result object containing memory marginalizes correctly."""
+        result = self.generate_qiskit_result()
+        marginal_result = marginal_counts(result, indices=[0])
+        marginal_memory = getattr(marginal_result.results[0].data, "memory", [])
+        expected = [ii % 2 for ii in range(8)]
+        self.assert_memory_is_marginalized_or_empty(marginal_memory, expected)
+
+        # Marginalizing onto a different bit position must select that bit,
+        # not always bit 0.  Use memory values with enough bits so that the
+        # requested position is present in every readout.
+        memory = [hex(ii) for ii in range(8, 16)]
+        result = self.generate_qiskit_result(memory=memory)
+        marginal_result = marginal_counts(result, indices=[1])
+        marginal_memory = getattr(marginal_result.results[0].data, "memory", [])
+        expected = [(ii >> 1) & 1 for ii in range(8, 16)]
+        self.assert_memory_is_marginalized_or_empty(marginal_memory, expected)
+
+    def test_marginal_counts_result_inplace(self):
+        """Test in-place counts and memory marginalization."""
+        result = self.generate_qiskit_result()
+
+        marginal_result = marginal_counts(result, indices=[0], inplace=True)
+        self.assertIs(result, marginal_result)
+        marginal_memory = getattr(marginal_result.results[0].data, "memory", [])
+        expected = [ii % 2 for ii in range(8)]
+        self.assert_memory_is_marginalized_or_empty(marginal_memory, expected)
+
+    def assert_memory_is_marginalized_or_empty(self, memory, expected_values):
+        """Check that memory has the projected values or uses the empty fallback."""
+        if memory:
+            self.assertEqual([int(value, 0) for value in memory], expected_values)
+        else:
+            self.assertEqual(memory, [])
+
