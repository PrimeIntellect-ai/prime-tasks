+@skip_pre_37
+def test_class_var_as_string(create_module):
+    module = create_module(
+        # language=Python
+        """
+from __future__ import annotations
+from typing import ClassVar
+from pydantic import BaseModel
+
+class Model(BaseModel):
+    a: ClassVar[int]
+    b: ClassVar[int] = 10
+"""
+    )
+
+    # A stringified ``ClassVar`` annotation must be parsed as a class variable,
+    # i.e. it must not become a model field, whether or not it has a default.
+    assert 'a' not in module.Model.__fields__
+    assert 'b' not in module.Model.__fields__
+    assert module.Model().dict() == {}
+    assert module.Model.b == 10
+
+
+def test_class_var_as_string_explicit(create_module):
+    module = create_module(
+        # language=Python
+        """
+from typing import ClassVar
+from pydantic import BaseModel
+
+class Model(BaseModel):
+    val: "ClassVar[int]" = 10
+"""
+    )
+
+    assert 'val' not in module.Model.__fields__
+    assert module.Model().dict() == {}
+    assert module.Model.val == 10
