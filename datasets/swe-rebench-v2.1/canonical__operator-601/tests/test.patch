diff --git a/test/test_charm.py b/test/test_charm.py
index 78dd4aa..d76ebda 100755
--- a/test/test_charm.py
+++ b/test/test_charm.py
@@ -430,3 +430,40 @@ containers:
         self.assertIsInstance(meta.containers['test2'], ContainerMeta)
         self.assertEqual(meta.containers['test1'].name, 'test1')
         self.assertEqual(meta.containers['test2'].name, 'test2')
+
+    def test_containers_storage(self):
+        meta = CharmMeta.from_yaml("""
+name: k8s-charm
+storage:
+  data:
+    type: filesystem
+    location: /test/storage
+  other:
+    type: filesystem
+    location: /test/other
+containers:
+  test1:
+    mounts:
+      - storage: data
+        location: /test/storagemount
+      - storage: other
+        location: /test/otherdata
+""")
+        mounts = meta.containers['test1'].mounts
+
+        def configured_locations(storage, index):
+            # Mounts may be exposed by storage name or by their position in the
+            # configured list, as in the public examples.
+            locations = []
+            for lookup in (
+                    lambda: mounts[storage],
+                    lambda: getattr(mounts, storage),
+                    lambda: mounts[index]):
+                try:
+                    locations.append(lookup().location)
+                except (AttributeError, IndexError, KeyError, TypeError):
+                    continue
+            return locations
+
+        self.assertIn('/test/storagemount', configured_locations('data', 0))
+        self.assertIn('/test/otherdata', configured_locations('other', 1))
