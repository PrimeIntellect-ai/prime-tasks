+
+  test("logs a warning when both honeycomb and w3c headers are present", () => {
+    const debug = require("debug");
+    const stderrWrites = [];
+    let consoleWarned = false;
+    let processWarned = false;
+    const origStderrWrite = process.stderr.write;
+    const origWarn = console.warn;
+    const origError = console.error;
+    const onWarning = () => {
+      processWarned = true;
+    };
+
+    process.stderr.write = (chunk) => {
+      stderrWrites.push(chunk.toString());
+      return true;
+    };
+    console.warn = () => {
+      consoleWarned = true;
+    };
+    console.error = () => {
+      consoleWarned = true;
+    };
+    process.on("warning", onWarning);
+    debug.enable("*");
+
+    try {
+      traceUtil.getTraceContext(
+        undefined,
+        getRequestWithHeaders([
+          {
+            name: api.w3c.TRACE_HTTP_HEADER,
+            value: "00-7f042f75651d9782dcff93a45fa99be0-c998e73e5420f609-01",
+          },
+          {
+            name: api.honeycomb.TRACE_HTTP_HEADER,
+            value: "1;trace_id=abcdefbeelineahh,parent_id=12345",
+          },
+        ])
+      );
+    } finally {
+      process.stderr.write = origStderrWrite;
+      console.warn = origWarn;
+      console.error = origError;
+      process.removeListener("warning", onWarning);
+      debug.disable();
+    }
+
+    const output = stderrWrites.join("").toLowerCase();
+    expect(consoleWarned || processWarned || output.length > 0).toBe(true);
+  });
