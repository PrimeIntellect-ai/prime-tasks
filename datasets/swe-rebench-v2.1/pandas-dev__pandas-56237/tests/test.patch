+    def test_pivot_table_observed_default_is_no_default(self):
+        # The default of observed is lib.no_default for both public entry points
+        for func in (pd.pivot_table, DataFrame.pivot_table):
+            default = inspect.signature(func).parameters["observed"].default
+            assert default is lib.no_default
+
+    @pytest.mark.parametrize("observed", [True, False])
+    def test_pivot_table_explicit_observed_no_warning(self, observed):
+        df = DataFrame(
+            {
+                "A": pd.Categorical(["a", "b", "a"]),
+                "B": ["x", "y", "x"],
+                "V": [1, 2, 3],
+            }
+        )
+        with tm.assert_produces_warning(False):
+            result = df.pivot_table(index="A", values="V", observed=observed)
+        assert result.index.name == "A"
+
