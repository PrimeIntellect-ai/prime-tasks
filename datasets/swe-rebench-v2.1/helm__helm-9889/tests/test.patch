+func TestUpdateSucceedsWithStaleTmpchartsDirectory(t *testing.T) {
+	srv, err := repotest.NewTempServerWithCleanup(t, "testdata/*.tgz*")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer srv.Stop()
+	if err := srv.LinkIndices(); err != nil {
+		t.Fatal(err)
+	}
+
+	chartPath, err := ioutil.TempDir("", "test-update-tmpcharts")
+	if err != nil {
+		t.Fatalf("could not create tempdir: %v", err)
+	}
+	defer os.RemoveAll(chartPath)
+
+	parent := &chart.Chart{Metadata: &chart.Metadata{
+		Name:       "parent",
+		Version:    "0.1.0",
+		APIVersion: chart.APIVersionV2,
+		Dependencies: []*chart.Dependency{{
+			Name:       "local-subchart",
+			Repository: srv.URL(),
+			Version:    "0.1.0",
+		}},
+	}}
+	if err := chartutil.SaveDir(parent, chartPath); err != nil {
+		t.Fatal(err)
+	}
+	chartRoot := filepath.Join(chartPath, parent.Name())
+
+	// Simulate a temporary directory left behind by an interrupted update.
+	if err := os.MkdirAll(filepath.Join(chartRoot, "tmpcharts"), 0755); err != nil {
+		t.Fatal(err)
+	}
+
+	g := getter.Providers{getter.Provider{
+		Schemes: []string{"http", "https"},
+		New:     getter.NewHTTPGetter,
+	}}
+	m := &Manager{
+		Out:              new(bytes.Buffer),
+		Getters:          g,
+		RepositoryConfig: filepath.Join(srv.Root(), "repositories.yaml"),
+		RepositoryCache:  srv.Root(),
+		ChartPath:        chartRoot,
+	}
+	if err := m.Update(); err != nil {
+		t.Fatalf("dependency update failed with a stale temporary directory: %v", err)
+	}
+
+	updated, err := loader.LoadFile(filepath.Join(chartRoot, "charts", "local-subchart-0.1.0.tgz"))
+	if err != nil {
+		updated, err = loader.LoadDir(filepath.Join(chartRoot, "charts", "local-subchart"))
+	}
+	if err != nil {
+		t.Fatalf("dependency update did not install the requested chart: %v", err)
+	}
+	if updated.Metadata.Version != "0.1.0" {
+		t.Errorf("installed dependency version = %q, want %q", updated.Metadata.Version, "0.1.0")
+	}
+}
