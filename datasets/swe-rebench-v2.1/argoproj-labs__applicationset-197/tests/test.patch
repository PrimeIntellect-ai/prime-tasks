+func TestApplicationSetCRDShortNamesInInstallManifests(t *testing.T) {
+	// Each installable ApplicationSet CRD must expose both short names.
+	manifests := []string{
+		filepath.Join("..", "..", "manifests", "crds", "argoproj.io_applicationsets.yaml"),
+		filepath.Join("..", "..", "manifests", "install.yaml"),
+		filepath.Join("..", "..", "manifests", "install-with-argo-cd.yaml"),
+	}
+
+	for _, manifestPath := range manifests {
+		t.Run(filepath.Base(manifestPath), func(t *testing.T) {
+			data, err := ioutil.ReadFile(manifestPath)
+			if !assert.NoError(t, err, "unable to read manifest %s", manifestPath) {
+				return
+			}
+
+			decoder := utilyaml.NewYAMLOrJSONDecoder(bytes.NewReader(data), 4096)
+			found := false
+			for {
+				var resource struct {
+					Kind     string `json:"kind"`
+					Metadata struct {
+						Name string `json:"name"`
+					} `json:"metadata"`
+					Spec struct {
+						Names struct {
+							ShortNames []string `json:"shortNames"`
+						} `json:"names"`
+					} `json:"spec"`
+				}
+				err := decoder.Decode(&resource)
+				if err == io.EOF {
+					break
+				}
+				if !assert.NoError(t, err, "unable to decode manifest %s", manifestPath) {
+					return
+				}
+				if resource.Kind != "CustomResourceDefinition" || resource.Metadata.Name != "applicationsets.argoproj.io" {
+					continue
+				}
+				found = true
+				assert.Contains(t, resource.Spec.Names.ShortNames, "appset")
+				assert.Contains(t, resource.Spec.Names.ShortNames, "appsets")
+			}
+			assert.True(t, found, "manifest %s must include the ApplicationSet CRD", manifestPath)
+		})
+	}
+}
