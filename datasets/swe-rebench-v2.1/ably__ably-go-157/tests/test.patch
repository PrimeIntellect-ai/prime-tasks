+// TestIssue_154_RetriesOn5xxWithUnparseableBody verifies that a response with
+// an HTTP status code in the 500-504 range is retried even when its body cannot
+// be parsed as a protocol error (e.g. an HTML error page), as required by RSC15d.
+func TestIssue_154_RetriesOn5xxWithUnparseableBody(t *testing.T) {
+	for _, status := range []int{
+		http.StatusInternalServerError, // 500
+		http.StatusNotImplemented,      // 501
+		http.StatusBadGateway,          // 502
+		http.StatusServiceUnavailable,  // 503
+		http.StatusGatewayTimeout,      // 504
+	} {
+		status := status
+		t.Run(strconv.Itoa(status), func(t *testing.T) {
+			var requests int32
+			server := httptest.NewServer(http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+				n := atomic.AddInt32(&requests, 1)
+				if n == 1 {
+					rw.Header().Set("Content-Type", "text/html")
+					rw.WriteHeader(status)
+					rw.Write([]byte("<html><body>cloudfront error</body></html>"))
+					return
+				}
+				rw.Header().Set("Content-Type", "application/json")
+				rw.WriteHeader(http.StatusOK)
+				rw.Write([]byte("[1234567890000]"))
+			}))
+			defer server.Close()
+
+			endpointURL, err := url.Parse(server.URL)
+			assert.Nil(t, err)
+			opts := ably.NewClientOptions("xxxxxxx.yyyyyyy:zzzzzzz")
+			opts.NoTLS = true
+			opts.UseTokenAuth = true
+			opts.RestHost = endpointURL.Hostname()
+			port, _ := strconv.ParseInt(endpointURL.Port(), 10, 0)
+			opts.Port = int(port)
+			opts.FallbackHosts = []string{endpointURL.Host}
+			client, e := ably.NewRestClient(opts)
+			assert.Nil(t, e)
+
+			_, err = client.Time()
+			assert.Nil(t, err, "expected the client to retry the %d response and succeed", status)
+			assert.GreaterOrEqual(t, atomic.LoadInt32(&requests), int32(2), "expected the client to retry the %d response", status)
+		})
+	}
+}
