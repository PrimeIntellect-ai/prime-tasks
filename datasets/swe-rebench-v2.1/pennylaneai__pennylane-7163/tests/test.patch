+class TestMPLClassicalWireReuse:
+    """Tests that the MPL drawer reuses classical wire lines for non-overlapping MCMs."""
+
+    def test_reuse_cwire_lines(self):
+        """Adding another non-overlapping MCM usage should not add vertical whitespace."""
+
+        with qml.queuing.AnnotatedQueue() as q:
+            qml.Identity(2)
+            qml.Identity(3)
+            m0 = qml.measure(0)
+            qml.cond(m0, qml.PauliX)(1)
+        single_usage_tape = qml.tape.QuantumScript.from_queue(q)
+
+        with qml.queuing.AnnotatedQueue() as q:
+            qml.Identity(2)
+            qml.Identity(3)
+            m0 = qml.measure(0)
+            qml.cond(m0, qml.PauliX)(1)
+            m1 = qml.measure(2)
+            qml.cond(m1, qml.PauliX)(3)
+        multiple_usage_tape = qml.tape.QuantumScript.from_queue(q)
+
+        _, single_usage_ax = qml.drawer.tape_mpl(single_usage_tape)
+        _, multiple_usage_ax = qml.drawer.tape_mpl(multiple_usage_tape)
+
+        single_usage_height = single_usage_ax.dataLim.height
+        multiple_usage_height = multiple_usage_ax.dataLim.height
+        assert pnp.isclose(single_usage_height, multiple_usage_height)
+
