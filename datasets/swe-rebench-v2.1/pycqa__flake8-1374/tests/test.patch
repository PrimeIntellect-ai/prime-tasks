+def test_syntax_error_is_reported_at_source_location(tmpdir, capsys):
+    """Checking malformed source reports a diagnostic rather than crashing."""
+    with tmpdir.as_cwd():
+        tmpdir.join("t.py").write("x = 1\nthis is not valid:\n")
+
+        with pytest.raises(SystemExit):
+            cli.main(["t.py"])
+
+    out, _ = capsys.readouterr()
+    assert "t.py:2:" in out
