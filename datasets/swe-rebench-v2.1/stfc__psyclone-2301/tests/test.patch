+def test_parallel_validation_of_safe_lfric_loops(dist_mem):
+    """LFRic loops over dofs and single-colour cells can be parallelised."""
+    _, invoke_info = parse(os.path.join(
+        BASE_PATH, "1_single_invoke.f90"), api=TEST_API)
+    psy = PSyFactory(TEST_API, distributed_memory=dist_mem).create(invoke_info)
+    schedule = psy.invokes.invoke_list[0].schedule
+    loop = schedule.walk(DynLoop)[0]
+
+    # A loop over the cells of one colour is safe even for writes to
+    # continuous fields. Rename its induction variable to ensure this is not
+    # tied to a particular fixture name.
+    Dynamo0p3ColourTrans().apply(loop)
+    cell_loop = schedule.walk(DynLoop)[1]
+    schedule.symbol_table.rename_symbol(
+        cell_loop.variable, "cell_index")
+    assert cell_loop.independent_iterations()
+    OMPLoopTrans().validate(cell_loop)
+
+    # A dof loop is also safe. Use a different induction-variable name from
+    # the fixture's conventional name.
+    _, invoke_info = parse(os.path.join(
+        BASE_PATH, "15.1.6_aX_plus_bY_builtin.f90"), api=TEST_API)
+    psy = PSyFactory(TEST_API, distributed_memory=dist_mem).create(invoke_info)
+    schedule = psy.invokes.invoke_list[0].schedule
+    dof_loop = schedule.walk(DynLoop)[0]
+    schedule.symbol_table.rename_symbol(
+        dof_loop.variable, "dof_index")
+    assert dof_loop.independent_iterations()
+    OMPLoopTrans().validate(dof_loop)
+
+
+def test_parallel_validation_of_discontinuous_field_loop(dist_mem):
+    """A discontinuous-space field write is safe in an uncoloured cell loop."""
+    _, invoke_info = parse(os.path.join(
+        BASE_PATH, "1_single_invoke_any_discontinuous_space.f90"),
+        api=TEST_API)
+    psy = PSyFactory(TEST_API, distributed_memory=dist_mem).create(invoke_info)
+    schedule = psy.invokes.invoke_list[0].schedule
+    loop = schedule.walk(DynLoop)[0]
+    schedule.symbol_table.rename_symbol(
+        loop.variable, "cell_index")
+    OMPLoopTrans().validate(loop)
+
+
+def test_parallel_validation_of_continuous_field_write_requires_colouring(
+        dist_mem):
+    """An uncoloured continuous-field write cannot be parallelised."""
+    _, invoke_info = parse(os.path.join(
+        BASE_PATH, "1_single_invoke.f90"), api=TEST_API)
+    psy = PSyFactory(TEST_API,
+                     distributed_memory=dist_mem).create(invoke_info)
+    schedule = psy.invokes.invoke_list[0].schedule
+    loop = schedule.walk(DynLoop)[0]
+    assert not loop.independent_iterations()
+
+    with pytest.raises(TransformationError):
+        DynamoOMPParallelLoopTrans().apply(loop)
