+(defn- write-qual-field
+  "Writes a single variant with the given QUAL and returns the written QUAL column."
+  [qual]
+  (let [meta-info {:info [] :format []}
+        header ["CHROM" "POS" "ID" "REF" "ALT" "QUAL" "FILTER" "INFO"]]
+    (with-open [sw (StringWriter.)
+                bw (BufferedWriter. sw)
+                w (VCFWriter. nil bw meta-info header)]
+      (vcf-writer/write-variants w [{:chr "1", :pos 1, :ref "T", :alt ["A"], :qual qual}])
+      (.flush bw)
+      (nth (cstr/split (str sw) #"\t") 5))))
+
+(deftest write-variants-qual
+  (testing "QUAL values within the usual range keep their plain representation"
+    (is (= (write-qual-field 10.0) "10"))
+    (is (= (write-qual-field 9.6) "9.6"))
+    (is (= (write-qual-field nil) ".")))
+  (testing "QUAL values outside the Integer range are written without overflow and keep their value"
+    (doseq [q [6e9 3e9 1.5e12 2.5e10 5.60878e+09 1.0E7 9.999999E6 8388608.0]]
+      (is (== q (Double/parseDouble (write-qual-field q)))
+          (str "QUAL " q " should round-trip through the written record")))))
 
