+    @staticmethod
+    def _enclosing_if_guard(qasm, statement):
+        """Return the text of the innermost enclosing ``if`` condition guarding ``statement``.
+
+        Returns ``None`` if the statement is not inside any ``if`` block.  This is a purely
+        behavioural check on the emitted OpenQASM 3 and does not depend on the exact formatting
+        or condition spelling chosen by the exporter.
+        """
+        stack = []
+        for line in qasm.splitlines():
+            stripped = line.strip()
+            if stripped.endswith("{"):
+                stack.append(stripped[:-1].strip())
+            elif stripped == "}":
+                if stack:
+                    stack.pop()
+            elif statement in stripped:
+                for guard in reversed(stack):
+                    if guard.startswith("if"):
+                        return guard
+                return None
+        return None
+
+    def test_unusual_conditions(self):
+        """Test that special QASM constructs such as ``measure`` are correctly handled when the
+        Terra instructions have old-style conditions."""
+        qc = QuantumCircuit(3, 2)
+        qc.h(0)
+        qc.measure(0, 0)
+        qc.measure(1, 1).c_if(0, True)
+        qasm = dumps(qc)
+
+        measurement_statements = [
+            line.strip() for line in qasm.splitlines() if re.search(r"=\s*measure\b", line)
+        ]
+        measurement_guards = [
+            self._enclosing_if_guard(qasm, statement) for statement in measurement_statements
+        ]
+        self.assertEqual(len(measurement_guards), 2)
+        # The unconditional measurement must remain outside a conditional block.
+        self.assertIsNone(measurement_guards[0])
+        # The conditional measurement must be emitted inside a conditional block.
+        self.assertIsNotNone(measurement_guards[1])
+
 
