+func TestResourceByDescriptorEachTimeSeries(t *testing.T) {
+	start := time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC)
+	end := start.Add(time.Second)
+	metric := &metricdata.Metric{
+		Descriptor: metricdata.Descriptor{
+			Name: "per_series_resource",
+			Type: metricdata.TypeCumulativeInt64,
+			LabelKeys: []metricdata.LabelKey{
+				{Key: "host"},
+				{Key: "remaining"},
+			},
+		},
+		TimeSeries: []*metricdata.TimeSeries{
+			{StartTime: start, LabelValues: []metricdata.LabelValue{{Value: "host-a"}, {Value: "metric-a"}}, Points: []metricdata.Point{{Time: end, Value: int64(1)}}},
+			{StartTime: start, LabelValues: []metricdata.LabelValue{{Value: "host-b"}, {Value: "metric-b"}}, Points: []metricdata.Point{{Time: end, Value: int64(2)}}},
+			{StartTime: start, LabelValues: []metricdata.LabelValue{{Value: "fallback"}, {Value: "metric-c"}}, Points: []metricdata.Point{{Time: end, Value: int64(3)}}},
+		},
+	}
+
+	options := optionsWithResourceByDescriptor(t, func(md *metricdata.Descriptor, labels map[string]string) (map[string]string, monitoredresource.Interface) {
+		if md.Name != "per_series_resource" {
+			t.Errorf("callback received descriptor %q", md.Name)
+		}
+		if labels["host"] == "fallback" {
+			return map[string]string{"remaining": labels["remaining"]}, &customResource{
+				rt: "",
+				rm: map[string]string{"host": labels["host"]},
+			}
+		}
+		return map[string]string{"remaining": labels["remaining"]}, &customResource{
+			rt: "host_resource",
+			rm: map[string]string{"host": labels["host"]},
+		}
+	})
+	requests := exportMetricsForTest(t, options, metric)
+	var got []*monitoringpb.TimeSeries
+	for _, request := range requests {
+		got = append(got, request.TimeSeries...)
+	}
+	if len(got) != len(metric.TimeSeries) {
+		t.Fatalf("got %d time series, want %d", len(got), len(metric.TimeSeries))
+	}
+	wantByHost := map[string]string{"host-a": "metric-a", "host-b": "metric-b"}
+	seenHosts := make(map[string]bool)
+	seenFallback := false
+	for _, series := range got {
+		labels := series.Metric.Labels
+		if len(labels) != 1 {
+			t.Errorf("metric labels = %#v, want only the remaining label", labels)
+		}
+		switch series.Resource.GetType() {
+		case "host_resource":
+			host := series.Resource.Labels["host"]
+			wantLabel, ok := wantByHost[host]
+			if !ok {
+				t.Errorf("unexpected host resource labels: %#v", series.Resource.Labels)
+				continue
+			}
+			if seenHosts[host] {
+				t.Errorf("more than one time series for host %q", host)
+			}
+			seenHosts[host] = true
+			if labels["remaining"] != wantLabel {
+				t.Errorf("host %q has remaining metric label %q, want %q", host, labels["remaining"], wantLabel)
+			}
+		case "global":
+			if seenFallback {
+				t.Error("more than one time series used the global fallback resource")
+			}
+			seenFallback = true
+			if len(series.Resource.Labels) != 0 {
+				t.Errorf("empty resource type produced global resource labels %#v, want none", series.Resource.Labels)
+			}
+			if labels["remaining"] != "metric-c" {
+				t.Errorf("fallback metric labels = %#v, want remaining=metric-c", labels)
+			}
+		default:
+			t.Errorf("unexpected resource type %q", series.Resource.GetType())
+		}
+	}
+	if len(seenHosts) != len(wantByHost) || !seenFallback {
+		t.Errorf("observed resources for hosts %v and global fallback %v, want both hosts and the fallback", seenHosts, seenFallback)
+	}
+}
