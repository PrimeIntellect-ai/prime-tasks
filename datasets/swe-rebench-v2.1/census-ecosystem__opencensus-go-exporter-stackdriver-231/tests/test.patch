+func exportMetricsForTest(t *testing.T, options Options, metrics ...*metricdata.Metric) []*monitoringpb.CreateTimeSeriesRequest {
+	t.Helper()
+	server, addr, done := createFakeServer(t)
+	defer done()
+	conn, err := grpc.Dial(addr, grpc.WithInsecure())
+	if err != nil {
+		t.Fatalf("could not connect to fake monitoring service: %v", err)
+	}
+	defer conn.Close()
+	options.MonitoringClientOptions = []option.ClientOption{option.WithGRPCConn(conn)}
+	options.TraceClientOptions = []option.ClientOption{option.WithGRPCConn(conn)}
+	exporter, err := NewExporter(options)
+	if err != nil {
+		t.Fatalf("could not create exporter: %v", err)
+	}
+	if err := exporter.ExportMetrics(context.Background(), metrics); err != nil {
+		t.Fatalf("could not export metrics: %v", err)
+	}
+	exporter.Flush()
+	var requests []*monitoringpb.CreateTimeSeriesRequest
+	server.forEachStackdriverTimeSeries(func(request *monitoringpb.CreateTimeSeriesRequest) {
+		requests = append(requests, request)
+	})
+	return requests
+}
+
+func optionsWithResourceByDescriptor(t *testing.T, callback func(*metricdata.Descriptor, map[string]string) (map[string]string, monitoredresource.Interface)) Options {
+	t.Helper()
+	options := Options{ProjectID: "foo", DefaultMonitoringLabels: &Labels{}}
+	field := reflect.ValueOf(&options).Elem().FieldByName("ResourceByDescriptor")
+	wantType := reflect.TypeOf(callback)
+	if !field.IsValid() {
+		t.Fatal("Options does not expose ResourceByDescriptor")
+	}
+	if field.Type() != wantType {
+		t.Fatalf("Options.ResourceByDescriptor has type %v, want %v", field.Type(), wantType)
+	}
+	field.Set(reflect.ValueOf(callback))
+	return options
+}
