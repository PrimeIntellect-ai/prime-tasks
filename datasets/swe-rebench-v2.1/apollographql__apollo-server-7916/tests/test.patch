+import { ApolloServer, HeaderMap } from '@apollo/server';
+import type { ApolloServerPlugin } from '@apollo/server';
+import { describe, it, expect } from '@jest/globals';
+import assert from 'assert';
+
+// `ApolloServerPluginDisableSuggestions` is a public entry point of the
+// package. It is loaded dynamically so that the option-based tests can still
+// run against a build that does not provide it.
+async function loadDisableSuggestionsPlugin(): Promise<ApolloServerPlugin> {
+  const modulePath = '@apollo/server/plugin/disableSuggestions';
+  const { ApolloServerPluginDisableSuggestions } = await import(modulePath);
+  return ApolloServerPluginDisableSuggestions();
+}
+
+describe('ApolloServerPluginDisableSuggestions', () => {
+  async function makeServer({
+    withPlugin,
+    query,
+    plugins,
+  }: {
+    withPlugin?: boolean;
+    query: string;
+    plugins?: ApolloServerPlugin[];
+  }) {
+    const server = new ApolloServer({
+      typeDefs: 'type Query {hello: String}',
+      resolvers: {
+        Query: {
+          hello() {
+            return 'asdf';
+          },
+        },
+      },
+      ...(withPlugin === undefined
+        ? {}
+        : { hideSchemaDetailsFromClientErrors: withPlugin }),
+      ...(plugins ? { plugins } : {}),
+    });
+
+    await server.start();
+
+    try {
+      return await server.executeHTTPGraphQLRequest({
+        httpGraphQLRequest: {
+          method: 'POST',
+          headers: new HeaderMap([['apollo-require-preflight', 't']]),
+          search: '',
+          body: {
+            query,
+          },
+        },
+        context: async () => ({}),
+      });
+    } finally {
+      await server.stop();
+    }
+  }
+
+  function errorMessage(response: Awaited<ReturnType<typeof makeServer>>) {
+    assert(response.body.kind === 'complete');
+    return JSON.parse(response.body.string).errors[0].message as string;
+  }
+
+  it('should not hide suggestions when plugin is not enabled', async () => {
+    const response = await makeServer({
+      withPlugin: false,
+      query: `#graphql
+            query {
+              help
+            }
+          `,
+    });
+
+    expect(errorMessage(response)).toContain('Did you mean');
+  });
+
+  it('should show suggestions when the option is omitted', async () => {
+    const response = await makeServer({
+      query: `#graphql
+            query {
+              help
+            }
+          `,
+    });
+
+    expect(errorMessage(response)).toContain('Did you mean');
+  });
+
+  it('should show suggestions by default in production', async () => {
+    const originalNodeEnv = process.env.NODE_ENV;
+    process.env.NODE_ENV = 'production';
+
+    try {
+      const query = `#graphql
+            query {
+              help
+            }
+          `;
+      const response = await makeServer({ query });
+      const responseWithExplicitFalse = await makeServer({
+        withPlugin: false,
+        query,
+      });
+
+      expect(errorMessage(response)).toContain('Did you mean');
+      expect(errorMessage(responseWithExplicitFalse)).toContain('Did you mean');
+    } finally {
+      if (originalNodeEnv === undefined) {
+        delete process.env.NODE_ENV;
+      } else {
+        process.env.NODE_ENV = originalNodeEnv;
+      }
+    }
+  });
+
+  it('should hide suggestions when plugin is enabled', async () => {
+    const response = await makeServer({
+      withPlugin: true,
+      query: `#graphql
+            query {
+              help
+            }
+          `,
+    });
+
+    const message = errorMessage(response);
+    expect(message).not.toContain('Did you mean');
+    expect(message).toContain('Cannot query field "help" on type "Query".');
+  });
+
+  it('should hide suggestions when the disable-suggestions plugin is installed explicitly', async () => {
+    const response = await makeServer({
+      query: `#graphql
+            query {
+              help
+            }
+          `,
+      plugins: [await loadDisableSuggestionsPlugin()],
+    });
+
+    const message = errorMessage(response);
+    expect(message).not.toContain('Did you mean');
+    expect(message).toContain('Cannot query field "help" on type "Query".');
+  });
+
+  it('should hide suggestions when the option is enabled and the plugin is also installed explicitly', async () => {
+    const response = await makeServer({
+      withPlugin: true,
+      query: `#graphql
+            query {
+              help
+            }
+          `,
+      plugins: [await loadDisableSuggestionsPlugin()],
+    });
+
+    const message = errorMessage(response);
+    expect(message).not.toContain('Did you mean');
+    expect(message).toContain('Cannot query field "help" on type "Query".');
+  });
+});
