+
+// https://github.com/gleam-lang/gleam/issues/3879
+#[test]
+fn use_list_and_bit_array_inexhaustive_assignments_report_diagnostics_in_errors_module() {
+    let source = "\nuse [1, 2, 3] <- todo\nuse <<var:8>> <- todo\ntodo\n";
+    let (errors, names) = crate::type_::tests::compile_statement_sequence(source)
+        .expect_err("inexhaustive use patterns should be rejected");
+    let error = crate::error::Error::Type {
+        names,
+        src: source.into(),
+        path: camino::Utf8PathBuf::from("/src/one/two.gleam"),
+        errors,
+    };
+    let diagnostics = error.pretty_string();
+
+    assert_eq!(diagnostics.matches("error: Inexhaustive pattern").count(), 2);
+    assert!(diagnostics.contains(
+        "This assignment uses a pattern that does not match all possible values. If\none of the other values is used then the assignment will crash."
+    ));
+    assert!(diagnostics.contains(
+        "    []\n    [_, _, _, _, ..]\n    [_, _, _]\n    [_, _]\n    [_]"
+    ));
+    assert!(diagnostics.contains("2 │ use [1, 2, 3] <- todo"));
+    assert!(diagnostics.contains("3 │ use <<var:8>> <- todo"));
+    assert!(diagnostics.contains("The missing patterns are:\n\n    _"));
+    assert!(diagnostics.contains("Hint: Use a more general pattern or use `let assert` instead."));
+}
