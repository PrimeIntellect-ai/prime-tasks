@@ -0,0 +1,73 @@
+use itertools::{assert_equal, Itertools};
+use std::{ops::Range, vec::IntoIter};
+
+fn mix_data() -> IntoIter<Result<Range<i32>, bool>> {
+    vec![Ok(0..2), Err(false), Ok(2..4), Err(true), Ok(4..6)].into_iter()
+}
+
+fn ok_data() -> IntoIter<Result<Range<i32>, bool>> {
+    vec![Ok(0..2), Ok(2..4), Ok(4..6)].into_iter()
+}
+
+#[test]
+fn flatten_ok_mixed_expected_forward() {
+    assert_equal(
+        mix_data().flatten_ok(),
+        vec![
+            Ok(0),
+            Ok(1),
+            Err(false),
+            Ok(2),
+            Ok(3),
+            Err(true),
+            Ok(4),
+            Ok(5),
+        ],
+    );
+}
+
+#[test]
+fn flatten_ok_collect_mixed_forward() {
+    assert_eq!(
+        mix_data().flatten_ok().collect::<Result<Vec<_>, _>>(),
+        Err(false)
+    );
+}
+
+#[test]
+fn flatten_ok_collect_ok_forward() {
+    assert_eq!(
+        ok_data().flatten_ok().collect::<Result<Vec<_>, _>>(),
+        Ok((0..6).collect())
+    );
+}
+
+#[test]
+fn flatten_ok_accepts_non_range_success_values() {
+    let input = vec![
+        Ok(vec!["first", "second"]),
+        Err("problem"),
+        Ok(vec!["third"]),
+    ];
+
+    assert_equal(
+        input.into_iter().flatten_ok(),
+        vec![Ok("first"), Ok("second"), Err("problem"), Ok("third")],
+    );
+}
+
+#[test]
+fn flatten_ok_empty_success_does_not_stop_outer_iteration() {
+    let input = vec![
+        Ok(Vec::<i32>::new()),
+        Err(false),
+        Ok(vec![1, 2]),
+        Ok(Vec::new()),
+        Err(true),
+    ];
+
+    assert_equal(
+        input.into_iter().flatten_ok(),
+        vec![Err(false), Ok(1), Ok(2), Err(true)],
+    );
+}
