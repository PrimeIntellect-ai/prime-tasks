+def test_modules_are_not_collected_twice(runner, tmp_path):
+    """See #624."""
+    tmp_path.joinpath("task_module.py").write_text("def task_example(): pass")
+    tmp_path.joinpath("pyproject.toml").write_text(
+        "[tool.pytask.ini_options]\npaths = ['.', '.']"
+    )
+    result = runner.invoke(cli, [tmp_path.as_posix()])
+    assert "Collected 1 task" in result.output
+
+
+def test_task_in_overlapping_paths_is_collected_once(runner, tmp_path):
+    nested = tmp_path / "nested"
+    nested.mkdir()
+    nested.joinpath("task_module.py").write_text(
+        "from pathlib import Path\n\ndef task_example(produces=Path('result.txt')):\n    produces.write_text('done')"
+    )
+    tmp_path.joinpath("pyproject.toml").write_text(
+        "[tool.pytask.ini_options]\npaths = ['.', 'nested']"
+    )
+
+    result = runner.invoke(cli, [tmp_path.as_posix()])
+
+    assert "Collected 1 task" in result.output
+
+
