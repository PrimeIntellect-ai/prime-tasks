+test_that("debugme reapplies the current DEBUGME setting", {
+  env <- new.env()
+  env$log_message <- function() { "!DEBUG toggle" }
+
+  withr::with_envvar(c(DEBUGME = ""), {
+    debugme(env, pkg = "toggle_pkg")
