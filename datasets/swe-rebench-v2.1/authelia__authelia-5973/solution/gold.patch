+func (a *Address) validateFD() (err error) {
+	var actualFD uint64
+
+	if actualFD, err = strconv.ParseUint(a.url.Host, 10, 64); err != nil {
+		return fmt.Errorf("failed to parse file descriptor: %w", err)
+	}
+
+	umask := -1
+
