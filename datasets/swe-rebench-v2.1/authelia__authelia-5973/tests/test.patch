+func TestAddress_FileDescriptorListener(t *testing.T) {
+	opened, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+
+	defer opened.Close()
+
+	file, err := opened.(*net.TCPListener).File()
+	require.NoError(t, err)
+
+	defer file.Close()
+
+	address, err := NewAddress(fmt.Sprintf("fd://%d", file.Fd()))
+	require.NoError(t, err)
+
+	ln, err := address.Listener()
+	require.NoError(t, err)
+
+	defer ln.Close()
+
+	assert.Equal(t, opened.Addr().String(), ln.Addr().String())
+
+	conn, err := net.Dial("tcp", ln.Addr().String())
+	require.NoError(t, err)
+
+	defer conn.Close()
+
+	accepted, err := ln.Accept()
+	require.NoError(t, err)
+	assert.NoError(t, accepted.Close())
+}
