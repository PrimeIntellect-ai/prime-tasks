+func TestServerAddressCanListenOnInheritedFileDescriptor(t *testing.T) {
+	opened, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	tcpListener := opened.(*net.TCPListener)
+	file, err := tcpListener.File()
+	require.NoError(t, err)
+	defer file.Close()
+
+	addressValue := fmt.Sprintf("fd://%d", file.Fd())
+	address, err := schema.NewAddress(addressValue)
+	require.NoError(t, err)
+	listener, err := address.Listener()
+	require.NoError(t, err)
+	defer listener.Close()
+	defer opened.Close()
+
+	assert.Equal(t, opened.Addr().String(), listener.Addr().String())
+	connection, err := net.Dial(listener.Addr().Network(), listener.Addr().String())
+	require.NoError(t, err)
+	defer connection.Close()
+
+	accepted, err := listener.Accept()
+	require.NoError(t, err)
+	assert.NoError(t, accepted.Close())
+}
