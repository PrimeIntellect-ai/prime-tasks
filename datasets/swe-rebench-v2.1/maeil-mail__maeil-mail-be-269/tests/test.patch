+package maeilwiki.mutiplechoice.domain;
+
+import static org.assertj.core.api.SoftAssertions.assertSoftly;
+
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+import java.util.List;
+import java.util.UUID;
+import jakarta.persistence.EntityManager;
+import maeilwiki.member.domain.Member;
+import maeilwiki.member.domain.MemberRepository;
+import maeilwiki.support.IntegrationTestSupport;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageRequest;
+import org.springframework.data.domain.Pageable;
+import org.springframework.transaction.support.TransactionTemplate;
+
+class WorkbookRepositoryTest extends IntegrationTestSupport {
+
+    @Autowired
+    private WorkbookRepository workbookRepository;
+
+    @Autowired
+    private MemberRepository memberRepository;
+
+    @Autowired
+    private EntityManager entityManager;
+
+    @Autowired
+    private TransactionTemplate txTemplate;
+
+    @Test
+    @DisplayName("카테고리에 해당하는 문제집 페이지를 id 기준 내림차순으로 조회한다.")
+    void pageByCategory() {
+        Member member = createMember();
+        Workbook backendWorkbook1 = createWorkbook(member, "backend");
+        Workbook backendWorkbook2 = createWorkbook(member, "backend");
+        Workbook backendWorkbook3 = createWorkbook(member, "backend");
+        Workbook backendWorkbook4 = createWorkbook(member, "backend");
+        Workbook frontendWorkbook1 = createWorkbook(member, "frontend");
+        Workbook frontendWorkbook2 = createWorkbook(member, "frontend");
+        createQuestions(backendWorkbook1, 1);
+        createQuestions(backendWorkbook2, 2);
+        createQuestions(backendWorkbook3, 3);
+        createQuestions(backendWorkbook4, 4);
+        Pageable pageable = PageRequest.of(0, 2);
+
+        Page<?> workbookSummaryPage = pageByCategory("BACKEND", pageable);
+
+        assertSoftly(softAssertions -> {
+            Object firstResult = workbookSummaryPage.getContent().get(0);
+            softAssertions.assertThat(firstResult.getClass().isRecord()).isTrue();
+            softAssertions.assertThat(Modifier.isPublic(firstResult.getClass().getModifiers())).isTrue();
+            softAssertions.assertThat(workbookSummaryPage.getTotalElements()).isEqualTo(4);
+            softAssertions.assertThat(workbookSummaryPage.getTotalPages()).isEqualTo(2);
+            softAssertions.assertThat(workbookSummaryPage.getSize()).isEqualTo(2);
+            softAssertions.assertThat(workbookId(workbookSummaryPage.getContent().get(0))).isEqualTo(backendWorkbook4.getId());
+            softAssertions.assertThat(questionCount(workbookSummaryPage.getContent().get(0))).isEqualTo(4);
+            softAssertions.assertThat(workbookId(workbookSummaryPage.getContent().get(1))).isEqualTo(backendWorkbook3.getId());
+            softAssertions.assertThat(questionCount(workbookSummaryPage.getContent().get(1))).isEqualTo(3);
+        });
+    }
+
+    @Test
+    @DisplayName("카테고리가 all 이면 모든 카테고리의 문제집 페이지를 조회한다.")
+    void pageByDefaultCategory() {
+        Member member = createMember();
+        Workbook backendWorkbook1 = createWorkbook(member, "backend");
+        Workbook backendWorkbook2 = createWorkbook(member, "backend");
+        Workbook backendWorkbook3 = createWorkbook(member, "backend");
+        Workbook backendWorkbook4 = createWorkbook(member, "backend");
+        Workbook frontendWorkbook1 = createWorkbook(member, "frontend");
+        Workbook frontendWorkbook2 = createWorkbook(member, "frontend");
+        createQuestions(backendWorkbook1, 1);
+        createQuestions(backendWorkbook2, 2);
+        createQuestions(backendWorkbook3, 3);
+        createQuestions(backendWorkbook4, 4);
+        createQuestions(frontendWorkbook1, 1);
+        createQuestions(frontendWorkbook2, 2);
+        Pageable pageable = PageRequest.of(0, 3);
+
+        Page<?> workbookSummaryPage = pageByCategory("all", pageable);
+
+        assertSoftly(softAssertions -> {
+            softAssertions.assertThat(workbookSummaryPage.getTotalElements()).isEqualTo(6);
+            softAssertions.assertThat(workbookSummaryPage.getTotalPages()).isEqualTo(2);
+            softAssertions.assertThat(workbookSummaryPage.getSize()).isEqualTo(3);
+            softAssertions.assertThat(workbookId(workbookSummaryPage.getContent().get(0))).isEqualTo(frontendWorkbook2.getId());
+            softAssertions.assertThat(questionCount(workbookSummaryPage.getContent().get(0))).isEqualTo(2);
+            softAssertions.assertThat(workbookId(workbookSummaryPage.getContent().get(1))).isEqualTo(frontendWorkbook1.getId());
+            softAssertions.assertThat(questionCount(workbookSummaryPage.getContent().get(1))).isEqualTo(1);
+            softAssertions.assertThat(workbookId(workbookSummaryPage.getContent().get(2))).isEqualTo(backendWorkbook4.getId());
+            softAssertions.assertThat(questionCount(workbookSummaryPage.getContent().get(2))).isEqualTo(4);
+        });
+    }
+
+    private Page<?> pageByCategory(String category, Pageable pageable) {
+        try {
+            Method method = WorkbookRepository.class.getMethod("pageByCategory", String.class, Pageable.class);
+            return (Page<?>) method.invoke(workbookRepository, category, pageable);
+        } catch (ReflectiveOperationException e) {
+            throw new AssertionError("pageByCategory(String, Pageable) is not available", e);
+        }
+    }
+
+    private Long workbookId(Object workbookSummaryWithQuestionCount) {
+        try {
+            Method workbookSummaryMethod = workbookSummaryWithQuestionCount.getClass().getMethod("workbookSummary");
+            Object workbookSummary = workbookSummaryMethod.invoke(workbookSummaryWithQuestionCount);
+            Method idMethod = workbookSummary.getClass().getMethod("id");
+            return (Long) idMethod.invoke(workbookSummary);
+        } catch (ReflectiveOperationException e) {
+            throw new AssertionError("workbookSummary().id() is not available", e);
+        }
+    }
+
+    private Long questionCount(Object workbookSummaryWithQuestionCount) {
+        try {
+            Method method = workbookSummaryWithQuestionCount.getClass().getMethod("questionCount");
+            return (Long) method.invoke(workbookSummaryWithQuestionCount);
+        } catch (ReflectiveOperationException e) {
+            throw new AssertionError("questionCount() is not available", e);
+        }
+    }
+
+    private Member createMember() {
+        Member member = new Member(UUID.randomUUID().toString(), UUID.randomUUID().toString(), "GITHUB");
+        member.setRefreshToken(UUID.randomUUID().toString());
+
+        return memberRepository.save(member);
+    }
+
+    private Workbook createWorkbook(Member member, String category) {
+        Workbook workbook = new Workbook("title", 4, category, "detail", 5, member);
+
+        return workbookRepository.save(workbook);
+    }
+
+    private WorkbookQuestion createQuestion(Workbook workbook) {
+        WorkbookQuestion workbookQuestion = new WorkbookQuestion("title", "explanation", workbook);
+
+        return save(workbookQuestion);
+    }
+
+    private void createQuestions(Workbook workbook, int times) {
+        for (int i = 0; i < times; i++) {
+            createQuestion(workbook);
+        }
+    }
+
+    private <T> T save(T entity) {
+        txTemplate.executeWithoutResult(it -> entityManager.persist(entity));
+
+        return entity;
+    }
+}
