+        request.getAsJsonArray("title")[0].asJsonObject
+            .getAsJsonObject("text").get("content").asString)
+    val properties = request.getAsJsonObject("properties")
+    assertTrue(properties.getAsJsonObject("Title").has("title"))
+    assertTrue(properties.getAsJsonObject("Description").has("rich_text"))
+  }
