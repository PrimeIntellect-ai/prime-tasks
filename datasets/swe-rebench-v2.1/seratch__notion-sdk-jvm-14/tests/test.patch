+              "Title" to TitlePropertySchema(),
+              "Description" to RichTextPropertySchema())
+      val database =
+          client.createDatabase(DatabaseParent.page("page-id"), titleElements, propertyDefinitions)
+      assertEquals(ObjectType.Database, database.objectType)
+      assertEquals("created-database-id", database.id)
+    }
+    assertEquals("POST", httpClient.method)
+    assertTrue(httpClient.url.endsWith("/databases"))
+    assertTrue(httpClient.body.isNotBlank())
+    val request = JsonParser.parseString(httpClient.body).asJsonObject
+    assertTrue(request.has("parent"))
+    assertTrue(request.has("title"))
+    assertTrue(request.has("properties"))
+    assertEquals("page-id", request.getAsJsonObject("parent").get("page_id").asString)
+    assertEquals(
