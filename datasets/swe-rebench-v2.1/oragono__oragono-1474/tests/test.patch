+func TestHelpRepliesIncludeNick(t *testing.T) {
+	probe, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	addr := probe.Addr().String()
+	probe.Close()
+
+	defaultConfig, err := os.ReadFile("../../default.yaml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	configText := string(defaultConfig)
+	listenerStart := strings.Index(configText, "    # addresses to listen on")
+	listenerEnd := strings.Index(configText, "    # configure the behavior of Tor listeners")
+	if listenerStart < 0 || listenerEnd < listenerStart {
+		t.Fatal("could not prepare an isolated test listener")
+	}
+	configText = configText[:listenerStart] + fmt.Sprintf("    # addresses to listen on\n    listeners:\n        %q:\n\n", addr) + configText[listenerEnd:]
+	configText = strings.Replace(configText, "    path: ircd.db", "    path: "+filepath.Join(t.TempDir(), "ircd.db"), 1)
+	configText = strings.Replace(configText, "    path: languages", "    path: "+filepath.Join("..", "..", "languages"), 1)
+	configPath := filepath.Join(t.TempDir(), "oragono.yaml")
+	if err := os.WriteFile(configPath, []byte(configText), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	config, err := ircserver.LoadConfig(configPath)
+	if err != nil {
+		t.Fatalf("load isolated server config: %v", err)
+	}
+	logManager, err := logger.NewManager(config.Logging)
+	if err != nil {
+		t.Fatalf("initialize logger: %v", err)
+	}
+	server, err := ircserver.NewServer(config, logManager)
+	if err != nil {
+		t.Fatalf("start isolated server: %v", err)
+	}
+	defer server.Shutdown()
+
+	conn, err := net.DialTimeout("tcp", addr, 5*time.Second)
+	if err != nil {
+		t.Fatalf("connect to isolated server: %v", err)
+	}
+	defer conn.Close()
+	if err := conn.SetDeadline(time.Now().Add(10 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	reader := bufio.NewReader(conn)
+	if _, err := fmt.Fprint(conn, "NICK ContractNick\r\nUSER user 0 * :Test User\r\n"); err != nil {
+		t.Fatal(err)
+	}
+
+	registered := false
+	for !registered {
+		line, err := reader.ReadString('\n')
+		if err != nil {
+			t.Fatalf("read registration response: %v", err)
+		}
+		registered = strings.Contains(line, " 001 ContractNick ")
+	}
+	if _, err := fmt.Fprint(conn, "HELP PRIVMSG\r\n"); err != nil {
+		t.Fatal(err)
+	}
+
+	seen := map[string]bool{}
+	for len(seen) < 3 {
+		line, err := reader.ReadString('\n')
+		if err != nil {
+			t.Fatalf("read help replies: %v", err)
+		}
+		fields := strings.Fields(line)
+		if len(fields) < 3 {
+			continue
+		}
+		switch fields[1] {
+		case "704", "705", "706":
+			if fields[2] != "ContractNick" {
+				t.Errorf("help numeric %s addressed to %q, want requesting nick ContractNick; line: %q", fields[1], fields[2], line)
+			}
+			seen[fields[1]] = true
+		}
+	}
