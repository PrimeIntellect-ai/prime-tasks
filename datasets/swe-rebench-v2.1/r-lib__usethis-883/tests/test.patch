diff --git a/tests/testthat/helper.R b/tests/testthat/helper.R
index 3e052c6..206990e 100644
--- a/tests/testthat/helper.R
+++ b/tests/testthat/helper.R
@@ -66,7 +66,8 @@ scoped_temporary_thing <- function(dir = file_temp(pattern = pattern),
   withr::local_options(list(usethis.quiet = TRUE))
   switch(
     thing,
-    package = create_package(dir, rstudio = rstudio, open = FALSE),
+    package = create_package(dir, rstudio = rstudio, open = FALSE,
+                             check_name = FALSE),
     project = create_project(dir, rstudio = rstudio, open = FALSE)
   )
   proj_set(dir)
diff --git a/tests/testthat/test-use-description.R b/tests/testthat/test-use-description.R
index 0cf9c6a..d0882c5 100644
--- a/tests/testthat/test-use-description.R
+++ b/tests/testthat/test-use-description.R
@@ -67,3 +67,43 @@ test_that("default description is tidy", {
   desc_lines_after <- readLines(proj_path("DESCRIPTION"))
   expect_identical(desc_lines_before, desc_lines_after)
 })
+
+test_that("use_description() checks the name by default", {
+  withr::local_options(list(usethis.description = NULL, devtools.desc = NULL))
+  scoped_temporary_package(dir = file_temp(pattern = "invalid_pkg_name"))
+  expect_error(
+    use_description(),
+    "is not a valid package name",
+    class = "usethis_error"
+  )
+})
+
+test_that("use_description() can skip the name check", {
+  withr::local_options(list(usethis.description = NULL, devtools.desc = NULL))
+  scoped_temporary_package(dir = file_temp(pattern = "invalid_pkg_name"))
+  expect_error_free(use_description(check_name = FALSE))
+  expect_proj_file("DESCRIPTION")
+  expect_error(
+    use_description(check_name = TRUE),
+    "is not a valid package name",
+    class = "usethis_error"
+  )
+})
+
+test_that("create_package() checks the name by default", {
+  pkg_path <- file_temp(pattern = "invalid_pkg_name")
+  expect_error(
+    create_package(pkg_path, rstudio = FALSE, open = FALSE),
+    "is not a valid package name",
+    class = "usethis_error"
+  )
+})
+
+test_that("create_package() can skip the name check", {
+  pkg_path <- file_temp(pattern = "invalid_pkg_name")
+  withr::defer(if (dir_exists(pkg_path)) dir_delete(pkg_path))
+  expect_error_free(
+    create_package(pkg_path, rstudio = FALSE, open = FALSE, check_name = FALSE)
+  )
+  expect_true(file_exists(path(pkg_path, "DESCRIPTION")))
+})
