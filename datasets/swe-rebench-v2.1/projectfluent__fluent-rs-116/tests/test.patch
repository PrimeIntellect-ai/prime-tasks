diff --git a/fluent-bundle/tests/bundle_test.rs b/fluent-bundle/tests/bundle_test.rs
index 476eb8f..f6a6261 100644
--- a/fluent-bundle/tests/bundle_test.rs
+++ b/fluent-bundle/tests/bundle_test.rs
@@ -1,5 +1,7 @@
 mod helpers;
 
+use std::collections::HashMap;
+
 use self::helpers::{
     assert_format_no_errors, assert_get_bundle_no_errors, assert_get_resource_from_str_no_errors,
 };
@@ -66,3 +68,36 @@ bar =
     assert_eq!(bundle.has_message("missing"), false);
     assert_eq!(bundle.has_message("-missing"), false);
 }
+
+#[test]
+fn bundle_isolates_interpolated_placeables() {
+    let res = assert_get_resource_from_str_no_errors(
+        "
+foo = Foo
+bar = Foo { $name } bar
+    ",
+    );
+    let mut bundle = fluent_bundle::FluentBundle::new(&["x-testing"]);
+    bundle.add_resource(&res).expect("Failed to add resource.");
+    let mut args = HashMap::new();
+    args.insert("name", "John".into());
+    let (formatted, errors) = bundle
+        .format("bar", Some(&args))
+        .expect("Expected a formatted value.");
+    assert!(errors.is_empty());
+    assert_eq!(formatted, "Foo \u{2068}John\u{2069} bar");
+
+    bundle.set_use_isolating(false);
+    let (formatted, errors) = bundle
+        .format("bar", Some(&args))
+        .expect("Expected a formatted value.");
+    assert!(errors.is_empty());
+    assert_eq!(formatted, "Foo John bar");
+
+    bundle.set_use_isolating(true);
+    let (formatted, errors) = bundle
+        .format("bar", Some(&args))
+        .expect("Expected a formatted value.");
+    assert!(errors.is_empty());
+    assert_eq!(formatted, "Foo \u{2068}John\u{2069} bar");
+}
