+/**
+ * Normalize set values and date-variable representations so equivalent scalar
+ * and array forms compare alike. Literal type metadata is not part of the
+ * public requirements for date-literal IN sets.
+ */
+function normalizeConditionValueShape(query: Query): Query {
+  const clone: any = JSON.parse(JSON.stringify(query));
+  const normalizeNode = (node: any) => {
+    if (!node || typeof node !== 'object') {
+      return;
+    }
+    if (node.left) {
+      normalizeNode(node.left);
+    }
+    if (node.right) {
+      normalizeNode(node.right);
+    }
+    if (node.value !== undefined) {
+      if (typeof node.value === 'string') {
+        node.value = [node.value];
+      }
+      delete node.literalType;
+      if (node.dateLiteralVariable !== undefined) {
+        const variables = Array.isArray(node.dateLiteralVariable) ? node.dateLiteralVariable : [node.dateLiteralVariable];
+        node.dateLiteralVariable = variables.filter((variable: any) => variable !== null && variable !== undefined);
+      }
+    }
+  };
+  if (clone.where) {
+    normalizeNode(clone.where);
+  }
+  if (clone.having) {
+    normalizeNode(clone.having);
+  }
+  return clone;
+}
