+    def test_locale_gets_overridden_by_file(self):
+        buf = StringIO(r'''
+msgid ""
+msgstr ""
+"Language: en_US\n"''')
+        catalog = pofile.read_po(buf, locale='de')
+        self.assertEqual(Locale('en', 'US'), catalog.locale)
+
+    def test_language_header_survives_write(self):
+        source = StringIO(r'''msgid ""
+msgstr ""
+"Language: en_US\n"''')
+        catalog = pofile.read_po(source)
+
+        output = BytesIO()
+        pofile.write_po(output, catalog)
+        written_catalog = pofile.read_po(BytesIO(output.getvalue()))
+
+        self.assertEqual(Locale('en', 'US'), written_catalog.locale)
+
