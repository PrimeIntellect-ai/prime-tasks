+func TestFileRelease(t *testing.T) {
+	as := require.New(t)
+
+	// a release function which returns an error is propagated to the caller
+	expectedErr := errors.New("release failed")
+	file := &walk.File{}
+	file.AddReleaseFunc(func() error {
+		return expectedErr
+	})
+	as.ErrorIs(file.Release(), expectedErr)
+
+	// a successful release returns nil
+	file = &walk.File{}
+	file.AddReleaseFunc(func() error {
+		return nil
+	})
+	as.NoError(file.Release())
+}
+
+
+func TestFileReleaseFuncType(t *testing.T) {
+	as := require.New(t)
+
+	var callback walk.ReleaseFunc = func() error { return nil }
+	as.Equal("ReleaseFunc", reflect.TypeOf(callback).Name())
+
+	file := &walk.File{}
+	file.AddReleaseFunc(callback)
+	as.NoError(file.Release())
 }
